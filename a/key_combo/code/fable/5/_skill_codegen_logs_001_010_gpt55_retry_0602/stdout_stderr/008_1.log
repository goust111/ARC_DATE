def _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:
    """
    anchor_idx in {0,1,2} selects position on a length:
      0 -> start, 1 -> middle, 2 -> end
    Returns the top-left coordinate so that the corresponding point of the placed object
    aligns with that point on the canvas.
    """
    if anchor_idx <= 0:
        canvas_anchor = 0
        obj_anchor = 0
    elif anchor_idx >= 2:
        canvas_anchor = max(0, size - 1)
        obj_anchor = max(0, place_size - 1)
    else:
        canvas_anchor = (size - 1) // 2 if size > 1 else 0
        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0
    return canvas_anchor - obj_anchor


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble and place enlarged sprites on a canvas using legend-panel instructions.

    Input structure:
    - Color-6 separators divide the grid into a left legend column and a main canvas.
    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.

    Rule:
    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.
    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).
    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.

    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    assert w >= 2, "grid width must be >= 2"

    # Output canvas is the region between the left separator run and (optionally) a
    # right-side separator run near the far edge (right legend panel).
    left_sep, right_sep = _split_canvas(g)
    left_sep_c1 = left_sep[1]
    canvas_c0 = left_sep_c1 + 1
    canvas_c1 = right_sep[0] if right_sep is not None else w
    main = g[:, canvas_c0:canvas_c1].copy()

    # Paint one constructed sprite per marker panel that lies outside the output canvas.
    marker_squares = _all_marker_panel_squares(g)
    assert marker_squares, "no marker panel found"

    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).
    eff_h, eff_w = main.shape
    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]
    if full6_cols:
        eff_w = min(full6_cols)
    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]
    if full6_rows:
        eff_h = min(full6_rows)

    out = main.copy()
    composite_written = np.zeros(out.shape, dtype=bool)

    for marker_r0, marker_c0 in marker_squares:
        # Ignore marker panels inside the output canvas; only legends should drive drawing.
        if canvas_c0 <= marker_c0 < canvas_c1:
            continue

        if marker_c0 + 5 > w:
            continue
        panel = g[:, marker_c0 : marker_c0 + 5]

        unit = _extract_unit_sprite(panel)
        if unit is None:
            continue
        unit_sprite, unit_bb = unit

        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)
        if frame_bb is None:
            continue
        fr0, fc0, fr1, fc1 = frame_bb
        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]
        frame_mask0 = (frame != 0) & (frame != 6)
        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))
        assert n8 == 1, f"frame must be 8-connected, got {n8} components"

        # Rotate layout according to clockhand.
        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3
        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)

        # Build composite by tiling the unit sprite into active frame cells.
        m_unit = (unit_sprite != 0) & (unit_sprite != 6)
        uh, uw = unit_sprite.shape
        fh, fw = frame_mask.shape
        comp = np.zeros((fh * uh, fw * uw), dtype=int)
        for i in range(fh):
            for j in range(fw):
                if not frame_mask[i, j]:
                    continue
                rr0 = i * uh
                cc0 = j * uw
                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]

        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)
        if pos is None:
            continue
        pr, pc = pos

        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])
        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])

        ch, cw = comp.shape
        for r in range(ch):
            rr = top + r
            assert 0 <= rr < out.shape[0], "sprite row out of canvas bounds"
            for c in range(cw):
                cc = left + c
                assert 0 <= cc < out.shape[1], "sprite col out of canvas bounds"
                if out[rr, cc] == 6:
                    continue
                val = int(comp[r, c])
                if val != 0 and val != 6:
                    assert not composite_written[rr, cc], "composites must not overlap"
                    composite_written[rr, cc] = True
                    out[rr, cc] = val
    return out

# --------------- generator (refine_8conn_fill_overlap) ---------------

# ── CFG: tunable generation parameters ──────────────────────────────
GRID_H_RANGE = (20, 30)         # output grid height
GRID_W = 30                     # output grid width (fixed)
LEGEND_COUNT_WEIGHTS = [1, 4]   # weights for [1-legend, 2-legend]
UNIT_SIZE_RANGE = (2, 5)        # NxN unit sprite side length
MIN_CANVAS_W = 8                # reject if canvas narrower than this
FRAME_H_RANGE = (4, 9)          # frame mask height (before rotation)
FRAME_W_RANGE = (3, 6)          # frame mask width  (before rotation)
FRAME_DENSITY = 0.5             # density for random_sprite frame generation
BAND_WIDTH_MIN = 4              # minimum band width for canvas background
MARKER_PANEL_HEIGHT = 8         # marker square (5) + rotation patch (3)
USABLE_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]  # all colors except 0 (bg) and 6 (separator)
ROTATION_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up/right/down/left clock-hand offsets
GEN_RETRIES = 300               # max attempts in generate_input


def _allocate_colors(num_legends):
    """Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend."""
    pool = list(USABLE_COLORS)
    random.shuffle(pool)

    unit_color_sets = []
    used_unit = set()
    for _ in range(num_legends):
        if len(pool) < 2:
            return None
        c1, c2 = pool.pop(), pool.pop()
        unit_color_sets.append((c1, c2))
        used_unit.update([c1, c2])

    bg_cands = [c for c in pool if c not in used_unit]
    if len(bg_cands) < 2:
        return None
    random.shuffle(bg_cands)
    bg_colors = (bg_cands[0], bg_cands[1])

    frame_colors = []
    all_set = set(USABLE_COLORS)
    for uc in unit_color_sets:
        candidates = list(all_set - set(uc))
        frame_colors.append(random.choice(candidates))
        canvas[:] = colors[band_indices][None, :]
    return canvas


def _overlay_composites(canvas, legends):
    """Stamp each legend's tiled composite onto the canvas (non-{0,6} pixels overwrite)."""
    output = canvas.copy()
    for leg in legends:
        sp, rf = leg["sprite"], leg["rotated_frame"]
        N = leg["N"]
        t, l = leg["comp_top"], leg["comp_left"]
        fh, fw = rf.shape

        # Build full composite by tiling the unit sprite into active frame cells
        comp = np.zeros((fh * N, fw * N), dtype=int)
        sprite_mask = (sp != 0) & (sp != 6)
        for i in range(fh):
            for j in range(fw):
                if rf[i, j]:
                    r0, c0 = i * N, j * N
                    comp[r0:r0 + N, c0:c0 + N][sprite_mask] = sp[sprite_mask]

        # Overwrite canvas where composite has content and canvas isn't color 6
        region = output[t:t + fh * N, l:l + fw * N]
        write_mask = (comp != 0) & (region != 6)
        region[write_mask] = comp[write_mask]
    return output


def _gen_attempt() -> np.ndarray | None:
    grid_h = random.randint(*GRID_H_RANGE)
    num_legends = random.choices([1, 2], weights=LEGEND_COUNT_WEIGHTS)[0]

    # Per legend: pick N, compute legend_w
    legends = []
    for _ in range(num_legends):
        N = random.randint(*UNIT_SIZE_RANGE)
        legends.append({"N": N, "legend_w": N + 2})

    # Layout widths
    left_lw = legends[0]["legend_w"]
    left_total = left_lw + 1  # legend + 1 separator col
    right_total = (1 + legends[1]["legend_w"]) if num_legends == 2 else 0
    canvas_w = GRID_W - left_total - right_total
    if canvas_w < MIN_CANVAS_W:
        return None

    # Color allocation
    colors = _allocate_colors(num_legends)
    if colors is None:
        return None
    unit_color_sets, (bg1, bg2), frame_colors = colors

    marker_r0 = grid_h - MARKER_PANEL_HEIGHT

    # Design each legend panel
    for li in range(num_legends):
        if not _design_legend(legends[li], unit_color_sets[li], frame_colors[li],
                              marker_r0, grid_h, canvas_w):
            return None

    # Assign anchor positions
    if not _assign_anchors(legends, grid_h, canvas_w):
        return None

    # Build canvas and overlay composites
    canvas = _build_banded_canvas(grid_h, canvas_w, bg1, bg2)
    output = _overlay_composites(canvas, legends)

    # Assemble input grid
    grid = np.zeros((grid_h, GRID_W), dtype=int)
    canvas_c0 = left_total
    grid[:, canvas_c0:canvas_c0 + canvas_w] = canvas

    _place_legend(grid, legends[0], col_start=0, sep_col=left_lw,
                  marker_r0=marker_r0, is_right=False)
    if num_legends == 2:
        r_sep = canvas_c0 + canvas_w
        _place_legend(grid, legends[1], col_start=r_sep + 1, sep_col=r_sep,
                      marker_r0=marker_r0, is_right=True)

    # Validate via solver
    try:
        if np.array_equal(main(grid), output):
            return grid
    except Exception:
        pass
    return None


def _place_legend(grid, leg, col_start, sep_col, marker_r0, is_right):
    """Draw one legend panel (separator, marker square, rotation patch, sprite, frame)."""
    N = leg["N"]
    grid[:, sep_col] = 6

    # Marker square column: sprite at col_start+1 must fit within the 5-wide panel
    mc0 = (col_start + max(0, N - 4)) if not is_right else (sep_col + max(0, N - 3))

    # 5x5 border-6 marker square
    grid[marker_r0:marker_r0 + 5, mc0:mc0 + 5] = 0
    grid[marker_r0, mc0:mc0 + 5] = 6
    grid[marker_r0 + 4, mc0:mc0 + 5] = 6
    grid[marker_r0:marker_r0 + 5, mc0] = 6
    grid[marker_r0:marker_r0 + 5, mc0 + 4] = 6
    grid[marker_r0 + 1 + leg["pr"], mc0 + 1 + leg["pc"]] = 4

    # Rotation patch: 3x5 block with 6-borders on cols 0,4 and 3x3 clock-hand inside
    rr0 = marker_r0 + 5
    grid[rr0:rr0 + 3, mc0:mc0 + 5] = 0
    grid[rr0:rr0 + 3, mc0] = 6
    grid[rr0:rr0 + 3, mc0 + 4] = 6
    cx_r, cx_c = rr0 + 1, mc0 + 2
    dr, dc = ROTATION_DIRS[leg["rot_k"]]
    grid[cx_r, cx_c] = 7
    grid[cx_r + dr, cx_c + dc] = 7

    # Unit sprite at row 1
    sp_col = col_start + 1 - mc0
    grid[1:1 + N, mc0 + sp_col:mc0 + sp_col + N] = leg["legend_sprite"]

    # Frame mask between unit sprite bottom and marker top
    fH, fW = leg["frame_H"], leg["frame_W"]
    avail = marker_r0 - (N + 1)
    gap = random.randint(1, max(1, avail - fH))
    fr_start = N + 1 + gap
    f_col = random.randint(0, max(0, 4 - fW))
    frame_region = grid[fr_start:fr_start + fH, mc0 + f_col:mc0 + f_col + fW]
    frame_region[leg["frame_mask"]] = leg["frame_color"]


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")
import math
import random

import numpy as np

from arc_utils import colors_present, find_components, paste


def _blocked_mask(g: np.ndarray, obstacle: int) -> np.ndarray:
    obstacle_mask = g == int(obstacle)
    cushion = np.zeros_like(obstacle_mask, dtype=bool)
    cushion[:-1, :] = obstacle_mask[1:, :]
    bottom_edge = np.zeros_like(obstacle_mask, dtype=bool)
    bottom_edge[-1, :] = True
    return obstacle_mask | cushion | bottom_edge


def _assert_output_separated(out: np.ndarray, obstacle: int, moving: int) -> None:
    obstacle_mask = out == int(obstacle)
    near_obstacle = np.zeros_like(obstacle_mask, dtype=bool)
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue

            src_r0 = max(0, -dr)
            src_r1 = out.shape[0] - max(0, dr)
            src_c0 = max(0, -dc)
            src_c1 = out.shape[1] - max(0, dc)
            dst_r0 = max(0, dr)
            dst_r1 = out.shape[0] - max(0, -dr)
            dst_c0 = max(0, dc)
            dst_c1 = out.shape[1] - max(0, -dc)
            near_obstacle[dst_r0:dst_r1, dst_c0:dst_c1] |= obstacle_mask[
                src_r0:src_r1, src_c0:src_c1
            ]

    assert not np.any((out == int(moving)) & near_obstacle), (
        "settled moving objects must not be 8-connected to obstacles"
    )


def _obstacle_column_heights(g: np.ndarray, obstacle: int) -> list[int]:
    heights = []
    obstacle_mask = g == int(obstacle)
    H, W = map(int, g.shape)
    for c in range(W):
        rows = np.flatnonzero(obstacle_mask[:, c])
        heights.append(0 if len(rows) == 0 else H - int(rows[0]))
    return heights


def _assert_obstacle_profile(g: np.ndarray, obstacle: int) -> None:
    heights = _obstacle_column_heights(g, obstacle)
    occupied = [h for h in heights if h > 0]
    assert occupied, "obstacle must occupy at least one bottom-supported column"

    H, W = map(int, g.shape)
    obstacle_mask = g == int(obstacle)
    total = int(obstacle_mask.sum())
    bottom3 = int(obstacle_mask[max(0, H - 3) :, :].sum())

    assert len(occupied) * 3 >= W, "obstacle must cover a substantial part of the bottom"
    assert sum(occupied) * 4 <= len(occupied) * 13, (
        "obstacle columns must be low on average"
    )
    assert bottom3 * 5 >= total * 3, "obstacle pixels must be mostly near the bottom"


def _infer_roles(g: np.ndarray) -> tuple[int, int, int]:
    colors = colors_present(g)
    assert len(colors) == 3, "expected background, obstacle, and moving colors"

    candidates = []
    for bg in colors:
        for obstacle in colors:
            if obstacle == bg or not np.any(g[-1, :] == obstacle):
                continue
            for moving in colors:
                if moving in (bg, obstacle) or np.any(g[-1, :] == moving):
                    continue
                blocked = _blocked_mask(g, obstacle)
                if np.any(blocked & (g == moving)):
                    continue
                candidates.append((int(bg), int(obstacle), int(moving)))

    assert len(candidates) == 1, "roles must be uniquely determined"
    return candidates[0]


def _movable_components(out: np.ndarray, bg: int, moving: int, blocked: np.ndarray) -> list[tuple[np.ndarray, np.ndarray]]:
    moving_mask = out == int(moving)
    moves = []
    for comp in find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[moving]):
        coords = comp["coords"]
        shifted = coords + np.array([1, 0])
        if int(shifted[:, 0].max()) >= int(out.shape[0]):
            continue
        if np.any(blocked[shifted[:, 0], shifted[:, 1]]):
            continue

        other_moving = moving_mask.copy()
        other_moving[coords[:, 0], coords[:, 1]] = False
        if np.any(other_moving[shifted[:, 0], shifted[:, 1]]):
            continue
        moves.append((coords, shifted))
    return moves


def main(grid: np.ndarray) -> np.ndarray:
    """
    Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.

    Input structure:
    - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.
    - The obstacle color is the unique non-background role that touches the bottom edge.
    - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.

    Rule:
    - Keep the background and obstacle pixels fixed.
    - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.
    - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.

    Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.
    """
    g = np.asarray(grid, dtype=int)
    bg, obstacle, moving = _infer_roles(g)
    _assert_obstacle_profile(g, obstacle)
    blocked = _blocked_mask(g, obstacle)
    assert not np.any(blocked & (g == moving)), "moving pixels must start in free cells"

    out = g.copy()
    while True:
        moves = _movable_components(out, bg, moving, blocked)
        if not moves:
            break
        for coords, _ in moves:
            out[coords[:, 0], coords[:, 1]] = bg
        for _, shifted in moves:
            out[shifted[:, 0], shifted[:, 1]] = moving

    _assert_output_separated(out, obstacle, moving)
    return out

# --------------- generator (att2) ---------------

# Canvas bounds.
GRID_H_RANGE = (4, 10)
GRID_W_RANGE = (7, 20)

# Obstacle profile constraints.
OBSTACLE_COVERAGE_RANGE = (0.08, 0.52)
POCKET_COUNT_RANGE = (1, 5)
DISTINCT_HEIGHT_COUNT_RANGE = (2, 4)
OBSTACLE_COMPONENT_RANGE = (1, 3)
BOTTOM_BAND_ROWS = 3
BOTTOM_COLS_MIN_MULTIPLIER = 3
COLUMN_AVG_MAX_NUM = 13
COLUMN_AVG_MAX_DEN = 4
BOTTOM3_MIN_NUM = 3
BOTTOM3_MIN_DEN = 5

# Bottom-heavy profile sampling.
PROFILE_RETRIES = 120
BOTTOM_HEAVY_WEIGHT = 5
LOW_COLUMN_EXTRA_PROB = 0.35
