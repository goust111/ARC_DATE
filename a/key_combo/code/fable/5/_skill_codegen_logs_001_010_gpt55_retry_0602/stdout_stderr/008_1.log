    """Return True if any cell in *coords_a* overlaps or is 4-adjacent to *coords_b*."""
    bset = set(coords_b)
    for r, c in coords_a:
        if (r, c) in bset:
            return True
        for nr, nc in neighbors4(r, c):
            if (nr, nc) in bset:
                return True
    return False


