from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, neighbors4
import random


Coord = tuple[int, int]


def _ordered_path(coords: np.ndarray) -> list[Coord]:
    cells = {tuple(map(int, coord)) for coord in coords}
    assert len(cells) == len(coords), "path coordinates must be unique"

    degrees = {
        cell: sum((neighbor in cells) for neighbor in neighbors4(*cell))
        for cell in cells
    }
    endpoints = sorted(cell for cell, degree in degrees.items() if degree == 1)
    assert len(endpoints) == 2, "path must have exactly two endpoints"
    assert all(degree in (1, 2) for degree in degrees.values()), "path must not branch"

    path = []
    prev = None
    cur = endpoints[0]
    while True:
        path.append(cur)
        next_cells = [
            neighbor
            for neighbor in neighbors4(*cur)
            if neighbor in cells and neighbor != prev
        ]
        if not next_cells:
            break
        assert len(next_cells) == 1, "path traversal must be unique"
        prev, cur = cur, next_cells[0]

    assert len(path) == len(cells), "path traversal must visit every foreground pixel"
    return path


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reverse the sequence of colors along the single 4-connected foreground path while keeping the path shape fixed.

    Input structure:
    - The background is the dominant color.
    - All non-background pixels form one multicolor 4-connected one-pixel-wide path.
    - The path has exactly two endpoints and no branches.

    Rule:
    - Walk the path from one endpoint to the other.
    - Replace the colors on those same path cells by the original path colors in reverse order.
    - Leave every background pixel unchanged.

    Key insight:
    - Nothing moves geometrically; only the color string written on the path is reversed between the endpoints.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert len(components) == 1, "expected exactly one foreground path"

    path = _ordered_path(components[0]["coords"])
    values = [int(g[r, c]) for r, c in path]

    out = g.copy()
    for (r, c), value in zip(path, reversed(values)):
        out[r, c] = value
    return out

# --------------- generator (att2, o5x) ---------------

# Grid and path geometry.
GRID_SHAPE = (10, 10)
BG_COLOR = 8
INTERIOR_MIN = 1
INTERIOR_MAX = 8
PATH_LEN_MIN, PATH_LEN_MAX = 8, 28
TURN_COUNT_MIN, TURN_COUNT_MAX = 2, 8
SEGMENT_STEPS_MIN, SEGMENT_STEPS_MAX = 1, 7

# Direction and color sampling.
DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
PATH_COLORS = [1, 2, 4, 5, 6, 7, 9]
PALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 6, 7

# Generation retry budget.
MAX_GENERATION_ATTEMPTS = 300


def _turn_dirs(direction: tuple[int, int] | None) -> list[tuple[int, int]]:
    if direction is None:
        dirs = list(DIRS)
    else:
        dr, dc = direction
        dirs = [(-dc, dr), (dc, -dr)]
    random.shuffle(dirs)
    return dirs


def _sample_run_lengths(n_segments: int, total_steps: int) -> list[int]:
    runs = []
    remaining = total_steps
    for i in range(n_segments):
        slots = n_segments - i - 1
        lo = max(SEGMENT_STEPS_MIN, remaining - SEGMENT_STEPS_MAX * slots)
        hi = min(SEGMENT_STEPS_MAX, remaining - SEGMENT_STEPS_MIN * slots)
        runs.append(random.randint(lo, hi))
        remaining -= runs[-1]
    random.shuffle(runs)
    return runs


def _sample_run_plan() -> list[int]:
    target_len = random.randint(PATH_LEN_MIN, PATH_LEN_MAX)
    total_steps = target_len - 1
    valid_turns = [
        turns
        for turns in range(TURN_COUNT_MIN, TURN_COUNT_MAX + 1)
        if SEGMENT_STEPS_MIN * (turns + 1) <= total_steps <= SEGMENT_STEPS_MAX * (turns + 1)
    ]
    turns = random.choice(valid_turns)
    return _sample_run_lengths(turns + 1, total_steps)


def _extend_segment(
    path: list[tuple[int, int]],
    used: set[tuple[int, int]],
    direction: tuple[int, int],
    steps: int,
) -> tuple[list[tuple[int, int]], set[tuple[int, int]]] | None:
    dr, dc = direction
    new_path = list(path)
    new_used = set(used)
    r, c = new_path[-1]

    for _ in range(steps):
        nr, nc = r + dr, c + dc
        if not (INTERIOR_MIN <= nr <= INTERIOR_MAX and INTERIOR_MIN <= nc <= INTERIOR_MAX):
            return None
        if (nr, nc) in new_used:
            return None
        if any((ar, ac) in new_used and (ar, ac) != (r, c) for ar, ac in neighbors4(nr, nc)):
            return None

        new_path.append((nr, nc))
        new_used.add((nr, nc))
        r, c = nr, nc

    return new_path, new_used


def _build_path(run_lengths: list[int]) -> list[tuple[int, int]] | None:
    starts = [(r, c) for r in range(INTERIOR_MIN, INTERIOR_MAX + 1) for c in range(INTERIOR_MIN, INTERIOR_MAX + 1)]
    random.shuffle(starts)

    def search(
        seg_i: int,
        prev_dir: tuple[int, int] | None,
        path: list[tuple[int, int]],
        used: set[tuple[int, int]],
    ) -> list[tuple[int, int]] | None:
        if seg_i == len(run_lengths):
            return path
        for direction in _turn_dirs(prev_dir):
            extended = _extend_segment(path, used, direction, run_lengths[seg_i])
            if extended is None:
                continue
            found = search(seg_i + 1, direction, extended[0], extended[1])
            if found is not None:
                return found
        return None

    for start in starts:
        found = search(0, None, [start], {start})
        if found is not None:
            return found
    return None


def _color_sequence(n: int) -> list[int]:
    palette = random.sample(PATH_COLORS, random.randint(PALETTE_SIZE_MIN, PALETTE_SIZE_MAX))
    seq = palette + [random.choice(palette) for _ in range(n - len(palette))]
    random.shuffle(seq)
    if seq == seq[::-1]:
        for i in range(1, n):
            if seq[i] != seq[0]:
                seq[0], seq[i] = seq[i], seq[0]
                break
    return seq


def _paint_path(grid: np.ndarray, path: list[Coord], colors: list[int]) -> None:
    for (r, c), color in zip(path, colors):
        grid[r, c] = color


def _passes_oracle(grid: np.ndarray, expected: np.ndarray) -> bool:
    try:
        return bool(np.array_equal(main(grid), expected))
    except AssertionError:
        return False


def _gen_attempt() -> np.ndarray | None:
    path = _build_path(_sample_run_plan())
    if path is None:
        return None
    colors = _color_sequence(len(path))
    grid = np.full(GRID_SHAPE, BG_COLOR, dtype=int)
    _paint_path(grid, path, colors)
    expected = grid.copy()
    _paint_path(expected, path, colors[::-1])
    if not _passes_oracle(grid, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 5792cb4d input")
from __future__ import annotations
import math
from collections import Counter
import numpy as np
from arc_utils import bbox_h, bbox_w, find_components, get_bg
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Stamp translated copies of a monochrome template guided by a singleton pixel layout.

    Input structure:
    - bg = background. A large monochrome shape (template, color T).
    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).
    - Singletons sit on a uniform-spacing lattice.

    Rule:
    - Convert each singleton's offset from the origin into coarse lattice units.
    - Place a template copy at each offset, scaled by template height/width.
    - The origin's copy is painted O instead of T.
    - Any pixel covered by two or more copies is also recolored to O.

    Key insight: The single T-colored singleton identifies both the origin position and the "self" copy, which is uniquely recolored.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))
    H, W = g.shape

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    assert not (not comps)

    template = max(comps, key=lambda d: int(d["area"]))
    templ_coords = template["coords"]
    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])
    r0, c0, r1, c1 = map(int, template["bbox"])
    h = int(bbox_h((r0, c0, r1, c1)))
    w = int(bbox_w((r0, c0, r1, c1)))

    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]

    # Singleton layout points (excluding the template component).
    singletons: list[tuple[int, int, int]] = []
    for comp in comps:
        if comp is template:
            continue
        if int(comp["area"]) != 1:
            continue
        rr, cc = map(int, comp["coords"][0])
        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))

    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]
    assert not (len(origin) != 1)
    orr, orc = origin[0]

    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]
    assert not (not other_cols)
    overlap_col = int(Counter(other_cols).most_common(1)[0][0])

    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]
    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]
    assert gcd_vals
    gunit = int(math.gcd(*gcd_vals))
    gunit = max(1, int(gunit))
    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]

    total = np.zeros((H, W), dtype=int)
    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton

    for dr, dc, col in deltas:
        off_r = int(dr * h)
        off_c = int(dc * w)
        is_origin = int(col) == int(templ_col)
        for rr, cc in templ_rel:
            R = int(r0 + off_r + rr)
            C = int(c0 + off_c + cc)
            if 0 <= R < H and 0 <= C < W:
                total[R, C] += 1
                if is_origin:
                    center[R, C] += 1

    out = np.full((H, W), int(bg), dtype=int)
    out[total > 0] = int(templ_col)
    out[(total == 1) & (center > 0)] = int(overlap_col)
    out[total >= 2] = int(overlap_col)
    return out

# --------------- generator (a1) ---------------

# ── Tunable configuration ──────────────────────────────────────────
GRID_SIZE = 22
TEMPLATE_H_CHOICES = [3, 4]       # template bbox height options
TEMPLATE_W = 3                    # template bbox width (fixed)
TEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds
TEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox
SINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons
LATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino
GUNIT = 2                         # singleton spacing in pixels

# Retry budgets
SPANNING_RETRIES = 40             # attempts per spanning polyomino
TEMPLATE_RETRIES = 60             # attempts to build a valid template
SINGLETON_RETRIES = 50            # attempts to place singleton cluster
GENERATE_RETRIES = 300            # outer retry loop


def _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
    """Grow a random 4-connected polyomino of *n* cells in a rows x cols grid."""
    start = (random.randint(0, rows - 1), random.randint(0, cols - 1))
    cells = {start}
    frontier = []
    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
        nr, nc = start[0] + dr, start[1] + dc
        if 0 <= nr < rows and 0 <= nc < cols:
            frontier.append((nr, nc))
    while len(cells) < n and frontier:
        cell = random.choice(frontier)
        frontier.remove(cell)
        if cell in cells:
            continue
        cells.add(cell)
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:
                frontier.append((nr, nc))
    return list(cells) if len(cells) == n else None


def _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
    """Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges)."""
    for _ in range(SPANNING_RETRIES):
        cells = _random_polyomino(n, rows, cols)
        if cells is None:
            continue
        rs = [r for r, c in cells]
        cs = [c for r, c in cells]
        if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:
            return cells
    return None


def _gen_template(h: int, w: int) -> list[tuple[int, int]] | None:
    """4-connected template shape in h x w, spanning bbox, within area/fill bounds."""
    total = h * w
    lo = max(TEMPLATE_AREA_RANGE[0], int(np.ceil(total * TEMPLATE_FILL_RANGE[0])))
    hi = min(TEMPLATE_AREA_RANGE[1], int(np.floor(total * TEMPLATE_FILL_RANGE[1])))
    if lo > hi:
        return None
    for _ in range(TEMPLATE_RETRIES):
        area = random.randint(lo, hi)
        cells = _spanning_polyomino(area, h, w)
        if cells is not None:
            return cells
    return None


def _gen_lattice(n: int) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:
    """Lattice polyomino of *n* cells with strictly interior origin."""
    ext_r = random.randint(*LATTICE_EXTENT_RANGE)
    ext_c = random.randint(*LATTICE_EXTENT_RANGE)
    cells = _spanning_polyomino(n, ext_r, ext_c)
    if cells is None:
        return None
    interior = [(r, c) for r, c in cells if 0 < r < ext_r - 1 and 0 < c < ext_c - 1]
    if not interior:
        return None
    return cells, random.choice(interior)


def _delta_bounds(deltas: list[tuple[int, int]]):
    """Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets."""
    min_dr = min(dr for dr, dc in deltas)
    max_dr = max(dr for dr, dc in deltas)
    min_dc = min(dc for dr, dc in deltas)
    max_dc = max(dc for dr, dc in deltas)
    return min_dr, max_dr, min_dc, max_dc


def _place_singletons(
    deltas, min_dr, max_dr, min_dc, max_dc,
    templ_cells, r0, c0, h, w, bg, T, O, occupied,
) -> np.ndarray | None:
    """Try to find a valid singleton cluster position and build the input grid."""
    orr_lo, orr_hi = -min_dr * GUNIT, GRID_SIZE - 1 - max_dr * GUNIT
    orc_lo, orc_hi = -min_dc * GUNIT, GRID_SIZE - 1 - max_dc * GUNIT
    if orr_lo > orr_hi or orc_lo > orc_hi:
        return None

    # Template bbox edges
    tr0, tr1 = r0, r0 + h - 1
    tc0, tc1 = c0, c0 + w - 1

    for _ in range(SINGLETON_RETRIES):
        orr = random.randint(orr_lo, orr_hi)
        orc = random.randint(orc_lo, orc_hi)

        # Singleton cluster bbox -- must be disjoint from template with >=1 bg cell gap
        sr0 = orr + min_dr * GUNIT
        sr1 = orr + max_dr * GUNIT
        sc0 = orc + min_dc * GUNIT
        sc1 = orc + max_dc * GUNIT
        if not (sr1 + 1 < tr0 or tr1 + 1 < sr0 or sc1 + 1 < tc0 or tc1 + 1 < sc0):
            continue

        # Singletons must not land on stamp pixels
        if any((orr + dr * GUNIT, orc + dc * GUNIT) in occupied for dr, dc in deltas):
            continue

        # Build input grid
        grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)
        for tr, tc in templ_cells:
            grid[r0 + tr, c0 + tc] = T
        for dr, dc in deltas:
            grid[orr + dr * GUNIT, orc + dc * GUNIT] = T if (dr == 0 and dc == 0) else O

        try:
            main(grid)
        except Exception:
            return None
        return grid

    return None


def _gen_attempt() -> np.ndarray | None:
    """Single attempt: pick colors, build template + lattice, place stamps + singletons."""
    bg, T, O = random.sample(range(10), 3)

