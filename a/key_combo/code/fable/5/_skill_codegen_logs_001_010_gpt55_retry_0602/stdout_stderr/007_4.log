+# contain 2, 3, and 4 sources.  The two-source phase alternates adjacent/opposite
+# corner geometry; all other choices remain random.
+_GENERATION_PHASE = random.randrange(6)
+_PALETTE = tuple(range(10))
+_MAX_ATTEMPTS = 400
