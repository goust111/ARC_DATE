    return min_pr, max_pr, min_pc, max_pc


def _place_on_grid(frame_coords, inner_coords, frame_h, frame_w, padded, frame_color, inner_color):
    bounds = _placement_bounds(padded, frame_h, frame_w)
    if bounds is None:
        return None

