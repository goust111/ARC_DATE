from __future__ import annotations

from collections import deque

import numpy as np

from arc_utils import bbox


def _solid_rectangle_marker(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
    for color in np.unique(g):
        mask = g == int(color)
        b = bbox(mask)
        assert b is not None
        r0, c0, r1, c1 = b
        area = int((r1 - r0 + 1) * (c1 - c0 + 1))
        if area > 1 and int(mask.sum()) == area and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1])):
            candidates.append((area, int(color), b))

    assert len(candidates) == 1
    _area, color, b = candidates[0]
    return color, b


def _find_reflected_strip_start(g: np.ndarray, marker: int) -> int:
    n, m = map(int, g.shape)
    assert n == m
    hi = n - 1

    for lo in range(n // 2 + 1):
        strip = g[:, lo : hi + 1]
        strip_reflected = strip[:, ::-1]
        known = (strip != marker) & (strip_reflected != marker)
        if bool(np.any((strip != strip_reflected) & known)):
            continue

        strip = g[lo : hi + 1, :]
        strip_reflected = strip[::-1, :]
        known = (strip != marker) & (strip_reflected != marker)
        if bool(np.any((strip != strip_reflected) & known)):
            continue

        return lo

    raise AssertionError("no reflected strip found")


def _reflection_orbit_values(g: np.ndarray, r: int, c: int, lo: int, marker: int) -> set[int]:
    n = int(g.shape[0])
    hi = n - 1
    seen: set[tuple[int, int]] = set()
    values: set[int] = set()
    q: deque[tuple[int, int]] = deque([(int(r), int(c))])

    while q:
        rr, cc = q.popleft()
        if (rr, cc) in seen:
            continue
        seen.add((rr, cc))

        value = int(g[rr, cc])
        if value != marker:
            values.add(value)

        if lo <= cc <= hi:
            q.append((rr, lo + hi - cc))
        if lo <= rr <= hi:
            q.append((lo + hi - rr, cc))

    return values


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reveal the rectangular patch hidden by the solid marker using the grid's reflection symmetries.

    Input structure:
    - A square colored pattern with one solid rectangular marker color occluding a patch.
    - The visible pattern has horizontal and vertical reflection symmetry on a large lower/right strip.
    - The top and left outer strips also expose transpose counterparts for cells not recoverable by those reflections.

    Rule:
    - Find the unique color whose full extent is a solid rectangle; this rectangle is the output region.
    - Infer the reflected strip start as the smallest row/column offset whose lower/right strips are mirror-consistent, ignoring marker pixels.
    - For each marker pixel, copy the unique non-marker value in its horizontal/vertical reflection orbit; if that orbit is entirely hidden in the outer strip, use the transposed top/left-strip counterpart.

    Key insight:
    The marker is not part of the pattern; it covers a missing rectangle whose cells are still determined by the visible mirror or transpose copies elsewhere in the grid.
    """
    g = np.asarray(grid, dtype=int)
    marker, (r0, c0, r1, c1) = _solid_rectangle_marker(g)
    lo = _find_reflected_strip_start(g, marker)

    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    out = np.empty((h, w), dtype=int)

    for rr in range(h):
        for cc in range(w):
            r = int(r0 + rr)
            c = int(c0 + cc)
            values = _reflection_orbit_values(g, r, c, lo, marker)
            if values:
                assert len(values) == 1
                out[rr, cc] = values.pop()
            else:
                assert r < lo or c < lo
                assert 0 <= c < g.shape[0] and 0 <= r < g.shape[1]
                value = int(g[c, r])
                assert value != marker
                out[rr, cc] = value

    return out

# --------------- generator (o5x) ---------------

# --- CFG: canvas & structure ---
_N = 30                  # grid side length (always square)
_LO = 2                  # outer border width (rows/cols 0..lo-1 are "free" border)
_HI = _N - 1             # max row/col index

# --- CFG: colors ---
_PALETTE = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)  # 8 non-marker colors
_MARKER = 8              # marker fill color

# --- CFG: marker rectangle size ---
_MARKER_DIM_LO = 3       # min marker side length
_MARKER_DIM_HI = 9       # max marker side length (inclusive)
_MARKER_AREA_LO = 16     # min marker area
_MARKER_AREA_HI = 36     # max marker area

# --- CFG: generation retries ---
_MAX_RETRIES = 300

_RNG = np.random.default_rng()
_SIZE_PAIRS = [
    (h, w)
    for h in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)
    for w in range(_MARKER_DIM_LO, _MARKER_DIM_HI + 1)
    if _MARKER_AREA_LO <= h * w <= _MARKER_AREA_HI
]
_PLACEMENT_CACHE: dict[tuple[int, int], list[tuple[int, int, list[tuple[int, int]]]]] = {}


def _orbit(r: int, c: int) -> set[tuple[int, int]]:
    """Return the LR+UD reflection orbit of (r, c) within the [_LO.._HI] axes."""
    rows = {r}
    cols = {c}
    if _LO <= r <= _HI:
        rows.add(_LO + _HI - r)
    if _LO <= c <= _HI:
        cols.add(_LO + _HI - c)
    return {(rr, cc) for rr in rows for cc in cols}


def _fallback_cells(r0: int, c0: int, h: int, w: int) -> list[tuple[int, int]] | None:
    """Identify marker cells whose entire orbit is inside the marker (need transpose fallback).

    Returns None if the placement is invalid (a fully-covered orbit cell lies
    inside the inner block, or its transpose is also inside the marker).
    """
    r1, c1 = r0 + h, c0 + w
    cells: list[tuple[int, int]] = []
    for r in range(r0, r1):
        for c in range(c0, c1):
            if all(r0 <= rr < r1 and c0 <= cc < c1 for rr, cc in _orbit(r, c)):
                if r >= _LO and c >= _LO:
                    return None  # orbit fully hidden but no transpose fallback available
                if r0 <= c < r1 and c0 <= r < c1:
                    return None  # transpose cell also hidden by marker
                cells.append((r, c))
    return cells


def _valid_placements(h: int, w: int) -> list[tuple[int, int, list[tuple[int, int]]]]:
    """Return all valid (r0, c0, fallback_cells) placements for a h x w marker, cached."""
    key = (h, w)
    if key not in _PLACEMENT_CACHE:
        placements: list[tuple[int, int, list[tuple[int, int]]]] = []
        for r0 in range(_N - h + 1):
            for c0 in range(_N - w + 1):
                fallback = _fallback_cells(r0, c0, h, w)
                if fallback is not None:
                    placements.append((r0, c0, fallback))
        _PLACEMENT_CACHE[key] = placements
    return _PLACEMENT_CACHE[key]


def _unify_groups(clean: np.ndarray, groups: list[set[tuple[int, int]]]) -> None:
    """Merge coordinate groups with union-find so all members share a random color."""
    parent: dict[tuple[int, int], tuple[int, int]] = {}

    def find(x: tuple[int, int]) -> tuple[int, int]:
        parent.setdefault(x, x)
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a: tuple[int, int], b: tuple[int, int]) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[rb] = ra

    for group in groups:
        coords = list(group)
        if not coords:
            continue
        for coord in coords[1:]:
            union(coords[0], coord)

    merged: dict[tuple[int, int], list[tuple[int, int]]] = {}
    for coord in parent:
        merged.setdefault(find(coord), []).append(coord)

    for coords in merged.values():
        color = int(_RNG.choice(_PALETTE))
        for r, c in coords:
            clean[r, c] = color


def _build_clean() -> np.ndarray:
    """Build a clean NxN grid with bilateral LR+UD symmetry on the [lo..N-1] axes."""
    half = (_N - _LO) // 2
    clean = np.empty((_N, _N), dtype=int)

    # Inner block: quarter tile mirrored LR then UD
    q = _RNG.choice(_PALETTE, size=(half, half))
    top = np.concatenate([q, q[:, ::-1]], axis=1)
    clean[_LO:_N, _LO:_N] = np.concatenate([top, top[::-1, :]], axis=0)

    # Top border rows: LR-symmetric on [lo..N-1]
    for r in range(_LO):
        vals = _RNG.choice(_PALETTE, size=half)
        clean[r, _LO : _LO + half] = vals
        clean[r, _LO + half : _N] = vals[::-1]

    # Left border cols: UD-symmetric on [lo..N-1]
    for c in range(_LO):
        vals = _RNG.choice(_PALETTE, size=half)
        clean[_LO : _LO + half, c] = vals
        clean[_LO + half : _N, c] = vals[::-1]

    # Top-left corner: free (no symmetry constraint)
    clean[:_LO, :_LO] = _RNG.choice(_PALETTE, size=(_LO, _LO))
    return clean


def _gen_attempt() -> np.ndarray | None:
    """Try once to generate a valid input grid. Returns None on failure."""
    clean = _build_clean()
    h, w = _SIZE_PAIRS[int(_RNG.integers(len(_SIZE_PAIRS)))]
    placements = _valid_placements(h, w)
    if not placements:
        return None
    r0, c0, fallback = placements[int(_RNG.integers(len(placements)))]

    # Ensure transpose-fallback cells share consistent colors across orbits
    groups = [_orbit(r, c) | _orbit(c, r) for r, c in fallback]
    _unify_groups(clean, groups)

    expected = clean[r0 : r0 + h, c0 : c0 + w].copy()
    inp = clean.copy()
    inp[r0 : r0 + h, c0 : c0 + w] = _MARKER

    try:
        if np.array_equal(main(inp), expected):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 0934a4d8 input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_coords, components_mask
import random

BBox = tuple[int, int, int, int]


def _edge_side(bbox: BBox, shape: tuple[int, int]) -> str:
    r0, c0, r1, c1 = bbox
    h, w = shape
    sides = []
    if r0 == 0:
        sides.append("top")
    if r1 == h - 1:
        sides.append("bottom")
    if c0 == 0:
        sides.append("left")
    if c1 == w - 1:
        sides.append("right")
    assert len(sides) == 1, "each black rectangle must touch exactly one grid edge"
    return sides[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide each black border rectangle to the opposite border, recoloring its swept stripe orange and leaving the rectangle black at the far edge.

    Input structure
    - The grid contains black rectangular 4-connected masks, each touching exactly one outer border.
    - Grey cells form incidental pattern content; orange is the trail color used when a black mask slides.

    Rule
    - Treat all black rectangles as moving simultaneously.
    - A rectangle touching the top or bottom edge moves vertically to the opposite edge in the same columns.
    - A rectangle touching the left or right edge moves horizontally to the opposite edge in the same rows.
    - Recolor the complete swept row or column stripe to orange, then stamp every destination rectangle in black.

    Key insight
    - Edge contact gives the slide direction; the output is the set of opposite-edge black rectangles plus their orange trails.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h > 0 and w > 0

    moving = Color.BLACK
    trail = Color.ORANGE
    assert np.any(g == moving), "expected at least one black rectangle"
    assert np.any(g == trail), "expected orange trail color to be present"

    out = g.copy()
    targets: list[BBox] = []
    for coords in components_mask(g == moving, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(coords)
        rect_h = r1 - r0 + 1
        rect_w = c1 - c0 + 1
        assert int(coords.shape[0]) == rect_h * rect_w, "black mask must be a solid rectangle"

        side = _edge_side((r0, c0, r1, c1), g.shape)
        if side == "top":
            out[:, c0 : c1 + 1] = trail
            targets.append((h - rect_h, c0, h - 1, c1))
        elif side == "bottom":
            out[:, c0 : c1 + 1] = trail
            targets.append((0, c0, rect_h - 1, c1))
        elif side == "left":
            out[r0 : r1 + 1, :] = trail
            targets.append((r0, w - rect_w, r1, w - 1))
        else:
            assert side == "right"
            out[r0 : r1 + 1, :] = trail
            targets.append((r0, 0, r1, rect_w - 1))

    for r0, c0, r1, c1 in targets:
        out[r0 : r1 + 1, c0 : c1 + 1] = moving

    return out

# --------------- generator (att1) ---------------

# Canvas and palette.
MIN_H, MAX_H = 6, 18
MIN_W, MAX_W = 8, 14
BG_GREY, BG_ORANGE = 5, 7
GREY_FRAC_MIN, GREY_FRAC_MAX = 0.2, 0.6

# Rectangle and band constraints.
MIN_RECTS, MAX_RECTS = 1, 8
MIN_BAND_SIZE, MAX_BAND_SIZE = 1, 6
BAND_GAP = 1
MIN_RECT_AREA, MAX_RECT_AREA = 2, 18
MAX_RECT_SIDE = 6
SOURCE_EDGE_OFFSET = 1

# Retry limits.
TARGET_COUNT_ATTEMPTS = 300
ANY_COUNT_ATTEMPTS = 100


def _partition_bands(
    total: int, n: int, min_size: int, max_size: int, min_gap: int = 0
) -> list[tuple[int, int]] | None:
    """Place n non-overlapping inclusive bands inside [0, total - 1]."""
    if n == 0:
        return []

    needed = n * min_size + (n - 1) * min_gap
    if needed > total:
        return None

    effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))
    if effective_max < min_size:
        return None

    widths = [random.randint(min_size, effective_max) for _ in range(n)]
    total_used = sum(widths) + (n - 1) * min_gap
    if total_used > total:
        excess = total_used - total
        indices = list(range(n))
        random.shuffle(indices)
        for i in indices:
            shrink = min(widths[i] - min_size, excess)
            widths[i] -= shrink
            excess -= shrink
            if excess == 0:
                break
        if excess > 0:
            return None

    remaining = total - sum(widths) - (n - 1) * min_gap
    extra_gaps = [0] * (n + 1)
    for _ in range(remaining):
        extra_gaps[random.randint(0, n)] += 1

    bands = []
    pos = 0
    for i in range(n):
        pos += extra_gaps[i]
        if i > 0:
            pos += min_gap
        bands.append((pos, pos + widths[i] - 1))
        pos += widths[i]
    return bands


def _choose_orientation_counts(n_rects: int) -> tuple[int, int] | None:
    max_vert = min(n_rects, (MAX_W - SOURCE_EDGE_OFFSET) // 2)
    max_horiz = min(n_rects, (MAX_H - SOURCE_EDGE_OFFSET) // 2)
    feasible = [(v, n_rects - v) for v in range(n_rects + 1)
                if v <= max_vert and (n_rects - v) <= max_horiz]
    if not feasible:
        return None
    return random.choice(feasible)


def _choose_canvas(n_vert: int, n_horiz: int) -> tuple[int, int] | None:
    min_h = max(MIN_H, 2 * n_horiz + 1) if n_horiz > 0 else MIN_H
    min_w = max(MIN_W, 2 * n_vert + 1) if n_vert > 0 else MIN_W
    if min_h > MAX_H or min_w > MAX_W:
        return None
    return random.randint(min_h, MAX_H), random.randint(min_w, MAX_W)


def _interior_bands(total: int, n: int) -> list[tuple[int, int]] | None:
    raw = _partition_bands(total - 2, n, MIN_BAND_SIZE, MAX_BAND_SIZE, BAND_GAP)
    if raw is None:
        return None
    return [(a + SOURCE_EDGE_OFFSET, b + SOURCE_EDGE_OFFSET) for a, b in raw]


def _rect_span_for_band(band_size: int, travel: int) -> int | None:
    max_len = min(MAX_RECT_SIDE, travel // 2 - 1, MAX_RECT_AREA // band_size)
    min_len = max(MIN_BAND_SIZE, -(-MIN_RECT_AREA // band_size))
    if min_len > max_len:
        return None
    return random.randint(min_len, max_len)


def _build_rects(H: int, W: int, n_vert: int, n_horiz: int) -> list[tuple[int, int, int, int, str]] | None:
    """Return destination rectangles plus their original source edge."""
    vert_edges = [random.choice(["top", "bottom"]) for _ in range(n_vert)]
    horiz_edges = [random.choice(["left", "right"]) for _ in range(n_horiz)]

    col_bands = _interior_bands(W, n_vert)
    if col_bands is None:
        return None
    row_bands = _interior_bands(H, n_horiz)
    if row_bands is None:
        return None

    rects = []
    for i, (c0, c1) in enumerate(col_bands):
        rect_w = c1 - c0 + 1
        rect_h = _rect_span_for_band(rect_w, H)
        if rect_h is None:
            return None
        se = vert_edges[i]
        if se == "top":
            dr0, dr1 = H - rect_h, H - 1
        else:
            dr0, dr1 = 0, rect_h - 1
        rects.append((dr0, c0, dr1, c1, se))

    for i, (r0, r1) in enumerate(row_bands):
        rect_h = r1 - r0 + 1
        rect_w = _rect_span_for_band(rect_h, W)
        if rect_w is None:
            return None
        se = horiz_edges[i]
        if se == "left":
            dc0, dc1 = W - rect_w, W - 1
        else:
            dc0, dc1 = 0, rect_w - 1
        rects.append((r0, dc0, r1, dc1, se))

    return rects


def _random_background(shape: tuple[int, int], grey_frac: float) -> np.ndarray:
    return np.where(np.random.random(shape) < grey_frac, BG_GREY, BG_ORANGE).astype(int)


def _render_output(H: int, W: int, rects: list[tuple[int, int, int, int, str]], grey_frac: float) -> np.ndarray:
    output = _random_background((H, W), grey_frac)

    for (dr0, dc0, dr1, dc1, se) in rects:
        if se in ("top", "bottom"):
            output[:, dc0:dc1 + 1] = BG_ORANGE
        else:
            output[dr0:dr1 + 1, :] = BG_ORANGE

    for (dr0, dc0, dr1, dc1, _) in rects:
        output[dr0:dr1 + 1, dc0:dc1 + 1] = 0
    return output


def _invert_output_to_input(
    output: np.ndarray, rects: list[tuple[int, int, int, int, str]], grey_frac: float
) -> np.ndarray:
    H, W = output.shape
    inp = output.copy()

    for (dr0, dc0, dr1, dc1, se) in rects:
        if se in ("top", "bottom"):
            inp[:, dc0:dc1 + 1] = _random_background((H, dc1 - dc0 + 1), grey_frac)
        else:
            inp[dr0:dr1 + 1, :] = _random_background((dr1 - dr0 + 1, W), grey_frac)

    for (dr0, dc0, dr1, dc1, se) in rects:
        rh, rw = dr1 - dr0 + 1, dc1 - dc0 + 1
        if se == "top":
            inp[0:rh, dc0:dc1 + 1] = 0
        elif se == "bottom":
            inp[H - rh:H, dc0:dc1 + 1] = 0
        elif se == "left":
            inp[dr0:dr1 + 1, 0:rw] = 0
        else:
            inp[dr0:dr1 + 1, W - rw:W] = 0

    return inp


def _is_valid_pair(inp: np.ndarray, output: np.ndarray) -> bool:
    try:
        return bool(np.array_equal(main(inp), output))
    except Exception:
        return False


def _gen_attempt_with_count(n_rects: int) -> np.ndarray | None:
    """Generate a valid input with exactly n_rects black rectangles."""
    counts = _choose_orientation_counts(n_rects)
    if counts is None:
        return None
    n_vert, n_horiz = counts

    canvas = _choose_canvas(n_vert, n_horiz)
    if canvas is None:
        return None
    H, W = canvas

    rects = _build_rects(H, W, n_vert, n_horiz)
    if rects is None:
        return None

    grey_frac = random.uniform(GREY_FRAC_MIN, GREY_FRAC_MAX)
    output = _render_output(H, W, rects, grey_frac)
    inp = _invert_output_to_input(output, rects, grey_frac)
    return inp if _is_valid_pair(inp, output) else None


def generate_input() -> np.ndarray:
    target_count = random.randint(MIN_RECTS, MAX_RECTS)
    for _ in range(TARGET_COUNT_ATTEMPTS):
        result = _gen_attempt_with_count(target_count)
        if result is not None:
            return result
    for _ in range(ANY_COUNT_ATTEMPTS):
        result = _gen_attempt_with_count(random.randint(MIN_RECTS, MAX_RECTS))
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {TARGET_COUNT_ATTEMPTS + ANY_COUNT_ATTEMPTS} attempts")

