from collections import Counter

import numpy as np

from arc_utils import bbox_coords, components_mask, neighbors8
import random
from arc_utils import paste


def _cc8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8)]


def _bbox(pts: list[tuple[int, int]]):
    return bbox_coords(np.asarray(pts))


def _top_k_colors(g: np.ndarray, k: int) -> list[int]:
    return [int(c) for c, _ in Counter(map(int, g.ravel())).most_common(k)]


def _components8_by_color(g: np.ndarray, colors: set[int]) -> list[tuple[int, list[tuple[int, int]]]]:
    return [(int(col), pts) for col in colors for pts in _cc8(g == col)]


_DIAMOND8_OFFSETS = {
    (0, 2),
    (1, 1),
    (1, 3),
    (2, 0),
    (2, 4),
    (3, 1),
    (3, 3),
    (4, 2),
}


def _is_diamond8(comp: list[tuple[int, int]]) -> bool:
    if len(comp) != 8:
        return False
    rs = [r for r, _ in comp]
    cs = [c for _, c in comp]
    r0, r1 = min(rs), max(rs)
    c0, c1 = min(cs), max(cs)
    if (r1 - r0) != 4 or (c1 - c0) != 4:
        return False
    norm = {(r - r0, c - c0) for r, c in comp}
    return norm == _DIAMOND8_OFFSETS


def _outer_line_info(pts: list[tuple[int, int]]):
    # Returns (slope_key, endpoints_sorted_by_r) or None if not diagonal collinear.
    if len(pts) < 2:
        return None
    rs = [r for r, _ in pts]
    cs = [c for _, c in pts]
    if all((r - c) == (rs[0] - cs[0]) for r, c in pts):
        # slope +1, canonical direction (1,1)
        endpoints = sorted(pts, key=lambda p: (p[0], p[1]))
        return ("rc_diff", endpoints)
    if all((r + c) == (rs[0] + cs[0]) for r, c in pts):
        # slope -1, canonical direction (1,-1)
        endpoints = sorted(pts, key=lambda p: (p[0], -p[1]))
        return ("rc_sum", endpoints)
    return None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend diagonal rays outward from outer-border segments adjacent to diamond shapes on a checkerboard.

    Input structure:
    - Checkerboard bg (two most common colors).
    - Hollow diamond outlines (8-pixel) in a non-bg color (inner border).
    - Short diagonal line segments in another non-bg color adjacent to each diamond edge (outer border).

    Rule:
    - For each outer-border segment, determine the outward direction (perpendicular to the segment, away from the diamond).
    - From each endpoint of the segment, cast a diagonal ray outward, painting over bg pixels with the segment's color until hitting a non-bg pixel or the grid edge.

    Key insight: Rays emit only from the two endpoints of each outer-border segment, not every pixel, and travel diagonally away from the diamond.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape

    # The checkerboard background uses the two most frequent colors (typically 0 and 1).
    bg_colors = set(_top_k_colors(g, 2))

    # Find diamond inner borders (size-8 diamond components) in non-background colors.
    non_bg = set(int(v) for v in np.unique(g)) - bg_colors
    comps = _components8_by_color(g, non_bg)
    diamonds: list[tuple[int, list[tuple[int, int]]]] = [(col, pts) for col, pts in comps if _is_diamond8(pts)]

    out = g.copy()

    # Process diamonds in stable order (top-left by bbox).
    def bbox_key(item):
        _, pts = item
        return _bbox(pts)

    for _, dpts in sorted(diamonds, key=bbox_key):
        dset = set(dpts)

        # Collect all adjacent non-bg (non checkerboard) pixels that are not part of the diamond.
        adj = []
        for r, c in dpts:
            for rr, cc in neighbors8(r, c):
                if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dset:
                    v = int(g[rr, cc])
                    if v not in bg_colors:
                        adj.append((rr, cc))

        if not adj:
            continue

        # Build mask for these adjacent pixels and extract their 8-connected components.
        adj_mask = np.zeros((h, w), dtype=bool)
        for r, c in adj:
            adj_mask[r, c] = True
        outer_comps = _cc8(adj_mask)

        for oc in outer_comps:
            ocol = int(g[oc[0][0], oc[0][1]])
            info = _outer_line_info(oc)
            if info is None:
                continue
            slope_key, endpoints = info

            if slope_key == "rc_diff":
                # line direction along (1,1); candidate normals are (-1,1) and (1,-1)
                normals = [(-1, 1), (1, -1)]
            else:
                # line direction along (1,-1); candidate normals are (-1,-1) and (1,1)
                normals = [(-1, -1), (1, 1)]

            # Choose inward normal by best overlap with diamond when shifting outer by that normal.
            best_n = None
            best_score = -1
            for n in normals:
                sc = sum(((r + n[0], c + n[1]) in dset) for r, c in oc)
                if sc > best_score:
                    best_score = sc
                    best_n = n
            if best_n is None or best_score <= 0:
                continue
            outward = (-best_n[0], -best_n[1])

            # Endpoints (two extremes along the diagonal line).
            p0 = endpoints[0]
            p1 = endpoints[-1]
            for pr, pc in (p0, p1):
                rr, cc = pr + outward[0], pc + outward[1]
                while 0 <= rr < h and 0 <= cc < w:
                    if int(out[rr, cc]) in bg_colors:
                        out[rr, cc] = ocol
                    else:
                        break
                    rr += outward[0]
                    cc += outward[1]

    return out

# --------------- generator (Codex attempt 2) ---------------

# ── Tunable parameters ──────────────────────────────────────
GRID_H_RANGE = (20, 24)         # canvas height bounds
GRID_W_RANGE = (14, 30)         # canvas width bounds
DIAMOND_COUNT_RANGE = (1, 3)    # number of diamonds per grid
EDGES_PER_DIAMOND = (2, 4)      # outer-segment edges per diamond
MIN_SEGMENT_LEN = 2             # minimum visible segment pixels (after boundary clip)
COLOR_RANGE = range(2, 10)      # non-background color palette
MAX_GEN_RETRIES = 300           # retry budget for generate_input

# ── Geometry constants ──────────────────────────────────────
_DIAMOND_COORDS = (
    (0, 2), (1, 1), (1, 3),
    (2, 0), (2, 4),
    (3, 1), (3, 3), (4, 2),
)

_EDGE_INFO = {
    "TR": {"segment": ((-1, 3), (0, 4), (1, 5)), "outward": (-1, 1), "slope": "diff"},
    "TL": {"segment": ((-1, 1), (0, 0), (1, -1)), "outward": (-1, -1), "slope": "sum"},
    "BL": {"segment": ((3, -1), (4, 0), (5, 1)), "outward": (1, -1), "slope": "diff"},
    "BR": {"segment": ((3, 5), (4, 4), (5, 3)), "outward": (1, 1), "slope": "sum"},
}
_EDGE_NAMES = tuple(_EDGE_INFO)


def _checkerboard(h: int, w: int) -> np.ndarray:
    """Checkerboard with top-left cell = 1, bg[r,c] = (r+c+1)%2."""
    rows, cols = np.indices((h, w))
    return ((rows + cols + 1) % 2).astype(int)


def _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
    """Set grid[r, c] = color for each (r, c) in cells."""
    for r, c in cells:
        grid[r, c] = color


def _sort_segment(cells: list[tuple[int, int]], slope: str) -> list[tuple[int, int]]:
    """Sort diagonal segment cells by row (and column appropriate to slope direction)."""
    if slope == "diff":
        return sorted(cells, key=lambda p: (p[0], p[1]))
    return sorted(cells, key=lambda p: (p[0], -p[1]))


def _ray_cells(shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
    """Walk diagonally from start+direction until hitting grid boundary."""
    h, w = shape
    dr, dc = direction
    r, c = start[0] + dr, start[1] + dc
    cells: list[tuple[int, int]] = []
    while 0 <= r < h and 0 <= c < w:
        cells.append((r, c))
        r += dr
        c += dc
    return cells


def _candidate_placement(
    h: int, w: int, r0: int, c0: int, edges: tuple[str, ...]
) -> dict[str, object] | None:
    """Build a placement for one diamond at (r0, c0) with the given edge set, or None on conflict."""
    diamond = [(r0 + dr, c0 + dc) for dr, dc in _DIAMOND_COORDS]
    all_cells = set(diamond)
    edge_parts = []
    for edge in edges:
        info = _EDGE_INFO[edge]
        segment = [
            (r0 + dr, c0 + dc)
            for dr, dc in info["segment"]
            if 0 <= r0 + dr < h and 0 <= c0 + dc < w
        ]
        if len(segment) < MIN_SEGMENT_LEN:
            return None
        segment = _sort_segment(segment, info["slope"])
        rays = _ray_cells((h, w), segment[0], info["outward"]) + _ray_cells(
            (h, w), segment[-1], info["outward"]
        )
        part_cells = segment + rays
        if len(set(part_cells)) != len(part_cells) or any(cell in all_cells for cell in part_cells):
            return None
        all_cells.update(part_cells)
        edge_parts.append({"segment": segment, "rays": rays, "weight": len(part_cells)})
    return {"diamond": diamond, "edges": edge_parts, "all_cells": frozenset(all_cells)}


def _search_placements(h: int, w: int, specs: list[tuple[str, ...]]) -> list[dict[str, object]] | None:
    """Find non-overlapping placements for all diamond specs via backtracking search."""
    order = sorted(range(len(specs)), key=lambda i: len(specs[i]), reverse=True)
    even_toplefts = [(r, c) for r in range(h - 4) for c in range(w - 4) if (r + c) % 2 == 0]

    candidate_cache: dict[tuple[str, ...], list[dict[str, object]]] = {}
    for edges in {specs[i] for i in order}:
        positions = even_toplefts[:]
        random.shuffle(positions)
        candidate_cache[edges] = [
            p for r0, c0 in positions
            if (p := _candidate_placement(h, w, r0, c0, edges)) is not None
        ]

    occupied: set[tuple[int, int]] = set()
    placed: list[dict[str, object] | None] = [None] * len(specs)

    def backtrack(i: int) -> bool:
        if i == len(order):
            return True
        spec_i = order[i]
        for placement in candidate_cache[specs[spec_i]]:
            cells = placement["all_cells"]
            if occupied.isdisjoint(cells):
                occupied.update(cells)
                placed[spec_i] = placement
                if backtrack(i + 1):
                    return True
                occupied.difference_update(cells)
                placed[spec_i] = None
        return False

    if not backtrack(0):
        return None
    return [p for p in placed if p is not None]


def _assign_segment_colors(placements: list[dict[str, object]], diamond_colors: list[int]) -> list[list[int]]:
    """Assign segment colors greedily by descending weight, balancing pixel counts across palette."""
    diamond_set = set(diamond_colors)
    palette = [c for c in COLOR_RANGE if c not in diamond_set]
    counts = Counter({c: 0 for c in palette})
    for c in diamond_colors:
        counts[c] += len(_DIAMOND_COORDS)

    # Sort edges by descending weight; assign least-used palette color to each.
    weighted_edges = sorted(
        ((ep["weight"], random.random(), pi, ei)
         for pi, pl in enumerate(placements) for ei, ep in enumerate(pl["edges"])),
        reverse=True,
    )
    segment_colors: list[list[int]] = [[0] * len(pl["edges"]) for pl in placements]
    for _, _, pi, ei in weighted_edges:
        chosen = min(palette, key=lambda c: (counts[c], random.random()))
        segment_colors[pi][ei] = chosen
        counts[chosen] += placements[pi]["edges"][ei]["weight"]
    return segment_colors


def _bg_counts_safe(grid: np.ndarray) -> bool:
    """Ensure both bg colors (0, 1) remain more frequent than any single non-bg color."""
    counts = Counter(map(int, grid.ravel()))
    max_non_bg = max((counts[c] for c in COLOR_RANGE), default=0)
    return counts[0] > max_non_bg and counts[1] > max_non_bg


def _gen_attempt() -> np.ndarray | None:
    """Try to build one valid (input, output) pair; return input grid or None on failure."""
    h = random.randint(*GRID_H_RANGE)
    w = random.randint(*GRID_W_RANGE)
    diamond_count = random.randint(*DIAMOND_COUNT_RANGE)
    specs = [
        tuple(sorted(random.sample(_EDGE_NAMES, random.randint(*EDGES_PER_DIAMOND))))
        for _ in range(diamond_count)
    ]

    placements = _search_placements(h, w, specs)
    if placements is None:
        return None

    diamond_colors = random.sample(list(COLOR_RANGE), len(placements))
    segment_colors = _assign_segment_colors(placements, diamond_colors)

    out = _checkerboard(h, w)
    ray_coords: list[tuple[int, int]] = []
    for pi, placement in enumerate(placements):
        _paint_cells(out, placement["diamond"], diamond_colors[pi])
        for ei, edge_part in enumerate(placement["edges"]):
            color = segment_colors[pi][ei]
            _paint_cells(out, edge_part["segment"], color)
            _paint_cells(out, edge_part["rays"], color)
            ray_coords.extend(edge_part["rays"])

    if not _bg_counts_safe(out):
        return None

    # Derive input by restoring checkerboard at ray positions.
    inp = out.copy()
    if ray_coords:
        rs, cs = zip(*ray_coords)
        rs, cs = np.array(rs), np.array(cs)
        inp[rs, cs] = (rs + cs + 1) % 2

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"failed to generate valid input after {MAX_GEN_RETRIES} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds
import random


def _has_complete_square_border(g: np.ndarray, obj: dict) -> bool:
    r0, c0, r1, c1 = obj["bbox"]
    h = bbox_h(obj["bbox"])
    w = bbox_w(obj["bbox"])
    if h != w or h < 2:
        return False

    color = int(obj["color"])
    return bool(
        np.all(g[r0, c0 : c1 + 1] == color)
        and np.all(g[r1, c0 : c1 + 1] == color)
        and np.all(g[r0 : r1 + 1, c0] == color)
        and np.all(g[r0 : r1 + 1, c1] == color)
    )


def _corner_marker_coords(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    return [
        (r0 - 1, c0),
        (r0, c0 - 1),
        (r0 - 1, c1),
        (r0, c1 + 1),
        (r1 + 1, c0),
        (r1, c0 - 1),
        (r1 + 1, c1),
        (r1, c1 + 1),
    ]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Mark every complete square object with red pixels just outside its corners.

    Input structure:
    - A uniform background contains one or more monochrome 4-connected foreground objects.
    - The relevant objects are square frames or filled squares: their bbox is square
      and all cells on the bbox border have the object's color.
    - Non-square bars and incomplete fragments may also appear and are ignored.

    Rule:
    - Keep the input unchanged.
    - For each complete square object, paint red on the two outside background
      pixels orthogonally adjacent to each of the square's four corners.

    Key insight: The transformation is not based on size or color; it selects
    objects whose bounding box is a complete square border and labels only their
    exposed outer corner-adjacent cells.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    out = g.copy()

    square_objects = [
        obj
        for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True)
        if _has_complete_square_border(g, obj)
    ]
    assert square_objects, "expected at least one complete square object"

    for obj in square_objects:
        coords = _corner_marker_coords(obj["bbox"])
        for r, c in coords:
            assert in_bounds(g.shape, r, c), "square object should have one-cell outside margin"
            assert int(g[r, c]) == int(bg), "corner marker positions should be background"
            out[r, c] = Color.RED

    return out

# --------------- generator (c) ---------------

# ---- Configuration ----
GRID_H, GRID_W = 10, 10
BG_COLOR = Color.ORANGE                       # background color (7)
FG_COLORS = [Color.PINK, Color.TEAL]          # foreground color choices
SQUARE_COUNT_RANGE = [1, 2, 3, 4]             # number of squares to attempt
SQUARE_SIZE_MIN = 2                            # minimum square side length
MAX_SZ_BY_COUNT = {1: 8, 2: 6, 3: 5, 4: 4}   # max square size per count
EDGE_MARGIN = 1                                # min gap from grid edge for squares
DISTRACTOR_COUNT_MAX = 5                       # max distractor objects
DISTRACTOR_TYPES = ['pixel', 'hbar', 'vbar', 'rect']
DISTRACTOR_BAR_RANGE = (2, 4)                  # bar/rect dimension range
DISTRACTOR_PLACE_RETRIES = 80                  # retries per distractor placement
GEN_MAX_RETRIES = 300                          # outer generate_input retry limit


def _marker_coords(r0, c0, sz):
    """Return the 8 corner-adjacent cells outside a square at (r0,c0) with side `sz`."""
    r1, c1 = r0 + sz - 1, c0 + sz - 1
    return [
        (r0 - 1, c0), (r0, c0 - 1),
        (r0 - 1, c1), (r0, c1 + 1),
        (r1 + 1, c0), (r1, c0 - 1),
        (r1 + 1, c1), (r1, c1 + 1),
    ]


def _border_mask(r0, c0, sz, shape):
    """Return a boolean mask with True on the border cells of a square."""
    mask = np.zeros(shape, dtype=bool)
    r1, c1 = r0 + sz - 1, c0 + sz - 1
    mask[r0, c0:c1+1] = True
    mask[r1, c0:c1+1] = True
    mask[r0:r1+1, c0] = True
    mask[r0:r1+1, c1] = True
    return mask


def _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg):
    """Draw a square frame (or filled 2x2) onto the grid and update tracking masks."""
    r1, c1 = r0 + sz - 1, c0 + sz - 1
    if sz == 2:
        grid[r0:r1+1, c0:c1+1] = fg
    else:
        grid[r0, c0:c1+1] = fg
        grid[r1, c0:c1+1] = fg
        grid[r0:r1+1, c0] = fg
        grid[r0:r1+1, c1] = fg
    occupied |= _border_mask(r0, c0, sz, grid.shape)
    for mr, mc in _marker_coords(r0, c0, sz):
        marker_reserved[mr, mc] = True


def _distractor_dims(dtype):
    """Return (height, width) for a distractor of the given type."""
    lo, hi = DISTRACTOR_BAR_RANGE
    if dtype == 'pixel':
        return 1, 1
    elif dtype == 'hbar':
        return 1, random.randint(lo, hi)
    elif dtype == 'vbar':
        return random.randint(lo, hi), 1
    else:
        dh = random.randint(lo, hi)
        dw = random.randint(lo, hi)
        if dh == dw:
            dw = dh + 1 if dh < hi else dh - 1
        return dh, dw


def _gen_attempt() -> np.ndarray | None:
    fg = random.choice(FG_COLORS)
    grid = np.full((GRID_H, GRID_W), BG_COLOR, dtype=int)
    occupied = np.zeros((GRID_H, GRID_W), dtype=bool)
    marker_reserved = np.zeros((GRID_H, GRID_W), dtype=bool)

    num_squares = random.choice(SQUARE_COUNT_RANGE)
    max_sz = MAX_SZ_BY_COUNT[num_squares]
    sizes = sorted([random.randint(SQUARE_SIZE_MIN, max_sz)
                     for _ in range(num_squares)], reverse=True)

    placed_squares = []

    def can_place(r0, c0, sz):
        r1, c1 = r0 + sz - 1, c0 + sz - 1
        if r0 < EDGE_MARGIN or c0 < EDGE_MARGIN or r1 > GRID_H - EDGE_MARGIN - 1 or c1 > GRID_W - EDGE_MARGIN - 1:
            return False
        for mr, mc in _marker_coords(r0, c0, sz):
            if mr < 0 or mr >= GRID_H or mc < 0 or mc >= GRID_W:
                return False
            if occupied[mr, mc] or marker_reserved[mr, mc]:
                return False
        # Border cells must not overlap existing occupied cells
        if (np.any(occupied[r0, c0:c1+1]) or np.any(occupied[r1, c0:c1+1]) or
                np.any(occupied[r0:r1+1, c0]) or np.any(occupied[r0:r1+1, c1])):
            return False
        return True

    for sz in sizes:
        positions = [(r0, c0)
                     for r0 in range(EDGE_MARGIN, GRID_H - sz)
                     for c0 in range(EDGE_MARGIN, GRID_W - sz)
                     if can_place(r0, c0, sz)]
        if not positions:
            continue
        r0, c0 = random.choice(positions)
        _draw_square(grid, occupied, marker_reserved, r0, c0, sz, fg)
        placed_squares.append((r0, c0, sz))

    if not placed_squares:
        return None

    # Place distractors
    num_distractors = random.randint(0, DISTRACTOR_COUNT_MAX)
    for _ in range(num_distractors):
        dtype = random.choice(DISTRACTOR_TYPES)
        for _try in range(DISTRACTOR_PLACE_RETRIES):
            dh, dw = _distractor_dims(dtype)
            r0 = random.randint(0, GRID_H - dh)
            c0 = random.randint(0, GRID_W - dw)
            region = grid[r0:r0+dh, c0:c0+dw]
            reserved = marker_reserved[r0:r0+dh, c0:c0+dw]
            if np.all(region == BG_COLOR) and not np.any(reserved):
                grid[r0:r0+dh, c0:c0+dw] = fg
                occupied[r0:r0+dh, c0:c0+dw] = True
                break

    # Validate with solver
    try:
        out = main(grid)
    except Exception:
        return None

    expected = grid.copy()
    for r0, c0, sz in placed_squares:
        for mr, mc in _marker_coords(r0, c0, sz):
            expected[mr, mc] = Color.RED
    if not np.array_equal(out, expected):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate input after %d attempts" % GEN_MAX_RETRIES)

