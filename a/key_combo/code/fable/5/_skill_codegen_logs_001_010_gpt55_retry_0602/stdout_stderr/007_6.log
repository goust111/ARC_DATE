+) -> list[np.ndarray] | None:
+    """Place visible sprites above the base with one-cell bbox separation."""
+    h, w = grid.shape
+    order = sorted(range(len(masks)), key=lambda i: masks[i].size, reverse=True)
+    reserved = np.zeros((h, w), dtype=bool)
