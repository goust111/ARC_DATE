+        return False
+    for color, mask in zip(colors, masks):
+        if int(np.count_nonzero(inp == color)) != int(mask.sum()):
+            return False
+        if int(np.count_nonzero(actual == color)) != int(mask.sum()):
+            return False
+    return True
+
