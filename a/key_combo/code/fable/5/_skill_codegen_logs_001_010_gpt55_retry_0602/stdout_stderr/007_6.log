+    for i in range(1, len(masks)):
+        left = placements[i][1]
+        width = masks[i].shape[1]
+        if np.array_equal(
+            surfaces[i - 1][left : left + width],
+            surfaces[i][left : left + width],
+        ):
+            return False
+
