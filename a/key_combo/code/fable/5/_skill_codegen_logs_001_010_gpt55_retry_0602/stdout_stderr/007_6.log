+
+def _semantic_audit(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    masks: list[np.ndarray],
+    colors: list[int],
+    placements: list[tuple[int, int]],
+    surfaces: list[np.ndarray],
+) -> bool:
+    """Check rule semantics, counterfactual dependencies, and rendered output."""
