+def _render_base(
+    height: int, width: int, bg: int, base_color: int, surface: np.ndarray
+) -> np.ndarray:
+    grid = np.full((height, width), bg, dtype=int)
+    for c, top in enumerate(surface):
+        grid[int(top) :, c] = base_color
+    return grid
