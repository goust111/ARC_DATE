+def _generate_attempt() -> np.ndarray | None:
+    height = random.randint(25, 30)
+    width = random.randint(17, 26)
+    count = random.randint(3, 5)
+    chain = _build_chain(height, width, count)
+    if chain is None:
+        return None
+    masks, placements, surfaces = chain
