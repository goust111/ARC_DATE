+    """Normalize coordinates to their inclusive bbox and return its mask."""
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
