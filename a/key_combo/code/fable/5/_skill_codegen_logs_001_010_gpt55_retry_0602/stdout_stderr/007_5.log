    raise RuntimeError("Failed to generate input after %d attempts" % GEN_MAX_RETRIES)
    indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}

    for i, (ca, _ra, wa) in enumerate(group):
        for cb, _rb, wb in group[i + 1 :]:
            overlap = wa & wb
            if not bool(overlap.any()):
                continue
            visible = set(int(v) for v in np.unique(g[overlap]))
            top_colors = visible & {int(ca), int(cb)}
            assert len(top_colors) == 1
            top = top_colors.pop()
            under = int(cb) if top == int(ca) else int(ca)
            if top not in above[under]:
                above[under].add(top)
                indegree[top] += 1

    ordered: list[tuple[int, int, np.ndarray]] = []
    remaining = set(by_color)
    while remaining:
        ready = [color for color in remaining if indegree[color] == 0]
        assert len(ready) == 1
        color = ready[0]
        remaining.remove(color)
        ordered.append(by_color[color])
        for nxt in above[color]:
            indegree[nxt] -= 1
    return ordered


def main(grid: np.ndarray) -> np.ndarray:
    """
    Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.

    Input structure:
    - Black background with several axis-aligned colored line drawings.
    - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.
    - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.

    Rule:
    - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.
    - Count the 4-connected background regions fully enclosed by those reconstructed walls.
    - The color with no enclosed region is the noise/pad color.
    - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.

    Key insight:
    - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    assert bg == 0

    counts: list[tuple[int, int, np.ndarray]] = []
    for color in colors_present(g, exclude={bg}):
        rooms = _room_count_for_color(g, int(color))
        walls = _walls_for_color(g, int(color))
        counts.append((int(color), int(rooms), walls))

    drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]
    pad_colors = [color for color, rooms, _walls in counts if rooms == 0]
    assert drawings
    assert len(pad_colors) == 1

    pad = int(pad_colors[0])
    ordered: list[tuple[int, int, np.ndarray]] = []
    for rooms in sorted({rooms for _color, rooms, _walls in drawings}):
        group = [item for item in drawings if item[1] == rooms]
        ordered.extend(_cover_order(g, group))

    width = max(rooms for _color, rooms, _walls in ordered)

    out = np.full((len(ordered), width), pad, dtype=int)
    for r, (color, rooms, _walls) in enumerate(ordered):
        out[r, :rooms] = int(color)
    return out

# --------------- generator (claude-opus-4-6) ---------------

# ---- CFG: Tunable generation parameters ----
_FRAME_COUNT_RANGE = (3, 5)           # number of colored frames per puzzle
_ROOM_COUNT_RANGE = (1, 6)            # rooms per frame
_TIE_PROBABILITY = 0.35              # chance of one tied room-count pair
_GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)
    5: (25, 30, 25, 30, 16, 18),
    4: (22, 30, 22, 30, 18, 22),
    3: (20, 30, 20, 30, 22, 25),
}
_CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame
_NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise
_WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise
_EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force
_OVERLAP_RETRY = 100                 # attempts to place overlapping frame
_GEN_RETRIES = 300                   # outer retry limit


def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:
    """Generate n gaps each in [min_gap, max_gap] with sum <= max_total."""
    if n * min_gap > max_total:
        return None
    gaps = [min_gap] * n
    remaining = max_total - sum(gaps)
    for i in range(n):
    # --- Place frames (largest first, random position) ---
    positions = [None] * frame_count
    for idx in sorted(range(frame_count), key=lambda i: -frames[i][2].size):
        fh, fw = frames[idx][2].shape
        positions[idx] = (random.randint(0, grid_h - fh), random.randint(0, grid_w - fw))

    # --- Force overlaps for tied pairs ---
    tied_pairs = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)
                  if room_counts[i] == room_counts[j]]
    for i, j in tied_pairs:
        _force_overlap(positions, i, j, frames, grid_h, grid_w)

    # --- Force some non-tied overlaps ---
    non_tied = [(i, j) for i in range(frame_count) for j in range(i + 1, frame_count)
                if room_counts[i] != room_counts[j]]
    n_extra = random.randint(*_EXTRA_OVERLAP_RANGE)
    if n_extra > 0 and non_tied:
        random.shuffle(non_tied)
        for i, j in non_tied[:min(n_extra, len(non_tied))]:
            _force_overlap(positions, i, j, frames, grid_h, grid_w)

    # --- Render and add noise ---
    render_order = list(range(frame_count))
    random.shuffle(render_order)

    grid, frame_mask = _render_frames(frames, positions, render_order, grid_h, grid_w)
    _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w)

    # --- Validate via solver oracle ---
    try:
        output = main(grid)
    except Exception:
        return None

    # Build expected output: rows sorted by (room_count, render_order position)
    frame_info = sorted(
        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])
    max_rooms = max(rc for rc, _, _ in frame_info)
    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)
    for r, (rc, _, color) in enumerate(frame_info):
        expected[r, :rc] = color

    return grid if np.array_equal(output, expected) else None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {_GEN_RETRIES} attempts")
from __future__ import annotations
import random
import numpy as np
from arc_utils import bbox_coords, is_contiguous, label_mask, paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Connect two sprites using matching connector pixels, then tight-crop.

    Input structure:
    - Background color `bg`, sprite color `obj`, connector color `ctrl` (small, 2 components).
    - Two main foreground sprites, plus possibly tiny detached pixels belonging to one sprite.

    Rule:
    - Identify the **base** sprite (closest to grid top-left).
    - Translate the other sprite so its connector sits one cell above the base's connector.
    - Stamp the plug onto the base; remove connectors (recolor `ctrl` to `obj`).
    - Output is the tight crop around all non-background pixels.

    Key insight: The connector pixels define the unique docking point and direction.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    # Fixed colors (consistent across all eval examples)
    bg, obj, ctrl = 1, 4, 7

    # Build foreground components (8-connected: sprites may touch diagonally)
    lab, n = label_mask(g != bg, connectivity=8)
    best_comps = []
    for k in range(1, int(n) + 1):
        pts = {(int(r), int(c)) for r, c in np.argwhere(lab == int(k))}
        best_comps.append(pts)
    best_comps.sort(key=len, reverse=True)
    assert len(best_comps) == 2  # exactly 2 sprites, no fragments
    A = set(best_comps[0])
    B = set(best_comps[1])

    def bbox_of_pts(pts: set[tuple[int, int]]) -> tuple[int, int, int, int]:
        coords = np.array(list(pts), dtype=int)
        r0, c0, r1, c1 = bbox_coords(coords)
        return int(r0), int(c0), int(r1), int(c1)

    def conn(sprite: set[tuple[int, int]]):
        return {(r, c) for (r, c) in sprite if int(g[int(r), int(c)]) == int(ctrl)}

    connA = conn(A)
    connB = conn(B)
    assert not (not connA or not connB)

    def norm(conn_pts: set[tuple[int, int]]):
        rs = [r for r, _c in conn_pts]
        cs = [c for _r, c in conn_pts]
        r0, c0 = int(min(rs)), int(min(cs))
        shape = {(int(r - r0), int(c - c0)) for r, c in conn_pts}
        return shape, (int(r0), int(c0))

    shpA, (ar0, ac0) = norm(connA)
    shpB, (br0, bc0) = norm(connB)
    assert not (shpA != shpB)

    # base = sprite whose bbox top-left is closest to (0,0)
    r0a, c0a, _r1a, _c1a = bbox_of_pts(A)
    r0b, c0b, _r1b, _c1b = bbox_of_pts(B)
    # Base must be anchored at grid top-left corner
    assert int(r0a + c0a) == 0 or int(r0b + c0b) == 0
    if int(r0a + c0a) <= int(r0b + c0b):
        base, connD = A, connA
        plug, connP = B, connB
    else:
        base, connD = B, connB
        plug, connP = A, connA

    # Connectors dock vertically: base connector's free side faces down,
    # plug connector's free side faces up.
    base_body = base - connD
    plug_body = plug - connP
    for r, c in connD:
        assert (int(r + 1), int(c)) not in base_body  # base: free side down
    for r, c in connP:
        assert (int(r - 1), int(c)) not in plug_body  # plug: free side up

    _sp, (pr0, pc0) = norm(connP)
    _sd, (dr0, dc0) = norm(connD)

    # place plug connector directly above base connector
    tr = int((dr0 - 1) - pr0)
    tc = int(dc0 - pc0)
    plug_shift = {(int(r + tr), int(c + tc)) for r, c in plug}

    # render on minimal bbox
    pts_all = base | plug_shift
    coords_all = np.array(list(pts_all), dtype=int)
    rr0, cc0, rr1, cc1 = bbox_coords(coords_all)
    rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))
    # Base must remain at output top-left after tight crop
    base_coords = np.array(list(base), dtype=int)
    br0, bc0 = int(base_coords[:, 0].min()), int(base_coords[:, 1].min())
    assert rr0 == br0 and cc0 == bc0  # plug must not extend above/left of base
    out = np.full((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), int(bg), dtype=int)

    base_sprite = crop(base_grid)
    plug_sprite = crop(plug_grid)
    if base_sprite is None or plug_sprite is None:
        return None
    bh, bw = base_sprite.shape
    ph, pw = plug_sprite.shape

    # Step 4: place on canvas — base at (0,0), plug elsewhere
    canvas_h = _rng.randint(max(7, max(bh, ph) + 2), 11)
    canvas_w = _rng.randint(max(3, max(bw, pw)), 13)
    if bh > canvas_h or bw > canvas_w or ph > canvas_h or pw > canvas_w:
        return None

    canvas = np.full((canvas_h, canvas_w), bg, dtype=int)
    paste(canvas, base_sprite, 0, 0, transparent=bg)
    try:
        pr, pc = random_free_location(canvas, plug_sprite, transparent=bg, padding=0)
    except ValueError:
        return None
    if pr + pc == 0:
        return None
    paste(canvas, plug_sprite, pr, pc, transparent=bg)

    if np.sum(canvas == bg) <= canvas.size // 2:
        return None

    # Step 5: oracle verify
    try:
        result = main(canvas)
    except Exception:
        return None
    # result should be non-trivial
    if result.size == 0 or not np.any(result != bg):
        return None
    return canvas


def generate_input():
    for _ in range(300):
        g = _gen_attempt()
        if g is not None:
            return g
    raise RuntimeError("generate_input: failed after 300 attempts")

