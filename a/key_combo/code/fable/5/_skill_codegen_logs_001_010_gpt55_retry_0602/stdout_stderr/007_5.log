    for _ in range(GEN_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate a valid 6ca952ad input")
from collections import Counter

import numpy as np

from arc_utils import bbox_coords, components_mask, neighbors8
import random
from arc_utils import paste


def _cc8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8)]


def _bbox(pts: list[tuple[int, int]]):
    return bbox_coords(np.asarray(pts))


def _top_k_colors(g: np.ndarray, k: int) -> list[int]:
    return [int(c) for c, _ in Counter(map(int, g.ravel())).most_common(k)]


def _components8_by_color(g: np.ndarray, colors: set[int]) -> list[tuple[int, list[tuple[int, int]]]]:
    return [(int(col), pts) for col in colors for pts in _cc8(g == col)]


_DIAMOND8_OFFSETS = {
    (0, 2),
    (1, 1),
    (1, 3),
    (2, 0),
    (2, 4),
    (3, 1),
    (3, 3),
    (4, 2),
}


def _is_diamond8(comp: list[tuple[int, int]]) -> bool:
    if len(comp) != 8:
        return False
    rs = [r for r, _ in comp]
    cs = [c for _, c in comp]
    r0, r1 = min(rs), max(rs)
    c0, c1 = min(cs), max(cs)
    if (r1 - r0) != 4 or (c1 - c0) != 4:
        return False
    norm = {(r - r0, c - c0) for r, c in comp}
    return norm == _DIAMOND8_OFFSETS


def _outer_line_info(pts: list[tuple[int, int]]):
    # Returns (slope_key, endpoints_sorted_by_r) or None if not diagonal collinear.
    if len(pts) < 2:
        return None
    rs = [r for r, _ in pts]
    cs = [c for _, c in pts]
    if all((r - c) == (rs[0] - cs[0]) for r, c in pts):
        # slope +1, canonical direction (1,1)
        endpoints = sorted(pts, key=lambda p: (p[0], p[1]))
        return ("rc_diff", endpoints)
    if all((r + c) == (rs[0] + cs[0]) for r, c in pts):
        # slope -1, canonical direction (1,-1)
        endpoints = sorted(pts, key=lambda p: (p[0], -p[1]))
        return ("rc_sum", endpoints)
    return None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend diagonal rays outward from outer-border segments adjacent to diamond shapes on a checkerboard.

    Input structure:
    - Checkerboard bg (two most common colors).
    - Hollow diamond outlines (8-pixel) in a non-bg color (inner border).
    - Short diagonal line segments in another non-bg color adjacent to each diamond edge (outer border).

    Rule:
    - For each outer-border segment, determine the outward direction (perpendicular to the segment, away from the diamond).
    - From each endpoint of the segment, cast a diagonal ray outward, painting over bg pixels with the segment's color until hitting a non-bg pixel or the grid edge.

    Key insight: Rays emit only from the two endpoints of each outer-border segment, not every pixel, and travel diagonally away from the diamond.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape

    # The checkerboard background uses the two most frequent colors (typically 0 and 1).
    bg_colors = set(_top_k_colors(g, 2))

    # Find diamond inner borders (size-8 diamond components) in non-background colors.
    non_bg = set(int(v) for v in np.unique(g)) - bg_colors
    comps = _components8_by_color(g, non_bg)
    diamonds: list[tuple[int, list[tuple[int, int]]]] = [(col, pts) for col, pts in comps if _is_diamond8(pts)]

    out = g.copy()

    # Process diamonds in stable order (top-left by bbox).
    def bbox_key(item):
        _, pts = item
        return _bbox(pts)

    for _, dpts in sorted(diamonds, key=bbox_key):
        dset = set(dpts)

        # Collect all adjacent non-bg (non checkerboard) pixels that are not part of the diamond.
        adj = []
        for r, c in dpts:
            for rr, cc in neighbors8(r, c):
                if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dset:
                    v = int(g[rr, cc])
                    if v not in bg_colors:
                        adj.append((rr, cc))

        if not adj:
            continue

        # Build mask for these adjacent pixels and extract their 8-connected components.
        adj_mask = np.zeros((h, w), dtype=bool)
        for r, c in adj:
            adj_mask[r, c] = True
        outer_comps = _cc8(adj_mask)

        for oc in outer_comps:
            ocol = int(g[oc[0][0], oc[0][1]])
            info = _outer_line_info(oc)
            if info is None:
                continue
            slope_key, endpoints = info

            if slope_key == "rc_diff":
                # line direction along (1,1); candidate normals are (-1,1) and (1,-1)
                normals = [(-1, 1), (1, -1)]
            else:
                # line direction along (1,-1); candidate normals are (-1,-1) and (1,1)
                normals = [(-1, -1), (1, 1)]

            # Choose inward normal by best overlap with diamond when shifting outer by that normal.
            best_n = None
            best_score = -1
            for n in normals:
                sc = sum(((r + n[0], c + n[1]) in dset) for r, c in oc)
                if sc > best_score:
                    best_score = sc
                    best_n = n
            if best_n is None or best_score <= 0:
                continue

def _gen_attempt() -> np.ndarray | None:
    """Try to build one valid (input, output) pair; return input grid or None on failure."""
    h = random.randint(*GRID_H_RANGE)
    w = random.randint(*GRID_W_RANGE)
    diamond_count = random.randint(*DIAMOND_COUNT_RANGE)
    specs = [
        tuple(sorted(random.sample(_EDGE_NAMES, random.randint(*EDGES_PER_DIAMOND))))
        for _ in range(diamond_count)
    ]

    placements = _search_placements(h, w, specs)
    if placements is None:
        return None

    diamond_colors = random.sample(list(COLOR_RANGE), len(placements))
    segment_colors = _assign_segment_colors(placements, diamond_colors)

    out = _checkerboard(h, w)
    ray_coords: list[tuple[int, int]] = []
    for pi, placement in enumerate(placements):
        _paint_cells(out, placement["diamond"], diamond_colors[pi])
        for ei, edge_part in enumerate(placement["edges"]):
            color = segment_colors[pi][ei]
            _paint_cells(out, edge_part["segment"], color)
            _paint_cells(out, edge_part["rays"], color)
            ray_coords.extend(edge_part["rays"])

    if not _bg_counts_safe(out):
        return None

    # Derive input by restoring checkerboard at ray positions.
    inp = out.copy()
    if ray_coords:
        rs, cs = zip(*ray_coords)
        rs, cs = np.array(rs), np.array(cs)
        inp[rs, cs] = (rs + cs + 1) % 2

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"failed to generate valid input after {MAX_GEN_RETRIES} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import bbox, colors_present, components_mask, get_bg, in_bounds
import random


DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
ORTHOGONALS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _strictly_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
    return outer[0] < inner[0] and outer[1] < inner[1] and outer[2] > inner[2] and outer[3] > inner[3]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Paint the inner foreground color into every background pixel that touches the enclosing frame only diagonally.

    Input structure:
    - The grid has one dominant background color and exactly two foreground colors.
    - One foreground color is an enclosing frame: its bbox strictly contains the bbox of the other, inner color.

    Rule:
    - Keep all existing pixels unchanged.
    - For each background pixel, if it is diagonally adjacent to the frame color and has no orthogonal adjacency to the frame color, recolor it to the inner color.

    Key insight: The inner color marks the color to use, while the frame's diagonal-only background neighbors define the cells to add.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, f"expected exactly two foreground colors, got {colors}"

    boxes: dict[int, tuple[int, int, int, int]] = {}
    for color in colors:
        b = bbox(g == int(color))
        assert b is not None, f"foreground color {color} has no bbox"
        boxes[int(color)] = b

    role_pairs = [
        (outer, inner)
        for outer in colors
        for inner in colors
        if outer != inner and _strictly_contains(boxes[int(outer)], boxes[int(inner)])
    ]
    assert len(role_pairs) == 1, f"expected one enclosing frame color, got {role_pairs}"
    frame_color, inner_color = map(int, role_pairs[0])

    assert len(components_mask(g != bg, connectivity=8)) == 1, "all foreground must be one 8-connected component"

    out = g.copy()
    H, W = g.shape
    for r in range(H):
        for c in range(W):
            if int(g[r, c]) != bg:
                continue

            has_diagonal_frame = any(
                in_bounds(g.shape, r + dr, c + dc) and int(g[r + dr, c + dc]) == frame_color
                for dr, dc in DIAGONALS
            )
            if not has_diagonal_frame:
                continue

            has_orthogonal_frame = any(
                in_bounds(g.shape, r + dr, c + dc) and int(g[r + dr, c + dc]) == frame_color
                for dr, dc in ORTHOGONALS
            )
            if not has_orthogonal_frame:
                has_orthogonal_inner = any(
                    in_bounds(g.shape, r + dr, c + dc) and int(g[r + dr, c + dc]) == inner_color
                    for dr, dc in ORTHOGONALS
                )
                assert not has_orthogonal_inner, "new pixel must not be orthogonally adjacent to inner color"
                out[r, c] = inner_color

    return out

# --------------- generator (att1, Claude) ---------------

# Canvas and palette.
BG = 7
GRID_H, GRID_W = 16, 16
FOREGROUND_COLORS = [c for c in range(10) if c != BG]

# Local rendering colors and fill-rule geometry.
LOCAL_FRAME_COLOR, LOCAL_INNER_COLOR = 1, 2
PAD = 2
DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
ORTHOGONALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]

# Frame geometry and accepted output-fill size.
FRAME_H_RANGE = (4, 7)
FRAME_W_RANGE = (4, 7)
FRAME_PIXELS_MIN, FRAME_PIXELS_MAX = 4, 21
FRAME_DENSITY_MIN, FRAME_DENSITY_MAX = 0.25, 0.50
FILL_COUNT_MIN, FILL_COUNT_MAX = 12, 15

    for r, c in frame_coords:
        grid[pr + PAD + r, pc + PAD + c] = frame_color
    for r, c in inner_coords:
        grid[pr + PAD + r, pc + PAD + c] = inner_color
    return grid


def _gen_attempt():
    frame_color, inner_color = random.sample(FOREGROUND_COLORS, 2)
    frame_h = random.randint(*FRAME_H_RANGE)
    frame_w = random.randint(*FRAME_W_RANGE)

    inner_coords = _choose_inner(frame_h, frame_w)
    if inner_coords is None:
        return None

    frame_coords = _build_frame(frame_h, frame_w, inner_coords)
    if frame_coords is None:
        return None

    padded = _validated_padded(frame_coords, inner_coords, frame_h, frame_w)
    if padded is None:
        return None

    grid = _place_on_grid(frame_coords, inner_coords, frame_h, frame_w, padded, frame_color, inner_color)
    if grid is None:
        return None

    try:
        main(grid)
    except Exception:
        return None

    return grid


def generate_input():
    for _ in range(MAX_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {MAX_ATTEMPTS} attempts")
from functools import reduce
from math import gcd

import numpy as np
import random
from itertools import combinations
from arc_utils import paste

def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
    """
    Infer a regular cell grid separated by full rows/cols of the same line color.
    Returns (step, row_divs, col_divs) where:
      - row_divs/col_divs are divider indices
      - step is the spacing between dividers (cell size including divider).
    """
    h, w = g.shape
    line = int(g[0, 0])
    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
    row_divs.sort()
    col_divs.sort()
    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
    step = reduce(gcd, drs + dcs)
    assert step > 1, "divider step must be > 1"
    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
    return int(step), row_divs, col_divs


def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale a minority cell's inner pattern up to the cell-grid level, completing a fractal overlay.

    Input structure:
    - Grid divided into NxN cells by separator lines of a single color.
    - Most cells share an identical interior pattern (majority); a few have a distinct pattern (minority).

    Rule:
    - Extract the inner pixel pattern from the minority cell.
    - Treat each pixel as a cell-sized stamp: active pixels → minority pattern, inactive → majority pattern.
    - Position this scaled-up pattern on the cell grid so existing minority cells align with active pixels.
    - Fill in all remaining active positions with the minority pattern.

    Key insight: The minority cell's interior is a miniature blueprint of where minority cells should appear at the grid scale — fractal self-similarity.
    """
    g = np.asarray(grid, dtype=int)
    step, _, _ = _infer_cell_grid_params(g)
    n = (g.shape[0] - 1) // step
    inner = step - 1

    # Extract interior patterns per cell.
    patterns: dict[tuple[int, ...], np.ndarray] = {}
    cell_pat: list[list[tuple[int, ...]]] = []
    for i in range(n):
        row: list[tuple[int, ...]] = []
        for j in range(n):
            r0 = i * step + 1
            c0 = j * step + 1
            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
            pat = tuple(pat_arr.ravel().tolist())
            if pat not in patterns:
                patterns[pat] = pat_arr
            row.append(pat)
        cell_pat.append(row)

    # Find minority/majority cell patterns.
    counts: dict[tuple[int, ...], int] = {}
    for i in range(n):
        for j in range(n):
            p = cell_pat[i][j]
            counts[p] = counts.get(p, 0) + 1
    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority + majority)"

    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
    minority_arr = patterns[minority_pat]

    # Mask derived from the minority cell's inner pattern:
    # active color is the most frequent color within the minority pattern.
    _vals, _cnts = np.unique(minority_arr, return_counts=True)
    active_color = int(_vals[_cnts.argmax()])
    mask = (minority_arr == active_color)
    mh, mw = mask.shape

    existing = np.zeros((n, n), dtype=bool)
    for i in range(n):
        for j in range(n):
            existing[i, j] = cell_pat[i][j] == minority_pat

    # Find the unique placement of the m×m mask in the cell grid such that:
    # - all existing minority cells lie within the block
    # - within the block, existing minority cells only occur where mask is True
    candidates: list[tuple[int, int]] = []
    for top in range(0, n - mh + 1):
        for left in range(0, n - mw + 1):
            block = np.zeros_like(existing)
            block[top : top + mh, left : left + mw] = True
            if np.any(existing & ~block):
                continue
            ex_block = existing[top : top + mh, left : left + mw]
            if np.any(ex_block & ~mask):
                continue
            candidates.append((int(top), int(left)))
    assert len(candidates) == 1, "must have a unique mask placement aligning existing minority cells"
    top, left = candidates[0]

    out = g.copy()
    for i in range(mh):
        for j in range(mw):
            target_pat = minority_arr if mask[i, j] else patterns[majority_pat]
            r0 = (top + i) * step + 1
            c0 = (left + j) * step + 1
            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
    return out

# --------------- generator (o5x) ---------------

# --- CFG: tunable generation parameters ---
CELL_GRID_N = 7           # number of cells per row/col in the 7x7 cell grid
CELL_INNER = 3            # interior size of each cell (3x3)
CELL_STEP = 4             # stride between cell origins (inner + 1 divider)
GRID_SIZE = 29            # full pixel grid: N*STEP+1

def _build_grid(separator, majority, minority, active_cells):
    """Construct a 29x29 grid: fill all cells with majority, then overwrite active_cells."""
    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
    for i in range(CELL_GRID_N):
        for j in range(CELL_GRID_N):
            paste(grid, majority, *_cell_origin(i, j))
    for i, j in active_cells:
        paste(grid, minority, *_cell_origin(i, j))
    return grid


def _gen_attempt():
    """Single generation attempt: build output, choose input subset, verify with solver."""
    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
    majority = _random_lr_pattern(shared, maj_exclusive)
    mask = _random_minority_mask()
    minority = np.where(mask, min_exclusive, shared).astype(int)

    top = random.randrange(PLACEMENT_RANGE)
    left = random.randrange(PLACEMENT_RANGE)
    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
    out = _build_grid(separator, majority, minority, active_cells)

    subset = _choose_given_subset(mask, top, left)
    if subset is None:
        return None
    given_cells = [(top + r, left + c) for r, c in subset]
    inp = _build_grid(separator, majority, minority, given_cells)

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


def generate_input():
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b99e7126 input")

