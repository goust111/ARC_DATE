+
+def _validate_generated(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    n: int,
+    majority: np.ndarray,
+    pattern_a: np.ndarray,
+    pattern_b: np.ndarray,
+    blueprint_a: np.ndarray,
+    blueprint_b: np.ndarray,
+    shown_a: set[tuple[int, int]],
+    shown_b: set[tuple[int, int]],
+) -> bool:
