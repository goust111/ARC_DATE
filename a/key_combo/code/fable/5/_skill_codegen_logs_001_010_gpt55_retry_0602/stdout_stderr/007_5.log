+    q_cells = np.array([[keys[r][c] == q_key for c in range(n)] for r in range(n)], dtype=bool)
+    majority_cells = np.array(
+        [[keys[r][c] == majority_key for c in range(n)] for r in range(n)], dtype=bool
+    )
