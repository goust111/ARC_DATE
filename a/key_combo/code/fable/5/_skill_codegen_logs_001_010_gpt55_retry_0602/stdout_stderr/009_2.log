        started.add((r, c))

        rr = int(r)
        if int(g[rr, c]) in {bg, water}:
            out[rr, c] = water

        while rr + 1 < h:
            nr = rr + 1
            hit: tuple[int, int, int] | None = None
            for a, b, color in by_row.get(nr, []):
