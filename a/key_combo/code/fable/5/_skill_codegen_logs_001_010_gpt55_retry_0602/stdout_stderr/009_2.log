+
+def generate_input() -> np.ndarray:
+    """Generate a varied, semantically checked colored-shelf waterfall input."""
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            assert grid.ndim == 2 and max(grid.shape) <= 30
