+        return None
+    _paint_shelf(grid, shelves, bg, left_r, left_a, left_b, left_color)
+    _paint_shelf(grid, shelves, bg, right_r, right_a, right_b, right_color)
+
+    left_out = left_a - 1
+    right_out = right_b + 1
