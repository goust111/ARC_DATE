+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+    h, w = g.shape
+    bg, water = _dominant_and_rarest(g)
+    assert water != GRAY, "grey is reserved for legend indicators"
