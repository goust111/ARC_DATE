+    _paint_shelf(grid, shelves, bg, grand_r, grand_a, grand_b, both_color)
+
+    sources = [root_c]
+    grid[0, root_c] = water
+
+    base_expected, base_events = _oracle_from_spec(
+        grid, bg, water, sources, shelves, mapping
