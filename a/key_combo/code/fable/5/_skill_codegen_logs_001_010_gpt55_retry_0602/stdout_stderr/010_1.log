+        if depth > 0:
+            rotated = frozenset((pr + _rotate_offset(int(r) - pr, int(c) - pc, depth)[0],
+                                 pc + _rotate_offset(int(r) - pr, int(c) - pc, depth)[1])
+                                for r, c in coords)
+            if rotated == source:
