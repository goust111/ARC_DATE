+def _sprite_pivots(h: int, start_c: int, sprite_w: int, n: int) -> list[tuple[int, int]]:
+    row_edges = (0, h // 2, h)
+    col_edges = (start_c, start_c + sprite_w // 2, start_c + sprite_w)
