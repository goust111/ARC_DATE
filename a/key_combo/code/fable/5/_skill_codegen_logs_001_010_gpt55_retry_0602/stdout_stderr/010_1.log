+        if not any(abs(r - pr) + abs(c - pc) == 1 for r, c in sprite_coords):
+            return None
+        for r, c in sprite_coords:
+            expected[r, c] = BACKGROUND
+        for dr, dc in offsets:
+            rr, cc = _rotate_offset(dr, dc, depth[color])
+            expected[pr + rr, pc + cc] = color
