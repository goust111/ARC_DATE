+        return None
+    cover_count = sum(mask.astype(int) for mask in masks)
+    overlap_fraction = float(np.sum(cover_count >= 2)) / float(np.sum(cover_count >= 1))
+    if overlap_fraction > 0.32:
+        return None
+    return canvas, masks
+
