+                break
+            cells.add(random.choice(tuple(frontier)))
+        if len(cells) != target:
+            continue
+        rotations = []
+        for turns in range(4):
+            rotations.append(frozenset(_rotate_offset(r, c, turns) for r, c in cells))
+        if len(set(rotations)) == 4:
+            return cells
