+def _label4(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    """Label True cells by 4-connectivity using the common (row, column) convention."""
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    next_label = 0
+    for sr, sc in np.argwhere(mask):
