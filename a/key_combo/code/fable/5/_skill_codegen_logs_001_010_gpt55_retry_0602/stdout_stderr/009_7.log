+    for i, (r0, r1) in enumerate(row_spans):
+        for j, divider_c in enumerate(col_dividers):
+            color = wall if int(parity[i, j]) != int(parity[i, j + 1]) else door
+            grid[r0 : r1 + 1, divider_c] = color
