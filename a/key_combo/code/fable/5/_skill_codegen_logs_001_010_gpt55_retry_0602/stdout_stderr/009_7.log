+    while queue:
+        region = queue.popleft()
+        for neighbor, relation in graph[region]:
+            wanted = parity[region] ^ relation
+            if neighbor in parity:
+                assert parity[neighbor] == wanted, "wall/door constraints must be consistent"
+            else:
