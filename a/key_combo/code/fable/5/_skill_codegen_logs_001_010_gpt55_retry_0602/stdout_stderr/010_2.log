+        "separator": (sep_r, sep_c, sep_color),
+        "canvas": canvas,
+        "row_counts": row_counts,
+        "col_counts": col_counts,
+        "row_key": row_key,
+        "col_key": col_key,
+        "destination": (dst_r0, dst_c0),
+    }
