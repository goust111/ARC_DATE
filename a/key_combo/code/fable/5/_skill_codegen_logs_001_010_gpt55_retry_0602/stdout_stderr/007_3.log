+def _component_at(grid: np.ndarray, start: Coord, forbidden: set[Coord]) -> set[Coord]:
+    """4-connected monochromatic component containing start."""
+    color = int(grid[start])
+    stack = [start]
+    seen: set[Coord] = set()
+    h, w = grid.shape
