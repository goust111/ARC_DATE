+    grid[head] = ray_color
+
+    expected = _expected_output(grid, bg, ray_color, steps, hit_index, hit_cells)
+    if not _validate_generated(
+        grid,
+        expected,
+        bg,
+        target_color,
+        tail,
+        head,
+        direction,
+        steps,
+        hit_index,
+        rectangles,
+    ):
