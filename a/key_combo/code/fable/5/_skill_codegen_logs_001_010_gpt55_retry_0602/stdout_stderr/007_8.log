+
+
+def _first_obstacle(
+    grid: np.ndarray, corner: tuple[int, int], direction: tuple[int, int]
+) -> tuple[int, int] | None:
+    r, c = corner[0] + direction[0], corner[1] + direction[1]
+    while 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:
