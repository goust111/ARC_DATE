from __future__ import annotations

import numpy as np

from arc_utils import bbox, crop_bbox, get_bg, paste
import random


def _major_foreground_color(g: np.ndarray, bg: int) -> int:
    vals, counts = np.unique(g[g != int(bg)], return_counts=True)
    assert vals.size, "input must contain foreground colors"
    return int(vals[int(np.argmax(counts))])


def _center_patch(g: np.ndarray, r0: int, c0: int, block: int, bg: int) -> np.ndarray:
    assert block == 3, "this task uses 3x3 blocks"
    main = _major_foreground_color(g, bg)
    patch = np.full((block, block), main, dtype=int)

    hole_r = int(r0) + block
    hole_c = int(c0) + block
    offsets = [-1, 1, 3]
    for r in range(block):
        for c in range(block):
            if r == block // 2 and c == block // 2:
                continue
            patch[r, c] = int(g[hole_r + offsets[r], hole_c + offsets[c]])
    return patch


def main(grid: np.ndarray) -> np.ndarray:
    """
    Expand a 3x3 block motif into a 5x5 block motif around its missing center.

    Input structure:
    - Teal background surrounds one 9x9 foreground motif.
    - The motif is a 3x3 array of 3x3 blocks; the middle block is empty teal.
    - Colored pixels immediately around the empty middle block encode the border
      of the missing center block.

    Rule:
    - Keep the original 9x9 motif in place.
    - Copy each of the eight surrounding 3x3 blocks to the opposite outer slot
      of the implied 5x5 block grid, without rotating it.
    - Fill the center block from the eight pixels around the hole; its center is
      the motif's majority foreground color.

    Key insight: The visible 9x9 motif is the middle of a larger periodic
    block-level pattern, and the empty center is reconstructed from its immediate
    inner boundary.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    motif_bbox = bbox(g != bg)
    assert motif_bbox is not None, "expected a foreground motif"
    r0, c0, r1, c1 = motif_bbox
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    assert h == w and h % 3 == 0, "motif must be a square 3x3 block grid"
    block = h // 3

    out = g.copy()
    expanded_r0 = int(r0) - block
    expanded_c0 = int(c0) - block

    for br in range(3):
        for bc in range(3):
            if (br, bc) == (1, 1):
                continue
            src = crop_bbox(
                g,
                (
                    int(r0) + br * block,
                    int(c0) + bc * block,
                    int(r0) + (br + 1) * block - 1,
                    int(c0) + (bc + 1) * block - 1,
                ),
            )
            dst_r = expanded_r0 + (4 - 2 * br) * block
            dst_c = expanded_c0 + (4 - 2 * bc) * block
            paste(out, src, dst_r, dst_c)

    paste(out, _center_patch(g, int(r0), int(c0), block, bg), int(r0) + block, int(c0) + block)
    return out

# --------------- generator (o5x) ---------------

# -- CFG: canvas & structure --
GRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19       # square grid side length
BLOCK = 3                                    # block side length
MOTIF_SIZE = BLOCK * 3                       # 9x9 motif (3x3 grid of blocks)
EXPANDED_SIZE = BLOCK * 5                    # 15x15 expanded output region
MOTIF_PAD = 3                                # min distance from motif edge to grid edge

# -- CFG: colors --
BG = 8                                       # background color
FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
COLOR_COUNT_MIN, COLOR_COUNT_MAX = 2, 4      # total foreground colors (incl. majority)

# -- CFG: majority pixel counts (corner block + edge block combined) --
MAJORITY_TOTAL_MIN, MAJORITY_TOTAL_MAX = 10, 16  # range for sum of major pixels in b00+b01
CORNER_MAJOR_MIN, CORNER_MAJOR_MAX = 5, 8        # major pixels in corner block (diag-sym)
EDGE_MAJOR_MIN, EDGE_MAJOR_MAX = 5, 8            # major pixels in edge block (LR-sym)

# -- CFG: generation --
MAX_RETRIES = 300

# -- Symmetry orbits for 3x3 blocks --
# Diagonal-symmetric orbits (b00 == b00.T): cells sharing a diag-orbit get the same color
DIAG_ORBITS = (
    ((0, 0),), ((1, 1),), ((2, 2),),
    ((0, 1), (1, 0)),
    ((0, 2), (2, 0)),
    ((1, 2), (2, 1)),
)
# LR-symmetric orbits (b01 == fliplr(b01)): cells sharing an LR-orbit get the same color
LR_ORBITS = (
    ((0, 0), (0, 2)),
    ((1, 0), (1, 2)),
    ((2, 0), (2, 2)),
    ((0, 1),), ((1, 1),), ((2, 1),),
)

# Row/col indices for sampling inner-boundary pixels that fill the center patch.
# Maps block-local (r,c) -> motif row/col via BLOCK + offset.
_CENTER_OFFSETS = np.array([-1, 1, 3])


def _major_orbits(orbits, forced_minor, target_count):
    """Enumerate all orbit subsets whose total pixel count equals target_count,
    excluding orbits that contain any forced_minor coordinate, then pick one."""
    forced_minor = set(forced_minor)
    usable = [
        idx for idx, orbit in enumerate(orbits)
        if all(coord not in forced_minor for coord in orbit)
    ]
    choices = []
    for mask in range(1 << len(usable)):
        selected = set()
        total = 0
        for bit, idx in enumerate(usable):
            if mask & (1 << bit):
                selected.add(idx)
                total += len(orbits[idx])
        if total == target_count:
            choices.append(selected)
    assert choices, "unreachable symmetric majority count"
    return random.choice(choices)



def _seed_block(orbits, forced_minor, majority, target_count):
    """Build a BLOCK x BLOCK array with majority color placed in orbits totalling
    target_count pixels. Returns (block, minor_orbits) where minor_orbits is a list
    of (block_ref, orbit) pairs whose colors are still unset (-1)."""
    block = np.full((BLOCK, BLOCK), -1, dtype=int)
    major_idxs = _major_orbits(orbits, forced_minor, target_count)
    minor_orbits = []
    for idx, orbit in enumerate(orbits):
        if idx in major_idxs:
            for r, c in orbit:
                block[r, c] = majority
        else:
            minor_orbits.append((block, orbit))
    return block, minor_orbits


def _assign_minor_colors(minor_orbits, colors):
    """Assign minor colors to unfilled orbits, guaranteeing each color appears at
    least once (remaining orbits get random picks)."""
    random.shuffle(minor_orbits)
    guaranteed = list(colors)
    random.shuffle(guaranteed)
    assignments = guaranteed + [
        random.choice(colors) for _ in range(len(minor_orbits) - len(guaranteed))
    ]
    for (block, orbit), color in zip(minor_orbits, assignments):
        for r, c in orbit:
            block[r, c] = color


def _make_blocks(majority, minor_colors, corner_major, edge_major):
    """Build the two seed blocks (b00=corner, b01=edge) with D4/LR symmetry."""
    b00, corner_minors = _seed_block(DIAG_ORBITS, [(2, 2)], majority, corner_major)
    b01, edge_minors = _seed_block(LR_ORBITS, [(2, 1)], majority, edge_major)
    minor_orbits = corner_minors + edge_minors
    assert len(minor_orbits) >= len(minor_colors)
    _assign_minor_colors(minor_orbits, minor_colors)
    assert np.all(b00 != -1) and np.all(b01 != -1)
    return b00, b01


def _assemble_motif(b00, b01):
    """Assemble the 9x9 motif from two seed blocks via D4 symmetry; center block is bg."""
    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)
    blocks = {
        (0, 0): b00,
        (0, 1): b01,
        (0, 2): np.fliplr(b00),
        (1, 0): b01.T,
        (1, 2): np.rot90(b01, -1),
        (2, 0): np.flipud(b00),
        (2, 1): np.flipud(b01),
        (2, 2): np.rot90(b00, 2),
    }
    for (br, bc), blk in blocks.items():
        paste(motif, blk, br * BLOCK, bc * BLOCK)
    return motif


def _gen_center_patch(motif, majority):
    """Reconstruct the center block from the 8 inner-boundary pixels of the motif.
    Center pixel is the majority foreground color."""
    rows = BLOCK + _CENTER_OFFSETS
    cols = BLOCK + _CENTER_OFFSETS
    patch = motif[np.ix_(rows, cols)].copy()
    patch[1, 1] = majority
    return patch


def _expanded_output(motif, center):
    """Build the 15x15 expanded region: original motif (with center filled) in the
    middle, each surrounding block mirrored to the opposite outer slot."""
    expanded = np.full((EXPANDED_SIZE, EXPANDED_SIZE), BG, dtype=int)
    output_motif = motif.copy()
    paste(output_motif, center, BLOCK, BLOCK)
    paste(expanded, output_motif, BLOCK, BLOCK)
    for br in range(3):
        for bc in range(3):
            if (br, bc) == (1, 1):
                continue
            src = motif[br * BLOCK:(br + 1) * BLOCK, bc * BLOCK:(bc + 1) * BLOCK]
            paste(expanded, src, (4 - 2 * br) * BLOCK, (4 - 2 * bc) * BLOCK)
    return expanded


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build motif, verify via oracle, return input or None."""
    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    color_count = random.randint(COLOR_COUNT_MIN, COLOR_COUNT_MAX)
    colors = random.sample(FOREGROUND_COLORS, color_count)
    majority = colors[0]
    minor_colors = colors[1:]

    # Choose how many majority pixels across both seed blocks
    possible_totals = [
        total for total in range(MAJORITY_TOTAL_MIN, MAJORITY_TOTAL_MAX + 1)
        if 18 - total >= len(minor_colors)
    ]
    majority_total = random.choice(possible_totals)
    pairs = [
        (corner, majority_total - corner)
        for corner in range(CORNER_MAJOR_MIN, CORNER_MAJOR_MAX + 1)
        if EDGE_MAJOR_MIN <= majority_total - corner <= EDGE_MAJOR_MAX
    ]
    corner_major, edge_major = random.choice(pairs)

    b00, b01 = _make_blocks(majority, minor_colors, corner_major, edge_major)
    motif = _assemble_motif(b00, b01)
    center = _gen_center_patch(motif, majority)
    expanded = _expanded_output(motif, center)

    r0 = random.randint(MOTIF_PAD, n - MOTIF_SIZE - MOTIF_PAD)
    c0 = random.randint(MOTIF_PAD, n - MOTIF_SIZE - MOTIF_PAD)
    inp = np.full((n, n), BG, dtype=int)
    out = np.full((n, n), BG, dtype=int)
    paste(inp, motif, r0, c0)
    paste(out, expanded, r0 - BLOCK, c0 - BLOCK)

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise AssertionError("failed to generate a valid db0c5428 input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components, get_bg
import random


def _is_solid_rect(g: np.ndarray, comp: dict) -> bool:
    r0, c0, r1, c1 = comp["bbox"]
    area = int((r1 - r0 + 1) * (c1 - c0 + 1))
    return int(comp["area"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp["color"])))


def _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    rects = [comp for comp in comps if _is_solid_rect(g, comp)]

    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []
    for color in {int(comp["color"]) for comp in rects}:
        same_color = [comp for comp in rects if int(comp["color"]) == color]
        for i, a in enumerate(same_color):
            for b in same_color[i + 1 :]:
                if bbox_h(a["bbox"]) != bbox_h(b["bbox"]) or bbox_w(a["bbox"]) != bbox_w(b["bbox"]):
                    continue

                ar0, ac0, _ar1, _ac1 = a["bbox"]
                br0, bc0, _br1, _bc1 = b["bbox"]
                if ar0 < br0 and ac0 < bc0:
                    source, dest = a, b
                elif br0 < ar0 and bc0 < ac0:
                    source, dest = b, a
                else:
                    continue

                sr0, sc0, sr1, sc1 = source["bbox"]
                dr0, dc0, _dr1, _dc1 = dest["bbox"]
                right = [
                    comp
                    for comp in rects
                    if int(comp["color"]) != color
                    and comp["bbox"][0] == sr0
                    and comp["bbox"][2] == sr1
                    and comp["bbox"][1] == comp["bbox"][3]
                    and sc1 < comp["bbox"][1] < dc0
                ]
                below = [
                    comp
                    for comp in rects
                    if int(comp["color"]) != color
                    and comp["bbox"][1] == sc0
                    and comp["bbox"][3] == sc1
                    and comp["bbox"][0] == comp["bbox"][2]
                    and sr1 < comp["bbox"][0] < dr0
                ]

                right_with_offsets = sorted(
                    ((int(comp["bbox"][1] - sc1), comp) for comp in right),
                    key=lambda item: item[0],
                )
                below_with_offsets = sorted(
                    ((int(comp["bbox"][0] - sr1), comp) for comp in below),
                    key=lambda item: item[0],
                )
                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:
                    right_offsets = [offset for offset, _comp in right_with_offsets]
                    below_offsets = [offset for offset, _comp in below_with_offsets]
                    if right_offsets == below_offsets and right_offsets[0] == 1:
                        candidates.append(
                            (
                                source,
                                dest,
                                [comp for _offset, comp in right_with_offsets],
                                [comp for _offset, comp in below_with_offsets],
                            )
                        )

    assert len(candidates) == 1, "expected one anchor pair with matching right and below controls"
    return candidates[0]


def _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:
    assert int(out[r, c]) in {int(bg), int(color)}, "paint target must be empty or already matching"
    out[r, c] = int(color)


def _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:
    for r in range(int(r0), int(r1) + 1):
        for c in range(int(c0), int(c1) + 1):
            _paint(out, bg, r, c, color)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.

    Input structure:
    - The background is the dominant color.
    - Two same-color solid rectangular anchors of the same size sit on opposite
      diagonal corners, with the first anchor above-left of the second.
    - The upper-left anchor has two one-cell-thick vertical control bars to its
      right and two one-cell-thick horizontal control bars below it.

    Rule:
    - Copy the anchor rectangle into the two missing corners of the implied
      larger rectangle.
    - Repeat the right-side control bars horizontally between the left and right
      anchors, using their spacing as the period, and draw the outer top and
      bottom borders in the first right-control color.
    - Repeat the below-side control bars vertically between the top and bottom
      anchors, using the same period, and draw the outer left and right borders
      in the first below-control color.

    Key insight: The small control bars are the first two ticks of two periodic
    frame patterns; the diagonal anchor supplies the opposite corner and the
    missing two anchor copies.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    source, dest, right_controls, below_controls = _find_structure(g, bg)

    sr0, sc0, sr1, sc1 = source["bbox"]
    dr0, dc0, dr1, dc1 = dest["bbox"]
    anchor_color = int(source["color"])
    assert int(dest["color"]) == anchor_color, "anchor colors must match"
    assert bbox_h(source["bbox"]) == bbox_h(dest["bbox"]), "anchor heights must match"
    assert bbox_w(source["bbox"]) == bbox_w(dest["bbox"]), "anchor widths must match"
    assert sr0 > 0 and sc0 > 0, "upper-left anchor must have space for outer frame"
    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], "lower-right anchor must have space for outer frame"

    right_offsets = [int(comp["bbox"][1] - sc1) for comp in right_controls]
    below_offsets = [int(comp["bbox"][0] - sr1) for comp in below_controls]
    assert right_offsets == below_offsets and right_offsets[0] == 1, "control offsets must match from the anchor edge"
    step = int(right_offsets[1] - right_offsets[0])
    assert step > 0, "control bars must be separated"
    period = 2 * step
    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, "right frame must close next to the destination anchor"
    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, "below frame must close next to the destination anchor"

    right_colors = [int(comp["color"]) for comp in right_controls]
    below_colors = [int(comp["color"]) for comp in below_controls]
    out = g.copy()

    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)
    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)

    first_c = int(sc1 + right_offsets[0])
    last_c = int(dc0 - 1)
    for c in range(first_c, last_c + 1):
        offset = int(c - sc1)
        if (offset - right_offsets[0]) % period == 0:
            color = right_colors[0]
        elif (offset - right_offsets[1]) % period == 0:
            color = right_colors[1]
        else:
            continue
        _paint_rect(out, bg, sr0, c, sr1, c, color)
        _paint_rect(out, bg, dr0, c, dr1, c, color)

    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])
    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])

    first_r = int(sr1 + below_offsets[0])
    last_r = int(dr0 - 1)
    left_c = int(sc0 - 1)
    right_c = int(dc1 + 1)
    for r in range(first_r, last_r + 1):
        _paint(out, bg, r, left_c, below_colors[0])
        _paint(out, bg, r, right_c, below_colors[0])

        offset = int(r - sr1)
        if (offset - below_offsets[0]) % period == 0:
            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])
            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])
        elif (offset - below_offsets[1]) % period == 0:
            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])
            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])

    return out


# --------------- generator (att2, o5x) ---------------

# Color sampling.
COLOR_COUNT, NON_BG_COLOR_COUNT = 10, 4

# Anchor/repetition geometry.
ANCHOR_SIZE_RANGE = (1, 5)
REPEAT_COUNT_RANGE = (2, 5)
CONTROL_OFFSETS = (1, 3)
FRAME_PERIOD, DEST_ANCHOR_GAP, STRUCTURE_FIXED_PAD = 4, 2, 3

# Canvas/margins.
CANVAS_MIN_SIZE, CANVAS_MAX_SIZE = 16, 30
MARGIN_CHOICES = range(4)
MIN_TOTAL_MARGIN, SOURCE_OUTER_MARGIN = 1, 1

# Retry.
MAX_GENERATION_ATTEMPTS = 300


def _gen_paint_rect(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> None:
    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)


def _choose_margins(struct_len: int) -> tuple[int, int]:
    pairs = [
        (before, after)
        for before in MARGIN_CHOICES
        for after in MARGIN_CHOICES
        if MIN_TOTAL_MARGIN <= before + after
        and CANVAS_MIN_SIZE <= struct_len + before + after <= CANVAS_MAX_SIZE
    ]
    return pairs[int(np.random.randint(len(pairs)))]


def _build_output(
    rows: int,
    cols: int,
    bg: int,
    anchor_color: int,
    right1: int,
    right2: int,
    below1: int,
    sr0: int,
    sc0: int,
    s: int,
    nh: int,
    nv: int,
) -> tuple[np.ndarray, tuple[int, int, int, int, int, int, int, int]]:
    out = np.full((rows, cols), int(bg), dtype=int)
    sr1, sc1 = sr0 + s - 1, sc0 + s - 1
    dr0 = sr1 + FRAME_PERIOD * nv + DEST_ANCHOR_GAP
    dc0 = sc1 + FRAME_PERIOD * nh + DEST_ANCHOR_GAP
    dr1, dc1 = dr0 + s - 1, dc0 + s - 1

    for r0, c0 in ((sr0, sc0), (sr0, dc0), (dr0, sc0), (dr0, dc0)):
        _gen_paint_rect(out, r0, c0, r0 + s - 1, c0 + s - 1, anchor_color)

    first_c, last_c = sc1 + CONTROL_OFFSETS[0], dc0 - 1
    for c in range(first_c, last_c + 1):
        offset = c - sc1
        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:
            color = right1
        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:
            color = right2
        else:
            continue
        _gen_paint_rect(out, sr0, c, sr1, c, color)
        _gen_paint_rect(out, dr0, c, dr1, c, color)
    _gen_paint_rect(out, sr0 - 1, first_c, sr0 - 1, last_c, right1)
    _gen_paint_rect(out, dr1 + 1, first_c, dr1 + 1, last_c, right1)

    first_r, last_r = sr1 + CONTROL_OFFSETS[0], dr0 - 1
    left_c, right_c = sc0 - 1, dc1 + 1
    for r in range(first_r, last_r + 1):
        out[r, left_c] = below1
        out[r, right_c] = below1
        offset = r - sr1
        if (offset - CONTROL_OFFSETS[0]) % FRAME_PERIOD == 0:
            _gen_paint_rect(out, r, left_c, r, sc1, below1)
            _gen_paint_rect(out, r, dc0, r, right_c, below1)
        elif (offset - CONTROL_OFFSETS[1]) % FRAME_PERIOD == 0:
            _gen_paint_rect(out, r, sc0, r, sc1, right2)
            _gen_paint_rect(out, r, dc0, r, dc1, right2)

    return out, (sr0, sc0, sr1, sc1, dr0, dc0, dr1, dc1)


def _derive_input(
    out: np.ndarray,
    bg: int,
    sr0: int,
    sc0: int,
    sr1: int,
    sc1: int,
    dr0: int,
    dc0: int,
    dr1: int,
    dc1: int,
) -> np.ndarray:
    keep = np.zeros(out.shape, dtype=bool)
    keep[sr0 : sr1 + 1, sc0 : sc1 + 1] = True
    keep[dr0 : dr1 + 1, dc0 : dc1 + 1] = True
    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[0]] = True
    keep[sr0 : sr1 + 1, sc1 + CONTROL_OFFSETS[1]] = True
    keep[sr1 + CONTROL_OFFSETS[0], sc0 : sc1 + 1] = True
    keep[sr1 + CONTROL_OFFSETS[1], sc0 : sc1 + 1] = True

    inp = np.full_like(out, int(bg))
    inp[keep] = out[keep]
    return inp


def _gen_attempt() -> np.ndarray | None:
    bg = int(np.random.randint(COLOR_COUNT))
    palette = [color for color in range(COLOR_COUNT) if color != bg]
    anchor_color, right1, right2, below1 = map(
        int, np.random.choice(palette, NON_BG_COLOR_COUNT, replace=False)
    )

    s = int(np.random.randint(ANCHOR_SIZE_RANGE[0], ANCHOR_SIZE_RANGE[1]))
    nh = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))
    nv = int(np.random.randint(REPEAT_COUNT_RANGE[0], REPEAT_COUNT_RANGE[1]))
    struct_h = 2 * s + FRAME_PERIOD * nv + STRUCTURE_FIXED_PAD
    struct_w = 2 * s + FRAME_PERIOD * nh + STRUCTURE_FIXED_PAD

    top, bottom = _choose_margins(struct_h)
    left, right = _choose_margins(struct_w)
    rows, cols = struct_h + top + bottom, struct_w + left + right
    sr0, sc0 = top + SOURCE_OUTER_MARGIN, left + SOURCE_OUTER_MARGIN

    out, box = _build_output(
        rows,
        cols,
        bg,
        anchor_color,
        right1,
        right2,
        below1,
        sr0,
        sc0,
        s,
        nh,
        nv,
    )
    inp = _derive_input(out, bg, *box)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

