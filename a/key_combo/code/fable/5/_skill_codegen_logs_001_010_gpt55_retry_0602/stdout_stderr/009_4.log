+    chosen: dict[Coord, dict[Coord, int]] = {
+        critical_anchor: critical_partial,
+        trimmed_anchor: trimmed_partial,
+    }
+    for anchor in copy_anchors[2:]:
+        chosen[anchor] = random.choice(partials)
