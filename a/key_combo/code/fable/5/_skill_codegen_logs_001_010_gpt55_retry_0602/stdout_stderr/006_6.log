+PLACEMENT_ATTEMPTS = 400
+SIDES = ("top", "right", "bottom", "left")
+SIDE_NORMAL = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
