+        for k in range(2 * len(point_set) - 1):
+            cell = _add(far, direction, k)
+            if k % 2 == 0:
+                assert cell in point_set
+            else:
+                assert int(g[cell]) == bg, "dotted rays must leave one black cell between dots"
