    try:
        output = main(grid)
    except Exception:
        return None

    # Build expected output: rows sorted by (room_count, render_order position)
    frame_info = sorted(
        [(room_counts[i], render_order.index(i), frame_colors[i]) for i in range(frame_count)])
    max_rooms = max(rc for rc, _, _ in frame_info)
    expected = np.full((frame_count, max_rooms), noise_color, dtype=int)
    for r, (rc, _, color) in enumerate(frame_info):
        expected[r, :rc] = color

    return grid if np.array_equal(output, expected) else None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {_GEN_RETRIES} attempts")
    if pr + pc == 0:
        return None
    paste(canvas, plug_sprite, pr, pc, transparent=bg)

    if np.sum(canvas == bg) <= canvas.size // 2:
        return None

    # Step 5: oracle verify
    try:
        result = main(canvas)
    except Exception:
        return None
    # result should be non-trivial
    if result.size == 0 or not np.any(result != bg):
        return None
    return canvas


def generate_input():
    for _ in range(300):
        g = _gen_attempt()
        if g is not None:
            return g
    raise RuntimeError("generate_input: failed after 300 attempts")
        return None

    base = np.full((H, W), bg, dtype=int)
    for frame in frames:
        _draw_frame(base, frame['r'], frame['c'], frame['size'])

    _assign_corner_colors(frames, bg)
    sources = _pick_sources(frames)
    if sources is None:
        return None

    output = _render_output(base, frames, pattern)
    inp = _derive_input(output, base, frames, pattern, k_max, sources)

    if not np.array_equal(main(inp), output):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f'failed to generate a valid input after {MAX_ATTEMPTS} attempts')

