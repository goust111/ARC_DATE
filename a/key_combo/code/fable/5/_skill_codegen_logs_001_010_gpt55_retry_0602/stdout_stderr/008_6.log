+# Directions are ordered by the rotation encoded in the puzzle:
+# up=0, right=1, down=2, left=3 (clockwise quarter-turns).
+_DIRS = ((-1, 0), (0, 1), (1, 0), (0, -1))
+_PALETTE = tuple(range(10))
+_GEN_RETRIES = 400
