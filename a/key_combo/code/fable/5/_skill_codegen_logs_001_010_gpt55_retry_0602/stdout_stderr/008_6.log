+    out = g.copy()
+    for comp, _, _ in instructions:
+        for r, c in comp:
+            out[r, c] = bg
+
+    h, w = out.shape
+    for _, (cr, cc), direction in instructions:
+        for dr, dc in _rotated(offsets, direction):
+            r, c = cr + dr, cc + dc
+            assert 0 <= r < h and 0 <= c < w, "rotated stamp must fit inside the grid"
