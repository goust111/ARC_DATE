+def generate_input() -> np.ndarray:
+    """Generate a varied, oracle-checked instance with all four direction branches."""
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid long-arm cross instance")

