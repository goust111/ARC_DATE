+        area_lo = 5 if (h, w) == (3, 3) else max(7, (h * w + 2) // 3)
+        area_hi = min(h * w - 1, area_lo + 4)
+        area = random.randint(area_lo, area_hi)
+
+        required = {
+            (0, 0),
+            (-rh, random.randint(-rw, rw)),
+            (rh, random.randint(-rw, rw)),
+            (random.randint(-rh, rh), -rw),
+            (random.randint(-rh, rh), rw),
+        }
+        if len(required) > area:
+            continue
