+    g = np.asarray(grid, dtype=int)
+    analysis = _analyze(g)
+    bg = int(analysis["background"])
+    template_color = int(analysis["template_color"])
+    offsets = analysis["template_offsets"]
+    instructions = analysis["instructions"]
