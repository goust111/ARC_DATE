+    """Rotate a row/column offset clockwise about (0, 0)."""
+    r, c = point
+    for _ in range(int(quarter_turns) % 4):
+        r, c = c, -r
+    return int(r), int(c)
+
+
+def _rotated(
+    points: set[tuple[int, int]], quarter_turns: int
+) -> set[tuple[int, int]]:
+    return {_rotate_offset(p, quarter_turns) for p in points}
