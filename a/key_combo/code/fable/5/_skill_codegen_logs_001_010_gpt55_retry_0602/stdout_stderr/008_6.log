+def _connected_relative(points: set[tuple[int, int]]) -> bool:
+    if not points:
+        return False
+    seen = {next(iter(points))}
+    queue = deque(seen)
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in _DIRS:
+            q = (r + dr, c + dc)
+            if q in points and q not in seen:
+                seen.add(q)
+                queue.append(q)
+    return len(seen) == len(points)
+
