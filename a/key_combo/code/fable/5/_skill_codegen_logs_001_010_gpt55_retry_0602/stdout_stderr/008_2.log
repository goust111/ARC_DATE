+    predicted = _trace_masks(blockers, rect)
+    observed = _observed_masks(grid, shadow)
+    if not all(np.array_equal(a, b) for a, b in zip(predicted, observed)):
+        return False
+    if not all(bool(side.any()) for side in observed):
+        return False
+
