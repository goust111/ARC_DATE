+        return False
+
+    # Every generated blocker must be visible evidence: removing it changes a trace.
+    for br0, bc0, br1, bc1 in blocker_rects:
+        reduced = blockers.copy()
+        reduced[br0 : br1 + 1, bc0 : bc1 + 1] = False
