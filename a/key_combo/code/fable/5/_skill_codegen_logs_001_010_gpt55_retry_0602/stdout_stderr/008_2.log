+
+    candidates = _candidate_rectangles(g, shadow)
+    assert len(candidates) == 1, f"expected one reconstructable rectangle, found {len(candidates)}"
+    r0, c0, r1, c1 = candidates[0]
+    out = g.copy()
+    out[r0 : r1 + 1, c0 : c1 + 1] = shadow
