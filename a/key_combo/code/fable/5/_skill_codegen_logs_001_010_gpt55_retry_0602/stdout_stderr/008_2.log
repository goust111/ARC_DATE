+
+    def rectangle_is_empty(rect: Rect) -> bool:
+        r0, c0, r1, c1 = rect
+        count = (
+            occupied_prefix[r1 + 1, c1 + 1]
+            - occupied_prefix[r0, c1 + 1]
+            - occupied_prefix[r1 + 1, c0]
+            + occupied_prefix[r0, c0]
+        )
+        return int(count) == 0
