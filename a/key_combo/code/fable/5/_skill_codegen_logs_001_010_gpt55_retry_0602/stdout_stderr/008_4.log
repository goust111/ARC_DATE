+                if 0 <= nxt[0] < h and 0 <= nxt[1] < w and nxt in unseen:
+                    unseen.remove(nxt)
+                    queue.append(nxt)
+                    cells.append(nxt)
+        result.append(np.asarray(cells, dtype=int))
+    return result
