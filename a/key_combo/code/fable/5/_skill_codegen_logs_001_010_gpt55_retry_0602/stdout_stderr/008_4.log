def _anchor_to_top_left(anchor_idx: int, size: int, place_size: int) -> int:
    """
    anchor_idx in {0,1,2} selects position on a length:
      0 -> start, 1 -> middle, 2 -> end
    Returns the top-left coordinate so that the corresponding point of the placed object
    aligns with that point on the canvas.
    """
    if anchor_idx <= 0:
        canvas_anchor = 0
        obj_anchor = 0
    elif anchor_idx >= 2:
        canvas_anchor = max(0, size - 1)
        obj_anchor = max(0, place_size - 1)
    else:
        canvas_anchor = (size - 1) // 2 if size > 1 else 0
        obj_anchor = (place_size - 1) // 2 if place_size > 1 else 0
    return canvas_anchor - obj_anchor


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble and place enlarged sprites on a canvas using legend-panel instructions.

    Input structure:
    - Color-6 separators divide the grid into a left legend column and a main canvas.
    - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.

    Rule:
    - Tile the unit sprite into each active cell of the frame to build an enlarged composite.
    - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).
    - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.

    Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    assert w >= 2, "grid width must be >= 2"

    # Output canvas is the region between the left separator run and (optionally) a
    # right-side separator run near the far edge (right legend panel).
    left_sep, right_sep = _split_canvas(g)
    left_sep_c1 = left_sep[1]
    canvas_c0 = left_sep_c1 + 1
    canvas_c1 = right_sep[0] if right_sep is not None else w
    main = g[:, canvas_c0:canvas_c1].copy()

    # Paint one constructed sprite per marker panel that lies outside the output canvas.
    marker_squares = _all_marker_panel_squares(g)
    assert marker_squares, "no marker panel found"

    # Anchor alignment (ignore internal full-height/full-width 6 separators inside main).
    eff_h, eff_w = main.shape
    full6_cols = [c for c in range(eff_w) if np.all(main[:, c] == 6)]
    if full6_cols:
        eff_w = min(full6_cols)
    full6_rows = [r for r in range(eff_h) if np.all(main[r, :] == 6)]
    if full6_rows:
        eff_h = min(full6_rows)

    out = main.copy()
    composite_written = np.zeros(out.shape, dtype=bool)

    for marker_r0, marker_c0 in marker_squares:
        # Ignore marker panels inside the output canvas; only legends should drive drawing.
        if canvas_c0 <= marker_c0 < canvas_c1:
            continue

        if marker_c0 + 5 > w:
            continue
        panel = g[:, marker_c0 : marker_c0 + 5]

        unit = _extract_unit_sprite(panel)
        if unit is None:
            continue
        unit_sprite, unit_bb = unit

        frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)
        if frame_bb is None:
            continue
        fr0, fc0, fr1, fc1 = frame_bb
        frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]
        frame_mask0 = (frame != 0) & (frame != 6)
        _, n8 = _scipy_label(frame_mask0, structure=np.ones((3, 3)))
        assert n8 == 1, f"frame must be 8-connected, got {n8} components"

        # Rotate layout according to clockhand.
        dir_k = _rotation_from_clockhand(g, marker_r0, marker_c0)  # up=0, right=1, down=2, left=3
        frame_mask = np.rot90(frame_mask0, (-dir_k) % 4)

        # Build composite by tiling the unit sprite into active frame cells.
        m_unit = (unit_sprite != 0) & (unit_sprite != 6)
        uh, uw = unit_sprite.shape
        fh, fw = frame_mask.shape
        comp = np.zeros((fh * uh, fw * uw), dtype=int)
        for i in range(fh):
            for j in range(fw):
                if not frame_mask[i, j]:
                    continue
                rr0 = i * uh
                cc0 = j * uw
                comp[rr0 : rr0 + uh, cc0 : cc0 + uw][m_unit] = unit_sprite[m_unit]

        pos = _position_indices_from_border_square(g, marker_r0, marker_c0)
        if pos is None:
            continue
        pr, pc = pos

        top = _anchor_to_top_left(pr, eff_h, comp.shape[0])
        left = _anchor_to_top_left(pc, eff_w, comp.shape[1])

        ch, cw = comp.shape
        for r in range(ch):
            rr = top + r
            assert 0 <= rr < out.shape[0], "sprite row out of canvas bounds"
            for c in range(cw):
                cc = left + c
                assert 0 <= cc < out.shape[1], "sprite col out of canvas bounds"
                if out[rr, cc] == 6:
                    continue
                val = int(comp[r, c])
                if val != 0 and val != 6:
                    assert not composite_written[rr, cc], "composites must not overlap"
                    composite_written[rr, cc] = True
                    out[rr, cc] = val
    return out

# --------------- generator (refine_8conn_fill_overlap) ---------------

# ── CFG: tunable generation parameters ──────────────────────────────
def _allocate_colors(num_legends):
    """Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend."""
    pool = list(USABLE_COLORS)
    random.shuffle(pool)

    unit_color_sets = []
    used_unit = set()
    for _ in range(num_legends):
        if len(pool) < 2:
            return None
        c1, c2 = pool.pop(), pool.pop()
        unit_color_sets.append((c1, c2))
        used_unit.update([c1, c2])

    bg_cands = [c for c in pool if c not in used_unit]
    if len(bg_cands) < 2:
        return None
    random.shuffle(bg_cands)
    bg_colors = (bg_cands[0], bg_cands[1])

    frame_colors = []
    all_set = set(USABLE_COLORS)
    for uc in unit_color_sets:
        candidates = list(all_set - set(uc))
        frame_colors.append(random.choice(candidates))

    return unit_color_sets, bg_colors, frame_colors


def _color_swap(sprite, c1, c2):
    """Return a copy of sprite with the two colors swapped."""
    sa, sb = sorted([c1, c2])
    out = sprite.copy()
    out[sprite == sa] = sb
    out[sprite == sb] = sa
    return out


def _design_legend(leg, unit_colors, frame_color, marker_r0, grid_h, canvas_w):
    """Fill in sprite, frame, and rotation for one legend dict. Returns False on failure."""
    N = leg["N"]
    uc1, uc2 = unit_colors

    # Unit sprite: NxN, fully filled, exactly 2 colors
    sprite = np.full((N, N), uc1, dtype=int)
    num_c2 = random.randint(1, N * N - 1)
    for p in random.sample(range(N * N), num_c2):
        sprite[p // N, p % N] = uc2

    legend_sprite = _color_swap(sprite, uc1, uc2)

    avail = marker_r0 - (N + 1)
    # Enumerate valid (frame_H, frame_W, rot_k) combos
    combos = []
    for fH in range(*FRAME_H_RANGE):
        if avail < fH + 1:
            continue
        for fW in range(*FRAME_W_RANGE):
            for rk in range(4):
                rh, rw = (fH, fW) if rk % 2 == 0 else (fW, fH)
                if rh * N <= grid_h and rw * N <= canvas_w:
                    combos.append((fH, fW, rk))
    if not combos:
        return False
    frame_H, frame_W, rot_k = random.choice(combos)

    frame_mask = random_sprite(
        frame_H, frame_W, density=FRAME_DENSITY, connectivity=8,
        color_palette=[1], symmetry="not_symmetric"
    ) != 0
    rot_frame = np.rot90(frame_mask, (-rot_k) % 4)

    leg.update(sprite=sprite, legend_sprite=legend_sprite, frame_mask=frame_mask,
               frame_H=frame_H, frame_W=frame_W, frame_color=frame_color,
               rot_k=rot_k, rotated_frame=rot_frame)
    return True


def _comp_size(leg):
    """Return (height, width) of the composite after rotation."""
    rf = leg["rotated_frame"]
    N = leg["N"]
    return rf.shape[0] * N, rf.shape[1] * N


def _assign_anchors(legends, grid_h, canvas_w):
    """Assign anchor positions to legends, avoiding overlap for 2-legend case. Returns False on failure."""
    if len(legends) == 1:
        pr, pc = random.randint(0, 2), random.randint(0, 2)
        ch, cw = _comp_size(legends[0])
        legends[0].update(pr=pr, pc=pc,
                          comp_top=_anchor_to_top_left(pr, grid_h, ch),
                          comp_left=_anchor_to_top_left(pc, canvas_w, cw))
        return True

    a, b = legends[0], legends[1]
    a_ch, a_cw = _comp_size(a)
    b_ch, b_cw = _comp_size(b)
    valid_pairs = []
    for apr in range(3):
        for apc in range(3):
            at = _anchor_to_top_left(apr, grid_h, a_ch)
            al = _anchor_to_top_left(apc, canvas_w, a_cw)
            if at < 0 or al < 0 or at + a_ch > grid_h or al + a_cw > canvas_w:
                continue
            for bpr in range(3):
                for bpc in range(3):
                    bt = _anchor_to_top_left(bpr, grid_h, b_ch)
                    bl = _anchor_to_top_left(bpc, canvas_w, b_cw)
                    if bt < 0 or bl < 0 or bt + b_ch > grid_h or bl + b_cw > canvas_w:
                        continue
                    # Reject overlapping bounding boxes
                    if at < bt + b_ch and bt < at + a_ch and al < bl + b_cw and bl < al + a_cw:
                        continue
                    valid_pairs.append((apr, apc, at, al, bpr, bpc, bt, bl))
    if not valid_pairs:
        return False
    apr, apc, at, al, bpr, bpc, bt, bl = random.choice(valid_pairs)
    a.update(pr=apr, pc=apc, comp_top=at, comp_left=al)
    b.update(pr=bpr, pc=bpc, comp_top=bt, comp_left=bl)
    return True


def _build_banded_canvas(grid_h, canvas_w, bg1, bg2):
    """Build a canvas with alternating horizontal or vertical color bands."""
    canvas = np.zeros((grid_h, canvas_w), dtype=int)
    band_dir = random.choice(["h", "v"])
    dim = grid_h if band_dir == "h" else canvas_w
    bw = random.randint(BAND_WIDTH_MIN, max(BAND_WIDTH_MIN, dim // 2))
    band_indices = np.arange(dim) // bw % 2
    colors = np.array([bg1, bg2])
    if band_dir == "h":
        canvas[:] = colors[band_indices][:, None]
    else:
        canvas[:] = colors[band_indices][None, :]
    return canvas


def _overlay_composites(canvas, legends):
    """Stamp each legend's tiled composite onto the canvas (non-{0,6} pixels overwrite)."""
    output = canvas.copy()
    for leg in legends:
        sp, rf = leg["sprite"], leg["rotated_frame"]
        N = leg["N"]
        t, l = leg["comp_top"], leg["comp_left"]
        fh, fw = rf.shape

        # Build full composite by tiling the unit sprite into active frame cells
        comp = np.zeros((fh * N, fw * N), dtype=int)
        sprite_mask = (sp != 0) & (sp != 6)
        for i in range(fh):
            for j in range(fw):
                if rf[i, j]:
                    r0, c0 = i * N, j * N
                    comp[r0:r0 + N, c0:c0 + N][sprite_mask] = sp[sprite_mask]

        # Overwrite canvas where composite has content and canvas isn't color 6
        region = output[t:t + fh * N, l:l + fw * N]
        write_mask = (comp != 0) & (region != 6)
        region[write_mask] = comp[write_mask]
    return output


def _gen_attempt() -> np.ndarray | None:
    grid_h = random.randint(*GRID_H_RANGE)
    num_legends = random.choices([1, 2], weights=LEGEND_COUNT_WEIGHTS)[0]

    # Per legend: pick N, compute legend_w
    legends = []
    for _ in range(num_legends):
        N = random.randint(*UNIT_SIZE_RANGE)
        legends.append({"N": N, "legend_w": N + 2})

    # Layout widths
    left_lw = legends[0]["legend_w"]
    left_total = left_lw + 1  # legend + 1 separator col
    right_total = (1 + legends[1]["legend_w"]) if num_legends == 2 else 0
    canvas_w = GRID_W - left_total - right_total
    if canvas_w < MIN_CANVAS_W:
        return None

    # Color allocation
    colors = _allocate_colors(num_legends)
    if colors is None:
        return None
    unit_color_sets, (bg1, bg2), frame_colors = colors

    marker_r0 = grid_h - MARKER_PANEL_HEIGHT

    # Design each legend panel
    for li in range(num_legends):
        if not _design_legend(legends[li], unit_color_sets[li], frame_colors[li],
                              marker_r0, grid_h, canvas_w):
            return None

    # Assign anchor positions
    if not _assign_anchors(legends, grid_h, canvas_w):
        return None

    # Build canvas and overlay composites
    canvas = _build_banded_canvas(grid_h, canvas_w, bg1, bg2)
    output = _overlay_composites(canvas, legends)

    # Assemble input grid
    grid = np.zeros((grid_h, GRID_W), dtype=int)
    canvas_c0 = left_total
    grid[:, canvas_c0:canvas_c0 + canvas_w] = canvas

    _place_legend(grid, legends[0], col_start=0, sep_col=left_lw,
                  marker_r0=marker_r0, is_right=False)
    if num_legends == 2:
        r_sep = canvas_c0 + canvas_w
        _place_legend(grid, legends[1], col_start=r_sep + 1, sep_col=r_sep,
                      marker_r0=marker_r0, is_right=True)

    # Validate via solver
    try:
        if np.array_equal(main(grid), output):
            return grid
    except Exception:
        pass
    return None


def _place_legend(grid, leg, col_start, sep_col, marker_r0, is_right):
    """Draw one legend panel (separator, marker square, rotation patch, sprite, frame)."""
    N = leg["N"]
    grid[:, sep_col] = 6

    # Marker square column: sprite at col_start+1 must fit within the 5-wide panel
    mc0 = (col_start + max(0, N - 4)) if not is_right else (sep_col + max(0, N - 3))

    # 5x5 border-6 marker square
    grid[marker_r0:marker_r0 + 5, mc0:mc0 + 5] = 0
    grid[marker_r0, mc0:mc0 + 5] = 6
    grid[marker_r0 + 4, mc0:mc0 + 5] = 6
    grid[marker_r0:marker_r0 + 5, mc0] = 6
    grid[marker_r0:marker_r0 + 5, mc0 + 4] = 6
    grid[marker_r0 + 1 + leg["pr"], mc0 + 1 + leg["pc"]] = 4

    # Rotation patch: 3x5 block with 6-borders on cols 0,4 and 3x3 clock-hand inside
    rr0 = marker_r0 + 5
    grid[rr0:rr0 + 3, mc0:mc0 + 5] = 0
    grid[rr0:rr0 + 3, mc0] = 6
    grid[rr0:rr0 + 3, mc0 + 4] = 6
    cx_r, cx_c = rr0 + 1, mc0 + 2
    dr, dc = ROTATION_DIRS[leg["rot_k"]]
    grid[cx_r, cx_c] = 7
    grid[cx_r + dr, cx_c + dc] = 7

    # Unit sprite at row 1
    sp_col = col_start + 1 - mc0
    grid[1:1 + N, mc0 + sp_col:mc0 + sp_col + N] = leg["legend_sprite"]

    # Frame mask between unit sprite bottom and marker top
    fH, fW = leg["frame_H"], leg["frame_W"]
    avail = marker_r0 - (N + 1)
    gap = random.randint(1, max(1, avail - fH))
    fr_start = N + 1 + gap
    f_col = random.randint(0, max(0, 4 - fW))
    frame_region = grid[fr_start:fr_start + fH, mc0 + f_col:mc0 + f_col + fW]
    frame_region[leg["frame_mask"]] = leg["frame_color"]


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")
from __future__ import annotations

from collections import defaultdict

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.

    Input structure:
    - The background is the most common color.
    - Foreground objects are solid monochrome rectangles touching a grid corner.
    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.

    Rule:
    - Clear the multiple objects of the repeated color from their original positions.
    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.

    Key insight:
    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    by_color: dict[int, list[dict]] = defaultdict(list)
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        by_color[int(comp["color"])].append(comp)

    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
    assert len(moving_colors) == 1
    moving_color = int(moving_colors[0])
    moving_objects = by_color[moving_color]

    out = g.copy()
    for comp in moving_objects:
        coords = comp["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

    for comp in moving_objects:
        coords = comp["coords"]
        r0, c0, r1, c1 = map(int, comp["bbox"])
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        assert int(comp["area"]) == height * width

        touches_top = r0 == 0
        touches_bottom = r1 == H - 1
        touches_left = c0 == 0
        touches_right = c1 == W - 1
        assert touches_top != touches_bottom
        assert touches_left != touches_right

        dr = height if touches_top else -height
        dc = width if touches_left else -width
        shifted = coords + np.array([dr, dc], dtype=int)
        assert bool(
            np.all(
                (0 <= shifted[:, 0])
                & (shifted[:, 0] < H)
                & (0 <= shifted[:, 1])
                & (shifted[:, 1] < W)
            )
        )

        target = out[shifted[:, 0], shifted[:, 1]]
        assert bool(np.all((target == bg) | (target == moving_color)))
        out[shifted[:, 0], shifted[:, 1]] = moving_color

    return out

# --------------- generator (o5x) ---------------

# Corner and movement model.
CORNERS = ("TL", "TR", "BL", "BR")
DIAGONAL_PAIRS = ({"TL", "BR"}, {"TR", "BL"})
INWARD_STEP_FACTOR = 2
COMPACT_CANVAS_FACTOR = 3

# Canvas, object count, and retry bounds.
GRID_ROW_BOUNDS = (7, 22)
GRID_COL_BOUNDS = (7, 30)
SQUARE_SIZE_BOUNDS = (1, 4)
MOVING_COUNT_BOUNDS = (2, 4)
GENERATION_RETRIES = 300

# Color palette.
COLOR_VALUES = tuple(range(10))

def _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = 0 if corner[0] == "T" else H - s
    col = 0 if corner[1] == "L" else W - s
    return row, col


def _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = s if corner[0] == "T" else H - INWARD_STEP_FACTOR * s
    col = s if corner[1] == "L" else W - INWARD_STEP_FACTOR * s
    return row, col


def _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:
    sizes = []
    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):
        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):
            bg_area = H * W - len(CORNERS) * s * s
            if bg_area <= moving_count * s * s:
                continue
            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:
                continue
            sizes.append((H, W))
    return sizes


def _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:
    if moving_count == len(CORNERS):
        return set(CORNERS)
    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:
        return set(random.choice(DIAGONAL_PAIRS))
    return set(random.sample(CORNERS, moving_count))


def _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:
    ar, ac = a
    br, bc = b
    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s


def _sample_layout():
    """Return a collision-free layout tuple, or None when the sampled size cannot work."""
    s = random.randint(*SQUARE_SIZE_BOUNDS)
    moving_count = random.randint(*MOVING_COUNT_BOUNDS)
    sizes = _valid_sizes(s, moving_count)
    if not sizes:
        return None
    H, W = random.choice(sizes)

    moving = _pick_moving_corners(H, W, s, moving_count)
    singletons = [corner for corner in CORNERS if corner not in moving]

    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}
    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}
    for moved_pos in shifted.values():
        for kept_pos in singleton_pos.values():
            if _overlaps(moved_pos, kept_pos, s):
                return None
    return H, W, s, moving, singletons, shifted, singleton_pos


def _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:
    colors = list(COLOR_VALUES)
    bg = random.choice(colors)
    colors.remove(bg)
    moving_color = random.choice(colors)
    colors.remove(moving_color)
    singleton_colors = random.sample(colors, singleton_count)
    return bg, moving_color, singleton_colors


def _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):
    """Render the matching input/output grids for an accepted layout and palette."""
    rect = np.full((s, s), moving_color, dtype=int)
    out = np.full((H, W), bg, dtype=int)
    for corner in moving:
        paste(out, rect, *shifted[corner])
    for corner, color in zip(singletons, singleton_colors):
        patch = np.full((s, s), color, dtype=int)
        paste(out, patch, *singleton_pos[corner])

    inp = out.copy()
    for corner in moving:
        r, c = shifted[corner]
        inp[r : r + s, c : c + s] = bg
    for corner in moving:
        paste(inp, rect, *_corner_pos(corner, H, W, s))
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    layout = _sample_layout()
    if layout is None:
        return None
    H, W, s, moving, singletons, shifted, singleton_pos = layout
    bg, moving_color, singleton_colors = _sample_colors(len(singletons))
    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)
    try:
        return inp if np.array_equal(main(inp), out) else None
    except AssertionError:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 22208ba4 input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, neighbors4
import random


Coord = tuple[int, int]


def _ordered_path(coords: np.ndarray) -> list[Coord]:
    cells = {tuple(map(int, coord)) for coord in coords}
    assert len(cells) == len(coords), "path coordinates must be unique"

    degrees = {
        cell: sum((neighbor in cells) for neighbor in neighbors4(*cell))
        for cell in cells
    }
    endpoints = sorted(cell for cell, degree in degrees.items() if degree == 1)
    assert len(endpoints) == 2, "path must have exactly two endpoints"
    assert all(degree in (1, 2) for degree in degrees.values()), "path must not branch"

    path = []
    prev = None
    cur = endpoints[0]
    while True:
        path.append(cur)
        next_cells = [
            neighbor
            for neighbor in neighbors4(*cur)
            if neighbor in cells and neighbor != prev
        ]
        if not next_cells:
            break
        assert len(next_cells) == 1, "path traversal must be unique"
        prev, cur = cur, next_cells[0]

    assert len(path) == len(cells), "path traversal must visit every foreground pixel"
    return path


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reverse the sequence of colors along the single 4-connected foreground path while keeping the path shape fixed.

    Input structure:
    - The background is the dominant color.
    - All non-background pixels form one multicolor 4-connected one-pixel-wide path.
    - The path has exactly two endpoints and no branches.

    Rule:
    - Walk the path from one endpoint to the other.
    - Replace the colors on those same path cells by the original path colors in reverse order.
    - Leave every background pixel unchanged.

    Key insight:
    - Nothing moves geometrically; only the color string written on the path is reversed between the endpoints.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert len(components) == 1, "expected exactly one foreground path"

