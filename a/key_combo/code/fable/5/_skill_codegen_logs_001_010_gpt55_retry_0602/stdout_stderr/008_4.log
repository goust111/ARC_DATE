    r_hi = min(_SOURCE_MAX_TOP, H - h - _SOURCE_EDGE_GAP)
    r0 = random.randint(_SOURCE_EDGE_GAP, r_hi)

    c_lo, c_hi = _SOURCE_EDGE_GAP, W - w - _SOURCE_EDGE_GAP
    center = (W - w) // 2
    c_lo = max(c_lo, center - _SOURCE_CENTER_JITTER)
    c_hi = min(c_hi, center + _SOURCE_CENTER_JITTER)
    c0 = random.randint(c_lo, c_hi)
    return (r0, c0, r0 + h - 1, c0 + w - 1)


def _choose_grouped(candidates):
    if not candidates:
        return None
    groups = {}
    for item in candidates:
        groups.setdefault(item[1], []).append(item[0])
    return random.choice(random.choice(list(groups.values())))


def _is_visible_blocker(grid, source, rect, axis, side):
    sr0, sc0, sr1, sc1 = source
    r0, c0, r1, c1 = rect
    if axis == "h":
        for r in range(max(sr0, r0), min(sr1, r1) + 1):
            if side == "left":
                if not np.any(grid[r, c1 + 1 : sc0] == _BLUE):
                    return True
            else:
                if not np.any(grid[r, sc1 + 1 : c0] == _BLUE):
                    return True
    else:
        for c in range(max(sc0, c0), min(sc1, c1) + 1):
            if side == "up":
                if not np.any(grid[r1 + 1 : sr0, c] == _BLUE):
                    return True
            else:
                if not np.any(grid[sr1 + 1 : r0, c] == _BLUE):
                    return True
    return False


def _blocker_candidates(grid, source, rects):
    H, W = grid.shape
    sr0, sc0, sr1, sc1 = source
    candidates = []

    for h in _BLOCKER_HEIGHTS:
        for w in _BLOCKER_WIDTHS:
            for r in range(max(0, sr0 - h + 1), min(sr1, H - h) + 1):
                for side, c_range in (
                    ("left", range(0, sc0 - w - _RAY_OBJECT_GAP + 1)),
                    ("right", range(sc1 + _RAY_OBJECT_GAP + 1, W - w + 1)),
                ):
                    for c in c_range:
                        rect = (r, c, r + h - 1, c + w - 1)
                        if _fits(rect, rects, H, W) and _is_visible_blocker(grid, source, rect, "h", side):
                            candidates.append((rect, ("h", side, h, w)))

            for c in range(max(0, sc0 - w + 1), min(sc1, W - w) + 1):
                for side, r_range in (
                    ("up", range(0, sr0 - h - _RAY_OBJECT_GAP + 1)),
                    ("down", range(sr1 + _RAY_OBJECT_GAP + 1, H - h + 1)),
                ):
                    for r in r_range:
                        rect = (r, c, r + h - 1, c + w - 1)
                        if _fits(rect, rects, H, W) and _is_visible_blocker(grid, source, rect, "v", side):
                            candidates.append((rect, ("v", side, h, w)))

    return candidates


def _place_blockers(grid, source, rects):
    """Place visible blue blockers; return False if any required choice fails."""
    for _ in range(random.randint(*_BLOCKER_COUNT_RANGE)):
        rect = _choose_grouped(_blocker_candidates(grid, source, rects))
        if rect is None:
            return False
        _place(grid, rect, _BLUE)
        rects.append(rect)
    return True


def _ray_mask(grid, source):
    H, W = grid.shape
    sr0, sc0, sr1, sc1 = source
    mask = np.zeros((H, W), dtype=bool)
    for r in range(sr0, sr1 + 1):
        for c in range(sc0 - 1, -1, -1):
            if grid[r, c] == _BLUE:
                break
            mask[r, c] = True
        for c in range(sc1 + 1, W):
            if grid[r, c] == _BLUE:
                break
            mask[r, c] = True
    for c in range(sc0, sc1 + 1):
        for r in range(sr0 - 1, -1, -1):
            if grid[r, c] == _BLUE:
                break
            mask[r, c] = True
        for r in range(sr1 + 1, H):
            if grid[r, c] == _BLUE:
                break
            mask[r, c] = True
    return mask


def _red_candidates(ray_mask, rects, want_path):
    H, W = ray_mask.shape
    candidates = []
    for h in _RED_HEIGHTS:
        for w in _RED_WIDTHS:
            for r in range(0, H - h + 1):
                for c in range(0, W - w + 1):
                    rect = (r, c, r + h - 1, c + w - 1)
                    if not _fits(rect, rects, H, W):
                        continue
                    in_path = bool(np.any(ray_mask[r : r + h, c : c + w]))
                    if in_path == want_path:
                        candidates.append((rect, (h, w)))
    return candidates


def _place_red_objects(grid, ray_mask, rects):
    """Place red rectangles with the preselected path/non-path role mix."""
    red_count = random.randint(*_RED_COUNT_RANGE)
    path_count = random.randint(_RED_PATH_COUNT_MIN, red_count - 1)
    red_roles = [True] * path_count + [False] * (red_count - path_count)
    random.shuffle(red_roles)
    for want_path in red_roles:
        rect = _choose_grouped(_red_candidates(ray_mask, rects, want_path))
        if rect is None:
            return False
        _place(grid, rect, _RED)
        rects.append(rect)
    return True


def _gen_attempt():
    W = random.randint(*_GRID_WIDTH_RANGE)
    grid = np.zeros((_GRID_HEIGHT, W), dtype=int)

    source = _source_rect(*grid.shape)
    rects = [source]
    _place(grid, source, _TEAL)
    if not _place_blockers(grid, source, rects):
        return None

    ray_mask = _ray_mask(grid, source)
    if not _place_red_objects(grid, ray_mask, rects):
        return None

    colors = set(map(int, np.unique(grid)))
    if colors != _REQUIRED_INPUT_COLORS or _YELLOW in colors:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(_MAX_GENERATION_ATTEMPTS):
        inp = _gen_attempt()
        if inp is None:
            continue
        try:
            out = main(inp)
        except Exception:
            continue
        if out.shape == inp.shape and not np.array_equal(out, inp):
            return inp
    raise RuntimeError("failed to generate a valid 6ffe8f07 input")
from __future__ import annotations
import numpy as np
from arc_utils import components_mask, find_components, get_bg

def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble colored sprites into a central bar's notches, chaining successive pieces along fixed-width strips.

    Input structure:
    - bg = most common color. Largest monochrome component is a solid "bar" with boundary notches (bg holes opening to its bbox edge).
    - Several smaller colored sprites scattered around the bar.

    Rule:
    - Each bar notch is filled by a root piece whose shape exactly covers the hole.
    - The root defines a strip (column-span or row-span) for its chain.
    - Successive pieces fill the bg cells inside the previous piece's bbox, locked to the same strip width.
    - Multiple chains grow independently from different bar notches.

    Key insight: The root piece's extent perpendicular to the chain direction locks the strip width for all subsequent pieces in that chain.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    bg = get_bg(g)

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    comps.sort(key=lambda d: -d["area"])
    assert comps

    bar = comps[0]
    pieces_raw = comps[1:]

    out = np.full((H, W), int(bg), dtype=int)
    bar_r0, bar_c0, bar_r1, bar_c1 = map(int, bar["bbox"])
    bar_h, bar_w = bar_r1 - bar_r0 + 1, bar_c1 - bar_c0 + 1
    bar_color = int(bar["color"])
    bar_occ = set((int(r), int(c)) for r, c in bar["coords"])
    bar_mask = np.zeros((bar_h, bar_w), dtype=bool)
    for r, c in bar_occ:
        bar_mask[r - bar_r0, c - bar_c0] = True
    for r, c in bar_occ:
        out[r, c] = bar_color

    def shape_from_coords(coords: np.ndarray, bbox):
        r0, c0, r1, c1 = map(int, bbox)
        h, w = r1 - r0 + 1, c1 - c0 + 1
        rel = [(int(r - r0), int(c - c0)) for r, c in coords]
        rel_set = set(rel)
        return {"rel": rel, "rel_set": rel_set, "h": h, "w": w}

    pieces = []
    for p in pieces_raw:
        # For this puzzle, pieces are used in their original orientation (no rotation / flip).
        r0, c0 = map(int, p["bbox"][:2])
        pieces.append({"color": int(p["color"]), "shape": shape_from_coords(p["coords"], p["bbox"]), "orig": (r0, c0)})

    def bar_notches(bar_mask, bar_r0, bar_c0):
        empty = ~bar_mask
        h, w = map(int, empty.shape)
        notches = []
        for pts in components_mask(empty, connectivity=4):
            r = pts[:, 0]
            c = pts[:, 1]
            top = int((r == 0).sum())
            bottom = int((r == h - 1).sum())
            left = int((c == 0).sum())
            right = int((c == w - 1).sum())

            # Keep only holes that open to the bar bbox boundary.
            if top + bottom + left + right == 0:
                continue

            hole_gl = set((bar_r0 + int(rr), bar_c0 + int(cc)) for rr, cc in pts)

            # Axis is determined by which bbox side has the widest mouth.
            side, mouth_n = max(
                [(name, cnt) for name, cnt in [("top", top), ("bottom", bottom), ("left", left), ("right", right)] if cnt > 0],
                key=lambda x: x[1],
            )
            axis = "cols" if side in ("top", "bottom") else "rows"
            notches.append({"axis": axis, "hole": hole_gl, "mouth_n": mouth_n})
        return notches

    notches = bar_notches(bar_mask, bar_r0, bar_c0)

    def pixels(v, top, left):
        return set((top + lr, left + lc) for lr, lc in v["rel"])

    def placement_pts(v, top, left, occ, must_cover=None, strip=None):
        if top < 0 or left < 0 or top + v["h"] > H or left + v["w"] > W:
            return None
        if strip is not None:
            axis, A, B = strip
            if axis == "cols":
                if left != A or v["w"] != B - A + 1:
                    return None
            else:
                if top != A or v["h"] != B - A + 1:
                    return None
        pts = pixels(v, top, left)
        if pts & occ:
            return None
        if must_cover is not None and not (must_cover <= pts):
            return None
        return pts

    def aligned_positions(axis, A, cover, v):
        if axis == "cols":
            left = A
            tops = set()
            for rN, cN in cover:
                for lr, lc in v["rel"]:
                    if cN == left + lc:
                        tops.add(rN - lr)
            for top in tops:
                yield top, left
        else:
            top = A
            lefts = set()
            for rN, cN in cover:
                for lr, lc in v["rel"]:
                    if rN == top + lr:
                        lefts.add(cN - lc)
            for left in lefts:
                yield top, left

    def touches(pts, other):
        for r, c in pts:
            for dr, dc in DIR4:
                if (r + dr, c + dc) in other:
                    return True
        return False

    def hole_positions(hole, v):
        pos = set()
        for rH, cH in hole:
            for lr, lc in v["rel"]:
                pos.add((rH - lr, cH - lc))
        return pos

    # Root candidates: fill the bar hole (no strip constraint yet).
    root_cands = []
    for ni, n in enumerate(notches):
        axis = n["axis"]

        for pi, p in enumerate(pieces):
            v = p["shape"]
            for top, left in hole_positions(n["hole"], v):
                pts = placement_pts(v, top, left, bar_occ, must_cover=n["hole"])
                if pts is None:
                    continue
                if axis == "cols":
                    A, B = int(left), int(left + v["w"] - 1)
                else:
                    A, B = int(top), int(top + v["h"] - 1)
                mv = abs(int(top) - int(p["orig"][0])) + abs(int(left) - int(p["orig"][1]))
                root_cands.append(
                    (
                        (int(mv), -int(n["mouth_n"])),
                        {"ni": ni, "pi": pi, "top": int(top), "left": int(left), "axis": axis, "A": A, "B": B, "shape": v},
                    )
                )

    root_cands.sort(key=lambda x: x[0])
    cand_roots = [pair[1] for pair in root_cands[:20]]

    best_out = out.copy()
    best_key = None

    def search(out_grid, occ_set, chains, remaining):
        nonlocal best_out, best_key
        placed_cnt = len(pieces) - len(remaining)
        key = (placed_cnt, -len(remaining), -len(occ_set))
        if best_key is None or key > best_key:
            best_key = key
            best_out = out_grid.copy()
        if not remaining:
            return True

        def gen_extend_moves(chain, remaining_set):
            axis = chain["axis"]
            A, B = int(chain["A"]), int(chain["B"])
            head = chain["head"]
            head_pts = pixels(head["shape"], head["top"], head["left"])
            head_top, head_left = int(head["top"]), int(head["left"])
            head_h, head_w = int(head["shape"]["h"]), int(head["shape"]["w"])

            cavity = {
                (r, c)
                for r in range(head_top, head_top + head_h)
                for c in range(head_left, head_left + head_w)
                if out_grid[r, c] == bg
            }
            if not cavity:
                return []

            moves = []
            for pi in remaining_set:
                v = pieces[pi]["shape"]
                for top, left in aligned_positions(axis, A, cavity, v):
                    pts = placement_pts(v, top, left, occ_set, must_cover=cavity, strip=(axis, A, B))
                    if pts is None:
                        continue
                    if not touches(pts, head_pts):
                        continue
                    moves.append((pi, top, left, pts, v))
            return moves

        # Try extending any chain.
        for ch in chains:
            moves = gen_extend_moves(ch, remaining)
            if not moves:
                continue
            # small branching factor is enough for this puzzle
            for pi, top, left, pts, v in moves[:8]:
                # apply
                for r, c in pts:
                    out_grid[r, c] = int(pieces[pi]["color"])
                old_head = ch["head"]
                ch["head"] = {"top": int(top), "left": int(left), "shape": v}
                occ2 = set(occ_set) | set(pts)
                rem2 = set(remaining)
                rem2.remove(pi)
                if search(out_grid, occ2, chains, rem2):
                    return True
                # undo
                ch["head"] = old_head
                for r, c in pts:
                    out_grid[r, c] = int(bg)
                # restore bar pixels (roots are always non-overlapping)
                for r, c in bar_occ:
                    out_grid[r, c] = bar_color
        return False

    # Try small root subsets (1..3) from top candidates.
    from itertools import combinations

    for k in range(1, min(3, len(cand_roots)) + 1):
        for roots_sel in combinations(range(len(cand_roots)), k):
            used_p = set()
            used_n = set()
            occ0 = set(bar_occ)
            out0 = np.full((H, W), int(bg), dtype=int)
            for r, c in bar_occ:
                out0[r, c] = bar_color

            chains = []
            ok = True
            for idx in roots_sel:
                root = cand_roots[idx]
                if root["pi"] in used_p or root["ni"] in used_n:
                    ok = False
                    break
                pts = pixels(root["shape"], root["top"], root["left"])
                if pts & occ0:
                    ok = False
                    break
                used_p.add(root["pi"])
                used_n.add(root["ni"])
                for r, c in pts:
                    out0[r, c] = int(pieces[root["pi"]]["color"])
                occ0 |= pts
                chains.append({"axis": root["axis"], "A": root["A"], "B": root["B"], "head": {"top": root["top"], "left": root["left"], "shape": root["shape"]}})

            if not ok:
                continue
            remaining = set(range(len(pieces))) - used_p
            search(out0, occ0, chains, remaining)

    return best_out


# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------

def _connected(cells):
    """Check 4-connectivity of a cell set."""
    if len(cells) <= 1:
        return True
    cells_set = set(cells)
    start = next(iter(cells_set))
    visited = {start}
    stack = [start]
    while stack:
        r, c = stack.pop()
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nb = (r + dr, c + dc)
            if nb in cells_set and nb not in visited:
                visited.add(nb)
                stack.append(nb)
    return len(visited) == len(cells_set)


def _grow_connected(rng, available, target, seeds, must_span_axis=None, span_range=None, retries=3):
    """Grow a 4-connected shape of exactly *target* cells within *available*, starting from *seeds*.

    *must_span_axis* ("cols"/"rows") + *span_range* (A, B) enforce that the
    resulting shape spans from A to B along that axis.

