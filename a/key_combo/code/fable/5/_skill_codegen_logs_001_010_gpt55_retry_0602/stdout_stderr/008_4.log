+        np.asarray([[1], [1]], dtype=bool),
+        np.asarray([[1, 0], [1, 1]], dtype=bool),
+        np.asarray([[1, 1], [0, 1]], dtype=bool),
+    )
+    return random.choice(choices).copy()
