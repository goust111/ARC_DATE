+def _solid_rectangle_masks(grid: np.ndarray) -> list[tuple[int, np.ndarray]]:
+    """Return colors whose complete occurrence set is one nontrivial rectangle."""
+    g = np.asarray(grid, dtype=int)
+    found: list[tuple[int, np.ndarray]] = []
