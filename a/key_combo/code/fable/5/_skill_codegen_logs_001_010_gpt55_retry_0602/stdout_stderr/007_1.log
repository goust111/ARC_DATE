+    has_visible_vertical_mate = False
+    has_blocked_direct_mate = False
+    for r, c in np.argwhere(hidden):
+        r, c = int(r), int(c)
+        h = (n - 1 - r, c)
+        v = (r, n - 1 - c)
+        hv = (n - 1 - r, n - 1 - c)
+        if bool(hidden[h] and hidden[v] and hidden[hv]):
