+    rolled = np.roll(g, shift=(dr, dc), axis=(0, 1))
+    hidden = np.roll(marker_mask, shift=(dr, dc), axis=(0, 1))
+    restored_rolled = _restore_in_rolled_frame(rolled, hidden)
+    restored = np.roll(restored_rolled, shift=(-dr, -dc), axis=(0, 1))
