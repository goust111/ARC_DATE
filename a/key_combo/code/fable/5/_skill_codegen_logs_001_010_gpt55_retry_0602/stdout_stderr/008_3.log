+
+    side = random.choice(("left", "right"))
+    sep_col = np.full((h, 1), separator, dtype=int)
+    if side == "left":
+        grid = np.concatenate((polluted, sep_col, healthy_aligned[:, ::-1]), axis=1)
+    else:
