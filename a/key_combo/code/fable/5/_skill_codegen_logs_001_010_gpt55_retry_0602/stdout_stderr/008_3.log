                    if orientation == "horizontal":
                        remaining = {(r, c) for r in range(t_r0, t_r1 + 1) for c in range(sc0, sc1 + 1)
                                     if (r, c) not in occ_set and (r, c) not in piece_cells}
                    else:
                        remaining = {(r, c) for r in range(sA, sB + 1) for c in range(t_c0, t_c1 + 1)
