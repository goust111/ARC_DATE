+    r0, c0, r1, c1 = rect
+    assert r1 - r0 >= 3 and c1 - c0 >= 3, "the implied rectangle must have a visible interior"
+    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == bg), (
