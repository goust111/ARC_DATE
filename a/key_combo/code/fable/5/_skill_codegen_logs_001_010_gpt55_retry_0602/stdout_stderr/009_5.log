+
+def _known_ray_cells(side: str, peak: int, depth: int, shape: tuple[int, int], rect: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    height, width = shape
+    if side == "top":
+        tip = (depth - 1, peak)
+    elif side == "bottom":
+        tip = (height - depth, peak)
+    elif side == "left":
+        tip = (peak, depth - 1)
+    else:
