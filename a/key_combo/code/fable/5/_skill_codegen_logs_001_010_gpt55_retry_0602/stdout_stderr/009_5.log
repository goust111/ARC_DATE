+    bottom_tip = terrains["bottom"]["tip"]
+    left_tip = terrains["left"]["tip"]
+    right_tip = terrains["right"]["tip"]
+    assert top_tip[0] <= r0 - 2 and bottom_tip[0] >= r1 + 2
+    assert left_tip[1] <= c0 - 2 and right_tip[1] >= c1 + 2
