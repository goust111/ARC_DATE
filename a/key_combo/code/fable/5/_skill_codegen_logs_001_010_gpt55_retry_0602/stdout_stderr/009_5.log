+    out = g.copy()
+    out[r0, c0 : c1 + 1] = winner_color
+    out[r1, c0 : c1 + 1] = winner_color
+    out[r0 : r1 + 1, c0] = winner_color
+    out[r0 : r1 + 1, c1] = winner_color
