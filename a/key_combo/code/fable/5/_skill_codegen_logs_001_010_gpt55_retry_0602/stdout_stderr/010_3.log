+    stop_c = random.randint(3, w - 8)
+    small_c = random.randint(stop_c + 4, w - 4)
+    large_r = random.randint(cross_r + 4, h - 5)
+    core = [
+        (left, [(cross_r, small_c)]),
+        (bottom, [(cross_r, stop_c), (cross_r + 1, stop_c)]),
+        (top, [(large_r + i, stop_c + 1) for i in range(3)]),
+    ]
