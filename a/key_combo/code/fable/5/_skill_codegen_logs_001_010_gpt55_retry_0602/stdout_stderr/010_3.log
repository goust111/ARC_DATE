from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste, random_free_location
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill holes inside a large template frame using shape-matched outside sprites.

    Input structure:
    - bg = most common color. One large monochrome frame object (template).
    - Inside the frame: holes of various shapes (non-frame-color regions).
    - Outside the frame: small monochrome sprites scattered on bg.

    Rule:
    - Crop to the frame's bounding box; fill entirely with frame color.
    - For each hole, find an outside sprite whose shape matches (rotation/flip allowed).
    - Fill the hole with the matched sprite's color. If multiple sprites match, use the most frequent color.

    Key insight: Sprites act as shape-coded color keys — their shape identifies which hole they fill, their color determines the fill color.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # STEP 1) Find the template frame: largest connected component of any non-bg color (8-connected).
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
    assert comps
    frame_area = max(int(comp["area"]) for comp in comps)
    frame_candidates = [comp for comp in comps if int(comp["area"]) == frame_area]
    assert len(frame_candidates) == 1
    frame = frame_candidates[0]
    frame_col = int(frame["color"])
    fb = frame["bbox"]
    r0, c0, r1, c1 = map(int, fb)

    sub = crop_bbox(g, fb)
    th, tw = sub.shape

    # STEP 2) Extract hole components inside the bbox (anything not equal to frame color), 4-connected.
    hole_mask = (sub != int(frame_col))
    holes: list[tuple[tuple[tuple[int, int], bytes], tuple[int, int], np.ndarray]] = []  # (key, (r0,c0), mask)
    for coords in components_mask(hole_mask, connectivity=4):
        hr0, hc0, hr1, hc1 = bbox_coords(coords)
        hh = int(hr1 - hr0 + 1)
        ww = int(hc1 - hc0 + 1)
        rel = coords - np.array([hr0, hc0])
        m = np.zeros((hh, ww), dtype=bool)
        m[rel[:, 0], rel[:, 1]] = True
        key = (m.shape, m.tobytes())
        holes.append((key, (int(hr0), int(hc0)), m))

    # STEP 3) Extract sprites outside the bbox.
    outside = g.copy()
    outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
    spr_comps = find_components(outside, bg=bg, connectivity=8, monochromatic=False, return_format="dict")

    # key -> color -> count
    sprites_by_key: dict[tuple[tuple[int, int], bytes], dict[int, int]] = {}

    def _all_mask_keys(mask: np.ndarray):
        """Generate keys for all rotations (and optional vertical flip) of a boolean mask."""
        m0 = mask.astype(bool)
        for flip in (False, True):
            m1 = np.flipud(m0) if flip else m0
            for k in range(4):
                m2 = np.rot90(m1, k)
                yield (m2.shape, m2.tobytes())

    for comp in spr_comps:
        coords = comp["coords"]
        bb = comp["bbox"]
        sr0, sc0, sr1, sc1 = map(int, bb)
        hh = int(sr1 - sr0 + 1)
        ww = int(sc1 - sc0 + 1)

        vals = [int(v) for v in g[coords[:, 0], coords[:, 1]]]
        scol = int(Counter(vals).most_common(1)[0][0])

        rel = coords - np.array([sr0, sc0])
        m = np.zeros((hh, ww), dtype=bool)
        m[rel[:, 0], rel[:, 1]] = True

        for key in _all_mask_keys(m):
            bucket = sprites_by_key.setdefault(key, {})
            bucket[scol] = int(bucket.get(scol, 0)) + 1

    # STEP 4) Render output: start from solid frame color, then fill each hole by shape match.
    out = np.full((th, tw), int(frame_col), dtype=int)
    for key, (hr0, hc0), hmask in holes:
        cmap = sprites_by_key.get(key)
        assert cmap is not None
        # choose the most frequent sprite color for this shape; break ties by preferring smaller color id
        scol = max(cmap.items(), key=lambda kv: (kv[1], -kv[0]))[0]
        patch = np.full(hmask.shape, int(scol), dtype=int)
        paste(out, patch, int(hr0), int(hc0), mask=hmask)

    return out

# --------------- generator (att1) ---------------

# ── Configuration ──────────────────────────────────────────────────────
NUM_COLORS = 10
GRID_SIZE = 30

# Frame bbox dimensions
FRAME_H_RANGE = (7, 13)
FRAME_W_RANGE = (7, 20)

# Hole layout
SHAPE_COUNT_RANGE = (3, 6)          # distinct canonical hole shapes
MIN_SHAPES = 3                       # minimum to accept a layout
SHAPE_MAX_AREA = 8                   # max cells per hole shape
FRAME_DENSITY_RANGE = (0.55, 0.92)   # fraction of frame_col in frame bbox
MIN_TOTAL_HOLES = 5                  # minimum hole instances
PLACEMENT_RETRIES = 80               # retries per symmetric placement attempt
MULT_EVEN_WEIGHTS = ([1, 2], [4, 1])       # (values, weights) for even-dim frames
MULT_ODD_WEIGHTS = ([1, 2, 3], [3, 2, 1])  # (values, weights) for odd-dim frames

# Sprite scattering
WINNING_SPRITE_RANGE = (2, 5)        # winning-color sprites per hole shape
OTHER_COLOR_MAX = 2                  # max distinct losing colors per shape
SPRITE_PADDING = 1                   # Chebyshev separation (bg cells)

# Generation retry budget
MAX_GEN_ATTEMPTS = 300


def _all_rot_flip(mask: np.ndarray):
    """Yield (key, oriented_mask) for all 8 rotation/flip variants of a bool mask."""
    m0 = mask.astype(bool)
    for flip in (False, True):
        m1 = np.flipud(m0) if flip else m0
        for k in range(4):
            m2 = np.rot90(m1, k)
            yield (m2.shape, m2.tobytes()), m2


def _canonical_key(mask: np.ndarray):
    """Smallest key across all rotation/flip variants (canonical representative)."""
    except ValueError:
        return False
    paste(placement, patch, r, c, transparent=bg)
    paste(inp, patch, r, c, transparent=bg)
    return True


def _scatter_sprites(inp, shape_info, bg, frame_col):
    """Place winning and losing sprites for each hole shape outside the frame.
    Returns True on success, False if placement space exhausted."""
    placement = inp.copy()
    other_pool = [c for c in range(NUM_COLORS) if c != bg and c != frame_col]

    for shape, fill_color, _ in shape_info:
        orientations = _all_orientations(shape)
        n_winning = random.randint(*WINNING_SPRITE_RANGE)
        losers = [c for c in other_pool if c != fill_color]
        n_other = random.randint(1, min(OTHER_COLOR_MAX, len(losers))) if losers else 0
        oc_list = random.sample(losers, min(n_other, len(losers)))

        # Place winning-color sprites (must all succeed)
        for _ in range(n_winning):
            if not _place_sprite(inp, placement, random.choice(orientations), fill_color, bg):
                return False

        # Place losing-color sprites (break on failure, not fatal)
        for oc in oc_list:
            n_oc = random.randint(1, max(1, n_winning - 1))
            for _ in range(n_oc):
                if not _place_sprite(inp, placement, random.choice(orientations), oc, bg):
                    break
    return True


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build symmetric frame, scatter sprites, validate."""
    bg = random.randint(0, NUM_COLORS - 1)
    frame_col = random.choice([c for c in range(NUM_COLORS) if c != bg])
    th = random.randint(*FRAME_H_RANGE)
    tw = random.randint(*FRAME_W_RANGE)

    layout = _build_hole_layout(th, tw)
    if layout is None:
        return None
    occ, hole_placements = layout

    result = _build_output(occ, hole_placements, frame_col, bg)
    if result is None:
        return None
    output, shape_info = result

    # Place frame (with holes as bg) on the 30x30 grid
    fr = random.randint(0, GRID_SIZE - th)
    fc_pos = random.randint(0, GRID_SIZE - tw)
    inp = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)
    paste(inp, np.where(occ, frame_col, bg).astype(int), fr, fc_pos)

    if not _scatter_sprites(inp, shape_info, bg, frame_col):
        return None

    # Oracle check
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        pass
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GEN_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {MAX_GEN_ATTEMPTS} attempts")
import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste
import random


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """
    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
    """
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.

    Input structure:
    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.
    - Each quadrant contains a red (2) square anchor block of varying size.
    - The top-left quadrant also has a colored motif attached to its red anchor.

    Rule:
    - Use the top-left quadrant's motif as the source pattern.
    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.
    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).
    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.

    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    bg = get_bg(g)
    mid_r, mid_c = _find_dividers(g, bg)

    # Find red anchor blocks (color 2) in each quadrant.
    red = components_mask(g == 2, connectivity=4)
    assert red, "grid must contain red (color 2) anchor blocks"

    # Quadrant key: (top/bottom, left/right)
    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
    # value: (r0,c0,size)
    for pts in red:
        r0, c0, r1, c1 = bbox_coords(pts)
        rr = (r0 + r1) // 2
        cc = (c0 + c1) // 2
        qb = 0 if rr < mid_r else 1
        qr = 0 if cc < mid_c else 1
        size = max(r1 - r0 + 1, c1 - c0 + 1)
        key = (qb, qr)
        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
        anchors[key] = (int(r0), int(c0), int(size))

    assert (0, 0) in anchors, "top-left quadrant must contain a red anchor block"
    sr0, sc0, sL = anchors[(0, 0)]
    assert sL > 0, "top-left red anchor must have positive size"

    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)
    # in the TL quadrant that contains the TL red anchor.
    tl = g[0:mid_r, 0:mid_c]
    comps = components_mask(tl != bg, connectivity=4)
    patch_bb = None
    for pts in comps:
        # component contains any red pixel?
        if any(tl[r, c] == 2 for r, c in pts):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch_bb = (int(r0), int(c0), int(r1), int(c1))
            break
    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with a red pixel"

    pr0, pc0, pr1, pc1 = patch_bb
    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()

    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
        src_h, src_w = img.shape
        if new_h <= 0 or new_w <= 0:
            return img.copy()
        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)
        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)
        rr = np.clip(rr, 0, src_h - 1)
        cc = np.clip(cc, 0, src_w - 1)
        return img[rr[:, None], cc[None, :]]

    # For each quadrant anchor, paste a scaled/reflected version of the patch.
    for (qb, qr), (tr0, tc0, tL) in anchors.items():
        if (qb, qr) == (0, 0):
            continue
        patch_t = patch
        if qr == 1:
            patch_t = np.fliplr(patch_t)
        if qb == 1:
            patch_t = np.flipud(patch_t)

        ratio = float(tL) / float(sL)
        new_h = int(round(patch_t.shape[0] * ratio))
        new_w = int(round(patch_t.shape[1] * ratio))
        new_h = max(1, new_h)
        new_w = max(1, new_w)
        patch_s = resize_nn(patch_t, new_h, new_w)
        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
        assert np.array_equal(roundtrip, patch_t), "scaling must preserve all motif information"

        # Align scaled red bbox in patch_s to the target red bbox.
        rr_red, cc_red = np.where(patch_s == 2)
        assert rr_red.size > 0, "scaled source patch must contain red anchor pixels"
        ar0, ac0 = int(rr_red.min()), int(cc_red.min())
        place_r0 = tr0 - ar0
        place_c0 = tc0 - ac0

        rr_p, cc_p = np.where(patch_s != bg)
        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
            val = int(patch_s[rr0, cc0])
            rr_t = place_r0 + rr0
            cc_t = place_c0 + cc0
            if not (0 <= rr_t < h and 0 <= cc_t < w):
                continue
            if rr_t == mid_r or cc_t == mid_c:
                continue
            if out[rr_t, cc_t] == 2:
    # Source pixel coordinates and their target positions
    src_rr, src_cc = np.where(patch_s != BG)
    tgt_rr = src_rr + place_r0
    tgt_cc = src_cc + place_c0

    # Mask: in-bounds, not on divider, target is not already red
    valid = ((tgt_rr >= 0) & (tgt_rr < GRID_SIZE) &
             (tgt_cc >= 0) & (tgt_cc < GRID_SIZE) &
             (tgt_rr != MID) & (tgt_cc != MID))
    tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]
    not_red = out[tgt_rr, tgt_cc] != RED
    out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, derive input, oracle-check."""
    target_sizes = {
        (0, 0): SOURCE_ANCHOR_SIZE,
        (0, 1): random.randint(*TARGET_SIZE_RANGE),
        (1, 0): random.randint(*TARGET_SIZE_RANGE),
        (1, 1): random.randint(*TARGET_SIZE_RANGE),
    }

    needs_block = any(s % SOURCE_ANCHOR_SIZE != 0 for k, s in target_sizes.items() if k != (0, 0))
    source = _source_patch(needs_block)
    if source is None:
        return None
    patch, anchor_r_in_patch, anchor_c_in_patch = source

    scaled = {
        key: _scaled_patch(patch, key[0], key[1], size)
        for key, size in target_sizes.items()
        if key != (0, 0)
    }

    # Place anchors
    anchors: dict[tuple[int, int], tuple[int, int]] = {}
    tl_r0 = random.randint(0, MID - patch.shape[0])
    tl_c0 = random.randint(0, MID - patch.shape[1])
    anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)
    for key, patch_s in scaled.items():
        anchors[key] = _choose_anchor(key[0], key[1], target_sizes[key], patch_s)

    # Build output grid
    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV
    paste(out, patch, tl_r0, tl_c0)
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        ar, ac = anchors[key]
        paste(out, np.full((size, size), RED, dtype=int), ar, ac)
    for key, patch_s in scaled.items():
        _stamp(out, patch_s, *anchors[key])

    # Build input: clear non-TL quadrants, keep only red anchors
    inp = out.copy()
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
        inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG
        ar, ac = anchors[key]
        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)

    return inp if np.array_equal(main(inp), out) else None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b10624e5 input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def _add_bar(bar_colors: dict[int, int], index: int, color: int) -> None:
    previous = bar_colors.setdefault(int(index), int(color))
    assert previous == int(color), "bar axis cannot receive two different colors"


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend each colored domino marker into a full row or column bar, with horizontal bars covering vertical bars at crossings.

    Input structure:
    - The background is the dominant color.
    - Every foreground object is a 4-connected same-color domino of exactly two pixels.
    - A horizontal domino marks a row to paint; a vertical domino marks a column to paint.

    Rule:
    - Paint each marked column entirely with the color of its vertical domino marker.
    - Paint each marked row entirely with the color of its horizontal domino marker.
    - Rows are painted after columns, so row bars overwrite column bars at intersections.

    Key insight:
    - The two-pixel orientation is the instruction: horizontal markers emit row bars, vertical markers emit column bars, and the only layering cue is row-over-column.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = get_bg(g)

    row_colors: dict[int, int] = {}
    col_colors: dict[int, int] = {}
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert components, "expected at least one foreground domino"

    for comp in components:
        color = int(comp["color"])
        coords = comp["coords"]
        assert len(coords) == 2, "each foreground object must be a two-pixel domino"
        r0, c0, r1, c1 = comp["bbox"]

        if r0 == r1 and c1 == c0 + 1:
            _add_bar(row_colors, r0, color)
        elif c0 == c1 and r1 == r0 + 1:
            _add_bar(col_colors, c0, color)
        else:
            raise AssertionError("domino marker must be horizontal or vertical")

    out = np.full_like(g, int(bg))
    for c, color in col_colors.items():
        out[:, c] = int(color)
    for r, color in row_colors.items():
        out[r, :] = int(color)
    return out

# --------------- generator (att2) ---------------

# Canvas and palette.
_GEN_BG = 7
_GEN_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
_GEN_SIZE_MIN = 7
_GEN_SIZE_MAX = 10

# Bar counts and color diversity.
_GEN_H_COUNT_MIN = 2
_GEN_H_COUNT_MAX = 3
_GEN_V_COUNT_MIN = 1
_GEN_V_COUNT_MAX = 4
_GEN_TOTAL_COUNT_MIN = 4
_GEN_TOTAL_COUNT_MAX = 7
_GEN_UNIQUE_COLOR_MIN = 3
_GEN_UNIQUE_COLOR_MAX = 5

# Marker placement.
_GEN_ROW_MARGIN = 1
_GEN_DOMINO_LEN = 2
_GEN_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
_GEN_MAX_ATTEMPTS = 300

def _gen_counts() -> tuple[int, int]:
    h_count = random.randint(_GEN_H_COUNT_MIN, _GEN_H_COUNT_MAX)
    min_v = max(_GEN_V_COUNT_MIN, _GEN_TOTAL_COUNT_MIN - h_count)
    max_v = min(_GEN_V_COUNT_MAX, _GEN_TOTAL_COUNT_MAX - h_count)
    return h_count, random.randint(min_v, max_v)

def _gen_bar_colors(n_bars: int) -> list[int]:
    n_unique = random.randint(_GEN_UNIQUE_COLOR_MIN, min(_GEN_UNIQUE_COLOR_MAX, n_bars))
    chosen = random.sample(_GEN_COLORS, n_unique)
    colors = chosen + [random.choice(chosen) for _ in range(n_bars - n_unique)]
    random.shuffle(colors)
    return colors

def _gen_bars(n: int) -> tuple[list[tuple[str, int, int]], list[tuple[str, int, int]]]:
    h_count, v_count = _gen_counts()
    rows = random.sample(range(_GEN_ROW_MARGIN, n - _GEN_ROW_MARGIN), h_count)
    cols = random.sample(range(n), v_count)
    colors = _gen_bar_colors(h_count + v_count)
    h_bars = [("h", r, colors[i]) for i, r in enumerate(rows)]
    v_bars = [("v", c, colors[h_count + i]) for i, c in enumerate(cols)]
    return h_bars, v_bars

def _gen_marker_options(n: int, orient: str, index: int, color: int):
    if orient == "h":
        opts = [
            (index, c, [(index, c), (index, c + 1)], np.full((1, _GEN_DOMINO_LEN), color, dtype=int))
            for c in range(n - _GEN_DOMINO_LEN + 1)
        ]
    else:
        opts = [
            (r, index, [(r, index), (r + 1, index)], np.full((_GEN_DOMINO_LEN, 1), color, dtype=int))
            for r in range(n - _GEN_DOMINO_LEN + 1)
        ]
    random.shuffle(opts)
    return opts

def _gen_can_place(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> bool:
    h, w = grid.shape
    cell_set = set(cells)
    for r, c in cells:
        if grid[r, c] != _GEN_BG:
            return False
        for dr, dc in _GEN_DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in cell_set and grid[rr, cc] == color:
                return False
    return True

def _gen_render_output(n: int, h_bars: list[tuple[str, int, int]], v_bars: list[tuple[str, int, int]]) -> np.ndarray:
    out = np.full((n, n), _GEN_BG, dtype=int)
    for _, c, color in v_bars:
        out[:, c] = color
    for _, r, color in h_bars:
        out[r, :] = color
    return out

def _gen_place_markers(n: int, bars: list[tuple[str, int, int]]) -> np.ndarray | None:
    grid = np.full((n, n), _GEN_BG, dtype=int)
    ordered = list(bars)
    random.shuffle(ordered)

    def backtrack(i: int) -> bool:
        if i == len(ordered):
            return True
        orient, index, color = ordered[i]
        for r0, c0, cells, patch in _gen_marker_options(n, orient, index, color):
            if not _gen_can_place(grid, cells, color):
                continue
            paste(grid, patch, r0, c0)
            if backtrack(i + 1):
                return True
            for r, c in cells:
                grid[r, c] = _GEN_BG
        return False

    return grid if backtrack(0) else None

def _gen_attempt() -> np.ndarray | None:
    n = random.randint(_GEN_SIZE_MIN, _GEN_SIZE_MAX)
    h_bars, v_bars = _gen_bars(n)
    out = _gen_render_output(n, h_bars, v_bars)
    inp = _gen_place_markers(n, h_bars + v_bars)
    if inp is None:
        return None
    if not np.array_equal(main(inp), out):
        return None
    return inp

def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate valid 9344f635 input")
import numpy as np
import random
from arc_utils import paste


def _bands(size: int, separators: list[int]) -> list[tuple[int, int]]:
    bands = []
    start = 0
    for cut in separators:
        if start < cut:
            bands.append((start, cut - 1))
        start = cut + 1
    if start < size:
        bands.append((start, size - 1))
    return bands


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extract the compact table of solid cells hidden inside a separator lattice.

    Input structure
    - The grid has full-width and full-height bars of one separator color, dividing it into rectangular cells.
    - Most cells contain a repeating multicolor pattern, while a contiguous rectangle of cells is solid monochrome.

    Rule
    - Split the input into lattice cells using the full separator rows and columns.
    - Keep the cells whose full interior is one color, crop to their occupied rectangle, and output those colors.

    Key insight
    - The periodic pattern is noise; only completely solid lattice cells encode the reduced output grid.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape

    row_colors = {int(g[r, 0]) for r in range(h) if np.all(g[r, :] == g[r, 0])}
    col_colors = {int(g[0, c]) for c in range(w) if np.all(g[:, c] == g[0, c])}
    sep_colors = row_colors & col_colors
    assert len(sep_colors) == 1, "there must be exactly one row/column separator color"
    sep = next(iter(sep_colors))
    assert row_colors == {sep}, "all full rows must be separator rows"
    assert col_colors == {sep}, "all full columns must be separator columns"

    sep_rows = [r for r in range(h) if np.all(g[r, :] == sep)]
    sep_cols = [c for c in range(w) if np.all(g[:, c] == sep)]
    assert sep_rows and sep_cols, "separator lattice must have rows and columns"

    row_bands = _bands(h, sep_rows)
    col_bands = _bands(w, sep_cols)

    solid_cells = {}
    for ri, (r0, r1) in enumerate(row_bands):
        for ci, (c0, c1) in enumerate(col_bands):
            cell = g[r0 : r1 + 1, c0 : c1 + 1]
            if np.all(cell == cell[0, 0]):
                solid_cells[(ri, ci)] = int(cell[0, 0])
    assert solid_cells, "must contain at least one solid lattice cell"

    solid_rows = [ri for ri, _ in solid_cells]
    solid_cols = [ci for _, ci in solid_cells]
    r0, r1 = min(solid_rows), max(solid_rows)
    c0, c1 = min(solid_cols), max(solid_cols)

    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    for ri in range(r0, r1 + 1):
        for ci in range(c0, c1 + 1):
            assert (ri, ci) in solid_cells, "solid lattice cells must form a rectangle"
            out[ri - r0, ci - c0] = solid_cells[(ri, ci)]
    return out

# --------------- generator (att2, o5x) ---------------

# Lattice dimensions: valid (L, cell_size) pairs produce 27-30 square grids.
VALID_LC = [(4, 6), (5, 5), (6, 4)]
COLOR_COUNT = 10
SEPARATOR_WIDTH = 1
# Solid rectangle: output block size in lattice coordinates.
SOLID_SIZE_RANGE = (2, 3)
# Pattern cells: diagonal variants are multicolor and solver-visible as non-solid.
PATTERN_TILE_MIN_COLORS = 5
PATTERN_CELL_MIN_COLORS = 2
DIAGONAL_ID_BITS = 4
# Retry budget: regenerate on rare validation failures.
MAX_GENERATION_ATTEMPTS = 300


def _pattern_tiles(csize: int, lattice: int, sep: int) -> dict[int, np.ndarray]:
    """Build one structured tile per lattice diagonal, or {} if validation fails."""
    colors = [c for c in range(COLOR_COUNT) if c != sep]
    random.shuffle(colors)
    palette = colors[: random.randint(PATTERN_TILE_MIN_COLORS, len(colors))]
    palette_arr = np.asarray(palette, dtype=int)
    k = len(palette)

    rr, cc = np.indices((csize, csize))
    base = (rr + cc + random.randrange(k)) % k
    if random.choice([False, True]):
        base = base.T
    if random.choice([False, True]):
        base = np.fliplr(base)
    if random.choice([False, True]):
        base = np.flipud(base)
    tiles = {}
    for diag in range(2 * lattice - 1):
        tile_idx = (base + random.randrange(k)) % k
        tile = palette_arr[tile_idx]
        # Encode the diagonal id in four cells so variants are guaranteed distinct.
        for bit in range(DIAGONAL_ID_BITS):
            tile.flat[bit] = palette[(diag >> bit) & 1]
        if len(np.unique(tile)) < PATTERN_TILE_MIN_COLORS:
            return {}
        tiles[diag] = tile
    return tiles


def _sample_solid_block(lattice, colors):
    """Return ((row, col, height, width), output colors) for the solid block."""
    solid_h = random.randint(*SOLID_SIZE_RANGE)
    solid_w = random.randint(*SOLID_SIZE_RANGE)
    solid_r0 = random.randint(0, lattice - solid_h)
    solid_c0 = random.randint(0, lattice - solid_w)
    flat = np.random.choice(colors, size=solid_h * solid_w).astype(int)
    if len(set(map(int, flat))) == 1:
        change_at = random.randrange(len(flat))
        flat[change_at] = random.choice([c for c in colors if c != int(flat[change_at])])
    return (solid_r0, solid_c0, solid_h, solid_w), flat.reshape((solid_h, solid_w))


def _render_grid(lattice, csize, sep, block, out, tiles):
    """Assemble the separator lattice from solid cells and pattern tiles."""
    n = lattice * csize + (lattice - 1)
    grid = np.full((n, n), sep, dtype=int)
    solid_r0, solid_c0, solid_h, solid_w = block
    stride = csize + SEPARATOR_WIDTH
    for ri in range(lattice):
        for ci in range(lattice):
            r0, c0 = ri * stride, ci * stride
            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:
                cell = np.full((csize, csize), int(out[ri - solid_r0, ci - solid_c0]), dtype=int)
            else:
                cell = tiles[(ri - ci) % (2 * lattice - 1)]
            paste(grid, cell, r0, c0)
    return grid


def _valid_generated_grid(grid, lattice, csize, sep, block):
    """Check separator lines and non-solid cells before the solver oracle."""
    stride = csize + SEPARATOR_WIDTH
    sep_lines = [csize + i * stride for i in range(lattice - 1)]
    if not all(np.all(grid[r, :] == sep) and np.all(grid[:, r] == sep) for r in sep_lines):
        return False
    solid_r0, solid_c0, solid_h, solid_w = block
    for ri in range(lattice):
        for ci in range(lattice):
            if solid_r0 <= ri < solid_r0 + solid_h and solid_c0 <= ci < solid_c0 + solid_w:
                continue
            r0, c0 = ri * stride, ci * stride
            if len(np.unique(grid[r0 : r0 + csize, c0 : c0 + csize])) < PATTERN_CELL_MIN_COLORS:
                return False
    return True


def _gen_attempt() -> np.ndarray | None:
    lattice, csize = random.choice(VALID_LC)
    sep = random.randrange(COLOR_COUNT)
    colors = [c for c in range(COLOR_COUNT) if c != sep]
    block, out = _sample_solid_block(lattice, colors)
    tiles = _pattern_tiles(csize, lattice, sep)
    if not tiles:
        return None
    grid = _render_grid(lattice, csize, sep, block, out, tiles)
    if not _valid_generated_grid(grid, lattice, csize, sep, block):
        return None
    try:
        if not np.array_equal(main(grid), out):
            return None
    except AssertionError:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 458e3a53 input")

