+def generate_input() -> np.ndarray:
+    """Generate a varied, semantically validated input grid no larger than 22x22."""
+    for _ in range(500):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid order-sensitive sliding scene")

