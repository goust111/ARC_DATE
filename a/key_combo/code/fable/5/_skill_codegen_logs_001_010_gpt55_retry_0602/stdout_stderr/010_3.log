+        # Area 2 is a necessary initial obstacle for area 1; after area 2 moves
+        # away, the settled area 1 is a necessary obstacle for area 3.
+        if 2 not in witnesses.get(1, set()) or 1 not in witnesses.get(3, set()):
+            return False
