+def _parse(grid: np.ndarray) -> tuple[int, dict[int, tuple[int, int]], list[dict]]:
+    """Read the corner background, four colored sides, and interior objects."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
