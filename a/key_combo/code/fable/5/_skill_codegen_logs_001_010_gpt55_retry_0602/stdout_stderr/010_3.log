+    top, bottom, left, right = random.sample([c for c in _PALETTE if c != bg], 4)
+
+    grid = np.full((h, w), bg, dtype=int)
+    grid[0, 1:-1] = top
+    grid[-1, 1:-1] = bottom
+    grid[1:-1, 0] = left
+    grid[1:-1, -1] = right
