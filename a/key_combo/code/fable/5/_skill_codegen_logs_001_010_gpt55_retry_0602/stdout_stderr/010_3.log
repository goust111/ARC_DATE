+    interior = g[1:-1, 1:-1]
+    assert set(map(int, np.unique(interior))) <= ({bg} | set(directions))
+    objects: list[dict] = []
+    for color, direction in directions.items():
+        for local in _components(interior == color):
+            coords = local + np.array([1, 1], dtype=int)
+            objects.append(
+                {
+                    "area": int(len(coords)),
+                    "color": int(color),
+                    "direction": direction,
+                    "coords": coords,
+                }
