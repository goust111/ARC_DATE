+        objects.append(placed_obj)
+
+    all_object_cells = set().union(*(obj["cells"] for obj in objects))
+    markers: list[tuple[int, int]] = []
+    for owner, obj in enumerate(objects):
+        candidates = _marker_candidates(obj["cells"], obj["direction"])
