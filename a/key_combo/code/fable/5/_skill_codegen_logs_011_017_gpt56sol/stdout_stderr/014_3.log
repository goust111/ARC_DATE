+
+def _swept_positions(
+    cells: set[tuple[int, int]], direction: tuple[int, int], steps: int
+) -> set[tuple[int, int]]:
+    swept: set[tuple[int, int]] = set()
+    for step in range(1, steps + 1):
+        swept |= _shift(cells, direction, step)
+    return swept
