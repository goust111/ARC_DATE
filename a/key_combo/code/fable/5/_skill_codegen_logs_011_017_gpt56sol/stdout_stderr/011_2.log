+
+
+def generate_input() -> np.ndarray:
+    """Generate varied valid scenes, alternating caught and floor branches."""
+    global _GEN_CALL_COUNT
+    want_container = (_GEN_CALL_COUNT % 2 == 0)
+    _GEN_CALL_COUNT += 1
+    for _ in range(_GEN_ATTEMPTS):
