+    occupied = {tuple(map(int, rc)) for rc in np.argwhere(grid != _GEN_BG)}
+    distractor_goal = random.randint(2, 6)
+    distractors = 0
+    candidates = [
+        (r, c)
+        for r in range(1, bottom - 4)
+        for c in range(1, w - 1)
+        if (r, c) not in forbidden_path and (r, c) not in occupied
+    ]
