+    if actual_box[3] >= w or base_box[3] >= w or not _boxes_separated([actual_box], base_box):
+        return None
+
+    containers: list[tuple[int, int, int, int]] = []
+    if want_container:
+        containers.extend((actual_box, base_box))
+    else:
