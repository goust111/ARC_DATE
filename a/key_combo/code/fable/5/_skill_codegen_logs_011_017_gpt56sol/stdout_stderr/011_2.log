from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste


def _closed_u_containers(g: np.ndarray, wall_color: int, bg: int) -> list[tuple[int, int, int, int]]:
    h, w = g.shape
    containers = []

    for bottom in range(1, h):
        for left in range(w - 2):
            if int(g[bottom, left]) != wall_color:
                continue
            for right in range(left + 2, w):
                if int(g[bottom, right]) != wall_color:
                    continue
                if not np.all(g[bottom, left : right + 1] == wall_color):
                    continue

                top = bottom
                while top > 0 and int(g[top - 1, left]) == wall_color and int(g[top - 1, right]) == wall_color:
                    top -= 1
                if top == bottom:
                    continue

                interior = g[top:bottom, left + 1 : right]
                if interior.size == 0 or not np.all(interior == bg):
                    continue
                containers.append((top, bottom, left, right))

    return containers


def main(grid: np.ndarray) -> np.ndarray:
    """
    Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.

    Input structure
    - The grid has a dominant background, one singleton marker pixel on the top row,
      and one other foreground color forming vertical bars and bottom segments.
    - A closed container is a U shape: two vertical side bars with a continuous
      bottom segment between them and an empty rectangular interior above the bottom.

    Rule
    - Remove the top marker from its original cell.
    - If exactly one closed U-shaped container has the marker column within its
      horizontal footprint, fill that container's empty interior with the marker color.
    - If no closed container is under the marker column, fill the whole bottom row
      with the marker color.

    Key insight
    - The marker does not identify a color by value; it identifies a vertical drop
      column, and only a structurally closed U shape can catch and contain the fill.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    foreground_colors = colors_present(g, exclude={bg})
    assert len(foreground_colors) == 2, "expected marker and wall colors"

    singleton_colors = [color for color in foreground_colors if int(np.count_nonzero(g == color)) == 1]
    assert len(singleton_colors) == 1, "expected exactly one singleton marker color"
    marker_color = singleton_colors[0]

    wall_colors = [color for color in foreground_colors if color != marker_color]
    assert len(wall_colors) == 1
    wall_color = wall_colors[0]

    marker_coords = np.argwhere(g == marker_color)
    assert marker_coords.shape == (1, 2)
    marker_r, marker_c = map(int, marker_coords[0])
    assert marker_r == 0, "marker must sit on the top row"

    containers = [
        container
        for container in _closed_u_containers(g, wall_color, bg)
        if container[0] > marker_r and container[2] <= marker_c <= container[3]
    ]
    assert len(containers) <= 1, "marker column must select at most one closed container"

    out = g.copy()
    out[marker_r, marker_c] = bg
    if containers:
        top, bottom, left, right = containers[0]
        out[top:bottom, left + 1 : right] = marker_color
    else:
        assert np.all(out[-1, :] == bg), "missed marker should fall to an empty bottom row"
        out[-1, :] = marker_color
    return out

# --------------- generator (o5x) ---------------

# Fixed ARC colors and canvas.
_GEN_BG = 0
_GEN_MARKER = 1
_GEN_WALL = 2
_GEN_H = 10
_GEN_W = 10

# Vertical layout bounds; row 9 stays empty in generated inputs.
_GEN_MARKER_ROW = 0
_GEN_MIN_WALL_ROW = 2
_GEN_LAST_WALL_ROW = 8

# Closed container interior size ranges, with exclusive upper bounds.
_GEN_INTERIOR_H_RANGE = (2, 4)
_GEN_INTERIOR_W_RANGE = (1, 6)

# Broken distractor patch size ranges, with exclusive upper bounds.
_GEN_DISTRACTOR_H_RANGE = (2, 4)
_GEN_DISTRACTOR_W_RANGE = (4, 7)

# Scenario mix and distractor count ranges, with exclusive upper bounds.
_GEN_FILL_CONTAINER_PROB = 0.67
_GEN_MISSED_HAS_U_PROB = 0.55
_GEN_DISTRACTORS_WITH_U_RANGE = (0, 2)
_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)

# Rejection-sampling retry budget.
_GEN_MAX_ATTEMPTS = 300


def _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:
    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)
    patch[:, 0] = _GEN_WALL
    patch[:, -1] = _GEN_WALL
    patch[-1, :] = _GEN_WALL
    return patch


def _gen_sample_u() -> tuple[int, int, int, int, int, int]:
    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))
    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))
    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))
    bottom = top + interior_h
    left = int(np.random.randint(0, _GEN_W - interior_w - 1))
    right = left + interior_w + 1
    return top, bottom, left, right, interior_h, interior_w


def _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:
    patch = np.full((height, width), _GEN_BG, dtype=int)
    if missing_side != "left":
        patch[:, 0] = _GEN_WALL
    if missing_side != "right":
        patch[:, -1] = _GEN_WALL
    patch[-1, :] = _GEN_WALL
    if gap is not None:
        patch[-1, gap] = _GEN_BG
    return patch


def _gen_distractor_patches() -> list[np.ndarray]:
    patches: list[np.ndarray] = []

    for h in range(*_GEN_DISTRACTOR_H_RANGE):
        for w in range(*_GEN_DISTRACTOR_W_RANGE):
            gap = int(np.random.randint(1, w - 1))
            patches.append(_gen_broken_u_patch(h, w, gap=gap))
            patches.append(_gen_broken_u_patch(h, w, missing_side="left"))
            patches.append(_gen_broken_u_patch(h, w, missing_side="right"))

    return patches


def _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:
    ph, pw = patch.shape
    local = np.argwhere(patch == _GEN_WALL)
    local_set = {(int(r), int(c)) for r, c in local}
    touch_local = {
        (r + dr, c + dc)
        for r, c in local_set
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))
        if (r + dr, c + dc) not in local_set
    }
    positions: list[tuple[int, int]] = []

    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):
        for c0 in range(0, _GEN_W - pw + 1):
            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):
                continue
            touches = any(
                0 <= r0 + r < _GEN_H
                and 0 <= c0 + c < _GEN_W
                and grid[r0 + r, c0 + c] == _GEN_WALL
                for r, c in touch_local
            )
            if not touches:
                positions.append((r0, c0))

    return positions


def _gen_place_distractors(grid: np.ndarray, count: int) -> bool:
    patches = _gen_distractor_patches()
    for _ in range(count):
        placed = False
        for idx in np.random.permutation(len(patches)):
            patch = patches[int(idx)]
            positions = _gen_valid_positions(grid, patch)
            if not positions:
                continue
            r0, c0 = positions[int(np.random.randint(0, len(positions)))]
            paste(grid, patch, r0, c0, transparent=_GEN_BG)
            placed = True
            break
        if not placed:
            return False
    return True


_GenUBox = tuple[int, int, int, int]


def _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:
    """Build the expected output and return metadata needed to derive the input."""
    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)
    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)
    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)
    u_box = None

    if has_u:
        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()
        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)
        u_box = (top, bottom, left, right)
        if fill_container:
            marker_c = int(np.random.randint(left + 1, right))
            expected[top:bottom, left + 1 : right] = _GEN_MARKER
        else:
            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]
            marker_c = int(outside[int(np.random.randint(0, len(outside)))])
            expected[-1, :] = _GEN_MARKER
        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))
    else:
        marker_c = int(np.random.randint(0, _GEN_W))
        expected[-1, :] = _GEN_MARKER
        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))

    return expected, fill_container, u_box, marker_c, distractor_count


def _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:
    inp = expected.copy()
    if fill_container:
        assert u_box is not None
        top, bottom, left, right = u_box
        inp[top:bottom, left + 1 : right] = _GEN_BG
    else:
        inp[-1, :] = _GEN_BG
    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER
    return inp


def _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:
    """Check structural invariants and the solver oracle."""
    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:
        return False
    if not np.all(inp[-1, :] == _GEN_BG):
        return False

    wall_coords = np.argwhere(inp == _GEN_WALL)
    if wall_coords.size == 0 or int(wall_coords[:, 0].min()) < _GEN_MIN_WALL_ROW or int(wall_coords[:, 0].max()) > _GEN_LAST_WALL_ROW:
        return False

    component_count = len(find_components(inp, bg=_GEN_BG, colors=[_GEN_WALL], connectivity=4))
    if not (1 <= component_count <= 3):
        return False

    containers = _closed_u_containers(inp, _GEN_WALL, _GEN_BG)
    if len(containers) > 1:
        return False
    if any(marker_c in (left, right) for _top, _bottom, left, right in containers):
        return False
    if fill_container:
        if len(containers) != 1 or containers[0] != u_box:
            return False
    elif containers and containers[0][2] <= marker_c <= containers[0][3]:
        return False

    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, expected)


def _gen_attempt() -> np.ndarray | None:
    expected, fill_container, u_box, marker_c, distractor_count = _gen_design_expected()
    if not _gen_place_distractors(expected, distractor_count):
        return None

    inp = _gen_input_from_expected(expected, fill_container, u_box, marker_c)
    if not _gen_valid_pair(inp, expected, fill_container, u_box, marker_c):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid db7260a4 input")
from __future__ import annotations
import numpy as np
from arc_utils import colors_present, components_mask, get_bg

def main(grid: np.ndarray) -> np.ndarray:
    """
    Trace diagonal rays from triangular arrows, reflecting off colored wall pixels.

    Input structure:
    - bg grid with monochrome 3-pixel L-shaped "arrows" (2x2 bbox missing one corner) and scattered colored wall pixels.

    Rule:
    - Each arrow fires a ray diagonally away from its missing corner, painting bg cells in its color.
    - A head-on wall hit reverses both axes; a side-touch wall hit flips the touched axis only.
    - On any bounce the ray adopts the wall's color and recolors the contact cell.
    - Ray stops when it exits the grid or reaches another arrow.

    Key insight: Two distinct reflection types (corner vs side-touch) plus color inheritance at each bounce drive the path geometry.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    def is_arrow_pts(pts: list[tuple[int, int]]) -> bool:
        if len(pts) != 3:
            return False
        rs = [r for r, _c in pts]
        cs = [c for _r, c in pts]
        return (max(rs) - min(rs) == 1) and (max(cs) - min(cs) == 1)

    def arrow_dir_and_start(pts: list[tuple[int, int]]):
        rs = [r for r, _c in pts]
        cs = [c for _r, c in pts]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
        miss = [p for p in corners if p not in set(pts)]
        if len(miss) != 1:
            return None
        mr, mc = miss[0]
        # direction away from missing corner
        dr = 1 if mr == r0 else -1
        dc = 1 if mc == c0 else -1

        pts_set = set(pts)
        deg = {p: 0 for p in pts}
        for r, c in pts:
            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if (rr, cc) in pts_set:
                    deg[(r, c)] += 1
        start = max(deg, key=lambda p: deg[p])  # right-angle corner
        return (int(dr), int(dc)), (int(start[0]), int(start[1]))

    # Detect arrows per-color (cannot rely on global non-bg connectivity).
    arrow_cells: set[tuple[int, int]] = set()
    arrows: list[tuple[int, list[tuple[int, int]]]] = []
    for col in colors_present(g, exclude={bg}):
        for coords in components_mask(g == int(col), connectivity=4):
            pts = [(int(r), int(c)) for r, c in coords]
            if is_arrow_pts(pts):
                arrows.append((int(col), pts))
                arrow_cells |= set(pts)

    wall_cells: set[tuple[int, int]] = {
        (int(r), int(c)) for r, c in np.argwhere(g != int(bg)) if (int(r), int(c)) not in arrow_cells
    }

    out = g.copy()

    for start_col, pts in arrows:
        info = arrow_dir_and_start(pts)
        if info is None:
            continue
        (dr, dc), cur = info
        cur_col = int(start_col)
        seen = set()

        while True:
            state = (cur, int(dr), int(dc), int(cur_col))
            if state in seen:
                break
            seen.add(state)

            nr = int(cur[0] + dr)
            nc = int(cur[1] + dc)
            if not (0 <= nr < H and 0 <= nc < W):
                break

            # Diagonal hit into a wall: corner reflection.
            if (nr, nc) in wall_cells:
                wcol = int(g[nr, nc])
                if int(g[int(cur[0]), int(cur[1])]) == int(bg):
                    out[int(cur[0]), int(cur[1])] = int(wcol)
                cur_col = int(wcol)
                dr, dc = -int(dr), -int(dc)
                continue

            # Arrow pixels act like blockers (sources only).
            if (nr, nc) in arrow_cells:
                break

            # Advance.
            cur = (int(nr), int(nc))
            if int(out[nr, nc]) == int(bg):
                out[nr, nc] = int(cur_col)

            # Side-touch bounces only when a wall lies in the direction of travel.
            if int(dr) == 1 and (nr + 1, nc) in wall_cells:
                wcol = int(g[nr + 1, nc])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dr = -int(dr)
            elif int(dr) == -1 and (nr - 1, nc) in wall_cells:
                wcol = int(g[nr - 1, nc])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dr = -int(dr)

            if int(dc) == 1 and (nr, nc + 1) in wall_cells:
                wcol = int(g[nr, nc + 1])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dc = -int(dc)
            elif int(dc) == -1 and (nr, nc - 1) in wall_cells:
                wcol = int(g[nr, nc - 1])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dc = -int(dc)

    return out


import random as _rng


def _gen_attempt() -> np.ndarray | None:
    """Single attempt to generate a valid input for task 142ca369.

    Output-first: for each arrow, plan the full zigzag ray path (with 0-4 side-touch
    bounces), place walls at bounce points, then derive the input (arrows + walls).
    """
    H, W = _rng.randint(18, 20), _rng.randint(18, 20)
    n_arrows = _rng.randint(1, 7)
    palette = list(range(1, 10))
    _rng.shuffle(palette)
    arrow_colors = palette[:n_arrows]

    grid = np.zeros((H, W), dtype=int)
    out = np.zeros((H, W), dtype=int)
    occupied: set[tuple[int, int]] = set()

    for ai in range(n_arrows):
        color = arrow_colors[ai]
        dr, dc = _rng.choice([-1, 1]), _rng.choice([-1, 1])
        n_bounces = _rng.choices([0, 1, 2, 3, 4], weights=[2, 3, 3, 2, 1])[0]

        placed = False
        for _ in range(60):
            # Start position with room for the 2x2 arrow bbox
            r_lo, r_hi = (1 if dr == -1 else 0), (H - 2 if dr == 1 else H - 1)
            c_lo, c_hi = (1 if dc == -1 else 0), (W - 2 if dc == 1 else W - 1)
            if r_lo > r_hi or c_lo > c_hi:
                continue
            sr, sc = _rng.randint(r_lo, r_hi), _rng.randint(c_lo, c_hi)

            # Arrow = 3 corners of 2x2 bbox, missing corner opposite to fire direction
            mr, mc = sr - dr, sc - dc
            arrow_pts = [(r, c) for r in (mr, sr) for c in (mc, sc) if (r, c) != (mr, mc)]
            if any(not (0 <= r < H and 0 <= c < W) or (r, c) in occupied for r, c in arrow_pts):
                continue

            # Trace ray path with planned bounces
            cur_r, cur_c, cur_dr, cur_dc, cur_col = sr, sc, dr, dc, color
            ray_cells: list[tuple[int, int, int]] = []
            walls: list[tuple[list[tuple[int, int]], int]] = []
            ray_set: set[tuple[int, int]] = set()
            arrow_set = set(arrow_pts)
            ok = True
            bounces_left = n_bounces

            for seg_idx in range(n_bounces + 1):
                max_steps = min(
                    (H - 1 - cur_r) if cur_dr == 1 else cur_r,
                    (W - 1 - cur_c) if cur_dc == 1 else cur_c,
                )
                if seg_idx < n_bounces and bounces_left > 0:
                    if max_steps < 4:
                        bounces_left = 0
                        seg_len = max_steps
                    else:
                        seg_len = _rng.randint(3, max(3, max_steps - 1))
                else:
                    seg_len = max_steps

                for _ in range(seg_len):
                    nr, nc = cur_r + cur_dr, cur_c + cur_dc
                    if not (0 <= nr < H and 0 <= nc < W):
                        break
                    if (nr, nc) in occupied or (nr, nc) in ray_set or (nr, nc) in arrow_set:
                        ok = False; break
                    ray_cells.append((nr, nc, cur_col))
                    ray_set.add((nr, nc))
                    cur_r, cur_c = nr, nc
                if not ok:
                    break

                if seg_idx >= n_bounces or bounces_left <= 0:
                    continue
                bounces_left -= 1

                # Collect feasible wall placements for this bounce
                options: list[tuple[list[tuple[int, int]], str]] = []
                # Horizontal wall (flips dr): center pixel at (cur_r+cur_dr, cur_c)
                wr, wc = cur_r + cur_dr, cur_c
                if 0 <= wr < H:
                    w3 = [(wr, wc + d) for d in (-1, 0, 1)]
                    if all(0 <= c < W for _, c in w3):
                        options.append((w3, 'dr'))
                    options.append(([(wr, wc)], 'dr'))
                # Vertical wall (flips dc): center pixel at (cur_r, cur_c+cur_dc)
                wr2, wc2 = cur_r, cur_c + cur_dc
                if 0 <= wc2 < W:
                    w3v = [(wr2 + d, wc2) for d in (-1, 0, 1)]
                    if all(0 <= r < H for r, _ in w3v):
                        options.append((w3v, 'dc'))
                    options.append(([(wr2, wc2)], 'dc'))
                if not options:
                    ok = False; break

                # Mix of 1-pixel and 3-pixel walls; shuffle with size preference
                _rng.shuffle(options)
                prefer_3 = _rng.random() < 0.6
                options.sort(key=lambda o: len(o[0]), reverse=prefer_3)
                chosen_wall = None
                for wpxs, flip in options:
                    if any((r, c) in occupied or (r, c) in ray_set or (r, c) in arrow_set
                           for r, c in wpxs):
                        continue
                    chosen_wall = (wpxs, flip)
                    break
                if chosen_wall is None:
                    ok = False; break

                wpxs, flip = chosen_wall
                wcol = _rng.choice(palette)
                walls.append((wpxs, wcol))

                # Bounce cell adopts wall color in output
                if ray_cells:
                    lr, lc, _ = ray_cells[-1]
                    ray_cells[-1] = (lr, lc, wcol)
                cur_col = wcol
                if flip == 'dr':
                    cur_dr = -cur_dr
                else:
                    cur_dc = -cur_dc

            if not ok or len(ray_cells) < 3:
                continue

            # Check no internal or external collisions
            new_cells = set(arrow_pts) | ray_set
            for wpxs, _ in walls:
                new_cells.update(wpxs)
            expected_count = len(arrow_pts) + len(ray_cells) + sum(len(w) for w, _ in walls)
            if len(new_cells) != expected_count or new_cells & occupied:
                continue

            # Commit
            for r, c in arrow_pts:
                grid[r, c] = out[r, c] = color
            for r, c, col in ray_cells:
                out[r, c] = col
            for wpxs, wcol in walls:
                for r, c in wpxs:
                    grid[r, c] = out[r, c] = wcol
            occupied |= new_cells
            placed = True
            break

        if not placed:
            return None

    # Oracle check: solver must reproduce planned output
    if not np.array_equal(main(grid), out):
        return None
    return grid


def generate_input() -> np.ndarray:
    """Generate a random valid input for task 142ca369."""
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 300 attempts")


from __future__ import annotations

from collections import Counter

import numpy as np

from arc_utils import crop_bbox, find_components, get_bg, paste
import random


_CROSS_MASK = np.array(
    [
        [False, True, False],
        [True, True, True],
        [False, True, False],
    ],
    dtype=bool,
)


def _marker_color(g: np.ndarray, bg: int) -> int:
    counts = Counter(int(v) for v in g[g != int(bg)])
    assert counts, "expected foreground pixels"
    max_count = max(counts.values())
    candidates = [color for color, count in counts.items() if count == max_count]
    assert len(candidates) == 1, "expected a unique repeated marker color"
    marker = int(candidates[0])
    assert counts[marker] % 4 == 0, "marker pixels should form 4-pixel sprites"
    return marker


def _block_kind(block: np.ndarray, bg: int, marker: int) -> str:
    assert block.shape == (3, 3), "expected 3x3 half-block"
    marker_mask = block == int(marker)
    other_mask = (block != int(bg)) & ~marker_mask

    if int(marker_mask.sum()) == 4 and not bool(other_mask.any()):
        return "marker"

    if not bool(marker_mask.any()) and int(other_mask.sum()) == 5:
        assert np.array_equal(other_mask, _CROSS_MASK), "expected a 5-pixel cross"
        return "cross"

    raise AssertionError("expected either a marker block or a colored cross block")


def _paste_checked(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
    h, w = patch.shape
    target = out[int(r0) : int(r0) + h, int(c0) : int(c0) + w]
    assert target.shape == patch.shape, "target patch must fit in the grid"
    assert not bool(np.any((target != int(bg)) & (patch != int(bg)))), "moved objects must not overlap"
    paste(out, patch, int(r0), int(c0), transparent=int(bg))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.

    Input structure:
    - The background is the dominant color.
    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color
      sprite attached to a 5-pixel non-marker colored cross.
    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly
      one side of the cross.

    Rule:
    - Move the whole object straight away from its marker side until the object
      bbox touches the corresponding grid edge.
    - Keep the marker sprite unchanged within the object.
    - Rotate the 3x3 colored cross block by 180 degrees before placing it.

    Key insight:
    The marker sprite is a directional tail; the cross is the leading payload,
    and only that payload turns around during the slide to the edge.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = get_bg(g)
    marker = _marker_color(g, bg)

    out = np.full_like(g, int(bg))
    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)
    assert objects, "expected at least one composite object"

    for obj in objects:
        assert int(obj["area"]) == 9, "each composite should contain 9 foreground pixels"
        r0, c0, _r1, _c1 = obj["bbox"]
        patch = crop_bbox(g, obj["bbox"])
        h, w = patch.shape
        moved = patch.copy()

        if (h, w) == (3, 6):
            left = patch[:, :3]
            right = patch[:, 3:]
            left_kind = _block_kind(left, bg, marker)
            right_kind = _block_kind(right, bg, marker)
            assert {left_kind, right_kind} == {"marker", "cross"}, "expected one marker and one cross"

            if left_kind == "marker":
                moved[:, 3:] = np.rot90(right, 2)
                target_r, target_c = int(r0), W - w
            else:
                moved[:, :3] = np.rot90(left, 2)
                target_r, target_c = int(r0), 0

        elif (h, w) == (6, 3):
            top = patch[:3, :]
            bottom = patch[3:, :]
            top_kind = _block_kind(top, bg, marker)
            bottom_kind = _block_kind(bottom, bg, marker)
            assert {top_kind, bottom_kind} == {"marker", "cross"}, "expected one marker and one cross"

            if top_kind == "marker":
                moved[3:, :] = np.rot90(bottom, 2)
                target_r, target_c = H - h, int(c0)
            else:
                moved[:3, :] = np.rot90(top, 2)
                target_r, target_c = 0, int(c0)

        else:
            raise AssertionError("each composite bbox should be 3x6 or 6x3")

        _paste_checked(out, moved, target_r, target_c, bg)

    return out

# --------------- generator (att2) ---------------

# Colors.
_GEN_BG = 8
_GEN_MARKER = 1
_GEN_CENTER = 4
_GEN_ARM_COLORS = [0, 2, 3, 5, 6, 7, 9]

# Object layout.
_GEN_SIDES = ["left", "right", "top", "bottom"]
_GEN_MARKER_COORDS = {
    "left": [(0, 0), (1, 1), (1, 2), (2, 0)],
    "right": [(0, 2), (1, 0), (1, 1), (2, 2)],
    "top": [(0, 0), (0, 2), (1, 1), (2, 1)],
    "bottom": [(0, 1), (1, 1), (2, 0), (2, 2)],
}
_GEN_ARM_POSITIONS = [(0, 1), (1, 0), (1, 2), (2, 1)]

# Canvas and placement bounds.
_GEN_OBJECT_COUNT_RANGE = (1, 4)
_GEN_MAX_SIDE = 18
_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}
_GEN_PADDING = 1
_GEN_EDGE_GAP = 2
_GEN_HORIZONTAL_SIZE = (3, 6)
_GEN_VERTICAL_SIZE = (6, 3)

# Retry limits.
_GEN_MAX_ATTEMPTS = 300


def _gen_marker_block(side: str) -> np.ndarray:
    block = np.full((3, 3), _GEN_BG, dtype=int)
    for r, c in _GEN_MARKER_COORDS[side]:
        block[r, c] = _GEN_MARKER
    return block


def _gen_cross_block() -> np.ndarray:
    block = np.full((3, 3), _GEN_BG, dtype=int)
    block[1, 1] = _GEN_CENTER
    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):
        block[r, c] = color
    return block


def _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:
    marker = _gen_marker_block(side)
    if side == "left":
        return np.concatenate([marker, cross], axis=1)
    if side == "right":
        return np.concatenate([cross, marker], axis=1)
    if side == "top":
        return np.concatenate([marker, cross], axis=0)
    return np.concatenate([cross, marker], axis=0)


def _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:
    out = patch.copy()
    if side == "left":
        out[:, 3:] = np.rot90(out[:, 3:], 2)
    elif side == "right":
        out[:, :3] = np.rot90(out[:, :3], 2)
    elif side == "top":
        out[3:, :] = np.rot90(out[3:, :], 2)
    else:
        out[:3, :] = np.rot90(out[:3, :], 2)
    return out


def _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:
    h, w = patch.shape
    H, W = canvas.shape
    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
        return False
    for dr, dc in np.argwhere(patch != _GEN_BG):
        r = int(r0 + dr)
        c = int(c0 + dc)
        r1 = max(0, r - padding)
        r2 = min(H, r + padding + 1)
        c1 = max(0, c - padding)
        c2 = min(W, c + padding + 1)
        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):
            return False
    return True


def _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:
    if side == "left":
        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]
    if side == "right":
        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]
    if side == "top":
        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]
    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]


def _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:
    if side == "left":
        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]
    if side == "right":
        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]
    if side == "top":
        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]
    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]


def _gen_canvas_shape(n_obj: int) -> tuple[int, int]:
    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]
    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)


def _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:
    H, W = expected.shape
    objects = []

    for _ in range(n_obj):
        sides = _GEN_SIDES[:]
        random.shuffle(sides)
        placed = False
        for side in sides:
            cross = _gen_cross_block()
            patch = _gen_composite(side, cross)
            positions = _gen_output_positions(side, H, W)
            random.shuffle(positions)
            for r0, c0 in positions:
                if _gen_can_place(expected, patch, r0, c0, padding=_GEN_PADDING):
                    paste(expected, patch, int(r0), int(c0), transparent=_GEN_BG)
                    objects.append((side, patch, r0, c0))
                    placed = True
                    break
            if placed:
                break
        if not placed:
            return None
    return objects


def _gen_place_input_objects(shape: tuple[int, int], objects: list[tuple[str, np.ndarray, int, int]]) -> np.ndarray | None:
    H, W = shape
    inp = np.full(shape, _GEN_BG, dtype=int)
    random.shuffle(objects)
    for side, out_patch, target_r, target_c in objects:
        in_patch = _gen_input_from_output(side, out_patch)
        positions = _gen_input_positions(side, H, W, target_r, target_c)
        random.shuffle(positions)
        placed = False
        for r0, c0 in positions:
            if _gen_can_place(inp, in_patch, r0, c0, padding=_GEN_PADDING):
                paste(inp, in_patch, int(r0), int(c0), transparent=_GEN_BG)
                placed = True
                break
        if not placed:
            return None
    return inp


def _gen_attempt() -> np.ndarray | None:
    n_obj = random.randint(*_GEN_OBJECT_COUNT_RANGE)
    H, W = _gen_canvas_shape(n_obj)

    expected = np.full((H, W), _GEN_BG, dtype=int)
    objects = _gen_place_output_objects(expected, n_obj)
    if objects is None:
        return None

    inp = _gen_place_input_objects((H, W), objects)
    if inp is None:
        return None
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 99caaf76 input")

