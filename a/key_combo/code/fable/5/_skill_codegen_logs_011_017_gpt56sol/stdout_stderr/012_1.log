+        candidate[:, 0] += 1
+        rr, cc = candidate[:, 0], candidate[:, 1]
+        blocked = bool(np.any(rr >= h))
+        if not blocked:
+            blocked = bool(np.any(occupied[rr, cc]))
+        if not blocked and virtual_barrier is not None:
