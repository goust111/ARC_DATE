+
+def _paint_patch(grid: np.ndarray, patch: np.ndarray, bottom: int, left: int, color: int) -> bool:
+    """Paint a boolean patch by its bottom row, rejecting overlap or out-of-bounds."""
+    ph, pw = patch.shape
