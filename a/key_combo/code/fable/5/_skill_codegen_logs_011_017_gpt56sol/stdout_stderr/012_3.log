# Canvas and palette bounds.
GRID_HEIGHT_BOUNDS = (9, 10)
GRID_WIDTH_BOUNDS = (9, 10)
BACKGROUND_COLOR = 7
WALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
# Object counts and pixel budgets.
COMPONENT_COUNT_BOUNDS = (2, 3)
INNER_FOREGROUND_BOUNDS = (15, 23)
SPRITE_PIXEL_BOUNDS = (1, 7)
# Sprite geometry limits.
SPRITE_HEIGHT_BOUNDS = (1, 5)
SPRITE_WIDTH_BOUNDS = (1, 3)
MIN_SPRITE_DENSITY = 0.56
# Input scatter and retry limits.
SCATTER_OFFSET_BOUNDS = (1, 5)
GENERATION_ATTEMPTS = 300

Placement = tuple[int, np.ndarray, int, int, bool]


def _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:
    values = []
    remaining = int(total)
    for i in range(int(parts)):
        slots = int(parts) - i - 1
        low = max(int(lo), remaining - int(hi) * slots)
        high = min(int(hi), remaining - int(lo) * slots)
        value = random.randint(low, high)
        values.append(value)
        remaining -= value
    random.shuffle(values)
    return values


def _gen_sprite_mask(size: int) -> np.ndarray:
    size = int(size)
    dims = [
        (h, w)
        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)
        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)
        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY
    ]
    h, w = random.choice(dims)

    coords: set[tuple[int, int]] = set()
    length = max(h, w)
    if length == 1:
        coords.add((0, 0))
    else:
        for i in range(length):
            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)
            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)
            coords.add((int(r), int(c)))

    while len(coords) < size:
        frontier = []
        for r, c in coords:
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:
                        frontier.append((nr, nc))
        coords.add(random.choice(frontier))

    mask = np.zeros((h, w), dtype=bool)
    for r, c in coords:
        mask[r, c] = True
    if random.choice([False, True]):
        mask = np.flipud(mask)
    if random.choice([False, True]):
        mask = np.fliplr(mask)
    return mask.copy()


def _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:
    return np.argwhere(mask) + np.array([int(r0), int(c0)])


def _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:
    grid = np.full(shape, int(bg), dtype=int)
    grid[:, 0] = int(left_color)
    grid[:, shape[1] - 1] = int(right_color)
    return grid


def _gen_place_output_side(
    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int
) -> list[Placement]:
    h, w = out.shape
    placements = []
    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):
        mh, mw = mask.shape
        c0 = 1 if left_side else w - 1 - mw
        rows = list(range(0, h - mh + 1))
        random.shuffle(rows)
        for r0 in rows:
            coords = _gen_mask_coords(mask, r0, c0)
            if np.any(out[coords[:, 0], coords[:, 1]] != bg):
                continue
            patch = np.where(mask, int(color), int(bg))
            paste(out, patch, r0, c0, transparent=bg)
            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))
            break
        else:
            return []
    return placements


def _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:
    for other in existing:
        dr = np.abs(coords[:, None, 0] - other[None, :, 0])
        dc = np.abs(coords[:, None, 1] - other[None, :, 1])
        if bool(np.any((dr <= 1) & (dc <= 1))):
            return True
    return False


def _gen_scatter_input(
    shape: tuple[int, int], bg: int, left_color: int, right_color: int, placements: list[Placement]
) -> np.ndarray | None:
    h, w = shape
    inp = _gen_base_grid((h, w), bg, left_color, right_color)
    by_color: dict[int, list[np.ndarray]] = {int(left_color): [], int(right_color): []}

    shuffled = list(placements)
    random.shuffle(shuffled)
    for color, mask, r0, c_out, left_side in shuffled:
        mh, mw = mask.shape
        max_offset = (w - 2 - (c_out + mw - 1)) if left_side else (c_out - 1)
        offsets = list(range(SCATTER_OFFSET_BOUNDS[0], min(SCATTER_OFFSET_BOUNDS[1], int(max_offset)) + 1))
        random.shuffle(offsets)
        for offset in offsets:
            c_in = c_out + offset if left_side else c_out - offset
            coords = _gen_mask_coords(mask, r0, c_in)
            if np.any(inp[coords[:, 0], coords[:, 1]] != bg):
                continue
            if _gen_touches_existing(coords, by_color[int(color)]):
                continue
            patch = np.where(mask, int(color), int(bg))
            paste(inp, patch, r0, c_in, transparent=bg)
            by_color[int(color)].append(coords)
            break
        else:
            return None
    return inp


def _gen_output_layout(
    shape: tuple[int, int], bg: int, left_color: int, right_color: int,
    left_masks: list[np.ndarray], right_masks: list[np.ndarray],
) -> tuple[np.ndarray, list[Placement]] | None:
    out = _gen_base_grid(shape, bg, left_color, right_color)
    left_placements = _gen_place_output_side(out, left_color, left_masks, left_side=True, bg=bg)
    if len(left_placements) != len(left_masks):
        return None
    right_placements = _gen_place_output_side(out, right_color, right_masks, left_side=False, bg=bg)
    if len(right_placements) != len(right_masks):
        return None
    return out, left_placements + right_placements


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(*GRID_HEIGHT_BOUNDS)
    w = random.randint(*GRID_WIDTH_BOUNDS)
    bg = BACKGROUND_COLOR
    left_color, right_color = random.sample(WALL_COLORS, 2)

    left_count = random.randint(*COMPONENT_COUNT_BOUNDS)
    right_count = random.randint(*COMPONENT_COUNT_BOUNDS)
    total_inner = random.randint(*INNER_FOREGROUND_BOUNDS)
    sizes = _gen_bounded_composition(total_inner, left_count + right_count, *SPRITE_PIXEL_BOUNDS)
    left_masks = [_gen_sprite_mask(size) for size in sizes[:left_count]]
    right_masks = [_gen_sprite_mask(size) for size in sizes[left_count:]]

    layout = _gen_output_layout((h, w), bg, left_color, right_color, left_masks, right_masks)
    if layout is None:
        return None
    out, placements = layout

    inp = _gen_scatter_input((h, w), bg, left_color, right_color, placements)
    if inp is None:
        return None
    try:
        solved = main(inp)
    except AssertionError:
        return None
    if np.array_equal(solved, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid f0100645 input")
from __future__ import annotations

from collections import deque

import numpy as np

from arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location
import random


def _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    b = bbox(mask)
    if b is None:
        return None
    r0, c0, r1, c1 = b
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    if h < 3 or w < 3:
        return None

    expected = np.zeros_like(mask, dtype=bool)
    expected[r0 : r1 + 1, c0] = True
    expected[r0 : r1 + 1, c1] = True
    expected[r0, c0 : c1 + 1] = True
    expected[r1, c0 : c1 + 1] = True
    if not np.array_equal(mask, expected):
        return None
    return int(r0), int(c0), int(r1), int(c1)


def _scaled_index(i: int, src_len: int, dst_len: int) -> int:
    assert src_len >= 1 and dst_len >= 1, "axis lengths must be positive"
    if src_len == 1:
        assert dst_len == 1, "a one-pixel motif axis maps to a one-pixel interior axis"
        return 0
    assert dst_len >= 2, "multi-pixel motif axis needs a multi-pixel interior axis"
    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))


def _fill_enclosed(stroke: np.ndarray) -> np.ndarray:
    h, w = stroke.shape
    open_space = ~stroke.astype(bool)
    padded = np.pad(open_space, 1, constant_values=True)
    seen = np.zeros_like(padded, dtype=bool)
    q: deque[tuple[int, int]] = deque()
    ph, pw = padded.shape

    for r in range(ph):
        for c in (0, pw - 1):
            if padded[r, c] and not seen[r, c]:
                seen[r, c] = True
                q.append((int(r), int(c)))
    for c in range(pw):
        for r in (0, ph - 1):
            if padded[r, c] and not seen[r, c]:
                seen[r, c] = True
                q.append((int(r), int(c)))

    while q:
        r, c = q.popleft()
        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True
                q.append((int(nr), int(nc)))

    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]
    return stroke.astype(bool) | holes


def _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:
    src_h, src_w = sprite.shape
    dst_h, dst_w = target_shape
    assert sprite.any(), "expected a nonempty sprite"

    stroke = np.zeros((dst_h, dst_w), dtype=int)
    coords = np.argwhere(sprite)
    mapped: dict[tuple[int, int], tuple[int, int]] = {}
    for sr, sc in coords:
        tr = _scaled_index(int(sr), src_h, dst_h)
        tc = _scaled_index(int(sc), src_w, dst_w)
        mapped[(int(sr), int(sc))] = (tr, tc)
        stroke[tr, tc] = 1

    for sr, sc in coords:
        sr = int(sr)
        sc = int(sc)
        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):
            if (nr, nc) in mapped:
                r0, c0 = mapped[(sr, sc)]
                r1, c1 = mapped[(nr, nc)]
                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)

    return _fill_enclosed(stroke.astype(bool))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.

    Input structure:
    - The background is the dominant color.
    - There are exactly two foreground colors: one forms a complete rectangular
      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.
    - The frame interior is initially background.

    Rule:
    - Clear the original sprite from its outside location.
    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to
      interior extremes.
    - Draw straight horizontal or vertical segments between mapped positions of
      adjacent sprite pixels, then fill any enclosed background region inside
      those drawn segments.

    Key insight:
    The outside sprite is a miniature line/fill diagram for the frame interior,
    not a bitmap to scale by block replication.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected one frame color and one sprite color"

    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []
    for color in colors:
        frame_bbox = _rect_frame_bbox(g == int(color))
        if frame_bbox is not None:
            frame_candidates.append((int(color), frame_bbox))
    assert len(frame_candidates) == 1, "expected a unique rectangular frame"

    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]
    sprite_color = next(color for color in colors if color != frame_color)
    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)
    assert len(sprite_components) == 1, "expected a single 4-connected sprite"
    frame_region = np.zeros_like(g, dtype=bool)
    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
    assert not np.any((g == sprite_color) & frame_region), "sprite must start outside the frame"

    sr0, sc0, sr1, sc1 = sprite_components[0]["bbox"]
    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color

    ir0, ic0 = fr0 + 1, fc0 + 1
    ir1, ic1 = fr1 - 1, fc1 - 1
    assert ir0 <= ir1 and ic0 <= ic1, "frame must have an interior"
    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]
    assert np.all(interior == bg), "frame interior must start empty"

    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))
    out = g.copy()
    out[g == sprite_color] = bg
    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color
    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and observed fixed colors.
_GRID_SHAPE = (10, 10)
_COLOR_COUNT = 10
_BG = 7
_FRAME_COLOR = 6

# Frame size bounds and retry budget.
_FRAME_SIZE_MIN = 3
_FRAME_SIZE_MAX = 8
_SINGLE_PIXEL_FRAME_SIZE = 3
_MAX_GENERATION_ATTEMPTS = 300

# Sprite color pool and source masks.
_SPRITE_COLORS = tuple(c for c in range(_COLOR_COUNT) if c not in {_BG, _FRAME_COLOR})
_SPRITE_SINGLE = np.ones((1, 1), dtype=bool)
_SPRITE_PATTERNS_2X2 = [
    np.array([[1, 1], [1, 0]], dtype=bool),
    np.array([[1, 1], [0, 1]], dtype=bool),
    np.array([[1, 0], [1, 1]], dtype=bool),
    np.array([[0, 1], [1, 1]], dtype=bool),
    np.array([[1, 1], [1, 1]], dtype=bool),
]

def _outside_locations(
    frame_bbox: tuple[int, int, int, int], patch_shape: tuple[int, int]
) -> list[tuple[int, int]]:
    fr0, fc0, fr1, fc1 = frame_bbox
    ph, pw = patch_shape
    locations: list[tuple[int, int]] = []
    for r in range(_GRID_SHAPE[0] - ph + 1):
        for c in range(_GRID_SHAPE[1] - pw + 1):
            pr0, pc0, pr1, pc1 = r, c, r + ph - 1, c + pw - 1
            separated = pr1 < fr0 or pr0 > fr1 or pc1 < fc0 or pc0 > fc1
            if separated:
                locations.append((r, c))
    return locations

def _frame_positions(size: int, patch_shape: tuple[int, int]) -> list[tuple[int, int]]:
    positions: list[tuple[int, int]] = []
    for r in range(_GRID_SHAPE[0] - size + 1):
        for c in range(_GRID_SHAPE[1] - size + 1):
            frame_bbox = (r, c, r + size - 1, c + size - 1)
            if _outside_locations(frame_bbox, patch_shape):
                positions.append((r, c))
    return positions

def _draw_frame(grid: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:
    r1, c1 = r0 + size - 1, c0 + size - 1
    grid[r0 : r1 + 1, c0] = color
    grid[r0 : r1 + 1, c1] = color
    grid[r0, c0 : c1 + 1] = color
    grid[r1, c0 : c1 + 1] = color

def _sample_sprite(size: int) -> np.ndarray:
    return _SPRITE_SINGLE.copy() if size == _SINGLE_PIXEL_FRAME_SIZE else random.choice(_SPRITE_PATTERNS_2X2).copy()

def _sample_case() -> tuple[int, int, np.ndarray]:
    sprite_color = random.choice(_SPRITE_COLORS)
    size = random.randint(_FRAME_SIZE_MIN, _FRAME_SIZE_MAX)
    return sprite_color, size, _sample_sprite(size)

def _build_candidate_grids(
    frame_bbox: tuple[int, int, int, int], sprite: np.ndarray, sprite_color: int
) -> tuple[np.ndarray, np.ndarray] | None:
    fr0, fc0, fr1, fc1 = frame_bbox
    stretched = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))
    if not np.any(stretched):
        return None

    out = np.full(_GRID_SHAPE, _BG, dtype=int)
    _draw_frame(out, fr0, fc0, fr1 - fr0 + 1, _FRAME_COLOR)
    out[fr0 + 1 : fr1, fc0 + 1 : fc1][stretched] = sprite_color

    inp = out.copy()
    inp[fr0 + 1 : fr1, fc0 + 1 : fc1] = _BG

    locations = _outside_locations(frame_bbox, sprite.shape)
    if not locations:
        return None
    sr, sc = random.choice(locations)
    patch = np.where(sprite, sprite_color, _BG)
    paste(inp, patch, sr, sc, transparent=_BG)
    return inp, out

def _gen_attempt() -> np.ndarray | None:
    sprite_color, size, sprite = _sample_case()

    frame_positions = _frame_positions(size, sprite.shape)
    if not frame_positions:
        return None
    fr0, fc0 = random.choice(frame_positions)
    frame_bbox = (fr0, fc0, fr0 + size - 1, fc0 + size - 1)

    candidate = _build_candidate_grids(frame_bbox, sprite, sprite_color)
    if candidate is None:
        return None
    inp, out = candidate

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None

def generate_input() -> np.ndarray:
    for _ in range(_MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 465b7d93 input")

