+    expected = _metadata_oracle(
+        grid,
+        meta["sprite_coords"],
+        meta["sprite_color"],
+        meta["marker_coords"],
+        meta["orientation"],
+        meta["axes"],
+        meta["near_index"],
+    )
+    only_one = _metadata_oracle(
