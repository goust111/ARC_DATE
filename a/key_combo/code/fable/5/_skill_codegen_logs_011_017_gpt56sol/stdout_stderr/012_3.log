+def _reflected(coords: np.ndarray, orientation: str, axis: int) -> np.ndarray:
+    copied = coords.copy()
+    dim = 1 if orientation == "vertical" else 0
+    copied[:, dim] = 2 * int(axis) - copied[:, dim]
+    return copied
