+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+        return None
+    if len(_components(mask)) != 1 or not _is_asymmetric(mask):
+        return None
+    return mask
