+    only_two = _metadata_oracle(
+        grid,
+        meta["sprite_coords"],
+        meta["sprite_color"],
+        meta["marker_coords"],
+        meta["orientation"],
+        meta["axes"],
+        meta["near_index"],
+        limit=2,
+    )
+    far_first = _metadata_oracle(
