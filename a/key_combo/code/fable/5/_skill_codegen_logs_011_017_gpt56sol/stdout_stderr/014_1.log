+    result: list[np.ndarray] = []
+    while unseen:
+        start = unseen.pop()
+        queue = deque([start])
+        cells = [start]
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) in unseen:
+                    unseen.remove((nr, nc))
