+    return (h, w), (bottom_r, bottom_c), (top_r, top_c)
+
+
+def _dilate(mask: np.ndarray) -> np.ndarray:
+    padded = np.pad(mask, 1, constant_values=False)
+    out = np.zeros_like(mask)
+    for dr in range(3):
