+    cols = np.arange(c1 - c0 - 1)[None, :]
+    depth = np.minimum(np.minimum(rows, rows[::-1]), np.minimum(cols, cols[:, ::-1]))
+    phase = depth % cycle
+    interior = np.empty(depth.shape, dtype=int)
+    start = 0
+    for color, end in zip(keys, ends):
