+    th, tw = target_shape
+    lh, lw = legend_shape
+    gap = 3
+    horizontal_min = tw + lw + gap + 2
+    vertical_min = th + lh + gap + 2
+    orientations = []
+    if horizontal_min <= 30:
+        orientations.append(True)
+    if vertical_min <= 30:
