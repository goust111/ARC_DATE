+def _rectangle_perimeter(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = mask[-1, :] = True
+    mask[:, 0] = mask[:, -1] = True
+    return mask
