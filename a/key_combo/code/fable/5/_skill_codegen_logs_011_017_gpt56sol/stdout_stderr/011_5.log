+def _draw_track(canvas: np.ndarray, a: Coord, b: Coord, color: int) -> list[Coord]:
+    """Draw a straight center-to-center segment between aligned node bboxes."""
+    n = _NODE_SIZE
+    ra, ca = a
+    rb, cb = b
+    pixels: list[Coord] = []
+    if ra == rb:
+        row = ra + n // 2
