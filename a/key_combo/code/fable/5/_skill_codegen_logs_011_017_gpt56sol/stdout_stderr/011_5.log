+        a, b = sorted(touched)
+        key = frozenset((a, b))
+        assert key not in edge_pixels, "parallel edge segments would make path selection ambiguous"
+        edge_pixels[key] = pixels
+        adjacency_sets[a].add(b)
+        adjacency_sets[b].add(a)
