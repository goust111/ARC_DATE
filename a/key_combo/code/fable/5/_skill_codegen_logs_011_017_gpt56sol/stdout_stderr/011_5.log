+    def visit(node: int, path: list[int], used: set[int]) -> None:
+        if len(paths) > limit:
+            return
+        if node == goal:
+            paths.append(path.copy())
+            return
+        for nxt in adjacency.get(node, []):
+            if nxt not in used:
+                used.add(nxt)
+                path.append(nxt)
+                visit(nxt, path, used)
+                path.pop()
+                used.remove(nxt)
