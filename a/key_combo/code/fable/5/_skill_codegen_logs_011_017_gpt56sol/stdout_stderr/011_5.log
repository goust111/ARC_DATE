+        touched: set[int] = set()
+        pixels: list[Coord] = []
+        for r, c in coords:
+            r, c = int(r), int(c)
+            pixels.append((r, c))
+            for rr, cc in _neighbors4(r, c):
+                node_id = pixel_to_node.get((rr, cc))
+                if node_id is not None:
