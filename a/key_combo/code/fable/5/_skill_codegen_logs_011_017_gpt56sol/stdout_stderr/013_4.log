+
+# Cardinal directions use the shared ARC convention: coordinates are (row, col).
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRECTIONS = (UP, DOWN, LEFT, RIGHT)
+OPPOSITE = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}
+
+MIN_SIDE = 20
+MAX_SIDE = 30
+MIN_CHAIN = 3
+MAX_CHAIN = 4
