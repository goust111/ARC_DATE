+def _cells_for(tip: tuple[int, int], direction: tuple[int, int]) -> frozenset[tuple[int, int]]:
+    tr, tc = tip
+    return frozenset((tr + dr, tc + dc) for dr, dc in ARROW_TEMPLATES[direction])
+
