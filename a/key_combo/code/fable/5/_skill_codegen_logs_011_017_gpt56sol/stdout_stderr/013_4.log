            if any(r < 0 or r >= height or c < 0 or c >= width for r, c in moved):
                continue
            if moved & target:
                continue
            if any(int(g[r, c]) != int(bg) for r, c in moved):
                continue

            union = moved | target
            rows = [r for r, _c in union]
            cols = [c for _r, c in union]
            rect_area = (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)
            if len(union) == rect_area:
                offsets.append((dr, dc))

    return offsets


def _completion_candidate(
    g: np.ndarray,
    bg: int,
) -> tuple[int, frozenset[tuple[int, int]], int, int]:
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    by_color: dict[int, list[dict]] = defaultdict(list)
    for component in components:
        by_color[int(component["color"])].append(component)

    candidates: list[tuple[int, frozenset[tuple[int, int]], int, int]] = []
    for color, parts in by_color.items():
        if len(parts) != 2:
            continue

        left_edge = [part for part in parts if int(part["bbox"][1]) == 0]
        anchors = [part for part in parts if int(part["bbox"][1]) != 0]
        if len(left_edge) != 1 or len(anchors) != 1:
            continue

        source = _cells(left_edge[0]["coords"])
        target = _cells(anchors[0]["coords"])
        for dr, dc in _solid_completion_offsets(g, source, target, bg):
            candidates.append((int(color), source, dr, dc))

    assert len(candidates) == 1, "expected one left-edge object that completes a same-color rectangle"
    return candidates[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the left-edge fragment into its same-colored anchor fragment to complete a solid rectangle.

    Input structure
    - The grid has a dominant background color.
    - Exactly one foreground color is split into two 4-connected objects: one
      touches the left edge, and the other is an anchor away from the left edge.
    - The translated left-edge object and the anchor can form one filled rectangle.
    Rule
    - Find the unique split color whose left-edge object can be translated onto
      background cells beside the other same-colored object so their union is a
      solid axis-aligned rectangle.
    - Clear the left-edge object's original cells to the background.
    - Paint that object at the unique completing offset, preserving all other cells.
    Key insight
    - The active color is identified by object structure and rectangle completion,
      not by a fixed color id; the same-colored anchor object stays in place.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    color, source, dr, dc = _completion_candidate(g, bg)

    out = g.copy()
    for r, c in source:
        out[r, c] = int(bg)
    for r, c in source:
        rr, cc = r + dr, c + dc
        assert int(out[rr, cc]) == int(bg), "translated source must land on background cells"
        out[rr, cc] = int(color)

    return out

# --------------- generator (o5x) ---------------

# Canvas and object size bounds.
GRID_SIZE_RANGE = (8, 16)
OBJECT_HEIGHT_RANGE = (3, 5)
RECT_WIDTH_RANGE = (4, 7)
LEFT_PATCH_CANVAS_PAD = 3

# Layout and shape constraints.
ROW_GAP_MIN = 1
MIN_ROW_WIDTH = 1
SOURCE_RIGHT_PAD = 2
DST_WIDTH_RESERVED_COLS = 1

# Sampling controls.
PALETTE_COLORS = tuple(range(10))
NONSPLIT_ABOVE_CHOICES = (True, False)
MAX_GENERATION_ATTEMPTS = 300


def _gen_symmetric_widths(height: int, width: int, *, min_width: int = MIN_ROW_WIDTH,
                          varied: bool = False, include_max: bool = False) -> list[int]:
    """Sample row widths and mirror them vertically."""
    half = (height + 1) // 2
    vals = [random.randint(min_width, width) for _ in range(half)]
    if include_max:
        vals[random.randrange(half)] = width
    if varied and width > min_width and len(set(vals + vals[: height // 2][::-1])) == 1:
        j = random.randrange(half)
        vals[j] = min(width, vals[j] + 1) if vals[j] < width else vals[j] - 1
    return vals + vals[: height // 2][::-1]


def _right_anchored_mask(widths: list[int], patch_width: int) -> np.ndarray:
    """Return a mask whose true cells fill each row from the right edge."""
    row_widths = np.asarray(widths, dtype=int)[:, None]
    cols = np.arange(patch_width)[None, :]
    return cols >= patch_width - row_widths


def _gen_right_shape_with_max_width(height: int, patch_width: int, max_row_width: int,
                                    color: int, bg: int) -> np.ndarray:
    patch = np.full((height, patch_width), bg, dtype=int)
    widths = _gen_symmetric_widths(height, max_row_width, varied=True, include_max=True)
    patch[_right_anchored_mask(widths, patch_width)] = color
    return patch


def _gen_pick_layout(n: int) -> tuple[int, int, int, int, int] | None:
    h_min, h_max = OBJECT_HEIGHT_RANGE
    pairs = [
        (rh, nh)
        for rh in range(h_min, h_max + 1)
        for nh in range(h_min, h_max + 1)
        if rh + nh + ROW_GAP_MIN <= n
    ]
    if not pairs:
        return None
    rect_h, nonsplit_h = random.choice(pairs)
    min_w, max_w = RECT_WIDTH_RANGE[0], min(RECT_WIDTH_RANGE[1], n - LEFT_PATCH_CANVAS_PAD)
    if max_w < min_w:
        return None
    rect_w = random.randint(min_w, max_w)

    place_nonsplit_above = random.choice(NONSPLIT_ABOVE_CHOICES)
    if place_nonsplit_above:
        max_rect_top = n - rect_h
        min_rect_top = nonsplit_h + ROW_GAP_MIN
        if min_rect_top > max_rect_top:
            return None
        rect_top = random.randint(min_rect_top, max_rect_top)
        nonsplit_top = random.randint(0, rect_top - nonsplit_h - ROW_GAP_MIN)
    else:
        max_rect_top = n - rect_h - nonsplit_h - ROW_GAP_MIN
        if max_rect_top < 0:
            return None
        rect_top = random.randint(0, max_rect_top)
        nonsplit_top = random.randint(rect_top + rect_h + ROW_GAP_MIN, n - nonsplit_h)
    return rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top


def _gen_split_patches(rect_h: int, rect_w: int, min_dst_width: int,
                       split_color: int, bg: int) -> tuple[np.ndarray, np.ndarray, list[int]]:
    dst_widths = _gen_symmetric_widths(rect_h, rect_w - 1, min_width=min_dst_width, varied=True)
    dst = np.full((rect_h, rect_w), bg, dtype=int)
    src = np.full((rect_h, rect_w), bg, dtype=int)
    dst_mask = _right_anchored_mask(dst_widths, rect_w)
    dst[dst_mask] = split_color
    src[~dst_mask] = split_color
    return dst, src, dst_widths


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(*GRID_SIZE_RANGE)
    layout = _gen_pick_layout(n)
    if layout is None:
        return None
    rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top = layout

    colors = list(PALETTE_COLORS)
    bg = random.choice(colors)
    colors.remove(bg)
    split_color, nonsplit_color = random.sample(colors, 2)
    min_dst_width = max(MIN_ROW_WIDTH, 2 * rect_w - n + SOURCE_RIGHT_PAD)
    if min_dst_width > rect_w - DST_WIDTH_RESERVED_COLS:
        return None

    dst, src, dst_widths = _gen_split_patches(rect_h, rect_w, min_dst_width, split_color, bg)
    nonsplit = _gen_right_shape_with_max_width(
        nonsplit_h,
        rect_w,
        max(dst_widths),
        nonsplit_color,
        bg,
    )
    split_area = rect_h * rect_w
    nonsplit_area = int(np.count_nonzero(nonsplit == nonsplit_color))
    bg_area = n * n - split_area - nonsplit_area
    if bg_area <= max(split_area, nonsplit_area):
        return None

    rect_left = n - rect_w
    out = np.full((n, n), bg, dtype=int)
    out[rect_top : rect_top + rect_h, rect_left:n] = split_color
    out[nonsplit_top : nonsplit_top + nonsplit_h, rect_left:n] = nonsplit

    inp = out.copy()
    inp[rect_top : rect_top + rect_h, rect_left:n] = bg
    inp[rect_top : rect_top + rect_h, rect_left:n] = dst
    # Opaque paste of src preserves the original small-canvas overlap behavior.
    inp[rect_top : rect_top + rect_h, 0:rect_w] = src

    try:
        produced = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(produced, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid fe45cba4 input")
import numpy as np

from arc_utils import components_mask, paste
import random


def _components4(mask):
    return components_mask(mask, connectivity=4)


def _find_separator_col(g: np.ndarray, sep_color: int = 5) -> int:
    _, w = g.shape
    cols = [c for c in range(w) if np.all(g[:, c] == sep_color)]
    assert len(cols) == 1, f"expected a unique full separator column, got {cols}"
    return int(cols[0])


def _background_color(g: np.ndarray, sep_col: int, sep_color: int = 5) -> int:
    h, w = g.shape
    border = []
    for c in range(w):
        if c != sep_col and g[0, c] != sep_color:
            border.append(int(g[0, c]))
        if c != sep_col and g[h - 1, c] != sep_color:
            border.append(int(g[h - 1, c]))
    for r in range(h):
        if g[r, 0] != sep_color:
            border.append(int(g[r, 0]))
        if g[r, w - 1] != sep_color:
            border.append(int(g[r, w - 1]))
    assert border, "expected non-separator border pixels to infer the background"
    vals, counts = np.unique(np.array(border, dtype=int), return_counts=True)
    winners = vals[counts == counts.max()]
    assert len(winners) == 1, f"background color must be unique on the border, got {winners.tolist()}"
    return int(winners[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.

    Input structure:
    - A vertical grey (5) separator column divides the grid into left and right halves.
    - Black shapes sit on the left side against a background color (bg).

    Rule:
    - Translate each black connected component rightward until its right edge is flush with the separator.
    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.
    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.

    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as "nozzles" projecting rightward.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    sep_color = 5
    black = 0
    red = 2

    sep = _find_separator_col(g, sep_color=sep_color)
    bg = _background_color(g, sep_col=sep, sep_color=sep_color)

    out = g.copy()

    # Step 1: move black components on the left so that their right edge touches the separator.
    left = out[:, :sep].copy()
    left_mask = left == black
    comps = _components4(left_mask)

    # Clear old black pixels (leave other colors intact).
    left[left == black] = bg

    target_right = sep - 1  # last column in left side, adjacent to separator
    for comp in comps:
        max_c = max(c for _, c in comp)
        delta = target_right - max_c
        assert delta >= 0, "left-side components must stay left of the separator"
        for r, c in comp:
            nc = c + delta
            assert 0 <= nc < sep, f"shifted pixel {(r, c)} left the pane"
            left[r, nc] = black

    out[:, :sep] = left

    # Step 2: find enclosed background regions (holes) on the left.
    # A hole is a bg component not touching the left subgrid boundary.
    holes = []
    for pts in _components4(left == bg):
        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):
            continue
        holes.append(pts)

    # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),
    # emit a red ray on the right side for each row containing hole pixels.
    trigger_col = sep - 2
    trigger_rows = []
    for pts in holes:
        if not any(c == trigger_col for _, c in pts):
            continue
        trigger_rows.extend(sorted(set(r for r, _ in pts)))
    assert len(trigger_rows) == len(set(trigger_rows)), f"trigger rows must be unique, got {trigger_rows}"
    for r in trigger_rows:
        assert np.all(out[r, sep + 1 :] == bg), f"right half of row {r} must be background before ray emission"
        out[r, sep + 1 :] = red

    return out

# --------------- generator (att4) ---------------

# ── Colors ──
BG = 6       # magenta background
BLACK = 0    # sprite color
RED = 2      # ray color
SEP_COLOR = 5  # grey separator

# ── Grid dimensions ──
H_MIN, H_MAX = 16, 25
W_MIN, W_MAX = 10, 16
SEP_MIN, SEP_MAX = 5, 11       # separator column range
RIGHT_W_MIN, RIGHT_W_MAX = 2, 4  # right-side width range

# ── Sprite constraints ──
N_SPRITES_MIN, N_SPRITES_MAX = 2, 5
SPRITE_H_MAX = 8               # max sprite bbox height
SPRITE_W_MAX = 6               # max sprite bbox width
MIN_BAND_GAP = 1               # min bg rows between sprite bands

# ── Probabilities ──
SPLIT_PROB = 0.4                # emitter: probability of split (mini+main) layout
EXTRA_EMITTERS_PROB = 0.25      # chance to add more emitters beyond the minimum
FLUSH_PROB = 0.35               # chance one input sprite stays flush with separator

# ── Retry budget ──
MAX_RETRIES = 300


def _scatter(total, slots):
    """Distribute *total* units randomly into *slots* bins."""
    vals = [0] * slots
    for _ in range(total):
        vals[random.randrange(slots)] += 1
    return vals


def _min_emitters_for(n):
    """Minimum emitter count to satisfy >=60% emitter fraction for *n* sprites."""
    return (3 * n + 4) // 5


def _min_rows_needed(n_emitters, n_total):
    """Minimum grid rows to fit *n_total* sprites with *n_emitters* emitters."""
    return n_emitters * 3 + (n_total - n_emitters) * 2 + (n_total - 1) + 2


def _sprite_bands(h, is_emitter):
    """Partition grid rows into disjoint vertical bands for each sprite.

    Returns list of (row_start, height) or None if they don't fit.
    """
    n = len(is_emitter)
    min_heights = [3 if e else 2 for e in is_emitter]
    base_gaps = [MIN_BAND_GAP] * (n + 1)
    height_cap = h - sum(base_gaps)
    if sum(min_heights) > height_cap:
        return None

    heights = min_heights[:]
    extra_cap = sum(SPRITE_H_MAX - x for x in heights)
    extra = random.randint(0, min(extra_cap, height_cap - sum(heights)))
    for _ in range(extra):
        choices = [i for i, x in enumerate(heights) if x < SPRITE_H_MAX]
        i = random.choice(choices)
        heights[i] += 1

    gaps = [a + b for a, b in zip(base_gaps, _scatter(h - sum(heights) - sum(base_gaps), n + 1))]
    bands = []
    r = gaps[0]
    for i, sh in enumerate(heights):
        bands.append((r, sh))
        r += sh + gaps[i + 1]
    return bands


def _emitter_patch(sh, max_sw):
    """Build an emitter sprite patch: a closed shell with an interior hole at the right edge."""
    hole_w = random.choice([1, 2]) if max_sw >= 4 else 1
    sw = random.randint(hole_w + 2, max_sw)
    patch = np.full((sh, sw), BG, dtype=int)

    right_wall = sw - 1
    left_wall = sw - hole_w - 2

    # Optionally split into a narrower mini section + main section,
    # creating a non-triggering hole in the mini part.
    right_shift = random.randint(1, max(1, sw - 3))
    mini_w = sw - right_shift
    can_split = sh >= 5 and mini_w >= 3 and right_shift >= 1
    if can_split and random.random() < SPLIT_PROB:
        _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w)
    else:
        patch[0, :] = BLACK
        patch[-1, :] = BLACK
        patch[1:-1, left_wall] = BLACK
        patch[1:-1, right_wall] = BLACK
    return patch


def _build_split_emitter(patch, sh, sw, left_wall, right_wall, mini_w):
    """Fill *patch* in-place with a split emitter (mini section + main section)."""
    place_top = random.random() < 0.5
    mini_h = random.randint(3, min(4, sh - 2))
    main_h = sh - mini_h + 1  # +1 for shared connection row
    if place_top:
        # Top = mini (narrower), bottom = main (full width)
        patch[0, :mini_w] = BLACK
        for r in range(mini_h):
            patch[r, 0] = BLACK
            patch[r, mini_w - 1] = BLACK
        patch[mini_h - 1, :] = BLACK  # connection row
        patch[-1, :] = BLACK
        for r in range(mini_h, sh):
            patch[r, left_wall] = BLACK
            patch[r, right_wall] = BLACK
    else:
        # Top = main (full width), bottom = mini (narrower)
        patch[0, :] = BLACK
        for r in range(main_h - 1):
            patch[r, left_wall] = BLACK
            patch[r, right_wall] = BLACK
        patch[main_h - 1, :] = BLACK  # connection row
        patch[-1, :mini_w] = BLACK
        for r in range(main_h, sh):
            patch[r, 0] = BLACK
            patch[r, mini_w - 1] = BLACK


def _distractor_patch(sh, max_sw):
    """Build a non-emitter distractor sprite (C-shape, L-shape, or solid block)."""
    choices = ["l_shape"]
    if sh >= 3 and max_sw >= 3:
        choices.extend(["c_left", "c_right"])
    if sh <= 3:
        choices.append("solid")
    kind = random.choice(choices)

    if kind == "solid":
        sw = random.randint(2, min(3, max_sw))
        return np.full((sh, sw), BLACK, dtype=int)

    min_sw = 3 if kind.startswith("c_") or sh == 2 else 2
    sw = random.randint(min_sw, max_sw)
    patch = np.full((sh, sw), BG, dtype=int)
    if kind == "c_left":
        patch[0, :] = BLACK
        patch[-1, :] = BLACK
        patch[:, -1] = BLACK
    elif kind == "c_right":
        patch[0, :] = BLACK
        patch[-1, :] = BLACK
        patch[:, 0] = BLACK
    else:
        patch[:, -1] = BLACK
        if random.random() < 0.5:
            patch[0, :] = BLACK
        else:
            patch[-1, :] = BLACK
    return patch


def _choose_grid_dims():
    """Pick grid height, width, and separator column satisfying all constraints."""
    h = random.randint(H_MIN, H_MAX)
    right_w = random.randint(RIGHT_W_MIN, RIGHT_W_MAX)
    valid_seps = [s for s in range(SEP_MIN, SEP_MAX + 1) if W_MIN <= s + 1 + right_w <= W_MAX]
    sep = random.choice(valid_seps)
    w = sep + 1 + right_w
    return h, w, sep


def _choose_emitter_flags(h):
    """Decide sprite count and which sprites are emitters. Returns flags list or None."""
    valid_counts = [n for n in range(N_SPRITES_MIN, N_SPRITES_MAX + 1)
                    if _min_rows_needed(_min_emitters_for(n), n) <= h]
    n = random.choice(valid_counts)

    min_em = _min_emitters_for(n)
    max_em = min_em
    for k in range(min_em + 1, n + 1):
        if _min_rows_needed(k, n) <= h:
            max_em = k
    if max_em > min_em and random.random() < EXTRA_EMITTERS_PROB:
        n_emitters = random.randint(min_em + 1, max_em)
    else:
        n_emitters = min_em

    flags = [True] * n_emitters + [False] * (n - n_emitters)
    random.shuffle(flags)
    return flags


def _render_output(h, w, sep, bands, flags):
    """Stamp sprites flush against the separator and paint red rays for emitters.

    Returns (output_grid, sprite_list) where sprite_list is [(patch, r0, c0), ...].
    """
    out = np.full((h, w), BG, dtype=int)
    out[:, sep] = SEP_COLOR

    sprites = []
    max_sw = min(SPRITE_W_MAX, sep - 1)
    for (r0, sh), is_emitter in zip(bands, flags):
        patch = _emitter_patch(sh, max_sw) if is_emitter else _distractor_patch(sh, max_sw)
        sw = patch.shape[1]
        c0 = sep - sw
        paste(out, patch, r0, c0, transparent=BG)
        if is_emitter:
            for lr in range(sh):
                if patch[lr, -1] == BLACK and patch[lr, -2] == BG:
                    out[r0 + lr, sep + 1:] = RED
        sprites.append((patch, r0, c0))
    return out, sprites


def _unslide_sprites(h, w, sep, sprites):
    """Shift each sprite leftward by a random amount to produce the input grid.

    Returns the input grid or None if any sprite can't be shifted.
    """
    n = len(sprites)
    inp = np.full((h, w), BG, dtype=int)
    inp[:, sep] = SEP_COLOR

    flush_i = random.randrange(n) if random.random() < FLUSH_PROB else -1
    for i, (patch, r0, c0) in enumerate(sprites):
        if c0 < 1:
            return None
        delta = 0 if i == flush_i else random.randint(1, c0)
        paste(inp, patch, r0, c0 - delta, transparent=BG)
    return inp


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, derive input, verify with oracle."""
    h, w, sep = _choose_grid_dims()
    flags = _choose_emitter_flags(h)
    bands = _sprite_bands(h, flags)
    if bands is None:
        return None

    out, sprites = _render_output(h, w, sep, bands, flags)
    inp = _unslide_sprites(h, w, sep, sprites)
    if inp is None:
        return None

    try:
        if not np.array_equal(main(inp), out):
            return None
    except Exception:
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 6e453dd6 input")

