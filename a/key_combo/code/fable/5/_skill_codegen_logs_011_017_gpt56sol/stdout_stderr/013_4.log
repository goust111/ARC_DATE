+        arrows.append(candidate)
+        trace.update(line)
+        trace.add(candidate["tip"])
+        incoming_directions.append(incoming)
+        directions_used.append(candidate["direction"])
+        position = candidate["tip"]
+        incoming = candidate["direction"]
