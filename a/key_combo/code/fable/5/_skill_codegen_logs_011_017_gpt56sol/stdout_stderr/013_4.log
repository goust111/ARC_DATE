+
+def _choose_start(shape: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    height, width = shape
+    side = random.choice(("top", "bottom", "left", "right"))
+    if side == "top":
+        return (0, random.randint(3, width - 4)), DOWN
+    if side == "bottom":
+        return (height - 1, random.randint(3, width - 4)), UP
+    if side == "left":
