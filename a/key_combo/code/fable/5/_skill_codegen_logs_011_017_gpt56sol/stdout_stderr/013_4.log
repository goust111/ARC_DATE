  "type": "transform_in_place",
  "src": "colored horizontal runs in the left reference panel's active columns",
  "dst": "blank right panel's active columns",
  "transform": "copy two-column endpoint runs to the corresponding edge of the right active span; stretch any run that connects the endpoint slots across the full active span"
}
</annotation>
</reference_puzzle>

