+        tip = event["tip"]
+        if collision == tip:
+            return None
+        incoming_dir = event["incoming"]
+        if incoming_dir[0] == 0 and collision[0] == tip[0]:
+            return None
+        if incoming_dir[1] == 0 and collision[1] == tip[1]:
+            return None
+    for decoy in decoys:
+        if any(int(expected[cell]) != int(grid[cell]) for cell in decoy["cells"]):
