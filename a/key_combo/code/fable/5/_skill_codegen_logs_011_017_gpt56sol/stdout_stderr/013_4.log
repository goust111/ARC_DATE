+                    candidates.append(
+                        {"cells": cells, "tip": (tr, tc), "direction": direction, "distance": distance}
+                    )
+        if not candidates:
+            return None
+        if decoy_index == 0:
+            near = [candidate for candidate in candidates if candidate["distance"] <= 5]
+            if near:
+                candidates = near
+        chosen = random.choice(candidates)
+        chosen.pop("distance")
+        decoys.append(chosen)
