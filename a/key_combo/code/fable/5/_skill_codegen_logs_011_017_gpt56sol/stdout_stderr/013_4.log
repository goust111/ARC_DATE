+
+
+def _choose_inward(start: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int]:
+    r, c = start
+    height, width = shape
+    if r == 0:
+        return DOWN
+    if r == height - 1:
+        return UP
+    if c == 0:
+        return RIGHT
+    assert c == width - 1
+    return LEFT
+
+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, oracle-checked framed relay with both chain and decoy arrows."""
