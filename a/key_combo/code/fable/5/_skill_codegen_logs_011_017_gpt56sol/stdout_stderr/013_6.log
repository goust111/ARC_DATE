+    template_points = {
+        (int(r), int(c))
+        for r, c in np.argwhere(g[:, :sep] == glyph_color)
+    }
+    assert len(template_points) >= 6, "template must be a complete, nontrivial glyph"
+    assert len(_components4(template_points)) == 1, "template glyph must be 4-connected"
+
