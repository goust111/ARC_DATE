+
+    expected = _independent_expected(inp, glyph_color, template_offsets, placements)
+    if not _validate_generated(
+        inp,
+        expected,
+        bg,
+        glyph_color,
+        sep,
+        template_offsets,
+        placements,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
