+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a valid fiducial reconstruction puzzle")

