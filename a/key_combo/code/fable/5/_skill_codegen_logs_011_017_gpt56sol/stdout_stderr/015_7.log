+    high = list(range(width // 2 + 1, width))
+    shifts = [rng.choice(low), rng.choice(high)]
+    remaining = [s for s in range(1, width) if s not in shifts]
+    shifts.extend(rng.sample(remaining, count - 2))
+    rng.shuffle(shifts)
+    return shifts
