+        slices: list[slice] = []
+        start = 0
+        valid = True
+        for r0, r1 in groups:
+            if r0 <= start:
+                valid = False
+                break
+            slices.append(slice(start, r0))
+            start = r1 + 1
+        if not valid or start >= height:
