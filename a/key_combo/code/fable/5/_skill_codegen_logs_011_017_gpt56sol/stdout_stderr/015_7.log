from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import Counter
import hashlib
import random
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/5/015/7.py')
m = SourceFileLoader('new_arc_task_semantics', str(p)).load_module()
input_sigs, output_sigs = set(), set()
band_counts, heights, widths = Counter(), Counter(), Counter()
edge_targets = 0
for _ in range(300):
    x = m.generate_input()
    y = m.main(x)
    sep, bands = m._band_slices(x)
    anchors_in = [m._singleton_pixel(x[s, :]) for s in bands]
    anchors_out = [m._singleton_pixel(y[s, :]) for s in bands]
    target = anchors_in[0][2]
    assert all(a[2] == target for a in anchors_out)
    assert np.array_equal(x[bands[0], :], y[bands[0], :])
    assert not np.array_equal(x, y)
    assert all(int(np.count_nonzero(x == a[0])) > 1 for a in anchors_in)
    assert len({a[0] for a in anchors_in}) == len(bands)

    # Color names/ids carry no meaning: an arbitrary palette permutation commutes.
    perm = list(range(10))
    random.shuffle(perm)
    xr = np.asarray(perm, dtype=int)[x]
    yr = np.asarray(perm, dtype=int)[y]
    assert np.array_equal(m.main(xr), yr)

    input_sigs.add(hashlib.md5(x.tobytes() + str(x.shape).encode()).hexdigest())
    output_sigs.add(hashlib.md5(y.tobytes() + str(y.shape).encode()).hexdigest())
    band_counts[len(bands)] += 1
    heights[bands[0].stop - bands[0].start] += 1
    widths[x.shape[1]] += 1
    edge_targets += target in (0, 1, x.shape[1] - 2, x.shape[1] - 1)

