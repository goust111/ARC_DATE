+        next_distance = distance[(r, c)] + 1
+        for cell in _neighbors4(r, c):
+            if cell in component and cell not in distance:
+                distance[cell] = next_distance
+                queue.append(cell)
+    assert len(distance) == len(component), "neutral component must be 4-connected"
+    return distance
+
