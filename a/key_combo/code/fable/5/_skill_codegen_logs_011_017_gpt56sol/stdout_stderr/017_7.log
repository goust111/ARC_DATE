import numpy as np

from arc_utils import bbox_coords, components_mask
import random

_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]


def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    """
    Legend is a top region with a background color (typically 5) and 4 vertical bars.
    Each bar's horizontal position inside its cell encodes turn direction:
      - bar on left  -> 'L' (turn counterclockwise)
      - bar on right -> 'R' (turn clockwise)
    """
    legend = grid[:legend_h, :]
    assert legend.size, "legend must be non-empty"
    _vals, _cnts = np.unique(legend, return_counts=True); bg = int(_vals[_cnts.argmax()])

    # Separator columns are solid bg throughout the legend.
    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    assert len(sep_cols) >= 2, "legend separator columns must exist"

    turn: dict[int, str] = {}
    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
        if b - a <= 2:
            continue
        interior = legend[1 : legend_h - 1, a + 1 : b]
        colors = set(map(int, np.unique(interior)))
        colors.discard(bg)
        colors.discard(0)
        assert len(colors) == 1, "each legend cell must encode exactly one color"
        col = int(next(iter(colors)))
        xs = np.where(interior == col)[1]
        x = int(xs[0])  # relative to interior
        # Decide left/right by proximity to borders (interior is typically 4 cells wide).
        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
    assert len(turn) == 4, "legend must encode four turn colors"
    return turn


def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
    """Return (r0,c0,size) for a solid square teal component."""
    candidates: list[tuple[int, int, int]] = []
    for cells in components_mask(g == teal, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(cells)
        hh = r1 - r0 + 1
        ww = c1 - c0 + 1
        if hh != ww:
            continue
        size = hh
        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
            continue
        candidates.append((int(r0), int(c0), int(size)))
    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
    return candidates[0]


def _rot_ccw(d: int) -> int:
    return (d - 1) % 4


def _rot_cw(d: int) -> int:
    return (d + 1) % 4


def main(grid: np.ndarray) -> np.ndarray:
    """
    Emit four teal beams from a square, turning at colored obstacles per a legend.

    Input structure:
    - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.
    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.

    Rule:
    - Remove the legend from the output.
    - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).
    - Each beam paints teal over bg cells as it moves.
    - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.
    - Beams stop at grid edges.

    Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.
    """
    g = np.asarray(grid, dtype=int)

    # Legend height: crop everything above and including the last row containing legend bg (usually 5).
    # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.
    legend_bg = 5
    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
    assert rows_with_legend.size, "legend rows must be present"
    legend_h = int(rows_with_legend.max() + 1)
    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"

    legend_turn = _parse_legend(g, legend_h)

    base = g[legend_h:, :].copy()
    assert base.size, "main grid must remain after legend crop"

    _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])
    teal = 8
    src = _find_teal_square(base, teal=teal)
    sr, sc, sz = src

    out = base.copy()

    def in_bounds(r: int, c: int) -> bool:
        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]

    def paint_block(r: int, c: int) -> None:
        blk = out[r : r + sz, c : c + sz]
        blk[blk == bg] = teal
        out[r : r + sz, c : c + sz] = blk

    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
        blk = out[nr : nr + sz, nc : nc + sz]
        cols = set(map(int, np.unique(blk)))
        cols.discard(bg)
        cols.discard(teal)
        if not cols:
            return None
        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
        return int(next(iter(cols)))

    # Four beams, each is a moving copy of the teal square.
    for d0 in range(4):
        r, c, d = sr, sc, d0
        seen: set[tuple[int, int, int]] = set()
        while True:
            state = (r, c, d)
            assert state not in seen, "beam path must not cycle"
            seen.add(state)

            dr, dc = _DIRS[d]
            nr, nc = r + dr, c + dc
            if not in_bounds(nr, nc):
                break

            oc = obstacle_color_at_next(nr, nc)
            if oc is None:
                r, c = nr, nc
                paint_block(r, c)
                continue

            assert oc in legend_turn, "obstacle color must be encoded by legend"
            turn = legend_turn[oc]
            d = _rot_ccw(d) if turn == "L" else _rot_cw(d)

    return out

# --------------- generator (o5x) ---------------

# ── Configuration ──────────────────────────────────────────────────────
_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
_N, _E, _S, _W = range(4)

# Color palettes
LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]          # colors eligible for obstacles / legend
BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]        # colors eligible for main-grid background
LEGEND_BG = 5                                  # legend background color
TEAL = 8                                       # beam / square color

# Canvas dimensions
GRID_H_RANGE = (19, 24)                        # main-grid height (rows)
GRID_W = 24                                    # main-grid width (fixed)
LEGEND_H = 6                                   # legend height (rows)
LEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells

# Teal square
TEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3
SQUARE_EDGE_GAP = 5                            # min gap from square to grid edges

# Obstacles
OBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3
OBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds
OBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present
OBS_BOTH_GAP = 2                               # gap subtracted when both sides present

# Span selection
SPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz
SPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz
SPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)

# Retry budget
MAX_RETRIES = 300


def _rot(d: int, turn: str) -> int:
    """Rotate direction d by turn ('L' = CCW, 'R' = CW)."""
    return (d - 1) % 4 if turn == "L" else (d + 1) % 4


# ── Obstacle span selection ───────────────────────────────────────────

def _choose_span(
    axis_len: int,
    required: list[tuple[int, int]],
    excluded: list[tuple[int, int]],
    min_len: int,
    max_len: int,
) -> tuple[int, int] | None:
    """Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*."""
    req0 = min(a for a, _ in required)
    req1 = max(b for _, b in required)
    lo = max(min_len, req1 - req0 + 1)
    hi = min(max_len, axis_len)
    choices: list[tuple[int, int, int]] = []
    for length in range(lo, hi + 1):
        start0 = max(0, req1 - length + 1)
        start1 = min(req0, axis_len - length)
        for start in range(start0, start1 + 1):
            end = start + length - 1
            if all(end < a or start > b for a, b in excluded):
                choices.append((length, start, end))
    if not choices:
        return None

    # Bias mildly toward compact side bars while still covering long-span cases.
    lengths = sorted({length for length, _, _ in choices})
    if random.random() < SPAN_COMPACT_PROB:
        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
        pool = [(start, end) for length, start, end in choices if length <= cutoff]
    else:
        pool = [(start, end) for _, start, end in choices]
    return random.choice(pool)


# ── Beam simulation (oracle) ──────────────────────────────────────────

def _simulate_paths(
    base: np.ndarray, turns: dict[int, str], bg: int
) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
    """Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists."""
    vals, counts = np.unique(base, return_counts=True)
    assert int(vals[counts.argmax()]) == bg

    teal_locs = np.argwhere(base == TEAL)
    assert teal_locs.size
    sr, sc = teal_locs.min(axis=0)
    r1, c1 = teal_locs.max(axis=0)
    sz = int(r1 - sr + 1)
    assert sz == int(c1 - sc + 1)

    out = base.copy()
    H, W = out.shape
    hits: list[list[tuple[int, int, int, int]]] = []

    def in_bounds(r: int, c: int) -> bool:
        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W

    def paint(r: int, c: int) -> None:
        blk = out[r : r + sz, c : c + sz]
        blk[blk == bg] = TEAL

    def obstacle_at(r: int, c: int) -> int | None:
        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
        colors.discard(bg)
        colors.discard(TEAL)
        if not colors:
            return None
        assert len(colors) == 1
        return next(iter(colors))

    for d0 in range(4):
        r, c, d = int(sr), int(sc), d0
        beam_hits: list[tuple[int, int, int, int]] = []
        seen: set[tuple[int, int, int]] = set()
        while True:
            state = (r, c, d)
            assert state not in seen
            seen.add(state)
            dr, dc = _DIRS[d]
            nr, nc = r + dr, c + dc
            if not in_bounds(nr, nc):
                break
            obs = obstacle_at(nr, nc)
            if obs is None:
                r, c = nr, nc
                paint(r, c)
                continue
            assert obs in turns
            beam_hits.append((d, obs, nr, nc))
            d = _rot(d, turns[obs])
            assert len(beam_hits) <= 2
        hits.append(beam_hits)

    return out, hits


# ── Legend construction ────────────────────────────────────────────────

def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
    """Build the 6x24 legend band from 4 colors and their turn assignments."""
    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
        legend[1:5, start : start + 4] = 0
        bar_col = start if turns[color] == "L" else start + 3
        legend[1:5, bar_col] = color
    return legend


# ── Obstacle thickness ────────────────────────────────────────────────

def _rand_thickness(lo: int, hi: int) -> int | None:
    """Return random thickness in [lo, hi], or None if infeasible."""
    return random.randint(lo, hi) if hi >= lo else None


def _thickness_pair(
    axis: int, sz: int, a_present: bool, b_present: bool
) -> tuple[int | None, int | None] | None:
    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
    lo, hi_cap = OBS_THICKNESS_RANGE
    if a_present and b_present:
        room = axis - sz - OBS_BOTH_GAP
        if room < 2 * lo:
            return None
        a = random.randint(lo, min(hi_cap, room - lo))
        b = _rand_thickness(lo, min(hi_cap, room - a))
        return (a, b) if b is not None else None
    if a_present:
        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
        return (t, None) if t is not None else None
    if b_present:
        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
        return (None, t) if t is not None else None
    return None, None


# ── Obstacle rect coordinates ─────────────────────────────────────────

def _obstacle_rect(
    side: int, thickness: int, span: tuple[int, int], h: int, w: int
) -> tuple[int, int, int, int]:
    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
    s0, s1 = span
    if side == _N:
        return 0, thickness - 1, s0, s1
    if side == _S:
        return h - thickness, h - 1, s0, s1
    if side == _W:
        return s0, s1, 0, thickness - 1
    # _E
    return s0, s1, w - thickness, w - 1


# ── Second-hit chain selection ────────────────────────────────────────

def _select_chains(
    present: set[int], second_hits: int
) -> dict[int, int] | None:
    """Pick non-overlapping (source -> adjacent target) pairs for multi-bounce beams."""
    candidates = [
        (side, nxt)
        for side in present
        for nxt in ((side - 1) % 4, (side + 1) % 4)
        if nxt in present
    ]
    random.shuffle(candidates)
    selected: list[tuple[int, int]] = []
    used: set[int] = set()
    for side, nxt in candidates:
        if len(selected) == second_hits:
            break
        if side in used or nxt in used:
            continue
        selected.append((side, nxt))
        used.update((side, nxt))
    return dict(selected) if len(selected) == second_hits else None


# ── Turn assignment per side ──────────────────────────────────────────

def _assign_turns(
    present: set[int], chains: dict[int, int]
) -> dict[int, str]:
    """Assign L/R turn direction for each obstacle side."""
    side_turn: dict[int, str] = {}
    for side in present:
        if side in chains:
            nxt = chains[side]
            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
        else:
            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
            side_turn[side] = random.choice(outward if outward else ["L", "R"])
    return side_turn


# ── Span constraints ─────────────────────────────────────────────────

def _compute_span_constraints(
    present: set[int], side_turn: dict[int, str], chains: dict[int, int],
    sr: int, sc: int, sz: int, lane: dict[int, int],
) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
    """Build required/excluded intervals for each obstacle's span selection."""
    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}

    # Each obstacle must cover the beam's cross-section at its edge.
    for side in present:
        base_coord = sc if side in (_N, _S) else sr
        required[side].append((base_coord, base_coord + sz - 1))

    def lane_interval(s: int) -> tuple[int, int]:
        return lane[s], lane[s] + sz - 1

    for side in present:
        nxt = _rot(side, side_turn[side])
        if nxt not in present:
            continue
        if chains.get(side) == nxt:
            # The beam bounces from *side* into *nxt*: nxt must cover side's lane.
            required[nxt].append(lane_interval(side))
            after = _rot(nxt, side_turn[nxt])
            if after in present:
                excluded[after].append(lane_interval(nxt))
        else:
            # The beam would miss nxt, so nxt must NOT cover side's lane.
            excluded[nxt].append(lane_interval(side))

    return required, excluded


# ── Main attempt ──────────────────────────────────────────────────────

def _gen_attempt() -> np.ndarray | None:
    h, w = random.randint(*GRID_H_RANGE), GRID_W
    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
    target_hits = random.choice([4, 5])
    second_hits = target_hits - obstacle_count
    if second_hits < 0 or second_hits > 2:
        return None

    # Obstacle thicknesses along each axis.
    ns = _thickness_pair(h, sz, _N in present, _S in present)
    ew = _thickness_pair(w, sz, _W in present, _E in present)
    if ns is None or ew is None:
        return None
    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}

    # Teal square placement bounds, respecting edge gap and obstacle thickness.
    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
    if _N in present: min_r = max(min_r, thickness[_N] + 1)
    if _S in present: max_r = min(max_r, h - thickness[_S] - sz - 1)
    if _W in present: min_c = max(min_c, thickness[_W] + 1)
    if _E in present: max_c = min(max_c, w - thickness[_E] - sz - 1)
    if min_r > max_r or min_c > max_c:
        return None
    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)

    # Lane positions: where the beam crosses each obstacle's edge.
    lane = {}
    if _N in present: lane[_N] = thickness[_N] + 1
    if _S in present: lane[_S] = h - thickness[_S] - sz
    if _W in present: lane[_W] = thickness[_W] + 1
    if _E in present: lane[_E] = w - thickness[_E] - sz

    # Select which beams get a second bounce.
    chains = _select_chains(present, second_hits)
    if chains is None:
        return None

    side_turn = _assign_turns(present, chains)
    required, excluded = _compute_span_constraints(
        present, side_turn, chains, sr, sc, sz, lane,
    )

    # Choose obstacle spans along each edge.
    spans: dict[int, tuple[int, int]] = {}
    for side in present:
        axis_len = w if side in (_N, _S) else h
        span = _choose_span(
            axis_len, required[side], excluded[side],
            SPAN_MIN_MULT * sz, min(SPAN_MAX_MULT * sz, axis_len),
        )
        if span is None:
            return None
        spans[side] = span

    # Color assignment.
    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
    obstacle_colors = random.sample(legend_colors, obstacle_count)
    side_color = dict(zip(sorted(present), obstacle_colors))
    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])

    # Render obstacles onto the base grid.
    base = np.full((h, w), bg, dtype=int)
    base[sr : sr + sz, sc : sc + sz] = TEAL
    occupied = np.zeros((h, w), dtype=bool)
    for side in present:
        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
        if region.any():
            return None
        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
            return None
        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]

    vals, counts = np.unique(base, return_counts=True)
    if int(vals[counts.argmax()]) != bg:
        return None

    # Build turn map: obstacle colors -> assigned turns, fill unused legend colors randomly.
    turns = {side_color[s]: side_turn[s] for s in present}
    for color in legend_colors:
        turns.setdefault(color, random.choice(["L", "R"]))

    # Validate via beam simulation.
    try:
        expected, hits = _simulate_paths(base, turns, bg)
    except AssertionError:
        return None
    hit_counts = [len(beam) for beam in hits]
    hit_colors = {color for beam in hits for _, color, _, _ in beam}
    if sum(hit_counts) != target_hits or any(c > 2 for c in hit_counts):
        return None
    if set(side_color.values()) - hit_colors:
        return None

    # Oracle check against the solver.
    legend = _make_legend(legend_colors, turns)
    inp = np.vstack([legend, base])
    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate e87109e9 input")
import numpy as np

from arc_utils import find_components, get_bg
import itertools
import random


MARKER_COLOR = 1
BODY_COLOR = 2


def _vertical_bars(g: np.ndarray, bg: int) -> list[dict]:
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    bars = []
    baseline = None
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        assert c0 == c1
        coords = comp["coords"]
        height = r1 - r0 + 1
        assert comp["area"] == height
        assert {(int(r), int(c)) for r, c in coords} == {(r, c0) for r in range(r0, r1 + 1)}
        if baseline is None:
            baseline = r1
        else:
            assert r1 == baseline
        bars.append(
            {
                "color": int(comp["color"]),
                "col": int(c0),
                "bottom": int(r1),
                "height": int(height),
                "coords": coords,
            }
        )

    assert bars
    return sorted(bars, key=lambda b: b["col"])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Rotate each blue-started chain of bottom-aligned vertical bars into horizontal bars resting on the same baseline.
    Input structure
    - The grid has a background and bottom-aligned, one-cell-wide vertical bars.
    - Blue bars are markers; red bars are body bars that may be chained after a marker.
    Rule
    - Starting at each blue bar, repeatedly include the next red bar whose column is exactly the current bar's column plus the current bar's height.
    - Clear every included vertical bar, then redraw each included bar horizontally to the right from its original bottom cell, with length equal to its vertical height.
    - Red bars that are not reached from a blue marker remain unchanged.
    Key insight
    - A vertical bar's height is also the width it occupies after rotation, so the chain follows immediate horizontal contact after each rotated bar.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = set(map(int, np.unique(g))) - {bg}
    assert colors <= {MARKER_COLOR, BODY_COLOR}
    assert MARKER_COLOR in colors

    bars = _vertical_bars(g, bg)
    by_col = {bar["col"]: bar for bar in bars}
    assert len(by_col) == len(bars)

    baselines = {bar["bottom"] for bar in bars}
    assert len(baselines) == 1
    baseline = baselines.pop()
    out = g.copy()
    for bar in bars:
        if bar["color"] != MARKER_COLOR:
            continue

        group = [bar]
        current = bar
        while True:
            next_col = current["col"] + current["height"]
            next_bar = by_col.get(next_col)
            if next_bar is None:
                break
            if next_bar["color"] != BODY_COLOR:
                break
            group.append(next_bar)
            current = next_bar

        for item in group:
            rows = item["coords"][:, 0]
            cols = item["coords"][:, 1]
            out[rows, cols] = bg

        for item in group:
            col = item["col"]
            height = item["height"]
            assert col + height <= g.shape[1]
            out[baseline, col : col + height] = item["color"]

    return out

# --------------- generator (att2) ---------------

# Canvas bounds.
MIN_ROWS, MAX_ROWS, MIN_WIDTH, MAX_WIDTH = 3, 9, 7, 30

# Bar and chain structure.
MIN_BLUE_BARS, MAX_BLUE_BARS = 1, 3
MIN_RED_BARS, MAX_RED_BARS, MAX_TOTAL_BARS = 1, 6, 9
MIN_BAR_HEIGHT, MAX_BAR_HEIGHT, MAX_CHAIN_RED_PER_BLUE, MAX_UNCHAINED_RED = 2, 4, 4, 2

# Layout padding and retry budget.
GAP_VALUES = (1, 2, 3)
MAX_RIGHT_MARGIN, MAX_RANDOM_LEFT_MARGIN, MAX_GENERATION_ATTEMPTS = 2, 2, 300


def _chain_red_distributions(n_blue, n_red):
    """Return all red-count allocations across blue-started chains."""
    return [c for c in itertools.product(range(MAX_CHAIN_RED_PER_BLUE + 1), repeat=n_blue) if sum(c) == n_red]


def _bounded_tuples(values, n, max_sum):
    """Return ordered n-tuples from values whose sum fits the width budget."""
    return [t for t in itertools.product(values, repeat=n) if sum(t) <= max_sum]


def _sample_groups():
    """Sample row count and bar groups before physical layout."""
    rows = random.randint(MIN_ROWS, MAX_ROWS)
    max_height = min(MAX_BAR_HEIGHT, rows)
    n_blue = random.randint(MIN_BLUE_BARS, MAX_BLUE_BARS)
    max_red = min(MAX_RED_BARS, MAX_TOTAL_BARS - n_blue, MAX_CHAIN_RED_PER_BLUE * n_blue + MAX_UNCHAINED_RED)
    red_total = random.randint(MIN_RED_BARS, max_red)
    min_unchained = max(0, red_total - MAX_CHAIN_RED_PER_BLUE * n_blue)
    max_unchained = min(MAX_UNCHAINED_RED, red_total)
    n_unchained = random.randint(min_unchained, max_unchained)

    distributions = _chain_red_distributions(n_blue, red_total - n_unchained)
    if not distributions:
        return None

    groups = [
        {"kind": "chain", "colors": [MARKER_COLOR] + [BODY_COLOR] * n_red}
        for n_red in random.choice(distributions)
    ]
    groups.extend({"kind": "unchained", "colors": [BODY_COLOR]} for _ in range(n_unchained))
    random.shuffle(groups)
    if groups[0]["kind"] == "unchained":
        for i, group in enumerate(groups):
            if group["kind"] == "chain":
                groups[0], groups[i] = groups[i], groups[0]
                break
    return rows, max_height, groups


def _sample_layout(max_height, groups):
    """Sample gaps, heights, margins, and positioned bar columns."""
    n_bars = sum(len(group["colors"]) for group in groups)
    right_margin = random.randint(0, MAX_RIGHT_MARGIN)

    gap_count = len(groups) - 1
    if gap_count:
        max_gap_sum = MAX_WIDTH - right_margin - MIN_BAR_HEIGHT * n_bars
        gap_options = _bounded_tuples(GAP_VALUES, gap_count, max_gap_sum)
        if not gap_options:
            return None
        gaps = list(random.choice(gap_options))
    else:
        gaps = []

    height_options = _bounded_tuples(
        tuple(range(MIN_BAR_HEIGHT, max_height + 1)),
        n_bars,
        MAX_WIDTH - right_margin - sum(gaps),
    )
    if not height_options:
        return None
    heights = list(random.choice(height_options))

    idx = 0
    for group in groups:
        count = len(group["colors"])
        group["heights"] = heights[idx : idx + count]
        idx += count

    span = sum(heights) + sum(gaps)
    min_left = max(0, MIN_WIDTH - right_margin - span)
    max_left = MAX_WIDTH - right_margin - span
    if min_left > max_left:
        return None
    if min_left <= min(MAX_RANDOM_LEFT_MARGIN, max_left):
        left_margin = random.randint(min_left, min(MAX_RANDOM_LEFT_MARGIN, max_left))
    else:
        left_margin = min_left

    width = left_margin + span + right_margin
    if not (MIN_WIDTH <= width <= MAX_WIDTH):
        return None

    bars = []
    col = left_margin
    gap_i = 0
    for group_i, group in enumerate(groups):
        chained = group["kind"] == "chain"
        for color, height in zip(group["colors"], group["heights"]):
            bars.append(
                {
                    "color": color,
                    "height": height,
                    "col": col,
                    "chained": chained,
                }
            )
            col += height
        if group_i + 1 < len(groups):
            col += gaps[gap_i]
            gap_i += 1

    if col + right_margin != width:
        return None
    return bars, width


def _render_pair(rows, width, bars):
    """Render the sampled input grid and its expected transformed output."""
    baseline = rows - 1
    inp = np.zeros((rows, width), dtype=int)
    out = np.zeros_like(inp)
    for bar in bars:
        color, height, col = bar["color"], bar["height"], bar["col"]
        vertical = slice(baseline - height + 1, baseline + 1)
        inp[vertical, col] = color
        if bar["chained"]:
            out[baseline, col : col + height] = color
        else:
            out[vertical, col] = color
    return inp, out


def _passes_oracle(inp, expected):
    """Return whether the solver accepts and matches the rendered output."""
    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, expected)


def _gen_attempt():
    sampled = _sample_groups()
    if sampled is None:
        return None
    rows, max_height, groups = sampled

    layout = _sample_layout(max_height, groups)
    if layout is None:
        return None
    bars, width = layout

    inp, expected = _render_pair(rows, width, bars)
    if not _passes_oracle(inp, expected):
        return None
    return inp


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 84551f4c input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox, colors_present, get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete every colored sprite by applying the union of all aligned partial sprite masks.

    Input structure:
    - The dominant color is the background.
    - Each non-background color appears as a separated partial copy of one common sprite mask.
    - The copies share a top-left-aligned sprite window; some copies may be missing lower or right edge pixels.

    Rule:
    - Crop each same-color mask to its bounding box.
    - Pad the crops to the maximum observed height and width, aligned at the top-left, and OR them into one complete template.
    - Fill that template at every sprite location using the sprite's own color.

    Key insight:
    - No single input sprite is complete, but their missing cells are complementary, so the aligned union reveals the full mask.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)

    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) >= 2, "expected multiple partial sprite copies"

    sprites: list[tuple[int, int, int, np.ndarray]] = []
    for color in colors:
        mask = g == color
        box = bbox(mask)
        assert box is not None, "each foreground color must be present"
        r0, c0, r1, c1 = box
        local = mask[r0 : r1 + 1, c0 : c1 + 1]
        assert np.any(local), "expected a nonempty sprite mask"
        sprites.append((int(color), int(r0), int(c0), local))

    template_h = max(local.shape[0] for _, _, _, local in sprites)
    template_w = max(local.shape[1] for _, _, _, local in sprites)
    assert template_h > 0 and template_w > 0

    template = np.zeros((template_h, template_w), dtype=bool)
    for _, _, _, local in sprites:
        local_h, local_w = map(int, local.shape)
        template[:local_h, :local_w] |= local
    assert np.any(template), "expected a nonempty recovered sprite template"

    out = g.copy()
    for color, r0, c0, _ in sprites:
        r1 = r0 + template_h
        c1 = c0 + template_w
        assert r1 <= height and c1 <= width, "sprite window must fit in the grid"
        region = out[r0:r1, c0:c1]
        assert np.all((region == bg) | (region == color)), "sprite windows must not overlap other colors"
        region[template] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas and palette bounds.
GRID_HEIGHT_RANGE = (11, 22)
GRID_WIDTH_RANGE = (18, 22)
PALETTE_SIZE = 10

# Template geometry and growth.
TEMPLATE_SIDE_RANGE = (5, 7)
TEMPLATE_FILL_FRACTION_RANGE = (0.48, 0.84)
TEMPLATE_STOP_PROBABILITY = 0.35
PATH_VERTICAL_FIRST_PROBABILITY = 0.5
ORTHOGONAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Sprite layout constraints.
SPRITE_COUNT_RANGE = (2, 4)
WINDOW_GAP = 1

# Per-sprite damage limits.
DAMAGE_FRACTION_RANGE = (0.07, 0.33)
DAMAGE_MISSING_PIXEL_RANGE = (1, 6)

# Rejection sampling limit.
GENERATION_RETRY_LIMIT = 300


def _gen_path(mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:
    r, c = a
    tr, tc = b
    if random.random() < PATH_VERTICAL_FIRST_PROBABILITY:
        while r != tr:
            mask[r, c] = True
            r += 1 if tr > r else -1
        while c != tc:
            mask[r, c] = True
            c += 1 if tc > c else -1
    else:
        while c != tc:
            mask[r, c] = True
            c += 1 if tc > c else -1
        while r != tr:
            mask[r, c] = True
            r += 1 if tr > r else -1
    mask[tr, tc] = True


def _gen_orbit(side: int, r: int, c: int) -> set[tuple[int, int]]:
    last = side - 1
    return {
        (r, c),
        (c, r),
        (last - r, c),
        (r, last - c),
        (last - r, last - c),
        (last - c, last - r),
        (c, last - r),
        (last - c, r),
    }


def _gen_add_orbit(mask: np.ndarray, r: int, c: int) -> None:
    for rr, cc in _gen_orbit(mask.shape[0], r, c):
        mask[rr, cc] = True


def _gen_template(side: int) -> np.ndarray | None:
    min_fill, max_fill = TEMPLATE_FILL_FRACTION_RANGE
    min_area = int(np.ceil(min_fill * side * side))
    max_area = int(np.floor(max_fill * side * side))
    target = random.randint(min_area, max_area)

    mask = np.zeros((side, side), dtype=bool)
    center = side // 2
    top_c = random.randrange(side)
    _gen_path(mask, (center, center), (0, top_c))
    for r, c in list(map(tuple, np.argwhere(mask))):
        _gen_add_orbit(mask, int(r), int(c))

    if int(mask.sum()) > max_area:
        return None
    target = max(target, int(mask.sum()))

    while int(mask.sum()) < target:
        orbit_choices = []
        for r, c in np.argwhere(mask):
            for dr, dc in ORTHOGONAL_STEPS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < side and 0 <= nc < side and not mask[nr, nc]:
                    orbit = _gen_orbit(side, int(nr), int(nc))
                    added = sum(1 for p in orbit if not mask[p])
                    if added and int(mask.sum()) + added <= max_area:
                        orbit_choices.append((int(nr), int(nc), added))
        if not orbit_choices:
            return None
        if int(mask.sum()) >= min_area and random.random() < TEMPLATE_STOP_PROBABILITY:
            break
        r, c, _ = random.choice(orbit_choices)
        _gen_add_orbit(mask, r, c)

    if not (min_area <= int(mask.sum()) <= max_area):
        return None
    return mask


def _gen_windows(height: int, width: int, side: int, count: int) -> list[tuple[int, int]] | None:
    windows: list[tuple[int, int]] = []
    candidates = [(r, c) for r in range(height - side + 1) for c in range(width - side + 1)]
    for _ in range(count):
        valid = []
        for r, c in candidates:
            ok = True
            for pr, pc in windows:
                separated_rows = (
                    r + side <= pr - WINDOW_GAP or pr + side <= r - WINDOW_GAP
                )
                separated_cols = (
                    c + side <= pc - WINDOW_GAP or pc + side <= c - WINDOW_GAP
                )
                if not (separated_rows or separated_cols):
                    ok = False
                    break
            if ok:
                valid.append((r, c))
        if not valid:
            return None
        windows.append(random.choice(valid))
    return windows


def _gen_damaged_masks(template: np.ndarray, count: int) -> list[np.ndarray] | None:
    coords = [tuple(map(int, rc)) for rc in np.argwhere(template)]
    area = len(coords)
    min_damage, max_damage = DAMAGE_FRACTION_RANGE
    min_missing, max_missing = DAMAGE_MISSING_PIXEL_RANGE
    low = max(min_missing, int(np.ceil(min_damage * area)))
    high = min(max_missing, int(np.floor(max_damage * area)))
    if low > high:
        return None

    top = random.choice([p for p in coords if p[0] == 0])
    left = random.choice([p for p in coords if p[1] == 0])
    bottom = random.choice([p for p in coords if p[0] == template.shape[0] - 1])
    right = random.choice([p for p in coords if p[1] == template.shape[1] - 1])

    missing_counts = {p: 0 for p in coords}
    masks = []
    for i in range(count):
        protect = {top, left}
        if i == 0:
            protect |= {bottom, right}
        k = random.randint(low, high)
        missing = set()
        for _ in range(k):
            choices = [
                p
                for p in coords
                if p not in protect
                and p not in missing
                and missing_counts[p] < count - 1
            ]
            if not choices:
                return None
            p = random.choice(choices)
            missing.add(p)
            missing_counts[p] += 1
        m = template.copy()
        if missing:
            rr, cc = zip(*missing)
            m[rr, cc] = False
        masks.append(m)

    if not np.array_equal(np.logical_or.reduce(masks), template):
        return None
    return masks


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*GRID_HEIGHT_RANGE)
    width = random.randint(*GRID_WIDTH_RANGE)
    side = random.randint(*TEMPLATE_SIDE_RANGE)
    count = random.randint(*SPRITE_COUNT_RANGE)

    template = _gen_template(side)
    if template is None:
        return None

    windows = _gen_windows(height, width, side, count)
    if windows is None:
        return None

    masks = _gen_damaged_masks(template, count)
    if masks is None:
        return None

    colors = list(range(PALETTE_SIZE))
    bg = random.choice(colors)
    fg_colors = random.sample([c for c in colors if c != bg], count)

    inp = np.full((height, width), bg, dtype=int)
    expected = inp.copy()
    for color, (r0, c0), damaged in zip(fg_colors, windows, masks):
        inp[r0 : r0 + side, c0 : c0 + side][damaged] = color
        expected[r0 : r0 + side, c0 : c0 + side][template] = color

    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid f8cc533f input")

