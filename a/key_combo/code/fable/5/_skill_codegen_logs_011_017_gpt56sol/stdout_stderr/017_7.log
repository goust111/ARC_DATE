+            (rr, cc)
+            for r, c in cells
+            for rr, cc in _neighbors4(r, c)
+            if 0 <= rr < box_h and 0 <= cc < box_w and (rr, cc) not in cells
+        }
+        if not frontier:
+            break
+        cells.add(random.choice(tuple(frontier)))
