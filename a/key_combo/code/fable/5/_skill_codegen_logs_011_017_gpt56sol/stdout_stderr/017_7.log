+# ------------------------------ generator ------------------------------
+
+GRID_SIDE_RANGE = (20, 31)  # random.randrange upper bound; ARC maximum remains 30
+OBJECT_COUNT_RANGE = (3, 6)
+PLACEMENT_GAP = 2
+GENERATION_ATTEMPTS = 300
