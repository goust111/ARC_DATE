from __future__ import annotations

import numpy as np
from scipy.ndimage import binary_dilation

import random

from arc_utils import (
    Color,
    STRUCT8,
    colors_present,
    components_mask,
    get_bg,
    in_bounds,
    label_mask,
    neighbors4,
)


def _path_color(g: np.ndarray, bg: int) -> int:
    candidates = []
    for color in colors_present(g, exclude={bg}):
        comps = components_mask(g == color, connectivity=4)
        if len(comps) == 2:
            candidates.append(int(color))

    assert len(candidates) == 1, "expected exactly one color forming two path components"
    return candidates[0]


def _adjacent_path_labels(labels: np.ndarray, r: int, c: int) -> set[int]:
    adjacent = set()
    for rr, cc in neighbors4(r, c):
        if in_bounds(labels.shape, rr, cc) and labels[rr, cc] > 0:
            adjacent.add(int(labels[rr, cc]))
    return adjacent


def main(grid: np.ndarray) -> np.ndarray:
    """
    Paint the top-connected middle channel between two orange path components teal.

    Input structure
    - The background is black.
    - One foreground color forms exactly two 4-connected one-pixel-wide path components.
    - Optional non-background control pixels may sit in the channel between the two paths.

    Rule
    - Dilate each path component by one cell in the 8-neighborhood and intersect the two dilations; this gives the one-cell-wide middle channel.
    - A control pixel in that channel is a blocker only when its 4-neighbors touch fewer than both path components; otherwise it is part of the channel and is repainted.
    - After removing blockers, paint the channel component connected to the top edge teal and keep all other pixels unchanged.

    Key insight
    - The desired pixels are not found by region filling; they are the geometric overlap of the two paths' one-cell halos, with weakly attached control pixels splitting the channel.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    bg = get_bg(g)
    assert bg == Color.BLACK, "expected black background"

    path_color = _path_color(g, bg)
    path_labels, n_paths = label_mask(g == path_color, connectivity=4)
    assert n_paths == 2, "expected two path components"

    channel = g != path_color
    for label_id in range(1, n_paths + 1):
        channel &= binary_dilation(path_labels == label_id, structure=STRUCT8)
    assert np.any(channel), "expected a middle channel between the paths"

    blocked = []
    for r_raw, c_raw in np.argwhere(channel & (g != bg)):
        r = int(r_raw)
        c = int(c_raw)
        adjacent = _adjacent_path_labels(path_labels, r, c)
        assert adjacent, "control pixel in channel must touch a path component"
        if len(adjacent) < n_paths:
            blocked.append((r, c))
        else:
            assert len(adjacent) == n_paths, "channel control pixel cannot touch extra path labels"

    passable = channel.copy()
    for r, c in blocked:
        passable[r, c] = False

    channel_labels, n_channels = label_mask(passable, connectivity=4)
    assert n_channels >= 1, "expected at least one passable channel component"
    top_components = [
        label_id for label_id in range(1, n_channels + 1) if np.any(channel_labels[0, :] == label_id)
    ]
    assert len(top_components) == 1, "expected exactly one channel component connected to the top edge"

    paint = channel_labels == top_components[0]
    assert np.any(paint), "expected cells to paint"
    out = g.copy()
    out[paint] = Color.TEAL
    return out

# --------------- generator (o5x) ---------------

# Canvas and channel bounds.
GEN_GRID_SHAPE = (10, 10)
GEN_TOP_ROW = 0
GEN_BOTTOM_ROW = 9
GEN_LEFT_COL = 0
GEN_RIGHT_COL = 9
GEN_MIN_CHANNEL_COL = 1
GEN_MAX_CHANNEL_COL = 8

# Segment and turn sampling.
GEN_MIN_TURNS = 2
GEN_MAX_TURNS = 4
GEN_VERTICAL_MIN = 2
GEN_VERTICAL_MAX = 7
GEN_VERTICAL_TOTAL_MIN = 6
GEN_VERTICAL_TOTAL_MAX = 9
GEN_FULL_HEIGHT_TOTAL = 9
GEN_FULL_HEIGHT_PROB = 0.8
GEN_HORIZONTAL_MIN = 2
GEN_HORIZONTAL_MAX = 4
GEN_HORIZONTAL_BUDGET = 7

# Optional blocker placement.
GEN_BLOCKER_PROB = 0.6
GEN_BLOCKING_BLOCKER_PROB = 0.55

# Retry budget for rejected geometry.
GEN_RETRY_LIMIT = 300


def _gen_walk_segment(path, dr, dc, steps):
    r, c = path[-1]
    for _ in range(steps):
        r += dr
        c += dc
        path.append((r, c))


def _gen_directions(hdir, turns):
    directions = [(1, 0)]
    for i in range(turns):
        directions.append((0, hdir) if i % 2 == 0 else (1, 0))
    return directions


def _gen_partition_total(total, count, minimum, maximum):
    """Randomly split total into count bounded positive steps."""
    steps = []
    remaining = total
    for i in range(count - 1):
        rest = count - i - 1
        hi = min(maximum, remaining - minimum * rest)
        lo = max(minimum, remaining - maximum * rest)
        val = random.randint(lo, hi)
        steps.append(val)
        remaining -= val
    steps.append(remaining)
    return steps


def _gen_vertical_steps(directions):
    v_count = sum(1 for d in directions if d == (1, 0))
    if directions[-1] == (1, 0) and random.random() < GEN_FULL_HEIGHT_PROB:
        total = GEN_FULL_HEIGHT_TOTAL
    else:
        total = random.randint(GEN_VERTICAL_TOTAL_MIN, GEN_VERTICAL_TOTAL_MAX)
    return _gen_partition_total(total, v_count, GEN_VERTICAL_MIN, GEN_VERTICAL_MAX)


def _gen_horizontal_steps(h_count):
    steps = []
    remaining = GEN_HORIZONTAL_BUDGET
    for i in range(h_count):
        hi = min(GEN_HORIZONTAL_MAX, remaining - GEN_HORIZONTAL_MIN * (h_count - i - 1))
        step = random.randint(GEN_HORIZONTAL_MIN, hi)
        steps.append(step)
        remaining -= step
    return steps


def _gen_start_col(hdir, h_steps):
    total_h = sum(h_steps)
    if hdir == 1:
        return random.randint(GEN_MIN_CHANNEL_COL, GEN_MAX_CHANNEL_COL - total_h)
    return random.randint(GEN_MIN_CHANNEL_COL + total_h, GEN_MAX_CHANNEL_COL)


def _gen_channel_path():
    hdir = random.choice([-1, 1])
    turns = random.randint(GEN_MIN_TURNS, GEN_MAX_TURNS)
    directions = _gen_directions(hdir, turns)
    v_steps = _gen_vertical_steps(directions)
    h_steps = _gen_horizontal_steps(sum(1 for d in directions if d[0] == 0))
    start_c = _gen_start_col(hdir, h_steps)

    path = [(GEN_TOP_ROW, start_c)]
    vi = 0
    hi = 0
    for dr, dc in directions:
        if dr:
            steps = v_steps[vi]
            vi += 1
        else:
            steps = h_steps[hi]
            hi += 1
        _gen_walk_segment(path, dr, dc, steps)

    if any(
        r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_MIN_CHANNEL_COL or c > GEN_MAX_CHANNEL_COL
        for r, c in path
    ):
        return None
    return path


def _gen_left_normal(dr, dc):
    return -dc, dr


def _gen_wall_sets(path):
    left = set()
    right = set()
    channel = set(path)
    for i, (r, c) in enumerate(path):
        dirs = []
        if i > 0:
            pr, pc = path[i - 1]
            dirs.append((r - pr, c - pc))
        if i + 1 < len(path):
            nr, nc = path[i + 1]
            dirs.append((nr - r, nc - c))
        for dr, dc in dirs:
            lr, lc = _gen_left_normal(dr, dc)
            if (r + lr, c + lc) not in channel:
                left.add((r + lr, c + lc))
            if (r - lr, c - lc) not in channel:
                right.add((r - lr, c - lc))
        if len(dirs) == 2 and dirs[0] != dirs[1]:
            for side in (1, -1):
                offsets = []
                for dr, dc in dirs:
                    lr, lc = _gen_left_normal(dr, dc)
                    offsets.append((side * lr, side * lc))
                direct = [(r + dr, c + dc) for dr, dc in offsets]
                if all(cell not in channel for cell in direct):
                    er = r + offsets[0][0] + offsets[1][0]
                    ec = c + offsets[0][1] + offsets[1][1]
                    if side == 1:
                        left.add((er, ec))
                    else:
                        right.add((er, ec))
    return left, right


def _gen_mask_from_cells(cells):
    mask = np.zeros(GEN_GRID_SHAPE, dtype=bool)
    cells = list(cells)
    if cells:
        rows, cols = zip(*cells)
        mask[rows, cols] = True
    return mask


def _gen_paint_cells(grid, cells, color):
    cells = list(cells)
    if cells:
        rows, cols = zip(*cells)
        grid[rows, cols] = color


def _gen_is_thin_component(mask):
    comps = components_mask(mask, connectivity=4)
    if len(comps) != 1:
        return False
    cells = {tuple(map(int, xy)) for xy in comps[0]}
    for r, c in cells:
        deg = sum((rr, cc) in cells for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)))
        if deg > 2:
            return False
    return True


def _gen_channel_from_solver_geometry(grid):
    labels, n_paths = label_mask(grid == Color.ORANGE, connectivity=4)
    if n_paths != 2:
        return None, None

    channel = grid != Color.ORANGE
    for label_id in range(1, n_paths + 1):
        channel &= binary_dilation(labels == label_id, structure=STRUCT8)
    return channel, labels


def _gen_render_valid_walls(channel_path):
    """Render orange walls and verify they induce exactly the sampled channel."""
    channel_cells = set(channel_path)
    left, right = _gen_wall_sets(channel_path)
    if left & right or left & channel_cells or right & channel_cells:
        return None, None
    if any(r < GEN_TOP_ROW or r > GEN_BOTTOM_ROW or c < GEN_LEFT_COL or c > GEN_RIGHT_COL for r, c in left | right):
        return None, None

    grid = np.zeros(GEN_GRID_SHAPE, dtype=int)
    _gen_paint_cells(grid, left | right, Color.ORANGE)

    left_mask = _gen_mask_from_cells(left)
    right_mask = _gen_mask_from_cells(right)
    if not _gen_is_thin_component(left_mask) or not _gen_is_thin_component(right_mask):
        return None, None

    channel, labels = _gen_channel_from_solver_geometry(grid)
    if channel is None:
        return None, None
    expected_channel = _gen_mask_from_cells(channel_path)
    if not np.array_equal(channel, expected_channel):
        return None, None
    return grid, labels


def _gen_blocker_candidates(labels, channel_path):
    """Return turn blockers and straight pass-through blocker locations."""
    turn_cells = []
    straight_cells = []
    for i, (r, c) in enumerate(channel_path):
        if i == 0:
            continue
        adj = _adjacent_path_labels(labels, r, c)
        if len(adj) == 1:
            turn_cells.append((r, c))
        elif len(adj) == 2:
            straight_cells.append((r, c))
    return turn_cells, straight_cells


def _gen_maybe_place_blocker(grid, labels, channel_path):
    if random.random() < GEN_BLOCKER_PROB:
        turn_cells, straight_cells = _gen_blocker_candidates(labels, channel_path)
        if turn_cells and straight_cells:
            if random.random() < GEN_BLOCKING_BLOCKER_PROB:
                r, c = random.choice(turn_cells)
            else:
                r, c = random.choice(straight_cells)
            grid[r, c] = Color.MAROON


def _gen_oracle_accepts(grid):
    """Accept only grids whose solver output paints a top-connected channel."""
    try:
        out = main(grid)
    except Exception:
        return False
    return bool(np.any((out == Color.TEAL)[GEN_TOP_ROW, :]))


def _gen_attempt():
    channel_path = _gen_channel_path()
    if channel_path is None:
        return None

    grid, labels = _gen_render_valid_walls(channel_path)
    if grid is None:
        return None

    _gen_maybe_place_blocker(grid, labels, channel_path)
    if not _gen_oracle_accepts(grid):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid f1bcbc2c input")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste
import random


def _assert_solid_rectangle(g: np.ndarray, color: int, component: dict) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = map(int, component["bbox"])
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    assert int(component["area"]) == h * w, "foreground objects must be solid rectangles"
    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(color)), "rectangle bbox must be filled"
    return r0, c0, r1, c1


def _facing_corners(
    upper: tuple[int, int, int, int],
    lower: tuple[int, int, int, int],
) -> tuple[tuple[int, int], tuple[int, int]]:
    _ur0, uc0, ur1, uc1 = upper
    lr0, lc0, _lr1, lc1 = lower
    assert ur1 < lr0, "paired rectangles must be vertically separated"

    if uc1 < lc0:
        return (ur1, uc1), (lr0, lc0)
    if lc1 < uc0:
        return (ur1, uc0), (lr0, lc1)
    raise AssertionError("paired rectangles must be diagonally separated")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw the missing diagonal connector segment between each pair of same-color rectangular objects.

    Input structure:
    - The grid has one dominant background color.
    - Every foreground color appears as exactly two separated solid rectangular 4-connected objects.
    - The two rectangles of each color are diagonally offset with facing corners on a 45-degree line.

    Rule:
    - Keep all existing rectangles unchanged.
    - For each foreground color, connect the lower facing corner of the upper rectangle to the upper facing corner of the lower rectangle.
    - Paint only the intervening background pixels on that diagonal, excluding the two endpoint pixels already in the rectangles.

    Key insight:
    - Same-color rectangles define the endpoints; the output completes the open diagonal between their nearest facing corners.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    out = g.copy()

    for color in colors_present(g, exclude={bg}):
        components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color])
        assert len(components) == 2, "each foreground color must have exactly two objects"

        rectangles = [_assert_solid_rectangle(g, int(color), component) for component in components]
        rectangles.sort(key=lambda b: b[0])
        upper, lower = rectangles
        start, end = _facing_corners(upper, lower)

        row_delta = int(end[0] - start[0])
        col_delta = int(end[1] - start[1])
        assert row_delta > 0, "connector must go downward from the upper rectangle"
        assert abs(row_delta) == abs(col_delta), "facing corners must be diagonally aligned"

        dr = 1
        dc = 1 if col_delta > 0 else -1
        r, c = int(start[0] + dr), int(start[1] + dc)
        while (r, c) != end:
            assert int(out[r, c]) == bg, "connector path must pass through background"
            out[r, c] = int(color)
            r += dr
            c += dc

    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and palette.
BG, N = 7, 16
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]

# Pair sampling and rectangle spacing.
PAIR_COUNTS = [3, 4, 5]
PAIR_COUNT_WEIGHTS = [4, 10, 60]
LARGE_RECT_SIZE, SMALL_RECT_SIZE = 3, 2
MIN_RECT_GAP = 2

# Connector sampling and retry budget.
DIRECTIONS = [1, -1]
GAP_RANGE, MAX_ATTEMPTS = (2, 6), 300

Box = tuple[int, int, int, int]
Cells = list[tuple[int, int]]
Candidate = tuple[Box, Box, Cells]


def _bbox_gap_ok(a: Box, b: Box) -> bool:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    row_gap = max(ar0 - br1 - 1, br0 - ar1 - 1, 0)
    col_gap = max(ac0 - bc1 - 1, bc0 - ac1 - 1, 0)
    return max(row_gap, col_gap) >= MIN_RECT_GAP


def _rect_cells(box: Box) -> Cells:
    r0, c0, r1, c1 = box
    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]


def _candidate(
    size: int,
    direction: int,
    gap: int,
    ur: int,
    uc: int,
) -> Candidate | None:
    delta = gap + 1
    upper = (ur, uc, ur + size - 1, uc + size - 1)
    if direction == 1:
        start = (upper[2], upper[3])
        end = (start[0] + delta, start[1] + delta)
        lower = (end[0], end[1], end[0] + size - 1, end[1] + size - 1)
    else:
        start = (upper[2], upper[1])
        end = (start[0] + delta, start[1] - delta)
        lower = (end[0], end[1] - size + 1, end[0] + size - 1, end[1])

    if min(*upper, *lower) < 0 or max(upper[2], upper[3], lower[2], lower[3]) >= N:
        return None
    if not _bbox_gap_ok(upper, lower):
        return None
    diag = [(start[0] + k, start[1] + direction * k) for k in range(1, gap + 1)]
    return upper, lower, diag


def _valid_candidates(
    occupied: np.ndarray,
    existing_rects: list[Box],
    size: int,
    direction: int,
    gap: int,
) -> list[Candidate]:
    out = []
    for ur in range(N - size + 1):
        for uc in range(N - size + 1):
            cand = _candidate(size, direction, gap, ur, uc)
            if cand is None:
                continue
            upper, lower, diag = cand
            if any(not _bbox_gap_ok(box, old) for box in (upper, lower) for old in existing_rects):
                continue
            cells = _rect_cells(upper) + _rect_cells(lower) + diag
            if any(bool(occupied[r, c]) for r, c in cells):
                continue
            out.append(cand)
    random.shuffle(out)
    return out


def _place_rect(grid: np.ndarray, box: Box, color: int) -> None:
    r0, c0, r1, c1 = box
    grid[r0 : r1 + 1, c0 : c1 + 1] = color


def _sample_plan(n_pairs: int) -> tuple[list[int], list[int], list[int], list[int], list[int]]:
    colors = random.sample(FOREGROUND_COLORS, n_pairs)
    sizes = [LARGE_RECT_SIZE] + [SMALL_RECT_SIZE] * (n_pairs - 1)
    random.shuffle(sizes)
    directions = [1, -1] + [random.choice(DIRECTIONS) for _ in range(n_pairs - 2)]
    random.shuffle(directions)
    gaps = [random.randint(*GAP_RANGE) for _ in range(n_pairs)]
    order = list(range(n_pairs))
    random.shuffle(order)
    order.sort(key=lambda i: (sizes[i], gaps[i]), reverse=True)
    return colors, sizes, directions, gaps, order


def _gen_attempt() -> np.ndarray | None:
    n_pairs = random.choices(PAIR_COUNTS, weights=PAIR_COUNT_WEIGHTS, k=1)[0]
    colors, sizes, directions, gaps, order = _sample_plan(n_pairs)
    output = np.full((N, N), BG, dtype=int)
    occupied = np.zeros((N, N), dtype=bool)
    rects: list[Box] = []
    diagonals: list[Cells] = []

    for idx in order:
        cands = _valid_candidates(occupied, rects, sizes[idx], directions[idx], gaps[idx])
        if not cands:
            return None
        upper, lower, diag = random.choice(cands)
        color = colors[idx]
        _place_rect(output, upper, color)
        _place_rect(output, lower, color)
        for r, c in diag:
            output[r, c] = color
        for r, c in _rect_cells(upper) + _rect_cells(lower) + diag:
            occupied[r, c] = True
        rects.extend([upper, lower])
        diagonals.append(diag)

    inp = output.copy()
    for diag in diagonals:
        for r, c in diag:
            inp[r, c] = BG
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 342ae2ed input")
from __future__ import annotations
import numpy as np
from arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Sort scattered 4×4 squares into two columns by type: frames left, solids right.

    Input structure:
    - bg = most common color. Multiple 4×4 objects on bg.
    - Frames: colored 1px border, bg-filled 2×2 interior.
    - Solids: entirely filled with one non-bg color.

    Rule:
    - Classify each 4×4 object as frame or solid by its interior.
    - Sort each group top-to-bottom by input row.
    - Stack frames in left column (cols 0–3), solids in right (cols 4–7).
    - Output is 8 wide; height = 4 × max(#frames, #solids), bg-padded.

    Key insight: Frame vs solid is determined solely by whether the 2×2 interior matches bg.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    frames: list[tuple[int, int, np.ndarray]] = []
    solids: list[tuple[int, int, np.ndarray]] = []

    for comp in comps:
        b = comp["bbox"]
        if bbox_h(b) != 4 or bbox_w(b) != 4:
            continue
        r0, c0, _r1, _c1 = b
        sub = crop_bbox(g, b)

        border = np.concatenate([sub[0, :], sub[-1, :], sub[1:-1, 0], sub[1:-1, -1]])
        bcols = set(map(int, border.flatten()))

        if len(bcols) == 1 and bool((sub[1:3, 1:3] == int(bg)).all()):
            frames.append((int(r0), int(c0), sub))
        else:
            solids.append((int(r0), int(c0), sub))

    frames.sort(key=lambda t: (int(t[0]), int(t[1])))
    solids.sort(key=lambda t: (int(t[0]), int(t[1])))

    outH = 4 * max(int(len(frames)), int(len(solids)))
    outW = 8
    out = np.full((outH, outW), int(bg), dtype=int)

    for i, (_r0, _c0, sub) in enumerate(frames):
        paste(out, sub, int(i * 4), 0)
    for i, (_r0, _c0, sub) in enumerate(solids):
        paste(out, sub, int(i * 4), 4)

    return out


def _make_frame(col: int, bg: int = 0) -> np.ndarray:
    a = np.full((4, 4), col, dtype=int)
    a[1:3, 1:3] = bg
    return a

def _make_solid(col: int) -> np.ndarray:
    return np.full((4, 4), col, dtype=int)

def _gen_attempt() -> np.ndarray | None:
    bg = 0
    H = int(np.random.randint(18, 30))
    W = int(np.random.randint(18, 30))
    g = np.full((H, W), bg, dtype=int)
    n_frames = int(np.random.randint(1, 5))
    n_solids = int(np.random.randint(1, 5))
    try:
        used_cols: set[int] = set()
        for _ in range(n_frames):
            col = int(np.random.randint(1, 10))
            while col in used_cols:
                col = int(np.random.randint(1, 10))
            used_cols.add(col)
            r0, c0 = random_free_location(g, _make_frame(col, bg), transparent=bg, border=1, padding=1, padding_connectivity=4)
            paste(g, _make_frame(col, bg), r0, c0, transparent=bg)
        for _ in range(n_solids):
            col = int(np.random.randint(1, 10))
            while col in used_cols:
                col = int(np.random.randint(1, 10))
            used_cols.add(col)
            r0, c0 = random_free_location(g, _make_solid(col), transparent=bg, border=1, padding=1, padding_connectivity=4)
            paste(g, _make_solid(col), r0, c0, transparent=bg)
        return g
    except Exception:
        return None

def generate_input() -> np.ndarray:
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("generate_input failed after 300 attempts")



