+    forbidden = np.zeros(inp.shape, dtype=bool)
+
+    patches: list[tuple[np.ndarray, np.ndarray]] = []
+    patches.append(_make_geodesic_patch(background, NEUTRAL, marker_palette[0], marker_palette[1]))
