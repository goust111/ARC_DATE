+def _horizontal_complete() -> np.ndarray:
+    for _ in range(100):
+        h = random.choice((5, 7))
+        w = random.choice([n for n in range(5, 9) if n != h])
+        mid = h // 2
+        depths = [random.randint(0, mid) for _ in range(w)]
