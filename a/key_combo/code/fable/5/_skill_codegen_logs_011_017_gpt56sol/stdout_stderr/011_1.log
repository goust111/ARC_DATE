+    # Prove that completion cannot be replaced by sliding the damaged masks.
+    damaged = [dict(obj, coords=set(obj["input_coords"])) for obj in parsed]
+    try:
+        damaged_final, _r, _s = _settle(damaged, grid.shape)
+    except AssertionError:
