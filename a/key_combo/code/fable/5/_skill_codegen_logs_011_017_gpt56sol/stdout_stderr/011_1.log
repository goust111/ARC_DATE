+        unseen[sr, sc] = False
+        queue = deque([(sr, sc)])
+        cells: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if 0 <= rr < h and 0 <= cc < w and unseen[rr, cc]:
+                    unseen[rr, cc] = False
+                    queue.append((rr, cc))
