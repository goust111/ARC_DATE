+def _parse_examples(g: np.ndarray) -> tuple[np.ndarray, dict[int, tuple[Direction, int]]]:
+    """Read isolated two-pixel examples from the outer two rings."""
+    h, w = g.shape
+    assert h >= 7 and w >= 7, "the outer examples need a nonempty interior"
