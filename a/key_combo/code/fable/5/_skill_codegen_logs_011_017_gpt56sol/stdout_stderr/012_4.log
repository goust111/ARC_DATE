+    # internal object, whereas the landing color occurs only in the examples.
+    interior_colors = set(map(int, np.unique(g[2:-2, 2:-2]))) - {0}
+    rules: dict[int, tuple[Direction, int]] = {}
+    target_colors: set[int] = set()
