+
+def _outer_band(shape: tuple[int, int]) -> np.ndarray:
+    """Mask the outer two rings of a grid."""
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:2, :] = True
+    mask[-2:, :] = True
+    mask[:, :2] = True
+    mask[:, -2:] = True
+    return mask
