# Canvas and palette.
BG_COLOR = 0
GRID_ROWS = 12
GRID_COL_CHOICES = [12, 13]
COLORS = list(range(1, 10))

# L-sprite geometry.
LEG_LEN_MIN = 2
LEG_LEN_MAX = 4
MIN_BODY_PIXELS = 4
ORIENTATION_COUNT = 4
LEG_PAIRS = [
    (v_len, h_len)
    for v_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)
    for h_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)
    if v_len + h_len - 1 >= MIN_BODY_PIXELS
]

# Sprite/control counts and rates.
SPRITE_COUNT_MIN = 2
SPRITE_COUNT_MAX = 4
MIN_MOVED_SPRITES = 1
MAX_MOVED_SPRITES = 2
MAX_STATIONARY_SPRITES = 2
DISTRACTOR_PROBABILITY = 0.5

# Placement constraints and retry limits.
PLACEMENT_PADDING = 1
PLACEMENT_PADDING_CONNECTIVITY = 4
MIN_DIAGONAL_DISTANCE = 1
GENERATION_RETRIES = 300


def _make_l_sprite(body_color: int, marker_color: int) -> tuple[np.ndarray, tuple[int, int]]:
    v_len, h_len = random.choice(LEG_PAIRS)
    orient = random.randrange(ORIENTATION_COUNT)
    patch = np.zeros((v_len, h_len), dtype=int)

    bend_r = 0 if orient in (0, 1) else v_len - 1
    bend_c = 0 if orient in (0, 2) else h_len - 1
    patch[bend_r, :] = body_color
    patch[:, bend_c] = body_color

    marker_r = bend_r + (1 if bend_r == 0 else -1)
    marker_c = bend_c + (1 if bend_c == 0 else -1)
    patch[marker_r, marker_c] = marker_color
    return patch, (bend_r, bend_c)


def _marker_offset(
    patch: np.ndarray, bend: tuple[int, int], marker_color: int
) -> tuple[int, int]:
    marker_cells = np.argwhere(patch == marker_color)
    assert len(marker_cells) == 1
    mr, mc = map(int, marker_cells[0])
    return mr - bend[0], mc - bend[1]


def _erase_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
    h, w = patch.shape
    mask = patch != BG_COLOR
    grid[r0 : r0 + h, c0 : c0 + w][mask] = BG_COLOR


def _blocked_cells(grid: np.ndarray) -> np.ndarray:
    """Return cells where a foreground patch pixel would violate the gap rule."""
    blocked = grid != BG_COLOR
    for _ in range(PLACEMENT_PADDING):
        expanded = blocked.copy()
        expanded[1:, :] |= blocked[:-1, :]
        expanded[:-1, :] |= blocked[1:, :]
        expanded[:, 1:] |= blocked[:, :-1]
        expanded[:, :-1] |= blocked[:, 1:]
        if PLACEMENT_PADDING_CONNECTIVITY == 8:
            expanded[1:, 1:] |= blocked[:-1, :-1]
            expanded[1:, :-1] |= blocked[:-1, 1:]
            expanded[:-1, 1:] |= blocked[1:, :-1]
            expanded[:-1, :-1] |= blocked[1:, 1:]
        elif PLACEMENT_PADDING_CONNECTIVITY != 4:
            raise ValueError("placement padding connectivity must be 4 or 8")
        blocked = expanded
    return blocked


def _patch_fits(blocked: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
    rows, cols = blocked.shape
    h, w = patch.shape
    if r0 < 0 or c0 < 0 or r0 + h > rows or c0 + w > cols:
        return False
    patch_mask = patch != BG_COLOR
    return not bool((blocked[r0 : r0 + h, c0 : c0 + w] & patch_mask).any())


def _place_component(grid: np.ndarray, patch: np.ndarray) -> tuple[int, int] | None:
    try:
        r, c = random_free_location(
            grid,
            patch,
            transparent=BG_COLOR,
            padding=PLACEMENT_PADDING,
            padding_connectivity=PLACEMENT_PADDING_CONNECTIVITY,
        )
    except ValueError:
        return None
    paste(grid, patch, r, c, transparent=BG_COLOR)
    return r, c


def _choose_moved_indices(n_sprites: int) -> set[int]:
    min_moves = max(MIN_MOVED_SPRITES, n_sprites - MAX_STATIONARY_SPRITES)
    max_moves = min(MAX_MOVED_SPRITES, n_sprites)
    n_moves = random.randint(min_moves, max_moves)
    return set(random.sample(range(n_sprites), n_moves))


def _choose_marker_colors(body_colors: list[int]) -> list[int]:
    marker_colors = []
    for body in body_colors:
        choices = [c for c in COLORS if c != body and c not in marker_colors]
        marker_colors.append(random.choice(choices))
    return marker_colors


def _build_sprites(n_sprites: int) -> tuple[list[dict], list[int]]:
    body_colors = random.sample(COLORS, n_sprites)
    marker_colors = _choose_marker_colors(body_colors)
    sprites = []
    for body, marker in zip(body_colors, marker_colors):
        patch, bend = _make_l_sprite(body, marker)
        sprites.append(
            {
                "patch": patch,
                "bend": bend,
                "marker": marker,
                "marker_offset": _marker_offset(patch, bend, marker),
            }
        )
    return sprites, marker_colors


def _place_output_layout(
    rows: int, cols: int, sprites: list[dict], marker_colors: list[int]
) -> np.ndarray | None:
    """Place final sprites and annotate each with output location and target bend."""
    out = np.zeros((rows, cols), dtype=int)
    for idx in random.sample(range(len(sprites)), len(sprites)):
        loc = _place_component(out, sprites[idx]["patch"])
        if loc is None:
            return None
        r, c = loc
        br, bc = sprites[idx]["bend"]
        sprites[idx]["out_loc"] = loc
        sprites[idx]["target"] = (r + br, c + bc)

    if random.random() < DISTRACTOR_PROBABILITY:
        distractor_choices = [c for c in COLORS if c not in marker_colors]
        distractor = np.array([[random.choice(distractor_choices)]], dtype=int)
        if _place_component(out, distractor) is None:
            return None
    return out


def _place_aligned_input_sprite(grid: np.ndarray, sprite: dict) -> tuple[int, int] | None:
    patch = sprite["patch"]
    bend = sprite["bend"]
    marker_dr, marker_dc = sprite["marker_offset"]
    target_r, target_c = sprite["target"]
    rows, cols = grid.shape
    blocked = _blocked_cells(grid)

    candidates = []
    for dist in range(MIN_DIAGONAL_DISTANCE, max(rows, cols) + 1):
        bend_r = target_r + marker_dr * dist
        bend_c = target_c + marker_dc * dist
        r = bend_r - bend[0]
        c = bend_c - bend[1]
        if _patch_fits(blocked, patch, r, c):
            candidates.append((r, c))

    if not candidates:
        return None

    r, c = random.choice(candidates)
    paste(grid, patch, r, c, transparent=BG_COLOR)
    return r, c


def _derive_input_grid(out: np.ndarray, sprites: list[dict], moved: set[int]) -> np.ndarray | None:
    """Reverse selected output placements into input sprites plus control pixels."""
    inp = out.copy()
    for idx in moved:
        r, c = sprites[idx]["out_loc"]
        _erase_patch(inp, sprites[idx]["patch"], r, c)

    for idx in moved:
        r, c = sprites[idx]["target"]
        if inp[r, c] != BG_COLOR:
            return None
        inp[r, c] = sprites[idx]["marker"]

    for idx in random.sample(list(moved), len(moved)):
        if _place_aligned_input_sprite(inp, sprites[idx]) is None:
            return None
    return inp


def _oracle_checked_input(inp: np.ndarray, out: np.ndarray) -> np.ndarray | None:
    try:
        actual = main(inp)
    except AssertionError:
        return None
    return inp if np.array_equal(actual, out) else None


def _gen_attempt() -> np.ndarray | None:
    rows, cols = GRID_ROWS, random.choice(GRID_COL_CHOICES)
    n_sprites = random.randint(SPRITE_COUNT_MIN, SPRITE_COUNT_MAX)
    moved = _choose_moved_indices(n_sprites)
    sprites, marker_colors = _build_sprites(n_sprites)

    out = _place_output_layout(rows, cols, sprites, marker_colors)
    if out is None:
        return None

    inp = _derive_input_grid(out, sprites, moved)
    if inp is None:
        return None
    return _oracle_checked_input(inp, out)


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

from collections import deque

import numpy as np

from arc_utils import bbox, colors_present, draw_line, find_components, get_bg, is_contiguous, paste, random_free_location
import random


def _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    b = bbox(mask)
    if b is None:
        return None
    r0, c0, r1, c1 = b
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    if h < 3 or w < 3:
        return None

    expected = np.zeros_like(mask, dtype=bool)
    expected[r0 : r1 + 1, c0] = True
    expected[r0 : r1 + 1, c1] = True
    expected[r0, c0 : c1 + 1] = True
    expected[r1, c0 : c1 + 1] = True
    if not np.array_equal(mask, expected):
        return None
    return int(r0), int(c0), int(r1), int(c1)


def _scaled_index(i: int, src_len: int, dst_len: int) -> int:
    assert src_len >= 1 and dst_len >= 1, "axis lengths must be positive"
    if src_len == 1:
        assert dst_len == 1, "a one-pixel motif axis maps to a one-pixel interior axis"
        return 0
    assert dst_len >= 2, "multi-pixel motif axis needs a multi-pixel interior axis"
    return int(round(int(i) * (dst_len - 1) / (src_len - 1)))


def _fill_enclosed(stroke: np.ndarray) -> np.ndarray:
    h, w = stroke.shape
    open_space = ~stroke.astype(bool)
    padded = np.pad(open_space, 1, constant_values=True)
    seen = np.zeros_like(padded, dtype=bool)
    q: deque[tuple[int, int]] = deque()
    ph, pw = padded.shape

    for r in range(ph):
        for c in (0, pw - 1):
            if padded[r, c] and not seen[r, c]:
                seen[r, c] = True
                q.append((int(r), int(c)))
    for c in range(pw):
        for r in (0, ph - 1):
            if padded[r, c] and not seen[r, c]:
                seen[r, c] = True
                q.append((int(r), int(c)))

    while q:
        r, c = q.popleft()
        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True
                q.append((int(nr), int(nc)))

    holes = open_space & ~seen[1 : h + 1, 1 : w + 1]
    return stroke.astype(bool) | holes


def _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:
    src_h, src_w = sprite.shape
    dst_h, dst_w = target_shape
    assert sprite.any(), "expected a nonempty sprite"

    stroke = np.zeros((dst_h, dst_w), dtype=int)
    coords = np.argwhere(sprite)
    mapped: dict[tuple[int, int], tuple[int, int]] = {}
    for sr, sc in coords:
        tr = _scaled_index(int(sr), src_h, dst_h)
        tc = _scaled_index(int(sc), src_w, dst_w)
        mapped[(int(sr), int(sc))] = (tr, tc)
        stroke[tr, tc] = 1

    for sr, sc in coords:
        sr = int(sr)
        sc = int(sc)
        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):
            if (nr, nc) in mapped:
                r0, c0 = mapped[(sr, sc)]
                r1, c1 = mapped[(nr, nc)]
                draw_line(stroke, r0, c0, end_r=r1, end_c=c1, color=1)

    return _fill_enclosed(stroke.astype(bool))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the small colored sprite into the hollow frame by stretching its shape to the frame interior.

    Input structure:
    - The background is the dominant color.
    - There are exactly two foreground colors: one forms a complete rectangular
      one-pixel-thick frame, and the other forms one 4-connected sprite outside it.
    - The frame interior is initially background.

    Rule:
    - Clear the original sprite from its outside location.
    - Map the sprite bbox to the frame interior bbox, sending bbox extremes to
      interior extremes.
    - Draw straight horizontal or vertical segments between mapped positions of
      adjacent sprite pixels, then fill any enclosed background region inside
      those drawn segments.

    Key insight:
    The outside sprite is a miniature line/fill diagram for the frame interior,
    not a bitmap to scale by block replication.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected one frame color and one sprite color"

    frame_candidates: list[tuple[int, tuple[int, int, int, int]]] = []
    for color in colors:
        frame_bbox = _rect_frame_bbox(g == int(color))
        if frame_bbox is not None:
            frame_candidates.append((int(color), frame_bbox))
    assert len(frame_candidates) == 1, "expected a unique rectangular frame"

    frame_color, (fr0, fc0, fr1, fc1) = frame_candidates[0]
    sprite_color = next(color for color in colors if color != frame_color)
    sprite_components = find_components(g, bg=bg, colors=[sprite_color], connectivity=4)
    assert len(sprite_components) == 1, "expected a single 4-connected sprite"
    frame_region = np.zeros_like(g, dtype=bool)
    frame_region[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
    assert not np.any((g == sprite_color) & frame_region), "sprite must start outside the frame"

    sr0, sc0, sr1, sc1 = sprite_components[0]["bbox"]
    sprite = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == sprite_color

    ir0, ic0 = fr0 + 1, fc0 + 1
    ir1, ic1 = fr1 - 1, fc1 - 1
    assert ir0 <= ir1 and ic0 <= ic1, "frame must have an interior"
    interior = g[ir0 : ir1 + 1, ic0 : ic1 + 1]
    assert np.all(interior == bg), "frame interior must start empty"

    stretched = _stretch_sprite(sprite, (ir1 - ir0 + 1, ic1 - ic0 + 1))
    out = g.copy()
    out[g == sprite_color] = bg
    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = sprite_color
    return out

