from __future__ import annotations

import numpy as np

from arc_utils import Color
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.

    Input structure:
    - The grid is an even square split into four equal quadrants.
    - Black is the background.
    - The upper-left and upper-right quadrants are control regions.
    - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.

    Rule:
    - Output height is the number of non-background pixels in the upper-left quadrant.
    - Output width is the number of non-background pixels in the upper-right quadrant.
    - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.
    - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.

    Key insight:
    - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h == w and h % 2 == 0 and w % 2 == 0

    bg = int(Color.BLACK)
    qh, qw = h // 2, w // 2
    upper_left = g[:qh, :qw]
    upper_right = g[:qh, qw:]
    fill_tile = g[qh:, :qw]
    stencil = g[qh:, qw:]

    out_h = int(np.count_nonzero(upper_left != bg))
    out_w = int(np.count_nonzero(upper_right != bg))
    assert out_h > 0 and out_w > 0

    out = np.empty((out_h, out_w), dtype=int)
    if not np.any(stencil != bg):
        for r in range(out_h):
            for c in range(out_w):
                value = int(fill_tile[r % qh, c % qw])
                assert value != bg
                out[r, c] = value
        return out

    for r in range(out_h):
        for c in range(out_w):
            value = int(stencil[r % qh, c % qw])
            if value == bg:
                fill_r = r // qh
                fill_c = c // qw
                assert fill_r < qh and fill_c < qw
                value = int(fill_tile[fill_r, fill_c])
                assert value != bg
            out[r, c] = value

    return out

# --------------- generator (o5x) ---------------

from math import ceil

# ── configuration constants ──────────────────────────────────────────
BLACK = 0
COLORS = tuple(range(1, 10))

GRID_SIZES = (4, 8, 16)                # allowed input grid side-lengths N
STENCIL_EMPTY_PROB = 0.16               # chance lower-right is all-black
LL_SOLID_PROB = 0.70                    # chance fill tile is single-color
LL_MULTI_COLOR_RANGE = (2, 3)           # color count when fill tile is multi-color
STENCIL_SINGLE_COLOR_PROB = 0.75        # chance stencil uses one fg color
STENCIL_MULTI_COLOR_RANGE = (2, 4)      # color count when stencil is multi-color
STENCIL_FG_FRAC = (0.30, 0.75)          # fg fraction range for random stencil mode
STENCIL_FRAME_MIN_Q = 4                 # min quadrant size to allow frame stencil
CONTROL_SINGLE_COLOR_PROB = 0.85        # chance control quadrant uses one color
CONTROL_RECT_PROB = 0.85                # chance control pixels form an axis-aligned rect
UL_MAX_COLORS = 3                       # max distinct colors in upper-left control
UR_MAX_COLORS = 2                       # max distinct colors in upper-right control
OUTPUT_DIM_MIN = 3                      # minimum output height/width
OUTPUT_DIM_MAX = 16                     # maximum output height/width
OUTPUT_AREA_MAX = 256                   # maximum output area
GEN_MAX_RETRIES = 300                   # retry budget for generate_input


# ── palette helpers ──────────────────────────────────────────────────

def _palette(k: int, pool=COLORS) -> list[int]:
    """Return k distinct colors sampled from pool."""
    pool = list(pool)
    random.shuffle(pool)
    return pool[:k]


def _random_color_array(shape: tuple[int, ...], palette: list[int]) -> np.ndarray:
    """Fill an array by drawing each cell independently from palette."""
    return np.array([random.choice(palette) for _ in range(int(np.prod(shape)))],
                    dtype=int).reshape(shape)


# ── coordinate orderings for control quadrant ────────────────────────

def _ordered_coords(q: int, mode: str) -> list[tuple[int, int]]:
    """Return all (r,c) in a qxq grid in a layout-dependent order."""
    coords = [(r, c) for r in range(q) for c in range(q)]
    if mode == "rect":
        r0, c0 = random.randint(0, q - 1), random.randint(0, q - 1)
        return [((r + r0) % q, (c + c0) % q) for r, c in coords]
    if mode == "rows":
        rows, cols = list(range(q)), list(range(q))
        random.shuffle(rows)
        random.shuffle(cols)
        return [(r, c) for r in rows for c in cols]
    if mode == "compact":
        ar, ac = random.randrange(q), random.randrange(q)
        random.shuffle(coords)
        return sorted(coords, key=lambda rc: (abs(rc[0] - ar) + abs(rc[1] - ac), random.random()))
    # fallback
    random.shuffle(coords)
    return coords


# ── quadrant builders ────────────────────────────────────────────────

def _make_lower_left(q: int, palette: list[int],
                     required_coords: list[tuple[int, int]] | None = None) -> np.ndarray:
    """Build the fill tile (all non-black) using stripe/solid/diagonal patterns."""
    k = len(palette)
    tile = np.empty((q, q), dtype=int)
    mode = "solid" if k == 1 else random.choice(["rows", "cols", "rows", "cols", "diagonal"])

    if mode == "solid":
        tile[:] = palette[0]
    elif mode == "rows":
        offset = random.randrange(k)
        for r in range(q):
            tile[r, :] = palette[(r + offset) % k]
    elif mode == "cols":
        offset = random.randrange(k)
        for c in range(q):
            tile[:, c] = palette[(c + offset) % k]
    elif mode == "diagonal":
        offset = random.randrange(k)
        rr, cc = np.mgrid[:q, :q]
        idx = (rr + cc + offset) % k
        for i, color in enumerate(palette):
            tile[idx == i] = color

    # ensure every palette color appears at least once
    existing = set(map(int, np.unique(tile)))
    missing = [c for c in palette if c not in existing]
    if missing:
        fix_coords = list(required_coords) if required_coords is not None else \
            [(r, c) for r in range(q) for c in range(q)]
        random.shuffle(fix_coords)
        for color, (r, c) in zip(missing, fix_coords):
            tile[r, c] = color
    return tile


def _make_stencil(q: int, palette: list[int]) -> np.ndarray:
    """Build the stencil tile (black = holes filled from fill tile)."""
    tile = np.zeros((q, q), dtype=int)
    modes = ["checker", "row_stripe", "col_stripe", "random", "random"]
    if q >= STENCIL_FRAME_MIN_Q:
        modes.append("frame")
    mode = random.choice(modes)

    if mode == "checker":
        parity = random.randrange(2)
        mask = (np.arange(q)[:, None] + np.arange(q)[None, :]) % 2 == parity
        tile[mask] = _random_color_array((int(mask.sum()),), palette)
    elif mode == "frame":
        t = random.randint(1, max(1, q // 4))
        mask = np.ones((q, q), dtype=bool)
        mask[t:q - t, t:q - t] = False
        tile[mask] = _random_color_array((int(mask.sum()),), palette)
    elif mode == "row_stripe":
        parity = random.randrange(2)
        for r in range(q):
            if r % 2 == parity:
                tile[r, :] = _random_color_array((q,), palette)
    elif mode == "col_stripe":
        parity = random.randrange(2)
        for c in range(q):
            if c % 2 == parity:
                tile[:, c] = _random_color_array((q,), palette)
    else:  # random scatter
        area = q * q
        lo = max(1, int(ceil(STENCIL_FG_FRAC[0] * area)))
        hi = max(lo, int(STENCIL_FG_FRAC[1] * area))
        fg_count = random.randint(lo, hi)
        coords = [(r, c) for r in range(q) for c in range(q)]
        random.shuffle(coords)
        for r, c in coords[:fg_count]:
            tile[r, c] = random.choice(palette)
    return tile


def _make_control(q: int, count: int, max_colors: int, pool: list[int]) -> np.ndarray:
    """Build a control quadrant with exactly `count` non-black pixels."""
    k = 1 if random.random() < CONTROL_SINGLE_COLOR_PROB else \
        random.randint(2, min(max_colors, count, len(pool)))
    pal = _palette(k, pool)
    tile = np.full((q, q), BLACK, dtype=int)

    factors = [(h, w) for h in range(1, q + 1) for w in range(1, q + 1) if h * w == count]
    if factors and random.random() < CONTROL_RECT_PROB:
        h, w = random.choice(factors)
        r0 = random.randint(0, q - h)
        c0 = random.randint(0, q - w)
        tile[r0:r0 + h, c0:c0 + w] = _random_color_array((h, w), pal)
    else:
        mode = random.choice(["rect", "compact", "rows"])
        coords = _ordered_coords(q, mode)[:count]
        for r, c in coords:
            tile[r, c] = random.choice(pal)
    return tile


# ── oracle / assembly ────────────────────────────────────────────────

def _expected_output(fill_tile: np.ndarray, stencil: np.ndarray,
                     out_h: int, out_w: int) -> np.ndarray:
    """Reproduce the solver's tiling logic for oracle validation."""
    q = fill_tile.shape[0]
    rr, cc = np.mgrid[:out_h, :out_w]
    if not np.any(stencil != BLACK):
        return fill_tile[rr % q, cc % q]
    tiled = stencil[rr % q, cc % q]
    bg_mask = tiled == BLACK
    tiled[bg_mask] = fill_tile[rr[bg_mask] // q, cc[bg_mask] // q]
    return tiled


def _gen_attempt() -> np.ndarray | None:
    """Try once to produce a valid grid; return None on failure."""
    n = random.choice(GRID_SIZES)
    q = n // 2
    stencil_empty = random.random() < STENCIL_EMPTY_PROB

    # -- palettes --
    ll_k = 1 if random.random() < LL_SOLID_PROB else random.randint(*LL_MULTI_COLOR_RANGE)
    ll_palette = _palette(ll_k)
    if stencil_empty:
        stencil_palette = []
    else:
        st_k = 1 if random.random() < STENCIL_SINGLE_COLOR_PROB else \
            random.randint(*STENCIL_MULTI_COLOR_RANGE)
        stencil_palette = _palette(st_k)

    output_colors = set(ll_palette) | set(stencil_palette)
    control_pool = [c for c in COLORS if c not in output_colors]
    if not control_pool:
        return None

    # -- output dimensions --
    lo = max(OUTPUT_DIM_MIN, q)
    hi = min(OUTPUT_DIM_MAX, q * q)
    valid_dims = [
        (h, w) for h in range(lo, hi + 1) for w in range(lo, hi + 1)
        if h * w <= OUTPUT_AREA_MAX and (stencil_empty or ceil(h / q) * ceil(w / q) >= ll_k)
    ]
    if not valid_dims:
        return None
    out_h, out_w = random.choice(valid_dims)

    # -- build quadrants --
    used_fill = [(r, c) for r in range(ceil(out_h / q)) for c in range(ceil(out_w / q))]
    fill_tile = _make_lower_left(q, ll_palette, used_fill)
    stencil = np.zeros((q, q), dtype=int) if stencil_empty else _make_stencil(q, stencil_palette)
    upper_left = _make_control(q, out_h, UL_MAX_COLORS, control_pool)
    upper_right = _make_control(q, out_w, UR_MAX_COLORS, control_pool)

    # -- assemble & validate --
    grid = np.zeros((n, n), dtype=int)
    grid[:q, :q] = upper_left
    grid[:q, q:] = upper_right
    grid[q:, :q] = fill_tile
    grid[q:, q:] = stencil

    expected = _expected_output(fill_tile, stencil, out_h, out_w)
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg
import random


def _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:
    rows: list[tuple[int, int]] = []
    for r in range(g.shape[0]):
        row_colors = set(map(int, g[r]))
        if len(row_colors) == 1:
            color = next(iter(row_colors))
            if int(color) != int(bg):
                rows.append((int(r), int(color)))
    assert len(rows) == 1, "expected exactly one solid non-background divider row"
    return rows[0]


def _unique_widest_row(coords: np.ndarray) -> int:
    row_counts: list[tuple[int, int]] = []
    for r in sorted(set(map(int, coords[:, 0]))):
        row_cols = np.sort(coords[coords[:, 0] == r, 1])
        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))
        row_counts.append((int(row_cols.size), int(r)))

    max_count = max(count for count, _r in row_counts)
    widest = [r for count, r in row_counts if count == max_count]
    assert max_count > 1, "multi-column sprites must have a horizontal span"
    assert len(widest) == 1, "expected a unique widest horizontal row"
    return int(widest[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.

    Input structure:
    - The background is the dominant color.
    - One non-background color forms a single full-width horizontal divider row.
    - The other non-background color forms 4-connected sprites above the divider.

    Rule:
    - Clear the original sprite pixels.
    - A one-column sprite falls to the bottom of its column and deletes the divider
      pixel it crossed.
    - Any wider sprite falls until its unique widest horizontal row is immediately
      above the divider row; if the moved sprite overlaps the divider, it covers it.

    Key insight:
    The red row is not a generic floor: only one-column sprites pass through to the
    bottom, while wider sprites are registered by their widest horizontal segment.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))
    line_r, line_color = _divider_row(g, bg)

    non_bg_colors = set(map(int, g.ravel())) - {bg}
    sprite_colors = non_bg_colors - {line_color}
    assert len(sprite_colors) == 1, "expected exactly one sprite color"
    sprite_color = next(iter(sprite_colors))

    sprites = find_components(
        g,
        bg=bg,
        colors=[sprite_color],
        connectivity=4,
        monochromatic=True,
    )
    assert sprites, "expected at least one sprite"

    out = g.copy()
    out[g == sprite_color] = bg
    occupied = np.zeros((H, W), dtype=bool)

    for sprite in sprites:
        coords = sprite["coords"]
        _r0, c0, r1, c1 = map(int, sprite["bbox"])
        assert r1 < line_r, "all sprites must begin above the divider"

        if c0 == c1:
            shift = H - 1 - r1
            assert shift >= 0
            assert int(out[line_r, c0]) == line_color
            out[line_r, c0] = bg
        else:
            widest_r = _unique_widest_row(coords)
            shift = line_r - 1 - widest_r
            assert shift >= 0

        moved = coords.copy()
        moved[:, 0] += shift
        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))
        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))

        for rr, cc in moved:
            r = int(rr)
            c = int(cc)
            assert not occupied[r, c], "moved sprites must not overlap"
            occupied[r, c] = True
            out[r, c] = sprite_color

    return out

# --------------- generator (att2) ---------------

# Canvas, palette, and divider bounds.
MIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18
LARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3
ADJACENT_ROW_OFFSET = 1

# Sprite counts, spacing, and retry limits.
MIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5
MAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3
GAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1
GENERATION_RETRIES = 300

# Sprite geometry.
MIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5
SINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3
WIDE_MULTI_PROB = 0.5


def _composition(total: int, parts: int) -> list[int]:
    shares = [0] * parts
    for _ in range(total):
        shares[random.randrange(parts)] += 1
    return shares


def _min_layout_width(n_single: int, n_multi: int) -> int:
    n = n_single + n_multi
    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)


def _count_pairs(width: int) -> list[tuple[int, int]]:
    pairs: list[tuple[int, int]] = []
    for n_single in range(MAX_SINGLE_SPRITES + 1):
        for n_multi in range(MAX_MULTI_SPRITES + 1):
            n = n_single + n_multi
            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:
                pairs.append((n_single, n_multi))
    return pairs


def _place_intervals(widths: list[int], grid_width: int) -> list[int]:
    n = len(widths)
    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)
    extra = grid_width - base
    assert extra >= 0
    gaps = _composition(extra, n + 1)

    starts: list[int] = []
    c = gaps[0]
    for i, width in enumerate(widths):
        starts.append(c)
        c += width
        if i < n - 1:
            c += GAP_COLUMNS + gaps[i + 1]
    return starts


def _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:
    coords = {(top + r, left + spine_col) for r in range(height)}
    coords.update((top + bar_row, left + c) for c in range(width))
    return np.array(sorted(coords), dtype=int)


def _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:
    descriptors: list[dict[str, int | str]] = []
    for _ in range(n_single):
        descriptors.append(
            {"kind": "single", "width": SINGLE_WIDTH, "height": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}
        )

    extra_width = grid_width - _min_layout_width(n_single, n_multi)
    for _ in range(n_multi):
        width = MIN_MULTI_WIDTH
        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:
            width = MAX_MULTI_WIDTH
            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH
        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)
        descriptors.append(
            {
                "kind": "multi",
                "width": width,
                "height": height,
                "bar_row": random.randint(0, height - ADJACENT_ROW_OFFSET),
                "spine_col": random.randrange(width),
            }
        )

    random.shuffle(descriptors)
    return descriptors


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)
    W = H
    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)
    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))
    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]
    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]

    pairs = _count_pairs(W)
    if not pairs:
        return None
    n_single, n_multi = random.choice(pairs)

    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)
    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)
    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):
        return None

    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)
    starts = _place_intervals([int(d["width"]) for d in descriptors], W)

    inp = np.full((H, W), bg, dtype=int)
    out = np.full((H, W), bg, dtype=int)
    inp[divider_r, :] = divider_color
    out[divider_r, :] = divider_color

    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET
    for desc, left in zip(descriptors, starts):
        height = int(desc["height"])
        width = int(desc["width"])
        if desc["kind"] == "single":
            col = left
            out[divider_r, col] = bg
            out[H - height : H, col] = sprite_color

            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)
            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color
            continue

        bar_row = int(desc["bar_row"])
        spine_col = int(desc["spine_col"])
        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row
        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)
        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):
            return None
        out[landed[:, 0], landed[:, 1]] = sprite_color

        landed_bottom = int(landed[:, 0].max())
        min_shift = landed_bottom - input_max_bottom
        max_shift = landed_top
        if min_shift > max_shift:
            return None
        shift = random.randint(min_shift, max_shift)
        original = landed.copy()
        original[:, 0] -= shift
        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):
            return None
        inp[original[:, 0], original[:, 1]] = sprite_color

    bg_count = int(np.count_nonzero(inp == bg))
    if bg_count <= int(np.count_nonzero(inp == divider_color)):
        return None
    if bg_count <= int(np.count_nonzero(inp == sprite_color)):
        return None

    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 84ba50d3 input")

