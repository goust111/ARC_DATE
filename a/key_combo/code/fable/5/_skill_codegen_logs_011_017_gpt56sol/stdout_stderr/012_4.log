+                "stop_kind": stop_kind,
+                "front_initial": front_initial,
+                "rear_initial": rear_initial,
+                "front_final": front_final,
+                "rear_final": rear_final,
+                "obstacle": obstacle,
+                "sweep": sweep,
+                "wrong_final": wrong,
+            }
