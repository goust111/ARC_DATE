+def _marker_candidates(
+    shape: tuple[int, int], direction: Direction, forbidden: set[Coord]
+) -> list[tuple[Coord, Coord]]:
+    h, w = shape
+    band = _outer_band(shape)
+    dr, dc = direction
+    candidates: list[tuple[Coord, Coord]] = []
+    for r in range(h):
+        for c in range(w):
