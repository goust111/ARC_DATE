+    result: list[np.ndarray] = []
+    for r0, c0 in np.argwhere(mask):
+        r0, c0 = int(r0), int(c0)
+        if seen[r0, c0]:
+            continue
+        seen[r0, c0] = True
+        queue: deque[Coord] = deque([(r0, c0)])
+        cells: list[Coord] = []
