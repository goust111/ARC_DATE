+
+
+def _terminal_order(obj: dict, direction: Direction, shape: tuple[int, int]) -> tuple[int, ...]:
+    """Order by distance to the directed grid edge, then only by visible coordinates."""
+    r0, c0, r1, c1 = obj["bbox"]
+    h, w = shape
+    if direction == UP:
+        distance = r0
+        tie = (c0, c1, r0, r1)
+    elif direction == DOWN:
+        distance = h - 1 - r1
+        tie = (c0, c1, -r1, -r0)
