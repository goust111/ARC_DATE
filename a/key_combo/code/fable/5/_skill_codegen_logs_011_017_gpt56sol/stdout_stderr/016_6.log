+            frontier.clear()
+            for r, c in cells:
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < canvas_h and 0 <= nc < canvas_w and (nr, nc) not in cells:
