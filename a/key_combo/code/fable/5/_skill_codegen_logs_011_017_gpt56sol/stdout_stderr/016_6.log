+    result: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r, c = int(r), int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        queue = deque([(r, c)])
+        cells: list[tuple[int, int]] = []
+        while queue:
+            rr, cc = queue.popleft()
+            cells.append((rr, cc))
+            for dr, dc in steps:
