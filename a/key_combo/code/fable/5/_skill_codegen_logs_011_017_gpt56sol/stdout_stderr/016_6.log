+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    """Return foreground components as (N, 2) arrays of canonical (row, col) coordinates."""
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    if connectivity == 4:
+        steps = ((-1, 0), (1, 0), (0, -1), (0, 1))
+    else:
+        steps = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr, dc) != (0, 0)
+        )
+
+    result: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r, c = int(r), int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        queue = deque([(r, c)])
+        cells: list[tuple[int, int]] = []
+        while queue:
+            rr, cc = queue.popleft()
+            cells.append((rr, cc))
+            for dr, dc in steps:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        result.append(np.asarray(cells, dtype=int))
+    return result
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    """Inclusive bounding box in (r0, c0, r1, c1) order."""
+    lo = coords.min(axis=0)
+    hi = coords.max(axis=0)
+    return int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])
+
+
+def _local_mask(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
