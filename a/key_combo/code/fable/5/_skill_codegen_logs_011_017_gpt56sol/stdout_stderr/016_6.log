+        seen[r, c] = True
+        queue = deque([(r, c)])
+        cells: list[tuple[int, int]] = []
+        while queue:
+            rr, cc = queue.popleft()
+            cells.append((rr, cc))
+            for dr, dc in steps:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        result.append(np.asarray(cells, dtype=int))
+    return result
