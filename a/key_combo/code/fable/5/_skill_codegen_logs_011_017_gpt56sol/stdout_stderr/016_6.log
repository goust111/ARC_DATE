+    r0, c0, r1, c1 = candidate
+    er0, ec0, er1, ec1 = existing
+    return (
+        r1 + gap <= er0
+        or er1 + gap <= r0
+        or c1 + gap <= ec0
+        or ec1 + gap <= c0
+    )
+
+
+def _place_patches(
+    shapes: list[tuple[int, int]], h: int, w: int, rng: np.random.Generator
