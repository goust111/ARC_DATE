+    coords = np.argwhere(mask)
+    assignments = palette * 2
+    assignments.extend(
+        int(palette[int(rng.integers(len(palette)))])
+        for _ in range(len(coords) - len(assignments))
+    )
+    rng.shuffle(assignments)
