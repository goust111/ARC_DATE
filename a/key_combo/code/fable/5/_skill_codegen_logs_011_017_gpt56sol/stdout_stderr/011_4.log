+        color = int(spec["color"])
+        s = int(spec["sum"])
+        arm = _arm_length(s)
+        for d in range(arm):
+            inp[_from_local(corner, d, 0, inp.shape)] = color
+            inp[_from_local(corner, 0, d, inp.shape)] = color
+        for u in _sample_offsets(s):
+            inp[_from_local(corner, u, s - u, inp.shape)] = color
