+def _well_separated(
+    candidate: set[tuple[int, int]], existing: set[tuple[int, int]], padding: int = 2
+) -> bool:
+    if not existing:
+        return True
+    for r, c in candidate:
+        for rr, cc in existing:
+            if max(abs(r - rr), abs(c - cc)) <= padding:
+                return False
+    return True
+
