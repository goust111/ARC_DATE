# --------------- generator (markers-first SAv4_mine: weighted sampling + fjord→island, 58% n=2) ---------------
# Markers-first construction: pick markers, build band with lobe to embed them,
# optionally carve fjord→island to create INTERIOR separator (25%), place template
# + end_block, run solver as oracle.

import random
from arc_utils import label_mask


def _build_band(H: int, W: int, lobe_rows: list[int] | None = None) -> np.ndarray:
    """Return a boolean mask for a thick meandering anti-diagonal band.

    Row 0's path span is in the rightmost cols (c_left[0] >= W-6, c_right[0] = W-1).
    Row H-1's path span is in the leftmost cols (c_left[H-1] = 0, c_right[H-1] <= 5).
    The band widens toward the middle and is 4-connected row-by-row.

    If `lobe_rows` is given, the band extends to col 0 across the CONTIGUOUS
    span [min(lobe_rows)-1, max(lobe_rows)+1] (inclusive), forming a single
    lobe that covers each marker's col-0 neighborhood. Outside that span,
    c_left gradients up at 2 cols/row. Baked into the parametric centerline
    so jitter/smoothing treat the lobe as part of the band's natural shape.

    Template area (rows 1-3) stays clear (c_left >= 12) so 2x2 blocks fit.
    """
    # Parametric centerline (anti-diagonal) and halfwidth profile.
    # Right-edge variation: bottom endpoint of centerline can shift right from
    # 0 up to W//4, which pushes c_right at lower rows rightward (band's right
    # edge stays higher longer instead of always collapsing to the left corner).
    # c_left is protected by marker-lobe + anchor, so this only expands right
    # edge — matches user's "only shift right, not left" requirement.
    bot_center = random.randint(0, W // 4)
    centers = np.linspace(W - 1, bot_center, H).astype(float)
    half_w = np.array([
        0.5 * (3 + (1.0 - abs(2.0 * r / max(1, H - 1) - 1.0)) * (W - 6))
        for r in range(H)
    ])

    c_left = np.zeros(H, dtype=int)
    c_right = np.zeros(H, dtype=int)

    # Smooth jitter: kernel=3 moving-average keeps adjacent-row jitter correlated
    # (independent ±3 jitter otherwise creates 1-cell bg notches in flat regions).
    cc_jit = np.convolve(
        np.array([random.randint(-3, 3) for _ in range(H)], dtype=float),
        np.ones(3) / 3, mode='same')
    w_jit = np.convolve(
        np.array([random.randint(-3, 3) for _ in range(H)], dtype=float),
        np.ones(3) / 3, mode='same')

    for r in range(H):
        c_left_param = centers[r] - half_w[r]
        if c_left_param <= 0:
            # "Flat left edge" row: band reaches/passes col 0 (inside lobe span
            # or natural band bottom). No left-edge jitter to avoid 1-cell notches.
            c_left[r] = 0
            c_right[r] = int(round(centers[r] + cc_jit[r] + half_w[r] + w_jit[r] / 2))
        else:
            # Slope row: legitimate c_left > 0; symmetric jitter.
            w = max(2, min(W, int(round(2 * half_w[r] + w_jit[r]))))
            cc = centers[r] + cc_jit[r]
            c_left[r] = int(round(cc - w / 2))
            c_right[r] = c_left[r] + w - 1

    # Lobe constraint: c_left = 0 from above the upper marker all the way to
    # H-1 (band reaches col 0 across the lower portion). lmax is set to H-1
    # rather than max(lobe_rows)+1 so the gradient between max(lobe_rows)+1 and
    # the bottom anchor doesn't form a spurious V-shaped bg notch — anchor
    # already forces c_left[H-1]=0, so the lobe should extend to meet it
    # naturally. Fjord carve creates the separator inside this lobe band.
    if lobe_rows:
        lmin = min(lobe_rows) - 1
        lmax = H - 1
        for r in range(H):
            d_outside = max(0, lmin - r, r - lmax)
            c_left[r] = min(c_left[r], 2 * d_outside)

    # Template area (rows 1-3): force c_left >= 12 so 2x2 blocks at cols {1,4,7,10}
    # have bg to sit on. Post-jitter because jitter could otherwise push c_left <12.
    for r in range(1, min(4, H)):
        c_left[r] = max(c_left[r], 12)
        if c_right[r] < c_left[r]:
            c_right[r] = c_left[r]

    # Anchor top to right corner; bottom c_left must be 0 but c_right takes
    # the shifted parametric (bot_center-dependent), clamped to grid only.
    c_right[0] = W - 1
    c_left[0] = max(c_left[0], W - 6)
    c_left[H - 1] = 0
    c_right[H - 1] = max(5, min(W - 1, c_right[H - 1]))

    # Remove 1-row c_left spikes in slope region (local maxima sandwiched by
    # lower neighbors). Flat rows (c_left=0) aren't affected since they're
    # already minimal.
    for _ in range(2):
        for r in range(1, H - 1):
            if c_left[r] > c_left[r - 1] and c_left[r] > c_left[r + 1]:
                c_left[r] = max(c_left[r - 1], c_left[r + 1])

    # Enforce row-to-row 4-connectivity + mostly-monotone leftward motion.
    for r in range(1, H):
        c_left[r] = min(c_left[r], c_left[r - 1] + 2)
        c_right[r] = min(c_right[r], c_right[r - 1] + 2)
        if c_left[r] > c_right[r - 1]:
            c_left[r] = c_right[r - 1]
        if c_right[r] < c_left[r - 1]:
            c_right[r] = c_left[r - 1]
        if c_right[r] < c_left[r]:
            c_right[r] = c_left[r]

    c_left = np.clip(c_left, 0, W - 1)
    c_right = np.clip(c_right, 0, W - 1)
    c_right[0] = W - 1
    c_left[H - 1] = 0

    mask = np.zeros((H, W), dtype=bool)
    for r in range(H):
        mask[r, c_left[r]:c_right[r] + 1] = True
    return mask


def _carve_fjord(mask: np.ndarray, r1: int, r2: int) -> bool:
    """Carve a bg 'fjord' biting into the band from col 0, between marker rows.

    The fjord is 2-3 rows tall at col 0 (strictly between r1 and r2), and
    extends rightward. As we go right, the fjord's top row decreases (slopes
    up-right, parallel to the band direction). The fjord stops before breaking
    the band's 4-connectivity.

    Mutates `mask` in place. Returns True if a valid carve was made; False otherwise
    (caller must use a pre-carve copy to restore on failure).
    """
    H, W = mask.shape
    sep_h = random.randint(2, 3)
    # Start rows in col 0 strictly between markers.
    sr_min = r1 + 2
    sr_max = r2 - 1 - sep_h
    if sr_max < sr_min:
        return False
    sr = random.randint(sr_min, sr_max)

    # Determine max reach: stop before disconnecting band. We probe one col at a time.
    cur_top = sr
    last_good = mask.copy()
    made_carve = False
    carved_cols = 0
    for k in range(W - 1):
        # Try to carve [cur_top, cur_top + sep_h - 1] at column k.
        trial = mask.copy()
        for dr in range(sep_h):
            rr = cur_top + dr
            if 0 <= rr < H:
                trial[rr, k] = False
        _, n_trial = label_mask(trial, connectivity=4)
        if n_trial != 1:
            break
        # Accept this column.
        np.copyto(mask, trial)
        np.copyto(last_good, trial)
        made_carve = True
        carved_cols += 1
        # Move top upward occasionally (slope up-right, parallel to anti-diagonal band).
        # Lower probability = fjord extends further horizontally before climbing.
        if random.random() < 0.3 and cur_top > 0:
            cur_top -= 1
    return made_carve


def _gen_attempt() -> np.ndarray | None:
    H = W = random.randint(20, 30)
    # Bias toward n=2 at sampling time to compensate for its lower per-attempt
    # success rate (n=2 requires carve + disjoint trajectories, ~40-60% success;
    # n=1 ~100%). Weight ~0.71 for n=2 yields roughly 1:1 output ratio.
    n_markers = 2 if random.random() < 0.7 else 1

    palette = list(range(10))
    random.shuffle(palette)
    bg = palette[0]
    path_color = palette[1]
    end_color = palette[2]
    n_blocks = random.randint(2, 4)
    cycle_pool = palette[3:]
    cycle_colors = [random.choice(cycle_pool) for _ in range(n_blocks)]

    # Markers-first: pick marker rows BEFORE building band. Band is built with
    # a lobe extending to col 0 across the marker-row neighborhood, baking
    # markers into the band's parametric curve.
    # Marker positions match eval distribution:
    #   n=1: bottom half (eval 0 marker at row 15/20 ≈ 0.75).
    #   n=2: r1 upper-middle [H/3, H/2], r2 lower [2H/3, H-4] (eval range
    #        r1/H ≈ 0.37-0.60, r2/H ≈ 0.87-0.92). Keeps both markers in the
    #        lower-to-middle region, not wasting the bottom grid area.
    if n_markers == 1:
        r1 = random.randint(H // 2, H - 4)
        markers = [r1]
    else:
        r1 = random.randint(H // 3, H // 2)
        r2 = random.randint(max(r1 + 5, 2 * H // 3), H - 4)
        markers = [r1, r2]

    mask = _build_band(H, W, lobe_rows=markers)
    # g[0,0] must be bg (template_bg per solver). Band should not touch top-left corner.
    if mask[0, 0]:
        return None
    _, n_path = label_mask(mask, connectivity=4)
    if n_path != 1:
        return None
    if not mask[0, :].any() or not mask[:, W - 1].any():
        return None
    if not mask[H - 1, :].any() or not mask[:, 0].any():
        return None
    # Marker embedding should be guaranteed by forced_left_rows, but verify.
    for r in markers:
        if not (mask[r, 0] and mask[r - 1, 0] and mask[r + 1, 0]):
            return None

    # n=2: choose separator form — ~75% left-edge fjord, ~25% interior island
    # (matches eval distribution: 3 of 4 n=2 evals have left-edge, 1 has interior).
    if n_markers == 2:
        trial = mask.copy()
        if not _carve_fjord(trial, r1, r2):
            return None
        # Convert fjord to interior island (~1/4 of eval, matches eval 3) by
        # restoring the first K cols of the carve — this disconnects the bg
        # strip from col 0 while keeping its shape as an elongated interior blob.
        use_interior = (random.random() < 0.25)  # matches eval ~1/4 interior island rate
        if use_interior:
            K = random.randint(2, 4)
            pre_carve_cells = mask & ~trial  # cells that fjord just carved
            for c in range(min(K, W)):
                trial[:, c] |= pre_carve_cells[:, c]
        _, nc = label_mask(trial, connectivity=4)
        if nc != 1:
            return None
        if not trial[0, :].any() or not trial[:, W - 1].any():
            return None
        if not trial[H - 1, :].any() or not trial[:, 0].any():
            return None
        # Marker embedding must be preserved post-carve/island
        for r in markers:
            if not (trial[r, 0] and trial[r - 1, 0] and trial[r + 1, 0]):
                return None
        mask = trial

    _, n_bg = label_mask(~mask, connectivity=4)
    if n_bg < 2:
        return None

    # Template placement (row in {1,2}, cols 1,4,7,10).
    template_row = random.choice([1, 2])
    block_cols = [1, 4, 7, 10][:n_blocks]
    if block_cols[-1] + 1 >= W:
        return None
    for bc in block_cols:
        for dr in range(2):
            for dc in range(2):
                rr, cc = template_row + dr, bc + dc
                if rr >= H or cc >= W or mask[rr, cc]:
                    return None

    g = np.full((H, W), bg, dtype=int)
    g[mask] = path_color

    for i, bc in enumerate(block_cols):
        g[template_row:template_row + 2, bc:bc + 2] = cycle_colors[i]

    # End block: 2x2 in bottom-right bg region, isolated from path by >=1 cell.
    end_candidates = []
    for r in range(H // 2, H - 1):
        for c in range(W // 2, W - 1):
            if not (g[r:r + 2, c:c + 2] == bg).all():
                continue
            r0, r1_ = max(0, r - 1), min(H, r + 3)
            c0, c1_ = max(0, c - 1), min(W, c + 3)
            if (g[r0:r1_, c0:c1_] == path_color).any():
                continue
            end_candidates.append((r, c))
    if not end_candidates:
        return None
    er, ec = random.choice(end_candidates)
    g[er:er + 2, ec:ec + 2] = end_color

    for r in markers:
        g[r, 0] = cycle_colors[0]

    # Path must remain single 4-conn after marker overwrite.
    _, n_path_after = label_mask(g == path_color, connectivity=4)
    if n_path_after != 1:
        return None

    # g[0,0] must be bg (== template_bg in solver).
    if g[0, 0] != bg:
        return None

    # path_color must be most-frequent non-bg color (solver's detection).
    # NOTE: solver uses template_bg = g[0,0], NOT most-common. So bg does NOT
    # need to be globally majority — only path must be max non-bg.
    cnt = Counter(map(int, g.flatten()))
    non_bg = sorted([(c, col) for col, c in cnt.items() if col != bg], reverse=True)
    if not non_bg or non_bg[0][1] != path_color:
        return None

    # Oracle: solver enforces marker embedding & disjoint trajectories.
    try:
        _ = main(g)
    except Exception:
        return None

    return g


def generate_input() -> np.ndarray:
    for _ in range(300):
        try:
            g = _gen_attempt()
        except Exception:
            g = None
_GEN_DISTRACTORS_WITHOUT_U_RANGE = (1, 4)

# Rejection-sampling retry budget.
_GEN_MAX_ATTEMPTS = 300


def _gen_u_patch(interior_h: int, interior_w: int) -> np.ndarray:
    patch = np.full((interior_h + 1, interior_w + 2), _GEN_BG, dtype=int)
    patch[:, 0] = _GEN_WALL
    patch[:, -1] = _GEN_WALL
    patch[-1, :] = _GEN_WALL
    return patch


def _gen_sample_u() -> tuple[int, int, int, int, int, int]:
    interior_h = int(np.random.randint(*_GEN_INTERIOR_H_RANGE))
    interior_w = int(np.random.randint(*_GEN_INTERIOR_W_RANGE))
    top = int(np.random.randint(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - interior_h + 1))
    bottom = top + interior_h
    left = int(np.random.randint(0, _GEN_W - interior_w - 1))
    right = left + interior_w + 1
    return top, bottom, left, right, interior_h, interior_w


def _gen_broken_u_patch(height: int, width: int, *, gap: int | None = None, missing_side: str | None = None) -> np.ndarray:
    patch = np.full((height, width), _GEN_BG, dtype=int)
    if missing_side != "left":
        patch[:, 0] = _GEN_WALL
    if missing_side != "right":
        patch[:, -1] = _GEN_WALL
    patch[-1, :] = _GEN_WALL
    if gap is not None:
        patch[-1, gap] = _GEN_BG
    return patch


def _gen_distractor_patches() -> list[np.ndarray]:
    patches: list[np.ndarray] = []

    for h in range(*_GEN_DISTRACTOR_H_RANGE):
        for w in range(*_GEN_DISTRACTOR_W_RANGE):
            gap = int(np.random.randint(1, w - 1))
            patches.append(_gen_broken_u_patch(h, w, gap=gap))
            patches.append(_gen_broken_u_patch(h, w, missing_side="left"))
            patches.append(_gen_broken_u_patch(h, w, missing_side="right"))

    return patches


def _gen_valid_positions(grid: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:
    ph, pw = patch.shape
    local = np.argwhere(patch == _GEN_WALL)
    local_set = {(int(r), int(c)) for r, c in local}
    touch_local = {
        (r + dr, c + dc)
        for r, c in local_set
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1))
        if (r + dr, c + dc) not in local_set
    }
    positions: list[tuple[int, int]] = []

    for r0 in range(_GEN_MIN_WALL_ROW, _GEN_LAST_WALL_ROW - ph + 2):
        for c0 in range(0, _GEN_W - pw + 1):
            if np.any(grid[r0 + local[:, 0], c0 + local[:, 1]] != _GEN_BG):
                continue
            touches = any(
                0 <= r0 + r < _GEN_H
                and 0 <= c0 + c < _GEN_W
                and grid[r0 + r, c0 + c] == _GEN_WALL
                for r, c in touch_local
            )
            if not touches:
                positions.append((r0, c0))

    return positions


def _gen_place_distractors(grid: np.ndarray, count: int) -> bool:
    patches = _gen_distractor_patches()
    for _ in range(count):
        placed = False
        for idx in np.random.permutation(len(patches)):
            patch = patches[int(idx)]
            positions = _gen_valid_positions(grid, patch)
            if not positions:
                continue
            r0, c0 = positions[int(np.random.randint(0, len(positions)))]
            paste(grid, patch, r0, c0, transparent=_GEN_BG)
            placed = True
            break
        if not placed:
            return False
    return True


_GenUBox = tuple[int, int, int, int]


def _gen_design_expected() -> tuple[np.ndarray, bool, _GenUBox | None, int, int]:
    """Build the expected output and return metadata needed to derive the input."""
    expected = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)
    fill_container = bool(np.random.random() < _GEN_FILL_CONTAINER_PROB)
    has_u = fill_container or bool(np.random.random() < _GEN_MISSED_HAS_U_PROB)
    u_box = None

    if has_u:
        top, bottom, left, right, interior_h, interior_w = _gen_sample_u()
        paste(expected, _gen_u_patch(interior_h, interior_w), top, left, transparent=_GEN_BG)
        u_box = (top, bottom, left, right)
        if fill_container:
            marker_c = int(np.random.randint(left + 1, right))
            expected[top:bottom, left + 1 : right] = _GEN_MARKER
        else:
            outside = [c for c in range(_GEN_W) if not (left <= c <= right)]
            marker_c = int(outside[int(np.random.randint(0, len(outside)))])
            expected[-1, :] = _GEN_MARKER
        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITH_U_RANGE))
    else:
        marker_c = int(np.random.randint(0, _GEN_W))
        expected[-1, :] = _GEN_MARKER
        distractor_count = int(np.random.randint(*_GEN_DISTRACTORS_WITHOUT_U_RANGE))

    return expected, fill_container, u_box, marker_c, distractor_count


def _gen_input_from_expected(expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> np.ndarray:
    inp = expected.copy()
    if fill_container:
        assert u_box is not None
        top, bottom, left, right = u_box
        inp[top:bottom, left + 1 : right] = _GEN_BG
    else:
        inp[-1, :] = _GEN_BG
    inp[_GEN_MARKER_ROW, marker_c] = _GEN_MARKER
    return inp


def _gen_valid_pair(inp: np.ndarray, expected: np.ndarray, fill_container: bool, u_box: _GenUBox | None, marker_c: int) -> bool:
    """Check structural invariants and the solver oracle."""
    if np.count_nonzero(inp == _GEN_MARKER) != 1 or inp[_GEN_MARKER_ROW, marker_c] != _GEN_MARKER:
        return False
    if not np.all(inp[-1, :] == _GEN_BG):
        return False

    wall_coords = np.argwhere(inp == _GEN_WALL)
    if wall_coords.size == 0 or int(wall_coords[:, 0].min()) < _GEN_MIN_WALL_ROW or int(wall_coords[:, 0].max()) > _GEN_LAST_WALL_ROW:
        return False

    component_count = len(find_components(inp, bg=_GEN_BG, colors=[_GEN_WALL], connectivity=4))
    if not (1 <= component_count <= 3):
        return False

    containers = _closed_u_containers(inp, _GEN_WALL, _GEN_BG)
    if len(containers) > 1:
        return False
    if any(marker_c in (left, right) for _top, _bottom, left, right in containers):
        return False
    if fill_container:
        if len(containers) != 1 or containers[0] != u_box:
            return False
    elif containers and containers[0][2] <= marker_c <= containers[0][3]:
        return False

    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, expected)


def _gen_attempt() -> np.ndarray | None:
    expected, fill_container, u_box, marker_c, distractor_count = _gen_design_expected()
    if not _gen_place_distractors(expected, distractor_count):
        return None

    inp = _gen_input_from_expected(expected, fill_container, u_box, marker_c)
    if not _gen_valid_pair(inp, expected, fill_container, u_box, marker_c):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid db7260a4 input")

# ── CFG: tunable generation parameters ──────────────────────────────────────
NODE_SIZE_CHOICES = [2, 3]               # N for NxN node squares
NODE_COUNT_RANGE = (7, 10)               # V = total graph nodes (2 terminal + rest station)
CYCLE_COUNT_CHOICES = [1, 2]             # independent cycles in the graph
PATH_LEN_CHOICES = [2, 3]               # shortest-path edge count between terminals
GAP_CHOICES = [2, 3]                     # gap between node square edge and cell boundary
CELL_GRID_DIMS = (3, 4, 5)              # candidate Kr, Kc values for the cell grid
GRID_SIZE_RANGE = (15, 30)               # canvas side length S bounds
COLOR_POOL = [0, 1, 2, 4, 6, 7, 8, 9]   # eligible colors (excludes green=3, grey=5)
CELL_PICK_RETRIES = 50                   # retries for _pick_cells connectivity check
GEN_ATTEMPT_RETRIES = 300                # outer retry limit in generate_input


def _compute_adjacency(picked: set[tuple[int, int]], use_diagonal: bool, allow_skip: bool):
    """
    Compute valid undirected edges between picked cells on a grid.

    Always includes cardinal distance-1 neighbors.  Optionally includes:
    - allow_skip: cardinal distance-2 when the intermediate cell is empty.
    - use_diagonal: diagonal distance-1 when both perpendicular cells are empty.
    """
    edges = set()
    for (i, j) in picked:
        for (di, dj) in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            n = (i + di, j + dj)
            if n in picked:
                edges.add(tuple(sorted([(i, j), n])))
        if allow_skip:
            for (di, dj) in [(-2, 0), (2, 0), (0, -2), (0, 2)]:
                mid = (i + di // 2, j + dj // 2)
                far = (i + di, j + dj)
                if far in picked and mid not in picked:
                    edges.add(tuple(sorted([(i, j), far])))
        if use_diagonal:
            for (di, dj) in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:
                n = (i + di, j + dj)
                corner1 = (i + di, j); corner2 = (i, j + dj)
                if n in picked and corner1 not in picked and corner2 not in picked:
                    edges.add(tuple(sorted([(i, j), n])))
    return edges


def _pick_cells(Kr: int, Kc: int, V: int, rng: random.Random,
                use_diagonal: bool, allow_skip: bool):
    """Pick V cells on a Kr x Kc grid ensuring the induced adjacency graph is connected."""
    cells = [(i, j) for i in range(Kr) for j in range(Kc)]
    if len(cells) < V:
        return None
    for _ in range(CELL_PICK_RETRIES):
        rng.shuffle(cells)
        picked = set(cells[:V])
        edges = _compute_adjacency(picked, use_diagonal=use_diagonal, allow_skip=allow_skip)
        adj = {c: [] for c in picked}
        for (a, b) in edges:
            adj[a].append(b); adj[b].append(a)
        root = next(iter(picked))
        seen = {root}; stack = [root]
        while stack:
            u = stack.pop()
            for v in adj[u]:
                if v not in seen:
                    seen.add(v); stack.append(v)
        if len(seen) == V:
            return picked
    return None


def _bfs_with_counts(src: int, allowed: set, V: int):
    """BFS from src over allowed edges.  Returns (dist, count, adj_list) dicts.

    dist[v] = shortest distance from src; count[v] = number of shortest paths.
    """
    adj = {i: [] for i in range(V)}
    for (a, b) in allowed:
        adj[a].append(b); adj[b].append(a)
    dist = {src: 0}; cnt = {src: 1}; q = deque([src])
    while q:
        u = q.popleft()
        for v in adj[u]:
            if v not in dist:
                dist[v] = dist[u] + 1; cnt[v] = cnt[u]; q.append(v)
            elif dist[v] == dist[u] + 1:
                cnt[v] += cnt[u]
    return dist, cnt, adj


def _build_graph_spatial(picked: set[tuple[int, int]], cell_to_id: dict, rng: random.Random,
                         path_len: int, n_cycles: int, use_diagonal: bool, allow_skip: bool):
    """
    Build an edge-subgraph on spatial adjacencies of the picked cells.

    Selects two terminals (remapped to ids 0 and V-1), constructs a spanning tree seeded
    from the unique shortest path of `path_len` edges, then adds `n_cycles` extra edges
    that preserve shortest-path uniqueness.  Returns (edges, path_nodes, path_edges,
    remapped_cell_to_id) or None on failure.
    """
    V = len(picked)
    cell_edges = _compute_adjacency(picked, use_diagonal=use_diagonal, allow_skip=allow_skip)
    full_edges = {tuple(sorted((cell_to_id[a], cell_to_id[b]))) for (a, b) in cell_edges}

    # Pick 2 distinct node ids as terminals
    ids = list(range(V))
    rng.shuffle(ids)
    t0, t1 = ids[0], ids[1]

    dist, cnt, adj = _bfs_with_counts(t0, full_edges, V)
    if t1 not in dist or dist[t1] != path_len:
        return None

    # Trace one shortest path t0 -> t1
    parent = {t0: None}; q = deque([t0]); seen = {t0}
    while q:
        u = q.popleft()
        if u == t1:
            break
        for v in adj[u]:
            if v not in seen:
                seen.add(v); parent[v] = u; q.append(v)
    cur = t1; sp_nodes = []
    while cur is not None:
        sp_nodes.append(cur); cur = parent[cur]
    sp_nodes.reverse()
    sp_edges = {tuple(sorted((sp_nodes[i], sp_nodes[i + 1]))) for i in range(len(sp_nodes) - 1)}

    # Build spanning tree seeded from the shortest path, expanding via BFS
    tree_edges = set(sp_edges)
    in_tree = set(sp_nodes)
    frontier = list(sp_nodes)
    while in_tree != set(range(V)):
        next_frontier = []
        for u in frontier:
            for v in adj[u]:
                if v not in in_tree:
                    tree_edges.add(tuple(sorted((u, v))))
                    in_tree.add(v)
                    next_frontier.append(v)
        if not next_frontier:
            return None
        frontier = next_frontier

    # Add n_cycles extra edges that preserve shortest-path uniqueness
    extra_candidates = list(full_edges - tree_edges)
    rng.shuffle(extra_candidates)
    final_edges = set(tree_edges)
    added = 0
    for e in extra_candidates:
        if added >= n_cycles:
            break
        cand = final_edges | {e}
        dist2, cnt2, _ = _bfs_with_counts(t0, cand, V)
        if dist2.get(t1) == path_len and cnt2.get(t1) == 1:
            final_edges.add(e); added += 1
    if added != n_cycles:
        return None

    # Final verification
    dist3, cnt3, _ = _bfs_with_counts(t0, final_edges, V)
    if dist3.get(t1) != path_len or cnt3.get(t1) != 1:
        return None
    if len(final_edges) != V - 1 + n_cycles:
        return None

    # Remap node ids: 0 = t0, V-1 = t1, others fill 1..V-2
    id_map = {t0: 0, t1: V - 1}
    for idx, i in enumerate(i for i in range(V) if i != t0 and i != t1):
        id_map[i] = idx + 1
    remapped_edges = {tuple(sorted((id_map[a], id_map[b]))) for (a, b) in final_edges}
    remapped_cell_to_id = {cell: id_map[cell_to_id[cell]] for cell in cell_to_id}
    new_path_nodes = [id_map[n] for n in sp_nodes]
    new_path_edges = [tuple(sorted((new_path_nodes[i], new_path_nodes[i + 1])))
                      for i in range(len(new_path_nodes) - 1)]

    return list(remapped_edges), new_path_nodes, new_path_edges, remapped_cell_to_id


# ---------------------------------------------------------------------------
# Spatial layout: placing squares and routing tracks
# ---------------------------------------------------------------------------

def _cell_to_square_pos(cell: tuple[int, int], N: int, cell_size: int, origin: tuple[int, int]):
    """Top-left corner of the NxN square centered in the given cell."""
    i, j = cell
    or_r, or_c = origin
    margin = (cell_size - N) // 2
    return (or_r + i * cell_size + margin, or_c + j * cell_size + margin)


def _dock_tl(sq_r: int, sq_c: int, N: int, Wt: int, si: int, sj: int):
    """Top-left of the Wt x Wt footprint docked to one face of an NxN square.

    The face is determined by the outgoing direction (si, sj).  Staggered offsets
    prevent two cardinal tracks from becoming 8-adjacent at a shared node corner:
      up    (si=-1): left-aligned columns
      down  (si=+1): right-aligned columns
      left  (sj=-1): bottom-aligned rows
      right (sj=+1): top-aligned rows
    """
    if si == -1:
        return sq_r - Wt, sq_c
    elif si == 1:
        return sq_r + N, sq_c + N - Wt
    elif sj == -1:
        return sq_r + N - Wt, sq_c - Wt
    elif sj == 1:
        return sq_r, sq_c + N
    return None


def _walk_footprints(sr: int, sc: int, er: int, ec: int):
    """Generate the sequence of footprint top-left positions from (sr,sc) to (er,ec).

    Steps diagonally first, then along the remaining axis.
    """
    pts = [(sr, sc)]
    cr, cc = sr, sc
    while cr != er and cc != ec:
        cr += 1 if er > cr else -1
        cc += 1 if ec > cc else -1
        pts.append((cr, cc))
    while cr != er:
        cr += 1 if er > cr else -1
        pts.append((cr, cc))
    while cc != ec:
        cc += 1 if ec > cc else -1
        pts.append((cr, cc))
    return pts


def _track_between_cells(cell_a: tuple[int, int], cell_b: tuple[int, int],
                         pos_a: tuple[int, int], pos_b: tuple[int, int], N: int,
                         rng: random.Random) -> list[tuple[int, int]]:
    """Route a (N-1)-wide track strip between two node squares.

    Returns list of (r, c) track pixels.  The track walks Wt x Wt footprints from
    square A's exit dock to square B's entry dock.
    """
    Wt = N - 1
    ra, ca = pos_a; rb, cb = pos_b
    dci, dcj = cell_b[0] - cell_a[0], cell_b[1] - cell_a[1]
    si = 0 if dci == 0 else (1 if dci > 0 else -1)
    sj = 0 if dcj == 0 else (1 if dcj > 0 else -1)

    sr, sc = _dock_tl(ra, ca, N, Wt, si, sj)
    # B's entry dock uses the *opposite* direction with B's stagger convention,
    # which is equivalent to calling _dock_tl with (-si, -sj) but using B's coordinates.
    # The per-direction formulas for arrival match departure of the opposite face:
    er, ec = _dock_tl(rb, cb, N, Wt, -si, -sj)

    pts_tl = _walk_footprints(sr, sc, er, ec)

    # Expand each footprint position into Wt x Wt pixels
    pixels = set()
    for r, c in pts_tl:
        for dr in range(Wt):
            for dc in range(Wt):
                pixels.add((r + dr, c + dc))
    return list(pixels)


# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------

def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    """Single attempt to generate a valid input grid.  Returns None on failure."""
    N = rng.choice(NODE_SIZE_CHOICES)
    V = rng.randint(*NODE_COUNT_RANGE)
    n_cycles = rng.choice(CYCLE_COUNT_CHOICES)
    path_len = rng.choice(PATH_LEN_CHOICES)

    gap = rng.choice(GAP_CHOICES)
    cell_size = N + gap

    # Find valid cell-grid dimensions
    KrKc_options = []
    for Kr in CELL_GRID_DIMS:
        for Kc in CELL_GRID_DIMS:
            if Kr * Kc < V:
                continue
            min_S = max(Kr, Kc) * cell_size + 2
            if min_S > GRID_SIZE_RANGE[1]:
                continue
            KrKc_options.append((Kr, Kc, min_S))
    if not KrKc_options:
        return None
    Kr, Kc, min_S = rng.choice(KrKc_options)
    S = rng.randint(max(GRID_SIZE_RANGE[0], min_S), GRID_SIZE_RANGE[1])

    # Pick connected cells (cardinal adjacency + skip-2)
    use_diagonal = False
    allow_skip = True
    picked = _pick_cells(Kr, Kc, V, rng, use_diagonal=use_diagonal, allow_skip=allow_skip)
    if picked is None:
        return None

    picked_list = list(picked); rng.shuffle(picked_list)
    cell_to_id = {cell: i for i, cell in enumerate(picked_list)}

    # Build graph
    gr = _build_graph_spatial(picked, cell_to_id, rng, path_len, n_cycles,
                              use_diagonal=use_diagonal, allow_skip=allow_skip)
    if gr is None:
        return None
    edges, path_nodes, path_edges, cell_to_id = gr
    id_to_cell = {v: k for k, v in cell_to_id.items()}
    V = len(picked)

    # Color assignment: 4 distinct colors from pool -> bg, terminal, station, track
    pool = list(COLOR_POOL)
    rng.shuffle(pool)
    four = pool[:4]
    bg = rng.choice(four)
    rest = [c for c in four if c != bg]
    terminal_color = rng.choice(rest)
    rest2 = [c for c in rest if c != terminal_color]
    station_color = rng.choice(rest2)
    track_color = [c for c in rest2 if c != station_color][0]

    # Place node squares on canvas
    canvas = np.full((S, S), bg, dtype=int)
    node_mask = np.zeros((S, S), dtype=bool)
    slack_r = S - Kr * cell_size - 2
    slack_c = S - Kc * cell_size - 2
    origin = (1 + rng.randint(0, max(0, slack_r)), 1 + rng.randint(0, max(0, slack_c)))
    id_to_pos = {}
    for i in range(V):
        cell = id_to_cell[i]
        pos = _cell_to_square_pos(cell, N, cell_size, origin)
        id_to_pos[i] = pos
        color = terminal_color if i in (0, V - 1) else station_color
        r0, c0 = pos
        canvas[r0:r0 + N, c0:c0 + N] = color
        node_mask[r0:r0 + N, c0:c0 + N] = True

    # Route tracks between connected node pairs
    track_mask = np.zeros((S, S), dtype=bool)
    edge_track_pixels = {}
    for (a, b) in edges:
        pixels = _track_between_cells(id_to_cell[a], id_to_cell[b],
                                      id_to_pos[a], id_to_pos[b], N, rng)
        for (r, c) in pixels:
            if not (0 <= r < S and 0 <= c < S):
                return None
            if node_mask[r, c] or track_mask[r, c]:
                return None
        for (r, c) in pixels:
            canvas[r, c] = track_color
            track_mask[r, c] = True
        edge_track_pixels[tuple(sorted((a, b)))] = pixels

    # Verify bg is still the most common color
    if np.argmax(np.bincount(canvas.ravel())) != bg:
        return None

    # Build expected output and oracle-check against solver
    expected = canvas.copy()
    for gnode in path_nodes:
        if gnode in (0, V - 1):
            continue
        r0, c0 = id_to_pos[gnode]
        expected[r0:r0 + N, c0:c0 + N] = 3
    for e in path_edges:
        for (r, c) in edge_track_pixels[tuple(sorted(e))]:
            expected[r, c] = 5

    try:
        actual = main(canvas)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return canvas


def generate_input() -> np.ndarray:
    rng = random.Random()
