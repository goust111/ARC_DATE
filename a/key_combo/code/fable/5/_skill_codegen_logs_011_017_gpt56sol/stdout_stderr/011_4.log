from __future__ import annotations

import random
from collections import Counter, deque

import numpy as np


RED = 2
_KINDS = ("H", "V", "D1", "D2")


def _background(grid: np.ndarray) -> int:
    """Return the dominant color, following the shared ARC toolbox convention."""
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _components(mask: np.ndarray) -> list[np.ndarray]:
    """Return 4-connected components as (N, 2) arrays of (row, column)."""
    h, w = mask.shape
    unseen = mask.astype(bool).copy()
    result: list[np.ndarray] = []
    for sr, sc in np.argwhere(unseen):
        sr, sc = int(sr), int(sc)
        if not unseen[sr, sc]:
            continue
        unseen[sr, sc] = False
        queue = deque([(sr, sc)])
        cells: list[tuple[int, int]] = []
        while queue:
            r, c = queue.popleft()
            cells.append((r, c))
            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if 0 <= rr < h and 0 <= cc < w and unseen[rr, cc]:
                    unseen[rr, cc] = False
                    queue.append((rr, cc))
        result.append(np.asarray(cells, dtype=int))
    return result


def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _crop_mask(coords: np.ndarray) -> tuple[np.ndarray, int, int]:
    r0, c0, r1, c1 = _bbox(coords)
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
    return mask, r0, c0


def _reflect(mask: np.ndarray, kind: str) -> np.ndarray:
    if kind == "H":
        return mask[::-1, :]
    if kind == "V":
        return mask[:, ::-1]
    if kind == "D1":
        return mask.T
    if kind == "D2":
        return np.rot90(mask, 2).T
    raise ValueError(f"unknown reflection kind: {kind}")


def _axes_of(mask: np.ndarray) -> list[str]:
    axes = []
    for kind in _KINDS:
        if kind.startswith("D") and mask.shape[0] != mask.shape[1]:
            continue
        if np.array_equal(mask, _reflect(mask, kind)):
            axes.append(kind)
    return axes


def _side_values(coords: np.ndarray, shape: tuple[int, int], kind: str) -> np.ndarray:
    """Signed side of an axis, in the object's own cropped coordinate system."""
    h, w = shape
    r = coords[:, 0]
    c = coords[:, 1]
    if kind == "H":
        return 2 * r - (h - 1)
    if kind == "V":
        return 2 * c - (w - 1)
    if kind == "D1":
        return r - c
    return r + c - (h - 1)


def _direction(kind: str, side: int) -> tuple[int, int]:
    if kind == "H":
        return (side, 0)
    if kind == "V":
        return (0, side)
    if kind == "D1":
        return (side, -side)
    return (side, side)


def _analyze_mask(mask: np.ndarray) -> dict:
    """Infer the unique completion axis, missing side, completed mask and motion."""
    candidates: list[dict] = []
    for kind in _KINDS:
        if kind.startswith("D") and mask.shape[0] != mask.shape[1]:
            continue
        mirrored = _reflect(mask, kind)
        missing = mirrored & ~mask
        if not missing.any():
            continue
        completed = mask | mirrored
        # The repaired object itself must have exactly one reflection axis.
        if _axes_of(completed) != [kind]:
            continue
        if len(_components(completed)) != 1:
            continue
        missing_coords = np.argwhere(missing)
        values = _side_values(missing_coords, mask.shape, kind)
        if np.all(values > 0):
            side = 1
        elif np.all(values < 0):
            side = -1
        else:
            continue
        candidates.append(
            {
                "kind": kind,
                "side": side,
                "direction": _direction(kind, side),
                "completed": completed,
                "missing": missing,
            }
        )
    assert len(candidates) == 1, "each incomplete object must have one unique one-sided reflection completion"
    return candidates[0]


def _edge_distance(coords: set[tuple[int, int]], direction: tuple[int, int], shape: tuple[int, int]) -> int:
    h, w = shape
    dr, dc = direction
    limits = []
    for r, c in coords:
        row_limit = h - 1 - r if dr > 0 else r if dr < 0 else max(h, w)
        col_limit = w - 1 - c if dc > 0 else c if dc < 0 else max(h, w)
        limits.append(min(row_limit, col_limit))
    return int(min(limits))


def _shift(coords: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
    return {(r + dr, c + dc) for r, c in coords}


def _settle(
    objects: list[dict],
    shape: tuple[int, int],
    order: list[int] | None = None,
    *,
    require_unique_order: bool = True,
) -> tuple[list[set[tuple[int, int]]], list[str], list[int]]:
    h, w = shape
    distances = [
        _edge_distance(obj["coords"], obj["direction"], shape)
        for obj in objects
    ]
    if require_unique_order:
        assert len(set(distances)) == len(distances), "edge distances must uniquely determine settling order"
    if order is None:
        order = sorted(range(len(objects)), key=lambda i: distances[i])

    occupied: set[tuple[int, int]] = set()
    final: list[set[tuple[int, int]]] = [set() for _ in objects]
    reasons = [""] * len(objects)
    steps = [0] * len(objects)
    for index in order:
        current = set(objects[index]["coords"])
        assert not (current & occupied), "a settled object may not cover an object that has not begun sliding"
        dr, dc = objects[index]["direction"]
        while True:
            nxt = _shift(current, dr, dc)
            if any(not (0 <= r < h and 0 <= c < w) for r, c in nxt):
                reason = "edge"
                break
            if nxt & occupied:
                reason = "object"
                break
            current = nxt
            steps[index] += 1
        final[index] = current
        reasons[index] = reason
        occupied |= current
    return final, reasons, steps


def _parse_objects(grid: np.ndarray, bg: int) -> tuple[list[dict], list[tuple[int, int]]]:
    components = _components(grid == RED)
    objects: list[dict] = []
    noise: list[tuple[int, int]] = []
    for coords in components:
        if len(coords) == 1:
            noise.append(tuple(map(int, coords[0])))
            continue
        mask, r0, c0 = _crop_mask(coords)
        info = _analyze_mask(mask)
        local = np.argwhere(info["completed"])
        info = dict(info)
        info["coords"] = {(int(r + r0), int(c + c0)) for r, c in local}
        info["input_coords"] = {tuple(map(int, p)) for p in coords}
        info["origin"] = (r0, c0)
        objects.append(info)
    return objects, noise


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete each one-sided incomplete red reflection object, then slide it toward its missing side until it reaches an edge or a settled object.

    Input structure:
    - A dominant background surrounds several 4-connected red objects and isolated
      red singleton noise pixels.
    - Each non-singleton is missing pixels from exactly one side of exactly one
      horizontal, vertical, main-diagonal, or anti-diagonal reflection axis.

    Rule:
    - Erase singleton noise and repair every object by reflecting its present half
      across its unique axis. The missing side selects the perpendicular cardinal
      or diagonal motion direction.
    - Settle objects in increasing distance to their forward grid edge. Move each
      repaired object one cell at a time until its next step leaves the grid or
      overlaps an already settled object; erase all original positions.

    Key insight:
    - The absent pixels are both the reflected content to restore and a directional
      code. They cannot be treated like the true noise singletons, and each object
      has its own axis-relative direction rather than sharing one gravity vector.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and 0 < g.shape[0] <= 30 and 0 < g.shape[1] <= 30
    bg = _background(g)
    assert set(map(int, np.unique(g))) <= {bg, RED}, "only background and red are expected"
    objects, _noise = _parse_objects(g, bg)
    assert objects, "expected at least one non-singleton incomplete object"

    final, _reasons, _steps = _settle(objects, g.shape)
    out = np.full_like(g, bg)
    for cells in final:
        for r, c in cells:
            out[r, c] = RED
    return out


# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------


def _connected(mask: np.ndarray) -> bool:
    return bool(mask.any()) and len(_components(mask)) == 1


def _tight(mask: np.ndarray) -> bool:
    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np


# The puzzle gives these two colors visible roles rather than numeric meanings.
WALL_COLOR = 5       # grey pixels reflect the ray
CONTAINER_COLOR = 2  # red pixels form U-shaped containers


def _background(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _components(mask: np.ndarray) -> list[np.ndarray]:
    """Return 4-connected components as arrays of canonical (row, column) coords."""
    h, w = mask.shape
    unseen = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
    result: list[np.ndarray] = []
    while unseen:
        seed = unseen.pop()
        queue = deque([seed])
        coords = [seed]
        while queue:
            r, c = queue.popleft()
            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) in unseen:
                    unseen.remove((nr, nc))
                    queue.append((nr, nc))
                    coords.append((nr, nc))
        result.append(np.asarray(coords, dtype=int))
    return result


def _find_arrow(grid: np.ndarray, bg: int) -> tuple[int, set[tuple[int, int]], tuple[int, int], int]:
    """Find the unique 3-cell L arrow and return color, cells, launch cell, dc."""
    candidates = []
    for color in map(int, np.unique(grid)):
        if color in (bg, WALL_COLOR, CONTAINER_COLOR):
            continue
        for coords in _components(grid == color):
            if len(coords) != 3:
                continue
            r0, c0 = map(int, coords.min(axis=0))
            r1, c1 = map(int, coords.max(axis=0))
            if (r1 - r0, c1 - c0) != (1, 1):
                continue
            cells = {tuple(map(int, rc)) for rc in coords}
            corners = {(r, c) for r in (r0, r1) for c in (c0, c1)}
            missing = list(corners - cells)
            if len(missing) != 1:
                continue

            # As in the reference arrow sprite, the missing corner is the tail:
            # launch from the diagonally opposite filled corner, continuing away.
            mr, mc = missing[0]
            start = (r0 + r1 - mr, c0 + c1 - mc)
            dr = start[0] - mr
            dc = start[1] - mc
            if dr == 1 and dc in (-1, 1):
                candidates.append((color, cells, start, dc))

    assert len(candidates) == 1, "expected one downward-pointing 3-pixel L arrow"
    return candidates[0]


def _find_containers(grid: np.ndarray, bg: int) -> list[tuple[int, int, int, int]]:
    """Return exact red U shapes as inclusive (top, bottom, left, right) bboxes."""
    containers: list[tuple[int, int, int, int]] = []
    for coords in _components(grid == CONTAINER_COLOR):
        r0, c0 = map(int, coords.min(axis=0))
        r1, c1 = map(int, coords.max(axis=0))
        if r1 <= r0 or c1 - c0 < 2:
            continue
        expected = {
            *((r, c0) for r in range(r0, r1 + 1)),
            *((r, c1) for r in range(r0, r1 + 1)),
            *((r1, c) for c in range(c0, c1 + 1)),
        }
        actual = {tuple(map(int, rc)) for rc in coords}
        if actual != expected:
            continue
        if not np.all(grid[r0:r1, c0 + 1:c1] == bg):
            continue
        containers.append((r0, r1, c0, c1))
    return sorted(containers)


def _trace_ray(
    grid: np.ndarray,
    start: tuple[int, int],
    initial_dc: int,
) -> tuple[int, list[tuple[str, int, int]], list[tuple[int, int]]]:
    """Trace the invisible downward ray; return landing column, events, and path."""
    h, w = grid.shape
    r, c = map(int, start)
    dc = int(initial_dc)
    events: list[tuple[str, int, int]] = []
    path: list[tuple[int, int]] = []

    while r < h - 1:
        nr = r + 1
        nc = c + dc
        if not (0 <= nc < w):
            events.append(("boundary", nr, nc))
            dc = -dc
            nc = c + dc
        elif int(grid[nr, nc]) == WALL_COLOR:
            events.append(("wall", nr, nc))
            dc = -dc
            nc = c + dc

        assert 0 <= nc < w, "reflection must return the ray to the grid"
        assert int(grid[nr, nc]) != WALL_COLOR, "ray may not be trapped between reflectors"
        r, c = nr, nc
        path.append((r, c))
        if int(grid[r, c]) == CONTAINER_COLOR or r == h - 1:
            return c, events, path

    return c, events, path


def main(grid: np.ndarray) -> np.ndarray:
    """
    Cast an invisible bouncing ray from an L-arrow and fill the U-container selected by its landing column.

    Input structure:
    - A dominant background contains one monochrome 3-pixel L arrow in the upper area,
      separate grey wall pixels, and one or more exact red U-shaped containers below.
    - The arrow's missing corner and diagonally opposite filled corner encode one of
      the two downward diagonal launch directions; container interiors are background.

    Rule:
    - Launch from the arrow's right-angle cell away from its missing corner. Move down
      one row per step, reversing only the horizontal direction before a left/right
      boundary crossing or a diagonal move into a grey wall pixel.
    - Stop on the first red container pixel or on the bottom row. If that column lies
      in exactly one closed U footprint, fill its interior with the arrow color;
      otherwise color the entire bottom row with the arrow color.
    - Erase all three arrow pixels, preserve every wall and container pixel, and never
      draw any cell of the ray trajectory.

    Key insight:
    - The arrow's visible column is not the destination: the unique target is obtained
      only by simulating the unseen diagonal path in grid (row, column) coordinates,
      including both boundary and grey-wall horizontal reflections.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert min(g.shape) >= 3, "grid is too small"
    bg = _background(g)

    arrow_color, arrow_cells, start, dc = _find_arrow(g, bg)
    containers = _find_containers(g, bg)
    assert containers, "expected at least one closed red U-container"
    landing_col, _events, _path = _trace_ray(g, start, dc)

    selected = [box for box in containers if box[2] <= landing_col <= box[3]]
    assert len(selected) <= 1, "landing column must identify at most one container"

    out = g.copy()
    for r, c in arrow_cells:
        out[r, c] = bg

    if selected:
        top, bottom, left, right = selected[0]
        interior = out[top:bottom, left + 1:right]
        assert np.all(interior == bg), "selected container interior must be empty"
        interior[:] = arrow_color
    else:
        out[-1, :] = arrow_color
    return out


