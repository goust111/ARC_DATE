+
+def _walk_positions(commands: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    positions = [(0, 0)]
+    r = c = 0
+    for dr, dc in commands:
+        r, c = r + dr, c + dc
+        positions.append((r, c))
+    return positions
