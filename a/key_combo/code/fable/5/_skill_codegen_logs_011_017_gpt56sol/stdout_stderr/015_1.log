+        rows = [p[0] for p in positions]
+        cols = [p[1] for p in positions]
+        if has_crossing != want_crossing:
+            continue
+        if (0, 0) in landings:
+            continue
+        if set(commands) != set(DIRECTIONS):
+            continue
+        if len(set(landings)) < 9:
+            continue
