+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+SIDES = ("top", "bottom", "left", "right")
+GENERATION_ATTEMPTS = 400
