from arc_utils import paste

# ── CFG: tunable generation parameters ──────────────────────────────
GRID_H, GRID_W = 10, 10                    # canvas size
BG, GREY = 0, 5                            # background and path colors
SPRITE_COUNTS = [4, 5]                      # number of sprites per example
SOURCE_COUNTS = [1, 2]                      # possible number of source sprites
INTERIOR_DEST_WEIGHTS = [3, 1]              # weights for [0, 1] interior dests
PATH_LEN_MIN, PATH_LEN_MAX = 10, 24        # grey trail length bounds
MIN_PORT_DIST_FRAC = 3                      # min_port_dist = max(3, target_len // this)
MAX_THICKNESS = 3                           # max 8-neighbor degree for path cells
PATH_WANDER_AWAY_P = 0.5                    # P(choose away-moves) when budget is large
PATH_WANDER_DIAG_P = 0.6                    # P(prefer diagonal) in wander/moderate phases
PATH_MODERATE_RANDOM_P = 0.3               # P(random move) in moderate-budget phase
GEN_RETRIES = 300                           # outer retry limit
def _make_sprite_patch(shape_type, border_color, center_color):
    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
    if shape_type == 'box':
        p = np.full((3, 3), border_color, dtype=int)
    else:  # plus
        p = np.zeros((3, 3), dtype=int)
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            p[1 + dr, 1 + dc] = border_color
    p[1, 1] = center_color
    return p


def _place_sprite(grid, patch, r0, c0):
    """Place patch cells on grid, skipping transparent (0) and out-of-bounds."""
    paste(grid, patch, r0, c0, transparent=BG, clip=True)


def _erase_sprite(grid, patch, r0, c0):
    """Undo a _place_sprite by zeroing non-transparent patch cells."""
    H, W = grid.shape
    for dr in range(3):
        for dc in range(3):
            rr, cc = r0 + dr, c0 + dc
            if 0 <= rr < H and 0 <= cc < W and patch[dr, dc] != 0:
                grid[rr, cc] = BG


def _overlaps(grid, patch, r0, c0):
    """Check if placing patch at (r0,c0) would overlap or 4-touch non-bg, non-grey cells."""
    H, W = grid.shape
    patch_cells = set()
    for dr in range(3):
        for dc in range(3):
            if patch[dr, dc] != 0:
                rr, cc = r0 + dr, c0 + dc
                if 0 <= rr < H and 0 <= cc < W:
                    if grid[rr, cc] != 0:
                        return True
                    patch_cells.add((rr, cc))
    for rr, cc in patch_cells:
        for nr, nc in [(rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)]:
            if (nr, nc) not in patch_cells and 0 <= nr < H and 0 <= nc < W:
                if int(grid[nr, nc]) not in (BG, GREY):
                    return True
    return False


def _sprite_positions():
    """All valid (r0,c0) for a 3x3 patch where center stays on grid."""
    return [(r0, c0) for r0 in range(-1, GRID_H) for c0 in range(-1, GRID_W)
            if 0 <= r0 + 1 < GRID_H and 0 <= c0 + 1 < GRID_W]


def _is_edge(r0, c0):
    return r0 <= 0 or r0 + 3 >= GRID_H or c0 <= 0 or c0 + 3 >= GRID_W


def _too_thick(r, c, occupied):
    """Check if adding (r,c) would push any cell's 8-degree above MAX_THICKNESS."""
    nbs = [(r + dr, c + dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)
           if (dr or dc) and (r + dr, c + dc) in occupied]
    if len(nbs) > MAX_THICKNESS:
        return True
    for nr, nc in nbs:
        deg = sum(1 for dr in (-1, 0, 1) for dc in (-1, 0, 1)
                  if (dr or dc) and (nr + dr, nc + dc) in occupied)
        if deg + 1 > MAX_THICKNESS:
            return True
    return False


def _gen_winding_path(grid, start, end, target_len):
    """Generate a winding 8-connected grey path with no 2x2 blocks."""
    path = [start]
    visited = {start}
    cr, cc = start

    def score(m):
        return abs(m[0] - end[0]) + abs(m[1] - end[1])

    for _ in range(target_len + 20):
        if max(abs(cr - end[0]), abs(cc - end[1])) <= 1:
            break

        moves = []
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nr, nc = cr + dr, cc + dc
                if (0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in visited
                        and grid[nr, nc] == 0 and not _too_thick(nr, nc, visited)):
                    moves.append((nr, nc, dr != 0 and dc != 0))

        if not moves:
            return None

        dist = abs(cr - end[0]) + abs(cc - end[1])
        budget = target_len - len(path)
        diag = [m for m in moves if m[2]]
        away = [m for m in moves if score(m) > dist]

        if budget > dist + 4:
            # Plenty of budget: strongly prefer wandering away or sideways
            if away and random.random() < PATH_WANDER_AWAY_P:
                pool = away
            elif diag and random.random() < PATH_WANDER_DIAG_P:
                pool = diag
            else:
                pool = moves
            chosen = random.choice(pool)
        elif budget > dist + 1:
            # Some budget: mix of diagonal and toward-target
            pool = diag if diag and random.random() < PATH_WANDER_DIAG_P else moves
            if random.random() < PATH_MODERATE_RANDOM_P:
                chosen = random.choice(pool)
            else:
                chosen = min(pool, key=score)
        else:
            # Tight: head toward target, prefer diagonal
            best = sorted(moves, key=score)
            top = [m for m in best if score(m) <= score(best[0]) + 1]
            dtop = [m for m in top if m[2]]
            chosen = random.choice(dtop) if dtop else best[0]

        cr, cc = chosen[0], chosen[1]
        path.append((cr, cc))
        visited.add((cr, cc))

    if end not in visited:
        if not _too_thick(end[0], end[1], visited):
            path.append(end)
        else:
            return None

    return path


def _is_8_connected(cells):
    """Check 8-connectivity of a set of cells via BFS."""
    if len(cells) <= 1:
        return True
    cell_set = set(cells)
    start = next(iter(cell_set))
    visited = {start}
    queue = deque([start])
    while queue:
        r, c = queue.popleft()
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nb = (r + dr, c + dc)
                if nb in cell_set and nb not in visited:
                    visited.add(nb)
                    queue.append(nb)
    return len(visited) == len(cell_set)


def _find_port_dir(grid, cr, cc, bc):
    """Find a valid port direction for a sprite centered at (cr,cc) with border color bc."""
    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    random.shuffle(dirs)
    for dr, dc in dirs:
        ir, ic = cr + dr, cc + dc
        er, ec = cr + 2 * dr, cc + 2 * dc
        if not (0 <= ir < GRID_H and 0 <= ic < GRID_W
                and 0 <= er < GRID_H and 0 <= ec < GRID_W):
            continue
        if grid[ir, ic] == bc and grid[er, ec] == 0:
            return (er, ec)
    return None


def _assign_colors(border_colors, num_sprites):
    """Assign roles (dest/source/distractor) and pick center colors for all sprites."""
    remaining = list(range(2, num_sprites))
    num_sources = random.choice(SOURCE_COUNTS) if len(remaining) >= 2 else max(1, len(remaining))
    if num_sources == 0:
        return None
    source_indices = remaining[:num_sources]
    distractor_indices = remaining[num_sources:]

    # Dest center colors = source border colors (lookup key)
    if num_sources == 1:
        dest_center_colors = [border_colors[source_indices[0]]] * 2
    else:
        dest_center_colors = [border_colors[si] for si in source_indices]

    # Source center colors: must avoid bg, grey, own border, and matched dest's border
    source_center_colors = []
    for j, si in enumerate(source_indices):
        forbidden = {BG, GREY, border_colors[si]}
        if num_sources == 1:
            forbidden.update([border_colors[0], border_colors[1]])
        else:
            forbidden.add(border_colors[j])
        candidates = [c for c in range(1, 10) if c not in forbidden]
        if not candidates:
            return None
        source_center_colors.append(random.choice(candidates))

    distractor_center_colors = [
        random.choice([c for c in range(1, 10) if c != GREY and c != border_colors[di]])
        for di in distractor_indices
    ]

    output_dest_centers = (source_center_colors * 2)[:2] if num_sources == 1 else source_center_colors

    return dict(
        source_indices=source_indices, distractor_indices=distractor_indices,
        dest_center_colors=dest_center_colors, source_center_colors=source_center_colors,
        distractor_center_colors=distractor_center_colors, output_dest_centers=output_dest_centers,
    )


def _place_dests(output_grid, shape_type, border_colors, output_dest_centers, min_port_dist):
    """Place 2 destination sprites on the grid. Returns (center_positions, first_port) or None."""
    all_pos = _sprite_positions()
    edge_pos = [p for p in all_pos if _is_edge(p[0], p[1])]
    int_pos = [p for p in all_pos if not _is_edge(p[0], p[1])]
    num_interior_dest = random.choices([0, 1], weights=INTERIOR_DEST_WEIGHTS)[0]

    dest_center_positions = []
    first_port = None

    for i in range(2):
        bc = border_colors[i]
        patch = _make_sprite_patch(shape_type, bc, output_dest_centers[i])
        pool = list(int_pos if i < num_interior_dest else edge_pos)
        random.shuffle(pool)

        placed = False
        for r0, c0 in pool:
            if _overlaps(output_grid, patch, r0, c0):
                continue
            cr, cc_pos = r0 + 1, c0 + 1

            # Temporarily place to check port availability
            _place_sprite(output_grid, patch, r0, c0)
            port = _find_port_dir(output_grid, cr, cc_pos, bc)
            if port is None:
                _erase_sprite(output_grid, patch, r0, c0)
                continue

            # Second dest must be far enough from first port
            if i == 1:
                dist = abs(port[0] - first_port[0]) + abs(port[1] - first_port[1])
                if dist < min_port_dist:
                    _erase_sprite(output_grid, patch, r0, c0)
                    continue

            dest_center_positions.append((cr, cc_pos))
            if i == 0:
                first_port = port
            placed = True
            break

        if not placed:
            return None

    return dest_center_positions


def _gen_attempt():
    shape_type = random.choice(['box', 'plus'])
    palette = [c for c in range(1, 10) if c != GREY]
    num_sprites = random.choice(SPRITE_COUNTS)
    border_colors = random.sample(palette, num_sprites)

    colors = _assign_colors(border_colors, num_sprites)
    if colors is None:
        return None

    target_len = random.randint(PATH_LEN_MIN, PATH_LEN_MAX)
    min_port_dist = max(3, target_len // MIN_PORT_DIST_FRAC)

    output_grid = np.zeros((GRID_H, GRID_W), dtype=int)
    result = _place_dests(output_grid, shape_type, border_colors,
                          colors['output_dest_centers'], min_port_dist)
    if result is None:
        return None
    dest_center_positions = result

    # Find port cells for grey path endpoints
    port_cells = []
    for i in range(2):
        cr, cc_pos = dest_center_positions[i]
        port = _find_port_dir(output_grid, cr, cc_pos, border_colors[i])
        if port is None:
            return None
        port_cells.append(port)

    # Generate grey path
    path_cells = _gen_winding_path(output_grid, port_cells[0], port_cells[1], target_len)
    if path_cells is None or not (PATH_LEN_MIN <= len(path_cells) <= PATH_LEN_MAX):
        return None
    if not _is_8_connected(path_cells):
        return None

    for r, c in path_cells:
        if output_grid[r, c] != BG:
            return None
        output_grid[r, c] = GREY

    # Verify port cells are trail endpoints (4-degree <= 1 within grey)
    for pr, pc in port_cells:
        deg = sum(1 for nr, nc in [(pr - 1, pc), (pr + 1, pc), (pr, pc - 1), (pr, pc + 1)]
                  if 0 <= nr < GRID_H and 0 <= nc < GRID_W and output_grid[nr, nc] == GREY)
        if deg > 1:
            return None

    # Derive input from output: restore original dest center colors
    input_grid = output_grid.copy()
    for i in range(2):
        cr, cc_pos = dest_center_positions[i]
        input_grid[cr, cc_pos] = colors['dest_center_colors'][i]

    # Place source and distractor sprites on input grid
    sprites_to_place = (
        [(border_colors[si], colors['source_center_colors'][j])
         for j, si in enumerate(colors['source_indices'])] +
        [(border_colors[di], colors['distractor_center_colors'][j])
         for j, di in enumerate(colors['distractor_indices'])]
    )
    all_pos = _sprite_positions()
    for bc, cc_color in sprites_to_place:
        patch = _make_sprite_patch(shape_type, bc, cc_color)
        pool = list(all_pos)
        random.shuffle(pool)
        placed = False
        for r0, c0 in pool:
            if not _overlaps(input_grid, patch, r0, c0):
                _place_sprite(input_grid, patch, r0, c0)
                placed = True
                break
        if not placed:
            return None

    # Oracle check
    try:
        out = main(input_grid)
        if np.array_equal(out, output_grid):
            return input_grid
    except Exception:
        pass
    return None


def generate_input():
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {GEN_RETRIES} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg
import itertools
import math
import random


def _find_marker_bar(g: np.ndarray, bg: int) -> tuple[int, str, tuple[int, int]]:
    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
    candidates: list[tuple[int, str, tuple[int, int]]] = []

    for color in colors:
        coords = np.argwhere(g == int(color))
        if coords.shape[0] != 3:
            continue

        rows = sorted(set(map(int, coords[:, 0])))
        cols = sorted(set(map(int, coords[:, 1])))
        if len(rows) == 1 and len(cols) == 3 and cols == list(range(cols[0], cols[0] + 3)):
            candidates.append((int(color), "horizontal", (rows[0], cols[1])))
        elif len(cols) == 1 and len(rows) == 3 and rows == list(range(rows[0], rows[0] + 3)):
            candidates.append((int(color), "vertical", (rows[1], cols[0])))

    assert len(candidates) == 1, "expected a unique three-pixel marker bar"
    return candidates[0]


def _roles(g: np.ndarray) -> tuple[int, int, tuple[int, int], tuple[int, int]]:
    bg = get_bg(g)
    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
    assert len(colors) == 3, "expected target color, marker bar color, and control-pixel color"

    bar_color, axis, center = _find_marker_bar(g, bg)
    control_candidates: list[tuple[int, tuple[int, int]]] = []
    for color in colors:
        if int(color) == int(bar_color):
            continue
        coords = np.argwhere(g == int(color))
        if coords.shape[0] != 1:
            continue
        r, c = map(int, coords[0])
        if abs(r - center[0]) + abs(c - center[1]) == 1:
            control_candidates.append((int(color), (r, c)))

    assert len(control_candidates) == 1, "expected one singleton control pixel adjacent to the bar center"
    control_color, control = control_candidates[0]

    target_colors = [color for color in colors if color not in (bar_color, control_color)]
    assert len(target_colors) == 1, "expected one remaining target color"

    dr = center[0] - control[0]
    dc = center[1] - control[1]
    assert abs(dr) + abs(dc) == 1, "control pixel must touch the marker bar center"
    if axis == "horizontal":
        assert dc == 0, "horizontal marker bars emit vertically"
    else:
        assert dr == 0, "vertical marker bars emit horizontally"

    return int(bg), int(target_colors[0]), center, (dr, dc)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase each target-color object crossed by the ray pointed by the bar-and-control marker.

    Input structure:
    - The background is the dominant color.
    - There is one three-pixel straight marker bar and one singleton control pixel adjacent to the bar center.
    - The remaining non-background color forms multiple 4-connected target objects.

    Rule:
    - Cast a straight ray from the marker bar center in the direction away from the adjacent control pixel.
    - Find every 4-connected target-color object that intersects that ray.
    - Recolor all pixels of those hit target objects to the background; all other pixels stay unchanged.

    Key insight:
    - The whole object is erased when the center ray touches any of its pixels; the full marker bar width is not swept.
    """
    g = np.asarray(grid, dtype=int)
    bg, target_color, center, step = _roles(g)
    height, width = g.shape

    ray: set[tuple[int, int]] = set()
    r = center[0] + step[0]
    c = center[1] + step[1]
    while 0 <= r < height and 0 <= c < width:
        ray.add((int(r), int(c)))
        r += step[0]
        c += step[1]

    target_objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[target_color])
    hit_objects = [
        obj
        for obj in target_objects
        if any(tuple(map(int, coord)) in ray for coord in obj["coords"])
    ]
    assert hit_objects, "expected at least one target object intersecting the marker ray"

    out = g.copy()
    for obj in hit_objects:
        coords = obj["coords"]
        out[coords[:, 0], coords[:, 1]] = int(bg)
    return out

# --------------- generator (o5x) ---------------

# Palette.
BG = 7
TARGET = 4
BAR = 5
CONTROL = 9

# Canvas size bounds.
HEIGHT_MIN, HEIGHT_MAX = 9, 14
WIDTH_MIN, WIDTH_MAX = 10, 13

# Marker and ray geometry.
BAR_CENTER_MARGIN = 2
RAY_LEN_MIN, RAY_LEN_MAX = 6, 8
NEIGHBOR_STEPS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
AXIS_HORIZONTAL, AXIS_VERTICAL = "horizontal", "vertical"

# Target component counts, density, and size caps.
DENSITY_MIN, DENSITY_MAX = 0.17, 0.21
OBJECT_COUNT_MIN, OBJECT_COUNT_MAX = 10, 18
EXPECTED_HIT_OBJECTS, CONNECTIVITY = 2, 4
HIT_EXTRA_CAP, NON_HIT_EXTRA_CAP = 6, 4

# Retry budget for rejection sampling.
GENERATION_ATTEMPTS = 300


def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for dr, dc in NEIGHBOR_STEPS_4:
        rr, cc = r + dr, c + dc
        if 0 <= rr < h and 0 <= cc < w:
            out.append((rr, cc))
    return out


def _ray_cells(center: tuple[int, int], step: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
    r, c = center[0] + step[0], center[1] + step[1]
    cells: list[tuple[int, int]] = []
    while 0 <= r < h and 0 <= c < w:
        cells.append((r, c))
        r += step[0]
        c += step[1]
    return cells


def _marker_candidates(
    h: int,
    w: int,
) -> list[tuple[str, tuple[int, int], tuple[int, int], tuple[int, int]]]:
    candidates: list[tuple[str, tuple[int, int], tuple[int, int], tuple[int, int]]] = []

    for length in range(RAY_LEN_MIN, RAY_LEN_MAX + 1):
        for c in range(BAR_CENTER_MARGIN, w - BAR_CENTER_MARGIN):
            if 1 <= length <= h - 2:
                candidates.append((AXIS_HORIZONTAL, (length, c), (-1, 0), (length + 1, c)))
            r = h - 1 - length
            if 1 <= r <= h - 2:
                candidates.append((AXIS_HORIZONTAL, (r, c), (1, 0), (r - 1, c)))

        for r in range(BAR_CENTER_MARGIN, h - BAR_CENTER_MARGIN):
            if 1 <= length <= w - 2:
                candidates.append((AXIS_VERTICAL, (r, length), (0, -1), (r, length + 1)))
            c = w - 1 - length
            if 1 <= c <= w - 2:
                candidates.append((AXIS_VERTICAL, (r, c), (0, 1), (r, c - 1)))

    return candidates


def _bar_cells(axis: str, center: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = center
    if axis == AXIS_HORIZONTAL:
        return [(r, c - 1), (r, c), (r, c + 1)]
    return [(r - 1, c), (r, c), (r + 1, c)]


def _place_marker(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int], set[tuple[int, int]], list[tuple[int, int]]] | None:
    """Draw one marker and return center, ray step, occupied marker cells, and ray cells."""
    h, w = g.shape
    candidates = _marker_candidates(h, w)
    if not candidates:
        return None

    axis, center, step, control = random.choice(candidates)
    marker: set[tuple[int, int]] = {control}
    bar_cells = _bar_cells(axis, center)
    marker.update(bar_cells)

    for rr, cc in bar_cells:
        g[rr, cc] = BAR
    g[control] = CONTROL
    return center, step, marker, _ray_cells(center, step, h, w)


def _feasible_size_choices(area: int) -> list[tuple[int, int, int]]:
    lo = math.ceil(area * DENSITY_MIN)
    hi = math.floor(area * DENSITY_MAX)
    choices: list[tuple[int, int, int]] = []
    for total_pixels in range(lo, hi + 1):
        for count in range(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX + 1):
            if count > total_pixels:
                continue
            extras = total_pixels - count
            caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)
            max_clustered = (count - 1) // EXPECTED_HIT_OBJECTS
            for clustered in range(max_clustered + 1):
                if clustered > extras:
                    continue
                if extras <= sum(sorted(caps, reverse=True)[:clustered]):
                    choices.append((total_pixels, count, clustered))
    return choices


def _choose_sizes(area: int) -> tuple[list[int], list[int]] | None:
    choices = _feasible_size_choices(area)
    if not choices:
        return None

    total_pixels, count, clustered = random.choice(choices)
    extras = total_pixels - count
    caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)

    if clustered == 0:
        if extras != 0:
            return None
        return [1] * EXPECTED_HIT_OBJECTS, [1] * (count - EXPECTED_HIT_OBJECTS)

    combos = [
        combo
        for combo in itertools.combinations(range(count), clustered)
        if extras <= sum(caps[i] for i in combo)
    ]
    if not combos:
        return None

    chosen = random.choice(combos)
    sizes = [1] * count
    for idx in chosen:
        sizes[idx] += 1
    remaining = extras - clustered

    while remaining > 0:
        available = [idx for idx in chosen if sizes[idx] < caps[idx] + 1]
        if not available:
            return None
        idx = random.choice(available)
        sizes[idx] += 1
        remaining -= 1

    return sizes[:EXPECTED_HIT_OBJECTS], sizes[EXPECTED_HIT_OBJECTS:]


def _touches_existing_target(
    r: int,
    c: int,
    existing: np.ndarray,
    current: set[tuple[int, int]],
) -> bool:
    h, w = existing.shape
    for rr, cc in _neighbors4(r, c, h, w):
        if existing[rr, cc] and (rr, cc) not in current:
            return True
    return False


def _place_object(
    g: np.ndarray,
    size: int,
    forbidden: set[tuple[int, int]],
    seed_pool: list[tuple[int, int]] | None = None,
) -> set[tuple[int, int]] | None:
    """Grow one 4-connected target object without 4-touching prior target objects."""
    h, w = g.shape
    existing = g == TARGET

    if seed_pool is None:
        seed_pool = [(r, c) for r in range(h) for c in range(w)]

    seeds = [
        (r, c)
        for r, c in seed_pool
        if (r, c) not in forbidden
        and g[r, c] == BG
        and not _touches_existing_target(r, c, existing, set())
    ]
    if not seeds:
        return None

    current = {random.choice(seeds)}
    while len(current) < size:
        frontier: set[tuple[int, int]] = set()
        for r, c in current:
            frontier.update(_neighbors4(r, c, h, w))

        options = [
            (r, c)
            for r, c in frontier
            if (r, c) not in current
            and (r, c) not in forbidden
            and g[r, c] == BG
            and not _touches_existing_target(r, c, existing, current)
        ]
        if not options:
            return None
        current.add(random.choice(options))

    for r, c in current:
        g[r, c] = TARGET
    return current


def _hit_count(g: np.ndarray, ray: set[tuple[int, int]]) -> int:
    objects = find_components(g, bg=BG, connectivity=CONNECTIVITY, monochromatic=True, colors=[TARGET])
    return sum(any((int(r), int(c)) in ray for r, c in obj["coords"]) for obj in objects)


def _place_objects(
    g: np.ndarray,
    sizes: list[int],
    forbidden: set[tuple[int, int]],
    seed_pool: list[tuple[int, int]] | None = None,
) -> bool:
    for size in sorted(sizes, reverse=True):
        if _place_object(g, size, forbidden, seed_pool) is None:
            return False
    return True


def _valid_generated_pair(inp: np.ndarray, out: np.ndarray, ray: set[tuple[int, int]]) -> bool:
    objects = find_components(inp, bg=BG, connectivity=CONNECTIVITY, monochromatic=True, colors=[TARGET])
    density = float(np.count_nonzero(inp == TARGET)) / inp.size
    if len(objects) < OBJECT_COUNT_MIN or len(objects) > OBJECT_COUNT_MAX:
        return False
    if not (DENSITY_MIN <= density <= DENSITY_MAX):
        return False
    if _hit_count(inp, ray) != EXPECTED_HIT_OBJECTS:
        return False

    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, out)


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(HEIGHT_MIN, HEIGHT_MAX)
    w = random.randint(WIDTH_MIN, WIDTH_MAX)
    out = np.full((h, w), BG, dtype=int)

    marker = _place_marker(out)
    if marker is None:
        return None
    _, _, marker_cells, ray_cells = marker
    ray = set(ray_cells)

    sizes = _choose_sizes(out.size)
    if sizes is None:
        return None
    hit_sizes, non_hit_sizes = sizes

    blocked_for_output = marker_cells | ray
    if not _place_objects(out, non_hit_sizes, blocked_for_output):
        return None

    inp = out.copy()
    if not _place_objects(inp, hit_sizes, marker_cells, ray_cells):
        return None

    if not _valid_generated_pair(inp, out, ray):
        return None

    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 2f767503 input")

