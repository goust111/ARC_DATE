+def _assemble(sprite: np.ndarray, scheme: tuple[int, int, int, int]) -> np.ndarray:
+    variants = _d4(sprite)
+    return np.block(
+        [
+            [variants[scheme[0]], variants[scheme[1]]],
+            [variants[scheme[2]], variants[scheme[3]]],
+        ]
+    )
