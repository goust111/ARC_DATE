+_GEN_CALL_COUNT = 0
+
+
+def generate_input() -> np.ndarray:
+    """Generate a varied, semantically audited census-ration instance."""
+    global _GEN_CALL_COUNT
+    # One divider-capped paid object in every three consecutive generated
