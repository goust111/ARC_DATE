+def _mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:
+    coords = np.argwhere(mask)
+    coords[:, 0] += int(r0)
+    coords[:, 1] += int(c0)
+    return coords.astype(int)
