def _feasible_dims(area: int) -> list[tuple[int, int]]:
def _build_groups(bg: int) -> tuple[list[dict], list[dict]]:
    """Create duplicate-shape (top) and unique-shape (bottom) component groups."""
    dup_layout = DUP_LAYOUTS[int(_RNG.integers(0, len(DUP_LAYOUTS)))]
    n_singletons = 2 if sum(dup_layout) == 4 else int(_RNG.integers(2, 4))

    colors = [c for c in range(NUM_COLORS) if c != bg]
    _RNG.shuffle(colors)

    used_shape_keys: set[tuple[bytes, tuple[int, int]]] = set()
    top, ci = [], 0
    for count in dup_layout:
        for _ in range(200):
            area = int(_RNG.integers(*AREA_RANGE))
            template = _make_component(area, colors[ci], bg)
            if template["shape_key"] not in used_shape_keys:
                used_shape_keys.add(template["shape_key"])
                break
        else:
            raise RuntimeError("failed to create a new duplicate template shape")
        top.append(template)
        ci += 1
        for _ in range(count - 1):
            top.append(_clone_component(template, colors[ci], bg))
            ci += 1

    bottom = []
    while len(bottom) < n_singletons:
        area = int(_RNG.integers(*AREA_RANGE))
        comp = _make_component(area, colors[ci], bg)
        if comp["shape_key"] in used_shape_keys:
            continue
        used_shape_keys.add(comp["shape_key"])
        bottom.append(comp)
        ci += 1
    return top, bottom


def _gen_attempt() -> np.ndarray | None:
    """Single attempt: build output-first, derive input, validate with oracle."""
    H = int(_RNG.integers(*GRID_H_RANGE))
    W = int(_RNG.integers(*GRID_W_RANGE))
    bg = int(_RNG.integers(0, NUM_COLORS))

    top, bottom = _build_groups(bg)
    _RNG.shuffle(top)
    _RNG.shuffle(bottom)

    if H - max(c["h"] for c in top) - max(c["h"] for c in bottom) < MIN_VERTICAL_GAP:
        return None

    top_cols = _assign_columns([c["w"] for c in top], W)
    bottom_cols = _assign_columns([c["w"] for c in bottom], W)
    if top_cols is None or bottom_cols is None:
        return None

    for comp, c0 in zip(top, top_cols):
        comp["c0"], comp["out_r0"] = c0, 0
    for comp, c0 in zip(bottom, bottom_cols):
        comp["c0"], comp["out_r0"] = c0, H - comp["h"]

    comps = top + bottom
    expected = _build_output(comps, H, W, bg)
    inp = _derive_input(comps, H, W, bg)
    if inp is None:
        return None
    if int(get_bg(inp)) != bg:
        return None

    found = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    if len(found) != len(comps):
        return None
    if Counter(len(c["coords"]) for c in found) != Counter(c["area"] for c in comps):
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 62593bfd sample")
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location
import random
from arc_utils import paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Align a central rectangle to two colored frame-edge controls via rotation/reflection.

    Input structure:
    - bg grid with two solid-colored border edges (distinct non-bg colors).
    - A central filled rectangle with 1px colored guide edges on two sides, colors matching the frame controls.

    Rule:
    - Rotate/mirror the object so its guide edges face the same sides as the matching frame controls.
    - Crop off the 1px guide edges from aligned sides.

    Key insight: Guide-edge colors encode target frame sides; the correct dihedral transform matches both simultaneously.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    def detect_controls_frame(arr: np.ndarray) -> list[tuple[str, int]]:
        H, W = arr.shape
        sides = {
            "top": arr[0, 1:-1],
            "bottom": arr[-1, 1:-1],
            "left": arr[1:-1, 0],
            "right": arr[1:-1, -1],
        }
        cand: list[tuple[str, int, int, int]] = []
        for side, v in sides.items():
            v = list(map(int, v))
            v_nb = [x for x in v if x != int(bg)]
            if not v_nb:
                continue
            col, count = Counter(v_nb).most_common(1)[0]
            # allow up to 1 mismatch (overlap near corners with the other control color)
            if int(count) >= len(v) - 1:
                cand.append((side, int(col), int(count), int(len(v))))
        cand.sort(key=lambda t: (t[2] / t[3], t[2]), reverse=True)
        return [(s, c) for s, c, _cnt, _L in cand[:2]]

    def extract_center_object(arr: np.ndarray) -> np.ndarray:
        H, W = arr.shape
        comps = find_components(arr, bg=int(bg), connectivity=4, monochromatic=False, return_format="dict")
        best = None  # (area, bbox)
        for comp in comps:
            r0, c0, r1, c1 = map(int, comp["bbox"])
            if bool(r0 == 0 or c0 == 0 or r1 == H - 1 or c1 == W - 1):
                continue
            area = int(comp["area"])
            if best is None or area > best[0]:
                best = (area, (r0, c0, r1, c1))
        if best is None:
            return arr.copy()
        _area, b = best
        return crop_bbox(arr, b)

    def guide_edges(arr: np.ndarray) -> dict[str, int]:
        fill = int(Counter(map(int, arr.flatten())).most_common(1)[0][0])
        edges = {
            "top": arr[0, :],
            "bottom": arr[-1, :],
            "left": arr[:, 0],
            "right": arr[:, -1],
        }
        out: dict[str, int] = {}
        for side, v in edges.items():
            v = list(map(int, v))
            v_nf = [x for x in v if x != int(fill)]
            if not v_nf:
                continue
            col, count = Counter(v_nf).most_common(1)[0]
            if int(count) >= len(v) - 1:
                out[side] = int(col)
        return out

    ctrls = detect_controls_frame(g)
    desired = {side: col for side, col in ctrls}
    obj = extract_center_object(g)

    # Try all dihedral transforms: rotations + optional horizontal flip.
    for k in range(4):
        base = np.rot90(obj, int(k))
        for flip in [False, True]:
            t = np.fliplr(base) if flip else base
            gedges = guide_edges(t)
            if all(side in gedges and int(gedges[side]) == int(col) for side, col in desired.items()):
                top = 1 if "top" in desired else 0
                bottom = int(t.shape[0]) - (1 if "bottom" in desired else 0)
                left = 1 if "left" in desired else 0
                right = int(t.shape[1]) - (1 if "right" in desired else 0)
                return t[int(top) : int(bottom), int(left) : int(right)]

    # Fallback: should not happen on this puzzle.
    return obj

