+        "ref_bg": int(left_bg if ref_left else right_bg),
+        "obj_bg": int(right_bg if ref_left else left_bg),
+        "obj_c0": int(sep + 1 if ref_left else 0),
+        "obj_c1": int(w - 1 if ref_left else sep - 1),
