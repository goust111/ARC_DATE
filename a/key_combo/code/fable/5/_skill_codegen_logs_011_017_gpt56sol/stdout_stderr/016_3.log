+    if signature in _SEEN_OUTPUTS:
+        return None
+    _SEEN_OUTPUTS.add(signature)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    """Generate a varied, semantically validated ARC input grid."""
+    for _ in range(300):
+        result = _gen_attempt()
+        if result is not None:
