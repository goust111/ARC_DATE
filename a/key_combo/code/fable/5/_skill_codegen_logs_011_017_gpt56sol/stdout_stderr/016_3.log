+    same_bbox_counterexample = any(
+        a["style"] != b["style"] and a["mask"].shape == b["mask"].shape
+        for i, a in enumerate(specs)
+        for b in specs[i + 1 :]
+    )
+    if not same_bbox_counterexample:
+        return False
