+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    """Find monochromatic 4-connected components using (row, column) coordinates."""
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(grid[r0, c0])
+            if color == bg or bool(seen[r0, c0]):
+                continue
+
+            seen[r0, c0] = True
+            queue = deque([(r0, c0)])
+            coords: list[Coord] = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    rr, cc = r + dr, c + dc
+                    if not (0 <= rr < h and 0 <= cc < w):
+                        continue
+                    if bool(seen[rr, cc]) or int(grid[rr, cc]) != color:
+                        continue
+                    seen[rr, cc] = True
+                    queue.append((rr, cc))
+
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": _bbox(coords),
+                }
+            )
+    return objects
+
+
+def _sprite_style(grid: np.ndarray, obj: dict, bg: int) -> str:
+    """Classify a promised sprite as a filled rectangle or a one-cell frame."""
+    r0, c0, r1, c1 = obj["bbox"]
+    color = int(obj["color"])
