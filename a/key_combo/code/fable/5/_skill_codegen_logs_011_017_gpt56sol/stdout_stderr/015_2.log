+                            "line": int(line),
+                            "separator": int(separator),
+                            "master_side": int(master_side),
+                            "region_a": region_a,
+                            "region_b": region_b,
+                            "cross": cross,
+                            "copy_info": copy_info,
+                            "master": master,
+                            "copy": copy,
+                            "background": int(background),
+                            "foreground": int(foreground),
