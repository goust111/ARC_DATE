from __future__ import annotations

import numpy as np

from arc_utils import bbox, components_mask, crop_bbox, random_sprite
import random


def _split_sections(grid: np.ndarray) -> tuple[str, list[np.ndarray]]:
    h, w = grid.shape
    sep = 1

    sep_rows = [r for r in range(h) if bool(np.all(grid[r, :] == sep))]
    if sep_rows:
        cuts = [-1] + sep_rows + [h]
        return "vertical", [grid[a + 1 : b, :] for a, b in zip(cuts, cuts[1:]) if b > a + 1]

    sep_cols = [c for c in range(w) if bool(np.all(grid[:, c] == sep))]
    cuts = [-1] + sep_cols + [w]
    return "horizontal", [grid[:, a + 1 : b] for a, b in zip(cuts, cuts[1:]) if b > a + 1]


def _solid_color(block: np.ndarray) -> int:
    vals, counts = np.unique(block, return_counts=True)
    return int(vals[int(np.argmax(counts))])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor a cropped template and repeat it according to a component-count stencil.

    Input structure:
    - Solid blue (1) separator rows or columns split the grid into four sections.
    - Section 1 is a black-background shape template; section 2 is a component-count stencil.
    - Sections 3 and 4 are solid color swatches for output foreground and background.

    Rule:
    - Crop section 1 to the bbox of its non-black pixels and recolor it with the two swatches.
    - Count 4-connected non-black components in section 2.
    - Repeat the recolored crop that many times, inserting one background-colored row/column between copies.

    Key insight: The second section encodes only the repeat count; the output orientation
    is inherited from whether the input separators are columns or rows.
    """
    g = np.asarray(grid, dtype=int)
    orientation, sections = _split_sections(g)
    template, repetition_pattern, foreground_block, background_block = sections[:4]

    template_mask = template != 0
    template_bbox = bbox(template_mask)
    if template_bbox is None:
        return np.empty((0, 0), dtype=int)

    foreground = _solid_color(foreground_block)
    background = _solid_color(background_block)
    tile_mask = crop_bbox(template_mask, template_bbox)
    tile = np.where(tile_mask, foreground, background).astype(int)

    n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))
    if n_repeats <= 1:
        return tile

    if orientation == "horizontal":
        sep = np.full((tile.shape[0], 1), background, dtype=int)
        pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
        return np.hstack(pieces)

    sep = np.full((1, tile.shape[1]), background, dtype=int)
    pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
    return np.vstack(pieces)

# --------------- generator (c) ---------------

# --- CFG: tunable generation parameters ---
REPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)
CROP_SIZE_RANGE = (2, 5)             # crop height/width bounds
DENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box
COLOR_POOL = list(range(2, 10))      # fg/bg color choices (2-9 inclusive)
TEMPLATE_COLOR = 4                   # shape drawn in yellow inside template
STENCIL_COLOR = 3                    # blob color in stencil section
SEPARATOR_COLOR = 1                  # blue separator rows/cols
SWATCH_DIM_RANGE = (3, 8)           # varying-axis size for color swatches
STENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size
BLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil
GEN_RETRIES = 300                    # outer generate_input retry limit


def _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:
    """Repeat `tile` n times along the given axis with 1-pixel bg_color separator."""
    if horizontal:
        sep = np.full((tile.shape[0], 1), bg_color, dtype=int)
        pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
        return np.hstack(pieces)
    sep = np.full((1, tile.shape[1]), bg_color, dtype=int)
    pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
    return np.vstack(pieces)


def _make_swatch(shared_dim: int, color: int, horizontal: bool) -> np.ndarray:
    """Create a solid color swatch. shared_dim is the fixed axis; varying axis is random."""
    varying = random.randint(*SWATCH_DIM_RANGE)
    if horizontal:
        return np.full((shared_dim, varying), color, dtype=int)
    return np.full((varying, shared_dim), color, dtype=int)


def _join_sections(sections: list[np.ndarray], shared_dim: int, horizontal: bool) -> np.ndarray:
    """Join sections with single-pixel separator lines of SEPARATOR_COLOR."""
    if horizontal:
        sep = np.full((shared_dim, 1), SEPARATOR_COLOR, dtype=int)
        parts = [sections[0]]
        for s in sections[1:]:
            parts.extend([sep, s])
        return np.hstack(parts)
    sep = np.full((1, shared_dim), SEPARATOR_COLOR, dtype=int)
    parts = [sections[0]]
    for s in sections[1:]:
        parts.extend([sep, s])
    return np.vstack(parts)


def _build_stencil(n_blobs: int, shared_dim: int, horizontal: bool) -> np.ndarray | None:
    """Place n_blobs 2-cell blobs (1x2 or 2x1) of STENCIL_COLOR on a black grid.
    Blobs are separated by >=1 cell of black in all directions."""
    min_varying = max(4, n_blobs * 2 + 2)
    varying_dim = random.randint(min_varying, min_varying + STENCIL_VARYING_EXTRA)

    h, w = (shared_dim, varying_dim) if horizontal else (varying_dim, shared_dim)
    grid = np.zeros((h, w), dtype=int)

    placed = 0
    for _ in range(BLOB_PLACE_RETRIES):
        if placed >= n_blobs:
            break
        br, bc = (1, 2) if random.choice([True, False]) else (2, 1)

        if h - 1 - br < 1 or w - 1 - bc < 1:
            continue
        r = random.randint(1, h - 1 - br)
        c = random.randint(1, w - 1 - bc)

        # Check blob cells + 1-cell neighborhood are all black
        r0, c0 = max(0, r - 1), max(0, c - 1)
        r1, c1 = min(h, r + br + 1), min(w, c + bc + 1)
        if np.any(grid[r0:r1, c0:c1] != 0):
            continue

        grid[r:r + br, c:c + bc] = STENCIL_COLOR
        placed += 1

    return grid if placed == n_blobs else None


def _gen_attempt() -> np.ndarray | None:
    horizontal = random.choice([True, False])
    N = random.randint(*REPEAT_COUNT_RANGE)

    # Generate connected tile shape
    crop_h = random.randint(*CROP_SIZE_RANGE)
    crop_w = random.randint(*CROP_SIZE_RANGE)
    density = random.uniform(*DENSITY_RANGE)
    shape = random_sprite(crop_h, crop_w, density=density, color_palette=[TEMPLATE_COLOR],
                          connectivity=4, symmetry="not_symmetric")

    # Pick distinct fg/bg colors
    fg_color, bg_color = random.sample(COLOR_POOL, 2)

    # Build output
    tile = np.where(shape != 0, fg_color, bg_color).astype(int)
    output = _tile_repeat(tile, N, bg_color, horizontal)

    # Build template: shape in (crop_h+2) x (crop_w+2) black border
    template = np.zeros((crop_h + 2, crop_w + 2), dtype=int)
    template[1:crop_h + 1, 1:crop_w + 1] = shape

    # Build stencil
    shared_dim = (crop_h + 2) if horizontal else (crop_w + 2)
    stencil = _build_stencil(N, shared_dim, horizontal)
    if stencil is None:
        return None

    # Assemble: template | stencil | fg_swatch | bg_swatch
    fg_swatch = _make_swatch(shared_dim, fg_color, horizontal)
    bg_swatch = _make_swatch(shared_dim, bg_color, horizontal)
    inp = _join_sections([template, stencil, fg_swatch, bg_swatch], shared_dim, horizontal)

    # Oracle check
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        pass
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after %d attempts" % GEN_RETRIES)
from __future__ import annotations
import random
from collections import Counter
import numpy as np
from arc_utils import get_bg, flood_fill, neighbors8, in_bounds, label_mask


def main(grid: np.ndarray) -> np.ndarray:
    """
    Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.

    Input structure:
    - Four 5×5 panels in one row, border-separated.
    - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)
               + one 8-isolated indicator pixel.
    - Panels 1–2: source patterns. Panel 3: blank (to fill).

    Rule:
    - Flood-fill (4-conn) from indicator, blocked by wall → inside region.
    - Inside → non-bg from panel 1; outside → non-bg from panel 2.
    - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.

    Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.
    """
    g = np.array(grid, dtype=int)

    border = int(g[0, 0])
    tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]
    t0, t1, t2, _t3 = tiles
    b = int(Counter(t1.flatten()).most_common(1)[0][0])
    assert border != b, "border color must differ from tile background"

    t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])
    cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}
    assert cue_set, "no cue pixels found"

    # --- Indicator = the unique 8-isolated cue pixel ---
    indicator = None
    for r, c in cue_set:
        if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):
            assert indicator is None, "multiple 8-isolated cue pixels"
            indicator = (r, c)
    assert indicator is not None, "no 8-isolated cue pixel found"

    # Indicator must sit at a tile corner or edge midpoint
    valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}
    assert indicator in valid_pos, f"indicator {indicator} not at corner/edge-midpoint"

    wall = cue_set - {indicator}

    # --- Structural assertions (feedback for generate_input agents) ---
    assert (2, 2) in wall, "wall must pass through the grid center (2,2)"

    # Wall must be symmetric about the line from indicator to center (2,2)
    ir, ic = indicator
    dr, dc = 2 - ir, 2 - ic
    if dr == 0:
        _refl = lambda r, c: (4 - r, c)
    elif dc == 0:
        _refl = lambda r, c: (r, 4 - c)
    elif dr * dc > 0:
        _refl = lambda r, c: (c, r)
    else:
        _refl = lambda r, c: (4 - c, 4 - r)
    assert wall == {_refl(r, c) for r, c in wall}, "wall must be symmetric about indicator→center axis"

    sides_touched = set()
    for r, c in wall:
        if r == 0: sides_touched.add("top")
        if r == 4: sides_touched.add("bottom")
        if c == 0: sides_touched.add("left")
        if c == 4: sides_touched.add("right")
    assert len(sides_touched) >= 2, f"wall must span edge-to-edge, only touches {sides_touched}"

    # --- Flood fill inside region ---
    EMPTY, WALL, INSIDE = 0, 1, 2
    tmp = np.zeros((5, 5), dtype=int)
    for r, c in wall:
        tmp[r, c] = WALL
    flood_fill(tmp, indicator[0], indicator[1], INSIDE, connectivity=4)
    inside = {(int(r), int(c)) for r, c in np.argwhere(tmp == INSIDE)}

    outside = {(r, c) for r in range(5) for c in range(5)} - inside - wall
    assert outside, "wall must partition the grid — outside region is empty"

    # Wall 4-connectivity determines boundary blending behavior:
    # axis-aligned walls (4-connected) allow t2 fallback; diagonal walls don't.
    wall_mask = np.zeros((5, 5), dtype=bool)
    for r, c in wall:
        wall_mask[r, c] = True
    _, n_comp = label_mask(wall_mask, connectivity=4)
    wall_4conn = (n_comp == 1)

    # --- Build output tile ---
    out3 = np.full((5, 5), b, dtype=int)
    for r in range(5):
        for c in range(5):
            v1, v2 = int(t1[r, c]), int(t2[r, c])
            if (r, c) in inside:
                if v1 != b:
                    out3[r, c] = v1
            elif (r, c) in wall:
                if v1 != b:
                    out3[r, c] = v1
                elif wall_4conn and v2 != b:
                    out3[r, c] = v2
            else:
                if v2 != b:
                    out3[r, c] = v2

    out = g.copy()
    out[1:6, 1 + 6 * 3 : 1 + 6 * 3 + 5] = out3
    return out

# --------------- generator (subagent) ---------------

# ── Tunables ──────────────────────────────────────────────────────────────────
TILE_SZ = 5                    # each panel is 5x5
GRID_ROWS, GRID_COLS = 7, 25  # fixed output grid shape
NUM_COLORS = 10                # ARC color palette size

T1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range
T2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range
ORBIT_INCLUDE_PROB = 0.55      # per-orbit inclusion probability for pattern sampling
PATTERN_RETRIES = 200          # max retries per _sample_symmetric_pattern call
GEN_RETRIES = 300              # max retries in generate_input outer loop
LBEND_PROB = 0.2               # L-bend wall probability (eval ratio ~4:1 straight:L-bend)

# ── Symmetric pattern orbits (D1+D2 symmetry on 5x5) ─────────────────────────
_ORBITS = [
    [(0, 0), (4, 4)],
    [(0, 4), (4, 0)],
    [(2, 2)],
    [(1, 1), (3, 3)],
    [(1, 3), (3, 1)],
    [(0, 1), (1, 0), (3, 4), (4, 3)],
    [(0, 2), (2, 0), (2, 4), (4, 2)],
    [(0, 3), (3, 0), (1, 4), (4, 1)],
    [(1, 2), (2, 1), (2, 3), (3, 2)],
]


def _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,
                              min_px: int, max_px: int) -> np.ndarray | None:
    """Sample a 5x5 grid symmetric under both diagonals, with fg pixel count in
    [min_px, max_px].  Randomizes orbit order, includes each greedily within
    the max budget, retries until min is met."""
    for _ in range(PATTERN_RETRIES):
        order = list(range(len(_ORBITS)))
        rng.shuffle(order)
        p = np.full((TILE_SZ, TILE_SZ), bg, dtype=int)
        count = 0
        for i in order:
            orbit = _ORBITS[i]
            if count + len(orbit) > max_px:
                continue
            if rng.random() < ORBIT_INCLUDE_PROB:
                for r, c in orbit:
                    p[r, c] = fg
                count += len(orbit)
        if min_px <= count <= max_px:
            return p
    return None


# ── Precomputed (indicator, wall) configurations ─────────────────────────────
# 8 straight + 12 L-bend combos, all verified to partition the 5x5 grid.
_STRAIGHT_CONFIGS = [
    ((0, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row
    ((4, 2), frozenset({(2,0),(2,1),(2,2),(2,3),(2,4)})),          # row
    ((2, 0), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col
    ((2, 4), frozenset({(0,2),(1,2),(2,2),(3,2),(4,2)})),          # col
    ((0, 0), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag
    ((4, 4), frozenset({(0,4),(1,3),(2,2),(3,1),(4,0)})),          # anti-diag
    ((0, 4), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag
    ((4, 0), frozenset({(0,0),(1,1),(2,2),(3,3),(4,4)})),          # diag
]
_LBEND_CONFIGS = [
    ((0, 0), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L
    ((0, 0), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R
    ((4, 4), frozenset({(2,2),(1,2),(0,2),(2,1),(2,0)})),          # U+L
    ((4, 4), frozenset({(2,2),(3,2),(4,2),(2,3),(2,4)})),          # D+R
    ((0, 4), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R
    ((0, 4), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L
    ((4, 0), frozenset({(2,2),(1,2),(0,2),(2,3),(2,4)})),          # U+R
    ((4, 0), frozenset({(2,2),(3,2),(4,2),(2,1),(2,0)})),          # D+L
    ((4, 2), frozenset({(2,2),(1,1),(0,0),(1,3),(0,4)})),          # NW+NE
    ((0, 2), frozenset({(2,2),(3,1),(4,0),(3,3),(4,4)})),          # SW+SE
    ((2, 4), frozenset({(2,2),(1,1),(0,0),(3,1),(4,0)})),          # NW+SW
    ((2, 0), frozenset({(2,2),(1,3),(0,4),(3,3),(4,4)})),          # NE+SE
]


def _flood_inside(wall: frozenset, indicator: tuple[int, int]) -> set[tuple[int, int]]:
    tmp = np.zeros((TILE_SZ, TILE_SZ), dtype=int)
    for r, c in wall:
        tmp[r, c] = 1
    flood_fill(tmp, indicator[0], indicator[1], 2, connectivity=4)
    return {(int(r), int(c)) for r, c in np.argwhere(tmp == 2)}


# ── Main generation loop ─────────────────────────────────────────────────────

def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    # 1. Colors: border != tile_bg; cue/t1/t2 mutually distinct and != tile_bg.
    palette = list(range(NUM_COLORS))
    tile_bg = rng.choice(palette)
    other = [c for c in palette if c != tile_bg]
    cue_color, t1_color, t2_color = rng.sample(other, 3)
    border = rng.choice(other)

    # 2. Wall + indicator (4:1 straight:L-bend ratio).
    pool = _LBEND_CONFIGS if rng.random() < LBEND_PROB else _STRAIGHT_CONFIGS
    indicator, wall = rng.choice(pool)
    inside = _flood_inside(wall, indicator)

    # 3. Tile-1 / Tile-2 symmetric patterns.
    t1 = _sample_symmetric_pattern(tile_bg, t1_color, rng,
                                   min_px=T1_MIN_PX, max_px=T1_MAX_PX)
    t2 = _sample_symmetric_pattern(tile_bg, t2_color, rng,
                                   min_px=T2_MIN_PX, max_px=T2_MAX_PX)
    if t1 is None or t2 is None:
        return None

    # 4. Tile-0 (cue tile): bg + wall + indicator drawn in cue_color.
    t0 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)
    for r, c in wall:
        t0[r, c] = cue_color
    t0[indicator[0], indicator[1]] = cue_color

    # 5. Composite output tile-3.
    wall_mask = np.zeros((TILE_SZ, TILE_SZ), dtype=bool)
    for r, c in wall:
        wall_mask[r, c] = True
    _, n_comp = label_mask(wall_mask, connectivity=4)
    wall_4conn = (n_comp == 1)
    outside = set((r, c) for r in range(TILE_SZ) for c in range(TILE_SZ)) - inside - wall
    out3 = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)
    for r in range(TILE_SZ):
        for c in range(TILE_SZ):
            v1, v2 = int(t1[r, c]), int(t2[r, c])
            if (r, c) in inside:
                if v1 != tile_bg: out3[r, c] = v1
            elif (r, c) in wall:
                if v1 != tile_bg: out3[r, c] = v1
                elif wall_4conn and v2 != tile_bg: out3[r, c] = v2
            else:
                if v2 != tile_bg: out3[r, c] = v2

    # 6. Assemble 7x25 input grid (tile-3 input is blank).
    t3_in = np.full((TILE_SZ, TILE_SZ), tile_bg, dtype=int)
    g = np.full((GRID_ROWS, GRID_COLS), border, dtype=int)
    for j, tile in enumerate([t0, t1, t2, t3_in]):
        g[1:6, 1 + 6 * j: 1 + 6 * j + 5] = tile

    # 7. Oracle: solver output must match hand-built composite.
    expected = g.copy()
    expected[1:6, 1 + 6 * 3: 1 + 6 * 3 + 5] = out3
    got = main(g)
    if not np.array_equal(got, expected):
        return None
    return g


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(GEN_RETRIES):
        g = _gen_attempt(rng)
        if g is not None:
            return g
    raise RuntimeError(f"generate_input failed after {GEN_RETRIES} attempts")

from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import get_bg
import itertools
import random
from arc_utils import is_contiguous, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Reorder 5×5 blocks into a connected strip by matching edge foreground pixels.

    Input structure:
    - bg = background; sep = divider color (full row/column lines).
    - Several 5×5 sprite blocks in a grid, separated by sep lines.

    Rule:
    - Two blocks "connect" when their facing edges share foreground pixels at the same offset (e.g., A's right edge ∩ B's left edge).
    - Chain all blocks in the orientation (horizontal or vertical) that admits a complete sequence.
    - Output is a 1×N strip of blocks in chain order, separated by sep lines.

    Key insight: Edge-contact overlap determines both block ordering and output orientation.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    def _most_common(a: np.ndarray) -> int:
        return int(Counter(map(int, a.flatten())).most_common(1)[0][0])

    def _find_sep(a: np.ndarray) -> int:
        H, W = a.shape
        cand: list[int] = []
        for r in range(H):
            if bool((a[int(r), :] == int(a[int(r), 0])).all()) and int(a[int(r), 0]) != int(bg):
                cand.append(int(a[int(r), 0]))
        for c in range(W):
            if bool((a[:, int(c)] == int(a[0, int(c)])).all()) and int(a[0, int(c)]) != int(bg):
                cand.append(int(a[0, int(c)]))
        return int(Counter(cand).most_common(1)[0][0])

    sep = _find_sep(g)

    def _full_sep_rows(a: np.ndarray) -> list[int]:
        return [int(r) for r in range(int(a.shape[0])) if bool((a[int(r), :] == int(sep)).all())]

    def _full_sep_cols(a: np.ndarray) -> list[int]:
        return [int(c) for c in range(int(a.shape[1])) if bool((a[:, int(c)] == int(sep)).all())]

    def _split_by_rows(a: np.ndarray) -> list[np.ndarray]:
        rows = _full_sep_rows(a)
        segs: list[np.ndarray] = []
        start = 0
        for r in rows + [int(a.shape[0])]:
            if int(r) > int(start):
                segs.append(a[int(start) : int(r), :].copy())
            start = int(r + 1)
        return segs

    def _split_by_cols(a: np.ndarray) -> list[np.ndarray]:
        cols = _full_sep_cols(a)
        segs: list[np.ndarray] = []
        start = 0
        for c in cols + [int(a.shape[1])]:
            if int(c) > int(start):
                segs.append(a[:, int(start) : int(c)].copy())
            start = int(c + 1)
        return segs

    def _render_strip(blocks: list[np.ndarray], axis: int) -> np.ndarray:
        # axis=0: vertical stack (sep rows), axis=1: horizontal stack (sep cols)
        n = int(len(blocks))
        if int(axis) == 0:
            out = np.full((int(n * 5 + (n - 1)), 5), int(bg), dtype=int)
            rr = 0
            for i, b in enumerate(blocks):
                out[int(rr) : int(rr + 5), :] = b
                rr += 5
                if int(i) < int(n - 1):
                    out[int(rr), :] = int(sep)
                    rr += 1
            return out
        out = np.full((5, int(n * 5 + (n - 1))), int(bg), dtype=int)
        cc = 0
        for i, b in enumerate(blocks):
            out[:, int(cc) : int(cc + 5)] = b
            cc += 5
            if int(i) < int(n - 1):
                out[:, int(cc)] = int(sep)
                cc += 1
        return out

    def _split_blocks() -> list[np.ndarray]:
        """Return list of 5x5 blocks (order doesn't matter; we will match by connect)."""
        rows = _full_sep_rows(g)
        cols = _full_sep_cols(g)
        if rows and cols:
            r = int(rows[0])
            c = int(cols[0])
            return [
                g[:r, :c],
                g[:r, int(c + 1) :],
                g[int(r + 1) :, :c],
                g[int(r + 1) :, int(c + 1) :],
            ]
        if rows:
            return _split_by_rows(g)
        if cols:
            return _split_by_cols(g)
        return []

    def _contacts(block: np.ndarray) -> dict[str, set[int]]:
        """Edge contact sets (offsets) for the block's foreground."""
        bbg = int(_most_common(block))
        m = block != int(bbg)
        top = set(np.where(m[0, :])[0].tolist())
        bot = set(np.where(m[-1, :])[0].tolist())
        left = set(np.where(m[:, 0])[0].tolist())
        right = set(np.where(m[:, -1])[0].tolist())
        return {"top": top, "bot": bot, "left": left, "right": right}

    def _find_chain(blocks: list[np.ndarray], orient: str):
        """Find an ordering p of indices such that consecutive blocks connect in orient."""
        import itertools

        cont = [_contacts(b) for b in blocks]

        def ok(a: int, b: int) -> bool:
            if orient == "h":
                return len(cont[int(a)]["right"] & cont[int(b)]["left"]) > 0
            return len(cont[int(a)]["bot"] & cont[int(b)]["top"]) > 0

        idx = list(range(int(len(blocks))))
        for perm in itertools.permutations(idx):
            if all(ok(perm[i], perm[i + 1]) for i in range(len(idx) - 1)):
                return perm
        return None

    blocks = _split_blocks()
    assert not (not blocks)

    chain_h = _find_chain(blocks, "h")
    chain_v = _find_chain(blocks, "v")

    if chain_h is not None and chain_v is None:
        ordered = [blocks[i] for i in chain_h]
        return _render_strip(ordered, axis=1)
    if chain_v is not None and chain_h is None:
        ordered = [blocks[i] for i in chain_v]
        return _render_strip(ordered, axis=0)
    assert not (chain_h is not None and chain_v is not None), "ambiguous: both H and V chains found"
    assert chain_h is not None or chain_v is not None, "must find at least one valid chain"

# --------------- generator (Codex attempt 2) ---------------

# -- Configuration constants --------------------------------------------------
BG = 7                          # background color
SEP = 6                         # separator color
PALETTE = [1, 2, 3, 4, 5, 8, 9]  # allowed foreground colors

BLOCK_SIZE = 5                  # sprite dimensions (square)
FG_AREA_MIN = 4                 # min foreground pixels per block
FG_AREA_MAX = 10                # max foreground pixels per block
EDGE_CONTACT_OFFSETS = [1, 2, 3]  # valid shared-edge contact rows/cols (interior only)
FILLER_ROWS = [1, 3]            # fallback interior rows for minimum-area seed

GRID_LAYOUT_PROB = 0.5          # probability of 2x2 grid layout when n=4
MAX_RETRIES = 300               # outer generate_input retry budget
# -----------------------------------------------------------------------------

_OTHER = {"h": "v", "v": "h"}
# Edge-pair keys: (leading edge of predecessor, trailing edge of successor)
_EDGE_PAIRS = {"h": ("right", "left"), "v": ("bot", "top")}
# _make_block keyword mapping per orientation:
#   orient -> (leading_kw, trailing_kw)
_ORIENT_KW = {"h": ("left", "right"), "v": ("top", "bottom")}


def _edge_sets(block: np.ndarray) -> dict[str, set[int]]:
    """Return sets of fg-pixel offsets on each edge of a 5x5 block."""
    mask = block != BG
    return {
        "top": set(np.where(mask[0])[0].tolist()),
        "bot": set(np.where(mask[-1])[0].tolist()),
        "left": set(np.where(mask[:, 0])[0].tolist()),
        "right": set(np.where(mask[:, -1])[0].tolist()),
    }


def _count_orders(blocks: list[np.ndarray], orient: str) -> int:
    """Count how many permutations form a valid chain in the given orientation."""
    contacts = [_edge_sets(block) for block in blocks]
    lead, trail = _EDGE_PAIRS[orient]

    def ok(a: int, b: int) -> bool:
        return bool(contacts[a][lead] & contacts[b][trail])

    total = 0
    for perm in itertools.permutations(range(len(blocks))):
        if all(ok(perm[i], perm[i + 1]) for i in range(len(perm) - 1)):
            total += 1
    return total


def _interior_frontier(mask: np.ndarray) -> list[tuple[int, int]]:
    """Return interior cells (rows/cols 1-3) adjacent to the mask but not yet set."""
    interior = mask[1:4, 1:4]
    # 4-neighbor dilation within interior
    has_neighbor = np.zeros_like(interior)
    has_neighbor[1:, :] |= interior[:-1, :]
    has_neighbor[:-1, :] |= interior[1:, :]
    has_neighbor[:, 1:] |= interior[:, :-1]
    has_neighbor[:, :-1] |= interior[:, 1:]
    # also check neighbors from border rows/cols of the full mask
    has_neighbor[0, :] |= mask[0, 1:4]   # row above interior
    has_neighbor[2, :] |= mask[4, 1:4]   # row below interior
    has_neighbor[:, 0] |= mask[1:4, 0]   # col left of interior
    has_neighbor[:, 2] |= mask[1:4, 4]   # col right of interior
    candidates = has_neighbor & ~interior
    rs, cs = np.where(candidates)
    return [(int(r) + 1, int(c) + 1) for r, c in zip(rs, cs)]


def _base_mask(left_offset: int | None, right_offset: int | None,
               target_area: int) -> np.ndarray | None:
    """Build a connected fg mask on a 5x5 grid with prescribed left/right edge contacts.

    The mask is seeded from the edge-contact offsets, then grown randomly through
    interior cells until target_area is reached.  Returns None on constraint violation.
    """
    S = BLOCK_SIZE
    mask = np.zeros((S, S), dtype=bool)

    # Seed from edge contacts -- horizontal arm + vertical spine to center col
    if left_offset is not None:
        mask[left_offset, 0:3] = True
        mask[min(left_offset, 2):max(left_offset, 2) + 1, 2] = True
    if right_offset is not None:
        mask[right_offset, 2:S] = True
        mask[min(right_offset, 2):max(right_offset, 2) + 1, 2] = True

    if mask.sum() < FG_AREA_MIN:
        mask[random.choice(FILLER_ROWS), 2] = True

    # Grow to target area via random frontier expansion (interior cells only)
    while mask.sum() < target_area:
        frontier = _interior_frontier(mask)
        if not frontier:
            return None
        r, c = random.choice(frontier)
        mask[r, c] = True

    # --- Validate edge constraints ---
    if left_offset is None:
        if mask[:, 0].any():
            return None
    elif np.where(mask[:, 0])[0].tolist() != [left_offset]:
        return None

    if right_offset is None:
        if mask[:, S - 1].any():
            return None
    elif np.where(mask[:, S - 1])[0].tolist() != [right_offset]:
        return None

    if mask[0].any() or mask[S - 1].any():
        return None
    if any(mask[r].all() for r in range(S)):
        return None
    if any(mask[:, c].all() for c in range(S)):
        return None
    if not is_contiguous(mask.astype(int), background=0, connectivity=4):
        return None
    return mask


def _make_block(color: int, *, left: int | None = None, right: int | None = None,
                top: int | None = None, bottom: int | None = None) -> np.ndarray | None:
    """Generate a single 5x5 block with the given color and edge-contact constraints."""
    if top is not None or bottom is not None:
        mask = _base_mask(bottom, top, random.randint(FG_AREA_MIN, FG_AREA_MAX))
        if mask is None:
            return None
        mask = np.rot90(mask, 1)
    else:
        mask = _base_mask(left, right, random.randint(FG_AREA_MIN, FG_AREA_MAX))
        if mask is None:
            return None

    block = np.full((BLOCK_SIZE, BLOCK_SIZE), BG, dtype=int)
    block[mask] = color
    return block


def _render_strip(blocks: list[np.ndarray], orient: str) -> np.ndarray:
    """Render blocks into a 1xN strip with SEP dividers."""
    n = len(blocks)
    S = BLOCK_SIZE
    stride = S + 1  # block size + 1 separator column/row
    if orient == "h":
        out = np.full((S, n * S + (n - 1)), BG, dtype=int)
        for i, block in enumerate(blocks):
            paste(out, block, 0, i * stride)
            if i < n - 1:
                out[:, i * stride + S] = SEP
    else:
        out = np.full((n * S + (n - 1), S), BG, dtype=int)
        for i, block in enumerate(blocks):
            paste(out, block, i * stride, 0)
            if i < n - 1:
                out[i * stride + S, :] = SEP
    return out


def _render_input(blocks: list[np.ndarray], output_orient: str) -> np.ndarray:
    """Scramble blocks and arrange into an input layout (2x2 grid or strip)."""
    n = len(blocks)
    perm = list(range(n))
    while perm == list(range(n)):
        random.shuffle(perm)
    scrambled = [blocks[i] for i in perm]

    if n == 4 and random.random() < GRID_LAYOUT_PROB:
        S = BLOCK_SIZE
        grid = np.full((2 * S + 1, 2 * S + 1), BG, dtype=int)
        grid[S, :] = SEP
        grid[:, S] = SEP
        for block, (r0, c0) in zip(scrambled, [(0, 0), (0, S + 1), (S + 1, 0), (S + 1, S + 1)]):
            paste(grid, block, r0, c0)
        return grid

    return _render_strip(scrambled, _OTHER[output_orient])


def _gen_attempt() -> np.ndarray | None:
    """Try once to generate a valid input grid. Returns None on failure."""
    n = random.choice([3, 4])
    orient = random.choice(["h", "v"])
    shared_offsets = random.sample(EDGE_CONTACT_OFFSETS, n - 1)

    lead_kw, trail_kw = _ORIENT_KW[orient]
    blocks: list[np.ndarray] = []
    for i in range(n):
        kw = {}
        if i > 0:
            kw[lead_kw] = shared_offsets[i - 1]
        if i < n - 1:
            kw[trail_kw] = shared_offsets[i]
        block = _make_block(random.choice(PALETTE), **kw)
        if block is None:
            return None
        blocks.append(block)

    if _count_orders(blocks, orient) != 1 or _count_orders(blocks, _OTHER[orient]) != 0:
        return None

    out = _render_strip(blocks, orient)
    inp = _render_input(blocks, orient)
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"failed to generate a valid input after {MAX_RETRIES} attempts")

