+    has_run = bool(np.any(mask[:-1] & mask[1:]))
+    isolated = [
+        c
+        for c in range(mask.size)
+        if mask[c]
+        and (c == 0 or not mask[c - 1])
+        and (c == mask.size - 1 or not mask[c + 1])
+    ]
