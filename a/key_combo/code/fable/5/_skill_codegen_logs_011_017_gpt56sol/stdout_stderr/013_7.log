+
+def _growth_trace(
+    grid: np.ndarray,
+) -> tuple[int, int, int, list[tuple[int, frozenset[int]]]]:
+    """Simulate successful active rows and return their coordinates by generation."""
+    g = np.asarray(grid, dtype=int)
