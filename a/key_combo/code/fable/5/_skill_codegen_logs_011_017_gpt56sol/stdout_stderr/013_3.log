+    r, c = start
+    dr, dc = direction
+    r0, c0, r1, c1 = bbox
+    if dr < 0:
+        return r - r0
+    if dr > 0:
+        return r1 - r
+    if dc < 0:
+        return c - c0
+    return c1 - c
