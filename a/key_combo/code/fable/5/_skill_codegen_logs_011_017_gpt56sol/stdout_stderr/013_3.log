+def _semantic_validation(grid: np.ndarray, metadata: dict) -> bool:
+    """Reject shortcuts and verify intended semantics, not only oracle closure."""
+    try:
+        out, trace, parsed = _parse_and_trace(grid)
+    except (AssertionError, ValueError):
