+def _mirror_for_turn(incoming: tuple[int, int], outgoing: tuple[int, int]) -> int:
+    if _reflected(incoming, SLASH) == outgoing:
+        return SLASH
+    assert _reflected(incoming, BACKSLASH) == outgoing
+    return BACKSLASH
