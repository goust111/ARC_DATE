+        for r in range(r0 + 2, r1 - 1)
+        for c in range(c0 + 2, c1 - 1)
+        if (r, c) not in forbidden
+        and all(abs(r - rr) + abs(c - cc) > 1 for rr, cc in forbidden)
+    ]
