+def _gap_pool(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return (
+        [(r0, c) for c in range(c0 + 1, c1)]
+        + [(r1, c) for c in range(c0 + 1, c1)]
+        + [(r, c0) for r in range(r0 + 1, r1)]
+        + [(r, c1) for r in range(r0 + 1, r1)]
+    )
