+    active_hits = trace["mirror_hits"]
+    if len(active_hits) < 2 or set(active_hits) != metadata["active_mirrors"]:
+        return False
+    if len(set(map(int, grid.ravel())) & {SLASH, BACKSLASH}) != 2:
+        return False
