+    return True
+
+
+def generate_input() -> np.ndarray:
+    """Generate varied, oracle-checked halls while cycling all terminal branches."""
+    global _branch_index
+    branch = BRANCHES[_branch_index % len(BRANCHES)]
+    rng = random.Random()
+    for _ in range(500):
