+        assert np.array_equal(solved, expected)
+        assert np.array_equal(solved[g == WALL_COLOR], g[g == WALL_COLOR])
+        source_mask = ~np.isin(g, (BACKGROUND_COLOR, WALL_COLOR))
+        assert np.array_equal(solved[source_mask], g[source_mask])
