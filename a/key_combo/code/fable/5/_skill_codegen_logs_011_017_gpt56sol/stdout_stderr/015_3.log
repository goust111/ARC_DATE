+
+# The stable visible palette across examples makes every role unambiguous.
+BACKGROUND_COLOR = 0
+WALL_COLOR = 5
+FRONTIER_COLOR = 2
+SOURCE_COLORS = (1, 3, 4, 6, 7, 8, 9)
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
