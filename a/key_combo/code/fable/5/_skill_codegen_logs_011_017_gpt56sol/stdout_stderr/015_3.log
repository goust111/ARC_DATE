+    minimum = np.min(distances, axis=0)
+    return eligible & (np.sum(distances == minimum[None, :, :], axis=0) >= 2)
+
+
+def _source_layout_is_semantic(
+    passable: np.ndarray,
+    sources: list[tuple[int, int]],
