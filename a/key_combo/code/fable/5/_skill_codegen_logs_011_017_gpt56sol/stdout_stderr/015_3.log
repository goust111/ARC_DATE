+    rng = random.Random()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(mode, rng)
+        if grid is not None:
+            _generation_counter += 1
+            return grid
+    raise RuntimeError(f"failed to generate wavefront-frontier mode {mode}")

