+    grid[passable] = BACKGROUND_COLOR
+    colors = rng.sample(SOURCE_COLORS, len(sources))
+    rng.shuffle(colors)
+    for source, color in zip(sources, colors):
+        grid[source] = int(color)
+    return grid
+
+
