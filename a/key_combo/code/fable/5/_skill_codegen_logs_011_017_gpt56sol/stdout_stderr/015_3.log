+    remaining = {tuple(map(int, cell)) for cell in np.argwhere(mask)}
+    count = 0
+    while remaining:
+        count += 1
+        stack = [remaining.pop()]
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in _neighbors(mask.shape, r, c):
+                if (nr, nc) in remaining:
+                    remaining.remove((nr, nc))
+                    stack.append((nr, nc))
