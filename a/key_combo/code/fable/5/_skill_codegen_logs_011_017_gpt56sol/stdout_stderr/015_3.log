def _bfs_counts(passable: np.ndarray, starts: list[Coord]) -> tuple[np.ndarray, np.ndarray]:
    h, w = passable.shape
    dist = np.full((h, w), -1, dtype=int)
    count = np.zeros((h, w), dtype=int)
    q = deque()
    for r, c in starts:
        rr = int(r)
        cc = int(c)
        if not passable[rr, cc] or dist[rr, cc] == 0:
            continue
        dist[rr, cc] = 0
        count[rr, cc] = 1
        q.append((rr, cc))

    while q:
        r, c = q.popleft()
        nd = int(dist[r, c]) + 1
        for nr, nc in neighbors4(r, c):
            if not (0 <= nr < h and 0 <= nc < w and passable[nr, nc]):
                continue
            if dist[nr, nc] == -1:
                dist[nr, nc] = nd
                count[nr, nc] = count[r, c]
                q.append((nr, nc))
            elif dist[nr, nc] == nd:
                count[nr, nc] = min(2, int(count[nr, nc]) + int(count[r, c]))
    return dist, count


def _unique_shortest_path(passable: np.ndarray, starts: list[Coord], goals: list[Coord]) -> tuple[list[Coord], int]:
    dist, count = _bfs_counts(passable, starts)
    reachable = [(int(dist[r, c]), (int(r), int(c))) for r, c in goals if dist[int(r), int(c)] >= 0]
    assert reachable, "endpoints must connect after filtering doors"
    shortest = min(d for d, _ in reachable)

    total = 0
    end_coord: Coord | None = None
    for r, c in goals:
        rr = int(r)
        cc = int(c)
        if int(dist[rr, cc]) != shortest:
            continue
        total = min(2, total + int(count[rr, cc]))
        if count[rr, cc] > 0 and end_coord is None:
            end_coord = (rr, cc)
    assert total == 1 and end_coord is not None, "expected a unique shortest path"

    start_set = {(int(r), int(c)) for r, c in starts}
    path = [end_coord]
    cur = end_coord
    while cur not in start_set:
        r, c = cur
        preds = []
        for nr, nc in neighbors4(r, c):
            if 0 <= nr < passable.shape[0] and 0 <= nc < passable.shape[1]:
                if int(dist[nr, nc]) == int(dist[r, c]) - 1 and int(count[nr, nc]) > 0:
                    preds.append((nr, nc))
        assert len(preds) == 1, "path backtracking must stay unique"
        cur = preds[0]
        path.append(cur)
    path.reverse()
    return path, shortest


def _analyze_grid(grid: np.ndarray) -> dict:
    g = np.asarray(grid, dtype=int)
    roles = _identify_roles(g)
    bg = int(roles["bg"])
    wall = int(roles["wall"])
    endpoint_color = int(roles["endpoint"])
    doors = _collect_doors(g, bg, wall)

    all_door_mask = np.zeros_like(g, dtype=bool)
    blocked_wrong_doors = np.zeros_like(g, dtype=bool)
    for door in doors:
        coords = door["coords"]
        width = int(door["width"])
        for r, c in coords:
            all_door_mask[int(r), int(c)] = True
            if width != int(roles["key_width"]):
                blocked_wrong_doors[int(r), int(c)] = True

    passable_bg = (g == bg) | (g == endpoint_color)
    passable_filtered = passable_bg & ~blocked_wrong_doors

    start_comp, goal_comp = roles["endpoint_components"]
    starts = [(int(r), int(c)) for r, c in start_comp]
    goals = [(int(r), int(c)) for r, c in goal_comp]
    path, filtered_len = _unique_shortest_path(passable_filtered, starts, goals)

    dist_all, _ = _bfs_counts(passable_bg, starts)
    all_reachable = [int(dist_all[r, c]) for r, c in goals if dist_all[int(r), int(c)] >= 0]
    assert all_reachable, "endpoints must connect in the original maze"
    all_len = min(all_reachable)

    return {
        **roles,
        "doors": doors,
        "door_mask": all_door_mask,
        "wrong_door_mask": blocked_wrong_doors,
        "path": path,
        "filtered_len": int(filtered_len),
        "all_len": int(all_len),
        "passable_filtered": passable_filtered,
        "passable_all": passable_bg,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Count the detached marker run, use that length as the key width, and paint the unique shortest route that only crosses matching-width doors.

    Input structure:
    - The grid has a dominant background, one wall color forming thin orthogonal partitions, two same-color endpoint blocks, and one detached marker run of a third color.
    - Door gaps appear as short 1-to-3-cell openings inside horizontal or vertical wall segments.
    - The marker run sits near the border in empty space and does not touch the wall structure.

    Rule:
    - Measure the marker-run length k.
    - Reinterpret every door whose width is not exactly k as blocked wall, while doors of width k stay traversable.
    - Find the unique shortest 4-connected path between the two endpoint components under that rewritten connectivity.
    - Recolor only the background cells on that path with the endpoint color; walls, door gaps, endpoints, and the marker remain unchanged.

    Key insight:
    - The marker run is the key that rewrites which openings count as doors, so the visually shorter route through a wrong-width gap is a decoy until connectivity is filtered first.
    """
    g = np.asarray(grid, dtype=int)
    info = _analyze_grid(g)

    out = g.copy()
    endpoint_color = int(info["endpoint"])
    for r, c in info["path"]:
        rr = int(r)
        cc = int(c)
        if out[rr, cc] == int(info["bg"]) and not info["door_mask"][rr, cc]:
            out[rr, cc] = endpoint_color
    return out


def _room_mask() -> np.ndarray:
    mask = np.zeros((ROOM_H, ROOM_W), dtype=bool)
    cr = ROOM_H // 2
    cc = ROOM_W // 2
    mask[cr, :] = True
    mask[:, cc] = True
    mask[max(0, cr - 1) : min(ROOM_H, cr + 2), 0] = True
    mask[max(0, cr - 1) : min(ROOM_H, cr + 2), ROOM_W - 1] = True
    mask[0, max(0, cc - 1) : min(ROOM_W, cc + 2)] = True
    mask[ROOM_H - 1, max(0, cc - 1) : min(ROOM_W, cc + 2)] = True
    return mask


def _edge(a: Node, b: Node) -> Edge:
from __future__ import annotations

from collections import deque
import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
PINK = 6
ORANGE = 7
TEAL = 8
MAROON = 9

EMPTY_COLOR = BLACK
WALL_COLOR = GREY
TIE_COLOR = PINK
GRID_COLOR = TEAL
SEED_COLORS = (BLUE, RED, GREEN, YELLOW, ORANGE, MAROON)
INF = 10**9


def _line_indices(g: np.ndarray, axis: int) -> list[int]:
    if axis == 0:
        return [r for r in range(g.shape[0]) if np.all(g[r, :] == GRID_COLOR)]
    return [c for c in range(g.shape[1]) if np.all(g[:, c] == GRID_COLOR)]


def _regular_grid_lines(g: np.ndarray) -> tuple[list[int], list[int]]:
    rows = _line_indices(g, 0)
    cols = _line_indices(g, 1)
    assert len(rows) >= 3 and len(cols) >= 3, "expected at least a 2x2 lattice"
    assert rows[0] == 0 and rows[-1] == g.shape[0] - 1
    assert cols[0] == 0 and cols[-1] == g.shape[1] - 1

    row_steps = np.diff(rows)
    col_steps = np.diff(cols)
    assert len(set(map(int, row_steps))) == 1 and int(row_steps[0]) >= 2
    assert len(set(map(int, col_steps))) == 1 and int(col_steps[0]) >= 2
    return rows, cols


def _read_cells(g: np.ndarray) -> tuple[np.ndarray, list[int], list[int]]:
    rows, cols = _regular_grid_lines(g)
    cell_rows = len(rows) - 1
    cell_cols = len(cols) - 1
    cells = np.empty((cell_rows, cell_cols), dtype=int)

    for rr in range(cell_rows):
        for cc in range(cell_cols):
            block = g[rows[rr] + 1 : rows[rr + 1], cols[cc] + 1 : cols[cc + 1]]
            assert block.size > 0
            color = int(block[0, 0])
            assert np.all(block == color), "each lattice cell must be solid"
            assert color != GRID_COLOR, "grid-line color may not be used as a cell fill"
            cells[rr, cc] = color
    return cells, rows, cols


def _find_seeds(cells: np.ndarray) -> list[tuple[int, int, int]]:
    seeds: list[tuple[int, int, int]] = []
    for r in range(cells.shape[0]):
        for c in range(cells.shape[1]):
            color = int(cells[r, c])
            if color not in (EMPTY_COLOR, WALL_COLOR):
                assert color != TIE_COLOR, "pink is reserved for equal-distance output"
                seeds.append((r, c, color))
    assert len(seeds) == 2, "expected exactly two seed cells"
    assert seeds[0][2] != seeds[1][2], "seed cells must have different colors"
    return seeds


def _bfs(walls: np.ndarray, seed: tuple[int, int]) -> np.ndarray:
    h, w = walls.shape
    dist = np.full((h, w), INF, dtype=int)
    sr, sc = seed
    assert not bool(walls[sr, sc])
    dist[sr, sc] = 0
    q: deque[tuple[int, int]] = deque([(sr, sc)])

    while q:
        r, c = q.popleft()
        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= nr < h and 0 <= nc < w and not bool(walls[nr, nc]):
                if dist[nr, nc] == INF:
                    dist[nr, nc] = dist[r, c] + 1
                    q.append((nr, nc))
    return dist


def _paint_cell(out: np.ndarray, rows: list[int], cols: list[int], r: int, c: int, color: int) -> None:
    out[rows[r] + 1 : rows[r + 1], cols[c] + 1 : cols[c + 1]] = int(color)


def main(grid: np.ndarray) -> np.ndarray:
    """Fill a walled lattice maze by shortest-path territory expansion from two colored seed cells.

    Input structure:
    A cyan one-pixel grid partitions the canvas into equal rectangular cells.
    Exactly two non-black, non-grey cells are solid seed cells with different
    colors. Some whole cells are grey walls, and the remaining whole cells are
    black empty ground.

    Rule:
    Treat the rectangular cells as the graph nodes, adjacent only up, down,
    left, and right. Grey wall cells are blocked. Every black cell is recolored
    with the seed color whose cell-graph shortest-path distance is smaller; if
    both distances are equal, it becomes pink. Seeds, grey walls, and cyan grid
    lines are preserved.

    Key insight:
    Distance is measured in lattice steps after respecting the grey walls, so a
    visually nearby seed can lose when the path must detour around the maze.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    cells, rows, cols = _read_cells(g)
    seeds = _find_seeds(cells)
    walls = cells == WALL_COLOR
    (r0, c0, color0), (r1, c1, color1) = seeds

    dist0 = _bfs(walls, (r0, c0))
    dist1 = _bfs(walls, (r1, c1))

    out = g.copy()
    for r in range(cells.shape[0]):
        for c in range(cells.shape[1]):
            if int(cells[r, c]) != EMPTY_COLOR:
                continue
            d0 = int(dist0[r, c])
            d1 = int(dist1[r, c])
            assert min(d0, d1) < INF, "every empty cell must be reachable"
            if d0 < d1:
                fill = color0
            elif d1 < d0:
                fill = color1
            else:
                fill = TIE_COLOR
            _paint_cell(out, rows, cols, r, c, fill)
    return out


# --------------- generator ---------------

CELL_ROWS_RANGE = (5, 9)
CELL_COLS_RANGE = (5, 10)
CELL_SIZE_VALUES = (2, 3)
EXTRA_WALL_RATE_RANGE = (0.04, 0.13)
MAX_GENERATION_ATTEMPTS = 2000


def _sample_dimensions(rng: np.random.Generator) -> tuple[int, int, int, int] | None:
    cell_h = int(rng.choice(CELL_SIZE_VALUES))
    cell_w = int(rng.choice(CELL_SIZE_VALUES))
    max_cell_rows = min(CELL_ROWS_RANGE[1], (30 - 1) // (cell_h + 1))
    max_cell_cols = min(CELL_COLS_RANGE[1], (30 - 1) // (cell_w + 1))
    if max_cell_rows < CELL_ROWS_RANGE[0] or max_cell_cols < CELL_COLS_RANGE[0]:
        return None
    rows = int(rng.integers(CELL_ROWS_RANGE[0], max_cell_rows + 1))
    cols = int(rng.integers(CELL_COLS_RANGE[0], max_cell_cols + 1))
    return rows, cols, cell_h, cell_w


def _base_barrier(
    rows: int,
    cols: int,
    rng: np.random.Generator,
) -> tuple[np.ndarray, str, int, int]:
    walls = np.zeros((rows, cols), dtype=bool)
    orientation = "vertical" if int(rng.integers(2)) == 0 else "horizontal"

    if orientation == "vertical":
        index = int(rng.integers(1, cols - 1))
        if cols >= 7:
            index = int(rng.integers(2, cols - 2))
        gap = int(rng.integers(0, rows))
        walls[:, index] = True
        walls[gap, index] = False
    else:
        index = int(rng.integers(1, rows - 1))
        if rows >= 7:
            index = int(rng.integers(2, rows - 2))
        gap = int(rng.integers(0, cols))
        walls[index, :] = True
        walls[index, gap] = False
    return walls, orientation, index, gap


def _choose_seeds(
    walls: np.ndarray,
    orientation: str,
    index: int,
    rng: np.random.Generator,
) -> tuple[tuple[int, int], tuple[int, int]] | None:
    rows, cols = walls.shape
    if orientation == "vertical":
        side_a = [(r, c) for r in range(rows) for c in range(index) if not walls[r, c]]
        side_b = [(r, c) for r in range(rows) for c in range(index + 1, cols) if not walls[r, c]]
    else:
        side_a = [(r, c) for r in range(index) for c in range(cols) if not walls[r, c]]
        side_b = [(r, c) for r in range(index + 1, rows) for c in range(cols) if not walls[r, c]]

    if not side_a or not side_b:
        return None
    seed_a = side_a[int(rng.integers(0, len(side_a)))]
    seed_b = side_b[int(rng.integers(0, len(side_b)))]
    if int(rng.integers(2)):
        seed_a, seed_b = seed_b, seed_a
    return seed_a, seed_b


def _add_extra_walls(
    walls: np.ndarray,
    seeds: tuple[tuple[int, int], tuple[int, int]],
    rng: np.random.Generator,
) -> np.ndarray:
    out = walls.copy()
    seed_set = set(seeds)
    rate = float(rng.uniform(*EXTRA_WALL_RATE_RANGE))
    for r in range(out.shape[0]):
        for c in range(out.shape[1]):
            if out[r, c] or (r, c) in seed_set:
                continue
            if rng.random() < rate:
                out[r, c] = True
    return out


def _classify_cells(
    walls: np.ndarray,
    seeds: tuple[tuple[int, int], tuple[int, int]],
    seed_colors: tuple[int, int],
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    dist0 = _bfs(walls, seeds[0])
    dist1 = _bfs(walls, seeds[1])
    labels = np.full(walls.shape, EMPTY_COLOR, dtype=int)
    labels[walls] = WALL_COLOR
    labels[seeds[0]] = seed_colors[0]
    labels[seeds[1]] = seed_colors[1]

    for r in range(walls.shape[0]):
        for c in range(walls.shape[1]):
            if walls[r, c] or (r, c) == seeds[0] or (r, c) == seeds[1]:
                continue
            d0 = int(dist0[r, c])
            d1 = int(dist1[r, c])
            if min(d0, d1) >= INF:
                labels[r, c] = -1
            elif d0 < d1:
                labels[r, c] = seed_colors[0]
            elif d1 < d0:
                labels[r, c] = seed_colors[1]
            else:
                labels[r, c] = TIE_COLOR
    return labels, dist0, dist1


def _naive_labels(
    walls: np.ndarray,
    seeds: tuple[tuple[int, int], tuple[int, int]],
    seed_colors: tuple[int, int],
) -> np.ndarray:
    labels = np.full(walls.shape, EMPTY_COLOR, dtype=int)
    labels[walls] = WALL_COLOR
    labels[seeds[0]] = seed_colors[0]
    labels[seeds[1]] = seed_colors[1]
    for r in range(walls.shape[0]):
        for c in range(walls.shape[1]):
            if walls[r, c] or (r, c) == seeds[0] or (r, c) == seeds[1]:
                continue
            d0 = abs(r - seeds[0][0]) + abs(c - seeds[0][1])
            d1 = abs(r - seeds[1][0]) + abs(c - seeds[1][1])
            if d0 < d1:
                labels[r, c] = seed_colors[0]
            elif d1 < d0:
                labels[r, c] = seed_colors[1]
            else:
                labels[r, c] = TIE_COLOR
    return labels


def _semantic_ok(
    walls: np.ndarray,
    seeds: tuple[tuple[int, int], tuple[int, int]],
    seed_colors: tuple[int, int],
) -> tuple[bool, np.ndarray | None]:
    expected, dist0, dist1 = _classify_cells(walls, seeds, seed_colors)
    if np.any(expected == -1):
        return False, None

    empty = ~(walls.copy())
    empty[seeds[0]] = False
    empty[seeds[1]] = False
    assigned = set(map(int, expected[empty].ravel()))
    if TIE_COLOR not in assigned:
        return False, None
    if seed_colors[0] not in assigned or seed_colors[1] not in assigned:
        return False, None

    naive = _naive_labels(walls, seeds, seed_colors)
    if not np.any((expected != naive) & empty):
        return False, None

    seed_distance = int(dist0[seeds[1]])
    if seed_distance >= INF or seed_distance < 4:
        return False, None
    if int(np.sum(walls)) < max(3, min(walls.shape) - 1):
        return False, None
    return True, expected


def _render_cells(cells: np.ndarray, cell_h: int, cell_w: int) -> np.ndarray:
    rows, cols = cells.shape
    out = np.full((rows * (cell_h + 1) + 1, cols * (cell_w + 1) + 1), EMPTY_COLOR, dtype=int)
    out[:: cell_h + 1, :] = GRID_COLOR
    out[:, :: cell_w + 1] = GRID_COLOR

    for r in range(rows):
        for c in range(cols):
            color = int(cells[r, c])
            r0 = r * (cell_h + 1) + 1
            c0 = c * (cell_w + 1) + 1
            out[r0 : r0 + cell_h, c0 : c0 + cell_w] = color
    return out

