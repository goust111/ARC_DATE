+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _row_segments(mask: np.ndarray) -> list[tuple[int, int, int]]:
+    """List True runs as (row, inclusive_start_col, inclusive_end_col)."""
