+    # cannot be mistaken for copying one representative segment shape.
+    cursor = 0
+    varied_groups = 0
+    for quota in quotas:
+        group_lengths = lengths[cursor : cursor + quota]
+        varied_groups += int(len(set(group_lengths)) >= 2)
+        cursor += quota
