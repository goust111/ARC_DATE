+    varied_groups = 0
+    for quota in quotas:
+        group_lengths = lengths[cursor : cursor + quota]
+        varied_groups += int(len(set(group_lengths)) >= 2)
+        cursor += quota
+    if varied_groups < max(2, len(quotas) - 1):
+        return False
+    return True
