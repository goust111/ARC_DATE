    options = []
    for quadrant in range(QUADRANT_COUNT):
        cells = _quadrant_cells(h, w, axis_r, axis_c, quadrant)
        counts = _valid_counts(len(cells))
        if counts:
            options.append((quadrant, cells, counts))
    if not options:
        return None
    _, cells, possible_counts = random.choice(options)
    marker_count = random.choice(possible_counts)
    color_count = random.randint(MARKER_COLOR_RANGE[0], min(MARKER_COLOR_RANGE[1], marker_count))
    return h, w, axis_r, axis_c, cells, marker_count, color_count


def _sample_markers(cells: list[tuple[int, int]], marker_count: int, color_count: int):
    """Sample cross color, source cells, and marker color assignments."""
    cross_color = random.choice([color for color in PALETTE if color != BG])
    marker_colors = random.sample([color for color in PALETTE if color not in (BG, cross_color)], color_count)
    random.shuffle(cells)
    marker_cells = cells[:marker_count]
    assignments: list[int] = []
    for color, count in zip(marker_colors, _color_counts(marker_count, color_count)):
        assignments.extend([color] * count)
    random.shuffle(assignments)
    return cross_color, marker_cells, assignments


def _render_pair(h: int, w: int, axis_r: int, axis_c: int, cross_color: int, marker_cells, assignments):
    """Render input and oracle output, or return None when reflected colors conflict."""
    inp = np.full((h, w), BG, dtype=int)
    out = np.full((h, w), BG, dtype=int)
    inp[axis_r, :] = out[axis_r, :] = cross_color
    inp[:, axis_c] = out[:, axis_c] = cross_color
    for (r, c), color in zip(marker_cells, assignments):
        inp[r, c] = color
        reflected = ((r, c), (2 * axis_r - r, c), (r, 2 * axis_c - c), (2 * axis_r - r, 2 * axis_c - c))
        for rr, cc in reflected:
            if 0 <= rr < h and 0 <= cc < w:
                if out[rr, cc] not in (BG, color):
                    return None
                out[rr, cc] = color
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    layout = _sample_layout()
    if layout is None:
        return None

    h, w, axis_r, axis_c, cells, marker_count, color_count = layout
    cross_color, marker_cells, assignments = _sample_markers(cells, marker_count, color_count)
    pair = _render_pair(h, w, axis_r, axis_c, cross_color, marker_cells, assignments)
    if pair is None:
        return None
    inp, out = pair

    try:
        solved = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import Color
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.

    Input structure:
    - The grid is an even square split into four equal quadrants.
    - Black is the background.
    - The upper-left and upper-right quadrants are control regions.
    - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.

    Rule:
    - Output height is the number of non-background pixels in the upper-left quadrant.
    - Output width is the number of non-background pixels in the upper-right quadrant.
    - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.
    - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.

    Key insight:
    - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h == w and h % 2 == 0 and w % 2 == 0

    bg = int(Color.BLACK)
    qh, qw = h // 2, w // 2
    upper_left = g[:qh, :qw]
    upper_right = g[:qh, qw:]
    fill_tile = g[qh:, :qw]
    stencil = g[qh:, qw:]

    out_h = int(np.count_nonzero(upper_left != bg))
    out_w = int(np.count_nonzero(upper_right != bg))
    assert out_h > 0 and out_w > 0

    out = np.empty((out_h, out_w), dtype=int)
    if not np.any(stencil != bg):
        for r in range(out_h):
            for c in range(out_w):
                value = int(fill_tile[r % qh, c % qw])
                assert value != bg
                out[r, c] = value
        return out

    for r in range(out_h):
        for c in range(out_w):
            value = int(stencil[r % qh, c % qw])
            if value == bg:
                fill_r = r // qh
                fill_c = c // qw
                assert fill_r < qh and fill_c < qw
                value = int(fill_tile[fill_r, fill_c])
                assert value != bg
            out[r, c] = value

    return out

# --------------- generator (o5x) ---------------

from math import ceil

# ── configuration constants ──────────────────────────────────────────
BLACK = 0
COLORS = tuple(range(1, 10))

GRID_SIZES = (4, 8, 16)                # allowed input grid side-lengths N
STENCIL_EMPTY_PROB = 0.16               # chance lower-right is all-black
LL_SOLID_PROB = 0.70                    # chance fill tile is single-color
LL_MULTI_COLOR_RANGE = (2, 3)           # color count when fill tile is multi-color
STENCIL_SINGLE_COLOR_PROB = 0.75        # chance stencil uses one fg color
STENCIL_MULTI_COLOR_RANGE = (2, 4)      # color count when stencil is multi-color
STENCIL_FG_FRAC = (0.30, 0.75)          # fg fraction range for random stencil mode
STENCIL_FRAME_MIN_Q = 4                 # min quadrant size to allow frame stencil
CONTROL_SINGLE_COLOR_PROB = 0.85        # chance control quadrant uses one color
CONTROL_RECT_PROB = 0.85                # chance control pixels form an axis-aligned rect
UL_MAX_COLORS = 3                       # max distinct colors in upper-left control
UR_MAX_COLORS = 2                       # max distinct colors in upper-right control
OUTPUT_DIM_MIN = 3                      # minimum output height/width
OUTPUT_DIM_MAX = 16                     # maximum output height/width
OUTPUT_AREA_MAX = 256                   # maximum output area
GEN_MAX_RETRIES = 300                   # retry budget for generate_input


# ── palette helpers ──────────────────────────────────────────────────

def _palette(k: int, pool=COLORS) -> list[int]:
    """Return k distinct colors sampled from pool."""
    pool = list(pool)
    random.shuffle(pool)
    return pool[:k]


def _random_color_array(shape: tuple[int, ...], palette: list[int]) -> np.ndarray:
    """Fill an array by drawing each cell independently from palette."""
    return np.array([random.choice(palette) for _ in range(int(np.prod(shape)))],
                    dtype=int).reshape(shape)


# ── coordinate orderings for control quadrant ────────────────────────

def _ordered_coords(q: int, mode: str) -> list[tuple[int, int]]:
    """Return all (r,c) in a qxq grid in a layout-dependent order."""
    coords = [(r, c) for r in range(q) for c in range(q)]
    if mode == "rect":
        r0, c0 = random.randint(0, q - 1), random.randint(0, q - 1)
        return [((r + r0) % q, (c + c0) % q) for r, c in coords]
    if mode == "rows":
        rows, cols = list(range(q)), list(range(q))
        random.shuffle(rows)
        random.shuffle(cols)
        return [(r, c) for r in rows for c in cols]
    if mode == "compact":
        ar, ac = random.randrange(q), random.randrange(q)
        random.shuffle(coords)
        return sorted(coords, key=lambda rc: (abs(rc[0] - ar) + abs(rc[1] - ac), random.random()))
    # fallback
    random.shuffle(coords)
    return coords


# ── quadrant builders ────────────────────────────────────────────────

def _make_lower_left(q: int, palette: list[int],
                     required_coords: list[tuple[int, int]] | None = None) -> np.ndarray:
    """Build the fill tile (all non-black) using stripe/solid/diagonal patterns."""
    k = len(palette)
    tile = np.empty((q, q), dtype=int)
    mode = "solid" if k == 1 else random.choice(["rows", "cols", "rows", "cols", "diagonal"])

    if mode == "solid":
        tile[:] = palette[0]
    elif mode == "rows":
        offset = random.randrange(k)
        for r in range(q):
            tile[r, :] = palette[(r + offset) % k]
    elif mode == "cols":
        offset = random.randrange(k)
        for c in range(q):
            tile[:, c] = palette[(c + offset) % k]
    elif mode == "diagonal":
        offset = random.randrange(k)
        rr, cc = np.mgrid[:q, :q]
        idx = (rr + cc + offset) % k
        for i, color in enumerate(palette):
            tile[idx == i] = color

    # ensure every palette color appears at least once
    existing = set(map(int, np.unique(tile)))
    missing = [c for c in palette if c not in existing]
    if missing:
        fix_coords = list(required_coords) if required_coords is not None else \
            [(r, c) for r in range(q) for c in range(q)]
        random.shuffle(fix_coords)
        for color, (r, c) in zip(missing, fix_coords):
            tile[r, c] = color
    return tile


def _make_stencil(q: int, palette: list[int]) -> np.ndarray:
    """Build the stencil tile (black = holes filled from fill tile)."""
    tile = np.zeros((q, q), dtype=int)
    modes = ["checker", "row_stripe", "col_stripe", "random", "random"]
    if q >= STENCIL_FRAME_MIN_Q:
        modes.append("frame")
    mode = random.choice(modes)

    if mode == "checker":
        parity = random.randrange(2)
        mask = (np.arange(q)[:, None] + np.arange(q)[None, :]) % 2 == parity
        tile[mask] = _random_color_array((int(mask.sum()),), palette)
    elif mode == "frame":
        t = random.randint(1, max(1, q // 4))
        mask = np.ones((q, q), dtype=bool)
        mask[t:q - t, t:q - t] = False
        tile[mask] = _random_color_array((int(mask.sum()),), palette)
    elif mode == "row_stripe":
        parity = random.randrange(2)
        for r in range(q):
            if r % 2 == parity:
                tile[r, :] = _random_color_array((q,), palette)
    elif mode == "col_stripe":
        parity = random.randrange(2)
        for c in range(q):
            if c % 2 == parity:
                tile[:, c] = _random_color_array((q,), palette)
    else:  # random scatter
        area = q * q
        lo = max(1, int(ceil(STENCIL_FG_FRAC[0] * area)))
        hi = max(lo, int(STENCIL_FG_FRAC[1] * area))
        fg_count = random.randint(lo, hi)
        coords = [(r, c) for r in range(q) for c in range(q)]
        random.shuffle(coords)
        for r, c in coords[:fg_count]:
            tile[r, c] = random.choice(palette)
    return tile


def _make_control(q: int, count: int, max_colors: int, pool: list[int]) -> np.ndarray:
    """Build a control quadrant with exactly `count` non-black pixels."""
    k = 1 if random.random() < CONTROL_SINGLE_COLOR_PROB else \
        random.randint(2, min(max_colors, count, len(pool)))
    pal = _palette(k, pool)
    tile = np.full((q, q), BLACK, dtype=int)

    factors = [(h, w) for h in range(1, q + 1) for w in range(1, q + 1) if h * w == count]
    if factors and random.random() < CONTROL_RECT_PROB:
        h, w = random.choice(factors)
        r0 = random.randint(0, q - h)
        c0 = random.randint(0, q - w)
        tile[r0:r0 + h, c0:c0 + w] = _random_color_array((h, w), pal)
    else:
        mode = random.choice(["rect", "compact", "rows"])
        coords = _ordered_coords(q, mode)[:count]
        for r, c in coords:
            tile[r, c] = random.choice(pal)
    return tile


# ── oracle / assembly ────────────────────────────────────────────────

def _expected_output(fill_tile: np.ndarray, stencil: np.ndarray,
                     out_h: int, out_w: int) -> np.ndarray:
    """Reproduce the solver's tiling logic for oracle validation."""
    q = fill_tile.shape[0]
    rr, cc = np.mgrid[:out_h, :out_w]
    if not np.any(stencil != BLACK):
        return fill_tile[rr % q, cc % q]
    tiled = stencil[rr % q, cc % q]
    bg_mask = tiled == BLACK
    tiled[bg_mask] = fill_tile[rr[bg_mask] // q, cc[bg_mask] // q]
    return tiled


def _gen_attempt() -> np.ndarray | None:
    """Try once to produce a valid grid; return None on failure."""
    n = random.choice(GRID_SIZES)
    q = n // 2
    stencil_empty = random.random() < STENCIL_EMPTY_PROB

    # -- palettes --
    ll_k = 1 if random.random() < LL_SOLID_PROB else random.randint(*LL_MULTI_COLOR_RANGE)
    ll_palette = _palette(ll_k)
    if stencil_empty:
        stencil_palette = []
    else:
        st_k = 1 if random.random() < STENCIL_SINGLE_COLOR_PROB else \
            random.randint(*STENCIL_MULTI_COLOR_RANGE)
        stencil_palette = _palette(st_k)

    output_colors = set(ll_palette) | set(stencil_palette)
    control_pool = [c for c in COLORS if c not in output_colors]
    if not control_pool:
        return None

    # -- output dimensions --
    lo = max(OUTPUT_DIM_MIN, q)
    hi = min(OUTPUT_DIM_MAX, q * q)
    valid_dims = [
        (h, w) for h in range(lo, hi + 1) for w in range(lo, hi + 1)
        if h * w <= OUTPUT_AREA_MAX and (stencil_empty or ceil(h / q) * ceil(w / q) >= ll_k)
    ]
    if not valid_dims:
        return None
    out_h, out_w = random.choice(valid_dims)

    # -- build quadrants --
    used_fill = [(r, c) for r in range(ceil(out_h / q)) for c in range(ceil(out_w / q))]
    fill_tile = _make_lower_left(q, ll_palette, used_fill)
    stencil = np.zeros((q, q), dtype=int) if stencil_empty else _make_stencil(q, stencil_palette)
    upper_left = _make_control(q, out_h, UL_MAX_COLORS, control_pool)
    upper_right = _make_control(q, out_w, UR_MAX_COLORS, control_pool)

    # -- assemble & validate --
    grid = np.zeros((n, n), dtype=int)
    grid[:q, :q] = upper_left
    grid[:q, q:] = upper_right
    grid[q:, :q] = fill_tile
    grid[q:, q:] = stencil

    expected = _expected_output(fill_tile, stencil, out_h, out_w)
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
import random


def _solid_separator_row(g: np.ndarray, bg: int) -> int:
    rows = [
        r
        for r in range(g.shape[0])
        if np.all(g[r] == int(g[r, 0])) and int(g[r, 0]) != int(bg)
    ]
    assert len(rows) == 1, "expected one solid non-background separator row"
    return int(rows[0])


def _legend_mapping(g: np.ndarray, sep: int, bg: int) -> tuple[dict[int, int], int]:
    top = g[:sep]
    comps = find_components(top, bg=bg, connectivity=4, monochromatic=True, return_format="dict")

    sprites = []
    markers = []
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        h = int(r1 - r0 + 1)
        w = int(c1 - c0 + 1)
        area = int(comp["area"])
        if area == 1:
            markers.append(comp)
        else:
            assert h == w and area == h * w, "legend sprites must be filled squares"
            sprites.append(comp)

    assert len(sprites) == len(markers) and len(sprites) > 0, "legend must pair each sprite with one marker"

    sizes = {int(s["bbox"][2] - s["bbox"][0] + 1) for s in sprites}
    assert len(sizes) == 1, "all legend sprites must have the same size"
    size = sizes.pop()
    assert size % 2 == 1, "legend sprite size must have a center pixel"

    marker_rows = {int(m["coords"][0][0]) for m in markers}
    assert len(marker_rows) == 1, "legend markers must lie on one row"
    marker_colors = [int(m["color"]) for m in markers]
    assert len(set(marker_colors)) == len(marker_colors), "legend marker colors must be unique"

    sprites.sort(key=lambda s: (int(s["bbox"][1] + s["bbox"][3]), int(s["bbox"][0])))
    markers.sort(key=lambda m: (int(m["coords"][0][1]), int(m["coords"][0][0])))

    mapping: dict[int, int] = {}
    for sprite, marker in zip(sprites, markers):
        _sr0, sc0, _sr1, sc1 = sprite["bbox"]
        mr, mc = map(int, marker["coords"][0])
        assert mc == (int(sc0) + int(sc1)) // 2, "marker must align with its sprite center column"
        assert mr > int(sprite["bbox"][2]), "marker must sit below its sprite"
        mapping[int(marker["color"])] = int(sprite["color"])

    return mapping, int(size)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replace each marker below the separator with the mapped top legend square centered on that marker.

    Input structure:
    - The background surrounds a top legend, one solid non-background separator row, and a lower marker field.
    - The legend contains equal-size filled square sprites, with a singleton marker below each sprite and aligned to its center column.
    - The lower field contains only background and marker colors from the legend.

    Rule:
    - Pair legend markers to legend sprites by left-to-right position.
    - Discard the legend and separator; keep the grid width and the rows below the separator.
    - In the lower field, replace every marker pixel by a filled square of the paired sprite color, centered at the marker location.

    Key insight: The top area is a positional color legend, and the actual output is the post-separator marker field expanded by that legend.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    sep = _solid_separator_row(g, bg)
    mapping, size = _legend_mapping(g, sep, bg)

    lower = g[sep + 1 :]
    out = np.full_like(lower, bg)
    radius = size // 2

    for r, c in np.argwhere(lower != bg):
        key = int(lower[r, c])
        assert key in mapping, "lower field marker must appear in the legend"
        r0 = int(r) - radius
        c0 = int(c) - radius
        r1 = r0 + size
        c1 = c0 + size
        assert 0 <= r0 and 0 <= c0 and r1 <= out.shape[0] and c1 <= out.shape[1], "expanded square must fit in output"
        assert np.all(out[r0:r1, c0:c1] == bg), "expanded squares must not overlap"
        out[r0:r1, c0:c1] = mapping[key]

    return out

# --------------- generator (o5x) ---------------

# Canvas and legend geometry.
BACKGROUND_COLOR, SEPARATOR_COLOR = 7, 6
FIELD_SHAPE = (13, 11)
FIELD_WIDTH = FIELD_SHAPE[1]
SQUARE_SIZE = 3
SQUARE_RADIUS = SQUARE_SIZE // 2
LEGEND_HEIGHT, LEGEND_MARKER_ROW, LEGEND_COLUMN_STRIDE = 6, 4, 4

# Palette and object counts.
PALETTE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
NUM_COLOR_PAIRS, SQUARE_COUNT_CHOICES = 3, [8, 9]

EMPTY, MAX_GENERATION_ATTEMPTS = 0, 300


def _color_pairs() -> tuple[list[int], list[int]]:
    """Return disjoint sprite and marker palettes in legend order."""
    picked = random.sample(PALETTE_COLORS, NUM_COLOR_PAIRS * 2)
    return picked[:NUM_COLOR_PAIRS], picked[NUM_COLOR_PAIRS:]


def _place_centers(n: int) -> list[tuple[int, int]] | None:
    """Place non-overlapping 3x3 squares and return their centers."""
    occ = np.full(FIELD_SHAPE, EMPTY, dtype=int)
    patch = np.ones((SQUARE_SIZE, SQUARE_SIZE), dtype=int)
    centers: list[tuple[int, int]] = []
    for _ in range(n):
        try:
            r0, c0 = random_free_location(occ, patch, transparent=EMPTY)
        except ValueError:
            return None
        paste(occ, patch, r0, c0)
        centers.append((r0 + SQUARE_RADIUS, c0 + SQUARE_RADIUS))
    return centers


def _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:
    """Connect square indices whose rendered 3x3 blocks share an edge."""
    neighbors = [set() for _ in centers]
    for i, (r1, c1) in enumerate(centers):
        for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):
            dr = abs(r1 - r2)
            dc = abs(c1 - c2)
            if (dr == SQUARE_SIZE and dc < SQUARE_SIZE) or (dc == SQUARE_SIZE and dr < SQUARE_SIZE):
                neighbors[i].add(j)
                neighbors[j].add(i)
    return neighbors


def _assign_square_ids(centers: list[tuple[int, int]]) -> list[int] | None:
    """Assign all color ids while preventing same-color touching squares."""
    neighbors = _touch_graph(centers)
    order = list(range(len(centers)))
    random.shuffle(order)
    order.sort(key=lambda i: len(neighbors[i]), reverse=True)
    ids: list[int | None] = [None] * len(centers)
    required = set(range(NUM_COLOR_PAIRS))

    def backtrack(pos: int, used: set[int]) -> bool:
        if pos == len(order):
            return used == required
        if len(required - used) > len(order) - pos:
            return False
        i = order[pos]
        choices = list(range(NUM_COLOR_PAIRS))
        random.shuffle(choices)
        for color_id in choices:
            if any(ids[j] == color_id for j in neighbors[i]):
                continue
            ids[i] = color_id
            if backtrack(pos + 1, used | {color_id}):
                return True
            ids[i] = None
        return False

    if not backtrack(0, set()):
        return None
    return [int(x) for x in ids]


def _build_grids(
    centers: list[tuple[int, int]],
    square_ids: list[int],
    sprite_colors: list[int],
    marker_colors: list[int],
) -> tuple[np.ndarray, np.ndarray]:
    """Return an assembled input grid and the matching oracle output."""
    out = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)
    lower = np.full(FIELD_SHAPE, BACKGROUND_COLOR, dtype=int)
    for (r, c), idx in zip(centers, square_ids):
        patch = np.full((SQUARE_SIZE, SQUARE_SIZE), sprite_colors[idx], dtype=int)
        paste(out, patch, r - SQUARE_RADIUS, c - SQUARE_RADIUS)
        lower[r, c] = marker_colors[idx]

    legend = np.full((LEGEND_HEIGHT, FIELD_WIDTH), BACKGROUND_COLOR, dtype=int)
    for i, (sprite, marker) in enumerate(zip(sprite_colors, marker_colors)):
        c0 = i * LEGEND_COLUMN_STRIDE
        legend[:SQUARE_SIZE, c0 : c0 + SQUARE_SIZE] = sprite
        legend[LEGEND_MARKER_ROW, c0 + SQUARE_RADIUS] = marker

    sep = np.full((1, FIELD_WIDTH), SEPARATOR_COLOR, dtype=int)
    return np.vstack([legend, sep, lower]), out


def _gen_attempt() -> np.ndarray | None:
    sprite_colors, marker_colors = _color_pairs()
    n_squares = random.choice(SQUARE_COUNT_CHOICES)
    centers = _place_centers(n_squares)
    if centers is None:
        return None
    square_ids = _assign_square_ids(centers)
    if square_ids is None:
        return None

    inp, out = _build_grids(centers, square_ids, sprite_colors, marker_colors)
    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
