+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r - min(rows), c - min(cols)] = True
+        turns = random.randrange(4)
+        mask = np.rot90(mask, turns)
+        if random.choice((False, True)):
+            mask = np.fliplr(mask)
+        return mask.copy()
+    raise RuntimeError("failed to grow a suitable object mask")
+
