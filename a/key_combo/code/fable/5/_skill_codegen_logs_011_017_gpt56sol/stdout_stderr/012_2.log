+            _oracle_output(grid, objects, 1, order="area"),
+            _oracle_output(grid, objects, -shift, order="area"),
+            _oracle_output(grid, objects, 0, order="area"),
+            _oracle_output(grid, objects, shift, order="space"),
+        )
