+def _oracle_expand(seed_mask: np.ndarray, depth: int, bg: int, color: int) -> np.ndarray:
+    """Independent base-n-digit oracle for the recursive Kronecker construction."""
+    n = int(seed_mask.shape[0])
+    side = n ** (depth + 1)
