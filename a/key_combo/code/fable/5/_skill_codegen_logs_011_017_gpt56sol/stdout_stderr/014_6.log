+                candidates.append(
+                    {
+                        "r0": r0,
+                        "c0": c0,
+                        "n": n,
+                        "depth": depth,
+                        "seed_mask": seed_mask.copy(),
+                        "seed_color": int(seed_values[0]),
+                        "bar_color": bar_color,
+                        "bar_coords": outside.copy(),
