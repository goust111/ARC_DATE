+
+def _straight_bar(grid: np.ndarray, coords: np.ndarray) -> tuple[int, int] | None:
+    """Return (length, color) when coords are one filled horizontal/vertical bar."""
+    if coords.size == 0:
+        return None
+    values = grid[coords[:, 0], coords[:, 1]]
+    colors = np.unique(values)
+    if colors.size != 1:
+        return None
