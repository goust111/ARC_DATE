+            masks.append(mask)
+    return masks
+
+
+_MASKS = {2: _available_seed_masks(2), 3: _available_seed_masks(3)}
+_SEEN_OUTPUTS: set[tuple[tuple[int, int], bytes]] = set()
+_GENERATION_INDEX = 0
+
