+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    todo = [tuple(map(int, coords[0]))]
+    seen = {todo[0]}
+    height, width = mask.shape
+    while todo:
+        r, c = todo.pop()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
