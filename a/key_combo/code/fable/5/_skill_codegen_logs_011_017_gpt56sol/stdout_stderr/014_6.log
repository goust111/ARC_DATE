+        else:
+            n = random.choice((2, 3))
+            depth = random.choice((1, 2, 3) if n == 2 else (1, 2))
+            same_color = random.random() < 0.4
+        grid = _gen_attempt(n, depth, same_color)
+        if grid is not None:
+            _GENERATION_INDEX += 1
+            return grid
+    raise RuntimeError("failed to generate a unique valid recursive-depth input")

