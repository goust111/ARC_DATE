  "type": "transform_in_place",
  "src": "horizontal stripes (full-width lines)",
  "transform": "build nested square frames: bottom stripe -> center solid square (side=stripe_height); then for each higher stripe -> wrap with a square frame (thickness=stripe_height, color=stripe color)",
  "grid_shape": "square: N = bottom_h + 2*sum(other stripe heights)",
  "notes": "stripes are read bottom-to-top; frame colors/heights come from stripe colors/heights"
}
</annotation>
