+
+import numpy as np
+
+
+_GRAY = 5
+_DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _background(grid: np.ndarray) -> int:
+    """Return the modal color, following the ARC background convention."""
