+            if len(candidates) != 1:
+                return False
+            _marker, (dr, dc) = candidates[0]
+            sr, sc, side, color = mover["row"], mover["col"], mover["side"], mover["color"]
+            work[sr : sr + side, sc : sc + side] = river
+            work[dr : dr + side, dc : dc + side] = color
