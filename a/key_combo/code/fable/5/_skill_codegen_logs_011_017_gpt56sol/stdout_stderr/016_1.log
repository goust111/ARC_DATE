+    integral = np.pad(free.astype(np.int16), ((1, 0), (1, 0))).cumsum(0).cumsum(1)
+    window = (
+        integral[side:, side:]
+        - integral[:-side, side:]
+        - integral[side:, :-side]
+        + integral[:-side, :-side]
+    )
+    feasible = window == side * side
+    assert 0 <= sr < ph and 0 <= sc < pw and bool(feasible[sr, sc])
+
+    reached = {(sr, sc)}
+    queue = deque([(sr, sc)])
+    while queue:
