+        work[src_r : src_r + side, src_c : src_c + side] = int(river)
+        work[dst_r : dst_r + side, dst_c : dst_c + side] = int(mover["color"])
+
+    assert not bool((work == _GRAY).any()), "every generated goal must be consumed"
