+        seen[row, col] = True
+        queue = deque([(row, col)])
+        component: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            component.append((r, c))
+            for dr, dc in _DIR4:
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < height and 0 <= cc < width and mask[rr, cc] and not seen[rr, cc]:
