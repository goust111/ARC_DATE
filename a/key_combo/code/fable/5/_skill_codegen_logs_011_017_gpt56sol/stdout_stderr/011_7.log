+def _dihedral(a: np.ndarray, index: int) -> np.ndarray:
+    """One of the eight square-grid symmetries, in a fixed visible order."""
+    k, reflected = divmod(int(index), 2)
+    turned = np.rot90(a, k)
+    return np.fliplr(turned) if reflected else turned.copy()
