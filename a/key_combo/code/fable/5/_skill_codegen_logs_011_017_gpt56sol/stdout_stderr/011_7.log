+        return None
+    variants = {_dihedral(tile, i).tobytes() for i in range(8)}
+    if len(variants) != 8:
+        return None
+    return tile
+
+
+def _occurrences(n: int, period: int, residue: tuple[int, int]) -> list[tuple[int, int]]:
+    rr, cc = residue
+    return [(r, c) for r in range(rr, n, period) for c in range(cc, n, period)]
+
+
