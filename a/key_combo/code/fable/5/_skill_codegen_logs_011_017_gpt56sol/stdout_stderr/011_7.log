+
+
+# ------------------------------ generator ------------------------------
+
+_GEN_ATTEMPTS = 500
+_PERIOD_REPEATS = {2: (4, 5, 6, 7), 3: (3, 4), 4: (3,)}
+
+
+def _random_asymmetric_tile(period: int, palette: list[int]) -> np.ndarray | None:
+    tile = np.random.choice(palette, size=(period, period)).astype(int)
