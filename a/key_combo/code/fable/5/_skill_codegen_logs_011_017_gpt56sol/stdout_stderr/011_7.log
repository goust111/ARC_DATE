_GEN_MAX_SIDE = 18
_GEN_MIN_SIDE_BY_OBJECT_COUNT = {1: 8, 2: 8, 3: 10, 4: 12}
_GEN_PADDING = 1
_GEN_EDGE_GAP = 2
_GEN_HORIZONTAL_SIZE = (3, 6)
_GEN_VERTICAL_SIZE = (6, 3)

# Retry limits.
_GEN_MAX_ATTEMPTS = 300


def _gen_marker_block(side: str) -> np.ndarray:
    block = np.full((3, 3), _GEN_BG, dtype=int)
    for r, c in _GEN_MARKER_COORDS[side]:
        block[r, c] = _GEN_MARKER
    return block


def _gen_cross_block() -> np.ndarray:
    block = np.full((3, 3), _GEN_BG, dtype=int)
    block[1, 1] = _GEN_CENTER
    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):
        block[r, c] = color
    return block


def _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:
    marker = _gen_marker_block(side)
    if side == "left":
        return np.concatenate([marker, cross], axis=1)
    if side == "right":
        return np.concatenate([cross, marker], axis=1)
    if side == "top":
        return np.concatenate([marker, cross], axis=0)
    return np.concatenate([cross, marker], axis=0)


def _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:
    out = patch.copy()
    if side == "left":
        out[:, 3:] = np.rot90(out[:, 3:], 2)
    elif side == "right":
        out[:, :3] = np.rot90(out[:, :3], 2)
    elif side == "top":
        out[3:, :] = np.rot90(out[3:, :], 2)
    else:
        out[:3, :] = np.rot90(out[:3, :], 2)
    return out


def _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:
    h, w = patch.shape
    H, W = canvas.shape
    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
        return False
    for dr, dc in np.argwhere(patch != _GEN_BG):
        r = int(r0 + dr)
        c = int(c0 + dc)
        r1 = max(0, r - padding)
        r2 = min(H, r + padding + 1)
        c1 = max(0, c - padding)
        c2 = min(W, c + padding + 1)
        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):
            return False
    return True


def _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:
    if side == "left":
        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]
    if side == "right":
        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]
    if side == "top":
        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]
    return [(0, c) for c in range(W - _GEN_EDGE_GAP)]


def _gen_input_positions(side: str, H: int, W: int, target_r: int, target_c: int) -> list[tuple[int, int]]:
    if side == "left":
        return [(target_r, c) for c in range(0, W - _GEN_HORIZONTAL_SIZE[1] - _GEN_PADDING)]
    if side == "right":
        return [(target_r, c) for c in range(_GEN_EDGE_GAP, W - _GEN_HORIZONTAL_SIZE[1] + _GEN_PADDING)]
    if side == "top":
        return [(r, target_c) for r in range(0, H - _GEN_VERTICAL_SIZE[0] - _GEN_PADDING)]
    return [(r, target_c) for r in range(_GEN_EDGE_GAP, H - _GEN_VERTICAL_SIZE[0] + _GEN_PADDING)]


def _gen_canvas_shape(n_obj: int) -> tuple[int, int]:
    min_side = _GEN_MIN_SIDE_BY_OBJECT_COUNT[int(n_obj)]
    return random.randint(min_side, _GEN_MAX_SIDE), random.randint(min_side, _GEN_MAX_SIDE)


def _gen_place_output_objects(expected: np.ndarray, n_obj: int) -> list[tuple[str, np.ndarray, int, int]] | None:
    H, W = expected.shape
    objects = []

    for _ in range(n_obj):
        sides = _GEN_SIDES[:]
        random.shuffle(sides)
        placed = False
        for side in sides:
            cross = _gen_cross_block()
            patch = _gen_composite(side, cross)
            positions = _gen_output_positions(side, H, W)
            random.shuffle(positions)
            for r0, c0 in positions:
                if _gen_can_place(expected, patch, r0, c0, padding=_GEN_PADDING):
                    paste(expected, patch, int(r0), int(c0), transparent=_GEN_BG)
                    objects.append((side, patch, r0, c0))
                    placed = True
                    break
            if placed:
                break
        if not placed:
            return None
    return objects


def _gen_place_input_objects(shape: tuple[int, int], objects: list[tuple[str, np.ndarray, int, int]]) -> np.ndarray | None:
    H, W = shape
    inp = np.full(shape, _GEN_BG, dtype=int)
    random.shuffle(objects)
    for side, out_patch, target_r, target_c in objects:
        in_patch = _gen_input_from_output(side, out_patch)
        positions = _gen_input_positions(side, H, W, target_r, target_c)
        random.shuffle(positions)
        placed = False
        for r0, c0 in positions:
            if _gen_can_place(inp, in_patch, r0, c0, padding=_GEN_PADDING):
                paste(inp, in_patch, int(r0), int(c0), transparent=_GEN_BG)
                placed = True
                break
        if not placed:
            return None
import numpy as np

from arc_utils import get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete the scene by adding the point-reflected copy of the colored object across the central marker.

    Input structure
    - The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.
    - A single divider color fills the center column except for the center marker.
    - All remaining foreground pixels form the object to copy, entirely on the left side of the divider.
    Rule
    - Keep the input unchanged.
    - For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.
    Key insight
    - The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h % 2 == 1 and w % 2 == 1

    cr, cc = h // 2, w // 2
    bg = int(get_bg(g))

    marker_color = int(g[cr, cc])
    assert marker_color != bg
    marker_mask = g == marker_color
    expected_markers = np.zeros(g.shape, dtype=bool)
    expected_markers[cr, 0] = True
    expected_markers[cr, cc] = True
    expected_markers[cr, w - 1] = True
    assert np.array_equal(marker_mask, expected_markers)

    center_col = g[:, cc]
    divider_colors = {int(color) for color in np.unique(center_col) if int(color) != marker_color}
    assert len(divider_colors) == 1
    divider_color = next(iter(divider_colors))
    assert divider_color != bg
    expected_divider = np.zeros(g.shape, dtype=bool)
    expected_divider[:, cc] = True
    expected_divider[cr, cc] = False
    assert np.array_equal(g == divider_color, expected_divider)

    source_mask = (g != bg) & (g != marker_color) & (g != divider_color)
    source_coords = np.argwhere(source_mask)
    assert source_coords.size > 0
    assert np.all(source_coords[:, 1] < cc)

    out = g.copy()
    for r, c in source_coords:
        rr = 2 * cr - int(r)
        rc = 2 * cc - int(c)
        assert 0 <= rr < h and 0 <= rc < w
        assert out[rr, rc] == bg
        out[rr, rc] = g[r, c]

    return out

# --------------- generator (o5x) ---------------

# Colors and canvas bounds.
BG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 7, 4, 8
GRID_SIZES, MIN_EMPTY_BORDER_ROWS = (15, 17, 19), 1

# Convex source shape bounds.
SOURCE_SPAN_RANGE = (10, 15)
SOURCE_MAX_WIDTH_RANGE = (5, 7)
SOURCE_EDGE_WIDTH_RANGE = (1, 3)
WIDTH_STEP_CAP, SOURCE_PIXEL_RANGE = 2, (35, 83)

# Color palette, band orders, and retry budget.
SOURCE_COLORS = (0, 1, 2, 3, 5, 6, 9)
SOURCE_COLOR_COUNT_RANGE, GEN_ATTEMPTS = (3, 7), 300
COLORING_KEYS = (
    lambda item: (item[2], item[3], item[1]),
    lambda item: (item[3], item[2], item[1]),
    lambda item: (item[2] + item[3], item[2], item[1]),
    lambda item: (item[2] - item[3], item[2], item[1]),
)


def _gen_bounded_steps(total, slots, cap):
    steps = []
    remaining = total
    for i in range(slots):
        left = slots - i - 1
        lo = max(0, remaining - cap * left)
        hi = min(cap, remaining)
        step = random.randint(lo, hi)
        steps.append(step)
        remaining -= step
    return steps


def _gen_width_profile(span, max_width):
    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)
    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
    if min_up + min_down + 1 > span:
        return None

    peak_start = random.randint(min_up, span - 1 - min_down)
    peak_end = random.randint(peak_start, span - 1 - min_down)

    widths = [start_width]
    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):
        widths.append(widths[-1] + step)

    widths.extend([max_width] * (peak_end - peak_start))

    current = max_width
    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):
        current -= step
        widths.append(current)

    area = sum(widths)
    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:
        return None
    return widths


def _choose_source_extent(n, cr):
    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]
    span = random.choice(valid_spans)
    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)
    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)
    r0 = random.randint(r0_min, r0_max)
    return span, r0, cr - r0


def _paint_source_cells(out, r0, widths, outer, cc):
    interior = []
    source = []
    for i, width in enumerate(widths):
        r = r0 + i
        c0 = cc - width
        for j in range(width):
            c = c0 + j
            source.append((r, c))
            if j == 0:
                out[r, c] = outer
            else:
                interior.append((r, c, i, j))
    return source, interior


def _gen_color_source(out, r0, widths, colors, cc):
    outer = colors[0]
    inner = colors[1:]
    source, interior = _paint_source_cells(out, r0, widths, outer, cc)
    if len(interior) < len(inner):
        return None

    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]
    interior.sort(key=key)
    band_count = len(inner)
    for rank, (r, c, _, _) in enumerate(interior):
        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]

    return source


def _reflect_source(out, source, cr, cc):
    reflected = []
    for r, c in source:
        rr = 2 * cr - r
        rc = 2 * cc - c
        if out[rr, rc] != BG_COLOR:
            return None
        out[rr, rc] = out[r, c]
        reflected.append((rr, rc))
    return reflected


def _gen_attempt():
    n = random.choice(GRID_SIZES)
    cr = cc = n // 2
    out = np.full((n, n), BG_COLOR, dtype=int)
    out[:, cc] = DIVIDER_COLOR
    out[cr, [0, cc, n - 1]] = MARKER_COLOR

    span, r0, center_i = _choose_source_extent(n, cr)
    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)
    widths = _gen_width_profile(span, max_width)
    if widths is None:
        return None
    if widths[center_i] >= cc:
        return None

    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)
    colors = random.sample(SOURCE_COLORS, color_count)
    source = _gen_color_source(out, r0, widths, colors, cc)
    if source is None:
        return None

    reflected = _reflect_source(out, source, cr, cc)
    if reflected is None:
        return None

    inp = out.copy()
    for r, c in reflected:
        inp[r, c] = BG_COLOR

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input():
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid e729b7be input")
import numpy as np
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Shear the rectangular input down-left onto a black canvas.

    Input structure
    A rectangular grid of colored pixels with no internal empty region to infer.

    Rule
    Create a black output with the same height and width W + H - 1, then copy
    each input row r unchanged starting at column H - 1 - r.

    Key insight
    The colors and row contents are preserved; only the row offsets change so
    the left edge forms a descending diagonal.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h > 0 and w > 0

    out = np.zeros((h, w + h - 1), dtype=int)
    for r in range(h):
        start = h - 1 - r
        out[r, start : start + w] = g[r]
    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and palette bounds.
MIN_HEIGHT, MAX_HEIGHT = 2, 10
MIN_WIDTH, MAX_WIDTH = 1, 9
MIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5
MAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30
PALETTE_VALUES = range(1, 10)

# Fill pattern controls.
FILL_MODES = ("noise", "row_runs", "column_bands", "diagonal_bands")
MAX_ROW_RUN_CUTS = 3
COLUMN_NOISE_PROB = 0.5
MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3
DIAGONAL_FLIP_PROB = 0.5

# Generation safety.
GENERATION_RETRIES = 300


def _ensure_palette_coverage(arr, palette):
    positions = random.sample(range(arr.size), len(palette))
    rows, cols = np.divmod(positions, arr.shape[1])
    arr[rows, cols] = palette


def _fill_grid(h, w, palette):
    k = len(palette)
    mode = random.choice(FILL_MODES)
    arr = np.zeros((h, w), dtype=int)

    if mode == "noise":
        arr[:] = np.random.choice(palette, size=(h, w))
    elif mode == "row_runs":
        for r in range(h):
            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []
            starts = [0] + cuts
            ends = cuts + [w]
            last = None
            for c0, c1 in zip(starts, ends):
                choices = [c for c in palette if c != last] or list(palette)
                last = random.choice(choices)
                arr[r, c0:c1] = last
    elif mode == "column_bands":
        for c in range(w):
            arr[:, c] = random.choice(palette)
        if random.random() < COLUMN_NOISE_PROB:
            for r in range(h):
                arr[r, random.randrange(w)] = random.choice(palette)
    else:
        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)
        phase = random.randrange(k)
        rows, cols = np.indices((h, w))
        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]
        if random.random() < DIAGONAL_FLIP_PROB:
            arr = np.fliplr(arr)

    _ensure_palette_coverage(arr, palette)
    return arr


def _gen_attempt():
    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)
    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)
    widths = [
        w
        for w in range(MIN_WIDTH, MAX_WIDTH + 1)
        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH
    ]
    if not widths:
        return None
    w = random.choice(widths)
    palette = random.sample(PALETTE_VALUES, k)
    return _fill_grid(h, w, palette)


def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations
import numpy as np
from arc_utils import colors_present, components_mask, get_bg

def main(grid: np.ndarray) -> np.ndarray:
    """
    Trace diagonal rays from triangular arrows, reflecting off colored wall pixels.

    Input structure:
    - bg grid with monochrome 3-pixel L-shaped "arrows" (2x2 bbox missing one corner) and scattered colored wall pixels.

    Rule:
    - Each arrow fires a ray diagonally away from its missing corner, painting bg cells in its color.
    - A head-on wall hit reverses both axes; a side-touch wall hit flips the touched axis only.
    - On any bounce the ray adopts the wall's color and recolors the contact cell.
    - Ray stops when it exits the grid or reaches another arrow.

    Key insight: Two distinct reflection types (corner vs side-touch) plus color inheritance at each bounce drive the path geometry.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    def is_arrow_pts(pts: list[tuple[int, int]]) -> bool:
        if len(pts) != 3:
            return False
        rs = [r for r, _c in pts]
        cs = [c for _r, c in pts]
        return (max(rs) - min(rs) == 1) and (max(cs) - min(cs) == 1)

    def arrow_dir_and_start(pts: list[tuple[int, int]]):
        rs = [r for r, _c in pts]
        cs = [c for _r, c in pts]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
        miss = [p for p in corners if p not in set(pts)]
        if len(miss) != 1:
            return None
        mr, mc = miss[0]
        # direction away from missing corner
        dr = 1 if mr == r0 else -1
        dc = 1 if mc == c0 else -1

        pts_set = set(pts)
        deg = {p: 0 for p in pts}
        for r, c in pts:
            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if (rr, cc) in pts_set:
                    deg[(r, c)] += 1
        start = max(deg, key=lambda p: deg[p])  # right-angle corner
        return (int(dr), int(dc)), (int(start[0]), int(start[1]))

    # Detect arrows per-color (cannot rely on global non-bg connectivity).
    arrow_cells: set[tuple[int, int]] = set()
    arrows: list[tuple[int, list[tuple[int, int]]]] = []
    for col in colors_present(g, exclude={bg}):
        for coords in components_mask(g == int(col), connectivity=4):
            pts = [(int(r), int(c)) for r, c in coords]
            if is_arrow_pts(pts):
                arrows.append((int(col), pts))
                arrow_cells |= set(pts)

    wall_cells: set[tuple[int, int]] = {
        (int(r), int(c)) for r, c in np.argwhere(g != int(bg)) if (int(r), int(c)) not in arrow_cells
    }

    out = g.copy()

    for start_col, pts in arrows:
        info = arrow_dir_and_start(pts)
        if info is None:
            continue
        (dr, dc), cur = info
        cur_col = int(start_col)
        seen = set()

        while True:
            state = (cur, int(dr), int(dc), int(cur_col))
            if state in seen:
                break
            seen.add(state)

            nr = int(cur[0] + dr)
            nc = int(cur[1] + dc)
            if not (0 <= nr < H and 0 <= nc < W):
                break

            # Diagonal hit into a wall: corner reflection.
            if (nr, nc) in wall_cells:
                wcol = int(g[nr, nc])
                if int(g[int(cur[0]), int(cur[1])]) == int(bg):
                    out[int(cur[0]), int(cur[1])] = int(wcol)
                cur_col = int(wcol)
                dr, dc = -int(dr), -int(dc)
                continue

            # Arrow pixels act like blockers (sources only).
            if (nr, nc) in arrow_cells:
                break

            # Advance.
            cur = (int(nr), int(nc))
            if int(out[nr, nc]) == int(bg):
                out[nr, nc] = int(cur_col)

            # Side-touch bounces only when a wall lies in the direction of travel.
            if int(dr) == 1 and (nr + 1, nc) in wall_cells:
                wcol = int(g[nr + 1, nc])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dr = -int(dr)
            elif int(dr) == -1 and (nr - 1, nc) in wall_cells:
                wcol = int(g[nr - 1, nc])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dr = -int(dr)

            if int(dc) == 1 and (nr, nc + 1) in wall_cells:
                wcol = int(g[nr, nc + 1])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dc = -int(dc)
            elif int(dc) == -1 and (nr, nc - 1) in wall_cells:
                wcol = int(g[nr, nc - 1])
                if int(g[nr, nc]) == int(bg):
                    out[nr, nc] = int(wcol)
                cur_col = int(wcol)
                dc = -int(dc)

    return out


import random as _rng


def _gen_attempt() -> np.ndarray | None:
    """Single attempt to generate a valid input for task 142ca369.

    Output-first: for each arrow, plan the full zigzag ray path (with 0-4 side-touch
    bounces), place walls at bounce points, then derive the input (arrows + walls).
    """
    H, W = _rng.randint(18, 20), _rng.randint(18, 20)
    n_arrows = _rng.randint(1, 7)
    palette = list(range(1, 10))
    _rng.shuffle(palette)
    arrow_colors = palette[:n_arrows]

    grid = np.zeros((H, W), dtype=int)
    out = np.zeros((H, W), dtype=int)
    occupied: set[tuple[int, int]] = set()

    for ai in range(n_arrows):
        color = arrow_colors[ai]
        dr, dc = _rng.choice([-1, 1]), _rng.choice([-1, 1])
        n_bounces = _rng.choices([0, 1, 2, 3, 4], weights=[2, 3, 3, 2, 1])[0]

        placed = False
        for _ in range(60):
            # Start position with room for the 2x2 arrow bbox
            r_lo, r_hi = (1 if dr == -1 else 0), (H - 2 if dr == 1 else H - 1)
            c_lo, c_hi = (1 if dc == -1 else 0), (W - 2 if dc == 1 else W - 1)
            if r_lo > r_hi or c_lo > c_hi:
                continue
            sr, sc = _rng.randint(r_lo, r_hi), _rng.randint(c_lo, c_hi)

            # Arrow = 3 corners of 2x2 bbox, missing corner opposite to fire direction
            mr, mc = sr - dr, sc - dc
            arrow_pts = [(r, c) for r in (mr, sr) for c in (mc, sc) if (r, c) != (mr, mc)]
            if any(not (0 <= r < H and 0 <= c < W) or (r, c) in occupied for r, c in arrow_pts):
                continue

            # Trace ray path with planned bounces
            cur_r, cur_c, cur_dr, cur_dc, cur_col = sr, sc, dr, dc, color
            ray_cells: list[tuple[int, int, int]] = []
            walls: list[tuple[list[tuple[int, int]], int]] = []
            ray_set: set[tuple[int, int]] = set()
            arrow_set = set(arrow_pts)
            ok = True
            bounces_left = n_bounces

            for seg_idx in range(n_bounces + 1):
                max_steps = min(
                    (H - 1 - cur_r) if cur_dr == 1 else cur_r,
                    (W - 1 - cur_c) if cur_dc == 1 else cur_c,
                )
                if seg_idx < n_bounces and bounces_left > 0:
                    if max_steps < 4:
                        bounces_left = 0
                        seg_len = max_steps
                    else:
                        seg_len = _rng.randint(3, max(3, max_steps - 1))
                else:
                    seg_len = max_steps

                for _ in range(seg_len):
                    nr, nc = cur_r + cur_dr, cur_c + cur_dc
                    if not (0 <= nr < H and 0 <= nc < W):
                        break
                    if (nr, nc) in occupied or (nr, nc) in ray_set or (nr, nc) in arrow_set:
                        ok = False; break
                    ray_cells.append((nr, nc, cur_col))
                    ray_set.add((nr, nc))
                    cur_r, cur_c = nr, nc
                if not ok:
                    break

                if seg_idx >= n_bounces or bounces_left <= 0:
                    continue
                bounces_left -= 1

                # Collect feasible wall placements for this bounce
                options: list[tuple[list[tuple[int, int]], str]] = []
                # Horizontal wall (flips dr): center pixel at (cur_r+cur_dr, cur_c)
                wr, wc = cur_r + cur_dr, cur_c
                if 0 <= wr < H:
                    w3 = [(wr, wc + d) for d in (-1, 0, 1)]
                    if all(0 <= c < W for _, c in w3):
                        options.append((w3, 'dr'))
                    options.append(([(wr, wc)], 'dr'))
                # Vertical wall (flips dc): center pixel at (cur_r, cur_c+cur_dc)
                wr2, wc2 = cur_r, cur_c + cur_dc
                if 0 <= wc2 < W:
                    w3v = [(wr2 + d, wc2) for d in (-1, 0, 1)]
                    if all(0 <= r < H for r, _ in w3v):
                        options.append((w3v, 'dc'))
                    options.append(([(wr2, wc2)], 'dc'))
                if not options:
                    ok = False; break

                # Mix of 1-pixel and 3-pixel walls; shuffle with size preference
                _rng.shuffle(options)
                prefer_3 = _rng.random() < 0.6
                options.sort(key=lambda o: len(o[0]), reverse=prefer_3)
                chosen_wall = None
                for wpxs, flip in options:
                    if any((r, c) in occupied or (r, c) in ray_set or (r, c) in arrow_set
