    h_min, h_max = OBJECT_HEIGHT_RANGE
    pairs = [
        (rh, nh)
        for rh in range(h_min, h_max + 1)
        for nh in range(h_min, h_max + 1)
        if rh + nh + ROW_GAP_MIN <= n
