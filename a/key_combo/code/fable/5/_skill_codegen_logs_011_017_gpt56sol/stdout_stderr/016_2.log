+    for _ in range(120):
+        first = random.randint(3, 6)
+        positions = [first]
+        for _j in range(1, count):
+            positions.append(positions[-1] + random.randint(3, 5))
+        if positions[-1] >= len(slots) - 2 or any(p in corners or not slots[p]["usable"] for p in positions):
