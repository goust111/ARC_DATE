+    cs = [c for _, c in path]
+    pr0, pc0 = min(rs), min(cs)
+    path_h, path_w = max(rs) - pr0 + 1, max(cs) - pc0 + 1
+    th, tw = tape.shape
+
+    layouts = []
+    if tw + path_w + 5 <= 30 and max(th, path_h) + 2 <= 30:
+        layouts.append("horizontal")
+    if th + path_h + 5 <= 30 and max(tw, path_w) + 2 <= 30:
