+
+def _program_path(lengths: list[int], turns: list[str], initial: int) -> list[tuple[int, int]] | None:
+    """Simulate in local coordinates and reject crossings or retraced pixels."""
+    r = c = 0
+    dr, dc = DIRS4[initial]
+    path = [(r, c)]
