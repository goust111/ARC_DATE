+        else:
+            path_pos, tape_pos = (b_r, 0), (a_r, path_w + gap)
+    else:
+        gap = random.randint(3, min(5, 28 - th - path_h))
+        local_h = th + gap + path_h
+        local_w = max(tw, path_w)
+        a_c = random.randint(0, local_w - tw)
+        b_c = random.randint(0, local_w - path_w)
+        if not reverse:
