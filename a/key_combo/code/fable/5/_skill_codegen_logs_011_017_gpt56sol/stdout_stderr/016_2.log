+    max_r, max_c = map(int, pts.max(axis=0))
+    row_starts = sorted({min_r, min_r + 1})
+    row_ends = sorted({max_r, max_r - 1})
+    col_starts = sorted({min_c, min_c + 1})
+    col_ends = sorted({max_c, max_c - 1})
