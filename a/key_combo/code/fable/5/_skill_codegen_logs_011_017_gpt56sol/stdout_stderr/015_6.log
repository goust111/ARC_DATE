+    intended_odd_columns: list[int],
+    novel_decoy: np.ndarray,
+    background: int,
+    separator: int,
+    row_count: int,
+    column_count: int,
+    height: int,
+    width: int,
+) -> bool:
+    """Check the stated semantics and anti-shortcut conditions, not only solver closure."""
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
