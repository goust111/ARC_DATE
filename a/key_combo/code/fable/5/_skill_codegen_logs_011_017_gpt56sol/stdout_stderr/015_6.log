+    """Return the only permutation covering all vertices through directed matches."""
+    n = graph.shape[0]
+    valid = []
+    for order in permutations(range(n)):
+        if all(graph[order[i], order[i + 1]] for i in range(n - 1)):
+            valid.append(order)
+            if len(valid) > 1:
