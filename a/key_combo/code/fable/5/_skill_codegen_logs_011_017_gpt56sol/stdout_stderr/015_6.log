+def _render_vertical(blocks: list[np.ndarray], separator: int) -> np.ndarray:
+    h, w = blocks[0].shape
+    out = np.full((len(blocks) * h + len(blocks) - 1, w), separator, dtype=int)
+    for index, block in enumerate(blocks):
+        r0 = index * (h + 1)
+        out[r0:r0 + h, :] = block
+    return out
