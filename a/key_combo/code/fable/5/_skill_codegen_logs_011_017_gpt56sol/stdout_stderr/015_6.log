+    extracted, found_columns = _independent_outliers(
+        grid, row_count, column_count, height, width
+    )
+    if found_columns != intended_odd_columns:
+        return False
+    if any(not np.array_equal(a, b) for a, b in zip(extracted, odd_by_row)):
