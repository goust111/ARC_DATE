from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox, get_bg
import random


def _solid_rect_bbox(g: np.ndarray, color: int) -> tuple[int, int, int, int]:
    box = bbox(g == color)
    assert box is not None, "expected color to appear"
    r0, c0, r1, c1 = box
    area = (r1 - r0 + 1) * (c1 - c0 + 1)
    assert int(np.count_nonzero(g == color)) == area, "colored object must be a solid rectangle"
    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "colored object bbox must be solid"
    return box


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the orange rectangle onto the maroon rectangle and mark gated corridor crossings in red.

    Input structure
    - The dominant background contains black obstacle segments.
    - There is one solid orange rectangle and one solid maroon rectangle of the same size.
    - The two rectangles share either their row span or their column span, so the move is straight and axis-aligned.

    Rule
    - Erase the original orange rectangle to the background.
    - Replace the maroon rectangle with the orange rectangle.
    - Between the two rectangles, paint red across the moving rectangle's width or height only at corridor cells flanked by black obstacle segments perpendicular to the movement.

    Key insight
    - The black segments define gates in the straight corridor; only those gated openings, not every swept background cell, become red.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    source = _solid_rect_bbox(g, Color.ORANGE)
    target = _solid_rect_bbox(g, Color.MAROON)
    sr0, sc0, sr1, sc1 = source
    tr0, tc0, tr1, tc1 = target

    assert (sr1 - sr0, sc1 - sc0) == (tr1 - tr0, tc1 - tc0), "rectangles must have the same size"
    same_cols = (sc0, sc1) == (tc0, tc1)
    same_rows = (sr0, sr1) == (tr0, tr1)
    assert same_cols != same_rows, "rectangles must align on exactly one axis"

    out = g.copy()
    out[g == Color.ORANGE] = bg
    out[tr0 : tr1 + 1, tc0 : tc1 + 1] = Color.ORANGE

    H, W = g.shape
    if same_cols:
        c0, c1 = sc0, sc1
        rows = range(tr1 + 1, sr0) if sr0 > tr0 else range(sr1 + 1, tr0)
        for r in rows:
            gated = (
                c0 > 0
                and c1 + 1 < W
                and g[r, c0 - 1] == Color.BLACK
                and g[r, c1 + 1] == Color.BLACK
            )
            if gated:
                assert np.all(g[r, c0 : c1 + 1] == bg), "gated opening must be background before painting"
                out[r, c0 : c1 + 1] = Color.RED
    else:
        r0, r1 = sr0, sr1
        cols = range(tc1 + 1, sc0) if sc0 > tc0 else range(sc1 + 1, tc0)
        for c in cols:
            gated = (
                r0 > 0
                and r1 + 1 < H
                and g[r0 - 1, c] == Color.BLACK
                and g[r1 + 1, c] == Color.BLACK
            )
            if gated:
                assert np.all(g[r0 : r1 + 1, c] == bg), "gated opening must be background before painting"
                out[r0 : r1 + 1, c] = Color.RED

    return out

# --------------- generator (o5x) ---------------

# Canvas and object geometry.
GRID_SIZE_MIN, GRID_SIZE_MAX = 8, 26
RECT_SIDE_MIN, RECT_SIDE_MAX = 1, 4
RECT_CANVAS_MARGIN = 4
GAP_MIN, GAP_MAX = 5, 7
CROSS_AXIS_PADDING = 2

# Gate count, spacing, and wall thickness.
BETWEEN_GATE_COUNTS = (2, 3)
GATE_TOTAL_MIN, GATE_TOTAL_MAX = 2, 8
GATE_SPACING_MIN, GATE_SPACING_MAX = 2, 4
GATE_SEGMENT_LEN = 2

# Palette and retry controls.
BACKGROUND_COLOR = Color.PINK
GATE_COLOR = Color.BLACK
RED_COLOR = Color.RED
SOURCE_COLOR = Color.ORANGE
TARGET_COLOR = Color.MAROON
BINARY_CHOICES = [False, True]
GENERATION_ATTEMPTS = 300


def _gen_extensions(anchor: int, limit: int, count: int, sign: int) -> list[list[int]]:
    if count == 0:
        return [[]]
    out: list[list[int]] = []
    for step in range(GATE_SPACING_MIN, GATE_SPACING_MAX + 1):
        pos = anchor + sign * step
        if not (0 <= pos <= limit):
            continue
        for tail in _gen_extensions(pos, limit, count - 1, sign):
            out.append(([pos] + tail) if sign > 0 else (tail + [pos]))
    return out


def _gen_between_positions(gap_cells: list[int], count: int) -> list[tuple[int, ...]]:
    """Enumerate in-gap gate positions with valid spacing, preserving nested-loop order."""
    out: list[tuple[int, ...]] = []
    if count == 2:
        for a in gap_cells:
            for b in gap_cells:
                if GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX:
                    out.append((a, b))
    else:
        for a in gap_cells:
            for b in gap_cells:
                for c in gap_cells:
                    if (
                        GATE_SPACING_MIN <= b - a <= GATE_SPACING_MAX
                        and GATE_SPACING_MIN <= c - b <= GATE_SPACING_MAX
                    ):
                        out.append((a, b, c))
    return out


def _gen_gate_positions(size: int, gap_cells: list[int]) -> tuple[list[int], list[int]] | None:
    choices: list[tuple[list[int], list[int]]] = []
    for between_count in BETWEEN_GATE_COUNTS:
        for between in _gen_between_positions(gap_cells, between_count):
            remaining = GATE_TOTAL_MAX - between_count
            max_left = min(remaining, (between[0] + 1) // GATE_SPACING_MIN)
            max_right = min(remaining, (size - between[-1]) // GATE_SPACING_MIN)
            for left_count in range(max_left + 1):
                for right_count in range(max_right + 1):
                    total = between_count + left_count + right_count
                    if not (GATE_TOTAL_MIN <= total <= GATE_TOTAL_MAX):
                        continue
                    for left in _gen_extensions(between[0], size - 1, left_count, -1):
                        for right in _gen_extensions(between[-1], size - 1, right_count, 1):
                            choices.append((left + list(between) + right, list(between)))
    if not choices:
        return None
    return random.choice(choices)


def _sample_axis_layout(size: int, rect_side: int, gap: int) -> tuple[int, int, int, int, list[int]]:
    """Sample aligned source/target spans and return the corridor cells between them."""
    source_first = random.choice(BINARY_CHOICES)
    span0 = random.randint(0, size - (2 * rect_side + gap))
    first0, second0 = span0, span0 + rect_side + gap
    src_axis0, dst_axis0 = (first0, second0) if source_first else (second0, first0)
    gap_cells = list(range(span0 + rect_side, span0 + rect_side + gap))
    return src_axis0, src_axis0 + rect_side - 1, dst_axis0, dst_axis0 + rect_side - 1, gap_cells


def _paint_rect(grid: np.ndarray, horizontal: bool, axis0: int, axis1: int, cross0: int, cross1: int, color: int) -> None:
    if horizontal:
        grid[cross0 : cross1 + 1, axis0 : axis1 + 1] = color
    else:
        grid[axis0 : axis1 + 1, cross0 : cross1 + 1] = color


def _gen_attempt() -> np.ndarray | None:
    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    rect_side = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, size - RECT_CANVAS_MARGIN))
    gap = random.randint(GAP_MIN, GAP_MAX)
    if 2 * rect_side + gap > size:
        return None

    horizontal = random.choice(BINARY_CHOICES)
    src_axis0, src_axis1, dst_axis0, dst_axis1, gap_cells = _sample_axis_layout(size, rect_side, gap)
    gate_choice = _gen_gate_positions(size, gap_cells)
    if gate_choice is None:
        return None
    gate_positions, red_positions = gate_choice

    cross0 = random.randint(CROSS_AXIS_PADDING, size - rect_side - CROSS_AXIS_PADDING)
    cross1 = cross0 + rect_side - 1
    output = np.full((size, size), BACKGROUND_COLOR, dtype=int)

    for pos in gate_positions:
        if horizontal:
            output[cross0 - GATE_SEGMENT_LEN : cross0, pos] = GATE_COLOR
            output[cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN, pos] = GATE_COLOR
        else:
            output[pos, cross0 - GATE_SEGMENT_LEN : cross0] = GATE_COLOR
            output[pos, cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN] = GATE_COLOR
    _paint_rect(output, horizontal, dst_axis0, dst_axis1, cross0, cross1, SOURCE_COLOR)
    for pos in red_positions:
        if horizontal:
            output[cross0 : cross1 + 1, pos] = RED_COLOR
        else:
            output[pos, cross0 : cross1 + 1] = RED_COLOR

    inp = output.copy()
    inp[inp == RED_COLOR] = BACKGROUND_COLOR
    _paint_rect(inp, horizontal, dst_axis0, dst_axis1, cross0, cross1, TARGET_COLOR)
    _paint_rect(inp, horizontal, src_axis0, src_axis1, cross0, cross1, SOURCE_COLOR)

    if np.array_equal(main(inp), output):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid fc10701f input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox, components_mask, crop_bbox, random_sprite
import random


def _split_sections(grid: np.ndarray) -> tuple[str, list[np.ndarray]]:
    h, w = grid.shape
    sep = 1

    sep_rows = [r for r in range(h) if bool(np.all(grid[r, :] == sep))]
    if sep_rows:
        cuts = [-1] + sep_rows + [h]
        return "vertical", [grid[a + 1 : b, :] for a, b in zip(cuts, cuts[1:]) if b > a + 1]

    sep_cols = [c for c in range(w) if bool(np.all(grid[:, c] == sep))]
    cuts = [-1] + sep_cols + [w]
    return "horizontal", [grid[:, a + 1 : b] for a, b in zip(cuts, cuts[1:]) if b > a + 1]


def _solid_color(block: np.ndarray) -> int:
    vals, counts = np.unique(block, return_counts=True)
    return int(vals[int(np.argmax(counts))])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor a cropped template and repeat it according to a component-count stencil.

    Input structure:
    - Solid blue (1) separator rows or columns split the grid into four sections.
    - Section 1 is a black-background shape template; section 2 is a component-count stencil.
    - Sections 3 and 4 are solid color swatches for output foreground and background.

    Rule:
    - Crop section 1 to the bbox of its non-black pixels and recolor it with the two swatches.
    - Count 4-connected non-black components in section 2.
    - Repeat the recolored crop that many times, inserting one background-colored row/column between copies.

    Key insight: The second section encodes only the repeat count; the output orientation
    is inherited from whether the input separators are columns or rows.
    """
    g = np.asarray(grid, dtype=int)
    orientation, sections = _split_sections(g)
    template, repetition_pattern, foreground_block, background_block = sections[:4]

    template_mask = template != 0
    template_bbox = bbox(template_mask)
    if template_bbox is None:
        return np.empty((0, 0), dtype=int)

    foreground = _solid_color(foreground_block)
    background = _solid_color(background_block)
    tile_mask = crop_bbox(template_mask, template_bbox)
    tile = np.where(tile_mask, foreground, background).astype(int)

    n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))
    if n_repeats <= 1:
        return tile

    if orientation == "horizontal":
        sep = np.full((tile.shape[0], 1), background, dtype=int)
        pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
        return np.hstack(pieces)

    sep = np.full((1, tile.shape[1]), background, dtype=int)
    pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
    return np.vstack(pieces)

# --------------- generator (c) ---------------

# --- CFG: tunable generation parameters ---
REPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)
CROP_SIZE_RANGE = (2, 5)             # crop height/width bounds
DENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box
COLOR_POOL = list(range(2, 10))      # fg/bg color choices (2-9 inclusive)
TEMPLATE_COLOR = 4                   # shape drawn in yellow inside template
STENCIL_COLOR = 3                    # blob color in stencil section
SEPARATOR_COLOR = 1                  # blue separator rows/cols
SWATCH_DIM_RANGE = (3, 8)           # varying-axis size for color swatches
STENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size
BLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil
GEN_RETRIES = 300                    # outer generate_input retry limit


def _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:
    """Repeat `tile` n times along the given axis with 1-pixel bg_color separator."""
    if horizontal:
        sep = np.full((tile.shape[0], 1), bg_color, dtype=int)
        pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
        return np.hstack(pieces)
    sep = np.full((1, tile.shape[1]), bg_color, dtype=int)
    pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
    return np.vstack(pieces)


def _make_swatch(shared_dim: int, color: int, horizontal: bool) -> np.ndarray:
    """Create a solid color swatch. shared_dim is the fixed axis; varying axis is random."""
    varying = random.randint(*SWATCH_DIM_RANGE)
    if horizontal:
        return np.full((shared_dim, varying), color, dtype=int)
    return np.full((varying, shared_dim), color, dtype=int)


def _join_sections(sections: list[np.ndarray], shared_dim: int, horizontal: bool) -> np.ndarray:
    """Join sections with single-pixel separator lines of SEPARATOR_COLOR."""
    if horizontal:
        sep = np.full((shared_dim, 1), SEPARATOR_COLOR, dtype=int)
        parts = [sections[0]]
        for s in sections[1:]:
            parts.extend([sep, s])
        return np.hstack(parts)
    sep = np.full((1, shared_dim), SEPARATOR_COLOR, dtype=int)
    parts = [sections[0]]
    for s in sections[1:]:
        parts.extend([sep, s])
    return np.vstack(parts)


def _build_stencil(n_blobs: int, shared_dim: int, horizontal: bool) -> np.ndarray | None:
    """Place n_blobs 2-cell blobs (1x2 or 2x1) of STENCIL_COLOR on a black grid.
    Blobs are separated by >=1 cell of black in all directions."""
    min_varying = max(4, n_blobs * 2 + 2)
    varying_dim = random.randint(min_varying, min_varying + STENCIL_VARYING_EXTRA)

    h, w = (shared_dim, varying_dim) if horizontal else (varying_dim, shared_dim)
    grid = np.zeros((h, w), dtype=int)

    placed = 0
    for _ in range(BLOB_PLACE_RETRIES):
        if placed >= n_blobs:
            break
        br, bc = (1, 2) if random.choice([True, False]) else (2, 1)

        if h - 1 - br < 1 or w - 1 - bc < 1:
            continue
        r = random.randint(1, h - 1 - br)
        c = random.randint(1, w - 1 - bc)

        # Check blob cells + 1-cell neighborhood are all black
        r0, c0 = max(0, r - 1), max(0, c - 1)
        r1, c1 = min(h, r + br + 1), min(w, c + bc + 1)
        if np.any(grid[r0:r1, c0:c1] != 0):
            continue

        grid[r:r + br, c:c + bc] = STENCIL_COLOR
        placed += 1

    return grid if placed == n_blobs else None


def _gen_attempt() -> np.ndarray | None:
    horizontal = random.choice([True, False])
    N = random.randint(*REPEAT_COUNT_RANGE)

    # Generate connected tile shape
    crop_h = random.randint(*CROP_SIZE_RANGE)
    crop_w = random.randint(*CROP_SIZE_RANGE)
    density = random.uniform(*DENSITY_RANGE)
    shape = random_sprite(crop_h, crop_w, density=density, color_palette=[TEMPLATE_COLOR],
                          connectivity=4, symmetry="not_symmetric")

    # Pick distinct fg/bg colors
    fg_color, bg_color = random.sample(COLOR_POOL, 2)

    # Build output
    tile = np.where(shape != 0, fg_color, bg_color).astype(int)
    output = _tile_repeat(tile, N, bg_color, horizontal)

    # Build template: shape in (crop_h+2) x (crop_w+2) black border
    template = np.zeros((crop_h + 2, crop_w + 2), dtype=int)
    template[1:crop_h + 1, 1:crop_w + 1] = shape

    # Build stencil
    shared_dim = (crop_h + 2) if horizontal else (crop_w + 2)
    stencil = _build_stencil(N, shared_dim, horizontal)
    if stencil is None:
        return None

    # Assemble: template | stencil | fg_swatch | bg_swatch
    fg_swatch = _make_swatch(shared_dim, fg_color, horizontal)
    bg_swatch = _make_swatch(shared_dim, bg_color, horizontal)
    inp = _join_sections([template, stencil, fg_swatch, bg_swatch], shared_dim, horizontal)

    # Oracle check
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        pass
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after %d attempts" % GEN_RETRIES)
from collections import Counter

import numpy as np

from arc_utils import Color, get_bg


def _unique_mode(values: np.ndarray) -> int:
    counts = Counter(map(int, values.reshape(-1)))
    ranked = counts.most_common()
    assert ranked, "expected a nonempty set of copied cells"
    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique consensus color"
    return int(ranked[0][0])


def _solid_lines(g: np.ndarray, axis: int) -> list[tuple[int, int]]:
    assert axis in (0, 1)
    lines: list[tuple[int, int]] = []
    limit = g.shape[axis]
    for idx in range(limit):
        line = g[idx, :] if axis == 0 else g[:, idx]
        color = int(line[0])
        if np.all(line == color):
            lines.append((idx, color))
    return lines


def _content_bands(separators: list[int], limit: int) -> list[tuple[int, int]]:
    bands: list[tuple[int, int]] = []
    start = 0
    for sep in [*separators, limit]:
        assert sep > start, "separator lines must leave nonempty content bands"
        bands.append((start, sep))
        start = sep + 1
    return bands


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reconstruct the repeated tile from its separated copies and mark the missing pixels in the damaged copy blue.

    Input structure:
    - The input is a lattice of equal-size blocks separated by one-cell solid rows
      and columns of the same separator color.
    - All blocks are copies of one motif except exactly one block, where some
      motif pixels have been overwritten by the motif background color.
    - Blue is absent from the input and is reserved as the output marker color.

    Rule:
    - Recover the motif by taking the unique majority color at each local block
      coordinate across all block copies.
    - Find the single block that differs from this consensus motif.
    - Return the consensus motif, recoloring the differing local coordinates blue.

    Key insight:
    - The repeated copies provide redundancy: the damaged positions are exactly
      the coordinates where the lone nonconforming copy has background instead of
      the consensus motif color.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert not np.any(g == Color.BLUE), "blue must be absent from the input"

    solid_rows = _solid_lines(g, axis=0)
    solid_cols = _solid_lines(g, axis=1)
    assert solid_rows and solid_cols, "expected solid separator rows and columns"

    separator_colors = {color for _, color in solid_rows} | {color for _, color in solid_cols}
    assert len(separator_colors) == 1, "all separator lines must have the same color"
    separator = next(iter(separator_colors))

    row_bands = _content_bands([idx for idx, _ in solid_rows], g.shape[0])
    col_bands = _content_bands([idx for idx, _ in solid_cols], g.shape[1])
    heights = {r1 - r0 for r0, r1 in row_bands}
    widths = {c1 - c0 for c0, c1 in col_bands}
    assert len(heights) == 1 and len(widths) == 1, "content blocks must have equal size"

    block_h = heights.pop()
    block_w = widths.pop()
    block_rows = len(row_bands)
    block_cols = len(col_bands)
    assert block_rows * block_cols >= 3, "expected enough repeated blocks for consensus"

    blocks = np.empty((block_rows, block_cols, block_h, block_w), dtype=int)
    for br, (r0, r1) in enumerate(row_bands):
        for bc, (c0, c1) in enumerate(col_bands):
            blocks[br, bc] = g[r0:r1, c0:c1]

    assert not np.any(blocks == separator), "separator color should not appear inside content blocks"
    block_bg = get_bg(blocks)

    motif = np.empty((block_h, block_w), dtype=int)
    for rr in range(block_h):
        for cc in range(block_w):
            motif[rr, cc] = _unique_mode(blocks[:, :, rr, cc])

    diffs = blocks != motif
    diff_counts = diffs.reshape(block_rows, block_cols, block_h * block_w).sum(axis=2)
    damaged_blocks = np.argwhere(diff_counts > 0)
    assert damaged_blocks.shape[0] == 1, "expected exactly one damaged copy of the motif"

    damaged_r, damaged_c = map(int, damaged_blocks[0])
    missing_mask = diffs[damaged_r, damaged_c]
    assert np.any(missing_mask), "damaged copy must contain at least one missing pixel"
    assert np.all(blocks[damaged_r, damaged_c][missing_mask] == block_bg), "damage must be overwritten with background"
    assert np.all(motif[missing_mask] != block_bg), "only non-background motif pixels should be marked"

    out = motif.copy()
    out[missing_mask] = Color.BLUE
    return out

# --------------- generator (o5x) ---------------

GEN_BG_COLOR = 8
GEN_PALETTE = (0, 2, 3, 4, 5, 6, 7, 9)

# Motif size, color count, and density bounds.
GEN_TILE_SIZE_MIN, GEN_TILE_SIZE_MAX = 3, 7
GEN_MOTIF_COLOR_MIN, GEN_MOTIF_COLOR_MAX = 2, 4
GEN_NON_BG_MIN, GEN_NON_BG_MAX = 6, 10

# Damage and lattice constraints.
GEN_DAMAGE_MIN, GEN_DAMAGE_MAX = 2, 4
GEN_MIN_INTACT_NON_BG = 1
GEN_BLOCK_COUNT_MIN, GEN_BLOCK_COUNT_MAX = 3, 6
GEN_SEPARATOR_WIDTH = 1
GEN_MAX_GRID_SIDE = 30

GEN_RETRY_LIMIT = 300


def _gen_valid_non_bg_counts(size: int, n_colors: int) -> list[int]:
    area = size * size
    valid = []
    for count in range(GEN_NON_BG_MIN, min(GEN_NON_BG_MAX, area - GEN_MIN_INTACT_NON_BG) + 1):
        bg_count = area - count
        if count >= n_colors and (count + n_colors - 1) // n_colors <= bg_count:
            valid.append(count)
    return valid


def _gen_balanced_counts(total: int, n_parts: int, cap: int) -> list[int]:
    counts = [1] * n_parts
    remaining = total - n_parts
    while remaining:
        choices = [i for i, count in enumerate(counts) if count < cap]
        idx = int(np.random.choice(choices))
        counts[idx] += 1
        remaining -= 1
    return counts


def _gen_build_motif(size: int) -> np.ndarray:
    n_colors = int(np.random.randint(GEN_MOTIF_COLOR_MIN, GEN_MOTIF_COLOR_MAX + 1))
    counts_by_size = _gen_valid_non_bg_counts(size, n_colors)
    non_bg_count = int(np.random.choice(counts_by_size))
    motif_colors = list(np.random.choice(GEN_PALETTE, size=n_colors, replace=False))
    motif = np.full((size, size), GEN_BG_COLOR, dtype=int)
    flat_cells = np.random.choice(size * size, size=non_bg_count, replace=False)
    color_counts = _gen_balanced_counts(non_bg_count, n_colors, size * size - non_bg_count)
    values = []
    for color, count in zip(motif_colors, color_counts):
        values.extend([int(color)] * count)
    np.random.shuffle(values)
    rows, cols = np.divmod(flat_cells, size)
    motif[rows, cols] = values
    return motif


def _gen_separator(motif: np.ndarray) -> int:
    motif_colors = set(map(int, motif[motif != GEN_BG_COLOR]))
    choices = [color for color in GEN_PALETTE if color not in motif_colors]
    return int(np.random.choice(choices))


def _gen_damage_cells(motif: np.ndarray) -> np.ndarray:
    non_bg_cells = np.argwhere(motif != GEN_BG_COLOR)
    max_damage = min(GEN_DAMAGE_MAX, len(non_bg_cells) - GEN_MIN_INTACT_NON_BG)
    damage_count = int(np.random.randint(GEN_DAMAGE_MIN, max_damage + 1))
    damage_ix = np.random.choice(len(non_bg_cells), size=damage_count, replace=False)
    return non_bg_cells[damage_ix]


def _gen_block_count(size: int) -> int:
    max_count = min(GEN_BLOCK_COUNT_MAX, GEN_MAX_GRID_SIDE // (size + GEN_SEPARATOR_WIDTH))
    return int(np.random.randint(GEN_BLOCK_COUNT_MIN, max_count + 1))


def _gen_tile_lattice(motif: np.ndarray, block_rows: int, block_cols: int, separator: int) -> np.ndarray:
    tile_h, tile_w = motif.shape
    rows = block_rows * tile_h + (block_rows - 1) * GEN_SEPARATOR_WIDTH
    cols = block_cols * tile_w + (block_cols - 1) * GEN_SEPARATOR_WIDTH
    grid = np.full((rows, cols), separator, dtype=int)
    for br in range(block_rows):
        for bc in range(block_cols):
            r0 = br * (tile_h + GEN_SEPARATOR_WIDTH)
            c0 = bc * (tile_w + GEN_SEPARATOR_WIDTH)
            grid[r0:r0 + tile_h, c0:c0 + tile_w] = motif
    return grid


def _gen_apply_damage(inp: np.ndarray, size: int, block_rows: int, block_cols: int, damage_cells: np.ndarray) -> None:
    damaged_br = int(np.random.randint(block_rows))
    damaged_bc = int(np.random.randint(block_cols))
    base_r = damaged_br * (size + GEN_SEPARATOR_WIDTH)
    base_c = damaged_bc * (size + GEN_SEPARATOR_WIDTH)
    inp[base_r + damage_cells[:, 0], base_c + damage_cells[:, 1]] = GEN_BG_COLOR


def _gen_attempt() -> np.ndarray | None:
    size = int(np.random.randint(GEN_TILE_SIZE_MIN, GEN_TILE_SIZE_MAX + 1))
    motif = _gen_build_motif(size)
    separator = _gen_separator(motif)
    damage_cells = _gen_damage_cells(motif)
    out = motif.copy()
    out[damage_cells[:, 0], damage_cells[:, 1]] = Color.BLUE
    block_rows = _gen_block_count(size)
    block_cols = _gen_block_count(size)
    inp = _gen_tile_lattice(motif, block_rows, block_cols, separator)
    _gen_apply_damage(inp, size, block_rows, block_cols, damage_cells)

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {GEN_RETRY_LIMIT} attempts")

