+
+
+def _to_grid(
+    depth: int,
+    lateral: int,
+    direction: int,
+    depth_size: int,
+    lateral_size: int,
+) -> tuple[int, int]:
+    """Map inward depth/lateral coordinates to canonical (row, col)."""
+    if direction == 0:  # top -> down
+        return depth, lateral
+    if direction == 1:  # bottom -> up
+        return depth_size - 1 - depth, lateral
