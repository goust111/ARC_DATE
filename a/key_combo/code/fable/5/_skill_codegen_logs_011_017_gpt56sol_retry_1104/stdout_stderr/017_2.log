+            terminal = plan["terminal_cell"]
+            if terminal not in walls or actual[terminal] != grid[terminal]:
+                return False
+            behind = _to_grid(
+                end_depth + 1,
+                end_lane,
+                plan["orientation"],
+                plan["depth_size"],
+                plan["lateral_size"],
