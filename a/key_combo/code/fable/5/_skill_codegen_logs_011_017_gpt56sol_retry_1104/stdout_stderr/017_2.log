+
+
+def _well_separated(
+    cell: tuple[int, int],
+    reserved: set[tuple[int, int]],
+    distance: int = 1,
+) -> bool:
+    return all(max(abs(cell[0] - r), abs(cell[1] - c)) > distance for r, c in reserved)
