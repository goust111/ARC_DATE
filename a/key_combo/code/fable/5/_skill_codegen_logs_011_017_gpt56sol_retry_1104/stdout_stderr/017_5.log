from __future__ import annotations

import numpy as np
from scipy.ndimage import binary_dilation

import random

from arc_utils import (
    Color,
    STRUCT8,
    colors_present,
    components_mask,
    get_bg,
    in_bounds,
    label_mask,
    neighbors4,
