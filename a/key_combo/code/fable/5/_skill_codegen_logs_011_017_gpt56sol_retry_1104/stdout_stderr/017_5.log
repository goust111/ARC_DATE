from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste
import random


def _assert_solid_rectangle(g: np.ndarray, color: int, component: dict) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = map(int, component["bbox"])
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    assert int(component["area"]) == h * w, "foreground objects must be solid rectangles"
    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(color)), "rectangle bbox must be filled"
    return r0, c0, r1, c1


def _facing_corners(
    upper: tuple[int, int, int, int],
    lower: tuple[int, int, int, int],
) -> tuple[tuple[int, int], tuple[int, int]]:
    _ur0, uc0, ur1, uc1 = upper
    lr0, lc0, _lr1, lc1 = lower
    assert ur1 < lr0, "paired rectangles must be vertically separated"

    if uc1 < lc0:
        return (ur1, uc1), (lr0, lc0)
    if lc1 < uc0:
        return (ur1, uc0), (lr0, lc1)
    raise AssertionError("paired rectangles must be diagonally separated")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw the missing diagonal connector segment between each pair of same-color rectangular objects.

    Input structure:
    - The grid has one dominant background color.
    - Every foreground color appears as exactly two separated solid rectangular 4-connected objects.
    - The two rectangles of each color are diagonally offset with facing corners on a 45-degree line.

    Rule:
    - Keep all existing rectangles unchanged.
    - For each foreground color, connect the lower facing corner of the upper rectangle to the upper facing corner of the lower rectangle.
    - Paint only the intervening background pixels on that diagonal, excluding the two endpoint pixels already in the rectangles.

    Key insight:
    - Same-color rectangles define the endpoints; the output completes the open diagonal between their nearest facing corners.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    out = g.copy()

    for color in colors_present(g, exclude={bg}):
        components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color])
        assert len(components) == 2, "each foreground color must have exactly two objects"

        rectangles = [_assert_solid_rectangle(g, int(color), component) for component in components]
        rectangles.sort(key=lambda b: b[0])
        upper, lower = rectangles
        start, end = _facing_corners(upper, lower)

        row_delta = int(end[0] - start[0])
        col_delta = int(end[1] - start[1])
        assert row_delta > 0, "connector must go downward from the upper rectangle"
        assert abs(row_delta) == abs(col_delta), "facing corners must be diagonally aligned"

        dr = 1
        dc = 1 if col_delta > 0 else -1
        r, c = int(start[0] + dr), int(start[1] + dc)
        while (r, c) != end:
            assert int(out[r, c]) == bg, "connector path must pass through background"
            out[r, c] = int(color)
            r += dr
            c += dc

    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and palette.
BG, N = 7, 16
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]

# Pair sampling and rectangle spacing.
PAIR_COUNTS = [3, 4, 5]
PAIR_COUNT_WEIGHTS = [4, 10, 60]
LARGE_RECT_SIZE, SMALL_RECT_SIZE = 3, 2
MIN_RECT_GAP = 2

# Connector sampling and retry budget.
DIRECTIONS = [1, -1]
GAP_RANGE, MAX_ATTEMPTS = (2, 6), 300

Box = tuple[int, int, int, int]
Cells = list[tuple[int, int]]
Candidate = tuple[Box, Box, Cells]


def _bbox_gap_ok(a: Box, b: Box) -> bool:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    row_gap = max(ar0 - br1 - 1, br0 - ar1 - 1, 0)
    col_gap = max(ac0 - bc1 - 1, bc0 - ac1 - 1, 0)
    return max(row_gap, col_gap) >= MIN_RECT_GAP


def _rect_cells(box: Box) -> Cells:
    r0, c0, r1, c1 = box
    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]


def _candidate(
    size: int,
    direction: int,
    gap: int,
    ur: int,
    uc: int,
) -> Candidate | None:
    delta = gap + 1
    upper = (ur, uc, ur + size - 1, uc + size - 1)
    if direction == 1:
        start = (upper[2], upper[3])
        end = (start[0] + delta, start[1] + delta)
        lower = (end[0], end[1], end[0] + size - 1, end[1] + size - 1)
    else:
        start = (upper[2], upper[1])
        end = (start[0] + delta, start[1] - delta)
        lower = (end[0], end[1] - size + 1, end[0] + size - 1, end[1])

    if min(*upper, *lower) < 0 or max(upper[2], upper[3], lower[2], lower[3]) >= N:
        return None
    if not _bbox_gap_ok(upper, lower):
        return None
    diag = [(start[0] + k, start[1] + direction * k) for k in range(1, gap + 1)]
    return upper, lower, diag


def _valid_candidates(
    occupied: np.ndarray,
    existing_rects: list[Box],
    size: int,
    direction: int,
    gap: int,
) -> list[Candidate]:
    out = []
    for ur in range(N - size + 1):
        for uc in range(N - size + 1):
            cand = _candidate(size, direction, gap, ur, uc)
            if cand is None:
                continue
            upper, lower, diag = cand
            if any(not _bbox_gap_ok(box, old) for box in (upper, lower) for old in existing_rects):
                continue
            cells = _rect_cells(upper) + _rect_cells(lower) + diag
            if any(bool(occupied[r, c]) for r, c in cells):
                continue
            out.append(cand)
    random.shuffle(out)
    return out


def _place_rect(grid: np.ndarray, box: Box, color: int) -> None:
    r0, c0, r1, c1 = box
    grid[r0 : r1 + 1, c0 : c1 + 1] = color


def _sample_plan(n_pairs: int) -> tuple[list[int], list[int], list[int], list[int], list[int]]:
    colors = random.sample(FOREGROUND_COLORS, n_pairs)
    sizes = [LARGE_RECT_SIZE] + [SMALL_RECT_SIZE] * (n_pairs - 1)
    random.shuffle(sizes)
    directions = [1, -1] + [random.choice(DIRECTIONS) for _ in range(n_pairs - 2)]
    random.shuffle(directions)
    gaps = [random.randint(*GAP_RANGE) for _ in range(n_pairs)]
    order = list(range(n_pairs))
    random.shuffle(order)
    order.sort(key=lambda i: (sizes[i], gaps[i]), reverse=True)
    return colors, sizes, directions, gaps, order


def _gen_attempt() -> np.ndarray | None:
    n_pairs = random.choices(PAIR_COUNTS, weights=PAIR_COUNT_WEIGHTS, k=1)[0]
    colors, sizes, directions, gaps, order = _sample_plan(n_pairs)
    output = np.full((N, N), BG, dtype=int)
    occupied = np.zeros((N, N), dtype=bool)
    rects: list[Box] = []
    diagonals: list[Cells] = []

    for idx in order:
        cands = _valid_candidates(occupied, rects, sizes[idx], directions[idx], gaps[idx])
        if not cands:
            return None
        upper, lower, diag = random.choice(cands)
        color = colors[idx]
        _place_rect(output, upper, color)
        _place_rect(output, lower, color)
        for r, c in diag:
            output[r, c] = color
        for r, c in _rect_cells(upper) + _rect_cells(lower) + diag:
            occupied[r, c] = True
        rects.extend([upper, lower])
        diagonals.append(diag)

    inp = output.copy()
    for diag in diagonals:
        for r, c in diag:
            inp[r, c] = BG
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 342ae2ed input")
from __future__ import annotations
import numpy as np
from arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Sort scattered 4×4 squares into two columns by type: frames left, solids right.

    Input structure:
    - bg = most common color. Multiple 4×4 objects on bg.
    - Frames: colored 1px border, bg-filled 2×2 interior.
    - Solids: entirely filled with one non-bg color.

    Rule:
    - Classify each 4×4 object as frame or solid by its interior.
    - Sort each group top-to-bottom by input row.
    - Stack frames in left column (cols 0–3), solids in right (cols 4–7).
    - Output is 8 wide; height = 4 × max(#frames, #solids), bg-padded.

    Key insight: Frame vs solid is determined solely by whether the 2×2 interior matches bg.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    frames: list[tuple[int, int, np.ndarray]] = []
    solids: list[tuple[int, int, np.ndarray]] = []

    for comp in comps:
        b = comp["bbox"]
        if bbox_h(b) != 4 or bbox_w(b) != 4:
            continue
        r0, c0, _r1, _c1 = b
        sub = crop_bbox(g, b)

        border = np.concatenate([sub[0, :], sub[-1, :], sub[1:-1, 0], sub[1:-1, -1]])
        bcols = set(map(int, border.flatten()))

        if len(bcols) == 1 and bool((sub[1:3, 1:3] == int(bg)).all()):
            frames.append((int(r0), int(c0), sub))
        else:
            solids.append((int(r0), int(c0), sub))

    frames.sort(key=lambda t: (int(t[0]), int(t[1])))
    solids.sort(key=lambda t: (int(t[0]), int(t[1])))

    outH = 4 * max(int(len(frames)), int(len(solids)))
    outW = 8
    out = np.full((outH, outW), int(bg), dtype=int)

    for i, (_r0, _c0, sub) in enumerate(frames):
        paste(out, sub, int(i * 4), 0)
    for i, (_r0, _c0, sub) in enumerate(solids):
        paste(out, sub, int(i * 4), 4)

    return out


def _make_frame(col: int, bg: int = 0) -> np.ndarray:
    a = np.full((4, 4), col, dtype=int)
    a[1:3, 1:3] = bg
    return a

def _make_solid(col: int) -> np.ndarray:
    return np.full((4, 4), col, dtype=int)

def _gen_attempt() -> np.ndarray | None:
    bg = 0
    H = int(np.random.randint(18, 30))
    W = int(np.random.randint(18, 30))
    g = np.full((H, W), bg, dtype=int)
    n_frames = int(np.random.randint(1, 5))
    n_solids = int(np.random.randint(1, 5))
    try:
        used_cols: set[int] = set()
        for _ in range(n_frames):
            col = int(np.random.randint(1, 10))
            while col in used_cols:
                col = int(np.random.randint(1, 10))
            used_cols.add(col)
            r0, c0 = random_free_location(g, _make_frame(col, bg), transparent=bg, border=1, padding=1, padding_connectivity=4)
            paste(g, _make_frame(col, bg), r0, c0, transparent=bg)
        for _ in range(n_solids):
            col = int(np.random.randint(1, 10))
            while col in used_cols:
                col = int(np.random.randint(1, 10))
            used_cols.add(col)
            r0, c0 = random_free_location(g, _make_solid(col), transparent=bg, border=1, padding=1, padding_connectivity=4)
            paste(g, _make_solid(col), r0, c0, transparent=bg)
        return g
    except Exception:
        return None

def generate_input() -> np.ndarray:
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("generate_input failed after 300 attempts")


from __future__ import annotations

import numpy as np

from arc_utils import bbox, colors_present, get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete every colored sprite by applying the union of all aligned partial sprite masks.

    Input structure:
    - The dominant color is the background.
    - Each non-background color appears as a separated partial copy of one common sprite mask.
    - The copies share a top-left-aligned sprite window; some copies may be missing lower or right edge pixels.

    Rule:
    - Crop each same-color mask to its bounding box.
    - Pad the crops to the maximum observed height and width, aligned at the top-left, and OR them into one complete template.
    - Fill that template at every sprite location using the sprite's own color.

    Key insight:
    - No single input sprite is complete, but their missing cells are complementary, so the aligned union reveals the full mask.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)

    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) >= 2, "expected multiple partial sprite copies"

    sprites: list[tuple[int, int, int, np.ndarray]] = []
    for color in colors:
        mask = g == color
        box = bbox(mask)
        assert box is not None, "each foreground color must be present"
        r0, c0, r1, c1 = box
        local = mask[r0 : r1 + 1, c0 : c1 + 1]
        assert np.any(local), "expected a nonempty sprite mask"
        sprites.append((int(color), int(r0), int(c0), local))

    template_h = max(local.shape[0] for _, _, _, local in sprites)
    template_w = max(local.shape[1] for _, _, _, local in sprites)
    assert template_h > 0 and template_w > 0

    template = np.zeros((template_h, template_w), dtype=bool)
    for _, _, _, local in sprites:
        local_h, local_w = map(int, local.shape)
        template[:local_h, :local_w] |= local
    assert np.any(template), "expected a nonempty recovered sprite template"

    out = g.copy()
    for color, r0, c0, _ in sprites:
        r1 = r0 + template_h
        c1 = c0 + template_w
        assert r1 <= height and c1 <= width, "sprite window must fit in the grid"
        region = out[r0:r1, c0:c1]
        assert np.all((region == bg) | (region == color)), "sprite windows must not overlap other colors"
        region[template] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas and palette bounds.
GRID_HEIGHT_RANGE = (11, 22)
GRID_WIDTH_RANGE = (18, 22)
PALETTE_SIZE = 10

# Template geometry and growth.
TEMPLATE_SIDE_RANGE = (5, 7)
TEMPLATE_FILL_FRACTION_RANGE = (0.48, 0.84)
TEMPLATE_STOP_PROBABILITY = 0.35
PATH_VERTICAL_FIRST_PROBABILITY = 0.5
ORTHOGONAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Sprite layout constraints.
SPRITE_COUNT_RANGE = (2, 4)
WINDOW_GAP = 1

# Per-sprite damage limits.
DAMAGE_FRACTION_RANGE = (0.07, 0.33)
DAMAGE_MISSING_PIXEL_RANGE = (1, 6)

# Rejection sampling limit.
GENERATION_RETRY_LIMIT = 300


def _gen_path(mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:
    r, c = a
    tr, tc = b
    if random.random() < PATH_VERTICAL_FIRST_PROBABILITY:
        while r != tr:
            mask[r, c] = True
            r += 1 if tr > r else -1
        while c != tc:
            mask[r, c] = True
            c += 1 if tc > c else -1
    else:
        while c != tc:
            mask[r, c] = True
            c += 1 if tc > c else -1
        while r != tr:
            mask[r, c] = True
            r += 1 if tr > r else -1
    mask[tr, tc] = True


def _gen_orbit(side: int, r: int, c: int) -> set[tuple[int, int]]:
    last = side - 1
    return {
        (r, c),
        (c, r),
        (last - r, c),
        (r, last - c),
        (last - r, last - c),
        (last - c, last - r),
        (c, last - r),
        (last - c, r),
    }


def _gen_add_orbit(mask: np.ndarray, r: int, c: int) -> None:
    for rr, cc in _gen_orbit(mask.shape[0], r, c):
        mask[rr, cc] = True


def _gen_template(side: int) -> np.ndarray | None:
    min_fill, max_fill = TEMPLATE_FILL_FRACTION_RANGE
    min_area = int(np.ceil(min_fill * side * side))
    max_area = int(np.floor(max_fill * side * side))
    target = random.randint(min_area, max_area)

    mask = np.zeros((side, side), dtype=bool)
    center = side // 2
    top_c = random.randrange(side)
    _gen_path(mask, (center, center), (0, top_c))
    for r, c in list(map(tuple, np.argwhere(mask))):
        _gen_add_orbit(mask, int(r), int(c))

    if int(mask.sum()) > max_area:
        return None
    target = max(target, int(mask.sum()))

    while int(mask.sum()) < target:
        orbit_choices = []
        for r, c in np.argwhere(mask):
            for dr, dc in ORTHOGONAL_STEPS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < side and 0 <= nc < side and not mask[nr, nc]:
                    orbit = _gen_orbit(side, int(nr), int(nc))
                    added = sum(1 for p in orbit if not mask[p])
                    if added and int(mask.sum()) + added <= max_area:
                        orbit_choices.append((int(nr), int(nc), added))
        if not orbit_choices:
            return None
        if int(mask.sum()) >= min_area and random.random() < TEMPLATE_STOP_PROBABILITY:
            break
        r, c, _ = random.choice(orbit_choices)
        _gen_add_orbit(mask, r, c)

    if not (min_area <= int(mask.sum()) <= max_area):
        return None
    return mask


def _gen_windows(height: int, width: int, side: int, count: int) -> list[tuple[int, int]] | None:
    windows: list[tuple[int, int]] = []
    candidates = [(r, c) for r in range(height - side + 1) for c in range(width - side + 1)]
    for _ in range(count):
        valid = []
        for r, c in candidates:
            ok = True
            for pr, pc in windows:
                separated_rows = (
                    r + side <= pr - WINDOW_GAP or pr + side <= r - WINDOW_GAP
                )
                separated_cols = (
                    c + side <= pc - WINDOW_GAP or pc + side <= c - WINDOW_GAP
                )
                if not (separated_rows or separated_cols):
                    ok = False
                    break
            if ok:
                valid.append((r, c))
        if not valid:
            return None
        windows.append(random.choice(valid))
    return windows


def _gen_damaged_masks(template: np.ndarray, count: int) -> list[np.ndarray] | None:
    coords = [tuple(map(int, rc)) for rc in np.argwhere(template)]
    area = len(coords)
    min_damage, max_damage = DAMAGE_FRACTION_RANGE
    min_missing, max_missing = DAMAGE_MISSING_PIXEL_RANGE
    low = max(min_missing, int(np.ceil(min_damage * area)))
    high = min(max_missing, int(np.floor(max_damage * area)))
    if low > high:
        return None

    top = random.choice([p for p in coords if p[0] == 0])
    left = random.choice([p for p in coords if p[1] == 0])
    bottom = random.choice([p for p in coords if p[0] == template.shape[0] - 1])
    right = random.choice([p for p in coords if p[1] == template.shape[1] - 1])

    missing_counts = {p: 0 for p in coords}
    masks = []
    for i in range(count):
        protect = {top, left}
        if i == 0:
            protect |= {bottom, right}
        k = random.randint(low, high)
        missing = set()
        for _ in range(k):
            choices = [
                p
                for p in coords
                if p not in protect
                and p not in missing
                and missing_counts[p] < count - 1
            ]
            if not choices:
                return None
            p = random.choice(choices)
            missing.add(p)
            missing_counts[p] += 1
        m = template.copy()
        if missing:
            rr, cc = zip(*missing)
            m[rr, cc] = False
        masks.append(m)

    if not np.array_equal(np.logical_or.reduce(masks), template):
        return None
    return masks


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*GRID_HEIGHT_RANGE)
    width = random.randint(*GRID_WIDTH_RANGE)
    side = random.randint(*TEMPLATE_SIDE_RANGE)
    count = random.randint(*SPRITE_COUNT_RANGE)

    template = _gen_template(side)
    if template is None:
        return None

    windows = _gen_windows(height, width, side, count)
    if windows is None:
        return None

    masks = _gen_damaged_masks(template, count)
    if masks is None:
        return None

    colors = list(range(PALETTE_SIZE))
    bg = random.choice(colors)
    fg_colors = random.sample([c for c in colors if c != bg], count)

    inp = np.full((height, width), bg, dtype=int)
    expected = inp.copy()
    for color, (r0, c0), damaged in zip(fg_colors, windows, masks):
        inp[r0 : r0 + side, c0 : c0 + side][damaged] = color
        expected[r0 : r0 + side, c0 : c0 + side][template] = color

    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid f8cc533f input")

