+    for item in objects:
+        patch = item["patch"]
+        ph, pw = map(int, patch.shape)
+        candidates: list[tuple[int, int]] = []
+        for r in range(1, height - ph):
+            for c in range(1, width - pw):
+                # Reserve complete bounding boxes, including frame cavities, with
