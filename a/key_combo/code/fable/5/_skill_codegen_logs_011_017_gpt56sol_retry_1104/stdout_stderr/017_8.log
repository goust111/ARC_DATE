+    units: list[dict] = []
+    for i in order:
+        h, w = map(int, spec["inner_shapes"][i])
+        unit = _make_frame((h, w), int(spec["frame_colors"][i]), bg)
+        unit[1:-1, 1:-1] = int(spec["block_colors"][i])
+        units.append({"grid": unit})
+    return _stack_units(units, bg)
+
+
