+def _sample_spec() -> dict | None:
+    n = random.choices((4, 5), weights=(3, 1), k=1)[0]
+
+    # This forced pair is an area-vs-perimeter counterexample: area 15 or 16
+    # is larger than area 14, while its perimeter is smaller.
