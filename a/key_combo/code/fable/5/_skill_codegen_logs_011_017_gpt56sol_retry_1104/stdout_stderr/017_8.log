+            coords = np.asarray(cells, dtype=int)
+            r0, c0 = map(int, coords.min(axis=0))
+            r1, c1 = map(int, coords.max(axis=0))
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "sprite": grid[r0 : r1 + 1, c0 : c1 + 1].copy(),
