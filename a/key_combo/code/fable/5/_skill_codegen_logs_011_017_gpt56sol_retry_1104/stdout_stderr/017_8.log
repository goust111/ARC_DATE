+            start = tuple(map(int, np.argwhere(unseen)[0]))
+            unseen[start] = False
+            queue = deque([start])
+            cells: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= nr < height and 0 <= nc < width and bool(unseen[nr, nc]):
+                        unseen[nr, nc] = False
+                        queue.append((nr, nc))
