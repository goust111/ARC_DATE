+    Key insight:
+    - The marker's quadrant supplies the rotation, while the sample's internal odd-colored pixel—not a bounding-box corner or center—supplies the translation anchor.
+    """
+    scene = _parse_scene(grid)
+    g = scene["grid"]
+    bg = int(scene["bg"])
