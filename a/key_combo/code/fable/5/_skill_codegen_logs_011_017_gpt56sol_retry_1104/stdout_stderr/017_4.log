+    relative = {(int(r) - ar, int(c) - ac) for r, c in np.argwhere(mask)}
+    if any(
+        {_rotate_offset_clockwise(dr, dc, k) for dr, dc in relative} == relative
+        for k in (1, 2, 3)
+    ):
