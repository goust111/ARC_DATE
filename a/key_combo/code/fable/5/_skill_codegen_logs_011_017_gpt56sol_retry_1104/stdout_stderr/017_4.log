+        r1, c1 = coords.max(axis=0)
+        if (ar, ac) in {(int(r0), int(c0)), (int(r0), int(c1)), (int(r1), int(c0)), (int(r1), int(c1))}:
+            return False
+        if 2 * ar == int(r0 + r1) and 2 * ac == int(c0 + c1):
+            return False
