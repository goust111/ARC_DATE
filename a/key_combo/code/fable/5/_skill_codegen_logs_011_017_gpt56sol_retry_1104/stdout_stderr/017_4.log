+    anchor_bitmap[local_anchor] = True
+    for marker_r, marker_c, color, target_q in markers:
+        turns = (target_q - sample_q) % 4
+        rotated = np.rot90(mask, k=-turns)
+        rotated_anchor = np.argwhere(np.rot90(anchor_bitmap, k=-turns))
