+        for raw_r, raw_c in coords:
+            r, c = int(raw_r), int(raw_c)
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) in orange_owner:
