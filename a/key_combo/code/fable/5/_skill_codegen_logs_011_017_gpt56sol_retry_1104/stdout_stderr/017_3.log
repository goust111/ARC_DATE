+        assert len(cells) <= len(stripe_list)
+        for stripe in stripe_list[: len(cells)]:
+            for r, c in stripe:
+                assert expected[r, c] in {CONTAINER_COLOR, color}
+                expected[r, c] = color
+    return expected
+
+
+def _generate_vertical_case() -> tuple[np.ndarray, np.ndarray, dict]:
