GEN_GRID_SHAPE = (10, 10)
GEN_TOP_ROW = 0
GEN_BOTTOM_ROW = 9
GEN_LEFT_COL = 0
GEN_RIGHT_COL = 9
GEN_MIN_CHANNEL_COL = 1
GEN_MAX_CHANNEL_COL = 8

# Segment and turn sampling.
GEN_MIN_TURNS = 2
GEN_MAX_TURNS = 4
GEN_VERTICAL_MIN = 2
GEN_VERTICAL_MAX = 7
