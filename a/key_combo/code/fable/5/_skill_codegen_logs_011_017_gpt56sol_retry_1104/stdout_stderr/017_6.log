# Canvas and palette.
BG, N = 7, 16
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]

# Pair sampling and rectangle spacing.
PAIR_COUNTS = [3, 4, 5]
PAIR_COUNT_WEIGHTS = [4, 10, 60]
LARGE_RECT_SIZE, SMALL_RECT_SIZE = 3, 2
MIN_RECT_GAP = 2

# Connector sampling and retry budget.
DIRECTIONS = [1, -1]
GAP_RANGE, MAX_ATTEMPTS = (2, 6), 300

Box = tuple[int, int, int, int]
Cells = list[tuple[int, int]]
Candidate = tuple[Box, Box, Cells]


def _bbox_gap_ok(a: Box, b: Box) -> bool:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    row_gap = max(ar0 - br1 - 1, br0 - ar1 - 1, 0)
    col_gap = max(ac0 - bc1 - 1, bc0 - ac1 - 1, 0)
    return max(row_gap, col_gap) >= MIN_RECT_GAP


def _rect_cells(box: Box) -> Cells:
    r0, c0, r1, c1 = box
    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]


def _candidate(
    size: int,
    direction: int,
    gap: int,
    ur: int,
    uc: int,
) -> Candidate | None:
    delta = gap + 1
    upper = (ur, uc, ur + size - 1, uc + size - 1)
    if direction == 1:
        start = (upper[2], upper[3])
        end = (start[0] + delta, start[1] + delta)
        lower = (end[0], end[1], end[0] + size - 1, end[1] + size - 1)
    else:
        start = (upper[2], upper[1])
        end = (start[0] + delta, start[1] - delta)
        lower = (end[0], end[1] - size + 1, end[0] + size - 1, end[1])

    if min(*upper, *lower) < 0 or max(upper[2], upper[3], lower[2], lower[3]) >= N:
        return None
    if not _bbox_gap_ok(upper, lower):
        return None
    diag = [(start[0] + k, start[1] + direction * k) for k in range(1, gap + 1)]
    return upper, lower, diag


def _valid_candidates(
    occupied: np.ndarray,
    existing_rects: list[Box],
    size: int,
    direction: int,
    gap: int,
) -> list[Candidate]:
    out = []
    for ur in range(N - size + 1):
        for uc in range(N - size + 1):
            cand = _candidate(size, direction, gap, ur, uc)
            if cand is None:
                continue
            upper, lower, diag = cand
            if any(not _bbox_gap_ok(box, old) for box in (upper, lower) for old in existing_rects):
                continue
            cells = _rect_cells(upper) + _rect_cells(lower) + diag
            if any(bool(occupied[r, c]) for r, c in cells):
                continue
            out.append(cand)
    random.shuffle(out)
    return out


def _place_rect(grid: np.ndarray, box: Box, color: int) -> None:
    r0, c0, r1, c1 = box
    grid[r0 : r1 + 1, c0 : c1 + 1] = color


def _sample_plan(n_pairs: int) -> tuple[list[int], list[int], list[int], list[int], list[int]]:
    colors = random.sample(FOREGROUND_COLORS, n_pairs)
    sizes = [LARGE_RECT_SIZE] + [SMALL_RECT_SIZE] * (n_pairs - 1)
    random.shuffle(sizes)
    directions = [1, -1] + [random.choice(DIRECTIONS) for _ in range(n_pairs - 2)]
    random.shuffle(directions)
    gaps = [random.randint(*GAP_RANGE) for _ in range(n_pairs)]
    order = list(range(n_pairs))
    random.shuffle(order)
    order.sort(key=lambda i: (sizes[i], gaps[i]), reverse=True)
    return colors, sizes, directions, gaps, order


def _gen_attempt() -> np.ndarray | None:
    n_pairs = random.choices(PAIR_COUNTS, weights=PAIR_COUNT_WEIGHTS, k=1)[0]
    colors, sizes, directions, gaps, order = _sample_plan(n_pairs)
    output = np.full((N, N), BG, dtype=int)
    occupied = np.zeros((N, N), dtype=bool)
    rects: list[Box] = []
    diagonals: list[Cells] = []

    for idx in order:
        cands = _valid_candidates(occupied, rects, sizes[idx], directions[idx], gaps[idx])
        if not cands:
            return None
        upper, lower, diag = random.choice(cands)
        color = colors[idx]
        _place_rect(output, upper, color)
        _place_rect(output, lower, color)
        for r, c in diag:
            output[r, c] = color
        for r, c in _rect_cells(upper) + _rect_cells(lower) + diag:
            occupied[r, c] = True
        rects.extend([upper, lower])
        diagonals.append(diag)

    inp = output.copy()
    for diag in diagonals:
        for r, c in diag:
            inp[r, c] = BG
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 342ae2ed input")
from __future__ import annotations
import numpy as np
from arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Sort scattered 4×4 squares into two columns by type: frames left, solids right.

    Input structure:
    - bg = most common color. Multiple 4×4 objects on bg.
    - Frames: colored 1px border, bg-filled 2×2 interior.
    - Solids: entirely filled with one non-bg color.

    Rule:
    - Classify each 4×4 object as frame or solid by its interior.
    - Sort each group top-to-bottom by input row.
    - Stack frames in left column (cols 0–3), solids in right (cols 4–7).
    - Output is 8 wide; height = 4 × max(#frames, #solids), bg-padded.

    Key insight: Frame vs solid is determined solely by whether the 2×2 interior matches bg.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    frames: list[tuple[int, int, np.ndarray]] = []
    solids: list[tuple[int, int, np.ndarray]] = []

    for comp in comps:
        b = comp["bbox"]
        if bbox_h(b) != 4 or bbox_w(b) != 4:
            continue
        r0, c0, _r1, _c1 = b
        sub = crop_bbox(g, b)

        border = np.concatenate([sub[0, :], sub[-1, :], sub[1:-1, 0], sub[1:-1, -1]])
        bcols = set(map(int, border.flatten()))

        if len(bcols) == 1 and bool((sub[1:3, 1:3] == int(bg)).all()):
            frames.append((int(r0), int(c0), sub))
        else:
            solids.append((int(r0), int(c0), sub))

    frames.sort(key=lambda t: (int(t[0]), int(t[1])))
    solids.sort(key=lambda t: (int(t[0]), int(t[1])))

    outH = 4 * max(int(len(frames)), int(len(solids)))
    outW = 8
    out = np.full((outH, outW), int(bg), dtype=int)

    for i, (_r0, _c0, sub) in enumerate(frames):
        paste(out, sub, int(i * 4), 0)
    for i, (_r0, _c0, sub) in enumerate(solids):
        paste(out, sub, int(i * 4), 4)

    return out


def _make_frame(col: int, bg: int = 0) -> np.ndarray:
    a = np.full((4, 4), col, dtype=int)
    a[1:3, 1:3] = bg
    return a

def _make_solid(col: int) -> np.ndarray:
    return np.full((4, 4), col, dtype=int)

def _gen_attempt() -> np.ndarray | None:
    bg = 0
    H = int(np.random.randint(18, 30))
    W = int(np.random.randint(18, 30))
    g = np.full((H, W), bg, dtype=int)
    n_frames = int(np.random.randint(1, 5))
    n_solids = int(np.random.randint(1, 5))
    try:
        used_cols: set[int] = set()
        for _ in range(n_frames):
            col = int(np.random.randint(1, 10))
            while col in used_cols:
                col = int(np.random.randint(1, 10))
            used_cols.add(col)
            r0, c0 = random_free_location(g, _make_frame(col, bg), transparent=bg, border=1, padding=1, padding_connectivity=4)
            paste(g, _make_frame(col, bg), r0, c0, transparent=bg)
        for _ in range(n_solids):
            col = int(np.random.randint(1, 10))
            while col in used_cols:
                col = int(np.random.randint(1, 10))
            used_cols.add(col)
            r0, c0 = random_free_location(g, _make_solid(col), transparent=bg, border=1, padding=1, padding_connectivity=4)
            paste(g, _make_solid(col), r0, c0, transparent=bg)
        return g
    except Exception:
        return None

def generate_input() -> np.ndarray:
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("generate_input failed after 300 attempts")


from __future__ import annotations
from collections import Counter
import numpy as np

def main(grid: np.ndarray) -> np.ndarray:
    """
    Reconstruct a 4-way symmetric mosaic by filling missing (black) pixels.

    Input structure:
    - A colored grid exhibiting bilateral symmetry along both a vertical and a horizontal axis.
    - Some pixels are erased to color 0 (black), creating gaps in the pattern.

    Rule:
    - Infer the vertical and horizontal reflection axes from the visible (non-zero) pixels.
    - For each black pixel, recover its color from the mirrored position across either axis or both.
    - When multiple mirrors yield candidates, use the majority color.

    Key insight: The reflection axes are not given — they must be deduced from the surviving pixels by finding the axes that best preserve the existing symmetry.
    """
    g = np.array(grid, dtype=int).copy()
    H, W = g.shape
    miss = 0
    assert not (not bool((g == int(miss)).any()))

    nz = g != int(miss)

    # Find best vertical axis (a2 = 2*axis), minimizing mismatches on known cells.
    best_a2 = 0
    best_key = None
    for a2 in range(0, 2 * (W - 1) + 1):
        mism = 0
        pairs = 0
        for r in range(H):
            cols = np.where(nz[int(r)])[0]
            for c in cols:
                c2 = int(a2) - int(c)
                if 0 <= c2 < W and bool(nz[int(r), int(c2)]):
                    pairs += 1
                    if int(g[int(r), int(c)]) != int(g[int(r), int(c2)]):
                        mism += 1
        key = (int(mism), -int(pairs))
        if best_key is None or key < best_key:
            best_key = key
            best_a2 = int(a2)

    # Find best horizontal axis (b2 = 2*axis), minimizing mismatches on known cells.
    best_b2 = 0
    best_key = None
    rows = np.where(nz.any(axis=1))[0]
    for b2 in range(0, 2 * (H - 1) + 1):
        mism = 0
        pairs = 0
        for r in rows:
            r2 = int(b2) - int(r)
            if not (0 <= r2 < H):
                continue
            cols = np.where(nz[int(r)] & nz[int(r2)])[0]
            pairs += int(len(cols))
            if len(cols):
                mism += int(np.sum(g[int(r), cols] != g[int(r2), cols]))
        key = (int(mism), -int(pairs))
        if best_key is None or key < best_key:
            best_key = key
            best_b2 = int(b2)

    out = g.copy()

    def fill_once(cur: np.ndarray) -> bool:
        changed = False
        zeros = np.argwhere(cur == int(miss))
        for r, c in zeros:
            r = int(r)
            c = int(c)
            cand: list[int] = []

            c2 = int(best_a2) - int(c)
            if 0 <= c2 < W and int(cur[int(r), int(c2)]) != int(miss):
                cand.append(int(cur[int(r), int(c2)]))

            r2 = int(best_b2) - int(r)
            if 0 <= r2 < H and int(cur[int(r2), int(c)]) != int(miss):
                cand.append(int(cur[int(r2), int(c)]))

            if 0 <= r2 < H and 0 <= c2 < W and int(cur[int(r2), int(c2)]) != int(miss):
                cand.append(int(cur[int(r2), int(c2)]))

            if cand:
                cur[int(r), int(c)] = int(Counter(cand).most_common(1)[0][0])
                changed = True
        return bool(changed)

    # Usually one pass suffices; do a few in case missing regions touch their mirrors.
    for _ in range(5):
        if not fill_once(out):
            break

    return out


def generate_input() -> np.ndarray:
    miss = 0
    H = int(np.random.randint(10, 18))
    W = int(np.random.randint(10, 18))

    # Symmetry axes through the center: a2 = W-1, b2 = H-1.
    a2 = int(W - 1)
    b2 = int(H - 1)

    pal = list(range(1, 10))
    g = np.full((H, W), int(miss), dtype=int)

    # Fill by orbit representatives under (r,c)->(r,b2-r) and (r,c)->(r,a2-c).
    seen = set()
    for r in range(H):
        for c in range(W):
            if (int(r), int(c)) in seen:
                continue
            orbit = {
                (int(r), int(c)),
                (int(r), int(a2 - c)),
                (int(b2 - r), int(c)),
                (int(b2 - r), int(a2 - c)),
            }
            orbit = {(rr, cc) for (rr, cc) in orbit if 0 <= rr < H and 0 <= cc < W}
            col = int(pal[int(np.random.randint(0, len(pal)))])
            for rr, cc in orbit:
                g[int(rr), int(cc)] = int(col)
                seen.add((int(rr), int(cc)))

    # Punch missing holes.
    n_holes = int(np.random.randint(max(1, (H * W) // 10), max(2, (H * W) // 4)))
    idx = np.random.choice(H * W, size=n_holes, replace=False)
    for k in idx:
        r = int(k // W)
        c = int(k % W)
        g[int(r), int(c)] = int(miss)

    # Ensure at least one non-missing pixel remains.
    if not bool((g != int(miss)).any()):
        g[int(H // 2), int(W // 2)] = 1
    return g


