+
+
+# ------------------------------ generator ------------------------------
+
+_RECT_SIZES = ((1, 2), (2, 1), (2, 2), (2, 3), (3, 2))
+_MAX_ATTEMPTS = 500
+_COLOR_COUNT_CYCLE = [2, 3, random.choice((2, 3))]
