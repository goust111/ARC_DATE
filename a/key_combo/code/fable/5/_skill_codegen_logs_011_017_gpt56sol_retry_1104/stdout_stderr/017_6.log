+
+
+def _choose_decoy(
+    pair: tuple[Box, Box], all_boxes: list[Box], path_cells: set[Coord], shape: tuple[int, int]
+) -> Box | None:
+    height, width = shape
+    candidates: list[Box] = []
+    sizes = list(_RECT_SIZES)
+    random.shuffle(sizes)
+    for h, w in sizes:
