+# ------------------------------ generator ------------------------------
+
+_RECT_SIZES = ((1, 2), (2, 1), (2, 2), (2, 3), (3, 2))
+_MAX_ATTEMPTS = 500
+
+
+def _box_cells(box: Box) -> set[Coord]:
+    r0, c0, r1, c1 = box
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
