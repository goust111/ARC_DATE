+def _box_cells(box: Box) -> set[Coord]:
+    r0, c0, r1, c1 = box
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def _inside(box: Box, shape: tuple[int, int]) -> bool:
+    return 0 <= box[0] <= box[2] < shape[0] and 0 <= box[1] <= box[3] < shape[1]
+
