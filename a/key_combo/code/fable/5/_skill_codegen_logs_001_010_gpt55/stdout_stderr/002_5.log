+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        cells: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            cells.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
