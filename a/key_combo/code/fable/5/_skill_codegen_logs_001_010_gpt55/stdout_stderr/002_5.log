+    assert not (ar in (0, H - 1) and ac in (0, W - 1)), "anchor must be on one edge, not a corner"
+    if ar == 0:
+        return (ar, ac), (1, 0)
+    if ar == H - 1:
+        return (ar, ac), (-1, 0)
+    if ac == 0:
