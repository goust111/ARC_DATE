+    expected, meta = _simulate_specs(shape, bg, anchor, anchor_color, away, specs)
+    alt_no_tail, _ = _simulate_specs(
+        shape, bg, anchor, anchor_color, away, specs, ignore_residual_obstacle=True
+    )
