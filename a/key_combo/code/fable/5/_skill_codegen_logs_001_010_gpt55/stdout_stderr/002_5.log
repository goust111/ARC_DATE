+def _components_of_color(g: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = g == int(color)
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    H, W = mask.shape
+    for sr, sc in np.argwhere(mask):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
