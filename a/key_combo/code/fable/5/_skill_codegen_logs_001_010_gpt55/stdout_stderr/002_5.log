+        if int(g[0, c]) not in (int(bg), GREY):
+            border.append((0, c))
+        if int(g[H - 1, c]) not in (int(bg), GREY):
+            border.append((H - 1, c))
+    for r in range(1, H - 1):
+        if int(g[r, 0]) not in (int(bg), GREY):
+            border.append((r, 0))
+        if int(g[r, W - 1]) not in (int(bg), GREY):
