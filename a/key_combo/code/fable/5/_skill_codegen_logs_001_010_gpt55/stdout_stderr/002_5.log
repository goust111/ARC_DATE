+def _build_specs(axis_len: int, block_colors: list[int]) -> list[dict] | None:
+    n = random.randint(3, min(5, len(block_colors)))
+    branches = ["surplus", "deficit"]
+    branches.extend(random.choice(("surplus", "exact", "deficit")) for _ in range(n - 2))
+
