+                fuel = needed + random.randint(1, 2)
+            elif branch == "tail_sensitive":
+                fuel = needed + max(1, previous_residual) + random.randint(0, 1)
+            elif branch == "after_deficit":
+                fuel = needed + random.randint(0, 2)
+            elif branch == "exact":
+                fuel = needed
+            else:
