+GRID_SIZE_RANGE = (23, 30)
+FRAME_COUNT_RANGE = (3, 5)
+FRAME_SIZE_RANGE = (7, 14)
+GEN_ATTEMPTS = 500
+RECT_ATTEMPTS = 800
