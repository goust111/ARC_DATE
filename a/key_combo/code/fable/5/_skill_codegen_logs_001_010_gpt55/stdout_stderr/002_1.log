+        sides = [
+            any(int(g[r0, c]) == color for c in range(c0, c1 + 1)),
+            any(int(g[r1, c]) == color for c in range(c0, c1 + 1)),
+            any(int(g[r, c0]) == color for r in range(r0, r1 + 1)),
+            any(int(g[r, c1]) == color for r in range(r0, r1 + 1)),
