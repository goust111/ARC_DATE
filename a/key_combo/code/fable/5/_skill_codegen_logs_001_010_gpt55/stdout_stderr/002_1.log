+def _occlusion_chain(g: np.ndarray, boxes: dict[int, tuple[int, int, int, int]]) -> list[int]:
+    colors = list(boxes)
+    perims = {color: _rect_perimeter(box) for color, box in boxes.items()}
+    edges: set[tuple[int, int]] = set()
