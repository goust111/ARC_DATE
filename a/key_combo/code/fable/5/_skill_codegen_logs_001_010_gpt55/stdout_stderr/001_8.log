+def _pad_bbox(box: BBox, shape: tuple[int, int], pad: int = 1) -> BBox:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    return (
+        max(0, r0 - pad),
+        max(0, c0 - pad),
+        min(h - 1, r1 + pad),
