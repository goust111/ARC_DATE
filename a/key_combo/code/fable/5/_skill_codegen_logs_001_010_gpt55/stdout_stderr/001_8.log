+    same_ring_center = _step(same_branch[-1], same_end_dir, 3)
+    wrong_end_dir = _unit_dir(wrong_branch[-2], wrong_branch[-1])
+    wrong_ring_center = _step(wrong_branch[-1], wrong_end_dir, 3)
