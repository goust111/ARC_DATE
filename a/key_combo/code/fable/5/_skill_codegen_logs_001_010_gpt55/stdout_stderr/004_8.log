+        masks,
+        fragment_positions,
+        target,
+        anchor,
+        anchor_color,
+        bg,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    """Generate a varied, semantically checked invisible-stamp instance."""
+    rng = np.random.default_rng()
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
