def _separated(
    candidate: tuple[int, int],
    placed: list[tuple[int, int]],
    height: int,
    width: int,
) -> bool:
    r, c = candidate
    for pr, pc in placed:
        if not (
            r + height + _GAP <= pr
            or pr + height + _GAP <= r
            or c + width + _GAP <= pc
            or pc + width + _GAP <= c
        ):
