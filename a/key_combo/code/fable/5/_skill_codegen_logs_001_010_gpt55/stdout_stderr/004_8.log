+    ar, ac = anchor
+    marker_r, marker_c = tr + ar, tc + ac
+    target_input = inp[tr : tr + height, tc : tc + width]
+    if int(np.sum(target_input != bg)) != 1 or int(target_input[ar, ac]) != anchor_color:
+        return False
