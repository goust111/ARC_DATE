from __future__ import annotations

import numpy as np

from arc_utils import Color, colors_present, find_components, get_bg, is_contiguous, paste
import itertools
import math
import random


RED = Color.RED
GREEN = Color.GREEN


def _component_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
    return mask


def _has_flanked_boundary_gap(mask: np.ndarray) -> bool:
    h, w = mask.shape

    for c in range(w):
        if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():
            return True
        if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():
            return True

    for r in range(h):
        if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():
            return True
        if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():
            return True

    return False


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide each foreground object horizontally to the edge indicated by whether its shape has an open notch.

    Input structure:
    - Yellow is the background and there is one blue foreground color.
    - The foreground is split into separated 4-connected objects.
    - Each object keeps its row span and shape in the output.

    Rule:
    - If an object's bbox border contains a background gap flanked by object pixels along that same border, slide it to the right edge and recolor it green.
    - Otherwise slide the object to the left edge and recolor it red.
    - Start from a blank background canvas; no moved objects overlap.

    Key insight:
    - The target side is encoded by the object's shape, not by its original position: open notches go right, while closed or solid shapes go left.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1, "expected exactly one foreground color"
    fg = int(fg_colors[0])

    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])
    assert components, "expected at least one foreground object"

    out = np.full_like(g, bg)
    W = g.shape[1]
    for component in components:
        bbox = tuple(map(int, component["bbox"]))
        r0, _c0, r1, _c1 = bbox
        mask = _component_mask(component["coords"], bbox)
        h, w = mask.shape

        has_open_notch = _has_flanked_boundary_gap(mask)
        dst_c = W - w if has_open_notch else 0
        color = GREEN if has_open_notch else RED
        assert 0 <= dst_c and dst_c + w <= W, "moved object must fit within the grid"

        dst = out[r0 : r1 + 1, dst_c : dst_c + w]
        assert dst.shape == (h, w), "destination slice must match object bbox"
        assert np.all(dst[mask] == bg), "moved objects must not overlap"
        dst[mask] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas and colors.
BG, BLUE, RED, GREEN = Color.YELLOW, Color.BLUE, Color.RED, Color.GREEN
GRID_H, GRID_W_MIN, GRID_W_MAX = 22, 19, 26

# Object counts, dimensions, and row separation.
OBJECT_COUNT_MIN, OBJECT_COUNT_MAX, NOTCH_OBJECT_COUNT = 3, 5, 2
OBJECT_H_MIN, OBJECT_H_MAX, OBJECT_W_MIN, OBJECT_W_MAX = 2, 6, 2, 9
MIN_ROW_GAP = 1

# Shape density and carving probabilities.
MIN_FILL_RATIO, CLOSED_LARGE_AREA_MIN = 0.64, 12
NOTCH_INTERIOR_CARVE_PROB, EXTRA_CARVE_PROB = 0.45, 0.20
CLOSED_CARVE_PROB_SMALL, CLOSED_CARVE_PROB_LARGE = 0.45, 0.88

# Placement and retry limits.
INTERIOR_COL_PAD, MAX_FOREGROUND_FRACTION = 1, 0.5
GENERATION_RETRIES = 300


def _has_flanked_boundary_gap(mask: np.ndarray) -> bool:
    h, w = mask.shape
    for c in range(w):
        if not mask[0, c] and mask[0, :c].any() and mask[0, c + 1 :].any():
            return True
        if h > 1 and not mask[h - 1, c] and mask[h - 1, :c].any() and mask[h - 1, c + 1 :].any():
            return True
    for r in range(h):
        if not mask[r, 0] and mask[:r, 0].any() and mask[r + 1 :, 0].any():
            return True
        if w > 1 and not mask[r, w - 1] and mask[:r, w - 1].any() and mask[r + 1 :, w - 1].any():
            return True
    return False


def _patch(mask: np.ndarray, color: int) -> np.ndarray:
    out = np.full(mask.shape, BG, dtype=int)
    out[mask] = int(color)
    return out


def _random_heights(n: int) -> list[int]:
    usable = GRID_H - MIN_ROW_GAP * (n - 1)
    choices = [
        hs
        for hs in itertools.product(range(OBJECT_H_MIN, OBJECT_H_MAX + 1), repeat=n)
        if sum(hs) <= usable
    ]
    return list(random.choice(choices))


def _row_starts(heights: list[int]) -> list[int]:
    free = GRID_H - sum(heights) - MIN_ROW_GAP * (len(heights) - 1)
    gaps = [0] * (len(heights) + 1)
    for _ in range(free):
        gaps[random.randrange(len(gaps))] += 1

    starts = []
    r = gaps[0]
    for i, h in enumerate(heights):
        starts.append(r)
        r += h
        if i + 1 < len(heights):
            r += MIN_ROW_GAP + gaps[i + 1]
    return starts


def _carve_interior_rect(mask: np.ndarray, max_remove: int, probability: float) -> int:
    if max_remove <= 0 or random.random() > probability:
        return 0

    h, w = mask.shape
    choices = []
    for r0 in range(1, h - 1):
        for c0 in range(1, w - 1):
            for r1 in range(r0, h - 1):
                for c1 in range(c0, w - 1):
                    area = (r1 - r0 + 1) * (c1 - c0 + 1)
                    if area <= max_remove and np.all(mask[r0 : r1 + 1, c0 : c1 + 1]):
                        choices.append((r0, c0, r1, c1, area))
    if not choices:
        return 0

    r0, c0, r1, c1, area = random.choice(choices)
    mask[r0 : r1 + 1, c0 : c1 + 1] = False
    return int(area)


def _make_notch_mask(h: int, w: int) -> np.ndarray | None:
    area = h * w
    max_remove = area - math.ceil(area * MIN_FILL_RATIO)
    edges = []
    if w >= OBJECT_W_MIN + 1:
        edges.extend(["top", "bottom"])
    if h >= OBJECT_H_MIN + 1:
        edges.extend(["left", "right"])
    if not edges or max_remove < 1:
        return None

    mask = np.ones((h, w), dtype=bool)
    edge = random.choice(edges)
    edge_len = w if edge in {"top", "bottom"} else h
    run = random.randint(1, min(edge_len - 2, max_remove))
    start = random.randint(1, edge_len - run - 1)

    if edge in {"top", "bottom"}:
        depth = random.randint(1, min(h - 1, max_remove // run))
        if edge == "top":
            mask[:depth, start : start + run] = False
        else:
            mask[h - depth :, start : start + run] = False
    elif edge == "left":
        depth = random.randint(1, min(w - 1, max_remove // run))
        mask[start : start + run, :depth] = False
    else:
        depth = random.randint(1, min(w - 1, max_remove // run))
        mask[start : start + run, w - depth :] = False

    removed = run * depth
    removed += _carve_interior_rect(mask, max_remove - removed, NOTCH_INTERIOR_CARVE_PROB)
    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
    if not _has_flanked_boundary_gap(mask):
        return None
    if not is_contiguous(mask.astype(int), background=0, connectivity=4):
        return None
    return mask


def _make_closed_mask(h: int, w: int) -> np.ndarray | None:
    area = h * w
    mask = np.ones((h, w), dtype=bool)
    max_remove = area - math.ceil(area * MIN_FILL_RATIO)
    probability = CLOSED_CARVE_PROB_LARGE if area >= CLOSED_LARGE_AREA_MIN else CLOSED_CARVE_PROB_SMALL
    removed = _carve_interior_rect(mask, max_remove, probability)
    _carve_interior_rect(mask, max_remove - removed, EXTRA_CARVE_PROB)
    if _has_flanked_boundary_gap(mask):
        return None
    if not is_contiguous(mask.astype(int), background=0, connectivity=4):
        return None
    return mask


def _sample_layout() -> tuple[int, list[str], list[int], list[int]]:
    W = random.randint(GRID_W_MIN, GRID_W_MAX)
    n = random.randint(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX)
    kinds = ["notch"] * NOTCH_OBJECT_COUNT + ["closed"] * (n - NOTCH_OBJECT_COUNT)
    random.shuffle(kinds)

    heights = _random_heights(n)
    starts = _row_starts(heights)
    return W, kinds, heights, starts


def _sample_objects(grid_w: int, kinds: list[str], starts: list[int], heights: list[int]):
    max_w = min(OBJECT_W_MAX, (grid_w - 1) // 2)

    objects = []
    for kind, r0, h in zip(kinds, starts, heights):
        if kind == "notch":
            widths = [w for w in range(OBJECT_W_MIN, max_w + 1) if w >= 3 or h >= 3]
            w = random.choice(widths)
            mask = _make_notch_mask(h, w)
            color, edge_c = GREEN, grid_w - w
        else:
            w = random.randint(OBJECT_W_MIN, max_w)
            mask = _make_closed_mask(h, w)
            color, edge_c = RED, 0
        if mask is None:
            return None
        objects.append((mask, r0, w, color, edge_c))
    return objects


def _render_pair(objects, grid_w: int) -> tuple[np.ndarray, np.ndarray] | None:
    inp = np.full((GRID_H, grid_w), BG, dtype=int)
    out = np.full((GRID_H, grid_w), BG, dtype=int)
    for mask, r0, w, color, edge_c in objects:
        paste(out, _patch(mask, color), r0, edge_c, transparent=BG)

    if sum(int(mask.sum()) for mask, *_ in objects) >= (GRID_H * grid_w) * MAX_FOREGROUND_FRACTION:
        return None

    for mask, r0, w, _color, _edge_c in objects:
        c0 = random.randint(INTERIOR_COL_PAD, grid_w - w - INTERIOR_COL_PAD)
        paste(inp, _patch(mask, BLUE), r0, c0, transparent=BG)
    return inp, out


def _oracle_accepts(inp: np.ndarray, out: np.ndarray) -> bool:
    try:
        solved = main(inp)
    except AssertionError:
        return False
    return bool(np.array_equal(solved, out))


def _gen_attempt() -> np.ndarray | None:
    W, kinds, heights, starts = _sample_layout()
    objects = _sample_objects(W, kinds, starts, heights)
    if objects is None:
        return None

    rendered = _render_pair(objects, W)
    if rendered is None:
        return None

    inp, out = rendered
    return inp if _oracle_accepts(inp, out) else None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 320afe60 input")
import numpy as np

from arc_utils import find_components, get_bg
import random


def _square_objects(g: np.ndarray, bg: int) -> list[dict]:
    objects = []
    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=True):
        r0, c0, r1, c1 = obj["bbox"]
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        if h == w and h >= 2 and int(obj["area"]) == h * w:
            objects.append({"side": int(h), "color": int(obj["color"]), "bbox": obj["bbox"]})
    return objects


def main(grid: np.ndarray) -> np.ndarray:
    """Render the filled-square object counts as compact nested stacks ordered by count rank.

    Input structure
    A large noisy grid has a dominant background, scattered non-square noise, and
    filled monochrome square objects. Each square side length has exactly one
    object color, and side lengths form consecutive sizes.

    Rule
    Ignore non-square components. If the lowest square in the scene is of the
    smallest side length, treat that one smallest square as a distractor and do
    not count it. For count rank k from left to right, create one block from all
    square sizes with at least k remaining objects; draw larger squares first and
    smaller squares over their upper-left corner, then append one background
    separator column.

    Key insight
    The output is a count histogram of square side lengths, but each histogram
    slot is rendered as nested upper-left square masks using the side colors.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    objects = _square_objects(g, bg)
    assert objects, "expected filled square objects"

    sides = sorted({obj["side"] for obj in objects})
    assert sides == list(range(sides[0], sides[-1] + 1)), "expected consecutive square side lengths"

    by_side = {side: [obj for obj in objects if obj["side"] == side] for side in sides}
    colors = {}
    for side, side_objects in by_side.items():
        side_colors = {obj["color"] for obj in side_objects}
        assert len(side_colors) == 1, "each side length should have one color"
        colors[side] = side_colors.pop()

    smallest = sides[0]
    lowest_row = max(obj["bbox"][2] for obj in objects)
    lowest_smallest = [obj for obj in by_side[smallest] if obj["bbox"][2] == lowest_row]
    if lowest_smallest:
        assert len(lowest_smallest) == 1, "expected at most one lowest smallest distractor"
        drop_bbox = lowest_smallest[0]["bbox"]
        by_side[smallest] = [obj for obj in by_side[smallest] if obj["bbox"] != drop_bbox]

    counts = {side: len(side_objects) for side, side_objects in by_side.items()}
    assert all(count > 0 for count in counts.values()), "each square size should remain represented"

    out_h = sides[-1] + 1
    groups = []
    for rank in range(max(counts.values())):
        present_sides = [side for side in sides if counts[side] > rank]
        assert present_sides, "rank should contain at least one square size"

        group_w = max(present_sides)
        group = np.full((out_h, group_w), bg, dtype=int)
        for side in sorted(present_sides, reverse=True):
            group[:side, :side] = colors[side]
        groups.append(group)

    out_w = sum(group.shape[1] + 1 for group in groups)
    out = np.full((out_h, out_w), bg, dtype=int)
    c = 0
    for group in groups:
        w = group.shape[1]
        out[:, c : c + w] = group
        c += w + 1

    return out

# --------------- generator (att1) ---------------

SIDES = [2, 3, 4]
ALL_COLORS = list(range(10))

# Canvas and object bounds.
GRID_SIZE_RANGE = (25, 28)
COUNT_RANGE = (2, 6)
SQUARE_GAP = 1

# Noise and distractor controls.
DISTRACTOR_PROB = 0.5
NOISE_COUNT_RANGE = (40, 70)

# Retry budget.
MAX_GENERATION_ATTEMPTS = 300


def _choose_palette() -> tuple[int, dict[int, int], int]:
    """Choose one background, three square colors, and one noise color."""
    bg = random.choice(ALL_COLORS)
    non_bg = [c for c in ALL_COLORS if c != bg]
    random.shuffle(non_bg)
    square_colors = {side: non_bg[i] for i, side in enumerate(SIDES)}
    return bg, square_colors, non_bg[len(SIDES)]


def _make_square_queue(
    counts: dict[int, int], square_colors: dict[int, int], has_distractor: bool
) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
    """Return regular squares plus the separately placed distractor candidate."""
    squares = [(side, square_colors[side]) for side in SIDES for _ in range(counts[side])]
    if has_distractor:
        squares.append((SIDES[0], square_colors[SIDES[0]]))

    random.shuffle(squares)
    if not has_distractor:
        return squares, None
    return squares[:-1], squares[-1]


def _free_positions(occupied: np.ndarray, side: int, min_r: int = 0) -> list[tuple[int, int]]:
    """List top-left positions whose padded square footprint is unoccupied."""
    H, W = occupied.shape
    valid = []
    for r in range(min_r, H - side + 1):
        for c in range(0, W - side + 1):
            r0 = max(0, r - SQUARE_GAP)
            r1 = min(H, r + side + SQUARE_GAP)
            c0 = max(0, c - SQUARE_GAP)
            c1 = min(W, c + side + SQUARE_GAP)
            if not occupied[r0:r1, c0:c1].any():
                valid.append((r, c))
    return valid


def _mark_occupied(occupied: np.ndarray, r: int, c: int, side: int) -> None:
    H, W = occupied.shape
    r0 = max(0, r - SQUARE_GAP)
    r1 = min(H, r + side + SQUARE_GAP)
    c0 = max(0, c - SQUARE_GAP)
    c1 = min(W, c + side + SQUARE_GAP)
    occupied[r0:r1, c0:c1] = True


def _place_square(
    grid: np.ndarray,
    occupied: np.ndarray,
    placed: list[tuple[int, int, int, int]],
    side: int,
    color: int,
    positions: list[tuple[int, int]] | None = None,
) -> bool:
    """Place one square at a random valid position and update grid state."""
    valid = _free_positions(occupied, side) if positions is None else positions
    if not valid:
        return False
    r, c = random.choice(valid)
    grid[r:r + side, c:c + side] = color
    _mark_occupied(occupied, r, c, side)
    placed.append((r, c, side, color))
    return True


def _place_squares(
    grid: np.ndarray,
    occupied: np.ndarray,
    regular_squares: list[tuple[int, int]],
    distractor_sq: tuple[int, int] | None,
) -> list[tuple[int, int, int, int]] | None:
    """Place all squares, requiring any distractor to sit below the others."""
    placed = []

    random.shuffle(regular_squares)
    for side, color in regular_squares:
        if not _place_square(grid, occupied, placed, side, color):
            return None

    if distractor_sq is None:
        return placed

    d_side, d_color = distractor_sq
    current_max_bottom = max(r + side - 1 for r, _, side, _ in placed) if placed else -1
    min_r = max(0, current_max_bottom - d_side + 2)
    valid = [
        (r, c)
        for r, c in _free_positions(occupied, d_side, min_r=min_r)
        if r + d_side - 1 > current_max_bottom
    ]
    if not _place_square(grid, occupied, placed, d_side, d_color, valid):
        return None
    return placed


def _add_noise(grid: np.ndarray, bg: int, noise_color: int) -> bool:
    """Scatter noise onto background cells only."""
    free_cells = list(zip(*np.where(grid == bg)))
    num_noise = random.randint(*NOISE_COUNT_RANGE)
    if len(free_cells) < num_noise:
        return False
    random.shuffle(free_cells)
    for r, c in free_cells[:num_noise]:
        grid[r, c] = noise_color
    return True


def _would_trigger_unintended_distractor(placed: list[tuple[int, int, int, int]]) -> bool:
    """Detect no-distractor samples where the solver would drop a small square."""
    lowest_row = max(r + side - 1 for r, _, side, _ in placed)
    return any(side == SIDES[0] and r + side - 1 == lowest_row for r, _, side, _ in placed)


def _render_expected_output(
    bg: int, counts: dict[int, int], square_colors: dict[int, int]
) -> np.ndarray:
    """Render the count-derived oracle output used to validate samples."""
    out_h = SIDES[-1] + 1
    groups = []
    for rank in range(max(counts.values())):
        present_sides = [side for side in SIDES if counts[side] > rank]
        group = np.full((out_h, max(present_sides)), bg, dtype=int)
        for side in sorted(present_sides, reverse=True):
            group[:side, :side] = square_colors[side]
        groups.append(group)

    out_w = sum(group.shape[1] + 1 for group in groups)
    out = np.full((out_h, out_w), bg, dtype=int)
    c = 0
    for group in groups:
        w = group.shape[1]
        out[:, c:c + w] = group
        c += w + 1
    return out


def _gen_attempt() -> np.ndarray | None:
    bg, square_colors, noise_color = _choose_palette()
    counts = {side: random.randint(*COUNT_RANGE) for side in SIDES}
    has_distractor = random.random() < DISTRACTOR_PROB
    regular_squares, distractor_sq = _make_square_queue(counts, square_colors, has_distractor)

    H = random.randint(*GRID_SIZE_RANGE)
    W = random.randint(*GRID_SIZE_RANGE)
    grid = np.full((H, W), bg, dtype=int)
    occupied = np.zeros((H, W), dtype=bool)

    placed = _place_squares(grid, occupied, regular_squares, distractor_sq)
    if placed is None or not _add_noise(grid, bg, noise_color):
        return None

    if not has_distractor and _would_trigger_unintended_distractor(placed):
        return None

    expected_out = _render_expected_output(bg, counts, square_colors)

    try:
        actual_out = main(grid)
    except Exception:
        return None

    if not np.array_equal(actual_out, expected_out):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {MAX_GENERATION_ATTEMPTS} attempts")
import numpy as np

from arc_utils import bbox_coords, colors_present, find_components, get_bg
import random


def _rotated_bar_coords(coords: np.ndarray) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox_coords(coords)
    height = r1 - r0 + 1
    width = c1 - c0 + 1
    area = int(coords.shape[0])

    assert height == 1 or width == 1
    length = max(height, width)
    assert area == length
    assert length % 2 == 1

    cr = (r0 + r1) // 2
    cc = (c0 + c1) // 2
    half = length // 2

    if length == 1:
        return [(cr, cc)]
    if height == 1:
        return [(r, cc) for r in range(cr - half, cr + half + 1)]
    return [(cr, c) for c in range(cc - half, cc + half + 1)]


def main(grid: np.ndarray) -> np.ndarray:
    """Rotate every foreground bar 90 degrees around its own center on the same canvas.

    Input structure
    The background is the dominant color, and all foreground pixels share one color.
    Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical
    bar with odd length, with single-pixel bars allowed.

    Rule
    Clear the canvas to the background, then redraw every bar with its midpoint, length,
    and color preserved while swapping horizontal and vertical orientation.

    Key insight
    The bars are independent objects: their centers and lengths identify the output
    placement, so no matching, ordering, or global symmetry is needed.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1

    out = np.full_like(g, bg)
    h, w = g.shape
    components = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=fg_colors,
    )
    assert components

    for comp in components:
        color = int(comp["color"])
        for r, c in _rotated_bar_coords(comp["coords"]):
            assert 0 <= r < h and 0 <= c < w
            assert out[r, c] == bg
            out[r, c] = color

    return out

# --------------- generator (c) ---------------

# Palette and canvas options.
BG_COLOR = 7
FG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)
GRID_SIDES = (9, 11, 13)

# Bar counts and weighted odd-length sampling.
MIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5
MAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}
LENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}
DEFAULT_LENGTH_WEIGHT = 1
ORIENTATIONS = ("H", "V")

# Retry and placement search limits.
OUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50
CENTER_TRIAL_LIMIT = 80

def _sample_lengths(N, K):
    possible_lengths = list(range(1, N + 1, 2))
    weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]
    lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)
    lengths.sort(reverse=True)
    return lengths

def _bar_pixels(cr, cc, length, orient):
    half = length // 2
    if orient == "H":
        return {(cr, cc + d) for d in range(-half, half + 1)}
    return {(cr + d, cc) for d in range(-half, half + 1)}

def _place_one_bar(N, length, occupied):
    """Return input pixels for one placed bar, mutating occupied on success."""
    half = length // 2
    lo, hi = half, N - 1 - half
    if lo > hi:
        return None
    orient = random.choice(ORIENTATIONS)
    out_orient = "V" if orient == "H" else "H"
    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]
    random.shuffle(candidates)

    for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:
        inp_pixels = _bar_pixels(cr, cc, length, orient)
        out_pixels = _bar_pixels(cr, cc, length, out_orient)
        footprint = inp_pixels | out_pixels
        if footprint & occupied:
            continue
        occupied |= footprint
        return inp_pixels
    return None

def _place_bars(N, K):
    occupied = set()
    bars_input = []
    for length in _sample_lengths(N, K):
        if len(bars_input) >= K:
            break
        inp_pixels = _place_one_bar(N, length, occupied)
        if inp_pixels is not None:
            bars_input.append(inp_pixels)
    return bars_input if len(bars_input) >= K else None

def _gen_attempt(N: int, K: int) -> np.ndarray | None:
    fg = random.choice(FG_COLORS)
    bars_input = _place_bars(N, K)
    if bars_input is None:
        return None

    grid = np.full((N, N), BG_COLOR, dtype=int)
    for bar_pixels in bars_input:
        for r, c in bar_pixels:
            grid[r, c] = fg

    try:
        main(grid)
    except Exception:
        return None
    return grid

