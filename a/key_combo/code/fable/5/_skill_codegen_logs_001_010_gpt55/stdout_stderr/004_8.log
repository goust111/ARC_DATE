+        seen[sr, sc] = True
+        queue = deque([(sr, sc)])
+        points: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            points.append((r, c))
+            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
