+def _bbox(points: np.ndarray) -> tuple[int, int, int, int]:
+    """Inclusive (r0, c0, r1, c1) bbox, following arc_utils.bbox_coords."""
+    lo = points.min(axis=0)
+    hi = points.max(axis=0)
+    return int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])
+
