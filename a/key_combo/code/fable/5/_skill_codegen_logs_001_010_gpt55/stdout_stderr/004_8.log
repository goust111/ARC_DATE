) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:
    """Place fragments and reserve one empty anchor target with two-cell gaps."""
    canvas_h, canvas_w = canvas_shape
    height, width = stamp_shape
    anchor_r, anchor_c = anchor
