+    assert int(ways[target]) == 1, "shortest route must be unique"
+
+    path = [target]
+    cur = target
+    while cur != start:
+        r, c = cur
+        preds = [
+            (r + dr, c + dc)
+            for dr, dc in DIR4
+            if _in_bounds((h, w), r + dr, c + dc)
+            and bool(passable[r + dr, c + dc])
+            and int(dist[r + dr, c + dc]) == int(dist[r, c]) - 1
