            (r, c)
            for r, c in cup["interior"]
            if int(g[r, c]) == int(content)
        }
        assert content_cells, "each cup must contain ammunition pixels"
        cup["content"] = int(content)
        cup["content_cells"] = content_cells
        cup["ammo"] = len(content_cells)

    return cups


