+    wall = _infer_roles(g)[1]
+    marker = _infer_roles(g)[2]
+    fixed = (g == wall) | (g == marker)
+    if not np.array_equal(g[fixed], out[fixed]):
+        return False
+    for r, c in door_cells:
+        if int(out[r, c]) != int(g[r, c]):
+            return False
+    return bool(np.any(out != g))
