+
+
+Coord = tuple[int, int]
+Door = tuple[str, int]
+
+BG = 0
+CYCLE = (2, 4, 3, 1)  # red -> yellow -> green -> blue -> red
+NON_CYCLE = (5, 6, 7, 8, 9)
+DIR4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATION_ATTEMPTS = 300
+
