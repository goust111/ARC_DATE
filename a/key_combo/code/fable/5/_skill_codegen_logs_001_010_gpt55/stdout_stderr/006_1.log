+    # cross twice, never at a corner; the overlap remains visually sparse.
+    borders = [_border(box) for box in boxes]
+    for i in range(n):
+        for j in range(i + 1, n):
+            overlap = borders[i] & borders[j]
+            if len(overlap) != 2:
+                return None
+            corners_i = {
