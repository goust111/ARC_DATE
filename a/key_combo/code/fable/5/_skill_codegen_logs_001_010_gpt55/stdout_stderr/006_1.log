+def _render_solution(
+    shape: tuple[int, int], bg: int, objects: list[dict], order: list[int]
+) -> np.ndarray:
+    h, w = map(int, shape)
+    by_color = {int(obj["color"]): obj for obj in objects}
+    out = np.full((h, w), int(bg), dtype=int)
