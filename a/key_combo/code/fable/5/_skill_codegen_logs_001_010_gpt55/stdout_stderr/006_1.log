+        for r, c in obj["border"]:
+            if (r, c) == obj["gap"]:
+                continue
+            rr, cc = int(r + sr), int(c + sc)
+            assert 0 <= rr < h and 0 <= cc < w, "translated ring must remain in the canvas"
+            out[rr, cc] = color
+    return out
+
