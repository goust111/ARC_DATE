+    forced_direction: tuple[int, int] | None = None,
+) -> np.ndarray:
+    """Independent generator renderer indexed by object ids rather than colors."""
+    out = np.full(shape, int(bg), dtype=int)
+    for obj_id in reversed(order):
+        spec = specs[obj_id]
