+_DIRS: dict[str, tuple[int, int]] = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _border(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, box)
+    return {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+
+
+def _side_midpoints(box: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, box)
+    assert (r1 - r0) % 2 == 0 and (c1 - c0) % 2 == 0, (
+        "ring height and width must be odd so a side-centered gap has a cardinal direction"
+    )
+    rm, cm = (r0 + r1) // 2, (c0 + c1) // 2
+    return {
+        "up": (r0, cm),
+        "down": (r1, cm),
+        "left": (rm, c0),
+        "right": (rm, c1),
+    }
+
+
+def _gap_direction(
+    box: tuple[int, int, int, int], gap: tuple[int, int]
+) -> tuple[int, int]:
+    matches = [name for name, cell in _side_midpoints(box).items() if cell == gap]
+    assert len(matches) == 1, "the unique gap must be centered on exactly one side"
+    return _DIRS[matches[0]]
+
+
+def _analyze(grid: np.ndarray) -> tuple[int, list[dict], list[int]]:
+    """Recover rings and the unique top-to-bottom order from visible ownership."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a nonempty 2-D grid"
+    bg = _background(g)
+    colors = [int(c) for c in np.unique(g) if int(c) != bg]
+    assert 2 <= len(colors) <= 9, "expected several differently colored rings"
+
+    objects: list[dict] = []
+    by_color: dict[int, dict] = {}
+    for color in colors:
+        coords = np.argwhere(g == color)
+        assert coords.size, "every ring color must be visible"
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        box = (int(r0), int(c0), int(r1), int(c1))
+        assert r1 - r0 >= 4 and c1 - c0 >= 4, "rings must have nontrivial interiors"
+        border = _border(box)
+        visible = {tuple(map(int, p)) for p in coords}
+        assert visible <= border, "all pixels of a ring color must lie on its recovered border"
+
+        # The generator keeps all four corners visible.  Besides making the
+        # visible bbox the true bbox, this explicitly rules out a smaller or
+        # shifted rectangle explanation.
+        corners = {(int(r0), int(c0)), (int(r0), int(c1)), (int(r1), int(c0)), (int(r1), int(c1))}
+        assert all(int(g[p]) == color for p in corners), "all four ring corners must identify its bbox"
+
+        bg_cells = [p for p in border if int(g[p]) == bg]
+        assert len(bg_cells) == 1, "each recovered border must have exactly one unoccluded gap"
+        gap = bg_cells[0]
+        direction = _gap_direction(box, gap)
+        obj = {
