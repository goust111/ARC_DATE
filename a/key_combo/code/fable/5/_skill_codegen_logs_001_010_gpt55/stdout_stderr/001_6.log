+    return True
+
+
+def _scan_band(
+    mismatch: np.ndarray,
+    wallpaper_mask: np.ndarray,
+    slider_box: BBox,
+    direction: Coord,
+) -> tuple[int, BBox, BBox] | None:
+    h, w = mismatch.shape
+    r0, c0, r1, c1 = slider_box
