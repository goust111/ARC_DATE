+
+
+def _dest_bbox(slider_box: BBox, direction: Coord, length: int) -> BBox:
+    r0, c0, r1, c1 = slider_box
+    dr, dc = direction
+    return (
+        int(r0 + dr * length),
+        int(c0 + dc * length),
+        int(r1 + dr * length),
+        int(c1 + dc * length),
+    )
