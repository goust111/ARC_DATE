+
+def _far_seam_is_normal(
+    mismatch: np.ndarray,
+    wallpaper_mask: np.ndarray,
+    slider_box: BBox,
+    direction: Coord,
+    length: int,
+) -> bool:
+    h, w = mismatch.shape
+    r0, c0, r1, c1 = slider_box
+    dr, dc = direction
+    if (dr, dc) == (-1, 0):
+        rr = r0 - length - 1
+        if rr < 0:
+            return False
+        seam_mismatch = mismatch[rr, c0 : c1 + 1]
+        seam_wall = wallpaper_mask[rr, c0 : c1 + 1]
+    elif (dr, dc) == (1, 0):
+        rr = r1 + length + 1
+        if rr >= h:
+            return False
+        seam_mismatch = mismatch[rr, c0 : c1 + 1]
+        seam_wall = wallpaper_mask[rr, c0 : c1 + 1]
+    elif (dr, dc) == (0, -1):
+        cc = c0 - length - 1
+        if cc < 0:
+            return False
+        seam_mismatch = mismatch[r0 : r1 + 1, cc]
+        seam_wall = wallpaper_mask[r0 : r1 + 1, cc]
+    else:
+        cc = c1 + length + 1
+        if cc >= w:
