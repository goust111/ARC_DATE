+        rr = r0 - 1
+        while rr >= 0 and np.all(mismatch[rr, c0 : c1 + 1]):
+            length += 1
+            rr -= 1
+    elif (dr, dc) == (1, 0):
+        rr = r1 + 1
+        while rr < h and np.all(mismatch[rr, c0 : c1 + 1]):
+            length += 1
+            rr += 1
+    elif (dr, dc) == (0, -1):
+        cc = c0 - 1
+        while cc >= 0 and np.all(mismatch[r0 : r1 + 1, cc]):
+            length += 1
+            cc -= 1
+    else:
+        cc = c1 + 1
+        while cc < w and np.all(mismatch[r0 : r1 + 1, cc]):
+            length += 1
+            cc += 1
+
