+
+def _connected_cells(h: int, w: int, count: int) -> set[tuple[int, int]]:
+    start = (random.randrange(h), random.randrange(w))
+    cells = {start}
+    while len(cells) < count:
+        frontier: list[tuple[int, int]] = []
