+def _transform_template(template: np.ndarray, flip_ud: bool, flip_lr: bool) -> np.ndarray:
+    tile = template.copy()
+    if bool(flip_ud):
+        tile = np.flipud(tile)
+    if bool(flip_lr):
+        tile = np.fliplr(tile)
+    return tile.copy()
