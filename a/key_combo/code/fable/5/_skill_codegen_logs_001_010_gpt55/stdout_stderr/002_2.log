+
+def _stamp_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_h: int, tile_w: int) -> None:
+    r0, c0 = _tile_origin(pos[0], pos[1], tile_h, tile_w)
+    grid[r0 : r0 + tile_h, c0 : c0 + tile_w] = tile
