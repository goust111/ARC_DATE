+
+        patch = _transform_template(template, flip_ud=(hr == H - 1), flip_lr=(vc == W - 1))
+        rs, cs = _tile_slice(row_spans[tile_r], col_spans[tile_c])
+        assert np.all(g[rs, cs] == int(bg)), "target tiles must be background in the input"
+        out[rs, cs] = patch
+
+    return out
+
