+
+COLORS = tuple(range(10))
+TILE_ROWS_CHOICES = (3, 4)
+TILE_COLS_CHOICES = (3, 4)
+TILE_H_RANGE = (4, 6)
+TILE_W_RANGE = (4, 6)
+PAIR_COUNT_RANGE = (4, 5)
+GEN_ATTEMPTS = 500
+
+ORIENTATIONS = (
+    ("top_left", False, False),
+    ("bottom_left", True, False),
+    ("top_right", False, True),
+    ("bottom_right", True, True),
+)
