+
+def _tile_origin(tile_r: int, tile_c: int, tile_h: int, tile_w: int) -> tuple[int, int]:
+    return 1 + int(tile_r) * (int(tile_h) + 1), 1 + int(tile_c) * (int(tile_w) + 1)
