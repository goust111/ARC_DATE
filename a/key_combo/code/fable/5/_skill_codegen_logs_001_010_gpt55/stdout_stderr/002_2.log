+def _gen_attempt() -> np.ndarray | None:
+    tile_rows = random.choice(TILE_ROWS_CHOICES)
+    tile_cols = random.choice(TILE_COLS_CHOICES)
+    tile_h = random.randint(*TILE_H_RANGE)
