+        _simulate_alternative(grid, {MIRROR, GLASS}),       # treat glass as mirror
+        _simulate_alternative(grid, set(), stop_at_optics=True),
+        _simulate_alternative(grid, {MIRROR}, forced_mirror_orientation="\\"),
