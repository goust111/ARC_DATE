GRID_COLS = (16, 30)
PALETTE = tuple(range(10))
FOREGROUND_COLOR_COUNT = (1, 3)
RECT_SIZE = (2, 11)
MARKER_COUNT = (1, 3)
MARKER_DISTANCE = (3, 10)
SAME_SIDE_MARKER_GAP = 3
