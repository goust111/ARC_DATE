from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
import random


def _dominant_foreground_color(g: np.ndarray, bg: int) -> int:
    vals, counts = np.unique(g[g != int(bg)], return_counts=True)
    assert vals.size > 0, "expected foreground pixels"
    max_count = int(counts.max())
    winners = vals[counts == max_count]
    assert winners.size == 1, "expected one largest foreground color for lattice frames"
    return int(winners[0])


def _parse_frames(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[list[int], list[int]]]:
    frames: list[tuple[list[int], list[int]]] = []
    components = find_components(
        g,
        bg=int(bg),
        colors=[int(frame_color)],
        connectivity=4,
        monochromatic=True,
    )
    assert components, "expected at least one lattice frame"

    for comp in components:
        r0, c0, r1, c1 = comp["bbox"]
        sub = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(frame_color)

        row_idx = [r for r in range(sub.shape[0]) if bool(sub[r, :].all())]
        col_idx = [c for c in range(sub.shape[1]) if bool(sub[:, c].all())]
        assert len(row_idx) >= 2 and len(col_idx) >= 2, "frame must divide slots"
        assert row_idx[0] == 0 and row_idx[-1] == sub.shape[0] - 1
        assert col_idx[0] == 0 and col_idx[-1] == sub.shape[1] - 1
        assert all(a + 1 < b for a, b in zip(row_idx, row_idx[1:]))
        assert all(a + 1 < b for a, b in zip(col_idx, col_idx[1:]))

        expected = np.zeros_like(sub, dtype=bool)
        expected[row_idx, :] = True
        expected[:, col_idx] = True
        assert np.array_equal(sub, expected), "frame must be a complete rectangular lattice"

        rows = [int(r0) + r for r in row_idx]
        cols = [int(c0) + c for c in col_idx]
        frames.append((rows, cols))

    slot_rows = len(frames[0][0]) - 1
    slot_cols = len(frames[0][1]) - 1
    for rows, cols in frames:
        assert len(rows) - 1 == slot_rows
        assert len(cols) - 1 == slot_cols
    return frames


def _infer_slot_colors(
    g: np.ndarray,
    bg: int,
    frame_color: int,
    frames: list[tuple[list[int], list[int]]],
) -> dict[tuple[int, int], int]:
    slot_rows = len(frames[0][0]) - 1
    slot_cols = len(frames[0][1]) - 1
    colors: dict[tuple[int, int], int] = {}

    for rows, cols in frames:
        for sr in range(slot_rows):
            for sc in range(slot_cols):
                region = g[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]]
                marker = region[(region != int(bg)) & (region != int(frame_color))]
                if marker.size == 0:
                    continue
                vals = np.unique(marker)
                assert vals.size == 1, "each colored slot must contain one color"
                color = int(vals[0])
                key = (sr, sc)
                assert key not in colors or colors[key] == color
                colors[key] = color

    expected = {(sr, sc) for sr in range(slot_rows) for sc in range(slot_cols)}
    assert set(colors) == expected, "colored slots must identify every logical slot"
    return colors


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill every lattice slot from the color assigned to that slot position by the other lattices.

    Input structure:
    - The background is the dominant color.
    - The largest foreground color forms several one-pixel-thick rectangular lattice frames.
    - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.

    Rule:
    - Infer a color for each logical slot position from the colored slots across all lattice frames.
    - Repaint every slot interior in every lattice with the inferred color for its row/column position.
    - Keep the frame lines and all background outside frames unchanged.

    Key insight:
    - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    frame_color = _dominant_foreground_color(g, bg)
    frames = _parse_frames(g, bg, frame_color)
    slot_colors = _infer_slot_colors(g, bg, frame_color, frames)

    out = g.copy()
    for rows, cols in frames:
        for sr in range(len(rows) - 1):
            for sc in range(len(cols) - 1):
                out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[
                    (sr, sc)
                ]
    return out

# --------------- generator (o5x) ---------------

# Grid and palette choices.
BG = 0
GRID_SIZE_RANGE = (22, 28)
NEAR_SQUARE_PROB = 0.65
NEAR_SQUARE_DELTAS = [-2, -1, 0, 1, 2]
FOREGROUND_COLORS = range(1, 10)
PALETTE_SIZE = 5

# Lattice geometry.
SLOT_SIZE_RANGE = (1, 8)
FRAME_HEIGHT_RANGE = (5, 18)
FRAME_WIDTH_RANGE = (5, 14)
LATTICE_LINE_COUNT = 3
SLOT_POSITIONS = [(0, 0), (0, 1), (1, 0), (1, 1)]

# Frame count and area allocation.
FRAME_COUNT_RANGE = (4, 6)
MIN_FRAME_AREA = 25
AREA_BUDGET_RANGE = (0.55, 0.88)
AREA_WEIGHT_SCALE = 35.0

# Placement and retry limits.
EDGE_BORDER = 1
PLACEMENT_PADDING = 1
PLACEMENT_CONNECTIVITY = 8
MAX_GENERATION_ATTEMPTS = 300

FrameSpec = tuple[tuple[int, int], tuple[int, int]]
PlacedFrame = tuple[int, int, tuple[int, int], tuple[int, int]]
SlotColors = dict[tuple[int, int], int]


def _line_indices(lengths: tuple[int, int]) -> list[int]:
    return [0, int(lengths[0]) + 1, int(lengths[0]) + int(lengths[1]) + 2]


def _slot_options() -> dict[tuple[int, int], list[FrameSpec]]:
    options: dict[tuple[int, int], list[FrameSpec]] = {}
    slot_min, slot_max = SLOT_SIZE_RANGE
    height_min, height_max = FRAME_HEIGHT_RANGE
    width_min, width_max = FRAME_WIDTH_RANGE
    for h0 in range(slot_min, slot_max + 1):
        for h1 in range(slot_min, slot_max + 1):
            height = h0 + h1 + LATTICE_LINE_COUNT
            if not height_min <= height <= height_max:
                continue
            for w0 in range(slot_min, slot_max + 1):
                for w1 in range(slot_min, slot_max + 1):
                    width = w0 + w1 + LATTICE_LINE_COUNT
                    if not width_min <= width <= width_max:
                        continue
                    options.setdefault((height, width), []).append(((h0, h1), (w0, w1)))
    return options


_SIZE_OPTIONS = _slot_options()


def _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:
    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]
    random.shuffle(keys)

    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)
    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))
    chosen_sizes: list[tuple[int, int]] = []
    remaining = budget

    for i in range(n_frames):
        slots_left = n_frames - i - 1
        candidates = [
            size
            for size in keys
            if size not in chosen_sizes
            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA
        ]
        if not candidates:
            return None
        weights = []
        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))
        for height, width in candidates:
            area = height * width
            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))
        size = random.choices(candidates, weights=weights, k=1)[0]
        chosen_sizes.append(size)
        remaining -= size[0] * size[1]

    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]
    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)
    return specs


def _choose_canvas_shape() -> tuple[int, int]:
    grid_min, grid_max = GRID_SIZE_RANGE
    rows = random.randint(grid_min, grid_max)
    cols = random.randint(grid_min, grid_max)
    if random.random() < NEAR_SQUARE_PROB:
        delta = random.choice(NEAR_SQUARE_DELTAS)
        cols = min(grid_max, max(grid_min, rows + delta))
    return rows, cols


def _choose_palette() -> tuple[int, SlotColors]:
    colors = random.sample(FOREGROUND_COLORS, PALETTE_SIZE)
    frame_color = colors[0]
    color_values = colors[1:]
    random.shuffle(color_values)
    slot_colors = {pos: color_values[i] for i, pos in enumerate(SLOT_POSITIONS)}
    return frame_color, slot_colors


def _make_output_patch(heights: tuple[int, int], widths: tuple[int, int], frame_color: int, slot_colors: SlotColors) -> tuple[np.ndarray, list[int], list[int]]:
    row_lines = _line_indices(heights)
    col_lines = _line_indices(widths)
    patch = np.zeros((row_lines[-1] + 1, col_lines[-1] + 1), dtype=int)
    patch[row_lines, :] = int(frame_color)
    patch[:, col_lines] = int(frame_color)

    for sr, sc in SLOT_POSITIONS:
        patch[row_lines[sr] + 1 : row_lines[sr + 1], col_lines[sc] + 1 : col_lines[sc + 1]] = slot_colors[(sr, sc)]
    return patch, row_lines, col_lines


def _hint_providers(n_frames: int) -> dict[tuple[int, int], int]:
    providers = [random.randrange(n_frames) for _ in SLOT_POSITIONS]
    if len(set(providers)) == 1:
        providers[random.randrange(len(providers))] = random.choice(
            [idx for idx in range(n_frames) if idx != providers[0]]
        )
    return {pos: providers[i] for i, pos in enumerate(SLOT_POSITIONS)}


def _place_frames(rows: int, cols: int, specs: list[FrameSpec]) -> list[PlacedFrame] | None:
    occ = np.zeros((rows, cols), dtype=int)
    placed: list[PlacedFrame] = []
    for heights, widths in specs:
        height = sum(heights) + LATTICE_LINE_COUNT
        width = sum(widths) + LATTICE_LINE_COUNT
        block = np.ones((height, width), dtype=int)
        try:
            r0, c0 = random_free_location(occ, block, transparent=BG, border=EDGE_BORDER, padding=PLACEMENT_PADDING, padding_connectivity=PLACEMENT_CONNECTIVITY)
        except ValueError:
            return None
        paste(occ, block, r0, c0)
        placed.append((r0, c0, heights, widths))
    return placed


def _gen_attempt() -> np.ndarray | None:
    rows, cols = _choose_canvas_shape()
    n_frames = random.randint(*FRAME_COUNT_RANGE)
    frame_color, slot_colors = _choose_palette()

    specs = _choose_frame_specs(n_frames, rows, cols)
    if specs is None:
        return None

    placed = _place_frames(rows, cols, specs)
    if placed is None:
        return None

    out = np.full((rows, cols), BG, dtype=int)
    line_data: list[tuple[int, int, list[int], list[int]]] = []
    for r0, c0, heights, widths in placed:
        patch, row_lines, col_lines = _make_output_patch(heights, widths, frame_color, slot_colors)
        paste(out, patch, r0, c0)
        line_data.append((r0, c0, row_lines, col_lines))

    inp = out.copy()
    providers = _hint_providers(n_frames)
    for frame_idx, (r0, c0, row_lines, col_lines) in enumerate(line_data):
        for sr, sc in SLOT_POSITIONS:
            if providers[(sr, sc)] == frame_idx:
                continue
            rr0 = r0 + row_lines[sr] + 1
            rr1 = r0 + row_lines[sr + 1]
            cc0 = c0 + col_lines[sc] + 1
            cc1 = c0 + col_lines[sc + 1]
            inp[rr0:rr1, cc0:cc1] = BG

    try:
        if int(get_bg(inp)) != BG:
            return None
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 2e65ae53 input")
from __future__ import annotations

import numpy as np

from arc_utils import components_mask, get_bg
import random


def _color_counts(g: np.ndarray) -> dict[int, int]:
    vals, counts = np.unique(g, return_counts=True)
    return {int(v): int(n) for v, n in zip(vals, counts)}


def _roles(g: np.ndarray) -> tuple[int, int, int, int]:
    bg = get_bg(g)
    counts = _color_counts(g)
    colors = [c for c in counts if c != bg]
    assert len(colors) == 3, "expected wall, door, and marker colors"

    marker_colors = [c for c in colors if counts[c] == 2]
    assert len(marker_colors) == 1, "expected exactly two marker pixels"
    path_color = marker_colors[0]

    remaining = [c for c in colors if c != path_color]
    areas = {c: counts[c] for c in remaining}
    door_area = min(areas.values())
    wall_area = max(areas.values())
    door_colors = [c for c in remaining if counts[c] == door_area]
    wall_colors = [c for c in remaining if counts[c] == wall_area]
    assert len(door_colors) == 1 and len(wall_colors) == 1
    assert door_area < wall_area, "door color must be the smaller non-marker object set"
    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])


def _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:
    comps = components_mask(g == int(door_color), connectivity=4)
    assert comps, "expected door segments"

    orientations: list[str] = []
    centers: list[tuple[int, int]] = []
    for coords in comps:
        assert coords.shape[0] == 3, "each door segment is three pixels long"
        r0, c0 = coords.min(axis=0)
        r1, c1 = coords.max(axis=0)
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        if height == 3 and width == 1:
            orientations.append("vertical")
            centers.append((int(r0 + 1), int(c0)))
        elif height == 1 and width == 3:
            orientations.append("horizontal")
            centers.append((int(r0), int(c0 + 1)))
        else:
            raise AssertionError("door segments must be straight length-3 bars")

    assert len(set(orientations)) == 1, "all doors must share an orientation"
    return orientations[0], centers


def _paint_segment(
    out: np.ndarray,
    start: tuple[int, int],
    end: tuple[int, int],
    color: int,
    allowed: set[int],
) -> None:
    r0, c0 = map(int, start)
    r1, c1 = map(int, end)
    assert r0 == r1 or c0 == c1, "path segments must be orthogonal"
    height, width = out.shape
    assert 0 <= r0 < height and 0 <= r1 < height
    assert 0 <= c0 < width and 0 <= c1 < width

    if r0 == r1:
        for c in range(min(c0, c1), max(c0, c1) + 1):
            assert int(out[r0, c]) in allowed, "path may only cover bg, doors, or markers"
            out[r0, c] = int(color)
    else:
        for r in range(min(r0, r1), max(r0, r1) + 1):
            assert int(out[r, c0]) in allowed, "path may only cover bg, doors, or markers"
            out[r, c0] = int(color)


def _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:
    coords = np.argwhere(g == int(path_color))
    assert coords.shape[0] == 2, "expected two marker pixels"
    return [tuple(map(int, coord)) for coord in coords]


def _solve_vertical_walls(
    g: np.ndarray,
    centers: list[tuple[int, int]],
    markers: list[tuple[int, int]],
    bg: int,
    path_color: int,
    door_color: int,
    wall_color: int,
) -> np.ndarray:
    out = g.copy()
    centers = sorted(centers, key=lambda p: p[1])
    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))
    assert len(wall_cols) == len(centers), "each vertical wall must have one door"
    assert [c for _r, c in centers] == wall_cols
    for _r, c in centers:
        assert np.all(np.isin(g[:, c], [wall_color, door_color]))

    start, end = sorted(markers, key=lambda p: p[1])
    assert start[1] < centers[0][1] and end[1] > centers[-1][1]

    allowed = {int(bg), int(path_color), int(door_color)}
    cur = start
    for door_r, door_c in centers:
        approach = (cur[0], door_c - 1)
        _paint_segment(out, cur, approach, path_color, allowed)
        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)
        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)
        cur = (door_r, door_c)

    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)
    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)
    return out


def _solve_horizontal_walls(
    g: np.ndarray,
    centers: list[tuple[int, int]],
    markers: list[tuple[int, int]],
    bg: int,
    path_color: int,
    door_color: int,
    wall_color: int,
) -> np.ndarray:
    out = g.copy()
    centers = sorted(centers, key=lambda p: p[0])
    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))
    assert len(wall_rows) == len(centers), "each horizontal wall must have one door"
    assert [r for r, _c in centers] == wall_rows
    for r, _c in centers:
        assert np.all(np.isin(g[r, :], [wall_color, door_color]))

    start, end = sorted(markers, key=lambda p: p[0])
    assert start[0] < centers[0][0] and end[0] > centers[-1][0]

    allowed = {int(bg), int(path_color), int(door_color)}
    cur = start
    for door_r, door_c in centers:
        approach = (door_r - 1, cur[1])
        _paint_segment(out, cur, approach, path_color, allowed)
        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)
        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)
        cur = (door_r, door_c)

    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)
    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw the marker-colored route through the centers of all doors in the parallel wall maze.

    Input structure:
    - The grid has a background, parallel full-span walls, one three-pixel door
      segment in each wall, and two marker pixels sharing a color.
    - Walls are either all vertical or all horizontal, and the markers are on
      opposite outer sides of the wall set.

    Rule:
    - Keep the scene unchanged except for the route.
    - Visit the door centers in wall order from the upper/left marker side to
      the lower/right marker side.
    - In each corridor, draw an orthogonal path to the cell just before the next
      wall, move along that wall to the door center, cross the center, and
      continue to the next corridor; after the last door, connect to the other
      marker.

    Key insight:
    - The three-pixel door segments mark the only crossing points through a set
      of parallel walls, so the output is the corridor path threaded through
      those centers.
    """
    g = np.asarray(grid, dtype=int)
    bg, path_color, door_color, wall_color = _roles(g)
    orientation, centers = _door_centers(g, door_color)
    markers = _markers(g, path_color)

    if orientation == "vertical":
        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)
    assert orientation == "horizontal"
    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)

# --------------- generator (att1) ---------------

# Canvas and color role sampling.
GRID_H = 30
GRID_W = 30
COLOR_POOL = range(10)
N_ROLE_COLORS = 4

# Parallel wall and door geometry.
ORIENTATIONS = ("vertical", "horizontal")
WALL_COUNT_RANGE = (3, 4)
WALL_POS_LO = 4
WALL_POS_HI_MARGIN = 5
WALL_MIN_GAP = 2
DOOR_CENTER_LO = 3
DOOR_CENTER_HI_MARGIN = 4

# Marker placement and retry budget.
MARKER_EDGE_RANGE = (1, 3)
MARKER_FREE_LO = 1
MARKER_FREE_HI_MARGIN = 2
GEN_RETRIES = 300


def _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:
    """Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions."""
    needed = n + (n - 1) * min_gap
    span = hi - lo + 1
    if span < needed:
        return None
    compressed_span = span - (n - 1) * min_gap
    picks = sorted(rng.sample(range(compressed_span), n))
    return [lo + picks[i] + i * min_gap for i in range(n)]


def _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):
    """Return wall positions and per-wall door centers for the chosen orientation."""
    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == "vertical" else (GRID_H, GRID_W)
    walls = _place_positions(
        n_walls,
        lo=WALL_POS_LO,
        hi=wall_axis - WALL_POS_HI_MARGIN,
        min_gap=WALL_MIN_GAP,
        rng=rng,
    )
    if walls is None:
        return None
    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]
    return walls, doors


def _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:
    """Sample start/end markers on opposite outer corridors."""
    edge_lo, edge_hi = MARKER_EDGE_RANGE
    if orientation == "vertical":
        start_col = rng.randint(edge_lo, edge_hi)
        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)
        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
    else:
        start_row = rng.randint(edge_lo, edge_hi)
        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)
        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
    return (start_row, start_col), (end_row, end_col)


def _render_grid(
    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end
) -> np.ndarray:
    """Render walls, doors, and the two markers into a fresh input grid."""
    grid = np.full((GRID_H, GRID_W), bg, dtype=int)
    if orientation == "vertical":
        for wall_col, door_row in zip(walls, doors):
            grid[:, wall_col] = wall_color
            grid[door_row - 1 : door_row + 2, wall_col] = door_color
    else:
        for wall_row, door_col in zip(walls, doors):
            grid[wall_row, :] = wall_color
            grid[wall_row, door_col - 1 : door_col + 2] = door_color

    grid[start] = marker_color
    grid[end] = marker_color
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = random.Random()
    bg, wall_color, door_color, marker_color = rng.sample(COLOR_POOL, N_ROLE_COLORS)
    orientation = rng.choice(ORIENTATIONS)
    n_walls = rng.randint(*WALL_COUNT_RANGE)

    layout = _sample_wall_layout(orientation, n_walls, rng)
    if layout is None:
        return None
    walls, doors = layout
    start, end = _sample_markers(orientation, rng)
    grid = _render_grid(orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end)

    try:
        main(grid)
    except Exception:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location
import random


def _tight_mask(mask: np.ndarray) -> np.ndarray:
    coords = np.argwhere(mask)
    assert coords.size, "expected a nonempty mask"
    r0, c0, r1, c1 = bbox_coords(coords)
    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)


def _mask_key(mask: np.ndarray) -> tuple[str, ...]:
    return tuple("".join("1" if cell else "0" for cell in row) for row in mask)


def _shape_signature(mask: np.ndarray) -> tuple[str, ...]:
    base = _tight_mask(mask)
    variants = []
    for k in range(4):
        rotated = np.rot90(base, k)
        variants.append(_mask_key(_tight_mask(rotated)))
        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))
    return min(variants)


def _legend_order(g: np.ndarray, bg: int) -> list[int]:
    labels: list[tuple[int, int]] = []
    W = g.shape[1]
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):
        if int(comp["area"]) != 1:
            continue
        r, c = map(int, comp["coords"][0])
        if c == W - 1:
            labels.append((r, int(comp["color"])))

    labels.sort()
    assert labels, "expected a right-edge color legend"
    assert [r for r, _color in labels] == list(range(len(labels))), "legend must start at the top edge"

    order = [color for _r, color in labels]
    assert len(order) == len(set(order)), "legend colors must be unique"
    assert set(order) == set(colors_present(g, exclude={bg})), "legend must list every foreground color"
    return order


def _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:
    comps = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        min_area=1,
    )
    main = [comp for comp in comps if int(comp["area"]) > 1]
    label = [
        comp
        for comp in comps
        if int(comp["area"]) == 1 and int(comp["coords"][0][1]) == g.shape[1] - 1
    ]
    assert len(main) == 1, "expected exactly one main object for each legend color"
    assert len(label) == 1, "expected exactly one right-edge singleton label for each legend color"
    assert len(comps) == 2, "each legend color should appear only as one object and one label"

    r0, c0, r1, c1 = main[0]["bbox"]
    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Build a color-labeled shape-equivalence table from the objects listed on the right edge.

    Input structure:
    - The background contains one main 4-connected object for each foreground color.
    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.
    - Those singleton pixels define the row and column order of the output table.

    Rule:
    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.
    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.
    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.
    - Leave diagonal cells and all separators as background.

    Key insight:
    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    order = _legend_order(g, bg)
    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}

    n = len(order)
    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)

    for i, color in enumerate(order):
        band = 3 + 3 * i
        out[0:2, band : band + 2] = int(color)
        out[band : band + 2, 0:2] = int(color)

    for i, row_color in enumerate(order):
        for j, col_color in enumerate(order):
            if i == j:
                continue
            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY
            r = 3 + 3 * i
            c = 3 + 3 * j
            out[r : r + 2, c : c + 2] = int(cell_color)

    return out

# --------------- generator (att2) ---------------

# Canvas and object bounds.
GEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)
GEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4
# Shape-class sampling.
GEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80
GEN_DIHEDRAL_FLIP_PROB = 0.5
# Output table layout and colors.
GEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3
GEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)
# Input placement and retry limits.
GEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300
GEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4
GEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_tight_mask(mask: np.ndarray) -> np.ndarray:
    coords = np.argwhere(mask)
    r0, c0, r1, c1 = bbox_coords(coords)
    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)


def _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:
    return tuple("".join("1" if cell else "0" for cell in row) for row in mask)


def _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:
    base = _gen_tight_mask(mask)
    variants = []
    for k in range(4):
        rotated = np.rot90(base, k)
        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))
        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))
    return min(variants)


def _has_hole(mask: np.ndarray) -> bool:
    bg = ~mask.astype(bool)
    if not bool(bg.any()):
        return False

    H, W = bg.shape
    seen = np.zeros_like(bg, dtype=bool)
    stack: list[tuple[int, int]] = []
    for r in range(H):
        for c in (0, W - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))
    for c in range(W):
        for r in (0, H - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))

    while stack:
        r, c = stack.pop()
        for dr, dc in GEN_NEIGHBORS_4:
            nr, nc = r + dr, c + dc
            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True
                stack.append((nr, nc))
    return bool((bg & ~seen).any())


def _random_corner_path(h: int, w: int) -> np.ndarray:
    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
    sr, sc = random.choice(starts)
    er, ec = h - 1 - sr, w - 1 - sc
    moves = [(1 if er > sr else -1, 0)] * (h - 1)
    moves += [(0, 1 if ec > sc else -1)] * (w - 1)
    random.shuffle(moves)

    mask = np.zeros((h, w), dtype=bool)
    r, c = sr, sc
    mask[r, c] = True
    for dr, dc in moves:
        r += dr
        c += dc
        mask[r, c] = True
    return mask


def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
    h, w = mask.shape
    choices = []
    for r in range(h):
        for c in range(w):
            if mask[r, c]:
                continue
            touches = sum(
                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]
                for dr, dc in GEN_NEIGHBORS_4
            )
            if touches != 1:
                continue
            trial = mask.copy()
            trial[r, c] = True
            if not _has_hole(trial):
                choices.append((r, c))
    return choices


def _random_mask() -> np.ndarray | None:
    area = random.randint(*GEN_OBJECT_AREA_RANGE)
    pairs = [
        (h, w)
        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)
        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)
        if h + w - 1 <= area <= h * w
        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS
    ]
    h, w = random.choice(pairs)
    mask = _random_corner_path(h, w)

    while int(mask.sum()) < area:
        choices = _growth_candidates(mask)
        if not choices:
            return None
        r, c = random.choice(choices)
        mask[r, c] = True
    return mask


def _class_sizes(n: int) -> list[int]:
    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])
    sizes = [1] * k
    for _ in range(n - k):
        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]
        sizes[random.choice(open_slots)] += 1
    random.shuffle(sizes)
    return sizes


def _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:
    canonical_masks: list[np.ndarray] = []
    signatures: set[tuple[str, ...]] = set()
    for _ in range(class_count):
        for _ in range(GEN_UNIQUE_MASK_RETRIES):
            mask = _random_mask()
            if mask is None:
                continue
            sig = _gen_shape_signature(mask)
            if sig in signatures:
                continue
            signatures.add(sig)
            canonical_masks.append(mask)
            break
        else:
            return None
    return canonical_masks


def _dihedral(mask: np.ndarray) -> np.ndarray:
    out = np.rot90(mask, random.randrange(4))
    if random.random() < GEN_DIHEDRAL_FLIP_PROB:
        out = np.fliplr(out)
    return out.astype(bool).copy()


def _build_output(colors: list[int], class_ids: list[int]) -> np.ndarray:
    n = len(colors)
    out_size = GEN_TABLE_STEP * n + GEN_TABLE_BLOCK
    out = np.zeros((out_size, out_size), dtype=int)
    for i, color in enumerate(colors):
        band = GEN_TABLE_STEP + GEN_TABLE_STEP * i
        out[0:GEN_TABLE_BLOCK, band : band + GEN_TABLE_BLOCK] = color
        out[band : band + GEN_TABLE_BLOCK, 0:GEN_TABLE_BLOCK] = color

    for i in range(n):
        for j in range(n):
            if i == j:
                continue
            r = GEN_TABLE_STEP + GEN_TABLE_STEP * i
            c = GEN_TABLE_STEP + GEN_TABLE_STEP * j
            cell_color = GEN_SAME_SHAPE_COLOR if class_ids[i] == class_ids[j] else GEN_DIFFERENT_SHAPE_COLOR
            out[r : r + GEN_TABLE_BLOCK, c : c + GEN_TABLE_BLOCK] = cell_color
    return out


def _sample_design() -> tuple[list[int], list[np.ndarray], np.ndarray] | None:
    n = random.randint(*GEN_OBJECT_COUNT_RANGE)
    colors = random.sample(GEN_OBJECT_COLORS, n)
    sizes = _class_sizes(n)
    class_ids = [class_i for class_i, size in enumerate(sizes) for _ in range(size)]
    random.shuffle(class_ids)
    canonical_masks = _unique_canonical_masks(len(sizes))
    if canonical_masks is None:
        return None
    oriented_masks = [_dihedral(canonical_masks[class_i]) for class_i in class_ids]
    expected = _build_output(colors, class_ids)
    return colors, oriented_masks, expected

def _build_input_grid(colors: list[int], oriented_masks: list[np.ndarray]) -> np.ndarray | None:
    n = len(colors)
    H = random.randint(*GEN_GRID_ROW_RANGE)
    W = random.randint(*GEN_GRID_COL_RANGE)
    grid = np.zeros((H, W), dtype=int)
    place_canvas = grid[:, : W - GEN_RESERVED_RIGHT_COLS]

    place_order = list(range(n))
    random.shuffle(place_order)
    for i in place_order:
        patch = np.zeros(oriented_masks[i].shape, dtype=int)
        patch[oriented_masks[i]] = colors[i]
        try:
            r, c = random_free_location(
                place_canvas,
                patch,
                transparent=0,
                border=GEN_PLACEMENT_BORDER,
                padding=GEN_PLACEMENT_PADDING,
                padding_connectivity=GEN_PLACEMENT_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(place_canvas, patch, r, c, transparent=0)

    for r, color in enumerate(colors):
        grid[r, -1] = color
    return grid


def _gen_attempt() -> np.ndarray | None:
    design = _sample_design()
    if design is None:
        return None
    colors, oriented_masks, expected = design
    grid = _build_input_grid(colors, oriented_masks)
    if grid is None:
        return None
    try:
        actual = main(grid)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 6165ea8f input")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, get_bg
import random


def _separator_columns(g: np.ndarray, bg: int) -> list[int]:
    H, W = g.shape
    candidates: list[list[int]] = []
    for color in colors_present(g, exclude={bg}):
        mask = g == int(color)
        full_cols = [c for c in range(W) if bool(np.all(mask[:, c]))]
        if len(full_cols) != 2:
            continue
        if int(mask.sum()) != int(H * len(full_cols)):
            continue
        s0, s1 = full_cols
        if s0 > 0 and s1 > s0 + 1 and s1 < W - 1:
            panel_w = s0
            if s1 - s0 - 1 == panel_w and W - s1 - 1 == panel_w:
                candidates.append(full_cols)

    assert len(candidates) == 1
    return candidates[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Pack the non-background rows from three separated panels into one panel, scanning panels right-to-left.

    Input structure:
    - A rectangular grid contains three equal-size panels separated by two full-height divider columns.
    - The background is the dominant color; divider pixels use a color that appears only in the divider columns.

    Rule:
    - Read panels from right to left, and within each panel read rows from top to bottom.
    - Keep each row that contains any non-background pixel, discarding all-background rows.
    - Place the kept rows at the bottom of a single panel-shaped output, padding above with background rows.

    Key insight:
    - The task is row packing: the divider columns mark independent panels, and only the occupied rows are moved.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    s0, s1 = _separator_columns(g, bg)
    panel_w = int(s0)
    assert H == panel_w

    panels = [
        g[:, :s0],
        g[:, s0 + 1 : s1],
        g[:, s1 + 1 :],
    ]
    rows: list[np.ndarray] = []
    for panel in reversed(panels):
        assert panel.shape == (H, panel_w)
        for r in range(H):
            row = panel[r, :]
            if bool(np.any(row != bg)):
                rows.append(row.copy())

    assert 0 < len(rows) <= H
    for i in range(len(rows) - 1):
        cols_a = set(int(c) for c in range(panel_w) if int(rows[i][c]) != bg)
        cols_b = set(int(c) for c in range(panel_w) if int(rows[i + 1][c]) != bg)
        assert cols_a & cols_b, "consecutive non-bg rows must share at least one column"
    out = np.full((H, panel_w), bg, dtype=int)
    out[H - len(rows) :, :] = np.asarray(rows, dtype=int)
    return out

# --------------- generator (o5x) ---------------

# Canvas and fixed palette observed in the task.
PANEL_SIZE_RANGE = (4, 6)
BG_COLOR, SEPARATOR_COLOR = 7, 6
CONTENT_COLORS = (1, 5)
# Packed output rows and per-panel block heights.
PACKED_ROW_RANGE = (3, 5)
GROUP_ROW_RANGE = (1, 3)
# Row intervals and hollow 3-row block variants.
ROW_WIDTH_RANGE = (1, 5)
HOLLOW_HEIGHT = 3
HOLLOW_WIDTH_RANGE = (3, 5)
HOLLOW_PROBABILITY = 0.35
# Rejection-sampling retry limit.
GENERATION_RETRIES = 300


def _partition_rows(total: int) -> tuple[int, int, int]:
    min_rows, max_rows = GROUP_ROW_RANGE
    choices = [
        (right, middle, left)
        for right in range(min_rows, max_rows + 1)
        for middle in range(min_rows, max_rows + 1)
        for left in range(min_rows, max_rows + 1)
        if right + middle + left == total
    ]
    return random.choice(choices)


def _interval(width: int, must_include: int | None = None) -> tuple[int, int]:
    min_len, max_config_len = ROW_WIDTH_RANGE
    max_len = min(max_config_len, width)
    length = random.randint(min_len, max_len)
    if must_include is None:
        start = random.randint(0, width - length)
    else:
        lo = max(0, must_include - length + 1)
        hi = min(must_include, width - length)
        start = random.randint(lo, hi)
    return start, start + length - 1


def _solid_block(height: int, width: int, bg: int, color: int) -> np.ndarray:
    block = np.full((height, width), bg, dtype=int)
    left, right = _interval(width)
    block[0, left : right + 1] = color
    for r in range(1, height):
        overlap_col = random.randint(left, right)
        left, right = _interval(width, overlap_col)
        block[r, left : right + 1] = color
    return block


def _hollow_block(width: int, bg: int, color: int) -> np.ndarray:
    block = np.full((HOLLOW_HEIGHT, width), bg, dtype=int)
    min_width, max_width = HOLLOW_WIDTH_RANGE
    shape_w = random.randint(min_width, min(max_width, width))
    left = random.randint(0, width - shape_w)
    right = left + shape_w - 1
    block[0, left : right + 1] = color
    block[1, left] = color
    block[1, right] = color
    block[2, left : right + 1] = color
    return block


def _connected_block(height: int, width: int, bg: int, color: int) -> np.ndarray:
    if height == HOLLOW_HEIGHT and width >= HOLLOW_WIDTH_RANGE[0] and random.random() < HOLLOW_PROBABILITY:
        return _hollow_block(width, bg, color)
    return _solid_block(height, width, bg, color)


def _place_block(block: np.ndarray, panel_size: int, bg: int) -> np.ndarray:
    panel = np.full((panel_size, panel_size), bg, dtype=int)
    offset = random.randint(0, panel_size - block.shape[0])
    panel[offset : offset + block.shape[0], :] = block
    return panel


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(*PANEL_SIZE_RANGE)
    bg = BG_COLOR
    sep = SEPARATOR_COLOR
