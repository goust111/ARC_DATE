+    vertical_margin = grid_h - sum(row_heights) - _GAP * (n_rows - 1)
+    horizontal_margin = grid_w - sum(col_widths) - _GAP * (n_cols - 1)
+    top = random.randint(1, vertical_margin - 1)
+    left = random.randint(1, horizontal_margin - 1)
