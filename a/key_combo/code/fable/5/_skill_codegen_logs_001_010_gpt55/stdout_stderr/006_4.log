+                    if not (0 <= nr < height and 0 <= nc < width):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            components.append(np.asarray(coords, dtype=int))
+    return components
