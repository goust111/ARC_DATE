import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Cycle each solid odd-sided square to the next smaller centered square, wrapping a single pixel to a 9x9 square.

    Input structure:
    - The grid has one dominant background color.
    - Every foreground object is a separated 4-connected monochrome solid square.
    - Square side lengths are odd and belong to the cycle 1, 3, 5, 7, 9.

    Rule:
    - Clear the canvas to the background.
    - Keep each square's color and center.
    - Replace side length n by n - 2 when n > 1; replace side length 1 by side length 9.

    Key insight:
    - The visible operation is on square size, not color: side lengths cycle 1 -> 9 -> 7 -> 5 -> 3 -> 1.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert components, "expected at least one foreground square"

    out = np.full_like(g, bg)
    painted = np.zeros(g.shape, dtype=bool)
    H, W = g.shape

    for obj in components:
        color = int(obj["color"])
        r0, c0, r1, c1 = obj["bbox"]
        side = int(r1 - r0 + 1)
        assert side == int(c1 - c0 + 1), "foreground object must have a square bbox"
        assert side in {1, 3, 5, 7, 9}, "square side length must be in the odd-size cycle"
        assert int(obj["area"]) == side * side, "foreground object must fill its bbox"
        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "foreground object must be solid"

        new_side = 9 if side == 1 else side - 2
        center_r = int((r0 + r1) // 2)
        center_c = int((c0 + c1) // 2)
        nr0 = center_r - new_side // 2
        nc0 = center_c - new_side // 2
        nr1 = nr0 + new_side
        nc1 = nc0 + new_side
        assert 0 <= nr0 < nr1 <= H and 0 <= nc0 < nc1 <= W, "transformed square must fit in the grid"

        region = (slice(nr0, nr1), slice(nc0, nc1))
        assert not painted[region].any(), "transformed squares must not overlap"
        out[region] = color
        painted[region] = True

    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and palette.
GRID_SIZE = 16
BACKGROUND_COLOR = 7
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
INPUT_SIDE_FROM_OUTPUT = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
# Object and side sampling.
SQUARE_COUNT_RANGE = (3, 5)
BASE_OUTPUT_SIDE_CHOICES = [1, 3, 5]
OUTPUT_SIDE_7_PROB = 0.45
OUTPUT_SIDE_9_PROB = 0.35
# Placement and retry policy.
OUTPUT_CLEARANCE_GAP = 1
INPUT_CLEARANCE_GAP = 0
MAX_GENERATION_ATTEMPTS = 300


def _bbox(center_r, center_c, side):
    d = side // 2
    return center_r - d, center_c - d, center_r + d, center_c + d


def _separated(a, b, gap=0):
    return (
        a[2] + gap + 1 <= b[0]
        or b[2] + gap + 1 <= a[0]
        or a[3] + gap + 1 <= b[1]
        or b[3] + gap + 1 <= a[1]
    )


def _clear(rect, rects, gap=0):
    return all(_separated(rect, other, gap) for other in rects)


def _draw_square(grid, color, box):
    r0, c0, r1, c1 = box
    shape = (r1 - r0 + 1, c1 - c0 + 1)
    paste(grid, np.full(shape, int(color), dtype=int), r0, c0)


def _choose_output_sides(count):
    sides = [random.choice(BASE_OUTPUT_SIDE_CHOICES) for _ in range(count)]
    slots = list(range(count))
    random.shuffle(slots)

    if random.random() < OUTPUT_SIDE_7_PROB:
        sides[slots.pop()] = 7
    if slots and random.random() < OUTPUT_SIDE_9_PROB:
        sides[slots.pop()] = 9

    random.shuffle(sides)
    return sides


def _sample_objects():
    """Sample color and side specs, returning larger required footprints first."""
    count = random.randint(*SQUARE_COUNT_RANGE)
    colors = random.sample(FOREGROUND_COLORS, count)
    out_sides = _choose_output_sides(count)
    in_sides = [INPUT_SIDE_FROM_OUTPUT[s] for s in out_sides]

    # Keep the configured background as the solver's dominant color.
    areas = [s * s for s in in_sides]
    if GRID_SIZE * GRID_SIZE - sum(areas) <= max(areas):
        return None

    objects = [
        {"color": color, "out_side": out_side, "in_side": in_side}
        for color, out_side, in_side in zip(colors, out_sides, in_sides)
    ]
    random.shuffle(objects)
    objects.sort(key=lambda obj: (max(obj["out_side"], obj["in_side"]), obj["out_side"]), reverse=True)
    return objects


def _place_objects(objects):
    """Place each object at a center valid for both input and output squares."""
    placed = []
    output_boxes = []
    input_boxes = []

    for obj in objects:
        out_side = obj["out_side"]
        in_side = obj["in_side"]
        margin = max(out_side // 2, in_side // 2)
        rows = range(margin, GRID_SIZE - margin)
        centers = [(r, c) for r in rows for c in rows]
        random.shuffle(centers)

        for r, c in centers:
            out_box = _bbox(r, c, out_side)
            in_box = _bbox(r, c, in_side)
            if _clear(out_box, output_boxes, OUTPUT_CLEARANCE_GAP) and _clear(in_box, input_boxes, INPUT_CLEARANCE_GAP):
                placed.append((obj["color"], out_box, in_box))
                output_boxes.append(out_box)
                input_boxes.append(in_box)
                break
        else:
            return None
    return placed


def _render_grid(placed, box_index):
    """Render one phase from placed tuples: 1 for output boxes, 2 for input boxes."""
    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
    for item in placed:
        _draw_square(grid, item[0], item[box_index])
    return grid


def _gen_attempt():
    objects = _sample_objects()
    if objects is None:
        return None

    placed = _place_objects(objects)
    if placed is None:
        return None

    out = _render_grid(placed, 1)
    inp = _render_grid(placed, 2)
    return inp if np.array_equal(main(inp), out) else None


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 522fdd07 input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


_LOCAL_TO_CORNER = {
    frozenset({(0, 0), (0, 1), (1, 0)}): "top_left",
    frozenset({(0, 0), (0, 1), (1, 1)}): "top_right",
    frozenset({(0, 0), (1, 0), (1, 1)}): "bottom_left",
    frozenset({(0, 1), (1, 0), (1, 1)}): "bottom_right",
}


def main(grid: np.ndarray) -> np.ndarray:
    """Expand each 3-pixel L marker into a same-color corner L on an empty background.

    Input structure
    - The grid is an odd square with one dominant background color.
    - Every foreground object is a monochromatic 4-connected 3-pixel L inside a
      2x2 box.

    Rule
    - Clear the grid to the background.
    - For each marker, map its L orientation to the corresponding outer corner
      and draw that corner L in the marker color with arm length half the grid.

    Key insight
    - The small marker is a miniature corner; its orientation, not its position,
      chooses which outer corner receives the expanded L.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h == w and h % 2 == 1

    bg = get_bg(g)
    out = np.full_like(g, bg)
    arm = h // 2

    seen_corners: set[str] = set()
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert components

    for comp in components:
        assert comp["area"] == 3
        r0, c0, r1, c1 = comp["bbox"]
        assert (r1 - r0, c1 - c0) == (1, 1)

        local = frozenset(
            (int(r) - r0, int(c) - c0) for r, c in comp["coords"]
        )
        assert local in _LOCAL_TO_CORNER
        corner = _LOCAL_TO_CORNER[local]
        assert corner not in seen_corners
        seen_corners.add(corner)

        color = int(comp["color"])
        if corner == "top_left":
            out[0, :arm] = color
            out[:arm, 0] = color
        elif corner == "top_right":
            out[0, w - arm :] = color
            out[:arm, w - 1] = color
        elif corner == "bottom_left":
            out[h - arm :, 0] = color
            out[h - 1, :arm] = color
        else:
            assert corner == "bottom_right"
            out[h - arm :, w - 1] = color
            out[h - 1, w - arm :] = color

    assert seen_corners == set(_LOCAL_TO_CORNER.values())
    return out

# --------------- generator (att2) ---------------
# Canvas and palette.
_GEN_BG_COLOR = 8
_GEN_GRID_SIZES = [5, 7, 9, 11, 13, 15]
_GEN_COLOR_VALUES = range(10)
# Corner order and marker geometry.
_GEN_CORNERS = ["top_left", "top_right", "bottom_left", "bottom_right"]
_GEN_MARKERS = {
    "top_left": ((0, 0), (0, 1), (1, 0)),
    "top_right": ((0, 0), (0, 1), (1, 1)),
    "bottom_left": ((0, 0), (1, 0), (1, 1)),
    "bottom_right": ((0, 1), (1, 0), (1, 1)),
}
_GEN_MARKER_SHAPE = (2, 2)
# Color reuse and retry policy.
_GEN_ALL_DISTINCT_COLOR_PROB = 0.5
_GEN_DISTINCT_CORNER_COUNT = 4
_GEN_REUSED_COLOR_BASE_COUNT = 3
_GEN_MAX_ATTEMPTS = 300


def _gen_marker(color: int, bg: int, corner: str) -> np.ndarray:
    marker = np.full(_GEN_MARKER_SHAPE, int(bg), dtype=int)
    for r, c in _GEN_MARKERS[corner]:
        marker[r, c] = int(color)
    return marker


def _gen_output(n: int, bg: int, colors_by_corner: dict[str, int]) -> np.ndarray:
    out = np.full((n, n), int(bg), dtype=int)
    arm = n // 2
    out[0, :arm] = colors_by_corner["top_left"]
    out[:arm, 0] = colors_by_corner["top_left"]
    out[0, n - arm :] = colors_by_corner["top_right"]
    out[:arm, n - 1] = colors_by_corner["top_right"]
    out[n - arm :, 0] = colors_by_corner["bottom_left"]
    out[n - 1, :arm] = colors_by_corner["bottom_left"]
    out[n - arm :, n - 1] = colors_by_corner["bottom_right"]
    out[n - 1, n - arm :] = colors_by_corner["bottom_right"]
    return out


def _gen_same_color_touch(
    canvas: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int, color: int
) -> bool:
    h, w = canvas.shape
    for pr, pc in np.argwhere(patch_mask):
        r = int(r0 + pr)
        c = int(c0 + pc)
        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= nr < h and 0 <= nc < w and int(canvas[nr, nc]) == int(color):
                return True
    return False


def _gen_valid_locations(canvas: np.ndarray, patch: np.ndarray, bg: int) -> list[tuple[int, int]]:
    h, w = canvas.shape
    ph, pw = patch.shape
    patch_mask = patch != int(bg)
    color = int(patch[patch_mask][0])
    locs: list[tuple[int, int]] = []

    for r0 in range(h - ph + 1):
        for c0 in range(w - pw + 1):
            region = canvas[r0 : r0 + ph, c0 : c0 + pw]
            if bool((region != int(bg))[patch_mask].any()):
                continue
            if _gen_same_color_touch(canvas, patch_mask, r0, c0, color):
                continue
            locs.append((r0, c0))
    return locs


def _gen_corner_colors(bg: int) -> dict[str, int]:
    palette = [c for c in _GEN_COLOR_VALUES if c != int(bg)]

    if random.random() < _GEN_ALL_DISTINCT_COLOR_PROB:
        colors = random.sample(palette, _GEN_DISTINCT_CORNER_COUNT)
    else:
        base = random.sample(palette, _GEN_REUSED_COLOR_BASE_COUNT)
        repeated = random.choice(base)
        colors = base + [repeated]
        random.shuffle(colors)
    return dict(zip(_GEN_CORNERS, colors))


def _gen_place_markers(
    inp: np.ndarray, colors_by_corner: dict[str, int], bg: int
) -> bool:
    corners = list(_GEN_CORNERS)
    random.shuffle(corners)
    for corner in corners:
        marker = _gen_marker(colors_by_corner[corner], bg, corner)
        locs = _gen_valid_locations(inp, marker, bg)
        if not locs:
            return False
        r0, c0 = random.choice(locs)
        paste(inp, marker, r0, c0, transparent=bg)
    return True


def _gen_attempt() -> np.ndarray | None:
    n = random.choice(_GEN_GRID_SIZES)
    bg = _GEN_BG_COLOR
    colors_by_corner = _gen_corner_colors(bg)
    expected = _gen_output(n, bg, colors_by_corner)

    inp = np.full((n, n), bg, dtype=int)
    if not _gen_place_markers(inp, colors_by_corner, bg):
        return None

    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("generate_input failed to construct a valid b745798f grid")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location, random_sprite
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.

    Input structure:
    - A grid has one dominant background color and several monochromatic 4-connected foreground objects.
    - Each foreground object spans at least two columns in its bounding box.

    Rule:
    - Find each same-color 4-connected foreground object.
    - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.
    - Leave all other pixels unchanged.

    Key insight:
    - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert components, "expected at least one foreground object"

    out = g.copy()
    for component in components:
        coords = component["coords"]
        _r0, c0, _r1, c1 = map(int, component["bbox"])
        assert c1 - c0 + 1 >= 2, "each object must span at least two columns"

        erase = coords[coords[:, 1] < c0 + 2]
        out[erase[:, 0], erase[:, 1]] = bg

    return out

# --------------- generator (att1, Claude) ---------------
# Canvas constraints.
BG = 8
GRID_SIZE_RANGE = (8, 11)
MIN_BACKGROUND_FRACTION = 0.50
# Object sampling constraints.
OBJECT_COUNT = 4
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]
SPRITE_WIDTH_RANGE = (2, 6)
SPRITE_HEIGHT_RANGE = (2, 5)
SPRITE_PIXEL_RANGE = (4, 14)
SPRITE_RETRIES = 30
SPRITE_CONNECTIVITY = 4
SPRITE_SYMMETRY = "not_symmetric"
# Placement and global retry policy.
PLACEMENT_PADDING = 1
PLACEMENT_CONNECTIVITY = 8
GENERATION_RETRIES = 300

def _sample_sprite(color: int) -> np.ndarray | None:
    """Return one connected sprite that lands inside the configured pixel-count range."""
    bw = random.randint(*SPRITE_WIDTH_RANGE)
    bh = random.randint(*SPRITE_HEIGHT_RANGE)
    max_px = bw * bh
    min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)
    max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)
    if min_px > max_target_px:
        return None
    target_px = random.randint(min_px, max_target_px)
    density = target_px / max_px
    for _ in range(SPRITE_RETRIES):
        try:
            sprite = random_sprite(bh, bw, density=density, color_palette=[color],
                                   connectivity=SPRITE_CONNECTIVITY, background=BG,
                                   symmetry=SPRITE_SYMMETRY)
        except Exception:
            continue
        px = int(np.sum(sprite != BG))
        if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:
            return sprite
    return None

def _place_sprite(grid: np.ndarray, sprite: np.ndarray) -> bool:
    """Paste sprite with the required Chebyshev gap; return False if no slot exists."""
    try:
        r, c = random_free_location(grid, sprite, transparent=BG,
                                    padding=PLACEMENT_PADDING,
                                    padding_connectivity=PLACEMENT_CONNECTIVITY)
    except ValueError:
        return False
    paste(grid, sprite, r, c, transparent=BG)
    return True

def _solver_accepts(grid: np.ndarray) -> bool:
    """Return whether the solver accepts the sampled task instance."""
    try:
        out = main(grid)
    except Exception:
        return False
    return out is not None

def _gen_attempt() -> np.ndarray | None:
    H = random.randint(*GRID_SIZE_RANGE)
    W = random.randint(*GRID_SIZE_RANGE)
    grid = np.full((H, W), BG, dtype=int)
    for color in random.sample(FOREGROUND_COLORS, OBJECT_COUNT):
        sprite = _sample_sprite(color)
        if sprite is None or not _place_sprite(grid, sprite):
            return None
    if np.sum(grid == BG) / grid.size < MIN_BACKGROUND_FRACTION:
        return None
    return grid if _solver_accepts(grid) else None

def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {GENERATION_RETRIES} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
from functools import lru_cache
import random


def _border(shape: tuple[int, int]) -> frozenset[tuple[int, int]]:
    h, w = shape
    return frozenset(
        (r, c)
        for r in range(h)
        for c in range(w)
        if r == 0 or r == h - 1 or c == 0 or c == w - 1
    )


def _candidate_outputs(
    bg: int, objects: list[dict], total_area: int
) -> list[np.ndarray]:
    outputs: list[tuple[int, np.ndarray]] = []

    for h in range(2, total_area + 1):
        for w in range(2, total_area + 1):
            if 2 * h + 2 * w - 4 != total_area:
                continue

            border = _border((h, w))
            placements_by_object: list[list[frozenset[tuple[int, int]]]] = []
            for obj in objects:
                placements: list[frozenset[tuple[int, int]]] = []
                for r0 in range(h - obj["h"] + 1):
                    for c0 in range(w - obj["w"] + 1):
                        cells = frozenset(
                            (r0 + r, c0 + c) for r, c in obj["rel"]
                        )
                        if cells <= border:
                            placements.append(cells)
                if not placements:
                    break
                placements_by_object.append(placements)
            else:
                order = sorted(
                    range(len(objects)),
                    key=lambda i: (
                        len(placements_by_object[i]),
                        -objects[i]["area"],
                        objects[i]["bbox"][0],
                        objects[i]["bbox"][1],
                    ),
                )
                solved: list[np.ndarray] = []

                def search(
                    k: int,
                    used: frozenset[tuple[int, int]],
                    chosen: list[tuple[int, frozenset[tuple[int, int]]]],
                ) -> None:
                    if k == len(order):
                        if used == border:
                            out = np.full((h, w), bg, dtype=int)
                            for obj_idx, cells in chosen:
                                for r, c in cells:
                                    out[r, c] = objects[obj_idx]["color"]
                            solved.append(out)
                        return

                    obj_idx = order[k]
                    for cells in placements_by_object[obj_idx]:
                        if cells & used:
                            continue
                        search(k + 1, used | cells, chosen + [(obj_idx, cells)])

                search(0, frozenset(), [])

                seen: set[tuple[int, ...]] = set()
                for out in solved:
                    key = tuple(map(int, out.ravel()))
                    if key in seen:
                        continue
                    seen.add(key)
                    outputs.append((abs(h - w), out))

    assert outputs, "the objects must assemble into at least one rectangular frame"
    best_balance = min(balance for balance, _out in outputs)
    best = [out for balance, out in outputs if balance == best_balance]
    unique = {(out.shape, tuple(map(int, out.ravel()))) for out in best}
    assert len(unique) == 1, "the most balanced frame assembly must be unique"
    return best


def main(grid: np.ndarray) -> np.ndarray:
    """Translate the colored objects into the most balanced complete rectangular frame.

    Input structure
    A grid with one dominant background color and several monochromatic
    4-connected foreground objects that are straight bars or corner-like line
    sprites.

    Rule
    Preserve every foreground object exactly, allowing translation only, and
    place the objects so they cover every pixel of a one-cell-thick rectangular
    frame exactly once; the frame interior is the background color.

    Key insight
    The output shape is not copied from the input: the foreground pixel count
    determines possible frame sizes, and the intended output is the valid frame
    assembly with the least difference between height and width.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(
        g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"
    )
    assert components, "at least one foreground object is required"

    objects: list[dict] = []
    for comp in components:
        r0, c0, r1, c1 = comp["bbox"]
        rel = tuple(
            sorted((int(r - r0), int(c - c0)) for r, c in comp["coords"])
        )
        objects.append(
            {
                "color": int(comp["color"]),
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "rel": rel,
                "h": int(r1 - r0 + 1),
                "w": int(c1 - c0 + 1),
                "area": int(comp["area"]),
            }
        )

    objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1], -obj["area"]))
    total_area = sum(obj["area"] for obj in objects)
    best = _candidate_outputs(bg, objects, total_area)
    return best[0]

# --------------- generator (att2) ---------------

# Palette and object mix.
COLOR_COUNT = 10
OBJECT_COUNT_CHOICES = (4, 5)
L_COUNTS_BY_OBJECT_COUNT = {4: (2, 3), 5: (3,)}

# Border arc and sprite shape bounds.
ARC_MIN_LEN, ARC_MAX_LEN = 1, 7
BAR_MIN_AREA, BAR_MAX_AREA = 1, 7
L_MIN_AREA, L_MAX_AREA = 3, 7
L_MIN_HEIGHT, L_MAX_HEIGHT = 2, 6
L_MIN_WIDTH, L_MAX_WIDTH = 2, 5
MIN_LENGTH_VARIETY_BY_COUNT = {4: 2, 5: 3}

# Frame, input canvas, and placement bounds.
FRAME_MIN_SIDE, FRAME_MAX_SIDE = 4, 8
FRAME_SIZE_OFFSETS = ((0, 0), (0, 1), (1, 0))
INPUT_MIN_SIDE, INPUT_MAX_SIDE, INPUT_FRAME_MARGIN = 6, 16, 2
PLACEMENT_BORDER, PLACEMENT_PADDING = 0, 0
GENERATION_ATTEMPTS = 300


def _border_coords(h: int, w: int) -> tuple[tuple[int, int], ...]:
    coords = [(0, c) for c in range(w)]
    coords += [(r, w - 1) for r in range(1, h)]
    coords += [(h - 1, c) for c in range(w - 2, -1, -1)]
    coords += [(r, 0) for r in range(h - 2, 0, -1)]
    return tuple(coords)


def _compositions(total: int, parts: int) -> list[tuple[int, ...]]:
    out: list[tuple[int, ...]] = []

    def rec(remaining: int, n: int, prefix: list[int]) -> None:
        if n == 1:
            if ARC_MIN_LEN <= remaining <= ARC_MAX_LEN:
                out.append(tuple(prefix + [remaining]))
            return
        lo = max(ARC_MIN_LEN, remaining - ARC_MAX_LEN * (n - 1))
        hi = min(ARC_MAX_LEN, remaining - ARC_MIN_LEN * (n - 1))
        for x in range(lo, hi + 1):
            rec(remaining - x, n - 1, prefix + [x])

    rec(total, parts, [])
    return out


def _coord_bounds(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
    rows, cols = zip(*coords)
    return min(rows), min(cols), max(rows), max(cols)


def _arc_kind(coords: tuple[tuple[int, int], ...]) -> str | None:
    r0, c0, r1, c1 = _coord_bounds(coords)
    h, w = r1 - r0 + 1, c1 - c0 + 1
    area = len(coords)

    if h == 1 or w == 1:
        return "bar" if BAR_MIN_AREA <= area <= BAR_MAX_AREA else None

    if not (
        L_MIN_AREA <= area <= L_MAX_AREA
        and L_MIN_HEIGHT <= h <= L_MAX_HEIGHT
        and L_MIN_WIDTH <= w <= L_MAX_WIDTH
    ):
        return None
    if area != h + w - 1:
        return None

    actual = {(r - r0, c - c0) for r, c in coords}
    for elbow_r, elbow_c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)):
        expected = {
            (r, c)
            for r in range(h)
            for c in range(w)
            if r == elbow_r or c == elbow_c
        }
        if actual == expected:
            return "L"
    return None


@lru_cache(maxsize=None)
def _valid_plans(h: int, w: int, count: int, l_count: int):
    border = _border_coords(h, w)
    perimeter = len(border)
    plans: list[tuple[tuple[tuple[int, int], ...], ...]] = []

    for start in range(perimeter):
        for lengths in _compositions(perimeter, count):
            pos = start
            arcs: list[tuple[tuple[int, int], ...]] = []
            kinds: list[str] = []
            for length in lengths:
                coords = tuple(border[(pos + i) % perimeter] for i in range(length))
                kind = _arc_kind(coords)
                if kind is None:
                    break
                arcs.append(coords)
                kinds.append(kind)
                pos = (pos + length) % perimeter
            else:
                if pos != start:
                    continue
                if kinds.count("L") != l_count or kinds.count("bar") != count - l_count:
                    continue
                if len(set(lengths)) < MIN_LENGTH_VARIETY_BY_COUNT[count]:
                    continue
                plans.append(tuple(arcs))

    return tuple(plans)


def _patch_from_arc(coords: tuple[tuple[int, int], ...], bg: int, color: int) -> np.ndarray:
    r0, c0, r1, c1 = _coord_bounds(coords)
    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
    for r, c in coords:
        patch[r - r0, c - c0] = color
    return patch


_FRAME_SIZES = tuple(
    dict.fromkeys(
        (n + dr, n + dc)
        for n in range(FRAME_MIN_SIDE, FRAME_MAX_SIDE + 1)
        for dr, dc in FRAME_SIZE_OFFSETS
        if n + dr <= FRAME_MAX_SIDE and n + dc <= FRAME_MAX_SIDE
    )
)


def _render_plan(h: int, w: int, bg: int, plans, colors: list[int]) -> tuple[np.ndarray, list[np.ndarray]]:
    arcs = list(random.choice(plans))
    random.shuffle(colors)
    out = np.full((h, w), bg, dtype=int)
    patches: list[np.ndarray] = []
    for coords, color in zip(arcs, colors):
        for r, c in coords:
            out[r, c] = color
        patches.append(_patch_from_arc(coords, bg, color))
    return out, patches


def _gen_attempt() -> np.ndarray | None:
    count = random.choice(OBJECT_COUNT_CHOICES)
    l_choices = list(L_COUNTS_BY_OBJECT_COUNT[count])
    random.shuffle(l_choices)

    sizes = list(_FRAME_SIZES)
    random.shuffle(sizes)
    bg = random.randrange(COLOR_COUNT)
    colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], count)

    for h, w in sizes:
        for l_count in l_choices:
            plans = _valid_plans(h, w, count, l_count)
            if not plans:
                continue

            out, patches = _render_plan(h, w, bg, plans, colors)
            H = random.randint(max(INPUT_MIN_SIDE, h + INPUT_FRAME_MARGIN), INPUT_MAX_SIDE)
            W = random.randint(max(INPUT_MIN_SIDE, w + INPUT_FRAME_MARGIN), INPUT_MAX_SIDE)
            inp = np.full((H, W), bg, dtype=int)
            try:
                for patch in random.sample(patches, len(patches)):
                    r, c = random_free_location(
                        inp,
                        patch,
                        transparent=bg,
                        border=PLACEMENT_BORDER,
                        padding=PLACEMENT_PADDING,
                    )
                    paste(inp, patch, r, c, transparent=bg)
            except ValueError:
                continue

            try:
                solved = main(inp)
            except Exception:
                continue
            if np.array_equal(solved, out):
                return inp

    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 83b6b474 input")

