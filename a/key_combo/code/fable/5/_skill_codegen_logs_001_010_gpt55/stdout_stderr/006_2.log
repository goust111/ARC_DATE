+        a_hidden = set(random.sample(cover_cells, random.randint(2, 4)))
+        b_hidden = set(random.sample(cover_cells, random.randint(2, 4)))
+        if a_hidden == b_hidden:
+            continue
+        a = visible.copy()
+        b = visible.copy()
+        for cell in a_hidden:
+            a[cell] = True
+        for cell in b_hidden:
