+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+RED = 2
+GREY = 5
+MASK = 8
+OBJECT_COLORS = (1, 3, 4, 6, 7, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_NEXT_OBJECT_COUNT = random.choice((4, 6))
