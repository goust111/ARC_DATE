+    - Several unequal shapes fit the visible fragment, so the table must select the donor
+      before the unique dihedral alignment can reveal which cross cells belong to the object.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _background(g)
