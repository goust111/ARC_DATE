+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if not coords.size:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1]:
+                if bool(mask[nr, nc]) and (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    stack.append((nr, nc))
