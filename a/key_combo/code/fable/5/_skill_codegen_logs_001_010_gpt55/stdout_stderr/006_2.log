+            block = g[r : r + 2, c : c + 2]
+            if i == j:
+                assert np.all(block == bg), "table diagonal must be blank"
+            else:
+                values = np.unique(block)
+                assert values.size == 1 and int(values[0]) in {RED, GREY}
