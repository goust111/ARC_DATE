+    desired: Coord, initial: Coord, body: tuple[Coord, ...], body_color: int,
+    nose_color: int, nose_cell: Coord, bg: int
+) -> bool:
+    """Check clue uniqueness, non-degeneracy, and independent semantic dependencies."""
+    try:
