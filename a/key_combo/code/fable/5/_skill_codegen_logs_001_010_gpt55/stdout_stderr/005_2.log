            horizontal = r0 <= mr <= r1 and (mc < c0 or mc > c1)
            vertical = c0 <= mc <= c1 and (mr < r0 or mr > r1)
            assert horizontal ^ vertical, (color, (mr, mc), rect["bbox"])

            if horizontal:
