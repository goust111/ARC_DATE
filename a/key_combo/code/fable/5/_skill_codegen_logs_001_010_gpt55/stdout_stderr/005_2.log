+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, semantically validated input with a unique output signature."""
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is None:
