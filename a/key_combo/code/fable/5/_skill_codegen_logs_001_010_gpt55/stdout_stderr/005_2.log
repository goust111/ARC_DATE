+    dr, dc = end[0] - start[0], end[1] - start[1]
+    if abs(dr) > abs(dc):
+        return (1 if dr > 0 else -1, 0)
+    if abs(dc) > abs(dr):
+        return (0, 1 if dc > 0 else -1)
+    return None
+
+
+def _can_extend(
+    shape: tuple[int, int], path: list[Coord], cell: Coord,
+    frame_box: BBox, frame: set[Coord]
+) -> bool:
