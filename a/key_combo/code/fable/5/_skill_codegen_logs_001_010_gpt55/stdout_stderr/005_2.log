+
+def _rotated_cells(offsets: tuple[Coord, ...], anchor: Coord, direction: Coord) -> set[Coord]:
+    result = set()
+    ar, ac = anchor
+    for offset in offsets:
+        dr, dc = _rotate_offset(offset, direction)
+        result.add((ar + dr, ac + dc))
