+    (
+        (1, 0), (2, -1), (2, 0), (2, 1),
+        (3, -2), (3, -1), (3, 0), (3, 1), (3, 2),
+        (4, -1), (4, 1),
+    ),
+    ((1, 0), (1, 1), (2, -1), (2, 0), (2, 1), (3, -1), (3, 0), (4, -1)),
+    ((1, 0), (2, 0), (2, 1), (3, -1), (3, 0), (3, 1), (4, -1), (4, 0)),
