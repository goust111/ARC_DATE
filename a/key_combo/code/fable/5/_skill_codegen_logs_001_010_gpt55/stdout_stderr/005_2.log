+    pad_top, pad_bottom, pad_left, pad_right = (random.randint(0, 1) for _ in range(4))
+    inner_h = max_r - min_r + 1 + pad_top + pad_bottom
+    inner_w = max_c - min_c + 1 + pad_left + pad_right
+    frame_h, frame_w = inner_h + 2, inner_w + 2
