+        inp, expected = result
+        signature = hashlib.md5(expected.tobytes() + str(expected.shape).encode()).hexdigest()
+        if signature in _SEEN_OUTPUTS:
+            continue
+        _SEEN_OUTPUTS.add(signature)
+        return inp
