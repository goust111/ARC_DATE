+    # A shortcut using the direction at the legend end must produce a different answer.
+    wrong_cells = _rotated_cells(((0, 0),) + body, endpoint, initial)
+    if all(0 <= r < inp.shape[0] and 0 <= c < inp.shape[1] for r, c in wrong_cells):
