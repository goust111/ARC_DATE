+
+def _background_color(grid: np.ndarray) -> int:
+    counts = Counter(map(int, grid.ravel()))
+    ordered = counts.most_common()
+    assert ordered and (len(ordered) == 1 or ordered[0][1] > ordered[1][1]), (
