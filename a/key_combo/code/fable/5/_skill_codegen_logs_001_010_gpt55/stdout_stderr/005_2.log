_ROW_MASKS = {
    "center": {3: [0, 1, 0], 4: [0, 1, 1, 0]},
    "outer":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},
    "full":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},
}


def _row_mask(kind: str, w: int) -> list[int]:
    """Return a row occupancy mask of the given kind and width."""
    return list(_ROW_MASKS[kind][w])


def _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:
    """Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1)."""
    rs, cs = np.where(arr == 1)
    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())


def _scale(arr: np.ndarray, k: int) -> np.ndarray:
    """Nearest-neighbor upscale by integer factor k."""
    if k == 1:
        return arr.copy()
    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)


def _make_labels() -> np.ndarray:
    """Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0)."""
    h, w = random.choice(PROTO_SHAPES)

    # Assign row counts per role (each role gets at least 1 row)
    counts = {1: 1, 2: 1, 3: 1}
    if h > 3:
        counts[random.choice([1, 2, 3])] += h - 3
    roles = []
    for role in random.sample([1, 2, 3], 3):
        roles.extend([role] * counts[role])

    # Pick row masks via weighted sampling
    weights_by_role = {
        1: ANCHOR_ROW_WEIGHTS,
        2: VARIABLE_ROW_WEIGHTS,
        3: VARIABLE_ROW_WEIGHTS,
    }
    masks = []
    for role in roles:
        entries = weights_by_role[role]
        kinds, wts = zip(*entries)
        chosen_kind = random.choices(kinds, weights=wts)[0]
        masks.append(_row_mask(chosen_kind, w))

    # Fix-up: ensure at least one row touches the left/right edge
    if not any(mask[0] or mask[-1] for mask in masks):
        i = random.randrange(h)
        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:
            masks[i] = _row_mask("outer", w)
        else:
            masks[i] = _row_mask("full", w)

    # Fix-up: ensure at least one row has bg holes
    if all(all(mask) for mask in masks):
        masks[random.randrange(h)] = _row_mask("center", w)

    # Assemble label grid
    labels = np.zeros((h, w), dtype=int)
    for r, (role, mask) in enumerate(zip(roles, masks)):
        for c, bit in enumerate(mask):
            if bit:
                labels[r, c] = role
    return labels


def _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:
    """Create proto_A and proto_B (flipud + recolored) from a shared label grid."""
    labels = _make_labels()
    pool = [c for c in range(10) if c not in (bg, 1)]
    a_cols = random.sample(pool, 2)
    remaining = [c for c in pool if c not in a_cols]
    if random.random() < COLOR_SHARE_PROB:
        b_cols = [random.choice(a_cols), random.choice(remaining)]
        random.shuffle(b_cols)
    else:
        b_cols = random.sample(remaining, 2)

    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:
        proto = np.full(lab.shape, bg, dtype=int)
        proto[lab == 1] = 1
        proto[lab == 2] = cols[0]
        proto[lab == 3] = cols[1]
        return proto

    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)


def _union_bbox(patch_a: np.ndarray, patch_b: np.ndarray) -> tuple[int, int, int, int]:
    """Compute (dr, dc, union_h, union_w) for anchor-aligned placement of two patches.

    dr, dc: offset from the input patch origin to the output patch origin.
    union_h, union_w: bounding box that encloses both patches when anchor-aligned.
    """
    oa = _anchor_bbox(patch_a)
    ia = _anchor_bbox(patch_b)
    dr = oa[0] - ia[0]
    dc = oa[1] - ia[1]
    h, w = patch_a.shape
    return dr, dc, h + abs(dr), w + abs(dc)


def _gen_attempt() -> np.ndarray | None:
    """Try once to build a valid grid; returns None on placement failure or oracle mismatch."""
    bg = random.choice(BG_CHOICES)
    proto_a, proto_b = _make_prototypes(bg)
    protos = [proto_a, proto_b]

    # Build instance list: 1 of each proto at scale 1, plus 1 at big scale
    count = random.choice(SPRITE_COUNTS)
    big_scale = random.choice(BIG_SCALES)
    instances = [(0, 1), (1, 1), (random.randrange(2), big_scale)]
    if count == 4:
        instances.append((random.randrange(2), 1))
    random.shuffle(instances)
    instances.sort(key=lambda item: item[1], reverse=True)  # place largest first

    max_dim = max(max(protos[typ].shape) * scale for typ, scale in instances)
    n = random.randint(max(GRID_SIZE_MIN, max_dim + GRID_MARGIN_FOR_SPRITES), GRID_SIZE_MAX)
    out = np.full((n, n), bg, dtype=int)
    inp = np.full((n, n), bg, dtype=int)
    reserve = np.full((n, n), bg, dtype=int)

    for out_type, scale in instances:
        output_patch = _scale(protos[out_type], scale)
        input_patch = _scale(protos[1 - out_type], scale)
        dr, dc, uh, uw = _union_bbox(output_patch, input_patch)
        marker = np.full((uh, uw), 1, dtype=int)
        try:
            ur, uc = random_free_location(
                reserve, marker, transparent=bg,
                border=PLACEMENT_BORDER, padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_CONNECTIVITY,
            )
        except ValueError:
            return None

        out_r = ur + max(0, -dr)
        out_c = uc + max(0, -dc)
        in_r, in_c = out_r + dr, out_c + dc

        paste(reserve, marker, ur, uc)
        paste(out, output_patch, out_r, out_c, transparent=bg)
        paste(inp, input_patch, in_r, in_c, transparent=bg)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid c7f57c3e input")
PATCH_ATTEMPTS = 80
PLACEMENT_ATTEMPTS = 30
GENERATE_ATTEMPTS = 300

def _gen_marker_cells(rect_h: int, rect_w: int, side: str, offset: int, dist: int):
    cells: set[tuple[int, int]] = set()
    if side == "top":
        marker = (-dist, offset)
        for cc in range(offset - 1, offset + 2):
            cells.add((-1, cc))
        for rr in range(-1, -dist - 2, -1):
            if rr != marker[0]:
                cells.add((rr, offset))
        cells.add((marker[0], offset - 1))
        cells.add((marker[0], offset + 1))
    elif side == "bottom":
        marker = (rect_h - 1 + dist, offset)
        for cc in range(offset - 1, offset + 2):
            cells.add((rect_h, cc))
        for rr in range(rect_h, marker[0] + 2):
            if rr != marker[0]:
                cells.add((rr, offset))
        cells.add((marker[0], offset - 1))
        cells.add((marker[0], offset + 1))
    elif side == "left":
        marker = (offset, -dist)
        for rr in range(offset - 1, offset + 2):
            cells.add((rr, -1))
        for cc in range(-1, -dist - 2, -1):
            if cc != marker[1]:
                cells.add((offset, cc))
        cells.add((offset - 1, marker[1]))
        cells.add((offset + 1, marker[1]))
    else:
        marker = (offset, rect_w - 1 + dist)
        for rr in range(offset - 1, offset + 2):
            cells.add((rr, rect_w))
        for cc in range(rect_w, marker[1] + 2):
            if cc != marker[1]:
                cells.add((offset, cc))
        cells.add((offset - 1, marker[1]))
        cells.add((offset + 1, marker[1]))
    return marker, cells


def _updated_margins(
    margins: tuple[int, int, int, int],
    side: str,
    dist: int,
) -> tuple[int, int, int, int]:
    top_extra, bottom_extra, left_extra, right_extra = margins
    if side == "top":
        top_extra = max(top_extra, dist + 1)
    elif side == "bottom":
        bottom_extra = max(bottom_extra, dist + 1)
    elif side == "left":
        left_extra = max(left_extra, dist + 1)
    else:
        right_extra = max(right_extra, dist + 1)
    return top_extra, bottom_extra, left_extra, right_extra


def _gen_marker_options(grid_h, grid_w, rect_h, rect_w, side_offsets, margins, markers, protrusions):
    options = []
    for side in SIDES:
        offsets = range(1, rect_w - 1) if side in ("top", "bottom") else range(1, rect_h - 1)
        for offset in offsets:
            if any(abs(offset - old) < SAME_SIDE_MARKER_GAP for old in side_offsets[side]):
                continue
            for dist in range(MARKER_DISTANCE[0], MARKER_DISTANCE[1] + 1):
                next_margins = _updated_margins(margins, side, dist)
                ntop, nbottom, nleft, nright = next_margins
                if ntop + rect_h + nbottom > grid_h:
                    continue
                if nleft + rect_w + nright > grid_w:
                    continue
                marker, cells = _gen_marker_cells(rect_h, rect_w, side, offset, dist)
                if marker in protrusions:
                    continue
                if any(cell in markers for cell in cells):
                    continue
                if protrusions & cells:
                    continue
                options.append((side, offset, dist, marker, cells, next_margins))
    return options


def _gen_make_patch(grid_h: int, grid_w: int, color: int, bg: int):
    for _ in range(PATCH_ATTEMPTS):
        rect_h = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_h))
        rect_w = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_w))
        if rect_h == 2 and rect_w == 2:
            continue

        marker_n = random.randint(MARKER_COUNT[0], MARKER_COUNT[1])
        side_offsets: dict[str, list[int]] = {side: [] for side in SIDES}
        margins = (0, 0, 0, 0)
        markers: list[tuple[int, int]] = []
        protrusions: set[tuple[int, int]] = set()

        for _marker_i in range(marker_n):
            options = _gen_marker_options(
                grid_h,
                grid_w,
                rect_h,
                rect_w,
                side_offsets,
                margins,
                markers,
                protrusions,
            )

            if not options:
                break
            side, offset, _dist, marker, cells, margins = random.choice(options)
            side_offsets[side].append(offset)
            markers.append(marker)
            protrusions.update(cells)
        else:
            rect_cells = {(r, c) for r in range(rect_h) for c in range(rect_w)}
            marker_cells = set(markers)
            if protrusions & rect_cells or protrusions & marker_cells:
                continue

            reserved_cells = rect_cells | marker_cells | protrusions
            rows = [r for r, _c in reserved_cells]
            cols = [c for _r, c in reserved_cells]
            min_r, max_r = min(rows), max(rows)
            min_c, max_c = min(cols), max(cols)
            patch_h = max_r - min_r + 1
            patch_w = max_c - min_c + 1
            if patch_h > grid_h or patch_w > grid_w:
                continue

            out_patch = np.full((patch_h, patch_w), bg, dtype=int)
            inp_patch = np.full((patch_h, patch_w), bg, dtype=int)
            reserve_patch = np.full((patch_h, patch_w), bg, dtype=int)
            for r, c in rect_cells | protrusions:
                out_patch[r - min_r, c - min_c] = color
            for r, c in rect_cells | marker_cells:
                inp_patch[r - min_r, c - min_c] = color
            for r, c in reserved_cells:
                reserve_patch[r - min_r, c - min_c] = color
            return out_patch, inp_patch, reserve_patch
    return None


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(GRID_ROWS[0], GRID_ROWS[1])
    w = random.randint(GRID_COLS[0], GRID_COLS[1])
    bg = random.choice(PALETTE)
    colors = random.sample(
        [c for c in PALETTE if c != bg],
        random.randint(FOREGROUND_COLOR_COUNT[0], FOREGROUND_COLOR_COUNT[1]),
    )

    out = np.full((h, w), bg, dtype=int)
    inp = np.full((h, w), bg, dtype=int)
    reserved = np.full((h, w), bg, dtype=int)

    for color in colors:
        for _ in range(PLACEMENT_ATTEMPTS):
            patches = _gen_make_patch(h, w, color, bg)
            if patches is None:
                continue
            out_patch, inp_patch, reserve_patch = patches
            try:
                r0, c0 = random_free_location(reserved, reserve_patch, transparent=bg)
            except ValueError:
                continue
            paste(out, out_patch, r0, c0, transparent=bg)
            paste(inp, inp_patch, r0, c0, transparent=bg)
            paste(reserved, reserve_patch, r0, c0, transparent=bg)
            break
        else:
            return None

    counts = np.bincount(inp.ravel(), minlength=10)
    if counts[bg] <= max(counts[c] for c in range(10) if c != bg):
        return None

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATE_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input failed after {GENERATE_ATTEMPTS} attempts")
# ---------- sprite planning & placement ----------

def _sprite_plan(legends: list[tuple[int, int]]) -> list[tuple[int, int | None]]:
    """Build a shuffled list of (hole_count, color_or_None) for all sprites to generate."""
    total = random.randint(*TOTAL_SPRITES_RANGE)
    remaining = total - len(legends)
    max_d = min(MAX_DISTRACTORS, remaining)
    valid_d = [d for d in range(1, max_d + 1)
               if remaining - d <= MAX_EXTRA_PER_LEGEND * len(legends)]
    n_distractors = random.choice(valid_d)
    extra_matches = remaining - n_distractors
    extras = [0] * len(legends)
    for _ in range(extra_matches):
        choices = [i for i, x in enumerate(extras) if x < MAX_EXTRA_PER_LEGEND]
        extras[random.choice(choices)] += 1

    plan = []
    for i, (hole_count, color) in enumerate(legends):
        for _ in range(1 + extras[i]):
            plan.append((hole_count, color))
    legend_holes = {h for h, _ in legends}
    distractor_holes = [h for h in range(MAX_HOLE_COUNT) if h not in legend_holes]
    for _ in range(n_distractors):
        plan.append((random.choice(distractor_holes), None))
    random.shuffle(plan)
    return plan


def _dilate_mask(mask: np.ndarray) -> np.ndarray:
    """8-connectivity dilation of a boolean mask (1-cell padding in all directions)."""
    return binary_dilation(mask, structure=_STRUCT8).astype(bool)


def _random_sprite_location(
    static_blocked: np.ndarray, occupied: np.ndarray, sprite: np.ndarray
) -> tuple[int, int] | None:
    """Find a random valid placement for sprite, avoiding blocked and occupied areas."""
    h, w = sprite.shape
    sprite_mask = sprite == GREY
    occupied_pad = _dilate_mask(occupied != BG)
    N = GRID_SIZE
    candidates = [(r, c) for r in range(N - h + 1) for c in range(N - w + 1)]
    random.shuffle(candidates)
    for r, c in candidates:
        rr0, cc0 = max(0, r - 1), max(0, c - 1)
        rr1, cc1 = min(N, r + h + 1), min(N, c + w + 1)
        if np.any(static_blocked[rr0:rr1, cc0:cc1] != BG):
            continue
        if np.any(occupied_pad[r : r + h, c : c + w] & sprite_mask):
            continue
        return int(r), int(c)
    return None


def _place_sprites(
    grid: np.ndarray, expected: np.ndarray, blocked: np.ndarray, legends: list[tuple[int, int]]
) -> bool:
    """Generate and place all sprites (matches + distractors) onto the grid."""
    items = []
    for hole_count, color in _sprite_plan(legends):
        sprite = _make_sprite(hole_count)
        if sprite is None:
            return False
        items.append((sprite.size, sprite, color))
    items.sort(key=lambda x: x[0], reverse=True)

    occupied = np.zeros_like(grid)
    for _, sprite, color in items:
        loc = _random_sprite_location(blocked, occupied, sprite)
        if loc is None:
            return False
        r, c = loc
        paste(grid, sprite, r, c, transparent=BG)
        paste(occupied, sprite, r, c, transparent=BG)
        if color is not None:
            out_patch = np.where(sprite == GREY, int(color), BG)
            paste(expected, out_patch, r, c, transparent=BG)
    return True


# ---------- top-level generation ----------

def _gen_attempt() -> np.ndarray | None:
    """Single attempt: build layout, place sprites, validate via oracle."""
    N = GRID_SIZE
    grid = np.zeros((N, N), dtype=int)
    expected = np.zeros((N, N), dtype=int)
    blocked = np.zeros((N, N), dtype=int)

    legends = _add_layout(grid, blocked)
    expected[:, :] = grid
    if not _place_sprites(grid, expected, blocked, legends):
        return None
    if int(np.sum(grid == BG)) <= int(np.sum(grid == GREY)):
        return None
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        try:
            grid = _gen_attempt()
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate e3721c99 input")

