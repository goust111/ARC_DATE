+def _add_mapping(mapping: dict[tuple[str, int], int], side: str, color: int, other: int) -> bool:
+    key = (side, int(color))
+    other = int(other)
+    if key in mapping and mapping[key] != other:
+        return False
+    mapping[key] = other
+    return True
+
