+        baseline_color,
+        cols,
+        heights,
+        bar_colors,
+        tooth_lengths,
+        tooth_colors,
+    )
+    if _is_semantically_strong(grid, expected, heights, bar_colors, tooth_lengths, tooth_colors):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
