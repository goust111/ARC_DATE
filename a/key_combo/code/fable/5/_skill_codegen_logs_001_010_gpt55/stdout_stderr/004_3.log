+def _bbox_outline(vertices: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    rs = [r for r, _ in vertices]
+    cs = [c for _, c in vertices]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
