    return [s for s in specs if len(_line_coords(s, (H, W))) >= MIN_LINE_LENGTH]


def _intersects(a: LineSpec, b: LineSpec, shape: tuple[int, int]) -> bool:
    return bool(set(_line_coords(a, shape)) & set(_line_coords(b, shape)))


