+    sprite_color: int,
+) -> dict[str, object] | None:
+    H, W = grid.shape
+    for _ in range(PLACE_ATTEMPTS):
+        sprite, spine = _make_sprite()
+        sh, sw = sprite.shape
+        copy_count = random.randint(3, min(5, int(np.count_nonzero(sprite & ~spine))))
+        masks = _make_damage_masks(sprite, spine, copy_count)
