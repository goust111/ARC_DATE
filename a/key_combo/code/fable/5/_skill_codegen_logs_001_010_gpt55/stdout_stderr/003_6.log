+        if not terminal_choices:
+            continue
+        term_i = random.choice(terminal_choices)
+        ordered_masks = [masks[i] for i in range(len(masks)) if i != term_i]
+        random.shuffle(ordered_masks)
+        ordered_masks.append(masks[term_i])
