+    palette = [c for c in COLORS if c != int(bg)]
+    expected = np.zeros((len(row_spans), len(col_spans)), dtype=int)
+    info: dict[tuple[int, int], dict[str, int]] = {}
+    recent_dominants: list[int] = []
