+    if not _place_anchors_and_distractors(grid, h_lines, v_lines, bg):
+        return None
+
+    if not _semantic_checks(grid, expected, bg, h_lines, v_lines, row_spans, col_spans):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
