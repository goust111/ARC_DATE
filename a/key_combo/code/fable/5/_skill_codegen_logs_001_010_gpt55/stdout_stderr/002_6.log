+def _layout_from_region_sizes(sizes: list[int]) -> tuple[int, list[tuple[int, int]], list[int]]:
+    spans: list[tuple[int, int]] = []
+    lines: list[int] = []
+    pos = 1
+    for i, size in enumerate(sizes):
+        start = pos
+        end = pos + int(size) - 1
+        spans.append((start, end))
+        pos = end + 1
+        if i + 1 < len(sizes):
+            lines.append(pos)
