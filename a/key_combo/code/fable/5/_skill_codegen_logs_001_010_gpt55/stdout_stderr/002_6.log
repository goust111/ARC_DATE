+    cells: list[tuple[int, int]] = []
+    for c in range(1, W - 1):
+        if int(grid[0, c]) == int(bg):
+            cells.append((0, c))
+        if int(grid[H - 1, c]) == int(bg):
+            cells.append((H - 1, c))
+    for r in range(1, H - 1):
+        if int(grid[r, 0]) == int(bg):
+            cells.append((r, 0))
+        if int(grid[r, W - 1]) == int(bg):
+            cells.append((r, W - 1))
+    random.shuffle(cells)
+    return cells
