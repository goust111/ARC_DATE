+def _paint_invisible_lines(
+    grid: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    h_lines: list[int],
+    v_lines: list[int],
+    region_info: dict[tuple[int, int], dict[str, int]],
+    bg: int,
+) -> None:
+    H, W = map(int, grid.shape)
+    palette = [c for c in COLORS if c != int(bg)]
