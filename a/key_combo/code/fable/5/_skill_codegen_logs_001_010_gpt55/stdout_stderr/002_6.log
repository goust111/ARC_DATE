+            if not _defines_aligned_pair(a, b, H, W):
+                grid[a] = int(color)
+                grid[b] = int(color)
+                return True
+    return False
+
+
+def _place_singletons(grid: np.ndarray, colors: list[int], bg: int, count: int) -> bool:
+    cells = _free_border_cells(grid, bg)
+    if len(cells) < count:
+        return False
+    for cell, color in zip(cells[:count], colors[:count]):
+        grid[cell] = int(color)
