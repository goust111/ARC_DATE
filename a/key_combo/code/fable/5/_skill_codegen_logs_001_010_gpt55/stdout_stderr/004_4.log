+        "idx": int(idx),
+        "side": side,
+        "start": start,
+        "color": int(color),
+        "step": step,
+        "track": _track_to_edge(shape, start, step),
+        "must_final": must_final,
+        "must_be_blocked_by": must_be_blocked_by,
