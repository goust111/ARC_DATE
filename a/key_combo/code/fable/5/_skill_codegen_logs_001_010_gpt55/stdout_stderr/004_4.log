+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt(call_index, require_unobstructed=require_unobstructed)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid four-way gravity input")

