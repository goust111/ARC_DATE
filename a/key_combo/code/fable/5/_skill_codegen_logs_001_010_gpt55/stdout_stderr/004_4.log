+    return int(len(track) - 1), False
+
+
+def _make_token(
+    shape: tuple[int, int],
+    side: str,
+    start: Coord,
+    color: int,
+    idx: int,
+    *,
+    must_final: Coord | None = None,
+    must_be_blocked_by: Coord | None = None,
+) -> dict:
+    step = STEPS[side]
