+def _core_candidates(shape: tuple[int, int], early_side: str) -> list[tuple[Coord, str, int, Coord, Coord]]:
+    h, w = shape
+    late_sides = ("left", "right") if early_side in ("top", "bottom") else ("top", "bottom")
