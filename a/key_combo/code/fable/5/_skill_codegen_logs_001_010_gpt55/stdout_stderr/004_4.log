+    return sides[0]
+
+
+def _edge_start(shape: tuple[int, int], side: str, lane: int) -> Coord:
+    h, w = shape
+    if side == "top":
+        return 0, int(lane)
+    if side == "bottom":
+        return h - 1, int(lane)
+    if side == "left":
+        return int(lane), 0
+    if side == "right":
