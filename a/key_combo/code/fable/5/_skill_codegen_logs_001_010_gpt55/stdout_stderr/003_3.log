+def _room_bounds(mr: int, mc: int, room: int, top: int, left: int) -> tuple[int, int, int, int]:
+    r0 = int(top + mr * room)
+    c0 = int(left + mc * room)
+    return r0, c0, r0 + room - 1, c0 + room - 1
