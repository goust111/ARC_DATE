+    for r in range(H):
+        for c in range(W):
+            if not mask[r, c] or labels[r, c] != -1:
+                continue
+            cid = len(comps)
+            labels[r, c] = cid
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neigh(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and labels[nr, nc] == -1:
+                        labels[nr, nc] = cid
+                        q.append((nr, nc))
+            comps.append(comp)
+    return labels, comps
+
