+                b = int(labels[r + 1, c])
+                if a != -1 and b != -1 and a != b:
+                    edges.add((min(a, b), max(a, b), DOWN))
+
+            if ne == wall and sw == wall and nw != wall and se != wall:
+                a = int(labels[r, c])
+                b = int(labels[r + 1, c + 1])
+                if a != -1 and b != -1 and a != b:
+                    edges.add((min(a, b), max(a, b), UP))
+    return sorted(edges)
+
+
+def _infer_scene(g: np.ndarray):
+    colors = _colors(g)
+    candidates = []
+    for wall in colors:
