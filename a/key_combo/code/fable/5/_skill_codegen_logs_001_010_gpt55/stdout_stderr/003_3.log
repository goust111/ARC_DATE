+def _crack_edges(g: np.ndarray, wall: int, labels: np.ndarray) -> list[tuple[int, int, str]]:
+    H, W = g.shape
+    edges: set[tuple[int, int, str]] = set()
+    for r in range(H - 1):
+        for c in range(W - 1):
