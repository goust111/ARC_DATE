+    comps = _components_by_color(g, bg)
+    glyphs = []
+    others = []
+    for comp in comps:
+        h, w = _bbox_size(comp["bbox"])
+        if h == GLYPH_SIZE and w == GLYPH_SIZE and int(comp["area"]) >= 24:
+            glyphs.append(comp)
+        else:
