+        rr = int(r0 + r)
+        cc = int(c0 + c)
+        assert int(grid[rr, cc]) == BG
+        grid[rr, cc] = int(color)
+        placed.add((rr, cc))
+    return placed
+
+
+def _gen_attempt() -> np.ndarray | None:
