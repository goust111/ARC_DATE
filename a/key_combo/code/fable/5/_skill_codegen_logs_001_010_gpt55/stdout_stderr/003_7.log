+    for r, c in coords:
+        if kind == "H":
+            vals.append(2 * int(r) - int(key))
+        elif kind == "V":
+            vals.append(2 * int(c) - int(key))
+        elif kind == "D":
+            vals.append(int(r) - int(c) - int(key))
+        elif kind == "A":
+            vals.append(int(r) + int(c) - int(key))
+        else:
+            raise ValueError(f"unknown axis kind {kind!r}")
+    if max(vals) < 0:
+        return -1
+    if min(vals) > 0:
