+            si = _side(base_objects[int(i)]["coords"], true_axis)  # type: ignore[arg-type]
+            src = int(i) if si < 0 else int(j)
+            dst = int(j) if si < 0 else int(i)
+            colors[src] = int(cycle[edge])
