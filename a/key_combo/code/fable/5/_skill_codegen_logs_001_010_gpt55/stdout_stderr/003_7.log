+    colors = _assign_colors(coordsets, true_axis, fake_axis, int(bg))
+    if colors is None:
+        return None
+    grid = _render(side, int(bg), coordsets, colors)
+    if not _semantic_accepts(grid, true_axis, fake_axis):
