+            grid[anchor[0] + dr, anchor[1] + dc] = color
+        blocked.update(reservation)
+        return anchor
+    return None
+
+
+def _expected_output(grid_shape: tuple[int, int], bg: int, plans: list[_FamilyPlan]) -> np.ndarray:
