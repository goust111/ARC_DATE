+
+LineSpec = tuple[str, int]
+Coord = tuple[int, int]
+
+DIRS = ("H", "V", "D", "A")  # row, column, r-c, r+c
+MIN_LINE_LENGTH = 7
+GRID_SIZE_RANGE = (14, 30)
+LINE_COUNT_RANGE = (3, 6)
+GENERATION_ATTEMPTS = 600
