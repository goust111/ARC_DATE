+            indeg[int(dst)] += 1
+
+    ready = [int(c) for c in colors if indeg[int(c)] == 0]
+    order: list[int] = []
+    while ready:
+        assert len(ready) == 1, "occlusion evidence must determine one layer chain"
+        cur = ready.pop()
+        order.append(cur)
