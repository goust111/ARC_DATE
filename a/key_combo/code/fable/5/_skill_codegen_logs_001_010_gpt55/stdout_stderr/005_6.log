+        for sc in range(w):
+            color = int(grid[sr, sc])
+            if color == bg or seen[sr, sc]:
+                continue
+
+            seen[sr, sc] = True
+            queue = deque([(sr, sc)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if (
+                        0 <= rr < h
+                        and 0 <= cc < w
+                        and not seen[rr, cc]
+                        and int(grid[rr, cc]) == color
+                    ):
+                        seen[rr, cc] = True
+                        queue.append((rr, cc))
