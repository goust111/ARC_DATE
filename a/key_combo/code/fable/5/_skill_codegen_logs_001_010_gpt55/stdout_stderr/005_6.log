+    """Extract a unique perfect matching of valid rectangle pairs."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _background(g)
+    objects = _components(g, bg)
+    assert len(objects) >= 2 and len(objects) % 2 == 0
