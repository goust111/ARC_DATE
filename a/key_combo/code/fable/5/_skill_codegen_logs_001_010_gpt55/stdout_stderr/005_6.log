# Layout ranges and bounds.
ALIGNMENTS = ("H", "V")
RECT_PERP_BOUNDS = (1, 4)
RECT_AXIAL_VALUES = range(1, 3)
GAP_VALUES = range(6, 17)
AXIAL_BOUNDS = (14, 22)
MARGIN = 1
PALETTE = tuple(range(10))
MAX_GENERATION_ATTEMPTS = 300
VALID_AXIAL_GAP_PAIRS = tuple(
    (rect_axial, gap)
    for rect_axial in RECT_AXIAL_VALUES
    for gap in GAP_VALUES
    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]
)


def _choose_layout() -> tuple[str, int, int, int]:
    alignment = random.choice(ALIGNMENTS)
    rect_perp = random.randint(*RECT_PERP_BOUNDS)
    rect_axial, gap = random.choice(VALID_AXIAL_GAP_PAIRS)
    return alignment, rect_perp, rect_axial, gap


def _choose_colors() -> tuple[int, int, int]:
    bg = random.choice(PALETTE)
    color_a, color_b = random.sample([color for color in PALETTE if color != bg], 2)
    return bg, color_a, color_b


def _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:
    """Build the horizontal input/output pair; vertical cases are its transpose."""
    perp = rect_perp + 2 * MARGIN
    axial = 2 * rect_axial + gap + 2 * MARGIN
    left_c0 = MARGIN
    left_c1 = left_c0 + rect_axial - 1
    right_c1 = axial - MARGIN - 1
    right_c0 = right_c1 - rect_axial + 1
    row0 = MARGIN
    row1 = row0 + rect_perp - 1

    out = np.full((perp, axial), bg, dtype=int)
    out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a
    out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b

    span = gap // 2
    out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a
    out[:, right_c0 - span : right_c0] = color_b

    inp = out.copy()
    inp[:, left_c1 + 1 : right_c0] = bg
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    alignment, rect_perp, rect_axial, gap = _choose_layout()
    bg, color_a, color_b = _choose_colors()
    inp, out = _render_horizontal(rect_perp, rect_axial, gap, bg, color_a, color_b)
    if alignment == "V":
        inp = inp.T.copy()
        out = out.T.copy()

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid d968ffd4 input")
from collections import defaultdict

import numpy as np

from arc_utils import colors_present, get_bg, in_bounds
import random


def _find_anchor(mask: np.ndarray) -> tuple[int, int, int, int]:
    h, w = mask.shape
    anchors = []
    for r in range(h - 2):
        for c in range(w - 2):
            if mask[r : r + 3, c : c + 3].all():
                anchors.append((r, c, r + 2, c + 2))
    assert len(anchors) == 1
    return anchors[0]


def _ray_terminal(
    coord: tuple[int, int],
    anchor: tuple[int, int, int, int],
    shape: tuple[int, int],
) -> tuple[tuple[int, int], tuple[int, int]]:
    r, c = coord
    r0, c0, r1, c1 = anchor
    dr = 1 if r < r0 else -1 if r > r1 else 0
    dc = 1 if c < c0 else -1 if c > c1 else 0
    assert (dr, dc) != (0, 0)

    cr, cc = r, c
    for _ in range(max(shape) * 2):
        nr, nc = cr + dr, cc + dc
        if r0 <= nr <= r1 and c0 <= nc <= c1:
            return (cr, cc), (dr, dc)
        assert in_bounds(shape, nr, nc)
        cr, cc = nr, nc
    raise AssertionError("ray does not reach anchor")


def main(grid: np.ndarray) -> np.ndarray:
    """Compress each colored ray pixel inward until it touches that color's 3x3 anchor block.
    Input structure
    - A uniform background grid with non-background colors.
    - Each foreground color contains one solid 3x3 anchor block; all other pixels of that color lie on straight 8-neighbor rays aimed at that block.
    Rule
    - Keep anchor blocks fixed, erase loose foreground pixels, and for each ray pack its pixels into consecutive cells adjacent to the anchor along the same ray.
    Key insight
    - The scattered pixels are displaced pixels on visible row, column, or diagonal sightlines back to their same-colored 3x3 block.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    out = np.full_like(g, bg)
    occupied: dict[tuple[int, int], int] = {}

    fg_colors = colors_present(g, exclude={bg})
    assert fg_colors

    for color in fg_colors:
        mask = g == color
        anchor = _find_anchor(mask)
        r0, c0, r1, c1 = anchor

        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                assert (r, c) not in occupied
                occupied[(r, c)] = color
                out[r, c] = color

        rays: dict[
            tuple[tuple[int, int], tuple[int, int]], list[tuple[int, int, int]]
        ] = defaultdict(list)
        for raw_r, raw_c in np.argwhere(mask):
            r, c = int(raw_r), int(raw_c)
            if r0 <= r <= r1 and c0 <= c <= c1:
                continue
            terminal, step = _ray_terminal((r, c), anchor, g.shape)
            dist = max(abs(r - terminal[0]), abs(c - terminal[1]))
            rays[(terminal, step)].append((dist, r, c))

        for (terminal, (dr, dc)), cells in rays.items():
            distances = [dist for dist, _, _ in cells]
            assert len(distances) == len(set(distances))
            tr, tc = terminal
            for i, _ in enumerate(sorted(cells)):
                dest = (tr - i * dr, tc - i * dc)
                assert in_bounds(g.shape, *dest)
                assert dest not in occupied
                occupied[dest] = color
                out[dest] = color

        assert int((out == color).sum()) == int(mask.sum())

    return out

