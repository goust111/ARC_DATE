+            top_len = tr1 - tr0 + 1
+            bottom_len = br1 - br0 + 1
+
+            out[tr1 + 1 : tr1 + 1 + bottom_len, c0 : c1 + 1] = top["color"]
+            out[br0 - top_len : br0, c0 : c1 + 1] = bottom["color"]
