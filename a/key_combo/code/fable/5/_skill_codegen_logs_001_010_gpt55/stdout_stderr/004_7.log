+def _longest_horizontal_run(g: np.ndarray, bg: int) -> tuple[int, int, int, int]:
+    """Return (row, first_col, last_col, color) for the unique longest run."""
+    runs: list[tuple[int, int, int, int]] = []
+    H, W = g.shape
+    for r in range(H):
+        c = 0
+        while c < W:
+            color = int(g[r, c])
+            if color == bg:
+                c += 1
