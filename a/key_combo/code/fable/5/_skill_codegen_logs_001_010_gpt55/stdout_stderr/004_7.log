+def _parse_balance(g: np.ndarray) -> tuple[int, int, list[dict[str, object]]]:
+    """Recover the fulcrum column and every visibly connected hanging block."""
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = int(get_bg(g))
