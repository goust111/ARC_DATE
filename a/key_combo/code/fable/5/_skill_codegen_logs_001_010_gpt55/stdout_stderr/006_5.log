+def _stack_oracle(
+    bg: int, rectangles: list[dict[str, object]], *, orient: bool = True
+) -> np.ndarray:
+    dims: list[tuple[int, int, int]] = []
+    for rect in rectangles:
+        r0, c0, r1, c1 = rect["box"]
+        h, w = r1 - r0 + 1, c1 - c0 + 1
