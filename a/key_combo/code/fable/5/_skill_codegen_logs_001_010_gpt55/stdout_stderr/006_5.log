+def _semantic_check(
+    grid: np.ndarray, bg: int, marker_color: int, colors: list[int], expected: np.ndarray
+) -> bool:
+    """Check rule semantics, anti-shortcuts, uniqueness, and non-degeneracy."""
+    try:
+        rectangles = _known_rectangles(grid, colors, marker_color)
+    except ValueError:
