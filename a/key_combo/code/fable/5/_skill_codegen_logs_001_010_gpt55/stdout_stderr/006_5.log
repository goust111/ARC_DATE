    for marker_color, r, c, direction in placements:
        _paint_output(out, marker_color, r, c, direction)
    _black_shared_corners(out, {d for _, _, _, d in placements})

    inp = out.copy()
    inp[~keep] = bg

    try:
        solved = main(inp)
    except AssertionError:
        return None
    if np.array_equal(solved, out):
        return inp
    return None


