+
+# ---------------------------------------------------------------------------
+# Generator
+# ---------------------------------------------------------------------------
+
+
+def _outward_marker(
+    box: tuple[int, int, int, int], direction: tuple[int, int]
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if direction == (-1, 0):
+        return r0 - 1, (c0 + c1) // 2
+    if direction == (1, 0):
+        return r1 + 1, (c0 + c1) // 2
+    if direction == (0, -1):
+        return (r0 + r1) // 2, c0 - 1
+    return (r0 + r1) // 2, c1 + 1
