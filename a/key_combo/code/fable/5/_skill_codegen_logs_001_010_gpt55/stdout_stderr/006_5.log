+
+def _turn_marker_side_down(array: np.ndarray, direction: tuple[int, int]) -> np.ndarray:
+    turns = {(1, 0): 0, (0, 1): 3, (-1, 0): 2, (0, -1): 1}
+    return np.rot90(array, k=turns[direction]).copy()
