+        owner[r0 : r1 + 1, c0 : c1 + 1] = i
+    r, c = rectangles[index]["marker"]
+    dr, dc = rectangles[index]["dir"]
+    r, c = r + dr, c + dc
+    hits: list[int] = []
+    while 0 <= r < h and 0 <= c < w:
+        hit = int(owner[r, c])
+        if hit >= 0 and (not hits or hits[-1] != hit):
+            hits.append(hit)
+        r, c = r + dr, c + dc
