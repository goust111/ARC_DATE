+    pieces: list[np.ndarray] = []
+    for i in order:
+        rect = rectangles[i]
+        r0, c0, r1, c1 = rect["box"]
+        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        pieces.append(_turn_marker_side_down(patch, rect["dir"]))
