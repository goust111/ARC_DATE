+            h, w = w, h
+        dims.append((h, w, int(rect["color"])))
+    out_h = sum(h for h, _w, _color in dims)
+    out_w = max(w for _h, w, _color in dims)
+    out = np.full((out_h, out_w), bg, dtype=int)
+    row = 0
+    for h, w, color in dims:
