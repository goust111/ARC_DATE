+    for i, rect in enumerate(rectangles):
+        coords = rect["coords"]
+        owner[coords[:, 0], coords[:, 1]] = i
+
+    successors: list[int | None] = []
+    for i, rect in enumerate(rectangles):
+        r, c = rect["marker"]
+        dr, dc = rect["dir"]
+        r, c = r + dr, c + dc
+        hit: int | None = None
+        while 0 <= r < h and 0 <= c < w:
+            if owner[r, c] >= 0:
+                hit = int(owner[r, c])
+                break
+            r, c = r + dr, c + dc
+        assert hit != i
+        successors.append(hit)
