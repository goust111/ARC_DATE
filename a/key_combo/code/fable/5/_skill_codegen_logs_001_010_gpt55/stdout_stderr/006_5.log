+    if not any(d[1] != 0 and sh[0] != sh[1] for sh, d in zip(shapes, directions)):
+        shapes[0] = random.choice(((3, 5), (5, 3)))
+    if not any(d[0] != 0 and sh[0] != sh[1] for sh, d in zip(shapes, directions)):
+        shapes[1] = random.choice(((3, 5), (5, 3)))
