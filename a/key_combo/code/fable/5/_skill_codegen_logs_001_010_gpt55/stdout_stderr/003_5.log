+        color = int(color)
+        full_rows = [r for r in range(H) if bool(np.all(grid[r, :] == color))]
+        full_cols = [c for c in range(W) if bool(np.all(grid[:, c] == color))]
+        if len(full_rows) < 2 or len(full_cols) < 2:
+            continue
