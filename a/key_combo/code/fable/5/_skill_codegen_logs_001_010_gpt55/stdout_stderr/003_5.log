+    counts = Counter(int(v) for v in grid.ravel())
+    if counts[int(marker)] != 1:
+        return False
+    body_counts = Counter(int(v) for v in body_colors.ravel())
+    if any(count == 1 for count in body_counts.values()):
+        return False
+
