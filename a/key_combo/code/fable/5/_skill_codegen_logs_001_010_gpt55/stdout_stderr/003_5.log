+def _runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    out: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for value in indices[1:]:
+        value = int(value)
+        if value == prev + 1:
