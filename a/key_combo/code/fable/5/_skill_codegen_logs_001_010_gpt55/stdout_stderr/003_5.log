+def _build_grid(
+    rows: int,
+    cols: int,
+    cell_size: int,
+    sep_width: int,
+    sep: int,
+    bg: int,
+    marker: int,
+    body_colors: np.ndarray,
+    directions: np.ndarray,
+    start: tuple[int, int],
