+Coord = tuple[int, int]
+_DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_PALETTE = tuple(range(10))
+_MAX_GENERATION_ATTEMPTS = 250
+_MAX_SEED_ATTEMPTS = 500
