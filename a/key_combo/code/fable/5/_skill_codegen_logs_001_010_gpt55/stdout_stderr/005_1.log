    grid = np.full((rows, cols), bg, dtype=int)

    bands: list[tuple[int, int, int]] = []
    col = 0
    for i, (width, color) in enumerate(zip(widths, fg_colors)):
        _gen_fill_band(grid, col, width, color)
        bands.append((col, col + width - 1, color))
        col += width
        if i != band_count - 1:
