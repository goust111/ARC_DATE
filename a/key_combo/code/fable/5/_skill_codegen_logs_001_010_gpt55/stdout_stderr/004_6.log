+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    H, W = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q: deque[Coord] = deque([(r, c)])
+        seen[r, c] = True
+        coords: list[Coord] = []
+        while q:
+            rr, cc = q.popleft()
+            coords.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
