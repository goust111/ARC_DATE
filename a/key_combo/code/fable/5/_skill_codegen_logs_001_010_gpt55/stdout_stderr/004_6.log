+def _random_shape_mask() -> np.ndarray | None:
+    h = random.randint(*SHAPE_HEIGHT_RANGE)
+    w = random.randint(*SHAPE_WIDTH_RANGE)
+    center = random.randint(2, w - 3)
+    left_cap = center
+    right_cap = w - 1 - center
+
