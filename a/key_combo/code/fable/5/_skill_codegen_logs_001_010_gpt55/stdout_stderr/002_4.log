+            dirs = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+        else:
+            dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        comps = []
+        for r in range(H):
+            for c in range(W):
+                if not mask[r, c] or seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                pts = []
+                while stack:
+                    rr, cc = stack.pop()
+                    pts.append((rr, cc))
+                    for dr, dc in dirs:
+                        nr, nc = rr + dr, cc + dc
+                        if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
