+def _spec_margin(spec: dict) -> tuple[int, int, int, int]:
+    plug = spec.get("plug")
+    if plug is None:
+        return 0, 0, 0, 0
+    depth = int(plug["depth"])
+    outside = int(plug["outside"])
+    top = bottom = left = right = 0
+    side = plug["side"]
+    needed = outside + depth + 1
+    if side == "top":
+        top = needed
+    elif side == "bottom":
+        bottom = needed
+    elif side == "left":
+        left = needed
+    else:
+        right = needed
+    return top, bottom, left, right
