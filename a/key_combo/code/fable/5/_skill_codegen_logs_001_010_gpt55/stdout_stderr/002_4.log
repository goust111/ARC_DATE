+
+def _plug_coords(box: BBox, plug: dict) -> list[Coord]:
+    r0, c0, r1, c1 = map(int, box)
+    side = plug["side"]
+    span = int(plug["span"])
+    depth = int(plug["depth"])
+    offset = int(plug["offset"])
+    outside = int(plug["outside"])
+    cells: list[Coord] = []
+
+    if side == "top":
+        cc0 = c0 + 1 + offset
+        for r in range(r0 - outside, r0 + depth + 1):
