+def _plug_motion_from_spec(box: BBox, plug: dict) -> tuple[int, int]:
+    side = plug["side"]
+    depth = int(plug["depth"])
+    if side == "top":
+        return -depth - 1, 0
+    if side == "bottom":
+        return depth + 1, 0
+    if side == "left":
+        return 0, -depth - 1
+    return 0, depth + 1
