+def _remaining_empty_counts(grid: np.ndarray, specs: list[dict], bg: int) -> list[int]:
+    counts = []
+    for spec in specs:
+        cells = _inner_cells(spec["box"])
+        counts.append(sum(int(grid[r, c]) == int(bg) for r, c in cells))
+    return counts
