+    except Exception:
+        return None
+    if not _semantic_checks(inp, actual, expected, metadata, bg):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {GEN_ATTEMPTS} attempts")

