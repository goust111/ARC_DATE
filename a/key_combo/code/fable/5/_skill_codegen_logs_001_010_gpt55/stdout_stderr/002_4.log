+def _build_pair(shape: tuple[int, int], specs: list[dict], bg: int, frame_color: int, scatter_colors: list[int], plug_colors: list[int]) -> tuple[np.ndarray, np.ndarray, dict] | None:
+    grid = np.full(shape, int(bg), dtype=int)
