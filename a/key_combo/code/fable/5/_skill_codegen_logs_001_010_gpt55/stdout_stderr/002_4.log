+    if side == "top":
+        cc0 = c0 + 1 + offset
+        for r in range(r0 - outside, r0 + depth + 1):
+            for c in range(cc0, cc0 + span):
+                cells.append((r, c))
+    elif side == "bottom":
+        cc0 = c0 + 1 + offset
+        for r in range(r1 - depth, r1 + outside + 1):
+            for c in range(cc0, cc0 + span):
+                cells.append((r, c))
+    elif side == "left":
+        rr0 = r0 + 1 + offset
+        for r in range(rr0, rr0 + span):
+            for c in range(c0 - outside, c0 + depth + 1):
+                cells.append((r, c))
+    else:
+        rr0 = r0 + 1 + offset
+        for r in range(rr0, rr0 + span):
+            for c in range(c1 - depth, c1 + outside + 1):
+                cells.append((r, c))
+    return cells
