+            for dr in range(-SCATTER_GAP, SCATTER_GAP + 1):
+                for dc in range(-SCATTER_GAP, SCATTER_GAP + 1):
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < H and 0 <= cc < W:
+                        if int(grid[rr, cc]) == int(color) or (rr, cc) in reserved:
