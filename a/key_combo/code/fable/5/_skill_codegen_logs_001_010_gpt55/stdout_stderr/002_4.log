+    inp, expected, metadata = pair
+    if int(get_bg(inp)) != int(bg):
+        return None
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not _semantic_checks(inp, actual, expected, metadata, bg):
+        return None
+    return inp
