+            _paint_cells(expected, _moved_plug_coords(box, spec["plug"]), plug_color)
+
+    metadata = {
+        "specs": specs,
+        "scatter_by_color": scatter_by_color,
+        "trap_area": next(spec["area"] for spec in specs if spec.get("trap")),
+    }
