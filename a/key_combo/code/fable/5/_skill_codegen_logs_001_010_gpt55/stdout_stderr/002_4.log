+    scatter_counts = sorted(len(cells) for cells in metadata["scatter_by_color"].values())
+    if len(full_areas) != len(set(full_areas)):
+        return False
+    if not all(full_areas.count(count) == 1 for count in scatter_counts):
+        return False
