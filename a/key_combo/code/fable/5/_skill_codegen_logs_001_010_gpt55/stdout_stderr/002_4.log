+
+def _bbox_overlap_with_gap(a: BBox, b: BBox, gap: int) -> bool:
+    return (
+        a[0] - gap <= b[2] + gap
+        and a[2] + gap >= b[0] - gap
+        and a[1] - gap <= b[3] + gap
+        and a[3] + gap >= b[1] - gap
