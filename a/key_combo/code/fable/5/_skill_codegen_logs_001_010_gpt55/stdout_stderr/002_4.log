+# ---------------- generator ----------------
+
+GEN_ATTEMPTS = 600
+GRID_SIZE_RANGE = (24, 30)
+INNER_H_RANGE = (2, 5)
+INNER_W_RANGE = (2, 6)
+MAX_PLUG_SPAN = 3
+MAX_PLUG_DEPTH = 2
+PLUGIN_OUTSIDE_DEPTHS = (1, 2)
+FRAME_GAP = 1
+SCATTER_GAP = 1
