+    assert len(groups) == 1, "expected one shared frame color"
+    frame_color, frames = groups[0]
+    frames = sorted(frames, key=lambda f: (f["box"][0], f["box"][1]))
+    assert len(frames) >= 2, "expected several rectangular frames"
