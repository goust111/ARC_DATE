+def _dim_options() -> list[tuple[int, int, int]]:
+    opts = []
+    for h in range(INNER_H_RANGE[0], INNER_H_RANGE[1] + 1):
+        for w in range(INNER_W_RANGE[0], INNER_W_RANGE[1] + 1):
