+
+def _candidate_scatter_cells(grid: np.ndarray, reserved: set[Coord], color: int) -> list[Coord]:
+    H, W = grid.shape
+    cells = []
+    for r in range(H):
+        for c in range(W):
+            if int(grid[r, c]) != int(get_bg(grid)):
+                continue
+            if (r, c) in reserved:
+                continue
