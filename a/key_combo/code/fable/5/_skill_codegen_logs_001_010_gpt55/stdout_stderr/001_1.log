+Coord = tuple[int, int]
+DIRS: tuple[Coord, ...] = ((0, 1), (1, 0), (0, -1), (-1, 0))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr or dc:
+                yield r + dr, c + dc
+
+
+def _bbox(cells: set[Coord]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _components_of_color(g: np.ndarray, color: int) -> list[set[Coord]]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[set[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != int(color):
+                continue
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            comp: set[Coord] = set()
+            while q:
+                rr, cc = q.popleft()
+                comp.add((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == int(color)
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
