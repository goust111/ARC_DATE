        for r in range(INTERIOR_MARGIN, side - INTERIOR_MARGIN)
        for c in range(INTERIOR_MARGIN, side - INTERIOR_MARGIN)
        if (r, c) not in taken
    ]
    return [
        combo
        for combo in itertools.combinations(interior, size)
        if _is_connected(combo, side)
    ]


