+    for direction, side, depth in trials:
+        dr, dc = direction
+        if (dr, dc) == (0, 1):
+            tail = (r0 + side // 2, c1)
+        elif (dr, dc) == (0, -1):
+            tail = (r0 + side // 2, c0)
+        elif (dr, dc) == (1, 0):
+            tail = (r1, c0 + side // 2)
+        else:
+            tail = (r0, c0 + side // 2)
+        frame, interior = _cup_geometry(tail, direction, side, depth)
