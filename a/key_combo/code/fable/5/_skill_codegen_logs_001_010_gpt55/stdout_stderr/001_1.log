+    else:
+        assert (dr, dc) == (-1, 0)  # tail points up; body and opening lie below it
+        closed_r = tr + 1
+        open_r = tr + int(depth)
+        left = tc - half
+        right = tc + half
+        for c in range(left, right + 1):
+            frame.add((closed_r, c))
+        for r in range(closed_r, open_r + 1):
+            frame.add((r, left))
+            frame.add((r, right))
