+                {
+                    "tail": tail,
+                    "direction": direction,
+                    "side": int(side),
+                    "depth": int(depth),
+                    "frame": frame,
+                    "interior": interior,
+                }
+            )
+
+    if len(matches) != 1:
+        return None
+    return matches[0]
+
+
+def _find_cups(g: np.ndarray, bg: int) -> list[dict]:
