+    elif (dr, dc) == (1, 0):  # tail points down; body and opening lie above it
+        closed_r = tr - 1
+        open_r = tr - int(depth)
+        left = tc - half
+        right = tc + half
+        for c in range(left, right + 1):
+            frame.add((closed_r, c))
+        for r in range(open_r, closed_r + 1):
+            frame.add((r, left))
+            frame.add((r, right))
+        for r in range(open_r, closed_r):
+            for c in range(left + 1, right):
+                interior.add((r, c))
