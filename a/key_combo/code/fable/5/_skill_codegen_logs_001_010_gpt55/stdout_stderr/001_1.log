PALETTE = tuple(range(10))
MAX_ATTEMPTS = 400


def _paint_cup(
    grid: np.ndarray,
    tail: Coord,
    direction: Coord,
    side: int,
    depth: int,
    border: int,
    content: int,
    ammo: int,
) -> None:
