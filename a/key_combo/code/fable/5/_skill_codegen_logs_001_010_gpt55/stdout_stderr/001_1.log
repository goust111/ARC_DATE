+
+def _clear_ray(grid: np.ndarray, bg: int, tail: Coord, direction: Coord, distance: int) -> bool:
+    r, c = tail
+    dr, dc = direction
+    for _ in range(int(distance) - 1):
+        r += dr
+        c += dc
