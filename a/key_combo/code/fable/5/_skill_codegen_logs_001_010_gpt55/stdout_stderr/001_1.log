+    for color in sorted(set(map(int, g.ravel())) - {int(bg)}):
+        color_cups = []
+        for comp in _components_of_color(g, color):
+            if len(comp) < 12:
+                continue
+            matched = _match_cup_component(comp, g.shape)
+            if matched is not None:
+                color_cups.append({**matched, "border": int(color)})
