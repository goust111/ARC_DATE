+        grid[rec["endpoint"]] = GREY
+        grid[rec["hinge"]] = BLUE
+        for p in rec["fixed_red"]:
+            grid[p] = RED
+        for p in rec["tail"]:
+            grid[p] = RED
+        grid[rec["socket"]] = YELLOW
+    return grid
