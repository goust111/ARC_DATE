+RED = Color.RED
+BLUE = Color.BLUE
+YELLOW = Color.YELLOW
+GREY = Color.GREY
+ROLE_COLORS = {RED, BLUE, YELLOW, GREY}
+
+HORIZONTAL = "H"
+VERTICAL = "V"
