+    covered = {endpoint, hinge, *fixed_red, *tail}
+    assert covered == coord_set, "rod component contains extra cells"
+    return {
+        "endpoint": endpoint,
+        "hinge": hinge,
+        "orient": orient,
+        "tail": tail,
+        "tail_len": len(tail),
