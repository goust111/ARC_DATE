+def _compatible(
+    rec: dict,
+    blocked: set[tuple[int, int]],
+    used_tail_lengths: set[int],
+) -> bool:
+    if int(rec["tail_len"]) in used_tail_lengths:
+        return False
+    return not bool(rec["footprint"] & blocked)
+
+
