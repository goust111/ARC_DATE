+# --------------- generator ---------------
+
+BG_COLORS = tuple(c for c in range(10) if c not in ROLE_COLORS)
+GRID_H_RANGE = (15, 30)
+GRID_W_RANGE = (15, 30)
+ROD_COUNT_RANGE = (3, 5)
+FIXED_DIST_RANGE = (2, 6)
+TAIL_LEN_RANGE = (2, 8)
