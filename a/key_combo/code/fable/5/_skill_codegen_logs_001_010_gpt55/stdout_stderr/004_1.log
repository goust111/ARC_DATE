+        return False
+    if int(np.count_nonzero(grid == bg)) <= int(grid.size // 2):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    H = random.randint(*GRID_H_RANGE)
+    W = random.randint(*GRID_W_RANGE)
+    shape = (H, W)
