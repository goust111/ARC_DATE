from __future__ import annotations

import numpy as np

from arc_utils import components_mask, get_bg
import random


def _color_counts(g: np.ndarray) -> dict[int, int]:
    vals, counts = np.unique(g, return_counts=True)
    return {int(v): int(n) for v, n in zip(vals, counts)}


def _roles(g: np.ndarray) -> tuple[int, int, int, int]:
    bg = get_bg(g)
    counts = _color_counts(g)
    colors = [c for c in counts if c != bg]
    assert len(colors) == 3, "expected wall, door, and marker colors"

    marker_colors = [c for c in colors if counts[c] == 2]
    assert len(marker_colors) == 1, "expected exactly two marker pixels"
    path_color = marker_colors[0]

    remaining = [c for c in colors if c != path_color]
    areas = {c: counts[c] for c in remaining}
    door_area = min(areas.values())
    wall_area = max(areas.values())
    door_colors = [c for c in remaining if counts[c] == door_area]
    wall_colors = [c for c in remaining if counts[c] == wall_area]
    assert len(door_colors) == 1 and len(wall_colors) == 1
    assert door_area < wall_area, "door color must be the smaller non-marker object set"
    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])


def _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:
    comps = components_mask(g == int(door_color), connectivity=4)
    assert comps, "expected door segments"

    orientations: list[str] = []
    centers: list[tuple[int, int]] = []
    for coords in comps:
        assert coords.shape[0] == 3, "each door segment is three pixels long"
        r0, c0 = coords.min(axis=0)
        r1, c1 = coords.max(axis=0)
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        if height == 3 and width == 1:
            orientations.append("vertical")
            centers.append((int(r0 + 1), int(c0)))
        elif height == 1 and width == 3:
            orientations.append("horizontal")
            centers.append((int(r0), int(c0 + 1)))
        else:
            raise AssertionError("door segments must be straight length-3 bars")

    assert len(set(orientations)) == 1, "all doors must share an orientation"
    return orientations[0], centers


def _paint_segment(
    out: np.ndarray,
    start: tuple[int, int],
    end: tuple[int, int],
    color: int,
    allowed: set[int],
) -> None:
    r0, c0 = map(int, start)
    r1, c1 = map(int, end)
    assert r0 == r1 or c0 == c1, "path segments must be orthogonal"
    height, width = out.shape
    assert 0 <= r0 < height and 0 <= r1 < height
    assert 0 <= c0 < width and 0 <= c1 < width

    if r0 == r1:
        for c in range(min(c0, c1), max(c0, c1) + 1):
            assert int(out[r0, c]) in allowed, "path may only cover bg, doors, or markers"
            out[r0, c] = int(color)
    else:
        for r in range(min(r0, r1), max(r0, r1) + 1):
            assert int(out[r, c0]) in allowed, "path may only cover bg, doors, or markers"
            out[r, c0] = int(color)


def _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:
    coords = np.argwhere(g == int(path_color))
    assert coords.shape[0] == 2, "expected two marker pixels"
    return [tuple(map(int, coord)) for coord in coords]


def _solve_vertical_walls(
    g: np.ndarray,
    centers: list[tuple[int, int]],
    markers: list[tuple[int, int]],
    bg: int,
    path_color: int,
    door_color: int,
    wall_color: int,
) -> np.ndarray:
    out = g.copy()
    centers = sorted(centers, key=lambda p: p[1])
    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))
    assert len(wall_cols) == len(centers), "each vertical wall must have one door"
    assert [c for _r, c in centers] == wall_cols
    for _r, c in centers:
        assert np.all(np.isin(g[:, c], [wall_color, door_color]))

    start, end = sorted(markers, key=lambda p: p[1])
    assert start[1] < centers[0][1] and end[1] > centers[-1][1]

    allowed = {int(bg), int(path_color), int(door_color)}
    cur = start
    for door_r, door_c in centers:
        approach = (cur[0], door_c - 1)
        _paint_segment(out, cur, approach, path_color, allowed)
        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)
        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)
        cur = (door_r, door_c)

    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)
    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)
    return out


def _solve_horizontal_walls(
    g: np.ndarray,
    centers: list[tuple[int, int]],
    markers: list[tuple[int, int]],
    bg: int,
    path_color: int,
    door_color: int,
    wall_color: int,
) -> np.ndarray:
    out = g.copy()
    centers = sorted(centers, key=lambda p: p[0])
    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))
    assert len(wall_rows) == len(centers), "each horizontal wall must have one door"
    assert [r for r, _c in centers] == wall_rows
    for r, _c in centers:
        assert np.all(np.isin(g[r, :], [wall_color, door_color]))

    start, end = sorted(markers, key=lambda p: p[0])
    assert start[0] < centers[0][0] and end[0] > centers[-1][0]

    allowed = {int(bg), int(path_color), int(door_color)}
    cur = start
    for door_r, door_c in centers:
        approach = (door_r - 1, cur[1])
        _paint_segment(out, cur, approach, path_color, allowed)
        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)
        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)
        cur = (door_r, door_c)

    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)
    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw the marker-colored route through the centers of all doors in the parallel wall maze.

    Input structure:
    - The grid has a background, parallel full-span walls, one three-pixel door
      segment in each wall, and two marker pixels sharing a color.
    - Walls are either all vertical or all horizontal, and the markers are on
      opposite outer sides of the wall set.

    Rule:
    - Keep the scene unchanged except for the route.
    - Visit the door centers in wall order from the upper/left marker side to
      the lower/right marker side.
    - In each corridor, draw an orthogonal path to the cell just before the next
      wall, move along that wall to the door center, cross the center, and
      continue to the next corridor; after the last door, connect to the other
      marker.

    Key insight:
    - The three-pixel door segments mark the only crossing points through a set
      of parallel walls, so the output is the corridor path threaded through
      those centers.
    """
    g = np.asarray(grid, dtype=int)
    bg, path_color, door_color, wall_color = _roles(g)
    orientation, centers = _door_centers(g, door_color)
    markers = _markers(g, path_color)

    if orientation == "vertical":
        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)
    assert orientation == "horizontal"
    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)

# --------------- generator (att1) ---------------

# Canvas and color role sampling.
GRID_H = 30
GRID_W = 30
COLOR_POOL = range(10)
N_ROLE_COLORS = 4

# Parallel wall and door geometry.
ORIENTATIONS = ("vertical", "horizontal")
WALL_COUNT_RANGE = (3, 4)
WALL_POS_LO = 4
WALL_POS_HI_MARGIN = 5
WALL_MIN_GAP = 2
DOOR_CENTER_LO = 3
DOOR_CENTER_HI_MARGIN = 4

# Marker placement and retry budget.
MARKER_EDGE_RANGE = (1, 3)
MARKER_FREE_LO = 1
MARKER_FREE_HI_MARGIN = 2
GEN_RETRIES = 300


def _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:
    """Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions."""
    needed = n + (n - 1) * min_gap
    span = hi - lo + 1
    if span < needed:
        return None
    compressed_span = span - (n - 1) * min_gap
    picks = sorted(rng.sample(range(compressed_span), n))
    return [lo + picks[i] + i * min_gap for i in range(n)]


def _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):
    """Return wall positions and per-wall door centers for the chosen orientation."""
    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == "vertical" else (GRID_H, GRID_W)
    walls = _place_positions(
        n_walls,
        lo=WALL_POS_LO,
        hi=wall_axis - WALL_POS_HI_MARGIN,
        min_gap=WALL_MIN_GAP,
        rng=rng,
    )
    if walls is None:
        return None
    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]
    return walls, doors


def _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:
    """Sample start/end markers on opposite outer corridors."""
    edge_lo, edge_hi = MARKER_EDGE_RANGE
    if orientation == "vertical":
        start_col = rng.randint(edge_lo, edge_hi)
        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)
        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
    else:
        start_row = rng.randint(edge_lo, edge_hi)
        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)
        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
    return (start_row, start_col), (end_row, end_col)


def _render_grid(
    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end
) -> np.ndarray:
    """Render walls, doors, and the two markers into a fresh input grid."""
    grid = np.full((GRID_H, GRID_W), bg, dtype=int)
    if orientation == "vertical":
        for wall_col, door_row in zip(walls, doors):
            grid[:, wall_col] = wall_color
            grid[door_row - 1 : door_row + 2, wall_col] = door_color
    else:
        for wall_row, door_col in zip(walls, doors):
            grid[wall_row, :] = wall_color
            grid[wall_row, door_col - 1 : door_col + 2] = door_color

    grid[start] = marker_color
    grid[end] = marker_color
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = random.Random()
    bg, wall_color, door_color, marker_color = rng.sample(COLOR_POOL, N_ROLE_COLORS)
    orientation = rng.choice(ORIENTATIONS)
    n_walls = rng.randint(*WALL_COUNT_RANGE)

    layout = _sample_wall_layout(orientation, n_walls, rng)
    if layout is None:
        return None
    walls, doors = layout
    start, end = _sample_markers(orientation, rng)
    grid = _render_grid(orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end)

    try:
        main(grid)
    except Exception:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_coords, colors_present, find_components, get_bg, paste, random_free_location
import random


def _tight_mask(mask: np.ndarray) -> np.ndarray:
    coords = np.argwhere(mask)
    assert coords.size, "expected a nonempty mask"
    r0, c0, r1, c1 = bbox_coords(coords)
    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)


def _mask_key(mask: np.ndarray) -> tuple[str, ...]:
    return tuple("".join("1" if cell else "0" for cell in row) for row in mask)


def _shape_signature(mask: np.ndarray) -> tuple[str, ...]:
    base = _tight_mask(mask)
    variants = []
    for k in range(4):
        rotated = np.rot90(base, k)
        variants.append(_mask_key(_tight_mask(rotated)))
        variants.append(_mask_key(_tight_mask(np.fliplr(rotated))))
    return min(variants)


def _legend_order(g: np.ndarray, bg: int) -> list[int]:
    labels: list[tuple[int, int]] = []
    W = g.shape[1]
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=1):
        if int(comp["area"]) != 1:
            continue
        r, c = map(int, comp["coords"][0])
        if c == W - 1:
            labels.append((r, int(comp["color"])))

    labels.sort()
    assert labels, "expected a right-edge color legend"
    assert [r for r, _color in labels] == list(range(len(labels))), "legend must start at the top edge"

    order = [color for _r, color in labels]
    assert len(order) == len(set(order)), "legend colors must be unique"
    assert set(order) == set(colors_present(g, exclude={bg})), "legend must list every foreground color"
    return order


def _main_object_mask(g: np.ndarray, bg: int, color: int) -> np.ndarray:
    comps = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        min_area=1,
    )
    main = [comp for comp in comps if int(comp["area"]) > 1]
    label = [
        comp
        for comp in comps
        if int(comp["area"]) == 1 and int(comp["coords"][0][1]) == g.shape[1] - 1
    ]
    assert len(main) == 1, "expected exactly one main object for each legend color"
    assert len(label) == 1, "expected exactly one right-edge singleton label for each legend color"
    assert len(comps) == 2, "each legend color should appear only as one object and one label"

    r0, c0, r1, c1 = main[0]["bbox"]
    return g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(color)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Build a color-labeled shape-equivalence table from the objects listed on the right edge.

    Input structure:
    - The background contains one main 4-connected object for each foreground color.
    - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.
    - Those singleton pixels define the row and column order of the output table.

    Rule:
    - Normalize each main object to its tight mask and compare masks up to rotation or reflection.
    - Draw 2x2 color labels across the top and down the left, separated by one background row/column.
    - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.
    - Leave diagonal cells and all separators as background.

    Key insight:
    - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    order = _legend_order(g, bg)
    signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}

    n = len(order)
    out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)

    for i, color in enumerate(order):
        band = 3 + 3 * i
        out[0:2, band : band + 2] = int(color)
        out[band : band + 2, 0:2] = int(color)

    for i, row_color in enumerate(order):
        for j, col_color in enumerate(order):
            if i == j:
                continue
            cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY
            r = 3 + 3 * i
            c = 3 + 3 * j
            out[r : r + 2, c : c + 2] = int(cell_color)

    return out

# --------------- generator (att2) ---------------

# Canvas and object bounds.
GEN_OBJECT_COUNT_RANGE, GEN_GRID_ROW_RANGE, GEN_GRID_COL_RANGE = (4, 7), (20, 25), (20, 23)
GEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4
# Shape-class sampling.
GEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80
GEN_DIHEDRAL_FLIP_PROB = 0.5
# Output table layout and colors.
GEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3
GEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)
# Input placement and retry limits.
GEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300
GEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4
GEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_tight_mask(mask: np.ndarray) -> np.ndarray:
    coords = np.argwhere(mask)
    r0, c0, r1, c1 = bbox_coords(coords)
    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)


def _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:
    return tuple("".join("1" if cell else "0" for cell in row) for row in mask)


def _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:
    base = _gen_tight_mask(mask)
    variants = []
    for k in range(4):
        rotated = np.rot90(base, k)
        variants.append(_gen_mask_key(_gen_tight_mask(rotated)))
        variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))
    return min(variants)


def _has_hole(mask: np.ndarray) -> bool:
    bg = ~mask.astype(bool)
    if not bool(bg.any()):
        return False

    H, W = bg.shape
    seen = np.zeros_like(bg, dtype=bool)
    stack: list[tuple[int, int]] = []
    for r in range(H):
        for c in (0, W - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))
    for c in range(W):
        for r in (0, H - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True
                stack.append((r, c))

    while stack:
        r, c = stack.pop()
        for dr, dc in GEN_NEIGHBORS_4:
            nr, nc = r + dr, c + dc
            if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True
                stack.append((nr, nc))
    return bool((bg & ~seen).any())


def _random_corner_path(h: int, w: int) -> np.ndarray:
    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
    sr, sc = random.choice(starts)
    er, ec = h - 1 - sr, w - 1 - sc
    moves = [(1 if er > sr else -1, 0)] * (h - 1)
    moves += [(0, 1 if ec > sc else -1)] * (w - 1)
    random.shuffle(moves)

    mask = np.zeros((h, w), dtype=bool)
    r, c = sr, sc
    mask[r, c] = True
    for dr, dc in moves:
        r += dr
        c += dc
        mask[r, c] = True
    return mask


def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
    h, w = mask.shape
    choices = []
    for r in range(h):
        for c in range(w):
            if mask[r, c]:
                continue
            touches = sum(
                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]
                for dr, dc in GEN_NEIGHBORS_4
            )
            if touches != 1:
                continue
            trial = mask.copy()
            trial[r, c] = True
            if not _has_hole(trial):
                choices.append((r, c))
    return choices


def _random_mask() -> np.ndarray | None:
    area = random.randint(*GEN_OBJECT_AREA_RANGE)
    pairs = [
        (h, w)
        for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)
        for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)
        if h + w - 1 <= area <= h * w
        and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS
    ]
    h, w = random.choice(pairs)
    mask = _random_corner_path(h, w)

    while int(mask.sum()) < area:
        choices = _growth_candidates(mask)
        if not choices:
            return None
        r, c = random.choice(choices)
        mask[r, c] = True
    return mask


def _class_sizes(n: int) -> list[int]:
    k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])
    sizes = [1] * k
    for _ in range(n - k):
        open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]
        sizes[random.choice(open_slots)] += 1
    random.shuffle(sizes)
    return sizes


def _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:
    canonical_masks: list[np.ndarray] = []
    signatures: set[tuple[str, ...]] = set()
    for _ in range(class_count):
        for _ in range(GEN_UNIQUE_MASK_RETRIES):
            mask = _random_mask()
            if mask is None:
                continue
            sig = _gen_shape_signature(mask)
            if sig in signatures:
                continue
            signatures.add(sig)
            canonical_masks.append(mask)
            break
        else:
            return None
    return canonical_masks


def _dihedral(mask: np.ndarray) -> np.ndarray:
    out = np.rot90(mask, random.randrange(4))
    if random.random() < GEN_DIHEDRAL_FLIP_PROB:
        out = np.fliplr(out)
    return out.astype(bool).copy()


def _build_output(colors: list[int], class_ids: list[int]) -> np.ndarray:
    n = len(colors)
    out_size = GEN_TABLE_STEP * n + GEN_TABLE_BLOCK
    out = np.zeros((out_size, out_size), dtype=int)
    for i, color in enumerate(colors):
        band = GEN_TABLE_STEP + GEN_TABLE_STEP * i
        out[0:GEN_TABLE_BLOCK, band : band + GEN_TABLE_BLOCK] = color
        out[band : band + GEN_TABLE_BLOCK, 0:GEN_TABLE_BLOCK] = color

    for i in range(n):
        for j in range(n):
            if i == j:
                continue
            r = GEN_TABLE_STEP + GEN_TABLE_STEP * i
            c = GEN_TABLE_STEP + GEN_TABLE_STEP * j
            cell_color = GEN_SAME_SHAPE_COLOR if class_ids[i] == class_ids[j] else GEN_DIFFERENT_SHAPE_COLOR
            out[r : r + GEN_TABLE_BLOCK, c : c + GEN_TABLE_BLOCK] = cell_color
    return out


def _sample_design() -> tuple[list[int], list[np.ndarray], np.ndarray] | None:
    n = random.randint(*GEN_OBJECT_COUNT_RANGE)
    colors = random.sample(GEN_OBJECT_COLORS, n)
    sizes = _class_sizes(n)
    class_ids = [class_i for class_i, size in enumerate(sizes) for _ in range(size)]
    random.shuffle(class_ids)
    canonical_masks = _unique_canonical_masks(len(sizes))
    if canonical_masks is None:
        return None
    oriented_masks = [_dihedral(canonical_masks[class_i]) for class_i in class_ids]
    expected = _build_output(colors, class_ids)
    return colors, oriented_masks, expected

def _build_input_grid(colors: list[int], oriented_masks: list[np.ndarray]) -> np.ndarray | None:
    n = len(colors)
    H = random.randint(*GEN_GRID_ROW_RANGE)
    W = random.randint(*GEN_GRID_COL_RANGE)
    grid = np.zeros((H, W), dtype=int)
    place_canvas = grid[:, : W - GEN_RESERVED_RIGHT_COLS]

    place_order = list(range(n))
    random.shuffle(place_order)
    for i in place_order:
        patch = np.zeros(oriented_masks[i].shape, dtype=int)
        patch[oriented_masks[i]] = colors[i]
        try:
            r, c = random_free_location(
                place_canvas,
                patch,
                transparent=0,
                border=GEN_PLACEMENT_BORDER,
                padding=GEN_PLACEMENT_PADDING,
                padding_connectivity=GEN_PLACEMENT_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(place_canvas, patch, r, c, transparent=0)

    for r, color in enumerate(colors):
        grid[r, -1] = color
    return grid


def _gen_attempt() -> np.ndarray | None:
    design = _sample_design()
    if design is None:
        return None
    colors, oriented_masks, expected = design
    grid = _build_input_grid(colors, oriented_masks)
    if grid is None:
        return None
    try:
        actual = main(grid)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 6165ea8f input")
from __future__ import annotations
import numpy as np
from arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location
from arc_utils import paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Reorder and stack rectangles by proximity to two colored edge lines.

    Input structure:
    - bg = most common color.
    - Two edge lines (h + v) meet at a corner marked by a unique color.
    - "Blue" line is color 1 if present, else the longer line; other is "red."
    - Solid rectangles in the interior.

    Rule:
    - Sort rectangles by (distance to blue edge, distance to red edge).
    - If the blue edge is vertical, rotate each rectangle 90° CCW.
    - Stack top-to-bottom, centered horizontally.

    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    # --- locate the marked corner ---
    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]
    corner = None
    for r, c in corners:
        if int(g[r, c]) == int(bg):
            continue
        nbr = []
        if r == 0:
            nbr.append(int(g[r + 1, c]))
        if r == H - 1:
            nbr.append(int(g[r - 1, c]))
        if c == 0:
            nbr.append(int(g[r, c + 1]))
        if c == W - 1:
            nbr.append(int(g[r, c - 1]))
        if nbr and all(int(n) != int(g[r, c]) for n in nbr):
            corner = (int(r), int(c))
            break
    assert corner is not None

    cr, cc = map(int, corner)
    marker = int(g[cr, cc])

    # --- line colors adjacent to the corner ---
    hstep = 1 if cc == 0 else -1
    vstep = 1 if cr == 0 else -1
    hcol = int(g[cr, cc + hstep])
    vcol = int(g[cr + vstep, cc])

    # Choose "blue" line color.
    if hcol == 1 or vcol == 1:
        blue_col = 1
        red_col = int(vcol if hcol == 1 else hcol)
    else:
        # Fallback: longer line is blue.
        hlen = 0
        c = int(cc + hstep)
        while 0 <= c < W and int(g[cr, c]) == int(hcol):
            hlen += 1
            c += int(hstep)
        vlen = 0
        r = int(cr + vstep)
        while 0 <= r < H and int(g[r, cc]) == int(vcol):
            vlen += 1
            r += int(vstep)
        if vlen >= hlen:
            blue_col = int(vcol)
            red_col = int(hcol)
        else:
            blue_col = int(hcol)
            red_col = int(vcol)

    blue_orient = "h" if int(hcol) == int(blue_col) else "v"
    red_orient = "h" if int(hcol) == int(red_col) else "v"

    # --- mask out the two edge lines (entire corner row + col) ---
    line_mask = np.zeros((H, W), dtype=bool)
    line_mask[cr, :] = True
    line_mask[:, cc] = True

    # --- extract solid rectangles (no bg inside bbox) ---
    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))
    rects = []
    for coords in components_mask(mask, connectivity=4):
        if coords.size == 0:
            continue
        b = bbox_coords(coords)
        sub = crop_bbox(g, b)
        if bool((sub == int(bg)).any()):
            continue
        rects.append({"box": tuple(map(int, b)), "arr": sub.copy()})

    assert not (not rects)

    def dist_to_edge(rect: dict, orient: str, edge_idx: int) -> int:
        r0, c0, r1, c1 = map(int, rect["box"])
        if orient == "v":
            col = int(edge_idx)
            if int(c0) > col:
                return int(c0 - col - 1)
            if int(c1) < col:
                return int(col - c1 - 1)
            return 0
        row = int(edge_idx)
        if int(r0) > row:
            return int(r0 - row - 1)
        if int(r1) < row:
            return int(row - r1 - 1)
        return 0

    blue_edge_idx = int(cc if blue_orient == "v" else cr)
    red_edge_idx = int(cc if red_orient == "v" else cr)

    def along_from_corner(rect: dict, orient: str) -> int:
        r0, c0, r1, c1 = map(int, rect["box"])
        if orient == "v":
            return int(r0 if cr == 0 else -r1)
        return int(c0 if cc == 0 else -c1)

    for rct in rects:
        rct["db"] = int(dist_to_edge(rct, blue_orient, blue_edge_idx))
        rct["dr"] = int(dist_to_edge(rct, red_orient, red_edge_idx))

    rects.sort(
        key=lambda r: (
            int(r["db"]),
            int(r["dr"]),
            along_from_corner(r, blue_orient),
            along_from_corner(r, red_orient),
        )
    )

    # Rotate all rectangles if blue edge is vertical.
    seq = []
    for rct in rects:
        a = rct["arr"]
        if blue_orient == "v":
            a = np.rot90(a, k=1)  # CCW
        seq.append(a)

    outW = int(max(int(a.shape[1]) for a in seq))
    outH = int(sum(int(a.shape[0]) for a in seq))
    out = np.full((outH, outW), int(bg), dtype=int)

    out_r = 0
    for a in seq:
        h, w = map(int, a.shape)
        out_c = int((outW - w) // 2)
        paste(out, a, int(out_r), int(out_c))
        out_r += int(h)

    return out

# --------------- generator (attempt 3, Codex) ---------------

BG = 8
BLUE = 1
RED = 2
MARKER = 0
DOMINANT_COLORS = np.array([3, 4, 5, 6, 7, 9], dtype=int)
MINORITY_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)


def _transform(grid: np.ndarray, blue_orient: str, corner: str) -> np.ndarray:
    if blue_orient == "h":
        if corner == "tl":
            return grid
        if corner == "tr":
            return np.fliplr(grid)
        if corner == "bl":
            return np.flipud(grid)
        return np.rot90(grid, 2)

    base = np.rot90(grid, 1)
    if corner == "bl":
        return base
    if corner == "tl":
        return np.flipud(base)
    if corner == "tr":
        return np.rot90(grid, 3)
    return np.flipud(np.rot90(grid, 3))


def _distribute_band_widths(count: int, used_target: int) -> list[int]:
    extra_units = (used_target - (4 * count - 2)) // 2
    order = np.random.permutation(count)
    units = np.zeros(count, dtype=int)
    remaining = int(extra_units)
    for i, idx in enumerate(order):
        slots_left = count - i - 1
        lo = max(0, remaining - 3 * slots_left)
        hi = min(3, remaining)
        take = int(np.random.randint(lo, hi + 1))
        units[int(idx)] = take
        remaining -= take
    return [2 + 2 * int(u) for u in units]


def _sprinkle_minorities(patch: np.ndarray, dominant: int) -> np.ndarray:
    area = int(patch.size)
    if area < 8 or np.random.rand() < 0.6:
        return patch

    max_minor = min(3, area // 4)
    if max_minor < 2:
        return patch

    n_minor = int(np.random.randint(2, max_minor + 1))
    n_colors = int(np.random.randint(1, min(2, n_minor) + 1))
    minority_choices = [int(c) for c in MINORITY_COLORS if int(c) != dominant]
    colors = np.random.choice(minority_choices, size=n_colors, replace=False)
    cells = np.random.choice(area, size=n_minor, replace=False)
    flat = patch.reshape(-1)
    for idx, cell in enumerate(cells):
        flat[int(cell)] = int(colors[idx % n_colors])
    return patch


def _build_canonical() -> np.ndarray:
    long_dim = int(np.random.randint(9, 29))
    options = []
    for trailing in (1, 2):
        max_used = long_dim - 2 - trailing
        if max_used < 6 or max_used % 2:
            continue
        max_count = min(5, (max_used + 2) // 4)
        pairs = []
        for a in range(2, max_count + 1):
            for b in range(2, max_count + 1):
                if a + b > 9:
                    continue
                eligible = []
                if max_used <= 10 * a - 2:
                    eligible.append(0)
                if max_used <= 10 * b - 2:
                    eligible.append(1)
                if eligible:
                    pairs.append((a, b, eligible))
        if pairs:
            options.append((max_used, pairs))

    max_used, pairs = options[int(np.random.randint(len(options)))]
    n0, n1, eligible = pairs[int(np.random.randint(len(pairs)))]
    max_band = int(np.random.choice(eligible))
    max0 = min(max_used, 10 * n0 - 2)
    max1 = min(max_used, 10 * n1 - 2)
    used0 = int(max_used if max_band == 0 else np.random.choice(np.arange(4 * n0 - 2, max0 + 1, 2)))
    used1 = int(max_used if max_band == 1 else np.random.choice(np.arange(4 * n1 - 2, max1 + 1, 2)))
    band0 = _distribute_band_widths(n0, used0)
    band1 = _distribute_band_widths(n1, used1)

    grid = np.full((8, long_dim), BG, dtype=int)
    grid[0, :] = BLUE
    grid[:, 0] = RED
    grid[0, 0] = MARKER

    for r0, widths in ((2, band0), (5, band1)):
        c = 2
        for w in widths:
            color = int(np.random.choice(DOMINANT_COLORS))
            patch = np.full((2, w), color, dtype=int)
            patch = _sprinkle_minorities(patch, color)
            paste(grid, patch, r0, c)
            c += w + 2

    return grid


def _gen_attempt() -> np.ndarray | None:
    canonical = _build_canonical()
    blue_orient = str(np.random.choice(["h", "v"]))
    corner = str(np.random.choice(["tl", "tr", "bl", "br"]))
    return _transform(canonical, blue_orient, corner)


def generate_input() -> np.ndarray:
    for _ in range(300):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate input for 291dc1e1")

