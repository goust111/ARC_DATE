+        paths = [_cells(anchor, offsets) for anchor in anchors]
+        if any(any(wall[r, c] for r, c in cells) for cells in paths):
+            continue
+        if any(_near(cells, occupied_by_frame[t], gap=1) for t, cells in enumerate(paths)):
+            continue
