+        color
+        for color in colors
+        if all(np.array_equal(panels[0] == color, panel == color) for panel in panels[1:])
+    ]
+    assert len(static) == 1, "the repeated panels must contain one uniquely static wall"
+    wall_color = int(static[0])
+    wall = panels[0] == wall_color
