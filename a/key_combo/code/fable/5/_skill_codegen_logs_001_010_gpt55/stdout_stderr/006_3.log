+        first = _advance(a0, offsets, initial, shape, wall)
+        if first is None or first[0] != a1:
+            continue
+        second = _advance(a1, offsets, first[1], shape, wall)
+        if second is None or second[0] != a2:
+            continue
+        fourth = _advance(a2, offsets, second[1], shape, wall)
+        if fourth is None:
+            continue
