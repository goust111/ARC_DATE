+    widths = (c0, c1 - c0 - 1, width - c1 - 1)
+    assert widths[0] == widths[1] == widths[2] and widths[0] >= 5
+    panels = [g[:, :c0].copy(), g[:, c0 + 1 : c1].copy(), g[:, c1 + 1 :].copy()]
+    return bg, int(divider), panels
