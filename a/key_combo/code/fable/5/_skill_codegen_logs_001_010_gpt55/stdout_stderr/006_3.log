+
+def _blocked(
+    anchor: Coord,
+    offsets: tuple[Coord, ...],
+    shape: tuple[int, int],
+    wall: np.ndarray,
+) -> tuple[bool, bool, bool]:
+    """Return (blocked, by_boundary, by_wall) in panel-local coordinates."""
+    height, width = shape
+    boundary = False
+    wall_hit = False
+    for r, c in _cells(anchor, offsets):
+        if not (0 <= r < height and 0 <= c < width):
