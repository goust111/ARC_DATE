+        coords = np.argwhere(g == int(color))
+        if coords.size == 0:
+            continue
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        if (r1 - r0, c1 - c0) != (2, 2):
+            continue
+        cells = frozenset((int(r - r0), int(c - c0)) for r, c in coords)
+        shape = _shape_index(cells)
+        if shape is None:
