+
+def _edge_runs(line: np.ndarray, bg: int) -> list[tuple[int, int, int, int]]:
+    runs: list[tuple[int, int, int, int]] = []
+    i = 0
+    n = int(line.shape[0])
+    while i < n:
+        color = int(line[i])
+        if color == bg:
+            i += 1
+            continue
+        j = i + 1
+        while j < n and int(line[j]) == color:
+            j += 1
+        runs.append((i, j - 1, color, j - i))
+        i = j
+    return runs
+
+
+def _find_source(g: np.ndarray, bg: int) -> dict:
+    H, W = g.shape
+    candidates: list[dict] = []
+    edge_specs = (
+        ("top", g[0, :], 0),
+        ("bottom", g[H - 1, :], H - 1),
+        ("left", g[:, 0], 0),
+        ("right", g[:, W - 1], W - 1),
+    )
+    for edge, line, fixed in edge_specs:
+        for start, end, color, length in _edge_runs(line, bg):
+            if length < 3:
+                continue
+            candidates.append(
+                {
+                    "edge": edge,
+                    "line": fixed,
+                    "start": int(start),
+                    "end": int(end),
+                    "color": int(color),
+                    "n": int(length),
+                }
+            )
