+        (n + 5, a, SHAPE_X),
+        (2 * n, b, SHAPE_DIAMOND),
+        (2 * n + 2, a, random.randrange(3)),
+    ]
+    if 2 * n + 2 > depth - 2:
+        return None
+
+    color_i = 0
+    for distance, span_pos, shape in mandatory:
+        center = _center_from(edge, H, W, distance, span_pos)
+        if not _place_token(grid, boxes, center, token_colors[color_i], shape):
+            return None
