+        q: deque[Coord] = deque([(sr, sc)])
+        labels[sr, sc] = cid
+        pts: list[Coord] = []
+        touches = False
+
+        while q:
+            r, c = q.popleft()
+            pts.append((r, c))
+            if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                touches = True
+            for nr, nc in _neighbors4(r, c):
+                if _in_bounds(g.shape, nr, nc) and labels[nr, nc] == -1 and int(g[nr, nc]) == bg:
+                    labels[nr, nc] = cid
+                    q.append((nr, nc))
