+            for _try in range(250):
+                r0 = random.randint(1, h - ph - 1)
+                c0 = random.randint(1, w - pw - 1)
+                box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+                if any(_boxes_too_close(box, old, 1) for old in boxes):
+                    continue
+                grid[r0 : r0 + ph, c0 : c0 + pw] = patch
+                boxes.append(box)
+                placed = True
+                break
+            if not placed:
