+
+def _transform(grid: np.ndarray, rotations: int, mirror: bool) -> np.ndarray:
+    out = np.rot90(grid, rotations)
+    if mirror:
+        out = np.fliplr(out)
+    return out.copy()
+
+
+def _generation_attempt() -> np.ndarray | None:
+    try:
