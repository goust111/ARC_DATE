+    cursor = anchor_lo - 1
+    for color, length in left_runs:
+        for i in range(length):
+            out[path[cursor - i]] = color
+        cursor -= length
+
+    cursor = anchor_hi + 1
+    for color, length in right_runs:
+        for i in range(length):
+            out[path[cursor + i]] = color
+        cursor += length
