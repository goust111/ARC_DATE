+Coord = tuple[int, int]
+TRACK_COLOR = 5
+BACKGROUND = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GENERATION_ATTEMPTS = 400
