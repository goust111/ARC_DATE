+        inp[path[anchor_hi]] = anchor_color
+        for color, (lo, hi) in zip(left_colors, left):
+            for i in range(lo, hi + 1):
+                inp[path[i]] = color
+        for color, (lo, hi) in zip(right_colors, right):
+            for i in range(lo, hi + 1):
+                inp[path[i]] = color
+
+        expected = np.full(shape, BACKGROUND, dtype=int)
+        for cell in path:
