+def _runs_in_path_order(
+    g: np.ndarray,
+    path: list[Coord],
+    start: int,
+    stop: int,
+    anchor_color: int,
+) -> list[tuple[int, int]]:
+    """Read maximal train runs on path[start:stop] in increasing path order."""
+    values = [int(g[path[i]]) for i in range(start, stop)]
+    runs: list[tuple[int, int]] = []
+    i = 0
+    while i < len(values):
