+    left_runs = _runs_in_path_order(g, path, 0, anchor_lo, anchor_color)
+    left_runs.reverse()  # near-to-far when walking away from the anchor
+    right_runs = _runs_in_path_order(g, path, anchor_hi + 1, len(path), anchor_color)
