+        pw = (w - 2) // 3
+        c1, c2 = pw, 2 * pw + 1
+        sep = int(grid[0, c1])
+        if (
+            sep != bg
+            and np.all(grid[:, c1] == sep)
+            and np.all(grid[:, c2] == sep)
+        ):
+            layouts.append(
+                (
+                    [grid[:, :pw], grid[:, pw + 1 : 2 * pw + 1], grid[:, 2 * pw + 2 :]],
+                    "vertical",
+                )
+            )
+
+    if h >= 5 and (h - 2) % 3 == 0:
+        ph = (h - 2) // 3
+        r1, r2 = ph, 2 * ph + 1
+        sep = int(grid[r1, 0])
+        if (
+            sep != bg
+            and np.all(grid[r1, :] == sep)
+            and np.all(grid[r2, :] == sep)
+        ):
