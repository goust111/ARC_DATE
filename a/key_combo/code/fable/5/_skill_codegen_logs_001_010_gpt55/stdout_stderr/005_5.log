+        try:
+            actual_holes, actual_solids = _panel_objects(panel, bg)
+        except AssertionError:
+            return None
+        if actual_holes != holes[i] or [int(obj["area"]) for obj in actual_solids] != areas:
+            return None
+        panels.append(panel)
+        records.append(
