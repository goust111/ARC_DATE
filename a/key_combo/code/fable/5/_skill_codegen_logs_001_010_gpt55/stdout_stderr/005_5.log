+            rank_lanes = [lane for lane in range(4) if lane != pointer_lane]
+            random.shuffle(rank_lanes)
+            trial.append((pointer_lane, rank_lanes))
+        selected_lanes = [trial[t][1][holes[(t - 1) % 3] - 1] for t in range(3)]
+        if len(set(selected_lanes)) == 3:
