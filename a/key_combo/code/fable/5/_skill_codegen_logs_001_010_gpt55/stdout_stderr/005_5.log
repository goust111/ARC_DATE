+    solids_by_panel: list[list[dict[str, object]]] = []
+    colors: list[int] = []
+    for panel in panels:
+        h, solids = _panel_objects(panel, bg)
+        holes.append(h)
+        solids_by_panel.append(solids)
+        colors.append(int(panel[panel != bg][0]))
