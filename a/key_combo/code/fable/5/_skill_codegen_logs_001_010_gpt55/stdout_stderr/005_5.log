+    out = np.full(shape, bg, dtype=int)
+    for target in range(3):
+        rank = ranks_for_target[target]
+        mask = np.asarray(records[target]["solids"][rank - 1], dtype=bool)
+        out[mask] = int(records[target]["color"])
