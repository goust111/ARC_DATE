+def _pointer_patch(holes: int) -> np.ndarray:
+    """Make a visibly framed pointer with exactly `holes` isolated one-cell holes."""
+    width = 2 * holes + 1
+    base = np.ones((3, width), dtype=bool)
+    base[1, 1::2] = False
