+def _split_panels(grid: np.ndarray, bg: int) -> tuple[list[np.ndarray], str]:
+    """Detect the two full separator bars and return three panels in display order."""
+    h, w = grid.shape
+    layouts: list[tuple[list[np.ndarray], str]] = []
