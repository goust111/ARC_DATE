+def _slot_starts(long_side: int) -> list[int]:
+    """Four height-4 slots separated from each other and the panel border."""
+    gaps = [1, 1, 1, 1, 1]
+    for _ in range(long_side - 21):
+        gaps[random.randrange(5)] += 1
+    starts: list[int] = []
+    cursor = gaps[0]
+    for i in range(4):
+        starts.append(cursor)
+        cursor += 4 + gaps[i + 1]
+    return starts
