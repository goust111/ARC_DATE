+        if key not in seen:
+            seen.add(key)
+            bank.append(mask)
+    _SHAPE_CACHE[area] = bank
+    return bank
+
+
+def _free_bbox_positions(reserved: np.ndarray, h: int, w: int) -> list[Coord]:
+    H, W = reserved.shape
