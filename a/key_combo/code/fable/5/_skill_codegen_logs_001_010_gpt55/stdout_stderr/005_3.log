# -- generation --
GEN_RETRIES = 300                   # outer retries for generate_input()

# 8-connectivity structuring element for dilation
_STRUCT8 = generate_binary_structure(2, 2)


# ---------- legend helpers ----------

def _legend_span(hole_count: int) -> int:
    """Width (or height) of a single legend patch along the arrangement axis."""
    return 3 if hole_count == 0 else 2 * hole_count + 1


def _legend_patch(hole_count: int, color: int, arrangement: str) -> np.ndarray:
    """Build a 3xSpan (horizontal) or Spanx3 (vertical) legend patch."""
    span = _legend_span(hole_count)
    if arrangement == "horizontal":
        patch = np.full((3, span), int(color), dtype=int)
        if hole_count:
            patch[1, 1::2] = BG
    else:
        patch = np.full((span, 3), int(color), dtype=int)
        if hole_count:
            patch[1::2, 1] = BG
    return patch


def _line_span(legends: list[tuple[int, int]]) -> int:
    """Total span of legend patches plus 1-cell gaps between them."""
    return sum(_legend_span(h) for h, _ in legends) + len(legends) - 1


def _choose_legends(arrangement: str, max_span: int) -> list[tuple[int, int]]:
    """Pick 2-4 legends with distinct hole counts that fit within max_span."""
    count = random.randint(*LEGEND_COUNT_RANGE)
    combos = [holes for holes in itertools.combinations(range(MAX_HOLE_COUNT), count)
              if sum(_legend_span(h) for h in holes) + count - 1 <= max_span]
    if not combos:
        return _choose_legends(arrangement, max_span + 2)
    holes = list(random.choice(combos))
    random.shuffle(holes)
    colors = random.sample(LEGEND_COLORS, count)
    return list(zip(holes, colors))


def _place_legend_line(
    grid: np.ndarray, legends: list[tuple[int, int]], arrangement: str, r: int, c: int
) -> None:
    """Paste legend patches sequentially along the arrangement axis."""
    rr, cc = int(r), int(c)
    for hole_count, color in legends:
        patch = _legend_patch(hole_count, color, arrangement)
        paste(grid, patch, rr, cc)
        if arrangement == "horizontal":
            cc += patch.shape[1] + 1
        else:
            rr += patch.shape[0] + 1


# ---------- layout helpers ----------

def _layout_full_horizontal(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:
    """Place a full-row horizontal divider with legend panel above or below."""
    legends = _choose_legends("horizontal", FULL_LAYOUT_MAX_SPAN)
    total = _line_span(legends)
    panel_h = random.randint(*PANEL_SIZE_RANGE)
    top = random.choice([True, False])
    c0 = random.randint(1, GRID_SIZE - 1 - total)
    if top:
        div_r = panel_h
        grid[div_r, :] = DIV
        blocked[: div_r + 1, :] = 9
        r0 = random.randint(1, panel_h - 4)
    else:
        div_r = GRID_SIZE - 1 - panel_h
        grid[div_r, :] = DIV
        blocked[div_r:, :] = 9
        r0 = random.randint(div_r + 2, GRID_SIZE - 4)
    _place_legend_line(grid, legends, "horizontal", r0, c0)
    return legends


def _layout_full_vertical(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:
    """Place a full-column vertical divider with legend panel left or right."""
    legends = _choose_legends("vertical", FULL_LAYOUT_MAX_SPAN)
    total = _line_span(legends)
    panel_w = random.randint(*PANEL_SIZE_RANGE)
    left = random.choice([True, False])
    r0 = random.randint(1, GRID_SIZE - 1 - total)
    if left:
        div_c = panel_w
        grid[:, div_c] = DIV
        blocked[:, : div_c + 1] = 9
        c0 = random.randint(1, panel_w - 4)
    else:
        div_c = GRID_SIZE - 1 - panel_w
        grid[:, div_c] = DIV
        blocked[:, div_c:] = 9
        c0 = random.randint(div_c + 2, GRID_SIZE - 4)
    _place_legend_line(grid, legends, "vertical", r0, c0)
    return legends


def _l_corner_geometry(corner: str, panel_h: int, panel_w: int,
                       arrangement: str, total: int) -> tuple:
    """Compute divider pivot and legend placement bounds for an L-corner.

    Returns (dr, dc, r_min, r_max, c_min, c_max) where (dr, dc) is the corner
    pivot of the L-divider and the remaining values bound the legend origin.
    """
    N = GRID_SIZE
    cross_dim = 3 if arrangement == "horizontal" else total
    along_dim = total if arrangement == "horizontal" else 3

    if corner == "tl":
        dr, dc = panel_h, panel_w
        r_min, r_max = 1, panel_h - cross_dim - 1
        c_min, c_max = 1, panel_w - along_dim - 1
    elif corner == "tr":
        dr, dc = panel_h, N - 1 - panel_w
        r_min, r_max = 1, panel_h - cross_dim - 1
        c_min, c_max = dc + 2, N - 1 - along_dim
    elif corner == "bl":
        dr, dc = N - 1 - panel_h, panel_w
        r_min, r_max = dr + 2, N - 1 - cross_dim
        c_min, c_max = 1, panel_w - along_dim - 1
    else:  # br
        dr, dc = N - 1 - panel_h, N - 1 - panel_w
        r_min, r_max = dr + 2, N - 1 - cross_dim
        c_min, c_max = dc + 2, N - 1 - along_dim

    return dr, dc, r_min, r_max, c_min, c_max


def _layout_l(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:
    """Place an L-shaped divider with legend panel in one corner."""
    arrangement = random.choice(["horizontal", "vertical"])
    legends = _choose_legends(arrangement, L_LAYOUT_MAX_SPAN)
    total = _line_span(legends)
    along = total + 2 + random.randint(0, min(L_LAYOUT_EXTRA_PADDING, 27 - (total + 2)))
    cross = random.randint(*PANEL_SIZE_RANGE)
    if arrangement == "horizontal":
        panel_h, panel_w = cross, along
    else:
        panel_h, panel_w = along, cross
    corner = random.choice(["tl", "tr", "bl", "br"])

    dr, dc, r_min, r_max, c_min, c_max = _l_corner_geometry(
        corner, panel_h, panel_w, arrangement, total)

    # Draw divider arms and mark blocked regions per corner
    N = GRID_SIZE
    if corner == "tl":
        grid[dr, : dc + 1] = DIV
        grid[: dr + 1, dc] = DIV
        blocked[:dr, :dc] = 9
        blocked[dr, : dc + 1] = 9
        blocked[: dr + 1, dc] = 9
    elif corner == "tr":
        grid[dr, dc:] = DIV
        grid[: dr + 1, dc] = DIV
        blocked[:dr, dc + 1:] = 9
        blocked[dr, dc:] = 9
        blocked[: dr + 1, dc] = 9
    elif corner == "bl":
        grid[dr, : dc + 1] = DIV
        grid[dr:, dc] = DIV
        blocked[dr + 1:, :dc] = 9
        blocked[dr, : dc + 1] = 9
        blocked[dr:, dc] = 9
    else:  # br
        grid[dr, dc:] = DIV
        grid[dr:, dc] = DIV
        blocked[dr + 1:, dc + 1:] = 9
        blocked[dr, dc:] = 9
        blocked[dr:, dc] = 9

    r0 = random.randint(r_min, r_max)
    c0 = random.randint(c_min, c_max)
    _place_legend_line(grid, legends, arrangement, r0, c0)
    return legends


def _add_layout(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:
    """Randomly choose and apply a divider layout (horizontal/vertical/L)."""
    kind = random.choice(["horizontal", "vertical", "l"])
    if kind == "horizontal":
        return _layout_full_horizontal(grid, blocked)
    if kind == "vertical":
        return _layout_full_vertical(grid, blocked)
    return _layout_l(grid, blocked)


# ---------- sprite generation ----------

def _sprite_area(hole_count: int) -> int:
    """Sample a random sprite area based on hole count."""
    if hole_count == 0:
        return random.randint(*SPRITE_AREA_0)
    elif hole_count <= 2:
        return random.randint(SPRITE_AREA_LOW_MIN, 25 + 10 * hole_count)
    else:
        return random.randint(10 + 2 * hole_count, 20 + 4 * hole_count)


def _place_hole_seeds(hole_count: int, center: int, csz: int, area: int) -> list[tuple[int, int]] | None:
    """Find well-separated seed positions for holes inside the canvas.

    Returns a list of seed coordinates, or None if insufficient seeds found.
    """
    margin = HOLE_SEED_MARGIN
    radius = max(HOLE_SEED_MIN_RADIUS, int(HOLE_SEED_RADIUS_FACTOR * area ** 0.5))
    positions = [(r, c) for r in range(center - radius, center + radius + 1)
                 for c in range(center - radius, center + radius + 1)
                 if margin <= r < csz - margin and margin <= c < csz - margin]
    random.shuffle(positions)
    seeds = []
    for r, c in positions:
        if all(max(abs(r - sr), abs(c - sc)) >= HOLE_SEED_MIN_SEP for sr, sc in seeds):
            seeds.append((r, c))
            if len(seeds) == hole_count:
                return seeds
    return None


def _grow_hole_blobs(seeds: list[tuple[int, int]], hole_count: int,
                     area: int, csz: int) -> set[tuple[int, int]]:
    """Grow irregular blob regions around each hole seed. Returns the full forbidden set."""
    margin = HOLE_SEED_MARGIN
    max_hole = (max(2, area // (hole_count + 2)) if hole_count <= 2
                else max(1, area // (hole_count * 2 + 1)))
    forbidden = set()
    for sr, sc in seeds:
        forbidden.add((sr, sc))
        blob = {(sr, sc)}
        target = random.randint(1, max(1, max_hole))
        while len(blob) < target:
            cands = []
            for r, c in blob:
                for nr, nc in neighbors4(r, c):
                    if not (margin <= nr < csz - margin and margin <= nc < csz - margin):
                        continue
                    if (nr, nc) in forbidden:
                        continue
                    if any((nnr, nnc) in forbidden and (nnr, nnc) not in blob
                           for nnr, nnc in neighbors4(nr, nc)):
                        continue
                    cands.append((nr, nc))
            if not cands:
                break
            p = random.choice(cands)
            forbidden.add(p)
            blob.add(p)
    return forbidden


def _find_start(center: int, csz: int, forbidden: set[tuple[int, int]]) -> tuple[int, int]:
    """Find the nearest non-forbidden cell to the canvas center."""
    if (center, center) not in forbidden:
        return center, center
    for d in range(1, csz):
        for dr in range(-d, d + 1):
            for dc in range(-d, d + 1):
                nr, nc = center + dr, center + dc
                if 0 <= nr < csz and 0 <= nc < csz and (nr, nc) not in forbidden:
                    return nr, nc
    return center, center  # fallback (shouldn't happen)


def _grow_mask(csz: int, area: int, start: tuple[int, int],
               forbidden: set[tuple[int, int]]) -> np.ndarray:
    """Grow a random connected blob of target area, avoiding forbidden cells."""
    mask = np.zeros((csz, csz), dtype=bool)
    sr, sc = start
    mask[sr, sc] = True
    frontier = list(neighbors4(sr, sc))
    filled = 1
    while filled < area and frontier:
        idx = random.randrange(len(frontier))
        frontier[idx], frontier[-1] = frontier[-1], frontier[idx]
        r, c = frontier.pop()
        if not (0 <= r < csz and 0 <= c < csz) or mask[r, c] or (r, c) in forbidden:
            continue
        mask[r, c] = True
        filled += 1
        for nr, nc in neighbors4(r, c):
            if 0 <= nr < csz and 0 <= nc < csz and not mask[nr, nc]:
                frontier.append((nr, nc))
    return mask


def _seal_and_connect(mask: np.ndarray, forbidden: set[tuple[int, int]]) -> np.ndarray:
    """Seal gaps around forbidden cells and keep only the largest connected component."""
    csz = mask.shape[0]
    for _ in range(SEAL_ITERS):
        sealed = False
        for r, c in sorted(forbidden):
            for nr, nc in neighbors4(r, c):
                if 0 <= nr < csz and 0 <= nc < csz and not mask[nr, nc] and (nr, nc) not in forbidden:
                    mask[nr, nc] = True
                    sealed = True
        if not sealed:
            break
    if np.any(mask):
        labeled, n_comp = label_mask(mask)
        if n_comp > 1:
            best = max(range(1, n_comp + 1), key=lambda l: int(np.sum(labeled == l)))
            mask = labeled == best
    return mask


def _crop_and_validate(mask: np.ndarray, forbidden: set[tuple[int, int]],
                       hole_count: int) -> np.ndarray | None:
    """Crop mask to tight bbox (including forbidden cells), validate shape and holes."""
    pts = np.argwhere(mask)
    if len(pts) == 0:
        return None
    rmin, cmin = pts.min(axis=0)
    rmax, cmax = pts.max(axis=0)
    for r, c in forbidden:
        rmin, cmin = min(rmin, r), min(cmin, c)
        rmax, cmax = max(rmax, r), max(cmax, c)
    h, w = rmax - rmin + 1, cmax - cmin + 1
    if h > SPRITE_MAX_H or w > SPRITE_MAX_W or max(h, w) > SPRITE_MAX_ASPECT * min(h, w):
        return None
    cropped = mask[rmin:rmax + 1, cmin:cmax + 1].copy()
    if _hole_count(cropped) != hole_count:
        return None
    return np.where(cropped, GREY, BG).astype(int)


def _make_sprite(hole_count: int) -> np.ndarray | None:
    """Generate a random amorphous grey sprite with the specified number of holes."""
    for _ in range(SPRITE_RETRIES):
        area = _sprite_area(hole_count)
        csz = max(CANVAS_MIN, int(area ** 0.5 * CANVAS_SCALE) + CANVAS_PAD)
        center = csz // 2

        forbidden = set()
        if hole_count > 0:
            seeds = _place_hole_seeds(hole_count, center, csz, area)
            if seeds is None:
                continue
            forbidden = _grow_hole_blobs(seeds, hole_count, area, csz)

        start = _find_start(center, csz, forbidden)
        mask = _grow_mask(csz, area, start, forbidden)
        mask = _seal_and_connect(mask, forbidden)

        result = _crop_and_validate(mask, forbidden, hole_count)
        if result is not None:
            return result
    return None


# ---------- sprite planning & placement ----------

def _sprite_plan(legends: list[tuple[int, int]]) -> list[tuple[int, int | None]]:
    """Build a shuffled list of (hole_count, color_or_None) for all sprites to generate."""
    total = random.randint(*TOTAL_SPRITES_RANGE)
    remaining = total - len(legends)
    max_d = min(MAX_DISTRACTORS, remaining)
    valid_d = [d for d in range(1, max_d + 1)
               if remaining - d <= MAX_EXTRA_PER_LEGEND * len(legends)]
    n_distractors = random.choice(valid_d)
    extra_matches = remaining - n_distractors
    extras = [0] * len(legends)
    for _ in range(extra_matches):
        choices = [i for i, x in enumerate(extras) if x < MAX_EXTRA_PER_LEGEND]
        extras[random.choice(choices)] += 1

    plan = []
    for i, (hole_count, color) in enumerate(legends):
        for _ in range(1 + extras[i]):
            plan.append((hole_count, color))
    legend_holes = {h for h, _ in legends}
    distractor_holes = [h for h in range(MAX_HOLE_COUNT) if h not in legend_holes]
    for _ in range(n_distractors):
        plan.append((random.choice(distractor_holes), None))
    random.shuffle(plan)
    return plan


def _dilate_mask(mask: np.ndarray) -> np.ndarray:
    """8-connectivity dilation of a boolean mask (1-cell padding in all directions)."""
    return binary_dilation(mask, structure=_STRUCT8).astype(bool)


def _random_sprite_location(
    static_blocked: np.ndarray, occupied: np.ndarray, sprite: np.ndarray
) -> tuple[int, int] | None:
    """Find a random valid placement for sprite, avoiding blocked and occupied areas."""
    h, w = sprite.shape
    sprite_mask = sprite == GREY
    occupied_pad = _dilate_mask(occupied != BG)
    N = GRID_SIZE
    candidates = [(r, c) for r in range(N - h + 1) for c in range(N - w + 1)]
    random.shuffle(candidates)
    for r, c in candidates:
        rr0, cc0 = max(0, r - 1), max(0, c - 1)
        rr1, cc1 = min(N, r + h + 1), min(N, c + w + 1)
        if np.any(static_blocked[rr0:rr1, cc0:cc1] != BG):
            continue
        if np.any(occupied_pad[r : r + h, c : c + w] & sprite_mask):
            continue
        return int(r), int(c)
    return None


def _place_sprites(
    grid: np.ndarray, expected: np.ndarray, blocked: np.ndarray, legends: list[tuple[int, int]]
) -> bool:
    """Generate and place all sprites (matches + distractors) onto the grid."""
    items = []
    for hole_count, color in _sprite_plan(legends):
        sprite = _make_sprite(hole_count)
        if sprite is None:
            return False
        items.append((sprite.size, sprite, color))
    items.sort(key=lambda x: x[0], reverse=True)

    occupied = np.zeros_like(grid)
    for _, sprite, color in items:
        loc = _random_sprite_location(blocked, occupied, sprite)
        if loc is None:
            return False
        r, c = loc
        paste(grid, sprite, r, c, transparent=BG)
        paste(occupied, sprite, r, c, transparent=BG)
        if color is not None:
            out_patch = np.where(sprite == GREY, int(color), BG)
            paste(expected, out_patch, r, c, transparent=BG)
    return True


# ---------- top-level generation ----------

def _gen_attempt() -> np.ndarray | None:
    """Single attempt: build layout, place sprites, validate via oracle."""
    N = GRID_SIZE
    grid = np.zeros((N, N), dtype=int)
    expected = np.zeros((N, N), dtype=int)
    blocked = np.zeros((N, N), dtype=int)

    legends = _add_layout(grid, blocked)
    expected[:, :] = grid
    if not _place_sprites(grid, expected, blocked, legends):
        return None
    if int(np.sum(grid == BG)) <= int(np.sum(grid == GREY)):
        return None
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        try:
            grid = _gen_attempt()
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate e3721c99 input")
import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
import random


def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    """Pick a stable anchor bbox inside the sprite array (color-1 pixels; always present)."""
    if np.any(arr == 1):
        ys, xs = np.where(arr == 1)
        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
    assert False, "sprite array has no color-1 pixels and should always have them"


def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    if scale <= 1:
        return arr.copy()
    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Swap every sprite to the opposite prototype while preserving scale and position.

    Input structure:
    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.
    - Each sprite instance is a scaled copy of one of the two prototypes, placed on the grid.

    Rule:
    - Identify the two prototype patterns from the smallest-area sprites.
    - For each sprite, determine which prototype it matches and its integer scale factor.
    - Replace it with the other prototype at the same scale, aligned by an internal anchor region (color-1 pixels).

    Key insight: Every sprite toggles to the alternate prototype; the anchor sub-region inside each sprite pins the alignment so swapped sprites land in the correct position regardless of scale.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)

    comps = components_mask(g != bg, connectivity=8)
    assert len(comps) >= 2, "grid must contain at least 2 sprite components"

    # Extract sprite records.
    sprites = []
    for pts in comps:
        r0, c0, r1, c1 = bbox_coords(pts)
        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})

    # Determine two base prototypes from the smallest bbox area sprites.
    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
    min_area = min(areas)
    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
    uniq: dict[tuple[int, ...], np.ndarray] = {}
    for s in base:
        key = tuple(s["arr"].ravel().tolist())
        if key not in uniq:
            uniq[key] = s["arr"]
    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototype patterns"

    proto_keys = list(uniq.keys())[:2]
    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]

    anc0 = _pick_anchor_bbox(protos[0], bg)
    anc1 = _pick_anchor_bbox(protos[1], bg)
    a0r0, a0c0, a0r1, a0c1 = anc0
    base_anc_h = a0r1 - a0r0 + 1
    base_anc_w = a0c1 - a0c0 + 1

    out = g.copy()

    for s in sprites:
        r0, c0, r1, c1 = s["bbox"]
        arr = s["arr"]
        anc = _pick_anchor_bbox(arr, bg)
        ar0, ac0, ar1, ac1 = anc
        inst_anc_h = ar1 - ar0 + 1
        inst_anc_w = ac1 - ac0 + 1
        # infer integer scale
        scale_h = max(1, inst_anc_h // max(1, base_anc_h))
        scale_w = max(1, inst_anc_w // max(1, base_anc_w))
        scale = int(max(scale_h, scale_w))

        # score which prototype matches this sprite when aligned by core bbox
        best_idx = 0
        best_score = -1
        for idx, p in enumerate(protos):
            sp = _scale_nn(p, scale)
            panc = _pick_anchor_bbox(p, bg)
            pr0, pc0, pr1, pc1 = panc
            pr0 *= scale
            pc0 *= scale
            # align anchor top-left to instance anchor top-left (global coords)
            top = (r0 + ar0) - pr0
            left = (c0 + ac0) - pc0

            # overlap score: count matching non-bg pixels where prototype expects non-bg
            score = 0
            ph, pw = sp.shape
            rr0 = max(0, top)
            cc0 = max(0, left)
            rr1 = min(h, top + ph)
            cc1 = min(w, left + pw)
            if rr0 >= rr1 or cc0 >= cc1:
                continue
            sub_g = g[rr0:rr1, cc0:cc1]
            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
            m = sub_p != bg
            if np.any(m):
                score = int(np.sum(sub_g[m] == sub_p[m]))
            if score > best_score:
                best_score = score
                best_idx = idx

        repl_idx = 1 - best_idx

        # Clear current sprite pixels.
        for rr, cc in s["pts"]:
            out[rr, cc] = bg

        # Place replacement.
        p = protos[repl_idx]
        sp = _scale_nn(p, scale)
        panc = _pick_anchor_bbox(p, bg)
        pr0, pc0, pr1, pc1 = panc
        pr0 *= scale
        pc0 *= scale
        top = (r0 + ar0) - pr0
        left = (c0 + ac0) - pc0

        ph, pw = sp.shape
        rr0 = max(0, top)
        cc0 = max(0, left)
        rr1 = min(h, top + ph)
        cc1 = min(w, left + pw)
        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
        m = sub_p != bg
        out_slice = out[rr0:rr1, cc0:cc1]
        out_slice[m] = sub_p[m]
        out[rr0:rr1, cc0:cc1] = out_slice

    return out

# --------------- generator (o5x) ---------------

# --- CFG: canvas ---
GRID_SIZE_MIN = 18                  # square grid lower bound
GRID_SIZE_MAX = 28                  # square grid upper bound
GRID_MARGIN_FOR_SPRITES = 6         # min_n = max_sprite_dim + this

# --- CFG: prototypes ---
PROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]  # (h, w) choices for label grid
BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9] # bg color pool (excludes 1)
COLOR_SHARE_PROB = 0.65             # prob that proto_B shares a color with proto_A

# --- CFG: row-mask weights (anchor role vs variable role) ---
#   each entry: (mask_type, weight)  where mask_type in {"center", "outer", "full"}
ANCHOR_ROW_WEIGHTS = [("center", 0.45), ("outer", 0.35), ("full", 0.20)]
VARIABLE_ROW_WEIGHTS = [("center", 0.68), ("full", 0.32)]
OUTER_FIXUP_PROB = 0.7             # when fixing no-edge row, prob of using outer vs full

# --- CFG: sprite instances ---
SPRITE_COUNTS = [3, 4]             # number of sprite instances per grid
BIG_SCALES = [2, 3]                # scale factor for the one large sprite

# --- CFG: placement ---
PLACEMENT_BORDER = 1               # min distance from grid edge
PLACEMENT_PADDING = 2              # min gap between sprite bboxes
PLACEMENT_CONNECTIVITY = 8         # connectivity for padding check

# --- CFG: generation retries ---
MAX_RETRIES = 300

# --- Row-mask patterns indexed by width ---
_ROW_MASKS = {
    "center": {3: [0, 1, 0], 4: [0, 1, 1, 0]},
    "outer":  {3: [1, 0, 1], 4: [1, 0, 0, 1]},
    "full":   {3: [1, 1, 1], 4: [1, 1, 1, 1]},
}


def _row_mask(kind: str, w: int) -> list[int]:
    """Return a row occupancy mask of the given kind and width."""
    return list(_ROW_MASKS[kind][w])


def _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:
    """Bounding box of color-1 (anchor) pixels: (r0, c0, r1, c1)."""
    rs, cs = np.where(arr == 1)
    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())


def _scale(arr: np.ndarray, k: int) -> np.ndarray:
    """Nearest-neighbor upscale by integer factor k."""
    if k == 1:
        return arr.copy()
    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)


def _make_labels() -> np.ndarray:
    """Build an (h, w) label grid with roles 1 (anchor), 2, 3 and bg holes (0)."""
    h, w = random.choice(PROTO_SHAPES)

    # Assign row counts per role (each role gets at least 1 row)
    counts = {1: 1, 2: 1, 3: 1}
    if h > 3:
        counts[random.choice([1, 2, 3])] += h - 3
    roles = []
    for role in random.sample([1, 2, 3], 3):
        roles.extend([role] * counts[role])

    # Pick row masks via weighted sampling
    weights_by_role = {
        1: ANCHOR_ROW_WEIGHTS,
        2: VARIABLE_ROW_WEIGHTS,
        3: VARIABLE_ROW_WEIGHTS,
    }
    masks = []
    for role in roles:
        entries = weights_by_role[role]
        kinds, wts = zip(*entries)
        chosen_kind = random.choices(kinds, weights=wts)[0]
        masks.append(_row_mask(chosen_kind, w))

    # Fix-up: ensure at least one row touches the left/right edge
    if not any(mask[0] or mask[-1] for mask in masks):
        i = random.randrange(h)
        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:
            masks[i] = _row_mask("outer", w)
        else:
            masks[i] = _row_mask("full", w)

    # Fix-up: ensure at least one row has bg holes
    if all(all(mask) for mask in masks):
        masks[random.randrange(h)] = _row_mask("center", w)

    # Assemble label grid
    labels = np.zeros((h, w), dtype=int)
    for r, (role, mask) in enumerate(zip(roles, masks)):
        for c, bit in enumerate(mask):
            if bit:
                labels[r, c] = role
    return labels


def _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:
    """Create proto_A and proto_B (flipud + recolored) from a shared label grid."""
    labels = _make_labels()
    pool = [c for c in range(10) if c not in (bg, 1)]
    a_cols = random.sample(pool, 2)
    remaining = [c for c in pool if c not in a_cols]
    if random.random() < COLOR_SHARE_PROB:
        b_cols = [random.choice(a_cols), random.choice(remaining)]
        random.shuffle(b_cols)
    else:
        b_cols = random.sample(remaining, 2)

    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:
        proto = np.full(lab.shape, bg, dtype=int)
        proto[lab == 1] = 1
        proto[lab == 2] = cols[0]
        proto[lab == 3] = cols[1]
        return proto

    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)


def _union_bbox(patch_a: np.ndarray, patch_b: np.ndarray) -> tuple[int, int, int, int]:
    """Compute (dr, dc, union_h, union_w) for anchor-aligned placement of two patches.

    dr, dc: offset from the input patch origin to the output patch origin.
    union_h, union_w: bounding box that encloses both patches when anchor-aligned.
    """
    oa = _anchor_bbox(patch_a)
    ia = _anchor_bbox(patch_b)
    dr = oa[0] - ia[0]
    dc = oa[1] - ia[1]
    h, w = patch_a.shape
    return dr, dc, h + abs(dr), w + abs(dc)


def _gen_attempt() -> np.ndarray | None:
    """Try once to build a valid grid; returns None on placement failure or oracle mismatch."""
    bg = random.choice(BG_CHOICES)
    proto_a, proto_b = _make_prototypes(bg)
    protos = [proto_a, proto_b]

    # Build instance list: 1 of each proto at scale 1, plus 1 at big scale
    count = random.choice(SPRITE_COUNTS)
    big_scale = random.choice(BIG_SCALES)
    instances = [(0, 1), (1, 1), (random.randrange(2), big_scale)]
    if count == 4:
        instances.append((random.randrange(2), 1))
    random.shuffle(instances)
    instances.sort(key=lambda item: item[1], reverse=True)  # place largest first

    max_dim = max(max(protos[typ].shape) * scale for typ, scale in instances)
    n = random.randint(max(GRID_SIZE_MIN, max_dim + GRID_MARGIN_FOR_SPRITES), GRID_SIZE_MAX)
    out = np.full((n, n), bg, dtype=int)
    inp = np.full((n, n), bg, dtype=int)
    reserve = np.full((n, n), bg, dtype=int)

    for out_type, scale in instances:
        output_patch = _scale(protos[out_type], scale)
        input_patch = _scale(protos[1 - out_type], scale)
        dr, dc, uh, uw = _union_bbox(output_patch, input_patch)
        marker = np.full((uh, uw), 1, dtype=int)
        try:
            ur, uc = random_free_location(
                reserve, marker, transparent=bg,
                border=PLACEMENT_BORDER, padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_CONNECTIVITY,
            )
        except ValueError:
            return None

        out_r = ur + max(0, -dr)
        out_c = uc + max(0, -dc)
        in_r, in_c = out_r + dr, out_c + dc

        paste(reserve, marker, ur, uc)
        paste(out, output_patch, out_r, out_c, transparent=bg)
        paste(inp, input_patch, in_r, in_c, transparent=bg)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid c7f57c3e input")
from __future__ import annotations

import numpy as np

from arc_utils import get_bg, in_bounds, neighbors4
import random


Coord = tuple[int, int]


def _unique_marker_color(g: np.ndarray, bg: int) -> int:
    vals, counts = np.unique(g, return_counts=True)
    markers = [int(v) for v, n in zip(vals, counts) if int(n) == 1 and int(v) != bg]
    assert len(markers) == 1, "expected exactly one non-background marker pixel"
    return markers[0]


def _obstacle_color(g: np.ndarray, bg: int, marker: int) -> int:
    colors = {int(v) for v in np.unique(g)}
    obstacles = colors - {int(bg), int(marker)}
    assert len(obstacles) == 1, "expected one obstacle color besides bg and marker"
    return obstacles.pop()


def _adjacent_to_color(g: np.ndarray, pos: Coord, color: int) -> bool:
    return any(
        in_bounds(g.shape, rr, cc) and int(g[rr, cc]) == int(color)
        for rr, cc in neighbors4(*pos)
    )


def _sightline_to_obstacle(
    g: np.ndarray, start: Coord, obstacle: int, bg: int
) -> tuple[Coord, Coord]:
    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    hits: list[tuple[Coord, Coord]] = []
    sr, sc = start

    for dr, dc in dirs:
        r, c = sr + dr, sc + dc
        previous_bg: Coord | None = None
        while in_bounds(g.shape, r, c):
            color = int(g[r, c])
            if color == obstacle:
                assert previous_bg is not None, "marker should not touch obstacle directly"
                hits.append(((dr, dc), previous_bg))
                break
            assert color == bg, "sightline should cross only background before obstacle"
            previous_bg = (r, c)
            r += dr
            c += dc

    assert len(hits) == 1, "expected one cardinal sightline from marker to obstacle"
    return hits[0]


def _walk_contour(g: np.ndarray, start: Coord, direction: Coord, obstacle: int, bg: int) -> Coord:
    dr, dc = direction
    if dr:
        turns = [(dr, -1), (dr, 1)]
    else:
        turns = [(-1, dc), (1, dc)]

    paths: list[tuple[int, Coord]] = []
    for tr, tc in turns:
        r, c = start
        length = 0
        while True:
            nr, nc = r + tr, c + tc
            if not in_bounds(g.shape, nr, nc):
                break
            if int(g[nr, nc]) != bg:
                break
            if not _adjacent_to_color(g, (nr, nc), obstacle):
                break
            r, c = nr, nc
            length += 1
        paths.append((length, (r, c)))

    max_len = max(length for length, _ in paths)
    endpoints = {pos for length, pos in paths if length == max_len}
    assert len(endpoints) == 1, "contour walk should have one structural endpoint"
    return endpoints.pop()


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the single marker to the endpoint reached by sliding along the obstacle contour.

    Input structure:
    - A dominant background color fills the canvas.
    - One single-pixel marker sits away from a connected obstacle region of the
      remaining color.
    - The marker has exactly one horizontal or vertical sightline to the obstacle.

    Rule:
    - Find the last background pixel before the obstacle along that sightline.
    - From that pixel, try the two diagonal turns that continue around the
      obstacle boundary.
    - Move the marker to the endpoint of the turn that remains 4-adjacent to the
      obstacle for the longest distance.

    Key insight:
    The marker is not placed by distance to the obstacle; it first points to the
    obstacle, then follows the visible outside contour until that contour segment ends.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    marker = _unique_marker_color(g, bg)
    obstacle = _obstacle_color(g, bg, marker)

    marker_coords = np.argwhere(g == marker)
    assert marker_coords.shape == (1, 2), "expected exactly one marker pixel"
    marker_pos = tuple(map(int, marker_coords[0]))

    direction, contour_start = _sightline_to_obstacle(g, marker_pos, obstacle, bg)
    assert _adjacent_to_color(g, contour_start, obstacle), "contour must start next to obstacle"
    dest = _walk_contour(g, contour_start, direction, obstacle, bg)
    assert int(g[dest]) == bg, "destination should be background"

    out = g.copy()
    out[marker_pos] = bg
    out[dest] = marker
    return out

# --------------- generator (att2) ---------------

BG_COLOR = 7
GEN_RETRIES = 300

# Obstacle shape bounds.
OBSTACLE_HEIGHT_RANGE = (4, 8)
OBSTACLE_WIDTH_RANGE = (3, 8)
OBSTACLE_AREA_RANGE = (6, 33)
MAX_BOUNDARY_LEFT = 7
BOUNDARY_STEP_PROB = 0.55

# Marker sightline and contour-walk bounds.
WALK_LEN_RANGE = (1, 4)
SIGHTLINE_GAP_RANGE = (2, 5)
CANVAS_SIZE_RANGE = (6, 16)


def _gen_boundary(h: int, start_row: int, walk_len: int, start_left: int) -> list[int]:
    lefts = [0] * h
    lefts[start_row] = start_left

    for r in range(start_row - 1, -1, -1):
        if lefts[r + 1] == 0:
            lefts[r] = 0
        else:
            lefts[r] = lefts[r + 1] - random.randint(0, 1)

    for i in range(1, walk_len + 1):
        lefts[start_row + i] = start_left + i

    stop_row = start_row + walk_len + 1
    if stop_row < h:
        lefts[stop_row] = lefts[stop_row - 1]
        for r in range(stop_row + 1, h):
            if lefts[r - 1] < MAX_BOUNDARY_LEFT and random.random() < BOUNDARY_STEP_PROB:
                lefts[r] = lefts[r - 1] + 1
            else:
                lefts[r] = lefts[r - 1]

    return lefts


def _gen_transform(g: np.ndarray, rotations: int, mirror: bool) -> np.ndarray:
    out = np.rot90(g, rotations)
    if mirror:
        out = np.fliplr(out)
    return out.copy()


def _gen_attempt() -> np.ndarray | None:
    bg = BG_COLOR
    colors = [c for c in range(10) if c != bg]
    obstacle = random.choice(colors)
    marker = random.choice([c for c in colors if c != obstacle])

    h = random.randint(*OBSTACLE_HEIGHT_RANGE)
    walk_len = random.randint(WALK_LEN_RANGE[0], min(WALK_LEN_RANGE[1], h - 3))
    start_row = random.randint(1, h - walk_len - 2)
    gap = random.randint(*SIGHTLINE_GAP_RANGE)

    max_start_left = min(gap, MAX_BOUNDARY_LEFT - walk_len)
    if max_start_left < 1:
        return None
    start_left = random.randint(1, max_start_left)

    lefts = _gen_boundary(h, start_row, walk_len, start_left)
    min_left = min(lefts)
    max_left = max(lefts)
    sum_lefts = sum(lefts)

    w_min = max(
        OBSTACLE_WIDTH_RANGE[0],
        max_left + 1,
        min_left + 3,
        (OBSTACLE_AREA_RANGE[0] + sum_lefts + h - 1) // h,
    )
    w_max = min(OBSTACLE_WIDTH_RANGE[1], (OBSTACLE_AREA_RANGE[1] + sum_lefts) // h)
    if w_min > w_max:
        return None
    w = random.randint(w_min, w_max)
    area = h * w - sum_lefts
    if not (OBSTACLE_AREA_RANGE[0] <= area <= OBSTACLE_AREA_RANGE[1]):
        return None

    c0 = gap - start_left + 1
    min_cols = max(CANVAS_SIZE_RANGE[0], c0 + w)
    possible_cols = [
        cols
        for cols in range(min_cols, CANVAS_SIZE_RANGE[1] + 1)
        if max(CANVAS_SIZE_RANGE[0], h, (2 * area + 2 + cols - 1) // cols) <= CANVAS_SIZE_RANGE[1]
    ]
    if not possible_cols:
        return None
    cols = random.choice(possible_cols)
    min_rows = max(CANVAS_SIZE_RANGE[0], h, (2 * area + 2 + cols - 1) // cols)
    rows = random.randint(min_rows, CANVAS_SIZE_RANGE[1])
    r0 = random.randint(0, rows - h)

    out = np.full((rows, cols), bg, dtype=int)
    for rr, left in enumerate(lefts):
        out[r0 + rr, c0 + left : c0 + w] = obstacle

    contour_start = (r0 + start_row, gap)
    dest = (contour_start[0] + walk_len, contour_start[1] + walk_len)
    marker_pos = (contour_start[0], 0)

    if out[dest] != bg or out[marker_pos] != bg:
        return None

    inp = out.copy()
    inp[marker_pos] = marker
    out[dest] = marker

    rotations = random.randrange(4)
    mirror = random.random() < 0.5
    inp = _gen_transform(inp, rotations, mirror)
    out = _gen_transform(out, rotations, mirror)

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input for 97c75046")
from __future__ import annotations

from collections import deque

import numpy as np

from arc_utils import Color, draw_line, get_bg, neighbors4
import random

Coord = tuple[int, int]


def _gray_path_connects(g: np.ndarray, start: Coord, end: Coord) -> bool:
    seen = {start}
    q = deque([start])

    while q:
        r, c = q.popleft()
        for rr, cc in neighbors4(r, c):
            if not (0 <= rr < g.shape[0] and 0 <= cc < g.shape[1]):
                continue
            p = (int(rr), int(cc))
            if p in seen:
                continue
            if p == end or int(g[rr, cc]) == Color.GREY:
                seen.add(p)
                q.append(p)

    gray_seen = sum(1 for r, c in seen if int(g[r, c]) == Color.GREY)
    return end in seen and gray_seen == int((g == Color.GREY).sum())


def _find_frame_center(g: np.ndarray, control: int) -> Coord:
    centers: list[Coord] = []
    border = np.ones((3, 3), dtype=bool)
    border[1, 1] = False

    for r in range(1, g.shape[0] - 1):
        for c in range(1, g.shape[1] - 1):
            if int(g[r, c]) != int(control):
                continue
            patch = g[r - 1 : r + 2, c - 1 : c + 2]
            if bool((patch[border] == Color.YELLOW).all()):
                centers.append((int(r), int(c)))

    assert len(centers) == 1
    return centers[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the yellow 3x3 frame by the displacement encoded by the gray path, then draw its diagonal yellow corner rays.

    Input structure:
    - The background is black.
    - One 3x3 yellow frame has a non-yellow control-color center.
    - A second control-color pixel is connected through gray path pixels to a lone yellow endpoint.

    Rule:
    - Use the vector from the second control-color pixel to the lone yellow endpoint as the frame's translation.
    - Fill the whole output with the control color.
    - Draw the translated yellow frame and extend yellow diagonal rays outward from its four corners to the grid edge.

    Key insight: The gray path's turns are irrelevant; its two colored endpoints encode the net displacement to apply to the frame.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape

    bg = get_bg(g)
    assert bg == Color.BLACK

    colors = set(map(int, np.unique(g)))
    role_colors = {int(bg), Color.YELLOW, Color.GREY}
    control_colors = colors - role_colors
    assert len(control_colors) == 1
    control = control_colors.pop()
    assert int((g == control).sum()) == 2
    assert int((g == Color.GREY).sum()) > 0

    frame_center = _find_frame_center(g, control)
    fr, fc = frame_center
    frame_yellow = {
        (r, c)
        for r in range(fr - 1, fr + 2)
        for c in range(fc - 1, fc + 2)
        if (r, c) != frame_center
    }

    yellow_cells = set(map(tuple, np.argwhere(g == Color.YELLOW)))
    endpoints = yellow_cells - frame_yellow
    assert len(endpoints) == 1
    endpoint = endpoints.pop()

    control_cells = set(map(tuple, np.argwhere(g == control)))
    path_controls = control_cells - {frame_center}
    assert len(path_controls) == 1
    path_control = path_controls.pop()
    assert _gray_path_connects(g, path_control, endpoint)

    dr = int(endpoint[0] - path_control[0])
    dc = int(endpoint[1] - path_control[1])
    out_center = (int(fr + dr), int(fc + dc))
    r, c = out_center
    assert 1 <= r < H - 1 and 1 <= c < W - 1

    out = np.full_like(g, int(control))
    for rr, cc, direction in (
        (r - 1, c - 1, (-1, -1)),
        (r - 1, c + 1, (-1, 1)),
        (r + 1, c - 1, (1, -1)),
        (r + 1, c + 1, (1, 1)),
    ):
        draw_line(out, rr, cc, direction=direction, color=Color.YELLOW)

    out[r - 1 : r + 2, c - 1 : c + 2] = Color.YELLOW
    out[r, c] = int(control)
    return out

# --------------- generator (o5x) ---------------

# CFG: colors.
FRAME_COLOR = Color.YELLOW
PATH_COLOR = Color.GREY
CONTROL_COLORS = [Color.BLUE, Color.GREEN, Color.PINK, Color.ORANGE, Color.TEAL]

# CFG: canvas and frame placement.
ROW_RANGE, COL_RANGE = (12, 30), (13, 30)
OUTPUT_CENTER_MARGIN, FRAME_EDGE_MARGIN, FRAME_CLEARANCE = 2, 1, 4
FRAME_CORNER_RAYS = ((-1, -1), (-1, 1), (1, -1), (1, 1))

# CFG: displacement and connector-path shape.
DISPLACEMENT_MAG_RANGE = (4, 9)
DIRECT_PATH_MIN_MAG, DETOUR_PATH_MAX_MAG = 5, 7
PATH_LEN_RANGE = (6, 10)
MAX_PATH_TURNS, DETOUR_OFFSETS = 2, (-1, 1)

# CFG: rejection sampling.
MAX_GENERATION_ATTEMPTS = 300


def _sgn(x: int) -> int:
    return 1 if x > 0 else -1


def _path_from_waypoints(waypoints: list[tuple[int, int]]) -> list[tuple[int, int]]:
    r, c = 0, 0
    path = [(r, c)]
    for nr, nc in waypoints:
        if r != nr and c != nc:
            raise ValueError("waypoints must form cardinal segments")
        while r != nr:
            r += _sgn(nr - r)
            path.append((r, c))
        while c != nc:
            c += _sgn(nc - c)
            path.append((r, c))
    return path


def _path_turns(path: list[tuple[int, int]]) -> int:
    dirs: list[tuple[int, int]] = []
    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        dirs.append((_sgn(r1 - r0) if r1 != r0 else 0, _sgn(c1 - c0) if c1 != c0 else 0))
    return sum(1 for a, b in zip(dirs, dirs[1:]) if a != b)


def _path_offsets(dr: int, dc: int) -> list[tuple[int, int]]:
    m = abs(dr) + abs(dc)
    candidates: list[list[tuple[int, int]]] = []

    if m >= DIRECT_PATH_MIN_MAG:
        if dr == 0 or dc == 0:
            candidates.append(_path_from_waypoints([(dr, dc)]))
        else:
            candidates.append(_path_from_waypoints([(dr, 0), (dr, dc)]))
            candidates.append(_path_from_waypoints([(0, dc), (dr, dc)]))
            if abs(dr) >= 2:
                split = random.randint(1, abs(dr) - 1) * _sgn(dr)
                candidates.append(_path_from_waypoints([(split, 0), (split, dc), (dr, dc)]))
            if abs(dc) >= 2:
                split = random.randint(1, abs(dc) - 1) * _sgn(dc)
                candidates.append(_path_from_waypoints([(0, split), (dr, split), (dr, dc)]))

    if m <= DETOUR_PATH_MAX_MAG:
        if dr == 0:
            off = random.choice(DETOUR_OFFSETS)
            candidates.append(_path_from_waypoints([(off, 0), (off, dc), (0, dc)]))
            candidates.append(_path_from_waypoints([(-off, 0), (-off, dc), (0, dc)]))
        elif dc == 0:
            off = random.choice(DETOUR_OFFSETS)
            candidates.append(_path_from_waypoints([(0, off), (dr, off), (dr, 0)]))
            candidates.append(_path_from_waypoints([(0, -off), (dr, -off), (dr, 0)]))
        else:
            sc = _sgn(dc)
            sr = _sgn(dr)
            candidates.append(_path_from_waypoints([(0, -sc), (dr, -sc), (dr, dc)]))
            candidates.append(_path_from_waypoints([(0, dc + sc), (dr, dc + sc), (dr, dc)]))
            candidates.append(_path_from_waypoints([(-sr, 0), (-sr, dc), (dr, dc)]))
            candidates.append(_path_from_waypoints([(dr + sr, 0), (dr + sr, dc), (dr, dc)]))

    valid = [
        p
        for p in candidates
        if PATH_LEN_RANGE[0] <= len(p) <= PATH_LEN_RANGE[1]
        and len(set(p)) == len(p)
        and _path_turns(p) <= MAX_PATH_TURNS
    ]
    if not valid:
        raise ValueError("no valid path shape")
    return random.choice(valid)


def _draw_frame(grid: np.ndarray, r: int, c: int, control: int) -> None:
    grid[r - 1 : r + 2, c - 1 : c + 2] = FRAME_COLOR
    grid[r, c] = int(control)


def _make_output(H: int, W: int, control: int, r: int, c: int) -> np.ndarray:
    out = np.full((H, W), int(control), dtype=int)
    for dr, dc in FRAME_CORNER_RAYS:
        draw_line(out, r + dr, c + dc, direction=(dr, dc), color=FRAME_COLOR)
    _draw_frame(out, r, c, control)
    return out


def _sample_output_scene() -> tuple[int, int, int, int, int, np.ndarray]:
    H, W = random.randint(*ROW_RANGE), random.randint(*COL_RANGE)
    control = random.choice(CONTROL_COLORS)
    out_r = random.randint(OUTPUT_CENTER_MARGIN, H - OUTPUT_CENTER_MARGIN - 1)
    out_c = random.randint(OUTPUT_CENTER_MARGIN, W - OUTPUT_CENTER_MARGIN - 1)
    expected = _make_output(H, W, control, out_r, out_c)
    return H, W, control, out_r, out_c, expected


def _valid_displacements(H: int, W: int, r: int, c: int, mag: int) -> list[tuple[int, int]]:
    choices: list[tuple[int, int]] = []
    for dr in range(-mag, mag + 1):
        dc_abs = mag - abs(dr)
        dc_values = [0] if dc_abs == 0 else [-dc_abs, dc_abs]
        for dc in dc_values:
            fr, fc = r - dr, c - dc
            if FRAME_EDGE_MARGIN <= fr < H - FRAME_EDGE_MARGIN and FRAME_EDGE_MARGIN <= fc < W - FRAME_EDGE_MARGIN:
                choices.append((dr, dc))
    return choices


def _sample_frame_displacement(H: int, W: int, out_r: int, out_c: int) -> tuple[int, int] | None:
    mag = random.randint(*DISPLACEMENT_MAG_RANGE)
    displacements = _valid_displacements(H, W, out_r, out_c, mag)
    if not displacements:
        return None
    return random.choice(displacements)


def _valid_starts(
    H: int,
    W: int,
    offsets: list[tuple[int, int]],
    frame_r: int,
    frame_c: int,
) -> list[tuple[int, int]]:
    rs = [r for r, _ in offsets]
    cs = [c for _, c in offsets]
    r_lo, r_hi = -min(rs), H - 1 - max(rs)
    c_lo, c_hi = -min(cs), W - 1 - max(cs)
    if r_lo > r_hi or c_lo > c_hi:
        return []

    starts: list[tuple[int, int]] = []
    for r0 in range(r_lo, r_hi + 1):
        for c0 in range(c_lo, c_hi + 1):
            ok = True
            for rr, cc in offsets:
                ar, ac = r0 + rr, c0 + cc
                if max(abs(ar - frame_r), abs(ac - frame_c)) < FRAME_CLEARANCE:
                    ok = False
                    break
            if ok:
                starts.append((r0, c0))
    random.shuffle(starts)
    return starts


def _place_path(
    grid: np.ndarray, path_r: int, path_c: int, offsets: list[tuple[int, int]], control: int
) -> None:
    path = [(path_r + rr, path_c + cc) for rr, cc in offsets]
    grid[path[0]] = int(control)
    for cell in path[1:-1]:
        grid[cell] = PATH_COLOR
    grid[path[-1]] = FRAME_COLOR


def _make_input(
    H: int, W: int, control: int, frame_r: int, frame_c: int, offsets: list[tuple[int, int]]
) -> np.ndarray | None:
    starts = _valid_starts(H, W, offsets, frame_r, frame_c)
    if not starts:
        return None

    inp = np.zeros((H, W), dtype=int)
    _draw_frame(inp, frame_r, frame_c, control)
    path_r, path_c = starts[0]
    _place_path(inp, path_r, path_c, offsets, control)
    return inp


def _gen_attempt() -> np.ndarray | None:
    H, W, control, out_r, out_c, expected = _sample_output_scene()

    displacement = _sample_frame_displacement(H, W, out_r, out_c)
    if displacement is None:
        return None
    dr, dc = displacement
    frame_r, frame_c = out_r - dr, out_c - dc
    try:
        offsets = _path_offsets(dr, dc)
    except ValueError:
        return None

    inp = _make_input(H, W, control, frame_r, frame_c, offsets)
    if inp is None:
        return None

    try:
        if np.array_equal(main(inp), expected):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 2b9ef948 input")

