+    bank: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for chosen in combinations(range(SHAPE_SIZE * SHAPE_SIZE), area):
+        mask = np.zeros((SHAPE_SIZE, SHAPE_SIZE), dtype=bool)
+        mask.ravel()[list(chosen)] = True
