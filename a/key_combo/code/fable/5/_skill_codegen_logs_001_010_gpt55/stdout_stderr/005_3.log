+    return positions
+
+
+def _place_footprint(reserved: np.ndarray, h: int, w: int) -> Coord | None:
+    positions = _free_bbox_positions(reserved, h, w)
+    if not positions:
+        return None
+    r, c = random.choice(positions)
+    reserved[r:r + h, c:c + w] = True
+    return r, c
