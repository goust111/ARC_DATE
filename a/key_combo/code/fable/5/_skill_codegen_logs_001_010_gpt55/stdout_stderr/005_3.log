+SHAPE_SIZE = 4
+SHAPE_AREAS = (7, 8, 9)
+FRAME_COUNT_RANGE = (2, 3)
+MAX_GENERATION_ATTEMPTS = 400
+_SHAPE_CACHE: dict[int, list[np.ndarray]] = {}
+
