from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def _ordered_objects(panel: np.ndarray, bg: int) -> list[dict]:
    objects = find_components(panel, bg=bg, connectivity=4, monochromatic=True)
    assert len(objects) == 3, "each panel must contain exactly three monochrome objects"

    objects = sorted(objects, key=lambda obj: obj["bbox"][1])
    previous_right = -1
    for obj in objects:
        _r0, c0, _r1, c1 = obj["bbox"]
        assert c0 > previous_right, "panel objects must be strictly ordered left to right"
        previous_right = c1
    return objects


def main(grid: np.ndarray) -> np.ndarray:
    """
    Combine the left, middle, and right ordered objects from three separated panels.

    Input structure
    - The grid is three HxH panels separated by one-cell vertical separator bars.
    - The background is the dominant color, and each panel contains exactly three same-color 4-connected foreground objects.

    Rule
    - Build a new HxH background canvas.
    - From the left panel copy its leftmost object, from the middle panel copy its middle object, and from the right panel copy its rightmost object.

    Key insight
    - The separator bars create three aligned layers, and the panel's own left-to-right object order selects which object survives in the merged output.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    H, W = g.shape
    assert W == 3 * H + 2, "expected three square panels separated by two columns"

    bg = get_bg(g)
    sep_a = int(g[0, H])
    sep_b = int(g[0, 2 * H + 1])
    assert sep_a == sep_b and sep_a != bg, "separator bars must use the same non-bg color"
    assert bool(np.all(g[:, H] == sep_a)), "first separator column must be solid"
    assert bool(np.all(g[:, 2 * H + 1] == sep_a)), "second separator column must be solid"

    panels = [
        g[:, :H],
        g[:, H + 1 : 2 * H + 1],
        g[:, 2 * H + 2 :],
    ]
    assert all(panel.shape == (H, H) for panel in panels), "panels must be HxH"

    out = np.full((H, H), bg, dtype=int)
    for panel_index, panel in enumerate(panels):
        obj = _ordered_objects(panel, bg)[panel_index]
        color = int(obj["color"])
        for r, c in obj["coords"]:
            rr, cc = int(r), int(c)
            assert out[rr, cc] == bg, "selected objects must not overlap"
            out[rr, cc] = color

    return out

# --------------- generator (att2) ---------------

# Canvas and palette values observed in the task.
_BG = 7
_SEP = 6
_COLORS = [0, 1, 2, 3, 4, 5, 8, 9]

# Panel geometry and object ordering.
_GRID_SIZES = [5, 6]
_N_PANELS = 3
_OBJECTS_PER_PANEL = 3
_DISTRACTOR_KEYS = [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)]

# Object-size, density, and color-reuse controls.
_MAX_OBJECT_AREA = 8
_AREA_BUDGET_BY_SIZE = {5: 56, 6: 72}
_MAX_COLOR_REUSES = 2

# Random-growth shape controls.
_FRONTIER_COMPACT_BIAS = 0.35
_FRONTIER_COMPACT_TOP_K = 3
_NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Retry limit for rejecting failed growth or oracle mismatches.
_MAX_ATTEMPTS = 300


def _segments(H: int) -> list[tuple[int, int]]:
    a, b = sorted(random.sample(range(1, H), 2))
    return [(0, a - 1), (a, b - 1), (b, H - 1)]


def _object_patch(H: int, cols: tuple[int, int], color: int, area: int) -> np.ndarray | None:
    c0, c1 = cols
    W = c1 - c0 + 1
    target = int(area)
    if target < 1 or target > H * W:
        return None

    start = (random.randrange(H), random.randrange(W))
    cells = {start}
    frontier: set[tuple[int, int]] = set()

    def add_frontier(r: int, c: int) -> None:
        for dr, dc in _NEIGHBOR_DELTAS:
            rr, cc = r + dr, c + dc
            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in cells:
                frontier.add((rr, cc))

    add_frontier(*start)
    while len(cells) < target:
        if not frontier:
            return None
        if random.random() < _FRONTIER_COMPACT_BIAS:
            options = sorted(
                frontier,
                key=lambda rc: sum(
                    (rc[0] + dr, rc[1] + dc) in cells for dr, dc in _NEIGHBOR_DELTAS
                ),
                reverse=True,
            )
            top_k = max(1, min(_FRONTIER_COMPACT_TOP_K, len(options)))
            cell = random.choice(options[:top_k])
        else:
            cell = random.choice(tuple(frontier))
        frontier.remove(cell)
        cells.add(cell)
        add_frontier(*cell)

    patch = np.full((H, H), _BG, dtype=int)
    for r, c in cells:
        patch[r, c0 + c] = int(color)
    return patch


def _choose_area(H: int, cols: tuple[int, int], budget: int, remaining_slots: int) -> int | None:
    width = cols[1] - cols[0] + 1
    high = min(_MAX_OBJECT_AREA, H * width, budget - (remaining_slots - 1))
    if high < 1:
        return None
    return random.randint(1, high)


def _assign_colors(selected: list[int]) -> dict[tuple[int, int], int] | None:
    colors = {(i, i): int(selected[i]) for i in range(_OBJECTS_PER_PANEL)}
    used_by_panel = [set() for _ in range(_N_PANELS)]
    counts = {c: 0 for c in _COLORS}
    for i, color in enumerate(selected):
        used_by_panel[i].add(int(color))
        counts[int(color)] += 1

    distractors = list(_DISTRACTOR_KEYS)
    random.shuffle(distractors)
    for panel_i, obj_i in distractors:
        options = [
            color
            for color in _COLORS
            if counts[color] < _MAX_COLOR_REUSES and color not in used_by_panel[panel_i]
        ]
        if not options:
            return None
        color = random.choice(options)
        colors[(panel_i, obj_i)] = color
        used_by_panel[panel_i].add(color)
        counts[color] += 1
    return colors


def _sample_patch(H: int, segs: list[tuple[int, int]], obj_i: int, color: int, budget: int, remaining: int):
    area = _choose_area(H, segs[obj_i], budget, remaining)
    if area is None:
        return None
    patch = _object_patch(H, segs[obj_i], color, area)
    if patch is None:
        return None
    return patch, budget - area, remaining - 1


def _sample_objects(H: int, segs: list[tuple[int, int]], selected_colors: list[int], colors):
    """Return all panel objects plus the expected merged output."""
    budget = _AREA_BUDGET_BY_SIZE[H]
    remaining = _N_PANELS * _OBJECTS_PER_PANEL
    objects: dict[tuple[int, int], np.ndarray] = {}
    out = np.full((H, H), _BG, dtype=int)

    for i in range(_OBJECTS_PER_PANEL):
        sampled = _sample_patch(H, segs, i, selected_colors[i], budget, remaining)
        if sampled is None:
            return None
        patch, budget, remaining = sampled
        objects[(i, i)] = patch
        paste(out, patch, 0, 0, transparent=_BG)

    for panel_i, obj_i in _DISTRACTOR_KEYS:
        sampled = _sample_patch(H, segs, obj_i, colors[(panel_i, obj_i)], budget, remaining)
        if sampled is None:
            return None
        patch, budget, remaining = sampled
        objects[(panel_i, obj_i)] = patch
    return objects, out


def _render_input(H: int, objects: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    """Render all objects into three panels separated by solid bars."""
    inp = np.full((H, _N_PANELS * H + (_N_PANELS - 1)), _BG, dtype=int)
    for sep_i in range(1, _N_PANELS):
        inp[:, sep_i * H + (sep_i - 1)] = _SEP
    for panel_i in range(_N_PANELS):
        panel = np.full((H, H), _BG, dtype=int)
        for obj_i in range(_OBJECTS_PER_PANEL):
            paste(panel, objects[(panel_i, obj_i)], 0, 0, transparent=_BG)
        paste(inp, panel, 0, panel_i * (H + 1))
    return inp


def _passes_oracle(inp: np.ndarray, expected: np.ndarray) -> bool:
    try:
        actual = main(inp)
    except AssertionError:
        return False
    return bool(np.array_equal(actual, expected))


def _gen_attempt() -> np.ndarray | None:
    H = random.choice(_GRID_SIZES)
    segs = _segments(H)
    selected_colors = random.sample(_COLORS, _OBJECTS_PER_PANEL)
    colors = _assign_colors(selected_colors)
    if colors is None:
        return None

    sampled = _sample_objects(H, segs, selected_colors, colors)
    if sampled is None:
        return None

    objects, out = sampled
    inp = _render_input(H, objects)
    if _passes_oracle(inp, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input for 5ecac7f7")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, get_bg
import math
import random


def _foreground_bands(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
    bands: list[tuple[int, int, int]] = []
    for color in colors_present(g, exclude={bg}):
        cols = np.where(g == color)[1]
        c0, c1 = int(cols.min()), int(cols.max())
        region_colors = {int(v) for v in np.unique(g[:, c0 : c1 + 1])}
        assert region_colors <= {int(bg), int(color)}, "each band must contain only its own color and bg"
        assert np.any(g[:, c0 : c1 + 1] == bg), "each band must have bg cells to fill"
        bands.append((c0, c1, int(color)))

    assert len(bands) >= 2, "expected multiple foreground bands"
    bands.sort(key=lambda item: item[0])
    for left, right in zip(bands, bands[1:]):
        assert left[1] < right[0], "foreground bands must be non-overlapping"
    return bands


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill each vertical foreground band's background cells with the color of the next band to its right.

    Input structure
    - The dominant color is the background.
    - Each other color occupies a separate vertical band defined by that color's
      minimum and maximum columns.
    - Within a band, all cells are either that band's color or background.

    Rule
    - Order the bands from left to right.
    - In each band, replace background pixels with the color of the next band in
      that order, wrapping from the rightmost band back to the leftmost.
    - Preserve all existing foreground pixels and all background pixels outside
      the bands.

    Key insight
    - The column bands form a cyclic palette legend: a band's gaps are completed
      by borrowing the color from its right-hand neighbor, not by changing the
      band's existing pixels.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    bands = _foreground_bands(g, bg)

    out = g.copy()
    for index, (c0, c1, _color) in enumerate(bands):
        fill_color = bands[(index + 1) % len(bands)][2]
        band = out[:, c0 : c1 + 1]
        band[band == bg] = fill_color

    return out

# --------------- generator (att2) ---------------

# Canvas bounds.
GRID_ROWS_RANGE = (8, 12)
GRID_COLS_RANGE = (7, 10)
# Band structure and foreground occupancy.
BAND_COUNT = 3
BAND_WIDTH_RANGE = (1, 3)
BAND_DENSITY_RANGE = (0.30, 0.75)
# Palette and retry budget.
PALETTE_SIZE = 4
MAX_GENERATION_ATTEMPTS = 300


def _gen_band_widths(total_cols: int, band_count: int) -> list[int] | None:
    band_cols = total_cols - (band_count - 1)
    options: list[tuple[int, ...]] = []
    min_width, max_width = BAND_WIDTH_RANGE

    def rec(prefix: list[int], remaining: int) -> None:
        if len(prefix) == band_count:
            if remaining == 0:
                options.append(tuple(prefix))
            return
        slots_left = band_count - len(prefix) - 1
        for width in range(min_width, max_width + 1):
            remainder = remaining - width
            if min_width * slots_left <= remainder <= max_width * slots_left:
                rec([*prefix, width], remainder)

    rec([], band_cols)
    if not options:
        return None
    return list(random.choice(options))


def _gen_fill_band(grid: np.ndarray, c0: int, width: int, color: int) -> None:
    rows = grid.shape[0]
    area = rows * width
    min_density, max_density = BAND_DENSITY_RANGE
    min_fg = max(width, math.ceil(min_density * area))
    max_fg = max(min_fg, math.floor(max_density * area))
    fg_count = random.randint(min_fg, max_fg)

    required = {(random.randrange(rows), c0 + dc) for dc in range(width)}
    cells = [(r, c0 + dc) for r in range(rows) for dc in range(width)]
    remaining = [cell for cell in cells if cell not in required]
    chosen = set(required)
    chosen.update(random.sample(remaining, fg_count - len(required)))
    for r, c in chosen:
        grid[r, c] = color


def _gen_expected_output(
    grid: np.ndarray, bands: list[tuple[int, int, int]], bg: int
) -> np.ndarray:
    out = grid.copy()
    for i, (c0, c1, _color) in enumerate(bands):
        fill_color = bands[(i + 1) % len(bands)][2]
        band = out[:, c0 : c1 + 1]
        band[band == bg] = fill_color
    return out


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*GRID_ROWS_RANGE)
    cols = random.randint(*GRID_COLS_RANGE)
    band_count = BAND_COUNT
    widths = _gen_band_widths(cols, band_count)
    if widths is None:
        return None

    colors = random.sample(range(10), PALETTE_SIZE)
    bg, *fg_colors = colors
    grid = np.full((rows, cols), bg, dtype=int)

    bands: list[tuple[int, int, int]] = []
    col = 0
    for i, (width, color) in enumerate(zip(widths, fg_colors)):
        _gen_fill_band(grid, col, width, color)
        bands.append((col, col + width - 1, color))
        col += width
        if i != band_count - 1:
            col += 1

    if col != cols:
        return None

    expected = _gen_expected_output(grid, bands, bg)
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
import random


Coord = tuple[int, int]


def _claim(g: np.ndarray, claims: dict[Coord, int], coord: Coord, color: int, bg: int) -> None:
    h, w = g.shape
    r, c = coord
    assert 0 <= r < h and 0 <= c < w, (coord, g.shape)
    assert int(g[r, c]) in (bg, color), (coord, int(g[r, c]), bg, color)
    previous = claims.get(coord)
    assert previous is None or previous == color, (coord, previous, color)
    claims[coord] = color


def _claim_range(
    g: np.ndarray,
    claims: dict[Coord, int],
    start: Coord,
    end: Coord,
    step: Coord,
    skip: Coord,
    color: int,
    bg: int,
) -> None:
    r, c = start
    er, ec = end
    dr, dc = step
    while True:
        if (r, c) != skip:
            _claim(g, claims, (r, c), color, bg)
        if (r, c) == (er, ec):
            break
        r += dr
        c += dc


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend each solid foreground rectangle toward its same-color isolated pixels with capped one-cell paths, clearing each original marker pixel.

    Input structure
    - The background is the dominant color.
    - Each foreground color has exactly one solid rectangular object and one or more isolated same-color marker pixels.
    - Every marker is horizontally or vertically aligned with the rectangle bbox and lies outside it.
    Rule
    - For each marker, draw a one-cell-wide straight path from the adjacent side of the rectangle through one cell beyond the marker.
    - Add a three-pixel perpendicular cap at the rectangle end and around the marker endpoint.
    - Recolor the original marker pixel to background.
    Key insight
    - The isolated pixels are not copied; they mark the hollow endpoints of capped protrusions grown from their matching rectangle.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert components

    by_color: dict[int, list[dict]] = {}
    for comp in components:
        by_color.setdefault(int(comp["color"]), []).append(comp)

    claims: dict[Coord, int] = {}
    clears: set[Coord] = set()

    for color, comps in by_color.items():
        rectangles = [comp for comp in comps if int(comp["area"]) > 1]
        markers = [comp for comp in comps if int(comp["area"]) == 1]
        assert len(rectangles) == 1, (color, [(comp["area"], comp["bbox"]) for comp in comps])
        assert markers and len(rectangles) + len(markers) == len(comps)

        rect = rectangles[0]
        r0, c0, r1, c1 = map(int, rect["bbox"])
        rect_h = r1 - r0 + 1
        rect_w = c1 - c0 + 1
        assert int(rect["area"]) == rect_h * rect_w
        assert min(rect_h, rect_w) >= 2

        for marker in markers:
            mr, mc = map(int, marker["coords"][0])
            horizontal = r0 <= mr <= r1 and (mc < c0 or mc > c1)
            vertical = c0 <= mc <= c1 and (mr < r0 or mr > r1)
            assert horizontal ^ vertical, (color, (mr, mc), rect["bbox"])

            if horizontal:
                dc = -1 if mc < c0 else 1
                side_c = c0 - 1 if dc < 0 else c1 + 1
                for rr in (mr - 1, mr, mr + 1):
                    _claim(g, claims, (rr, side_c), color, bg)
                for rr in (mr - 1, mr + 1):
                    _claim(g, claims, (rr, mc), color, bg)
                _claim_range(
                    g,
                    claims,
                    (mr, side_c),
                    (mr, mc + dc),
                    (0, dc),
                    (mr, mc),
                    color,
                    bg,
                )
            else:
                dr = -1 if mr < r0 else 1
                side_r = r0 - 1 if dr < 0 else r1 + 1
                for cc in (mc - 1, mc, mc + 1):
                    _claim(g, claims, (side_r, cc), color, bg)
                for cc in (mc - 1, mc + 1):
                    _claim(g, claims, (mr, cc), color, bg)
                _claim_range(
                    g,
                    claims,
                    (side_r, mc),
                    (mr + dr, mc),
                    (dr, 0),
                    (mr, mc),
                    color,
                    bg,
                )

            clears.add((mr, mc))

    assert not (set(claims) & clears)

    out = g.copy()
    for (r, c), color in claims.items():
        out[r, c] = color
    for r, c in clears:
        out[r, c] = bg
    return out

# --------------- generator (att2) ---------------

GRID_ROWS = (13, 30)
GRID_COLS = (16, 30)
PALETTE = tuple(range(10))
FOREGROUND_COLOR_COUNT = (1, 3)
RECT_SIZE = (2, 11)
MARKER_COUNT = (1, 3)
MARKER_DISTANCE = (3, 10)
SAME_SIDE_MARKER_GAP = 3
SIDES = ("top", "bottom", "left", "right")
PATCH_ATTEMPTS = 80
PLACEMENT_ATTEMPTS = 30
GENERATE_ATTEMPTS = 300

def _gen_marker_cells(rect_h: int, rect_w: int, side: str, offset: int, dist: int):
    cells: set[tuple[int, int]] = set()
    if side == "top":
        marker = (-dist, offset)
        for cc in range(offset - 1, offset + 2):
            cells.add((-1, cc))
        for rr in range(-1, -dist - 2, -1):
            if rr != marker[0]:
                cells.add((rr, offset))
        cells.add((marker[0], offset - 1))
        cells.add((marker[0], offset + 1))
    elif side == "bottom":
        marker = (rect_h - 1 + dist, offset)
        for cc in range(offset - 1, offset + 2):
            cells.add((rect_h, cc))
        for rr in range(rect_h, marker[0] + 2):
            if rr != marker[0]:
                cells.add((rr, offset))
        cells.add((marker[0], offset - 1))
        cells.add((marker[0], offset + 1))
    elif side == "left":
        marker = (offset, -dist)
        for rr in range(offset - 1, offset + 2):
            cells.add((rr, -1))
        for cc in range(-1, -dist - 2, -1):
            if cc != marker[1]:
                cells.add((offset, cc))
        cells.add((offset - 1, marker[1]))
        cells.add((offset + 1, marker[1]))
    else:
        marker = (offset, rect_w - 1 + dist)
        for rr in range(offset - 1, offset + 2):
            cells.add((rr, rect_w))
        for cc in range(rect_w, marker[1] + 2):
            if cc != marker[1]:
                cells.add((offset, cc))
        cells.add((offset - 1, marker[1]))
        cells.add((offset + 1, marker[1]))
    return marker, cells


def _updated_margins(
    margins: tuple[int, int, int, int],
    side: str,
    dist: int,
) -> tuple[int, int, int, int]:
    top_extra, bottom_extra, left_extra, right_extra = margins
    if side == "top":
        top_extra = max(top_extra, dist + 1)
    elif side == "bottom":
        bottom_extra = max(bottom_extra, dist + 1)
    elif side == "left":
        left_extra = max(left_extra, dist + 1)
    else:
        right_extra = max(right_extra, dist + 1)
    return top_extra, bottom_extra, left_extra, right_extra


def _gen_marker_options(grid_h, grid_w, rect_h, rect_w, side_offsets, margins, markers, protrusions):
    options = []
    for side in SIDES:
        offsets = range(1, rect_w - 1) if side in ("top", "bottom") else range(1, rect_h - 1)
        for offset in offsets:
            if any(abs(offset - old) < SAME_SIDE_MARKER_GAP for old in side_offsets[side]):
                continue
            for dist in range(MARKER_DISTANCE[0], MARKER_DISTANCE[1] + 1):
                next_margins = _updated_margins(margins, side, dist)
                ntop, nbottom, nleft, nright = next_margins
                if ntop + rect_h + nbottom > grid_h:
                    continue
                if nleft + rect_w + nright > grid_w:
                    continue
                marker, cells = _gen_marker_cells(rect_h, rect_w, side, offset, dist)
                if marker in protrusions:
                    continue
                if any(cell in markers for cell in cells):
                    continue
                if protrusions & cells:
                    continue
                options.append((side, offset, dist, marker, cells, next_margins))
    return options


def _gen_make_patch(grid_h: int, grid_w: int, color: int, bg: int):
    for _ in range(PATCH_ATTEMPTS):
        rect_h = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_h))
        rect_w = random.randint(RECT_SIZE[0], min(RECT_SIZE[1], grid_w))
        if rect_h == 2 and rect_w == 2:
            continue

        marker_n = random.randint(MARKER_COUNT[0], MARKER_COUNT[1])
        side_offsets: dict[str, list[int]] = {side: [] for side in SIDES}
        margins = (0, 0, 0, 0)
        markers: list[tuple[int, int]] = []
        protrusions: set[tuple[int, int]] = set()

        for _marker_i in range(marker_n):
            options = _gen_marker_options(
                grid_h,
                grid_w,
                rect_h,
                rect_w,
                side_offsets,
                margins,
                markers,
                protrusions,
            )

            if not options:
                break
            side, offset, _dist, marker, cells, margins = random.choice(options)
            side_offsets[side].append(offset)
            markers.append(marker)
            protrusions.update(cells)
        else:
            rect_cells = {(r, c) for r in range(rect_h) for c in range(rect_w)}
            marker_cells = set(markers)
            if protrusions & rect_cells or protrusions & marker_cells:
                continue

            reserved_cells = rect_cells | marker_cells | protrusions
            rows = [r for r, _c in reserved_cells]
            cols = [c for _r, c in reserved_cells]
            min_r, max_r = min(rows), max(rows)
            min_c, max_c = min(cols), max(cols)
            patch_h = max_r - min_r + 1
            patch_w = max_c - min_c + 1
            if patch_h > grid_h or patch_w > grid_w:
                continue

            out_patch = np.full((patch_h, patch_w), bg, dtype=int)
            inp_patch = np.full((patch_h, patch_w), bg, dtype=int)
            reserve_patch = np.full((patch_h, patch_w), bg, dtype=int)
            for r, c in rect_cells | protrusions:
                out_patch[r - min_r, c - min_c] = color
            for r, c in rect_cells | marker_cells:
                inp_patch[r - min_r, c - min_c] = color
            for r, c in reserved_cells:
                reserve_patch[r - min_r, c - min_c] = color
            return out_patch, inp_patch, reserve_patch
    return None


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(GRID_ROWS[0], GRID_ROWS[1])
    w = random.randint(GRID_COLS[0], GRID_COLS[1])
    bg = random.choice(PALETTE)
    colors = random.sample(
        [c for c in PALETTE if c != bg],
        random.randint(FOREGROUND_COLOR_COUNT[0], FOREGROUND_COLOR_COUNT[1]),
    )

    out = np.full((h, w), bg, dtype=int)
    inp = np.full((h, w), bg, dtype=int)
    reserved = np.full((h, w), bg, dtype=int)

    for color in colors:
        for _ in range(PLACEMENT_ATTEMPTS):
            patches = _gen_make_patch(h, w, color, bg)
            if patches is None:
                continue
            out_patch, inp_patch, reserve_patch = patches
            try:
                r0, c0 = random_free_location(reserved, reserve_patch, transparent=bg)
            except ValueError:
                continue
            paste(out, out_patch, r0, c0, transparent=bg)
            paste(inp, inp_patch, r0, c0, transparent=bg)
            paste(reserved, reserve_patch, r0, c0, transparent=bg)
            break
        else:
            return None

    counts = np.bincount(inp.ravel(), minlength=10)
    if counts[bg] <= max(counts[c] for c in range(10) if c != bg):
        return None

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATE_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input failed after {GENERATE_ATTEMPTS} attempts")
import numpy as np

from arc_utils import find_components, get_bg
import random


def _is_solid_rect(g: np.ndarray, comp: dict) -> bool:
    r0, c0, r1, c1 = comp["bbox"]
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    return comp["area"] == h * w and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == comp["color"])


def main(grid: np.ndarray) -> np.ndarray:
    """Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.

    Input structure
    - A dominant background contains exactly two solid, same-sized monochromatic rectangles.
    - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.

    Rule
    - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.
    - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.
    - When the gap length is odd, leave the center row/column as background.

    Key insight
    - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert len(comps) == 2
    assert all(_is_solid_rect(g, comp) for comp in comps)

    a, b = comps
    ar0, ac0, ar1, ac1 = a["bbox"]
    br0, bc0, br1, bc1 = b["bbox"]
    assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)

    same_rows = (ar0, ar1) == (br0, br1)
    same_cols = (ac0, ac1) == (bc0, bc1)
    assert same_rows != same_cols

    out = g.copy()
    if same_rows:
        left, right = sorted(comps, key=lambda comp: comp["bbox"][1])
        _lr0, _lc0, _lr1, lc1 = left["bbox"]
        _rr0, rc0, _rr1, _rc1 = right["bbox"]
        gap = rc0 - lc1 - 1
        assert gap >= 1
        span = gap // 2
        out[:, lc1 + 1 : lc1 + 1 + span] = left["color"]
        out[:, rc0 - span : rc0] = right["color"]
    else:
        top, bottom = sorted(comps, key=lambda comp: comp["bbox"][0])
        _tr0, _tc0, tr1, _tc1 = top["bbox"]
        br0, _bc0, _br1, _bc1 = bottom["bbox"]
        gap = br0 - tr1 - 1
        assert gap >= 1
        span = gap // 2
        out[tr1 + 1 : tr1 + 1 + span, :] = top["color"]
        out[br0 - span : br0, :] = bottom["color"]
    return out

# --------------- generator (att2) ---------------

# Layout ranges and bounds.
ALIGNMENTS = ("H", "V")
RECT_PERP_BOUNDS = (1, 4)
RECT_AXIAL_VALUES = range(1, 3)
GAP_VALUES = range(6, 17)
AXIAL_BOUNDS = (14, 22)
MARGIN = 1
PALETTE = tuple(range(10))
MAX_GENERATION_ATTEMPTS = 300
VALID_AXIAL_GAP_PAIRS = tuple(
    (rect_axial, gap)
    for rect_axial in RECT_AXIAL_VALUES
    for gap in GAP_VALUES
    if AXIAL_BOUNDS[0] <= 2 * rect_axial + gap + 2 * MARGIN <= AXIAL_BOUNDS[1]
)


def _choose_layout() -> tuple[str, int, int, int]:
    alignment = random.choice(ALIGNMENTS)
    rect_perp = random.randint(*RECT_PERP_BOUNDS)
    rect_axial, gap = random.choice(VALID_AXIAL_GAP_PAIRS)
    return alignment, rect_perp, rect_axial, gap


def _choose_colors() -> tuple[int, int, int]:
    bg = random.choice(PALETTE)
    color_a, color_b = random.sample([color for color in PALETTE if color != bg], 2)
    return bg, color_a, color_b


def _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:
    """Build the horizontal input/output pair; vertical cases are its transpose."""
    perp = rect_perp + 2 * MARGIN
    axial = 2 * rect_axial + gap + 2 * MARGIN
    left_c0 = MARGIN
    left_c1 = left_c0 + rect_axial - 1
    right_c1 = axial - MARGIN - 1
    right_c0 = right_c1 - rect_axial + 1
    row0 = MARGIN
    row1 = row0 + rect_perp - 1

    out = np.full((perp, axial), bg, dtype=int)
    out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a
    out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b

    span = gap // 2
    out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a
    out[:, right_c0 - span : right_c0] = color_b

    inp = out.copy()
    inp[:, left_c1 + 1 : right_c0] = bg
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    alignment, rect_perp, rect_axial, gap = _choose_layout()
    bg, color_a, color_b = _choose_colors()
    inp, out = _render_horizontal(rect_perp, rect_axial, gap, bg, color_a, color_b)
    if alignment == "V":
        inp = inp.T.copy()
        out = out.T.copy()

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid d968ffd4 input")

