+    return grid
+
+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, semantically checked input grid of at most 30x30."""
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generation_attempt()
+        if grid is not None:
