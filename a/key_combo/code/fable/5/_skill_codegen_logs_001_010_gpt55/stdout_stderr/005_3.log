+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as (N, 2) arrays of (r, c)."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    result: list[np.ndarray] = []
+    for r0, c0 in np.argwhere(mask):
+        r0, c0 = int(r0), int(c0)
+        if seen[r0, c0]:
+            continue
+        seen[r0, c0] = True
+        stack = [(r0, c0)]
+        cells: list[Coord] = []
+        while stack:
+            r, c = stack.pop()
+            cells.append((r, c))
+            for dr, dc in NEIGHBORS4:
