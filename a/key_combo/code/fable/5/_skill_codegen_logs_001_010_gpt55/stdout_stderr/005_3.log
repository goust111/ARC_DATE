+
+
+def _independent_oracle(
+    inp: np.ndarray,
+    bg: int,
+    cavity_coords: list[np.ndarray],
+    sprite_coords: list[np.ndarray],
+    sprite_assignment: list[int | None],
+    sprite_colors: list[int],
