+    out = np.zeros((h // 2, w // 2), dtype=int)
+    for r in range(h // 2):
+        for c in range(w // 2):
+            orbit = (
+                (r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, c),
+                (h - 1 - r, w - 1 - c),
