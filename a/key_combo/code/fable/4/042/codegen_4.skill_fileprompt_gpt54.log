+        return int(grid[rr, cc]) in (WALL, color)
+
+    vertical = (
+        wallish(r - 1, c)
+        and wallish(r + 1, c)
+        and not wallish(r, c - 1)
+        and not wallish(r, c + 1)
+    )
+    horizontal = (
+        wallish(r, c - 1)
+        and wallish(r, c + 1)
+        and not wallish(r - 1, c)
+        and not wallish(r + 1, c)
+    )
+    if vertical == horizontal:
+        return None
+    return "v" if vertical else "h"
