+def _distances_for_color(
+    grid: np.ndarray,
+    color: int,
+    start: tuple[int, int],
+    gate_mask: np.ndarray,
+) -> np.ndarray:
+    inf = grid.shape[0] * grid.shape[1] + 1
+    dist = np.full(grid.shape, inf, dtype=int)
+    q: deque[tuple[int, int]] = deque([start])
+    dist[start] = 0
+    while q:
