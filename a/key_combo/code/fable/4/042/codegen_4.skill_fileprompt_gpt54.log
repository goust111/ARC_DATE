_GEN_PALETTE = tuple(c for c in range(10) if c not in _GEN_RESERVED_COLORS)

def _gen_rect_patch(height: int, width: int, bg: int, fg: int, has_hole: bool) -> np.ndarray:
    patch = np.full((height, width), fg, dtype=int)
    if has_hole:
