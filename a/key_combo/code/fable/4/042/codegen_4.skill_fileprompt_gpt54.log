    rows = _gen_cuts(h, n_h)
    cols = _gen_cuts(w, n_v)
    if rows is None or cols is None:
        return None

    g = np.zeros((h, w), dtype=int)
    for c in cols:
        g[:, c] = Color.BLUE
    for r in rows:
        g[r, :] = Color.BLUE

    markers = set()

