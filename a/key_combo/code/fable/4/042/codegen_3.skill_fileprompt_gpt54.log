+        a_left = int(a["bbox"][1])
+        a_right = int(a["bbox"][3])
+        b_left = int(b["bbox"][1])
+        b_right = int(b["bbox"][3])
+        if a_right < b_left:
+            c_start, c_end = a_right + 1, b_left - 1
+        else:
+            c_start, c_end = b_right + 1, a_left - 1
