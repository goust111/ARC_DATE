+
+def _fill_enclosed_background(grid: np.ndarray, bg: int) -> np.ndarray:
+    out = grid.copy()
+    h, w = out.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[Coord] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
