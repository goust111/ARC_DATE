+    left_offset = random.randint(0, final_w - local_w)
+    ctrl_r = final_h - 1
+
+    occupied: list[tuple[int, int, int, int]] = []
+    cycle_rows: set[int] = set()
+    cycle_cols: set[int] = set()
+    for _, lr, lc in cycle_positions:
