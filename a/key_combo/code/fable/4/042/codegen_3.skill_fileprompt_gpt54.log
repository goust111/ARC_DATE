+            "bbox": (r0, c0, r1, c1),
+            "outer_size": h,
+            "thickness": thickness,
+            "inner_color": inner_color,
+            "inner_bbox": (r0 + thickness, c0 + thickness, r1 - thickness, c1 - thickness),
