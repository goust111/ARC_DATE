+def _parse_frame(grid: np.ndarray, border_color: int, coords: np.ndarray, bg: int) -> dict | None:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
