+def _control_row(grid: np.ndarray, frames: list[dict], bg: int, border_color: int) -> tuple[int, list[int]]:
+    max_r = max(int(frame["bbox"][2]) for frame in frames)
+    ctrl_r = None
+    for r in range(grid.shape[0] - 1, max_r + 1, -1):
