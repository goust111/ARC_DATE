+def _same_row_band(a: dict, b: dict) -> bool:
+    ia = a["inner_bbox"]
+    ib = b["inner_bbox"]
+    return int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2])
+
+
+def _same_col_band(a: dict, b: dict) -> bool:
+    ia = a["inner_bbox"]
+    ib = b["inner_bbox"]
+    return int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3])
