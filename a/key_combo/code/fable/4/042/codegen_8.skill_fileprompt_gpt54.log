+def _place_horizontal_lane(grid: np.ndarray, reserved: np.ndarray, direction: int) -> bool:
+    h, w = grid.shape
+    thickness = random.randint(*THICKNESS_RANGE)
+    obj_w = random.randint(*LENGTH_RANGE)
