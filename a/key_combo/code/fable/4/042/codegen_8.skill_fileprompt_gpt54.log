+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0 = int(coords[:, 0].min())
+            r1 = int(coords[:, 0].max())
+            c0 = int(coords[:, 1].min())
+            c1 = int(coords[:, 1].max())
+            anchor = (r0, c0)
