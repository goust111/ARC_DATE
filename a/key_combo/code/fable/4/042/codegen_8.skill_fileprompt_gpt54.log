+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+MARKER = 9
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OBJECT_COLORS = [1, 2, 3, 4, 5, 6, 7, 8]
+
+GEN_RETRIES = 400
