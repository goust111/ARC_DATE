            c = slot_col0 + sc * SLOT_STRIDE
            inp[r : r + TILE_SIZE, c : c + TILE_SIZE] = SLOT_COLOR
            control = slot_controls.get((sr, sc))
            if control is not None:
                inp[r + 1, c + 1] = control
    return inp


