+    if placed_specs is None:
+        return None
+
+    inp, out = _render_example(bg, motif, motif_box, (grid_h, grid_w), placed_specs)
+    if _most_common_color(inp) != bg:
+        return None
+    if not np.array_equal(main(inp), out):
