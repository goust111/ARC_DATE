+def _diagonal_sector(horizontal: str, vertical: str) -> str:
+    return {
+        ("L", "U"): "DR",
+        ("L", "D"): "UR",
+        ("R", "U"): "DL",
+        ("R", "D"): "UL",
+    }[(horizontal, vertical)]
