+    if v_side == "N":
+        r_lo = top_margin
+        r_hi = mr0 - gap - slot_h
+    elif v_side == "S":
+        r_lo = mr1 + gap + 1
+        r_hi = h - bottom_margin - slot_h - 1
+    else:
+        r_lo = max(top_margin, mr0 - slot_h + 1)
+        r_hi = min(h - bottom_margin - slot_h - 1, mr1)
+
+    if h_side == "W":
+        c_lo = left_margin
+        c_hi = mc0 - gap - slot_w
+    elif h_side == "E":
+        c_lo = mc1 + gap + 1
+        c_hi = w - right_margin - slot_w - 1
+    else:
+        c_lo = max(left_margin, mc0 - slot_w + 1)
+        c_hi = min(w - right_margin - slot_w - 1, mc1)
+
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return (r_lo, r_hi), (c_lo, c_hi)
+
+
+def _required_extents(slot_specs: list[dict[str, object]]) -> tuple[int, int, int, int]:
+    up = down = left = right = 0
+    for spec in slot_specs:
+        sector = spec["sector"]
+        gap = int(spec["gap"])
+        slot_h, slot_w = spec["shape"]
+        v_side, h_side = _sector_sides(str(sector))
+        if v_side == "N":
+            up = max(up, slot_h + gap)
+        if v_side == "S":
+            down = max(down, slot_h + gap)
+        if h_side == "W":
+            left = max(left, slot_w + gap)
+        if h_side == "E":
+            right = max(right, slot_w + gap)
+    return up, down, left, right
