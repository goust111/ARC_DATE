+        specs[-1]["shape"] = (h * int(specs[-1]["k"]), w * int(specs[-1]["k"]))
+    return specs
+
+
+def _place_slots(
+    motif_box: tuple[int, int, int, int],
+    grid_shape: tuple[int, int],
+    margins: tuple[int, int, int, int],
+    slot_specs: list[dict[str, object]],
