+    for box in slot_boxes:
+        slot = _crop(g, box)
+        assert np.all(slot == BLACK), "each slot component must be a solid black rectangle"
+        sh, sw = slot.shape
+        assert sh % mh == 0 and sw % mw == 0, "slot dimensions must be integer multiples of motif dimensions"
+        factor_h = sh // mh
+        factor_w = sw // mw
