    center_r = (r0 + r1) // 2
    center_c = (c0 + c1) // 2
    H, W = inp.shape
    out = inp.copy()

    for dr, dc in RAY_DIRECTIONS:
        color = int(inp[center_r + dr, center_c + dc])
