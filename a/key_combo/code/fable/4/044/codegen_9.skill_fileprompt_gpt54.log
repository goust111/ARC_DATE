def _gen_can_sum(areas: tuple[int, ...], slots: int, total: int, memo: dict[tuple[int, int], bool]) -> bool:
    key = (slots, total)
    if key in memo:
        return memo[key]
    if slots == 0:
        memo[key] = total == 0
        return memo[key]
    if total < MIN_COMPONENT_AREA * slots or total > MAX_COMPONENT_AREA * slots:
        memo[key] = False
