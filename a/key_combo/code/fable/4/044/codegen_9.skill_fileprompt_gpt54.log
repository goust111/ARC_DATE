def _gen_center(n: int) -> tuple[int, int]:
    choices = []
    for r in range(2, n - 2):
        for c in range(2, n - 2):
            distances = (r, c, n - 1 - r, n - 1 - c)
            if min(distances) in CENTER_EDGE_DISTANCES and max(distances) in CENTER_FAR_EDGE_DISTANCES:
