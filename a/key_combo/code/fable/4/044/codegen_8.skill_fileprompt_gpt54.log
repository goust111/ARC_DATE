L_MAX_H = 9
L_MIN_W = 3
L_MAX_W = 8
L_LEG_MIN = 2
L_SHAPE_PROB = 0.25
MAX_GENERATION_ATTEMPTS = 300

_GEN_COMPONENT_BANK = None


def _gen_table_value(r: int, c: int, cycle: list[int]) -> int:
    near = min(r, c)
    dist = abs(r - c)
    if dist == 0:
        return cycle[0]
    if dist <= near + 1:
