_GEN_BBOX_WIDTH_RANGE = (5, 19)
_GEN_BORDER_RANGE = (1, 4)
_GEN_INTERIOR_HEIGHT_RANGE = (3, 10)
_GEN_INTERIOR_WIDTH_RANGE = (3, 15)
_GEN_MIN_EMPTY_INTERIOR_CELLS = 2

