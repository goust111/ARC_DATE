def _gen_slide_choices_top(
    H: int,
    out_cells: tuple[tuple[int, int], ...],
    blocked: np.ndarray,
    prev_key: tuple[int, int, int, int] | None,
) -> list[tuple[int, tuple[tuple[int, int], ...], tuple[int, int, int, int]]]:
