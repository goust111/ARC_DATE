+    mode = random.choices(PRIMARY_PAIR_MODES, weights=PRIMARY_PAIR_WEIGHTS, k=1)[0]
+    first_orientation = mode[0]
+    second_orientation = mode[1]
+
+    for _ in range(140):
+        first = _sample_bar(shape, colors[0], orientation=first_orientation)
+        if first is None:
+            return None
+
+        for _ in range(220):
