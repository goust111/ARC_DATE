+
+    for comp in bars_raw:
+        r0, c0, r1, c1 = comp["bbox"]
+        area = int(comp["area"])
+        height = int(r1 - r0 + 1)
+        width = int(c1 - c0 + 1)
+        assert area == height * width, "each foreground object must be solid"
+        assert height == 1 or width == 1, "each foreground object must be a straight bar"
