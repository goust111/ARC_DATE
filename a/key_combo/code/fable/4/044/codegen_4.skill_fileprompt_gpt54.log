+def _render_input(shape: tuple[int, int], bg: int, bars: list[tuple[str, int, int, int, int]]) -> np.ndarray:
+    grid = np.full(shape, bg, dtype=int)
+    for orientation, r, c, length, color in bars:
+        if orientation == "H":
+            grid[r, c : c + length] = color
+        else:
