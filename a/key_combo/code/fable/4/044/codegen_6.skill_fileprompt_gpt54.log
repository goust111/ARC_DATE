+def _orbits(n: int) -> list[list[tuple[int, int]]]:
+    visited: set[tuple[int, int]] = set()
+    out: list[list[tuple[int, int]]] = []
+    for r in range(n):
+        for c in range(n):
+            if (r, c) in visited:
+                continue
+            rr, cc = n - 1 - r, n - 1 - c
+            orbit = [(r, c)] if (rr, cc) == (r, c) else [(r, c), (rr, cc)]
+            visited.update(orbit)
+            out.append(orbit)
+    return out
+
