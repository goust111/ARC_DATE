+def _split_panels(grid: np.ndarray) -> tuple[list[np.ndarray], int]:
+    h, w = map(int, grid.shape)
+    if w == 2 * h:
+        n = h
+        return [grid[:, :n], grid[:, n:]], n
+    if h == 2 * w:
