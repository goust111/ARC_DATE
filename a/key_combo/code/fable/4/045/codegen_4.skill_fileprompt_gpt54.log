0162: def _connected(shape: Shape) -> bool:
0163:     cells = set(shape)
0164:     seen = {next(iter(cells))}
0165:     stack = list(seen)
0166:     while stack:
0167:         r, c = stack.pop()
0168:         for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
0169:             if (nr, nc) in cells and (nr, nc) not in seen:
0170:                 seen.add((nr, nc))
0171:                 stack.append((nr, nc))
0172:     return len(seen) == len(cells)
