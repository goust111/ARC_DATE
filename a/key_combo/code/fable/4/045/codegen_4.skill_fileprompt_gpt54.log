+    free_w = 30 - extent_w
+    pad_top = random.randint(0, free_h)
+    pad_left = random.randint(0, free_w)
+
+    shifted = [
+        (top - min_r + pad_top, left - min_c + pad_left, height, width)
+        for top, left, height, width in rects
+    ]
