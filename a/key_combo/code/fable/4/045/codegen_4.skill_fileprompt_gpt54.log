+    rotated = [colors[-1], *colors[:-1]]
+    grid = np.zeros(shape, dtype=int)
+    rect_by_color = dict(zip(colors, rects))
+    for color in rotated:
+        _paint_rect(grid, rect_by_color[color], color)
+    return grid
+
+
