0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """
0012:     Grow four clockwise spiral wall paths from the tips of a teal cross.
0013: 
0014:     Input structure:
0015:     - bg = 0 (black). A single teal (8) cross centered in the grid.
0016: 
0017:     Rule:
0018:     - Each arm tip launches a "turtle" heading 90° right of its outward direction.
0019:     - Movement priority: turn right > go straight > turn left (left only if not on border).
0020:     - Normal step = 2 cells; step right after a turn = 1 cell.
0021:     - Each new cell must have a 1-cell orthogonal gap from all existing walls except the predecessor.
0022: 
0023:     Key insight: The right-turn preference plus alternating 2/1 step lengths creates self-avoiding spirals that tile the grid with uniform spacing.
0024:     """
0025: 
0026:     grid = np.asarray(grid, dtype=int)
0027:     h, w = grid.shape
0028:     out = grid.copy()
0029: 
0030:     # Cross "center hole": row/col with maximum 8s.
0031:     row_counts = np.sum(grid == 8, axis=1)
0032:     col_counts = np.sum(grid == 8, axis=0)
0033:     cr = int(np.argmax(row_counts))
0034:     cc = int(np.argmax(col_counts))
0035: 
0036:     def inb(r: int, c: int) -> bool:
0037:         return 0 <= r < h and 0 <= c < w
0038: 
0039:     def is_border(r: int, c: int) -> bool:
0040:         return r == 0 or r == h - 1 or c == 0 or c == w - 1
0041: 
0042:     def add(pos, d, k=1):
0043:         return (pos[0] + d[0] * k, pos[1] + d[1] * k)
