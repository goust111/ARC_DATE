0045:     def right(d):
0046:         return _DIRS_URDL[(_DIRS_URDL.index(d) + 1) % 4]
0047: 
0048:     def left(d):
0049:         return _DIRS_URDL[(_DIRS_URDL.index(d) + 3) % 4]
0050: 
0051:     def spacing_ok(cell, prev, start) -> bool:
0052:         r, c = cell
0053:         for nr, nc in neighbors4(r, c):
0054:             if inb(nr, nc) and out[nr, nc] != 0 and (nr, nc) != prev and (nr, nc) != start:
0055:                 return False
0056:         return True
0057: 
0058:     def can_move(cur, d, length: int) -> bool:
0059:         prev = cur
0060:         for t in range(1, length + 1):
0061:             rr, cc2 = add(cur, d, t)
0062:             if not inb(rr, cc2) or out[rr, cc2] != 0:
0063:                 return False
0064:             if not spacing_ok((rr, cc2), prev, cur):
0065:                 return False
0066:             prev = (rr, cc2)
0067:         return True
