+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _make_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

