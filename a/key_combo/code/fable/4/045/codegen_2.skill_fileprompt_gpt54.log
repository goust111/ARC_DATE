+    h, w = map(int, shape)
+    return all(0 <= r < h and 0 <= c < w for r, c in coords)
+
+
+def _pairwise_disjoint(*coord_sets: set[Coord]) -> bool:
+    seen: set[Coord] = set()
+    for coords in coord_sets:
+        if seen & coords:
+            return False
+        seen |= coords
+    return True
