    target, gaps, fill_by_shape = matches[0]
    out = crop_bbox(g, target["bbox"])

    for gap in gaps:
        out[gap[:, 0], gap[:, 1]] = fill_by_shape[_shape_key(gap)]

    assert not np.any(out == bg)
    return out

