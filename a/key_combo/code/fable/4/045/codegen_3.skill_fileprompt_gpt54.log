+
+def _generate_pair_patch() -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    for _ in range(PAIR_RETRIES):
+        path = _random_path()
+        left_cells, right_cells = _wall_sets(path)
+        if not left_cells or not right_cells:
