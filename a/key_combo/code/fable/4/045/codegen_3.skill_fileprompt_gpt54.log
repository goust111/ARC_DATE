+                binary_dilation(grey_masks[i], structure=STRUCT8)
+                & binary_dilation(grey_masks[j], structure=STRUCT8)
+                & (g == BG)
+            )
+            if not channel.any():
+                continue
+            key = _shape_key(channel)
+            color = shape_to_color.get(key)
+            if color is not None:
+                out[channel] = color
+
