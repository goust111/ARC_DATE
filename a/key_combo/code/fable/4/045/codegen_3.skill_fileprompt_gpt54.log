+        arr = np.asarray(coords, dtype=int)
+        if random.random() < 0.5:
+            arr[:, 0] = h - 1 - arr[:, 0]
+        if random.random() < 0.5:
+            arr[:, 1] = w - 1 - arr[:, 1]
+        if random.random() < 0.5:
+            arr = arr[:, ::-1]
+        return [(int(rr), int(cc)) for rr, cc in arr]
