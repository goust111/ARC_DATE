+            dirs.append((r - pr, c - pc))
+        if i + 1 < len(path):
+            nr, nc = path[i + 1]
+            dirs.append((nr - r, nc - c))
+        for dr, dc in dirs:
+            lr, lc = _left_normal(dr, dc)
+            if (r + lr, c + lc) not in channel:
+                left.add((r + lr, c + lc))
+            if (r - lr, c - lc) not in channel:
+                right.add((r - lr, c - lc))
+        if len(dirs) == 2 and dirs[0] != dirs[1]:
+            for side in (1, -1):
