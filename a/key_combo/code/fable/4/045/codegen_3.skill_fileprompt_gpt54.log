+
+def _paste_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    mask = patch != BG
+    h, w = patch.shape
+    view = grid[top : top + h, left : left + w]
+    view[mask] = patch[mask]
