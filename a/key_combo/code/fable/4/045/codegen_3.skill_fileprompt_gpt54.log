+
+    for spec in key_specs:
+        pos = _place_patch(grid, spec["patch"], placed_boxes, pad=2)
+        if pos is None:
+            return None
+
+    try:
+        got = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(got, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
