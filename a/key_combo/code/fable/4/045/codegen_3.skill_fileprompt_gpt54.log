+def _label(mask: np.ndarray, connectivity: int = 4) -> tuple[np.ndarray, int]:
+    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
+    lab, n = label(mask.astype(bool), structure=struct)
+    return lab, int(n)
