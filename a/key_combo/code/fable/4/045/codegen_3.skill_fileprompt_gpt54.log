+
+
+def _generate_hole_mask(used_keys: set[tuple[int, int, tuple[tuple[int, int], ...]]]) -> np.ndarray:
+    for _ in range(PAIR_RETRIES):
+        path = _random_path()
+        coords = np.asarray(path, dtype=int)
+        coords -= coords.min(axis=0)
