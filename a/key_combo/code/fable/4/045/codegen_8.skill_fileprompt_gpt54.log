+        fg = colors[1] if colors[0] == 0 else colors[0]
+    else:
+        counts = {color: int(np.count_nonzero(grid == color)) for color in colors}
+        bg = max(colors, key=lambda color: counts[color])
+        fg = min(colors, key=lambda color: counts[color])
+    assert bg != fg
+    return bg, fg
