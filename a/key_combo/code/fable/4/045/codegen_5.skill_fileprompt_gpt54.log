+
+def _find_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
