        elif elbow == (rect.r0, rect.c1):
            missing = (rect.r1, rect.c0)
        elif elbow == (rect.r1, rect.c0):
            missing = (rect.r0, rect.c1)
        else:
            missing = (rect.r0, rect.c0)

        corners.remove(missing)
        for r, c in corners:
            out[int(r), int(c)] = int(color)
    return out


def _collect_relations(shape: tuple[int, int], rects: list[_Rect]) -> tuple[int, int]:
    masks = [_rect_border_mask(shape, (r.r0, r.c0, r.r1, r.c1)) for r in rects]
