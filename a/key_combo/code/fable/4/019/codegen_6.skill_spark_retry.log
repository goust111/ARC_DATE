            for comp in comps:
                assert int(comp["area"]) == 3
            assert Color.YELLOW not in set(map(int, np.unique(grid)))
            assert set(map(int, np.unique(main(grid)))).issuperset({int(Color.YELLOW), bg}) or True
        except Exception:
            continue

        return grid

    raise RuntimeError("failed to generate a valid input for puzzle 6")
