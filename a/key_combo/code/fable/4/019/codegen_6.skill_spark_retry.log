        if mode == '"'nested' and nested_count == 0:
            continue
        if mode == 'crossing' and crossings == 0:
            continue
        if mode == 'both' and (crossings == 0 or nested_count == 0):
            continue

        bg = random.choice(mod.GEN_BACKGROUND)
        colors = mod._palette(bg, len(rects))
        grid = mod._build_input((H, W), rects, colors, bg)

        try:
            out = mod.main(grid)
        except Exception as e:
            reasons[(mode,'main')] += 1
            if reasons[(mode,'main')] < 5:
                print('mode', mode, 'main fail', repr(e), 'shape', grid.shape)
            continue

        try:
            colors_in_input = mod.colors_present(grid, exclude={bg})
            for c in colors_in_input:
                assert int((grid == c).sum()) == 3
        except Exception as e:
            reasons[(mode,'count')] += 1
            continue

        print('success', mode, H, W, len(rects), crossings, nested_count)
        raise SystemExit

    print('no success for mode', mode, 'reasons', dict(reasons))
print('done reasons', reasons)
