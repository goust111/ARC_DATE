        # Use the closest enclosing rectangle (smallest strictly enclosing area).
        _, outer_color, outer_rect = min(containing, key=lambda t: t[0])
        fill_r0, fill_c0, fill_r1, fill_c1 = inner_rect
        out[fill_r0 + 1 : fill_r1, fill_c0 + 1 : fill_c1] = int(outer_color)

    return out


