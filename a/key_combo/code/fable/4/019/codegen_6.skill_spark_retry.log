                nested += 1
            if _strictly_inside((rects[j].r0, rects[j].c0, rects[j].r1, rects[j].c1), (rects[i].r0, rects[i].c0, rects[i].r1, rects[i].c1)):
                nested += 1

    return crossings, nested


