    for outer in options:
        inner_h_max = outer.r1 - outer.r0 - 1
        inner_w_max = outer.c1 - outer.c0 - 1
        if inner_h_max < 2 or inner_w_max < 2:
            continue

        for _ in range(300):
            inner_h = random.randint(3, min(8, inner_h_max + 1))
            inner_w = random.randint(3, min(8, inner_w_max + 1))
            if inner_h > outer.r1 - outer.r0 - 1 or inner_w > outer.c1 - outer.c0 - 1:
                continue
