def _place_nested(shape: tuple[int, int], occupied: np.ndarray, rects: list[_Rect]) -> _Rect | None:
    if not rects:
        return None

    options = [
        r for r in rects if (r.r1 - r.r0 >= 3) and (r.c1 - r.c0 >= 3)
