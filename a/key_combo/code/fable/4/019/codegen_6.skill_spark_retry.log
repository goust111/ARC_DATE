            if not overlap_counts:
                continue

            target_idx = rects.index(target)
            if overlap_counts[target_idx] != 1:
                continue
            if any(i != target_idx and count > 0 for i, count in enumerate(overlap_counts)):
                continue

            cell = np.argwhere(cand_mask & t_mask)
            if len(cell) != 1:
                continue
            rr, cc = map(int, cell[0])
            if not (target.r0 < rr < target.r1 and target.c0 <= cc <= target.c1 and (cc == vc)):
                continue

            if any(_overlap_with(cand, existing) for existing in rects):
                continue

            if np.any(cand_mask & occupied):
                continue

            return cand
    return None


def _build_input(shape: tuple[int, int], rects: list[_Rect]) -> np.ndarray:
    h, w = map(int, shape)
    bg = random.choice(GEN_BACKGROUND)
    colors = _candidate_colors(bg, len(rects))

    out = np.full((h, w), int(bg), dtype=int)
