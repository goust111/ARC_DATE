Rect = tuple[int, int, int, int]


def _rect_border_mask(shape: tuple[int, int], rect: Rect) -> np.ndarray:
    h, w = shape
    r0, c0, r1, c1 = map(int, rect)
    out = np.zeros((int(h), int(w)), dtype=bool)
    out[r0, c0 : c1 + 1] = True
    out[r1, c0 : c1 + 1] = True
    out[r0 : r1 + 1, c0] = True
    out[r0 : r1 + 1, c1] = True
    return out


def _rect_area(rect: Rect) -> int:
    r0, c0, r1, c1 = rect
    return int(r1 - r0 + 1) * int(c1 - c0 + 1)


def _strictly_inside(inner: Rect, outer: Rect) -> bool:
    r0, c0, r1, c1 = inner
    o0, oc0, o1, oc1 = outer
    return int(o0) < int(r0) and int(r1) < int(o1) and int(oc0) < int(c0) and int(c1) < int(oc1)


def _infer_rectangle_from_three_points(coords: np.ndarray) -> Rect:
    rows = Counter(map(int, coords[:, 0]))
    cols = Counter(map(int, coords[:, 1]))

    elbows = [
        (int(r), int(c))
        for r, c in coords
        if rows[int(r)] == 2 and cols[int(c)] == 2
    ]
    assert len(elbows) == 1, \"expected one elbow pixel for each color\"
    elbow_row = int(elbows[0][0])
    elbow_col = int(elbows[0][1])

    missing_row_candidates = [r for r, n in rows.items() if n == 1]
    missing_col_candidates = [c for c, n in cols.items() if n == 1]
    assert len(missing_row_candidates) == 1, \"expected exactly one missing row\"
    assert len(missing_col_candidates) == 1, \"expected exactly one missing col\"
    missing_row = missing_row_candidates[0]
    missing_col = missing_col_candidates[0]

    all_rows = [elbow_row, *missing_row_candidates]
    all_cols = [elbow_col, *missing_col_candidates]
    r0, r1 = min(all_rows), max(all_rows)
    c0, c1 = min(all_cols), max(all_cols)
    missing = (missing_row, missing_col)

    corners = {
        (r0, c0),
        (r0, c1),
        (r1, c0),
        (r1, c1),
    }
    assert missing in corners, \"missing corner must complete the rectangle\"
    present = corners - {missing}
    assert present <= set(map(tuple, map(int, coords))), \"existing corners must match\"
    return r0, c0, r1, c1


def main(grid: np.ndarray) -> np.ndarray:
    \"\"\"
    Complete each color's three rectangle corners, then process emergent crossing and nesting relations.

    Input structure:
    - Background color is dominant; each foreground color appears at exactly three pixels forming three corners of one axis-aligned rectangle.
    - One foreground corner (the elbow) shares its row with one point and its column with another.
    - Yellow is absent in input and is reserved for crossing marks.

    Rule:
    - For every color, infer the missing fourth corner and draw the complete hollow rectangle border of that color.
    - Keep original pixels and preserve other colors.
    - If two different rectangle borders occupy the same cell after completion, set that cell to yellow.
    - If one rectangle is strictly inside another, fill the inner rectangle's interior with the outer rectangle color.

    Key insight:
    - The missing corners are required first; only after completion can crossing and strict nesting be detected correctly.
    \"\"\"
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    color_by_color = {
        int(comp[\"color\"]): comp for comp in comps
    }

    non_bg_colors = colors_present(g, exclude={bg})
    rect_specs: List[tuple[int, Rect, np.ndarray]] = []
    out = g.copy()

    for color in non_bg_colors:
        comp = color_by_color[color]
        assert int(comp[\"area\"]) == 3, \"each color must be exactly three corner pixels\"
        r0, c0, r1, c1 = _infer_rectangle_from_three_points(comp[\"coords\"])
        border = _rect_border_mask(g.shape, (r0, c0, r1, c1))
        out[border] = color
        rect_specs.append((color, (r0, c0, r1, c1), border))

    # Crossing marks
    for i in range(len(rect_specs)):
        ci, _, mi = rect_specs[i]
        for j in range(i + 1, len(rect_specs)):
            cj, _, mj = rect_specs[j]
            assert ci "'!= cj, "rectangle colors should be unique"
            overlap = mi & mj
            if np.any(overlap):
                out[overlap] = int(Color.YELLOW)

    # Nesting fill
    for i in range(len(rect_specs)):
        inner_color, inner_rect, inner_border = rect_specs[i]
        inner_r0, inner_c0, inner_r1, inner_c1 = inner_rect
        if inner_r1 - inner_r0 <= 1 or inner_c1 - inner_c0 <= 1:
            continue

        containing = [
            (int(_rect_area(outer_rect)), outer_color, outer_rect)
            for outer_color, outer_rect, _ in rect_specs
            if outer_color != inner_color and _strictly_inside(inner_rect, outer_rect)
        ]
        if not containing:
