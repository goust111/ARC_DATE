        if mode == 'both':
            target_n = max(4, target_n)

        rects = []
        occupied = np.zeros((H, W), dtype=bool)
        first = mod._place_independent((H, W), occupied)
        if first is None:
            continue
        rects.append(first)
        occupied |= mod._rect_border_mask((H, W), first)

        second = mod._place_independent((H, W), occupied)
        if second is None:
            continue
        rects.append(second)
        occupied |= mod._rect_border_mask((H, W), second)

        masks = [mod._rect_border_mask((H, W), r) for r in rects]

        if mode in ('nested', 'both'):
            nested = mod._place_nested((H, W), occupied, rects)
            if nested is None:
                continue
            rects.append(nested)
            m = mod._rect_border_mask((H, W), nested)
            occupied |= m
            masks.append(m)

        if mode in ('crossing', 'both'):
            crossing = mod._place_crossing((H, W), occupied, rects, masks)
            if crossing is None:
                continue
            rects.append(crossing)
            m = mod._rect_border_mask((H, W), crossing)
            occupied |= m
            masks.append(m)

        while len(rects) < target_n:
            cand = mod._place_independent((H, W), occupied)
            if cand is None:
                break
            rects.append(cand)
            m = mod._rect_border_mask((H, W), cand)
            occupied |= m
            masks.append(m)

        if len(rects) "'!= target_n:
