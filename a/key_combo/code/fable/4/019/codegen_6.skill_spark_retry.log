    return None


def _place_crossing(shape: tuple[int, int], occupied: np.ndarray, rects: list[_Rect]) -> _Rect | None:
    h, w = map(int, shape)
    if not rects:
        return None

    targets = [r for r in rects if (r.r1 - r.r0 >= 3) and (r.c1 - r.c0 >= 3)]
    random.shuffle(targets)
    if not targets:
        return None

    for target in targets:
        for _ in range(500):
