+def _transform_panel(panel: np.ndarray, rot90: int, flip_lr: bool) -> np.ndarray:
+    out = np.array(panel, copy=True)
+    if flip_lr:
+        out = np.fliplr(out)
+    return np.rot90(out, k=rot90)
