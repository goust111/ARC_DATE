+from __future__ import annotations
+
+import os
+import random
+import sys
+from collections import Counter
+
+import numpy as np
+
+
+_ARC_UTILS_PATH = "/home/lixinyu/snap/new/solvers"
+if _ARC_UTILS_PATH not in sys.path:
+    sys.path.append(_ARC_UTILS_PATH)
+
+from arc_utils import Color, find_components, get_bg, paste, random_free_location
+
+
+def _transform_panel(panel: np.ndarray, rot90: int, flip_lr: bool) -> np.ndarray:
+    out = np.array(panel, copy=True)
+    if flip_lr:
+        out = np.fliplr(out)
+    return np.rot90(out, k=rot90)
+
+
+def _key_pair_at_topleft(panel: np.ndarray) -> int | None:
+    for color in np.unique(panel):
+        coords = np.argwhere(panel == color)
+        if len(coords) != 2:
+            continue
+        (r0, c0), (r1, c1) = [tuple(map(int, v)) for v in coords]
+        if abs(r0 - r1) + abs(c0 - c1) != 1:
+            continue
+        if set(((r0, c0), (r1, c1))) == {(0, 0), (0, 1)}:
+            return int(color)
+    return None
+
+
+def _normalize_panel(panel: np.ndarray) -> tuple[np.ndarray, int, int]:
+    canonical = None
+    canonical_key = None
+    canonical_blank = None
+    for rot90 in range(4):
+        for flip_lr in (False, True):
+            transformed = _transform_panel(panel, rot90, flip_lr)
+            key = _key_pair_at_topleft(transformed)
+            if key is None:
+                continue
+            if canonical is not None:
+                raise AssertionError("panel key pose is not unique under dihedral transforms")
+            canonical = transformed
+            canonical_key = int(key)
+
+    if canonical is None or canonical_key is None:
+        raise AssertionError("failed to find corner-key pose for a panel")
+
+    color_counts = Counter(map(int, canonical.ravel()))
+    blank = next((color for color, _cnt in color_counts.most_common() if color != canonical_key), None)
+    if blank is None:
+        raise AssertionError("failed to infer panel blank color")
+
+    assert color_counts[canonical_key] == 2, "corner key should be exactly two cells"
+
+    return canonical, int(blank), int(canonical_key)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Normalize each panel by a unique corner-key pose and overlay their interior drawings.
+
+    Input structure:
+    - Most-common color is a separator surrounding several same-size rectangular panels.
+    - Each panel is made of a dominant blank color plus sparse colored marks.
+    - Each panel carries a unique two-cell corner key: one corner pixel and its right-adjacent companion, both same key color.
+
+    Rule:
+    - For each panel, apply the unique dihedral transform that moves the key to (top-left, top-right).
+    - Create one output panel with the canonical panel size and blank color.
+    - Overlay every non-blank, non-key mark from each normalized panel at its relative position.
+    - Ignore all key pixels in the output.
+
+    Key insight:
+    - Panel orientations are random and cannot be overlaid directly; the two-cell corner key uniquely determines each panel's reverse transform.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+
+    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False)
+    assert comps, "expected at least one panel"
+
+    normalized: list[tuple[np.ndarray, int, int]] = []
+    panel_sizes: set[tuple[int, int]] = set()
+    blank_color = None
+    key_color = None
+
+    for comp in comps:
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        panel = g[r0 : r1 + 1, c0 : c1 + 1]
+        coords = np.asarray(comp["coords"], dtype=int)
+        assert panel.size == coords.shape[0], "panel should be rectangular with no holes"
+
+        norm, blank, key = _normalize_panel(panel)
+        panel_sizes.add((norm.shape[0], norm.shape[1]))
+        if blank_color is None:
+            blank_color = blank
+        else:
+            assert blank == blank_color, "all panels must share the same blank color"
+        if key_color is None:
+            key_color = key
+        else:
+            assert key == key_color, "all corner keys should use the same color"
+
+        mark_mask = (norm != blank) & (norm != key)
+        assert mark_mask.any(), "panel must contain at least one drawing mark"
+        normalized.append((norm, blank, key, mark_mask))
+
+    assert len(panel_sizes) == 1, "panels must have equal size after normalization"
+    h, w = next(iter(panel_sizes))
+    assert blank_color is not None
+
+    out = np.full((h, w), int(blank_color), dtype=int)
+    for norm, blank, key, mark_mask in normalized:
+        painted = out != blank
+        assert not np.any(painted & mark_mask), "drawing marks must not overlap between panels"
+        out[mark_mask] = norm[mark_mask]
+        assert not np.any((norm == key) & ((out == key) & (~mark_mask))), "key pixels must be ignored"
+
+    return out
+
+
+PANEL_H_RANGE = (3, 9)
+PANEL_W_RANGE = (3, 9)
+PANEL_COUNT_RANGE = (2, 6)
+CANVAS_H_RANGE = (18, 30)
+CANVAS_W_RANGE = (18, 30)
+MARK_CELLS_RANGE = (10, 28)
+GEN_ATTEMPTS = 500
+
+
+def _random_connected_cells(
+    h: int,
+    w: int,
+    target: int,
+    forbidden: set[tuple[int, int]],
+) -> set[tuple[int, int]]:
+    free = [(r, c) for r in range(h) for c in range(w) if (r, c) not in forbidden]
+    if len(free) < target:
+        return set()
+
+    cells = {random.choice(free)}
+    for _ in range(1, target):
+        frontier = []
+        for r, c in list(cells):
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells and (nr, nc) not in forbidden:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return set()
+        cells.add(random.choice(frontier))
+    return cells
+
+
+def _generate_attempt() -> np.ndarray | None:
+    panel_h = random.randint(*PANEL_H_RANGE)
+    panel_w = random.randint(*PANEL_W_RANGE)
+    panel_count = random.randint(*PANEL_COUNT_RANGE)
+
+    sep = random.choice([c for c in Color.NOT_BLACK if c != 0][:8])
+    blank = random.choice([c for c in Color.NOT_BLACK if c != sep and c != Color.GRAY][:8])
+    key_color = random.choice([c for c in Color.NOT_BLACK if c not in (sep, blank)][:8])
+    colors = [c for c in Color.NOT_BLACK if c not in (sep, blank, key_color)]
+    random.shuffle(colors)
+    colors = colors[: random.randint(2, min(4, len(colors)))]
+
+    canonical_panels: list[np.ndarray] = []
+    all_used: set[tuple[int, int]] = {(0, 0), (0, 1)}
+    target_mark_cells = random.randint(*MARK_CELLS_RANGE)
+    min_needed = 0
+    for panel_idx in range(panel_count):
+        min_needed += 3
+    if target_mark_cells < panel_count:
+        target_mark_cells = panel_count
+    if target_mark_cells > panel_h * panel_w - min_needed:
+        target_mark_cells = panel_h * panel_w - min_needed
+    if target_mark_cells <= 0:
+        return None
+
+    panel_assignments = [set() for _ in range(panel_count)]
+    panel_coloring: list[dict[tuple[int, int], int]] = [dict() for _ in range(panel_count)]
+
+    owner_by_cell: dict[tuple[int, int], int] = {}
+    for i in range(panel_count):
+        remaining = [(r, c) for r in range(panel_h) for c in range(panel_w) if (r, c) not in all_used and (r, c) not in owner_by_cell]
+        if not remaining:
+            return None
+        anchor = random.choice(remaining)
+        owner_by_cell[anchor] = i
+        all_used.add(anchor)
+
+    extra = target_mark_cells - panel_count
+    for _ in range(extra):
+        remaining = [(r, c) for r in range(panel_h) for c in range(panel_w) if (r, c) not in all_used and (r, c) not in owner_by_cell]
+        if not remaining:
+            break
+        cell = random.choice(remaining)
+        owner = random.randrange(panel_count)
+        owner_by_cell[cell] = owner
+        all_used.add(cell)
+
+    for cell, owner in owner_by_cell.items():
+        panel_assignments[owner].add(cell)
+
+    # Add short connected strokes in every panel to avoid trivial noisy points.
+    for owner in range(panel_count):
+        if len(panel_assignments[owner]) <= 1:
+            added = _random_connected_cells(panel_h, panel_w, 2, set(panel_assignments[owner]) | {(0, 0), (0, 1)})
+            if not added:
+                return None
+            panel_assignments[owner].update(added)
+
+    for owner in range(panel_count):
+        if not panel_assignments[owner]:
+        ```
+            return None
+        panel = np.full((panel_h, panel_w), blank, dtype=int)
+        panel[0, 0] = key_color
