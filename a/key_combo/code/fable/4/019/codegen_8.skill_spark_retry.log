+        for cell in panel_assignments[owner]:
+            if cell in {(0, 0), (0, 1)}:
+                return None
+            panel[cell[0], cell[1]] = random.choice(colors)
+        canonical_panels.append(panel)
+
+    expected = np.full((panel_h, panel_w), blank, dtype=int)
+    for panel in canonical_panels:
+        marks = (panel != blank) & (panel != key_color)
+        if np.any((expected != blank) & marks):
+            return None
+        expected[marks] = panel[marks]
+
+    transforms = [(random.randrange(4), random.choice((False, True))) for _ in canonical_panels]
+    oriented_panels = [_transform_panel(p, rot, flip) for p, (rot, flip) in zip(canonical_panels, transforms)]
+
+    canvas_h = random.randint(*CANVAS_H_RANGE)
+    canvas_w = random.randint(*CANVAS_W_RANGE)
+    grid = np.full((canvas_h, canvas_w), sep, dtype=int)
