+                border=1,
+                padding=1,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(grid, panel, r0, c0)
+
+    if get_bg(grid) != sep:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
