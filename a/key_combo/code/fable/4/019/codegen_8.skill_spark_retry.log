+    normalized: list[tuple[np.ndarray, int, int, np.ndarray]] = []
+    per_panel_candidates: list[list[tuple[np.ndarray, int, bool, int]]] = []
+    panel_sizes = Counter()
+    blank_color = None
+
+    for comp in comps:
