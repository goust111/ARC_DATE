CELL_SIZE_RANGE, GAP_RANGE = range(1, 5), range(1, 3)
BORDER_TOP_LEFT = 1

# Fixed colors and retry policy.
LATTICE_COLOR, CELL_COLOR = 1, 0
MAX_GENERATION_ATTEMPTS = 300

VALID_LAYOUTS_BY_SIZE = {}
for n in ARRAY_SIZE_RANGE:
