+            transformed = _transform_panel(panel, rot90, flip_lr)
+            key = _key_pair_at_topleft(transformed)
+            if key is None:
+                continue
+            candidates.append((transformed, int(key), bool(flip_lr), int(rot90)))
+    return candidates
