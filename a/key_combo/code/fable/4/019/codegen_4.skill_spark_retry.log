def _gen_lattice_options() -> list[tuple[int, int, int, int, int, int, int]]:
    """Enumerate valid lattice/canvas tuples in sampling order."""
    options = []
    for period in GEN_PERIODS:
        for interior_size in GEN_INTERIOR_SIZES:
