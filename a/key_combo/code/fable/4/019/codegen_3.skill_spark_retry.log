    distance = random.randint(*_GEN_DISTANCE_RANGE)
    src_r, src_c = _gen_source(edge, dest_r, dest_c, distance)
    inp = _gen_render_square(color, src_r, src_c)

    if not np.array_equal(main(inp), out):
