 101: def _gen_fill_quadrant(
 102:     grid: np.ndarray,
 103:     r0: int,
 104:     r1: int,
 105:     c0: int,
 106:     c1: int,
 107:     dominant: int,
 108: ) -> None:
 109:     grid[r0:r1, c0:c1] = dominant
 110:     border = _gen_border_coords(r0, r1, c0, c1)
 111:     interior_area = max(0, r1 - r0 - 2) * max(0, c1 - c0 - 2)
 112:     total_area = (r1 - r0) * (c1 - c0)
 113:     min_dominant_on_border = max(0, total_area // 2 + 1 - interior_area)
 114:     max_by_mode = int(np.floor(MAX_MODE_RATIO * total_area)) - interior_area
 115:     max_by_noise = int(np.floor(MAX_DOMINANT_BORDER_RATIO * len(border)))
 116:     max_dominant_on_border = max(min_dominant_on_border, min(max_by_mode, max_by_noise))
 117:     dominant_on_border = random.randint(min_dominant_on_border, max_dominant_on_border)
 118: 
 119:     random.shuffle(border)
 120:     dominant_cells = set(border[:dominant_on_border])
 121:     noise_cells = border[dominant_on_border:]
 122:     noise_palette = [color for color in range(COLOR_COUNT) if color != dominant]
 123:     distinct_noise = random.randint(
 124:         NOISE_DISTINCT_MIN,
 125:         min(NOISE_DISTINCT_MAX, len(noise_palette), len(noise_cells)),
 126:     )
 127:     used_noise = random.sample(noise_palette, distinct_noise)
 128:     noise_values = used_noise[:]
 129:     noise_values.extend(random.choice(used_noise) for _ in range(len(noise_cells) - len(noise_values)))
 130:     random.shuffle(noise_values)
 131: 
 132:     for r, c in dominant_cells:
 133:         grid[r, c] = dominant
 134:     for (r, c), color in zip(noise_cells, noise_values):
 135:         grid[r, c] = color
