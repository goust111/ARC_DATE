 109: 
 110:     extra = _GEN_GRID_SIZE - sum(widths) - _GEN_MIN_INTER_OBJECT_GAP * (n - 1)
 111:     gap_extra = [0] * (n + 1)
 112:     for _ in range(extra):
 113:         gap_extra[random.randrange(n + 1)] += 1
