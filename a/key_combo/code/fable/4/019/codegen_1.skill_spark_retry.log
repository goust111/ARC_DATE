 142: def _gen_prevent_extra_solid_crosses(
 143:     grid: np.ndarray,
 144:     cross_r: int,
 145:     cross_c: int,
 146:     separator: int,
 147:     dominants: list[int],
 148: ) -> None:
 149:     for r in range(grid.shape[0]):
 150:         if r != cross_r and np.all(grid[r, :] == separator):
 151:             dominant = dominants[0] if r < cross_r else dominants[2]
 152:             grid[r, 0] = _gen_non_separator_noise(separator, dominant)
 153:     for c in range(grid.shape[1]):
 154:         if c != cross_c and np.all(grid[:, c] == separator):
 155:             dominant = dominants[0] if c < cross_c else dominants[1]
 156:             grid[0, c] = _gen_non_separator_noise(separator, dominant)
