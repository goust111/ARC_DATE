  97: def _gen_partition_spans(n):
  98:     available = _GEN_GRID_SIZE - _GEN_MIN_INTER_OBJECT_GAP * (n - 1)
  99:     if n == 2 and random.random() < _GEN_TWO_OBJECT_WIDE_SPAN_PROB:
