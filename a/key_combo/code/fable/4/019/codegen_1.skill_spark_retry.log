 159: def _gen_attempt() -> np.ndarray | None:
 160:     colors = random.sample(range(COLOR_COUNT), 5)
 161:     separator = colors[0]
 162:     dominants = colors[1:]
 163:     expected = np.array(
 164:         [
 165:             [dominants[0], separator, dominants[1]],
 166:             [separator, separator, separator],
 167:             [dominants[2], separator, dominants[3]],
 168:         ],
 169:         dtype=int,
 170:     )
 171: 
 172:     height = width = GRID_SIZE
 173:     cross_r = random.randint(CROSS_ROW_MIN, CROSS_ROW_MAX)
 174:     cross_c = random.randint(CROSS_COL_MIN, CROSS_COL_MAX)
 175:     grid = np.full((height, width), separator, dtype=int)
 176: 
 177:     quadrants = [
 178:         (0, cross_r, 0, cross_c, dominants[0]),
 179:         (0, cross_r, cross_c + 1, width, dominants[1]),
 180:         (cross_r + 1, height, 0, cross_c, dominants[2]),
 181:         (cross_r + 1, height, cross_c + 1, width, dominants[3]),
 182:     ]
 183:     for r0, r1, c0, c1, dominant in quadrants:
 184:         _gen_fill_quadrant(grid, r0, r1, c0, c1, dominant)
 185: 
 186:     grid[cross_r, :] = separator
 187:     grid[:, cross_c] = separator
 188:     _gen_prevent_extra_solid_crosses(grid, cross_r, cross_c, separator, dominants)
 189: 
 190:     try:
 191:         if np.array_equal(main(grid), expected):
 192:             return grid
 193:     except AssertionError:
 194:         return None
 195:     return None
