 119: GEN_OBJECT_AREA_RANGE, GEN_OBJECT_BBOX_RANGE, GEN_OBJECT_MAX_EXTRA_CELLS = (5, 13), (2, 7), 4
 120: # Shape-class sampling.
 121: GEN_CLASS_OPTIONS, GEN_MAX_CLASS_SIZE, GEN_UNIQUE_MASK_RETRIES = (2, 3), 3, 80
 122: GEN_DIHEDRAL_FLIP_PROB = 0.5
 123: # Output table layout and colors.
 124: GEN_OBJECT_COLORS, GEN_TABLE_BLOCK, GEN_TABLE_STEP = [1, 3, 4, 6, 7, 8, 9], 2, 3
 125: GEN_SAME_SHAPE_COLOR, GEN_DIFFERENT_SHAPE_COLOR = int(Color.RED), int(Color.GREY)
 126: # Input placement and retry limits.
 127: GEN_RESERVED_RIGHT_COLS, GEN_ATTEMPTS = 2, 300
 128: GEN_PLACEMENT_BORDER, GEN_PLACEMENT_PADDING, GEN_PLACEMENT_CONNECTIVITY = 1, 2, 4
 129: GEN_NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
