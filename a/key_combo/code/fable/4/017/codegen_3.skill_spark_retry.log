+def _diagonal_signatures(sources: set[tuple[int, int]]) -> tuple[set[int], set[int]]:
+    nw_diag = {r - c for r, c in sources}
+    ne_diag = {r + c for r, c in sources}
+    return nw_diag, ne_diag
