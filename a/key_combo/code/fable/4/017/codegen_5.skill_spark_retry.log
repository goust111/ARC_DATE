+    max_k = min(H // h, W // w)
+    matches: list[tuple[int, int, int]] = []
+    for k in range(2, max_k + 1):
+        big_h = h * k
+        big_w = w * k
+        for r0 in range(H - big_h + 1):
+            for c0 in range(W - big_w + 1):
+                if _template_match_at(grid, template, r0, c0, k):
+                    matches.append((k, r0, c0))
