+        touches_outer = int(b0 == 0 or b1 == 0 or b2 == h - 1 or b3 == w - 1)
+        area = sub.size
+        hole_area = int(hole_mask.sum())
+        candidates.append((touches_outer, area, -hole_area, sub))
