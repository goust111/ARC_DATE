    for j, (outer_left, inner_left) in enumerate(zip(outers, inners)):
        row = top + j
        inp[row, outer_left : inner_left + 1] = color
    inp[:, axis_left + 1 :] = BACKGROUND_COLOR

    if not _gen_passes_oracle(inp, out, outers, inners):
        return None
    return inp

