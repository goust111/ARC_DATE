+def _bbox_includes_yellow_only(grid: np.ndarray, bbox_corner: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox_corner)
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    return patch == Color.YELLOW
