+            for rr, cc in clues:
+                if int(rot[int(rr), int(cc)]) != int(q[int(rr), int(cc)]):
+                    ok = False
+                    break
+            if ok:
+                valid.append(idx)
+        candidates.append(valid)
+        assert valid, "no rotation can satisfy this quadrant"
