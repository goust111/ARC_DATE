+def _bbox_disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    a0, b0, a1, b1 = map(int, a)
+    c0, d0, c1, d1 = map(int, b)
+    return a1 < c0 or c1 < a0 or b1 < d0 or d1 < b0
