+
+def _assemble_output(frame: np.ndarray, assignment: tuple[int, int, int, int], rots: list[np.ndarray]) -> np.ndarray:
+    n2 = frame.shape[0] // 2
+    out = frame.copy()
+    for qi, rot_idx in enumerate(assignment):
+        q_r, q_c = _quadrants(n2)[qi]
+        out[q_r, q_c] = rots[rot_idx]
+    return out
