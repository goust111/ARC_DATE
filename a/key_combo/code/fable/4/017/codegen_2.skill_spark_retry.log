+            loc_sprite = (sr, sc, sr + sprite_size - 1, sc + sprite_size - 1)
+            if _bbox_disjoint(loc_frame, loc_sprite):
+                canvas = np.full((h, w), Color.BLACK, dtype=int)
+                paste(canvas, frame, tr, tc, clip=True)
+                paste(canvas, sprite, sr, sc, clip=True)
+                placed = True
+                break
+        if placed:
+            break
+    assert placed, "failed to place sprite and frame without overlap"
+    return canvas
+
+
+def _random_sprite(shape: int, rng: np.random.Generator) -> np.ndarray:
+    colors = [c for c in Color.NOT_BLACK if c != Color.YELLOW]
+    rng.shuffle(colors)
+    colors = [int(c) for c in colors[:4]]
+    palette = colors
+    sprite = np.array(
+        [[_random_choice(palette, int(palette[0])) for _ in range(shape)] for __ in range(shape)],
+        dtype=int,
+    )
+    # carve some zeros to keep irregular sparse support while preserving connectivity.
+    for rr in range(shape):
+        for cc in range(shape):
+            if rr == 0 and cc == 0:
+                continue
+            if rng.random() < 0.15:
+                sprite[rr, cc] = Color.BLACK
+    if not np.any(sprite != Color.BLACK):
+        sprite[0, 0] = palette[0]
+    return sprite
+
+
+def _make_distinct_rotations(sprite: np.ndarray) -> list[np.ndarray]:
+    rots = _rotations(sprite)
+    encoded = {rot.tobytes() for rot in rots}
+    if len(encoded) < 4:
