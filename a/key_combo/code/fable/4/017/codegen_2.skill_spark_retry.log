+    candidates: list[list[int]] = []
+    for q_r, q_c in quadrants:
+        q = frame[q_r, q_c]
+        clue_mask = (q != bg) & (~marker_mask[q_r, q_c])
+        clues = np.argwhere(clue_mask)
+        valid: list[int] = []
+        for idx, rot in enumerate(rots):
+            ok = True
+            for rr, cc in clues:
+                if int(rot[int(rr), int(cc)]) != int(q[int(rr), int(cc)]):
