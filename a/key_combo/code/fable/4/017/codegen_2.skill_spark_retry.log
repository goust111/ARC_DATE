+    for _ in range(500):
+        tr = int(rng.integers(0, h - frame_h + 1))
+        tc = int(rng.integers(0, w - frame_h + 1))
+        loc_frame = (tr, tc, tr + frame_h - 1, tc + frame_h - 1)
+        # Try to put the sprite outside the 2n×2n target block.
