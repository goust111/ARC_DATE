+    assignments: list[tuple[int, int, int, int]] = []
+    for perm in itertools.permutations(range(4)):
+        if all(int(perm[i]) in candidates[i] for i in range(4)):
+            assignments.append(tuple(map(int, perm)))
+    return assignments
