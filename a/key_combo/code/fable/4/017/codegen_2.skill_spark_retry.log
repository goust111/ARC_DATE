+def _random_sprite(shape: int, rng: np.random.Generator) -> np.ndarray:
+    colors = [c for c in Color.NOT_BLACK if c != Color.YELLOW]
+    rng.shuffle(colors)
+    colors = [int(c) for c in colors[:4]]
+    palette = colors
