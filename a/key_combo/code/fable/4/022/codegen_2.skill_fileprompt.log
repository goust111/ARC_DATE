+def _plus_intersection_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    row = random.randint(1, h - 2)
+    col = random.randint(1, w - 2)
+    mask[row, :] = True
+    mask[:, col] = True
