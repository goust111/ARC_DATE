def _touches_edge(b: tuple[int, int, int, int], h: int, w: int) -> bool:
    r0, c0, r1, c1 = b
    return r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1


def _axis_gap(a0: int, a1: int, b0: int, b1: int) -> int:
