+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            if cell in chosen:
+                continue
+            chosen.add(cell)
+            for nxt in _neighbors4(*cell):
+                if 0 <= nxt[0] < allowed.shape[0] and 0 <= nxt[1] < allowed.shape[1] and allowed[nxt] and nxt not in chosen:
