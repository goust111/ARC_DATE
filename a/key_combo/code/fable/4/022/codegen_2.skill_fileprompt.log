+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = list(range(1, 10))
+
+PANEL_H_RANGE = (6, 8)
+PANEL_W_RANGE = (6, 9)
+SHADOW_MIN_CELLS = 4
+SHADOW_MAX_CELLS = 8
+
+CANDIDATE_COUNT_CHOICES = (4, 5)
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 30)
+TOP_MARGIN_CHOICES = (0, 1)
+BOTTOM_GAP_RANGE = (2, 4)
+PLACEMENT_PAD = 1
+
+GENERATION_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
+    assert box is not None, "expected a non-empty mask"
+    r0, c0, r1, c1 = box
+    return np.asarray(mask[r0 : r1 + 1, c0 : c1 + 1], dtype=bool)
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return np.count_nonzero(mask) > 0 and len(_component_coords(mask)) == 1
+
+
+def _find_monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(set(map(int, grid.ravel())) - {int(bg)}):
+        for coords in _component_coords(grid == color):
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
+                }
+            )
+    return comps
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    mask = np.asarray(mask, dtype=bool)
+    return tuple(map(int, mask.shape)), mask.tobytes()
+
+
+def _orientations(mask: np.ndarray) -> list[np.ndarray]:
+    mask = _trim_mask(mask)
+    out: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for candidate in (rot, np.fliplr(rot)):
