+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = list(range(1, 10))
+
+PANEL_H_RANGE = (6, 8)
+PANEL_W_RANGE = (6, 9)
+SHADOW_MIN_CELLS = 4
+SHADOW_MAX_CELLS = 8
+
+CANDIDATE_COUNT_CHOICES = (4, 5)
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 30)
+TOP_MARGIN_CHOICES = (0, 1)
+BOTTOM_GAP_RANGE = (2, 4)
+PLACEMENT_PAD = 1
