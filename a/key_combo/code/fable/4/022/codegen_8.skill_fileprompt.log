+        for coords in _components(grid == color):
+            r0, c0, r1, c1 = _bbox(coords)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            local = np.zeros((h, w), dtype=bool)
+            local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
