+def _patch_coords(patch: np.ndarray, bg: int, r0: int, c0: int) -> np.ndarray:
+    coords = np.argwhere(patch != bg)
+    coords[:, 0] += int(r0)
+    coords[:, 1] += int(c0)
+    return coords
