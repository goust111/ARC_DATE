+                    mask[top + base_h, start_c : start_c + arm_w] = True
+            else:
+                arm_h = rng.randint(1, min(3, base_h - 2))
+                start_r = top + rng.randint(1, base_h - arm_h - 1)
+                if side == "left":
+                    mask[start_r : start_r + arm_h, left - 1] = True
+                else:
+                    mask[start_r : start_r + arm_h, left + base_w] = True
