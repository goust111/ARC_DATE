+    for (ti, tj), fill_color in target_to_color.items():
+        cr0, cc0, cr1, cc1 = _cavity_bounds(h_lines, v_lines, ti, tj)
+        region = out[cr0 : cr1 + 1, cc0 : cc1 + 1].copy()
+        region[region == BG] = fill_color
+        out[cr0 : cr1 + 1, cc0 : cc1 + 1] = region
