    canvas_boundary[:, 0] = True
    canvas_boundary[:, -1] = True

    adjacent_to_exterior = ndimage.binary_dilation(exterior, iterations=1)
    return (grid != bg) & (adjacent_to_exterior | canvas_boundary)


