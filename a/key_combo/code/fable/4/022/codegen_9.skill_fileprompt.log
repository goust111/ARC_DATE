+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 300
+
+PIECE_COUNT_CHOICES = (2, 3, 4)
+AMBIGUOUS_PAIR_PROB = 0.75
+SHAPE_HEIGHT_RANGE = (2, 4)
+SHAPE_WIDTH_RANGE = (2, 4)
