+        return (rows[1], cols[0]), "v"
+    return None
+
+
+def _find_bar_and_control(components: list[dict]) -> tuple[int, int, tuple[int, int], tuple[int, int]]:
+    singleton_at = {
+        (int(comp["coords"][0, 0]), int(comp["coords"][0, 1])): idx
