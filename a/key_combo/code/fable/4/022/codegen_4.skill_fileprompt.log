+VERTICAL_RAY_DIMS = ((1, 1), (1, 2), (2, 1), (2, 2), (2, 3))
+HORIZONTAL_RAY_DIMS = ((1, 1), (2, 1), (1, 2), (2, 2), (3, 2))
