+                    "color": color,
+                    "coords": coords,
+                    "area": int(coords.shape[0]),
+                    "bbox": _bbox(coords),
+                }
+            )
+    return comps
+
+
+def _line3_info(coords: np.ndarray) -> tuple[tuple[int, int], str] | None:
