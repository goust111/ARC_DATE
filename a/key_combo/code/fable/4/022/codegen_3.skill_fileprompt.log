def _outward_dir(t: tuple[int, int], b: tuple[int, int, int, int]) -> tuple[int, int]:
    r, c = t
    r0, c0, r1, c1 = b
    dr = -1 if r < r0 else 1 if r > r1 else 0
    dc = -1 if c < c0 else 1 if c > c1 else 0
