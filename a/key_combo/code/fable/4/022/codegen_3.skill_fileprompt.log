        if contacts == 0:
            continue
        cands.append((color, added, touched, int(wall_mask.sum()), contacts))
    if not cands:
        results['"'no_cands'] += 1
        continue
    best1 = min(cands, key=lambda x: (x[2], x[3], -x[4], x[0]))[0]
    best2 = min(cands, key=lambda x: (x[3], x[2], -x[4], x[0]))[0]
    best3 = min(cands, key=lambda x: ((0 if x[1] > 0 else 1), x[2], x[3], -x[4], x[0]))[0]
    results['total'] += 1
