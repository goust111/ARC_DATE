    wall_color, indicator_color = rng.sample(mod.PALETTE, 2)
    filler_palette = rng.sample([c for c in mod.PALETTE if c not in (wall_color, indicator_color)], rng.randint(2,4))
    full = np.zeros((h,w), dtype=int)
    orbits = mod._all_orbits(h,w)
    wall_cells = {tuple(cell) for cell in np.argwhere(wall)}
    inside_cells = {tuple(cell) for cell in np.argwhere(inside)}
    inside_orbits=[]
    for orbit in orbits:
        if all(cell in wall_cells for cell in orbit):
            for r,c in orbit: full[r,c] = wall_color
        elif all(cell in inside_cells for cell in orbit):
            inside_orbits.append(orbit)
        else:
            col = rng.choice(filler_palette)
            for r,c in orbit: full[r,c] = col
    indicator_orbit = rng.choice([o for o in inside_orbits if len(o)>1] or inside_orbits)
    for r,c in indicator_orbit: full[r,c] = indicator_color
    for orbit in inside_orbits:
        if orbit == indicator_orbit: continue
        col = rng.choice(filler_palette)
        for r,c in orbit: full[r,c] = col
    inp = full.copy()
    wall_orbits = [orbit for orbit in orbits if any(cell in wall_cells for cell in orbit)]
    erasable_wall_orbits = [orbit for orbit in wall_orbits if len(orbit)>=2]
    if not erasable_wall_orbits:
        continue
    for orbit in rng.sample(erasable_wall_orbits, rng.randint(1, min(3, len(erasable_wall_orbits)))):
        mod._erase_subset(inp, orbit, rng, keep_at_least_one=True)
    survivor = rng.choice(list(indicator_orbit))
    for r,c in indicator_orbit:
        if (r,c) "'!= survivor:
            inp[r,c] = mod.BLACK
    interior_orbits=[]; exterior_orbits=[]
    for orbit in orbits:
        if orbit == indicator_orbit or any(cell in wall_cells for cell in orbit):
            continue
        if all(cell in inside_cells for cell in orbit): interior_orbits.append(orbit)
        elif not any(cell in inside_cells for cell in orbit): exterior_orbits.append(orbit)
    if interior_orbits:
        for orbit in rng.sample(interior_orbits, rng.randint(1, min(4, len(interior_orbits)))):
            mod._erase_subset(inp, orbit, rng, keep_at_least_one=False)
    if exterior_orbits:
        for orbit in rng.sample(exterior_orbits, rng.randint(0, min(4, len(exterior_orbits)))):
            mod._erase_subset(inp, orbit, rng, keep_at_least_one=False)
    if mod._unique_color_count(inp) != 1 or int(np.count_nonzero(inp == indicator_color)) != 1:
        continue
    leak = mod._flood_region(inp == wall_color, survivor)
    if not mod._touches_border(leak):
        continue
    hs = mod._infer_axis(inp, vertical=False)
    vs = mod._infer_axis(inp, vertical=True)
    non_black = inp[inp != mod.BLACK]
