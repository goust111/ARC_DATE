+        rr, cc = int(r), int(c)
+        if seen[rr, cc]:
+            continue
+        count += 1
+        queue = deque([(rr, cc)])
+        seen[rr, cc] = True
+        while queue:
+            cr, cc = queue.popleft()
+            for nr, nc in _neighbors4(cr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
