from __future__ import annotations
import random
from collections import deque
import numpy as np

BLACK = 0

def neighbors4(r,c):
    yield r-1,c
    yield r+1,c
    yield r,c-1
    yield r,c+1

def infer_axis(g, vertical):
    H,W = g.shape
    size = W if vertical else H
    center = size - 1
    coords = np.argwhere(g "'!= BLACK)
    best = None
    for s in range(2*size - 1):
        contradictions = support = missing = 0
        for r,c in coords:
            rr, cc = int(r), int(c)
            other = s - (cc if vertical else rr)
            if not (0 <= other < size):
                contradictions += 1
                continue
            v = int(g[rr,cc])
            ov = int(g[rr,other] if vertical else g[other,cc])
            if ov == BLACK:
                missing += 1
            elif ov == v:
                support += 1
            else:
                contradictions += 1
        score = (contradictions, -support, missing, abs(s-center))
        if best is None or score < best[0]:
            best = (score, s)
    return best[1]

def orbit(r,c,hs,vs,H,W):
    pts = {(r,c), (hs-r,c), (r,vs-c), (hs-r,vs-c)}
    return tuple(sorted((rr,cc) for rr,cc in pts if 0 <= rr < H and 0 <= cc < W))

def repair(g, color, hs, vs):
    H,W = g.shape
    out = g.copy()
    seen = set()
    added = mixed = touched = 0
    for r in range(H):
        for c in range(W):
            key = orbit(r,c,hs,vs,H,W)
            if key in seen:
                continue
            seen.add(key)
            vals = {int(g[rr,cc]) for rr,cc in key if int(g[rr,cc]) != BLACK}
            if color not in vals:
                continue
            touched += 1
            if any(v not in (BLACK, color) for v in vals):
                mixed += 1
                continue
            for rr,cc in key:
                if int(out[rr,cc]) == BLACK:
                    out[rr,cc] = color
                    added += 1
    return out, added, mixed, touched

def flood(blocked, start):
    H,W = blocked.shape
    sr,sc = start
    if blocked[sr,sc]:
        return np.zeros_like(blocked, dtype=bool)
    seen = np.zeros_like(blocked, dtype=bool)
    dq = deque([start])
    seen[sr,sc] = True
    while dq:
        r,c = dq.popleft()
        for nr,nc in neighbors4(r,c):
            if 0 <= nr < H and 0 <= nc < W and not blocked[nr,nc] and not seen[nr,nc]:
                seen[nr,nc] = True
                dq.append((nr,nc))
    return seen

def comp_count(mask):
    H,W = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    n=0
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]:
            continue
        n += 1
        dq = deque([(r,c)])
        seen[r,c] = True
        while dq:
            rr,cc = dq.popleft()
            for nr,nc in neighbors4(rr,cc):
                if 0 <= nr < H and 0 <= nc < W and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc] = True
                    dq.append((nr,nc))
    return n

def choose_wall(g):
    nonzero = g[g!=0]
    cols, counts = np.unique(nonzero, return_counts=True)
    uniq = [int(c) for c,n in zip(cols, counts) if int(n) == 1]
    assert len(uniq)==1
    ind_col = uniq[0]
    pos = tuple(map(int, np.argwhere(g == ind_col)[0]))
    hs = infer_axis(g, False)
    vs = infer_axis(g, True)
    opts=[]
    for color in sorted(set(map(int, nonzero)) - {ind_col}):
        repaired, added, mixed, touched = repair(g, color, hs, vs)
        if mixed:
            continue
        blocked = repaired == color
        region = flood(blocked, pos)
        border = bool(region[0].any() or region[-1].any() or region[:,0].any() or region[:,-1].any())
        if border:
            continue
        adj = np.zeros_like(region)
        contacts = 0
        for r,c in np.argwhere(region):
            r=int(r); c=int(c)
            for nr,nc in neighbors4(r,c):
                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and blocked[nr,nc]:
                    adj[nr,nc] = True
                    contacts += 1
        if contacts == 0 or comp_count(adj) != 1:
            continue
        score = (int(added > 0), contacts, int(adj.sum()), touched, int(blocked.sum()))
        opts.append((score, color, repaired, region))
    assert opts, '"'no wall'
    opts.sort()
    return hs,vs,ind_col,pos,opts[-1]

def boundary(mask):
    H,W = mask.shape
    out = np.zeros_like(mask)
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        for nr,nc in neighbors4(r,c):
            if not (0 <= nr < H and 0 <= nc < W) or not mask[nr,nc]:
                out[r,c] = True
                break
    return out

def make_blob(H,W,rng):
    cr, cc = H//2, W//2
    for _ in range(200):
        radius = rng.randint(3, min(cr-2, 7))
        center_half = rng.randint(3, min(cc-2, 8))
        prof=[center_half]
        cur=center_half
        for _d in range(1, radius+1):
            cur = rng.randint(max(1, cur-2), cur)
            prof.append(cur)
        mask = np.zeros((H,W), dtype=bool)
        for d,half in enumerate(prof):
            cols = slice(cc-half, cc+half+1)
            mask[cr-d, cols] = True
            mask[cr+d, cols] = True
        wall = boundary(mask)
        inside = mask & ~wall
        if inside.sum() >= 8 and wall.sum() >= 16:
            return mask, wall, inside
    raise RuntimeError

def iter_orbits(H,W):
    hs,vs = H-1, W-1
    seen=set()
    out=[]
    for r in range(H):
        for c in range(W):
            o=orbit(r,c,hs,vs,H,W)
            if o in seen:
                continue
            seen.add(o)
            out.append(o)
    return out

def gen():
    rng = random.Random()
    for attempt in range(500):
        H = rng.randrange(13, 30, 2)
        W = rng.randrange(13, 30, 2)
        mask, wall, inside = make_blob(H,W,rng)
        wall_color, ind_color = rng.sample(range(1,10), 2)
        fillers = rng.sample([c for c in range(1,10) if c not in (wall_color, ind_color)], rng.randint(2,4))
        full = np.zeros((H,W), dtype=int)
        hs,vs = H-1, W-1
        orbit_list = iter_orbits(H,W)
        inside_set = {tuple(x) for x in np.argwhere(inside)}
        wall_set = {tuple(x) for x in np.argwhere(wall)}
        inside_orbits=[]
        for o in orbit_list:
            if all(p in wall_set for p in o):
                for r,c in o: full[r,c]=wall_color
            elif all(p in inside_set for p in o):
                inside_orbits.append(o)
            else:
                col = rng.choice(fillers)
                for r,c in o: full[r,c]=col
        pref=[o for o in inside_orbits if len(o) > 1]
        ind_orbit = rng.choice(pref or inside_orbits)
        for r,c in ind_orbit: full[r,c]=ind_color
        for o in inside_orbits:
            if o == ind_orbit:
                continue
            col = rng.choice(fillers)
            for r,c in o: full[r,c]=col
        inp = full.copy()
        wall_orbits = [o for o in orbit_list if any(wall[p] for p in o)]
        erasable_wall = [o for o in wall_orbits if len(o) >= 2]
        if not erasable_wall:
            continue
        for o in rng.sample(erasable_wall, rng.randint(1, min(3, len(erasable_wall)))):
            k = rng.randint(1, len(o)-1)
            for r,c in rng.sample(list(o), k):
                inp[r,c] = 0
        survivor = rng.choice(list(ind_orbit))
        for r,c in ind_orbit:
            if (r,c) "'!= survivor:
                inp[r,c] = 0
        nonwall_out=[]
        nonwall_in=[]
        for o in orbit_list:
            if o == ind_orbit or any(wall[p] for p in o):
                continue
            if all(p in inside_set for p in o):
                nonwall_in.append(o)
            elif not any(p in inside_set for p in o):
                nonwall_out.append(o)
        for pool, lo, hi in ((nonwall_in, 1, 4), (nonwall_out, 0, 4)):
            if not pool:
                continue
            count = rng.randint(lo, min(hi, len(pool)))
            for o in rng.sample(pool, count):
                k = rng.randint(1, len(o))
                for r,c in rng.sample(list(o), k):
                    inp[r,c] = 0
        expected = inp.copy()
        expected[wall] = wall_color
        expected[inside] = ind_color
        if np.count_nonzero(inp == ind_color) != 1:
            continue
        leak = flood(inp == wall_color, survivor)
        if not (leak[0].any() or leak[-1].any() or leak[:,0].any() or leak[:,-1].any()):
            continue
        try:
            hs2,vs2,ind_col,pos,opt = choose_wall(inp)
            out = opt[2].copy(); out[opt[3]] = ind_col
        except Exception:
            continue
        if not np.array_equal(out, expected):
            print('"'mismatch', attempt, inp.shape)
            print(hs2,vs2, wall_color, ind_col, pos, opt[1], opt[0])
            return inp, expected, out
    print('success')
    return None

bad = gen()
if bad is None:
    print('ok')
