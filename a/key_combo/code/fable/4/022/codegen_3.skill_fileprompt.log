+BLACK = 0
+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() or mask[-1].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _flood_region(blocked: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = blocked.shape
+    sr, sc = map(int, start)
+    if blocked[sr, sc]:
+        raise AssertionError("start point cannot be inside the wall")
+
+    region = np.zeros((h, w), dtype=bool)
+    queue = deque([(sr, sc)])
+    region[sr, sc] = True
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc] and not region[nr, nc]:
+                region[nr, nc] = True
+                queue.append((nr, nc))
+    return region
+
+
+def _component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+
+    for r, c in np.argwhere(mask):
+        rr, cc = int(r), int(c)
+        if seen[rr, cc]:
+            continue
+        count += 1
+        queue = deque([(rr, cc)])
+        seen[rr, cc] = True
+        while queue:
+            cr, cc = queue.popleft()
+            for nr, nc in _neighbors4(cr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+    return count
+
+
+def _infer_axis(grid: np.ndarray, *, vertical: bool) -> int:
+    h, w = grid.shape
+    size = w if vertical else h
+    center = size - 1
+    coords = np.argwhere(grid != BLACK)
+    best: tuple[tuple[int, int, int, int], int] | None = None
+
+    for axis_sum in range(2 * size - 1):
+        contradictions = 0
+        support = 0
+        missing = 0
+        for r, c in coords:
+            rr, cc = int(r), int(c)
+            reflected = axis_sum - (cc if vertical else rr)
+            if not 0 <= reflected < size:
+                contradictions += 1
+                continue
+            value = int(grid[rr, cc])
+            other = int(grid[rr, reflected] if vertical else grid[reflected, cc])
+            if other == BLACK:
+                missing += 1
+            elif other == value:
+                support += 1
+            else:
+                contradictions += 1
+
+        score = (contradictions, -support, missing, abs(axis_sum - center))
+        if best is None or score < best[0]:
+            best = (score, axis_sum)
+
+    assert best is not None
+    return int(best[1])
