+        region = _flood_region(wall_mask, indicator_pos)
+        if _touches_border(region):
+            continue
+
+        adjacent_wall, contacts = _adjacent_wall_mask(region, wall_mask)
+        if contacts == 0:
+            continue
+
+        score = (
+            0 if added > 0 else 1,
+            touched_orbits,
+            int(wall_mask.sum()),
+            -contacts,
+            wall_color,
