+
+def _boundary(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    boundary = np.zeros((h, w), dtype=bool)
+
+    for r, c in np.argwhere(mask):
+        rr, cc = int(r), int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                boundary[rr, cc] = True
+                break
+    return boundary
