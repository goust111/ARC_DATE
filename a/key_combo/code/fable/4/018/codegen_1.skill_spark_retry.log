        continue

    marker_candidates = mod._collect_markers(grid, bg)
    if len(marker_candidates) "'!= 2:
        reasons[mode]['"'collect'] = reasons[mode].get('collect',0)+1
        continue

    reasons[mode]['ok'] += 1
    if reasons[mode]['ok'] >= 1:
        print('first ok mode', mode, 'attempt', attempt, 'shape', grid.shape)
        break

print(reasons)
