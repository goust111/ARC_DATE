        assert len(gaps) == 1
        assert len(frame_neighbors) == 3

        _, dr, dc, gap_r, gap_c = gaps[0]
        ext_r, ext_c = r + 2 * dr, c + 2 * dc
        assert in_bounds(g.shape, ext_r, ext_c)
