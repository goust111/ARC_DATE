        (r - 1, c + 1),
        (r, c - 1),
        (r, c + 1),
        (r + 1, c - 1),
        (r + 1, c),
        (r + 1, c + 1),
        (r, c),
    ]

    gap = (r + dr, c + dc)
    ext = (r + 2 * dr, c + 2 * dc)

    if not in_bounds(grid.shape, *ext):
        return None
    if not in_bounds(grid.shape, *gap):
        return None
    if not in_bounds(grid.shape, r - 1, c - 1) or not in_bounds(grid.shape, r + 1, c + 1):
        return None

    all_cells = ring + [ext]
    for rr, cc in all_cells:
        if int(grid[rr, cc]) "'!= Color.BACKGROUND:
            return None

    for rr, cc in ring:
        grid[rr, cc] = Color.GREY

    # Keep marker as gray too, like the reference 692cd3b6-style doorway grammar.
    grid[gap] = Color.BACKGROUND
    return (r, c), gap, ext


'"'''
