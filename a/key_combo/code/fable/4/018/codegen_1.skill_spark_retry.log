    if random.random() < MIRROR_PROB:
        arr[:, 1] *= -1
    return _gen_norm_coords(map(tuple, arr))


def _gen_polyomino(area):
    cells = {(0, 0)}
    frontier = {(0, 1), (1, 0), (0, -1), (-1, 0)}
    while len(cells) < area:
        cell = random.choice(tuple(frontier))
        cells.add(cell)
        frontier.remove(cell)
