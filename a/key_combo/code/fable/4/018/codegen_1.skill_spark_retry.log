        r_mid0 = min(ext_positions[0][0], ext_positions[1][0]) - 1
        r_mid1 = max(ext_positions[0][0], ext_positions[1][0]) + 1
        c_mid0 = min(ext_positions[0][1], ext_positions[1][1]) - 1
        c_mid1 = max(ext_positions[0][1], ext_positions[1][1]) + 1
        if 0 <= r_mid0 - 3 < H and 0 <= r_mid1 + 3 <= H and 0 <= c_mid0 - 3 < W and 0 <= c_mid1 + 3 <= W:
            mod._place_block(
                grid,
                color,
                min_row=max(0, r_mid0 - 3),
                max_row=min(H - 1, r_mid1 + 3),
                min_col=max(0, c_mid0 - 3),
                max_col=min(W - 1, c_mid1 + 3),
                max_h=3,
                max_w=3,
            )

    try:
        _ = mod.main(grid)
