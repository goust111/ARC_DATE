    half_w = W // 2
    mode = random.choice([\"diag\", \"diag\", \"diag\", \"row\", \"col\", \"row\", \"col\"])
    reasons[mode]['total'] += 1

    if mode == \"diag\":
        r1 = mod._rand_between(4, max(5, half_h - 3))
        if r1 is None:
            reasons[mode]['place_center'] = reasons[mode].get('place_center',0)+1
            continue
        r2 = mod._rand_between(max(int(r1)+4, half_h + 3), H - 4)
        c1 = mod._rand_between(4, max(5, half_w - 3))
        if c2 := mod._rand_between(max(half_w + 3, int(c1) + 4), W - 4):
            pass
        else:
            reasons[mode]['place_center'] = reasons[mode].get('place_center',0)+1
            continue
        centers = [(int(r1), int(c1)), (int(r2), int(c2))]
    elif mode == \"row\":
        r = int(np.random.randint(4, H - 4))
        c1 = mod._rand_between(4, max(5, half_w - 3))
        c2 = mod._rand_between(half_w + 3, W - 4)
        if c1 is None or c2 is None or int(c1) + 2 >= int(c2):
            reasons[mode]['place_center'] = reasons[mode].get('place_center',0)+1
            continue
        centers = [(r, c1), (r, c2)]
    else:
        c = int(np.random.randint(4, W - 4))
        r1 = mod._rand_between(4, max(5, half_h - 3))
        if r1 is None:
            reasons[mode]['place_center'] = reasons[mode].get('place_center',0)+1
            continue
        r2 = mod._rand_between(half_h + 3, H - 4)
        if r2 is None:
            reasons[mode]['place_center'] = reasons[mode].get('place_center',0)+1
            continue
        centers = [(r1, c), (r2, c)]

    doors = []
    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    order = list(range(2))
    random.shuffle(order)
    ok = True
    for idx in order:
        center = centers[idx]
        placed = False
        for _ in range(8):
            direction = random.choice(directions)
            placement = mod._place_frame(grid, center, direction)
            if placement is None:
                continue
            doors.append(((placement[0], placement[1]), placement[2]))
            placed = True
            break
        if not placed:
            ok = False
            break
    if not ok:
        reasons[mode]['frame'] = reasons[mode].get('frame',0)+1
        continue

    marker_positions = [d[0][0] for d in doors]
    outer_positions = [d[0][1] for d in doors]
    ext_positions = [d[1] for d in doors]
    if len(set(marker_positions)) "'!= 2 or len(set(outer_positions)) != 2 or len(set(ext_positions)) != 2:
        reasons[mode]['"'marker_distinct'] = reasons[mode].get('marker_distinct',0)+1
        continue

    available_colors = random.sample(mod.non_gray_palette, k=random.randint(0, min(5, len(mod.non_gray_palette)))) if 'mod.non_gray_palette' in vars(mod) else []
    num_blocks = random.randint(0, 5)
    num_blocks = min(num_blocks, len(available_colors))
    for i in range(num_blocks):
        color = available_colors[i % len(available_colors)]
        mod._place_block(
            grid,
            color,
            min_row=1,
            max_row=max(1, H // 2 - 1),
            min_col=1,
            max_col=W - 2,
            max_h=4,
            max_w=4,
        )

    if random.random() < 0.7:
        color_pool = [c for c in mod.Color.NOT_BLACK if c not in set(grid.flatten())]
        color_pool = [c for c in color_pool if c "'!= bg and c != mod.Color.GREY]
