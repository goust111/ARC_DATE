+    min_height = max(1, (2 * total_height) // width + 1)
+    return min_height
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATE_ATTEMPTS):
+        try:
+            num_bars = random.randint(1, min(5, len(Color.NOT_BLACK), MAX_SIZE // 2))
