+            BLACK = 0
+
+        def get_bg(grid: np.ndarray) -> int:
+            values, counts = np.unique(grid.astype(int), return_counts=True)
+            return int(values[np.argmax(counts)])
+
+
+MAX_SIZE = 30
+MAX_TOTAL_HEIGHT = 14
+MAX_GENERATE_ATTEMPTS = 300
