def _make_template(k: int, color: int, bg: int) -> np.ndarray:
    while True:
        patch = np.full((k, k), int(color), dtype=int)
        for r in range(k):
            for c in range(k):
                if random.random() < 0.32:
                    patch[r, c] = bg

        non_bg = np.count_nonzero(patch != bg)
        bg_count = int((patch == bg).sum())
        if non_bg > 0 and bg_count > 0:
            return patch


def _stitch_left_panel(h: int, k: int, templates: list[tuple[int, np.ndarray]]) -> np.ndarray:
    panel = np.full((h, k), BG, dtype=int)
    for i, (color, sprite) in enumerate(templates):
        r0 = i * k
        r1 = r0 + k
        panel[r0:r1, :] = sprite
    return panel


def _stitch_right_panel(
    h: int,
    slot_cols: int,
    k: int,
    template_colors: list[int],
    templates: dict[int, np.ndarray],
    bg: int,
) -> np.ndarray:
    out = np.full((h, slot_cols * k), BG, dtype=int)
    slot_count = (h // k) * slot_cols
    slots = list(range(slot_count))
    random.shuffle(slots)

    overlap_pairs = [
        (ci, cj)
        for i, ci in enumerate(template_colors)
        for cj in template_colors[i + 1 :]
        if np.any((templates[ci] != bg) & (templates[cj] != bg))
    ]

    if overlap_pairs and random.random() < 0.85:
        n_double = random.randint(1, min(2, slot_count - 1))
    else:
        n_double = 0

    n_single = 0
    remaining = slot_count - n_double
    if remaining > 0:
        # Keep some empties so not every slot is marked.
        low = 1 if not n_double else 0
        n_single = random.randint(low, max(1, remaining))
        n_single = min(n_single, remaining)

    # Fill selected slots with markers.
    cursor = 0

    def write_single(slot: int) -> None:
        sr, sc = divmod(slot, slot_cols)
        r0 = sr * k
        c0 = sc * k
        pos = random.randrange(k * k)
        rr = r0 + pos // k
        cc = c0 + pos % k
        color = random.choice(template_colors)
        out[rr, cc] = color

    def write_double(slot: int) -> None:
        sr, sc = divmod(slot, slot_cols)
        r0 = sr * k
        c0 = sc * k
        color_a, color_b = random.choice(overlap_pairs)

        same_row = random.random() < 0.35
        if same_row:
            row = random.randrange(k)
            c1, c2 = random.sample(range(k), 2)
            p1 = (r0 + row, c0 + min(c1, c2))
            p2 = (r0 + row, c0 + max(c1, c2))
        else:
            pos1 = random.randrange(k * k)
            pos2 = random.randrange(k * k - 1)
            if pos2 >= pos1:
                pos2 += 1
            p1 = (r0 + pos1 // k, c0 + pos1 % k)
            p2 = (r0 + pos2 // k, c0 + pos2 % k)
            if p1[0] > p2[0]:
