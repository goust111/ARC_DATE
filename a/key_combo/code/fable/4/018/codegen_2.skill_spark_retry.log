            assert len(marks) <= 2, "slot must contain at most two markers"
            if len(marks) == 1:
                _, _, color = marks[0]
                assert color in templates, "single marker must match a source template color"
                out[r0:r1, c0:c1] = templates[color]
                continue

            (rb, cb, color_b), (rt, ct, color_t) = _base_overlay_order(marks)
            assert color_b != color_t, "double markers must have two different template colors"
            assert color_b in templates and color_t in templates, "double markers must map to known template colors"
