def _parse_templates(left: np.ndarray, bg: int) -> dict[int, np.ndarray]:
    h, k = left.shape
    assert h > 0 and k > 0, "left panel must be non-empty"
    assert h % k == 0, "left panel height must be a multiple of template size"

    templates: dict[int, np.ndarray] = {}
    for r0 in range(0, h, k):
        template = left[r0 : r0 + k, :]
        non_bg_colors = colors_present(template, exclude={bg})
        if not non_bg_colors:
            continue
        assert len(non_bg_colors) == 1, "each template must use one color plus background holes"
        color = int(non_bg_colors[0])
        assert color not in templates, "template colors must be unique"
        templates[color] = template.copy()

    assert templates, "at least one template is required"
    return templates


def _markers_in_slot(slot: np.ndarray, bg: int) -> tuple[tuple[int, int, int], ...]:
    cells = np.argwhere(slot != bg)
    return tuple((int(r), int(c), int(slot[int(r), int(c)])) for r, c in cells)


def _base_overlay_order(markers: tuple[tuple[int, int, int], tuple[int, int, int]]) -> tuple[
    tuple[int, int, int],
    tuple[int, int, int],
]:
    (r1, c1, color1), (r2, c2, color2) = markers
    if r1 < r2:
        return (r1, c1, color1), (r2, c2, color2)
    if r2 < r1:
        return (r2, c2, color2), (r1, c1, color1)
    return (r1, min((c1, color1), (c2, color2)), max((c1, color2)))


def _overlay_slot(base: np.ndarray, top: np.ndarray, bg: int) -> np.ndarray:
    out = base.copy()
    overlay = top != bg
    out[overlay] = top[overlay]
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Stamp slot templates from marker colors, honoring marker ordering in double-marker slots.

    Input structure:
    - The grid has a single full-height divider column, splitting source templates and target slots.
    - Left side contains stacked k×k templates of distinct colors, each possibly with background holes.
    - Right side is partitioned into k×k slots, each containing zero, one, or two marker pixels.
    - Marker color maps to a template color.

    Rule:
    - Keep divider, left-side templates, and untouched slots unchanged except where stamped.
    - For each slot with one marker, stamp the matching template over the slot.
    - For each slot with two markers, use row order (upper first; tie by left first) to pick base and overlay templates:
      paint the base first, then overlay top template where it is non-background, letting background holes reveal the base.
    - The slot markers are always covered by stamping.

    Key insight:
    - Two markers define stack order by position, so overlap behavior in marker cells is explained by transparent hole composition, not color blending.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0

    h, w = g.shape
    bg = int(get_bg(g))
    divider_col, _divider_color = _divider_info(g)
