    k = divider_col
    left = g[:, :k]
    right = g[:, divider_col + 1 :]
    assert right.shape[1] % k == 0, "right panel width must be partitionable into k×k slots"

    templates = _parse_templates(left, bg=bg)
    assert len(templates) * k == h or right.shape[0] == h
    assert h % k == 0, "grid height must partition into k×k slot rows"

    out = g.copy()
    slot_rows = h // k
    slot_cols = right.shape[1] // k

    for sr in range(slot_rows):
        r0 = sr * k
        r1 = r0 + k
        for sc in range(slot_cols):
            c0 = divider_col + 1 + sc * k
            c1 = c0 + k
            slot = g[r0:r1, c0:c1]

            marks = _markers_in_slot(slot, bg)
            if not marks:
