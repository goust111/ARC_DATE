+def _segment_columns(foot_col: int, height: int, width: int, direction: int) -> list[int]:
+    if direction == 1:
+        end_col = min(width - 1, foot_col + height - 1)
+        return list(range(foot_col, end_col + 1))
+    start_col = max(0, foot_col - height + 1)
+    return list(range(start_col, foot_col + 1))
