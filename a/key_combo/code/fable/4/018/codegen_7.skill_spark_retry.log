+def _extract_poles(grid: np.ndarray, bg: int) -> dict[int, dict]:
+    components = find_components(grid, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
+    poles: dict[int, dict] = {}
+    for comp in components:
+        color = int(comp["color"])
+        if color == bg or color == Color.GREY:
+            continue
+
+        coords = np.asarray(comp["coords"], dtype=int)
+        cols = np.unique(coords[:, 1])
+        rows = np.unique(coords[:, 0])
+        if cols.size != 1:
+            continue
+        if rows.size != (rows.max() - rows.min() + 1):
+            continue
+
+        poles[color] = {
+            "coords": coords,
+            "col": int(cols[0]),
+            "top_row": int(rows.min()),
+            "foot_row": int(rows.max()),
+            "height": int(rows.size),
+        }
+    return poles
+
