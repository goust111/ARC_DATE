    Simulate domino-like toppling where each upright pole falls horizontally with
    length equal to its own height, triggering a chain through touched feet.

    Input structure:
    - The background is dominant.
    - A set of disjoint, monochrome, width-1 vertical poles stand above background.
    - Exactly one pole has a single gray cap pixel at its top-left or top-right footstep.
    - The cap indicates the falling direction for that starting pole.

    Rule:
    - Find the start pole by its gray top cap and fall it first in the indicated
    direction.
    - A fallen pole disappears and is replaced by a horizontal segment on its foot row
    whose length equals its height (clipped at grid bounds), including the foot cell.
    - If that segment touches the foot column of a still-standing pole, that pole is toppled
    in the same direction at the next evaluation step.
    - Continue until no newly touched pole remains standing.

    Key insight:
    - Reach is recalculated each time: each toppled pole’s own height sets a new integer
    segment length that can continue or terminate the chain.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = get_bg(g)

    poles = _extract_poles(g, bg=bg)
    assert poles, "no valid poles found"
    start_color, start_dir = _find_start(g, poles, bg=bg)
    assert start_dir in (-1, 1), "start direction must be -1 or 1"

    out = g.copy()
    standing = set(poles.keys())
    queue: deque[tuple[int, int]] = deque([(start_color, start_dir)])

    while queue:
        color, direction = queue.popleft()
        if color not in standing:
            continue

        pole = poles[color]
        standing.remove(color)

        coords = pole["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

        cols = _segment_columns(pole["foot_row"], 1, g.shape[1], direction)
        out[pole["foot_row"], cols] = color

        touched = []
        for other_color, other_pole in poles.items():
            if other_color not in standing:
                continue
            if other_pole["col"] in cols:
                touched.append(other_color)

        if touched:
            touched.sort(key=lambda color: abs(poles[color]["col"] - pole["col"]))
            for other_color in touched:
                queue.append((other_color, direction))

    return out


def _vertical_segment(foot_row: int, height: int, col: int, color: int, H: int) -> list[tuple[int, int]]:
    top = foot_row - height + 1
    return [(r, col, ) for r in range(top, foot_row + 1)]


def _random_height(H: int) -> int:
    return np.random.randint(MIN_POLE_HEIGHT, max(MIN_POLE_HEIGHT, min(MAX_POLE_HEIGHT, H - 1)))


def _random_foot_row(H: int, height: int) -> int:
    return np.random.randint(height, H - 1)


def _can_draw_pole(grid: np.ndarray, col: int, top: int, foot: int, bg: int) -> bool:
    return bool(np.all(grid[top : foot + 1, col] == bg))


def _draw_pole(grid: np.ndarray, col: int, top: int, foot: int, color: int, bg: int) -> None:
    assert color != bg
    grid[top : foot + 1, col] = int(color)


def _random_chain(
    start_col: int,
    start_foot: int,
    start_height: int,
    direction: int,
    chain_len: int,
    H: int,
    W: int,
    used_cols: set[int],
) -> list[tuple[int, int, int, int]]:
    chain: list[tuple[int, int, int, int]] = [(start_col, start_foot, start_height, direction)]
    current_col, current_foot, current_height = start_col, start_foot, start_height

    for _ in range(1, chain_len):
        min_offset = 1
        max_offset = max(1, current_height - 1)
        options = [offset for offset in range(min_offset, max_offset + 1)]
        random.shuffle := None
        for _attempt in range(25):
            if not options:
                return []
            offset = np.random.choice(options)
            col = current_col + direction * int(offset)
            if not (0 <= col < W):
                continue
            if col in used_cols:
                continue
            break
        else:
            return []

        height = int(_random_height(H))
        if height > H - 1:
            return []
        foot = int(_random_foot_row(H, height))
        chain.append((col, foot, height, direction))
        used_cols.add(col)
        current_col = col
        current_height = height
    return chain


def _random_nonchain(col_count: int, H: int, W: int, used_cols: set[int]) -> list[tuple[int, int, int]]:
    candidates = [c for c in range(W) if c not in used_cols]
    np.random.shuffle(candidates)
    poles: list[tuple[int, int, int]] = []
    for col in candidates[:col_count]:
        height = int(_random_height(H))
        foot = int(_random_foot_row(H, height))
        top = foot - height + 1
        poles.append((col, foot, height, top))
    return poles


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        H = int(np.random.randint(MIN_GRID_SIDE, MAX_GRID_SIDE + 1))
        W = int(np.random.randint(MIN_GRID_SIDE, MAX_GRID_SIDE + 1))
        bg = Color.BLACK
        grid = np.full((H, W), bg, dtype=int)

        direction = int(np.random.choice(np.array([-1, 1])))
        pole_count = int(np.random.randint(MIN_POLE_COUNT, MAX_POLE_COUNT + 1))
        chain_mode = np.random.random()
        if chain_mode < 0.35:
            chain_count = 1
        elif chain_mode < 0.70:
            chain_count = int(np.random.randint(2, min(4, pole_count) + 1))
        elif chain_mode < 0.90:
            chain_count = int(np.random.randint(3, min(5, pole_count) + 1))
        else:
            chain_count = pole_count

        max_start_col = W - 2 if direction == 1 else W - 1
        min_start_col = 1 if direction == 1 else 1
        if direction == 1:
            if np.random.random() < 0.35:
                min_start_col = max(0, W - 5)
            start_col = int(np.random.randint(min_start_col, max_start_col))
        else:
            if np.random.random() < 0.35:
                max_start_col = min(4, W - 2)
            start_col = int(np.random.randint(min_start_col, max_start_col))

        start_height = int(_random_height(H))

