+def _find_start(grid: np.ndarray, poles: dict[int, dict], bg: int) -> tuple[int, int]:
+    gray_cells = np.argwhere(grid == Color.GREY)
+    assert gray_cells.shape == (1, 2), "input must contain exactly one gray cap pixel"
+
+    hat_r, hat_c = map(int, gray_cells[0])
+    candidates: list[tuple[int, int]] = []
+    for color, pole in poles.items():
+        if pole["top_row"] != hat_r:
+            continue
+        if abs(pole["col"] - hat_c) != 1:
+            continue
+        if grid[hat_r, pole["col"]] != color:
+            continue
+
+        direction = -1 if pole["col"] < hat_c else 1
+        candidates.append((color, direction))
