+            if width >= 2:
+                cc = (cc + 1) % width
+                pattern[rr, cc] = color
+            else:
+                rr = (rr + 1) % height
+                pattern[rr, cc] = color
+
+    return pattern
+
+
+def _apply_damage(
+    grid: np.ndarray,
+    cfg: tuple[SplitAxis, PairMode, bool],
+    marker_color: int,
+    marker_r: int,
+    marker_c: int,
