+
+    if random.random() < 0.4 and all(value > 0 for value in displacement):
+        return None
+    if random.random() < 0.3 and all(value == 0 for value in displacement):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(1200):
+        grid = _try_generate_candidate()
+        if grid is None:
+            continue
+
+        out = main(grid)
