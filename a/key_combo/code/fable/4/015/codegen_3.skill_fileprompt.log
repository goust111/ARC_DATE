+def _marker_slot_candidates(box: BBox, side: str, gap: int) -> list[Coord]:
+    r0, c0, r1, c1 = box
+    if side == "top":
+        return [(r0 - gap - 1, c) for c in range(c0, c1 + 1)]
+    if side == "bottom":
+        return [(r1 + gap + 1, c) for c in range(c0, c1 + 1)]
+    if side == "left":
+        return [(r, c0 - gap - 1) for r in range(r0, r1 + 1)]
+    if side == "right":
