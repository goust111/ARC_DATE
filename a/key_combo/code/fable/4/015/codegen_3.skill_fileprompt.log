+GEN_GRID_MIN = 18
+GEN_GRID_MAX = 30
+GEN_RECT_COUNT_CHOICES = (2, 3, 3)
+GEN_RECT_SIDE_MIN = 5
+GEN_RECT_SIDE_MAX = 9
+GEN_MAX_DEPTH = 3
+GEN_MAX_MARKERS_PER_RECT = 2
+GEN_EDGE_MARGIN = GEN_MAX_DEPTH + 1
+GEN_RECT_PADDING = 3
+GEN_MIN_COVERAGE = 0.12
+GEN_MAX_COVERAGE = 0.42
