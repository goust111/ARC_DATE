+    r, c = coord
+    r0, c0, r1, c1 = box
+    if side == "top":
+        cells = [(rr, c) for rr in range(r + 1, r0)]
+    elif side == "bottom":
+        cells = [(rr, c) for rr in range(r1 + 1, r)]
+    elif side == "left":
+        cells = [(r, cc) for cc in range(c + 1, c0)]
+    else:
+        cells = [(r, cc) for cc in range(c1 + 1, c)]
