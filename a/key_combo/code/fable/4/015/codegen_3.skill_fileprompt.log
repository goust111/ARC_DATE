                mapping[(r, c)] = rect_idx
    return mapping


def _sightline_hits(grid: np.ndarray, coord: Coord, rect_by_cell: dict[Coord, int]) -> list[tuple[int, int]]:
    hits: list[tuple[int, int]] = []
