    out = g.copy()

    for r, c in marker_coords:
        out[r, c] = BG

    for rect_idx, depth in sorted(plan):
        _paint_layer(out, rectangles[rect_idx]["bbox"], depth, plan[(rect_idx, depth)])

    return out


