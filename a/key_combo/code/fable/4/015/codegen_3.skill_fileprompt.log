+    cols = np.arange(c0, c1 + 1)[None, :]
+    layer_depth = np.minimum(
+        np.minimum(rows - r0, r1 - rows),
+        np.minimum(cols - c0, c1 - cols),
+    )
+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    region[layer_depth == depth] = int(color)
