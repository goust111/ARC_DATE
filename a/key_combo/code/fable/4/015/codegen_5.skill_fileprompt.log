# Colors and sprite placement.
BG_COLOR, SPRITE_COLOR, MARKER_COLOR = 0, 1, 2
SPRITE_SIZE, CENTER_OFFSET = 2, PITCH // 2
INPUT_OFFSET_START, INPUT_OFFSET_STOP = 1, 4
