+    h, w = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + h > dst.shape[0] or c0 + w > dst.shape[1]:
+        raise ValueError("paste out of bounds")
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
+
