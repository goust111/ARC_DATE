    return None


def _gen_count_bounds(color: int, N: int) -> tuple[int, int]:
    lo, hi = COLOR_COUNT_RANGES[color]
    return int(np.ceil(lo * N)), int(np.floor(hi * N))


def _gen_neighbor_cells(cells: Placement, H: int, W: int) -> list[Coord]:
    out: set[Coord] = set()
