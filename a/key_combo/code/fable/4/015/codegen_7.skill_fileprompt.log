+
+# --------------- generator ---------------
+
+BG_COLOR = 0
+PITCH = 8
+CELL_LAYOUTS = ((3, 3), (3, 3), (3, 2), (2, 3))
+TOP_LEFT_MAX = 2
+BOTTOM_PAD_MAX = 2
+GEN_ATTEMPTS = 300
