+def _cell_center(marker_rows: list[int], marker_cols: list[int], cell: Coord) -> Coord:
+    r_idx, c_idx = map(int, cell)
+    return (
+        (int(marker_rows[r_idx]) + int(marker_rows[r_idx + 1])) // 2,
+        (int(marker_cols[c_idx]) + int(marker_cols[c_idx + 1])) // 2,
