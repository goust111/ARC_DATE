    n: int,
    rel_path: list[Coord],
    footprint: list[Coord],
) -> tuple[int, int, int, int] | None:
    """Return inclusive translation bounds that keep the footprint in-grid."""
    path_rows = [r for r, _ in rel_path]
    path_cols = [c for _, c in rel_path]
