    direction: tuple[int, int],
    gap_len: int,
) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:
    dr, dc = direction
    gap = [(visible[0] + dr * k, visible[1] + dc * k) for k in range(1, gap_len + 1)]
    marker = (visible[0] + dr * (gap_len + 1), visible[1] + dc * (gap_len + 1))
