+
+
+def _sample_patch(bg: int, sprite_colors: list[int]) -> np.ndarray:
+    mask = random.choice(BASE_MASKS).copy()
+    mask = np.rot90(mask, random.randrange(4))
+    if random.random() < 0.5:
+        mask = np.fliplr(mask)
+
+    patch = np.full(mask.shape, bg, dtype=int)
