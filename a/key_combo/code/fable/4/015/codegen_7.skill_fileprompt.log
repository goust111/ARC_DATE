+    pitch_r = int(next(iter(row_steps)))
+    pitch_c = int(next(iter(col_steps)))
+    if pitch_r != pitch_c or pitch_r < 4 or pitch_r % 2 != 0:
+        return None
+    return rows, cols, pitch_r
