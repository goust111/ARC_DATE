+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+MARKER_COLORS = (BLUE, RED, YELLOW)
+PANEL_COLORS = (3, 6, 7, 8, 9)
+GEN_RETRY_LIMIT = 400
