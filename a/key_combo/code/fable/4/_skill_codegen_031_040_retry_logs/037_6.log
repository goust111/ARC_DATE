    return candidates[0]


def _shift_cells(cells: set[Coord], dr: int, dc: int, distance: int) -> set[Coord]:
    return {(r + dr * distance, c + dc * distance) for r, c in cells}


def _shift_box(box: BBox, dr: int, dc: int, distance: int) -> BBox:
    r0, c0, r1, c1 = box
    return (
