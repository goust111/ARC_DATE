+    r0, c0, r1, c1 = frame_box
+    assert cr1 - cr0 + 1 < r1 - r0, "cluster bbox must be smaller than interior height"
+    assert cc1 - cc0 + 1 < c1 - c0, "cluster bbox must be smaller than interior width"
+
