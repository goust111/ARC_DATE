+def _tab_side(tab: Coord, box: BBox) -> str | None:
+    """Return the outward side of a non-corner tab, or None."""
+    tr, tc = tab
+    r0, c0, r1, c1 = box
+    if tr == r0 - 1 and c0 < tc < c1:
+        return "top"
+    if tr == r1 + 1 and c0 < tc < c1:
+        return "bottom"
+    if tc == c0 - 1 and r0 < tr < r1:
+        return "left"
+    if tc == c1 + 1 and r0 < tr < r1:
+        return "right"
+    return None
+
