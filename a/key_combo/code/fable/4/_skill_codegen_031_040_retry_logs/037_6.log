            continue
        trial = removed | {cell}
        if _connected_after_removal(n, blob, trial):
            picked.append(cell)
            removed.add(cell)
    return picked


def _isolated_pairs(g: np.ndarray, blob: set[Cell], bg: int, dr: int, dc: int) -> list[MarkerPair]:
    n = g.shape[0]
