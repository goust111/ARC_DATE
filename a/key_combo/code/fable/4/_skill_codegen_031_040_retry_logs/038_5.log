+            return None
+        if not _semantics_hold(
+            inp, expected, template, masks, exclusive_groups, anchor_color, transposed
+        ):
+            return None
+        if not np.array_equal(main(inp), expected):
+            return None
+    except (AssertionError, ValueError):
+        return None
+    return inp
+
