+
+def _grow_masks(
+    rng: np.random.Generator,
+    template: set[Coord],
+    exclusive_groups: list[set[Coord]],
+) -> list[set[Coord]]:
+    all_exclusive = set().union(*exclusive_groups)
+    masks: list[set[Coord]] = []
+    allowed_regions: list[set[Coord]] = []
