def _gen_bbox_cells(box):
    r0, c0, r1, c1 = box
    return {
        (r, c)
        for r in range(r0, r1 + 1)
        for c in range(c0, c1 + 1)
    }


def _gen_bbox_separated(a, b):
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
