    br0, bc0, br1, bc1 = b
    return ar1 + MIN_BLACK_GAP < br0 or br1 + MIN_BLACK_GAP < ar0 or (
        ac1 + MIN_BLACK_GAP < bc0 or bc1 + MIN_BLACK_GAP < ac0
    )


def _gen_attempt():
