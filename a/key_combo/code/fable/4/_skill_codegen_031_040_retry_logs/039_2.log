GEN_GAP_RANGE = (3, 7)
GEN_ROW_MIN_MARGIN, GEN_ROW_MAX_SPAN, GEN_COL_MIN_MARGIN = 2, 18, 5

# Topology and region validation.
GEN_FG_RATIO_RANGE, GEN_INTERSECTION_RANGE, GEN_ENDPOINT_RANGE = (0.18, 0.22), (8, 11), (13, 18)
