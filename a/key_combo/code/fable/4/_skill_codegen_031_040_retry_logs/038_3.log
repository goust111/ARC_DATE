    extra_steps = np.zeros(n - 1, dtype=int)
    if slack > 0:
        if n >= 3:
            forced_i = int(rng.integers(0, n - 1))
            forced = int(rng.integers(1, slack + 1))
            extra_steps[forced_i] += forced
            slack -= forced
        for _ in range(slack):
