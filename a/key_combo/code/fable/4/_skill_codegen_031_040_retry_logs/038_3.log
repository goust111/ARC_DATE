+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    """Require two full background rows or columns between sprite bboxes."""
+    return a[2] + 2 < b[0] or b[2] + 2 < a[0] or a[3] + 2 < b[1] or b[3] + 2 < a[1]
