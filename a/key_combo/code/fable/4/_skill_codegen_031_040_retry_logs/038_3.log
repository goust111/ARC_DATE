    canvas_low = GRID_COL_RANGE[0] if horizontal else GRID_ROW_RANGE[0]
    canvas_high = GRID_COL_RANGE[1] if horizontal else GRID_ROW_RANGE[1]
    low = max(canvas_low, _min_axis_length(n))
    if low >= canvas_high:
