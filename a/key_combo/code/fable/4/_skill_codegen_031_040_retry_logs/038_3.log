+    for color in marker_colors:
+        positions = np.argwhere(g == color)
+        assert positions.shape == (2, 2), "every marker color must occur exactly twice"
+        (r1, c1), (r2, c2) = (tuple(map(int, position)) for position in positions)
+        if r1 == r2 or c1 == c2:
+            degenerate_count += 1
+            continue
