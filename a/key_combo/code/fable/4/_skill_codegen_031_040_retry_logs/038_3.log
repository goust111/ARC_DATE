def _min_axis_length(n):
    multi = EDGE_MARGIN + MULTI_AXIS_STEP * (n - 1) + SPRITE_SIZE + EDGE_MARGIN
    return PAIR_AXIS_MIN_LENGTH if n == 2 else multi

