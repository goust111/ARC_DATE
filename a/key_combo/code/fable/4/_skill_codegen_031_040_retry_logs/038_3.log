+
+BACKGROUND = 0
+GREY = 5
+MARKER_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+_RNG = np.random.default_rng()
+_SEEN_OUTPUTS: set[tuple[tuple[int, int], bytes]] = set()
