    return out


def _gen_place_marker_9def23fe(side, idx, r0, c0, r1, c1, h, w):
    if side == "top":
        return int(r0 - np.random.randint(_GEN_MARKER_MIN_GAP_9DEF23FE, r0 + 1)), c0 + idx
    if side == "bottom":
