+
+# Connected polyominoes with multiple rows and columns. A random rigid transform
+# is applied once, then the exact resulting orientation is copied everywhere.
+_BASE_SHAPES = (
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (0, 1), (0, 2), (1, 1), (2, 1)),
+    ((0, 0), (1, 0), (1, 1), (2, 1), (2, 2)),
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+    ((0, 0), (1, 0), (1, 1), (1, 2), (0, 2)),
