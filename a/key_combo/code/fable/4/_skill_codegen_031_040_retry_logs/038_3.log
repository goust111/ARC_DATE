+        (r, c)
+        for r in range(1, height - shape_h)
+        for c in range(1, width - shape_w)
+    ]
+    rng.shuffle(candidates)
+    boxes: list[tuple[int, int, int, int]] = []
+    copies: list[tuple[tuple[int, int], ...]] = []
+    for r0, c0 in candidates:
