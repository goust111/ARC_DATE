    return True


def _gen_touches_existing(mask, r0, c0, h, w):
    r1 = min(GRID_SIZE, r0 + h + PLACEMENT_CLEARANCE)
    c1 = min(GRID_SIZE, c0 + w + PLACEMENT_CLEARANCE)
