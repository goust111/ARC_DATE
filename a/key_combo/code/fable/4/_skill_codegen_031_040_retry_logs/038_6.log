import itertools

# Canvas structure and fixed colors.
GRID_SIZE = 28
GRID_SHAPE = (GRID_SIZE, GRID_SIZE)
OUTER_WIDTH, INNER_FRAME_INDEX, MAIN_START = 2, 2, 3
OUTER_FRAME_COLOR, INNER_FRAME_COLOR = 1, 4
