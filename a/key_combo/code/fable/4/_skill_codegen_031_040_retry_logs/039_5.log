+GEN_HEIGHT_RANGE = (14, 24)
+GEN_WIDTH_RANGE = (14, 24)
+GEN_MIRROR_COUNT_RANGE = (3, 6)
+GEN_FILTER_COUNT_RANGE = (2, 4)
+GEN_MIN_SEGMENT = 3
+GEN_MAX_ATTEMPTS = 500
