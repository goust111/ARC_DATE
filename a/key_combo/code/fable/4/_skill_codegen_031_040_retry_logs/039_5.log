+
+BACKGROUND = 0
+SLASH_MIRROR = 8
+BACKSLASH_MIRROR = 9
+MIRROR_COLORS = (SLASH_MIRROR, BACKSLASH_MIRROR)
+FILTER_COLORS = (1, 2, 3, 4, 5, 6, 7)
