+    r, c = border[0]
+    inward = []
+    if r == 0:
+        inward.append((1, 0))
+    if r == height - 1:
+        inward.append((-1, 0))
+    if c == 0:
+        inward.append((0, 1))
+    if c == width - 1:
+        inward.append((0, -1))
+    assert len(inward) == 1, "the source must not occupy a corner"
+    return (r, c), inward[0]
