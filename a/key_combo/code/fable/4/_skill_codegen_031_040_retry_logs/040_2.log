+    top_center_c2 = top_box[1] + top_box[3]
+    bottom_center_r2 = bottom_box[0] + bottom_box[2]
+    bottom_center_c2 = bottom_box[1] + bottom_box[3]
+    assert top_center_r2 != bottom_center_r2 and top_center_c2 != bottom_center_c2
