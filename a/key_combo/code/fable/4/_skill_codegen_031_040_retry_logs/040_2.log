+        dims = [_DIMENSION_POOL[int(index)] for index in chosen_indices]
+        rng.shuffle(dims)
+        areas = [height * width for height, width in dims]
+        if len(set(areas)) != count:
+            continue
+        if areas == sorted(areas) or areas == sorted(areas, reverse=True):
+            continue
+        return dims
+    return None
