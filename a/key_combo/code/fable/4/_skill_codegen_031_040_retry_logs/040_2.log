    for rotated in _unique_rotations(shape):
        shape_cells = np.argwhere(rotated)
        for sr, sc in shape_cells:
            for pr, pc in pocket:
                dr = int(pr) - int(sr)
                dc = int(pc) - int(sc)
                placed = {
                    (dr + int(r), dc + int(c))
                    for r, c in shape_cells
