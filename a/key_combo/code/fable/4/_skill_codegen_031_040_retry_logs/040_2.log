+        grid_h = int(rng.integers(max(18, span_h + 2), 31))
+        grid_w = int(rng.integers(max(18, span_w + 2), 31))
+        top_margin = int(rng.integers(1, grid_h - span_h))
+        left_margin = int(rng.integers(1, grid_w - span_w))
+        translated = [
