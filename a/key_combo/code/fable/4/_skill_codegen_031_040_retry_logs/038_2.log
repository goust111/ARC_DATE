+# ---------------------------------------------------------------------------
+
+_RNG = random.Random()
+_COLORS = tuple(range(1, 10))
+_MAX_ATTEMPTS = 400
+
+
+def _make_palette(length: int) -> tuple[tuple[int, ...], int]:
+    """Make an aperiodic sequence; longer bars always show visible repetition."""
+    anchor_color = _RNG.choice(_COLORS)
