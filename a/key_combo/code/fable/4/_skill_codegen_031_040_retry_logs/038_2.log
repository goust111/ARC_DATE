+    _RNG.shuffle(candidates)
+    chosen: list[Coord] = []
+    for point in candidates:
+        if all(
+            max(abs(point[0] - other[0]), abs(point[1] - other[1])) > 1
+            for other in chosen
+        ):
+            chosen.append(point)
+            if len(chosen) == count:
+                return chosen
+    return None
+
+
+def _assignment_grid(
+    shape: tuple[int, int],
+    scatter: list[Coord],
+    orientation: str,
+    sequence: tuple[int, ...],
+    anchor: Coord,
+    anchor_color: int,
+) -> np.ndarray:
+    ordered = _ordered_scatter(scatter, orientation)
