+    if orientation == "horizontal":
+        row = 0 if side == "first" else height - 1
+        return tuple((row, c) for c in range(start, start + length))
+    col = 0 if side == "first" else width - 1
+    return tuple((r, col) for r in range(start, start + length))
+
