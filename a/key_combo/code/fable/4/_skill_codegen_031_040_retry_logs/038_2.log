from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/4/038/2.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
out_sigs = set()
orientations = set()
sides = set()
lengths = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    bar = mod._find_bar(inp)
    orientations.add(bar.orientation)
    lengths.add(len(bar.coords))
    if bar.orientation == 'horizontal':
        sides.add(('h', bar.coords[0][0]))
    else:
        sides.add(('v', bar.coords[0][1]))
    assert any(bar.colors.count(c) > 1 for c in set(bar.colors))
    assert all(out[p] == 0 for p in bar.coords)
print('variants', len(sigs))
print('output_variants', len(out_sigs))
print('orientations', orientations, 'bar_lengths', sorted(lengths), 'side_variants', len(sides))
assert len(sigs) >= 20
assert len(out_sigs) == len(sigs)
assert orientations == {'horizontal', 'vertical'}
