+def _bbox(coords: np.ndarray) -> Rect:
+    """Inclusive bounding box, matching arc_utils.bbox_coords."""
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
