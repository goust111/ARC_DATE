+    all_vertical = [(r, c, "V", color) for r, c, _, color in bars]
+    if np.array_equal(expected, _render_expected(grid.shape, stamp, all_horizontal)):
+        return False
+    if np.array_equal(expected, _render_expected(grid.shape, stamp, all_vertical)):
+        return False
+    return True
+
