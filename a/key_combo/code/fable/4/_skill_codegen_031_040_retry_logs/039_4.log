import numpy as np

from arc_utils import Color, bbox, bbox_h, bbox_w, crop_bbox
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Recover the hidden 5x5 patch by rotating the scene 180 degrees and cropping the blue-mask location.

    Input structure
    A scene contains exactly one solid 5x5 blue mask over a larger rotationally symmetric pattern.

    Rule
    Locate the blue mask, rotate the whole input grid 180 degrees, and return the 5x5 patch at the mask's original bbox.

    Key insight
    The blue block is an occluder; the hidden pixels are supplied by the opposite 180-degree-corresponding part of the same pattern.
    """
    g = np.asarray(grid, dtype=int)

    mask = g == Color.BLUE
    b = bbox(mask)
    assert b is not None
    assert bbox_h(b) == 5 and bbox_w(b) == 5
    assert int(mask.sum()) == 25
    assert np.all(crop_bbox(mask, b))

    out = crop_bbox(np.rot90(g, 2), b)
    assert out.shape == (5, 5)
    assert not np.any(out == Color.BLUE)
    return out

# --------------- generator (o5x) ---------------

# Canvas, block, and blue-mask geometry.
BLOCK_SIZE, GRID_SIZE, BLUE_SIZE = 6, 24, 5
BLUE_TOP_LEFTS = range(GRID_SIZE - BLUE_SIZE + 1)
OPPOSITE_TOP_LEFT_BASE = GRID_SIZE - BLUE_SIZE
HALF_TURN = 2
# Transpose-symmetric 6x6 block foreground counts.
BLOCK_ON_COUNT_RANGE = (16, 29)
DIAGONAL_CELLS = list(range(BLOCK_SIZE))
TRANSPOSE_PAIRS = [(r, c) for r in range(BLOCK_SIZE) for c in range(r + 1, BLOCK_SIZE)]
# Color sharing modes for A, B, C blocks.
COLOR_POOL = [c for c in range(10) if c not in (Color.BLACK, Color.BLUE)]
COLOR_SHARE_MODES = ("ab", "bc", "abc")
# Generation retry limit.
MAX_GENERATION_ATTEMPTS = 300


def _gen_transpose_mask() -> np.ndarray:
    target = random.randint(*BLOCK_ON_COUNT_RANGE)
    diagonal_choices = [
        d for d in range(BLOCK_SIZE + 1)
        if (target - d) % 2 == 0 and 0 <= (target - d) // 2 <= len(TRANSPOSE_PAIRS)
    ]
    diag_count = random.choice(diagonal_choices)
    pair_count = (target - diag_count) // 2

    mask = np.zeros((BLOCK_SIZE, BLOCK_SIZE), dtype=bool)
    diag_cells = random.sample(DIAGONAL_CELLS, diag_count)
    for i in diag_cells:
        mask[i, i] = True

    for r, c in random.sample(TRANSPOSE_PAIRS, pair_count):
        mask[r, c] = True
        mask[c, r] = True
    return mask


def _gen_color_assignment() -> tuple[int, int, int]:
    mode = random.choice(COLOR_SHARE_MODES)
    if mode == "ab":
        shared, other = random.sample(COLOR_POOL, 2)
        return shared, shared, other
    if mode == "bc":
        other, shared = random.sample(COLOR_POOL, 2)
        return other, shared, shared
    return tuple(random.sample(COLOR_POOL, 3))


def _gen_colored_block(color: int) -> np.ndarray:
    block = np.zeros((BLOCK_SIZE, BLOCK_SIZE), dtype=int)
    block[_gen_transpose_mask()] = color
    return block


def _gen_pattern() -> np.ndarray:
    color_a, color_b, color_c = _gen_color_assignment()
    block_a = _gen_colored_block(color_a)
    block_b = _gen_colored_block(color_b)
    block_c = _gen_colored_block(color_c)
    q1 = np.block([[block_a, block_b], [block_b, block_c]])
    top = np.concatenate([q1, np.fliplr(q1)], axis=1)
    bottom = np.flipud(top)
    return np.concatenate([top, bottom], axis=0)


def _gen_blue_position(pattern: np.ndarray) -> tuple[int, int] | None:
    positions = []
    for r in BLUE_TOP_LEFTS:
        for c in BLUE_TOP_LEFTS:
            rr, cc = OPPOSITE_TOP_LEFT_BASE - r, OPPOSITE_TOP_LEFT_BASE - c
            row_overlap = max(r, rr) <= min(r + BLUE_SIZE - 1, rr + BLUE_SIZE - 1)
            col_overlap = max(c, cc) <= min(c + BLUE_SIZE - 1, cc + BLUE_SIZE - 1)
            if row_overlap and col_overlap:
                continue
            opposite_patch = pattern[rr : rr + BLUE_SIZE, cc : cc + BLUE_SIZE]
            if np.any(opposite_patch != Color.BLACK):
                positions.append((r, c))
    if not positions:
        return None
    return random.choice(positions)


def _gen_attempt() -> np.ndarray | None:
    pattern = _gen_pattern()
    pos = _gen_blue_position(pattern)
    if pos is None:
        return None

    r, c = pos
    inp = pattern.copy()
    inp[r : r + BLUE_SIZE, c : c + BLUE_SIZE] = Color.BLUE
    expected = np.rot90(pattern, HALF_TURN)[r : r + BLUE_SIZE, c : c + BLUE_SIZE]
    got = main(inp)
    if not np.array_equal(got, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate ff805c23 input")
    h, w = tile.shape
    r_off, c_off = map(int, offset)
    out = np.empty((H, W), dtype=tile.dtype)
    for r in range(H):
        tr = (r - r_off) % h
        for c in range(W):
            tc = (c - c_off) % w
            out[r, c] = tile[tr, tc]
    return out




# =============================================================================
# Motion / interaction (translate, collision/contact)
# =============================================================================


def translate(obj: np.ndarray, dr: int, dc: int, *, background: int = Color.BLACK) -> np.ndarray:
    """Translate a full-grid object by (dr,dc), filling empty with background."""
    dr = int(dr)
    dc = int(dc)
    bg = int(background)
    H, W = obj.shape
    out = np.full_like(obj, bg)
    rr, cc = np.nonzero(obj != bg)
    rr2 = rr + dr
    cc2 = cc + dc
    inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
    out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
    return out


def collision(
    *,
    object1: np.ndarray,
    object2: np.ndarray,
    r1: int = 0,
    c1: int = 0,
    r2: int = 0,
    c2: int = 0,
    background: int = Color.BLACK,
) -> bool:
    """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
    bg = int(background)
    a = object1
    b = object2
    H1, W1 = a.shape
    H2, W2 = b.shape

    dr = int(r2) - int(r1)
    dc = int(c2) - int(c1)

    ra0 = max(0, dr)
    ca0 = max(0, dc)
    ra1 = min(H1, dr + H2)
    ca1 = min(W1, dc + W2)
    if ra0 >= ra1 or ca0 >= ca1:
        return False

    rb0 = ra0 - dr
    cb0 = ca0 - dc
    rb1 = rb0 + (ra1 - ra0)
    cb1 = cb0 + (ca1 - ca0)
    return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())


def contact(
    *,
    object1: np.ndarray,
    object2: np.ndarray,
    r1: int = 0,
    c1: int = 0,
    r2: int = 0,
    c2: int = 0,
    background: int = Color.BLACK,
    connectivity: int = 4,
) -> bool:
    """Return True iff objects touch (share edge/diagonal) or overlap."""
    bg = int(background)
    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
    m2 = (object2 != bg)
    m2d = ndimage.binary_dilation(m2, structure=struct)
    return collision(
        object1=(object1 != bg).astype(int),
        object2=m2d.astype(int),
        r1=r1,
        c1=c1,
        r2=r2,
        c2=c2,
        background=0,
    )


# =============================================================================
# Generation helpers
# =============================================================================

def first_free_location(
    canvas: np.ndarray,
    patch: np.ndarray,
    *,
    transparent: int,
    border: int = 0,
    padding: int = 0,
    padding_connectivity: int = 8,
) -> Coord | None:
    """
    Find the first (top-left) location where `patch` fits without overlap.

    Args:
        transparent: color treated as transparent in both `canvas` and `patch`
        border: keep at least this many empty cells to the canvas border
        padding: if > 0, treat `canvas` occupancy as dilated by `padding` pixels.
                 (useful for “leave a gap” placement constraints)
        padding_connectivity: 4 or 8 for the dilation neighborhood

    Returns:
        (r0,c0) or None if no placement exists.
    """
    H, W = canvas.shape
    h, w = patch.shape
    border = int(border)
    padding = int(padding)
    bg = int(transparent)

    if h <= 0 or w <= 0:
        return None
    if H - h + 1 - border <= border or W - w + 1 - border <= border:
        return None

    # Occupancy of the canvas (optionally dilated to enforce padding).
    occ = (canvas != bg)
    if padding > 0:
        if int(padding_connectivity) == 4:
            struct = STRUCT4
        elif int(padding_connectivity) == 8:
            struct = STRUCT8
        else:
            raise ValueError("first_free_location: padding_connectivity must be 4 or 8")
        occ = ndimage.binary_dilation(occ, iterations=padding, structure=struct)

    patch_mask = (patch != bg)
    if not bool(patch_mask.any()):
        # Empty patch: any in-bounds location works; choose first.
        return int(border), int(border)

    for r0 in range(border, H - h + 1 - border):
        for c0 in range(border, W - w + 1 - border):
            if not bool((occ[r0 : r0 + h, c0 : c0 + w] & patch_mask).any()):
                return int(r0), int(c0)
    return None


def random_sprite(
    m,
    n,
    *,
    density: float = 0.5,
    symmetry: str | None = None,
    color_palette: list[int] | None = None,
    connectivity: int = 4,
    background: int = Color.BLACK,
    no_repeated_colors: bool = False,
) -> np.ndarray:
    """Generate a contiguous sprite of shape (m,n) with random symmetry and palette (for puzzle generation)."""
    if isinstance(m, range):
        m = list(m)
    if isinstance(n, range):
        n = list(n)
    if not isinstance(m, list):
        m = [m]
    if not isinstance(n, list):
        n = [n]

    m_original, n_original = m, n
    density_original, symmetry_original = density, symmetry
    palette_original, conn_original, bg_original = color_palette, connectivity, background

    can_be_square = any(m_ == n_ for m_ in m for n_ in n)
    symmetry_types = ["horizontal", "vertical", "not_symmetric", "mirror"]
    if can_be_square:
        symmetry_types += ["diagonal", "radial"]
    symmetry = symmetry or random.choice(symmetry_types)

    has_to_be_square = symmetry in ("diagonal", "radial")
    if has_to_be_square:
        m, n = random.choice([(m_, n_) for m_ in m_original for n_ in n_original if m_ == n_])
    else:
        m = random.choice(m)
        n = random.choice(n)

    if m == 1 or n == 1:
        density = 1.0
    elif m == 2 or n == 2:
        density = max(float(density), 0.6)
    elif m == 3 or n == 3:
        density = max(float(density), 0.5)
    else:
        density = max(0.4, min(0.95, random.gauss(float(density), 0.1)))

    sprite = generate_sprite(
        n=int(m),
        m=int(n),
        symmetry_type=symmetry,
        color_palate=color_palette,
        fill_percentage=density,
        connectivity=connectivity,
        background=background,
        no_repeated_colors=no_repeated_colors,
    )
    assert is_contiguous(sprite, connectivity=connectivity, background=background), "Generated sprite is not contiguous."

    bg = int(background)
    if (
        np.sum(sprite[0, :] != bg) > 0
        and np.sum(sprite[-1, :] != bg) > 0
        and np.sum(sprite[:, 0] != bg) > 0
        and np.sum(sprite[:, -1] != bg) > 0
    ):
        return sprite

    return random_sprite(
        m_original,
        n_original,
        density=density_original,
        symmetry=symmetry_original,
        color_palette=palette_original,
        connectivity=conn_original,
        background=bg_original,
        no_repeated_colors=no_repeated_colors,
    )


def random_free_location(
    canvas: np.ndarray,
    patch: np.ndarray,
    *,
    transparent: int,
    border: int = 0,
    padding: int = 0,
    padding_connectivity: int = 8,
) -> Coord:
    """
    Return a random (r,c) top-left location where `patch` fits without overlap.

    This is the generator-friendly counterpart of `first_free_location` and mirrors the
    legacy seeds' `random_free_location_for_sprite` behavior.

    Raises:
        ValueError: if no free location exists.
    """
    H, W = canvas.shape
    h, w = patch.shape
    border = int(border)
    padding = int(padding)
    pad_conn = int(padding_connectivity)
    bg = int(transparent)

    if h <= 0 or w <= 0:
        raise ValueError("random_free_location: patch must be non-empty")
    if H <= 0 or W <= 0:
        raise ValueError("random_free_location: canvas must be non-empty")

    if border < 0:
        raise ValueError("random_free_location: border must be >= 0")
    if padding < 0:
        raise ValueError("random_free_location: padding must be >= 0")
    if pad_conn not in (4, 8):
        raise ValueError("random_free_location: padding_connectivity must be 4 or 8")

    r_min = border
    c_min = border
    r_max = H - border - h
    c_max = W - border - w
    if r_max < r_min or c_max < c_min:
        raise ValueError("random_free_location: patch cannot fit (border too large or patch too big)")

    occ = (canvas != bg)
    if padding > 0:
        struct = STRUCT4 if pad_conn == 4 else STRUCT8
        occ = ndimage.binary_dilation(occ, structure=struct, iterations=padding)

    m = (patch != bg)

    candidates: list[Coord] = []
    for r0 in range(r_min, r_max + 1):
        for c0 in range(c_min, c_max + 1):
            if not bool((occ[r0 : r0 + h, c0 : c0 + w] & m).any()):
                candidates.append((int(r0), int(c0)))

    if not candidates:
        raise ValueError("random_free_location: no free location")
    return random.choice(candidates)


