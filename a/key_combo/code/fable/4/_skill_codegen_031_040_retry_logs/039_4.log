+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    stamp = _extract_stamp(g)
+    bars = _find_bars(g)
+    side = stamp.shape[0]
+    radius = side // 2
+    h, w = g.shape
+
