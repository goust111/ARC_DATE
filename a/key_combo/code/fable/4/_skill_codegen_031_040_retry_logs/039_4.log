+    coords = holes[0]
+    r0, c0, r1, c1 = _bbox(coords)
+    side_h, side_w = r1 - r0 + 1, c1 - c0 + 1
+    assert side_h == side_w and side_h % 2 == 1, "hole bbox must be an odd square"
+
+    stamp = np.zeros((side_h, side_w), dtype=bool)
+    stamp[coords[:, 0] - r0, coords[:, 1] - c0] = True
