+def _random_path(mask: np.ndarray, start: Coord, goal: Coord) -> None:
+    """Add a randomized shortest orthogonal path, preserving connectivity."""
+    r, c = start
+    gr, gc = goal
+    mask[r, c] = True
+    while (r, c) != (gr, gc):
+        steps = []
+        if r < gr:
+            steps.append((r + 1, c))
+        elif r > gr:
+            steps.append((r - 1, c))
+        if c < gc:
+            steps.append((r, c + 1))
+        elif c > gc:
+            steps.append((r, c - 1))
