+    background = g == BLACK
+    reached_a = dist_a >= 0
+    reached_b = dist_b >= 0
+    owned_a = background & reached_a & (~reached_b | (dist_a < dist_b))
+    owned_b = background & reached_b & (~reached_a | (dist_b < dist_a))
+
+    out = g.copy()
+    out[owned_a] = color_a
+    out[owned_b] = color_b
+    return out
