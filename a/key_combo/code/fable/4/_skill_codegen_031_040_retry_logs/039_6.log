+    grid = np.full((height, width), GRAY, dtype=int)
+    lattice = [(r, c) for r in range(1, height - 1, 2) for c in range(1, width - 1, 2)]
+    start = random.choice(lattice)
+    visited = {start}
+    stack = [start]
+    grid[start] = BLACK
+
+    while stack:
+        r, c = stack[-1]
+        choices = []
+        for dr, dc in ((-2, 0), (2, 0), (0, -2), (0, 2)):
+            nxt = (r + dr, c + dc)
+            if nxt in visited:
+                continue
+            if 1 <= nxt[0] < height - 1 and 1 <= nxt[1] < width - 1:
+                choices.append(nxt)
+        if not choices:
+            stack.pop()
+            continue
+
+        nr, nc = random.choice(choices)
+        grid[(r + nr) // 2, (c + nc) // 2] = BLACK
+        grid[nr, nc] = BLACK
+        visited.add((nr, nc))
+        stack.append((nr, nc))
+    return grid, start
+
