+        out[rows[cell_r] + 1 : rows[cell_r + 1], cols[cell_c] + 1 : cols[cell_c + 1]] = BLUE
+    return out
+
+
+# ------------------------------ generator ------------------------------
+
+
+def _line_positions(interior_sizes: np.ndarray) -> list[int]:
+    positions = [0]
+    for size in interior_sizes:
