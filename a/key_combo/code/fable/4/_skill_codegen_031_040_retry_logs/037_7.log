+
+
+# ------------------------------ generator ------------------------------
+
+_DIRECTIONS = ("left", "up", "right", "down")
+_generation_count = 0
+_MAX_ATTEMPTS = 400
+
+
+def _draw_frame(grid: np.ndarray, top: int, left: int, fh: int, fw: int, color: int) -> None:
+    for r, c in _perimeter((top, left, top + fh - 1, left + fw - 1)):
+        if _in_bounds(grid.shape, r, c):
