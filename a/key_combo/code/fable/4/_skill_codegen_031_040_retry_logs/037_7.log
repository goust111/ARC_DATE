def _sample_layout(direction: str) -> tuple[tuple[int, int], BBox, int, int, int]:
    """Return shape, source bbox, target top/left packed as three trailing ints (top, left, clip)."""
    fh, fw = random.randint(6, 10), random.randint(6, 10)
