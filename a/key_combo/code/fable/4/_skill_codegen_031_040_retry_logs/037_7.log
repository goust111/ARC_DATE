+def _components4(mask: np.ndarray) -> list[set[Coord]]:
+    unseen = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    components: list[set[Coord]] = []
+    while unseen:
+        start = unseen.pop()
+        component = {start}
+        queue = deque([start])
+        while queue:
+            r, c = queue.popleft()
+            for cell in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if cell in unseen:
+                    unseen.remove(cell)
+                    component.add(cell)
+                    queue.append(cell)
