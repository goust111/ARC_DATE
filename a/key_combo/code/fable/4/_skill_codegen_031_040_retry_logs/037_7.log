    return lo, hi


def _choose_embedded_sites(n: int, blob: set[Cell]) -> list[Cell] | None:
    embedded_capacity = min(
        EMBEDDED_MAX,
        (len(blob) - EMBEDDED_MAIN_MARGIN) // 2,
