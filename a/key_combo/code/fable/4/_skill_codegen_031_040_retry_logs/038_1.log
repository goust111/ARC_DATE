+        inp[r1, c0 : c1 + 1] = frame_color
+        inp[r0 : r1 + 1, c0] = frame_color
+        inp[r0 : r1 + 1, c1] = frame_color
+
+        rr = np.arange(interior_h) % row_period
+        cc = np.arange(interior_w) % col_period
