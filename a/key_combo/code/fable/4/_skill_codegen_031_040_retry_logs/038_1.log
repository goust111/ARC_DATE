+def _tile_value(
+    tile: np.ndarray,
+    row_period: int,
+    col_period: int,
+    base_r: int,
+    base_c: int,
+    r: int,
+    c: int,
+) -> int:
+    return int(tile[(r - base_r) % row_period, (c - base_c) % col_period])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Extend the interior wallpaper as a full band through the frame's unique gap.
+
+    Input structure:
