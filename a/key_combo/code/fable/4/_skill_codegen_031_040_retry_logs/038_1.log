+    gap: tuple[int, int],
+    side: str,
+    tile: np.ndarray,
+) -> tuple[np.ndarray, set[tuple[int, int]]]:
+    """Render the rule directly from generator metadata, independently of inference."""
+    r0, c0, r1, c1 = box
+    row_period, col_period = map(int, tile.shape)
