+"""ARC task: extend a periodic wallpaper through a one-gap rectangular frame."""
+
+from __future__ import annotations
+
+import numpy as np
+
+
+_SIDES = ("top", "bottom", "left", "right")
+_RNG = np.random.default_rng()
+_side_cycle: list[str] = []
