+    phase_shift = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}[side]
+    dr, dc = phase_shift
+    wrong_phase_differs = any(
+        int(expected[r, c])
+        != _tile_value(tile, rp, cp, base_r, base_c, r + dr, c + dc)
+        for r, c in exterior
