+        row_period = int(_RNG.integers(2, 5))
+        col_period = int(_RNG.integers(2, 5))
+        interior_h = 2 * row_period + int(_RNG.integers(0, row_period + 1))
+        interior_w = 2 * col_period + int(_RNG.integers(0, col_period + 1))
