    return random.randint(lo, hi)


def _gen_feasible_specs(rows: int, cols: int, side: str) -> list[tuple[int, int, int, int, int]]:
    horizontal = side in _GEN_HORIZONTAL_SIDES
    axis_limit = cols if horizontal else rows
