# === CFG: tunable generation parameters ===

# Grid dimensions
_HEIGHT_OPTIONS = [17, 19, 21, 23]          # odd heights (spec: 17-23)
_WIDTH_RANGE = (14, 21)                     # columns (spec: 14-21)
_BAR_START_OPTIONS = [2, 3]                 # leftmost column of horizontal bars
