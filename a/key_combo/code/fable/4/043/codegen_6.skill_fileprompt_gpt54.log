+def _paint_line(
+    out: np.ndarray,
+    src: np.ndarray,
+    bg: int,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    color: int,
+) -> None:
+    r, c = map(int, start)
+    er, ec = map(int, end)
+    dr = 0 if r == er else (1 if er > r else -1)
+    dc = 0 if c == ec else (1 if ec > c else -1)
+    assert dr == 0 or dc == 0, "path segments must be axis-aligned"
+
+    while (r, c) != (er, ec):
+        r += dr
+        c += dc
+        if int(src[r, c]) == bg:
+            out[r, c] = int(color)
