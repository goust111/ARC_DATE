+    buckets = {4: [], 3: [], 2: [], 1: [], 0: []}
+    h, w = labels.shape
+    for r, c in ordered:
+        same4 = 0
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds((h, w), nr, nc) and labels[nr, nc] == int(region_id):
+                same4 += 1
+        buckets[same4].append((r, c))
