+def _is_far_from_markers(pos: tuple[int, int], placed: set[tuple[int, int]]) -> bool:
+    r, c = pos
+    for rr, cc in placed:
+        if max(abs(r - rr), abs(c - cc)) <= 1:
+            return False
+    return True
