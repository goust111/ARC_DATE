+    bg = _get_bg(g)
+    wall_candidates = []
+    for color in sorted(int(c) for c in np.unique(g) if int(c) != bg):
+        analysis = _analyze_wall_map(g, color)
+        if analysis is not None:
+            wall_candidates.append((int(color), analysis))
