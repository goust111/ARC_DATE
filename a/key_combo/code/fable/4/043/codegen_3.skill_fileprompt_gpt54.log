+def _split_positive(total: int, parts: int, rng: random.Random) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(rng.sample(range(1, int(total)), parts - 1))
+    return [b - a for a, b in zip([0] + cuts, cuts + [int(total)])]
