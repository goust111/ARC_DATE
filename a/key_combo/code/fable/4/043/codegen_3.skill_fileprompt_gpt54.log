+
+def _apply_transform(grid: np.ndarray, op: int) -> np.ndarray:
+    if op == 0:
+        return grid.copy()
+    if op == 1:
+        return np.rot90(grid, 1)
+    if op == 2:
+        return np.rot90(grid, 2)
+    if op == 3:
+        return np.rot90(grid, 3)
+    if op == 4:
+        return np.fliplr(grid)
+    if op == 5:
+        return np.flipud(grid)
+    if op == 6:
