+def _render_markers(
+    wall_grid: np.ndarray,
+    labels: np.ndarray,
+    parity: dict[int, int],
+    bg: int,
+    wall: int,
+    fill0: int,
+    fill1: int,
+    noise0: int,
+    noise1: int,
+    rng: random.Random,
