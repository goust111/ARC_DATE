+    r, c = int(start_r), 0
+    cells = [(r, c)]
+    for h_run, v_run in zip(horiz_runs, vert_runs):
+        for _ in range(h_run):
+            c += 1
+            cells.append((r, c))
+        for _ in range(v_run):
+            r += 1
+            cells.append((r, c))
+    if (r, c) != (h - 1, int(end_c)):
+        return None
+    return cells
