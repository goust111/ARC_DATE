+    chosen: list[tuple[int, int]] = []
+    blocked = set(placed)
+    for pos in pool:
+        if _is_far_from_markers(pos, blocked):
+            chosen.append(pos)
+            blocked.add(pos)
+            if len(chosen) == count:
+                return chosen
