+    region_id: int,
+    count: int,
+    placed: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    ordered = _region_candidate_cells(labels, region_id)
+    if len(ordered) < count:
+        return None
+
+    buckets = {4: [], 3: [], 2: [], 1: [], 0: []}
+    h, w = labels.shape
+    for r, c in ordered:
+        same4 = 0
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds((h, w), nr, nc) and labels[nr, nc] == int(region_id):
+                same4 += 1
+        buckets[same4].append((r, c))
+
+    pool = buckets[4] + buckets[3] + buckets[2] + buckets[1] + buckets[0]
+    rng.shuffle(pool)
+    pool.sort(key=lambda pos: _region_candidate_cells(labels, region_id).index(pos))
