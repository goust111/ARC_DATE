+
+
+def _choose_positions_for_region(
+    labels: np.ndarray,
+    region_id: int,
+    count: int,
+    placed: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    ordered = _region_candidate_cells(labels, region_id)
+    if len(ordered) < count:
