+def _spaced_combos(values: list[int], n: int, gap: int) -> list[tuple[int, ...]]:
+    return [
+        combo
+        for combo in itertools.combinations(values, n)
+        if all(combo[i + 1] - combo[i] >= gap for i in range(len(combo) - 1))
+    ]
