    if not _gen_solver_accepts(inp, out):
        return None
    return inp


def generate_input():
    for _ in range(GENERATE_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 4b6b68e5 input")

