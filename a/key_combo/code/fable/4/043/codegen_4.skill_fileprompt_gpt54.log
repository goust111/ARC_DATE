+CHAIN_LENGTH_WEIGHTS = [1, 3, 3, 2, 1]
+DORMANT_DOMINO_RANGE = (1, 4)
+EXTRA_SINGLETON_RANGE = (2, 6)
+END_WITH_BLOCKER_PROB = 0.55
+MAX_LINK_DISTANCE = 7
