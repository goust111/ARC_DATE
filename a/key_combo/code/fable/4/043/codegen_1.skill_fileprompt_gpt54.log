    right = left + w + 1
    grid[top, left] = GEN_MARKER_COLOR
    grid[top, right] = GEN_MARKER_COLOR
    grid[bottom, left] = GEN_MARKER_COLOR
    grid[bottom, right] = GEN_MARKER_COLOR
    grid[top + 1 : bottom, left] = left_color
    grid[top + 1 : bottom, right] = right_color


