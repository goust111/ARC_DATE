+def _add_random_rect(
+    rects: list[dict],
+    used_lefts: set[int],
+    reserved: set[tuple[int, int]],
+    height: int,
+    width: int,
+    color: int,
+) -> bool:
+    for _ in range(EXTRA_RETRIES):
+        h = _random_span(height - 1)
+        w = _random_span(width - 1)
+        r0 = random.randint(0, height - h)
+        c0 = random.randint(0, width - w)
