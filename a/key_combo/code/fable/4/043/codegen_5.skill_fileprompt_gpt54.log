    right = np.zeros((h, half), dtype=bool)

    if contact_r == 0:
        left_edge_r = 0
        right_edge_r = random.randrange(h)
    elif contact_r == h - 1:
        left_edge_r = random.randrange(h)
        right_edge_r = h - 1
    else:
