+        width = n_panels * panel_w + (n_panels - 1)
+        grid = np.full((panel_h, width), bg, dtype=int)
+        for idx, candidate in enumerate(candidates):
+            c0 = idx * (panel_w + 1)
+            grid[:, c0 : c0 + panel_w] = candidate["panel"]
+            if idx < n_panels - 1:
+                grid[:, c0 + panel_w] = sep_color
+
+        out = main(grid)
+        assert out.shape == grid.shape
+        return grid
