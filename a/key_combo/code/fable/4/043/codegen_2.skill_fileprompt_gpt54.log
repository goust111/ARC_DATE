+def _complete_panel(panel: np.ndarray, bg: int) -> tuple[np.ndarray, int]:
+    r0, c0, painted = _find_rotation_square(panel, bg)
+    out = panel.copy()
+    added = 0
+    for (rr, cc), color in painted.items():
+        ar, ac = r0 + rr, c0 + cc
