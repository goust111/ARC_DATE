    b = bbox(missing)
    assert b is not None, "expected black missing-patch cells"
    r0, c0, r1, c1 = b
    assert (r1 - r0 + 1, c1 - c0 + 1) == (3, 3), "expected a 3x3 missing patch"
    assert int(missing.sum()) == 9, "expected exactly one 3x3 black patch"
