+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                orbit = _orbit((nr, nc), w)
+                if all(not mask[or_r, or_c] for or_r, or_c in orbit):
+                    frontier.add(orbit)
