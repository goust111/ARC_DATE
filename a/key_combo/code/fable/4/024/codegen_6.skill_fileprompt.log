+
+def _frontier_orbits(mask: np.ndarray) -> list[tuple[tuple[int, int], ...]]:
+    h, w = mask.shape
+    frontier: set[tuple[tuple[int, int], ...]] = set()
+    for r, c in np.argwhere(mask):
