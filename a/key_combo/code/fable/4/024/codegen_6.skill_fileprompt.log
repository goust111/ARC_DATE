def _contiguous_run_lengths(total: int, num_runs: int) -> list[int]:
    cuts = sorted(random.sample(range(1, total), num_runs - 1))
    return [b - a for a, b in zip([0] + cuts, cuts + [total])]


def _bar_color_sequence(num_bars: int) -> list[int]:
