+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+GEN_ATTEMPTS = 500
+GEN_SCENARIOS = (
+    (True, True),
+    (True, False),
+    (False, True),
+    (False, False),
+)
+GEN_SCENARIO_WEIGHTS = (4, 2, 2, 1)
+GEN_MOTIF_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
