+            continue
+
+        inside_bbox = (
+            (fg_coords[:, 0] >= r0)
+            & (fg_coords[:, 0] <= r1)
+            & (fg_coords[:, 1] >= c0)
+            & (fg_coords[:, 1] <= c1)
+        )
+        if not np.all(inside_bbox):
