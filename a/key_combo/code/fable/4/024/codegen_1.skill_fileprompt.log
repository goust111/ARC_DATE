# Mask density, symmetry, and connectivity constraints.
MIN_MASK_DENSITY = 0.39
MAX_MASK_DENSITY = 1.0
COMPONENT_COUNT_CHOICES = range(1, 6)
COMPONENT_CONNECTIVITY = 4
NONVERTICAL_MIN_HEIGHT = 2

# Retry limits.
MASK_ATTEMPTS = 20
