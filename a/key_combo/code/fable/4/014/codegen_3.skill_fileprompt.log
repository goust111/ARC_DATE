+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+CLOUD = 8
+SQUARE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+
+TEMPLATE_RETRIES = 300
+NOISE_RETRIES = 120
+PLACEMENT_RETRIES = 200
+GENERATION_RETRIES = 300
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors4_count(mask: np.ndarray) -> np.ndarray:
+    counts = np.zeros(mask.shape, dtype=int)
+    counts[1:, :] += mask[:-1, :]
+    counts[:-1, :] += mask[1:, :]
+    counts[:, 1:] += mask[:, :-1]
+    counts[:, :-1] += mask[:, 1:]
+    return counts
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    if not mask.any():
+        return False
+    return len(_components(mask)) == 1
+
+
+def _template_is_valid(mask: np.ndarray) -> bool:
+    if not mask.any() or mask.all():
+        return False
+    if not mask[0, :].any() or not mask[-1, :].any():
+        return False
+    if not mask[:, 0].any() or not mask[:, -1].any():
+        return False
+    if not _is_connected(mask):
+        return False
+    counts = _neighbors4_count(mask)
+    return bool(np.all(counts[mask] >= 2))
+
+
+def _apply_corner_notch(mask: np.ndarray, corner: str) -> None:
+    k = mask.shape[0]
+    if corner == "tl":
+        cells = ((0, 0), (0, 1), (1, 0))
+    elif corner == "tr":
+        cells = ((0, k - 1), (0, k - 2), (1, k - 1))
+    elif corner == "bl":
+        cells = ((k - 1, 0), (k - 2, 0), (k - 1, 1))
+    else:
+        cells = ((k - 1, k - 1), (k - 2, k - 1), (k - 1, k - 2))
+    for r, c in cells:
+        mask[r, c] = False
+
