+        final_cloud = cloud.copy()
+        for r, c in chosen:
+            final_cloud[r, c] = True
+        final_counts = _neighbors4_count(final_cloud)
+        if all(int(final_counts[r, c]) <= 1 for r, c in chosen):
+            return chosen
