+    ch, cw = cloud_patch.shape
+    k = square.shape[0]
+    min_h = max(ch, k) + 3
+    min_w = max(cw, k) + 3
+
+    for _ in range(PLACEMENT_RETRIES):
+        h = random.randint(min_h, 30)
+        w = random.randint(min_w, 30)
