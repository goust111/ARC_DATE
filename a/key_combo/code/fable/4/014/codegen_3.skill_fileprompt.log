+    return None
+
+
+def _build_cloud_patch(template: np.ndarray, pad: int) -> np.ndarray:
+    k = template.shape[0]
+    patch = np.zeros((k + 2 * pad, k + 2 * pad), dtype=int)
+    patch[pad : pad + k, pad : pad + k][template] = CLOUD
