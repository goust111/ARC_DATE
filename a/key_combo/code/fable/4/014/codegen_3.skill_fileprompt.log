+def _inside_noise_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    counts = _neighbors4_count(mask)
+    coords = np.argwhere(~mask)
+    return [
+        (int(r), int(c))
+        for r, c in coords
+        if int(counts[int(r), int(c)]) <= 1
+    ]
