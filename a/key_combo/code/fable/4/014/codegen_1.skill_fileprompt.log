+def _can_add_path_cell(
+    cell: tuple[int, int],
+    prev: tuple[int, int],
+    shape: tuple[int, int],
+    path_set: set[tuple[int, int]],
+    obstacles: dict[tuple[int, int], int],
+) -> bool:
+    r, c = cell
