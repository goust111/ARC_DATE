+            actual = main(inp)
+        except Exception:
+            continue
+        if not np.array_equal(actual, out):
+            continue
+        return inp, out
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
