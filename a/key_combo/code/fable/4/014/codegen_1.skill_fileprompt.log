+
+
+def _search_path(
+    current: tuple[int, int],
+    heading: int,
+    turn_sequence: list[str],
+    seg_idx: int,
+    shape: tuple[int, int],
+    path: list[tuple[int, int]],
+    path_set: set[tuple[int, int]],
+    obstacles: dict[tuple[int, int], int],
+    turn_records: list[tuple[int, int]],
