    grid = np.full((H, W), Color.BLACK, dtype=int)

    palette = random.sample(Color.NOT_BLACK, k=3)
    sprite = np.array([[random.choice(palette) for _ in range(h)] for _ in range(w)], dtype=int)

    for r0 in range(0, H, w):
