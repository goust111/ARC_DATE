+    return new_cells
+
+
+def _touches_cells(obj: dict, halo_cells: set[tuple[int, int]]) -> bool:
+    if not halo_cells:
+        return False
+    for r, c in obj["coords"]:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in halo_cells:
+                return True
+    return False
+
+
+def _simulate(grid: np.ndarray) -> tuple[np.ndarray, dict]:
