+        left_lo = max(0, c0 - width)
+        left_hi = min(w - width, c1 + 1)
+        return [(top, left) for left in range(left_lo, left_hi + 1)]
+
+    top = r0 - height - 1
+    if top < 0:
+        return []
+    left_lo = max(0, c0 - width)
+    left_hi = min(w - width, c1 + 1)
+    return [(top, left) for left in range(left_lo, left_hi + 1)]
+
+
