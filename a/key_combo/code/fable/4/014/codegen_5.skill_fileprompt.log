+def _draw_halo(out: np.ndarray, obj: dict, halo_color: int) -> set[tuple[int, int]]:
+    h, w = out.shape
+    r0, c0, r1, c1 = obj["bbox"]
+    new_cells: set[tuple[int, int]] = set()
