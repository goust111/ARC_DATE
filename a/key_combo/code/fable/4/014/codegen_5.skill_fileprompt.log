    for h2, w2 in RECT_DIMENSIONS
    if h1 * w1 != h2 * w2
    and (h1 + h2 + MIN_RECT_GAP <= GRID_SIZE or w1 + w2 + MIN_RECT_GAP <= GRID_SIZE)
)

