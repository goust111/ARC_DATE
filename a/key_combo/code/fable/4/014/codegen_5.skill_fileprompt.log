+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+OBJECT_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+OBJECT_DIMS = tuple(
+    (h, w)
+    for h in range(1, 5)
+    for w in range(1, 5)
