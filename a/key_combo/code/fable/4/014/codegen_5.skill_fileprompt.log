+        return None
+    if want_clipped and not any(_touches_border(objects[obj_idx], shape) for obj_idx in trace["ignited_order"]):
+        return None
+    if len(objects) > chain_len and len(trace["ignited_order"]) == len(objects):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
