    out = grid.copy()
    ranked = sorted(
        ((h * w, r, c, h, w) for r, c, h, w in placements),
        key=lambda item: item[0],
    )
    for fill, (_area, r, c, h, w) in zip(INTERIOR_COLORS_BY_AREA, ranked):
        out[r + 1 : r + h - 1, c + 1 : c + w - 1] = fill
    return out


