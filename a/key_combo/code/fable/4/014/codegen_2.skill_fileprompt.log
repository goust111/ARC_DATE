MIN_FILL_DENOMINATOR = 4

# CFG: same-color adjacency structure.
MIN_HORIZONTAL_EDGES = 1
MAX_HORIZONTAL_EDGES = 4
VERTICAL_EDGE_PROBABILITY = 0.45
NEIGHBOR_OFFSETS = ((0, -1), (0, 1), (-1, 0), (1, 0))

