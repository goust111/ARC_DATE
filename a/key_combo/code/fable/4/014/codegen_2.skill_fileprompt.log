MIN_RECT_SIDE, MAX_RECT_SIDE, MIN_RECT_GAP = 3, 6, 1
RECT_DIMENSIONS = tuple(
    (h, w)
    for h in range(MIN_RECT_SIDE, MAX_RECT_SIDE + 1)
    for w in range(MIN_RECT_SIDE, MAX_RECT_SIDE + 1)
)
VALID_DIMENSION_PAIRS = tuple(
    ((h1, w1), (h2, w2))
