import random
import numpy as np


def best_cycle(counts):
    # counts[a,b] reward for b being successor of a
    n = counts.shape[0]
    best_score = None
    best_order = None
    start = 0
    size = 1 << n
    neg = -10**9
    dp = [[neg] * n for _ in range(size)]
    parent = [[None] * n for _ in range(size)]
    dp[1 << start][start] = 0
    for mask in range(size):
        for last in range(n):
            cur = dp[mask][last]
            if cur == neg:
                continue
            for nxt in range(n):
                if mask >> nxt & 1:
                    continue
                score = cur + int(counts[last, nxt])
                nm = mask | (1 << nxt)
                if score > dp[nm][nxt]:
                    dp[nm][nxt] = score
                    parent[nm][nxt] = (mask, last)
    full = size - 1
    for last in range(n):
        if last == start:
            continue
        score = dp[full][last] + int(counts[last, start])
        if best_score is None or score > best_score:
            best_score = score
            order = [start]
            mask = full
            cur = last
            tail = []
            while cur "'!= start:
                tail.append(cur)
                mask, cur = parent[mask][cur]
            order.extend(reversed(tail))
            best_order = order
    return best_order, best_score

def infer(grid):
    colors = sorted(set(map(int, grid.flat)))
    n = len(colors)
    idx = {c:i for i,c in enumerate(colors)}
    trans = np.zeros((n,n), dtype=int)
    for row in grid:
        for a, b in zip(row[:-1], row[1:]):
            a = int(a); b = int(b)
            if a != b:
                trans[idx[a], idx[b]] += 1
    order_idx, _ = best_cycle(trans)
    order = [colors[i] for i in order_idx]
    pos = {color:i for i,color in enumerate(order)}
    best = None
    for sign in (1,-1):
        for phase in range(n):
            pred = np.array([[order[(phase + c + sign*r) % n] for c in range(grid.shape[1])] for r in range(grid.shape[0])], dtype=int)
            match = int(np.count_nonzero(pred == grid))
            cand = (match, sign, phase, pred, order)
            if best is None or cand[:3] > best[:3]:
                best = cand
    return best

def render(h,w,order,sign,phase=0):
    n = len(order)
    return np.array([[order[(phase + c + sign*r) % n] for c in range(w)] for r in range(h)], dtype=int)

for trial in range(5000):
    n = random.randint(3, 6)
    colors = random.sample(range(1, 10), n)
    sign = random.choice((1,-1))
    phase = random.randrange(n)
    h = random.randint(n+2, 24)
    w = random.randint(n+2, 24)
    base = render(h,w,colors,sign,phase)
    occ = base.copy()
    occupied = np.zeros_like(base, dtype=bool)
    patch_count = random.randint(1,4)
    placed = 0
    for _ in range(200):
        if placed >= patch_count:
            break
        ph = random.randint(2, min(6, h))
        pw = random.randint(2, min(7, w))
        r0 = random.randint(0, h-ph)
        c0 = random.randint(0, w-pw)
        rr0 = max(0, r0-1); rr1 = min(h, r0+ph+1); cc0 = max(0, c0-1); cc1 = min(w, c0+pw+1)
        if occupied[rr0:rr1, cc0:cc1].any():
            continue
        color = random.choice(colors)
        before = occ[r0:r0+ph, c0:c0+pw].copy()
        if np.count_nonzero(before != color) < max(2, before.size // 3):
            continue
        occ[r0:r0+ph, c0:c0+pw] = color
        occupied[r0:r0+ph, c0:c0+pw] = True
        placed += 1
    if placed == 0:
        continue
    match, guess_sign, guess_phase, pred, guess_order = infer(occ)
    if not np.array_equal(pred, base):
        print('"'fail', trial)
        print('n/sign/phase/colors', n, sign, phase, colors)
        print('guess', guess_sign, guess_phase, guess_order)
        print('occ shape', occ.shape)
        print(occ)
        print(base)
        raise SystemExit
print('ok')
