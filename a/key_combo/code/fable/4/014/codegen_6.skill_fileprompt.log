def _try_place_patches(base: np.ndarray, cycle: list[int]) -> np.ndarray | None:
    height, width = map(int, base.shape)
    patch_target = random.randint(*PATCH_COUNT_RANGE)
    painted = base.copy()
    reserved = np.zeros_like(base, dtype=bool)
