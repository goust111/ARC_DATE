import random
import numpy as np

def best_assignment(counts):
    n = counts.shape[0]
    size = 1 << n
    dp = [-10**9] * size
    prev_mask = [-1] * size
    prev_color = [-1] * size
    dp[0] = 0
    for mask in range(size):
        res = mask.bit_count()
        if res >= n or dp[mask] < 0:
            continue
        base = dp[mask]
        for color in range(n):
            if mask >> color & 1:
                continue
            nxt = mask | (1 << color)
            score = base + int(counts[res, color])
            if score > dp[nxt]:
                dp[nxt] = score
                prev_mask[nxt] = mask
                prev_color[nxt] = color
    assign = [0] * n
    mask = size - 1
    for res in range(n - 1, -1, -1):
        assign[res] = prev_color[mask]
        mask = prev_mask[mask]
    return assign, dp[-1]

def infer(grid):
    colors = sorted(set(map(int, grid.flat)))
    n = len(colors)
    color_to_idx = {c:i for i,c in enumerate(colors)}
    best = None
    for sign in (1, -1):
        counts = np.zeros((n, n), dtype=int)
        for r in range(grid.shape[0]):
            for c in range(grid.shape[1]):
                res = (c + sign * r) % n
                counts[res, color_to_idx[int(grid[r, c])]] += 1
        assign, score = best_assignment(counts)
        cyc = [colors[i] for i in assign]
        pred = np.array([[cyc[(c + sign * r) % n] for c in range(grid.shape[1])] for r in range(grid.shape[0])], dtype=int)
        bad = int(np.count_nonzero(pred "'!= grid))
        cand = (score, -bad, sign, cyc, pred)
        if best is None or cand > best:
            best = cand
    return best

def render(h,w,cyc,sign):
    n = len(cyc)
    return np.array([[cyc[(c + sign * r) % n] for c in range(w)] for r in range(h)], dtype=int)

for trial in range(500):
    n = random.randint(3, 6)
    colors = random.sample(range(1, 10), n)
    sign = random.choice((1,-1))
    h = random.randint(n+2, 20)
    w = random.randint(n+2, 20)
