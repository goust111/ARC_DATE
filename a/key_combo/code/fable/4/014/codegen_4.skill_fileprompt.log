+    limit = grid.shape[axis]
+    best_step = None
+    best_support = -1
+
+    for step in range(1, limit):
+        if axis == 0:
+            left = grid[:-step, :]
+            right = grid[step:, :]
+            valid = ~ignore_mask[:-step, :] & ~ignore_mask[step:, :]
