+    h, w = _shape((r0, c0, r1, c1))
+    if h < 3 or w < 3:
+        return False
+
+    patch = np.zeros((h, w), dtype=bool)
+    patch[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return np.array_equal(patch, border)
