+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+GRAY = 5
+PATTERN_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GENERATION_RETRIES = 400
+PLACEMENT_RETRIES = 200
+TILE_RETRIES = 200
