+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc):
+                    if not _in_bounds((h, w), nr, nc) or seen[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
