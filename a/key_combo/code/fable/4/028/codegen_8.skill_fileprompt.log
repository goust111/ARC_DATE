+    cell_set = set(cells)
+    if cell_set == {(box_r, box_c), (box_r + 1, box_c + 1)}:
+        return "\\"
+    if cell_set == {(box_r, box_c + 1), (box_r + 1, box_c)}:
+        return "/"
