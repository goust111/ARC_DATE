+
+
+def _start_direction(shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:
+    h, w = shape
+    sides = []
+    if r == 0:
+        sides.append(DIR_DOWN)
+    if r == h - 1:
+        sides.append(DIR_UP)
+    if c == 0:
+        sides.append(DIR_RIGHT)
+    if c == w - 1:
