+        interior = int(patch[1, 1])
+        if border == interior:
+            continue
+        expected = np.full((h, w), interior, dtype=int)
+        expected[0, :] = border
+        expected[-1, :] = border
+        expected[:, 0] = border
+        expected[:, -1] = border
