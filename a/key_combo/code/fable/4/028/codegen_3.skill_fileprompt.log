        marker = (nr1, random.randint(nc0, nc1))
    elif direction == "left":
        frame_box = (nr0, nc0 + d, nr1, nc1)
        marker = (random.randint(nr0, nr1), nc0)
    else:
        frame_box = (nr0, nc0, nr1, nc1 - d)
        marker = (random.randint(nr0, nr1), nc1)
    return frame_box, marker


