+            candidates.append(((r0, c0, r1, c1), border, interior))
+    assert len(candidates) == 1, "expected one two-color solid rectangle"
+    return candidates[0]
+
+
+def _cascade_box(
+    box: tuple[int, int, int, int], markers: set[tuple[int, int]]
