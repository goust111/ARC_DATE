+    for r, c in shifted_chain:
+        if not _well_separated((r, c), occupied):
+            return None
+        inp[r, c] = marker_color
+        occupied.add((r, c))
+
+    distractors = _place_distractors(shifted_final, inp.shape, occupied)
+    for r, c in distractors:
