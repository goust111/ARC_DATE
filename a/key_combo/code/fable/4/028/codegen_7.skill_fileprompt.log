GRID_SIZE_RANGE = (11, 13)
BACKGROUND_COLOR = 0

# Palette choices.
MARKER_COLOR = 8
FRAME_COLOR_POOL = [color for color in range(1, 10) if color != MARKER_COLOR]

# Frame and expansion geometry.
DIRECTIONS = ["up", "down", "left", "right"]
VERTICAL_DIRECTIONS = {"up", "down"}
