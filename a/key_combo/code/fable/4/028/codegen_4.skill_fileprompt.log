+def _ring_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int], thickness: int = WALL_THICKNESS) -> np.ndarray:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((h, w), dtype=bool)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
