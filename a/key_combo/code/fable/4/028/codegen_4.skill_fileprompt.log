+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _shape_from_coords(coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _mask_variants(mask: np.ndarray) -> list[np.ndarray]:
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    out: list[np.ndarray] = []
+    for flip in (False, True):
+        base = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = (cur.shape, cur.astype(np.uint8).tobytes())
+            if key not in seen:
+                seen.add(key)
+                out.append(cur.copy())
+    return out
+
+
+def _canonical_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return min((variant.shape, variant.astype(np.uint8).tobytes()) for variant in _mask_variants(mask))
