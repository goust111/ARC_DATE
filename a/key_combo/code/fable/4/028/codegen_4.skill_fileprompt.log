+    inner_r0 = r0 + WALL_THICKNESS
+    inner_c0 = c0 + WALL_THICKNESS
+    inner_r1 = r1 - WALL_THICKNESS
+    inner_c1 = c1 - WALL_THICKNESS
+    seed_r = random.randint(inner_r0 + 1, inner_r1 - 1)
+    seed_c = random.randint(inner_c0 + 1, inner_c1 - 1)
