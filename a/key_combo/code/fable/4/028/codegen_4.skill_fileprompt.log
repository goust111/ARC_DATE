+        variants.append(variant)
+    return variants
+
+
+def _place_hole(side: str, mask: np.ndarray, outer_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = outer_bbox
