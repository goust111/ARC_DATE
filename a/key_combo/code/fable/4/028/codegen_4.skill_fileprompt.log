+                best_color = color
+                best_comp = comp
+    assert best_color is not None and best_comp is not None
+    return best_color, best_comp, _bbox(best_comp)
+
+
+def _flood_fill(passable: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = passable.shape
+    seen = np.zeros_like(passable, dtype=bool)
