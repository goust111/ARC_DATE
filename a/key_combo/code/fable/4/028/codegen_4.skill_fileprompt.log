+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(20, 30)
+    w = random.randint(20, 30)
+    grid = np.full((h, w), BACKGROUND, dtype=int)
+
+    colors = list(range(1, 10))
+    random.shuffle(colors)
+    wall_color = colors.pop()
+    seed_color = colors.pop()
+
+    outer_h = random.randint(10, min(16, h - 6))
+    outer_w = random.randint(10, min(16, w - 6))
+    r0 = random.randint(3, h - outer_h - 3)
+    c0 = random.randint(3, w - outer_w - 3)
+    outer_bbox = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
+    r1 = outer_bbox[2]
+    c1 = outer_bbox[3]
