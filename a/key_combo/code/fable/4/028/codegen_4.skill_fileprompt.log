+    out = g.copy()
+    matched_sprite_ids: set[int] = set()
+    for hole_comp in hole_components:
+        hole_shape, _ = _shape_from_coords(hole_comp)
+        hole_key = _canonical_key(hole_shape)
+        matches = sprites_by_key.get(hole_key, [])
