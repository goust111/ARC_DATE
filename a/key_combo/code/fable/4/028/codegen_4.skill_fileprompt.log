+
+def _find_wall(grid: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int]], tuple[int, int, int, int]]:
+    best_color = None
+    best_comp = None
+    best_size = -1
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for comp in _components(grid == color):
