+            return None
+
+    if expected_unique_matches != len(matched_indices):
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid shape-key flood input")

