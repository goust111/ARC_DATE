        sprite_key_counts[key] = sprite_key_counts.get(key, 0) + 1

    expected_unique_matches = 0
    for idx, hole in enumerate(holes):
        count = sprite_key_counts.get(hole["key"], 0)
        if idx in matched_indices:
            if count != 1:
