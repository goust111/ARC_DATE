+    mask = np.zeros((h, w), dtype=bool)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    mask[r0 + thickness : r1 - thickness + 1, c0 + thickness : c1 - thickness + 1] = False
+    return mask
