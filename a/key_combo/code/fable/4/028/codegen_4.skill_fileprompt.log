+    pad_c0 = max(0, left - 1)
+    pad_r1 = min(h - 1, top + sh)
+    pad_c1 = min(w - 1, left + sw)
+    if np.any(grid[pad_r0 : pad_r1 + 1, pad_c0 : pad_c1 + 1] != BACKGROUND):
