+    return True
+
+
+def _draw_sprite(grid: np.ndarray, sprite: np.ndarray, top: int, left: int, color: int) -> None:
+    sh, sw = sprite.shape
+    for rr in range(sh):
+        for cc in range(sw):
+            if sprite[rr, cc]:
+                grid[top + rr, left + cc] = color
