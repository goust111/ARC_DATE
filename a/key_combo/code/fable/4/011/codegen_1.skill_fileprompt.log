+    exit_side = start_frame.gap_side(exit_gap)
+    direction = SIDE_TO_INWARD[exit_side]
+    candidates: list[Coord] = []
+    cur = _add(exit_gap, direction)
+    while True:
+        r0, c0, r1, c1 = start_frame.bbox
+        if not (r0 < cur[0] < r1 and c0 < cur[1] < c1):
