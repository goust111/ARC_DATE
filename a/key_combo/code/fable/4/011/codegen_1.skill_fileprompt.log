+def _path_segment_is_clear(
+    cells: list[Coord],
+    occupied_bboxes: set[Coord],
+    reserved_path: set[Coord],
+) -> bool:
+    return all(cell not in occupied_bboxes and cell not in reserved_path for cell in cells)
