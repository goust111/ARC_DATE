+START_MARGIN = 2
+SEGMENT_LENGTH_RANGE = (3, 7)
+RELAY_COUNT_CHOICES = (1, 2, 3)
+RELAY_COUNT_WEIGHTS = (2, 4, 3)
+EXTRA_FRAME_CHOICES = (0, 1, 2)
+EXTRA_FRAME_WEIGHTS = (3, 4, 2)
