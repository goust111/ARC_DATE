+        color_idx += 1
+        frames.append(blocker_frame)
+        occupied_bboxes |= _bbox_cells(blocker_frame.bbox)
+        reserved_path |= set(final_cells)
+        path_cells.extend(final_cells)
+
+    for _ in range(extra_count):
