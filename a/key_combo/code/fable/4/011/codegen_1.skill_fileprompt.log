def _gen_stamp_targets(center, offsets, n):
    r, c = center
    targets = [(r + dr, c + dc, color) for dr, dc, color in offsets]
    return [(rr, cc, color) for rr, cc, color in targets if 0 <= rr < n and 0 <= cc < n]


