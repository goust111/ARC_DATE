+            exit_offset_max = fh - 2 if exit_side in {"left", "right"} else fw - 2
+            entry_offset = random.randint(1, entry_offset_max)
+            exit_offset = random.randint(1, exit_offset_max)
+            frame = _frame_from_entry(
+                shape,
+                entry_gap,
+                entry_side,
