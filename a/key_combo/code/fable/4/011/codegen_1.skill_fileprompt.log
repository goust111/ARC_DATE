+
+    marker = markers[0]
+    marker_color = int(grid[marker])
+
+    host_frames = []
+    for frame in frames:
+        r0, c0, r1, c1 = frame.bbox
+        if r0 < marker[0] < r1 and c0 < marker[1] < c1:
+            host_frames.append(frame)
+    assert len(host_frames) == 1, "marker must lie inside exactly one frame"
+
+    host = host_frames[0]
+    aligned: list[tuple[Coord, Coord]] = []
+    for gap in host.gaps:
+        if gap[0] != marker[0] and gap[1] != marker[1]:
+            continue
+        segment = _line_cells(marker, gap)
+        if all(int(grid[cell]) == BG for cell in segment):
+            aligned.append((gap, _direction_between(marker, gap)))
+    assert len(aligned) == 1, "marker must align with exactly one usable gap"
