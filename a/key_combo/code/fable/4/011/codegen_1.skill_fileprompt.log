+def _path_to_edge(shape: tuple[int, int], current_pos: Coord, current_dir: Coord) -> list[Coord]:
+    cells: list[Coord] = []
+    cur = current_pos
+    while True:
+        nxt = _add(cur, current_dir)
+        if not _in_bounds(shape, nxt):
+            break
+        cells.append(nxt)
+        cur = nxt
+    return cells
+
