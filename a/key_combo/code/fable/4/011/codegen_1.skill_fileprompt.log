+DIR_TO_ENTRY_SIDE: dict[Coord, str] = {direction: side for side, direction in SIDE_TO_INWARD.items()}
+DIR_TO_EXIT_SIDE: dict[Coord, str] = {direction: side for side, direction in SIDE_TO_OUTWARD.items()}
