+        hit_offset = random.randint(1, hit_offset_max)
+
+        if hit_side == "left":
+            bbox = (hit_cell[0] - hit_offset, hit_cell[1], hit_cell[0] - hit_offset + fh - 1, hit_cell[1] + fw - 1)
+        elif hit_side == "right":
