+    inp = _render_input(shape, frames, marker, marker_color)
+    expected = _paint_expected(inp, path_cells, marker_color)
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
