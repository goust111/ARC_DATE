    row_colors = {
        int(g[r, 0])
        for r in range(g.shape[0])
        if np.all(g[r, :] == g[r, 0])
    }
    col_colors = {
        int(g[0, c])
        for c in range(g.shape[1])
        if np.all(g[:, c] == g[0, c])
    }
    candidates = row_colors & col_colors
