+    start, end = runs[0]
+    assert end - start + 1 < line.size, "counter segment must be shorter than the full border"
+    segment = line[start : end + 1]
+    color = int(segment[0])
+    assert color != edge_color, "counter segment must use a color different from the edge bar"
