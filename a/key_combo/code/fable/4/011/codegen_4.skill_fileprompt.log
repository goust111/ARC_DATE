+        elif i == 1:
+            should_wrap = False
+        else:
+            should_wrap = random.random() < 0.5
+        index = _sample_marker_index(step_count, walk_length, should_wrap)
+        r, c = _coord_from_index(shape, side, channel, index)
+        if grid[r, c] != bg:
