+SIDES = ("top", "bottom", "left", "right")
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+PALETTE = tuple(range(10))
+MAX_GENERATION_ATTEMPTS = 400
