+
+    for _ in range(PLACEMENT_TRIES):
+        size = _sample_frame_size(height, width)
+        if size is None:
+            return None
+        outer_h, outer_w = size
+
+        row_lo = max(0, pr0 - outer_h + 2)
+        row_hi = min(height - outer_h, pr1)
+        col_lo = max(0, pc0 - outer_w + 2)
+        col_hi = min(width - outer_w, pc1)
