+        cells = _frame_cells(bbox)
+
+        if len(cells & prior_cell_sets[-1]) not in REQUIRED_PREV_OVERLAPS:
+            continue
+        if any(len(cells & older) not in ALLOWED_OLDER_OVERLAPS for older in prior_cell_sets[:-1]):
