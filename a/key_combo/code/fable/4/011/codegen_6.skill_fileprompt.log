COLOR_POOL = list(range(10))

def frame_cells(bb):
    r0,c0,r1,c1 = bb
    cells=set()
    for c in range(c0,c1+1):
        cells.add((r0,c)); cells.add((r1,c))
    for r in range(r0+1,r1):
        cells.add((r,c0)); cells.add((r,c1))
