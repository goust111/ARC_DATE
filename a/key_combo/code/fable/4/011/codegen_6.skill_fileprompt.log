+
+# --------------- generator ---------------
+
+GRID_HEIGHT_RANGE = (16, 24)
+GRID_WIDTH_RANGE = (16, 24)
+FRAME_COUNT_CHOICES = (3, 4, 5)
+FRAME_SIZE_MIN = 4
+FRAME_SIZE_MAX = 11
+GRID_BORDER = 1
+
+REQUIRED_PREV_OVERLAPS = (2, 4)
+ALLOWED_OLDER_OVERLAPS = (0, 2, 4)
+MAX_OLDER_OVERLAP_FRAMES = 1
