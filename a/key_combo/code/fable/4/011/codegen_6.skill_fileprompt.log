GENERATION_TRIES = 300


def _frame_cells(r0, c0, r1, c1):
    """Return set of (r, c) for the 1-cell-thick border of a rectangle."""
    cells = set()
    for c in range(c0, c1 + 1):
        cells.add((r0, c))
        cells.add((r1, c))
    for r in range(r0 + 1, r1):
        cells.add((r, c0))
        cells.add((r, c1))
    return cells


def _sample_layer_order():
