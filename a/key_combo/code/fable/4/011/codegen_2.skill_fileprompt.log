+def _analyze_family(grid: np.ndarray, family: str) -> tuple[int, list[tuple[int, int, int]]]:
+    n = int(grid.shape[0])
+    total_cost = 0
+    anomalies: list[tuple[int, int, int]] = []
+    for orbit in _iter_orbits(n, family):
