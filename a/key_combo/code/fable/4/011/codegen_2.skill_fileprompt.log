+    for r0 in range(n - h + 1):
+        for c0 in range(n - w + 1):
+            ok = True
+            for dr, dc, _ in coords:
+                r = r0 + dr
+                c = c0 + dc
+                if not (r < c and r + c < n - 1):
+                    ok = False
+                    break
+            if ok:
+                candidates.append((r0, c0))
+    return candidates
+
