+    positions: list[tuple[int, int]] = []
+    placed = np.zeros_like(template)
+    for dr, dc, value in coords:
+        ar, ac = transform(r0 + dr, c0 + dc)
+        positions.append((int(ar), int(ac)))
+        placed[dr, dc] = value
