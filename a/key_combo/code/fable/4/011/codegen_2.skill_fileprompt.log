+    shift = random.randint(1, len(colors) - 1)
+    return {color: colors[(idx + shift) % len(colors)] for idx, color in enumerate(colors)}
+
+
+def _family_transform(n: int, family: str, variant: int):
+    if family == "hv":
+        transforms = (
+            lambda r, c: (r, c),
+            lambda r, c: (r, n - 1 - c),
+            lambda r, c: (n - 1 - r, c),
+            lambda r, c: (n - 1 - r, n - 1 - c),
