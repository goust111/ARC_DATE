  30:     assert g.ndim == 2, "expected a 2D grid"
  31: 
  32:     present = set(map(int, np.unique(g)))
  33:     assert STATIC_COLORS <= present, "expected yellow and orange divider colors"
  34:     moving_colors = present - STATIC_COLORS
  35:     assert len(moving_colors) >= 2, "expected at least two regions to cycle"
  36: 
  37:     components = find_components(
