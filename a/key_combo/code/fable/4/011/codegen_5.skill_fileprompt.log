+    return CARDINAL_OFFSETS.index(tuple(offset))
+
+
+def _rotate_offset_cw(offset: tuple[int, int], k: int) -> tuple[int, int]:
+    dr, dc = map(int, offset)
+    for _ in range(k % 4):
