+def _gray_neighbor_offset(grid: np.ndarray, r: int, c: int, bg: int) -> tuple[int, int] | None:
+    color = int(grid[r, c])
+    if color in (bg, GRAY):
+        return None
+    hits = []
+    for dr, dc in CARDINAL_OFFSETS:
+        rr, cc = r + dr, c + dc
+        if in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == GRAY:
+            hits.append((dr, dc))
+    if len(hits) != 1:
+        return None
+    return hits[0]
