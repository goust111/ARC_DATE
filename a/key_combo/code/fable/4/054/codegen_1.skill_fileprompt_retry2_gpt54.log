+        pattern: list[int | None] = [None] * period
+        ok = True
+        for idx, color in enumerate(colors):
+            if color == unknown:
+                continue
+            slot = idx % period
+            seen = pattern[slot]
+            if seen is None:
+                pattern[slot] = int(color)
+            elif seen != int(color):
+                ok = False
