+
+    inp = clean.copy()
+    for idx in occluded:
+        r, c = path[idx]
+        inp[r, c] = OCCLUDER
+    return inp, clean
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = int(RNG.integers(10, 17))
+    width = int(RNG.integers(10, 17))
+    bg = int(RNG.choice(np.array([c for c in ALL_COLORS if c != OCCLUDER], dtype=int)))
+
+    path = _build_snake(height, width)
