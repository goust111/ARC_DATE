+    bg: int = BG,
+) -> tuple[int, int]:
+    """Return (unique_ray_cells, rays_blocked_by_stacks_or_bar)."""
+    settled = _settle_grid(
+        shape=shape,
+        bar_row=bar_row,
+        bar_c0=bar_c0,
+        bar_c1=bar_c1,
+        bar_color=bar_color,
+        particle_color=particle_color,
+        counts=counts,
+        bg=bg,
