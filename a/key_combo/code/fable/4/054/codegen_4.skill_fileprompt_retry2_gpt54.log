+    extra_inside = [c for c in inside if counts[c] == 0]
+    if extra_inside:
+        extra_n = int(rng.integers(1, min(3, len(extra_inside)) + 1))
+        for c in rng.choice(np.array(extra_inside, dtype=int), size=extra_n, replace=False):
