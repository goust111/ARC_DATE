_GEN_COL_BLOCK_COUNT_RANGE = (5, 12)
_GEN_ROW_BLOCK_SIZE_RANGE = (1, 5)
_GEN_COL_BLOCK_SIZE_RANGE = (1, 4)

# Palette and local rectangle painting controls.
