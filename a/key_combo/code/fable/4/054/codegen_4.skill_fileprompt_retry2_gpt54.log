+    """Render the bar and all gravity-settled stacks before splash rays."""
+    height, width = map(int, shape)
+    out = np.full((height, width), int(bg), dtype=int)
+    out[bar_row, bar_c0 : bar_c1 + 1] = int(bar_color)
+
