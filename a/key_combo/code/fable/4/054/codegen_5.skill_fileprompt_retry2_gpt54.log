def _gen_edge_layouts(indices, lengths, width, row):
    if not indices:
        return [()]
    if len(indices) == 1:
        idx = indices[0]
        length = lengths[idx]
        return [((idx, row, c0),) for c0 in range(width - length + 1)]
    if len(indices) > MAX_LEGENDS_PER_EDGE:
        return []

    layouts = []
    a, b = indices
    for first, second in ((a, b), (b, a)):
