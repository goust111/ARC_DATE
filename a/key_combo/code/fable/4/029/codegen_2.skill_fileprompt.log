+    return points
+
+
+def _find_blocks(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int]]:
+    blocks: list[tuple[int, int, int, int]] = []
+    for comp in _components(g != bg):
+        if len(comp) <= 1:
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h != w or h < 2:
