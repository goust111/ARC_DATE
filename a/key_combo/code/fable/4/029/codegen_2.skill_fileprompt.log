+        if dr < 0 or dc < 0 or dr % block_step != 0 or dc % block_step != 0:
+            return None
+        rr = dr // block_step
+        cc = dc // block_step
+        key = (int(rr), int(cc))
+        prev = merged.get(key)
+        if prev is not None:
+            if prev != color:
+                return None
+            overlap += 1
+        merged[key] = int(color)
