+    h, w = panel.shape
+    for r in range(h):
+        for c in range(w):
+            if int(panel[r, c]) != path_color:
+                continue
+            for dr, dc in ((0, 1), (1, 0)):
+                a = (r - dr, c - dc)
+                b = (r + dr, c + dc)
+                if not (_in_bounds(panel.shape, *a) and _in_bounds(panel.shape, *b)):
+                    continue
