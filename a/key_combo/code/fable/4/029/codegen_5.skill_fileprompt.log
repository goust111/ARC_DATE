40:def main(grid: np.ndarray) -> np.ndarray:
41:    """Count each colored object's enclosed black pixels and pack those counts into a 3x3 summary.
42:
43:    Input structure
44:    - A black background contains exactly two 4-connected monochrome foreground objects arranged left-to-right.
45:    - Each foreground object encloses one or more black pixels inside its bounding box.
46:
47:    Rule
48:    - Count, for each object, the black pixels inside its bounding box that are not 4-connected to the bounding-box border through black pixels.
49:    - In left-to-right object order, allocate enough 3-wide output rows for that count and fill that many cells left-to-right with the object's color.
50:
51:    Key insight
52:    - The output is not the hole shapes themselves; it is a compact row-packed count summary of the enclosed background area of each object.
53:    """
54:    g = np.asarray(grid, dtype=int)
55:    assert g.ndim == 2
56:
57:    bg = Color.BACKGROUND
58:    assert np.any(g == bg)
59:
60:    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
61:    comps = sorted(comps, key=lambda comp: comp["bbox"][1])
62:    assert len(comps) == 2
63:    assert comps[0]["bbox"][3] < comps[1]["bbox"][1]
64:
65:    out = np.full((3, 3), bg, dtype=int)
66:    out_row = 0
67:    for comp in comps:
68:        count = _enclosed_bg_count(g, comp, bg)
69:        assert count > 0
70:        rows_needed = (count + 2) // 3
71:        assert out_row + rows_needed <= out.shape[0]
72:
73:        for k in range(count):
74:            out[out_row + k // out.shape[1], k % out.shape[1]] = int(comp["color"])
75:        out_row += rows_needed
76:
77:    return out
