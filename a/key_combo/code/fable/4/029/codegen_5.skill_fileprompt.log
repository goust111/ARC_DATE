23:def main(grid: np.ndarray) -> np.ndarray:
24:    """Complete the erased cells of a periodic wallpaper by inferring its smallest repeating tile.
25:
26:    Input structure
27:    A rectangular grid contains a multi-color repeating pattern. The background
28:    color is also a valid tile color, and some non-background pattern pixels
29:    have been erased to that background color.
30:
31:    Rule
32:    Ignore background-colored cells and find the unique smallest row/column
33:    period whose residue classes assign every visible foreground pixel one
34:    consistent color. Repaint each foreground residue class across the whole
35:    grid, leaving residue classes with no foreground evidence as background.
36:
37:    Key insight
38:    The visible foreground pixels are enough to recover the wallpaper's period;
39:    erased pixels are exactly the background cells in foreground residue classes.
40:    """
41:    g = np.asarray(grid, dtype=int)
42:    assert g.ndim == 2
43:    height, width = g.shape
44:    assert height > 0 and width > 0
45:
46:    values, counts = np.unique(g, return_counts=True)
47:    max_count = int(counts.max())
48:    assert int(np.count_nonzero(counts == max_count)) == 1
49:    bg = get_bg(g)
50:    assert int(counts[values == bg][0]) == max_count
51:
52:    candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []
53:    for row_period in range(1, height + 1):
54:        for col_period in range(1, width + 1):
55:            tile = _foreground_tile_for_period(g, bg, row_period, col_period)
56:            if tile is not None:
57:                candidates.append((row_period, col_period, tile))
58:
59:    assert candidates
60:    min_area = min(row_period * col_period for row_period, col_period, _ in candidates)
61:    best = [
62:        candidate
63:        for candidate in candidates
64:        if candidate[0] * candidate[1] == min_area
65:    ]
66:    assert len(best) == 1
67:    row_period, col_period, tile = best[0]
68:    assert tile
69:
70:    out = np.full_like(g, bg)
71:    for (tile_r, tile_c), color in tile.items():
72:        out[tile_r::row_period, tile_c::col_period] = color
73:    return out
