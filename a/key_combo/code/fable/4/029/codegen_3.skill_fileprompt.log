        cropp=visible_period(crop, BG, ignore={marker})
        if fullp != (pr,2*f):
            continue
        if not (cropp[1] < fullp[1]):
            continue
        # expected is full wallpaper crop
        expected = wallpaper[:, :W//2] if keep_left else wallpaper[:, W//2:]
        return grid, expected, fullp, cropp, (pr,f), changed
    return None

for i in range(50):
    x=gen_vertical()
