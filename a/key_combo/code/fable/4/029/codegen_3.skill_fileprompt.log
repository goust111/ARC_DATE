+    h, w = tile.shape
+    for pr in range(1, h + 1):
+        for pc in range(1, w + 1):
+            classes: dict[tuple[int, int], int] = {}
+            ok = True
+            for r in range(h):
+                for c in range(w):
+                    key = (r % pr, c % pc)
+                    color = int(tile[r, c])
+                    prev = classes.get(key)
+                    if prev is not None and prev != color:
+                        ok = False
+                        break
+                    classes[key] = color
+                if not ok:
