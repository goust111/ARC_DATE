        row_reps=random.randint(max(3,(8+pr-1)//pr), min(8,30//pr))
        col_rep_half=random.randint(2, max(2, 30//(4*f)))
        W=2*col_rep_half*(2*f)
        if W>30:
            continue
        H=row_reps*pr
        wallpaper=np.tile(T,(row_reps,2*col_rep_half))
        keep_left=random.choice([True,False])
        grid=wallpaper.copy()
        keep_slice=(slice(None), slice(0,W//2) if keep_left else slice(W//2,W))
        kept=grid[keep_slice]
        erased_positions=[]
        for rr,cc in changed:
            cols=range(0,W//2) if keep_left else range(W//2,W)
            for r in range(H):
                if r%pr!=rr:
                    continue
                for c in cols:
                    if c%(2*f)==cc and wallpaper[r,c]!=BG:
                        grid[r,c]=BG
                        erased_positions.append((r,c))
        if len(erased_positions)<2:
            continue
        row_to_cols={}
        for r,c in erased_positions:
            row_to_cols.setdefault(r,[]).append(c)
        candidate_rows=[r for r,cs in row_to_cols.items() if len(cs)>=2]
        if not candidate_rows:
            continue
        mr=random.choice(candidate_rows)
        cs=random.sample(row_to_cols[mr],2)
        marker=random.choice([x for x in PALETTE if x not in set(np.unique(wallpaper))])
        for c in cs:
            grid[mr,c]=marker
        fullp=visible_period(grid, BG, ignore={marker})
