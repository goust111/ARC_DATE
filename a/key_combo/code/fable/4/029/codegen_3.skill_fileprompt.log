 191:     prior = panels[:-1]
 192:     next_time = len(prior)
 193: 
 194:     predictions: list[tuple[int, np.ndarray]] = []
 195:     for color in diff_colors:
 196:         times = [i for i, panel in enumerate(prior) if np.any(panel == color)]
 197:         assert len(times) >= 2
 198:         gaps = [b - a for a, b in zip(times, times[1:])]
 199:         assert len(set(gaps)) == 1
 200:         period = gaps[0]
 201:         if next_time - times[-1] != period:
 202:             continue
 203: 
