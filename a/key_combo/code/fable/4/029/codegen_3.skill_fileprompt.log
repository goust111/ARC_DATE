+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h % 2 == 0 or w % 2 == 0
+
+    bg = _get_bg(g)
+    marker = _find_marker_color(g, bg)
