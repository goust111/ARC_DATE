import random
from collections import Counter
import numpy as np

BG = 0
PALETTE = [1,2,3,4,5,6,7,8,9]

def get_bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]

def full_period(tile):
    h,w = tile.shape
    for pr in range(1,h+1):
        for pc in range(1,w+1):
            ok=True
            seen={}
            for r in range(h):
                for c in range(w):
                    k=(r%pr,c%pc)
                    v=int(tile[r,c])
                    if k in seen and seen[k]"'!=v:
                        ok=False; break
                    seen[k]=v
                if not ok: break
            if ok:
                return pr,pc
    raise AssertionError

def visible_period(grid, bg, ignore=()):
    ignore=set(ignore)
    h,w=grid.shape
    for pr in range(1,h+1):
        for pc in range(1,w+1):
            ok=True
            seen={}
            for r in range(h):
                for c in range(w):
                    v=int(grid[r,c])
                    if v==bg or v in ignore:
                        continue
                    k=(r%pr,c%pc)
                    if k in seen and seen[k]!=v:
                        ok=False; break
                    seen[k]=v
                if not ok: break
            if ok:
                return pr,pc
    raise AssertionError

def make_base(pr,f):
    for _ in range(500):
        F = np.random.choice([BG,1,2,3,4,5,6], size=(pr,f), p=[0.3,0.14,0.14,0.14,0.1,0.09,0.09])
        if not np.any(F!=BG):
            continue
        if full_period(F)!=(pr,f):
            continue
        return F
    return None

def gen_vertical():
    for _ in range(1000):
        pr=random.randint(1,3)
        f=random.randint(1,3)
        F=make_base(pr,f)
        if F is None:
            continue
        T=np.concatenate([F,F.copy()],axis=1)
        choices=[(r,c) for r in range(pr) for c in range(f)]
        random.shuffle(choices)
        n_alt=random.randint(1,max(1,min(len(choices),pr+1)))
        changed=[]
        for r,c in choices:
            old=int(T[r,c+f])
            color=random.choice([x for x in PALETTE if x!=old])
            T[r,c+f]=color
            changed.append((r,c+f))
            if len(changed)>=n_alt and full_period(T)==(pr,2*f):
                break
        if full_period(T)!=(pr,2*f):
