+            classes: dict[tuple[int, int], int] = {}
+            ok = True
+            for r, c, color in visible:
+                key = (r % pr, c % pc)
+                prev = classes.get(key)
+                if prev is not None and prev != color:
+                    ok = False
+                    break
+                classes[key] = color
+            if ok:
+                return pr, pc, classes
+    raise AssertionError("some period should always fit")
+
