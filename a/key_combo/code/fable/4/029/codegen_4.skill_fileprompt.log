+        hole_mask[r0 : r1 + 1, c0 : c1 + 1] = local_holes
+
+        boundary_black: deque[tuple[int, int, int]] = deque()
+        seen = np.zeros(g.shape, dtype=bool)
+        for r, c in comp["coords"]:
+            for nr, nc in _neighbors4(r, c):
+                if not _in_bounds(g.shape, nr, nc):
+                    continue
