 155:     h, w = int(rect_h), int(rect_w)
 156:     for t in thicks:
 157:         inner_h, inner_w = h - 2 * t, w - 2 * t
 158:         areas.append(h * w - inner_h * inner_w)
 159:         h, w = inner_h, inner_w
 160:     areas.append(h * w)
