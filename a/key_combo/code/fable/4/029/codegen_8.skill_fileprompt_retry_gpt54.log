 265: def _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:
 266:     out = np.full((h, w), bg, dtype=int)
 267:     area = h * w
 268:     min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))
 269:     max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))
 270:     target = random.randint(min_deco, max_deco)
 271:     orbits = _sym_orbits(h, w)
 272:     random.shuffle(orbits)
 273:     count = 0
 274:     for orbit in orbits:
 275:         if count >= target:
 276:             break
 277:         if count + len(orbit) > max_deco and count >= min_deco:
 278:             continue
 279:         for r, c in orbit:
 280:             out[r, c] = deco
 281:         count += len(orbit)
 282:     return out
