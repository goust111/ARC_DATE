  49: def main(grid: np.ndarray) -> np.ndarray:
  50:     """
  51:     Reverse the nested color layers inside each solid rectangular foreground object.
  52: 
  53:     Input structure
  54:     - The background is the most common color.
  55:     - Every 4-connected foreground object is a filled rectangle.
  56:     - Each rectangle is made from inward nested rectangular color layers, with a
  57:       uniform boundary at every peel step.
  58: 
  59:     Rule
  60:     - For each rectangle independently, read its layer colors from outermost to
  61:       innermost by repeatedly peeling the current uniform boundary.
  62:     - Recolor every pixel of each layer to the color at the opposite position in
  63:       that outer-to-inner order.
  64:     - Keep the background unchanged.
  65: 
  66:     Key insight
  67:     - The transformation reverses the order of the colored rectangular layers,
  68:       not the one-cell geometric distance shells; thick layers move as whole
  69:       color masks.
  70:     """
  71:     g = np.asarray(grid, dtype=int)
  72:     assert g.ndim == 2, "expected a 2D grid"
  73: 
  74:     bg = get_bg(g)
  75:     out = g.copy()
  76:     components = components_mask(g != bg, connectivity=4)
  77:     assert components, "expected at least one foreground rectangle"
  78: 
  79:     for coords in components:
  80:         r0, c0, r1, c1 = bbox_coords(coords)
  81:         rect_mask = g[r0 : r1 + 1, c0 : c1 + 1] != bg
  82:         assert np.all(rect_mask), "foreground component must fill its bounding box"
  83: 
  84:         rect = g[r0 : r1 + 1, c0 : c1 + 1]
  85:         layer_colors = _layer_order(rect)
  86:         color_map = dict(zip(layer_colors, reversed(layer_colors)))
  87: 
  88:         out_rect = out[r0 : r1 + 1, c0 : c1 + 1]
  89:         for src, dst in color_map.items():
  90:             out_rect[rect == src] = dst
  91: 
  92:     return out
