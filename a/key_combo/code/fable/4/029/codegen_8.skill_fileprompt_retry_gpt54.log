 285: def _base_patterns(axis_len: int, line_len: int, max_back: int) -> list[tuple[int, list[list[tuple[int, int]]]]]:
 286:     patterns: list[tuple[int, list[list[tuple[int, int]]]]] = []
 287:     for growth in range(BLOB_GROWTH_MIN, BLOB_GROWTH_MAX + 1):
 288:         extra = max_back * growth
 289:         max_initial_width = axis_len - extra
 290:         if max_initial_width < 1:
 291:             continue
 292: 
 293:         for lines in range(1, min(BLOB_MAX_LINE_COUNT, line_len) + 1):
 294:             for width in range(1, min(BLOB_MAX_WIDTH, max_initial_width, BLOB_MAX_INITIAL_CELLS // lines) + 1):
 295:                 patterns.append((growth, [[(0, width - 1)] for _ in range(lines)]))
 296: 
 297:         if line_len >= 2 and max_initial_width >= 2:
 298:             for lines in range(2, min(BLOB_MAX_LINE_COUNT + 1, line_len) + 1):
 299:                 width = min(2, max_initial_width)
 300:                 if lines * width <= BLOB_MAX_INITIAL_CELLS and width + 1 + extra <= axis_len:
 301:                     patterns.append((growth, [[(i % 2, i % 2 + width - 1)] for i in range(lines)]))
 302: 
 303:         if line_len >= 3 and max_initial_width >= 3:
