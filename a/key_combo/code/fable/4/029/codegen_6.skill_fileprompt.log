        if candidate[0] * candidate[1] == min_area
    ]
    assert len(best) == 1
    row_period, col_period, tile = best[0]
    assert tile

    out = np.full_like(g, bg)
    for (tile_r, tile_c), color in tile.items():
        out[tile_r::row_period, tile_c::col_period] = color
    return out

