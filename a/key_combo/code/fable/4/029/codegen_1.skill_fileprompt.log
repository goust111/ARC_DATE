+    occupied_above = _shifted_cells(shape, top_anchor)
+
+    for idx in range(1, sprite_count):
+        color = top_to_bottom[idx]
+        prev_cells = _shifted_cells(shape, anchors[top_to_bottom[idx - 1]])
+        placed = False
+        for _ in range(_GEN_PLACEMENT_TRIES):
