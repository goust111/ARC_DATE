+    w = random.randint(_GEN_SHAPE_W_RANGE[0], min(_GEN_SHAPE_W_RANGE[1], max_w))
+    target = random.randint(_GEN_SHAPE_CELLS_RANGE[0], min(_GEN_SHAPE_CELLS_RANGE[1], h * w - 1))
+
