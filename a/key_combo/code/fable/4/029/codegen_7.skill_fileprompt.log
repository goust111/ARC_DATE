+    comps = _find_color_components(g, skip_colors={bg})
+    frames = []
+    for comp in comps:
+        if int(comp["color"]) != FRAME_COLOR:
+            continue
+        r0, c0, r1, c1 = comp["bbox"]
+        local_mask = g[r0 : r1 + 1, c0 : c1 + 1] == FRAME_COLOR
