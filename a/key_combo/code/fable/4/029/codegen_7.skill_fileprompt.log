+def _mirror_for_longer_leg(mask: np.ndarray, frame_h: int, frame_w: int) -> np.ndarray:
+    if frame_h > frame_w:
+        return np.fliplr(mask)
+    return np.flipud(mask)
+
+
+def _inside_bbox(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return (
+        (coords[:, 0] >= r0)
+        & (coords[:, 0] <= r1)
+        & (coords[:, 1] >= c0)
+        & (coords[:, 1] <= c1)
+    )
