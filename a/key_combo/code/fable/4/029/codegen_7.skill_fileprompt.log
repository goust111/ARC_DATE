    return out


def _random_connected_mask(rng: np.random.Generator, h: int, w: int) -> np.ndarray | None:
    area_min = max(4, int(np.ceil(h * w * 0.4)))
    area_max = min(h * w - 1, int(np.floor(h * w * 0.7)))
