+def _place_bbox(
+    rng: np.random.Generator,
+    existing: list[tuple[int, int, int, int]],
+    grid_h: int,
+    grid_w: int,
+    obj_h: int,
+    obj_w: int,
+) -> tuple[int, int] | None:
+    for _ in range(120):
+        top = int(rng.integers(0, grid_h - obj_h + 1))
+        left = int(rng.integers(0, grid_w - obj_w + 1))
+        bbox = (top, left, top + obj_h - 1, left + obj_w - 1)
