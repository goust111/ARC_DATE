import random

import numpy as np
from typing import *
from arc_utils import Color, colors_present, draw_line, find_components, paste

# concepts:
# growing, connecting

# description:
# In the input you will see two pixels of different colors aligned horizontally or vertically.
# To make the output, you need to connect the two pixels with two lines and a hollow rectangle of size 4x5 in the middle.
# Half of the rectangle is colored with the color of the one side's pixel, and the other half with the color of the other side's pixel.

def main(input_grid):
    """
    Connect two aligned colored pixels through a centered split-color hollow rectangle.

    Input structure:
    - Two single pixels of different colors are aligned horizontally or vertically.
    - The background is black.
    - There is enough space between the pixels for the hollow rectangle bridge.

    Rule:
    - Rotate vertical cases into a horizontal canonical form.
    - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
    - Paste it midway between the pixels and connect each pixel to the nearest side.

    Key insight:
    - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
    """
    # Plan (from the original seed solver):
    # 1. Parse the input
    # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
    # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
    # 4. Place the rectangle in the middle of the two pixels
    # 5. Draw lines to connect the original two pixels with the rectangle
    # 6. Rotate the grid back if it was not originally horizontal
    #
    # Implementation note:
    # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
    #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
    comps = find_components(
        input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
    )
    if len(comps) != 2:
        return input_grid.copy()

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))

    rotated = False
    grid = input_grid
    if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
        grid = np.rot90(grid)
        rotated = True

    comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
    if len(comps) != 2:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))
    c0 = int(comps[0]["color"])
    c1 = int(comps[1]["color"])

    # Should now be horizontally aligned
    if p0[0] != p1[0]:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    # Sort left->right by column
    if p0[1] <= p1[1]:
        left_pos, right_pos = p0, p1
        left_color, right_color = c0, c1
    else:
        left_pos, right_pos = p1, p0
        left_color, right_color = c1, c0

    r = left_pos[0]
    c_left = left_pos[1]
    c_right = right_pos[1]

    output_grid = grid.copy()

    # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
    # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
    rect_h, rect_w = 5, 4
    rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
    rect[:, 0] = left_color
    rect[:, -1] = right_color
    rect[0, : rect_w // 2] = left_color
    rect[0, rect_w // 2 :] = right_color
    rect[-1, : rect_w // 2] = left_color
    rect[-1, rect_w // 2 :] = right_color

    middle_c = (c_left + c_right + 1) // 2
    paste(
        output_grid,
        rect,
        r - rect_h // 2,
        middle_c - rect_w // 2,
        transparent=Color.BLACK,
        clip=True,
    )

    # Connect left/right pixels to the rectangle via horizontal lines
    draw_line(
        grid=output_grid,
        r=r,
        c=c_left + 1,
        direction=(0, 1),
        color=left_color,
        stop_at=Color.NOT_BLACK,
    )
    draw_line(
        grid=output_grid,
        r=r,
        c=c_right - 1,
        direction=(0, -1),
        color=right_color,
        stop_at=Color.NOT_BLACK,
    )

    if rotated:
        output_grid = np.rot90(output_grid, k=-1)
    return output_grid

def generate_input():
    # Generate a random background grid
    # Make sure the grid's width is greater than its height
    width, height = random.randint(15, 20), random.randint(10, 15)
    grid = np.zeros((width, height), dtype=int)

    # Get the color of two pixels
    colors = np.random.choice(Color.NOT_BLACK, 2, replace=False)
    color1, color2 = colors

    # Place the two pixels on the grid horizontally (randomly rotate at the end to get a variety of orientations)
    x1 = np.random.randint(0, width)
    x2 = np.random.randint(0, width)
    c = np.random.randint(0, height)

    # Ensure there is enough horizontal distance to place the 4x5 rectangle
    distance = abs(x2 - x1)
    rectangle_width, rectangle_height = 4, 5
    if distance < rectangle_width+1: return generate_input()

    # Ensure the remaining distance is odd, so that we can split the pixel colors in half between them
    if (distance - rectangle_width) % 2 != 1: return generate_input()

    # Ensure there is enough vertical space to place the rectangle
    if c < rectangle_height // 2 or c + rectangle_height // 2 >= height: return generate_input()    

    # Place the two pixels on the grid
    grid[x1, c] = color1
    grid[x2, c] = color2

    # Randomly rotate the whole grid
    if np.random.rand() < 0.5:
        grid = np.rot90(grid, k=-1)

    return grid
from __future__ import annotations
import numpy as np
from arc_utils import colors_present, crop_bbox, find_components, get_bg, paste, random_free_location
from arc_utils import find_components, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.

    Input structure:
    - bg = background color.
    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).

    Rule:
    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).

    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # Find multicolor connected components of the foreground as a whole.
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (len(comps) != 2)

    infos = []
    for comp in comps:
        patch = crop_bbox(g, comp["bbox"])
        cols = colors_present(patch, exclude={bg})
        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})

    # Building block is the component with >=2 colors (or more unique colors), preferring square.
    infos.sort(
        key=lambda d: (
            len(d["cols"]) >= 2,
            len(d["cols"]),
            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
        ),
        reverse=True,
    )
    block = infos[0]["patch"]
    ctrl = infos[1]["patch"]

    bh, bw = map(int, block.shape)
    ch, cw = map(int, ctrl.shape)

    ctrl_cols = colors_present(ctrl, exclude={bg})
    if not ctrl_cols:
        return np.full((0, 0), int(bg), dtype=int)

    ctrl_col = int(ctrl_cols[0])
    mask = (ctrl == int(ctrl_col))

    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if bool(mask[r, c]):
                paste(out, block, r * bh, c * bw)
    return out

# --------------- generator (Codex#3) ---------------

def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
    seen: set[tuple[int, int]] = set()
    out: list[tuple[list[tuple[int, int]], bool]] = []
    s = int(size)
    for r in range(s):
        for c in range(s):
            if (r, c) in seen:
                continue
            orbit = {
                (r, c),
                (c, s - 1 - r),
                (s - 1 - r, s - 1 - c),
                (s - 1 - c, r),
                (r, s - 1 - c),
                (s - 1 - r, c),
                (c, r),
                (s - 1 - c, s - 1 - r),
            }
            cells = sorted(orbit)
            seen.update(cells)
            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
            out.append((cells, border))
    return out


def _make_tile(bg: int, fg_colors: list[int], rng: np.random.Generator) -> np.ndarray:
    size = int(rng.integers(3, 6))
    n_tile_colors = int(rng.integers(2, 4))
    tile_colors = list(rng.choice(fg_colors, size=n_tile_colors, replace=False))
    orbits = _dihedral_orbits(size)
    rng.shuffle(orbits)

    tile = np.full((size, size), int(bg), dtype=int)
    assignments: dict[int, int] = {}
    for i, color in enumerate(tile_colors):
        assignments[i] = int(color)

    interior_idxs = [i for i, (_cells, border) in enumerate(orbits) if not border and i not in assignments]
    if interior_idxs and rng.random() < 0.25:
        assignments[int(rng.choice(interior_idxs))] = int(bg)

    for i, (_cells, border) in enumerate(orbits):
        if i not in assignments:
            palette = tile_colors if border else tile_colors + ([bg] if interior_idxs else [])
            assignments[i] = int(rng.choice(palette))

    for i, (cells, _border) in enumerate(orbits):
        for r, c in cells:
            tile[r, c] = assignments[i]
    return tile


def _neighbors8(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            rr = r + dr
            cc = c + dc
            if 0 <= rr < h and 0 <= cc < w:
                out.append((rr, cc))
    return out


def _make_ctrl(bg: int, color: int, rng: np.random.Generator) -> np.ndarray:
    h = int(rng.integers(3, 6))
    w = int(rng.integers(3, 6))
    area = h * w
    min_fill = (area + 1) // 2
    max_fill = int(np.floor(0.72 * area))
    target = int(rng.integers(min_fill, max_fill + 1))

    ar = int(rng.integers(0, h))
    ac = int(rng.integers(0, w))
    mask = np.zeros((h, w), dtype=bool)
    mask[:, ac] = True
    mask[ar, :] = True

    while int(mask.sum()) < target:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if any(mask[rr, cc] for rr, cc in _neighbors8(h, w, r, c)):
                    frontier.append((r, c))
        pick = frontier[int(rng.integers(len(frontier)))]
        mask[pick] = True

    ctrl = np.full((h, w), int(bg), dtype=int)
    ctrl[mask] = int(color)
    return ctrl


def _compose_output(tile: np.ndarray, ctrl: np.ndarray, bg: int) -> np.ndarray:
    th, tw = tile.shape
    ch, cw = ctrl.shape
    out = np.full((ch * th, cw * tw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if ctrl[r, c] != bg:
                paste(out, tile, r * th, c * tw)
    return out


