    fill = np.tile(tile, (bar_height // height, 1))
    target = g[r0 : r1 + 1, c + 1 : c + 1 + width]
    assert np.all((target == bg) | (target == fill))
    out[r0 : r1 + 1, c + 1 : c + 1 + width] = fill


