+        jobs: list[int] = []
+        for spec in placed:
+            loop_spec = spec[0]
+            jobs.extend([int(loop_spec["fill_color"])] * int(loop_spec["concave_count"]))
+        random.shuffle(jobs)
+
+        blocked = _blocked_for_markers(grid.shape, placed)
