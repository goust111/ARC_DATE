+    prev = start
+    cur = neighbors[0]
+    while cur != start:
+        path.append(cur)
+        nxt = [(nr, nc) for nr, nc in _neighbors4(*cur) if (nr, nc) in pts and (nr, nc) != prev]
+        assert len(nxt) == 1, (cur, nxt)
+        prev, cur = cur, nxt[0]
