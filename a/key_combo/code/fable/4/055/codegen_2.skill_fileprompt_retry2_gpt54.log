+def _concave_count(coords: np.ndarray) -> int:
+    counts = _turn_counts(_trace_cycle(coords))
+    assert counts
+    assert abs(counts[1] - counts[-1]) == 4, counts
+    return int(min(counts[1], counts[-1]))
