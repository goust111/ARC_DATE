+def _turn_counts(path: list[tuple[int, int]]) -> Counter[int]:
+    counts: Counter[int] = Counter()
+    n = len(path)
+    for i, (r, c) in enumerate(path):
+        pr, pc = path[i - 1]
+        nr, nc = path[(i + 1) % n]
+        incoming = (r - pr, c - pc)
+        outgoing = (nr - r, nc - c)
+        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
+        if cross != 0:
