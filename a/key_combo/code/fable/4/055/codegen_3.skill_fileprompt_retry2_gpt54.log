        for pivot in candidates[ordered[i]]:
            if pivot in used:
                continue
            used.add(pivot)
            search(i + 1, used)
            used.remove(pivot)

    search(0, set())
    return count


def _all_triples(n: int, want_oob: bool, want_same_row: bool) -> list[Triple]:
    triples: list[Triple] = []
    for pr in range(n):
