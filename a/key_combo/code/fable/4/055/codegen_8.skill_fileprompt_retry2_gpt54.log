one of those components may already be a long\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:302:# - Recognize the arrow's facing direction from its protruding tip, not from the marker's contact side.\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:304:# - Repeat that tile from its current seed position all the way to the boundary in the arrow-indicated direction,\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:305:#   while preserving arrow-colored cells.\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:308:#   fails. Only the arrow silhouette's asymmetric protrusion consistently identifies the ray direction.\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:315:    arrow_col = detect_arrow_component_color(g, bg=bg, connectivity=4)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:316:    if arrow_col is None:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:319:    arrow_lab, an = label_mask(g == int(arrow_col), connectivity=4)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:320:    non_mask = (g != int(bg)) & (g != int(arrow_col))\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:324:        arrow_mask = arrow_lab == int(ak)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:325:        arrow_coords = np.argwhere(arrow_mask)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:326:        if arrow_coords.size == 0:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:329:        ar0, ac0, ar1, ac1 = bbox_coords(arrow_coords)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:330:        local_arrow = arrow_mask[int(ar0):int(ar1) + 1, int(ac0):int(ac1) + 1]\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:331:        direction = _match_arrow_direction(local_arrow)\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:336:        for r, c in arrow_coords:\n/home/lixinyu/snap/new/ceshi/code_combo/53fb4810/4/code.py:362