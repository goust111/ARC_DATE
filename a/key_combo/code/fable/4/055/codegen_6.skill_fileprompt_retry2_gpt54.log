+    bottom = int(rng.integers(extra_h - top + 1))
+    left = int(rng.integers(extra_w + 1))
+    right = int(rng.integers(extra_w - left + 1))
+    grid_h = base_h + top + bottom
+    grid_w = base_w + left + right
