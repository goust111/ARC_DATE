+    shape_sigs = [_shape_signature(np.argwhere(spec["shape"])) for spec in pair_specs]
+    color_list = [int(spec["key_color"]) for spec in pair_specs]
+    if max(Counter(shape_sigs).values()) < 2 or max(Counter(color_list).values()) < 2:
