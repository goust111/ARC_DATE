def _gen_d6e50e54_count_allocations(total, caps):
    if not caps:
        return [()] if total == 0 else []

    out = []
    rest_min = len(caps) - 1
    rest_max = sum(caps[1:])
    for first in range(1, caps[0] + 1):
        remaining = total - first
