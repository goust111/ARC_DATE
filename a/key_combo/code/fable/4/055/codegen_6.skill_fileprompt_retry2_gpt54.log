+    slot_h = max(int(p.shape[0]) for p in patches) + 2
+    slot_w = max(int(p.shape[1]) for p in patches) + 2
+
+    layouts = []
+    for rows in range(2, min(total, 4) + 1):
+        cols = (total + rows - 1) // rows
+        base_h = rows * slot_h
+        base_w = cols * slot_w
+        if base_h <= 30 and base_w <= 30:
