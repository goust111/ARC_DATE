+    right = _gen_side_notches(outer_h, left_right_depth, counts["right"])
+    bottom = _gen_side_notches(outer_w, top_bottom_depth, counts["bottom"])
+    left = _gen_side_notches(outer_h, left_right_depth, counts["left"])
