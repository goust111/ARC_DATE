+    colors = {point: int(g[point]) for point in points}
+    cycle = _reconstruct_cycle(points, colors)
+
+    out = g.copy()
+    for a, b in zip(cycle, cycle[1:]):
+        for r, c in _cells_between(a, b)[1:-1]:
+            out[r, c] = GREY
