+    solutions: dict[tuple[tuple[int, int], ...], list[tuple[int, int]]] = {}
+    for start in sorted(points):
+        for incoming0 in DIRS:
+            cycle = _trace_candidate(start, incoming0, turn_signs, rows, cols)
+            if cycle is None:
+                continue
