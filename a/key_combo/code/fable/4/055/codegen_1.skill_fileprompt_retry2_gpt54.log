+        prev = vertices[i - 1]
+        nxt = vertices[(i + 1) % n]
+        incoming = _direction(prev, cur)
+        outgoing = _direction(cur, nxt)
+        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
+        if cross == 0:
+            return None
+        counts[-1 if cross < 0 else 1] += 1
+    return counts
