+    height = max(r for r, _ in occupied) + 1
+    width = max(c for _, c in occupied) + 1
+    inp = np.full((height, width), BLACK, dtype=int)
+    out = np.full((height, width), BLACK, dtype=int)
+
+    for r, c in occupied:
+        out[r, c] = GREY
+
