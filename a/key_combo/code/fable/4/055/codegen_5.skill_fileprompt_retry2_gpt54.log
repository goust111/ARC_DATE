+GEN_BG = 0
+GEN_COLORS = tuple(range(1, 10))
+GEN_DIM_RANGE = (6, 11)
+GEN_COUNT_OPTIONS = (3, 4)
+GEN_MARGIN_RANGE = (2, 5)
+GEN_GAP_RANGE = (2, 5)
