+    for i in range(count - 1):
+        cut += base[i]
+        max_overlap = min(2, base[i] - 1, base[i + 1] - 1)
+        overlaps.append(random.randint(1, max_overlap))
+    cut = 0
+    starts[0] = 0
+    for i in range(count - 1):
+        cut += base[i]
+        ends[i] = cut + overlaps[i] - 1
+        starts[i + 1] = cut - overlaps[i]
+    ends[-1] = length - 1
+    return [(starts[i], ends[i]) for i in range(count)]
+
