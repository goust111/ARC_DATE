+    for dr in range(-hb + 1, ha):
+        for dc in range(-wb + 1, wa):
+            overlap = _overlap_slices(a.shape, b.shape, dr, dc)
+            if overlap is None:
+                continue
+            ars, acs, brs, bcs = overlap
+            if np.array_equal(a[ars, acs], b[brs, bcs]):
+                offsets.append((dr, dc))
+    return offsets
