+def _stripe_intervals(length: int, count: int) -> list[tuple[int, int]] | None:
+    if length < 2 * count:
+        return None
+    base = _random_composition(length, count, 2)
+    starts = [0] * count
+    ends = [0] * count
+    cut = 0
