+def _assemble(pieces: list[np.ndarray]) -> np.ndarray:
+    n = len(pieces)
+    pair_offsets = [[[] for _ in range(n)] for _ in range(n)]
+    for i in range(n):
+        for j in range(n):
+            if i != j:
+                pair_offsets[i][j] = _matching_offsets(pieces[i], pieces[j])
