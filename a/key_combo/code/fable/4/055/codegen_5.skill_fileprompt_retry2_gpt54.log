+def _scatter_pieces(pieces: list[np.ndarray]) -> np.ndarray | None:
+    order = list(range(len(pieces)))
+    random.shuffle(order)
+    pieces = [pieces[i] for i in order]
+    layouts_by_count = {
+        3: [(3,), (1, 2), (2, 1)],
+        4: [(4,), (2, 2), (1, 3), (3, 1)],
+    }
+    layouts = list(layouts_by_count[len(pieces)])
+    random.shuffle(layouts)
