+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and space_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                queue.append((nr, nc))
+    return outside
+
