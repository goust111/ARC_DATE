import random
from collections import Counter, defaultdict

import numpy as np


DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
PALETTE = list(range(1, 10))
MAX_GENERATION_ATTEMPTS = 400


def _get_bg(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def _neighbors4(r: int, c: int):
    for dr, dc in DIRS4:
        yield r + dr, c + dc


def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    components = []

    for r in range(h):
        for c in range(w):
            color = int(grid[r, c])
            if color == bg or seen[r, c]:
                continue

            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                rr, cc = stack.pop()
                cells.append((rr, cc))
                for nr, nc in _neighbors4(rr, cc):
                    if not _in_bounds(grid.shape, nr, nc) or seen[nr, nc]:
                        continue
                    if int(grid[nr, nc]) != color:
                        continue
                    seen[nr, nc] = True
                    stack.append((nr, nc))

            coords = np.array(cells, dtype=int)
            components.append(
                {
                    "color": color,
                    "coords": coords,
                    "bbox": _bbox_from_coords(coords),
                    "area": len(cells),
                }
            )

    return components


def _candidate_frame_specs_for_bbox(bbox: tuple[int, int, int, int]) -> list[dict]:
    r0, c0, r1, c1 = bbox
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    specs = []

    if h == 3 and w >= 4:
        for gap_side in ("left", "right"):
            mask = np.zeros((h, w), dtype=bool)
            mask[0, :] = True
            mask[2, :] = True
            mask[:, 0] = True
            mask[:, -1] = True
            gap_local = (1, 0 if gap_side == "left" else w - 1)
            mask[gap_local] = False
            cols = range(w - 2, 0, -1) if gap_side == "left" else range(1, w - 1)
            corridor_local = [(1, c) for c in cols]
            specs.append(
                {
                    "orientation": "horizontal",
                    "gap_side": gap_side,
                    "mask": mask,
                    "gap_local": gap_local,
                    "corridor_local": corridor_local,
                }
            )

    if w == 3 and h >= 4:
        for gap_side in ("top", "bottom"):
            mask = np.zeros((h, w), dtype=bool)
            mask[:, 0] = True
            mask[:, 2] = True
            mask[0, :] = True
            mask[-1, :] = True
            gap_local = (0 if gap_side == "top" else h - 1, 1)
            mask[gap_local] = False
            rows = range(h - 2, 0, -1) if gap_side == "top" else range(1, h - 1)
            corridor_local = [(r, 1) for r in rows]
            specs.append(
                {
                    "orientation": "vertical",
                    "gap_side": gap_side,
                    "mask": mask,
                    "gap_local": gap_local,
                    "corridor_local": corridor_local,
                }
            )

