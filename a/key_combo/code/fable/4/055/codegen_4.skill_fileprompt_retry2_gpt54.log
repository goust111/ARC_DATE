+        for _ in range(count - 1):
+            options = [cell for cell in eligible if _manhattan(cell, gap) >= distance and not blocked[cell]]
+            if not options:
+                return None
+            cell = random.choice(options)
+            placements[color].append(cell)
+            _mark_blocked(blocked, *cell)
