        remaining = n_sprites - i - 1
        current_sum = sum(along_dims)
        lo = max(SPRITE_DIM_MIN, ALONG_SUM_MIN - current_sum - SPRITE_DIM_MAX * remaining)
        hi = min(SPRITE_DIM_MAX, ALONG_SUM_MAX - current_sum - SPRITE_DIM_MIN * remaining)
        if lo > hi:
