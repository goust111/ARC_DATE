+            max_erases = min(len(candidates), max(1, block_size // 2 + 1))
+            force_noise = (br, bc) == noisy_wall or (br, bc) == noisy_passage
+            if force_noise:
+                erase_count = random.randint(1, max_erases)
+            elif random.random() < 0.55:
