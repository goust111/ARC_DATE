+
+            macro = np.full((rows, cols), PASSAGE, dtype=int)
+            for r, c in wall_positions:
+                macro[r, c] = WALL
+            macro[start] = ENDPOINT
+            macro[goal] = ENDPOINT
+            return macro, route
+
+    raise RuntimeError("failed to sample a valid macro maze")
+
