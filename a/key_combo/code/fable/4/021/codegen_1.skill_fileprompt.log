+            else:
+                erase_count = 0
+
+            if erase_count == 0 and state == ENDPOINT and random.random() < 0.5:
+                erase_count = 1
+
+            for rr, cc in random.sample(candidates, erase_count):
+                grid[r0 + rr, c0 + cc] = ERASE
