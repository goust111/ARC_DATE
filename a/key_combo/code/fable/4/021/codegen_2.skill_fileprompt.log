def _gen_scatter_input(widths: list[int], tops: list[int], raw_sprites: list[np.ndarray]) -> np.ndarray:
    """Place marked sprites left-to-right with the fixed input gap."""
    inp_w = sum(widths) + _GEN_INPUT_GAP * (len(raw_sprites) - 1)
