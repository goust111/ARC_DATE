from itertools import product

def classify(A,C):
    r0,c0=A;r1,c1=C
    dr=r1-r0;dc=c1-c0
    sr=1 if dr>0 else -1
    sc=1 if dc>0 else -1
    if abs(dr)<abs(dc):
        L=abs(dr)
        u=(sr*L,sc*L)
        v=(0,sc*(abs(dc)-L))
    else:
        L=abs(dc)
        u=(sr*L,sc*L)
        v=(sr*(abs(dr)-L),0)
    det=u[0]*v[1]-u[1]*v[0]
    D=abs(det)
    verts=[A,(A[0]+u[0],A[1]+u[1]),(A[0]+v[0],A[1]+v[1]),C]
    rmin=min(r for r,c in verts); rmax=max(r for r,c in verts)
    cmin=min(c for r,c in verts); cmax=max(c for r,c in verts)
    B=(A[0]+u[0],A[1]+u[1]); Dp=(A[0]+v[0],A[1]+v[1])
    def line(a,b):
        dr=b[0]-a[0];dc=b[1]-a[1]
        sr=0 if dr==0 else dr//abs(dr)
        sc=0 if dc==0 else dc//abs(dc)
        n=max(abs(dr),abs(dc))
        return {(a[0]+i*sr,a[1]+i*sc) for i in range(n+1)}
    boundary=line(A,B)|line(A,Dp)|line(Dp,C)|line(B,C)
    ins=[]; bd=[]
    for p in product(range(rmin,rmax+1), range(cmin,cmax+1)):
        pr=p[0]-A[0]; pc=p[1]-A[1]
        a=pr*v[1]-pc*v[0]
        b=u[0]*pc-u[1]*pr
        if det<0:
            a=-a;b=-b
        if 0<a<D and 0<b<D:
            ins.append(p)
        elif ((a==0 or a==D) and 0<=b<=D) or ((b==0 or b==D) and 0<=a<=D):
            bd.append(p)
    print('A,C',A,C,'u',u,'v',v,'boundary_match',set(bd)==boundary,'inside',sorted(ins),'boundary',sorted(boundary))

for A,C in [((0,0),(3,5)),((0,5),(3,0)),((5,0),(0,4)),((0,0),(5,3)),((5,5),(1,2))]:
    classify(A,C)
