    interior: set[Coord] = set()
    boundary: set[Coord] = set()
    for r in range(max(0, r0), min(shape[0] - 1, r1) + 1):
        for col in range(max(0, c0), min(shape[1] - 1, c1) + 1):
            kind = _classify_point((r, col), a, c)
            if kind == "inside":
                interior.add((r, col))
            elif kind == "boundary":
                boundary.add((r, col))
    return interior, boundary


