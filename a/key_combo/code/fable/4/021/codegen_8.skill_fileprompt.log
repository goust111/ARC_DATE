+        for idx, (r0, c0, r1, c1) in enumerate(zones):
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            feasible = []
+            if w >= 2 * MIN_ZONE_W + 1:
+                feasible.append("v")
+            if h >= 2 * MIN_ZONE_H + 1:
+                feasible.append("h")
+            if feasible:
