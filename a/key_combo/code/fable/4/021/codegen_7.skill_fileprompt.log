+    random.shuffle(pairs)
+    for src_a, src_b in pairs:
+        r, c = positions[idx]
+        idx += 1
+        vis[src_a, r, c] = True
+        vis[src_b, r, c] = True
+
+    for r, c in positions[idx:]:
+        count = random.choices((1, 2, 3, 4), weights=(2, 4, 3, 1), k=1)[0]
+        chosen = random.sample(range(4), count)
+        vis[chosen, r, c] = True
