+    if len(np.unique(base)) < 3:
+        return None
+    non_base = int(np.count_nonzero(base != palette[0]))
+    if non_base < max(4, (h * w) // 4):
+        return None
+    if _has_forbidden_symmetry(base):
+        return None
+    return base
+
