+def _has_forbidden_symmetry(base: np.ndarray) -> bool:
+    return (
+        np.array_equal(base, np.fliplr(base))
+        or np.array_equal(base, np.flipud(base))
+        or np.array_equal(base, _rot180(base))
+    )
+
