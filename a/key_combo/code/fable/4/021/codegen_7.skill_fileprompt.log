+
+        fr = random.randint(1, canvas_h - frame_h - 1)
+        fc = random.randint(1, canvas_w - frame_w - 1)
+        placed.append((fr, fc, frame_h, frame_w))
+
+        tile_positions: list[tuple[int, int]] = []
+        ok = True
+        for _tile in range(3):
+            found = False
+            for _ in range(200):
