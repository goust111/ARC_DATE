+def _paint_shape(base: np.ndarray, color: int) -> None:
+    h, w = base.shape
+    kind = random.choice(("rect", "hline", "vline", "l"))
+    if kind == "rect":
+        rh = random.randint(1, min(3, h))
+        rw = random.randint(1, min(3, w))
