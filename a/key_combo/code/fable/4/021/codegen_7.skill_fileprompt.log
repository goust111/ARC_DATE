+    pad: int,
+) -> bool:
+    r0, c0, h, w = rect
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    for pr0, pc0, ph, pw in placed:
+        pr1 = pr0 + ph - 1
+        pc1 = pc0 + pw - 1
