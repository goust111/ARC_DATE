+def _sample_layout(h: int, w: int) -> tuple[int, int, tuple[int, int], list[tuple[int, int]]] | None:
+    frame_h = 2 * h + 2
+    frame_w = 2 * w + 2
+    min_h = max(frame_h + 2, h + 10)
+    min_w = max(frame_w + 2, w + 10)
+
+    for _ in range(200):
