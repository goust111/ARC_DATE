+    r0, c0, r1, c1 = _bbox(frame_coords)
+    border = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all(border[0, :] == FRAME)
+    assert np.all(border[-1, :] == FRAME)
