+def _can_place(
+    rect: tuple[int, int, int, int],
+    placed: list[tuple[int, int, int, int]],
+    pad: int,
+) -> bool:
+    r0, c0, h, w = rect
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    for pr0, pc0, ph, pw in placed:
+        pr1 = pr0 + ph - 1
+        pc1 = pc0 + pw - 1
+        rows_disjoint = r1 + pad < pr0 or pr1 + pad < r0
+        cols_disjoint = c1 + pad < pc0 or pc1 + pad < c0
+        if not (rows_disjoint or cols_disjoint):
+            return False
+    return True
