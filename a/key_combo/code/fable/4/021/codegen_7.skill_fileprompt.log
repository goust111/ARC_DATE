+    assert len(valid_bases) == 1, f"expected a unique tile-orientation assignment, found {len(valid_bases)}"
+    return valid_bases[0]
+
+
+def _expected_output(base: np.ndarray) -> np.ndarray:
+    return np.block(
+        [
+            [base, np.fliplr(base)],
+            [np.flipud(base), _rot180(base)],
+        ]
+    )
