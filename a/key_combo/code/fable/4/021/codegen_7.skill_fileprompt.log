+    h = target.shape[0] // 2
+    w = target.shape[1] // 2
+    seed = np.array(target[:h, :w], dtype=int, copy=True)
+    tiles = _extract_tiles(g, frame_bbox, h, w)
+    base = _reconstruct_base(seed, tiles)
+    return _expected_output(base)
