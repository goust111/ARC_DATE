+def _transform(grid: np.ndarray, kind: str) -> np.ndarray:
+    if kind == "id":
+        return np.array(grid, dtype=int, copy=True)
+    if kind == "lr":
+        return np.fliplr(grid)
+    if kind == "ud":
+        return np.flipud(grid)
+    if kind == "r2":
+        return _rot180(grid)
+    raise ValueError(f"unknown transform kind: {kind}")
