+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _extract_frame(grid: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    frame_coords = np.argwhere(grid == FRAME)
