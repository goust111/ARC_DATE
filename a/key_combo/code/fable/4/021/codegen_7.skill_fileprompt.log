+
+
+def _make_partials(base: np.ndarray, vis: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    partials = [np.where(vis[i], base, ERASED).astype(int) for i in range(4)]
+    tiles = [
