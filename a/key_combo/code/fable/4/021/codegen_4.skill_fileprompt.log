        left_row = int(left_entries[0][2][0] - r0) if left_entries else None
        right_row = int(right_entries[0][2][0] - r0) if right_entries else None
        sprites.append(
            {
                "body_color": int(body_color),
                "raw": raw,
                "filled": filled,
                "bbox": bbox,
                "left_color": left_color,
                "right_color": right_color,
                "left_row": left_row,
                "right_row": right_row,
