+WIDTH_RANGE = (3, 5)
+HEIGHT_RANGE = (2, 5)
+MAX_OUTPUT_HEIGHT = 12
+MAX_OUTPUT_WIDTH = 28
+MAX_LAYOUT_ATTEMPTS = 200
