+def _sample_layout() -> tuple[list[int], list[int], list[int | None], list[int | None], list[int]] | None:
+    for _ in range(MAX_LAYOUT_ATTEMPTS):
+        n = random.choice(SPRITE_COUNT_OPTIONS)
