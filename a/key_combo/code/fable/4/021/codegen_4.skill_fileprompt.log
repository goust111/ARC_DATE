+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+
+# Generator bounds.
+SPRITE_COUNT_OPTIONS = (3, 4, 5)
+WIDTH_RANGE = (3, 5)
+HEIGHT_RANGE = (2, 5)
+MAX_OUTPUT_HEIGHT = 12
+MAX_OUTPUT_WIDTH = 28
+MAX_LAYOUT_ATTEMPTS = 200
+MAX_MASK_ATTEMPTS = 120
+MAX_PLACE_ATTEMPTS = 250
+MAX_GENERATE_ATTEMPTS = 300
