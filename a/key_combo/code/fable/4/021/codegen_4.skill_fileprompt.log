+    sprites = _extract_sprites(g)
+    left_lookup = {}
+    heads = []
+    tails = []
+    for idx, sprite in enumerate(sprites):
+        if sprite["left_color"] is None:
+            heads.append(idx)
+        else:
+            left_lookup[int(sprite["left_color"])] = idx
+        if sprite["right_color"] is None:
+            tails.append(idx)
