+        right_active = (r, w - 1) not in source_positions and int(grid[r, w - 1]) in source_colors
+        assert not (left_active and right_active), "each row may host at most one edge deflector"
+        if left_active:
+            deflectors[r] = ("left", int(grid[r, 0]))
+        elif right_active:
