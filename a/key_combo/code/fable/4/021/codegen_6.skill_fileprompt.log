+    del width
+    return {row: ("left" if step == 1 else "right", color) for row, step in zip(rows, seq)}
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for task 6")

