+def _paint_container(out: np.ndarray, container: dict[str, int], fill_color: int) -> None:
+    r0, c0, r1, c1 = container["r0"], container["c0"], container["r1"], container["c1"]
+    out[r0, c0 : c1 + 1] = GREY
+    out[r1, c0 : c1 + 1] = GREY
+    out[r0 : r1 + 1, c0] = GREY
+    out[r0 : r1 + 1, c1] = GREY
+    out[r0 + 1 : r1, c0 + 1 : c1] = fill_color
