+def _find_containers(grid: np.ndarray) -> list[dict[str, int]]:
+    containers = []
+    for r0, c0, r1, c1 in _component_bboxes(grid == GREY):
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 3 or width < 3:
+            continue
+        border = np.zeros_like(grid, dtype=bool)
