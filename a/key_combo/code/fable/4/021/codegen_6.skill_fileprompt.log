+BLACK = 0
+GREY = 5
+SOURCE_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MAX_GEN_ATTEMPTS = 400
+HEIGHT_RANGE = (12, 21)
+TOP_ROW_RANGE = (6, 12)
+CONTAINER_HEIGHT_RANGE = (4, 7)
+CONTAINER_COUNT_RANGE = (2, 4)
+CONTAINER_WIDTH_RANGE = (3, 7)
+GAP_RANGE = (1, 3)
+MARGIN_RANGE = (1, 4)
