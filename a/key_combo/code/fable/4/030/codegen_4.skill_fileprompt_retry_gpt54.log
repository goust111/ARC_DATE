+BACKGROUND = 0
+NON_BG_COLORS = tuple(range(1, 10))
+MASK_H_RANGE = (6, 11)
+MASK_W_RANGE = (5, 10)
+SEP_W_RANGE = (1, 2)
+ROW_GAP_RANGE = (1, 3)
+EXTRA_W_RANGE = (0, 6)
+EXTRA_H_RANGE = (0, 4)
+MAX_ATTEMPTS = 300
+
+TRUTH_TABLES = (
