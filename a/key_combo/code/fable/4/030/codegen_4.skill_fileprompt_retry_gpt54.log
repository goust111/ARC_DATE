+        if col_color != bg and np.all(patch[:, c] == col_color):
+            c_end = c
+            while c_end + 1 < w and np.all(patch[:, c_end + 1] == col_color):
+                c_end += 1
+            left_w = c
+            right_w = w - c_end - 1
+            if left_w == right_w and left_w > 0:
