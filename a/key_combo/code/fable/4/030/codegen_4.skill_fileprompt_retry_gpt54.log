+
+def paste(dst: np.ndarray, src: np.ndarray, r0: int, c0: int) -> None:
+    h, w = src.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = src
+
+
+def _corner_origins(shape: tuple[int, int]) -> list[tuple[str, int, int]]:
+    h, w = shape
+    return [
+        ("tl", 0, 0),
+        ("tr", 0, w - 4),
+        ("bl", h - 4, 0),
+        ("br", h - 4, w - 4),
+    ]
