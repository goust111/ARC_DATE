        gap_lo = max(min_gap, remaining - rest_maxs)
        gap_hi = min(ANCHOR_GAP_MAX, remaining - rest_mins)
        if gap_lo > gap_hi:
            return None
        gap = int(np.random.randint(gap_lo, gap_hi + 1))
        gaps.append(gap)
        remaining -= gap

