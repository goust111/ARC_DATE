+                for nr, nc in _neighbors4(int(r), int(c))
+            )
+            has_exterior = any(
+                0 <= nr < patch.shape[0]
+                and 0 <= nc < patch.shape[1]
+                and exterior[nr, nc]
+                for nr, nc in _neighbors4(int(r), int(c))
+            )
+            if has_region and has_exterior:
