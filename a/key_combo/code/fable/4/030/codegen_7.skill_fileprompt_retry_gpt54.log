    expected = grid.copy()
    _paint_path(expected, path, colors[::-1])
    if not _passes_oracle(grid, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
