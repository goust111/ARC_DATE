GEN_PATTERN_INTERIOR_MARGIN = 2
GEN_PATTERN_MODES = ("walk", "frontier", "mixed")
GEN_MIXED_WALK_PROB = 0.6
GEN_NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

