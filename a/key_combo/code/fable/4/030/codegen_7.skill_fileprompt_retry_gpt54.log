GEN_ORIENTATION_COUNT, GEN_MAX_ATTEMPTS = 8, 300


def _gen_orient(crop: np.ndarray, idx: int) -> np.ndarray:
    return _orientations(crop)[int(idx)].copy()


def _gen_is_asymmetric(arr: np.ndarray) -> bool:
    base = arr.copy()
