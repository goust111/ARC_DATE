+        raise AssertionError("cup must have exactly one open side segment")
+
+    side = open_sides[0]
+    span = side_spans[side]
+    if span[-1] - span[0] + 1 != len(span):
+        raise AssertionError("opening must be contiguous")
+
+    if side in ("top", "bottom"):
