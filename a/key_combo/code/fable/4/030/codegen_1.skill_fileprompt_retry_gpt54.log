+
+def _border_coords(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    coords = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0, r1 + 1):
+        coords.add((r, c0))
+        coords.add((r, c1))
+    return coords
