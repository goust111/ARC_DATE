+        if r < r0 and start <= c <= end:
+            return True, r0 - r
+    elif side == "bottom":
+        if r > r1 and start <= c <= end:
+            return True, r - r1
+    elif side == "left":
+        if c < c0 and start <= r <= end:
+            return True, c0 - c
+    else:
+        if c > c1 and start <= r <= end:
