+        patch[0, offset : offset + opening_width] = BG
+    elif side == "bottom":
+        patch[-1, offset : offset + opening_width] = BG
+    elif side == "left":
+        patch[offset : offset + opening_width, 0] = BG
+    else:
+        patch[offset : offset + opening_width, -1] = BG
