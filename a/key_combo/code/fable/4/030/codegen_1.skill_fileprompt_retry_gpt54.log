+    side_spans = {
+        "top": [c for c in range(c0, c1 + 1) if (r0, c) in missing],
+        "bottom": [c for c in range(c0, c1 + 1) if (r1, c) in missing],
+        "left": [r for r in range(r0, r1 + 1) if (r, c0) in missing],
+        "right": [r for r in range(r0, r1 + 1) if (r, c1) in missing],
+    }
