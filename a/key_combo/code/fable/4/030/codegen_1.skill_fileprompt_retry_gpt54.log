+        "bbox": (r0, c0, r1, c1),
+        "side": side,
+        "opening_width": opening_width,
+        "open_range": open_range,
+    }
+
+
+def _band_membership(cup: dict, r: int, c: int) -> tuple[bool, int]:
+    r0, c0, r1, c1 = cup["bbox"]
+    start, end = cup["open_range"]
+    side = cup["side"]
