+        "bl": (r1 + 1, c0 - 1),
+        "br": (r1 + 1, c1 + 1),
+    }[corner]
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    rows, cols = _sample_layout()
+    inner = random.randint(5, 6)
+    outer = inner + 2
+    gap = 2
+    margin = 1
+    height = rows * outer + (rows - 1) * gap + 2 * margin
