+                break
+            cells.add(random.choice(tuple(frontier)))
+
+        mask = np.zeros((size, size), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        if mask[size - 1, 0] or mask[0, size - 1] or mask[size - 1, size - 1]:
