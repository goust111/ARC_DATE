+    _frame_color, frame_cells, frame_bbox = _find_frame(g, bg)
+    r0, c0, r1, c1 = frame_bbox
+    assert r1 - r0 >= 2 and c1 - c0 >= 2, "frame interior must be non-empty"
+
+    path_cells = {
+        (int(r), int(c))
+        for r, c in np.argwhere(g != bg)
+        if (int(r), int(c)) not in frame_cells
+    }
