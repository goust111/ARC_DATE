+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+DIRS4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PALETTE: tuple[int, ...] = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
