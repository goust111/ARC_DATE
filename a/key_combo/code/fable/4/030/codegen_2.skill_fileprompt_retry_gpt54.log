+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, set[Coord], BBox]:
+    frame_hits: list[tuple[int, set[Coord], BBox]] = []
+    for color in sorted(set(map(int, grid.ravel())) - {bg}):
+        for comp in _components(grid == color):
