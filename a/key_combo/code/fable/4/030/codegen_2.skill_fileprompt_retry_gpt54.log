+    ordered: list[Coord] = []
+    prev: Coord | None = None
+    cur = start
+    while True:
+        ordered.append(cur)
+        next_cells = [nb for nb in _neighbors4(*cur) if nb in path_cells and nb != prev]
+        if not next_cells:
