+    mr0, mr1, mc0, mc1 = main_rect
+    drow = int(panel_idx[0] - main_idx[0])
+    dcol = int(panel_idx[1] - main_idx[1])
+    if abs(drow) > 1 or abs(dcol) > 1 or (drow == 0 and dcol == 0):
+        return None
+
+    if drow == -1:
+        rr0, rr1 = 0, pr1 - pr0
+    elif drow == 0:
