+                continue
+            rows_here = np.flatnonzero(allowed[:, c]).astype(int).tolist()
+            if not rows_here:
+                ok = False
+                break
+            min_load = min(row_load[r] for r in rows_here)
+            options = [r for r in rows_here if row_load[r] == min_load]
+            r = random.choice(options)
+            chosen.add((r, c))
+            row_load[r] += 1
+        if not ok:
