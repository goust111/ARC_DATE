    inp = out.copy()
    inp[inp == GEN_BLUE] = GEN_BLACK
    try:
        if not np.array_equal(main(inp), out):
            return None
    except AssertionError:
        return None
    return inp


def _gen_attempt() -> np.ndarray | None:
    layout = _gen_choose_frame_layout()
    if layout is None:
        return None
    n, k, frames = layout

    g = _gen_render_frames(n, frames)
    if _gen_has_red_2x2(g):
