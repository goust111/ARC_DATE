+
+    fold_panels = []
+    for ri, ci, rect in rects:
+        coverage = _coverage_rect(rect, (ri, ci), main_rect, (main_ri, main_ci))
+        if coverage is None:
+            continue
+        fold_panels.append((int(_area(rect)), ri, ci, rect, coverage))
+    fold_panels.sort(key=lambda item: (item[0], item[1], item[2]))
