def _gen_pick_spaced_positions(lo: int, hi: int, count: int, sep: int) -> list[int] | None:
    if count <= 0:
        return []
    max_base = hi - (sep - 1) * (count - 1)
    if max_base < lo:
        return None
    bases = sorted(random.sample(range(lo, max_base + 1), count))
