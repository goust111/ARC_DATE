    small_sizes = [(random.randint(*SMALL_FRAME_SIZE_RANGE), random.randint(*SMALL_FRAME_SIZE_RANGE)) for _ in range(small_count)]
    frame_specs = [(large_h, large_w, True), *[(h, w, False) for h, w in small_sizes]]
