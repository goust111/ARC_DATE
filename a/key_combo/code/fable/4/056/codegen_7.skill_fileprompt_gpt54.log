+def _segments(length: int, blanks: list[int]) -> list[tuple[int, int]]:
+    cuts = [-1, *sorted(blanks), int(length)]
+    parts: list[tuple[int, int]] = []
+    for left, right in zip(cuts, cuts[1:]):
+        start = left + 1
+        end = right
+        if start < end:
+            parts.append((start, end))
+    return parts
+
