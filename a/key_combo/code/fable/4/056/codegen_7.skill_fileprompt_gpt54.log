+    dcol = int(panel_idx[1] - main_idx[1])
+    if abs(drow) > 1 or abs(dcol) > 1 or (drow == 0 and dcol == 0):
+        return None
+
+    if drow == -1:
+        rr0, rr1 = 0, pr1 - pr0
+    elif drow == 0:
