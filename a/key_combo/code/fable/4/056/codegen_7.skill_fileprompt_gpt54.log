+    fold_panels.sort(key=lambda item: (item[0], item[1], item[2]))
+
+    for _panel_area, ri, ci, rect, _coverage in fold_panels:
+        r0, r1, c0, c1 = rect
+        for r in range(r0, r1):
+            for c in range(c0, c1):
+                color = int(g[r, c])
+                if color == BG:
+                    continue
