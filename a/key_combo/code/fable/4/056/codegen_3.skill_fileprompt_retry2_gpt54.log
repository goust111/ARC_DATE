NEIGHBORS8 = [
    (dr, dc)
    for dr in (-1, 0, 1)
    for dc in (-1, 0, 1)
    if not (dr == 0 and dc == 0)
]


def _touches(mask: np.ndarray, coords: np.ndarray) -> bool:
    height, width = map(int, mask.shape)
    for r, c in coords:
        for dr, dc in NEIGHBORS8:
            rr, cc = int(r) + dr, int(c) + dc
            if 0 <= rr < height and 0 <= cc < width and mask[rr, cc]:
                return True
