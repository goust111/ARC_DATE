                    0 <= anchor_r
                    and 0 <= anchor_c
                    and anchor_r + height <= g.shape[0]
                    and anchor_c + width <= g.shape[1]
                ):
                    continue

                ok = True
                for rr, cc in np.argwhere(template["visible"]):
                    gr, gc = anchor_r + int(rr), anchor_c + int(cc)
