+    min_row, max_row = min(rows), max(rows)
+    color_idx = 0
+
+    for row in rows:
+        left = random.randint(0, min_col - 1)
+        right = random.randint(max_col + 1, grid.shape[1] - 1)
+        color = colors[color_idx]
