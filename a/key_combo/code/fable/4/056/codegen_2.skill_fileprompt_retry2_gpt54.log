+
+def _erase_selected_color(grid: np.ndarray, bg: int, marker: tuple[int, int], marker_color: int) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    out[out == marker_color] = bg
+    out[marker] = marker_color
