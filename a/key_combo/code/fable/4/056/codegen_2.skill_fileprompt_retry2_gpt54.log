+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int) -> bool:
+    ar0, ac0, ah, aw = a
+    br0, bc0, bh, bw = b
+    ar1, ac1 = ar0 + ah - 1, ac0 + aw - 1
+    br1, bc1 = br0 + bh - 1, bc0 + bw - 1
+    return not (ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0)
