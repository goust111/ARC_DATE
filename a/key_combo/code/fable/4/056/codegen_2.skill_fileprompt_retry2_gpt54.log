+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+PALETTE = tuple(range(3, 10))
+
+GRID_MIN = 20
+GRID_MAX = 28
+ROOM_SIZE_MIN = 5
+ROOM_SIZE_MAX = 9
+ROOM_PAD = 2
