+    bracket = brackets[0]
+    bracket_coords = set(bracket["coords"])
+    r0, c0, r1, c1 = bracket["bbox"]
+    markers = [
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if (r, c) not in bracket_coords and int(grid[r, c]) != bg
