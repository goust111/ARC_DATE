+        "shape": tuple(map(int, cropped.shape)),
+        "connector": connector,
+        "rel_cells": rel,
+        "offset": (r_off, c_off),
+    }
+
+
+def _render_piece(piece: dict, body_color: int, connector_color: int) -> np.ndarray:
+    arr = np.zeros(piece["shape"], dtype=int)
+    arr[piece["mask"]] = body_color
