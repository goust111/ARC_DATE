+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = list(range(1, 10))
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _bbox(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bbox_size(cells: set[tuple[int, int]]) -> tuple[int, int]:
+    r0, c0, r1, c1 = _bbox(cells)
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    coords = np.argwhere(mask)
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (r0, c0)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _random_connected_mask(height: int, width: int, area: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    start = (random.randrange(height), random.randrange(width))
+    mask[start] = True
+    frontier = [start]
+    while int(mask.sum()) < area:
+        r, c = random.choice(frontier)
+        neighbors = []
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
+                neighbors.append((nr, nc))
+        if not neighbors:
+            frontier.remove((r, c))
+            if not frontier:
+                break
+            continue
+        chosen = random.choice(neighbors)
+        mask[chosen] = True
+        frontier.append(chosen)
+    return mask
+
+
+def _piece_from_mask(mask: np.ndarray) -> dict:
+    cropped, (r_off, c_off) = _crop_mask(mask)
+    boundary = []
+    h, w = map(int, cropped.shape)
+    for r, c in np.argwhere(cropped):
+        rr = int(r)
+        cc = int(c)
+        if sum(
+            0 <= rr + dr < h and 0 <= cc + dc < w and bool(cropped[rr + dr, cc + dc])
+            for dr, dc in DIRS4
+        ) == 0:
+            continue
+        if any(
+            not (0 <= rr + dr < h and 0 <= cc + dc < w) or not bool(cropped[rr + dr, cc + dc])
+            for dr, dc in DIRS4
+        ):
+            boundary.append((rr, cc))
+    connector = random.choice(boundary)
+    rel = {(int(r - connector[0]), int(c - connector[1])) for r, c in np.argwhere(cropped)}
+    return {
+        "mask": cropped,
+        "shape": tuple(map(int, cropped.shape)),
+        "connector": connector,
+        "rel_cells": rel,
+        "offset": (r_off, c_off),
+    }
+
