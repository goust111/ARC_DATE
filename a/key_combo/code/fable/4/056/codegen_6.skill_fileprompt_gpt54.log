+
+
+def _draw_rectangle(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int, kind: str) -> None:
+    r0, c0, r1, c1 = bbox
+    assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == BACKGROUND)
