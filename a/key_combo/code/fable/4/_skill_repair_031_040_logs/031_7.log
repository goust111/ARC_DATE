        r, c = random.randint(0, n - 1), random.randint(0, m - 1)
        grid = np.full((n, m), bg)
        diagonal_orientation = True
    elif symmetry_type == "radial":
        if n != m:
            raise ValueError("Radial symmetry requires a square grid.")
