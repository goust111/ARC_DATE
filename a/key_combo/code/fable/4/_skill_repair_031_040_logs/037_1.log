from importlib.machinery import SourceFileLoader
import random
import numpy as np
p='key_combo/code/fable/4/037/1.py'
m=SourceFileLoader('dbg',p).load_module()
m._validate_layout=lambda *args: None
for seed in range(1000):
    random.seed(seed)
    g=m.generate_input()
    try:
        parsed=m._parse(g)
    except AssertionError as e:
        print('seed',seed,'shape',g.shape,'error',e)
        bg=m._background(g)
        for color in np.unique(g):
            color=int(color)
            if color==bg: continue
            comps=m._components(g==color)
