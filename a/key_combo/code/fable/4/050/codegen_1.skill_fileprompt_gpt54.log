            return None
        r, c = turn_row, next_c

    for rr in range(r + 1, rect_top):
        if not add_path((rr, target_c)):
            return None

    return path_cells, blocker_cells, (rect_top, target_c)


def _safe_extra_blockers(
    grid: np.ndarray,
    blocker_color: int,
    forbidden: set[tuple[int, int]],
) -> None:
    h, w = grid.shape
    candidates = []
