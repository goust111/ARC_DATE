+            continue
+        rect_candidates.append((sum(len(comp) for comp in comps), color, comps))
+
+    assert len(rect_candidates) == 1, "expected one rectangle color"
+    rect_color = rect_candidates[0][1]
+    rect_components = rect_candidates[0][2]
+
