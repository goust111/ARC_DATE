+        if (nr, nc) in rect_lookup:
+            return rect_lookup[(nr, nc)]
+
+        if int(grid[nr, nc]) != blocker_color:
+            r, c = nr, nc
+            continue
+
+        choices: list[tuple[int, int]] = []
+        for tdr, tdc in ((-dc, dr), (dc, -dr)):
+            tr, tc = r + tdr, c + tdc
