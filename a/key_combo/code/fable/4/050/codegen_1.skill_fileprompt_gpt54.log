    paste(inp, patch, r, c, transparent=_GEN_BG)
    return (int(r), int(c), int(r + patch.shape[0] - 1), int(c + patch.shape[1] - 1))


def _gen_scatter(coords_list: list[np.ndarray], colors: list[int]) -> np.ndarray | None:
