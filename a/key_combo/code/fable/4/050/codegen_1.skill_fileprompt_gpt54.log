+
+_ZONE_W = 6
+_MIN_GAP = 2
+_MIN_H = 16
+_MAX_H = 26
+_MAX_ATTEMPTS = 400
+_PALETTE = list(range(10))
+
+
+def _sample_layout(n_rects: int) -> tuple[int, list[tuple[int, int]]]:
+    base_width = 2 + n_rects * _ZONE_W + (n_rects - 1) * _MIN_GAP
+    assert base_width <= 30
