+    rect_color = rect_candidates[0][1]
+    rect_components = rect_candidates[0][2]
+
+    start_cells = [
+        (0, c, int(g[0, c]))
+        for c in range(g.shape[1])
+        if int(g[0, c]) != bg and int(g[0, c]) != rect_color
+    ]
