+    waypoint_cols: list[int],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]], tuple[int, int]] | None:
+    path_cells: set[tuple[int, int]] = set()
+    blocker_cells: set[tuple[int, int]] = set()
+    r, c = 0, start_c
