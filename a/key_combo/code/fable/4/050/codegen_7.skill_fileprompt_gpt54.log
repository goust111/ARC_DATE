+from collections import Counter
+import random
+
+import numpy as np
+
+
+WALL_COLOR = 5
+MAX_ATTEMPTS = 400
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _find_separator_col(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == WALL_COLOR)]
+    assert len(cols) == 1, f"expected one full grey separator column, got {cols}"
+    return int(cols[0])
+
+
+def _infer_background(grid: np.ndarray, sep: int) -> int:
