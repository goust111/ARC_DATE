+    input_grid = np.full((grid_h, width), int(bg), dtype=int)
+    output_grid = np.full((grid_h, width), int(bg), dtype=int)
+    input_grid[:, sep] = WALL_COLOR
+    output_grid[:, sep] = WALL_COLOR
