+def _find_separator_col(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == WALL_COLOR)]
+    assert len(cols) == 1, f"expected one full grey separator column, got {cols}"
+    return int(cols[0])
