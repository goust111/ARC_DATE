+
+def _infer_background(grid: np.ndarray, sep: int) -> int:
+    values = [int(v) for v in grid[:, np.arange(grid.shape[1]) != sep].ravel()]
+    counts = Counter(values)
+    counts.pop(WALL_COLOR, None)
