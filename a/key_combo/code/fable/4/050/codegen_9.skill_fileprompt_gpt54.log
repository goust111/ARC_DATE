+    occupied = np.zeros((h, w), dtype=bool)
+    keys: list[dict] = []
+    for top in range(h - 2):
+        for left in range(w - 2):
+            if occupied[top : top + 3, left : left + 3].any():
+                continue
+            key = _classify_key_window(grid, bg, top, left)
+            if key is None:
