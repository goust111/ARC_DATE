+    random.shuffle(candidates)
+    if not candidates:
+        return None
+    top, left = candidates[0]
+    _paste_patch(grid, patch, top, left)
+    _mark_reserved(reserved, top, left, 3, 3, pad=1)
+    return top, left
+
