+        cc = left + dc
+        for nr, nc in _neighbors4(rr, cc):
+            inside = top <= nr < top + 3 and left <= nc < left + 3
+            if not inside and _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == frame_color:
+                return False
