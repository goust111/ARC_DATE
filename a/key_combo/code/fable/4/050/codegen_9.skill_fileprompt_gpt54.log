+        return None
+    keys.append(
+        {
+            "top": pseudo_pos[0],
+            "left": pseudo_pos[1],
+            "frame": pseudo_frame,
+            "center": pseudo_center,
+            "kind": "pseudo",
+            "valid": False,
+        }
