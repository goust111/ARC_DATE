   228	    stopped = []
   229	    for obj in objects:
   230	        r0, c0, collided = _stopping_position(obj, stopped, g.shape)
   231	        patch = _rotate_payload(obj["patch"], obj["side"]) if collided else obj["patch"]
   232	        _paste_checked(out, patch, r0, c0, bg)
   233	        h, w = patch.shape
   234	        stopped.append({"bbox": (r0, c0, r0 + h - 1, c0 + w - 1)})
   235	
   236	    return out
