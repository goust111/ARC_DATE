   201	def main(grid: np.ndarray) -> np.ndarray:
   202	    """
   203	    Slide each tailed payload away from its tail, stacking nearer ones first and flipping only collision-stopped payloads.
   204	
   205	    Input structure:
   206	    - The background contains several 8-connected composite objects.
   207	    - Each object is a sparse monochrome 3x3 tail attached to one side of a fully filled 3x3 payload block.
   208	    - Every composite bbox is either 3x6 or 6x3, so the tail uniquely indicates one of the four travel directions.
   209	
   210	    Rule:
   211	    - For each object, move it straight away from its tail.
   212	    - Resolve objects from smallest initial distance to the target edge to largest, and let each one slide until its bbox touches the grid edge or an already stopped object.
   213	    - Objects that stop on the wall keep their payload unchanged; objects that stop by collision rotate only the 3x3 payload 180 degrees while keeping the tail fixed in place.
   214	
   215	    Key insight:
   216	    - The rotation records a collision event rather than a property of the object, so the correct output requires an ordered stacking simulation.
   217	    """
   218	    g = np.asarray(grid, dtype=int)
   219	    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
   220	    bg = get_bg(g)
   221	
   222	    objects = [_parse_object(comp, bg, g.shape) for comp in _find_components(g, bg)]
