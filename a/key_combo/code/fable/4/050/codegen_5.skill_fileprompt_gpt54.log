+
+
+def _orbit4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    cells = {(int(r), int(c)), (int(r), int(w - 1 - c)), (int(h - 1 - r), int(c)), (int(h - 1 - r), int(w - 1 - c))}
