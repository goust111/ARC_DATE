+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
+
+
+def _trim_bool(mask: np.ndarray) -> np.ndarray:
+    box = bbox(mask)
+    assert box is not None, "mask must be non-empty"
+    return crop_bbox(mask.astype(bool), box)
