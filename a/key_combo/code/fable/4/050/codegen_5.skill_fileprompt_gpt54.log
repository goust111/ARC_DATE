+
+    for patch, color in order:
+        h, w = patch.shape
+        positions = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1) if _can_place(occupied, h, w, r, c, padding)]
+        if not positions:
+            return None
+        r0, c0 = random.choice(positions)
+        colored = _render_mask(patch, color)
