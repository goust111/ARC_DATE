+        perfect = _strict_symmetric_mask()
+        vertical_decoy = _build_single_axis_decoy("vertical")
+        horizontal_decoy = _build_single_axis_decoy("horizontal")
+
+        masks = [target_inp, perfect, vertical_decoy, horizontal_decoy]
