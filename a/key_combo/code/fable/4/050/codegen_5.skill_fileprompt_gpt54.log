+            need_vertical, need_horizontal = True, False
+        else:
+            missing_options = [(r, 0) for r in range(h // 2) if base[r, 0]]
+            stray_options = [(0, w - 2), (1, w - 2), (0, 1), (0, w // 2 - 1)]
