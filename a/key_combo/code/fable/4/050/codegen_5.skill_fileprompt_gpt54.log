+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
+                return True
+    return False
+
+
+def _build_double_base() -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    h = random.choice([5, 7, 9])
+    w = random.choice([5, 7, 9])
+    cr, cc = h // 2, w // 2
