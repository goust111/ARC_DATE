+
+        max_h = max(mask.shape[0] for mask in masks)
+        max_w = max(mask.shape[1] for mask in masks)
+        H = random.randint(max(20, max_h + 6), 30)
+        W = random.randint(max(20, max_w + 6), 30)
+        grid = _place_patches(zipped, H, W, padding=2)
