+    for i in range(1, len(full_path)):
+        dr = abs(full_path[i][0] - full_path[i - 1][0])
+        dc = abs(full_path[i][1] - full_path[i - 1][1])
+        if dr + dc != 1:
+            return False
+
+    for i in range(1, len(full_path) - 1):
