+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    counts = Counter(int(v) for v in np.asarray(grid, dtype=int).ravel())
+    return int(counts.most_common(1)[0][0])
+
+
