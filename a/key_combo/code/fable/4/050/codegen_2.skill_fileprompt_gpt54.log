+    for r, c in distractor_candidates[:distractor_count]:
+        input_grid[r, c] = blocker_color
+        output_grid[r, c] = blocker_color
+
+    try:
+        solved = main(input_grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, output_grid):
+        return None
+    return input_grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
