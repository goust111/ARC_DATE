0020: def main(grid: np.ndarray) -> np.ndarray:
0021:     """
0022:     Extract the unique foreground color mask whose cropped shape is symmetric across a vertical axis.
0023: 
0024:     Input structure:
0025:     - The grid has a dominant background and several colored masks.
0026:     - Each non-background color forms one candidate mask, possibly split into multiple 4-connected objects.
0027:     - Exactly one candidate's bounding-box crop is invariant under left-right reflection.
0028: 
0029:     Rule:
0030:     - For each non-background color, crop all pixels of that color to their bounding box.
0031:     - Select the unique crop that equals its left-right mirror image.
0032:     - Return that crop, with non-selected cells in the crop set to the background color.
0033: 
0034:     Key insight:
0035:     - The target is not identified by its color or size; it is the only color mask with vertical mirror symmetry.
0036:     """
0037:     g = np.asarray(grid, dtype=int)
0038:     assert g.ndim == 2, "expected a 2D grid"
0039: 
0040:     bg = get_bg(g)
0041:     symmetric_crops: list[np.ndarray] = []
0042:     for color in colors_present(g, exclude={bg}):
0043:         crop = _cropped_color_mask(g, color, bg)
0044:         if np.array_equal(crop, np.fliplr(crop)):
0045:             symmetric_crops.append(crop)
0046: 
0047:     assert len(symmetric_crops) == 1, "expected exactly one vertically symmetric color mask"
0048:     return symmetric_crops[0]
0049: 
