0248: def _gen_partition(sizes: tuple[int, ...]) -> list[set[tuple[int, int]]] | None:
0249:     def rec(cells: set[tuple[int, int]], rest: tuple[int, ...]):
0250:         if not rest:
0251:             return [] if not cells else None
0252:         if len(rest) == 1:
0253:             return [set(cells)] if len(cells) == rest[0] and _gen_is_connected(cells) else None
0254: 
0255:         size = rest[0]
0256:         for subset in _gen_connected_subsets(cells, size):
0257:             remaining = cells - subset
0258:             if not _gen_component_sizes_fit(remaining, rest[1:]):
0259:                 continue
0260:             tail = rec(remaining, rest[1:])
0261:             if tail is not None:
0262:                 return [subset] + tail
0263:         return None
0264: 
0265:     return rec(set(_GEN_CELLS), sizes)
