+    occupied[r0 + coords[:, 0], c0 + coords[:, 1]] = True
+
+
+def random_position(occupied: np.ndarray, reserve_mask: np.ndarray, padding: int) -> tuple[int, int] | None:
+    H, W = occupied.shape
