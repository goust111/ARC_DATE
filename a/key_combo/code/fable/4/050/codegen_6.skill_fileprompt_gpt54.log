0038: def main(grid: np.ndarray) -> np.ndarray:
0039:     """
0040:     Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.
0041: 
0042:     Input structure:
0043:     - A vertical grey (5) separator column divides the grid into left and right halves.
0044:     - Black shapes sit on the left side against a background color (bg).
0045: 
0046:     Rule:
0047:     - Translate each black connected component rightward until its right edge is flush with the separator.
0048:     - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.
0049:     - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.
0050: 
0051:     Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as "nozzles" projecting rightward.
0052:     """
0053:     g = np.asarray(grid, dtype=int)
0054:     h, w = g.shape
0055:     sep_color = 5
0056:     black = 0
0057:     red = 2
0058: 
0059:     sep = _find_separator_col(g, sep_color=sep_color)
0060:     bg = _background_color(g, sep_col=sep, sep_color=sep_color)
0061: 
0062:     out = g.copy()
0063: 
0064:     # Step 1: move black components on the left so that their right edge touches the separator.
0065:     left = out[:, :sep].copy()
0066:     left_mask = left == black
0067:     comps = _components4(left_mask)
0068: 
0069:     # Clear old black pixels (leave other colors intact).
0070:     left[left == black] = bg
0071: 
0072:     target_right = sep - 1  # last column in left side, adjacent to separator
0073:     for comp in comps:
0074:         max_c = max(c for _, c in comp)
0075:         delta = target_right - max_c
0076:         assert delta >= 0, "left-side components must stay left of the separator"
0077:         for r, c in comp:
0078:             nc = c + delta
0079:             assert 0 <= nc < sep, f"shifted pixel {(r, c)} left the pane"
0080:             left[r, nc] = black
0081: 
0082:     out[:, :sep] = left
0083: 
0084:     # Step 2: find enclosed background regions (holes) on the left.
0085:     # A hole is a bg component not touching the left subgrid boundary.
0086:     holes = []
0087:     for pts in _components4(left == bg):
0088:         if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):
0089:             continue
0090:         holes.append(pts)
0091: 
0092:     # Step 3: if a hole touches column sep-2 (one cell left of the black border that touches separator),
0093:     # emit a red ray on the right side for each row containing hole pixels.
0094:     trigger_col = sep - 2
0095:     trigger_rows = []
0096:     for pts in holes:
0097:         if not any(c == trigger_col for _, c in pts):
0098:             continue
0099:         trigger_rows.extend(sorted(set(r for r, _ in pts)))
0100:     assert len(trigger_rows) == len(set(trigger_rows)), f"trigger rows must be unique, got {trigger_rows}"
0101:     for r in trigger_rows:
0102:         assert np.all(out[r, sep + 1 :] == bg), f"right half of row {r} must be background before ray emission"
0103:         out[r, sep + 1 :] = red
0104: 
0105:     return out
