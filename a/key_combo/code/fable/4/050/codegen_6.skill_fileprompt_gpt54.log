+        h = random.randint(*GEN_MASTER_HW)
+        w = random.randint(*GEN_MASTER_HW)
+        max_area = min(GEN_MASTER_AREA[1], h * w - 1)
+        min_area = min(GEN_MASTER_AREA[0], max_area)
