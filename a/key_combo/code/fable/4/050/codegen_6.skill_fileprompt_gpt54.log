0154: def _sprite_bands(h, is_emitter):
0155:     """Partition grid rows into disjoint vertical bands for each sprite.
0156: 
0157:     Returns list of (row_start, height) or None if they don't fit.
0158:     """
0159:     n = len(is_emitter)
0160:     min_heights = [3 if e else 2 for e in is_emitter]
0161:     base_gaps = [MIN_BAND_GAP] * (n + 1)
0162:     height_cap = h - sum(base_gaps)
0163:     if sum(min_heights) > height_cap:
0164:         return None
0165: 
0166:     heights = min_heights[:]
0167:     extra_cap = sum(SPRITE_H_MAX - x for x in heights)
0168:     extra = random.randint(0, min(extra_cap, height_cap - sum(heights)))
0169:     for _ in range(extra):
0170:         choices = [i for i, x in enumerate(heights) if x < SPRITE_H_MAX]
0171:         i = random.choice(choices)
0172:         heights[i] += 1
0173: 
0174:     gaps = [a + b for a, b in zip(base_gaps, _scatter(h - sum(heights) - sum(base_gaps), n + 1))]
0175:     bands = []
0176:     r = gaps[0]
0177:     for i, sh in enumerate(heights):
0178:         bands.append((r, sh))
0179:         r += sh + gaps[i + 1]
0180:     return bands
