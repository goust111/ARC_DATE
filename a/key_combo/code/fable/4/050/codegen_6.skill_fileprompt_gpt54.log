0199: def _gen_components(cells) -> list[set[tuple[int, int]]]:
0200:     remaining = set(cells)
0201:     comps = []
0202:     while remaining:
0203:         start = remaining.pop()
0204:         comp = {start}
0205:         stack = [start]
0206:         while stack:
0207:             cell = stack.pop()
0208:             for nb in _gen_neighbors(cell):
0209:                 if nb in remaining:
0210:                     remaining.remove(nb)
0211:                     comp.add(nb)
0212:                     stack.append(nb)
0213:         comps.append(comp)
0214:     return comps
