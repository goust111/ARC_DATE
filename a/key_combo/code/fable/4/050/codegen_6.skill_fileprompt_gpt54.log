+    out: dict[tuple[tuple[int, int], ...], np.ndarray] = {}
+    for orient in orientations:
+        full = np.argwhere(orient)
+        for pr, pc in partial_set:
+            for fr, fc in full:
+                dr, dc = int(pr - fr), int(pc - fc)
+                placed = full + np.array([dr, dc], dtype=int)
