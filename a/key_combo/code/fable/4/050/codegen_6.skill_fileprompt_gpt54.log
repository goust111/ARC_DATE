0149: def _min_rows_needed(n_emitters, n_total):
0150:     """Minimum grid rows to fit *n_total* sprites with *n_emitters* emitters."""
0151:     return n_emitters * 3 + (n_total - n_emitters) * 2 + (n_total - 1) + 2
