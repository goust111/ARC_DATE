0184: def _gen_is_connected(cells) -> bool:
0185:     cells = set(cells)
0186:     if not cells:
0187:         return False
0188:     seen = {next(iter(cells))}
0189:     stack = list(seen)
0190:     while stack:
0191:         cell = stack.pop()
0192:         for nb in _gen_neighbors(cell):
0193:             if nb in cells and nb not in seen:
0194:                 seen.add(nb)
0195:                 stack.append(nb)
0196:     return len(seen) == len(cells)
