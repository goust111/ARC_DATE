0217: def _gen_component_sizes_fit(cells, sizes: tuple[int, ...]) -> bool:
0218:     caps = tuple(sorted((len(comp) for comp in _gen_components(cells)), reverse=True))
0219:     sizes = tuple(sorted(sizes, reverse=True))
0220: 
0221:     def pack(i: int, capacities: tuple[int, ...]) -> bool:
0222:         if i == len(sizes):
0223:             return all(cap == 0 for cap in capacities)
0224:         size = sizes[i]
0225:         tried = set()
0226:         for j, cap in enumerate(capacities):
0227:             if cap < size or cap in tried:
0228:                 continue
0229:             tried.add(cap)
0230:             nxt = list(capacities)
0231:             nxt[j] -= size
0232:             if pack(i + 1, tuple(sorted(nxt, reverse=True))):
0233:                 return True
0234:         return False
0235: 
0236:     return pack(0, caps)
