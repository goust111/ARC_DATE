+def gen_partial_mask(full_mask: np.ndarray, orientations: list[np.ndarray]) -> np.ndarray | None:
+    full_coords = np.argwhere(full_mask)
+    area = len(full_coords)
+    keep_min = max(3, area // 3)
+    if keep_min >= area:
+        keep_min = area - 1
+    if keep_min < 2:
+        return None
+    for _ in range(GEN_PARTIAL_ATTEMPTS):
