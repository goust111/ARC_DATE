0013: def main(input_grid):
0014:     """
0015:     Recolor unboxed shape copies to match the same-shaped object enclosed by a gray box.
0016: 
0017:     Input structure:
0018:     - The input is a black grid with gray outline boxes and colored sprites.
0019:     - Some colored sprites are contained inside gray boxes.
0020:     - Other sprites outside the boxes may share the same shape in different colors.
0021: 
0022:     Rule:
0023:     - Separate gray box objects from non-gray sprite objects.
0024:     - Identify sprites contained inside gray interiors.
0025:     - Recolor outside sprites with matching shape masks to the contained sprite's color.
0026: 
0027:     Key insight:
0028:     - Gray boxes mark reference examples whose colors transfer to same-shaped free copies.
0029:     """
0030:     # Plan:
0031:     # 1. Extract the objects and separate them according to if they are grey or not
0032:     # 2. Determine if each non-grey shape is contained by a grey shape
0033:     # 3. Check to see which objects (among grey contained shapes) have another object which has the same shape (not contained by grey)
0034:     # 4. Do the color change when you find these matching objects
0035: 
0036:     # 1. Extract the objects, separating them by if they are grey or not
0037:     bg = Color.BLACK
0038:     objects = find_components(input_grid, bg=bg, connectivity=8, monochromatic=True, return_format="objects")
0039:     grey_objects = [obj for obj in objects if Color.GREY in colors_present(obj, exclude={bg})]
0040:     non_grey_objects = [obj for obj in objects if Color.GREY not in colors_present(obj, exclude={bg})]
0041: 
0042:     # 2. Determine if each non-grey shape is contained by a grey shape
0043:     # Divide the non-grey objects into two groups: those contained by grey, and those not contained by grey
0044:     # Make a helper function for checking of one object is contained by another
0045:     def object_contains_another_object(inside_object, outside_object):
0046:         # Using bounding boxes:
0047:         # inside_x, inside_y, inside_width, inside_height = bounding_box(inside_object)
0048:         # outside_x, outside_y, outside_width, outside_height = bounding_box(outside_object)
0049:         # return inside_x >= outside_x and inside_y >= outside_y and inside_x + inside_width <= outside_x + outside_width and inside_y + inside_height <= outside_y + outside_height
0050:         # Using topology+masks:
0051:         inside_object_mask = inside_object != bg
0052:         outside_interior_mask = object_interior(outside_object, background=bg)
0053:         return np.all(outside_interior_mask >= inside_object_mask)
0054:     objects_contained_by_grey = [ non_grey for non_grey in non_grey_objects
0055:                                   if any( object_contains_another_object(non_grey, grey) for grey in grey_objects ) ]
0056:     objects_not_contained_by_gray = [ non_grey for non_grey in non_grey_objects
0057:                                      if not any( object_contains_another_object(non_grey, grey) for grey in grey_objects ) ]
0058:     
0059:     # 3. Check to see which objects (among grey contained shapes) have another object which has the same shape (not contained by grey)
0060:     output_grid = input_grid.copy()
0061: 
0062:     # Helper function to check if two objects have the same shape
0063:     def objects_have_same_shape(obj1, obj2):
0064:         b1 = bbox(obj1 != bg)
0065:         b2 = bbox(obj2 != bg)
0066:         if b1 is None or b2 is None:
0067:             return False
0068:         mask1 = crop_bbox(obj1, b1) != bg
0069:         mask2 = crop_bbox(obj2, b2) != bg
0070:         return np.array_equal(mask1, mask2)
0071:     
0072:     for grey_contained in objects_contained_by_grey:
0073:         for non_grey in objects_not_contained_by_gray:
0074:             if objects_have_same_shape(grey_contained, non_grey):
0075:                 # 4. Do the color change
0076:                 target_color = colors_present(grey_contained, exclude={bg})[0]
0077:                 non_grey_mask = non_grey != bg
0078:                 output_grid[non_grey_mask] = target_color
0079: 
0080:     return output_grid
