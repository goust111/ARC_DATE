0029: def main(grid: np.ndarray) -> np.ndarray:
0030:     """
0031:     Summarize the colored 2x2 markers inside a filled panel as a 2x2 position map.
0032: 
0033:     Input structure
0034:     - The boundary has one empty background color.
0035:     - The non-background pixels form one solid rectangular panel, whose dominant
0036:       non-background color is the panel fill.
0037:     - Every other color appears as one solid 2x2 marker inside the panel.
0038: 
0039:     Rule
0040:     - Output a 2x2 grid initialized to the background color.
0041:     - Split the panel bbox into top/bottom and left/right halves.
0042:     - Put each marker color into the output cell matching the half that contains
0043:       that marker's center.
0044: 
0045:     Key insight
0046:     - The large panel is an enlarged 2x2 canvas; the small colored squares mark
0047:       which coarse cells should be non-background.
0048:     """
0049:     g = np.asarray(grid, dtype=int)
0050:     assert g.ndim == 2, "expected a 2D grid"
0051: 
0052:     bg = _boundary_background(g)
0053:     panel_box = bbox(g != bg)
0054:     assert panel_box is not None, "expected a non-background panel"
0055:     r0, c0, r1, c1 = panel_box
0056:     assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] != bg), "panel bbox must be filled"
0057: 
0058:     color_counts = {color: int((g == color).sum()) for color in colors_present(g, exclude={bg})}
0059:     panel_color = _unique_max_color(color_counts, "expected a unique largest panel color")
0060: 
0061:     out = np.full((2, 2), bg, dtype=int)
0062:     marker_colors = [color for color in color_counts if color != panel_color]
0063:     assert marker_colors, "expected at least one 2x2 marker"
0064: 
