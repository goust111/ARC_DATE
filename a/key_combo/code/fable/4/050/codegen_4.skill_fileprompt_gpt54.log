13: def main(input_grid):
14:     """
15:     Recolor unboxed shape copies to match the same-shaped object enclosed by a gray box.
16: 
17:     Input structure:
18:     - The input is a black grid with gray outline boxes and colored sprites.
19:     - Some colored sprites are contained inside gray boxes.
20:     - Other sprites outside the boxes may share the same shape in different colors.
21: 
22:     Rule:
23:     - Separate gray box objects from non-gray sprite objects.
24:     - Identify sprites contained inside gray interiors.
25:     - Recolor outside sprites with matching shape masks to the contained sprite's color.
26: 
27:     Key insight:
28:     - Gray boxes mark reference examples whose colors transfer to same-shaped free copies.
29:     """
30:     # Plan:
31:     # 1. Extract the objects and separate them according to if they are grey or not
32:     # 2. Determine if each non-grey shape is contained by a grey shape
33:     # 3. Check to see which objects (among grey contained shapes) have another object which has the same shape (not contained by grey)
34:     # 4. Do the color change when you find these matching objects
35: 
36:     # 1. Extract the objects, separating them by if they are grey or not
37:     bg = Color.BLACK
38:     objects = find_components(input_grid, bg=bg, connectivity=8, monochromatic=True, return_format="objects")
39:     grey_objects = [obj for obj in objects if Color.GREY in colors_present(obj, exclude={bg})]
40:     non_grey_objects = [obj for obj in objects if Color.GREY not in colors_present(obj, exclude={bg})]
41: 
42:     # 2. Determine if each non-grey shape is contained by a grey shape
43:     # Divide the non-grey objects into two groups: those contained by grey, and those not contained by grey
44:     # Make a helper function for checking of one object is contained by another
45:     def object_contains_another_object(inside_object, outside_object):
46:         # Using bounding boxes:
47:         # inside_x, inside_y, inside_width, inside_height = bounding_box(inside_object)
48:         # outside_x, outside_y, outside_width, outside_height = bounding_box(outside_object)
49:         # return inside_x >= outside_x and inside_y >= outside_y and inside_x + inside_width <= outside_x + outside_width and inside_y + inside_height <= outside_y + outside_height
50:         # Using topology+masks:
51:         inside_object_mask = inside_object != bg
52:         outside_interior_mask = object_interior(outside_object, background=bg)
53:         return np.all(outside_interior_mask >= inside_object_mask)
54:     objects_contained_by_grey = [ non_grey for non_grey in non_grey_objects
55:                                   if any( object_contains_another_object(non_grey, grey) for grey in grey_objects ) ]
56:     objects_not_contained_by_gray = [ non_grey for non_grey in non_grey_objects
57:                                      if not any( object_contains_another_object(non_grey, grey) for grey in grey_objects ) ]
58:     
59:     # 3. Check to see which objects (among grey contained shapes) have another object which has the same shape (not contained by grey)
60:     output_grid = input_grid.copy()
61: 
62:     # Helper function to check if two objects have the same shape
63:     def objects_have_same_shape(obj1, obj2):
64:         b1 = bbox(obj1 != bg)
65:         b2 = bbox(obj2 != bg)
66:         if b1 is None or b2 is None:
67:             return False
68:         mask1 = crop_bbox(obj1, b1) != bg
69:         mask2 = crop_bbox(obj2, b2) != bg
70:         return np.array_equal(mask1, mask2)
71:     
72:     for grey_contained in objects_contained_by_grey:
73:         for non_grey in objects_not_contained_by_gray:
74:             if objects_have_same_shape(grey_contained, non_grey):
75:                 # 4. Do the color change
76:                 target_color = colors_present(grey_contained, exclude={bg})[0]
77:                 non_grey_mask = non_grey != bg
78:                 output_grid[non_grey_mask] = target_color
79: 
80:     return output_grid
