+    return scored[0][0]
+
+
+def _component_center(coords: np.ndarray) -> tuple[float, float]:
+    bbox = bbox_coords(coords)
+    r0, c0, r1, c1 = bbox
+    return (r0 + r1) / 2.0, (c0 + c1) / 2.0
+
+
+def _detect_panel_and_sprite(grid: np.ndarray, bg: int) -> tuple[np.ndarray, np.ndarray]:
