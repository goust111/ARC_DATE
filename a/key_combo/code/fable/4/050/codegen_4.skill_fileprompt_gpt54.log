+    raise ValueError(f"unknown quadrant: {quadrant}")
+
+
+def _closest_corner(center_r: float, center_c: float, bounds: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bounds
+    options = {
+        "TL": (r0, c0),
