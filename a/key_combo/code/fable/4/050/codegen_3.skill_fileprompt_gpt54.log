+        lambda r, c: (r, c),
+        lambda r, c: (r, -c),
+        lambda r, c: (-r, c),
+        lambda r, c: (-r, -c),
+        lambda r, c: (c, r),
+        lambda r, c: (c, -r),
+        lambda r, c: (-c, r),
+        lambda r, c: (-c, -r),
