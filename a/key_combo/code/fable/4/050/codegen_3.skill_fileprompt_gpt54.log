GEN_FRAME_CELLS = 9
GEN_CENTER_EXTRA = (7, 13)
GEN_RING_EXTRA_MAX = 12

# Density/background guardrails.
GEN_DENSITY_CAP, GEN_BG_RING_MARGIN = 0.36, 18

