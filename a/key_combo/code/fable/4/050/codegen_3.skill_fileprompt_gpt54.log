    panel_w = random.randint(*PANEL_W_RANGE)
    row_margins = _gen_margin_pair(panel_h, *GRID_H_RANGE)
    col_margins = _gen_margin_pair(panel_w, *GRID_W_RANGE)
    if row_margins is None or col_margins is None:
