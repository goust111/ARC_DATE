+def _extract_pieces(grid: np.ndarray, frame_coords: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int).copy()
+    g[frame_coords[:, 0], frame_coords[:, 1]] = int(bg)
