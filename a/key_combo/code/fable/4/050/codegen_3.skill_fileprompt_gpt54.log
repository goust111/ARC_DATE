+def _tile_with_leftover(pieces: list[dict], hole_set: set[Coord], patch_shape: tuple[int, int], leftover_idx: int) -> list[dict[int, tuple[Coord, ...]]]:
+    active = [idx for idx in range(len(pieces)) if idx != leftover_idx]
