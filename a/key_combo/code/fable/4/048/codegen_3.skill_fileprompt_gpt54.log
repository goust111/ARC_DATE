+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+MARKER_COLORS = {BLUE, RED, GREEN, YELLOW}
+CORNER_ORDER = ("nw", "ne", "se", "sw")
+BASE_CW = [BLUE, RED, YELLOW, GREEN]
+BASE_CCW = [BLUE, GREEN, YELLOW, RED]
+GEN_RETRIES = 400
