+        return False
+    for r, c in random.sample(choices, k=count):
+        grid[r, c] = random.choice(tuple(MARKER_COLORS))
+        blocked[r, c] = True
+    return True
+
+
+def _expected_from_targets(grid: np.ndarray, targets: list[dict]) -> np.ndarray:
+    out = grid.copy()
