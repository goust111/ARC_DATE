+    turns_ccw %= 4
+    if turns_ccw == 0:
+        return cells.copy()
+
+    r0, c0, r1, c1 = _bbox_coords(cells)
+    rsum = r0 + r1
+    csum = c0 + c1
+    out: list[tuple[int, int]] = []
+    for r, c in cells:
+        dr2 = 2 * int(r) - rsum
+        dc2 = 2 * int(c) - csum
+        for _ in range(turns_ccw):
+            dr2, dc2 = -dc2, dr2
