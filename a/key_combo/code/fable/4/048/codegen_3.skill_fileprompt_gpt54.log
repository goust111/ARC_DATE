+        mask = np.fliplr(mask)
+    mask = np.rot90(mask, k=random.randrange(4))
+    return mask.astype(bool)
+
+
+def _reserve(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    h, w = blocked.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h - 1, r1 + pad)
+    cc1 = min(w - 1, c1 + pad)
