    ]
    n_pieces = np.random.randint(2, 5)
    min_side = 10 if n_pieces <= 2 else (12 if n_pieces == 3 else 14)
    canvas_h, canvas_w = np.random.randint(min_side, 20), np.random.randint(min_side, 20)
