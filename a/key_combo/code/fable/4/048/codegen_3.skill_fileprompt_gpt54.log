+def _chirality_from_corners(corner_colors: list[int]) -> str | None:
+    for shift in range(4):
+        if corner_colors == _rotate_colors_right(BASE_CW, shift):
+            return "cw"
+        if corner_colors == _rotate_colors_right(BASE_CCW, shift):
+            return "ccw"
+    return None
