+
+
+def _corner_sequence(chirality: str, phase: int) -> list[int]:
+    base = BASE_CW if chirality == "cw" else BASE_CCW
+    return _rotate_colors_right(base, phase)
+
+
+def _build_target(
+    grid: np.ndarray,
