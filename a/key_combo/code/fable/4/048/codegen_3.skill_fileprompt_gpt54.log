+                        "turns_ccw": turns_ccw,
+                        "side": side,
+                    }
+                )
+
+    best_by_component: dict[int, dict] = {}
+    for cand in sorted(candidates, key=lambda item: (item["side"], item["bbox"])):
+        best_by_component.setdefault(cand["component_id"], cand)
+    return list(best_by_component.values())
