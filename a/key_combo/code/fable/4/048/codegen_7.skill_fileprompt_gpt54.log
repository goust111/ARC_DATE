+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _split_input(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] >= 3
