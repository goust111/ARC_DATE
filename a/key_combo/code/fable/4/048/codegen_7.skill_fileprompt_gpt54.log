+    inp = np.full((total_h, total_w), BLACK, dtype=int)
+    start = random.randint(0, total_w - len(cycle))
+    inp[0, start : start + len(cycle)] = np.array(cycle, dtype=int)
+    inp[2:, :] = inp_main
+    return inp, expected
