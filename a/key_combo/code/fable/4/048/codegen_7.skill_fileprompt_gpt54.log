+    H, W = shape
+    obj = np.zeros((H, W), dtype=bool)
+    obj[coords[:, 0], coords[:, 1]] = True
+    out = np.zeros((H, W), dtype=bool)
+    for r, c in coords:
+        for nr in range(int(r) - 1, int(r) + 2):
