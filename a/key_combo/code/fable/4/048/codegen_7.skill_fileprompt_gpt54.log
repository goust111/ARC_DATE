+    graph = [[] for _ in range(n)]
+    for i, (r1, c1) in enumerate(positions):
+        for j in range(i + 1, n):
+            r2, c2 = positions[j]
+            if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+                graph[i].append(j)
