+    inp_main = main_grid.copy()
+    inp_main[objects[source_idx]["outline"]] = source_color
+
+    total_h = inp_main.shape[0] + 2
+    total_w = inp_main.shape[1]
+    if total_h > 30 or total_w > 30:
