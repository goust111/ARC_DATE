+    return graph
+
+
+def _bfs_distances(graph: list[list[int]], source: int) -> list[int]:
+    dist = [-1] * len(graph)
+    dist[source] = 0
+    queue = deque([source])
+    while queue:
+        cur = queue.popleft()
+        for nxt in graph[cur]:
