+    out = g.copy()
+    painted = np.zeros(g.shape, dtype=bool)
+    painted[r, c] = True
+    seen_states: set[tuple[int, int, int]] = set()
+
+    while True:
+        state = (r, c, d)
+        if state in seen_states:
+            break
+        seen_states.add(state)
