+def _classify_obstacle(mask: np.ndarray, cells: list[tuple[int, int]]) -> str:
+    r0, c0, r1, c1 = _bbox(cells)
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    if np.all(sub):
+        return "solid"
+    if (
+        sub.shape[0] >= 3
+        and sub.shape[1] >= 3
+        and np.all(sub[0, :])
+        and np.all(sub[-1, :])
+        and np.all(sub[:, 0])
+        and np.all(sub[:, -1])
+        and not np.any(sub[1:-1, 1:-1])
