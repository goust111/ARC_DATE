    hole_mask = _gen_keep_residues_visible(hole_mask, period)
    if hole_mask is None or not (TOTAL_BLACK_BOUNDS[0] <= int(hole_mask.sum()) <= TOTAL_BLACK_BOUNDS[1]):
        return None

    inp = out.copy()
    inp[hole_mask] = Color.BLACK
    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


