# Canvas and diagonal tile parameters.
CANVAS_SHAPE = (16, 16)
PERIOD_BOUNDS = (5, 8)
FIRST_TILE_COLOR = 1

# Hole geometry and black-cell budget.
HOLE_COUNT_BOUNDS = (3, 4)
TOTAL_BLACK_BOUNDS = (39, 43)
HOLE_SIDE_BOUNDS = (2, 7)
HOLE_AREA_BOUNDS = (4, 29)
REMOVED_CELL_DIVISOR = 5

