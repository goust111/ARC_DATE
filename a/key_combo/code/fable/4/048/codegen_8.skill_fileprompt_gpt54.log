            if c0 < 0:
                continue
            r_lo = max(0, hit_r - hh + 1)
            r_hi = min(hit_r, h - hh)
            if r_lo > r_hi:
                continue
            r0 = random.randint(r_lo, r_hi)
            bbox = (r0, c0, r0 + hh - 1, c0 + ww - 1)
        elif direction == 2:
            r0 = hit_r
            if r0 + hh > h:
