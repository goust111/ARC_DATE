+    obstacle_ids = np.full(g.shape, -1, dtype=int)
+    kinds: dict[int, str] = {}
+    for idx, cells in enumerate(comps):
+        kind = _classify_obstacle(obstacle_mask, cells)
+        kinds[idx] = kind
+        for cr, cc in cells:
