+    for obj in sorted(objects, key=lambda item: item["scale"], reverse=True):
+        crop_h, crop_w = obj["crop"].shape
+        scaled_h, scaled_w = _scaled_shape(obj["crop"], obj["scale"])
+        max_r = h - scaled_h
+        max_c = w - scaled_w
+        if max_r < 0 or max_c < 0:
+            return None
+
+        candidates: list[tuple[int, int]] = []
+        for _ in range(90):
