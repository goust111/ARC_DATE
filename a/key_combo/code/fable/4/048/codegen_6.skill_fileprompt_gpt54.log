+        if len(candidates) - start < hole_count - len(chosen):
+            return False
+        for idx in range(start, len(candidates)):
+            r, c = candidates[idx]
+            if any(abs(r - rr) + abs(c - cc) == 1 for rr, cc in chosen):
+                continue
+            chosen.append((r, c))
+            if search(idx + 1):
