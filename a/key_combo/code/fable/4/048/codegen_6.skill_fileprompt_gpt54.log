+    if not _visible_window_on_top(layer_info, out, BG):
+        return None
+    if float(np.count_nonzero(out)) / float(out.size) > 0.72:
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+    return inp
