+def _transparent_paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, transparent: int) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
