def _gen_region_fits(canvas: np.ndarray, rect: np.ndarray, r0: int, c0: int) -> bool:
    height, width = rect.shape
    grid_h, grid_w = canvas.shape
    rr0 = max(0, r0 - REGION_GAP)
    cc0 = max(0, c0 - REGION_GAP)
