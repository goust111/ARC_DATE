+        r0, c0 = random.choice(candidates)
+        placed_obj = dict(obj)
+        placed_obj["bbox"] = (r0, c0, r0 + crop_h - 1, c0 + crop_w - 1)
+        placed.append(placed_obj)
+        _mark_blocked(blocked, obj["mask"], r0, c0)
