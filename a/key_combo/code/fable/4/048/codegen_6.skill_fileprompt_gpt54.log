+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+NEIGHBORS8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 0),
+    (0, 1),
+    (1, -1),
+    (1, 0),
+    (1, 1),
+)
+
+GENERATION_RETRIES = 500
+OBJECT_COUNT_OPTIONS = (2, 3)
+HOLE_COUNT_POOL = (2, 3, 4, 5)
+COLOR_POOL = tuple(range(1, 10))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _find_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    objects: list[dict] = []
+    for color in sorted(set(map(int, np.unique(grid))) - {bg}):
+        for coords in _component_coords(grid == color):
+            bbox = _bbox_from_coords(coords)
+            crop = _crop_bbox(grid, bbox)
+            hole_mask, holes = _hole_mask_and_coords(crop, color, bg)
+            objects.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox,
+                    "crop": crop,
+                    "hole_mask": hole_mask,
+                    "holes": holes,
+                    "scale": len(holes),
+                }
+            )
+    return objects
+
+
+def _hole_mask_and_coords(crop: np.ndarray, color: int, bg: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    h, w = crop.shape
+    seen = np.zeros((h, w), dtype=bool)
+    hole_mask = np.zeros((h, w), dtype=bool)
+    holes: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if int(crop[r, c]) != bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and int(crop[nr, nc]) == bg and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if touches_border:
+                continue
+            assert len(coords) == 1, "every enclosed background component must be a 1-cell hole"
+            hr, hc = coords[0]
+            hole_mask[hr, hc] = True
+            holes.append((hr, hc))
