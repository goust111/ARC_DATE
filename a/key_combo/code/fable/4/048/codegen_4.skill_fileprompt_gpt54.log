+    grid = np.zeros((H, W), dtype=int)
+
+    for idx in order:
+        arr = arrays[idx]
+        h, w = map(int, arr.shape)
+        spots = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
