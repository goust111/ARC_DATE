+
+def _sprite_array(mask: np.ndarray) -> np.ndarray:
+    arr = np.zeros(mask.shape, dtype=int)
+    arr[mask] = GREY
+    return arr
+
+
+def _can_place(occupied: np.ndarray, top: int, left: int, h: int, w: int) -> bool:
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
