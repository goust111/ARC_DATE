+            if not candidates:
+                break
+            max_gain = max(gain for gain, _, _ in candidates)
+            if max_gain > 0:
+                pool = [(r, c) for gain, r, c in candidates if gain == max_gain]
+            else:
+                pool = [(r, c) for _, r, c in candidates]
