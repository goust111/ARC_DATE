+            actual = main(grid)
+        except AssertionError:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

