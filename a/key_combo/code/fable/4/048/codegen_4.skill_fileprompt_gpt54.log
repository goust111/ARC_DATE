+
+    total_area = sum((arr.shape[0] + 2) * (arr.shape[1] + 2) for arr in arrays)
+    min_side = max(18, int(np.ceil(np.sqrt(total_area))) + 2)
+    if min_side > 30:
+        return None
+
+    for _ in range(80):
