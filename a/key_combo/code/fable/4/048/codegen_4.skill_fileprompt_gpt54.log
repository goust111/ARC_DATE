import random, numpy as np
from collections import deque

def conn(mask):
    coords=np.argwhere(mask)
    if len(coords)==0: return False
    start=tuple(coords[0])
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==int(mask.sum())

def touch(mask):
    return mask[0,:].any() and mask[-1,:].any() and mask[:,0].any() and mask[:,-1].any()

def maze(h,w):
    g=np.zeros((h,w),dtype=bool)
    rooms=[(r,c) for r in range(1,h,2) for c in range(1,w,2)]
    start=random.choice(rooms)
    g[start]=True
    seen={start}
    stack=[start]
    while stack:
        r,c=stack[-1]
        nbrs=[]
        for dr,dc in [(-2,0),(2,0),(0,-2),(0,2)]:
            nr,nc=r+dr,c+dc
            if 1<=nr<h-1 and 1<=nc<w-1 and (nr,nc) not in seen:
                nbrs.append((nr,nc,dr//2,dc//2))
        if nbrs:
            nr,nc,mr,mc=random.choice(nbrs)
            g[r+mr,c+mc]=True
            g[nr,nc]=True
            seen.add((nr,nc))
            stack.append((nr,nc))
        else:
            stack.pop()
    # openings to four sides
    for c in [1,w-2]:
        g[0,c]=True; g[1,c]=True; g[h-1,c]=True; g[h-2,c]=True
    for r in [1,h-2]:
        g[r,0]=True; g[r,1]=True; g[r,w-1]=True; g[r,w-2]=True
    return g

for dims in [(7,7),(9,9),(7,9)]:
    ok=0
    for _ in range(100):
        m=maze(*dims)
        if conn(m) and conn(~m) and touch(m) and touch(~m):
            ok+=1
            if ok==1:
                print('sample',dims) ; print(m.astype(int))
    print(dims, ok)
