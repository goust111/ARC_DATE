+BLACK = 0
+GREY = 5
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in _DIR4:
+        yield r + dr, c + dc
+
