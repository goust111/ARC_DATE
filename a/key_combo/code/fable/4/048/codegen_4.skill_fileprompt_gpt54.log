/bin/bash -lc "python - <<'PY'
import numpy as np, random
from collections import deque

def conn(mask):
    coords=np.argwhere(mask)
    if len(coords)==0: return False
    start=tuple(coords[0])
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==mask.sum()

def touch(mask):
    return mask[0,:].any() and mask[-1,:].any() and mask[:,0].any() and mask[:,-1].any()

for h,w in [(4,4),(5,5),(5,6)]:
    found=False
    for _ in range(200000):
        p=random.uniform(0.25,0.55)
        m=np.random.rand(h,w)<p
        if not touch(m) or not touch(~m):
            continue
        if conn(m) and conn(~m):
            print('found', (h,w), m.astype(int), sep='\\n')
            found=True
            break
    print('done', (h,w), found)
