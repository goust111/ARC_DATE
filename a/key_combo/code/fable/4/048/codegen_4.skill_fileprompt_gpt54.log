+    counts = Counter(_mask_key(sprite) for sprite in sprites)
+    reps = {_mask_key(sprite): sprite for sprite in sprites}
+
+    surplus: list[tuple[tuple[int, int], bytes]] = []
+    handled: set[tuple[tuple[int, int], bytes]] = set()
+    for key in counts:
+        if key in handled:
+            continue
+        sprite = reps[key]
+        partner = _partner_mask(sprite)
+        partner_key = _mask_key(partner)
+        c1 = counts[key]
+        c2 = counts.get(partner_key, 0)
+        if partner_key == key:
+            if c1 % 2 == 1:
+                surplus.extend([key] * (c1 % 2))
+            handled.add(key)
+            continue
+        if c1 > c2:
+            surplus.extend([key] * (c1 - c2))
+        elif c2 > c1:
+            surplus.extend([partner_key] * (c2 - c1))
+        handled.add(key)
+        handled.add(partner_key)
+
+    assert len(surplus) == 1, "expected exactly one unmatched sprite"
+    outlier = reps[surplus[0]]
+    partner = _partner_mask(outlier)
+
+    out = np.zeros(outlier.shape, dtype=int)
+    out[partner] = GREY
+    return out
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(
+        mask[0, :].any()
+        and mask[-1, :].any()
+        and mask[:, 0].any()
+        and mask[:, -1].any()
+    )
+
+
+def _draw_segment(cells: list[tuple[int, int]], a: tuple[int, int], b: tuple[int, int]) -> None:
+    r0, c0 = a
+    r1, c1 = b
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            if not cells or cells[-1] != (r0, c):
+                cells.append((r0, c))
+        return
+    step = 1 if r1 >= r0 else -1
+    for r in range(r0, r1 + step, step):
+        if not cells or cells[-1] != (r, c0):
+            cells.append((r, c0))
+
+
+def _random_sprite_mask(h: int, w: int, forbidden: set[tuple[tuple[int, int], bytes]]) -> np.ndarray | None:
+    for _ in range(200):
+        top_col = random.randint(1, w - 2)
+        left_turn_row = random.randint(1, h - 3)
+        bottom_col = random.randint(1, w - 2)
+        right_turn_row = random.randint(left_turn_row + 1, h - 2)
+
+        cells: list[tuple[int, int]] = []
+        points = [
+            (0, top_col),
+            (left_turn_row, top_col),
+            (left_turn_row, 0),
+            (h - 1, 0),
+            (h - 1, bottom_col),
+            (right_turn_row, bottom_col),
+            (right_turn_row, w - 1),
+        ]
+        for a, b in zip(points, points[1:]):
+            _draw_segment(cells, a, b)
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        for _branch in range(random.randint(0, 2)):
+            anchors = cells[1:-1]
+            random.shuffle(anchors)
+            added = False
+            for ar, ac in anchors:
+                dirs = _DIR4[:]
+                random.shuffle(dirs)
+                for dr, dc in dirs:
+                    branch_cells: list[tuple[int, int]] = []
+                    max_len = 2 if random.random() < 0.5 else 1
+                    ok = True
+                    for step in range(1, max_len + 1):
+                        nr = ar + dr * step
+                        nc = ac + dc * step
+                        if not (0 <= nr < h and 0 <= nc < w) or mask[nr, nc]:
+                            ok = False
+                            break
+                        deg = 0
+                        for rr, cc in _neighbors4(nr, nc):
