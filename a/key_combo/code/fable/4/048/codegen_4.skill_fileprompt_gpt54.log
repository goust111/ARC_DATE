+            return None
+    return grid
+
+
+def _choose_dims() -> tuple[int, int]:
+    dims = [(h, w) for h in range(4, 8) for w in range(4, 8) if h % 2 == 0 or w % 2 == 0]
+    return random.choice(dims)
+
+
+def _build_pair_type(
+    dims: tuple[int, int],
+    forbidden: set[tuple[tuple[int, int], bytes]],
