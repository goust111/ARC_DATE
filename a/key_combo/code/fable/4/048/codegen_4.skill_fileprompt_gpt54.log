+                        branch_cells.append((nr, nc))
+                    if not ok or not branch_cells:
+                        continue
+                    trial = mask.copy()
+                    for nr, nc in branch_cells:
+                        trial[nr, nc] = True
+                    if _is_connected(~trial):
+                        mask = trial
+                        cells.extend(branch_cells)
+                        added = True
+                        break
+                if added:
+                    break
+
+        comp = ~mask
+        if not (_is_connected(mask) and _is_connected(comp)):
+            continue
+        if not (_touches_all_sides(mask) and _touches_all_sides(comp)):
+            continue
