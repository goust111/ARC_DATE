+            _draw_segment(cells, a, b)
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+
+        for _branch in range(random.randint(0, 2)):
+            anchors = cells[1:-1]
+            random.shuffle(anchors)
+            added = False
+            for ar, ac in anchors:
+                dirs = _DIR4[:]
+                random.shuffle(dirs)
+                for dr, dc in dirs:
+                    branch_cells: list[tuple[int, int]] = []
+                    max_len = 2 if random.random() < 0.5 else 1
+                    ok = True
+                    for step in range(1, max_len + 1):
+                        nr = ar + dr * step
+                        nc = ac + dc * step
+                        if not (0 <= nr < h and 0 <= nc < w) or mask[nr, nc]:
+                            ok = False
+                            break
+                        deg = 0
+                        for rr, cc in _neighbors4(nr, nc):
+                            if 0 <= rr < h and 0 <= cc < w and (mask[rr, cc] or (rr, cc) in branch_cells):
+                                deg += 1
+                        if deg != 1:
