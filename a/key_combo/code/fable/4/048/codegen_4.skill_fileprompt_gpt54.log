+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(
+        mask[0, :].any()
+        and mask[-1, :].any()
+        and mask[:, 0].any()
+        and mask[:, -1].any()
+    )
+
+
+def _random_sprite_mask(h: int, w: int, forbidden: set[tuple[tuple[int, int], bytes]]) -> np.ndarray | None:
+    n = h * w
+    min_len = max(h + w - 2, int(np.ceil(0.28 * n)))
+    max_len = min(n - 4, int(np.floor(0.55 * n)))
+    if min_len > max_len:
+        return None
+
+    for _ in range(200):
+        mask = np.zeros((h, w), dtype=bool)
+        start = (random.randrange(h), random.randrange(w))
+        mask[start] = True
+        target = random.randint(min_len, max_len)
+        sides_hit = {
+            "top": start[0] == 0,
+            "bottom": start[0] == h - 1,
+            "left": start[1] == 0,
+            "right": start[1] == w - 1,
+        }
+
+        for _step in range(target - 1):
+            candidates: list[tuple[int, int, int]] = []
+            for r in range(h):
+                for c in range(w):
+                    if mask[r, c]:
+                        continue
+                    deg = 0
+                    for nr, nc in _neighbors4(r, c):
+                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                            deg += 1
+                    if deg != 1:
+                        continue
+                    gain = 0
+                    gain += int(r == 0 and not sides_hit["top"])
+                    gain += int(r == h - 1 and not sides_hit["bottom"])
+                    gain += int(c == 0 and not sides_hit["left"])
+                    gain += int(c == w - 1 and not sides_hit["right"])
