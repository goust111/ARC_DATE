+
+    assert len(surplus) == 1, "expected exactly one unmatched sprite"
+    outlier = reps[surplus[0]]
+    partner = _partner_mask(outlier)
+
+    out = np.zeros(outlier.shape, dtype=int)
+    out[partner] = GREY
+    return out
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(
+        mask[0, :].any()
+        and mask[-1, :].any()
+        and mask[:, 0].any()
+        and mask[:, -1].any()
+    )
+
+
+def _draw_segment(cells: list[tuple[int, int]], a: tuple[int, int], b: tuple[int, int]) -> None:
+    r0, c0 = a
+    r1, c1 = b
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            if not cells or cells[-1] != (r0, c):
+                cells.append((r0, c))
+        return
+    step = 1 if r1 >= r0 else -1
+    for r in range(r0, r1 + step, step):
+        if not cells or cells[-1] != (r, c0):
+            cells.append((r, c0))
+
+
+def _random_sprite_mask(h: int, w: int, forbidden: set[tuple[tuple[int, int], bytes]]) -> np.ndarray | None:
+    for _ in range(200):
+        top_col = random.randint(1, w - 2)
+        left_turn_row = random.randint(1, h - 3)
+        bottom_col = random.randint(1, w - 2)
+        right_turn_row = random.randint(left_turn_row + 1, h - 2)
+
+        cells: list[tuple[int, int]] = []
+        points = [
+            (0, top_col),
+            (left_turn_row, top_col),
+            (left_turn_row, 0),
+            (h - 1, 0),
+            (h - 1, bottom_col),
+            (right_turn_row, bottom_col),
