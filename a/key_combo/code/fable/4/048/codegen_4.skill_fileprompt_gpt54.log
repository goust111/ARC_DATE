+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _extract_sprites(grid: np.ndarray) -> list[np.ndarray]:
+    mask = grid == GREY
+    seen = np.zeros_like(mask, dtype=bool)
+    sprites: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        cells = []
+        while q:
+            cr, cc = q.popleft()
+            cells.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comp = np.zeros_like(mask, dtype=bool)
+        for cr, cc in cells:
+            comp[cr, cc] = True
+        r0, c0, r1, c1 = _bbox(comp)
+        sprites.append(comp[r0 : r1 + 1, c0 : c1 + 1])
+    return sprites
+
+
+def _partner_mask(mask: np.ndarray) -> np.ndarray:
+    return np.rot90(~mask, 2)
+
