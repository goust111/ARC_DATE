+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_DIR8 = _DIR4 + [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+_GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in _DIR4:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr, dc in _DIR8:
+        yield r + dr, c + dc
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_connected(mask: np.ndarray, connectivity: int = 4) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    neigh = _neighbors4 if connectivity == 4 else _neighbors8
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neigh(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _extract_sprites(grid: np.ndarray) -> list[np.ndarray]:
+    mask = grid == GREY
+    seen = np.zeros_like(mask, dtype=bool)
+    sprites: list[np.ndarray] = []
+    neigh = _neighbors8
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        cells = []
+        while q:
+            cr, cc = q.popleft()
+            cells.append((cr, cc))
+            for nr, nc in neigh(cr, cc):
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comp = np.zeros_like(mask, dtype=bool)
+        for cr, cc in cells:
+            comp[cr, cc] = True
