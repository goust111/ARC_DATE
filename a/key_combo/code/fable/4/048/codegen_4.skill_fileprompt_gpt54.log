+    special_dims = _choose_dims()
+    forbidden: set[tuple[tuple[int, int], bytes]] = set()
+
+    pair_specs: list[tuple[np.ndarray, np.ndarray, int]] = []
+
+    special_pair = _build_pair_type(special_dims, forbidden)
