+        W = random.randint(min_side, 30)
+        grid = _place_objects(arrays, H, W)
+        if grid is None:
+            continue
+        try:
+            actual = main(grid)
+        except AssertionError:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    return None
