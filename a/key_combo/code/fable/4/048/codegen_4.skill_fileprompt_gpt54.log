import numpy as np, random, math
from collections import deque

def conn(mask):
    coords=np.argwhere(mask)
    if len(coords)==0 or len(coords)==mask.size: return False
    start=tuple(coords[0])
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==int(mask.sum())

def touch(mask):
    return [mask[0,:].any(), mask[-1,:].any(), mask[:,0].any(), mask[:,-1].any()]

def score(m):
    s=0
    s += 4 * sum(touch(m))
    c = ~m
    s += 4 * sum(touch(c))
    if conn(m): s += 20
    if conn(c): s += 20
    return s

h=w=8
best_global=None
best_score=-1
for restart in range(6):
    m=np.random.rand(h,w)<0.5
    cur=score(m)
    temp=3.0
