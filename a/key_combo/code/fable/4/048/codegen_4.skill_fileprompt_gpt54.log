import numpy as np, random, math
from collections import deque

def conn(mask):
    coords=np.argwhere(mask)
    if len(coords)==0: return False
    start=tuple(coords[0])
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<mask.shape[0] and 0<=nc<mask.shape[1] and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==int(mask.sum())

def touch(mask):
    return mask[0,:].any() and mask[-1,:].any() and mask[:,0].any() and mask[:,-1].any()

def score(m):
    s=0
    if touch(m): s+=4
    if touch(~m): s+=4
    if conn(m): s+=10
    if conn(~m): s+=10
    return s

for h,w in [(6,6),(7,7),(8,8),(9,9)]:
    m=np.random.rand(h,w)<0.5
    cur=score(m)
    best=cur; bestm=m.copy()
    temp=2.0
    print('start', (h,w), cur, flush=True)
    for step in range(300000):
        r=random.randrange(h); c=random.randrange(w)
        m[r,c]=~m[r,c]
        sc=score(m)
        if sc==28:
            print('found', (h,w), step, flush=True)
            print(m.astype(int), flush=True)
            raise SystemExit
        delta=sc-cur
        if delta >= 0 or random.random() < math.exp(delta/max(temp,1e-6)):
            cur=sc
            if sc>best:
                best=sc; bestm=m.copy(); print('best', (h,w), best, step, flush=True)
        else:
            m[r,c]=~m[r,c]
        temp*=0.99999
    print('done', (h,w), best, flush=True)
    print(bestm.astype(int), flush=True)
