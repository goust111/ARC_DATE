+    canvas_h = rng.randint(panel_h + 2, min(30, panel_h + 8))
+
+    xs = _row_positions(canvas_w, panel_count, panel_w, INTERNAL_GAP, rng)
+    ys = [rng.randint(1, canvas_h - panel_h - 1) for _ in range(panel_count)]
