+            x += gaps[i + 1]
+    return xs
+
+
+def _pointer_slots(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    slots = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                    slots.append((r, c))
+                    break
+    return slots
+
+
+def _extract_panels(grid: np.ndarray, bg: int) -> list[dict]:
+    mask = grid != bg
+    panels = []
+    for coords in _components(mask):
+        rows = [r for r, _c in coords]
+        cols = [c for _r, c in coords]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        panels.append({"arr": grid[r0 : r1 + 1, c0 : c1 + 1].copy(), "bbox": (r0, c0, r1, c1)})
+    return panels
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(int(x) for x in coords[0])
+    seen = {start}
+    stack = [start]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])

