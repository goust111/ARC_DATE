HOLE_SIDE_BOUNDS = (2, 7)
HOLE_AREA_BOUNDS = (4, 29)
REMOVED_CELL_DIVISOR = 5

# Placement separation, connectivity checks, and retry budget.
HOLE_PLACEMENT_PADDING = 1
HOLE_PADDING_CONNECTIVITY = 8
HOLE_CONNECTIVITY = 4
