+def _line_to_border(shape: tuple[int, int], pos: tuple[int, int], dir_idx: int) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = DIRS[dir_idx]
+    r, c = pos
+    cells: list[tuple[int, int]] = []
+    r += dr
+    c += dc
+    while 0 <= r < h and 0 <= c < w:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
