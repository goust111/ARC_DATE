+def _has_smaller_period(tile: np.ndarray) -> bool:
+    pr, pc = tile.shape
+    for rr in range(1, pr + 1):
+        for cc in range(1, pc + 1):
+            if rr == pr and cc == pc:
+                continue
+            ok = True
+            for r in range(pr):
+                for c in range(pc):
+                    if int(tile[r, c]) != int(tile[r % rr, c % cc]):
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                return True
+    return False
