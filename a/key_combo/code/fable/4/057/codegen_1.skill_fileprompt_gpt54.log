def _gen_be94b721_dim_choices(area: int, *, largest: bool) -> list[tuple[int, int]]:
    row_min, row_max = LARGEST_HEIGHT_RANGE if largest else DISTRACTOR_HEIGHT_RANGE
    choices: list[tuple[int, int]] = []
