_HOLE_COUNT_RANGE, _HOLE_TOTAL_RANGE = (4, 5), (46, 65)
_RECT_H_RANGE, _RECT_W_RANGE, _RECT_AREA_RANGE = (2, 6), (2, 7), (4, 34)

