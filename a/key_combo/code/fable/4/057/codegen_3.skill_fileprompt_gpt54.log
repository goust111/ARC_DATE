    local = np.zeros((h, w), dtype=bool)
    full_rows, rem = divmod(pixel_count, w)
    if full_rows:
        local[:full_rows, :] = True
    if rem:
        start = int(np.random.randint(0, w - rem + 1))
        local[full_rows, start : start + rem] = True

    if bool(np.random.randint(0, 2)):
