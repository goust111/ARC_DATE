+    grid_h = random.randint(max(pattern_h + 4, GRID_H_RANGE[0]), GRID_H_RANGE[1])
+    grid_w = random.randint(max(pattern_w + 4, GRID_W_RANGE[0]), GRID_W_RANGE[1])
