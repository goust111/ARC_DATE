+            if (r, c) in forbidden or (r, mc) in forbidden:
+                continue
+            pairs.append((r, c, mc))
+    random.shuffle(pairs)
+    for r, c, mc in pairs[: max(3, len(pairs))]:
+        region[r, c] = sticker_color
+        region[r, mc] = sticker_color
+        return True
+    return False
