+    pattern_bbox = _find_pattern_bbox(g, bg)
+    r0, c0, r1, c1 = pattern_bbox
+    region = g[r0 : r1 + 1, c0 : c1 + 1]
+    sticker_color, sticker_local = _find_sticker(region)
+    return _move_sticker(g, pattern_bbox, sticker_color, sticker_local)
