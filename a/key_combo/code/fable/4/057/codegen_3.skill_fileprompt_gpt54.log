        if not choices:
            return None
        cells = choices[int(np.random.randint(len(choices)))]
        rows, cols = np.array(cells, dtype=int).T
        out[rows, cols] = color
        occupied[rows, cols] = True
        placed.append((color, cells))
    return out, placed


