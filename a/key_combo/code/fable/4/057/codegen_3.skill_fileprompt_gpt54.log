+def _move_sticker(
+    grid: np.ndarray,
+    pattern_bbox: tuple[int, int, int, int],
+    sticker_color: int,
+    sticker_local: np.ndarray,
+) -> np.ndarray:
+    r0, c0, r1, c1 = pattern_bbox
+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    out = grid.copy()
