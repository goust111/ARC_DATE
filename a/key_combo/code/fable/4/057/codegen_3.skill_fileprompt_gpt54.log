            if max(h, w) / max(1, min(h, w)) > GEN_BLOB_MAX_ASPECT:
                continue
            if area - pixel_count > max(GEN_BLOB_EXTRA_AREA_FLOOR, min(h, w) + 1):
                continue
            options.append((h, w))

