+    fc1 = fc0 + frame_w - 1
+    canvas[fr0, fc0 : fc1 + 1] = frame_color
+    canvas[fr1, fc0 : fc1 + 1] = frame_color
+    canvas[fr0 : fr1 + 1, fc0] = frame_color
+    canvas[fr0 : fr1 + 1, fc1] = frame_color
