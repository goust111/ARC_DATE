+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+PALETTE = list(range(10))
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIDE_RANGE = (18, 27)
+SPRITE_COUNT_RANGE = (2, 4)
