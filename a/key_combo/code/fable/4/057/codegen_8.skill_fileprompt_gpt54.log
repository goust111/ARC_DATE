        total_mask,
        blob_count,
        GEN_BLOB_PIXELS_MIN,
        GEN_BLOB_PIXELS_MAX,
    )
    if blob_sizes is None:
        return None
    np.random.shuffle(blob_sizes)

    mask = np.zeros((GEN_GRID_SIZE, GEN_GRID_SIZE), dtype=bool)
    orbit_mask_counts = [0] * len(caps)
    for blob_size in blob_sizes:
