+        full_mask = _build_full_mask(half_mask, types[idx])
+        specs.append(
+            {
+                "color": object_colors[idx],
+                "type": types[idx],
+                "top": starts[idx],
+                "left": bar_c0 - half_w,
+                "mask": full_mask,
+                "area": int(full_mask.sum()),
