+    slack = height - min_total
+    gaps = [0] * (len(object_heights) + 1)
+    for _ in range(slack):
+        gaps[random.randrange(len(gaps))] += 1
+    starts: list[int] = []
+    cursor = gaps[0]
+    for i, obj_h in enumerate(object_heights):
+        starts.append(cursor)
+        cursor += obj_h + 1 + gaps[i + 1]
