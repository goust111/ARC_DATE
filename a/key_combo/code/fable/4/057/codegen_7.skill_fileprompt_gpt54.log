+def _is_connected(coords: set[Coord]) -> bool:
+    if not coords:
+        return False
+    stack = [next(iter(coords))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in coords and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
