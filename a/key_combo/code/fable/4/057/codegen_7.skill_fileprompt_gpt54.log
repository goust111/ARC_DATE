+    for axis_sum in range(0, 2 * width - 1):
+        added: set[Coord] = set()
+        ok = True
+        for r, c in observed:
+            cc = axis_sum - c
+            if not 0 <= cc < width:
+                ok = False
+                break
+            mate = (r, int(cc))
+            if mate not in observed:
+                if int(cc) not in bar_cols:
+                    ok = False
+                    break
+                added.add(mate)
+        if not ok or (require_hidden and not added):
+            continue
+        full = observed | added
+        if _is_connected(full):
