+            for cc in range(max(0, c - PADDING_RADIUS), min(w, c + PADDING_RADIUS + 1)):
+                blocked[rr, cc] = True
+
+
+def _render_input(shape: tuple[int, int], pairs: list[dict[str, object]]) -> np.ndarray:
+    grid = np.full(shape, BACKGROUND, dtype=int)
+    for pair in pairs:
+        color = int(pair["color"])
+        path = pair["path"]
+        grid[path[0]] = color
+        grid[path[-1]] = color
