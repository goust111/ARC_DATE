+    for _ in range(4 * h * w + 1):
+        r, c, dr, dc, bounced = _advance((h, w), r, c, dr, dc)
+        if bounced:
+            bounce_count += 1
+
+        cell = (r, c)
+        if cell == target:
+            path.append(cell)
+            return path, bounce_count
+
+        if int(grid[r, c]) != bg:
+            return None
+
+        path.append(cell)
+        state = (r, c, dr, dc)
+        if state in states:
+            return None
+        states.add(state)
+
+    return None
