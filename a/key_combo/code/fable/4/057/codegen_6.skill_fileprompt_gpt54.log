            if occupancy[cell]:
                return False
            occupancy[cell] = True
        for cell in spec["blockers"]:
            if occupancy[cell]:
                return False
            occupancy[cell] = True
    return True


def _render_input(height: int, width: int, specs: list[dict[str, object]]) -> np.ndarray:
    grid = np.full((height, width), BACKGROUND, dtype=int)
    for spec in specs:
