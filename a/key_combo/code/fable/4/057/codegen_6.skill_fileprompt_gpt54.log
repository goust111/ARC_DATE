+
+    for color in order:
+        r, c = sources[color]
+        target_r, target_c = endpoints[color]
+        seen = {(r, c)}
+
+        while (r, c) != (target_r, target_c):
+            assert r + 1 < height or (r, c) == (target_r, target_c), "path ran out of rows before reaching its endpoint"
