+        or br + BLOCK_SIZE - 1 < ar
+        or ac + BLOCK_SIZE - 1 < bc
+        or bc + BLOCK_SIZE - 1 < ac
+    )
+
+
+def _block_touch_or_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    ar, ac = a
+    br, bc = b
+    return not (
