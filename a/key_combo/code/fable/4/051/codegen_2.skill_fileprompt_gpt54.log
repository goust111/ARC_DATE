+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+ORANGE = 7
+
+BLOCK_SIZE = 3
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+SIDE_TO_DIR = {"top": "down", "bottom": "up", "left": "right", "right": "left"}
+MARKER_POS = {"up": (0, 1), "down": (2, 1), "left": (1, 0), "right": (1, 2)}
+MARKER_DIR = {v: k for k, v in MARKER_POS.items()}
