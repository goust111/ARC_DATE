+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+NON_BLACK_NON_YELLOW = [1, 2, 3, 5, 6, 7, 8, 9]
+
+GRID_HEIGHT_RANGE = (18, 27)
