def _gen_area_bounds(h, w):
    cells = h * w
    lower = (AREA_MIN_NUM * cells + AREA_MIN_DEN - 1) // AREA_MIN_DEN
    upper = (AREA_MAX_PERCENT * cells) // AREA_PERCENT_DEN
    return max(AREA_MIN, lower), min(AREA_MAX, upper)


