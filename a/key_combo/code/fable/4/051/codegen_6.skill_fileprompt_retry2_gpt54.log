        axis_rows = [h // 2] if h % 2 else [h // 2 - 1, h // 2]
        mask[axis_rows, :] = True
        choices = [c for c in range(w) if c != w - 1 - c]
        arm_col = random.choice(choices)
        mask[:, arm_col] = True

