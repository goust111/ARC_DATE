+                    "bbox": (r0, c0, r1, c1),
+                    "border": tuple(sorted(border)),
+                }
+            )
+    return rectangles
+
+
+def _marker_direction(shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:
+    h, w = shape
+    on_top = r == 0
+    on_bottom = r == h - 1
+    on_left = c == 0
+    on_right = c == w - 1
+    assert (on_top + on_bottom + on_left + on_right) == 1, "marker must lie on exactly one border side"
+    if on_top:
+        return 1, 0
+    if on_bottom:
+        return -1, 0
+    if on_left:
+        return 0, 1
+    return 0, -1
