+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(inp, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

