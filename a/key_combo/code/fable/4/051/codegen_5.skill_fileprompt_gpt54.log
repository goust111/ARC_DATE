+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(coords: list[tuple[int, int]]) -> tuple[np.ndarray, int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask, r0, c0
+
+
+def _arrow_sprite(direction: str, shaft_len: int) -> np.ndarray:
+    shaft_len = int(shaft_len)
+    assert shaft_len >= 2
+    if direction == "right":
+        sprite = np.zeros((3, shaft_len + 2), dtype=bool)
+        sprite[1, :] = True
+        sprite[:, -2] = True
+        return sprite
+    if direction == "left":
+        sprite = np.zeros((3, shaft_len + 2), dtype=bool)
+        sprite[1, :] = True
+        sprite[:, 1] = True
+        return sprite
+    if direction == "down":
+        sprite = np.zeros((shaft_len + 2, 3), dtype=bool)
+        sprite[:, 1] = True
+        sprite[-2, :] = True
+        return sprite
+    if direction == "up":
+        sprite = np.zeros((shaft_len + 2, 3), dtype=bool)
+        sprite[:, 1] = True
+        sprite[1, :] = True
+        return sprite
+    raise AssertionError(f"unknown direction: {direction}")
+
