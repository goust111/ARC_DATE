+def _sample_spaced_starts(max_start: int, count: int, min_delta: int) -> list[int] | None:
+    starts = list(range(1, max_start + 1))
+    for _ in range(100):
+        random.shuffle(starts)
+        picked: list[int] = []
+        for pos in starts:
+            if all(abs(pos - prev) >= min_delta for prev in picked):
+                picked.append(pos)
+                if len(picked) == count:
+                    return sorted(picked)
+    return None
+
