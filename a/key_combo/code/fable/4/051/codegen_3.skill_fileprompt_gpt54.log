+    half_w = random.randint(7, 15)
+    bg = random.choice(INPUT_BG_CHOICES)
+    sep = _separator_color(bg)
+
+    margin_r = 1 if half_h >= 3 else 0
+    margin_c = 1 if half_w >= 3 else 0
+    anchor = (
