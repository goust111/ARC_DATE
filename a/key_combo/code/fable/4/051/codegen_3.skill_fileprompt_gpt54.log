+
+    color_counts = Counter(map(int, grid.flatten()))
+    if color_counts[sep] != half_w:
+        return None
+    if np.any(np.all(top_half == sep, axis=1)) or np.any(np.all(bottom_half == sep, axis=1)):
+        return None
+    return grid
