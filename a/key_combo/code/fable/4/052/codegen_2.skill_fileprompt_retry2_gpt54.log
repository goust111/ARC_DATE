+def _scatter_pieces(grid, occupied, pieces):
+    gh, gw = grid.shape
+    for piece in sorted(pieces, key=lambda item: -(item["shape"][0] * item["shape"][1])):
+        ph, pw = piece["shape"]
+        positions = [(r, c) for r in range(1, gh - ph) for c in range(1, gw - pw)]
