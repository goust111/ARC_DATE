+        else:
+            rects.append((r0, c0, r1, cut - 1))
+            rects.append((r0, cut, r1, c1))
+    rects.sort()
+    return rects
+
+
+def _color_scene(rects, height, width):
+    scene = np.zeros((height, width), dtype=int)
+    colors = random.sample(PALETTE, len(rects) + 1)
+    assignment = {}
