14: def main(input_grid):
15:     """
16:     Pull each colored pixel toward the gray rectangle until it touches the accumulated gray mass, then recolor it gray.
17: 
18:     Input structure:
19:     - The grid contains exactly one gray rectangle or bar on a black background.
20:     - Other non-black, non-gray objects are colored pixels or small objects around it.
21:     - Objects may appear on any side after rotation.
22: 
23:     Rule:
24:     - Detect the gray object and all other colored objects.
25:     - For each colored object, find the shortest cardinal displacement that would make it touch the gray object.
26:     - Move it in that direction until the next step would collide, recolor it gray, and paste it.
27: 
28:     Key insight:
29:     - The gray rectangle acts as both magnet and accumulator; previously moved objects affect
30:       where later objects stop.
31:     """
32:     # Plan:
33:     # 1. Detect the objects; separate the gray rectangle from the other pixels
34:     # 2. Move each colored pixel toward the gray rectangle until it touches
35:     # 3. Change its color once it touches
36: 
37:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
38: 
39:     grey_objects = [ obj for obj in objects if Color.GREY in colors_present(obj, exclude={ Color.BLACK }) ]
40:     other_objects = [ obj for obj in objects if Color.GREY not in colors_present(obj, exclude={ Color.BLACK }) ]
41: 
42:     assert len(grey_objects) == 1, "There should be exactly one grey object"
43:     
44:     grey_object = grey_objects[0]
45: 
46:     # Make the output grid: Start with the gray object, then add the colored pixels one-by-one
47:     output_grid = np.full_like(input_grid, Color.BLACK)
48:     paste(output_grid, grey_object, 0, 0, transparent=Color.BLACK, clip=True)
49: 
50:     # Move the colored objects and change their color once they hit grey
51:     for colored_object in other_objects:
52:         # First calculate what direction we have to move in order to contact the grey object
53:         # Consider all displacements, starting with the smallest translations first
54:         possible_displacements = [ (i*dr, i*dc) for i in range(0, 30) for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)] ]
55: 
56:         # Only keep the displacements that cause a contact between the colored object and the grey object
57:         valid_displacements = [ displacement for displacement in possible_displacements
58:                                 if contact(object1=translate(colored_object, *displacement), object2=grey_object) ]
59:         assert valid_displacements, "There should be at least one valid displacement"
60: 
61:         # Pick the smallest valid displacement
62:         displacement = min(valid_displacements, key=lambda displacement: sum(abs(r) for r in displacement))
63: 
64:         # Extract the direction from the displacement
65:         direction = np.sign(displacement, dtype=int)
66: 
67:         # Now move the colored object in that direction until there is a collision with something else
68:         if not all( delta == 0 for delta in direction ):
69:             while not collision(object1=translate(colored_object, *direction), object2=output_grid):
70:                 colored_object = translate(colored_object, *direction)
71:         
72:         # Finally change the color of the colored object to grey anne draw it onto the outlet
73:         colored_object[colored_object != Color.BLACK] = Color.GREY
74:         paste(output_grid, colored_object, 0, 0, transparent=Color.BLACK, clip=True)
75:     
76:     return output_grid
