+        r0, c0, r1, c1 = rect
+        scene[r0 : r1 + 1, c0 : c1 + 1] = colors[idx]
+    for i, rect_a in enumerate(rects):
+        for rect_b in rects[i + 1 :]:
+            if _rectangles_adjacent(rect_a, rect_b):
