    return True


def _make_input():
    sh = random.randint(12, 17)
    sw = random.randint(12, 17)
    rects = _partition_scene(sh, sw)
    if len(rects) < 5:
        return None
    scene, occluder_color = _color_scene(rects, sh, sw)
    if not _scene_is_asymmetric(scene):
