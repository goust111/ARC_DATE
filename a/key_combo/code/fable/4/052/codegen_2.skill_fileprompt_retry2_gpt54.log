def _can_place_rect(occupied, r0, c0, h, w):
    gh, gw = occupied.shape
    rr0 = max(0, r0 - 1)
    cc0 = max(0, c0 - 1)
    rr1 = min(gh, r0 + h + 1)
    cc1 = min(gw, c0 + w + 1)
    return not occupied[rr0:rr1, cc0:cc1].any()


def _scatter_pieces(grid, occupied, pieces):
    gh, gw = grid.shape
