+GRID_MIN = 18
+GRID_MAX = 30
+SOURCE_MIN_SIDE = 4
+SOURCE_MAX_SIDE = 7
+MARKER_MIN = 3
+MARKER_MAX = 6
+MATCH_MIN = 2
+MATCH_MAX = 5
+DISTRACTOR_MIN = 4
