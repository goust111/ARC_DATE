+    bg: int,
+    marker_color: int,
+    cell: tuple[int, int],
+    allowed_keys: set[tuple[frozenset[tuple[int, int]], frozenset[tuple[int, int]]]],
+    by_cell: dict[tuple[int, int], list[tuple[frozenset[tuple[int, int]], frozenset[tuple[int, int]]]]],
+) -> bool:
