    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    fill_color, marker_color, marker_mask = _find_source(g, bg)

    out = g.copy()
    for fill_cells in _matching_fill_cells(g, bg, marker_color, marker_mask):
        for r, c in fill_cells:
            out[r, c] = fill_color
    return out

