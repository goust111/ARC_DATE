+                    continue
+                box = (r0, c0, h, w)
+                assert box not in seen_boxes, "match should have unique chirality"
+                seen_boxes.add(box)
+                matches.append(
+                    {
+                        "r0": int(r0),
+                        "c0": int(c0),
+                        "mask": transformed.copy(),
+                        "chirality": chirality,
+                    }
+                )
+    return matches
+
+
