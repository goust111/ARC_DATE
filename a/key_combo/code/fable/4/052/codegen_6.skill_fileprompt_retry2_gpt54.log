+def _orientation_map(mask: np.ndarray, *, strict: bool = True) -> list[tuple[np.ndarray, str]]:
+    oriented: dict[tuple[tuple[int, int], tuple[int, ...]], tuple[np.ndarray, str]] = {}
+    for k in range(4):
