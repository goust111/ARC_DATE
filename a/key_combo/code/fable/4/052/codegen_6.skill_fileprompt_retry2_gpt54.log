+                    (r0 + rr, c0 + cc)
+                    for rr in range(h)
+                    for cc in range(w)
+                    if transformed[rr, cc]
+                )
+                fill_cells = frozenset(
+                    (r0 + rr, c0 + cc)
+                    for rr in range(h)
+                    for cc in range(w)
+                    if not transformed[rr, cc]
+                )
+                footprint = marker_cells | fill_cells
+                rec = {
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "mask": transformed.copy(),
+                    "chirality": chirality,
+                    "marker_cells": marker_cells,
+                    "fill_cells": fill_cells,
+                    "footprint": footprint,
+                    "key": (marker_cells, fill_cells),
