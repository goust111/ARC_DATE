+
+
+def _valid_match_keys(
+    grid: np.ndarray,
+    bg: int,
+    marker_color: int,
+    placements: list[dict[str, object]],
+) -> set[tuple[frozenset[tuple[int, int]], frozenset[tuple[int, int]]]]:
