+            colors = set(map(int, np.unique(region)))
+            if bg in colors or len(colors) != 2 or color not in colors:
+                continue
+            if int(region[0, 0]) != color or int(region[0, -1]) != color or int(region[-1, 0]) != color or int(region[-1, -1]) != color:
