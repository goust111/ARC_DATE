+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "mask": transformed.copy(),
+                    "chirality": chirality,
+                    "marker_cells": marker_cells,
+                    "fill_cells": fill_cells,
+                    "footprint": footprint,
+                    "key": (marker_cells, fill_cells),
