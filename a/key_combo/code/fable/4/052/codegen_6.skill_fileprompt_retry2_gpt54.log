+            if int(np.count_nonzero(region == color)) != len(coords):
+                continue
+            marker_color = next(iter(colors - {color}))
+            marker_mask = region == marker_color
+            if not marker_mask.any() or marker_mask.all():
+                continue
+            if not _has_full_chirality(marker_mask):
