+        return None
+    if not np.array_equal(main(inp), out):
+        return None
+    if len(set(map(int, np.unique(inp)))) < 3:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _make_attempt()
