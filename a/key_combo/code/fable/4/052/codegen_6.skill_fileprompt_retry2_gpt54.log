+def _placement_index(
+    grid_shape: tuple[int, int],
+    marker_mask: np.ndarray,
+) -> tuple[list[dict[str, object]], dict[tuple[int, int], list[tuple[frozenset[tuple[int, int]], frozenset[tuple[int, int]]]]]]:
+    H, W = map(int, grid_shape)
