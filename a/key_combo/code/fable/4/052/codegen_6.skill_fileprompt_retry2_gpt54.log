+            else:
+                if (marker_cells, fill_cells) not in allowed_keys:
+                    return False
+    return True
+
+
+def _apply_expected(
+    inp: np.ndarray,
+    fill_color: int,
+    marker_color: int,
+    chosen: list[dict[str, object]],
+) -> np.ndarray:
