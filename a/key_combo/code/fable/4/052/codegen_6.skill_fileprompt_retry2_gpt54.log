+        h = random.randint(SOURCE_MIN_SIDE, SOURCE_MAX_SIDE)
+        w = random.randint(SOURCE_MIN_SIDE, SOURCE_MAX_SIDE)
+        interior = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+        if len(interior) < MARKER_MIN:
+            continue
