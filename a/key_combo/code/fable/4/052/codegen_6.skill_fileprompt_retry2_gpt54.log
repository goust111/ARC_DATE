+    for match in matches:
+        r0 = int(match["r0"])
+        c0 = int(match["c0"])
+        transformed = np.asarray(match["mask"], dtype=bool)
+        h, w = transformed.shape
+        patch = out[r0 : r0 + h, c0 : c0 + w]
+        if match["chirality"] == "rotation":
+            patch[~transformed] = fill_color
+        else:
+            patch[transformed] = fill_color
+            patch[~transformed] = marker_color
