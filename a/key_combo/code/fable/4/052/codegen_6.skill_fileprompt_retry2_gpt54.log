+    for rec in chosen:
+        r0 = int(rec["r0"])
+        c0 = int(rec["c0"])
+        transformed = np.asarray(rec["mask"], dtype=bool)
+        patch = out[r0 : r0 + transformed.shape[0], c0 : c0 + transformed.shape[1]]
+        if rec["chirality"] == "rotation":
+            patch[~transformed] = fill_color
+        else:
+            patch[transformed] = fill_color
+            patch[~transformed] = marker_color
+    return out
+
