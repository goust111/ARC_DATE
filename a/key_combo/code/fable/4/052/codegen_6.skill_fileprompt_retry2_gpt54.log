+def _choose_match_counts() -> tuple[int, int]:
+    mode = random.choices(
+        ["both", "rotation_only", "mirror_only"],
+        weights=[0.6, 0.2, 0.2],
+        k=1,
+    )[0]
+    total = random.randint(MATCH_MIN, MATCH_MAX)
+    if mode == "both":
+        rot = random.randint(1, total - 1)
+        mir = total - rot
+        return rot, mir
+    if mode == "rotation_only":
+        return total, 0
+    return 0, total
