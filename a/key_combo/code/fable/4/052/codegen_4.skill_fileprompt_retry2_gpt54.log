+    count = random.randint(1, min(3, len(cells)))
+    for rr, cc in random.sample(cells, count):
+        patch[rr, cc] = random.choice(marker_colors)
+    return patch
+
+
+def _rect_clear(rect: Rect, others: list[Rect], margin: int = 1) -> bool:
