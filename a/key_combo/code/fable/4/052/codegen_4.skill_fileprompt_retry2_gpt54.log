+
+        all_coords = []
+        for r0, c0, r1, c1 in rooms:
+            all_coords.extend([(r0, c0), (r1, c1)])
+        for path in corridors:
+            all_coords.extend(path)
+        min_r, min_c, max_r, max_c = _bbox(all_coords)
+        if max_r - min_r + 1 <= 18 and max_c - min_c + 1 <= 18:
+            return rooms, corridors
