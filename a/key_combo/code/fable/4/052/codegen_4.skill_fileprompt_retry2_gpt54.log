+            return idx
+    return -1
+
+
+def _build_group_layout(count: int, h: int, w: int) -> tuple[list[Rect], list[list[Coord]]]:
+    if count == 1:
+        return [(0, 0, h - 1, w - 1)], []
+
+    for _ in range(300):
