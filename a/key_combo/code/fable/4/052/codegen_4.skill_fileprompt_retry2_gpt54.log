+    if room_count == 3:
+        mode = random.choice(["all", "one_isolate"])
+
+    if mode == "all":
+        return [room_count]
+    if mode == "one_isolate":
+        sizes = [room_count - 1, 1]
+    elif mode == "two_groups":
+        first = random.randint(2, room_count - 2)
+        second = room_count - first
+        if second == 1:
+            sizes = [first - 1, 2, 1]
+        else:
+            sizes = [first, second]
