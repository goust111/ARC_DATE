+    if np.array_equal(out, grid):
+        return None
+    if out.shape != grid.shape:
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
