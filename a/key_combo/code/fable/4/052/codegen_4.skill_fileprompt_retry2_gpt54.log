+            patch = g[r0 : r1 + 1, c0 : c1 + 1]
+            for rr, cc in np.argwhere(patch != base):
+                rr = int(rr)
+                cc = int(cc)
+                value = int(patch[rr, cc])
+                assert int(merged[rr, cc]) in {base, value}
+                merged[rr, cc] = value
+        for room_idx in group:
+            r0, c0, r1, c1 = rooms[room_idx]["bbox"]
+            out[r0 : r1 + 1, c0 : c1 + 1] = merged
+
+    return out
