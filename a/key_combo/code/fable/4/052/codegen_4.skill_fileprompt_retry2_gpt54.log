+    sh, sw = sprite.shape
+    rows = list(range(border, h - sh - border + 1))
+    cols = list(range(border, w - sw - border + 1))
+    random.shuffle(rows)
+    random.shuffle(cols)
+    for top in rows:
+        for left in cols:
+            if _can_place(canvas, sprite, top, left, padding):
