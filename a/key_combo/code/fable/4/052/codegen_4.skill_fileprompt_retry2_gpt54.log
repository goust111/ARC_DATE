+        sc0 = c0 - min_c
+        sprite[sr0 : sr0 + patch.shape[0], sc0 : sc0 + patch.shape[1]] = patch
+    for path in corridors:
+        for r, c in path:
+            sprite[r - min_r, c - min_c] = corridor_color
