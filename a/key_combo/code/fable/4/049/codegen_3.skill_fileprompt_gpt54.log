+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+SPRITE_SHAPES = (
+    (
+        "00100",
+        "01110",
+        "11111",
+        "01010",
+        "00100",
+    ),
+    (
+        "00100",
+        "01110",
+        "11111",
+        "00110",
+        "00100",
+    ),
