+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+GREY = 5
+WHITE = 10
+MARKER_COLORS = {GREY, WHITE}
+LEGEND_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+LEGEND_LEN_RANGE = (4, 7)
+CONTENT_WIDTH_RANGE = (12, 24)
+MIN_REGION_SIDE = 3
+MAX_GENERATION_ATTEMPTS = 400
