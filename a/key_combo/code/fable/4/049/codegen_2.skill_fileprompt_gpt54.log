+def _adjacent(rect_a: tuple[int, int, int, int], rect_b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = rect_a
+    br0, bc0, br1, bc1 = rect_b
+    vertical_touch = ac1 == bc0 or bc1 == ac0
+    horizontal_overlap = max(ac0, bc0) < min(ac1, bc1)
