def _gen_add_distractor(h, w, centers, red_cells):
    candidates = [(r, c) for r in range(GEN_CENTER_MARGIN, h - GEN_CENTER_MARGIN) for c in range(GEN_CENTER_MARGIN, w - GEN_CENTER_MARGIN)]
