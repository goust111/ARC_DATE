def _gen_attempt() -> np.ndarray | None:
    template, fill_mask = _gen_template()
    out = np.zeros(GRID_SHAPE, dtype=int)

    try:
        source_origin, partial_origins = _gen_place_template_copies(out, template)
    except ValueError:
