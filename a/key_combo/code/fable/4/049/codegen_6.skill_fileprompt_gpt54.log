+                patch = np.array([[color, color]], dtype=int)
+            else:
+                patch = np.array([[color], [color]], dtype=int)
+        else:
+            patch = np.array([[color, 0], [color, color]], dtype=int)
+
+        ph, pw = patch.shape
+        candidates = [(r, c) for r in range(rows - ph + 1) for c in range(cols - pw + 1) if _can_place(reserved, r, c, ph, pw)]
