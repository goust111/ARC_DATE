+def _choose_layout(h: int, w: int, kind: str) -> tuple[set[int], set[int], tuple[int, int], tuple[int, int]] | None:
+    if kind == "row_row":
+        return _choose_row_row_layout(h, w)
+    if kind == "col_col":
+        return _choose_col_col_layout(h, w)
+    if kind == "row_col":
