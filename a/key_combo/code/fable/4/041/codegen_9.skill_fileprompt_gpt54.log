+    patch[-2, 0] = patch[-1, 0] = patch[-1, 1] = int(marker_color)
+    patch[-2, -1] = patch[-1, -2] = patch[-1, -1] = int(marker_color)
+    patch[1:-1, 1:-1] = interior
+    return patch
