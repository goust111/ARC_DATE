+    for h in range(2, min(7, target_h - 1) + 1):
+        for w in range(2, min(7, target_w - 1) + 1):
+            if (h, w) in used:
+                continue
+            if h * w >= target_area:
+                continue
+            if target_h % h == 0 and target_w % w == 0 and target_h // h == target_w // w:
+                continue
+            choices.append((h, w))
