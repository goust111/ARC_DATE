+        src_h = random.randint(2, 6)
+        src_w = random.randint(2, 6)
+        target_h = src_h * scale
+        target_w = src_w * scale
+        if target_h >= 6 and target_w >= 6 and target_h + 2 <= 22 and target_w + 2 <= 22:
