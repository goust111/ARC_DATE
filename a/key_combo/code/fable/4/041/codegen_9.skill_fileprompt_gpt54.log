+def _paste_patch(canvas: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    region = canvas[top : top + h, left : left + w]
+    mask = patch != 0
+    region[mask] = patch[mask]
