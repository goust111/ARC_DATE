    ((0, 1), (1, 0), (1, 1)): "BR",
}


def _corner_key(role: str, box: tuple[int, int, int, int]) -> tuple[int, int]:
    r0, c0, r1, c1 = box
    if role == "TL":
        return r0, c0
    if role == "TR":
