+import numpy as np
+
+
+_CORNER_ROLES = {
+    ((0, 0), (0, 1), (1, 0)): "TL",
+    ((0, 0), (0, 1), (1, 1)): "TR",
+    ((0, 0), (1, 0), (1, 1)): "BL",
+    ((0, 1), (1, 0), (1, 1)): "BR",
