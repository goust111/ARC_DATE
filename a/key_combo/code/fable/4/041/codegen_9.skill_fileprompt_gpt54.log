+        frontier: list[tuple[int, int]] = []
+        for r, c in cells:
+            for dr, dc in _DIR4:
+                nr, nc = int(r + dr), int(c + dc)
+                if 0 <= nr < free.shape[0] and 0 <= nc < free.shape[1] and free[nr, nc] and (nr, nc) not in used:
