+
+_DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+_NON_BG_COLORS = tuple(range(1, 10))
+_GEN_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _monochrome_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in _DIR4:
+                    nr, nc = int(rr + dr), int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _corner_anchor(role: str, box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if role == "TL":
+        return int(r0), int(c0)
+    if role == "TR":
+        return int(r0), int(c1)
+    if role == "BL":
+        return int(r1), int(c0)
+    return int(r1), int(c1)
+
+
+def _find_frames(grid: np.ndarray, bg: int) -> list[dict]:
