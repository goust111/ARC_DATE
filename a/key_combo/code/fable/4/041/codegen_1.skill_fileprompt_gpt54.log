                c = sc0
                while c + motif_w - 1 >= bc0:
                    paste(out, motif, sr0, c, transparent=bg, clip=True)
                    c -= motif_w
            else:
                c = sc0
                while c <= bc0:
                    paste(out, motif, sr0, c, transparent=bg, clip=True)
