        result = _gen_attempt()
        if result is not None:
            try:
                out = main(result)
            except Exception:
                continue
            # Verify the output is a 1xN array
            if out.ndim == 2 and out.shape[0] == 1:
                return result
    raise RuntimeError(f"Failed to generate valid input after {GENERATION_RETRIES} attempts")

