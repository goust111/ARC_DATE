BG = 0
OBJECT_SIZE = 4
OBJECT_GAP = 1
GRID_HEIGHT_RANGE = (18, 24)
GRID_WIDTH_RANGE = (16, 22)
# Object counts and colors.
FRAME_COUNT_RANGE = (2, 3)
SOLID_COUNT_RANGE = (2, 3)
PALETTE_COLORS = list(range(1, 10))
REQUIRED_SOLID_COLOR = 8
# Layout choices and retry budget.
