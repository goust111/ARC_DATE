+GEN_ATTEMPTS = 500
+GEN_MIN_LINES = 3
+GEN_MAX_LINES = 5
+GEN_MIN_SIDE = 8
+GEN_MAX_SIDE = 18
+GEN_MIN_RAW_DIAG = 4
+GEN_MIN_VISIBLE_PIXELS = 3
