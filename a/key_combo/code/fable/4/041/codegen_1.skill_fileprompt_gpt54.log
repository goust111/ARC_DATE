+    order: list[int] = []
+    remaining = set(lines)
+    while remaining:
+        zeroes = sorted(color for color in remaining if indegree[color] == 0)
+        assert len(zeroes) == 1
+        color = zeroes[0]
+        remaining.remove(color)
+        order.append(color)
+        for higher in edges[color]:
