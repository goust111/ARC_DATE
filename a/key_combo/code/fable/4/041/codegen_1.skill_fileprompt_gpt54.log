+                continue
+            if int(grid[r, c]) != int(bg):
+                continue
+            ok = True
+            for rr, cc in _neighbors4(int(r), int(c)):
+                if 0 <= rr < height and 0 <= cc < width and int(grid[rr, cc]) != int(bg):
+                    ok = False
