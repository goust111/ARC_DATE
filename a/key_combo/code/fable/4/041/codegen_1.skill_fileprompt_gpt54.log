+def _line_cells(shape: tuple[int, int], kind: str, value: int) -> frozenset[tuple[int, int]]:
+    height, width = map(int, shape)
+    if kind == "horizontal":
+        return frozenset((value, c) for c in range(width))
+    if kind == "vertical":
