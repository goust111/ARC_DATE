+    signatures: set[tuple[str, int]] = set()
+    for r, c in coords:
+        signatures.add(("horizontal", int(r)))
+        signatures.add(("vertical", int(c)))
+        signatures.add(("diag_down", int(r - c)))
+        signatures.add(("diag_up", int(r + c)))
+    return signatures
+
