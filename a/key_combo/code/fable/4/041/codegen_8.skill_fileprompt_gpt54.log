+        gaps: list[dict[str, int]] = []
+        ok = True
+        saw_long_segment = False
+        for idx, (is_fg, start, end) in enumerate(runs):
+            length = int(end - start)
+            if is_fg:
+                segment = vals[start:end]
+                if not _is_chain_run(segment):
