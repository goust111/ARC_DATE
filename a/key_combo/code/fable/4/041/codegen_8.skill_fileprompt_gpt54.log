+    def rec(pos: int) -> None:
+        if len(solutions) > 1:
+            return
+        if pos == len(order):
+            solutions.add(tuple(fill for fill in fills if fill is not None))
+            return
+
+        gap_idx = order[pos]
+        choices = _choices_for_gap(gaps[gap_idx], counts)
+        assert choices
+        for cells, use in choices:
+            for piece, n in use.items():
+                counts[piece] -= n
+            fills[gap_idx] = cells
