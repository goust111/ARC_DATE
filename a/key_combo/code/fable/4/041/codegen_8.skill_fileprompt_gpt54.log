+def _find_strip(grid: np.ndarray, *, bg: int) -> tuple[int, int, int, list[dict[str, int]]]:
+    candidates: list[tuple[int, int, int, list[dict[str, int]]]] = []
+    h, _w = grid.shape
+    for r in range(h):
+        cols = np.flatnonzero(grid[r] != bg)
+        if len(cols) < 4:
+            continue
+        left = int(cols[0])
+        right = int(cols[-1])
+        vals = grid[r, left : right + 1]
