+        right = int(cols[-1])
+        vals = grid[r, left : right + 1]
+        if int(vals[0]) == bg or int(vals[-1]) == bg:
+            continue
+
+        runs: list[tuple[bool, int, int]] = []
+        i = 0
+        while i < len(vals):
+            j = i + 1
+            is_fg = int(vals[i]) != bg
+            while j < len(vals) and (int(vals[j]) != bg) == is_fg:
