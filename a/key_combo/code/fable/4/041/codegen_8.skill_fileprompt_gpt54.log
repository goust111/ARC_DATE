def _is_hollow_frame(patch: np.ndarray, bg: int, color: int) -> bool:
    h, w = patch.shape
    if h < 3 or w < 3:
        return False
    return (
        np.all(patch[0, :] == color)
        and np.all(patch[-1, :] == color)
        and np.all(patch[:, 0] == color)
        and np.all(patch[:, -1] == color)
        and np.all(patch[1:-1, 1:-1] == bg)
