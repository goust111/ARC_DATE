+    distractor_count = random.randint(1, 3)
+    scattered = missing_dominos + [distractor_type] * distractor_count
+    random.shuffle(scattered)
+
+    width = int(len(full_row))
+    min_h = max(10, len(scattered) + 4)
+    max_h = min(20, len(scattered) + 9)
