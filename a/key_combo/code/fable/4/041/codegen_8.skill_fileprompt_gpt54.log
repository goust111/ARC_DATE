+    touched_rows: set[int] = {strip_row}
+    for colors in dominos:
+        options: list[tuple[list[tuple[int, int]], tuple[int, int]]] = []
+        for orientation in ("h", "v"):
+            if orientation == "h":
+                for r in range(h):
