+    diag_pairs = [((0, 0), (1, 1)), ((0, 1), (1, 0))]
+    for a, b in diag_pairs:
+        if a in visible and b in visible:
+            assert np.array_equal(_rot180(quads[a]), quads[b]), "diagonal point symmetry broken"
+
