    out = g.copy()
    out[g == BLUE] = bg
    rr, cc = np.indices(g.shape)

    for top, left, bottom, right in frames:
        height = bottom - top + 1
        width = right - left + 1
        assert height != width

        in_frame = (top <= rr) & (rr <= bottom) & (left <= cc) & (cc <= right)
        blue_coords = np.argwhere((g == BLUE) & in_frame)
