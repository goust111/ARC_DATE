+    for sq in squares:
+        r0, c0 = sq["top_left"]
+        assert feasible[r0, c0]
+        comp_id = int(labels[r0, c0])
+        info = infos[comp_id]
+        score = int(info["scores"][r0, c0])
+        enriched.append(
+            {
+                **sq,
+                "comp_id": comp_id,
+                "score": score,
+                "comp_size": int(info["size"]),
+            }
+        )
