+
+
+def _render_input(
+    h: int,
+    w: int,
+    marker_mask: np.ndarray,
+    source: tuple[int, int],
+    target: tuple[int, int],
+    stop: tuple[int, int],
+    n: int,
+    mover_color: int,
+    target_color: int,
