+    next_id = 0
+    for r in range(h):
+        for c in range(w):
+            if not feasible[r, c] or int(labels[r, c]) >= 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = next_id
+            nodes = []
+            while q:
