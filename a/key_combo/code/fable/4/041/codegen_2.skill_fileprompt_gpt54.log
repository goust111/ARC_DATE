+        else:
+            other_targets = []
+            for other_id, other_info in enumerate(infos):
+                if other_id == comp_id or int(other_info["size"]) < 2:
+                    continue
+                for node in other_info["nodes"]:
+                    if int(other_info["scores"][node]) >= 1:
