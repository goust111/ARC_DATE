+
+
+def _pick_positions(marker_mask: np.ndarray, n: int, want_reachable: bool) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]] | None:
+    feasible, labels, infos = _analyze_mask(marker_mask, n)
