+
+def _farthest_node(dist: np.ndarray, nodes: list[tuple[int, int]]) -> tuple[int, int]:
+    return min(nodes, key=lambda rc: (-int(dist[rc]), rc[0], rc[1]))
+
+
+def _component_info(feasible: np.ndarray, nodes: list[tuple[int, int]]) -> dict:
