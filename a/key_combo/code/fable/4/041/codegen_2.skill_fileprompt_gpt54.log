from collections import deque
import numpy as np

def comps(markers,n,H=12,W=12):
    mask=np.zeros((H,W),dtype=bool)
    for r,c in markers:
        mask[max(0,r-1):min(H,r+2),max(0,c-1):min(W,c+2)] = True
    h2,w2=H-n+1,W-n+1
    feas=np.zeros((h2,w2),dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feas[r:r+1,c:c+1]=mask[r:r+n,c:c+n].all()
    seen=set(); comps=[]
    for r in range(h2):
      for c in range(w2):
        if not feas[r,c] or (r,c) in seen: continue
        q=deque([(r,c)]); seen.add((r,c)); cur=[]
        while q:
          x,y=q.popleft(); cur.append((x,y))
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<h2 and 0<=ny<w2 and feas[nx,ny] and (nx,ny) not in seen:
              seen.add((nx,ny)); q.append((nx,ny))
        comps.append(cur)
