+def _step_choices() -> list[tuple[int, int, str]]:
+    out = []
+    for delta in (2, 3):
+        out.extend(((delta, 0, "card"), (-delta, 0, "card"), (0, delta, "card"), (0, -delta, "card")))
+    for dr in (-2, 2):
+        for dc in (-2, 2):
+            out.append((dr, dc, "diag"))
+    return out
