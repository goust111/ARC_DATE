+        r0, c0, r1, c1 = comp["bbox"]
+        n = r1 - r0 + 1
+        if n < 2 or n != c1 - c0 + 1 or int(comp["area"]) != n * n:
+            continue
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if bool((patch == int(comp["color"])).all()):
