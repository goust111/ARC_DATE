+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+MARKER = 5
+MOVER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 600
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _components_by_color(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == int(bg):
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(cells)),
+                }
+            )
+    return comps
+
+
+def _find_squares(grid: np.ndarray, bg: int) -> list[dict]:
+    candidates = []
+    for comp in _components_by_color(grid, bg):
+        r0, c0, r1, c1 = comp["bbox"]
+        n = r1 - r0 + 1
+        if n < 2 or n != c1 - c0 + 1 or int(comp["area"]) != n * n:
+            continue
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if bool((patch == int(comp["color"])).all()):
+            candidates.append(
+                {
+                    "color": int(comp["color"]),
