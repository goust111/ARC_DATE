+    marker_mask = g == MARKER
+    halo = _halo_from_markers(marker_mask)
+    feasible = _feasible_positions(halo, n)
+    labels, comps = _components_of_feasible(feasible)
+    infos = [_component_info(feasible, nodes) for nodes in comps]
