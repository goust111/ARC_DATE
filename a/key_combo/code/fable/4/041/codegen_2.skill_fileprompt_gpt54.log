+    dist0 = _bfs_dist(feasible, a0)
+    a = _farthest_node(dist0, nodes)
+    dist_a = _bfs_dist(feasible, a)
+    b = _farthest_node(dist_a, nodes)
+    dist_b = _bfs_dist(feasible, b)
+    scores = np.minimum(dist_a, dist_b)
+    return {
+        "nodes": nodes,
+        "a": a,
+        "b": b,
