+def _remove_markers(mask: np.ndarray, boxes: list[tuple[int, int, int]]) -> np.ndarray:
+    out = mask.copy()
+    for r0, c0, n in boxes:
+        out[r0 : r0 + n, c0 : c0 + n] = False
+    return out
