+
+    marker_count = int((grid == MARKER).sum())
+    if marker_count < 5:
+        return None
+    if np.array_equal(grid, solved["output"]):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

