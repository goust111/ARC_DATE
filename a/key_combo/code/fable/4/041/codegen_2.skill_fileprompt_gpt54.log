+                                abs(node[0] - farthest[0]) + abs(node[1] - farthest[1]),
+                                _marker_coverage(marker_mask, node, n),
+                                node,
+                            )
+                        )
+            if other_targets:
+                other_targets.sort()
+                return source, other_targets[0][2], farthest
+    return None
+
+
+def _render_input(
+    h: int,
+    w: int,
+    marker_mask: np.ndarray,
+    source: tuple[int, int],
+    target: tuple[int, int],
+    stop: tuple[int, int],
+    n: int,
+    mover_color: int,
+    target_color: int,
+) -> np.ndarray:
