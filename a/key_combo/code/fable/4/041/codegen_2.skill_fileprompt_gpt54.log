+                if last_vec is not None and (dr, dc) == (-last_vec[0], -last_vec[1]):
+                    continue
+                ok = True
+                for idx, (rr, cc) in enumerate(path):
+                    cheb = max(abs(rr - nr), abs(cc - nc))
+                    if idx == len(path) - 1:
+                        continue
+                    if cheb <= 3:
+                        ok = False
+                        break
