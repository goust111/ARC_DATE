+    source_candidates = []
+    for comp_id, info in enumerate(infos):
+        if int(info["size"]) < 5:
+            continue
+        for endpoint in {tuple(info["a"]), tuple(info["b"])}:
+            src_dist = _bfs_dist(feasible, endpoint)
