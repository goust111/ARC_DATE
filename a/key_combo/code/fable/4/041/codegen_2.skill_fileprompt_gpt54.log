+def _attempt_generate() -> np.ndarray | None:
+    h = random.randint(18, 28)
+    w = random.randint(18, 28)
+    n = random.choice((2, 3))
+    want_reachable = random.random() < (0.7 if n == 2 else 0.5)
+
+    chain = _build_marker_chain(h, w)
+    if chain is None:
+        return None
+    marker_mask = np.zeros((h, w), dtype=bool)
+    for r, c in chain:
