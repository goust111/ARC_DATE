+                        seen[nr, nc] = True
+                        q.append((int(nr), int(nc)))
+            components.append(
+                {
+                    "coords": np.array(coords, dtype=int),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
