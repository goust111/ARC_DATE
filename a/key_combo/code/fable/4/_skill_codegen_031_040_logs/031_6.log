+        dimensions = _sample_dimensions(count)
+        colors = random.sample(FRAME_COLORS, count)
+
+        row_order = list(range(count))
+        random.shuffle(row_order)
+        # A nonzero cyclic shift is a derangement of the row order, ensuring that
