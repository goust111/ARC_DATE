+        objects: list[tuple[int, int, int, int, int]] = []
+        for index, color in enumerate(colors):
+            r0, r1 = row_spans[index]
+            c0, c1 = col_spans[index]
+            inp[r0 : r1 + 1, 0] = color
+            inp[0, c0 : c1 + 1] = color
