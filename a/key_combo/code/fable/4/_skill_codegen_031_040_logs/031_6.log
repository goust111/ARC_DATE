+    areas = [(r1 - r0 - 1) * (c1 - c0 - 1) for _, r0, c0, r1, c1 in objects]
+    heights = [r1 - r0 + 1 for _, r0, _c0, r1, _c1 in objects]
+    widths = [c1 - c0 + 1 for _, _r0, c0, _r1, c1 in objects]
+    if not (any(a % 2 for a in areas) and any(a % 2 == 0 for a in areas)):
