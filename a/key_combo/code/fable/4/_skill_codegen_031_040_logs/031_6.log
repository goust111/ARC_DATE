+        area += 1
+        for dr, dc in FOUR_NEIGHBORS:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < height and 0 <= cc < width and out[rr, cc] == BLACK:
+                out[rr, cc] = color
+                stack.append((rr, cc))
