+def _gen_attempt() -> np.ndarray | None:
+    n = random.choice([3, 4, 5])
+    separator_width = random.choice([1, 2])
+    max_cell_size = min(6, (30 - (n - 1) * separator_width) // n)
+    cell_height = random.randint(3, max_cell_size)
