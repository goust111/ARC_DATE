+    result_cells = {
+        tuple(map(int, rc))
+        for rc in np.argwhere((expected != BACKGROUND) & (expected != grid[bar_row, 0]))
+        if tuple(map(int, rc)) not in {(bar_row - k, 0) for k in range(1, len(palette) + 1)}
+    }
+    if source_cells <= result_cells or np.array_equal(grid, expected):
+        return False  # some old locations must visibly clear
+
+    # A full cycle is exercised, so every visible palette entry controls output.
+    moving_colors = set(int(x) for x in expected) - {BACKGROUND, int(grid[bar_row, 0])}
+    if not set(palette).issubset(moving_colors):
+        return False
+    return np.array_equal(main(grid), expected)
+
+
