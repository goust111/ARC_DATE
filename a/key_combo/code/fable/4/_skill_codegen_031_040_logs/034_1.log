+        below = int(np.sum(grid[bar_row + 1 :, c] == GREY))
+        for side, count in ((-1, above), (1, below)):
+            for layer in range(1, count + 1):
+                expected[bar_row + side * layer, c] = palette[(layer - 1) % len(palette)]
+    return expected
+
