+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, oracle-checked long-arm anchor puzzle input."""
+    for _ in range(500):
+        case = _gen_attempt()
+        if case is None:
+            continue
+        grid, expected, metadata = case
+        if _semantically_valid(grid, expected, metadata):
