+DIRECTIONS = ((-1, 0), (0, 1), (1, 0), (0, -1))
+CORNERS = ("tl", "tr", "bl", "br")
+
+
+def _map_from_corner(
+    corner: str, shape: tuple[int, int], r: int, c: int
+) -> tuple[int, int]:
+    """Map corner-local (r, c), whose origin is the corner, to grid coordinates."""
+    h, w = shape
+    if corner == "tl":
+        return r, c
+    if corner == "tr":
+        return r, w - 1 - c
+    if corner == "bl":
+        return h - 1 - r, c
+    if corner == "br":
