+
+    occupied_stamp_cells: set[tuple[int, int]] = set()
+    for obj in directed:
+        cr, cc = obj["center"]
+        dr, dc = obj["direction"]
+        stamp_center = (cr + side * dr, cc + side * dc)
+        top = stamp_center[0] - radius
+        left = stamp_center[1] - radius
+        assert 0 <= top and 0 <= left
+        assert top + side <= g.shape[0] and left + side <= g.shape[1]
+        stamp_cells = {
