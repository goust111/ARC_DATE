+    directed_colors = {obj["color"] for obj in directed}
+    if not all(obj["color"] in directed_colors for obj in meta["symmetric"]):
+        return False
+    if len({obj["stamp_center"] for obj in directed}) != len(directed):
+        return False
+
+    side = meta["side"]
+    for obj in directed:
