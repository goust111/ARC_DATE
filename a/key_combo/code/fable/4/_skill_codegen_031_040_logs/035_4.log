+def generate_input() -> np.ndarray:
+    """Generate varied, non-degenerate examples in all four motion directions."""
+    for _ in range(500):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid toll-queue puzzle")

