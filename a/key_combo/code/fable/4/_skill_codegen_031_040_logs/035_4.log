+        for c in range(width):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            seen[r, c] = True
+            stack = [(r, c)]
+            points: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                points.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.asarray(points, dtype=int)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(points),
+                }
+            )
+    return objects
+
+
+def _solid_rectangle(obj: dict) -> bool:
+    r0, c0, r1, c1 = obj["bbox"]
+    return int(obj["area"]) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _center(obj: dict, axis: int) -> int:
+    b = obj["bbox"]
+    lo, hi = (b[0], b[2]) if axis == 0 else (b[1], b[3])
+    assert (lo + hi) % 2 == 0, "all object centers must lie on grid cells"
+    return (lo + hi) // 2
