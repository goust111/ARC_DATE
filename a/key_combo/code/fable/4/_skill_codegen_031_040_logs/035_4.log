+        candidates = [i for i in range(1, len(events) + 1) if not (events[i - 1 : i + 1] == ["bar", "bar"])]
+        events.insert(random.choice(candidates), "block")
+    assert events.count("bar") == n_bars and events.count("block") == n_blocks
+    return events
