+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    """Inclusive (r0, c0, r1, c1) bbox using the arc_utils convention."""
+    lo = coords.min(axis=0)
+    hi = coords.max(axis=0)
+    return int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])
