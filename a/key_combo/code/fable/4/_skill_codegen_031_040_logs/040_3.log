+
+
+def _put_tile(grid: np.ndarray, pos: TilePos, tile: np.ndarray, size: int) -> None:
+    r0, c0 = _tile_origin(pos, size)
+    grid[r0 : r0 + size, c0 : c0 + size] = tile
+
+
