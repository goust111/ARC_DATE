+    if hr == int(r1) and 2 * hc == int(c0 + c1):
+        candidates.append(2)
+    if hc == int(c0) and 2 * hr == int(r0 + r1):
+        candidates.append(3)
+    assert len(candidates) == 1, "the head must uniquely identify one sprite side"
+    return candidates[0]
