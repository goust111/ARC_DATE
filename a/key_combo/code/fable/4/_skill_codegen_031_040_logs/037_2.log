/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path(\"/home/lixinyu/snap/a/key_combo/code/fable/4/037/2.py\")
mod = SourceFileLoader(\"new_arc_task\", str(p)).load_module()
sigs = set()
out_sigs = set()
ks = []
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f\"input grid exceeds 30x30: {inp.shape}\"
    assert out.ndim == 2 and max(out.shape) <= 30, f\"output grid exceeds 30x30: {out.shape}\"
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())

    d = inp.shape[1] // 2
    control = inp[:, d]
    vals, counts = np.unique(control, return_counts=True)
    marker = vals[counts == 1][0]
    k = int(np.flatnonzero(control == marker)[0])
    ks.append(k)
    left = inp[:, :d] == mod.MASK_COLOR
    right = inp[:, d + 1:] == mod.MASK_COLOR
    expected = mod._overlay(left, right, k)
    assert np.array_equal(out, expected)
    assert mod._semantically_valid(left, right, k)
    assert len({np.packbits(left | mod._shift_down(right, q)).tobytes() for q in range(inp.shape[0])}) == inp.shape[0]
    if k:
        assert not np.array_equal(out == mod.OUTPUT_COLOR, left | right)
        shifted = mod._shift_down(right, k)
        assert np.any(right[-k:] & ~left[-k:] & ~shifted[-k:])

print(\"variants\", len(sigs))
print(\"output_variants\", len(out_sigs))
print(\"k_zero\", ks.count(0), \"k_positive\", sum(k > 0 for k in ks), \"positive_values\", sorted(set(ks) - {0}))
assert len(sigs) >= 20
assert len(out_sigs) >= 20
assert ks.count(0) >= 33 and sum(k > 0 for k in ks) >= 66
