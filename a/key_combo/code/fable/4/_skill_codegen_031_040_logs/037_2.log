+    """Independent rule oracle used by both generation and validation."""
+    merged = left.astype(bool) | _shift_down(right.astype(bool), k)
+    out = np.full(left.shape, BACKGROUND, dtype=int)
+    out[merged] = OUTPUT_COLOR
+    return out
