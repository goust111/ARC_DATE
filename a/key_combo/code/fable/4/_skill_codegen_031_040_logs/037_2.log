+        grid = np.full((height, 2 * panel_width + 1), BACKGROUND, dtype=int)
+        grid[:, :panel_width][left] = MASK_COLOR
+        grid[:, panel_width] = divider_color
+        grid[k, panel_width] = marker_color
+        grid[:, panel_width + 1 :][right] = MASK_COLOR
+
