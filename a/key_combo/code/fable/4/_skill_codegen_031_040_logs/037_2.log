+    """Ensure the marker row, rather than a coincidental shortcut, selects the result."""
+    signatures = {
+        np.packbits(left | _shift_down(right, candidate)).tobytes()
+        for candidate in range(left.shape[0])
+    }
+    return len(signatures) == left.shape[0]
