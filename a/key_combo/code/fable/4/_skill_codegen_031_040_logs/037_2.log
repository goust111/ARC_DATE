+    control = g[:, divider_col]
+    right = g[:, divider_col + 1 :]
+    assert left.shape == right.shape
+    assert set(map(int, np.unique(left))) <= {BACKGROUND, MASK_COLOR}
+    assert set(map(int, np.unique(right))) <= {BACKGROUND, MASK_COLOR}
