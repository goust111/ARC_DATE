+
+def _shift_down(mask: np.ndarray, amount: int) -> np.ndarray:
+    """Translate a panel-local boolean mask downward, clipping at its bbox."""
+    k = int(amount)
+    assert mask.ndim == 2 and 0 <= k < mask.shape[0]
+    shifted = np.zeros_like(mask, dtype=bool)
+    if k == 0:
+        shifted[:] = mask
+    else:
+        shifted[k:, :] = mask[:-k, :]
+    return shifted
