+import numpy as np
+
+
+# The puzzle names these two visible ARC colors explicitly.
+MAROON = 9
+TEAL = 8
+INPUT_COLORS = tuple(range(8))
+MAX_GRID_SIZE = 30
+_generation_count = 0
