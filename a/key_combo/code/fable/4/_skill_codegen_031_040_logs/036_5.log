实现已写入目标路径。当前版本的求解逻辑不依赖外部导入，因而可被 `SourceFileLoader` 独立加载；生成器还专门加入了“大于配对区域”和“小于配对区域”的干扰项，排除了按面积取对象的捷径。现在开始运行指定 100 次验证，并额外统计顺/逆时针、阅读顺序朝向和输出多样性。
exec
/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/4/036/5.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
out_sigs = set()
turns = {1: 0, 3: 0}
shapes = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    _, _, k = mod._solve_details(inp)
    turns[k] += 1
    shapes.add(out.shape)
print('variants', len(sigs))
print('output_variants', len(out_sigs), 'turns', turns, 'output_shapes', sorted(shapes))
assert len(sigs) >= 20
assert len(out_sigs) >= 20
assert all(turns[k] >= 20 for k in turns)
assert len(shapes) >= 6
