+    for _ in range(rng.randint(0, 2)):
+        options = [
+            (a, b)
+            for a in range(2, 9)
+            for b in range(2, 9)
+            if not _shape_conflicts((a, b), shapes)
+        ]
+        if not options:
+            break
+        shapes.append(rng.choice(options))
+    return shapes
