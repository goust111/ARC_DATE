+TEAL = 8
+INPUT_COLORS = tuple(range(8))
+MAX_GRID_SIZE = 30
+_generation_count = 0
+
+
+def _background(grid: np.ndarray) -> int:
+    """Return the most frequent color, following arc_utils.get_bg."""
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
