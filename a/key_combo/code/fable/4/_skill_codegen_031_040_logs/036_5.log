+        if a * b > pair_area and not _shape_conflicts((a, b), shapes)
+    ]
+    rng.shuffle(large_options)
+    if not large_options:
+        return None
+    shapes.append(large_options[0])
+
+    for _ in range(rng.randint(0, 2)):
+        options = [
