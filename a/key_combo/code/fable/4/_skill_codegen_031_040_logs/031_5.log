+    colors = [color_a if i % 2 == 0 else color_b for i in range(4)]
+
+    full_span = sum(base_w * scale for scale in scales) + 3 * normal_gap
+    width = random.randint(max(26, full_span + 2), 30)
+    height = random.randint(20, 28)
