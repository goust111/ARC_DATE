+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    """Return 4-connected foreground components with inclusive bounding boxes."""
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
