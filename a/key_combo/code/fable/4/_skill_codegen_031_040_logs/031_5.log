        for lane_i in lane_order:
            if sums[lane_i] + heights[idx] > capacity:
                continue
            if not lanes[lane_i]:
                empty_before = sum(1 for lane in lanes if not lane)
                items_left = len(order) - pos
                if empty_before > items_left:
