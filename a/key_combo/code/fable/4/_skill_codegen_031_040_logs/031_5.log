import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_h, colors_present, crop_bbox, draw_line, find_components, object_neighbors, paste, random_free_location, random_sprite, scale_sprite

# concepts:
# scaling, puzzle pieces, indicator pixels

# description:
# In the input you will see objects with exactly 2 colors, each with one pixel/rectangle of a different color as an indicator. The indicator color is the same across objects.
# To make the output, one of those objects is a template shape that you are going to translate/recolor/rescale to match indicators with each other object.
# Place the rescaled template on top of the other shape so that the indicators are at the same position, and change color to match what you are placing on top of.

def main(input_grid):
    """
    Complete each partial object by scaling and recoloring the largest template so its indicator aligns with the partial indicator.

    Input structure:
    - The grid contains several two-color objects on a black background.
    - One indicator color appears in every object.
    - One object is the full template; the others are partial scaled objects with their own colors.

    Rule:
    - Find the common indicator color across all objects.
    - Choose the template by largest object size normalized by indicator size.
    - Scale and recolor the template for each other object, then paste it with indicators aligned.

    Key insight:
    - The indicator region supplies both correspondence and scale, while the template supplies
      the missing shape around each partial object.
    """
    # Plan:
    # 1. Parse the input into template object and other objects, and determine the indicator color
    # 2. For each other object, rescale+recolor the template to match indicators

    # 1. Parse the input

    # Extract all the objects from the input grid
    background = Color.BLACK
    objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=False, return_format="objects")

    # The indicator pixel's color appears in all the objects
    possible_indicator_colors = [ color for color in Color.ALL_COLORS
                                 if all( color in colors_present(obj, exclude={ background }) for obj in objects)]
    assert len(possible_indicator_colors) == 1, "There should be exactly one indicator color"
    indicator_color = possible_indicator_colors[0]

    # Find the template object, which is the biggest object after you scale the indicator down to have size 1x1
    object_sizes = [ np.sum(obj != background) for obj in objects]
    indicator_sizes = [ np.sum(obj == indicator_color) for obj in objects]
    rescaled_sizes = [size // indicator_size for size, indicator_size in zip(object_sizes, indicator_sizes)]
    template_index = np.argmax(rescaled_sizes)
    template_object = objects[template_index]
    other_objects = [obj for i, obj in enumerate(objects) if i != template_index]

    _b = bbox(template_object != background)
    assert _b is not None
    template_sprite = crop_bbox(template_object, _b)

    # 2. For each other object, rescale+recolor the template to match indicators
    # Determine the scaling factor by the ratio of the size of the indicator pixel region
    # Determine the color according to the non-indicator color of the object
    # Determine the position so that indicator pixels are overlaid

    # To produce the output we draw on top of the input
    output_grid = input_grid.copy()

    for other_object in other_objects:

        # Find the new shape's color
        new_color = [ color for color in colors_present(other_object, exclude={ background }) if color != indicator_color][0]

        # find the new scale, which is the ratio of the size of the indicator pixel in the original shape to the size of the indicator pixel in the new shape
        b_other = bbox(other_object == indicator_color)
        b_template = bbox(template_object == indicator_color)
        assert b_other is not None and b_template is not None
        new_scale = bbox_h(b_other) // bbox_h(b_template)

        # Scale the original template to the same scale...
        template_sprite_scaled = scale_sprite(template_sprite, new_scale)
        # ...and change its color to the new shape's color
        template_sprite_scaled[(template_sprite_scaled != background) & (template_sprite_scaled != indicator_color)] = new_color

        # Overlay the indicator pixels from the scaled/recolored template sprite with the indicator pixels from the other object
        r = np.min(np.argwhere(other_object == indicator_color)[:,0]) - np.min(np.argwhere(template_sprite_scaled == indicator_color)[:,0])
        c = np.min(np.argwhere(other_object == indicator_color)[:,1]) - np.min(np.argwhere(template_sprite_scaled == indicator_color)[:,1])
        paste(output_grid, template_sprite_scaled, r, c, transparent=Color.BLACK, clip=True)
        
    return output_grid

def generate_input():
    # Generate the background grid
    background = Color.BLACK
    width, height = np.random.randint(15, 30), np.random.randint(15, 30)
    grid = np.full((width, height), background)

    # Randomly select the color of objects and indicator, which should all be distinct
    n_objects = 2
    colors = np.random.choice(Color.NOT_BLACK, n_objects + 1, replace=False)
    indicator_color, template_color, other_colors = colors[0], colors[1], colors[2:]

    # Ensure the shapes after completion do not overlap by having a canvas that shows what things will look like after producing the output
    output_grid = grid.copy()    

    # Generate the original shape
    w, h = np.random.randint(3, 5), np.random.randint(3, 5)
    template_sprite = random_sprite(w, h, color_palette=[template_color], connectivity=4)

    # Randomly turn one pixel into the indicator pixel
    indicator_pixel = random.choice(np.argwhere(template_sprite == template_color))
    template_sprite[indicator_pixel[0], indicator_pixel[1]] = indicator_color

    # Place the template on the grid, and on the predicted output
    r, c = random_free_location(output_grid, template_sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
    paste(grid, template_sprite, r, c, transparent=Color.BLACK, clip=True)
    paste(output_grid, template_sprite, r, c, transparent=Color.BLACK, clip=True)

    # Check which pixels are neighbors of the indicator pixel, which will be included in the other objects
    neighbor_mask = (template_sprite == template_color) & object_neighbors(template_sprite == indicator_color, connectivity=8)
    
    # Place the other objects
    for other_color in other_colors:
        # there is the completed other object which will be in the output, and the uncompleted other object which will be in the input
        complete_other_object = template_sprite.copy()
        complete_other_object[complete_other_object == template_color] = other_color

        # Make the incomplete object, which just has the indicator pixel plus one of its neighbors
        incomplete_other_object = template_sprite.copy()
        incomplete_other_object[incomplete_other_object == template_color] = background        
        neighbor_r, neighbor_c = random.choice(np.argwhere(neighbor_mask))
        incomplete_other_object[neighbor_r, neighbor_c] = other_color

        # Rescale both
        scale = np.random.randint(1, 3)
        complete_other_object = scale_sprite(complete_other_object, scale)
        incomplete_other_object = scale_sprite(incomplete_other_object, scale)

        # Place the complete object on the predicted output
        try:
            r, c = random_free_location(output_grid, complete_other_object, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
        except ValueError:
            break
        paste(output_grid, complete_other_object, r, c, transparent=Color.BLACK, clip=True)

        # place the incomplete object such that its indicators overlap at the same location
        r -= np.min(np.argwhere(complete_other_object == indicator_color)[:,0]) - np.min(np.argwhere(incomplete_other_object == indicator_color)[:,0])
        c -= np.min(np.argwhere(complete_other_object == indicator_color)[:,1]) - np.min(np.argwhere(incomplete_other_object == indicator_color)[:,1])
        paste(grid, incomplete_other_object, r, c, transparent=Color.BLACK, clip=True)

    return grid
import numpy as np

from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, paste, random_free_location
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the empty interior of each colored rectangular frame, using grey for a one-pixel interior and orange for a larger interior.

    Input structure:
    - The background is the dominant color.
    - Every foreground object is a monochrome one-cell-thick rectangular frame.
    - Each frame has a background-colored rectangular interior.

    Rule:
    - Preserve the frame pixels.
    - Fill a frame's interior with grey when the interior has exactly one pixel.
    - Fill a frame's interior with orange when the interior has more than one pixel.

    Key insight:
    - The output color is determined by the size of the enclosed background region, not by the frame color.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert objects, "expected at least one foreground frame"

    out = g.copy()
    for obj in objects:
        color = int(obj["color"])
        r0, c0, r1, c1 = obj["bbox"]
        height = bbox_h(obj["bbox"])
        width = bbox_w(obj["bbox"])
        assert height >= 3 and width >= 3, "frames must enclose a nonempty interior"

        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        border = np.zeros((height, width), dtype=bool)
        border[0, :] = True
        border[-1, :] = True
        border[:, 0] = True
        border[:, -1] = True

        assert np.all(patch[border] == color), "expected a solid monochrome frame border"
        assert np.all(patch[~border] == bg), "expected an empty frame interior"
        interior_area = int((~border).sum())
        assert interior_area >= 1, "expected a nonempty interior"

        fill = Color.GREY if interior_area == 1 else Color.ORANGE
        out[r0 + 1 : r1, c0 + 1 : c1] = fill

    return out

# --------------- generator (o5x) ---------------

# Canvas and frame sampling.
_GEN_BACKGROUND = Color.BLACK
_GEN_ROWS_RANGE, _GEN_COLS_RANGE = (6, 16), (6, 13)
_GEN_FRAME_COUNT_RANGE, _GEN_FRAME_SIZES = (1, 5), ((3, 3), (3, 4), (4, 3))
_GEN_FRAME_COLORS = (1, 2, 3, 4, 6, 8, 9)

# Placement, fill, and retry controls.
_GEN_FRAME_BORDER = 1
_GEN_FRAME_PADDING, _GEN_PADDING_CONNECTIVITY = 1, 8
_GEN_MAX_ATTEMPTS, _GEN_SINGLE_FILL, _GEN_MULTI_FILL = 300, Color.GREY, Color.ORANGE

def _gen_frame_patch(height: int, width: int, color: int) -> np.ndarray:
    """Render a black-interior rectangular frame patch."""
    patch = np.full((height, width), _GEN_BACKGROUND, dtype=int)
    patch[0, :] = color
    patch[-1, :] = color
    patch[:, 0] = color
    patch[:, -1] = color
    return patch

def _sample_frames() -> list[tuple[int, int, int]]:
    """Sample frame dimensions/colors and shuffle placement order."""
    frame_count = random.randint(*_GEN_FRAME_COUNT_RANGE)
    frames = [
        (*random.choice(_GEN_FRAME_SIZES), random.choice(_GEN_FRAME_COLORS))
        for _ in range(frame_count)
    ]
    random.shuffle(frames)
    return frames

def _paste_frame(grid: np.ndarray, expected: np.ndarray, frame: tuple[int, int, int]) -> bool:
    """Paste one frame into both grids; return False if no legal slot exists."""
    height, width, color = frame
    patch = _gen_frame_patch(height, width, color)
    try:
        r0, c0 = random_free_location(
            grid,
            patch,
            transparent=_GEN_BACKGROUND,
            padding=_GEN_FRAME_PADDING,
            padding_connectivity=_GEN_PADDING_CONNECTIVITY,
        )
    except ValueError:
        return False

    paste(grid, patch, r0, c0, transparent=_GEN_BACKGROUND)
    paste(expected, patch, r0, c0, transparent=_GEN_BACKGROUND)
    interior_area = (height - 2 * _GEN_FRAME_BORDER) * (width - 2 * _GEN_FRAME_BORDER)
    fill = _GEN_SINGLE_FILL if interior_area == 1 else _GEN_MULTI_FILL
    expected[
        r0 + _GEN_FRAME_BORDER : r0 + height - _GEN_FRAME_BORDER,
        c0 + _GEN_FRAME_BORDER : c0 + width - _GEN_FRAME_BORDER,
    ] = fill
    return True

def _has_strict_background_mode(grid: np.ndarray) -> bool:
    """Require black to outnumber every possible frame color."""
    return int(np.count_nonzero(grid == _GEN_BACKGROUND)) > max(
        int(np.count_nonzero(grid == color)) for color in _GEN_FRAME_COLORS
    )

def _gen_attempt() -> np.ndarray | None:
    rows, cols = random.randint(*_GEN_ROWS_RANGE), random.randint(*_GEN_COLS_RANGE)
    grid = np.full((rows, cols), _GEN_BACKGROUND, dtype=int)
    expected = grid.copy()

    for frame in _sample_frames():
        if not _paste_frame(grid, expected, frame):
            return None
    if not _has_strict_background_mode(grid):
        return None
    try:
        solved = main(grid)
    except Exception:
        return None
    if not np.array_equal(solved, expected):
        return None
    return grid

def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {_GEN_MAX_ATTEMPTS} attempts")
from collections import Counter

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Copy the marked sprite window into the marked empty window, aligned by the shared marker.

    Input structure
    - The dominant color is the outer background.
    - There are exactly two solid rectangular non-background windows.
    - Each window has one pixel of a shared marker color; only one window also
      contains the sprite color(s).

    Rule
    - The marker-only window gives the output size and fill color.
    - Translate every non-fill pixel from the sprite window so the source marker
      lands on the destination marker.

    Key insight
    The two equal marker pixels define the offset; the output is cropped to the
    marker-only window, not to the sprite window.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    windows = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert len(windows) == 2

    regions = []
    for window in windows:
        r0, c0, r1, c1 = window["bbox"]
        region = g[r0 : r1 + 1, c0 : c1 + 1]
        assert int(window["area"]) == int(region.size)
        regions.append(region)

    colors = colors_present(g, exclude={bg})
    counts = Counter(map(int, g.ravel()))

    marker_candidates = [
        color
        for color in colors
        if counts[color] == len(regions)
        and all(np.count_nonzero(region == color) == 1 for region in regions)
    ]
    assert len(marker_candidates) == 1
    marker = marker_candidates[0]

    fill_candidates = [
        color
        for color in colors
        if color != marker and all(np.any(region == color) for region in regions)
    ]
    assert len(fill_candidates) == 1
    fill = fill_candidates[0]

    sprite_colors = [color for color in colors if color not in {fill, marker}]
    assert sprite_colors

    classified = []
    for region in regions:
        marker_coords = np.argwhere(region == marker)
        assert marker_coords.shape == (1, 2)
        has_sprite = any(np.any(region == color) for color in sprite_colors)
        classified.append((has_sprite, region, tuple(map(int, marker_coords[0]))))

    source = [item for item in classified if item[0]]
    destination = [item for item in classified if not item[0]]
    assert len(source) == 1
    assert len(destination) == 1

    _, src_region, src_marker = source[0]
    _, dst_region, dst_marker = destination[0]

    out = np.full(dst_region.shape, fill, dtype=int)
    dr = dst_marker[0] - src_marker[0]
    dc = dst_marker[1] - src_marker[1]

    for r, c in np.argwhere(src_region != fill):
        rr = int(r) + dr
        cc = int(c) + dc
        assert 0 <= rr < out.shape[0]
        assert 0 <= cc < out.shape[1]
        out[rr, cc] = src_region[r, c]

    return out

# --------------- generator (o5x) ---------------
# Fixed colors and draw palette.
BG_COLOR, FILL_COLOR = 8, 0
MARKER_AND_SPRITE_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]

# Sprite blob geometry.
SPRITE_PIXEL_RANGE = (7, 11)
BLOB_HEIGHT_OPTIONS, BLOB_WIDTH_OPTIONS = (3, 4), (3, 4, 5)
BLOB_MARKER_MARGIN = 1
FOUR_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))

# Source and destination window constraints.
SOURCE_HEIGHT_RANGE, SOURCE_WIDTH_RANGE = (4, 7), (5, 7)
SOURCE_DENSITY_RANGE = (0.19, 0.36)
DEST_SIZE_RANGE = (5, 9)

# Canvas placement and retry budget.
GRID_SIZE_RANGE = (18, 23)
WINDOW_BORDER, WINDOW_PADDING = 1, 1
GENERATION_ATTEMPTS = 300

def _gen_monotone_path(start, end):
    r, c = start
    er, ec = end
    moves = []
    moves.extend([(1 if er > r else -1, 0)] * abs(er - r))
    moves.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
    random.shuffle(moves)

    path = [(r, c)]
    for dr, dc in moves:
        r += dr
        c += dc
        path.append((r, c))
    return path

def _gen_spanning_component(height, width, total_cells):
    marker = (
        random.randrange(BLOB_MARKER_MARGIN, height - BLOB_MARKER_MARGIN),
        random.randrange(BLOB_MARKER_MARGIN, width - BLOB_MARKER_MARGIN),
    )
    corner = random.choice([(0, 0), (0, width - 1), (height - 1, 0), (height - 1, width - 1)])
    opposite = (height - 1 - corner[0], width - 1 - corner[1])

    coords = set(_gen_monotone_path(corner, marker))
    coords.update(_gen_monotone_path(marker, opposite))

    while len(coords) < total_cells:
        frontier = []
        for r, c in coords:
            for dr, dc in FOUR_NEIGHBORS:
                nr = r + dr
                nc = c + dc
                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in coords:
                    frontier.append((nr, nc))
        if not frontier:
            return None
        coords.add(random.choice(frontier))

    return coords, marker

def _gen_pick_bbox(sprite_pixels):
    total_cells = sprite_pixels + 1
    choices = [
        (height, width)
        for height in BLOB_HEIGHT_OPTIONS
        for width in BLOB_WIDTH_OPTIONS
        if height + width - 1 <= total_cells <= height * width
    ]
    return random.choice(choices)

def _gen_pick_source_size(blob_height, blob_width, sprite_pixels):
    min_density, max_density = SOURCE_DENSITY_RANGE
    choices = []
    for height in range(max(SOURCE_HEIGHT_RANGE[0], blob_height), SOURCE_HEIGHT_RANGE[1] + 1):
        for width in range(max(SOURCE_WIDTH_RANGE[0], blob_width), SOURCE_WIDTH_RANGE[1] + 1):
            density = sprite_pixels / (height * width)
            if min_density <= density <= max_density:
                choices.append((height, width))
    if not choices:
        return None
    return random.choice(choices)

def _paint_aligned_sprite(canvas, sprite_coords, src_marker, dst_marker, marker_color, sprite_color):
    dr = dst_marker[0] - src_marker[0]
    dc = dst_marker[1] - src_marker[1]
    for r, c in sprite_coords:
        canvas[dr + r, dc + c] = sprite_color
    canvas[dst_marker] = marker_color

def _gen_sprite_blob():
    sprite_pixels = random.randint(*SPRITE_PIXEL_RANGE)
    blob_height, blob_width = _gen_pick_bbox(sprite_pixels)
    component = _gen_spanning_component(blob_height, blob_width, sprite_pixels + 1)
    if component is None:
        return None
    blob_coords, src_marker = component
    sprite_coords = [coord for coord in blob_coords if coord != src_marker]
    if len(sprite_coords) != sprite_pixels:
        return None
    return sprite_pixels, blob_height, blob_width, src_marker, sprite_coords

def _place_windows(source, dest):
    height = random.randint(*GRID_SIZE_RANGE)
    width = random.randint(*GRID_SIZE_RANGE)
    grid = np.full((height, width), BG_COLOR, dtype=int)
    windows = [source, dest]
    random.shuffle(windows)
    try:
        for window in windows:
            r0, c0 = random_free_location(grid, window, transparent=BG_COLOR, border=WINDOW_BORDER, padding=WINDOW_PADDING)
            paste(grid, window, r0, c0)
    except ValueError:
        return None
    return grid

def _gen_attempt():
    marker_color, sprite_color = random.sample(MARKER_AND_SPRITE_COLORS, 2)
    sprite = _gen_sprite_blob()
    if sprite is None:
        return None
    sprite_pixels, blob_height, blob_width, src_marker, sprite_coords = sprite

    source_size = _gen_pick_source_size(blob_height, blob_width, sprite_pixels)
    if source_size is None:
        return None
    source_height, source_width = source_size
    source_top = random.randint(0, source_height - blob_height)
    source_left = random.randint(0, source_width - blob_width)
    source = np.full((source_height, source_width), FILL_COLOR, dtype=int)
    source_marker = (source_top + src_marker[0], source_left + src_marker[1])
    _paint_aligned_sprite(source, sprite_coords, src_marker, source_marker, marker_color, sprite_color)

    top_extent = src_marker[0]
    bottom_extent = blob_height - 1 - src_marker[0]
    left_extent = src_marker[1]
    right_extent = blob_width - 1 - src_marker[1]
    dest_height = random.randint(max(DEST_SIZE_RANGE[0], blob_height), DEST_SIZE_RANGE[1])
    dest_width = random.randint(max(DEST_SIZE_RANGE[0], blob_width), DEST_SIZE_RANGE[1])
    dest_marker = (
        random.randint(top_extent, dest_height - 1 - bottom_extent),
        random.randint(left_extent, dest_width - 1 - right_extent),
    )

    expected = np.full((dest_height, dest_width), FILL_COLOR, dtype=int)
    _paint_aligned_sprite(expected, sprite_coords, src_marker, dest_marker, marker_color, sprite_color)
    dest = np.full((dest_height, dest_width), FILL_COLOR, dtype=int)
    dest[dest_marker] = marker_color

    grid = _place_windows(source, dest)
    if grid is None:
        return None
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid

