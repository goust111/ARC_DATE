+    shape: tuple[int, int], origin: tuple[int, int], direction: tuple[int, int]
+) -> list[tuple[int, int]]:
+    """Coordinates strictly beyond origin, ordered from near to far."""
+    height, width = shape
+    r, c = origin
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    r += dr
+    c += dc
