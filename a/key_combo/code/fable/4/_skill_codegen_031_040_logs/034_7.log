+            for r, c in cells[segment_start : endpoint + 1]:
+                out[r, c] = color
+            segment_start = endpoint + 1
+
+        for r, c in cells[segment_start:]:
+            out[r, c] = BLACK
+
+    out[marker] = BLACK
+    return out
