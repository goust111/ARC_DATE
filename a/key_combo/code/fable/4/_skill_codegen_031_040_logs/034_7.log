+    height, width = shape
+    r, c = origin
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    r += dr
+    c += dc
+    while 0 <= r < height and 0 <= c < width:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
+
+
