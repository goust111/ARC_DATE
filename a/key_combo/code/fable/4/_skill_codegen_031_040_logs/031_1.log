from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import bbox_coords, colors_present, components_mask, get_bg
from scipy import ndimage


def _flood_from_bbox_side(border_set: set, bbox: tuple, side: str) -> set:
    """4-conn flood within bbox, seeded from non-border cells on the given bbox edge,
    stopping at border cells. Returns the set of reached cells (includes seeds)."""
    r0, c0, r1, c1 = bbox
    if side == "U":
        seeds = [(r0, c) for c in range(c0, c1 + 1) if (r0, c) not in border_set]
    elif side == "D":
        seeds = [(r1, c) for c in range(c0, c1 + 1) if (r1, c) not in border_set]
    elif side == "L":
        seeds = [(r, c0) for r in range(r0, r1 + 1) if (r, c0) not in border_set]
    else:  # "R"
        seeds = [(r, c1) for r in range(r0, r1 + 1) if (r, c1) not in border_set]

    visited = set(seeds)
    stack = list(seeds)
    while stack:
        r, c = stack.pop()
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if not (r0 <= nr <= r1 and c0 <= nc <= c1):
                continue
            if (nr, nc) in visited or (nr, nc) in border_set:
                continue
            visited.add((nr, nc))
            stack.append((nr, nc))
    return visited


def main(grid: np.ndarray) -> np.ndarray:
    """
    Eject content pixels from cup-shaped frames outward along each cup's tail direction.

    Input structure:
    - bg = background. Hollow cup/Y/funnel frames, each a unique border color.
    - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.
    - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.

    Rule:
    - For each cup, identify its tail spike and tail direction.
    - Erase all content pixels from the mouth interior.
    - Draw a straight line of content-colored pixels from the spike outward in the tail direction,
      one pixel per erased content pixel; cells beyond the grid edge are dropped.

    Key insight: The tail spike is the unique convergent point whose outward direction is opposite
    the mouth opening where the content lives.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))
    out = g.copy()

    DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
    OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}

    for border_col in colors_present(g, exclude={bg}):
        for border_coords in components_mask(g == int(border_col), connectivity=8):
            if border_coords.size == 0 or int(border_coords.shape[0]) < 5:
                continue

            r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))
            bbox = (r0, c0, r1, c1)
            border_set = {(int(r), int(c)) for r, c in border_coords}
            corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}

            # Candidate tail spikes: single border cell on a bbox edge, not at a corner.
            edges = (
                ("U", [p for p in border_set if p[0] == r0]),
                ("D", [p for p in border_set if p[0] == r1]),
                ("L", [p for p in border_set if p[1] == c0]),
                ("R", [p for p in border_set if p[1] == c1]),
            )
            candidates = [
                (d, cells[0]) for d, cells in edges
                if len(cells) == 1 and cells[0] not in corners
            ]
            if not candidates:
                continue

            # Each candidate: flood from opposite bbox side; keep candidates whose flood
            # reaches content (non-bg, non-border) cells.
            passing = []
            for d, spike in candidates:
                mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])
                cnt = Counter()
                for r, c in mouth:
                    v = int(g[r, c])
                    if v != bg and v != int(border_col):
                        cnt[v] += 1
                if not cnt:
                    continue
                content_col = int(cnt.most_common(1)[0][0])
                content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]
                passing.append((d, spike, content_col, content_cells))

            # Only act on cups with an unambiguous tail.
            if len(passing) != 1:
                continue
            tail_dir, spike, content_col, content_cells = passing[0]

            # Erase content, then eject outward.
            for r, c in content_cells:
                out[r, c] = bg

            dr, dc = DIR4[tail_dir]
            sr, sc = spike
            for t in range(1, len(content_cells) + 1):
                rr = sr + dr * t
                cc = sc + dc * t
                if not (0 <= rr < H and 0 <= cc < W):
                    break
                out[rr, cc] = content_col

    return out

# --------------- generator (claude opus) ---------------

# ==== Generator configuration ====
# Canvas size bounds (inclusive)
GRID_H_RANGE = (10, 13)
GRID_W_RANGE = (10, 13)

# Number of cups per grid (choices sampled uniformly)
NUM_CUPS_CHOICES = (1, 2, 3)

def _gen_attempt(rng: np.random.Generator, num_cups: int | None = None) -> np.ndarray | None:
    """Single end-to-end generation attempt. Returns a valid input grid or None on failure.

    Pipeline: sample canvas -> build/place each cup (committing borders and ejection lines to
    canvas_out) -> scatter content into canvas_in -> optionally add a stray pixel -> oracle
    check that main(canvas_in) == canvas_out.
    """
    if num_cups is None:
        num_cups = int(rng.choice(NUM_CUPS_CHOICES))
    H = int(rng.integers(GRID_H_RANGE[0], GRID_H_RANGE[1] + 1))
    W = int(rng.integers(GRID_W_RANGE[0], GRID_W_RANGE[1] + 1))
    canvas_out = np.zeros((H, W), dtype=int)
    canvas_in = np.zeros((H, W), dtype=int)

    palette = list(range(1, 10))
    rng.shuffle(palette)

    # occ_cup: union of placed cup bboxes (dilation applied at check time for 1-cell gap).
    # occ_path: union of ejection paths (must stay bg in the input).
    occ_cup = np.zeros((H, W), dtype=bool)
    occ_path = np.zeros((H, W), dtype=bool)

    cups_meta: list[dict] = []
    for _ in range(num_cups):
        if len(palette) < 2:
            return None
        border_color = int(palette.pop())
        content_color = int(palette.pop())
        # Return content_color to the pool so other cups may reuse it as border or content
        # (spec allows content colors to match other cups' border/content).
        palette.append(content_color)

        meta = _add_cup(
            rng, H, W, border_color, content_color, canvas_in, canvas_out, occ_cup, occ_path,
        )
        if meta is None:
            return None
        cups_meta.append(meta)

    if len(cups_meta) != num_cups:
        return None

    if not _scatter_content(rng, canvas_in, cups_meta):
        return None

    _try_place_stray(rng, canvas_in, canvas_out, cups_meta)

    try:
        produced = main(canvas_in)
    except Exception:
        return None
    if not np.array_equal(produced, canvas_out):
        return None
    return canvas_in


def generate_input() -> np.ndarray:
    rng = np.random.default_rng()
    # Pick intended num_cups once so retries don't skew toward 1-cup (the easiest case).
    num_cups = int(rng.choice(NUM_CUPS_CHOICES))
    for _ in range(GEN_RETRIES_PRIMARY):
        result = _gen_attempt(rng, num_cups=num_cups)
        if result is not None:
            return result
    # Fall back to any num_cups on exhaustion.
    for _ in range(GEN_RETRIES_FALLBACK):
        result = _gen_attempt(rng)
        if result is not None:
            return result
    raise RuntimeError(f"generate_input: failed after {GEN_RETRIES_PRIMARY + GEN_RETRIES_FALLBACK} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import bbox, get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Expand the top-left seed mask into a recursive colored pattern and tile it across the full grid.

    Input structure
    - The background is the dominant color.
    - All foreground lies in a top-left rectangle whose last row and last column are a solid secondary color.
    - Removing that secondary-color row and column leaves a seed region containing background plus one primary color.

    Rule
    - Use the primary-color pixels in the seed as a binary mask.
    - Replace each primary seed cell with a copy of the seed mask in the primary color, and each background seed cell
      with a copy of the seed mask in the secondary color.
    - Repeat and crop that expanded tile to the original grid shape.

    Key insight
    The solid L-shaped secondary-color border is a legend, not output content; it supplies the color used when the
    seed's background cells are expanded.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))

    fg_bbox = bbox(g != bg)
    assert fg_bbox is not None, "expected a top-left foreground legend"
    r0, c0, r1, c1 = fg_bbox
    assert r0 == 0 and c0 == 0, "foreground legend must be anchored at the top-left corner"

    legend_box = g[: r1 + 1, : c1 + 1]
    seed_h = legend_box.shape[0] - 1
    seed_w = legend_box.shape[1] - 1
    assert seed_h >= 1 and seed_w >= 1, "legend must contain a non-empty seed plus border"

    secondary_border = np.concatenate((legend_box[:seed_h, seed_w], legend_box[seed_h, :]))
    secondary_colors = np.unique(secondary_border)
    assert secondary_colors.size == 1, "expected one solid secondary-color border"
    secondary = int(secondary_colors[0])
    assert secondary != bg, "secondary border must be foreground"

    seed = legend_box[:seed_h, :seed_w]
    primary_colors = np.unique(seed[seed != bg])
    assert primary_colors.size == 1, "seed must contain exactly one primary foreground color"
    primary = int(primary_colors[0])
    assert primary != secondary, "primary and secondary colors must be distinct"
    assert np.all((seed == bg) | (seed == primary)), "seed may contain only background and primary colors"
    assert np.any(seed == bg), "seed must include background cells that expand to the secondary color"

    seed_mask = seed == primary
    H, W = g.shape
    rows = np.arange(H)[:, None]
    cols = np.arange(W)[None, :]

    inner_mask = seed_mask[rows % seed_h, cols % seed_w]
    meta_mask = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]

    out = np.full(g.shape, bg, dtype=int)
    out[inner_mask & meta_mask] = primary
    out[inner_mask & ~meta_mask] = secondary
    return out

# --------------- generator (att2, o5x) ---------------

# Color palette.
BACKGROUND_COLOR, PALETTE_COLORS = 7, tuple(range(10))
# Seed geometry.
SEED_SIZES = (2, 3)
SEED_DENSITY_MIN, SEED_DENSITY_MAX = 0.33, 0.67
# Canvas layout.
TILE_MULTIPLIERS, GRID_MIN, GRID_MAX = range(3, 6), 7, 16
REMAINDERS_BY_SQUARENESS = {False: (0,), True: (0, 1)}
# Retry budget.
MAX_GENERATION_ATTEMPTS = 300

def _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:
    """Render the two-level fractal that main() should produce."""
    seed_h, seed_w = seed_mask.shape
    H, W = shape
    rows = np.arange(H)[:, None]
    cols = np.arange(W)[None, :]

    inner = seed_mask[rows % seed_h, cols % seed_w]
    meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]

    out = np.full((H, W), bg, dtype=int)
    out[inner & meta] = primary
    out[inner & ~meta] = secondary
    return out

def _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:
    """Return valid canvas shapes for a sampled seed size."""
    options = []
    for k in TILE_MULTIPLIERS:
        for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:
            H = seed_h * k + rem
            W = seed_w * k + rem
            if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:
                options.append((H, W))
    return options

def _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:
    """Sample a nonempty, nonfull primary mask within density bounds."""
    area = seed_h * seed_w
    lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))
    hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))
    n_primary = random.randint(lo, hi)
    chosen = random.sample(range(area), n_primary)
    mask = np.zeros((seed_h, seed_w), dtype=bool)
    mask.reshape(-1)[chosen] = True
    return mask

def _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:
    """Render the top-left seed legend on a background canvas."""
    seed_h, seed_w = seed_mask.shape
    inp = np.full(shape, bg, dtype=int)
    inp[:seed_h, :seed_w][seed_mask] = primary
    inp[seed_h, : seed_w + 1] = secondary
    inp[:seed_h, seed_w] = secondary
    return inp

def _gen_attempt() -> np.ndarray | None:
    """Build one oracle-checked input grid, or None if validation fails."""
    bg = BACKGROUND_COLOR
    primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)

    seed_h = random.choice(SEED_SIZES)
    seed_w = random.choice(SEED_SIZES)
    H, W = random.choice(_layout_options(seed_h, seed_w))

    seed_mask = _random_seed_mask(seed_h, seed_w)
    inp = _render_input(seed_mask, (H, W), bg, primary, secondary)
    expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp

def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 58c02a16 input")
import numpy as np
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Build a 3x3 mosaic of whole-grid mirror reflections around the original tile.

    Input structure
    - The input is a 3x3 color grid; every cell belongs to the source tile.

    Rule
    - Produce a 9x9 grid split into nine 3x3 tile slots.
    - The center slot is the original tile.
    - Slots above or below the center reverse source rows.
    - Slots left or right of the center reverse source columns.
    - Corner slots reverse both rows and columns.

    Key insight
    The output is reflection wallpaper of the entire small grid, not per-pixel scaling or color-specific processing.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert g.shape == (3, 3), "expected the 3x3 source tile"

    rows = np.arange(g.shape[0])
    cols = np.arange(g.shape[1])
    row_order = np.concatenate((rows[::-1], rows, rows[::-1]))
    col_order = np.concatenate((cols[::-1], cols, cols[::-1]))
    return g[row_order[:, None], col_order[None, :]]

# --------------- generator (o5x) ---------------
# Color/tile sampling config.
TILE_SHAPE, TILE_CELLS = (3, 3), 9
COLOR_VALUES = range(1, 10)
PALETTE_SIZE_RANGE = (3, 4)
MAX_ATTEMPTS = 300
# Oracle reflection config.
REFLECTION_ORDER = np.array([2, 1, 0, 0, 1, 2, 2, 1, 0])

def _gen_expected_output(tile: np.ndarray) -> np.ndarray:
    return tile[REFLECTION_ORDER[:, None], REFLECTION_ORDER[None, :]]


def _gen_attempt() -> np.ndarray | None:
    palette_size = random.randint(*PALETTE_SIZE_RANGE)
    palette = random.sample(COLOR_VALUES, palette_size)

    cells = list(palette)
    cells.extend(random.choices(palette, k=TILE_CELLS - palette_size))
    random.shuffle(cells)

    return np.array(cells, dtype=int).reshape(TILE_SHAPE)


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        inp = _gen_attempt()
        if inp is None:
            continue
        out = _gen_expected_output(inp)
        if np.array_equal(main(inp), out):
            return inp
    raise RuntimeError("failed to generate a valid c48954c1 input")
import numpy as np
import random
from arc_utils import Color, draw_line, randomly_scatter_points


# concepts:
# line drawing, obstacle avoidance

# description:
# In the input you will see several red pixels on the bottom row of the grid, and some gray pixels scattered on the grid.
# To make the output grid, you should draw a red line upward from each red pixel, but avoiding the gray pixels.
# To avoid touching the gray pixels, go right to avoid them until you can go up again.

def main(input_grid):
    """
    Grow red paths upward from red starts while sidestepping gray obstacles to the right.

    Input structure:
    - The grid has red start pixels along the bottom row.
    - Gray pixels are scattered as obstacles away from the outer border.
    - All other cells are black background.

    Rule:
    - For each red start, attempt to move one cell upward at each step.
    - If the cell above is gray, draw one red step to the right instead.
    - Stop a path when it reaches the top or can no longer sidestep within the grid.

    Key insight:
    - Each path follows a simple local rule: upward progress is preferred, and gray
      blockers only cause rightward detours.
    """
    # The output grid is the same size as the input grid, and we are going to draw on top of the input, so we copy it
    output_grid = input_grid.copy()
    H, W = input_grid.shape

    # Red pixels are on the bottom row.
    starts = np.argwhere(input_grid[H - 1, :] == Color.RED).flatten()
    for c0 in starts:
        r = H - 1
        c = int(c0)
        # Draw upward; if blocked by GRAY above, sidestep right.
        while r > 0 and 0 <= c < W:
            if int(output_grid[r - 1, c]) == Color.GRAY:
                if c + 1 >= W:
                    break
                output_grid[r, c + 1] = Color.RED
                c += 1
            else:
                output_grid[r - 1, c] = Color.RED
                r -= 1

    return output_grid

def generate_input():
    # Generate the background grid with size of n x m.
    n, m = 10, 10
    grid = np.zeros((m, n), dtype=int)

    # Generate the red pixels on the bottom row.
    # Get 3 random positions for the red pixels.
    available_postion = range(1, 9)
    red_location = random.sample(available_postion, 3)

    # Draw the red pixels on the bottom row.
    for pos_r in red_location:
        grid[pos_r, -1] = Color.RED
    
    # Get the region except the bottom row, left most column and right most column.
    # Randomly scatter the gray pixels on the grid.
    randomly_scatter_points(grid[1:-1, 1:-1], color=Color.GRAY, density=0.1)
    
    return grid
