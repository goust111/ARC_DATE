+            _paint_object(grid, cap, cap_top, c, cap_color)
+            _paint_object(grid, cup, cup_top, c, cup_color)
+            specs.extend(
+                [
+                    {"mask": frame, "left": c, "color": frame_color, "out_top": 0},
+                    {"mask": cap, "left": c, "color": cap_color, "out_top": closed_h},
