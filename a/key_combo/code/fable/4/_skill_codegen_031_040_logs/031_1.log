+    h, w = mask.shape
+    unseen = set(map(tuple, np.argwhere(mask)))
+    result: list[np.ndarray] = []
+    while unseen:
+        seed = unseen.pop()
+        stack = [seed]
+        cells = [seed]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in _N4:
+                q = (r + dr, c + dc)
