+@dataclass
+class _Entity:
+    coords: np.ndarray
+    values: np.ndarray
+    members: frozenset[int]
+    closed: bool
+
+    def copy(self) -> "_Entity":
+        return _Entity(self.coords.copy(), self.values.copy(), self.members, self.closed)
