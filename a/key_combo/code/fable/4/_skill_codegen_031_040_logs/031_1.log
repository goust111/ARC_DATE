+    @property
+    def bbox(self) -> tuple[int, int, int, int]:
+        lo = self.coords.min(axis=0)
+        hi = self.coords.max(axis=0)
+        return int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])
