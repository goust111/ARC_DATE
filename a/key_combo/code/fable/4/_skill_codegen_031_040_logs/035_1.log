def _ring_projection(
    r: int,
    c: int,
    block_bbox: tuple[int, int, int, int],
) -> tuple[int, int]:
    r0, c0, r1, c1 = block_bbox

    if r < r0:
        nr = r0 - 1
    elif r > r1:
        nr = r1 + 1
    else:
        nr = r

    if c < c0:
        nc = c0 - 1
    elif c > c1:
        nc = c1 + 1
    else:
        nc = c

    return int(nr), int(nc)


