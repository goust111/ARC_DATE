+    for sq in ordered:
+        before = int(np.count_nonzero(out))
+        directions = (
+            (-1, 0, sq.r0 - 1),
+            (1, 0, sq.r1 + 1),
+            (0, -1, sq.c0 - 1),
+            (0, 1, sq.c1 + 1),
