  "src": "background pixels whose left and right neighbors are the same non-bg color, grouped by column, plus the unique non-bg marker color below each column",
  "transform": "fill each selected column top-to-bottom: each gap row's bar color applies from the previous breakpoint through that gap, and the lower marker color applies after the last gap; preserve all other pixels"
}
</annotation>
