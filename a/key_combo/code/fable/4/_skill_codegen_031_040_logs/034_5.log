+    wall_row_set = set(wall_rows)
+    wall_col_set = set(wall_cols)
+    seed_cells = [
+        (r, c)
+        for r in range(g.shape[0])
+        for c in range(g.shape[1])
+        if r not in wall_row_set and c not in wall_col_set and int(g[r, c]) != bg
