+    active: set[Room] = set()
+    for a, b, color, _gap in edges:
+        adjacency.setdefault(a, []).append((b, color))
+        adjacency.setdefault(b, []).append((a, color))
+        active.update((a, b))
+
+    assert root in active, "the seed room must belong to the door tree"
