+
+
+def _entry_color(
+    a: Room,
+    b: Room,
+    wall_rows: list[int],
+    wall_cols: list[int],
+    row_colors: dict[int, int],
+    col_colors: dict[int, int],
+) -> tuple[int, str]:
+    if a[0] != b[0]:
