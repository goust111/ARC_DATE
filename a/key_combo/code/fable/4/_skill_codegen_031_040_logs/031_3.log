+
+    frames: list[dict] = []
+    cups: list[dict] = []
+    pair_map: dict[Coord, Coord] = {}
+
+    for i in range(n_cups):
+        source_row = 3 + 8 * i
+        target_row = source_row + 4
+        cup_left = rng.choice((1, 2))
+        patch, spike_local, candidates = _right_facing_cup(border_colors[i])
