+        seed = unseen.pop()
+        comp = {seed}
+        stack = [seed]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in steps:
+                q = (r + dr, c + dc)
+                if q in unseen:
+                    unseen.remove(q)
+                    comp.add(q)
+                    stack.append(q)
