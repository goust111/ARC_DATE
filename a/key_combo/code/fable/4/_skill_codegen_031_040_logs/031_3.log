+"""ARC puzzle 3: portal-guided cup rays fill the first frame they hit."""
+
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+DIRS: dict[str, Coord] = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+
+
+def _background(grid: np.ndarray) -> int:
+    """Use the public ARC toolbox convention: background is the modal color."""
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: set[Coord]) -> BBox:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[set[Coord]]:
+    """Return coordinate sets using the toolbox's (row, column) convention."""
+    h, w = mask.shape
+    if connectivity == 4:
+        steps = ((-1, 0), (1, 0), (0, -1), (0, 1))
+    else:
+        steps = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr, dc) != (0, 0)
+        )
+
+    unseen = {(int(r), int(c)) for r, c in np.argwhere(mask)}
+    result: list[set[Coord]] = []
+    while unseen:
+        seed = unseen.pop()
+        comp = {seed}
+        stack = [seed]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in steps:
+                q = (r + dr, c + dc)
+                if q in unseen:
+                    unseen.remove(q)
+                    comp.add(q)
+                    stack.append(q)
+        result.append(comp)
+    return result
+
+
+def _rectangle_from_component(coords: set[Coord], color: int) -> dict | None:
+    if len(coords) < 8:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+    border = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    if coords != border:
+        return None
+    interior = {
+        (r, c)
+        for r in range(r0 + 1, r1)
+        for c in range(c0 + 1, c1)
+    }
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "border": border,
+        "interior": interior,
+    }
+
