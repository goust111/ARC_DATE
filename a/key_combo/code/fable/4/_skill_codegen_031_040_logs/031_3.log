+    portal_at: dict[Coord, Coord] = {}
+    for color in sorted(set(map(int, grid.ravel())) - {bg} - excluded_colors):
+        coords = [tuple(map(int, p)) for p in np.argwhere(grid == color)]
+        if len(coords) != 2:
