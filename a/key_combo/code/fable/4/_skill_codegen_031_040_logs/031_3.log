+    expected = inp.copy()
+    hit_ids: set[int] = set()
+    for cup in cups:
+        hit, used = _oracle_trace(inp.shape, cup["spike"], "R", pair_map, frames)
+        direct_hit, direct_used = _oracle_trace(inp.shape, cup["spike"], "R", {}, frames)
