+        "U": sorted(p for p in coords if p[0] == r0),
+        "D": sorted(p for p in coords if p[0] == r1),
+        "L": sorted(p for p in coords if p[1] == c0),
+        "R": sorted(p for p in coords if p[1] == c1),
