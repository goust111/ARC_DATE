+    border_owner = {p: i for i, frame in enumerate(frames) for p in frame["border"]}
+    h, w = shape
+    dr, dc = DIRS[direction]
+    r, c = spike
+    used: list[Coord] = []
+    seen: set[tuple[int, int]] = set()
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w) or (r, c) in seen:
+            return None, used
