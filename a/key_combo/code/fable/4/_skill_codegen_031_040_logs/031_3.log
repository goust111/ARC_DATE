+    if side == "U":
+        seeds = [(r0, c) for c in range(c0, c1 + 1)]
+    elif side == "D":
+        seeds = [(r1, c) for c in range(c0, c1 + 1)]
+    elif side == "L":
+        seeds = [(r, c0) for r in range(r0, r1 + 1)]
+    else:
+        seeds = [(r, c1) for r in range(r0, r1 + 1)]
+
+    seen = {p for p in seeds if p not in border}
+    queue = deque(seen)
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS.values():
+            q = (r + dr, c + dc)
+            if (
+                r0 <= q[0] <= r1
+                and c0 <= q[1] <= c1
+                and q not in border
+                and q not in seen
+            ):
+                seen.add(q)
+                queue.append(q)
+    return seen
+
