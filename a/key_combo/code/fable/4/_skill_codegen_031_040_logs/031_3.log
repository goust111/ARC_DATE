+def _cup_from_component(
+    grid: np.ndarray, coords: set[Coord], border_color: int, bg: int
+) -> dict | None:
+    """Recognize a cup by its unique one-pixel tail side and colored mouth."""
+    if len(coords) < 7:
+        return None
+    box = _bbox(coords)
+    r0, c0, r1, c1 = box
