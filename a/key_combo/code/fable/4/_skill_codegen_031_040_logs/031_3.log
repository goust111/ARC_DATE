+    h, w = shape
+    dr, dc = DIRS[direction]
+    r, c = spike
+    visited: set[tuple[int, int, str]] = set()
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        state = (r, c, direction)
+        if state in visited:
+            return None
+        visited.add(state)
+        if (r, c) in portal_at:
+            r, c = portal_at[(r, c)]
+            continue
+        if (r, c) in border_owner:
+            return int(border_owner[(r, c)])
