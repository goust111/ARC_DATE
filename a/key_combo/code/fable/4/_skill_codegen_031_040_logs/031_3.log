+        frames.append(decoy)
+
+        target = _draw_frame(inp, target_row - 1, 19, 3, target_width, frame_color)
+        target_id = len(frames)
+        frames.append(target)
+
+        far = _draw_frame(inp, target_row - 1, 25, 3, 3, frame_color)
+        far_id = len(frames)
+        frames.append(far)
+
+        cups.append(
+            {
+                "spike": spike,
+                "direction": "R",
+                "content": content_abs,
+                "content_color": content_colors[i],
+                "entry": entry,
+                "decoy_id": decoy_id,
+                "target_id": target_id,
+                "far_id": far_id,
+            }
+        )
