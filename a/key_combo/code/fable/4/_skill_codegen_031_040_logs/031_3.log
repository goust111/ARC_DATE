+    if side == "U":
+        seeds = [(r0, c) for c in range(c0, c1 + 1)]
+    elif side == "D":
+        seeds = [(r1, c) for c in range(c0, c1 + 1)]
+    elif side == "L":
+        seeds = [(r, c0) for r in range(r0, r1 + 1)]
+    else:
+        seeds = [(r, c1) for r in range(r0, r1 + 1)]
