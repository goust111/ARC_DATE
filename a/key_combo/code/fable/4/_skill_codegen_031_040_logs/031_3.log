+    if len(passing) != 1:
+        return None
+    direction, spike, content_color, content = passing[0]
+    return {
+        "border_color": int(border_color),
+        "border": coords,
+        "bbox": box,
+        "direction": direction,
+        "spike": spike,
+        "content_color": int(content_color),
+        "content": content,
+    }
