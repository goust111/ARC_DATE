+
+
+def _touches_existing(cells: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in cells:
+        if (r, c) in occupied:
+            return True
+        if any((nr, nc) in occupied for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))):
