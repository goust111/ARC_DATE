    return {
        "NW": (r0, c0),
        "NE": (r0, c1),
        "SW": (r1, c0),
        "SE": (r1, c1),
    }


def _outside_corner_coords(corners: dict[str, tuple[int, int]]) -> dict[str, tuple[int, int]]:
