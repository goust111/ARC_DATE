GEN_BG_COLOR = 8
GEN_PALETTE = (0, 2, 3, 4, 5, 6, 7, 9)

# Motif size, color count, and density bounds.
GEN_TILE_SIZE_MIN, GEN_TILE_SIZE_MAX = 3, 7
GEN_MOTIF_COLOR_MIN, GEN_MOTIF_COLOR_MAX = 2, 4
