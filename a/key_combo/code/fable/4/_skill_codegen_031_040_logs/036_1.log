SEED_RETRIES = 50            # retries for placing isolated seed cells
GEN_RETRIES = 300            # outer generate_input retry budget

# Precompute valid grid layouts: {N: [(rows, cols), ...]}
_LAYOUTS_BY_N: dict[int, list[tuple[int, int]]] = {}
