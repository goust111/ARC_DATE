+        todo = deque([(sr, sc)])
+        cells: list[Coord] = []
+        while todo:
+            r, c = todo.popleft()
+            cells.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
