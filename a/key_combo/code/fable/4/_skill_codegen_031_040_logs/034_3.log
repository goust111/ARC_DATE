+    bg = _background(g)
+    divider_color, divider_r, divider_c = _find_divider(g, bg)
+    legend = _legend_entries(g, bg, divider_r, divider_c)
+    queries = _query_entries(g, bg, divider_color, legend)
+    query_by_key = {item["key"]: item for item in queries}
