+_SHAPE_CATALOG = _catalog()
+
+
+def _is_chiral(shape: Shape) -> bool:
+    return bool(set(_variants(shape)) - set(_rotations(shape)))
+
+
+def _patch(shape: Shape, color: int, bg: int) -> np.ndarray:
