    return True


def _gen_top_up_rows(out, wall_rows, col_bands, target, wall_rows_set, wall_cols_set, row_counts, col_counts):
    for row_idx, r in enumerate(wall_rows):
        need = max(0, ROW_MARKER_MIN - row_counts[r])
