+        if color == bg:
+            continue
+        comps = _components(legend == color)
+        assert len(comps) == 1, "each legend color must form exactly one sprite"
+        coords = comps[0]
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        entries.append(
