+) -> list[tuple[int, int, int, int]]:
+    height, width = _shape_size(shape)
+    grid_h, grid_w = grid_shape
+    regions = (
+        (0, divider_r - 1, divider_c + 2, grid_w - 1),
+        (divider_r + 2, grid_h - 1, 0, grid_w - 1),
+    )
