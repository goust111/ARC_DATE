# Canvas and frame bounds.
GRID_SIDE_MIN, GRID_SIDE_MAX = 10, 20
FRAME_COUNT_MIN, FRAME_COUNT_MAX, FRAME_COUNT_MAX_AT_MIN_GRID = 2, 5, 4
FRAME_SIDE_MIN_ODD, FRAME_SIDE_MIN_EVEN, FRAME_SIDE_MAX = 3, 4, 10

# Layout spacing and weighting.
FRAME_GAP = 1
ROW_WEIGHT_FLOOR, ROW_WEIGHT_MARGIN, ROW_WEIGHT_POWER = 0.25, 2, 2
SIDE_WEIGHT_POWER, ROW_GROW_MIN_DIVISOR = 2, 2

# Final random orientation and retry budget.
ROTATION_TURNS_MIN, ROTATION_TURNS_MAX = 0, 3
FLIP_OPTIONS = (False, True)
GENERATION_RETRIES = 300

def _gen_frame_patch(side: int) -> np.ndarray:
    patch = np.zeros((side, side), dtype=int)
    patch[0, :] = Color.BLUE
    patch[-1, :] = Color.BLUE
    patch[:, 0] = Color.BLUE
    patch[:, -1] = Color.BLUE
    return patch

def _gen_expected_output(inp: np.ndarray, frames: list[tuple[int, int, int]]) -> np.ndarray:
    out = inp.copy()
    for r0, c0, side in frames:
        fill = Color.ORANGE if side % 2 else Color.RED
        out[r0 + 1 : r0 + side - 1, c0 + 1 : c0 + side - 1] = fill
    return out

def _gen_split_slack(extra: int, slots: int) -> list[int]:
    cuts = sorted(random.randint(0, extra) for _ in range(slots - 1))
    parts = []
    prev = 0
    for cut in cuts + [extra]:
        parts.append(cut - prev)
        prev = cut
    random.shuffle(parts)
    return parts

def _gen_weighted_choice(items: list[int], weights: list[float]) -> int:
    total = sum(weights)
    pick = random.random() * total
    upto = 0.0
    for item, weight in zip(items, weights):
        upto += weight
        if pick <= upto:
            return item
    return items[-1]

def _gen_min_side(parity: int) -> int:
    return FRAME_SIDE_MIN_EVEN if parity == 0 else FRAME_SIDE_MIN_ODD

def _gen_row_counts(n: int, k: int) -> list[int] | None:
    min_slot_span = FRAME_SIDE_MIN_ODD + FRAME_GAP
    max_per_row = (n + FRAME_GAP) // min_slot_span
    max_rows = min(k, (n + FRAME_GAP) // min_slot_span)
    feasible_rows = [r for r in range(1, max_rows + 1) if k <= r * max_per_row]
    if not feasible_rows:
        return None

    weights = []
    for rows in feasible_rows:
        max_frames_in_row = (k + rows - 1) // rows
        vertical_avg = (n - FRAME_GAP * (rows - 1)) / rows
        horizontal_avg = (n - FRAME_GAP * (max_frames_in_row - 1)) / max_frames_in_row
        weights.append(
            max(ROW_WEIGHT_FLOOR, min(vertical_avg, horizontal_avg) - ROW_WEIGHT_MARGIN) ** ROW_WEIGHT_POWER
        )

    row_count = _gen_weighted_choice(feasible_rows, weights)
    base = k // row_count
    extra = k % row_count
    counts = [base + 1] * extra + [base] * (row_count - extra)
    random.shuffle(counts)
    return counts

def _gen_choose_row_heights(n: int, row_parities: list[list[int]]) -> list[int] | None:
    row_mins = [max(_gen_min_side(parity) for parity in parities) for parities in row_parities]
    extra = n - FRAME_GAP * (len(row_mins) - 1) - sum(row_mins)
    if extra < 0:
        return None

    heights = row_mins[:]
    min_grow = (extra + ROW_GROW_MIN_DIVISOR - 1) // ROW_GROW_MIN_DIVISOR
    grow_budget = random.randint(min_grow, extra) if extra else 0
    while grow_budget:
        choices = [i for i, height in enumerate(heights) if height < FRAME_SIDE_MAX]
        if not choices:
            break
        row = random.choice(choices)
        heights[row] += 1
        grow_budget -= 1
    return heights

def _gen_choose_sides(n: int, height: int, parities: list[int]) -> list[int] | None:
    remaining = n - FRAME_GAP * (len(parities) - 1)
    sides = []
    for i, parity in enumerate(parities):
        min_side = _gen_min_side(parity)
        future_min = sum(_gen_min_side(p) for p in parities[i + 1 :])
        max_side = min(FRAME_SIDE_MAX, height, remaining - future_min)
        candidates = [side for side in range(min_side, max_side + 1) if side % 2 == parity]
        if not candidates:
            return None
        side = _gen_weighted_choice(candidates, [side**SIDE_WEIGHT_POWER for side in candidates])
        sides.append(side)
        remaining -= side
    random.shuffle(sides)
    return sides

def _gen_layout(n: int, k: int) -> tuple[list[int], list[list[int]]] | None:
    """Choose row heights and per-row frame parities without placing pixels."""
    parity_plan = [0, 1]
    parity_plan.extend(random.randint(0, 1) for _ in range(k - 2))
    random.shuffle(parity_plan)

    row_counts = _gen_row_counts(n, k)
    if row_counts is None:
        return None

    row_parities = []
    cursor = 0
    for count in row_counts:
        row_parities.append(parity_plan[cursor : cursor + count])
        cursor += count
    random.shuffle(row_parities)

    row_heights = _gen_choose_row_heights(n, row_parities)
    if row_heights is None:
        return None
    return row_heights, row_parities

def _gen_place_frames(
    n: int, row_heights: list[int], row_parities: list[list[int]]
) -> tuple[np.ndarray, list[tuple[int, int, int]]] | None:
    """Render non-overlapping square frames from the row layout."""
    inp = np.zeros((n, n), dtype=int)
    frames: list[tuple[int, int, int]] = []

    used_height = sum(row_heights) + FRAME_GAP * (len(row_heights) - 1)
    v_slack = _gen_split_slack(n - used_height, len(row_heights) + 1)
    r = v_slack[0]
    for row_i, (height, parities) in enumerate(zip(row_heights, row_parities)):
        sides = _gen_choose_sides(n, height, parities)
        if sides is None:
            return None

        used_width = sum(sides) + FRAME_GAP * (len(sides) - 1)
        h_slack = _gen_split_slack(n - used_width, len(sides) + 1)
        c = h_slack[0]
        for side_i, side in enumerate(sides):
            r0 = r + random.randint(0, height - side)
            paste(inp, _gen_frame_patch(side), r0, c, transparent=None)
            frames.append((r0, c, side))
            c += side + FRAME_GAP + h_slack[side_i + 1]
        r += height + FRAME_GAP + v_slack[row_i + 1]
    return inp, frames

def _gen_random_orientation(inp: np.ndarray, expected: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    turns = random.randint(ROTATION_TURNS_MIN, ROTATION_TURNS_MAX)
    if turns:
        inp = np.rot90(inp, turns)
        expected = np.rot90(expected, turns)
    if random.choice(FLIP_OPTIONS):
        inp = np.fliplr(inp)
        expected = np.fliplr(expected)
    return inp, expected

def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
    max_k = FRAME_COUNT_MAX_AT_MIN_GRID if n == GRID_SIDE_MIN else FRAME_COUNT_MAX
    k = random.randint(FRAME_COUNT_MIN, max_k)

    layout = _gen_layout(n, k)
    if layout is None:
        return None

    placed = _gen_place_frames(n, *layout)
    if placed is None:
        return None
    inp, frames = placed
    expected = _gen_expected_output(inp, frames)
    inp, expected = _gen_random_orientation(inp, expected)
    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp

def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


class _Object:
    def __init__(self, bbox: tuple[int, int, int, int], patch: np.ndarray, closed: bool):
        self.bbox = bbox
        self.patch = patch
        self.height = int(patch.shape[0])
        self.closed = bool(closed)


def _object_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    rel = coords - np.array([r0, c0])
    mask[rel[:, 0], rel[:, 1]] = True
    return mask


def _has_enclosed_hole(mask: np.ndarray) -> bool:
    h, w = mask.shape
    exterior = np.zeros_like(mask, dtype=bool)
    stack: list[tuple[int, int]] = []

    for r in range(h):
        for c in range(w):
            if (r in (0, h - 1) or c in (0, w - 1)) and not mask[r, c]:
                exterior[r, c] = True
                stack.append((r, c))

    while stack:
        r, c = stack.pop()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr = r + dr
            nc = c + dc
            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not exterior[nr, nc]:
                exterior[nr, nc] = True
                stack.append((nr, nc))

    return bool(np.any((~mask) & (~exterior)))


def _objects(g: np.ndarray, bg: int) -> list[_Object]:
    objects: list[_Object] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):
        color = int(comp["color"])
        bbox = tuple(map(int, comp["bbox"]))
        coords = comp["coords"]
        mask = _object_mask(coords, bbox)
        patch = np.full(mask.shape, bg, dtype=int)
        patch[mask] = color
        objects.append(_Object(bbox, patch, _has_enclosed_hole(mask)))

    assert objects, "expected at least one foreground object"
    return objects


def _can_place(out: np.ndarray, obj: _Object, row: int, bg: int) -> bool:
    _r0, c0, _r1, _c1 = obj.bbox
    h, w = obj.patch.shape
    mask = obj.patch != bg
    region = out[row : row + h, c0 : c0 + w]
    return bool(np.all(region[mask] == bg))


def _place(out: np.ndarray, obj: _Object, row: int, bg: int) -> None:
    _r0, c0, _r1, _c1 = obj.bbox
    paste(out, obj.patch, row, c0, transparent=bg)


def _slide_into_place(out: np.ndarray, obj: _Object, bg: int, upward: bool) -> None:
    H = out.shape[0]
    if upward:
        rows = range(0, H - obj.height + 1)
    else:
        rows = range(H - obj.height, -1, -1)

    for row in rows:
        if _can_place(out, obj, row, bg):
            _place(out, obj, row, bg)
            return

    raise AssertionError("expected a valid slide position")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide closed foreground objects upward and open foreground objects downward, keeping their columns and stacking on collision.

    Input structure
    - The grid has a single background color and several monochromatic 4-connected foreground objects.
    - Some objects are closed frames with at least one enclosed background hole inside their bounding box.
    - The remaining objects are open line-like sprites with no enclosed hole.

    Rule
    - Redraw every object on an empty background canvas without changing its color, shape, or horizontal position.
    - Closed frame objects slide vertically upward to the first non-colliding position.
    - Open objects slide vertically downward to the first non-colliding position.
    - Within each direction, preserve the original vertical order so overlapping columns stack instead of crossing.

    Key insight
    - The only role distinction is whether an object encloses a hole: hole objects pack against the top edge, while non-hole objects pack against the bottom edge.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    out = np.full_like(g, bg)
    objects = _objects(g, bg)

    closed = [obj for obj in objects if obj.closed]
    open_objects = [obj for obj in objects if not obj.closed]
    assert closed, "expected at least one closed object"
    assert open_objects, "expected at least one open object"

    for obj in sorted(closed, key=lambda o: (o.bbox[0], o.bbox[1], o.bbox[2], o.bbox[3])):
        _slide_into_place(out, obj, bg, upward=True)

    for obj in sorted(open_objects, key=lambda o: (-o.bbox[2], o.bbox[1], -o.bbox[0], o.bbox[3])):
        _slide_into_place(out, obj, bg, upward=False)

    return out

# --------------- generator (o5x) ---------------

# Canvas and object size bounds.
GRID_SIZE_MIN = 13
GRID_SIZE_MAX = 17
SPRITE_SIZE_MIN = 3
SPRITE_SIZE_MAX = 5

# Object count ranges.
CLOSED_COUNT_MIN = 2
CLOSED_COUNT_MAX = 3
OPEN_COUNT_MIN = 2
OPEN_COUNT_MAX = 4

# Palette constraints.
COLOR_MIN = 1
COLOR_MAX = 9
DISTINCT_COLOR_MIN = 3
DISTINCT_COLOR_MAX = 4
MAX_OBJECTS_PER_COLOR = 2

# Layout constraints.
MIN_ZONE_GAP = 3
LANE_GAP = 1
SCATTER_EDGE_MARGIN = 1
SCATTER_MIDDLE_FIRST_PROB = 0.8

# Retry limit.
GENERATION_ATTEMPTS = 300


def _gen_frame_mask(h: int, w: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def _gen_cross_mask() -> np.ndarray:
    h = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
    w = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
    r = random.randint(1, h - 2)
    c = random.randint(1, w - 2)
    mask = np.zeros((h, w), dtype=bool)
    mask[r, :] = True
    mask[:, c] = True
    return mask


def _gen_color_labels(n: int) -> list[int]:
    min_k = max(DISTINCT_COLOR_MIN, (n + 1) // MAX_OBJECTS_PER_COLOR)
    k = random.randint(min_k, min(DISTINCT_COLOR_MAX, n))
    colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), k)
    counts = [1] * k
    for _ in range(n - k):
        choices = [i for i, count in enumerate(counts) if count < MAX_OBJECTS_PER_COLOR]
        counts[random.choice(choices)] += 1

    labels: list[int] = []
    for color, count in zip(colors, counts):
        labels.extend([color] * count)
    random.shuffle(labels)
    return labels


def _gen_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.zeros(mask.shape, dtype=int)
    patch[mask] = color
    return patch


def _gen_partition_lanes(heights: list[int], capacity: int, n_lanes: int) -> list[list[int]] | None:
    order = list(range(len(heights)))
    random.shuffle(order)
    order.sort(key=lambda i: heights[i], reverse=True)
    lanes: list[list[int]] = [[] for _ in range(n_lanes)]
    sums = [0] * n_lanes

    def rec(pos: int) -> bool:
        if pos == len(order):
            return all(lane for lane in lanes)

        idx = order[pos]
        lane_order = list(range(n_lanes))
        random.shuffle(lane_order)
        for lane_i in lane_order:
            if sums[lane_i] + heights[idx] > capacity:
                continue
            if not lanes[lane_i]:
                empty_before = sum(1 for lane in lanes if not lane)
                items_left = len(order) - pos
                if empty_before > items_left:
                    continue
            lanes[lane_i].append(idx)
            sums[lane_i] += heights[idx]
            if rec(pos + 1):
                return True
            sums[lane_i] -= heights[idx]
            lanes[lane_i].pop()
        return False

    return lanes if rec(0) else None


def _gen_random_gaps(total: int, parts: int) -> list[int]:
    gaps = [0] * parts
    for _ in range(total):
        gaps[random.randrange(parts)] += 1
    return gaps


def _gen_assign_columns(objs: list[dict], width: int, capacity: int) -> bool:
    heights = [int(obj["patch"].shape[0]) for obj in objs]
    min_lanes = max(1, (sum(heights) + capacity - 1) // capacity)
    lane_counts = list(range(min_lanes, len(objs) + 1))
    random.shuffle(lane_counts)

    for n_lanes in lane_counts:
        lanes = _gen_partition_lanes(heights, capacity, n_lanes)
        if lanes is None:
            continue
        random.shuffle(lanes)
        lane_widths = [max(int(objs[i]["patch"].shape[1]) for i in lane) for lane in lanes]
        required = sum(lane_widths) + LANE_GAP * (n_lanes - 1)
        if required > width:
            continue

        gaps = _gen_random_gaps(width - required, n_lanes + 1)
        col = gaps[0]
        for lane_i, lane in enumerate(lanes):
            lane_w = lane_widths[lane_i]
            for obj_i in lane:

