+def _place_mask(
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    shape: tuple[int, int],
+) -> np.ndarray:
+    """Translate a boolean mask onto a target canvas, cropping at its boundary."""
+    out = np.zeros(shape, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr, cc = int(r) + top, int(c) + left
+        if 0 <= rr < shape[0] and 0 <= cc < shape[1]:
+            out[rr, cc] = True
