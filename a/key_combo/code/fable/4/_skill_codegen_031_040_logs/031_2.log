def _gen_can_place_pixels(canvas: np.ndarray, obj: dict, row: int) -> bool:
    patch = obj["patch"]
    c = int(obj["c"])
    h, w = patch.shape
    region = canvas[row : row + h, c : c + w]
    return bool(np.all(region[patch != 0] == 0))


def _gen_pack_group(canvas: np.ndarray, objs: list[dict], upward: bool) -> bool:
    height = int(canvas.shape[0])
    for obj in objs:
        h = int(obj["patch"].shape[0])
        if upward:
            rows = range(0, height - h + 1)
        else:
            rows = range(height - h, -1, -1)
        for row in rows:
            if _gen_can_place_pixels(canvas, obj, row):
                paste(canvas, obj["patch"], row, int(obj["c"]), transparent=0)
                obj["out_r"] = row
                break
        else:
            return False
    return True


def _gen_zone_gap(closed: list[dict], open_objs: list[dict]) -> int:
    closed_bottom = max(int(obj["out_r"]) + int(obj["patch"].shape[0]) - 1 for obj in closed)
    open_top = min(int(obj["out_r"]) for obj in open_objs)
    return open_top - closed_bottom - 1


def _gen_same_color_touch(objs: list[dict]) -> bool:
    placed = []
    for obj in objs:
        coords = np.argwhere(obj["patch"] != 0)
        coords = coords + np.array([int(obj["out_r"]), int(obj["c"])])
        placed.append((int(obj["color"]), coords))

    for i in range(len(placed)):
        color_i, coords_i = placed[i]
        for j in range(i + 1, len(placed)):
            color_j, coords_j = placed[j]
            if color_i != color_j:
                continue
            distances = np.abs(coords_i[:, None, :] - coords_j[None, :, :]).sum(axis=2)
            if np.any(distances <= 1):
                return True
    return False


def _gen_can_scatter(canvas: np.ndarray, obj: dict, row: int) -> bool:
    patch = obj["patch"]
    c = int(obj["c"])
    h, w = patch.shape
    if row < 0 or row + h > canvas.shape[0] or c < 0 or c + w > canvas.shape[1]:
        return False
    mask = patch != 0
    if np.any(canvas[row : row + h, c : c + w][mask] != 0):
        return False

    coords = np.argwhere(mask)
    for rr, cc in coords:
        ar = row + int(rr)
        ac = c + int(cc)
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr = ar + dr
            nc = ac + dc
            if 0 <= nr < canvas.shape[0] and 0 <= nc < canvas.shape[1] and canvas[nr, nc] != 0:
                return False
    return True


def _gen_row_candidates(height: int, obj_h: int) -> list[int]:
    rows = list(range(0, height - obj_h + 1))
    middle = [r for r in rows if SCATTER_EDGE_MARGIN <= r <= height - obj_h - SCATTER_EDGE_MARGIN]
    edge = [r for r in rows if r not in middle]
    random.shuffle(middle)
    random.shuffle(edge)
    if random.random() < SCATTER_MIDDLE_FIRST_PROB:
        return middle + edge
    return edge + middle


def _gen_scatter_input(height: int, width: int, closed: list[dict], open_objs: list[dict]) -> np.ndarray | None:
    """Place input objects in solver order while preserving same-group vertical order."""
    canvas = np.zeros((height, width), dtype=int)

    def rec(ci: int, oi: int, prev_closed_top: int, prev_open_bottom: int) -> bool:
        if ci == len(closed) and oi == len(open_objs):
            return True

        choices: list[str] = []
        if ci < len(closed):
            choices.append("closed")
        if oi < len(open_objs):
            choices.append("open")
        random.shuffle(choices)

        for choice in choices:
            if choice == "closed":
                obj = closed[ci]
                h = int(obj["patch"].shape[0])
                for row in _gen_row_candidates(height, h):
                    if row <= prev_closed_top or not _gen_can_scatter(canvas, obj, row):
                        continue
                    paste(canvas, obj["patch"], row, int(obj["c"]), transparent=0)
                    if rec(ci + 1, oi, row, prev_open_bottom):
                        return True
                    canvas[row : row + h, int(obj["c"]) : int(obj["c"]) + obj["patch"].shape[1]][obj["patch"] != 0] = 0
            else:
                obj = open_objs[oi]
                h = int(obj["patch"].shape[0])
                for row in _gen_row_candidates(height, h):
                    bottom = row + h - 1
                    if bottom >= prev_open_bottom or not _gen_can_scatter(canvas, obj, row):
                        continue
                    paste(canvas, obj["patch"], row, int(obj["c"]), transparent=0)
                    if rec(ci, oi + 1, prev_closed_top, bottom):
                        return True
                    canvas[row : row + h, int(obj["c"]) : int(obj["c"]) + obj["patch"].shape[1]][obj["patch"] != 0] = 0
        return False

    return canvas if rec(0, 0, -1, height) else None


def _gen_canvas_shape() -> tuple[int, int]:
    return random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX), random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)


def _gen_objects() -> tuple[list[dict], list[dict], list[dict]]:
    """Build colored closed and open sprites, then randomize each solver group order."""
    n_closed = random.randint(CLOSED_COUNT_MIN, CLOSED_COUNT_MAX)
    n_open = random.randint(OPEN_COUNT_MIN, OPEN_COUNT_MAX)
    closed: list[dict] = []
    for _ in range(n_closed):
        h = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
        w = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
        closed.append({"kind": "closed", "mask": _gen_frame_mask(h, w)})

    open_objs: list[dict] = []
    for _ in range(n_open):
        open_objs.append({"kind": "open", "mask": _gen_cross_mask()})

    all_objs = closed + open_objs
    for obj, color in zip(all_objs, _gen_color_labels(len(all_objs))):
        obj["color"] = color
        obj["patch"] = _gen_patch(obj["mask"], color)

    random.shuffle(closed)
    random.shuffle(open_objs)

    return closed, open_objs, all_objs


def _gen_capacity_split(height: int, closed: list[dict], open_objs: list[dict]) -> tuple[int, int] | None:
    max_closed_h = max(int(obj["patch"].shape[0]) for obj in closed)
    max_open_h = max(int(obj["patch"].shape[0]) for obj in open_objs)
    available = height - MIN_ZONE_GAP
    if max_closed_h + max_open_h > available:
        return None
    closed_capacity = random.randint(max_closed_h, available - max_open_h)
    open_capacity = available - closed_capacity
    return closed_capacity, open_capacity


def _gen_assign_layout(height: int, width: int, closed: list[dict], open_objs: list[dict]) -> bool:
    capacities = _gen_capacity_split(height, closed, open_objs)
    if capacities is None:
        return False
    closed_capacity, open_capacity = capacities

    if not _gen_assign_columns(closed, width, closed_capacity):
        return False
    if not _gen_assign_columns(open_objs, width, open_capacity):
        return False
    return True


def _gen_pack_output(height: int, width: int, closed: list[dict], open_objs: list[dict]) -> np.ndarray | None:
    """Render the packed target grid and reject invalid zone separation."""
    output = np.zeros((height, width), dtype=int)
    if not _gen_pack_group(output, closed, upward=True):
        return None
    if not _gen_pack_group(output, open_objs, upward=False):
        return None
    if _gen_zone_gap(closed, open_objs) < MIN_ZONE_GAP:
        return None
    return output


def _gen_checked_input(height: int, width: int, closed: list[dict], open_objs: list[dict], output: np.ndarray) -> np.ndarray | None:
    """Scatter objects into an input grid and keep only examples accepted by the solver oracle."""
    inp = _gen_scatter_input(height, width, closed, open_objs)
    if inp is None or np.array_equal(inp, output):
        return None
    if not np.array_equal(main(inp), output):
        return None
    return inp


def _gen_attempt() -> np.ndarray | None:
    height, width = _gen_canvas_shape()
    closed, open_objs, all_objs = _gen_objects()

    if not _gen_assign_layout(height, width, closed, open_objs):
        return None

    output = _gen_pack_output(height, width, closed, open_objs)
    if output is None or _gen_same_color_touch(all_objs):
        return None

    return _gen_checked_input(height, width, closed, open_objs, output)


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate ac2e8ecf input")
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import bbox_coords, colors_present, components_mask, get_bg
from scipy import ndimage


def _flood_from_bbox_side(border_set: set, bbox: tuple, side: str) -> set:
    """4-conn flood within bbox, seeded from non-border cells on the given bbox edge,
    stopping at border cells. Returns the set of reached cells (includes seeds)."""
    r0, c0, r1, c1 = bbox
    if side == "U":
        seeds = [(r0, c) for c in range(c0, c1 + 1) if (r0, c) not in border_set]
    elif side == "D":
        seeds = [(r1, c) for c in range(c0, c1 + 1) if (r1, c) not in border_set]
    elif side == "L":
        seeds = [(r, c0) for r in range(r0, r1 + 1) if (r, c0) not in border_set]
    else:  # "R"
        seeds = [(r, c1) for r in range(r0, r1 + 1) if (r, c1) not in border_set]

    visited = set(seeds)
    stack = list(seeds)
    while stack:
        r, c = stack.pop()
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if not (r0 <= nr <= r1 and c0 <= nc <= c1):
                continue
            if (nr, nc) in visited or (nr, nc) in border_set:
                continue
            visited.add((nr, nc))
            stack.append((nr, nc))
    return visited


def main(grid: np.ndarray) -> np.ndarray:
    """
    Eject content pixels from cup-shaped frames outward along each cup's tail direction.

    Input structure:
    - bg = background. Hollow cup/Y/funnel frames, each a unique border color.
    - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.
    - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.

    Rule:
    - For each cup, identify its tail spike and tail direction.
    - Erase all content pixels from the mouth interior.
    - Draw a straight line of content-colored pixels from the spike outward in the tail direction,
      one pixel per erased content pixel; cells beyond the grid edge are dropped.

    Key insight: The tail spike is the unique convergent point whose outward direction is opposite
    the mouth opening where the content lives.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))
    out = g.copy()

    DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
    OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}

    for border_col in colors_present(g, exclude={bg}):
        for border_coords in components_mask(g == int(border_col), connectivity=8):
            if border_coords.size == 0 or int(border_coords.shape[0]) < 5:
                continue

            r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))
            bbox = (r0, c0, r1, c1)
            border_set = {(int(r), int(c)) for r, c in border_coords}
            corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}

            # Candidate tail spikes: single border cell on a bbox edge, not at a corner.
            edges = (
                ("U", [p for p in border_set if p[0] == r0]),
                ("D", [p for p in border_set if p[0] == r1]),
                ("L", [p for p in border_set if p[1] == c0]),
                ("R", [p for p in border_set if p[1] == c1]),
            )
            candidates = [
                (d, cells[0]) for d, cells in edges
                if len(cells) == 1 and cells[0] not in corners
            ]
            if not candidates:
                continue

            # Each candidate: flood from opposite bbox side; keep candidates whose flood
            # reaches content (non-bg, non-border) cells.
            passing = []
            for d, spike in candidates:
                mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])
                cnt = Counter()
                for r, c in mouth:
                    v = int(g[r, c])
                    if v != bg and v != int(border_col):
                        cnt[v] += 1
                if not cnt:
                    continue
                content_col = int(cnt.most_common(1)[0][0])
                content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]
                passing.append((d, spike, content_col, content_cells))

            # Only act on cups with an unambiguous tail.
            if len(passing) != 1:
                continue
            tail_dir, spike, content_col, content_cells = passing[0]

            # Erase content, then eject outward.
            for r, c in content_cells:
                out[r, c] = bg

            dr, dc = DIR4[tail_dir]
            sr, sc = spike
            for t in range(1, len(content_cells) + 1):
                rr = sr + dr * t
                cc = sc + dc * t
                if not (0 <= rr < H and 0 <= cc < W):
                    break
                out[rr, cc] = content_col

    return out

# --------------- generator (claude opus) ---------------

# ==== Generator configuration ====
# Canvas size bounds (inclusive)
GRID_H_RANGE = (10, 13)
GRID_W_RANGE = (10, 13)

# Number of cups per grid (choices sampled uniformly)
NUM_CUPS_CHOICES = (1, 2, 3)

# Cup bbox bounds for the canonical (tail=U) patch.
# After rotation to L/R the axes swap, so both orientations must fit spec bbox 3..8 rows x 3..7 cols.
CUP_BBOX_MAX_UD = (8, 7)  # (max_h, max_w) when tail is U or D
CUP_BBOX_MAX_LR = (7, 8)  # (max_h, max_w) when tail is L or R

# Arm-length ranges for the canonical Y/funnel (inclusive)
ARM_LEN_RANGE = (1, 3)        # L and R diagonal arm length
WALL_EXT_RANGE = (0, 4)       # hL / hR (extra vertical wall cells after arm touches side)

# Content pixel count cap (per cup)
CONTENT_COUNT_MAX = 7

# Stray-pixel probability and color choice probability (border vs content)
STRAY_PROB = 0.4
STRAY_USE_BORDER_PROB = 0.5

# Retry budgets
GEN_RETRIES_PRIMARY = 300     # retries that honor a pre-chosen num_cups
GEN_RETRIES_FALLBACK = 300    # fallback retries with random num_cups
# ==================================

DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
_STRUCT8 = np.ones((3, 3), dtype=bool)


def _build_canonical_cup(L: int, R: int, hL: int, hR: int, color: int) -> tuple[np.ndarray, tuple[int, int]]:
    """Build a Y/funnel cup with tail pointing UP (spike at top, row 0).

    Left arm is a diagonal of length L going down-left; right arm length R down-right.
    After the left arm reaches col 0 (at row L), the left wall continues for hL more rows.
    Likewise the right wall continues for hR rows after its arm reaches col L+R.
    Requires hL + hR >= 1 so the bbox has enough vertical extent for a mouth.
    Returns (patch, spike_rc); bg in patch is 0."""
    assert L >= 1 and R >= 1 and hL >= 0 and hR >= 0 and (hL + hR) >= 1
    w = L + R + 1
    h = max(L + hL, R + hR) + 1
    g = np.zeros((h, w), dtype=int)
    g[0, L] = color                                   # spike
    g[np.arange(1, L + 1), L - np.arange(1, L + 1)] = color   # left arm
    g[np.arange(1, R + 1), L + np.arange(1, R + 1)] = color   # right arm
    if hL:
        g[L + 1:L + hL + 1, 0] = color                # left wall
    if hR:
        g[R + 1:R + hR + 1, w - 1] = color            # right wall
    return g, (0, L)


def _mouth_interior_coords(patch: np.ndarray, border_color: int, opposite_side: str) -> list[tuple[int, int]]:
    """Flood-fill the interior of the cup patch from cells on the given bbox edge, stopping at
    the border. Returns the sorted list of interior coordinates (seeds included)."""
    h, w = patch.shape
    border_mask = (patch == border_color)
    if opposite_side == "U":
        seeds = [(0, c) for c in range(w) if not border_mask[0, c]]
    elif opposite_side == "D":
        seeds = [(h - 1, c) for c in range(w) if not border_mask[h - 1, c]]
    elif opposite_side == "L":
        seeds = [(r, 0) for r in range(h) if not border_mask[r, 0]]
    else:  # "R"
        seeds = [(r, w - 1) for r in range(h) if not border_mask[r, w - 1]]
    visited = set(seeds)
    stack = list(seeds)
    while stack:
        r, c = stack.pop()
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited and not border_mask[nr, nc]:
                visited.add((nr, nc))
                stack.append((nr, nc))
    return sorted(visited)


def _rotate_to_direction(
    patch: np.ndarray, spike: tuple[int, int], mouth: list[tuple[int, int]], direction: str,
) -> tuple[np.ndarray, tuple[int, int], list[tuple[int, int]]]:
    """Rotate a canonical (tail=U) patch, its spike and mouth coords to the target tail direction."""
    h, w = patch.shape
    sr, sc = spike
    if direction == "U":
        return patch.copy(), (sr, sc), list(mouth)
    if direction == "D":
        return np.flipud(patch).copy(), (h - 1 - sr, sc), [(h - 1 - r, c) for (r, c) in mouth]
    if direction == "L":
        # rot90 k=1 (CCW): old (r, c) -> new (w-1-c, r)
        return np.rot90(patch, k=1).copy(), (w - 1 - sc, sr), [(w - 1 - c, r) for (r, c) in mouth]
    if direction == "R":
        # rot90 k=-1 (CW): old (r, c) -> new (c, h-1-r)
        return np.rot90(patch, k=-1).copy(), (sc, h - 1 - sr), [(c, h - 1 - r) for (r, c) in mouth]
    raise ValueError(direction)


def _sample_cup_shape(rng: np.random.Generator, direction: str) -> tuple[int, int, int, int] | None:
    """Pick (L, R, hL, hR) parameters for a canonical cup, clamped so the patch fits the
    task's bbox spec after rotation. Returns None if no feasible shape could be derived."""
    if direction in ("U", "D"):
        max_h_canon, max_w_canon = CUP_BBOX_MAX_UD
    else:
        max_h_canon, max_w_canon = CUP_BBOX_MAX_LR

    lo, hi = ARM_LEN_RANGE
    L_arm = int(rng.integers(lo, hi + 1))
    R_arm = int(rng.integers(lo, hi + 1))
    while L_arm + R_arm + 1 > max_w_canon:
        if L_arm >= R_arm:
            L_arm -= 1
        else:
            R_arm -= 1

    wlo, whi = WALL_EXT_RANGE
    hL = int(rng.integers(wlo, whi + 1))
    hR = int(rng.integers(wlo, whi + 1))
    if hL + hR == 0:
        hL = 1
    while max(L_arm + hL, R_arm + hR) + 1 > max_h_canon:
        if L_arm + hL >= R_arm + hR and hL > 0:
            hL -= 1
        elif hR > 0:
            hR -= 1
        else:

