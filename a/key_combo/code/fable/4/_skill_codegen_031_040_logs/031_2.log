+# ------------------------------ generator ------------------------------
+
+_BACKGROUND = 0
+_WINDOW_BOTTOM = 5
+_MASK_PALETTE = (1, 3, 4, 7, 9)
+_MAX_ATTEMPTS = 500
+_GENERATION_COUNT = 0
