+def _anchor(patch: np.ndarray, color: int) -> tuple[int, int]:
+    coords = np.argwhere(patch == color)
+    assert coords.shape == (1, 2), "each window needs exactly one anchor of each anchor color"
+    return int(coords[0, 0]), int(coords[0, 1])
