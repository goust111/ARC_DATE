                    continue
                if masks[other_i, r, c]:
                    overlap_add += 1
                if int((trial & masks[other_i]).sum()) > _PAIR_OVERLAP_RANGE[1]:
                    ok = False
                    break
            if ok:
                any_overlap.append((r, c))
                if overlap_add == 0:
                    low_overlap.append((r, c))
