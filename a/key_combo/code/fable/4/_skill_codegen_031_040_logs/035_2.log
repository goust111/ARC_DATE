    c0 = int(_GEN_RNG.integers(*BLOCK_ANCHOR_RANGE))
    ring_specs = [(r0 + ro, c0 + co, dr, dc) for ro, co, dr, dc in RING_OFFSETS]
    marker_paths = _gen_marker_paths(ring_specs)
