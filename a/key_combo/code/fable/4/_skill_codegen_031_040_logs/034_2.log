+    seeds = {
+        (r + dr, c + dc)
+        for r, c in template_coords
+        for dr, dc in DIR4
+        if (r + dr, c + dc) in allowed
+    }
+
+    shapes = {frozenset((seed,)) for seed in seeds}
+    for _ in range(1, area):
+        expanded: set[frozenset[Coord]] = set()
+        for cells in shapes:
+            for r, c in cells:
