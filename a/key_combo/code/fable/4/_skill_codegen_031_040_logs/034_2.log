+            for r, c in coords
+            for dr, dc in DIR4
+        ), "every indicator must touch the template orthogonally"
+        indicator_bbox = _bbox(coords)
+        direction = _direction(template_bbox, indicator_bbox)
+        assert direction != (0, 0), "indicator direction must be well-defined"
