+    for item in indicators:
+        painted |= _stamp_ray(
+            out,
+            template_mask,
+            template_bbox,
+            item["direction"],  # type: ignore[arg-type]
+            int(item["color"]),
+            int(item["area"]),
+        )
+    return out, painted
+
+
+def _generate_attempt() -> np.ndarray | None:
