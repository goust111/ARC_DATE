+    return by_direction
+
+
+def _full_copy_count(template_bbox: BBox, direction: Coord, shape: tuple[int, int]) -> int:
+    height, width = shape
+    r0, c0, r1, c1 = template_bbox
+    side = r1 - r0 + 1
+    dr, dc = direction
