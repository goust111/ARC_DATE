+                    nxt = (r + dr, c + dc)
+                    if nxt in allowed and nxt not in cells:
+                        expanded.add(cells | {nxt})
+        shapes = expanded
+
+    by_direction: dict[Coord, list[set[Coord]]] = {}
+    for frozen in shapes:
+        cells = set(frozen)
+        if not any(
