+    allowed = {
+        (r, c)
+        for r in range(max(0, r0 - area), min(height, r1 + area + 1))
+        for c in range(max(0, c0 - area), min(width, c1 + area + 1))
+        if not (r0 <= r <= r1 and c0 <= c <= c1)
