+        for r, c in indicator["coords"]:  # type: ignore[union-attr]
+            out[r, c] = bg
+    for indicator in indicators:
+        _stamp_ray(
+            out,
+            template_mask,
+            template_bbox,
+            indicator["direction"],  # type: ignore[arg-type]
+            int(indicator["color"]),
+            int(indicator["area"]),
+        )
