+        for c in range(1, len(heights) - 1)
+        if int(heights[c]) > int(heights[c - 1])
+        and int(heights[c]) > int(heights[c + 1])
+    ]
+
+
+def _entry_basin(peaks: list[int], marker_col: int) -> int:
+    candidates = [
