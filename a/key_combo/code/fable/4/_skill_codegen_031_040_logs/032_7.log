+    current = bottom
+    for j in range(center - 1, -1, -1):
+        current = min(rim - 1, current + random.randint(0, 1))
+        values[j] = current
+    current = bottom
+    for j in range(center + 1, width):
+        current = min(rim - 1, current + random.randint(0, 1))
+        values[j] = current
+    return values
