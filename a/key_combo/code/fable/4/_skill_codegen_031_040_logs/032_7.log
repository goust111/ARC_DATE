+        level = min(plan.peak_heights[basin], plan.peak_heights[basin + 1])
+        for c in range(left + 1, right):
+            for r in range(canvas_h - level, canvas_h - int(heights[c])):
+                if int(out[r, c]) == BACKGROUND:
