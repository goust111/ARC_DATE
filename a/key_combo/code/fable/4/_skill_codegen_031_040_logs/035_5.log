import random, numpy as np

def grow(h,w,n):
    m=np.zeros((h,w),bool)
    r=random.randrange(h); c=random.randrange(w); m[r,c]=1
    while m.sum()<n:
        candidates=set()
        for rr,cc in np.argwhere(m):
            for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
                a,b=int(rr)+dr,int(cc)+dc
                if 0<=a<h and 0<=b<w and not m[a,b]: candidates.add((a,b))
        if not candidates:return None
        # half the time grow from a less crowded frontier cell for shape diversity
        cs=list(candidates)
        if random.random()<.55:
            scores=[]
            for a,b in cs:
                scores.append(sum(0<=a+dr<h and 0<=b+dc<w and m[a+dr,b+dc] for dr,dc in ((-1,0),(1,0),(0,-1),(0,1))))
            best=min(scores) if random.random()<.5 else max(scores)
            cs=[x for x,s in zip(cs,scores) if s==best]
        m[random.choice(cs)]=1
    return m

def trial():
  h=random.randint(6,9);w=random.randint(6,9);N=h*w
  counts=random.sample(range(max(6,N//7), min(20,N//3)+1),4)
  order=sorted(range(4),key=lambda i:counts[i],reverse=True)
  if order in ([0,1,2,3],[3,2,1,0]):return False,None
  ms=np.array([grow(h,w,n) for n in counts]);cov=ms.sum(0);u=(cov>0).sum();ov=(cov==2).sum()
  ok=(cov.max()<=2 and .35*N<=u<=.72*N and 3<=ov<=max(6,N//6) and all((ms[i]&(cov==1)).any() for i in range(4)) and all((ms[order[k-1]]&ms[order[k]]).any() for k in range(1,4)))
  return ok,(h,w,counts,order,u,ov,cov.max())

ok=0;tries=[]
for i in range(10000):
  yes,x=trial()
  if yes: ok+=1; tries.append(x)
print('success',ok,'rate',ok/10000)
print(tries[:5])
