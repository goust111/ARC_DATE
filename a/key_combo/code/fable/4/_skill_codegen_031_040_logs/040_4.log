+            cr0, cc0 = coords.min(axis=0)
+            cr1, cc1 = coords.max(axis=0)
+            bbox_area = (int(cr1) - int(cr0) + 1) * (int(cc1) - int(cc0) + 1)
+            inside_this_cell = (
+                int(cr0) >= r0
+                and int(cr1) <= r1
+                and int(cc0) >= c0
+                and int(cc1) <= c1
+            )
+            intact[cell_r, cell_c] = inside_this_cell and len(coords) == bbox_area
