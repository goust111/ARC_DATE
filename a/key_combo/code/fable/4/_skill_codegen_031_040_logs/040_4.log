+                    line_rows[r] + 1 : line_rows[r + 1],
+                    line_cols[c] + 1 : line_cols[c + 1],
+                ] = key[slot % len(key)]
+    return grid, expected, broken
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    broken: set[tuple[int, int]],
+    n_rows: int,
+    n_cols: int,
