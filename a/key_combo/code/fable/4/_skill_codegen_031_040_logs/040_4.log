    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    shapes.add(inp.shape)
print('variants', len(sigs), 'output_variants', len(out_sigs), 'shapes', len(shapes), sorted(shapes))
assert len(sigs) >= 20
assert len(out_sigs) == len(sigs), 'distinct generated inputs must not collapse to identical outputs'
