+def _in_bounds(shape: tuple[int, int], cell: Coord) -> bool:
+    """ARC coordinates are always (row, column), as in arc_utils.in_bounds."""
+    r, c = cell
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
