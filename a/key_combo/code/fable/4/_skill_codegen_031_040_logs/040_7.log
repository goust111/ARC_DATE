+    eligible = [
+        i
+        for i in range(2, len(path) - 2)
+        if _sub(path[i], path[i - 1]) == _sub(path[i + 1], path[i])
+        and all(abs(i - bend_i) >= 2 for bend_i in bend_indices)
+    ]
