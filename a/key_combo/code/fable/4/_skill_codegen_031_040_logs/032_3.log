def _gen_anchor_cells(anchor):
    r0, c0, r1, c1 = anchor
    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]


def _gen_terminals(anchor):
    r0, c0, r1, c1 = anchor
    if (r0, c0) == (0, 0):
        return (
            [(r, c1 + 1, 0, 1) for r in range(r0, r1 + 1)]
            + [(r1 + 1, c, 1, 0) for c in range(c0, c1 + 1)]
            + [(r1 + 1, c1 + 1, 1, 1)]
        )
    return (
        [(r, c0 - 1, 0, -1) for r in range(r0, r1 + 1)]
        + [(r0 - 1, c, -1, 0) for c in range(c0, c1 + 1)]
        + [(r0 - 1, c0 - 1, -1, -1)]
    )


def _gen_seed_anchors(inp, out, colors):
    """Paint both fixed anchors and return occupied input cells."""
    occupied_in = set()

    for color, anchor in zip(colors, _GEN_ANCHORS):
        for r, c in _gen_anchor_cells(anchor):
            inp[r, c] = color
            out[r, c] = color
            occupied_in.add((r, c))

    return occupied_in


def _gen_place_loose_pixels(inp, out, color, anchor, occupied_in):
    """Sample terminals for one anchor and place their loose input pixels."""
    terminals = _gen_terminals(anchor)
    chosen = random.sample(terminals, random.randint(_GEN_RAYS_MIN, _GEN_RAYS_MAX))
    for tr, tc, dr, dc in chosen:
        out[tr, tc] = color
        max_dist = 0
        rr, cc = tr + dr, tc + dc
        while 0 <= rr < _GEN_SHAPE[0] and 0 <= cc < _GEN_SHAPE[1]:
            max_dist += 1
            rr += dr
            cc += dc
        dist = random.randint(1, min(_GEN_MAX_LOOSE_DISTANCE, max_dist))
        loose = (tr + dr * dist, tc + dc * dist)
        if loose in occupied_in:
            return False
        occupied_in.add(loose)
        inp[loose] = color
    return True


def _gen_attempt() -> np.ndarray | None:
    colors = random.sample(_GEN_FOREGROUND_COLORS, 2)
    random.shuffle(colors)

    inp = np.full(_GEN_SHAPE, _GEN_BG, dtype=int)
    out = np.full(_GEN_SHAPE, _GEN_BG, dtype=int)
    occupied_in = _gen_seed_anchors(inp, out, colors)

    for color, anchor in zip(colors, _GEN_ANCHORS):
        if not _gen_place_loose_pixels(inp, out, color, anchor, occupied_in):
            return None

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid f28a3cbb input")
GEN_ATTEMPTS = 300
CLIP_PROB = 0.3
MIN_CLIPPED_RADIUS = 3
EDGES = ["top", "bottom", "left", "right"]


def _gen_diamond_pixels(shape, cr, cc, radius):
    """Get visible pixels of a diamond outline clipped to grid."""
    h, w = shape
    if radius == 0:
        if 0 <= cr < h and 0 <= cc < w:
            return {(cr, cc)}
        return set()
    pts = set()
    for i in range(radius):
        for r, c in [(cr - radius + i, cc + i), (cr + i, cc + radius - i),
                     (cr + radius - i, cc - i), (cr - i, cc - radius + i)]:
            if 0 <= r < h and 0 <= c < w:
                pts.add((r, c))
    return pts


def _choose_counts():
    return (
        random.randint(*COUNT_RANGE),
        random.randint(*COUNT_RANGE),
        random.randint(*COUNT_RANGE),
    )


def _choose_static_colors(n_static):
    if n_static == 1:
        return [random.choice(STATIC_COLORS)]
    return random.sample(STATIC_COLORS, 2)


def _random_edge_center(shape, max_r):
    """Sample a center just outside one edge, matching the original clipped placement."""
    h, w = shape
    edge = random.choice(EDGES)
    if edge == "top":
        return (
            random.randint(max(-max_r + 1, -max_r), min(max_r - 2, 0)),
            random.randint(max_r, w - 1 - max_r),
        )
    if edge == "bottom":
        return (
            random.randint(
                max(h - 1, h - max_r + 1),
                min(h + max_r - 2, h + max_r - 1),
            ),
            random.randint(max_r, w - 1 - max_r),
        )
    if edge == "left":
        return (
            random.randint(max_r, h - 1 - max_r),
            random.randint(max(-max_r + 1, -max_r), min(max_r - 2, 0)),
        )
    return (
        random.randint(max_r, h - 1 - max_r),
        random.randint(
            max(w - 1, w - max_r + 1),
            min(w + max_r - 2, w + max_r - 1),
        ),
    )


def _random_center(shape, max_r, allow_clip):
    h, w = shape
    if allow_clip and random.random() < CLIP_PROB and max_r >= MIN_CLIPPED_RADIUS:
        return _random_edge_center(shape, max_r)
    return random.randint(0, h - 1), random.randint(0, w - 1)


def _place_object(shape, occupied, out_r, in_r, allow_clip=False):
    """Return a non-overlapping visible center, or None."""
    max_r = max(out_r, in_r)
    for _ in range(PLACE_TRIES):
        cr, cc = _random_center(shape, max_r, allow_clip)
        out_pixels = _gen_diamond_pixels(shape, cr, cc, out_r)
        in_pixels = _gen_diamond_pixels(shape, cr, cc, in_r)
        all_pixels = out_pixels | in_pixels
        if out_pixels and in_pixels and not (all_pixels & occupied):
            occupied.update(all_pixels)
            return cr, cc
    return None


def _append_object(objects, occupied, color, out_r, in_r, allow_clip=False):
    placed = _place_object(GEN_SHAPE, occupied, out_r, in_r, allow_clip)
    if placed is None:
        return False
    cr, cc = placed
    objects.append((color, cr, cc, out_r, in_r))
    return True


def _plan_objects():
    n_red, n_gray, n_static = _choose_counts()
    static_cols = _choose_static_colors(n_static)
    objects = []
    occupied = set()

    for _ in range(n_red):
        out_r = random.randint(*RED_OUT_RADIUS_RANGE)
        if not _append_object(objects, occupied, _gen_RED, out_r, out_r + 1, allow_clip=True):
            return None

    for _ in range(n_gray):
        out_r = random.randint(*GRAY_OUT_RADIUS_RANGE)
        if not _append_object(objects, occupied, _gen_GRAY, out_r, out_r - 1):
            return None

    for i in range(n_static):
        radius = random.randint(*STATIC_RADIUS_RANGE)
        if not _append_object(objects, occupied, static_cols[i], radius, radius):
            return None

    return objects


def _render_pair(objects):
    input_grid = np.full(GEN_SHAPE, BG, dtype=int)
    output_grid = np.full(GEN_SHAPE, BG, dtype=int)

    for color, cr, cc, out_r, in_r in objects:
        for r, c in _gen_diamond_pixels(GEN_SHAPE, cr, cc, in_r):
            input_grid[r, c] = color
        for r, c in _gen_diamond_pixels(GEN_SHAPE, cr, cc, out_r):
            output_grid[r, c] = color

    return input_grid, output_grid


def _passes_oracle(input_grid, output_grid):
    try:
        return np.array_equal(main(input_grid), output_grid)
    except Exception:
        return False


def _gen_attempt():
    objects = _plan_objects()
    if objects is None:
        return None

    input_grid, output_grid = _render_pair(objects)
    if _passes_oracle(input_grid, output_grid):
        return input_grid
    return None


def generate_input():
    for _ in range(GEN_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_ATTEMPTS} attempts")
SPRITE_WIDTH, SPRITE_HEIGHTS = 3, (3, 5)
ROW_KIND_COUNT, SIDE_ONLY_KIND, CENTER_ONLY_KIND, FULL_ROW_KIND = 3, 0, 1, 2
# Retry budget.
MAX_GENERATION_ATTEMPTS = 300

def _gen_sprite_mask(height: int) -> np.ndarray:
    """Return a 3-wide LR/UD-symmetric mask that uses both side and center cells."""
    row_count = (height + 1) // 2
    row_kinds = np.random.randint(0, ROW_KIND_COUNT, size=row_count)
    if not np.any(row_kinds != SIDE_ONLY_KIND):
        row_kinds[np.random.randint(row_count)] = FULL_ROW_KIND
    if not np.any(row_kinds != CENTER_ONLY_KIND):
        row_kinds[np.random.randint(row_count)] = FULL_ROW_KIND
    mask = np.zeros((height, SPRITE_WIDTH), dtype=bool)
    for rr, kind in enumerate(row_kinds):
        side = kind != SIDE_ONLY_KIND
        center = kind != CENTER_ONLY_KIND
        row = np.array([side, center, side], dtype=bool)
        mask[rr] = row
        mask[height - 1 - rr] = row
    return mask


def _gen_attempt() -> np.ndarray | None:
    height = int(np.random.choice(SPRITE_HEIGHTS))
    mask = _gen_sprite_mask(height)
    r0 = int(np.random.randint(*START_ROW_RANGE))
    c0 = int(np.random.randint(*START_COL_RANGE))
    grid = np.full(GRID_SHAPE, BACKGROUND, dtype=int)
    patch = np.zeros(mask.shape, dtype=int)
    patch[mask] = SPRITE_COLOR
    paste(grid, patch, r0, c0, transparent=BACKGROUND)

    try:
        main(grid)
    except Exception:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid d304284e input")

