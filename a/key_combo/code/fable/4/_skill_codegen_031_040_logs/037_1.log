+        horizontal[r, start : start + run] = True
+    assert horizontal.any() and not horizontal.all()
+    return horizontal if axis == "horizontal" else horizontal.T
+
+
+def _rect_cells(top: int, left: int, height: int, width: int) -> set[Coord]:
+    return {(r, c) for r in range(top, top + height) for c in range(left, left + width)}
+
+
+def _spaced(a: set[Coord], b: set[Coord], distance: int = 2) -> bool:
+    return all(abs(r - rr) + abs(c - cc) > distance for r, c in a for rr, cc in b)
+
+
+def _sample_virtual_rectangles(n: int, count: int) -> list[set[Coord]] | None:
+    """Sample well-separated rectangles strictly above and away from r=c."""
+    rects: list[set[Coord]] = []
+    for _ in range(count):
+        placed = None
+        for _attempt in range(300):
+            height, width = random.randint(2, 4), random.randint(2, 4)
+            top = random.randint(5, n - height - 5)
+            left = random.randint(5, n - width - 5)
+            cells = _rect_cells(top, left, height, width)
+            if min(c - r for r, c in cells) < 3:
+                continue
+            if all(_spaced(cells, old, 2) for old in rects):
+                placed = cells
+                break
+        if placed is None:
+            return None
+        rects.append(placed)
+    return rects
+
+
+def _translated_positions(coords: np.ndarray, direction: Coord, shift: int) -> set[Coord]:
+    dr, dc = direction
+    return {
+        (int(r + step * dr), int(c + step * dc))
+        for step in range(shift + 1)
+        for r, c in coords
+    }
+
+
+def _candidate_placements(
+    n: int,
+    shape: np.ndarray,
+    axis: str,
+    desired_hit: str,
+    virtual: set[Coord],
+    used_starts: set[Coord],
+    used_finals: set[Coord],
+    used_sweeps: set[Coord],
+) -> list[tuple[np.ndarray, np.ndarray, int, set[Coord]]]:
+    local = np.argwhere(shape)
+    sh, sw = shape.shape
+    diag = {(i, i) for i in range(n)}
+    forbidden = diag | virtual
+    direction = (0, -1) if axis == "horizontal" else (1, 0)
+    candidates = []
+    for top in range(1, n - sh - 1):
+        for left in range(1, n - sw - 1):
+            coords = local + np.array((top, left), dtype=int)
+            start = {(int(r), int(c)) for r, c in coords}
+            if min(c - r for r, c in start) <= 0 or start & virtual:
+                continue
+            if used_starts and not _spaced(start, used_starts, 1):
+                continue
+            final, shift, hit = _slide(coords, direction, forbidden, (n, n))
+            final_cells = {(int(r), int(c)) for r, c in final}
+            reason = "virtual" if hit & virtual else "line" if hit & diag else "edge"
+            if reason != desired_hit or shift < 2 or start & final_cells:
+                continue
+            sweep = _translated_positions(coords, direction, shift)
+            if sweep & used_starts or start & used_sweeps:
+                continue
+            if used_finals and not _spaced(final_cells, used_finals, 1):
+                continue
+            if final_cells & used_starts:
+                continue
+            if desired_hit == "virtual":
+                line_final, line_shift, _ = _slide(coords, direction, diag, (n, n))
+                if line_shift <= shift or np.array_equal(line_final, final):
+                    continue
+            candidates.append((coords, final, shift, sweep))
+    random.shuffle(candidates)
+    return candidates
+
+
+def _semantic_check(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    virtual: set[Coord],
+    specs: list[tuple[np.ndarray, np.ndarray, str]],
+) -> bool:
+    """Check the stated geometry and necessity of the hidden-wall step independently."""
+    n = inp.shape[0]
+    diag = {(i, i) for i in range(n)}
+    try:
+        parsed = _parse(inp)
+        anchors = parsed[5]
+        visible_movers = parsed[6]
+        reconstructed = {(int(c), int(r)) for obj in anchors for r, c in obj}
+        if reconstructed != virtual or len(visible_movers) != len(specs):
+            return False
+        if not np.array_equal(main(inp), expected) or np.array_equal(inp, expected):
+            return False
+
+        expected_finals: set[Coord] = set()
+        for start, final, wanted in specs:
+            direction = _motion(start)
+            got, shift, hit = _slide(start, direction, diag | virtual, inp.shape)
+            reason = "virtual" if hit & virtual else "line" if hit & diag else "edge"
+            if reason != wanted or not np.array_equal(got, final) or shift < 2:
+                return False
+            expected_finals |= {(int(r), int(c)) for r, c in final}
+            if wanted == "virtual":
+                no_wall, no_wall_shift, _ = _slide(start, direction, diag, inp.shape)
+                if no_wall_shift <= shift or np.array_equal(no_wall, final):
+                    return False
+        mover_color = parsed[4]
+        return expected_finals == {(int(r), int(c)) for r, c in np.argwhere(expected == mover_color)}
+    except (AssertionError, ValueError):
+        return False
+
+
+def _generate_attempt() -> np.ndarray | None:
+    count = random.choice((1, 2))
+    n = random.randint(22 if count == 1 else 25, 30)
+    virtual_rects = _sample_virtual_rectangles(n, count)
+    if virtual_rects is None:
+        return None
+    virtual = set().union(*virtual_rects)
+
+    if count == 2:
+        axes = ["horizontal", "vertical"]
+        random.shuffle(axes)
+        desired = ["virtual", "line"]
+        random.shuffle(desired)
+    else:
+        axes = [random.choice(("horizontal", "vertical"))]
+        desired = [random.choice(("virtual", "line"))]
+
+    mover_specs: list[tuple[np.ndarray, np.ndarray, str]] = []
+    used_starts: set[Coord] = set()
+    used_finals: set[Coord] = set()
+    used_sweeps: set[Coord] = set()
+    for axis, wanted in zip(axes, desired):
+        chosen = None
+        for _ in range(40):
+            shape = _random_long_axis_shape(axis)
+            candidates = _candidate_placements(
+                n, shape, axis, wanted, virtual, used_starts, used_finals, used_sweeps
+            )
+            if candidates:
+                chosen = candidates[0]
+                break
+        if chosen is None:
+            return None
+        start, final, _shift, sweep = chosen
+        mover_specs.append((start, final, wanted))
+        used_starts |= {(int(r), int(c)) for r, c in start}
+        used_finals |= {(int(r), int(c)) for r, c in final}
+        used_sweeps |= sweep
+
+    # Random transposition covers both sides of r=c and swaps horizontal/vertical motion.
+    transpose = bool(random.getrandbits(1))
+    if transpose:
+        virtual = {(c, r) for r, c in virtual}
+        mover_specs = [(s[:, ::-1].copy(), f[:, ::-1].copy(), kind) for s, f, kind in mover_specs]
+
+    bg, line_color, anchor_color, mover_color = random.sample(range(10), 4)
+    inp = np.full((n, n), bg, dtype=int)
+    np.fill_diagonal(inp, line_color)
+    # Real anchors are the transpose of the invisible rectangles.
+    for r, c in virtual:
+        inp[c, r] = anchor_color
+    for start, _final, _kind in mover_specs:
+        inp[start[:, 0], start[:, 1]] = mover_color
+
+    expected = inp.copy()
+    expected[expected == mover_color] = bg
+    for _start, final, _kind in mover_specs:
+        expected[final[:, 0], final[:, 1]] = mover_color
+
+    return inp if _semantic_check(inp, expected, virtual, mover_specs) else None
+
+
+def generate_input() -> np.ndarray:
+    """Generate varied one/two-mover scenes with explicit semantic counterexamples."""
+    for _ in range(400):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid invisible-diagonal-wall puzzle")

