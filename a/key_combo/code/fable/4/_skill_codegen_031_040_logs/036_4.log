# Canvas and palette.
GEN_ROW_RANGE = (10, 12)
GEN_COL_RANGE = (10, 11)
GEN_COLOR_RANGE = range(1, 10)
GEN_PALETTE_SIZE = 3
GEN_BACKGROUND = 0

# Sprite structure.
GEN_SPRITE_SIZE = 3
GEN_SPRITE_C1_COUNT_RANGE = (3, 6)
GEN_ROTATION_STEPS = (1, 2, 3)
GEN_FULL_TURN_STEPS = 4

# Marker geometry, placement, and retry budget.
GEN_CORNERS = ["NW", "NE", "SW", "SE"]
GEN_SPRITE_MARGIN = 3
GEN_L_GROUP_OFFSETS = (-1, 1)
GEN_MARKER_COUNT = 4
GEN_MAX_ATTEMPTS = 300

GEN_CORNER_OUTWARD = {"NW": (-1, -1), "NE": (-1, 1), "SW": (1, -1), "SE": (1, 1)}
GEN_ROTATED_CORNER = {
    1: {"NW": "SW", "NE": "NW", "SW": "SE", "SE": "NE"},
    2: {"NW": "SE", "NE": "SW", "SW": "NE", "SE": "NW"},
    3: {"NW": "NE", "NE": "SE", "SW": "NW", "SE": "SW"},
}


def _gen_rotation_steps(src_corner: str, dst_corner: str) -> int:
    for steps, mapping in GEN_ROTATED_CORNER.items():
        if mapping[src_corner] == dst_corner:
            return steps
    raise ValueError("source and destination corners must be distinct")


def _gen_sprite_corners(r0: int, c0: int) -> dict[str, tuple[int, int]]:
    far = GEN_SPRITE_SIZE - 1
    return {
        "NW": (r0, c0),
        "NE": (r0, c0 + far),
        "SW": (r0 + far, c0),
        "SE": (r0 + far, c0 + far),
    }


def _gen_outside_corner(corner: str, pos: tuple[int, int]) -> tuple[int, int]:
    dr, dc = GEN_CORNER_OUTWARD[corner]
    return pos[0] + dr, pos[1] + dc


def _gen_l_group(dst_corner: str, corners: dict[str, tuple[int, int]]):
    sr, sc = corners[dst_corner]
    cr, cc = _gen_outside_corner(dst_corner, (sr, sc))
    square = [(cr + dr, cc + dc) for dr in GEN_L_GROUP_OFFSETS for dc in GEN_L_GROUP_OFFSETS]
    return (cr, cc), [pos for pos in square if pos != (sr, sc)]


def _gen_is_rot_asymmetric(patch: np.ndarray) -> bool:
    return all(not np.array_equal(patch, np.rot90(patch, k=k)) for k in GEN_ROTATION_STEPS)


def _gen_make_sprite(sprite_c1: int, sprite_c2: int) -> np.ndarray:
    """Sample a filled sprite and repair accidental rotational symmetry."""
    c1_count = random.randint(*GEN_SPRITE_C1_COUNT_RANGE)
    positions = [(r, c) for r in range(GEN_SPRITE_SIZE) for c in range(GEN_SPRITE_SIZE)]
    c1_positions = random.sample(positions, c1_count)
    patch = np.full((GEN_SPRITE_SIZE, GEN_SPRITE_SIZE), sprite_c2, dtype=int)
    rr, cc = zip(*c1_positions)
    patch[rr, cc] = sprite_c1
    if _gen_is_rot_asymmetric(patch):
        return patch

    swaps = [(a, b) for a in positions for b in positions if patch[a] != patch[b]]
    random.shuffle(swaps)
    for a, b in swaps:
        repaired = patch.copy()
        repaired[a], repaired[b] = repaired[b], repaired[a]
        if _gen_is_rot_asymmetric(repaired):
            return repaired
    raise ValueError("failed to repair sprite asymmetry")


def _gen_layout(rows: int, cols: int, src_corner: str, dst_corner: str):
    """Sample sprite placement and derive valid marker coordinates."""
    r0 = random.randint(GEN_SPRITE_MARGIN, rows - GEN_SPRITE_MARGIN - GEN_SPRITE_SIZE)
    c0 = random.randint(GEN_SPRITE_MARGIN, cols - GEN_SPRITE_MARGIN - GEN_SPRITE_SIZE)
    corners = _gen_sprite_corners(r0, c0)
    collapsed_marker, l_markers = _gen_l_group(dst_corner, corners)
    singleton_marker = _gen_outside_corner(src_corner, corners[src_corner])
    marker_positions = l_markers + [singleton_marker]
    if len(set(marker_positions)) != GEN_MARKER_COUNT:
        return None

    for r, c in marker_positions + [collapsed_marker]:
        if not (0 <= r < rows and 0 <= c < cols):
            return None
    return r0, c0, collapsed_marker, marker_positions


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*GEN_ROW_RANGE)
    cols = random.randint(*GEN_COL_RANGE)
    sprite_c1, sprite_c2, marker_color = random.sample(GEN_COLOR_RANGE, GEN_PALETTE_SIZE)

    try:
        output_sprite = _gen_make_sprite(sprite_c1, sprite_c2)
    except ValueError:
        return None
    src_corner, dst_corner = random.sample(GEN_CORNERS, 2)
    steps = _gen_rotation_steps(src_corner, dst_corner)
    input_sprite = np.rot90(output_sprite, k=GEN_FULL_TURN_STEPS - steps)

    layout = _gen_layout(rows, cols, src_corner, dst_corner)
    if layout is None:
        return None
    r0, c0, collapsed_marker, marker_positions = layout

    inp = np.zeros((rows, cols), dtype=int)
    out = np.zeros((rows, cols), dtype=int)
    paste(inp, input_sprite, r0, c0, transparent=None)
    paste(out, output_sprite, r0, c0, transparent=None)

    marker_rows, marker_cols = zip(*marker_positions)
    if np.any(inp[marker_rows, marker_cols] != GEN_BACKGROUND):
        return None
    inp[marker_rows, marker_cols] = marker_color
    cr, cc = collapsed_marker
    if out[cr, cc] != GEN_BACKGROUND:
        return None
    out[cr, cc] = marker_color

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid ecaa0ec1 input")
import numpy as np
import random
from arc_utils import Color, bbox, colors_present, detect_objects, draw_line, paste, random_free_location, random_sprite


# concepts:
# cups, filling

# description:
# In the input you will see several blue "cups", meaning an almost-enclosed shape with a small opening at the top, and empty space (black pixels) inside, as well as a single colored pixel inside.
# To make the output grid, you should fill the interior of each cup with the same color as the colored pixel inside it. 
# Also, put a single layer of colored pixels above the cup with the same color as what's inside.

def main(input_grid):
    """
    Fill each blue cup with its internal marker color and add a matching cap layer above it.

    Input structure:
    - The grid contains one or more blue cup-shaped outlines on a black background.
    - Each cup has a black interior with exactly one non-blue colored marker inside.
    - The cup bounding box defines the interior area to fill.

    Rule:
    - Detect each blue cup object.
    - Find the unique non-black, non-blue color inside its bounding box.
    - Fill the cup interior with that color and paint one matching row above the cup.

    Key insight:
    - The marker pixel supplies the fill color, while the blue outline supplies the geometry
      for both the interior and the added top layer.
    """
    # Plan:
    # 1. Detect all the blue cups
    # 2. For each cup, find the mask of what is inside of it
    # 3. Find the color of the single pixel inside the cup
    # 4. Fill the cup with the color
    # 5. Put a single layer of colored pixels above the cup with the same color as what's inside
    
    # Detect all the blue cups
    blue_cups = detect_objects(grid=input_grid, colors=[Color.BLUE], monochromatic=True, connectivity=4, background=Color.BLACK)

    output_grid = input_grid.copy()

    # For each cup object...
    for obj in blue_cups:
        # Extract what's inside the cup (as its own object), which is everything in the bounding box that is not the object itself
        b = bbox(obj != Color.BLACK)
        assert b is not None
        r0, c0, r1, c1 = b
        inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
        inside_cup_mask[r0 : r1 + 1, c0 : c1 + 1] = True
        inside_cup_mask = inside_cup_mask & (obj != Color.BLUE)
        object_inside_cup = np.where(inside_cup_mask, input_grid, Color.BLACK)

        # Find the color of the single pixel inside the cup
        colors = set(map(int, np.unique(object_inside_cup))) - {Color.BLACK, Color.BLUE}
        assert len(colors) == 1, "There should be exactly one color inside the cup"
        color = next(iter(colors))

        # Fill the cup with the color
        output_grid[inside_cup_mask] = color

        # Put a single layer of colored pixels above the cup with the same color as what's inside
        top_r = r0 - 1
        if top_r >= 0:
            output_grid[top_r, c0 : c1 + 1] = color

    return output_grid

def generate_input():
    # Generate the grid with random size
    width = np.random.randint(12, 30)
    height = np.random.randint(12, 30)
    grid = np.full((width, height), Color.BLACK)

    n_cups = np.random.randint(1, 2+1)

    for cup_index in range(n_cups):
        # Pick a random width/height for this cup
        cup_width = np.random.randint(4, 8)
        cup_height = np.random.randint(3, 8)

        # Make a sprite, which is just going to be a blue outline of a rectangle with a hole at the top
        sprite = np.full((cup_width, cup_height), Color.BLACK)
        sprite[0, :] = Color.BLUE
        sprite[-1, :] = Color.BLUE
        sprite[:, 0] = Color.BLUE
        sprite[:, -1] = Color.BLUE

        # Make the hole centered at the top (variable size)
        hole_left_r = np.random.randint(1, cup_width//2)
        hole_right_r = cup_width - hole_left_r - 1
        hole_c = 0
        sprite[hole_left_r:hole_right_r+1, hole_c] = Color.BLACK

        # Put another color inside the cup
        color = np.random.choice([color for color in Color.NOT_BLACK if color != Color.BLUE])
        r, c = np.random.randint(1, cup_width-1), np.random.randint(1, cup_height-1)
        sprite[r, c] = color

        # Find a random free location for it
        try:
            free_r, free_c = random_free_location(grid, sprite, transparent=Color.BLACK, border=1, padding=1, padding_connectivity=8)
        except ValueError:
            break
        paste(grid, sprite, free_r, free_c, transparent=Color.BLACK, clip=True)

    return grid    
