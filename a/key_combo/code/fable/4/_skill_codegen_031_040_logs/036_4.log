+def _direction(a: tuple[int, int], b: tuple[int, int]) -> int | None:
+    """Return the cardinal half-line from a to b, or None when unaligned."""
+    ar, ac = a
+    br, bc = b
+    if ac == bc and br < ar:
+        return 0
+    if ar == br and bc > ac:
+        return 1
+    if ac == bc and br > ar:
+        return 2
+    if ar == br and bc < ac:
+        return 3
+    return None
+
