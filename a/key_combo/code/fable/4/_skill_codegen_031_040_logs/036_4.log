import numpy as np

from arc_utils import Color, bbox, crop_bbox, find_components, get_bg, paste
import math
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Compare the two same-sized motifs and output the cropped mask of cells missing from the damaged copy.

    Input structure
    - The black background contains exactly two 4-connected multicolor foreground objects.
    - The two objects have the same rectangular bbox shape and represent aligned copies of the same motif.
    - One object is complete; the other is a damaged copy with only foreground cells removed.

    Rule
    - Align the two object crops by their bbox top-left corners.
    - Select the cells that are foreground in the complete crop and background in the damaged crop.
    - Crop that missing-cell mask to its own bbox, recolor selected cells teal, and leave other cells black.

    Key insight
    - The output is not one of the colored motifs; it is the shape of the damage after subtracting the smaller motif mask from the larger matching motif mask.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    assert bg == Color.BLACK, "expected black background"

    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert len(components) == 2, "expected exactly two motif objects"

    crops = [crop_bbox(g, component["bbox"]) for component in components]
    assert crops[0].shape == crops[1].shape, "motif bboxes must have the same shape"

    candidates = []
    for complete, damaged in ((crops[0], crops[1]), (crops[1], crops[0])):
        complete_mask = complete != bg
        damaged_mask = damaged != bg
        missing = complete_mask & ~damaged_mask
        extra = damaged_mask & ~complete_mask
        overlap = complete_mask & damaged_mask
        if missing.any() and not extra.any() and np.array_equal(complete[overlap], damaged[overlap]):
            candidates.append(missing)

    assert len(candidates) == 1, "expected a unique complete-to-damaged mask difference"
    missing = candidates[0]
    missing_bbox = bbox(missing)
    assert missing_bbox is not None, "expected at least one missing cell"

    cropped_missing = crop_bbox(missing, missing_bbox)
    out = np.zeros(cropped_missing.shape, dtype=int)
    out[cropped_missing] = Color.TEAL
    return out

# --------------- generator (o5x) ---------------

# Missing-mask dimensions and occupancy.
MISSING_H_RANGE = (2, 4)
MISSING_W_RANGE = (6, 10)
MISSING_CELL_RANGE = (6, 13)
SINGLE_MISSING_MAX_W = 8
SINGLE_MISSING_PROB = 0.35

# Two-component missing-mask split geometry.
TWO_MISSING_GAP_CHOICES = (1, 2)
TWO_MISSING_WIDE_GAP_MIN_W = 8
TWO_MISSING_MIN_SIDE_W = 2

# Motif bbox, foreground density, and missing-cell fraction constraints.
MOTIF_H_RANGE = (8, 15)
MOTIF_W_RANGE = (6, 10)
MOTIF_DENSITY_RANGE = (0.67, 0.92)
MISSING_FRACTION_RANGE = (0.08, 0.16)
NEAR_GEOMETRY_LIMIT = 20

# Layered motif coloring.
MOTIF_PALETTE = (1, 2, 3, 4, 6, 7)
MOTIF_COLOR_COUNT_RANGE = (4, 6)
MOTIF_BAND_HEIGHTS = (2, 3)

# Canvas placement and retry limits.
CANVAS_H_RANGE = (22, 25)
CANVAS_W_RANGE = (22, 25)
PLACEMENT_GAP_RANGE = (3, 6)
GENERATION_ATTEMPTS = 300

FOUR_NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))
HORIZONTAL = "h"
VERTICAL = "v"


def _gen_mask_from_cells(h: int, w: int, cells: set[tuple[int, int]], col_offset: int = 0) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    for r, c in cells:
        mask[r, c + col_offset] = True
    return mask


def _gen_grow_cells(h: int, w: int, size: int, seeds: set[tuple[int, int]]) -> set[tuple[int, int]] | None:
    cells = set(seeds)
    if len(cells) > size:
        return None
    while len(cells) < size:
        frontier = set()
        for r, c in cells:
            for dr, dc in FOUR_NEIGHBOR_DELTAS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
                    frontier.add((nr, nc))
        if not frontier:
            return None
        cells.add(random.choice(tuple(frontier)))
    return cells


def _gen_single_missing(h: int, w: int, count: int) -> np.ndarray | None:
    base_r = random.randrange(h)
    branch_c = random.randrange(w)
    seeds = {(base_r, c) for c in range(w)}
    seeds.update((r, branch_c) for r in range(h))
    cells = _gen_grow_cells(h, w, count, seeds)
    if cells is None:
        return None
    return _gen_mask_from_cells(h, w, cells)


def _gen_two_missing(h: int, w: int, count: int) -> np.ndarray | None:
    gap_w = random.choice(TWO_MISSING_GAP_CHOICES) if w >= TWO_MISSING_WIDE_GAP_MIN_W else 1
    lo_gap = TWO_MISSING_MIN_SIDE_W
    hi_gap = w - gap_w - TWO_MISSING_MIN_SIDE_W
    if lo_gap > hi_gap:
        return None
    gap_c = random.randint(lo_gap, hi_gap)
    left_w = gap_c
    right_c0 = gap_c + gap_w
    right_w = w - right_c0

    max_left = h * left_w
    max_right = h * right_w
    lo_left = max(1, count - max_right)
    hi_left = min(max_left, count - 1)
    if lo_left > hi_left:
        return None
    left_count = random.randint(lo_left, hi_left)
    right_count = count - left_count

    top_on_left = random.random() < 0.5
    left_seed = (0 if top_on_left else h - 1, 0)
    right_seed = (h - 1 if top_on_left else 0, right_w - 1)
    left_cells = _gen_grow_cells(h, left_w, left_count, {left_seed})
    right_cells = _gen_grow_cells(h, right_w, right_count, {right_seed})
    if left_cells is None or right_cells is None:
        return None

    mask = _gen_mask_from_cells(h, w, left_cells)
    mask |= _gen_mask_from_cells(h, w, right_cells, col_offset=right_c0)
    return mask


def _gen_missing_mask() -> tuple[np.ndarray, int] | None:
    h = random.randint(*MISSING_H_RANGE)
    w = random.randint(*MISSING_W_RANGE)
    use_single = w <= SINGLE_MISSING_MAX_W and random.random() < SINGLE_MISSING_PROB
    if use_single:
        lo = max(MISSING_CELL_RANGE[0], w + h - 1)
        hi = min(MISSING_CELL_RANGE[1], h * w)
        if lo <= hi:
            count = random.randint(lo, hi)
            mask = _gen_single_missing(h, w, count)
            if mask is not None:
                return mask, 1

    count = random.randint(MISSING_CELL_RANGE[0], min(MISSING_CELL_RANGE[1], h * w))
    mask = _gen_two_missing(h, w, count)
    if mask is None:
        return None
    return mask, 2


def _gen_component_count(mask: np.ndarray) -> int:
    return len(find_components(mask.astype(int), bg=Color.BLACK, connectivity=4, monochromatic=False))


def _gen_margin_options(
    motif_h: int,
    motif_w: int,
    missing: np.ndarray,
    row_offset: int,
    col_offset: int,
    n_components: int,
) -> list[list[int]]:
    mh, mw = missing.shape
    missing_by_row = {row_offset + r: [] for r in range(mh)}
    for r, c in zip(*np.nonzero(missing)):
        missing_by_row[row_offset + r].append(col_offset + c)

    options = []
    max_margin = (motif_w - 1) // 2
    for r in range(motif_h):
        allowed = max_margin
        if r in missing_by_row and missing_by_row[r]:
            allowed = min(allowed, min(min(c, motif_w - 1 - c) for c in missing_by_row[r]))
        if n_components == 1 and row_offset <= r < row_offset + mh:
            allowed = 0
        options.append(list(range(allowed + 1)))
    return options


def _gen_possible_margin_sums(options: list[list[int]], motif_w: int) -> set[int]:
    sums = {0}
    for row_options in options:
        sums = {total + motif_w - 2 * margin for total in sums for margin in row_options}
    return sums


def _gen_choose_margins(options: list[list[int]], motif_w: int, target_fg: int) -> list[int] | None:
    states: dict[int, list[int]] = {0: []}
    for row_options in options:
        shuffled = list(row_options)
        random.shuffle(shuffled)
        next_states: dict[int, list[int]] = {}
        sums = list(states.items())
        random.shuffle(sums)
        for total, margins in sums:
            for margin in shuffled:
                new_total = total + motif_w - 2 * margin
                if new_total <= target_fg and new_total not in next_states:
                    next_states[new_total] = margins + [margin]
        states = next_states
        if not states:
            return None
    return states.get(target_fg)


def _gen_width_options(missing_w: int, n_components: int) -> list[int]:
    if n_components == 1:
        return list(range(missing_w + 2, MOTIF_W_RANGE[1] + 1))
    return [missing_w]


def _gen_foreground_bounds(area: int, missing_count: int) -> tuple[int, int]:
    min_density, max_density = MOTIF_DENSITY_RANGE
    min_missing_frac, max_missing_frac = MISSING_FRACTION_RANGE
    min_fg = max(math.ceil(min_density * area), math.ceil(missing_count / max_missing_frac), missing_count + 1)
    max_fg = min(math.floor(max_density * area), math.floor(missing_count / min_missing_frac), area)
    return min_fg, max_fg


def _gen_pick_geometry(missing: np.ndarray, n_components: int) -> tuple[int, int, int, int, list[int]] | None:
    mh, mw = missing.shape
    missing_count = int(missing.sum())
    width_options = _gen_width_options(mw, n_components)
    random.shuffle(width_options)

    configs = []
    target_density = random.uniform(*MOTIF_DENSITY_RANGE)
    for motif_w in width_options:
        if not (MOTIF_W_RANGE[0] <= motif_w <= MOTIF_W_RANGE[1]):
            continue
        col_offsets = [0] if n_components == 2 else list(range(1, motif_w - mw))
        for motif_h in range(MOTIF_H_RANGE[0], MOTIF_H_RANGE[1] + 1):
            if motif_h < mh + 2:
                continue
            area = motif_h * motif_w
            min_fg, max_fg = _gen_foreground_bounds(area, missing_count)
            if min_fg > max_fg:
                continue
            for row_offset in range(1, motif_h - mh):
                for col_offset in col_offsets:
                    margin_options = _gen_margin_options(motif_h, motif_w, missing, row_offset, col_offset, n_components)
                    possible_fg = _gen_possible_margin_sums(margin_options, motif_w)
                    for fg in range(min_fg, max_fg + 1):
                        if fg in possible_fg:
                            density = fg / area
                            configs.append((abs(density - target_density), motif_h, motif_w, row_offset, col_offset, margin_options, fg))

    if not configs:
        return None
    configs.sort(key=lambda item: item[0])
    near = configs[: max(1, min(NEAR_GEOMETRY_LIMIT, len(configs)))]
    _score, motif_h, motif_w, row_offset, col_offset, margin_options, target_fg = random.choice(near)
    margins = _gen_choose_margins(margin_options, motif_w, target_fg)
    if margins is None:
        return None
    return motif_h, motif_w, row_offset, col_offset, margins


def _gen_color_motif(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    colors = random.sample(MOTIF_PALETTE, random.randint(*MOTIF_COLOR_COUNT_RANGE))
    phase = random.randrange(len(colors))
    band_h = random.choice(MOTIF_BAND_HEIGHTS)
    motif = np.zeros((h, w), dtype=int)
    for r in range(h):
        cols = np.flatnonzero(mask[r])
        if cols.size == 0:
            continue
        left = int(cols[0])
        right = int(cols[-1])
        row_band = r // band_h
        for c in range(w):
            if mask[r, c]:
                d = min(c - left, right - c)
                motif[r, c] = colors[(d + row_band + phase) % len(colors)]
    return motif


def _gen_foreground_connected(sprite: np.ndarray) -> bool:
    comps = find_components(sprite, bg=Color.BLACK, connectivity=4, monochromatic=False)
    return len(comps) == 1


def _gen_build_pair(missing: np.ndarray, n_components: int) -> tuple[np.ndarray, np.ndarray] | None:
    geometry = _gen_pick_geometry(missing, n_components)
    if geometry is None:
        return None
    motif_h, motif_w, row_offset, col_offset, margins = geometry

    complete_mask = np.zeros((motif_h, motif_w), dtype=bool)
    for r, margin in enumerate(margins):
        complete_mask[r, margin : motif_w - margin] = True
    missing_abs = np.zeros((motif_h, motif_w), dtype=bool)
    missing_abs[row_offset : row_offset + missing.shape[0], col_offset : col_offset + missing.shape[1]] = missing
    if np.any(~complete_mask & missing_abs):
        return None

    complete = _gen_color_motif(complete_mask)
    damaged = complete.copy()
    damaged[missing_abs] = 0

    if not _gen_foreground_connected(complete) or not _gen_foreground_connected(damaged):
        return None
    if complete.shape != damaged.shape:
        return None
    return complete, damaged


def _gen_placement_options(obj_h: int, obj_w: int) -> list[tuple[str, int, int, int]]:
    grids = [(r, c) for r in range(CANVAS_H_RANGE[0], CANVAS_H_RANGE[1] + 1) for c in range(CANVAS_W_RANGE[0], CANVAS_W_RANGE[1] + 1)]
    random.shuffle(grids)
    options = []
    for grid_h, grid_w in grids:
        for gap in range(PLACEMENT_GAP_RANGE[0], PLACEMENT_GAP_RANGE[1] + 1):
            if 2 * obj_w + gap <= grid_w:
                options.append((HORIZONTAL, grid_h, grid_w, gap))
            if 2 * obj_h + gap <= grid_h:
                options.append((VERTICAL, grid_h, grid_w, gap))
    return options


def _gen_place_pair(complete: np.ndarray, damaged: np.ndarray) -> np.ndarray | None:
    h, w = complete.shape
    options = _gen_placement_options(h, w)
    if not options:
        return None

    orient, grid_h, grid_w, gap = random.choice(options)
    grid = np.zeros((grid_h, grid_w), dtype=int)
    first, second = (complete, damaged) if random.random() < 0.5 else (damaged, complete)
    if orient == HORIZONTAL:
        c0 = random.randint(0, grid_w - (2 * w + gap))
        c1 = c0 + w + gap
        r0 = random.randint(0, grid_h - h)
        r1 = random.randint(0, grid_h - h)
    else:
        r0 = random.randint(0, grid_h - (2 * h + gap))
        r1 = r0 + h + gap
        c0 = random.randint(0, grid_w - w)
        c1 = random.randint(0, grid_w - w)
    paste(grid, first, r0, c0, transparent=Color.BLACK)
    paste(grid, second, r1, c1, transparent=Color.BLACK)
    return grid


def _gen_expected_output(missing: np.ndarray) -> np.ndarray:
    expected = np.zeros(missing.shape, dtype=int)
    expected[missing] = Color.TEAL
    return expected


def _gen_oracle_accepts(inp: np.ndarray, expected: np.ndarray) -> bool:
    try:
        actual = main(inp)
    except Exception:
        return False
    if not np.array_equal(actual, expected):
        return False
    return get_bg(inp) == Color.BLACK


def _gen_attempt() -> np.ndarray | None:
    missing_info = _gen_missing_mask()
    if missing_info is None:
        return None
    missing, n_components = missing_info
    if _gen_component_count(missing) != n_components:
        return None

    pair = _gen_build_pair(missing, n_components)
    if pair is None:
        return None
    complete, damaged = pair
    inp = _gen_place_pair(complete, damaged)
    if inp is None:
        return None

    if not _gen_oracle_accepts(inp, _gen_expected_output(missing)):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 2037f2c7 input")
import numpy as np

from arc_utils import colors_present, find_components, get_bg
import random


def _assert_output_footprints_disjoint(dims: list[tuple[int, int]]) -> None:
    occupied: set[tuple[int, int]] = set()

    c = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        cells = {(r, cc) for r in range(short) for cc in range(c, c + long)}
        assert not (occupied & cells), "normalized output rectangles must not overlap"
        occupied |= cells
        c += long + 1

    c = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        cells = {
            (r, cc)
            for r in range(10 - long, 10)
            for cc in range(c, c + short)
        }
        assert not (occupied & cells), "normalized output rectangles must not overlap"
        occupied |= cells
        c += short + 1


def main(grid: np.ndarray) -> np.ndarray:
    """
    Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.

    Input structure
    The grid has one background color and one foreground color; the foreground forms
    separate solid rectangles, ordered from left to right.

    Rule
    Build a 10-row background canvas whose width is the packed width of the wide
    versions of the rectangles. For each source rectangle, paint a top-aligned
    rectangle of shape min(h,w) by max(h,w), with one background column between
    consecutive rectangles. Then, starting again from the left edge, paint a
    bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,
    again separated by one background column.

    Key insight
    The input rectangles are not copied in their original orientations; each object
    contributes one horizontal-facing and one vertical-facing normalized rectangle,
    preserving left-to-right object order.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1
    fg = fg_colors[0]

    components = find_components(g, bg=bg, connectivity=4, colors=[fg])
    assert components
    components = sorted(components, key=lambda obj: (obj["bbox"][1], obj["bbox"][0]))

    dims: list[tuple[int, int]] = []
    for obj in components:
        r0, c0, r1, c1 = obj["bbox"]
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        assert obj["area"] == h * w
        dims.append((h, w))

    out_h = 10
    out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1
    _assert_output_footprints_disjoint(dims)
    out = np.full((out_h, out_w), bg, dtype=int)

    c = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        assert long <= out_h
        out[:short, c : c + long] = fg
        c += long + 1

    c = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        assert long <= out_h
        out[out_h - long : out_h, c : c + short] = fg
        c += short + 1

    return out

# --------------- generator (att1) ---------------

# Color palette.
COLOR_VALUES = tuple(range(10))

# Rectangle counts and dimensions.
RECT_COUNT_MIN = 4
RECT_COUNT_MAX = 6
SHORT_SIDE_MIN = 1
SHORT_SIDE_MAX = 3
SIDE_SUM_MAX = 10
LONG_SIDE_MAX = SIDE_SUM_MAX - SHORT_SIDE_MIN

# Canvas and packing constraints.
ARC_GRID_MAX = 30
OUTPUT_HEIGHT = 10
GAP_WIDTH = 1

# Retry policy.
MAX_GENERATION_ATTEMPTS = 300


def _gen_d749d46f_output_footprints_disjoint(dims):
    occupied = set()

    col = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        cells = {(r, c) for r in range(short) for c in range(col, col + long)}
        if occupied & cells:
            return False
        occupied |= cells
        col += long + GAP_WIDTH

    col = 0
    for h, w in dims:
        short, long = min(h, w), max(h, w)
        cells = {
            (r, c)
            for r in range(OUTPUT_HEIGHT - long, OUTPUT_HEIGHT)
            for c in range(col, col + short)
        }
        if occupied & cells:
            return False
        occupied |= cells
        col += short + GAP_WIDTH

    return True


def _sample_dimensions(n_rects):
    """Sample source rectangle dimensions under the output-width budget."""
    dims = []
    remaining_budget = ARC_GRID_MAX - GAP_WIDTH * (n_rects - 1)

    for i in range(n_rects):
        rects_left = n_rects - i
        min_needed = rects_left - 1
        max_for_this = min(remaining_budget - min_needed, LONG_SIDE_MAX)
        if max_for_this < SHORT_SIDE_MIN:
            return None

        short = random.randint(SHORT_SIDE_MIN, SHORT_SIDE_MAX)
        max_long = min(SIDE_SUM_MAX - short, max_for_this)
        if max_long < short:
            short = SHORT_SIDE_MIN
            max_long = min(LONG_SIDE_MAX, max_for_this)
            if max_long < SHORT_SIDE_MIN:
                return None

        long = random.randint(short, max_long)
        remaining_budget -= long

        if random.random() < 0.5:
            h, w = long, short
        else:
            h, w = short, long
        dims.append((h, w))

    return dims


def _input_shape(dims):
    return max(h for h, _ in dims), sum(w for _, w in dims) + GAP_WIDTH * (len(dims) - 1)


def _background_is_dominant(dims, inp_h, inp_w):
    fg_pixels = sum(h * w for h, w in dims)
    total_pixels = inp_h * inp_w
    bg_pixels = total_pixels - fg_pixels
    return bg_pixels > fg_pixels


def _build_input_grid(dims, bg, fg, inp_h, inp_w):
    grid = np.full((inp_h, inp_w), bg, dtype=int)
    col = 0
    for h, w in dims:
        grid[:h, col:col + w] = fg
        col += w + GAP_WIDTH
    return grid


def _passes_solver_oracle(grid):
    try:
        out = main(grid)
    except Exception:
        return False
    return out.shape[0] == OUTPUT_HEIGHT


def _gen_attempt():
    """Generate one valid input grid, or None when sampled dimensions fail constraints."""
    bg, fg = random.sample(COLOR_VALUES, 2)
    n_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)
    dims = _sample_dimensions(n_rects)
    if dims is None:
        return None

    inp_h, inp_w = _input_shape(dims)
    if inp_w > ARC_GRID_MAX:
        return None
    if not _gen_d749d46f_output_footprints_disjoint(dims):
        return None
    if inp_h > ARC_GRID_MAX or inp_h < 1:
        return None
    if not _background_is_dominant(dims, inp_h, inp_w):
        return None

    grid = _build_input_grid(dims, bg, fg, inp_h, inp_w)
    if not _passes_solver_oracle(grid):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components, get_bg, paste
import random


_CORNER_OUTWARD = {
    "NW": (-1, -1),
    "NE": (-1, 1),
    "SW": (1, -1),
    "SE": (1, 1),
}

_ROTATED_CORNER = {
    0: {"NW": "NW", "NE": "NE", "SW": "SW", "SE": "SE"},
    1: {"NW": "SW", "NE": "NW", "SW": "SE", "SE": "NE"},
    2: {"NW": "SE", "NE": "SW", "SW": "NE", "SE": "NW"},
    3: {"NW": "NE", "NE": "SE", "SW": "NW", "SE": "SW"},
}


def _corner_coords(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    return {
        "NW": (r0, c0),
        "NE": (r0, c1),
        "SW": (r1, c0),
        "SE": (r1, c1),
    }


def _outside_corner_coords(corners: dict[str, tuple[int, int]]) -> dict[str, tuple[int, int]]:
    return {
        name: (pos[0] + _CORNER_OUTWARD[name][0], pos[1] + _CORNER_OUTWARD[name][1])
        for name, pos in corners.items()
    }


def _rotation_steps(src_corner: str, dst_corner: str) -> int:
    steps = [k for k, mapping in _ROTATED_CORNER.items() if mapping[src_corner] == dst_corner]
    assert len(steps) == 1, "expected a unique rotation mapping between marked corners"
    return steps[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Rotate the 3x3 two-color sprite so the singleton marker corner maps to the missing-corner marker, then collapse that marker to its center.

    Input structure
    - The dominant color is the background.
    - The foreground has one filled 3x3 two-color sprite and four same-color singleton marker pixels.
    - Three marker pixels form the outer corners of a missing-corner square whose missing corner touches one sprite corner.
    - The fourth marker pixel sits diagonally outside another sprite corner.

    Rule
    - Identify the sprite corner touched by the missing-corner marker as the destination corner.
    - Identify the sprite corner diagonally adjacent to the singleton marker as the source corner.
    - Rotate the sprite in place by the unique quarter-turn count that maps the source corner to the destination corner.
    - Remove the four input marker pixels and paint one marker pixel at the missing-corner square's center.

    Key insight
    - The marker pixels are rotation controls: the L-shaped group names the target corner, while the lone marker names the corner that must rotate into it.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "input must be a 2D grid"
    bg = get_bg(g)

    components = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    sprite_candidates = []
    for component in components:
        bbox = component["bbox"]
        if component["area"] == 9 and bbox_h(bbox) == 3 and bbox_w(bbox) == 3:
            r0, c0, r1, c1 = bbox
            if np.all(g[r0 : r1 + 1, c0 : c1 + 1] != bg):
                sprite_candidates.append(component)
    assert len(sprite_candidates) == 1, "expected one filled 3x3 foreground sprite"

    sprite = sprite_candidates[0]
    r0, c0, r1, c1 = sprite["bbox"]
    sprite_patch = g[r0 : r1 + 1, c0 : c1 + 1]
    sprite_colors = set(map(int, sprite_patch.flat))
    assert len(sprite_colors) == 2, "sprite must use exactly two colors"

    marker_components = [component for component in components if component is not sprite]
    assert len(marker_components) == 4, "expected four marker pixels outside the sprite"
    assert all(component["area"] == 1 for component in marker_components), "markers must be singleton pixels"

    marker_coords = [tuple(map(int, component["coords"][0])) for component in marker_components]
    marker_colors = {int(g[r, c]) for r, c in marker_coords}
    assert len(marker_colors) == 1, "all markers must have the same color"
    marker_color = next(iter(marker_colors))
    assert marker_color != bg and marker_color not in sprite_colors, "marker color must be distinct"
    marker_set = set(marker_coords)

    corners = _corner_coords(sprite["bbox"])
    outside = _outside_corner_coords(corners)
    matches = []
    for dst_corner, sprite_corner_coord in corners.items():
        center = outside[dst_corner]
        square_corners = {
            (center[0] + dr, center[1] + dc)
            for dr in (-1, 1)
            for dc in (-1, 1)
        }
        l_marker_coords = square_corners - {sprite_corner_coord}
        if not l_marker_coords.issubset(marker_set):
            continue

        remaining_markers = marker_set - l_marker_coords
        if len(remaining_markers) != 1:
            continue
        singleton = next(iter(remaining_markers))
        src_corners = [corner for corner, pos in outside.items() if pos == singleton]
        if len(src_corners) == 1:
            matches.append((src_corners[0], dst_corner, center))

    assert len(matches) == 1, "expected a unique marker-defined source and destination corner"
    src_corner, dst_corner, center = matches[0]
    cr, cc = center
    assert 0 <= cr < g.shape[0] and 0 <= cc < g.shape[1], "collapsed marker center must be in bounds"

    out = g.copy()
    for r, c in marker_set:
        out[r, c] = bg
    out[r0 : r1 + 1, c0 : c1 + 1] = np.rot90(sprite_patch, k=_rotation_steps(src_corner, dst_corner))
    out[cr, cc] = marker_color
    return out

