+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    padded = np.pad(mask, 1)
+    out = np.zeros_like(mask)
+    for dr in range(3):
+        for dc in range(3):
+            out |= padded[dr : dr + mask.shape[0], dc : dc + mask.shape[1]]
+    return out
