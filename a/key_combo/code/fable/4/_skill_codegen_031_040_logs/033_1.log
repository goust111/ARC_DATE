+
+Coord = tuple[int, int]
+
+
+@dataclass(frozen=True)
+class _Chain:
+    """A recovered chain of full rectangle components."""
+
+    h: int
+    w: int
+    direction: int
+    anchors: tuple[Coord, ...]
+    gap: Coord
