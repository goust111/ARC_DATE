+class _Chain:
+    """A recovered chain of full rectangle components."""
+
+    h: int
+    w: int
+    direction: int
+    anchors: tuple[Coord, ...]
+    gap: Coord
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as arrays of (row, column) coordinates."""
+    height, width = mask.shape
