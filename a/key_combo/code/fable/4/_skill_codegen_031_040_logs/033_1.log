def _build_halo(grid: np.ndarray, preserve: set) -> np.ndarray:
    """Paint orange (7) Chebyshev-1 halo around preserve pixels; keep them black."""
    H, W = grid.shape
    output = grid.copy()
    for r, c in preserve:
        for dr in range(-1, 2):
            for dc in range(-1, 2):
                rr, cc = r + dr, c + dc
                if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:
                    output[rr, cc] = 7
