def _make_target_region(H: int, W: int) -> set[tuple[int, int]] | None:
    for _ in range(TARGET_RETRY_LIMIT):
        if random.random() < TARGET_STAIRCASE_PROB:
            max_n = min(STAIRCASE_MAX_SIZE, H, W)
            if max_n < STAIRCASE_MIN_SIZE:
