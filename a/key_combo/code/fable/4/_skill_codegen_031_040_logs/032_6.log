import numpy as np

from arc_utils import find_components, get_bg
import random


RED = 2
GRAY = 5


def _diamond_outline(shape: tuple[int, int], cr: int, cc: int, radius: int) -> set[tuple[int, int]]:
    assert radius >= 0
    h, w = shape
    return {
        (r, c)
        for r in range(h)
        for c in range(w)
        if abs(r - cr) + abs(c - cc) == radius
    }


def _diamond_fits(coords: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int, int]]:
    h, w = shape
    pts = {tuple(map(int, p)) for p in coords}
    margin = h + w
    fits: list[tuple[int, int, int]] = []
    for cr in range(-margin, h + margin + 1):
        for cc in range(-margin, w + margin + 1):
            radii = {abs(r - cr) + abs(c - cc) for r, c in pts}
            if len(radii) != 1:
                continue
            radius = radii.pop()
            if _diamond_outline(shape, cr, cc, radius) == pts:
                fits.append((cr, cc, radius))
    return fits


def _minimal_diamond_fit(coords: np.ndarray, shape: tuple[int, int]) -> tuple[int, int, int, bool]:
    fits = _diamond_fits(coords, shape)
    assert fits
    min_radius = min(radius for _cr, _cc, radius in fits)
    minimal = [(cr, cc, radius) for cr, cc, radius in fits if radius == min_radius]
    assert len(minimal) == 1
    cr, cc, radius = minimal[0]
    return cr, cc, radius, len(fits) > 1


def _gray_outline(coords: np.ndarray, shape: tuple[int, int]) -> set[tuple[int, int]]:
    h, w = shape
    cr, cc, radius, edge_ambiguous = _minimal_diamond_fit(coords, shape)

    if edge_ambiguous:
        # Continue an edge-clipped growing arc away from the nearest perpendicular edge.
        if cr in (0, h - 1):
            assert cc * 2 != w - 1
            cc += 1 if cc * 2 < w - 1 else -1
        elif cc in (0, w - 1):
            assert cr * 2 != h - 1
            cr += 1 if cr * 2 < h - 1 else -1
        else:
            raise AssertionError("ambiguous diamond fit without edge clipping")

    return _diamond_outline(shape, cr, cc, radius + 1)


def _paint_checked(
    out: np.ndarray,
    coords: set[tuple[int, int]],
    color: int,
    protected: np.ndarray,
    painted: np.ndarray,
) -> None:
    for r, c in coords:
        assert not protected[r, c]
        assert not painted[r, c] or int(out[r, c]) == color
        out[r, c] = color
        painted[r, c] = True


def main(grid: np.ndarray) -> np.ndarray:
    """Red diamond outlines contract by one layer and gray diamond outlines expand by one layer while other objects stay fixed.

    Input structure
    - A 16x16 orange-background grid contains one-cell-thick Manhattan-diamond outlines.
    - Red and gray outlines are the changing objects; other colored diamond outlines are static.
    - Some outlines may be clipped by the grid boundary, but their visible pixels still fit a clipped Manhattan-distance contour.
    Rule
    - Clear all red and gray pixels.
    - Red objects are redrawn with the same diamond center and radius minus one.
    - Gray objects are redrawn with radius plus one; an ambiguous edge-clipped growing arc continues away from the nearest perpendicular edge.
    Key insight
    - The task is not about moving whole objects: each changing object is a contour of a diamond, and the visible operation is one step of contour contraction or expansion.
    """
    g = np.asarray(grid, dtype=int)
    assert g.shape == (16, 16)
    bg = get_bg(g)
    assert bg not in (RED, GRAY)

    colors = set(map(int, g.flatten()))
    assert RED in colors and GRAY in colors

    out = g.copy()
    changing = np.isin(g, [RED, GRAY])
    protected = (g != bg) & ~changing
    out[changing] = bg
    painted = np.zeros(g.shape, dtype=bool)

    for comp in find_components(g, bg=bg, connectivity=8, colors=[RED], return_format="dict"):
        cr, cc, radius, _ = _minimal_diamond_fit(comp["coords"], g.shape)
        assert radius >= 1
        _paint_checked(out, _diamond_outline(g.shape, cr, cc, radius - 1), RED, protected, painted)

    for comp in find_components(g, bg=bg, connectivity=8, colors=[GRAY], return_format="dict"):
        _paint_checked(out, _gray_outline(comp["coords"], g.shape), GRAY, protected, painted)

    return out

# --------------- generator (att1) ---------------

# Canvas and palette.
GEN_SHAPE = (16, 16)
BG = 7
_gen_RED = RED
_gen_GRAY = GRAY
STATIC_COLORS = [8, 9]

# Object counts and radius ranges.
COUNT_RANGE = (1, 2)
RED_OUT_RADIUS_RANGE = (0, 5)
GRAY_OUT_RADIUS_RANGE = (1, 5)
STATIC_RADIUS_RANGE = (0, 2)

# Placement retries and clipping controls.
PLACE_TRIES = 50
GEN_ATTEMPTS = 300
CLIP_PROB = 0.3
MIN_CLIPPED_RADIUS = 3
EDGES = ["top", "bottom", "left", "right"]


def _gen_diamond_pixels(shape, cr, cc, radius):
    """Get visible pixels of a diamond outline clipped to grid."""
    h, w = shape
    if radius == 0:
        if 0 <= cr < h and 0 <= cc < w:
            return {(cr, cc)}
        return set()
    pts = set()
    for i in range(radius):
        for r, c in [(cr - radius + i, cc + i), (cr + i, cc + radius - i),
                     (cr + radius - i, cc - i), (cr - i, cc - radius + i)]:
            if 0 <= r < h and 0 <= c < w:
                pts.add((r, c))
    return pts


def _choose_counts():
    return (
        random.randint(*COUNT_RANGE),
        random.randint(*COUNT_RANGE),
        random.randint(*COUNT_RANGE),
    )


def _choose_static_colors(n_static):
    if n_static == 1:
        return [random.choice(STATIC_COLORS)]
    return random.sample(STATIC_COLORS, 2)


    """Return a non-overlapping visible center, or None."""
    max_r = max(out_r, in_r)
    for _ in range(PLACE_TRIES):
        cr, cc = _random_center(shape, max_r, allow_clip)
        out_pixels = _gen_diamond_pixels(shape, cr, cc, out_r)
        in_pixels = _gen_diamond_pixels(shape, cr, cc, in_r)
        all_pixels = out_pixels | in_pixels
        if out_pixels and in_pixels and not (all_pixels & occupied):
            occupied.update(all_pixels)
            return cr, cc
    return None


def _append_object(objects, occupied, color, out_r, in_r, allow_clip=False):
    placed = _place_object(GEN_SHAPE, occupied, out_r, in_r, allow_clip)
    if placed is None:
        return False
    cr, cc = placed
    objects.append((color, cr, cc, out_r, in_r))
    return True


def _plan_objects():
    n_red, n_gray, n_static = _choose_counts()
    static_cols = _choose_static_colors(n_static)
    objects = []
    occupied = set()

    for _ in range(n_red):
        out_r = random.randint(*RED_OUT_RADIUS_RANGE)
        if not _append_object(objects, occupied, _gen_RED, out_r, out_r + 1, allow_clip=True):
            return None

    for _ in range(n_gray):
        out_r = random.randint(*GRAY_OUT_RADIUS_RANGE)
        if not _append_object(objects, occupied, _gen_GRAY, out_r, out_r - 1):
            return None

    for i in range(n_static):
        radius = random.randint(*STATIC_RADIUS_RANGE)
        if not _append_object(objects, occupied, static_cols[i], radius, radius):
            return None

    return objects


def _render_pair(objects):
    input_grid = np.full(GEN_SHAPE, BG, dtype=int)
    output_grid = np.full(GEN_SHAPE, BG, dtype=int)

    for color, cr, cc, out_r, in_r in objects:
        for r, c in _gen_diamond_pixels(GEN_SHAPE, cr, cc, in_r):
            input_grid[r, c] = color
        for r, c in _gen_diamond_pixels(GEN_SHAPE, cr, cc, out_r):
            output_grid[r, c] = color

    return input_grid, output_grid


def _passes_oracle(input_grid, output_grid):
    try:
        return np.array_equal(main(input_grid), output_grid)
    except Exception:
        return False


def _gen_attempt():
    objects = _plan_objects()
    if objects is None:
        return None

    input_grid, output_grid = _render_pair(objects)
    if _passes_oracle(input_grid, output_grid):
        return input_grid
    return None


def generate_input():
    for _ in range(GEN_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_ATTEMPTS} attempts")

import numpy as np
from typing import *
from arc_utils import Color, bbox, crop_bbox, draw_line, first_free_location, paste, random_sprite, scale_sprite

# concepts:
# scaling, shape matching, non-black background

# description:
# In the input you should see three objects, two of which are the same shape but different sizes and colors. The third object is a different shape.
# To make the output, you need to find the two objects that are the same shape but different sizes and colors.
# Return the smaller object in the same shape.

def main(input_grid):
    """
    Return the smaller object from the pair that has the same shape at different scales.

    Input structure:
    - The grid has a most-common background color.
    - Three colored objects are present, one of them a distractor.
    - Two objects share shape but differ in color and scale, and the larger may be clipped.

    Rule:
    - Split candidate objects by color against the background.
    - Compare object masks after scaling smaller candidates by factors of 2 or 3.
    - Crop and return the unique smaller object that matches a larger scaled object.

    Key insight:
    - Shape matching ignores color and allows the scaled larger object to be partially outside the canvas.
    """
    # Plan:
    # 1. Find the background color
    # 2. Extract objects by color
    # 3. Define a helper function to check if two objects are the same shape but different color/scale, remembering that the bigger one might be partially out of the canvas
    # 4. Iterate all candidate objects and check if they are the same shape but different color/scale
    # 5. Return what we find

    # Determine the background color, which is the most common color in the grid
    colors = np.unique(input_grid)
    background = colors[np.argmax([np.sum(input_grid == c) for c in colors])]
    object_colors = [c for c in colors if c != background]

    # Extract the objects, each of which is a different color.
    # This means we can split the canvas by color, instead of using connected components.
    objects = []
    for color in object_colors:
        object = np.copy(input_grid)
        object[input_grid != color] = background
        objects.append(object)
    
    # Define a helper function for checking if two objects are different color/scale but same shape
    # This has to handle the case where the bigger object is partially outside the grid
    def same_shape_different_color_different_scale(obj1, obj2):
        # obj1 is the smaller object
        if np.sum(obj1 != background) > np.sum(obj2 != background): return False

        b1 = bbox(obj1 != background)
        b2 = bbox(obj2 != background)
        if b1 is None or b2 is None:
            return False
        mask1 = (crop_bbox(obj1, b1) != background)
        mask2 = (crop_bbox(obj2, b2) != background)

        # Loop through all possible scale factors
        for scale_factor in range(2, 4):
            scaled_mask1 = scale_sprite(mask1, scale_factor)
            # loop over all possible places that we might put mask2, which starts anywhere in the scaled_mask1
            # note that we are only doing this because there can be objects that fall outside of the canvas
            # otherwise we would just compare the two masks directly
            for dr, dc in np.ndindex(scaled_mask1.shape):
                if np.array_equal(scaled_mask1[dr : dr + mask2.shape[0], dc : dc + mask2.shape[1]], mask2):
                    return True
        return False
    
    output_grid_candidates = []
    # Iterate all candidate objects
    for obj in objects:
        other_objects = [o for o in objects if o is not obj]
        if any( same_shape_different_color_different_scale(obj, other_obj) for other_obj in other_objects ):
            output_grid_candidates.append(obj)

    # Check if the generated input grid is valid
    assert len(output_grid_candidates) == 1, f"Should only have one output grid candidate, have {len(output_grid_candidates)}"

    _b = bbox(output_grid_candidates[0] != background)
    assert _b is not None
    output_grid = crop_bbox(output_grid_candidates[0], _b)

    return output_grid

def generate_input():
    # get color for background and three objects
    background, small_color, big_color, other_color = np.random.choice(Color.NOT_BLACK, 4, replace=False)

    # Create background grid.
    n, m = np.random.randint(20, 30), np.random.randint(20, 30)
    grid = np.full((m, n), background)

    # Create two different sprites
    n1, m1 = np.random.randint(3, 6), np.random.randint(3, 6)
    n2, m2 = np.random.randint(3, 6), np.random.randint(3, 6)

    sprite_small = random_sprite(m=m1, n=n1, color_palette=[small_color], background=background, connectivity=8)
    sprite_other = random_sprite(m=m2, n=n2, color_palette=[other_color], background=background, connectivity=8)

    # Scale the small sprite to the big sprite
    scale_factor = np.random.randint(2, 4)
    sprite_big = scale_sprite(sprite_small, scale_factor)
    # change its color
    sprite_big[sprite_big == small_color] = big_color

    # Place the big sprite on the grid
    # The sprite can be partially outside the grid
    # Ensure the sprite is not too outside the grid
    padding = 4
    r, c = np.random.randint(padding, m - padding), np.random.randint(padding, n - padding)
    paste(grid, sprite_big, r, c, transparent=background, clip=True)

    try:
        # Place the small sprite on the grid
        _loc = first_free_location(grid, sprite_small, transparent=background, border=0, padding=0, padding_connectivity=8)
        if _loc is None:
            raise ValueError("no placement")
        r, c = _loc
        paste(grid, sprite_small, r, c, transparent=background, clip=True)

        # Place the other sprite on the grid
        _loc = first_free_location(grid, sprite_other, transparent=background, border=0, padding=0, padding_connectivity=8)
        if _loc is None:
            raise ValueError("no placement")
        r, c = _loc
        paste(grid, sprite_other, r, c, transparent=background, clip=True)

        # Check if the generated grid is valid
        main(grid)
    except:
        return generate_input()

    return grid

