+    try:
+        info = _parse(inp)
+        out = main(inp)
+    except AssertionError:
+        return None
+    if info["rotation"] != quarter_turns or not np.array_equal(out, expected):
+        return None
+
+    changed = out != inp
+    if int(changed.sum()) != block_size * block_size + 1:
+        return None
+    if len(set(map(int, out[changed]))) != 2:
+        return None
+    return inp
