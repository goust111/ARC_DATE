+
+
+def _place_frames(rng: random.Random, grid: np.ndarray, plans: list[dict]) -> bool:
+    h, w = grid.shape
+    boxes: list[BBox] = []
+    for plan in sorted(plans, key=lambda x: (x["ih"] + 2) * (x["iw"] + 2), reverse=True):
