def _base_and_pair_marker(values: np.ndarray) -> tuple[int, int]:
    counts = Counter(map(int, values))
    max_count = max(counts.values())
    bases = [color for color, n in counts.items() if n == max_count]
    assert len(bases) == 1
    base = bases[0]
