+        specs.append(("extra_complete", extra_dims, extra_votes, True))
+
+    plans = []
+    used_patterns: set[tuple[tuple[int, int], bytes]] = set()
+    for color, (role, (ih, iw), votes, complete) in zip(frame_colors, specs):
+        for _ in range(50):
