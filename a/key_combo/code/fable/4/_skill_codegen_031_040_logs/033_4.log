+    """Return 4-connected components using the common ARC (row, col) convention."""
+    unseen = {tuple(map(int, p)) for p in np.argwhere(mask)}
+    result: list[set[Coord]] = []
+    while unseen:
+        seed = unseen.pop()
+        comp = {seed}
+        queue = [seed]
+        while queue:
+            r, c = queue.pop()
+            for dr, dc in CARDINALS:
+                nxt = (r + dr, c + dc)
+                if nxt in unseen:
+                    unseen.remove(nxt)
+                    comp.add(nxt)
+                    queue.append(nxt)
+        result.append(comp)
+    return result
