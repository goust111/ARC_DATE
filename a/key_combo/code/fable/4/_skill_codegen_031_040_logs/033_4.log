+def _solve_details(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    parsed = _parse(grid)
+    entities: list[dict] = parsed["entities"]
+    queue: deque[tuple[int, int]] = deque()
+    lit: dict[int, int] = {}
+    for eid, entity in enumerate(entities):
