+    # A port records (entity corner, first grey cell, direction entity->wire).
+    for eid, entity in enumerate(entities):
+        if entity["kind"] == "source":
+            r, c = next(iter(entity["cells"]))
+            candidates = [
+                ((r, c), (r + dr, c + dc), (dr, dc))
+                for dr, dc in DIAGONALS
+                if (r + dr, c + dc) in wire
