from __future__ import annotations
import numpy as np
from arc_utils import components_mask
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Highlight black defects in blue foreground by surrounding them with orange.

    Input structure:
    - Blue (1) foreground on black (0) bg; small black holes or protrusions within blue regions; occasional thin blue spurs into black areas.

    Rule:
    - Thin blue pixels mostly surrounded by black are absorbed into the background.
    - Small black components (≤3 cells) and leaf pixels of larger black components are "defects."
    - Each defect gets an orange (7) 8-neighbor halo; the defect pixels themselves stay black.

    Key insight: Only structural anomalies—tiny isolated patches and dangling endpoints—are marked, not bulk black regions.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    hole_col = 0
    border_col = 7

    # STEP 0) Fill blue (1) pixels to black (0) when mostly surrounded by black.
    base = g.copy()
    for r in range(H):
        for c in range(W):
            if int(base[r, c]) != 1:
                continue
            nb = 0
            oob = 0
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                rr = int(r + dr)
                cc = int(c + dc)
                if not (0 <= rr < H and 0 <= cc < W):
                    oob += 1
                    continue
                if int(base[rr, cc]) == int(hole_col):
                    nb += 1
            # only count outside-as-black for corners (two out-of-bounds sides)
            if oob >= 2:
                nb += int(oob)
            if nb >= 3:
                base[int(r), int(c)] = int(hole_col)

    # STEP 1/2) Collect target black pixels (they must remain black).
    preserve: set[tuple[int, int]] = set()
    comps = components_mask(base == int(hole_col), connectivity=4)
    for coords in comps:
        pts_list = [(int(r), int(c)) for r, c in coords]
        if len(pts_list) <= 3:
            preserve.update(pts_list)
            continue
        for r, c in pts_list:
            nb = 0
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                rr = int(r + dr)
                cc = int(c + dc)
                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):
                    nb += 1
            if nb <= 1:
                preserve.add((int(r), int(c)))

    # STEP 3) Paint orange in the Chebyshev-1 neighborhood of each target set/pixel.
    out = base.copy()
    for coords in comps:
        pts_list = [(int(r), int(c)) for r, c in coords]
        targets = pts_list if len(pts_list) <= 3 else [p for p in pts_list if p in preserve]
        for r, c in targets:
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    rr = int(r + dr)
                    cc = int(c + dc)
                    if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:
                        out[rr, cc] = int(border_col)

    # Ensure target black pixels remain black.
    for r, c in preserve:
        out[int(r), int(c)] = int(hole_col)

    return out

# --------------- generator (att1) ---------------

# ── CFG: tunable generation parameters ──────────────────────────────
GRID_H_RANGE = (16, 19)           # canvas height bounds
GRID_W_RANGE = (16, 19)           # canvas width bounds
MIN_BLUE_REGION = 30              # minimum blue region size (cells)
MIN_BLACK_REGION = 20             # minimum black region size (cells)
PARTITION_STYLES = ['h_stripes', 'rect_inset', 'l_shape']
STRIPE_CUTS_RANGE = (1, 3)       # number of horizontal cuts for h_stripes
CUT_MARGIN = 3                   # min distance from grid edge for cuts
INSET_MARGIN = 2                 # padding from edge for rect_inset
INNER_INSET_MIN_GAP = 6          # min dimension for nested inset
INNER_INSET_PROB = 0.5           # probability of nested inset
DEFECT_COUNT_RANGE = (2, 9)      # number of defect holes to place
DEFECT_SIZE_WEIGHTS = [6, 2, 1]  # weights for defect sizes [1, 2, 3]
DEFECT_CLEARANCE = 2             # min Chebyshev distance between defects
DEFECT_PLACE_TRIES = 50          # retries per defect placement
LEAF_COUNT_RANGE = (0, 4)        # number of leaf protrusions
SPUR_COUNT_RANGE = (2, 6)        # number of blue spurs in black regions
MIN_DEFECTS = 2                  # reject grid if fewer defects placed
MIN_SPURS = 2                    # reject grid if fewer spurs placed
MAX_GEN_ATTEMPTS = 300           # outer retry limit


def _nearby(r: int, c: int, dist: int, ref: set) -> bool:
    """Return True if any pixel in `ref` is within Chebyshev distance `dist`."""
    for dr in range(-dist, dist + 1):
        for dc in range(-dist, dist + 1):
            if (r + dr, c + dc) in ref:
                return True
    return False


def _exclusion_zone(pixels, dist: int) -> set:
    """Return the set of all coords within Chebyshev `dist` of any pixel."""
    zone = set()
    for r, c in pixels:
        for dr in range(-dist, dist + 1):
            for dc in range(-dist, dist + 1):
                zone.add((r + dr, c + dc))
    return zone


def _build_partition(H: int, W: int) -> np.ndarray:
    """Create an H x W grid partitioned into blue (1) and black (0) regions."""
    grid = np.zeros((H, W), dtype=int)
    style = random.choice(PARTITION_STYLES)

    if style == 'h_stripes':
        n_cuts = random.randint(*STRIPE_CUTS_RANGE)
        cuts = sorted(random.sample(
            range(CUT_MARGIN, H - CUT_MARGIN), min(n_cuts, H - 2 * CUT_MARGIN)))
        boundaries = [0] + cuts + [H]
        first_color = random.randint(0, 1)
        for i in range(len(boundaries) - 1):
            grid[boundaries[i]:boundaries[i + 1], :] = (first_color + i) % 2

    elif style == 'rect_inset':
        bg = random.randint(0, 1)
        grid[:, :] = bg
        r0 = random.randint(INSET_MARGIN, H // 3)
        r1 = random.randint(2 * H // 3, H - CUT_MARGIN)
        c0 = random.randint(INSET_MARGIN, W // 3)
        c1 = random.randint(2 * W // 3, W - CUT_MARGIN)
        grid[r0:r1 + 1, c0:c1 + 1] = 1 - bg
        if (r1 - r0 > INNER_INSET_MIN_GAP and c1 - c0 > INNER_INSET_MIN_GAP
                and random.random() < INNER_INSET_PROB):
            ir0 = random.randint(r0 + 2, r0 + (r1 - r0) // 3)
            ir1 = random.randint(r0 + 2 * (r1 - r0) // 3, r1 - 2)
            ic0 = random.randint(c0 + 2, c0 + (c1 - c0) // 3)
            ic1 = random.randint(c0 + 2 * (c1 - c0) // 3, c1 - 2)
            grid[ir0:ir1 + 1, ic0:ic1 + 1] = bg

    elif style == 'l_shape':
        bg = random.randint(0, 1)
        grid[:, :] = bg
        vc = random.randint(W // 3, 2 * W // 3)
        if random.random() < 0.5:
            grid[:, :vc] = 1 - bg
            hc = random.randint(H // 3, 2 * H // 3)
            grid[:hc, vc:] = 1 - bg
        else:
            grid[:, vc:] = 1 - bg
            hc = random.randint(H // 3, 2 * H // 3)
            grid[hc:, :vc] = 1 - bg

    return grid


def _find_interior_blue(grid: np.ndarray) -> list[tuple[int, int]]:
    """Return blue pixels whose 4-neighbors are all blue or out-of-bounds."""
    H, W = grid.shape
    blue = grid == 1
    # A blue pixel is interior if no in-bounds 4-neighbor is non-blue.
    eroded = blue.copy()
    eroded[:-1, :] &= blue[1:, :]   # neighbor below
    eroded[1:, :]  &= blue[:-1, :]  # neighbor above
    eroded[:, :-1] &= blue[:, 1:]   # neighbor right
    eroded[:, 1:]  &= blue[:, :-1]  # neighbor left
    rs, cs = np.where(eroded)
    coords = list(zip(rs.tolist(), cs.tolist()))
    random.shuffle(coords)
    return coords


def _place_defects(grid: np.ndarray, interior_blue: list) -> tuple[set, int]:
    """Place 2-9 small black defects in blue-region interiors.

    Returns (defect_pixels, defects_placed). Modifies `interior_blue` in place.
    """
    H, W = grid.shape
    n_defects = random.randint(*DEFECT_COUNT_RANGE)
    defect_pixels: set[tuple[int, int]] = set()
    interior_set = set(interior_blue)
    defects_placed = 0

    for _ in range(n_defects):
        if not interior_blue:
            break
        defect_size = random.choices([1, 2, 3], weights=DEFECT_SIZE_WEIGHTS)[0]

        placed = False
        for _try in range(DEFECT_PLACE_TRIES):
            if not interior_blue:
                break
            seed_r, seed_c = interior_blue[random.randint(0, len(interior_blue) - 1)]

            if _nearby(seed_r, seed_c, DEFECT_CLEARANCE, defect_pixels):
                continue

            # Grow defect from seed
            defect = [(seed_r, seed_c)]
            if defect_size > 1:
                dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
                random.shuffle(dirs)
                for dr, dc in dirs:
                    nr, nc = seed_r + dr, seed_c + dc
                    if (nr, nc) not in interior_set or (nr, nc) in defect_pixels:
                        continue
                    # Check neighbor is surrounded by blue (except the seed)
                    ok = True
                    for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                        rr, cc = nr + dr2, nc + dc2
                        if (rr, cc) == (seed_r, seed_c):
                            continue
                        if 0 <= rr < H and 0 <= cc < W:
                            if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:
                                ok = False
                                break
                    if ok and not _nearby(nr, nc, DEFECT_CLEARANCE, defect_pixels):
                        defect.append((nr, nc))
                        if len(defect) >= defect_size:
                            break

            # Validate: every non-defect 4-neighbor of every defect pixel must be blue
            defect_set = set(defect)
            valid = True
            for r, c in defect:
                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                    rr, cc = r + dr, c + dc
                    if (rr, cc) in defect_set:
                        continue
                    if 0 <= rr < H and 0 <= cc < W:
                        if grid[rr, cc] != 1 or (rr, cc) in defect_pixels:
                            valid = False
                            break
                if not valid:
                    break

            if valid:
                defect_pixels.update(defect)
                defects_placed += 1
                placed = True
                remove = _exclusion_zone(defect, DEFECT_CLEARANCE)
                interior_blue[:] = [p for p in interior_blue if p not in remove]
                interior_set -= remove
                break

    return defect_pixels, defects_placed


def _place_leaves(grid: np.ndarray, defect_pixels: set) -> set:
    """Place 0-4 leaf protrusions from large black regions into blue regions."""
    H, W = grid.shape
    n_leaves = random.randint(*LEAF_COUNT_RANGE)
    leaf_pixels: set[tuple[int, int]] = set()

    black_comps = components_mask(grid == 0, connectivity=4)
    large_black = [c for c in black_comps if len(c) > 3]

    for _ in range(n_leaves):
        if not large_black:
            break
        comp_set = set((int(r), int(c)) for r, c in random.choice(large_black))

        # Find blue pixels adjacent to this component that would be valid leaves
        candidates = []
        for r, c in comp_set:
            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                rr, cc = r + dr, c + dc
                if not (0 <= rr < H and 0 <= cc < W) or grid[rr, cc] != 1:
                    continue
                if (rr, cc) in defect_pixels or (rr, cc) in leaf_pixels:
                    continue
                # Count black 4-neighbors of the candidate pixel
                black_n = sum(
                    1 for dr2, dc2 in [(-1, 0), (1, 0), (0, -1), (0, 1)]
                    if 0 <= rr + dr2 < H and 0 <= cc + dc2 < W
                    and (grid[rr + dr2, cc + dc2] == 0 or (rr + dr2, cc + dc2) in leaf_pixels))
                if black_n == 1:
                    candidates.append((rr, cc))

        if candidates:
            lr, lc = random.choice(candidates)
            if not _nearby(lr, lc, DEFECT_CLEARANCE, defect_pixels):
                leaf_pixels.add((lr, lc))
                grid[lr, lc] = 0

    return leaf_pixels


def _build_halo(grid: np.ndarray, preserve: set) -> np.ndarray:
    """Paint orange (7) Chebyshev-1 halo around preserve pixels; keep them black."""
    H, W = grid.shape
    output = grid.copy()
    for r, c in preserve:
        for dr in range(-1, 2):
            for dc in range(-1, 2):
                rr, cc = r + dr, c + dc
                if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in preserve:
                    output[rr, cc] = 7
    for r, c in preserve:
        output[r, c] = 0
    return output


def _find_spur_candidates(grid: np.ndarray, exclude: set) -> list[tuple[int, int]]:
    """Find black pixels eligible to become blue spurs (solver's STEP 0 absorbs them).

    A pixel qualifies if it has >= 3 effective black 4-neighbors, matching the
    solver's absorption logic (OOB counts as black only at corners with >= 2 OOB sides).
    """
    H, W = grid.shape
    black = grid == 0

    # Count in-bounds black 4-neighbors via shifts
    nb = np.zeros((H, W), dtype=int)
    nb[:-1, :] += black[1:, :]
    nb[1:, :]  += black[:-1, :]
    nb[:, :-1] += black[:, 1:]
    nb[:, 1:]  += black[:, :-1]

    # Count out-of-bounds sides
    oob = np.zeros((H, W), dtype=int)
    oob[0, :] += 1; oob[-1, :] += 1; oob[:, 0] += 1; oob[:, -1] += 1

    # Effective count: add oob only when >= 2 (corner pixels)
    effective = nb.copy()
    effective[oob >= 2] += oob[oob >= 2]

    # Eligible: black, effective >= 3, not in exclude set
    rs, cs = np.where(black & (effective >= 3))
    candidates = [(int(r), int(c)) for r, c in zip(rs, cs)
                  if (r, c) not in exclude]
    random.shuffle(candidates)
    return candidates


def _gen_attempt() -> np.ndarray | None:
    """Single attempt to generate a valid input grid for task 71e489b6."""
    H = random.randint(*GRID_H_RANGE)
    W = random.randint(*GRID_W_RANGE)

    # Step 1: Build region partition
    grid = _build_partition(H, W)

    # Validate region sizes
    for comp in components_mask(grid == 1, connectivity=4):
        if len(comp) < MIN_BLUE_REGION:
            return None
    for comp in components_mask(grid == 0, connectivity=4):
        if len(comp) < MIN_BLACK_REGION:
            return None

    # Step 2: Place defects
    interior_blue = _find_interior_blue(grid)
    defect_pixels, defects_placed = _place_defects(grid, interior_blue)
    if defects_placed < MIN_DEFECTS:
        return None
    for r, c in defect_pixels:
        grid[r, c] = 0

    # Step 3: Place leaves
    leaf_pixels = _place_leaves(grid, defect_pixels)

    # Step 4: Build expected output
    preserve = defect_pixels | leaf_pixels
    output = _build_halo(grid, preserve)

    # Step 5: Add spurs to derive input
    inp = grid.copy()
    n_spurs = random.randint(*SPUR_COUNT_RANGE)
    candidates = _find_spur_candidates(inp, defect_pixels | leaf_pixels)
    for r, c in candidates[:n_spurs]:
        inp[r, c] = 1
    if min(n_spurs, len(candidates)) < MIN_SPURS:
        return None

    # Step 6: Oracle check
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        pass
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GEN_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {MAX_GEN_ATTEMPTS} attempts")
from collections import deque

import numpy as np

from arc_utils import Color, in_bounds, neighbors4, neighbors8
import random


def _distances(passable: np.ndarray, start: tuple[int, int]) -> dict[tuple[int, int], int]:
    q = deque([start])
    dist = {start: 0}
    while q:
        r, c = q.popleft()
        for nr, nc in neighbors4(r, c):
            if in_bounds(passable.shape, nr, nc) and passable[nr, nc]:
                nxt = (nr, nc)
                if nxt not in dist:
                    dist[nxt] = dist[(r, c)] + 1
                    q.append(nxt)
    return dist


def _unique_shortest_path(
    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
) -> set[tuple[int, int]]:
    dist_start = _distances(passable, start)
    assert end in dist_start
    dist_end = _distances(passable, end)
    length = dist_start[end]
    path = {
        p
        for p in dist_start
        if p in dist_end and dist_start[p] + dist_end[p] == length
    }
    assert len(path) == length + 1
    return path


def _has_unique_simple_path(
    passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]
) -> bool:
    stack = [(start, {start})]
    count = 0
    while stack:
        (r, c), seen = stack.pop()
        if (r, c) == end:
            count += 1
            if count > 1:
                return False
            continue
        for nr, nc in neighbors4(r, c):
            nxt = (nr, nc)
            if in_bounds(passable.shape, nr, nc) and passable[nr, nc] and nxt not in seen:
                stack.append((nxt, seen | {nxt}))
    return count == 1


def main(grid: np.ndarray) -> np.ndarray:
    """Recolor the unique safe route between the two maroon endpoints from teal to maroon.

    Input structure
    - A black background contains a teal 4-connected track, exactly two maroon endpoint pixels, and one or more orange blocker pixels embedded near the track.

    Rule
    - Treat each orange blocker and its 8-neighborhood as forbidden.
    - In the remaining teal/maroon track graph, there is exactly one simple
      4-connected path between the maroon endpoints.
    - Recolor teal pixels on that path to maroon; leave endpoints, blockers, and all other cells unchanged.

    Key insight
    - The orange pixels block nearby teal cells diagonally as well as orthogonally, which removes shorter decoy routes and makes the intended endpoint-to-endpoint path unique.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    assert set(map(int, np.unique(g))) <= {
        Color.BLACK,
        Color.ORANGE,
        Color.TEAL,
        Color.MAROON,
    }

    endpoints = [tuple(map(int, p)) for p in np.argwhere(g == Color.MAROON)]
    blockers = [tuple(map(int, p)) for p in np.argwhere(g == Color.ORANGE)]
    assert len(endpoints) == 2
    assert blockers

    forbidden = np.zeros(g.shape, dtype=bool)
    for r, c in blockers:
        forbidden[r, c] = True
        for nr, nc in neighbors8(r, c):
            if in_bounds(g.shape, nr, nc):
                forbidden[nr, nc] = True
    assert all(not forbidden[r, c] for r, c in endpoints)

    passable = ((g == Color.TEAL) | (g == Color.MAROON)) & ~forbidden
    assert _has_unique_simple_path(passable, endpoints[0], endpoints[1])
    path = _unique_shortest_path(passable, endpoints[0], endpoints[1])

    out = g.copy()
    for r, c in path:
        if g[r, c] == Color.TEAL:
            out[r, c] = Color.MAROON
    return out

# --------------- generator (att1) ---------------

# Canvas and lattice bounds.
_GEN_HEIGHT_CHOICES = [7, 7, 9, 9, 9]
_GEN_WIDTH = 9
_GEN_BAR_ROW_START = 1
_GEN_BAR_ROW_STEP = 2
_GEN_BAR_COUNT_BY_HEIGHT = {7: [3], 9: [3, 4]}
_GEN_BAR_START_COL_RANGE = (1, 2)
_GEN_BAR_END_OFFSET_RANGE = (3, 2)
_GEN_MAX_BAR_GAPS = 2

# Connector and endpoint search limits.
_GEN_MIN_CONNECTORS = 2
_GEN_MAX_CONNECTORS = 5
_GEN_ENDPOINT_PRIMARY_LIMIT = 8
_GEN_ENDPOINT_SECONDARY_LIMIT = 10
_GEN_TARGET_PATH_RANGE = (12, 20)
_GEN_FALLBACK_MIN_DISTANCE = 10

# Track, blocker, and validation constraints.
_GEN_TRACK_SIZE_RANGE = (26, 42)
_GEN_BLOCKER_CHOICES = [1, 2]
_GEN_MIN_BLOCKER_ADJACENCY = 2
_GEN_BLOCKER_TRIES_FACTOR = 3
_GEN_MAX_BLOCKER_TRIES = 50
_GEN_BLOCKER_SEPARATION = 2
_GEN_COVERAGE_RANGE = (0.45, 0.72)
_GEN_TURN_RANGE = (2, 8)
_GEN_MAX_ATTEMPTS = 300

_GEN_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def _gen_bfs_dist(track_set, start):
    """BFS distances from start over track_set."""
    dist = {start: 0}
    q = deque([start])
    while q:
        r, c = q.popleft()
        for dr, dc in _GEN_DIRS4:
            nr, nc = r+dr, c+dc
            if (nr, nc) in track_set and (nr, nc) not in dist:
                dist[(nr, nc)] = dist[(r, c)] + 1
                q.append((nr, nc))
    return dist


def _gen_path_cells(track_set, start, end):
    """Return (set of cells on ALL shortest paths, path_length) for uniqueness check."""
    dist_s = _gen_bfs_dist(track_set, start)
    if end not in dist_s:
        return None, None
    dist_e = _gen_bfs_dist(track_set, end)
    length = dist_s[end]
    cells = {p for p in dist_s if p in dist_e and dist_s[p] + dist_e[p] == length}
    return cells, length


def _gen_has_unique_simple_path(track_set, start, end):
    """Return True iff exactly one simple path connects start to end."""
    stack = [(start, {start})]
    count = 0
    while stack:
        cell, seen = stack.pop()
        if cell == end:
            count += 1
            if count > 1:
                return False
            continue
        r, c = cell
        for dr, dc in _GEN_DIRS4:
            nxt = (r + dr, c + dc)
            if nxt in track_set and nxt not in seen:
                stack.append((nxt, seen | {nxt}))
    return count == 1


def _gen_choose_layout():
    """Choose grid size and horizontal bar columns."""
    H = random.choice(_GEN_HEIGHT_CHOICES)
    W = _GEN_WIDTH
    if H == 7:
        n_bars = _GEN_BAR_COUNT_BY_HEIGHT[H][0]
    else:
        n_bars = random.choice(_GEN_BAR_COUNT_BY_HEIGHT[H])
    bar_rows = [
        _GEN_BAR_ROW_START + _GEN_BAR_ROW_STEP * i for i in range(n_bars)
    ]
    if bar_rows[-1] >= H:
        return None

    bar_cols = []
    for _ in range(n_bars):
        c_start = random.randint(*_GEN_BAR_START_COL_RANGE)
        c_end = random.randint(
            W - _GEN_BAR_END_OFFSET_RANGE[0],
            W - _GEN_BAR_END_OFFSET_RANGE[1],
        )
        cols = list(range(c_start, c_end + 1))
        n_gaps = random.randint(0, _GEN_MAX_BAR_GAPS)
        interior = [c for c in cols if c != c_start and c != c_end]
        if n_gaps > 0 and len(interior) >= n_gaps * 2:
            gap_candidates = interior[:]
            random.shuffle(gap_candidates)
            gaps_chosen = []
            for gc in gap_candidates:
                if len(gaps_chosen) >= n_gaps:
                    break
                if all(abs(gc - g) > 1 for g in gaps_chosen):
                    gaps_chosen.append(gc)
            for gc in gaps_chosen:
                cols.remove(gc)
        bar_cols.append(set(cols))

    return H, W, bar_rows, bar_cols


def _gen_build_lattice(bar_rows, bar_cols):
    """Build connected horizontal bars plus vertical connectors."""
    track = set()
    for i, row in enumerate(bar_rows):
        for c in bar_cols[i]:
            track.add((row, c))

    for i in range(len(bar_rows) - 1):
        top_row = bar_rows[i]
        bot_row = bar_rows[i + 1]
        shared_cols = sorted(bar_cols[i] & bar_cols[i + 1])
        if len(shared_cols) < _GEN_MIN_CONNECTORS:
            return None
        n_conn = random.randint(
            _GEN_MIN_CONNECTORS, min(_GEN_MAX_CONNECTORS, len(shared_cols))
        )
        if len(shared_cols) >= 3 and n_conn >= _GEN_MIN_CONNECTORS:
            chosen = [shared_cols[0], shared_cols[-1]]
            mid = shared_cols[1:-1]
            random.shuffle(mid)
            chosen += mid[:n_conn - 2]
        else:
            chosen = random.sample(shared_cols, n_conn)

        for c in chosen:
            for r in range(top_row, bot_row + 1):
                track.add((r, c))

    if not track:
        return None
    start_cell = next(iter(track))
    visited = _gen_bfs_dist(track, start_cell)
    if len(visited) != len(track):
        return None
    return track


def _gen_border_candidates(track, H, W, bar_rows, bar_cols):
    """Find possible endpoint stems from lattice cells to the border."""
    border_candidates = []
    for (r, c) in track:
        if r == bar_rows[0]:
            if all((rr, c) not in track for rr in range(0, r)):
                border_candidates.append(((r, c), (0, c), 'top', r))
        if r == bar_rows[-1]:
            if all((rr, c) not in track for rr in range(r + 1, H)):
                border_candidates.append(((r, c), (H - 1, c), 'bot', H - 1 - r))
        bar_idx = bar_rows.index(r) if r in bar_rows else -1
        if bar_idx >= 0:
            if c == min(bar_cols[bar_idx]):
                if all((r, cc) not in track for cc in range(0, c)):
                    border_candidates.append(((r, c), (r, 0), 'left', c))
            if c == max(bar_cols[bar_idx]):
                if all((r, cc) not in track for cc in range(c + 1, W)):
                    border_candidates.append(((r, c), (r, W - 1), 'right', W - 1 - c))
    return border_candidates


def _gen_pair_distance(track, c1, c2):
    att1, _, _, stem_len1 = c1
    att2, _, _, stem_len2 = c2
    d = _gen_bfs_dist(track, att1)
    if att2 not in d:
        return None
    return d[att2] + stem_len1 + stem_len2


def _gen_choose_endpoints(track, border_candidates):
    """Pick two border endpoints whose stem-adjusted distance is task-like."""
    if len(border_candidates) < 2:
        return None
    random.shuffle(border_candidates)

    best_pair = None
    best_dist = 0
    for i in range(min(_GEN_ENDPOINT_PRIMARY_LIMIT, len(border_candidates))):
        for j in range(
            i + 1, min(_GEN_ENDPOINT_SECONDARY_LIMIT, len(border_candidates))
        ):
            c1 = border_candidates[i]
            c2 = border_candidates[j]
            total_d = _gen_pair_distance(track, c1, c2)
            if total_d is None:
                continue
            if (
                _GEN_TARGET_PATH_RANGE[0] <= total_d <= _GEN_TARGET_PATH_RANGE[1]
                and total_d > best_dist
            ):
                best_dist = total_d
                best_pair = (c1, c2)

    if best_pair is None:
        for i in range(len(border_candidates)):
            for j in range(i + 1, len(border_candidates)):
                c1 = border_candidates[i]
                c2 = border_candidates[j]
                total_d = _gen_pair_distance(track, c1, c2)
                if total_d is None:
                    continue
                if total_d >= _GEN_FALLBACK_MIN_DISTANCE:
                    best_pair = (c1, c2)
                    best_dist = total_d
                    break
            if best_pair:
                break
    return best_pair


def _gen_add_stem(track, attachment, side, H, W):
    r, c = attachment
    if side == 'top':
        for sr in range(0, r):
            track.add((sr, c))
    elif side == 'bot':
        for sr in range(r + 1, H):
            track.add((sr, c))
    elif side == 'left':
        for sc in range(0, c):
            track.add((r, sc))
    elif side == 'right':
        for sc in range(c + 1, W):
            track.add((r, sc))


def _gen_add_and_validate_endpoints(track, best_pair, H, W):
    """Add stems and return endpoint cells if they satisfy degree/border checks."""
    ep1_info, ep2_info = best_pair
    att1, pos1, side1, _ = ep1_info
    att2, pos2, side2, _ = ep2_info
    _gen_add_stem(track, att1, side1, H, W)
    _gen_add_stem(track, att2, side2, H, W)
    endpoint_cells = [pos1, pos2]

    for ep in endpoint_cells:
        deg = sum(1 for dr, dc in _GEN_DIRS4
                  if (ep[0]+dr, ep[1]+dc) in track)
        if deg != 1:
            return None

    for ep in endpoint_cells:
        if not (ep[0] == 0 or ep[0] == H - 1 or ep[1] == 0 or ep[1] == W - 1):
            return None
    return endpoint_cells


def _gen_blocker_candidates(track, endpoint_cells, H, W):
    """Find interior track cells that can act as orange blockers."""
    blocker_candidates = []
    for (r, c) in track:
        if (r, c) in endpoint_cells:
            continue
        if r <= 0 or r >= H - 1 or c <= 0 or c >= W - 1:
            continue
        nbr8 = [(r+dr, c+dc) for dr in [-1,0,1] for dc in [-1,0,1] if (dr,dc) != (0,0)]
        if any(n in endpoint_cells for n in nbr8):
            continue
        adj_track = sum(1 for dr, dc in _GEN_DIRS4 if (r+dr, c+dc) in track)
        if adj_track < _GEN_MIN_BLOCKER_ADJACENCY:
            continue
        blocker_candidates.append((r, c))
    return blocker_candidates


def _gen_forbidden(blockers):
    forbidden = set()
    for br, bc in blockers:
        for dr in [-1, 0, 1]:
            for dc in [-1, 0, 1]:
                forbidden.add((br + dr, bc + dc))
    return forbidden


def _gen_choose_blockers(n_blockers, blocker_candidates, attempt):
    if n_blockers == 1:
        idx = attempt % len(blocker_candidates)
        return [blocker_candidates[idx]]

    idx1 = random.randint(0, len(blocker_candidates) - 1)
    idx2 = random.randint(0, len(blocker_candidates) - 1)
    if idx1 == idx2:
        return None
    blockers = [blocker_candidates[idx1], blocker_candidates[idx2]]
    r1, c1 = blockers[0]
    r2, c2 = blockers[1]
    if (
        abs(r1-r2) <= _GEN_BLOCKER_SEPARATION
        and abs(c1-c2) <= _GEN_BLOCKER_SEPARATION
    ):
        return None
    return blockers


def _gen_ordered_path(passable, start, end, path_cells):
    """Order a unique shortest path from end back to start using BFS ranks."""
    dist_s = _gen_bfs_dist(passable, start)
    path_ordered = [end]
    current = end
    ok = True
    while current != start:
        found = False
        for dr, dc in _GEN_DIRS4:
            nxt = (current[0]+dr, current[1]+dc)
            if nxt in path_cells and dist_s.get(nxt, -1) == dist_s[current] - 1:
                path_ordered.append(nxt)
                current = nxt
                found = True
                break
        if not found:
            ok = False
            break
    return path_ordered if ok else None


def _gen_turn_count(path_ordered):
    turns = 0
    for k in range(1, len(path_ordered) - 1):
        d1 = (path_ordered[k][0] - path_ordered[k-1][0], path_ordered[k][1] - path_ordered[k-1][1])
        d2 = (path_ordered[k+1][0] - path_ordered[k][0], path_ordered[k+1][1] - path_ordered[k][1])
        if d1 != d2:
            turns += 1
    return turns


def _gen_validate_blocked_path(track, endpoint_cells, forbidden):
    passable = track - forbidden

    if endpoint_cells[0] not in passable or endpoint_cells[1] not in passable:
        return False

    if not _gen_has_unique_simple_path(passable, endpoint_cells[0], endpoint_cells[1]):
        return False

    path_cells, path_length = _gen_path_cells(passable, endpoint_cells[0], endpoint_cells[1])
    if path_cells is None:
        return False

    if len(path_cells) != path_length + 1:
        return False

    if path_length < _GEN_TARGET_PATH_RANGE[0] or path_length > _GEN_TARGET_PATH_RANGE[1]:
        return False

    coverage = len(path_cells) / len(track)
    if coverage < _GEN_COVERAGE_RANGE[0] or coverage > _GEN_COVERAGE_RANGE[1]:
        return False

    path_ordered = _gen_ordered_path(
        passable, endpoint_cells[0], endpoint_cells[1], path_cells
    )
    if path_ordered is None or len(path_ordered) != path_length + 1:
        return False

    turns = _gen_turn_count(path_ordered)
    return _GEN_TURN_RANGE[0] <= turns <= _GEN_TURN_RANGE[1]


def _gen_render_grid(track, endpoint_cells, blockers, H, W):
    grid = np.zeros((H, W), dtype=int)
    blocker_set = set(blockers)
    for (r, c) in track:
        if (r, c) in endpoint_cells:
            grid[r, c] = Color.MAROON
        elif (r, c) in blocker_set:
            grid[r, c] = Color.ORANGE
        else:
            grid[r, c] = Color.TEAL
    return grid


def _gen_try_blockers(track, endpoint_cells, H, W):
    """Place blockers, validate the unique route, and return a rendered grid."""
    n_blockers = random.choice(_GEN_BLOCKER_CHOICES)
    blocker_candidates = _gen_blocker_candidates(track, endpoint_cells, H, W)
    if len(blocker_candidates) < n_blockers:
        return None

    random.shuffle(blocker_candidates)

    for attempt in range(
        min(
            _GEN_MAX_BLOCKER_TRIES,
            len(blocker_candidates) * _GEN_BLOCKER_TRIES_FACTOR,
        )
    ):
        blockers = _gen_choose_blockers(n_blockers, blocker_candidates, attempt)
        if blockers is None:
            continue

        forbidden = _gen_forbidden(blockers)
        if any(ep in forbidden for ep in endpoint_cells):
            continue

        if not _gen_validate_blocked_path(track, endpoint_cells, forbidden):
            continue

        grid = _gen_render_grid(track, endpoint_cells, blockers, H, W)
        try:
            out = main(grid)
            if out is None:
                continue
        except (AssertionError, Exception):
            continue
        return grid

    return None


def _gen_attempt():
    """Single attempt to generate a valid input grid."""
    layout = _gen_choose_layout()
    if layout is None:
        return None
    H, W, bar_rows, bar_cols = layout

    track = _gen_build_lattice(bar_rows, bar_cols)
    if track is None:
        return None

    border_candidates = _gen_border_candidates(track, H, W, bar_rows, bar_cols)
    best_pair = _gen_choose_endpoints(track, border_candidates)
    if best_pair is None:
        return None

    endpoint_cells = _gen_add_and_validate_endpoints(track, best_pair, H, W)
    if endpoint_cells is None:
        return None

    if len(track) < _GEN_TRACK_SIZE_RANGE[0] or len(track) > _GEN_TRACK_SIZE_RANGE[1]:
        return None

    return _gen_try_blockers(track, endpoint_cells, H, W)


def generate_input() -> np.ndarray:
    """Generate a valid input grid for the maze shortest-path task."""
    for _ in range(_GEN_MAX_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {_GEN_MAX_ATTEMPTS} attempts")

