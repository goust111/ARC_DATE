+
+
+def _build_case(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    tile_rows, tile_cols = LAYOUTS[int(rng.integers(0, len(LAYOUTS)))]
+    tile_count = tile_rows * tile_cols
+    tile_h = int(rng.integers(*TILE_SIDE_RANGE))
