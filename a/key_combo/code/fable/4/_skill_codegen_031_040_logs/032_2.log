+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = int(_RNG.integers(27, 31))
+    w = int(_RNG.integers(27, 31))
+    palette = list(map(int, _RNG.permutation(10)))
+    bg = palette.pop()
