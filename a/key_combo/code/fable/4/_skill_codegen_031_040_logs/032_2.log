+def _is_square_outline(coords: Iterable[Coord]) -> bool:
+    points = set(coords)
+    if not points:
+        return False
+    r0, c0, r1, c1 = _bbox(points)
+    side = r1 - r0 + 1
+    return side >= 3 and side == c1 - c0 + 1 and points == _outline_coords((r0, c0, r1, c1))
