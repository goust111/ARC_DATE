def _gen_completed_grid(n: int, bg: int, fg: int) -> np.ndarray:
    side = n * n + GEN_SEPARATOR_WIDTH * (n - 1)
    out = np.full((side, side), bg, dtype=int)
    step = n + GEN_SEPARATOR_WIDTH
