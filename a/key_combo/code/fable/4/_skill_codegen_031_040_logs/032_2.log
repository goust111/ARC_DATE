+        ("dilate", 1),
+        ("dilate", 2),
+        ("same", 0),
+    ]
+    if bool(_RNG.integers(0, 2)):
+        direction = ("shrink", "dilate", "same")[int(_RNG.integers(0, 3))]
+        roles.append((direction, 0 if direction == "same" else int(_RNG.integers(1, 3))))
