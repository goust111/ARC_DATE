+    zones = _zone_grid(h, w)
+    _RNG.shuffle(zones)
+    _RNG.shuffle(roles)
+    inp = np.full((h, w), bg, dtype=int)
+    expected = np.full((h, w), bg, dtype=int)
+    specs: list[dict] = []
