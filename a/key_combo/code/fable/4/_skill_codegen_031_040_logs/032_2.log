+        zone = zones[index]
+        zr0, zc0, zr1, zc1 = zone
+        max_foot = min(zr1 - zr0 - 1, zc1 - zc0 - 1)
+        if direction == "shrink":
+            min_side = 2 * k + 3
+            if min_side > max_foot:
+                return None
+            input_side = int(_RNG.integers(min_side, max_foot + 1))
