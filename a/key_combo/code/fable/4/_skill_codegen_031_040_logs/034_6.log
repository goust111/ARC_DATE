def _gen_band_cells(r0: int, c0: int, size: int, cap_width: int, grow: int, slope: int) -> tuple[np.ndarray, np.ndarray]:
    cells = []
    layers = []
    last_layer = size - cap_width
    for row_offset, left, right in _gen_band_offsets(size, cap_width, grow):
