from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path(\"/home/lixinyu/snap/a/key_combo/code/fable/4/034/6.py\")
mod = SourceFileLoader(\"new_arc_task\", str(p)).load_module()
sigs = set()
out_sigs = set()
shapes = set()
turns_seen = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f\"input grid exceeds 30x30: {inp.shape}\"
    assert out.ndim == 2 and max(out.shape) <= 30, f\"output grid exceeds 30x30: {out.shape}\"
    assert np.array_equal(out, mod._manual_transform(inp))
    assert mod._semantically_valid(inp)
    shapes.add(inp.shape)
    for r, c in np.argwhere(inp == mod.GREY):
        turns_seen.add(mod._quadrant_turns(int(r), int(c), inp.shape[0]))
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
print(\"variants\", len(sigs))
print(\"output_variants\", len(out_sigs))
print(\"input_shapes\", sorted(shapes))
print(\"turns_seen\", sorted(turns_seen))
assert len(sigs) >= 20
assert len(out_sigs) == len(sigs), \"distinct generated inputs must not collapse to identical outputs\"
assert shapes == {(2, 2), (4, 4)}
assert turns_seen == {0, 1, 2, 3}
