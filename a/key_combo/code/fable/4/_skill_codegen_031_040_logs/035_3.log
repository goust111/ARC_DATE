+    rectangles = _decode_rectangles(g, background, bar_rows, bar_cols)
+
+    out = np.full(g.shape, background, dtype=int)
+    for color, r0, c0, r1, c1 in rectangles:
+        out[r0 : r1 + 1, c0 : c1 + 1] = color
+    out[bar_rows, :] = GRAY
+    out[:, bar_cols] = GRAY
+    return out
