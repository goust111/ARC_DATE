+    ordered = list(cells)
+    random.shuffle(ordered)
+    quadrants = [0, 1, 2, 3, 0, 1, 2, 3]
+    quadrants.extend(random.randrange(4) for _ in range(len(ordered) - len(quadrants)))
+    random.shuffle(quadrants)
+    return dict(zip(ordered, quadrants))
+
+
