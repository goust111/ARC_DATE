from __future__ import annotations

import numpy as np

from arc_utils import colors_present
import random


Coord = tuple[int, int]


def _reflection_orbits(shape: tuple[int, int]) -> list[tuple[Coord, ...]]:
    height, width = map(int, shape)
    seen: set[frozenset[Coord]] = set()
    orbits: list[tuple[Coord, ...]] = []

    for r in range(height):
        for c in range(width):
            orbit = frozenset(
                {
                    (r, c),
                    (height - 1 - r, c),
                    (r, width - 1 - c),
                    (height - 1 - r, width - 1 - c),
                }
            )
            if orbit in seen:
                continue
            seen.add(orbit)
            orbits.append(tuple(orbit))

    return orbits


def _missing_color(g: np.ndarray, orbits: list[tuple[Coord, ...]]) -> int:
    candidates: list[int] = []
    for color in colors_present(g):
        valid = True
        for orbit in orbits:
            known = {int(g[r, c]) for r, c in orbit if int(g[r, c]) != color}
            if len(known) != 1:
                valid = False
                break
        if valid:
            candidates.append(int(color))

    assert len(candidates) == 1, "expected exactly one color to behave as the missing-cell marker"
    return candidates[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replace the missing-marker cells so the whole grid has matching horizontal and vertical reflections.

    Input structure:
    - The grid is a complete reflection-symmetric pattern except for cells of one marker color.
    - Under reflection across the horizontal and vertical center lines, each orbit has exactly one non-marker color.
    - The marker color is structurally unique: treating any other color as missing breaks at least one orbit.

    Rule:
    - Group cells by their four-way reflection orbit: original, vertical mirror, horizontal mirror, and 180-degree mirror.
    - Infer the unique marker color whose removal leaves one known color in every orbit.
    - Fill every cell in each orbit with that known color.

    Key insight:
    - The yellow cells are not objects to move; they are holes in a two-axis mirror pattern, and their values are copied from the visible cells in the same reflection orbit.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    orbits = _reflection_orbits(g.shape)
    marker = _missing_color(g, orbits)

    out = g.copy()
    for orbit in orbits:
        known = {int(g[r, c]) for r, c in orbit if int(g[r, c]) != marker}
        assert len(known) == 1, "each reflection orbit must reveal exactly one fill color"
        fill = known.pop()
        for r, c in orbit:
            out[r, c] = fill

    return out

# --------------- generator (o5x) ---------------

# Canvas and palette.
GRID_SIZE, HALF_SIZE = 16, 8
GRID_SHAPE = (GRID_SIZE, GRID_SIZE)
QUADRANT_SHAPE = (HALF_SIZE, HALF_SIZE)
QUADRANT_CELLS = HALF_SIZE * HALF_SIZE
PATTERN_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
OUTPUT_COLOR_COUNTS = (7, 8)
MARKER_COLOR = 4

# Marker rectangle geometry.
RECT_MIN_SIDE, RECT_MAX_SIDE = 2, 4
RECT_MIN_AREA = 6
MARKER_MIN_AREA, MARKER_MAX_AREA = 12, 25
MARKER_BLOCK_COUNT = 2
REGION_COUNT = 4

# Retry policy.
GEN_MAX_ATTEMPTS = 300

Rect = tuple[int, int, int, int]
RectDims = tuple[int, int]

RECT_DIMS = [(h, w) for h in range(RECT_MIN_SIDE, RECT_MAX_SIDE + 1) for w in range(RECT_MIN_SIDE, RECT_MAX_SIDE + 1) if h * w >= RECT_MIN_AREA]
RECT_DIM_PAIRS = [(d1, d2) for d1 in RECT_DIMS for d2 in RECT_DIMS if MARKER_MIN_AREA <= d1[0] * d1[1] + d2[0] * d2[1] <= MARKER_MAX_AREA]


def _gen_reflect_output(top_left: np.ndarray) -> np.ndarray:
    out = np.zeros(GRID_SHAPE, dtype=int)
    out[:HALF_SIZE, :HALF_SIZE] = top_left
    out[:HALF_SIZE, HALF_SIZE:] = np.fliplr(top_left)
    out[HALF_SIZE:, :HALF_SIZE] = np.flipud(top_left)
    out[HALF_SIZE:, HALF_SIZE:] = np.flipud(np.fliplr(top_left))
    return out


def _gen_top_left_quadrant(colors: list[int]) -> np.ndarray:
    flat = np.array([random.choice(colors) for _ in range(QUADRANT_CELLS)], dtype=int)
    for idx, color in zip(random.sample(range(QUADRANT_CELLS), len(colors)), colors):
        flat[idx] = color
    return flat.reshape(QUADRANT_SHAPE)


def _gen_rect_cells(rect: Rect) -> set[tuple[int, int]]:
    r0, c0, h, w = rect
    return {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}


def _gen_orbit_cells(r: int, c: int) -> frozenset[tuple[int, int]]:
    last = GRID_SIZE - 1
    return frozenset({(r, c), (last - r, c), (r, last - c), (last - r, last - c)})


def _gen_has_full_marker_orbit(cells: set[tuple[int, int]]) -> bool:
    return any(_gen_orbit_cells(r, c) <= cells for r, c in cells)


def _gen_rect_options(h: int, w: int, region: int) -> list[Rect]:
    top = region < 2
    left = region % 2 == 0
    row_range = range(1, HALF_SIZE) if top else range(HALF_SIZE, GRID_SIZE - h)
    col_range = range(1, HALF_SIZE) if left else range(HALF_SIZE, GRID_SIZE - w)
    return [(r, c, h, w) for r in row_range for c in col_range]


def _gen_rectangles_have_gap(rect1: Rect, rect2: Rect) -> bool:
    r1, c1, h1, w1 = rect1
    r2, c2, h2, w2 = rect2
    return (
        r1 + h1 < r2
        or r2 + h2 < r1
        or c1 + w1 < c2
        or c2 + w2 < c1
    )


def _gen_valid_rect_pairs(dim1: RectDims, dim2: RectDims, regions: list[int]) -> list[tuple[Rect, Rect]]:
    h1, w1 = dim1
    h2, w2 = dim2
    pair_options = []
    for rect1 in _gen_rect_options(h1, w1, regions[0]):
        cells1 = _gen_rect_cells(rect1)
        for rect2 in _gen_rect_options(h2, w2, regions[1]):
            if not _gen_rectangles_have_gap(rect1, rect2):
                continue
            marker_cells = cells1 | _gen_rect_cells(rect2)
            if not _gen_has_full_marker_orbit(marker_cells):
                pair_options.append((rect1, rect2))
    return pair_options


def _gen_pick_marker_mask() -> np.ndarray | None:
    dim1, dim2 = random.choice(RECT_DIM_PAIRS)
    regions = random.sample(range(REGION_COUNT), MARKER_BLOCK_COUNT)
    pair_options = _gen_valid_rect_pairs(dim1, dim2, regions)

    if not pair_options:
        return None

    mask = np.zeros(GRID_SHAPE, dtype=bool)
    for r, c, h, w in random.choice(pair_options):
        mask[r:r + h, c:c + w] = True
    return mask


def _gen_attempt() -> np.ndarray | None:
    n_colors = random.choice(OUTPUT_COLOR_COUNTS)
    colors = random.sample(PATTERN_COLORS, n_colors)
    output = _gen_reflect_output(_gen_top_left_quadrant(colors))
    marker_mask = _gen_pick_marker_mask()
    if marker_mask is None:
        return None

    inp = output.copy()
    inp[marker_mask] = MARKER_COLOR
    if not np.array_equal(main(inp), output):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b8825c91 input")
import numpy as np

from arc_utils import Color, bbox, bbox_h, bbox_w, crop_bbox
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Recover the hidden 5x5 patch by rotating the scene 180 degrees and cropping the blue-mask location.

    Input structure
    A scene contains exactly one solid 5x5 blue mask over a larger rotationally symmetric pattern.

    Rule
    Locate the blue mask, rotate the whole input grid 180 degrees, and return the 5x5 patch at the mask's original bbox.

    Key insight
    The blue block is an occluder; the hidden pixels are supplied by the opposite 180-degree-corresponding part of the same pattern.
    """
    g = np.asarray(grid, dtype=int)

    mask = g == Color.BLUE
    b = bbox(mask)
    assert b is not None
    assert bbox_h(b) == 5 and bbox_w(b) == 5
    assert int(mask.sum()) == 25
    assert np.all(crop_bbox(mask, b))

    out = crop_bbox(np.rot90(g, 2), b)
    assert out.shape == (5, 5)
    assert not np.any(out == Color.BLUE)
    return out

# --------------- generator (o5x) ---------------

# Canvas, block, and blue-mask geometry.
BLOCK_SIZE, GRID_SIZE, BLUE_SIZE = 6, 24, 5
BLUE_TOP_LEFTS = range(GRID_SIZE - BLUE_SIZE + 1)
OPPOSITE_TOP_LEFT_BASE = GRID_SIZE - BLUE_SIZE
HALF_TURN = 2
# Transpose-symmetric 6x6 block foreground counts.
BLOCK_ON_COUNT_RANGE = (16, 29)
DIAGONAL_CELLS = list(range(BLOCK_SIZE))
TRANSPOSE_PAIRS = [(r, c) for r in range(BLOCK_SIZE) for c in range(r + 1, BLOCK_SIZE)]
# Color sharing modes for A, B, C blocks.
COLOR_POOL = [c for c in range(10) if c not in (Color.BLACK, Color.BLUE)]
COLOR_SHARE_MODES = ("ab", "bc", "abc")
# Generation retry limit.
MAX_GENERATION_ATTEMPTS = 300


def _gen_transpose_mask() -> np.ndarray:
    target = random.randint(*BLOCK_ON_COUNT_RANGE)
    diagonal_choices = [
        d for d in range(BLOCK_SIZE + 1)
        if (target - d) % 2 == 0 and 0 <= (target - d) // 2 <= len(TRANSPOSE_PAIRS)
    ]
    diag_count = random.choice(diagonal_choices)
    pair_count = (target - diag_count) // 2

    mask = np.zeros((BLOCK_SIZE, BLOCK_SIZE), dtype=bool)
    diag_cells = random.sample(DIAGONAL_CELLS, diag_count)
    for i in diag_cells:
        mask[i, i] = True

    for r, c in random.sample(TRANSPOSE_PAIRS, pair_count):
        mask[r, c] = True
        mask[c, r] = True
    return mask


def _gen_color_assignment() -> tuple[int, int, int]:
    mode = random.choice(COLOR_SHARE_MODES)
    if mode == "ab":
        shared, other = random.sample(COLOR_POOL, 2)
        return shared, shared, other
    if mode == "bc":
        other, shared = random.sample(COLOR_POOL, 2)
        return other, shared, shared
    return tuple(random.sample(COLOR_POOL, 3))


def _gen_colored_block(color: int) -> np.ndarray:
    block = np.zeros((BLOCK_SIZE, BLOCK_SIZE), dtype=int)
    block[_gen_transpose_mask()] = color
    return block


def _gen_pattern() -> np.ndarray:
    color_a, color_b, color_c = _gen_color_assignment()
    block_a = _gen_colored_block(color_a)
    block_b = _gen_colored_block(color_b)
    block_c = _gen_colored_block(color_c)
    q1 = np.block([[block_a, block_b], [block_b, block_c]])
    top = np.concatenate([q1, np.fliplr(q1)], axis=1)
    bottom = np.flipud(top)
    return np.concatenate([top, bottom], axis=0)


def _gen_blue_position(pattern: np.ndarray) -> tuple[int, int] | None:
    positions = []
    for r in BLUE_TOP_LEFTS:
        for c in BLUE_TOP_LEFTS:
            rr, cc = OPPOSITE_TOP_LEFT_BASE - r, OPPOSITE_TOP_LEFT_BASE - c
            row_overlap = max(r, rr) <= min(r + BLUE_SIZE - 1, rr + BLUE_SIZE - 1)
            col_overlap = max(c, cc) <= min(c + BLUE_SIZE - 1, cc + BLUE_SIZE - 1)
            if row_overlap and col_overlap:
                continue
            opposite_patch = pattern[rr : rr + BLUE_SIZE, cc : cc + BLUE_SIZE]
            if np.any(opposite_patch != Color.BLACK):
                positions.append((r, c))
    if not positions:
        return None
    return random.choice(positions)


def _gen_attempt() -> np.ndarray | None:
    pattern = _gen_pattern()
    pos = _gen_blue_position(pattern)
    if pos is None:
        return None

    r, c = pos
    inp = pattern.copy()
    inp[r : r + BLUE_SIZE, c : c + BLUE_SIZE] = Color.BLUE
    expected = np.rot90(pattern, HALF_TURN)[r : r + BLUE_SIZE, c : c + BLUE_SIZE]
    got = main(inp)
    if not np.array_equal(got, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate ff805c23 input")
import numpy as np
import random
from arc_utils import Color, bbox, bbox_anchor, crop_bbox, draw_line, find_components, first_free_location, object_interior, paste, random_sprite


# concepts:
# filling, topology

# description:
# The input is a black 12x12 grid containing a few grey squares. Each square has a "hole" in it, a contiguous black region of pixels.
# To create the output, fill in the hole of each grey object with red if the hole is a square. Otherwise, leave the hole as is.

def main(input_grid):
    """
    Fill only square-shaped holes inside gray square objects with red.

    Input structure:
    - The grid is black with multiple gray square objects.
    - Each gray object may contain a contiguous black hole inside it.
    - Some holes are solid square blocks and others are irregular.

    Rule:
    - Detect each gray object and crop it to its bounding box.
    - Compute the enclosed black interior mask.
    - Recolor the hole red only when its bounding box is square and completely filled.

    Key insight:
    - The decision is based on the hole's own geometry, not on the outer gray square.
    """
    # get the grey squares
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
    output_grid = input_grid.copy()

    for obj in objects:
        b = bbox(obj != Color.BLACK)
        if b is None:
            continue
        r0, c0, r1, c1 = b
        sprite = crop_bbox(obj, b)

        # Identify the black hole(s) inside the grey object.
        hole_mask = (sprite == Color.BLACK) & object_interior(sprite, background=Color.BLACK)

        hb = bbox(hole_mask)
        if hb is not None:
            hr0, hc0, hr1, hc1 = hb
            hh = hr1 - hr0 + 1
            hw = hc1 - hc0 + 1
            hole_crop = hole_mask[hr0 : hr1 + 1, hc0 : hc1 + 1]
            if hh == hw and int(hole_crop.sum()) == hh * hw:
                sprite[hole_mask] = Color.RED

        output_grid = paste(output_grid, sprite, r0, c0, transparent=Color.BLACK)

    return output_grid


def generate_input():
    # create a 12x12 black grid
    grid = np.full((12, 12), Color.BLACK)

    # add 2-3 grey squares.
    # For each grey square, add a hole in the middle.
    # 50% chance the hole is a square, otherwise it's a random contiguous object.
    # The hole should not overlap with the border of the square.

    num_grey_squares = np.random.randint(2, 4)

    for _ in range(num_grey_squares):
        # create grey square, and try to find a location for it
        length = np.random.randint(4, 6)
        grey_square = np.full((length, length), Color.GREY)
        try:
            _loc = first_free_location(grid, grey_square, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        except ValueError:
            # we were unable to find a space for a square; try over from scratch
            return generate_input()

        # # add a hole in the middle.
        # # 50% chance the hole is a square, otherwise it's a random contiguous object.
        # # The hole should not overlap with the border of the square.
        has_square_hole = np.random.choice([True, False])
        if has_square_hole:
            hole_size = np.random.randint(1, length - 1)
            hole_r, hole_c = np.random.randint(1, length - hole_size), np.random.randint(1, length - hole_size)
            grey_square[hole_r:hole_r + hole_size, hole_c:hole_c + hole_size] = Color.BLACK
        else:
            hole_obj = random_sprite(length-2, length-2, color_palette=[Color.BLACK], background=Color.GREY)
            grey_square[1:-1, 1:-1] = hole_obj

        grid = paste(grid, grey_square, r, c, transparent=Color.BLACK, clip=True)

    return grid
