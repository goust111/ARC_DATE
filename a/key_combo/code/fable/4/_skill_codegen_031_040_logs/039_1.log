+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+def _orbit(r: int, c: int, side: int) -> tuple[Coord, Coord, Coord, Coord]:
+    """Return one orbit in TL, TR, BL, BR order in full-canvas coordinates."""
+    return (
+        (r, c),
+        (r, side - 1 - c),
+        (side - 1 - r, c),
+        (side - 1 - r, side - 1 - c),
+    )
