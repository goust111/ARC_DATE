+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    bbox_area = (max(rows) - min(rows) + 1) * (max(cols) - min(cols) + 1)
+    if len(set(rows)) < 3 or len(set(cols)) < 3:
+        return None
+    if len(cells) == bbox_area or not _axis_asymmetric(cells):
