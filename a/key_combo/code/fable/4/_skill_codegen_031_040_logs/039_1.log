import numpy as np

from arc_utils import Color, colors_present, components_mask, find_components, flood_fill, get_bg
import random


def _paint_exterior_background(out: np.ndarray, bg: int) -> None:
    height, width = out.shape

    for r in range(height):
        for c in (0, width - 1):
            if int(out[r, c]) == bg:
                flood_fill(out, r, c, Color.GREEN, connectivity=4)

    for c in range(width):
        for r in (0, height - 1):
            if int(out[r, c]) == bg:
                flood_fill(out, r, c, Color.GREEN, connectivity=4)


def main(grid: np.ndarray) -> np.ndarray:
    """Color exterior background green and enclosed background regions red around the line object.

    Input structure
    - The grid has black background and one non-background color.
    - The non-background pixels form one 4-connected orthogonal line object.

    Rule
    - Preserve the colored line object.
    - Treat the line object as a wall: background connected to the grid border is exterior and becomes green.
    - Background not 4-connected to the border is enclosed by the line object and becomes red.

    Key insight
    - This is a wall flood-fill task: flood from the boundary to identify exterior background, then the remaining background cells are holes.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    assert bg == Color.BLACK
    assert len(colors_present(g, exclude={bg})) == 1
    assert len(find_components(g, bg=bg, connectivity=4, monochromatic=False)) == 1

    out = g.copy()
    _paint_exterior_background(out, bg)

    enclosed = out == bg
    assert bool(enclosed.any())
    out[enclosed] = Color.RED
    return out

# --------------- generator (o5x) ---------------

# Canvas and palette.
GEN_HEIGHT_RANGE, GEN_WIDTH_RANGE = (21, 25), (21, 25)
GEN_LINE_COLORS = [Color.BLUE, Color.YELLOW, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]

# Line counts and spacing.
GEN_H_COUNT_CHOICES, GEN_ENCLOSED_COUNT_CHOICES = [4, 5], [2, 3]
GEN_TOTAL_SEGMENT_RANGE, GEN_H_LEN_RANGE, GEN_V_LEN_RANGE = (7, 9), (5, 25), (7, 22)
def _gen_exterior_map(grid):
    exterior = grid.copy()
    _paint_exterior_background(exterior, Color.BLACK)
    return exterior


def _gen_enclosed_regions(grid):
    exterior = _gen_exterior_map(grid)
    return [len(coords) for coords in components_mask(exterior == Color.BLACK, connectivity=4)]


def _gen_segment_intersections(h_segments, v_segments):
    count = 0
    for row, c0, c1 in h_segments:
        for col, r0, r1 in v_segments:
            if c0 <= col <= c1 and r0 <= row <= r1:
                count += 1
    return count


def _gen_validate_segment_specs(h_segments, v_segments):
    h_lens = [c1 - c0 + 1 for _, c0, c1 in h_segments]
    v_lens = [r1 - r0 + 1 for _, r0, r1 in v_segments]
    return (
        len(h_segments) in GEN_H_COUNT_CHOICES
        and 3 <= len(v_segments) <= 5
        and _gen_between(len(h_segments) + len(v_segments), GEN_TOTAL_SEGMENT_RANGE)
        and not any(not _gen_between(length, GEN_H_LEN_RANGE) for length in h_lens)
        and not any(not _gen_between(length, GEN_V_LEN_RANGE) for length in v_lens)
    )


def _gen_validate_grid_geometry(grid, color):
    fg = grid == color
    ratio = float(fg.sum()) / float(grid.size)
    if not _gen_between(ratio, GEN_FG_RATIO_RANGE):
        return False
    if np.any(
        fg[:-1, :-1].astype(int)
        + fg[1:, :-1].astype(int)
        + fg[:-1, 1:].astype(int)
        + fg[1:, 1:].astype(int)
        == 4
    ):
        return False

    comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=False)
    return len(comps) == 1


def _gen_validate_graph_topology(grid, color, h_segments, v_segments):
    intersections = _gen_segment_intersections(h_segments, v_segments)
    endpoints, border_endpoints, border_count, degree3, degree4 = _gen_degree_counts(grid, color)
    if not (
        _gen_between(intersections, GEN_INTERSECTION_RANGE)
        and _gen_between(endpoints, GEN_ENDPOINT_RANGE)
        and _gen_between(border_endpoints, GEN_BORDER_ENDPOINT_RANGE)
        and _gen_between(border_count, GEN_TOUCHED_BORDER_RANGE)
    ):
        return False
    if degree3 > GEN_MAX_DEGREE3 or degree3 + degree4 != intersections:
        return False

    enclosed = _gen_enclosed_regions(grid)
    return (
        len(enclosed) in GEN_ENCLOSED_COUNT_CHOICES
        and not any(not _gen_between(size, GEN_ENCLOSED_SIZE_RANGE) for size in enclosed)
        and max(enclosed) >= GEN_MIN_LARGE_ENCLOSED
    )


def _gen_matches_solver(grid):
    try:
        out = main(grid)
    except AssertionError:
        return False
    expected = grid.copy()
    exterior = _gen_exterior_map(grid)
    expected[exterior == Color.BLACK] = Color.RED
    expected[exterior == Color.GREEN] = Color.GREEN
    return np.array_equal(out, expected)


def _gen_validate(grid, color, h_segments, v_segments):
    return (
        _gen_validate_segment_specs(h_segments, v_segments)
        and _gen_validate_grid_geometry(grid, color)
        and _gen_validate_graph_topology(grid, color, h_segments, v_segments)
        and _gen_matches_solver(grid)
    )


def _gen_select_enclosing_rows(rows, cols, enclosed_target):
    eligible_base = []
    for i in range(len(rows) - 1):
        for j in range(i + 1, len(rows)):
            row_gap = rows[j] - rows[i] - 1
            areas = [row_gap * (cols[k + 1] - cols[k] - 1) for k in range(enclosed_target)]
            if all(_gen_between(area, GEN_ENCLOSED_SIZE_RANGE) for area in areas) and max(areas) >= GEN_MIN_LARGE_ENCLOSED:
                eligible_base.append((i, j, max(areas) ** 2))
    if not eligible_base:
        return None

    base_i, base_j, _ = random.choices(
        eligible_base, weights=[item[2] for item in eligible_base], k=1
    )[0]
    top = rows[base_i]
    bottom = rows[base_j]
    extra_rows = [row for row in rows if row not in (top, bottom)]
    return top, bottom, extra_rows


def _gen_outer_h_segments(width, top, bottom, cols):
    contact_count = random.randint(*GEN_BORDER_CONTACT_COUNT_RANGE)
    contacts = set(random.sample(GEN_ENDPOINT_NAMES, contact_count))
    row_name = {top: "top", bottom: "bottom"}
    h_segments = []
    left_col = cols[0]
    right_col = cols[-1]
    for row in (top, bottom):
        name = row_name[row]
        if (name, "left") in contacts:
            c0 = 0
        else:
            c0 = left_col - random.randint(GEN_EDGE_EXTENSION_MIN, left_col - 1)
        if (name, "right") in contacts:
            c1 = width - 1
        else:
            c1 = right_col + random.randint(GEN_EDGE_EXTENSION_MIN, width - 2 - right_col)
        h_segments.append((row, c0, c1))
    return h_segments


def _gen_add_side_rows(width, cols, top, bottom, extra_rows, t_row, h_segments):
    v_count = len(cols)
    assigned_rows = {i: [top, bottom] for i in range(v_count)}
    for row in extra_rows:
        side_i = random.choice([0, v_count - 1])
        col = cols[side_i]
        assigned_rows[side_i].append(row)
        make_t = row == t_row
        if side_i == 0:
            cap = col - 1
            if make_t:
                out = random.randint(GEN_T_EXTENSION_RANGE[0], min(GEN_T_EXTENSION_RANGE[1], cap))
                h_segments.append((row, col - out, col))
            else:
                out = random.randint(GEN_SIDE_EXTENSION_RANGE[0], min(GEN_SIDE_EXTENSION_RANGE[1], cap))
                h_segments.append((row, col - out, col + 1))
        else:
            cap = width - 2 - col
            if make_t:
                out = random.randint(GEN_T_EXTENSION_RANGE[0], min(GEN_T_EXTENSION_RANGE[1], cap))
                h_segments.append((row, col, col + out))
            else:
                out = random.randint(GEN_SIDE_EXTENSION_RANGE[0], min(GEN_SIDE_EXTENSION_RANGE[1], cap))
                h_segments.append((row, col - 1, col + out))
    return assigned_rows


def _gen_vertical_segments(height, cols, assigned_rows):
    v_segments = []
    for i, col in enumerate(cols):
        span = _gen_vertical_span(height, assigned_rows[i])
        if span is None:
            return None
        r0, r1 = span
        v_segments.append((col, r0, r1))
    return v_segments


def _gen_attempt():
    height = random.randint(*GEN_HEIGHT_RANGE)
    width = random.randint(*GEN_WIDTH_RANGE)
    color = random.choice(GEN_LINE_COLORS)
    enclosed_target = random.choice(GEN_ENCLOSED_COUNT_CHOICES)
    h_count = random.choice(GEN_H_COUNT_CHOICES)
    v_count = enclosed_target + 1

    rows = _gen_gap_positions(height, h_count, min_margin=GEN_ROW_MIN_MARGIN, max_span=GEN_ROW_MAX_SPAN)
    cols = _gen_gap_positions(width, v_count, min_margin=GEN_COL_MIN_MARGIN)
    if rows is None or cols is None:
        return None

    enclosing_rows = _gen_select_enclosing_rows(rows, cols, enclosed_target)
    if enclosing_rows is None:
        return None
    top, bottom, extra_rows = enclosing_rows

    t_row = random.choice(extra_rows) if random.random() < GEN_T_ROW_PROBABILITY else None
    h_segments = _gen_outer_h_segments(width, top, bottom, cols)
    assigned_rows = _gen_add_side_rows(width, cols, top, bottom, extra_rows, t_row, h_segments)
    v_segments = _gen_vertical_segments(height, cols, assigned_rows)
    if v_segments is None:
        return None

    grid = _gen_draw_segments(height, width, color, h_segments, v_segments)
    if not _gen_validate(grid, color, h_segments, v_segments):
        return None
    return grid


def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_h, bbox_w, colors_present, find_components, get_bg, paste
import random
from itertools import product


def _paste_teal_block(out: np.ndarray, r: int, c: int, size: int, bg: int) -> None:
    H, W = out.shape
    rr0 = max(0, int(r))
    cc0 = max(0, int(c))
    rr1 = min(H, int(r) + int(size))
    cc1 = min(W, int(c) + int(size))
    if rr0 < rr1 and cc0 < cc1:
        assert np.all(out[rr0:rr1, cc0:cc1] == int(bg))
    patch = np.full((int(size), int(size)), Color.TEAL, dtype=int)
    paste(out, patch, int(r), int(c), clip=True)


def main(grid: np.ndarray) -> np.ndarray:
    """Paint teal square blocks at the two outward opposite corners of each diagonal foreground motif.

    Input structure
    - The canvas has one background color and one foreground color.
    - Each 8-connected foreground object has a square bounding box split into a 2-by-2 grid of equal square blocks.
    - Exactly two diagonal blocks of that footprint are filled with the foreground color; the other two are background.

    Rule
    - Preserve the input.
    - If the filled blocks are northwest/southeast, paint teal blocks just outside the northeast and southwest corners.
    - If the filled blocks are northeast/southwest, paint teal blocks just outside the northwest and southeast corners.
    - Clip any painted block at the grid boundary.

    Key insight
    - The green pixels are scaled square blocks; the task completes the perpendicular diagonal of the expanded block layout.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    source_colors = colors_present(g, exclude={bg})
    assert len(source_colors) == 1
    source_color = int(source_colors[0])
    assert source_color != Color.TEAL

    out = g.copy()
    components = find_components(
        g,
        bg=bg,
        colors=[source_color],
        connectivity=8,
        monochromatic=False,
    )
    assert components

    for comp in components:
        r0, c0, r1, c1 = map(int, comp["bbox"])
        h = bbox_h(comp["bbox"])
        w = bbox_w(comp["bbox"])
        assert h == w and h % 2 == 0
        size = h // 2

        sub = g[r0 : r1 + 1, c0 : c1 + 1]
        occupied: set[tuple[int, int]] = set()
        for br in range(2):
            for bc in range(2):
                block = sub[br * size : (br + 1) * size, bc * size : (bc + 1) * size]
                if np.all(block == source_color):
                    occupied.add((br, bc))
                else:
                    assert np.all(block == bg)

        if occupied == {(0, 0), (1, 1)}:
            targets = [(r0 - size, c1 + 1), (r1 + 1, c0 - size)]
        else:
            assert occupied == {(0, 1), (1, 0)}
            targets = [(r0 - size, c0 - size), (r1 + 1, c1 + 1)]

        for rr, cc in targets:
            _paste_teal_block(out, rr, cc, size, bg)

    return out

# --------------- generator (o5x) ---------------
# Canvas and colors.
GEN_GRID_SHAPE = (10, 10)
GEN_BACKGROUND = Color.BLACK
GEN_TARGET_COLOR = Color.TEAL
GEN_FOREGROUND_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)

def _gen_rect_cells(shape: tuple[int, int], r: int, c: int, size: int) -> set[tuple[int, int]]:
    H, W = shape
    rr0 = max(0, int(r))
    cc0 = max(0, int(c))
    rr1 = min(H, int(r) + int(size))
    cc1 = min(W, int(c) + int(size))
    return {(rr, cc) for rr in range(rr0, rr1) for cc in range(cc0, cc1)}


def _gen_padded_cells(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
    H, W = shape
    out: set[tuple[int, int]] = set()
    for r, c in cells:
        for dr in GEN_PAD_OFFSETS:
            for dc in GEN_PAD_OFFSETS:
                rr = r + dr
                cc = c + dc
                if 0 <= rr < H and 0 <= cc < W:
                    out.add((rr, cc))
    return out


def _gen_block_origins(
    r0: int, c0: int, size: int, diagonal: int
) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
    """Return foreground and outward target block top-lefts before clipping."""
    s = int(size)
    span = GEN_MOTIF_BLOCK_SPAN * s
    if diagonal == GEN_DIAGONAL_NW_SE:
        fg_blocks = [(r0, c0), (r0 + s, c0 + s)]
        target_blocks = [(r0 - s, c0 + span), (r0 + span, c0 - s)]
    else:
        fg_blocks = [(r0, c0 + s), (r0 + s, c0)]
        target_blocks = [(r0 - s, c0 - s), (r0 + span, c0 + span)]
    return fg_blocks, target_blocks


def _gen_motif_parts(
    shape: tuple[int, int], r0: int, c0: int, size: int, diagonal: int
) -> dict | None:
    s = int(size)
    fg_blocks, teal_blocks = _gen_block_origins(r0, c0, s, int(diagonal))

    fg = set()
    for rr, cc in fg_blocks:
        fg |= _gen_rect_cells(shape, rr, cc, s)

    teal_parts = [_gen_rect_cells(shape, rr, cc, s) for rr, cc in teal_blocks]
    if any(len(part) == 0 for part in teal_parts):
        return None
    if teal_parts[0] & teal_parts[1]:
        return None
    teal = teal_parts[0] | teal_parts[1]
    if fg & teal:
        return None

    return {
        "size": s,
        "diagonal": int(diagonal),
        "fg_blocks": fg_blocks,
        "teal_blocks": teal_blocks,
        "fg": fg,
        "teal": teal,
        "bbox": _gen_rect_cells(shape, r0, c0, GEN_MOTIF_BLOCK_SPAN * s),
    }


def _gen_candidate_placements(shape: tuple[int, int], size: int, diagonal: int) -> list[dict]:
    H, W = shape
    options = []
    span = GEN_MOTIF_BLOCK_SPAN * int(size)
    for r0 in range(H - span + 1):
        for c0 in range(W - span + 1):
            parts = _gen_motif_parts(shape, r0, c0, int(size), int(diagonal))
            if parts is not None:
                options.append(parts)
    random.shuffle(options)
    return options


def _gen_fits(parts: dict, state: dict, shape: tuple[int, int]) -> bool:
    if parts["bbox"] & state["bbox"]:
        return False
    if parts["teal"] & state["teal"]:
        return False
    if parts["teal"] & state["bbox"]:
        return False
    if parts["bbox"] & state["teal"]:
        return False
    return not (parts["fg"] & state["fg_padded"])


def _gen_add_state(parts: dict, state: dict, shape: tuple[int, int]) -> dict:
    return {
        "bbox": state["bbox"] | parts["bbox"],
        "teal": state["teal"] | parts["teal"],
        "fg_padded": state["fg_padded"] | _gen_padded_cells(parts["fg"], shape),
    }


def _gen_choose_placements(specs: tuple[tuple[int, int], ...], shape: tuple[int, int]) -> list[dict] | None:
    options = [_gen_candidate_placements(shape, size, diagonal) for size, diagonal in specs]
    if any(len(opts) == 0 for opts in options):
        return None

    order = sorted(range(len(specs)), key=lambda i: (len(options[i]), -specs[i][0]))

    def rec(k: int, state: dict, chosen: list[tuple[int, dict]]) -> list[tuple[int, dict]] | None:
        if k == len(order):
            return chosen
        idx = order[k]
        for parts in options[idx]:
            if _gen_fits(parts, state, shape):
                placed = rec(k + 1, _gen_add_state(parts, state, shape), chosen + [(idx, parts)])
                if placed is not None:
                    return placed
        return None

    initial_state = {"bbox": set(), "teal": set(), "fg_padded": set()}
    placed = rec(0, initial_state, [])
    if placed is None:
        return None

    result: list[dict] = [None] * len(specs)  # type: ignore[list-item]
    for idx, parts in placed:
        result[idx] = parts
    return result


def _gen_feasible_specs(count: int, shape: tuple[int, int]) -> list[tuple[tuple[int, int], ...]]:
    feasible = []
    for sizes in product(GEN_BLOCK_SIZES, repeat=int(count)):
        for diagonals in product(GEN_DIAGONALS, repeat=int(count)):
            specs = tuple((int(sizes[i]), int(diagonals[i])) for i in range(int(count)))
            if _gen_choose_placements(specs, shape) is not None:
                feasible.append(specs)
    random.shuffle(feasible)
    return feasible


def _gen_paste_square(grid: np.ndarray, r: int, c: int, size: int, color: int, *, clip: bool) -> None:
    patch = np.full((int(size), int(size)), int(color), dtype=int)
    paste(grid, patch, int(r), int(c), clip=clip)


def _gen_sample_placements(count: int, shape: tuple[int, int]) -> list[dict] | None:
    feasible = _gen_feasible_specs(count, shape)
    if not feasible:
        return None
    specs = random.choice(feasible)
    return _gen_choose_placements(specs, shape)


def _gen_render_output(shape: tuple[int, int], bg: int, fg: int, placements: list[dict]) -> np.ndarray:
    out = np.full(shape, bg, dtype=int)
    for parts in placements:
        for rr, cc in parts["fg_blocks"]:
            _gen_paste_square(out, rr, cc, parts["size"], fg, clip=False)
    for parts in placements:
        for rr, cc in parts["teal_blocks"]:
            _gen_paste_square(out, rr, cc, parts["size"], GEN_TARGET_COLOR, clip=True)
    return out


def _gen_attempt() -> np.ndarray | None:
    shape = GEN_GRID_SHAPE
    bg = GEN_BACKGROUND
    fg = random.choice(GEN_FOREGROUND_COLORS)
    count = random.randint(*GEN_MOTIF_COUNT_RANGE)

    placements = _gen_sample_placements(count, shape)
    if placements is None:
        return None

    out = _gen_render_output(shape, bg, fg, placements)
    inp = out.copy()
    inp[inp == GEN_TARGET_COLOR] = bg
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 22233c11 input")

