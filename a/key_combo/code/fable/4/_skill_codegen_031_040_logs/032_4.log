+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    """Return the inclusive (r0, c0, r1, c1) bbox used by arc_utils."""
+    coords = np.argwhere(mask)
+    assert len(coords), "expected a nonempty mask"
