+    mask = source_cells[r0 : r1 + 1, c0 : c1 + 1]
+    assert _is_8_connected(mask), "source sprite must be 8-connected"
+    assert mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()
