+    coords = {tuple(map(int, p)) for p in np.argwhere(mask)}
+    if not coords:
+        return False
+    seen = {next(iter(coords))}
+    stack = list(seen)
+    while stack:
+        r, c = stack.pop()
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (dr or dc) and (r + dr, c + dc) in coords and (r + dr, c + dc) not in seen:
