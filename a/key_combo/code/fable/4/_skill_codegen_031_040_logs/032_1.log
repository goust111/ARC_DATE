+    return shape[1] - 1 - c
+
+
+def _candidate_center_is_clear(
+    center: tuple[int, int],
+    sides: frozenset[str],
+    occupied: set[tuple[int, int]],
+) -> bool:
+    core = set().union(*(_side_cells(center, side) for side in sides))
+    return all(not _touches_any(cell, occupied) for cell in core)
