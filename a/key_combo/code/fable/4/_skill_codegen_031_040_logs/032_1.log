+            elif c >= cc + 4 and "right" in sides:
+                matches.append((center, "right", c - cc))
+        if c == cc:
+            if r <= cr - 4 and "up" in sides:
+                matches.append((center, "up", cr - r))
+            elif r >= cr + 4 and "down" in sides:
