from __future__ import annotations

import numpy as np

from arc_utils import Color, colors_present, find_components, get_bg


ARM_OFFSETS = (
    (0, -3),
    (0, -2),
    (0, 2),
    (0, 3),
    (-3, 0),
    (-2, 0),
    (2, 0),
    (3, 0),
)
GAP_OFFSETS = ((0, -1), (0, 1), (-1, 0), (1, 0))


def _assert_two_cell_bars(g: np.ndarray, bg: int, fg: int) -> None:
    components = find_components(g, bg=bg, connectivity=4, colors=[fg])
    assert components, "expected foreground bars"
    for component in components:
        coords = np.asarray(component["coords"], dtype=int)
        assert coords.shape == (2, 2), "each foreground object must be a two-pixel bar"
        r0, c0 = map(int, coords[0])
        r1, c1 = map(int, coords[1])
        is_bar = (r0 == r1 and abs(c0 - c1) == 1) or (c0 == c1 and abs(r0 - r1) == 1)
        assert is_bar, "foreground objects must be horizontal or vertical adjacent pairs"


def _is_cross_center(g: np.ndarray, r: int, c: int, bg: int, fg: int) -> bool:
    if int(g[r, c]) != bg:
        return False
    return all(int(g[r + dr, c + dc]) == fg for dr, dc in ARM_OFFSETS) and all(
        int(g[r + dr, c + dc]) == bg for dr, dc in GAP_OFFSETS
    )


def main(grid: np.ndarray) -> np.ndarray:
    """
    Mark the missing center of each plus-shaped arrangement of four two-pixel bars with yellow.

    Input structure:
    - The background is the dominant color.
    - The single foreground color forms isolated 4-connected objects, each a horizontal or vertical two-pixel bar.
    - Some bars form an implied plus sign: two horizontal bars and two vertical bars around an empty center, with a one-pixel gap between the center and each bar.

    Rule:
    - Keep the input unchanged except at implied plus-sign centers.
    - For every background pixel with foreground bars at offsets 2-3 cells left, right, above, and below, recolor that center yellow.
    - The one-pixel gaps immediately next to the center in the four cardinal directions must remain background.

    Key insight:
    - The yellow pixels are not extending a line; they identify the shared missing center where four separated two-pixel bars align as a plus sign.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = g.shape
    assert height >= 7 and width >= 7, "grid must be large enough for the plus motif"

    bg = get_bg(g)
    foreground = colors_present(g, exclude={bg})
    assert len(foreground) == 1, "expected exactly one foreground color"
    fg = int(foreground[0])
    assert bg != Color.YELLOW and fg != Color.YELLOW, "yellow is reserved for output markers"
    _assert_two_cell_bars(g, bg, fg)

    centers = [
        (r, c)
        for r in range(3, height - 3)
        for c in range(3, width - 3)
        if _is_cross_center(g, r, c, bg, fg)
    ]
    assert centers, "expected at least one missing plus center"

    out = g.copy()
    for r, c in centers:
        out[r, c] = Color.YELLOW
    return out

# --------------- generator (att1) ---------------

# Canvas and color bounds.
GRID_SIZE_MIN = 8
GRID_SIZE_MAX_EXCLUSIVE = 21
BACKGROUND_COLOR = 8
FOREGROUND_COLOR = 1

# Plus motif placement.
PLUS_COUNT_MIN = 1
PLUS_COUNT_MAX_EXCLUSIVE = 5
CENTER_MARGIN = 3
CENTER_TRIES = 100

# Distractor bar placement.
DISTRACTOR_RATIO_MIN = 0.2
DISTRACTOR_RATIO_MAX = 0.6
DISTRACTOR_RETRY_MULTIPLIER = 20
NEW_PLUS_SCAN_RADIUS = 3

# Overall generation retries.
GENERATION_ATTEMPTS = 300
NEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _offset_cells(r: int, c: int, offsets: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
    return [(r + dr, c + dc) for dr, dc in offsets]


def _all_cells_bg(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:
    height, width = grid.shape
    for r, c in cells:
        if r < 0 or r >= height or c < 0 or c >= width:
            return False
        if grid[r, c] != bg:
            return False
    return True


def _cells_are_isolated(grid: np.ndarray, cells: list[tuple[int, int]], bg: int) -> bool:
    """Check that cells have no 4-neighbor foreground outside their own component."""
    height, width = grid.shape
    cell_set = set(cells)
    for r, c in cells:
        for dr, dc in NEIGHBOR_OFFSETS:
            nr, nc = r + dr, c + dc
            if (nr, nc) in cell_set:
                continue
            if 0 <= nr < height and 0 <= nc < width and grid[nr, nc] != bg:
                return False
    return True


def _place_plus_centers(grid: np.ndarray, rng: np.random.Generator, count: int, bg: int, fg: int) -> list[tuple[int, int]]:
    """Place up to count complete plus motifs and return their hidden centers."""
    height, width = grid.shape
    centers = []
    for _ in range(count):
        found = False
        for _try in range(CENTER_TRIES):
            r = int(rng.integers(CENTER_MARGIN, height - CENTER_MARGIN))
            c = int(rng.integers(CENTER_MARGIN, width - CENTER_MARGIN))
            arm_cells = _offset_cells(r, c, ARM_OFFSETS)
            gap_cells = _offset_cells(r, c, GAP_OFFSETS)
            all_cells = arm_cells + gap_cells + [(r, c)]

            if not _all_cells_bg(grid, all_cells, bg):
                continue
            if not _cells_are_isolated(grid, arm_cells, bg):
                continue

            for ar, ac in arm_cells:
                grid[ar, ac] = fg
            centers.append((r, c))
            found = True
            break

        if not found:
            break
    return centers


def _target_distractor_count(rng: np.random.Generator, plus_count: int) -> int:
    arm_bars = plus_count * 4
    ratio = rng.uniform(DISTRACTOR_RATIO_MIN, DISTRACTOR_RATIO_MAX)
    return max(1, int(round(arm_bars * ratio / (1 - ratio))))


def _candidate_centers_near_bar(bar_cells: list[tuple[int, int]], height: int, width: int) -> set[tuple[int, int]]:
    check_cells = set()
    for br, bc in bar_cells:
        for dr in range(-NEW_PLUS_SCAN_RADIUS, NEW_PLUS_SCAN_RADIUS + 1):
            for dc in range(-NEW_PLUS_SCAN_RADIUS, NEW_PLUS_SCAN_RADIUS + 1):
                cr, cc = br + dr, bc + dc
                if CENTER_MARGIN <= cr < height - CENTER_MARGIN and CENTER_MARGIN <= cc < width - CENTER_MARGIN:
                    check_cells.add((cr, cc))
    return check_cells


def _would_create_extra_plus(
    grid: np.ndarray, bar_cells: list[tuple[int, int]], centers: list[tuple[int, int]], bg: int, fg: int
) -> bool:
    height, width = grid.shape
    for cr, cc in _candidate_centers_near_bar(bar_cells, height, width):
        if (cr, cc) in centers:
            continue
        if grid[cr, cc] != bg:
            continue
        arms_ok = all(0 <= cr + dr < height and 0 <= cc + dc < width and grid[cr + dr, cc + dc] == fg
                      for dr, dc in ARM_OFFSETS)
        gaps_ok = all(0 <= cr + dr < height and 0 <= cc + dc < width and grid[cr + dr, cc + dc] == bg
                      for dr, dc in GAP_OFFSETS)
        if arms_ok and gaps_ok:
            return True
    return False


def _place_distractors(
    grid: np.ndarray, rng: np.random.Generator, target_count: int, centers: list[tuple[int, int]], bg: int, fg: int
) -> int:
    height, width = grid.shape
    placed = 0
    for _ in range(target_count * DISTRACTOR_RETRY_MULTIPLIER):
        if placed >= target_count:
            break

        orientation = rng.integers(0, 2)
        r0 = int(rng.integers(0, height))
        c0 = int(rng.integers(0, width))
        if orientation == 0:
            r1, c1 = r0, c0 + 1
        else:
            r1, c1 = r0 + 1, c0

        if r1 >= height or c1 >= width:
            continue
        if grid[r0, c0] != bg or grid[r1, c1] != bg:
            continue

        bar_cells = [(r0, c0), (r1, c1)]
        if not _cells_are_isolated(grid, bar_cells, bg):
            continue

        for r, c in bar_cells:
            grid[r, c] = fg

        if _would_create_extra_plus(grid, bar_cells, centers, bg, fg):
            for r, c in bar_cells:
                grid[r, c] = bg
            continue

        placed += 1
    return placed


def _passes_solver_oracle(grid: np.ndarray, centers: list[tuple[int, int]]) -> bool:
    try:
        out = main(grid.copy())
    except (AssertionError, Exception):
        return False

    expected = grid.copy()
    for r, c in centers:
        expected[r, c] = 4
    return np.array_equal(out, expected)


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()

    height = rng.integers(GRID_SIZE_MIN, GRID_SIZE_MAX_EXCLUSIVE)
    width = rng.integers(GRID_SIZE_MIN, GRID_SIZE_MAX_EXCLUSIVE)
    bg = BACKGROUND_COLOR
    fg = FOREGROUND_COLOR

    grid = np.full((height, width), bg, dtype=int)

    plus_count = rng.integers(PLUS_COUNT_MIN, PLUS_COUNT_MAX_EXCLUSIVE)
    if height < 2 * CENTER_MARGIN + 1 or width < 2 * CENTER_MARGIN + 1:
        return None

    centers = _place_plus_centers(grid, rng, plus_count, bg, fg)
    if len(centers) == 0:
        return None

    distractor_count = _target_distractor_count(rng, len(centers))
    placed_distractors = _place_distractors(grid, rng, distractor_count, centers, bg, fg)
    if placed_distractors < 1:
        return None

    if not _passes_solver_oracle(grid, centers):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts")
from collections import defaultdict

import numpy as np

from arc_utils import colors_present, get_bg, in_bounds
import random


def _find_anchor(mask: np.ndarray) -> tuple[int, int, int, int]:
    h, w = mask.shape
    anchors = []
    for r in range(h - 2):
        for c in range(w - 2):
            if mask[r : r + 3, c : c + 3].all():
                anchors.append((r, c, r + 2, c + 2))
    assert len(anchors) == 1
    return anchors[0]


def _ray_terminal(
    coord: tuple[int, int],
    anchor: tuple[int, int, int, int],
    shape: tuple[int, int],
) -> tuple[tuple[int, int], tuple[int, int]]:
    r, c = coord
    r0, c0, r1, c1 = anchor
    dr = 1 if r < r0 else -1 if r > r1 else 0
    dc = 1 if c < c0 else -1 if c > c1 else 0
    assert (dr, dc) != (0, 0)

    cr, cc = r, c
    for _ in range(max(shape) * 2):
        nr, nc = cr + dr, cc + dc
        if r0 <= nr <= r1 and c0 <= nc <= c1:
            return (cr, cc), (dr, dc)
        assert in_bounds(shape, nr, nc)
        cr, cc = nr, nc
    raise AssertionError("ray does not reach anchor")


def main(grid: np.ndarray) -> np.ndarray:
    """Compress each colored ray pixel inward until it touches that color's 3x3 anchor block.
    Input structure
    - A uniform background grid with non-background colors.
    - Each foreground color contains one solid 3x3 anchor block; all other pixels of that color lie on straight 8-neighbor rays aimed at that block.
    Rule
    - Keep anchor blocks fixed, erase loose foreground pixels, and for each ray pack its pixels into consecutive cells adjacent to the anchor along the same ray.
    Key insight
    - The scattered pixels are displaced pixels on visible row, column, or diagonal sightlines back to their same-colored 3x3 block.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    out = np.full_like(g, bg)
    occupied: dict[tuple[int, int], int] = {}

    fg_colors = colors_present(g, exclude={bg})
    assert fg_colors

    for color in fg_colors:
        mask = g == color
        anchor = _find_anchor(mask)
        r0, c0, r1, c1 = anchor

        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                assert (r, c) not in occupied
                occupied[(r, c)] = color
                out[r, c] = color

        rays: dict[
            tuple[tuple[int, int], tuple[int, int]], list[tuple[int, int, int]]
        ] = defaultdict(list)
        for raw_r, raw_c in np.argwhere(mask):
            r, c = int(raw_r), int(raw_c)
            if r0 <= r <= r1 and c0 <= c <= c1:
                continue
            terminal, step = _ray_terminal((r, c), anchor, g.shape)
            dist = max(abs(r - terminal[0]), abs(c - terminal[1]))
            rays[(terminal, step)].append((dist, r, c))

        for (terminal, (dr, dc)), cells in rays.items():
            distances = [dist for dist, _, _ in cells]
            assert len(distances) == len(set(distances))
            tr, tc = terminal
            for i, _ in enumerate(sorted(cells)):
                dest = (tr - i * dr, tc - i * dc)
                assert in_bounds(g.shape, *dest)
                assert dest not in occupied
                occupied[dest] = color
                out[dest] = color

        assert int((out == color).sum()) == int(mask.sum())

    return out

# --------------- generator (o5x) ---------------

# Canvas, palette, and retries.
_GEN_BG = 6
_GEN_SHAPE = (9, 9)
_GEN_FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 7, 8, 9]
_GEN_MAX_ATTEMPTS = 300

# Fixed anchor layout.
_GEN_TOP_LEFT_ANCHOR = (0, 0, 2, 2)
_GEN_BOTTOM_RIGHT_ANCHOR = (6, 6, 8, 8)
_GEN_ANCHORS = (_GEN_TOP_LEFT_ANCHOR, _GEN_BOTTOM_RIGHT_ANCHOR)

# Ray sampling.
_GEN_RAYS_MIN = 3
_GEN_RAYS_MAX = 6
_GEN_MAX_LOOSE_DISTANCE = 5


def _gen_anchor_cells(anchor):
    r0, c0, r1, c1 = anchor
    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]


def _gen_terminals(anchor):
    r0, c0, r1, c1 = anchor
    if (r0, c0) == (0, 0):
        return (
            [(r, c1 + 1, 0, 1) for r in range(r0, r1 + 1)]
            + [(r1 + 1, c, 1, 0) for c in range(c0, c1 + 1)]
            + [(r1 + 1, c1 + 1, 1, 1)]
        )
    return (
        [(r, c0 - 1, 0, -1) for r in range(r0, r1 + 1)]
        + [(r0 - 1, c, -1, 0) for c in range(c0, c1 + 1)]
        + [(r0 - 1, c0 - 1, -1, -1)]
    )


def _gen_seed_anchors(inp, out, colors):
    """Paint both fixed anchors and return occupied input cells."""
    occupied_in = set()

    for color, anchor in zip(colors, _GEN_ANCHORS):
        for r, c in _gen_anchor_cells(anchor):
            inp[r, c] = color
            out[r, c] = color
            occupied_in.add((r, c))

    return occupied_in


def _gen_place_loose_pixels(inp, out, color, anchor, occupied_in):
    """Sample terminals for one anchor and place their loose input pixels."""
    terminals = _gen_terminals(anchor)
    chosen = random.sample(terminals, random.randint(_GEN_RAYS_MIN, _GEN_RAYS_MAX))
    for tr, tc, dr, dc in chosen:
        out[tr, tc] = color
        max_dist = 0
        rr, cc = tr + dr, tc + dc
        while 0 <= rr < _GEN_SHAPE[0] and 0 <= cc < _GEN_SHAPE[1]:
            max_dist += 1
            rr += dr
            cc += dc
        dist = random.randint(1, min(_GEN_MAX_LOOSE_DISTANCE, max_dist))
        loose = (tr + dr * dist, tc + dc * dist)
        if loose in occupied_in:
            return False
        occupied_in.add(loose)
        inp[loose] = color
    return True


def _gen_attempt() -> np.ndarray | None:
    colors = random.sample(_GEN_FOREGROUND_COLORS, 2)
    random.shuffle(colors)

    inp = np.full(_GEN_SHAPE, _GEN_BG, dtype=int)
    out = np.full(_GEN_SHAPE, _GEN_BG, dtype=int)
    occupied_in = _gen_seed_anchors(inp, out, colors)

    for color, anchor in zip(colors, _GEN_ANCHORS):
        if not _gen_place_loose_pixels(inp, out, color, anchor, occupied_in):
            return None

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid f28a3cbb input")
_EDGE_DEFS = {
    "top":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),
    "bottom": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),
    "left":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),
    "right":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),
}


def _diag_flood(ray, seeds):
    """BFS all zero-cells in *ray* diag-reachable from *seeds*. Returns the visited set (includes seeds)."""
    n = ray.shape[0]
    seen = set(seeds)
    q = deque(seeds)
    while q:
        r, c = q.popleft()
        for dr, dc in _DIAG_DIRS:
            nr, nc = r + dr, c + dc
            if 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0 and (nr, nc) not in seen:
                seen.add((nr, nc))
                q.append((nr, nc))
    return seen


def _cast_main_rays(n, orientation, length, pos, colors):
    """Place the main run and cast 4 diagonal rays from each pixel (with occlusion). Returns (ray_grid, coords) or (None, None)."""
    ray = np.zeros((n, n), dtype=int)
    if orientation == "H":
        coords = [(pos, c) for c in range(n - length, n)]
    else:
        coords = [(r, pos) for r in range(n - length, n)]

    for (r, c), color in zip(coords, colors):
        if ray[r, c] != 0:
            return None, None
        ray[r, c] = color
        for dr, dc in _DIAG_DIRS:
            nr, nc = r + dr, c + dc
            while 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0:
                ray[nr, nc] = color
                nr += dr
                nc += dc
    return ray, coords


def _diag_labels(ray):
    """Label each diagonal-connected zero-region in *ray* with a unique integer. Non-zero cells get -1."""
    n = ray.shape[0]
    labels = np.full_like(ray, -1, dtype=int)
    next_label = 0
    for sr, sc in np.argwhere(ray == 0):
        sr, sc = int(sr), int(sc)
        if labels[sr, sc] >= 0:
            continue
        for cell in _diag_flood(ray, [(sr, sc)]):
            labels[cell] = next_label
        next_label += 1
    return labels


def _touches(cells, blocked):
    """True if any cell in *cells* is orthogonally adjacent to a cell in *blocked*."""
    for r, c in cells:
        for dr, dc in _ORTH_DIRS:
            if (r + dr, c + dc) in blocked:
                return True
    return False


def _edge_pairs(ray, labels, excluded_edge, blocked):
    """Find valid size-2 bar placements along grid edges (excluding *excluded_edge* and cells adjacent to *blocked*)."""
    n = ray.shape[0]
    pairs = []
    for edge_name, gen_fn in _EDGE_DEFS.items():
        if edge_name == excluded_edge:
            continue
        for pair in gen_fn(n):
            if all(ray[p] == 0 for p in pair) and not _touches(pair, blocked):
                pairs.append((pair, frozenset(int(labels[p]) for p in pair)))
    return pairs


def _choose_bars(ray, main_coords, orientation):
    """Select 1 or 2 compatible bar placements from grid edges."""
    excluded_edge = "right" if orientation == "H" else "bottom"
    labels = _diag_labels(ray)
    candidates = _edge_pairs(ray, labels, excluded_edge, set(main_coords))
    if not candidates:
        return None

    compatible_twos = []
    for i, (pair_a, labels_a) in enumerate(candidates):
        for pair_b, labels_b in candidates[i + 1:]:
            if labels_a & labels_b or _touches(pair_b, set(pair_a)):
                continue
            compatible_twos.append((pair_a, pair_b))

    if compatible_twos and random.choice((1, 2)) == 2:
        return list(random.choice(compatible_twos))
    return [random.choice(candidates)[0]]


def _bar_regions_disjoint(ray, bars):
    """Check that the diagonal flood regions of all bars are mutually disjoint."""
    claimed = set()
    for pair in bars:
        region = _diag_flood(ray, list(pair))
        if claimed & region:
            return False
        claimed.update(region)
    return True


def _build_output(ray, bars, bar_colors):
    """Overlay each bar's diagonal flood region onto the ray grid."""
    out = ray.copy()
    for pair, color in zip(bars, bar_colors):
        for r, c in _diag_flood(ray, list(pair)):
            out[r, c] = color
    return out


def _gen_attempt():
    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    orientation = random.choice(("H", "V"))
    length = random.randint(RUN_LENGTH_MIN, min(n - 1, RUN_LENGTH_MAX))
    pos = random.randint(POS_MARGIN, n - 1 - POS_MARGIN)

    colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), length)
    ray, main_coords = _cast_main_rays(n, orientation, length, pos, colors)
    if ray is None:
        return None

    bars = _choose_bars(ray, main_coords, orientation)
    if not bars or not _bar_regions_disjoint(ray, bars):
        return None

    remaining = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c not in colors]
    bar_colors = random.sample(remaining, len(bars))

    inp = np.zeros((n, n), dtype=int)
    for (r, c), color in zip(main_coords, colors):
        inp[r, c] = color
    for pair, color in zip(bars, bar_colors):
        for r, c in pair:
            inp[r, c] = color

    expected = _build_output(ray, bars, bar_colors)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 1190bc91 input")
def _gen_mark_blocked(blocked, coords):
    h, w = blocked.shape
    for r, c in coords:
        r0 = max(0, int(r) - 1)
        r1 = min(h, int(r) + 2)
        c0 = max(0, int(c) - 1)
        c1 = min(w, int(c) + 2)
        blocked[r0:r1, c0:c1] = True


def _gen_blob_coords(size):
    max_area = int(size / _GEN_BLOB_MIN_DENSITY)
    max_dim = min(_GEN_BLOB_MAX_DIM, size)
    dims = [
        (h, w)
        for h in range(1, max_dim + 1)
        for w in range(1, max_dim + 1)
        if h * w >= size and h * w <= max_area and h + w > 2
    ]
    weights = [1 + _GEN_BLOB_SPARSITY_WEIGHT * (h * w - size) for h, w in dims]
    h, w = random.choices(dims, weights=weights, k=1)[0]

    coords = {(random.randrange(h), random.randrange(w))}
    while len(coords) < size:
        frontier = []
        for r, c in coords:
            for dr, dc in _GEN_DIRS8:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:
                    frontier.append((nr, nc))
        coords.add(random.choice(frontier))

    arr = np.array(list(coords), dtype=int)
    arr[:, 0] -= arr[:, 0].min()
    arr[:, 1] -= arr[:, 1].min()
    return arr


def _gen_pick_total_foreground(n_singletons, n_clusters, lo, hi):
    bands = []
    low_hi = min(hi, n_singletons + 4 * n_clusters - 1)
    if lo <= low_hi:
        bands.append((lo, low_hi, _GEN_TOTAL_FG_BAND_WEIGHTS[0]))
    mid_low_lo = max(lo, n_singletons + 4 * n_clusters)
    mid_low_hi = min(hi, n_singletons + 5 * n_clusters - 1)
    if mid_low_lo <= mid_low_hi:
        bands.append((mid_low_lo, mid_low_hi, _GEN_TOTAL_FG_BAND_WEIGHTS[1]))
    mid_lo = max(lo, n_singletons + 5 * n_clusters)
    mid_hi = min(hi, n_singletons + 6 * n_clusters)
    if mid_lo <= mid_hi:
        bands.append((mid_lo, mid_hi, _GEN_TOTAL_FG_BAND_WEIGHTS[2]))
    high_lo = max(lo, n_singletons + 6 * n_clusters + 1)
    if high_lo <= hi:
        bands.append((high_lo, hi, _GEN_TOTAL_FG_BAND_WEIGHTS[3]))
    band = random.choices(bands, weights=[band[2] for band in bands], k=1)[0]
    return random.randint(band[0], band[1])


def _gen_choose_counts(h, w):
    area = h * w
    min_frac, max_frac = _GEN_FG_FRACTION_RANGE
    min_fg = int(np.ceil(min_frac * area))
    max_fg = int(np.floor(max_frac * area))
    min_components, max_components = _GEN_COMPONENT_COUNT_RANGE
    min_cluster_size, max_cluster_size = _GEN_CLUSTER_SIZE_RANGE
    choices = []
    for n_singletons in range(_GEN_SINGLETON_COUNT_RANGE[0], _GEN_SINGLETON_COUNT_RANGE[1] + 1):
        for n_clusters in range(_GEN_CLUSTER_COUNT_RANGE[0], _GEN_CLUSTER_COUNT_RANGE[1] + 1):
            if not min_components <= n_singletons + n_clusters <= max_components:
                continue
            lo = max(min_fg, n_singletons + min_cluster_size * n_clusters)
            hi = min(max_fg, n_singletons + max_cluster_size * n_clusters)
            if lo <= hi:
                choices.append((n_singletons, n_clusters, lo, hi))
    if not choices:
        return None

    singleton_options = sorted({choice[0] for choice in choices})
    n_singletons = random.choice(singleton_options)
    cluster_choices = [choice for choice in choices if choice[0] == n_singletons]
