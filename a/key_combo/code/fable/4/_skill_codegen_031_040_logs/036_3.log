def main(grid: np.ndarray) -> np.ndarray:
    """
    Stamp translated copies of a monochrome template guided by a singleton pixel layout.

    Input structure:
    - bg = background. A large monochrome shape (template, color T).
    - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).
    - Singletons sit on a uniform-spacing lattice.

    Rule:
    - Convert each singleton's offset from the origin into coarse lattice units.
    - Place a template copy at each offset, scaled by template height/width.
    - The origin's copy is painted O instead of T.
    - Any pixel covered by two or more copies is also recolored to O.

    Key insight: The single T-colored singleton identifies both the origin position and the "self" copy, which is uniquely recolored.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))
    H, W = g.shape

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    assert not (not comps)

    template = max(comps, key=lambda d: int(d["area"]))
    templ_coords = template["coords"]
    templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])
    r0, c0, r1, c1 = map(int, template["bbox"])
    h = int(bbox_h((r0, c0, r1, c1)))
    w = int(bbox_w((r0, c0, r1, c1)))

    templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]

    # Singleton layout points (excluding the template component).
    singletons: list[tuple[int, int, int]] = []
    for comp in comps:
        if comp is template:
            continue
        if int(comp["area"]) != 1:
            continue
        rr, cc = map(int, comp["coords"][0])
        singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))

    origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]
    assert not (len(origin) != 1)
    orr, orc = origin[0]

    other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]
    assert not (not other_cols)
    overlap_col = int(Counter(other_cols).most_common(1)[0][0])

    deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]
    gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]
    assert gcd_vals
    gunit = int(math.gcd(*gcd_vals))
    gunit = max(1, int(gunit))
    deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]

    total = np.zeros((H, W), dtype=int)
    center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton

    for dr, dc, col in deltas:
        off_r = int(dr * h)
        off_c = int(dc * w)
        is_origin = int(col) == int(templ_col)
        for rr, cc in templ_rel:
            R = int(r0 + off_r + rr)
            C = int(c0 + off_c + cc)
            if 0 <= R < H and 0 <= C < W:
                total[R, C] += 1
                if is_origin:
                    center[R, C] += 1

    out = np.full((H, W), int(bg), dtype=int)
    out[total > 0] = int(templ_col)
    out[(total == 1) & (center > 0)] = int(overlap_col)
    out[total >= 2] = int(overlap_col)
    return out

# --------------- generator (a1) ---------------

# ── Tunable configuration ──────────────────────────────────────────
GRID_SIZE = 22
TEMPLATE_H_CHOICES = [3, 4]       # template bbox height options
TEMPLATE_W = 3                    # template bbox width (fixed)
TEMPLATE_AREA_RANGE = (6, 10)     # absolute cell-count bounds
TEMPLATE_FILL_RANGE = (0.65, 0.85)  # fill-ratio bounds within bbox
SINGLETON_COUNT_RANGE = (5, 6)    # number of lattice singletons
LATTICE_EXTENT_RANGE = (3, 4)     # rows/cols of lattice polyomino
GUNIT = 2                         # singleton spacing in pixels

# Retry budgets
SPANNING_RETRIES = 40             # attempts per spanning polyomino
TEMPLATE_RETRIES = 60             # attempts to build a valid template
SINGLETON_RETRIES = 50            # attempts to place singleton cluster
GENERATE_RETRIES = 300            # outer retry loop


def _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
    """Grow a random 4-connected polyomino of *n* cells in a rows x cols grid."""
    start = (random.randint(0, rows - 1), random.randint(0, cols - 1))
    cells = {start}
    frontier = []
    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
        nr, nc = start[0] + dr, start[1] + dc
        if 0 <= nr < rows and 0 <= nc < cols:
            frontier.append((nr, nc))
    while len(cells) < n and frontier:
        cell = random.choice(frontier)
        frontier.remove(cell)
        if cell in cells:
            continue
        cells.add(cell)
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:
                frontier.append((nr, nc))
    return list(cells) if len(cells) == n else None


def _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
    """Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges)."""
    for _ in range(SPANNING_RETRIES):
    templ_cells = _gen_template(h, w)
    if templ_cells is None:
        return None

    n_sing = random.randint(*SINGLETON_COUNT_RANGE)
    lat = _gen_lattice(n_sing)
    if lat is None:
        return None
    lattice_cells, origin = lat
    deltas = [(r - origin[0], c - origin[1]) for r, c in lattice_cells]
    min_dr, max_dr, min_dc, max_dc = _delta_bounds(deltas)

    # Compute valid placement window for the template origin
    r0_lo, r0_hi = -min_dr * h, GRID_SIZE - max_dr * h - h
    c0_lo, c0_hi = -min_dc * w, GRID_SIZE - max_dc * w - w
    if r0_lo > r0_hi or c0_lo > c0_hi:
        return None

    r0 = random.randint(r0_lo, r0_hi)
    c0 = random.randint(c0_lo, c0_hi)

    # Verify no pixel overlap between stamps
    occupied = set()
    for dr, dc in deltas:
        for tr, tc in templ_cells:
            pt = (r0 + dr * h + tr, c0 + dc * w + tc)
            if pt in occupied:
                return None
            occupied.add(pt)

    return _place_singletons(
        deltas, min_dr, max_dr, min_dc, max_dc,
        templ_cells, r0, c0, h, w, bg, T, O, occupied,
    )


def generate_input() -> np.ndarray:
    for _ in range(GENERATE_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate input after %d attempts" % GENERATE_RETRIES)
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import bbox_coords, bbox_h, bbox_w, crop_bbox, find_components, label_mask
import random
from arc_utils import label_mask, random_free_location, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Match sprites to frames by connected-hole count, then nest each sprite inside its frame.

    Input structure:
    - bg = azure (8). Large hollow squares (frames) arranged in a grid; smaller filled squares (sprites) placed elsewhere.
    - Each frame and sprite has a distinct color. Sprites may contain holes (non-sprite-color pixels).

    Rule:
    - Frames form a regular grid; some may be bg-colored (invisible).
    - Count connected hole regions inside each frame's interior and each sprite.
    - Pair each frame with the sprite sharing the same hole count.
    - Place the matched sprite inside the frame border; recolor sprite holes to the frame's color.

    Key insight: The matching key is the number of connected hole components, not hole area or color.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    BG = 8  # Azure background for this puzzle family

    comps = find_components(g, bg=BG, connectivity=4, monochromatic=True, return_format="dict")

    # Find square regions (lower fill threshold to catch sprites with holes).
    MIN_FILL_RATIO = 0.5
    square_regions: list[tuple[int, dict]] = []
    for comp in comps:
        b = comp["bbox"]
        h = int(bbox_h(b))
        w = int(bbox_w(b))
        area = int(comp["area"])
        if h == w and 4 <= h <= 10 and area >= int(h * h * MIN_FILL_RATIO):
            square_regions.append((int(h), comp))

    assert not (not square_regions)

    # Group by size - frames are larger, sprites are smaller.
    sizes: dict[int, list[dict]] = {}
    for size, comp in square_regions:
        sizes.setdefault(int(size), []).append(comp)

    size_list = sorted(sizes.keys(), reverse=True)
    frame_size = int(size_list[0])
    sprite_size = int(size_list[1]) if len(size_list) > 1 else int(frame_size - 2)

    frames = sizes.get(int(frame_size), [])
    sprites_raw = sizes.get(int(sprite_size), [])
    assert not (not frames)

    # Determine frame grid structure from frame positions.
    frame_positions = [(int(f["bbox"][0]), int(f["bbox"][1])) for f in frames]
    min_r = min(r for r, c in frame_positions)
    min_c = min(c for r, c in frame_positions)
    max_r = max(r for r, c in frame_positions)
    max_c = max(c for r, c in frame_positions)

    n_rows = int((max_r - min_r) // frame_size + 1)
    n_cols = int((max_c - min_c) // frame_size + 1)

    # Build frame grid (including potential background-colored frames).
    frame_grid = []
    for ri in range(n_rows):
        for ci in range(n_cols):
            inp_r = int(min_r + ri * frame_size)
            inp_c = int(min_c + ci * frame_size)
            region = g[inp_r : inp_r + frame_size, inp_c : inp_c + frame_size]
            border = np.concatenate([region[0, :], region[-1, :], region[:, 0], region[:, -1]])
            frame_color = int(Counter(map(int, border.flatten())).most_common(1)[0][0])

            inner = region[1:-1, 1:-1]
            hole_mask = inner != int(frame_color)
            _lab, num_holes = label_mask(hole_mask, connectivity=4)

            frame_grid.append({"color": int(frame_color), "out_r": int(ri * frame_size), "out_c": int(ci * frame_size), "holes": int(num_holes)})

    # Process sprites - count holes in each.
    sprites = []
    for comp in sprites_raw:
        b = comp["bbox"]
        sprite_region = crop_bbox(g, b)
        sprite_color = int(comp["color"])
        hole_mask = sprite_region != int(sprite_color)
        _lab, num_holes = label_mask(hole_mask, connectivity=4)
        sprites.append({"color": int(sprite_color), "holes": int(num_holes), "content": sprite_region.copy(), "h": int(sprite_region.shape[0]), "w": int(sprite_region.shape[1])})

    # Match frames to sprites by hole count.
    matches: dict[tuple[int, int], tuple[dict, dict]] = {}
    used_sprites: set[int] = set()
    for f in frame_grid:
        for i, s in enumerate(sprites):
            if int(i) not in used_sprites and int(f["holes"]) == int(s["holes"]):
                matches[(int(f["out_r"]), int(f["out_c"]))] = (f, s)
                used_sprites.add(int(i))
                break

    # Build output grid.
    out_h = int(n_rows * frame_size)
    out_w = int(n_cols * frame_size)
    out = np.full((out_h, out_w), int(BG), dtype=int)

    for f in frame_grid:
        fr, fc = int(f["out_r"]), int(f["out_c"])
        frame_color = int(f["color"])
        out[fr : fr + frame_size, fc : fc + frame_size] = int(frame_color)

        if (fr, fc) in matches:
            _f, sprite = matches[(fr, fc)]
            content = np.array(sprite["content"], dtype=int).copy()
            sprite_color = int(sprite["color"])
            content[content != int(sprite_color)] = int(frame_color)

            sh, sw = int(sprite["h"]), int(sprite["w"])
            out[fr + 1 : fr + 1 + sh, fc + 1 : fc + 1 + sw] = content

    return out

# --------------- generator (attempt_1) ---------------

# ── Configuration ──────────────────────────────────────────────────────
BG = 8                      # background color (solver hardcodes azure=8)
FRAME_SIZE_RANGE = [6, 7, 8]  # square frame side length
GRID_DIM_RANGE = (1, 4)     # rows/cols of the frame grid (exclusive upper)
N_RANGE = (2, 6)             # min/max frame count (inclusive)
CANVAS_MIN = 15              # minimum input grid side
CANVAS_MAX = 30              # maximum input grid side
SPRITE_PADDING = 2           # extra canvas room for sprite placement
SPRITE_PLACEMENT_PAD = 1     # padding around sprites when placing
HOLE_START_MAX = 1           # max starting hole count (0 or 1)
SEED_RETRIES = 50            # retries for placing isolated seed cells
GEN_RETRIES = 300            # outer generate_input retry budget

# Precompute valid grid layouts: {N: [(rows, cols), ...]}
_LAYOUTS_BY_N: dict[int, list[tuple[int, int]]] = {}
for _r in range(GRID_DIM_RANGE[0], GRID_DIM_RANGE[1]):
    for _c in range(GRID_DIM_RANGE[0], GRID_DIM_RANGE[1]):
        if N_RANGE[0] <= _r * _c <= N_RANGE[1]:
            _LAYOUTS_BY_N.setdefault(_r * _c, []).append((_r, _c))
_VALID_NS = sorted(_LAYOUTS_BY_N.keys())

    # 6. Place frame grid on canvas
    canvas = np.full((H, W), BG, dtype=int)
    r0 = random.randint(0, H - grid_pixel_h)
    c0 = random.randint(0, W - grid_pixel_w)
    for idx, (_, fpatch) in enumerate(frames):
