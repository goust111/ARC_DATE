from pathlib import Path
from collections import Counter
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/4/036/3.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
out_sigs = set()
stats = Counter()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    checked, traces, containers = mod._solve(inp, with_trace=True)
    assert np.array_equal(checked, out)
    assert not np.array_equal(inp, out)
    stats[('containers', len(containers))] += 1
    stats[('sources', len(traces))] += 1
    kinds = {e[0] for t in traces for e in t['events']}
    assert {'enter', 'shift', 'terminate', 'wall'} <= kinds
    if 'bottom' in kinds:
        stats['bottom_cases'] += 1
    shift = next(e for t in traces for e in t['events'] if e[0] == 'shift')
    stats['shift_left' if shift[2] < shift[1] else 'shift_right'] += 1
print('variants', len(sigs))
print('output variants', len(out_sigs))
print('stats', dict(stats))
assert len(sigs) >= 20
assert len(out_sigs) >= 20
assert stats['shift_left'] and stats['shift_right']
assert stats[('containers', 4)] and stats[('containers', 6)]
assert stats[('sources', 2)] and stats[('sources', 4)]
