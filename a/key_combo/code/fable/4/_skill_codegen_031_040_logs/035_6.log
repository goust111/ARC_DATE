+        # unchanged, but its depth colors must change: the palette step is real.
+        witness = basins[0]
+        marker_rows = [
+            r
+            for r in range(witness.bottom - 1, witness.top - 1, -1)
+            if int(grid[r, witness.marker_side]) not in (GREY, BLACK, BLUE)
+        ]
+        if len(marker_rows) < 2:
