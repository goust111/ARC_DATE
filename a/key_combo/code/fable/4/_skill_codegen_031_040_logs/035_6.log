+    grid: np.ndarray, basins: list[Basin]
+) -> tuple[list[list[tuple[int, int]]], dict[tuple[int, int], int]]:
+    terrain = _terrain_mask(grid)
+    assignments: list[list[tuple[int, int]]] = [[] for _ in basins]
+    slide_counts: dict[tuple[int, int], int] = {}
