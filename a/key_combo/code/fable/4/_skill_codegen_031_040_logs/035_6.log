+    specs: list[dict] = []
+    cursor = left_margin
+    for i, (inner_w, depth, palette) in enumerate(zip(widths, layers, palettes)):
+        left = cursor
+        right = left + inner_w + 1
+        bottom = h - rng.randint(2, 4)
+        wall_height = max(depth + 2, len(palette) + 3) + rng.randint(0, 2)
+        top = bottom - wall_height + 1
+        if top < 9:
+            return None
