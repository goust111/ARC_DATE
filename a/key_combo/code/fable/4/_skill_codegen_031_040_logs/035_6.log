+    r, c = stop
+    matches = [
+        i
+        for i, basin in enumerate(basins)
+        if basin.top <= r < basin.bottom and basin.left < c < basin.right
+    ]
+    assert len(matches) == 1, f"settled water at {stop} must belong to one basin"
+    return matches[0]
+
