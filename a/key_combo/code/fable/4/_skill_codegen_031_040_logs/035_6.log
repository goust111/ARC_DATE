+def _detect_basins(grid: np.ndarray) -> list[Basin]:
+    """Find separated U shapes from their gray floors, then read wall markers."""
+    h, w = grid.shape
+    terrain = _terrain_mask(grid)
+    basins: list[Basin] = []
