+    for bottom in range(h):
+        for left, right in _gray_runs(grid[bottom]):
+            # A floor has open background below it (or lies at the grid edge).
+            if bottom + 1 < h and np.any(grid[bottom + 1, left : right + 1] != BLACK):
+                continue
