sigs = set()
out_to_in = {}
shapes = Counter()
patch_shapes = Counter()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    inp_sig = hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest()
    out_sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest()
    assert out_sig not in out_to_in or out_to_in[out_sig] == inp_sig, 'distinct generated inputs shared one output'
    out_to_in[out_sig] = inp_sig
    sigs.add(inp_sig)
    shapes[inp.shape] += 1
    coords = np.argwhere(inp == mod.PATCH_COLOR)
    r0, c0 = coords.min(axis=0); r1, c1 = coords.max(axis=0)
    patch_shapes[(int(r1-r0+1), int(c1-c0+1))] += 1
    sh, sw = math.isqrt(inp.shape[0]), math.isqrt(inp.shape[1])
    expected_patch = out[r0:r1+1, c0:c1+1]
    assert len(np.unique(expected_patch)) == 3
    assert not (r0 % sh == 0 and (r1+1) % sh == 0 and c0 % sw == 0 and (c1+1) % sw == 0)
print('variants', len(sigs))
print('outputs', len(out_to_in))
print('grid_shapes', dict(sorted(shapes.items())))
print('patch_shape_variants', len(patch_shapes))
assert len(sigs) >= 20
assert len(out_to_in) == len(sigs)
assert len(shapes) >= 6
assert len(patch_shapes) >= 8
