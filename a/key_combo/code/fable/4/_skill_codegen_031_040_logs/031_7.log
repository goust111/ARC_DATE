+        boxes = _candidate_patch_boxes(expected, seed, bg, primary, secondary)
+        if not boxes:
+            continue
+        box = _choose_patch_box(boxes, seed)
+
+        inp = expected.copy()
+        r0, c0, r1, c1 = box
+        inp[r0:r1, c0:c1] = PATCH_COLOR
+        if _semantically_valid(inp, expected, seed, bg, primary, secondary, box):
