def main(grid: np.ndarray) -> np.ndarray:
    """
    Build a 3x3 mosaic of whole-grid mirror reflections around the original tile.

    Input structure
    - The input is a 3x3 color grid; every cell belongs to the source tile.

    Rule
    - Produce a 9x9 grid split into nine 3x3 tile slots.
    - The center slot is the original tile.
    - Slots above or below the center reverse source rows.
    - Slots left or right of the center reverse source columns.
    - Corner slots reverse both rows and columns.

    Key insight
    The output is reflection wallpaper of the entire small grid, not per-pixel scaling or color-specific processing.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert g.shape == (3, 3), "expected the 3x3 source tile"

    rows = np.arange(g.shape[0])
    cols = np.arange(g.shape[1])
    row_order = np.concatenate((rows[::-1], rows, rows[::-1]))
    col_order = np.concatenate((cols[::-1], cols, cols[::-1]))
    return g[row_order[:, None], col_order[None, :]]
def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        inp = _gen_attempt()
        if inp is None:
            continue
        out = _gen_expected_output(inp)
        if np.array_equal(main(inp), out):
            return inp
    raise RuntimeError("failed to generate a valid c48954c1 input")
def _expected_output(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:
    """Render the two-level fractal that main() should produce."""
    seed_h, seed_w = seed_mask.shape
    H, W = shape
    rows = np.arange(H)[:, None]
    cols = np.arange(W)[None, :]

    inner = seed_mask[rows % seed_h, cols % seed_w]
    meta = seed_mask[(rows // seed_h) % seed_h, (cols // seed_w) % seed_w]

    out = np.full((H, W), bg, dtype=int)
    out[inner & meta] = primary
    out[inner & ~meta] = secondary
    return out

def _layout_options(seed_h: int, seed_w: int) -> list[tuple[int, int]]:
    """Return valid canvas shapes for a sampled seed size."""
    options = []
    for k in TILE_MULTIPLIERS:
        for rem in REMAINDERS_BY_SQUARENESS[seed_h == seed_w]:
            H = seed_h * k + rem
            W = seed_w * k + rem
            if GRID_MIN <= H <= GRID_MAX and GRID_MIN <= W <= GRID_MAX and H >= seed_h * seed_h and W >= seed_w * seed_w:
                options.append((H, W))
    return options

def _random_seed_mask(seed_h: int, seed_w: int) -> np.ndarray:
    """Sample a nonempty, nonfull primary mask within density bounds."""
    area = seed_h * seed_w
    lo = max(1, int(np.ceil(area * SEED_DENSITY_MIN)))
    hi = min(area - 1, int(np.floor(area * SEED_DENSITY_MAX)))
    n_primary = random.randint(lo, hi)
    chosen = random.sample(range(area), n_primary)
    mask = np.zeros((seed_h, seed_w), dtype=bool)
    mask.reshape(-1)[chosen] = True
    return mask

def _render_input(seed_mask: np.ndarray, shape: tuple[int, int], bg: int, primary: int, secondary: int) -> np.ndarray:
    """Render the top-left seed legend on a background canvas."""
    seed_h, seed_w = seed_mask.shape
    inp = np.full(shape, bg, dtype=int)
    inp[:seed_h, :seed_w][seed_mask] = primary
    inp[seed_h, : seed_w + 1] = secondary
    inp[:seed_h, seed_w] = secondary
    return inp

def _gen_attempt() -> np.ndarray | None:
    """Build one oracle-checked input grid, or None if validation fails."""
    bg = BACKGROUND_COLOR
    primary, secondary = random.sample([c for c in PALETTE_COLORS if c != bg], 2)

    seed_h = random.choice(SEED_SIZES)
    seed_w = random.choice(SEED_SIZES)
    H, W = random.choice(_layout_options(seed_h, seed_w))

    seed_mask = _random_seed_mask(seed_h, seed_w)
    inp = _render_input(seed_mask, (H, W), bg, primary, secondary)
    expected = _expected_output(seed_mask, (H, W), bg, primary, secondary)
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp

def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 58c02a16 input")
MARKER_AND_SPRITE_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]

# Sprite blob geometry.
SPRITE_PIXEL_RANGE = (7, 11)
BLOB_HEIGHT_OPTIONS, BLOB_WIDTH_OPTIONS = (3, 4), (3, 4, 5)
BLOB_MARKER_MARGIN = 1
FOUR_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))

# Source and destination window constraints.
SOURCE_HEIGHT_RANGE, SOURCE_WIDTH_RANGE = (4, 7), (5, 7)
SOURCE_DENSITY_RANGE = (0.19, 0.36)
DEST_SIZE_RANGE = (5, 9)

# Canvas placement and retry budget.
GRID_SIZE_RANGE = (18, 23)
WINDOW_BORDER, WINDOW_PADDING = 1, 1
GENERATION_ATTEMPTS = 300

def _gen_monotone_path(start, end):
    r, c = start
    er, ec = end
    moves = []
    moves.extend([(1 if er > r else -1, 0)] * abs(er - r))
    moves.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
    random.shuffle(moves)

    path = [(r, c)]
    for dr, dc in moves:
        r += dr
        c += dc
        path.append((r, c))
    return path

def _gen_spanning_component(height, width, total_cells):
    marker = (
        random.randrange(BLOB_MARKER_MARGIN, height - BLOB_MARKER_MARGIN),
        random.randrange(BLOB_MARKER_MARGIN, width - BLOB_MARKER_MARGIN),
    )
    corner = random.choice([(0, 0), (0, width - 1), (height - 1, 0), (height - 1, width - 1)])
    opposite = (height - 1 - corner[0], width - 1 - corner[1])

    coords = set(_gen_monotone_path(corner, marker))
    coords.update(_gen_monotone_path(marker, opposite))

    while len(coords) < total_cells:
        frontier = []
        for r, c in coords:
            for dr, dc in FOUR_NEIGHBORS:
                nr = r + dr
                nc = c + dc
                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in coords:
                    frontier.append((nr, nc))
        if not frontier:
            return None
        coords.add(random.choice(frontier))

    return coords, marker

def _gen_pick_bbox(sprite_pixels):
    total_cells = sprite_pixels + 1
    choices = [
        (height, width)
        for height in BLOB_HEIGHT_OPTIONS
        for width in BLOB_WIDTH_OPTIONS
        if height + width - 1 <= total_cells <= height * width
    ]
    return random.choice(choices)

def _gen_pick_source_size(blob_height, blob_width, sprite_pixels):
    min_density, max_density = SOURCE_DENSITY_RANGE
    choices = []
    for height in range(max(SOURCE_HEIGHT_RANGE[0], blob_height), SOURCE_HEIGHT_RANGE[1] + 1):
        for width in range(max(SOURCE_WIDTH_RANGE[0], blob_width), SOURCE_WIDTH_RANGE[1] + 1):
            density = sprite_pixels / (height * width)
            if min_density <= density <= max_density:
                choices.append((height, width))
    if not choices:
        return None
    return random.choice(choices)

def _paint_aligned_sprite(canvas, sprite_coords, src_marker, dst_marker, marker_color, sprite_color):
    dr = dst_marker[0] - src_marker[0]
    dc = dst_marker[1] - src_marker[1]
    for r, c in sprite_coords:
        canvas[dr + r, dc + c] = sprite_color
    canvas[dst_marker] = marker_color

def _gen_sprite_blob():
    sprite_pixels = random.randint(*SPRITE_PIXEL_RANGE)
    blob_height, blob_width = _gen_pick_bbox(sprite_pixels)
    component = _gen_spanning_component(blob_height, blob_width, sprite_pixels + 1)
    if component is None:
        return None
    blob_coords, src_marker = component
    sprite_coords = [coord for coord in blob_coords if coord != src_marker]
    if len(sprite_coords) != sprite_pixels:
        return None
    return sprite_pixels, blob_height, blob_width, src_marker, sprite_coords

def _place_windows(source, dest):
    height = random.randint(*GRID_SIZE_RANGE)
    width = random.randint(*GRID_SIZE_RANGE)
    grid = np.full((height, width), BG_COLOR, dtype=int)
    windows = [source, dest]
    random.shuffle(windows)
    try:
        for window in windows:
            r0, c0 = random_free_location(grid, window, transparent=BG_COLOR, border=WINDOW_BORDER, padding=WINDOW_PADDING)
            paste(grid, window, r0, c0)
    except ValueError:
        return None
    return grid

def _gen_attempt():
    marker_color, sprite_color = random.sample(MARKER_AND_SPRITE_COLORS, 2)
    sprite = _gen_sprite_blob()
    if sprite is None:
        return None
    sprite_pixels, blob_height, blob_width, src_marker, sprite_coords = sprite

    source_size = _gen_pick_source_size(blob_height, blob_width, sprite_pixels)
    if source_size is None:
        return None
    source_height, source_width = source_size
    source_top = random.randint(0, source_height - blob_height)
    source_left = random.randint(0, source_width - blob_width)
    source = np.full((source_height, source_width), FILL_COLOR, dtype=int)
    source_marker = (source_top + src_marker[0], source_left + src_marker[1])
    _paint_aligned_sprite(source, sprite_coords, src_marker, source_marker, marker_color, sprite_color)

    top_extent = src_marker[0]
    bottom_extent = blob_height - 1 - src_marker[0]
    left_extent = src_marker[1]
    right_extent = blob_width - 1 - src_marker[1]
    dest_height = random.randint(max(DEST_SIZE_RANGE[0], blob_height), DEST_SIZE_RANGE[1])
    dest_width = random.randint(max(DEST_SIZE_RANGE[0], blob_width), DEST_SIZE_RANGE[1])
    dest_marker = (
        random.randint(top_extent, dest_height - 1 - bottom_extent),
        random.randint(left_extent, dest_width - 1 - right_extent),
    )

    expected = np.full((dest_height, dest_width), FILL_COLOR, dtype=int)
    _paint_aligned_sprite(expected, sprite_coords, src_marker, dest_marker, marker_color, sprite_color)
    dest = np.full((dest_height, dest_width), FILL_COLOR, dtype=int)
    dest[dest_marker] = marker_color

    grid = _place_windows(source, dest)
    if grid is None:
        return None
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid

def generate_input():
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input for 2f0c5170")
FRAME_GAP = 1
ROW_WEIGHT_FLOOR, ROW_WEIGHT_MARGIN, ROW_WEIGHT_POWER = 0.25, 2, 2
SIDE_WEIGHT_POWER, ROW_GROW_MIN_DIVISOR = 2, 2

# Final random orientation and retry budget.
ROTATION_TURNS_MIN, ROTATION_TURNS_MAX = 0, 3
FLIP_OPTIONS = (False, True)
GENERATION_RETRIES = 300

def _gen_frame_patch(side: int) -> np.ndarray:
    patch = np.zeros((side, side), dtype=int)
    patch[0, :] = Color.BLUE
    patch[-1, :] = Color.BLUE
    patch[:, 0] = Color.BLUE
    patch[:, -1] = Color.BLUE
    return patch

def _gen_expected_output(inp: np.ndarray, frames: list[tuple[int, int, int]]) -> np.ndarray:
    out = inp.copy()
    for r0, c0, side in frames:
        fill = Color.ORANGE if side % 2 else Color.RED
        out[r0 + 1 : r0 + side - 1, c0 + 1 : c0 + side - 1] = fill
    return out

def _gen_split_slack(extra: int, slots: int) -> list[int]:
    cuts = sorted(random.randint(0, extra) for _ in range(slots - 1))
    parts = []
    prev = 0
    for cut in cuts + [extra]:
        parts.append(cut - prev)
        prev = cut
    random.shuffle(parts)
    return parts

def _gen_weighted_choice(items: list[int], weights: list[float]) -> int:
    total = sum(weights)
    pick = random.random() * total
    upto = 0.0
    for item, weight in zip(items, weights):
        upto += weight
        if pick <= upto:
            return item
    return items[-1]

def _gen_min_side(parity: int) -> int:
    return FRAME_SIDE_MIN_EVEN if parity == 0 else FRAME_SIDE_MIN_ODD

def _gen_row_counts(n: int, k: int) -> list[int] | None:
    min_slot_span = FRAME_SIDE_MIN_ODD + FRAME_GAP
    max_per_row = (n + FRAME_GAP) // min_slot_span
    max_rows = min(k, (n + FRAME_GAP) // min_slot_span)
    feasible_rows = [r for r in range(1, max_rows + 1) if k <= r * max_per_row]
    if not feasible_rows:
        return None

    weights = []
    for rows in feasible_rows:
        max_frames_in_row = (k + rows - 1) // rows
        vertical_avg = (n - FRAME_GAP * (rows - 1)) / rows
        horizontal_avg = (n - FRAME_GAP * (max_frames_in_row - 1)) / max_frames_in_row
        weights.append(
            max(ROW_WEIGHT_FLOOR, min(vertical_avg, horizontal_avg) - ROW_WEIGHT_MARGIN) ** ROW_WEIGHT_POWER
        )

    row_count = _gen_weighted_choice(feasible_rows, weights)
    base = k // row_count
    extra = k % row_count
    counts = [base + 1] * extra + [base] * (row_count - extra)
    random.shuffle(counts)
    return counts

def _gen_choose_row_heights(n: int, row_parities: list[list[int]]) -> list[int] | None:
    row_mins = [max(_gen_min_side(parity) for parity in parities) for parities in row_parities]
    extra = n - FRAME_GAP * (len(row_mins) - 1) - sum(row_mins)
    if extra < 0:
        return None

    heights = row_mins[:]
    min_grow = (extra + ROW_GROW_MIN_DIVISOR - 1) // ROW_GROW_MIN_DIVISOR
    grow_budget = random.randint(min_grow, extra) if extra else 0
    while grow_budget:
        choices = [i for i, height in enumerate(heights) if height < FRAME_SIDE_MAX]
        if not choices:
            break
        row = random.choice(choices)
        heights[row] += 1
        grow_budget -= 1
    return heights

def _gen_choose_sides(n: int, height: int, parities: list[int]) -> list[int] | None:
    remaining = n - FRAME_GAP * (len(parities) - 1)
    sides = []
    for i, parity in enumerate(parities):
        min_side = _gen_min_side(parity)
        future_min = sum(_gen_min_side(p) for p in parities[i + 1 :])
        max_side = min(FRAME_SIDE_MAX, height, remaining - future_min)
        candidates = [side for side in range(min_side, max_side + 1) if side % 2 == parity]
        if not candidates:
            return None
        side = _gen_weighted_choice(candidates, [side**SIDE_WEIGHT_POWER for side in candidates])
        sides.append(side)
        remaining -= side
    random.shuffle(sides)
    return sides

def _gen_layout(n: int, k: int) -> tuple[list[int], list[list[int]]] | None:
    """Choose row heights and per-row frame parities without placing pixels."""
    parity_plan = [0, 1]
    parity_plan.extend(random.randint(0, 1) for _ in range(k - 2))
    random.shuffle(parity_plan)

    row_counts = _gen_row_counts(n, k)
    if row_counts is None:
        return None

    row_parities = []
    cursor = 0
    for count in row_counts:
        row_parities.append(parity_plan[cursor : cursor + count])
        cursor += count
    random.shuffle(row_parities)

    row_heights = _gen_choose_row_heights(n, row_parities)
    if row_heights is None:
        return None
    return row_heights, row_parities

def _gen_place_frames(
    n: int, row_heights: list[int], row_parities: list[list[int]]
) -> tuple[np.ndarray, list[tuple[int, int, int]]] | None:
    """Render non-overlapping square frames from the row layout."""
    inp = np.zeros((n, n), dtype=int)
    frames: list[tuple[int, int, int]] = []

    used_height = sum(row_heights) + FRAME_GAP * (len(row_heights) - 1)
    v_slack = _gen_split_slack(n - used_height, len(row_heights) + 1)
    r = v_slack[0]
    for row_i, (height, parities) in enumerate(zip(row_heights, row_parities)):
        sides = _gen_choose_sides(n, height, parities)
        if sides is None:
            return None

        used_width = sum(sides) + FRAME_GAP * (len(sides) - 1)
        h_slack = _gen_split_slack(n - used_width, len(sides) + 1)
        c = h_slack[0]
        for side_i, side in enumerate(sides):
            r0 = r + random.randint(0, height - side)
            paste(inp, _gen_frame_patch(side), r0, c, transparent=None)
            frames.append((r0, c, side))
            c += side + FRAME_GAP + h_slack[side_i + 1]
        r += height + FRAME_GAP + v_slack[row_i + 1]
    return inp, frames

def _gen_random_orientation(inp: np.ndarray, expected: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    turns = random.randint(ROTATION_TURNS_MIN, ROTATION_TURNS_MAX)
    if turns:
        inp = np.rot90(inp, turns)
        expected = np.rot90(expected, turns)
    if random.choice(FLIP_OPTIONS):
        inp = np.fliplr(inp)
        expected = np.fliplr(expected)
    return inp, expected

def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
    max_k = FRAME_COUNT_MAX_AT_MIN_GRID if n == GRID_SIDE_MIN else FRAME_COUNT_MAX
    k = random.randint(FRAME_COUNT_MIN, max_k)

    layout = _gen_layout(n, k)
    if layout is None:
        return None

    placed = _gen_place_frames(n, *layout)
    if placed is None:
        return None
    inp, frames = placed
    expected = _gen_expected_output(inp, frames)
    inp, expected = _gen_random_orientation(inp, expected)
    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp

def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

