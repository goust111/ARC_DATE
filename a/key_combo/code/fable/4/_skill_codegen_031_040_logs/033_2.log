+    starts = [tuple(map(int, p)) for p in np.argwhere(g == YELLOW)]
+    ends = [tuple(map(int, p)) for p in np.argwhere(g == MAROON)]
+    blockers = [tuple(map(int, p)) for p in np.argwhere(g == ORANGE)]
