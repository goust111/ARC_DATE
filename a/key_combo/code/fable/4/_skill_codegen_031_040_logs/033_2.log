+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+BEAD_COLORS = (1, 2, 3, 6)
+
+N4 = ((-1, 0), (0, -1), (0, 1), (1, 0))
