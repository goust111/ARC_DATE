+def _forbidden(shape: tuple[int, int], blockers: list[tuple[int, int]]) -> np.ndarray:
+    """Return the blocker cells and their Chebyshev-radius-one neighborhoods."""
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in blockers:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
