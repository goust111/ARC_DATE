+    """Extract grey placeholder blocks using four-connectivity."""
+    unseen = {tuple(map(int, p)) for p in np.argwhere(grid == GREY)}
+    components: list[list[tuple[int, int]]] = []
+    while unseen:
+        seed = min(unseen)
+        unseen.remove(seed)
+        queue = deque([seed])
+        component = [seed]
+        while queue:
+            r, c = queue.popleft()
+            for dr, dc in N4:
+                nxt = (r + dr, c + dc)
+                if nxt in unseen:
