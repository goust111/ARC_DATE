+            left = right - widths[i] + 1
+            intervals[i] = (left, right)
+            cursor = left
+    else:
+        cursor = anchor_right if target_mode == "anchor" else -1
+        for i in range(chain_len - 1, -1, -1):
+            gap = random.randint(2, 5 if target_mode == "anchor" else 6)
+            left = cursor + gap + 1
+            right = left + widths[i] - 1
+            intervals[i] = (left, right)
+            cursor = right
