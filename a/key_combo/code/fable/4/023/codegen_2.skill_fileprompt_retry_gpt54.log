+            out[r, c] = int(piece["color"])
+
+    return out
+
+
+def _make_red_piece(top: int, height: int, full_left: int, full_width: int, sign: int) -> tuple[Coord, ...]:
+    body_width = full_width - 1
+    tail_row = top + random.randrange(height)
+    cells: list[Coord] = []
+
+    if sign == 1:
+        body_left = full_left + 1
+        tail_col = full_left
+    else:
