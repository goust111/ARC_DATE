+
+    lane_specs = []
+    toward_sign = random.choice((1, -1))
+    lane_specs.append((lane_bands[0], toward_sign, "anchor", random.randint(3, 4)))
+
+    for top, lane_height in lane_bands[1:]:
+        side = random.choice(("left", "right"))
+        sign = -1 if side == "left" else 1
