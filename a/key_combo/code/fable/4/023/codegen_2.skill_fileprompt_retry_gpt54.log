+    pieces: list[tuple[int, tuple[Coord, ...]] | None] = []
+    for i, (left, _right) in enumerate(intervals):
+        if i == 0:
+            pieces.append((RED, _make_red_piece(top, height, left, widths[i], sign)))
+        else:
