+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is None:
+            continue
+        if np.array_equal(main(grid), _transform(grid)):
