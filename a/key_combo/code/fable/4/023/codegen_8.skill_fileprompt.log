+
+    for _ in range(80):
+        if placed == target_count:
+            break
+        rect_h, rect_w = _random_choice(list(OBSTACLE_SIZES), rng)
+        if height - 4 - rect_h <= 0 or width - 4 - rect_w <= 0:
