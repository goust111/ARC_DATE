+        blocked_count = sum(cand.blocked for cand in selected)
+        direct_count = len(selected) - blocked_count
+        if (
+            len(selected) >= PIXEL_COUNT_MIN
+            and blocked_count >= 1
+            and direct_count >= 1
+            and any(cand.far for cand in selected)
+            and len({cand.side for cand in selected}) == 4
