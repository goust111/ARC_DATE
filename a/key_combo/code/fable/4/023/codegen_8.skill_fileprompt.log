+        c0 = int(rng.integers(2, width - 2 - rect_w + 1))
+        r1 = r0 + rect_h - 1
+        c1 = c0 + rect_w - 1
+
+        rr0 = max(1, r0 - 1)
+        cc0 = max(1, c0 - 1)
+        rr1 = min(height - 2, r1 + 1)
+        cc1 = min(width - 2, c1 + 1)
+        if mask[rr0 : rr1 + 1, cc0 : cc1 + 1].any():
+            continue
+
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
