+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DEGREE_TO_COLOR = {
+    1: BLUE,
+    2: RED,
+    3: YELLOW,
