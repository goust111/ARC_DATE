+    if np.max(cell_counts) < 2 or len(set(map(int, cell_counts.tolist()))) < 2:
+        return None
+
+    row_heights = [int(rng.integers(CELL_SIZE_MIN, CELL_SIZE_MAX_EXCLUSIVE)) for _ in range(room_ids.shape[0])]
