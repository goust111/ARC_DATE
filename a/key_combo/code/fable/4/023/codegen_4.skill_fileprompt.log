+def _macro_neighbors(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    out = []
+    h, w = shape
+    for nr, nc in _neighbors4(r, c):
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
