+def _mask_from_cells(shape: tuple[int, int], cells: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in cells:
+        mask[int(r), int(c)] = True
+    return mask
