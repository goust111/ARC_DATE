+def _bbox_is_clear(
+    candidate: tuple[int, int, int, int], existing: list[tuple[int, int, int, int]], gap: int = 1
+) -> bool:
+    r0, c0, r1, c1 = candidate
+    for er0, ec0, er1, ec1 in existing:
+        separated = (
+            r1 + gap < er0
+            or er1 + gap < r0
+            or c1 + gap < ec0
+            or ec1 + gap < c0
+        )
+        if not separated:
+            return False
