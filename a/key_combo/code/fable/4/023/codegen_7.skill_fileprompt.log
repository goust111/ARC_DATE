+def _random_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    path = [(r, c)]
+
+    while (r, c) != (er, ec):
+        steps: list[tuple[int, int]] = []
+        if r < er:
+            steps.append((r + 1, c))
+        elif r > er:
+            steps.append((r - 1, c))
+        if c < ec:
+            steps.append((r, c + 1))
+        elif c > ec:
