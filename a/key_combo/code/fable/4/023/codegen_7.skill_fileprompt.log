+        return None
+
+    components = _connected_components(grid, BACKGROUND)
+    if len(components) != 3:
+        return None
+
+    by_color: dict[int, int] = {}
+    for component in components:
+        color = int(component["color"])
+        by_color[color] = by_color.get(color, 0) + 1
+    if sorted(by_color.values()) != [1, 2]:
