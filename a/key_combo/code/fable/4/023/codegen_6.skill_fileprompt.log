+    height = int(spec["height"])
+    bottom = int(spec["bottom_row"])
+    center = int(spec["center_col"])
+    color = int(spec["color"])
+    top = bottom - height + 1
+    assert np.all(out[top : bottom + 1, center] == BLACK)
+    out[top : bottom + 1, center] = color
+
