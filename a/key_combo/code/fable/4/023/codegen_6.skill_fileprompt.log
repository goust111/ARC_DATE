+    max_h = max(heights)
+    min_rows = max(10, max_h + 4, 5 * count)
+    min_cols = max(12, 2 * max_h + 5, 6 * count)
+    rows = int(rng.integers(min_rows, min(30, min_rows + 8) + 1))
+    cols = int(rng.integers(min_cols, min(30, min_cols + 10) + 1))
+    return rows, cols
