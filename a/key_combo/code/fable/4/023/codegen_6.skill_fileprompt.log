+def _footprint_bbox(spec: dict[str, int | str]) -> tuple[int, int, int, int]:
+    height = int(spec["height"])
+    bottom = int(spec["bottom_row"])
+    center = int(spec["center_col"])
+    return bottom - height + 1, center - height + 1, bottom, center + height - 1
+
