+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+    if not np.any(g != BLACK):
+        return g.copy()
+    specs = _parse_objects(g)
+    return _render_scene(g.shape, specs, flip_state=True)
+
