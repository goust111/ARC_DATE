12:def main(grid: np.ndarray) -> np.ndarray:
13:    """
14:    Recolor every third monochromatic foreground bar in top-to-bottom order red, starting with the first.
15:
16:    Input structure:
17:    - Black cells are the background.
18:    - The foreground consists of solid blue/teal horizontal rectangles.
19:    - Each rectangle is a maximal 4-connected monochromatic foreground object.
20:
21:    Rule:
22:    - Keep the grid shape and black background unchanged.
23:    - Order the foreground objects by top row, then left column.
24:    - Recolor objects with ranks 1, 4, 7, ... to red; leave all other foreground objects unchanged.
25:
26:    Key insight:
27:    - The selected objects are not chosen by their color or size; only their ordinal position in the vertical object sequence matters.
28:    """
29:    g = np.asarray(grid, dtype=int)
30:    colors = set(map(int, g.flat))
31:    assert Color.BLACK in colors, "expected black background cells"
32:    assert colors - {Color.BLACK} == {Color.BLUE, Color.TEAL}, "expected blue and teal foreground objects"
33:
34:    objects = find_components(g, bg=Color.BLACK, connectivity=4, monochromatic=True)
35:    assert objects, "expected foreground objects"
36:    for obj in objects:
37:        _assert_solid_rect(g, obj)
38:
39:    ordered = sorted(objects, key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
40:
41:    out = g.copy()
