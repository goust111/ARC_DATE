50:def main(grid: np.ndarray) -> np.ndarray:
51:    """
52:    Move the yellow 3x3 frame by the displacement encoded by the gray path, then draw its diagonal yellow corner rays.
53:
54:    Input structure:
55:    - The background is black.
56:    - One 3x3 yellow frame has a non-yellow control-color center.
57:    - A second control-color pixel is connected through gray path pixels to a lone yellow endpoint.
58:
59:    Rule:
60:    - Use the vector from the second control-color pixel to the lone yellow endpoint as the frame's translation.
61:    - Fill the whole output with the control color.
62:    - Draw the translated yellow frame and extend yellow diagonal rays outward from its four corners to the grid edge.
63:
64:    Key insight: The gray path's turns are irrelevant; its two colored endpoints encode the net displacement to apply to the frame.
65:    """
66:    g = np.asarray(grid, dtype=int)
67:    H, W = g.shape
68:
69:    bg = get_bg(g)
70:    assert bg == Color.BLACK
71:
72:    colors = set(map(int, np.unique(g)))
73:    role_colors = {int(bg), Color.YELLOW, Color.GREY}
74:    control_colors = colors - role_colors
75:    assert len(control_colors) == 1
76:    control = control_colors.pop()
77:    assert int((g == control).sum()) == 2
78:    assert int((g == Color.GREY).sum()) > 0
79:
80:    frame_center = _find_frame_center(g, control)
81:    fr, fc = frame_center
82:    frame_yellow = {
83:        (r, c)
84:        for r in range(fr - 1, fr + 2)
85:        for c in range(fc - 1, fc + 2)
86:        if (r, c) != frame_center
87:    }
88:
89:    yellow_cells = set(map(tuple, np.argwhere(g == Color.YELLOW)))
90:    endpoints = yellow_cells - frame_yellow
91:    assert len(endpoints) == 1
92:    endpoint = endpoints.pop()
93:
94:    control_cells = set(map(tuple, np.argwhere(g == control)))
95:    path_controls = control_cells - {frame_center}
96:    assert len(path_controls) == 1
97:    path_control = path_controls.pop()
98:    assert _gray_path_connects(g, path_control, endpoint)
99:
100:    dr = int(endpoint[0] - path_control[0])
101:    dc = int(endpoint[1] - path_control[1])
102:    out_center = (int(fr + dr), int(fc + dc))
103:    r, c = out_center
104:    assert 1 <= r < H - 1 and 1 <= c < W - 1
105:
106:    out = np.full_like(g, int(control))
107:    for rr, cc, direction in (
108:        (r - 1, c - 1, (-1, -1)),
109:        (r - 1, c + 1, (-1, 1)),
110:        (r + 1, c - 1, (1, -1)),
111:        (r + 1, c + 1, (1, 1)),
112:    ):
113:        draw_line(out, rr, cc, direction=direction, color=Color.YELLOW)
114:
115:    out[r - 1 : r + 2, c - 1 : c + 2] = Color.YELLOW
116:    out[r, c] = int(control)
117:    return out
