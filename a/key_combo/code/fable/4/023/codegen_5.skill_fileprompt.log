+    inp = _render_input(shape, rects, emitters)
+    if not _scene_is_valid(inp, emitters):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_scene(rng)
+        if grid is not None:
+            return grid
