+        return False
+    if len(_find_emitters(inp)) != len(emitters):
+        return False
+
+    obstacles = inp == RED
+    all_emitter_cells = set()
+    for head, direction in emitters:
+        all_emitter_cells.update(_emitter_cells(head, direction))
+
+    expected = inp.copy()
+    exits = set()
+    for head, direction in emitters:
