CELL_SIZE_CHOICES = (4, 5)
DIVIDER_ROW_CHOICES = (3, 4)
DIVIDER_COL_COUNT = 3
TRUNCATED_EDGE_SIZE_CHOICES = (2, 3)

# Sprite groups and colors.
