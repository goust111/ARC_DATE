+        grid[tail2] = TEAL
+        grid[tail1] = TEAL
+        grid[hr, hc] = YELLOW
+    return grid
+
+
+def _scene_is_valid(
+    inp: np.ndarray,
+    emitters: list[tuple[tuple[int, int], tuple[int, int]]],
+) -> bool:
