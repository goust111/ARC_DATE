/bin/bash -lc "python -m py_compile key_combo/code/fable/4/003/2.py && python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib, time
import numpy as np
p = Path('/home/lixinyu/snap/a/key_combo/code/fable/4/003/2.py')
mod = SourceFileLoader('repair_probe2', str(p)).load_module()
sigs = set()
times = []
counts = {}
t0 = time.perf_counter()
for i in range(100):
    t = time.perf_counter()
    inp = mod.generate_input()
    out = mod.main(inp)
    times.append(time.perf_counter() - t)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, inp.shape
    assert out.ndim == 2 and max(out.shape) <= 30, out.shape
    assert inp.shape == out.shape
    assert not np.array_equal(inp, out)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    nkeys = len(set(map(int, np.unique(inp))) - {0, 5})
    counts[nkeys] = counts.get(nkeys, 0) + 1
elapsed = time.perf_counter() - t0
print('variants', len(sigs), 'elapsed', round(elapsed, 3), 'max_case', round(max(times), 3), 'key_counts', counts)
assert len(sigs) >= 20
assert elapsed < 10
PY" in /home/lixinyu/snap/a
