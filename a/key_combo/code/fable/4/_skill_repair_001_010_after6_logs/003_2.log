        if len(variants) != 4:
            continue
        if variants & used_variants:
            continue
        return shape
    return None


def _sample_void_shape() -> Shape | None:
    count = random.randint(1, 3)
    return _connected_offsets(3, 3, count)


def _in_square(cells: set[Coord], box: tuple[int, int, int, int], margin: int = 0) -> bool:
    r0, c0, r1, c1 = box
    return all(r0 + margin <= r <= r1 - margin and c0 + margin <= c <= c1 - margin for r, c in cells)


def _body_connected(mask: np.ndarray) -> bool:
    comps = _mask_components(mask)
    return len(comps) == 1


