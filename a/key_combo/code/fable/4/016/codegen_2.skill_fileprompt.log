+    return {
+        "tile": tile,
+        "expected": expected,
+        "mismatch": mismatch,
+        "row_period": int(row_period),
+        "col_period": int(col_period),
+        "support_min": int(support.min()),
+    }
+
+
+def _best_periodic_model(grid: np.ndarray, ignore_mask: np.ndarray) -> dict:
