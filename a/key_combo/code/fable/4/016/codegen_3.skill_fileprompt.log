        return None
    comps = find_components(grid, bg=bg, colors=[fg], connectivity=4, monochromatic=True)
    if len(comps) != total_objects:
        return None
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def _gen_attempt():
