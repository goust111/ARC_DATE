+    sep_color = int(grid[split_r, split_c])
+    if not np.all(grid[split_r, :] == sep_color):
+        raise ValueError("separator row is not solid")
+    if not np.all(grid[:, split_c] == sep_color):
+        raise ValueError("separator column is not solid")
