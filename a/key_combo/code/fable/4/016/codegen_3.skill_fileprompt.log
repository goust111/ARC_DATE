            lo = max(SPRITE_MIN_PIXELS, int(np.ceil(SPRITE_MIN_DENSITY * h * w)))
            hi = min(SPRITE_MAX_PIXELS, h * w)
            for count in range(lo, hi + 1):
                options = _gen_mask_options(h, w, count)
                if options:
