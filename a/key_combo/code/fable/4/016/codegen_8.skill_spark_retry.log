        total_reflections += reflections
        if hit_loop:
            looped = True

    stats: dict[str, int | bool] = {
        "total_reflections": total_reflections,
        "painted_cells": total_painted,
        "looped": looped,
        "emitters": len(emitters),
        "mirrors": len(mirrors) // 2,
