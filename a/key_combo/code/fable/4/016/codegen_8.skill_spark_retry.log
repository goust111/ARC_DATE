    occupied = (out != bg)
    for lock in locks:
        matches = []
        for sprite_index, sprite in enumerate(sprites):
            for rot in range(4):
                if same_mask(np.rot90(lock["hole_shape"], rot), sprite["mask"]):
                    matches.append((sprite_index, rot))
