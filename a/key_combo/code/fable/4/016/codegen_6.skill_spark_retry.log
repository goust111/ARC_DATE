+        assert 0 <= rr0 <= rr1 < H and 0 <= cc0 <= cc1 < W
+        out[rr0 : rr1 + 1, cc0 : cc1 + 1] = col
+
+    assert not np.array_equal(out, g), "expected a visible transformation"
+    return out
