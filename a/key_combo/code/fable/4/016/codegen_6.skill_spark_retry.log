+        add_if_slider(body, (1, 0), r1 - br1, coords[coords[:, 0] > br1])
+
+    for br0 in range(r0 + 1, r1 + 1):
+        body = (br0, c0, r1, c1)
+        add_if_slider(body, (-1, 0), br0 - r0, coords[coords[:, 0] < br0])
