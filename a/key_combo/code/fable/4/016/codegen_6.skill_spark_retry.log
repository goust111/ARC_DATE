+            if len(rows) == 1 and cols == expected_cols:
+                candidates.append((body, direction, length))
+        else:
+            expected_rows = set(range(br1 + 1, r1 + 1)) if dr > 0 else set(range(r0, br0))
+            if len(cols) == 1 and rows == expected_rows:
