+def _validate_candidate(branch: int, inp: np.ndarray, out: np.ndarray, bg: int) -> bool:
+    changed = _changed_colors(inp, out, bg)
+    if branch == 0:
+        return len(changed) == 1
+    if branch == 1:
+        return len(changed) == 2
+    return len(changed) >= 3
