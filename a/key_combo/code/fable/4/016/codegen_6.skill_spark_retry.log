+
+    color, slider_body, direction, tail_len = slider
+    assert tail_len >= 2
+
+    bboxes = {i: bbox for i, (_, bbox) in enumerate(objects)}
+    slider_idx: int | None = None
+    for idx, (col, _) in enumerate(objects):
