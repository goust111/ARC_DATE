+            return
+        br0, bc0, br1, bc1 = body
+        if not _is_full_rect(mask, body):
+            return
+
+        dr, dc = direction
+        rows = set(map(int, outside[:, 0]))
+        cols = set(map(int, outside[:, 1]))
+        if dr == 0:
