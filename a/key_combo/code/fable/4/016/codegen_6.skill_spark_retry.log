+def _first_collision(
+    mover_idx: int,
+    bboxes: dict[int, BBox],
+    direction: Direction,
+) -> tuple[int | None, int]:
+    r0, c0, r1, c1 = bboxes[mover_idx]
+    dr, dc = direction
+    best_dist = 10**9
+    best_idx: int | None = None
+
+    for j, (rr0, cc0, rr1, cc1) in bboxes.items():
+        if j == mover_idx:
+            continue
+        if dr == 0 and dc > 0:
+            if cc0 > c1 and not (rr1 < r0 or rr0 > r1):
+                dist = int(cc0 - c1 - 1)
+                if dist < best_dist:
+                    best_dist, best_idx = dist, j
+        elif dr == 0 and dc < 0:
+            if cc1 < c0 and not (rr1 < r0 or rr0 > r1):
+                dist = int(c0 - cc1 - 1)
+                if dist < best_dist:
+                    best_dist, best_idx = dist, j
+        elif dr > 0 and dc == 0:
+            if rr0 > r1 and not (cc1 < c0 or cc0 > c1):
+                dist = int(rr0 - r1 - 1)
+                if dist < best_dist:
+                    best_dist, best_idx = dist, j
+        else:
+            if rr1 < r0 and not (cc1 < c0 or cc0 > c1):
+                dist = int(r0 - rr1 - 1)
+                if dist < best_dist:
+                    best_dist, best_idx = dist, j
+
+    if best_idx is None:
+        return None, best_dist
+    return best_idx, int(best_dist)
