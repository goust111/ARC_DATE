+        add_if_slider(body, (0, -1), bc0 - c0, coords[coords[:, 1] < bc0])
+
+    for br1 in range(r0, r1):
+        body = (r0, c0, br1, c1)
+        add_if_slider(body, (1, 0), r1 - br1, coords[coords[:, 0] > br1])
