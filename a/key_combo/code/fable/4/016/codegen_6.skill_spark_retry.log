+def _move_chain(
+    mover_idx: int,
+    budget: int,
+    direction: Direction,
+    bboxes: dict[int, BBox],
+    H: int,
+    W: int,
+    in_flight: set[int] | None = None,
+) -> None:
+    if budget <= 0:
+        return
+    if in_flight is None:
+        in_flight = set()
+    if mover_idx in in_flight:
+        return
+    in_flight.add(mover_idx)
