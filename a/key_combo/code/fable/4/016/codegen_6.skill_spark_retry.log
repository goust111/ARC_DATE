+
+def _detect_slider(mask: np.ndarray) -> tuple[BBox, Direction, int] | None:
+    coords = np.argwhere(mask)
+    assert coords.size, "expected non-empty component for slider detection"
+    r0, c0, r1, c1 = bbox_coords(coords)
