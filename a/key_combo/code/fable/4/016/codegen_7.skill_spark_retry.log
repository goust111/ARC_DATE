        full = (pr0, pc0, pr1, pc1 + length)
    elif dc < 0:
        full = (pr0, pc0 - length, pr1, pc1)
    elif dr > 0:
        full = (pr0, pc0, pr1 + length, pc1)
    else:
        full = (pr0 - length, pc0, pr1, pc1)
