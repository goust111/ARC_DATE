mod = SourceFileLoader('new_arc_task', '/home/lixinyu/snap/a/key_combo/code/fable/4/016/7.py').load_module()
from arc_utils import components_mask, get_bg

# Generate a concrete failing candidate directly until one fails in main.
for i in range(500):
    random.seed(i)
    np.random.seed(i)

    specs = mod._sample_specs()
    bg = random.choice([1,2,3,4,6,7,8,9])
    legend, _ = mod._render_legend(specs, bg)
    H = random.randint(max(14, legend.shape[0]+6), 30)
    W = random.randint(max(14, legend.shape[1]+10), 30)
    g = np.full((H,W), bg, dtype=int)
    lr = random.randint(1, H - legend.shape[0] - 1)
    lc = random.randint(1, W - legend.shape[1] - 1)
    mod.paste(g, legend, lr, lc)
    forbidden = np.zeros_like(g, dtype=bool)
    forbidden[lr:lr+legend.shape[0], lc:lc+legend.shape[1]] = True

    for spec in specs:
        patch = mod._make_object_patch(spec.color if not spec.has_points else 5, bg, spec.count)
        if patch is None:
            continue
        try:
            mod._place_patch(g, patch, bg, forbidden)
        except Exception:
            continue

    bg2 = get_bg(g)
    legend2 = mod._find_legend_bbox(g, bg2)
    rows = mod._extract_legend_rows(g, legend2, bg2)
    outside = np.ones_like(g,dtype=bool)
    outside[legend2[0]:legend2[2]+1, legend2[1]:legend2[3]+1]=False

    gray_components = []
    for idx, coords in enumerate(components_mask((g==5)&outside, connectivity=4)):
        gray_components.append((idx, coords, mod._holes_from_coords(coords)))

    # replicate matching
    for row in rows:
        rr, kc, kc_color, cnt = row
        if cnt>0:
            cand=[(idx,coords) for idx,coords,h in gray_components if h==cnt]
            if not cand:
                print('FAIL seed',i,'specs',specs,'row',row,'bg',bg2,'gray comps',[(i,h) for i,_,h in gray_components])
                print('legend',legend2,'grid',g.shape)
                raise SystemExit
            
print('no fail')
