from __future__ import annotations

from pathlib import Path
import random
import sys
from dataclasses import dataclass

import numpy as np
from scipy.ndimage import binary_fill_holes, label

UTILS_DIR = Path(__file__).resolve().parents[6] / \"new\" / \"solvers\"
if str(UTILS_DIR) not in sys.path:
    sys.path.append(str(UTILS_DIR))

from arc_utils import Color, bbox_coords, components_mask, get_bg, paste, random_free_location, STRUCT4


@dataclass(frozen=True)
class _RowSpec:
    color: int
    count: int
    has_points: bool


def _count_holes(mask: np.ndarray) -> int:
    \"\"\"Return number of 4-connected holes in a boolean object mask.\"\"\"
    if not bool(mask.any()):
        return 0
    filled = binary_fill_holes(mask)
    holes = filled & (~mask)
    _, n = label(holes, structure=STRUCT4)
    return int(n)


def _holes_from_coords(coords: np.ndarray) -> int:
    if coords.size == 0:
        return 0
    r0, c0, r1, c1 = bbox_coords(coords)
    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    patch[coords[:, 0] - r0, coords[:, 1] - c0] = True
    return _count_holes(patch)


def _find_legend_bbox(grid: np.ndarray, background: int, frame_color: int = Color.BLACK) -> tuple[int, int, int, int]:
    \"\"\"Find the black rectangular legend frame in the input.\"\"\"
    comps = []
    from arc_utils import find_components

    for comp in find_components(grid, bg=background, colors=[frame_color], connectivity=8, monochromatic=True):
        r0, c0, r1, c1 = map(int, comp[\"bbox\"])
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        if h < 3 or w < 3:
            continue

        coords = comp[\"coords\"]
        inner = (coords[:, 0] > r0) & (coords[:, 0] < r1) & (coords[:, 1] > c0) & (coords[:, 1] < c1)
        if bool(np.any(inner)):
            continue

        frame_patch = grid[r0 : r1 + 1, c0 : c1 + 1]
        if not (
            np.all(frame_patch[0, :] == frame_color)
            and np.all(frame_patch[-1, :] == frame_color)
            and np.all(frame_patch[:, 0] == frame_color)
            and np.all(frame_patch[:, -1] == frame_color)
        ):
            continue

        inner_patch = frame_patch[1:-1, 1:-1]
        if inner_patch.size == 0 or not np.any(inner_patch "'!= background):
            continue

        comps.append(comp)

    assert comps, "expected at least one black legend frame"
    comps.sort(key=lambda item: item["area"], reverse=True)
    bbox = tuple(map(int, comps[0]["bbox"]))
    return bbox


def _legend_rows(grid: np.ndarray, legend_bbox: tuple[int, int, int, int], background: int) -> list[tuple[int, int, int, int]]:
    """Parse legend rows: (row, key_col, key_color, point_count)."""
    r0, c0, r1, c1 = legend_bbox
    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
    rows = []

    for rr, row in enumerate(inner):
        nz = np.where(row != background)[0]
        if nz.size == 0:
            continue
        key_c = int(nz.min())
        key_color = int(row[key_c])
        if key_color == Color.BLACK:
            continue

        # Points are same key color to the right in that row.
        point_count = int(np.sum(row[key_c + 1 :] == key_color))
        rows.append((r0 + 1 + rr, c0 + 1 + key_c, key_color, point_count))

    assert rows, "expected at least one valid key row in the legend"
    return rows


def main(grid: np.ndarray) -> np.ndarray:
    """Use legend points and outer gray object holes as one conservation law.

    Input structure:
    - There is one black rectangular legend frame containing key rows on its left side.
    - Each key row has a key color pixel; some rows also contain right-side key-color dots.
    - Outside the frame, gray components may contain enclosed holes; key-color components may also.

    Rule:
    - Let the point count in a key row be n. If n > 0, find the gray component outside the frame
      with exactly n 4-connected holes and recolor that whole gray component to the key color.
    - Let the point count in a key row be 0. Count holes in the key color component outside the frame,
      then write that many key-color dots to the right of the key pixel at one-cell gaps.
    - Components without holes and non-legend regions outside the frame are preserved.

    Key insight:
    - Point count and hole count are a shared invariant; one can infer missing dots from holes and
      missing objects from dots, then complete both directions consistently.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    H, W = g.shape
    out = g.copy()

    background = get_bg(g)
    assert background != Color.BLACK, "generation assumption: background is not black frame color"

    legend = _find_legend_bbox(g, background=background, frame_color=Color.BLACK)
    r0, c0, r1, c1 = legend
    inside_rows = _legend_rows(g, legend, background)

    outside = np.ones_like(g, dtype=bool)
    outside[r0 : r1 + 1, c0 : c1 + 1] = False

    # Precompute gray components and their hole counts.
    gray_components = []
    for coords in components_mask((g == Color.GREY) & outside, connectivity=4):
        hole_count = _holes_from_coords(coords)
        gray_components.append((coords, hole_count))

    used_gray = set[int]()

    for row, key_c, key_color, point_count in inside_rows:
        if point_count > 0:
            match = [i for i, (_, n_holes) in enumerate(gray_components) if i not in used_gray and n_holes == point_count]
            assert match, "could not find gray object matching row point count"
            comp = gray_components[match[0]][0]
            out[comp[:, 0], comp[:, 1]] = key_color
            used_gray.add(match[0])
            continue

        key_masks = components_mask((g == key_color) & outside, connectivity=4)
        assert key_masks, "key-color object must exist for point-less rows"
        key_holes = [(_holes_from_coords(coords), idx) for idx, coords in enumerate(key_masks)]
        assert all(v == 1 for v, _ in key_holes), "expected exactly one key-color object for each zero-point row"

        for k, _ in key_holes:
            m = int(k)
            for t in range(m):
                cc = int(key_c + 2 * (t + 1))
                assert cc < c1, "legend does not have enough width for generated dots"
                out[row, cc] = key_color

    assert not np.array_equal(out, g), "main() should change at least one pixel"
    return out


def _make_holey_mask(height: int, width: int, hole_count: int) -> np.ndarray | None:
    """Create a filled block with exactly `hole_count` enclosed 4-connected holes."""
    if hole_count < 0:
        return None
    if hole_count == 0:
        return np.ones((height, width), dtype=bool)
    if height < 3 or width < 3:
        return None
    if hole_count > (height - 2) * (width - 2):
        return None

    interior = [(r, c) for r in range(1, height - 1) for c in range(1, width - 1)]
    for _ in range(300):
        if len(interior) < hole_count:
            break

        random.shuffle(interior)
        holes: list[tuple[int, int]] = []
        for cell in interior:
            if len(holes) >= hole_count:
                break
            r, c = cell
            if any(abs(r - hr) + abs(c - hc) == 1 for hr, hc in holes):
                continue
            holes.append((r, c))

        if len(holes) != hole_count:
            continue

        mask = np.ones((height, width), dtype=bool)
        for r, c in holes:
            mask[r, c] = False

        _, comp_cnt = label(mask, structure=STRUCT4)
        if comp_cnt != 1:
            continue
        if _count_holes(mask) != hole_count:
            continue

        return mask
    return None


def _place_patch(canvas: np.ndarray, patch: np.ndarray, background: int, forbidden: np.ndarray) -> tuple[int, int]:
    """Place `patch` onto `canvas` with padding, avoiding `forbidden` cells."""
    if patch.size == 0:
        raise ValueError("patch is empty")

    work = canvas.copy()
    block_color = 10 if background != 10 else 11
    work[forbidden] = block_color
    r, c = random_free_location(work, patch, transparent=background, padding=1, padding_connectivity=4)
    paste(canvas, patch, r, c, transparent=background)
    return r, c


def _gen_legend(specs: list[_RowSpec], max_count: int, background: int) -> tuple[np.ndarray, int, int, int, int]:
    """Create a clean legend patch and return it with absolute placement info."""
    if not specs:
        raise ValueError("legend requires at least one row")
    if max_count < 1:
        raise ValueError("legend max_count must be positive")

    # Legend with fixed left key column and one-cell spaced dots.
    inner_width = max(4, 2 * max_count + 2)
    inner_height = len(specs)
    legend = np.full((inner_height + 2, inner_width + 2), fill_value=background, dtype=int)

    legend[0, :] = Color.BLACK
    legend[-1, :] = Color.BLACK
    legend[:, 0] = Color.BLACK
    legend[:, -1] = Color.BLACK

    key_col = 1
    for idx, spec in enumerate(specs):
        r = 1 + idx
        legend[r, key_col] = int(spec.color)
        for t in range(spec.count):
            cc = key_col + 2 * (t + 1)
            if cc < legend.shape[1] - 1:
                legend[r, cc] = int(spec.color)

    # Random placement in caller.
    return legend, key_col, inner_width + 2, inner_height + 2, 0


def _gen_patch_for_spec(spec: _RowSpec) -> tuple[np.ndarray, int]:
    """Build object patch for a row spec."""
    hole_count = int(spec.count)
    color = int(spec.color)
    if spec.has_points:
        color = Color.GREY

    for _ in range(200):
        height = random.randint(4, 8)
        width = random.randint(4, 8)
        if hole_count > (height - 2) * (width - 2):
            continue

        mask = _make_holey_mask(height, width, hole_count)
        if mask is None:
            continue

        patch = np.full((height, width), fill_value=0, dtype=int)
        # Use background from caller later.
        patch[mask] = color
        return patch, color
    return None  # type: ignore[return-value]


def _generate_row_specs() -> list[_RowSpec]:
    """Generate row specs that force both incomplete-branch cases to appear."""
    n_rows = random.randint(2, 4)
    colors = random.sample([1, 2, 3, 4, 6, 7, 8, 9], k=n_rows)

    if n_rows == 2:
        branches = [True, False]
    else:
        branches = [True, False]
        for _ in range(n_rows - 2):
            branches.append(random.choice([True, False]))
        random.shuffle(branches)

    point_indices = [i for i, b in enumerate(branches) if b]
    obj_indices = [i for i, b in enumerate(branches) if not b]

    max_points = random.randint(1, 4)
    point_counts = random.sample(range(1, max_points + 1), k=max(1, len(point_indices)))

    specs: list[_RowSpec] = []
    point_iter = iter(point_counts)

    for idx in range(n_rows):
        if idx in point_indices:
            count = int(next(point_iter))
            specs.append(_RowSpec(color=colors[idx], count=count, has_points=True))
        else:
            count = random.randint(1, 4)
            specs.append(_RowSpec(color=colors[idx], count=count, has_points=False))

    return specs

def _is_valid_generated(grid: np.ndarray, specs: list[_RowSpec]) -> bool:
    try:
        out = main(grid)
    except Exception:
        return False

    # Require a real rule application: input and output differ.
    if np.array_equal(grid, out):
        return False

    # Sanity: every row must show correct color in legend key column.
    bg = get_bg(grid)
    legend = _find_legend_bbox(grid, background=bg, frame_color=Color.BLACK)
    rows = _legend_rows(grid, legend, bg)
    if len(rows) != len(specs):
        return False

    return True


def generate_input() -> np.ndarray:
    """Generate diverse valid inputs for this task."""
    for _ in range(400):
        n_rows = random.randint(2, 4)
        bg_choices = [1, 2, 3, 4, 6, 7, 8, 9]
        bg = random.choice([c for c in bg_choices if c != Color.GREY])

        specs = _generate_row_specs()
