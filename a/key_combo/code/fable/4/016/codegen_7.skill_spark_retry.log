            if h != w:
                pairs.append((w, h))
    # Prefer close-to-square, then smaller height.
    pairs.sort(key=lambda t: (abs(t[0] - t[1]), t[0], t[1]))
    return pairs


def _placeable(board: np.ndarray, placement: list[tuple[int, int, int]]) -> bool:
    for r, c, _ in placement:
        if board[r, c] != -1:
