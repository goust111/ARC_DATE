def _gen_mask_options(h: int, w: int, count: int) -> list[np.ndarray]:
    out = []
    cells = [(r, c) for r in range(h) for c in range(w)]
    for combo in itertools.combinations(cells, count):
        rows = {r for r, _ in combo}
        cols = {c for _, c in combo}
