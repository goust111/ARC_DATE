+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+PALETTE = tuple(range(10))
+NONZERO_COLORS = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+COMPONENT_RETRIES = 120
+PLACEMENT_RETRIES = 160
