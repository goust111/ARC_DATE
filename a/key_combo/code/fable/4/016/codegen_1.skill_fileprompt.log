+    br0, bc0, br1, bc1 = b
+    return not (ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0)
+
+
+def try_place_box(box_h: int, box_w: int, zone: tuple[int, int, int, int], used: list[tuple[int, int, int, int]], pad: int = 1):
