+        sprite_coords = sprite["coords"]
+        sprite_mask_on_grid[sprite_coords[:, 0], sprite_coords[:, 1]] = True
+        assert np.array_equal(hole_cells, sprite_mask_on_grid), "translated hole must cover the matched sprite exactly"
