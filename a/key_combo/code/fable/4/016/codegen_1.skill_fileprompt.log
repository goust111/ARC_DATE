+def enclosed_holes(mask: np.ndarray) -> list[np.ndarray]:
+    H, W = mask.shape
+    bg = ~mask
+    seen = np.zeros((H, W), dtype=bool)
+    holes = []
+    for r in range(H):
+        for c in range(W):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr == 0 or rr == H - 1 or cc == 0 or cc == W - 1:
+                    touches_edge = True
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if touches_edge:
+                continue
+            hole = np.zeros_like(mask, dtype=bool)
+            for rr, cc in coords:
+                hole[rr, cc] = True
+            holes.append(hole)
