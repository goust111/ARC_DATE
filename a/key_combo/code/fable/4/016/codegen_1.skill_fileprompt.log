+def trim_mask(mask: np.ndarray) -> np.ndarray:
+    box = mask_bbox(mask)
+    assert box is not None, "mask must contain at least one cell"
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
