+        place_c1 = place_c0 + rotated_mask.shape[1] - 1
+        H, W = g.shape
+        assert 0 <= place_r0 <= place_r1 < H and 0 <= place_c0 <= place_c1 < W, "moved object exceeds grid bounds"
