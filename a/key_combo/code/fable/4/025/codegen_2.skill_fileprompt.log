+                    "center": center,
+                    "missing_dir": missing_dir,
+                    "slot": _add(center, missing_dir),
+                }
+            )
+    assert pluses, "expected at least one incomplete plus"
+    return pluses
+
+
+def _find_grey_components(grid: np.ndarray) -> list[list[Coord]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != MIRROR:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        nr, nc = rr + dr, cc + dc
+                        if not (0 <= nr < h and 0 <= nc < w):
+                            continue
+                        if seen[nr, nc] or int(grid[nr, nc]) != MIRROR:
+                            continue
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _build_turn_map(grid: np.ndarray) -> dict[Coord, dict[Coord, Coord]]:
+    turn_map: dict[Coord, dict[Coord, Coord]] = {}
