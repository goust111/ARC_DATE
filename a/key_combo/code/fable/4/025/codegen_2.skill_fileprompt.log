from collections import Counter, defaultdict

import numpy as np
import random


def _runs(active: list[bool]) -> list[tuple[int, int]]:
    runs: list[tuple[int, int]] = []
    start = None
    for i, value in enumerate(active):
        if value and start is None:
            start = i
        elif not value and start is not None:
            runs.append((start, i))
            start = None
    if start is not None:
        runs.append((start, len(active)))
    return runs


def _unique_dominant(values: list[int]) -> int:
    counts = Counter(values)
    ranked = counts.most_common()
    assert ranked, "expected at least one interior structural value"
    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique interior fill color"
    return int(ranked[0][0])


def _lattice_runs(g: np.ndarray, separator: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
    height, width = g.shape
    assert np.all(g[0, :] == separator) and np.all(g[-1, :] == separator), "expected separator rows on the boundary"
    assert np.all(g[:, 0] == separator) and np.all(g[:, -1] == separator), "expected separator columns on the boundary"

    row_runs = _runs([not np.all(g[r, :] == separator) for r in range(height)])
    col_runs = _runs([not np.all(g[:, c] == separator) for c in range(width)])
    assert row_runs and col_runs, "expected a nonempty tile lattice"
    assert all(end - start == 4 for start, end in row_runs), "expected 4-cell-high tile rows"
    assert all(end - start == 4 for start, end in col_runs), "expected 4-cell-wide tile columns"
    return row_runs, col_runs


def _structural_colors(
    g: np.ndarray,
    row_runs: list[tuple[int, int]],
    col_runs: list[tuple[int, int]],
) -> tuple[int, int]:
    border_values: set[int] = set()
    interior_values: list[int] = []
    for r0, r1 in row_runs:
        for c0, c1 in col_runs:
            tile = g[r0:r1, c0:c1]
            assert tile.shape == (4, 4), "expected 4x4 tiles"
            border = np.concatenate([tile[0, :], tile[3, :], tile[1:3, 0], tile[1:3, 3]])
            border_values.update(map(int, border))
            interior_values.extend(map(int, tile[1:3, 1:3].reshape(-1)))

    assert len(border_values) == 1, "expected one repeated frame color"
    frame = next(iter(border_values))
    fill = _unique_dominant([value for value in interior_values if value != frame])
    assert fill != frame, "frame and fill colors must be distinct"
    return int(frame), int(fill)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete same-color marker segments inside a regular lattice of framed tiles.

    Input structure
    - The grid is partitioned by separator rows and columns into 4x4 framed tiles.
    - All tile borders have one frame color, and each 2x2 tile interior has a dominant fill color.
    - Other interior colors are endpoint markers, with their exact 2x2 subcell position preserved.

    Rule
    - Group endpoint markers by marker color and by their relative interior subcell.
    - When two or more endpoints in a group share a tile row, fill every intervening tile at that same subcell with the marker color.
    - When two or more endpoints in a group share a tile column, fill every intervening tile at that same subcell with the marker color.

    Key insight
    - The colored endpoints are not connected in pixel space; they are connected on the coarser tile lattice, and the chosen interior subcell identifies which lane to paint.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    separator = int(g[0, 0])
    row_runs, col_runs = _lattice_runs(g, separator)
    frame, fill = _structural_colors(g, row_runs, col_runs)
    structural = {separator, frame, fill}

    groups: dict[tuple[int, int, int], list[tuple[int, int]]] = defaultdict(list)
    for tile_r, (r0, _) in enumerate(row_runs):
        for tile_c, (c0, _) in enumerate(col_runs):
            for dr in (1, 2):
                for dc in (1, 2):
                    color = int(g[r0 + dr, c0 + dc])
                    if color not in structural:
                        groups[(color, dr, dc)].append((tile_r, tile_c))
    assert groups, "expected at least one marker group"

    out = g.copy()
    for (color, dr, dc), points in groups.items():
        assert len(points) >= 2, "expected every marker group to define at least one segment"
        covered: set[tuple[int, int]] = set()
        by_row: dict[int, list[int]] = defaultdict(list)
        by_col: dict[int, list[int]] = defaultdict(list)
        for tile_r, tile_c in points:
            by_row[tile_r].append(tile_c)
            by_col[tile_c].append(tile_r)

        for tile_r, tile_cols in by_row.items():
            if len(tile_cols) < 2:
                continue
            for tile_c in range(min(tile_cols), max(tile_cols) + 1):
                r = row_runs[tile_r][0] + dr
                c = col_runs[tile_c][0] + dc
                assert int(out[r, c]) in structural or int(out[r, c]) == color, "conflicting marker segment"
                out[r, c] = color
                covered.add((tile_r, tile_c))

        for tile_c, tile_rows in by_col.items():
            if len(tile_rows) < 2:
                continue
            for tile_r in range(min(tile_rows), max(tile_rows) + 1):
                r = row_runs[tile_r][0] + dr
                c = col_runs[tile_c][0] + dc
                assert int(out[r, c]) in structural or int(out[r, c]) == color, "conflicting marker segment"
                out[r, c] = color
                covered.add((tile_r, tile_c))

        assert set(points) <= covered, "expected every marker endpoint to lie on a completed segment"

    return out

# --------------- generator (o5x) ---------------

# Tile lattice geometry.
TILE_COUNT_RANGE = (3, 5)
TILE_STRIDE, TILE_OFFSET, TILE_SIZE, INTERIOR_SIZE = 5, 1, 4, 2

# Marker group and segment bounds.
GROUP_COUNT_RANGE = (2, 4)
SEGMENT_LENGTH_MIN = 3
MAX_GENERATION_ATTEMPTS = 300

# Color and base interior sampling.
NONZERO_COLORS = list(range(1, 10))
OPTIONAL_FRAME_SUBCELL_CHOICES = 2
INTERIOR_LANES_0 = tuple((dr, dc) for dr in range(INTERIOR_SIZE) for dc in range(INTERIOR_SIZE))


def _gen_base_grid(tile_rows, tile_cols, frame, interior):
    """Render the structural lattice before marker segments are painted."""
    grid = np.zeros((TILE_STRIDE * tile_rows + TILE_OFFSET, TILE_STRIDE * tile_cols + TILE_OFFSET), dtype=int)
    for tile_r in range(tile_rows):
        for tile_c in range(tile_cols):
            r0, c0 = _gen_tile_origin(tile_r, tile_c)
            grid[r0 : r0 + TILE_SIZE, c0 : c0 + TILE_SIZE] = frame
            grid[r0 + TILE_OFFSET : r0 + TILE_OFFSET + INTERIOR_SIZE, c0 + TILE_OFFSET : c0 + TILE_OFFSET + INTERIOR_SIZE] = interior
    return grid


def _gen_tile_origin(tile_r, tile_c):
    return TILE_OFFSET + TILE_STRIDE * tile_r, TILE_OFFSET + TILE_STRIDE * tile_c


def _gen_pixel(tile_r, tile_c, dr, dc):
    r0, c0 = _gen_tile_origin(tile_r, tile_c)
    return r0 + dr, c0 + dc


def _gen_candidate(endpoint_count, segment_class, cells, endpoints):
    return {"endpoint_count": endpoint_count, "class": segment_class, "cells": cells, "endpoints": endpoints}


def _gen_axis_ends(center, length, limit):
    ends = []
    if center - length + 1 >= 0:
        ends.append(center - length + 1)
    if center + length - 1 < limit:
        ends.append(center + length - 1)
    return ends


def _gen_segment_candidates(tile_rows, tile_cols, eligible_lanes):
    """Build all non-conflicting segment shapes available before occupancy filtering."""
    candidates = []
    for dr, dc in eligible_lanes:
        for tile_r in range(tile_rows):
            for length in range(SEGMENT_LENGTH_MIN, tile_cols + 1):
                for start_c in range(tile_cols - length + 1):
                    end_c = start_c + length - 1
                    cells = tuple((tile_r, tile_c, dr, dc) for tile_c in range(start_c, end_c + 1))
                    endpoints = ((tile_r, start_c, dr, dc), (tile_r, end_c, dr, dc))
                    candidates.append(_gen_candidate(2, ("H", length), cells, endpoints))

        for tile_c in range(tile_cols):
            for length in range(SEGMENT_LENGTH_MIN, tile_rows + 1):
                for start_r in range(tile_rows - length + 1):
                    end_r = start_r + length - 1
                    cells = tuple((tile_r, tile_c, dr, dc) for tile_r in range(start_r, end_r + 1))
                    endpoints = ((start_r, tile_c, dr, dc), (end_r, tile_c, dr, dc))
                    candidates.append(_gen_candidate(2, ("V", length), cells, endpoints))

        for corner_r in range(tile_rows):
            for corner_c in range(tile_cols):
                for h_len in range(SEGMENT_LENGTH_MIN, tile_cols + 1):
                    h_ends = _gen_axis_ends(corner_c, h_len, tile_cols)
                    for v_len in range(SEGMENT_LENGTH_MIN, tile_rows + 1):
                        v_ends = _gen_axis_ends(corner_r, v_len, tile_rows)
                        for end_c in h_ends:
                            for end_r in v_ends:
                                c0, c1 = sorted((corner_c, end_c))
                                r0, r1 = sorted((corner_r, end_r))
                                cells = {(corner_r, tile_c, dr, dc) for tile_c in range(c0, c1 + 1)}
                                cells.update((tile_r, corner_c, dr, dc) for tile_r in range(r0, r1 + 1))
                                endpoints = (
                                    (corner_r, corner_c, dr, dc),
                                    (corner_r, end_c, dr, dc),
                                    (end_r, corner_c, dr, dc),
                                )
                                candidates.append(_gen_candidate(3, ("L", h_len, v_len), tuple(sorted(cells)), endpoints))
    return candidates


def _gen_pick_candidate(candidates, occupied):
    """Sample one currently unoccupied segment with the original class-balanced policy."""
    valid = [cand for cand in candidates if not any(cell in occupied for cell in cand["cells"])]
    if not valid:
        return None

    endpoint_counts = sorted({cand["endpoint_count"] for cand in valid})
    endpoint_count = random.choice(endpoint_counts)
    same_count = [cand for cand in valid if cand["endpoint_count"] == endpoint_count]

    by_class = {}
    for cand in same_count:
        by_class.setdefault(cand["class"], []).append(cand)
    segment_class = random.choice(list(by_class))
    return random.choice(by_class[segment_class])


def _gen_setup():
    """Sample dimensions, colors, base interior pattern, and marker-eligible lanes."""
    tile_rows = random.randint(*TILE_COUNT_RANGE)
    tile_cols = random.randint(*TILE_COUNT_RANGE)
    group_count = random.randint(*GROUP_COUNT_RANGE)

    colors = list(NONZERO_COLORS)
    random.shuffle(colors)
    frame = colors.pop()
    fill = colors.pop()
    marker_colors = [colors.pop() for _ in range(group_count)]

    interior = np.full((INTERIOR_SIZE, INTERIOR_SIZE), fill, dtype=int)
    if random.randrange(OPTIONAL_FRAME_SUBCELL_CHOICES):
        interior[random.randrange(INTERIOR_SIZE), random.randrange(INTERIOR_SIZE)] = frame
    eligible_lanes = [
        (dr + TILE_OFFSET, dc + TILE_OFFSET)
        for dr, dc in INTERIOR_LANES_0
        if int(interior[dr, dc]) == fill
    ]
    return tile_rows, tile_cols, frame, interior, marker_colors, eligible_lanes


def _gen_pick_groups(marker_colors, candidates):
    """Assign each marker color to a segment while preventing cell overlap."""
    occupied = set()
    groups = []
    for color in marker_colors:
        cand = _gen_pick_candidate(candidates, occupied)
        if cand is None:
            return None
        groups.append((color, cand))
        occupied.update(cand["cells"])
    return groups


def _gen_render_output(tile_rows, tile_cols, frame, interior, groups):
    out = _gen_base_grid(tile_rows, tile_cols, frame, interior)
    for color, cand in groups:
        for tile_r, tile_c, dr, dc in cand["cells"]:
            r, c = _gen_pixel(tile_r, tile_c, dr, dc)
            out[r, c] = color
    return out


def _gen_make_input(out, interior, groups):
    """Erase non-endpoint marker cells from the completed output grid."""
    inp = out.copy()
    for _color, cand in groups:
        endpoints = set(cand["endpoints"])
        for tile_r, tile_c, dr, dc in cand["cells"]:
            if (tile_r, tile_c, dr, dc) not in endpoints:
                r, c = _gen_pixel(tile_r, tile_c, dr, dc)
                inp[r, c] = int(interior[dr - TILE_OFFSET, dc - TILE_OFFSET])
    return inp


def _gen_attempt():
    tile_rows, tile_cols, frame, interior, marker_colors, eligible_lanes = _gen_setup()
    candidates = _gen_segment_candidates(tile_rows, tile_cols, eligible_lanes)
    groups = _gen_pick_groups(marker_colors, candidates)
    if groups is None:
        return None

    out = _gen_render_output(tile_rows, tile_cols, frame, interior, groups)
    inp = _gen_make_input(out, interior, groups)
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid a096bf4d input")
def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
    """
    A grey endpoint (er,ec) is a port for this sprite if:
      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
    """
    cr, cc = sprite["center_pos"]
    b = int(sprite["border"])
    ports: list[tuple[int, int]] = []
    for ir, ic in neighbors4(cr, cc):
        dr, dc = ir - cr, ic - cc
        er, ec = cr + 2 * dr, cc + 2 * dc
        if (er, ec) not in eps:
            continue
        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
            ports.append((er, ec))
    return ports


def main(grid: np.ndarray) -> np.ndarray:
    """
    Transfer center colors between bordered sprites matched by color, keeping only path-connected ones.

    Input structure:
    - bg, grey (5) path network, and several small "bordered sprites" each having a border color and a single center pixel of a different color.
    - Grey path forms a one-stroke trail under 8-connectivity; its start/end cells touch exactly two destination sprites via ports.

    Rule:
    - Destination sprites are determined by the grey trail's two endpoints.
    - For each destination, find the source sprite whose border color equals the destination's center color.
    - Replace the destination's center pixel with the source's center color.
    - Delete all non-destination sprites; grey paths and destinations remain.

    Key insight: Center color of each destination acts as a lookup key into the border colors of other sprites, enabling indirect color transfer.
    """
    g = np.asarray(grid, dtype=int)
    bg = _bg_boundary(g)
    grey = 5

    sprites = _detect_bordered_sprites(g, bg, grey)
    assert sprites, "expected at least one bordered sprite in the grid"

    # Trail endpoints determine the 2 destination sprites (no color tiebreaking).
    te1, te2 = _find_trail_endpoints(g, grey, sprites)
    trail_eps = {te1, te2}

    eps_pair = [te1, te2]
    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)]
            for ep in eps_pair}

    # Bipartite match: fewer-options-first; tiebreak by sprite farthest from OTHER endpoint
    dest: list[dict] = [None, None]  # type: ignore[list-item]
    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
    used: set[int] = set()
    for i in order:
        ep = eps_pair[i]
        other = eps_pair[1 - i]
        cands = [sp for sp in opts[ep] if id(sp) not in used]
        best = max(cands, key=lambda sp: abs(sp["center_pos"][0] - other[0])
                   + abs(sp["center_pos"][1] - other[1]))
        dest[i] = best
        used.add(id(best))
    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
    dest_ids = {id(sp) for sp in dest}

    # Build border->sprites lookup (using original input attributes).
    by_border: dict[int, list[dict]] = {}
    for sp in sprites:
        by_border.setdefault(int(sp["border"]), []).append(sp)

    out = g.copy()

    # Delete all non-destination sprites completely.
    for sp in sprites:
        if id(sp) in dest_ids:
            continue
        for r, c in sp["pts"]:
            out[r, c] = bg

    # Also delete any remaining non-grey, non-bg pixels not connected to a destination sprite.
    # (Some instances contain extra non-sprite components that are removed in the output.)
    keep = np.zeros(out.shape, dtype=bool)
    q: list[tuple[int, int]] = []
    for d in dest:
        for r, c in d["pts"]:
            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
                keep[r, c] = True
                q.append((r, c))
    while q:
        r, c = q.pop()
        for nr, nc in neighbors4(r, c):
            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
                if keep[nr, nc]:
                    continue
                if out[nr, nc] == bg or out[nr, nc] == grey:
                    continue
                keep[nr, nc] = True
                q.append((nr, nc))
    drop = (out != bg) & (out != grey) & (~keep)
    out[drop] = bg

    # Update destination centers by matching their original center color to a source sprite border.
    for d in dest:
        want_border = int(d["center"])
        srcs = by_border.get(want_border, [])
        if not srcs:
            continue
        assert len(srcs) == 1, "each destination color should match at most one source border"
        src = srcs[0]
        dr, dc = d["center_pos"]
        out[dr, dc] = int(src["center"])

    return out

# --------------- generator (c) ---------------

from arc_utils import paste

# ── CFG: tunable generation parameters ──────────────────────────────
GRID_H, GRID_W = 10, 10                    # canvas size
BG, GREY = 0, 5                            # background and path colors
SPRITE_COUNTS = [4, 5]                      # number of sprites per example
SOURCE_COUNTS = [1, 2]                      # possible number of source sprites
INTERIOR_DEST_WEIGHTS = [3, 1]              # weights for [0, 1] interior dests
PATH_LEN_MIN, PATH_LEN_MAX = 10, 24        # grey trail length bounds
MIN_PORT_DIST_FRAC = 3                      # min_port_dist = max(3, target_len // this)
MAX_THICKNESS = 3                           # max 8-neighbor degree for path cells
PATH_WANDER_AWAY_P = 0.5                    # P(choose away-moves) when budget is large
PATH_WANDER_DIAG_P = 0.6                    # P(prefer diagonal) in wander/moderate phases
PATH_MODERATE_RANDOM_P = 0.3               # P(random move) in moderate-budget phase
GEN_RETRIES = 300                           # outer retry limit


def _make_sprite_patch(shape_type, border_color, center_color):
    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
    if shape_type == 'box':
        p = np.full((3, 3), border_color, dtype=int)
    else:  # plus
        p = np.zeros((3, 3), dtype=int)
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            p[1 + dr, 1 + dc] = border_color
    p[1, 1] = center_color
    return p


def _place_sprite(grid, patch, r0, c0):
    """Place patch cells on grid, skipping transparent (0) and out-of-bounds."""
    paste(grid, patch, r0, c0, transparent=BG, clip=True)


def _erase_sprite(grid, patch, r0, c0):
    """Undo a _place_sprite by zeroing non-transparent patch cells."""
    H, W = grid.shape
    for dr in range(3):
        for dc in range(3):
            rr, cc = r0 + dr, c0 + dc
            if 0 <= rr < H and 0 <= cc < W and patch[dr, dc] != 0:
                grid[rr, cc] = BG


def _overlaps(grid, patch, r0, c0):
    """Check if placing patch at (r0,c0) would overlap or 4-touch non-bg, non-grey cells."""
    H, W = grid.shape
    patch_cells = set()
    for dr in range(3):
        for dc in range(3):
            if patch[dr, dc] != 0:
                rr, cc = r0 + dr, c0 + dc
                if 0 <= rr < H and 0 <= cc < W:
                    if grid[rr, cc] != 0:
                        return True
                    patch_cells.add((rr, cc))
    for rr, cc in patch_cells:
        for nr, nc in [(rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)]:
            if (nr, nc) not in patch_cells and 0 <= nr < H and 0 <= nc < W:
                if int(grid[nr, nc]) not in (BG, GREY):
                    return True
    return False


def _sprite_positions():
    """All valid (r0,c0) for a 3x3 patch where center stays on grid."""
    return [(r0, c0) for r0 in range(-1, GRID_H) for c0 in range(-1, GRID_W)
            if 0 <= r0 + 1 < GRID_H and 0 <= c0 + 1 < GRID_W]


def _is_edge(r0, c0):
    return r0 <= 0 or r0 + 3 >= GRID_H or c0 <= 0 or c0 + 3 >= GRID_W


def _too_thick(r, c, occupied):
    """Check if adding (r,c) would push any cell's 8-degree above MAX_THICKNESS."""
    nbs = [(r + dr, c + dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)
           if (dr or dc) and (r + dr, c + dc) in occupied]
    if len(nbs) > MAX_THICKNESS:
        return True
    for nr, nc in nbs:
        deg = sum(1 for dr in (-1, 0, 1) for dc in (-1, 0, 1)
                  if (dr or dc) and (nr + dr, nc + dc) in occupied)
        if deg + 1 > MAX_THICKNESS:
            return True
    return False


def _gen_winding_path(grid, start, end, target_len):
    """Generate a winding 8-connected grey path with no 2x2 blocks."""
    path = [start]
    visited = {start}
    cr, cc = start

    def score(m):
        return abs(m[0] - end[0]) + abs(m[1] - end[1])

    for _ in range(target_len + 20):
        if max(abs(cr - end[0]), abs(cc - end[1])) <= 1:
            break

        moves = []
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nr, nc = cr + dr, cc + dc
                if (0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in visited
                        and grid[nr, nc] == 0 and not _too_thick(nr, nc, visited)):
                    moves.append((nr, nc, dr != 0 and dc != 0))

        if not moves:
            return None

        dist = abs(cr - end[0]) + abs(cc - end[1])
        budget = target_len - len(path)
        diag = [m for m in moves if m[2]]
        away = [m for m in moves if score(m) > dist]

        if budget > dist + 4:
            # Plenty of budget: strongly prefer wandering away or sideways
            if away and random.random() < PATH_WANDER_AWAY_P:
                pool = away
            elif diag and random.random() < PATH_WANDER_DIAG_P:
                pool = diag
            else:
                pool = moves
            chosen = random.choice(pool)
        elif budget > dist + 1:
            # Some budget: mix of diagonal and toward-target
            pool = diag if diag and random.random() < PATH_WANDER_DIAG_P else moves
            if random.random() < PATH_MODERATE_RANDOM_P:
                chosen = random.choice(pool)
            else:
                chosen = min(pool, key=score)
        else:
            # Tight: head toward target, prefer diagonal
            best = sorted(moves, key=score)
            top = [m for m in best if score(m) <= score(best[0]) + 1]
            dtop = [m for m in top if m[2]]
            chosen = random.choice(dtop) if dtop else best[0]

        cr, cc = chosen[0], chosen[1]
        path.append((cr, cc))
        visited.add((cr, cc))

    if end not in visited:
        if not _too_thick(end[0], end[1], visited):
            path.append(end)
        else:
            return None

    return path


def _is_8_connected(cells):
    """Check 8-connectivity of a set of cells via BFS."""
    if len(cells) <= 1:
        return True
    cell_set = set(cells)
    start = next(iter(cell_set))
    visited = {start}
    queue = deque([start])
    while queue:
        r, c = queue.popleft()
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nb = (r + dr, c + dc)
                if nb in cell_set and nb not in visited:
                    visited.add(nb)
                    queue.append(nb)
    return len(visited) == len(cell_set)


def _find_port_dir(grid, cr, cc, bc):
    """Find a valid port direction for a sprite centered at (cr,cc) with border color bc."""
    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    random.shuffle(dirs)
    for dr, dc in dirs:
        ir, ic = cr + dr, cc + dc
        er, ec = cr + 2 * dr, cc + 2 * dc
        if not (0 <= ir < GRID_H and 0 <= ic < GRID_W
                and 0 <= er < GRID_H and 0 <= ec < GRID_W):
            continue
        if grid[ir, ic] == bc and grid[er, ec] == 0:
            return (er, ec)
    return None


def _assign_colors(border_colors, num_sprites):
    """Assign roles (dest/source/distractor) and pick center colors for all sprites."""
    remaining = list(range(2, num_sprites))
    num_sources = random.choice(SOURCE_COUNTS) if len(remaining) >= 2 else max(1, len(remaining))
    if num_sources == 0:
        return None
    source_indices = remaining[:num_sources]
    distractor_indices = remaining[num_sources:]

    # Dest center colors = source border colors (lookup key)
    if num_sources == 1:
        dest_center_colors = [border_colors[source_indices[0]]] * 2
    else:
        dest_center_colors = [border_colors[si] for si in source_indices]

    # Source center colors: must avoid bg, grey, own border, and matched dest's border
    source_center_colors = []
    for j, si in enumerate(source_indices):
        forbidden = {BG, GREY, border_colors[si]}
        if num_sources == 1:
            forbidden.update([border_colors[0], border_colors[1]])
        else:
            forbidden.add(border_colors[j])
        candidates = [c for c in range(1, 10) if c not in forbidden]
        if not candidates:
            return None
        source_center_colors.append(random.choice(candidates))

    distractor_center_colors = [
        random.choice([c for c in range(1, 10) if c != GREY and c != border_colors[di]])
        for di in distractor_indices
    ]

    output_dest_centers = (source_center_colors * 2)[:2] if num_sources == 1 else source_center_colors

    return dict(
        source_indices=source_indices, distractor_indices=distractor_indices,
        dest_center_colors=dest_center_colors, source_center_colors=source_center_colors,
        distractor_center_colors=distractor_center_colors, output_dest_centers=output_dest_centers,
    )


def _place_dests(output_grid, shape_type, border_colors, output_dest_centers, min_port_dist):
    """Place 2 destination sprites on the grid. Returns (center_positions, first_port) or None."""
    all_pos = _sprite_positions()
    edge_pos = [p for p in all_pos if _is_edge(p[0], p[1])]
    int_pos = [p for p in all_pos if not _is_edge(p[0], p[1])]
    num_interior_dest = random.choices([0, 1], weights=INTERIOR_DEST_WEIGHTS)[0]

    dest_center_positions = []
    first_port = None

    for i in range(2):
        bc = border_colors[i]
        patch = _make_sprite_patch(shape_type, bc, output_dest_centers[i])
        pool = list(int_pos if i < num_interior_dest else edge_pos)
        random.shuffle(pool)

        placed = False
        for r0, c0 in pool:
            if _overlaps(output_grid, patch, r0, c0):
                continue
            cr, cc_pos = r0 + 1, c0 + 1

            # Temporarily place to check port availability
            _place_sprite(output_grid, patch, r0, c0)
            port = _find_port_dir(output_grid, cr, cc_pos, bc)
            if port is None:
                _erase_sprite(output_grid, patch, r0, c0)
                continue

            # Second dest must be far enough from first port
            if i == 1:
                dist = abs(port[0] - first_port[0]) + abs(port[1] - first_port[1])
                if dist < min_port_dist:
                    _erase_sprite(output_grid, patch, r0, c0)
                    continue

            dest_center_positions.append((cr, cc_pos))
            if i == 0:
                first_port = port
            placed = True
            break

        if not placed:
            return None

    return dest_center_positions


def _gen_attempt():
    shape_type = random.choice(['box', 'plus'])
    palette = [c for c in range(1, 10) if c != GREY]
    num_sprites = random.choice(SPRITE_COUNTS)
    border_colors = random.sample(palette, num_sprites)

    colors = _assign_colors(border_colors, num_sprites)
    if colors is None:
        return None

    target_len = random.randint(PATH_LEN_MIN, PATH_LEN_MAX)
    min_port_dist = max(3, target_len // MIN_PORT_DIST_FRAC)

    output_grid = np.zeros((GRID_H, GRID_W), dtype=int)
    result = _place_dests(output_grid, shape_type, border_colors,
                          colors['output_dest_centers'], min_port_dist)
    if result is None:
        return None
    dest_center_positions = result

    # Find port cells for grey path endpoints
    port_cells = []
    for i in range(2):
        cr, cc_pos = dest_center_positions[i]
        port = _find_port_dir(output_grid, cr, cc_pos, border_colors[i])
        if port is None:
            return None
        port_cells.append(port)

    # Generate grey path
    path_cells = _gen_winding_path(output_grid, port_cells[0], port_cells[1], target_len)
    if path_cells is None or not (PATH_LEN_MIN <= len(path_cells) <= PATH_LEN_MAX):
        return None
    if not _is_8_connected(path_cells):
        return None

    for r, c in path_cells:
        if output_grid[r, c] != BG:
            return None
        output_grid[r, c] = GREY

    # Verify port cells are trail endpoints (4-degree <= 1 within grey)
    for pr, pc in port_cells:
        deg = sum(1 for nr, nc in [(pr - 1, pc), (pr + 1, pc), (pr, pc - 1), (pr, pc + 1)]
                  if 0 <= nr < GRID_H and 0 <= nc < GRID_W and output_grid[nr, nc] == GREY)
        if deg > 1:
            return None

    # Derive input from output: restore original dest center colors
    input_grid = output_grid.copy()
    for i in range(2):
        cr, cc_pos = dest_center_positions[i]
        input_grid[cr, cc_pos] = colors['dest_center_colors'][i]

    # Place source and distractor sprites on input grid
    sprites_to_place = (
        [(border_colors[si], colors['source_center_colors'][j])
         for j, si in enumerate(colors['source_indices'])] +
        [(border_colors[di], colors['distractor_center_colors'][j])
         for j, di in enumerate(colors['distractor_indices'])]
    )
    all_pos = _sprite_positions()
    for bc, cc_color in sprites_to_place:
        patch = _make_sprite_patch(shape_type, bc, cc_color)
        pool = list(all_pos)
        random.shuffle(pool)
        placed = False
        for r0, c0 in pool:
            if not _overlaps(input_grid, patch, r0, c0):
                _place_sprite(input_grid, patch, r0, c0)
                placed = True
                break
        if not placed:
            return None

    # Oracle check
    try:
        out = main(input_grid)
        if np.array_equal(out, output_grid):
            return input_grid
    except Exception:
        pass
    return None


def generate_input():
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {GEN_RETRIES} attempts")

