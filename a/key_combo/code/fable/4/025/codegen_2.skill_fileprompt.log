+def _add(cell: Coord, direction: Coord, steps: int = 1) -> Coord:
+    return cell[0] + direction[0] * steps, cell[1] + direction[1] * steps
+
+
+def _in_bounds(shape: tuple[int, int], cell: Coord) -> bool:
+    r, c = cell
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
