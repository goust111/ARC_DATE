+def _module_bbox_size(module: np.ndarray) -> tuple[int, int]:
+    coords = np.argwhere(module != BG)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
