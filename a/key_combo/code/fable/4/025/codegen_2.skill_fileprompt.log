+        pts = sorted(comp)
+        assert len(pts) == 2, "each mirror must be a 2-pixel component"
+        (r0, c0), (r1, c1) = pts
+        assert abs(r1 - r0) == 1 and abs(c1 - c0) == 1, "mirror pixels must be diagonally adjacent"
