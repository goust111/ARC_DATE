+def _paint_plus(grid: np.ndarray, center: Coord, color: int, missing_dir: Coord) -> None:
+    r, c = center
+    grid[r, c] = color
+    for direction in DIR4:
+        if direction == missing_dir:
+            continue
+        rr, cc = _add(center, direction)
+        grid[rr, cc] = color
