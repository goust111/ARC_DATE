+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    rows, cols = np.where(mask)
+    assert rows.size > 0, "expected a non-empty object"
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
