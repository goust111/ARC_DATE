+
+def _analyze_object(grid: np.ndarray, color: int) -> ObjectInfo:
+    mask = (grid == int(color))
+    r0, c0, r1, c1 = _bbox(mask)
+    crop_mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+    height, width = crop_mask.shape
