+    if empty_rows:
+        seam = int(empty_rows[0])
+        top = crop_mask[:seam, :]
+        bottom = crop_mask[seam + 1 :, :]
+        assert top.shape == bottom.shape, "expected a balanced horizontal seam"
+        symmetric = bool(np.array_equal(top, bottom[::-1, :]))
