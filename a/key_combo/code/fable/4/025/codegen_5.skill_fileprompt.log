    raise RuntimeError("failed to sample a connected asymmetric half")


def _build_horizontal_object(
    rng: np.random.Generator,
    color: int,
    donor_color: int | None,
    *,
    symmetric: bool,
) -> tuple[np.ndarray, np.ndarray]:
