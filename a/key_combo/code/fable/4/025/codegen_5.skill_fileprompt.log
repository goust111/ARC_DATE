        if not strict:
            row = int(candidates[int(rng.integers(len(candidates)))])
            cols = np.flatnonzero(subset[row])
            if rng.random() < 0.5:
                subset[row, int(cols[0])] = False
            else:
                subset[row, int(cols[-1])] = False

        if _is_connected(subset):
