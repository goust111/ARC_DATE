        for tile_c, (c0, _) in enumerate(col_runs):
            for dr in (1, 2):
                for dc in (1, 2):
                    color = int(g[r0 + dr, c0 + dc])
                    if color not in structural:
                        groups[(color, dr, dc)].append((tile_r, tile_c))
    assert groups, "expected at least one marker group"

