+        tail_dr, tail_dc, fuel = tail_options[0]
+        move_dir = (-tail_dr, -tail_dc)
+        movers[(r, c)] = Mover(
+            pos=(r, c),
+            color=color,
+            tail_dir=(tail_dr, tail_dc),
+            move_dir=move_dir,
+            fuel=int(fuel),
