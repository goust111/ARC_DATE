+            if mismatch.size == 0:
+                continue
+            if int(mismatch.shape[0]) != 1:
+                return None
+
+            lr, lc = map(int, mismatch[0])
+            if int(block[lr, lc]) != defect_color:
+                return None
+            if (lr, lc) in seen_local_positions:
+                return None
+
+            seen_local_positions.add((lr, lc))
+            out[tr, tc] = int(base[lr, lc])
+            defect_tiles += 1
+
