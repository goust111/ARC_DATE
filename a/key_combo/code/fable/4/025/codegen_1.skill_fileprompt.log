+        return None
+    defect_color = int(rng.choice(defect_palette))
+
+    grid = np.tile(tile, (tile_rows, tile_cols))
+    expected = np.zeros((tile_rows, tile_cols), dtype=int)
+    for (tr, tc), (lr, lc) in zip(coarse_cells, local_cells):
