+            return ph, pw, tile_rows, tile_cols
+    return None
+
+
+def _neighbors4(rows: int, cols: int, r: int, c: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < rows and 0 <= cc < cols:
+            out.append((rr, cc))
+    return out
