+def _scan_colors(grid: np.ndarray, bg: int = BG) -> list[int]:
+    seen: set[int] = set()
+    colors: list[int] = []
+    for value in map(int, grid.ravel(order="C")):
+        if value == bg or value in seen:
+            continue
+        seen.add(value)
+        colors.append(value)
+    return colors
+
