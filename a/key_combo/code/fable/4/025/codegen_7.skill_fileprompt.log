+        ready.remove(pick)
+        order.append(pick)
+        for nxt in sorted(edges[pick], key=lambda idx: _rect_key(rects[idx])):
+            indegree[nxt] -= 1
+            if indegree[nxt] == 0:
+                ready.append(nxt)
