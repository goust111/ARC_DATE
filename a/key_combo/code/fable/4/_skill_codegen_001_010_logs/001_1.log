def _gen_boxes_compatible(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    """Return whether two inclusive 2x2 boxes avoid overlap and 4-adjacency."""
    ar0, ac0, ar1, ac1 = a
