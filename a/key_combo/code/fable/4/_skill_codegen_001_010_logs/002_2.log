+        if in_side in ("left", "right"):
+            offset = random.randint(1, h - 2)
+            r0 = out_gap[0] - offset
+            r1 = r0 + h - 1
+            if in_side == "left":
+                c0 = out_gap[1] + dist
+                c1 = c0 + w - 1
+                in_gap = (out_gap[0], c0)
+            else:
+                c1 = out_gap[1] - dist
+                c0 = c1 - w + 1
+                in_gap = (out_gap[0], c1)
+        else:
+            offset = random.randint(1, w - 2)
+            c0 = out_gap[1] - offset
+            c1 = c0 + w - 1
+            if in_side == "top":
+                r0 = out_gap[0] + dist
+                r1 = r0 + h - 1
+                in_gap = (r0, out_gap[1])
+            else:
+                r1 = out_gap[0] - dist
+                r0 = r1 - h + 1
+                in_gap = (r1, out_gap[1])
