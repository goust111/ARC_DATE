def _erase_mirror(canvas: np.ndarray, spr: dict, bg: int) -> None:
    """Erase the mirror half of a sprite back to *bg*."""
    r0, c0 = spr['r0'], spr['c0']
    h, w = spr['mirror'].shape
    canvas[r0:r0 + h, c0:c0 + w][spr['mirror']] = bg


