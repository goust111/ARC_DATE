+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+SIDE_DELTAS: dict[str, Coord] = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+
+
+@dataclass(frozen=True)
+class Frame:
+    bbox: BBox
+    color: int
