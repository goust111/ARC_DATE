+
+import numpy as np
+
+
+BG = 0
+MAX_GENERATION_ATTEMPTS = 900
+GRID_MIN = 22
+GRID_MAX = 30
+FRAME_SIZE_RANGE = (4, 7)
+CHAIN_LENGTH_CHOICES = (3, 4)
+CORRIDOR_RANGE = (3, 7)
