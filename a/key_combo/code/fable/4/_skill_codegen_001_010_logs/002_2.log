+
+
+def _place_next_frame(
+    shape: tuple[int, int],
+    frames: list[Frame],
+    current: Frame,
+    out_gap: Coord,
+    color: int,
+) -> Frame | None:
+    out_side = _side_of_gap(out_gap, current.bbox)
+    in_side = OPPOSITE[out_side]
+    for _ in range(100):
+        h = random.randint(*FRAME_SIZE_RANGE)
+        w = random.randint(*FRAME_SIZE_RANGE)
+        dist = random.randint(*CORRIDOR_RANGE)
