+        c += dc
+    return None
+
+
+def _apply_relay(g: np.ndarray, frames: list[Frame], source_i: int) -> np.ndarray:
+    out = g.copy()
+    current_i = int(source_i)
+    incoming: Coord | None = None
+    pattern = _interior_pattern(g, frames[current_i])
+    seen: set[tuple[int, Coord | None]] = set()
