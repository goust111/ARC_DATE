+
+def _side_cells(b: BBox, side: str) -> list[Coord]:
+    r0, c0, r1, c1 = b
+    if side == "top":
+        return [(r0, c) for c in range(c0 + 1, c1)]
+    if side == "bottom":
+        return [(r1, c) for c in range(c0 + 1, c1)]
