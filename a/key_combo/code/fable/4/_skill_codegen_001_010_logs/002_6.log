+
+BG = 0
+GREY = 5
+ARC_COLORS = tuple(range(10))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GROUP_COUNT_CHOICES = (3, 4, 5)
+HEIGHT_RANGE = (7, 12)
+WIDTH_CHOICES = (3, 4, 5, 6)
