+        sr, sc = int(sr_raw), int(sc_raw)
+        if seen[sr, sc]:
+            continue
+        q: deque[Coord] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        coords: list[Coord] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
