+    nonempty_cols = np.flatnonzero(mask.any(axis=0))
+    assert len(nonempty_cols) == w, "a group must occupy one continuous run of non-background columns"
+    assert int(nonempty_cols[0]) == 0 and int(nonempty_cols[-1]) == w - 1
