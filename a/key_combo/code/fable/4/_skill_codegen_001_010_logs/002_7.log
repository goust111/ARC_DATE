+        dirs[0] = random.choice(((-1, 0), (0, -1)))
+    if not any(step in ((1, 0), (0, 1)) for step in dirs):
+        dirs[1] = random.choice(((1, 0), (0, 1)))
+    random.shuffle(dirs)
+    return dirs
+
