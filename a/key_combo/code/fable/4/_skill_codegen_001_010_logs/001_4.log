    legend_mask[legend_row:legend_row + legend_rows, legend_col:legend_col + LEGEND_WIDTH] = True
    if np.count_nonzero((grid != bg) & (~legend_mask)) < MIN_PLACED_TARGETS:
        return False

    inp = grid.copy()
    try:
        out = main(inp)
    except Exception:
        return False
    return np.array_equal(main(grid), out)



