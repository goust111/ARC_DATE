    grid = np.zeros((h, w), dtype=int)
    for r, c0, c1, top_color, bottom_color in gates:
        grid[r, c0 : c1 + 1] = int(top_color)
        grid[r + 1, c0 : c1 + 1] = int(bottom_color)
    return grid


