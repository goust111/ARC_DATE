+def _fragment_bboxes(g: np.ndarray) -> list[tuple[int, int, int, int]]:
+    mask = (g != BG) & (g != FRAME)
+    comps = _components(mask)
+    assert comps, "expected at least one pattern fragment"
+    boxes: list[tuple[int, int, int, int]] = []
+    for coords in comps:
