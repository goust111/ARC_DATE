        border_area = 2 * h + 2 * w - 4
        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                if r in (r0, r1) or c in (c0, c1):
                    if g[r, c] != frame_color:
                        missing.append((r, c))
                else:
                    assert g[r, c] == bg

