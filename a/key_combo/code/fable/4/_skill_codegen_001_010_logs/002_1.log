+        r0, c0, r1, c1 = b
+        patch = mask[r0 : r1 + 1, c0 : c1 + 1]
+        assert bool(np.all(patch)), "pattern fragments must be solid rectangles"
+        assert FRAME not in set(map(int, g[r0 : r1 + 1, c0 : c1 + 1].ravel()))
+        boxes.append(b)
