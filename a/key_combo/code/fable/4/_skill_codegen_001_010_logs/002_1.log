+    pr, pc = tile.shape
+    for _ in range(120):
+        c0 = random.randint(1, cols - pc - 1)
+        boxes: list[tuple[int, int, int, int]] = []
+        temp = occupied.copy()
+        residues = list(range(pr))
+        random.shuffle(residues)
+        ok = True
+        for residue in residues:
