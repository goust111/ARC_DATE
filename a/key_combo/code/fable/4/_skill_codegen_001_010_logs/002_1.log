+            if not _fragment_has_alternative_period(box, g, tile.shape):
+                return False
+
+        for remove_idx, box in enumerate(boxes):
+            r0, c0, r1, c1 = box
+            reduced = g.copy()
+            reduced[r0 : r1 + 1, c0 : c1 + 1] = BG
+            try:
