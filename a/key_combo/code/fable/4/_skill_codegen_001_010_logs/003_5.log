+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if out.shape != grid.shape or max(out.shape) > 30:
+        return None
+    if not _passes_semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
