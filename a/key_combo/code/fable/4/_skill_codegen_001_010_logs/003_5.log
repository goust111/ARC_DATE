+    assert np.all(row0[:c0] == bg) and np.all(row0[c1 + 1 :] == bg), "only the tape may appear on the top row"
+    assert np.all(g[1, :] == bg), "one background separator row must split tape and scene"
+    tape = [int(x) for x in row0[c0 : c1 + 1]]
