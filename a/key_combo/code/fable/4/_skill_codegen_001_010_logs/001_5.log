+def generate_input() -> np.ndarray:
+    for _ in range(RETRY_LIMIT):
+        grid = _render_candidate()
+        if grid is None:
+            continue
+        if _generator_semantics_ok(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid fable/4/5 input")

