+def _seed_and_pairs(g: np.ndarray):
+    vals, counts = np.unique(g, return_counts=True)
+    seed = []
+    pairs = {}
+    for value, count in zip(vals, counts):
+        color = int(value)
+        n = int(count)
+        if color == BG:
+            continue
+        coords = [tuple(map(int, rc)) for rc in np.argwhere(g == color)]
+        if n == 1:
