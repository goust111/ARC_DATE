+    q = deque([seed_coord])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w) or (nr, nc) in seen:
+                continue
+            if int(canvas[nr, nc]) != BG:
+                continue
+            seen.add((nr, nc))
