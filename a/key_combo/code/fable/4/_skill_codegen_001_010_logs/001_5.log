import random


def _ring_windows(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
    rings: list[tuple[int, int]] = []
    h, w = g.shape
    for r in range(h - 2):
        for c in range(w - 2):
            window = g[r : r + 3, c : c + 3]
            if np.any(window == bg):
                continue
            border = np.array(
                (
                    window[0, 0],
                    window[0, 1],
                    window[0, 2],
                    window[1, 0],
                    window[1, 2],
                    window[2, 0],
                    window[2, 1],
                    window[2, 2],
                )
            )
            if np.all(border == border[0]) and int(window[1, 1]) != int(border[0]):
                rings.append((r, c))
    return rings


def _checker_windows(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
    checkers: list[tuple[int, int]] = []
    h, w = g.shape
    for r in range(h - 2):
        for c in range(w - 2):
            window = g[r : r + 3, c : c + 3]
            if np.any(window == bg):
                continue
            colors = set(map(int, window.flat))
            if len(colors) != 2:
                continue

            even_color = int(window[0, 0])
            odd_color = int(window[0, 1])
            is_checker = all(
                int(window[rr, cc]) == (even_color if (rr + cc) % 2 == 0 else odd_color)
                for rr in range(3)
                for cc in range(3)
            )
            if is_checker:
                checkers.append((r, c))
    return checkers


