+def _dilated(mask: np.ndarray, pad: int) -> np.ndarray:
+    if pad <= 0:
+        return mask.copy()
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                if abs(dr) + abs(dc) <= pad:
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < h and 0 <= cc < w:
