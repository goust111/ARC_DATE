    return False


def _gen_ray_cells(shape, gap, side):
    rows, cols = shape
    dr, dc = _gen_ray_step(side)
    r, c = gap
    cells = []
    while 0 <= r < rows and 0 <= c < cols:
        cells.append((r, c))
        r += dr
        c += dc
    return cells

