+def _choose_plan() -> tuple[list[tuple[Coord, ...]], list[list[tuple[int, tuple[Coord, ...]]]], list[tuple[Coord, ...]], int]:
+    cavities: list[tuple[Coord, ...]] = []
+    assignments: list[list[tuple[int, tuple[Coord, ...]]]] = []
+    pieces: list[tuple[Coord, ...]] = []
