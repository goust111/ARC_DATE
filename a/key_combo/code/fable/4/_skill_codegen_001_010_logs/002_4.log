+    if not nonsymmetric:
+        return _choose_plan()
+    trap_piece_i = random.choice(nonsymmetric)
+    trap_shape = random.choice([rot for rot in _rotations(pieces[trap_piece_i]) if not _same_shape(rot, pieces[trap_piece_i])])
+    cavities.append(trap_shape)
