        mover_masks.append(mask)
        used_area += int(mask.sum())
    return mover_masks


def _place_movers(inp: np.ndarray, out: np.ndarray, mover_masks: list[np.ndarray], cols: list[int], fg: int) -> tuple[np.ndarray, set[int]] | None:
