def _gen_sequence(
    n: int,
    colors: list[int],
    *,
    fixed: dict[int, int],
    min_distinct: int,
    avoid_adjacent: bool = True,
) -> list[int] | None:
    fixed = {int(k): int(v) for k, v in fixed.items()}
    if any(k < 0 or k >= n for k in fixed):
