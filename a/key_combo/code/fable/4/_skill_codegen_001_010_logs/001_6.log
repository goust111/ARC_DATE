+def _build_plans(sprite_count: int) -> list[tuple[int, int]] | None:
+    for _ in range(100):
+        marker_count = random.choice((4, 4, 5))
+        sizes = [1, 2, 3]
+        while len(sizes) < marker_count:
+            sizes.append(random.choice((1, 2, 3)))
+        random.shuffle(sizes)
