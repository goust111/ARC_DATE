+def _has_only_one_separator(grid: np.ndarray, separator_row: int) -> bool:
+    bg = _get_bg(grid)
+    h, w = map(int, grid.shape)
+    for r in range(h):
+        color = int(grid[r, 0])
+        if color != bg and np.all(grid[r, :] == color) and r != separator_row:
+            return False
