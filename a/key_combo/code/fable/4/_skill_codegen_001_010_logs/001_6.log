+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        q = deque([(sr, sc)])
+        seen[sr, sc] = True
+        cells: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for nr, nc in _neighbors(r, c, connectivity):
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if seen[nr, nc] or not bool(mask[nr, nc]):
+                    continue
+                seen[nr, nc] = True
