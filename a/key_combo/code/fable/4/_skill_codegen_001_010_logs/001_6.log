+        cols = list(range(1, width - sw))
+        random.shuffle(rows)
+        random.shuffle(cols)
+        placed = False
+        for r0 in rows:
+            for c0 in cols:
+                if not _rect_clear(occupied, r0, c0, sh, sw, margin=1):
+                    continue
