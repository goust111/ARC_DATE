+    for r in range(1, h - 1):
+        color = int(g[r, 0])
+        if color != bg and np.all(g[r, :] == color):
+            lines.append(("row", r))
+    for c in range(1, w - 1):
+        color = int(g[0, c])
+        if color != bg and np.all(g[:, c] == color):
+            lines.append(("col", c))
