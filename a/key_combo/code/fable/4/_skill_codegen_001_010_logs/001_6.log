+        sprite = spec["sprite"]
+        sh, sw = map(int, sprite.shape)
+        rows = list(range(1, height - sh))
+        cols = list(range(1, width - sw))
+        random.shuffle(rows)
+        random.shuffle(cols)
+        placed = False
+        for r0 in rows:
+            for c0 in cols:
+                if not _rect_clear(occupied, r0, c0, sh, sw, margin=1):
+                    continue
+                _paint_patch(panel, sprite, r0, c0)
