+                sprite[r, c] = int(body_colors[0])
+        else:
+            counts = [2] * body_count
+            for _leftover in range(len(body_cells) - sum(counts)):
+                counts[random.randrange(body_count)] += 1
+            pos = 0
+            for color, count in zip(body_colors, counts):
