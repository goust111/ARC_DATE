+
+def _neighbors(r: int, c: int, connectivity: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+    if int(connectivity) == 8:
+        yield r - 1, c - 1
+        yield r - 1, c + 1
+        yield r + 1, c - 1
+        yield r + 1, c + 1
