+    used = {idx: set() for idx in range(len(specs))}
+    for owner, k in plans:
+        used[owner].add(k)
+    if any(not sizes for sizes in used.values()):
+        return False
+    if not any(len(sizes) >= 2 for sizes in used.values()):
+        return False
+    if len({spec["anchor"] for spec in specs}) < min(2, len(specs)):
