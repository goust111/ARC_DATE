    """Return True iff (r,c) is within a grid of shape (H,W)."""
    H, W = map(int, shape)
    return 0 <= int(r) < H and 0 <= int(c) < W


def neighbors4(r: int, c: int) -> Iterator[Coord]:
    """4-neighborhood of (r,c)."""
    r = int(r)
    c = int(c)
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


