def _legend_bbox(g: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    candidates = []
    for comp in find_components(g, bg=bg, connectivity=8, monochromatic=False):
        r0, c0, r1, c1 = comp["bbox"]
        h = bbox_h(comp["bbox"])
        if bbox_w(comp["bbox"]) != 2:
