def _line_separates_targets(
    g: np.ndarray,
    bg: int,
    legend_bbox: tuple[int, int, int, int],
    line: tuple[str, int, int],
) -> bool:
    r0, c0, r1, c1 = legend_bbox
    typ, idx, _color = line
    mask = np.ones(g.shape, dtype=bool)
    mask[r0 : r1 + 1, c0 : c1 + 1] = False
    if typ == "row":
        mask[idx, :] = False
    else:
        mask[:, idx] = False
    targets = np.argwhere((g != bg) & mask)
    if targets.size == 0:
