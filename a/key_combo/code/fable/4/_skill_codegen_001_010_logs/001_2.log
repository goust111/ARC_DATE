+    if direction == (0, -1):
+        return random.randint(3, h - 4), random.randint(4, w - 4)
+    if direction == (1, 0):
+        return random.randint(3, h - 5), random.randint(3, w - 4)
+    return random.randint(4, h - 4), random.randint(3, w - 4)
