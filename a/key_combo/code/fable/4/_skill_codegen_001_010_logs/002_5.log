        h = r1 - r0 + 1
        w = c1 - c0 + 1
        assert h >= 3 and w >= 3

        coords = frame["coords"]
        assert all(r in (r0, r1) or c in (c0, c1) for r, c in coords)

        missing: list[tuple[int, int]] = []
        border_area = 2 * h + 2 * w - 4
        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
