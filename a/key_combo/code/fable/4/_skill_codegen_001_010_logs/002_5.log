import numpy as np

from arc_utils import Color, find_components, get_bg


def _gap_direction(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> tuple[int, int]:
    r, c = gap
    r0, c0, r1, c1 = bbox
    assert int(r in (r0, r1)) + int(c in (c0, c1)) == 1
    if r == r0:
        return -1, 0
    if r == r1:
        return 1, 0
    if c == c0:
        return 0, -1
    assert c == c1
    return 0, 1


