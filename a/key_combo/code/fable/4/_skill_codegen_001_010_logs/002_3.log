+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        q: deque[Coord] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        cells: list[Coord] = []
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for rr, cc in _neighbors(r, c, connectivity):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
