  "dst": "single prototype object d in the other foreground color",
  "match_cond": "run-compressed s.shape == run-compressed d.shape up to rotation/reflection",
  "transform": "recolor matched s to d.color; leave nonmatching objects unchanged"
}
</annotation>
</reference_puzzle>

