import random

import numpy as np

from arc_utils import Color, find_components, paste

# ---------------------------------------------------------------------------
# Core helpers
# ---------------------------------------------------------------------------

_INDICATOR_COLORS = (Color.RED, Color.GREEN)
_BG = Color.BLACK
_PATTERN_PALETTE = [Color.BLUE, Color.YELLOW, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
_NEIGHBORS_4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = map(int, shape)
    return 0 <= int(r) < h and 0 <= int(c) < w


def _rand_connected_region(
    h: int,
    w: int,
    anchor: tuple[int, int],
    axis_c: int,
    side: str,
    target_size: int,
    *,
    max_steps: int = 500,
) -> set[tuple[int, int]] | None:
    if side not in {\"left\", \"right\"}:
        raise ValueError(\"side must be 'left' or 'right'\")

    ar, ac = anchor
    if not (0 <= ar < h and 0 <= ac < w):
        return None
    if side == \"left\" and ac > axis_c:
        return None
    if side == \"right\" and ac < axis_c:
        return None

    def allowed(r: int, c: int) -> bool:
        return c <= axis_c if side == \"left\" else c >= axis_c

    cells: set[tuple[int, int]] = {anchor}
    frontier: list[tuple[int, int]] = [anchor]

    attempts = 0
    while len(cells) < target_size and attempts < max_steps:
        attempts += 1
        r, c = random.choice(frontier)
        dr, dc = random.choice(_NEIGHBORS_4)
        nr, nc = r + dr, c + dc
        if 0 <= nr < h and 0 <= nc < w and allowed(nr, nc):
            nxt = (nr, nc)
            if nxt not in cells:
                cells.add(nxt)
                frontier.append(nxt)

    return cells if len(cells) == target_size else None


def _axis_has_missing_partner(patch: np.ndarray, axis_c: int, marker: tuple[int, int]) -> bool:
    h, w = map(int, patch.shape)
    marker_r, marker_c = marker
    if not (0 <= marker_c < w):
