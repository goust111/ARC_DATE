    patch[1 : h - 1, axis_c] = indicator_color if False else patch[1 : h - 1, axis_c]
    # leave only one side partially filled so completion is non-trivial
    for rr in range(2, h):
        patch[rr, 0:axis_c] = random.choice(
            [c for c in _PATTERN_PALETTE if c != indicator_color]
        )
    return patch, marker


def _bbox_for_coords(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _free_position(
    occupied: np.ndarray,
    shape_mask: np.ndarray,
    *,
    padding: int = 1,
    tries: int = 500,
) -> tuple[int, int] | None:
    h, w = occupied.shape
    ph, pw = map(int, shape_mask.shape)
    for _ in range(tries):
        r0 = random.randint(0, h - ph)
        c0 = random.randint(0, w - pw)

        rr0 = max(0, r0 - padding)
        cc0 = max(0, c0 - padding)
        rr1 = min(h, r0 + ph + padding)
        cc1 = min(w, c0 + pw + padding)

        if np.any(occupied[rr0:rr1, cc0:cc1] & shape_mask[max(0, rr0-r0):max(0, rr0-r0)+ (rr1-rr0),
                                                         max(0, cc0-c0):max(0, cc0-c0)+ (cc1-cc0)]):
            continue

        if np.any(occupied[r0 : r0 + ph, c0 : c0 + pw] & shape_mask):
            continue

        return r0, c0

    return None


def _place_isolated_marker(
    grid: np.ndarray,
    occupied: np.ndarray,
    color: int,
    *,
    tries: int = 500,
) -> tuple[int, int] | None:
    h, w = grid.shape
    for _ in range(tries):
        r = random.randint(0, h - 1)
        c = random.randint(0, w - 1)
        if occupied[r, c]:
            continue

        rr0 = max(0, r - 1)
        cc0 = max(0, c - 1)
        rr1 = min(h, r + 2)
        cc1 = min(w, c + 2)
        if np.any(occupied[rr0:rr1, cc0:cc1]):
            continue

        grid[r, c] = int(color)
        occupied[r, c] = True
        return r, c

    return None


def _build_symmetric_stamp(
    grid: np.ndarray,
    component_coords: np.ndarray,
    marker_row: int,
    marker_col: int,
) -> tuple[np.ndarray, tuple[int, int]]:
    h, w = map(int, grid.shape)
    stamp_cells: dict[tuple[int, int], int] = {}

    for r, c in map(tuple, component_coords):
        r_i = int(r)
        c_i = int(c)
        col = int(grid[r_i, c_i])
        stamp_cells[(r_i, c_i)] = col

        mirrored_c = 2 * int(marker_col) - c_i
        if not (0 <= mirrored_c < w):
            continue

        existing = stamp_cells.get((r_i, mirrored_c))
        if existing is not None and existing != col:
            # Degenerate/conflicted inputs are allowed; keep original when conflicts exist.
            continue
        stamp_cells[(r_i, mirrored_c)] = col

    r0, c0, r1, c1 = _bbox_for_coords(stamp_cells.keys())
    stamp = np.full((r1 - r0 + 1, c1 - c0 + 1), _BG, dtype=int)
    for (r, c), value in stamp_cells.items():
        stamp[r - r0, c - c0] = int(value)

    return stamp, (marker_row - r0, marker_col - c0)


# ---------------------------------------------------------------------------
# Main transform
# ---------------------------------------------------------------------------

def main(grid: np.ndarray) -> np.ndarray:
    """以指示像素所在列对每个图案做左右镜像补全，再在同色孤立指示像素处盖印。

Input structure:
- 黑色为背景。
- 输入上有若干多色图案，每个图案内部恰有一个红色或绿色指示像素。
- 另有若干红色/绿色孤立像素，作为盖印目标（与图案内部像素不连通）。

Rule:
- 识别每个包含且仅包含一个指示色像素的多色图案，对该图案按指示像素所在的列做左右镜像补全（同列镜像）得到对称全形。
- 用该对称全形替换该图案原位。
- 再将该对称全形按其指示像素对齐到每个同色的孤立指示像素，逐一盖印，背景之外不变。

Key insight:
- 指示像素同时决定了图案的补全轴、图案与目标颜色的配对关系，以及盖印时的锚点位置。
"""

    g = np.asarray(grid, dtype=int)
    if g.ndim != 2:
        raise ValueError("main expects a 2D grid")

    out = g.copy()
    H, W = g.shape

    components = find_components(g, bg=_BG, connectivity=8, monochromatic=False, return_format="dict")
    patterns: list[tuple[np.ndarray, tuple[int, int], int, tuple[int, int]]] = []
    targets: dict[int, list[tuple[int, int]]] = {Color.RED: [], Color.GREEN: []}

    for comp in components:
        coords = comp["coords"]
        if coords.size == 0:
            continue

        values = g[coords[:, 0], coords[:, 1]]
        is_indicator = np.isin(values, _INDICATOR_COLORS)
        cnt_indicator = int(np.sum(is_indicator))

        # Size-1 components are isolated markers.
        if coords.shape[0] == 1 and cnt_indicator == 1:
            mr, mc = map(int, coords[0])
            col = int(g[mr, mc])
            targets[col].append((mr, mc))
            continue

        # Multi-cell patterns must include exactly one indicator pixel.
        if cnt_indicator != 1:
            continue

        marker_index = int(np.flatnonzero(is_indicator)[0])
        marker_row, marker_col = map(int, coords[marker_index])
        marker_color = int(values[marker_index])

        stamp, anchor = _build_symmetric_stamp(g, coords, marker_row, marker_col)
        patterns.append((stamp, anchor, marker_color, (marker_row, marker_col)))

    for stamp, anchor, marker_color, marker_global in patterns:
        ph, pw = map(int, stamp.shape)
        anchor_r, anchor_c = map(int, anchor)

        # Place completed pattern at original position.
        top = marker_global[0] - anchor_r
        left = marker_global[1] - anchor_c
        if 0 <= top and 0 <= left and top + ph <= H and left + pw <= W:
            paste(out, stamp, top, left, transparent=_BG)

        # Stamp to each same-color isolated target.
        for tr, tc in targets.get(marker_color, []):
            top = int(tr) - anchor_r
            left = int(tc) - anchor_c
            if 0 <= top and 0 <= left and top + ph <= H and left + pw <= W:
                paste(out, stamp, top, left, transparent=_BG)

    return out


# ---------------------------------------------------------------------------
# Random generator
# ---------------------------------------------------------------------------

def _build_inputs_once() -> np.ndarray | None:
    H = random.randint(16, 30)
    W = random.randint(16, 30)
    grid = np.full((H, W), _BG, dtype=int)
    occupied = np.zeros((H, W), dtype=bool)

    pattern_count = random.randint(1, 4)
    if random.random() < 0.65 and pattern_count >= 2:
        # Branch: force both marker colors to appear.
        pattern_marker_colors = [Color.RED, Color.GREEN] + [random.choice(_INDICATOR_COLORS) for _ in range(pattern_count - 2)]
        random.shuffle(pattern_marker_colors)
    else:
        pattern_marker_colors = [random.choice(_INDICATOR_COLORS) for _ in range(pattern_count)]

    for marker_color in pattern_marker_colors:
        for _ in range(80):
            patch, marker = _generate_partial_pattern(indicator_color=marker_color)
            mask = patch != _BG

            # Keep patches reasonably spaced so generator is stable and readable.
            pos = _free_position(occupied, mask, padding=1, tries=220)
            if pos is None:
                continue

            r0, c0 = pos
            patch_h, patch_w = map(int, patch.shape)
            if r0 + patch_h > H or c0 + patch_w > W:
                continue

            paste(grid, patch, r0, c0, transparent=_BG)
            occupied[r0 : r0 + patch_h, c0 : c0 + patch_w] |= (patch != _BG)
            break
        else:
            return None

    # One or more isolated marker targets per pattern, with occasional multiple targets.
    for marker_color in pattern_marker_colors:
        target_count = random.choice((1, 1, 2))
        for _ in range(target_count):
            pos = _place_isolated_marker(grid, occupied, marker_color, tries=500)
            if pos is None:
                return None

    # Optional extra random targets adds coverage of repeated stamping behavior.
    if random.random() < 0.65:
        for marker_color in _INDICATOR_COLORS:
            if random.random() < 0.4:
                if _place_isolated_marker(grid, occupied, marker_color, tries=250) is None:
                    return None

    # Keep only visible, valid cases.
    try:
        _ = main(grid)
    except Exception:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(300):
        grid = _build_inputs_once()
        if grid is not None:
            return grid

    raise RuntimeError("failed to generate valid puzzle input")
