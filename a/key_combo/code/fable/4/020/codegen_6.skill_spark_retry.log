# Canvas, object count, and retry bounds.
_GEN_BACKGROUND_45737921 = 0
_GEN_ROW_RANGE_45737921 = range(7, 14)
_GEN_COL_RANGE_45737921 = range(7, 13)
_GEN_OBJECT_COUNT_RANGE_45737921 = (1, 4)
_GEN_MAX_ATTEMPTS_45737921 = 300

