+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+TEMPLATE_COLORS = np.array([3, 4, 5, 6, 7, 8, 9], dtype=int)
+
+GRID_MIN = 18
+GRID_MAX = 30
+PATH_LEN_RANGE = (4, 7)
+DISTRACTOR_CHOICES = (0, 1, 2, 3)
+DISTRACTOR_WEIGHTS = np.array([0.2, 0.25, 0.35, 0.2], dtype=float)
+STEP_MIN = 4
+STEP_MAX = 7
+FIELD_MARGIN = 5
+GEN_RETRIES = 400
+
