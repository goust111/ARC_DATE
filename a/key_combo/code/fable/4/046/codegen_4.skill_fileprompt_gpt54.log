+
+    return distractors
+
+
+def _paint_template(grid: np.ndarray, template: np.ndarray, corner: str) -> None:
+    H, W = grid.shape
+    if corner == "tl":
+        r0, c0 = 0, 0
+    elif corner == "tr":
+        r0, c0 = 0, W - 3
+    elif corner == "bl":
+        r0, c0 = H - 3, 0
+    else:
+        r0, c0 = H - 3, W - 3
+    grid[r0 : r0 + 3, c0 : c0 + 3] = template
