+                    if any(pt not in point_to_idx for pt in corners):
+                        continue
+                    rect = (r0, c0, r1, c1)
+                    idxs = tuple(point_to_idx[pt] for pt in corners)
+                    rid = len(rects)
+                    rects.append(rect)
+                    rect_points.append(idxs)
+                    for pid in idxs:
