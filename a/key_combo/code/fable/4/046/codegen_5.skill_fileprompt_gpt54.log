+
+        try:
+            solved = sorted(_search_unique_rectangles(_extract_points(grid)))
+        except AssertionError:
+            continue
+
+        if solved != sorted(rects):
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid invisible-rectangle input")

