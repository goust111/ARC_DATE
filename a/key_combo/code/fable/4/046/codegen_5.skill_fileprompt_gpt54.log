+    solution_masks: list[tuple[int, ...]] = []
+    n_points = len(points)
+    n_rects = len(rects)
+
+    def dfs(state: np.ndarray, counts: np.ndarray) -> None:
+        if len(solution_masks) >= 2:
+            return
+
+        best_point = None
+        best_undecided: list[int] | None = None
+        best_branch_count = None
+
+        for pid in range(n_points):
+            count = int(counts[pid])
+            if count > 2:
+                return
