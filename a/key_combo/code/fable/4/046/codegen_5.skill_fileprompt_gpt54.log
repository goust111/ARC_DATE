+    return True
+
+
+def _coverage_is_clear(rects: list[tuple[int, int, int, int]], shape: tuple[int, int]) -> bool:
+    cover = np.zeros(shape, dtype=np.int16)
+    for r0, c0, r1, c1 in rects:
+        cover[r0 : r1 + 1, c0 : c1 + 1] += 1
