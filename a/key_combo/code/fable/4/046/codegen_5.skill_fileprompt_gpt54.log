+    return 0 <= r0 < r1 < height and 0 <= c0 < c1 < width and (r1 - r0) >= 2 and (c1 - c0) >= 2
+
+
+def _pairwise_clear(rects: list[tuple[int, int, int, int]]) -> bool:
