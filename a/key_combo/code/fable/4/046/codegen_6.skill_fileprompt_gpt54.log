+    specs = _sample_specs(pair_count, rng)
+
+    band_heights = [max(s1, s2) for s1, s2, _ in specs]
+    widths = [s1 + gap + s2 for s1, s2, gap in specs]
+    min_height = sum(band_heights) + (pair_count + 1)
