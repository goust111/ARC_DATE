+
+def _paint_cells(grid: np.ndarray, coords: np.ndarray, values: np.ndarray) -> None:
+    for (r, c), color in zip(np.asarray(coords, dtype=int), np.asarray(values, dtype=int)):
+        grid[int(r), int(c)] = int(color)
