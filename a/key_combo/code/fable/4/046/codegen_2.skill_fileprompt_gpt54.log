+
+def _apply_transform(coords: np.ndarray, transform_id: int) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    r = arr[:, 0]
+    c = arr[:, 1]
+    tid = int(transform_id)
+    if tid == 0:
+        out = np.column_stack([r, c])
+    elif tid == 1:
+        out = np.column_stack([c, -r])
+    elif tid == 2:
+        out = np.column_stack([-r, -c])
+    elif tid == 3:
+        out = np.column_stack([-c, r])
+    elif tid == 4:
+        out = np.column_stack([r, -c])
+    elif tid == 5:
