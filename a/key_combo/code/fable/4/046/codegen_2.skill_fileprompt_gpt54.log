+def _valid_sprite_landing(
+    sprite_abs: np.ndarray,
+    shape: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> bool:
+    for r, c in np.asarray(sprite_abs, dtype=int):
+        rr = int(r)
+        cc = int(c)
+        if not _in_bounds(shape, rr, cc) or (rr, cc) in blocked:
