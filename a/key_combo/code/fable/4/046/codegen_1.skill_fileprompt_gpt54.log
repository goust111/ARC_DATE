0057:         r = int(r)
0058:         c = int(c)
0059:         color = int(g[r, c])
0060:         if color == marker:
0061:             continue
0062:         rr = tr + (r - sr)
0063:         cc = tc + (c - sc)
0064:         assert in_bounds(g.shape, rr, cc), "translated sprite must remain in bounds"
0065:         assert int(g[rr, cc]) == bg, "translated sprite must land on background cells"
0066:         out[rr, cc] = color
0067: 
0068:     return out
