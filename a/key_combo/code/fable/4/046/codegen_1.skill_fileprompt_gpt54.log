0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Copy the colored sprite so its gray marker aligns with the isolated gray target marker.
0011: 
0012:     Input structure
0013:     - The background contains one 4-connected multicolor source sprite with exactly one gray marker pixel.
0014:     - A second gray marker pixel is isolated elsewhere on the background.
0015: 
0016:     Rule
0017:     - Keep the source sprite in place.
0018:     - Translate every non-gray pixel of the source sprite by the offset from the source marker to the isolated marker.
0019:     - Erase the isolated marker to the background before painting the translated copy.
0020: 
0021:     Key insight
0022:     - The gray pixels are anchors, not artwork: the gray pixel inside the source gives the copy origin, and the isolated gray pixel gives the destination.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
0026:     marker = Color.GREY
0027:     assert bg != marker, "gray marker must be distinct from the background"
0028:     assert np.argwhere(g == marker).shape[0] == 2, "expected exactly two gray marker pixels"
0029: 
0030:     source_components = []
0031:     target_components = []
0032:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict"):
0033:         coords = comp["coords"]
0034:         vals = g[coords[:, 0], coords[:, 1]]
0035:         if not np.any(vals == marker):
0036:             continue
0037:         if np.any(vals != marker):
0038:             source_components.append(coords)
0039:         else:
0040:             target_components.append(coords)
0041: 
0042:     assert len(source_components) == 1, "expected one source sprite containing a gray marker"
0043:     assert len(target_components) == 1, "expected one isolated gray target marker"
0044: 
0045:     source = source_components[0]
0046:     target = target_components[0]
0047:     assert target.shape == (1, 2), "target marker must be a single pixel"
0048:     source_markers = source[g[source[:, 0], source[:, 1]] == marker]
0049:     assert source_markers.shape == (1, 2), "source sprite must contain one gray marker"
0050: 
0051:     sr, sc = map(int, source_markers[0])
0052:     tr, tc = map(int, target[0])
0053: 
0054:     out = g.copy()
0055:     out[tr, tc] = bg
