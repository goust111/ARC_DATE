0071: def main(grid: np.ndarray) -> np.ndarray:
0072:     """
0073:     Draw orange corridors along a nearest-visible-block walk from the red 2x2 block through teal 2x2 blocks.
0074: 
0075:     Input structure
0076:     - The background contains one red 2x2 start block and multiple teal 2x2 target blocks.
0077:     - Blocks may align in shared two-row or two-column bands; non-background pixels between aligned blocks block visibility.
0078: 
0079:     Rule
0080:     - Start at the red block.
0081:     - Among unvisited teal blocks visible in the same horizontal or vertical band, choose the unique nearest one.
0082:     - Paint the background gap between the current block and that teal block orange, then continue from that teal block.
0083:     - Stop when no unvisited teal block is visible from the current block.
0084: 
0085:     Key insight
0086:     - The output is not the full alignment graph; it is a greedy nearest-neighbor walk whose line of sight is blocked by any existing colored block.
0087:     """
0088:     g = np.asarray(grid, dtype=int)
0089:     bg = int(get_bg(g))
0090:     current, unvisited = _blocks(g, bg)
0091:     out = g.copy()
0092: 
0093:     while True:
0094:         candidates = []
0095:         for block in unvisited:
0096:             step = _visible_step(g, bg, current, block)
0097:             if step is None:
0098:                 continue
0099:             axis, distance = step
0100:             candidates.append((distance, axis, block))
0101: 
0102:         if not candidates:
0103:             break
0104: 
0105:         min_distance = min(distance for distance, _axis, _block in candidates)
0106:         nearest = [candidate for candidate in candidates if candidate[0] == min_distance]
0107:         assert len(nearest) == 1, "expected a unique nearest visible teal block"
0108: 
0109:         _distance, axis, block = nearest[0]
0110:         _paint_corridor(out, current, block, axis)
0111:         unvisited = [candidate for candidate in unvisited if candidate is not block]
0112:         current = block
0113: 
0114:     return out
