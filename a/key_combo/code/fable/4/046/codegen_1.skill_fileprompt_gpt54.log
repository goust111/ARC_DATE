0015: def main(input_grid):
0016:     """
0017:     Fill the gray square with stripe colors in the order and orientation they appear.
0018: 
0019:     Input structure:
0020:     - The grid contains colored stripes and one gray square.
0021:     - The gray square side length matches the number of stripe color entries.
0022:     - Stripes are all vertical or all horizontal.
0023: 
0024:     Rule:
0025:     - Extract the gray square as the output canvas.
0026:     - Sort non-gray stripes by column for vertical stripes or row for horizontal stripes.
0027:     - Fill each output column or row with the corresponding stripe color in order.
0028: 
0029:     Key insight:
0030:     - Stripe orientation determines whether the ordered colors become output columns or rows.
0031:     """
0032:     # Find the gray square in the input grid and get its position and size
0033:     gray_rectangle = detect_objects(grid=input_grid, colors=[Color.GRAY], monochromatic=True, connectivity=4)[0]
0034:     _b = bbox(gray_rectangle != Color.BLACK)
0035:     assert _b is not None
0036:     output_grid = crop_bbox(gray_rectangle, _b)
0037: 
0038:     # Get the color lines in the input grid
0039:     objects = detect_objects(grid=input_grid, monochromatic=False, connectivity=8)
0040:     lines = []
0041:     for obj in objects:
0042:         # Get the position and size of the color line
0043:         _b = bbox(obj != Color.BLACK)
0044:         assert _b is not None
0045:         r0, c0, r1, c1 = _b
0046:         h = r1 - r0 + 1
0047:         w = c1 - c0 + 1
0048:         color = obj[r0, c0]
0049:         if color != Color.GRAY:
0050:             lines.append({"r": r0, "c": c0, "color": int(color), "h": h, "w": w})
0051:     
0052:     # Check if the stripes are horizontal or vertical
0053:     stripes_are_vertical = all(line["w"] == 1 for line in lines)
