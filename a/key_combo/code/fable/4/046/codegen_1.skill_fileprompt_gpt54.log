0064:     # Find the colors lines in the input grid in order
0065:     colors_in_square = [
0066:         d["color"] for i, d in enumerate(lines) if i == 0 or d["color"] != lines[i - 1]["color"]
0067:     ]
0068: 
0069:     # Fill the gray square with the colors of the stripes in the order and direction they appear
0070:     for i in range(len(output_grid)):
0071:         if stripes_are_vertical:
0072:             # Fill column i top-to-bottom
0073:             draw_line(grid=output_grid, r=0, c=i, direction=direction, color=colors_in_square[i])
0074:         else:
0075:             # Fill row i left-to-right
0076:             draw_line(grid=output_grid, r=i, c=0, direction=direction, color=colors_in_square[i])
0077:             
0078:     return output_grid
