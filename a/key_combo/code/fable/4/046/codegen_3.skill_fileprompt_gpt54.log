+    objects = []
+
+    for sr, sc in np.argwhere(g != bg):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        q = deque([(sr, sc)])
+        seen[sr, sc] = True
+        coords = []
+        colors = set()
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
