+        r0, c0 = chosen
+        objects[idx] = {
+            "color": None,
+            "r0": int(r0),
+            "c0": int(c0),
+            "mask": mask.copy(),
+            "bend": int(bends),
+        }
+        _add_blocked(mask, r0, c0, blocked)
