+    for flip in (False, True):
+        base = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            variant = _normalize_mask(np.rot90(base, k))
+            sig = _mask_signature(variant)
+            if sig not in seen:
+                seen.add(sig)
+                variants.append(variant)
+    return variants
+
