+def _build_panel(
+    H: int,
+    heights: list[int],
+    widths: list[int],
+) -> np.ndarray:
+    panel_w = 2 + sum(widths) + (len(widths) - 1)
+    panel = np.full((H, panel_w), BG, dtype=int)
+    col = 1
+    for height, width in zip(heights, widths):
+        panel[H - height : H, col : col + width] = BAR_COLOR
+        col += width + 1
+    return panel
