+            c += dc
+            min_r = min(min_r, r)
+            max_r = max(max_r, r)
+            min_c = min(min_c, c)
+            max_c = max(max_c, c)
+            if 0 <= r < h and 0 <= c < w and (r, c) not in lap_by_cell:
