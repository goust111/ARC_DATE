+            grid[r0 : r1 + 1, c0 : c1 + 1] = color
+        if include_diagonals:
+            for r, c in pair["diag"]:
+                grid[r, c] = color
+
+
+def _empty_line_candidates(grid: np.ndarray, bg: int) -> tuple[list[int], list[int]]:
