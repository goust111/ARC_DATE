def _sample_input() -> np.ndarray:
    """Return a 3x3 grid with one uniformly sampled foreground marker."""
    inp = np.zeros((INPUT_SIZE, INPUT_SIZE), dtype=int)
    pos = random.randrange(INPUT_CELL_COUNT)
