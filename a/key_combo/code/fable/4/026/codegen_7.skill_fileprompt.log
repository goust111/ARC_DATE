+    cols = [c for c in range(1, grid.shape[1] - 1) if np.all(grid[1:-1, c] == bg)]
+    return rows, cols
+
+
+def _blocked_line_candidates(input_base: np.ndarray, connected: np.ndarray, bg: int) -> tuple[list[int], list[int]]:
