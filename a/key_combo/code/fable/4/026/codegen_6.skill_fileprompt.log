def _gen_projection_bbox(edge: str, h: int, w: int, distance: int, span: tuple[int, int]) -> BBox:
    s0, s1 = span
    if edge == "top":
        row = distance + 1
        return 1, s0, row, s1
    if edge == "bottom":
        row = h - 2 - distance
        return row, s0, h - 2, s1
    if edge == "left":
