+
+def _patch_is_degenerate(patch: np.ndarray, color_a: int, color_b: int) -> bool:
+    fg = patch[patch != BG]
+    if fg.size < 6 or len(set(map(int, fg.tolist()))) != 2:
+        return True
+    counts = Counter(map(int, fg.tolist()))
+    if min(counts.values()) < 2:
+        return True
