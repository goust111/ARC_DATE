def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*_GEN_GRID_ROWS)
    cols = random.randint(*_GEN_GRID_COLS)
    n_segments = random.randint(*_GEN_SEGMENT_COUNT)
