+            if not _bbox_in_strip(cur, bounds[strip_idx - 1], orient):
+                ok = False
+                break
+        if not ok:
+            continue
+
+        cur = bbox
+        for strip_idx in range(source_strip, len(bounds) - 1):
+            cur = _reflect_bbox(cur, separators[strip_idx], orient)
+            if not _bbox_in_strip(cur, bounds[strip_idx + 1], orient):
