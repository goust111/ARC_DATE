+        base_area = int(mask.sum())
+        lower = max(area_min, base_area)
+        if lower > area_max:
+            continue
+        target_area = random.randint(lower, area_max)
+        while int(mask.sum()) < target_area:
+            frontier = _mask_frontier(mask)
+            if not frontier:
