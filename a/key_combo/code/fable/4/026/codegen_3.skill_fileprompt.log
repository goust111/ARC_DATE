    r0, c0, r1, c1 = bbox
    grid[r0 : r1 + 1, c0 : c1 + 1] = color


def _gen_paint_wall(grid: np.ndarray, edge: str) -> None:
    if edge == "top":
        grid[0, :] = WALL_COLOR
    elif edge == "bottom":
        grid[-1, :] = WALL_COLOR
    elif edge == "left":
        grid[:, 0] = WALL_COLOR
    else:
        grid[:, -1] = WALL_COLOR


def _gen_draw_segment(grid: np.ndarray, edge: str, distance: int, span: tuple[int, int], color: int) -> None:
    s0, s1 = span
    h, w = grid.shape
    if edge == "top":
