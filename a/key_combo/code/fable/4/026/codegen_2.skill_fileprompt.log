+def _sample_sprite(size: int, cell_bg: int, sprite_colors: list[int]) -> np.ndarray | None:
+    target_area = random.randint(size + 1, min(size * size - 2, (size * size * 3) // 5))
+    mask = _grow_connected_mask(size, target_area)
