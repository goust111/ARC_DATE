+        obj_mask = np.zeros(grid_shape, dtype=bool)
+        obj_mask[coords[:, 0], coords[:, 1]] = True
+        ref_mask = np.zeros(grid_shape, dtype=bool)
+        ref_mask[reflected[:, 0], reflected[:, 1]] = True
