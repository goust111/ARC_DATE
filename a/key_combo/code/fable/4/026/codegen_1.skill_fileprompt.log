def _gen_connected_mask(h: int, w: int, count: int) -> np.ndarray:
    corners = [
        ((0, 0), (h - 1, w - 1)),
        ((0, w - 1), (h - 1, 0)),
        ((h - 1, 0), (0, w - 1)),
        ((h - 1, w - 1), (0, 0)),
    ]
    (r, c), (end_r, end_c) = random.choice(corners)
    dr = 1 if end_r > r else -1
    dc = 1 if end_c > c else -1
