+        "left": 1 if orient == "v" else 0,
+        "right": 1 if orient == "v" else 0,
+    }
+    for edge in ("top", "bottom", "left", "right"):
+        count = min_extra[edge] + random.randint(0, 2)
+        for _ in range(count):
