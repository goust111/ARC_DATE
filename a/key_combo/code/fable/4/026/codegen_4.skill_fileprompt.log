                    missing = rect & ~mask
                    extra = mask & ~rect
                    covered_missing = np.zeros_like(mask, dtype=bool)
                    covered_extra = np.zeros_like(mask, dtype=bool)
                    features: list[Feature] = []

                    try:
                        for side in SIDES:
