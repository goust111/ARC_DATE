+            for left_shift in (0, 1):
+                for right_shift in (0, 1):
+                    top = top_shift
+                    bottom = h - 1 - bottom_shift
+                    left = left_shift
+                    right = w - 1 - right_shift
+                    if top > bottom or left > right:
+                        continue
