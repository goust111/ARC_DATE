+
+
+def _build_output_coords(h: int, w: int, features: tuple[Feature, ...]) -> tuple[tuple[int, int], ...]:
+    top, left, bottom, right = 0, 0, h - 1, w - 1
+    for feature in features:
+        k = feature.length
+        if feature.side == "top":
+            bottom += k if feature.kind == "notch" else -k
+        elif feature.side == "bottom":
