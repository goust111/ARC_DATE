import random
from collections import Counter, deque
from dataclasses import dataclass

import numpy as np


DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
SIDES = ("top", "bottom", "left", "right")
HORIZONTAL_SIDES = {"top", "bottom"}
VERTICAL_SIDES = {"left", "right"}
PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
BACKGROUND = 0

GRID_SIZE_MAX = 30
OBJECT_GAP = 1
GEN_RETRIES = 400
SPEC_RETRIES = 120
BASE_HEIGHT_RANGE = (5, 9)
BASE_WIDTH_RANGE = (5, 9)
FEATURE_LENGTH_CAP = 4
BACKGROUND_FRACTION_MIN = 0.45


@dataclass(frozen=True)
class Feature:
    side: str
    kind: str
    start: int
    length: int


@dataclass(frozen=True)
class ObjectSpec:
    color: int
    features: tuple[Feature, ...]
    input_coords: tuple[tuple[int, int], ...]
    output_coords: tuple[tuple[int, int], ...]
    input_bbox: tuple[int, int, int, int]
    output_bbox: tuple[int, int, int, int]
    overall_bbox: tuple[int, int, int, int]


def get_bg(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])


def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def relative_bbox(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
    rows = [r for r, _c in coords]
    cols = [c for _r, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def union_bbox(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
) -> tuple[int, int, int, int]:
    return min(a[0], b[0]), min(a[1], b[1]), max(a[2], b[2]), max(a[3], b[3])


def translate_bbox(
    bbox: tuple[int, int, int, int], anchor: tuple[int, int]
) -> tuple[int, int, int, int]:
    r0, c0 = anchor
    return bbox[0] + r0, bbox[1] + c0, bbox[2] + r0, bbox[3] + c0


def bbox_area(bbox: tuple[int, int, int, int]) -> int:
    return (bbox[2] - bbox[0] + 1) * (bbox[3] - bbox[1] + 1)


def boxes_separated(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int
) -> bool:
    return (
        a[2] + gap < b[0]
        or b[2] + gap < a[0]
        or a[3] + gap < b[1]
        or b[3] + gap < a[1]
    )


def find_components(grid: np.ndarray, bg: int) -> list[dict]:
    h, w = map(int, grid.shape)
    visited = np.zeros((h, w), dtype=bool)
    components: list[dict] = []
    for r in range(h):
        for c in range(w):
            if visited[r, c] or int(grid[r, c]) == bg:
                continue
            color = int(grid[r, c])
            queue = deque([(r, c)])
            visited[r, c] = True
            cells: list[tuple[int, int]] = []
            while queue:
                rr, cc = queue.popleft()
                cells.append((rr, cc))
                for dr, dc in DIRS4:
                    nr, nc = rr + dr, cc + dc
                    if (
                        in_bounds((h, w), nr, nc)
                        and not visited[nr, nc]
                        and int(grid[nr, nc]) == color
                    ):
                        visited[nr, nc] = True
                        queue.append((nr, nc))
            coords = np.array(cells, dtype=int)
            components.append(
                {"color": color, "coords": coords, "bbox": bbox_from_coords(coords)}
            )
    return components


def _contiguous_span(line: np.ndarray) -> tuple[int, int] | None:
    idx = np.flatnonzero(line)
    if idx.size == 0:
        return None
    if int(idx[-1] - idx[0] + 1) != int(idx.size):
        raise ValueError("feature cells must form one contiguous segment")
    return int(idx[0]), int(idx.size)


def _extract_side_feature(
    diff: np.ndarray,
    side: str,
    top: int,
    bottom: int,
    left: int,
    right: int,
) -> tuple[int, int] | None:
    axis_len = right - left + 1 if side in HORIZONTAL_SIDES else bottom - top + 1
    if axis_len < 3:
        if side == "top":
            active = top > 0 and diff[top - 1, left : right + 1].any()
            active = active or diff[top, left : right + 1].any()
        elif side == "bottom":
            active = bottom + 1 < diff.shape[0] and diff[bottom + 1, left : right + 1].any()
            active = active or diff[bottom, left : right + 1].any()
        elif side == "left":
            active = left > 0 and diff[top : bottom + 1, left - 1].any()
            active = active or diff[top : bottom + 1, left].any()
        else:
            active = right + 1 < diff.shape[1] and diff[top : bottom + 1, right + 1].any()
            active = active or diff[top : bottom + 1, right].any()
        if active:
            raise ValueError("feature cannot touch rectangle corners")
        return None

    if side == "top":
        line = diff[top, left : right + 1]
    elif side == "bottom":
        line = diff[bottom, left : right + 1]
    elif side == "left":
        line = diff[top : bottom + 1, left]
    else:
        line = diff[top : bottom + 1, right]

    span = _contiguous_span(line)
    if span is None:
        return None
    start, length = span
    if start == 0 or start + length == axis_len:
        raise ValueError("feature segment must lie on the middle part of a side")
    return start, length


