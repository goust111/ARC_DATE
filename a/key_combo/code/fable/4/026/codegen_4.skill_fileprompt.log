+    random.shuffle(kinds)
+    colors = random.sample(PALETTE, n_objects)
+
+    specs: list[ObjectSpec] = []
+    offset = 0
+    for color, count in zip(colors, counts):
+        spec = _make_spec(color, kinds[offset : offset + count])
+        if spec is None:
+            return None
+        specs.append(spec)
