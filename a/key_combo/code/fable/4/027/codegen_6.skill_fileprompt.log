+def _fits_with_padding(
+    occupied: np.ndarray,
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+    *,
+    pad: int = 1,
+) -> bool:
+    h_grid, w_grid = occupied.shape
+    if r0 < 1 or c0 < 1 or r0 + h > h_grid - 1 or c0 + w > w_grid - 1:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h_grid, r0 + h + pad)
+    cc1 = min(w_grid, c0 + w + pad)
+    return not bool(occupied[rr0:rr1, cc0:cc1].any())
