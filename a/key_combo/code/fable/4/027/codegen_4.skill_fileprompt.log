+    coord_to_comp: dict[int, dict[tuple[int, int], int]] = {}
+    for color in sorted(int(x) for x in np.unique(grid) if int(x) != bg):
+        comps = []
+        mapping: dict[tuple[int, int], int] = {}
+        for idx, comp in enumerate(_components(grid == color)):
+            for cell in comp:
