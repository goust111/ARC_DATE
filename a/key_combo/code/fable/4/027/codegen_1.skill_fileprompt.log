+    runs: list[tuple[int, int]] = []
+    start = prev = int(values[0])
+    for value in values[1:]:
+        value = int(value)
+        if value == prev + 1:
+            prev = value
+            continue
+        runs.append((start, prev))
+        start = prev = value
+    runs.append((start, prev))
+    return runs
