+def _render_histogram(order: list[int], bars: dict[int, dict]) -> np.ndarray:
+    max_len = max(int(bars[color]["length"]) for color in order)
+    out = np.zeros((len(order), max_len), dtype=int)
+    for row, color in enumerate(order):
