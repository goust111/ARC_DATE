+def _global_cells(mask: np.ndarray, r0: int, c0: int) -> list[tuple[int, int]]:
+    cells = np.argwhere(mask)
+    return [(int(r0 + r), int(c0 + c)) for r, c in cells]
+
+
+def _can_place(mask: np.ndarray, occupied: np.ndarray, r0: int, c0: int) -> bool:
