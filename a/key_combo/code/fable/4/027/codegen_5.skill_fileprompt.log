+def _place_on_row(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    mask: np.ndarray,
+    rect: tuple[int, int, int, int],
+    target_row: int,
+    side: str,
+) -> dict:
+    H, W = grid.shape
+    h, w = mask.shape
+    rect_r0, rect_c0, rect_r1, rect_c1 = rect
+    assert rect_r0 <= target_row <= rect_r1
