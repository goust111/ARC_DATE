    ar, ac, ah, aw = rect_a
    br, bc, bh, bw = rect_b
    ar1, ac1 = ar + ah - 1, ac + aw - 1
    br1, bc1 = br + bh - 1, bc + bw - 1
    row_gap = ar1 + MIN_EMPTY_GAP < br or br1 + MIN_EMPTY_GAP < ar
    col_gap = ac1 + MIN_EMPTY_GAP < bc or bc1 + MIN_EMPTY_GAP < ac
    return row_gap or col_gap


