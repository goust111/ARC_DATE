SIZE_WEIGHTS_BY_TOTAL = ((7, [2, 3, 3, 2]), (9, [3, 3, 2, 1]), (None, [4, 4, 2, 1]))
MIN_PLACEMENT_SIZE = 2
PLACEMENT_PADDING, PLACEMENT_PADDING_CONNECTIVITY = 1, 8
PLACEMENT_KWARGS = dict(
