MOTIF_PIXEL_RANGE = (4, 9)
MOTIF_SIDE_INSET, MOTIF_AXIS_MARGIN = 3, 2
SYMMETRIC_PAIR_MIN_OFFSET = 1

# Rejection sampling limit.
