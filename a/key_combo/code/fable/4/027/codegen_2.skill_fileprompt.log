V_FRAME_HEIGHTS, V_FRAME_WIDTHS = (10, 12), (7, 9, 11)
H_FRAME_HEIGHTS, H_FRAME_WIDTHS = (7, 9), (10, 11)
CAP_HALF_SPAN, BAR_OFFSET, WALL_INSET = 1, 1, 2

# Motif counts and safe interior positions.
