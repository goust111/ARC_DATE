+        seen.add(orbit)
+        (r1, c1), (r2, c2) = orbit
+        if min(r1, r2, c1, c2) == 0 or max(r1, r2) == h - 1 or max(c1, c2) == w - 1:
+            continue
+        out.append((orbit[0], orbit[1]))
+    return out
+
+
+def _choose_missing_cells(rng: np.random.Generator, mask: np.ndarray) -> list[tuple[int, int]] | None:
+    orbits = _candidate_orbits(mask)
+    if len(orbits) < 2:
