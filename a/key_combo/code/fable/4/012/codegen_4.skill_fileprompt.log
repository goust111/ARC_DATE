+        mask = _crop_mask(mask)
+        if min(mask.shape) < 2 or int(mask.sum()) < min_area or not _is_connected(mask):
+            continue
+        got_lr = bool(np.array_equal(mask, np.fliplr(mask)))
+        got_ud = bool(np.array_equal(mask, np.flipud(mask)))
