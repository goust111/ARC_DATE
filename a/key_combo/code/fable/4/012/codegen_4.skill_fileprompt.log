+
+def _canonical_domain(h: int, w: int, *, sym_lr: bool, sym_ud: bool) -> list[Coord]:
+    row_stop = (h + 1) // 2 if sym_ud else h
+    col_stop = (w + 1) // 2 if sym_lr else w
+    return [(r, c) for r in range(row_stop) for c in range(col_stop)]
