    assert rhi - rlo > 1 and chi - clo > 1, "marked rectangle must have a nonempty interior"

    out = np.full_like(g, bg)
    out[[rlo, rhi], :] = marker
    out[:, [clo, chi]] = marker
    out[rlo + 1 : rhi, clo + 1 : chi] = Color.BLUE
    return out

