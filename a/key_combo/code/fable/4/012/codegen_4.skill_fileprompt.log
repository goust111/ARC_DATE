+def _seed_cell(h: int, w: int, *, sym_lr: bool, sym_ud: bool) -> Coord:
+    r = (h - 1) // 2 if sym_ud else random.randrange(h)
+    c = (w - 1) // 2 if sym_lr else random.randrange(w)
