+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors8(r, c, (h, w)):
+            if not mask[rr, cc] or (rr, cc) in seen:
+                continue
+            seen.add((rr, cc))
+            q.append((rr, cc))
+    return len(seen) == int(mask.sum())
+
