+_SHADOW_COLOR = 5
+_MAX_ATTEMPTS = 400
+_OFFSET_CHOICES = [(dr, dc) for dr in (-2, -1, 0, 1, 2) for dc in (-2, -1, 0, 1, 2) if (dr, dc) != (0, 0)]
