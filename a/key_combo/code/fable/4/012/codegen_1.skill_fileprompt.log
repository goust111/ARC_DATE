+    body_region = body_mask[r0 : r1 + 1, c0 : c1 + 1]
+    shadow_region = shadow_mask[r0 : r1 + 1, c0 : c1 + 1]
+
+    comp_local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    comp_local[coords[:, 0] - r0, coords[:, 1] - c0] = True
