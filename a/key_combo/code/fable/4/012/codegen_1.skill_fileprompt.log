+    score = (support_count, int(explained_shadow.sum()), int(missing_body.sum()))
+    return score, missing_body
+
+
+def _infer_repair(grid: np.ndarray) -> tuple[int, np.ndarray]:
+    bg = _get_bg(grid)
+    colors = _colors_present(grid, exclude={bg})
