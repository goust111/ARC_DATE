+    if not np.array_equal(produced, expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid orphan-shadow input")

