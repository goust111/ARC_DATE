+    row_period, col_period = tile.shape
+    row_offset, col_offset = offset
+    rows = (np.arange(h)[:, None] - int(row_offset)) % row_period
+    cols = (np.arange(w)[None, :] - int(col_offset)) % col_period
+    return tile[rows, cols]
