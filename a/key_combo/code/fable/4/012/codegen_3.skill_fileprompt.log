+    cols = np.arange(mask.shape[1])[None, :] % col_period
+    for rr in range(row_period):
+        for cc in range(col_period):
+            visible = ((rows == rr) & (cols == cc) & (~mask)).any()
+            if not bool(visible):
+                return False
+    return True
+
