+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input: failed after {_MAX_ATTEMPTS} attempts")

