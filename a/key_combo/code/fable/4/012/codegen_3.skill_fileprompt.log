def bbox(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return None
    r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def components(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    comps=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            stack=[(r,c)]; seen[r,c]=True; comp=[]
            while stack:
                rr,cc=stack.pop(); comp.append((rr,cc))
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; stack.append((nr,nc))
            comps.append(comp)
    return comps

def primitive_period(tile):
    h,w=tile.shape
    def row_ok(rp):
        return all(np.array_equal(tile[r], tile[r%rp]) for r in range(h))
    def col_ok(cp):
        return all(np.array_equal(tile[:,c], tile[:,c%cp]) for c in range(w))
    rp=next(r for r in range(1,h+1) if row_ok(r))
    cp=next(c for c in range(1,w+1) if col_ok(c))
    return rp,cp

def infer(grid):
    H,W=grid.shape
    def build(rp,cp):
        tile=np.zeros((rp,cp),dtype=int)
        for rr in range(rp):
            for cc in range(cp):
                vals=grid[rr::rp,cc::cp].ravel().tolist()
                tile[rr,cc]=Counter(vals).most_common(1)[0][0]
        pred=np.empty_like(grid)
        for r in range(H):
            for c in range(W):
                pred[r,c]=tile[r%rp,c%cp]
        return tile,pred
    cands=[]
    for area in range(1,H*W+1):
        pass
    for rp in range(1,H+1):
        for cp in range(1,W+1):
            tile,pred=build(rp,cp)
            mism=pred"'!=grid
            comps=components(mism)
            if len(comps)!=1:
                continue
            if mism.sum()==0:
                continue
            cands.append((rp*cp,mism.sum(),rp,cp,tile,pred))
    cands.sort()
    if not cands:
        return None
    return cands[0][2],cands[0][3],cands[0][5]

def rand_connected(h,w,n):
    start=(random.randrange(h),random.randrange(w))
    cells={start}
    frontier=[start]
    while len(cells)<n:
