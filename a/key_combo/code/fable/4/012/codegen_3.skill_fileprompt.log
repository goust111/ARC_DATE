+    h, w = tile.shape
+    row_period = h
+    for candidate in range(1, h + 1):
+        ok = True
+        for r in range(h):
+            if not np.array_equal(tile[r], tile[r % candidate]):
+                ok = False
+                break
+        if ok:
+            row_period = candidate
+            break
+
+    col_period = w
+    for candidate in range(1, w + 1):
+        ok = True
+        for c in range(w):
+            if not np.array_equal(tile[:, c], tile[:, c % candidate]):
