        opts=[p for p in opts if 0<=p[0]<h and 0<=p[1]<w and p not in cells]
        if not opts:
            continue
        cells.add(random.choice(opts))
    mask=np.zeros((h,w),dtype=bool)
    for r,c in cells: mask[r,c]=True
    return mask

