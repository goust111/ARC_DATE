+    return cropped
+
+
+def _gen_tile(row_period: int, col_period: int, palette: list[int]) -> np.ndarray | None:
+    for _ in range(200):
+        tile = np.array(
+            [[random.choice(palette) for _ in range(col_period)] for _ in range(row_period)],
