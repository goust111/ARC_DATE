+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    submask = mask[r0 : r1 + 1, c0 : c1 + 1]
+    subgrid = grid[r0 : r1 + 1, c0 : c1 + 1]
+    out[submask] = subgrid[submask]
+    return out
