    # Round-trip check
    if not np.array_equal(main(inp), out):
        return None

    return inp#.tolist()


def generate_input():
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("generate_input: failed after 300 attempts")

