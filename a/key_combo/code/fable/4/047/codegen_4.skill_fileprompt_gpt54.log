from arc_utils import bbox_h, bbox_w, find_components, get_bg, paste
import random


def _frame_interior_area(g: np.ndarray, bg: int, obj: dict) -> tuple[int, int]:
    color = int(obj["color"])
    r0, c0, r1, c1 = obj["bbox"]
    height = bbox_h(obj["bbox"])
    width = bbox_w(obj["bbox"])
    assert height >= 3 and width >= 3, "expected a frame with a nonempty interior"

    sub = g[r0 : r1 + 1, c0 : c1 + 1]
    border = np.zeros((height, width), dtype=bool)
    border[0, :] = True
    border[-1, :] = True
    border[:, 0] = True
    border[:, -1] = True

    assert np.all(sub[border] == color), "expected a complete monochrome frame border"
    assert np.all(sub[~border] == bg), "expected frame interior to be background"
    assert int(obj["area"]) == int(border.sum()), "expected a one-cell-thick rectangular frame"

    return int((height - 2) * (width - 2)), color


def main(grid: np.ndarray) -> np.ndarray:
    """
    Output a 2x2 block colored like the hollow rectangular frame with the largest interior.

    Input structure
    - The background is the most common color.
    - The foreground consists of exactly two 4-connected monochrome hollow rectangular frames.
    - Each frame is one cell thick and has a background-colored interior.

    Rule
    - Measure each frame by the area strictly inside its border.
    - Select the unique frame with the largest interior area.
    - Return a 2x2 grid filled with that frame's color.

    Key insight
    - The task compares the size of the empty regions enclosed by the frames; the
      output is only the winning frame color, normalized to a small solid block.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert min(g.shape) > 0, "expected a nonempty grid"

    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert len(objects) == 2, "expected exactly two foreground frames"

    frames = [_frame_interior_area(g, bg, obj) for obj in objects]
    largest_area = max(area for area, _color in frames)
    largest = [(area, color) for area, color in frames if area == largest_area]
    assert len(largest) == 1, "expected a unique largest frame interior"

    _area, color = largest[0]
    return np.full((2, 2), color, dtype=int)

# --------------- generator (o5x) ---------------

# Canvas and color bounds.
GRID_SIZE, BACKGROUND_COLOR, OUTPUT_SIZE = 10, 0, 2
NONZERO_COLORS = range(1, 10)

# Frame size and separation constraints.
FRAME_MIN_SIZE, FRAME_MAX_SIZE = 3, GRID_SIZE
FRAME_DIMENSIONS = range(FRAME_MIN_SIZE, FRAME_MAX_SIZE + 1)
MIN_FRAME_GAP = 1
MAX_FRAME_PAIR_SPAN = GRID_SIZE - MIN_FRAME_GAP

# Layout choices and retry budget.
SIDE_BY_SIDE, STACKED = "side_by_side", "stacked"
LAYOUTS = (SIDE_BY_SIDE, STACKED)
GENERATION_RETRIES = 300


def _gen_interior_area(h: int, w: int) -> int:
    return (h - 2) * (w - 2)


def _gen_dimension_candidates(layout: str) -> list[tuple[tuple[int, int], tuple[int, int]]]:
    candidates = []
    for h1 in FRAME_DIMENSIONS:
        for w1 in FRAME_DIMENSIONS:
            for h2 in FRAME_DIMENSIONS:
                for w2 in FRAME_DIMENSIONS:
                    span = w1 + w2 if layout == SIDE_BY_SIDE else h1 + h2
                    if span <= MAX_FRAME_PAIR_SPAN and _gen_interior_area(h1, w1) != _gen_interior_area(h2, w2):
                        candidates.append(((h1, w1), (h2, w2)))
    return candidates


DIMENSION_CANDIDATES = {layout: _gen_dimension_candidates(layout) for layout in LAYOUTS}


def _gen_frame_patch(h: int, w: int, color: int) -> np.ndarray:
    patch = np.zeros((h, w), dtype=int)
    patch[[0, -1], :] = color
    patch[:, [0, -1]] = color
    return patch


def _gen_choose_frames() -> tuple[list[dict], str]:
    layout = random.choice(LAYOUTS)
    colors = random.sample(NONZERO_COLORS, 2)
    (h1, w1), (h2, w2) = random.choice(DIMENSION_CANDIDATES[layout])
    frames = [
        {"h": h1, "w": w1, "color": colors[0], "area": _gen_interior_area(h1, w1)},
        {"h": h2, "w": w2, "color": colors[1], "area": _gen_interior_area(h2, w2)},
    ]
    random.shuffle(frames)
    return frames, layout


def _gen_place_frames(grid: np.ndarray, frames: list[dict], layout: str) -> None:
    first, second = frames
    if layout == SIDE_BY_SIDE:
        gap = random.randint(MIN_FRAME_GAP, GRID_SIZE - first["w"] - second["w"])
        c0 = random.randint(0, GRID_SIZE - first["w"] - gap - second["w"])
        first["r"] = random.randint(0, GRID_SIZE - first["h"])
        first["c"] = c0
        second["r"] = random.randint(0, GRID_SIZE - second["h"])
        second["c"] = c0 + first["w"] + gap
    else:
        gap = random.randint(MIN_FRAME_GAP, GRID_SIZE - first["h"] - second["h"])
        r0 = random.randint(0, GRID_SIZE - first["h"] - gap - second["h"])
        first["r"] = r0
        first["c"] = random.randint(0, GRID_SIZE - first["w"])
        second["r"] = r0 + first["h"] + gap
        second["c"] = random.randint(0, GRID_SIZE - second["w"])

    for frame in frames:
        patch = _gen_frame_patch(frame["h"], frame["w"], frame["color"])
        paste(grid, patch, frame["r"], frame["c"], transparent=BACKGROUND_COLOR)


def _gen_attempt() -> np.ndarray | None:
    grid = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
    frames, layout = _gen_choose_frames()
    _gen_place_frames(grid, frames, layout)

    winner = max(frames, key=lambda frame: frame["area"])
    expected = np.full((OUTPUT_SIZE, OUTPUT_SIZE), winner["color"], dtype=int)
    try:
        actual = main(grid)
    except AssertionError:
        return None
    if np.array_equal(actual, expected):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input for 445eab21")
import numpy as np

from arc_utils import find_components, get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill each colored outline by painting the horizontal row spans enclosed by its paired boundary pixels.

    Input structure
    - The grid has a dominant background and one or more monochromatic 8-connected foreground outlines.
    - Each outline has exactly two pixels on every row it occupies; those pixels are the left and right boundary of that row.

    Rule
    - For each foreground outline, process only the rows touched by that outline.
    - On each touched row, recolor the whole interval between the two boundary pixels to the outline color.
    - Keep all other pixels unchanged.

    Key insight
    - The sparse diagonal sides already mark the row-by-row horizontal fill limits of the solid shape.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
    assert objects, "expected at least one foreground outline"

    out = g.copy()
    for obj in objects:
        color = int(obj["color"])
        coords = obj["coords"]
        rows = sorted({int(r) for r in coords[:, 0]})
        assert rows, "expected each object to occupy at least one row"

        for r in rows:
            row_cols = coords[coords[:, 0] == r, 1]
            assert row_cols.size == 2, "expected exactly two boundary pixels per occupied row"
            c0 = int(row_cols.min())
            c1 = int(row_cols.max())

            span = g[r, c0 : c1 + 1]
            assert np.all((span == bg) | (span == color)), "row span must contain only background and the outline color"
            out[r, c0 : c1 + 1] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas, palette, sampling bounds, and retry limit.
CANVAS_SIZE = 10
BACKGROUND = 0
COLOR_RANGE = range(1, 10)
OUTLINE_COUNT_BOUNDS = (1, 3)
HEIGHT_BOUNDS = (3, 5)
GENERATION_ATTEMPTS = 300

def _gen_outline_cells(r0, c0, height):
    """Return boundary cells and filled row spans for one V outline."""
    width = 2 * (height - 1)
    boundary = []
    filled = []
    for k in range(height):
        side_k = min(k, height - 2)
        r = r0 + k
        c_left = c0 + side_k
        c_right = c0 + width - 1 - side_k
        boundary.append((r, c_left))
        boundary.append((r, c_right))
        for c in range(c_left, c_right + 1):
            filled.append((r, c))
    return boundary, filled

def _gen_valid_positions(height, used_filled):
    """Return shuffled placements whose filled spans do not overlap used cells."""
    width = 2 * (height - 1)
    positions = []
    for r0 in range(CANVAS_SIZE + 1 - height):
        for c0 in range(CANVAS_SIZE + 1 - width):
            boundary, filled = _gen_outline_cells(r0, c0, height)
            if all(not used_filled[r, c] for r, c in filled):
                positions.append((r0, c0, boundary, filled))
    random.shuffle(positions)
    return positions

def _place_outlines(heights, order):
    """Backtrack over shuffled valid positions; return placements or None."""
    placements = [None] * len(heights)
    used_filled = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)

    def place_from(pos):
        if pos == len(order):
            return True

        idx = order[pos]
        for r0, c0, boundary, filled in _gen_valid_positions(heights[idx], used_filled):
            for r, c in filled:
                used_filled[r, c] = True
            placements[idx] = (r0, c0, boundary, filled)

            if place_from(pos + 1):
                return True

            placements[idx] = None
            for r, c in filled:
                used_filled[r, c] = False

        return False

    return placements if place_from(0) else None

def _render_grids(colors, placements):
    """Render sparse input and its filled oracle target."""
    inp = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
    expected = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
    for color, placement in zip(colors, placements):
        _, _, boundary, filled = placement
        for r, c in boundary:
            inp[r, c] = color
        for r, c in filled:
            expected[r, c] = color
    return inp, expected

def _gen_attempt():
    n_outlines = random.randint(*OUTLINE_COUNT_BOUNDS)
    colors = random.sample(COLOR_RANGE, n_outlines)
    heights = [random.randint(*HEIGHT_BOUNDS) for _ in range(n_outlines)]
    order = list(range(n_outlines))
    random.shuffle(order)

    placements = _place_outlines(heights, order)
    if placements is None:
        return None

    inp, expected = _render_grids(colors, placements)
    try:
        actual = main(inp)
    except AssertionError:
        return None

    if not np.array_equal(actual, expected):
        return None
    return inp

def generate_input():
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 22168020 input")

