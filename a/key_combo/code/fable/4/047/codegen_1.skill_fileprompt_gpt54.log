    inp = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
    expected = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
    for color, placement in zip(colors, placements):
        _, _, boundary, filled = placement
        for r, c in boundary:
            inp[r, c] = color
        for r, c in filled:
            expected[r, c] = color
    return inp, expected

def _gen_attempt():
