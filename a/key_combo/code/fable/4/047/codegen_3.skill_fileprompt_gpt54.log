# Canvas and object size bounds.
GRID_SIZE_RANGE = (8, 16)
OBJECT_HEIGHT_RANGE = (3, 5)
RECT_WIDTH_RANGE = (4, 7)
LEFT_PATCH_CANVAS_PAD = 3

# Layout and shape constraints.
ROW_GAP_MIN = 1
MIN_ROW_WIDTH = 1
SOURCE_RIGHT_PAD = 2
DST_WIDTH_RESERVED_COLS = 1

# Sampling controls.
PALETTE_COLORS = tuple(range(10))
NONSPLIT_ABOVE_CHOICES = (True, False)
MAX_GENERATION_ATTEMPTS = 300


def _gen_symmetric_widths(height: int, width: int, *, min_width: int = MIN_ROW_WIDTH,
                          varied: bool = False, include_max: bool = False) -> list[int]:
    """Sample row widths and mirror them vertically."""
    half = (height + 1) // 2
    vals = [random.randint(min_width, width) for _ in range(half)]
    if include_max:
        vals[random.randrange(half)] = width
    if varied and width > min_width and len(set(vals + vals[: height // 2][::-1])) == 1:
        j = random.randrange(half)
        vals[j] = min(width, vals[j] + 1) if vals[j] < width else vals[j] - 1
    return vals + vals[: height // 2][::-1]


def _right_anchored_mask(widths: list[int], patch_width: int) -> np.ndarray:
    """Return a mask whose true cells fill each row from the right edge."""
    row_widths = np.asarray(widths, dtype=int)[:, None]
    cols = np.arange(patch_width)[None, :]
    return cols >= patch_width - row_widths


def _gen_right_shape_with_max_width(height: int, patch_width: int, max_row_width: int,
                                    color: int, bg: int) -> np.ndarray:
    patch = np.full((height, patch_width), bg, dtype=int)
    widths = _gen_symmetric_widths(height, max_row_width, varied=True, include_max=True)
    patch[_right_anchored_mask(widths, patch_width)] = color
    return patch


def _gen_pick_layout(n: int) -> tuple[int, int, int, int, int] | None:
    h_min, h_max = OBJECT_HEIGHT_RANGE
    pairs = [
        (rh, nh)
        for rh in range(h_min, h_max + 1)
        for nh in range(h_min, h_max + 1)
        if rh + nh + ROW_GAP_MIN <= n
    ]
    if not pairs:
        return None
    rect_h, nonsplit_h = random.choice(pairs)
    min_w, max_w = RECT_WIDTH_RANGE[0], min(RECT_WIDTH_RANGE[1], n - LEFT_PATCH_CANVAS_PAD)
    if max_w < min_w:
        return None
    rect_w = random.randint(min_w, max_w)

    place_nonsplit_above = random.choice(NONSPLIT_ABOVE_CHOICES)
    if place_nonsplit_above:
        max_rect_top = n - rect_h
        min_rect_top = nonsplit_h + ROW_GAP_MIN
        if min_rect_top > max_rect_top:
            return None
        rect_top = random.randint(min_rect_top, max_rect_top)
        nonsplit_top = random.randint(0, rect_top - nonsplit_h - ROW_GAP_MIN)
    else:
        max_rect_top = n - rect_h - nonsplit_h - ROW_GAP_MIN
        if max_rect_top < 0:
            return None
        rect_top = random.randint(0, max_rect_top)
        nonsplit_top = random.randint(rect_top + rect_h + ROW_GAP_MIN, n - nonsplit_h)
    return rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top


def _gen_split_patches(rect_h: int, rect_w: int, min_dst_width: int,
                       split_color: int, bg: int) -> tuple[np.ndarray, np.ndarray, list[int]]:
    dst_widths = _gen_symmetric_widths(rect_h, rect_w - 1, min_width=min_dst_width, varied=True)
    dst = np.full((rect_h, rect_w), bg, dtype=int)
    src = np.full((rect_h, rect_w), bg, dtype=int)
    dst_mask = _right_anchored_mask(dst_widths, rect_w)
    dst[dst_mask] = split_color
    src[~dst_mask] = split_color
    return dst, src, dst_widths


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(*GRID_SIZE_RANGE)
    layout = _gen_pick_layout(n)
    if layout is None:
        return None
    rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top = layout

    colors = list(PALETTE_COLORS)
    bg = random.choice(colors)
    colors.remove(bg)
    split_color, nonsplit_color = random.sample(colors, 2)
    min_dst_width = max(MIN_ROW_WIDTH, 2 * rect_w - n + SOURCE_RIGHT_PAD)
    if min_dst_width > rect_w - DST_WIDTH_RESERVED_COLS:
        return None

    dst, src, dst_widths = _gen_split_patches(rect_h, rect_w, min_dst_width, split_color, bg)
    nonsplit = _gen_right_shape_with_max_width(
        nonsplit_h,
        rect_w,
        max(dst_widths),
        nonsplit_color,
        bg,
    )
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import get_bg
import itertools
import random
from arc_utils import is_contiguous, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Reorder 5×5 blocks into a connected strip by matching edge foreground pixels.

    Input structure:
    - bg = background; sep = divider color (full row/column lines).
    - Several 5×5 sprite blocks in a grid, separated by sep lines.

    Rule:
    - Two blocks "connect" when their facing edges share foreground pixels at the same offset (e.g., A's right edge ∩ B's left edge).
    - Chain all blocks in the orientation (horizontal or vertical) that admits a complete sequence.
    - Output is a 1×N strip of blocks in chain order, separated by sep lines.

    Key insight: Edge-contact overlap determines both block ordering and output orientation.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    def _most_common(a: np.ndarray) -> int:
        return int(Counter(map(int, a.flatten())).most_common(1)[0][0])

    def _find_sep(a: np.ndarray) -> int:
        H, W = a.shape
        cand: list[int] = []
        for r in range(H):
            if bool((a[int(r), :] == int(a[int(r), 0])).all()) and int(a[int(r), 0]) != int(bg):
                cand.append(int(a[int(r), 0]))
        for c in range(W):
            if bool((a[:, int(c)] == int(a[0, int(c)])).all()) and int(a[0, int(c)]) != int(bg):
                cand.append(int(a[0, int(c)]))
        return int(Counter(cand).most_common(1)[0][0])

    sep = _find_sep(g)

    def _full_sep_rows(a: np.ndarray) -> list[int]:
        return [int(r) for r in range(int(a.shape[0])) if bool((a[int(r), :] == int(sep)).all())]

    def _full_sep_cols(a: np.ndarray) -> list[int]:
        return [int(c) for c in range(int(a.shape[1])) if bool((a[:, int(c)] == int(sep)).all())]

    def _split_by_rows(a: np.ndarray) -> list[np.ndarray]:
        rows = _full_sep_rows(a)
        segs: list[np.ndarray] = []
        start = 0
        for r in rows + [int(a.shape[0])]:
            if int(r) > int(start):
                segs.append(a[int(start) : int(r), :].copy())
            start = int(r + 1)
        return segs

    def _split_by_cols(a: np.ndarray) -> list[np.ndarray]:
        cols = _full_sep_cols(a)
        segs: list[np.ndarray] = []
        start = 0
        for c in cols + [int(a.shape[1])]:
            if int(c) > int(start):
                segs.append(a[:, int(start) : int(c)].copy())
            start = int(c + 1)
        return segs

    def _render_strip(blocks: list[np.ndarray], axis: int) -> np.ndarray:
        # axis=0: vertical stack (sep rows), axis=1: horizontal stack (sep cols)
        n = int(len(blocks))
        if int(axis) == 0:
            out = np.full((int(n * 5 + (n - 1)), 5), int(bg), dtype=int)
            rr = 0
            for i, b in enumerate(blocks):
                out[int(rr) : int(rr + 5), :] = b
                rr += 5
                if int(i) < int(n - 1):
                    out[int(rr), :] = int(sep)
                    rr += 1
            return out
        out = np.full((5, int(n * 5 + (n - 1))), int(bg), dtype=int)
        cc = 0
        for i, b in enumerate(blocks):
            out[:, int(cc) : int(cc + 5)] = b
            cc += 5
            if int(i) < int(n - 1):
                out[:, int(cc)] = int(sep)
                cc += 1
        return out

    def _split_blocks() -> list[np.ndarray]:
        """Return list of 5x5 blocks (order doesn't matter; we will match by connect)."""
        rows = _full_sep_rows(g)
        cols = _full_sep_cols(g)
        if rows and cols:
            r = int(rows[0])
            c = int(cols[0])
            return [
                g[:r, :c],
                g[:r, int(c + 1) :],
                g[int(r + 1) :, :c],
                g[int(r + 1) :, int(c + 1) :],
            ]
        if rows:
            return _split_by_rows(g)
        if cols:
            return _split_by_cols(g)
        return []

    def _contacts(block: np.ndarray) -> dict[str, set[int]]:
        """Edge contact sets (offsets) for the block's foreground."""
        bbg = int(_most_common(block))
        m = block != int(bbg)
        top = set(np.where(m[0, :])[0].tolist())
        bot = set(np.where(m[-1, :])[0].tolist())
        left = set(np.where(m[:, 0])[0].tolist())
        right = set(np.where(m[:, -1])[0].tolist())
        return {"top": top, "bot": bot, "left": left, "right": right}

    def _find_chain(blocks: list[np.ndarray], orient: str):
        """Find an ordering p of indices such that consecutive blocks connect in orient."""
        import itertools

        cont = [_contacts(b) for b in blocks]

        def ok(a: int, b: int) -> bool:
            if orient == "h":
                return len(cont[int(a)]["right"] & cont[int(b)]["left"]) > 0
            return len(cont[int(a)]["bot"] & cont[int(b)]["top"]) > 0

        idx = list(range(int(len(blocks))))
        for perm in itertools.permutations(idx):
            if all(ok(perm[i], perm[i + 1]) for i in range(len(idx) - 1)):
                return perm
        return None

    blocks = _split_blocks()
    assert not (not blocks)

    chain_h = _find_chain(blocks, "h")
    chain_v = _find_chain(blocks, "v")

    if chain_h is not None and chain_v is None:
        ordered = [blocks[i] for i in chain_h]
        return _render_strip(ordered, axis=1)
    if chain_v is not None and chain_h is None:
        ordered = [blocks[i] for i in chain_v]
        return _render_strip(ordered, axis=0)
    assert not (chain_h is not None and chain_v is not None), "ambiguous: both H and V chains found"
    assert chain_h is not None or chain_v is not None, "must find at least one valid chain"

