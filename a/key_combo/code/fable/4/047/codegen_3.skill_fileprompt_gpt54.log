+            continue
+        if not np.any(rect == BACKGROUND):
+            continue
+        if np.any(np.sum(rect != BACKGROUND, axis=1) < 2):
+            continue
+        if np.any(np.sum(rect != BACKGROUND, axis=0) < 2):
+            continue
