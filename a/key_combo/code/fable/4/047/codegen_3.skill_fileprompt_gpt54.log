+    penalty = 0
+    if not np.any(rect[0] != BACKGROUND):
+        penalty += 1
+    if not np.any(rect[-1] != BACKGROUND):
+        penalty += 1
+    if not np.any(rect[:, 0] != BACKGROUND):
+        penalty += 1
+    if not np.any(rect[:, -1] != BACKGROUND):
+        penalty += 1
+    return penalty
+
+
+def _nonempty_rows(grid: np.ndarray) -> np.ndarray:
+    return np.flatnonzero(np.any(grid != BACKGROUND, axis=1))
+
+
