+        score = (
+            changes,
+            _border_black_penalty(repaired),
+            repaired.shape[0] * repaired.shape[1],
+        )
+        if best is None or score < best[0]:
+            best = (score, repaired)
+
+    assert best is not None
+    return best[1]
+
