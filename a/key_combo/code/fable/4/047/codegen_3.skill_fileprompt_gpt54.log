# Canvas and palette bounds.
GRID_HEIGHT_BOUNDS = (9, 10)
GRID_WIDTH_BOUNDS = (9, 10)
BACKGROUND_COLOR = 7
WALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
# Object counts and pixel budgets.
COMPONENT_COUNT_BOUNDS = (2, 3)
INNER_FOREGROUND_BOUNDS = (15, 23)
SPRITE_PIXEL_BOUNDS = (1, 7)
# Sprite geometry limits.
SPRITE_HEIGHT_BOUNDS = (1, 5)
SPRITE_WIDTH_BOUNDS = (1, 3)
MIN_SPRITE_DENSITY = 0.56
# Input scatter and retry limits.
SCATTER_OFFSET_BOUNDS = (1, 5)
GENERATION_ATTEMPTS = 300

Placement = tuple[int, np.ndarray, int, int, bool]


def _gen_bounded_composition(total: int, parts: int, lo: int, hi: int) -> list[int]:
    values = []
    remaining = int(total)
    for i in range(int(parts)):
        slots = int(parts) - i - 1
        low = max(int(lo), remaining - int(hi) * slots)
        high = min(int(hi), remaining - int(lo) * slots)
        value = random.randint(low, high)
        values.append(value)
        remaining -= value
    random.shuffle(values)
    return values


def _gen_sprite_mask(size: int) -> np.ndarray:
    size = int(size)
    dims = [
        (h, w)
        for h in range(SPRITE_HEIGHT_BOUNDS[0], SPRITE_HEIGHT_BOUNDS[1] + 1)
        for w in range(SPRITE_WIDTH_BOUNDS[0], SPRITE_WIDTH_BOUNDS[1] + 1)
        if max(h, w) <= size <= h * w and size / (h * w) >= MIN_SPRITE_DENSITY
    ]
    h, w = random.choice(dims)

    coords: set[tuple[int, int]] = set()
    length = max(h, w)
    if length == 1:
        coords.add((0, 0))
    else:
        for i in range(length):
            r = (i * (h - 1) + (length - 1) // 2) // (length - 1)
            c = (i * (w - 1) + (length - 1) // 2) // (length - 1)
            coords.add((int(r), int(c)))

    while len(coords) < size:
        frontier = []
        for r, c in coords:
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:
                        frontier.append((nr, nc))
        coords.add(random.choice(frontier))

    mask = np.zeros((h, w), dtype=bool)
    for r, c in coords:
        mask[r, c] = True
    if random.choice([False, True]):
        mask = np.flipud(mask)
    if random.choice([False, True]):
        mask = np.fliplr(mask)
    return mask.copy()


def _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:
    return np.argwhere(mask) + np.array([int(r0), int(c0)])


def _gen_base_grid(shape: tuple[int, int], bg: int, left_color: int, right_color: int) -> np.ndarray:
    grid = np.full(shape, int(bg), dtype=int)
    grid[:, 0] = int(left_color)
    grid[:, shape[1] - 1] = int(right_color)
    return grid


def _gen_place_output_side(
    out: np.ndarray, color: int, masks: list[np.ndarray], *, left_side: bool, bg: int
) -> list[Placement]:
    h, w = out.shape
    placements = []
    for mask in sorted(masks, key=lambda m: int(m.sum()), reverse=True):
        mh, mw = mask.shape
        c0 = 1 if left_side else w - 1 - mw
        rows = list(range(0, h - mh + 1))
        random.shuffle(rows)
        for r0 in rows:
            coords = _gen_mask_coords(mask, r0, c0)
            if np.any(out[coords[:, 0], coords[:, 1]] != bg):
                continue
            patch = np.where(mask, int(color), int(bg))
            paste(out, patch, r0, c0, transparent=bg)
            placements.append((int(color), mask, int(r0), int(c0), bool(left_side)))
            break
        else:
            return []
    return placements


def _gen_touches_existing(coords: np.ndarray, existing: list[np.ndarray]) -> bool:
    for other in existing:
        dr = np.abs(coords[:, None, 0] - other[None, :, 0])
        dc = np.abs(coords[:, None, 1] - other[None, :, 1])
        if bool(np.any((dr <= 1) & (dc <= 1))):
            return True
    return False
import numpy as np

import random
from arc_utils import Color, bbox, draw_line, find_components, flood_fill

# concepts:
# objects, flood fill, connectivity

# description:
# In the input, you will see a black grid with a red line that starts in the top left corner and bounces off the borders of the grid until it reaches the right side of the grid.
# To make the output, find the black regions separated by the red lines, then, starting with the first region from the left, color every third region yellow.

def main(input_grid):
    """
    Color every third black region between a red bouncing divider line yellow.

    Input structure:
    - The input is a black grid split by a red line.
    - The red line acts as a boundary between connected black regions.
    - Regions are ordered from left to right by their bounding boxes.

    Rule:
    - Find connected regions using red as the separating background.
    - Sort the regions from left to right.
    - Flood-fill regions with indices 0, 3, 6, and so on with yellow.

    Key insight:
    - The red path partitions the grid; the fill pattern is determined by region order.
    """
    # copy the input grid to the output grid
    output_grid = np.copy(input_grid)

    # find the black regions in the input grid
    bg = Color.RED
    black_regions = find_components(
        input_grid,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        return_format="objects",
    )

    # sort the regions from left to right using the coordinates of their bounding boxes
    black_regions = sorted(black_regions, key=lambda region: bbox(region != bg)[1])

    # color every third black region yellow using flood fill
    for i, region in enumerate(black_regions):
        if i % 3 == 0:
            rr, cc = np.argwhere(region != bg)[0]
            flood_fill(output_grid, int(rr), int(cc), Color.YELLOW, connectivity=4)

    return output_grid



def generate_input():
    # make a black grid that is 3 cells tall and between 10 and 20 cells wide
    grid = np.zeros((np.random.randint(10,20), 3), dtype=int)

    # make a red line that starts in the top left corner and bounces off the borders of the grid until it reaches the right side of the grid
    r, c = 0, 0
    dr, dc = 1, 1
    # go until we reach the right side of the grid
    while r < grid.shape[0]:
        # make the current cell red
        grid[r, c] = Color.RED
        # if we are at the top or bottom of the grid, bounce off the top or bottom border
        if c + dc >= grid.shape[1]:
            dc = -1
        elif c + dc < 0:
            dc = 1
        r += dr
        c += dc

    return grid
