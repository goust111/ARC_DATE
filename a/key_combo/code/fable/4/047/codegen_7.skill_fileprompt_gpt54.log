+    main_span += max(0, len(specs) - 1)
+    cross_span = max(spec["width"] if layout == "vertical" else spec["height"] for spec in specs)
+    if main_span > MAX_GRID_SIZE or cross_span > MAX_GRID_SIZE:
+        return None
+
+    bg = random.choice(ALL_COLORS)
