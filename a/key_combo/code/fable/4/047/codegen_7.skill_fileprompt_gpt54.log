+        elif side == "bottom":
+            patch[h - 1, start : start + length] = int(bg)
+        elif side == "left":
+            patch[start : start + length, 0] = int(bg)
+        else:
+            patch[start : start + length, w - 1] = int(bg)
+    return patch
