+def _has_outer_area_inversion(frames: list[dict]) -> bool:
+    for i, a in enumerate(frames):
+        for b in frames[i + 1 :]:
+            da = int(a["interior_area"]) - int(b["interior_area"])
+            db = int(a["outer_area"]) - int(b["outer_area"])
+            if da * db < 0:
