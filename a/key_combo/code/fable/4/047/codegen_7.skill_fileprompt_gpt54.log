+            dims.append((h, w))
+            used.add(area)
+
+        random.shuffle(dims)
+        temp = [
+            {
+                "height": h,
+                "width": w,
+                "interior_area": (h - 2) * (w - 2),
+                "outer_area": h * w,
+            }
+            for h, w in dims
+        ]
+        if _has_outer_area_inversion(temp):
