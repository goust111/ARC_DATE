+    grid = np.full(grid_shape, int(bg), dtype=int)
+
+    pos = random.randint(0, main_extent - main_used)
+    for idx, spec in enumerate(specs):
+        h = int(spec["height"])
+        w = int(spec["width"])
+        if layout == "vertical":
+            r0 = pos
+            c0 = random.randint(0, cross_extent - w)
+        else:
+            r0 = random.randint(0, cross_extent - h)
+            c0 = pos
+
