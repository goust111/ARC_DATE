+    for idx in range(shared_depth):
+        gates[idx] = shaft_col
+
+    mismatch_choices = [col for col in allowed_cols[shared_depth] if col != shaft_col]
+    if not mismatch_choices:
+        return None
+    gates[shared_depth] = random.choice(mismatch_choices)
