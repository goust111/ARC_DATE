+    frame_color = _infer_frame_color(g, bg)
+    frames = _parse_frames(g, frame_color)
+    balls = _extract_balls(g, bg, frame_color)
+    out, _finals = _simulate(g, bg, frame_color, frames, balls)
+    return out
+
