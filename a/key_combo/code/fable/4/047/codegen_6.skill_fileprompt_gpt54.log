+                candidates.append(pos)
+        if not candidates:
+            return None
+        r0, c0 = random.choice(candidates)
+        grid[r0 : r0 + k, c0 : c0 + k] = patches[idx]
+        placed[idx] = (r0, c0)
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_blocks = random.randint(3, 5)
+    k = random.randint(5, 6)
+    bg = random.choice(PALETTE)
