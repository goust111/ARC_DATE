+
+def _allocate_side_tokens(shape_adj: list[dict[str, int]], k: int, bg: int) -> list[dict[str, tuple[int, int]]]:
+    pool = [(offset, color) for offset in range(1, k - 1) for color in PALETTE if color != bg]
