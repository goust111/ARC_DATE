+    assert comps, "expected at least one block"
+    blocks = []
+    sizes = set()
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert h == w, "expected square block bounding boxes"
+        sizes.add(h)
+        blocks.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "patch": grid[r0 : r1 + 1, c0 : c1 + 1].copy(),
