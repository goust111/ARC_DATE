+    if any(deg not in {1, 2} for deg in degrees.values()):
+        return None
+    endpoints = [cell for cell, deg in degrees.items() if deg == 1]
+    if len(endpoints) != 2:
+        return None
+    (r1, c1), (r2, c2) = endpoints
+    if r1 == r2:
