+
+def _reflect_coords(coords: set[tuple[int, int]], axis_kind: str, axis: int) -> set[tuple[int, int]]:
+    if axis_kind == "h":
+        return {(2 * axis - r, c) for (r, c) in coords}
+    return {(r, 2 * axis - c) for (r, c) in coords}
