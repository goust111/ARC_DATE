实现方案已经定了：`main()` 走“识别两条开放单像素曲线 → 端点定轴镜像闭环 → 4 邻域外洪泛求两层内部区域 → 仅保留夹层散点”；`generate_input()` 则先生成两条最终嵌套闭环，再各自裁成不同轴向的半轮廓，最后撒点并反验 `main()`。接下来写 `8.py`，再跑 prompt 指定的 100 次自检和编译检查。
exec
/bin/bash -lc "python - <<'PY'
import random, numpy as np
from collections import deque


def neighbors4(r,c):
    yield r-1,c
    yield r+1,c
    yield r,c-1
    yield r,c+1

def component_coords(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,bool)
    comps=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            coords=[]
            while q:
                rr,cc=q.popleft(); coords.append((rr,cc))
                for nr,nc in neighbors4(rr,cc):
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            comps.append(coords)
    return comps

def reflect(coords, kind, axis):
    out=set()
    for r,c in coords:
        if kind=='h': out.add((2*axis-r,c))
        else: out.add((r,2*axis-c))
    return out

def interior(shape, ring):
    H,W=shape
    blocked=np.zeros(shape,bool)
    for r,c in ring: blocked[r,c]=True
    outside=np.zeros(shape,bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if not blocked[r,c] and not outside[r,c]: outside[r,c]=True; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if not blocked[r,c] and not outside[r,c]: outside[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and not blocked[nr,nc] and not outside[nr,nc]:
                outside[nr,nc]=True; q.append((nr,nc))
    return (~blocked) & (~outside)

def dedupe(seq):
    out=[]
    for cell in seq:
        if not out or out[-1]"'!=cell:
            out.append(cell)
    return out

def make_profile(length, depth):
    peak=random.randint(max(1,length//3), min(length-1, max(1, 2*length//3)))
    vals=[0]*(length+1)
    cur=0
    for i in range(1, peak+1):
        remaining=peak-i+1
        low=max(1, depth-remaining)
        high=min(depth, cur+1)
        cur=random.randint(low, high) if low<=high else high
        vals[i]=cur
    cur=depth
    vals[peak]=depth
    for i in range(peak+1,length):
        steps_left=length-i
        low=max(1, cur-1)
        high=min(depth, steps_left)
        if low>high: low=high
        cur=random.randint(low, high)
        vals[i]=cur
    vals[length]=0
    for i in range(1,length):
        if vals[i]==0: vals[i]=1
    return vals

def half_from_profile_h(axis, c0, prof, side):
    row_sign=-1 if side=='"'up' else 1
    coords=[(axis,c0)]
    prev=axis
    for j in range(1,len(prof)):
        c=c0+j
        target=axis + row_sign*prof[j]
        coords.append((prev,c))
        step=1 if target>prev else -1
        for r in range(prev+step, target+step, step):
            coords.append((r,c))
        prev=target
    return dedupe(coords)

def half_from_profile_v(axis, r0, prof, side):
    col_sign=-1 if side=='left' else 1
    coords=[(r0,axis)]
    prev=axis
    for j in range(1,len(prof)):
        r=r0+j
        target=axis + col_sign*prof[j]
        coords.append((r,prev))
        step=1 if target>prev else -1
        for c in range(prev+step, target+step, step):
            coords.append((r,c))
        prev=target
    return dedupe(coords)

def gen_loop(shape, orient):
    H,W=shape
    if orient=='h':
        span=random.randint(7, min(16,W-4))
        c0=random.randint(2, W-span-2)
        c1=c0+span
        depth=random.randint(2, min(6, H//3, span//2))
