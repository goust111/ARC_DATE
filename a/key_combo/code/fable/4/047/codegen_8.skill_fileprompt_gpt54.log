import random

def dedupe(seq):
    out=[]
    for x in seq:
        if not out or out[-1]"'!=x: out.append(x)
    return out

def half_h(axis,c0,profile,side):
    sign=-1 if side=='"'up' else 1
    pts=[(axis + sign*profile[j], c0+j) for j in range(len(profile))]
    coords=[pts[0]]
    for j in range(1,len(pts)):
        pr,pc=pts[j-1]
        tr,tc=pts[j]
        if pr==axis and tr"'!=axis:
            step=1 if tr>pr else -1
            for r in range(pr+step,tr+step,step): coords.append((r,pc))
            for c in range(pc+1,tc+1): coords.append((tr,c))
        else:
            for c in range(pc+1,tc+1): coords.append((pr,c))
            if tr!=pr:
                step=1 if tr>pr else -1
                for r in range(pr+step,tr+step,step): coords.append((r,tc))
    return dedupe(coords)

def half_v(axis,r0,profile,side):
    sign=-1 if side=='"'left' else 1
    pts=[(r0+j, axis + sign*profile[j]) for j in range(len(profile))]
    coords=[pts[0]]
    for j in range(1,len(pts)):
        pr,pc=pts[j-1]
        tr,tc=pts[j]
        if pc==axis and tc"'!=axis:
            step=1 if tc>pc else -1
            for c in range(pc+step,tc+step,step): coords.append((pr,c))
            for r in range(pr+1,tr+1): coords.append((r,tc))
        else:
            for r in range(pr+1,tr+1): coords.append((r,pc))
            if tc!=pc:
                step=1 if tc>pc else -1
                for c in range(pc+step,tc+step,step): coords.append((tr,c))
    return dedupe(coords)

def cls(coords):
    s=set(coords)
    deg={x:sum(((x[0]-1,x[1]) in s, (x[0]+1,x[1]) in s, (x[0],x[1]-1) in s, (x[0],x[1]+1) in s)) for x in s}
    ends=[x for x,d in deg.items() if d==1]
    bad=[x for x,d in deg.items() if d not in (1,2)]
    if bad or len(ends)!=2: return None,deg
    (r1,c1),(r2,c2)=ends
    if r1==r2:
        axis='"'h'; av=r1; offs=[r-av for r,c in coords if (r,c) not in ends]
    elif c1==c2:
        axis='v'; av=c1; offs=[c-av for r,c in coords if (r,c) not in ends]
    else:
        return ('bad ends',ends),deg
    ok=offs and all(o"'!=0 for o in offs) and len({o>0 for o in offs})==1
    return (axis,av,ends,ok),deg

profiles=[[0,1,2,2,3,2,1,0],[0,1,1,2,3,2,1,0]]
