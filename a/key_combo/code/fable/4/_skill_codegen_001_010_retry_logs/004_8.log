+    grid = np.full((height, width), BACKGROUND, dtype=int)
+    grid[0, :k1] = GREY
+    grid[0, width - k2 :] = GREY
+    for col, color, bar_height in zip(cols, colors, heights):
+        top = height - int(bar_height)
+        assert top > 0
+        grid[top:height, int(col)] = int(color)
