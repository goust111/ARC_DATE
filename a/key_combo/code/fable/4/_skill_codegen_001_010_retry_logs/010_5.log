+    else:
+        return None
+
+    inp = np.full((body_height + 1, width), background, dtype=int)
+    inp[:-1, :][wall_mask] = wall
+    inp[-1, :] = code_row
+    expected = inp.copy()
+    expected[-1, :] = background
+    for cells in chambers:
