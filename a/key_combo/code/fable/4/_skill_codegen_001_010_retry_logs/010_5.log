+    wall: int,
+) -> bool:
+    """Check puzzle semantics, uniqueness, anti-shortcuts, and the solver oracle."""
+    if inp.ndim != 2 or max(inp.shape) > 30 or inp.shape != expected.shape:
+        return False
+    if _background_color(inp) != background:
+        return False
