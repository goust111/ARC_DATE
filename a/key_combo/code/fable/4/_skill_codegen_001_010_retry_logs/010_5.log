+    left_to_right = sorted(
+        chambers,
+        key=lambda cells: sum(c for _r, c in cells) / len(cells),
+    )
+    left_colors = [area_to_color[len(cells)] for cells in left_to_right]
+    code_row = np.asarray(code_values, dtype=int)
