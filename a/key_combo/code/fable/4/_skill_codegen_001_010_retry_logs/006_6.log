    # 1 H gap mandatory, rest from V (eval pattern: 1H + 1-2V)
    v_gap_count = gap_count - 1
    if len(v_ready) < v_gap_count:
        return None
    rng.shuffle(h_ready)
    rng.shuffle(v_ready)

