        gap_start, anchor, dc = rng.choice(v_opts)
        col = v_seg["col"]
        chain = _v_chain_coords(col, gap_start, anchor, dc)
        inp[gap_start:gap_start + GAP_SIZE, col] = bg
        for r, c in chain:
