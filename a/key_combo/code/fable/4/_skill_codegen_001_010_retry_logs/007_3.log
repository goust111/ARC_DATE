+    usable = n * n - len(corners)
+    min_hidden = 5
+    max_hidden = min(14, usable - 2, usable // 2 + 2)
+    if max_hidden < min_hidden:
+        return None
+
+    palette_size = random.randint(3, min(5, 9))
+    palette = random.sample([c for c in range(10) if c != int(bg)], palette_size)
+
