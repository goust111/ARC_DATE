+def _source_aligned_quadrants(motif: np.ndarray) -> list[np.ndarray]:
+    side = int(motif.shape[0])
+    assert motif.shape == (side, side) and side % 2 == 0
+    n = side // 2
+    top_left = motif[:n, :n]
+    top_right = motif[:n, n:]
+    bottom_left = motif[n:, :n]
+    bottom_right = motif[n:, n:]
+
+    return [
