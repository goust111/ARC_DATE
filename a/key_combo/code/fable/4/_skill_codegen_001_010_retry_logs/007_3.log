+def _neighbors4(r: int, c: int, n: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < n and 0 <= cc < n:
+            out.append((rr, cc))
