def _gen_directly_repairable(mask: np.ndarray, row: int, col: int) -> bool:
    reflection_mates = (
        (_GEN_AXIS_SUM - row, col),
        (row, _GEN_AXIS_SUM - col),
        (_GEN_AXIS_SUM - row, _GEN_AXIS_SUM - col),
    )
