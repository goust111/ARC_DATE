+                g[:mid_r, mid_c + 1 :],
+                g[mid_r + 1 :, :mid_c],
+                g[mid_r + 1 :, mid_c + 1 :],
+            )
+
+    assert height % 2 == 0 and width % 2 == 0, "input must split evenly or have one separator cross"
