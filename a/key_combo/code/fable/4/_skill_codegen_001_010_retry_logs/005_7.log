+    preferred = styles[_GEN_CALL_COUNT % len(styles)]
+    _GEN_CALL_COUNT += 1
+
+    for i in range(GEN_MAX_ATTEMPTS):
+        style = preferred if i < GEN_MAX_ATTEMPTS // 2 else random.choice(styles)
+        grid = _gen_attempt(style)
+        if grid is not None:
