+
+# ---------------- generator ----------------
+
+
+def _edge_l_path(h: int, w: int) -> set[tuple[int, int]]:
+    mode = random.randrange(4)
+    cells: set[tuple[int, int]] = set()
+    if mode == 0:
+        cells.update((r, 0) for r in range(h))
+        cells.update((h - 1, c) for c in range(w))
