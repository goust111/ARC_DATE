+    q, rem = divmod(int(area), int(prototype_area))
+    assert rem == 0 and q > 0, "block area must be prototype area times a square"
+    k = int(math.isqrt(q))
+    assert k * k == q, "block area must determine one integer scale"
+    return k
+
