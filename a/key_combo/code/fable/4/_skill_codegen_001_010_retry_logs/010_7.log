+Coord = tuple[int, int]
+Axis = tuple[str, int]
+
+_BACKGROUND = 0
+_PALETTE = tuple(range(1, 10))
+_DIRECTIONS = ["horizontal", "vertical", "diagonal"]
+_direction_cycle: list[str] = []
