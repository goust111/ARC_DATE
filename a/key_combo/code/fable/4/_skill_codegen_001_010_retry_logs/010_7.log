+def _side_value(p: Coord, axis: Axis) -> int:
+    r, c = p
+    kind, value = axis
+    if kind == "horizontal":
+        return r - value
+    if kind == "vertical":
+        return c - value
+    if kind == "diag_down":
+        return r - c - value
+    if kind == "diag_up":
+        return r + c - value
+    raise ValueError(f"unknown axis kind: {kind}")
