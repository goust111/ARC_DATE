+
+def _neighbors(r: int, c: int, connectivity: int = 4):
+    deltas = ((-1, 0), (1, 0), (0, -1), (0, 1))
+    if connectivity == 8:
+        deltas = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr, dc) != (0, 0)
+        )
+    for dr, dc in deltas:
+        yield r + dr, c + dc
