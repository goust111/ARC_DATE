+    result: list[set[Coord]] = []
+    while unseen:
+        start = unseen.pop()
+        component = {start}
+        stack = [start]
+        while stack:
+            r, c = stack.pop()
+            for q in _neighbors(r, c, connectivity):
+                if q in unseen:
+                    unseen.remove(q)
+                    component.add(q)
+                    stack.append(q)
+        result.append(component)
+    return result
