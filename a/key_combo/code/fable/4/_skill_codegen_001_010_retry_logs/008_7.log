+
+def _mode_nonblack_first(vals: list[int]) -> int:
+    counts = Counter(int(v) for v in vals)
+    nonblack = [(cnt, -first, color) for first, (color, cnt) in enumerate(counts.items()) if color != BLACK]
+    if nonblack:
+        _cnt, _neg_first, color = max(nonblack)
+        return int(color)
+    return BLACK
