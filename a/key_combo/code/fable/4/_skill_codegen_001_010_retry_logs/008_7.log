+            inward_c = 1 if c_edge == 0 else -1
+            m = np.zeros((cell_h, cell_w), dtype=bool)
+            m[r_edge, c_edge] = True
+            m[r_edge + inward_r, c_edge] = True
+            m[r_edge, c_edge + inward_c] = True
