+                (r1, c1) = defects[0]["grid_pos"]  # type: ignore[index]
+                (r2, c2) = defects[1]["grid_pos"]  # type: ignore[index]
+                mask1 = defects[0]["mask"]  # type: ignore[index]
+                mask2 = defects[1]["mask"]  # type: ignore[index]
+                if r1 == r2 or c1 == c2:
