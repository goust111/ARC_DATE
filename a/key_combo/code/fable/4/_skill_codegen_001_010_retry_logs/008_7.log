+            if cell_h < 2:
+                continue
+            for cols in range(2, W + 1):
+                inner_w = W - (cols - 1) * gap
+                if inner_w < cols or inner_w % cols != 0:
+                    continue
+                cell_w = inner_w // cols
+                if cell_w < 2:
+                    continue
+                if rows * cols < 4:
+                    continue
+                if not _gaps_are_black(crop, rows, cols, cell_h, cell_w, gap):
