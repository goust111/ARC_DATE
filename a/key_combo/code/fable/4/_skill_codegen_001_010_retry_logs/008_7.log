+    best_key = (
+        int(best["rows"]) * int(best["cols"]),
+        int(best["cell_h"]) * int(best["cell_w"]),
+        int(best["gap"]),
+    )
+    tied = [
+        item
+        for item in valid
+        if (
+            int(item["rows"]) * int(item["cols"]),
+            int(item["cell_h"]) * int(item["cell_w"]),
+            int(item["gap"]),
