+                valid.append(
+                    {
+                        "origin": (int(br0), int(bc0)),
+                        "rows": int(rows),
+                        "cols": int(cols),
+                        "cell_h": int(cell_h),
+                        "cell_w": int(cell_w),
+                        "gap": int(gap),
+                        "template": template,
+                        "defects": defects,
+                    }
+                )
