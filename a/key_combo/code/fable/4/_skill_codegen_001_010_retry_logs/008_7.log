+def _solve_with_meta(grid: np.ndarray) -> tuple[np.ndarray, dict[str, object]]:
+    meta = _parse_tiling(grid)
+    template = meta["template"]  # type: ignore[assignment]
+    defects = meta["defects"]  # type: ignore[assignment]
