+        return False
+    cells = {(int(r), int(c)) for r, c in pts}
+    q: deque[tuple[int, int]] = deque([next(iter(cells))])
+    seen = {q[0]}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
