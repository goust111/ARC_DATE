+        r0 = row_cells[cell[0]][0]
+        c0 = col_cells[cell[1]][0]
+        offsets = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+        period = len(offsets)
+        seeds.append(Seed(int(color), int(period), cell, offsets))
