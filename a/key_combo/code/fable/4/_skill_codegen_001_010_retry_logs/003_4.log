+    colors = random.sample([c for c in ARC_COLORS if c != BACKGROUND], 3)
+    scaffold, color1, color2 = colors
+    seeds = [
+        Seed(color1, period1, source1, _gen_offsets(period1)),
+        Seed(color2, period2, source2, _gen_offsets(period2)),
