+import numpy as np
+
+
+BACKGROUND = 0
+CELL_SIZE = 3
+ARC_COLORS = tuple(range(10))
+PERIOD_PAIRS = ((2, 3), (2, 4), (2, 6), (3, 6))
+MAX_GENERATION_ATTEMPTS = 800
+
+
+@dataclass(frozen=True)
+class Seed:
+    color: int
+    period: int
+    cell: tuple[int, int]
