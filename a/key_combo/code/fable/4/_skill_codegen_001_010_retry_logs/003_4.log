+
+def _build_grid(
+    row_sizes: list[int],
+    col_sizes: list[int],
+    scaffold: int,
+    seeds: list[Seed],
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    height, row_bands, row_seps = _bands_from_sizes(row_sizes)
+    width, col_bands, col_seps = _bands_from_sizes(col_sizes)
+    assert height <= 30 and width <= 30
