+
+def _build_grid(
+    row_sizes: list[int],
+    col_sizes: list[int],
+    scaffold: int,
+    seeds: list[Seed],
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
