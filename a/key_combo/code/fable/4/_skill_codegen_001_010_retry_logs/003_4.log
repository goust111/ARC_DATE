+    grid = np.full((height, width), BACKGROUND, dtype=int)
+    if row_seps:
+        grid[row_seps, :] = int(scaffold)
+    if col_seps:
+        grid[:, col_seps] = int(scaffold)
+
+    for seed in seeds:
+        row_band = row_bands[seed.cell[0]]
+        col_band = col_bands[seed.cell[1]]
