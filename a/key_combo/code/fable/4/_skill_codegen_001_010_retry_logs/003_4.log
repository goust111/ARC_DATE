+
+
+def _side_sizes(cell_count: int, *, prefer_truncated: bool) -> list[int]:
+    cell_count = int(cell_count)
+    if cell_count == 8:
+        last = random.choice([1, 2])
+    elif prefer_truncated:
+        last = random.choice([1, 2])
+    else:
+        last = random.choice([1, 2, 3, 3])
