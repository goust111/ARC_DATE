        for lat_c in range(_GEN_BORDER, _GEN_GRID_SIZE - lattice_w):
            for ctl_r in range(_GEN_BORDER, _GEN_GRID_SIZE - rows):
                for ctl_c in range(_GEN_BORDER, lat_c - cols - _GEN_LAYOUT_GAP + 1):
