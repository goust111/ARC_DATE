+def _run_index(runs: list[tuple[int, int]], value: int) -> int:
+    matches = [idx for idx, (lo, hi) in enumerate(runs) if lo <= int(value) <= hi]
+    assert len(matches) == 1, "foreground pixels must lie inside exactly one open cell"
+    return matches[0]
+
