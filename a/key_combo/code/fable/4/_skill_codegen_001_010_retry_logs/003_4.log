+            cell = (row_idx, col_idx)
+            if cell in source_cells:
+                continue
+            hits = _cell_hits(cell, seeds)
+            if len(hits) == 1:
+                _stamp(out, row_band, col_band, hits[0])
+    return out
+
+
+def _relative_color_coords(
+    grid: np.ndarray,
+    row_band: tuple[int, int],
+    col_band: tuple[int, int],
+    color: int,
+) -> set[tuple[int, int]]:
+    r0, r1 = row_band
+    c0, c1 = col_band
