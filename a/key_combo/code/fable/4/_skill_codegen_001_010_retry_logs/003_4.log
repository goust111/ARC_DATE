+        row_lines = np.flatnonzero(np.all(g == int(color), axis=1))
+        col_lines = np.flatnonzero(np.all(g == int(color), axis=0))
+        if row_lines.size and col_lines.size:
+            candidates.append((int(color), row_lines, col_lines))
