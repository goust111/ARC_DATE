    height = GEN_PANEL_HEIGHT
    width = random.randint(GEN_PANEL_WIDTH_MIN, GEN_PANEL_WIDTH_MAX)
    colors = random.sample(GEN_PANEL_COLORS, random.choice(GEN_PANEL_COLOR_COUNTS))
