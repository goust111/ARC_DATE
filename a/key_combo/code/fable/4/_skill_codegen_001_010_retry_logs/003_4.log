+
+
+# --------------- generator ---------------
+
+
+def _lcm(a: int, b: int) -> int:
+    return abs(int(a) * int(b)) // math.gcd(int(a), int(b))
+
+
+def _bands_from_sizes(sizes: list[int]) -> tuple[int, list[tuple[int, int]], list[int]]:
+    bands: list[tuple[int, int]] = []
