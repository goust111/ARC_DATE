+def _clipped_offsets(
+    row_band: tuple[int, int],
+    col_band: tuple[int, int],
+    seed: Seed,
+) -> set[tuple[int, int]]:
+    height = row_band[1] - row_band[0] + 1
+    width = col_band[1] - col_band[0] + 1
+    return {(dr, dc) for dr, dc in seed.offsets if dr < height and dc < width}
+
