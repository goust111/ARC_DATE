+def _background_color(g: np.ndarray) -> int:
+    values, counts = np.unique(g, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _colors_present(g: np.ndarray, exclude: set[int] | None = None) -> list[int]:
