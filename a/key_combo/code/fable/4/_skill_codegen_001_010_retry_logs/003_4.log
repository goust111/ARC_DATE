_GEN_BORDER = 1
_GEN_LAYOUT_GAP = 1
_GEN_HOLE_COUNT_RANGE = (1, 2)
_GEN_COLOR_COUNT_RANGE = (2, 5)
_GEN_RETRY_LIMIT = 300


def _gen_template_mask() -> np.ndarray:
    mask = np.ones((_GEN_TEMPLATE_SIZE, _GEN_TEMPLATE_SIZE), dtype=bool)
