+def _candidate_sources(
+    row_sizes: list[int],
+    col_sizes: list[int],
+    period1: int,
+    period2: int,
+    want_source_collision: bool,
+) -> list[tuple[tuple[int, int], tuple[int, int], dict[str, int]]]:
