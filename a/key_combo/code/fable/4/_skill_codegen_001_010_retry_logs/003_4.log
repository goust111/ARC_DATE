+    assert count >= len(mandatory)
+    rest = [(r, c) for r in range(CELL_SIZE) for c in range(CELL_SIZE) if (r, c) not in mandatory]
+    random.shuffle(rest)
+    coords = set(mandatory)
+    coords.update(rest[: count - len(coords)])
+    return tuple(sorted(coords))
