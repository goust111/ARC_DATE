+def _distance_to_entry(pos: tuple[int, int], d: tuple[int, int], center: tuple[int, int]) -> int:
+    entry = (center[0] - d[0], center[1] - d[1])
+    return abs(entry[0] - pos[0]) + abs(entry[1] - pos[1])
