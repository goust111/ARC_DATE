+        if int(grid[h - 1, c]) != bg:
+            edge_cells.append((h - 1, c))
+    for r in range(1, h - 1):
+        if int(grid[r, 0]) != bg:
+            edge_cells.append((r, 0))
+        if int(grid[r, w - 1]) != bg:
+            edge_cells.append((r, w - 1))
