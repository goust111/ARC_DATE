+    assert len(edge_cells) == 1, "expected one non-background source pixel on the grid edge"
+    r, c = edge_cells[0]
+    on_top = r == 0
+    on_bottom = r == h - 1
+    on_left = c == 0
+    on_right = c == w - 1
+    assert sum((on_top, on_bottom, on_left, on_right)) == 1, "source cannot sit on a corner"
