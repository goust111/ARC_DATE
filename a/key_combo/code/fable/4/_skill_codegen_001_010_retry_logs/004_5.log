+            ring = Ring((int(cr), int(cc)), (gaps[0], gaps[1]), int(color))
+            solid = _ring_solid_cells(ring.center, ring.gaps)
+            assert not (solid & used_solid), "ring frames must be disjoint"
+            used_solid |= solid
+            rings.append(ring)
