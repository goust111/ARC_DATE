+) -> list[tuple[int, int]]:
+    entry = (center[0] - d[0], center[1] - d[1])
+    cells: list[tuple[int, int]] = []
+    r, c = pos
+    while (r, c) != entry:
+        r += d[0]
+        c += d[1]
+        cells.append((int(r), int(c)))
+    cells.append(center)
+    return cells
