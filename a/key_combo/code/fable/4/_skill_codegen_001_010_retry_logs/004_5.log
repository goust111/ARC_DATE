+    return candidates
+
+
+def _ray_cells_until_edge(shape: tuple[int, int], pos: tuple[int, int], d: tuple[int, int]) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    r, c = pos
+    while True:
+        r += d[0]
+        c += d[1]
+        if not _in_bounds(shape, r, c):
+            return cells
+        cells.append((int(r), int(c)))
+
+
+def _render_grid(
+    shape: tuple[int, int],
+    source: tuple[int, int],
+    source_color: int,
+    rings: list[Ring],
+) -> np.ndarray:
