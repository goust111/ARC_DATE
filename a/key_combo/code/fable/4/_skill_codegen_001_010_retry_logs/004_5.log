+    on_bottom = r == h - 1
+    on_left = c == 0
+    on_right = c == w - 1
+    assert sum((on_top, on_bottom, on_left, on_right)) == 1, "source cannot sit on a corner"
+
+    if on_top:
+        direction = (1, 0)
+    elif on_bottom:
+        direction = (-1, 0)
+    elif on_left:
+        direction = (0, 1)
+    else:
+        direction = (0, -1)
