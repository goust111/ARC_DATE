+
+    for cr in range(1, h - 1):
+        for cc in range(1, w - 1):
+            if int(grid[cr, cc]) != bg:
+                continue
+
+            corner_values = [
+                int(grid[cr - 1, cc - 1]),
+                int(grid[cr - 1, cc + 1]),
+                int(grid[cr + 1, cc - 1]),
+                int(grid[cr + 1, cc + 1]),
