+def _trace(
+    grid: np.ndarray,
+    source: tuple[int, int],
+    direction: tuple[int, int],
+    source_color: int,
+    rings: list[Ring],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    bg = _most_common_color(grid)
