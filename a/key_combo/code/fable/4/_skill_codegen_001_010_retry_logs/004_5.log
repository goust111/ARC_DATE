+    h, w = map(int, shape)
+    return 0 <= r < h and 0 <= c < w
+
+
+def _add(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    return int(a[0] + b[0]), int(a[1] + b[1])
+
+
+def _neg(d: tuple[int, int]) -> tuple[int, int]:
+    return -int(d[0]), -int(d[1])
+
