+        if cell in gap_map:
+            ring_idx, entry_normal = gap_map[cell]
+            assert entry_normal == _neg(d), "ray reached a ring gap from the wrong side"
+            ring = rings[ring_idx]
+            center = ring.center
+            assert _add(cell, d) == center, "entry gap must lead directly to the ring center"
