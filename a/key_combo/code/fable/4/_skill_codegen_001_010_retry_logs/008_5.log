+    for comp in external:
+        coords = np.asarray(comp["coords"], dtype=int)
+        out[coords[:, 0], coords[:, 1]] = BLACK
+
+    for lock in locks:
+        coords = np.asarray(lock["cavity"], dtype=int)
+        out[coords[:, 0], coords[:, 1]] = int(lock["color"])
