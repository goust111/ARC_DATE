+                    enclosed = False
+                    break
+                grey_neighbors.add(gid)
+            if not enclosed:
+                break
+
+        if enclosed and len(grey_neighbors) == 1:
+            sid = next(iter(grey_neighbors))
+            cavities.setdefault(sid, []).append(
+                {
