+def _grey_component_labels(g: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    comps = _components(g == GREY)
+    labels = np.full(g.shape, -1, dtype=int)
+    for idx, coords in enumerate(comps):
+        labels[coords[:, 0], coords[:, 1]] = int(idx)
+    return labels, comps
