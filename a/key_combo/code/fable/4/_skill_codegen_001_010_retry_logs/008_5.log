def _gen_stretch_options(mask, *, min_density, max_density, max_area):
    row_opts = _gen_factor_tuples(mask.shape[0])
    col_opts = _gen_factor_tuples(mask.shape[1])
    out = []
    seen = set()
    for row_factors in row_opts:
