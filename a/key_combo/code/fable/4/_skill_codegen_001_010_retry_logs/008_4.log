+def _known_specs_output(
+    grid: np.ndarray,
+    specs: list[dict],
+    *,
+    force_no_cushion: bool = False,
+) -> np.ndarray:
+    out = grid.copy()
+    for spec in specs:
+        gap = 0 if force_no_cushion else int(spec["k"]) - 1
+        _slide_yellow_on_mask(grid, out, spec["inner_mask"], spec["direction"], gap)
+    return out
+
