        patch[mask] = int(color)
        paste(out, patch, anchor_top, int(left), transparent=GEN_BG)
        paste(inp, patch, top_by_color[int(color)], int(left), transparent=GEN_BG)
    return inp, out

def _gen_attempt() -> np.ndarray | None:
    rows = _gen_randint(GRID_ROWS)
