+def _gen_attempt() -> np.ndarray | None:
+    rows = random.randint(24, 30)
+    cols = random.randint(24, 30)
+    bg = random.choice([0, 8])
+    palette = [1, 2, 3, 5, 6, 7, 9]
+    if bg in palette:
