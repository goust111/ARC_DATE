+
+BLACK = 0
+YELLOW = 4
+CARDINAL_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAGONAL_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ALL_DIRS = CARDINAL_DIRS + DIAGONAL_DIRS
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
