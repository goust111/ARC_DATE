+    stack_seen = False
+    for color, direction, k in zip(colors, dirs, ks):
+        inner_h = random.randint(5, 8 if region_count == 3 else 9)
+        inner_w = random.randint(5, 8 if region_count == 3 else 9)
+        box = _draw_region_wall(grid, occ, color, inner_h, inner_w)
