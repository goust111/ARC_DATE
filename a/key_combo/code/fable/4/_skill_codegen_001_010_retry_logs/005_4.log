+
+# ---------------- generator ----------------
+
+_GEN_MAX_ATTEMPTS = 500
+_GEN_CALL_COUNT = 0
+
+
+def _truthful_pointer(
+    side: str,
+    hub: tuple[int, int],
+    dist: int,
+    color: int,
+) -> Pointer:
+    hr, hc = hub
+    if side == "top":
+        head = (hr - dist, hc)
+        tail = (hr - dist - 1, hc)
+        direction = (1, 0)
+    elif side == "bottom":
+        head = (hr + dist, hc)
+        tail = (hr + dist + 1, hc)
+        direction = (-1, 0)
+    elif side == "left":
+        head = (hr, hc - dist)
+        tail = (hr, hc - dist - 1)
+        direction = (0, 1)
+    elif side == "right":
+        head = (hr, hc + dist)
+        tail = (hr, hc + dist + 1)
+        direction = (0, -1)
+    else:
+        raise ValueError(f"unknown side {side!r}")
+    return Pointer(tail, head, direction, color)
+
+
+def _max_truth_distance(side: str, shape: tuple[int, int], hub: tuple[int, int]) -> int:
+    h, w = shape
+    hr, hc = hub
+    if side == "top":
+        return hr - 1
+    if side == "bottom":
+        return h - hr - 2
+    if side == "left":
+        return hc - 1
+    if side == "right":
+        return w - hc - 2
+    raise ValueError(f"unknown side {side!r}")
+
+
+def _cells_too_close(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(abs(a[0] - b[0]), abs(a[1] - b[1])) <= 1
+
+
+def _candidate_clear(
+    tail: tuple[int, int],
+    head: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    protected: set[tuple[int, int]],
+) -> bool:
+    if tail in occupied or head in occupied or tail in protected or head in protected:
+        return False
+    for cell in (tail, head):
+        for old in occupied:
+            if _cells_too_close(cell, old):
+                return False
+    return True
+
+
+def _liar_mode(pointer: Pointer, hub: tuple[int, int]) -> str | None:
+    hr, hc = pointer.head
+    dr, dc = pointer.direction
+    if _ray_contains(pointer, hub):
+        return None
+    if dr == 0 and hr == hub[0] and (hub[1] - hc) * dc < 0:
+        return "backward_aligned"
+    if dc == 0 and hc == hub[1] and (hub[0] - hr) * dr < 0:
+        return "backward_aligned"
+    if (dr == 0 and hr != hub[0]) or (dc == 0 and hc != hub[1]):
+        return "off_axis"
+    return None
+
+
+def _make_input(
+    shape: tuple[int, int],
+    bg: int,
+    pointers: list[Pointer],
+) -> np.ndarray:
