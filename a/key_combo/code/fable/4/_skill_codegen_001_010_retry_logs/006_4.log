+def _candidate_frames(g: np.ndarray, bg: int, occ_mask: np.ndarray) -> list[dict]:
+    frame_mask = (g != bg) & (~occ_mask) & (g != Color.RED)
+    combined = (g != bg) & (g != Color.RED)
+    candidates: list[dict] = []
