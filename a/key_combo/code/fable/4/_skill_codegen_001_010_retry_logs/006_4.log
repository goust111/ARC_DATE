+
+    expected = _gen_marker_or_erase_expected(grid, frames, bg, frame_color, occ_color)
+    if expected is None:
+        return None
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
