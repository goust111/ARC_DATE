+        return
+
+    segment = _gen_gap_segment(box, side, 3)
+    occ_part = segment[:2]
+    bare_part = segment[2:]
+    _gen_paint_rect(grid, _gen_occ_rect_for_segment(occ_part, side), occ_color)
+    for r, c in bare_part:
+        grid[r, c] = get_bg(grid)
+
