+    h, w = grid.shape
+    for _ in range(80):
+        length = random.randint(2, 4)
+        horizontal = random.random() < 0.5
+        dh, dw = (1, length) if horizontal else (length, 1)
+        r0 = random.randint(1, h - dh - 1)
+        c0 = random.randint(1, w - dw - 1)
+        r1, c1 = r0 + dh - 1, c0 + dw - 1
