+def _border_coords(box: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = box
+    coords: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        if r1 != r0:
+            coords.append((r1, c))
+    for r in range(r0 + 1, r1):
