+
+def _intermediate_cells(
+    shape: tuple[tuple[int, int], ...],
+    anchor: tuple[int, int],
+    v: tuple[int, int],
+) -> set[tuple[int, int]]:
+    dr, dc = v
+    g = math.gcd(abs(dr), abs(dc))
+    if g <= 1:
+        return set()
+    step = (dr // g, dc // g)
+    here = _cells(shape, anchor)
+    there = _cells(shape, (anchor[0] + dr, anchor[1] + dc))
