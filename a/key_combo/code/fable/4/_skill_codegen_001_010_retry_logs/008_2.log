+    g = math.gcd(abs(dr), abs(dc))
+    if g <= 1:
+        return set()
+    step = (dr // g, dc // g)
+    here = _cells(shape, anchor)
+    there = _cells(shape, (anchor[0] + dr, anchor[1] + dc))
+    blocked = here | there
+    middle = set()
+    for r, c in here:
+        for t in range(1, g):
+            p = (int(r + t * step[0]), int(c + t * step[1]))
+            if p not in blocked:
