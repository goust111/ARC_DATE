+    return [_cells(shape, (start[0] + k * v[0], start[1] + k * v[1])) for k in range(steps + 1)]
+
+
+def _chain_cells(
+    shape: tuple[tuple[int, int], ...],
+    start: tuple[int, int],
+    v: tuple[int, int],
+) -> set[tuple[int, int]]:
+    cells = set()
+    for k in (-2, -1, 0):
+        cells |= _cells(shape, (start[0] + k * v[0], start[1] + k * v[1]))
+    return cells
+
+
+def _max_boundary_steps(
+    shape: tuple[tuple[int, int], ...],
+    start: tuple[int, int],
+    v: tuple[int, int],
+    H: int,
+    W: int,
+) -> int:
