+
+def _chain_cells(
+    shape: tuple[tuple[int, int], ...],
+    start: tuple[int, int],
+    v: tuple[int, int],
+) -> set[tuple[int, int]]:
+    cells = set()
+    for k in (-2, -1, 0):
+        cells |= _cells(shape, (start[0] + k * v[0], start[1] + k * v[1]))
