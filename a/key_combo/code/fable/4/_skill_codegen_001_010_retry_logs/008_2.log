+def _claim_vectors(objects: list[dict], shadows: list[dict]) -> list[dict]:
+    shadow_shapes = [_shape_from_coords(comp["coords"]) for comp in shadows]
+    shadow_anchors = [_anchor(comp) for comp in shadows]
+
+    claims = []
+    used_shadow_ids: list[int] = []
