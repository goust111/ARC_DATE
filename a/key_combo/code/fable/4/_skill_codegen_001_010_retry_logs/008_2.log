+    out[blockers] = BLOCKER
+
+    occupied = np.zeros_like(blockers, dtype=bool)
+    for claim in claims:
+        coords = claim["coords"].copy()
+        vector = claim["vector"]
+
+        while True:
+            nxt = coords + vector
+            in_bounds = (
+                (0 <= nxt[:, 0])
+                & (nxt[:, 0] < H)
+                & (0 <= nxt[:, 1])
+                & (nxt[:, 1] < W)
+            )
+            if not bool(in_bounds.all()):
+                break
+            if bool(blockers[nxt[:, 0], nxt[:, 1]].any()):
+                break
+            coords = nxt
