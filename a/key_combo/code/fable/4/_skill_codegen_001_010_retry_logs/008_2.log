+
+def _touches4(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    if a & b:
+        return True
+    for r, c in a:
+        if (r - 1, c) in b or (r + 1, c) in b or (r, c - 1) in b or (r, c + 1) in b:
+            return True
+    return False
