+    colors = random.sample(MOVING_COLORS, count)
+    specs = []
+    for i in range(count):
+        if i == 0:
+            stop_kind = "obstacle"
+            crossing = True
+        elif i == 1:
+            stop_kind = "boundary"
+            crossing = False
+        else:
+            stop_kind = random.choice(["obstacle", "boundary"])
+            crossing = False
+        specs.append(
+            {
+                "shape": shapes[i],
+                "vector": vectors[i],
+                "color": int(colors[i]),
+                "stop_kind": stop_kind,
+                "crossing": crossing,
+            }
+        )
