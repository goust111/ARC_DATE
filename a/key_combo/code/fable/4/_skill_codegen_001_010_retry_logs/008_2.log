+def _render(records: list[dict], blockers: set[tuple[int, int]], H: int, W: int) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.full((H, W), BG, dtype=int)
+    out = np.full((H, W), BG, dtype=int)
