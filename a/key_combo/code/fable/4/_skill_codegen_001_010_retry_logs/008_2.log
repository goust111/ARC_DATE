+        obj_shape = _shape_from_coords(obj["coords"])
+        obj_anchor = _anchor(obj)
+        matching = [i for i, shape in enumerate(shadow_shapes) if shape == obj_shape]
+        candidates = []
+
+        for i in matching:
+            for j in matching:
+                if i == j:
+                    continue
