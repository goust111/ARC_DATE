+            "color": spec["color"],
+            "vector": v,
+            "start": start,
+            "steps": steps,
+            "stop_kind": stop_kind,
+            "chain": chain,
+            "success_path": success_path,
+            "final_cells": _cells(shape, final_anchor),
+            "new_blockers": new_blockers,
+            "crossed": crossed,
