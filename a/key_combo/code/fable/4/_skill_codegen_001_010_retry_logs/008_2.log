+        out[r, c] = BLOCKER
+
+    for rec in records:
+        shape = rec["shape"]
+        sr, sc = rec["start"]
+        dr, dc = rec["vector"]
+        for anchor, color in (
+            ((sr - 2 * dr, sc - 2 * dc), AFTERIMAGE),
+            ((sr - dr, sc - dc), AFTERIMAGE),
+            ((sr, sc), rec["color"]),
+        ):
+            for r, c in _cells(shape, anchor):
+                inp[r, c] = int(color)
+
+        for r, c in rec["final_cells"]:
+            out[r, c] = int(rec["color"])
+    return inp, out
