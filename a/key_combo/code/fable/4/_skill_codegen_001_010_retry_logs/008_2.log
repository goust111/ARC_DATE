+def _shape_from_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0, c0, _r1, _c1 = bbox_coords(np.asarray(coords, dtype=int))
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
