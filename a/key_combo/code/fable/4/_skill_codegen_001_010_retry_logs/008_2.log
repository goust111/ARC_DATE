+
+def _landings(
+    shape: tuple[tuple[int, int], ...],
+    start: tuple[int, int],
+    v: tuple[int, int],
+    steps: int,
+) -> list[set[tuple[int, int]]]:
+    return [_cells(shape, (start[0] + k * v[0], start[1] + k * v[1])) for k in range(steps + 1)]
+
+
+def _chain_cells(
+    shape: tuple[tuple[int, int], ...],
+    start: tuple[int, int],
+    v: tuple[int, int],
+) -> set[tuple[int, int]]:
+    cells = set()
+    for k in (-2, -1, 0):
+        cells |= _cells(shape, (start[0] + k * v[0], start[1] + k * v[1]))
+    return cells
+
+
+def _max_boundary_steps(
+    shape: tuple[tuple[int, int], ...],
+    start: tuple[int, int],
+    v: tuple[int, int],
+    H: int,
+    W: int,
+) -> int:
+    steps = 0
+    while True:
+        nxt = _cells(shape, (start[0] + (steps + 1) * v[0], start[1] + (steps + 1) * v[1]))
+        if not _fits(nxt, H, W):
+            return steps
+        steps += 1
+        if steps > 8:
