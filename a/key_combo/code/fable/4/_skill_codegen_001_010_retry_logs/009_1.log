    marker = np.zeros((SHAPE_SIZE, SHAPE_SIZE), dtype=int)
    marker[0 if arm_is_top else -1, :] = MARKER_COLOR
    stem_rows = slice(1, None) if arm_is_top else slice(0, -1)
    marker[stem_rows, SHAPE_SIZE // 2] = MARKER_COLOR
    return marker


