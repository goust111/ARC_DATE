BLOCK_COLS_PANEL_LEFT = (8, 15)
BLOCK_COLS_PANEL_RIGHT = (2, 9)
BLOCK_INDICES = np.arange(BLOCK_COUNT)
INPUT_SOLID_COUNT_MIN, INPUT_SOLID_COUNT_MAX_EXCLUSIVE = 0, 3

