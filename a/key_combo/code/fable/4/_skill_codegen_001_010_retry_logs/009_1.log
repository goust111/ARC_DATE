    masks = []
    for cells in itertools.combinations(range(SHAPE_SIZE * SHAPE_SIZE), k):
        mask = np.zeros((SHAPE_SIZE, SHAPE_SIZE), dtype=bool)
        mask.flat[list(cells)] = True
