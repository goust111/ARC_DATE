+        candidate_input_occ = input_occ.copy()
+        candidate_input_occ[combined_coords[:, 0], combined_coords[:, 1]] = True
+        blocked_for_target = output_occ | candidate_input_occ
+        if not _clear(target_coords, blocked_for_target, padding=1):
+            continue
