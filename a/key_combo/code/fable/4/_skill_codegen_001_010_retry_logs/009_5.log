+
+def _parse_scene(grid: np.ndarray) -> tuple[int, list[dict], list[dict], dict, int, int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _background(g)
