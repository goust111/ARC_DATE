+                candidates = [{anchor}]
+            elif kind == "h":
+                ar, ac = anchor
+                candidates = [{(ar, ac), (ar, ac + 1)}, {(ar, ac - 1), (ar, ac)}]
+            elif kind == "v":
+                ar, ac = anchor
+                candidates = [{(ar, ac), (ar + 1, ac)}, {(ar - 1, ac), (ar, ac)}]
+            else:
+                raise AssertionError(f"unknown marker kind {kind!r}")
