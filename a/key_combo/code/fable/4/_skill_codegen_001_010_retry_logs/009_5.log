+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BACKGROUND = 0
+MARKER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MARKER_KINDS = ("h", "v", "r")
+GENERATION_ATTEMPTS = 700
+PLACE_ATTEMPTS = 700
