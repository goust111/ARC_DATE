+
+
+def _marker_options(mask: np.ndarray, kind: str) -> list[set[Coord]]:
+    obj = {(int(r), int(c)) for r, c in np.argwhere(mask)}
+    options: list[set[Coord]] = []
+    for r, c in obj:
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            anchor = (r + dr, c + dc)
