+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BACKGROUND = 0
+MARKER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MARKER_KINDS = ("h", "v", "r")
+GENERATION_ATTEMPTS = 700
+PLACE_ATTEMPTS = 700
+
+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(row: int, col: int):
+    yield row - 1, col
+    yield row + 1, col
+    yield row, col - 1
+    yield row, col + 1
+
+
+def _neighbors8(row: int, col: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr or dc:
+                yield row + dr, col + dc
+
+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    colors: set[int] | None = None,
+    connectivity: int = 8,
+) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    neighbor_fn = _neighbors4 if int(connectivity) == 4 else _neighbors8
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == int(bg):
+                continue
+            if colors is not None and color not in colors:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
