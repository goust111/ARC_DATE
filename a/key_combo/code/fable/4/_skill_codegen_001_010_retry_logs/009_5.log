+            if seen[r, c] or color == int(bg):
+                continue
+            if colors is not None and color not in colors:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbor_fn(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+
+            arr = np.asarray(coords, dtype=int)
+            comps.append(
+                {
+                    "id": len(comps),
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
