+# ---------------- generator ----------------
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    cells = {(int(r), int(c)) for r, c in coords}
+    stack = [next(iter(cells))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors8(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
