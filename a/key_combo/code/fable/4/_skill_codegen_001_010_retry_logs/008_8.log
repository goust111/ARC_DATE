+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+TEAL = 8
+
+PROTOTYPE_COLORS = (1, 2, 3, 4, 6, 7, 9)
+OBJECT_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+GEN_ATTEMPTS = 800
