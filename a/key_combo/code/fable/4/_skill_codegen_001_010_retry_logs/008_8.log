+        b = _bbox(mask)
+        assert b is not None
+        r0, c0, r1, c1 = b
+        mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        if _connected(mask):
+            return mask
+    raise RuntimeError("failed to make connected distractor")
