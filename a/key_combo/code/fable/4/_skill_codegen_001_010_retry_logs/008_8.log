+
+def _corner_position(
+    shape: tuple[int, int],
+    patch_shape: tuple[int, int],
+    corner: str,
+) -> tuple[int, int]:
+    height, width = shape
+    ph, pw = patch_shape
+    if corner == "tl":
+        return 0, 0
+    if corner == "tr":
+        return 0, width - pw
+    if corner == "bl":
+        return height - ph, 0
+    return height - ph, width - pw
