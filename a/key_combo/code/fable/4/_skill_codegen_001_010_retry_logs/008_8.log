+    while True:
+        changed = False
+        if out.shape[0] > 1:
+            keep_rows = [0]
+            for r in range(1, out.shape[0]):
+                if not np.array_equal(out[r], out[r - 1]):
+                    keep_rows.append(r)
+            if len(keep_rows) != out.shape[0]:
+                out = out[keep_rows, :]
+                changed = True
+
+        if out.shape[1] > 1:
+            keep_cols = [0]
+            for c in range(1, out.shape[1]):
+                if not np.array_equal(out[:, c], out[:, c - 1]):
+                    keep_cols.append(c)
+            if len(keep_cols) != out.shape[1]:
+                out = out[:, keep_cols]
+                changed = True
