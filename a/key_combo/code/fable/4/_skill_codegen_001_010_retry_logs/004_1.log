+    if chain_to_row_slot == list(range(segment_count)):
+        chain_to_row_slot[0], chain_to_row_slot[1] = chain_to_row_slot[1], chain_to_row_slot[0]
+
+    grid = np.zeros((height, width), dtype=int)
