+        else:
+            assert int(content.size) == content_len, "all contents must have equal length"
+
+        segments.append(
+            {
+                "row": int(r),
+                "c0": int(c0),
+                "c1": int(c1),
+                "left": left,
+                "right": right,
+                "content": content,
+            }
+        )
+
+    assert segments, "expected at least one ported row segment"
+    return segments
+
+
