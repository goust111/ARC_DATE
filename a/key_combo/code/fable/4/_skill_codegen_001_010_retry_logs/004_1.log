+        if len(set(map(int, arr))) < min(2, len(palette)):
+            continue
+        key = tuple(map(int, arr))
+        if key in seen:
+            continue
+        seen.add(key)
+        contents.append(arr)
+
+    raise RuntimeError("failed to sample distinct content rows")
