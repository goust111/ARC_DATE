from __future__ import annotations

import numpy as np

from arc_utils import bbox_coords, get_bg
import random


def _legend_pairs(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
    pairs: list[tuple[int, int]] = []
    for r in range(g.shape[0]):
        left = int(g[r, 0])
        right = int(g[r, 1])
        if left == bg or right == bg:
            break
        pairs.append((left, right))
    assert pairs, "expected a non-empty two-column legend at the upper left"
    return pairs


def main(grid: np.ndarray) -> np.ndarray:
    """Expand each sparse color object into a filled rectangular region using its legend-paired fill color.

    Input structure
    A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives
    a source color in the left column and that source color's fill color in the right column.  Outside the
    legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.

    Rule
    Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox
    by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired
    legend fill color while preserving every original non-legend dot.

    Key insight
    The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted
    from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape
    assert W >= 2, "expected room for a two-column legend"

    pairs = _legend_pairs(g, bg)
    source_colors = {source for source, _fill in pairs}
    assert len(source_colors) == len(pairs), "legend source colors must be unique"

    legend_mask = np.zeros(g.shape, dtype=bool)
    legend_mask[: len(pairs), :2] = True
    dot_mask = (g != bg) & ~legend_mask
    assert dot_mask.any(), "expected source dots outside the legend"
    assert set(map(int, g[dot_mask])).issubset(source_colors), "outside dots must use legend source colors"

    dots_by_color: dict[int, np.ndarray] = {}
    all_dots = np.zeros(g.shape, dtype=bool)
    for source, _fill in pairs:
        coords = np.argwhere(dot_mask & (g == source))
        assert coords.size, "each legend source color must appear outside the legend"
        dots_by_color[source] = coords
        all_dots[coords[:, 0], coords[:, 1]] = True

    out = np.full_like(g, bg)
    for source, fill in reversed(pairs):
        r0, c0, r1, c1 = bbox_coords(dots_by_color[source])
        r0 = max(0, r0 - 1)
        c0 = max(0, c0 - 1)
        r1 = min(H - 1, r1 + 1)
        c1 = min(W - 1, c1 + 1)

        region = out[r0 : r1 + 1, c0 : c1 + 1]
        background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]
        region[background_inside_region] = fill

    out[all_dots] = g[all_dots]
    return out

# --------------- generator (o5x) ---------------

# Canvas and legend geometry.
GRID_HEIGHT, GRID_WIDTH = 20, 20
BACKGROUND_COLOR = 0
LEGEND_COLS = 2
DOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1

# Legend palette sampling.
COLORS = tuple(range(1, 10))
PAIR_COUNT_CHOICES = (2, 3)
ROTATED_SOURCE_FILL_PROB = 0.45

# Dot-grid shape sampling.
DOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8
DOT_COLS_MIN, DOT_COLS_MAX = 2, 5

# Layout search.
THREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)
MODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = "overlap", "overlap_any", "separate", "any"
POST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)
POST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)

# Generation retry budget.
GENERATION_RETRIES = 300


def _origin_bbox(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> tuple[int, int, int, int]:
    r, c = origin
    return (
        r - BBOX_PAD,
        c - BBOX_PAD,
        r + DOT_STRIDE * (dot_rows - 1) + BBOX_PAD,
        c + DOT_STRIDE * (dot_cols - 1) + BBOX_PAD,
    )


def _hits_legend(box: tuple[int, int, int, int], n_pairs: int) -> bool:
    r0, c0, r1, c1 = box
    return r0 <= n_pairs - 1 and r1 >= 0 and c0 <= LEGEND_COLS - 1 and c1 >= 0


def _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:
    origins: list[tuple[int, int]] = []
    max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)
    max_c = GRID_WIDTH - 1 - BBOX_PAD - DOT_STRIDE * (dot_cols - 1)
    for r in range(BBOX_PAD, max_r + 1):
        for c in range(BBOX_PAD, max_c + 1):
            box = _origin_bbox((r, c), dot_rows, dot_cols)
            if not _hits_legend(box, n_pairs):
                origins.append((r, c))
    return origins


def _dot_coords(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> np.ndarray:
    rows = origin[0] + DOT_STRIDE * np.arange(dot_rows)
    cols = origin[1] + DOT_STRIDE * np.arange(dot_cols)
    rr, cc = np.meshgrid(rows, cols, indexing="ij")
    return np.stack([rr.ravel(), cc.ravel()], axis=1).astype(int)


def _expanded_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = bbox_coords(coords)
    return (
        max(0, r0 - BBOX_PAD),
        max(0, c0 - BBOX_PAD),
        min(GRID_HEIGHT - 1, r1 + BBOX_PAD),
        min(GRID_WIDTH - 1, c1 + BBOX_PAD),
    )


def _inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = box
    return (coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)


def _separated_by_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return (
        a[2] + NON_OVERLAP_GAP < b[0]
        or b[2] + NON_OVERLAP_GAP < a[0]
        or a[3] + NON_OVERLAP_GAP < b[1]
        or b[3] + NON_OVERLAP_GAP < a[1]
    )


def _intersection_bounds(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
) -> tuple[int, int, int, int] | None:
    r0, c0 = max(a[0], b[0]), max(a[1], b[1])
    r1, c1 = min(a[2], b[2]), min(a[3], b[3])
    if r0 > r1 or c0 > c1:
        return None
    return r0, c0, r1, c1


def _intersection_has_background(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int], dot_mask: np.ndarray
) -> bool:
    bounds = _intersection_bounds(a, b)
    if bounds is None:
        return False
    r0, c0, r1, c1 = bounds
    return bool((~dot_mask[r0 : r1 + 1, c0 : c1 + 1]).any())


def _remove_dots_covered_by_higher_priority(
    coords: np.ndarray, higher_boxes: list[tuple[int, int, int, int]]
) -> np.ndarray:
    keep = np.ones(len(coords), dtype=bool)
    for box in higher_boxes:
        keep &= ~_inside_box(coords, box)
    return coords[keep]


def _scene_data(
    sizes: list[tuple[int, int]], origins: list[tuple[int, int]]
) -> tuple[list[np.ndarray], list[tuple[int, int, int, int]], np.ndarray] | None:
    remaining: list[np.ndarray] = []
    boxes: list[tuple[int, int, int, int]] = []
    dot_mask = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)

    for (dot_rows, dot_cols), origin in zip(sizes, origins):
        coords = _remove_dots_covered_by_higher_priority(_dot_coords(origin, dot_rows, dot_cols), boxes)
        if coords.size == 0:
            return None
        if len(set(map(int, coords[:, 0]))) != dot_rows or len(set(map(int, coords[:, 1]))) != dot_cols:
            return None
        if dot_mask[coords[:, 0], coords[:, 1]].any():
            return None
        dot_mask[coords[:, 0], coords[:, 1]] = True
        remaining.append(coords)
        boxes.append(_expanded_bbox(coords))

    return remaining, boxes, dot_mask


def _render_output(
    pairs: list[tuple[int, int]], remaining: list[np.ndarray], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray
) -> np.ndarray:
    out = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    for idx in range(len(pairs) - 1, -1, -1):
        _source, fill = pairs[idx]
        r0, c0, r1, c1 = boxes[idx]
        region = out[r0 : r1 + 1, c0 : c1 + 1]
        region[~dot_mask[r0 : r1 + 1, c0 : c1 + 1]] = fill
    for (source, _fill), coords in zip(pairs, remaining):
        out[coords[:, 0], coords[:, 1]] = source
    return out


def _build_input(pairs: list[tuple[int, int]], remaining: list[np.ndarray]) -> np.ndarray:
    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    grid[: len(pairs), :LEGEND_COLS] = np.asarray(pairs, dtype=int)
    for (source, _fill), coords in zip(pairs, remaining):
        grid[coords[:, 0], coords[:, 1]] = source
    return grid


def _visible_overlap(
    pairs: list[tuple[int, int]], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray, out: np.ndarray
) -> bool:
    for hi in range(len(pairs)):
        for lo in range(hi + 1, len(pairs)):
            bounds = _intersection_bounds(boxes[hi], boxes[lo])
            if bounds is None:
                continue
            r0, c0, r1, c1 = bounds
            overlap_fill = (~dot_mask[r0 : r1 + 1, c0 : c1 + 1]) & (
                out[r0 : r1 + 1, c0 : c1 + 1] == pairs[hi][1]
            )
            lr0, lc0, lr1, lc1 = boxes[lo]
            lower_fill = (~dot_mask[lr0 : lr1 + 1, lc0 : lc1 + 1]) & (
                out[lr0 : lr1 + 1, lc0 : lc1 + 1] == pairs[lo][1]
            )
            if overlap_fill.any() and lower_fill.any():
                return True
    return False


def _choose_pairs(n_pairs: int) -> list[tuple[int, int]]:
    colors = list(COLORS)
    sources = random.sample(colors, n_pairs)
    non_sources = [c for c in colors if c not in sources]
    if random.random() < ROTATED_SOURCE_FILL_PROB:
        fills = sources[1:] + sources[:1]
        replace_count = random.randint(0, n_pairs)
        for idx, color in zip(random.sample(range(n_pairs), replace_count), random.sample(non_sources, replace_count)):
            fills[idx] = color
    else:
        fills = random.sample(non_sources, n_pairs)
    return list(zip(sources, fills))


def _candidate_origins(
    sizes: list[tuple[int, int]],
    origins: list[tuple[int, int]],
    legal: list[tuple[int, int]],
    mode: str,
    target: int | None = None,
) -> list[tuple[int, int]]:
    candidates: list[tuple[int, int]] = []
    for origin in legal:
        data = _scene_data(sizes[: len(origins) + 1], origins + [origin])
        if data is None:
            continue
        _remaining, boxes, dot_mask = data
        new_box = boxes[-1]
        if mode == MODE_OVERLAP:
            assert target is not None
            if not _intersection_has_background(new_box, boxes[target], dot_mask):
                continue
        elif mode == MODE_OVERLAP_ANY:
            if not any(_intersection_has_background(new_box, old_box, dot_mask) for old_box in boxes[:-1]):
                continue
        elif mode == MODE_SEPARATE:
            if not all(_separated_by_gap(new_box, old_box) for old_box in boxes[:-1]):
                continue
        candidates.append(origin)
    return candidates


def _choose_origins(n_pairs: int, sizes: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
    legal = [_legal_origins(n_pairs, dot_rows, dot_cols) for dot_rows, dot_cols in sizes]
    if any(not options for options in legal):
        return None

    origins = [random.choice(legal[0])]
    forced_step = 1 if n_pairs == 2 else random.choice(THREE_PAIR_FORCED_OVERLAP_STEPS)
    for idx in range(1, n_pairs):
        if idx == forced_step:
            target = random.randrange(idx)
            candidates = _candidate_origins(sizes, origins, legal[idx], MODE_OVERLAP, target)
        elif idx < forced_step:
            candidates = _candidate_origins(sizes, origins, legal[idx], MODE_SEPARATE)
            if not candidates:
                candidates = _candidate_origins(sizes, origins, legal[idx], MODE_ANY)
        else:
            mode = random.choices(POST_FORCED_LAYOUT_MODES, weights=POST_FORCED_LAYOUT_WEIGHTS, k=1)[0]
            candidates = _candidate_origins(sizes, origins, legal[idx], mode)
            if not candidates:
                candidates = _candidate_origins(sizes, origins, legal[idx], MODE_ANY)
        if not candidates:
            return None
        origins.append(random.choice(candidates))
    return origins


def _gen_attempt() -> np.ndarray | None:
    n_pairs = random.choice(PAIR_COUNT_CHOICES)
    pairs = _choose_pairs(n_pairs)
    sizes = [
        (random.randint(DOT_ROWS_MIN, DOT_ROWS_MAX), random.randint(DOT_COLS_MIN, DOT_COLS_MAX))
        for _ in range(n_pairs)
    ]
    origins = _choose_origins(n_pairs, sizes)
    if origins is None:
        return None

    data = _scene_data(sizes, origins)
    if data is None:
        return None
    remaining, boxes, dot_mask = data
    out = _render_output(pairs, remaining, boxes, dot_mask)
    if not _visible_overlap(pairs, boxes, dot_mask, out):
        return None

    inp = _build_input(pairs, remaining)
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 305b1341 input")
import numpy as np

from arc_utils import Color
import random


def _infer_minimal_tile(g: np.ndarray) -> np.ndarray:
    height, width = map(int, g.shape)
    known = g != Color.BLACK
    assert np.any(~known), "expected black missing pixels"

    candidates: list[tuple[int, np.ndarray]] = []
    for tile_h in range(1, height + 1):
        for tile_w in range(1, width + 1):
            tile = np.full((tile_h, tile_w), -1, dtype=int)
            valid = True
            for r, c in np.argwhere(known):
                tr, tc = int(r) % tile_h, int(c) % tile_w
                value = int(g[r, c])
                if tile[tr, tc] == -1:
                    tile[tr, tc] = value
                elif tile[tr, tc] != value:
                    valid = False
                    break
            if valid and np.all(tile != -1):
                candidates.append((tile_h * tile_w, tile))

    assert candidates, "expected a fully observed repeating tile"
    best_area = min(area for area, _ in candidates)
    best = [tile for area, tile in candidates if area == best_area]
    assert len(best) == 1, "expected a unique minimal repeating tile"
    return best[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the black holes by continuing the smallest repeating non-black wallpaper pattern.

    Input structure:
    - The grid is a rectangular wallpaper pattern with some cells replaced by black.
    - Every phase of the true repeating tile is visible at least once in a non-black cell.
    - The smallest fully observed tile consistent with the non-black cells is unique.

    Rule:
    - Ignore black pixels while inferring the repeating tile.
    - Find the unique minimal-area tile whose row/column phases agree with all non-black cells.
    - Replace every grid cell by the color at its corresponding tile phase.

    Key insight:
    - Black is missing data, not part of the wallpaper; the observed colored cells determine the latent periodic tile.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    tile = _infer_minimal_tile(g)
    tile_h, tile_w = map(int, tile.shape)
    rows = np.arange(g.shape[0])[:, None] % tile_h
    cols = np.arange(g.shape[1])[None, :] % tile_w
    out = tile[rows, cols]
    assert np.all(out[g != Color.BLACK] == g[g != Color.BLACK]), "tile must preserve all known cells"
    return out

# --------------- generator (o5x) ---------------

# Canvas and latent tile bounds.
CANVAS_SIZE = 25
TILE_HEIGHT_RANGE = (4, 9)
TILE_WIDTH_RANGE = (2, 9)
GRID_LINE_COLOR = Color.BLUE
OUTER_GRID_LINE_INDEX = 0
MISSING_COLOR = Color.BLACK

# Interior grid-line and color sampling.
LINE_MIN_LENGTH = 6
LINE_PROBABILITY = 0.35
LINE_STEP_RANGE = (3, 5)
INNER_COLOR_COUNT_RANGE = (2, 3)
NON_BLUE_COLORS = [2, 3, 4, 5, 6, 7, 8, 9]

# Black-hole blob sampling and placement.
BLOB_COUNT_RANGE = (3, 4)
BLACK_TOTAL_RANGE = (50, 81)
BLOB_SIZE_RANGE = (4, 55)
BLOB_HEIGHT_RANGE = (2, 11)
BLOB_WIDTH_RANGE = (2, 9)
BLOB_MIN_FILL_RATIO = 0.56
RECT_BLOB_PROBABILITY = 0.35
BORDER_MARGIN = 1
NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Outer retry budget for rejected tile/placement attempts.
GEN_RETRY_LIMIT = 300


def _gen_line_positions(length: int) -> set[int]:
    lines = {OUTER_GRID_LINE_INDEX}
    if length >= LINE_MIN_LENGTH and random.random() < LINE_PROBABILITY:
        step = random.randint(LINE_STEP_RANGE[0], min(LINE_STEP_RANGE[1], length - 1))
        lines.update(range(step, length, step))
    return lines


def _gen_neighbors(r: int, c: int, height: int, width: int):
    """Yield in-bounds 4-neighbors in the legacy order."""
    for dr, dc in NEIGHBORS_4:
        nr, nc = r + dr, c + dc
        if 0 <= nr < height and 0 <= nc < width:
            yield int(nr), int(nc)


def _gen_inner_orbits(rows: list[int], cols: list[int]) -> list[list[tuple[int, int]]]:
    """Group inner tile cells into LR+UD symmetry orbits."""
    orbits = []
    for i in range((len(rows) + 1) // 2):
        paired_rows = {rows[i], rows[-1 - i]}
        for j in range((len(cols) + 1) // 2):
            paired_cols = {cols[j], cols[-1 - j]}
            orbits.append([(r, c) for r in paired_rows for c in paired_cols])
    return orbits


def _gen_min_period(tile: np.ndarray) -> tuple[int, int]:
    h, w = tile.shape
    rows = np.arange(h)[:, None]
    cols = np.arange(w)[None, :]
    for th in range(1, h + 1):
        for tw in range(1, w + 1):
            if np.array_equal(tile, tile[rows % th, cols % tw]):
                return th, tw
    return h, w


def _gen_build_tile() -> np.ndarray | None:
    """Sample a full-period symmetric tile, or reject it."""
    tile_h = random.randint(*TILE_HEIGHT_RANGE)
    tile_w = random.randint(*TILE_WIDTH_RANGE)
    row_lines = _gen_line_positions(tile_h)
    col_lines = _gen_line_positions(tile_w)
    inner_rows = [r for r in range(tile_h) if r not in row_lines]
    inner_cols = [c for c in range(tile_w) if c not in col_lines]
    orbits = _gen_inner_orbits(inner_rows, inner_cols)
    if len(orbits) < 2:
        return None

    n_colors = random.randint(INNER_COLOR_COUNT_RANGE[0], min(INNER_COLOR_COUNT_RANGE[1], len(orbits)))
    colors = random.sample(NON_BLUE_COLORS, n_colors)
    values = colors + [random.choice(colors) for _ in range(len(orbits) - n_colors)]
    random.shuffle(values)

    tile = np.full((tile_h, tile_w), GRID_LINE_COLOR, dtype=int)
    for cells, color in zip(orbits, values):
        for r, c in cells:
            tile[r, c] = color

    if _gen_min_period(tile) != (tile_h, tile_w):
        return None
    return tile


def _gen_wallpaper(tile: np.ndarray) -> np.ndarray:
    h, w = tile.shape
    rows = np.arange(CANVAS_SIZE)[:, None] % h
    cols = np.arange(CANVAS_SIZE)[None, :] % w
    return tile[rows, cols]


def _gen_blob_sizes(count: int, total: int) -> list[int]:
    sizes = []
    remaining = total
    for i in range(count):
        left = count - i - 1
        lo = max(BLOB_SIZE_RANGE[0], remaining - BLOB_SIZE_RANGE[1] * left)
        hi = min(BLOB_SIZE_RANGE[1], remaining - BLOB_SIZE_RANGE[0] * left)
        size = random.randint(lo, hi)
        sizes.append(size)
        remaining -= size
    random.shuffle(sizes)
    return sizes


def _gen_blob_shape(size: int) -> np.ndarray | None:
    """Sample a connected blob mask with the requested area."""
    dims = [
        (h, w)
        for h in range(BLOB_HEIGHT_RANGE[0], BLOB_HEIGHT_RANGE[1] + 1)
        for w in range(BLOB_WIDTH_RANGE[0], BLOB_WIDTH_RANGE[1] + 1)
        if h + w - 1 <= size <= h * w and size / (h * w) >= BLOB_MIN_FILL_RATIO
    ]
    if not dims:
        return None

    rect_dims = [(h, w) for h, w in dims if h * w == size]
    if rect_dims and random.random() < RECT_BLOB_PROBABILITY:
        h, w = random.choice(rect_dims)
        return np.ones((h, w), dtype=bool)

    h, w = random.choice(dims)
    mask = np.zeros((h, w), dtype=bool)
    r = c = 0
    mask[r, c] = True
    steps = [(1, 0)] * (h - 1) + [(0, 1)] * (w - 1)
    random.shuffle(steps)
    for dr, dc in steps:
        r += dr
        c += dc
        mask[r, c] = True

    while int(mask.sum()) < size:
        frontier = []
        for rr, cc in np.argwhere(mask):
            for nr, nc in _gen_neighbors(rr, cc, h, w):
                if not mask[nr, nc]:
                    frontier.append((int(nr), int(nc)))
        if not frontier:
            return None
        nr, nc = random.choice(frontier)
        mask[nr, nc] = True
    return mask


def _gen_touches_existing(mask: np.ndarray, cells: list[tuple[int, int]]) -> bool:
    for r, c in cells:
        if mask[r, c]:
            return True
        for nr, nc in _gen_neighbors(r, c, CANVAS_SIZE, CANVAS_SIZE):
            if mask[nr, nc]:
                return True
    return False


def _gen_phase_counts(tile_h: int, tile_w: int) -> np.ndarray:
    rows = np.arange(CANVAS_SIZE) % tile_h
    cols = np.arange(CANVAS_SIZE) % tile_w
    counts = np.zeros((tile_h, tile_w), dtype=int)
    np.add.at(counts, (rows[:, None], cols[None, :]), 1)
    return counts


def _gen_place_blob(
    black: np.ndarray, shape: np.ndarray, phase_counts: np.ndarray, tile_h: int, tile_w: int
) -> bool:
    """Place one blob without touching existing blobs or hiding a tile phase."""
    h, w = shape.shape
    offsets = [(int(r), int(c)) for r, c in np.argwhere(shape)]
    choices = []
    for r0 in range(BORDER_MARGIN, CANVAS_SIZE - h):
        for c0 in range(BORDER_MARGIN, CANVAS_SIZE - w):
            cells = [(r0 + r, c0 + c) for r, c in offsets]
            if _gen_touches_existing(black, cells):
                continue
            next_counts = phase_counts.copy()
            for r, c in cells:
                next_counts[r % tile_h, c % tile_w] -= 1
            if np.all(next_counts > 0):
                choices.append((r0, c0, next_counts))
    if not choices:
        return False

    r0, c0, next_counts = random.choice(choices)
    for r, c in offsets:
        black[r0 + r, c0 + c] = True
    phase_counts[:, :] = next_counts
    return True


def _gen_attempt() -> np.ndarray | None:
    """Run one output-first generation attempt and oracle-check it."""
    tile = _gen_build_tile()
    if tile is None:
        return None

    out = _gen_wallpaper(tile)
    tile_h, tile_w = tile.shape
    blob_count = random.randint(*BLOB_COUNT_RANGE)
    total_black = random.randint(*BLACK_TOTAL_RANGE)
    sizes = _gen_blob_sizes(blob_count, total_black)
    black = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)
    phase_counts = _gen_phase_counts(tile_h, tile_w)

    for size in sizes:
        shape = _gen_blob_shape(size)
        if shape is None or not _gen_place_blob(black, shape, phase_counts, tile_h, tile_w):
            return None

    inp = out.copy()
    inp[black] = MISSING_COLOR
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
import numpy as np
import random as _gen_random
from arc_utils import components_mask as _gen_components_mask, paste as _gen_paste


PANEL_STARTS = (0, 5, 10, 15)
SEPARATOR_COLS = (4, 9, 14)
VISIBLE_ORDER = (2, 3, 0, 1)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Overlay the four separated 4x4 panels into one 4x4 image using a fixed front-to-back panel order.

    Input structure
    - The input is a 4x19 grid split by three full-height separator columns into four 4x4 panels.
    - Each panel contains background 0 plus exactly one foreground color, and the four panel colors are distinct.

    Rule
    - Treat 0 cells in each panel as transparent.
    - Stack the panels front-to-back in positional order: third panel, fourth panel, first panel, second panel.
    - The output cell is the first non-background color visible at that position, or 0 if all panels are empty there.

    Key insight
    - The four masks are already aligned; the only hidden information is their layer priority, which starts at the third panel and then proceeds cyclically.
    """
    g = np.asarray(grid, dtype=int)
    assert g.shape == (4, 19), "expected four 4x4 panels separated by three columns"

    separators = g[:, SEPARATOR_COLS]
    separator_color = int(separators[0, 0])
    assert separator_color != 0, "separator color must be non-background"
    assert np.all(separators == separator_color), "separator columns must be uniform"

    panels = []
    panel_colors = []
    for start in PANEL_STARTS:
        panel = g[:, start : start + 4]
        colors = set(map(int, np.unique(panel))) - {0}
        assert len(colors) == 1, "each panel must have exactly one foreground color"
        color = colors.pop()
        assert color != separator_color, "panel colors must differ from the separator color"
        panels.append(panel)
        panel_colors.append(color)
    assert len(set(panel_colors)) == len(panel_colors), "panel colors must be distinct"

    out = np.zeros((4, 4), dtype=int)
    filled = np.zeros((4, 4), dtype=bool)
    for panel_index in VISIBLE_ORDER:
        panel = panels[panel_index]
        mask = (panel != 0) & (~filled)
        out[mask] = panel[mask]
        filled |= mask

    return out

# --------------- generator (o5x) ---------------

# Grid geometry: four 4x4 panels separated by three uniform columns.
_GEN_PANEL_SIZE, _GEN_INPUT_WIDTH = 4, 19
_GEN_GRID_SHAPE = (_GEN_PANEL_SIZE, _GEN_PANEL_SIZE)
_GEN_PANEL_STARTS = (0, 5, 10, 15)
_GEN_SEPARATOR_COLS = (4, 9, 14)
_GEN_PANEL_COUNT = len(_GEN_PANEL_STARTS)

# Overlay structure: order positions map to panel indices front-to-back.
_GEN_VISIBLE_ORDER = (2, 3, 0, 1)
_GEN_BACK_ORDER_POSITIONS = (1, 2, 3)

# Palette: one separator color plus one distinct foreground color per panel.
_GEN_COLOR_VALUES = range(1, 10)
_GEN_COLOR_COUNT = 5

# Panel mask constraints observed in the task examples.
_GEN_PANEL_AREA_MIN, _GEN_PANEL_AREA_MAX = 5, 12
_GEN_COMPONENT_MIN, _GEN_COMPONENT_MAX = 1, 5
_GEN_COMPONENT_CONNECTIVITY = 4

# Output composition: 0-3 blank cells and usually 3-4 visible colors.
_GEN_ZERO_CELL_MIN, _GEN_ZERO_CELL_MAX = 0, 3
_GEN_PRESENT_COLOR_COUNTS = (3, 4)

# Generation retry limit.
_GEN_MAX_ATTEMPTS = 300

_GEN_ALL_CELLS = tuple((r, c) for r in range(_GEN_PANEL_SIZE) for c in range(_GEN_PANEL_SIZE))
_GEN_BIT_WEIGHTS = np.array(
    [1 << i for i in range(_GEN_PANEL_SIZE * _GEN_PANEL_SIZE)], dtype=np.uint32
)


def _gen_bit_to_mask(bit):
    return ((bit & _GEN_BIT_WEIGHTS) != 0).reshape(_GEN_GRID_SHAPE)


def _gen_mask_bit(mask):
    return int(np.sum(_GEN_BIT_WEIGHTS[np.asarray(mask, dtype=bool).ravel()]))


def _gen_count_components(mask):
    return len(_gen_components_mask(mask, connectivity=_GEN_COMPONENT_CONNECTIVITY))


def _gen_build_mask_bank():
    bank = []
    by_area = {}
    for bit in range(1, 1 << (_GEN_PANEL_SIZE * _GEN_PANEL_SIZE)):
        area = bit.bit_count()
        if not _GEN_PANEL_AREA_MIN <= area <= _GEN_PANEL_AREA_MAX:
            continue
        mask = _gen_bit_to_mask(bit)
        comp_count = _gen_count_components(mask)
        if _GEN_COMPONENT_MIN <= comp_count <= _GEN_COMPONENT_MAX:
            entry = (bit, mask, area, comp_count)
            bank.append(entry)
            by_area.setdefault(area, []).append(entry)
    return bank, by_area


_GEN_MASK_BANK, _GEN_MASKS_BY_AREA = _gen_build_mask_bank()


def _gen_copy_mask_entry(entry):
    bit, mask, _, _ = entry
    return bit, mask.copy()


def _gen_choose_entry_with_area_then_components(entries, area=None):
    if area is None:
        area = _gen_random.choice(sorted({entry[2] for entry in entries}))
        entries = [entry for entry in entries if entry[2] == area]

    comp_count = _gen_random.choice(sorted({entry[3] for entry in entries}))
    return _gen_random.choice([entry for entry in entries if entry[3] == comp_count])


def _gen_sample_bank_mask(area):
    entry = _gen_choose_entry_with_area_then_components(_GEN_MASKS_BY_AREA[area], area)
    return _gen_copy_mask_entry(entry)


def _gen_choose_panel_mask(required_bit, allowed_bit):
    candidates = [
        entry
        for entry in _GEN_MASK_BANK
        if (entry[0] & required_bit) == required_bit and (entry[0] & ~allowed_bit) == 0
    ]
    if not candidates:
        return None

    entry = _gen_choose_entry_with_area_then_components(candidates)
    return _gen_copy_mask_entry(entry)


def _gen_random_composition(total, parts):
    if parts == 0:
        return []
    choices = []
    for cuts in np.ndindex(*(total + 1 for _ in range(parts - 1))):
        vals = []
        prev = 0
        ok = True
        for cut in sorted(cuts):
            val = cut - prev
            if val < 1 or val > _GEN_PANEL_AREA_MAX:
                ok = False
                break
            vals.append(val)
            prev = cut
        last = total - prev
        if ok and 1 <= last <= _GEN_PANEL_AREA_MAX:
            vals.append(last)
            choices.append(vals)
    return _gen_random.choice(choices) if choices else None


def _gen_sample_palette():
    colors = _gen_random.sample(_GEN_COLOR_VALUES, _GEN_COLOR_COUNT)
    return colors[0], colors[1:]


def _gen_build_output_winners():
    zero_count = _gen_random.randint(_GEN_ZERO_CELL_MIN, _GEN_ZERO_CELL_MAX)
    filled_count = (_GEN_PANEL_SIZE * _GEN_PANEL_SIZE) - zero_count
    present_count = _gen_random.choice(_GEN_PRESENT_COLOR_COUNTS)
    front_area_hi = min(_GEN_PANEL_AREA_MAX, filled_count - (present_count - 1))
    front_area = _gen_random.randint(_GEN_PANEL_AREA_MIN, front_area_hi)
    _, front_mask = _gen_sample_bank_mask(front_area)

    selected_positions = _gen_random.sample(_GEN_BACK_ORDER_POSITIONS, present_count - 1)
    selected_positions.sort()
    other_counts = _gen_random_composition(filled_count - front_area, len(selected_positions))
    if other_counts is None:
        return None

    winners = np.full(_GEN_GRID_SHAPE, -1, dtype=int)
    winners[front_mask] = 0

    remaining = [cell for cell in _GEN_ALL_CELLS if not front_mask[cell]]
    _gen_random.shuffle(remaining)
    nonzero_remaining = remaining[zero_count:]
    cursor = 0
    for pos, count in zip(selected_positions, other_counts):
        for r, c in nonzero_remaining[cursor : cursor + count]:
            winners[r, c] = pos
        cursor += count
    return winners


def _gen_decompose_winners(winners):
    cumulative_front = 0
    panel_masks = [None] * _GEN_PANEL_COUNT
    for order_pos, panel_index in enumerate(_GEN_VISIBLE_ORDER):
        required_bit = _gen_mask_bit(winners == order_pos)
        allowed_bit = cumulative_front | required_bit
        chosen = _gen_choose_panel_mask(required_bit, allowed_bit)
        if chosen is None:
            return None
        bit, mask = chosen
        panel_masks[panel_index] = mask
        cumulative_front |= required_bit
    return panel_masks


def _gen_expected_output(winners, panel_colors):
    out = np.zeros(_GEN_GRID_SHAPE, dtype=int)
    for order_pos, panel_index in enumerate(_GEN_VISIBLE_ORDER):
        out[winners == order_pos] = panel_colors[panel_index]
    return out


def _gen_render_input(separator_color, panel_colors, panel_masks):
    inp = np.zeros((_GEN_PANEL_SIZE, _GEN_INPUT_WIDTH), dtype=int)
    inp[:, _GEN_SEPARATOR_COLS] = separator_color
    for panel_index, start in enumerate(_GEN_PANEL_STARTS):
        panel = np.where(panel_masks[panel_index], panel_colors[panel_index], 0)
        _gen_paste(inp, panel, 0, start)
    return inp


def _gen_attempt():
    separator_color, panel_colors = _gen_sample_palette()

    winners = _gen_build_output_winners()
    if winners is None:
        return None

    panel_masks = _gen_decompose_winners(winners)
    if panel_masks is None:
        return None

    inp = _gen_render_input(separator_color, panel_colors, panel_masks)
    expected = _gen_expected_output(winners, panel_colors)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 281123b4 input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, in_bounds, neighbors4
import random


def _line_color(g: np.ndarray, bg: int) -> int:
    vals, counts = np.unique(g[g != int(bg)], return_counts=True)
    assert vals.size == 3, "expected one line color and two marker colors"
    max_count = int(counts.max())
    winners = vals[counts == max_count]
    assert winners.size == 1, "line color must be uniquely most common"
    return int(winners[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.

    Input structure:
    - The background is the dominant color.
    - Each foreground object is a straight horizontal or vertical 4-connected rod.
    - Each rod contains many pixels of one line color, one endpoint marker, and one
      interior control marker.

    Rule:
    - For every rod, keep the segment from the endpoint marker through the control
      marker unchanged.
    - Move the line-color tail on the far side of the control marker to a
      perpendicular ray starting next to that marker.
    - Choose the perpendicular direction with more space to the grid edge.

    Key insight:
    - The endpoint marker identifies the fixed side of the rod, while the control
      marker is the hinge; the tail folds into the larger open half-plane.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = get_bg(g)
    line_color = _line_color(g, bg)

    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert components, "expected at least one marked rod"

    clear: list[tuple[int, int]] = []
    paint: list[tuple[int, int]] = []

    for comp in components:
        coords = [tuple(map(int, coord)) for coord in comp["coords"]]
        coord_set = set(coords)
        marker_coords = [p for p in coords if int(g[p]) != line_color]
        assert len(marker_coords) == 2, "each rod must have exactly two markers"

        degrees = {
            p: sum((nr, nc) in coord_set for nr, nc in neighbors4(*p))
            for p in marker_coords
        }
        endpoints = [p for p, degree in degrees.items() if int(degree) == 1]
        hinges = [p for p, degree in degrees.items() if int(degree) == 2]
        assert len(endpoints) == 1 and len(hinges) == 1, "markers must be endpoint and hinge"
        endpoint = endpoints[0]
        hinge = hinges[0]

        rows = {r for r, _c in coords}
        cols = {c for _r, c in coords}
        assert len(rows) == 1 or len(cols) == 1, "each object must be a straight rod"

        if len(rows) == 1:
            assert endpoint[0] == hinge[0], "horizontal rod markers must share a row"
            fixed_sign = int(np.sign(endpoint[1] - hinge[1]))
            assert fixed_sign != 0, "endpoint and hinge must be distinct"
            tail_step = (0, -fixed_sign)
            up_space = int(hinge[0])
            down_space = int(H - 1 - hinge[0])
            assert up_space != down_space, "perpendicular direction must be unique"
            fold_step = (-1, 0) if up_space > down_space else (1, 0)
        else:
            assert endpoint[1] == hinge[1], "vertical rod markers must share a column"
            fixed_sign = int(np.sign(endpoint[0] - hinge[0]))
            assert fixed_sign != 0, "endpoint and hinge must be distinct"
            tail_step = (-fixed_sign, 0)
            left_space = int(hinge[1])
            right_space = int(W - 1 - hinge[1])
            assert left_space != right_space, "perpendicular direction must be unique"
            fold_step = (0, -1) if left_space > right_space else (0, 1)

        tail: list[tuple[int, int]] = []
        step = 1
        while True:
            p = (
                int(hinge[0]) + int(tail_step[0]) * step,
                int(hinge[1]) + int(tail_step[1]) * step,
            )
            if p not in coord_set:
                break
            assert int(g[p]) == line_color, "tail must contain only line-color pixels"
            tail.append(p)
            step += 1
        assert tail, "each hinge must have a moving tail"

        for step in range(1, len(tail) + 1):
            p = (
                int(hinge[0]) + int(fold_step[0]) * step,
                int(hinge[1]) + int(fold_step[1]) * step,
            )
            assert in_bounds(g.shape, *p), "folded tail must remain in bounds"
            paint.append(p)
        clear.extend(tail)

    assert len(set(clear)) == len(clear), "moving tails must not overlap"
    assert len(set(paint)) == len(paint), "folded tails must not collide"
    clear_set = set(clear)
    for p in paint:
        assert int(g[p]) == int(bg) or p in clear_set, "fold target must be empty"

    out = g.copy()
    for p in clear:
        out[p] = bg
    for p in paint:
        out[p] = line_color
    return out

# --------------- generator (o5x) ---------------

# ARC colors.
BG, RED, HINGE, END = 7, 2, 0, 5

# Canvas and rod-count sampling.
GRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16
ROD_COUNT_MIN, ROD_COUNT_MAX = 1, 7
ROD_DENSITY_DIVISOR = 28

# Rod geometry sampling.
HORIZONTAL, VERTICAL = "h", "v"
ORIENTATIONS = (HORIZONTAL, VERTICAL)
FIXED_SIGNS = (-1, 1)
ROD_LEN_MIN, ROD_LEN_MAX = 3, 12
FIXED_LEN_MIN, FIXED_LEN_MAX = 2, 9
TAIL_LEN_MAX = 5

# Placement and retry controls.
GAP_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))
MAX_GENERATE_ATTEMPTS = 300

Record = dict[str, object]
RecordKey = tuple[int, int, int, str]

_RECORD_CACHE: dict[int, list[tuple[RecordKey, Record]]] = {}


def _expanded(cells: set[tuple[int, int]], n: int) -> set[tuple[int, int]]:
    out = set(cells)
    shape = (n, n)
    for r, c in cells:
        for dr, dc in GAP_DIRECTIONS:
            nr, nc = r + dr, c + dc
            if in_bounds(shape, nr, nc):
                out.add((nr, nc))
    return out


def _fold_steps(n: int, orient: str, hinge: tuple[int, int], fixed_sign: int):
    """Return fixed-arm and fold steps, or None for a centered hinge."""
    r, c = hinge
    if orient == HORIZONTAL:
        up, down = r, n - 1 - r
        if up == down:
            return None
        return (0, fixed_sign), ((-1, 0) if up > down else (1, 0))

    left, right = c, n - 1 - c
    if left == right:
        return None
    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))


def _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:
    r, c = origin
    dr, dc = step
    return [(r + dr * k, c + dc * k) for k in range(1, count + 1)]


def _record(n: int, orient: str, fixed_len: int, tail_len: int, hinge: tuple[int, int], fixed_sign: int):
    steps = _fold_steps(n, orient, hinge, fixed_sign)
    if steps is None:
        return None

    fixed_step, fold_step = steps
    tail_step = (-fixed_step[0], -fixed_step[1])
    fixed = _ray_cells(hinge, fixed_step, fixed_len - 1)
    tail = _ray_cells(hinge, tail_step, tail_len)
    folded = _ray_cells(hinge, fold_step, tail_len)

    all_cells = fixed + tail + folded + [hinge]
    shape = (n, n)
    if any(not in_bounds(shape, rr, cc) for rr, cc in all_cells):
        return None

    endpoint = fixed[-1]
    fixed_red = fixed[:-1]
    input_cells = {hinge, endpoint, *fixed_red, *tail}
    envelope = input_cells | set(folded)
    if len(envelope) != len(input_cells) + len(folded):
        return None

    return {
        "hinge": hinge,
        "endpoint": endpoint,
        "fixed_red": fixed_red,
        "tail": tail,
        "folded": folded,
        "envelope": envelope,
        "red_count": fixed_len + tail_len - 2,
    }


def _all_records(n: int) -> list[tuple[RecordKey, Record]]:
    if n in _RECORD_CACHE:
        return _RECORD_CACHE[n]

    records: list[tuple[RecordKey, Record]] = []
    for orient in ORIENTATIONS:
        for total_len in range(ROD_LEN_MIN, ROD_LEN_MAX + 1):
            fixed_min = max(FIXED_LEN_MIN, total_len - TAIL_LEN_MAX)
            fixed_max = min(FIXED_LEN_MAX, total_len - 1)
            for fixed_len in range(fixed_min, fixed_max + 1):
                tail_len = total_len - fixed_len
                key = (total_len, fixed_len, tail_len, orient)
                for r in range(n):
                    for c in range(n):
                        for fixed_sign in FIXED_SIGNS:
                            rec = _record(n, orient, fixed_len, tail_len, (r, c), fixed_sign)
                            if rec is not None:
                                records.append((key, rec))
    _RECORD_CACHE[n] = records
    return records


def _choose_record(n: int, blocked: set[tuple[int, int]], rod_count: int, current_red: int, is_last: bool):
    by_key: dict[RecordKey, list[Record]] = {}
    for key, rec in _all_records(n):
        total_len = key[0]
        red_count = total_len - 2
        if is_last and current_red + red_count <= rod_count:
            continue
        if rec["envelope"] & blocked:
            continue
        by_key.setdefault(key, []).append(rec)

    if not by_key:
        return None

    totals = sorted({key[0] for key in by_key})
    total_len = random.choice(totals)
    fixed_lengths = sorted({key[1] for key in by_key if key[0] == total_len})
    fixed_len = random.choice(fixed_lengths)
    orientations = sorted({key[3] for key in by_key if key[:2] == (total_len, fixed_len)})
    orient = random.choice(orientations)
    tail_len = total_len - fixed_len
    return random.choice(by_key[(total_len, fixed_len, tail_len, orient)])


def _paint(records: list[Record], n: int) -> tuple[np.ndarray, np.ndarray]:
    inp = np.full((n, n), BG, dtype=int)
    out = np.full((n, n), BG, dtype=int)
    for rec in records:
        hinge = rec["hinge"]
        endpoint = rec["endpoint"]
        inp[hinge] = HINGE
        out[hinge] = HINGE
        inp[endpoint] = END
        out[endpoint] = END
        for p in rec["fixed_red"]:
            inp[p] = RED
            out[p] = RED
        for p in rec["tail"]:
            inp[p] = RED
        for p in rec["folded"]:
            out[p] = RED
    return inp, out


def _place_records(n: int, rod_count: int) -> list[Record] | None:
    """Sample non-touching rods and their fold envelopes for one grid."""
    blocked: set[tuple[int, int]] = set()
    records: list[Record] = []
    red_total = 0

    for i in range(rod_count):
        rec = _choose_record(n, blocked, rod_count, red_total, i == rod_count - 1)
        if rec is None:
            return None
        records.append(rec)
        red_total += int(rec["red_count"])
        blocked |= _expanded(rec["envelope"], n)
    return records


def _valid_generated_pair(inp: np.ndarray, out: np.ndarray, rod_count: int) -> bool:
    counts = {int(v): int(np.count_nonzero(inp == v)) for v in (BG, RED, HINGE, END)}
    if counts[RED] <= rod_count or counts[BG] <= counts[RED]:
        return False

    try:
        solved = main(inp)
    except Exception:
        return False
    return bool(np.array_equal(solved, out))


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    max_rods = max(ROD_COUNT_MIN, min(ROD_COUNT_MAX, (n * n) // ROD_DENSITY_DIVISOR))
    rod_count = random.randint(ROD_COUNT_MIN, max_rods)

    records = _place_records(n, rod_count)
    if records is None:
        return None
    inp, out = _paint(records, n)
    if not _valid_generated_pair(inp, out, rod_count):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATE_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 230f2e48 input")

