from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/4/010/9.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
out_sigs = set()
shapes = set()
noise_positions = {'corner': 0, 'edge': 0, 'interior': 0}
witness_counts = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    h, w = out.shape
    shapes.add((h, w))
    bad = None
    for pos, block in mod._blocks(inp, h, w):
        if len(set(map(int, np.unique(block))) - {0}) >= 2:
            assert bad is None
            bad = pos
    assert bad is not None
    r, c = bad
    if r in (0, h - 1) and c in (0, w - 1):
        noise_positions['corner'] += 1
    elif r in (0, h - 1) or c in (0, w - 1):
        noise_positions['edge'] += 1
    else:
        noise_positions['interior'] += 1
    witness_counts.add(int(np.count_nonzero(out == out[bad])) - 1)
print('variants', len(sigs))
print('output_variants', len(out_sigs), 'shapes', sorted(shapes))
print('noise_positions', noise_positions, 'witness_counts', sorted(witness_counts))
assert len(sigs) >= 20
assert len(out_sigs) >= 20
assert all(noise_positions.values())
assert {1, 2}.issubset(witness_counts) and max(witness_counts) >= 3
