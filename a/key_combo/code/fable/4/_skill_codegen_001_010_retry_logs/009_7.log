+
+
+@dataclass(frozen=True)
+class _Rect:
+    """A monochromatic solid rectangle with an inclusive (row, col) bbox."""
+
+    color: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def area(self) -> int:
+        return (self.r1 - self.r0 + 1) * (self.c1 - self.c0 + 1)
+
+    @property
+    def box(self) -> tuple[int, int, int, int]:
+        return self.r0, self.c0, self.r1, self.c1
