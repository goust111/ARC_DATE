+        c0 = int(rng.integers(sc0, sc1 - total_length + 2))
+        first = _Rect(colors[0], r0, c0, r0 + thickness - 1, c0 + depths[0] - 1)
+        second_c0 = first.c1 + gap + 1
+        second = _Rect(
