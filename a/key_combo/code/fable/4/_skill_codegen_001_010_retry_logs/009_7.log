+        )
+    else:
+        r0 = int(rng.integers(sr0, sr1 - total_length + 2))
+        c0 = int(rng.integers(sc0, sc1 - thickness + 2))
+        first = _Rect(colors[0], r0, c0, r0 + depths[0] - 1, c0 + thickness - 1)
+        second_r0 = first.r1 + gap + 1
+        second = _Rect(
