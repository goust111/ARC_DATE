    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert max(g.shape) <= 30, "ARC grids may not exceed 30 in either dimension"
    bg = _background(g)
    pairs = _facing_pairs(g, bg)

    out = g.copy()
    for pair in pairs:
        _grow_pair(out, pair)
    return out


