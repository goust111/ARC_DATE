+    full_sprite = _gen_sprite_from_mask(full_mask, bg)
+    source_patch = _gen_source_patch(n, half_cells, axis_cells, bg)
+
+    frames = _gen_place_frames(H, W, kinds, side, n)
+    if frames is None:
