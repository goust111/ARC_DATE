+        return (r1, c1) == point
+    if corner == "tr":
+        return (r1, c0) == point
+    if corner == "bl":
+        return (r0, c1) == point
+    if corner == "br":
+        return (r0, c0) == point
+    raise AssertionError(f"unknown corner: {corner}")
+
+
+def _axis_info(axis_coords: np.ndarray) -> tuple[str, int]:
