+            out[r, c] = YELLOW
+    for frame in frames:
+        oriented = _orient_sprite(full_sprite, source_kind, frame["kind"])
+        pr, pc = frame["paste"]
+        _stamp_sprite(out, oriented, pr, pc)
+    return out
