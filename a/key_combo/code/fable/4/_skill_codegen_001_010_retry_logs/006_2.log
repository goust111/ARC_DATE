+    seen = np.zeros_like(mask, dtype=bool)
+    H, W = mask.shape
+    count = 0
+    for r in range(H):
+        for c in range(W):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            stack = [(r, c)]
+            seen[r, c] = True
