+    return {
+        "kind": kind,
+        "missing": missing,
+        "markers": tuple(corners[k] for k in KINDS if k != kind),
+        "paste": (pr, pc),
+    }
+
+
+def _gen_candidate_frames(kind: str, H: int, W: int, side: int, n: int) -> list[dict]:
