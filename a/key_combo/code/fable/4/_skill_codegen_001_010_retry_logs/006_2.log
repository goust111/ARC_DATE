+
+def _gen_source_patch(n: int, half: set[tuple[int, int]], axis_cells: set[tuple[int, int]], bg: int) -> np.ndarray:
+    patch = np.full((n, n), int(bg), dtype=int)
+    for r, c in axis_cells:
+        patch[r, c] = GREY
+    for r, c in half:
+        patch[r, c] = RED
+    return patch
