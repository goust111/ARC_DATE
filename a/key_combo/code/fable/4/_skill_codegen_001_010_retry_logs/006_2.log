+def _gen_build_output(H: int, W: int, bg: int, frames: list[dict], full_sprite: np.ndarray, source_kind: str) -> np.ndarray:
+    out = np.full((H, W), int(bg), dtype=int)
+    for frame in frames:
+        for r, c in frame["markers"]:
+            out[r, c] = YELLOW
