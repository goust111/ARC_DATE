+# ---------------- generator ----------------
+
+GEN_RETRIES = 500
+GEN_BACKGROUNDS = (0, 1, 3, 6, 7, 8, 9)
+GEN_AXIS_KINDS = ("diag_main", "diag_anti")
+GEN_SPRITE_SIZES = (5, 6, 7)
