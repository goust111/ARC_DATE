+RED = 2
+YELLOW = 4
+GREY = 5
+
+KINDS = ("tl", "tr", "bl", "br")
+CORNER_SIGN = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
