+def _gen_paste_non_bg(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = patch.shape
+    mask = patch != int(bg)
+    target = out[r0 : r0 + h, c0 : c0 + w]
+    assert not np.any(target[mask] == YELLOW)
+    target[mask] = patch[mask]
