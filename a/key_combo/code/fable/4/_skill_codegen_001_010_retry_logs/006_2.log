+    H, W = paste_used.shape
+    pr, pc = frame["paste"]
+    paste_used[pr : pr + n, pc : pc + n] = True
+    pad = GEN_MARKER_CLEARANCE
+    for r, c in frame["markers"]:
+        marker_used[r, c] = True
+        marker_forbidden[max(0, r - pad) : min(H, r + pad + 1), max(0, c - pad) : min(W, c + pad + 1)] = True
+
