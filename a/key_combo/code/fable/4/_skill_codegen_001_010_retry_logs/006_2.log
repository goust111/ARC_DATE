+    sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    for rr, cc in np.vstack([red_coords, reflected]):
+        sprite[int(rr) - r0, int(cc) - c0] = RED
+    return sprite, box
