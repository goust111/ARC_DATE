+    pr, pc = frame["paste"]
+    if paste_used[pr : pr + n, pc : pc + n].any():
+        return False
+    if marker_used[pr : pr + n, pc : pc + n].any():
+        return False
+    for r, c in frame["markers"]:
+        if marker_forbidden[r, c] or paste_used[r, c]:
