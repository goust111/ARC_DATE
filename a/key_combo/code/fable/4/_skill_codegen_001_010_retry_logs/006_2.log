+def _signed_distance(pos: tuple[int, int], axis: tuple[str, int]) -> int:
+    r, c = pos
+    kind, value = axis
+    if kind == "h":
+        return int(r - value)
+    if kind == "v":
+        return int(c - value)
+    if kind == "diag_main":
+        return int(r - c - value)
+    if kind == "diag_anti":
+        return int(r + c - value)
+    raise AssertionError(f"unknown axis kind: {kind}")
+
+
+def _reflect_point(pos: tuple[int, int], axis: tuple[str, int]) -> tuple[int, int]:
+    r, c = pos
+    kind, value = axis
+    if kind == "h":
+        return 2 * value - r, c
+    if kind == "v":
+        return r, 2 * value - c
+    if kind == "diag_main":
+        return c + value, r - value
+    if kind == "diag_anti":
+        return value - c, value - r
+    raise AssertionError(f"unknown axis kind: {kind}")
