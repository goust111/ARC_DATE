from functools import lru_cache
from itertools import product

# Grid layout.
GRID_SHAPE = (10, 10)
MARKER_ROW, SEPARATOR_ROW, CODE_ROW = 0, 6, 8
BACKGROUND_COLOR, SEPARATOR_COLOR, MARKER_COLOR = 0, 5, 8
CODE_WIDTH = GRID_SHAPE[1]

# Sampling bounds and retry policy.
MARKER_LEN_RANGE, COLOR_COUNT_RANGE, COLOR_VALUE_RANGE = (1, 5), (2, 6), (1, 10)
MAX_MATCHING_COLORS, MAX_SELECTED_COLUMNS, RETRY_LIMIT = 3, 6, 300
CODE_PALETTE = tuple(c for c in range(*COLOR_VALUE_RANGE) if c != SEPARATOR_COLOR)

@lru_cache(maxsize=None)
def _gen_count_options(marker_len: int, color_count: int, matching_count: int) -> list[tuple[int, ...]]:
    """Return ordered non-matching color counts that fill the code row."""
    other_count = color_count - matching_count
    other_total = CODE_WIDTH - marker_len * matching_count
    return [
        counts
        for counts in product(range(1, other_total + 1), repeat=other_count)
        if sum(counts) == other_total and marker_len not in counts
    ]


def _count_plans(marker_len: int) -> list[tuple[int, int, list[tuple[int, ...]]]]:
    """Return feasible color-count plans with cached non-matching counts."""
    plans = []
    for color_count in range(*COLOR_COUNT_RANGE):
        max_matching = min(MAX_MATCHING_COLORS, color_count, MAX_SELECTED_COLUMNS // marker_len)
        for matching_count in range(1, max_matching + 1):
            options = _gen_count_options(marker_len, color_count, matching_count)
            if options:
                plans.append((color_count, matching_count, options))
    return plans


def _sample_code_values(marker_len, color_count, matching_count, options):
    """Sample a shuffled code row and the colors expected to trigger bars."""
    other_counts = list(options[int(np.random.randint(len(options)))])
    colors = list(np.random.choice(CODE_PALETTE, size=color_count, replace=False))
    matching_colors = colors[:matching_count]
    counts = [marker_len] * matching_count + other_counts
    code_values = [int(color) for color, count in zip(colors, counts) for _ in range(int(count))]
    np.random.shuffle(code_values)
    return code_values, matching_colors


def _render_case(marker_len, code_values, matching_colors):
    """Build the input grid and its oracle output for the sampled code row."""
    code_row = np.array(code_values, dtype=int)
    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)
    grid[MARKER_ROW, :marker_len] = MARKER_COLOR
    grid[SEPARATOR_ROW, :] = SEPARATOR_COLOR
    grid[CODE_ROW, :] = code_row
    expected = grid.copy()
    matching_mask = np.isin(code_row, matching_colors)
    expected[SEPARATOR_ROW - marker_len : SEPARATOR_ROW, matching_mask] = code_row[matching_mask]
    return grid, expected


def _gen_attempt() -> np.ndarray | None:
    marker_len = int(np.random.randint(*MARKER_LEN_RANGE))

    plans = _count_plans(marker_len)
    if not plans:
        return None

    color_count, matching_count, options = plans[int(np.random.randint(len(plans)))]
    code_values, matching_colors = _sample_code_values(marker_len, color_count, matching_count, options)
    grid, expected = _render_case(marker_len, code_values, matching_colors)

    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_coords, get_bg
import random


def _legend_pairs(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
    pairs: list[tuple[int, int]] = []
    for r in range(g.shape[0]):
        left = int(g[r, 0])
        right = int(g[r, 1])
        if left == bg or right == bg:
            break
        pairs.append((left, right))
    assert pairs, "expected a non-empty two-column legend at the upper left"
    return pairs


def main(grid: np.ndarray) -> np.ndarray:
    """Expand each sparse color object into a filled rectangular region using its legend-paired fill color.

    Input structure
    A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives
    a source color in the left column and that source color's fill color in the right column.  Outside the
    legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.

    Rule
    Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox
    by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired
    legend fill color while preserving every original non-legend dot.

    Key insight
    The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted
    from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape
    assert W >= 2, "expected room for a two-column legend"

    pairs = _legend_pairs(g, bg)
    source_colors = {source for source, _fill in pairs}
    assert len(source_colors) == len(pairs), "legend source colors must be unique"

    legend_mask = np.zeros(g.shape, dtype=bool)
    legend_mask[: len(pairs), :2] = True
    dot_mask = (g != bg) & ~legend_mask
    assert dot_mask.any(), "expected source dots outside the legend"
    assert set(map(int, g[dot_mask])).issubset(source_colors), "outside dots must use legend source colors"

    dots_by_color: dict[int, np.ndarray] = {}
    all_dots = np.zeros(g.shape, dtype=bool)
    for source, _fill in pairs:
        coords = np.argwhere(dot_mask & (g == source))
        assert coords.size, "each legend source color must appear outside the legend"
        dots_by_color[source] = coords
        all_dots[coords[:, 0], coords[:, 1]] = True

    out = np.full_like(g, bg)
    for source, fill in reversed(pairs):
        r0, c0, r1, c1 = bbox_coords(dots_by_color[source])
        r0 = max(0, r0 - 1)
        c0 = max(0, c0 - 1)
        r1 = min(H - 1, r1 + 1)
        c1 = min(W - 1, c1 + 1)

        region = out[r0 : r1 + 1, c0 : c1 + 1]
        background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]
        region[background_inside_region] = fill

    out[all_dots] = g[all_dots]
    return out

# --------------- generator (o5x) ---------------

# Canvas and legend geometry.
GRID_HEIGHT, GRID_WIDTH = 20, 20
BACKGROUND_COLOR = 0
LEGEND_COLS = 2
DOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1

# Legend palette sampling.
COLORS = tuple(range(1, 10))
PAIR_COUNT_CHOICES = (2, 3)
ROTATED_SOURCE_FILL_PROB = 0.45

# Dot-grid shape sampling.
DOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8
DOT_COLS_MIN, DOT_COLS_MAX = 2, 5

# Layout search.
THREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)
MODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = "overlap", "overlap_any", "separate", "any"
POST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)
POST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)

# Generation retry budget.
GENERATION_RETRIES = 300


def _origin_bbox(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> tuple[int, int, int, int]:
    r, c = origin
    return (
        r - BBOX_PAD,
        c - BBOX_PAD,
        r + DOT_STRIDE * (dot_rows - 1) + BBOX_PAD,
        c + DOT_STRIDE * (dot_cols - 1) + BBOX_PAD,
    )


def _hits_legend(box: tuple[int, int, int, int], n_pairs: int) -> bool:
    r0, c0, r1, c1 = box
    return r0 <= n_pairs - 1 and r1 >= 0 and c0 <= LEGEND_COLS - 1 and c1 >= 0


def _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:
    origins: list[tuple[int, int]] = []
    max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)
    max_c = GRID_WIDTH - 1 - BBOX_PAD - DOT_STRIDE * (dot_cols - 1)
    for r in range(BBOX_PAD, max_r + 1):
        for c in range(BBOX_PAD, max_c + 1):
            box = _origin_bbox((r, c), dot_rows, dot_cols)
            if not _hits_legend(box, n_pairs):
                origins.append((r, c))
    return origins


def _dot_coords(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> np.ndarray:
    rows = origin[0] + DOT_STRIDE * np.arange(dot_rows)
    cols = origin[1] + DOT_STRIDE * np.arange(dot_cols)
    rr, cc = np.meshgrid(rows, cols, indexing="ij")
    return np.stack([rr.ravel(), cc.ravel()], axis=1).astype(int)


def _expanded_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = bbox_coords(coords)
    return (
        max(0, r0 - BBOX_PAD),
        max(0, c0 - BBOX_PAD),
        min(GRID_HEIGHT - 1, r1 + BBOX_PAD),
        min(GRID_WIDTH - 1, c1 + BBOX_PAD),
    )


def _inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = box
    return (coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)


def _separated_by_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return (
        a[2] + NON_OVERLAP_GAP < b[0]
        or b[2] + NON_OVERLAP_GAP < a[0]
        or a[3] + NON_OVERLAP_GAP < b[1]
        or b[3] + NON_OVERLAP_GAP < a[1]
    )


def _intersection_bounds(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
) -> tuple[int, int, int, int] | None:
    r0, c0 = max(a[0], b[0]), max(a[1], b[1])
    r1, c1 = min(a[2], b[2]), min(a[3], b[3])
    if r0 > r1 or c0 > c1:
        return None
    return r0, c0, r1, c1


def _intersection_has_background(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int], dot_mask: np.ndarray
) -> bool:
    bounds = _intersection_bounds(a, b)
    if bounds is None:
        return False
    r0, c0, r1, c1 = bounds
    return bool((~dot_mask[r0 : r1 + 1, c0 : c1 + 1]).any())


def _remove_dots_covered_by_higher_priority(
    coords: np.ndarray, higher_boxes: list[tuple[int, int, int, int]]
) -> np.ndarray:
    keep = np.ones(len(coords), dtype=bool)
    for box in higher_boxes:
        keep &= ~_inside_box(coords, box)
    return coords[keep]


def _scene_data(
    sizes: list[tuple[int, int]], origins: list[tuple[int, int]]
) -> tuple[list[np.ndarray], list[tuple[int, int, int, int]], np.ndarray] | None:
    remaining: list[np.ndarray] = []
    boxes: list[tuple[int, int, int, int]] = []
    dot_mask = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)

    for (dot_rows, dot_cols), origin in zip(sizes, origins):
        coords = _remove_dots_covered_by_higher_priority(_dot_coords(origin, dot_rows, dot_cols), boxes)
        if coords.size == 0:
            return None
        if len(set(map(int, coords[:, 0]))) != dot_rows or len(set(map(int, coords[:, 1]))) != dot_cols:
            return None
        if dot_mask[coords[:, 0], coords[:, 1]].any():
            return None
        dot_mask[coords[:, 0], coords[:, 1]] = True
        remaining.append(coords)
        boxes.append(_expanded_bbox(coords))

    return remaining, boxes, dot_mask


def _render_output(
    pairs: list[tuple[int, int]], remaining: list[np.ndarray], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray
) -> np.ndarray:
    out = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    for idx in range(len(pairs) - 1, -1, -1):
        _source, fill = pairs[idx]
        r0, c0, r1, c1 = boxes[idx]
        region = out[r0 : r1 + 1, c0 : c1 + 1]
        region[~dot_mask[r0 : r1 + 1, c0 : c1 + 1]] = fill
    for (source, _fill), coords in zip(pairs, remaining):
        out[coords[:, 0], coords[:, 1]] = source
    return out


def _build_input(pairs: list[tuple[int, int]], remaining: list[np.ndarray]) -> np.ndarray:
    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    grid[: len(pairs), :LEGEND_COLS] = np.asarray(pairs, dtype=int)
    for (source, _fill), coords in zip(pairs, remaining):
        grid[coords[:, 0], coords[:, 1]] = source
    return grid


def _visible_overlap(
    pairs: list[tuple[int, int]], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray, out: np.ndarray
) -> bool:
    for hi in range(len(pairs)):
        for lo in range(hi + 1, len(pairs)):
            bounds = _intersection_bounds(boxes[hi], boxes[lo])
            if bounds is None:
                continue
            r0, c0, r1, c1 = bounds
            overlap_fill = (~dot_mask[r0 : r1 + 1, c0 : c1 + 1]) & (
                out[r0 : r1 + 1, c0 : c1 + 1] == pairs[hi][1]
            )
            lr0, lc0, lr1, lc1 = boxes[lo]
            lower_fill = (~dot_mask[lr0 : lr1 + 1, lc0 : lc1 + 1]) & (
                out[lr0 : lr1 + 1, lc0 : lc1 + 1] == pairs[lo][1]
            )
            if overlap_fill.any() and lower_fill.any():
                return True
    return False


def _choose_pairs(n_pairs: int) -> list[tuple[int, int]]:
    colors = list(COLORS)
    sources = random.sample(colors, n_pairs)
    non_sources = [c for c in colors if c not in sources]
    if random.random() < ROTATED_SOURCE_FILL_PROB:
        fills = sources[1:] + sources[:1]
        replace_count = random.randint(0, n_pairs)
        for idx, color in zip(random.sample(range(n_pairs), replace_count), random.sample(non_sources, replace_count)):
            fills[idx] = color
    else:
        fills = random.sample(non_sources, n_pairs)
    return list(zip(sources, fills))


def _candidate_origins(
    sizes: list[tuple[int, int]],
    origins: list[tuple[int, int]],
    legal: list[tuple[int, int]],
    mode: str,
    target: int | None = None,
) -> list[tuple[int, int]]:
    candidates: list[tuple[int, int]] = []
    for origin in legal:
        data = _scene_data(sizes[: len(origins) + 1], origins + [origin])
        if data is None:
            continue
        _remaining, boxes, dot_mask = data
        new_box = boxes[-1]
        if mode == MODE_OVERLAP:
            assert target is not None
            if not _intersection_has_background(new_box, boxes[target], dot_mask):
                continue
        elif mode == MODE_OVERLAP_ANY:
            if not any(_intersection_has_background(new_box, old_box, dot_mask) for old_box in boxes[:-1]):
                continue
        elif mode == MODE_SEPARATE:
            if not all(_separated_by_gap(new_box, old_box) for old_box in boxes[:-1]):
                continue
        candidates.append(origin)
    return candidates


def _choose_origins(n_pairs: int, sizes: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
    legal = [_legal_origins(n_pairs, dot_rows, dot_cols) for dot_rows, dot_cols in sizes]
    if any(not options for options in legal):
        return None

    origins = [random.choice(legal[0])]
    forced_step = 1 if n_pairs == 2 else random.choice(THREE_PAIR_FORCED_OVERLAP_STEPS)
    for idx in range(1, n_pairs):
        if idx == forced_step:
            target = random.randrange(idx)
            candidates = _candidate_origins(sizes, origins, legal[idx], MODE_OVERLAP, target)
        elif idx < forced_step:
            candidates = _candidate_origins(sizes, origins, legal[idx], MODE_SEPARATE)
            if not candidates:
                candidates = _candidate_origins(sizes, origins, legal[idx], MODE_ANY)
        else:
            mode = random.choices(POST_FORCED_LAYOUT_MODES, weights=POST_FORCED_LAYOUT_WEIGHTS, k=1)[0]
            candidates = _candidate_origins(sizes, origins, legal[idx], mode)
            if not candidates:
                candidates = _candidate_origins(sizes, origins, legal[idx], MODE_ANY)
        if not candidates:
            return None
        origins.append(random.choice(candidates))
    return origins


def _gen_attempt() -> np.ndarray | None:
    n_pairs = random.choice(PAIR_COUNT_CHOICES)
    pairs = _choose_pairs(n_pairs)
    sizes = [
        (random.randint(DOT_ROWS_MIN, DOT_ROWS_MAX), random.randint(DOT_COLS_MIN, DOT_COLS_MAX))
        for _ in range(n_pairs)
    ]
    origins = _choose_origins(n_pairs, sizes)
    if origins is None:
        return None

    data = _scene_data(sizes, origins)
    if data is None:
        return None
    remaining, boxes, dot_mask = data
    out = _render_output(pairs, remaining, boxes, dot_mask)
    if not _visible_overlap(pairs, boxes, dot_mask, out):
        return None

    inp = _build_input(pairs, remaining)
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 305b1341 input")
from collections import Counter, deque

import numpy as np

from arc_utils import components_mask as _gen_components_mask, get_bg, neighbors4
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Flood-fill each marked chamber bounded by walls with its marker color.

    Input structure
    A same-size grid has a dominant background/open color, one repeated wall color,
    and one-cell colored markers sitting inside some wall-bounded open chambers.

    Rule
    Infer the wall as the unique non-background color that appears more than once.
    Treat wall pixels as barriers. For every 4-connected non-wall component, leave
    it unchanged if it has no marker; otherwise assert it has exactly one marker and
    recolor the whole component with that marker's color.

    Key insight
    The repeated color is a maze wall that partitions the background into chambers;
    the singleton marker inside a chamber supplies the fill color for that chamber.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()
    bg = get_bg(g)

    counts = Counter(map(int, g.ravel()))
    wall_colors = [color for color, count in counts.items() if color != bg and count > 1]
    assert len(wall_colors) == 1
    wall = wall_colors[0]

    marker_colors = [color for color in counts if color not in (bg, wall)]
    assert all(counts[color] == 1 for color in marker_colors)

    h, w = g.shape
    seen = np.zeros(g.shape, dtype=bool)
    for sr in range(h):
        for sc in range(w):
            if seen[sr, sc] or g[sr, sc] == wall:
                continue

            component = []
            markers = []
            queue = deque([(sr, sc)])
            seen[sr, sc] = True
            while queue:
                r, c = queue.popleft()
                component.append((r, c))
                if g[r, c] != bg:
                    markers.append((r, c))
                for nr, nc in neighbors4(r, c):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] != wall:
                        seen[nr, nc] = True
                        queue.append((nr, nc))

            if markers:
                assert len(markers) == 1
                color = int(g[markers[0]])
                for r, c in component:
                    out[r, c] = color

    return out

# --------------- generator (o5x) ---------------

# Neighborhood and sentinel values.
_GEN_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
_GEN_EMPTY_LABEL, _GEN_BG_COLOR, _GEN_WALL_COLOR = -1, 0, 5
# Canvas, component counts, and wall budgets.
_GEN_GRID_SIZES = [7, 9]
_GEN_MARKED_COUNTS = [2, 3]
_GEN_UNMARKED_COUNTS_7 = [5, 5, 6, 6, 7, 8]
_GEN_UNMARKED_COUNT_RANGE_9 = (5, 8)
_GEN_WALL_COUNTS_7 = [19, 20, 21]
_GEN_WALL_COUNTS_9 = [32, 33, 34, 35, 36]
_GEN_MAX_WALL_COMPONENT_7, _GEN_MAX_WALL_COMPONENT_9 = 9, 12
# Chamber size ranges.
_GEN_MARKED_SIZE_RANGE, _GEN_UNMARKED_SIZE_RANGE = (3, 13), (1, 10)
# Validation thresholds.
_GEN_MIN_WALL_4_COMPONENTS = 5
_GEN_WALL_8_COMPONENT_MIN_FRACTION = 0.75
_GEN_BORDER_WALL_RANGE = (8, 12)
# Retry limits and marker palette.
_GEN_START_TRIAL_LIMIT, _GEN_GROW_RESTARTS, _GEN_RETRY_LIMIT = 80, 8, 300
_GEN_MARKER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]


def _gen_sample_counts(n):
    marked_count = random.choice(_GEN_MARKED_COUNTS)
    if n == 7:
        unmarked_count = random.choice(_GEN_UNMARKED_COUNTS_7)
        wall_count = random.choice(_GEN_WALL_COUNTS_7)
        max_wall_component = _GEN_MAX_WALL_COMPONENT_7
    else:
        unmarked_count = random.randint(*_GEN_UNMARKED_COUNT_RANGE_9)
        wall_count = random.choice(_GEN_WALL_COUNTS_9)
        max_wall_component = _GEN_MAX_WALL_COMPONENT_9
    return marked_count, unmarked_count, wall_count, max_wall_component


def _gen_sample_component_sizes(total_open, marked_count, unmarked_count):
    marked_min, marked_max = _GEN_MARKED_SIZE_RANGE
    unmarked_min, unmarked_max = _GEN_UNMARKED_SIZE_RANGE
    mins = [marked_min] * marked_count + [unmarked_min] * unmarked_count
    maxs = [marked_max] * marked_count + [unmarked_max] * unmarked_count
    order = list(range(len(mins)))
    random.shuffle(order)

    values = [None] * len(mins)
    remaining = total_open
    for pos, idx in enumerate(order):
        rest = order[pos + 1 :]
        lo = max(mins[idx], remaining - sum(maxs[j] for j in rest))
        hi = min(maxs[idx], remaining - sum(mins[j] for j in rest))
        if lo > hi:
            return None
        values[idx] = random.randint(lo, hi)
        remaining -= values[idx]

    return values[:marked_count], values[marked_count:]


def _gen_can_use_cell(cell, labels, label):
    empty, dirs = _GEN_EMPTY_LABEL, _GEN_DIRS
    n = labels.shape[0]
    r, c = cell
    if not (0 <= r < n and 0 <= c < n) or labels[r, c] != empty:
        return False
    for dr, dc in dirs:
        nr, nc = r + dr, c + dc
        if 0 <= nr < n and 0 <= nc < n:
            neighbor_label = labels[nr, nc]
            if neighbor_label != empty and neighbor_label != label:
                return False
    return True


def _gen_place_component(labels, size, label, *, must_touch_border=False):
    empty, dirs = _GEN_EMPTY_LABEL, _GEN_DIRS
    n = labels.shape[0]
    starts = [(r, c) for r in range(n) for c in range(n) if labels[r, c] == empty]
    if must_touch_border:
        starts = [cell for cell in starts if cell[0] in (0, n - 1) or cell[1] in (0, n - 1)]
    random.shuffle(starts)

    for seed in starts[:_GEN_START_TRIAL_LIMIT]:
        for _ in range(_GEN_GROW_RESTARTS):
            if not _gen_can_use_cell(seed, labels, label):
                continue

            cells = {seed}
            labels[seed] = label
            ok = True
            for _ in range(size - 1):
                frontier = []
                for r, c in cells:
                    for dr, dc in dirs:
                        nr, nc = r + dr, c + dc
                        if not _gen_can_use_cell((nr, nc), labels, label):
                            continue
                        same_neighbors = 0
                        for er, ec in dirs:
                            rr, cc = nr + er, nc + ec
                            if 0 <= rr < n and 0 <= cc < n and labels[rr, cc] == label:
                                same_neighbors += 1
                        frontier.extend([(nr, nc)] * (1 + same_neighbors))

                if not frontier:
                    ok = False
                    break

                cell = random.choice(frontier)
                cells.add(cell)
                labels[cell] = label

            if ok:
                return cells

            for r, c in cells:
                labels[r, c] = empty

    return None


def _gen_place_components(labels, marked_sizes, unmarked_sizes):
    """Place all chamber labels; returns marked/unmarked component sets or None."""
    items = [("marked", size) for size in marked_sizes]
    items.extend(("unmarked", size) for size in unmarked_sizes)
    random.shuffle(items)
    items.sort(key=lambda item: item[1], reverse=True)

    marked_components = []
    unmarked_components = []
    for label, (role, size) in enumerate(items):
        component = _gen_place_component(
            labels,
            size,
            label,
            must_touch_border=(role == "marked"),
        )
        if component is None: return None
        (marked_components if role == "marked" else unmarked_components).append(component)

    return marked_components, unmarked_components


def _gen_border_wall_count(wall_mask):
    total = wall_mask[0].sum() + wall_mask[-1].sum()
    return int(total + wall_mask[1:-1, 0].sum() + wall_mask[1:-1, -1].sum())


def _gen_layout_is_valid(labels, marked_sizes, unmarked_sizes, wall_count, max_wall_component):
    """Validate chamber sizes and wall connectivity against the sampled plan."""
    wall_mask = labels == _GEN_EMPTY_LABEL
    actual_sizes = sorted(len(comp) for comp in _gen_components_mask(~wall_mask, connectivity=4))
    if actual_sizes != sorted(marked_sizes + unmarked_sizes):
        return False

    wall_components4 = _gen_components_mask(wall_mask, connectivity=4)
    if len(wall_components4) < _GEN_MIN_WALL_4_COMPONENTS or max(len(comp) for comp in wall_components4) > max_wall_component:
        return False

    wall_components8 = _gen_components_mask(wall_mask, connectivity=8)
    if max(len(comp) for comp in wall_components8) < int(wall_count * _GEN_WALL_8_COMPONENT_MIN_FRACTION):
        return False

    border_min, border_max = _GEN_BORDER_WALL_RANGE
    if not (border_min <= _gen_border_wall_count(wall_mask) <= border_max):
        return False

    return True


def _gen_render_pair(n, marked_components, unmarked_components):
    """Build the solved grid and corresponding input with one visible seed per marked chamber."""
    out = np.full((n, n), _GEN_WALL_COLOR, dtype=int)
    for component in unmarked_components:
        for r, c in component:
            out[r, c] = _GEN_BG_COLOR

    marker_colors = random.sample(_GEN_MARKER_COLORS, len(marked_components))
    inp = out.copy()
    for color, component in zip(marker_colors, marked_components):
        cells = list(component)
        for r, c in cells:
            out[r, c] = color
            inp[r, c] = _GEN_BG_COLOR
        r, c = random.choice(cells)
        inp[r, c] = color

    return inp, out


def _gen_attempt(_gen_n=None):
    n = _gen_n if _gen_n is not None else random.choice(_GEN_GRID_SIZES)
    marked_count, unmarked_count, wall_count, max_wall_component = _gen_sample_counts(n)
    sampled = _gen_sample_component_sizes(n * n - wall_count, marked_count, unmarked_count)
    if sampled is None: return None
    marked_sizes, unmarked_sizes = sampled

    labels = np.full((n, n), _GEN_EMPTY_LABEL, dtype=int)
    placed = _gen_place_components(labels, marked_sizes, unmarked_sizes)
    if placed is None:
        return None
    marked_components, unmarked_components = placed

    if not _gen_layout_is_valid(labels, marked_sizes, unmarked_sizes, wall_count, max_wall_component):
        return None

    inp, out = _gen_render_pair(n, marked_components, unmarked_components)
    try:
        solved = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(solved, out):
        return None

    return inp


def generate_input():
    n = random.choice(_GEN_GRID_SIZES)
    for _ in range(_GEN_RETRY_LIMIT):
        grid = _gen_attempt(n)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate e69241bd input")
import numpy as np

from arc_utils import Color
import random


def _infer_minimal_tile(g: np.ndarray) -> np.ndarray:
    height, width = map(int, g.shape)
    known = g != Color.BLACK
    assert np.any(~known), "expected black missing pixels"

    candidates: list[tuple[int, np.ndarray]] = []
    for tile_h in range(1, height + 1):
        for tile_w in range(1, width + 1):
            tile = np.full((tile_h, tile_w), -1, dtype=int)
            valid = True
            for r, c in np.argwhere(known):
                tr, tc = int(r) % tile_h, int(c) % tile_w
                value = int(g[r, c])
                if tile[tr, tc] == -1:
                    tile[tr, tc] = value
                elif tile[tr, tc] != value:
                    valid = False
                    break
            if valid and np.all(tile != -1):
                candidates.append((tile_h * tile_w, tile))

    assert candidates, "expected a fully observed repeating tile"
    best_area = min(area for area, _ in candidates)
    best = [tile for area, tile in candidates if area == best_area]
    assert len(best) == 1, "expected a unique minimal repeating tile"
    return best[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the black holes by continuing the smallest repeating non-black wallpaper pattern.

    Input structure:
    - The grid is a rectangular wallpaper pattern with some cells replaced by black.
    - Every phase of the true repeating tile is visible at least once in a non-black cell.
    - The smallest fully observed tile consistent with the non-black cells is unique.

    Rule:
    - Ignore black pixels while inferring the repeating tile.
    - Find the unique minimal-area tile whose row/column phases agree with all non-black cells.
    - Replace every grid cell by the color at its corresponding tile phase.

    Key insight:
    - Black is missing data, not part of the wallpaper; the observed colored cells determine the latent periodic tile.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    tile = _infer_minimal_tile(g)
    tile_h, tile_w = map(int, tile.shape)
    rows = np.arange(g.shape[0])[:, None] % tile_h
    cols = np.arange(g.shape[1])[None, :] % tile_w
    out = tile[rows, cols]
    assert np.all(out[g != Color.BLACK] == g[g != Color.BLACK]), "tile must preserve all known cells"
    return out

# --------------- generator (o5x) ---------------

# Canvas and latent tile bounds.
CANVAS_SIZE = 25
TILE_HEIGHT_RANGE = (4, 9)
TILE_WIDTH_RANGE = (2, 9)
GRID_LINE_COLOR = Color.BLUE
OUTER_GRID_LINE_INDEX = 0
MISSING_COLOR = Color.BLACK

# Interior grid-line and color sampling.
LINE_MIN_LENGTH = 6
LINE_PROBABILITY = 0.35
LINE_STEP_RANGE = (3, 5)
INNER_COLOR_COUNT_RANGE = (2, 3)
NON_BLUE_COLORS = [2, 3, 4, 5, 6, 7, 8, 9]

# Black-hole blob sampling and placement.
BLOB_COUNT_RANGE = (3, 4)
BLACK_TOTAL_RANGE = (50, 81)
BLOB_SIZE_RANGE = (4, 55)
BLOB_HEIGHT_RANGE = (2, 11)
BLOB_WIDTH_RANGE = (2, 9)
BLOB_MIN_FILL_RATIO = 0.56
RECT_BLOB_PROBABILITY = 0.35
BORDER_MARGIN = 1
NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Outer retry budget for rejected tile/placement attempts.
GEN_RETRY_LIMIT = 300


def _gen_line_positions(length: int) -> set[int]:
    lines = {OUTER_GRID_LINE_INDEX}
    if length >= LINE_MIN_LENGTH and random.random() < LINE_PROBABILITY:
        step = random.randint(LINE_STEP_RANGE[0], min(LINE_STEP_RANGE[1], length - 1))
        lines.update(range(step, length, step))
    return lines


def _gen_neighbors(r: int, c: int, height: int, width: int):
    """Yield in-bounds 4-neighbors in the legacy order."""
    for dr, dc in NEIGHBORS_4:
        nr, nc = r + dr, c + dc
        if 0 <= nr < height and 0 <= nc < width:
            yield int(nr), int(nc)


def _gen_inner_orbits(rows: list[int], cols: list[int]) -> list[list[tuple[int, int]]]:
    """Group inner tile cells into LR+UD symmetry orbits."""
    orbits = []
    for i in range((len(rows) + 1) // 2):
        paired_rows = {rows[i], rows[-1 - i]}
        for j in range((len(cols) + 1) // 2):
            paired_cols = {cols[j], cols[-1 - j]}
            orbits.append([(r, c) for r in paired_rows for c in paired_cols])
    return orbits


def _gen_min_period(tile: np.ndarray) -> tuple[int, int]:
    h, w = tile.shape
    rows = np.arange(h)[:, None]
    cols = np.arange(w)[None, :]
    for th in range(1, h + 1):
        for tw in range(1, w + 1):
            if np.array_equal(tile, tile[rows % th, cols % tw]):
                return th, tw
    return h, w


def _gen_build_tile() -> np.ndarray | None:
    """Sample a full-period symmetric tile, or reject it."""
    tile_h = random.randint(*TILE_HEIGHT_RANGE)
    tile_w = random.randint(*TILE_WIDTH_RANGE)
    row_lines = _gen_line_positions(tile_h)
    col_lines = _gen_line_positions(tile_w)
    inner_rows = [r for r in range(tile_h) if r not in row_lines]
    inner_cols = [c for c in range(tile_w) if c not in col_lines]
    orbits = _gen_inner_orbits(inner_rows, inner_cols)
    if len(orbits) < 2:
        return None

    n_colors = random.randint(INNER_COLOR_COUNT_RANGE[0], min(INNER_COLOR_COUNT_RANGE[1], len(orbits)))
    colors = random.sample(NON_BLUE_COLORS, n_colors)
    values = colors + [random.choice(colors) for _ in range(len(orbits) - n_colors)]
    random.shuffle(values)

    tile = np.full((tile_h, tile_w), GRID_LINE_COLOR, dtype=int)
    for cells, color in zip(orbits, values):
        for r, c in cells:
            tile[r, c] = color

    if _gen_min_period(tile) != (tile_h, tile_w):
        return None
    return tile


def _gen_wallpaper(tile: np.ndarray) -> np.ndarray:
    h, w = tile.shape
    rows = np.arange(CANVAS_SIZE)[:, None] % h
    cols = np.arange(CANVAS_SIZE)[None, :] % w
    return tile[rows, cols]


def _gen_blob_sizes(count: int, total: int) -> list[int]:
    sizes = []
    remaining = total
    for i in range(count):
        left = count - i - 1
        lo = max(BLOB_SIZE_RANGE[0], remaining - BLOB_SIZE_RANGE[1] * left)
        hi = min(BLOB_SIZE_RANGE[1], remaining - BLOB_SIZE_RANGE[0] * left)
        size = random.randint(lo, hi)
        sizes.append(size)
        remaining -= size
    random.shuffle(sizes)
    return sizes


def _gen_blob_shape(size: int) -> np.ndarray | None:
    """Sample a connected blob mask with the requested area."""
    dims = [
        (h, w)
        for h in range(BLOB_HEIGHT_RANGE[0], BLOB_HEIGHT_RANGE[1] + 1)
        for w in range(BLOB_WIDTH_RANGE[0], BLOB_WIDTH_RANGE[1] + 1)
        if h + w - 1 <= size <= h * w and size / (h * w) >= BLOB_MIN_FILL_RATIO
    ]
    if not dims:
        return None

    rect_dims = [(h, w) for h, w in dims if h * w == size]
    if rect_dims and random.random() < RECT_BLOB_PROBABILITY:
        h, w = random.choice(rect_dims)
        return np.ones((h, w), dtype=bool)

    h, w = random.choice(dims)
    mask = np.zeros((h, w), dtype=bool)
    r = c = 0
    mask[r, c] = True
    steps = [(1, 0)] * (h - 1) + [(0, 1)] * (w - 1)
    random.shuffle(steps)
    for dr, dc in steps:
        r += dr
        c += dc
        mask[r, c] = True

    while int(mask.sum()) < size:
        frontier = []
        for rr, cc in np.argwhere(mask):
            for nr, nc in _gen_neighbors(rr, cc, h, w):
                if not mask[nr, nc]:
                    frontier.append((int(nr), int(nc)))
        if not frontier:
            return None
        nr, nc = random.choice(frontier)
        mask[nr, nc] = True
    return mask


def _gen_touches_existing(mask: np.ndarray, cells: list[tuple[int, int]]) -> bool:
    for r, c in cells:
        if mask[r, c]:
            return True
        for nr, nc in _gen_neighbors(r, c, CANVAS_SIZE, CANVAS_SIZE):
            if mask[nr, nc]:
                return True
    return False


def _gen_phase_counts(tile_h: int, tile_w: int) -> np.ndarray:
    rows = np.arange(CANVAS_SIZE) % tile_h
    cols = np.arange(CANVAS_SIZE) % tile_w
    counts = np.zeros((tile_h, tile_w), dtype=int)
    np.add.at(counts, (rows[:, None], cols[None, :]), 1)
    return counts


def _gen_place_blob(
    black: np.ndarray, shape: np.ndarray, phase_counts: np.ndarray, tile_h: int, tile_w: int
) -> bool:
    """Place one blob without touching existing blobs or hiding a tile phase."""
    h, w = shape.shape
    offsets = [(int(r), int(c)) for r, c in np.argwhere(shape)]
    choices = []
    for r0 in range(BORDER_MARGIN, CANVAS_SIZE - h):
        for c0 in range(BORDER_MARGIN, CANVAS_SIZE - w):
            cells = [(r0 + r, c0 + c) for r, c in offsets]
            if _gen_touches_existing(black, cells):
                continue
            next_counts = phase_counts.copy()
            for r, c in cells:
                next_counts[r % tile_h, c % tile_w] -= 1
            if np.all(next_counts > 0):
                choices.append((r0, c0, next_counts))
    if not choices:
        return False

    r0, c0, next_counts = random.choice(choices)
    for r, c in offsets:
        black[r0 + r, c0 + c] = True
    phase_counts[:, :] = next_counts
    return True


def _gen_attempt() -> np.ndarray | None:
    """Run one output-first generation attempt and oracle-check it."""
    tile = _gen_build_tile()
    if tile is None:
        return None

    out = _gen_wallpaper(tile)
    tile_h, tile_w = tile.shape
    blob_count = random.randint(*BLOB_COUNT_RANGE)
    total_black = random.randint(*BLACK_TOTAL_RANGE)
    sizes = _gen_blob_sizes(blob_count, total_black)
    black = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)
    phase_counts = _gen_phase_counts(tile_h, tile_w)

    for size in sizes:
        shape = _gen_blob_shape(size)
        if shape is None or not _gen_place_blob(black, shape, phase_counts, tile_h, tile_w):
            return None

    inp = out.copy()
    inp[black] = MISSING_COLOR
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

