+def _expected_from_states(states: np.ndarray, background: int, foregrounds: list[int]) -> np.ndarray:
+    """Independent truth table: 011, 101, and 110 select their absent color."""
+    lookup = np.array(
+        [
+            background,
+            foregrounds[0],
+            foregrounds[1],
+            foregrounds[2],
+            foregrounds[2],
+            foregrounds[1],
+            foregrounds[0],
+            background,
+        ],
+        dtype=int,
