from collections import Counter, deque

import numpy as np

from arc_utils import components_mask as _gen_components_mask, get_bg, neighbors4
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Flood-fill each marked chamber bounded by walls with its marker color.

    Input structure
    A same-size grid has a dominant background/open color, one repeated wall color,
    and one-cell colored markers sitting inside some wall-bounded open chambers.

    Rule
    Infer the wall as the unique non-background color that appears more than once.
    Treat wall pixels as barriers. For every 4-connected non-wall component, leave
    it unchanged if it has no marker; otherwise assert it has exactly one marker and
    recolor the whole component with that marker's color.

    Key insight
    The repeated color is a maze wall that partitions the background into chambers;
    the singleton marker inside a chamber supplies the fill color for that chamber.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()
    bg = get_bg(g)

    counts = Counter(map(int, g.ravel()))
    wall_colors = [color for color, count in counts.items() if color != bg and count > 1]
    assert len(wall_colors) == 1
    wall = wall_colors[0]

    marker_colors = [color for color in counts if color not in (bg, wall)]
    assert all(counts[color] == 1 for color in marker_colors)

    h, w = g.shape
    seen = np.zeros(g.shape, dtype=bool)
    for sr in range(h):
        for sc in range(w):
            if seen[sr, sc] or g[sr, sc] == wall:
                continue

            component = []
            markers = []
            queue = deque([(sr, sc)])
            seen[sr, sc] = True
            while queue:
                r, c = queue.popleft()
                component.append((r, c))
                if g[r, c] != bg:
                    markers.append((r, c))
                for nr, nc in neighbors4(r, c):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] != wall:
                        seen[nr, nc] = True
                        queue.append((nr, nc))

            if markers:
                assert len(markers) == 1
                color = int(g[markers[0]])
                for r, c in component:
                    out[r, c] = color

    return out

# --------------- generator (o5x) ---------------

# Neighborhood and sentinel values.
_GEN_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
_GEN_EMPTY_LABEL, _GEN_BG_COLOR, _GEN_WALL_COLOR = -1, 0, 5
# Canvas, component counts, and wall budgets.
_GEN_GRID_SIZES = [7, 9]
_GEN_MARKED_COUNTS = [2, 3]
_GEN_UNMARKED_COUNTS_7 = [5, 5, 6, 6, 7, 8]
_GEN_UNMARKED_COUNT_RANGE_9 = (5, 8)
_GEN_WALL_COUNTS_7 = [19, 20, 21]
_GEN_WALL_COUNTS_9 = [32, 33, 34, 35, 36]
_GEN_MAX_WALL_COMPONENT_7, _GEN_MAX_WALL_COMPONENT_9 = 9, 12
# Chamber size ranges.
_GEN_MARKED_SIZE_RANGE, _GEN_UNMARKED_SIZE_RANGE = (3, 13), (1, 10)
# Validation thresholds.
_GEN_MIN_WALL_4_COMPONENTS = 5
_GEN_WALL_8_COMPONENT_MIN_FRACTION = 0.75
_GEN_BORDER_WALL_RANGE = (8, 12)
# Retry limits and marker palette.
_GEN_START_TRIAL_LIMIT, _GEN_GROW_RESTARTS, _GEN_RETRY_LIMIT = 80, 8, 300
_GEN_MARKER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]


def _gen_sample_counts(n):
    marked_count = random.choice(_GEN_MARKED_COUNTS)
    if n == 7:
        unmarked_count = random.choice(_GEN_UNMARKED_COUNTS_7)
        wall_count = random.choice(_GEN_WALL_COUNTS_7)
        max_wall_component = _GEN_MAX_WALL_COMPONENT_7
    else:
        unmarked_count = random.randint(*_GEN_UNMARKED_COUNT_RANGE_9)
        wall_count = random.choice(_GEN_WALL_COUNTS_9)
        max_wall_component = _GEN_MAX_WALL_COMPONENT_9
    return marked_count, unmarked_count, wall_count, max_wall_component


def _gen_sample_component_sizes(total_open, marked_count, unmarked_count):
    marked_min, marked_max = _GEN_MARKED_SIZE_RANGE
    unmarked_min, unmarked_max = _GEN_UNMARKED_SIZE_RANGE
    mins = [marked_min] * marked_count + [unmarked_min] * unmarked_count
    maxs = [marked_max] * marked_count + [unmarked_max] * unmarked_count
    order = list(range(len(mins)))
    random.shuffle(order)

    values = [None] * len(mins)
    remaining = total_open
    for pos, idx in enumerate(order):
        rest = order[pos + 1 :]
        lo = max(mins[idx], remaining - sum(maxs[j] for j in rest))
        hi = min(maxs[idx], remaining - sum(mins[j] for j in rest))
        if lo > hi:
            return None
        values[idx] = random.randint(lo, hi)
        remaining -= values[idx]

    return values[:marked_count], values[marked_count:]


def _gen_can_use_cell(cell, labels, label):
    empty, dirs = _GEN_EMPTY_LABEL, _GEN_DIRS
    n = labels.shape[0]
    r, c = cell
    if not (0 <= r < n and 0 <= c < n) or labels[r, c] != empty:
        return False
    for dr, dc in dirs:
        nr, nc = r + dr, c + dc
        if 0 <= nr < n and 0 <= nc < n:
            neighbor_label = labels[nr, nc]
            if neighbor_label != empty and neighbor_label != label:
                return False
    return True


def _gen_place_component(labels, size, label, *, must_touch_border=False):
    empty, dirs = _GEN_EMPTY_LABEL, _GEN_DIRS
    n = labels.shape[0]
    starts = [(r, c) for r in range(n) for c in range(n) if labels[r, c] == empty]
    if must_touch_border:
        starts = [cell for cell in starts if cell[0] in (0, n - 1) or cell[1] in (0, n - 1)]
    random.shuffle(starts)

    for seed in starts[:_GEN_START_TRIAL_LIMIT]:
        for _ in range(_GEN_GROW_RESTARTS):
            if not _gen_can_use_cell(seed, labels, label):
                continue

            cells = {seed}
            labels[seed] = label
            ok = True
            for _ in range(size - 1):
                frontier = []
                for r, c in cells:
                    for dr, dc in dirs:
                        nr, nc = r + dr, c + dc
                        if not _gen_can_use_cell((nr, nc), labels, label):
                            continue
                        same_neighbors = 0
                        for er, ec in dirs:
                            rr, cc = nr + er, nc + ec
                            if 0 <= rr < n and 0 <= cc < n and labels[rr, cc] == label:
                                same_neighbors += 1
                        frontier.extend([(nr, nc)] * (1 + same_neighbors))

                if not frontier:
                    ok = False
                    break

                cell = random.choice(frontier)
                cells.add(cell)
                labels[cell] = label

            if ok:
                return cells

            for r, c in cells:
                labels[r, c] = empty

    return None


def _gen_place_components(labels, marked_sizes, unmarked_sizes):
    """Place all chamber labels; returns marked/unmarked component sets or None."""
    items = [("marked", size) for size in marked_sizes]
    items.extend(("unmarked", size) for size in unmarked_sizes)
    random.shuffle(items)
    items.sort(key=lambda item: item[1], reverse=True)

    marked_components = []
    unmarked_components = []
    for label, (role, size) in enumerate(items):
        component = _gen_place_component(
            labels,
            size,
            label,
            must_touch_border=(role == "marked"),
        )
        if component is None: return None
        (marked_components if role == "marked" else unmarked_components).append(component)

    return marked_components, unmarked_components


def _gen_border_wall_count(wall_mask):
    total = wall_mask[0].sum() + wall_mask[-1].sum()
    return int(total + wall_mask[1:-1, 0].sum() + wall_mask[1:-1, -1].sum())


def _gen_layout_is_valid(labels, marked_sizes, unmarked_sizes, wall_count, max_wall_component):
    """Validate chamber sizes and wall connectivity against the sampled plan."""
    wall_mask = labels == _GEN_EMPTY_LABEL
    actual_sizes = sorted(len(comp) for comp in _gen_components_mask(~wall_mask, connectivity=4))
    if actual_sizes != sorted(marked_sizes + unmarked_sizes):
        return False

    wall_components4 = _gen_components_mask(wall_mask, connectivity=4)
    if len(wall_components4) < _GEN_MIN_WALL_4_COMPONENTS or max(len(comp) for comp in wall_components4) > max_wall_component:
        return False

    wall_components8 = _gen_components_mask(wall_mask, connectivity=8)
    if max(len(comp) for comp in wall_components8) < int(wall_count * _GEN_WALL_8_COMPONENT_MIN_FRACTION):
        return False

    border_min, border_max = _GEN_BORDER_WALL_RANGE
    if not (border_min <= _gen_border_wall_count(wall_mask) <= border_max):
        return False

    return True


def _gen_render_pair(n, marked_components, unmarked_components):
    """Build the solved grid and corresponding input with one visible seed per marked chamber."""
    out = np.full((n, n), _GEN_WALL_COLOR, dtype=int)
    for component in unmarked_components:
        for r, c in component:
            out[r, c] = _GEN_BG_COLOR

    marker_colors = random.sample(_GEN_MARKER_COLORS, len(marked_components))
    inp = out.copy()
    for color, component in zip(marker_colors, marked_components):
        cells = list(component)
        for r, c in cells:
            out[r, c] = color
            inp[r, c] = _GEN_BG_COLOR
        r, c = random.choice(cells)
        inp[r, c] = color

    return inp, out


def _gen_attempt(_gen_n=None):
    n = _gen_n if _gen_n is not None else random.choice(_GEN_GRID_SIZES)
    marked_count, unmarked_count, wall_count, max_wall_component = _gen_sample_counts(n)
    sampled = _gen_sample_component_sizes(n * n - wall_count, marked_count, unmarked_count)
    if sampled is None: return None
    marked_sizes, unmarked_sizes = sampled

    labels = np.full((n, n), _GEN_EMPTY_LABEL, dtype=int)
    placed = _gen_place_components(labels, marked_sizes, unmarked_sizes)
    if placed is None:
        return None
    marked_components, unmarked_components = placed

    if not _gen_layout_is_valid(labels, marked_sizes, unmarked_sizes, wall_count, max_wall_component):
        return None

    inp, out = _gen_render_pair(n, marked_components, unmarked_components)
    try:
        solved = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(solved, out):
        return None

    return inp


def generate_input():
    n = random.choice(_GEN_GRID_SIZES)
    for _ in range(_GEN_RETRY_LIMIT):
        grid = _gen_attempt(n)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate e69241bd input")

import numpy as np
from typing import *
from arc_utils import Color, bbox, bbox_anchor, colors_present, draw_line, find_components
import random

# concepts:
# pattern generation

# description:
# In the input you will see a grid with two colored pixels.
# To make the output, you should draw a pattern from the two pixels.
# step 1: draw a horizontal line outward from the two pixels in their respective colours.
# step 2: draw a border around the canvas whose top half is colored to match the top pixel and whose bottom half matches the bottom pixel.


def main(input_grid):
    """
    Draw horizontal lines through two colored pixels and split the border color by their vertical order.

    Input structure:
    - The input is a black grid with exactly two colored single pixels.
    - One pixel lies in the upper half and the other in the lower half.
    - The grid height is even so the final border split has a clear midpoint.

    Rule:
    - Sort the two pixels from top to bottom.
    - Draw a full horizontal line through each pixel in its own color.
    - Draw the border, then recolor all non-black border and line pixels in the top half to the top color and in the bottom half to the bottom color.

    Key insight:
    - The two pixels define both the line rows and the two-color frame: vertical order decides which
      color owns each half of the output.
    """
    # Plan:
    # 1. Parse the input and determine which pixel is top in which is bottom
    # 2. Draw horizontal lines
    # 3. Draw border, colored appropriately

    background = Color.BLACK

    # 1. Input parsing: find the two single-pixel components and sort by row (top -> bottom).
    pixels = find_components(
        input_grid,
        bg=background,
        connectivity=4,
        monochromatic=True,
        return_format="dict",
    )
    pixels.sort(key=lambda d: int(d["bbox"][0]))  # r0
    assert len(pixels) == 2

    # 2. Draw horizontal lines across the row of each pixel, in that pixel's color.
    output_grid = np.full_like(input_grid, background)
    H, W = output_grid.shape
    for p in pixels:
        r0, _c0, _r1, _c1 = p["bbox"]
        color = int(p["color"])
        draw_line(output_grid, r=int(r0), c=0, direction=(0, 1), length=None, color=color)

    # 3. Draw border. Then enforce top-half vs bottom-half coloring.
    top_color = int(pixels[0]["color"])
    bottom_color = int(pixels[1]["color"])

    # Border (we recolor halves afterwards, so edges get the correct split).
    draw_line(output_grid, r=0, c=0, direction=(0, 1), length=None, color=top_color)        # top edge
    draw_line(output_grid, r=0, c=0, direction=(1, 0), length=None, color=top_color)        # left edge
    draw_line(output_grid, r=H - 1, c=0, direction=(0, 1), length=None, color=bottom_color) # bottom edge
    draw_line(output_grid, r=0, c=W - 1, direction=(1, 0), length=None, color=bottom_color) # right edge

    # Everything below the midline is bottom color, everything above is top color.
    top = output_grid[: H // 2, :]
    top[top != background] = top_color
    bottom = output_grid[H // 2 :, :]
    bottom[bottom != background] = bottom_color

    return output_grid

def generate_input():
    # Generate the grid, ensure the grid has an even height so that we can split it evenly between top and bottom
    width, height = np.random.randint(10, 20, size=2)
    while (height % 2 == 1):
        width, height = np.random.randint(10, 20, size=2)
    background = Color.BLACK
    grid = np.full((width, height), background)

    # Randomly choose two colors
    colors = np.random.choice(Color.NOT_BLACK, size=2, replace=False)

    # Randomly place the pixels so that one of them is the in the bottom half and the other in the top half
    x1, x2 = np.random.choice(range(width), size=2, replace=False)
    y1, y2 = np.random.randint(2, height//2-1), np.random.randint(height//2 + 1, height-2)
    grid[x1, y1] = colors[0]
    grid[x2, y2] = colors[1]

    return grid
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def _ordered_objects(panel: np.ndarray, bg: int) -> list[dict]:
    objects = find_components(panel, bg=bg, connectivity=4, monochromatic=True)
    assert len(objects) == 3, "each panel must contain exactly three monochrome objects"

    objects = sorted(objects, key=lambda obj: obj["bbox"][1])
    previous_right = -1
    for obj in objects:
        _r0, c0, _r1, c1 = obj["bbox"]
        assert c0 > previous_right, "panel objects must be strictly ordered left to right"
        previous_right = c1
    return objects


def main(grid: np.ndarray) -> np.ndarray:
    """
    Combine the left, middle, and right ordered objects from three separated panels.

    Input structure
    - The grid is three HxH panels separated by one-cell vertical separator bars.
    - The background is the dominant color, and each panel contains exactly three same-color 4-connected foreground objects.

    Rule
    - Build a new HxH background canvas.
    - From the left panel copy its leftmost object, from the middle panel copy its middle object, and from the right panel copy its rightmost object.

    Key insight
    - The separator bars create three aligned layers, and the panel's own left-to-right object order selects which object survives in the merged output.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    H, W = g.shape
    assert W == 3 * H + 2, "expected three square panels separated by two columns"

    bg = get_bg(g)
    sep_a = int(g[0, H])
    sep_b = int(g[0, 2 * H + 1])
    assert sep_a == sep_b and sep_a != bg, "separator bars must use the same non-bg color"
    assert bool(np.all(g[:, H] == sep_a)), "first separator column must be solid"
    assert bool(np.all(g[:, 2 * H + 1] == sep_a)), "second separator column must be solid"

    panels = [
        g[:, :H],
        g[:, H + 1 : 2 * H + 1],
        g[:, 2 * H + 2 :],
    ]
    assert all(panel.shape == (H, H) for panel in panels), "panels must be HxH"

    out = np.full((H, H), bg, dtype=int)
    for panel_index, panel in enumerate(panels):
        obj = _ordered_objects(panel, bg)[panel_index]
        color = int(obj["color"])
        for r, c in obj["coords"]:
            rr, cc = int(r), int(c)
            assert out[rr, cc] == bg, "selected objects must not overlap"
            out[rr, cc] = color

    return out

# --------------- generator (att2) ---------------

# Canvas and palette values observed in the task.
_BG = 7
_SEP = 6
_COLORS = [0, 1, 2, 3, 4, 5, 8, 9]

# Panel geometry and object ordering.
_GRID_SIZES = [5, 6]
_N_PANELS = 3
_OBJECTS_PER_PANEL = 3
_DISTRACTOR_KEYS = [(0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)]

# Object-size, density, and color-reuse controls.
_MAX_OBJECT_AREA = 8
_AREA_BUDGET_BY_SIZE = {5: 56, 6: 72}
_MAX_COLOR_REUSES = 2

# Random-growth shape controls.
_FRONTIER_COMPACT_BIAS = 0.35
_FRONTIER_COMPACT_TOP_K = 3
_NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Retry limit for rejecting failed growth or oracle mismatches.
_MAX_ATTEMPTS = 300


def _segments(H: int) -> list[tuple[int, int]]:
    a, b = sorted(random.sample(range(1, H), 2))
    return [(0, a - 1), (a, b - 1), (b, H - 1)]


def _object_patch(H: int, cols: tuple[int, int], color: int, area: int) -> np.ndarray | None:
    c0, c1 = cols
    W = c1 - c0 + 1
    target = int(area)
    if target < 1 or target > H * W:
        return None

    start = (random.randrange(H), random.randrange(W))
    cells = {start}
    frontier: set[tuple[int, int]] = set()

    def add_frontier(r: int, c: int) -> None:
        for dr, dc in _NEIGHBOR_DELTAS:
            rr, cc = r + dr, c + dc
            if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in cells:
                frontier.add((rr, cc))

    add_frontier(*start)
    while len(cells) < target:
        if not frontier:
            return None
        if random.random() < _FRONTIER_COMPACT_BIAS:
            options = sorted(
                frontier,
                key=lambda rc: sum(
                    (rc[0] + dr, rc[1] + dc) in cells for dr, dc in _NEIGHBOR_DELTAS
                ),
                reverse=True,
            )
            top_k = max(1, min(_FRONTIER_COMPACT_TOP_K, len(options)))
            cell = random.choice(options[:top_k])
        else:
            cell = random.choice(tuple(frontier))
        frontier.remove(cell)
        cells.add(cell)
        add_frontier(*cell)

    patch = np.full((H, H), _BG, dtype=int)
    for r, c in cells:
        patch[r, c0 + c] = int(color)
    return patch


def _choose_area(H: int, cols: tuple[int, int], budget: int, remaining_slots: int) -> int | None:
    width = cols[1] - cols[0] + 1
    high = min(_MAX_OBJECT_AREA, H * width, budget - (remaining_slots - 1))
    if high < 1:
        return None
    return random.randint(1, high)


def _assign_colors(selected: list[int]) -> dict[tuple[int, int], int] | None:
    colors = {(i, i): int(selected[i]) for i in range(_OBJECTS_PER_PANEL)}
    used_by_panel = [set() for _ in range(_N_PANELS)]
    counts = {c: 0 for c in _COLORS}
    for i, color in enumerate(selected):
        used_by_panel[i].add(int(color))
        counts[int(color)] += 1

    distractors = list(_DISTRACTOR_KEYS)
    random.shuffle(distractors)
    for panel_i, obj_i in distractors:
        options = [
            color
            for color in _COLORS
            if counts[color] < _MAX_COLOR_REUSES and color not in used_by_panel[panel_i]
        ]
        if not options:
            return None
        color = random.choice(options)
        colors[(panel_i, obj_i)] = color
        used_by_panel[panel_i].add(color)
        counts[color] += 1
    return colors


def _sample_patch(H: int, segs: list[tuple[int, int]], obj_i: int, color: int, budget: int, remaining: int):
    area = _choose_area(H, segs[obj_i], budget, remaining)
    if area is None:
        return None
    patch = _object_patch(H, segs[obj_i], color, area)
    if patch is None:
        return None
    return patch, budget - area, remaining - 1


def _sample_objects(H: int, segs: list[tuple[int, int]], selected_colors: list[int], colors):
    """Return all panel objects plus the expected merged output."""
    budget = _AREA_BUDGET_BY_SIZE[H]
    remaining = _N_PANELS * _OBJECTS_PER_PANEL
    objects: dict[tuple[int, int], np.ndarray] = {}
    out = np.full((H, H), _BG, dtype=int)

    for i in range(_OBJECTS_PER_PANEL):
        sampled = _sample_patch(H, segs, i, selected_colors[i], budget, remaining)
        if sampled is None:
            return None
        patch, budget, remaining = sampled
        objects[(i, i)] = patch
        paste(out, patch, 0, 0, transparent=_BG)

    for panel_i, obj_i in _DISTRACTOR_KEYS:
        sampled = _sample_patch(H, segs, obj_i, colors[(panel_i, obj_i)], budget, remaining)
        if sampled is None:
            return None
        patch, budget, remaining = sampled
        objects[(panel_i, obj_i)] = patch
    return objects, out


def _render_input(H: int, objects: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    """Render all objects into three panels separated by solid bars."""
    inp = np.full((H, _N_PANELS * H + (_N_PANELS - 1)), _BG, dtype=int)
    for sep_i in range(1, _N_PANELS):
        inp[:, sep_i * H + (sep_i - 1)] = _SEP
    for panel_i in range(_N_PANELS):
        panel = np.full((H, H), _BG, dtype=int)
        for obj_i in range(_OBJECTS_PER_PANEL):
            paste(panel, objects[(panel_i, obj_i)], 0, 0, transparent=_BG)
        paste(inp, panel, 0, panel_i * (H + 1))
    return inp


def _passes_oracle(inp: np.ndarray, expected: np.ndarray) -> bool:
    try:
        actual = main(inp)
    except AssertionError:
        return False
    return bool(np.array_equal(actual, expected))


def _gen_attempt() -> np.ndarray | None:
    H = random.choice(_GRID_SIZES)
    segs = _segments(H)
    selected_colors = random.sample(_COLORS, _OBJECTS_PER_PANEL)
    colors = _assign_colors(selected_colors)
    if colors is None:
        return None

    sampled = _sample_objects(H, segs, selected_colors, colors)
    if sampled is None:
        return None

    objects, out = sampled
    inp = _render_input(H, objects)
    if _passes_oracle(inp, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input for 5ecac7f7")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, in_bounds, neighbors4
import random


def _line_color(g: np.ndarray, bg: int) -> int:
    vals, counts = np.unique(g[g != int(bg)], return_counts=True)
    assert vals.size == 3, "expected one line color and two marker colors"
    max_count = int(counts.max())
    winners = vals[counts == max_count]
    assert winners.size == 1, "line color must be uniquely most common"
    return int(winners[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fold each straight red rod at its black marker, leaving the gray-anchored side fixed.

    Input structure:
    - The background is the dominant color.
    - Each foreground object is a straight horizontal or vertical 4-connected rod.
    - Each rod contains many pixels of one line color, one endpoint marker, and one
      interior control marker.

    Rule:
    - For every rod, keep the segment from the endpoint marker through the control
      marker unchanged.
    - Move the line-color tail on the far side of the control marker to a
      perpendicular ray starting next to that marker.
    - Choose the perpendicular direction with more space to the grid edge.

    Key insight:
    - The endpoint marker identifies the fixed side of the rod, while the control
      marker is the hinge; the tail folds into the larger open half-plane.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = get_bg(g)
    line_color = _line_color(g, bg)

    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert components, "expected at least one marked rod"

    clear: list[tuple[int, int]] = []
    paint: list[tuple[int, int]] = []

    for comp in components:
        coords = [tuple(map(int, coord)) for coord in comp["coords"]]
        coord_set = set(coords)
        marker_coords = [p for p in coords if int(g[p]) != line_color]
        assert len(marker_coords) == 2, "each rod must have exactly two markers"

        degrees = {
            p: sum((nr, nc) in coord_set for nr, nc in neighbors4(*p))
            for p in marker_coords
        }
        endpoints = [p for p, degree in degrees.items() if int(degree) == 1]
        hinges = [p for p, degree in degrees.items() if int(degree) == 2]
        assert len(endpoints) == 1 and len(hinges) == 1, "markers must be endpoint and hinge"
        endpoint = endpoints[0]
        hinge = hinges[0]

        rows = {r for r, _c in coords}
        cols = {c for _r, c in coords}
        assert len(rows) == 1 or len(cols) == 1, "each object must be a straight rod"

        if len(rows) == 1:
            assert endpoint[0] == hinge[0], "horizontal rod markers must share a row"
            fixed_sign = int(np.sign(endpoint[1] - hinge[1]))
            assert fixed_sign != 0, "endpoint and hinge must be distinct"
            tail_step = (0, -fixed_sign)
            up_space = int(hinge[0])
            down_space = int(H - 1 - hinge[0])
            assert up_space != down_space, "perpendicular direction must be unique"
            fold_step = (-1, 0) if up_space > down_space else (1, 0)
        else:
            assert endpoint[1] == hinge[1], "vertical rod markers must share a column"
            fixed_sign = int(np.sign(endpoint[0] - hinge[0]))
            assert fixed_sign != 0, "endpoint and hinge must be distinct"
            tail_step = (-fixed_sign, 0)
            left_space = int(hinge[1])
            right_space = int(W - 1 - hinge[1])
            assert left_space != right_space, "perpendicular direction must be unique"
            fold_step = (0, -1) if left_space > right_space else (0, 1)

        tail: list[tuple[int, int]] = []
        step = 1
        while True:
            p = (
                int(hinge[0]) + int(tail_step[0]) * step,
                int(hinge[1]) + int(tail_step[1]) * step,
            )
            if p not in coord_set:
                break
            assert int(g[p]) == line_color, "tail must contain only line-color pixels"
            tail.append(p)
            step += 1
        assert tail, "each hinge must have a moving tail"

        for step in range(1, len(tail) + 1):
            p = (
                int(hinge[0]) + int(fold_step[0]) * step,
                int(hinge[1]) + int(fold_step[1]) * step,
            )
            assert in_bounds(g.shape, *p), "folded tail must remain in bounds"
            paint.append(p)
        clear.extend(tail)

    assert len(set(clear)) == len(clear), "moving tails must not overlap"
    assert len(set(paint)) == len(paint), "folded tails must not collide"
    clear_set = set(clear)
    for p in paint:
        assert int(g[p]) == int(bg) or p in clear_set, "fold target must be empty"

    out = g.copy()
    for p in clear:
        out[p] = bg
    for p in paint:
        out[p] = line_color
    return out

# --------------- generator (o5x) ---------------

# ARC colors.
BG, RED, HINGE, END = 7, 2, 0, 5

# Canvas and rod-count sampling.
GRID_SIZE_MIN, GRID_SIZE_MAX = 8, 16
ROD_COUNT_MIN, ROD_COUNT_MAX = 1, 7
ROD_DENSITY_DIVISOR = 28

# Rod geometry sampling.
HORIZONTAL, VERTICAL = "h", "v"
ORIENTATIONS = (HORIZONTAL, VERTICAL)
FIXED_SIGNS = (-1, 1)
ROD_LEN_MIN, ROD_LEN_MAX = 3, 12
FIXED_LEN_MIN, FIXED_LEN_MAX = 2, 9
TAIL_LEN_MAX = 5

# Placement and retry controls.
GAP_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))
MAX_GENERATE_ATTEMPTS = 300

Record = dict[str, object]
RecordKey = tuple[int, int, int, str]

_RECORD_CACHE: dict[int, list[tuple[RecordKey, Record]]] = {}


def _expanded(cells: set[tuple[int, int]], n: int) -> set[tuple[int, int]]:
    out = set(cells)
    shape = (n, n)
    for r, c in cells:
        for dr, dc in GAP_DIRECTIONS:
            nr, nc = r + dr, c + dc
            if in_bounds(shape, nr, nc):
                out.add((nr, nc))
    return out


def _fold_steps(n: int, orient: str, hinge: tuple[int, int], fixed_sign: int):
    """Return fixed-arm and fold steps, or None for a centered hinge."""
    r, c = hinge
    if orient == HORIZONTAL:
        up, down = r, n - 1 - r
        if up == down:
            return None
        return (0, fixed_sign), ((-1, 0) if up > down else (1, 0))

    left, right = c, n - 1 - c
    if left == right:
        return None
    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))


def _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:
    r, c = origin
    dr, dc = step
    return [(r + dr * k, c + dc * k) for k in range(1, count + 1)]


def _record(n: int, orient: str, fixed_len: int, tail_len: int, hinge: tuple[int, int], fixed_sign: int):
    steps = _fold_steps(n, orient, hinge, fixed_sign)
    if steps is None:
        return None

    fixed_step, fold_step = steps
    tail_step = (-fixed_step[0], -fixed_step[1])
    fixed = _ray_cells(hinge, fixed_step, fixed_len - 1)
    tail = _ray_cells(hinge, tail_step, tail_len)
    folded = _ray_cells(hinge, fold_step, tail_len)

    all_cells = fixed + tail + folded + [hinge]
    shape = (n, n)
    if any(not in_bounds(shape, rr, cc) for rr, cc in all_cells):
        return None

    endpoint = fixed[-1]
    fixed_red = fixed[:-1]
    input_cells = {hinge, endpoint, *fixed_red, *tail}
    envelope = input_cells | set(folded)
    if len(envelope) != len(input_cells) + len(folded):
        return None

    return {
        "hinge": hinge,
        "endpoint": endpoint,
        "fixed_red": fixed_red,
        "tail": tail,
        "folded": folded,
        "envelope": envelope,
        "red_count": fixed_len + tail_len - 2,
    }


def _all_records(n: int) -> list[tuple[RecordKey, Record]]:
    if n in _RECORD_CACHE:
        return _RECORD_CACHE[n]

    records: list[tuple[RecordKey, Record]] = []
    for orient in ORIENTATIONS:
        for total_len in range(ROD_LEN_MIN, ROD_LEN_MAX + 1):
            fixed_min = max(FIXED_LEN_MIN, total_len - TAIL_LEN_MAX)
            fixed_max = min(FIXED_LEN_MAX, total_len - 1)
            for fixed_len in range(fixed_min, fixed_max + 1):
                tail_len = total_len - fixed_len
                key = (total_len, fixed_len, tail_len, orient)
                for r in range(n):
                    for c in range(n):
                        for fixed_sign in FIXED_SIGNS:
                            rec = _record(n, orient, fixed_len, tail_len, (r, c), fixed_sign)
                            if rec is not None:
                                records.append((key, rec))
    _RECORD_CACHE[n] = records
    return records


def _choose_record(n: int, blocked: set[tuple[int, int]], rod_count: int, current_red: int, is_last: bool):
    by_key: dict[RecordKey, list[Record]] = {}
    for key, rec in _all_records(n):
        total_len = key[0]
        red_count = total_len - 2
        if is_last and current_red + red_count <= rod_count:
            continue
        if rec["envelope"] & blocked:
            continue
        by_key.setdefault(key, []).append(rec)

    if not by_key:
        return None

    totals = sorted({key[0] for key in by_key})
    total_len = random.choice(totals)
    fixed_lengths = sorted({key[1] for key in by_key if key[0] == total_len})
    fixed_len = random.choice(fixed_lengths)
    orientations = sorted({key[3] for key in by_key if key[:2] == (total_len, fixed_len)})
    orient = random.choice(orientations)
    tail_len = total_len - fixed_len
    return random.choice(by_key[(total_len, fixed_len, tail_len, orient)])


def _paint(records: list[Record], n: int) -> tuple[np.ndarray, np.ndarray]:
    inp = np.full((n, n), BG, dtype=int)
    out = np.full((n, n), BG, dtype=int)
    for rec in records:
        hinge = rec["hinge"]
        endpoint = rec["endpoint"]
        inp[hinge] = HINGE
        out[hinge] = HINGE
        inp[endpoint] = END
        out[endpoint] = END
        for p in rec["fixed_red"]:
            inp[p] = RED
            out[p] = RED
        for p in rec["tail"]:
            inp[p] = RED
        for p in rec["folded"]:
            out[p] = RED
    return inp, out


def _place_records(n: int, rod_count: int) -> list[Record] | None:
    """Sample non-touching rods and their fold envelopes for one grid."""
    blocked: set[tuple[int, int]] = set()
    records: list[Record] = []
    red_total = 0

    for i in range(rod_count):
        rec = _choose_record(n, blocked, rod_count, red_total, i == rod_count - 1)
        if rec is None:
            return None
        records.append(rec)
        red_total += int(rec["red_count"])
        blocked |= _expanded(rec["envelope"], n)
    return records


def _valid_generated_pair(inp: np.ndarray, out: np.ndarray, rod_count: int) -> bool:
    counts = {int(v): int(np.count_nonzero(inp == v)) for v in (BG, RED, HINGE, END)}
    if counts[RED] <= rod_count or counts[BG] <= counts[RED]:
        return False

    try:
        solved = main(inp)
    except Exception:
        return False
    return bool(np.array_equal(solved, out))


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    max_rods = max(ROD_COUNT_MIN, min(ROD_COUNT_MAX, (n * n) // ROD_DENSITY_DIVISOR))
    rod_count = random.randint(ROD_COUNT_MIN, max_rods)

    records = _place_records(n, rod_count)
    if records is None:
        return None
    inp, out = _paint(records, n)
    if not _valid_generated_pair(inp, out, rod_count):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATE_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 230f2e48 input")

