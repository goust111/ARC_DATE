import numpy as np
from typing import *
from arc_utils import Color, MirrorSymmetry, bbox, bbox_anchor, colors_present, draw_line, find_components, first_free_location, paste, random_sprite
import random

# concepts:
# symmetry, mirror

# description:
# In the input you will see two objects on each outer side of two red frames.
# To make the output, you need to mirror the two objects by flipping them over the symmetry of the red frames, making them inside the red frames. Each object flips over the frame closest to it.

def main(input_grid):
    """
    Mirror gray objects across their nearest red frame so the reflected copies land inside the frames.

    Input structure:
    - The input is a black grid with red frame objects and gray objects outside them.
    - All objects are aligned along one row or one column.
    - Each gray object belongs to the closest red frame.

    Rule:
    - Detect the red frames and gray objects.
    - Infer whether the reflection axis is horizontal or vertical from object alignment.
    - Reflect each gray object across the center line of its closest frame and redraw the frame.

    Key insight:
    - The red frames define local mirror axes; each gray object moves by reflection, not by free translation.
    """
    # Extract the framework
    frame_color = Color.RED
    object_color = Color.GRAY 
    background = Color.BLACK

    # Create an empty grid
    n, m = input_grid.shape
    output_grid = np.zeros((n, m), dtype=int)

    # parse the input
    objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=True, return_format="objects")
    frames = [ obj for obj in objects if frame_color in colors_present(obj, exclude={ background }) ]
    mirrored_objects = [ obj for obj in objects if object_color in colors_present(obj, exclude={ background }) ]

    # determine if we are doing horizontal or vertical mirroring
    # if all the objects have the same X coordinate, we are doing vertical mirroring
    # if all the objects have the same Y coordinate, we are doing horizontal mirroring
    def _center(b: tuple[int, int, int, int]) -> tuple[float, float]:
        r0, c0, r1, c1 = map(int, b)
        return (r0 + r1) / 2.0, (c0 + c1) / 2.0

    centers: list[tuple[float, float]] = []
    for obj in objects:
        _b = bbox(obj != background)
        assert _b is not None
        centers.append(_center(_b))
    r_positions = [rc[0] for rc in centers]
    c_positions = [rc[1] for rc in centers]

    # Legacy note: the seed solver ran under a transpose wrapper, so the axis test swaps here.
    if all(c == c_positions[0] for c in c_positions):
        orientation = "vertical"
    elif all(r == r_positions[0] for r in r_positions):
        orientation = "horizontal"
    else: raise ValueError(f"The objects are not aligned in a single axis")

    # Flip each other object over its closest frame
    for mirrored_object in mirrored_objects:
        # Find the closest frame
        def distance_between_objects(obj1, obj2):
            _b = bbox(obj1 != background)
            assert _b is not None
            r1, c1 = _center(_b)
            _b = bbox(obj2 != background)
            assert _b is not None
            r2, c2 = _center(_b)
            return (r1 - r2) ** 2 + (c1 - c2) ** 2        
        closest_frame = min(frames, key=lambda frame: distance_between_objects(frame, mirrored_object))

        # Build a symmetry object for flipping over the closest frame
        _b = bbox(closest_frame != background)
        assert _b is not None
        frame_r, frame_c = _center(_b)
        _b = bbox(mirrored_object != background)
        assert _b is not None
        this_r, this_c = _center(_b)
        # Make it one pixel past the middle of frame
        frame_c += 0.5 if this_c > frame_c else -0.5
        frame_r += 0.5 if this_r > frame_r else -0.5
        # Conjugation note: legacy seeds ran under a transpose wrapper.
        # When objects are aligned vertically (same column), we mirror across a horizontal line (mirror_r).
        # When objects are aligned horizontally (same row), we mirror across a vertical line (mirror_c).
        symmetry = MirrorSymmetry(
            mirror_r=frame_r if orientation == "vertical" else None,
            mirror_c=frame_c if orientation == "horizontal" else None,
        )
        
        # Flip the object over the symmetry
        for r, c in np.argwhere(mirrored_object != background):
            r2, c2 = symmetry.apply(r, c)
            output_grid[r2, c2] = mirrored_object[r, c]
        
        # Draw the frame
        output_grid = paste(output_grid, closest_frame, 0, 0, transparent=Color.BLACK, clip=True)

    return output_grid

def generate_input():
    # Create a 2D background
    n, m = np.random.randint(15, 30), np.random.randint(15, 30)
    grid = np.zeros((m, n), dtype=int)

    # Get a framework for pattern
    frame_length = np.random.randint(5, 10)
    frame_width = 2
    frame_color = Color.RED

    # Draw a half of the framework
    frame_sprite = np.zeros((frame_length, frame_width), dtype=int)
    # horizontal bar and two vertical pixels
    frame_sprite[:, 0] = frame_color
    frame_sprite[0, 1] = frame_color
    frame_sprite[-1, 1] = frame_color

    # Select the interval for two half frameworks that form one entire framework
    frame_interval = np.random.randint(4, 6)
    
    # Calculate the sizes of two things that we are going to mirror within framwork
    pattern_color = Color.GRAY
    pattern_length = frame_length - 2
    pattern_width = frame_interval // 2
    pattern_width_with_padding = frame_interval // 2 + 1

    # Generate two patterns out the framwork
    pattern_1 = random_sprite(m=pattern_length, n=pattern_width, color_palette=[pattern_color])
    pattern_2 = random_sprite(m=pattern_length, n=pattern_width, color_palette=[pattern_color])

    # place the pattern in the frame
    whole_frame = np.zeros((frame_length, frame_width * 2 + frame_interval + pattern_width_with_padding * 2), dtype=int)
    # Place the upper half of the frame
    whole_frame = paste(whole_frame, frame_sprite, 0, pattern_width_with_padding, transparent=Color.BLACK, clip=True)
    # Place the upper pattern
    whole_frame = paste(whole_frame, pattern_1, 1, 0, transparent=Color.BLACK, clip=True)
    # Place the lower pattern
    whole_frame = paste(whole_frame, pattern_2, 1, frame_width * 2 + frame_interval + pattern_width_with_padding + 1, transparent=Color.BLACK, clip=True)
    # Place the lower half of the frame
    whole_frame = paste(whole_frame, np.flipud(frame_sprite), 0, frame_width + frame_interval + pattern_width_with_padding, transparent=Color.BLACK, clip=True)

    # place the frame in the background
    _loc = first_free_location(grid, whole_frame, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    grid = paste(grid, whole_frame, r, c, transparent=Color.BLACK, clip=True)

    # Randomly rotate the grid so that we get both vertical and horizontal arrangements
    if np.random.rand() < 0.5:
        grid = np.rot90(grid, k=-1)
    return grid
from collections import Counter

import numpy as np

from arc_utils import get_bg


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw vertical bars for the colors whose bottom code-row frequency equals the marker count.

    Input structure
    The grid has a dominant background, one solid full-width separator row, a
    single contiguous marker run above the separator, and one non-background
    code row below the separator.

    Rule
    Count the marker pixels above the separator. In the code row, find every
    color that appears exactly that many times. For each occurrence of such a
    color, fill that column for the same number of cells immediately above the
    separator, using the code-row color.

    Key insight
    The marker run is the histogram target count, and the code row gives both
    the colors to test and the columns where matching bars must be drawn.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height = int(g.shape[0])
    bg = get_bg(g)

    separator_rows = [
        r
        for r in range(height)
        if np.all(g[r, :] == int(g[r, 0])) and int(g[r, 0]) != bg
    ]
    assert len(separator_rows) == 1, "expected one solid non-background separator row"
    separator_row = separator_rows[0]

    marker_mask = g[:separator_row, :] != bg
    assert marker_mask.any(), "expected marker pixels above the separator"
    marker_rows = np.flatnonzero(marker_mask.any(axis=1))
    assert len(marker_rows) == 1, "marker pixels must occupy one row"
    marker_row = int(marker_rows[0])
    marker_cols = np.flatnonzero(marker_mask[marker_row])
    assert len(marker_cols) == int(marker_mask.sum()), "expected no other foreground above the separator"
    assert len(set(map(int, g[marker_row, marker_cols]))) == 1, "marker run must be monochromatic"
    assert np.all(np.diff(marker_cols) == 1), "marker pixels must form a contiguous run"
    marker_count = len(marker_cols)

    code_rows = [r for r in range(separator_row + 1, height) if np.all(g[r, :] != bg)]
    assert len(code_rows) == 1, "expected one non-background code row below the separator"
    code = g[code_rows[0], :]

    start_row = separator_row - marker_count
    assert start_row >= 0, "marker count must fit above the separator"

    code_counts = Counter(map(int, code))
    selected_cols = [c for c, color in enumerate(map(int, code)) if code_counts[color] == marker_count]
    assert selected_cols, "expected at least one code color with marker-count frequency"

    out = g.copy()
    for col in selected_cols:
        color = int(code[col])
        assert np.all(out[start_row:separator_row, col] == bg), "bar target cells must be background"
        out[start_row:separator_row, col] = color

    return out

# --------------- generator (o5x) ---------------
from functools import lru_cache
from itertools import product

# Grid layout.
GRID_SHAPE = (10, 10)
MARKER_ROW, SEPARATOR_ROW, CODE_ROW = 0, 6, 8
BACKGROUND_COLOR, SEPARATOR_COLOR, MARKER_COLOR = 0, 5, 8
CODE_WIDTH = GRID_SHAPE[1]

# Sampling bounds and retry policy.
MARKER_LEN_RANGE, COLOR_COUNT_RANGE, COLOR_VALUE_RANGE = (1, 5), (2, 6), (1, 10)
MAX_MATCHING_COLORS, MAX_SELECTED_COLUMNS, RETRY_LIMIT = 3, 6, 300
CODE_PALETTE = tuple(c for c in range(*COLOR_VALUE_RANGE) if c != SEPARATOR_COLOR)

@lru_cache(maxsize=None)
def _gen_count_options(marker_len: int, color_count: int, matching_count: int) -> list[tuple[int, ...]]:
    """Return ordered non-matching color counts that fill the code row."""
    other_count = color_count - matching_count
    other_total = CODE_WIDTH - marker_len * matching_count
    return [
        counts
        for counts in product(range(1, other_total + 1), repeat=other_count)
        if sum(counts) == other_total and marker_len not in counts
    ]


def _count_plans(marker_len: int) -> list[tuple[int, int, list[tuple[int, ...]]]]:
    """Return feasible color-count plans with cached non-matching counts."""
    plans = []
    for color_count in range(*COLOR_COUNT_RANGE):
        max_matching = min(MAX_MATCHING_COLORS, color_count, MAX_SELECTED_COLUMNS // marker_len)
        for matching_count in range(1, max_matching + 1):
            options = _gen_count_options(marker_len, color_count, matching_count)
            if options:
                plans.append((color_count, matching_count, options))
    return plans


def _sample_code_values(marker_len, color_count, matching_count, options):
    """Sample a shuffled code row and the colors expected to trigger bars."""
    other_counts = list(options[int(np.random.randint(len(options)))])
    colors = list(np.random.choice(CODE_PALETTE, size=color_count, replace=False))
    matching_colors = colors[:matching_count]
    counts = [marker_len] * matching_count + other_counts
    code_values = [int(color) for color, count in zip(colors, counts) for _ in range(int(count))]
    np.random.shuffle(code_values)
    return code_values, matching_colors


def _render_case(marker_len, code_values, matching_colors):
    """Build the input grid and its oracle output for the sampled code row."""
    code_row = np.array(code_values, dtype=int)
    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)
    grid[MARKER_ROW, :marker_len] = MARKER_COLOR
    grid[SEPARATOR_ROW, :] = SEPARATOR_COLOR
    grid[CODE_ROW, :] = code_row
    expected = grid.copy()
    matching_mask = np.isin(code_row, matching_colors)
    expected[SEPARATOR_ROW - marker_len : SEPARATOR_ROW, matching_mask] = code_row[matching_mask]
    return grid, expected


def _gen_attempt() -> np.ndarray | None:
    marker_len = int(np.random.randint(*MARKER_LEN_RANGE))

    plans = _count_plans(marker_len)
    if not plans:
        return None

    color_count, matching_count, options = plans[int(np.random.randint(len(plans)))]
    code_values, matching_colors = _sample_code_values(marker_len, color_count, matching_count, options)
    grid, expected = _render_case(marker_len, code_values, matching_colors)

    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_coords, get_bg
import random


def _legend_pairs(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
    pairs: list[tuple[int, int]] = []
    for r in range(g.shape[0]):
        left = int(g[r, 0])
        right = int(g[r, 1])
        if left == bg or right == bg:
            break
        pairs.append((left, right))
    assert pairs, "expected a non-empty two-column legend at the upper left"
    return pairs


def main(grid: np.ndarray) -> np.ndarray:
    """Expand each sparse color object into a filled rectangular region using its legend-paired fill color.

    Input structure
    A background-color grid has a two-column legend in columns 0 and 1, starting at row 0: each row gives
    a source color in the left column and that source color's fill color in the right column.  Outside the
    legend, the foreground pixels are sparse dot objects whose colors are exactly the legend source colors.

    Rule
    Clear the legend.  For each source color, take the bbox of all of its non-legend dots, expand that bbox
    by one pixel in every direction, and fill background cells inside the expanded rectangle with the paired
    legend fill color while preserving every original non-legend dot.

    Key insight
    The legend order is also the layer order: earlier legend rows are in front, so fill rectangles are painted
    from the last legend row back to the first and higher-priority fills overwrite lower-priority fills.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape
    assert W >= 2, "expected room for a two-column legend"

    pairs = _legend_pairs(g, bg)
    source_colors = {source for source, _fill in pairs}
    assert len(source_colors) == len(pairs), "legend source colors must be unique"

    legend_mask = np.zeros(g.shape, dtype=bool)
    legend_mask[: len(pairs), :2] = True
    dot_mask = (g != bg) & ~legend_mask
    assert dot_mask.any(), "expected source dots outside the legend"
    assert set(map(int, g[dot_mask])).issubset(source_colors), "outside dots must use legend source colors"

    dots_by_color: dict[int, np.ndarray] = {}
    all_dots = np.zeros(g.shape, dtype=bool)
    for source, _fill in pairs:
        coords = np.argwhere(dot_mask & (g == source))
        assert coords.size, "each legend source color must appear outside the legend"
        dots_by_color[source] = coords
        all_dots[coords[:, 0], coords[:, 1]] = True

    out = np.full_like(g, bg)
    for source, fill in reversed(pairs):
        r0, c0, r1, c1 = bbox_coords(dots_by_color[source])
        r0 = max(0, r0 - 1)
        c0 = max(0, c0 - 1)
        r1 = min(H - 1, r1 + 1)
        c1 = min(W - 1, c1 + 1)

        region = out[r0 : r1 + 1, c0 : c1 + 1]
        background_inside_region = ~all_dots[r0 : r1 + 1, c0 : c1 + 1]
        region[background_inside_region] = fill

    out[all_dots] = g[all_dots]
    return out

# --------------- generator (o5x) ---------------

# Canvas and legend geometry.
GRID_HEIGHT, GRID_WIDTH = 20, 20
BACKGROUND_COLOR = 0
LEGEND_COLS = 2
DOT_STRIDE, BBOX_PAD, NON_OVERLAP_GAP = 2, 1, 1

# Legend palette sampling.
COLORS = tuple(range(1, 10))
PAIR_COUNT_CHOICES = (2, 3)
ROTATED_SOURCE_FILL_PROB = 0.45

# Dot-grid shape sampling.
DOT_ROWS_MIN, DOT_ROWS_MAX = 2, 8
DOT_COLS_MIN, DOT_COLS_MAX = 2, 5

# Layout search.
THREE_PAIR_FORCED_OVERLAP_STEPS = (1, 2)
MODE_OVERLAP, MODE_OVERLAP_ANY, MODE_SEPARATE, MODE_ANY = "overlap", "overlap_any", "separate", "any"
POST_FORCED_LAYOUT_MODES = (MODE_SEPARATE, MODE_OVERLAP_ANY, MODE_ANY)
POST_FORCED_LAYOUT_WEIGHTS = (3, 3, 1)

# Generation retry budget.
GENERATION_RETRIES = 300


def _origin_bbox(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> tuple[int, int, int, int]:
    r, c = origin
    return (
        r - BBOX_PAD,
        c - BBOX_PAD,
        r + DOT_STRIDE * (dot_rows - 1) + BBOX_PAD,
        c + DOT_STRIDE * (dot_cols - 1) + BBOX_PAD,
    )


def _hits_legend(box: tuple[int, int, int, int], n_pairs: int) -> bool:
    r0, c0, r1, c1 = box
    return r0 <= n_pairs - 1 and r1 >= 0 and c0 <= LEGEND_COLS - 1 and c1 >= 0


def _legal_origins(n_pairs: int, dot_rows: int, dot_cols: int) -> list[tuple[int, int]]:
    origins: list[tuple[int, int]] = []
    max_r = GRID_HEIGHT - 1 - BBOX_PAD - DOT_STRIDE * (dot_rows - 1)
    max_c = GRID_WIDTH - 1 - BBOX_PAD - DOT_STRIDE * (dot_cols - 1)
    for r in range(BBOX_PAD, max_r + 1):
        for c in range(BBOX_PAD, max_c + 1):
            box = _origin_bbox((r, c), dot_rows, dot_cols)
            if not _hits_legend(box, n_pairs):
                origins.append((r, c))
    return origins


def _dot_coords(origin: tuple[int, int], dot_rows: int, dot_cols: int) -> np.ndarray:
    rows = origin[0] + DOT_STRIDE * np.arange(dot_rows)
    cols = origin[1] + DOT_STRIDE * np.arange(dot_cols)
    rr, cc = np.meshgrid(rows, cols, indexing="ij")
    return np.stack([rr.ravel(), cc.ravel()], axis=1).astype(int)


def _expanded_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = bbox_coords(coords)
    return (
        max(0, r0 - BBOX_PAD),
        max(0, c0 - BBOX_PAD),
        min(GRID_HEIGHT - 1, r1 + BBOX_PAD),
        min(GRID_WIDTH - 1, c1 + BBOX_PAD),
    )


def _inside_box(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = box
    return (coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)


def _separated_by_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    return (
        a[2] + NON_OVERLAP_GAP < b[0]
        or b[2] + NON_OVERLAP_GAP < a[0]
        or a[3] + NON_OVERLAP_GAP < b[1]
        or b[3] + NON_OVERLAP_GAP < a[1]
    )


def _intersection_bounds(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
) -> tuple[int, int, int, int] | None:
    r0, c0 = max(a[0], b[0]), max(a[1], b[1])
    r1, c1 = min(a[2], b[2]), min(a[3], b[3])
    if r0 > r1 or c0 > c1:
        return None
    return r0, c0, r1, c1


def _intersection_has_background(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int], dot_mask: np.ndarray
) -> bool:
    bounds = _intersection_bounds(a, b)
    if bounds is None:
        return False
    r0, c0, r1, c1 = bounds
    return bool((~dot_mask[r0 : r1 + 1, c0 : c1 + 1]).any())


def _remove_dots_covered_by_higher_priority(
    coords: np.ndarray, higher_boxes: list[tuple[int, int, int, int]]
) -> np.ndarray:
    keep = np.ones(len(coords), dtype=bool)
    for box in higher_boxes:
        keep &= ~_inside_box(coords, box)
    return coords[keep]


def _scene_data(
    sizes: list[tuple[int, int]], origins: list[tuple[int, int]]
) -> tuple[list[np.ndarray], list[tuple[int, int, int, int]], np.ndarray] | None:
    remaining: list[np.ndarray] = []
    boxes: list[tuple[int, int, int, int]] = []
    dot_mask = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)

    for (dot_rows, dot_cols), origin in zip(sizes, origins):
        coords = _remove_dots_covered_by_higher_priority(_dot_coords(origin, dot_rows, dot_cols), boxes)
        if coords.size == 0:
            return None
        if len(set(map(int, coords[:, 0]))) != dot_rows or len(set(map(int, coords[:, 1]))) != dot_cols:
            return None
        if dot_mask[coords[:, 0], coords[:, 1]].any():
            return None
        dot_mask[coords[:, 0], coords[:, 1]] = True
        remaining.append(coords)
        boxes.append(_expanded_bbox(coords))

    return remaining, boxes, dot_mask


def _render_output(
    pairs: list[tuple[int, int]], remaining: list[np.ndarray], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray
) -> np.ndarray:
    out = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    for idx in range(len(pairs) - 1, -1, -1):
        _source, fill = pairs[idx]
        r0, c0, r1, c1 = boxes[idx]
        region = out[r0 : r1 + 1, c0 : c1 + 1]
        region[~dot_mask[r0 : r1 + 1, c0 : c1 + 1]] = fill
    for (source, _fill), coords in zip(pairs, remaining):
        out[coords[:, 0], coords[:, 1]] = source
    return out


def _build_input(pairs: list[tuple[int, int]], remaining: list[np.ndarray]) -> np.ndarray:
    grid = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND_COLOR, dtype=int)
    grid[: len(pairs), :LEGEND_COLS] = np.asarray(pairs, dtype=int)
    for (source, _fill), coords in zip(pairs, remaining):
        grid[coords[:, 0], coords[:, 1]] = source
    return grid


def _visible_overlap(
    pairs: list[tuple[int, int]], boxes: list[tuple[int, int, int, int]], dot_mask: np.ndarray, out: np.ndarray
) -> bool:
    for hi in range(len(pairs)):
        for lo in range(hi + 1, len(pairs)):
            bounds = _intersection_bounds(boxes[hi], boxes[lo])
            if bounds is None:
                continue
            r0, c0, r1, c1 = bounds
            overlap_fill = (~dot_mask[r0 : r1 + 1, c0 : c1 + 1]) & (
                out[r0 : r1 + 1, c0 : c1 + 1] == pairs[hi][1]
            )
            lr0, lc0, lr1, lc1 = boxes[lo]
            lower_fill = (~dot_mask[lr0 : lr1 + 1, lc0 : lc1 + 1]) & (
                out[lr0 : lr1 + 1, lc0 : lc1 + 1] == pairs[lo][1]
            )
            if overlap_fill.any() and lower_fill.any():
                return True
    return False


def _choose_pairs(n_pairs: int) -> list[tuple[int, int]]:
    colors = list(COLORS)
    sources = random.sample(colors, n_pairs)
    non_sources = [c for c in colors if c not in sources]
    if random.random() < ROTATED_SOURCE_FILL_PROB:
        fills = sources[1:] + sources[:1]
        replace_count = random.randint(0, n_pairs)
        for idx, color in zip(random.sample(range(n_pairs), replace_count), random.sample(non_sources, replace_count)):
            fills[idx] = color
    else:
        fills = random.sample(non_sources, n_pairs)
    return list(zip(sources, fills))


def _candidate_origins(
    sizes: list[tuple[int, int]],
    origins: list[tuple[int, int]],
    legal: list[tuple[int, int]],
    mode: str,
    target: int | None = None,
) -> list[tuple[int, int]]:
    candidates: list[tuple[int, int]] = []
    for origin in legal:
        data = _scene_data(sizes[: len(origins) + 1], origins + [origin])
        if data is None:
            continue
        _remaining, boxes, dot_mask = data
        new_box = boxes[-1]
        if mode == MODE_OVERLAP:
            assert target is not None
            if not _intersection_has_background(new_box, boxes[target], dot_mask):
                continue
        elif mode == MODE_OVERLAP_ANY:
            if not any(_intersection_has_background(new_box, old_box, dot_mask) for old_box in boxes[:-1]):
                continue
        elif mode == MODE_SEPARATE:
            if not all(_separated_by_gap(new_box, old_box) for old_box in boxes[:-1]):
                continue
        candidates.append(origin)
    return candidates


def _choose_origins(n_pairs: int, sizes: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
    legal = [_legal_origins(n_pairs, dot_rows, dot_cols) for dot_rows, dot_cols in sizes]
    if any(not options for options in legal):
        return None

    origins = [random.choice(legal[0])]
    forced_step = 1 if n_pairs == 2 else random.choice(THREE_PAIR_FORCED_OVERLAP_STEPS)
    for idx in range(1, n_pairs):
        if idx == forced_step:
            target = random.randrange(idx)
            candidates = _candidate_origins(sizes, origins, legal[idx], MODE_OVERLAP, target)
        elif idx < forced_step:
            candidates = _candidate_origins(sizes, origins, legal[idx], MODE_SEPARATE)
            if not candidates:
                candidates = _candidate_origins(sizes, origins, legal[idx], MODE_ANY)
        else:
            mode = random.choices(POST_FORCED_LAYOUT_MODES, weights=POST_FORCED_LAYOUT_WEIGHTS, k=1)[0]
            candidates = _candidate_origins(sizes, origins, legal[idx], mode)
            if not candidates:
                candidates = _candidate_origins(sizes, origins, legal[idx], MODE_ANY)
        if not candidates:
            return None
        origins.append(random.choice(candidates))
    return origins


def _gen_attempt() -> np.ndarray | None:
    n_pairs = random.choice(PAIR_COUNT_CHOICES)
    pairs = _choose_pairs(n_pairs)
    sizes = [
        (random.randint(DOT_ROWS_MIN, DOT_ROWS_MAX), random.randint(DOT_COLS_MIN, DOT_COLS_MAX))
        for _ in range(n_pairs)
    ]
    origins = _choose_origins(n_pairs, sizes)
    if origins is None:
        return None

    data = _scene_data(sizes, origins)
    if data is None:
        return None
    remaining, boxes, dot_mask = data
    out = _render_output(pairs, remaining, boxes, dot_mask)
    if not _visible_overlap(pairs, boxes, dot_mask, out):
        return None

    inp = _build_input(pairs, remaining)
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 305b1341 input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
import random


def _x_mask(height: int, width: int) -> np.ndarray:
    assert height > 0 and width > 0, "interior must be nonempty"
    if height > width:
        return _x_mask(width, height).T

    mask = np.zeros((height, width), dtype=bool)
    center_rows = {(height - 1) // 2, height // 2}
    for r in range(height):
        d = min(r, height - 1 - r)
        left = d
        right = width - 1 - d
        assert left <= right, "x arms must not cross outside the interior"
        if r in center_rows:
            mask[r, left : right + 1] = True
        else:
            mask[r, left] = True
            mask[r, right] = True
    return mask


def main(grid: np.ndarray) -> np.ndarray:
    """
    Turn each filled marked rectangle into a frame containing an X drawn in the marker color.

    Input structure:
    - The background is the most common color.
    - Each 4-connected foreground object is a solid rectangular block with one
      embedded marker pixel of a different color.
    - The rectangle border is all one frame color, so the marker is strictly inside.

    Rule:
    - Replace the full canvas with background, then redraw each rectangle's border
      in its frame color.
    - Clear the rectangle interior except for an X in the marker color.
    - The X uses 45-degree arms from the interior corners and fills any center
      connector where opposite arms would otherwise be separated.

    Key insight:
    - The marker does not mark a position to preserve; it supplies the color for
      the canonical X pattern inside its containing frame.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    out = np.full(g.shape, bg, dtype=int)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert components, "expected at least one marked rectangle"

    for comp in components:
        r0, c0, r1, c1 = comp["bbox"]
        block = g[r0 : r1 + 1, c0 : c1 + 1]
        height, width = map(int, block.shape)
        assert height >= 3 and width >= 3, "rectangle must have an interior"
        assert np.all(block != bg), "foreground object must fill its bbox"

        border = np.concatenate(
            [block[0, :], block[-1, :], block[1:-1, 0], block[1:-1, -1]]
        )
        frame_colors = np.unique(border)
        assert frame_colors.size == 1, "rectangle border must have one frame color"
        frame = int(frame_colors[0])

        marker_colors = [int(color) for color in np.unique(block) if int(color) != frame]
        assert len(marker_colors) == 1, "expected one marker color in each rectangle"
        marker = marker_colors[0]
        assert int(np.sum(block == marker)) == 1, "marker color must appear once per rectangle"

        out[r0, c0 : c1 + 1] = frame
        out[r1, c0 : c1 + 1] = frame
        out[r0 : r1 + 1, c0] = frame
        out[r0 : r1 + 1, c1] = frame

        interior = out[r0 + 1 : r1, c0 + 1 : c1]
        interior[_x_mask(height - 2, width - 2)] = marker

    return out

# --------------- generator (o5x) ---------------

# Rectangle count and count-conditioned canvas bounds.
RECT_COUNT_CHOICES, RECT_COUNT_WEIGHTS = [1, 2, 3], [1, 3, 10]
GRID_ROWS_BY_RECT_COUNT = {1: (12, 19), 2: (13, 19), 3: (16, 19)}
GRID_COLS_BY_RECT_COUNT = {1: (14, 24), 2: (15, 24), 3: (18, 24)}

# Rectangle dimensions and area gates.
RECT_HEIGHT_BOUNDS, RECT_WIDTH_BOUNDS = (6, 13), (6, 11)
GRID_EDGE_PADDING, SINGLE_RECT_TOTAL_AREA_MARGIN = 1, 2
MIN_RECT_AREA = RECT_HEIGHT_BOUNDS[0] * RECT_WIDTH_BOUNDS[0]
MULTI_RECT_TOTAL_AREA_FRACTION = 0.56
SINGLE_RECT_AREA_FRACTION_BY_COUNT = {2: 0.40, 3: 0.36}

# Packing, colors, and retry budget.
PLACEMENT_BORDER, PLACEMENT_PADDING, PLACEMENT_PADDING_CONNECTIVITY = 1, 1, 4
BG_COLOR, COLOR_BINCOUNT_MIN_LENGTH, GEN_RETRY_LIMIT = 0, 10, 300
PALETTE_COLORS = list(range(1, 10))

def _gen_expected_output(shape: tuple[int, int], rects: list[tuple[int, int, int, int, int, int]]) -> np.ndarray:
    out = np.zeros(shape, dtype=int)
    for r0, c0, h, w, frame, marker in rects:
        r1 = r0 + h - 1
        c1 = c0 + w - 1
        out[r0, c0 : c1 + 1] = frame
        out[r1, c0 : c1 + 1] = frame
        out[r0 : r1 + 1, c0] = frame
        out[r0 : r1 + 1, c1] = frame
        interior = out[r0 + 1 : r1, c0 + 1 : c1]
        interior[_x_mask(h - 2, w - 2)] = marker
    return out

def _gen_choose_sizes(H: int, W: int, n_rects: int) -> list[tuple[int, int]] | None:
    """Choose rectangle sizes while preserving the original area rejection gates."""
    min_h, max_h_bound = RECT_HEIGHT_BOUNDS
    min_w, max_w_bound = RECT_WIDTH_BOUNDS
    max_h = min(max_h_bound, H - 2 * GRID_EDGE_PADDING)
    max_w = min(max_w_bound, W - 2 * GRID_EDGE_PADDING)
    if max_h < min_h or max_w < min_w:
        return None

    grid_area = H * W
    if n_rects == 1:
        total_limit = (grid_area - SINGLE_RECT_TOTAL_AREA_MARGIN) // 2
        single_limit = total_limit
    else:
        total_limit = int(grid_area * MULTI_RECT_TOTAL_AREA_FRACTION)
        single_limit = int(grid_area * SINGLE_RECT_AREA_FRACTION_BY_COUNT[n_rects])

    sizes: list[tuple[int, int]] = []
    used_area = 0
    for idx in range(n_rects):
        remaining_min_area = MIN_RECT_AREA * (n_rects - idx - 1)
        choices = [
            (h, w)
            for h in range(min_h, max_h + 1)
            for w in range(min_w, max_w + 1)
            if h * w <= single_limit and used_area + h * w + remaining_min_area <= total_limit
        ]
        if not choices:
            return None
        h, w = random.choice(choices)
        sizes.append((h, w))
        used_area += h * w

    random.shuffle(sizes)
    return sizes

def _gen_place_rectangles(shape: tuple[int, int], sizes: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
    """Pack rectangles with the same padding and random placement policy."""
    occupancy = np.zeros(shape, dtype=int)
    placed: list[tuple[int, int, int, int]] = []
    for h, w in sorted(sizes, key=lambda size: size[0] * size[1], reverse=True):
        patch = np.ones((h, w), dtype=int)
        try:
            r0, c0 = random_free_location(
                occupancy,
                patch,
                transparent=BG_COLOR,
                border=PLACEMENT_BORDER,
                padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_PADDING_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(occupancy, patch, r0, c0)
        placed.append((r0, c0, h, w))
    return placed

def _gen_render_marked_rectangles(
    shape: tuple[int, int], placed: list[tuple[int, int, int, int]]
) -> tuple[np.ndarray, list[tuple[int, int, int, int, int, int]]]:
    """Render the input grid and matching rectangle descriptors for oracle checks."""
    frame_colors = random.sample(PALETTE_COLORS, len(placed))
    grid = np.zeros(shape, dtype=int)
    rects: list[tuple[int, int, int, int, int, int]] = []
    for (r0, c0, h, w), frame in zip(placed, frame_colors):
        marker = random.choice([color for color in PALETTE_COLORS if color != frame])
        patch = np.full((h, w), frame, dtype=int)
        patch[random.randint(1, h - 2), random.randint(1, w - 2)] = marker
        paste(grid, patch, r0, c0)
        rects.append((r0, c0, h, w, frame, marker))
    return grid, rects

def _gen_matches_solver(shape: tuple[int, int], grid: np.ndarray, rects: list[tuple[int, int, int, int, int, int]]) -> bool:
    expected = _gen_expected_output(shape, rects)
    try:
        actual = main(grid)
    except Exception:
        return False
    return np.array_equal(actual, expected)

def _gen_attempt() -> np.ndarray | None:
    n_rects = random.choices(RECT_COUNT_CHOICES, weights=RECT_COUNT_WEIGHTS, k=1)[0]
    H = random.randint(*GRID_ROWS_BY_RECT_COUNT[n_rects])
    W = random.randint(*GRID_COLS_BY_RECT_COUNT[n_rects])

    sizes = _gen_choose_sizes(H, W, n_rects)
    if sizes is None:
        return None
    areas = [h * w for h, w in sizes]
    bg_area = H * W - sum(areas)
    if bg_area <= max(areas) + n_rects:
        return None

    shape = (H, W)
    placed = _gen_place_rectangles(shape, sizes)
    if placed is None:
        return None

    grid, rects = _gen_render_marked_rectangles(shape, placed)
    counts = np.bincount(grid.ravel(), minlength=COLOR_BINCOUNT_MIN_LENGTH)
    if counts[BG_COLOR] <= int(counts[1:].max()):
        return None
    if not _gen_matches_solver(shape, grid, rects):
        return None
    return grid

def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 8cb8642d input")

