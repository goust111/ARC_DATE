+import numpy as np
+
+
+BG = 0
+GREY = 5
+PINK = 6
+RECT_COLORS = (1, 2, 3, 4, 7, 8, 9)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 700
+
+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
