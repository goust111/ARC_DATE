+
+    second = _place_aligned_rect(
+        grid,
+        records,
+        src,
+        pass_dir,
+        colors[1],
+        "after_pass_lit",
+        through=False,
+        min_dist=first_far + random.randint(3, 5),
+    )
+    if second is None:
+        return None
+
+    direct = _place_aligned_rect(
+        grid, records, src, sink_dir, colors[2], "direct_lit", through=False, min_dist=3
+    )
+    if direct is None:
