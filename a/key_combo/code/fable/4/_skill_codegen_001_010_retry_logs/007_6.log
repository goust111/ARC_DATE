+    if any(info is None for info in infos):
+        return False
+    if len(gaps) == 1:
+        return True
+    side0, _inward0, key0 = infos[0]
+    side1, _inward1, key1 = infos[1]
+    return _opposite_side(side0) == side1 and key0 == key1
