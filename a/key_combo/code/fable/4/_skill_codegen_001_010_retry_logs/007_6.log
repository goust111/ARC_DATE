+    c0: int,
+    h: int,
+    w: int,
+    color: int,
+    gaps: set[tuple[int, int]],
+    label: str,
+) -> dict | None:
+    if not _padded_clear(grid, r0, c0, h, w):
+        return None
+    bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+    if not _valid_gap_set(sorted(gaps), bbox):
+        return None
+    record = {
