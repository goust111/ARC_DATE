+        r0, c0 = sr + dist, sc - offset
+        gaps = {(r0, sc)}
+        if through:
+            gaps.add((r0 + h - 1, sc))
+        far_dist = dist + h - 1
+    elif (dr, dc) == (-1, 0):
+        r0, c0 = sr - dist - h + 1, sc - offset
+        gaps = {(r0 + h - 1, sc)}
+        if through:
+            gaps.add((r0, sc))
+        far_dist = dist + h - 1
+    elif (dr, dc) == (0, 1):
+        r0, c0 = sr - offset, sc + dist
+        gaps = {(sr, c0)}
+        if through:
+            gaps.add((sr, c0 + w - 1))
+        far_dist = dist + w - 1
+    else:
+        r0, c0 = sr - offset, sc - dist - w + 1
+        gaps = {(sr, c0 + w - 1)}
+        if through:
