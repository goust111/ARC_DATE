        normal = (-dc, dr) if color == blue else (dc, -dr)
        r0, c0, r1, c1 = comp["bbox"]
        if normal[0] < 0:
            side = (r0 - 1, hc)
        elif normal[0] > 0:
            side = (r1 + 1, hc)
        elif normal[1] < 0:
            side = (hr, c0 - 1)
        else:
