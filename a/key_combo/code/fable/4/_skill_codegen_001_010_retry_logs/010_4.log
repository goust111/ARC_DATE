+    for coords in _components(grid != bg):
+        box = _bbox(coords)
+        values = [int(grid[cell]) for cell in coords]
+        coord_set = set(coords)
+        r0, c0, r1, c1 = box
+
+        if r1 - r0 >= 2 and c1 - c0 >= 2 and coord_set == _perimeter(box) and len(set(values)) == 1:
+            frames.append(box)
+            continue
