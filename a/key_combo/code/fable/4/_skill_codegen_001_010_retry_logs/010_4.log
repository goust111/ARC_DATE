+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+_DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_PALETTE = tuple(range(1, 10))
+_MAX_GENERATION_ATTEMPTS = 400
