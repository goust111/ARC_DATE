+    out = g.copy()
+    for rod, _target in plans:
+        for cell in rod["tail"]:
+            out[cell] = bg
+    for rod, target in plans:
+        for cell in target:
+            assert int(out[cell]) == bg, "folded tail must land on empty frame interior"
+            out[cell] = rod["line_color"]
