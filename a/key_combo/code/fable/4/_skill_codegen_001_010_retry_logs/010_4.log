+        rods.append(
+            {
+                "horizontal": horizontal,
+                "line_color": repeated[0],
+                "endpoint": endpoint,
+                "hinge": hinge,
+                "tail": [ordered[i] for i in tail_indices],
+                "fixed": [ordered[i] for i in fixed_indices],
+            }
+        )
