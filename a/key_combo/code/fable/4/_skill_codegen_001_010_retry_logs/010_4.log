+    directions = ((-1, 0), (1, 0)) if rod["horizontal"] else ((0, -1), (0, 1))
+    candidates: list[tuple[list[Coord], BBox]] = []
+    for dr, dc in directions:
+        cells = [(hr + step * dr, hc + step * dc) for step in range(1, length + 1)]
