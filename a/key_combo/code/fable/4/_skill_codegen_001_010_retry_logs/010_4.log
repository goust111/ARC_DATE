+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+_DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_PALETTE = tuple(range(1, 10))
+_MAX_GENERATION_ATTEMPTS = 400
+
+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    """Return 4-connected True components using canonical (row, column) coordinates."""
+    height, width = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    found: list[list[Coord]] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        queue = deque([(sr, sc)])
+        component: list[Coord] = []
+        while queue:
+            r, c = queue.popleft()
+            component.append((r, c))
+            for dr, dc in _DIR4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        found.append(component)
+    return found
+
