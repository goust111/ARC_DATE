+def _place_frames(height: int, width: int, sizes: list[tuple[int, int]]) -> list[BBox] | None:
+    boxes: list[BBox] = []
+    for frame_h, frame_w in sorted(sizes, reverse=True):
+        legal: list[BBox] = []
+        for r0 in range(1, height - frame_h):
