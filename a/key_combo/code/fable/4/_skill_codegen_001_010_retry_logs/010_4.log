+        while queue:
+            r, c = queue.popleft()
+            component.append((r, c))
+            for dr, dc in _DIR4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        found.append(component)
+    return found
