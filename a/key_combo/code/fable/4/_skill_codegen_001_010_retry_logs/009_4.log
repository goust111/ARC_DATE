+    g[r0 : r1 + 1, c1] = int(color)
+    g[r0, c0 : c1 + 1] = int(color)
+    g[r1, c0 : c1 + 1] = int(color)
+
+
+def _scatter_candidates(shape: tuple[int, int], box: BBox) -> list[Coord]:
+    height, width = map(int, shape)
