+                positions.append((r0, c0))
+            elif side == "top" and top <= 2 and bottom >= 5:
+                positions.append((r0, c0))
+            elif side == "bottom" and bottom <= 2 and top >= 5:
+                positions.append((r0, c0))
+    return positions
+
