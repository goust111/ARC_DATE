+def _outside_mask(shape: tuple[int, int], box: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    mask = np.ones(shape, dtype=bool)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = False
+    return mask
+
