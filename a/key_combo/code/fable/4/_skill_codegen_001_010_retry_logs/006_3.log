+        "category": category,
+        "start": start,
+        "direction": direction,
+        "step": step,
+        "slots": slots,
+        "statuses": statuses,
+        "patch": patch,
+        "steps": steps,
+        "target_idx": target_idx,
+        "bounced": bounced,
+        "skipped": skipped,
+    }
+
+
+def _expected_from_specs(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
+        r0, c0 = spec["start"]
+        out[r0 : r0 + 2, c0 : c0 + 2] = BG
+    for spec in specs:
+        for (r, c), status in zip(spec["slots"], spec["statuses"]):
+            out[r, c] = int(status)
