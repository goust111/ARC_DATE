+    cells = colors[:] + [random.choice(colors) for _ in range(4 - distinct)]
+    random.shuffle(cells)
+    return np.array(cells, dtype=int).reshape(2, 2)
+
+
+def _status_sample(category: str, steps: int) -> list[int] | None:
