+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
