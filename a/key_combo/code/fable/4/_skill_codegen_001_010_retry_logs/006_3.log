+
+def _status_sample(category: str, steps: int) -> list[int] | None:
+    if category == "regular":
+        length = random.randint(max(5, steps + 2), 7)
+        return [GREEN] * length
+
+    if category == "bounce":
+        if steps != 4:
+            return None
