+
+def _slot_coords(start: tuple[int, int], direction: tuple[int, int], step: int, length: int) -> list[tuple[int, int]]:
+    sr, sc = start
+    dr, dc = direction
+    return [(sr + dr * step * i, sc + dc * step * i) for i in range(length)]
+
