def _gen_marker_control_keys(marker_coords: set[tuple[int, int]]) -> set[tuple[int, str, tuple[int, int], tuple[tuple[int, int], ...]]]:
    rows = sorted({r for r, _c in marker_coords})
    cols = sorted({c for _r, c in marker_coords})
    keys = set()
    for r0 in rows:
        for r1 in rows:
            if r1 <= r0:
