+            color = int(rng.choice([BLUE, CYAN, RED, YELLOW, GREEN]))
+            axis_pos = int(rng.choice(all_axis_positions))
+            track = int(rng.integers(1, track_len - 1))
+            if _attempt_add_point(grid, orientation, axis_pos, track, color, occupied):
