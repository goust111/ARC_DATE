+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _build_attempt(np.random.default_rng())
+        if grid is not None:
+            return grid.astype(int)
+    raise RuntimeError("failed to generate a valid layered homing input")

