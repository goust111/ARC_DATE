            here = (tile_r, tile_c)
            there = (tile_rows - 1 - tile_r, tile_cols - 1 - tile_c)
            if here == there or here in seen or there in seen:
                continue
            pairs.append((here, there))
            seen.add(here)
            seen.add(there)
    return pairs


