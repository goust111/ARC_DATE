+    occupied.add((r, c))
+    return True
+
+
+def _add_required_point(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    orientation: str,
+    positions: list[int],
+    track: int,
+    color: int,
+    occupied: set[tuple[int, int]],
+) -> bool:
+    choices = positions.copy()
+    rng.shuffle(choices)
+    for axis_pos in choices:
+        if _attempt_add_point(grid, orientation, axis_pos, track, color, occupied):
+            return True
+    return False
+
