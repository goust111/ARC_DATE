+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+CYAN = 8
+
+COOL_COLORS = {BLUE, CYAN}
+WARM_COLORS = {RED, YELLOW}
