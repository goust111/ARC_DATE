+    if orientation == ROWS:
+        return int(axis_pos), int(track)
+    return int(track), int(axis_pos)
+
+
+def _axis_and_track(orientation: str, r: int, c: int) -> tuple[int, int]:
+    if orientation == ROWS:
+        return int(r), int(c)
+    return int(c), int(r)
