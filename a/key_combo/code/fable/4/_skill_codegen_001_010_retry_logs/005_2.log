+        width = int(c1 - c0 + 1)
+        net = pos_count - neg_count
+        assert abs(net) * 2 < min(height, width), "net magnitude must leave a nonempty core"
+
+        blocks.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "height": height,
+                "width": width,
+                "color": block_color,
+                "pos_count": pos_count,
+                "neg_count": neg_count,
+                "net": net,
+            }
+        )
