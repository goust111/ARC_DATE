+    for block in blocks:
+        r0, c0, r1, c1 = block["r0"], block["c0"], block["r1"], block["c1"]
+        net = int(block["net"])
+        total_controls = int(block["pos_count"] + block["neg_count"])
+        if net != 0 and total_controls <= abs(net):
+            return False
