+def _semantic_checks(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        solved = main(inp)
+        bg, legend, blocks = _parse_input(inp)
+    except Exception:
+        return False
+    if not np.array_equal(solved, expected):
