+            border = expected[r0 - pad : r1 + pad + 1, c0 - pad : c1 + pad + 1].copy()
+            border[pad : pad + region.shape[0], pad : pad + region.shape[1]] = int(block["color"])
+            if not bool(np.all(border == int(block["color"]))):
