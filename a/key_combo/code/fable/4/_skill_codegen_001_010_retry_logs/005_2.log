+            out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
+            out[r0 + cut : r1 - cut + 1, c0 + cut : c1 - cut + 1] = inp[
+                r0 + cut : r1 - cut + 1, c0 + cut : c1 - cut + 1
+            ]
