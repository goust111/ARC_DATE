+    h, w = occupied.shape
+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(h - 1, r1 + gap)
+    cc1 = min(w - 1, c1 + gap)
+    occupied[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
