WIDTH_RANGE = (5, 9)
MOTIF_H_RANGE = (3, 6)
# Foreground support and density limits.
BBOX_W_RANGE = (3, 5)
FG_DENSITY_RANGE = (0.30, 0.50)
# Generation retry limit.
MAX_ATTEMPTS = 300

