+    while cur in mapping:
+        assert cur not in seen, "color-pair legend must be acyclic"
+        seen.add(cur)
+        cur = int(mapping[cur])
+    return cur
+
+
+def _path_edges(color: int, mapping: dict[int, int]) -> list[tuple[int, int]]:
+    cur = int(color)
+    seen: set[int] = set()
+    edges: list[tuple[int, int]] = []
+    while cur in mapping:
+        assert cur not in seen, "color-pair legend must be acyclic"
+        seen.add(cur)
+        nxt = int(mapping[cur])
+        edges.append((cur, nxt))
+        cur = nxt
+    return edges
+
