    height, width, blank_rows, motif_h = dims
    colors = rng.choice(np.arange(10), size=3, replace=False)
    bg = int(colors[0])
    fg_colors = [int(colors[1]), int(colors[2])]
    bbox_w = int(rng.integers(BBOX_W_RANGE[0], min(BBOX_W_RANGE[1], width) + 1))
