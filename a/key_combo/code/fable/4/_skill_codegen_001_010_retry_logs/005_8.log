    for i, (r, c) in enumerate(coords):
        if i == 0:
            color = fg_colors[0]
        elif i == 1:
            color = fg_colors[1]
        else:
            color = int(rng.choice(fg_colors))
        motif[r, c0 + c] = color
    return motif

def _gen_attempt() -> np.ndarray | None:
