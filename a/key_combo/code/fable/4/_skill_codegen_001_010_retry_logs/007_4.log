+    if not np.array_equal(got[grid == BLUE], grid[grid == BLUE]):
+        return None
+    if not np.array_equal(got[grid == PINK], grid[grid == PINK]):
+        return None
+    if int(np.count_nonzero((got == RED) & (grid == BG))) < axis_len:
