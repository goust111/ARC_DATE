+def _pink_options(start: int, end: int, sign: int) -> list[int]:
+    opts = []
+    for pos in range(start + 1, end):
+        low_dist = pos - start
+        high_dist = end - pos
+        if sign < 0 and low_dist < high_dist:
+            opts.append(pos)
+        if sign > 0 and high_dist < low_dist:
+            opts.append(pos)
+    return opts
+
