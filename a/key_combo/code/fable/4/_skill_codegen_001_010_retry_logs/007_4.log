+
+# ---------------- generator ----------------
+
+GEN_ATTEMPTS = 500
+MIN_GAP = 3
+MAX_GAP = 5
+BAR_LENGTHS = (4, 5, 6, 7)
+HIT_COUNT_RANGE = (3, 6)
+
+
+def _shape(axis_len: int, lat_len: int, orient: str) -> tuple[int, int]:
