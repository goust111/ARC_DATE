    max_bar_height = min(height - 1, BAR_HEIGHT_RANGE[1])
    bar_height = int(np.random.randint(BAR_HEIGHT_RANGE[0], max_bar_height + 1))
    grid = np.full((height, width), Color.BLACK, dtype=int)
