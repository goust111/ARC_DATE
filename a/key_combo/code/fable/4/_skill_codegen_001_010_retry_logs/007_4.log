+def _bar_choices(lane: int, lat_len: int, allowed_signs: tuple[int, ...]) -> list[dict]:
+    choices: list[dict] = []
+    for length in BAR_LENGTHS:
+        max_start = lat_len - length - 2
+        for start in range(2, max_start + 1):
+            end = start + length - 1
+            if not (start <= lane <= end):
