+    max_len = total - 1
+    cells = _oriented_snake(n_rows, n_cols)
+    boundary_indices = [i for i, cell in enumerate(cells) if _is_boundary(cell, n_rows, n_cols)]
+    random.shuffle(boundary_indices)
