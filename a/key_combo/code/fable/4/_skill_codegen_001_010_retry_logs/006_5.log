+def _constant_region_size(lines: list[int], limit: int) -> int | None:
+    if len(lines) < 2 or lines[0] != 0 or lines[-1] != limit - 1:
+        return None
+    gaps = [lines[i + 1] - lines[i] - 1 for i in range(len(lines) - 1)]
+    if min(gaps) < 3 or len(set(gaps)) != 1:
