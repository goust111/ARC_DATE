+
+def _path_directions(path: list[tuple[int, int]]) -> list[str]:
+    directions = []
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        delta = (r1 - r0, c1 - c0)
+        directions.append(next(name for name, step in DIRS.items() if step == delta))
+    return directions
