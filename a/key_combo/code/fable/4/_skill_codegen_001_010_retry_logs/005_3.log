+    out, _frames, _active = _solve(grid)
+    return out
+
+
+def _empty_frame_patch(h: int, w: int, color: int) -> np.ndarray:
+    patch = np.full((h, w), _BG, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
+
+
+def _can_place(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(H, r0 + h + pad)
+    cc1 = min(W, c0 + w + pad)
+    return not bool(np.any(occupied[rr0:rr1, cc0:cc1]))
+
+
+def _place_frame_bboxes(H: int, W: int, count: int) -> list[dict] | None:
+    specs = [{"h": random.randint(4, 7), "w": random.randint(4, 8)} for _ in range(count)]
+    order = sorted(range(count), key=lambda i: specs[i]["h"] * specs[i]["w"], reverse=True)
+    occupied = np.zeros((H, W), dtype=bool)
+
+    def rec(k: int) -> bool:
+        if k == len(order):
+            return True
+        idx = order[k]
+        h, w = specs[idx]["h"], specs[idx]["w"]
+        starts = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
+        random.shuffle(starts)
+        for r0, c0 in starts:
+            if not _can_place(occupied, r0, c0, h, w, pad=1):
+                continue
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(H, r0 + h + 1)
+            cc1 = min(W, c0 + w + 1)
+            occupied[rr0:rr1, cc0:cc1] = True
+            specs[idx].update({"r0": r0, "c0": c0, "r1": r0 + h - 1, "c1": c0 + w - 1})
+            if rec(k + 1):
+                return True
+            occupied[rr0:rr1, cc0:cc1] = False
+            for key in ("r0", "c0", "r1", "c1"):
+                specs[idx].pop(key, None)
+        return False
+
+    if not rec(0):
+        return None
+    return specs
+
+
+def _choose_gap_cells(frame: dict) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame["bbox"]
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    options = [pt for pt in _border_coords(r0, c0, r1, c1) if pt not in corners]
+    random.shuffle(options)
+
+    chosen: list[tuple[int, int]] = []
+    target = random.randint(1, min(3, len(options)))
+    side_taken: set[str] = set()
+    for r, c in options:
+        if r == r0:
+            side = "top"
+        elif r == r1:
+            side = "bottom"
+        elif c == c0:
+            side = "left"
+        else:
+            side = "right"
+        if side in side_taken and len(side_taken) < 2:
+            continue
+        chosen.append((r, c))
+        side_taken.add(side)
+        if len(chosen) == target:
+            break
