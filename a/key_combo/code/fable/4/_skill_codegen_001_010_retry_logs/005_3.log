+
+    out = g.copy()
+    active: set[int] = set()
+    queue = list(broken)
+    while queue:
+        i = int(queue.pop(0))
+        if i in active:
+            continue
+        frame = frames[i]
+        _complete_and_fill(out, frame)
+        active.add(i)
+
+        next_color = int(frame["fill_color"])
+        if next_color not in color_to_frame:
