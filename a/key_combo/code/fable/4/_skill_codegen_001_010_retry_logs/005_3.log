+    non_frame_colors = sorted(set(Color.NOT_BLACK) - {int(frame["color"]) for frame in frames})
+    candidates = [(r, c) for r in range(H) for c in range(W) if not frame_bbox_mask[r, c] and grid[r, c] == _BG]
