+        r0, c0 = int(spec["r0"]), int(spec["c0"])
+        r1, c1 = int(spec["r1"]), int(spec["c1"])
+        frame = {
+            "h": int(spec["h"]),
+            "w": int(spec["w"]),
+            "r0": r0,
+            "c0": c0,
