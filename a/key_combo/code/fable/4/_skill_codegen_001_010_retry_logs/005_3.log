+    bottom = int(np.sum(g[r1, c0 : c1 + 1] == color))
+    left = int(np.sum(g[r0 : r1 + 1, c0] == color))
+    right = int(np.sum(g[r0 : r1 + 1, c1] == color))
+    return top, bottom, left, right
