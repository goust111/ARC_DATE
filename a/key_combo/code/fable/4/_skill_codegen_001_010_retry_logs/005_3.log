+def _attempt_generate() -> np.ndarray | None:
+    frame_count = random.randint(3, 5)
+    H = random.randint(18, 30)
+    W = random.randint(18, 30)
+    placed = _place_frame_bboxes(H, W, frame_count)
+    if placed is None:
