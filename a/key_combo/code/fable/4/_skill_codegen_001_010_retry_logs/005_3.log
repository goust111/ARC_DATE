+def _generated_expected(grid: np.ndarray, frames: list[dict], head: int) -> tuple[np.ndarray, set[int]] | None:
+    out = grid.copy()
+    by_color = {int(frame["color"]): i for i, frame in enumerate(frames)}
+    active: set[int] = set()
+    cur = int(head)
+    while True:
+        if cur in active:
+            return None
+        _complete_and_fill(out, frames[cur])
