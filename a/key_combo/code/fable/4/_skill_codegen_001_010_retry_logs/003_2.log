+# --------------- generator ---------------
+
+
+def _connected_offsets(max_h: int, max_w: int, count: int) -> Shape | None:
+    coords = {(random.randrange(max_h), random.randrange(max_w))}
+    misses = 0
+    while len(coords) < count and misses < 200:
+        r, c = random.choice(tuple(coords))
+        dirs = list(NEIGHBORS4)
+        random.shuffle(dirs)
+        added = False
+        for dr, dc in dirs:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < max_h and 0 <= nc < max_w and (nr, nc) not in coords:
+                coords.add((nr, nc))
+                added = True
+                break
