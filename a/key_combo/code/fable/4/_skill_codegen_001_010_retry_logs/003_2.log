+            if not all(out[r, c] for r, c in orbit):
+                continue
+            trial = out.copy()
+            for r, c in orbit:
+                trial[r, c] = False
+            if not _body_connected(trial):
+                continue
+            out = trial
+            placed = True
+            break
+        if not placed:
+            return None
+    return out
+
+
+def _adjacent_to(cells: set[Coord], other: set[Coord]) -> bool:
+    for r, c in cells:
+        for dr, dc in NEIGHBORS4:
+            if (r + dr, c + dc) in other:
+                return True
+    return False
+
+
+def _surrounded_by_body(cells: set[Coord], body_mask: np.ndarray) -> bool:
+    h, w = body_mask.shape
+    for r, c in cells:
