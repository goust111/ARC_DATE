+            gaps.append({"cells": cells, "shape": shape})
+            missing.update(cells)
+            used_variants.update(_shape_variants(shape))
+            accepted = True
+            break
+        if not accepted:
+            return None
+    return gaps
+
+
+def _shape_patch(shape: Shape, color: int) -> tuple[np.ndarray, list[Coord]]:
+    coords, h, w = shape
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in coords:
+        patch[r, c] = int(color)
+    return patch, sorted(coords)
+
+
+def _can_place_key(grid: np.ndarray, body_mask: np.ndarray, patch_cells: list[Coord], r0: int, c0: int) -> bool:
+    h, w = grid.shape
+    translated = {(int(r0 + r), int(c0 + c)) for r, c in patch_cells}
+    for r, c in translated:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if grid[r, c] != BG or body_mask[r, c]:
+            return False
+    for r, c in translated:
+        for dr, dc in NEIGHBORS8:
+            rr = r + dr
+            cc = c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if (rr, cc) in translated:
+                continue
+            if body_mask[rr, cc] or grid[rr, cc] != BG:
+                return False
+    return True
+
+
+def _place_keys(grid: np.ndarray, body_mask: np.ndarray, gaps: list[dict]) -> tuple[np.ndarray, list[dict]] | None:
+    out = grid.copy()
+    colors = random.sample(KEY_COLORS, len(gaps))
+    order = list(range(len(gaps)))
+    random.shuffle(order)
+    forced_rotated = random.choice(order)
+    key_infos: list[dict] = []
+
+    for gap_idx in order:
+        turns = random.randrange(4)
+        if gap_idx == forced_rotated and turns == 0:
+            turns = random.randint(1, 3)
+        key_shape = _rotate_shape(gaps[gap_idx]["shape"], turns)
+        color = colors[gap_idx]
+        patch, patch_cells = _shape_patch(key_shape, color)
+        ph, pw = patch.shape
+        candidates = [(r, c) for r in range(out.shape[0] - ph + 1) for c in range(out.shape[1] - pw + 1)]
+        random.shuffle(candidates)
+        placed = False
+        for r0, c0 in candidates:
+            if not _can_place_key(out, body_mask, patch_cells, r0, c0):
+                continue
+            for dr, dc in patch_cells:
+                out[r0 + dr, c0 + dc] = int(color)
+            key_infos.append({"gap_idx": gap_idx, "color": int(color), "turns": int(turns)})
+            placed = True
+            break
+        if not placed:
+            return None
+    return out, key_infos
+
+
+def _build_expected(grid: np.ndarray, gaps: list[dict], colors_by_gap: dict[int, int]) -> np.ndarray:
+    out = grid.copy()
+    out[(out != BG) & (out != BODY)] = BG
+    for idx, gap in enumerate(gaps):
+        color = colors_by_gap[idx]
+        for r, c in gap["cells"]:
+            out[r, c] = int(color)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(23, 30)
+    width = random.randint(23, 30)
+    max_side = min(13, height - 8, width - 8)
+    side_choices = [s for s in (9, 11, 13) if s <= max_side]
+    if not side_choices:
+        return None
+    side = random.choice(side_choices)
+
+    top = random.randint(4, height - side - 4)
+    left = random.randint(4, width - side - 4)
+    box = (top, left, top + side - 1, left + side - 1)
+    center = (top + side // 2, left + side // 2)
+    center2 = (2 * center[0], 2 * center[1])
+
+    body_mask = np.zeros((height, width), dtype=bool)
+    body_mask[top : top + side, left : left + side] = True
+    body_mask = _place_symmetric_voids(body_mask, center2, box)
+    if body_mask is None:
+        return None
+
+    gaps = _place_gaps(body_mask, center2, box)
+    if gaps is None:
+        return None
+
+    grid = np.full((height, width), BG, dtype=int)
+    grid[body_mask] = BODY
+    for gap in gaps:
+        for r, c in gap["cells"]:
+            grid[r, c] = BG
+
+    placed = _place_keys(grid, body_mask, gaps)
+    if placed is None:
+        return None
+    grid, key_infos = placed
+
+    colors_by_gap = {int(info["gap_idx"]): int(info["color"]) for info in key_infos}
+    if len(colors_by_gap) != len(gaps):
+        return None
+    if not any(int(info["turns"]) != 0 for info in key_infos):
+        return None
+
+    expected = _build_expected(grid, gaps, colors_by_gap)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid symmetric key-gap input")

