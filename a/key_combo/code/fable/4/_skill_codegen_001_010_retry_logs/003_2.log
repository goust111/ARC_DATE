def _build_long_pocket_combos():
    combos = []
    min_fg_cells, max_fg_cells = LONG_POCKET_FG_CELLS_RANGE
    for height in range(LONG_POCKET_HEIGHT_RANGE[0], LONG_POCKET_HEIGHT_RANGE[1] + 1):
