+    for _ in range(int(turns) % 4):
+        nr2 = sr + 2 * cc - sc
+        nc2 = sc - 2 * rr + sr
+        assert nr2 % 2 == 0 and nc2 % 2 == 0, "rotation center must map cells to cells"
+        rr = nr2 // 2
+        cc = nc2 // 2
