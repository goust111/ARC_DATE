+    out = coords
+    hh = int(h)
+    ww = int(w)
+    for _ in range(int(turns) % 4):
+        out = frozenset((c, hh - 1 - r) for r, c in out)
+        hh, ww = ww, hh
+    return out, hh, ww
+
+
+def _shape_variants(shape: Shape) -> set[frozenset[Coord]]:
