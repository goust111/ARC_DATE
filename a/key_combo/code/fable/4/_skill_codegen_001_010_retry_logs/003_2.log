+        return None
+    return _normalize_shape(coords)
+
+
+def _sample_gap_shape(used_variants: set[frozenset[Coord]]) -> Shape | None:
+    for _ in range(200):
+        max_h = random.randint(2, 4)
+        max_w = random.randint(2, 4)
+        count = random.randint(3, min(6, max_h * max_w))
+        shape = _connected_offsets(max_h, max_w, count)
+        if shape is None:
+            continue
+        coords, h, w = shape
+        if h < 2 or w < 2:
+            continue
+        variants = _shape_variants(shape)
+        if len(variants) != 4:
+            continue
+        if variants & used_variants:
+            continue
+        return shape
+    return None
+
+
+def _sample_void_shape() -> Shape | None:
+    count = random.randint(1, 3)
+    return _connected_offsets(3, 3, count)
+
+
+def _in_square(cells: set[Coord], box: tuple[int, int, int, int], margin: int = 0) -> bool:
+    r0, c0, r1, c1 = box
+    return all(r0 + margin <= r <= r1 - margin and c0 + margin <= c <= c1 - margin for r, c in cells)
+
+
+def _body_connected(mask: np.ndarray) -> bool:
+    comps = _mask_components(mask)
+    return len(comps) == 1
+
+
+def _orbit_union(cells: set[Coord], center2: tuple[int, int]) -> set[Coord]:
+    out: set[Coord] = set()
+    for turns in range(4):
+        out.update(_rotate_cells(cells, center2, turns))
+    return out
+
+
+def _place_symmetric_voids(body_mask: np.ndarray, center2: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray | None:
+    target = random.randint(1, 3)
+    out = body_mask.copy()
+    for _ in range(target):
+        placed = False
+        for _attempt in range(200):
+            shape = _sample_void_shape()
+            if shape is None:
+                continue
+            coords, h, w = shape
+            r0, c0, r1, c1 = box
+            if r1 - r0 + 1 <= h + 4 or c1 - c0 + 1 <= w + 4:
+                continue
+            ar = random.randint(r0 + 2, r1 - h - 1)
+            ac = random.randint(c0 + 2, c1 - w - 1)
