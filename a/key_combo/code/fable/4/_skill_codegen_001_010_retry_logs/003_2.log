+        for _attempt in range(350):
+            base = _sample_gap_shape(used_variants)
+            if base is None:
+                continue
+            shape = _rotate_shape(base, random.randrange(4))
+            coords, h, w = shape
+            if r1 - r0 + 1 <= h + 4 or c1 - c0 + 1 <= w + 4:
+                continue
+            ar = random.randint(r0 + 2, r1 - h - 1)
+            ac = random.randint(c0 + 2, c1 - w - 1)
+            cells = {(ar + r, ac + c) for r, c in coords}
+
+            if not _in_square(cells, box, margin=2):
