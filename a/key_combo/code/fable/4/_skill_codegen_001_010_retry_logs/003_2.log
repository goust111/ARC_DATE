+    Rule:
+    - Infer the body's center from the gray bbox and rotate every visible gray pixel through the four quarter-turn positions.
+    - The inferred body cells that are currently background are the true gaps; symmetric voids remain background because no rotated gray pixel implies them.
+    - Match each outside key sprite to exactly one gap by comparing all four rotations of the key shape.
+    - Erase all outside keys, fill every matched gap with its key's color, and leave all other body pixels gray.
+
+    Key insight:
+    - The missing shape is defined by the three gray rotational counterparts, while the colored key supplies only the color and a rotated verification of that shape.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+    bg = _background(g)
+    center2, _bbox = _body_center(g)
+    complete, gaps = _infer_gap_components(g, bg, center2)
+    gaps = sorted(gaps, key=lambda obj: tuple(map(int, obj["bbox"])))
+    keys = _key_components(g, bg, complete)
+    matching = _unique_matching(gaps, keys)
+
+    out = g.copy()
+    out[(g != bg) & (g != BODY)] = bg
+    for gap_idx, key_idx in enumerate(matching):
+        coords = gaps[gap_idx]["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(keys[key_idx]["color"])
+    return out
+
+
+# --------------- generator ---------------
+
+
+def _connected_offsets(max_h: int, max_w: int, count: int) -> Shape | None:
+    coords = {(random.randrange(max_h), random.randrange(max_w))}
+    misses = 0
+    while len(coords) < count and misses < 200:
+        r, c = random.choice(tuple(coords))
+        dirs = list(NEIGHBORS4)
+        random.shuffle(dirs)
+        added = False
+        for dr, dc in dirs:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < max_h and 0 <= nc < max_w and (nr, nc) not in coords:
+                coords.add((nr, nc))
+                added = True
+                break
+        if not added:
+            misses += 1
+    if len(coords) != count:
+        return None
+    return _normalize_shape(coords)
+
+
+def _sample_gap_shape(used_variants: set[frozenset[Coord]]) -> Shape | None:
+    for _ in range(200):
+        max_h = random.randint(2, 4)
+        max_w = random.randint(2, 4)
+        count = random.randint(3, min(6, max_h * max_w))
+        shape = _connected_offsets(max_h, max_w, count)
+        if shape is None:
+            continue
+        coords, h, w = shape
+        if h < 2 or w < 2:
+            continue
+        variants = _shape_variants(shape)
+        if len(variants) != 4:
+            continue
+        if variants & used_variants:
+            continue
+        return shape
+    return None
+
+
+def _sample_void_shape() -> Shape | None:
+    count = random.randint(1, 3)
+    return _connected_offsets(3, 3, count)
+
+
+def _in_square(cells: set[Coord], box: tuple[int, int, int, int], margin: int = 0) -> bool:
+    r0, c0, r1, c1 = box
+    return all(r0 + margin <= r <= r1 - margin and c0 + margin <= c <= c1 - margin for r, c in cells)
+
+
+def _body_connected(mask: np.ndarray) -> bool:
+    comps = _mask_components(mask)
+    return len(comps) == 1
+
+
+def _orbit_union(cells: set[Coord], center2: tuple[int, int]) -> set[Coord]:
+    out: set[Coord] = set()
+    for turns in range(4):
+        out.update(_rotate_cells(cells, center2, turns))
+    return out
+
+
+def _place_symmetric_voids(body_mask: np.ndarray, center2: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray | None:
+    target = random.randint(1, 3)
+    out = body_mask.copy()
+    for _ in range(target):
+        placed = False
+        for _attempt in range(200):
+            shape = _sample_void_shape()
+            if shape is None:
+                continue
+            coords, h, w = shape
+            r0, c0, r1, c1 = box
+            if r1 - r0 + 1 <= h + 4 or c1 - c0 + 1 <= w + 4:
+                continue
+            ar = random.randint(r0 + 2, r1 - h - 1)
+            ac = random.randint(c0 + 2, c1 - w - 1)
+            cells = {(ar + r, ac + c) for r, c in coords}
+            orbit = _orbit_union(cells, center2)
+            if not _in_square(orbit, box, margin=1):
+                continue
+            if not all(out[r, c] for r, c in orbit):
+                continue
+            trial = out.copy()
+            for r, c in orbit:
+                trial[r, c] = False
+            if not _body_connected(trial):
+                continue
+            out = trial
+            placed = True
+            break
+        if not placed:
+            return None
+    return out
+
+
+def _adjacent_to(cells: set[Coord], other: set[Coord]) -> bool:
+    for r, c in cells:
+        for dr, dc in NEIGHBORS4:
+            if (r + dr, c + dc) in other:
+                return True
+    return False
+
+
+def _surrounded_by_body(cells: set[Coord], body_mask: np.ndarray) -> bool:
+    h, w = body_mask.shape
+    for r, c in cells:
+        for dr, dc in NEIGHBORS4:
+            rr = r + dr
+            cc = c + dc
+            if not (0 <= rr < h and 0 <= cc < w and body_mask[rr, cc]):
+                return False
+    return True
+
+
+def _place_gaps(body_mask: np.ndarray, center2: tuple[int, int], box: tuple[int, int, int, int]) -> list[dict] | None:
+    gap_count = random.randint(2, 4)
+    used_variants: set[frozenset[Coord]] = set()
+    missing: set[Coord] = set()
+    gaps: list[dict] = []
+    r0, c0, r1, c1 = box
+
+    for _ in range(gap_count):
+        accepted = False
+        for _attempt in range(350):
+            base = _sample_gap_shape(used_variants)
+            if base is None:
+                continue
+            shape = _rotate_shape(base, random.randrange(4))
+            coords, h, w = shape
+            if r1 - r0 + 1 <= h + 4 or c1 - c0 + 1 <= w + 4:
+                continue
+            ar = random.randint(r0 + 2, r1 - h - 1)
+            ac = random.randint(c0 + 2, c1 - w - 1)
+            cells = {(ar + r, ac + c) for r, c in coords}
+
+            if not _in_square(cells, box, margin=2):
+                continue
+            if not all(body_mask[r, c] for r, c in cells):
+                continue
+            if not _surrounded_by_body(cells, body_mask):
+                continue
+            rotations = [_rotate_cells(cells, center2, turns) for turns in range(4)]
+            if any(not all(body_mask[r, c] for r, c in rotated) for rotated in rotations):
+                continue
+            if any(rotations[turns] & cells for turns in (1, 2, 3)):
+                continue
+            if any(rotated & missing for rotated in rotations):
+                continue
+            if _adjacent_to(cells, missing):
+                continue
+
+            gaps.append({"cells": cells, "shape": shape})
+            missing.update(cells)
+            used_variants.update(_shape_variants(shape))
+            accepted = True
+            break
+        if not accepted:
+            return None
+    return gaps
+
+
+def _shape_patch(shape: Shape, color: int) -> tuple[np.ndarray, list[Coord]]:
+    coords, h, w = shape
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in coords:
+        patch[r, c] = int(color)
+    return patch, sorted(coords)
+
+
+def _can_place_key(grid: np.ndarray, body_mask: np.ndarray, patch_cells: list[Coord], r0: int, c0: int) -> bool:
+    h, w = grid.shape
+    translated = {(int(r0 + r), int(c0 + c)) for r, c in patch_cells}
+    for r, c in translated:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if grid[r, c] != BG or body_mask[r, c]:
+            return False
+    for r, c in translated:
+        for dr, dc in NEIGHBORS8:
+            rr = r + dr
+            cc = c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if (rr, cc) in translated:
+                continue
+            if body_mask[rr, cc] or grid[rr, cc] != BG:
+                return False
+    return True
+
+
+def _place_keys(grid: np.ndarray, body_mask: np.ndarray, gaps: list[dict]) -> tuple[np.ndarray, list[dict]] | None:
+    out = grid.copy()
+    colors = random.sample(KEY_COLORS, len(gaps))
+    order = list(range(len(gaps)))
+    random.shuffle(order)
+    forced_rotated = random.choice(order)
+    key_infos: list[dict] = []
+
+    for gap_idx in order:
+        turns = random.randrange(4)
+        if gap_idx == forced_rotated and turns == 0:
+            turns = random.randint(1, 3)
+        key_shape = _rotate_shape(gaps[gap_idx]["shape"], turns)
+        color = colors[gap_idx]
+        patch, patch_cells = _shape_patch(key_shape, color)
+        ph, pw = patch.shape
+        candidates = [(r, c) for r in range(out.shape[0] - ph + 1) for c in range(out.shape[1] - pw + 1)]
+        random.shuffle(candidates)
+        placed = False
+        for r0, c0 in candidates:
+            if not _can_place_key(out, body_mask, patch_cells, r0, c0):
+                continue
+            for dr, dc in patch_cells:
+                out[r0 + dr, c0 + dc] = int(color)
+            key_infos.append({"gap_idx": gap_idx, "color": int(color), "turns": int(turns)})
+            placed = True
+            break
+        if not placed:
+            return None
+    return out, key_infos
+
+
+def _build_expected(grid: np.ndarray, gaps: list[dict], colors_by_gap: dict[int, int]) -> np.ndarray:
+    out = grid.copy()
+    out[(out != BG) & (out != BODY)] = BG
+    for idx, gap in enumerate(gaps):
+        color = colors_by_gap[idx]
+        for r, c in gap["cells"]:
+            out[r, c] = int(color)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(23, 30)
+    width = random.randint(23, 30)
+    max_side = min(13, height - 8, width - 8)
+    side_choices = [s for s in (9, 11, 13) if s <= max_side]
+    if not side_choices:
+        return None
+    side = random.choice(side_choices)
+
+    top = random.randint(4, height - side - 4)
+    left = random.randint(4, width - side - 4)
+    box = (top, left, top + side - 1, left + side - 1)
+    center = (top + side // 2, left + side // 2)
+    center2 = (2 * center[0], 2 * center[1])
+
+    body_mask = np.zeros((height, width), dtype=bool)
+    body_mask[top : top + side, left : left + side] = True
+    body_mask = _place_symmetric_voids(body_mask, center2, box)
+    if body_mask is None:
+        return None
+
+    gaps = _place_gaps(body_mask, center2, box)
+    if gaps is None:
+        return None
+
+    grid = np.full((height, width), BG, dtype=int)
+    grid[body_mask] = BODY
+    for gap in gaps:
+        for r, c in gap["cells"]:
+            grid[r, c] = BG
+
+    placed = _place_keys(grid, body_mask, gaps)
+    if placed is None:
+        return None
+    grid, key_infos = placed
+
+    colors_by_gap = {int(info["gap_idx"]): int(info["color"]) for info in key_infos}
+    if len(colors_by_gap) != len(gaps):
+        return None
+    if not any(int(info["turns"]) != 0 for info in key_infos):
+        return None
+
+    expected = _build_expected(grid, gaps, colors_by_gap)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid symmetric key-gap input")

