+
+
+def _place_gaps(body_mask: np.ndarray, center2: tuple[int, int], box: tuple[int, int, int, int]) -> list[dict] | None:
+    gap_count = random.randint(2, 4)
+    used_variants: set[frozenset[Coord]] = set()
+    missing: set[Coord] = set()
+    gaps: list[dict] = []
