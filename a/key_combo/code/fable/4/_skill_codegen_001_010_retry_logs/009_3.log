+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (1, 4),
+    (4, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (2, 4),
+    (4, 2),
+    (3, 3),
+)
+
+BASE_MOTIF = (
+    ((0, 0), (0, 1), (0, 2), (0, 3)),  # start object
+    ((2, 5),),  # pixel-nearest from start
+    ((3, 1),),  # center-nearest from start, but farther by pixel distance
+)
+
+
+def _motif_variant() -> list[np.ndarray]:
+    transforms = (
+        lambda r, c: (r, c),
+        lambda r, c: (r, -c),
+        lambda r, c: (-r, c),
