+    out[marker] = bg
+    old_colors = [objects[idx]["color"] for idx in chain]
+    for pos, idx in enumerate(chain):
+        coords = objects[idx]["coords"]
+        out[coords[:, 0], coords[:, 1]] = old_colors[pos - 1]
