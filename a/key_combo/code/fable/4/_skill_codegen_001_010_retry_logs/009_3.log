+        lambda r, c: (c, r),
+        lambda r, c: (c, -r),
+        lambda r, c: (-c, r),
+        lambda r, c: (-c, -r),
+    )
+    transform = random.choice(transforms)
+    pieces = []
+    all_pts = []
+    for obj in BASE_MOTIF:
+        pts = np.asarray([transform(r, c) for r, c in obj], dtype=int)
+        pieces.append(pts)
+        all_pts.extend(map(tuple, pts))
