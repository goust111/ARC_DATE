+    r0, c0, r1, c1 = obj["bbox"]
+    return int(r0 + r1), int(c0 + c1)
+
+
+def _center_distance(a: dict, b: dict) -> int:
+    ar, ac = _center2(a)
+    br, bc = _center2(b)
