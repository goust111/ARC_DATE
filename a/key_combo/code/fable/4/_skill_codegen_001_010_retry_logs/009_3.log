+from collections import Counter
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+START_MARKER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield int(r) + dr, int(c) + dc
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == int(bg) or color == START_MARKER:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.asarray(coords, dtype=int)
+            comps.append(
+                {
+                    "id": len(comps),
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _coords_distance(a: np.ndarray, b: np.ndarray) -> int:
+    dr = np.abs(a[:, None, 0] - b[None, :, 0])
+    dc = np.abs(a[:, None, 1] - b[None, :, 1])
+    return int(np.maximum(dr, dc).min())
+
+
+def _object_distance(a: dict, b: dict) -> int:
+    return _coords_distance(a["coords"], b["coords"])
+
