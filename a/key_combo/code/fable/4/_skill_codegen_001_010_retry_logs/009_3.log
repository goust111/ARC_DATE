+def _parse_scene(grid: np.ndarray) -> tuple[list[dict], tuple[int, int], int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _get_bg(g)
