+            return False
+        if int(out[marker]) != BACKGROUND:
+            return False
+        if np.count_nonzero(out == START_MARKER):
+            return False
+
+        fg_in = (grid != BACKGROUND) & (grid != START_MARKER)
+        fg_out = out != BACKGROUND
+        if not np.array_equal(fg_in, fg_out):
