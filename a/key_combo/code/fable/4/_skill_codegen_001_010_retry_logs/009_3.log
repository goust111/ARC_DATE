+    for r, c in coords:
+        if not (0 <= int(r) < h and 0 <= int(c) < w):
+            return False
+        r0, r1 = max(0, int(r) - 1), min(h, int(r) + 2)
+        c0, c1 = max(0, int(c) - 1), min(w, int(c) + 2)
+        if bool(occ[r0:r1, c0:c1].any()):
