+# ---------------- generator ----------------
+
+GRID_SIDE_RANGE = (15, 26)
+OBJECT_COUNT_RANGE = (4, 7)
+GENERATION_ATTEMPTS = 1200
+PLACE_ATTEMPTS = 300
+
