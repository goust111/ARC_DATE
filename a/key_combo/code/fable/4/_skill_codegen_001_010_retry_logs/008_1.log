+    for _ in range(250):
+        lengths = [random.randint(1, 6) for _ in range(n_segments)]
+        total = sum(lengths)
+        if not 9 <= total <= 29:
+            continue
+        if max(lengths) < 2 or len(set(lengths)) < 2:
+            continue
+        if _trace_relative(lengths) is None:
+            continue
+        return lengths
+
