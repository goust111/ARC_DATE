+def _has_shadow_distractor(
+    grid: np.ndarray,
+    hits: list[tuple[int, int, int]],
+    incoming_dirs: list[tuple[int, int]],
+) -> bool:
+    hit_cells = {(r, c) for r, c, _color in hits}
+    for (r, c, _color), direction in zip(hits[:-1], incoming_dirs[:-1]):
