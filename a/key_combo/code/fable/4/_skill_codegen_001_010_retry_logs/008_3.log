+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+ORANGE = 7
+TEAL = 8
+
+TURN_COLORS = (BLUE, RED)
+ALLOWED_INPUT_COLORS = {BLACK, BLUE, RED, TEAL}
+
+MIN_STEP = 2
