# Line-symbol shape, density, and compression bounds.
_GEN_SYMBOL_SIZE_MIN, _GEN_SYMBOL_SIZE_MAX = 3, 5
_GEN_SYMBOL_DENSITY_MIN, _GEN_SYMBOL_DENSITY_MAX = 0.55, 0.89
_GEN_PROTO_DENSITY_MIN = 0.78
