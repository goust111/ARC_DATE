+
+def _ray_cells(
+    shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]
+) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = direction
+    out: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return out
+        out.append((r, c))
+
+
+def _open_segment(
+    start: tuple[int, int], end: tuple[int, int], direction: tuple[int, int]
+) -> list[tuple[int, int]]:
