+        r, c = rng.choice(candidates)
+        grid[r, c] = rng.choice(TURN_COLORS)
+        occupied.add((r, c))
+
+    if not _semantic_check(grid, hits, incoming_dirs):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
