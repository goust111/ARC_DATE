+def _trace_hits(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert set(map(int, np.unique(g))) <= ALLOWED_INPUT_COLORS, "unexpected input color"
