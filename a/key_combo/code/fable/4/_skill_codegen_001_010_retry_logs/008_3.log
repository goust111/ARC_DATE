+    return False
+
+
+def _semantic_check(
+    grid: np.ndarray,
+    expected_hits: list[tuple[int, int, int]],
+    incoming_dirs: list[tuple[int, int]],
+) -> bool:
+    try:
+        traced = _trace_hits(grid)
+    except AssertionError:
+        return False
+    if traced != expected_hits:
+        return False
+    if len(traced) < HIT_COUNT_RANGE[0]:
