+    cells: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            cell = (r, c)
+            if cell in occupied or cell in forbidden:
+                continue
+            if _too_close(cell, occupied):
