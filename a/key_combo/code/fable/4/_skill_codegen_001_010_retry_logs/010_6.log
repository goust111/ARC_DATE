+def _slot_positions(count: int, shapes_by_rank: list[np.ndarray], height: int, width: int):
+    columns = 3 if count >= 5 else 2
+    slots = [(r, c) for r in range(2) for c in range(columns)][:count]
+    rank_order = list(range(1, count + 1))
