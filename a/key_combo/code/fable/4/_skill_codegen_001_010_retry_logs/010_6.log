+def _unique_mode(values: np.ndarray, message: str) -> int:
+    colors, counts = np.unique(values, return_counts=True)
+    largest = int(counts.max())
+    winners = colors[counts == largest]
+    assert winners.size == 1, message
+    return int(winners[0])
