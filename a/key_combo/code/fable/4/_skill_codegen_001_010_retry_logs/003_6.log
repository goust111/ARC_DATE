+def _erase_blocks(g: np.ndarray, bg: int, blocks: list[dict]) -> np.ndarray:
+    erased = g.copy()
+    for block in blocks:
+        r0, c0, r1, c1 = block["bbox"]
+        erased[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
+    return erased
