import numpy as np

from arc_utils import Color, get_bg


DIAMOND_CELLS = ((0, 1), (1, 0), (1, 2), (2, 1))
DIAMOND_SET = set(DIAMOND_CELLS)
NEIGHBOR_DIRECTIONS = (
    (-1, 0),
    (-1, 1),
    (0, 1),
    (1, 1),
    (1, 0),
    (1, -1),
