GEN_PREFIX_MIN_ROWS_PER_COLUMN = 1
GEN_PREFIX_VARIATION_ROW, GEN_PREFIX_REPAIR_ROW = 0, 1
GEN_PREFIX_FLIP_CHOICES = [False, True]

# Retry budget.
