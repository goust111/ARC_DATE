+def _local_holes(patch: np.ndarray, bg: int) -> list[np.ndarray] | None:
+    height, width = map(int, patch.shape)
+    _labels, comps = _components(patch == int(bg))
+    holes: list[np.ndarray] = []
+
+    for coords in comps:
