+def _reading_order_regions(g: np.ndarray, bg: int) -> list[np.ndarray]:
+    _labels, regions = _components(g == int(bg))
+    regions.sort(key=lambda coords: (int(coords[:, 0].min()), int(coords[:, 1].min())))
+    return regions
