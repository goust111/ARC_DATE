+        return False
+
+    side = random.choice(sides)
+    length = random.randint(1, 2)
+    if side in ("top", "bottom"):
+        if c1 - c0 < 4:
+            return False
+        c = random.randint(c0 + 2, c1 - 2)
+        if side == "top":
+            sep = r0 - 1
+            for dr in range(1, length + 1):
+                grid[sep + dr, c] = BARRIER
+        else:
+            sep = r1 + 1
+            for dr in range(1, length + 1):
