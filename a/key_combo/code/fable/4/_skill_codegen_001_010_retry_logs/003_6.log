+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+ARC_COLORS = tuple(range(10))
+BG = 0
+BARRIER = 5
+BLOCK_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATION_ATTEMPTS = 700
