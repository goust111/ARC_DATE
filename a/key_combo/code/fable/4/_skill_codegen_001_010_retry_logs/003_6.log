+    for coords in comps:
+        touches_edge = np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 0] == height - 1)
+            | (coords[:, 1] == 0)
+            | (coords[:, 1] == width - 1)
+        )
+        if touches_edge:
