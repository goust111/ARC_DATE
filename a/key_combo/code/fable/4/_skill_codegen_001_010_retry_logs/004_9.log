+        length = segment_index + 1
+        for _ in range(length):
+            row += dr
+            col += dc
+            coord = (row, col)
+            assert coord not in occupied, "spiral path should not overlap itself"
+            occupied.add(coord)
+            cells.append((row, col, int(color), segment_index))
+
+    return cells
+
