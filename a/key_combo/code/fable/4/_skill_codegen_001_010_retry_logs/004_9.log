/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/4/004/9.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

def oracle(colors):
    dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)]
    r, c = 0, -1
    cells = []
    for i, color in enumerate(colors):
        dr, dc = dirs[i % 4]
        for _ in range(i + 1):
            r += dr
            c += dc
            cells.append((r, c, int(color)))
    rs = [x for x, _, _ in cells]
    cs = [y for _, y, _ in cells]
    r0, r1 = min(rs), max(rs)
    c0, c1 = min(cs), max(cs)
    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    seen = set()
    for r, c, color in cells:
        assert (r, c) not in seen
        seen.add((r, c))
        out[r - r0, c - c0] = color
    return out

for k in range(3, 30):
    colors = (np.arange(k) % 9 + 1).astype(int)
    inp = colors.reshape(-1, 1)
    out = mod.main(inp)
    exp = oracle(colors)
    assert np.array_equal(out, exp), k
    assert max(out.shape) <= 30, (k, out.shape)
    assert np.count_nonzero(out) == k * (k + 1) // 2

base = (np.arange(8) % 9 + 1).reshape(-1, 1).astype(int)
changed = base.copy()
changed[3, 0] = 9 if changed[3, 0] "'!= 9 else 8
assert not np.array_equal(mod.main(base), mod.main(changed))
print('"'semantic ok')
