    """Return occupied cells plus their 4-neighbor no-touch padding."""
    forbidden = mask.copy()
    forbidden[1:, :] |= mask[:-1, :]
    forbidden[:-1, :] |= mask[1:, :]
    forbidden[:, 1:] |= mask[:, :-1]
    forbidden[:, :-1] |= mask[:, 1:]
