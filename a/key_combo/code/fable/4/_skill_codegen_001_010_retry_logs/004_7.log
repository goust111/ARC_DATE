+    partner_pos = anomaly_pair[1 - (call_index % 2)]
+    repaired[anomaly_pos] = partner_color
+    repaired[partner_pos] = partner_color
+    corrupt[partner_pos] = partner_color
+    corrupt[anomaly_pos] = anomaly_color
