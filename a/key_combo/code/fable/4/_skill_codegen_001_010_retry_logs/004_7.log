+        sep_cols = [c for c in range(width) if bool(np.all(g[:, c] == color))]
+        if not sep_rows or not sep_cols:
+            continue
+
+        sep_mask = np.zeros(g.shape, dtype=bool)
+        sep_mask[sep_rows, :] = True
+        sep_mask[:, sep_cols] = True
