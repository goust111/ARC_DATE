+    grid: np.ndarray,
+    windows: list[list[np.ndarray]],
+    expected: np.ndarray,
+    palette: list[int],
+) -> bool:
+    """Check the stated rule, uniqueness cues, and sampled-cell dependencies."""
+    n = len(windows)
+    if grid.shape != (n * n + n - 1, n * n + n - 1):
+        return False
+    if max(grid.shape) > 30 or np.unique(expected).size < 3:
+        return False
+
