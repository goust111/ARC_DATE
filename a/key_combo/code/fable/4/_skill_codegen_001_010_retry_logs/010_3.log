+    grid = np.full((size, size), _SEPARATOR_COLOR, dtype=int)
+    for i in range(n):
+        for j in range(n):
+            r0, c0 = i * (n + 1), j * (n + 1)
+            grid[r0 : r0 + n, c0 : c0 + n] = windows[i][j]
+    return grid
+
+
