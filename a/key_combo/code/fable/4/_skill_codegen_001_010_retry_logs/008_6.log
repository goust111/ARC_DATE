+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+CELL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+POSES = tuple(range(8))
+QUARTER_TURNS = {1, 3}
+REFLECTIONS = {4, 5, 6, 7}
