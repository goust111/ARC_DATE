+        if len(frames) < 2:
+            continue
+        dims = {(len(rows) - 1, len(cols) - 1) for rows, cols in frames}
+        if len(dims) == 1:
+            frames.sort(key=lambda rc: (rc[0][0], rc[1][0]))
+            candidates.append((color, frames))
