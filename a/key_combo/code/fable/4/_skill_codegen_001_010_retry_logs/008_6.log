+    found: list[tuple[tuple[int, ...], dict[tuple[int, int], int]]] = []
+    if not observations:
+        return found
+
+    pose_ranges = [[0]] + [list(POSES) for _ in range(len(observations) - 1)]
+    for pose_tuple in itertools.product(*pose_ranges):
