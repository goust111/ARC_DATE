+def _pose_coord(pose: int, r: int, c: int, n: int) -> tuple[int, int]:
+    r = int(r)
+    c = int(c)
+    last = int(n) - 1
+    if pose == 0:
+        return r, c
+    if pose == 1:
+        return c, last - r
+    if pose == 2:
+        return last - r, last - c
+    if pose == 3:
+        return last - c, r
+    if pose == 4:
+        return last - r, c
+    if pose == 5:
+        return r, last - c
+    if pose == 6:
+        return c, r
+    if pose == 7:
+        return last - c, last - r
+    raise ValueError("bad pose")
