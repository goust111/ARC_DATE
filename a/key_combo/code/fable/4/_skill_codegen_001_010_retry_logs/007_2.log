+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr or dc:
+                yield r + dr, c + dc
+
+
+def _components8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    remaining = {(int(r), int(c)) for r, c in np.argwhere(mask)}
+    comps: list[list[tuple[int, int]]] = []
+    while remaining:
+        seed = remaining.pop()
+        stack = [seed]
+        comp = [seed]
+        while stack:
+            r, c = stack.pop()
+            for nb in _neighbors8(r, c):
+                if nb in remaining:
+                    remaining.remove(nb)
+                    stack.append(nb)
+                    comp.append(nb)
+        comps.append(comp)
+    return comps
+
+
+def _triangle_info(cells: list[tuple[int, int]]) -> dict | None:
+    if len(cells) != 3:
+        return None
+    s = set(cells)
+    deg4 = {p: sum(1 for n in _neighbors4(*p) if n in s) for p in cells}
+    deg8 = {p: sum(1 for n in _neighbors8(*p) if n in s) for p in cells}
