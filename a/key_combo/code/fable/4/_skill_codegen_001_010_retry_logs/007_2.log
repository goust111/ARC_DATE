+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    h = rng.randint(MIN_SIZE, MAX_SIZE)
+    w = rng.randint(MIN_SIZE, MAX_SIZE)
+    if rng.random() < 0.4:
+        w = rng.randint(max(MIN_SIZE, h - 4), min(MAX_SIZE, h + 5))
