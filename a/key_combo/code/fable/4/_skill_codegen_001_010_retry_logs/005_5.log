+    holes = ~covered
+    if not bool(np.any(holes)):
+        return False
+    if (
+        bool(np.any(holes[0, :]))
+        or bool(np.any(holes[-1, :]))
+        or bool(np.any(holes[:, 0]))
+        or bool(np.any(holes[:, -1]))
