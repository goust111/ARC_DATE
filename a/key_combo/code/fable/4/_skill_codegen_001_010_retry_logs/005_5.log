+    top_c1 = right_start + right_ov_top
+    bottom_c0 = gap_start - left_ov_bottom
+    bottom_c1 = right_start + right_ov_bottom
+
+    windows = [
+        (0, 0, h, gap_start),
+        (0, right_start, h, w - right_start),
+        (0, top_c0, top_h, top_c1 - top_c0),
