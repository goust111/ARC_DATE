+        return False
+    if np.count_nonzero(holes) < 2 or np.count_nonzero(covered) < int(0.78 * h * w):
+        return False
+    for r, c in np.argwhere(holes):
+        if not covered[int(r), w - 1 - int(c)]:
+            return False
