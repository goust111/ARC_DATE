+    br0 = ar0 - int(dr)
+    bc0 = ac0 - int(dc)
+    br1 = br0 + (ar1 - ar0)
+    bc1 = bc0 + (ac1 - ac0)
+    return slice(ar0, ar1), slice(ac0, ac1), slice(br0, br1), slice(bc0, bc1)
