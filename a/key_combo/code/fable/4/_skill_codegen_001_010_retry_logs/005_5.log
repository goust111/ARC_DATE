+
+def _window_mask(shape: tuple[int, int], windows: list[tuple[int, int, int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c, h, w in windows:
+        mask[r : r + h, c : c + w] = True
+    return mask
+
