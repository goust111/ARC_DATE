+
+
+def _can_place(occupied: np.ndarray, r: int, c: int, h: int, w: int, padding: int = 1) -> bool:
+    gh, gw = occupied.shape
+    if r < 0 or c < 0 or r + h > gh or c + w > gw:
+        return False
+    r0 = max(0, r - padding)
+    c0 = max(0, c - padding)
+    r1 = min(gh, r + h + padding)
+    c1 = min(gw, c + w + padding)
