+    covered = _window_mask(template.shape, windows)
+    holes = ~covered
+    if not bool(np.any(holes)):
+        return False
+    if bool(np.any(holes[0, :] | holes[-1, :] | holes[:, 0] | holes[:, -1])):
+        return False
