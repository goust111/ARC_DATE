+    b_shape: tuple[int, int],
+    dr: int,
+    dc: int,
+) -> tuple[slice, slice] | None:
+    """Slices for b placed at (dr, dc) relative to a."""
+    ah, aw = map(int, a_shape)
+    bh, bw = map(int, b_shape)
+
+    ar0 = max(0, int(dr))
+    ac0 = max(0, int(dc))
+    ar1 = min(ah, int(dr) + bh)
+    ac1 = min(aw, int(dc) + bw)
+    if ar0 >= ar1 or ac0 >= ac1:
+        return None
