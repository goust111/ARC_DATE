+def _matching_shifts(a: np.ndarray, b: np.ndarray) -> list[tuple[int, int, int]]:
+    """Return (overlap_area, dr, dc) shifts where b agrees with a."""
+    ah, aw = map(int, a.shape)
+    bh, bw = map(int, b.shape)
+    matches: list[tuple[int, int, int]] = []
