) -> np.ndarray:
    grid = np.full(shape, bg, dtype=int)
    for pointer in pointers:
        tr, tc = pointer.tail
        hr, hc = pointer.head
        assert int(grid[tr, tc]) == bg and int(grid[hr, hc]) == bg
        grid[tr, tc] = GRAY
        grid[hr, hc] = pointer.color
    return grid


