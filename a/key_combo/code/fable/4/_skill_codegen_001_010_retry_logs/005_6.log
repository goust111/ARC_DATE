+    h, w = map(int, shape)
+    edges = [r == 0, r == h - 1, c == 0, c == w - 1]
+    assert sum(bool(x) for x in edges) == 1, "source must be on exactly one boundary edge"
+    if r == 0:
+        return 1, 0
+    if r == h - 1:
+        return -1, 0
+    if c == 0:
+        return 0, 1
+    return 0, -1
