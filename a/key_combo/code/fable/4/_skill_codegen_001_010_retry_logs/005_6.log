+def _ray_cells(start: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    while _in_bounds(shape, r, c):
