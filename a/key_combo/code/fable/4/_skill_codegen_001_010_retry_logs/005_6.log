+class Hit(NamedTuple):
+    cell: tuple[int, int]
+    mate: tuple[int, int]
+    incoming: tuple[int, int]
+    outgoing: tuple[int, int]
+    color: int
+
+
+class Trace(NamedTuple):
+    out: np.ndarray
+    hits: list[Hit]
+    path: list[tuple[int, int]]
+    source: tuple[int, int]
+    bg: int
+
+
+class PlanStep(NamedTuple):
+    cell: tuple[int, int]
+    mate: tuple[int, int]
+    incoming: tuple[int, int]
+    outgoing: tuple[int, int]
+
+
