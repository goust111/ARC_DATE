+    preferred = edges[_GEN_CALL_COUNT % len(edges)]
+    _GEN_CALL_COUNT += 1
+    edge_order = [preferred] + [edge for edge in edges if edge != preferred]
+
+    for edge in edge_order:
+        for _ in range(_GEN_MAX_ATTEMPTS):
+            grid = _gen_attempt(edge)
+            if grid is not None:
+                return grid
