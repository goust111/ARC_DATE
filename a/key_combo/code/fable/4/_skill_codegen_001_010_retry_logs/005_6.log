+    all_colors = set(map(int, np.unique(grid))) - {trace.bg, RED}
+    hit_colors = {hit.color for hit in trace.hits}
+    return len(all_colors - hit_colors) >= decoy_count and np.array_equal(main(grid), trace.out)
