+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    edges = ["top", "right", "bottom", "left"]
+    preferred = edges[_GEN_CALL_COUNT % len(edges)]
+    _GEN_CALL_COUNT += 1
+    edge_order = [preferred] + [edge for edge in edges if edge != preferred]
+
