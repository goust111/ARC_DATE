+    if cur_h > fh - 2 or cur_w > fw - 2:
+        return None
+    r0 = random.randint(1, fh - cur_h - 1)
+    c0 = random.randint(1, fw - cur_w - 1)
+    current = (r0, c0, r0 + cur_h - 1, c0 + cur_w - 1)
+    boxes = [current]
+    for mt, mb, ml, mr in reversed(margins):
+        pr0, pc0, pr1, pc1 = current
