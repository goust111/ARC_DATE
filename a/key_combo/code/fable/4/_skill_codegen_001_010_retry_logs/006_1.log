    out = np.full((_GEN_N, _GEN_N), _GEN_BG, dtype=int)
    patch, min_r, min_c = _gen_source_patch(offsets, _GEN_SOURCE)
    for r, c in destinations:
        _gen_paste(out, patch, r + min_r, c + min_c)
