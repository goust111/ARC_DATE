+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 1
+DIVIDER = 5
+START = 6
+PAINT_COLORS = [2, 3, 4, 7, 8, 9]
+GEN_RETRIES = 400
