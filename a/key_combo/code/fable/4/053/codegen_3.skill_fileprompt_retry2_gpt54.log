+
+    a_panel = g[a_bbox[0] : a_bbox[2] + 1, a_bbox[1] : a_bbox[3] + 1]
+    b_panel = g[b_bbox[0] : b_bbox[2] + 1, b_bbox[1] : b_bbox[3] + 1]
