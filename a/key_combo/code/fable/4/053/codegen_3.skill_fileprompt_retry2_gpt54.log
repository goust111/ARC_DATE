+def _render_grid(
+    a_panel: np.ndarray, b_panel: np.ndarray, verdict: np.ndarray, bg: int, a_color: int, b_color: int, x_color: int
+) -> np.ndarray:
+    size = a_panel.shape[0]
+    top_margin = random.randint(1, 2)
+    width_options = [
