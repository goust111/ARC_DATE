+    assert set(map(int, np.unique(b_panel))) <= allowed_visible
+    assert np.all(x_slot == BLACK), "the missing slot should be blank"
+    assert set(map(int, np.unique(verdict))) <= allowed_visible | {a_color, b_color, x_color}
