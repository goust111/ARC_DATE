+    grid[panel_top : panel_top + size, b_left : b_left + size] = b_panel
+    grid[panel_top : panel_top + size, x_left : x_left + size] = BLACK
+    grid[verdict_top : verdict_top + size, verdict_left : verdict_left + size] = verdict
