+def _make_shape_masks(cell_size):
+    base_masks = random.sample(SHAPE_LIBRARY, ORDER)
+    anchor_r = random.randint(0, cell_size - 3)
+    anchor_c = random.randint(0, cell_size - 3)
+    return [
