+    starts = [
+        (r, c)
+        for r in range(start_row_min, start_row_max + 1)
+        for c in range(start_col_min, start_col_max + 1)
+        if _forward_room(h, sep, (r, c), direction) >= 2
+    ]
+    if not starts:
+        return None
