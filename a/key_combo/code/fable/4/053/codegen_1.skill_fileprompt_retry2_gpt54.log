+                        break
+                if not keep:
+                    break
+            if keep:
+                candidates.append(pos)
+    return candidates
+
+
+def _build_input_grid(
+    h: int,
+    sep: int,
+    bg: int,
+    arrow_color: int,
+    arrow_cells: list[Coord],
+    walls: dict[Coord, int],
+) -> np.ndarray:
