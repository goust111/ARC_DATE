+    arrow_cells = _make_arrow_cells(start, direction)
+
+    n_bounces = random.choices(BOUNCE_COUNT_CHOICES, weights=BOUNCE_COUNT_WEIGHTS, k=1)[0]
+    path_cells: set[Coord] = set()
+    hidden_walls: dict[Coord, int] = {}
+    cur = start
+    ray_dir = direction
