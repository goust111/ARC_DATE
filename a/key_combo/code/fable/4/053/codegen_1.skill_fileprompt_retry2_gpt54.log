+SEP_COLOR = 5
+MAX_GENERATION_ATTEMPTS = 400
+BOUNCE_COUNT_CHOICES = [0, 1, 2, 3, 4]
+BOUNCE_COUNT_WEIGHTS = [1, 3, 3, 2, 1]
+EVENT_TYPE_WEIGHTS = {"corner": 3, "row": 2, "col": 2}
