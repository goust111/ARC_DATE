+        right = cur_c
+        while right + 1 < w and int(shelf_grid[hit_row, right + 1]) == shelf_color:
+            right += 1
+
+        dist_left = cur_c - left
+        dist_right = right - cur_c
+        assert dist_left != dist_right, "hit point must be closer to one end"
+        if dist_left < dist_right:
