+    return shelf_grid
+
+
+def _trace_particle(
+    shelf_grid: np.ndarray,
+    start_r: int,
+    start_c: int,
+    color: int,
+    *,
+    shelf_ids: np.ndarray | None = None,
+    mutate: bool,
+    record_path: bool,
+) -> dict:
+    h, w = shelf_grid.shape
+    cur_r = int(start_r)
+    cur_c = int(start_c)
+    path_cells: set[tuple[int, int]] = {(cur_r, cur_c)} if record_path else set()
+    contact_shelves: set[int] = set()
+    punch_cells: set[tuple[int, int]] = set()
+    deflections = 0
+    punches = 0
+
+    while cur_r < h - 1:
