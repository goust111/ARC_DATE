+
+def _find_monochrome_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BACKGROUND or seen[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((int(cr), int(cc)))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            components.append({"color": color, "coords": coords})
+
+    return components
+
+
+def _classify_input_objects(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    shelves: list[dict] = []
+    particles: list[dict] = []
