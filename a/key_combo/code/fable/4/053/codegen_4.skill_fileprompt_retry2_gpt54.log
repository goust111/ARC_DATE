+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BACKGROUND or seen[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((int(cr), int(cc)))
