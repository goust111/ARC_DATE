+    punch_cells: set[tuple[int, int]] = set()
+    deflections = 0
+    punches = 0
+
+    while cur_r < h - 1:
+        hit_row = None
+        for rr in range(cur_r + 1, h):
+            if int(shelf_grid[rr, cur_c]) != BACKGROUND:
+                hit_row = int(rr)
+                break
+
+        if hit_row is None:
+            if record_path:
+                for rr in range(cur_r + 1, h):
+                    path_cells.add((int(rr), cur_c))
+            cur_r = h - 1
+            break
+
+        if record_path:
