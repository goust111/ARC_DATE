+        left = cols[0]
+        right = cols[-1]
+        assert right - left + 1 == len(cols), "shelf cells must be contiguous"
+        shelves.append(
+            {
+                "row": int(next(iter(rows))),
+                "left": int(left),
+                "right": int(right),
+                "color": color,
+            }
+        )
