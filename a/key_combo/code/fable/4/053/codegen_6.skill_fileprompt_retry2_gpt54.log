+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components_from_cells(cells: set[Coord]) -> list[set[Coord]]:
+    remaining = set(cells)
+    comps: list[set[Coord]] = []
+    while remaining:
+        start = remaining.pop()
+        comp = {start}
+        stack = [start]
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in _neighbors4(r, c):
+                nxt = (int(nr), int(nc))
+                if nxt in remaining:
+                    remaining.remove(nxt)
+                    comp.add(nxt)
+                    stack.append(nxt)
+        comps.append(comp)
+    return comps
