+def _random_connected_subset(pool: list[Coord], min_size: int, max_size: int) -> set[Coord] | None:
+    if len(pool) < min_size:
+        return None
+    cells = set(pool)
+    sizes = list(range(min_size, min(max_size, len(pool)) + 1))
+    random.shuffle(sizes)
+    pool_list = list(pool)
+    for size in sizes:
+        for _ in range(80):
+            subset = set(random.sample(pool_list, size))
+            if _is_connected(subset):
+                return subset
+    candidates: list[set[Coord]] = []
+    for size in sizes:
+        if len(pool_list) > 12 and size > 3:
+            continue
+        for picked in combinations(pool_list, size):
+            subset = set(picked)
+            if _is_connected(subset):
+                candidates.append(subset)
+        if candidates:
+            break
+    if not candidates:
+        return None
+    return random.choice(candidates)
