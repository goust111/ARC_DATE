+def _components_from_cells(cells: set[Coord]) -> list[set[Coord]]:
+    remaining = set(cells)
+    comps: list[set[Coord]] = []
+    while remaining:
+        start = remaining.pop()
+        comp = {start}
+        stack = [start]
+        while stack:
