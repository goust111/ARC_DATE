+
+
+def _random_unique_fragment(
+    template_masks: list[np.ndarray],
+    template_idx: int,
+    top_left: tuple[int, int],
+    grid_shape: tuple[int, int],
+) -> set[Coord] | None:
+    template_cells = {(int(r), int(c)) for r, c in np.argwhere(template_masks[template_idx])}
