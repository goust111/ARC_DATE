+        for anchor in candidate_subsets:
+            fragment = shared | anchor
+            placements = _placements_covering_cells(
+                _placed_cells(fragment, top_left),
+                template_masks,
+                grid_shape,
+            )
+            if placements == [(int(template_idx), int(top_left[0]), int(top_left[1]))]:
