+    min_h = max(GRID_MIN, size * 2 + BOX_GAP + 1)
+    min_w = max(GRID_MIN, size * 2 + BOX_GAP + 1)
+    h = random.randint(min_h, GRID_MAX)
+    w = random.randint(min_w, GRID_MAX)
+
