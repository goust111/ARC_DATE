+    comps: list[set[Coord]] = []
+    while remaining:
+        start = remaining.pop()
+        comp = {start}
+        stack = [start]
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in _neighbors4(r, c):
+                nxt = (int(nr), int(nc))
+                if nxt in remaining:
