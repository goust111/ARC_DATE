+    r1, c1 = coords.max(axis=0)
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return {
+        "color": int(color),
+        "coords": [(int(r), int(c)) for r, c in coords],
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
