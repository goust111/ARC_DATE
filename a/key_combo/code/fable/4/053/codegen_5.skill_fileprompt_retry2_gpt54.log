+    out = []
+    len_a = len(seq_a)
+    len_b = len(seq_b)
+    for delta in range(-(len_b - 1), len_a):
+        overlaps = False
+        ok = True
+        for idx_a, color_a in enumerate(seq_a):
+            idx_b = idx_a - delta
+            if not (0 <= idx_b < len_b):
