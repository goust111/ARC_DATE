+                seen.add(j)
+                stack.append(j)
+    return len(seen) == len(intervals)
+
+
+def _sample_sequences() -> tuple[list[tuple[int | None, ...]], list[tuple[int, ...]]]:
+    for _ in range(GEN_ATTEMPTS):
