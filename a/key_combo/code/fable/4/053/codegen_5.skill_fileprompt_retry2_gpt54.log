+def _merge_known(
+    known: dict[int, int], sequence: tuple[int | None, ...], start: int
+) -> dict[int, int] | None:
+    merged = dict(known)
+    for idx, color in enumerate(sequence):
+        if color is None:
+            continue
+        pos = int(start + idx)
+        prev = merged.get(pos)
+        if prev is not None and prev != color:
+            return None
+        merged[pos] = int(color)
+    return merged
+
