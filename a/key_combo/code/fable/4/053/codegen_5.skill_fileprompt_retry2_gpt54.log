+        pos = int(start + idx)
+        prev = merged.get(pos)
+        if prev is not None and prev != color:
+            return None
+        merged[pos] = int(color)
+    return merged
+
+
+def _candidate_shift(seq_a: tuple[int | None, ...], seq_b: tuple[int | None, ...]) -> list[int]:
+    out = []
+    len_a = len(seq_a)
+    len_b = len(seq_b)
+    for delta in range(-(len_b - 1), len_a):
+        overlaps = False
+        ok = True
+        for idx_a, color_a in enumerate(seq_a):
