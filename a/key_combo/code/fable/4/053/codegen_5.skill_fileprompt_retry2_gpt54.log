+def _intervals_connected(intervals: list[tuple[int, int]]) -> bool:
+    seen = {0}
+    stack = [0]
+    while stack:
+        idx = stack.pop()
+        s0, l0 = intervals[idx]
+        e0 = s0 + l0
+        for j, (s1, l1) in enumerate(intervals):
+            if j in seen:
+                continue
+            e1 = s1 + l1
+            if max(s0, s1) < min(e0, e1):
