+                "bbox": (r0, c0, r1, c1),
+                "sequence": tuple(sequence),
+                "missing_idx": int(missing_idx),
+            }
+        )
+    assert targets
+    targets.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return targets
+
