+                merged = _merge_known(known, sequences[idx], start)
+                if merged is not None:
+                    valid.append((start, merged))
+            if valid:
+                frontier.append((len(valid), -len(sequences[idx]), idx, valid))
+
+        if not frontier:
+            return
