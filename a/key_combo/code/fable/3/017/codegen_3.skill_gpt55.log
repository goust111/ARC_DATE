+    sprites: list[dict] = []
+    marked_indices: list[int] = []
+    for idx, comp in enumerate(components):
+        crop = _component_crop(without_marker, comp, bg)
+        sprite = {
+            "bbox": tuple(map(int, comp["bbox"])),
+            "coords": comp["coords"],
