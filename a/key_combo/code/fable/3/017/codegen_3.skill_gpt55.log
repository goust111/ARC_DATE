+def _make_bad_color_decoy(
+    src: np.ndarray, transform_name: str, codomain_colors: list[int]
+) -> np.ndarray | None:
+    moved = _apply_transform(src, transform_name)
+    decoy = np.full(moved.shape, BG, dtype=int)
+    mask = moved != BG
+    for r, c in np.argwhere(mask):
