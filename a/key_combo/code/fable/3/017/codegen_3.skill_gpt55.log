+def _place_regular_sprite(
+    grid: np.ndarray, crop: np.ndarray, reserved: list[tuple[int, int, int, int]]
+) -> bool:
+    for r0, c0 in _candidate_locations(grid.shape, crop, reserved):
+        _paste_crop(grid, crop, r0, c0)
