+    if moved.shape != dst.shape:
+        return None
+
+    moved_mask = moved != int(bg)
+    dst_mask = dst != int(bg)
+    if not np.array_equal(moved_mask, dst_mask) or not bool(moved_mask.any()):
+        return None
