+
+def _apply_transform(arr: np.ndarray, name: str) -> np.ndarray:
+    if name == "hflip":
+        return np.fliplr(arr).copy()
+    if name == "vflip":
+        return np.flipud(arr).copy()
+    if name == "transpose":
+        return arr.T.copy()
+    if name == "rot180":
+        return np.rot90(arr, 2).copy()
+    raise ValueError(f"unknown transform: {name}")
