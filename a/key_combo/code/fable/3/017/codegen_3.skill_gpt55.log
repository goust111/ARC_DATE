+    if _mapping_signature(key["mapping"]) != _mapping_signature(mapping):
+        return None
+    if not np.array_equal(_expected_from_key(marked_sprite["crop"], transform_name, mapping), expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
