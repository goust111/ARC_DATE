+    H, W = shape
+    h, w = crop.shape
+    locations: list[tuple[int, int]] = []
+    for r0 in range(H - h + 1):
+        for c0 in range(W - w + 1):
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if all(_bbox_separated(box, other) for other in reserved):
+                locations.append((r0, c0))
