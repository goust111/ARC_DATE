+    comps: list[list[tuple[int, int]]] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for dr, dc in NEIGHBORS8:
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < H and 0 <= cc < W and mask[rr, cc] and not seen[rr, cc]:
