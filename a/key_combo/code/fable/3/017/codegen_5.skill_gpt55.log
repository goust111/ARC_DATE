+def _place_planned_hits(
+    grid: np.ndarray,
+    hit_count: int,
+    colors: list[int],
+    force_vertical: bool,
+) -> bool:
+    used = 0
+    vertical_done = False
+    while used < hit_count:
+        try:
+            steps, order, _sprites, _owner = _trace_current(grid)
+        except AssertionError:
+            return False
+        if len(order) != used:
+            return False
+
+        last_new = -1
+        for i, step in enumerate(steps):
+            if step["new_hit"] is not None:
+                last_new = i
+
+        can_pair = force_vertical and not vertical_done and used + 2 <= hit_count
+        if can_pair:
+            candidates = _candidate_steps(
+                steps,
+                hit_count - used - 2,
+                after_step=last_new,
+                need_alt=True,
+                width=grid.shape[1],
+            )
+            for step in candidates:
+                tr, tc = step["target"]
+                pre_c = int(step["pre"][1])
+                dc = int(step["trial_dc"])
