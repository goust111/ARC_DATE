    expected[r0 : r1 + 1, c0] = Color.BLUE
    expected[r0 : r1 + 1, c1] = Color.BLUE
    expected[rows, cols] = MARKER_COLOR

    if not np.array_equal(main(grid), expected):
        return None
    return grid


