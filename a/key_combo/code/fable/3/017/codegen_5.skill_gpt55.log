def _opposite_corner_walk_options(h: int, w: int):
    return [
        ((0, 0), (h - 1, w - 1), [(1, 0), (0, 1)]),
        ((0, w - 1), (h - 1, 0), [(1, 0), (0, -1)]),
        ((h - 1, 0), (0, w - 1), [(-1, 0), (0, 1)]),
        ((h - 1, w - 1), (0, 0), [(-1, 0), (0, -1)]),
    ]


def _gen_connected_mask(h: int, w: int, k: int) -> np.ndarray:
