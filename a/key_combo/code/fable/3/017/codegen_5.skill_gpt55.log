+
+
+# --------------- generator ---------------
+
+_GEN_CALLS = 0
+_GEN_ATTEMPTS = 500
+_GEN_H_RANGE = (17, 26)
+_GEN_W_RANGE = (7, 13)
+_GEN_HIT_RANGE = (3, 5)
+_GEN_DISTRACTOR_RANGE = (1, 3)
+
+
+def _mask_pool(required: tuple[tuple[int, int], ...], forbidden: tuple[tuple[int, int], ...] = ()) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    req = set(required)
+    ban = set(forbidden)
+    for bits in range(1, 1 << 9):
