+def _edge_col_for_direction(dc: int) -> int:
+    return 0 if int(dc) == 1 else 2
+
+
+def _can_place_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int) -> bool:
+    H, W = grid.shape
