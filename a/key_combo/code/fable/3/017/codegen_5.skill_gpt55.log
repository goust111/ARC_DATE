+
+def _connected8(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q: deque[tuple[int, int]] = deque([start])
+    H, W = mask.shape
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS8:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < H and 0 <= cc < W and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
