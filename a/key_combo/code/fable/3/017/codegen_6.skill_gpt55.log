+    locations_by_original: list[tuple[int, int] | None] = [None, None, None]
+    for original_index, table, loc in (
+        (source_order[0], top_tables[0], loc_top_0),
+        (source_order[1], top_tables[1], loc_top_1),
+        (2, target, (target_r, target_c)),
