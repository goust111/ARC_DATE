+
+def _orientations(arr: np.ndarray) -> list[tuple[str, np.ndarray]]:
+    a = np.asarray(arr, dtype=int)
+    return [
+        ("identity", a.copy()),
+        ("rot90", np.rot90(a, 1).copy()),
