+def _pairwise_distinct_oriented(sources: list[np.ndarray]) -> bool:
+    keys: set[bytes] = set()
+    for source in sources:
+        for _name, oriented in _orientations(source):
+            key = oriented.tobytes()
+            if key in keys:
+                return False
+            keys.add(key)
+    return True
