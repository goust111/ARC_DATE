def _gen_dihedral_arrays(arr: np.ndarray) -> list[np.ndarray]:
    variants = [
        arr,
        np.fliplr(arr),
        np.flipud(arr),
        np.flipud(np.fliplr(arr)),
        arr.T,
        np.fliplr(arr.T),
        np.flipud(arr.T),
        np.flipud(np.fliplr(arr.T)),
    ]
    out: list[np.ndarray] = []
    seen: set[tuple[int, ...]] = set()
    for variant in variants:
        key = tuple(map(int, variant.ravel()))
        if key not in seen:
            seen.add(key)
