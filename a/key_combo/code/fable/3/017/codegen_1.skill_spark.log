+    col = int(color)
+    grid[r0, c0 : c1 + 1] = col
+    grid[r1, c0 : c1 + 1] = col
+    grid[r0 : r1 + 1, c0] = col
+    grid[r0 : r1 + 1, c1] = col
+
+
