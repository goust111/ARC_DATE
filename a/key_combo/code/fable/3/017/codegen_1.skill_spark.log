+        failed = False
+
+        for col in map(int, selected_colors):
+            if failed:
+                break
+
+            rect_success = False
+            for _ in range(250):
+                box_h = _rand_int(2, max(2, min(10, h - 1)))
+                box_w = _rand_int(2, max(2, min(10, w - 1)))
