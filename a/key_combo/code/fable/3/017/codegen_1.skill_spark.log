+def _distances_from(starts: Iterable[tuple[int, int]], passable: np.ndarray) -> np.ndarray:
+    """BFS multi-source distances on passable cells."""
+    h, w = passable.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q: deque[tuple[int, int]] = deque()
