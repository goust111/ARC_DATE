+    for r, c in starts:
+        if 0 <= r < h and 0 <= c < w and passable[r, c]:
+            dist[r, c] = 0
+            q.append((int(r), int(c)))
+
+    while q:
+        r, c = q.popleft()
+        nd = int(dist[r, c]) + 1
+        for nr, nc in neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:
+                dist[nr, nc] = nd
+                q.append((nr, nc))
+    return dist
+
+
