+    masks: list[np.ndarray] = []
+    for bits in range(1, 1 << (SPRITE_SIZE * SPRITE_SIZE)):
+        mask = np.array(
+            [(bits >> i) & 1 for i in range(SPRITE_SIZE * SPRITE_SIZE)],
+            dtype=bool,
+        ).reshape((SPRITE_SIZE, SPRITE_SIZE))
+        area = int(mask.sum())
+        if area < 4 or area > 8:
+            continue
