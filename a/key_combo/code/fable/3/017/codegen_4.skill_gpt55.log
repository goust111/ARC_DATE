+    min_side = max(17, table_side + 8)
+    h = _rand_int(min_side, 30)
+    w = _rand_int(min_side, 30)
+    tr = _rand_int(1, h - table_side - 1)
+    tc = _rand_int(1, w - table_side - 1)
