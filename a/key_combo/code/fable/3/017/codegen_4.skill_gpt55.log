+                puzzle[r, c] = color
+                visible_counts[color] += 1
+
+        if _blank_pattern_ok(puzzle, full):
+            return puzzle
+    return None
+
+
+def _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = map(int, a)
+    br0, bc0, br1, bc1 = map(int, b)
