+    h, w = map(int, shape)
+    candidates = [(r, c) for r in range(1, h - SPRITE_SIZE) for c in range(1, w - SPRITE_SIZE)]
+    for _ in range(80):
+        random.shuffle(candidates)
+        rects = list(occupied)
+        chosen: list[tuple[int, int]] = []
+        for r, c in candidates:
