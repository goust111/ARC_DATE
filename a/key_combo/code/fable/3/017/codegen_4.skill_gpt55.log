+    grid[tr : tr + table_side, tc] = GREY
+    grid[tr : tr + table_side, tc + table_side - 1] = GREY
+    grid[tr, tc : tc + table_side] = GREY
+    grid[tr + table_side - 1, tc : tc + table_side] = GREY
