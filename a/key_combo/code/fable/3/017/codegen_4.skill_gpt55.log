+    n = int(full.shape[0])
+    out = np.full((SPRITE_SIZE * n, SPRITE_SIZE * n), BLACK, dtype=int)
+    for r, c in np.argwhere(puzzle == BLACK):
+        rr, cc = int(r), int(c)
+        color = int(full[rr, cc])
+        out[SPRITE_SIZE * rr : SPRITE_SIZE * (rr + 1), SPRITE_SIZE * cc : SPRITE_SIZE * (cc + 1)] = sprites[color]
+    return out
+
