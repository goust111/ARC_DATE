+        chosen: list[tuple[int, int]] = []
+        for r, c in candidates:
+            box = (int(r), int(c), int(r) + SPRITE_SIZE - 1, int(c) + SPRITE_SIZE - 1)
+            if all(_separated(box, prev, gap=1) for prev in rects):
