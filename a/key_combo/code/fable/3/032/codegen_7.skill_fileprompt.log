+        elif dirs == {"L", "D"}:
+            tr.add((int(r), int(c)))
+        elif dirs == {"R", "U"}:
+            bl.add((int(r), int(c)))
+        elif dirs == {"L", "U"}:
+            br.add((int(r), int(c)))
