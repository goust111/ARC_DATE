+
+def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return 0
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
+
+
+def _interior_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    r0 = max(a[0] + 1, b[0] + 1)
+    c0 = max(a[1] + 1, b[1] + 1)
+    r1 = min(a[2] - 1, b[2] - 1)
+    c1 = min(a[3] - 1, b[3] - 1)
+    if r0 > r1 or c0 > c1:
+        return 0
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
