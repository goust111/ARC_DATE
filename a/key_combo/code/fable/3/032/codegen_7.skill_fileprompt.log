+def _sample_overlap_pair(shape: tuple[int, int]) -> list[tuple[int, int, int, int]] | None:
+    h, w = shape
+    for _ in range(RECT_RETRIES):
+        a = _sample_rect(shape)
+        ah = a[2] - a[0] + 1
