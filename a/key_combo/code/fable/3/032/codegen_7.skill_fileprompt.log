+    rects = set()
+    for r0, c0 in tl:
+        for r1, c1 in br:
+            if r1 <= r0 + 1 or c1 <= c0 + 1:
+                continue
+            if (r0, c1) not in tr or (r1, c0) not in bl:
+                continue
