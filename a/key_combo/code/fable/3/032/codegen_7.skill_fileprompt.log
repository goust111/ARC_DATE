+    h, w = grid.shape
+    cells = []
+    for dr, dc in shape:
+        r = top + dr
+        c = left + dc
+        grid[r, c] = color
+        cells.append((r, c))
+    for r, c in cells:
+        for dr, dc in DIRS8 + [(0, 0)]:
