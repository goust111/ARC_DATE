+        max_dr = max(2, min(ah - 3, 4))
+        max_dc = max(2, min(aw - 3, 4))
+        dr = random.randint(2, max_dr)
+        dc = random.randint(2, max_dc)
+        b = (a[0] + dr, a[1] + dc, a[0] + dr + outer_h2 - 1, a[1] + dc + outer_w2 - 1)
