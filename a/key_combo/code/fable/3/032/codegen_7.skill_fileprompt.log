+    mask = np.zeros((h, w), dtype=bool)
+    for r0, c0, r1, c1 in rects:
+        rr0 = max(0, r0 - pad)
+        cc0 = max(0, c0 - pad)
+        rr1 = min(h - 1, r1 + pad)
+        cc1 = min(w - 1, c1 + pad)
