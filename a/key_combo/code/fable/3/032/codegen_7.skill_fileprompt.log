+def _partition_count(total: int) -> list[int]:
+    min_parts = max(2, (total + 2) // 3)
+    max_parts = min(4, total)
+    n_parts = random.randint(min_parts, max_parts)
+    parts = [1] * n_parts
+    remaining = total - n_parts
+    while remaining > 0:
+        idx = random.randrange(n_parts)
+        if parts[idx] < 3:
+            parts[idx] += 1
+            remaining -= 1
