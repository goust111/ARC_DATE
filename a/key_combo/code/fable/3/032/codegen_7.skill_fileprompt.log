+
+
+def _place_shape(grid: np.ndarray, color: int, shape: tuple[tuple[int, int], ...], top: int, left: int, blocked: np.ndarray) -> None:
+    h, w = grid.shape
+    cells = []
+    for dr, dc in shape:
+        r = top + dr
+        c = left + dc
+        grid[r, c] = color
+        cells.append((r, c))
+    for r, c in cells:
+        for dr, dc in DIRS8 + [(0, 0)]:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w:
