+def _normalize_shape(shape: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = list(shape)
+    r0 = min(r for r, _ in pts)
+    c0 = min(c for _, c in pts)
+    norm = sorted((r - r0, c - c0) for r, c in pts)
