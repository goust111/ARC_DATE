+    for r, c in cells:
+        for dr, dc in DIRS8:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) != BLACK and (rr, cc) not in cells:
+                return False
