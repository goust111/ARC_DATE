+    inner_w = random.randint(3, 6)
+    return inner_h, inner_w
+
+
+def _sample_rect(shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    inner_h, inner_w = _sample_rect_dims()
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
