+    present_colors = [int(c) for c in np.unique(grid) if int(c) not in (BLACK, GREY)]
+    if sorted(present_colors) != sorted(colors):
+        return None
+    if len({int(np.count_nonzero(grid == color)) for color in present_colors}) != n_rects:
