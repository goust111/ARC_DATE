        nonlocal best, tries
        if best is not None or tries > 2000:
            return
        if i == len(cand_lists):
            tries += 1
            H2,W2=H,W
            arrow_all=set()
            bbs=[]
            starts=[]
            sdirs=[]
            paths=[]
            for start,sd,bb,_ in chosen:
                bbs.append(bb)
                starts.append(start)
