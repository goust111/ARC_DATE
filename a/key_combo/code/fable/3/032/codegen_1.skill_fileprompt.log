def arrow_cells(bb, start_dir, scale):
    r0,c0,r1,c1=bb
    miss_r = 0 if start_dir[0] < 0 else 1
    miss_c = 0 if start_dir[1] < 0 else 1
    out=set()
    for r in range(r0,r1+1):
        for c in range(c0,c1+1):
            if (r-r0)//scale == miss_r and (c-c0)//scale == miss_c:
                continue
            out.add((r,c))
    return out


def attempt():
    H = random.randint(12,26)
    W = random.randint(12,26)
    scale = random.choice([1,2])
    size = 2*scale
    n = random.choice([2,3])
    # choose interior intersection point
    I = (random.randint(2,H-3), random.randint(2,W-3))
    dirs=[]
    dirs.append(random.choice(SLOPE_FAMILIES[1]))
    dirs.append(random.choice(SLOPE_FAMILIES[-1]))
