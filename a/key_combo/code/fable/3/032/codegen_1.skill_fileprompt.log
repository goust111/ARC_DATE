                p={(r,c) for r,c,_dr,_dc in states}
                if I not in p:
                    return
                paths.append(p)
            if any(p & arrow_all for p in paths):
                return
            count=Counter()
            for p in paths:
                for cell in p:
                    if cell not in arrow_all:
                        count[cell]+=1
            cross={cell for cell,v in count.items() if v>=2}
            interior={cell for cell in cross if cell not in {(0,0),(0,W2-1),(H2-1,0),(H2-1,W2-1)}}
            if I not in interior:
                return
            if not (1 <= len(cross) <= 8):
                return
            if len(interior) > 6:
                return
            best=(H,W,scale,I,chosen,cross)
            return
        for cand in cand_lists[i]:
            bb = cand[2]
            ok=True
            for prev in chosen:
                if overlap(expand(bb,1), expand(prev[2],1)):
                    ok=False
                    break
            if not ok:
                continue
            rec(i+1, chosen+[cand])
            if best is not None:
                return
    rec(0,[])
    return best is not None

