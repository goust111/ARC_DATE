+    coord_to_idx: dict[tuple[int, int], int] = {}
+    for idx, (r, c) in enumerate(coords):
+        row_cols[r].append(c)
+        col_rows[c].append(r)
+        coord_to_idx[(r, c)] = idx
+    for cols in row_cols.values():
+        cols.sort()
+    for rows in col_rows.values():
+        rows.sort()
+    return row_cols, col_rows, coord_to_idx
