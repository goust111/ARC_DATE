+    idx: int,
+    direction: int,
+) -> int | None:
+    r, c = coords[idx]
+    if direction == RIGHT:
+        cols = row_cols[r]
+        pos = bisect.bisect_right(cols, c)
+        if pos >= len(cols):
+            return None
+        return coord_to_idx[(r, cols[pos])]
+    if direction == LEFT:
+        cols = row_cols[r]
+        pos = bisect.bisect_left(cols, c) - 1
+        if pos < 0:
+            return None
+        return coord_to_idx[(r, cols[pos])]
+    if direction == DOWN:
+        rows = col_rows[c]
+        pos = bisect.bisect_right(rows, r)
+        if pos >= len(rows):
+            return None
+        return coord_to_idx[(rows[pos], c)]
+    rows = col_rows[c]
+    pos = bisect.bisect_left(rows, r) - 1
+    if pos < 0:
+        return None
+    return coord_to_idx[(rows[pos], c)]
