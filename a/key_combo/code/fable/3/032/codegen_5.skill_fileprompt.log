+    colors: dict[tuple[int, int], int],
+) -> bool:
+    mask = out != BLACK
+    occupied = np.argwhere(mask)
+    if occupied.size == 0:
+        return False
+
+    start = tuple(map(int, occupied[0]))
+    q: deque[tuple[int, int]] = deque([start])
