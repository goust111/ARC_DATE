+    n = len(corners)
+    for idx in range(n):
+        ar, ac = corners[idx]
+        br, bc = corners[(idx + 1) % n]
+        if ar == br:
+            c0, c1 = sorted((ac, bc))
+            out[ar, c0 : c1 + 1] = GREY
+        else:
+            r0, r1 = sorted((ar, br))
+            out[r0 : r1 + 1, ac] = GREY
