+    for r, c in np.argwhere(g != BLACK):
+        color = int(g[r, c])
+        assert color in (YELLOW, RED), "input must contain only yellow/red corner pixels"
+        coord = (int(r), int(c))
+        coords.append(coord)
+        colors[coord] = color
+
