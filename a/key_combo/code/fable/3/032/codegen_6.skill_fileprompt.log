+    blocked_idx2 = _find_block_index(blocks2, blocked_coords)
+    if blocked_idx2 is None or blocked_idx2 not in burned2:
+        return None
+
+    survivors = total_blocks - len(burned)
+    if survivors < 2:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
