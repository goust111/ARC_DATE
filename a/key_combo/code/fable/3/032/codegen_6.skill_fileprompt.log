+        if not _try_add_burnable_block(grid, lit):
+            return None
+
+    blocked = _try_add_blocked_candidate(grid)
+    if blocked is None:
+        return None
+    blocked_coords, wall_cells = blocked
+
+    safe_target = random.randint(1, 3)
+    safe_added = _try_add_safe_blocks(grid, safe_target)
+    if safe_added == 0:
+        return None
+
