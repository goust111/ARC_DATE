+    min_c = min(c for _, c in coords)
+    shifted = sorted((r - min_r, c - min_c) for r, c in coords)
+    arr = np.array(shifted, dtype=int)
+    r1, c1 = arr.max(axis=0)
+    mask = np.zeros((int(r1) + 1, int(c1) + 1), dtype=bool)
+    mask[arr[:, 0], arr[:, 1]] = True
+    return mask
