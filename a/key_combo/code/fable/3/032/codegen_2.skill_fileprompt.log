+    if h + 2 * border > H or w + 2 * border > W:
+        return []
+    out = []
+    for r0 in range(border, H - border - h + 1):
+        for c0 in range(border, W - border - w + 1):
+            rr0 = max(0, r0 - padding)
+            cc0 = max(0, c0 - padding)
