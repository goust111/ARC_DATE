    10	# In the input, you will see a black grid with a red line that starts in the top left corner and bounces off the borders of the grid until it reaches the right side of the grid.
    11	# To make the output, find the black regions separated by the red lines, then, starting with the first region from the left, color every third region yellow.
    12	
    13	def main(input_grid):
    14	    """
    15	    Color every third black region between a red bouncing divider line yellow.
    16	
    17	    Input structure:
    18	    - The input is a black grid split by a red line.
    19	    - The red line acts as a boundary between connected black regions.
    20	    - Regions are ordered from left to right by their bounding boxes.
    21	
    22	    Rule:
    23	    - Find connected regions using red as the separating background.
    24	    - Sort the regions from left to right.
    25	    - Flood-fill regions with indices 0, 3, 6, and so on with yellow.
    26	
    27	    Key insight:
    28	    - The red path partitions the grid; the fill pattern is determined by region order.
    29	    """
    30	    # copy the input grid to the output grid
    31	    output_grid = np.copy(input_grid)
    32	
    33	    # find the black regions in the input grid
    34	    bg = Color.RED
    35	    black_regions = find_components(
    36	        input_grid,
    37	        bg=bg,
    38	        connectivity=4,
    39	        monochromatic=True,
    40	        return_format="objects",
    41	    )
    42	
    43	    # sort the regions from left to right using the coordinates of their bounding boxes
    44	    black_regions = sorted(black_regions, key=lambda region: bbox(region != bg)[1])
    45	
    46	    # color every third black region yellow using flood fill
    47	    for i, region in enumerate(black_regions):
    48	        if i % 3 == 0:
    49	            rr, cc = np.argwhere(region != bg)[0]
    50	            flood_fill(output_grid, int(rr), int(cc), Color.YELLOW, connectivity=4)
    51	
    52	    return output_grid
    53	
    54	
