+        return False
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    pts = {tuple(map(int, p)) for p in coords}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in pts and nxt not in seen:
