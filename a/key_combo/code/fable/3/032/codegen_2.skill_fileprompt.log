    95	    h = max(r for r, _ in coords) - min_r + 1
    96	    w = max(c for _, c in coords) - min_c + 1
    97	    patch = np.zeros((h, w), dtype=int)
    98	    for r, c in coords:
    99	        patch[r - min_r, c - min_c] = Color.RED
