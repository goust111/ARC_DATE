+    out = g.copy()
+    occupied = np.zeros((h, w), dtype=bool)
+    start_mask = np.zeros((h, w), dtype=bool)
+    for c, _color in starts:
+        start_mask[h - 1, c] = True
+
+    stats: dict[str, object] = {
+        "reached_all_top": True,
+        "detours": 0,
+        "tie_count": 0,
+        "directions": set(),
+        "blocking_shift_count": 0,
+    }
