+    dist = 0
+    while True:
+        cc += int(dc)
+        dist += 1
+        if not (0 <= cc < w):
+            return None
+        if int(grid[r, cc]) == PLATFORM:
+            return None
+        if dynamic and bool(occupied[r, cc]):
+            return None
+        if bool(start_mask[r, cc]) and cc != int(start_col):
+            return None
+
+        blocked_above = int(grid[r - 1, cc]) == PLATFORM
+        if dynamic and bool(occupied[r - 1, cc]):
+            blocked_above = True
+        if not blocked_above:
+            return int(dist)
+
