/bin/bash -lc "python - <<'PY'
import random, numpy as np
BG=0; PL=5; COLORS=[1,2,3,4,6,7,8,9]


def spaced_positions(lo, hi, n, min_gap):
    vals=list(range(lo,hi+1))
    for _ in range(500):
        picks=sorted(random.sample(vals,n))
        if all(b-a>=min_gap for a,b in zip(picks,picks[1:])):
            return picks
    return None


def apply_bar(grid,r,left,right,gaps):
    for c in range(left,right+1):
        if any(g0<=c<=g1 for g0,g1 in gaps):
            continue
        grid[r,c]=PL


def make_random_bar(W):
    left=random.randint(0,max(0,W//6))
    right=random.randint(max(left+6,W*3//5), W-1)
    inner=list(range(left+1,right))
    if not inner:
        return left,right,[(left,left)]
    random.shuffle(inner)
    gap_count=random.choice([1,2,2,3])
    centers=[]
    for x in inner:
        if all(abs(x-y)>=3 for y in centers):
            centers.append(x)
            if len(centers)>=gap_count:
                break
    centers.sort()
    gaps=[]
    for gc in centers:
        gw=random.choice([1,1,2])
        g0=max(left+1, gc-gw//2)
        g1=min(right-1, g0+gw-1)
        gaps.append((g0,g1))
    return left,right,gaps or [((left+right)//2, (left+right)//2)]


def search_side(grid, occupied, start_mask, r,c,dc,start_col,dynamic):
    H,W=grid.shape
    cc=c
    dist=0
    while True:
        cc += dc
        dist += 1
        if not (0<=cc<W):
            return None
        if grid[r,cc] == PL or (dynamic and occupied[r,cc]) or (start_mask[r,cc] and cc "'!= start_col):
            return None
        blocked_above = grid[r-1,cc] == PL or (dynamic and occupied[r-1,cc])
        if not blocked_above:
            return dist


def trace(grid):
    H,W=grid.shape
    start_mask=np.zeros_like(grid,dtype=bool)
    starts=[]
    for c,v in enumerate(grid[-1]):
        if v not in (BG,PL):
            start_mask[H-1,c]=True
            starts.append((c,int(v)))
    occupied=np.zeros_like(grid,dtype=bool)
    events=[]
    choices=[]
    reached=[]
    for start_col,color in starts:
        r=H-1;c=start_col
        path={(r,c)}
        while r>0:
            if grid[r-1,c] != PL and not occupied[r-1,c]:
                r -= 1
                path.add((r,c))
                continue
            ld=search_side(grid,occupied,start_mask,r,c,-1,start_col,True)
            rd=search_side(grid,occupied,start_mask,r,c,1,start_col,True)
            lds=search_side(grid,occupied,start_mask,r,c,-1,start_col,False)
            rds=search_side(grid,occupied,start_mask,r,c,1,start_col,False)
            if ld is None and rd is None:
                break
            if rd is None or (ld is not None and ld <= rd):
                dc=-1; dist=ld; choice='"'L'
            else:
                dc=1; dist=rd; choice='R'
            if rds is None or (lds is not None and lds <= rds):
                static_choice='L' if lds is not None else None
            else:
                static_choice='R'
            events.append((r,start_col,choice,ld,rd,lds,rds,static_choice))
            choices.append(choice)
            for _ in range(dist):
                c += dc
                path.add((r,c))
        reached.append(r==0)
        for rr,cc in path:
            occupied[rr,cc]=True
    seq=any((e[3],e[4]) "'!= (e[5],e[6]) for e in events)
    tie=any(e[3] is not None and e[4] is not None and e[3]==e[4] for e in events)
    both=('"'L' in choices and 'R' in choices)
    return {'reached':all(reached),'events':events,'seq':seq,'tie':tie,'both':both,'n_events':len(events)}


def gen(mode):
    H=random.randint(14,22)
    W=random.randint(14,24)
    n=random.randint(2,min(5,len(COLORS),(W-4)//3))
    starts=spaced_positions(1,W-2,n,3)
    if not starts:
        return None
    grid=np.zeros((H,W),dtype=int)
    for c,color in zip(starts, random.sample(COLORS,n)):
        grid[H-1,c]=color
    special_row=random.randint(H-6,H-4)
    if mode=='sequential':
        pairs=[(a,b) for a,b in zip(starts,starts[1:]) if 2 <= b-a <= 3 and b+3 < W]
        if not pairs:
            return None
        a,b=random.choice(pairs)
        shared=a+1
        alt=b+2 if b+2 < W-1 else b+1
        left=max(0,a-3)
        right=min(W-1,alt+2)
        apply_bar(grid,special_row,left,right,[(shared,shared),(alt,alt)])
    elif mode=='tie':
        candidates=[s for s in starts if s-2 >= 1 and s+2 <= W-2]
        if not candidates:
            return None
        s=random.choice(candidates)
        d=random.choice([1,2])
        if not (1 <= s-d and s+d <= W-2):
            return None
        left=max(0,s-d-2)
        right=min(W-1,s+d+2)
        apply_bar(grid,special_row,left,right,[(s-d,s-d),(s+d,s+d)])
    else:
        left,right,gaps=make_random_bar(W)
        apply_bar(grid,special_row,left,right,gaps)
    available=[r for r in range(2,special_row-1) if all(abs(r-r2)>=2 for r2 in [special_row])]
    random.shuffle(available)
    extra=random.randint(1,min(4,len(available))) if available else 0
    rows=[]
    for r in available:
        if all(abs(r-r0)>=2 for r0 in rows):
            rows.append(r)
            if len(rows)>=extra:
                break
    for r in rows:
        left,right,gaps=make_random_bar(W)
        apply_bar(grid,r,left,right,gaps)
    return grid

for mode in ['sequential','tie','mixed']:
    good=0; total=0
    for i in range(1000):
        g=gen(mode)
        if g is None:
            continue
        total += 1
        t=trace(g)
        ok=t['reached'] and t['n_events']>=1
        if mode=='sequential': ok = ok and t['seq']
        if mode=='tie': ok = ok and t['tie']
        if mode=='mixed': ok = ok and t['both']
        if ok: good += 1
    print(mode, good, total, good/max(total,1))
