+    starts: list[tuple[int, int]] = []
+    for c, value in enumerate(grid[-1]):
+        color = int(value)
+        if color not in (BACKGROUND, PLATFORM):
+            starts.append((int(c), color))
+    return starts
+
+
+def _search_gap(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    start_mask: np.ndarray,
