+    available = [col for col in range(1, width - 1) if col not in protected]
+    max_gaps = max(3, min(6, width // 3))
+    for gaps in gap_sets:
+        target = random.randint(2, max_gaps)
+        choices = available.copy()
+        random.shuffle(choices)
