    frame_coords = coords[on_frame]
    noise_coords = coords[~on_frame]
    frame_restore[frame_coords[:, 0], frame_coords[:, 1]] = values[on_frame]
    out[noise_coords[:, 0], noise_coords[:, 1]] = values[~on_frame]

