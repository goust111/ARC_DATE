+            land_row = support_row - 1
+            assert 0 <= land_row < height, "source has no room to settle above its support"
+            assert int(out[land_row, c_raw]) == bg, "landing cell must be empty"
+            out[land_row, c_raw] = int(out[support_row, c_raw])
