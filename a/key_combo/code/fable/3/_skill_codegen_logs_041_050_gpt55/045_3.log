def _gen_build_candidate_input(
    rng: np.random.Generator,
    sample: np.ndarray,
    tr: int,
    tc: int,
) -> tuple[np.ndarray, np.ndarray]:
    frame = _gen_frame_mask(tr, tc)
    out = np.zeros(_GEN_GRID_SHAPE, dtype=int)
    sr, sc = _GEN_SOURCE_POS
