    """Place a patch under bbox-gap constraints, paste it, and record its bbox."""
    loc = _gen_place_patch(canvas, patch, placed_bboxes)
    if loc is None:
        return None
    r, c, bb = loc
    paste(canvas, patch, r, c, transparent=0)
    placed_bboxes.append(bb)
    return r, c, bb


