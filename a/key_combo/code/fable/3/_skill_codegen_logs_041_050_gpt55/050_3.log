        wall = np.zeros((h, w), dtype=bool)
        for r, c in cells:
            wall[r, c] = True
        coords = np.argwhere(wall)
        if not (CLOSED_AREA[0] <= len(coords) <= CLOSED_AREA[1]):
            continue
