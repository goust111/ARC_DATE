+    else:
+        bg_non_corners = [(r, c) for r in range(3) for c in range(3) if not mask[r, c]]
+        new_lr, new_lc = random.choice(bg_non_corners)
+    changed_mask_grid[r0 + new_lr, c0 + new_lc] = int(mask_color)
