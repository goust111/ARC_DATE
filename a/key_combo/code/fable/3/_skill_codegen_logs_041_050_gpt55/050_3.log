def _gen_no_same_color_touch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, color: int) -> bool:
    h, w = patch.shape
    mask = patch != 0
    for pr, pc in np.argwhere(mask):
        ar, ac = int(r0 + pr), int(c0 + pc)
        for dr in (-1, 0, 1):
