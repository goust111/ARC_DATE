CLOSED_NOTCH_COUNT, NOTCH_SPAN = (1, 2), (2, 4)
NOTCH_SIDES = ["top", "bottom", "left", "right"]
OPEN_SIZE, OPEN_AREA = ((5, 9), (7, 11)), (10, 46)
OPEN_JOG_CHOICES = [1, 2]
OPEN_BBOX_ROWS, OPEN_BBOX_COLS = (4, 13), (5, 11)

