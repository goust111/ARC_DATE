+    return out
+
+
+# --------------- generator ---------------
+
+GEN_H_RANGE = (10, 19)
+GEN_W_RANGE = (10, 19)
+GEN_TURNS_RANGE = (4, 8)
+GEN_SEGMENT_MAX = 7
+GEN_FINAL_MIN = 2
+GEN_UNIQUE_PATH_MIN = 11
+GEN_UNIQUE_PATH_MAX = 70
+GEN_EXTRA_DEFLECTORS_RANGE = (1, 5)
+GEN_RETRIES = 700
