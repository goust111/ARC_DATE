+def _path_color_counts(inp: np.ndarray, out: np.ndarray) -> dict[int, int]:
+    counts = {GREEN: 0, RED: 0, BLUE: 0}
+    deflectors = (inp == RED) | (inp == BLUE)
+    changed_or_path = (out != BLACK) & ~deflectors
+    for color in counts:
