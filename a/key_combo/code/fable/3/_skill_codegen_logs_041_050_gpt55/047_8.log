+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _right(dr: int, dc: int) -> tuple[int, int]:
+    return dc, -dr
+
+
+def _left(dr: int, dc: int) -> tuple[int, int]:
+    return -dc, dr
+
