    existing = _rect_coords(range(h), range(s + 1, s + 1 + t))
    _gen_damage(inp, out, full, existing, fg)
    inp[ctrl_r, s + 1 : s + 1 + t] = fg

    if random.choice(BINARY_CHOICES):
        inp = np.fliplr(inp).copy()
        out = np.fliplr(out).copy()
    return inp, out

