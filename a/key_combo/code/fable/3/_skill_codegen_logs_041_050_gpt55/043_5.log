+    anchor_arr = np.asarray(anchors, dtype=int)
+    for idx, ((ar, ac), cur) in enumerate(zip(anchors, visible)):
+        for dr, dc in cur:
+            p = np.array([ar + dr, ac + dc], dtype=int)
+            distances = np.abs(anchor_arr - p).sum(axis=1)
