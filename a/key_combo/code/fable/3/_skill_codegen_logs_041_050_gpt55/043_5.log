+def _frontier(cells: set[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                out.add((nr, nc))
+    return list(out)
