+def _add_path(cells: set[tuple[int, int]], start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = start
+    er, ec = end
+    cells.add((r, c))
+    while (r, c) != (er, ec):
+        steps: list[tuple[int, int]] = []
+        if r < er:
+            steps.append((r + 1, c))
+        elif r > er:
+            steps.append((r - 1, c))
+        if c < ec:
+            steps.append((r, c + 1))
+        elif c > ec:
+            steps.append((r, c - 1))
+        r, c = random.choice(steps)
+        cells.add((r, c))
