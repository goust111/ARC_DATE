+def _copy_bbox(anchor: tuple[int, int], rel_bbox: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    ar, ac = anchor
+    r0, c0, r1, c1 = rel_bbox
+    return ar + r0, ac + c0, ar + r1, ac + c1
