+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+WHITE = 10
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 1200
+
+
+def _bbox(points: set[tuple[int, int]]) -> tuple[int, int, int, int]:
