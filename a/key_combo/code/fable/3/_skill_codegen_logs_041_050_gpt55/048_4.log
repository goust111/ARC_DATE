    values = list(lows)
    remaining = int(total) - sum(values)
    caps = [hi - lo for lo, hi in zip(lows, highs)]
    while remaining > 0:
        choices = [i for i, cap in enumerate(caps) if cap > 0]
        if not choices:
            return None
        i = random.choice(choices)
        values[i] += 1
        caps[i] -= 1
        remaining -= 1
    return values


