+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+RED = 2
+INPUT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GENERATION_ATTEMPTS = 500
