            rr, cc = r + dr, c + dc
            if not (0 <= rr < h and 0 <= cc < w):
                continue
            assert painted[rr, cc] in (bg, color), "template stamps must not conflict"
            painted[rr, cc] = color

    out = g.copy()
    for r, (r0, r1) in enumerate(row_spans):
        for c, (c0, c1) in enumerate(col_spans):
            out[r0 : r1 + 1, c0 : c1 + 1] = painted[r, c]
    return out

