+BLACK = 0
+PALETTE = tuple(range(1, 10))
+MAX_ARM = 8
+GEN_RETRIES = 500
+
+
+@dataclass(frozen=True)
+class _Cross:
+    color: int
+    cr: int
+    cc: int
+    up: int
+    down: int
+    left: int
+    right: int
