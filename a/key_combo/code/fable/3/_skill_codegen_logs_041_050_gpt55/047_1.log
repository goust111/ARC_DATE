+def _endpoints(cross: _Cross) -> tuple[tuple[int, int], ...]:
+    return (
+        (cross.cr - cross.up, cross.cc),
+        (cross.cr + cross.down, cross.cc),
+        (cross.cr, cross.cc - cross.left),
+        (cross.cr, cross.cc + cross.right),
+    )
+
