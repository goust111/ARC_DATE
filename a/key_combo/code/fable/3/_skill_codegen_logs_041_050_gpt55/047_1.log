+        down = _random_arm(H - 1 - r)
+        if c < cc:
+            min_left = cc - c + 1
+            if min_left > min(MAX_ARM, cc):
+                continue
+            left = random.randint(min_left, min(MAX_ARM, cc))
+            right = _random_arm(W - 1 - cc)
+        else:
+            min_right = c - cc + 1
+            if min_right > min(MAX_ARM, W - 1 - cc):
