+    cc = random.randint(1, W - 2)
+    return _Cross(
+        color=int(color),
+        cr=cr,
+        cc=cc,
+        up=_random_arm(cr),
+        down=_random_arm(H - 1 - cr),
+        left=_random_arm(cc),
+        right=_random_arm(W - 1 - cc),
