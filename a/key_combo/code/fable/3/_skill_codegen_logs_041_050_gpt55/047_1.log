+def _cells(cross: _Cross) -> set[tuple[int, int]]:
+    pts = {(r, cross.cc) for r in range(cross.top, cross.bottom + 1)}
+    pts.update((cross.cr, c) for c in range(cross.left_col, cross.right_col + 1))
+    return pts
