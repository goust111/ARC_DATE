        marker = _gen_marker(colors_by_corner[corner], bg, corner)
        locs = _gen_valid_locations(inp, marker, bg)
        if not locs:
            return False
        r0, c0 = random.choice(locs)
        paste(inp, marker, r0, c0, transparent=bg)
    return True


