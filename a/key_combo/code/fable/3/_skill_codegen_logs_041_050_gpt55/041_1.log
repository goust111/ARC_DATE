+def _components(mask: np.ndarray, *, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    dirs = NEIGHBORS4 if int(connectivity) == 4 else NEIGHBORS8
+    out: list[np.ndarray] = []
