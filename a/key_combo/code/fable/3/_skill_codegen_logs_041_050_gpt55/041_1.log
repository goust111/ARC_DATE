+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        cells: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for dr, dc in dirs:
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
