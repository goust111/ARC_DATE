# Fixed task palette.
_GEN_BG = 7
_GEN_SEP = 9
_GEN_TOP = 5
_GEN_SOURCE = 2
_GEN_TRAIL = 6

# Canvas and object-count bounds.
_GEN_GRID_SIZES = (7, 9, 11)
