    height, width = out.shape
    total = height * width
    low = (
        _GEN_CORRUPT_MIN_PERCENT * total + _GEN_PERCENT_DENOMINATOR - 1
    ) // _GEN_PERCENT_DENOMINATOR
    high = _GEN_CORRUPT_MAX_PERCENT * total // _GEN_PERCENT_DENOMINATOR
    if low > high:
