    n: int,
    sep: int,
    sources: set[tuple[int, int]],
    trails: set[tuple[int, int]],
    max_len: int,
) -> tuple[tuple[int, int], tuple[tuple[int, int], ...], int] | None:
    opts = _gen_segment_options(n, sep, sources, trails, max_len)
