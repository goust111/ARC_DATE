+    assert (len(row_candidates) == 1) ^ (len(col_candidates) == 1), "expected one full-span wall"
+    if row_candidates:
+        orientation = "horizontal"
+        wall_index = int(row_candidates[0])
+        line = grid[wall_index, :]
+    else:
