+    wall_color, wall_count = counts.most_common(1)[0]
+    assert wall_color != bg and wall_count > 3, "expected a dominant wall color"
+
+    centers: dict[int, Coord] = {}
+    i = 0
+    n = len(line)
+    while i < n:
+        color = int(line[i])
+        if color == wall_color:
+            i += 1
