+def _find_wall_and_doors(grid: np.ndarray, bg: int) -> tuple[str, int, int, dict[int, Coord]]:
+    h, w = grid.shape
+    row_candidates = [r for r in range(h) if np.all(grid[r, :] != bg)]
+    col_candidates = [c for c in range(w) if np.all(grid[:, c] != bg)]
