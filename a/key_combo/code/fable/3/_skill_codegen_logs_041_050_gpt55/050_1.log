+# ---------------- generator ----------------
+
+COLORS = tuple(range(10))
+GRID_H_RANGE = (15, 30)
+GRID_W_RANGE = (15, 30)
+DOOR_COUNT_RANGE = (2, 4)
+EXTRA_SPRITE_RANGE = (0, 2)
+GENERATION_RETRIES = 500
