+        key_locs = [tuple(map(int, rc)) for rc, val in zip(coords, values) if int(val) in key_colors]
+        assert len(key_locs) == 1, "each sprite must contain exactly one door-colored key pixel"
+        key_color = int(g[key_locs[0]])
