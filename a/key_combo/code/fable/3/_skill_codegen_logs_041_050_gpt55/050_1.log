+        right = grid[:, wall_index + 1 :] != bg
+        assert bool(np.any(left)) ^ bool(np.any(right)), "sprites must occupy exactly one side"
+        if np.any(left):
+            mask[:, :wall_index] = left
+        else:
+            mask[:, wall_index + 1 :] = right
+    return mask
