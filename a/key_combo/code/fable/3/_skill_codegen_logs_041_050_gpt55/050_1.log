+        j = i
+        while j < n and int(line[j]) == color:
+            j += 1
+        assert j - i == 3, "each door segment must be a straight three-pixel run"
+        center_axis = (i + j - 1) // 2
+        assert color not in centers, "door core colors must be unique"
+        if orientation == "horizontal":
