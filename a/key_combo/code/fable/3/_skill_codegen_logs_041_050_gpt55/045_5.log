        return None
    if not _gen_repair_sample_matches(inp, sample, fixed, expected_matches, rng):
        return None
    noise_nz = int(np.count_nonzero(inp[~fixed]))
    bg_frac = float(np.mean(inp == _GEN_BACKGROUND))
