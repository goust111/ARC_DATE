+    random.shuffle(silhouettes)
+    if not any(item["kind"] == "mirror" and int(item["scale"]) == scale for item in silhouettes):
+        return None
+    if not any(item["kind"] == "modified" and int(item["scale"]) == scale for item in silhouettes):
