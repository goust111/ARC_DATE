+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or int(grid[sr, sc]) == bg:
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            cells: list[Coord] = []
+            colors: set[int] = set()
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                colors.add(int(grid[r, c]))
+                for nr, nc in _neighbors4(r, c):
