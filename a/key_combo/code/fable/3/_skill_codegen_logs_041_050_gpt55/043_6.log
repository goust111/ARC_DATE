+from arc_utils import Color, components_mask, paste
+
+
+BG = Color.GREY
+LINE = Color.BLACK
+MARK = Color.TEAL
+DIRECTIONS = ((1, 1), (1, -1))
+SPRITE_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.MAROON]
