+        assert _in_bounds(g.shape, rr, cc), "reflected sprite must stay in bounds"
+        assert int(g[rr, cc]) != LINE, "reflected sprite must not collide with black segments"
+        out[rr, cc] = int(g[r, c])
+        reflected_any |= (rr, cc) not in original
