+    sys.path.append(str(_UTILS))
+
+from arc_utils import Color, components_mask, paste
+
+
+BG = Color.GREY
+LINE = Color.BLACK
+MARK = Color.TEAL
+DIRECTIONS = ((1, 1), (1, -1))
