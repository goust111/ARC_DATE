+        if np.count_nonzero(out == MARK) != len(intended["coords"]):
+            return False
+    except Exception:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GEN_SIDE_RANGE)
+    w = random.randint(*GEN_SIDE_RANGE)
+    grid = np.full((h, w), BG, dtype=int)
+
+    placed = _place_selected(grid)
+    if placed is None:
