+        return False
+    for r, c in new_cells:
+        if not _in_bounds(g.shape, r, c) or int(g[r, c]) != BG:
+            return False
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) in new_cells:
+                    continue
+                if _in_bounds(g.shape, rr, cc) and int(g[rr, cc]) == LINE:
+                    return False
+    return True
+
