+            assert side in _TURN_BY_SYMBOL_SIDE, "ordinary pointers must be straight/left/right symbols"
+            direction = (direction + _TURN_BY_SYMBOL_SIDE[side]) % 4
+
+        dr, dc = _DELTAS[direction]
+        r += dr
+        c += dc
+
+    return path
