+                    trial,
+                    expected,
+                    box,
+                    side,
+                    gap,
+                    bg,
+                    pattern_palette,
+                )
+            except ValueError:
+                continue
+
+            grid = trial
+            expected = trial_expected
+            placed_boxes.append(box)
+            frames.append(frame)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    if _get_bg(grid) != int(bg):
+        return None
+    if max(grid.shape) > 30:
+        return None
+    if not _gen_semantic_checks(grid, expected, frames, bg):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
