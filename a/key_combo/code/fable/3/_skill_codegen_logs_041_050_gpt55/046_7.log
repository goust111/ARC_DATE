+_GEN_BG_FOR_DRAW = 0
+
+
+def _gen_attempt() -> np.ndarray | None:
+    global _GEN_BG_FOR_DRAW
+
+    height = random.randint(*GEN_SIZE_RANGE)
+    width = random.randint(*GEN_SIZE_RANGE)
+    colors = list(GEN_COLORS)
+    bg = random.choice(colors)
