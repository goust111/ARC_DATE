+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDES = ("top", "bottom", "left", "right")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _foreground_colors(grid: np.ndarray, bg: int) -> list[int]:
+    return sorted(int(v) for v in np.unique(grid) if int(v) != int(bg))
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros(grid.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for sr, sc in np.argwhere(grid == int(color)):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        q: deque[Coord] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        pts: list[Coord] = []
+        while q:
+            r, c = q.popleft()
+            pts.append((r, c))
+            for dr, dc in NEIGHBORS4:
+                rr, cc = r + dr, c + dc
+                if (
+                    0 <= rr < h
+                    and 0 <= cc < w
+                    and not seen[rr, cc]
+                    and int(grid[rr, cc]) == int(color)
