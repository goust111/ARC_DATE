+    cells = {(int(r), int(c)) for r, c in coords}
+    border = _border_cells(r0, c0, r1, c1)
+    if not cells <= border:
+        return None
+
+    gaps = list(border - cells)
+    if len(gaps) != 1:
+        return None
+    gap = gaps[0]
+    side = _gap_side((r0, c0, r1, c1), gap)
+    if side is None:
+        return None
+    if cells != border - {gap}:
+        return None
