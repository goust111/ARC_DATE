+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+        comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _border_cells(r0: int, c0: int, r1: int, c1: int) -> set[Coord]:
+    return {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+
+
+def _gap_side(box: BBox, gap: Coord) -> str | None:
+    r0, c0, r1, c1 = box
+    r, c = gap
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _frame_from_component(coords: np.ndarray, color: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+        return None
+
+    cells = {(int(r), int(c)) for r, c in coords}
+    border = _border_cells(r0, c0, r1, c1)
+    if not cells <= border:
+        return None
+
+    gaps = list(border - cells)
+    if len(gaps) != 1:
+        return None
+    gap = gaps[0]
+    side = _gap_side((r0, c0, r1, c1), gap)
+    if side is None:
+        return None
+    if cells != border - {gap}:
