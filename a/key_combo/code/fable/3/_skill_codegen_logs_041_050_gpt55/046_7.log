+    r0, c0, r1, c1 = box
+    expected[r0 : r1 + 1, c0 : c1 + 1] = grid[r0 : r1 + 1, c0 : c1 + 1]
+    for r, c in target_cells:
+        expected[r, c] = int(bg)
+    for r, c, color in source_records:
+        rr, cc = _mirror_cell((r, c), axis_kind, axis)
+        expected[rr, cc] = int(color)
