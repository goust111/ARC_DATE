+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        assert r1 - r0 + 1 >= 6 and c1 - c0 + 1 >= 6, "frames must leave cells on both sides of the gap axis"
+        for cell in frame["cells"]:
