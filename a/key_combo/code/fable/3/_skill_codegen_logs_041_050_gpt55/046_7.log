+            if not offsets:
+                continue
+            offset = random.choice(offsets)
+            if h >= height - 2 or w >= width - 2:
+                continue
+            r0 = random.randint(1, height - h - 1)
+            c0 = random.randint(1, width - w - 1)
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
