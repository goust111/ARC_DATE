+    source_pixels: list[tuple[int, int, int]] = []
+    target_cells: list[Coord] = []
+    target_had_pixels = False
+
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            delta = c - axis if axis_kind == "vertical" else r - axis
+            if delta == 0:
