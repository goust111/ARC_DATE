+        return {
+            "side": side,
+            "center": center,
+            "sprite_box": sprite_box,
+            "sequence": list(sequence),
+            "mirrors": mirrors,
+            "exit_cell": exit_cell,
+            "exit_dir": direction,
+            "output_box": output_box,
+        }
