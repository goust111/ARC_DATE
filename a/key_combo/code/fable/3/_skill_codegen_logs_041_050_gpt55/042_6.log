+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_components(mask, connectivity=4)) == 1
+
+
+def _random_sprite(size: int, colors: tuple[int, int], sequence: list[str]) -> np.ndarray | None:
+    for _ in range(80):
