+BG = 0
+GREY = 5
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR_FROM_EDGE = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
