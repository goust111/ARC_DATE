+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR_FROM_EDGE = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+GEN_ATTEMPTS = 700
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
