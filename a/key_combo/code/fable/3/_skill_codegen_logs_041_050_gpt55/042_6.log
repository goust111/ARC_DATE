+def _swap_colors(patch: np.ndarray, colors: tuple[int, int]) -> np.ndarray:
+    a, b = colors
+    out = patch.copy()
+    ma = patch == a
+    mb = patch == b
+    out[ma] = b
+    out[mb] = a
