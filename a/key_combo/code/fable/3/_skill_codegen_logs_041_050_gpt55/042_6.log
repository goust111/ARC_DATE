    bottom_rows = {r for r, _c in bottom}
    left_cols = {c for _r, c in left}
    right_cols = {c for _r, c in right}
    assert len(top_rows) == len(bottom_rows) == len(left_cols) == len(right_cols) == 1

    r0 = top_rows.pop()
    r1 = bottom_rows.pop()
    c0 = left_cols.pop()
    c1 = right_cols.pop()
