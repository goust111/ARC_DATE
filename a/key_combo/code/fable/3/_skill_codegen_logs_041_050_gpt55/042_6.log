+    r0, c0, r1, c1 = b
+    touches = []
+    if r0 == 0:
+        touches.append("top")
+    if r1 == h - 1:
+        touches.append("bottom")
+    if c0 == 0:
+        touches.append("left")
+    if c1 == w - 1:
+        touches.append("right")
