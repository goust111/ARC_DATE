+def _place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    for rr, cc in np.argwhere(patch != BG):
+        grid[r0 + int(rr), c0 + int(cc)] = int(patch[rr, cc])
