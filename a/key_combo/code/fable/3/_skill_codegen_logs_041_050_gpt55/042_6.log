+
+def _random_sprite(size: int, colors: tuple[int, int], sequence: list[str]) -> np.ndarray | None:
+    for _ in range(80):
+        patch = np.zeros((size, size), dtype=int)
+        for r in range(size):
+            for c in range(size):
+                if random.random() < 0.72:
+                    patch[r, c] = random.choice(colors)
