+    sprite = _find_sprite(g)
+    mirrors = _mirror_map(g)
+    traced = _trace(g, sprite, mirrors)
+    r0, c0 = _exit_placement(g.shape, traced["patch"].shape, traced["exit_cell"], traced["exit_dir"])
