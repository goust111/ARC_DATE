+def _build_plan(shape: tuple[int, int], size: int, side: str, sequence: list[str]) -> dict | None:
+    for _ in range(180):
+        center = _choose_center(side, size, shape)
+        sprite_box = _sprite_bbox(side, center, size, shape)
+        direction = DIR_FROM_EDGE[side]
+        pos = center
