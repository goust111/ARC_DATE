+        "bbox": b,
+        "patch": patch,
+        "colors": colors,
+        "side": side,
+        "center": center,
+        "direction": direction,
+    }
+
+
+def _hit_is_interior(mirrors: dict[Coord, str], pos: Coord, orient: str) -> bool:
+    r, c = pos
+    dr, dc = _diagonal_step(orient)
+    return mirrors.get((r + dr, c + dc)) == orient and mirrors.get((r - dr, c - dc)) == orient
