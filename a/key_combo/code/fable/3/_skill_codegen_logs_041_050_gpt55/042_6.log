_GEN_BG_COLORS = (Color.BLUE, Color.GREY, Color.TEAL, Color.MAROON, Color.ORANGE, Color.YELLOW, Color.PINK)
_GEN_ROWS_RANGE = (10, 15)
_GEN_COLS_RANGE = (10, 19)
_GEN_BORDER_PAD = 1

