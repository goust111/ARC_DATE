+_N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+_SHAPES: dict[str, tuple[Coord, ...]] = {
+    "solid": (
+        (-1, -1), (-1, 0), (-1, 1),
+        (0, -1), (0, 0), (0, 1),
