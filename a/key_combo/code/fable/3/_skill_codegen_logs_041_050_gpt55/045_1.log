+    dest_box = _box_cells(dest_center)
+    if path_set & (source_box | dest_box):
+        return None
+
+    all_cells = path_set | source_box | dest_box
+    if any(cell in reserved for cell in all_cells):
+        return None
+    return source_center, dest_center, all_cells
