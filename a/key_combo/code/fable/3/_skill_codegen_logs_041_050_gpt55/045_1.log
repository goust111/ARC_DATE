def _straight_guide(g: np.ndarray, bg: int) -> tuple[int, set[int], set[int]]:
    candidates: list[tuple[int, set[int], set[int]]] = []
    for color in colors_present(g, exclude={bg}):
        coords = np.argwhere(g == color)
        assert coords.size > 0
