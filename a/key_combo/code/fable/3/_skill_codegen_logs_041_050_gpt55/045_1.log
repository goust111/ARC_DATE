+    before_end = path[-2]
+    source_out = (start[0] - second[0], start[1] - second[1])
+    dest_out = (end[0] - before_end[0], end[1] - before_end[1])
+    source_center = (start[0] + 2 * source_out[0], start[1] + 2 * source_out[1])
+    dest_center = (end[0] + 2 * dest_out[0], end[1] + 2 * dest_out[1])
