+
+def _get_bg(g: np.ndarray) -> int:
+    return int(Counter(map(int, g.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
