+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(20, 30)
+    w = random.randint(20, 30)
+    n_wires = random.choice([3, 4])
+    counts = _make_counts(n_wires)
+    shapes = _make_shapes(n_wires)
