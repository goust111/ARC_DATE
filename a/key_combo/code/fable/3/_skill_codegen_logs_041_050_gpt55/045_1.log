+def _path_from_steps(start: Coord, dirs_and_lengths: list[tuple[Coord, int]]) -> list[Coord] | None:
+    path = [start]
+    r, c = start
+    for (dr, dc), length in dirs_and_lengths:
+        for _ in range(length):
+            r += dr
+            c += dc
+            if (r, c) in path:
+                return None
+            path.append((r, c))
+    return path
