+            path = _random_candidate_path((h, w), min_cells)
+            fit = _candidate_fits(path, (h, w), reserved)
+            if fit is None:
+                continue
+            bead_indices = _sample_bead_indices(len(path), bead_count)
+            if bead_indices is None:
