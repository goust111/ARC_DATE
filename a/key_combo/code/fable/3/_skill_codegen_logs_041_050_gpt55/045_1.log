+
+def _make_shapes(n_wires: int) -> list[str]:
+    shapes = list(_CYCLE)
+    random.shuffle(shapes)
+    while len(shapes) < n_wires:
+        shapes.append(random.choice(_CYCLE))
+    random.shuffle(shapes)
+    return shapes
