+
+
+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r0, c0 in np.argwhere(mask):
+        r = int(r0)
+        c = int(c0)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q: deque[Coord] = deque([(r, c)])
+        comp: list[Coord] = []
+        while q:
+            pr, pc = q.popleft()
+            comp.append((pr, pc))
+            for nr, nc in _neighbors4(pr, pc):
