+# --------------- generator ---------------
+
+_BG = 0
+_WIRE_COLOR = 8
+_BEAD_COLORS = (5,)
+_TOKEN_COLORS = (1, 2, 3, 4, 6, 7, 9)
+_GEN_RETRIES = 500
+_PLACE_RETRIES = 300
