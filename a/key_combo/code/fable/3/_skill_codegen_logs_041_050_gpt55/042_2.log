+def _runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    spans = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+        else:
+            spans.append((start, prev))
+            start = prev = idx
+    spans.append((start, prev))
+    return spans
+
