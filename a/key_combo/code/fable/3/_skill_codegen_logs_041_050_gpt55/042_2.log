    assert g.ndim == 2

    bg = get_bg(g)
    target, mapping = _target_and_legend(g, bg)
    crop = crop_bbox(g, target["bbox"])

    out = crop.copy()
    for source, replacement in mapping.items():
        out[crop == source] = replacement
    return out

