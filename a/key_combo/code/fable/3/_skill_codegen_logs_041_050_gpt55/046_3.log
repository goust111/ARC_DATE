+    assert frames, "expected at least one hollow square frame"
+    frame_cells = sum(4 * (int(frame["side"]) - 1) for frame in frames)
+    assert frame_cells + len(legend_cells) == int((g != BG).sum()), "unexpected foreground object"
+    return cycle, frames
