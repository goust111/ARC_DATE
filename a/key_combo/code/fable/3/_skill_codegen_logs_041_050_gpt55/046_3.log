+    legend_cell_set = set(legend_cells)
+    cycle_set = set(cycle)
+    frames: list[dict] = []
+    for comp in comps:
+        frame = _frame_from_component(g, comp, legend_cell_set, cycle_set)
+        if frame is not None:
+            frames.append(frame)
