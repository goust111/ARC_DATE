    return coord_set


def _gen_pocket_attempt():
    path_count = random.randint(*POCKET_PATH_COUNT_RANGE)
    size_lo, size_hi = POCKET_SIZE_BY_PATH_COUNT[path_count]
    height = random.randint(size_lo, size_hi)
    width = random.randint(size_lo, size_hi)

