+    occupied = np.zeros((rows, cols), dtype=bool)
+    items: list[dict] = []
+
+    order = list(range(count))
+    random.shuffle(order)
+    for idx in order:
+        color = int(colors[idx])
+        spec = specs[idx]
+        side = int(spec["side"])
