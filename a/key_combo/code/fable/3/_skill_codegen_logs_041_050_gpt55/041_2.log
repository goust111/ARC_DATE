+    area = int(comp["area"])
+    marker = dict(comp)
+    if area == 1:
+        marker["kind"] = "point"
+        marker["point"] = tuple(map(int, comp["coords"][0]))
+        return marker
+
+    if r0 == r1 and area == c1 - c0 + 1 and area >= 3:
+        marker["kind"] = "hline"
+        marker["axis"] = r0
