+
+def _components(grid: np.ndarray, color: int, connectivity: int = 8) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    nbrs = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    out: list[dict] = []
+
+    for sr, sc in np.argwhere(grid == int(color)):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in nbrs:
+                rr, cc = r + dr, c + dc
+                if (
+                    0 <= rr < h
+                    and 0 <= cc < w
+                    and not seen[rr, cc]
+                    and int(grid[rr, cc]) == int(color)
+                ):
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+
+        arr = np.asarray(coords, dtype=int)
+        out.append(
+            {
+                "color": int(color),
+                "coords": arr,
+                "bbox": _bbox(arr),
+                "area": int(arr.shape[0]),
+            }
+        )
+    return out
+
+
+def _is_solid_square(comp: dict, grid: np.ndarray, min_side: int = 5) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
