+
+    expected = _expected_from_items(grid, bg, items)
+    if not _semantic_ok(grid, expected, bg, items):
+        return None
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
