+        foot_h, foot_w = int(spec["foot_h"]), int(spec["foot_w"])
+        motif_pos = _place_box(occupied, foot_h, foot_w, pad=1)
+        if motif_pos is None:
+            return None
+        mr, mc = motif_pos
