LONG_POCKET_HEIGHT_RANGE, LONG_POCKET_WIDTH_RANGE = (9, 12), (5, 7)
LONG_POCKET_RUN_RANGE, LONG_POCKET_FG_CELLS_RANGE = (3, 5), (18, 23)
LONG_POCKET_REGION_COUNT = 2
# Top-level strategy thresholds.
