+
+
+def _touches(a: dict, b: dict, connectivity: int = 8) -> bool:
+    offsets = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    bcoords = {tuple(map(int, xy)) for xy in b["coords"]}
+    for r, c in a["coords"]:
