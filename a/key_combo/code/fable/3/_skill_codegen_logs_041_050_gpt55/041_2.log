+        r0, c0, side = item["block"]
+        mask = item["mask"]
+        mh, mw = map(int, mask.shape)
+        rr, cc = np.argwhere(mask).T
+        off_r = r0 + (side - mh) // 2
+        off_c = c0 + (side - mw) // 2
+        out[off_r + rr, off_c + cc] = int(bg)
