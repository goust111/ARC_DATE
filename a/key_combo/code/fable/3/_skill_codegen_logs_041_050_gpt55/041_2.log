+def _bbox(coords: set[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    arr = np.asarray(list(coords) if isinstance(coords, set) else coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
