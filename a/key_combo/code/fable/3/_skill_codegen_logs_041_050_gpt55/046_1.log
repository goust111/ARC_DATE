+
+def _cell_neighbors(cell: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    r, c = cell
+    out = []
+    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
