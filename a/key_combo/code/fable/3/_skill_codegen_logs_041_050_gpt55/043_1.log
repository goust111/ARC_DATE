0061:     # 2. For each other object, rescale+recolor the template to match indicators
0062:     # Determine the scaling factor by the ratio of the size of the indicator pixel region
0063:     # Determine the color according to the non-indicator color of the object
0064:     # Determine the position so that indicator pixels are overlaid
0065: 
0066:     # To produce the output we draw on top of the input
0067:     output_grid = input_grid.copy()
0068: 
0069:     for other_object in other_objects:
0070: 
0071:         # Find the new shape's color
