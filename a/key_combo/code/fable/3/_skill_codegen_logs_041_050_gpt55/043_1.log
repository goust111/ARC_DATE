0055:     assert np.all(left_panel[:, -1] == left_bg), "left panel must have a right margin"
0056: 
0057:     mini_start = 2
0058:     mini_end = divider - 2
0059:     assert mini_end - mini_start + 1 >= 4, "left active region must contain two endpoint slots"
0060:     left_slot = (mini_start, mini_start + 1)
0061:     right_slot = (mini_end - 1, mini_end)
0062: 
0063:     target_start = divider + 2
