0043:     # The indicator pixel's color appears in all the objects
0044:     possible_indicator_colors = [ color for color in Color.ALL_COLORS
0045:                                  if all( color in colors_present(obj, exclude={ background }) for obj in objects)]
0046:     assert len(possible_indicator_colors) == 1, "There should be exactly one indicator color"
0047:     indicator_color = possible_indicator_colors[0]
