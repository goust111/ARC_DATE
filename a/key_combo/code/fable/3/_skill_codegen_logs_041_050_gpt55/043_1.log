0050:     object_sizes = [ np.sum(obj != background) for obj in objects]
0051:     indicator_sizes = [ np.sum(obj == indicator_color) for obj in objects]
0052:     rescaled_sizes = [size // indicator_size for size, indicator_size in zip(object_sizes, indicator_sizes)]
0053:     template_index = np.argmax(rescaled_sizes)
0054:     template_object = objects[template_index]
0055:     other_objects = [obj for i, obj in enumerate(objects) if i != template_index]
