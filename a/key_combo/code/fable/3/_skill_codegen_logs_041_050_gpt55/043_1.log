0073: 
0074:         # find the new scale, which is the ratio of the size of the indicator pixel in the original shape to the size of the indicator pixel in the new shape
0075:         b_other = bbox(other_object == indicator_color)
0076:         b_template = bbox(template_object == indicator_color)
