0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """
0024:     Return the 3x3 monochrome sprite type that appears most often in the input.
0025: 
0026:     Input structure
0027:     The grid has a dominant background and several small monochrome foreground sprites.
0028:     Each sprite is an 8-connected component whose bounding box is 3x3.
0029: 
0030:     Rule
0031:     Normalize each sprite to its 3x3 bounding-box mask, keeping its color as part of
0032:     the sprite identity. Count identical colored sprite types and output one copy of
0033:     the uniquely most frequent type on the background.
0034: 
0035:     Key insight
0036:     The output is not a crop from a particular location; it is the repeated motif
0037:     selected by copy count.
0038:     """
0039:     g = np.asarray(grid, dtype=int)
0040:     bg = get_bg(g)
0041:     components = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
0042:     assert components
0043: 
0044:     groups: dict[tuple[int, tuple[tuple[int, ...], ...]], list[dict]] = defaultdict(list)
0045:     masks: dict[tuple[int, tuple[tuple[int, ...], ...]], np.ndarray] = {}
0046:     for component in components:
0047:         color = int(component["color"])
0048:         mask = _component_mask(component)
0049:         pattern = tuple(tuple(int(x) for x in row) for row in mask)
0050:         key = (color, pattern)
0051:         groups[key].append(component)
0052:         masks[key] = mask
0053: 
0054:     max_count = max(len(group) for group in groups.values())
0055:     winners = [key for key, group in groups.items() if len(group) == max_count]
0056:     assert len(winners) == 1
0057: 
0058:     color, _pattern = winners[0]
0059:     mask = masks[winners[0]]
0060:     out = np.full(mask.shape, bg, dtype=int)
0061:     out[mask] = color
0062:     return out

