+        new_cols = cols + shift
+        assert int(new_cols.min()) >= 0 and int(new_cols.max()) < g.shape[1]
+        out[r, cols] = bg
+        assert bool(np.all(out[r, new_cols] == bg)), "shifted row must land on background"
