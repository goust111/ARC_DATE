   232	        segment = spec["segment"]
   233	        consumed, stop = _trace_drill(
   234	            g,
   235	            block_color,
   236	            spec["start"],
   237	            spec["dir"],
   238	            int(segment["length"]),
   239	        )
   240	        for cell in consumed:
   241	            assert cell not in consumed_owner, "drill tunnels must not consume the same material cell"
   242	            consumed_owner[cell] = idx
   243	        stops.append(stop)
   244	
   245	    for idx, stop in enumerate(stops):
   246	        owner = consumed_owner.get(stop)
   247	        assert owner is None or owner == idx, "one drill may not stop inside another drill tunnel"
   248	    assert len(set(stops)) == len(stops), "drill landing cells must be distinct"
