   179	    assert budget > 0, "drill segment length must be positive"
   180	    ray = _ray_cells(grid.shape, start, direction)
   181	    material_indexes = [i for i, (r, c) in enumerate(ray) if int(grid[r, c]) == int(block_color)]
   182	    assert material_indexes and material_indexes[0] == 0, "drill must start in a touched block"
   183	
   184	    consumed_count = min(int(budget), len(material_indexes))
   185	    consumed = {ray[i] for i in material_indexes[:consumed_count]}
   186	    if int(budget) <= len(material_indexes):
   187	        stop = ray[material_indexes[int(budget) - 1]]
   188	    else:
   189	        stop_index = material_indexes[-1] + 1
   190	        assert stop_index < len(ray), "overflow drill needs an in-bounds background cell after the last block"
   191	        stop = ray[stop_index]
