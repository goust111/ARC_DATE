+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 2 or width < 2:
+            return None
+        if len(coords) != height * width:
+            return None
+        if not bool(np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == int(color))):
+            return None
+        blocks.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "cells": frozenset(coords),
+                "color": int(color),
+            }
