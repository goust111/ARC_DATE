+                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and int(g[rr, cc]) == color:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
+
+            comps.append({"color": color, "coords": frozenset(coords)})
+
+    comps.sort(key=lambda comp: min(comp["coords"]))
+    return comps
+
