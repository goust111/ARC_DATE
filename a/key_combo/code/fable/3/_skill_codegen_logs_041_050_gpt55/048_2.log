+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+    assert 0 < max(g.shape) <= 30, "ARC grids must be at most 30 by 30"
+
+    axis, line = _source_axis(g)
+    units: list[dict] = []
+    movers: list[tuple[int, tuple[int, int]]] = []
+    fractured = 0
