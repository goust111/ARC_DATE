+    if r0 < 0 or c0 < 0 or r0 + h > hgt or c0 + w > wid:
+        return False
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(hgt, r0 + h + margin)
+    cc1 = min(wid, c0 + w + margin)
