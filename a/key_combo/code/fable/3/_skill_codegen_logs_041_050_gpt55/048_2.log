+def _resolve_pushes(units: list[dict], initial_movers: list[tuple[int, tuple[int, int]]], shape: tuple[int, int]) -> None:
+    q: deque[tuple[int, tuple[int, int]]] = deque(initial_movers)
+    steps = 0
+    max_steps = shape[0] * shape[1] * max(1, len(units))
