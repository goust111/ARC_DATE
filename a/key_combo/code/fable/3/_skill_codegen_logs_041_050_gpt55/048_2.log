    return int(shape[:, 0].max()) + 1, int(shape[:, 1].max()) + 1


def _gen_normalize(coords):
    arr = np.array(list(coords), dtype=int)
    arr[:, 0] -= int(arr[:, 0].min())
    arr[:, 1] -= int(arr[:, 1].min())
    order = np.lexsort((arr[:, 1], arr[:, 0]))
