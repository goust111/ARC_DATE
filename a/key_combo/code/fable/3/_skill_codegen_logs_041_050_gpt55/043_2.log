    assert len(obstacle_colors) == 1
    obstacle_color = obstacle_colors[0]

    obstacle_rows = np.flatnonzero(np.any(g == obstacle_color, axis=1))
    assert len(obstacle_rows) == 1
    obstacle_row = int(obstacle_rows[0])
