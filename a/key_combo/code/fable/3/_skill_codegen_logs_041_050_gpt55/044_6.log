+# --------------- generator ---------------
+
+
+_MAX_ATTEMPTS = 900
+_Q_RANGE = (8, 13)
+_SHAPE_SIZES = ((4, 4), (4, 5), (5, 4), (5, 5), (5, 6), (6, 5))
