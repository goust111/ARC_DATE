+def _expand_coarse_path(coarse_path: list[Coord]) -> list[Coord]:
+    path: list[Coord] = [coarse_path[0]]
+    for (r0, c0), (r1, c1) in zip(coarse_path, coarse_path[1:]):
+        path.append(((r0 + r1) // 2, (c0 + c1) // 2))
+        path.append((r1, c1))
+    return path
