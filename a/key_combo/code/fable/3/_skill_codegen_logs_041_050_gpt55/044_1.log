+                    and 0 <= cc + dc < len(cols)
+                    and (rr + dr, cc + dc) not in used
+                    for dr, dc in _DIRECTIONS
+                )
+
+            options.sort(key=onward_count, reverse=True)
+            limit = min(len(options), 2)
+            nxt = random.choice(options[:limit])
+            coarse.append(nxt)
+            used.add(nxt)
+        if len(coarse) != steps + 1:
+            continue
