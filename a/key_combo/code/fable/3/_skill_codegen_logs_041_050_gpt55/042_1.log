+    continuing = []
+    for dr, dc in dirs:
+        rr, cc = r + dr, c + dc
+        if _in_bounds(shape, rr, cc) and int(g[rr, cc]) == color:
+            continuing.append((dr, dc))
+    assert len(continuing) == 1, "corner emitters must have one visible inward ray direction"
+    return continuing
