+def _ray_hits(g: np.ndarray) -> dict[tuple[int, int], set[tuple[int, int]]]:
+    hits: dict[tuple[int, int], set[tuple[int, int]]] = {
+        (1, 0): set(),
+        (-1, 0): set(),
+        (0, 1): set(),
+        (0, -1): set(),
