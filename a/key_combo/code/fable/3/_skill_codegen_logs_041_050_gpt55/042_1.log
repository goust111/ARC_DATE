+def _edge_dirs(shape: tuple[int, int], r: int, c: int, color: int, g: np.ndarray) -> list[tuple[int, int]]:
+    h, w = shape
+    dirs: list[tuple[int, int]] = []
+    if r == 0:
+        dirs.append((1, 0))
+    if r == h - 1:
+        dirs.append((-1, 0))
