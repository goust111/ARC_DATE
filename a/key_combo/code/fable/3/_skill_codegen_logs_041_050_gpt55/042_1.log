+def _border_cells(shape: tuple[int, int]):
+    h, w = shape
+    for c in range(w):
+        yield 0, c
+        if h > 1:
+            yield h - 1, c
+    for r in range(1, h - 1):
+        yield r, 0
+        if w > 1:
+            yield r, w - 1
