+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIRS: tuple[tuple[int, int], ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+ALL_COLORS = tuple(range(10))
+MAX_ATTEMPTS = 600
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        pts: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            pts.append((r, c))
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+        comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rectangle_candidate(g: np.ndarray, bg: int, coords: np.ndarray) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h, w = r1 - r0 + 1, c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+    if int(coords.shape[0]) != h * w:
+        return None
+
+    patch = g[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros(patch.shape, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    border_values = set(map(int, patch[border].reshape(-1)))
+    if len(border_values) != 1:
+        return None
+    fill = next(iter(border_values))
+    if fill == int(bg):
+        return None
