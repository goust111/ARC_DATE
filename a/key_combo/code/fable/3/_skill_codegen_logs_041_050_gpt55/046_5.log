+    if len(marker_colors) != 1:
+        return None
+    marker_color = next(iter(marker_colors))
+    if marker_color in (int(bg), int(fill)):
+        return None
+
+    interior_non_marker = (~border) & (~marker_mask)
+    if not bool(np.all(patch[interior_non_marker] == int(fill))):
+        return None
