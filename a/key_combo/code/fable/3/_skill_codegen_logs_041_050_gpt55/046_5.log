            grid[r0 : r0 + TILE_SIZE, c0 : c0 + TILE_SIZE] = frame
            grid[r0 + TILE_OFFSET : r0 + TILE_OFFSET + INTERIOR_SIZE, c0 + TILE_OFFSET : c0 + TILE_OFFSET + INTERIOR_SIZE] = interior
    return grid


def _gen_tile_origin(tile_r, tile_c):
