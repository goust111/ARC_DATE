from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np


def _get_bg(grid: np.ndarray) -> int:
    values, counts = np.unique(grid, return_counts=True)
    return int(values[int(np.argmax(counts))])


def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
    colors = set(map(int, np.unique(grid)))
    if exclude:
        colors -= set(map(int, exclude))
    return sorted(colors)


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros(mask.shape, dtype=bool)
    out: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or not bool(mask[r, c]):
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in _neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bool(mask[nr, nc]):
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(np.array(coords, dtype=int))
    return out


def _center_offsets(size: int) -> list[tuple[int, int]]:
    if size % 2 == 1:
        m = size // 2
        return [(m, m)]
    a = size // 2 - 1
    b = size // 2
    return [(a, a), (a, b), (b, a), (b, b)]


def _node_candidate(g: np.ndarray, bg: int, color: int, coords: np.ndarray) -> dict | None:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
    height = r1 - r0 + 1
    width = c1 - c0 + 1
    if height != width or height < 2:
        return None

    patch = g[r0 : r1 + 1, c0 : c1 + 1]
    if int(np.count_nonzero(patch == int(color))) != int(coords.shape[0]):
        return None

    if bool(np.all(patch == int(color))):
        return {
            "color": int(color),
            "size": int(height),
            "bbox": (r0, c0, r1, c1),
            "coords": coords,
            "hollow": False,
        }

    if height < 3:
        return None
    if not bool(np.all((patch == int(color)) | (patch == int(bg)))):
        return None
    border = np.zeros(patch.shape, dtype=bool)
    border[0, :] = True
    border[-1, :] = True
    border[:, 0] = True
    border[:, -1] = True
    if not bool(np.all(patch[border] == int(color))):
        return None
    if not all(int(patch[rr, cc]) == int(bg) for rr, cc in _center_offsets(height)):
        return None

    return {
        "color": int(color),
        "size": int(height),
        "bbox": (r0, c0, r1, c1),
        "coords": coords,
        "hollow": True,
    }


