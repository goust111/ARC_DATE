NODE_SIZE_CHOICES = [2, 3]               # N for NxN node squares
NODE_COUNT_RANGE = (7, 10)               # V = total graph nodes (2 terminal + rest station)
CYCLE_COUNT_CHOICES = [1, 2]             # independent cycles in the graph
