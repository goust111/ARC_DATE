+            slots.append(
+                {
+                    "index": i,
+                    "color": colors[i],
+                    "main": main,
+                    "head": (hr, hc),
+                    "heading": target_headings[i],
+                    "stamp_cells": stamp_cells,
+                    "turns": turns,
