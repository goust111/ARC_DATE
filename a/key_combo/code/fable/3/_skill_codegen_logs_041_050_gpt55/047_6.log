+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+DIRS4 = ((-1, 0), (0, 1), (1, 0), (0, -1))
+ARC_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    h, w = mask.shape
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q = deque([(sr, sc)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        out.append(comp)
+    return out
+
+
+def _rotate_coord(coord: tuple[int, int], turns: int) -> tuple[int, int]:
+    r, c = coord
+    for _ in range(turns % 4):
+        r, c = c, -r
+    return int(r), int(c)
+
+
+def _rotation_steps(src: tuple[int, int], dst: tuple[int, int]) -> int:
+    for turns in range(4):
+        if _rotate_coord(src, turns) == dst:
+            return turns
+    raise AssertionError(f"cannot rotate heading {src} to {dst}")
+
+
+def _find_frame(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
+    candidates: list[tuple[int, int, tuple[int, int, int, int]]] = []
+    for color in sorted(set(map(int, g.ravel())) - {BG, GRAY}):
+        for comp in _components(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h, w = r1 - r0 + 1, c1 - c0 + 1
+            if h < 4 or w < 4:
+                continue
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[~border] == color):
+                continue
