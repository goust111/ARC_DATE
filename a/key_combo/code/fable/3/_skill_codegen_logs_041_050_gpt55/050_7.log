+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        cells: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
