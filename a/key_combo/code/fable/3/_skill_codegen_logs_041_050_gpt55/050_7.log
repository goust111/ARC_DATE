+    sample_w = inner_w // t
+    assert (inner_h - sample_h) % 2 == 0 and (inner_w - sample_w) % 2 == 0
+    sr0 = ir0 + (inner_h - sample_h) // 2
+    sc0 = ic0 + (inner_w - sample_w) // 2
