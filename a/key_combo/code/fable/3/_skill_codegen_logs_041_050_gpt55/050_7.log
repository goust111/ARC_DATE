+def _ring_mask(shape: tuple[int, int], thickness: int) -> np.ndarray:
+    h, w = map(int, shape)
+    t = int(thickness)
+    rr, cc = np.indices((h, w))
+    return (rr < t) | (rr >= h - t) | (cc < t) | (cc >= w - t)
+
