+    frames.sort(key=lambda f: (f["r0"], f["c0"], f["r1"], f["c1"], f["color"]))
+    assert 1 <= len(frames) <= 2, "expected one or two rectangular thick frames"
+    if len(frames) == 2:
+        assert frames[0]["t"] != frames[1]["t"], "two frames must have different thicknesses"
