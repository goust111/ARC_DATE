+    r0, c0, r1, c1, t = (int(frame[k]) for k in ("r0", "c0", "r1", "c1", "t"))
+    ir0, ic0, ir1, ic1 = r0 + t, c0 + t, r1 - t, c1 - t
+    inner_h = ir1 - ir0 + 1
+    inner_w = ic1 - ic0 + 1
+    assert inner_h > 0 and inner_w > 0
+    assert inner_h % t == 0 and inner_w % t == 0
