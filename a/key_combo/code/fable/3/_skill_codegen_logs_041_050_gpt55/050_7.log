+def _zoom(sprite: np.ndarray, factor: int) -> np.ndarray:
+    """Nearest-neighbor integer pixel upscale, matching arc_utils.scale_sprite."""
+    k = int(factor)
+    assert k > 0
+    return np.repeat(np.repeat(np.asarray(sprite, dtype=int), k, axis=0), k, axis=1)
