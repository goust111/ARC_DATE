+    if kind == "tee":
+        h = random.randint(3, max_side)
+        w = random.randint(3, max_side)
+        mask = np.zeros((h, w), dtype=bool)
+        mask[0, :] = True
+        mask[:, w // 2] = True
+        return np.rot90(mask, random.randrange(4))
