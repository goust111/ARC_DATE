+def _random_shape_mask(n: int) -> np.ndarray:
+    max_side = min(5, n)
+    kind = random.choice(["rect", "line", "ell", "tee", "stair"])
+
+    if kind == "rect":
+        h = random.randint(2, max_side)
+        w = random.randint(2, max_side)
+        return np.ones((h, w), dtype=bool)
+
+    if kind == "line":
