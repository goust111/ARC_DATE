def _gen_split_runs(total, max_events, rng):
    if total == 0:
        return []
    min_events = (total + 1) // 2
    max_events = min(max_events, total)
    if min_events > max_events:
        return None
    n_events = int(rng.integers(min_events, max_events + 1))
