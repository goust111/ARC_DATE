  "type": "move_along_path",
  "src": "red control pixels on the bottom row",
  "path": "move upward through black cells; when the cell above is grey, step one cell right on the current row if that cell is black, otherwise stop",
  "trajectory": "paint every black cell visited by the path red",
  "transform": "leave grey obstacles and the original red controls unchanged"
}
</annotation>
</reference_puzzle>

