+        r0, c0 = _tile_origin(n, tr, tc)
+        source_tile = g[r0 : r0 + n, c0 : c0 + n]
+        target_tile = out[r0 : r0 + n, c0 : c0 + n]
+        target_tile[source_tile != bg] = PAINT_CYCLE[i % len(PAINT_CYCLE)]
+    return out
