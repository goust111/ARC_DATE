    r0, c0 = random.choice(marker_positions)
    expected = out_grid[r0 : r0 + marker_h, c0 : c0 + marker_w].copy()
    inp = out_grid.copy()
    inp[r0 : r0 + marker_h, c0 : c0 + marker_w] = MARKER_COLOR

    if not _passes_oracle(inp, expected):
        return None
    return inp


