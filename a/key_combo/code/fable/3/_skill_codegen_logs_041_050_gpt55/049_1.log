+# --------------- generator ---------------
+
+GEN_N_VALUES = (3, 4, 5)
+GEN_BG = 0
+GEN_FOREGROUND_COLORS = (1, 3, 4, 6, 7, 9)
+GEN_RETRY_LIMIT = 300
