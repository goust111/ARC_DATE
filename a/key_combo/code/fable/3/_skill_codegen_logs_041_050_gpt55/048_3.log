+def _grow_chain(
+    blocks: list[dict], h: int, w: int, seed_idx: int, length: int
+) -> list[int] | None:
+    first = _place_adjacent(blocks, h, w, seed_idx, None, "gray", 2)
+    if first is None:
+        return None
+    chain = [first]
+    parent = first
+    for _ in range(length - 1):
+        nxt = _place_adjacent(blocks, h, w, parent, None, "gray", 1)
+        if nxt is None:
+            return None
+        chain.append(nxt)
+        parent = nxt
+    return chain
