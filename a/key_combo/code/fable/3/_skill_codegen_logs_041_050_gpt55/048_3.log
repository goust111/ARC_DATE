+    out = np.zeros((h, w), dtype=int)
+    for idx, block in enumerate(blocks):
+        color = colors[idx] if block["role"] == "gray" else int(block["color"])
+        for r, c in block["cells"]:
+            out[r, c] = color
+    return out, colors, generations, decisions
+
