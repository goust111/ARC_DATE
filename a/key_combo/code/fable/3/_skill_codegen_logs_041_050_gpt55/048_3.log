+    for start in range(n):
+        if disc[start] == -1:
+            dfs(start)
+
+    seen = [False] * n
+    pieces: list[frozenset[tuple[int, int]]] = []
+    for start in range(n):
+        if seen[start]:
+            continue
+        q = deque([start])
+        seen[start] = True
+        piece = set()
+        while q:
+            u = q.popleft()
+            piece.add(ordered[u])
+            for v in adj[u]:
+                edge = (min(u, v), max(u, v))
+                if edge in bridges or seen[v]:
+                    continue
+                seen[v] = True
+                q.append(v)
