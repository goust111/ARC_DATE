+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        q = deque([(sr, sc)])
+        seen[sr, sc] = True
+        cells = set()
+        while q:
+            r, c = q.popleft()
+            cells.add((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if (
