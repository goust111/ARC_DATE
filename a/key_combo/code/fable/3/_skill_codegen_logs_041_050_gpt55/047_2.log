+    assert isinstance(branches, dict)
+    required = ("red_only", "blue_only", "both_red", "both_blue", "stay")
+    if any(int(branches[name]) == 0 for name in required):
+        return False
+    if int(profile["red_stack"]) < 2 or int(profile["blue_stack"]) < 2:
+        return False
