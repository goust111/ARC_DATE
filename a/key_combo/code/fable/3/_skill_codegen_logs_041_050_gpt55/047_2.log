+    red_counts, blue_counts = _stack_counts(trial, red_cols, blue_rows)
+    return (
+        max(red_counts.values(), default=0) <= MAX_STACK_PER_LINE
+        and max(blue_counts.values(), default=0) <= MAX_STACK_PER_LINE
