+
+# ----------------------------- generator -----------------------------
+
+
+GEN_RETRIES = 800
+MIN_SIZE = 14
+MAX_SIZE = 24
+MIN_SEG_LEN = 4
+MAX_SEG_LEN = 7
+EDGE_GAP = 5
+MAX_STACK_PER_LINE = 4
