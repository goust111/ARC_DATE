+    turn_z = random.randint(min_turn, max_turn)
+
+    grid = np.full((height, width), BLACK, dtype=int)
+    start_cols = {
+        colors[0]: x_col,
+        colors[1]: z_col,
+        colors[2]: w_col,
+        colors[4]: y_col,
+    }
+    if use_extra:
+        extra_candidates = [c for c in range(w_col + 3, width - 1)]
