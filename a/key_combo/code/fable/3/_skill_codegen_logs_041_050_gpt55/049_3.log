    return _gen_randint(_GEN_LEAF_HEIGHT_RANGE), _gen_randint(_GEN_LEAF_WIDTH_RANGE)


def _gen_margin() -> int:
    return random.choices(_GEN_MARGIN_VALUES, weights=_GEN_MARGIN_WEIGHTS)[0]


