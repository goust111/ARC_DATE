from collections import Counter

import numpy as np


COLORS = tuple(range(10))
CORNER_NAMES = ("tl", "tr", "bl", "br")
LOCAL_CORNERS = {
    "tl": (0, 0),
    "tr": (0, 2),
    "bl": (2, 0),
    "br": (2, 2),
}
