    return path

def _gen_scatter_obstacles(grid, row_counts, used_path, target_count, rng):
    h, w = grid.shape
    obstacle_count = int(np.count_nonzero(grid == _GEN_OBSTACLE))
    if obstacle_count > target_count:
        return False

    for r in rng.permutation(h - 1):
        r = int(r)
        if row_counts[r] != 0:
            continue
        if obstacle_count >= target_count:
