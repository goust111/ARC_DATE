+            color = int(grid[sr, sc])
+            if color == bg or seen[sr, sc]:
+                continue
+            q = deque([(sr, sc)])
+            seen[sr, sc] = True
+            cells = []
+            while q:
+                r, c = q.popleft()
+                cells.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
