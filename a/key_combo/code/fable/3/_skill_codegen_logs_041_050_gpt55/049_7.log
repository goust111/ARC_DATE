def _gen_leaf_size() -> tuple[int, int]:
    if random.random() < _GEN_LEAF_DEGENERATE_PROB:
        if random.random() < _GEN_LEAF_DEGENERATE_AXIS_PROB:
            return 1, _gen_randint(_GEN_LEAF_LINE_LENGTH_RANGE)
