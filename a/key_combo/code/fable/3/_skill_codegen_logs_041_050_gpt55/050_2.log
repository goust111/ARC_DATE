+    depth: int,
+    container_color: int,
+    object_color: int,
+    rng: random.Random,
+) -> tuple[list[tuple[int, int, int]], list[Coord], str] | None:
+    shape = rng.choice(("dot", "bar"))
+    if direction in ("left", "right"):
+        h = rng.randint(5, 7)
+        w = rng.randint(depth + 3, depth + 5)
+    else:
+        h = rng.randint(depth + 3, depth + 5)
+        w = rng.randint(5, 7)
