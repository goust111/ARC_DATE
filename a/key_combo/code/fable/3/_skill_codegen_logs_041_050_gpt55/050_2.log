+        coords = tuple((int(r), int(c)) for r, c in obj["coords"])
+        records.append(
+            MovingObject(
+                coords=coords,
+                color=int(obj["color"]),
+                direction=direction,
+                depth=depth,
+                container_bbox=container["bbox"],
+            )
+        )
