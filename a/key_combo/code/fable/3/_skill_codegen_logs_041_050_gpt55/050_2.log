+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros(grid.shape, dtype=bool)
+    comps: list[dict] = []
+    for r, c in np.argwhere(grid != BG):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        color = int(grid[r, c])
+        q: deque[Coord] = deque([(r, c)])
+        seen[r, c] = True
+        coords: list[Coord] = []
+        while q:
+            rr, cc = q.popleft()
+            coords.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if (
+                    0 <= nr < h
+                    and 0 <= nc < w
+                    and not seen[nr, nc]
+                    and int(grid[nr, nc]) == color
+                ):
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        arr = np.array(coords, dtype=int)
+        comps.append({"color": color, "coords": arr, "bbox": _bbox(arr), "area": len(coords)})
+    return comps
+
+
+def _required_u_mask(h: int, w: int, direction: str) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    if direction == "up":
+        mask[:, 0] = True
+        mask[:, w - 1] = True
+        mask[h - 1, :] = True
+    elif direction == "down":
+        mask[:, 0] = True
+        mask[:, w - 1] = True
+        mask[0, :] = True
+    elif direction == "left":
+        mask[0, :] = True
+        mask[h - 1, :] = True
+        mask[:, w - 1] = True
+    elif direction == "right":
+        mask[0, :] = True
+        mask[h - 1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(direction)
+    return mask
+
+
+def _u_direction(component: dict) -> str | None:
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    local = np.zeros((h, w), dtype=bool)
+    coords = component["coords"]
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    for direction in DIR_ORDER:
+        if np.array_equal(local, _required_u_mask(h, w, direction)):
+            return direction
+    return None
+
+
