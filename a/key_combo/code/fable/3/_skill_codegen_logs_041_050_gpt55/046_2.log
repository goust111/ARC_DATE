def _gen_choose_square_colors() -> list[int]:
    total = random.randint(_GEN_TOTAL_SQUARE_MIN, _GEN_TOTAL_SQUARE_MAX)
    grey_min = max(0, total - _GEN_PINK_SQUARE_MAX)
