    (Color.GREY, Color.BLUE, Color.GREY),
    (Color.BLUE, Color.BLACK, Color.BLUE),
    (Color.GREY, Color.BLUE, Color.GREY),
)


def _select_centers(n_centers):
    candidates = [(r, c) for r in CENTER_COORDS for c in CENTER_COORDS]
