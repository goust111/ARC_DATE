    out = np.zeros(GRID_SHAPE, dtype=int)
    for r, c in centers:
        out[r - 1 : r + 2, c - 1 : c + 2] = MOTIF

    if not np.array_equal(main(grid), out):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
