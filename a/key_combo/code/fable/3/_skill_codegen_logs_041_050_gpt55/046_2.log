+
+    sr0, sc0, sr1, _sc1 = source_r0, left, source_r0 + source_h - 1, left + width - 1
+    marble_r = random.randint(sr0 + 1, sr1 - 1)
+    if direction_name == "bottom":
+        direction = (1, 0)
+    else:
+        direction = (-1, 0)
+    start = (marble_r, lane_c)
+    grid[start] = int(marble_color)
+    return {
