+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+_DIR_BY_SIDE = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+_OPPOSITE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[Coord]]:
+    h, w = grid.shape
+    seen = np.zeros(grid.shape, dtype=bool)
+    out: list[list[Coord]] = []
+
+    for sr, sc in np.argwhere(grid == int(color)):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q: deque[Coord] = deque([(sr, sc)])
+        coords: list[Coord] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        out.append(coords)
+    return out
+
+
+def _bbox(coords: list[Coord]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _border_cells(r0: int, c0: int, r1: int, c1: int) -> set[Coord]:
+    return {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+
+
+def _gap_side(box: tuple[int, int, int, int], gap: Coord) -> str | None:
+    r0, c0, r1, c1 = box
+    r, c = gap
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _frame_from_component(grid: np.ndarray, color: int, coords: list[Coord]) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+
+    cells = set(coords)
+    border = _border_cells(r0, c0, r1, c1)
+    if any(cell not in border for cell in cells):
+        return None
+    gaps = list(border - cells)
+    if len(gaps) != 1:
+        return None
+    gap = gaps[0]
+    side = _gap_side((r0, c0, r1, c1), gap)
+    if side is None:
+        return None
+    if cells != border - {gap}:
