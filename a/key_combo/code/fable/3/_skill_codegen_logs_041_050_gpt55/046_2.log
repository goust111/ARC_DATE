+        starts = _band_starts(height, sizes)
+        if starts is None:
+            return None
+        for top, track_h, branch, marble_color in zip(starts, sizes, branches, marble_colors):
+            spec = _add_horizontal_track(grid, bg, frame_color, marble_color, top, track_h, branch)
+            if spec is None:
