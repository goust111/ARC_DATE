+def _expected_from_specs(grid: np.ndarray, bg: int, specs: list[dict]) -> np.ndarray | None:
+    out = grid.copy()
+    starts = {spec["start"] for spec in specs}
+    ends: set[Coord] = set()
+    for r, c in starts:
+        out[r, c] = int(bg)
+    for spec in specs:
+        end = spec["end"]
+        if end in starts or end in ends:
+            return None
+        if int(out[end]) != int(bg):
+            return None
+        ends.add(end)
+        out[end] = int(spec["color"])
+    return out
+
