+
+
+def _add_vertical_track(
+    grid: np.ndarray,
+    bg: int,
+    frame_color: int,
+    marble_color: int,
+    left: int,
+    width: int,
+    branch: str,
+) -> dict | None:
+    h, w = grid.shape
+    source_h = random.randint(4, 6)
+    obstacle_h = random.randint(4, 6)
+    lane_offset = random.randint(1, width - 2)
