+            else:
+                end = (obstacle_r0 + obstacle_h - 2, lane_c)
+        else:
+            obstacle_r0 = random.randint(1, h - total - 1)
+            source_r0 = obstacle_r0 + obstacle_h + gap
+            near_side = "bottom"
