    if len(components_mask(grid != GEN_BG, connectivity=4)) != GEN_REQUIRED_COMPONENTS:
        return False

    expected = _gen_apply_wave(grid)
    if expected is None: return False

    try:
        return np.array_equal(main(grid), expected)
    except Exception:
        return False


