+
+SIDE_DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+OPPOSITE_SIDE = {"N": "S", "S": "N", "W": "E", "E": "W"}
+OPPOSITE_DIR = {v: (-v[0], -v[1]) for v in SIDE_DIRS.values()}
+ALL_SIDES = tuple(SIDE_DIRS)
+SLOTS = (1, 2)
