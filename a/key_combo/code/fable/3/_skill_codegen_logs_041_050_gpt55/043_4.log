+
+def _gap_pos(r0: int, c0: int, side: str, slot: int) -> tuple[int, int]:
+    slot = int(slot)
+    if side == "N":
+        return r0, c0 + slot
+    if side == "S":
+        return r0 + 3, c0 + slot
+    if side == "W":
+        return r0 + slot, c0
+    if side == "E":
