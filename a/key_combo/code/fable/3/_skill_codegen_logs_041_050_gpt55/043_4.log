+def _edge_sides(pos: tuple[int, int], positions: list[tuple[int, int, int, int]]) -> list[str]:
+    rows = [i for i, _j, _r, _c in positions]
+    cols = [j for _i, j, _r, _c in positions]
+    i, j = pos
+    sides = []
+    if i == min(rows):
+        sides.append("N")
+    if i == max(rows):
+        sides.append("S")
+    if j == min(cols):
+        sides.append("W")
+    if j == max(cols):
+        sides.append("E")
