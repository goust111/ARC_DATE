+
+def _gap_side_slot(r0: int, c0: int, gap: tuple[int, int]) -> tuple[str, int] | None:
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c0 + 3:
+        return "N", gc - c0
+    if gr == r0 + 3 and c0 < gc < c0 + 3:
+        return "S", gc - c0
+    if gc == c0 and r0 < gr < r0 + 3:
+        return "W", gr - r0
+    if gc == c0 + 3 and r0 < gr < r0 + 3:
+        return "E", gr - r0
+    return None
