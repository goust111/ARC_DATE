+        if np.array_equal(actual, grid):
+            return None
+
+        erased = 0
+        changed_receivers = 0
+        for idx, frame in enumerate(detected):
+            patch_in = grid[frame["r"] + 1 : frame["r"] + 3, frame["c"] + 1 : frame["c"] + 3]
+            patch_out = actual[frame["r"] + 1 : frame["r"] + 3, frame["c"] + 1 : frame["c"] + 3]
+            if idx not in incoming:
