+def _border_coords(r0: int, c0: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for dr in range(4):
+        for dc in range(4):
+            if dr in (0, 3) or dc in (0, 3):
+                coords.append((r0 + dr, c0 + dc))
+    return coords
