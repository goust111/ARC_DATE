+        if len(incoming) < 2 or len(incoming) >= frame_count:
+            return None
+
+        expected = _expected_from_pairs(grid, detected, top_left_to_pos, partner, bg)
+        actual = main(grid)
+        if not np.array_equal(actual, expected):
