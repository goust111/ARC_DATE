    candidates = []
    if left - 1 >= 0:
        candidates.append((col - (left - 1), 0, left - 1))
    if right + 1 < width:
        candidates.append(((right + 1) - col, 1, right + 1))
    return min(candidates, key=lambda item: (item[0], -item[1]))[2]


