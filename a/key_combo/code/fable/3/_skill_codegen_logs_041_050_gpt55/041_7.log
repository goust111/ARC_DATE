def _gen_scatter_patches(patches, bg: int, h: int, w: int):
    grid = np.full((int(h), int(w)), int(bg), dtype=int)
    ordered = sorted(
        patches,
        key=lambda patch: (
            max(patch.shape),
            int(np.count_nonzero(patch != int(bg))),
            random.random(),
        ),
        reverse=True,
    )
