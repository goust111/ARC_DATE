+
+def _spans_between(line_groups: list[Span], limit: int) -> list[Span]:
+    spans: list[Span] = []
+    start = 0
+    for line_start, line_end in line_groups:
+        if start < line_start:
+            spans.append((start, line_start - 1))
+        start = line_end + 1
+    if start < limit:
+        spans.append((start, limit - 1))
