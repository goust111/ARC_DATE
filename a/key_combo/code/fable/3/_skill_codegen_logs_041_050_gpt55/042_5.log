from arc_utils import bbox as _bbox

# ── CFG: canvas ──
GRID_H_RANGE = (18, 30)          # output grid height
GRID_W_RANGE = (25, 30)          # output grid width
NUM_PAIRS_CHOICES = [1, 2]       # how many frame-tool pairs

# ── CFG: frame geometry ──
