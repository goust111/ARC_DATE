+
+def _groups(indices: list[int]) -> list[Span]:
+    assert indices, "expected separator lines"
+    groups: list[Span] = []
+    start = prev = int(indices[0])
+    for idx0 in indices[1:]:
+        idx = int(idx0)
+        if idx == prev + 1:
+            prev = idx
+        else:
+            groups.append((start, prev))
+            start = prev = idx
+    groups.append((start, prev))
+    return groups
