    if size >= LARGE_CROSS_SIZE_MIN:
        return random.randint(LARGE_CROSS_MARGIN, size - LARGE_CROSS_MARGIN - 1)
    return random.randint(SMALL_CROSS_MARGIN, size - SMALL_CROSS_MARGIN - 1)


