GUIDE_GAP_SIZE_RANGE = (1, 3)
GUIDE_MIN_SPAN_FOR_GAPS = 4

# Guide placement and source counts.
MIN_CROSS_SIZE, LARGE_CROSS_SIZE_MIN = 5, 11
LARGE_CROSS_MARGIN, SMALL_CROSS_MARGIN = 5, 2
