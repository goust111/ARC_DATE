    for _ in range(_MAX_ATTEMPTS):
        grid = _sample_grid()
        expected = np.concatenate((grid, np.fliplr(grid)), axis=1)
        if np.array_equal(main(grid), expected):
            return grid
    raise RuntimeError("failed to generate a valid 6d0aefbc input")

