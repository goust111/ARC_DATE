def _gen_template_masks(n: int, k: int) -> list[np.ndarray]:
    """Return full-bbox masks with the required 4-connected component count."""
    key = (int(n), int(k))
    if key in _GEN_MASK_CACHE:
        return _GEN_MASK_CACHE[key]

    masks: list[np.ndarray] = []
