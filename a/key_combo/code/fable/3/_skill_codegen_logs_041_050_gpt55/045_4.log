    for h in range(h0, _GEN_CANVAS_MAX_H + 1):
        for w in range(w0, _GEN_CANVAS_MAX_W + 1):
            bg_area = h * w - int(mask_area) - int(template_area)
            if bg_area > mask_area:
                choices.append((h, w))
