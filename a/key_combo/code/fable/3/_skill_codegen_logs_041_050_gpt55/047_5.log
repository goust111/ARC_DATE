+    r1, c1 = p1
+    r2, c2 = p2
+    dr = abs(int(r1) - int(r2))
+    dc = abs(int(c1) - int(c2))
+    H, W = shape
+
+    if mode == "same_row":
+        return dr == 0
+    if mode == "same_col":
+        return dc == 0
+    if mode == "diagonal":
