+def _make_grid(H: int, W: int, cols: list[int], heights: list[int], colors: list[int]) -> np.ndarray:
+    grid = np.full((H, W), BLACK, dtype=int)
+    grid[H - 1, cols[0] - 1] = RED
+    for c, h, color in zip(cols, heights, colors):
