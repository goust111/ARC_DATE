+    infos: list[dict] = []
+    for key, comps in groups.items():
+        color = key[0]
+        mask = masks[key]
+        count = len(comps)
+        area = int(mask.sum())
+        layout = _layout_mask(comps, mask.shape) if count == area and count > 1 else None
+        self_similar = layout is not None and bool(np.array_equal(layout, mask))
+        infos.append(
+            {
+                "key": key,
+                "color": color,
+                "mask": mask,
+                "components": comps,
+                "count": count,
+                "area": area,
+                "layout": layout,
+                "self_similar": self_similar,
+            }
+        )
+    return infos
