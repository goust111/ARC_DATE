+
+    for sr in range(h):
+        for sc in range(w):
+            color = int(grid[sr, sc])
+            if color == bg or seen[sr, sc]:
+                continue
+
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in NEIGHBORS8:
+                    nr, nc = r + dr, c + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            out.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                    "mask": _component_mask(arr),
+                }
+            )
+    return out
