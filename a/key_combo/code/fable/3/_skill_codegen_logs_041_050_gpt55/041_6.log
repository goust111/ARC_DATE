+def _frame_id_grid(shape: tuple[int, int], frames: list[dict]) -> np.ndarray:
+    ids = np.full(shape, -1, dtype=int)
+    for idx, frame in enumerate(frames):
+        coords = frame["coords"]
+        ids[coords[:, 0], coords[:, 1]] = idx
+    return ids
