+    w = c1 - c0 + 1
+    if h < 5 or w < 5 or h % 2 == 0 or w % 2 == 0:
+        return None
+    if int(coords.shape[0]) != 2 * h + 2 * w - 4:
+        return None
+
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(local, border):
