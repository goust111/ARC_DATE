+    col_count = max(c for _r, c in lattice) + 1
+
+    min_h = 2 * GEN_HALF_MAX + 1 + (row_count - 1) * GEN_MIN_CENTER_GAP
+    min_w = 2 * GEN_HALF_MAX + 1 + (col_count - 1) * GEN_MIN_CENTER_GAP
