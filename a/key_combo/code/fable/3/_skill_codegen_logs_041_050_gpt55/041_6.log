+    out = g.copy()
+    for frame, target_idx in zip(frames, targets):
+        r0, c0, r1, c1 = frame["bbox"]
+        fill_color = int(frames[int(target_idx)]["pointer_color"])
+        black_interior = g[r0 + 1 : r1, c0 + 1 : c1] == BG
+        view = out[r0 + 1 : r1, c0 + 1 : c1]
