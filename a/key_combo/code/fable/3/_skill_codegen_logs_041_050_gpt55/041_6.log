+
+def _ray_target(ids: np.ndarray, source_idx: int, frame: dict) -> int:
+    h, w = ids.shape
+    cr, cc = frame["center"]
+    dr, dc = frame["direction"]
+    r, c = cr + dr, cc + dc
+    while 0 <= r < h and 0 <= c < w:
+        hit = int(ids[r, c])
+        if hit >= 0 and hit != int(source_idx):
+            return hit
+        r += dr
+        c += dc
+    raise AssertionError("each pointer ray must hit another frame")
