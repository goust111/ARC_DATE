+    orientations.extend(random.choice(["h", "v"]) for _ in range(count - 2))
+    random.shuffle(orientations)
+
+    mirrors: dict[tuple[int, int], str] = {}
+    used_h_rows: set[int] = set()
+    used_v_cols: set[int] = set()
+
+    for orient in orientations:
+        placed = False
+        for _ in range(100):
