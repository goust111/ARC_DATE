+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _is_source_edge(shape: tuple[int, int], r: int, c: int) -> bool:
+    del shape
+    return r == 0 or c == 0
+
