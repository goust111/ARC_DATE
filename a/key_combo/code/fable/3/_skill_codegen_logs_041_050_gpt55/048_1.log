+        try:
+            out = main(g)
+        except AssertionError:
+            continue
+        if out.shape == g.shape and max(out.shape) <= 30:
+            return g
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
