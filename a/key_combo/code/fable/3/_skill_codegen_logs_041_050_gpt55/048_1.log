+    components: list[set[tuple[int, int]]] = []
+
+    for start in sorted(green):
+        if start in seen:
+            continue
+        stack = [start]
+        seen.add(start)
+        comp: set[tuple[int, int]] = set()
+        while stack:
+            r, c = stack.pop()
+            comp.add((r, c))
+            for dr, dc in DIAGONALS:
+                nb = (r + dr, c + dc)
