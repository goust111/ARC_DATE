    r0, c0, r1, c1 = _bbox(hole)
    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    crop_hole = hole[r0 : r1 + 1, c0 : c1 + 1]
    out[crop_hole] = full[r0 : r1 + 1, c0 : c1 + 1][crop_hole]
    return out



