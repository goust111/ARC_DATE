+    Key insight:
+    - The neighboring tiles are mirror copies, not plain translations, and the
+      black hole is the foreground shape to extract rather than a blemish to hide.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
