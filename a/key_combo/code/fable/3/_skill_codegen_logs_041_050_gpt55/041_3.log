+    min_cells = max(5, box_h + box_w - 2)
+    max_cells = max(min_cells, min(area - 2, (area * 2) // 3))
+    for _ in range(200):
+        target = random.randint(min_cells, max_cells)
+        cells = {(random.randrange(box_h), random.randrange(box_w))}
