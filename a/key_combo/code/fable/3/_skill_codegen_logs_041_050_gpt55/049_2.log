        max_turns = min(
            _GEN_MAX_TURNS,
            max_shift,
            _GEN_PATH_MAX_CELLS - up_steps,
            _GEN_MAX_RIGHT_PER_UP_STEP * up_steps,
        )
        if min_turns <= max_turns:
            feasible.append((up_steps, min_turns, max_turns))
    if not feasible:
