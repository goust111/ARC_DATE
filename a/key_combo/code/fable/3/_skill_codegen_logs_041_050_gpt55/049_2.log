+    seen = np.zeros(mask.shape, dtype=bool)
+    out: list[np.ndarray] = []
+    for sr, sc in np.argwhere(mask):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords: list[Coord] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
