GRID_SIZE_RANGE, RECT_SIDE_RANGE = (15, 22), (4, 7)
RECT_AREA_FRACTION_RANGE = (0.06, 0.10)
RECT_EDGE_MARGIN = 1
GENERATION_RETRY_LIMIT = 300
# Noise palette, density, and optional secondary-color rates.
