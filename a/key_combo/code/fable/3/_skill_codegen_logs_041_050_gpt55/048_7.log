+        assert int(rows[-1] - rows[0] + 1) == int(rows.size), "rail pixels must be contiguous"
+        spans.append((int(rows[0]), int(rows[-1])))
+
+    assert spans[0] == spans[1], "the two rails must cover the same row range"
