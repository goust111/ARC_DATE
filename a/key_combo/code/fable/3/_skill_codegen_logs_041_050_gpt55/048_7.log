+            ok = True
+            for c in range(w):
+                unit_c = _phase_to_unit_col(c + shift, period_w)
+                for r in np.flatnonzero(known[:, c]):
+                    v = int(strip[int(r), c])
+                    old = int(unit[int(r), unit_c])
+                    if old == -1:
