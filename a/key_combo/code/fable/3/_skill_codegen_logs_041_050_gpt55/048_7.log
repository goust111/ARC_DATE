    )
    return bg, axis_color, mirror_color, nonmirror_color


def _gen_reflect_mirror_cells(
    out: np.ndarray, mirror_cells: list[tuple[int, int]], axis_kind: str, bg: int, mirror_color: int
) -> list[tuple[int, int]] | None:
