+        for _ in range(GENERATION_ATTEMPTS):
+            grid = _gen_attempt(branch)
+            if grid is not None:
+                return grid
+    raise RuntimeError("failed to generate a valid glide-period rail crop input")
+
+
+if __name__ == "__main__":
+    sigs = set()
+    for _ in range(10):
