+    preferred = BRANCHES[_GEN_CALL_COUNT % len(BRANCHES)]
+    _GEN_CALL_COUNT += 1
+    branches = [preferred] + random.sample(list(BRANCHES), len(BRANCHES))
+    for branch in branches:
+        for _ in range(GENERATION_ATTEMPTS):
