BG = 7
PALETTE = tuple(range(10))
# Canvas and cross-axis bounds.
GRID_SIZE_RANGE = (8, 17)
AXIS_ROW_RANGE = (4, 6)
AXIS_COL_RANGE = (3, 8)
AXIS_END_MARGIN = 4
# Marker placement constraints.
