+        if len(_recolor_pairs(inp, base, rec_box)) != 1 or _phase_shifts(inp, tile, rec_box):
+            continue
+        if len(_phase_shifts(inp, tile, phase_box)) != 1 or _recolor_pairs(inp, base, phase_box):
