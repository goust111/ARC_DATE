+    edge_bias = random.random()
+    if edge_bias < 0.18:
+        r0 = random.choice([0, height - box_h])
+    else:
+        r0 = random.randint(0, height - box_h)
+    if edge_bias > 0.82:
+        c0 = random.choice([0, width - box_w])
+    else:
+        c0 = random.randint(0, width - box_w)
+    return int(r0), int(c0), int(r0 + box_h - 1), int(c0 + box_w - 1)
