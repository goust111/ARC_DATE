+
+    occ_total = distractor_count + random.randint(0, min(3, distractor_count))
+    occluders = _choose_occluders(local_mask, occ_total)
+    if occluders is None:
+        return None
+
+    visible_local = local_mask.copy()
+    for r, c in occluders:
