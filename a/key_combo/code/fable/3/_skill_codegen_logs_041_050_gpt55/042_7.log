+        r0 = mr * (CELL_SIZE + SEP_SIZE)
+        for mc in range(macro_cols):
+            c0 = mc * (CELL_SIZE + SEP_SIZE)
+            grid[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE] = BLACK
