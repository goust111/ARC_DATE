+        positions: list[Coord] = [start]
+        directions: list[Coord] = []
+        used: set[Coord] = {start}
+        forbidden_pointer_cells: set[Coord] = set()
+        used_dirs: set[Coord] = set()
+        failed = False
+
+        for _step in range(pointer_count - 1):
