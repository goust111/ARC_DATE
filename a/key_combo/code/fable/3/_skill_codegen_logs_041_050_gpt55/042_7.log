+        int(g[0, c])
+        for c in range(g.shape[1])
+        if np.all(g[:, c] == g[0, c])
+    }
+    candidates = row_colors & col_colors
+    assert len(candidates) == 1, "expected one full-row/full-column separator color"
+    separator = candidates.pop()
