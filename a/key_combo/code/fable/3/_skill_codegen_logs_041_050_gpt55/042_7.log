+        c0 = mc * (CELL_SIZE + SEP_SIZE)
+        grid[r0 + 1 + dr, c0 + 1 + dc] = BLUE
+    return grid
+
+
+def _expected_from_macro(
+    grid: np.ndarray,
+    macro_rows: int,
+    macro_cols: int,
+    pointer_dirs: dict[Coord, Coord],
