+    ):
+        start, end = _sample_vertical_span(sr, v_band)
+        bars.append(
+            {
+                "direction": "left",
+                "orientation": "v",
+                "axis": col,
+                "start": start,
+                "end": end,
+                "color": color,
+            }
+        )
+    for col, color in zip(
