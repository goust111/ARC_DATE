+    sr, sc = seed
+    h, w = grid.shape
+
+    for name, (dr, dc) in DIRS.items():
+        current = seed_color
+        bars = rays[name]
+        bar_idx = 0
+        rr, cc = sr + dr, sc + dc
+
+        while 0 <= rr < h and 0 <= cc < w:
+            if bar_idx < len(bars):
+                bar = bars[bar_idx]
+                hit = (dr != 0 and rr == bar["axis"]) or (dc != 0 and cc == bar["axis"])
