+                "direction": "up",
+                "orientation": "h",
+                "axis": row,
+                "start": start,
+                "end": end,
+                "color": color,
+            }
+        )
+    for row, color in zip(
+        _sample_spaced_positions(sr + v_band + 2, h - 2, counts["down"]),
+        sequences["down"],
+    ):
+        start, end = _sample_horizontal_span(sc, h_band)
+        bars.append(
