+
+
+def _paint_wall(grid: np.ndarray, side: str, color: int) -> None:
+    if side == "top":
+        grid[0, :] = color
+    elif side == "bottom":
+        grid[-1, :] = color
+    elif side == "left":
+        grid[:, 0] = color
+    elif side == "right":
+        grid[:, -1] = color
+    else:
+        raise AssertionError(f"unknown side: {side}")
+
+
+def _detect_wall(grid: np.ndarray) -> tuple[str, int]:
+    H, W = grid.shape
+    edges = {
+        "top": grid[0, :],
+        "bottom": grid[H - 1, :],
+        "left": grid[:, 0],
+        "right": grid[:, W - 1],
+    }
