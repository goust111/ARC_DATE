+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < H and 0 <= nc < W):
+                continue
+            if (nr, nc) in candidate:
+                continue
+            if occupied[nr, nc] and (r, c, nr, nc) not in allowed_neighbors:
+                return False
+
