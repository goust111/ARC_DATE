    """
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    return bbox_coords(coords)


def bbox_mask(mask: np.ndarray) -> np.ndarray:
    """
    Return a boolean mask that is True exactly inside the bbox of `mask`.

