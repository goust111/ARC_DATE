+    if direction == "L":
+        for r in range(r0, r1 + 1):
+            allowed_neighbors.add((r, c0, r, c0 - 1))
+    elif direction == "R":
+        for r in range(r0, r1 + 1):
+            allowed_neighbors.add((r, c1, r, c1 + 1))
+    elif direction == "U":
+        for c in range(c0, c1 + 1):
+            allowed_neighbors.add((r0, c, r0 - 1, c))
+    else:
