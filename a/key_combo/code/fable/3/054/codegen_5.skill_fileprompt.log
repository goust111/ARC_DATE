+GEN_HEIGHT_RANGE = (18, 26)
+GEN_WIDTH_RANGE = (18, 26)
+GEN_WALL_SIDES = ("left", "right", "bottom")
+GEN_SLIDER_COUNT_RANGE = (3, 5)
+GEN_MIN_SIDE = 2
+GEN_MAX_SHORT = 4
+GEN_MAX_LONG = 5
+GEN_MIN_TRAIL = 2
+GEN_ATTEMPTS = 400
