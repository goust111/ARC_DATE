+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+CHANNEL = 8
+MARKER = 4
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
