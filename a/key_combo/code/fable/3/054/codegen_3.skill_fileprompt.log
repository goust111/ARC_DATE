+    for coords in _iter_components(g == GREY, connectivity=8):
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        crop = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        if _classify_mask(crop == GREY) == target_symmetry:
+            matches.append(crop)
