+def _orbit_adjacent(mask: np.ndarray, orbit: tuple[tuple[int, int], ...]) -> bool:
+    for r, c in orbit:
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
