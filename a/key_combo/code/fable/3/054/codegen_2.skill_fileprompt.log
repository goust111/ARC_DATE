+        axes = {"v" if dr else "h" for (dr, _dc), _length in trace}
+        if len(axes) < 2:
+            continue
+        return start, trace
+
+    return None
+
+
+def _trace_cells(
+    start: tuple[int, int],
+    trace: list[tuple[tuple[int, int], int]],
