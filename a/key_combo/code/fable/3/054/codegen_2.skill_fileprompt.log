+    bar_cols: dict[int, int] = {}
+    for c in range(w):
+        color = int(grid[h - 1, c])
+        if color in (bg, START, HEAD):
+            continue
+        if color in bar_lengths:
+            continue
+        length = 0
+        r = h - 1
+        while r >= 0 and int(grid[r, c]) == color:
+            length += 1
+            r -= 1
+        bar_lengths[color] = int(length)
+        bar_cols[color] = int(c)
+    return bar_lengths, bar_cols
+
+
+def _decode_segment(
+    grid: np.ndarray,
+    color: int,
+    bar_len: int,
+    bar_col: int,
