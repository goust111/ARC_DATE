+    col_lines = [idx * (cell_w + 1) for idx in range(chamber_cols + 1)]
+    grid[row_lines, :] = LATTICE
+    grid[:, col_lines] = LATTICE
+    return grid, row_lines, col_lines
+
+
+def _pick_layout() -> tuple[int, int, int, int]:
