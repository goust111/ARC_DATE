    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg, row_lines, col_lines, sprite_info, markers = _parse_chambers(g)
    sprite_r, sprite_c, _sprite_color, sprite_patch = sprite_info

    out = g.copy()
