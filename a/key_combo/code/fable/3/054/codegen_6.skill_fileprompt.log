+import random
+
+import numpy as np
+
+
+BG = 0
+LATTICE = 8
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
