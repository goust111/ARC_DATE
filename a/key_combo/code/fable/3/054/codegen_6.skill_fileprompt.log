        rendered = sprite_patch.copy()
        if abs(chamber_r - sprite_r) % 2 == 1:
            rendered = np.flipud(rendered)
        if abs(chamber_c - sprite_c) % 2 == 1:
            rendered = np.fliplr(rendered)

