+) -> None:
+    r, c = map(int, start)
+    h, w = out.shape
+
+    for index, (color, length) in enumerate(segments):
+        step = 1 if int(color) == RED else -1
+        dr, dc = (0, step) if index % 2 == 0 else (step, 0)
+        for _ in range(int(length)):
+            r += dr
+            c += dc
+            assert 0 <= r < h and 0 <= c < w, "decoded trace left the grid"
+            out[r, c] = int(color)
