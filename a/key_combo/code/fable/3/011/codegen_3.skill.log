                _claim_range(
                    g,
                    claims,
                    (side_r, mc),
                    (mr + dr, mc),
                    (dr, 0),
                    (mr, mc),
                    color,
                    bg,
                )

            clears.add((mr, mc))

    assert not (set(claims) & clears)

    out = g.copy()
    for (r, c), color in claims.items():
        out[r, c] = color
    for r, c in clears:
        out[r, c] = bg
    return out

