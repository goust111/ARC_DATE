                    _claim(g, claims, (rr, side_c), color, bg)
                for rr in (mr - 1, mr + 1):
                    _claim(g, claims, (rr, mc), color, bg)
                _claim_range(
                    g,
                    claims,
                    (mr, side_c),
                    (mr, mc + dc),
                    (0, dc),
                    (mr, mc),
                    color,
