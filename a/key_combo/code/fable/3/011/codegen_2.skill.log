+def _count_gate_segments(gates: np.ndarray) -> int:
+    count = 0
+    h, w = gates.shape
+    for r in range(1, h):
+        c = 1
+        while c < w - 1:
+            if int(gates[r, c]) < 0:
+                c += 1
+                continue
+            count += 1
+            color = int(gates[r, c])
+            while c + 1 < w - 1 and int(gates[r, c + 1]) == color:
