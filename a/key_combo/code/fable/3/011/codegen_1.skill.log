import numpy as np

_ARC_UTILS = Path('/home/lixinyu/snap/new/solvers')
if str(_ARC_UTILS) not in sys.path:
    sys.path.append(str(_ARC_UTILS))
from arc_utils import components_mask, get_bg

SEG_W = 3
MAX_ATTEMPTS = 500

def top_water_color(g,bg):
    cols = {int(v) for v in g[0] if int(v) "'!= int(bg)}
    assert len(cols) == 1
    return next(iter(cols))

def shelf_color(g,bg,water):
    cols = {int(v) for v in g.ravel() if int(v) not in {int(bg), int(water)}}
    assert len(cols) == 1
    return next(iter(cols))

def row_min_period(row):
    W = len(row)
    if not np.any(row):
        return None
    for p in range(1, W // 2 + 1):
        ok = True
        for c in range(W - p):
            if bool(row[c]) != bool(row[c + p]):
                ok = False
                break
        if ok:
            return p
    return None

def infer_period(g, shelf):
    periods = []
    for r in range(g.shape[0]):
        row = (g[r] == shelf)
        p = row_min_period(row)
        if p is not None:
            periods.append(p)
    assert periods
    cnt = Counter(periods)
    best = max(cnt.values())
    cand = [p for p, n in cnt.items() if n == best]
    assert best >= 2, (periods, cnt)
    assert len(cand) == 1, (periods, cnt)
    return cand[0]

def infer_intended(g, shelf, p):
    H, W = g.shape
    intended = np.zeros((H, W), dtype=bool)
    for r in range(H):
        cols = np.flatnonzero(g[r] == shelf)
        if cols.size == 0:
            continue
        residues = {int(c % p) for c in cols}
        intended[r] = np.array([(c % p) in residues for c in range(W)], dtype=bool)
    return intended

def segment_bounds(mask_row, c):
    a = int(c)
    while a - 1 >= 0 and bool(mask_row[a - 1]):
        a -= 1
    b = int(c)
    while b + 1 < len(mask_row) and bool(mask_row[b + 1]):
        b += 1
    return a, b

def source_starts(g, water):
    starts = []
    for coords in components_mask(g == water, connectivity=8):
        if coords.size == 0 or not bool((coords[:, 0] == 0).any()):
            continue
        rmax = int(coords[:, 0].max())
        cols = sorted({int(c) for r, c in coords if int(r) == rmax})
        starts.extend((rmax, c) for c in cols)
    starts.sort()
    return starts

def simulate(grid, intended, water, shelf, sources):
    g = np.asarray(grid, dtype=int)
    out = g.copy()
    H, W = g.shape
    q = deque((int(r), int(c)) for r, c in sources)
    seen = set()
    stats = {'"'leaks': 0, 'overflows': 0, 'filled_gaps': set(), 'gap_cells': set(), 'overflow_cells': set()}
    gap_coords = {(int(r), int(c)) for r, c in np.argwhere(intended & (g "'!= shelf))}
    stats['"'gap_cells'] = set(gap_coords)

    def spread_side(spread_r, shelf_r, start_c, step):
        c = int(start_c)
        while True:
            nxt = c + step
            if not (0 <= nxt < W):
                return
            if out[spread_r, nxt] == water:
                return
            out[spread_r, nxt] = water
            if intended[shelf_r, nxt]:
                if g[shelf_r, nxt] "'!= shelf:
                    out[shelf_r, nxt] = water
                    q.append((shelf_r, nxt))
                    stats['"'leaks'] += 1
                    stats['filled_gaps'].add((shelf_r, nxt))
                    return
                c = nxt
                continue
            stats['overflows'] += 1
            stats['overflow_cells'].add((spread_r, nxt))
            q.append((spread_r, nxt))
            return

    while q:
        rr, cc = q.popleft()
        rr = int(rr); cc = int(cc)
        if (rr, cc) in seen:
            continue
        seen.add((rr, cc))
        if out[rr, cc] "'!= water:
            assert g[rr, cc] != shelf
            out[rr, cc] = water
        while True:
            nr = rr + 1
            if nr >= H:
                break
            if out[nr, cc] == water:
                break
            if g[nr, cc] == shelf:
                assert intended[nr, cc]
                spread_side(rr, nr, cc, -1)
                spread_side(rr, nr, cc, 1)
                break
            rr = nr
            out[rr, cc] = water
    return out, stats


def gen_attempt():
    bg, shelf, water = random.sample(range(10), 3)
    P = random.randint(5, 8)
    K_options = [k for k in (3, 4) if k * P <= 30]
    K = random.choice(K_options)
    W = K * P
    R = random.choice([4, 5])
    y = random.randint(4, 6)
    rows = [y]
    for _ in range(R - 1):
        rows.append(rows[-1] + random.randint(3, 5))
    H = rows[-1] + random.randint(3, 5)
    if H > 30:
        return None
    corrupted_path = 2 if R == 5 and random.random() < 0.45 else 1
    active0_copy = 1 if K == 3 else random.randint(1, K - 2)
    offset0 = random.randint(0, P - SEG_W)
    active_cols = [active0_copy * P + offset0 + SEG_W - 1]
    for _ in range(corrupted_path):
        active_cols.append(active_cols[-1] - 1)
    intended = np.zeros((H, W), dtype=bool)
    offsets = {}
    for i, r in enumerate(rows):
        if i < len(active_cols):
            offsets[r] = (active_cols[i] - (SEG_W - 1)) % P
        else:
            offsets[r] = random.randint(0, P - 1)
        off = offsets[r]
        for c in range(W):
            if (c - off) % P < SEG_W:
                intended[r, c] = True
    grid = np.full((H, W), bg, dtype=int)
    grid[intended] = shelf
    gap_cells = set()
    for i in range(corrupted_path):
        r = rows[i]
        gap_c = active_cols[i] - 1
        if grid[r, gap_c] != shelf:
            return None
        grid[r, gap_c] = bg
        gap_cells.add((r, gap_c))
    extra_row = rows[-1]
    dormant_copy = K - 1
    dormant_gap = dormant_copy * P + (offsets[extra_row] + 1) % P
    if intended[extra_row, dormant_gap] and (extra_row, dormant_gap) not in gap_cells:
        grid[extra_row, dormant_gap] = bg
        gap_cells.add((extra_row, dormant_gap))
    if len(gap_cells) < corrupted_path + 1:
        return None
    num_sources = 1 if random.random() < 0.65 else 2
    source_cols = {active_cols[0]}
    if num_sources == 2:
        choices = []
        for copy_idx in range(K - 1):
            for off in range(P - SEG_W + 1):
                c = copy_idx * P + off + SEG_W - 1
                if c == active_cols[0]:
                    continue
                if abs(c - active_cols[0]) >= 2:
                    choices.append(c)
        if choices:
            source_cols.add(random.choice(choices))
    for c in sorted(source_cols):
        stem_h = random.choice([1, 2])
        grid[:stem_h, c] = water
    p = infer_period(grid, shelf)
    if p != P:
        return None
    inferred = infer_intended(grid, shelf, p)
    starts = source_starts(grid, water)
    out, stats = simulate(grid, intended, water, shelf, starts)
    out2, stats2 = simulate(grid, inferred, water, shelf, starts)
    if not np.array_equal(out, out2):
        return None
    if stats['"'leaks'] < 1 or stats['overflows'] < 1:
        return None
    if not (stats['gap_cells'] - stats['filled_gaps']):
        return None
    added_water = int(np.count_nonzero(out == water) - np.count_nonzero(grid == water))
    if added_water < 8 or added_water > (H * W) // 3:
        return None
    return grid, out, P, stats

ok = 0
for i in range(200):
    res = gen_attempt()
    if res is not None:
        ok += 1
print('ok', ok)
assert ok > 80
for _ in range(20):
    grid, out, P, stats = gen_attempt()
    bg = get_bg(grid)
    water = top_water_color(grid, bg)
    shelf = shelf_color(grid, bg, water)
    p = infer_period(grid, shelf)
    intended = infer_intended(grid, shelf, p)
    starts = source_starts(grid, water)
    out2, _ = simulate(grid, intended, water, shelf, starts)
    assert np.array_equal(out, out2)
print('sample ok')
