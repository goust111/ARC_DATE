+    for piece in layout:
+        cells = frozenset((r - r0, c - c0) for r, c in piece["cells"])
+        for rr, cc in cells:
+            mask[rr, cc] = True
+        shifted.append({"family": piece["family"], "cells": cells})
+    return mask, shifted
