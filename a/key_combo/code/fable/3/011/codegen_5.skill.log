+
+
+def _stamp_cells_at_corner(stamp: np.ndarray, corner: str, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    sh, sw = stamp.shape
+    if corner == "tl":
+        r0, c0 = 0, 0
+    elif corner == "tr":
+        r0, c0 = 0, w - sw
+    elif corner == "bl":
+        r0, c0 = h - sh, 0
+    else:
+        r0, c0 = h - sh, w - sw
