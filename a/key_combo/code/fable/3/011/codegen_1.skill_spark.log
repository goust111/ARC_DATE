    non_edge_area = n * n - n
    lo = max(MAIN_MIN_PIXELS, math.ceil(MAIN_MIN_NON_EDGE_RATIO * non_edge_area))
    hi = min(MAIN_MAX_PIXELS, math.floor(MAIN_MAX_NON_EDGE_RATIO * non_edge_area))
    if lo > hi:
