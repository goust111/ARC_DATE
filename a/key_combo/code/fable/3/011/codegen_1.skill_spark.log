get_bg = _load_arc_utils()


# -----------------------------------------------------------------------------
# shared geometry helpers
# -----------------------------------------------------------------------------
def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    H, W = shape
    return 0 <= int(r) < H and 0 <= int(c) < W


def _row_segments(mask: np.ndarray) -> list[tuple[int, int]]:
    segments: list[tuple[int, int]] = []
    c = 0
    W = int(mask.shape[0])
    while c < W:
        if not bool(mask[c]):
            c += 1
            continue
        start = int(c)
        while c + 1 < W and bool(mask[c + 1]):
            c += 1
        segments.append((start, int(c)))
        c += 1
    return segments


def _find_segment(segments: list[tuple[int, int]], c: int) -> tuple[int, int] | None:
    c = int(c)
    for a, b in segments:
        if a <= c <= b:
            return a, b
    return None


def _expected_mask_for_residue_set(width: int, period: int, residues: Iterable[int]) -> np.ndarray:
    residues_set = {int(r) for r in residues}
    return np.array([(c % period) in residues_set for c in range(width)], dtype=bool)


def _infer_period_and_expected_shelf(g: np.ndarray, shelf: int, bg: int) -> tuple[int, dict[int, np.ndarray]]:
    H, W = g.shape
    shelf_rows = [r for r in range(H) if bool((g[r] == shelf).any())]
    assert shelf_rows, \"expected at least one shelf row\"

    max_p = max(2, min(W // 2, 12))
    best: tuple[int, int, int] | None = None
    best_info: dict[int, np.ndarray] | None = None

    for p in range(2, max_p + 1):
        row_expected: dict[int, np.ndarray] = {}
        total_missing = 0
        total_residues = 0

        for r in shelf_rows:
            cols = np.flatnonzero(g[r] == shelf)
            if cols.size == 0:
                continue

            residues = {int(c) % p for c in cols}
            if not residues:
                continue

            expected_row = _expected_mask_for_residue_set(W, p, residues)
            missing = int(np.sum(expected_row & (g[r] == bg)))
            row_expected[r] = expected_row
            total_missing += missing
            total_residues += len(residues)

        if not row_expected:
            continue

        # reject trivial full-fit candidates that contain no missing corrupted pixels,
        # because the puzzle relies on visible holes.
        if total_missing == 0:
            continue

        # prefer compact period descriptions and the smallest phase span first.
        score = (total_missing, total_residues, p)
        if best is None or score < best:
            best = score
            best_info = row_expected

    assert best_info is not None, \"failed to infer shelf period\"
    return int(best[2]), best_info


# -----------------------------------------------------------------------------
# simulation
# -----------------------------------------------------------------------------
def _spread_horizontally(
    row: int,
    source_c: int,
    shelf_row: int,
    segment: tuple[int, int],
    g: np.ndarray,
    out: np.ndarray,
    water: int,
    shelf: int,
    bg: int,
    seen: set[tuple[int, int]],
    q: deque[tuple[int, int]],
) -> None:
    W = int(g.shape[1])
    a, b = segment
    for dc in (-1, 1):
        c = int(source_c)
        while True:
            c += dc
            if c < 0 or c >= W:
                break

            # one cell beyond each real endpoint starts overflow.
            if c == a - 1 or c == b + 1:
                if int(out[row, c]) == int(bg):
                    out[row, c] = int(water)
                q.append((row, c))
                break

            # must stay within the same segment while spreading.
            if c < a or c > b:
                break

            if int(out[row, c]) == int(bg):
                out[row, c] = int(water)

            below = int(g[shelf_row, c])
            if below == int(shelf):
                continue

            # leak point: reaches corrupted gap of the true shelf line.
            if below == int(bg):
                if (row, c) not in seen:
                    q.append((row, c))
            # existing water or other obstacle blocks further spreading.
            break


def main(grid: np.ndarray) -> np.ndarray:
    \"\"\"Infer shelf periodicity and simulate phase-aware vertical water flow with spill-over and hole leaks.

    Input structure:
    - A background color is dominant.
    - There is one shelf color and one water color.
    - Water sources are one or more pixels on the top row.
    - Shelf rows are horizontal periodic patterns; some shelf pixels are missing and replaced by background.

    Rule:
    - Infer the global minimal horizontal period and each shelf row's periodic shelf phase from observed shelf pixels.
    - Treat missing periodic shelf pixels as genuine holes while keeping shelf pixels unchanged.
    - Simulate water falling from each top-source column: down through background, then spread across the shelf segment above.
    - While spreading, whichever side first touches a hole drops vertically from that point; otherwise each side turns down one cell past the real segment end.
    - Every resumed vertical path repeats until leaving the grid or touching existing water/shelf support.

    Key insight:
    - The phase of the periodic shelf reconstruction is needed to distinguish a true shelf gap (which leaks) from outside background (which overflows).
    \"\"\"
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    assert g.ndim == 2 and H > 0 and W > 0, \"expected non-empty 2D grid\"

    bg = get_bg(g)
    counts = Counter(map(int, g.ravel()))
    non = [int(c) for c in counts if int(c) "'!= int(bg)]
    assert len(non) >= 2, "expected at least one shelf color and one water color"

    # one color is the scarce water, the other is the dominant shelf color.
    water = int(sorted(non, key=lambda c: (counts[c], c))[0])
    shelf_candidates = [c for c in non if c != water]
    assert shelf_candidates, "expected a shelf color distinct from water"
    shelf = int(shelf_candidates[0] if len(shelf_candidates) == 1 else max(shelf_candidates, key=lambda c: counts[c]))

    period, expected_rows = _infer_period_and_expected_shelf(g, shelf, bg)
    _ = period  # retained for readability/debugging

    expected_segments = {r: _row_segments(mask) for r, mask in expected_rows.items()}

    out = g.copy()
    sources = [(0, int(c)) for c in np.flatnonzero(g[0] == water)]
    assert sources, "expected at least one top-row water source"

    q: deque[tuple[int, int]] = deque(sources)
    seen: set[tuple[int, int]] = set()

    while q:
        r, c = q.popleft()
        if not _in_bounds((H, W), r, c) or (r, c) in seen:
            continue
        seen.add((r, c))

        while True:
            if not _in_bounds((H, W), r, c):
                break

            if int(out[r, c]) != int(water):
                out[r, c] = int(water)

            nr = int(r + 1)
            if nr >= H:
                break

            below = int(g[nr, c])
            if below == int(water):
                break

            if below == int(shelf):
                segs = expected_segments.get(nr)
                assert segs is not None, "expected row should have periodic shelf reconstruction"
                segment = _find_segment(segs, c)
                assert segment is not None, "water should only spill from a shelf segment"
                _spread_horizontally(
                    row=r,
                    source_c=c,
                    shelf_row=nr,
                    segment=segment,
                    g=g,
                    out=out,
                    water=water,
                    shelf=shelf,
                    bg=bg,
                    seen=seen,
                    q=q,
                )
                break

            if below != int(bg):
                # Unknown obstacle colors are not part of the task spec; stop path.
                break

            r = nr

    return out


# -----------------------------------------------------------------------------
# generator
# -----------------------------------------------------------------------------
def _has_smaller_period(pattern: np.ndarray) -> bool:
    m = len(pattern)
    for p in range(1, m // 2 + 1):
        if m % p:
            continue
        ok = True
        for i in range(m - p):
            if int(pattern[i]) != int(pattern[i + p]):
                ok = False
                break
        if ok:
            return True
    return False


def _random_base_pattern(p: int) -> np.ndarray:
    """Generate a periodic run-mask without smaller period artifacts."""
    while True:
        x = np.zeros(p, dtype=int)
        start = random.randint(0, max(0, p - 2))
        run = random.randint(2, max(2, p - 1))
        end = min(p, start + run)

        x[start:end] = 1
        if random.random() < 0.45:
            # add one separated run to keep visual complexity.
            start2 = random.randint(0, p - 1)
            end2 = random.randint(start2 + 1, min(p, start2 + 3))
            if not (start2 <= end - 1 and start <= end2 - 1 and start2 < start):
                x[start2:end2] = 1

        if x.sum() == 0 or x.sum() == p:
            continue
        if _has_smaller_period(x):
            continue
        return x.astype(bool)


def _row_segments_from_mask(mask: np.ndarray) -> list[tuple[int, int]]:
    return _row_segments(mask)


def _choose_source_col(row_mask: np.ndarray, protected: set[tuple[int, int]]) -> int:
    candidates = [int(c) for c in np.flatnonzero(row_mask)]
    random.shuffle(candidates)
    for c in candidates:
        if (0, c) in protected:
            continue
        return c
    return int(candidates[0])


def _add_critical_leak(
    grid: np.ndarray,
    segments: list[tuple[int, int]],
    row: int,
    source_c: int,
    direction: int,
    palette_bg: int,
) -> tuple[int, int]:
    if direction not in (-1, 1):
        direction = 1

    seg = None
    for a, b in segments:
        if a <= source_c <= b:
            seg = (a, b)
            break
    if seg is None:
        raise RuntimeError("source not on shelf segment")

    a, b = seg
    pool = []
    c = source_c + direction
    if direction < 0:
        while c >= a:
            if int(grid[row, c]) != int(palette_bg):
                pool.append(c)
            c -= 1
    else:
        while c <= b:
            if int(grid[row, c]) != int(palette_bg):
                pool.append(c)
            c += 1

    if not pool:
        raise RuntimeError("no room to create leak from this source")

    hole_c = int(random.choice(pool))
    if grid[row, hole_c] == palette_bg:
        raise RuntimeError("chosen leak position already background")
    grid[row, hole_c] = int(palette_bg)
    return row, hole_c


def _candidate_inputs(
    H: int,
    W: int,
    palette: tuple[int, ...],
) -> np.ndarray:
    bg, shelf, water = [int(c) for c in random.sample(palette, 3)]

    p = random.randint(3, min(7, max(3, W // 2 - 1)))
    base = _random_base_pattern(p)

    # Build periodic shelf rows.
    shelf_rows_count = random.randint(3, min(6, max(3, H // 2)))
    rows = sorted(random.sample(range(2, H - 1), shelf_rows_count))

    grid = np.full((H, W), bg, dtype=int)

    tile = np.tile(base.astype(int), (W // len(base)) + 1)[:W]
    for r in rows:
        grid[r][tile == 1] = shelf

    first_row = rows[0]
    expected = tile == 1
    segments = _row_segments_from_mask(expected)
    if not segments:
        raise RuntimeError("no shelf segment generated")

    n_sources = random.choice([1, 2]) if len(cols := np.flatnonzero(expected)) > 4 else 1
    source_cols = []
    used = set[int]()
    protected: set[tuple[int, int]] = set()

    n_sources = 1 if len(segments) == 0 else max(1, min(2, n_sources))

    # Ensure one source per branch class when possible.
    branch_modes = ["leak", "overflow"]
    random.shuffle(branch_modes)
    mode_by_source = [branch_modes[i % 2] for i in range(n_sources)]

    for i in range(n_sources):
        # choose source inside the periodic segment area
        c = int(_choose_source_col(expected, protected))
        # keep sources apart for readability.
        while c in used and len(used) < len(np.flatnonzero(expected)):
            c = int(_choose_source_col(expected, protected))
        used.add(c)
        source_cols.append(c)

        # For overflow branch, keep a clean span to the edge on the chosen side.
        direction = -1 if random.random() < 0.5 else 1

        if mode_by_source[i] == "leak":
            hole_row, hole_c = _add_critical_leak(grid, segments, first_row, c, direction, bg)
            _ = hole_row
            _ = hole_c
        else:
            # Reserve all cells until this segment end to avoid accidental random holes.
            seg = None
            for a, b in segments:
                if a <= c <= b:
                    seg = (a, b)
                    break
            if seg is None:
                continue
            a, b = seg
            if direction < 0:
                protected.update({(first_row, cc) for cc in range(a - 1, c)})
            else:
                protected.update({(first_row, cc) for cc in range(c + 1, b + 2)})

    source_cols = sorted(source_cols)

    # add additional random holes (never on protected/mandatory shelf cells).
    shelf_cells = [(int(r), int(c)) for r in rows for c in np.flatnonzero(grid[r] == shelf)]
    hole_candidates = [(r, c) for r, c in shelf_cells if (r, c) not in protected and (r, c) not in zip([first_row] * len(source_cols), source_cols)]

    random.shuffle(hole_candidates)
    to_remove = random.randint(2, min(6, max(1, len(hole_candidates) // 6)))
    for r, c in hole_candidates[:to_remove]:
        if random.random() < 0.65:
            grid[r, c] = bg

    for c in source_cols:
        grid[0, c] = water

    # Keep top row only as sources.
    for r in range(1, first_row):
        grid[r, :] = np.where(grid[r, :] == water, bg, grid[r, :])

    # Reject degenerate cases: each shelf row should keep at least one pixel.
    for r in rows:
        if int((grid[r] == shelf).sum()) == 0:
            raise RuntimeError("all shelf removed from a shelf row")

    return grid


def generate_input() -> np.ndarray:
    """Generate a valid input for this puzzle.

    The generator alternates hole-leak and overflow conditions by branch mode,
    randomizes shelf period, branch count, source count, row layout, colors,
    and ensures all generated samples satisfy the assumptions required by `main`.
    """
    palette = tuple(range(10))
    for _ in range(400):
        H = random.randint(14, 28)
        W = random.randint(18, 30)
        try:
            inp = _candidate_inputs(H, W, palette)
        except Exception:
            continue

        try:
            out = main(inp)
        except Exception:
            continue

        if out.shape != inp.shape:
            continue
        if np.array_equal(out, inp):
            continue
        if int(inp.shape[0]) > 30 or int(inp.shape[1]) > 30:
            continue

        return inp

    raise RuntimeError("failed to generate valid 011 puzzle input after retries")
