-    dr, dc = DIRS[direction]
-    object_cells = {cell for obj in objects for cell in obj["coords"]}
-    steps = 0
-    while _in_bounds(shape, r, c):
-        if (r, c) in object_cells:
-            return False
-        steps += 1
-        r += dr
-        c += dc
-    return steps >= 3
