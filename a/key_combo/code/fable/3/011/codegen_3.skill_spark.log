+def _direction_from_centers(
+    obj_bbox: tuple[int, int, int, int],
+    hole_center: tuple[float, float],
+) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = map(float, obj_bbox)
+    obj_r, obj_c = (r0 + r1) / 2.0, (c0 + c1) / 2.0
+    hole_r, hole_c = hole_center
+    d_r = hole_r - obj_r
+    d_c = hole_c - obj_c
+    eps = 1e-9
+    if abs(d_r) > abs(d_c) + eps:
+        return (1 if d_r > 0 else -1, 0)
+    if abs(d_c) > abs(d_r) + eps:
+        return (0, 1 if d_c > 0 else -1)
