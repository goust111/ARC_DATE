Cell = tuple[int, int]
MarkerPair = tuple[Cell, Cell]


def _edge_direction(edge: str) -> tuple[int, int]:
    return EDGE_DIRECTIONS[edge]


def _paint_edge(g: np.ndarray, edge: str, color: int) -> None:
    if edge == "top":
        g[0, :] = color
    elif edge == "bottom":
        g[-1, :] = color
    elif edge == "left":
        g[:, 0] = color
    else:
        g[:, -1] = color


