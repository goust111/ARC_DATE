+def _direction_from_centers(
+    obj_bbox: tuple[int, int, int, int],
+    hole_center: tuple[float, float],
+) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = map(float, obj_bbox)
+    cr, cc = (r0 + r1) / 2.0, (c0 + c1) / 2.0
+    hr, hc = hole_center
+    drow = hr - cr
+    dcol = hc - cc
+    if abs(drow) > abs(dcol):
+        if drow == 0:
+            return None
+        return (1 if drow > 0 else -1, 0)
+    if abs(dcol) > abs(drow):
+        if dcol == 0:
+            return None
+        return (0, 1 if dcol > 0 else -1)
