from __future__ import annotations

import importlib.util
from collections import Counter, deque
from pathlib import Path
import random
from typing import Iterable

import numpy as np


# -----------------------------------------------------------------------------
# arc_utils load (support direct SourceFileLoader execution)
# -----------------------------------------------------------------------------
def _load_arc_utils():
