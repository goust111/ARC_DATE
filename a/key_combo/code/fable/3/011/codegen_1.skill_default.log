+    return out
+
+
+def _segments_for_interval(width: int, period: int, start: int, end: int) -> list[Segment]:
+    spans: list[Segment] = []
+    for k in range((-period - end) // period, (width + period) // period + 1):
+        left = start + k * period
+        right = end + k * period
+        if 0 <= left and right < width:
+            spans.append((int(left), int(right)))
+    return spans
+
+
