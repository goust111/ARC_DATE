@@ -0,0 +1,474 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Segment = tuple[int, int]
+
+PALETTE = tuple(range(10))
+MAX_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _run_segments(row_mask: np.ndarray) -> list[Segment]:
+    spans: list[Segment] = []
+    c = 0
+    w = int(row_mask.shape[0])
+    while c < w:
+        if not bool(row_mask[c]):
+            c += 1
+            continue
+        left = c
+        while c + 1 < w and bool(row_mask[c + 1]):
+            c += 1
+        spans.append((int(left), int(c)))
+        c += 1
+    return spans
+
+
+def _role_colors(grid: np.ndarray) -> tuple[int, int, int]:
+    bg = _get_bg(grid)
+    top_colors = [int(c) for c in np.unique(grid[0]) if int(c) != bg]
+    assert len(top_colors) == 1, "expected a unique water color on the top edge"
+    water = int(top_colors[0])
+
+    others = [int(c) for c in np.unique(grid) if int(c) not in {bg, water}]
+    assert len(others) == 1, "expected exactly one shelf color besides water"
+    return int(bg), int(water), int(others[0])
+
+
+def _row_phase_interval(cols: list[int], period: int) -> tuple[int, int] | None:
+    phases = sorted({int(c) % int(period) for c in cols})
+    if not phases:
+        return None
+
+    best: tuple[int, int, int] | None = None
+    p = int(period)
+    for i, start in enumerate(phases):
+        prev = phases[i - 1] if i > 0 else phases[-1] - p
+        gap_before = start - prev - 1
+        end = start
+        for phase in phases:
+            value = phase
+            if value < start:
+                value += p
+            if value > end:
+                end = value
+        arc_len = end - start + 1
+        score = (arc_len, -gap_before, start)
+        if best is None or score < best:
+            best = score
+
+    assert best is not None
+    _arc_len, _gap_before, start = best
+    end = start + _arc_len - 1
+    if end >= p:
+        # The generator avoids wraparound shelf phases.  A wrapping candidate is
+        # ambiguous for row segments, so it is rejected during period search.
+        return None
+    return int(start), int(end)
+
+
+def _candidate_intended(
+    shape: tuple[int, int],
+    shelf_coords: np.ndarray,
+    shelf_rows: list[int],
+    period: int,
+) -> tuple[np.ndarray, int] | None:
+    h, w = shape
+    intended = np.zeros((h, w), dtype=bool)
+    holes = 0
+    p = int(period)
+
+    for r in shelf_rows:
+        cols = sorted(int(c) for rr, c in shelf_coords if int(rr) == int(r))
+        interval = _row_phase_interval(cols, p)
+        if interval is None:
+            return None
+        a, b = interval
+        width = b - a + 1
+        if width < 2 or width >= p:
+            return None
+
+        possible_repeats = 0
+        visible_repeats = 0
+        for k in range((-p - b) // p, (w + p) // p + 1):
+            left = a + k * p
+            right = b + k * p
+            if left < 0 or right >= w:
+                continue
+            possible_repeats += 1
+            intended[int(r), left : right + 1] = True
+            if np.any([c in range(left, right + 1) for c in cols]):
+                visible_repeats += 1
+
+        if possible_repeats < 2 or visible_repeats < 2:
+            return None
+
+    shelf_mask = np.zeros((h, w), dtype=bool)
+    for r, c in shelf_coords:
+        shelf_mask[int(r), int(c)] = True
+    if np.any(shelf_mask & ~intended):
+        return None
+    holes = int(np.count_nonzero(intended & ~shelf_mask))
+    return intended, holes
+
+
+def _infer_intended_shelves(grid: np.ndarray, shelf: int) -> tuple[int, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    shelf_coords = np.argwhere(g == int(shelf))
+    assert shelf_coords.size > 0, "expected shelf pixels"
+    shelf_rows = sorted({int(r) for r, _c in shelf_coords})
+
+    candidates: list[tuple[int, int, np.ndarray]] = []
+    for period in range(3, max(4, w // 2 + 1)):
+        result = _candidate_intended(g.shape, shelf_coords, shelf_rows, period)
+        if result is None:
+            continue
+        intended, holes = result
+        if holes < 1:
+            continue
+        candidates.append((int(holes), int(period), intended))
+
+    assert candidates, "expected a uniquely inferable horizontal period"
+    candidates.sort(key=lambda item: (item[0], item[1]))
+    best_holes, best_period, best_intended = candidates[0]
+    if len(candidates) > 1:
+        next_holes, next_period, _next_intended = candidates[1]
+        assert (best_holes, best_period) != (next_holes, next_period)
+    return int(best_period), best_intended
+
+
+def _segment_containing(segments: list[Segment], col: int) -> Segment | None:
+    c = int(col)
+    for left, right in segments:
+        if int(left) <= c <= int(right):
+            return int(left), int(right)
+    return None
+
+
+def _paint_if_open(out: np.ndarray, original: np.ndarray, r: int, c: int, water: int, shelf: int) -> None:
+    if 0 <= r < out.shape[0] and 0 <= c < out.shape[1] and int(original[r, c]) != int(shelf):
+        out[r, c] = int(water)
+
+
+def _simulate_water(
+    grid: np.ndarray,
+    water: int,
+    shelf: int,
+    intended: np.ndarray,
+    *,
+    collect_events: bool = False,
+) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    actual_shelf = g == int(shelf)
+    out = g.copy()
+    events = {"hole_leaks": 0, "overflows": 0, "hit_rows": set()}
+
+    intended_segments = [_run_segments(intended[r]) for r in range(h)]
+    sources = [(0, int(c)) for c in np.flatnonzero(g[0] == int(water))]
+    assert sources, "expected top-edge water sources"
+
+    q: deque[Coord] = deque(sources)
+    seen_starts: set[Coord] = set()
+
+    while q:
+        rr, cc = q.popleft()
+        rr = int(rr)
+        cc = int(cc)
+        if not (0 <= rr < h and 0 <= cc < w):
+            continue
+        if (rr, cc) in seen_starts:
+            continue
+        seen_starts.add((rr, cc))
+        if int(g[rr, cc]) == int(shelf):
+            continue
+
+        _paint_if_open(out, g, rr, cc, water, shelf)
+
+        while True:
+            nr = rr + 1
+            if nr >= h:
+                break
+            if int(out[nr, cc]) == int(water) and int(g[nr, cc]) != int(shelf):
+                break
+
+            if bool(actual_shelf[nr, cc]):
+                seg = _segment_containing(intended_segments[nr], cc)
+                assert seg is not None, "actual shelf must be inside the inferred shelf span"
+                left, right = seg
+                spread_r = rr
+                events["hit_rows"].add(int(nr))
+
+                _paint_if_open(out, g, spread_r, cc, water, shelf)
+                for dc in (-1, 1):
+                    x = cc
+                    while True:
+                        x += dc
+                        if x < left or x > right:
+                            overflow_c = left - 1 if dc < 0 else right + 1
+                            if 0 <= overflow_c < w:
+                                _paint_if_open(out, g, spread_r, overflow_c, water, shelf)
+                                events["overflows"] += 1
+                                q.append((int(spread_r), int(overflow_c)))
+                            break
+
+                        _paint_if_open(out, g, spread_r, x, water, shelf)
+                        if bool(intended[nr, x]) and not bool(actual_shelf[nr, x]):
+                            out[nr, x] = int(water)
+                            events["hole_leaks"] += 1
+                            q.append((int(nr), int(x)))
+                            break
+                break
+
+            rr = nr
+            _paint_if_open(out, g, rr, cc, water, shelf)
+
+    if not collect_events:
+        events = {}
+    return out, events
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Let top-edge water fall over phase-repaired shelves, leaking through inferred missing shelf pixels.
+
+    Input structure:
+    - The background is the most common color; a unique water color appears on the top edge.
+    - The other non-background color forms horizontal shelf fragments on several rows.
+    - All shelf rows share one smallest horizontal period, and some periodic shelf cells are erased to background as holes.
+
+    Rule:
+    - Infer the unique smallest horizontal period from the remaining shelf pixels, then reconstruct each row's intended repeated shelf spans.
+    - Water falls straight down through background cells until it hits a real shelf pixel.
+    - Above a hit shelf span, water spreads left and right; the first inferred hole on a side is filled and leaks downward, while a side with no hole overflows one cell beyond the true endpoint.
+    - Continue every leaked or overflowed stream recursively until it reaches the bottom or existing water.
+
+    Key insight:
+    - A background cell inside the periodic shelf phase is a leak, while an identical-looking background cell beyond the true endpoint is an overflow point.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30, "expected an ARC-sized 2D grid"
+    _bg, water, shelf = _role_colors(g)
+    _period, intended = _infer_intended_shelves(g, shelf)
+    out, _events = _simulate_water(g, water, shelf, intended)
+    return out
+
+
+def _phase_interval_containing(phase: int, period: int, length: int) -> tuple[int, int] | None:
+    phase = int(phase)
+    period = int(period)
+    length = int(length)
+    starts = [s for s in range(1, period - length) if s <= phase <= s + length - 1]
+    if not starts:
+        starts = [s for s in range(0, period - length + 1) if s <= phase <= s + length - 1]
+    if not starts:
+        return None
+    start = int(random.choice(starts))
+    return start, start + length - 1
+
+
+def _segments_for_interval(width: int, period: int, start: int, end: int) -> list[Segment]:
+    spans: list[Segment] = []
+    for k in range((-period - end) // period, (width + period) // period + 1):
+        left = start + k * period
+        right = end + k * period
+        if 0 <= left and right < width:
+            spans.append((int(left), int(right)))
+    return spans
+
+
+def _intended_from_rows(
+    shape: tuple[int, int],
+    rows: list[int],
+    intervals: dict[int, tuple[int, int]],
+    period: int,
+) -> np.ndarray:
+    h, w = shape
+    intended = np.zeros((h, w), dtype=bool)
+    for r in rows:
+        start, end = intervals[int(r)]
+        for left, right in _segments_for_interval(w, period, start, end):
+            intended[int(r), left : right + 1] = True
+    return intended
+
+
+def _choose_shelf_rows(height: int, count: int) -> list[int] | None:
+    rows: list[int] = []
+    candidates = list(range(3, height - 1))
+    random.shuffle(candidates)
+    for r in sorted(candidates):
+        if all(abs(r - old) >= 3 for old in rows):
+            rows.append(int(r))
+        if len(rows) == count:
+            return sorted(rows)
+    return None
+
+
+def _add_guarded_hole(
+    holes: set[Coord],
+    protected: set[Coord],
+    row: int,
+    left: int,
+    right: int,
+    preferred_side_of: int | None = None,
+) -> int | None:
+    choices = [
+        c
+        for c in range(int(left), int(right) + 1)
+        if (int(row), int(c)) not in protected
+    ]
+    if preferred_side_of is not None:
+        if random.random() < 0.5:
+            side = [c for c in choices if c < int(preferred_side_of)]
+        else:
+            side = [c for c in choices if c > int(preferred_side_of)]
+        if side:
+            choices = side
+    if not choices:
+        return None
+    c = int(random.choice(choices))
+    holes.add((int(row), c))
+    return c
+
+
+def _naive_actual_shelf_water(grid: np.ndarray, water: int, shelf: int) -> np.ndarray:
+    return _simulate_water(grid, water, shelf, grid == int(shelf))[0]
+
+
+def _build_candidate() -> tuple[np.ndarray, np.ndarray] | None:
+    height = random.randint(14, 24)
+    width = random.randint(21, 30)
+    period = random.randint(6, min(8, width // 3))
+    row_count = random.randint(3, min(5, max(3, (height - 4) // 3)))
+    shelf_rows = _choose_shelf_rows(height, row_count)
+    if shelf_rows is None:
+        return None
+
+    bg, water, shelf = random.sample(list(PALETTE), 3)
+    intervals: dict[int, tuple[int, int]] = {}
+    protected: set[Coord] = set()
+    holes: set[Coord] = set()
+
+    top_row = shelf_rows[0]
+    top_len = random.randint(3, period - 2)
+    top_start = random.randint(1, period - top_len - 1)
+    top_end = top_start + top_len - 1
+    intervals[top_row] = (top_start, top_end)
+    top_segments = _segments_for_interval(width, period, top_start, top_end)
+    top_segments = [seg for seg in top_segments if seg[0] > 0 and seg[1] < width - 1]
+    if not top_segments:
+        return None
+    top_left, top_right = random.choice(top_segments)
+    if top_right - top_left + 1 < 3:
+        return None
+
+    source_col = random.randint(top_left, top_right)
+    protected.add((top_row, source_col))
+    top_hole = _add_guarded_hole(holes, protected, top_row, top_left, top_right, source_col)
+    if top_hole is None:
+        return None
+    overflow_col = top_left - 1 if top_hole > source_col else top_right + 1
+    if not (0 <= overflow_col < width):
+        return None
+
+    catch_col = int(random.choice([top_hole, overflow_col]))
+    for i, row in enumerate(shelf_rows[1:], start=1):
+        if i == 1:
+            phase = catch_col % period
+            length = random.randint(3, period - 2)
+            interval = _phase_interval_containing(phase, period, length)
+            if interval is None:
+                return None
+            start, end = interval
+        else:
+            length = random.randint(3, period - 2)
+            start = random.randint(0, period - length)
+            end = start + length - 1
+        intervals[row] = (int(start), int(end))
+
+    intended = _intended_from_rows((height, width), shelf_rows, intervals, period)
+    if not bool(intended[top_row, source_col]):
+        return None
+    protected.add((top_row, source_col))
+    for row in shelf_rows[1:]:
+        if bool(intended[row, catch_col]):
+            protected.add((int(row), catch_col))
+            spans = _run_segments(intended[row])
+            seg = _segment_containing(spans, catch_col)
+            if seg is not None and random.random() < 0.75:
+                _add_guarded_hole(holes, protected, row, seg[0], seg[1], catch_col)
+            break
+
+    extra_holes = random.randint(1, 5)
+    intended_cells = [tuple(map(int, rc)) for rc in np.argwhere(intended)]
+    random.shuffle(intended_cells)
+    for r, c in intended_cells:
+        if extra_holes <= 0:
+            break
+        if (r, c) in holes or (r, c) in protected:
+            continue
+        start, end = intervals[int(r)]
+        phase = c % period
+        if phase in {start, end} and random.random() < 0.75:
+            continue
+        holes.add((int(r), int(c)))
+        extra_holes -= 1
+
+    grid = np.full((height, width), int(bg), dtype=int)
+    grid[intended] = int(shelf)
+    for r, c in holes:
+        grid[int(r), int(c)] = int(bg)
+    grid[0, source_col] = int(water)
+
+    if random.random() < 0.45:
+        source_options = [
+            c
+            for left, right in top_segments
+            for c in range(left, right + 1)
+            if c != source_col and (top_row, c) not in holes
+        ]
+        if source_options:
+            grid[0, int(random.choice(source_options))] = int(water)
+
+    counts = Counter(map(int, grid.ravel()))
+    if counts[int(bg)] <= max(counts.get(int(water), 0), counts.get(int(shelf), 0)):
+        return None
+
+    try:
+        inferred_period, inferred = _infer_intended_shelves(grid, shelf)
+    except Exception:
+        return None
+    if inferred_period != period or not np.array_equal(inferred, intended):
+        return None
+
+    expected, events = _simulate_water(grid, water, shelf, intended, collect_events=True)
+    if int(events["hole_leaks"]) < 1 or int(events["overflows"]) < 1:
+        return None
+    if len(events["hit_rows"]) < 2:
+        return None
+    if np.array_equal(expected, grid):
+        return None
+    if np.array_equal(_naive_actual_shelf_water(grid, water, shelf), expected):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        built = _build_candidate()
+        if built is not None:
+            grid, _expected = built
+            return grid
+    raise RuntimeError(f"failed to generate a valid phase-leak waterfall input after {MAX_ATTEMPTS} attempts")

