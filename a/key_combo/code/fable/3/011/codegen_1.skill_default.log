+def _paint_open(out: np.ndarray, original: np.ndarray, r: int, c: int, water: int, shelf: int) -> None:
+    if 0 <= r < out.shape[0] and 0 <= c < out.shape[1] and int(original[r, c]) != int(shelf):
+        out[r, c] = int(water)
