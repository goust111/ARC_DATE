+
+def _choose_rows(height: int, count: int) -> list[int] | None:
+    choices = list(range(3, height - 1))
+    for _ in range(80):
+        rows = sorted(random.sample(choices, int(count)))
+        if all(rows[i + 1] - rows[i] >= 3 for i in range(len(rows) - 1)):
+            return [int(r) for r in rows]
