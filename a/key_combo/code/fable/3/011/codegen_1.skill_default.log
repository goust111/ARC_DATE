+            if bool(actual_shelf[nr, cc]):
+                seg = _segment_containing(intended_segments[nr], cc)
+                assert seg is not None, "actual shelf must be inside the inferred shelf span"
+                left, right = seg
+                spread_r = rr
+                events["hit_rows"].add(int(nr))
