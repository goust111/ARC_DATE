+                        _paint_open(out, g, spread_r, x, water, shelf)
+                        if bool(intended[nr, x]) and not bool(actual_shelf[nr, x]):
+                            out[nr, x] = int(water)
+                            events["hole_leaks"] = int(events["hole_leaks"]) + 1
+                            q.append((int(nr), int(x)))
+                            break
