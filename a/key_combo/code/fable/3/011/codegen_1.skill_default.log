+def _role_colors(grid: np.ndarray) -> tuple[int, int, int]:
+    bg = _get_bg(grid)
+    top_colors = [int(c) for c in np.unique(grid[0]) if int(c) != bg]
+    assert len(top_colors) == 1, "expected a unique water color on the top edge"
+    water = int(top_colors[0])
