+    period = random.randint(6, min(8, width // 3))
+    row_count = random.randint(3, min(5, max(3, (height - 4) // 3)))
+    shelf_rows = _choose_shelf_rows(height, row_count)
+    if shelf_rows is None:
+        return None
+
+    bg, water, shelf = random.sample(list(PALETTE), 3)
+    intervals: dict[int, tuple[int, int]] = {}
+    protected: set[Coord] = set()
+    holes: set[Coord] = set()
+
+    top_row = shelf_rows[0]
+    top_len = random.randint(3, period - 2)
+    top_start = random.randint(1, period - top_len - 1)
+    top_end = top_start + top_len - 1
+    intervals[top_row] = (top_start, top_end)
+    top_segments = _segments_for_interval(width, period, top_start, top_end)
+    top_segments = [seg for seg in top_segments if seg[0] > 0 and seg[1] < width - 1]
+    if not top_segments:
+        return None
+    top_left, top_right = random.choice(top_segments)
+    if top_right - top_left + 1 < 3:
+        return None
+
+    source_col = random.randint(top_left, top_right)
+    protected.add((top_row, source_col))
+    top_hole = _add_guarded_hole(holes, protected, top_row, top_left, top_right, source_col)
+    if top_hole is None:
+        return None
+    overflow_col = top_left - 1 if top_hole > source_col else top_right + 1
+    if not (0 <= overflow_col < width):
+        return None
+
+    catch_col = int(random.choice([top_hole, overflow_col]))
+    for i, row in enumerate(shelf_rows[1:], start=1):
+        if i == 1:
+            phase = catch_col % period
+            length = random.randint(3, period - 2)
+            interval = _phase_interval_containing(phase, period, length)
+            if interval is None:
+                return None
+            start, end = interval
+        else:
+            length = random.randint(3, period - 2)
+            start = random.randint(0, period - length)
+            end = start + length - 1
+        intervals[row] = (int(start), int(end))
+
+    intended = _intended_from_rows((height, width), shelf_rows, intervals, period)
+    if not bool(intended[top_row, source_col]):
+        return None
+    protected.add((top_row, source_col))
+    for row in shelf_rows[1:]:
+        if bool(intended[row, catch_col]):
+            protected.add((int(row), catch_col))
+            spans = _run_segments(intended[row])
+            seg = _segment_containing(spans, catch_col)
+            if seg is not None and random.random() < 0.75:
+                _add_guarded_hole(holes, protected, row, seg[0], seg[1], catch_col)
+            break
+
+    extra_holes = random.randint(1, 5)
+    intended_cells = [tuple(map(int, rc)) for rc in np.argwhere(intended)]
+    random.shuffle(intended_cells)
+    for r, c in intended_cells:
+        if extra_holes <= 0:
+            break
+        if (r, c) in holes or (r, c) in protected:
+            continue
+        start, end = intervals[int(r)]
+        phase = c % period
+        if phase in {start, end} and random.random() < 0.75:
+            continue
+        holes.add((int(r), int(c)))
+        extra_holes -= 1
+
+    grid = np.full((height, width), int(bg), dtype=int)
+    grid[intended] = int(shelf)
+    for r, c in holes:
+        grid[int(r), int(c)] = int(bg)
+    grid[0, source_col] = int(water)
+
+    if random.random() < 0.45:
+        source_options = [
+            c
+            for left, right in top_segments
+            for c in range(left, right + 1)
+            if c != source_col and (top_row, c) not in holes
+        ]
+        if source_options:
+            grid[0, int(random.choice(source_options))] = int(water)
+
+    counts = Counter(map(int, grid.ravel()))
+    if counts[int(bg)] <= max(counts.get(int(water), 0), counts.get(int(shelf), 0)):
+        return None
+
+    try:
+        inferred_period, inferred = _infer_intended_shelves(grid, shelf)
+    except Exception:
+        return None
+    if inferred_period != period or not np.array_equal(inferred, intended):
+        return None
+
+    expected, events = _simulate_water(grid, water, shelf, intended, collect_events=True)
+    if int(events["hole_leaks"]) < 1 or int(events["overflows"]) < 1:
+        return None
+    if len(events["hit_rows"]) < 2:
+        return None
+    if np.array_equal(expected, grid):
+        return None
+    if np.array_equal(_naive_actual_shelf_water(grid, water, shelf), expected):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        built = _build_candidate()
+        if built is not None:
+            grid, _expected = built
+            return grid
+    raise RuntimeError(f"failed to generate a valid phase-leak waterfall input after {MAX_ATTEMPTS} attempts")

