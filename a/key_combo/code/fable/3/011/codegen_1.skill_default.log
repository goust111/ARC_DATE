+    while q:
+        r, c = q.popleft()
+        r = int(r)
+        c = int(c)
+        if not (0 <= r < h and 0 <= c < w):
+            continue
+        if (r, c) in seen_starts:
+            continue
+        seen_starts.add((r, c))
+        if int(g[r, c]) == int(shelf):
+            continue
