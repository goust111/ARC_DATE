+                br = random.randint(sr + sh + gap, h - border - bh)
+            bc = random.randint(border, w - border - bw)
+            sc = random.randint(border, w - border - sw)
+
+        clean = np.full((h, w), bg, dtype=int)
+        inp = np.full((h, w), bg, dtype=int)
