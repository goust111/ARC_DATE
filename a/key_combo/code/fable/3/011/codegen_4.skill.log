+        if len(np.unique(patch)) < 2:
+            continue
+        transitions = int(np.count_nonzero(patch[:, 1:] != patch[:, :-1]))
+        transitions += int(np.count_nonzero(patch[1:, :] != patch[:-1, :]))
+        if transitions < max(3, (h + w) // 2):
+            continue
+        return patch
