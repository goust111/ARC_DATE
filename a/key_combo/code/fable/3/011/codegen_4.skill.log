+def bbox_coords(coords: np.ndarray) -> BBox:
+    """Inclusive bbox for an (N,2) coords array in (r,c) order."""
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
