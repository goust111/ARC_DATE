+                r1 = random.randint(r0, h - 1)
+                c0 = random.randint(0, w - 1)
+                c1 = random.randint(c0, w - 1)
+                patch[r0 : r1 + 1, c0 : c1 + 1] = color
+            elif mode == "row":
