+
+def _repair_pair(small: np.ndarray, big: np.ndarray, scale: int) -> tuple[np.ndarray, np.ndarray]:
+    repaired_small = np.array(small, dtype=int, copy=True)
+    repaired_big = np.array(big, dtype=int, copy=True)
