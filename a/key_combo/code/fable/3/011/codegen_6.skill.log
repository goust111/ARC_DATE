    allowed = set(_main_allowed(n, edge))
    if len(allowed) < size:
        return None

    start = random.choice(tuple(allowed))
    blob = {start}
    frontier = {
        (rr, cc)
        for rr, cc in neighbors4(*start)
        if (rr, cc) in allowed
