    return rows


def _gen_draw_motif(grid: np.ndarray, bar_r: int, color: int, center_c: int, solid_count: int) -> None:
    left_c = center_c - 1
    for k in range(2 * solid_count + 1):
        r = bar_r + 1 + k
        if k % 2 == 0:
            grid[r, left_c] = color
            grid[r, left_c + 2] = color
