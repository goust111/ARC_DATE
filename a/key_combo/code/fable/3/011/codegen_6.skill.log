  "type": "transform_in_place",
  "src": "4-connected background regions partitioned by long 8-connected contour-color components and obstacle-color pixels",
  "transform": "recolor each non-exterior background region touching a long contour component to the contour color; keep the two largest background regions and all foreground pixels unchanged"
}
</annotation>
</reference_puzzle>

