+def _id_map(shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    ids = np.full(shape, -1, dtype=int)
+    for oid, obj in enumerate(objects):
+        for r, c in obj["coords"]:
+            ids[r, c] = oid
+    return ids
