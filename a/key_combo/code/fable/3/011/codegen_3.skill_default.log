    col = int(spec["color"])
    bg = int(spec["bg"])
    grid[r0:r1 + 1, c0:c1 + 1] = col
    if spec["has_hole"]:
        hr, hc = spec["hole"]
        grid[int(hr), int(hc)] = bg


def _hole_for_rect(r0: int, c0: int, r1: int, c1: int, direction: tuple[int, int]) -> tuple[int, int] | None:
    dr, dc = direction
    rm, cm = (r0 + r1) // 2, (c0 + c1) // 2
    if dr != 0:
        max_off = (r1 - r0) // 2
        if max_off < 1:
            return None
        off = random.randint(1, max_off)
        hr = rm - off if dr < 0 else rm + off
        return int(hr), cm
    if dc != 0:
        max_off = (c1 - c0) // 2
        if max_off < 1:
            return None
        off = random.randint(1, max_off)
        hc = cm - off if dc < 0 else cm + off
        return rm, hc
    return None


def _make_object_spec(
    r0: int,
    c0: int,
    h: int,
    w: int,
    color: int,
    *,
    bg: int,
    has_hole: bool,
    direction: tuple[int, int] | None,
) -> dict[str, object] | None:
    r1 = r0 + h - 1
    c1 = c0 + w - 1
    hole = None
    if has_hole:
        if direction is None:
            direction = _rand_dir()
        hole = _hole_for_rect(r0, c0, r1, c1, direction)
        if hole is None:
            return None
    return {
        "r0": r0,
        "c0": c0,
        "r1": r1,
        "c1": c1,
        "color": color,
        "bg": bg,
        "has_hole": has_hole,
        "direction": None if direction is None else tuple(direction),
        "hole": hole,
    }


def _ray_cells(
    emitter: dict[str, object],
