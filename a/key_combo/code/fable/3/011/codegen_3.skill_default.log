    r0, c0, r1, c1 = int(spec["r0"]), int(spec["c0"]), int(spec["r1"]), int(spec["c1"])
    occ[r0:r1 + 1, c0:c1 + 1] = True
    if spec["has_hole"]:
        hr, hc = spec["hole"]
        occ[int(hr), int(hc)] = False


def _paint_object(grid: np.ndarray, spec: dict[str, object]) -> None:
