+def _direction_from_hole(
+    obj_bbox: tuple[int, int, int, int], hole_bbox: tuple[int, int, int, int]
+) -> str:
+    r0, c0, r1, c1 = obj_bbox
+    hr0, hc0, hr1, hc1 = hole_bbox
+    dr2 = (hr0 + hr1) - (r0 + r1)
+    dc2 = (hc0 + hc1) - (c0 + c1)
+    assert (dr2 == 0) ^ (dc2 == 0), "hole center must be offset along exactly one axis"
+    if dr2 < 0:
+        return "up"
+    if dr2 > 0:
+        return "down"
+    if dc2 < 0:
+        return "left"
+    assert dc2 > 0
+    return "right"
+
