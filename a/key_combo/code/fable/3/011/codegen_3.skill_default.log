        start = r1 + 1
        end = int(target["r0"]) - 1 if target is not None else H - 1
        if start > end:
            return []
        return [(rr, hc) for rr in range(start, end + 1) if in_bounds(shape, rr, hc)]

    if dr == -1:
        start = r0 - 1
        end = int(target["r1"]) + 1 if target is not None else 0
        if start < end:
            return []
        return [(rr, hc) for rr in range(start, end - 1, -1) if in_bounds(shape, rr, hc)]

    if dc == 1:
        start = c1 + 1
        end = int(target["c0"]) - 1 if target is not None else W - 1
        if start > end:
            return []
        return [(hr, cc) for cc in range(start, end + 1) if in_bounds(shape, hr, cc)]

    start = c0 - 1
    end = int(target["c1"]) + 1 if target is not None else 0
    if start < end:
        return []
    return [(hr, cc) for cc in range(start, end - 1, -1) if in_bounds(shape, hr, cc)]


