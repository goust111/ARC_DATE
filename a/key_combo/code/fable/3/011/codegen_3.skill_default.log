+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(mask.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(coords)
+    return comps
