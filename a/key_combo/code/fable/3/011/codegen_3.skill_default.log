+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(mask.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(coords)
+    return comps
