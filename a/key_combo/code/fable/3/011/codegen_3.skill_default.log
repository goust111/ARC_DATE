def _can_place(mask: np.ndarray, r0: int, c0: int, h: int, w: int, *, pad: int = 1) -> bool:
    H, W = mask.shape
    r1 = r0 + h - 1
    c1 = c0 + w - 1
    rr0 = max(0, r0 - pad)
    cc0 = max(0, c0 - pad)
    rr1 = min(H, r1 + pad + 1)
    cc1 = min(W, c1 + pad + 1)
    if rr0 >= rr1 or cc0 >= cc1:
        return False
    if mask[rr0:rr1, cc0:cc1].any():
        return False
    return True


