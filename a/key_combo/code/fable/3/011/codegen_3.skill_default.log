+
+
+def _hole_infos_for_component(
+    shape: tuple[int, int],
+    coords: list[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+) -> list[dict]:
+    r0, c0, r1, c1 = bbox
+    local_h = r1 - r0 + 1
+    local_w = c1 - c0 + 1
+    obj = np.zeros((local_h, local_w), dtype=bool)
+    for r, c in coords:
+        obj[r - r0, c - c0] = True
