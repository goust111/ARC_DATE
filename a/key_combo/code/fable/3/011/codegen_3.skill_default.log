+    ids = _id_map(g.shape, objects)
+    out = g.copy()
+    out[seed_coord] = bg
+
+    current = initial_id
+    hit_once: set[int] = set()
+    while True:
+        obj = objects[current]
+        if obj["hole"] is None:
+            break
+
+        r, c, direction = _ray_start(obj)
+        dr, dc = DIRS[direction]
+        hit_id = -1
+        while _in_bounds(g.shape, r, c):
