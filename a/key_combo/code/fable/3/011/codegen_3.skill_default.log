+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+DIRS: dict[str, tuple[int, int]] = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_NAMES = tuple(DIRS)
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+GENERATION_ATTEMPTS = 800
+PLACEMENT_ATTEMPTS = 120
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _component_masks(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(mask.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _same_color_components(g: np.ndarray, bg: int) -> list[dict]:
+    h, w = g.shape
+    seen = np.zeros(g.shape, dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(g.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "bbox": _bbox_from_coords(coords)})
+    return comps
+
+
+def _hole_infos_for_component(
+    shape: tuple[int, int],
+    coords: list[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+) -> list[dict]:
+    del shape
+    r0, c0, r1, c1 = bbox
+    local_h = r1 - r0 + 1
+    local_w = c1 - c0 + 1
+    obj = np.zeros((local_h, local_w), dtype=bool)
+    for r, c in coords:
+        obj[r - r0, c - c0] = True
+
+    holes: list[dict] = []
+    for comp in _component_masks(~obj):
+        touches_border = any(
+            lr == 0 or lc == 0 or lr == local_h - 1 or lc == local_w - 1
+            for lr, lc in comp
