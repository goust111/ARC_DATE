+    direction: str,
+    color: int,
+    holed: bool,
+    role: str,
+) -> dict | None:
+    sr0, sc0, sr1, sc1 = source["bbox"]
+    source_cr = (sr0 + sr1) // 2
+    source_cc = (sc0 + sc1) // 2
+
+    for _ in range(PLACEMENT_ATTEMPTS):
+        h, w = _holed_size() if holed else _solid_size()
+        gap = random.randint(2, 5)
+
+        if direction in ("left", "right"):
