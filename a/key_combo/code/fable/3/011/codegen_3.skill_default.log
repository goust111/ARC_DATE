+def _expanded_bbox(bbox: tuple[int, int, int, int], pad: int = 1) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 - pad, c0 - pad, r1 + pad, c1 + pad
