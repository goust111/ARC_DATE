+def _ray_start(obj: dict) -> tuple[int, int, str]:
+    r0, c0, r1, c1 = obj["bbox"]
+    direction = obj["hole"]["direction"]
+    assert (r0 + r1) % 2 == 0 and (c0 + c1) % 2 == 0, (
+        "firing object bbox center must lie on a grid cell"
