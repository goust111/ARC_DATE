+def _transform_coords(coords: list[tuple[int, int]], shape: tuple[int, int], k: int) -> list[tuple[int, int]]:
+    k %= 4
+    h, w = shape
+    out = []
+    for r, c in coords:
+        if k == 0:
+            out.append((r, c))
+        elif k == 1:
+            out.append((w - 1 - c, r))
+        elif k == 2:
+            out.append((h - 1 - r, w - 1 - c))
+        else:
