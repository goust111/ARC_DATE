+
+def _choose_colors(n_active: int) -> tuple[int, list[int]]:
+    dup = random.choice(COLORS)
+    base_color = random.choice([c for c in COLORS if c != dup])
+    piece_colors = [0] * n_active
+    piece_colors[0] = dup
