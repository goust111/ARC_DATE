+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(local_bg[r, c]) and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(local_bg[nr, nc]) and not outside[nr, nc]:
