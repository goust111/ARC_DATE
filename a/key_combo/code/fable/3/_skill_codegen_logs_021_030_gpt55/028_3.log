+
+
+def _place_hole_mask(occ: np.ndarray, shape: Shape) -> Coord | None:
+    h, w = _shape_size(shape)
+    H, W = occ.shape
+    candidates: list[Coord] = []
+    for r0 in range(1, H - h):
+        for c0 in range(1, W - w):
+            cells = [(r0 + r, c0 + c) for r, c in shape]
+            ok = True
+            for r, c in cells:
