+            hole, piece_a, piece_b = made
+            canon = _canonical(hole)
+            if canon in seen_holes:
+                continue
+            loc = _place_hole_mask(hole_occ, hole)
+            if loc is None:
+                continue
+            r0, c0 = loc
+            cells = frozenset((r0 + r, c0 + c) for r, c in hole)
+            for r, c in cells:
+                hole_occ[r, c] = True
+            seen_holes.add(canon)
+            specs.append(
+                {
+                    "hole": hole,
+                    "piece_a": piece_a,
+                    "piece_b": piece_b,
+                    "top_left": (r0, c0),
+                    "cells": cells,
+                }
+            )
