+
+def _cells_at(shape: Shape, r0: int, c0: int) -> frozenset[Coord]:
+    return frozenset((r0 + r, c0 + c) for r, c in shape)
+
+
+def _all_piece_specs(hole_specs: list[dict]) -> list[dict]:
