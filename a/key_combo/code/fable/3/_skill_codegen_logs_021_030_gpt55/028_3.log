+
+def _component_holes(g: np.ndarray, comp: dict, bg: int) -> list[dict]:
+    r0, c0, r1, c1 = comp["bbox"]
+    crop = g[r0 : r1 + 1, c0 : c1 + 1]
+    local_bg = crop == int(bg)
+    h, w = local_bg.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[Coord] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
