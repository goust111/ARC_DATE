+    specs = []
+    seen_holes: set[Shape] = set()
+    first_area = random.choice(HOLE_AREA_CHOICES)
+    areas = [first_area, first_area]
+    while len(areas) < n_holes:
+        areas.append(random.choice(HOLE_AREA_CHOICES))
