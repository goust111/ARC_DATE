+    template_key = _dense_shape_key(template["coords"])
+
+    matches = []
+    for comp in _lattice_components(g, bg, template_color):
+        contracted = _sparse_contracted_key(comp["coords"])
+        if contracted == template_key:
+            matches.append(comp)
