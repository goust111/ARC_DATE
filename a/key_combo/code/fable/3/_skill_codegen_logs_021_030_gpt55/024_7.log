+def _valid_shape(shape: tuple[Coord, ...], *, min_h: int = 1, min_w: int = 1) -> bool:
+    h, w = _shape_size(shape)
+    return (
+        h >= min_h
+        and w >= min_w
+        and _shape_connected(shape)
+        and not _shape_has_hole(shape)
