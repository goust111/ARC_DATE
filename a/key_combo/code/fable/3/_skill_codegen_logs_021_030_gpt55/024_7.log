+            return shape
+    return None
+
+
+def _spanning_shape(height: int, width: int, area: int) -> tuple[Coord, ...] | None:
+    min_area = height + width - 1
+    if area < min_area or area > height * width:
+        return None
+
+    for _ in range(200):
+        cells: set[Coord] = {(0, 0)}
+        r = c = 0
+        steps = [(1, 0)] * (height - 1) + [(0, 1)] * (width - 1)
