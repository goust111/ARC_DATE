+
+def _same_count_decoy(target: tuple[Coord, ...]) -> tuple[Coord, ...] | None:
+    rotations = [_rotate_shape(target, k) for k in (1, 2, 3)]
+    rotations = [shape for shape in rotations if shape != target and _valid_shape(shape, min_h=2, min_w=2)]
