+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BG = 0
+COLORS = list(range(1, 10))
+MAX_GEN_ATTEMPTS = 700
+
+
+def _background(grid: np.ndarray) -> int:
+    counts = Counter(map(int, grid.ravel()))
+    return int(counts.most_common(1)[0][0])
+
+
+def _bbox(coords: list[Coord] | tuple[Coord, ...]) -> BBox:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normal_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append({"color": color, "coords": coords, "bbox": _bbox(coords)})
+    return out
+
+
+def _lattice_components(grid: np.ndarray, bg: int, template_color: int) -> list[dict]:
+    out: list[dict] = []
+    for color in sorted(set(map(int, grid.ravel())) - {int(bg), int(template_color)}):
+        pts = {(int(r), int(c)) for r, c in np.argwhere(grid == color)}
+        while pts:
+            seed = next(iter(pts))
+            pts.remove(seed)
+            coords = [seed]
+            q = deque([seed])
+            while q:
