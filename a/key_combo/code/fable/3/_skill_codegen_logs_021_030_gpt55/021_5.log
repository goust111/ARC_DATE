+def _is_hollow_square(sub: np.ndarray, color: int) -> bool:
+    if sub.shape[0] != sub.shape[1] or sub.shape[0] < 3:
+        return False
+    expected = np.zeros_like(sub, dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(sub == int(color), expected))
