+def _frame_patch(size: int, color: int) -> np.ndarray:
+    patch = np.full((int(size), int(size)), BLACK, dtype=int)
+    patch[0, :] = int(color)
+    patch[-1, :] = int(color)
+    patch[:, 0] = int(color)
+    patch[:, -1] = int(color)
+    return patch
+
