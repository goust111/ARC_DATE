+    if sum(row_lengths) > MAX_INTERNAL or sum(col_lengths) > MAX_INTERNAL:
+        return None
+
+    row_segments = list(zip(row_colors, row_lengths))
+    col_segments = list(zip(col_colors, col_lengths))
+    return row_segments, col_segments
