+    for r0, r1, row_color, row_len in row_runs:
+        for c0, c1, col_color, col_len in col_runs:
+            color = _winner(row_color, row_len, col_color, col_len)
+            out[r0 : r1 + 1, c0 : c1 + 1] = color
+    return out
