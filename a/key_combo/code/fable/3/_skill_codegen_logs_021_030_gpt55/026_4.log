+    for row_color, row_len in row_segments:
+        for col_color, col_len in col_segments:
+            if row_color == col_color:
+                counts["same"] += 1
+                if row_len == col_len:
+                    counts["same_equal"] += 1
+            elif row_len > col_len:
+                counts["row_longer"] += 1
+            elif col_len > row_len:
+                counts["col_longer"] += 1
+            else:
+                counts["cancel"] += 1
+    return counts
+
