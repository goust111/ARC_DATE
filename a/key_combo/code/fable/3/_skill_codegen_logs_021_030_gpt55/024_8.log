    if count == 1:
        return [total]
    cuts = sorted(random.sample(range(1, total), count - 1))
    vals = []
    prev = 0
    for cut in cuts + [total]:
        vals.append(cut - prev)
        prev = cut
    return vals


def _gen_main_path():
