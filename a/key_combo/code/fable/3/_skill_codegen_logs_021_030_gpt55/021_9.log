+    if mode == "axis":
+        return random.choice([(5, 5), (5, 7), (7, 5), (7, 7), (5, 9), (9, 5)])
+    return random.choice([(5, 5), (5, 7), (7, 5), (7, 7), (7, 9), (9, 7)])
