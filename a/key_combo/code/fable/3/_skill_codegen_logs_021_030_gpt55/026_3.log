+        current = head
+        seen_states: set[tuple[int, int, int, int]] = set()
+
+        while True:
+            state = (int(current[0]), int(current[1]), int(dr), int(dc))
+            assert state not in seen_states, "ray must terminate instead of cycling"
+            seen_states.add(state)
