+    for row in rows:
+        if added >= target:
+            break
+        go_right = bool(rng.integers(2))
+        if go_right:
+            head_c = int(rng.integers(1, min(5, W - 1)))
+            tail_c = head_c - 1
+            ray = [(row, c) for c in range(head_c + 1, W)]
+        else:
