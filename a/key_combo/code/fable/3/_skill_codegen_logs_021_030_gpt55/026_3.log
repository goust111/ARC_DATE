+def _transform_grid(g: np.ndarray, kind: int) -> np.ndarray:
+    if kind == 0:
+        out = g
+    elif kind == 1:
+        out = np.rot90(g, 1)
+    elif kind == 2:
+        out = np.rot90(g, 2)
+    elif kind == 3:
+        out = np.rot90(g, 3)
+    elif kind == 4:
+        out = np.fliplr(g)
+    elif kind == 5:
+        out = np.flipud(g)
+    elif kind == 6:
+        out = g.T
+    else:
+        out = np.fliplr(np.flipud(g)).T
+    return out.copy()
+
+
+def _straight_no_teleport_output(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    seeds = _find_seeds(g)
+    for head, tail in seeds:
+        dr, dc = head[0] - tail[0], head[1] - tail[1]
+        r, c = head
+        while True:
+            r += dr
+            c += dc
+            if not _in_bounds(g.shape, r, c):
+                break
+            if int(g[r, c]) == BLACK:
+                out[r, c] = YELLOW
