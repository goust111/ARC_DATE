+def _paint_rect(grid: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> bool:
+    if r0 < 0 or c0 < 0 or r0 + h > grid.shape[0] or c0 + w > grid.shape[1]:
+        return False
+    if np.any(grid[r0 : r0 + h, c0 : c0 + w] != BLACK):
+        return False
+    grid[r0 : r0 + h, c0 : c0 + w] = int(color)
+    return True
