+        if np.any(rect_at[r0 : r1 + 1, c0 : c1 + 1] == -1):
+            return None
+        if np.any(actual[r0 : r1 + 1, c0 : c1 + 1] != inp[r0 : r1 + 1, c0 : c1 + 1]):
