+        if not _paint_rect(grid, rA, cA, h, w, color):
+            return None
+        if not _paint_rect(grid, rB, cB, h, w, color):
+            return None
+
+        current_r = int(next_r)
+        current_c = int(new_current_c)
+
+    final_segment = _line_cells_right(current_r, current_c + 1, W - 1)
