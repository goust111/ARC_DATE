+
+                current = (int(tr), int(tc))
+                while True:
+                    sr, sc = current[0] + dr, current[1] + dc
+                    if not _in_bounds(g.shape, sr, sc) or int(rect_at[sr, sc]) != partner[rect_idx]:
+                        break
