+
+    rect_at = np.full(g.shape, -1, dtype=int)
+    for idx, rect in enumerate(rectangles):
+        r0, c0, r1, c1 = rect["bbox"]
+        assert np.all(rect_at[r0 : r1 + 1, c0 : c1 + 1] == -1), "portal rectangles must not overlap"
+        rect_at[r0 : r1 + 1, c0 : c1 + 1] = idx
+
