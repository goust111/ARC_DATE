+    colors = [int(c) for c in rng.choice(np.array(PORTAL_COLORS), size=n_pairs, replace=False)]
+
+    start_row = int(rng.integers(3, H - 3))
+    head_col = int(rng.integers(1, 3))
+    tail = (start_row, head_col - 1)
+    head = (start_row, head_col)
+    grid[tail] = ORANGE
+    grid[head] = YELLOW
