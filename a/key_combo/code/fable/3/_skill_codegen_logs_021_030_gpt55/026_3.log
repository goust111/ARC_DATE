+def _find_seeds(g: np.ndarray) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    heads = [tuple(map(int, rc)) for rc in np.argwhere(g == YELLOW)]
+    tails = {tuple(map(int, rc)) for rc in np.argwhere(g == ORANGE)}
