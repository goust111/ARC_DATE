+    assert int(np.count_nonzero(mask)) == int(sub.size), "expected exactly one grey bar"
+    assert (r0 == r1) ^ (c0 == c1), "grey attractor must be one-cell-thick"
+    assert max(r1 - r0 + 1, c1 - c0 + 1) >= 4, "grey bar is too short"
