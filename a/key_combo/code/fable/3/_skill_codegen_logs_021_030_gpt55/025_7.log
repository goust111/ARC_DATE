+import numpy as np
+
+
+Coord = tuple[int, int]
+Shape = tuple[Coord, ...]
+
+ALL_COLORS = tuple(range(10))
+MIN_SPRITE_AREA = 3
+GEN_ATTEMPTS = 700
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _neighbors4(r: int, c: int) -> Iterable[Coord]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
