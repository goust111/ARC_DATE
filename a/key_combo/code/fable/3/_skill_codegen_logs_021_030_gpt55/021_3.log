+    "DOT": frozenset({(0, 0)}),
+    "H2": frozenset({(0, 0), (0, 1)}),
+    "V2": frozenset({(0, 0), (1, 0)}),
+    "L_UL": frozenset({(0, 0), (0, 1), (1, 0)}),
+    "L_UR": frozenset({(0, 0), (0, 1), (1, 1)}),
+    "L_BL": frozenset({(0, 0), (1, 0), (1, 1)}),
+    "L_BR": frozenset({(0, 1), (1, 0), (1, 1)}),
