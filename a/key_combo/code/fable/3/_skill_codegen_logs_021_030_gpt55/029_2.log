    out = _gen_paint_output((rows, cols), bboxes, gaps)
    inp = out.copy()
    inp[inp == FILL_COLOR] = BACKGROUND_COLOR
    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


