+def _catalog_masks(
+    min_count: int,
+    max_count: int,
+    *,
+    connected: bool = False,
+) -> tuple[np.ndarray, ...]:
+    masks: list[np.ndarray] = []
+    for count in range(min_count, max_count + 1):
+        for cells in itertools.combinations(range(MASK_SIDE * MASK_SIDE), count):
