+    inp[fr : fr + MASK_SIDE, fc : fc + MASK_SIDE] = fine_patch
+
+    expected = _render_output(layout, fine_mask, color_a, color_b)
+    if not _semantic_accepts(inp, expected, layout, fine_mask, color_a, color_b):
+        return None
+    return inp
+
