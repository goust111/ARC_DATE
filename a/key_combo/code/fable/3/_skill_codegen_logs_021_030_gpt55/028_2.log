+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
+        )
+
+    seen = set()
+    queue: deque[tuple[int, int]] = deque([next(iter(cells))])
+    while queue:
+        r, c = queue.popleft()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for dr, dc in deltas:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                queue.append(nxt)
+    return seen == cells
+
