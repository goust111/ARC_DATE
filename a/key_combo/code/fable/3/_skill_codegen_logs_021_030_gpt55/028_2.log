+        return None
+
+    layout = np.zeros((MASK_SIDE, MASK_SIDE), dtype=bool)
+    for br in range(MASK_SIDE):
+        for bc in range(MASK_SIDE):
+            tile = crop[
+                br * TILE_SIDE : (br + 1) * TILE_SIDE,
+                bc * TILE_SIDE : (bc + 1) * TILE_SIDE,
+            ]
+            if np.all(tile == color):
+                layout[br, bc] = True
+            elif np.all(tile == BG):
+                layout[br, bc] = False
+            else:
+                return None
+
