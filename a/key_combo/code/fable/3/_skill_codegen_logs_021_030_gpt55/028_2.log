+def _rects_clear(
+    first: tuple[int, int, int, int],
+    second: tuple[int, int, int, int],
+    gap: int,
+) -> bool:
+    r0, c0, h0, w0 = first
+    r1, c1, h1, w1 = second
+    return (
+        r0 + h0 + gap <= r1
+        or r1 + h1 + gap <= r0
+        or c0 + w0 + gap <= c1
+        or c1 + w1 + gap <= c0
+    )
+
