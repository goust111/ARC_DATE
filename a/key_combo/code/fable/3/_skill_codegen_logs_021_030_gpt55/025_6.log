    """Backtrack marker centers so all eventual stamps stay disjoint."""
    occupied = np.zeros((rect_h, rect_w), dtype=bool)
    centers = np.zeros((rect_h, rect_w), dtype=bool)
    positions: list[tuple[int, int] | None] = [None] * len(patterns)
