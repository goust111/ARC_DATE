    center_r, center_c = SPRITE_CENTER
    patch[center_r, center_c] = int(marker_color)
    rows = [center_r + dr for dr, _ in pattern]
    cols = [center_c + dc for _, dc in pattern]
    patch[rows, cols] = STAMP_COLOR
    return patch


