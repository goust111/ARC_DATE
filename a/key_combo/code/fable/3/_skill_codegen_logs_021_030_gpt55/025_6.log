def _pattern_reaches_all_sides(pattern: Pattern) -> bool:
    return (
        any(dr == -1 for dr, _ in pattern)
        and any(dr == 1 for dr, _ in pattern)
        and any(dc == -1 for _, dc in pattern)
        and any(dc == 1 for _, dc in pattern)
