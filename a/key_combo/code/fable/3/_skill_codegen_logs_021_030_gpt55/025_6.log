+        return "H", "R", r, (r, c1)
+
+    if r < r0:
+        return "V", "T", c, (r0, c)
+    return "V", "B", c, (r1, c)
+
+
+def _opposite_side(side: str) -> str:
+    return {"L": "R", "R": "L", "T": "B", "B": "T"}[side]
