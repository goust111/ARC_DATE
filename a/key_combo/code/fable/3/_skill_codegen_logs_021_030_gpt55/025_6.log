+    for comp in _components_by_color(g, bg):
+        coords = comp["coords"]
+        in_frame = mask[coords[:, 0], coords[:, 1]]
+        if bool(np.all(in_frame)):
+            assert int(comp["color"]) == frame_color, "only the frame may occupy frame cells"
+            continue
