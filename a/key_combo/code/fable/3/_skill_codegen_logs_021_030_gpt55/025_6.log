+        opposite = groups[key].get(_opposite_side(pixel["side"]))
+        if opposite is not None and pixels[opposite]["color"] == pixel["color"]:
+            _paint_segment(out, pixel["coord"], pixels[opposite]["coord"], pixel["color"], bg, frame_color)
+        else:
