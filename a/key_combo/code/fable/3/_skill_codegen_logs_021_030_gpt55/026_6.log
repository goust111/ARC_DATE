+    grid[:, panel_w] = GREY
+    grid[:, 2 * panel_w + 1] = GREY
+    starts = [0, panel_w + 1, 2 * panel_w + 2]
+    size = motif.shape[0]
+    for frame in range(3):
+        r0, c0 = positions[frame]
+        patch = _rotate_n(motif, frame)
+        panel_c = starts[frame] + c0
+        grid[r0 : r0 + size, panel_c : panel_c + size] = patch
+    return grid
+
