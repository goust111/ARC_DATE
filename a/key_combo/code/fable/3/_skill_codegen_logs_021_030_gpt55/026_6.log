+def _add_path(cells: set[tuple[int, int]], a: tuple[int, int], b: tuple[int, int], rng: random.Random) -> None:
+    r, c = a
+    br, bc = b
+    if rng.random() < 0.5:
+        while r != br:
+            cells.add((r, c))
+            r += 1 if br > r else -1
+        while c != bc:
+            cells.add((r, c))
+            c += 1 if bc > c else -1
+    else:
+        while c != bc:
+            cells.add((r, c))
+            c += 1 if bc > c else -1
+        while r != br:
+            cells.add((r, c))
+            r += 1 if br > r else -1
+    cells.add((br, bc))
+
+
+def _random_connected_mask(size: int, rng: random.Random) -> np.ndarray:
