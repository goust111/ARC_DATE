+BLACK = 0
+GREY = 5
+MOTIF_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+PANEL_W_RANGE = (7, 9)
+HEIGHT_RANGE = (9, 15)
+MOTIF_SIZE_RANGE = (3, 5)
