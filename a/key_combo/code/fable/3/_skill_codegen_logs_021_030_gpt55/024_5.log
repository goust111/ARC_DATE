+def _rand_choice(seq):
+    return seq[random.randrange(len(seq))]
+
+
+def _dir_between(a: tuple[int, int], b: tuple[int, int]) -> int | None:
+    rr = int(b[0]) - int(a[0])
+    cc = int(b[1]) - int(a[1])
+    if rr == 0 and cc == 0:
+        return None
