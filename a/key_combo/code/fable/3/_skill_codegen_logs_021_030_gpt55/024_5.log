+    cc = int(dst[1]) - int(sc)
+    if rr == 0 and cc == 0:
+        return None
+
+    if dr == 0:
+        if rr != 0 or cc * dc <= 0:
+            return None
+        return abs(cc)
+    if dc == 0:
+        if cc != 0 or rr * dr <= 0:
+            return None
+        return abs(rr)
+    if abs(rr) != abs(cc) or rr * dr <= 0 or cc * dc <= 0:
