+
+DIRS: tuple[tuple[int, int], ...] = (
+    (-1, 0),   # up
+    (-1, 1),   # up-right
+    (0, 1),    # right
+    (1, 1),    # down-right
+    (1, 0),    # down
+    (1, -1),   # down-left
+    (0, -1),   # left
