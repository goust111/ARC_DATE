+DIR_TO_INDEX = {d: i for i, d in enumerate(DIRS)}
+ALL_COLORS = list(range(10))
+
+
+@dataclass(frozen=True)
+class Obj:
+    kind: str
+    top: int
+    left: int
+    direction: int | None = None
+    start: bool = False
