    def pick_var_color(x, st):
        vals = [int(v) for v in np.unique(x) if int(v) != 0 and int(v) not in st]
        if not vals:
            return None
        best = None
        for v in vals:
            cnt = int(np.sum(x == v))
            if best is None or cnt > best[0]:
                best = (cnt, v)
