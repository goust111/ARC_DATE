+    mods = {int(item["mod"]) for item in items}
+    if 0 not in mods or len(mods) < 3:
+        return False
+    if not any(item["direction"][0] == 0 for item in items):
+        return False
+    if not any(item["direction"][1] == 0 for item in items):
+        return False
