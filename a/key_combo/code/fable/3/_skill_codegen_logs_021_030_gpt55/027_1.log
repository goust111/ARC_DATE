# Canvas, color, and foreground budget.
_GEN_HEIGHT_RANGE, _GEN_WIDTH_RANGE, _GEN_COLOR_RANGE = (11, 17), (9, 19), (1, 9)
_GEN_BACKGROUND = 0
_GEN_FG_FRACTION_RANGE = (0.13, 0.24)

