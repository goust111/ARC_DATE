+            (box[2] - box[0] + 1, color)
+            for color, box in frames.items()
+            if _inside(box, r, c)
+        ]
+        assert containing, "marker must be inside a frame"
+        containing.sort()
+        owner = containing[0][1]
+        assert owner != marker_color, "a frame cannot point to itself"
+        owners[owner].append(marker_color)
