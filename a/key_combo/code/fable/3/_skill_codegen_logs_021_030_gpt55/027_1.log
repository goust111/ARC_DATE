+    g[r1, c0 : c1 + 1] = color
+    g[r0 : r1 + 1, c0] = color
+    g[r0 : r1 + 1, c1] = color
+
+
+def _smallest_owner(frames: dict[int, BBox], r: int, c: int) -> int | None:
+    containing = [
+        (box[2] - box[0] + 1, color)
+        for color, box in frames.items()
+        if _inside(box, r, c)
+    ]
+    if not containing:
+        return None
+    containing.sort()
+    return containing[0][1]
