+
+def _draw_frame(g: np.ndarray, box: BBox, color: int) -> None:
+    r0, c0, r1, c1 = box
+    g[r0, c0 : c1 + 1] = color
+    g[r1, c0 : c1 + 1] = color
+    g[r0 : r1 + 1, c0] = color
+    g[r0 : r1 + 1, c1] = color
