+    chain: list[int] = []
+    seen: set[int] = set()
+    cur = heads[0]
+    while True:
+        assert cur not in seen, "pointer graph must be acyclic"
+        assert cur in edges, "pointer target must be a frame"
+        seen.add(cur)
+        chain.append(cur)
+        nxt = edges[cur]
+        if nxt is None:
