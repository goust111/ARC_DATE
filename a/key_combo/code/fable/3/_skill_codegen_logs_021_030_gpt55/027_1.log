+    assert by_color, "expected at least one hollow square frame"
+    frames: dict[int, BBox] = {}
+    for color, boxes in by_color.items():
+        assert len(boxes) == 1, f"frame color {color} must identify one square"
+        frames[int(color)] = boxes[0]
+    return frames
