+def _marker_cell(
+    g: np.ndarray,
+    frames: dict[int, BBox],
+    owner: int,
+    bg: int,
+    used: set[tuple[int, int]],
+) -> tuple[int, int] | None:
+    r0, c0, r1, c1 = frames[owner]
+    cells = [
+        (r, c)
+        for r in range(r0 + 1, r1)
+        for c in range(c0 + 1, c1)
+        if (r, c) not in used
+        and int(g[r, c]) == bg
+        and _smallest_owner(frames, r, c) == owner
+    ]
