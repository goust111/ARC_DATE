+    if len({r for r, _c in cells}) == 1 and height >= 7:
+        r, c = next(iter(cells))
+        for rr in (r - 1, r + 1):
+            if (rr, c) in pool_set:
+                cells.add((rr, c))
+                break
+    if len({c for _r, c in cells}) == 1 and width >= 7:
+        r, c = next(iter(cells))
+        for cc in (c - 1, c + 1):
