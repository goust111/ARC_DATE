+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+COLORS = tuple(range(1, 10))
+GENERATION_ATTEMPTS = 800
+
+_GEN_CALL_COUNT = 0
+
+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        nbrs = ((-1, 0), (1, 0), (0, -1), (0, 1))
+    else:
+        nbrs = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
+        )
+
+    comps: list[np.ndarray] = []
+    for sr, sc in np.argwhere(mask):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        cells: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            cells.append((r, c))
+            for dr, dc in nbrs:
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+        comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _border_mask(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((int(height), int(width)), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _find_template(grid: np.ndarray, bg: int) -> dict:
+    candidates: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(grid) if int(c) != int(bg)):
+        coords = np.argwhere(grid == int(color))
+        if coords.size == 0:
+            continue
+
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 5 or width < 5:
+            continue
+
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = _border_mask(height, width)
+        interior = ~border
+        if not bool(np.all(sub[border] == int(color))):
+            continue
+        motif_mask = (sub == int(color)) & interior
+        if not bool(motif_mask.any()):
+            continue
+        if not bool(np.any(sub[interior] == int(bg))):
+            continue
+
+        motif_rel = [(int(r), int(c)) for r, c in np.argwhere(motif_mask)]
+        candidates.append(
+            {
+                "color": int(color),
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "height": int(height),
+                "width": int(width),
+                "motif": motif_rel,
+            }
+        )
