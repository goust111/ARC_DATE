+    ]
+    if branch % 4 == 0:
+        focused = [(h, w) for h, w in clean if h == template_h and w != template_w]
+    elif branch % 4 == 1:
+        focused = [(h, w) for h, w in clean if w == template_w and h != template_h]
+    elif branch % 4 == 2:
+        focused = [(h, w) for h, w in clean if h == template_w and w == template_h]
