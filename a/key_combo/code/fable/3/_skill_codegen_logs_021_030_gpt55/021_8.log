+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    placed: list[dict],
+    template_h: int,
+    template_w: int,
+    motif: list[tuple[int, int]],
+    template_color: int,
+) -> bool:
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+    if np.array_equal(grid, expected):
+        return False
