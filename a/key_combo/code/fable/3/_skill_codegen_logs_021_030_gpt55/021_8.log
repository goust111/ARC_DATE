+
+def _draw_frame_and_motif(
+    out: np.ndarray,
+    rect: tuple[int, int, int, int],
+    color: int,
+    motif_rel: list[tuple[int, int]],
+) -> None:
+    r0, c0, r1, c1 = rect
+    out[r0, c0 : c1 + 1] = int(color)
+    out[r1, c0 : c1 + 1] = int(color)
