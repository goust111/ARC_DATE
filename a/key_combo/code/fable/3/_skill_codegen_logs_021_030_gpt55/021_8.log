        for coords in _components(grid == int(color), connectivity=4):
            if len(coords) < 3:
                continue
            r0, c0, r1, c1 = _bbox(coords)
            area = len(coords)
            if r0 == r1 and area == c1 - c0 + 1:
                bars.append(
                    {
                        "orientation": "h",
                        "color": int(color),
                        "row": r0,
                        "c0": c0,
                        "c1": c1,
                        "length": area,
                        "coords": set(coords),
