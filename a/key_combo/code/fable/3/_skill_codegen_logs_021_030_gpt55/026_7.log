from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import deque
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/3/026/7.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()
GRID, WALL, EMPTY, TIE = 8, 5, 0, 6
INF = 10**6

def parse(g):
    line_rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == GRID)]
    line_cols = [c for c in range(g.shape[1]) if np.all(g[:, c] == GRID)]
    cells = np.empty((len(line_rows)-1, len(line_cols)-1), dtype=int)
    for r in range(cells.shape[0]):
        for c in range(cells.shape[1]):
            block = g[line_rows[r]+1:line_rows[r+1], line_cols[c]+1:line_cols[c+1]]
            assert np.all(block == block[0, 0])
            cells[r, c] = int(block[0, 0])
    return cells, line_rows, line_cols

def bfs(walls, seed):
    d = np.full(walls.shape, INF, dtype=int)
    d[seed] = 0
    q = deque([seed])
    while q:
        r, c = q.popleft()
        for nr, nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0 <= nr < walls.shape[0] and 0 <= nc < walls.shape[1] and not walls[nr, nc] and d[nr, nc] == INF:
                d[nr, nc] = d[r, c] + 1
                q.append((nr, nc))
    return d

def fill(cells, rows, cols, template):
    out = template.copy()
    for r in range(cells.shape[0]):
        for c in range(cells.shape[1]):
            out[rows[r]+1:rows[r+1], cols[c]+1:cols[c+1]] = cells[r, c]
    return out

for i in range(80):
    inp = mod.generate_input()
    out = mod.main(inp)
    cells, rows, cols = parse(inp)
    seeds = [(r, c, int(cells[r, c])) for r in range(cells.shape[0]) for c in range(cells.shape[1]) if int(cells[r, c]) not in (EMPTY, WALL)]
    assert len(seeds) == 2
