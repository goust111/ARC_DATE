+def _line_indices(g: np.ndarray, axis: int) -> list[int]:
+    if axis == 0:
+        return [r for r in range(g.shape[0]) if np.all(g[r, :] == GRID_COLOR)]
+    return [c for c in range(g.shape[1]) if np.all(g[:, c] == GRID_COLOR)]
