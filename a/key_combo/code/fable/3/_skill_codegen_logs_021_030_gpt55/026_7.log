+    inp_cells = np.full((rows, cols), EMPTY_COLOR, dtype=int)
+    inp_cells[walls] = WALL_COLOR
+    inp_cells[seeds[0]] = seed_colors[0]
+    inp_cells[seeds[1]] = seed_colors[1]
