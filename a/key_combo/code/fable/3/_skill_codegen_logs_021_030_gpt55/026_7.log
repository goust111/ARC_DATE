+    for r in range(cells.shape[0]):
+        for c in range(cells.shape[1]):
+            if int(cells[r, c]) != EMPTY_COLOR:
+                continue
+            d0 = int(dist0[r, c])
+            d1 = int(dist1[r, c])
+            assert min(d0, d1) < INF, "every empty cell must be reachable"
