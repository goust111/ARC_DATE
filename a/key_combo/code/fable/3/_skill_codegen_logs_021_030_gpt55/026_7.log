+    seed_set = set(seeds)
+    rate = float(rng.uniform(*EXTRA_WALL_RATE_RANGE))
+    for r in range(out.shape[0]):
+        for c in range(out.shape[1]):
+            if out[r, c] or (r, c) in seed_set:
