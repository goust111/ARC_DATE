+    row_steps = np.diff(rows)
+    col_steps = np.diff(cols)
+    assert len(set(map(int, row_steps))) == 1 and int(row_steps[0]) >= 2
+    assert len(set(map(int, col_steps))) == 1 and int(col_steps[0]) >= 2
+    return rows, cols
