+                if any(j != idx and value in col_sets[j] for j in range(len(specs))):
+                    continue
+            else:
+                if any(j != idx and value in row_sets[j] for j in range(len(specs))):
+                    continue
+            choices.append((marker[0], marker[1], direction, axis))
+    return choices
