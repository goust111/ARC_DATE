+def _sprite_with_holes(hole_count: int, rng: random.Random) -> np.ndarray:
+    if hole_count == 0:
+        h = rng.randint(2, 5)
+        w = rng.randint(2, 6)
+        return np.ones((h, w), dtype=bool)
