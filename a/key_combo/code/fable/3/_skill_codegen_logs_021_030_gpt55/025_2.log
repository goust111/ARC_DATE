+    row_sets = [set(map(int, s["coords"][:, 0])) for s in specs]
+    col_sets = [set(map(int, s["coords"][:, 1])) for s in specs]
+    rows = sorted(row_sets[idx])
+    cols = sorted(col_sets[idx])
+    choices: list[tuple[int, int, tuple[int, int], str]] = []
+    edges = [
+        ("top", (-1, 0), "col", cols),
+        ("bottom", (1, 0), "col", cols),
+        ("left", (0, -1), "row", rows),
+        ("right", (0, 1), "row", rows),
