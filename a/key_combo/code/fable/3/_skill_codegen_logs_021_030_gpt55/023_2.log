+    for pos, color in fixed:
+        if not _add_seed(seeds, pos, color):
+            return None
+
+    required_empty = {
+        tie_room,
+        tie_helper,
+        majority_room,
+        (major_r + 1, major_c),
+        (1, tie_col - 1),
+        (2, tie_col),
+    }
+    if any(pos in seeds for pos in required_empty):
