+    room_rows: int,
+    room_cols: int,
+    seeds: dict[tuple[int, int], int],
+) -> list[list[int | None]]:
+    return [[seeds.get((r, c)) for c in range(room_cols)] for r in range(room_rows)]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    room_rows = random.randint(5, 6)
+    room_cols = random.randint(5, 7)
