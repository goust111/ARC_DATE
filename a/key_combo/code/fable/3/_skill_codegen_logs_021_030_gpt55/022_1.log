+    bg = _get_bg(g)
+    centers = _find_ring_centers(g, bg)
+    driver = next(i for i, (r, c) in enumerate(centers) if int(g[r, c]) == DRIVER)
+    graph = _build_graph(centers)
+    distances = _distances_from(graph, driver)
+
+    out = g.copy()
+    for i, center in enumerate(centers):
