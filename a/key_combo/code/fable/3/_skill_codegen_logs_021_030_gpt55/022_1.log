+def _build_graph(centers: list[tuple[int, int]]) -> list[list[int]]:
+    graph = [[] for _ in centers]
+    for i, (r0, c0) in enumerate(centers):
+        for j in range(i + 1, len(centers)):
+            r1, c1 = centers[j]
+            if (r1 - r0, c1 - c0) in TANGENT_DELTAS:
+                graph[i].append(j)
+                graph[j].append(i)
