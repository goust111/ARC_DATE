def _gen_dihedral_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    forms = []
    base = mask.astype(bool)
    for k in range(4):
        rot = np.rot90(base, k)
        forms.append(_gen_key(rot))
        forms.append(_gen_key(np.fliplr(rot)))
    return min(forms)


def _gen_random_shape() -> np.ndarray:
