+
+def _make_chain(n: int) -> tuple[list[tuple[int, int]], list[tuple[tuple[int, int], tuple[int, int]]]] | None:
+    for _ in range(80):
+        nodes = {(0, 0)}
+        edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+        end = (0, 0)
