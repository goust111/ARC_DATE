+        return None
+    for _ in range(80):
+        nodes = {(0, 0)}
+        edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+        for dr, dc in random.sample(DIRS, 3):
+            child = (dr, dc)
+            nodes.add(child)
+            edges.append(((0, 0), child))
