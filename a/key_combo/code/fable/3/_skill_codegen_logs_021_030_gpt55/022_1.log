    out = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
    out[marker1] = MARKER_COLORS[0]
    out[marker2] = MARKER_COLORS[1]
    rays, landings = [], set()
    groups = (
        (marker1, marker2, dirs1, RAY_COLORS[0]),
        (marker2, marker1, dirs2, RAY_COLORS[1]),
