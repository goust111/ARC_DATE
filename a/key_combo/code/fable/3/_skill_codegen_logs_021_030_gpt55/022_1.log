+GEN_RETRIES = 300
+NODE_COUNT_RANGE = (3, 8)
+BACKGROUND_COLORS = tuple(c for c in ALL_COLORS if c != DRIVER)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _neighbors(node: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = node
