    valid_counts = [n for n in range(lo, hi + 1) if lo <= total_rays - n <= hi]
    ray1_count = random.choice(valid_counts)
    return random.sample(DIRECTIONS, ray1_count), random.sample(DIRECTIONS, total_rays - ray1_count)


