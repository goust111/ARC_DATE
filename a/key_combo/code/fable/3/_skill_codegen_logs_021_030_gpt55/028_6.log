+    rel = int(value) - int(line0)
+    mod = rel % period
+
+    if mod == 0 or mod == period // 2:
+        return None
+    if 0 < mod < period // 2:
+        return int(line0 + mod), 0
+    return int(line0 + period - mod), 1
+
+
