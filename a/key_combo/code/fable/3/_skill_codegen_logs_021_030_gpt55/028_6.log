            r, c = random.choice(cells)
            mask[r, c] = True

        coords = np.argwhere(mask)
        used_cols = set(map(int, coords[:, 1]))
        row_patterns = {tuple(map(bool, mask[r, :])) for r in range(depth)}
        if int(mask.sum()) != target_area:
