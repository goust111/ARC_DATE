+    top_wall = random.randint(2, 4)
+    bottom_wall = random.randint(2, 4)
+    left_wall = random.randint(2, 4)
+    right_wall = random.randint(2, 4)
+    outer_h = cavity_h + top_wall + bottom_wall
+    outer_w = cavity_w + left_wall + right_wall
