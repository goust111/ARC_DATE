+        empty = outside_bg
+        next_idx = 2
+    else:
+        empty = colors[2]
+        next_idx = 3
+    a_color = colors[next_idx]
+    b_color = colors[next_idx + 1]
+    tile = np.full(a_mask.shape, int(b_color), dtype=int)
+    tile[a_mask] = int(a_color)
