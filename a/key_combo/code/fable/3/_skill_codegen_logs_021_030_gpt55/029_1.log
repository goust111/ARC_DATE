+
+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[Coord]:
+    h, w = shape
+    steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    if connectivity == 8:
+        steps += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+    out = []
+    for dr, dc in steps:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    for start_r, start_c in np.argwhere(mask):
+        sr, sc = int(start_r), int(start_c)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q: deque[Coord] = deque([(sr, sc)])
+        coords: list[Coord] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for nr, nc in _neighbors(r, c, (h, w), connectivity):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
