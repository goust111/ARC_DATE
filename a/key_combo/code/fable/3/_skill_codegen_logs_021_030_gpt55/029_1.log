+    """Return the unique zero-gap rectangular assembly and its origin relative to A."""
+    a_pts = [tuple(map(int, p)) for p in np.argwhere(a_mask)]
+    b_pts = [tuple(map(int, p)) for p in np.argwhere(b_mask)]
