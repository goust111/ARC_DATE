+    k = sprite_mask.shape[0]
+    total = int(sprite_mask.sum())
+    valid = []
+    for i in range(k):
+        line = sprite_mask[i, :] if axis == 0 else sprite_mask[:, i]
+        hidden_count = int(line.sum())
+        visible_count = total - hidden_count
+        if 1 <= hidden_count < k and visible_count >= 2:
+            valid.append(i)
+    return valid
+
