+def _slot_area_mask(n: int, k: int, starts: list[int]) -> np.ndarray:
+    mask = np.zeros((n, n), dtype=bool)
+    for rs in starts:
+        for cs in starts:
+            mask[rs : rs + k, cs : cs + k] = True
+    return mask
