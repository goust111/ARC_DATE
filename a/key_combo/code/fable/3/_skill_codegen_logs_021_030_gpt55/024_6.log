def _gen_attempt():
    height = int(np.random.randint(*CANVAS_HEIGHT_RANGE))
    width = int(np.random.randint(*CANVAS_WIDTH_RANGE))
    lengths, layout = _gen_choose_legend_plan(height, width)
    legends = _gen_make_legends(lengths)
    if legends is None:
