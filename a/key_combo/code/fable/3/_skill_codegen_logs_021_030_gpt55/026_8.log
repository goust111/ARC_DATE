+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PINK = 6
+GENERATOR_COLORS = (1, 2, 3, 4, 5, 7, 8, 9)
+
+MIN_SIZE = 20
+MAX_SIZE = 30
+MAX_GENERATION_ATTEMPTS = 600
+MAX_PLACE_ATTEMPTS = 250
