+        "three_rect": 0,
+        "four_rect": 0,
+    }
+    for color in [int(c) for c in np.unique(grid) if int(c) != BLACK]:
+        points = [tuple(map(int, rc)) for rc in np.argwhere(grid == color)]
+        if len(points) == 1:
+            counts["noise"] += 1
+        elif len(points) == 2:
