+    return np.array_equal(actual, expected)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    H = rng.randint(MIN_SIZE, MAX_SIZE)
+    W = rng.randint(MIN_SIZE, MAX_SIZE)
