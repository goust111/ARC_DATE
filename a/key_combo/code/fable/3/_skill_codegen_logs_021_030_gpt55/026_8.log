+        return _spec_rect_from_corners(kind, color, points)
+
+    if kind == "three_rect":
+        missing = rng.randrange(4)
+        points = [corner for i, corner in enumerate(corners) if i != missing]
+        rng.shuffle(points)
+        return _spec_rect_from_corners(kind, color, points)
