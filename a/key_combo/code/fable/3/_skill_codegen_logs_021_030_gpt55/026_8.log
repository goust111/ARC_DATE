+            cols = {c for _r, c in points}
+            if len(rows) == 2 and len(cols) == 2:
+                counts["three_rect"] += 1
+        elif len(points) == 4:
+            rows = {r for r, _c in points}
+            cols = {c for _r, c in points}
+            if len(rows) == 2 and len(cols) == 2 and set(points) == {(r, c) for r in rows for c in cols}:
