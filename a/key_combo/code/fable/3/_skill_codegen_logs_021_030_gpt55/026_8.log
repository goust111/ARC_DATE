+    layers: dict[Coord, set[int]] = {}
+    for color in sorted(int(c) for c in np.unique(g) if int(c) != BLACK):
+        coords = [tuple(map(int, rc)) for rc in np.argwhere(g == color)]
+        drawn = _draw_from_generator_points(coords)
+        if drawn is None:
