+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    layers: dict[Coord, set[int]] = {}
+    for color in sorted(int(c) for c in np.unique(g) if int(c) != BLACK):
