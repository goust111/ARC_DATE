+    inp = _build_input(shape, specs)
+    expected = _render_specs(shape, specs)
+    if not _semantic_checks(inp, expected, specs):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
