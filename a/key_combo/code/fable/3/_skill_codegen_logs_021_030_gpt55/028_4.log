        color_rows = {color: row for color, row in zip(ordered_colors, rows)}
        _gen_place_aligned(grid, widths, colors, color_rows)
    else:
        _gen_place_unaligned_left_shift(grid, widths, colors)
    return list(range(1, len(colors))) + [0]


