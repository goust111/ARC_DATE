+    lower_multi = [
+        i
+        for i, half in enumerate(halves)
+        if half == "lower"
+        and sum(bool(np.any((panels[i][r, :] != bg) & (panels[i][r, :] != marker))) for r in range(height)) >= 2
+    ]
