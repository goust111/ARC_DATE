+
+def _separator_columns(grid: np.ndarray, bg: int) -> tuple[int, list[int]]:
+    h, w = grid.shape
+    candidates: list[tuple[int, list[int]]] = []
+
+    for color in _colors_present(grid, exclude={bg}):
