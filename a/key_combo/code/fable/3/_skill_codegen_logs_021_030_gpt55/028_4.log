+    panels: list[np.ndarray],
+    bg: int,
+    marker: int,
+    marker_counts: list[int],
+    halves: list[str],
+    *,
+    order: list[int] | None = None,
+    strip_markers: bool = True,
+    use_half_directions: bool = True,
+) -> list[np.ndarray]:
