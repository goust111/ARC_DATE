+    return left, right
+
+
+def _render_clean_panel(
+    rows: int,
+    cols: int,
+    block_size: int,
+    state: np.ndarray,
+    sprite: np.ndarray,
+    blank: int,
+) -> np.ndarray:
+    h, w = _panel_shape(rows, cols, block_size)
+    panel = np.full((h, w), SEPARATOR, dtype=int)
+    for br in range(rows):
+        for bc in range(cols):
