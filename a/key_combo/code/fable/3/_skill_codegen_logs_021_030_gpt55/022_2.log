+    chosen = set(required)
+    remaining = [cell for cell in candidates if cell not in chosen]
+    if target > len(chosen):
+        chosen.update(random.sample(remaining, target - len(chosen)))
+    for r, c in chosen:
+        inp[r, c] = ERASED
