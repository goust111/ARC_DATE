    for color in colors:
        for c in range(width):
            row = np.full(width, int(bg), dtype=int)
            row[c] = int(color)
            key = tuple(map(int, row.tolist()))
            if key not in used:
                used.add(key)
                return row
    raise RuntimeError("failed to make a distinct row pattern")


def _build_panel(
    height: int,
    width: int,
    bg: int,
    marker: int,
    marker_count: int,
    half: str,
    content_count: int,
    content_colors: list[int],
    used_rows: set[tuple[int, ...]],
) -> np.ndarray:
