+        h, w = key
+        if h != w and random.random() < 0.55:
+            dims = [(h, w), (w, h)]
+        else:
+            dims0 = (w, h) if h != w and random.random() < 0.5 else (h, w)
+            dims = [dims0, dims0]
+        for dims_i in dims:
