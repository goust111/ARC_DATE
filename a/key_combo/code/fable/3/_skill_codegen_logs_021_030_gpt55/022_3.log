+def _render_input(shape: tuple[int, int], specs: list[dict], boxes: list[tuple[int, int, int, int]]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for spec, box in zip(specs, boxes):
+        r0, c0, r1, c1 = box
+        color = int(spec["color"])
+        if random.random() < 0.5:
