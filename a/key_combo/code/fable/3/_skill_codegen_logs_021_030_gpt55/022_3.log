+    color_i += 1
+    specs.append({"color": colors[color_i], "dims": (w, h), "pair": 0})
+    color_i += 1
+
+    # Mandatory same-orientation pair with the same area as the first pair.
+    h, w = same_key
+    if random.random() < 0.5:
+        h, w = w, h
+    specs.append({"color": colors[color_i], "dims": (h, w), "pair": 1})
+    color_i += 1
+    specs.append({"color": colors[color_i], "dims": (h, w), "pair": 1})
+    color_i += 1
+
