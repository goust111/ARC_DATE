+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    specs = _choose_specs()
+    dims = [tuple(map(int, spec["dims"])) for spec in specs]
+    pair_count = (len(specs) - 1) // 2
+    min_side = 24 if pair_count == 2 else 27
+    shape = (random.randint(min_side, 30), random.randint(min_side, 30))
