+    return True
+
+
+def _make_relative_path(n: int) -> tuple[list[tuple[int, int]], list[int]] | None:
+    dirs = _sample_directions(n)
+    heads = [(0, 0)]
+    for direction in dirs:
+        dr, dc = DIRS4[direction]
+        dist = random.randint(*STEP_DISTANCE_RANGE)
+        r, c = heads[-1]
