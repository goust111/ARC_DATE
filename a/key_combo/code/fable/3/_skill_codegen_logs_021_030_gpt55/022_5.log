+        remaining.remove(heads[i + 1])
+
+    return not remaining
+
+
+def _has_required_path_structure(heads: list[tuple[int, int]], dirs: list[int]) -> bool:
+    if len(set(dirs)) < 2:
+        return False
+    if not any(dirs[i] == dirs[i - 1] for i in range(1, len(dirs))):
+        return False
