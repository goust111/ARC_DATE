+    col_major_colors = [
+        dict(zip(heads[1:], marker_colors))[pt]
+        for pt in sorted(heads[1:], key=lambda rc: (rc[1], rc[0]))
+    ]
+    if marker_colors == row_major_colors or marker_colors == col_major_colors:
+        return None
+
+    return grid
