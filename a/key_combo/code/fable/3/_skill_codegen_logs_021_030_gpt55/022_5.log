+
+    square_pos = _choose_square((h, w), n, heads, sprite_cells)
+    if square_pos is None:
+        return None
+
+    try:
+        grid = _render_case(
+            (h, w),
+            bg,
+            actor,
+            marker_colors,
+            template,
+            first_dir,
+            heads,
+            sprite_cells,
+            square_pos,
