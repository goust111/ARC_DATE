+def _direction_between(a: tuple[int, int], b: tuple[int, int]) -> int | None:
+    ar, ac = a
+    br, bc = b
+    if ac == bc and br < ar:
+        return 0
+    if ar == br and bc > ac:
+        return 1
+    if ac == bc and br > ar:
+        return 2
+    if ar == br and bc < ac:
+        return 3
+    return None
+
