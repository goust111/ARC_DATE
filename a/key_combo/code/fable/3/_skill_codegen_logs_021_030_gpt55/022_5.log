+
+def _render_case(
+    shape: tuple[int, int],
+    bg: int,
+    actor: int,
+    marker_colors: list[int],
+    template: str,
+    first_dir: int,
+    heads: list[tuple[int, int]],
+    sprite_cells: set[tuple[int, int]],
+    square_pos: tuple[int, int],
+) -> np.ndarray:
+    side = len(marker_colors)
+    grid = np.full(shape, int(bg), dtype=int)
