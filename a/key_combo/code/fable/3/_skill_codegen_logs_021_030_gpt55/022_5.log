+def _line_cells(a: tuple[int, int], b: tuple[int, int]) -> set[tuple[int, int]]:
+    ar, ac = a
+    br, bc = b
+    dr = (br > ar) - (br < ar)
+    dc = (bc > ac) - (bc < ac)
+    steps = max(abs(br - ar), abs(bc - ac))
+    return {(ar + i * dr, ac + i * dc) for i in range(steps + 1)}
+
