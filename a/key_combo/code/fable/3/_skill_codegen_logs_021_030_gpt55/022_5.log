+        for comp in _components(g == color, connectivity=8):
+            if len(comp) <= 1:
+                continue
+            matched = _match_sprite_component(comp)
+            if matched is None:
+                continue
+            template, direction, head, cells = matched
+            candidates.append(
+                {
+                    "color": int(color),
+                    "template": template,
+                    "direction": int(direction),
+                    "head": head,
+                    "cells": cells,
+                }
+            )
