+    options: list[tuple[int, int]] = []
+    for r in range(h - side + 1):
+        for c in range(w - side + 1):
+            cells = _square_cells(r, c, side)
+            if cells & blocked:
+                continue
+            options.append((r, c))
+    if not options:
+        return None
+    return random.choice(options)
