    side = max(lengths)
    assert len(bars) == (side + 1) // 2

    layers = sorted(bars, key=lambda bar: bar[0], reverse=True)
    out = np.empty((side, side), dtype=int)
    for layer, (_, color) in enumerate(layers):
        out[layer : side - layer, layer : side - layer] = color

    return out

