    if int(grid[r, c]) != WALL_COLOR:
        return False
    if r in wall_rows_set and c in wall_cols_set:
        return False
    grid[r, c] = color
    if r in wall_rows_set:
        row_counts[r] += 1
    elif c in wall_cols_set:
        col_counts[c] += 1
    else:
        return False
    return True


