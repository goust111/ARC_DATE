+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in nbrs:
