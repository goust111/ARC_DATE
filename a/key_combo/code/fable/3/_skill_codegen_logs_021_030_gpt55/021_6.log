+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+SIDE_NAMES = ("top", "bottom", "left", "right")
+SIDE_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+
+def _background(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: list[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    if connectivity == 4:
+        nbrs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        nbrs = [
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
+        ]
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            seen[r, c] = True
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in nbrs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bool(mask[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _line_bars(grid: np.ndarray, bg: int) -> list[dict]:
+    bars: list[dict] = []
+    for color in sorted(set(map(int, grid.ravel())) - {int(bg), GRAY}):
+        for coords in _components(grid == int(color), connectivity=4):
+            if len(coords) < 3:
