def _solid_bar(component: dict) -> dict | None:
    b = component["bbox"]
    h = bbox_h(b)
    w = bbox_w(b)
    area = int(component["area"])
    if min(h, w) != 1 or area != max(h, w) or area <= 1:
        return None

    orientation = "h" if h == 1 else "v"
    return {
