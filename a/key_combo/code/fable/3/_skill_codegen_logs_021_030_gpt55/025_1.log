        paste(out, src["patch"], src["top"], src["left"])
    inp = _compose_input(bg, dst, sources)
    if inp is None:
        return None

    try:
        got = main(inp)
    except Exception:
        return None
    if not np.array_equal(got, out):
        return None
    return inp


