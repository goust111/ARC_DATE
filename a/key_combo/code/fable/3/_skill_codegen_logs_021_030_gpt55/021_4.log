+def _trace_signature(events: list[tuple[int, int, int, int, str, int, int]]) -> tuple[tuple[int, int, int, int, str], ...]:
+    return tuple((tr, tc, hr, hc, orientation) for tr, tc, hr, hc, orientation, _dr, _dc in events)
