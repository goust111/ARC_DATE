+                continue
+            if _max_visible_ring_index(shape, (r, c), spacing) < marker_count + 1:
+                continue
+            if _min_full_ring_index(shape, (r, c), spacing) < 1:
+                continue
+            anchors.append((r, c))
+    return anchors
+
