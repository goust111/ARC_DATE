+def _paint_concentric_rings(
+    grid: np.ndarray,
+    bg: int,
+    anchor: tuple[int, int],
+    spacing: int,
+    colors: list[int],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    ar, ac = anchor
+    rows, cols = np.indices(out.shape)
+    dist = np.maximum(np.abs(rows - ar), np.abs(cols - ac))
