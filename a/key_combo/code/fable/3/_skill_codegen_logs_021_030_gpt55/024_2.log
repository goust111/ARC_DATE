+    expected_positions: list[tuple[int, int]] = []
+    for k in range(1, len(marker_coords) + 1):
+        rr = ar + k * step_r
+        cc = ac + k * step_c
+        assert _in_bounds(g.shape, rr, cc), "marker line must stay inside the grid"
