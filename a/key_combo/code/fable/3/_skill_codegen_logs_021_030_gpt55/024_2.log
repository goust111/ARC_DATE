+    shape: tuple[int, int],
+    direction: tuple[int, int],
+    spacing: int,
+    marker_count: int,
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    anchors: list[tuple[int, int]] = []
+    for r in range(h):
