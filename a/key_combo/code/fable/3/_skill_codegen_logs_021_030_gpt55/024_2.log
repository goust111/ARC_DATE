+    ar, ac = anchor
+    dist = np.maximum(np.abs(rows - ar), np.abs(cols - ac))
+    between = (dist > 0) & (dist % spacing != 0)
+    if not np.any(between & (expected == bg)):
+        return False
+
+    changed = np.count_nonzero(inp != expected)
+    return changed >= max(8, len(colors) * 3)
+
