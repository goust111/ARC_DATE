+def _expected_from_plan(
+    shape: tuple[int, int],
+    bg: int,
+    anchor: tuple[int, int],
+    spacing: int,
+    colors: list[int],
+) -> np.ndarray:
+    grid = np.full(shape, bg, dtype=int)
+    grid[anchor] = GREY
+    return _paint_concentric_rings(grid, bg, anchor, spacing, colors)
