+def _draw_legend_entry(grid: np.ndarray, top: int, shape: np.ndarray, color: int, legend_c0: int) -> None:
+    key_patch = grid[top : top + ENTRY_H, legend_c0 : legend_c0 + SYMBOL_SIZE]
+    key_patch[shape] = LEGEND_KEY
