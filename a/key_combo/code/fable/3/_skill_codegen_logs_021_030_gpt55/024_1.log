+    for r in range(0, legend.shape[0] - ENTRY_H + 1):
+        key = legend[r : r + ENTRY_H, 0:SYMBOL_SIZE]
+        gap = legend[r : r + ENTRY_H, SYMBOL_SIZE]
+        block = legend[r : r + ENTRY_H, SYMBOL_SIZE + 1 : SYMBOL_SIZE + 1 + SYMBOL_SIZE]
