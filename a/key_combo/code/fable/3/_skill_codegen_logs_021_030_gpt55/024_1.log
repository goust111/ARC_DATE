+BG = 0
+SEP = 5
+LEGEND_KEY = 8
+OCCLUDER = 9
+SYMBOL_SIZE = 3
+LEGEND_W = 7
+ENTRY_H = 3
+ENTRY_GAP = 1
+
+OUTPUT_COLORS = [1, 2, 3, 4, 6, 7]
