+OUTPUT_COLORS = [1, 2, 3, 4, 6, 7]
+MAIN_SYMBOL_COLORS = [1, 2, 3, 4, 6, 7]
+MAIN_SIZES = [13, 17, 21]
+HEIGHTS = [17, 21, 25, 29]
+MAX_GEN_ATTEMPTS = 500
