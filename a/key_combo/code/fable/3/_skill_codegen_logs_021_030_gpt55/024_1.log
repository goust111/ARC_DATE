+
+
+def _paint_symbol(grid: np.ndarray, r0: int, c0: int, mask: np.ndarray, color: int) -> None:
+    patch = grid[r0 : r0 + SYMBOL_SIZE, c0 : c0 + SYMBOL_SIZE]
