+def _anchor_orbits(h: int, w: int) -> list[tuple[Coord, Coord]]:
+    anchors = [(r, c) for r in range(1, h - SYMBOL_SIZE + 1, 4) for c in range(1, w - SYMBOL_SIZE + 1, 4)]
