+    opened = [False] * len(rooms)
+    changed = True
+    while changed:
+        changed = False
+        for idx, room in enumerate(rooms):
+            if opened[idx] or int(room["lock_color"]) not in held:
+                continue
+            opened[idx] = True
+            held.update(map(int, room["key_colors"]))
+            changed = True
+    return opened
