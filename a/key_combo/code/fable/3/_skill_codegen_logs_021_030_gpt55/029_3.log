+                grid,
+                bg=BLACK,
+                connectivity=4,
+                monochromatic=True,
+                colors=[int(color)],
+                return_format="dict",
+            )
+        )
+
+    out = []
+    for coords in _components(grid == int(color)):
+        out.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": _bbox_coords(coords),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return out
+
+
+def _border_cells(box: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = box
