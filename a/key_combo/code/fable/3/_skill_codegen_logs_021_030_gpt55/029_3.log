+        lock_pos = random.choice(_side_positions(box, side))
+        _draw_room(grid, box, frame_color, lock_pos, lock_colors[idx])
+        specs.append(
+            {
+                "bbox": box,
+                "lock_pos": lock_pos,
+                "lock_color": int(lock_colors[idx]),
+                "key_colors": set(map(int, key_colors_by_room[idx])),
+                "key_positions": [],
+            }
