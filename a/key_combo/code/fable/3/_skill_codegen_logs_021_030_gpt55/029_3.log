+def _component_as_room(grid: np.ndarray, comp: dict) -> dict | None:
+    frame_color = int(comp["color"])
+    r0, c0, r1, c1 = comp["bbox"]
+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+
+    coords = comp["coords"]
+    if any(not (r in (r0, r1) or c in (c0, c1)) for r, c in coords):
+        return None
