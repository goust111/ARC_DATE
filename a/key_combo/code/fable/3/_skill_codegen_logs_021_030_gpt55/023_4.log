+    for r, c in _sample_cells(empty, extra_count):
+        mode = random.randrange(3)
+        if mode == 0:
+            a[r, c] = int(random.choice(palette))
+        elif mode == 1:
+            b[r, c] = int(random.choice(palette))
+        else:
+            color = int(random.choice(palette))
+            a[r, c] = color
+            b[r, c] = _different_color(color, palette)
+    return True
