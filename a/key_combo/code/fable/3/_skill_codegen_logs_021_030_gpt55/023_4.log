+    a = g[0::2, 0::2]
+    b = np.fliplr(g[1::2, 1::2])
+
+    same_foreground = (a == b) & (a != int(bg))
+    out = np.full(a.shape, int(bg), dtype=int)
+    out[same_foreground] = a[same_foreground]
+    return out
