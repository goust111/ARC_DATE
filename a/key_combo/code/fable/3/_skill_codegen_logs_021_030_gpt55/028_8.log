+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Shape = tuple[Coord, ...]
+
+ARC_COLORS = tuple(range(10))
+GEN_RETRIES = 500
+OBJECT_PADDING = 2
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _normalize(coords) -> Shape:
+    arr = np.asarray(list(coords), dtype=int)
+    arr = arr - arr.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in arr))
+
+
+def _shape_size(shape: Shape) -> tuple[int, int]:
+    return max(r for r, _c in shape) + 1, max(c for _r, c in shape) + 1
+
+
+def _shape_to_mask(shape: Shape) -> np.ndarray:
+    h, w = _shape_size(shape)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in shape:
+        mask[r, c] = True
+    return mask
+
+
+def _mask_to_shape(mask: np.ndarray) -> Shape:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    return _normalize(coords)
+
+
+def _connected_cells(cells: set[Coord]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    q: deque[Coord] = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == int(bg):
+                continue
+            color = int(grid[r, c])
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
