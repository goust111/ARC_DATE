+def _random_location(occupied: np.ndarray, shape: Shape, padding: int) -> Coord | None:
+    h, w = occupied.shape
+    sh, sw = _shape_size(shape)
+    options: list[Coord] = []
+    for r0 in range(1, h - sh):
+        for c0 in range(1, w - sw):
+            if _can_place(occupied, shape, r0, c0, padding):
