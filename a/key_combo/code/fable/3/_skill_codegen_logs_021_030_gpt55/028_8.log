+
+    proto_comp = comps[areas.index(max(areas))]
+    if _normalize(map(tuple, proto_comp["coords"])) != prototype:
+        return False
+
+    shifted = False
+    after = False
+    additions = 0
+    ph, pw = _shape_size(prototype)
+    for comp in comps:
