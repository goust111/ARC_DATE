+def _semantic_checks(inp: np.ndarray, expected: np.ndarray, prototype: Shape) -> bool:
+    try:
+        actual = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+    if np.array_equal(inp, expected):
