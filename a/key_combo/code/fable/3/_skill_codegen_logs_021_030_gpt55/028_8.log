+            fragment = _normalize(cells)
+            offsets = _embedding_offsets(prototype, fragment)
+            if len(offsets) != 1:
+                continue
+            offset = offsets[0]
+            key = (fragment, offset)
+            if key in seen:
+                continue
+            seen.add(key)
+
+            fh, fw = _shape_size(fragment)
+            before = offset[0] > 0 or offset[1] > 0
+            after = offset[0] + fh < ph or offset[1] + fw < pw
+            if n - size < 2:
+                continue
