            path_cells.add(current)

        if i == len(directions) - 1:
            continue

        next_direction = directions[i + 1]
        trigger = (current[0] + dr, current[1] + dc)
        blocker = (current[0] - next_direction[0], current[1] - next_direction[1])

        if trigger == blocker:
            return None
