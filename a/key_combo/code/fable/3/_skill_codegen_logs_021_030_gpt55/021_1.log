+def _random_mask(h: int, w: int) -> np.ndarray | None:
+    mask = np.zeros((h, w), dtype=bool)
+    target_components = random.randint(2, min(6, max(2, (h * w) // 18 + 2)))
+
+    for _ in range(target_components):
