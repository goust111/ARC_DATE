+    grid = np.full((h, 2 * w + 1), BLACK, dtype=int)
+    grid[:, :w][left] = active
+    grid[:, w] = BLUE
+    grid[int(marker_r), w] = YELLOW
+    grid[:, w + 1 :][right] = active
+    return grid
