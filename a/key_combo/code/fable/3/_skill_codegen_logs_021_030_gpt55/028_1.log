+    cur = goal
+    while cur != start:
+        r, c = cur
+        predecessors = [
+            (nr, nc)
+            for nr, nc in _neighbors4(r, c)
+            if _in_bounds((h, w), nr, nc)
+            and not bool(wall_mask[nr, nc])
+            and int(dist[nr, nc]) == int(dist[r, c]) - 1
