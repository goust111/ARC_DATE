+
+def _cell_depth(r: int, c: int, rings: list[dict]) -> int:
+    depth = 0
+    for ring in rings:
+        r0, c0, r1, c1 = ring["bbox"]
+        if r0 <= r <= r1 and c0 <= c <= c1:
+            depth += 1
+    return depth
