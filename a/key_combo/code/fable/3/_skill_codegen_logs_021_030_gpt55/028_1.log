+        cells.add((r, c1))
+    return cells
+
+
+def _find_rings(g: np.ndarray) -> list[dict]:
+    colors = [int(c) for c in np.unique(g) if int(c) not in (BLACK, RED)]
+    assert len(colors) >= 2, "expected at least two colored rings"
