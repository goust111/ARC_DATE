+        trial = g.copy()
+        if trial[start] != BLACK or trial[goal] != BLACK:
+            continue
+        trial[start] = RED
+        trial[goal] = RED
+        if _candidate_ok(trial):
+            return trial
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
