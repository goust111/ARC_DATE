    paste(grid, body, body_r, body_c, transparent=_GEN_BG)
    return target_count


def _gen_is_valid(grid, target_count, target_color):
    if set(np.unique(grid).tolist()) != {_GEN_BG, _GEN_MARKER_COLOR, _GEN_BODY_COLOR}:
