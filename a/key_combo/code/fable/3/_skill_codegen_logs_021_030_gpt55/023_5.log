def _try_add_distractor(
    grid: np.ndarray,
    r: int,
    c: int,
    color: int,
    base_sig: tuple[tuple[tuple[int, int, int], ...], tuple[Coord, ...], int],
) -> bool:
    if not _cell_clear_for_blocker(grid, int(r), int(c)):
        return False
    trial = grid.copy()
    trial[int(r), int(c)] = int(color)
    try:
        sig = _trace_signature(trial)
