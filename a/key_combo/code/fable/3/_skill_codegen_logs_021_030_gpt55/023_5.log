+# --------------- generator ---------------
+
+
+def _cell_clear_for_blocker(grid: np.ndarray, r: int, c: int) -> bool:
+    h, w = grid.shape
+    if not (0 < int(r) < h - 1 and 0 <= int(c) < w):
+        return False
+    if int(grid[r, c]) != BG:
+        return False
+    for rr in range(max(0, r - 1), min(h, r + 2)):
+        for cc in range(max(0, c - 1), min(w, c + 2)):
+            if int(grid[rr, cc]) != BG:
+                return False
+    return True
