_GEN_COMPONENT_COUNT_RANGE, _GEN_CLUSTER_SIZE_RANGE = (14, 25), (2, 12)
_GEN_COMMON_CLUSTER_MAX_SIZE = 6
_GEN_LARGE_CLUSTER_MIN_SIZE, _GEN_LARGE_CLUSTER_PROB = 7, 0.35

