+    decoy_count = random.randint(1, min(3, len(palette)))
+    decoy_colors = [palette.pop() for _ in range(decoy_count)]
+    decoys = _place_decoys(grid, rooms, decoy_colors)
+    if len(decoys) != decoy_count:
