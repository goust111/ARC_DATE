+    for start in sorted(sources):
+        if start in seen:
+            continue
+        path: list[int] = []
+        cur = start
+        while cur not in path:
+            assert cur in arrows, "cycle left the participating set"
+            path.append(cur)
+            cur = arrows[cur]
+        assert cur == start, "each arrow component must be a directed cycle"
+        seen.update(path)
+
+    assert seen == sources
+    return arrows
