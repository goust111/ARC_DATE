+
+    grid = _paint_pure_layers(shape, colors)
+    _place_markers(grid, colors, arrows)
+
+    expected = _expected_from_plan(shape, colors, arrows)
+    direct = _direct_marker_recolor(shape, colors, arrows)
+    if np.array_equal(direct, expected):
