SMALL_HOLE_DIMS, TALL_HOLE_DIMS = [(1, 1), (1, 2), (2, 1), (1, 3), (3, 1)], [(11, 1), (12, 1), (13, 1)]
SMALL_HOLE_PROB, TALL_HOLE_MAX_COUNT, TALL_HOLE_PROB = 0.55, 5, 0.28

