BG_COLOR, DIVIDER_COLOR, MARKER_COLOR = 0, 5, 1
DIVIDER_COL = SPRITE_SIDE
CANVAS_SHAPE = (SPRITE_SIDE * SLOT_ROWS, SPRITE_SIDE * SLOT_COLS + SPRITE_SIDE + 1)
SLOT_COUNT = SLOT_ROWS * SLOT_COLS
SLOT_CENTER = SPRITE_SIDE // 2

