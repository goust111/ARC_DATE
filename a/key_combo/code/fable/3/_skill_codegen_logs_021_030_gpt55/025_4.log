+            if seen[r0, c0] or not bool(mask[r0, c0]):
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[Coord] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
