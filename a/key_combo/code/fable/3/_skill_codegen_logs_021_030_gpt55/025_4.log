def _compose_input(bg: int, dst: np.ndarray, sources: list[dict]) -> np.ndarray | None:
    inp = np.full(INPUT_SHAPE, int(bg), dtype=int)
    pieces = [dst] + [src["patch"] for src in sources]
    try:
        for patch in sorted(pieces, key=lambda p: -p.size):
