    return inp, out

def _gen_attempt() -> np.ndarray | None:
    rows = _gen_randint(GRID_ROWS)
    cols = _gen_randint(GRID_COLS)
    count = _gen_randint(SPRITE_COUNT)

    sprite_size = _gen_sprite_size(cols, count)
    if sprite_size is None:
