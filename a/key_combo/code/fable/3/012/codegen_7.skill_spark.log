            geometry_candidates.append((area, k, int(color), comp, b))

    assert len(geometry_candidates) >= 2, "expected at least two geometric candidates"

    selected = [item for item in geometry_candidates if item[0] == item[1]]
    assert len(selected) == 1, "expected exactly one count-consistent candidate"

    area, k, color, comp, b = selected[0]
    assert k >= 1 and len(comp) == area

    # Reconstruct output canvas from frame crop and paste scaled sprite in interior.
    out = crop_bbox(g, frame_bbox).copy()
    sprite_r0, sprite_c0, sprite_r1, sprite_c1 = b
    sprite = np.full((bbox_h(b), bbox_w(b)), bg, dtype=int)
    sprite[0 : sprite_r1 - sprite_r0 + 1, 0 : 0 + 1]
