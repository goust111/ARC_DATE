        except AssertionError:
            continue
        if _count_nonblack(patch) == 0:
            continue
        if not _place_patch(canvas, patch, padding=1):
            continue

    return canvas


def _count_nonblack(arr: np.ndarray) -> int:
    return int(np.count_nonzero(np.asarray(arr, dtype=int) != Color.BLACK))


def generate_input() -> np.ndarray:
    for _ in range(1200):
        try:
            grid = _generate_once()
            out = main(grid)
            # Ensure deterministic transformation is valid and output is properly bounded.
            assert isinstance(out, np.ndarray)
