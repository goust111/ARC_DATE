def main(grid: np.ndarray) -> np.ndarray:
    \"\"\"Place the unique count-consistent sprite into the interior of a hollow square frame.

    Input structure
    A black background with one one-cell-thick square frame of a single non-black color
    and multiple disjoint single-color sprites elsewhere. The selected sprites are
    square-bounded and some can geometrically fit the frame interior by integer scaling.

    Rule
    Detect the frame, compute its interior side length n, and find all sprites whose
    square bounding box side s divides n. Among those candidates, choose the unique sprite
    whose pixel count equals k = n // s. Scale that sprite by factor k and render it in
    the frame interior, returning the cropped frame region.

    Key insight
    Integer geometric fit is the first filter, but only one candidate is accepted by the
    count-self-consistency condition pixel_count == scale.
    \"\"\"

    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"
    bg = int(get_bg(g))
    assert bg == Color.BLACK, \"expected black background\"

    colors = colors_present(g, exclude={bg})
    assert colors, \"expected at least one non-background color\"

    # Detect exactly one hollow frame object: 1-pixel-wide square border.
    frame_color = None
    frame_bbox = None
    for color in colors:
        for comp in components_mask(g == color, connectivity=4):
            b = bbox(comp)
            if b is None:
                continue
            h = bbox_h(b)
            w = bbox_w(b)
            if h < 3 or w < 3 or h "'!= w:
                continue
            if len(comp) != 4 * h - 4:
                continue
            r0, c0, r1, c1 = b
            inner = g[r0 + 1 : r1, c0 + 1 : c1]
            if inner.size <= 0:
                continue
            if int(np.sum(inner == color)) != 0:
                continue
            if not np.array_equal(inner, np.full_like(inner, bg)):
                continue
            if frame_color is not None:
                raise AssertionError("expected exactly one valid frame color")
            frame_color = int(color)
            frame_bbox = b

    assert frame_color is not None and frame_bbox is not None, "expected a single valid frame"
    assert bbox_h(frame_bbox) == bbox_w(frame_bbox)
    r0, c0, r1, c1 = frame_bbox
    interior_side = int((r1 - r0 - 1))
    assert interior_side >= 1, "invalid frame interior"

    # Find square sprites whose side divides the interior and apply the count==scale lock.
    geometry_candidates: list[tuple[int, int, int, np.ndarray, tuple[int, int]]] = []
    for color in [c for c in colors if c != frame_color]:
        for comp in components_mask(g == color, connectivity=4):
            b = bbox(comp)
            if b is None:
                continue
            h = bbox_h(b)
            w = bbox_w(b)
            if h != w or h < 2:
                continue
            if interior_side % h != 0:
                continue
            k = interior_side // h
            area = int(len(comp))
            if area <= 0:
                continue

            # Keep mask compact with a clear bbox and single-color body.
            sprite = g[b[0] : b[2] + 1, b[1] : b[3] + 1]
            sprite_colors = set(map(int, sprite.flatten())) - {bg}
            if sprite_colors != {int(color)}:
