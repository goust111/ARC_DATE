    assert sprite_mask.shape == (bbox_h(b), bbox_w(b))
    sprite[sprite_mask] = color
    scaled = scale_sprite(sprite, k)
    assert scaled.shape == (interior_side, interior_side), "scaled sprite size mismatch"

    paste(out, scaled, 1, 1, transparent=bg)
    return out


# ------------------------ generator helpers ------------------------

def _min_area_for_square_bbox(side: int) -> int:
    # Minimum connected area to touch all four sides of a square bbox.
    return max(3, 2 * side - 1)


def _skeleton_path_mask(side: int, rng: random.Random) -> np.ndarray:
    mask = np.zeros((side, side), dtype=bool)
    # Deterministic L-shaped full-side-to-full-side skeleton.
    for c in range(side):
        mask[0, c] = True
    for r in range(1, side):
        mask[r, side - 1] = True

    # Randomly rotate/flip to enlarge visual diversity.
    k = rng.randrange(4)
    for _ in range(k):
        mask = np.rot90(mask)
    if rng.random() < 0.5:
        mask = np.fliplr(mask)
    if rng.random() < 0.5:
        mask = np.flipud(mask)
    return mask


def _random_connected_mask_with_square_bbox(side: int, area: int, rng: random.Random) -> np.ndarray | None:
    area = int(area)
    side = int(side)
    if side <= 0:
        return None
    min_area = _min_area_for_square_bbox(side)
    if area < min_area or area > side * side:
        return None

    for _ in range(400):
        mask = _skeleton_path_mask(side, rng).copy()
        count = int(mask.sum())
        if count > area:
            continue

        frontier: set[Tuple[int, int]] = set()
        coords = {tuple(int(x) for x in p) for p in np.argwhere(mask)}

        def refresh_frontier() -> None:
            frontier.clear()
            for r, c in list(coords):
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    rr = r + dr
                    cc = c + dc
                    if 0 <= rr < side and 0 <= cc < side and (rr, cc) not in coords:
                        frontier.add((rr, cc))

        refresh_frontier()
        current = count
        while current < area:
            if not frontier:
                break
            rr, cc = rng.choice(tuple(frontier))
            mask[rr, cc] = True
            coords.add((rr, cc))
            frontier.discard((rr, cc))
            current += 1
            refresh_frontier()

        if current != area:
            continue

        b = bbox(np.argwhere(mask))
        if b is None:
            continue
        if bbox_h(b) == side and bbox_w(b) == side:
            return mask

    return None


def _sprite_patch(side: int, area: int, color: int, rng: random.Random) -> np.ndarray:
    mask = _random_connected_mask_with_square_bbox(side, area, rng)
    if mask is None:
        raise ValueError("failed to generate square sprite mask")
    out = np.full((side, side), Color.BLACK, dtype=int)
    out[mask] = color
    return out


def _frame_patch(side: int, color: int) -> np.ndarray:
    patch = np.full((side, side), Color.BLACK, dtype=int)
    patch[0, :] = color
    patch[-1, :] = color
    patch[:, 0] = color
    patch[:, -1] = color
    return patch


def _place_patch(canvas: np.ndarray, patch: np.ndarray, *, padding: int = 1) -> bool:
    try:
        r, c = random_free_location(
            canvas,
            patch,
            transparent=Color.BLACK,
            border=0,
            padding=padding,
            padding_connectivity=8,
        )
    except ValueError:
        return False
    paste(canvas, patch, r, c, transparent=Color.BLACK)
    return True


def _generate_once() -> np.ndarray:
    rng = random.Random(np.random.randint(0, 2**31 - 1))

    interior_side = rng.choice([18, 24, 28])
