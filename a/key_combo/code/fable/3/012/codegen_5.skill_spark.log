+        return False
+    if np.array_equal(stamp, np.fliplr(stamp)):
+        return False
+    if np.array_equal(stamp, np.flipud(stamp)):
+        return False
+    return True
+
+
+def _build_seed() -> tuple[np.ndarray, int]:
+    colors = [int(c) for c in Color.NOT_BLACK]
+    for _ in range(300):
