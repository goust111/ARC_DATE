    black = _gen_place_components(masks)
    if black is None:
        return None

    inp = output.copy()
    inp[black] = 0
    if not np.array_equal(main(inp), output):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        inp = _gen_attempt()

