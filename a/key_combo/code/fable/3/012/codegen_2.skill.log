    options = _gen_shape_options(count)
    random.shuffle(options)
    for k, h, w in options[:SHAPE_OPTION_LIMIT]:
        if k == 1:
            mask = _gen_connected_full_bbox_mask(h, w, count)
        else:
            mask = _gen_multi_component_mask(h, w, count, k)
        if mask is None:
