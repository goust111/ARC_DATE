from __future__ import annotations

import random
import sys
from pathlib import Path

import numpy as np

# Ensure arc_utils can be imported when this file is loaded directly via SourceFileLoader.
_SOLVER_DIR = Path(\"/home/lixinyu/snap/new/solvers\")
if str(_SOLVER_DIR) not in sys.path:
    sys.path.append(str(_SOLVER_DIR))

from arc_utils import Color, colors_present, get_bg


def _edge_runs(line: np.ndarray, background: int) -> dict[int, tuple[int, int]]:
    \"\"\"Return a map color -> (start, end) for each contiguous non-background run.\"\"\"
    runs: dict[int, tuple[int, int]] = {}
    n = int(line.size)
    i = 0
    while i < n:
        value = int(line[i])
        if value == background:
            i += 1
            continue
        j = i + 1
        while j < n and int(line[j]) == value:
            j += 1
        assert value not in runs, f\"color {value} must appear in exactly one edge run\"
        runs[value] = (i, j - 1)
        i = j
    return runs


def _parse_rectangles(g: np.ndarray) -> list[tuple[int, int, int, int, int]]:
    \"\"\"Parse colors from top/left projection bars into phantom rectangles.\"\"\"
    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"

    background = int(get_bg(g))
    assert background == int(Color.BLACK), \"expected black background\"

    top_runs = _edge_runs(g[0, :], background)
    left_runs = _edge_runs(g[:, 0], background)

    top_colors = set(top_runs)
    left_colors = set(left_runs)
    assert top_colors and left_colors, \"expected at least one projection color\"
    assert top_colors == left_colors, \"top and left projections must use the same color set\"

    rectangles: list[tuple[int, int, int, int, int]] = []
    for color in sorted(top_colors):
        c0, c1 = top_runs[color]
        r0, r1 = left_runs[color]
        assert 0 <= r0 <= r1 < g.shape[0]
        assert 0 <= c0 <= c1 < g.shape[1]
        area = (r1 - r0 + 1) * (c1 - c0 + 1)
        rectangles.append((int(color), int(r0), int(r1), int(c0), int(c1), int(area)))

    areas = [area for _, _, _, _, _, area in rectangles]
    assert len(set(areas)) == len(areas), \"rectangle areas must be unique for deterministic tie-free overlap\"

    return rectangles


def _paint_overlaps(g: np.ndarray, rectangles: list[tuple[int, int, int, int, int, int]]) -> np.ndarray:
    \"\"\"Paint overlap cells by the color of the smallest-area covering rectangle.\"\"\"
    out = g.copy()
    height, width = out.shape

    for r in range(1, height):
        for c in range(1, width):
            owners: list[tuple[int, int]] = []
            for color, r0, r1, c0, c1, area in rectangles:
                if r0 <= r <= r1 and c0 <= c <= c1:
                    owners.append((area, color))

            if len(owners) < 2:
                continue

            owners.sort(key=lambda item: item[0])
            min_area = owners[0][0]
            tied = [color for area, color in owners if area == min_area]
            assert len(set(tied)) == 1, \"overlap cells must have a unique smallest-area owner\"
            out[r, c] = int(tied[0])

    return out


def main(grid: np.ndarray) -> np.ndarray:
    \"\"\"Recover the phantom rectangles from top/left projection bars and paint only intersections by smaller-area colors.

    Input structure:
    - The grid uses a black background.
    - Top row segments give each rectangle's column span.
    - Left column segments give each rectangle's row span.
    - Each non-black color appears in exactly one top segment and one left segment.

    Rule:
    - Build one axis-aligned rectangle per color from its top and left spans.
    - For every interior cell covered by at least two rectangles, paint it with the color of the unique smallest-area rectangle among those covering it.
    - Keep all projection bars and non-overlapped background cells unchanged.

    Key insight:
    - The visible bars are only projections, so output depends on pairwise rectangle intersections and area ordering, not on any directly drawn rectangle interior.
    \"\"\"
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    colors = colors_present(g, exclude={int(Color.BLACK)})
    assert colors, \"expected visible colors\"
    rectangles = _parse_rectangles(g)
    return _paint_overlaps(g, rectangles)


# -------------------- generator --------------------

_BG = int(Color.BLACK)
_COLOR_POOL = [int(c) for c in Color.NOT_BLACK]
_GENERATION_TRIES = 800
_MIN_SIZE = 9
_MAX_SIZE = 23


def _counts_for_rectangles(rows: int, cols: int, rects: list[tuple[int, int, int, int]]) -> np.ndarray:
    \"\"\"Return interior overlap count map for (rows x cols).\"\"\"
    cover = np.zeros((rows, cols), dtype=int)
    for r0, r1, c0, c1 in rects:
        cover[r0 : r1 + 1, c0 : c1 + 1] += 1
    return cover


def _pairwise_overlap_map(rects: list[tuple[int, int, int, int]]) -> int:
    involved = [False] * len(rects)
    pair_overlap = 0
    for i, (r0, r1, c0, c1) in enumerate(rects):
        for j in range(i + 1, len(rects)):
            rr0, rr1, cc0, cc1 = rects[j]
            h = min(r1, rr1) - max(r0, rr0) + 1
            w = min(c1, cc1) - max(c0, rr0) + 1
            if h > 0 and w > 0:
                area = h * w
                if area > 0:
                    pair_overlap += 1
                    involved[i] = involved[j] = True
    return involved.count(True)


def _sample_rectangles(rows: int, cols: int, count: int, mode: str) -> list[tuple[int, int, int, int]] | None:
    \"\"\"Generate phantom rectangles meeting requested overlap mode.\"\"\"
    inner_h = rows - 1
    inner_w = cols - 1
    max_h = max(2, min(inner_h - 1, 8))
    max_w = max(2, min(inner_w - 1, 8))

    for _ in range(900):
        rects: list[tuple[int, int, int, int]] = []
        areas: set[int] = set()
        for _ in range(count):
            for _ in range(140):
                rh = random.randint(2, max_h)
                rw = random.randint(2, max_w)
                r0 = random.randint(1, inner_h - rh + 1)
                c0 = random.randint(1, inner_w - rw + 1)
                r1 = r0 + rh - 1
                c1 = c0 + rw - 1
                area = rh * rw
                if area in areas:
                    continue
                rects.append((r0, r1, c0, c1))
                areas.add(area)
                break
            else:
                break

        if len(rects) "'!= count:
            continue

        area_list = [(r1 - r0 + 1) * (c1 - c0 + 1) for r0, r1, c0, c1 in rects]
        if len(set(area_list)) != count:
            continue

        cover = _counts_for_rectangles(rows, cols, rects)
        inner = cover[1:, 1:]
        pair_cells = int(np.count_nonzero(inner >= 2))
        triple_cells = int(np.count_nonzero(inner >= 3))
        total_inner = (rows - 1) * (cols - 1)

        if pair_cells == 0:
            if mode != "none":
                continue
            if total_inner < 0:
                continue
        elif mode == "none":
            continue
        elif mode == "pair":
            if triple_cells != 0:
                continue
            if pair_cells < 2:
                continue
        elif mode == "triple":
            if triple_cells < 1:
                continue

        if pair_cells > total_inner // 2:
            continue

        # ensure every rectangle takes part in at least one overlap in the meaningful modes
        if mode != "none":
            overlap_participants = 0
            for i in range(len(rects)):
                r0, r1, c0, c1 = rects[i]
                for j in range(len(rects)):
                    if i == j:
                        continue
                    rr0, rr1, cc0, cc1 = rects[j]
                    h = min(r1, rr1) - max(r0, rr0) + 1
                    w = min(c1, cc1) - max(c0, cc0) + 1
                    if h > 0 and w > 0:
                        overlap_participants += 1
                        break
            if overlap_participants != len(rects):
                continue

        return rects

    return None


def _rectangles_to_input(
    rows: int,
    cols: int,
    rects: list[tuple[int, int, int, int]],
) -> tuple[np.ndarray, list[tuple[int, int, int, int, int, int]]]:
    colors = random.sample(_COLOR_POOL, len(rects))
    color_rects: list[tuple[int, int, int, int, int, int]] = []
    inp = np.full((rows, cols), _BG, dtype=int)

    for color, (r0, r1, c0, c1) in zip(colors, rects):
        inp[0, c0 : c1 + 1] = color
        inp[r0 : r1 + 1, 0] = color
        area = (r1 - r0 + 1) * (c1 - c0 + 1)
        color_rects.append((int(color), int(r0), int(r1), int(c0), int(c1), int(area)))

    return inp, color_rects


def generate_input() -> np.ndarray:
    for _ in range(_GENERATION_TRIES):
        rows = int(random.randint(_MIN_SIZE, _MAX_SIZE))
        cols = int(random.randint(_MIN_SIZE, _MAX_SIZE))
        if max(rows, cols) > 30:
            continue

        count = int(random.randint(3, 5))
        mode = random.choice(["pair", "pair", "pair", "triple", "none"])
        rects = _sample_rectangles(rows, cols, count, mode)
        if rects is None:
            continue

        inp, rects_with_color = _rectangles_to_input(rows, cols, rects)
        expected = _paint_overlaps(inp, rects_with_color)

        if np.array_equal(main(inp), expected):
            colors_in_input = colors_present(inp, exclude={_BG})
            assert len(colors_in_input) == len(rects)

            # semantic sanity checks copied from task definition
            assert len(colors_in_input) == len(set(colors_in_input))
            parsed = _parse_rectangles(inp)
            assert len(parsed) == len(rects)
            expected_from_parsed = _paint_overlaps(inp, parsed)
            assert np.array_equal(expected_from_parsed, expected)
            return inp

    raise RuntimeError("failed to generate a valid input for puzzle 3/012/1")
