def _projection_spans(line: np.ndarray, background: int) -> dict[int, tuple[int, int]]:
    \"\"\"Return each visible color's (first, last) index on an edge line.\"\"\"
    spans: dict[int, tuple[int, int]] = {}
    for idx, value in enumerate(line):
        color = int(value)
        if color == background:
            continue
        if color not in spans:
            spans[color] = (idx, idx)
        else:
            lo, hi = spans[color]
            spans[color] = (min(lo, idx), max(hi, idx))
    return spans


