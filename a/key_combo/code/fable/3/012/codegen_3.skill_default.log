+    pts = np.asarray(points, dtype=int)
+    if pts.size == 0:
+        return np.empty((0, 2), dtype=int)
+
+    out = np.empty_like(pts)
+    if k == 0:
+        out[:, 0] = pts[:, 0]
+        out[:, 1] = pts[:, 1]
+    elif k == 1:
+        out[:, 0] = pts[:, 1]
+        out[:, 1] = (h - 1) - pts[:, 0]
+    elif k == 2:
+        out[:, 0] = (h - 1) - pts[:, 0]
+        out[:, 1] = (w - 1) - pts[:, 1]
