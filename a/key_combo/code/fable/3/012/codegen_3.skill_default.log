+        if len(rects) != 4:
+            continue
+        all_hidden = rects[0].copy()
+        any_hidden = np.zeros(mask.shape, dtype=bool)
+        for rect in rects:
+            all_hidden &= rect
+            any_hidden |= rect & mask
+        if not any_hidden.any():
+            continue
+        if (all_hidden & mask).any():
+            continue
+        return rects
+    return None
