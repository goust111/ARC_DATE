+def _candidate_outputs(grid: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+    assert max(g.shape) <= 30, "ARC grids must be at most 30 by 30"
