+        target = random.randint(int(0.46 * area), int(0.66 * area))
+        top = (0, random.randrange(w))
+        bottom = (h - 1, random.randrange(w))
+        left = (random.randrange(h), 0)
+        right = (random.randrange(h), w - 1)
+        seeds = [top, bottom, left, right]
+        random.shuffle(seeds)
+
+        mask = np.zeros((h, w), dtype=bool)
+        mask[seeds[0]] = True
+        for seed in seeds[1:]:
+            starts = np.argwhere(mask)
+            start = tuple(map(int, starts[random.randrange(len(starts))]))
+            _draw_path(mask, start, seed)
+
+        if int(mask.sum()) > target:
+            continue
+
+        while int(mask.sum()) < target:
+            frontier: list[tuple[int, int]] = []
+            for rr, cc in np.argwhere(mask):
+                for nr, nc in _neighbors4(int(rr), int(cc), h, w):
+                    if not bool(mask[nr, nc]):
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            mask[random.choice(frontier)] = True
+
+        if int((~mask).sum()) < 5:
+            continue
+        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
+        if not _connected(mask):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 2)):
+            continue
+        return mask
