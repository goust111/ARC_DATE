            top = int(np.random.randint(0, canvas_h - h + 1))
            left = int(np.random.randint(0, canvas_w - w + 1))
            if not _can_place(occupied, top, left, mask, spacing=spacing):
                continue
            window = grid[top : top + h, left : left + w]
            if np.any(window != 0):
                continue
            window[mask] = color
            occ_sub = np.zeros((h, w), dtype=bool)
            occ_sub[mask] = True
            occupied[top : top + h, left : left + w] |= occ_sub
            placements.append(
                {
                "color": int(color),
                "rot": int(rot),
                "mask": mask,
                "top": int(top),
                "left": int(left),
                }
            )
            placed = True
            break
        if not placed:
            raise RuntimeError("could not place rotated sprites without overlap")
    return grid, placements


def _add_occluder_to_copy(
    grid: np.ndarray,
    copy: dict[str, object],
    background: int,
    occluder: int,
    *,
    max_patch: int = 4,
) -> bool:
    color = int(copy["color"])  # same as copy color
    mask: np.ndarray = copy["mask"]
    top = int(copy["top"])
    left = int(copy["left"])
    h, w = map(int, mask.shape)
    H, W = map(int, grid.shape)
    sprite_area = int(mask.sum())
    assert sprite_area > 0

    # Expanded coordinate system with one-cell border around the sprite to allow background capture.
    exp_h, exp_w = h + 2, w + 2
    expanded = np.zeros((exp_h, exp_w), dtype=bool)
    expanded[1 : h + 1, 1 : w + 1] = mask

    # Patch size is small and connected (rectangle) by construction.
    for _ in range(400):
        ph = int(np.random.randint(1, 4))
        pw = int(np.random.randint(1, 4))
        tmax = exp_h - ph
        lmax = exp_w - pw
        if tmax < 0 or lmax < 0:
            return False

        exp_r0 = int(np.random.randint(0, tmax + 1))
        exp_c0 = int(np.random.randint(0, lmax + 1))

        patch_sprite = expanded[exp_r0 : exp_r0 + ph, exp_c0 : exp_c0 + pw]
        covered = int(patch_sprite.sum())
        if covered == 0:
            continue
        if covered == ph * pw:
            continue
        if covered >= sprite_area:
            continue

        # avoid touching outer perimeter of the real sprite so its bbox stays visible
        rows, cols = np.where(patch_sprite)
        if np.any(rows == 1) or np.any(rows == h) or np.any(cols == 1) or np.any(cols == w):
            continue

        # map to global coordinates
        g_top = top + exp_r0 - 1
        g_left = left + exp_c0 - 1
        g_bottom = g_top + ph
        g_right = g_left + pw
        if g_top < 0 or g_left < 0 or g_bottom > H or g_right > W:
            continue

        rr = np.arange(g_top, g_bottom)
        cc = np.arange(g_left, g_right)
        window = grid[np.ix_(rr, cc)]
        allowed = (window == background) | (window == color)
        if not bool(np.all(allowed)):
            continue

        # this guarantees at least one sprite cell is covered and at least one background cell is covered
        if int(np.count_nonzero(window == color)) == 0 or int(np.count_nonzero(window == background)) == 0:
            continue

        # keep occluders compact and avoid accidentally erasing all sprite cells
        if int(np.count_nonzero(window == color)) >= sprite_area:
            continue
        if int(np.count_nonzero(window == color)) < 1:
            continue

        # hard cap to keep output dense enough and diverse in size
        if ph * pw > max_patch:
            continue

        window[:] = occluder
        if covered >= sprite_area:
            return False
        return True

    return False


def _validate_generation(grid: np.ndarray, base_mask: np.ndarray, placements: list[dict[str, object]]) -> bool:
    try:
        output = main(grid)
    except Exception:
        return False

    if output.shape != grid.shape or output.size > 30 * 30:
        return False
    if int(np.count_nonzero(output == Color.GRAY)) > 0:
        return False

    # sanity: each reconstructed sprite area must recover the full base mask and each copy is not complete.
    for copy in placements:
        color = int(copy["color"])
        top = int(copy["top"])
        left = int(copy["left"])
        mask: np.ndarray = copy["mask"]
        local = np.argwhere(grid[top : top + mask.shape[0], left : left + mask.shape[1]] == color)
        if local.shape[0] == 0:
            return False
        if local.shape[0] >= int(mask.sum()):
            return False

    colors = colors_present(grid, exclude={int(get_bg(grid)), Color.GRAY})
    if len(colors) != 4:
        return False

    return True


def generate_input() -> np.ndarray:
    background = int(Color.BLACK)
    occluder = int(Color.GRAY)
    sprite_colors = random.sample([c for c in Color.NOT_BLACK if c != occluder], 4)

    for _ in range(800):
        base = _random_base_mask()
        rotated = _random_rotation_patches(base, sprite_colors)

        # Use non-square canvas and random size to avoid accidental symmetry shortcuts.
        h0 = int(base.shape[0])
        w0 = int(base.shape[1])
        canvas_h = int(np.random.randint(max(18, h0 + w0 + 4), 31))
        canvas_w = int(np.random.randint(max(18, h0 + w0 + 4), 31))

        try:
            canvas, placements = _place_sprites(canvas_h, canvas_w, rotated, spacing=1, attempts=1500)
        except RuntimeError:
            continue

        # add one connected grey occluder for each copy.
        all_ok = True
        for copy in placements:
            if np.random.random() < 0.5:
                ok = _add_occluder_to_copy(canvas, copy, background=background, occluder=occluder, max_patch=4)
            else:
                ok = _add_occluder_to_copy(canvas, copy, background=background, occluder=occluder, max_patch=9)
            if not ok:
                all_ok = False
                break
            # Ensure each copy remains non-complete immediately.
            color = int(copy["color"])
            mask = np.array(copy["mask"], dtype=bool)
            top = int(copy["top"])
            left = int(copy["left"])
            visible = np.count_nonzero(canvas[top : top + mask.shape[0], left : left + mask.shape[1]] == color)
            if visible >= int(mask.sum()) or visible == 0:
                all_ok = False
                break

        if not all_ok:
            continue

        # Every mask cell must be visible in at least one recovered copy.
        # This is a stronger generator-side promise to guarantee deterministic recovery.
        rot_map = {int(copy["color"]): int(copy["rot"]) for copy in placements}
        coverage = np.zeros(base.shape, dtype=bool)
        for color, rot in rot_map.items():
            copy = next(c for c in placements if int(c["color"]) == color)
            top = int(copy["top"])
            left = int(copy["left"])
            mask = np.array(copy["mask"], dtype=bool)
            vis = np.rot90(canvas[top : top + mask.shape[0], left : left + mask.shape[1]] == color, -rot)
            coverage |= vis

        if not int(np.all(coverage)):
            continue

        if not _validate_generation(canvas, base, placements):
            continue

        return canvas

    raise RuntimeError("failed to generate valid puzzle input")

