def _can_place(
    occupied: np.ndarray,
    top: int,
    left: int,
    shape_mask: np.ndarray,
    *,
    spacing: int = 1,
) -> bool:
    h, w = map(int, shape_mask.shape)
    H, W = map(int, occupied.shape)
    if top < 0 or left < 0 or top + h > H or left + w > W:
        return False

    r0 = max(0, top - spacing)
    c0 = max(0, left - spacing)
    r1 = min(H, top + h + spacing)
    c1 = min(W, left + w + spacing)

    window = np.zeros((r1 - r0, c1 - c0), dtype=bool)
    window_r0 = top - r0
    window_c0 = left - c0
    window[window_r0 : window_r0 + h, window_c0 : window_c0 + w] = shape_mask
    return not bool(np.any(window & occupied[r0:r1, c0:c1]))


def _random_rotation_patches(
    base_mask: np.ndarray,
    colors: list[int],
) -> list[tuple[int, int, np.ndarray]]:
    rots = [0, 1, 2, 3]
    random.shuffle(rots)
    out: list[tuple[int, int, np.ndarray]] = []
    for rot, color in zip(rots, colors):
        out.append((color, int(rot), np.rot90(base_mask, rot)))
    return out


