from arc_utils import Color, bbox, colors_present, get_bg


def _local_to_canonical(r: int, c: int, h: int, w: int, rot: int) -> tuple[int, int]:
    """
    Map a coordinate (r, c) in a copy rotated by ``rot`` back to canonical 0° mask coordinates.
    """
    if rot == 0:
        return int(r), int(c)
    if rot == 1:
        return int(c), int(h - 1 - r)
    if rot == 2:
        return int(h - 1 - r), int(w - 1 - c)
    # rot == 3
    return int(w - 1 - c), int(r)


def _canonical_score_from_assignment(
    color_infos: dict[int, dict[str, object]],
    orientations: dict[int, int],
    grid: np.ndarray,
    occluder: int,
    background: int,
) -> tuple[int, np.ndarray] | None:
    """
    Reconstruct a candidate canonical mask under a fixed orientation assignment.

    Returns (area, canonical_mask) if the assignment is internally consistent,
    otherwise None.
    """
    colors = list(orientations)
    can_shape: tuple[int, int] | None = None
    can_parts: list[np.ndarray] = []

    for color in colors:
        info = color_infos[color]
        local_mask = info["mask"]
        rot = orientations[color]
        can_mask = np.rot90(local_mask, (-rot) % 4)
        if can_shape is None:
            can_shape = tuple(map(int, can_mask.shape))
        elif tuple(can_mask.shape) != can_shape:
            return None
        can_parts.append(can_mask)

    h, w = map(int, can_shape)
    can_mask = np.zeros((h, w), dtype=bool)
    for part in can_parts:
        can_mask |= part

    if can_mask.size == 0:
        return None

    for color in colors:
        info = color_infos[color]
        local_mask = info["mask"]
        rot = orientations[color]
        # The visible cells of each copy must be subset of its reconstructed full shape.
        expected_local = np.rot90(can_mask, rot)
        if expected_local.shape != local_mask.shape or not np.all(local_mask <= expected_local):
            return None

        # Each copy must have at least one gray occluder pixel on sprite area.
        r0, c0, r1, c1 = info["bbox"]
        win = grid[r0 : r1 + 1, c0 : c1 + 1]
        if int(np.count_nonzero((win == occluder) & expected_local)) < 1:
            return None

    return int(can_mask.sum()), can_mask


def _extract_sprite_infos(grid: np.ndarray, background: int, occluder: int) -> dict[int, dict[str, object]]:
    colors = [int(c) for c in colors_present(grid, exclude={background}) if int(c) != occluder]
    assert len(colors) == 4, f"expected exactly four sprite colors, got {len(colors)}"

    infos: dict[int, dict[str, object]] = {}
    for color in sorted(colors):
        coords = np.argwhere(grid == color)
        assert coords.size > 0, f"sprite color {color} missing"
        r0, c0, r1, c1 = map(int, bbox(coords))
        h, w = r1 - r0 + 1, c1 - c0 + 1
        mask = np.zeros((h, w), dtype=bool)
        mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
        infos[int(color)] = {
            "bbox": (r0, c0, r1, c1),
            "mask": mask,
            "count": int(coords.shape[0]),
        }
    return infos


def _resolve_orientations(
    color_infos: dict[int, dict[str, object]],
    grid: np.ndarray,
    occluder: int,
    background: int,
) -> tuple[dict[int, int], np.ndarray]:
    colors = list(color_infos)
    assert len(colors) == 4, "expected four sprite colors"
    assert len(set(colors)) == 4

    best_area = None
    best_score: tuple[int, ...] | None = None
    best_map: dict[int, int] | None = None
    best_mask: np.ndarray | None = None

    for rots in itertools.permutations(range(4), 4):
        orientation = {color: int(rot) for color, rot in zip(colors, rots)}
        out = _canonical_score_from_assignment(
            color_infos, orientation, grid, occluder=occluder, background=background
        )
        if out is None:
            continue
        area, can_mask = out
        key = tuple(rots)
        if best_area is None or area < best_area or (area == best_area and (best_score is None or key < best_score)):
            best_area = area
            best_score = key
            best_map = orientation
            best_mask = can_mask

    assert best_map is not None and best_mask is not None, "failed to infer unique rotation registration"
    return best_map, best_mask


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recover four rotated sprites from four gray-windowed fragments and erase all gray.

    Input structure:
    - The background is uniform.
    - Four disjoint single-color sprites exist, each using a different color.
    - Their masks are the same shape under 0°, 90°, 180°, 270° rotation.
    - Each sprite is partially covered by one gray connected patch that may include nearby background.

    Rule:
    - Find each sprite's color mask and determine the rotation that maps all four copies to one
      canonical mask orientation (0°, 90°, 180°, 270° each used once).
    - Reconstruct the complete canonical mask as the union of the transformed visible parts.
    - For every gray pixel, map its local coordinate back to the canonical frame via its copy's rotation:
      paint it with that copy's color if inside the reconstructed mask, otherwise paint it background.
    - Keep all non-gray pixels unchanged.

    Key insight:
    - The full shape can be recovered only by combining all four rotated fragments under registration;
      gray patches are windows that must be filled according to each copy's recovered orientation.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
    background = int(get_bg(g))

    present_colors = colors_present(g, exclude={background})
    occluder = int(Color.GRAY)
    if occluder not in present_colors and Color.GREY not in present_colors:
        # Fallback for unusual but equivalent gray IDs.
        if present_colors:
            counts = Counter(int(v) for v in g.reshape(-1))
            sorted_by_count = sorted((counts[c], c) for c in present_colors)
            occluder = int(sorted_by_count[0][1])
    sprite_colors = [int(c) for c in present_colors if int(c) != occluder]
    assert len(sprite_colors) == 4, f"expected four sprite colors, got {len(sprite_colors)}"

    infos = _extract_sprite_infos(g, background=background, occluder=occluder)
    assert len(infos) == 4
    orientations, canonical_mask = _resolve_orientations(
        infos, g, occluder=occluder, background=background
    )

    out = np.array(g, copy=True)
    out[out == occluder] = background

    can_h, can_w = map(int, canonical_mask.shape)
    for color in infos:
        info = infos[color]
        rot = int(orientations[color])
        r0, c0, r1, c1 = info["bbox"]
        local_window = g[r0 : r1 + 1, c0 : c1 + 1]
        local_h, local_w = local_window.shape
        gray_cells = np.argwhere(local_window == occluder)
        for gr, gc in gray_cells:
            cr, cc = _local_to_canonical(int(gr), int(gc), local_h, local_w, rot)
            if 0 <= cr < can_h and 0 <= cc < can_w and canonical_mask[cr, cc]:
                out[r0 + int(gr), c0 + int(gc)] = color
            else:
                out[r0 + int(gr), c0 + int(gc)] = background

    return out


