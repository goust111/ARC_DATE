+                covered_bg = candidate & ~mask
+                if not hidden.any() or not covered_bg.any():
+                    continue
+                if not (mask & ~candidate).any():
+                    continue
+                signature = tuple(map(tuple, np.argwhere(hidden)))
+                if signature in hidden_signatures:
