+    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+        if 0 <= nr < h and 0 <= nc < w:
+            yield nr, nc
+
+
+def _draw_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = map(int, start)
+    er, ec = map(int, end)
+    mask[r, c] = True
+    while (r, c) != (er, ec):
+        options: list[tuple[int, int]] = []
+        if r < er:
+            options.append((r + 1, c))
+        if r > er:
+            options.append((r - 1, c))
+        if c < ec:
+            options.append((r, c + 1))
+        if c > ec:
+            options.append((r, c - 1))
