+    assert gray in colors_present(g), "failed to detect gray color"
+
+    infos = _collect_sprites(g, sprite_colors)
+    shifts, orients, canonical = _solve_registration(infos)
+    return _reconstruct_output(g, bg, infos, shifts, orients, canonical)
+
+
+# -------------------------- Generator --------------------------
+
+GEN_ATTEMPTS = 2500
+GEN_CANVAS_H = (16, 30)
+GEN_CANVAS_W = (16, 30)
+GEN_BASE_H = (4, 8)
+GEN_BASE_W = (4, 8)
+
+
+def _rand_connected_mask() -> np.ndarray:
+    for _ in range(400):
+        h = random.randint(*GEN_BASE_H)
+        w = random.randint(*GEN_BASE_W)
+        target = int((h * w) * random.uniform(0.35, 0.8))
+        target = max(5, min(target, h * w - 2))
+
+        r, c = random.randint(0, h - 1), random.randint(0, w - 1)
+        mask = np.zeros((h, w), dtype=bool)
+        mask[r, c] = True
+
+        frontier = [(r, c)]
+        size = 1
+        while size < target:
+            r0, c0 = random.choice(frontier)
+            opts = []
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r0 + dr, c0 + dc
+                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
+                    opts.append((nr, nc))
+            if not opts:
+                nr, nc = random.randint(0, h - 1), random.randint(0, w - 1)
+                if bool(mask[nr, nc]):
+                    continue
+            else:
+                nr, nc = random.choice(opts)
+            mask[nr, nc] = True
+            frontier.append((nr, nc))
+            size += 1
+
+        if np.array_equal(mask, np.rot90(mask, 1)):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 2)):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 3)):
+            continue
+
+        if np.count_nonzero(mask) < 6:
+            continue
+        return mask
+
+    raise RuntimeError("failed to generate base mask")
+
+
+def _can_place(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, *, pad: int = 1) -> bool:
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    r1, c1 = max(0, r0 - pad), max(0, c0 - pad)
+    r2, c2 = min(H, r0 + h + pad), min(W, c0 + w + pad)
+    return not bool(occupied[r1:r2, c1:c2].any())
+
+
+def _random_connected_block(mask: np.ndarray, max_area: int, must_touch_sprite: bool, must_touch_bg: bool) -> set[tuple[int, int]]:
+    local_h, local_w = mask.shape
+    for _ in range(500):
+        target = random.randint(1, max(1, max_area))
+        sr = random.randint(0, local_h - 1)
+        sc = random.randint(0, local_w - 1)
+
+        block: set[tuple[int, int]] = {(sr, sc)}
+        while len(block) < target:
+            frontier: list[tuple[int, int]] = []
+            for r, c in block:
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < local_h and 0 <= nc < local_w and (nr, nc) not in block:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            block.add(random.choice(frontier))
+
+        if len(block) != target:
+            continue
+        if must_touch_sprite and not any(mask[r, c] for r, c in block):
+            continue
+        if must_touch_bg and not any(not mask[r, c] for r, c in block):
+            continue
+        return block
+
+    return set()
+
+
+def _all_base_cells_visible(base_mask: np.ndarray, placements: list[dict[str, object]], inp: np.ndarray) -> bool:
+    h0, w0 = base_mask.shape
+    vis = np.zeros((h0, w0), dtype=bool)
+
+    for info in placements:
+        rot = int(info["rot"])
+        origin = info["origin"]
+        color = int(info["color"])
+        patch = np.rot90(base_mask, rot)
+        h, w = patch.shape
+        rr, cc = np.where(patch)
+        for lr, lc in zip(rr.tolist(), cc.tolist()):
+            gr = int(origin[0]) + int(lr)
+            gc = int(origin[1]) + int(lc)
+            if inp[gr, gc] == color:
+                br, bc = _rotate_point((int(lr), int(lc)), h, w, (4 - rot) % 4)
+                if 0 <= br < h0 and 0 <= bc < w0:
+                    vis[br, bc] = True
+
+    return bool(vis.all())
+
+
+def _render_full_output(base_mask: np.ndarray, placements: list[dict[str, object]], rows: int, cols: int) -> np.ndarray:
+    out = np.full((rows, cols), Color.BLACK, dtype=int)
+    for info in placements:
+        rot = int(info["rot"])
+        origin = info["origin"]
+        color = int(info["color"])
+        patch = np.rot90(base_mask, rot)
+        rr, cc = np.where(patch)
+        for lr, lc in zip(rr.tolist(), cc.tolist()):
+            out[int(origin[0]) + int(lr), int(origin[1]) + int(lc)] = color
+    return out
+
+
+def _apply_occluder(inp: np.ndarray, color: int, gray: int, origin: tuple[int, int], patch: np.ndarray) -> bool:
+    h, w = patch.shape
+    r0, c0 = origin
+    include_bg = random.random() < 0.75
+
+    block = _random_connected_block(
+        patch,
+        max_area=max(2, int(patch.sum() * 0.55)),
+        must_touch_sprite=True,
+        must_touch_bg=include_bg,
+    )
+    if not block:
+        return False
+
+    # keep at least one sprite pixel and one background pixel covered in half cases
+    sprite_count = sum(1 for r, c in block if patch[r, c])
+    bg_count = len(block) - sprite_count
+    if sprite_count == 0:
+        return False
+    if include_bg and bg_count == 0:
+        return False
+
+    before = patch.copy()
+
+    for lr, lc in block:
+        gr, gc = r0 + lr, c0 + lc
+        v = int(inp[gr, gc])
+        if v != color and v != Color.BLACK:
+            return False
+
+    for lr, lc in block:
+        gr, gc = r0 + lr, c0 + lc
+        inp[gr, gc] = gray
+
+    after = inp[r0 : r0 + h, c0 : c0 + w] == color
+    if not np.array_equal(before, before):
+        return False
+    if not np.array_equal(_bbox_of_bool(before), _bbox_of_bool(after)):
+        return False
+    if int(after.sum()) == 0:
+        return False
+    if int(before.sum()) - int(after.sum()) > int(before.sum() * 0.8):
+        return False
+
+    return True
+
+
+def _bbox_of_bool(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    if not bool(mask.any()):
+        return None
+    rs, cs = np.where(mask)
+    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        rows = random.randint(*GEN_CANVAS_H)
+        cols = random.randint(*GEN_CANVAS_W)
+        base_mask = _rand_connected_mask()
+        h0, w0 = base_mask.shape
+        if h0 + 2 * 2 > rows or w0 + 2 * 2 > cols:
+            continue
+
+        colors = [c for c in Color.NOT_BLACK if c != Color.GRAY]
+        random.shuffle(colors)
+        colors = colors[:4]
+
+        rotations = [0, 1, 2, 3]
+        random.shuffle(rotations)
+
+        inp = np.full((rows, cols), Color.BLACK, dtype=int)
+        occupied = np.zeros((rows, cols), dtype=bool)
+        placements: list[dict[str, object]] = []
+
+        ok = True
+        for color, rot in zip(colors, rotations):
+            patch = np.rot90(base_mask, rot)
+            h, w = patch.shape
+
+            found = False
+            for _ in range(200):
+                r0 = random.randint(0, rows - h)
+                c0 = random.randint(0, cols - w)
+                if _can_place(occupied, r0, c0, h, w, pad=2):
+                    found = True
+                    break
+            if not found:
+                ok = False
+                break
+
+            rr, cc = np.where(patch)
+            for lr, lc in zip(rr.tolist(), cc.tolist()):
+                inp[r0 + int(lr), c0 + int(lc)] = color
+
+            occupied[r0 : r0 + h, c0 : c0 + w] = True
+            br0, bc0 = max(0, r0 - 2), max(0, c0 - 2)
+            br1, bc1 = min(rows, r0 + h + 2), min(cols, c0 + w + 2)
+            occupied[br0:br1, bc0:bc1] = True
+
+            placements.append({"color": int(color), "origin": (r0, c0), "rot": int(rot), "patch": patch})
+
+        if not ok:
+            continue
+
+        for info in placements:
+            if not _apply_occluder(inp, int(info["color"]), Color.GRAY, info["origin"], info["patch"]):
+                ok = False
+                break
+
+        if not ok:
+            continue
+
+        if not _all_base_cells_visible(base_mask, placements, inp):
+            continue
+
+        expected = _render_full_output(base_mask, placements, rows, cols)
+        try:
+            if not np.array_equal(main(inp), expected):
+                continue
+        except Exception:
+            continue
+
+        return inp.astype(int)
+
+    raise RuntimeError("failed to generate valid input")

diff --git a/a/key_combo/code/fable/3/012/3.py b/a/key_combo/code/fable/3/012/3.py
new file mode 100644
index 0000000000000000000000000000000000000000..4fcce688969ddf08bc51cd200a70e6c33d9cdae2
--- /dev/null
+++ b/a/key_combo/code/fable/3/012/3.py
@@ -0,0 +1,544 @@
+from __future__ import annotations
+# PATCH_VISIBILITY_CHECK
+
+import itertools
+import random
+import sys
+from collections import Counter
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterable
+
+import numpy as np
+from numpy.typing import NDArray
+
+_UTILS = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS) not in sys.path:
+    sys.path.append(str(_UTILS))
+
+from arc_utils import Color, components_mask, colors_present, get_bg
+
+
+Grid = NDArray[np.integer]
+
+
+@dataclass
+class SpriteInfo:
+    color: int
+    coords: NDArray[np.integer]
+    origin: tuple[int, int]
+    shape: tuple[int, int]
+    variants: list[NDArray[np.integer]]
+    variant_shapes: list[tuple[int, int]]
+
+
+def _as_set(coords: NDArray[np.integer]) -> set[tuple[int, int]]:
+    return {(int(r), int(c)) for r, c in np.asarray(coords, dtype=int)}
+
+
+def _rotate_point(point: tuple[int, int], h: int, w: int, k: int) -> tuple[int, int]:
+    r, c = point
+    k &= 3
+    if k == 0:
+        return int(r), int(c)
+    if k == 1:
+        return int(c), int(h - 1 - r)
+    if k == 2:
+        return int(h - 1 - r), int(w - 1 - c)
+    return int(w - 1 - c), int(r)
+
+
+def _rotate_coords(points: NDArray[np.integer], h: int, w: int, k: int) -> NDArray[np.integer]:
+    pts = np.asarray(points, dtype=int)
+    if pts.size == 0:
+        return np.empty((0, 2), dtype=int)
+
+    out = np.empty_like(pts)
+    if k == 0:
+        out[:, 0] = pts[:, 0]
+        out[:, 1] = pts[:, 1]
+    elif k == 1:
+        out[:, 0] = pts[:, 1]
+        out[:, 1] = (h - 1) - pts[:, 0]
+    elif k == 2:
+        out[:, 0] = (h - 1) - pts[:, 0]
+        out[:, 1] = (w - 1) - pts[:, 1]
+    else:
+        out[:, 0] = (w - 1) - pts[:, 1]
+        out[:, 1] = pts[:, 0]
+    return out.astype(int)
+
+
+def _shape_after_rotation(h: int, w: int, k: int) -> tuple[int, int]:
+    return (h, w) if (k & 1) == 0 else (w, h)
+
+
+def _bbox_from_set(points: set[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    if not points:
+        return None
+    rs, cs = zip(*points)
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _translate_points(points: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
+    return {(r + dr, c + dc) for r, c in points}
+
+
+def _best_shift(src: set[tuple[int, int]], dst: set[tuple[int, int]]) -> tuple[tuple[int, int], int]:
+    if not src or not dst:
+        return (0, 0), 0
+
+    overlap_by_shift: Counter[tuple[int, int]] = Counter()
+    for sr, sc in src:
+        for tr, tc in dst:
+            overlap_by_shift[(tr - sr, tc - sc)] += 1
+
+    best_shift = (0, 0)
+    best_overlap = -1
+    best_compact = 1_000_000
+
+    for (dr, dc), ov in overlap_by_shift.items():
+        compact = abs(dr) + abs(dc)
+        if ov > best_overlap or (ov == best_overlap and compact < best_compact):
+            best_overlap = ov
+            best_compact = compact
+            best_shift = (dr, dc)
+
+    return best_shift, int(best_overlap)
+
+
+def _collect_colors(g: np.ndarray, bg: int) -> tuple[int, list[int]]:
+    colors = colors_present(g, exclude={bg})
+    if len(colors) < 5:
+        raise AssertionError("expected one gray occluder and four sprite colors")
+
+    by_components = []
+    for c in colors:
+        comps = components_mask(g == int(c), connectivity=4)
+        by_components.append((int(len(comps)), int(np.sum(g == int(c))), int(c)))
+
+    by_components.sort()
+    gray = int(by_components[-1][2])
+
+    sprite_colors = [c for c in colors if c != gray]
+    if len(sprite_colors) != 4:
+        raise AssertionError("expected exactly four sprite colors")
+
+    return gray, sprite_colors
+
+
+def _collect_sprites(
+    g: np.ndarray,
+    sprite_colors: Iterable[int],
+) -> list[SpriteInfo]:
+    infos: list[SpriteInfo] = []
+    for color in sorted(map(int, sprite_colors)):
+        coords = np.argwhere(g == color)
+        if coords.size == 0:
+            raise AssertionError(f"empty sprite color {color}")
+
+        r0, c0 = int(coords[:, 0].min()), int(coords[:, 1].min())
+        r1, c1 = int(coords[:, 0].max()), int(coords[:, 1].max())
+        local = np.asarray(coords - np.array([r0, c0]), dtype=int)
+        h, w = r1 - r0 + 1, c1 - c0 + 1
+
+        variants: list[NDArray[np.integer]] = []
+        shapes: list[tuple[int, int]] = []
+        for k in range(4):
+            variants.append(_rotate_coords(local, h, w, k))
+            shapes.append(_shape_after_rotation(h, w, k))
+
+        infos.append(
+            SpriteInfo(
+                color=color,
+                coords=coords,
+                origin=(r0, c0),
+                shape=(h, w),
+                variants=variants,
+                variant_shapes=shapes,
+            )
+        )
+
+    return infos
+
+
+def _solve_registration(infos: list[SpriteInfo]) -> tuple[list[tuple[int, int]], list[int], set[tuple[int, int]]]:
+    n = len(infos)
+    if n != 4:
+        raise AssertionError("solver expects exactly four sprite copies")
+
+    best: tuple[tuple[int, int, int], list[tuple[int, int]], list[int], list[set[tuple[int, int]]]] | None = None
+
+    for perm in itertools.permutations(range(4), 4):
+        base_idx = 0
+        base_orient = perm[base_idx]
+        orients = [(int(perm[i]) - int(base_orient)) % 4 for i in range(n)]
+
+        aligned: list[set[tuple[int, int]]] = []
+        shifts: list[tuple[int, int]] = [(0, 0)] * n
+
+        base_set = _as_set(infos[base_idx].variants[orients[base_idx]])
+        if not base_set:
+            continue
+        aligned.append(base_set)
+        valid = True
+
+        for i in range(1, n):
+            src = _as_set(infos[i].variants[orients[i]])
+            shift, ov = _best_shift(src, base_set)
+            if ov <= 0:
+                valid = False
+                break
+            aligned.append(_translate_points(src, shift[0], shift[1]))
+            shifts[i] = shift
+
+        if not valid:
+            continue
+
+        all_points = set().union(*aligned)
+        if not all_points:
+            continue
+
+        pair_overlap = 0
+        for i in range(n):
+            for j in range(i + 1, n):
+                pair_overlap += len(aligned[i] & aligned[j])
+
+        span = 0
+        bb = _bbox_from_set(all_points)
+        if bb is None:
+            continue
+        span = (bb[2] - bb[0] + 1) + (bb[3] - bb[1] + 1)
+
+        cand = (pair_overlap, -span, -len(all_points))
+        if best is None or cand > best[0]:
+            best = (cand, shifts, orients, aligned)
+
+    if best is None:
+        raise AssertionError("cannot register four rotations uniquely")
+
+    _, shifts, orients, aligned = best
+
+    union = set().union(*aligned)
+    r0, c0, _r1, _c1 = _bbox_from_set(union)
+    shifts = [(dr - r0, dc - c0) for dr, dc in shifts]
+    canonical = {(r - r0, c - c0) for r, c in union}
+
+    return shifts, orients, canonical
+
+
+def _reconstruct_output(
+    g: np.ndarray,
+    bg: int,
+    infos: list[SpriteInfo],
+    shifts: list[tuple[int, int]],
+    orients: list[int],
+    canonical: set[tuple[int, int]],
+) -> np.ndarray:
+    out = np.full_like(g, int(bg), dtype=int)
+    canon_shape = canonical
+
+    for idx, info in enumerate(infos):
+        ori = orients[idx]
+        rot_h, rot_w = info.variant_shapes[ori]
+        dr, dc = shifts[idx]
+
+        for cr, cc in canon_shape:
+            lr, lc = _rotate_point((cr - dr, cc - dc), rot_h, rot_w, (4 - ori) % 4)
+            if not (lr, lc) in canon_shape:
+                continue
+            if not (0 <= lr < info.shape[0] and 0 <= lc < info.shape[1]):
+                continue
+
+            gr = info.origin[0] + lr
+            gc = info.origin[1] + lc
+            if not (0 <= gr < g.shape[0] and 0 <= gc < g.shape[1]):
+                continue
+            if out[gr, gc] != bg:
+                raise AssertionError("reconstruction produced overlapping copies")
+            out[gr, gc] = info.color
+
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Recover hidden rotated sprite copies and fill their gray occluders.
+
+    Input structure:
+    - A uniform background with one gray occluder color and four disjoint sprite colors.
+    - The four sprites have the same binary mask, and each is a 0/90/180/270 degree rotation of one base mask.
+    - Gray occluder patches cover part of each sprite (and may include adjacent background).
+
+    Rule:
+    - Detect the gray color, then parse the four sprite color masks.
+    - For all permutations of 90-degree assignments, align each sprite to a shared normalized coordinate by translation.
+    - Keep the alignment with best pairwise overlap consistency and take the union of normalized visible masks as the complete shared mask.
+    - For each canonical masked cell, map it back through each copy's inverse registration transform and paint that copy color; keep background elsewhere.
+
+    Key insight:
+    - Each visible copy is an occluded view of the same mask under rotation; the full mask is the union in normalized space, and occlusion can be restored by applying that shared mask back to each oriented copy.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    bg = get_bg(g)
+    gray, sprite_colors = _collect_colors(g, bg)
+    assert gray in colors_present(g), "failed to detect gray color"
+
+    infos = _collect_sprites(g, sprite_colors)
+    shifts, orients, canonical = _solve_registration(infos)
+    return _reconstruct_output(g, bg, infos, shifts, orients, canonical)
+
+
+# -------------------------- Generator --------------------------
+
+GEN_ATTEMPTS = 2500
+GEN_CANVAS_H = (16, 30)
+GEN_CANVAS_W = (16, 30)
+GEN_BASE_H = (4, 8)
+GEN_BASE_W = (4, 8)
+
+
+def _rand_connected_mask() -> np.ndarray:
+    for _ in range(400):
+        h = random.randint(*GEN_BASE_H)
+        w = random.randint(*GEN_BASE_W)
+        target = int((h * w) * random.uniform(0.35, 0.8))
+        target = max(5, min(target, h * w - 2))
+
+        r, c = random.randint(0, h - 1), random.randint(0, w - 1)
+        mask = np.zeros((h, w), dtype=bool)
+        mask[r, c] = True
+
+        frontier = [(r, c)]
+        size = 1
+        while size < target:
+            r0, c0 = random.choice(frontier)
+            opts = []
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r0 + dr, c0 + dc
+                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
+                    opts.append((nr, nc))
+            if not opts:
+                nr, nc = random.randint(0, h - 1), random.randint(0, w - 1)
+                if bool(mask[nr, nc]):
+                    continue
+            else:
+                nr, nc = random.choice(opts)
+            mask[nr, nc] = True
+            frontier.append((nr, nc))
+            size += 1
+
+        if np.array_equal(mask, np.rot90(mask, 1)):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 2)):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 3)):
+            continue
+
+        if np.count_nonzero(mask) < 6:
+            continue
+        return mask
+
+    raise RuntimeError("failed to generate base mask")
+
+
+def _can_place(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, *, pad: int = 1) -> bool:
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    r1, c1 = max(0, r0 - pad), max(0, c0 - pad)
+    r2, c2 = min(H, r0 + h + pad), min(W, c0 + w + pad)
+    return not bool(occupied[r1:r2, c1:c2].any())
+
+
