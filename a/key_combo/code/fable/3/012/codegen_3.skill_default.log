from __future__ import annotations

import itertools
import random
import sys
from pathlib import Path

import numpy as np

from collections import Counter

# Load shared ARC helpers directly from the repository copy.
_SOLVERS_ROOT = Path("/home/lixinyu/snap/new/solvers")
if str(_SOLVERS_ROOT) not in sys.path:
