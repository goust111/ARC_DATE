+        out = g.copy()
+        for record, rotation in zip(records, rotations):
+            r0, c0, _r1, _c1 = record["bbox"]
+            reconstructed = np.rot90(full_mask, int(rotation))
+            rr, cc = np.nonzero(record["unknown"])
+            color = int(record["color"])
+            for dr, dc in zip(rr, cc):
