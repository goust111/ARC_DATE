+    rw = random.randint(2, min(4, w))
+    r0 = random.randint(0, h - rh)
+    c0 = random.randint(0, w - rw)
+    rect = np.zeros((h, w), dtype=bool)
+    rect[r0 : r0 + rh, c0 : c0 + rw] = True
+    return rect
