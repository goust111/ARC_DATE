+    if int(np.count_nonzero(counts >= 3)) < 2:
+        return False
+    if int(np.count_nonzero(counts == 2)) < 5:
+        return False
+    fill_count = int(np.count_nonzero(fill))
+    if not (8 <= fill_count <= max(8, inner_h * inner_w // 4)):
+        return False
