+    areas = [(r1 - r0 + 1) * (c1 - c0 + 1) for r0, r1, c0, c1 in rel_rects]
+    if len(set(areas)) != len(areas):
+        return False
+
+    counts, owner = _relative_cover_counts(rel_rects, areas, colors, inner_h, inner_w)
