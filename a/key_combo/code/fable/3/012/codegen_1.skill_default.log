# Canvas and region dimensions.
MIN_GRID_SIZE, MAX_GRID_SIZE = 13, 19
MIN_REGION_COUNT, MAX_REGION_COUNT = 2, 4
MIN_PART_SIZE, MAX_PART_SIZE = 2, 8

# Marker placement constraints.
