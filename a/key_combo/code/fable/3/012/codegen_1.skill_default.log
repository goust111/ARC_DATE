from importlib.machinery import SourceFileLoader
from pathlib import Path
import itertools
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/3/012/1.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

def span(vals):
    vals = sorted(set(map(int, vals)))
    assert vals
    assert vals == list(range(vals[0], vals[-1] + 1))
    return vals[0], vals[-1]

def parse(g):
    h, w = g.shape
    for band in range(1, min(h, w)):
        if np.any(g[:band, :band] "'!= 0) or np.any(g[band:, band:] != 0):
            continue
        top = g[:band, band:]
        left = g[band:, :band]
        colors = {int(x) for x in np.unique(top) if int(x)}
        if not colors or colors != {int(x) for x in np.unique(left) if int(x)} or len(colors) != band:
            continue
        rects = []
        for color in colors:
            tc = np.argwhere(top == color)
            lc = np.argwhere(left == color)
            assert len(set(map(int, tc[:, 0]))) == 1
            assert len(set(map(int, lc[:, 1]))) == 1
            c0, c1 = span(tc[:, 1] + band)
            r0, r1 = span(lc[:, 0] + band)
            rects.append((color, r0, r1, c0, c1, (r1 - r0 + 1) * (c1 - c0 + 1)))
        assert len({r[-1] for r in rects}) == len(rects)
        return band, rects
    raise AssertionError('"'no parse')

def inter(a, b):
    return max(0, min(a[2], b[2]) - max(a[1], b[1]) + 1) * max(0, min(a[4], b[4]) - max(a[3], b[3]) + 1)

for i in range(200):
    inp = mod.generate_input()
    out = mod.main(inp)
    band, rects = parse(inp)
    assert 4 <= len(rects) <= 5
    assert np.array_equal(out[:band, :], inp[:band, :])
    assert np.array_equal(out[:, :band], inp[:, :band])
    counts = np.zeros_like(inp, dtype=int)
    expected = inp.copy()
    for r in range(band, inp.shape[0]):
        for c in range(band, inp.shape[1]):
            covering = [rect for rect in rects if rect[1] <= r <= rect[2] and rect[3] <= c <= rect[4]]
            counts[r, c] = len(covering)
            if len(covering) >= 2:
                min_area = min(rect[5] for rect in covering)
                winners = [rect for rect in covering if rect[5] == min_area]
                assert len(winners) == 1
                expected[r, c] = winners[0][0]
    assert np.array_equal(out, expected)
    assert np.count_nonzero(counts >= 3) >= 2
    assert np.count_nonzero(counts == 2) >= 5
    assert len({int(x) for x in out[(counts >= 2)]}) >= 2
    pairs = [inter(a, b) for a, b in itertools.combinations(rects, 2)]
    assert any(x == 0 for x in pairs)
    assert all(any(inter(a, b) > 0 for b in rects if b is not a) for a in rects)
print('semantic checks passed')
