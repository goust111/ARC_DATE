+def _contiguous_span(values: np.ndarray) -> tuple[int, int] | None:
+    if values.size == 0:
+        return None
+    vals = sorted(set(map(int, values)))
+    if vals != list(range(vals[0], vals[-1] + 1)):
+        return None
+    return vals[0], vals[-1]
 
