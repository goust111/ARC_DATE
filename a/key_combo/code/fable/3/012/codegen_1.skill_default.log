+
+def _relative_intersection(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar0, ar1, ac0, ac1 = a
+    br0, br1, bc0, bc1 = b
+    h = min(ar1, br1) - max(ar0, br0) + 1
+    w = min(ac1, bc1) - max(ac0, bc0) + 1
+    return max(0, h) * max(0, w)
