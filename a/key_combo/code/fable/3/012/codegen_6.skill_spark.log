        ]
        if not choices:
            return None
        area = random.choice(choices)
        options = bank[area]
        rects = [mask for mask, kind in options if kind == "rect"]
        l_shapes = [mask for mask, kind in options if kind == "l"]
        if rects and l_shapes:
