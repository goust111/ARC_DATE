        else:
            pool = rects or l_shapes
        masks.append(random.choice(pool).copy())
        remaining -= area

    random.shuffle(masks)
    return masks


def _gen_fits(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
    h, w = patch.shape
    rows, cols = np.nonzero(patch)
    for dr, dc in zip(rows, cols):
