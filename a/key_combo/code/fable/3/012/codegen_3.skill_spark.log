/bin/bash -lc "cat > /home/lixinyu/snap/a/key_combo/code/fable/3/012/3.py <<'PY'
from __future__ import annotations

import itertools
import random
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable

import numpy as np
from numpy.typing import NDArray

from collections import Counter

_UTILS = Path(\"/home/lixinyu/snap/new/solvers\")
if str(_UTILS) not in sys.path:
    sys.path.append(str(_UTILS))

from arc_utils import Color, components_mask, colors_present, get_bg

Grid = NDArray[np.integer]


@dataclass
class SpriteInfo:
    color: int
    coords: NDArray[np.integer]
    origin: tuple[int, int]
    shape: tuple[int, int]
    variants: list[NDArray[np.integer]]
    variant_shapes: list[tuple[int, int]]


def _as_set(coords: NDArray[np.integer]) -> set[tuple[int, int]]:
    return {(int(r), int(c)) for r, c in np.asarray(coords, dtype=int)}


def _bbox_from_set(points: set[tuple[int, int]]) -> tuple[int, int, int, int] | None:
    if not points:
        return None
    rs, cs = zip(*points)
    return min(rs), min(cs), max(rs), max(cs)


def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    if not bool(mask.any()):
        return None
    rows, cols = np.where(mask)
    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())


def _rotate_point(
    p: tuple[int, int] | list[int] | NDArray[np.integer],
    h: int,
    w: int,
    k: int,
) -> tuple[int, int]:
    r, c = int(p[0]), int(p[1])
    k &= 3
    if k == 0:
        return r, c
    if k == 1:
        return c, h - 1 - r
    if k == 2:
        return h - 1 - r, w - 1 - c
    return w - 1 - c, r


def _rotate_points(coords: NDArray[np.integer], h: int, w: int, k: int) -> NDArray[np.integer]:
    pts = np.asarray(coords, dtype=int)
    if pts.size == 0:
        return np.empty((0, 2), dtype=int)

    k &= 3
    r = pts[:, 0]
    c = pts[:, 1]
    if k == 0:
        rr, cc = r, c
    elif k == 1:
        rr, cc = c, (h - 1) - r
    elif k == 2:
        rr, cc = (h - 1) - r, (w - 1) - c
    else:
        rr, cc = (w - 1) - c, r

    return np.column_stack([rr.astype(int), cc.astype(int)])


def _shape_for_rotation(h: int, w: int, k: int) -> tuple[int, int]:
    return (h, w) if (k & 1) == 0 else (w, h)


def _translate_points(points: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
    return {(r + dr, c + dc) for r, c in points}


def _best_shift(src: set[tuple[int, int]], dst: set[tuple[int, int]]) -> tuple[tuple[int, int], int]:
    if not src or not dst:
        return (0, 0), 0

    counter: Counter[tuple[int, int]] = Counter()
    for sr, sc in src:
        for dr, dc in dst:
            counter[(dr - sr, dc - sc)] += 1

    if not counter:
        return (0, 0), 0

    # Prefer max overlap first, then compact shifts.
    best = None
    for shift, overlap in counter.items():
        if best is None:
            best = (shift, overlap)
            continue
        if overlap > best[1]:
            best = (shift, overlap)
        elif overlap == best[1]:
            dr, dc = shift
            bdr, bdc = best[0]
            if abs(dr) + abs(dc) < abs(bdr) + abs(bdc):
                best = (shift, overlap)

    return best[0], int(best[1])


def _identify_gray_and_sprites(g: np.ndarray, bg: int) -> tuple[int, list[int]]:
    cols = colors_present(g, exclude={bg})
    if len(cols) < 2:
        raise AssertionError(\"expected at least one occluder and several sprite colors\")

    stats = []
    for c in cols:
        comps = components_mask(g == int(c), connectivity=4)
        area = int(np.sum(g == int(c)))
        stats.append((int(len(comps)), area, int(c)))

    stats_sorted = sorted(stats, key=lambda t: (t[0], t[1], -t[2]))
    gray = int(stats_sorted[-1][2])

    sprite_colors = [c for c in cols if c "'!= gray]
    if len(sprite_colors) != 4:
        # fallback: if stats are ambiguous, prefer the color most close to Gray and force 4 others.
        # This keeps the solver deterministic for the required generation profile.
        alt = [t for t in stats if t[2] != gray]
        if len(alt) != 4:
            raise AssertionError("expected exactly four sprite colors")
        sprite_colors = [int(c) for c in alt]

    return gray, sprite_colors


def _collect_sprite_infos(g: np.ndarray, bg: int, gray: int, colors: Iterable[int]) -> list[SpriteInfo]:
    infos: list[SpriteInfo] = []
    for color in sorted(map(int, colors)):
        m = (g == color)
        coords = np.argwhere(m)
        if coords.size == 0:
            raise AssertionError(f"empty color {color}")

        r0, c0 = int(coords[:, 0].min()), int(coords[:, 1].min())
        r1, c1 = int(coords[:, 0].max()), int(coords[:, 1].max())
        local = np.asarray(coords - np.array([r0, c0]), dtype=int)
        h, w = r1 - r0 + 1, c1 - c0 + 1

        variants: list[NDArray[np.integer]] = []
        variant_shapes: list[tuple[int, int]] = []
        for k in range(4):
            variants.append(_rotate_points(local, h, w, k))
            variant_shapes.append(_shape_for_rotation(h, w, k))

        infos.append(
            SpriteInfo(
                color=color,
                coords=coords,
                origin=(r0, c0),
                shape=(h, w),
                variants=variants,
                variant_shapes=variant_shapes,
            )
        )

    return infos


def _solve_copy_placement(
    infos: list[SpriteInfo],
) -> tuple[list[tuple[int, int]], list[NDArray[np.integer]], list[int], set[tuple[int, int]]]:
    n = len(infos)
    if n != 4:
        raise AssertionError("expected four sprites")

    best: dict[str, object] | None = None

    for perm in itertools.permutations(range(4), 4):
        # Fix a relative reference orientation by removing the first copy'"'s assigned rotation.
        base = perm[0]
        rel_orients = [(int(perm[i]) - int(base)) % 4 for i in range(4)]

        base_set = _as_set(infos[0].variants[rel_orients[0]])
        if not base_set:
            continue

        shifts: list[tuple[int, int]] = [(0, 0)] * n
        aligned: list[set[tuple[int, int]]] = []
        aligned.append(base_set)
        valid = True
        pair_overlap = 0

        for i in range(1, n):
            v_pts = infos[i].variants[rel_orients[i]]
            src = _as_set(v_pts)
            shift, overlap = _best_shift(src, base_set)
            if overlap <= 0:
                valid = False
                break
            shifted = _translate_points(src, shift[0], shift[1])
            aligned.append(shifted)
            shifts[i] = shift

        if not valid:
            continue

        all_points = set().union(*aligned)
        if not all_points:
            continue

        for i in range(n):
            for j in range(i + 1, n):
                pair_overlap += len(aligned[i] & aligned[j])

        bbox = _bbox_from_set(all_points)
        if bbox is None:
            continue
        span = (bbox[2] - bbox[0] + 1) + (bbox[3] - bbox[1] + 1)
        if best is None:
            best = {
                \"score\": (pair_overlap, -span, -len(all_points)),
                \"shifts\": shifts,
                \"orients\": rel_orients,
                \"aligned\": aligned,
            }
            continue

        score = (pair_overlap, -span, -len(all_points))
        best_score = best[\"score\"]
        if score > best_score:
            best = {
                \"score\": score,
                \"shifts\": shifts,
                \"orients\": rel_orients,
                \"aligned\": aligned,
            }

    if best is None:
        raise AssertionError(\"failed to solve registration for four copies\")

    shifts = best[\"shifts\"]  # type: ignore[assignment]
    orients = best[\"orients\"]  # type: ignore[assignment]
    all_points = set().union(*best[\"aligned\"])  # type: ignore[union-attr]

    # Normalize canonical coords so all are non-negative.
    r0, c0, r1, c1 = _bbox_from_set(all_points)
    canonical_union = {(_r - r0, _c - c0) for (_r, _c) in all_points}
    shifts = [(dr - r0, dc - c0) for dr, dc in shifts]

    return shifts, orients, list(infos[0].shape), list(canonical_union), canonical_union

def _fill_from_registration(g: np.ndarray, infos: list[SpriteInfo], bg: int, shifts: list[tuple[int, int]], orients: list[int], canonical_set: set[tuple[int, int]]) -> np.ndarray:
    out = np.full_like(g, int(bg), dtype=int)
    full_mask = set(canonical_set)

    # Reconstruct by mapping each cell in canonical shape through each copy's rotation,
    # then checking that the back-rotated coordinate exists in the canonical full mask.
    for idx, info in enumerate(infos):
        color = info.color
        ori = orients[idx]
        shift = shifts[idx]
        rot_h, rot_w = info.variant_shapes[ori]
        h0, w0 = info.shape
        dr, dc = shift

        for cr, cc in full_mask:
            if cr - dr < -200 or cc - dc < -200:
                continue
            p = _rotate_point((cr - dr, cc - dc), rot_h, rot_w, (4 - ori) % 4)
            if p not in full_mask:
                continue

            lr, lc = p
            if not (0 <= lr < h0 and 0 <= lc < w0):
                continue
            gr = info.origin[0] + lr
            gc = info.origin[1] + lc
            if not (0 <= gr < g.shape[0] and 0 <= gc < g.shape[1]):
                continue
            out[gr, gc] = color

    return out


def main(grid: np.ndarray) -> np.ndarray:
    \"\"\"Reconstruct four rotated sprite copies and remove gray occluders.

    Input structure:
    - The grid is on a uniform background.
    - There are four disjoint colored sprites of distinct colors; each is one copy of the same mask rotated by 0/90/180/270 degrees.
    - A separate gray patch covers a connected occluder area on each sprite, sometimes including adjacent background cells.

    Rule:
    - Identify the gray color and the four sprite colors, then align the four color masks by choosing which rotation each mask uses.
    - In a shared normalized coordinate system, union the aligned visible color masks to recover the complete shared mask.
    - For each canonical masked cell and each copy, map the cell back through the inverse registration transform and paint that copy's color;
      otherwise paint background.

    Key insight:
    - The full mask is recoverable from the union of partially visible rotated copies, so occluders can be replaced by finding the correct shared registration
      across the four 90-degree variants.
    \"\"\"
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, \"expected a non-empty 2D grid\"

    bg = get_bg(g)
    gray, sprite_colors = _identify_gray_and_sprites(g, bg)
    infos = _collect_sprite_infos(g, bg, gray, sprite_colors)

    shifts, orients, _, canonical_set, _ = _solve_copy_placement(infos)
    return _fill_from_registration(g, infos, bg, shifts, orients, canonical_set)


# ------------------------- generators -------------------------

GEN_ATTEMPTS = 2500
GEN_CANVAS_R = (16, 30)
GEN_CANVAS_C = (16, 30)
GEN_BASE_H = (4, 8)
GEN_BASE_W = (4, 8)


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def _rand_base_mask() -> np.ndarray:
    for _ in range(400):
        h = random.randint(*GEN_BASE_H)
        w = random.randint(*GEN_BASE_W)
        total = h * w
        min_area = max(5, total // 4)
        target = random.randint(min_area, max(min_area + 1, int(total * 0.85)))

        r, c = random.randrange(h), random.randrange(w)
        mask = np.zeros((h, w), dtype=bool)
        mask[r, c] = True
        area = 1
        frontier = [(r, c)]

        while area < target:
            fr, fc = random.choice(frontier)
            options = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = fr + dr, fc + dc
                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
                    options.append((nr, nc))
            if options:
                nr, nc = random.choice(options)
            else:
                nr, nc = random.randint(0, h - 1), random.randint(0, w - 1)
            if not bool(mask[nr, nc]):
                mask[nr, nc] = True
                area += 1
                frontier.append((nr, nc))

        # reject near-symmetric masks and too thin line-shapes.
        if np.array_equal(mask, np.rot90(mask, 1)):
            continue
        if np.array_equal(mask, np.rot90(mask, 2)):
            continue
        if np.array_equal(mask, np.rot90(mask, 3)):
            continue

        if int(mask.sum()) < 6:
            continue
        if int(mask.sum()) > total - 2:
            continue

        return mask

    raise RuntimeError(\"failed to generate a robust base mask\")


def _can_place(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, *, pad: int = 1) -> bool:
    H, W = occupied.shape
    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
        return False

    r1 = max(0, r0 - pad)
    c1 = max(0, c0 - pad)
    r2 = min(H, r0 + h + pad)
    c2 = min(W, c0 + w + pad)
    return not bool(occupied[r1:r2, c1:c2].any())


def _patch_bbox(mask: np.ndarray, origin: tuple[int, int], canvas: np.ndarray) -> tuple[int, int, int, int] | None:
    h, w = mask.shape
    r0, c0 = origin
    local = canvas[r0 : r0 + h, c0 : c0 + w] == True  # noqa: E712
    return _bbox_from_mask(local)


def _random_connected_block(local_h: int, local_w: int, max_area: int, must_touch_sprite: bool, must_touch_bg: bool) -> set[tuple[int, int]]:
    for _ in range(600):
        area = random.randint(1, max(1, max_area))
        sr = random.randint(0, local_h - 1)
        sc = random.randint(0, local_w - 1)

        block = {(sr, sc)}
        while len(block) < area:
            edges: list[tuple[int, int]] = []
            for r, c in block:
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < local_h and 0 <= nc < local_w and (nr, nc) not in block:
                        edges.append((nr, nc))
            if not edges:
                break
            block.add(random.choice(edges))

        if len(block) < area:
            continue

        if must_touch_sprite and not any(mask[r, c] for r, c in block):
            continue
        if must_touch_bg and not any(not mask[r, c] for r, c in block):
            continue

        return block
    return set()


def _all_base_cells_visible(
    base_mask: np.ndarray,
    placements: list[dict[str, object]],
    inp: np.ndarray,
    gray: int,
) -> bool:
    h0, w0 = base_mask.shape
    visible = np.zeros((h0, w0), dtype=bool)
    for info in placements:
        rot = int(info[\"rot\"])
        origin = info[\"origin\"]
        patch = np.rot90(base_mask, rot)
        h, w = patch.shape
        for lr, lc in np.argwhere(patch):
            rr = int(origin[0]) + int(lr)
            cc = int(origin[1]) + int(lc)
            if inp[rr, cc] == int(info[\"color\"]):
                br, bc = _rotate_point((int(lr), int(lc)), h, w, (4 - rot) % 4)
                if 0 <= br < h0 and 0 <= bc < w0:
                    visible[br, bc] = True

    return bool(visible.all())


def _build_expected_output(
    base_mask: np.ndarray,
    placements: list[dict[str, object]],
    rows: int,
    cols: int,
) -> tuple[np.ndarray, np.ndarray]:
    inp = np.full((rows, cols), Color.BLACK, dtype=int)
    out = np.full((rows, cols), Color.BLACK, dtype=int)

    for info in placements:
        rot = int(info[\"rot\"])
        origin = info[\"origin\"]
        color = int(info[\"color\"])
        patch = np.rot90(base_mask, rot)
        r0, c0 = origin
        h, w = patch.shape
        for lr, lc in np.argwhere(patch):
            rr = r0 + int(lr)
            cc = c0 + int(lc)
            inp[rr, cc] = color
            out[rr, cc] = color

    return inp, out


def _apply_occluder(
    inp: np.ndarray,
    out: np.ndarray,
    occupied: np.ndarray,
    color: int,
    gray: int,
    origin: tuple[int, int],
    patch: np.ndarray,
) -> bool:
    h, w = patch.shape
    r0, c0 = origin

    include_bg = random.random() < 0.8
    block = _random_connected_block(
        h,
        w,
        max_area=max(2, int(patch.sum() * 0.5)),
        must_touch_sprite=True,
        must_touch_bg=include_bg,
    )
    if not block:
        return False

    # apply temporary occluder, then validate
    patch_color = patch.copy()
    before_bbox = _bbox_from_mask(patch_color)
    if before_bbox is None:
        return False

    # no overlap with other colors already on canvas
    for lr, lc in block:
        gr = r0 + lr
        gc = c0 + lc
        if not _in_bounds(inp.shape, gr, gc):
            return False
        v = int(inp[gr, gc])
        if v not in (Color.BLACK, color):
            return False

    for lr, lc in block:
        gr = r0 + lr
        gc = c0 + lc
        if int(inp[gr, gc]) == color:
            inp[gr, gc] = gray
            patch_color[lr, lc] = False
        elif inp[gr, gc] == Color.BLACK:
            inp[gr, gc] = gray

    after_local = inp[r0 : r0 + h, c0 : c0 + w] == color

    after_bbox = _bbox_from_mask(after_local)
    if after_bbox "'!= before_bbox:
        return False

    # keep at least one visible cell and keep some occluded cells.
    if patch_color.sum() == 0:
        return False
    if not _all_base_cells_visible(
        patch,
        [{"rot": 0, "origin": (r0, c0), "color": color}],
        inp,
        gray,
    ):
        return False
    if int((patch_color == True).sum()) == int(patch.sum()):
        return False
    if int((patch.sum() - patch_color.sum())) > int(patch.sum() * 0.75):
        return False

    occupied |= (inp == gray) | (inp == color)
    return True


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        rows = random.randint(*GEN_CANVAS_R)
        cols = random.randint(*GEN_CANVAS_C)

        base_mask = _rand_base_mask()
        h0, w0 = base_mask.shape
        if h0 > rows or w0 > cols:
            continue

        colors = [c for c in Color.NOT_BLACK if c != Color.GRAY]
        random.shuffle(colors)
        colors = colors[:4]

        # fixed rotations for this instance but shuffled color order keeps variance.
        rotations = [0, 1, 2, 3]
        random.shuffle(rotations)

        inp = np.full((rows, cols), Color.BLACK, dtype=int)
        out = np.full((rows, cols), Color.BLACK, dtype=int)
        occupied = np.zeros((rows, cols), dtype=bool)

        placements: list[dict[str, object]] = []
        okay = True

        for color, rot in zip(colors, rotations):
            patch = np.rot90(base_mask, rot)
            h, w = patch.shape

            # Find a free placement with separation.
            found = False
            for _ in range(250):
                r0 = random.randint(0, rows - h)
                c0 = random.randint(0, cols - w)
                if _can_place(occupied, r0, c0, h, w, pad=2):
                    found = True
                    break
            if not found:
                okay = False
                break

            # Draw full color patch into both inp/out canvases.
            rr, cc = np.where(patch)
            for rr0, cc0 in zip(rr.tolist(), cc.tolist()):
                gr = r0 + int(rr0)
                gc = c0 + int(cc0)
                inp[gr, gc] = color
                out[gr, gc] = color

            occupied[r0 : r0 + h, c0 : c0 + w] = True

            # Keep a small padded occupied region for less touching between copies.
            rr0, cc0 = max(0, r0 - 2), max(0, c0 - 2)
            rr1, cc1 = min(rows, r0 + h + 2), min(cols, c0 + w + 2)
            occupied[rr0:rr1, cc0:cc1] = True

            placements.append({"color": color, "origin": (r0, c0), "rot": rot, "patch": patch})

        if not okay:
            continue

        # Apply one occluder per copy.
        occ_for_check = np.zeros((rows, cols), dtype=bool)
        for info in placements:
            color = int(info["color"])
            origin = info["origin"]
            patch = info["patch"]
            if not _apply_occluder(inp, out, occ_for_check, color, Color.GRAY, origin, patch):
                okay = False
                break

        if not okay:
            continue

        if not _all_base_cells_visible(base_mask, placements, inp, Color.GRAY):
            continue

        try:
            if not np.array_equal(main(inp), out):
                continue
        except Exception:
            continue

        if int(inp.max()) > 30:
            continue

        return inp.astype(int)

    raise RuntimeError("failed to generate a valid input")
