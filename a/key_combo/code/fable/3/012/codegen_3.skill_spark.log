        return False

    r1 = max(0, r0 - pad)
    c1 = max(0, c0 - pad)
    r2 = min(H, r0 + h + pad)
    c2 = min(W, c0 + w + pad)
    return not bool(occupied[r1:r2, c1:c2].any())


