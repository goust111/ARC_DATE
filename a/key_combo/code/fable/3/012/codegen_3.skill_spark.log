+def _is_connected(mask: np.ndarray) -> bool:
+    h, w = map(int, mask.shape)
+    if not mask.any():
+        return False
+    seen = np.zeros((h, w), dtype=bool)
+    queue: list[tuple[int, int]] = []
+    start = tuple(map(int, np.argwhere(mask)[0]))
+    seen[start] = True
+    queue.append(start)
+    count = 1
 
+    for r, c in queue:
