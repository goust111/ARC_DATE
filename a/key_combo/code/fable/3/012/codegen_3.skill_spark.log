from __future__ import annotations

import itertools
import random
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable

import numpy as np
from numpy.typing import NDArray

from collections import Counter

_UTILS = Path("/home/lixinyu/snap/new/solvers")
if str(_UTILS) not in sys.path:
    sys.path.append(str(_UTILS))

from arc_utils import Color, components_mask, colors_present, get_bg

Grid = NDArray[np.integer]


@dataclass
class SpriteInfo:
    color: int
    coords: NDArray[np.integer]
    origin: tuple[int, int]
    shape: tuple[int, int]
    variants: list[NDArray[np.integer]]
    variant_shapes: list[tuple[int, int]]


def _as_set(coords: NDArray[np.integer]) -> set[tuple[int, int]]:
    return {(int(r), int(c)) for r, c in np.asarray(coords, dtype=int)}


def _bbox_from_set(points: set[tuple[int, int]]) -> tuple[int, int, int, int] | None:
    if not points:
        return None
    rs, cs = zip(*points)
    return min(rs), min(cs), max(rs), max(cs)


def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    if not bool(mask.any()):
        return None
    rows, cols = np.where(mask)
    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())


def _rotate_point(
    p: tuple[int, int] | list[int] | NDArray[np.integer],
    h: int,
    w: int,
    k: int,
) -> tuple[int, int]:
    r, c = int(p[0]), int(p[1])
    k &= 3
    if k == 0:
        return r, c
    if k == 1:
        return c, h - 1 - r
    if k == 2:
        return h - 1 - r, w - 1 - c
    return w - 1 - c, r


def _rotate_points(coords: NDArray[np.integer], h: int, w: int, k: int) -> NDArray[np.integer]:
    pts = np.asarray(coords, dtype=int)
    if pts.size == 0:
        return np.empty((0, 2), dtype=int)

    k &= 3
    r = pts[:, 0]
    c = pts[:, 1]
    if k == 0:
        rr, cc = r, c
    elif k == 1:
        rr, cc = c, (h - 1) - r
    elif k == 2:
        rr, cc = (h - 1) - r, (w - 1) - c
    else:
        rr, cc = (w - 1) - c, r

    return np.column_stack([rr.astype(int), cc.astype(int)])


def _shape_for_rotation(h: int, w: int, k: int) -> tuple[int, int]:
    return (h, w) if (k & 1) == 0 else (w, h)


def _translate_points(points: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
    return {(r + dr, c + dc) for r, c in points}


def _best_shift(src: set[tuple[int, int]], dst: set[tuple[int, int]]) -> tuple[tuple[int, int], int]:
    if not src or not dst:
        return (0, 0), 0

    counter: Counter[tuple[int, int]] = Counter()
    for sr, sc in src:
        for dr, dc in dst:
            counter[(dr - sr, dc - sc)] += 1

    if not counter:
        return (0, 0), 0

    # Prefer max overlap first, then compact shifts.
    best = None
    for shift, overlap in counter.items():
        if best is None:
            best = (shift, overlap)
            continue
        if overlap > best[1]:
            best = (shift, overlap)
        elif overlap == best[1]:
            dr, dc = shift
            bdr, bdc = best[0]
            if abs(dr) + abs(dc) < abs(bdr) + abs(bdc):
                best = (shift, overlap)

    return best[0], int(best[1])


def _identify_gray_and_sprites(g: np.ndarray, bg: int) -> tuple[int, list[int]]:
    cols = colors_present(g, exclude={bg})
    if len(cols) < 2:
        raise AssertionError("expected at least one occluder and several sprite colors")

    stats = []
    for c in cols:
        comps = components_mask(g == int(c), connectivity=4)
        area = int(np.sum(g == int(c)))
        stats.append((int(len(comps)), area, int(c)))

    stats_sorted = sorted(stats, key=lambda t: (t[0], t[1], -t[2]))
    gray = int(stats_sorted[-1][2])

    sprite_colors = [c for c in cols if c != gray]
    if len(sprite_colors) != 4:
        # fallback: if stats are ambiguous, prefer the color most close to Gray and force 4 others.
        # This keeps the solver deterministic for the required generation profile.
        alt = [t for t in stats if t[2] != gray]
        if len(alt) != 4:
            raise AssertionError("expected exactly four sprite colors")
        sprite_colors = [int(c) for c in alt]

    return gray, sprite_colors


def _collect_sprite_infos(g: np.ndarray, bg: int, gray: int, colors: Iterable[int]) -> list[SpriteInfo]:
    infos: list[SpriteInfo] = []
    for color in sorted(map(int, colors)):
        m = (g == color)
        coords = np.argwhere(m)
        if coords.size == 0:
            raise AssertionError(f"empty color {color}")

        r0, c0 = int(coords[:, 0].min()), int(coords[:, 1].min())
        r1, c1 = int(coords[:, 0].max()), int(coords[:, 1].max())
        local = np.asarray(coords - np.array([r0, c0]), dtype=int)
        h, w = r1 - r0 + 1, c1 - c0 + 1

        variants: list[NDArray[np.integer]] = []
        variant_shapes: list[tuple[int, int]] = []
        for k in range(4):
            variants.append(_rotate_points(local, h, w, k))
            variant_shapes.append(_shape_for_rotation(h, w, k))

        infos.append(
            SpriteInfo(
                color=color,
                coords=coords,
                origin=(r0, c0),
                shape=(h, w),
                variants=variants,
                variant_shapes=variant_shapes,
            )
        )

    return infos


def _solve_copy_placement(
    infos: list[SpriteInfo],
) -> tuple[list[tuple[int, int]], list[NDArray[np.integer]], list[int], set[tuple[int, int]]]:
    n = len(infos)
    if n != 4:
        raise AssertionError("expected four sprites")

    best: dict[str, object] | None = None

    for perm in itertools.permutations(range(4), 4):
        # Fix a relative reference orientation by removing the first copy's assigned rotation.
        base = perm[0]
        rel_orients = [(int(perm[i]) - int(base)) % 4 for i in range(4)]

        base_set = _as_set(infos[0].variants[rel_orients[0]])
        if not base_set:
            continue

        shifts: list[tuple[int, int]] = [(0, 0)] * n
        aligned: list[set[tuple[int, int]]] = []
        aligned.append(base_set)
        valid = True
        pair_overlap = 0

        for i in range(1, n):
            v_pts = infos[i].variants[rel_orients[i]]
            src = _as_set(v_pts)
            shift, overlap = _best_shift(src, base_set)
            if overlap <= 0:
                valid = False
                break
            shifted = _translate_points(src, shift[0], shift[1])
            aligned.append(shifted)
            shifts[i] = shift

        if not valid:
            continue

        all_points = set().union(*aligned)
        if not all_points:
            continue

        for i in range(n):
            for j in range(i + 1, n):
                pair_overlap += len(aligned[i] & aligned[j])

        bbox = _bbox_from_set(all_points)
        if bbox is None:
            continue
        span = (bbox[2] - bbox[0] + 1) + (bbox[3] - bbox[1] + 1)
        if best is None:
            best = {
                "score": (pair_overlap, -span, -len(all_points)),
                "shifts": shifts,
                "orients": rel_orients,
                "aligned": aligned,
            }
            continue

        score = (pair_overlap, -span, -len(all_points))
        best_score = best["score"]
        if score > best_score:
            best = {
                "score": score,
                "shifts": shifts,
                "orients": rel_orients,
                "aligned": aligned,
            }

    if best is None:
        raise AssertionError("failed to solve registration for four copies")

    shifts = best["shifts"]  # type: ignore[assignment]
    orients = best["orients"]  # type: ignore[assignment]
    all_points = set().union(*best["aligned"])  # type: ignore[union-attr]

    # Normalize canonical coords so all are non-negative.
    r0, c0, r1, c1 = _bbox_from_set(all_points)
    canonical_union = {(_r - r0, _c - c0) for (_r, _c) in all_points}
    shifts = [(dr - r0, dc - c0) for dr, dc in shifts]

    return shifts, orients, list(infos[0].shape), list(canonical_union), canonical_union

def _fill_from_registration(g: np.ndarray, infos: list[SpriteInfo], bg: int, shifts: list[tuple[int, int]], orients: list[int], canonical_set: set[tuple[int, int]]) -> np.ndarray:
    out = np.full_like(g, int(bg), dtype=int)
    full_mask = set(canonical_set)

    # Reconstruct by mapping each cell in canonical shape through each copy's rotation,
    # then checking that the back-rotated coordinate exists in the canonical full mask.
    for idx, info in enumerate(infos):
        color = info.color
        ori = orients[idx]
        shift = shifts[idx]
        rot_h, rot_w = info.variant_shapes[ori]
        h0, w0 = info.shape
        dr, dc = shift

        for cr, cc in full_mask:
            if cr - dr < -200 or cc - dc < -200:
                continue
            p = _rotate_point((cr - dr, cc - dc), rot_h, rot_w, (4 - ori) % 4)
            if p not in full_mask:
                continue

            lr, lc = p
            if not (0 <= lr < h0 and 0 <= lc < w0):
                continue
            gr = info.origin[0] + lr
            gc = info.origin[1] + lc
            if not (0 <= gr < g.shape[0] and 0 <= gc < g.shape[1]):
                continue
            out[gr, gc] = color

    return out


def main(grid: np.ndarray) -> np.ndarray:
    """Reconstruct four rotated sprite copies and remove gray occluders.

    Input structure:
    - The grid is on a uniform background.
    - There are four disjoint colored sprites of distinct colors; each is one copy of the same mask rotated by 0/90/180/270 degrees.
    - A separate gray patch covers a connected occluder area on each sprite, sometimes including adjacent background cells.

    Rule:
    - Identify the gray color and the four sprite colors, then align the four color masks by choosing which rotation each mask uses.
    - In a shared normalized coordinate system, union the aligned visible color masks to recover the complete shared mask.
    - For each canonical masked cell and each copy, map the cell back through the inverse registration transform and paint that copy's color;
      otherwise paint background.

    Key insight:
    - The full mask is recoverable from the union of partially visible rotated copies, so occluders can be replaced by finding the correct shared registration
      across the four 90-degree variants.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"

    bg = get_bg(g)
    gray, sprite_colors = _identify_gray_and_sprites(g, bg)
    infos = _collect_sprite_infos(g, bg, gray, sprite_colors)

    shifts, orients, _, canonical_set, _ = _solve_copy_placement(infos)
    return _fill_from_registration(g, infos, bg, shifts, orients, canonical_set)


