+    start = (random.randrange(h), random.randrange(w))
+    cells = {start}
+    frontier = set(_neighbors4(start[0], start[1], h, w))
+
+    while len(cells) < area and frontier:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
