+    area_total = h * w
+    max_area = area_total if allow_full else area_total - 1
+    if max_area < 1:
+        return None
+
+    min_area = 1 if area_total <= 2 or random.random() < 0.2 else 2
+    min_area = min(min_area, max_area)
