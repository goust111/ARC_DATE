+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(mask.shape, r, c):
+            if mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return seen
+
+
+def _count_components(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            seen[r, c] = True
+            stack = [(r, c)]
+            while stack:
+                cr, cc = stack.pop()
+                for nr, nc in _neighbors4(mask.shape, cr, cc):
