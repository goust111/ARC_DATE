+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
