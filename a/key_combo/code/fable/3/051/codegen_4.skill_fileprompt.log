+def _color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(grid == color):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
