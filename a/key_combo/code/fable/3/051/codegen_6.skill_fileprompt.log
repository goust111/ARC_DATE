+    used_keys: set[tuple[int, int]] = set()
+
+    for block in blocks:
+        color = int(block["color"])
+        hole_r, hole_c = block["hole"]
+        candidates = [
+            key
+            for key in singletons_by_color.get(color, [])
+            if key not in used_keys and ((key[0] == hole_r) ^ (key[1] == hole_c))
