+PALETTE = tuple(range(1, 10))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GENERATION_ATTEMPTS = 400
+BLOCK_PLACEMENT_ATTEMPTS = 300
+DISTRACTOR_PLACEMENT_ATTEMPTS = 200
