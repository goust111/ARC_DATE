+
+def _sweep_cells(r0: int, c0: int, h: int, w: int, dr: int, dc: int) -> set[tuple[int, int]]:
+    rr0 = min(r0, r0 + dr)
+    cc0 = min(c0, c0 + dc)
+    rr1 = max(r0 + h - 1, r0 + dr + h - 1)
+    cc1 = max(c0 + w - 1, c0 + dc + w - 1)
