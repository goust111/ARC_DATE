+        if int(comp["area"]) == 1:
+            coord = tuple(map(int, comp["coords"][0]))
+            singletons_by_color.setdefault(color, []).append(coord)
+            continue
+
+        r0, c0, r1, c1 = comp["bbox"]
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        hole_coords = np.argwhere(patch == BACKGROUND)
