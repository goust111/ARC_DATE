  57:     max_area = max(int(comp["area"]) for comp in comps)
  58:     main_candidates = [comp for comp in comps if int(comp["area"]) == max_area]
  59:     assert len(main_candidates) == 1, "main run must be the unique largest foreground object"
  60: 
  61:     main = main_candidates[0]
  62:     main_coords = _component_coords(main)
