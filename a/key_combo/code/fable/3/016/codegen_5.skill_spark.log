  27: def _runs(values: list[int]) -> list[tuple[int, int]]:
  28:     if not values:
  29:         return []
  30: 
  31:     runs: list[tuple[int, int]] = []
  32:     start = prev = values[0]
  33:     for value in values[1:]:
  34:         if value == prev + 1:
  35:             prev = value
  36:             continue
  37:         runs.append((start, prev))
  38:         start = prev = value
  39:     runs.append((start, prev))
  40:     return runs
