  15: def _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:
  16:     mask = np.isin(g, marker_colors)
  17:     candidates: list[tuple[int, int, int, int]] = []
  18:     for coords in components_mask(mask, connectivity=8):
  19:         r0, c0, r1, c1 = bbox_coords(coords)
  20:         if r0 == 0:
  21:             candidates.append((r0, c0, r1, c1))
