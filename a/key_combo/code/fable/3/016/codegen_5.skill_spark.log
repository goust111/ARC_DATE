   9: # description:
  10: # In the input, you will see a grid with a row of colored blocks on the bottom and the right. 
  11: # There is also a square in the top left that is not touching the other colors.
  12: # To make the output:
  13: # 1. count the number of colors that aren't black
  14: # 2. enlarge every pixel in the input by a factor of the number of colors
  15: # 3. add diagonal red lines coming out of the corners of the square in the top left portion of the grid
  16: 
  17: def main(input_grid):
  18:     """
  19:     Scale the whole grid by its number of non-black colors and draw red diagonals from the enlarged square's corners.
  20: 
  21:     Input structure:
  22:     - The grid has non-black color runs on the bottom row and right column.
  23:     - A separate non-black square sits away from those border runs.
  24:     - The number of distinct non-black colors determines the scale factor.
  25: 
  26:     Rule:
  27:     - Count distinct non-black colors and magnify every input pixel by that factor.
  28:     - Find the enlarged square component in the scaled output.
  29:     - Draw red diagonal rays outward from the four corners until they meet non-black cells or the edge.
  30: 
  31:     Key insight:
  32:     - Border colors encode the numeric scale, while the isolated square anchors the added
  33:       diagonal construction after scaling.
  34:     """
  35:     # count the number of colors that aren't black
  36:     num_colors = len(set(map(int, np.unique(input_grid))) - {Color.BLACK})
  37:     if num_colors <= 0:
  38:         return np.copy(input_grid)
  39: 
  40:     # magnify the pixels in input grid onto the output grid
  41:     output_grid = np.repeat(np.repeat(input_grid, num_colors, axis=0), num_colors, axis=1)
  42: 
  43:     # find the square in the output grid
  44:     objects = find_components(output_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
  45:     square = next(obj for obj in objects if int(obj[-1, -1]) == Color.BLACK)
  46:     
  47:     # find the bounding box of the square
  48:     b = bbox(square != Color.BLACK)
  49:     assert b is not None
  50:     r0, c0, r1, c1 = b
  51: 
  52:     # draw the diagonal red lines
  53:     stop_at = set(Color.NOT_BLACK)
  54:     L = max(output_grid.shape) * 3
  55:     draw_line(output_grid, r0 - 1, c0 - 1, length=L, color=Color.RED, direction=(-1, -1), stop_at=stop_at, clip=True)
  56:     draw_line(output_grid, r1 + 1, c1 + 1, length=L, color=Color.RED, direction=(1, 1), stop_at=stop_at, clip=True)
  57:     draw_line(output_grid, r0 - 1, c1 + 1, length=L, color=Color.RED, direction=(-1, 1), stop_at=stop_at, clip=True)
  58:     draw_line(output_grid, r1 + 1, c0 - 1, length=L, color=Color.RED, direction=(1, -1), stop_at=stop_at, clip=True)
  59: 
  60:     return output_grid
  61: 
