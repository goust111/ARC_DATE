  57:             continue
  58: 
  59:         for c in cols:
  60:             if int(base[floor_r, c]) != obstacle:
  61:                 continue
  62:             has_horizontal_neighbor = (
  63:                 (c > 0 and int(base[floor_r, c - 1]) == obstacle)
  64:                 or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)
  65:             )
  66:             if has_horizontal_neighbor:
  67:                 return True
  68: 
  69:     return False
