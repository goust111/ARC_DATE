   7: def _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:
   8:     counts = [(int(np.sum(g == color)), int(color)) for color in colors]
   9:     max_count = max(count for count, _color in counts)
  10:     winners = [color for count, color in counts if count == max_count]
  11:     assert len(winners) == 1, "expected one most numerous non-background obstacle color"
  12:     return winners[0]
