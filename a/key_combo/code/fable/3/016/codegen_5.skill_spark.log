  29: def main(grid: np.ndarray) -> np.ndarray:
  30:     """Rotate each vertical bar's color one slot right and its height one slot left.
  31: 
  32:     Input structure
  33:     - A dominant background surrounds several monochrome one-cell-wide vertical bars.
  34:     - Every bar is bottom-aligned and occupies a distinct column.
  35:     - The ordered bar slots are read from left to right.
  36: 
  37:     Rule
  38:     - Keep the grid shape and the bar columns unchanged.
  39:     - At slot i, use the color from the previous slot cyclically.
  40:     - At slot i, use the height from the next slot cyclically.
  41: 
  42:     Key insight
  43:     - Color and height are independent cyclic attributes of the ordered bar slots:
  44:       colors rotate right while heights rotate left.
  45:     """
  46:     g = np.asarray(grid, dtype=int)
  47:     height = g.shape[0]
  48:     bg = get_bg(g)
  49:     bars = _extract_bars(g, bg)
  50: 
  51:     out = np.full_like(g, bg)
  52:     count = len(bars)
  53:     for i, bar in enumerate(bars):
  54:         color = bars[(i - 1) % count]["color"]
  55:         bar_height = bars[(i + 1) % count]["height"]
  56:         assert 1 <= bar_height <= height
  57:         out[height - bar_height : height, bar["col"]] = color
  58: 
  59:     return out
  60: 
