  70: COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]
  71: OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1
  72: # Retry limit.
  73: MAX_GENERATION_ATTEMPTS = 300
  74: 
