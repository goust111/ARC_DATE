+
+def _bbox_has_visible_sides(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> bool:
+    """Require each frame side to have at least one visible pixel in the input."""
+    coords = np.argwhere(grid == color)
+    if coords.size == 0:
+        return False
+    r0, c0, r1, c1 = bbox
+    rs = coords[:, 0]
