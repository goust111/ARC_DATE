+    color_set = set(colors)
+    for start in colors:
+        dfs((start,), color_set - {start})
+        if len(paths) > 1:
+            break
+
+    assert len(paths) == 1, "occlusion relations do not define a unique depth chain"
+    return list(paths[0])
