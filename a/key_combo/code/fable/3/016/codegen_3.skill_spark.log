    r1, c1 = coords.max(axis=0)
    crop = panel[r0 : r1 + 1, c0 : c1 + 1]
    crop_content = content[r0 : r1 + 1, c0 : c1 + 1]

    colors = np.unique(crop[crop_content])
    assert len(colors) == 1
    color = int(colors[0])
    mask = crop == color
    assert np.array_equal(mask, crop_content)
