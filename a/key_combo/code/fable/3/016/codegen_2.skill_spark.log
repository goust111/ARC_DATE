from pathlib import Path

import numpy as np


def _load_arc_utils():
    \"\"\"Load arc_utils from the repository even when this file is loaded directly.\"\"\"
    try:
        import arc_utils as mod  # type: ignore
        return mod
    except Exception:
        candidates = [
            Path(__file__).resolve().parents[6] / \"new\" / \"solvers\" / \"arc_utils.py\",
