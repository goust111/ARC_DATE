# Canvas and palette.
GEN_H_RANGE = (12, 18)
GEN_W_RANGE = (10, 17)
GEN_CENTER_MARGIN = 1
GEN_BACKGROUND_COLOR, GEN_PLUS_COLOR, GEN_CONNECTOR_COLOR = Color.BLACK, Color.GREEN, Color.RED

# Counts and topology.
GEN_PLUS_COUNT_RANGE = (3, 5)
GEN_PAIR_COUNT_RANGE = (1, 3)
GEN_HUB_PROB_FOR_FOUR_PLUSES = 0.5

# Diagonal connector geometry and placement retries.
GEN_PAIR_DISTANCE_RANGE = (3, 7)
GEN_GAP_LEN_RANGE = (2, 5)
GEN_PAIR_ATTEMPTS = 160
GEN_DIRECTIONS = ((1, 1), (1, -1), (-1, 1), (-1, -1))

# Object separation and outer retry budget.
GEN_CENTER_MIN_CHEBYSHEV = 3
GEN_PLUS_TOUCH_RADIUS = 1
GEN_GENERATE_ATTEMPTS = 300

GEN_PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
GEN_PLUS_SPRITE = np.array(
    [[0, GEN_PLUS_COLOR, 0], [GEN_PLUS_COLOR, GEN_PLUS_COLOR, GEN_PLUS_COLOR], [0, GEN_PLUS_COLOR, 0]],
    dtype=int,
)


def _gen_plus_cells(center):
    r, c = center
    return tuple((r + dr, c + dc) for dr, dc in GEN_PLUS_OFFSETS)


def _gen_all_plus_cells(centers):
    cells = set()
    for center in centers:
        cells.update(_gen_plus_cells(center))
    return cells


def _gen_center_ok(center, h, w):
    r, c = center
    return GEN_CENTER_MARGIN <= r < h - GEN_CENTER_MARGIN and GEN_CENTER_MARGIN <= c < w - GEN_CENTER_MARGIN


def _gen_centers_far(centers):
    for i, (r1, c1) in enumerate(centers):
        for r2, c2 in centers[i + 1 :]:
            if max(abs(r2 - r1), abs(c2 - c1)) < GEN_CENTER_MIN_CHEBYSHEV:
                return False
    return True


def _gen_pluses_separate(centers):
    groups = [set(_gen_plus_cells(center)) for center in centers]
    for i, first in enumerate(groups):
        for second in groups[i + 1 :]:
            for r1, c1 in first:
                for r2, c2 in second:
                    if max(abs(r2 - r1), abs(c2 - c1)) <= GEN_PLUS_TOUCH_RADIUS:
                        return False
    return True


def _gen_gap_cells(a, b):
    r1, c1 = a
    r2, c2 = b
    dr, dc = r2 - r1, c2 - c1
    if abs(dr) != abs(dc):
        return ()
    sr = (dr > 0) - (dr < 0)
    sc = (dc > 0) - (dc < 0)
    return tuple((r1 + k * sr, c1 + k * sc) for k in range(1, abs(dr)))


def _gen_edge(a, b):
    return tuple(sorted((a, b)))


def _gen_no_extra_diagonal(new_centers, old_centers, allowed_base=None):
    for r1, c1 in new_centers:
        for old in old_centers:
            if allowed_base is not None and old == allowed_base:
                continue
            r2, c2 = old
            if abs(r2 - r1) == abs(c2 - c1):
                return False
    return True


def _gen_pair_ok(h, w, a, b, centers, red_cells):
    if not all(_gen_center_ok(center, h, w) for center in centers):
        return False
    if not _gen_centers_far(centers) or not _gen_pluses_separate(centers):
        return False
    gap = _gen_gap_cells(a, b)
    if not GEN_GAP_LEN_RANGE[0] <= len(gap) <= GEN_GAP_LEN_RANGE[1]:
        return False
    plus_cells = _gen_all_plus_cells(centers)
    return not any(cell in plus_cells or cell in red_cells for cell in gap)


def _gen_make_pair(h, w, centers, red_cells, base=None):
    for _ in range(GEN_PAIR_ATTEMPTS):
        dist = int(np.random.randint(*GEN_PAIR_DISTANCE_RANGE))
        sr, sc = GEN_DIRECTIONS[int(np.random.randint(0, len(GEN_DIRECTIONS)))]
        if base is None:
            r_low = max(GEN_CENTER_MARGIN, GEN_CENTER_MARGIN - sr * dist)
            r_high = min(h - GEN_CENTER_MARGIN - 1, h - GEN_CENTER_MARGIN - 1 - sr * dist)
            c_low = max(GEN_CENTER_MARGIN, GEN_CENTER_MARGIN - sc * dist)
            c_high = min(w - GEN_CENTER_MARGIN - 1, w - GEN_CENTER_MARGIN - 1 - sc * dist)
            if r_low > r_high or c_low > c_high:
                continue
            a = (
                int(np.random.randint(r_low, r_high + 1)),
                int(np.random.randint(c_low, c_high + 1)),
            )
            b = (a[0] + sr * dist, a[1] + sc * dist)
            new_centers = [a, b]
        else:
            a = base
            b = (a[0] + sr * dist, a[1] + sc * dist)
            if not _gen_center_ok(b, h, w):
                continue
            new_centers = [b]

        if any(center in centers for center in new_centers):
            continue
        if not _gen_no_extra_diagonal(new_centers, centers, allowed_base=base):
            continue
        trial_centers = centers + new_centers
        if _gen_pair_ok(h, w, a, b, trial_centers, red_cells):
            return a, b
    return None


import numpy as np

import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste, random_sprite

# concepts:
# counting, resizing

# description:
# In the input, you will see a grid with a row of colored blocks on the bottom and the right. 
# There is also a square in the top left that is not touching the other colors.
# To make the output:
# 1. count the number of colors that aren't black
# 2. enlarge every pixel in the input by a factor of the number of colors
# 3. add diagonal red lines coming out of the corners of the square in the top left portion of the grid

def main(input_grid):
    """
    Scale the whole grid by its number of non-black colors and draw red diagonals from the enlarged square's corners.

    Input structure:
    - The grid has non-black color runs on the bottom row and right column.
    - A separate non-black square sits away from those border runs.
    - The number of distinct non-black colors determines the scale factor.

    Rule:
    - Count distinct non-black colors and magnify every input pixel by that factor.
    - Find the enlarged square component in the scaled output.
    - Draw red diagonal rays outward from the four corners until they meet non-black cells or the edge.

    Key insight:
    - Border colors encode the numeric scale, while the isolated square anchors the added
      diagonal construction after scaling.
    """
    # count the number of colors that aren't black
    num_colors = len(set(map(int, np.unique(input_grid))) - {Color.BLACK})
    if num_colors <= 0:
        return np.copy(input_grid)

    # magnify the pixels in input grid onto the output grid
    output_grid = np.repeat(np.repeat(input_grid, num_colors, axis=0), num_colors, axis=1)

    # find the square in the output grid
    objects = find_components(output_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
    square = next(obj for obj in objects if int(obj[-1, -1]) == Color.BLACK)
    
    # find the bounding box of the square
    b = bbox(square != Color.BLACK)
    assert b is not None
    r0, c0, r1, c1 = b

    # draw the diagonal red lines
    stop_at = set(Color.NOT_BLACK)
    L = max(output_grid.shape) * 3
    draw_line(output_grid, r0 - 1, c0 - 1, length=L, color=Color.RED, direction=(-1, -1), stop_at=stop_at, clip=True)
    draw_line(output_grid, r1 + 1, c1 + 1, length=L, color=Color.RED, direction=(1, 1), stop_at=stop_at, clip=True)
    draw_line(output_grid, r0 - 1, c1 + 1, length=L, color=Color.RED, direction=(-1, 1), stop_at=stop_at, clip=True)
    draw_line(output_grid, r1 + 1, c0 - 1, length=L, color=Color.RED, direction=(1, -1), stop_at=stop_at, clip=True)

    return output_grid

def generate_input():
    # make a 5x5 black grid for the background
    n = m = 5
    grid = np.zeros((n,m), dtype=int)

    # pick the colors for the bottom and right of the grid
    colors = list(Color.NOT_BLACK)

    # construct a random sequence of colors for the bottom and right of the grid
    # don't repeat a color in the sequence
    sequence = []
    while len(sequence) < 5:
        # select a color
        color = np.random.choice(colors)
        # remove the color from the array of remaining colors
        colors = np.delete(colors, np.where(colors == color))
        length = np.random.randint(1, 6 - len(sequence))
        sequence.extend([color] * length)

    # put the same sequence on the bottom and right of the grid
    grid[-1, :] = sequence
    grid[:, -1] = sequence

    # pick the color of the square
    square_color = np.random.choice(list(Color.NOT_BLACK))
    
    # make the square
    square_sprite = random_sprite(2, 2, density=1, color_palette=[square_color])

    # put the square on the grid so it doesn't touch the bottom or right
    _loc = first_free_location(grid, square_sprite, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    paste(grid, square_sprite, r, c, transparent=Color.BLACK, clip=True)
    
    return grid


