GEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1
GRID_SIZE_RANGE = (14, 16)
MARKER_SIZE = 3
STOP_COUNT_RANGE = (1, 3)
OBSTACLE_COMPONENT_RANGE = (7, 9)
OBSTACLE_PIXEL_RANGE = (20, 31)
COMPONENT_SIZE_RANGE = (1, 11)
MIN_STOP_OBSTACLE_ROW = 6
DROP_ZONE_HEIGHT = 3
COMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300


def _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:
    grid = np.full((H, W), GEN_BG, dtype=int)
    c0 = random.randint(0, W - MARKER_SIZE)
    num_stops = random.randint(*STOP_COUNT_RANGE)
    positions = list(range(MARKER_SIZE))
    random.shuffle(positions)
    stop_positions = sorted(positions[:num_stops])
    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)
    for j in stop_positions:
        marker[MARKER_SIZE - 1, j] = GEN_STOP
    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker
    obstacle_pixels: set[tuple[int, int]] = set()
    for j in stop_positions:
        col = c0 + j
        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)
        grid[first_obs_row, col] = GEN_OBSTACLE
        obstacle_pixels.add((first_obs_row, col))
    return grid, c0, stop_positions, obstacle_pixels


def _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:
    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}
    for j in stop_positions:
        col = c0 + j
        for r in range(MARKER_SIZE, H):
            if (r, col) not in obstacle_pixels:
                continue
            for dr in range(1, DROP_ZONE_HEIGHT + 1):
                if r - dr >= 0:
                    forbidden.add((r - dr, col))
            break
    return forbidden


def _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:
    component_sizes = []
    left = total_pixels
    min_size, max_size = COMPONENT_SIZE_RANGE
    for i in range(component_count):
        remaining = component_count - i - 1
        if remaining == 0:
            size = left
        else:
            lo = max(min_size, left - max_size * remaining)
            hi = min(max_size, left - min_size * remaining)
            if lo > hi:
                return None
            size = random.randint(lo, hi)
        left -= size
        if size < min_size or size > max_size:
            return None
        component_sizes.append(size)
    random.shuffle(component_sizes)
    return component_sizes


def _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],
                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:
    H, W = grid.shape
    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)
    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:
    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:
        return None

    comp = {(sr, sc)}
    frontier = [(sr, sc)]
    while len(comp) < comp_size and frontier:
        random.shuffle(frontier)
        expanded = False
        for fr, fc in frontier:
            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]
            random.shuffle(nbrs)
            for nr, nc in nbrs:
                if (0 <= nr < H and 0 <= nc < W
                        and (nr, nc) not in forbidden
                        and (nr, nc) not in obstacle_pixels
                        and (nr, nc) not in comp
                        and grid[nr, nc] == GEN_BG):
                    comp.add((nr, nc))
                    frontier.append((nr, nc))
                    expanded = True
                    break
            if expanded:
                break
        if not expanded:
            break
    return comp if len(comp) == comp_size else None


def _place_obstacle_components(grid: np.ndarray, component_sizes: list[int], forbidden: set[tuple[int, int]],
                               obstacle_pixels: set[tuple[int, int]]) -> bool:
    for comp_size in component_sizes:
        placed = False
        for _ in range(COMPONENT_PLACEMENT_ATTEMPTS):
            comp = _grow_component(grid, comp_size, forbidden, obstacle_pixels)
            if comp is None:
                continue
            if any((pr + dr, pc + dc) in obstacle_pixels
                   for pr, pc in comp for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]):
                continue
            for pr, pc in comp:
                grid[pr, pc] = GEN_OBSTACLE
                obstacle_pixels.add((pr, pc))
            placed = True
            break
        if not placed:
            return False
    return True


def _scatter_obstacles(grid: np.ndarray, c0: int, stop_positions: list[int],
                       obstacle_pixels: set[tuple[int, int]]) -> bool:
    H, _W = grid.shape
    num_target_components = random.randint(*OBSTACLE_COMPONENT_RANGE)
    total_target_pixels = random.randint(*OBSTACLE_PIXEL_RANGE)
    remaining_pixels = max(0, total_target_pixels - len(obstacle_pixels))
    remaining_components = max(1, num_target_components - len(stop_positions))
    if remaining_pixels <= 0 or remaining_components <= 0:
        return True

    component_sizes = _sample_component_sizes(remaining_pixels, remaining_components)
    if component_sizes is None:
        return False
    forbidden = _forbidden_cells(H, c0, stop_positions, obstacle_pixels)
    return _place_obstacle_components(grid, component_sizes, forbidden, obstacle_pixels)


def _has_clear_stop_drop_zones(grid: np.ndarray, c0: int, stop_positions: list[int]) -> bool:
    H, _W = grid.shape
    for j in stop_positions:
        col = c0 + j
        first_obs = next((r for r in range(MARKER_SIZE, H) if grid[r, col] == GEN_OBSTACLE), None)
        if first_obs is None:
            return False
        for dr in range(1, DROP_ZONE_HEIGHT + 1):
            if first_obs - dr < 0 or grid[first_obs - dr, col] != GEN_BG:
                return False
    return True


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(*GRID_SIZE_RANGE)
    W = random.randint(*GRID_SIZE_RANGE)
    grid, c0, stop_positions, obstacle_pixels = _init_scene(H, W)

    if not _scatter_obstacles(grid, c0, stop_positions, obstacle_pixels):
        return None
    if not _has_clear_stop_drop_zones(grid, c0, stop_positions):
        return None
    obs_comps = [c for c in find_components(grid, bg=GEN_BG, connectivity=4, monochromatic=True)
                 if c['color'] == GEN_OBSTACLE]
    if not (OBSTACLE_COMPONENT_RANGE[0] <= len(obs_comps) <= OBSTACLE_COMPONENT_RANGE[1]):
        return None

    # Run solver to verify no assertion failures
    try:
        main(grid)
    except Exception:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts")
    return tuple(sorted((a, b)))


def _gen_no_extra_diagonal(new_centers, old_centers, allowed_base=None):
    for r1, c1 in new_centers:
        for old in old_centers:
            if allowed_base is not None and old == allowed_base:
                continue
            r2, c2 = old
            if abs(r2 - r1) == abs(c2 - c1):
                return False
    return True


def _gen_pair_ok(h, w, a, b, centers, red_cells):
    if not all(_gen_center_ok(center, h, w) for center in centers):
        return False
    if not _gen_centers_far(centers) or not _gen_pluses_separate(centers):
        return False
    gap = _gen_gap_cells(a, b)
    if not GEN_GAP_LEN_RANGE[0] <= len(gap) <= GEN_GAP_LEN_RANGE[1]:
        return False
    plus_cells = _gen_all_plus_cells(centers)
    return not any(cell in plus_cells or cell in red_cells for cell in gap)


def _gen_make_pair(h, w, centers, red_cells, base=None):
    for _ in range(GEN_PAIR_ATTEMPTS):
        dist = int(np.random.randint(*GEN_PAIR_DISTANCE_RANGE))
        sr, sc = GEN_DIRECTIONS[int(np.random.randint(0, len(GEN_DIRECTIONS)))]
        if base is None:
            r_low = max(GEN_CENTER_MARGIN, GEN_CENTER_MARGIN - sr * dist)
            r_high = min(h - GEN_CENTER_MARGIN - 1, h - GEN_CENTER_MARGIN - 1 - sr * dist)
            c_low = max(GEN_CENTER_MARGIN, GEN_CENTER_MARGIN - sc * dist)
            c_high = min(w - GEN_CENTER_MARGIN - 1, w - GEN_CENTER_MARGIN - 1 - sc * dist)
            if r_low > r_high or c_low > c_high:
                continue
            a = (
                int(np.random.randint(r_low, r_high + 1)),
                int(np.random.randint(c_low, c_high + 1)),
            )
            b = (a[0] + sr * dist, a[1] + sc * dist)
            new_centers = [a, b]
        else:
            a = base
            b = (a[0] + sr * dist, a[1] + sc * dist)
            if not _gen_center_ok(b, h, w):
                continue
            new_centers = [b]

        if any(center in centers for center in new_centers):
            continue
        if not _gen_no_extra_diagonal(new_centers, centers, allowed_base=base):
            continue
        trial_centers = centers + new_centers
        if _gen_pair_ok(h, w, a, b, trial_centers, red_cells):
            return a, b
    return None



import random

import numpy as np
from typing import *
from arc_utils import Color, colors_present, draw_line, find_components, paste

# concepts:
# growing, connecting

# description:
# In the input you will see two pixels of different colors aligned horizontally or vertically.
# To make the output, you need to connect the two pixels with two lines and a hollow rectangle of size 4x5 in the middle.
# Half of the rectangle is colored with the color of the one side's pixel, and the other half with the color of the other side's pixel.

def main(input_grid):
    """
    Connect two aligned colored pixels through a centered split-color hollow rectangle.

    Input structure:
    - Two single pixels of different colors are aligned horizontally or vertically.
    - The background is black.
    - There is enough space between the pixels for the hollow rectangle bridge.

    Rule:
    - Rotate vertical cases into a horizontal canonical form.
    - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
    - Paste it midway between the pixels and connect each pixel to the nearest side.

    Key insight:
    - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
    """
    # Plan (from the original seed solver):
    # 1. Parse the input
    # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
    # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
    # 4. Place the rectangle in the middle of the two pixels
    # 5. Draw lines to connect the original two pixels with the rectangle
    # 6. Rotate the grid back if it was not originally horizontal
    #
    # Implementation note:
    # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
    #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
    comps = find_components(
        input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
    )
    if len(comps) != 2:
        return input_grid.copy()

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))

    rotated = False
    grid = input_grid
    if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
        grid = np.rot90(grid)
        rotated = True

    comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
    if len(comps) != 2:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))
    c0 = int(comps[0]["color"])
    c1 = int(comps[1]["color"])

    # Should now be horizontally aligned
    if p0[0] != p1[0]:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    # Sort left->right by column
    if p0[1] <= p1[1]:
        left_pos, right_pos = p0, p1
        left_color, right_color = c0, c1
    else:
        left_pos, right_pos = p1, p0
        left_color, right_color = c1, c0

    r = left_pos[0]
    c_left = left_pos[1]
    c_right = right_pos[1]

    output_grid = grid.copy()

    # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
    # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
    rect_h, rect_w = 5, 4
    rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
    rect[:, 0] = left_color
    rect[:, -1] = right_color
    rect[0, : rect_w // 2] = left_color
    rect[0, rect_w // 2 :] = right_color
    rect[-1, : rect_w // 2] = left_color
    rect[-1, rect_w // 2 :] = right_color

    middle_c = (c_left + c_right + 1) // 2
    paste(
        output_grid,
        rect,
        r - rect_h // 2,
        middle_c - rect_w // 2,
        transparent=Color.BLACK,
        clip=True,
    )

    # Connect left/right pixels to the rectangle via horizontal lines
    draw_line(
        grid=output_grid,
        r=r,
        c=c_left + 1,
        direction=(0, 1),
        color=left_color,
        stop_at=Color.NOT_BLACK,
    )
    draw_line(
        grid=output_grid,
        r=r,
        c=c_right - 1,
        direction=(0, -1),
        color=right_color,
        stop_at=Color.NOT_BLACK,
    )

    if rotated:
        output_grid = np.rot90(output_grid, k=-1)
    return output_grid

def generate_input():
    # Generate a random background grid
    # Make sure the grid's width is greater than its height
    width, height = random.randint(15, 20), random.randint(10, 15)
    grid = np.zeros((width, height), dtype=int)

    # Get the color of two pixels
    colors = np.random.choice(Color.NOT_BLACK, 2, replace=False)
    color1, color2 = colors

    # Place the two pixels on the grid horizontally (randomly rotate at the end to get a variety of orientations)
    x1 = np.random.randint(0, width)
    x2 = np.random.randint(0, width)
    c = np.random.randint(0, height)

    # Ensure there is enough horizontal distance to place the 4x5 rectangle
    distance = abs(x2 - x1)
    rectangle_width, rectangle_height = 4, 5
    if distance < rectangle_width+1: return generate_input()

    # Ensure the remaining distance is odd, so that we can split the pixel colors in half between them
    if (distance - rectangle_width) % 2 != 1: return generate_input()

    # Ensure there is enough vertical space to place the rectangle
    if c < rectangle_height // 2 or c + rectangle_height // 2 >= height: return generate_input()    

    # Place the two pixels on the grid
    grid[x1, c] = color1
    grid[x2, c] = color2

    # Randomly rotate the whole grid
    if np.random.rand() < 0.5:
        grid = np.rot90(grid, k=-1)

    return grid

