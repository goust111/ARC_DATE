import random

import numpy as np
from typing import *
from arc_utils import Color, colors_present, draw_line, find_components, paste

# concepts:
# growing, connecting

# description:
# In the input you will see two pixels of different colors aligned horizontally or vertically.
# To make the output, you need to connect the two pixels with two lines and a hollow rectangle of size 4x5 in the middle.
# Half of the rectangle is colored with the color of the one side's pixel, and the other half with the color of the other side's pixel.

def main(input_grid):
    """
    Connect two aligned colored pixels through a centered split-color hollow rectangle.

    Input structure:
    - Two single pixels of different colors are aligned horizontally or vertically.
    - The background is black.
    - There is enough space between the pixels for the hollow rectangle bridge.

    Rule:
    - Rotate vertical cases into a horizontal canonical form.
    - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
    - Paste it midway between the pixels and connect each pixel to the nearest side.

    Key insight:
    - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
    """
    # Plan (from the original seed solver):
    # 1. Parse the input
    # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
    # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
    # 4. Place the rectangle in the middle of the two pixels
    # 5. Draw lines to connect the original two pixels with the rectangle
    # 6. Rotate the grid back if it was not originally horizontal
    #
    # Implementation note:
    # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
    #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
    comps = find_components(
        input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
    )
    if len(comps) != 2:
        return input_grid.copy()

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))

    rotated = False
    grid = input_grid
    if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
        grid = np.rot90(grid)
        rotated = True

    comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
    if len(comps) != 2:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))
    c0 = int(comps[0]["color"])
    c1 = int(comps[1]["color"])

    # Should now be horizontally aligned
    if p0[0] != p1[0]:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    # Sort left->right by column
    if p0[1] <= p1[1]:
        left_pos, right_pos = p0, p1
        left_color, right_color = c0, c1
    else:
        left_pos, right_pos = p1, p0
        left_color, right_color = c1, c0

    r = left_pos[0]
    c_left = left_pos[1]
    c_right = right_pos[1]

    output_grid = grid.copy()

    # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
    # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
    rect_h, rect_w = 5, 4
    rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
    rect[:, 0] = left_color
    rect[:, -1] = right_color
    rect[0, : rect_w // 2] = left_color
    rect[0, rect_w // 2 :] = right_color
    rect[-1, : rect_w // 2] = left_color
    rect[-1, rect_w // 2 :] = right_color

    middle_c = (c_left + c_right + 1) // 2
    paste(
        output_grid,
        rect,
        r - rect_h // 2,
        middle_c - rect_w // 2,
        transparent=Color.BLACK,
        clip=True,
    )

    # Connect left/right pixels to the rectangle via horizontal lines
    draw_line(
        grid=output_grid,
        r=r,
        c=c_left + 1,
        direction=(0, 1),
        color=left_color,
        stop_at=Color.NOT_BLACK,
    )
    draw_line(
        grid=output_grid,
        r=r,
        c=c_right - 1,
        direction=(0, -1),
        color=right_color,
        stop_at=Color.NOT_BLACK,
    )

    if rotated:
        output_grid = np.rot90(output_grid, k=-1)
    return output_grid

def generate_input():
    # Generate a random background grid
    # Make sure the grid's width is greater than its height
    width, height = random.randint(15, 20), random.randint(10, 15)
    grid = np.zeros((width, height), dtype=int)

    # Get the color of two pixels
    colors = np.random.choice(Color.NOT_BLACK, 2, replace=False)
    color1, color2 = colors

    # Place the two pixels on the grid horizontally (randomly rotate at the end to get a variety of orientations)
    x1 = np.random.randint(0, width)
    x2 = np.random.randint(0, width)
    c = np.random.randint(0, height)

    # Ensure there is enough horizontal distance to place the 4x5 rectangle
    distance = abs(x2 - x1)
    rectangle_width, rectangle_height = 4, 5
    if distance < rectangle_width+1: return generate_input()

    # Ensure the remaining distance is odd, so that we can split the pixel colors in half between them
    if (distance - rectangle_width) % 2 != 1: return generate_input()

    # Ensure there is enough vertical space to place the rectangle
    if c < rectangle_height // 2 or c + rectangle_height // 2 >= height: return generate_input()    

    # Place the two pixels on the grid
    grid[x1, c] = color1
    grid[x2, c] = color2

    # Randomly rotate the whole grid
    if np.random.rand() < 0.5:
        grid = np.rot90(grid, k=-1)

    return grid
import numpy as np

from arc_utils import find_components, get_bg


def _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:
    height = g.shape[0]
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert len(components) >= 2

    bars: list[dict[str, int]] = []
    for comp in components:
        r0, c0, r1, c1 = map(int, comp["bbox"])
        color = int(comp["color"])
        area = int(comp["area"])

        assert c0 == c1
        assert r1 == height - 1
        assert area == r1 - r0 + 1
        assert bool(np.all(g[r0 : r1 + 1, c0] == color))

        bars.append({"color": color, "col": c0, "height": area})

    bars.sort(key=lambda bar: bar["col"])
    assert len({bar["col"] for bar in bars}) == len(bars)
    return bars


def main(grid: np.ndarray) -> np.ndarray:
    """Rotate each vertical bar's color one slot right and its height one slot left.

    Input structure
    - A dominant background surrounds several monochrome one-cell-wide vertical bars.
    - Every bar is bottom-aligned and occupies a distinct column.
    - The ordered bar slots are read from left to right.

    Rule
    - Keep the grid shape and the bar columns unchanged.
    - At slot i, use the color from the previous slot cyclically.
    - At slot i, use the height from the next slot cyclically.

    Key insight
    - Color and height are independent cyclic attributes of the ordered bar slots:
      colors rotate right while heights rotate left.
    """
    g = np.asarray(grid, dtype=int)
    height = g.shape[0]
    bg = get_bg(g)
    bars = _extract_bars(g, bg)

    out = np.full_like(g, bg)
    count = len(bars)
    for i, bar in enumerate(bars):
        color = bars[(i - 1) % count]["color"]
        bar_height = bars[(i + 1) % count]["height"]
        assert 1 <= bar_height <= height
        out[height - bar_height : height, bar["col"]] = color

    return out

# --------------- generator (o5x) ---------------

_RNG = np.random.default_rng()

# Canvas/bar bounds.
BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6
BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1
BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2
# Color and transform sampling.
COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]
OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1
# Retry limit.
MAX_GENERATION_ATTEMPTS = 300


def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)
    for i, (color, bar_height) in enumerate(zip(colors, heights)):
        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET
        grid[side - int(bar_height) : side, col] = int(color)
    return grid


def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)
    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)
    return _render_bars(n, out_colors, out_heights)


def _gen_attempt() -> np.ndarray | None:
    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))
    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)
    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)
    if len(set(map(int, heights))) == 1:
        idx = int(_RNG.integers(n))
        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]
        heights[idx] = int(_RNG.choice(choices))

    grid = _render_bars(n, colors, heights)
    if np.array_equal(main(grid), _expected_output(n, colors, heights)):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
import numpy as np

import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste, random_sprite

# concepts:
# counting, resizing

# description:
# In the input, you will see a grid with a row of colored blocks on the bottom and the right. 
# There is also a square in the top left that is not touching the other colors.
# To make the output:
# 1. count the number of colors that aren't black
# 2. enlarge every pixel in the input by a factor of the number of colors
# 3. add diagonal red lines coming out of the corners of the square in the top left portion of the grid

def main(input_grid):
    """
    Scale the whole grid by its number of non-black colors and draw red diagonals from the enlarged square's corners.

    Input structure:
    - The grid has non-black color runs on the bottom row and right column.
    - A separate non-black square sits away from those border runs.
    - The number of distinct non-black colors determines the scale factor.

    Rule:
    - Count distinct non-black colors and magnify every input pixel by that factor.
    - Find the enlarged square component in the scaled output.
    - Draw red diagonal rays outward from the four corners until they meet non-black cells or the edge.

    Key insight:
    - Border colors encode the numeric scale, while the isolated square anchors the added
      diagonal construction after scaling.
    """
    # count the number of colors that aren't black
    num_colors = len(set(map(int, np.unique(input_grid))) - {Color.BLACK})
    if num_colors <= 0:
        return np.copy(input_grid)

    # magnify the pixels in input grid onto the output grid
    output_grid = np.repeat(np.repeat(input_grid, num_colors, axis=0), num_colors, axis=1)

    # find the square in the output grid
    objects = find_components(output_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
    square = next(obj for obj in objects if int(obj[-1, -1]) == Color.BLACK)
    
    # find the bounding box of the square
    b = bbox(square != Color.BLACK)
    assert b is not None
    r0, c0, r1, c1 = b

    # draw the diagonal red lines
    stop_at = set(Color.NOT_BLACK)
    L = max(output_grid.shape) * 3
    draw_line(output_grid, r0 - 1, c0 - 1, length=L, color=Color.RED, direction=(-1, -1), stop_at=stop_at, clip=True)
    draw_line(output_grid, r1 + 1, c1 + 1, length=L, color=Color.RED, direction=(1, 1), stop_at=stop_at, clip=True)
    draw_line(output_grid, r0 - 1, c1 + 1, length=L, color=Color.RED, direction=(-1, 1), stop_at=stop_at, clip=True)
    draw_line(output_grid, r1 + 1, c0 - 1, length=L, color=Color.RED, direction=(1, -1), stop_at=stop_at, clip=True)

    return output_grid

def generate_input():
    # make a 5x5 black grid for the background
    n = m = 5
    grid = np.zeros((n,m), dtype=int)

    # pick the colors for the bottom and right of the grid
    colors = list(Color.NOT_BLACK)

    # construct a random sequence of colors for the bottom and right of the grid
    # don't repeat a color in the sequence
    sequence = []
    while len(sequence) < 5:
        # select a color
        color = np.random.choice(colors)
        # remove the color from the array of remaining colors
        colors = np.delete(colors, np.where(colors == color))
        length = np.random.randint(1, 6 - len(sequence))
        sequence.extend([color] * length)

    # put the same sequence on the bottom and right of the grid
    grid[-1, :] = sequence
    grid[:, -1] = sequence

    # pick the color of the square
    square_color = np.random.choice(list(Color.NOT_BLACK))
    
    # make the square
    square_sprite = random_sprite(2, 2, density=1, color_palette=[square_color])

    # put the square on the grid so it doesn't touch the bottom or right
    _loc = first_free_location(grid, square_sprite, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    paste(grid, square_sprite, r, c, transparent=Color.BLACK, clip=True)
    
    return grid


