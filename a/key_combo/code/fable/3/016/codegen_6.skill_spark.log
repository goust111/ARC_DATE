import random


def _unique_largest_count_color(g: np.ndarray, colors: list[int]) -> int:
    counts = [(int(np.sum(g == color)), int(color)) for color in colors]
    max_count = max(count for count, _color in counts)
    winners = [color for count, color in counts if count == max_count]
    assert len(winners) == 1, "expected one most numerous non-background obstacle color"
    return winners[0]


def _marker_bbox(g: np.ndarray, marker_colors: list[int]) -> tuple[int, int, int, int]:
    mask = np.isin(g, marker_colors)
    candidates: list[tuple[int, int, int, int]] = []
    for coords in components_mask(mask, connectivity=8):
        r0, c0, r1, c1 = bbox_coords(coords)
        if r0 == 0:
            candidates.append((r0, c0, r1, c1))

    assert len(candidates) == 1, "expected one top-edge marker component"
    return candidates[0]


def _runs(values: list[int]) -> list[tuple[int, int]]:
    if not values:
        return []

    runs: list[tuple[int, int]] = []
    start = prev = values[0]
    for value in values[1:]:
        if value == prev + 1:
            prev = value
            continue
        runs.append((start, prev))
        start = prev = value
    runs.append((start, prev))
    return runs


def _can_slide_right(base: np.ndarray, obstacle: int, bg: int, cols: list[int], marker_bottom_r: int, height: int) -> bool:
    H, W = base.shape
    assert cols
    if cols[-1] + 1 >= W:
        return False

    for floor_r in range(marker_bottom_r + 1, H):
        target_rows = np.arange(floor_r - height + 1, floor_r + 1)
        if int(target_rows[0]) < 0:
            continue

        shifted_cols = [c + 1 for c in cols]
        target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)
        if not target_is_clear:
            continue

        for c in cols:
            if int(base[floor_r, c]) != obstacle:
                continue
            has_horizontal_neighbor = (
                (c > 0 and int(base[floor_r, c - 1]) == obstacle)
                or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)
            )
            if has_horizontal_neighbor:
                return True

    return False


def _clear_bottom_edge_gap(base: np.ndarray, out: np.ndarray, obstacle: int, bg: int, c: int, width: int) -> None:
    H, W = base.shape
    if int(base[H - 1, c]) != obstacle:
        return

    c1 = c
    while c1 < W and int(base[H - 1, c1]) == obstacle:
        c1 += 1

    if c1 - c >= width:
        out[H - 1, c + 1 : c + width] = bg


def main(grid: np.ndarray) -> np.ndarray:
    """Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.

    Input structure
    - The background is the dominant color.
    - The most numerous non-background color forms stationary grey obstacle pixels.
    - The other two colors form a single 3x3 top-edge marker whose top two rows
      are maroon and whose bottom row contains maroon or blue control pixels.

    Rule
    - Erase the top marker.
    - Treat each marker column as a vertical drop retaining its three colors.
    - A column whose bottom control pixel is blue stops immediately above the
      first grey pixel below that column, or bottom-aligns if none exists.
    - Contiguous maroon-ended columns pass through obstacles and bottom-align;
      if such a run has a clear down-right slide from a grey ledge, shift the
      run one column right before bottom-aligning.
    - When a maroon-ended drop lands through a grey bar on the bottom edge, clear
      the rest of the marker-width gap in that bottom bar.

    Key insight
    - The bottom row of the top marker is a control strip: blue cells mean
      "stick to the first obstacle," while maroon cells mean "fall through."
    """
    g = np.asarray(grid, dtype=int)
    H = g.shape[0]
    bg = int(get_bg(g))

    non_bg = colors_present(g, exclude={bg})
    assert len(non_bg) == 3, "expected obstacle color plus two marker colors"
    obstacle = _unique_largest_count_color(g, non_bg)
    marker_colors = [color for color in non_bg if color != obstacle]
    assert len(marker_colors) == 2, "expected exactly two marker colors"

    r0, c0, r1, c1 = _marker_bbox(g, marker_colors)
    marker = g[r0 : r1 + 1, c0 : c1 + 1]
    marker_h, marker_w = marker.shape
    assert (marker_h, marker_w) == (3, 3), "expected a 3x3 marker"
    assert np.all(np.isin(marker, marker_colors)), "marker bbox must contain only marker colors"

    pass_color = int(marker[0, 0])
    assert np.all(marker[:2, :] == pass_color), "top two marker rows must be the pass-through color"
    stop_colors = [color for color in marker_colors if color != pass_color]
    assert len(stop_colors) == 1, "expected one stop color"
    stop_color = stop_colors[0]

    out = g.copy()
    out[r0 : r1 + 1, c0 : c1 + 1] = bg
    base = out.copy()

    pass_columns: list[int] = []
    for j in range(marker_w):
        c = c0 + j
        stack = marker[:, j]
        bottom_control = int(stack[-1])

        if bottom_control == stop_color:
            obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)
            if len(obstacles_below):
                floor_r = int(r1 + 1 + obstacles_below[0])
                top_r = floor_r - marker_h
            else:
                top_r = H - marker_h
            assert top_r >= 0, "stopped column must fit above its obstacle"
            out[top_r : top_r + marker_h, c] = stack
        else:
            assert bottom_control == pass_color, "bottom control must be one of the marker colors"
            pass_columns.append(j)

    for start_j, end_j in _runs(pass_columns):
        source_cols = list(range(c0 + start_j, c0 + end_j + 1))
        shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0
        top_r = H - marker_h

        for j in range(start_j, end_j + 1):
            c = c0 + j + shift
            _clear_bottom_edge_gap(base, out, obstacle, bg, c, marker_w)
            out[top_r : top_r + marker_h, c] = marker[:, j]

    return out

# --------------- generator (att1) ---------------

GEN_BG, GEN_OBSTACLE, GEN_PASS, GEN_STOP = 7, 5, 9, 1
GRID_SIZE_RANGE = (14, 16)
MARKER_SIZE = 3
STOP_COUNT_RANGE = (1, 3)
OBSTACLE_COMPONENT_RANGE = (7, 9)
OBSTACLE_PIXEL_RANGE = (20, 31)
COMPONENT_SIZE_RANGE = (1, 11)
MIN_STOP_OBSTACLE_ROW = 6
DROP_ZONE_HEIGHT = 3
COMPONENT_PLACEMENT_ATTEMPTS, GENERATION_ATTEMPTS = 100, 300


def _init_scene(H: int, W: int) -> tuple[np.ndarray, int, list[int], set[tuple[int, int]]]:
    grid = np.full((H, W), GEN_BG, dtype=int)
    c0 = random.randint(0, W - MARKER_SIZE)
    num_stops = random.randint(*STOP_COUNT_RANGE)
    positions = list(range(MARKER_SIZE))
    random.shuffle(positions)
    stop_positions = sorted(positions[:num_stops])
    marker = np.full((MARKER_SIZE, MARKER_SIZE), GEN_PASS, dtype=int)
    for j in stop_positions:
        marker[MARKER_SIZE - 1, j] = GEN_STOP
    grid[0:MARKER_SIZE, c0:c0 + MARKER_SIZE] = marker
    obstacle_pixels: set[tuple[int, int]] = set()
    for j in stop_positions:
        col = c0 + j
        first_obs_row = random.randint(MIN_STOP_OBSTACLE_ROW, H - 1)
        grid[first_obs_row, col] = GEN_OBSTACLE
        obstacle_pixels.add((first_obs_row, col))
    return grid, c0, stop_positions, obstacle_pixels


def _forbidden_cells(H: int, c0: int, stop_positions: list[int], obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]]:
    forbidden = {(r, c) for r in range(MARKER_SIZE) for c in range(c0, c0 + MARKER_SIZE)}
    for j in stop_positions:
        col = c0 + j
        for r in range(MARKER_SIZE, H):
            if (r, col) not in obstacle_pixels:
                continue
            for dr in range(1, DROP_ZONE_HEIGHT + 1):
                if r - dr >= 0:
                    forbidden.add((r - dr, col))
            break
    return forbidden


def _sample_component_sizes(total_pixels: int, component_count: int) -> list[int] | None:
    component_sizes = []
    left = total_pixels
    min_size, max_size = COMPONENT_SIZE_RANGE
    for i in range(component_count):
        remaining = component_count - i - 1
        if remaining == 0:
            size = left
        else:
            lo = max(min_size, left - max_size * remaining)
            hi = min(max_size, left - min_size * remaining)
            if lo > hi:
                return None
            size = random.randint(lo, hi)
        left -= size
        if size < min_size or size > max_size:
            return None
        component_sizes.append(size)
    random.shuffle(component_sizes)
    return component_sizes


def _grow_component(grid: np.ndarray, comp_size: int, forbidden: set[tuple[int, int]],
                    obstacle_pixels: set[tuple[int, int]]) -> set[tuple[int, int]] | None:
    H, W = grid.shape
    sr, sc = random.randint(0, H - 1), random.randint(0, W - 1)
    if (sr, sc) in forbidden or (sr, sc) in obstacle_pixels or grid[sr, sc] != GEN_BG:
        return None

    comp = {(sr, sc)}
    frontier = [(sr, sc)]
    while len(comp) < comp_size and frontier:
        random.shuffle(frontier)
        expanded = False
        for fr, fc in frontier:
            nbrs = [(fr - 1, fc), (fr + 1, fc), (fr, fc - 1), (fr, fc + 1)]
            random.shuffle(nbrs)
            for nr, nc in nbrs:
                if (0 <= nr < H and 0 <= nc < W
                        and (nr, nc) not in forbidden
                        and (nr, nc) not in obstacle_pixels
                        and (nr, nc) not in comp
                        and grid[nr, nc] == GEN_BG):
                    comp.add((nr, nc))
                    frontier.append((nr, nc))
                    expanded = True
                    break

import random

import numpy as np
from typing import *
from arc_utils import Color, colors_present, draw_line, find_components, paste

# concepts:
# growing, connecting

# description:
# In the input you will see two pixels of different colors aligned horizontally or vertically.
# To make the output, you need to connect the two pixels with two lines and a hollow rectangle of size 4x5 in the middle.
# Half of the rectangle is colored with the color of the one side's pixel, and the other half with the color of the other side's pixel.

def main(input_grid):
    """
    Connect two aligned colored pixels through a centered split-color hollow rectangle.

    Input structure:
    - Two single pixels of different colors are aligned horizontally or vertically.
    - The background is black.
    - There is enough space between the pixels for the hollow rectangle bridge.

    Rule:
    - Rotate vertical cases into a horizontal canonical form.
    - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
    - Paste it midway between the pixels and connect each pixel to the nearest side.

    Key insight:
    - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
    """
    # Plan (from the original seed solver):
    # 1. Parse the input
    # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
    # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
    # 4. Place the rectangle in the middle of the two pixels
    # 5. Draw lines to connect the original two pixels with the rectangle
    # 6. Rotate the grid back if it was not originally horizontal
    #
    # Implementation note:
    # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
    #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
    comps = find_components(
        input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
    )
    if len(comps) != 2:
        return input_grid.copy()

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))

    rotated = False
    grid = input_grid
    if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
        grid = np.rot90(grid)
        rotated = True

    comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
    if len(comps) != 2:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    p0 = tuple(map(int, comps[0]["coords"][0]))
    p1 = tuple(map(int, comps[1]["coords"][0]))
    c0 = int(comps[0]["color"])
    c1 = int(comps[1]["color"])

    # Should now be horizontally aligned
    if p0[0] != p1[0]:
        out = grid.copy()
        return np.rot90(out, k=-1) if rotated else out

    # Sort left->right by column
    if p0[1] <= p1[1]:
        left_pos, right_pos = p0, p1
        left_color, right_color = c0, c1
    else:
        left_pos, right_pos = p1, p0
        left_color, right_color = c1, c0

    r = left_pos[0]
    c_left = left_pos[1]
    c_right = right_pos[1]

    output_grid = grid.copy()

    # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
    # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
    rect_h, rect_w = 5, 4
    rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
    rect[:, 0] = left_color
    rect[:, -1] = right_color
    rect[0, : rect_w // 2] = left_color
    rect[0, rect_w // 2 :] = right_color
    rect[-1, : rect_w // 2] = left_color
    rect[-1, rect_w // 2 :] = right_color

    middle_c = (c_left + c_right + 1) // 2
    paste(
        output_grid,
        rect,
        r - rect_h // 2,
        middle_c - rect_w // 2,
        transparent=Color.BLACK,
        clip=True,
    )

    # Connect left/right pixels to the rectangle via horizontal lines
    draw_line(
        grid=output_grid,
        r=r,
        c=c_left + 1,
        direction=(0, 1),
        color=left_color,
        stop_at=Color.NOT_BLACK,
    )
    draw_line(
        grid=output_grid,
        r=r,
        c=c_right - 1,
        direction=(0, -1),
        color=right_color,
        stop_at=Color.NOT_BLACK,
    )

    if rotated:
        output_grid = np.rot90(output_grid, k=-1)
    return output_grid

def generate_input():
    # Generate a random background grid
    # Make sure the grid's width is greater than its height
    width, height = random.randint(15, 20), random.randint(10, 15)
    grid = np.zeros((width, height), dtype=int)

    # Get the color of two pixels
    colors = np.random.choice(Color.NOT_BLACK, 2, replace=False)
    color1, color2 = colors

    # Place the two pixels on the grid horizontally (randomly rotate at the end to get a variety of orientations)
    x1 = np.random.randint(0, width)
    x2 = np.random.randint(0, width)
    c = np.random.randint(0, height)

    # Ensure there is enough horizontal distance to place the 4x5 rectangle
    distance = abs(x2 - x1)
    rectangle_width, rectangle_height = 4, 5
    if distance < rectangle_width+1: return generate_input()

    # Ensure the remaining distance is odd, so that we can split the pixel colors in half between them
    if (distance - rectangle_width) % 2 != 1: return generate_input()

    # Ensure there is enough vertical space to place the rectangle
    if c < rectangle_height // 2 or c + rectangle_height // 2 >= height: return generate_input()    

    # Place the two pixels on the grid
    grid[x1, c] = color1
    grid[x2, c] = color2

    # Randomly rotate the whole grid
    if np.random.rand() < 0.5:
        grid = np.rot90(grid, k=-1)

    return grid
import numpy as np

from arc_utils import find_components, get_bg


def _extract_bars(g: np.ndarray, bg: int) -> list[dict[str, int]]:
    height = g.shape[0]
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert len(components) >= 2

    bars: list[dict[str, int]] = []
    for comp in components:
        r0, c0, r1, c1 = map(int, comp["bbox"])
        color = int(comp["color"])
        area = int(comp["area"])

        assert c0 == c1
        assert r1 == height - 1
        assert area == r1 - r0 + 1
        assert bool(np.all(g[r0 : r1 + 1, c0] == color))

        bars.append({"color": color, "col": c0, "height": area})

    bars.sort(key=lambda bar: bar["col"])
    assert len({bar["col"] for bar in bars}) == len(bars)
    return bars


def main(grid: np.ndarray) -> np.ndarray:
    """Rotate each vertical bar's color one slot right and its height one slot left.

    Input structure
    - A dominant background surrounds several monochrome one-cell-wide vertical bars.
    - Every bar is bottom-aligned and occupies a distinct column.
    - The ordered bar slots are read from left to right.

    Rule
    - Keep the grid shape and the bar columns unchanged.
    - At slot i, use the color from the previous slot cyclically.
    - At slot i, use the height from the next slot cyclically.

    Key insight
    - Color and height are independent cyclic attributes of the ordered bar slots:
      colors rotate right while heights rotate left.
    """
    g = np.asarray(grid, dtype=int)
    height = g.shape[0]
    bg = get_bg(g)
    bars = _extract_bars(g, bg)

    out = np.full_like(g, bg)
    count = len(bars)
    for i, bar in enumerate(bars):
        color = bars[(i - 1) % count]["color"]
        bar_height = bars[(i + 1) % count]["height"]
        assert 1 <= bar_height <= height
        out[height - bar_height : height, bar["col"]] = color

    return out

# --------------- generator (o5x) ---------------

_RNG = np.random.default_rng()

# Canvas/bar bounds.
BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE = 3, 6
BACKGROUND_COLOR, MIN_BAR_HEIGHT = 7, 1
BAR_COL_OFFSET, BAR_COL_STRIDE = 1, 2
# Color and transform sampling.
COLOR_POOL = [0, 1, 2, 3, 4, 5, 6, 8, 9]
OUTPUT_COLOR_SHIFT, OUTPUT_HEIGHT_SHIFT = 1, -1
# Retry limit.
MAX_GENERATION_ATTEMPTS = 300


def _render_bars(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
    grid = np.full((side, side), BACKGROUND_COLOR, dtype=int)
    for i, (color, bar_height) in enumerate(zip(colors, heights)):
        col = BAR_COL_STRIDE * i + BAR_COL_OFFSET
        grid[side - int(bar_height) : side, col] = int(color)
    return grid


def _expected_output(n: int, colors: np.ndarray, heights: np.ndarray) -> np.ndarray:
    out_colors = np.roll(colors, OUTPUT_COLOR_SHIFT)
    out_heights = np.roll(heights, OUTPUT_HEIGHT_SHIFT)
    return _render_bars(n, out_colors, out_heights)


def _gen_attempt() -> np.ndarray | None:
    n = int(_RNG.integers(BAR_COUNT_MIN, BAR_COUNT_MAX_EXCLUSIVE))
    side = BAR_COL_STRIDE * n + BAR_COL_OFFSET
    colors = _RNG.choice(COLOR_POOL, size=n, replace=False)
    heights = _RNG.integers(MIN_BAR_HEIGHT, side, size=n)
    if len(set(map(int, heights))) == 1:
        idx = int(_RNG.integers(n))
        choices = [h for h in range(MIN_BAR_HEIGHT, side) if h != int(heights[idx])]
        heights[idx] = int(_RNG.choice(choices))

    grid = _render_bars(n, colors, heights)
    if np.array_equal(main(grid), _expected_output(n, colors, heights)):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

from itertools import combinations

import numpy as np

from arc_utils import bbox_coords, colors_present, get_bg


def _frame_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    mask = np.zeros(shape, dtype=bool)
    mask[r0 : r1 + 1, c0] = True
    mask[r0 : r1 + 1, c1] = True
    mask[r0, c0 : c1 + 1] = True
    mask[r1, c0 : c1 + 1] = True
    return mask


def _color_frames(g: np.ndarray, bg: int) -> tuple[list[int], dict[int, np.ndarray]]:
    colors = colors_present(g, exclude={bg})
    assert len(colors) >= 2, "expected multiple foreground frame colors"

    frames: dict[int, np.ndarray] = {}
    for color in colors:
        coords = np.argwhere(g == color)
        assert coords.size > 0, "foreground colors must have visible pixels"
        r0, c0, r1, c1 = bbox_coords(coords)
        assert r1 > r0 and c1 > c0, "each color must define a rectangular frame"
        frame = _frame_mask(g.shape, (r0, c0, r1, c1))
        assert np.all(frame[g == color]), "visible pixels must lie on the inferred frame perimeter"
        frames[int(color)] = frame
    return colors, frames


def _crossing_edges(g: np.ndarray, colors: list[int], frames: dict[int, np.ndarray]) -> set[tuple[int, int]]:
    edges: set[tuple[int, int]] = set()
    for a, b in combinations(colors, 2):
        crossing = frames[a] & frames[b]
        for r_raw, c_raw in np.argwhere(crossing):
            r = int(r_raw)
            c = int(c_raw)
            visible = int(g[r, c])
            if visible == a:
                edges.add((b, a))
            elif visible == b:
                edges.add((a, b))
            else:
                assert visible in colors, "frame crossings must be covered by a foreground frame"
    assert edges, "expected visible crossings between frames"
    return edges


def _unique_path(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:
    outgoing = {color: [other for other in colors if (color, other) in edges] for color in colors}
    paths: list[tuple[int, ...]] = []

    def search(path: tuple[int, ...], remaining: set[int]) -> None:
        if not remaining:
            paths.append(path)
            return
        for nxt in outgoing[path[-1]]:
            if nxt in remaining:
                search((*path, nxt), remaining - {nxt})

    color_set = set(colors)
    for start in colors:
        search((start,), color_set - {start})

    assert len(paths) == 1, "crossings must determine a unique frame order"
    return list(paths[0])


def _render_nested(colors: list[int]) -> np.ndarray:
    size = 2 * len(colors) - 1
    out = np.empty((size, size), dtype=int)
    for layer, color in enumerate(colors):
        end = size - layer - 1
        out[layer : end + 1, layer] = color
        out[layer : end + 1, end] = color
        out[layer, layer : end + 1] = color
        out[end, layer : end + 1] = color
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Untangle overlapping colored rectangular frames into concentric square frames ordered by their visible crossings.

    Input structure
    - The background contains several one-cell-thick axis-aligned rectangular frames, one color per frame.
    - Frames overlap, and the visible color at an overlap records a directed crossing from the hidden frame to the visible frame.
    - Each foreground color still has visible pixels on the perimeter of its full rectangular bounding box.

    Rule
    - Infer each color's full rectangular frame from the bounding box of its visible pixels.
    - Add a directed edge A -> B when B is visible at a crossing of A and B's frame perimeters.
    - Find the unique path that visits every frame color once, then render those colors as one-pixel-thick concentric square frames from outside to inside.

    Key insight
    - The output is not a crop of the input; the crossing graph gives a single frame order, and that order is redrawn as nested rings.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"

    bg = get_bg(g)
    colors, frames = _color_frames(g, bg)
    edges = _crossing_edges(g, colors, frames)
    order = _unique_path(colors, edges)
    return _render_nested(order)

# --------------- generator (att1) ---------------

# Color and frame count bounds.
MIN_FRAME_COUNT = 5
MAX_FRAME_COUNT_EXCLUSIVE = 8
AVAILABLE_COLORS = list(range(1, 10))

# Square canvas and rectangular frame size bounds.
MIN_GRID_SIZE = 12
MAX_GRID_SIZE_EXCLUSIVE = 26
GRID_SIZE_PER_FRAME = 2
GRID_SIZE_PADDING = 2
MIN_FRAME_DIM = 3
MAX_FRAME_DIM = 13

# Rejection thresholds and retry budgets.
MIN_OVERLAP_DENSITY = 0.57
LAYOUT_ATTEMPTS = 50
PLACEMENT_ATTEMPTS = 150
GENERATION_ATTEMPTS = 300


def _choose_ordering(rng):
    """Return colors ordered from back/outermost to front/innermost."""
    n = rng.integers(MIN_FRAME_COUNT, MAX_FRAME_COUNT_EXCLUSIVE)
    colors = list(AVAILABLE_COLORS)
    rng.shuffle(colors)
    return list(colors[:n])


def _choose_grid_size(rng, n):
    min_size = max(MIN_GRID_SIZE, n * GRID_SIZE_PER_FRAME + GRID_SIZE_PADDING)
    return int(rng.integers(min_size, MAX_GRID_SIZE_EXCLUSIVE))


def _random_bbox(rng, size, min_dim, max_dim):
    h = rng.integers(min_dim, max_dim + 1)
    w = rng.integers(min_dim, max_dim + 1)
    r0 = rng.integers(0, size - h + 1)
    c0 = rng.integers(0, size - w + 1)
    return (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))


def _place_bboxes(rng, ordering, size):
    """Place frames so every consecutive pair has intersecting perimeters."""
    min_dim = MIN_FRAME_DIM
    max_dim = min(MAX_FRAME_DIM, size - 1)

    for _ in range(LAYOUT_ATTEMPTS):
        bboxes = {}
        ok = True
        for i, color in enumerate(ordering):
            if i == 0:
                bboxes[color] = _random_bbox(rng, size, min_dim, max_dim)
                continue

            placed = False
            for _ in range(PLACEMENT_ATTEMPTS):
                candidate = _random_bbox(rng, size, min_dim, max_dim)
                if _perimeters_overlap(candidate, bboxes[ordering[i - 1]]):
                    bboxes[color] = candidate
                    placed = True
                    break
            if not placed:
                ok = False
                break
        if ok:
            return bboxes
    return None


def _frame_masks_from_bboxes(bboxes, shape):
    masks = {}
    for color, (r0, c0, r1, c1) in bboxes.items():
        mask = np.zeros(shape, dtype=bool)
        mask[r0:r1 + 1, c0] = True
        mask[r0:r1 + 1, c1] = True
        mask[r0, c0:c1 + 1] = True
        mask[r1, c0:c1 + 1] = True
        masks[color] = mask
    return masks


def _front_edges(ordering, frame_masks):
    """Return overlap count and edges implied by back-to-front paint order."""
    edges = set()
    overlapping_pairs = 0
    for a, b in combinations(ordering, 2):
        crossing = frame_masks[a] & frame_masks[b]
        if crossing.any():
            overlapping_pairs += 1
            idx_a = ordering.index(a)
            idx_b = ordering.index(b)
            if idx_a < idx_b:
                edges.add((a, b))
            else:
                edges.add((b, a))
    return overlapping_pairs, edges


def _has_required_overlaps(ordering, overlapping_pairs, edges):
    n = len(ordering)
    total_pairs = n * (n - 1) // 2
    if total_pairs > 0 and overlapping_pairs / total_pairs < MIN_OVERLAP_DENSITY:
        return False
    return all((ordering[i], ordering[i + 1]) in edges for i in range(n - 1))


def _has_unique_order_path(ordering, edges):
    outgoing = {c: [o for o in ordering if (c, o) in edges] for c in ordering}
    paths = []

    def search(path, remaining):
        if len(paths) > 1:
            return
        if not remaining:
            paths.append(tuple(path))
            return
        for nxt in outgoing[path[-1]]:
            if nxt in remaining:
                search(path + [nxt], remaining - {nxt})

    color_set = set(ordering)
    for start in ordering:
        search([start], color_set - {start})
        if len(paths) > 1:
            break
    return len(paths) == 1 and list(paths[0]) == ordering


def _paint_frames(ordering, frame_masks, shape):
    grid = np.zeros(shape, dtype=int)
    for color in ordering:
        grid[frame_masks[color]] = color
    return grid


def _visible_pixels_span_bboxes(grid, ordering, bboxes):
    for color in ordering:
        visible = np.argwhere(grid == color)
        if visible.size == 0:
            return False
        vr0, vc0 = visible.min(axis=0)
        vr1, vc1 = visible.max(axis=0)
        if (vr0, vc0, vr1, vc1) != bboxes[color]:
            return False
    return True


from __future__ import annotations

import numpy as np

from arc_utils import bbox, get_bg, scale_sprite


def main(grid: np.ndarray) -> np.ndarray:
    """
    Expand the left-edge 2x2 motif into rightward copies scaled by powers of two.

    Input structure
    - The background is the most common color.
    - The only foreground pixels form a filled 2x2 motif in columns 0 and 1.
    Rule
    - Start with a background-filled output of the same shape.
    - For scales 1, 2, 4, ... that fit horizontally, stamp the motif scaled by that factor.
    - Place each scaled stamp at column 2 * (scale - 1), with its top row band ending on the
      original motif's top row and its bottom row band starting on the original motif's bottom row.
    Key insight
    - The original 2x2 motif is the smallest copy in a dyadic sequence: each next copy doubles
      both dimensions, starts immediately to the right, and grows away from the seam between
      the motif's two rows.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    box = bbox(g != bg)
    assert box is not None, "expected foreground motif"
    r0, c0, r1, c1 = box
    assert c0 == 0 and c1 == 1, "motif must occupy the first two columns"
    assert r1 == r0 + 1, "motif must be exactly two rows tall"

    motif = g[r0 : r1 + 1, c0 : c1 + 1]
    assert motif.shape == (2, 2)
    assert np.all(motif != bg), "motif must be a filled 2x2 foreground block"

    height, width = g.shape
    out = np.full_like(g, bg)

    scale = 1
    while 2 * (scale - 1) + 2 * scale <= width:
        top = r0 - scale + 1
        left = 2 * (scale - 1)
        assert top >= 0 and top + 2 * scale <= height, "scaled motif must fit vertically"

        stamp = scale_sprite(motif, scale)
        out[top : top + 2 * scale, left : left + 2 * scale] = stamp
        scale *= 2

    assert scale > 1, "expected at least the original 2x2 motif to fit"
    return out

# --------------- generator (o5x) ---------------
# Canvas geometry and retry bound.
SCALE_COUNT_CHOICES = [2, 3, 4]
MAX_GRID_HEIGHT, MAX_SLACK_ROWS = 30, 2
GENERATION_RETRIES = 300
# Motif and color sampling.
BACKGROUND_COLOR, MOTIF_SIZE = 0, 2
MOTIF_CELLS = MOTIF_SIZE * MOTIF_SIZE
MOTIF_COLOR_COUNT_MIN, MOTIF_COLOR_COUNT_MAX_EXCL = 2, 5
NON_BACKGROUND_COLORS = np.arange(1, 10)

def _gen_expected_output(inp: np.ndarray, motif: np.ndarray, r0: int) -> np.ndarray:
    out = np.zeros_like(inp)
    scale = 1
    height, width = inp.shape
    while MOTIF_SIZE * (2 * scale - 1) <= width:
        top = r0 - scale + 1
        left = MOTIF_SIZE * (scale - 1)
        size = MOTIF_SIZE * scale
        if top < 0 or top + size > height:
            return np.full((0, 0), -1, dtype=int)
        stamp = scale_sprite(motif, scale)
        out[top : top + size, left : left + size] = stamp
        scale *= 2
    return out

def _gen_motif() -> np.ndarray:
    color_count = int(np.random.randint(MOTIF_COLOR_COUNT_MIN, MOTIF_COLOR_COUNT_MAX_EXCL))
    colors = np.random.choice(NON_BACKGROUND_COLORS, size=color_count, replace=False)
    vals = list(colors)
    vals.extend(np.random.choice(colors, size=MOTIF_CELLS - color_count, replace=True).tolist())
    np.random.shuffle(vals)
    return np.array(vals, dtype=int).reshape(MOTIF_SIZE, MOTIF_SIZE)

def _gen_attempt() -> np.ndarray | None:
    n_scales = int(np.random.choice(SCALE_COUNT_CHOICES))
    scale_max = 2 ** (n_scales - 1)
    max_extra = min(MAX_SLACK_ROWS, MAX_GRID_HEIGHT - MOTIF_SIZE * scale_max)
    height_extra = int(np.random.randint(0, max_extra + 1))
    height = MOTIF_SIZE * scale_max + height_extra
    width = 2 * MOTIF_SIZE * scale_max - MOTIF_SIZE
    r0 = int(np.random.randint(scale_max - 1, height - scale_max))

    motif = _gen_motif()
    inp = np.full((height, width), BACKGROUND_COLOR, dtype=int)
    inp[r0 : r0 + MOTIF_SIZE, 0:MOTIF_SIZE] = motif

    expected = _gen_expected_output(inp, motif, r0)
    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp

def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        inp = _gen_attempt()
        if inp is not None:
            return inp
