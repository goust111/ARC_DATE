  1326	def _score_symmetry(
  1327	    grid: np.ndarray,
  1328	    symmetry: Symmetry,
  1329	    ignore_colors: list[int],
  1330	    background: int | None = None,
  1331	) -> tuple[int, int, int]:
  1332	    """
  1333	    Score how well `grid` satisfies the symmetry.
  1334	
  1335	    Returns:
  1336	        (perfect_mapping, off_canvas, bad_mapping)
  1337	    """
  1338	    n, m = grid.shape
  1339	    if background is None:
  1340	        occupied = np.argwhere(~np.isin(grid, ignore_colors))
  1341	    else:
  1342	        occupied = np.argwhere((~np.isin(grid, ignore_colors)) & (grid != int(background)))
  1343	
  1344	    if occupied.size == 0:
  1345	        return 0, 0, 0
  1346	
  1347	    tr, tc = symmetry.apply(occupied[:, 0], occupied[:, 1])
  1348	    in_canvas = (tr >= 0) & (tr < n) & (tc >= 0) & (tc < m)
  1349	    off_canvas = int(np.sum(~in_canvas))
  1350	
  1351	    tr = tr[in_canvas]
  1352	    tc = tc[in_canvas]
  1353	    occupied = occupied[in_canvas]
  1354	
  1355	    original = grid[occupied[:, 0], occupied[:, 1]]
  1356	    transformed = grid[tr, tc]
  1357	
  1358	    bad = int(np.sum((original != transformed) & (~np.isin(transformed, ignore_colors))))
  1359	    perfect = int(np.sum(original == transformed))
  1360	    return perfect, off_canvas, bad
  1361	
