+    c_lo, c_hi = _valid_interval(gw, w, dc)
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+
+    for _ in range(160):
+        r = random.randint(r_lo, r_hi)
+        c = random.randint(c_lo, c_hi)
+        rect = _padded_rect((r, c), shape)
+        if not _rects_clear([rect], reserved):
+            continue
+        return (r, c), (r + dr, c + dc)
+    return None
