+        coords = comp["coords"]
+        values = {int(v) for v in g[coords[:, 0], coords[:, 1]]}
+        sig = _shape_signature(coords)
+        if values == {GREY}:
+            assert sig not in shadows
+            shadows[sig] = comp
+        else:
+            assert sig not in colored
+            colored[sig] = comp
