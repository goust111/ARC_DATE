  1135	
  1136	    def apply(self, r, c, iters: int = 1):
  1137	        r = r + int(iters) * self.dr
  1138	        c = c + int(iters) * self.dc
  1139	        if isinstance(r, np.ndarray):
  1140	            r = r.astype(int)
  1141	        if isinstance(c, np.ndarray):
  1142	            c = c.astype(int)
  1143	        if isinstance(r, float):
  1144	            r = int(round(r))
  1145	        if isinstance(c, float):
  1146	            c = int(round(c))
  1147	        return r, c
  1148	
  1149	    def __repr__(self):
  1150	        return f"TranslationalSymmetry(dr={self.dr}, dc={self.dc})"
  1151	
  1152	    def __str__(self):
  1153	        return self.__repr__()
  1154	
  1155	    def _iter_range(self, grid_shape: tuple[int, int]):
  1156	        top = 0
  1157	        if self.dr != 0:
  1158	            top = math.ceil(grid_shape[0] / abs(self.dr))
  1159	        if self.dc != 0:
  1160	            top = max(top, math.ceil(grid_shape[1] / abs(self.dc)))
  1161	        return (-top, top + 1)
