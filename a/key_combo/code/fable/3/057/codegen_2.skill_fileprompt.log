+    for (r, c), color in zip(coords, colors):
+        patch[r, c] = int(color)
+    return patch
+
+
+def _shadow_patch(mask: np.ndarray) -> np.ndarray:
+    patch = np.full(mask.shape, BACKGROUND, dtype=int)
+    patch[mask] = GREY
+    return patch
