  1522	def detect_objects(
  1523	    grid: np.ndarray,
  1524	    _=None,
  1525	    predicate=None,
  1526	    background: int = Color.BLACK,
  1527	    monochromatic: bool = False,
  1528	    connectivity: int | None = None,
  1529	    allowed_dimensions: list[tuple[int, int]] | None = None,
  1530	    colors: list[int] | None = None,
  1531	    can_overlap: bool = False,
  1532	) -> list[np.ndarray]:
  1533	    """
  1534	    Seeds-compatible object detector returning full-grid objects.
  1535	
  1536	    Prefer `find_components(..., return_format="dict")` for new solver code.
  1537	    """
  1538	    bg = int(background)
  1539	    objects: list[np.ndarray] = []
  1540	
  1541	    if connectivity is not None:
  1542	        objects.extend(
  1543	            find_components(
  1544	                grid,
  1545	                bg=bg,
  1546	                connectivity=connectivity,
  1547	                monochromatic=monochromatic,
  1548	                return_format="objects",
  1549	            )
  1550	        )
  1551	        if colors is not None:
  1552	            allowed = set(map(int, colors)) | {bg}
  1553	            objects = [obj for obj in objects if all(int(v) in allowed for v in obj.flatten())]
  1554	        if predicate is not None:
  1555	            def _cropped(o: np.ndarray) -> np.ndarray:
  1556	                b = bbox(o != bg)
