DIRECT_COLOR=2; MIRROR_COLOR=8; DIRS=((1,0),(-1,0),(0,1),(0,-1))
def connected(mask):
    coords=np.argwhere(mask)
    if not len(coords): return False
    stack=[tuple(coords[0])]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in DIRS:
            rr,cc=r+dr,c+dc
            if 0<=rr<mask.shape[0] and 0<=cc<mask.shape[1] and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==int(mask.sum())
def covers(mask): return np.all(mask.any(axis=0)) and np.all(mask.any(axis=1))
def grow_mask(n,rng):
    min_area=max(4,2*n-2); max_area=n*n-n
    for _ in range(500):
        target=int(rng.integers(min_area,max_area+1))
        mask=np.zeros((n,n),bool)
        mask[int(rng.integers(0,n)), int(rng.integers(0,n))]=True
        while mask.sum()<max_area and (mask.sum()<target or not covers(mask)):
            occ=np.argwhere(mask); rows=mask.any(axis=1); cols=mask.any(axis=0)
            candidates=[]; scores=[]
            for r,c in occ:
                for dr,dc in DIRS:
                    rr,cc=r+dr,c+dc
                    if not (0<=rr<n and 0<=cc<n) or mask[rr,cc]: continue
                    cand=(int(rr),int(cc))
                    if cand in candidates: continue
                    score=(0 if rows[rr] else 3)+(0 if cols[cc] else 3)+(1 if rr in (0,n-1) else 0)+(1 if cc in (0,n-1) else 0)
                    candidates.append(cand); scores.append(score)
            if not candidates: break
            maxs=max(scores); best=[cand for cand,score in zip(candidates,scores) if score==maxs]
            rr,cc=best[int(rng.integers(0,len(best)))]
            mask[rr,cc]=True
        if mask.sum()<min_area or not covers(mask) or not connected(mask) or np.array_equal(mask,np.fliplr(mask)):
