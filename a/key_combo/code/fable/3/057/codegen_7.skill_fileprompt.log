    selected_cols: list[int],
    row_sides: dict[int, str],
    col_sides: dict[int, str],
) -> np.ndarray:
    height, width = map(int, out.shape)
    r1 = r0 + rect_h - 1
    c1 = c0 + rect_w - 1
    inp = out.copy()

