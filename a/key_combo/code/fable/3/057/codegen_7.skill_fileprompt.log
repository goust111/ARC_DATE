+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+NON_BLACK_COLORS = tuple(range(1, 10))
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
