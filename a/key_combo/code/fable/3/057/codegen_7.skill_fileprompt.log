        r0, c0, r1, c1 = comp["bbox"]
        coords = np.asarray(comp["coords"], dtype=int) - np.array([r0, c0], dtype=int)
        pieces.append(
            {
                "color": int(comp["color"]),
                "area": int(comp["area"]),
