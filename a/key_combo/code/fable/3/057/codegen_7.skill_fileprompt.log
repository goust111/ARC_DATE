        # The square can be partly outside the canvas
        # This math is to get the (x,y) of the top-left corner of the square, even if it's outside the canvas
        _b = bbox(square_obj != Color.BLACK)
        assert _b is not None
        r, c, _r1, _c1 = _b
        w = _r1 - r + 1
