+        col0 = trace_c0 + offset
+        col1 = col0 + size - 1
+        assert 0 <= row0 <= row1 < height
+        assert 0 <= col0 <= col1 < width
+        out[row0 : row1 + 1, col0 : col1 + 1] = SQUARE_COLOR
+
+    out[g == trace_color] = trace_color
+    return out
