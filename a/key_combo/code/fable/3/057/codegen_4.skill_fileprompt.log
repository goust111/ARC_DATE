import random

import numpy as np


BG_COLOR = 0
TRACE_COLOR = 8
SQUARE_COLOR = 4

HEIGHT_RANGE = (12, 24)
WIDTH_RANGE = (14, 28)
OBJECT_COUNT_RANGE = (2, 4)
SIDE_RANGE = (2, 6)
