+        "color": int(color),
+        "bbox": bbox,
+        "opening": tuple(map(int, opening)),
+        "side": side,
+        "outward": SIDE_TO_OUTWARD[side],
+        "inward": SIDE_TO_INWARD[side],
+        "deepest": _deepest_cell(bbox, side, opening),
+        "ball": None,
+    }
