+def _draw_cup(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    color: int,
+    side: str,
+    offset: int,
+) -> None:
+    bottom = top + height - 1
+    right = left + width - 1
