+    src_color, ball_color, wall_color = random.sample(PALETTE, 3)
+    wall_side = random.choice(("top", "bottom", "right"))
+    wall_offset = _sample_open_offset(wall_w if wall_side in {"top", "bottom"} else wall_h)
