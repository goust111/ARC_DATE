+def _parse_cups(grid: np.ndarray) -> tuple[list[dict[str, object]], np.ndarray, int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    colors = sorted(int(v) for v in np.unique(g) if int(v) != bg)
+
