+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+SIDE_TO_OUTWARD = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+SIDE_TO_INWARD = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+
+CARDINAL_DIRECTIONS = ("right", "left", "down", "up")
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 300
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = np.asarray(grid == int(color), dtype=bool)
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _opening_side(opening: tuple[int, int], bbox: tuple[int, int, int, int]) -> str | None:
+    r, c = opening
+    r0, c0, r1, c1 = bbox
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _deepest_cell(bbox: tuple[int, int, int, int], side: str, opening: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    r, c = opening
+    if side == "top":
+        return (r1 - 1, c)
+    if side == "bottom":
+        return (r0 + 1, c)
+    if side == "left":
+        return (r, c1 - 1)
+    return (r, c0 + 1)
+
+
+def _cup_from_component(
+    grid: np.ndarray, color: int, coords: np.ndarray, bg: int
+) -> dict[str, object] | None:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 5 or w < 5:
+        return None
+
+    bbox = (int(r0), int(c0), int(r1), int(c1))
+    perimeter = _perimeter_cells(*bbox)
+    comp_set = {tuple(map(int, coord)) for coord in coords.tolist()}
+    if len(comp_set) != len(perimeter) - 1:
+        return None
+    if not comp_set.issubset(perimeter):
+        return None
+
+    missing = list(perimeter - comp_set)
+    if len(missing) != 1:
+        return None
+    opening = missing[0]
+    side = _opening_side(opening, bbox)
+    if side is None:
+        return None
+
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if np.any(inner == int(color)):
+        return None
+
+    return {
+        "color": int(color),
+        "bbox": bbox,
+        "opening": tuple(map(int, opening)),
+        "side": side,
+        "outward": SIDE_TO_OUTWARD[side],
+        "inward": SIDE_TO_INWARD[side],
+        "deepest": _deepest_cell(bbox, side, opening),
+        "ball": None,
+    }
+
+
+def _ball_is_isolated(grid: np.ndarray, r: int, c: int, bg: int) -> bool:
+    height, width = grid.shape
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < height and 0 <= nc < width and int(grid[nr, nc]) != bg:
+            return False
+    return True
