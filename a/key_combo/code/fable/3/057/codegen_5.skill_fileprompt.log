+    cups, wall_mask, bg = _parse_cups(g)
+    opening_map = {tuple(cup["opening"]): cup for cup in cups}
+
+    out = g.copy()
+    launches: list[tuple[tuple[int, int], int, tuple[int, int]]] = []
+    for cup in cups:
+        ball = cup["ball"]
+        if ball is None:
+            continue
+        br, bc, color = ball
+        launches.append(((int(br), int(bc)), int(color), tuple(cup["outward"])))
+        out[br, bc] = bg
+
