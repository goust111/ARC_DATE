+    missing = list(perimeter - comp_set)
+    if len(missing) != 1:
+        return None
+    opening = missing[0]
+    side = _opening_side(opening, bbox)
+    if side is None:
+        return None
+
+    inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if np.any(inner == int(color)):
+        return None
