+    src_row = _sample_open_offset(src_h)
+    travel = random.randint(4, 8)
+
+    src_top = 2
+    src_left = 2
+    lane = src_top + src_row
+    patch_h = src_top + src_h + 2
+    patch_w = src_left + src_w + travel
+    patch = np.zeros((patch_h, patch_w), dtype=int)
