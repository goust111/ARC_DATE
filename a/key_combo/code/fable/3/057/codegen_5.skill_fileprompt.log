+    src_top = lane - src_row
+    dst_top = lane - dst_row
+    src_left = 1
+    dst_left = src_left + src_w + gap
+
+    patch_h = max(src_top + src_h, dst_top + dst_h) + 1
+    patch_w = dst_left + dst_w + 1
