+def _ball_is_isolated(grid: np.ndarray, r: int, c: int, bg: int) -> bool:
+    height, width = grid.shape
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < height and 0 <= nc < width and int(grid[nr, nc]) != bg:
+            return False
