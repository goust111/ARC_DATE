+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _deepest_cell(bbox: tuple[int, int, int, int], side: str, opening: tuple[int, int]) -> tuple[int, int]:
