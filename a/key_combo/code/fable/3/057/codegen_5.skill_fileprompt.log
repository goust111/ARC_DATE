+    touch_side: str | None,
+) -> bool:
+    h, w = occupied.shape
+    pad_top = 0 if touch_side == "top" else 1
+    pad_bottom = 0 if touch_side == "bottom" else 1
+    pad_left = 0 if touch_side == "left" else 1
+    pad_right = 0 if touch_side == "right" else 1
