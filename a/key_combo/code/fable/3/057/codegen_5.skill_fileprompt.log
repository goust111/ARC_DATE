+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _opening_side(opening: tuple[int, int], bbox: tuple[int, int, int, int]) -> str | None:
+    r, c = opening
+    r0, c0, r1, c1 = bbox
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _deepest_cell(bbox: tuple[int, int, int, int], side: str, opening: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    r, c = opening
+    if side == "top":
+        return (r1 - 1, c)
+    if side == "bottom":
+        return (r0 + 1, c)
+    if side == "left":
+        return (r, c1 - 1)
+    return (r, c0 + 1)
