+
+
+def _trace_ball(
+    start: tuple[int, int],
+    color: int,
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+    wall_mask: np.ndarray,
+    opening_map: dict[tuple[int, int], dict[str, object]],
