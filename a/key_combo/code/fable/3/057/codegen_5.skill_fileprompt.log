+        nr = current[0] + dr
+        nc = current[1] + dc
+        if not (0 <= nr < height and 0 <= nc < width):
+            return current
+
+        gate = opening_map.get((nr, nc))
+        if gate is not None and gate["ball"] is None and tuple(gate["inward"]) == (dr, dc):
+            if int(gate["color"]) == int(color):
+                return tuple(map(int, gate["deepest"]))
+            return current
+
+        if wall_mask[nr, nc]:
+            return current
+        current = (nr, nc)
+
