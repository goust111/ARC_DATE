+    for cup in cups:
+        r0, c0, r1, c1 = cup["bbox"]
+        interior = [
+            (r, c)
+            for r in range(r0 + 1, r1)
+            for c in range(c0 + 1, c1)
+            if int(g[r, c]) != bg
+        ]
+        assert len(interior) <= 1, "each cup interior may contain at most one ball"
+        if not interior:
