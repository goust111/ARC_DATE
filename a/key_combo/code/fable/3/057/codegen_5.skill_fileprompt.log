+    return int(values[np.argmax(counts)])
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = np.asarray(grid == int(color), dtype=bool)
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(coords, dtype=int))
+    return out
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _opening_side(opening: tuple[int, int], bbox: tuple[int, int, int, int]) -> str | None:
+    r, c = opening
+    r0, c0, r1, c1 = bbox
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    return None
+
+
+def _deepest_cell(bbox: tuple[int, int, int, int], side: str, opening: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    r, c = opening
+    if side == "top":
+        return (r1 - 1, c)
+    if side == "bottom":
+        return (r0 + 1, c)
+    if side == "left":
+        return (r, c1 - 1)
+    return (r, c0 + 1)
