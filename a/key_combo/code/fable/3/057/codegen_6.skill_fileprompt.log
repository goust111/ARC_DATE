+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, transparent: int = BG) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != transparent
+    assert not np.any(view[mask] != transparent)
+    view[mask] = patch[mask]
