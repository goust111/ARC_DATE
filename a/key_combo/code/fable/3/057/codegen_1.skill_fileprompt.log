+def _padding_clear(mask: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    hh, ww = mask.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not bool(mask[rr0:rr1, cc0:cc1].any())
+
+
+def _place_distractors(
+    rng: random.Random,
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    orientation: str,
+    active_lines: list[int],
+    colors: list[int],
+) -> bool:
+    h, w = grid.shape
+    forbidden = set(map(int, active_lines))
+    for color in colors:
+        placed = False
+        for _ in range(120):
+            rh = rng.randint(1, 3)
+            rw = rng.randint(1, 3)
+            if rh >= h - 2 or rw >= w - 2:
+                continue
