+    total = rng.randint(min_total, max_total)
+    counts = [2] * lane_count
+    extra = total - min_total
+    per_lane_cap = 4 if lane_count == 1 else 3
+    while extra > 0:
+        idx = rng.randrange(lane_count)
+        if counts[idx] < per_lane_cap:
+            counts[idx] += 1
+            extra -= 1
+    rng.shuffle(counts)
+    return counts
