+    hh, ww = mask.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not bool(mask[rr0:rr1, cc0:cc1].any())
+
+
+def _place_distractors(
+    rng: random.Random,
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    orientation: str,
+    active_lines: list[int],
+    colors: list[int],
