+                actual_segments = segments
+            else:
+                marker = (int(line), w - 1)
+                actual_segments = [_mirror_segment(seg, w - 1) for seg in segments]
+        else:
+            if side == "positive":
+                marker = (0, int(line))
+                actual_segments = segments
+            else:
