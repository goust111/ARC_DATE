+    occupied = np.zeros((h, w), dtype=bool)
+
+    color_cursor = 0
+    for line, count in zip(lines, counts):
+        side = rng.choice(("positive", "negative"))
+        segments = _sample_chain_segments(rng, span, count, max_len=max_len)
+        if segments is None:
