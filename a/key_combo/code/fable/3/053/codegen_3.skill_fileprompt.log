+        return (r0, fc0 - w, r0 + h - 1, fc0 - 1)
+    r0 = cr0 + off
+    return (r0, fc1 + 1, r0 + h - 1, fc1 + w)
+
+
+def _build_instance(specs: list[dict], cavity_h: int, cavity_w: int) -> tuple[np.ndarray, np.ndarray] | None:
+    bg = int(specs[0]["bg"])
+    frame_color = int(specs[0]["frame_color"])
