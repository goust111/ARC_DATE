+    h, w = map(int, grid.shape)
+    row_seps = [r for r in range(h) if np.all(grid[r, :] == GREY)]
+    col_seps = [c for c in range(w) if np.all(grid[:, c] == GREY)]
+
+    row_bands = _bands(row_seps, h)
+    col_bands = _bands(col_seps, w)
