        dest = (dest_r, dest_c)
        assert dest not in destinations, "expected one singleton per marker-block quadrant"
        destinations.add(dest)
        out[dest] = int(comp["color"])

    assert destinations == {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
    return out

