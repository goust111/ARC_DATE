+        comp_mask = np.zeros_like(traversable, dtype=bool)
+        for r, c in cells:
+            comp_mask[r, c] = True
+        dist = bfs_distances(comp_mask, (sr, sc))
+        base_idx = PALETTE_INDEX[start_color]
+        for r, c in cells:
+            out[r, c] = PALETTE[(base_idx + int(dist[r, c])) % len(PALETTE)]
+
+    return out
