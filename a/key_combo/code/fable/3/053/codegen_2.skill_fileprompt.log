+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def component_cells(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
