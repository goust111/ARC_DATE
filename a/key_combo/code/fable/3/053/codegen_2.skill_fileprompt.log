   285	def main(grid: np.ndarray) -> np.ndarray:
   286	    """
   287	    Recolor each marker-bearing floor region into a cyclic geodesic wavefront around its marker.
   288	
   289	    Input structure:
   290	    - The canvas consists of orange floor and magenta wall cells; walls block 4-neighbor movement and split the floor into separate 4-connected regions.
   291	    - Some regions contain exactly one non-orange, non-wall marker pixel.
   292	    - Marker colors follow the puzzle's fixed visible cycle; in ARC ids the usable non-wall order is green-yellow-black-grey-red-teal-maroon-blue.
   293	
   294	    Rule:
   295	    - Keep every wall cell unchanged.
   296	    - For each region that contains a marker, compute shortest 4-neighbor path lengths from that marker while staying inside the same floor region.
   297	    - Recolor the marker cell and every other cell in that region by advancing through the cyclic palette by the geodesic distance; leave unmarked floor regions orange.
   298	
   299	    Key insight:
   300	    - The wavefront uses distance around walls rather than raw Manhattan distance, so equal-color bands bend through corridors and shift across thin barriers.
   301	    """
   302	    g = np.asarray(grid, dtype=int)
   303	    assert g.ndim == 2
   304	
   305	    traversable = g != WALL
   306	    out = g.copy()
   307	
   308	    for cells in component_cells(traversable):
   309	        markers = [(r, c) for r, c in cells if int(g[r, c]) != FLOOR]
   310	        if not markers:
   311	            continue
   312	
   313	        assert len(markers) == 1, "each floor region must contain at most one marker"
   314	        sr, sc = markers[0]
   315	        start_color = int(g[sr, sc])
   316	        assert start_color in PALETTE_INDEX, "marker color must belong to the cyclic palette"
   317	
   318	        comp_mask = np.zeros_like(traversable, dtype=bool)
   319	        for r, c in cells:
   320	            comp_mask[r, c] = True
   321	        dist = bfs_distances(comp_mask, (sr, sc))
   322	        base_idx = PALETTE_INDEX[start_color]
   323	        for r, c in cells:
   324	            out[r, c] = PALETTE[(base_idx + int(dist[r, c])) % len(PALETTE)]
   325	
   326	    return out
   327	
   328	
   329	def generate_input() -> np.ndarray:
   330	    for _ in range(GEN_RETRIES):
   331	        grid = gen_attempt()
   332	        if grid is not None:
   333	            return grid
   334	    raise RuntimeError("failed to generate a valid wavefront-coloring input")

