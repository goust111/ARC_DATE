+def is_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    start = tuple(int(v) for v in cells[0])
+    return int((bfs_distances(mask, start) >= 0).sum()) == int(mask.sum())
