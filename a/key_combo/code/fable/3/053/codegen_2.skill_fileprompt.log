+def make_offset_barbell() -> tuple[np.ndarray, bool]:
+    room1_h = random.randint(3, 5)
+    room1_w = random.randint(3, 5)
+    room2_h = random.randint(3, 5)
+    room2_w = random.randint(3, 5)
