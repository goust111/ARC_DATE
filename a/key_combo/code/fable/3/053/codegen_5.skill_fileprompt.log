            assert abs(col_i - col_j) > 2, "expected source blocks to occupy separate column bands"

    out = g.copy()
    for row, col, color, _ in blocks:
        out[row, :] = color
        out[:, col] = color

    for i, (row, _, _, _) in enumerate(blocks):
        for j, (_, col, _, _) in enumerate(blocks):
