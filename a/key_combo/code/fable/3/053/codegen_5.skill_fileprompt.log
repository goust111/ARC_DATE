+        "bottom": list(range(0, c0 - 1)) + list(range(c1 + 2, width)),
+        "left": list(range(0, r0 - 1)) + list(range(r1 + 2, height)),
+        "right": list(range(0, r0 - 1)) + list(range(r1 + 2, height)),
+    }
+
+    chosen: dict[str, list[int]] = {}
