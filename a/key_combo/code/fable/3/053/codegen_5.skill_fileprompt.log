+    out[r1, c0] = bl
+    out[r1, c1] = br
+
+    out[r0 + 1 : r_mid, c0 + 1 : c_mid] = tl
+    out[r0 + 1 : r_mid, c_mid:c1] = tr
+    out[r_mid:r1, c0 + 1 : c_mid] = bl
