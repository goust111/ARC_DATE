def _gen_d6e50e54_make_grids(n, r0, c0, r1, c1, assigned):
    inp = np.full((n, n), BG_COLOR, dtype=int)
    inp[r0 : r1 + 1, c0 : c1 + 1] = RECT_INPUT_COLOR
    for _dest, src in assigned:
