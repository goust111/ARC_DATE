# CFG: colors and sprite shape.
_GEN_BG = 5
_GEN_GUIDE_COLOR = 7
_GEN_SPRITE_COLORS = [1, 2, 3, 4, 6, 8]
_GEN_SPRITE_SIZE = 3
_GEN_SPRITE_GAP = 1

# CFG: inclusive bounds and structural counts.
_GEN_GRID_H = (13, 17)
_GEN_GRID_W = (14, 18)
_GEN_GUIDE_H = (5, 10)
_GEN_GUIDE_W = (6, 8)
_GEN_SPRITE_COUNT = (4, 5)
_GEN_GUIDE_FRAGMENTS = (3, 6)

