+    candidates = [(r, c) for r, c in _interior_cells(base) if (r, c) not in blocked]
+    for _ in range(60):
+        random.shuffle(candidates)
+        chosen: list[tuple[int, int]] = []
+        for r, c in candidates:
+            if any(max(abs(r - rr), abs(c - cc)) <= 1 for rr, cc in chosen):
