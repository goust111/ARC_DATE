def _gen_normalized_coords(coords):
    arr = np.array(coords, dtype=int)
    origin = arr.min(axis=0)
    shifted = arr - origin
    return tuple(sorted((int(r), int(c)) for r, c in shifted))


def _gen_shapes_by_size():
