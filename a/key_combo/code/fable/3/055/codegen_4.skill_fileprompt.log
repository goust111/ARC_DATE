QUADRANT_SHAPE = (HALF_SIZE, HALF_SIZE)
QUADRANT_CELLS = HALF_SIZE * HALF_SIZE
PATTERN_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
OUTPUT_COLOR_COUNTS = (7, 8)
MARKER_COLOR = 4

