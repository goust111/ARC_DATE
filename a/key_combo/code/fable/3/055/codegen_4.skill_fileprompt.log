    out = main(grid)
    assert out.shape == grid.shape
    assert not np.array_equal(out, grid)
    return grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        try:
            return _generate_case()
        except (AssertionError, RuntimeError, ValueError, KeyError):
