+import numpy as np
+
+
+Coord = tuple[int, int]
+DIRS4: tuple[Coord, ...] = ((-1, 0), (0, 1), (1, 0), (0, -1))
+DIR_NAMES: tuple[str, ...] = ("up", "right", "down", "left")
