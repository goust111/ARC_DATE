    n_colors = random.randint(1, min(GEN_MAX_DISTINCT_COLORS, k))
    chosen = random.sample(GEN_TEMPLATE_COLORS, n_colors)
    colors = chosen[:] + [random.choice(chosen) for _ in range(k - n_colors)]
