0141:                 continue
0142:             remaining = [
0143:                 other
0144:                 for other in next_candidates[i + 1 :]
0145:                 if not _gen_too_close(other, box)
0146:             ]
0147:             result = rec(remaining, chosen + [box])
0148:             if result is not None:
0149:                 return result
0150:         return None
