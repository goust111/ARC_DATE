+    h = random.randint(_MIN_BOX, max_h)
+    w = random.randint(_MIN_BOX, max_w)
+    grid_h = rows * h + (rows + 1) * gap + rows * _JITTER
+    grid_w = cols * w + (cols + 1) * gap + cols * _JITTER
+    return rows, cols, gap, h, w, grid_h, grid_w
