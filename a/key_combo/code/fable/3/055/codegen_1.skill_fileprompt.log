            max_w = min(_MAX_BOX, (30 - (cols + 1) * gap - cols * _JITTER) // cols)
            if max_h >= _MIN_BOX and max_w >= _MIN_BOX:
                choices.append((rows, cols, gap, max_h, max_w))
