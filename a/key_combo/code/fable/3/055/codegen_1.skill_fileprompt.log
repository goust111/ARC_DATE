+    choices = []
+    for gap in _GAP_CHOICES:
+        for rows in range(1, min(3, count) + 1):
+            cols = (count + rows - 1) // rows
+            max_h = min(_MAX_BOX, (30 - (rows + 1) * gap - rows * _JITTER) // rows)
+            max_w = min(_MAX_BOX, (30 - (cols + 1) * gap - cols * _JITTER) // cols)
