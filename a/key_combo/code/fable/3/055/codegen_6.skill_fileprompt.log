+
+
+def _vector_candidates() -> list[tuple[int, int]]:
+    candidates = [
+        (dr, dc)
+        for dr in (-2, -1, 0, 1, 2)
+        for dc in (-2, -1, 0, 1, 2)
+        if (dr, dc) != (0, 0)
