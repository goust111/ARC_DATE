+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+DIVIDER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+ROTATION_STEPS = (0, 1, 3)  # np.rot90: 0, ccw 90, cw 90
+
+FRAME_H_RANGE = (10, 14)
+FRAME_W_RANGE = (12, 17)
+OBJECT_COUNT_OPTIONS = (3, 4)
+SIDE_OPTIONS = (3, 4)
+PLACEMENT_MARGIN = 1
+PLACEMENT_GAP = 1
+MAX_GENERATION_ATTEMPTS = 400
