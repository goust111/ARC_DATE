+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+NON_BACKGROUND_COLORS = tuple(range(1, 10))
+RIGHT = "right"
+LEFT = "left"
+SIDES = (RIGHT, LEFT)
+GENERATION_ATTEMPTS = 700
+BLOCK_CLEARANCE = 1
+SIDE_GAP = 3
+MAX_FUEL = 28
+
+_GEN_COUNTER = 0
