+def _frame_pixels(spec: FrameSpec) -> set[tuple[int, int]]:
+    return {cell for cell in _border_cells(spec.bbox) if cell not in spec.gaps}
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
