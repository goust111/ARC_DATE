+        if int(inp[ar, ac]) != BG or int(truth[ar, ac]) != int(figure_color):
+            return False
+        if int(expected[ar, ac]) != int(fill_color):
+            return False
+    for r, c in extras:
+        ar, ac = top + r, left + c
+        if int(inp[ar, ac]) != int(figure_color) or int(truth[ar, ac]) != BG:
+            return False
+        if int(expected[ar, ac]) != BG:
+            return False
