+def _corner_cells(height: int, width: int, corner: str) -> list[tuple[int, int]]:
+    if corner == "TL":
+        r0, c0 = 0, 0
+    elif corner == "TR":
+        r0, c0 = 0, width - 2
+    elif corner == "BL":
+        r0, c0 = height - 2, 0
+    elif corner == "BR":
+        r0, c0 = height - 2, width - 2
+    else:
+        raise ValueError(f"unknown corner {corner}")
+    return [(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)]
