+    cc2 = 2 * int(c)
+    for _ in range(int(turns) % 4):
+        dr2 = rr2 - center_r2
+        dc2 = cc2 - center_c2
+        rr2 = center_r2 + dc2
+        cc2 = center_c2 - dr2
