+            votes = sum(int(g[rr, cc]) == figure_color for rr, cc in rotated)
+            truth_is_foreground = votes >= 2
+            current_is_foreground = int(g[r, c]) == figure_color
+
+            if truth_is_foreground == current_is_foreground:
+                continue
+            if truth_is_foreground:
