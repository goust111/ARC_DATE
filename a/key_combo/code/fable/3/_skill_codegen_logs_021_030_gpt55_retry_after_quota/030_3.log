+        cols = range(0, mid)
+    elif quadrant == "NE":
+        rows = range(0, mid)
+        cols = range(mid + 1, size)
+    elif quadrant == "SW":
+        rows = range(mid + 1, size)
+        cols = range(0, mid)
+    elif quadrant == "SE":
+        rows = range(mid + 1, size)
