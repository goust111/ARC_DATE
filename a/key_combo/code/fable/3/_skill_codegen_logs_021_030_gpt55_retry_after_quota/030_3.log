+
+BG = 0
+NON_BG_COLORS = tuple(range(1, 10))
+QUADRANTS = ("NW", "NE", "SW", "SE")
+PALETTE_CORNERS = ("TL", "TR", "BL", "BR")
+GENERATION_ATTEMPTS = 400
+
+_GEN_COUNTER = 0
+
