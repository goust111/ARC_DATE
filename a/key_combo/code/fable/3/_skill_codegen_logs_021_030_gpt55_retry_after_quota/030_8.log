+def _place_scatter(
+    board_h: int,
+    width: int,
+    palette: tuple[int, ...],
+    counts: tuple[int, ...],
+) -> dict[int, list[tuple[int, int]]] | None:
+    used: set[tuple[int, int]] = set()
+    positions: dict[int, list[tuple[int, int]]] = {}
+    short_side = min(board_h, width)
+
+    central_min_depth = max(2, short_side // 3)
