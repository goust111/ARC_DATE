+        out[r1 - t + 1 : r1 + 1, c0 : c1 + 1] = int(color)
+        out[r0 : r1 + 1, c0 : c0 + t] = int(color)
+        out[r0 : r1 + 1, c1 - t + 1 : c1 + 1] = int(color)
