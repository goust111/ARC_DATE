+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+MARKER_COLORS = (1, 3, 4, 6, 7, 8, 9)
+GENERATION_ATTEMPTS = 500
+
+
+def _edge_marker_color(values: np.ndarray, role: str) -> int:
