+            cell
+            for cell in _line_cells(shape, kind, value)
+            if cell[0] in window_set and owners[cell] == [idx]
+        ]
+        if len(cells) < 3:
+            return None
+        residues.append(cells)
+    return residues
+
+
+def _crossing_cells(
+    shape: tuple[int, int],
+    keys: list[tuple[str, int]],
+) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
