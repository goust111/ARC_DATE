+
+BLACK = 0
+GREY = 5
+DIFF_DIAGONAL = "diff"  # r - c is constant: down-right diagonal
+SUM_DIAGONAL = "sum"  # r + c is constant: down-left diagonal
+LINE_KINDS = (DIFF_DIAGONAL, SUM_DIAGONAL)
