+def _place_external_sprites(grid: np.ndarray, frame_box: BBox, sprites: list[dict]) -> bool:
+    occupied: set[Coord] = {
+        (int(r), int(c))
+        for r, c in np.argwhere(grid != BACKGROUND)
+    }
