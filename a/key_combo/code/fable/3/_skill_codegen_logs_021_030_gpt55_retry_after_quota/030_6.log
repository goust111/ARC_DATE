+    valid: list[np.ndarray] = []
+    for fg in colors:
+        occ = colors[1] if fg == colors[0] else colors[0]
+        try:
+            valid.append(_solve_with_roles(g, bg, int(fg), int(occ)))
+        except AssertionError:
+            continue
