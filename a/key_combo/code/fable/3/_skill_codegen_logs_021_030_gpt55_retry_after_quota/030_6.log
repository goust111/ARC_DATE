+# --------------- generator ---------------
+
+MAX_ATTEMPTS = 400
+BLOCK_SIZES = (5, 6, 7, 8)
+BLOCK_COUNT_RANGE = (4, 6)
+MIN_BLOCK_GAP = 2
+ARC_COLORS = tuple(range(10))
