+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, grid.ravel()))
+    if exclude is not None:
+        colors -= {int(c) for c in exclude}
+    return sorted(colors)
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        q: deque[Coord] = deque([(sr, sc)])
+        seen[sr, sc] = True
+        coords: list[Coord] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _mirror(cell: Coord, size: int) -> Coord:
+    r, c = cell
+    return int(size - 1 - r), int(size - 1 - c)
