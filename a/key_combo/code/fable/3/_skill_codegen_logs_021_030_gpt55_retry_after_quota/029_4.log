+    legend_mask = np.zeros(g.shape, dtype=bool)
+    legend_mask[g.shape[0] - 1, : len(legend)] = True
+    wall_mask = np.zeros(g.shape, dtype=bool)
+    interior_mask = np.zeros(g.shape, dtype=bool)
