+    box = (int(r0), int(c0), int(r1), int(c1))
+    actual = {(int(r), int(c)) for r, c in coords}
+    expected = _wall_cells_for_box(box)
+    if actual != expected:
+        return None
+
+    return {
+        "bbox": box,
+        "inner": (int(r0), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+        "wall_cells": expected,
