+    groups = _line_groups(sorted(separator_indices))
+    out: list[tuple[int, int]] = []
+    cursor = 0
+    for start, stop in groups:
+        if cursor <= start - 1:
+            out.append((cursor, start - 1))
+        cursor = stop + 1
+    if cursor <= length - 1:
+        out.append((cursor, length - 1))
+    return out
