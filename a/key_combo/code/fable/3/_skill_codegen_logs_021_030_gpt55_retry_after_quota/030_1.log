+    a, b = colors
+    assert np.all((tile == a) | (tile == b)), "tile contains a non-pattern color"
+    return np.where(tile == a, b, a)
+
+
+def _partner(tile: np.ndarray, colors: tuple[int, int]) -> np.ndarray:
+    return np.rot90(_swap_colors(tile, colors), 2).copy()
+
