+def _repeat_tile(tile: np.ndarray, rows: int, cols: int) -> np.ndarray:
+    rr = np.arange(rows)[:, None] % tile.shape[0]
+    cc = np.arange(cols)[None, :] % tile.shape[1]
+    return tile[rr, cc].astype(int)
+
+
