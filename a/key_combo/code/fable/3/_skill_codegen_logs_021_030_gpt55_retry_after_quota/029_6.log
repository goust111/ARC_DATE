    return cells


def _gen_gap_options(shape, bboxes, own_i):
    options = {}
    bbox = bboxes[own_i]
    min_ray_length, max_ray_length = RAY_LENGTH_RANGE
    for side in SIDE_ORDER:
        if not (min_ray_length <= _gen_ray_length(shape, bbox, side) <= max_ray_length):
