+    pattern_mask = expected == pattern
+    h, w = expected.shape
+    pattern_cells = [(int(r), int(c)) for r, c in np.argwhere(pattern_mask)]
+    bg_cells = [(int(r), int(c)) for r, c in np.argwhere(~pattern_mask)]
+    if not pattern_cells or not bg_cells:
+        return None
+
+    for _ in range(5000):
