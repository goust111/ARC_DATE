+_GRID_COLS = range(16, 31)
+_ROW_PERIODS = (2, 3, 4, 5)
+_COL_PERIODS = (3, 4, 5, 6)
+_ANOMALY_COUNTS = (2, 3, 3, 4)
+_COLORS = tuple(range(10))
+_MAX_GENERATION_ATTEMPTS = 500
+
