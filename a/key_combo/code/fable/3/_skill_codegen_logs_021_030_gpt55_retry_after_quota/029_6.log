+    return int(pos[0]), int(pos[1])
+
+
+def _well_spaced(pos: tuple[int, int], chosen: list[tuple[int, int]], min_distance: int = 4) -> bool:
+    r, c = pos
+    for rr, cc in chosen:
+        if abs(r - rr) + abs(c - cc) < min_distance:
