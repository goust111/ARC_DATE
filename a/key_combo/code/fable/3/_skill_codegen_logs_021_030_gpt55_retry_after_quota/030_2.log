+def _ray_cells(
+    shape: tuple[int, int],
+    r0: int,
+    c0: int,
+    height: int,
+    width: int,
+    direction: tuple[int, int],
+    length: int,
+) -> list[tuple[int, int]]:
+    grid_h, grid_w = shape
+    dr, dc = direction
+    center_r = r0 + height // 2
+    center_c = c0 + width // 2
+    rr, cc = center_r, center_c
+    while r0 <= rr < r0 + height and c0 <= cc < c0 + width:
+        rr += dr
+        cc += dc
+
+    cells: list[tuple[int, int]] = []
+    for _ in range(length):
+        if not (0 <= rr < grid_h and 0 <= cc < grid_w):
+            break
+        cells.append((rr, cc))
+        rr += dr
+        cc += dc
+    return cells
+
