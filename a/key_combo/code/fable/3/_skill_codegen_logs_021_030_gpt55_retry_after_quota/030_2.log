+def _layout_is_clear(shape: tuple[int, int], placed: list[PlacedObject]) -> bool:
+    rects = [_rect_bbox(obj) for obj in placed]
+    ray_owner: dict[tuple[int, int], int] = {}
+    clipped = 0
+    full = 0
+    axis = 0
+    diagonal = 0
+    for i, obj in enumerate(placed):
