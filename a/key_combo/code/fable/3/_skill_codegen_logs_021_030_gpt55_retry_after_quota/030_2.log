+    assert np.all(region[-1, :] == int(color)), "hole cannot touch the bottom edge"
+    assert np.all(region[:, 0] == int(color)), "hole cannot touch the left edge"
+    assert np.all(region[:, -1] == int(color)), "hole cannot touch the right edge"
