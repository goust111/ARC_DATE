    new_col = int(color)
    old_col = int(grid[r0, c0])
    if old_col == new_col:
        return
    if int(connectivity) == 4:
        def nbrs(rr: int, cc: int):
            yield rr - 1, cc
            yield rr + 1, cc
            yield rr, cc - 1
            yield rr, cc + 1
    else:
        def nbrs(rr: int, cc: int):
            for dr in (-1, 0, 1):
