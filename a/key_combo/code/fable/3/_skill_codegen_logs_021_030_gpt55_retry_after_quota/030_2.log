+def _valid_holes(rect_h: int, rect_w: int, direction: tuple[int, int]) -> list[HoleSpec]:
+    holes: list[HoleSpec] = []
+    for h in range(1, min(MAX_HOLE_SIDE, rect_h - 2) + 1):
+        for w in range(1, min(MAX_HOLE_SIDE, rect_w - 2) + 1):
