+def _bboxes_touch(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar0 <= br1 + 1 and br0 <= ar1 + 1 and ac0 <= bc1 + 1 and bc0 <= ac1 + 1
+
+
+def _cell_in_bbox(cell: tuple[int, int], box: tuple[int, int, int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = box
