        grid[line_r, c0 : c0 + gap_len] = _GEN_BG
    else:
        line_c = cell_size + c * (cell_size + 1)
        r0 = r * (cell_size + 1) + offset
        grid[r0 : r0 + gap_len, line_c] = _GEN_BG


