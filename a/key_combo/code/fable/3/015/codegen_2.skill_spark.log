    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    frames = _rectangular_frame_candidates(g, bg)
    assert len(frames) == 1, "expected exactly one rectangular frame"

    frame = frames[0]
