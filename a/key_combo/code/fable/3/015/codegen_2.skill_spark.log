+        if placements is None:
+            continue
+
+        inp = np.full((H, W), bg, dtype=int)
+        for spec, pos in zip(specs, placements):
+            _draw_block(inp, pos[0], pos[1], spec)
+
+        try:
+            blocks = _extract_blocks(inp, bg)
+            out, stats = _run_growth(inp, blocks, track_conflict=True)
+        except Exception:
