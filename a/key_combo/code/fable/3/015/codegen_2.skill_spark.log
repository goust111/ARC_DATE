+def _can_place(
+    occupancy: np.ndarray,
+    r: int,
+    c: int,
+    h: int,
+    w: int,
+    *,
+    allow_margin: int = 1,
+) -> bool:
+    H, W = occupancy.shape
+    if r < 0 or c < 0 or r + h > H or c + w > W:
+        return False
+    r0 = max(0, r - allow_margin)
+    c0 = max(0, c - allow_margin)
+    r1 = min(H, r + h + allow_margin)
+    c1 = min(W, c + w + allow_margin)
+    return not bool(occupancy[r0:r1, c0:c1].any())
