+def _infer_separator_color(g: np.ndarray, bg: int) -> int:
+    color_count = Counter(int(x) for x in g.ravel() if int(x) != bg)
+    assert color_count, "expected separator color and centers"
+    sep_color, _ = color_count.most_common(1)[0]
+    return sep_color
