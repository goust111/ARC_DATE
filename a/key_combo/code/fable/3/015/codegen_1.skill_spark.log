+    while True:
+        neighbors = [n for n in adjacency.get(cur, set()) if n != prev]
+        if not neighbors:
+            break
+        if len(neighbors) != 1:
+            raise AssertionError("non-unique path traversal encountered")
+        nxt = neighbors[0]
+        if nxt in seen:
+            raise AssertionError("cycle detected in traversal path")
+        path.append(nxt)
+        seen.add(nxt)
+        prev, cur = cur, nxt
+
+    return path
