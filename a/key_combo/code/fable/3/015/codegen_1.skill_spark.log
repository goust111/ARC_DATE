+    path: list[tuple[int, int]],
+    cell_size: int,
+    row_lines: list[int],
+    col_lines: list[int],
+    cell_colors: np.ndarray,
+    bg: int = 0,
+) -> None:
+    rows = [(k * (cell_size + 1), k * (cell_size + 1) + cell_size - 1) for k in range(len(row_lines) + 1)]
+    cols = rows
+
+    for ri in range(len(rows)):
+        for ci in range(len(cols)):
+            r0, r1 = rows[ri]
+            c0, c1 = cols[ci]
+            cr = (r0 + r1) // 2
+            cc = (c0 + c1) // 2
+            color = int(cell_colors[ri, ci])
+            if (ri, ci) == path[0]:
