+                        "center_col": int(c0 + mid),
+                        "length": length,
+                        "base_color": unique[0],
+                        "is_pivot": False,
+                    }
+                )
+                continue
+
+            assert len(unique) == 2
+            outer = np.concatenate((values[:mid], values[mid + 1 :]))
+            assert outer.size > 0 and len(set(map(int, outer))) == 1
+            base_color = int(outer[0])
+            inset_color = int(values[mid])
+            assert inset_color != base_color
+
+            bar = {
