+    assert 0 <= c0 <= c1 < grid.shape[1]
+    grid[row, c0 : c1 + 1] = int(color)
+    if inset_color is not None:
+        grid[row, center_col] = int(inset_color)
+
+
+def _parse_bars(grid: np.ndarray, bg: int) -> tuple[list[dict], dict]:
