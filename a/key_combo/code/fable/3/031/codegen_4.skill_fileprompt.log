+
+    moved = False
+    for index in other_indices:
+        target_row = top_row + layer_count - 1 - index
+        if placements[index] != target_row:
+            moved = True
+            break
+    if not moved:
+        return None
+
+    try:
+        if np.array_equal(main(inp), expected):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
