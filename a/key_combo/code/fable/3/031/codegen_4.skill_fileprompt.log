        (0xFF, 0x41, 0x36),  # 2 red
        (0x2E, 0xCC, 0x40),  # 3 green
        (0xFF, 0xDC, 0x00),  # 4 yellow
        (0xA0, 0xA0, 0xA0),  # 5 grey
        (0xF0, 0x12, 0xBE),  # 6 magenta/pink
