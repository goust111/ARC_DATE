+            else:
+                solid[h - depth :, start : start + length] = False
+        else:
+            max_depth = min(3, w - 4)
+            max_length = h - 2
+            if max_depth < 1 or max_length < 1:
+                return None
+            depth = random.randint(1, max_depth)
+            length = random.randint(1, max_length)
+            start = random.randint(1, h - length - 1)
