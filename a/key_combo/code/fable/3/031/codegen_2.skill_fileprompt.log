+    cc0 = c0 - left
+    rr1 = r1 + bottom
+    cc1 = c1 + right
+    return inp[rr0 : rr1 + 1, cc0 : cc1 + 1].copy(), out[rr0 : rr1 + 1, cc0 : cc1 + 1].copy()
+
