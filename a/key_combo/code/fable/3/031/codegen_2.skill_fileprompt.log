+    return walls
+
+
+def _mirror_axis(src_mask: np.ndarray, dst_mask: np.ndarray) -> str | None:
+    if src_mask.shape != dst_mask.shape:
+        return None
+    hits: list[str] = []
+    if np.array_equal(np.fliplr(src_mask), dst_mask):
+        hits.append("h")
+    if np.array_equal(np.flipud(src_mask), dst_mask):
+        hits.append("v")
+    if len(hits) == 1:
+        return hits[0]
+    return None
