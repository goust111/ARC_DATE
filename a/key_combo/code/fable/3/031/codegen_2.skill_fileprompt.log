+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _boundary_mask(solid: np.ndarray) -> np.ndarray:
+    h, w = solid.shape
+    wall = np.zeros_like(solid, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not solid[r, c]:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w) or not solid[nr, nc]:
+                    wall[r, c] = True
