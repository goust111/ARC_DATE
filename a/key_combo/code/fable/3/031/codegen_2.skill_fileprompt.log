+                max(0, r0 - PLACEMENT_PADDING),
+                max(0, c0 - PLACEMENT_PADDING),
+                min(MASTER_CANVAS_SIZE - 1, r0 + h - 1 + PLACEMENT_PADDING),
+                min(MASTER_CANVAS_SIZE - 1, c0 + w - 1 + PLACEMENT_PADDING),
