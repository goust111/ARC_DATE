+
+def _map_point(point: Coord, src_bbox: tuple[int, int, int, int], dst_bbox: tuple[int, int, int, int], axis: str) -> Coord:
+    sr0, sc0, sr1, sc1 = src_bbox
+    dr0, dc0, dr1, dc1 = dst_bbox
