+            "wall_open_a": wall_a_open,
+            "wall_full_b": wall_b,
+            "wall_open_b": wall_b_open,
+            "pattern_full_a": pattern_full,
+            "pattern_half_a": a_half,
+            "pattern_full_b": b_full,
+            "pattern_half_b": b_half,
+        }
+    return None
