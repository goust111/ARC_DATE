+        cells = list(pattern_full)
+        random.shuffle(cells)
+        split = random.randint(1, len(cells) - 1)
+        a_half = set(cells[:split])
+        a_missing = set(cells[split:])
+        b_full = _mirror_local_coords(pattern_full, wall.shape, axis)
