+
+Coord = tuple[int, int]
+
+BACKGROUND = 0
+MAX_GRID_SIZE = 30
+GEN_RETRY_LIMIT = 400
+PAIR_RETRY_LIMIT = 200
+LOCAL_SHAPE_RETRY_LIMIT = 200
+MASTER_CANVAS_SIZE = 30
+PLACEMENT_PADDING = 2
