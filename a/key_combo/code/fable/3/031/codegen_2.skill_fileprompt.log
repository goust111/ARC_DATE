+            {
+                "wall_color": int(comp["color"]),
+                "open_coords": set(comp["coords"]),
+                "completed_coords": option["completed"],
+                "gap": option["gap"],
+                "interior": option["interior"],
+                "content": content,
+                "complete_mask": completed_mask,
+                "bbox": bbox,
+            }
+        )
