+        grid[r0 + r, c0 + c] = color
+
+
+def _crop_with_margin(inp: np.ndarray, out: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    coords = np.argwhere(inp != BACKGROUND)
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+
