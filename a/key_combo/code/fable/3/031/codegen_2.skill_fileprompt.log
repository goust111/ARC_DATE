+    bottom = random.randint(0, min(3, inp.shape[0] - 1 - r1))
+    right = random.randint(0, min(3, inp.shape[1] - 1 - c1))
+
+    rr0 = r0 - top
+    cc0 = c0 - left
+    rr1 = r1 + bottom
+    cc1 = c1 + right
