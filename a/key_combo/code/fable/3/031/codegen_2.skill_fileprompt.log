+def _mirror_local_coords(coords: set[Coord], shape: tuple[int, int], axis: str) -> set[Coord]:
+    h, w = shape
+    if axis == "h":
+        return {(r, w - 1 - c) for r, c in coords}
+    if axis == "v":
+        return {(h - 1 - r, c) for r, c in coords}
+    raise ValueError(f"unknown axis: {axis}")
