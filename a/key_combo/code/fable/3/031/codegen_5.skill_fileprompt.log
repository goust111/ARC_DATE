            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                    seen[nr, nc] = True; q.append((nr, nc))
        m = np.zeros_like(mask)
        for rr, cc in cells:
            m[rr, cc] = True
        out.append(m)
    return out


def terrain_connected(grid):
    mask = grid "'!= 0
    if not mask.any() or not mask[-1].any():
        return False
    h, w = grid.shape
    start = tuple(map(int, np.argwhere(mask)[0]))
    q = deque([start])
    seen = {start}
    while q:
        r, c = q.popleft()
        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
                seen.add((nr, nc)); q.append((nr, nc))
    return len(seen) == int(mask.sum())


def to_grid(profile, H):
    g = np.zeros((H, len(profile)), int)
    for c, top in enumerate(profile):
        g[top:, c] = 2
    return g


def best_gap(grid, component):
    terrain = 2
    orig = int(component.sum())
    h, w = grid.shape
    candidates = set()
    for r, c in np.argwhere(component):
        r = int(r); c = int(c)
        for dc in (-1, 1):
            cc = c + dc
            if 0 <= cc < w and grid[r, cc] == terrain:
                candidates.add((r, cc))
    best = None
    for r, c in candidates:
        temp = grid.copy(); temp[r, c] = 0
        if not terrain_connected(temp):
            continue
        new = water_mask(temp)
        kept = int((new & component).sum())
        red = orig - kept
        if 0 < kept < orig:
            score = (red, kept)
            if best is None or score > best[0]:
                best = (score, (r, c, kept, red))
    return None if best is None else best[1]


def build_profile():
    # left drain terrace open to edge
    left_drain = random.randint(8, 12)
    ridge0 = random.randint(2, 5)
    basin1 = random.randint(left_drain + 2, min(17, left_drain + 6))
    ridge1 = random.randint(3, min(7, basin1 - 3))
    basin2 = random.randint(max(ridge1 + 3, ridge0 + 3), min(18, ridge1 + 8))
    ridge2 = random.randint(2, min(8, basin2 - 3))
    profile = []
    profile.extend([left_drain] * random.randint(2, 4))
    profile.extend(int(round(v)) for v in np.linspace(left_drain, ridge0, random.randint(2, 4) + 1)[1:])
    profile.extend([ridge0] * random.randint(2, 3))
    profile.extend(int(round(v)) for v in np.linspace(ridge0, basin1, random.randint(2, 4) + 1)[1:])
    profile.extend([basin1] * random.randint(3, 5))
    profile.extend(int(round(v)) for v in np.linspace(basin1, ridge1, random.randint(2, 4) + 1)[1:])
    profile.extend([ridge1] * random.randint(2, 3))
    profile.extend(int(round(v)) for v in np.linspace(ridge1, basin2, random.randint(2, 4) + 1)[1:])
    profile.extend([basin2] * random.randint(3, 5))
    profile.extend(int(round(v)) for v in np.linspace(basin2, ridge2, random.randint(2, 4) + 1)[1:])
    profile.extend([ridge2] * random.randint(2, 4))
    if random.random() < 0.6:
        basin3 = random.randint(ridge2 + 3, min(18, ridge2 + 7))
        ridge3 = random.randint(2, min(8, basin3 - 3))
        profile.extend(int(round(v)) for v in np.linspace(ridge2, basin3, random.randint(2, 4) + 1)[1:])
        profile.extend([basin3] * random.randint(2, 4))
        profile.extend(int(round(v)) for v in np.linspace(basin3, ridge3, random.randint(2, 4) + 1)[1:])
        profile.extend([ridge3] * random.randint(2, 4))
    if not (18 <= len(profile) <= 29):
        return None
    H = max(profile) + random.randint(4, 6)
    if H > 30:
        return None
    return np.array(profile), H

ok = 0
for _ in range(500):
    built = build_profile()
    if built is None:
        continue
    profile, H = built
    g = to_grid(profile, H)
    wm = water_mask(g)
    comps = comp_masks(wm)
    if len(comps) < 2:
        continue
    gaps = [best_gap(g, comp) for comp in comps]
    gaps = [x for x in gaps if x is not None]
    if not gaps:
