from collections import deque
import numpy as np


def water_mask(grid):
    bg = grid == 0
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    q = deque()
    for r in range(h):
        for c in (0, w - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True; q.append((r, c))
    for c in range(w):
        if bg[h - 1, c] and not seen[h - 1, c]:
            seen[h - 1, c] = True; q.append((h - 1, c))
    while q:
        r, c = q.popleft()
        for nr, nc in ((r, c - 1), (r, c + 1), (r - 1, c)):
            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True; q.append((nr, nc))
    return bg & ~seen


def conn(grid):
    mask=grid"'!=0
    h,w=grid.shape
    if not mask.any() or not mask[-1].any(): return False
    start=tuple(map(int,np.argwhere(mask)[0]))
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==int(mask.sum())


def comp_masks(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,bool); out=[]
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; cells=[]
        while q:
            rr,cc=q.popleft(); cells.append((rr,cc))
            for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=1; q.append((nr,nc))
        m=np.zeros_like(mask)
        for rr,cc in cells: m[rr,cc]=1
        out.append(m)
    return out


def find_gap_for_component(g, comp):
    h,w=g.shape
    terrain=np.argwhere(g!=0)
    orig=int(comp.sum())
    best=None
    for r,c in terrain:
        temp=g.copy(); temp[r,c]=0
        if not conn(temp):
            continue
        new=water_mask(temp)
        kept=int((new & comp).sum())
        red=orig-kept
        if kept >= max(4, orig//3) and red >= max(3, orig//5):
            # prefer a notch away from the bottom and not on side edges
            score=(red, kept, -abs(int(c)-w//2))
            if best is None or score>best[0]:
                best=(score,(int(r),int(c),kept,red))
    return None if best is None else best[1]


def gen_profile():
    W=random.randint(20,28)
    row=random.randint(8,12)
    prof=[row]
    direction=0
    for i in range(1,W):
        if i<4:
            step=random.choice([0,0,-1,1])
        else:
            if random.random()<0.25:
                direction=random.choice([-1,0,1]) if direction==0 else random.choice([direction,0,-direction])
            step=direction
            if random.random()<0.3:
                step=0
        row=max(3,min(16,row+step))
        prof.append(row)
    return prof

