for _ in range(500):
    prof=gen_profile()
    H=max(prof)+random.randint(4,7)
    if H>30: continue
    g=np.zeros((H,len(prof)),int)
    for c,t in enumerate(prof): g[t:,c]=2
    wm=water_mask(g)
    comps=comp_masks(wm)
    comps=[m for m in comps if int(m.sum())>=5]
    if len(comps)<2:
        continue
    found=None
    for comp in sorted(comps, key=lambda m:int(m.sum()), reverse=True):
        gap=find_gap_for_component(g, comp)
        if gap:
            found=(comp,gap)
            break
    if found is None:
        continue
    # leave another sealed basin with area >=5
    r,c,kept,red=found[1]
    temp=g.copy(); temp[r,c]=0
    final=water_mask(temp)
    final_comps=comp_masks(final)
    final_areas=sorted([int(m.sum()) for m in final_comps], reverse=True)
    if len([a for a in final_areas if a>=4])<2:
        continue
    success+=1
    if success<=8:
        print('"'success',success,'shape',g.shape,'areas',[int(m.sum()) for m in comps],'gap',found[1],'final',final_areas,'profile',prof)
print('total',success)
