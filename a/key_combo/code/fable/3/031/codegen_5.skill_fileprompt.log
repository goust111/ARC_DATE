    for r in range(h):
        for c in (0, w - 1):
            if bg[r, c] and not seen[r, c]:
                seen[r, c] = True; q.append((r, c))
    for c in range(w):
        if bg[h - 1, c] and not seen[h - 1, c]:
            seen[h - 1, c] = True; q.append((h - 1, c))
    while q:
        r, c = q.popleft()
        for nr, nc in ((r, c - 1), (r, c + 1), (r - 1, c)):
            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
                seen[nr, nc] = True; q.append((nr, nc))
    return bg & ~seen


def conn(grid):
    mask=grid"'!=0
    h,w=grid.shape
    if not mask.any() or not mask[-1].any(): return False
    start=tuple(map(int,np.argwhere(mask)[0]))
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==int(mask.sum())


def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,bool); out=[]
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; cells=[]
        while q:
            rr,cc=q.popleft(); cells.append((rr,cc))
            for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=1; q.append((nr,nc))
        out.append(cells)
    return out


def build_profile():
    rim1 = random.randint(6,8)
    outer_a = random.randint(rim1+1, rim1+2)
    outer_b = random.randint(outer_a+1, outer_a+2)
    floor1 = random.randint(outer_b, outer_b+2)
    rim2 = random.randint(rim1, rim1+1)
    high = random.randint(3, rim1-1)
    floor2 = random.randint(rim2+2, rim2+5)
    rim3 = random.randint(4, min(8, floor2-1))
    prof=[]
    prof += [outer_a]*random.randint(2,3)
    prof += [outer_b]*random.randint(2,3)
    prof += list(range(outer_b-1, rim1-1, -1))
    prof += list(range(rim1+1, floor1+1))
    prof += [floor1]*random.randint(2,4)
    prof += list(range(floor1-1, rim2-1, -1))
    prof += [rim2]*random.randint(1,2)
    prof += list(range(rim2-1, high-1, -1))
    prof += [high]*random.randint(1,2)
    prof += list(range(high+1, floor2+1))
    prof += [floor2]*random.randint(2,4)
    prof += list(range(floor2-1, rim3-1, -1))
    prof += [rim3]*random.randint(2,4)
    if len(prof) > 29:
        return None
    if len(prof) < 20:
        prof += [rim3]*random.randint(20-len(prof), 29-len(prof))
    return prof

success=0
for _ in range(2000):
    prof=build_profile()
    if prof is None: continue
    H=max(prof)+random.randint(4,6)
    if H>30: continue
    g=np.zeros((H,len(prof)),int)
    for c,t in enumerate(prof): g[t:,c]=2
    wm=water_mask(g)
    cs=comps(wm)
    areas=sorted([len(x) for x in cs], reverse=True)
    if len([a for a in areas if a>=4])<2:
        continue
    # first local minimum row (shallower terrain) after outer slopes? actually rim1 is first strict local min after deep left edge
    rim1_row=min(prof)
    # better: first place where profile starts increasing again after decreasing from outer_b.
    c0=None
    for i in range(1,len(prof)-1):
        if prof[i-1] > prof[i] < prof[i+1]:
            c0=i; break
    if c0 is None: continue
    temp=g.copy(); temp[prof[c0], c0]=0
    if not conn(temp):
        continue
    new=water_mask(temp)
    # identify overlap with largest original comp near first basin
    reduced = int(wm.sum()) - int((new & wm).sum())
    if reduced <= 0:
        continue
    final_areas=sorted([len(x) for x in comps(new)], reverse=True)
    if len([a for a in final_areas if a>=4])<2:
        continue
    success+=1
    if success<=10:
        print('"'success',success,'shape',g.shape,'areas',areas,'final',final_areas,'gap',(prof[c0],c0),'profile',prof)
print('total',success)
