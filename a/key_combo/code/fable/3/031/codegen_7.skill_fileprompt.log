+def _visible_paint_count(mask: np.ndarray, r0: int, c0: int, height: int, width: int) -> int:
+    mh, mw = mask.shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(height, r0 + mh)
+    cc1 = min(width, c0 + mw)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return 0
+    return int(mask[rr0 - r0 : rr1 - r0, cc0 - c0 : cc1 - c0].sum())
+
