+        (r0 == 0 and c0 == 0)
+        or (r0 == 0 and c1 == w - 1)
+        or (r1 == h - 1 and c0 == 0)
+        or (r1 == h - 1 and c1 == w - 1)
+    )
+
+
+def _find_template(
+    grid: np.ndarray, bg: int
