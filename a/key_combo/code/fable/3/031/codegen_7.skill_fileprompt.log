+        fg_cols = int(np.unique(np.argwhere(mask)[:, 1]).size)
+        bg_rows = int(np.unique(np.argwhere(~mask)[:, 0]).size)
+        bg_cols = int(np.unique(np.argwhere(~mask)[:, 1]).size)
+        if min(fg_rows, fg_cols, bg_rows, bg_cols) < 2:
+            continue
+        return mask
+
