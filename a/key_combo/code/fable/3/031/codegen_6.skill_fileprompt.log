+def _pick_demo_spec(kind: str) -> tuple[np.ndarray, np.ndarray, tuple, list[int]]:
+    palette_pool = [c for c in Color.NOT_BLACK]
+    for _ in range(200):
+        if kind in {"rot90", "rot270"}:
+            size = random.randint(3, 6)
+            h = w = size
+        else:
+            h = random.randint(3, 6)
+            w = random.randint(3, 6)
+
+        if kind == "swap":
