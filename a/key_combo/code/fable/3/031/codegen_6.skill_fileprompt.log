+
+    gap = random.randint(1, 3)
+    pair_w = 2 * demo_before.shape[1] + gap
+    side = random.choice(["top", "bottom", "left", "right"])
+    sep_color = random.choice([c for c in Color.NOT_BLACK if c not in palette])
+
+    for _ in range(200):
