+    r0, r1, c0, c1 = map(int, bounds)
+    sub_h = r1 - r0
+    sub_w = c1 - c0
+    h, w = demo_before.shape
+    gap = random.randint(1, 3)
+    pair_w = 2 * w + gap
+
+    if side == "top":
+        rr = 0
+        cc = 0 if random.random() < 0.5 else sub_w - pair_w
+    elif side == "bottom":
+        rr = sub_h - h
+        cc = 0 if random.random() < 0.5 else sub_w - pair_w
+    elif side == "left":
+        rr = 0 if random.random() < 0.5 else sub_h - h
+        cc = 0
+    elif side == "right":
+        rr = 0 if random.random() < 0.5 else sub_h - h
+        cc = sub_w - pair_w
