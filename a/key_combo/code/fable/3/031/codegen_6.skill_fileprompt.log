+    seen = {demo.tobytes()}
+    sprites: list[np.ndarray] = []
+    for _ in range(count):
+        for _ in range(200):
+            sprite = _random_pattern(h, w, palette, required_colors=required, changed_by=spec)
+            key = sprite.tobytes()
+            if key in seen:
