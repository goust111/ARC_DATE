+def _matching_transforms(before: np.ndarray, after: np.ndarray, bg: int) -> list[tuple]:
+    matches: list[tuple] = []
+    for kind in TRANSFORM_KINDS:
+        if kind == "swap":
+            colors = sorted(set(map(int, np.unique(before))) - {int(bg)})
+            for i, a in enumerate(colors):
