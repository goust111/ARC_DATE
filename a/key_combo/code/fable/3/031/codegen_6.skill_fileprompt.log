+            palette = random.sample(palette_pool, k=palette_size)
+            a, b = sorted(random.sample(palette, k=2))
+            spec = ("swap", int(a), int(b))
+            sprite = _random_pattern(h, w, palette, required_colors={a, b}, changed_by=spec)
+        else:
