+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    layout = _find_layout(g)
+    spec = layout["spec"]
+    bg = int(get_bg(g))
+    out = g.copy()
+
+    for comp in layout["main_comps"]:
