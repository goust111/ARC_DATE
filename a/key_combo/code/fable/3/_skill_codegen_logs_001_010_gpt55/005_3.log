+    h = cell_rows * STEP + 1
+    w = cell_cols * STEP + 1
+    grid = np.full((h, w), BLACK, dtype=int)
+    for r in range(0, h, STEP):
+        grid[r, :] = sep_color
+    for c in range(0, w, STEP):
+        grid[:, c] = sep_color
