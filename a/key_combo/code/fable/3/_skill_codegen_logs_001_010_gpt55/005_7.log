+def _make_branch_plan(n_bars: int, max_old: int, max_count: int) -> tuple[int, list[dict[str, int | str]]] | None:
+    if max_old < 3 or max_count < 2:
+        return None
+    shared = random.randint(2, min(5, max_count, max_old - 1))
