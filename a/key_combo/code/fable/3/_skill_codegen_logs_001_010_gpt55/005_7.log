def _gen_mark_blocked_top(
    blocked: np.ndarray, cells: tuple[tuple[int, int], ...]
) -> None:
    H, W = blocked.shape
    for r, c in cells:
        for dr, dc in _GEN_BLOCK_OFFSETS:
            rr, cc = r + dr, c + dc
            if 0 <= rr < H and 0 <= cc < W:
                blocked[rr, cc] = True


def _gen_input_cells_ok_top(
    cells: tuple[tuple[int, int], ...], blocked: np.ndarray
