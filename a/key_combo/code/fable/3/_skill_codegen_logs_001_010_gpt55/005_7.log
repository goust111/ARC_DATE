+    shared, plans = plan
+
+    cols = _choose_spaced_columns(width, n_bars)
+    if cols is None:
+        return None
+    colors = random.sample(BAR_COLORS, n_bars)
+
+    grid = np.full((height, width), BG, dtype=int)
+    specs: list[dict[str, int | str]] = []
+    color_counts: dict[int, int] = {}
