+
+
+def _split_options(grid: np.ndarray, room: tuple[int, int, int, int]):
+    r0, c0, r1, c1 = room
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    options = []
+
+    if width >= 2 * MIN_ROOM_SIDE + 1 and height >= MIN_ROOM_SIDE:
+        for c in range(c0 + MIN_ROOM_SIDE, c1 - MIN_ROOM_SIDE + 1):
