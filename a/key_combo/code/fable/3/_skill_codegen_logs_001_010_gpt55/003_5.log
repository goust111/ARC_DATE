+    labels = np.full((h, w), -1, dtype=int)
+    rooms: list[np.ndarray] = []
+    for sr, sc in np.argwhere(passable):
+        sr = int(sr)
+        sc = int(sc)
+        if labels[sr, sc] != -1:
+            continue
+        label = len(rooms)
+        stack = [(sr, sc)]
+        labels[sr, sc] = label
+        coords: list[tuple[int, int]] = []
+        while stack:
