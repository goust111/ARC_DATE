+def _center_mask(pattern: np.ndarray, cell_size: int) -> np.ndarray:
+    mask = np.zeros((cell_size, cell_size), dtype=bool)
+    ph, pw = pattern.shape
+    r0 = (cell_size - ph) // 2
+    c0 = (cell_size - pw) // 2
+    mask[r0 : r0 + ph, c0 : c0 + pw] = pattern
+    return mask
+
