+    for r, (r0, r1) in enumerate(row_spans):
+        for c, (c0, c1) in enumerate(col_spans):
+            cell = g[r0:r1, c0:c1]
+            mask = (cell != bg) & (cell != sep)
+            if not bool(mask.any()):
+                empty.append((r, c))
+                continue
