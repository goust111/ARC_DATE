+def _rot_rel(cell: tuple[int, int], turns: int) -> tuple[int, int]:
+    """Rotate a relative (r, c) coordinate clockwise around (0, 0)."""
+    r, c = map(int, cell)
+    turns %= 4
+    if turns == 0:
+        return r, c
+    if turns == 1:
+        return c, -r
+    if turns == 2:
+        return -r, -c
+    return -c, r
+
+
+def _neighbors(cell: tuple[int, int], connectivity: int = 4):
+    r, c = cell
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+        return
+
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr or dc:
+                yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    H, W = mask.shape
+    seen = np.zeros(mask.shape, dtype=bool)
+    out: list[np.ndarray] = []
+    for r0, c0 in np.argwhere(mask):
+        r0 = int(r0)
+        c0 = int(c0)
+        if seen[r0, c0]:
+            continue
+        cells: list[tuple[int, int]] = []
+        queue: deque[tuple[int, int]] = deque([(r0, c0)])
+        seen[r0, c0] = True
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for rr, cc in _neighbors((r, c), connectivity):
+                if 0 <= rr < H and 0 <= cc < W and bool(mask[rr, cc]) and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    queue.append((rr, cc))
+        out.append(np.array(cells, dtype=int))
+    return out
