+def _is_connected(cells: set[tuple[int, int]], connectivity: int = 8) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    stack = [start]
+    while stack:
+        cell = stack.pop()
+        for nb in _neighbors(cell, connectivity):
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                stack.append(nb)
+    return len(seen) == len(cells)
