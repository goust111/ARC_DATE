+    cells = {(ar, ac), (ar, ac + 1)}
+    while len(cells) < target:
+        candidates = []
+        for cell in cells:
+            for nb in _neighbors(cell, 4):
+                r, c = nb
+                if 0 <= r < h and 0 <= c < w and nb not in cells:
+                    candidates.append(nb)
