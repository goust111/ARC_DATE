+        queue: deque[tuple[int, int]] = deque([(r0, c0)])
+        seen[r0, c0] = True
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for rr, cc in _neighbors((r, c), connectivity):
