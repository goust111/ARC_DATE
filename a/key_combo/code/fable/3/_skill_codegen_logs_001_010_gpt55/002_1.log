+    H, W = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-GEN_PADDING, GEN_PADDING + 1):
+            for dc in range(-GEN_PADDING, GEN_PADDING + 1):
