+def _rot_rel(cell: tuple[int, int], turns: int) -> tuple[int, int]:
+    """Rotate a relative (r, c) coordinate clockwise around (0, 0)."""
+    r, c = map(int, cell)
+    turns %= 4
+    if turns == 0:
+        return r, c
+    if turns == 1:
+        return c, -r
+    if turns == 2:
+        return -r, -c
+    return -c, r
