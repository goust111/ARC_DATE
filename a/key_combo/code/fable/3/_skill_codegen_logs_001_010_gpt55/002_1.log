+    rotated = {_rot_rel(rel, rotation) for rel in rels}
+    r0, c0, r1, c1 = _bbox(rotated)
+    rows = range(GEN_PLACEMENT_BORDER - r0, H - GEN_PLACEMENT_BORDER - r1)
+    cols = range(GEN_PLACEMENT_BORDER - c0, W - GEN_PLACEMENT_BORDER - c1)
