+def _sprites(area: np.ndarray, bg: int) -> list[dict]:
+    sprites: list[dict] = []
+    for color in sorted(set(map(int, np.unique(area))) - {bg}):
+        for coords in _components(area == color):
+            sprites.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "key": _shape_key_from_coords(coords),
