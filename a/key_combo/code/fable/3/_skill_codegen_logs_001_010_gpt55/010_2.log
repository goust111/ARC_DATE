    if kind == 'D':
        return list(range(-(S - DIAGONAL_MIN_CELLS), S - DIAGONAL_MIN_CELLS + 1))
    if kind == 'U':
        return list(range(DIAGONAL_MIN_CELLS - 1, 2 * S - DIAGONAL_MIN_CELLS))
    raise ValueError(kind)


