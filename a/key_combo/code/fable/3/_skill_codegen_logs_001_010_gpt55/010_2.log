+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    pts = [(int(r) - r0, int(c) - c0) for r, c in coords]
+    return tuple(sorted(pts))
+
+
+def _shape_key_from_mask(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    return _shape_key_from_coords(np.argwhere(mask))
