    side = CELL_SIZE + n_seps * CELL_STRIDE - (TRUNCATED_CROP if truncated else 0)
    separators = CELL_SIZE + CELL_STRIDE * np.arange(n_seps)
    return side, separators, _gen_open_cells(side, separators)


