+    if not np.array_equal(actual, expected):
+        return None
+    if len(_sprites(sprite_area, BACKGROUND)) != len(sprites):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
