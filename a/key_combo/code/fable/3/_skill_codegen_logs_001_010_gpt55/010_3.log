    th = int(target_coords[:, 0].max() + 1)
    tw = int(target_coords[:, 1].max() + 1)
    sprite_norm = [(int(r - sprite_coords[:, 0].min()), int(c - sprite_coords[:, 1].min())) for r, c in sprite_coords]

