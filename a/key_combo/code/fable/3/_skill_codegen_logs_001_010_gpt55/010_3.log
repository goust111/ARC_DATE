            sprite_out = tuple(sorted((r - r0, c - c0) for r, c in moved))
            key = (r1 - r0 + 1, c1 - c0 + 1, target_out, sprite_out)
            matches[key] = {
                "shape": (r1 - r0 + 1, c1 - c0 + 1),
                "target": target_out,
                "sprite": sprite_out,
            }
    return list(matches.values())


