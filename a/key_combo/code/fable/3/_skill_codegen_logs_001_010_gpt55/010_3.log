+    layout = _layout_regions(scaffold_h, scaffold_w, key_h, key_w)
+    if layout is None:
+        return None
+    height, width, scaffold_pos, key_pos = layout
+
+    line_color = random.randint(1, 9)
+    key = _make_key(key_rows, key_cols, line_color)
+    if key is None:
