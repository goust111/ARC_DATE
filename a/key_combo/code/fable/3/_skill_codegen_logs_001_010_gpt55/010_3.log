+    wrong_default_phase = _stamp_with_key(
+        grid,
+        scaffold_pos,
+        rows,
+        cols,
+        cell_h,
+        cell_w,
+        key_values,
+        anchor,
+        source,
+        offsets,
+        phase_locked=False,
+    )
+    if np.array_equal(expected, wrong_default_phase):
+        return None
+
+    tiled_colors = [
+        int(key_values[(i - sr + anchor[0]) % key_rows, (j - sc + anchor[1]) % key_cols])
+        for i in range(rows)
+        for j in range(cols)
