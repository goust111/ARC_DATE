+            colors = set(map(int, np.unique(sub[mask])))
+            assert len(colors) == 1, "the seed motif must be monochrome"
+            offsets = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+            hits.append((i, j, colors.pop(), offsets))
