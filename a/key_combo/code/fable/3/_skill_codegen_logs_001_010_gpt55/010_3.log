+            sub = np.zeros((bh, bw), dtype=bool)
+            sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            row_lines = np.flatnonzero(np.all(sub, axis=1))
+            col_lines = np.flatnonzero(np.all(sub, axis=0))
+            if len(row_lines) < 2 or len(col_lines) < 2:
+                continue
