+    return int(sr), int(sc)
+
+
+def _expected_from_meta(shape: tuple[int, int], wall: int, meta: list[dict[str, object]]) -> np.ndarray:
+    out = np.full(shape, int(wall), dtype=int)
+    for item in meta:
