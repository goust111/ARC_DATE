+        return None
+
+    row_spans, wall_rows = _starts_from_sizes(row_sizes)
+    col_spans, wall_cols = _starts_from_sizes(col_sizes)
+    height = sum(row_sizes) + len(wall_rows)
+    width = sum(col_sizes) + len(wall_cols)
+    if max(height, width) > 30:
