+        seq = item["seq"]  # type: ignore[assignment]
+        out[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = _paint_no_cycle(
+            int(r1) - int(r0) + 1,
+            int(c1) - int(c0) + 1,
