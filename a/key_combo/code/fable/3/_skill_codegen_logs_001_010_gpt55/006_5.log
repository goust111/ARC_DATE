    colors = set(map(int, np.unique(g)))
    assert colors <= {0, 8}

    out = g.copy()
    rects = find_components(g, bg=0, colors=[8], connectivity=4)
    assert rects
    assert sum(int(rect["area"]) for rect in rects) == int(np.count_nonzero(g == 8))

