+
+def _distance_to_rect_boundary(h: int, w: int) -> np.ndarray:
+    rows = np.arange(int(h))
+    cols = np.arange(int(w))
+    dr = np.minimum(rows, int(h) - 1 - rows)[:, None]
+    dc = np.minimum(cols, int(w) - 1 - cols)[None, :]
+    return np.minimum(dr, dc).astype(int)
