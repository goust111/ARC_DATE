    sizes = []
    remaining = total
    for slots in range(k, 0, -1):
        lo = max(min_size, remaining - max_size * (slots - 1))
        hi = min(max_size, remaining - min_size * (slots - 1))
        size = random.randint(lo, hi)
        sizes.append(size)
        remaining -= size
