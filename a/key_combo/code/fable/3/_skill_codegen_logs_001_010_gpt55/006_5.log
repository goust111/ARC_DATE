+    expected = _expected_from_meta(grid.shape, wall, meta)
+    if not _semantic_guard(grid, expected, wall, meta):
+        return None
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
