+        label += 1
+        cells: list[tuple[int, int]] = []
+        queue: deque[tuple[int, int]] = deque([(sr, sc)])
+        labels[sr, sc] = label
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < H and 0 <= cc < W and bool(mask[rr, cc]) and labels[rr, cc] == 0:
+                    labels[rr, cc] = label
+                    queue.append((rr, cc))
