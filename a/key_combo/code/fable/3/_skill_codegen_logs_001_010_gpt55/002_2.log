+    bottom = g[idx + 1 :, :]
+    top_count = _palette_pixel_count(top)
+    bottom_count = _palette_pixel_count(bottom)
+    assert (top_count > 0) != (bottom_count > 0), "exactly one side must contain palette bars"
+    if top_count > 0:
