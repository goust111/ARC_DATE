+        assert 0 < idx < W - 1, "vertical separator must split two nonempty sides"
+        left = g[:, :idx]
+        right = g[:, idx + 1 :]
+        left_count = _palette_pixel_count(left)
+        right_count = _palette_pixel_count(right)
