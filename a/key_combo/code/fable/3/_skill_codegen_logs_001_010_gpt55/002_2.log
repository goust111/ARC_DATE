+GEN_PLACEMENT_RETRIES = 160
+GEN_GROUP_COUNT_RANGE = (3, 5)
+GEN_VERTICAL_MAIN_H_RANGE = (17, 26)
+GEN_HORIZONTAL_MAIN_W_RANGE = (17, 27)
