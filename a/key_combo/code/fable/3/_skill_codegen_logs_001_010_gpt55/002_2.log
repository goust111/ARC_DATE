+        min_main = 19 if max_depth == 3 else 17
+        main_w = random.randint(min_main, 30 - legend_w - 1)
+        main_h = random.randint(max(min_main, GEN_VERTICAL_MAIN_H_RANGE[0]), GEN_VERTICAL_MAIN_H_RANGE[1])
+        legend_h = main_h
