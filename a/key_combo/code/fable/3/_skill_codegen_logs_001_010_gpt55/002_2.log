+        grid = np.zeros((mh, mw + 1 + lw), dtype=int)
+        grid[:, :mw] = main_area
+        grid[:, mw] = GREY
+        grid[:, mw + 1 :] = legend
+        return grid
+    if side == "top":
+        assert lw == mw
+        grid = np.zeros((lh + 1 + mh, mw), dtype=int)
+        grid[:lh, :] = legend
+        grid[lh, :] = GREY
+        grid[lh + 1 :, :] = main_area
+        return grid
+
+    assert side == "bottom"
+    assert lw == mw
+    grid = np.zeros((mh + 1 + lh, mw), dtype=int)
+    grid[:mh, :] = main_area
+    grid[mh, :] = GREY
+    grid[mh + 1 :, :] = legend
+    return grid
+
+
+def _expected_from_known_semantics(
+    grid: np.ndarray,
+    main_slice: tuple[slice, slice],
+    depth_colors: dict[int, int],
+) -> np.ndarray | None:
