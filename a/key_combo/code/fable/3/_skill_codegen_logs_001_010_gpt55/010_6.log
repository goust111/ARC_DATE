+        palette = random.sample(COLORS, color_count)
+        tile = np.array(random.choices(palette, k=rp * cp), dtype=int).reshape(rp, cp)
+        for color in palette:
+            tile[random.randrange(rp), random.randrange(cp)] = int(color)
