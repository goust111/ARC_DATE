+    bg = _get_bg(g)
+    comps = _components_mask(g != bg)
+    assert len(comps) >= 2, "expected several scattered fragments"
+    pieces: list[dict] = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        cells = tuple(
+            sorted(
+                (int(r) - r0, int(c) - c0, int(g[int(r), int(c)]))
+                for r, c in coords
+            )
+        )
