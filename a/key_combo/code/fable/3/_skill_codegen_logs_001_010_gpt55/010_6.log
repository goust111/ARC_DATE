+            idx = int(idx)
+            if int(tile[idx]) == -1:
+                tile[idx] = int(color)
+                changed_tile.append(idx)
+        for cell, color in cand["cells"]:
+            cell = int(cell)
+            occupied[cell] = True
+            board[cell] = int(color)
+            changed_cells.append(cell)
+        return changed_cells, changed_tile
