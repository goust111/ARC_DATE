+def _terminal_color(color: int, mapping: dict[int, int]) -> int:
+    seen: set[int] = set()
+    cur = int(color)
+    while cur in mapping:
+        assert cur not in seen, "mapping chain must be acyclic"
+        seen.add(cur)
+        cur = int(mapping[cur])
+    return cur
