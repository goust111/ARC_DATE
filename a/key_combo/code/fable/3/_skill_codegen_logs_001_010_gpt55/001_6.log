+    out = g.copy()
+    for obj in objects:
+        coords = obj["coords"]
+        assert isinstance(coords, np.ndarray)
+        terminal = _terminal_color(int(obj["color"]), mapping)
+        out[coords[:, 0], coords[:, 1]] = int(terminal)
