+    has_unmarked_key = False
+    has_unmarked_nonkey = False
+    for obj in objects:
+        color = int(obj["color"])
+        marker = obj["marker"]
+        terminal = _terminal_color(color, mapping)
+        if marker is not None and int(marker) in mapping and terminal != int(marker):
