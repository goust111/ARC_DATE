+
+def _random_object_mask(marked: bool) -> tuple[np.ndarray, tuple[int, int] | None] | None:
+    for _ in range(SPRITE_ATTEMPTS):
+        if marked:
+            height = random.randint(3, 5)
+            width = random.randint(3, 6)
+        else:
+            height = random.randint(2, 5)
+            width = random.randint(3, 6)
+            if height * width < 5:
+                continue
