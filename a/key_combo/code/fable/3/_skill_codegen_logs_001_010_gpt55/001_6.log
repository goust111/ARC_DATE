+def _render(objects: list[dict[str, object]], mapping: dict[int, int], shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.zeros(shape, dtype=int)
+    expected = np.zeros(shape, dtype=int)
