+        mask = obj["mask"]
+        assert isinstance(mask, np.ndarray)
+        r0 = int(obj["r"])
+        c0 = int(obj["c"])
+        body = int(obj["color"])
+        marker = obj["marker"]
+
+        rel = np.argwhere(mask)
+        rr = r0 + rel[:, 0]
+        cc = c0 + rel[:, 1]
+        inp[rr, cc] = body
+        if marker is not None:
+            mr, mc = obj["marker_rel"]  # type: ignore[misc]
