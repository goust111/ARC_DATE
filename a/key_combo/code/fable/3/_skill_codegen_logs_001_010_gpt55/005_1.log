+            used_distances.add(dist)
+            return {"r": rr, "c": cc, "color": color, "name": "extra"}
+    return None
+
+
+def _find_unfilled_cell(
+    full: np.ndarray, holes: set[tuple[int, int]], avoid_color: int
+) -> tuple[int, int] | None:
+    h, w = full.shape
+    candidates = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if int(full[r, c]) != avoid_color and _far_from(holes, r, c)
