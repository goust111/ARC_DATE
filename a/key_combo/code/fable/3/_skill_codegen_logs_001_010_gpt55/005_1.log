+    filled: list[tuple[dict, tuple[int, int]]] = []
+    deleted: list[dict] = []
+    if ordered_spares is None:
+        ordered_spares = sorted(
+            spares,
+            key=lambda s: (_path_to_pattern(s, bbox)[0], int(s["r"]), int(s["c"])),
+        )
