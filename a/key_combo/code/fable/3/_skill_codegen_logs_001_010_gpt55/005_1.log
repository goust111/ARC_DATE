+def _attempt_generate() -> np.ndarray | None:
+    pr = random.choice((2, 3, 4))
+    pc = random.choice((2, 3, 4))
+    rep_r = random.choice((3, 4, 5))
+    rep_c = random.choice((3, 4, 5))
+    ph, pw = pr * rep_r, pc * rep_c
+
