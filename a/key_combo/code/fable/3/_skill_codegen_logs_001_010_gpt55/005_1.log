+def _apply_repair(
+    g: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    demands: dict[tuple[int, int], int],
+    spares: list[dict],
+    ordered_spares: list[dict] | None = None,
+):
+    r0, c0, _r1, _c1 = bbox
+    out = g.copy()
+    for spare in spares:
+        out[int(spare["r"]), int(spare["c"])] = BLACK
