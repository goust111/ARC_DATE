+    h, w = map(int, shape)
+    r, c, dr, dc = _opening_start_and_step(cup)
+    cells: list[tuple[int, int]] = []
+    for _ in range(int(overflow)):
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        cells.append((r, c))
+        r += 2 * dr
+        c += 2 * dc
+    return cells
+
