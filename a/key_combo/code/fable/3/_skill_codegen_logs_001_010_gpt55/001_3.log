+def _outline_mask(shape: tuple[int, int], direction: str) -> np.ndarray | None:
+    h, w = map(int, shape)
+    mask = np.zeros((h, w), dtype=bool)
+    if direction == "up":
+        if h < 4 or w < 5 or (w - 2) % 2 != 1:
+            return None
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif direction == "down":
+        if h < 4 or w < 5 or (w - 2) % 2 != 1:
+            return None
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif direction == "left":
+        if h < 5 or w < 4 or (h - 2) % 2 != 1:
+            return None
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif direction == "right":
+        if h < 5 or w < 4 or (h - 2) % 2 != 1:
+            return None
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        return None
+    return mask
