+def _place_markers(grid: np.ndarray, cup: Cup, color: int, layers: int) -> None:
+    cells = _cup_count_cells(cup)
+    needed = int(cup.width) * int(layers)
+    assert 0 < needed <= len(cells)
+    chosen = random.sample(cells, needed)
+    for r, c in chosen:
+        grid[r, c] = int(color)
