+            reserve_cells.update(overflow_cells)
+            if reserve_cells & reserved:
+                continue
+            reserved.update(reserve_cells)
+            _render_outline(grid, cup)
+            _place_markers(grid, cup, color, layers)
+            specs.append((cup, color, layers))
+            placed = True
+            break
