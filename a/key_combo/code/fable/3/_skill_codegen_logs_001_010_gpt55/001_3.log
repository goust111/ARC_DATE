+        if h < 4 or w < 5 or (w - 2) % 2 != 1:
+            return None
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif direction == "down":
+        if h < 4 or w < 5 or (w - 2) % 2 != 1:
+            return None
+        mask[:, 0] = True
+        mask[:, -1] = True
