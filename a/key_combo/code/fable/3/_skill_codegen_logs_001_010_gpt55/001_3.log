+BACKGROUND = 0
+OUTLINE = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
+VERTICAL_DIRS = ("up", "down")
+HORIZONTAL_DIRS = ("left", "right")
+GENERATION_ATTEMPTS = 600
