+    elif cup.direction == "left":
+        for r in range(r0 + 1, r1):
+            for c in range(c0, c1):
+                cells.append((r, c))
+    else:
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1 + 1):
+                cells.append((r, c))
+    return cells
+
