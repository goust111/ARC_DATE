+    if cup.direction == "up":
+        return r0 - 1, (c0 + c1) // 2, -1, 0
+    if cup.direction == "down":
+        return r1 + 1, (c0 + c1) // 2, 1, 0
+    if cup.direction == "left":
+        return (r0 + r1) // 2, c0 - 1, 0, -1
+    return (r0 + r1) // 2, c1 + 1, 0, 1
