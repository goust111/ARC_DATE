+def _cup_capacity_cells(cup: Cup, layers: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = cup.bbox
+    layers = int(min(layers, cup.depth))
+    cells: list[tuple[int, int]] = []
+    if layers <= 0:
