+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for sr in range(h):
+        for sc in range(w):
+            if not bool(mask[sr, sc]) or bool(seen[sr, sc]):
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
