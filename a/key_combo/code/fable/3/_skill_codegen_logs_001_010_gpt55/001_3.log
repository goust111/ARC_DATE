+    if direction == "left" and overflow:
+        min_c = max(min_c, 2)
+    if direction == "right" and overflow:
+        max_c = min(max_c, w - outer_w - 2)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    r = random.randint(min_r, max_r)
+    c = random.randint(min_c, max_c)
