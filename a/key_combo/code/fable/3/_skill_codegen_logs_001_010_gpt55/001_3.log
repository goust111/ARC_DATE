+    flags = [True, False]
+    while len(flags) < n:
+        flags.append(random.random() < 0.45)
+    random.shuffle(flags)
+    return flags
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(16, 30)
+    width = random.randint(16, 30)
+    shape = (height, width)
