+        grid[r1, c0 : c1 + 1] = OUTLINE
+    elif cup.direction == "down":
+        grid[r0 : r1 + 1, c0] = OUTLINE
+        grid[r0 : r1 + 1, c1] = OUTLINE
+        grid[r0, c0 : c1 + 1] = OUTLINE
+    elif cup.direction == "left":
+        grid[r0, c0 : c1 + 1] = OUTLINE
+        grid[r1, c0 : c1 + 1] = OUTLINE
+        grid[r0 : r1 + 1, c1] = OUTLINE
+    else:
+        grid[r0, c0 : c1 + 1] = OUTLINE
+        grid[r1, c0 : c1 + 1] = OUTLINE
+        grid[r0 : r1 + 1, c0] = OUTLINE
+
