+            cup_depth = random.randint(2, 5)
+            layers = cup_depth + 1 if overflow_flag else random.randint(1, cup_depth)
+            cup = _candidate_cup(shape, direction, cup_width, cup_depth, int(overflow_flag))
+            if cup is None:
