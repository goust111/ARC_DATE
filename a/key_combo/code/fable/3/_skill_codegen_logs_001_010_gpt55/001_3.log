+def _cup_from_top_left(direction: str, r: int, c: int, width: int, depth: int) -> Cup:
+    if direction in VERTICAL_DIRS:
+        h = depth + 2
+        w = width + 2
+    else:
+        h = width + 2
+        w = depth + 2
+    return Cup(direction, (int(r), int(c), int(r + h - 1), int(c + w - 1)), int(width), int(depth))
