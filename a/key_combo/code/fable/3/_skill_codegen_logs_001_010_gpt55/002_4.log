+    coords = [(r, c) for r, c, _value in anomalies]
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c, value in anomalies:
+        out[r - r0, c - c0] = int(value)
+    return out
+
