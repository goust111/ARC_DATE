+def _all_rotation_orbits(n: int) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    orbits: list[list[tuple[int, int]]] = []
+    for r in range(n):
+        for c in range(n):
+            if (r, c) in seen:
+                continue
+            orbit = _rotation_orbit(n, r, c)
+            seen.update(orbit)
+            orbits.append(orbit)
+    return orbits
