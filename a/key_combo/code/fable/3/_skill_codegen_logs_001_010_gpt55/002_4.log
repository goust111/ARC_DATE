+
+BLACK = 0
+ARC_COLORS = tuple(range(10))
+
+_GRID_SIZES = (9, 11, 13, 15, 17, 19, 21, 23, 25)
+_GEN_RETRY_LIMIT = 500
+_SPRITE_RETRY_LIMIT = 120
+_GEN_MODE_COUNT = 4
+_GEN_CALL_COUNT = 0
+_SEEN_OUTPUT_SIGNATURES: set[tuple[tuple[int, int], bytes]] = set()
