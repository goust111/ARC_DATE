+def _gen_attempt(mode: int) -> tuple[np.ndarray, np.ndarray] | None:
+    rng = np.random.default_rng()
+    n = int(rng.choice(np.array(_GRID_SIZES, dtype=int)))
+    palette = _sample_palette(rng)
+    base = _build_symmetric_base(n, palette, rng)
