+def _stamp_grid(base: np.ndarray, coords: list[tuple[int, int]], values: list[int]) -> np.ndarray:
+    grid = base.copy()
+    for (r, c), value in zip(coords, values):
+        grid[r, c] = int(value)
+    return grid
