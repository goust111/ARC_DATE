+def _is_rotationally_symmetric(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    if h != w:
+        return False
+    for r in range(h):
+        for c in range(w):
+            rr, cc = _rot90_coord(h, r, c)
+            if int(g[r, c]) != int(g[rr, cc]):
