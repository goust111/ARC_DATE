+def _detect_barriers(g: np.ndarray, bg: int) -> list[Barrier]:
+    h, w = g.shape
+    barriers: list[Barrier] = []
+    for r in range(h):
+        row = g[r]
+        if int(row[0]) == bg or int(row[-1]) == bg:
+            continue
+        gap_runs = _true_runs(row == bg)
+        if len(gap_runs) != 1:
+            continue
+        g0, g1 = gap_runs[0]
+        if g0 == 0 or g1 == w - 1:
+            continue
+        solid = row[row != bg]
+        if solid.size == 0 or len(set(map(int, solid))) != 1:
+            continue
+        if solid.size < 4:
+            continue
