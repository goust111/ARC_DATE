+
+BACKGROUND = 0
+BARRIER_COLOR = 5
+BAR_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 500
+
+
+@dataclass(frozen=True)
+class Barrier:
+    row: int
+    gap: tuple[int, int]
+    color: int
+
+
+@dataclass(frozen=True)
+class Bar:
+    row: int
+    span: tuple[int, int]
+    color: int
