+        occupied[coords[:, 0], coords[:, 1]] = True
+    return out, truncated_moves, full_moves
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.choice([8, 9])
+    w = random.choice([8, 9])
+    n_frames = 3
+    side = random.choice(SIDES)
+    horizontal = random.choice([False, True])
+    objects = _build_objects(h, w)
+
+    try:
