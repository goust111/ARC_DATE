+        velocity = _velocity_from_anchors(anchors, direction)
+        obj = dict(states[-1][color])
+        obj["color"] = color
+        obj["velocity"] = velocity
+        if velocity == (0, 0):
+            settled.append(obj)
+        else:
+            moving.append(obj)
