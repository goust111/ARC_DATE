+) -> tuple[np.ndarray, bool]:
+    vr, vc = velocity
+    mag = max(abs(vr), abs(vc))
+    if mag == 0:
+        return coords.copy(), False
+    step = np.array([0 if vr == 0 else int(vr / abs(vr)), 0 if vc == 0 else int(vc / abs(vc))])
+    h, w = occupied.shape
