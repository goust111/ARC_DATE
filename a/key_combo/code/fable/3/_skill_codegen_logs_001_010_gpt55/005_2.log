+            pw = (w - (n - 1)) // n
+            if pw >= 4:
+                divs = [i * (pw + 1) - 1 for i in range(1, n)]
+                colors = [int(g[0, c]) for c in divs]
+                if len(set(colors)) == 1 and colors[0] != bg:
