+                colors = [int(g[0, c]) for c in divs]
+                if len(set(colors)) == 1 and colors[0] != bg:
+                    if all(np.all(g[:, c] == colors[0]) for c in divs):
+                        panels = [g[:, i * (pw + 1) : i * (pw + 1) + pw].copy() for i in range(n)]
+                        candidates.append(panels)
+
+        if (h - (n - 1)) % n == 0:
+            ph = (h - (n - 1)) // n
+            if ph >= 4:
