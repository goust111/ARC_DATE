+def _settle_key(obj: dict, direction: tuple[int, int]) -> tuple[int, int, int, int]:
+    dr, dc = direction
+    r0, c0, r1, c1 = obj["bbox"]
+    if dr == -1:
+        return (r0, c0, c1, r1)
+    if dr == 1:
