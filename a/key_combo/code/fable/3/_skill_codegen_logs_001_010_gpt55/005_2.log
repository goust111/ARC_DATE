+    h, w = panel.shape
+    specs = [
+        ("top", (-1, 0), panel[0, :]),
+        ("bottom", (1, 0), panel[h - 1, :]),
+        ("left", (0, -1), panel[:, 0]),
+        ("right", (0, 1), panel[:, w - 1]),
+    ]
