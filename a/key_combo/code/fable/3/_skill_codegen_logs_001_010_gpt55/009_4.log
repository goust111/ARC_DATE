                if all(mask[x, y] for x, y in cells) or _gen_orbit_blocked(cells, blocked):
                    continue
                if not _gen_has_neighbor(mask, cells):
                    continue
                if len(cells) <= remaining:
                    candidates.append(cells)
                else:
                    overshoot.append(cells)

        if candidates:
