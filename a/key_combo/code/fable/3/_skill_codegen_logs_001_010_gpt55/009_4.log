+def _candidate_matrix(g, cavities, colors, surface_r, cluster_mask) -> list[list[int]]:
+    rows: list[list[int]] = []
+    for cavity in cavities:
+        row = []
+        for i, color in enumerate(colors):
+            if _candidate_offsets(g, cavity["shape"], int(color), surface_r, cluster_mask):
+                row.append(i)
+        rows.append(row)
+    return rows
