+    else:
+        scatter_box = (1, 1, h - 2, w - panel_w - gap - 1)
+
+    random.shuffle(objects)
+    objects.sort(key=lambda mask: int(mask.size), reverse=True)
+    for mask in objects:
+        mh, mw = mask.shape
+        sr0, sc0, sr1, sc1 = scatter_box
+        if mh > sr1 - sr0 + 1 or mw > sc1 - sc0 + 1:
+            return False
+        placed = False
