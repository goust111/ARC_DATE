+def _shape_catalog() -> dict[int, list[np.ndarray]]:
+    global _CATALOG
+    if _CATALOG is not None:
+        return _CATALOG
+
+    shape_texts = (
+        ("11",),
+        ("111",),
+        ("10", "11"),
+        ("1111",),
+        ("11", "11"),
+        ("100", "111"),
+        ("111", "010"),
+        ("111", "010", "010"),
+        ("110", "010", "011"),
+        ("111", "100", "100"),
+        ("010", "111", "010"),
+        ("111", "111"),
+        ("1110", "0011", "0010"),
+        ("100", "100", "111", "100"),
+        ("111", "101", "110"),
+        ("111", "111", "010"),
+        ("111", "101", "111"),
+        ("1111", "1111"),
+        ("111", "111", "110"),
+        ("1111", "0100", "0111"),
