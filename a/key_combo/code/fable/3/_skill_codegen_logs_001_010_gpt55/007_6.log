+            return False
+    return True
+
+
+def _raw_crop_for_entry(entry: dict) -> np.ndarray:
+    return _paint_mask(entry["mask"], int(entry["color"]))
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    n: int,
+    raw_count: int,
+    scatter_color: int,
+    entries: list[dict],
+) -> bool:
+    if grid.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
