+        sr0, sc0, sr1, sc1 = scatter_box
+        if mh > sr1 - sr0 + 1 or mw > sc1 - sc0 + 1:
+            return False
+        placed = False
+        for _ in range(250):
+            r0 = random.randint(sr0, sr1 - mh + 1)
+            c0 = random.randint(sc0, sc1 - mw + 1)
+            if _can_place_object(grid, mask, r0, c0, scatter_box):
