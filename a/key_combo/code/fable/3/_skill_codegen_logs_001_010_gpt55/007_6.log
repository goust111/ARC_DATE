+        _CLASS_COUNT_CYCLE = [2, 3, 4]
+        random.shuffle(_CLASS_COUNT_CYCLE)
+    return _CLASS_COUNT_CYCLE.pop()
+
+
+def _next_panel_left() -> bool:
+    global _PANEL_SIDE_CYCLE
+    if not _PANEL_SIDE_CYCLE:
