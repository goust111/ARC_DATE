+    heights = [int(entry["mask"].shape[0]) for entry in entries]
+    min_total = sum(heights) + len(entries) + 1
+    if min_total > h:
+        return False
+    gaps = [1] * (len(entries) + 1)
+    extra = h - min_total
+    for add, gap_i in zip(_distribute_extra(extra, len(gaps)), range(len(gaps))):
+        gaps[gap_i] += add
