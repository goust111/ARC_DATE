+        r_end = min(h, r + 2)
+        c_start = max(0, c - 1)
+        c_end = min(w, c + 2)
+        if np.any(grid[r_start:r_end, c_start:c_end] != BACKGROUND):
+            return False
+    return True
+
+
+def _place_scatter(
+    grid: np.ndarray,
+    panel_left: bool,
+    panel_w: int,
+    objects: list[np.ndarray],
+    color: int,
