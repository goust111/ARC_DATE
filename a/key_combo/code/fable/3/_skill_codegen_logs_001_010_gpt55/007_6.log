    targets[1] = max(targets.values(), default=0) + random.randint(5, 9)
    return targets


def _split_component_areas(count: int, total: int) -> list[int]:
    sizes = [1] * int(count)
    extra = int(total) - int(count)
    while extra > 0:
        idx = random.randrange(len(sizes))
        add = random.randint(1, min(2, extra))
        sizes[idx] += add
