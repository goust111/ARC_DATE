+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GENERATION_RETRIES = 700
+
+
+Coord = tuple[int, int]
+
+
+@dataclass(frozen=True)
+class Axis:
+    color: int
+    kind: str
+    value: int
