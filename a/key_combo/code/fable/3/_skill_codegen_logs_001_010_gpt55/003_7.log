+    if set(parsed) != {axis.color for axis in axes}:
+        return False
+    if len(endpoints) != 4:
+        return False
+
+    added = np.count_nonzero(expected != inp)
+    if added < 8:
+        return False
+    return bool(np.array_equal(solved, expected))
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 30)
+    w = random.randint(18, 30)
+    shape = (h, w)
