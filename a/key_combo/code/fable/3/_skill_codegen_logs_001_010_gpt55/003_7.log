+    for p in endpoints:
+        by_color.setdefault(int(g[p]), []).append(p)
+    assert len(by_color) == 2, "endpoints must form two same-color pairs"
+
+    axes: dict[int, Axis] = {}
+    kinds: set[str] = set()
+    endpoint_set = set(endpoints)
+    for color, pts in by_color.items():
+        axis = _axis_from_pair(g.shape, int(color), pts)
+        axes[int(color)] = axis
+        kinds.add(axis.kind)
