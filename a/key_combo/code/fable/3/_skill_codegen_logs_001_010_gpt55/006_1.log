    grid = _gen_place_input_rect(h, w, rect)
    try:
        if np.array_equal(main(grid), rect):
            return grid
    except Exception:
        return None
    return None


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 7468f01a input")

