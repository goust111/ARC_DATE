+
+def _normalize_cells(cells: set[tuple[int, int]]) -> np.ndarray:
+    min_r = min(r for r, _c in cells)
+    min_c = min(c for _r, c in cells)
+    arr = np.array(sorted((r - min_r, c - min_c) for r, c in cells), dtype=int)
+    return arr
+
+
