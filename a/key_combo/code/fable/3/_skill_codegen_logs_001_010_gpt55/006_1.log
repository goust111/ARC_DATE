+    arr = np.array(cells, dtype=int)
+    if random.random() < 0.5:
+        arr = arr[:, [1, 0]]
+    if random.random() < 0.5:
+        arr[:, 0] = -arr[:, 0]
+    if random.random() < 0.5:
+        arr[:, 1] = -arr[:, 1]
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    return np.array(sorted(map(tuple, arr)), dtype=int)
+
+
