    rh, rw = rect.shape
    grid = np.full((h, w), _GEN_BG_COLOR, dtype=int)
    r0 = random.randint(_GEN_PLACEMENT_BORDER, h - rh - _GEN_PLACEMENT_BORDER)
    c0 = random.randint(_GEN_PLACEMENT_BORDER, w - rw - _GEN_PLACEMENT_BORDER)
