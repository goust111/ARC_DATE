+    if not np.array_equal(out, expected):
+        return False
+    if out.shape[0] >= grid.shape[0] or out.shape[1] >= grid.shape[1]:
+        return False
+    if _count_mixed_four_bar_centers(grid, bg) < 1:
+        return False
+    if int(np.count_nonzero(out != int(bg))) < TRUE_PLUS_COUNT:
+        return False
+    return True
