+        other_choices = [x for x in palette if int(x) != int(base)]
+        if not other_choices:
+            continue
+        colors = [int(base)] * len(ARM_BARS)
+        for idx in rng.sample(range(len(colors)), rng.choice([1, 2])):
+            colors[idx] = int(rng.choice(other_choices))
