+        if orient == "h":
+            r = rng.randrange(height)
+            c = rng.randrange(width - 1)
+            bars = [[(r, c), (r, c + 1)]]
+        else:
+            r = rng.randrange(height - 1)
+            c = rng.randrange(width)
+            bars = [[(r, c), (r + 1, c)]]
