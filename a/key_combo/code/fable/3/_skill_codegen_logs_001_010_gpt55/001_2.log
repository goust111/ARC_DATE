    rows = [r for r, _c in centers]
    cols = [c for _r, c in centers]
    r0, r1 = min(rows), max(rows)
    c0, c1 = min(cols), max(cols)
    corner_set = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
