+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
+    bg = int(get_bg(grid))
+    if int(np.count_nonzero(grid == bg)) <= max(int(np.count_nonzero(grid == c)) for c in colors_present(grid, exclude={bg})):
