+def _frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = map(int, mask.shape)
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if bool(mask[r, c]):
+                continue
+            if any(0 <= r + dr < h and 0 <= c + dc < w and bool(mask[r + dr, c + dc]) for dr, dc in ORTHOGONAL):
