+def _next_rotate_branch() -> bool:
+    global _BRANCH_QUEUE
+    if not _BRANCH_QUEUE:
+        _BRANCH_QUEUE = [False, True, random.choice([False, True])]
+        random.shuffle(_BRANCH_QUEUE)
+    return bool(_BRANCH_QUEUE.pop())
