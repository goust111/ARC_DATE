+
+def _carve_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = map(int, start)
+    er, ec = map(int, end)
+    mask[r, c] = True
+    while (r, c) != (er, ec):
+        moves: list[tuple[int, int]] = []
+        if r < er:
+            moves.append((1, 0))
+        elif r > er:
+            moves.append((-1, 0))
+        if c < ec:
+            moves.append((0, 1))
+        elif c > ec:
+            moves.append((0, -1))
+        dr, dc = random.choice(moves)
+        r += dr
+        c += dc
+        mask[r, c] = True
