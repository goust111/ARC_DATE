ORTHOGONAL = ((-1, 0), (1, 0), (0, -1), (0, 1))
DIAGONAL = ((-1, -1), (-1, 1), (1, -1), (1, 1))
ARC_COLORS = tuple(range(10))
GENERATION_ATTEMPTS = 600
SPRITE_ATTEMPTS = 120

