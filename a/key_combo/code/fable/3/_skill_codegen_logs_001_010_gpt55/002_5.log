    side = set()
    for r, c in cells:
        for cc in (c - 1, c + 1):
            if _in_bounds(shape, r, cc):
                side.add((r, cc))
    return side


def _gen_blocker_component_sizes(blockers):
    unseen = set(blockers)
    sizes = []
    while unseen:
        stack = [unseen.pop()]
        size = 0
        while stack:
            r, c = stack.pop()
            size += 1
            for nb in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if nb in unseen:
                    unseen.remove(nb)
