def _lr_path(W: int, lo: int, hi: int) -> list[tuple[int, int]] | None:
    short_turn, long_turn = LR_TURN_OPTIONS
    turn_goal = random.choice(LR_TURN_OPTIONS)
    if turn_goal == long_turn and W - 1 < long_turn:
