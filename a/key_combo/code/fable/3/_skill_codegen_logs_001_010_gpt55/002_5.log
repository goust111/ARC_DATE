+
+def _frame_from_component(g: np.ndarray, coords: np.ndarray, color: int, bg: int) -> dict | None:
+    b = _bbox(coords)
+    r0, c0, r1, c1 = b
+    if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+        return None
