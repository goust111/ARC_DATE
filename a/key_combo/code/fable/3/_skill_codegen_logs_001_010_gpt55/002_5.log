        if len(cells) != target_area:
            continue

        r0, c0, r1, c1 = _bbox_from_coords(list(cells))
        crop_h = r1 - r0 + 1
        crop_w = c1 - c0 + 1
        if crop_h < 2 or crop_w < 2:
