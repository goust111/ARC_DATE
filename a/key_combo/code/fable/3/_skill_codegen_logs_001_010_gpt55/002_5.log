SQUARE_MARGIN = 5
SQUARE_COLOR = Color.TEAL
BLOCKER_COLOR = Color.GRAY

# Output path constraints.
MAX_RED_RAY_LEN = 8
MAX_YELLOW_RIBBON_STEPS = 5
PAINTED_COUNT_RANGE = (31, 52)
MIN_ACTIVE_EMITTERS = 4
