+    gaps: list[dict] = []
+    for pos in missing:
+        if int(g[pos]) != int(bg):
+            return None
+        side_out = _gap_side_and_outward(b, pos)
+        if side_out is None:
+            return None
+        side, outward = side_out
+        gaps.append({"pos": pos, "side": side, "out": outward, "color": int(color)})
+
+    if len(gaps) == 2:
+        a, b_gap = gaps
+        ar, ac = a["out"]
+        br, bc = b_gap["out"]
+        if (ar, ac) != (-br, -bc):
+            return None
+        if ar and a["pos"][1] != b_gap["pos"][1]:
+            return None
+        if ac and a["pos"][0] != b_gap["pos"][0]:
+            return None
