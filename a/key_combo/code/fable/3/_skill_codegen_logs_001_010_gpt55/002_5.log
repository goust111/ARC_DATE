+        if len(closed_gaps) < min_closed:
+            continue
+
+        return {
+            "kind": kind,
+            "start": start_obj,
+            "final": final,
+            "object_color": object_color,
+            "closed": closed_gaps,
+            "lane_row": lane_r,
+        }
+
+    return None
