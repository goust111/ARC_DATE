+
+def _transform_grid(grid: np.ndarray, op: int) -> np.ndarray:
+    if op == 0:
+        out = grid
+    elif op == 1:
+        out = np.rot90(grid, 1)
+    elif op == 2:
+        out = np.rot90(grid, 2)
+    elif op == 3:
+        out = np.rot90(grid, 3)
+    elif op == 4:
+        out = np.fliplr(grid)
+    elif op == 5:
