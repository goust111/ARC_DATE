+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+NONBLACK = tuple(range(1, 10))
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+_GEN_RETRY_LIMIT = 700
+_GEN_CALL_COUNT = 0
+_GEN_SEEN_INPUTS: set[tuple[tuple[int, int], bytes]] = set()
