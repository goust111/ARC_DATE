        if max_area < 3:
            continue
        target_area = int(rng.integers(3, max_area + 1))

        cells = {(int(rng.integers(0, h)), int(rng.integers(0, w)))}
        moves = ((1, 0), (-1, 0), (0, 1), (0, -1))
        grow_attempts = 0
