GEN_SPRITE_AREA_RANGE = (12, 20)
GEN_FRAGMENT_COUNT_RANGE = (3, 5)
GEN_GRID_SIZE_RANGE = (20, 30)
GEN_PLACEMENT_BORDER = 1
GEN_PADDING = 1
GEN_MASK_RETRY_LIMIT = 160
GEN_PLACEMENT_RETRY_LIMIT = 120



