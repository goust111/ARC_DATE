+                closed_gaps.append(((lane_r, c_right), color))
+            elif spec["role"] == "transit":
+                gaps = {(lane_r, c_left), (lane_r, c_right)}
+                closed_gaps.append(((lane_r, c_left), color))
+                closed_gaps.append(((lane_r, c_right), color))
+            else:
