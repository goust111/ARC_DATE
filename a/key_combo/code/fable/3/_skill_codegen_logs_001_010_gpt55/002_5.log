+
+def _expected_from_records(inp: np.ndarray, records: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for record in records:
+        out[record["start"]] = BLACK
+    for record in records:
+        for pos, color in record["closed"]:
+            out[pos] = int(color)
