+            return None
+    except AssertionError:
+        return None
+
+    return _place_scene(template, counts, offsets, bg, t_color, o_color, origin_color)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GENERATION_RETRIES):
