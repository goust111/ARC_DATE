+def _spans_bbox(cells: set[Coord], h: int, w: int) -> bool:
+    return (
+        any(r == 0 for r, _ in cells)
+        and any(r == h - 1 for r, _ in cells)
+        and any(c == 0 for _, c in cells)
+        and any(c == w - 1 for _, c in cells)
