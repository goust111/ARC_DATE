+    def propagate(assign: list[int]) -> bool:
+        changed = True
+        while changed:
+            changed = False
+            for vs, kind in constraints:
+                yes = sum(1 for v in vs if assign[v] == 1)
+                unknown = [v for v in vs if assign[v] < 0]
