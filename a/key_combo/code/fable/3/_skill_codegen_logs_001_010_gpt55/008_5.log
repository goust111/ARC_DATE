    assert a.shape == (tile_h, tile_w) and b.shape == (tile_h, tile_w)

    xor = np.logical_xor(a, b)
    assert bool(xor.any()), "minority symmetric difference must be non-empty"
    out = np.full((tile_h, tile_w), BLACK, dtype=int)
    out[xor] = PINK
    return out


