+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    candidates = []
+    for color in sorted(int(x) for x in np.unique(grid) if int(x) != BG):
+        m = grid == color
+        corners = np.argwhere(m)
+        for r0, c0 in corners:
+            r0 = int(r0)
+            c0 = int(c0)
+            for r1 in range(r0 + 2, h):
+                if not m[r1, c0]:
+                    continue
+                for c1 in range(c0 + 2, w):
