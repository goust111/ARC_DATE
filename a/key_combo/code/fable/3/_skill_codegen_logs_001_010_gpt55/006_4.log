+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return max(int(a0), int(b0)) <= min(int(a1), int(b1))
