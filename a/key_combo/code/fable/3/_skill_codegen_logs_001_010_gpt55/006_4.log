+    if direction == "left":
+        return int(r), int(c1 + 1)
+    if direction == "down":
+        return int(r0 - size), int(c)
+    return int(r1 + 1), int(c)
+
+
+def _center_in_frame(fr: dict, size: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = fr["bbox"]
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    assert inner_h >= size and inner_w >= size
