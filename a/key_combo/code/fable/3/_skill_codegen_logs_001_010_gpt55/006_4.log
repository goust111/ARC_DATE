+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
+}
+FRONT_SIDE = {"right": "left", "left": "right", "down": "top", "up": "bottom"}
+REAR_SIDE = {"right": "right", "left": "left", "down": "bottom", "up": "top"}
