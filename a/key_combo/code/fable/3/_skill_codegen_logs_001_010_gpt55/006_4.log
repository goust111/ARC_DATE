+                break
+            if direction == "left" and fc1 < c0 and _overlap(r0, r1, fr0, fr1):
+                found.append(direction)
+                break
+            if direction == "down" and fr0 > r1 and _overlap(c0, c1, fc0, fc1):
+                found.append(direction)
+                break
+            if direction == "up" and fr1 < r0 and _overlap(c0, c1, fc0, fc1):
+                found.append(direction)
+                break
