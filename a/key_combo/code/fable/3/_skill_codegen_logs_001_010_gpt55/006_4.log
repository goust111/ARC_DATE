+    )
+    accepted = []
+    used: set[tuple[int, int]] = set()
+    for fr in candidates:
+        cells = set(fr["wall_cells"])
+        if cells and cells.isdisjoint(used):
+            accepted.append(fr)
+            used.update(cells)
+    accepted.sort(key=lambda fr: fr["bbox"])
+    return accepted
