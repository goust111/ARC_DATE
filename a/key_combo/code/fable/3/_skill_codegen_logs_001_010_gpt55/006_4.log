+    if not has_corridor_before_deadend:
+        return False
+    if np.array_equal(grid, expected):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    orientation = random.choice(["h", "v"])
+    sign = random.choice([-1, 1])
+    n_routes = random.choice([2, 3])
