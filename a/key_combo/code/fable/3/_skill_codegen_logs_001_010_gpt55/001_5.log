+    winners: list[int] = []
+    for i, mask in enumerate(masks):
+        ok = True
+        for j, other in enumerate(masks):
+            if i == j:
+                continue
+            if not np.all(np.logical_or(~other, mask)):
+                ok = False
+                break
+            if not np.any(mask & ~other):
+                ok = False
+                break
