+def _paint_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = map(int, start)
+    tr, tc = map(int, end)
+    mask[r, c] = True
+    axes = [0, 1]
+    random.shuffle(axes)
+    for axis in axes:
