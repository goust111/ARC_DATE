    r, c = map(int, start)
    tr, tc = map(int, end)
    mask[r, c] = True
    axes = [0, 1]
    random.shuffle(axes)
    for axis in axes:
        if axis == 0:
            while r != tr:
                r += 1 if tr > r else -1
                mask[r, c] = True
        else:
            while c != tc:
                c += 1 if tc > c else -1
                mask[r, c] = True


