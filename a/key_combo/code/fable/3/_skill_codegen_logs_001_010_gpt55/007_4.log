    min_non_marker = max(int(np.ceil(NON_MARKER_DENSITY_MIN * total)), stripe_non_bg + len(GEN_COLORS))
    max_non_marker = min(int(np.floor(NON_MARKER_DENSITY_MAX * total)), total - 2 * marker_count - 1)
