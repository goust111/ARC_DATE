+    if mode == "aligned" and not np.array_equal(raw, expected):
+        return False
+
+    no_overlap_recolor = expected.copy()
+    no_overlap_recolor[no_overlap_recolor == YELLOW] = left_color
+    if np.array_equal(no_overlap_recolor, expected):
