+    small = np.zeros((3, 3), dtype=bool)
+    for r in range(3):
+        for c in range(3):
+            block = patch[r * scale : (r + 1) * scale, c * scale : (c + 1) * scale]
+            if np.all(block == int(color)):
+                small[r, c] = True
+            elif np.all(block == BACKGROUND):
+                small[r, c] = False
+            else:
+                return None
