+def _downscale_main_candidate(g: np.ndarray, color: int) -> tuple[np.ndarray, tuple[int, int, int, int], int] | None:
+    b = bbox(g == int(color))
+    if b is None:
+        return None
+
+    h = bbox_h(b)
+    w = bbox_w(b)
+    if h != w or h % 3 != 0:
+        return None
+
+    scale = h // 3
+    if scale < 2:
+        return None
+
+    patch = crop_bbox(g, b)
+    if np.any((patch != BACKGROUND) & (patch != int(color))):
+        return None
