        for bc in range(w // BLOCK_SIZE):
            k = (br + bc) % ROTATION_COUNT
            r0, c0 = BLOCK_SIZE * br, BLOCK_SIZE * bc
            grid[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE] = np.rot90(seed, k)

    if not np.array_equal(main(grid), seed):
        return None
    return grid

