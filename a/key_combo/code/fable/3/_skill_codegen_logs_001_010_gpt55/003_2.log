+    return [item for item in chosen if item is not None]
+
+
+def _render(
+    shape: tuple[int, int],
+    orient: str,
+    line: int,
+    spacing: int,
+    phase: int,
+    specs: list[FrameSpec],
+    placements: list[tuple[int, int, int, int]],
+    *,
+    final: bool,
+) -> np.ndarray:
