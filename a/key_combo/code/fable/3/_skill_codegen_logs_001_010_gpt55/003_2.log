+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        comp = [(sr, sc)]
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        while q:
+            r, c = q.popleft()
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    q.append((rr, cc))
+                    comp.append((rr, cc))
+        comps.append(comp)
+    return comps
