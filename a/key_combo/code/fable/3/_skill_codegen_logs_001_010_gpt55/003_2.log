+    out = np.full_like(g, BG)
+    for r, c in _track_points(g.shape, orient, line, spacing, phase):
+        out[r, c] = TRACK
+
+    occupied: set[tuple[int, int]] = set()
+    for color, cells in moved:
+        for r, c in cells:
+            assert (r, c) not in occupied, "shifted frames must not overlap"
+            occupied.add((r, c))
+            out[r, c] = int(color)
+    return out
