+
+def _valid_generation(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    orient: str,
+    line: int,
+    spacing: int,
+    phase: int,
+    specs: list[FrameSpec],
+) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2 or max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+    try:
+        got_orient, got_line, got_spacing, got_phase, visible = _track_info(inp)
+    except Exception:
