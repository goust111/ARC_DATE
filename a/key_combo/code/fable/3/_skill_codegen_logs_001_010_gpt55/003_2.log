+            cc = int(c + dc * spacing * rooms)
+            assert 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1], "shifted frame must remain in bounds"
+            shifted.append((rr, cc))
+        moved.append((int(color), shifted))
