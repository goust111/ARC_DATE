+
+
+def _count_closed_rooms(g: np.ndarray, color: int, box: tuple[int, int, int, int]) -> int:
+    h, w = g.shape
+    r0, c0, r1, c1 = box
+    er0, ec0 = max(0, r0 - 1), max(0, c0 - 1)
+    er1, ec1 = min(h - 1, r1 + 1), min(w - 1, c1 + 1)
