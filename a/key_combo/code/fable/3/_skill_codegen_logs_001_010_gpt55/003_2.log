+        bottom_gap = [(r1, c) for c in range(c0 + 1, c1) if int(g[r1, c]) != color]
+        if len(top_gap) == 1 and len(bottom_gap) == 0:
+            return -1, 0
+        if len(bottom_gap) == 1 and len(top_gap) == 0:
+            return 1, 0
