+        left_gap = [(r, c0) for r in range(r0 + 1, r1) if int(g[r, c0]) != color]
+        right_gap = [(r, c1) for r in range(r0 + 1, r1) if int(g[r, c1]) != color]
+        if len(left_gap) == 1 and len(right_gap) == 0:
+            return 0, -1
+        if len(right_gap) == 1 and len(left_gap) == 0:
+            return 0, 1
+    else:
