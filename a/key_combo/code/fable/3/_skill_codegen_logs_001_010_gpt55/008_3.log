+
+def _layout(rows: int, cols: int, rng: random.Random) -> tuple[int, int, int, int, int, int]:
+    lattice_h = rows * TEMPLATE_STRIDE - TEMPLATE_GAP
+    lattice_w = cols * TEMPLATE_STRIDE - TEMPLATE_GAP
+    gap = rng.randint(2, 4)
