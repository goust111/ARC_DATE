+            if not bool(present[i, j]):
+                continue
+            rr = lat_r + i * TEMPLATE_STRIDE
+            cc = lat_c + j * TEMPLATE_STRIDE
+            _paste_solid_template(grid, rr, cc, int(control[i, j]))
