+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+TEMPLATE_SIZE = 3
+TEMPLATE_GAP = 1
+TEMPLATE_STRIDE = TEMPLATE_SIZE + TEMPLATE_GAP
+UNKNOWN = -1
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def _neighbors4(r: int, c: int):
+    yield int(r) - 1, int(c)
+    yield int(r) + 1, int(c)
+    yield int(r), int(c) - 1
+    yield int(r), int(c) + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_h(box: BBox) -> int:
+    return int(box[2] - box[0] + 1)
+
+
+def _bbox_w(box: BBox) -> int:
+    return int(box[3] - box[1] + 1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for sr in range(h):
+        for sc in range(w):
+            if not bool(mask[sr, sc]) or bool(seen[sr, sc]):
+                continue
+            q: deque[Coord] = deque([(int(sr), int(sc))])
+            seen[sr, sc] = True
+            cells: list[Coord] = []
+            while q:
+                r, c = q.popleft()
+                cells.append((int(r), int(c)))
+                for nr, nc in _neighbors4(r, c):
+                    if not _in_bounds(mask.shape, nr, nc):
+                        continue
+                    if not bool(mask[nr, nc]) or bool(seen[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    q.append((int(nr), int(nc)))
+            out.append(np.array(cells, dtype=int))
+    return out
+
