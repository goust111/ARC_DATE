+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    rows, cols = rng.choice(GEN_DIMS)
+    bg = rng.choice(PALETTE)
+    occluder = rng.choice([c for c in PALETTE if c != bg])
+    usable = [c for c in PALETTE if c not in (bg, occluder)]
