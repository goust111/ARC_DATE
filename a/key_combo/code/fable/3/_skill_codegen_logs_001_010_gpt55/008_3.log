+    groups: dict[tuple[int, int], list[dict]] = {}
+    for comp in comps:
+        r0, c0, _r1, _c1 = comp["bbox"]
+        groups.setdefault((int(r0) % TEMPLATE_STRIDE, int(c0) % TEMPLATE_STRIDE), []).append(comp)
