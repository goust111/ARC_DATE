+    max_span = min(6, h - 4)
+    max_depth = min(5, w - 4)
+    if max_span < 2 or max_depth < 2:
+        raise ValueError("grid too small")
+    span = random.randint(2, max_span)
+    depth = random.randint(2, max_depth)
+    r0 = random.randint(2, h - span - 2)
