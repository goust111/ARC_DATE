+    wall_start = shadow_indices[0]
+    shadow_set = set(shadow_indices)
+    corners = _corner_indices(shape)
+    final_stack = {(wall_start - d) % n for d in range(1, count + 1)}
+    forbidden = shadow_set | final_stack
