+    out = g.copy()
+    for r, c in perim:
+        out[r, c] = bg
+
+    occupied = np.zeros(n, dtype=bool)
+    for idx in shadow_indices:
+        occupied[idx] = True
+        r, c = perim[idx]
+        out[r, c] = block_color
