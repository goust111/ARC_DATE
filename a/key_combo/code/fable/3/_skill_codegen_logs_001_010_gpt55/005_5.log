+    candidates = [
+        idx
+        for idx in range(n)
+        if idx not in forbidden
+        and _distance_to_wall(idx, wall_start, n) > count
+        and (idx - 1) % n not in shadow_set
+        and (idx + 1) % n not in shadow_set
