+    n = len(perim)
+    shadow = list(info["shadow_indices"])
+    wall_start = int(info["wall_start"])
+    corners = _corner_indices(inp.shape)
+
+    r0, c0, r1, c1 = info["block_bbox"]
+    if not np.array_equal(inp[r0 : r1 + 1, c0 : c1 + 1], out[r0 : r1 + 1, c0 : c1 + 1]):
