+    visited = {first}
+    prev = elbow
+    cur = first
+    while True:
+        nxts = []
+        for dr, dc in DIAGONALS:
+            nb = (cur[0] + dr, cur[1] + dc)
+            if nb == prev or nb in visited:
+                continue
+            if nb in path_cells:
+                nxts.append(nb)
+        if not nxts:
+            break
