+    assert visited == path_cells, "all non-arrow pixels must belong to the traced path"
+    er, ec = seq[-1]
+    h, w = g.shape
+    assert er in (0, h - 1) or ec in (0, w - 1), "path must terminate at a grid edge"
+    return seq
