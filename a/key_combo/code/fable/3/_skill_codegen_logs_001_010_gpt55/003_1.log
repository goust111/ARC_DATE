+def _sign_delta(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
+    dr = int(b[0] - a[0])
+    dc = int(b[1] - a[1])
+    assert abs(dr) == 1 and abs(dc) == 1, "path steps must be diagonal"
+    return dr, dc
