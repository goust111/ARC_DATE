+        path, turn_walls, turn_indices = plan
+        colors = random.sample(PALETTE, n_bounces + 1)
+        inp, expected = _render_from_plan((h, w), arrow, path, turn_walls, turn_indices, colors)
+        if _valid_generation(inp, expected, flips):
+            return inp
+    return None
+
