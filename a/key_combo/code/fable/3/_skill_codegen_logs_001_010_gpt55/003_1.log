+    shape: tuple[int, int],
+    cell: tuple[int, int],
+    previous: tuple[int, int],
+    path_set: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+) -> bool:
+    if not _in_bounds(shape, *cell):
+        return False
+    if cell in path_set or cell in blocked:
