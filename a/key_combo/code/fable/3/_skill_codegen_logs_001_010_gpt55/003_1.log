+    turn_indices: list[int],
+    colors: list[int],
+) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.zeros(shape, dtype=int)
+    out = np.zeros(shape, dtype=int)
+
+    for r, c in arrow:
+        inp[r, c] = colors[0]
+        out[r, c] = colors[0]
+
