+    g: np.ndarray,
+) -> tuple[int, set[tuple[int, int]], tuple[int, int], tuple[int, int]]:
+    h, w = g.shape
+    candidates = []
+    for r0 in range(h - 1):
+        for c0 in range(w - 1):
+            pts = []
+            for r in (r0, r0 + 1):
+                for c in (c0, c0 + 1):
+                    if int(g[r, c]) != BG:
+                        pts.append((r, c))
+            if len(pts) != 3:
+                continue
+            colors = {int(g[r, c]) for r, c in pts}
+            if len(colors) != 1:
+                continue
+            color = colors.pop()
+            comp = _same_color_component(g, pts[0], color)
+            if comp != set(pts):
+                continue
