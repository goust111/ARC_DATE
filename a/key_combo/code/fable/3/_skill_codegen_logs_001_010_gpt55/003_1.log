+            corners = {(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)}
+            missing = list(corners - set(pts))
+            if len(missing) != 1:
+                continue
+            mr, mc = missing[0]
+            dr = 1 if mr == r0 else -1
+            dc = 1 if mc == c0 else -1
+            elbow = (mr + dr, mc + dc)
+            if elbow not in set(pts):
