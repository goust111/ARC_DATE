+    seen = {start}
+    q: deque[tuple[int, int]] = deque([start])
+    while q:
+        r, c = q.popleft()
+        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in seen:
+                if int(g[rr, cc]) == int(color):
+                    seen.add((rr, cc))
+                    q.append((rr, cc))
