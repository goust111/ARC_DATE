+    candidates.sort(key=lambda item: (item[0], item[1], item[2]))
+
+    min_area = candidates[0][0]
+    best = [item for item in candidates if item[0] == min_area]
+    assert len(best) == 1, "ambiguous fundamental tile"
+    return best[0][3].copy()
+
