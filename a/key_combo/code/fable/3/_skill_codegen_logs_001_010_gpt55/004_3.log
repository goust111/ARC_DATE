+    return bg, mapping, query[0], query[1], panel_edges
+
+
+def _apply_mapping(patch: np.ndarray, mask: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    out = patch.copy()
+    for r, c in np.argwhere(mask):
+        r, c = int(r), int(c)
+        out[r, c] = _terminal(int(patch[r, c]), mapping)
