+def _render_grid(
+    panel_rows: int,
+    panel_cols: int,
+    panel_h: int,
+    panel_w: int,
+    panels: list[np.ndarray],
+    bg: int,
+) -> np.ndarray:
+    h = panel_rows * panel_h + panel_rows - 1
+    w = panel_cols * panel_w + panel_cols - 1
+    grid = np.full((h, w), int(bg), dtype=int)
