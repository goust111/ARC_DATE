+        pr = i // panel_cols
+        pc = i % panel_cols
+        r0 = pr * (panel_h + 1)
+        c0 = pc * (panel_w + 1)
+        grid[r0 : r0 + panel_h, c0 : c0 + panel_w] = panel
+    return grid
+
+
+def _direct_once(patch: np.ndarray, mask: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    out = patch.copy()
+    for r, c in np.argwhere(mask):
+        r, c = int(r), int(c)
+        out[r, c] = int(mapping.get(int(patch[r, c]), int(patch[r, c])))
+    return out
+
