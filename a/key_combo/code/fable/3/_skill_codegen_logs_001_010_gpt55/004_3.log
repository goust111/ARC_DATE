+    for i, panel in enumerate(panels):
+        pr = i // panel_cols
+        pc = i % panel_cols
+        r0 = pr * (panel_h + 1)
+        c0 = pc * (panel_w + 1)
+        grid[r0 : r0 + panel_h, c0 : c0 + panel_w] = panel
