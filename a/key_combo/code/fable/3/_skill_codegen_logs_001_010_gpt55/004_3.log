+    row_segments = _segments(h, row_seps)
+    col_segments = _segments(w, col_seps)
+    panels: list[np.ndarray] = []
+    for r0, r1 in row_segments:
+        for c0, c1 in col_segments:
+            panels.append(grid[r0 : r1 + 1, c0 : c1 + 1])
