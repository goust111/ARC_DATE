+def _gen_attempt() -> np.ndarray | None:
+    n_examples = random.choice([3, 5])
+    if n_examples == 3:
+        panel_rows, panel_cols = 2, 2
+        panel_h = random.randint(7, 10)
+        panel_w = random.randint(9, 13)
+    else:
