+
+    assert used_marker_colors == set(markers)
+    return out
+
+
+# --------------- generator ---------------
+
+MAX_ATTEMPTS = 500
+GAP = 1
+
+
+def _dilate(mask: np.ndarray, pad: int = 1) -> np.ndarray:
+    if pad <= 0:
+        return mask.copy()
+    h, w = mask.shape
+    out = mask.copy()
+    pts = np.argwhere(mask)
+    for r, c in pts:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                rr, cc = int(r) + dr, int(c) + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = True
