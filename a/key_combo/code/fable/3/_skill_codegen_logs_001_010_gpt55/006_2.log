+    return None
+
+
+def _make_sprite(bg: int, anchor_color: int, filler_color: int, side: str) -> tuple[np.ndarray, Coord]:
+    for _ in range(100):
+        h = random.randint(3, 5)
+        core_w = random.choice([3, 5])
