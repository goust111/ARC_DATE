    cc = random.randint(PLUS_CENTER_EDGE_MARGIN, w - PLUS_CENTER_EDGE_MARGIN - 1)

    g = np.full((h, w), Color.BLACK, dtype=int)
    for dr, dc in PLUS_OFFSETS:
