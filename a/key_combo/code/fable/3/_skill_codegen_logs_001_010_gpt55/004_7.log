+    if pts.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
