from __future__ import annotations

from collections import Counter
import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GRAY = 5
PINK = 6

DIRECTION_BY_COLOR: dict[int, tuple[int, int]] = {
    BLUE: (0, 1),    # right
    RED: (1, 0),     # down
    GREEN: (0, -1),  # left
    YELLOW: (-1, 0), # up
}
DIRECTION_COLORS = tuple(DIRECTION_BY_COLOR.keys())

MIN_INSTRUCTIONS = 6
MAX_INSTRUCTIONS = 9
MAX_GENERATION_ATTEMPTS = 500
PROGRAM_ATTEMPTS = 300


def _background(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])


def _find_separator_col(grid: np.ndarray, bg: int) -> int:
    h, w = grid.shape
    candidates: list[int] = []
    for c in range(w):
        col = grid[:, c]
        if bool(np.all(col == int(col[0]))) and int(col[0]) != int(bg):
