+
+def _layout_is_valid(grid: np.ndarray, bands: list[tuple[int, int]], bg: int) -> bool:
+    side = int(bands[0][1] - bands[0][0])
+    width = int(grid.shape[1])
+    if width < 2 * side:
+        return False
