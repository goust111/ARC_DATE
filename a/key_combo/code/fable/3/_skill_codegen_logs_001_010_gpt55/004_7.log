+TRANSFORM_NAMES = ("rot90", "rot180", "rot270", "flip_h", "flip_v")
+MAX_GENERATION_ATTEMPTS = 1000
+PLAN_CYCLE = ((2, 4), (2, 5), (3, 5), (3, 6))
+_GENERATE_CALLS = 0
