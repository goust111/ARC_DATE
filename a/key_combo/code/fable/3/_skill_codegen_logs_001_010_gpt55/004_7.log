+def _runs(rows: list[int]) -> list[tuple[int, int]]:
+    if not rows:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = prev = int(rows[0])
+    for r in rows[1:]:
+        r = int(r)
+        if r == prev + 1:
+            prev = r
+        else:
+            runs.append((start, prev + 1))
+            start = prev = r
+    runs.append((start, prev + 1))
+    return runs
+
