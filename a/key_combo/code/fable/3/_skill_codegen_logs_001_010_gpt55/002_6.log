        if any(prog[i]==prog[i+1] for i in range(L-1)): continue
        full=apply(p,prog)
        if np.array_equal(full, apply(p, tuple(reversed(prog)))): continue
        if any(np.array_equal(full, apply(p, prog[:i]+prog[i+1:])) for i in range(L)): continue
        # require adjacent noncommute swap sensitive for all pairs except H/V
        ok=True
        sens=False
        for i in range(L-1):
            sw=list(prog); sw[i],sw[i+1]=sw[i+1],sw[i]
            same=np.array_equal(full, apply(p, tuple(sw)))
            if same and set([prog[i],prog[i+1]]) "'!= {H,V}: ok=False
            if not same: sens=True
        if not ok or not sens: continue
        print(prog)
        n+=1
        if n>20: break
