import numpy as np
R,H,V=1,2,3
def apply(p,prog):
    out=p.copy()
    for c in prog:
        if c==R: out=np.rot90(out,-1)
        elif c==H: out=np.fliplr(out)
        else: out=np.flipud(out)
    return out.copy()
