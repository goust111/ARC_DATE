+    (ROTATE_CW, MIRROR_LEFT_RIGHT),
+    (MIRROR_UP_DOWN, ROTATE_CW),
+    (MIRROR_LEFT_RIGHT, ROTATE_CW, MIRROR_UP_DOWN),
+    (ROTATE_CW, MIRROR_UP_DOWN, MIRROR_LEFT_RIGHT),
