+                kind = "L" if abs(direction[0]) + abs(direction[1]) == 2 else "V"
+                out.append(
+                    {
+                        "front": (r, c),
+                        "direction": direction,
+                        "cells": tuple(sorted(cells)),
+                        "cell_set": frozenset(cells),
