            # otherwise: Create a corrupted version of the pattern; randomly set some pixels to black
            corrupted_sprite = template_sprite.copy()
            for r, c in np.argwhere(corrupted_sprite != Color.BLACK):
                if random.choice([0, 1]) == 0:
