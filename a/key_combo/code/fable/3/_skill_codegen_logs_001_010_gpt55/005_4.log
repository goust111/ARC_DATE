+    h, w = shape
+    out = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            for direction in ALL_EMIT_DIRS:
+                cells = _triangle_cells((r, c), direction)
+                if not all(1 <= rr < h - 1 and 1 <= cc < w - 1 for rr, cc in cells):
