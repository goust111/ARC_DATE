+def _trace(
+    grid: np.ndarray,
+    out: np.ndarray,
+    start: Coord,
+    direction: Coord,
+    fuse_color: int,
+    bg: int,
+    cell_to_triangle: dict[Coord, int],
+) -> tuple[int | None, list[Coord]]:
+    h, w = grid.shape
+    r, c = start
+    painted: list[Coord] = []
+    while 0 <= r < h and 0 <= c < w:
+        pos = (r, c)
+        tri_id = cell_to_triangle.get(pos)
+        if tri_id is not None:
+            return tri_id, painted
+        if int(grid[r, c]) != bg:
+            return None, painted
+        out[r, c] = fuse_color
+        painted.append(pos)
+        r += direction[0]
+        c += direction[1]
+    return None, painted
+
+
+def _solve(grid: np.ndarray, *, collect_meta: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _background(g)
+    marker, fuse_color, fuse_dir = _edge_marker(g, bg)
+    triangles = _find_triangles(g, bg, marker)
