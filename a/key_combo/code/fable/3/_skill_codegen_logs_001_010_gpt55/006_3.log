+
+    choices = [
+        n
+        for n in range(PATH_LEN_RANGE[0], PATH_LEN_RANGE[1] + 1)
+        if (s0 * (n - 1)) % (s0 + s1) != 0
+    ]
+    return s0, s1, rng.choice(choices)
+
+
+def _make_local_record(profile: str, rng: random.Random) -> dict[str, object] | None:
+    s0, s1, n = _choose_profile(profile, rng)
