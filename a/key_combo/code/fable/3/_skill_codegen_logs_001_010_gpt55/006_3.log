+        n = rng.choice([5, 7, 9, 11, 13])
+        return speed, speed, n
+
+    pairs = [(1, 2), (2, 1), (1, 3), (3, 1), (2, 3), (3, 2)]
+    s0, s1 = rng.choice(pairs)
+
