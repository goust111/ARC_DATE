_GEN_CANVAS_H_RANGE, _GEN_CANVAS_W_RANGE = (10, 17), (15, 17)
_GEN_RECT_H_RANGE, _GEN_RECT_W_RANGE, _GEN_PLACEMENT_BORDER = (4, 7), (5, 8), 1

