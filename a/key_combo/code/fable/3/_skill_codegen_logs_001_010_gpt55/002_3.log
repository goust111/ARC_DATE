+        len(records) >= 3
+        and axes == {0, 1}
+        and len(set(counts)) >= 2
+        and any(gap == count for gap, count in zip(gaps, counts))
+        and any(gap > count for gap, count in zip(gaps, counts))
+        and any(area != count for area, count in zip(slider_areas, counts))
+    )
