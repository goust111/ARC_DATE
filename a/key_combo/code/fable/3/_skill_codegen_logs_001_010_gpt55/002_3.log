+
+# --------------- generator ---------------
+
+GEN_RETRY_LIMIT = 500
+GEN_GRID_RANGE = (22, 30)
+GEN_PAIR_RANGE = (3, 4)
+GEN_COUNTER_AREA_RANGE = (1, 4)
+GEN_EXTRA_GAP_RANGE = (0, 2)
+GEN_PLACE_RETRY = 250
