+        else:
+            count_hi = min(GEN_COUNTER_AREA_RANGE[1], max_gap)
+            count = random.randint(GEN_COUNTER_AREA_RANGE[0], count_hi)
+            extra_hi = min(GEN_EXTRA_GAP_RANGE[1], max_gap - count)
