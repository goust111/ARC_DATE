+    w = int(local[:, 1].max()) + 1
+
+    if direction == "left":
+        top = ar0 if h == 2 else random.choice([ar0, ar1])
+        left = ac0 - int(gap) - w
+    elif direction == "right":
+        top = ar0 if h == 2 else random.choice([ar0, ar1])
+        left = ac1 + int(gap) + 1
+    elif direction == "up":
+        top = ar0 - int(gap) - h
+        left = ac0 if w == 2 else random.choice([ac0, ac1])
+    else:
