def _gen_pick_lengths(red_caps, ribbon_caps):
    red_lengths = [random.randint(1, cap) for cap in red_caps]
    ribbon_steps = [random.randint(1, cap) for cap in ribbon_caps]
    for _ in range(LENGTH_ADJUST_RETRIES):
