+                "color": int(color),
+                "slider": slider,
+                "counter": counter,
+                "count": int(count),
+                "gap": int(gap),
+                "dr": int(dr),
+                "dc": int(dc),
+                "axis": int(axis),
+            }
+        )
+
+    if not _semantic_checks(records):
+        return None
+
+    try:
+        expected = _expected_from_records(grid, records)
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
