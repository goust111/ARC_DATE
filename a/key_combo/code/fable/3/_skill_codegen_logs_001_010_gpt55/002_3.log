+    colors_present,
+    components_mask,
+    get_bg,
+)
+
+
+BG = int(Color.BLACK)
+ANCHOR = int(Color.GREY)
+MOVING_COLORS = [
+    int(Color.BLUE),
+    int(Color.RED),
+    int(Color.GREEN),
+    int(Color.YELLOW),
+    int(Color.PINK),
+    int(Color.ORANGE),
+    int(Color.TEAL),
+    int(Color.MAROON),
