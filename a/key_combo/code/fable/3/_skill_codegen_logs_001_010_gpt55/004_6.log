+    area_max = min(th * tw - 3, max(area_min, int(round(th * tw * 0.68))))
+    if area_min > area_max:
+        return None
+
+    for _ in range(150):
+        area = random.randint(area_min, area_max)
+        mask = np.zeros((th, tw), dtype=bool)
+        mask[0, 0] = True
+        cells = {(0, 0)}
+
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
