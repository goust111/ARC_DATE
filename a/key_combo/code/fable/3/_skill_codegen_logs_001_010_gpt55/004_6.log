            frontier = []
            for r, c in cells:
                for nr, nc in _neighbors(r, c, 4):
                    if 0 <= nr < th and 0 <= nc < tw and (nr, nc) not in cells:
                        frontier.append((nr, nc))
            if not frontier:
                break
            cells.add(random.choice(frontier))

        for r, c in cells:
            mask[r, c] = True

