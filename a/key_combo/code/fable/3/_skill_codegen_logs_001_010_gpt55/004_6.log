+def _neighbors(r: int, c: int, connectivity: int = 4):
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+    else:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr or dc:
+                    yield r + dr, c + dc
