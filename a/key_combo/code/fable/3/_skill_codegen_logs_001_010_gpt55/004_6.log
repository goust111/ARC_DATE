+    if len(rel) != count:
+        return None
+    return rel
+
+
+def _absolute_anchors(rel: list[tuple[int, int]], template_shape: tuple[int, int]) -> tuple[int, int, list[tuple[int, int]]] | None:
+    th, tw = template_shape
