+    for ar, ac in anchors:
+        for tr, tc in coords:
+            grid[int(ar) + int(tr), int(ac) + int(tc)] = BLUE
+    for ar, ac in anchors:
+        grid[int(ar), int(ac)] = RED
+    return grid
