+    if require_background_anchor:
+        background_offsets = [
+            (r, c)
+            for r in range(min(th, row_radius + 1))
+            for c in range(min(tw, col_radius + 1))
+            if (r, c) != (0, 0) and not bool(template[r, c])
+        ]
