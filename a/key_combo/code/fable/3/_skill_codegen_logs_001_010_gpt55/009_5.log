+                "direction": direction,
+                "end": nxt,
+                "distance": int(distance),
+                "blocker": blocker,
+            }
+        )
+        pos = nxt
+    return pos, steps
+
+
+def _run_one_step(
+    start: Coord,
+    program: list[Coord],
+    field_h: int,
+    field_w: int,
+    obstacles: set[Coord],
+) -> Coord:
+    r, c = map(int, start)
+    for dr, dc in program:
