+BG = 0
+GRAY = 5
+
+TOP = (-1, 0)
+BOTTOM = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRECTIONS = [TOP, BOTTOM, LEFT, RIGHT]
+SIDE_NAMES = ("top", "bottom", "left", "right")
