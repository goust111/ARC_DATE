+    col_lines = [c for c in range(mask.shape[1]) if bool(mask[:, c].all())]
+    if len(row_lines) < 3 or len(col_lines) < 3:
+        return None
+    if row_lines[0] != 0 or row_lines[-1] != mask.shape[0] - 1:
+        return None
+    if col_lines[0] != 0 or col_lines[-1] != mask.shape[1] - 1:
+        return None
