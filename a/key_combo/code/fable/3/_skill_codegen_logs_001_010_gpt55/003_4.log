            assert int(g[prev]) != int(g[nxt]), "a turn must switch to a new visible color"
            out[wr, wc] = int(g[nxt])
        prev = cur

    return out


def _arrow_cells(
    elbow: tuple[int, int], direction: tuple[int, int]
) -> set[tuple[int, int]]:
    r, c = elbow
