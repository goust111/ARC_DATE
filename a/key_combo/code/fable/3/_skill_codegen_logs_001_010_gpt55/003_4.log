+        if len(seen_frames) != n_frames:
+            continue
+        ok = True
+        for frame_idx, sr, sc in positions:
+            h, w = slot_mats[frame_idx].shape
+            if not (sr in (0, h - 1) and sc in (0, w - 1)):
