def _gen_choose_counts(
    boxes: list[tuple[int, int, int, int]],
) -> tuple[tuple[int, ...], int] | None:
    options = []
    for box in boxes:
        bounds = _gen_count_bounds(box)
        if bounds is None:
            return None
