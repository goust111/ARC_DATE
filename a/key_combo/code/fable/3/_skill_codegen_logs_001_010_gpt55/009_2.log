+def _semantic_accepts(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    bg: int,
+    sep: int,
+    dr: int,
+    dc: int,
+) -> bool:
+    h = (grid.shape[0] - 1) // 2
+    top = grid[:h]
+    bottom = grid[h + 1 :]
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
+    if np.any(grid == CYAN):
+        return False
+    if int(np.count_nonzero(grid == sep)) != grid.shape[1]:
+        return False
