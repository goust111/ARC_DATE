+        and int(np.count_nonzero(same)) >= 2
+        and int(np.count_nonzero(only_top)) >= 2
+        and int(np.count_nonzero(only_bottom)) >= 2
+        and clipped >= 2
+        and int(np.count_nonzero(expected == CYAN)) >= 2
+    )
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
