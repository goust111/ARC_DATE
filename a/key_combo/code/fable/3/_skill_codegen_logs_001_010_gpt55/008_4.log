def _marker_column(g: np.ndarray) -> int:
    h, w = g.shape
    candidates = []
    for c in range(w):
        if all(np.unique(np.delete(g[r], c)).size == 1 for r in range(h)):
            candidates.append(c)
    assert len(candidates) == 1, "expected one marker column"
    return int(candidates[0])


