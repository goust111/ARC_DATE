+
+
+def _segment_cells(
+    start: tuple[int, int],
+    end: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[tuple[int, int]]:
+    sr, sc = map(int, start)
+    er, ec = map(int, end)
+    dr, dc = map(int, direction)
+    if dr == 0:
+        assert sr == er
+        steps = (ec - sc) * dc
+    else:
+        assert sc == ec
+        steps = (er - sr) * dr
+    assert steps >= 1
+    return [(sr + i * dr, sc + i * dc) for i in range(1, int(steps) + 1)]
+
+
+def _can_add_control(
+    grid: np.ndarray,
+    cell: tuple[int, int],
+    forbidden: set[tuple[int, int]],
