+def _is_internal(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 < int(r) < h - 1 and 0 < int(c) < w - 1
+
+
+def _edge_direction(shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:
