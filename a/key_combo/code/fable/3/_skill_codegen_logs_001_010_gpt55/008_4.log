+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT_TURN = {
+    UP: RIGHT,
+    RIGHT: DOWN,
+    DOWN: LEFT,
+    LEFT: UP,
