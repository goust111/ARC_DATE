+        if len(owners) != 1:
+            continue
+
+        owner = owners[0]
+        seed_row, seed_length = segments[owner]
+        dist = abs(r - seed_row)
+        if r < seed_row:
+            fill_width = seed_length + dist
+            assert fill_width <= width, "green wedge must fit inside the grid"
+            out[r, :fill_width] = GREEN
+        else:
+            fill_width = seed_length - dist
+            if fill_width > 0:
+                out[r, :fill_width] = BLUE
+
+    return out
