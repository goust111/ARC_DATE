+    width = rng.randint(width_min, 30)
+
+    lengths = _choose_lengths(rng, width, rows, max_green_extra, bottom_margin)
+    if lengths is None:
+        return None
+
+    segments = list(zip(rows, lengths))
+    inp = np.full((height, width), BLACK, dtype=int)
+    for row, length in segments:
