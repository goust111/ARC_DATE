+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        comp = [(sr, sc)]
+        q: deque[tuple[int, int]] = deque([(sr, sc)])
+        while q:
+            r, c = q.popleft()
