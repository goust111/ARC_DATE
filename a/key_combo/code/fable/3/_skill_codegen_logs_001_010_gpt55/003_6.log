+    origins = [(r, c) for r in range(rows - h + 1) for c in range(cols - w + 1)]
+    random.shuffle(origins)
+    for r0, c0 in origins:
+        if not _can_place(occupied, r0, c0, h, w, padding=1):
+            continue
