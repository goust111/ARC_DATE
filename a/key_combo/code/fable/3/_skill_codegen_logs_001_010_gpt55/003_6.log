+    out: np.ndarray,
+    color: int,
+    box: tuple[int, int, int, int],
+    orient: str,
+    long_len: int,
+    period: int,
+) -> None:
+    r0, c0, r1, c1 = box
+    out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+    if period <= 0:
+        return
+
+    if orient == "h":
+        mid_r = r0 + 1
+        for pos in range(1, long_len, int(period)):
+            out[mid_r, c0 + pos] = BG
+    else:
+        mid_c = c0 + 1
+        for pos in range(1, long_len, int(period)):
+            out[r0 + pos, mid_c] = BG
+
