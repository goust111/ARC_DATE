+        occupied[r0 : r0 + h, c0 : c0 + w] = True
+        return int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)
+    return None
+
+
+def _place_dot(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    color: int,
+) -> tuple[int, int] | None:
+    rows, cols = grid.shape
+    cells = [(r, c) for r in range(rows) for c in range(cols)]
+    random.shuffle(cells)
+    for r, c in cells:
+        if not _can_place(occupied, r, c, 1, 1, padding=1):
+            continue
+        grid[r, c] = int(color)
+        occupied[r, c] = True
+        return int(r), int(c)
+    return None
+
+
+def _hole_positions(long_len: int, period: int) -> set[int]:
+    if period <= 0:
+        return set()
+    return {int(pos) for pos in range(1, int(long_len), int(period))}
+
+
+def _expected_from_specs(
+    shape: tuple[int, int],
+    specs: list[dict[str, object]],
+) -> np.ndarray:
