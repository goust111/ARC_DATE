+        return None
+    hole_h = int(rng.integers(2, min(6, height) + 1))
+    hole_w = int(rng.integers(2, min(6, side_width) + 1))
+    r0 = int(rng.integers(0, height - hole_h + 1))
+
+    place_left = bool(rng.integers(2))
+    if place_left:
+        c0 = int(rng.integers(0, side_width - hole_w + 1))
+    else:
