+            color = _weighted_left_color(rng, palette, pair, int(row_biases[r]), int(col_biases[c]))
+            g[r, c] = color
+            g[r, width - 1 - c] = _swap_color_value(color, pair)
+
+    if width % 2:
+        g[:, width // 2] = rng.choice(np.array(fixed_colors, dtype=int), size=height, replace=True)
+    return g
