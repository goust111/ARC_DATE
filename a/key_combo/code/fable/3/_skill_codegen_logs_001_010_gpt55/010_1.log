+    _cb, br0, bc0, br1, bc1 = b
+    r0 = max(ar0, br0)
+    c0 = max(ac0, bc0)
+    r1 = min(ar1, br1)
+    c1 = min(ac1, bc1)
+    if r0 <= r1 and c0 <= c1:
+        return int(r0), int(c0), int(r1), int(c1)
