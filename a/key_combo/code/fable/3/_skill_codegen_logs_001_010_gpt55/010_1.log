+        rh = r1 - r0 + 1
+        rw = c1 - c0 + 1
+        area = rh * rw
+        if rh < 3 or rw < 3:
+            continue
+        if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+            continue
