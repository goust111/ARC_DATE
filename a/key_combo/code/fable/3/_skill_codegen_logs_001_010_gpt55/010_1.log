+        right = [(r, c1) for r in range(r0, r1 + 1)]
+        if not (
+            _side_has_uncovered_cell(top, higher)
+            and _side_has_uncovered_cell(bottom, higher)
+            and _side_has_uncovered_cell(left, higher)
