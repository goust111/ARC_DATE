+GEN_ATTEMPTS = 800
+LAYOUT_ATTEMPTS = 300
+GRID_SIZE_RANGE = (18, 27)
+RECT_COUNT_CHOICES = (4, 5)
+PERIOD_CHOICES = (3, 4)
