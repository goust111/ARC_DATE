+
+def _rectangles_from_visible_edges(g: np.ndarray) -> list[Rect]:
+    h, w = g.shape
+    grid_area = h * w
+    rects: list[Rect] = []
+
+    for raw_color in np.unique(g):
+        color = int(raw_color)
+        coords = np.argwhere(g == color)
+        if coords.shape[0] < 6:
+            continue
