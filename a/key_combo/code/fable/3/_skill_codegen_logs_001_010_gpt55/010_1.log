+        _color, rr0, cc0, rr1, cc1 = rect
+        if rr0 < 1 or cc0 < 1 or rr1 >= rows - 1 or cc1 >= cols - 1:
+            continue
+        inter = _overlap(rect, target)
+        if inter is None:
+            continue
+        ir0, ic0, ir1, ic1 = inter
+        inter_area = (ir1 - ir0 + 1) * (ic1 - ic0 + 1)
+        area = _rect_area(rect)
+        target_area = _rect_area(target)
+        if inter_area >= area or inter_area >= target_area:
+            continue
+        if inter_area > int(0.80 * area):
+            continue
+        return rect
+    return None
+
+
+def _gen_rectangles(shape: tuple[int, int], colors: list[int]) -> list[Rect] | None:
+    rows, cols = shape
+    n = len(colors)
+
+    for _ in range(LAYOUT_ATTEMPTS):
+        bottom = _sample_bottom_rect(rows, cols, colors[0])
+        if bottom is None:
+            continue
+        rects = [bottom]
+
+        for idx in range(1, n):
+            placed = None
+            for _try in range(100):
+                if idx == 1:
+                    rh = random.randint(4, 6)
+                    rw = random.randint(4, 7)
+                    target_index = 0
+                    prefer_large = False
+                elif idx == 2:
+                    rh = random.randint(6, 9)
+                    rw = random.randint(6, 9)
+                    target_index = 1
+                    prefer_large = True
+                else:
+                    rh = random.randint(4, 8)
+                    rw = random.randint(4, 8)
+                    target_index = random.randrange(idx)
+                    prefer_large = random.random() < 0.25
+
+                rect = _sample_overlapping_rect(
+                    shape,
+                    colors[idx],
+                    rects[target_index],
+                    rh,
+                    rw,
+                    prefer_large_overlap=prefer_large,
