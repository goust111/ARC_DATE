+    _color, r0, c0, r1, c1 = bottom
+    bottom_mask = np.zeros(shape, dtype=bool)
+    bottom_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    exclusive = bottom_mask & (cover == 1)
+    if int(np.count_nonzero(exclusive)) < 8:
