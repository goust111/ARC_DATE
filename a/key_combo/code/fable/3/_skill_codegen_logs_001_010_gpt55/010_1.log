+        cols = coords[:, 1]
+        touches_top = bool(np.any(rows == r0))
+        touches_bottom = bool(np.any(rows == r1))
+        touches_left = bool(np.any(cols == c0))
+        touches_right = bool(np.any(cols == c1))
