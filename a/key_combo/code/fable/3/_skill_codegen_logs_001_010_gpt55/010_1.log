+
+def _gen_tile(period: int, colors: list[int]) -> np.ndarray:
+    row_step = random.choice([x for x in range(1, period) if np.gcd(x, period) == 1])
+    col_step = random.choice([x for x in range(1, period) if np.gcd(x, period) == 1])
