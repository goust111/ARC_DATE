+def _sample_overlapping_rect(
+    shape: tuple[int, int],
+    color: int,
+    target: Rect,
+    height: int,
+    width: int,
+    *,
+    prefer_large_overlap: bool = False,
+) -> Rect | None:
+    rows, cols = shape
+    _tc, tr0, tc0, tr1, tc1 = target
+    th = tr1 - tr0 + 1
+    tw = tc1 - tc0 + 1
+
