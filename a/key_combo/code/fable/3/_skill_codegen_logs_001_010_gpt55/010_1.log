+def _render(base: np.ndarray, rects_bottom_to_top: list[Rect]) -> np.ndarray:
+    out = base.copy()
+    for color, r0, c0, r1, c1 in rects_bottom_to_top:
+        out[r0 : r1 + 1, c0 : c1 + 1] = color
+    return out
