# Canvas and shape bounds (upper bounds are exclusive where passed to randint).
GRID_H_RANGE, GRID_W_RANGE = (12, 16), (13, 16)
FRAME_H_RANGE, FRAME_W_RANGE = (9, 12), (8, 11)
OBJECT_SIZE_RANGE = (3, 5)
