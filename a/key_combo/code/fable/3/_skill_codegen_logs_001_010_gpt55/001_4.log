+MAX_LOST_PIXELS = 8
+GENERATION_ATTEMPTS = 600
+PLACEMENT_ATTEMPTS = 80
+ORTHOGONAL_STEPS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _paint_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = map(int, start)
+    tr, tc = map(int, end)
+    mask[r, c] = True
+    axes = [0, 1]
+    random.shuffle(axes)
+    for axis in axes:
+        if axis == 0:
+            while r != tr:
+                r += 1 if tr > r else -1
+                mask[r, c] = True
+        else:
