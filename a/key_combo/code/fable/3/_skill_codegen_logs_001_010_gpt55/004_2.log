+
+        forced_colors = random.sample(palette, min(3, len(palette), len(colored)))
+        forced_cells = random.sample(colored, len(forced_colors))
+        for (r, c), color in zip(forced_cells, forced_colors):
+            arr[r, c] = int(color)
+
+        if len(set(map(int, arr[arr != int(bg)]))) < 2:
