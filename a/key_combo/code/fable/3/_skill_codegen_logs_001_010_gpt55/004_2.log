        r0, c0, r1, c1 = map(int, target["bbox"])
        patch = out[r0 : r1 + 1, c0 : c1 + 1]
        assert patch.shape == sprite_mask.shape, "target bbox must match source sprite bbox"
        patch[sprite_mask] = sprite[sprite_mask]

    return out

