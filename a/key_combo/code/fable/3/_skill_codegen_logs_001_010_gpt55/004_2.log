+    out = np.asarray(grid, dtype=int).copy()
+    k = int(geom["k"])
+    top = int(geom["top"])
+    left = int(geom["left"])
+    gap_r = int(geom["gap_r"])
+    gap_c = int(geom["gap_c"])
