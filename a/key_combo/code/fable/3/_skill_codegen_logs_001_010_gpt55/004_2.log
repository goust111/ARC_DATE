                    lo = max(1, remaining - left * cols)
                    hi = min(cols, remaining - left)
                    for width in range(lo, hi + 1):
                        rec(prefix + [width], remaining - width, r + 1)
                rec([], count, 0)
    return shapes


# Valid (block_size, gap) pairs satisfying STEP_MIN <= block_size+gap <= STEP_MAX
