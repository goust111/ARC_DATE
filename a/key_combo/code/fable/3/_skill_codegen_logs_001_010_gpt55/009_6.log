+    start = next(iter(coords))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nb in _neighbors4(r, c):
+            if nb in coords and nb not in seen:
+                seen.add(nb)
+                stack.append(nb)
