+        return None
+    if liquid_counts[2] - liquid_counts[1] == liquid_counts[0]:
+        return None
+    if counts[_PANEL_COUNT + 1] <= 0:
+        return None
+    if any(np.array_equal(expected, panel) for panel in panels):
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return inp
