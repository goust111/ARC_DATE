+    grid: np.ndarray,
+    pair: tuple[tuple[int, int, int, int], tuple[int, int, int, int]],
+) -> np.ndarray:
+    left, right = pair
+    assert left[0] == right[0] and left[2] == right[2]
+    stripe = grid[left[0] : left[2] + 1, left[3] + 1 : right[1]].copy()
+    assert stripe.shape[0] == MARKER_SIZE and stripe.shape[1] > 0
+    return stripe
