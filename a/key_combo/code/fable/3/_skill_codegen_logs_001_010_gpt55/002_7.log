+
+
+def _choose_shape(mode: int, rng: np.random.Generator) -> tuple[int, int]:
+    if mode in (1, 2):
+        return int(rng.integers(23, 31)), int(rng.integers(23, 31))
+    if mode == 0:
+        return int(rng.integers(17, 29)), int(rng.integers(18, 31))
