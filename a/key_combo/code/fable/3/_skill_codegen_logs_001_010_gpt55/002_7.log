+def _legend_origin(shape: tuple[int, int], corner: int, k: int) -> tuple[int, int]:
+    H, W = map(int, shape)
+    width = int(k) + 2
+    if corner == 0:
+        return 0, 0
+    if corner == 1:
+        return 0, W - width
+    if corner == 2:
+        return H - 3, 0
+    return H - 3, W - width
