+            if not (0 <= ar < H and 0 <= ac < W and 0 <= br < H and 0 <= bc < W):
+                continue
+            la = int(labels[ar, ac])
+            lb = int(labels[br, bc])
+            if la > 0 and lb > 0 and la != lb:
+                edges.add(tuple(sorted((la, lb))))
+
+    graph = {region: set() for region in range(1, n_regions + 1)}
+    for a, b in edges:
+        graph[a].add(b)
+        graph[b].add(a)
+    return labels, n_regions, graph, edges
