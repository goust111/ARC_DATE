+def _build_region_graph(
+    g: np.ndarray, wall: int, palette_mask: np.ndarray
+) -> tuple[np.ndarray, int, dict[int, set[int]], set[tuple[int, int]]]:
+    passable = (g != int(wall)) & ~palette_mask
+    labels, n_regions = _label_components(passable)
