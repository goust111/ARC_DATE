+
+
+def _place_seed(
+    grid: np.ndarray,
+    rels: np.ndarray,
+    existing_positions: list[tuple[int, int]],
+    row_range: tuple[int, int],
+    col_range: tuple[int, int],
+    used_bottoms: set[int],
