+        return None
+
+    virtual_occupied: set[tuple[int, int]] = set()
+    for pos in existing_positions:
+        virtual_occupied |= _cells_key(_copy_cells(pos, rels))
+
+    for _ in range(300):
+        r = random.randint(rmin, rmax)
+        c = random.randint(cmin, cmax)
+        cells = _copy_cells((r, c), rels)
