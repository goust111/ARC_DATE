+            np.all((0 <= lower_cells[:, 0]) & (lower_cells[:, 0] < h - 1))
+            and np.all((0 <= upper_cells[:, 0]) & (upper_cells[:, 0] < h - 1))
+            and np.all((0 <= lower_cells[:, 1]) & (lower_cells[:, 1] < w))
+            and np.all((0 <= upper_cells[:, 1]) & (upper_cells[:, 1] < w))
