+    grid = np.full((h, left_w + 1 + right_w), BLACK, dtype=int)
+    grid[:, left_w] = PINK
+    sr, sc = map(int, start)
+    grid[sr, left_w + 1 + sc] = GRAY
+
+    for row, (color, length) in zip(rows, program):
+        c0 = random.randint(0, left_w - int(length) - 2)
+        c1 = c0 + int(length) + 1
