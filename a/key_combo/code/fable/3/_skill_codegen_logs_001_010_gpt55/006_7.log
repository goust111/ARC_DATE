+
+def _inside_bbox(p: Coord, bbox: BBox) -> bool:
+    r, c = p
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _nested_bbox_cells(frames: list[dict[str, object]], owner_idx: int, p: Coord) -> bool:
