+def _fill_frame_interior(out: np.ndarray, frames: list[dict[str, object]], idx: int, bg: int) -> None:
+    frame = frames[idx]
+    color = int(frame["color"])
+    r0, c0, r1, c1 = frame["bbox"]  # type: ignore[misc]
+    for r in range(int(r0) + 1, int(r1)):
