+def _build_top_chain(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(27, 30)
+    w = rng.randint(27, 30)
+    bg = rng.choice([0, 5, 7])
+    grid = np.full((h, w), bg, dtype=int)
