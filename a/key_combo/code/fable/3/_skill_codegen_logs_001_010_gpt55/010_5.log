+def _translation_class(coord: Coord, shape: tuple[int, int], vec: Coord) -> set[Coord]:
+    h, w = shape
+    dr, dc = vec
+    out: set[Coord] = set()
+    for k in range(-max(h, w), max(h, w) + 1):
+        r = coord[0] + k * dr
+        c = coord[1] + k * dc
+        if 0 <= r < h and 0 <= c < w:
+            out.add((r, c))
+    return out
