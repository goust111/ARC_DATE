+        for dc in range(-(w - 1), w):
+            if dr == 0 and dc == 0:
+                continue
+            r0, r1, c0, c1 = _overlap_slices(grid.shape, dr, dc)
+            if r0 >= r1 or c0 >= c1:
+                continue
+            a = grid[r0:r1, c0:c1]
+            b = grid[r0 + dr : r1 + dr, c0 + dc : c1 + dc]
+            visible = (a != missing) & (b != missing)
+            support = int(np.count_nonzero(visible))
+            if support == 0:
+                continue
+            if not bool(np.all(a[visible] == b[visible])):
