+    return np.concatenate([first, second], axis=0).astype(int)
+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    tile: np.ndarray,
+    cmap: dict[int, int],
+    axis: str,
+    mask1: np.ndarray,
+    mask2: np.ndarray,
