+
+
+def _can_place(occupied: np.ndarray, sprite: np.ndarray, bg: int, top: int, left: int, padding: int) -> bool:
+    h, w = sprite.shape
+    H, W = occupied.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
