+    rect_left = random.randint(1, W - rect_w - 1)
+    grid[rect_top : rect_top + rect_h, rect_left : rect_left + rect_w] = rect
+    occupied[rect_top : rect_top + rect_h, rect_left : rect_left + rect_w] = True
