+
+def _draw_path(
+    shape: tuple[int, int],
+    bg: int,
+    order: list[tuple[int, int]],
+    directions: list[tuple[int, int]],
+    colors: list[int],
+) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    turret_index = {pos: idx for idx, pos in enumerate(order)}
+    cur_idx = 0
+    pos = order[0]
+
+    while True:
+        out[pos] = colors[cur_idx]
+        dr, dc = directions[cur_idx]
