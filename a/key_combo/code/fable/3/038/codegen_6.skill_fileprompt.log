+def _gen_attempt() -> np.ndarray | None:
+    turret_count = random.randint(*TURRET_COUNT_RANGE)
+    min_side = max(GRID_MIN, 2 * turret_count + 8)
+    h = random.randint(min_side, GRID_MAX)
+    w = random.randint(min_side, GRID_MAX)
