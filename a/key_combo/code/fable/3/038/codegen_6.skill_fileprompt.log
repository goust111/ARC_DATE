+
+GRID_MIN = 14
+GRID_MAX = 28
+TURRET_COUNT_RANGE = (2, 6)
+GEN_ATTEMPTS = 400
+PATH_BUILD_ATTEMPTS = 120
+
+
+def _get_bg(grid: np.ndarray) -> int:
