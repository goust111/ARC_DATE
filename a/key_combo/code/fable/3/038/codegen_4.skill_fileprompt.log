# Canvas, palette, and retry bounds.
BG_COLOR = 0
GRID_HEIGHT_RANGE, GRID_WIDTH_RANGE = (21, 22), (16, 20)
COLOR_COUNT_RANGE, COLOR_POOL = (4, 5), range(1, 10)
GENERATOR_MAX_ATTEMPTS = 300
# Shared mask density limits.
