+        return None
+    _r0a, c0a, _r1a, c1a = a["bbox"]
+    _r0b, c0b, _r1b, c1b = b["bbox"]
+    axis2 = c0a + c1b
+    if axis2 != c1a + c0b or axis2 % 2:
+        return None
+    reflected = {(r, axis2 - c) for r, c in a["coord_set"]}
+    if reflected != b["coord_set"]:
+        return None
+    return axis2 // 2
