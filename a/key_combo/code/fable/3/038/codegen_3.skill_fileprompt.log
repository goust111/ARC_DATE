+def _sample_asymmetric_mask(used: set[tuple[tuple[int, int], bytes]]) -> np.ndarray | None:
+    for _ in range(300):
+        mask = _random_connected_mask()
+        orbit = _shape_orbit(mask)
+        if not _is_asymmetric(mask) or orbit & used:
