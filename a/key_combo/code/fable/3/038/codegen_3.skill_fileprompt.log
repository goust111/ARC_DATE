+def _sample_vertical_self_mask(used: set[tuple[tuple[int, int], bytes]]) -> np.ndarray | None:
+    for _ in range(300):
+        base = _random_connected_mask(min_h=3, max_h=6, min_w=2, max_w=4, min_cells=3, max_cells=7)
