+    if reflected != comp["coord_set"]:
+        return None
+    return axis2 // 2
+
+
+def _solve_components(components: list[dict]) -> list[dict]:
+    n = len(components)
+    assert n % 2 == 1 and n > 0
+
+    adjacency: dict[int, list[dict]] = {i: [] for i in range(n)}
