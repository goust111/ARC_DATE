+    if not np.array_equal(np.flipud(a["mask"]), b["mask"]):
+        return None
+    r0a, _c0a, r1a, _c1a = a["bbox"]
+    r0b, _c0b, r1b, _c1b = b["bbox"]
+    axis2 = r0a + r1b
+    if axis2 != r1a + r0b or axis2 % 2:
+        return None
+    reflected = {(axis2 - r, c) for r, c in a["coord_set"]}
+    if reflected != b["coord_set"]:
