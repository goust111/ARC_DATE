+def _markers_are_clear(markers: list[dict]) -> bool:
+    cols = [m["value"] for m in markers if m["kind"] == "v"]
+    rows = [m["value"] for m in markers if m["kind"] == "h"]
+    centers = [m["value"] for m in markers if m["kind"] == "r"]
