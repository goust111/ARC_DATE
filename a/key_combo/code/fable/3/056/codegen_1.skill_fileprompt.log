+    return {(pr + dr, pc + dc) for dr, dc in rel_cells}
+
+
+def _connected_components(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r in range(h):
