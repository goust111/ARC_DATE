+    dr, dc = rel
+    if direction == DIR_CW:
+        return dc, -dr
+    if direction == DIR_CCW:
+        return -dc, dr
+    raise ValueError(f"unexpected direction: {direction}")
+
+
+def _rotate_set(cells: set[tuple[int, int]], direction: int) -> set[tuple[int, int]]:
+    return {_rotate_point(cell, direction) for cell in cells}
