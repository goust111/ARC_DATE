+    order = sorted(range(len(pivots)), key=lambda idx: len(candidate_lists[idx]))
+    assignments: list[dict[str, object] | None] = [None] * len(pivots)
+    used_red: set[int] = set()
+    used_green: set[int] = set()
+    used_future: set[tuple[int, int]] = set()
