+    def search(depth: int) -> bool:
+        if depth == len(order):
+            return True
+        pivot_i = order[depth]
+        for candidate in candidate_lists[pivot_i]:
+            red_i = int(candidate["red_i"])
+            green_i = int(candidate["green_i"])
+            future_abs = set(candidate["future_abs"])
