+        if not frontier:
+            return None
+        cells.add(random.choice(sorted(frontier)))
+    return cells
+
+
+def _expand_cells(
+    cells: set[tuple[int, int]], shape: tuple[int, int], radius: int = 1
+) -> set[tuple[int, int]]:
