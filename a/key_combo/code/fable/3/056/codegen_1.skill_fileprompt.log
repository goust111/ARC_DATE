+def _random_connected_shape(height: int, width: int, n_cells: int) -> set[tuple[int, int]] | None:
+    start = (random.randrange(height), random.randrange(width))
+    cells = {start}
+    while len(cells) < n_cells:
+        frontier = {
+            nxt
+            for cell in cells
+            for nxt in _neighbors4(cell, height, width)
+            if nxt not in cells
