+        chosen_cells: dict[str, set[tuple[int, int]] | tuple[int, int]] | None = None
+        for pivot in positions:
+            red_abs = _add_rel(pivot, red_rel)
+            green_abs = _add_rel(pivot, green_rel)
+            future_abs = _add_rel(pivot, future_rel)
