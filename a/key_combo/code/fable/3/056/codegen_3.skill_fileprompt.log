+            return None
+        for i in range(1, body_w - 1):
+            tab = bool(occupancy[height - 1, body_c0 + i])
+            base = bool(occupancy[body_r0 + body_h - 1, body_c0 + i])
+            if tab and base:
+                seq.append(1)
+                saw_tab = True
+            elif (not tab) and (not base):
+                seq.append(0)
