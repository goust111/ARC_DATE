+    motif_mask = interior != base_color
+    return {
+        "side": side,
+        "axis": SIDE_AXIS[side],
+        "body_h": body_h,
+        "body_w": body_w,
+        "body_r0": body_r0,
+        "body_c0": body_c0,
+        "seq": seq_t,
+        "motif_mask": motif_mask,
+        "interior_h": body_h - 2,
