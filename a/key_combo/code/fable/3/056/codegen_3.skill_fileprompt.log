+
+def _choose_unpaired_sequence(length: int, existing: list[tuple[int, ...]]) -> tuple[int, ...] | None:
+    for _ in range(300):
+        seq = _random_seq(length)
+        if seq in existing:
+            continue
+        if any(_sequence_matches(seq, other) for other in existing):
