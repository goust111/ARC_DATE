+from collections import Counter, deque
+import math
+import random
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+HORIZONTAL_SIDES = ("top", "bottom")
+VERTICAL_SIDES = ("left", "right")
+ALL_SIDES = HORIZONTAL_SIDES + VERTICAL_SIDES
+SIDE_AXIS = {"top": "h", "bottom": "h", "left": "v", "right": "v"}
