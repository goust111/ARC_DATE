+# --------------- generator ---------------
+
+COLORS = list(range(10))
+BODY_H_RANGE = (5, 8)
+BODY_W_RANGE = (5, 8)
+PAIR_COUNT_RANGE = (2, 3)
+UNPAIRED_COUNT_RANGE = (0, 2)
+PADDING = 2
+PLACEMENT_TRIES = 250
+GEN_RETRIES = 300
