+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[tuple[int, int]]:
+    dirs = DIRS4 if connectivity == 4 else DIRS8
+    out = []
+    h, w = shape
+    for dr, dc in dirs:
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
