+        max_h = min(5, r1 - r0 - 1)
+        max_w = min(5, c1 - c0 - 1)
+        if max_h < 2 or max_w < 2:
+            return None
+        sprite, anchor = _generate_template_sprite(max_h, max_w, main_colors[idx], minority_colors[idx])
+
+        placements = []
+        for top in range(r0 + 1, r1 - sprite.shape[0] + 2):
+            for left in range(c0 + 1, c1 - sprite.shape[1] + 2):
