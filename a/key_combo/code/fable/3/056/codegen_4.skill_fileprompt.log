+def _crop_component(grid: np.ndarray, coords: list[tuple[int, int]]) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
