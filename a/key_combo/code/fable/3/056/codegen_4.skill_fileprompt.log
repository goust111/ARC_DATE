+
+def _can_place_bbox(
+    occupied: np.ndarray,
+    bounds: tuple[int, int, int, int],
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+) -> bool:
+    r0, c0, r1, c1 = bounds
+    if top < r0 + 1 or left < c0 + 1 or top + height - 1 > r1 - 1 or left + width - 1 > c1 - 1:
+        return False
+    rr0 = max(r0, top - 1)
+    cc0 = max(c0, left - 1)
+    rr1 = min(r1, top + height)
+    cc1 = min(c1, left + width)
+    return not occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any()
