+    local_blocked = set(blocked)
+    for pos in choices:
+        if pos in local_blocked:
+            continue
+        picked.append(pos)
+        local_blocked |= _expand_cells([pos], shape)
+        if len(picked) == count:
+            return picked
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    side = random.choice(["top", "bottom", "left", "right"])
