+
+def _visible_stamp_cells(
+    shape: tuple[int, int],
+    sprite: np.ndarray,
+    anchor: tuple[int, int],
+    marker: tuple[int, int],
+) -> tuple[list[tuple[int, int, int]], bool]:
+    h, w = shape
+    top = marker[0] - anchor[0]
+    left = marker[1] - anchor[1]
