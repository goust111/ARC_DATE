+    blocked: set[tuple[int, int]] = set()
+    matched_placements = []
+    for idx, require_clipped in plans:
+        spec = template_specs[idx]
+        picked = _pick_marker_position(
+            grid.shape,
+            catalog_zone,
+            spec["sprite"],
+            spec["anchor"],
+            blocked,
+            require_clipped=require_clipped,
