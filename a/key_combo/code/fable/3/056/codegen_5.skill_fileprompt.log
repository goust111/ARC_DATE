+def _turn_dirs(prev_dir: Coord | None) -> list[Coord]:
+    if prev_dir is None:
+        dirs = DIRS4[:]
+    else:
+        dr, dc = prev_dir
+        dirs = [(-dc, dr), (dc, -dr)]
+    random.shuffle(dirs)
+    return dirs
