+def _extend_segment(
+    path: list[Coord],
+    used: set[Coord],
+    direction: Coord,
+    steps: int,
+    shape: tuple[int, int],
+) -> tuple[list[Coord], set[Coord]] | None:
+    dr, dc = direction
+    h, w = shape
+    new_path = list(path)
+    new_used = set(used)
+    r, c = new_path[-1]
+
+    for _ in range(steps):
+        nr, nc = r + dr, c + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            return None
+        if (nr, nc) in new_used:
+            return None
+        if any((ar, ac) in new_used and (ar, ac) != (r, c) for ar, ac in _neighbors4(nr, nc)):
+            return None
+        new_path.append((nr, nc))
+        new_used.add((nr, nc))
+        r, c = nr, nc
