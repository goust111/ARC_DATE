+
+def _random_composition(total: int, parts: int) -> list[int]:
+    assert parts >= 1 and total >= parts
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    out: list[int] = []
+    prev = 0
+    for cut in cuts + [total]:
+        out.append(cut - prev)
+        prev = cut
+    return out
+
