+    r1, c1 = coords.max(axis=0)
+    sprite = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    sprite[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return sprite
