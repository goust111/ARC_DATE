+def _mask_signature(mask: np.ndarray) -> tuple[int, int, tuple[int, ...]]:
+    trimmed = _trim_mask(np.asarray(mask, dtype=bool))
+    flat = tuple(int(v) for v in trimmed.ravel())
+    return int(trimmed.shape[0]), int(trimmed.shape[1]), flat
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    if not coords:
+        return False
+    start = next(iter(coords))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nxt = (r + dr, c + dc)
+            if nxt in coords and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(coords)
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        coords = []
+        while stack:
+            rr, cc = stack.pop()
+            coords.append((rr, cc))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr = rr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        components.append(np.array(coords, dtype=int))
+    return components
