    idx: int = 0,
    chosen: list[tuple[dict, str]] | None = None,
    blocked: set[tuple[int, int]] | None = None,
) -> list[tuple[dict, str]] | None:
    if chosen is None:
        chosen = []
    if blocked is None:
        blocked = set()
    if idx == len(source_types):
        return chosen

    candidates = slots[:]
    random.shuffle(candidates)
    source_type = source_types[idx]
