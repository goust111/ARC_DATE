+    source_particles: dict[tuple[int, int], list[int]] = {}
+    for path_index, path in enumerate(paths):
+        for i, cell in enumerate(path[:-1]):
+            cell_state[cell]["direction"] = _direction_between(cell, path[i + 1])
+            cell_state[cell]["leak"] = True
