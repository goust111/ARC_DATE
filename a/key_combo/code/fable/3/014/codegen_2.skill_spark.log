def _reflect(dr: int, dc: int, mirror: str) -> Tuple[int, int]:
    \"\"\"Reflect a directional delta by a diagonal mirror.\"\"\"
    if mirror == \"\\\\\":
        return int(dc), int(dr)
    if mirror == \"/\":
