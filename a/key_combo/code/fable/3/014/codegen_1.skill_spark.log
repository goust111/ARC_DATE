def main(grid: np.ndarray) -> np.ndarray:
    """
    Recover hidden deviation pixels by overlaying aligned slot copies and keeping only slot-relative outliers.

    Input structure:
    - Background is the most frequent color.
    - Non-background pixels form several identical rectangular slot copies arranged on a regular grid.
    - Each slot is a copy of one base sprite, with sparse color deviations.
    - Non-background noise pixels outside the slot array are present.

    Rule:
    - Detect the slot array and recover the common bbox-aligned grid of slots.
    - For each relative position inside a slot, take the majority color across all slots as the base sprite color.
    - In the output sprite-sized grid, write only the deviation colors at positions where any slot differs from the base majority; all other cells are background.

    Key insight:
    - The “noise” is not removed globally: all slots are aligned by their own bbox and only the non-majority traces at each relative cell are extracted and overlaid into one compact sprite.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=False, min_area=1)
    layout = _component_to_layout(components)
    assert layout is not None, "unable to detect a regular slot layout"

    h = int(layout["height"])
    w = int(layout["width"])

    slot_patches: list[np.ndarray] = []
    for item in layout["components"]:
        r0, c0, r1, c1 = map(int, item["bbox"])
        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        assert patch.shape == (h, w), "slot copy shape must align"
        slot_patches.append(patch)

    out = np.full((h, w), int(bg), dtype=int)

    for rr in range(h):
        for cc in range(w):
            votes = Counter(int(patch[rr, cc]) for patch in slot_patches)
            common = votes.most_common()
            base_color, base_count = common[0]
            if len(common) > 1 and common[1][1] == base_count:
                # Degenerate ambiguity should not occur under task constraints.
                raise AssertionError("ambiguous base color at a slot-relative position")

            non_base = [color for color, _ in common if color != base_color]
            if non_base:
                if len(non_base) != 1:
                    raise AssertionError("expected at most one deviation color per slot-relative position")
                out[rr, cc] = int(non_base[0])

    return out


# -------------------------- generator --------------------------

def _sample_slot_layout(
    sprite_h: int,
    sprite_w: int,
) -> tuple[int, int, int, int] | None:
    """Return (rows, cols, gap_r, gap_c) with slots-fit guardrails."""
    max_slots = sprite_h * sprite_w

    use_line = random.random() < 0.3
    rows_options = [(1, c) for c in range(2, min(6, max_slots) + 1)]
    cols_options = [(r, 1) for r in range(2, min(6, max_slots) + 1)]

    grid_options = [(r, c) for r in range(2, 5) for c in range(2, 5) if r * c <= max_slots]
    if use_line:
        grid_options = [opt for opt in (rows_options + cols_options) if 2 <= opt[0] * opt[1] <= max_slots]

    if not grid_options:
        return None

    rows, cols = random.choice(grid_options)
    gap_r = random.randint(1 if rows > 1 else 0, 2)
    gap_c = random.randint(1 if cols > 1 else 0, 2)
    return rows, cols, gap_r, gap_c


def _is_free_for_noise(
    r: int,
    c: int,
    occupied: set[tuple[int, int]],
    H: int,
    W: int,
) -> bool:
    if (r, c) in occupied:
        return False
    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
        nr, nc = r + dr, c + dc
        if 0 <= nr < H and 0 <= nc < W and (nr, nc) in occupied:
            return False
    return True


def _place_isolated_pair(
    g: np.ndarray,
    occupied: set[tuple[int, int]],
    color: int,
) -> bool:
    H, W = g.shape
    candidates: list[tuple[int, int]] = [
        (r, c)
        for r in range(H)
        for c in range(W)
        if _is_free_for_noise(r, c, occupied, H, W)
    ]
    random.shuffle(candidates)

    for r0, c0 in candidates:
        for dr, dc in ((1, 0), (0, 1)):
            r1, c1 = r0 + dr, c0 + dc
            if not (0 <= r1 < H and 0 <= c1 < W):
                continue
            if not _is_free_for_noise(r1, c1, occupied, H, W):
                continue
            g[r0, c0] = color
            g[r1, c1] = color
            occupied.add((r0, c0))
            occupied.add((r1, c1))
            return True
    return False


