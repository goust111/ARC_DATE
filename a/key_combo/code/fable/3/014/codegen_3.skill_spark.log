    r0, c0 = map(int, top_left)
    r1 = r0 + h + 1
    c1 = c0 + w + 1
    canvas[r0, c0 : c1 + 1] = frame_color
    canvas[r1, c0 : c1 + 1] = frame_color
    canvas[r0 : r1 + 1, c0] = frame_color
    canvas[r0 : r1 + 1, c1] = frame_color
