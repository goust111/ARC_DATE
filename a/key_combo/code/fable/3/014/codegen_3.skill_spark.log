    inner_h = random.randint(*mod._INNER_H_RANGE)
    inner_w = random.randint(*mod._INNER_W_RANGE)
    outer_h = inner_h + 2
    outer_w = inner_w + 2
    frame_colors = random.sample(list(mod._PANEL_COLOR_POOL), panel_count)
    layout = mod._place_panel_tops(panel_count, outer_h, outer_w)
    if layout is None:
        continue
    H,W,rects = layout
    rects = rects[:panel_count]
    permutation = mod._random_pointer_permutation(panel_count)
    pointer_colors = [int(frame_colors[t]) for t in permutation]

    available_colors = [c for c in mod._PANEL_COLOR_POOL if c not in frame_colors]
    canvas = np.full((H, W), mod._BG, dtype=int)
    for idx,(r0,c0,r1,c1) in enumerate(rects):
        k = random.randint(*mod._PANEL_CONTENT_COLOR_COUNT)
        if len(available_colors) < k:
            k = len(available_colors)
        palette = random.sample(available_colors, k=k)
        if not palette:
            palette = [c for c in mod._PANEL_COLOR_POOL if c not in frame_colors]
        inner = mod._random_content(inner_h, inner_w, palette)
        pr,pc = random.randrange(inner_h), random.randrange(inner_w)
        inner[pr,pc] = pointer_colors[idx]
        mod._draw_frame(canvas, (r0,c0), inner_h, inner_w, int(frame_colors[idx]), inner)

    # inspect components using current main parser assumptions
    bg = int(mod.get_bg(canvas))
    comps = mod.find_components(canvas, bg=bg, connectivity=4, monochromatic=True, return_format='dict')
    frame_comps = [comp for comp in comps if mod._is_rect_frame_component(canvas, comp)]
    panels=[]
    for comp in frame_comps:
        r0,c0,r1,c1 = map(int, comp['bbox'])
        if r0+1 <= r1-1 and c0+1 <= c1-1:
            panels.append({'color': int(comp['color']), 'inner':(r0+1,c0+1,r1-1,c1-1)})
    dedup={}
    for p in panels:
        dedup.setdefault(p['color'], p)
    panels=list(dedup.values())

    if len(panels) < 2:
        continue
    frame_colors_detected = {p['color'] for p in panels}
    bad=False
    for p in panels:
        r0,c0,r1,c1 = p['inner']
        inner = canvas[r0:r1+1,c0:c1+1]
        cand=[]
        for rr,cc in np.argwhere(inner"'!=bg):
            color=int(inner[tuple(map(int,(rr,cc)))])
            if color != p['"'color'] and color in frame_colors_detected:
                cand.append((rr,cc,color))
        if len(cand)"'!=1:
            bad=True
            if len(cand)>1:
                print('"'attempt', attempt, 'panel', p['color'], 'n',len(cand), 'samples', cand[:6])
                print('frame colors detected', sorted(frame_colors_detected))
                print('used frame colors', frame_colors)
                print('permutation', permutation)
                print('first 3 rows:\\n', canvas[:10,:10])
                raise SystemExit
            break
    if not bad:
        print('found good', attempt)
        print('panel_count', panel_count, 'dims', H,W, inner_h, inner_w)
        raise SystemExit

print('no valid found')
