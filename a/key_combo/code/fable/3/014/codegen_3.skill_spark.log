_GEN_BG = 0
_GEN_GRID_SIZE_RANGE = (20, 30)
_GEN_COLOR_IDS = range(1, 10)
_GEN_COLOR_COUNT = 4
# Pair and path structure.
_GEN_PAIR_COUNT = 2
