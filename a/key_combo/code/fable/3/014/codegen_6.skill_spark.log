            stats['sprite_none'] += 1
            continue
        mod._draw_sprite(grid, sprite_color, sprite_bbox, sprite_side)

        try:
            out = mod.main(grid)
            stats['main_ok'] += 1
            if np.array_equal(grid, out):
                stats['no_move'] += 1
        except Exception:
            stats['main_fail'] += 1

    print('frame_count', frame_count, dict(stats))
