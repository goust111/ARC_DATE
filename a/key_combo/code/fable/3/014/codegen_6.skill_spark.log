        mod._draw_frame(grid, int(frame_colors[0]), outer_bbox)
        parent_inner = mod._inner_bbox(outer_bbox)

        ok = True
        for j in range(1, frame_count):
            side = random.choice(mod.SIDES)
            child = mod._place_child(parent_inner, side, min_h=3, min_w=3)
            if child is None:
                stats['child_none'] += 1
                ok = False
                break
            mod._draw_frame(grid, int(frame_colors[j]), child)
            parent_inner = mod._inner_bbox(child)

        if not ok:
            continue

        sprite_side = random.choice(mod.SIDES)
        sprite_bbox = mod._place_child(parent_inner, sprite_side, min_h=2, min_w=2)
