def _rects_diagonal(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
    a_r0, a_c0, a_r1, a_c1 = a
    b_r0, b_c0, b_r1, b_c1 = b

    return (
        (a_r1 + margin < b_r0 or b_r1 + margin < a_r0)
        and (a_c1 + margin < b_c0 or b_c1 + margin < a_c0)
    )


def _place_two_frames(H: int, W: int, outer_a: tuple[int, int], outer_b: tuple[int, int], margin: int) -> tuple[int, int, int, int, int, int] | None:
    oh_a, ow_a = outer_a
    oh_b, ow_b = outer_b

    r0_min = margin
    r0_max = H - oh_a - margin
    c0_min = margin
    c0_max = W - ow_a - margin
    if r0_min > r0_max or c0_min > c0_max:
        return None

    for _ in range(_TRIES_TO_PLACE):
        a_r0 = random.randint(r0_min, r0_max)
        a_c0 = random.randint(c0_min, c0_max)
        a_r1 = a_r0 + oh_a - 1
        a_c1 = a_c0 + ow_a - 1
        a_rect = (a_r0, a_c0, a_r1, a_c1)

        b_r0_min = margin
        b_r0_max = H - oh_b - margin
        b_c0_min = margin
        b_c0_max = W - ow_b - margin
        if b_r0_min > b_r0_max or b_c0_min > b_c0_max:
            return None

        b_r0 = random.randint(b_r0_min, b_r0_max)
        b_c0 = random.randint(b_c0_min, b_c0_max)
        b_r1 = b_r0 + oh_b - 1
        b_c1 = b_c0 + ow_b - 1
        b_rect = (b_r0, b_c0, b_r1, b_c1)

        if _rects_diagonal(a_rect, b_rect, margin=margin):
            return (a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1)

    return None


def _draw_hollow_frame(canvas: np.ndarray, top_left: tuple[int, int], inner_h: int, inner_w: int, color: int) -> tuple[int, int, int, int]:
    r0, c0 = map(int, top_left)
    r1 = r0 + int(inner_h) + 1
    c1 = c0 + int(inner_w) + 1

    canvas[r0, c0 : c1 + 1] = color
    canvas[r1, c0 : c1 + 1] = color
    canvas[r0 : r1 + 1, c0] = color
    canvas[r0 : r1 + 1, c1] = color

    return (r0, c0, r1, c1)


def _axis_candidates(
    g: np.ndarray,
    bg: int,
    frame: dict,
    d: int,
    sides: tuple[str, ...],
) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = frame["bbox"]
    h, w = g.shape
    out: list[tuple[int, int]] = []

    if "up" in sides:
        mr = r0 - int(d) - 1
        if 0 <= mr < h:
            for mc in range(c0, c1 + 1):
                if g[mr, mc] == bg and _axis_is_bg(g, bg, mr, mc, 1, 0, d):
                    out.append((mr, mc))

    if "down" in sides:
        mr = r1 + int(d) + 1
        if 0 <= mr < h:
            for mc in range(c0, c1 + 1):
                if g[mr, mc] == bg and _axis_is_bg(g, bg, mr, mc, -1, 0, d):
                    out.append((mr, mc))

    if "left" in sides:
        mc = c0 - int(d) - 1
        if 0 <= mc < w:
            for mr in range(r0, r1 + 1):
                if g[mr, mc] == bg and _axis_is_bg(g, bg, mr, mc, 0, 1, d):
                    out.append((mr, mc))

    if "right" in sides:
        mc = c1 + int(d) + 1
        if 0 <= mc < w:
            for mr in range(r0, r1 + 1):
                if g[mr, mc] == bg and _axis_is_bg(g, bg, mr, mc, 0, -1, d):
                    out.append((mr, mc))

    return out


def _place_frame_markers(
    g: np.ndarray,
    bg: int,
    frame: dict,
    frame_idx: int,
    frames: list[dict],
    marker_palette: list[int],

