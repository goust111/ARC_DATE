from importlib.machinery import SourceFileLoader
from pathlib import Path
import random, numpy as np
p=Path('/home/lixinyu/snap/a/key_combo/code/fable/3/014/4.py')
mod=SourceFileLoader('x', str(p)).load_module()

def attempt():
    inner_h_a = random.randint(*mod._INNER_H_RANGE)
    inner_w_a = random.randint(*mod._INNER_W_RANGE)
    inner_h_b = random.randint(*mod._INNER_H_RANGE)
    inner_w_b = random.randint(*mod._INNER_W_RANGE)

    outer_h_a = inner_h_a + 2
    outer_w_a = inner_w_a + 2
    outer_h_b = inner_h_b + 2
    outer_w_b = inner_w_b + 2

    rings_a = mod._frame_inner_layers(inner_h_a, inner_w_a)
    rings_b = mod._frame_inner_layers(inner_h_b, inner_w_b)
    edge_margin = 1 + max(rings_a, rings_b)
    if edge_margin < 3:
        edge_margin = 3

    H = random.randint(max(outer_h_a, outer_h_b) + 2 * edge_margin + 3, 30)
    W = random.randint(max(outer_w_a, outer_w_b) + 2 * edge_margin + 3, 30)
    if H > 30:
        H = 30
    if W > 30:
        W = 30
    if H < outer_h_a + 2 * edge_margin or W < outer_w_a + 2 * edge_margin:
        return ('skip', None)

    place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), margin=edge_margin)
    if place is None:
        return ('no_place', None)

    a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1 = place
    frame_color_a = random.choice(mod._COLOR_POOL)
    frame_color_b = frame_color_a if random.random() < 0.4 else random.choice([c for c in mod._COLOR_POOL if c "'!= frame_color_a])
    palette = [int(c) for c in mod._COLOR_POOL if c not in {frame_color_a, frame_color_b}] or [int(c) for c in mod._COLOR_POOL if c != mod._BG]
    canvas = np.full((H, W), mod._BG, dtype=int)
    fa=mod._draw_hollow_frame(canvas,(a_r0,a_c0),inner_h_a,inner_w_a,frame_color_a)
    fb=mod._draw_hollow_frame(canvas,(b_r0,b_c0),inner_h_b,inner_w_b,frame_color_b)
    frame_a={'"'bbox':fa,'rings':rings_a,'inner_h':inner_h_a,'inner_w':inner_w_a}
    frame_b={'bbox':fb,'rings':rings_b,'inner_h':inner_h_b,'inner_w':inner_w_b}
    frames=[frame_a, frame_b]

    ok_a=mod._place_frame_markers(canvas, mod._BG, frame_a,0,frames,palette)
    if not ok_a:
        return ('bad_a', frame_a)
    ok_b=mod._place_frame_markers(canvas, mod._BG, frame_b,1,frames,palette)
    if not ok_b:
        return ('bad_b', frame_b)

    try:
        out = mod.main(canvas)
    except Exception as e:
        return ('main_fail', e)

    if np.array_equal(out, canvas):
        return ('no_change', None)
    if np.array_equal(mod.main(out), out):
        return ('ok', out)
    return ('not_stable', None)

for i in range(5000):
    r=attempt()
    if r[0] "'!= '"'ok':
        if r[0]=='bad_a' or r[0]=='bad_b':
            frame=r[1]
            print('fail',r[0],frame['rings'])
            break
        print('fail',r)
        break
else:
    print('all ok')
