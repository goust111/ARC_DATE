        edge_margin = max(3, 1 + max(rings_a, rings_b))

        lo_h = max(outer_h_a, outer_h_b) + 2 * edge_margin + 3
        lo_w = max(outer_w_a, outer_w_b) + 2 * edge_margin + 3
        H = random.randint(lo_h, 30)
        W = random.randint(lo_w, 30)
        if H < outer_h_a + 2 * edge_margin or W < outer_w_a + 2 * edge_margin:
            continue

        place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), edge_margin)
        if place is None:
            continue

        a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1 = place

        if random.random() < 0.4:
            frame_color_a = random.choice(mod._COLOR_POOL)
            frame_color_b = frame_color_a
        else:
            frame_color_a, frame_color_b = random.sample(mod._COLOR_POOL, 2)

        marker_palette = [int(c) for c in mod._COLOR_POOL if c not in {frame_color_a, frame_color_b}]
        random.shuffle(marker_palette)

        if len(marker_palette) < rings_a + rings_b:
            marker_palette = marker_palette

        canvas = np.full((H, W), mod._BG, dtype=int)
        frame_a_bbox = mod._draw_hollow_frame(canvas, (a_r0, a_c0), inner_h_a, inner_w_a, frame_color_a)
        frame_b_bbox = mod._draw_hollow_frame(canvas, (b_r0, b_c0), inner_h_b, inner_w_b, frame_color_b)
        frames=[
            {'bbox':frame_a_bbox,'rings':rings_a,'inner_h':inner_h_a,'inner_w':inner_w_a,'color':frame_color_a},
            {'bbox':frame_b_bbox,'rings':rings_b,'inner_h':inner_h_b,'inner_w':inner_w_b,'color':frame_color_b},
        ]
        colors_a = marker_palette[:rings_a]
        colors_b = marker_palette[rings_a:rings_a+rings_b]
        if not mod._place_frame_markers(canvas, mod._BG, frames[0], 0, frames, colors_a):
            cnt['marker'] += 1
            continue
        if not mod._place_frame_markers(canvas, mod._BG, frames[1], 1, frames, colors_b):
            cnt['marker'] += 1
            continue
        try:
            out = mod.main(canvas)
        except Exception:
            cnt['same'] += 1
            continue
        if np.array_equal(out, canvas):
            cnt['idempotent_fail'] += 1
            continue
        try:
            if not np.array_equal(mod.main(out), out):
                cnt['same'] +=1
                continue
        except Exception:
            cnt['same'] +=1
            continue
        ok=True
        break
    if ok:
        cnt['ok'] +=1

print(cnt)
