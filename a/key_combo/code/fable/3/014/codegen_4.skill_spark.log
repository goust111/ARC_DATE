# Bounds and palette.
GRID_MIN, GRID_MAX = 10, 20
INTERIOR_MIN, INTERIOR_MAX = 4, 12
PADDING_MIN, PADDING_MAX = 1, 3
MARKER_COUNT_MIN, MARKER_COUNT_MAX = 2, 5
MARKER_COLOR_MIN, MARKER_COLOR_MAX = 2, 9
BG_COLOR, FRAME_COLOR = 0, 1

