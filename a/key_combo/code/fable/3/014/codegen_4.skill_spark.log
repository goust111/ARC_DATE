        if not mod._place_frame_markers(canvas, mod._BG, frame_a, 0, frames, colors_a):
            outer_stats['mark'] += 1
            continue
        if not mod._place_frame_markers(canvas, mod._BG, frame_b, 1, frames, colors_b):
            outer_stats['mark'] += 1
            continue

        try:
