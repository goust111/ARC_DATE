    inner_w_a = random.randint(*mod._INNER_W_RANGE)
    inner_h_b = random.randint(*mod._INNER_H_RANGE)
    inner_w_b = random.randint(*mod._INNER_W_RANGE)
    outer_h_a, outer_w_a = inner_h_a+2, inner_w_a+2
    outer_h_b, outer_w_b = inner_h_b+2, inner_w_b+2
    rings_a = mod._frame_inner_layers(inner_h_a, inner_w_a)
    rings_b = mod._frame_inner_layers(inner_h_b, inner_w_b)
    edge_margin = max(3, 1 + max(rings_a, rings_b))

    H = random.randint(max(outer_h_a, outer_h_b) + 2*edge_margin + 3, 30)
    W = random.randint(max(outer_w_a, outer_w_b) + 2*edge_margin + 3, 30)
    if H < outer_h_a + 2*edge_margin or W < outer_w_a + 2*edge_margin:
        continue

    place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), margin=edge_margin)
    if place is None:
        continue
    a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1 = place

    frame_color_a = random.choice(mod._COLOR_POOL)
    frame_color_b = frame_color_a if random.random()<0.4 else random.choice([c for c in mod._COLOR_POOL if c"'!=frame_color_a])
    marker_palette = [c for c in mod._COLOR_POOL if c not in {frame_color_a, frame_color_b}]
    random.shuffle(marker_palette)
    if len(marker_palette)<rings_a+rings_b:
        marker_palette = marker_palette + [random.choice(marker_palette)]
        random.shuffle(marker_palette)

    colors_a = marker_palette[:rings_a]
    colors_b = marker_palette[rings_a:rings_a+rings_b]

    canvas = np.full((H,W), mod._BG, dtype=int)
    fa = mod._draw_hollow_frame(canvas, (a_r0,a_c0), inner_h_a, inner_w_a, frame_color_a)
    fb = mod._draw_hollow_frame(canvas, (b_r0,b_c0), inner_h_a, inner_w_b if False else inner_w_b, frame_color_b)
    frames=[{'"'bbox':fa,'rings':rings_a,'inner_h':inner_h_a,'inner_w':inner_w_a},{'bbox':fb,'rings':rings_b,'inner_w':inner_w_b,'inner_h':inner_h_b}]

    if not mod._place_frame_markers(canvas, mod._BG, frames[0],0,frames,colors_a):
        continue
    if not mod._place_frame_markers(canvas, mod._BG, frames[1],1,frames,colors_b):
        continue
    out = mod.main(canvas)
    if np.array_equal(out, canvas):
        continue
    out2 = mod.main(out)
    if not np.array_equal(out, out2):
        print('found non-idempotent')
