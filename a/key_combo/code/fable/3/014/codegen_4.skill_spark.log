from pathlib import Path
import random
p=Path('/home/lixinyu/snap/a/key_combo/code/fable/3/014/4.py')
mod=SourceFileLoader('x', str(p)).load_module()

bad=0
for _ in range(50000):
    H=random.randint(10,30)
    W=random.randint(10,30)
    ih1=random.randint(*mod._INNER_H_RANGE)
    iw1=random.randint(*mod._INNER_W_RANGE)
    ih2=random.randint(*mod._INNER_H_RANGE)
    iw2=random.randint(*mod._INNER_W_RANGE)
    oh1,ow1=ih1+2,iw1+2
    oh2,ow2=ih2+2,iw2+2
    edge_margin=max(1+mod._frame_inner_layers(ih1,iw1),3)
    edge_margin=max(edge_margin,1+mod._frame_inner_layers(ih2,iw2))
    if H<oh1+2*edge_margin+3 or W<ow1+2*edge_margin+3 or H<oh2+2*edge_margin+3 or W<ow2+2*edge_margin+3:
        H=max(oh1,oh2)+2*edge_margin+3
        W=max(ow1,ow2)+2*edge_margin+3
        H=min(H,30)
        W=min(W,30)
    if H<=0 or W<=0:
        continue
    res=mod._place_two_frames(H,W,(oh1,ow1),(oh2,ow2),margin=edge_margin)
    if res is None:
        continue
    a0,a1,a2,a3,b0,b1,b2,b3=res
    for r0,c0,r1,c1 in [(a0,a1,a2,a3),(b0,b1,b2,b3)]:
        if not (0<=r0<=r1<H and 0<=c0<=c1<W):
            bad+=1
            print('bad',res,'canvas',H,W,'rect',oh1,ow1,oh2,ow2,'edge',edge_margin)
            raise SystemExit
print('bad',bad)
