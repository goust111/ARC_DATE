def _rects_diagonal(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
    a_r0, a_c0, a_r1, a_c1 = a
    b_r0, b_c0, b_r1, b_c1 = b

    return (
        (a_r1 + margin < b_r0 or b_r1 + margin < a_r0)
        and (a_c1 + margin < b_c0 or b_c1 + margin < a_c0)
    )


def _place_two_frames(H: int, W: int, outer_a: tuple[int, int], outer_b: tuple[int, int], margin: int) -> tuple[int, int, int, int, int, int, int, int] | None:
    oh_a, ow_a = outer_a
    oh_b, ow_b = outer_b

    r0_min = margin
    r0_max = H - oh_a - margin
    c0_min = margin
    c0_max = W - ow_a - margin
    if r0_min > r0_max or c0_min > c0_max:
        return None

    for _ in range(_TRIES_TO_PLACE):
        a_r0 = random.randint(r0_min, r0_max)
        a_c0 = random.randint(c0_min, c0_max)
        a_r1 = a_r0 + oh_a - 1
        a_c1 = a_c0 + ow_a - 1
        a_rect = (a_r0, a_c0, a_r1, a_c1)

        b_r0_min = margin
        b_r0_max = H - oh_b - margin
        b_c0_min = margin
        b_c0_max = W - ow_b - margin
        if b_r0_min > b_r0_max or b_c0_min > b_c0_max:
            return None

        b_r0 = random.randint(b_r0_min, b_r0_max)
        b_c0 = random.randint(b_c0_min, b_c0_max)
        b_r1 = b_r0 + oh_b - 1
        b_c1 = b_c0 + ow_b - 1
        b_rect = (b_r0, b_c0, b_r1, b_c1)

        if _rects_diagonal(a_rect, b_rect, margin=margin):
            return (a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1)

    return None
