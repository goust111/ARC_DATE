from importlib.machinery import SourceFileLoader
from pathlib import Path
import random
import numpy as np
p=Path('/home/lixinyu/snap/a/key_combo/code/fable/3/014/4.py')
mod=SourceFileLoader('x', str(p)).load_module()

for attempt in range(400):
    inner_h_a = random.randint(*mod._INNER_H_RANGE)
    inner_w_a = random.randint(*mod._INNER_W_RANGE)
    inner_h_b = random.randint(*mod._INNER_H_RANGE)
    inner_w_b = random.randint(*mod._INNER_W_RANGE)

    outer_h_a = inner_h_a + 2
    outer_w_a = inner_w_a + 2
    outer_h_b = inner_h_b + 2
    outer_w_b = inner_w_b + 2

    rings_a = mod._frame_inner_layers(inner_h_a, inner_w_a)
    rings_b = mod._frame_inner_layers(inner_h_b, inner_w_b)
    edge_margin = 1 + max(rings_a, rings_b)
    if edge_margin < 3:
        edge_margin = 3

    H = random.randint(max(outer_h_a, outer_h_b) + 2 * edge_margin + 3, 30)
    W = random.randint(max(outer_w_a, outer_w_b) + 2 * edge_margin + 3, 30)
    if H > 30:
        H = 30
    if W > 30:
        W = 30
    if H < outer_h_a + 2 * edge_margin or W < outer_w_a + 2 * edge_margin:
        continue

    place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), margin=edge_margin)
    if place is None:
        place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), margin=1)
        if place is None:
            print('no place')
            continue

    a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1 = place
    if random.random() < 0.4:
        frame_color_a = random.choice(mod._COLOR_POOL)
        frame_color_b = frame_color_a
    else:
        frame_color_a, frame_color_b = random.sample(mod._COLOR_POOL, 2)
    palette = [int(c) for c in mod._COLOR_POOL if c not in {frame_color_a, frame_color_b}] or [int(c) for c in mod._COLOR_POOL if c "'!= mod._BG]

    canvas = np.full((H, W), mod._BG, dtype=int)
    frame_a_bbox = mod._draw_hollow_frame(canvas, (a_r0, a_c0), inner_h_a, inner_w_a, frame_color_a)
