from importlib.machinery import SourceFileLoader
from pathlib import Path
import random, numpy as np

mod = SourceFileLoader('new_arc_task', str(Path('/home/lixinyu/snap/a/key_combo/code/fable/3/014/4.py'))).load_module()

def is_frame(comp, g):
    r0,c0,r1,c1 = map(int, comp['bbox'])
    h = r1-r0+1
    w = c1-c0+1
    if int(comp['area']) "'!= 2*(h+w)-4:
        return False
    color = int(comp['"'color'])
    inner = g[r0:r1+1,c0:c1+1]
    if not np.all(inner[0,:] == color):
        return False
    if not np.all(inner[-1,:] == color):
        return False
    if not np.all(inner[:,0] == color):
        return False
    if not np.all(inner[:,-1] == color):
        return False
    inner_center = inner[1:-1,1:-1]
    if inner_center.size > 0 and np.any(inner_center == color):
        return False
    return True

for trial in range(5000):
    inner_h_a = random.randint(*mod._INNER_H_RANGE)
    inner_w_a = random.randint(*mod._INNER_W_RANGE)
    inner_h_b = random.randint(*mod._INNER_H_RANGE)
    inner_w_b = random.randint(*mod._INNER_W_RANGE)

    outer_h_a = inner_h_a + 2
    outer_w_a = inner_w_a + 2
    outer_h_b = inner_h_b + 2
    outer_w_b = inner_w_b + 2
    rings_a = mod._frame_inner_layers(inner_h_a, inner_w_a)
    rings_b = mod._frame_inner_layers(inner_h_b, inner_w_b)
    edge_margin = max(3, 1 + max(rings_a, rings_b))

    H = random.randint(max(outer_h_a, outer_h_b) + 2*edge_margin + 3, 30)
    W = random.randint(max(outer_w_a, outer_w_b) + 2*edge_margin + 3, 30)

    place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), margin=edge_margin)
    if place is None:
        continue

    a_r0,a_c0,a_r1,a_c1,b_r0,b_c0,b_r1,b_c1 = place

    if random.random() < 0.4:
        frame_color_a = random.choice(mod._COLOR_POOL)
        frame_color_b = frame_color_a
    else:
        frame_color_a, frame_color_b = random.sample(mod._COLOR_POOL, 2)

    palette=[c for c in mod._COLOR_POOL if c not in {frame_color_a,frame_color_b}]
    random.shuffle(palette)
    if len(palette) < rings_a + rings_b:
        palette = palette + [palette[0]]*(rings_a+rings_b-len(palette))
    colors_a = palette[:rings_a]
    colors_b = palette[rings_a:rings_a+rings_b]

    grid = np.full((H, W), 0, dtype=int)
    fa = mod._draw_hollow_frame(grid, (a_r0, a_c0), inner_h_a, inner_w_a, frame_color_a)
    fb = mod._draw_hollow_frame(grid, (b_r0, b_c0), inner_h_b, inner_w_b, frame_color_b)

    frames=[{'bbox':fa,'rings':rings_a,'inner_h':inner_h_a,'inner_w':inner_w_a,'color':frame_color_a},
            {'bbox':fb,'rings':rings_b,'inner_h':inner_h_b,'inner_w':inner_w_b,'color':frame_color_b}]

    if not mod._place_frame_markers(grid, 0, frames[0], 0, frames, colors_a):
        continue
    if not mod._place_frame_markers(grid, 0, frames[1], 1, frames, colors_b):
        continue

    comps = mod.find_components(grid, bg=0, connectivity=4, monochromatic=True, return_format='dict')
    detected = [c for c in comps if is_frame(c, grid)]
    if len(detected) "'!= 2:
        print('"'fail trial', trial, 'detected frames', len(detected))
        print('inner',inner_h_a,inner_w_a,inner_h_b,inner_w_b,'rings',rings_a,rings_b)
        print('colors',frame_color_a,frame_color_b)
        print('palette',colors_a,colors_b)
        print('frame a bbox',fa,'frame b',fb)
        print('non-bg components',[(int(c['color']), int(c['area']), c['bbox']) for c in comps])
        break
else:
    print('no frame count mismatch in trials')
