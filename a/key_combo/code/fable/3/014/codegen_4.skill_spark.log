        edge_margin = 1 + max(rings_a, rings_b)
        if edge_margin < 3:
            edge_margin = 3

        H = random.randint(max(outer_h_a, outer_w_a, outer_h_b, outer_w_b) + 2 * edge_margin + 3, 30)
        W = random.randint(max(outer_w_a, outer_w_a, outer_w_b, outer_w_b) + 2 * edge_margin + 3, 30)

        if H > 30:
            H = 30
        if W > 30:
            W = 30

        if H < outer_h_a + 2 * edge_margin or W < outer_w_a + 2 * edge_margin:
            outer_stats['size'] += 1
            continue

        place = mod._place_two_frames(H, W, (outer_h_a, outer_w_a), (outer_h_b, outer_w_b), margin=edge_margin)
        if place is None:
            outer_stats['place'] += 1
            continue

        a_r0, a_c0, a_r1, a_c1, b_r0, b_c0, b_r1, b_c1 = place

        if random.random() < 0.4:
            frame_color_a = random.choice(mod._COLOR_POOL)
            frame_color_b = frame_color_a
        else:
            frame_color_a, frame_color_b = random.sample(mod._COLOR_POOL, 2)

        marker_palette = [int(c) for c in mod._COLOR_POOL if c not in {frame_color_a, frame_color_b}]
        if len(marker_palette) < rings_a + rings_b:
