            extra = rings_a + rings_b - len(marker_palette)
            if extra > 0:
                marker_palette = marker_palette + [int(random.choice(marker_palette)) for _ in range(extra)]
            random.shuffle(marker_palette)
        else:
            random.shuffle(marker_palette)

        if len(marker_palette) < rings_a + rings_b:
            outer_stats['"'colors'] += 1
            continue

        canvas = np.full((H, W), mod._BG, dtype=int)
        frame_a_bbox = mod._draw_hollow_frame(canvas, (a_r0, a_c0), inner_h_a, inner_w_a, frame_color_a)
        frame_b_bbox = mod._draw_hollow_frame(canvas, (b_r0, b_c0), inner_h_b, inner_w_b, frame_color_b)

        frame_a = {
            'bbox': frame_a_bbox,
            'rings': rings_a,
            'inner_h': inner_h_a,
            'inner_w': inner_w_a,
            'color': frame_color_a,
