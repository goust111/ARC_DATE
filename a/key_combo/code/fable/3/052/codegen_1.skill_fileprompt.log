+def _ring_cells(bbox: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells: set[Coord] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _draw_ring(grid: np.ndarray, bbox: BBox, color: int) -> None:
