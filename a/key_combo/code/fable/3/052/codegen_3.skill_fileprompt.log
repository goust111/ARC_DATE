+    marker_candidates = []
+    for color in all_colors:
+        per_region = [int(np.count_nonzero(region == color)) for region in regions]
+        if sum(per_region) == len(regions) and all(count == 1 for count in per_region):
+            marker_candidates.append(int(color))
