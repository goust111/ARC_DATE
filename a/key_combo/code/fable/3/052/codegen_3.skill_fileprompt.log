+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _legend_candidate(
+    grid: np.ndarray, bg: int, row: int, start_col: int, step: int
+) -> dict | None:
+    h, w = grid.shape
+    cols: list[int] = []
+    c = int(start_col)
+    while 0 <= c < w and int(grid[row, c]) != bg:
+        cols.append(c)
+        c += int(step)
+    if len(cols) < 2:
+        return None
+    if h > 1:
+        inward_row = 1 if row == 0 else h - 2
+        if any(int(grid[inward_row, cc]) != bg for cc in cols):
+            return None
+    positions = [(int(row), int(cc)) for cc in cols]
+    colors = [int(grid[r, c0]) for r, c0 in positions]
+    if step < 0:
+        positions.reverse()
+        colors.reverse()
+    return {"positions": positions, "colors": colors}
+
+
+def _find_legend_strip(grid: np.ndarray, bg: int) -> tuple[list[int], set[tuple[int, int]]]:
+    h, w = grid.shape
+    candidates = []
+    for row, start_col, step in [
+        (0, 0, 1),
+        (0, w - 1, -1),
+        (h - 1, 0, 1),
+        (h - 1, w - 1, -1),
+    ]:
+        candidate = _legend_candidate(grid, bg, row, start_col, step)
+        if candidate is not None:
+            candidates.append(candidate)
