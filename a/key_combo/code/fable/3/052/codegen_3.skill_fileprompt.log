+    if any(cell in blocked for cell in cells):
+        return None
+
+    if want_crop and crop_cells:
+        crop_goal = random.choice(list(crop_cells))
+        anchor = random.choice(list(cells))
+        path = _shortest_path(h, w, anchor, crop_goal, blocked)
+        if path is None:
+            return None
+        cells.update(path)
