+        w = c1 - c0 + 1
+        if coords.shape[0] != h * w or h < 3 or w < 3:
+            continue
+        windows.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "region": g[r0 : r1 + 1, c0 : c1 + 1],
