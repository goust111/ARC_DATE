+    count = max(int(count), len(cells))
+    while len(cells) < count:
+        frontier = []
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                nxt = (int(nr), int(nc))
+                if 0 <= nr < h and 0 <= nc < w and nxt not in blocked and nxt not in cells:
