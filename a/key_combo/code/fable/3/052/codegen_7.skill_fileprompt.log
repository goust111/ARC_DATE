+    sprites: list[dict] = []
+    for idx, coords in enumerate(_components((grid != int(bg)) & outside)):
+        patch = _crop_component(grid, coords, bg)
+        bbox = _bbox_coords(coords)
+        colors = sorted(set(map(int, patch.ravel())) - {int(bg)})
+        sprites.append(
+            {
+                "id": int(idx),
+                "coords": coords,
+                "bbox": bbox,
+                "patch": patch,
+                "area": int(coords.shape[0]),
+                "colors": colors,
+            }
