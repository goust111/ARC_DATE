+def _find_sprites(grid: np.ndarray, bg: int, frames: list[dict]) -> list[dict]:
+    outside = np.ones(grid.shape, dtype=bool)
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        outside[r0 : r1 + 1, c0 : c1 + 1] = False
