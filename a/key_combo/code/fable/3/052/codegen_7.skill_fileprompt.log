+
+def _pick_inner_dim(sprite_dim: int, min_inner: int) -> int:
+    lo = max(int(sprite_dim), int(min_inner))
+    choices = [dim for dim in range(lo, 10) if (dim - int(sprite_dim)) % 2 == 0]
