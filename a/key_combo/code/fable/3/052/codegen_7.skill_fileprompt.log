+def _is_hollow_rectangle_mask(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h < 3 or w < 3:
+        return False
+    perimeter = np.zeros((h, w), dtype=bool)
+    perimeter[0, :] = True
+    perimeter[-1, :] = True
+    perimeter[:, 0] = True
+    perimeter[:, -1] = True
