+    r0, c0, r1, c1 = _bbox_coords(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    patch[coords[:, 0] - r0, coords[:, 1] - c0] = grid[coords[:, 0], coords[:, 1]]
+    return patch
+
