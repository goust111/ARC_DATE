def check_between_objects(
    obj1: np.ndarray,
    obj2: np.ndarray,
    r: int | None = None,
    c: int | None = None,
    padding: int = 0,
    background: int = Color.BLACK,
    **kwargs,
) -> bool:
    """Check if a pixel (r,c) lies between two objects, horizontally or vertically."""
    xr, used_x = _consume_alias(kwargs, "r", ["x"])
    yc, used_y = _consume_alias(kwargs, "c", ["y"])
