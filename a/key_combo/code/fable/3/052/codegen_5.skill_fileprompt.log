+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L
+TURN_LEFT = "L"
+TURN_RIGHT = "R"
+ALL_COLORS = list(range(10))
+MAX_ATTEMPTS = 400
+END_SHAPES = [(2, 2), (2, 3), (3, 2)]
