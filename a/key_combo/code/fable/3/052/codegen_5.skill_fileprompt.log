+
+
+def _is_singleton_object_valid(
+    cell: tuple[int, int],
+    shape: tuple[int, int],
+    path_set: set[tuple[int, int]],
+    object_set: set[tuple[int, int]],
+    allowed_path_neighbor: tuple[int, int] | None,
+) -> bool:
+    if not _in_bounds(shape, cell):
+        return False
+    if cell in path_set or cell in object_set:
