+    parent = {start: None}
+    queue = [start]
+    while queue and goal not in parent:
+        cur = queue.pop(0)
+        for nb in _neighbors4(cur):
+            if nb in trail_cells and nb not in parent:
+                parent[nb] = cur
+                queue.append(nb)
