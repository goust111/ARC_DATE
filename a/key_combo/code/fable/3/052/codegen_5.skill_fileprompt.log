+    assert covered_turn_idx is not None
+
+    prefix_min = max(2 * cycle_len, corner_indices[covered_turn_idx] + 3)
+    prefix_max = len(route) - 4
+    blocked_lengths = {corner_idx + 2 for corner_idx in corner_indices}
+    candidates = [
