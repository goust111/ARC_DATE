+    side = random.choice(["top", "bottom", "left", "right"])
+    if side == "top":
+        return (0, random.randint(2, w - 3)), 2
+    if side == "bottom":
+        return (h - 1, random.randint(2, w - 3)), 0
+    if side == "left":
+        return (random.randint(2, h - 3), 0), 1
+    return (random.randint(2, h - 3), w - 1), 3
