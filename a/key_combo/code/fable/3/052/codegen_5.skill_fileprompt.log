+            route.extend(seg)
+            path_set.update(seg)
+            object_set.add(obstacle)
+            obstacle_order.append(obstacle)
+            corner_indices.append(len(route) - 1)
+            result = dfs(corner, next_dir, turn_idx + 1)
+            if result is not None:
+                return result
+
+            corner_indices.pop()
+            obstacle_order.pop()
+            object_set.remove(obstacle)
+            for _ in seg:
