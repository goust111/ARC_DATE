+        return None
+    route, obstacle_order, corner_indices, end_block, turns = route_data
+
+    if len(route) < 16:
+        return None
+
+    obstacle_map = {cell: turn_color[turn] for cell, turn in zip(obstacle_order, turns)}
+    if len(obstacle_map) != len(obstacle_order):
+        return None
+
+    covered_turn_idx = None
