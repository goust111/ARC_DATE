+    obstacle_cells: dict[tuple[int, int], int] = {}
+    end_cells: set[tuple[int, int]] = set()
+    for cell in corner_obstacles:
+        obstacle_cells[cell] = int(g[cell])
+    for comp in remaining_comps:
