+        prev = ordered[i - 1]
+        cur = ordered[i]
+        nxt = ordered[i + 1]
+        incoming = (cur[0] - prev[0], cur[1] - prev[1])
+        outgoing = (nxt[0] - cur[0], nxt[1] - cur[1])
