+    seen: set[tuple[tuple[int, ...], ...]] = set()
+    for cand in raw:
+        if swap_dims is not None and ((cand.shape != mask.shape) != bool(swap_dims)):
+            continue
+        key = _mask_key(cand)
+        if key in seen:
+            continue
+        seen.add(key)
+        variants.append(cand.astype(bool, copy=True))
+    return variants
