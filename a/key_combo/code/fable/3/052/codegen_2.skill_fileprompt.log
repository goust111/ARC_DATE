+def _random_transform(mask: np.ndarray, rng: random.Random, swap_dims: bool | None = None) -> np.ndarray:
+    variants = _transform_variants(mask, swap_dims=swap_dims)
+    assert variants
+    return variants[rng.randrange(len(variants))].copy()
