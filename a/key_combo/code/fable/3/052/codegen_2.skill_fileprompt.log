+    r0 = max(0, int(r) - 1)
+    c0 = max(0, int(c) - 1)
+    r1 = min(reserved.shape[0], int(r) + int(h) + 1)
+    c1 = min(reserved.shape[1], int(c) + int(w) + 1)
+    reserved[r0:r1, c0:c1] = True
+
