+def _step_between(
+    start: tuple[int, int], end: tuple[int, int]
+) -> tuple[int, int]:
+    span = max(abs(end[0] - start[0]), abs(end[1] - start[1])) + 1
+    if span == 1:
+        return 0, 0
+    return (
+        (end[0] - start[0]) // (span - 1),
+        (end[1] - start[1]) // (span - 1),
+    )
