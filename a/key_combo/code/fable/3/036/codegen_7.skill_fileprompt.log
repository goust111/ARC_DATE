+        possible: list[str] = []
+        for candidate in ("H", "V", "D1", "D2"):
+            found = False
+            for i, a in enumerate(gray_coords):
+                for b in gray_coords[i + 1 :]:
+                    if _inclusive_span(a, b, candidate) == total_len:
+                        possible.append(candidate)
+                        found = True
