+def generate_input() -> np.ndarray:
+    generators = {
+        "H": _gen_horizontal,
+        "V": _gen_vertical,
+        "D1": _gen_d1,
+    }
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        kind = random.choice(GEN_KINDS)
+        grid = generators[kind]()
+        if grid is not None:
+            return grid
