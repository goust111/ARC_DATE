+    cols = {c for _r, c in coords}
+    diffs = {r - c for r, c in coords}
+    sums = {r + c for r, c in coords}
+    if len(rows) == 1:
+        return "H"
+    if len(cols) == 1:
+        return "V"
+    if len(diffs) == 1:
+        return "D1"
+    if len(sums) == 1:
+        return "D2"
+    return None
+
