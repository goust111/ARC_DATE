+
+
+def _reassembled_output(
+    shape: tuple[int, int],
+    bg: int,
+    grey_points: list[tuple[int, int]],
+    kind: str,
+    start: tuple[int, int],
+    fragments: list[tuple[int, int]],
+) -> np.ndarray:
