+def _raw_orientation(coords: list[tuple[int, int]]) -> str | None:
+    if len(coords) <= 1:
+        return "POINT"
+    rows = {r for r, _c in coords}
+    cols = {c for _r, c in coords}
+    diffs = {r - c for r, c in coords}
+    sums = {r + c for r, c in coords}
