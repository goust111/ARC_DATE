+
+def _choose_spaced_values(values: list[int], count: int, gap: int) -> list[int] | None:
+    if len(values) < count:
+        return None
+    for _ in range(200):
+        sample = sorted(random.sample(values, count))
+        if all(b - a >= gap for a, b in zip(sample, sample[1:])):
+            return sample
+    return None
