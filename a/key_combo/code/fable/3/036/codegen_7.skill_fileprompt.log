+    out = _reassembled_output(
+        inp.shape,
+        bg,
+        grey_points,
+        "D1",
+        (start_r, start_c),
+        [(length, color) for length, color, _line in ordered_fragments],
+    )
+    return _oracle_checked_input(inp, out)
+
+
+def generate_input() -> np.ndarray:
