+    gray_coords = _color_coords(g, GREY)
+    fragment_lines = {int(frag["line"]) for frag in fragments}
+    candidates: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for i, a in enumerate(gray_coords):
+        for b in gray_coords[i + 1 :]:
