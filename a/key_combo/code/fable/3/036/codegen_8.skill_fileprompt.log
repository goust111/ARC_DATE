+    cells = {start}
+    frontier = {start}
+    while len(cells) < target_count and frontier:
+        base = tuple(list(frontier)[int(rng.integers(len(frontier)))])
+        options: list[tuple[int, int]] = []
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
