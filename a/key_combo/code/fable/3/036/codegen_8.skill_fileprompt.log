+RED = 2
+GEN_ATTEMPTS = 800
+GEN_BG_CANDIDATES = [0, 1, 3, 4, 5, 6, 7, 8, 9]
+GEN_MOTIF_COLORS = [0, 1, 3, 4, 5, 6, 7, 8, 9]
