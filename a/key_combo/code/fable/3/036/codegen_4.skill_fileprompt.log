+            _v_len, v_gap = v_option
+            if branch == "tie" and h_gap == v_gap:
+                pairs.append((h_option, v_option))
+            elif branch == "horizontal_wins" and h_gap < v_gap:
+                pairs.append((h_option, v_option))
+            elif branch == "vertical_wins" and v_gap < h_gap:
+                pairs.append((h_option, v_option))
