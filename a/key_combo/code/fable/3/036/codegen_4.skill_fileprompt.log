+                    "r": seg["row"],
+                    "c": seg["c1"],
+                    "dr": 0,
+                    "dc": 1,
+                    "color": seg["color"],
+                    "active": seg["c1"] < width - 1,
+                }
+            )
+        else:
+            endpoints.append(
+                {
+                    "r": seg["r0"],
+                    "c": seg["col"],
+                    "dr": -1,
+                    "dc": 0,
+                    "color": seg["color"],
+                    "active": seg["r0"] > 0,
+                }
+            )
+            endpoints.append(
+                {
+                    "r": seg["r1"],
+                    "c": seg["col"],
+                    "dr": 1,
+                    "dc": 0,
+                    "color": seg["color"],
+                    "active": seg["r1"] < height - 1,
+                }
+            )
+    return endpoints
+
