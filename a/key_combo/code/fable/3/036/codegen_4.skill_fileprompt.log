+import random
+from collections import Counter
+from typing import Iterable
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+INPUT_COLORS = (
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.GREY,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+)
+BRANCH_SEQUENCE = ("tie", "horizontal_wins", "vertical_wins")
+COUNT_OPTIONS = (
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (2, 2),
+    (1, 3),
+    (3, 1),
+    (2, 3),
+    (3, 2),
+)
+SIZE_RANGE = (18, 24)
+OUTER_MARGIN = 5
+ROW_COL_GAP = 3
+LINE_LENGTHS = (2, 3, 4)
+MAX_START_GAP = 4
+GENERATION_RETRIES = 300
+_GEN_CALL_COUNT = 0
