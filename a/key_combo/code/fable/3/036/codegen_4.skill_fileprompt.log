+    if int(out[row, col]) != v_color:
+        return False
+    if int(out[_forced_prev_cell(row, col, h_side, "H")]) != h_color:
+        return False
+    if int(out[_forced_next_cell(row, col, v_side, "V")]) != v_color:
+        return False
+    return True
