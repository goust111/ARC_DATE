+            i, j, orientation = edges[edge_index]
+            other = j if i == start else i
+            if used[other]:
+                continue
+            used[start] = True
+            used[other] = True
+            current.append((start, other, orientation))
+            dfs(current)
+            current.pop()
+            used[start] = False
+            used[other] = False
