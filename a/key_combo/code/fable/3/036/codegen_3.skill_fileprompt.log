+def _horizontal_candidate(grid: np.ndarray, bg: int, a: dict, b: dict) -> bool:
+    ar0, ac0, ar1, ac1 = map(int, a["bbox"])
+    br0, bc0, br1, bc1 = map(int, b["bbox"])
+    if (ar0, ar1) != (br0, br1):
