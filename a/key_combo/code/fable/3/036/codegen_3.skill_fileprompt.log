+            sum(heights[:idx]) + sum(gaps[: idx + 1]),
+            sum(heights[: idx + 1]) + sum(gaps[: idx + 1]) - 1,
+        )
+        for idx in range(pair_count)
+    ]
+
+
+def _gen_attempt() -> np.ndarray | None:
