+
+def _solve_latin_unique(partial: np.ndarray, colors: list[int]) -> np.ndarray:
+    solutions = _latin_solutions(partial, colors, limit=2)
+    assert len(solutions) == 1, "compressed table must have a unique Latin completion"
+    return solutions[0]
