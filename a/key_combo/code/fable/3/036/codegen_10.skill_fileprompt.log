+            row_vals = {int(v) for v in grid[r] if int(v) >= 0}
+            for c in range(n):
+                if int(grid[r, c]) >= 0:
+                    continue
+                col_vals = {int(v) for v in grid[:, c] if int(v) >= 0}
+                cands = [color for color in color_list if color not in row_vals and color not in col_vals]
+                if not cands:
+                    return
