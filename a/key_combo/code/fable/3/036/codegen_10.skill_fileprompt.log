+    for comp in _find_components(grid, bg):
+        box = comp["bbox"]
+        height = _bbox_h(box)
+        width = _bbox_w(box)
+        color = int(comp["color"])
+        if height < 3 or width < 3:
+            continue
+        if int(comp["area"]) != height * width:
