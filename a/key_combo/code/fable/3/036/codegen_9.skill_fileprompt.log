+    bottom = random.randint(*RECT_EXTENT_RANGE)
+    left = random.randint(*RECT_EXTENT_RANGE)
+    right = random.randint(*RECT_EXTENT_RANGE)
+
+    rect_h = top + 1 + bottom
+    rect_w = left + 1 + right
+    counts = _candidate_counts(top, bottom, left, right)
