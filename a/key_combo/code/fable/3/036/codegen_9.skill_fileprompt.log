+    rect_bbox: tuple[int, int, int, int],
+    cross: tuple[int, int],
+    colors: tuple[int, int, int, int],
+) -> np.ndarray:
+    r0, c0, r1, c1 = rect_bbox
+    r, c = cross
+    tl, tr, bl, br = colors
+
+    out = np.full(shape, BLACK, dtype=int)
+    out[r0:r, c0:c] = tl
+    out[r0:r, c + 1 : c1 + 1] = tr
+    out[r + 1 : r1 + 1, c0:c] = bl
+    out[r + 1 : r1 + 1, c + 1 : c1 + 1] = br
+    out[r, c0 : c1 + 1] = PINK
+    out[r0 : r1 + 1, c] = PINK
