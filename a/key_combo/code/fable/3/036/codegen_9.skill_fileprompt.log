+        mask = _normalize(coords)
+        for _ in range(random.randrange(4)):
+            mask = np.rot90(mask)
+        if random.random() < 0.5:
+            mask = np.flipud(mask)
+        if random.random() < 0.5:
+            mask = np.fliplr(mask)
+        if mask.shape[0] <= max_h and mask.shape[1] <= max_w:
+            return mask.copy()
+    return None
+
