+        return None
+    if len(interior_colors) < min(2, len(palette_colors)):
+        return None
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
