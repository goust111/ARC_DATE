+        chosen.append((r, c))
+        r0 = max(0, r - 1)
+        r1 = min(shape[0] - 1, r + 1)
+        c0 = max(0, c - 1)
+        c1 = min(shape[1] - 1, c + 1)
+        blocked[r0 : r1 + 1, c0 : c1 + 1] = True
