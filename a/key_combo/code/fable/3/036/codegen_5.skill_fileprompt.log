+Color = int
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, grid.flatten()))
+    if exclude is not None:
+        colors -= set(exclude)
+    return sorted(colors)
+
+
+def bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def clipped_frame_mask(shape: tuple[int, int], box: BBox) -> np.ndarray:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    mask = np.zeros(shape, dtype=bool)
+    if r0 > r1 or c0 > c1:
+        return mask
+
+    clip_c0 = max(0, c0)
+    clip_c1 = min(w - 1, c1)
+    if clip_c0 <= clip_c1:
+        if 0 <= r0 < h:
+            mask[r0, clip_c0 : clip_c1 + 1] = True
+        if 0 <= r1 < h:
+            mask[r1, clip_c0 : clip_c1 + 1] = True
+
+    clip_r0 = max(0, r0)
+    clip_r1 = min(h - 1, r1)
+    if clip_r0 <= clip_r1:
+        if 0 <= c0 < w:
+            mask[clip_r0 : clip_r1 + 1, c0] = True
+        if 0 <= c1 < w:
+            mask[clip_r0 : clip_r1 + 1, c1] = True
+    return mask
+
+
+def visible_interior_mask(shape: tuple[int, int], box: BBox) -> np.ndarray:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    mask = np.zeros(shape, dtype=bool)
+    rr0 = max(0, r0 + 1)
+    rr1 = min(h - 1, r1 - 1)
+    cc0 = max(0, c0 + 1)
+    cc1 = min(w - 1, c1 - 1)
+    if rr0 <= rr1 and cc0 <= cc1:
+        mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+    return mask
+
+
+def is_full_rect_frame(shape: tuple[int, int], coords: np.ndarray) -> bool:
+    box = bbox_coords(coords)
+    r0, c0, r1, c1 = box
+    if r0 < 0 or c0 < 0 or r1 >= shape[0] or c1 >= shape[1]:
