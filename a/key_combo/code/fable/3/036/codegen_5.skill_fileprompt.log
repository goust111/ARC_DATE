+def order_arithmetic_boxes(boxes: list[BBox]) -> tuple[list[BBox], BBox]:
+    assert len(boxes) >= 2
+    for perm in itertools.permutations(range(len(boxes))):
+        seq = [boxes[i] for i in perm]
+        step = diff_box(seq[0], seq[1])
+        if step == (0, 0, 0, 0):
+            continue
