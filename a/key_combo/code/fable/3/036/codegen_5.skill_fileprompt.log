+
+
+def _draw_frames(shape: tuple[int, int], boxes: list[BBox], color: int) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for box in boxes:
+        grid[clipped_frame_mask(shape, box)] = color
