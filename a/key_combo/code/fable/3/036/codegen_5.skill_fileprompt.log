+
+def add_box(box: BBox, step: BBox, sign: int = 1) -> BBox:
+    return tuple(int(box[i] + sign * step[i]) for i in range(4))
+
+
+def diff_box(a: BBox, b: BBox) -> BBox:
+    return tuple(int(b[i] - a[i]) for i in range(4))
