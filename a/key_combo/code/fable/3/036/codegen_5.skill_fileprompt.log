+
+    min_r = max(0, -(n - 1) * dr)
+    max_r = min(hh - h, hh - h - (n - 1) * dr)
+    min_c = max(0, -(n - 1) * dc)
+    max_c = min(ww - w, ww - w - (n - 1) * dc)
+    if min_r > max_r or min_c > max_c:
