+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != target_area:
+            continue
+
+        rel = {(r - ar, c - ac) for r, c in cells}
+        rows = {dr for dr, _dc in rel}
+        cols = {dc for _dr, dc in rel}
+        if len(rows) < 2 or len(cols) < 2:
+            continue
+        if len(rel) == h * w:
+            continue
+        return rel
+    return None
