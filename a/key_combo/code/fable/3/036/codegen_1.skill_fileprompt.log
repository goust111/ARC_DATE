+
+def _boundary_candidates(template: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    rows = [dr for dr, _dc in template]
+    cols = [dc for _dr, dc in template]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    candidates = set()
