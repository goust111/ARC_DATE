+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+TEAL = 8
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIZE_RANGE = (18, 30)
+OBJECT_COUNT_RANGE = (2, 4)
