+        left_c0 = extra_left + dc
+    else:
+        left_c0 = extra_left
+        right_c0 = extra_left - dc
+
+    left_full = source[left_r0 : left_r0 + panel_h, left_c0 : left_c0 + panel_w].copy()
+    right_full = source[right_r0 : right_r0 + panel_h, right_c0 : right_c0 + panel_w].copy()
