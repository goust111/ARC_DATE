+    right_view = right[right_slice]
+    hole_mask = left_view == GREY
+    left_view[hole_mask] = right_view[hole_mask]
+    out[left_slice] = left_view
+
+    assert not np.any(out == GREY), "all left-panel holes must be repairable"
