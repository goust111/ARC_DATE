+
+    if random.random() < 0.7:
+        color = random.choice(palette)
+        if random.random() < 0.5:
+            row = random.randrange(height)
+            c0 = random.randint(0, width - 3)
+            c1 = random.randint(c0 + 2, width - 1)
+            grid[row, c0 : c1 + 1] = color
+        else:
+            col = random.randrange(width)
