+
+def _count_components(mask: np.ndarray) -> int:
+    seen = np.zeros_like(mask, dtype=bool)
+    height, width = map(int, mask.shape)
+    components = 0
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            components += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return components
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    grown = mask.copy()
+    grown[1:, :] |= mask[:-1, :]
+    grown[:-1, :] |= mask[1:, :]
+    grown[:, 1:] |= mask[:, :-1]
+    grown[:, :-1] |= mask[:, 1:]
+    return grown
+
+
+def _axis_error(grid: np.ndarray, axis: int, period: int) -> float:
+    if axis == 0:
+        if period >= grid.shape[0]:
+            return 1.0
+        return float(np.mean(grid[period:, :] != grid[:-period, :]))
+    if period >= grid.shape[1]:
+        return 1.0
+    return float(np.mean(grid[:, period:] != grid[:, :-period]))
+
+
+def _reconstruct_wallpaper(grid: np.ndarray, tile_h: int, tile_w: int) -> tuple[np.ndarray, np.ndarray]:
+    height, width = map(int, grid.shape)
