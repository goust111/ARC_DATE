+def _axis_error(grid: np.ndarray, axis: int, period: int) -> float:
+    if axis == 0:
+        if period >= grid.shape[0]:
+            return 1.0
+        return float(np.mean(grid[period:, :] != grid[:-period, :]))
+    if period >= grid.shape[1]:
+        return 1.0
+    return float(np.mean(grid[:, period:] != grid[:, :-period]))
