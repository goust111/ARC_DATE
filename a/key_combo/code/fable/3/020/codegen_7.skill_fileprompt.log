13: def main(input_grid):
14:     """
15:     Color selected divider-bounded regions by their relative positions.
16: 
17:     Input structure:
18:     - Gray lines partition a black canvas into multiple regions.
19:     - At least three non-gray regions are present.
20:     - Regions are selected by upper-left, middle, and lower-right position.
21: 
22:     Rule:
23:     - Treat gray as the divider color and find connected regions between dividers.
24:     - Fill the upper-left region blue and the lower-right region green.
25:     - Fill the middle positional candidate red while leaving dividers unchanged.
26: 
27:     Key insight:
28:     - The regions are not identified by shape; their sorted positions determine their colors.
29:     """
30:     divider = Color.GREY
31:     regions = find_components(input_grid, bg=divider, connectivity=4, monochromatic=False, return_format="objects")
32: 
33:     bbs = []
34:     for obj in regions:
35:         b = bbox(obj != divider)
36:         if b is not None:
37:             bbs.append(b)
38:     assert len(bbs) >= 3
39: 
40:     # Choose TL, BR, and "middle" by position.
41:     bbs_sorted = sorted(bbs, key=lambda b: (b[0], b[1]))
42:     tl = bbs_sorted[0]
43:     br = max(bbs_sorted, key=lambda b: (b[0] + b[1]))
44:     mid_candidates = [b for b in bbs_sorted if b not in (tl, br)]
45:     mid = mid_candidates[len(mid_candidates) // 2]
46: 
47:     out = input_grid.copy()
48:     for b, color in [(tl, Color.BLUE), (mid, Color.RED), (br, Color.GREEN)]:
49:         r0, c0, r1, c1 = b
50:         out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
51:     return out
52: 
