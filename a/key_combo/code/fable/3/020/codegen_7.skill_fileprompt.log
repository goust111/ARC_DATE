8: def main(grid: np.ndarray) -> np.ndarray:
9:     """
10:     Paint a teal diamond envelope around each straight foreground bar.
11: 
12:     Input structure
13:     - The grid has a single background color and one non-background foreground color.
14:     - Every foreground object is a solid horizontal or vertical one-cell-thick bar.
15:     - Teal is absent from the input and is reserved for the added envelope pixels.
16: 
17:     Rule
18:     - Keep every original foreground bar unchanged.
19:     - For a horizontal bar, paint teal rows above and below it; each step away from the bar shortens the interval by one pixel at both ends.
20:     - For a vertical bar, apply the same shrinking construction rotated ninety degrees.
21: 
22:     Key insight
23:     - A bar of length L defines a centered diamond of radius floor((L - 1) / 2), with the original bar forming the middle line and teal filling only the surrounding background cells.
24:     """
25:     g = np.asarray(grid, dtype=int)
26:     assert g.ndim == 2, "expected a 2D grid"
27: 
28:     bg = get_bg(g)
29:     colors = colors_present(g, exclude={bg})
30:     assert len(colors) == 1, "expected exactly one foreground color"
31:     bar_color = colors[0]
32:     fill_color = Color.TEAL
33:     assert fill_color != bg and fill_color != bar_color, "teal must be a new output color"
34:     assert not np.any(g == fill_color), "teal must not appear in the input"
35: 
36:     out = g.copy()
37:     height, width = map(int, g.shape)
38:     bars = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[bar_color])
39:     assert bars, "expected at least one foreground bar"
40: 
41:     for bar in bars:
42:         r0, c0, r1, c1 = bar["bbox"]
43:         h = int(r1 - r0 + 1)
44:         w = int(c1 - c0 + 1)
45:         area = int(bar["area"])
46:         assert area == h * w, "foreground bar must be solid"
47:         assert h == 1 or w == 1, "foreground object must be a straight bar"
48: 
49:         length = max(h, w)
50:         radius = (length - 1) // 2
51:         assert radius >= 1, "bar must be long enough to form an envelope"
52: 
53:         if h == 1:
54:             row = int(r0)
55:             for offset in range(1, radius + 1):
56:                 left = int(c0 + offset)
57:                 right = int(c1 - offset)
58:                 assert 0 <= left <= right < width, "horizontal envelope interval must stay in bounds"
59:                 for rr in (row - offset, row + offset):
60:                     assert 0 <= rr < height, "horizontal envelope row must stay in bounds"
61:                     view = out[rr, left : right + 1]
62:                     view[view == bg] = fill_color
63:         else:
64:             col = int(c0)
65:             for offset in range(1, radius + 1):
66:                 top = int(r0 + offset)
67:                 bottom = int(r1 - offset)
68:                 assert 0 <= top <= bottom < height, "vertical envelope interval must stay in bounds"
69:                 for cc in (col - offset, col + offset):
70:                     assert 0 <= cc < width, "vertical envelope column must stay in bounds"
71:                     view = out[top : bottom + 1, cc]
72:                     view[view == bg] = fill_color
73: 
74:     return out
