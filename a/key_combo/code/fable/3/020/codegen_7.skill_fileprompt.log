57:     n, m = grid_len, grid_len
58:     grid = np.zeros((m, n), dtype=int)
59: 
60:     # Get the number of horizontal and vertical lines
61:     # Keep line counts modest so `randomly_spaced_indices` is always feasible.
62:     line_nums = [2, 3]
63:     line_num = np.random.choice(line_nums)
64: 
65:     # Generate the gray lines' positions with interval between each line to form several rectangles
66:     # If padding is True, the lines will be padded with 1 grid on both sides
67:     vertical_lines = randomly_spaced_indices(max_len=n, n_indices=line_num, border_size=1, padding=3)
68:     horizontal_lines = randomly_spaced_indices(max_len=m, n_indices=line_num, border_size=1, padding=2)
69: 
70:     # Draw the gray vertical and horizontal lines on the grid
71:     for c in vertical_lines:
72:         draw_line(grid=grid, r=0, c=int(c), direction=(1, 0), color=Color.GRAY)
73:     
74:     for r in horizontal_lines:
75:         draw_line(grid=grid, r=int(r), c=0, direction=(0, 1), color=Color.GRAY)
