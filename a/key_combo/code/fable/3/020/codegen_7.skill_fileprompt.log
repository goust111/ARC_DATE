6: def main(grid: np.ndarray) -> np.ndarray:
7:     """Repeat the foreground row band vertically to fill the whole grid.
8: 
9:     Input structure
10:     - The input is a 2D grid with a background color and one contiguous horizontal
11:       band of rows containing all non-background pixels.
12:     - Rows outside that band are entirely background.
13: 
14:     Rule
15:     - Use the full-width foreground band as a vertical tile.
16:     - Repeat that tile upward and downward over the original canvas, keeping the
17:       original band row aligned with its input row position.
18: 
19:     Key insight
20:     - The sparse input is a phase marker for a vertical row pattern, not a set of
21:       separate objects to move or recolor.
22:     """
23:     g = np.asarray(grid, dtype=int)
24:     assert g.ndim == 2, "input must be a 2D grid"
25: 
26:     bg = int(get_bg(g))
27:     active_rows = np.any(g != bg, axis=1)
28:     rows = np.flatnonzero(active_rows)
29:     assert rows.size > 0, "grid must contain a foreground row band"
30: 
31:     r0 = int(rows[0])
32:     r1 = int(rows[-1])
33:     assert np.array_equal(rows, np.arange(r0, r1 + 1)), "foreground rows must form one contiguous band"
34:     assert np.all(g[:r0] == bg) and np.all(g[r1 + 1 :] == bg), "rows outside the band must be background"
35: 
36:     tile = g[r0 : r1 + 1, :]
37:     tile_h = tile.shape[0]
38:     row_indices = (np.arange(g.shape[0]) - r0) % tile_h
39:     return tile[row_indices].copy()
