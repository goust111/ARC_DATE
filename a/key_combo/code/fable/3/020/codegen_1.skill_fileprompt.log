14:def main(input_grid):
15:    """
16:    Compress nested colored shapes into a small nested-square color summary.
17:
18:    Input structure:
19:    - The input contains nested monochromatic non-black shapes on a black background.
20:    - Outer layers have larger bounding boxes than inner layers.
21:    - Each layer has a distinct color.
22:
23:    Rule:
24:    - Detect the colored objects and sort them from largest bounding box to smallest.
25:    - Create a square output with one ring per detected layer.
26:    - Fill nested squares from outermost to innermost using the corresponding layer colors.
27:
28:    Key insight:
29:    - The output preserves only nesting order and colors; geometric details of the
30:      original shapes are reduced to one-pixel-thick square layers.
31:    """
32:    # Plan:
33:    # 1. Parse the input into objects and order them from outermost to innermost by area
34:    # 2. Draw nested rectangles with the colors of the input objects, each layer has only one pixel length
35:
36:    # 1. input parsing
37:    # Find the objects in the input grid
38:    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
39:
40:    # Sort the objects from outermost to innermost, using area to determine the order
41:    def _area(o: np.ndarray) -> int:
42:        b = bbox(o != Color.BLACK)
43:        if b is None:
44:            return 0
45:        r0, c0, r1, c1 = b
46:        return (r1 - r0 + 1) * (c1 - c0 + 1)
47:
48:    objects.sort(key=_area, reverse=True)
49:
50:    # 2. drawing the output
51:    # Leave only one layer of each color shape
52:    grid_len = len(objects) * 2 - 1
53:    output_grid = np.full((grid_len, grid_len), Color.BLACK)
54:
55:    # Calculate each layer's length, which starts at the outermost layer
56:    current_len = grid_len
57:
58:    # Draw nested shapes with the colors of the input objects. Each layer has only one pixel length of the current color
59:    for i, obj in enumerate(objects):
60:        # Get the color of the current layer
61:        cols = set(map(int, np.unique(obj))) - {Color.BLACK}
62:        assert cols
63:        color = next(iter(cols))
64:        # Fill the region with the current color
65:        cur_shape = np.full((current_len, current_len), color)
66:        # Place the current shape in the output grid
67:        # Make sure each layer has only one pixel length of the current color
68:        output_grid = paste(output_grid, cur_shape, i, i)
69:        current_len -= 2
70:
71:    return output_grid
