29:def main(input_grid):
30:    """
31:    Repeat a black template object outward in the color and direction of its touching indicator.
32:
33:    Input structure:
34:    - The grid has a non-black background.
35:    - A black template object touches one or more single-pixel indicator objects.
36:    - Each indicator color is different from the background.
37:
38:    Rule:
39:    - Detect the background, template objects, and one-pixel indicators.
40:    - For each touching template-indicator pair, infer the direction from template center to indicator.
41:    - Recolor the template to the indicator color and paste repeated translated copies outward.
42:
43:    Key insight:
44:    - The indicator acts as both a color label and a direction handle for repeated
45:      translation of the same template shape.
46:    """
47:    # Plan:
48:    # 1. Parse the input into the black object and the indicator pixel(s)
49:    # 2. Determine the direction of translation
50:    # 3. Put down recolored versions of the black object
51:
52:    # 1. Parse the input
53:    # Background is the most common color.
54:    bg = get_bg(input_grid)
55:
56:    # Extract connected components (as full-grid objects).
57:    objects = find_components(input_grid, bg=bg, connectivity=8, monochromatic=True, return_format="objects")
58:
59:    # Indicators are single-pixel objects.
60:    indicator_objects = [obj for obj in objects if int((obj != bg).sum()) == 1]
61:
62:    # Templates are larger objects.
63:    template_objects = [obj for obj in objects if int((obj != bg).sum()) != 1]
64:
65:    # We draw on top of the output, so copy it
66:    output_grid = input_grid.copy()
67:
68:    # Iterate over every template and indicator which are in contact
69:    for template_obj in template_objects:
70:        b_template = bbox(template_obj != bg)
71:        assert b_template is not None
72:        template_sprite = crop_bbox(template_obj, b_template)
73:        for indicator_obj in indicator_objects:
74:            if not contact(object1=template_obj, object2=indicator_obj, background=bg, connectivity=8):
75:                continue
76:
77:            # 2. Determine the direction of translation
78:            b_ind = bbox(indicator_obj != bg)
79:            assert b_ind is not None
80:            ind_r, ind_c = bbox_anchor(b_ind, anchor="center")
81:            tpl_r, tpl_c = bbox_anchor(b_template, anchor="center")
82:
83:            dr = int(np.sign(ind_r - tpl_r))
84:            dc = int(np.sign(ind_c - tpl_c))
85:            # Figure out the stride the translation, which is as far as we can go while still covering the indicator pixel
86:            possible_strides = [
87:                stride
88:                for stride in range(1, max(output_grid.shape))
89:                if collision(
90:                    object1=indicator_obj,
91:                    object2=template_obj,
92:                    r2=stride * dr,
93:                    c2=stride * dc,
94:                    background=bg,
95:                )
96:            ]
97:            stride = max(possible_strides)
98:
99:            # 3. Put down recolored versions of the black object as much as we can until we fall out of the canvas
100:            # Prepare a new version of the sprite
101:            new_color = colors_present(indicator_obj, exclude={bg})[0]
102:            recolored_template_sprite = template_sprite.copy()
103:            recolored_template_sprite[recolored_template_sprite != bg] = new_color
104:
105:            # Put down the recolored sprite at every stride
106:            for i in range(1, 10):
107:                old_r, old_c = bbox_anchor(b_template, anchor="upper left")
108:                new_r = old_r + i * dr * stride
109:                new_c = old_c + i * dc * stride
