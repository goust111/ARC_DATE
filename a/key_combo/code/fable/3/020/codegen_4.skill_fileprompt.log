+
+def _make_lock_patch(hole_mask: np.ndarray, color: int) -> tuple[np.ndarray, np.ndarray]:
+    h, w = hole_mask.shape
+    top = random.randint(1, 2)
+    bottom = random.randint(1, 2)
+    left = random.randint(1, 2)
+    right = random.randint(1, 2)
