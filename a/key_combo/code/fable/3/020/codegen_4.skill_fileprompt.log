+def _random_connected_mask(*, exact_area: int | None = None) -> np.ndarray | None:
+    for _ in range(120):
+        if exact_area is None:
+            h = random.randint(3, 6)
+            w = random.randint(4, 6)
+            lo = max(5, (h * w + 2) // 3)
+            hi = max(lo, min(h * w - 1, (2 * h * w) // 3 + 1))
