+        while int(mask.sum()) < area and frontier:
+            choices = list(frontier)
+            weights = []
+            for r, c in choices:
+                touch = sum(
+                    0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc] for dr, dc in NEIGHBORS4
+                )
+                weights.append(1 + touch * touch)
+            r, c = random.choices(choices, weights=weights, k=1)[0]
