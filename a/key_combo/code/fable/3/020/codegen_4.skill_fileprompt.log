    if coords.size == 0:
        return []
    r0, c0, r1, c1 = bbox_coords(coords)
    obj = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    obj[coords[:, 0] - r0, coords[:, 1] - c0] = True

    padded = np.pad(obj, 1, constant_values=False)
    h, w = padded.shape
    sizes = []
