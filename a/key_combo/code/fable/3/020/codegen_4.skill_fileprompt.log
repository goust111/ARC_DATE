+    divider_cols = [i * (w + 1) for i in range(n + 1)]
+    band[:, divider_cols] = GREY
+    for i, piece in enumerate(piece_masks):
+        c0 = divider_cols[i] + 1
+        band[:, c0 : c0 + w][piece] = fragment_color
+    return band
+
