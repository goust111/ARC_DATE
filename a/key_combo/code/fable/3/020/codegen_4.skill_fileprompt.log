+def _split_fragments(key_mask: np.ndarray, n_parts: int) -> list[np.ndarray] | None:
+    area = int(key_mask.sum())
+    for _ in range(120):
+        parts: list[np.ndarray] = []
+        for _part in range(n_parts):
+            omit_size = random.randint(max(1, area // 4), max(1, area // 2))
