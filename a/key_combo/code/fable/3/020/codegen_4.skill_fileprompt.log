+    for r, c in chosen:
+        out[r, c] = True
+    return out
+
+
+def _neighbors_in_mask(cell: tuple[int, int], mask: np.ndarray) -> list[tuple[int, int]]:
+    r, c = cell
+    out = []
+    for dr, dc in NEIGHBORS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
