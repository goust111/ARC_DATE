+    assert len(fragment_colors) == 1
+    fragment_color = fragment_colors[0]
+
+    piece_masks: list[np.ndarray] = []
+    widths: list[int] = []
+    for left, right in zip(divider_cols, divider_cols[1:]):
+        if right - left <= 1:
+            continue
