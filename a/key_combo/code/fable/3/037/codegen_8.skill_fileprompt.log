+        color = marker_colors[marker_idx]
+        if side == "top":
+            grid[:rect_h, c0 : c1 + 1] = color
+        else:
+            grid[height - rect_h :, c0 : c1 + 1] = color
+
+    out = main(grid)
+    if np.array_equal(out, grid):
