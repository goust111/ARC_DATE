+
+def _parse_marker(coords: np.ndarray) -> dict[str, int] | None:
+    if int(coords.shape[0]) != 4:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if (r1 - r0 + 1, c1 - c0 + 1) != (2, 3):
+        return None
