+    rel = {(int(r - r0), int(c - c0)) for r, c in coords}
+    control_above = {(0, 1), (1, 0), (1, 1), (1, 2)}
+    control_below = {(0, 0), (0, 1), (0, 2), (1, 1)}
+    mid_col = c0 + 1
+    if rel == control_above:
