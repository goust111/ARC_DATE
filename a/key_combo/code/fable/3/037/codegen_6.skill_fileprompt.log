        bottom_c0, bottom_c1 = _contiguous_span(np.flatnonzero(mask[r1, :]))
        left_r0, left_r1 = _contiguous_span(np.flatnonzero(mask[:, c0]))
        right_r0, right_r1 = _contiguous_span(np.flatnonzero(mask[:, c1]))

