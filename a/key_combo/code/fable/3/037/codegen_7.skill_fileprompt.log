TEAL = 8

GEN_RETRY_LIMIT = 200


def _extract_valid_segments(grid: np.ndarray) -> list[np.ndarray]:
    segments: list[np.ndarray] = []
    segment_width = None

    for row in grid:
        blue_cols = np.flatnonzero(row == BLUE)
        teal_cols = np.flatnonzero(row == TEAL)
        if blue_cols.size != 1 or teal_cols.size != 1:
