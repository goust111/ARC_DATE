+    cuts_b = _sample_cuts(feature_b)
+    bins_a = np.digitize(feature_a, cuts_a)
+    bins_b = np.digitize(feature_b, cuts_b)
+    table = _color_table(len(cuts_a) + 1, len(cuts_b) + 1, palette)
