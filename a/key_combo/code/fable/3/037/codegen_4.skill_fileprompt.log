+
+@lru_cache(maxsize=None)
+def _all_orbits(n: int) -> tuple[tuple[tuple[int, int], ...], ...]:
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(n):
+        for c in range(n):
+            orbit = _d4_orbit(n, r, c)
+            if orbit not in seen:
+                seen.add(orbit)
+                orbits.append(orbit)
+    return tuple(orbits)
+
