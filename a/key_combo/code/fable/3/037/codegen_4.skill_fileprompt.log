+def _d4_orbit(n: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    last = n - 1
+    pts = {
+        (r, c),
+        (r, last - c),
+        (last - r, c),
+        (last - r, last - c),
+        (c, r),
+        (c, last - r),
+        (last - c, r),
+        (last - c, last - r),
+    }
+    return tuple(sorted(pts))
