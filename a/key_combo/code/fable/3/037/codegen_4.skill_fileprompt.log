+    rr, cc = np.indices((n, n))
+    edge = np.minimum.reduce([rr, cc, n - 1 - rr, n - 1 - cc])
+    diag = np.minimum(np.abs(rr - cc), np.abs(rr + cc - (n - 1)))
+    dr2 = np.abs(2 * rr - (n - 1))
+    dc2 = np.abs(2 * cc - (n - 1))
+    radius = np.maximum(dr2, dc2)
+    diamond = dr2 + dc2
+    return edge, diag, radius, diamond
