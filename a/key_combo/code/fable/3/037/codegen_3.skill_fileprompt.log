+        top += dr
+        left += dc
+        moved = True
+
+
+def _transform(grid: np.ndarray, *, return_trace: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    sprites, wall_coords, control, current = _parse_scene(g)
+    order: list[int] = []
+    reasons: list[str] = []
+    seen: set[int] = set()
