+
+def _cells_from_patch(patch: np.ndarray) -> list[tuple[int, int, int]]:
+    rr, cc = np.nonzero(patch != BG)
+    vals = patch[rr, cc]
+    return [(int(r), int(c), int(v)) for r, c, v in zip(rr, cc, vals)]
