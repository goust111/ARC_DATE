+    if direction == (1, 0):
+        return h - 1, w // 2
+    if direction == (0, -1):
+        return h // 2, 0
+    assert direction == (0, 1)
+    return h // 2, w - 1
+
+
+def _make_sprite(direction: tuple[int, int], body_color: int, marker_color: int) -> dict:
