+        assert current not in seen, "collision chain must not cycle"
+        seen.add(current)
+        order.append(current)
+        blocker, reason = _slide_sprite(current, sprites, wall_coords, g.shape)
+        reasons.append(reason)
+        if blocker is None:
+            break
+        current = blocker
