+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 8
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 9]
+GEN_ATTEMPTS = 500
+PLACEMENT_ATTEMPTS = 120
