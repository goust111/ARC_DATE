+    directions: list[tuple[int, int]] = []
+    if w % 2 == 1 and (marker_r, marker_c) == (r0, c0 + w // 2):
+        directions.append((-1, 0))
+    if w % 2 == 1 and (marker_r, marker_c) == (r1, c0 + w // 2):
+        directions.append((1, 0))
