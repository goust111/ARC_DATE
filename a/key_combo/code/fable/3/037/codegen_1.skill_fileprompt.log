+                out[r, hit_c + 1 : c] = control_color
+                hits.append((r, hit_c, 1))
+            if right:
+                hit_c = right[0]
+                assert hit_c - c >= 2, "stamp would overlap its control pixel"
+                assert np.all(g[r, c + 1 : hit_c] == bg), "horizontal ray path must be empty"
