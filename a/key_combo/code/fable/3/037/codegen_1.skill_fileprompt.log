+
+    box_row_starts = [r0 for r0 in range(h - 4) if all(bar_r not in range(r0, r0 + 5) for bar_r in bar_rows)]
+    box_col_starts = list(range(2, w - 5))
+    if not box_row_starts or not box_col_starts:
