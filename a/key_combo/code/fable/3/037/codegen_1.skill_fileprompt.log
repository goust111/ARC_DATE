+                assert hit_r - r >= 2, "stamp would overlap its control pixel"
+                assert np.all(g[r + 1 : hit_r, c] == bg), "vertical ray path must be empty"
+                out[r + 1 : hit_r, c] = control_color
+                hits.append((hit_r, c, 0))
