+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+    bg = _get_bg(g)
+    assert bg == BG, "expected black background"
+
+    legend_bbox, sprite = _find_legend(g, bg)
