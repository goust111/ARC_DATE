import hashlib
import random
from collections import Counter
import numpy as np

BG = 0
BOX = 5
SIDE_TO_POS = {0: (0, 1), 1: (1, 2), 2: (2, 1), 3: (1, 0)}
POS_TO_SIDE = {v: k for k, v in SIDE_TO_POS.items()}


def get_bg(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])


def components(mask):
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            out.append(np.array(coords, dtype=int))
    return out


def bbox(coords):
    return tuple(map(int, (coords[:, 0].min(), coords[:, 1].min(), coords[:, 0].max(), coords[:, 1].max())))


def singleton_side(sprite):
    vals, counts = np.unique(sprite, return_counts=True)
    assert len(vals) == 2 and sorted(counts.tolist()) == [1, 8]
    singleton_color = int(vals[np.argmin(counts)])
    locs = np.argwhere(sprite == singleton_color)
    assert locs.shape == (1, 2)
    pos = tuple(map(int, locs[0]))
    assert pos in POS_TO_SIDE
    return POS_TO_SIDE[pos]


def oriented_stamp(sprite, target_side):
    for k in range(4):
        rot = np.rot90(sprite, k)
        if singleton_side(rot) == target_side:
            return rot
    raise AssertionError


def find_legend(grid, bg):
    candidates = []
    for coords in components(grid == BOX):
        r0, c0, r1, c1 = bbox(coords)
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        if h < 5 or w < 5:
            continue
        local = np.zeros((h, w), dtype=bool)
        local[coords[:, 0] - r0, coords[:, 1] - c0] = True
        border = np.zeros((h, w), dtype=bool)
        border[0, :] = True
        border[-1, :] = True
        border[:, 0] = True
        border[:, -1] = True
        if not np.array_equal(local, border):
            continue
        inner = grid[r0 + 1 : r1, c0 + 1 : c1]
        non_bg = np.argwhere(inner "'!= bg)
        if non_bg.shape[0] != 9:
            continue
        sr0, sc0, sr1, sc1 = bbox(non_bg)
        if (sr1 - sr0 + 1, sc1 - sc0 + 1) != (3, 3):
            continue
        sprite = inner[sr0 : sr1 + 1, sc0 : sc1 + 1]
        if np.any(sprite == bg):
            continue
        try:
            singleton_side(sprite)
        except AssertionError:
            continue
        candidates.append((r0, c0, r1, c1, sprite))
    assert len(candidates) == 1, len(candidates)
    return candidates[0]


def find_bars(grid, bg):
    h, w = grid.shape
    full_rows = [r for r in range(h) if grid[r, 0] != bg and np.all(grid[r, :] == grid[r, 0])]
    full_cols = [c for c in range(w) if grid[0, c] != bg and np.all(grid[:, c] == grid[0, c])]
    if full_rows and not full_cols:
        colors = {int(grid[r, 0]) for r in full_rows}
        assert len(colors) == 1
        return '"'rows', full_rows, colors.pop()
    if full_cols and not full_rows:
        colors = {int(grid[0, c]) for c in full_cols}
        assert len(colors) == 1
        return 'cols', full_cols, colors.pop()
    raise AssertionError((full_rows, full_cols))


def main(grid):
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = get_bg(g)
    assert bg == BG
    box_r0, box_c0, box_r1, box_c1, sprite = find_legend(g, bg)
    orientation, bars, _bar_color = find_bars(g, bg)
    control_positions = []
    for r, c in zip(*np.where(g "'!= bg)):
        r = int(r)
        c = int(c)
        if box_r0 <= r <= box_r1 and box_c0 <= c <= box_c1:
            continue
        if orientation == '"'rows' and r in bars:
            continue
        if orientation == 'cols' and c in bars:
            continue
        control_positions.append((r, c))
    assert control_positions
    control_colors = {int(g[r, c]) for r, c in control_positions}
    assert len(control_colors) == 1
    control_color = control_colors.pop()

    out = g.copy()
    hits = []
    if orientation == 'rows':
        bars = sorted(bars)
        for r, c in sorted(control_positions):
            above = [br for br in bars if br < r]
            below = [br for br in bars if br > r]
            if above:
                hit = above[-1]
                assert r - hit >= 2
                assert np.all(g[hit + 1 : r, c] == bg)
                out[hit + 1 : r, c] = control_color
                hits.append((hit, c, 2))
            if below:
                hit = below[0]
                assert hit - r >= 2
                assert np.all(g[r + 1 : hit, c] == bg)
                out[r + 1 : hit, c] = control_color
                hits.append((hit, c, 0))
    else:
        bars = sorted(bars)
        for r, c in sorted(control_positions):
            left = [bc for bc in bars if bc < c]
            right = [bc for bc in bars if bc > c]
            if left:
                hit = left[-1]
                assert c - hit >= 2
                assert np.all(g[r, hit + 1 : c] == bg)
                out[r, hit + 1 : c] = control_color
                hits.append((r, hit, 1))
            if right:
                hit = right[0]
                assert hit - c >= 2
                assert np.all(g[r, c + 1 : hit] == bg)
                out[r, c + 1 : hit] = control_color
                hits.append((r, hit, 3))

    centers = [(r, c) for r, c, _ in hits]
    assert len(set(centers)) == len(centers)
    for hr, hc, side in hits:
        stamp = oriented_stamp(sprite, side)
        assert 1 <= hr < g.shape[0] - 1 and 1 <= hc < g.shape[1] - 1
        out[hr - 1 : hr + 2, hc - 1 : hc + 2] = stamp
    return out


def make_sprite(major, minor, side):
    sprite = np.full((3, 3), major, dtype=int)
    sprite[SIDE_TO_POS[side]] = minor
    return sprite


def sample_spaced(lo, hi, count, min_gap):
    vals = list(range(lo, hi + 1))
    if len(vals) < count:
        return None
    for _ in range(200):
        picks = sorted(random.sample(vals, count))
        if all(b - a >= min_gap for a, b in zip(picks, picks[1:])):
            return picks
    return None


def sample_spaced_values(values, count, min_gap):
    if len(values) < count:
        return None
    for _ in range(200):
        picks = sorted(random.sample(values, count))
        if all(b - a >= min_gap for a, b in zip(picks, picks[1:])):
            return picks
    return None


def max_spaced_count(values, min_gap):
    count = 0
    last = -10**9
    for v in sorted(values):
        if v - last >= min_gap:
            count += 1
            last = v
    return count


def gen_attempt():
    H = random.randint(18, 30)
    W = random.randint(18, 30)
    max_bars = min(4, (H - 5) // 4)
    if max_bars < 2:
        return None
    bar_count = random.randint(2, max_bars)
    bar_rows = sample_spaced(2, H - 3, bar_count, 4)
    if bar_rows is None:
        return None

    box_row_starts = [r0 for r0 in range(0, H - 4) if all(br not in range(r0, r0 + 5) for br in bar_rows)]
    if not box_row_starts:
        return None
    box_col_starts = list(range(2, W - 6 + 1))
    if not box_col_starts:
        return None

    palette = [1, 2, 3, 4, 6, 7, 8, 9]
    bar_color, control_color, major, minor = random.sample(palette, 4)
    legend_side = random.randrange(4)
    sprite = make_sprite(major, minor, legend_side)

    for _ in range(80):
        box_r0 = random.choice(box_row_starts)
        box_c0 = random.choice(box_col_starts)
        allowed_cols = [c for c in range(1, W - 1) if c <= box_c0 - 2 or c >= box_c0 + 6]
        max_controls = min(4, max_spaced_count(allowed_cols, 4))
        if max_controls < 2:
            continue
        control_count = random.randint(2, max_controls)
        control_cols = sample_spaced_values(allowed_cols, control_count, 4)
        if control_cols is None:
            continue

        categories = []
        top_rows = list(range(0, bar_rows[0] - 1))
        if top_rows:
            categories.append(('top', top_rows))
        for upper, lower in zip(bar_rows, bar_rows[1:]):
            mid_rows = list(range(upper + 2, lower - 1))
            if mid_rows:
                categories.append((('between', upper, lower), mid_rows))
        bottom_rows = list(range(bar_rows[-1] + 2, H))
        if bottom_rows:
            categories.append(('bottom', bottom_rows))
        between_categories = [item for item in categories if isinstance(item[0], tuple)]
        edge_categories = [item for item in categories if item[0] in {'top', 'bottom'}]
        if not between_categories or not edge_categories:
            continue

        picks = [random.choice(between_categories), random.choice(edge_categories)]
        while len(picks) < control_count:
            picks.append(random.choice(categories))
        random.shuffle(picks)
        control_points = []
        for col, (_, rows) in zip(control_cols, picks):
            control_points.append((random.choice(rows), col))

        grid = np.zeros((H, W), dtype=int)
        grid[bar_rows, :] = bar_color
        grid[box_r0, box_c0 : box_c0 + 5] = BOX
        grid[box_r0 + 4, box_c0 : box_c0 + 5] = BOX
        grid[box_r0 : box_r0 + 5, box_c0] = BOX
        grid[box_r0 : box_r0 + 5, box_c0 + 4] = BOX
        grid[box_r0 + 1 : box_r0 + 4, box_c0 + 1 : box_c0 + 4] = sprite
        for r, c in control_points:
            grid[r, c] = control_color

        if random.random() < 0.5:
            grid = grid.T.copy()
        try:
            out = main(grid)
        except AssertionError:
            continue
        if np.array_equal(grid, out):
            continue
        return grid
    return None


def generate_input():
    for _ in range(200):
        grid = gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError

sigs=set()
for i in range(200):
    inp = generate_input()
    out = main(inp)
    assert inp.ndim==2 and out.ndim==2 and max(inp.shape)<=30 and max(out.shape)<=30
    sigs.add(hashlib.md5(inp.tobytes()+str(inp.shape).encode()).hexdigest())
print('variants', len(sigs))
print('sample shape range ok')
