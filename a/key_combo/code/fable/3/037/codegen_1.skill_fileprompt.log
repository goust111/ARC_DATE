+
+BG = 0
+BOX = 5
+SIDE_TO_POS = {0: (0, 1), 1: (1, 2), 2: (2, 1), 3: (1, 0)}
+POS_TO_SIDE = {pos: side for side, pos in SIDE_TO_POS.items()}
+GEN_ATTEMPTS = 200
