+    axis_vec, diag_vec = _decompose_offset(b[0] - a[0], b[1] - a[1])
+    axis_corner = (a[0] + axis_vec[0], a[1] + axis_vec[1])
+    diag_corner = (a[0] + diag_vec[0], a[1] + diag_vec[1])
+    return _chain_cells(a, axis_corner, b), _chain_cells(a, diag_corner, b)
