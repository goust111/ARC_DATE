+    pc0 = max(0, c0 - PAIR_PADDING)
+    pr1 = min(occupied.shape[0] - 1, r1 + PAIR_PADDING)
+    pc1 = min(occupied.shape[1] - 1, c1 + PAIR_PADDING)
