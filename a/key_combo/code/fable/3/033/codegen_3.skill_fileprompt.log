0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Move every foreground object straight downward by a number of rows equal to its own pixel count.
0010: 
0011:     Input structure:
0012:     - The grid has one dominant background color.
0013:     - The foreground is made of separated 4-connected monochromatic objects.
0014:     - Objects may move partly below the bottom edge of the grid.
0015: 
0016:     Rule:
0017:     - Clear the canvas to the background.
0018:     - For each foreground object, compute its area in pixels.
0019:     - Redraw the object at the same columns and that many rows lower, clipping pixels below the grid.
0020: 
0021:     Key insight:
0022:     - The downward displacement is the object's own area; color and shape only identify which pixels move together.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
0026:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0027:     assert objects, "expected at least one foreground object"
0028: 
0029:     out = np.full_like(g, bg)
0030:     painted = np.zeros(g.shape, dtype=bool)
0031:     H, W = g.shape
0032: 
0033:     for obj in objects:
0034:         coords = np.asarray(obj["coords"], dtype=int)
0035:         area = int(obj["area"])
0036:         color = int(obj["color"])
0037:         assert coords.ndim == 2 and coords.shape == (area, 2), "component coords must match area"
0038:         assert np.all(g[coords[:, 0], coords[:, 1]] == color), "component must be monochromatic"
0039: 
0040:         target = coords.copy()
0041:         target[:, 0] += area
0042:         assert np.all((0 <= target[:, 1]) & (target[:, 1] < W)), "columns are preserved in bounds"
0043: 
0044:         keep = target[:, 0] < H
0045:         target = target[keep]
0046:         if target.size == 0:
0047:             continue
0048: 
0049:         rr = target[:, 0]
0050:         cc = target[:, 1]
0051:         assert not painted[rr, cc].any(), "moved objects must not overlap"
0052:         out[rr, cc] = color
0053:         painted[rr, cc] = True
0054: 
0055:     return out
0056: 
