+                "shape": shape,
+                "payload": payload,
+                "array": _build_object(shape, payload, border_color, bg),
+            }
+        )
+
+    empty_specs = [
+        (0, _sample_non_identity_transform(rng, need_flip=False)),
+        (1, _sample_non_identity_transform(rng, need_flip=True)),
