0014: def main(input_grid):
0015:     """
0016:     Return the one sprite among several objects that has a symmetry.
0017: 
0018:     Input structure:
0019:     - The input is a black grid containing several monochromatic sprites.
0020:     - One sprite is symmetric under a rotation, reflection, or diagonal symmetry.
0021:     - The other sprites are non-symmetric distractors.
0022: 
0023:     Rule:
0024:     - Detect and crop each object into its sprite.
0025:     - Test each sprite for radial, vertical, horizontal, and diagonal symmetry.
0026:     - Return the first sprite that satisfies one of those symmetry tests.
0027: 
0028:     Key insight:
0029:     - Shape symmetry, not color or position, identifies the target sprite.
0030:     """
0031:     # find the objects in the input grid
0032:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
0033: 
0034:     # crop out the sprites from the objects
0035:     sprites = []
0036:     for obj in objects:
0037:         b = bbox(obj != Color.BLACK)
0038:         if b is None:
0039:             continue
0040:         sprites.append(crop_bbox(obj, b))
0041: 
0042:     # find the symmetric sprite
0043:     symmetric_sprite = None
0044:     for sprite in sprites:
0045:       # check if the sprite is radially symmetric
0046:       if np.array_equal(sprite, np.rot90(sprite, 1)):
0047:         symmetric_sprite = sprite
0048:         break
0049:       # check if the sprite is vertically symmetric
0050:       elif np.array_equal(sprite, np.fliplr(sprite)):
0051:         symmetric_sprite = sprite
0052:         break
0053:       # check if the sprite is horizontally symmetric
0054:       elif np.array_equal(sprite, np.flipud(sprite)):
0055:         symmetric_sprite = sprite
0056:         break
0057:       # check if the sprite is diagonally symmetric
0058:       elif np.array_equal(sprite, sprite.T) or (
0059:           sprite.shape[0] == sprite.shape[1] and np.array_equal(sprite, np.rot90(sprite, 2).T)
0060:       ):
0061:         symmetric_sprite = sprite
0062:         break
0063: 
0064:     return symmetric_sprite
0065: 
0066:   
0067: 
