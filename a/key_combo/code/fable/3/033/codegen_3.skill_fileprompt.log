0038: def main(grid: np.ndarray) -> np.ndarray:
0039:     """
0040:     Delete connected components whose colors match a legend swatch.
0041: 
0042:     Input structure:
0043:     - Background (bg) fills most of the grid.
0044:     - Top-left corner: a small square legend region bordered on its bottom and right edges by a single color; the interior holds a set of "target" colors.
0045:     - Elsewhere: multicolored objects (4-connected components) on the bg.
0046: 
0047:     Rule:
0048:     - Read the target color set from inside the legend border.
0049:     - For each connected component, check whether it contains **all** target colors.
0050:     - Erase (fill with bg) every component that does; leave all others unchanged.
0051:     - Output grid is the same size.
0052: 
0053:     Key insight: The legend acts as a filter specification — only components carrying the full color palette shown in the legend are removed.
0054:     """
0055:     g = np.asarray(grid, dtype=int)
0056:     bg = _bg_boundary(g)
0057: 
0058:     legend = _find_legend(g, bg)
0059:     _sz, _x, legend_colors = legend
0060:     assert legend_colors, "legend interior contains no target colors"
0061: 
0062:     out = g.copy()
0063:     comps = components_mask(g != bg, connectivity=4)
0064:     for pts in comps:
0065:         cols = {int(g[r, c]) for r, c in pts}
0066:         if legend_colors.issubset(cols):
0067:             for r, c in pts:
0068:                 out[r, c] = bg
0069:     return out
0070: 
