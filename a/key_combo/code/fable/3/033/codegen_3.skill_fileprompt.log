0083:     out[nr0, nc0 : nc1 + 1] = border_color
0084:     out[nr1, nc0 : nc1 + 1] = border_color
0085:     out[nr0 : nr1 + 1, nc0] = border_color
0086:     out[nr0 : nr1 + 1, nc1] = border_color
