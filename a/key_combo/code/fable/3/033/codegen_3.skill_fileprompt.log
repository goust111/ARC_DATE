0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Fill holes in a target object with colors from a source object's subsprites, then tight-crop.
0011: 
0012:     Input structure:
0013:     - bg = background. Two similar 8-connected objects share an outline color.
0014:     - Source has colored subsprites in cavities; target has empty cavities.
0015: 
0016:     Rule:
0017:     - Find the two 8-connected objects.
0018:     - Target = object with more hole area. Align subsprites to holes (rotation/flip if needed).
0019:     - Fill each hole with its matched subsprite color; tight-crop.
0020: 
0021:     Key insight: Hole centers in the target are matched to source subsprite centers under the best rotation/flip transform.
0022:     """
0023:     g = np.array(grid, dtype=int)
0024:     bg = int(get_bg(g))
0025: 
0026:     def _components(mask: np.ndarray) -> list[dict]:
0027:         lab, n = label_mask(mask, connectivity=8)
0028:         comps = []
0029:         for cid in range(1, int(n) + 1):
0030:             pts = np.argwhere(lab == int(cid))
0031:             if pts.size == 0:
0032:                 continue
0033:             r0, c0 = pts.min(axis=0)
0034:             r1, c1 = pts.max(axis=0)
0035:             comps.append(
0036:                 {
0037:                     "cid": int(cid),
0038:                     "pts": pts,
0039:                     "size": int(len(pts)),
0040:                     "cent": (float(pts[:, 0].mean()), float(pts[:, 1].mean())),
0041:                     "bbox": (int(r0), int(c0), int(r1), int(c1)),
0042:                 }
0043:             )
0044:         comps.sort(key=lambda d: int(d["size"]), reverse=True)
0045:         return comps
0046: 
0047:     def _extract_two_objects():
0048:         comps = _components(g != int(bg))
0049:         if len(comps) < 2:
0050:             return [comps]
0051:         return [[comps[0]], [comps[1]]]
0052: 
0053:     def _bbox_of(group: list[dict]) -> tuple[int, int, int, int]:
0054:         r0 = min(int(d["bbox"][0]) for d in group)
0055:         c0 = min(int(d["bbox"][1]) for d in group)
0056:         r1 = max(int(d["bbox"][2]) for d in group)
0057:         c1 = max(int(d["bbox"][3]) for d in group)
0058:         return int(r0), int(c0), int(r1), int(c1)
0059: 
0060:     def _extract_group_subgrid(group: list[dict]) -> np.ndarray:
0061:         r0, c0, r1, c1 = _bbox_of(group)
0062:         sub = np.full((int(r1 - r0 + 1), int(c1 - c0 + 1)), int(bg), dtype=int)
0063:         for d in group:
0064:             for rr, cc in d["pts"]:
0065:                 sub[int(rr) - int(r0), int(cc) - int(c0)] = int(g[int(rr), int(cc)])
0066:         return sub
0067: 
0068:     def _enclosed_bg_components(sub: np.ndarray) -> list[dict]:
0069:         m = sub == int(bg)
0070:         lab, n = label_mask(m, connectivity=4)
0071:         Hs, Ws = sub.shape
0072:         holes = []
0073:         for cid in range(1, int(n) + 1):
0074:             pts = np.argwhere(lab == int(cid))
0075:             if pts.size == 0:
0076:                 continue
0077:             r0, c0 = pts.min(axis=0)
0078:             r1, c1 = pts.max(axis=0)
0079:             if bool(r0 == 0 or c0 == 0 or r1 == int(Hs - 1) or c1 == int(Ws - 1)):
0080:                 continue
0081:             cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))
0082:             holes.append({"pts": pts, "cent": cent, "size": int(len(pts))})
0083:         return holes
0084: 
0085:     def _outline_col(sub: np.ndarray) -> int:
0086:         cnt = Counter(map(int, sub.flatten()))
0087:         opts = [(c, n) for c, n in cnt.items() if int(c) != int(bg)]
0088:         return int(max(opts, key=lambda t: t[1])[0]) if opts else int(bg)
0089: 
0090:     def _colored_components(sub: np.ndarray) -> list[dict]:
0091:         outc = _outline_col(sub)
0092:         m = (sub != int(bg)) & (sub != int(outc))
0093:         lab, n = label_mask(m, connectivity=4)
0094:         subs = []
0095:         for cid in range(1, int(n) + 1):
0096:             pts = np.argwhere(lab == int(cid))
0097:             if pts.size == 0:
0098:                 continue
0099:             col = Counter(map(int, sub[lab == int(cid)].flatten())).most_common(1)[0][0]
0100:             cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))
0101:             subs.append({"cent": cent, "color": int(col)})
0102:         return subs
