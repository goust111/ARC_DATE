+
+def _crop_bbox(arr: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return np.asarray(arr)[r0 : r1 + 1, c0 : c1 + 1]
