+    g = np.asarray(grid, dtype=int)
+    height, width = g.shape
+    assert height % 2 == 1 and height >= 5
+
+    divider_r = height // 2
+    divider_color = int(g[divider_r, 0])
+    assert np.all(g[divider_r] == divider_color)
+
+    upper = g[:divider_r]
+    lower = g[divider_r + 1 :]
+    assert upper.shape == lower.shape
