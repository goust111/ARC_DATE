+
+    lower_mask = _make_lower_mask(fallen_occ, upper_occ)
+    if lower_mask is None:
+        return None
+
+    lower_area = int(lower_mask.sum())
+    if not (5 <= lower_area <= (half_h * width) // 2):
+        return None
+
+    lower = np.full((half_h, width), bg, dtype=int)
+    lower[lower_mask] = mask_color
+
