+def _find_table(grid: np.ndarray, bg: int) -> tuple[np.ndarray, int, list[tuple[int, int]], list[tuple[int, int]], int]:
+    candidates = []
+    for color in map(int, np.unique(grid)):
+        if color == bg:
+            continue
+        full_rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == color)]
+        if len(full_rows) >= 2:
