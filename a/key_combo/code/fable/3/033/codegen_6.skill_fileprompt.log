+    colors, counts = np.unique(non_bg, return_counts=True)
+    best = int(np.argmax(counts))
+    ink_color = int(colors[best])
+    assert np.sum(counts == counts[best]) == 1, "legend ink color must be uniquely most common in legend band"
+
