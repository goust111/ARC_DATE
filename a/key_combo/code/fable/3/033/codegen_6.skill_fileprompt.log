+
+TEMPLATE_LIBRARY = [
+    _mask_from_coords([(0, 0), (0, 1), (1, 0), (2, 0)]),
+    _mask_from_coords([(0, 0), (0, 1), (0, 2), (1, 1)]),
+    _mask_from_coords([(0, 0), (1, 0), (1, 1), (2, 1)]),
+    _mask_from_coords([(0, 1), (0, 2), (1, 1), (2, 1)]),
