def _gen_norm_coords(coords):
    arr = np.asarray(list(coords), dtype=int)
    arr[:, 0] -= arr[:, 0].min()
    arr[:, 1] -= arr[:, 1].min()
    return arr


def _gen_transform_coords(coords):
