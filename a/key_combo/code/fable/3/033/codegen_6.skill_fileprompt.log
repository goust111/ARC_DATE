+    widths = {c1 - c0 + 1 for c0, c1 in col_regions}
+    assert len(heights) == 1 and len(widths) == 1
+    cell_h = heights.pop()
+    cell_w = widths.pop()
+    assert cell_h == cell_w == CELL_SIZE
+
+    return table, line_color, row_regions, col_regions, table_top
