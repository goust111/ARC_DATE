+def _evaluate_axis(grid: np.ndarray, bg: int, kind: str, axis_sum: int) -> dict | None:
+    h, w = grid.shape
+    repaired = np.full_like(grid, bg)
+    breaches: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            q = _mirror_point(kind, axis_sum, r, c)
+            if q is None:
+                if int(grid[r, c]) != bg:
+                    return None
+                continue
