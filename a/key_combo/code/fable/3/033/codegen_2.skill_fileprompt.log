+                continue
+            if a != bg and b != bg:
+                if a != b:
+                    return None
+                repaired[r, c] = a
+                repaired[rr, cc] = a
+                continue
+            if a != bg:
+                breaches.append((r, c))
+            else:
+                breaches.append((rr, cc))
+
+    repaired_area = int(np.count_nonzero(repaired != bg))
+    if repaired_area == 0 or not breaches:
