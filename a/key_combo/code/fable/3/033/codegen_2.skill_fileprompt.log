+    max_fill = min(4, len(off_pairs) - 1)
+    filled_pair_count = rng.randint(2, max_fill)
+    filled_pair_ids = set(rng.sample(range(len(off_pairs)), filled_pair_count))
+    palette = rng.sample(PALETTE, rng.randint(2, 4))
