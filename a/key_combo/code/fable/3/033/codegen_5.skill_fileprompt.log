+    if direction in {"right", "left"}:
+        for r, c in obstacles:
+            idx.setdefault(int(r), []).append(int(c))
+    else:
+        for r, c in obstacles:
+            idx.setdefault(int(c), []).append(int(r))
+    for values in idx.values():
+        values.sort()
+    return idx
