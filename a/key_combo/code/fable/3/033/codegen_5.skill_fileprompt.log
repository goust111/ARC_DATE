+    max_c = int(coords[:, 1].max())
+    mr, mc = marker
+    if direction == "right":
+        vals = list(range(0, mc - max_c))
+        vals.sort(reverse=True)
+        return vals
+    if direction == "left":
+        vals = list(range(mc + 1, w - max_c))
+        vals.sort()
+        return vals
+    if direction == "down":
+        vals = list(range(0, mr - max_r))
+        vals.sort(reverse=True)
+        return vals
+    vals = list(range(mr + 1, h - max_r))
+    vals.sort()
+    return vals
+
