+OPPOSITE_DIR = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+
+BG = 0
+PALETTE = list(range(1, 10))
+MAX_GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
+
+def _infer_direction(marker: tuple[int, int], objects: list[dict]) -> str:
+    mr, mc = marker
+    all_coords = np.vstack([obj["coords"] for obj in objects])
+    r0, c0 = all_coords.min(axis=0)
+    r1, c1 = all_coords.max(axis=0)
+
+    candidates = []
+    if int(c1) < mc and int(r0) <= mr <= int(r1):
+        candidates.append("right")
+    if int(c0) > mc and int(r0) <= mr <= int(r1):
+        candidates.append("left")
+    if int(r1) < mr and int(c0) <= mc <= int(c1):
+        candidates.append("down")
+    if int(r0) > mr and int(c0) <= mc <= int(c1):
+        candidates.append("up")
+    if len(candidates) == 1:
+        return candidates[0]
+
+    relaxed = []
+    if int(c1) < mc:
+        relaxed.append("right")
+    if int(c0) > mc:
+        relaxed.append("left")
+    if int(r1) < mr:
+        relaxed.append("down")
+    if int(r0) > mr:
+        relaxed.append("up")
+    assert len(relaxed) == 1, "could not infer a unique movement direction"
+    return relaxed[0]
+
+
+def _distance_key(obj: dict, marker: tuple[int, int], direction: str) -> int:
+    mr, mc = marker
+    r0, c0, r1, c1 = obj["bbox"]
+    if direction == "right":
+        return mc - c1
+    if direction == "left":
