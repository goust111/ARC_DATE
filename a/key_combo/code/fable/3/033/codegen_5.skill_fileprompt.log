+            prof[rr] = max(prof.get(rr, -10**9), int(c))
+    elif direction == "left":
+        for r, c in coords:
+            rr = int(r)
+            prof[rr] = min(prof.get(rr, 10**9), int(c))
+    elif direction == "down":
