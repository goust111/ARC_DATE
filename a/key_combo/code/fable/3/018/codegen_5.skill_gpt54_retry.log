+        grid = np.full((rows, cols), -1, dtype=int)
+
+        def backtrack(idx: int) -> bool:
+            if idx == n_cells:
+                return True
+            r = idx // cols
+            c = idx % cols
+
+            used_up = int(grid[r - 1, c]) if r > 0 else None
