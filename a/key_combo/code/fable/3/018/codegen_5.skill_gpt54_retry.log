+        return False
+    if set(parsed_sprites) != set(sprite_masks):
+        return False
+    if any(not np.array_equal(parsed_sprites[color], sprite_masks[color]) for color in sprite_masks):
+        return False
+    if not np.array_equal(solved, expected):
+        return False
+    return True
+
