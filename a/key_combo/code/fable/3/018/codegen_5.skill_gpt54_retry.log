+
+def _dilate_box(mask: np.ndarray, bbox: BBox, pad: int) -> None:
+    h, w = mask.shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r1 + pad + 1)
+    cc1 = min(w, c1 + pad + 1)
+    mask[rr0:rr1, cc0:cc1] = True
+
+
+def _place_legends(
