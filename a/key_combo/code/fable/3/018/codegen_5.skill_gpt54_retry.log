+                comps.append(
+                    {
+                        "color": int(color),
+                        "coords": coords,
+                        "bbox": _bbox_from_coords(coords),
+                        "area": int(coords.shape[0]),
+                    }
+                )
+        return comps
+
+    comps = []
+    for coords in _components_from_mask(grid != int(bg)):
+        vals = {int(grid[r, c]) for r, c in coords}
+        comps.append(
