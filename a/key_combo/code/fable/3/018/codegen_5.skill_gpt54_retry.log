+            cells_left = n_cells - idx - 1
+            for color in candidates:
+                counts[color] -= 1
+                needed = sum(1 for value in counts.values() if value > 0)
+                if needed <= cells_left:
+                    grid[r, c] = color
+                    if backtrack(idx + 1):
