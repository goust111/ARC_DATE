+            candidates = [
+                (direction, cells[0])
+                for direction, cells in edges
+                if len(cells) == 1 and cells[0] not in corners
+            ]
+            passing: list[tuple[str, tuple[int, int], int, list[tuple[int, int]]]] = []
+            for direction, spike in candidates:
