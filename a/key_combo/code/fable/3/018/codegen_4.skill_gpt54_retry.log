+        mouth_canon = _mouth_interior_coords(patch_canon, border_color, open_side="D")
+        patch, spike, mouth = _rotate_to_direction(patch_canon, spike_canon, mouth_canon, direction)
+        if len(mouth) < min_capacity:
+            continue
