  "src": "8-connected marked object s containing one marker pixel and a monochrome sprite",
  "dst": "standalone marker pixel d",
  "match_cond": "s.marker.color == d.color",
  "transform": "erase the input; stamp s.sprite at each d using the marker as anchor, keep d, and delete source markers plus distractor markers"
}
</annotation>
</reference_puzzle>

