    if not candidates:
        return None

    r0, c0 = random.choice(candidates)
    paste(out, patch, r0, c0, transparent=BG)
    marker_pos = (r0 + anchor_r, c0 + anchor_c)
    dest_mask[marker_pos] = True
    return marker_pos


