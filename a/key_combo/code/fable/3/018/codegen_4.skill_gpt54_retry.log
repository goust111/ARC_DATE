+
+def _sample_cup_spec(rng: np.random.Generator, border_color: int, content_color: int, min_capacity: int) -> dict:
+    while True:
+        direction = str(rng.choice(np.array(list(DIR4))))
+        L = int(rng.integers(1, 4))
+        R = int(rng.integers(1, 4))
