+BG = Color.BLACK
+BORDER_PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
