# Panel geometry and fixed quadrant placement.
_PANEL_SHAPE, _INPUT_SHAPE = (5, 5), (10, 10)
_PANEL_ORIGINS = ((0, 0), (0, 5), (5, 0), (5, 5))
_PANEL_COUNT = 4

