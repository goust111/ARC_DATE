        ok = True
        for p in _NON_GREEN_PANELS:
            trial = masks[p].copy()
            trial[r, c] = True
            if _gen_component_count(trial) > _COMPONENT_RANGE[1]:
                ok = False
                break
        if ok:
            return r, c
    return None


