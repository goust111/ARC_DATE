+    seen = set(seeds)
+    stack = list(seeds)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4.values():
+            nr, nc = r + dr, c + dc
+            if not (r0 <= nr <= r1 and c0 <= nc <= c1):
+                continue
+            if (nr, nc) in seen or (nr, nc) in border_set:
+                continue
+            seen.add((nr, nc))
+            stack.append((nr, nc))
+    return seen
