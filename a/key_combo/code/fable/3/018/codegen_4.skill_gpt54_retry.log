) -> bool:
    while int(masks[panel_i].sum()) < target:
        low_overlap = []
        any_overlap = []
        for r, c in _gen_coords(allowed & ~masks[panel_i]):
            trial = masks[panel_i].copy()
            trial[r, c] = True
            if _gen_component_count(trial) > _COMPONENT_RANGE[1]:
                continue
            overlap_add = 0
            ok = True
            for other_i in range(_PANEL_COUNT):
                if other_i == panel_i:
