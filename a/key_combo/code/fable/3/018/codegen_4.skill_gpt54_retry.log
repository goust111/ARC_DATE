+def _choose_hit_count(rng: np.random.Generator, capacity: int, safe_len: int) -> int:
+    minimum = int(safe_len + 1)
+    max_extra = int(min(2, capacity - minimum))
+    extra = 0
+    if max_extra > 0:
+        if rng.random() < 0.65:
+            extra = int(rng.integers(1, max_extra + 1))
+        else:
+            extra = 0
