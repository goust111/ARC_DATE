+def _expected_from_specs(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
+        color = int(spec["color"])
+        p0 = spec["p0"]
+        p1 = spec["p1"]
+        d0 = _chessboard_distance_to_border(p0, spec["border"])
+        d1 = _chessboard_distance_to_border(p1, spec["border"])
