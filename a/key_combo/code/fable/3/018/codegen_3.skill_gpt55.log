+def _branch_plan(n: int) -> list[str]:
+    branches = ["limited", "surplus"]
+    if n >= 3:
+        branches.append(random.choice(["zero", "exact"]))
+    while len(branches) < n:
+        branches.append(random.choice(["limited", "surplus", "exact", "zero"]))
+    random.shuffle(branches)
+    return branches
