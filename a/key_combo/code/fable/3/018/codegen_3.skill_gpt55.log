+def _dims_for_branch(branch: str, gap: int) -> list[tuple[int, int]]:
+    dims: list[tuple[int, int]] = []
+    for h in range(3, 8):
+        for w in range(3, 8):
+            capacity = (h - 2) * (w - 2)
+            if branch == "surplus" and capacity >= gap + 1:
+                dims.append((h, w))
+            elif branch == "exact" and capacity >= gap:
+                dims.append((h, w))
+            elif branch in ("limited", "zero") and capacity >= 1:
