+        step_r = _sign(far[0] - near[0])
+        step_c = _sign(far[1] - near[1])
+        used = min(int(spec["gap"]), len(spec["gray_cells"]))
+        for i in range(1, used + 1):
+            out[near[0] + i * step_r, near[1] + i * step_c] = color
+        for r, c in spec["gray_cells"][:used]:
+            out[r, c] = color
+    return out
