def _gen_composition(total: int, parts: int, low: int, high: int) -> list[int] | None:
    counts = []
    remaining = int(total)
    for i in range(parts):
        rest = parts - i - 1
        lo = max(low, remaining - high * rest)
        hi = min(high, remaining - low * rest)
        if lo > hi:
            return None
        val = random.randint(lo, hi)
        counts.append(val)
        remaining -= val
    random.shuffle(counts)
    return counts


