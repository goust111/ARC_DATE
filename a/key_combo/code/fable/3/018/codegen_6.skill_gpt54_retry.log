  28: def main(grid: np.ndarray) -> np.ndarray:
  29:     """
  30:     Connect every horizontally or vertically aligned pair of blue marker pixels with teal segments.
  31: 
  32:     Input structure
  33:     - A 2D black-background grid.
  34:     - The only foreground pixels are blue markers.
  35:     - Some rows and columns contain two or more blue markers.
  36: 
  37:     Rule
  38:     - Preserve every input pixel.
  39:     - In each row, sort the blue marker columns and paint teal on the background cells strictly between adjacent markers.
  40:     - In each column, sort the blue marker rows and paint teal on the background cells strictly between adjacent markers.
  41: 
  42:     Key insight
  43:     - The markers are endpoints for straight horizontal and vertical connections; unrelated markers are ignored unless they share the same row or column.
  44:     """
  45:     g = np.asarray(grid, dtype=int)
  46:     assert g.ndim == 2, "expected a 2D grid"
  47:     bg = get_bg(g)
  48:     assert bg == Color.BLACK, "expected black background"
  49:     assert colors_present(g, exclude={bg}) == [Color.BLUE], "expected only blue foreground markers"
  50: 
  51:     out = g.copy()
  52:     marker_coords = np.argwhere(g == Color.BLUE)
  53:     assert marker_coords.shape[0] >= 2, "expected at least two blue markers"
  54: 
  55:     painted = 0
  56:     height, width = map(int, g.shape)
  57:     for r in range(height):
