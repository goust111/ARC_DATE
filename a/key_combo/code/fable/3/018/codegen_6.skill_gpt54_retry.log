 270: 
 271:         # stamp moved head pixels
 272:         for r, c in head_pts:
 273:             rrr = int(r + tr)
 274:             ccc = int(c + tc)
 275:             if 0 <= rrr < H and 0 <= ccc < W:
 276:                 out[rrr, ccc] = int(hc)
 277: 
 278:     return out
