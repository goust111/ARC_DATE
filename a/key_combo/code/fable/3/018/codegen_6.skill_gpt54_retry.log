+            forbidden |= patch
+
+    for _ in range(int(rng.integers(1, 3))):
+        patch = _sample_patch(rng, panel_h, panel_w, forbidden)
+        if patch is None:
+            break
+        exclusive_a |= patch
+        forbidden |= patch
+
+    for _ in range(int(rng.integers(1, 3))):
+        patch = _sample_patch(rng, panel_h, panel_w, forbidden)
+        if patch is None:
+            break
+        exclusive_b |= patch
+        forbidden |= patch
