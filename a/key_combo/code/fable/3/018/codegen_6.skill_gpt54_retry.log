  12: def main(grid: np.ndarray) -> np.ndarray:
  13:     """
  14:     Connect each same-colored endpoint pair by filling the diagonal segment between them.
  15: 
  16:     Input structure:
  17:     - A dominant background surrounds several foreground colors.
  18:     - Each foreground color appears exactly twice.
  19:     - The two pixels of each foreground color are endpoints of a strict 45-degree diagonal segment.
  20: 
  21:     Rule:
  22:     - Preserve the input pixels.
  23:     - For every foreground color, paint that color on every cell along the diagonal segment connecting its two endpoints.
  24: 
  25:     Key insight:
  26:     Each color supplies its own two endpoints; the missing cells are just the background cells on the straight diagonal between them.
  27:     """
  28:     g = np.asarray(grid, dtype=int)
  29:     assert g.ndim == 2, "grid must be 2D"
  30: 
  31:     bg = get_bg(g)
  32:     colors = colors_present(g, exclude={bg})
  33:     assert colors, "expected at least one foreground endpoint pair"
  34: 
  35:     out = g.copy()
  36:     for color in colors:
  37:         coords = np.argwhere(g == color)
  38:         assert len(coords) == 2, "each foreground color must have exactly two endpoints"
  39:         (r0, c0), (r1, c1) = coords.astype(int).tolist()
  40: 
  41:         dr = r1 - r0
  42:         dc = c1 - c0
  43:         assert dr != 0 and abs(dr) == abs(dc), "endpoint pair must define a strict diagonal"
  44: 
  45:         step_r = _sign(dr)
  46:         step_c = _sign(dc)
  47:         for k in range(abs(dr) + 1):
  48:             r = r0 + k * step_r
  49:             c = c0 + k * step_c
  50:             assert int(out[r, c]) in (bg, color), "diagonal paths must not cross other colors"
  51:             out[r, c] = color
  52: 
  53:     return out
  54: 
