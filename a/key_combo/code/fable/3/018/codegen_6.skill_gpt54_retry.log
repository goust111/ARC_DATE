 169:         rem = comp_pts - head_pts
 170:         if rem:
 171:             mask_rem = np.zeros((H, W), dtype=bool)
 172:             for rr, cc in rem:
 173:                 mask_rem[int(rr), int(cc)] = True
 174:             labr, nr = label(mask_rem, structure=STRUCT4)
 175:             for k in range(1, int(nr) + 1):
 176:                 pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}
 177:                 if not pts:
 178:                     continue
 179:                 # reject if adjacent to BORDER
 180:                 adj = False
 181:                 for r, c in pts:
 182:                     for dr, dc in DIR4:
 183:                         rr, cc = int(r + dr), int(c + dc)
 184:                         if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):
 185:                             adj = True
 186:                             break
 187:                     if adj:
 188:                         break
 189:                 if adj:
 190:                     continue
 191:                 rs = [r for r, _c in pts]
 192:                 cs = [c for _r, c in pts]
 193:                 r00, c00 = int(min(rs)), int(min(cs))
 194:                 shp = {(int(r - r00), int(c - c00)) for r, c in pts}
 195:                 if shp != head_shape:
 196:                     continue
 197:                 dests.append({"pts": pts, "shape": shp, "tl": (r00, c00)})
 198: 
 199:         if not dests:
 200:             continue
 201: 
 202:         best = None
 203:         best_dest = None
 204:         for d in dests:
 205:             tr0 = int(d["tl"][0] - head_tl[0])
 206:             tc0 = int(d["tl"][1] - head_tl[1])
 207:             if direction[0] != 0 and tc0 != 0:
 208:                 continue
 209:             if direction[1] != 0 and tr0 != 0:
 210:                 continue
 211:             if direction[0] == 1 and tr0 <= 0:
 212:                 continue
 213:             if direction[0] == -1 and tr0 >= 0:
 214:                 continue
 215:             if direction[1] == 1 and tc0 <= 0:
 216:                 continue
 217:             if direction[1] == -1 and tc0 >= 0:
 218:                 continue
 219:             dist = abs(tr0) + abs(tc0)
 220:             if best is None or dist < best:
 221:                 best = dist
 222:                 best_dest = d
 223:         if best_dest is None:
 224:             continue
 225: 
 226:         # translation to overlap head onto destination, capped by number of GREY cells
 227:         tr0 = int(best_dest["tl"][0] - head_tl[0])
 228:         tc0 = int(best_dest["tl"][1] - head_tl[1])
 229:         steps = abs(tr0) + abs(tc0)
 230: 
 231:         inner = g[r0 + 1 : r1, c0 + 1 : c1]
 232:         grey_coords = [
 233:             (int(r0 + 1 + rr), int(c0 + 1 + cc))
 234:             for rr in range(inner.shape[0])
 235:             for cc in range(inner.shape[1])
 236:             if int(inner[rr, cc]) == GREY
 237:         ]
 238:         steps = min(int(steps), int(len(grey_coords)))
 239: 
 240:         dr, dc = direction
 241:         tr = int(dr * steps)
 242:         tc = int(dc * steps)
 243: 
 244:         # choose which greys to fill in order from head side inward
 245:         if direction == (0, 1):
 246:             order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))
 247:         elif direction == (0, -1):
 248:             order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))
 249:         elif direction == (1, 0):
 250:             order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))
 251:         else:  # (-1,0)
 252:             order = sorted(grey_coords, key=lambda p: (p[0], p[1]))
 253:         to_fill = set(order[:steps])
 254: 
 255:         # erase original container rect and original head pixels (destination stays)
 256:         out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
 257:         for r, c in head_pts:
 258:             if int(out[int(r), int(c)]) == int(hc):
 259:                 out[int(r), int(c)] = int(bg)
 260: 
 261:         # stamp moved container rectangle (using paste for the bulk placement)
 262:         patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
 263:         if to_fill:
 264:             for rr, cc in to_fill:
 265:                 pr = int(rr - r0)
 266:                 pc = int(cc - c0)
 267:                 if 0 <= pr < patch.shape[0] and 0 <= pc < patch.shape[1] and int(patch[pr, pc]) == GREY:
