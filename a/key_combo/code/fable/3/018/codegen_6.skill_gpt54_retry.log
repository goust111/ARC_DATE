from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/3/018/6.py')
mod = SourceFileLoader('arc_task_6_sem_final', str(p)).load_module()

GREEN = 3

def parse(grid):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    cands = []
    if (W - 2) % 3 == 0:
        pw = (W - 2) // 3
        if pw > 0:
            s1, s2 = pw, 2 * pw + 1
            if np.all(g[:, s1] == g[0, s1]) and np.all(g[:, s2] == g[0, s1]):
                line = int(g[0, s1])
                panels = [g[:, :pw], g[:, s1 + 1:s2], g[:, s2 + 1:]]
                sets = [set(map(int, np.unique(p))) for p in panels]
                if all(line not in s for s in sets):
                    common = sets[0] & sets[1] & sets[2]
                    if len(common) == 1:
                        bg = int(next(iter(common)))
                        areas = [int((p "'!= bg).sum()) for p in panels]
                        if min(areas) > 0 and areas.count(min(areas)) == 1 and areas.index(min(areas)) in (0, 2):
                            cands.append(('"'vertical', panels, bg, areas.index(min(areas))))
    if (H - 2) % 3 == 0:
        ph = (H - 2) // 3
        if ph > 0:
            s1, s2 = ph, 2 * ph + 1
            if np.all(g[s1, :] == g[s1, 0]) and np.all(g[s2, :] == g[s1, 0]):
                line = int(g[s1, 0])
                panels = [g[:ph, :], g[s1 + 1:s2, :], g[s2 + 1:, :]]
                sets = [set(map(int, np.unique(p))) for p in panels]
                if all(line not in s for s in sets):
                    common = sets[0] & sets[1] & sets[2]
                    if len(common) == 1:
                        bg = int(next(iter(common)))
                        areas = [int((p "'!= bg).sum()) for p in panels]
                        if min(areas) > 0 and areas.count(min(areas)) == 1 and areas.index(min(areas)) in (0, 2):
                            cands.append(('"'horizontal', panels, bg, areas.index(min(areas))))
    assert len(cands) == 1
    return cands[0]


def slide(coords, wall, direction):
    dr, dc = direction
    cur = [tuple(map(int, p)) for p in coords]
    H, W = wall.shape
    for _ in range(H + W + 5):
        if any(wall[r + dr, c + dc] for r, c in cur):
            return set(cur)
        nxt = []
        for r, c in cur:
            rr, cc = r + dr, c + dc
            assert 0 <= rr < H and 0 <= cc < W
            nxt.append((rr, cc))
        cur = nxt
    raise AssertionError('no stop')

stats = {
    'vertical': 0,
    'horizontal': 0,
    'sprite_first': 0,
    'sprite_last': 0,
    'overlap_trap': 0,
    'no_overlap': 0,
}
for _ in range(200):
    inp = mod.generate_input()
    orient, panels, bg, sprite_idx = parse(inp)
    stats[orient] += 1
    stats['sprite_first' if sprite_idx == 0 else 'sprite_last'] += 1
    if sprite_idx == 0:
        sprite_panel, m1, m2 = panels[0], panels[1], panels[2]
    else:
        sprite_panel, m1, m2 = panels[2], panels[0], panels[1]
    direction = (0, 1) if orient == 'vertical' and sprite_idx == 0 else \\
                (0, -1) if orient == 'vertical' else \\
                (1, 0) if sprite_idx == 0 else (-1, 0)
    wall_xor = np.logical_xor(m1 "'!= bg, m2 != bg)
    wall_union = np.logical_or(m1 != bg, m2 != bg)
    coords = np.argwhere(sprite_panel != bg)
    final_xor = slide(coords, wall_xor, direction)
    final_union = slide(coords, wall_union, direction)
    overlap = bool(np.logical_and(m1 != bg, m2 != bg).any())
    if overlap:
        stats['"'overlap_trap'] += 1
        assert final_xor "'!= final_union
    else:
        stats['"'no_overlap'] += 1
    expected = np.full(wall_xor.shape, bg, dtype=int)
    expected[wall_xor] = GREEN
    sprite_color = int(next(iter(set(map(int, np.unique(sprite_panel))) - {bg})))
    for r, c in final_xor:
        assert expected[r, c] == bg
        expected[r, c] = sprite_color
    got = mod.main(inp)
    assert np.array_equal(got, expected)

print(stats)
