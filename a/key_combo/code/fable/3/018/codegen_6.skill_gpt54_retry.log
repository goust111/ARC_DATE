+
+GREEN = 3
+RETRY_LIMIT = 500
+PALETTE = tuple(color for color in range(10) if color != GREEN)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _extract_candidate(grid: np.ndarray, orientation: str) -> dict | None:
+    g = np.asarray(grid, dtype=int)
+    H, W = map(int, g.shape)
