def parse(grid):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    cands = []
    if (W - 2) % 3 == 0:
        pw = (W - 2) // 3
        if pw > 0:
            s1, s2 = pw, 2 * pw + 1
            if np.all(g[:, s1] == g[0, s1]) and np.all(g[:, s2] == g[0, s1]):
                line = int(g[0, s1])
                panels = [g[:, :pw], g[:, s1 + 1:s2], g[:, s2 + 1:]]
                sets = [set(map(int, np.unique(p))) for p in panels]
                if all(line not in s for s in sets):
                    common = sets[0] & sets[1] & sets[2]
                    if len(common) == 1:
                        bg = int(next(iter(common)))
                        areas = [int((p "'!= bg).sum()) for p in panels]
                        if min(areas) > 0 and areas.count(min(areas)) == 1 and areas.index(min(areas)) in (0, 2):
                            cands.append(('"'vertical', panels, bg, areas.index(min(areas))))
    if (H - 2) % 3 == 0:
        ph = (H - 2) // 3
        if ph > 0:
            s1, s2 = ph, 2 * ph + 1
            if np.all(g[s1, :] == g[s1, 0]) and np.all(g[s2, :] == g[s1, 0]):
                line = int(g[s1, 0])
                panels = [g[:ph, :], g[s1 + 1:s2, :], g[s2 + 1:, :]]
                sets = [set(map(int, np.unique(p))) for p in panels]
                if all(line not in s for s in sets):
                    common = sets[0] & sets[1] & sets[2]
                    if len(common) == 1:
                        bg = int(next(iter(common)))
                        areas = [int((p "'!= bg).sum()) for p in panels]
                        if min(areas) > 0 and areas.count(min(areas)) == 1 and areas.index(min(areas)) in (0, 2):
                            cands.append(('"'horizontal', panels, bg, areas.index(min(areas))))
    assert len(cands) == 1
    return cands[0]


def slide(coords, wall, direction):
    dr, dc = direction
    cur = [tuple(map(int, p)) for p in coords]
    H, W = wall.shape
    for _ in range(H + W + 5):
        if any(wall[r + dr, c + dc] for r, c in cur):
            return set(cur)
        nxt = []
        for r, c in cur:
            rr, cc = r + dr, c + dc
            assert 0 <= rr < H and 0 <= cc < W
            nxt.append((rr, cc))
        cur = nxt
    raise AssertionError('no stop')

stats = {
