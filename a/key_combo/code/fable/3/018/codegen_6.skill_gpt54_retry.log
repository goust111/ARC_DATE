  59:         painted += _paint_between_positions(out, g, r, cols, axis=0)
  60:     for c in range(width):
  61:         rows = sorted(int(r) for r in np.flatnonzero(g[:, c] == Color.BLUE))
  62:         painted += _paint_between_positions(out, g, c, rows, axis=1)
  63: 
  64:     assert painted > 0, "expected at least one aligned marker interval"
  65:     assert np.array_equal(out[g == Color.BLUE], g[g == Color.BLUE]), "blue markers must be preserved"
