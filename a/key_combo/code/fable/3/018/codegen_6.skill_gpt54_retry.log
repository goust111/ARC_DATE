  36: def main(grid: np.ndarray) -> np.ndarray:
  37:     """
  38:     Eject content pixels from cup-shaped frames outward along each cup's tail direction.
  39: 
  40:     Input structure:
  41:     - bg = background. Hollow cup/Y/funnel frames, each a unique border color.
  42:     - Each cup has a convergent tail spike on one side and an open mouth on the opposite side.
  43:     - Content pixels (a single non-border color per cup) sit inside the cup's mouth interior.
  44: 
  45:     Rule:
  46:     - For each cup, identify its tail spike and tail direction.
  47:     - Erase all content pixels from the mouth interior.
  48:     - Draw a straight line of content-colored pixels from the spike outward in the tail direction,
  49:       one pixel per erased content pixel; cells beyond the grid edge are dropped.
  50: 
  51:     Key insight: The tail spike is the unique convergent point whose outward direction is opposite
  52:     the mouth opening where the content lives.
  53:     """
  54:     g = np.array(grid, dtype=int)
  55:     H, W = g.shape
  56:     bg = int(get_bg(g))
  57:     out = g.copy()
  58: 
  59:     DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
  60:     OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
  61: 
  62:     for border_col in colors_present(g, exclude={bg}):
  63:         for border_coords in components_mask(g == int(border_col), connectivity=8):
  64:             if border_coords.size == 0 or int(border_coords.shape[0]) < 5:
  65:                 continue
  66: 
  67:             r0, c0, r1, c1 = (int(v) for v in bbox_coords(border_coords))
  68:             bbox = (r0, c0, r1, c1)
  69:             border_set = {(int(r), int(c)) for r, c in border_coords}
  70:             corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
  71: 
  72:             # Candidate tail spikes: single border cell on a bbox edge, not at a corner.
  73:             edges = (
  74:                 ("U", [p for p in border_set if p[0] == r0]),
  75:                 ("D", [p for p in border_set if p[0] == r1]),
  76:                 ("L", [p for p in border_set if p[1] == c0]),
  77:                 ("R", [p for p in border_set if p[1] == c1]),
  78:             )
  79:             candidates = [
  80:                 (d, cells[0]) for d, cells in edges
  81:                 if len(cells) == 1 and cells[0] not in corners
  82:             ]
  83:             if not candidates:
  84:                 continue
  85: 
  86:             # Each candidate: flood from opposite bbox side; keep candidates whose flood
  87:             # reaches content (non-bg, non-border) cells.
  88:             passing = []
  89:             for d, spike in candidates:
  90:                 mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])
  91:                 cnt = Counter()
  92:                 for r, c in mouth:
  93:                     v = int(g[r, c])
  94:                     if v != bg and v != int(border_col):
  95:                         cnt[v] += 1
  96:                 if not cnt:
  97:                     continue
  98:                 content_col = int(cnt.most_common(1)[0][0])
  99:                 content_cells = [p for p in mouth if int(g[p[0], p[1]]) == content_col]
 100:                 passing.append((d, spike, content_col, content_cells))
 101: 
 102:             # Only act on cups with an unambiguous tail.
 103:             if len(passing) != 1:
 104:                 continue
 105:             tail_dir, spike, content_col, content_cells = passing[0]
 106: 
 107:             # Erase content, then eject outward.
 108:             for r, c in content_cells:
 109:                 out[r, c] = bg
 110: 
 111:             dr, dc = DIR4[tail_dir]
 112:             sr, sc = spike
 113:             for t in range(1, len(content_cells) + 1):
 114:                 rr = sr + dr * t
 115:                 cc = sc + dc * t
 116:                 if not (0 <= rr < H and 0 <= cc < W):
 117:                     break
 118:                 out[rr, cc] = content_col
 119: 
 120:     return out
 121: 
 122: # --------------- generator (claude opus) ---------------
 123: 
 124: # ==== Generator configuration ====
 125: # Canvas size bounds (inclusive)
 126: GRID_H_RANGE = (10, 13)
 127: GRID_W_RANGE = (10, 13)
 128: 
 129: # Number of cups per grid (choices sampled uniformly)
 130: NUM_CUPS_CHOICES = (1, 2, 3)
