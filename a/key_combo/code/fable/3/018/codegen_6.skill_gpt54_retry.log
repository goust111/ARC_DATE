  15: def main(input_grid):
  16:     """
  17:     Downscale a colored rectangular partition grid to one pixel per partition.
  18: 
  19:     Input structure:
  20:     - A multicolored chessboard-like sprite sits on a black background.
  21:     - Each cell is a monochromatic rectangle and cell sizes may vary.
  22:     - Component upper-left corners define the row and column partition positions.
  23: 
  24:     Rule:
  25:     - Detect the non-black rectangular components.
  26:     - Collect sorted unique top-left row and column positions.
  27:     - Sample the input color at each position to build the compact output grid.
  28: 
  29:     Key insight:
  30:     - The output is the partition coordinate skeleton, not a proportional resize.
  31:     """
  32:     # Plan:
  33:     # 1. Find the colored regions in the input grid
  34:     # 2. Get the coordinates of the chessboard pattern, which are the x/y positions of the regions
  35:     # 3. Draw the output grid with one pixel for each region (cell of the chessboard)
  36: 
  37:     # 1. Input parsing
  38:     # Find the colored objects in the input grid
  39:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  40: 
  41:     # 2. Figuring out the chessboard pattern
  42:     # Get the position of the objects
  43:     positions = []
  44:     for obj in objects:
  45:         _b = bbox(obj != Color.BLACK)
  46:         assert _b is not None
  47:         positions.append(bbox_anchor(_b, anchor="upper left"))
  48:     r_position_list = [r for r, _c in positions]
  49:     c_position_list = [c for _r, c in positions]
  50: 
  51:     # Sort the position list, and get the unique position list since
  52:     # the pattern is separated as chessboard
  53:     r_position_list = sorted(np.unique(r_position_list))
  54:     c_position_list = sorted(np.unique(c_position_list))
  55: 
  56:     # 3. Drawing the output
  57:     # Get the size of chessboard with one pixel represents the original region
  58:     w_color, h_color = len(r_position_list), len(c_position_list)
  59:     output_grid = np.full((w_color, h_color), Color.BLACK)
  60: 
  61:     for r_index, r in enumerate(r_position_list):
  62:         for c_index, c in enumerate(c_position_list):
  63:             # Use one pixel to represent the original region
  64:             output_grid[r_index, c_index] = input_grid[r, c]
  65: 
  66:     return output_grid
