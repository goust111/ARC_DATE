    expected = np.full(wall_xor.shape, bg, dtype=int)
    expected[wall_xor] = GREEN
    sprite_color = int(next(iter(set(map(int, np.unique(sprite_panel))) - {bg})))
    for r, c in final_xor:
        assert expected[r, c] == bg
        expected[r, c] = sprite_color
    got = mod.main(inp)
    assert np.array_equal(got, expected)

print(stats)
