+def _panel_views(g: np.ndarray, sep_r: int, sep_c: int) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    return (
+        g[:sep_r, :sep_c],
+        g[:sep_r, sep_c + 1 :],
+        g[sep_r + 1 :, :sep_c],
+        g[sep_r + 1 :, sep_c + 1 :],
