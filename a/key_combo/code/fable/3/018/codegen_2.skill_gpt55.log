+    _paint(grid, decoy_a)
+    _paint(grid, decoy_b)
+    decoy_coords = _coords_of(decoy_a) + _coords_of(decoy_b)
+    _mark(occupied_in, decoy_coords)
+    _mark(occupied_out, decoy_coords)
