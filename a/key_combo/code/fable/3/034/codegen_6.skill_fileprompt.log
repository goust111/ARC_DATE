def _place_scene_objects(
    grid: np.ndarray, target: np.ndarray, markers: list[np.ndarray], distractor_colors: list[int], bg: int
) -> bool:
    placed: list[BBox] = []
    if _place_patch(grid, target, bg, placed, margin=_TARGET_MARGIN) is None:
