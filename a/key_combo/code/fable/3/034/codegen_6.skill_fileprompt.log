+        assert shifted[:, 1].min() >= 0 and shifted[:, 1].max() < g.shape[1]
+        assert np.all(out[shifted[:, 0], shifted[:, 1]] == bg), "fallen shape overlaps existing cells"
+        out[shifted[:, 0], shifted[:, 1]] = shape["color"]
