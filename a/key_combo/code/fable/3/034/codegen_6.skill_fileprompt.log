    right_vals = range(EXPANSION_RANGE[0], EXPANSION_RANGE[1] + 1) if "right" in sides else [0]
    bottom_vals = range(EXPANSION_RANGE[0], EXPANSION_RANGE[1] + 1) if "bottom" in sides else [0]
