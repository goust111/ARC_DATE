+def _damage_tile(tile: np.ndarray, tile_bg: int, anchor_color: int) -> np.ndarray | None:
+    damageable = [
+        (int(r), int(c))
+        for r, c in np.argwhere((tile != tile_bg) & (tile != anchor_color))
