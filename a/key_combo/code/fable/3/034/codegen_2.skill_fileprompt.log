+        row_sep_sizes = {r1 - r0 + 1 for r0, r1 in row_seps}
+        col_sep_sizes = {c1 - c0 + 1 for c0, c1 in col_seps}
+        if len(row_sep_sizes) != 1 or len(col_sep_sizes) != 1:
+            continue
+        if row_sep_sizes != col_sep_sizes:
