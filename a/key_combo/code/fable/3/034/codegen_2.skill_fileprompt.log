+        (int(r), int(c))
+        for r, c in np.argwhere((tile != tile_bg) & (tile != anchor_color))
+    ]
+    if len(damageable) < 2:
+        return None
+    damaged = tile.copy()
+    damage_count = random.randint(1, min(4, len(damageable) - 1))
+    for r, c in random.sample(damageable, damage_count):
+        damaged[r, c] = tile_bg
+    return damaged
+
