+            transform_idx = _find_transform_to_target(coord, canonical_anchor, tile_size)
+            if transform_idx is None:
+                valid = False
+                break
+            normalized_tiles.append(_apply_transform(tile, transform_idx))
+            normalize_transforms.append(transform_idx)
