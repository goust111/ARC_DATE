+        shape_h = max(r for r, _ in shape) + 1
+        shape_w = max(c for _, c in shape) + 1
+        if shape_h > tile_size or shape_w > tile_size:
+            continue
+        r0 = random.randint(0, tile_size - shape_h)
+        c0 = random.randint(0, tile_size - shape_w)
