+        valid_solutions.append(
+            {
+                "anchor_color": anchor_color,
+                "canonical_anchor": canonical_anchor,
+                "template": template,
+                "damaged_index": damaged_index,
+                "anchor_coords": anchor_coords,
+                "normalize_transforms": normalize_transforms,
+            }
+        )
