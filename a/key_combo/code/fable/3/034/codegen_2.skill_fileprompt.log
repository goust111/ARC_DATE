+def _infer_repair(flat_tiles: list[np.ndarray]) -> dict:
+    tile_size = int(flat_tiles[0].shape[0])
+    colors = sorted({int(color) for tile in flat_tiles for color in np.unique(tile)})
+    valid_solutions = []
