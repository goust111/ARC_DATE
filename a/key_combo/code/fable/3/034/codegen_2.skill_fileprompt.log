+
+def _neighbors4(cell: tuple[int, int]) -> Iterable[tuple[int, int]]:
+    r, c = cell
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _normalize_cells(cells: set[tuple[int, int]]) -> list[tuple[int, int]]:
