+    return damaged
+
+
+def _generate_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    tile_size, tile_rows, tile_cols = random.choice(GRID_LAYOUT_OPTIONS)
+    tile_count = tile_rows * tile_cols
+
+    colors = random.sample(PALETTE, 5)
