+import random
+from typing import Iterable
+
+import numpy as np
+
+
+PALETTE = tuple(range(10))
+TRANSFORM_COUNT = 8
+MAX_GENERATION_ATTEMPTS = 400
+TILE_SIZE_RANGE = (5, 8)
+GRID_LAYOUT_OPTIONS = tuple(
+    (tile_size, tile_rows, tile_cols)
+    for tile_size in range(TILE_SIZE_RANGE[0], TILE_SIZE_RANGE[1] + 1)
