+        covered_rows = sum(r1 - r0 + 1 for r0, r1 in row_tiles) + sum(
+            r1 - r0 + 1 for r0, r1 in row_seps
+        )
+        covered_cols = sum(c1 - c0 + 1 for c0, c1 in col_tiles) + sum(
+            c1 - c0 + 1 for c0, c1 in col_seps
+        )
+        if covered_rows != h or covered_cols != w:
+            continue
