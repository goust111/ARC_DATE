+        orbit = {
+            _transform_coord(anchor_coords[0], tile_size, transform_idx)
+            for transform_idx in range(TRANSFORM_COUNT)
+        }
+        if len(orbit) != TRANSFORM_COUNT:
+            continue
+        canonical_anchor = min(orbit)
