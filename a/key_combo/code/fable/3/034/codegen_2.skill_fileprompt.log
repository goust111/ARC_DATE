+    counts = {color: int(np.count_nonzero(tile == color)) for color in motif_colors}
+    if any(count < 2 for count in counts.values()):
+        return None
+    if int(np.count_nonzero((tile != tile_bg) & (tile != anchor_color))) < 6:
+        return None
