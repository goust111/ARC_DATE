+def _random_connected_shape(size: int) -> list[tuple[int, int]]:
+    cells = {(0, 0)}
+    while len(cells) < size:
+        frontier = {
+            neighbor
+            for cell in cells
+            for neighbor in _neighbors4(cell)
+            if neighbor not in cells
