+
+
+def _find_color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    visited = np.zeros_like(mask, dtype=bool)
+    height, width = mask.shape
+    components: list[np.ndarray] = []
