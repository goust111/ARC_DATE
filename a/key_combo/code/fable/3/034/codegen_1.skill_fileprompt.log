+def _random_mover_patch(color: int, bg: int) -> np.ndarray:
+    for _ in range(100):
+        height = random.randint(2, 4)
+        width = random.randint(2, 4)
+        max_area = min(height * width - 1, 6)
+        if max_area < 3:
+            continue
