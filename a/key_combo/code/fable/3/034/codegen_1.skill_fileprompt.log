+
+def _drop_distance(coords: np.ndarray, blocked: np.ndarray) -> int:
+    height = blocked.shape[0]
+    distance = 0
+    while True:
+        for r, c in coords:
+            nr = int(r) + distance + 1
+            nc = int(c)
+            if nr >= height or blocked[nr, nc]:
+                return distance
+        distance += 1
