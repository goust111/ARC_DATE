+    grid[top : top + table_h, cc] = wall_color
+    for width in slot_widths:
+        cc += width + 1
+        grid[top : top + table_h, cc] = wall_color
+
+    slots: list[list[tuple[int, int, int, int]]] = []
+    r = top + 1
+    for height in slot_heights:
