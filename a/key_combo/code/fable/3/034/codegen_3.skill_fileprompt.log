+    out = g.copy()
+    marker_positions: dict[int, Coord] = {}
+    for color in marker_colors:
+        marker_r, marker_c = map(int, np.argwhere(g == color)[0])
+        marker_positions[color] = (marker_r, marker_c)
+        out[marker_r, marker_c] = bg
