+        if use_horizontal:
+            anchor_r, anchor_c = map(int, row_anchors[0])
+            step = 1 if marker_c > anchor_c else -1
+            if any(g[anchor_r, c] != bg for c in range(anchor_c + step, marker_c, step)):
