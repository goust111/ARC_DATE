+def _margin_pair(design_size: int) -> tuple[int, int] | None:
+    spare = 30 - design_size
+    if spare < 2:
+        return None
+    first = random.randint(1, min(4, spare - 1))
+    second = random.randint(1, min(4, spare - first))
+    return first, second
