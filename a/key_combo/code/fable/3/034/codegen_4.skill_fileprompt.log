from itertools import product

def primitive(seq):
    p=len(seq)
    for d in range(1,p):
        if p%d==0 and all(seq[i]==seq[i%d] for i in range(p)):
            return False
    return True

def infer(obs):
    n=len(obs)
    labels=tuple(dict.fromkeys(x for x in obs if x is not None))
    cand=set()
    for p in range(1,n):
        residues=[None]*p
        ok=True
        for i,v in enumerate(obs):
            if v is None: continue
            r=i%p
            if residues[r] is None: residues[r]=v
            elif residues[r]"'!=v: ok=False; break
        if not ok: continue
        miss=[i for i,v in enumerate(residues) if v is None]
        for vals in product(labels, repeat=len(miss)) if miss else [()]:
            pat=list(residues)
            for r,v in zip(miss, vals): pat[r]=v
            pat=tuple(pat)
            if not primitive(pat):
                continue
            full=tuple(pat[i%p] for i in range(n))
            if all(v is None or v==full[i] for i,v in enumerate(obs)):
                cand.add(full)
    return cand

for n in [6,7]:
  print('"'n',n)
  for p in [2,3,4]:
    best=[]
    alph=range(4)
    seen=set()
    for seq in product(alph, repeat=p):
      if not primitive(seq):
        continue
      full=tuple(seq[i%p] for i in range(n))
      if full in seen:
        continue
      seen.add(full)
      cnt=0
      masks=[]
      for mask in range(1,1<<n):
        miss=[i for i in range(n) if mask>>i &1]
        if len(miss)>=n-1: continue
        obs=[None if i in miss else full[i] for i in range(n)]
        c=infer(obs)
        if len(c)==1 and next(iter(c))==full:
          cnt+=1; masks.append(tuple(miss))
      best.append((cnt,seq,masks[:10]))
    best.sort(reverse=True,key=lambda x:x[0])
    print(' p',p,'best',best[:5])
