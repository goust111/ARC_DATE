_GEN_OBJECT_COUNT, _GEN_HOLE_COUNT_MIN, _GEN_HOLE_COUNT_MAX = 3, 1, 3
_GEN_PADDING, _GEN_PADDING_CONNECTIVITY, _GEN_ATTEMPTS = 2, 8, 300

