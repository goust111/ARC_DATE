# Visual clockwise order on the grid: up -> right -> down -> left.
DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
TOP_DIR = 2
RIGHT_DIR = 3
BOTTOM_DIR = 0
LEFT_DIR = 1

