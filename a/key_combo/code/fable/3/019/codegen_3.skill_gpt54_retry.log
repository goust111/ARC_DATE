        for r, c in ray["blockers"]:
            out[r, c] = GREY
    return out


def _scatter_fuels(
    shape: tuple[int, int],
    rays: list[dict[str, object]],
    blueprint: np.ndarray,
) -> np.ndarray | None:
    inp = np.full(shape, BLACK, dtype=int)
