def _runs(indices: list[int]) -> list[tuple[int, int]]:
    runs = []
    start = None
    prev = None
    for idx in indices:
        if start is None:
            start = prev = int(idx)
        elif idx == prev + 1:
            prev = int(idx)
        else:
            runs.append((start, prev))
            start = prev = int(idx)
    if start is not None:
