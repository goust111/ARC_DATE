    out = _gen_expected_output(inp, n_rooms)
    if out is None:
        return None
    return inp


def generate_input() -> np.ndarray:
    target_n = random.randint(GEN_ROOM_COUNT_MIN, GEN_ROOM_COUNT_MAX)
