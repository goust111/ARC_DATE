                x = temp_parent[x]
            return x

        for edge in eligible:
            ra = find(edge["a"])
            rb = find(edge["b"])
            ta = temp_find(ra)
            tb = temp_find(rb)
            assert ta != tb
            temp_parent[tb] = ta

        for edge in eligible:
            union(edge["a"], edge["b"])
