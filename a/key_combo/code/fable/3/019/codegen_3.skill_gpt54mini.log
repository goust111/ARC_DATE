_GEN_SIZE, _GEN_BORDER = 15, 1
_GEN_RECT_MIN_SIDE, _GEN_RECT_MAX_SIDE, _GEN_HOLED_RECT_MIN_SIDE = 2, 7, 3
_GEN_HOLE_MIN_SIDE, _GEN_HOLE_BORDER = 1, 1

