                            "r1": r1,
                            "c0": c0,
                            "c1": c1,
                        }
                    )

            if a[2] < b[0] or b[2] < a[0]:
                if a[2] < b[0]:
                    upper_i, lower_i, upper, lower = i, j, a, b
                else:
