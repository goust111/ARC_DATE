        out[r1, c0 : c1 + 1] = color
        if r0 + 1 <= r1 - 1:
            out[r0 + 1 : r1, left[3]] = bg
            out[r0 + 1 : r1, right[1]] = bg
    else:
        upper = rects[edge["a"]]
        lower = rects[edge["b"]]
        out[r0 : r1 + 1, c0] = color
        out[r0 : r1 + 1, c1] = color
        if c0 + 1 <= c1 - 1:
