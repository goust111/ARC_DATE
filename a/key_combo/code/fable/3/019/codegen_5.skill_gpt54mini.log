            random.randint(GEN_LARGE_ROOM_MIN, GEN_LARGE_ROOM_FALLBACK_MAX),
            random.randint(GEN_LARGE_ROOM_MIN, GEN_LARGE_ROOM_FALLBACK_MAX),
        )
    random.shuffle(sizes)
    return sizes


def _gen_overlap_len(a0: int, a1: int, b0: int, b1: int) -> int:
    return max(0, min(a1, b1) - max(a0, b0) + 1)

