+            elif corner == "tr":
+                r, c = dr, w - 1 - dc
+            elif corner == "bl":
+                r, c = h - 1 - dr, dc
+            else:
+                r, c = h - 1 - dr, w - 1 - dc
+            if 0 <= r < h and 0 <= c < w:
+                mask[r, c] = True
