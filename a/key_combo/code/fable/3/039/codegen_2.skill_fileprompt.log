+
+    h = rng.randint(h_lo, min(30, h_lo + 4))
+    w = rng.randint(w_lo, min(30, w_lo + 4))
+    corner = rng.choice(["tl", "tr", "bl", "br"])
+    positions = _place_chains((h, w), patches, corner, code_len, rng)
+    if positions is None:
+        return None
