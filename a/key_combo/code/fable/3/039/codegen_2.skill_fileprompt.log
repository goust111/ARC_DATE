+    interiors: list[np.ndarray] = []
+    interior_sizes: list[int] = []
+    for coords in _components(g == frame_color, conn8=True):
+        inside = _frame_inside_mask(g.shape, coords)
+        if inside.any():
+            interiors.append(inside)
+            interior_sizes.append(int(inside.sum()))
