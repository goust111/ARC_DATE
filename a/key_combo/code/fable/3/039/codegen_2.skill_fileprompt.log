+        rr1 = min(h, r0 + ph + CHAIN_SEPARATION)
+        cc0 = max(0, c0 - CHAIN_SEPARATION)
+        cc1 = min(w, c0 + pw + CHAIN_SEPARATION)
+        occupancy[rr0:rr1, cc0:cc1] = True
