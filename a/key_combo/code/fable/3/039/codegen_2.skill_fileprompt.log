+
+    regions: list[tuple[np.ndarray, int, int]] = []
+    for coords in _components(g == bg):
+        sample = tuple(map(int, coords[0]))
+        enclosers = [i for i, inside in enumerate(interiors) if bool(inside[sample])]
+        if not enclosers:
+            continue
