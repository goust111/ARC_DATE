+    for patch, (r0, c0) in zip(patches, positions):
+        _paint_patch(grid, patch, r0, c0, bg)
+    _paint_code(grid, corner, code_colors)
+
+    if not _valid_generated(grid, depths):
+        return None
+    return grid
