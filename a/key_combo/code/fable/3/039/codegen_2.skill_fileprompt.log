0101: def main(grid: np.ndarray) -> np.ndarray:
0102:     """
0103:     Slide yellow pixels inside walled regions in the direction dictated by border-legend arrows.
0104: 
0105:     Input structure:
0106:     - bg = most common color; yellow pixels sit inside enclosed regions bounded by colored walls.
0107:     - Border legends: small rectangles on the grid edge whose fill color C matches a region's border color. Each legend contains a center dot and an indicator dot encoding a direction.
0108: 
0109:     Rule:
0110:     - For each enclosed region, identify its border color C and look up the legend with fill color C.
0111:     - The direction from the legend's center dot to its indicator dot gives the slide direction.
0112:     - All yellow pixels in that region slide in that direction, stacking against the far wall.
0113: 
0114:     Key insight: Legend fill color links to region border color; the center→indicator offset encodes the movement vector.
0115:     """
0116:     g = np.asarray(grid, dtype=int)
0117:     h, w = g.shape
0118:     bg = get_bg(g)
0119: 
0120:     mover = 4  # yellow in ARC
0121:     dirs = _legend_directions(g, bg)
0122:     assert dirs, "legend_directions must find at least one legend; grid should always have border legends"
0123: 
0124:     passable = (g == bg) | (g == mover)
0125:     out = g.copy()
0126: 
0127:     # Find enclosed passable regions (not connected to the outer border).
0128:     for pts in components_mask(passable, connectivity=4):
0129:         if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
0130:             continue  # outside background
0131: 
0132:         movers = [(int(r), int(c)) for r, c in pts if int(g[r, c]) == mover]
0133:         if not movers:
0134:             continue
0135: 
0136:         # Determine this region's border color by counting adjacent wall colors.
0137:         border_counts: dict[int, int] = {}
0138:         pset = {(int(r), int(c)) for r, c in pts}
0139:         for r, c in pts:
0140:             for nr, nc in neighbors4(r, c):
0141:                 if not (0 <= nr < h and 0 <= nc < w):
0142:                     continue
0143:                 if (nr, nc) in pset:
0144:                     continue
0145:                 v = int(g[nr, nc])
0146:                 if v == bg or v == mover:
0147:                     continue
0148:                 border_counts[v] = border_counts.get(v, 0) + 1
0149:         if not border_counts:
0150:             continue
