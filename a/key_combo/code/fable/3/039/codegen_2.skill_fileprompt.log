+
+
+def _paint_code(grid: np.ndarray, corner: str, colors: list[int]) -> None:
+    h, w = grid.shape
+    for i, color in enumerate(colors):
+        if corner == "tl":
+            r, c = i, i
+        elif corner == "tr":
+            r, c = i, w - 1 - i
+        elif corner == "bl":
+            r, c = h - 1 - i, i
+        else:
+            r, c = h - 1 - i, w - 1 - i
+        grid[r, c] = color
+
+
+def _analyze_depths(grid: np.ndarray) -> list[int]:
