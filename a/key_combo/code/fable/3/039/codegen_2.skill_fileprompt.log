+    except Exception:
+        return False
+
+    if inferred_depths != sorted(depths):
+        return False
+    if np.array_equal(out, grid):
+        return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    chain_count = rng.choices([1, 2, 3], weights=[1, 4, 2], k=1)[0]
+    depths = _sample_depths(chain_count, rng)
