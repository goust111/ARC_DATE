+        sizes,
+        gap_range=(1, 2),
+        max_row_cap=14,
+        pad_range=(0, 1),
+    )
+
+    patch = np.full((inner_h + 2, inner_w + 2), WALL, dtype=int)
+    chamber_coords: list[np.ndarray] = []
+    for sig, (r0, c0) in zip(order, positions):
