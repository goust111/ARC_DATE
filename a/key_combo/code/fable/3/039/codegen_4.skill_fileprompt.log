+        cells = {(0, 0)}
+        while len(cells) < area:
+            frontier = set()
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    nbr = (r + dr, c + dc)
+                    if nbr not in cells:
+                        frontier.add(nbr)
+            candidate = rng.choice(tuple(frontier))
+            trial = _normalize(cells | {candidate})
+            th, tw = _shape_dims(trial)
