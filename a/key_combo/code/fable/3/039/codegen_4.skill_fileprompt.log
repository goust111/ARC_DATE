+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    arr = arr[order]
+    return tuple((int(r), int(c)) for r, c in arr)
+
+
+def _shape_dims(sig: ShapeSig) -> tuple[int, int]:
+    rows = [r for r, _ in sig]
+    cols = [c for _, c in sig]
+    return max(rows) + 1, max(cols) + 1
