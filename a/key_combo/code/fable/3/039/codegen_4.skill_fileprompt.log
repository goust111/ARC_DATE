+
+        out = inp.copy()
+        for local_coords in chamber_coords:
+            abs_coords = local_coords + np.array([wall_y, wall_x], dtype=int)
+            sig = _normalize(local_coords)
+            out[abs_coords[:, 0], abs_coords[:, 1]] = chamber_colors[sig]
