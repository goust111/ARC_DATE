+import numpy as np
+
+
+Coord = tuple[int, int]
+ShapeSig = tuple[Coord, ...]
+
+BG = 0
+WALL = 5
+SPRITE_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+CHAMBER_COUNT_RANGE = (2, 4)
+CHAMBER_AREA_RANGE = (4, 7)
+DECOY_COUNT_RANGE = (1, 3)
+MAX_SHAPE_SPAN = 5
+MAX_GRID_SPAN = 30
+GEN_RETRIES = 500
