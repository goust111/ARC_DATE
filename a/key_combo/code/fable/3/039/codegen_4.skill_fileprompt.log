+def _paste_shape(canvas: np.ndarray, sig: ShapeSig, top: int, left: int, color: int) -> np.ndarray:
+    coords = np.asarray(sig, dtype=int)
+    canvas[top + coords[:, 0], left + coords[:, 1]] = int(color)
