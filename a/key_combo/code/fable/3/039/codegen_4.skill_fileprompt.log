+    while len(decoys) < count:
+        area = _shape_area(rng.choice(chambers)) if rng.random() < 0.8 else rng.randint(*CHAMBER_AREA_RANGE)
+        for _ in range(200):
+            sig = _random_polyomino(rng, area)
