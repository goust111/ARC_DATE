+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    wall = _infer_wall_color(g, bg)
+    h, w = g.shape
+
+    chambers: dict[ShapeSig, np.ndarray] = {}
+    for comp in _components(g == bg):
