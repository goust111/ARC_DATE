+    mask = _shape_mask(sig)
+    variants: set[ShapeSig] = set()
+    for rot in range(4):
+        rotated = np.rot90(mask, rot)
+        for arr in (rotated, np.fliplr(rotated)):
+            coords = np.argwhere(arr)
