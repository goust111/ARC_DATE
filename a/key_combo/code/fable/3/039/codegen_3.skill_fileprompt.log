+        max_top = clearance - ph - 2
+        if max_top < 1:
+            return None
+        top_low = 1
+        top_high = min(max_top, h // 2 + idx)
+        if top_high < top_low:
+            return None
+
+        placed = False
+        for _ in range(60):
+            top = random.randint(top_low, top_high)
+            box = _bbox_from_patch(patch, top, left)
+            if any(not _boxes_are_separate(box, other, margin=1) for other in placed_boxes):
