+    active_cols = [c for c in range(w) if c != legend_c]
+
+    terrain_max = max(3, min(7, h // 3))
+    profile = _random_walk_profile(len(active_cols), terrain_max)
+    terrain_top = np.full(w, h, dtype=int)
+
+    grid = np.full((h, w), BG, dtype=int)
