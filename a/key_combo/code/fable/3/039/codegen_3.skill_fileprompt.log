+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+TERRAIN = 5
+SPRITE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
