+def _build_attempt() -> np.ndarray | None:
+    h = random.randint(16, 24)
+    w = random.randint(12, 20)
+    side = random.choice(["left", "right"])
+    legend_c = 0 if side == "left" else w - 1
+    active_cols = [c for c in range(w) if c != legend_c]
+
