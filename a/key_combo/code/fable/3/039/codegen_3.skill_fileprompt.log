    return ar1 + margin < br0 or br1 + margin < ar0 or ac1 + margin < bc0 or bc1 + margin < ac0


def _paint_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int, color: int) -> np.ndarray:
    coords = np.argwhere(patch)
