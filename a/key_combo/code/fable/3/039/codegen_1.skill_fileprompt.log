+    "left": ((1, 0), (1, 1), (1, 2), (1, 3), (0, 1), (2, 1)),
+    "right": ((1, 0), (1, 1), (1, 2), (1, 3), (0, 2), (2, 2)),
+    "up": ((0, 1), (1, 1), (2, 1), (3, 1), (1, 0), (1, 2)),
+    "down": ((0, 1), (1, 1), (2, 1), (3, 1), (2, 0), (2, 2)),
