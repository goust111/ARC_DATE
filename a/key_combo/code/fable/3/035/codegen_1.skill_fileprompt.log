MIN_CENTER_DISTANCE = 6
EDGE_CENTER_PROBABILITY = 0.25
YELLOW_COUNT_RANGE = (2, 4)
YELLOW_CONNECTIVITY = 8

# Background noise and post-render density guard.
GREY_PROBABILITY_RANGE = (0.45, 0.50)
GREY_DENSITY_RANGE = (0.40, 0.55)

