+        return None
+
+    if c0 < 0 or c1 >= width or c0 > c1:
+        return None
+    if c0 > path_c1 or c1 < path_c0:
+        return None
+    if c1 - c0 + 1 <= bar_h:
+        return None
+    return (int(row0), int(c0), int(row0 + bar_h - 1), int(c1))
+
