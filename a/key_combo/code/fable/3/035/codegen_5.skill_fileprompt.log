+            box = (r0, c0, r1, c1)
+            if any(not (box[2] < other[0] or other[2] < box[0] or box[3] < other[1] or other[3] < box[1]) for other in used_boxes):
+                continue
+            grid[r0 : r1 + 1, c0 : c1 + 1] = color
