+
+def _top_support_rows(structure: np.ndarray) -> dict[int, int]:
+    support: dict[int, int] = {}
+    for c in range(structure.shape[1]):
+        rows = np.where(structure[:, c] != BLACK)[0]
+        if rows.size:
+            support[int(c)] = int(rows[0])
+    return support
