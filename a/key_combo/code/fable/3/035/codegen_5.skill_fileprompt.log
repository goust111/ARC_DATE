    rng.shuffle(interiors)
    rng.shuffle(edges)

    if not use_edge:
        return _gen_extend_centers(interiors, [], count, 0)

    for edge in edges:
        remaining = [
            point
            for point in interiors
            if abs(point[0] - edge[0]) + abs(point[1] - edge[1]) >= MIN_CENTER_DISTANCE
