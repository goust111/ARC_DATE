+    breaks: list[dict] = []
+    for seg in planned:
+        seg_len = seg["c1"] - seg["c0"] + 1
+        gap_len = int(rng.integers(1, min(3, seg_len - 4) + 1))
+        gap0 = int(rng.integers(seg["c0"] + 2, seg["c1"] - gap_len))
+        gap1 = gap0 + gap_len - 1
+        inp[seg["row"], gap0 : gap1 + 1] = BLACK
