+
+    order = sorted(range(len(pieces)), key=lambda idx: int(pieces[idx]["mask"].sum()), reverse=True)
+    placed: list[dict | None] = [None] * len(pieces)
+    for idx in order:
+        piece = pieces[idx]
+        mask = piece["mask"]
+        ph, pw = mask.shape
+        if ph > h - lower_start or pw > w - 2:
+            raise RuntimeError("piece does not fit")
+        success = False
