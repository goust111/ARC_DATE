+    valid_count = random.choice(RECT_COUNT_CHOICES)
+    noise_count = min(random.choice(NOISE_GROUP_COUNT_CHOICES), len(PALETTE) - valid_count)
+    colors = random.sample(PALETTE, valid_count + noise_count)
