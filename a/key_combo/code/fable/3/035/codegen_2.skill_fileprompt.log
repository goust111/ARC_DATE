        weights = weights / weights.sum()
        n_threes = int(np.random.choice(three_choices, p=weights))

    n_twos = extra - max_extra * n_threes
    heights = np.array(
        [RECT_HEIGHT_MAX] * n_threes
        + [RECT_HEIGHT_MID] * n_twos
        + [RECT_HEIGHT_MIN] * (n - n_twos - n_threes),
        dtype=int,
    )
