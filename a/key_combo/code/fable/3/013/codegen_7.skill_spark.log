            (r, c)
            for r in range(grid_size)
            for c in range(grid_size)
            if not occupancy[r, c]
            and not (frame_r0 <= r <= frame_r1 and frame_c0 <= c <= frame_c1)
            and _free_with_margin(occupancy, [(r, c)], margin=0)
