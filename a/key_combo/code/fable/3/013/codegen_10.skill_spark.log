+        grid = _random_scene(rng)
+        if _wall_density(grid) < 0.05 or _wall_density(grid) > 0.40:
+            continue
+        if _solve_trace_len(grid) >= 1:
+            return grid
+
+    raise RuntimeError("failed to generate a valid wall-chain puzzle input")

