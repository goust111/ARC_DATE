+    max_h = min(10, h - 3)
+    max_w = min(11, w - 3)
+    box_h = int(rng.integers(4, max_h + 1))
+    box_w = int(rng.integers(4, max_w + 1))
+    r0 = int(rng.integers(1, h - box_h - 1))
+    c0 = int(rng.integers(1, w - box_w - 1))
+    r1 = r0 + box_h - 1
+    c1 = c0 + box_w - 1
