+            newly = after_enclosed & ~current_enclosed
+            if np.any(newly):
+                candidates.append({"line": pts, "fill": newly})
+    return candidates
+
+
+def _solve_once(grid: np.ndarray, wall: int) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    return_grid = g.copy()
+    background = int(np.bincount(return_grid.ravel()).argmax())
+    for _ in range(MAX_STEPS):
+        actions = _find_candidates(return_grid, background, wall)
+        if len(actions) != 1:
+            break
+        action = actions[0]
+        line = action["line"]
+        fill = action["fill"]
+
+        for r, c in line:
+            return_grid[int(r), int(c)] = wall
+        return_grid[fill] = FILL_COLOR
+    return return_grid
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Close wall chains and recolor every newly enclosed cavity in yellow."""
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("main expects a 2D grid")
+
+    background = int(np.bincount(g.ravel()).argmax())
+    colors = [int(v) for v in np.unique(g) if int(v) != background and int(v) != FILL_COLOR]
+    wall = int(max(colors, default=WALL_COLOR))
+
+    out = g.copy()
+    for _ in range(MAX_STEPS):
+        actions = _find_candidates(out, background, wall)
+        if len(actions) != 1:
+            break
+        action = actions[0]
+        for r, c in action["line"]:
+            out[int(r), int(c)] = wall
+        out[action["fill"]] = FILL_COLOR
+    return out
+
+
+def _random_grid(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(16, 29))
+    w = int(rng.integers(16, 29))
+    grid = np.full((h, w), BG_COLOR, dtype=int)
