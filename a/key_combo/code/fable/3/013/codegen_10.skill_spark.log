+    if rng.random() < 0.45:
+        grid = grid.T
+    return grid
+
+
+def _wall_density(grid: np.ndarray) -> float:
+    return float(np.mean(grid == WALL_COLOR))
+
+
+def _solve_trace_len(grid: np.ndarray) -> int:
+    current = grid.copy()
+    background = int(np.bincount(current.ravel()).argmax())
+    step = 0
