+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    dr = r1 - r0
+    dc = c1 - c0
+    if dr == 0 and dc == 0:
+        return []
+    if dr == 0:
+        step = 1 if dc > 0 else -1
+        return [(r0, c0 + i * step) for i in range(abs(dc) + 1)]
+    if dc == 0:
+        step = 1 if dr > 0 else -1
+        return [(r0 + i * step, c0) for i in range(abs(dr) + 1)]
+    if abs(dr) == abs(dc):
