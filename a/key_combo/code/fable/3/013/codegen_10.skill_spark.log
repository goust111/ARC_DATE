+        if _solve_trace_len(candidate) >= 2:
+            return candidate
+    return None
+
+
+def generate_input() -> np.ndarray:
+    """Create a valid ARC input with a deterministic chain-enclosure wall progression."""
+    rng = np.random.default_rng()
+    want_multi = rng.random() < MULTISTEP_PROB
