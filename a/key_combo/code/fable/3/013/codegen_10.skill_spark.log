+        if r + 1 < h and wall_mask[r + 1, c]:
+            deg += 1
+        if c > 0 and wall_mask[r, c - 1]:
+            deg += 1
+        if c + 1 < w and wall_mask[r, c + 1]:
+            deg += 1
+        if deg == 1:
+            endpoints.append((r, c))
