import numpy as np
import random
from collections import deque

BG=0; WALL=8; Y=4

def endpoints(grid):
    H,W=grid.shape
    pts=[]
    for r in range(H):
        for c in range(W):
            if grid[r,c]"'!=WALL: continue
            deg=0
            if r>0 and grid[r-1,c]==WALL: deg+=1
            if r+1<H and grid[r+1,c]==WALL: deg+=1
            if c>0 and grid[r,c-1]==WALL: deg+=1
            if c+1<W and grid[r,c+1]==WALL: deg+=1
            if deg==1: pts.append((r,c))
    return pts

def line_points(a,b):
    r0,c0=a; r1,c1=b
    dr=r1-r0; dc=c1-c0
    if dr==0:
        if c0==c1: return []
        s=1 if dc>0 else -1
        return [(r0,c0+i*s) for i in range(abs(dc)+1)]
    if dc==0:
        s=1 if dr>0 else -1
        return [(r0+i*s,c0) for i in range(abs(dr)+1)]
    if abs(dr)==abs(dc):
        sr=1 if dr>0 else -1
        sc=1 if dc>0 else -1
        return [(r0+i*sr,c0+i*sc) for i in range(abs(dr)+1)]
    return []

def enclosed_mask(grid):
    H,W=grid.shape
    bg=(grid==BG)
    vis=np.zeros((H,W),bool)
    q=deque()
    for c in range(W):
        if bg[0,c] and not vis[0,c]: vis[0,c]=True;q.append((0,c))
        if bg[H-1,c] and not vis[H-1,c]: vis[H-1,c]=True;q.append((H-1,c))
    for r in range(H):
        if bg[r,0] and not vis[r,0]: vis[r,0]=True;q.append((r,0))
        if bg[r,W-1] and not vis[r,W-1]: vis[r,W-1]=True;q.append((r,W-1))
    while q:
      r,c=q.popleft()
      for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<H and 0<=cc<W and bg[rr,cc] and not vis[rr,cc]:
          vis[rr,cc]=True; q.append((rr,cc))
    return bg & (~vis)

def step_candidates(g):
    eps=endpoints(g)
    before=enclosed_mask(g)
    cand=[]
    for i in range(len(eps)):
      for j in range(i+1,len(eps)):
        pts=line_points(eps[i],eps[j])
        if not pts: continue
        ok=True
        for r,c in pts[1:-1]:
          if g[r,c]!=BG:
            ok=False;break
        if not ok: continue
        tmp=g.copy()
        for r,c in pts:
          tmp[r,c]=WALL
        after=enclosed_mask(tmp)
        new=after & (~before)
        if new.any():
          cand.append((eps[i],eps[j],pts,int(new.sum())))
    return cand

def solve_trace(g,max_steps=10):
    g=g.copy(); out=[]
    for _ in range(max_steps):
      c=step_candidates(g)
      if len(c)!=1:
        return out
      a,b,pts,n=c[0]
      for rr,cc in pts:
        g[rr,cc]=WALL
      enc=enclosed_mask(g)
      if enc.any(): g[enc]=Y
      out.append((a,b,n))
    return out

def draw_open_box(g,r0,c0,r1,c1,missing='"'right'):
    # three edges
    if missing"'!='"'top':
        g[r0,c0:c1+1]=WALL
    if missing"'!='"'bottom':
        g[r1,c0:c1+1]=WALL
    if missing"'!='"'left':
        g[r0:r1+1,c0]=WALL
    if missing"'!='"'right':
        g[r0:r1+1,c1]=WALL

def random_base(H,W):
    g=np.full((H,W),BG,dtype=int)
    nboxes=random.randint(1,4)
    for _ in range(nboxes):
      h=random.randint(4,min(9,H-2))
      w=random.randint(4,min(9,W-2))
      r0=random.randint(1,H-h-1)
      c0=random.randint(1,W-w-1)
      r1=r0+h-1; c1=c0+w-1
      miss=random.choice(['top','bottom','left','right'])
      draw_open_box(g,r0,c1-r1 if False else c0,r1,c1,miss)
    # random short segments
    for _ in range(random.randint(6,14)):
      typ=random.choice(['h','v','d'])
      if typ=='h':
        r=random.randint(1,H-2); l=random.randint(2,7)
        c0=random.randint(1,W-l-1)
        for c in range(c0,c0+l):
          if random.random()<0.9: g[r,c]=WALL
      elif typ=='v':
        c=random.randint(1,W-2); l=random.randint(2,7)
        r0=random.randint(1,H-l-1)
        for r in range(r0,r0+l):
          if random.random()<0.9: g[r,c]=WALL
      else:
        l=random.randint(3,8)
        r0=random.randint(1,H-l-1); c0=random.randint(1,W-l-1)
        for t in range(l):
          if random.random()<0.95: g[r0+t,c0+t]=WALL
    return g

random.seed(0)
from collections import Counter
cnt=Counter()
for attempt in range(500):
    H=random.randint(18,28)
    W=random.randint(18,28)
    g=random_base(H,W)
    s=solve_trace(g,20)
    cnt[len(s)]+=1
    if len(s)>=2:
      pass
print(cnt)
