        for dr, dc in _GEN_DIRS4:
            nr, nc = r+dr, c+dc
            if (nr, nc) in track_set and (nr, nc) not in dist:
                dist[(nr, nc)] = dist[(r, c)] + 1
                q.append((nr, nc))
