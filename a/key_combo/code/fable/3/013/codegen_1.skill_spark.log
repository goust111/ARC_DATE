+        # Keep only geometry and boundary branch coverage checks.
+        if len(path) <= 1:
+            continue
+        sr, sc = start
+        right_panel[sr, sc] = START
+        return right_panel, painted
+    raise RuntimeError("failed to place a non-overlapping path on right panel")
+
+
