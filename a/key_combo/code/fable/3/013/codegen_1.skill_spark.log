    separator = np.full((H, panel_sep), int(sep_color), dtype=int)
    return np.concatenate([left_panel, separator, right_panel], axis=1)


def _program_from_path_constraints(
    height: int,
    right_w: int,
    sep_right: int,
    W: int,
    commands: list[tuple[int, int]],
