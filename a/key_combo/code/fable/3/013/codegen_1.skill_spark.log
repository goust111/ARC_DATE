+    panel_top = 0
+    panel_left = sep_right + 1
+    panel_bottom = panel[0] - 1
+    panel_right = W - 1
+
+    if not (panel_left <= sc < W):
+        raise ValueError("start is not in the right panel")
+
+    sides: list[str] = []
+    if sr == panel_top:
+        sides.append("top")
+    if sr == panel_bottom:
+        sides.append("bottom")
+    if sc == panel_left:
+        sides.append("left")
+    if sc == panel_right:
+        sides.append("right")
+    if not sides:
+        raise ValueError("start must lie on the boundary of right panel")
+    return sides
