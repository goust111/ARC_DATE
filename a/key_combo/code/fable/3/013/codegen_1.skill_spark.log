+    r, c = sr_local, sc_local
+    visited = {(r, c)}
+    for color, thickness in commands:
+        dr, dc = _turn((dr, dc), color)
+        for _ in range(thickness):
+            r += dr
+            c += dc
+            if not in_bounds((right_panel.shape[0], right_panel.shape[1]), r, c):
