+    if len(candidates) == 1:
+        return candidates[0]
+
+    # Deterministic tie-break: prefer moving from panel side into interior first.
+    for prefer in ((0, 1), (1, 0), (0, -1), (-1, 0)):
+        if prefer in candidates:
+            return prefer
+    raise ValueError("ambiguous start direction")
