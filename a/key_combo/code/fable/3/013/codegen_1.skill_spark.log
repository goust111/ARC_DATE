    n = mask.shape[0]
    for _ in range(80):
        if axis == "h":
            if n // 2 == 0:
                return False
            r = int(rng.integers(0, n // 2))
            c = int(rng.integers(0, n))
            mc = n - 1 - c
            rr = n - 1 - r
            if c == mc:
                continue
            if mask[r, c] or mask[rr, c] or mask[r, mc] or mask[rr, mc]:
                continue
            mask[r, c] = True
            mask[rr, c] = True
            return True

        if axis == "v":
            if n // 2 == 0:
                return False
            c = int(rng.integers(0, n // 2))
            r = int(rng.integers(0, n))
            mr = n - 1 - r
            cc = n - 1 - c
            if r == mr:
                continue
            if mask[r, c] or mask[r, cc] or mask[mr, c] or mask[mr, cc]:
                continue
            mask[r, c] = True
            mask[r, cc] = True
            return True

    return False


