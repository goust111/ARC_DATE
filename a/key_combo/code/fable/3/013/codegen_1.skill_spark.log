+    c = 0
+    for color, steps in commands:
+        panel[:, c : c + steps] = int(color)
+        c += steps
+    return panel
+
+
+def _random_start_and_direction(height: int, width: int, sep_right: int, W: int, rng: np.random.Generator) -> tuple[tuple[int, int], tuple[int, int], str]:
+    # Start must lie on the right-panel boundary; avoid panel corners to keep direction unique.
+    side = int(rng.integers(0, 4))
+    if side == 0 and width >= 3:  # left panel boundary
+        r = int(rng.integers(1, height - 1))
+        c_local = 0
+    elif side == 1 and width >= 3:  # top
+        r = 0
+        c_local = int(rng.integers(1, width - 1))
+    elif side == 2 and width >= 3:  # right
+        r = int(rng.integers(1, height - 1))
+        c_local = width - 1
+    else:  # bottom
+        r = height - 1
+        c_local = int(rng.integers(1, width - 1)) if width > 2 else 0
