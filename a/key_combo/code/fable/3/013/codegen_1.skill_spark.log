    if sr == panel_bottom:
        sides.append(\"bottom\")
    if sc == panel_left:
        sides.append(\"left\")
    if sc == panel_right:
        sides.append(\"right\")
    if not sides:
        raise ValueError(\"start must lie on the boundary of right panel\")
