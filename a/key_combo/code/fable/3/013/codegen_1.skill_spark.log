        c = int(rng.integers(col_lo, col_hi))
        if axis_to_break == "v":
            mc = mask.shape[1] - 1 - c
            if c == mc or mask[r, c] or mask[r, mc]:
                continue
            mask[r, c] = True
            return True
        if axis_to_break == "h":
            mr = mask.shape[0] - 1 - r
            if r == mr or mask[r, c] or mask[mr, c]:
                continue
            mask[r, c] = True
            return True

