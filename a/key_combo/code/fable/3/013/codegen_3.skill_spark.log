in_bounds = _ARC_UTILS.in_bounds


RIGHT_TURN = Color.RED
LEFT_TURN = Color.TEAL
STRAIGHT = Color.YELLOW
DIVIDER = Color.GRAY
START = Color.GREEN
BACKGROUND = Color.BLACK

DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left (clockwise)


def _turn(direction: tuple[int, int], command: int) -> tuple[int, int]:
    d = DIRS.index(tuple(direction))
    if command == RIGHT_TURN:
        d = (d + 1) % 4
    elif command == LEFT_TURN:
        d = (d - 1) % 4
    elif command == STRAIGHT:
        pass
    else:
        raise ValueError("unsupported command color")
    return DIRS[d]


def _find_separator(g: np.ndarray) -> tuple[int, int, int]:
    H, W = g.shape
    runs: list[tuple[int, int, int]] = []
    c = 0
    while c < W:
        col = g[:, c]
        if not np.all(col == int(col[0])):
            c += 1
            continue
        color = int(col[0])
        s = c
        while c + 1 < W and np.all(g[:, c + 1] == color):
            c += 1
        e = c
        if 0 < s and e < W - 1:
            runs.append((s, e, color))
        c += 1

    candidates = [run for run in runs if run[2] in {DIVIDER, Color.GRAY}]
    if not candidates:
        candidates = [run for run in runs if run[2] not in {BACKGROUND, START, RIGHT_TURN, LEFT_TURN, STRAIGHT}]
    assert candidates, "expected one full-height separator run"

    # Prefer the thinest non-border separator candidate.
    runs_sorted = sorted(candidates, key=lambda item: (item[1] - item[0] + 1, item[0], item[2]))
    return runs_sorted[0]


def _decode_program(left_panel: np.ndarray) -> list[tuple[int, int]]:
    H, W = left_panel.shape
    assert W > 0, "left panel is empty"

    cmds: list[tuple[int, int]] = []
    c = 0
    while c < W:
        col = left_panel[:, c]
        assert np.all(col == int(col[0])), "left panel stripe must be full-height"
        color = int(col[0])
        if color not in {RIGHT_TURN, LEFT_TURN, STRAIGHT}:
            raise ValueError("left panel uses unsupported stripe color")
        s = c
        while c + 1 < W and np.all(left_panel[:, c + 1] == color):
            c += 1
        e = c
        cmds.append((color, e - s + 1))
        c += 1
    return cmds


def _boundary_sides(sr: int, sc: int, panel: tuple[int, int], sep_right: int, W: int) -> list[str]:
    panel_top = 0
    panel_left = sep_right + 1
    panel_bottom = panel[0] - 1
    panel_right = W - 1

    if not (panel_left <= sc < W):
        raise ValueError("start is not in the right panel")

    sides: list[str] = []
    if sr == panel_top:
        sides.append("top")
    if sr == panel_bottom:
        sides.append("bottom")
    if sc == panel_left:
        sides.append("left")
    if sc == panel_right:
        sides.append("right")
    if not sides:
        raise ValueError("start must lie on the boundary of right panel")
    return sides


def _start_direction(sr: int, sc: int, panel_shape: tuple[int, int], sep_right: int, W: int) -> tuple[int, int]:
    sides = _boundary_sides(sr, sc, panel_shape, sep_right, W)
    candidates = []
    for s in sides:
        if s == "left":
            candidates.append((0, 1))
        if s == "right":
            candidates.append((0, -1))
        if s == "top":
            candidates.append((1, 0))
        if s == "bottom":
            candidates.append((-1, 0))

    if len(candidates) == 1:
        return candidates[0]

    # Deterministic tie-break: prefer moving from panel side into interior first.
    for prefer in ((0, 1), (1, 0), (0, -1), (-1, 0)):
        if prefer in candidates:
            return prefer
    raise ValueError("ambiguous start direction")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw a turning path in the right panel according to the left-program stripes.

    Input structure:
    - The grid is split by a vertical full-height divider into a left panel, divider, right panel.
    - The left panel is filled with full-height vertical stripes; each stripe color is red, cyan/teal, or yellow.
    - The stripe thickness equals how many steps to walk, and each stripe color controls turning.
    - The right panel is black except for one green start pixel on its boundary.

    Rule:
    - Read stripe colors from left to right in the left panel; each stripe yields one instruction: color as turn and width as step count.
    - Start at the green boundary pixel in the right panel, initially pointing from the boundary toward panel interior.
    - For each instruction: rotate by color (red=right turn, cyan/teal=left turn, yellow=straight), then move exactly the stripe thickness steps, painting every visited cell green.
    - The right panel has no overlaps in valid inputs and may be shorter than the full grid.

    Key insight:
    - The left panel is not geometric art but an explicit trajectory program; stripe thickness is path length, not decorative thickness.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "input must be non-empty 2D"
    H, W = g.shape

    sep_left, sep_right, _sep_color = _find_separator(g)
    left_panel = g[:, :sep_left]
    right_panel = g[:, sep_right + 1 :]

    start = coords_where(right_panel == START)
    assert start.shape == (1, 2), "expected exactly one green start pixel"
    sr_local, sc_local = map(int, start[0])
    sr_abs = sr_local
    sc_abs = sc_local + sep_right + 1

    commands = _decode_program(left_panel)
    dr, dc = _start_direction(sr_abs, sc_abs, right_panel.shape, sep_right, W)

    out = right_panel.copy()
    out[sr_local, sc_local] = START

    r, c = sr_local, sc_local
    visited = {(r, c)}
    for color, thickness in commands:
        dr, dc = _turn((dr, dc), color)
        for _ in range(thickness):
            r += dr
            c += dc
            if not in_bounds((right_panel.shape[0], right_panel.shape[1]), r, c):
                raise AssertionError("path leaves right panel")
            if (r, c) in visited:
                raise AssertionError("path overlaps itself")
            visited.add((r, c))
            out[int(r), int(c)] = START

    return out.astype(int)


def _paint_path_in_panel(
    panel_shape: tuple[int, int],
    start: tuple[int, int],
    direction: tuple[int, int],
    commands: Iterable[tuple[int, int]],
) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
    H, W = map(int, panel_shape)
    dr, dc = map(int, direction)
    out = np.full((H, W), BACKGROUND, dtype=int)
    out[start] = START

    visited = {start}
    path: list[tuple[int, int]] = [start]
    cmds: list[tuple[int, int]] = []
    r, c = map(int, start)

    for color, steps in commands:
        if steps <= 0:
            raise ValueError("thickness must be positive")
        dr, dc = _turn((dr, dc), int(color))
        r2, c2 = r, c
        for _ in range(int(steps)):
            r2 += dr
            c2 += dc
            if not in_bounds((H, W), r2, c2):
                raise ValueError("path exits right panel")
            if (r2, c2) in visited:
                raise ValueError("path overlaps itself")

