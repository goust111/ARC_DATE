+    c0 = random.randint(0, max(0, w // 2 - left_w))
+    c1 = c0 + left_w - 1
+    mask = np.zeros((h, w), dtype=bool)
+    if w % 2 == 1:
+        center = w // 2
+        c_pairs = list(range(-left_w, left_w + 1))
+        for c in c_pairs:
+            cc_left = center + c
+            cc_right = center - c
+            if 0 <= cc_left < w:
+                mask[r0 : r1 + 1, cc_left] = True
+            if 0 <= cc_right < w:
+                mask[r0 : r1 + 1, cc_right] = True
+    else:
