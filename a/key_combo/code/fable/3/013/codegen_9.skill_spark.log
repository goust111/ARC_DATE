+    if qc == 0:
+        col_min = c0
+        col_max = c0 + half_w - 2
+    else:
+        col_min = c0 + half_w
+        col_max = c1 - 1
+
+    if row_min > row_max or col_min > col_max:
+        raise ValueError("main: panel too small for quadrant marker placement")
+
+    return random.randint(row_min, row_max), random.randint(col_min, col_max)
+
+
