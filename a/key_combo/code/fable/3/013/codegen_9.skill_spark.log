+def _block_quadrant(top_left: tuple[int, int], panel_box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r, c = top_left
+    r0, c0, r1, c1 = panel_box
+    mid_r = (r0 + r1 + 1) / 2
+    mid_c = (c0 + c1 + 1) / 2
+    return (0 if r + 0.5 < mid_r else 1, 0 if c + 0.5 < mid_c else 1)
