+        raise AssertionError("main: mirrored position falls outside panel")
+
+    out = g.copy()
+    out[dest_r : dest_r + 2, dest_c : dest_c + 2] = missing_color
+    return out
+
+
+def _candidate_marker_pos(
+    panel_box: tuple[int, int, int, int], quadrant: tuple[int, int]
+) -> tuple[int, int]:
