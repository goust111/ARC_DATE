+
+
+def _extract_markers(
+    grid: np.ndarray,
+    panel_color: int,
+    panel_box: tuple[int, int, int, int],
+) -> tuple[dict[int, tuple[int, int]], dict[tuple[int, int], tuple[int, int]]]:
