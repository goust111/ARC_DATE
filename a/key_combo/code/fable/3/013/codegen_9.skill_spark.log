+    half_h = h // 2
+    half_w = w // 2
+    qr, qc = quadrant
+
+    if qr == 0:
+        row_min = r0
+        row_max = r0 + half_h - 2
+    else:
+        row_min = r0 + half_h
+        row_max = r1 - 1
