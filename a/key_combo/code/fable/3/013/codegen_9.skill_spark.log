+
+def _find_thumbnail(grid: np.ndarray, bg: int, panel_box: tuple[int, int, int, int]) -> tuple[int, int]:
+    h, w = grid.shape
+    corners = [(0, 0), (0, w - 2), (h - 2, 0), (h - 2, w - 2)]
+    candidates: list[tuple[int, int]] = []
+    pr0, pc0, pr1, pc1 = panel_box
