+        grid[legend_r0 + 1 : legend_r1, legend_c0 + 1 : legend_c1] = BACKGROUND
+        grid[legend_r0 + 1 : legend_r1, legend_c0 + 1 : legend_c1] = BACKGROUND
+        # fill interior background explicitly (inner area), keep border frame
