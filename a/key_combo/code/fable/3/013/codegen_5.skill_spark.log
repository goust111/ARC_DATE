+    bars: dict[int, dict[str, int]] = {}
+    for color in np.unique(grid):
+        c = int(color)
+        if c in {bg, ring_color}:
+            continue
+        for comp in components_mask(grid == c, connectivity=4):
+            if comp.size == 0:
