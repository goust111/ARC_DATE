+
+def _area_dims(area: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for h in range(2, 9):
+        if area % h != 0:
+            continue
+        w = area // h
+        if w >= 2 and w <= 8:
+            out.append((h, w))
+    return out
+
+
+def _try_place_ring(grid: np.ndarray, occ: np.ndarray, area: int, rng: np.random.Generator) -> bool:
+    dims = _area_dims(area)
+    if not dims:
+        return False
+    h, w = choice(dims)
+    outer_h, outer_w = h + 2, w + 2
