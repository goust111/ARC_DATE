+            if local_bg[x, y]:
+                outside[x, y] = True
+                q.append((x, y))
+    for y in range(W):
+        for x in (0, H - 1):
+            if local_bg[x, y] and not outside[x, y]:
+                outside[x, y] = True
+                q.append((x, y))
