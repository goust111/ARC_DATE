MARKER_TOTAL_MIN, MARKER_TOTAL_MAX_EXCLUSIVE = 3, 8
MARKERS_PER_SPRITE_MIN, MARKERS_PER_SPRITE_MAX = 1, 4
SINGLE_COLOR_MIN_TOTAL, SINGLE_COLOR_PROB = 4, 0.45
DISTRACTOR_MARKER_COUNT, PARITY_CLASSES = 2, (0, 1)

