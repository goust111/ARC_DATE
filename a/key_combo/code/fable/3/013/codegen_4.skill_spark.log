def _random_subset_of(mask: np.ndarray, density: float) -> np.ndarray | None:
    idx = np.flatnonzero(mask.ravel())
    if len(idx) == 0:
        return None

    for _ in range(128):
        keep = np.random.random(len(idx)) < float(density)
        if not keep.any():
