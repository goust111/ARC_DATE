+def _place_horizontal_pair(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    color_left: int,
+    color_right: int,
+    fixed_row: int | None = None,
+    min_left_col: int = 0,
+) -> dict | None:
+    H, W = grid.shape
