    blocked = set(forbidden)
    choices = []
    for parity in PARITY_CLASSES:
        cells = [(r, c) for r in range(h) for c in range(w) if (r + c) % 2 == parity]
        if len(cells) < count:
            continue
        for combo in itertools.combinations(cells, count):
            if _gen_norm_signature(combo) not in blocked:
