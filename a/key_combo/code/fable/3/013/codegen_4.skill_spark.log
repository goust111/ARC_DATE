+                side = "left"
+            else:
+                raise AssertionError("cannot determine notch opening side")
+        else:
+            if mc - 1 >= 0 and int(patch[mr, mc - 1]) == color:
+                side = "right"
+            else:
+                raise AssertionError("cannot determine notch opening side")
