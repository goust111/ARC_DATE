+        global_r = int(r0 + mr)
+        global_c = int(c0 + mc)
+
+        if mr == 0:
+            if mr + 1 < h and int(patch[mr + 1, mc]) == color:
+                side = "top"
+            else:
+                raise AssertionError("cannot determine notch opening side")
+        elif mr == h - 1:
+            if mr - 1 >= 0 and int(patch[mr - 1, mc]) == color:
+                side = "bottom"
+            else:
+                raise AssertionError("cannot determine notch opening side")
+        elif mc == 0:
