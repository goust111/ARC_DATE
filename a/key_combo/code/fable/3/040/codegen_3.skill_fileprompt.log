+                    area = _bbox_area(body_bbox)
+                    inside = (rows >= r0) & (rows <= r1) & (cols >= c0) & (cols <= c1)
+                    if int(inside.sum()) != area:
+                        continue
+                    signature = _stem_signature(rows[~inside], cols[~inside], body_bbox)
+                    if signature is None:
+                        continue
