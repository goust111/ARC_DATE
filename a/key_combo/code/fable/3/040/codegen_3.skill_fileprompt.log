+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BBox = tuple[int, int, int, int]
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+OPPOSITE = {
+    "up": "down",
