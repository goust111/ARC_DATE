+def _random_code() -> np.ndarray:
+    count = random.choice(MARKER_COUNT_CHOICES)
+    code = np.zeros((COARSE_SIDE, COARSE_SIDE), dtype=bool)
+    for idx in random.sample(range(COARSE_SIDE * COARSE_SIDE), count):
