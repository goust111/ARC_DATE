+                block = patch[
+                    br * BLOCK_SIDE : (br + 1) * BLOCK_SIDE,
+                    bc * BLOCK_SIDE : (bc + 1) * BLOCK_SIDE,
+                ].copy()
+                marker_cells = [tuple(map(int, rc)) for rc in np.argwhere(block == marker)]
+                if len(marker_cells) <= 1:
+                    continue
+                rr, cc = random.choice(marker_cells)
+                block[rr, cc] = fill
+                patch[
+                    br * BLOCK_SIDE : (br + 1) * BLOCK_SIDE,
+                    bc * BLOCK_SIDE : (bc + 1) * BLOCK_SIDE,
+                ] = block
