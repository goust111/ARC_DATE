+        assert np.all((0 <= shifted[:, 0]) & (shifted[:, 0] < g.shape[0]))
+        assert np.all((0 <= shifted[:, 1]) & (shifted[:, 1] < g.shape[1]))
+        assert np.all(out[shifted[:, 0], shifted[:, 1]] == bg), "translated sprites must not overlap"
