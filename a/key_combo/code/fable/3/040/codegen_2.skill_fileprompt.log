+        for combo in itertools.combinations(pool, k):
+            damage = np.array(combo, dtype=int)
+            if side == "up" and not np.all(damage[:, 0] < center_r):
+                continue
+            if side == "down" and not np.all(damage[:, 0] > center_r):
+                continue
