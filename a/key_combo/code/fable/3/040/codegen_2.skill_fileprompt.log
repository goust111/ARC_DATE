+    if np.all(damage_coords[:, 0] > center_r):
+        options.append((float(damage_coords[:, 0].mean()) - center_r, "down"))
+    if np.all(damage_coords[:, 1] < center_c):
+        options.append((center_c - float(damage_coords[:, 1].mean()), "left"))
