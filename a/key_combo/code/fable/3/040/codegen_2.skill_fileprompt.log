    max_k = min(4, len(pool))
    choices=[]
    for k in range(1, max_k+1):
        for comb in itertools.combinations(pool, k):
            arr = np.array(comb, dtype=int)
            if side == 'up' and not np.all(arr[:,0] < cr):
