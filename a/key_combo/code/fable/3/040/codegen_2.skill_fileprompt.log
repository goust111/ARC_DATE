def frontier_candidates(coords, side):
    cr = coords[:,0].mean()
    cc = coords[:,1].mean()
    pts = [tuple(map(int, rc)) for rc in coords.tolist()]
    if side == 'up':
        pool = [p for p in pts if p[0] < cr]
        if not pool:
            return []
        levels = sorted({p[0] for p in pool})[:2]
        pool = [p for p in pool if p[0] in levels]
        pool.sort(key=lambda p: (p[0], abs(p[1]-cc), p[1]))
    elif side == 'down':
