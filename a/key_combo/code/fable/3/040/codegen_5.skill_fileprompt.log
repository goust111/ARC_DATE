+        for r in range(r0, r1 + 1):
+            if r in wall_by_row and wall_by_row[r] != wall_col:
+                return None
+            wall_by_row[r] = wall_col
+            if grid[r, wall_col] != BG:
+                return None
+            grid[r, wall_col] = WALL
+
