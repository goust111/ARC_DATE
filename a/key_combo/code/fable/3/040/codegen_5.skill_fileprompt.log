+
+    colors = random.sample(PALETTE, n_sprites)
+    row_to_cols: dict[int, list[int]] = {}
+    sprite_rows: list[list[int]] = []
+
+    for cells, top, left, color in zip(sprites, tops, lefts, colors):
+        rows_here = set()
+        for dr, dc in cells:
