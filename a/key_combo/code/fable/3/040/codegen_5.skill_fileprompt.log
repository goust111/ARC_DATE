+def _random_split(total: int, parts: int) -> list[int]:
+    cuts = sorted(random.sample(range(total + parts - 1), parts - 1)) if parts > 1 else []
+    values = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
+        values.append(cut - prev - 1)
+        prev = cut
+    return values
