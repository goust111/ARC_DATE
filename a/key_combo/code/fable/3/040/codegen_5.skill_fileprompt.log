+BG = 0
+MIRROR = 5
+WALL = 9
+PALETTE = (1, 2, 3, 4, 6, 7, 8)
+GEN_ATTEMPTS = 600
+
+
+PRIMARY_SPRITES = (
+    ((0, 0), (1, 0), (1, 1), (2, 1), (3, 1)),
+    ((0, 1), (1, 0), (1, 1), (2, 0), (3, 0)),
+    ((0, 0), (1, 0), (2, 0), (2, 1), (3, 1)),
+    ((0, 0), (0, 1), (1, 1), (2, 1), (3, 1)),
+)
+
