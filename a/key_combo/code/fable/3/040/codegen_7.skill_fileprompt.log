+
+def _side_is_informative(bits: np.ndarray, height: int, width: int) -> bool:
+    for indices in _side_ranges(height, width):
+        side = bits[indices]
+        if not np.any(side == 1):
+            return False
+        if not np.any(side == 0):
+            return False
+    return True
+
+
