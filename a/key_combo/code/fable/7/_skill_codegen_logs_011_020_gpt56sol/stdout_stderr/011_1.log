+    for row in range(1, height - 1):
+        row_runs = _runs(np.flatnonzero(g[row] == obstacle_color))
+        if row_runs:
+            obstacles_by_row[row] = row_runs
+
+    return bg, source_color, obstacle_color, source_cols, palette, obstacles_by_row
