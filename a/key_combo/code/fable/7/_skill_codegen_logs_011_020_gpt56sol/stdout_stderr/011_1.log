+    middle_colors = set(map(int, np.unique(g[1:-1]))) - {bg} - set(palette)
+    assert len(middle_colors) == 1, "expected one common obstacle color"
+    obstacle_color = next(iter(middle_colors))
+    assert obstacle_color != source_color
