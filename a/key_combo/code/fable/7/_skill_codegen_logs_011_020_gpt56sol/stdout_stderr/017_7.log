    if len(rects) != RECT_COUNT:
        return None

    hidden = _gen_place_holes_29ec7d0e(p, rects)
    if hidden is None:
        return None

    inp = out.copy()
    inp[hidden] = 0
    if not np.array_equal(main(inp), out):
        return None
    return inp
