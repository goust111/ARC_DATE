+        q = [(r, c)]
+        comp = []
+        while q:
+            x, y = q.pop()
+            comp.append((x, y))
+            for dx, dy in DIR4:
+                nx, ny = x + dx, y + dy
+                if 0 <= nx < h and 0 <= ny < w and mask[nx, ny] and not seen[nx, ny]:
+                    seen[nx, ny] = True
+                    q.append((nx, ny))
