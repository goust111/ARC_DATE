from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/015/2.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
out_sigs = set()
shapes = set()
starts = set()
tape_orients = set()
seen_colors = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    shapes.add(inp.shape)
    sr, sc = np.argwhere(inp == mod.RED)[0]
    starts.add('down' if sr == 0 else 'up')
    q, cells = mod._instruction_queue(inp)
    seen_colors.update(q)
    tape_orients.add('horizontal' if cells[0][0] == cells[1][0] else 'vertical')
    assert np.all(out[inp == mod.GREY] == mod.GREY)
    assert np.all(out[(inp == mod.BLUE) | (inp == mod.GREEN)] == mod.BG)
print('variants', len(sigs))
print('output_variants', len(out_sigs), 'shapes', len(shapes), 'starts', starts, 'tapes', tape_orients, 'instructions', seen_colors)
assert len(sigs) >= 20
assert len(out_sigs) == len(sigs)
assert starts == {'up', 'down'}
assert tape_orients == {'horizontal', 'vertical'}
assert seen_colors == {mod.BLUE, mod.GREEN}
