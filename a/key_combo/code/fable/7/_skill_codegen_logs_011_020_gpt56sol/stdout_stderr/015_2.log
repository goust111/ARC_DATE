+        ar, ac = a
+        br, bc = b
+        assert ar == br or ac == bc
+        sr = 0 if ar == br else (1 if br > ar else -1)
+        sc = 0 if ac == bc else (1 if bc > ac else -1)
+        for k in range(max(abs(br - ar), abs(bc - ac)) + 1):
+            paint(ar + k * sr, ac + k * sc)
