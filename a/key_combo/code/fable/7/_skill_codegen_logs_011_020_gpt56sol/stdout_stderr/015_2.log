+def _attempt_generate() -> np.ndarray | None:
+    n = random.randint(4, 6)
+    h = random.randint(max(15, 3 * n + 3), min(25, 4 * n + 7))
+    w = random.randint(14, 24)
+    dr = random.choice((-1, 1))
+    instructions = _make_instructions(n)
+
