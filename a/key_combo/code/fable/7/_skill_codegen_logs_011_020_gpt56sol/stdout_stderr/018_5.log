SIDE_MIN, SIDE_MAX_EXCLUSIVE = 3, 6
COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE = 3, 6
ARC_COLOR_COUNT = 10
MAX_GENERATION_ATTEMPTS = 300


def _gen_expected_output(inp: np.ndarray) -> np.ndarray:
    return np.block(
        [
            [inp, np.rot90(inp, -1)],
            [np.rot90(inp, 1), np.rot90(inp, 2)],
        ]
    )


