+def _semantic_checks(inp: np.ndarray, expected: np.ndarray, records: list[dict]) -> bool:
+    """Check rule meaning, not merely solver/generator agreement."""
+    if len(records) != 3:
+        return False
+    if {(r["orientation"], r["kind"]) for r in records if r["kind"] == "mirror"} != {
