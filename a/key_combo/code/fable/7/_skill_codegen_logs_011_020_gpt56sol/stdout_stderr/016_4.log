+
+def _mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    result = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    result[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return result
+
