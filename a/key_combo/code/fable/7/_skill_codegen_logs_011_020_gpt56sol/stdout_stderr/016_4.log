+            lo, hi = group["band"]
+            if group["orientation"] == "vertical" and _overlap(box[0], box[2], lo, hi):
+                candidates.append(group)
+            elif group["orientation"] == "horizontal" and _overlap(box[1], box[3], lo, hi):
+                candidates.append(group)
