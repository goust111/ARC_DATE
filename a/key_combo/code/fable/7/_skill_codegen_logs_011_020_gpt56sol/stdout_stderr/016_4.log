    lab, n = label(fg_mask, structure=struct)
    if return_format == "dict":
        out: list[dict] = []
        for k in range(1, int(n) + 1):
            coords = np.argwhere(lab == k)
            if coords.size == 0 or int(coords.shape[0]) < int(min_area):
                continue
            out.append(
                {
                    "color": None,
                    "coords": coords,
                    "bbox": bbox_coords(coords),
                    "area": int(coords.shape[0]),
                }
            )
        return out

    objs: list[np.ndarray] = []
    for k in range(1, int(n) + 1):
        m = (lab == k)
        if int(m.sum()) < int(min_area):
            continue
        obj = np.full_like(grid, bg)
        obj[m] = grid[m]
        objs.append(obj)
    return objs


# =============================================================================
# Geometry
# =============================================================================


def flood_fill(grid: np.ndarray, r: int, c: int, color: int, *, connectivity: int = 4) -> None:
    """Flood fill region containing (r,c) with `color` (in-place)."""
    H, W = grid.shape
    r0 = int(r)
    c0 = int(c)
    if not (0 <= r0 < H and 0 <= c0 < W):
        return
    new_col = int(color)
    old_col = int(grid[r0, c0])
    if old_col == new_col:
        return
    if int(connectivity) == 4:
        def nbrs(rr: int, cc: int):
            yield rr - 1, cc
            yield rr + 1, cc
            yield rr, cc - 1
            yield rr, cc + 1
    else:
        def nbrs(rr: int, cc: int):
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    yield rr + dr, cc + dc
    stack: list[Coord] = [(r0, c0)]
    while stack:
        rr, cc = stack.pop()
        if not (0 <= rr < H and 0 <= cc < W):
            continue
        if int(grid[rr, cc]) != old_col:
            continue
        grid[rr, cc] = new_col
        for nr, nc in nbrs(rr, cc):
            stack.append((nr, nc))


def draw_line(
    grid: np.ndarray,
    r: int,
    c: int,
    *,
    end_r: int | None = None,
    end_c: int | None = None,
    length: int | None = None,
    direction: tuple[int, int] | None = None,
    color: int,
    stop_at: set[int] | None = None,
    clip: bool = False,
) -> Coord:
    """
    Draw a line starting at (r,c) either to an endpoint or by (length,direction).
    Modifies grid in-place. Returns (r_end,c_end) last drawn.

    Compatibility note (seed helpers):
      - If you provide `direction` and leave `length=None`, the line extends until
        it would leave the grid (implemented by using a sufficiently large length).
    """
    rr = int(r)
    cc = int(c)
    H, W = grid.shape
    col = int(color)
    stop_at = set() if stop_at is None else set(map(int, stop_at))

    if (end_r is None) != (end_c is None):
        raise ValueError("draw_line: either provide both end_r and end_c, or neither")

    if end_r is not None and end_c is not None:
        er = int(end_r)
        ec = int(end_c)
        dr = er - rr
        dc = ec - cc
        length = max(abs(dr), abs(dc)) + 1
        dr = 0 if dr == 0 else int(dr / abs(dr))
        dc = 0 if dc == 0 else int(dc / abs(dc))
    else:
        if direction is None:
            raise ValueError("draw_line: must provide endpoint or direction")
        dr, dc = map(int, direction)
        dr = 0 if dr == 0 else int(dr / abs(dr))
        dc = 0 if dc == 0 else int(dc / abs(dc))
        if length is None:
            # Extend until the edge (seed-style behavior). This uses a bound that is
            # certainly long enough even if the start is out-of-bounds and clip=True.
            length = max(H, W) * 2
        length = int(length)

    last_r, last_c = rr, cc
    for i in range(int(length)):
        r2 = rr + i * dr
        c2 = cc + i * dc
        if not (0 <= r2 < H and 0 <= c2 < W):
            if bool(clip):
                continue
            break
        if int(grid[r2, c2]) in stop_at:
            break
        grid[r2, c2] = col
        last_r, last_c = r2, c2
    return int(last_r), int(last_c)


# =============================================================================
# Tiling
# =============================================================================


def tile_fill(shape: tuple[int, int], tile: np.ndarray, *, offset: Coord = (0, 0)) -> np.ndarray:
    """Return a new grid of `shape` filled by repeating `tile` with a phase offset."""
    H, W = map(int, shape)
    h, w = tile.shape
    r_off, c_off = map(int, offset)
    out = np.empty((H, W), dtype=tile.dtype)
    for r in range(H):
        tr = (r - r_off) % h
        for c in range(W):
            tc = (c - c_off) % w
            out[r, c] = tile[tr, tc]
    return out




# =============================================================================
# Motion / interaction (translate, collision/contact)
# =============================================================================


def translate(obj: np.ndarray, dr: int, dc: int, *, background: int = Color.BLACK) -> np.ndarray:
    """Translate a full-grid object by (dr,dc), filling empty with background."""
    dr = int(dr)
    dc = int(dc)
    bg = int(background)
    H, W = obj.shape
    out = np.full_like(obj, bg)
    rr, cc = np.nonzero(obj != bg)
    rr2 = rr + dr
    cc2 = cc + dc
    inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
    out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
    return out


def collision(
    *,
    object1: np.ndarray,
    object2: np.ndarray,
    r1: int = 0,
    c1: int = 0,
    r2: int = 0,
    c2: int = 0,
    background: int = Color.BLACK,
) -> bool:
    """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
    bg = int(background)
    a = object1
    b = object2
    H1, W1 = a.shape
    H2, W2 = b.shape

    dr = int(r2) - int(r1)
    dc = int(c2) - int(c1)

    ra0 = max(0, dr)
    ca0 = max(0, dc)
    ra1 = min(H1, dr + H2)
    ca1 = min(W1, dc + W2)
    if ra0 >= ra1 or ca0 >= ca1:
        return False

    rb0 = ra0 - dr
    cb0 = ca0 - dc
    rb1 = rb0 + (ra1 - ra0)
    cb1 = cb0 + (ca1 - ca0)
    return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())


def contact(
    *,
    object1: np.ndarray,
    object2: np.ndarray,
    r1: int = 0,
    c1: int = 0,
    r2: int = 0,
    c2: int = 0,
    background: int = Color.BLACK,
    connectivity: int = 4,
) -> bool:
    """Return True iff objects touch (share edge/diagonal) or overlap."""
    bg = int(background)
    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
    m2 = (object2 != bg)
    m2d = ndimage.binary_dilation(m2, structure=struct)
    return collision(
        object1=(object1 != bg).astype(int),
        object2=m2d.astype(int),
        r1=r1,
        c1=c1,
        r2=r2,
        c2=c2,
        background=0,
    )


# =============================================================================
# Generation helpers
# =============================================================================

def first_free_location(
    canvas: np.ndarray,
    patch: np.ndarray,
    *,
    transparent: int,
    border: int = 0,
    padding: int = 0,
    padding_connectivity: int = 8,
) -> Coord | None:
    """
    Find the first (top-left) location where `patch` fits without overlap.

    Args:
        transparent: color treated as transparent in both `canvas` and `patch`
        border: keep at least this many empty cells to the canvas border
        padding: if > 0, treat `canvas` occupancy as dilated by `padding` pixels.
                 (useful for “leave a gap” placement constraints)
        padding_connectivity: 4 or 8 for the dilation neighborhood

    Returns:
        (r0,c0) or None if no placement exists.
    """
    H, W = canvas.shape
    h, w = patch.shape
    border = int(border)
    padding = int(padding)
    bg = int(transparent)

    if h <= 0 or w <= 0:
        return None
    if H - h + 1 - border <= border or W - w + 1 - border <= border:
        return None

    # Occupancy of the canvas (optionally dilated to enforce padding).
    occ = (canvas != bg)
    if padding > 0:
        if int(padding_connectivity) == 4:
            struct = STRUCT4
        elif int(padding_connectivity) == 8:
            struct = STRUCT8
        else:
            raise ValueError("first_free_location: padding_connectivity must be 4 or 8")
        occ = ndimage.binary_dilation(occ, iterations=padding, structure=struct)
        if _nearest_non_overlapping_shift(shifted, occupied) == (-in_dr, -in_dc):
            return [(int(r), int(c)) for r, c in shifted]
    return None


def _random_polyomino(
    size: int, grid_h: int = PANEL_SIZE, grid_w: int = PANEL_SIZE, forbidden: set | None = None
) -> list[tuple[int, int]]:
    """Grow a random 4-connected polyomino, or return [] if growth gets stuck."""
    if forbidden is None:
        forbidden = set()

    free = [(r, c) for r in range(grid_h) for c in range(grid_w) if (r, c) not in forbidden]
    if not free:
        return []

    start = random.choice(free)
    cells = {start}
    frontier = set()
    for dr, dc in ORTHOGONAL_STEPS:
        nr, nc = start[0] + dr, start[1] + dc
        if (nr, nc) not in forbidden:
            if 0 <= nr < grid_h and 0 <= nc < grid_w:
                frontier.add((nr, nc))

    while len(cells) < size and frontier:
        nxt = random.choice(list(frontier))
        cells.add(nxt)
        frontier.discard(nxt)
        for dr, dc in ORTHOGONAL_STEPS:
            nr, nc = nxt[0] + dr, nxt[1] + dc
            if 0 <= nr < grid_h and 0 <= nc < grid_w and (nr, nc) not in cells and (nr, nc) not in forbidden:
                frontier.add((nr, nc))

    if len(cells) < size:
        return []
    return list(cells)


def _sample_sprites(colors: list[int]) -> list[tuple[int, list[tuple[int, int]]]] | None:
    """Choose non-overlapping output sprites and keep room for later panels."""
    occupied = set()
    sprites = []

    for idx, color in enumerate(colors):
        remaining_panels = NUM_PANELS - idx - 1
        max_possible = min(MAX_SPRITE_SIZE, PANEL_SIZE * PANEL_SIZE - len(occupied) - remaining_panels * MIN_SPRITE_SIZE)
        if max_possible < MIN_SPRITE_SIZE:
            return None

        sprite_size = random.randint(MIN_SPRITE_SIZE, max_possible)
        cells = _random_polyomino(sprite_size, forbidden=occupied)
        if not cells:
            return None

        sprites.append((color, cells))
        occupied.update(cells)

    return sprites


def _render_output(sprites: list[tuple[int, list[tuple[int, int]]]]) -> np.ndarray:
    output = np.full((PANEL_SIZE, PANEL_SIZE), BG, dtype=int)
    for color, cells in sprites:
        _paint_cells(output, cells, color)
    return output


def _choose_panel_sprite_cells(
    sprites: list[tuple[int, list[tuple[int, int]]]]
) -> list[list[tuple[int, int]]] | None:
    panel_sprite_cells = [list(cells) for _color, cells in sprites]
    if random.random() >= SHIFT_BRANCH_PROBABILITY:
        return panel_sprite_cells

    earlier = np.zeros((PANEL_SIZE, PANEL_SIZE), dtype=bool)
    for _color, cells in sprites[:2]:
        _paint_cells(earlier, cells, True)

    shifted = _overlap_input_cells(sprites[2][1], earlier)
    if shifted is None:
        return None

    panel_sprite_cells[2] = shifted
    return panel_sprite_cells


def _distractor_forbidden_cells(sprite_cells: list[tuple[int, int]]) -> set[tuple[int, int]]:
    sprite_set = set(sprite_cells)
    sprite_adjacent = set()
    for r, c in sprite_cells:
        for dr, dc in ORTHOGONAL_STEPS:
            nr, nc = r + dr, c + dc
            if 0 <= nr < PANEL_SIZE and 0 <= nc < PANEL_SIZE:
                sprite_adjacent.add((nr, nc))
    return sprite_set | sprite_adjacent


def _build_panel(color: int, sprite_cells: list[tuple[int, int]]) -> np.ndarray | None:
    panel = np.full((PANEL_SIZE, PANEL_SIZE), BG, dtype=int)
    _paint_cells(panel, sprite_cells, color)

    max_distractor = min(len(sprite_cells) - 1, MAX_DISTRACTOR_SIZE)
    if max_distractor < 1:
        return None

    distractor_size = random.randint(1, max_distractor)
    distractor_cells = _random_polyomino(distractor_size, forbidden=_distractor_forbidden_cells(sprite_cells))
    if not distractor_cells:
        return None
    _paint_cells(panel, distractor_cells, color)

    _, n_comps = label(panel == color, structure=STRUCT4)
    if n_comps != REQUIRED_PANEL_COMPONENTS:
        return None
    return panel


def _build_panels(
    sprites: list[tuple[int, list[tuple[int, int]]]], panel_sprite_cells: list[list[tuple[int, int]]]
) -> list[np.ndarray] | None:
    panels = []
    for idx, (color, _output_cells) in enumerate(sprites):
        panel = _build_panel(color, panel_sprite_cells[idx])
        if panel is None:
            return None
        panels.append(panel)
    return panels


def _assemble_grid(panels: list[np.ndarray]) -> np.ndarray:
    grid = np.full((PANEL_SIZE, GRID_WIDTH), BG, dtype=int)
    for start, panel in zip(PANEL_STARTS, panels):
        grid[:, start : start + PANEL_SIZE] = panel
    for col in SEPARATOR_COLS:
        grid[:, col] = SEP
    return grid


def _oracle_accepts(grid: np.ndarray, expected_output: np.ndarray) -> bool:
    try:
        return bool(np.array_equal(main(grid), expected_output))
    except Exception:
        return False


def _gen_attempt() -> np.ndarray | None:
    colors = random.sample(AVAILABLE_COLORS, NUM_PANELS)
    sprites = _sample_sprites(colors)
    if sprites is None:
        return None

    output = _render_output(sprites)
    panel_sprite_cells = _choose_panel_sprite_cells(sprites)
    if panel_sprite_cells is None:
        return None

    panels = _build_panels(sprites, panel_sprite_cells)
    if panels is None:
        return None

    grid = _assemble_grid(panels)
    return grid if _oracle_accepts(grid, output) else None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts")
        if mask.sum() < MIN_REGION_CELLS:
            return None
        _, n = label_mask(mask, connectivity=4)
        if n != 1:
            return None
    return region


# ── Adjacency discovery ───────────────────────────────────────────────

def _find_adjacent_pairs(region: np.ndarray) -> list[tuple[int, int]]:
    """Return all directed (src, dst) pairs between adjacent regions."""
    H, W = region.shape
    # Detect boundaries via horizontal and vertical neighbor differences
    undirected = set()
    for r in range(H):
        for c in range(W):
            for dr, dc in _DIRS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W:
                    a, b = int(region[r, c]), int(region[nr, nc])
                    if a != b:
                        undirected.add((min(a, b), max(a, b)))
    directed = []
    for a, b in undirected:
        directed.append((a, b))
        directed.append((b, a))
    return directed


# ── Marker count selection ─────────────────────────────────────────────

def _choose_marker_counts(n_regions: int) -> tuple[int, int, int] | None:
    """Return (n_markers, n_normal, n_colored) or None if infeasible."""
    max_possible = min(MARKER_MAX, n_regions)
    if max_possible < MARKER_MIN:
        return None
    n_markers = random.randint(MARKER_MIN, max_possible)
    n_colored = random.randint(0, min(COLORED_MAX, n_markers - 2))
    n_normal = n_markers - n_colored
    if n_normal > NORMAL_MAX:
        n_colored = n_markers - NORMAL_MAX
        n_normal = NORMAL_MAX
        if n_colored > COLORED_MAX:
            n_markers = NORMAL_MAX + COLORED_MAX
            n_colored = COLORED_MAX
            n_normal = NORMAL_MAX
    return n_markers, n_normal, n_colored


# ── Marker placement search ───────────────────────────────────────────

def _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W):
    """Find all valid (center, stem) for placing a T marker from src toward dst."""
    candidates = []
    for r in range(1, H - 1):
        for c in range(1, W - 1):
            for stem in _DIRS:
                bar = _get_bar(stem)
                cells = _t_cells((r, c), stem)
                if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):
                    continue
                if cells & occupied_cells:
                    continue
                if _t_neighborhood((r, c), stem) & occupied_cells:
                    continue
                if cells & occupied_neighbors:
                    continue
                # Diagonal cells (stem + each bar dir) must lie in source region
                if not all(
                    0 <= r + stem[0] + bd[0] < H and
                    0 <= c + stem[1] + bd[1] < W and
                    region[r + stem[0] + bd[0], c + stem[1] + bd[1]] == src
                    for bd in bar
                ):
                    continue
                # Walk along stem from step=2 until we hit dst or leave bounds
                step = 2
                found = False
                while True:
                    nr, nc = r + stem[0] * step, c + stem[1] * step
                    if not (0 <= nr < H and 0 <= nc < W):
                        break
                    if (nr, nc) in occupied_cells or (nr, nc) in cells:
                        step += 1
                        continue
                    found = int(region[nr, nc]) == dst
                    break
                if found:
                    candidates.append(((r, c), stem))
    return candidates


def _register_marker(kind, center, stem, occupied_cells, occupied_neighbors):
    """Update occupied_cells and occupied_neighbors after placing a marker."""
    cells = _t_cells(center, stem)
    if kind == 'normal':
        occupied_cells |= cells
        occupied_neighbors |= (_t_neighborhood(center, stem) - cells)
    else:
        branch = _t_branch_cells(center, stem)
        occupied_cells |= branch
        occupied_cells.add(center)
        # Each branch cell must remain a singleton: buffer all non-marker neighbors
        for br, bc in branch:
            for dr, dc in _DIRS:
                nb = (br + dr, bc + dc)
                if nb != center and nb not in branch:
                    occupied_neighbors.add(nb)
        for dr, dc in _DIRS:
            nb = (center[0] + dr, center[1] + dc)
            if nb not in branch:
                occupied_neighbors.add(nb)


# ── Grid construction ─────────────────────────────────────────────────

def _build_color_map(region: np.ndarray, colors: list[int]) -> np.ndarray:
    """Map region ids to colors via vectorized lookup."""
    lut = np.array(colors, dtype=int)
    return lut[region]


def _stamp_markers_input(grid, placed_markers):
    """Write T-marker cells onto the input grid."""
    for kind, center, stem, _src, _dst, tc in placed_markers:
        if kind == 'normal':
            for cr, cc in _t_cells(center, stem):
                grid[cr, cc] = 1
        else:
            grid[center[0], center[1]] = tc
            for cr, cc in _t_branch_cells(center, stem):
                grid[cr, cc] = 1


def _stamp_markers_output(grid, placed_markers, out_colors):
    """Fill marker cells in the output grid with the source region's final color."""
    for kind, center, stem, src, _dst, _tc in placed_markers:
        color = out_colors[src]
        for cr, cc in _t_cells(center, stem):
            grid[cr, cc] = color


# ── L9 rotation marker ────────────────────────────────────────────────

def _try_place_l9(region, placed_markers, occupied_neighbors, input_grid, output_grid, out_colors):
    """Attempt to place a 5-cell L9 marker; return orientation string or None."""
    if random.random() >= L9_PROBABILITY:
        return None
    orient = random.choice(list(L9_OFFSETS))
    offsets = L9_OFFSETS[orient]
    H, W = region.shape

    all_marker_cells = set()
    for kind, center, stem, *_ in placed_markers:
        all_marker_cells |= _t_cells(center, stem)

    candidates = []
    for r in range(H):
        for c in range(W):
            cells = [(r + dr, c + dc) for dr, dc in offsets]
            if not all(0 <= cr < H and 0 <= cc < W for cr, cc in cells):
                continue
            rid = int(region[r, c])
            if not all(int(region[cr, cc]) == rid for cr, cc in cells):
                continue
            if any((cr, cc) in all_marker_cells for cr, cc in cells):
                continue
            if any((cr, cc) in occupied_neighbors for cr, cc in cells):
                continue
            candidates.append((r, c, rid))

    if not candidates:
        return None
    lr, lc, rid = random.choice(candidates)
    for dr, dc in offsets:
        input_grid[lr + dr, lc + dc] = 9
        output_grid[lr + dr, lc + dc] = out_colors[rid]
    return orient


# ── Main generation attempt ───────────────────────────────────────────

def _gen_attempt() -> np.ndarray | None:
    n_regions = random.choices(REGION_COUNTS, weights=REGION_WEIGHTS)[0]
    min_size = max(9, int(n_regions * REGION_SIZE_FACTOR))
    H = random.randint(min_size, GRID_SIZE_MAX)
    W = random.randint(min_size, GRID_SIZE_MAX)

    region = _grow_regions(H, W, n_regions)
    if region is None:
        return None

    directed_pairs = _find_adjacent_pairs(region)

    counts = _choose_marker_counts(n_regions)
    if counts is None:
        return None
    n_markers, n_normal, n_colored = counts

    # Select src->dst pairs with unique destinations
    random.shuffle(directed_pairs)
    dest_used = set()
    marker_pairs = []
    for src, dst in directed_pairs:
        if dst not in dest_used:
            marker_pairs.append((src, dst))
            dest_used.add(dst)
            if len(marker_pairs) >= n_markers:
                break
    if len(marker_pairs) < n_markers:
        n_markers = len(marker_pairs)
        if n_markers < MARKER_MIN:
            return None
        n_colored = min(n_colored, n_markers - 1)
        n_normal = n_markers - n_colored
    random.shuffle(marker_pairs)

    # Assign input colors
    pool = list(COLOR_POOL)
    random.shuffle(pool)
    if n_regions > len(pool):
        return None
    input_colors = pool[:n_regions]

    # Compute output colors from recoloring rules
    out_colors = list(input_colors)
    normal_pairs = marker_pairs[:n_normal]
    colored_pairs = marker_pairs[n_normal:]

    colored_targets = []
    for _src, dst in colored_pairs:
        cands = [c for c in pool if c != input_colors[dst]]
        if not cands:
            return None
        colored_targets.append(random.choice(cands))

    for src, dst in normal_pairs:
        out_colors[dst] = input_colors[src]
    for (src, dst), tc in zip(colored_pairs, colored_targets):
        out_colors[dst] = tc

    # Build marker definitions and place them
    all_defs = [('normal', s, d, None) for s, d in normal_pairs] + \
               [('colored', s, d, tc) for (s, d), tc in zip(colored_pairs, colored_targets)]
    random.shuffle(all_defs)

    occupied_cells: set[tuple[int, int]] = set()
    occupied_neighbors: set[tuple[int, int]] = set()
    placed_markers = []
    for kind, src, dst, tc in all_defs:
        cands = _find_valid_placements(region, src, dst, occupied_cells, occupied_neighbors, H, W)
        if not cands:
            return None
        center, stem = random.choice(cands)
        _register_marker(kind, center, stem, occupied_cells, occupied_neighbors)
        placed_markers.append((kind, center, stem, src, dst, tc))

    # Build grids via vectorized lookup
    input_grid = _build_color_map(region, input_colors)
    output_grid = _build_color_map(region, out_colors)

    _stamp_markers_input(input_grid, placed_markers)
    _stamp_markers_output(output_grid, placed_markers, out_colors)

    # Optional L9 rotation marker
    l9_orient = _try_place_l9(region, placed_markers, occupied_neighbors,
                              input_grid, output_grid, out_colors)
    if l9_orient == 'top_right':
        output_grid = np.rot90(output_grid, 1)
    elif l9_orient == 'top_left':
        output_grid = np.rot90(output_grid, 3)

    try:
        result = main(input_grid)
    except Exception:
        return None
    return input_grid if np.array_equal(result, output_grid) else None


