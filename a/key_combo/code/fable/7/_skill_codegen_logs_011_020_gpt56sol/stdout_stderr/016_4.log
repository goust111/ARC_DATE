+def _paint(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> np.ndarray:
+    coords = np.argwhere(mask) + np.array([r0, c0])
+    assert np.all(grid[coords[:, 0], coords[:, 1]] == 0)
