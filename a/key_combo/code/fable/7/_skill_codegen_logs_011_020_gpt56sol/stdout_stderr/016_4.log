+            transform = np.fliplr(source) if kind == "mirror" else np.rot90(source, 2)
+            _paint(inp, transform, pair_r, zc + 7, pair_color)
+            singleton_r = random.choice((pair_r, pair_r + 1))
+            singleton_c = zc + random.choice((2, 5))
+            singleton = _paint(inp, singleton_mask, singleton_r, singleton_c, singleton_color)
+            band = (pair_r, pair_r + 2)
+        else:
