def _bg_counts_safe(grid: np.ndarray) -> bool:
    """Ensure both bg colors (0, 1) remain more frequent than any single non-bg color."""
    counts = Counter(map(int, grid.ravel()))
    max_non_bg = max((counts[c] for c in COLOR_RANGE), default=0)
    return counts[0] > max_non_bg and counts[1] > max_non_bg


def _gen_attempt() -> np.ndarray | None:
    """Try to build one valid (input, output) pair; return input grid or None on failure."""
    h = random.randint(*GRID_H_RANGE)
