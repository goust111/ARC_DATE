+    for bar in bars:
+        assert len(bar) == 2, "every foreground component must be a two-pixel bar"
+        (r0, c0), (r1, c1) = tuple(bar)
+        assert abs(r0 - r1) + abs(c0 - c1) == 1, "bar pixels must be adjacent"
