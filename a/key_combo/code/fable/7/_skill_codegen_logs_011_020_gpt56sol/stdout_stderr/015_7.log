+    if not _isolated_from_foreground(grid, cells, bg):
+        return False
+    for r, c in cells:
+        grid[r, c] = color
+    return True
+
+
+def _place_anchor(grid: np.ndarray, center: tuple[int, int], color: int, bg: int) -> bool:
+    placed: list[set[tuple[int, int]]] = []
+    r, c = center
+    for pair in ARM_PAIRS:
