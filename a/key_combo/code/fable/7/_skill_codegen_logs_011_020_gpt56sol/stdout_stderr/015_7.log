+        ordered = sorted(cs)
+        for c0, c1 in zip(ordered, ordered[1:]):
+            yield (r, c0), (r, c1)
+    for c, rs in cols.items():
+        ordered = sorted(rs)
+        for r0, r1 in zip(ordered, ordered[1:]):
+            yield (r0, c), (r1, c)
+
+
