+    r0, c0 = a
+    r1, c1 = b
+    assert r0 == r1 or c0 == c1
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        return [(r0, c) for c in range(lo, hi + 1)]
+    lo, hi = sorted((r0, r1))
+    return [(r, c0) for r in range(lo, hi + 1)]
+
+
