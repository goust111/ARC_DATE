  "type": "transform_in_place",
  "src": "grey diagonal ribbon bands on the background",
  "transform": "normalize each band's slant from its top cap; recolor each grey pixel by the marker color at min(row offset, normalized column offset), capped at the far end",
  "symbol_instructions": "the contiguous marker row gives the cyclic color order for band layers"
}
</annotation>
</reference_puzzle>

