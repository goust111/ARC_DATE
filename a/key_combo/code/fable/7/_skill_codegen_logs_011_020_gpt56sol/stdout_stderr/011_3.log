        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[Color.GREY],
    )
    assert bands, "expected at least one grey band"

    for band in bands:
        _paint_diagonal_band(out, band["coords"], palette)

    return out

