+    for macro_r in range(n):
+        for macro_c in range(n):
+            if not mask[macro_r, macro_c]:
+                continue
+            invert = bool(seed[macro_r, macro_c])
+            for local_r in range(n):
+                for local_c in range(n):
+                    occupied = bool(seed[local_r, local_c]) != invert
+                    if occupied:
