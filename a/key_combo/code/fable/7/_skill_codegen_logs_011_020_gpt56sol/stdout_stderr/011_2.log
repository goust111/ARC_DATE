+    """Grow a sparse 4-connected full-panel sprite with no dihedral symmetry."""
+    max_area = (n * n - 1) // 2
+    for _ in range(100):
+        target_area = random.randint(3, max_area)
+        cells = {(random.randrange(n), random.randrange(n))}
+        while len(cells) < target_area:
+            frontier = []
+            for r, c in cells:
