+"""ARC task 7: extend a bracket-delimited motif with two coupled sequences."""
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+MARKER = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
