+        assert current not in seen, "the references may not contain a cycle"
+        seen.add(current)
+        colors.append(current)
+        frame = frames[current]
+        target = frame["target"]
+        if target is not None:
+            count = int(frame["count"])
+            assert count > 0
+            counts.append(count)
+            current = int(target)
+        else:
