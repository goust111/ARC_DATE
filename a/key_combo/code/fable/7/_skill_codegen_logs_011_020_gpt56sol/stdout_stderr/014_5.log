+        for dr, dc in DIR4:
+            p = (r + dr, c + dc)
+            if p not in shape and p not in holes:
+                result.add(p)
+    return list(result)
+
+
+def _dilate(points: set[tuple[int, int]], radius: int = 1) -> set[tuple[int, int]]:
+    return {
+        (r + dr, c + dc)
+        for r, c in points
+        for dr in range(-radius, radius + 1)
+        for dc in range(-radius, radius + 1)
+    }
+
