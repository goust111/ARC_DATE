+                and int(line[x + 1]) not in (bg, wall)):
+            if any(y in used for y in (x - 1, x, x + 1)):
+                return None
+            doors.append((x, int(line[x - 1]), int(line[x + 1])))
+            used.update((x - 1, x, x + 1))
