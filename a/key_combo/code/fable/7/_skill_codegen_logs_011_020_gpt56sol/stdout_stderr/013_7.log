+        non_bg = [int(v) for v in line if int(v) != bg]
+        if not non_bg:
+            continue
+        wall, amount = Counter(non_bg).most_common(1)[0]
+        if amount < max(4, int(np.ceil(0.40 * span))):
+            continue
+        doors = _doors_on_line(line, bg, wall)
+        if doors is not None:
+            found.append((pos, wall, doors))
+    return found
+
