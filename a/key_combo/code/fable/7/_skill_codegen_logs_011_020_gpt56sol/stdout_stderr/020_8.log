+                    nr, nc = r + dr, c + dc
+                    if (0 <= nr < h and 0 <= nc < w and labels[nr, nc] < 0
+                            and int(grid[nr, nc]) not in (RED, YELLOW)):
+                        labels[nr, nc] = label
+                        queue.append((nr, nc))
+            regions.append(cells)
+    return labels, regions
