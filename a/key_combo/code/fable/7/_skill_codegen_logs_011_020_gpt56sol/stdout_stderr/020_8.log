+    for sr in range(h):
+        for sc in range(w):
+            if labels[sr, sc] >= 0 or int(grid[sr, sc]) in (RED, YELLOW):
+                continue
+            label = len(regions)
+            cells: list[tuple[int, int]] = []
+            labels[sr, sc] = label
+            queue = deque([(sr, sc)])
+            while queue:
