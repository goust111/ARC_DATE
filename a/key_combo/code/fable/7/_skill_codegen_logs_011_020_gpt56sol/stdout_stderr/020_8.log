+        pairs = [pair for pair in (vertical, horizontal)
+                 if pair[0] >= 0 and pair[1] >= 0 and pair[0] != pair[1]]
+        assert len(pairs) == 1, "each yellow door must join exactly two opposite regions"
+        a, b = pairs[0]
