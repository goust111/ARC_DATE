+def _graph_from_edges(n: int, edges: list[tuple[int, int]]) -> list[set[int]]:
+    graph = [set() for _ in range(n)]
+    for a, b in edges:
+        graph[a].add(b)
+        graph[b].add(a)
+    return graph
