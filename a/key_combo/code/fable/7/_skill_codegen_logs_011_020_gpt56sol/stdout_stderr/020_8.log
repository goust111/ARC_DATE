+def _label_open_regions(grid: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    """Label 4-connected cells that are not red walls or yellow doors."""
+    h, w = grid.shape
+    labels = np.full((h, w), -1, dtype=int)
