+
+def _grid_edges(rows: int, cols: int) -> list[tuple[int, int]]:
+    edges = []
+    for r in range(rows):
+        for c in range(cols):
+            node = r * cols + c
+            if r + 1 < rows:
+                edges.append((node, (r + 1) * cols + c))
+            if c + 1 < cols:
