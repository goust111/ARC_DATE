+                return None
+
+            if local is not None:
+                observed = 1 if int(g[r, c]) == color else 0
+                lr, lc = local
+                if values[lr, lc] >= 0 and values[lr, lc] != observed:
+                    return None
+                values[lr, lc] = observed
