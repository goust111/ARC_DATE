+    canvas: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    color: int,
+) -> None:
+    """Opaque clipped stamp: false sprite cells paint background too."""
+    h, w = canvas.shape
+    n = mask.shape[0]
+    r0, r1 = max(0, top), min(h, top + n)
+    c0, c1 = max(0, left), min(w, left + n)
+    if r0 >= r1 or c0 >= c1:
+        return
+    sub = mask[r0 - top : r1 - top, c0 - left : c1 - left]
+    canvas[r0:r1, c0:c1] = np.where(sub, color, BG)
+
+
