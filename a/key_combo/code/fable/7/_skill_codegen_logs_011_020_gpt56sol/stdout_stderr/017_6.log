+        outputs.append(
+            _render_all(g.shape, model.mask(), model.origin, model.d, model.direction, model.color)
+        )
+    unique = {x.tobytes() for x in outputs}
+    assert len(unique) == 1, "stamp evidence does not determine a unique output"
