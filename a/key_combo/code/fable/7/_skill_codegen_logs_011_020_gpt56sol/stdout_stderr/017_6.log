                choices.append((r0, c0, add_counts))
        if not choices:
            return None

        r0, c0, add_counts = random.choice(choices)
        hidden[r0 : r0 + h, c0 : c0 + w] = True
        hidden_counts += add_counts

    if np.any(hidden_counts >= total_counts):
        return None
    return hidden


