+        _stamp(out, _rot(mask, k), top, left, color)
+    else:
+        raise AssertionError("stamp trajectory did not leave the canvas")
+    return out
+
+
+def _connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    seen = {tuple(map(int, pts[0]))}
+    stack = list(seen)
+    while stack:
