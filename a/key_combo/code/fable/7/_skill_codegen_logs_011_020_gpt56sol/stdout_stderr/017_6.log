+            local = None
+            if _inside_square(r, c, b_top, b_left, n):
+                # rotCW(mask)[u,v] == mask[n-1-v,u]
+                u, v = r - b_top, c - b_left
+                local = (n - 1 - v, u)
+            elif _inside_square(r, c, a_top, a_left, n):
+                local = (r - a_top, c - a_left)
