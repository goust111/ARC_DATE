+            if above == BACKGROUND:
+                r -= 1
+                out[r, c] = SMOKE
+                continue
+            assert above == SHELF, "a path may meet only background or a shelf"
+            left, right = _shelf_span(grid, r - 1, c)
+            dl, dr = c - left, right - c
+            if mode == "vertical":
+                directions: list[int] = []
+            elif mode == "both":
+                directions = [-1, 1]
+            elif mode == "near":
+                directions = [-1] if dl < dr else [1] if dr < dl else [-1, 1]
+            else:
+                directions = [-1] if dl > dr else [1] if dr > dl else [-1, 1]
+
+            event = {
+                "row": r - 1,
+                "hit": c,
