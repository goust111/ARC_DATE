+        marker = markers[0]
+        gap = shell["gap"]
+        if marker[0] == gap[0]:
+            direction = (0, -1 if gap[1] == c0 else 1)
+        elif marker[1] == gap[1]:
+            direction = (-1 if gap[0] == r0 else 1, 0)
+        else:
