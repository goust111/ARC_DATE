+    if random.random() < 0.5:
+        grid = np.fliplr(grid).copy()
+    if random.random() < 0.5:
+        grid = np.flipud(grid).copy()
+
+    try:
+        out, shells, shots, outcomes, recolor, bg = _solve(grid, True)
+    except (AssertionError, IndexError):
+        return None
+    hits = [(shot, hit) for shot, hit, edge in outcomes
