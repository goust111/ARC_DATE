GRID_SIZE_RANGE = (8, 9)
BRACKET_WIDTH_RANGE = (3, 4)
MOVER_HEIGHT_RANGE = (1, 3)
MOVER_MAX_CELLS = 4
MOVER_MIN_DENSITY_NUM = 2
MOVER_MIN_DENSITY_DEN = 3
# Layout choices and retry budget.
TOP_LEFT_OPTIONS = [True, False]
MAX_GENERATION_ATTEMPTS = 300

def _gen_half_starts(grid_width, bracket_width, left_side):
    if left_side:
        return list(range(0, grid_width // 2 - bracket_width + 1))
    return list(range((grid_width + 1) // 2, grid_width - bracket_width + 1))

def _gen_bracket_columns(grid_width, bracket_width):
    """Choose non-overlapping top/bottom bracket starts on opposite halves."""
    top_left = random.choice(TOP_LEFT_OPTIONS)
    top_starts = _gen_half_starts(grid_width, bracket_width, top_left)
    bottom_starts = _gen_half_starts(grid_width, bracket_width, not top_left)
    if not top_starts or not bottom_starts:
        return None
    return random.choice(top_starts), random.choice(bottom_starts)

def _gen_add_bracket(grid, c0, width, top_edge):
    edge_row, arm_row = (0, 1) if top_edge else (-1, -2)
    grid[edge_row, c0:c0 + width] = BRACKET_COLOR
    grid[arm_row, c0] = BRACKET_COLOR
    grid[arm_row, c0 + width - 1] = BRACKET_COLOR

def _gen_sprite_masks(height, width):
    area = height * width
    min_cells = (MOVER_MIN_DENSITY_NUM * area + MOVER_MIN_DENSITY_DEN - 1) // MOVER_MIN_DENSITY_DEN
    max_cells = min(MOVER_MAX_CELLS, area)
    masks = []
    for cell_count in range(min_cells, max_cells + 1):
        for cells in itertools.combinations(range(area), cell_count):
            mask = np.zeros((height, width), dtype=bool)
            mask[np.unravel_index(cells, (height, width))] = True
            if not mask.any(axis=0).all() or not mask.any(axis=1).all():
                continue
            if is_contiguous(mask.astype(int), background=0, connectivity=4):
                masks.append(mask)
    return masks

def _gen_mover_sprite(height, width, color, bg):
    masks = _gen_sprite_masks(height, width)
    if not masks:
        return None
    mask = random.choice(masks)
    sprite = np.full((height, width), bg, dtype=int)
    sprite[mask] = color
    return sprite

def _gen_paste_if_clear(grid, sprite, row, col, sprite_mask):
    """Paste sprite only when every colored sprite cell lands on background."""
    target = grid[row:row + sprite.shape[0], col:col + sprite.shape[1]]
    if not np.all(target[sprite_mask] == BG_COLOR):
        return False
    paste(grid, sprite, row, col, transparent=BG_COLOR)
    return True

def _gen_attempt():
    height = random.randint(*GRID_SIZE_RANGE)
    grid_width = random.randint(*GRID_SIZE_RANGE)
    bracket_width = random.randint(*BRACKET_WIDTH_RANGE)
    interior_width = bracket_width - 2

    bracket_columns = _gen_bracket_columns(grid_width, bracket_width)
    if bracket_columns is None:
        return None
    top_c0, bottom_c0 = bracket_columns

    mover_height = random.randint(*MOVER_HEIGHT_RANGE)
    mover_color = random.choice(MOVER_COLORS)
    sprite = _gen_mover_sprite(mover_height, interior_width, mover_color, BG_COLOR)
    if sprite is None:
        return None

    out = np.full((height, grid_width), BG_COLOR, dtype=int)
    _gen_add_bracket(out, top_c0, bracket_width, top_edge=True)
    _gen_add_bracket(out, bottom_c0, bracket_width, top_edge=False)

    dest_r = height - mover_height
    dest_c = top_c0 + 1
    sprite_mask = sprite != BG_COLOR
    if not _gen_paste_if_clear(out, sprite, dest_r, dest_c, sprite_mask):
        return None

    inp = out.copy()
    target = inp[dest_r:dest_r + mover_height, dest_c:dest_c + interior_width]
    target[sprite_mask] = BG_COLOR

    source_c = bottom_c0 + 1
    max_source_r = height - 2 - mover_height
    if max_source_r < 1:
        return None
    source_r = random.randint(1, max_source_r)
    if not _gen_paste_if_clear(inp, sprite, source_r, source_c, sprite_mask):
        return None

    if np.array_equal(main(inp), out):
        return inp
    return None

def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate df9fd884 input")

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste

# concepts:
# growing

# description:
# In the input you will see a grid with some green rectangles. Each rectangle has one red pixel on one of its borders.
# To make the output, you should extend the green region of each rectangle to the border of the grid in the direction of the red pixel, with the extent of the line increasing with the extent of the rectangle.
# Also you should draw a red line from the red pixel to the border of the grid.


def main(input_grid):
    """
    Grow each green rectangle outward from its red border indicator to the canvas edge.

    Input structure:
    - Each foreground object is a green rectangle with one red pixel on its border.
    - Objects sit on a black background.
    - The red pixel indicates the side from which growth should extend.

    Rule:
    - Find each rectangle-and-indicator component.
    - Extend a green band from the rectangle toward the canvas edge on the indicator side.
    - Draw a red line from the indicator pixel to that same edge.

    Key insight:
    - The indicator side controls direction, while the rectangle thickness controls the grown band.
    """
    # Initialize the output grid
    output_grid = np.copy(input_grid)
    
    rectangle_color = Color.GREEN
    indicator_color = Color.RED
    background = Color.BLACK

    # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
    objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
    for obj in objects:
        # find the red indicator
        for red_r, red_c in np.argwhere(obj == indicator_color):
            break

        # Get the dimensions of the object, and its position
        _b = bbox(obj != background)
        assert _b is not None
        r, c, _r1, _c1 = _b
        width = _r1 - r + 1
        height = _c1 - c + 1

        # depending on which side of the rectangle that the indicator is on, we draw in different directions
        # left edge: draw to the left
        if red_r == r:
            # Extend the green rectangle to the left until it reaches the border
            output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
        elif red_r == r + width - 1:
            # Extend the green rectangle to the right until it reaches the border
            output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
        elif red_c == c:
            # Extend the green rectangle to the top until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
        elif red_c == c + height - 1:
            # Extend the green rectangle to the bottom until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
        else:
            assert False, "The red pixel is not on the border of the rectangle"

    return output_grid

def generate_input():
    # Create the background grid
    n, m = np.random.randint(20, 30), np.random.randint(20, 30)
    grid = np.full((m, n), Color.BLACK)

    rectangle_num = 2
    rectangle_color = Color.GREEN
    indicator_color = Color.RED

    # Draw rectangles on the grid
    for i in range(rectangle_num):
        width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        # The width should be twice smaller than the height
        while (width * 2 + 2) >= height:
            width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        green_rectangle = np.full((width, height), rectangle_color)

        # Place one indicator pixel on one random border of the rectangle
        # Spare enough space for the extend line with the same size of width - 1
        r_coord = np.random.choice([0, width - 1])
        c_coord = np.random.choice(range(width + 1, height - (width + 1)))
        green_rectangle[r_coord, c_coord] = indicator_color
        # Randomly rotate the object so that we get a variety of orientations
        if np.random.choice([True, False]):
            green_rectangle = np.rot90(green_rectangle, k=-1)
            r_coord, c_coord = c_coord, r_coord

        # Place the rectangle on the grid
        try:
            _loc = first_free_location(grid, green_rectangle, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        # Check if there is no space for the rectangle
        except:
            return generate_input()
        paste(grid, green_rectangle, r, c, transparent=Color.BLACK, clip=True)

    # Check if the generated grid is valid
    transformed_grid = main(grid)
    objects = find_components(transformed_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")

    # After transformation, the two objects should not touch each other
    if len(objects) != rectangle_num:
        # Regenerate the grid
        return generate_input()

    return grid
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def _sparse_marker_color(g: np.ndarray, bg: int) -> int:
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected exactly two foreground colors"

    counts = {color: int(np.count_nonzero(g == color)) for color in colors}
    marker_count = min(counts.values())
    markers = [color for color, count in counts.items() if count == marker_count]
    assert len(markers) == 1, "sparse marker color must be unique"
    assert any(count > marker_count for count in counts.values()), "expected one color to be denser than the marker"
    return markers[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase each foreground object that contains more than one sparse marker-color pixel.

    Input structure
    - A dominant background surrounds separated 4-connected foreground objects.
    - The foreground uses one dense object color and one sparse marker color.
    Rule
    - Infer the marker as the unique less frequent foreground color.
    - Keep objects with zero or one marker pixel.
    - Recolor every pixel of an object to background when it contains two or more marker pixels.
    Key insight
    - The marker count inside each whole object, not the object's size or position, decides whether that object remains.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    marker = _sparse_marker_color(g, bg)

    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    assert objects, "expected foreground objects"

    out = g.copy()
    kept_any = False
    removed_any = False
    for obj in objects:
        coords = obj["coords"]
        marker_count = int(np.count_nonzero(g[coords[:, 0], coords[:, 1]] == marker))
        if marker_count >= 2:
            out[coords[:, 0], coords[:, 1]] = bg
            removed_any = True
        else:
            kept_any = True

    assert kept_any and removed_any, "expected both kept and erased objects"
    return out

# --------------- generator (o5x) ---------------

# Canvas and object geometry.
ROW_RANGE, COL_RANGE = (13, 14), (12, 15)
OBJECT_RANGE = (6, 7)
RECT_H_RANGE, RECT_W_RANGE = (2, 4), (2, 6)
RECT_DIMS = tuple((h, w) for h in range(RECT_H_RANGE[0], RECT_H_RANGE[1] + 1) for w in range(RECT_W_RANGE[0], RECT_W_RANGE[1] + 1))
RECT_MIN_AREA = RECT_H_RANGE[0] * RECT_W_RANGE[0]
RECT_MAX_AREA = RECT_H_RANGE[1] * RECT_W_RANGE[1]

# Marker assignment and foreground density.
KEPT_OBJECT_COUNT = 3
MARKER_TOTAL_RANGE = (9, 14)
KEPT_MARKERS = (0, 1)
REMOVED_MARKERS = (2, 4)
FG_AREA_FACTORS = (5, 9)
FG_AREA_DIVISOR = 2

# Rendering, placement, and retries.
BG_COLOR, DENSE_COLOR, MARKER_COLOR = 0, 1, 8
PLACE_PAD, PLACE_CONN = 1, 8
PLACE_KWARGS = dict(transparent=BG_COLOR, padding=PLACE_PAD, padding_connectivity=PLACE_CONN)
MAX_GENERATION_ATTEMPTS = 300


def _gen_bounded_parts(n: int, total: int, lo: int, hi: int) -> list[int] | None:
    parts: list[int] = []
    remaining = int(total)
    for i in range(int(n)):
        rem = int(n) - i - 1
        low = max(int(lo), remaining - int(hi) * rem)
        high = min(int(hi), remaining - int(lo) * rem)
        if low > high:
            return None
        value = random.randint(low, high)
        parts.append(value)
        remaining -= value
    return parts if remaining == 0 else None


def _gen_marker_counts(n_objects: int, total_markers: int) -> list[tuple[int, bool]] | None:
    kept_count = KEPT_OBJECT_COUNT
    removed_count = int(n_objects) - kept_count
    kept_totals = [
        k
        for k in range(kept_count + 1)
        if REMOVED_MARKERS[0] * removed_count <= int(total_markers) - k <= REMOVED_MARKERS[1] * removed_count
    ]
    if not kept_totals:
        return None

    kept_total = random.choice(kept_totals)
    kept_markers = [KEPT_MARKERS[1]] * kept_total + [KEPT_MARKERS[0]] * (kept_count - kept_total)
    random.shuffle(kept_markers)

    removed_markers = _gen_bounded_parts(removed_count, int(total_markers) - kept_total, *REMOVED_MARKERS)
    if removed_markers is None:
        return None

    objects = [(m, True) for m in kept_markers] + [(m, False) for m in removed_markers]
    random.shuffle(objects)
    return objects


def _gen_rect_dims(n_objects: int, min_area: int, max_area: int) -> list[tuple[int, int]] | None:
    dims: list[tuple[int, int]] = []
    area = 0
    for i in range(int(n_objects)):
        rem = int(n_objects) - i - 1
        feasible = []
        for h, w in RECT_DIMS:
            new_area = area + h * w
            if new_area + rem * RECT_MIN_AREA <= int(max_area) and new_area + rem * RECT_MAX_AREA >= int(min_area):
                feasible.append((h, w))
        if not feasible:
            return None
        h, w = random.choice(feasible)
        dims.append((h, w))
        area += h * w

    if not (int(min_area) <= area <= int(max_area)):
        return None
    random.shuffle(dims)
    return dims


def _gen_pair_dims_counts(dims: list[tuple[int, int]], counts: list[tuple[int, bool]]):
    remaining = list(dims)
    paired: list[tuple[int, int, int, bool]] = []
    for marker_count, keep in sorted(counts, reverse=True):
        compatible = [i for i, (h, w) in enumerate(remaining) if h * w > marker_count]
        if not compatible:
            return None
        idx = random.choice(compatible)
        h, w = remaining.pop(idx)
        paired.append((h, w, marker_count, keep))
    random.shuffle(paired)
    return paired


def _gen_marked_rect(h: int, w: int, marker_count: int) -> np.ndarray:
    rect = np.full((h, w), DENSE_COLOR, dtype=int)
    rect.flat[random.sample(range(h * w), marker_count)] = MARKER_COLOR
    return rect


def _render_specs(rows: int, cols: int, specs: list[tuple[int, int, int, bool]]):
    """Return generated input and expected output, or None if placement fails."""
    inp = np.full((rows, cols), BG_COLOR, dtype=int)
    expected = np.full_like(inp, BG_COLOR)
    occupancy = np.full_like(inp, BG_COLOR)
    order = list(specs)
    random.shuffle(order)
    order.sort(key=lambda item: item[0] * item[1], reverse=True)

    for h, w, marker_count, keep in order:
        patch = np.full((h, w), DENSE_COLOR, dtype=int)
        try:
            r0, c0 = random_free_location(occupancy, patch, **PLACE_KWARGS)
        except ValueError:
            return None

        rect = _gen_marked_rect(h, w, marker_count)
        paste(inp, rect, r0, c0)
        paste(occupancy, patch, r0, c0)
        if keep:
            paste(expected, rect, r0, c0)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*ROW_RANGE)
    cols = random.randint(*COL_RANGE)
    n_objects = random.randint(*OBJECT_RANGE)
    total_markers = random.randint(*MARKER_TOTAL_RANGE)

    grid_area = rows * cols
    min_area = FG_AREA_FACTORS[0] * total_markers
    max_area = min(FG_AREA_FACTORS[1] * total_markers, (grid_area + total_markers - 1) // FG_AREA_DIVISOR)
    if min_area > max_area:
        return None

    dims = _gen_rect_dims(n_objects, min_area, max_area)
    counts = _gen_marker_counts(n_objects, total_markers)
    if dims is None or counts is None:
        return None
    specs = _gen_pair_dims_counts(dims, counts)
    if specs is None:
        return None

    rendered = _render_specs(rows, cols, specs)
    if rendered is None:
        return None
    inp, expected = rendered

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, is_contiguous, paste
import itertools
import random


def _template_mask(component: dict, bbox: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    for r, c in component["coords"]:
        mask[int(r) - r0, int(c) - c0] = True
    return mask


def _copy_starts(positions: list[int], anchor_index: int, anchor_start: int, sprite_len: int) -> list[int]:
    starts: list[int | None] = [None] * len(positions)
    starts[anchor_index] = int(anchor_start)

    for i in range(anchor_index + 1, len(positions)):
        gap = positions[i] - positions[i - 1] - 1
        assert gap >= 0, "control pixels must be in increasing order without duplicates"
        assert starts[i - 1] is not None
        starts[i] = starts[i - 1] + sprite_len + gap

    for i in range(anchor_index - 1, -1, -1):
        gap = positions[i + 1] - positions[i] - 1
        assert gap >= 0, "control pixels must be in increasing order without duplicates"
        assert starts[i + 1] is not None
        starts[i] = starts[i + 1] - sprite_len - gap

    assert all(start is not None for start in starts)
    return [int(start) for start in starts]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Copy the red template sprite along the control-pixel line, preserving control gaps and recoloring each copy.

    Input structure
    The grid has a black background, one 8-connected red template sprite, and
    several isolated control pixels in one row or column.  Exactly one control
    pixel has the template color.

    Rule
    Read the control pixels left-to-right or top-to-bottom.  The copy matching
    the template-color control is the original sprite; each neighboring control
    becomes a same-shape copy in that control color.  The empty cells between
    adjacent control pixels become the empty columns or rows between adjacent
    sprite bboxes.

    Key insight
    The singleton control line is a compressed ordered layout: expanding each
    marker to the template bbox while keeping the inter-marker gaps fixes every
    copy position from the original sprite.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    components = find_components(g, bg=bg, connectivity=8, monochromatic=True)
    sprite_components = [component for component in components if component["area"] > 1]
    assert len(sprite_components) == 1, "expected one non-singleton template sprite"

    sprite = sprite_components[0]
    template_color = int(sprite["color"])
    sr0, sc0, sr1, sc1 = sprite["bbox"]
    template = _template_mask(sprite, sprite["bbox"])
    sprite_h, sprite_w = template.shape

    controls: list[tuple[int, int, int]] = []
    for component in components:
        if component is sprite:
            continue
        assert component["area"] == 1, "all non-template components must be singleton controls"
        r, c = map(int, component["coords"][0])
        controls.append((r, c, int(component["color"])))

    assert len(controls) >= 2, "expected an ordered control line"
    anchor_indices = [i for i, (_, _, color) in enumerate(controls) if color == template_color]
    assert len(anchor_indices) == 1, "expected one control pixel with the template color"

    control_rows = {r for r, _, _ in controls}
    control_cols = {c for _, c, _ in controls}
    if len(control_rows) == 1:
        controls.sort(key=lambda item: item[1])
        positions = [c for _, c, _ in controls]
        anchor_index = next(i for i, (_, _, color) in enumerate(controls) if color == template_color)
        starts = _copy_starts(positions, anchor_index, sc0, sprite_w)
        placements = [(sr0, start, color) for start, (_, _, color) in zip(starts, controls)]
    elif len(control_cols) == 1:
        controls.sort(key=lambda item: item[0])
        positions = [r for r, _, _ in controls]
        anchor_index = next(i for i, (_, _, color) in enumerate(controls) if color == template_color)
        starts = _copy_starts(positions, anchor_index, sr0, sprite_h)
        placements = [(start, sc0, color) for start, (_, _, color) in zip(starts, controls)]
    else:
        raise AssertionError("control pixels must share one row or one column")

    out = g.copy()
    H, W = g.shape
    for r0, c0, color in placements:
        assert 0 <= r0 and 0 <= c0 and r0 + sprite_h <= H and c0 + sprite_w <= W
        target = out[r0 : r0 + sprite_h, c0 : c0 + sprite_w]
        occupied = target[template]
        if color == template_color:
            assert np.all(occupied == template_color), "template-color copy must be the original sprite"
        else:
            assert np.all(occupied == bg), "new copies must land on background"
        target[template] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas and axis bounds.
GRID_HEIGHT_BOUNDS = (13, 23)
GRID_WIDTH_BOUNDS = (14, 24)
HORIZONTAL = "horizontal"
VERTICAL = "vertical"
AXES = [HORIZONTAL, VERTICAL]

# Sprite geometry and colors.
SPRITE_SIZE = 3
SPRITE_AREAS = [6, 7]
BACKGROUND_COLOR = 0
SPRITE_COLOR = 2

# Control-line layout and palette.
CONTROL_COUNTS = [4, 5]
CONTROL_GAP_BOUNDS = (1, 4)
CONTROL_EDGE_COORDS = [1, 2]
CONTROL_TO_SPRITE_MIN_OFFSET = 5
CONTROL_PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
CONTROL_DISTINCT_BOUNDS = (2, 4)
MIN_COPY_SPAN_FRACTION = 0.75

# Retry limits.
GENERATION_RETRIES = 300

def _gen_sprite_mask() -> np.ndarray:
    area = random.choice(SPRITE_AREAS)
    masks: list[np.ndarray] = []
    for cells in itertools.combinations(range(SPRITE_SIZE * SPRITE_SIZE), area):
        mask = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=bool)
        for cell in cells:
            mask[cell // SPRITE_SIZE, cell % SPRITE_SIZE] = True
        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
            continue
        if is_contiguous(mask.astype(int), background=BACKGROUND_COLOR, connectivity=8):
            masks.append(mask)
    return random.choice(masks)


def _gen_gaps(count: int, max_axis_len: int) -> list[int]:
    gap_min, gap_max = CONTROL_GAP_BOUNDS
    choices = [
        list(gaps)
        for gaps in itertools.product(range(gap_min, gap_max + 1), repeat=count - 1)
        if count * SPRITE_SIZE + sum(gaps) <= max_axis_len
    ]
    return random.choice(choices)


def _gen_control_positions(axis_len: int, gaps: list[int]) -> list[int] | None:
    control_span = len(gaps) + 1 + sum(gaps)
    if control_span > axis_len:
        return None
    if control_span <= axis_len - 2:
        start = random.randint(1, axis_len - control_span - 1)
    else:
        start = random.randint(0, axis_len - control_span)
    positions = [start]
    for gap in gaps:
        positions.append(positions[-1] + gap + 1)
    return positions


def _gen_control_colors(count: int, anchor_index: int) -> list[int]:
    distinct_min, distinct_max = CONTROL_DISTINCT_BOUNDS
    distinct_count = random.randint(distinct_min, min(distinct_max, count))
    selected = random.sample(CONTROL_PALETTE, distinct_count - 1)
    other_count = count - 1
    others = selected[:]
    while len(others) < other_count:
        others.append(random.choice(selected))
    random.shuffle(others)

    colors: list[int] = []
    other_i = 0
    for i in range(count):
        if i == anchor_index:
            colors.append(SPRITE_COLOR)
        else:
            colors.append(others[other_i])
            other_i += 1
    return colors


def _gen_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)
    patch[mask] = int(color)
    return patch


def _gen_copy_starts(axis_len: int, copy_span: int, gaps: list[int]) -> list[int]:
    starts = [random.randint(0, axis_len - copy_span)]
    for gap in gaps:
        starts.append(starts[-1] + SPRITE_SIZE + gap)
    return starts


def _origin(axis: str, start: int, fixed_coord: int) -> tuple[int, int]:
    return (fixed_coord, start) if axis == HORIZONTAL else (start, fixed_coord)


def _render_candidate(axis, height, width, mask, starts, control_positions, colors, anchor_index):
    out = np.zeros((height, width), dtype=int)
    fixed_limit = height if axis == HORIZONTAL else width
    control_fixed = random.choice(CONTROL_EDGE_COORDS)
    min_sprite_fixed = control_fixed + CONTROL_TO_SPRITE_MIN_OFFSET
    if min_sprite_fixed > fixed_limit - SPRITE_SIZE:
        return None
    sprite_fixed = random.randint(min_sprite_fixed, fixed_limit - SPRITE_SIZE)

    for start, color in zip(starts, colors):
        r, c = _origin(axis, start, sprite_fixed)
        paste(out, _gen_patch(mask, color), r, c, transparent=BACKGROUND_COLOR)

    for position, color in zip(control_positions, colors):
        r, c = _origin(axis, position, control_fixed)
        out[r, c] = color

    inp = out.copy()
    for i, start in enumerate(starts):
        if i == anchor_index:
            continue
        r, c = _origin(axis, start, sprite_fixed)
        inp[r : r + SPRITE_SIZE, c : c + SPRITE_SIZE][mask] = BACKGROUND_COLOR
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    axis = random.choice(AXES)
    count = random.choice(CONTROL_COUNTS)
    max_axis_len = GRID_WIDTH_BOUNDS[1] if axis == HORIZONTAL else GRID_HEIGHT_BOUNDS[1]
    gaps = _gen_gaps(count, max_axis_len)
    copy_span = count * SPRITE_SIZE + sum(gaps)
    max_len_for_span = min(max_axis_len, int(copy_span / MIN_COPY_SPAN_FRACTION))
    axis_len = random.randint(copy_span, max_len_for_span)
    if axis == HORIZONTAL:
        height, width = random.randint(*GRID_HEIGHT_BOUNDS), axis_len
    else:
        height, width = axis_len, random.randint(*GRID_WIDTH_BOUNDS)

    mask = _gen_sprite_mask()
    anchor_index = random.randrange(count)
    colors = _gen_control_colors(count, anchor_index)
    starts = _gen_copy_starts(axis_len, copy_span, gaps)
    control_positions = _gen_control_positions(axis_len, gaps)
    if control_positions is None:
        return None

    rendered = _render_candidate(axis, height, width, mask, starts, control_positions, colors, anchor_index)
    if rendered is None:
        return None
    inp, out = rendered
    try:
        solved = main(inp)
    except Exception:
        return None
    return inp if np.array_equal(solved, out) else None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid

import numpy as np
from typing import *
from arc_utils import Color, bbox, colors_present, crop_bbox, draw_line, find_components, paste, random_free_location, random_sprite
import random

# concepts:
# puzzle pieces, rotation

# description:
# In the input you will see a red object with holes in it, and several multicolored 3x3 "puzzle pieces"
# To make the output, crop to just the red object and then put each puzzle piece in the red object so that the red pixels in the puzzle piece perfectly fit into the holes in the red object. You can rotate and translate the puzzle pieces to make them fit.

def main(input_grid):
    """
    Crop the red object and fit each multicolor puzzle piece into its matching red-shaped hole.

    Input structure:
    - The input contains one fully red object with black holes.
    - It also contains several multicolor puzzle pieces on the black background.
    - Puzzle pieces may include red cells that act as the hole-fitting stencil.

    Rule:
    - Crop the red object to form the output canvas.
    - Sort puzzle pieces by the number of red cells so larger stencils are placed first.
    - Try rotations and translations, placing each piece where its red cells land only on black holes.

    Key insight:
    - Red cells inside a piece are not paint for the red object; they are the stencil that tells
      which hole shape the piece can occupy.
    """
    # Plan:
    # 1. Detect the object, separating the puzzle pieces from the red object with holes
    # 2. Crop to just the red object
    # 3. Put each puzzle piece so that its red pixels perfectly overlay holes in the red object (considering translations and rotations)

    # 1. Separate puzzle pieces from the red object (remembering that puzzle pieces might have some red in them also: they are not monochromatic---but the red thing is fully red)
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
    red_objects = [ obj for obj in objects if set(colors_present(obj, exclude={ Color.BLACK })) == {Color.RED} ]
    puzzle_pieces = [ obj for obj in objects if set(colors_present(obj, exclude={ Color.BLACK })) != {Color.RED} ]

    assert len(red_objects) == 1, "There should be exactly one fully red object"
    red_object = red_objects[0]

    # 2. The output begins by cropping to just the red object
    _b = bbox(red_object != Color.BLACK)
    assert _b is not None
    output_grid = crop_bbox(red_object, _b)

    # 3. Put each puzzle piece so that its red pixels perfectly overlay holes in the red object
    # Put in the pieces which have the most red first (otherwise a small puzzle piece might go in a big hole)
    puzzle_pieces.sort(key=lambda piece: np.sum(piece == Color.RED), reverse=True)

    for puzzle_piece in puzzle_pieces:
        # Extract just the sprite of this piece, and then figure out where it should go, including its position and rotation
        _b = bbox(puzzle_piece != Color.BLACK)
        assert _b is not None
        piece_sprite = crop_bbox(puzzle_piece, _b)
        possible_sprites = [ piece_sprite, np.rot90(piece_sprite), np.rot90(piece_sprite, k=2), np.rot90(piece_sprite, k=3) ]

        # A placement solution is a tuple (x, y, sprite) where x, y is the top-left corner of the rotated sprite
        possible_solutions = [ (r, c, sprite)
                              for sprite in possible_sprites
                              for r in range(output_grid.shape[0] - piece_sprite.shape[0] + 1)
                              for c in range(output_grid.shape[1] - piece_sprite.shape[1] + 1) ]
        
        # Filter placement solutions to only those where the red pixels of the piece fit into the holes of the red object
        def valid_solution(r, c, sprite):
            # Make a canvas to try putting down the sprite
            test_canvas = np.full_like(output_grid, Color.BLACK)
            paste(test_canvas, sprite, r, c, transparent=Color.BLACK, clip=True)
            # Check if every red pixel in the placed test object is also red in the red object
            red_pixels = [ (r, c) for r, c in np.argwhere(test_canvas == Color.RED) ]
            return all( output_grid[red_r, red_c] == Color.BLACK for red_r, red_c in red_pixels )
                
        possible_solutions = [ solution for solution in possible_solutions if valid_solution(*solution) ]
        if len(possible_solutions) == 0:
            assert False, "No solution found for puzzle piece"

        # Pick the first solution and blit the sprite into the output grid
        r, c, sprite = list(possible_solutions)[0]
        paste(output_grid, sprite, r, c, transparent=Color.BLACK, clip=True)
    
    return output_grid

def generate_input():
    # Choose 2-4 distinct piece shapes with different red-pixel counts (so the greedy solver order is unambiguous).
    # We keep holes small to avoid disconnecting the red object.
    all_cells = [(r, c) for r in range(3) for c in range(3)]
    shape_templates: list[list[tuple[int, int]]] = [
        [cell for cell in all_cells if cell != (1, 1)],  # 8 pixels (1 hole at center)
        [cell for cell in all_cells if cell not in {(1, 1), (0, 0)}],  # 7 pixels (2 holes)
        [cell for cell in all_cells if cell not in {(1, 1), (0, 0), (2, 2)}],  # 6 pixels (3 holes)
        [(1, 1), (0, 1), (2, 1), (1, 0), (1, 2)],  # plus shape (5 pixels / 4 holes)
    ]
    n_pieces = np.random.randint(2, 5)
    min_side = 10 if n_pieces <= 2 else (12 if n_pieces == 3 else 14)
    canvas_h, canvas_w = np.random.randint(min_side, 20), np.random.randint(min_side, 20)
    red_canvas = np.full((canvas_h, canvas_w), Color.RED)
    chosen_templates = random.sample(shape_templates, k=n_pieces)

    pieces: list[np.ndarray] = []

    # Reserve non-overlapping 3x3 blocks on a coarse lattice (guaranteed fit, no retries).
    row_starts = list(range(1, canvas_h - 3, 5))
    col_starts = list(range(1, canvas_w - 3, 5))
    block_positions = [(r, c) for r in row_starts for c in col_starts]
    block_positions = random.sample(block_positions, k=n_pieces)

    for template, (r0, c0) in zip(chosen_templates, block_positions):
        non_red_color = random.choice([c for c in Color.NOT_BLACK if c != Color.RED])

        piece = np.full((3, 3), Color.RED, dtype=int)
        for rr, cc in template:
            piece[int(rr), int(cc)] = int(non_red_color)
        pieces.append(piece)

        # Punch holes using a rotated version of the piece (solver is allowed to rotate pieces).
        rotated_piece = np.rot90(piece, k=np.random.randint(0, 4))

        holes = (rotated_piece == Color.RED)
        red_canvas[r0 : r0 + 3, c0 : c0 + 3][holes] = Color.BLACK

    # Create the final input grid.
    # Place the red canvas and all pieces in a guaranteed non-overlapping layout (no retries).
    sep = 2  # empty columns between the canvas and the pieces
    min_W = canvas_w + sep + 3
    min_H = max(canvas_h, (n_pieces - 1) * 4 + 3)
    H = np.random.randint(min_H, 30 + 1)
    W = np.random.randint(min_W, 30 + 1)
    grid = np.full((H, W), Color.BLACK)

    # Place the red canvas on the left.
    r_canvas = np.random.randint(0, H - canvas_h + 1)
    c_canvas = 0
    paste(grid, red_canvas, r_canvas, c_canvas, transparent=Color.BLACK, clip=True)

    # Place all pieces in a vertical strip on the right, spaced out.
    c_piece = canvas_w + sep
    r0 = np.random.randint(0, H - ((n_pieces - 1) * 4 + 3) + 1)
    for i, piece in enumerate(pieces):
        r = r0 + i * 4
        paste(grid, piece, r, c_piece, transparent=Color.BLACK, clip=True)

    # Random rotation for variety.
    grid = np.rot90(grid, k=np.random.randint(0, 4))
    return grid
import numpy as np

from arc_utils import bbox, colors_present, get_bg
import random


def _rectangular_frame_bbox(mask: np.ndarray):
    b = bbox(mask)
    if b is None:
        return None

    r0, c0, r1, c1 = b
    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
        return None

    expected = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    expected[0, :] = True
    expected[-1, :] = True
    expected[:, 0] = True
    expected[:, -1] = True
    if not np.array_equal(mask[r0 : r1 + 1, c0 : c1 + 1], expected):
        return None
    return b


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the inside of the rectangular frame with nested color bands read from the diagonal markers.

    Input structure
    - The background is empty, with one one-pixel-thick rectangular foreground frame.
    - Every other foreground color appears as a singleton marker pixel.
    - The markers form a contiguous down-right diagonal ending one pixel above-left of the frame.

    Rule
    - Read the marker colors in diagonal order from upper-left to lower-right.
    - Fill the frame interior with rectangular bands in that order: each color
      paints the next inward ring, and the final color fills the remaining center.
    - Preserve the frame, markers, and exterior background.

    Key insight
    - The diagonal singleton markers are an outer-to-inner palette for the empty framed region.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    frame_candidates = []
    for color in colors_present(g, exclude={bg}):
        candidate = _rectangular_frame_bbox(g == color)
        if candidate is not None:
            frame_candidates.append((int(color), candidate))
    assert len(frame_candidates) == 1, "expected one rectangular frame color"

    frame_color, frame_bbox = frame_candidates[0]
    r0, c0, r1, c1 = frame_bbox
    assert np.all(g[r0 + 1 : r1, c0 + 1 : c1] == bg), "expected empty frame interior"

    markers = []
    for color in colors_present(g, exclude={bg, frame_color}):
        coords = np.argwhere(g == color)
        assert coords.shape == (1, 2), "expected each palette color to be one marker pixel"
        markers.append((int(coords[0, 0]), int(coords[0, 1]), int(color)))
    assert markers, "expected at least one marker"

    markers.sort(key=lambda item: (item[0], item[1]))
    for (r, c, _color), (next_r, next_c, _next_color) in zip(markers, markers[1:]):
        assert (next_r, next_c) == (r + 1, c + 1), "expected a contiguous diagonal marker run"
    assert (markers[-1][0], markers[-1][1]) == (r0 - 1, c0 - 1), (
        "expected marker diagonal to end above-left of the frame"
    )

    out = g.copy()
    marker_colors = [color for _r, _c, color in markers]
    for i, color in enumerate(marker_colors):
        rr0 = r0 + 1 + i
        cc0 = c0 + 1 + i
        rr1 = r1 - 1 - i
        cc1 = c1 - 1 - i
        assert rr0 <= rr1 and cc0 <= cc1, "expected enough interior for all marker colors"

        if i == len(marker_colors) - 1:
            assert np.all(out[rr0 : rr1 + 1, cc0 : cc1 + 1] == bg)
            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = color
        else:
            assert np.all(out[rr0, cc0 : cc1 + 1] == bg)
            assert np.all(out[rr1, cc0 : cc1 + 1] == bg)
            assert np.all(out[rr0 : rr1 + 1, cc0] == bg)
            assert np.all(out[rr0 : rr1 + 1, cc1] == bg)
            out[rr0, cc0 : cc1 + 1] = color
            out[rr1, cc0 : cc1 + 1] = color
            out[rr0 : rr1 + 1, cc0] = color
            out[rr0 : rr1 + 1, cc1] = color

    return out

# --------------- generator (o5x) ---------------
# Bounds and palette.
GRID_MIN, GRID_MAX = 10, 20
INTERIOR_MIN, INTERIOR_MAX = 4, 12
PADDING_MIN, PADDING_MAX = 1, 3
MARKER_COUNT_MIN, MARKER_COUNT_MAX = 2, 5
MARKER_COLOR_MIN, MARKER_COLOR_MAX = 2, 9
BG_COLOR, FRAME_COLOR = 0, 1

# Frame geometry and retry budget.
FRAME_CELLS = 2
MAX_GENERATION_ATTEMPTS = 300


def _sample_inner_size(n_markers, pad):
    min_inner = max(INTERIOR_MIN, 2 * n_markers - 1, GRID_MIN - n_markers - FRAME_CELLS - pad)
    max_inner = min(INTERIOR_MAX, GRID_MAX - n_markers - FRAME_CELLS - pad)
    return None if min_inner > max_inner else random.randint(min_inner, max_inner)


def _draw_markers_and_bands(out, marker_colors, frame_bbox):
    r0, c0, r1, c1 = frame_bbox
    for i, color in enumerate(marker_colors):
        out[i, i] = color
        rr0 = r0 + 1 + i
        cc0 = c0 + 1 + i
        rr1 = r1 - 1 - i
        cc1 = c1 - 1 - i
        if i == len(marker_colors) - 1:
            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = color
        else:
            out[rr0, cc0 : cc1 + 1] = color
            out[rr1, cc0 : cc1 + 1] = color
            out[rr0 : rr1 + 1, cc0] = color
            out[rr0 : rr1 + 1, cc1] = color


def _gen_attempt():
    n_markers = random.randint(MARKER_COUNT_MIN, MARKER_COUNT_MAX)
    pad_bottom = random.randint(PADDING_MIN, PADDING_MAX)
    pad_right = random.randint(PADDING_MIN, PADDING_MAX)

    inner_h = _sample_inner_size(n_markers, pad_bottom)
    if inner_h is None:
        return None
    inner_w = _sample_inner_size(n_markers, pad_right)
    if inner_w is None:
        return None
    height = n_markers + inner_h + FRAME_CELLS + pad_bottom
    width = n_markers + inner_w + FRAME_CELLS + pad_right
    out = np.zeros((height, width), dtype=int)
    marker_colors = random.sample(range(MARKER_COLOR_MIN, MARKER_COLOR_MAX + 1), n_markers)
    r0 = c0 = n_markers
    r1, c1 = r0 + inner_h + 1, c0 + inner_w + 1

    out[r0, c0 : c1 + 1] = FRAME_COLOR
    out[r1, c0 : c1 + 1] = FRAME_COLOR
    out[r0 : r1 + 1, c0] = FRAME_COLOR
    out[r0 : r1 + 1, c1] = FRAME_COLOR
    _draw_markers_and_bands(out, marker_colors, (r0, c0, r1, c1))

    inp = out.copy()
    inp[r0 + 1 : r1, c0 + 1 : c1] = BG_COLOR

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 99306f82 input")
from collections import Counter

import numpy as np

from arc_utils import crop_bbox, find_components, get_bg, is_contiguous, paste
import random
from itertools import combinations


def main(grid: np.ndarray) -> np.ndarray:
    """
    Crop the single 5x5 foreground block whose number of background holes is different from the others.

    Input structure
    - The background is the dominant color.
    - Exactly one foreground color forms several disconnected 5x5 blocks.
    - Each block has a solid foreground border and may contain background holes in its interior.

    Rule
    - Count the background pixels inside each 5x5 block's bounding box.
    - Find the one hole count that occurs for exactly one block.
    - Return that unique block cropped to its 5x5 bounding box.

    Key insight
    - The requested pattern is not determined by position; it is the outlier among the repeated blocks by internal hole count.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)

    assert len(objects) >= 2
    colors = {int(obj["color"]) for obj in objects}
    assert len(colors) == 1
    fg = next(iter(colors))

    crops: list[tuple[int, np.ndarray]] = []
    for obj in objects:
        crop = crop_bbox(g, obj["bbox"])
        assert crop.shape == (5, 5)
        assert int(np.sum(crop == fg)) == int(obj["area"])
        assert np.all((crop == bg) | (crop == fg))
        assert np.all(crop[0, :] == fg)
        assert np.all(crop[-1, :] == fg)
        assert np.all(crop[:, 0] == fg)
        assert np.all(crop[:, -1] == fg)
        holes = int(np.sum(crop == bg))
        crops.append((holes, crop))

    hole_counts = Counter(holes for holes, _ in crops)
    unique_holes = [holes for holes, n in hole_counts.items() if n == 1]
    assert len(unique_holes) == 1

    matches = [crop for holes, crop in crops if holes == unique_holes[0]]
    assert len(matches) == 1
    return matches[0].copy()

# --------------- generator (o5x) ---------------

# Canvas and palette bounds.
CANVAS_HEIGHT_RANGE = (14, 17)
CANVAS_WIDTH_RANGE = (18, 19)
FG_COLOR_RANGE = (1, 9)

# Block and hole structure.
BG = 0
BLOCK_SIZE = 5
INTERIOR_SIZE = 3
INTERIOR_OFFSET = 1
INTERIOR_CENTER = (1, 1)
HOLE_COUNT_RANGE = (1, 4)
COMMON_HOLE_RANGE = (2, 3)
BLOCK_COUNT_RANGE = (4, 5)
HOLE_CONNECTIVITY = 4
INTERIOR_HOLE_CELLS = tuple((r, c) for r in range(INTERIOR_SIZE) for c in range(INTERIOR_SIZE) if (r, c) != INTERIOR_CENTER)

# Layout candidates, separation, and retry policy.
MIN_BLOCK_GAP = 1
BASE_LAYOUTS = ((2, 3),)
FOUR_BLOCK_LAYOUT = (2, 2)
TALL_LAYOUT = (3, 2)
TALL_LAYOUT_MIN_HEIGHT = 17
GEN_ATTEMPTS = 300

def _gen_hole_pattern(count: int) -> tuple[tuple[int, int], ...]:
    options = []
    for combo in combinations(INTERIOR_HOLE_CELLS, count):
        if all(abs(a[0] - b[0]) + abs(a[1] - b[1]) != 1 for a, b in combinations(combo, 2)):
            mask = np.ones((BLOCK_SIZE, BLOCK_SIZE), dtype=int)
            for r, c in combo:
                mask[r + INTERIOR_OFFSET, c + INTERIOR_OFFSET] = BG
            if is_contiguous(mask, background=BG, connectivity=HOLE_CONNECTIVITY):
                options.append(combo)
    return random.choice(options)

def _gen_block(fg: int, holes: int) -> np.ndarray:
    block = np.full((BLOCK_SIZE, BLOCK_SIZE), fg, dtype=int)
    for r, c in _gen_hole_pattern(holes):
        block[r + INTERIOR_OFFSET, c + INTERIOR_OFFSET] = BG
    return block

def _gen_axis_positions(total: int, count: int) -> list[int] | None:
    base = BLOCK_SIZE * count + MIN_BLOCK_GAP * (count - 1)
    if base > total:
        return None
    extras = [0] * (count + 1)
    for _ in range(total - base):
        extras[random.randrange(count + 1)] += 1
    positions = []
    cursor = extras[0]
    for i in range(count):
        positions.append(cursor)
        if i + 1 < count:
            cursor += BLOCK_SIZE + MIN_BLOCK_GAP + extras[i + 1]
    return positions

def _gen_locations(height: int, width: int, count: int) -> list[tuple[int, int]] | None:
    layouts = list(BASE_LAYOUTS)
    if count == FOUR_BLOCK_LAYOUT[0] * FOUR_BLOCK_LAYOUT[1]:
        layouts.append(FOUR_BLOCK_LAYOUT)
    if height >= TALL_LAYOUT_MIN_HEIGHT:
        layouts.append(TALL_LAYOUT)
    random.shuffle(layouts)
    for rows, cols in layouts:
        if rows * cols < count:
            continue
        row_positions = _gen_axis_positions(height, rows)
        col_positions = _gen_axis_positions(width, cols)
        if row_positions is None or col_positions is None:
            continue
        slots = [(r, c) for r in row_positions for c in col_positions]
        random.shuffle(slots)
        return slots[:count]
    return None

def _render_grid(height, width, fg, block_count, common_holes, unique_holes, locations):
    """Return the input grid and expected crop for the unique block."""
    unique_index = random.randrange(block_count)
    grid = np.zeros((height, width), dtype=int)
    expected = None
    for i, (r, c) in enumerate(locations):
        holes = unique_holes if i == unique_index else common_holes
        block = _gen_block(fg, holes)
        paste(grid, block, r, c, transparent=None)
        if i == unique_index:
            expected = block
    return grid, expected

def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*CANVAS_HEIGHT_RANGE)
    width = random.randint(*CANVAS_WIDTH_RANGE)
    fg = random.randint(*FG_COLOR_RANGE)
    block_count = random.randint(*BLOCK_COUNT_RANGE)
    common_holes = random.randint(*COMMON_HOLE_RANGE)
    unique_holes = random.choice([n for n in range(HOLE_COUNT_RANGE[0], HOLE_COUNT_RANGE[1] + 1) if n != common_holes])
    locations = _gen_locations(height, width, block_count)
    if locations is None:
        return None
    grid, expected = _render_grid(height, width, fg, block_count, common_holes, unique_holes, locations)
    try:
        if expected is not None and np.array_equal(main(grid), expected):
            return grid
    except AssertionError:
        pass
    return None

def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

