import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste

# concepts:
# growing

# description:
# In the input you will see a grid with some green rectangles. Each rectangle has one red pixel on one of its borders.
# To make the output, you should extend the green region of each rectangle to the border of the grid in the direction of the red pixel, with the extent of the line increasing with the extent of the rectangle.
# Also you should draw a red line from the red pixel to the border of the grid.


def main(input_grid):
    """
    Grow each green rectangle outward from its red border indicator to the canvas edge.

    Input structure:
    - Each foreground object is a green rectangle with one red pixel on its border.
    - Objects sit on a black background.
    - The red pixel indicates the side from which growth should extend.

    Rule:
    - Find each rectangle-and-indicator component.
    - Extend a green band from the rectangle toward the canvas edge on the indicator side.
    - Draw a red line from the indicator pixel to that same edge.

    Key insight:
    - The indicator side controls direction, while the rectangle thickness controls the grown band.
    """
    # Initialize the output grid
    output_grid = np.copy(input_grid)
    
    rectangle_color = Color.GREEN
    indicator_color = Color.RED
    background = Color.BLACK

    # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
    objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
    for obj in objects:
        # find the red indicator
        for red_r, red_c in np.argwhere(obj == indicator_color):
            break

        # Get the dimensions of the object, and its position
        _b = bbox(obj != background)
        assert _b is not None
        r, c, _r1, _c1 = _b
        width = _r1 - r + 1
        height = _c1 - c + 1

        # depending on which side of the rectangle that the indicator is on, we draw in different directions
        # left edge: draw to the left
        if red_r == r:
            # Extend the green rectangle to the left until it reaches the border
            output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
        elif red_r == r + width - 1:
            # Extend the green rectangle to the right until it reaches the border
            output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
        elif red_c == c:
            # Extend the green rectangle to the top until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
        elif red_c == c + height - 1:
            # Extend the green rectangle to the bottom until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
        else:
            assert False, "The red pixel is not on the border of the rectangle"

    return output_grid

def generate_input():
    # Create the background grid
    n, m = np.random.randint(20, 30), np.random.randint(20, 30)
    grid = np.full((m, n), Color.BLACK)

    rectangle_num = 2
    rectangle_color = Color.GREEN
    indicator_color = Color.RED

    # Draw rectangles on the grid
    for i in range(rectangle_num):
        width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        # The width should be twice smaller than the height
        while (width * 2 + 2) >= height:
            width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        green_rectangle = np.full((width, height), rectangle_color)

        # Place one indicator pixel on one random border of the rectangle
        # Spare enough space for the extend line with the same size of width - 1
        r_coord = np.random.choice([0, width - 1])
        c_coord = np.random.choice(range(width + 1, height - (width + 1)))
        green_rectangle[r_coord, c_coord] = indicator_color
        # Randomly rotate the object so that we get a variety of orientations
        if np.random.choice([True, False]):
            green_rectangle = np.rot90(green_rectangle, k=-1)
            r_coord, c_coord = c_coord, r_coord

        # Place the rectangle on the grid
        try:
            _loc = first_free_location(grid, green_rectangle, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        # Check if there is no space for the rectangle
        except:
            return generate_input()
        paste(grid, green_rectangle, r, c, transparent=Color.BLACK, clip=True)

    # Check if the generated grid is valid
    transformed_grid = main(grid)
    objects = find_components(transformed_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")

    # After transformation, the two objects should not touch each other
    if len(objects) != rectangle_num:
        # Regenerate the grid
        return generate_input()

    return grid
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def _sparse_marker_color(g: np.ndarray, bg: int) -> int:
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected exactly two foreground colors"

    counts = {color: int(np.count_nonzero(g == color)) for color in colors}
    marker_count = min(counts.values())
    markers = [color for color, count in counts.items() if count == marker_count]
    assert len(markers) == 1, "sparse marker color must be unique"
    assert any(count > marker_count for count in counts.values()), "expected one color to be denser than the marker"
    return markers[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase each foreground object that contains more than one sparse marker-color pixel.

    Input structure
    - A dominant background surrounds separated 4-connected foreground objects.
    - The foreground uses one dense object color and one sparse marker color.
    Rule
    - Infer the marker as the unique less frequent foreground color.
    - Keep objects with zero or one marker pixel.
    - Recolor every pixel of an object to background when it contains two or more marker pixels.
    Key insight
    - The marker count inside each whole object, not the object's size or position, decides whether that object remains.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    marker = _sparse_marker_color(g, bg)

    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    assert objects, "expected foreground objects"

    out = g.copy()
    kept_any = False
    removed_any = False
    for obj in objects:
        coords = obj["coords"]
        marker_count = int(np.count_nonzero(g[coords[:, 0], coords[:, 1]] == marker))
        if marker_count >= 2:
            out[coords[:, 0], coords[:, 1]] = bg
            removed_any = True
        else:
            kept_any = True

    assert kept_any and removed_any, "expected both kept and erased objects"
    return out

# --------------- generator (o5x) ---------------

# Canvas and object geometry.
ROW_RANGE, COL_RANGE = (13, 14), (12, 15)
OBJECT_RANGE = (6, 7)
RECT_H_RANGE, RECT_W_RANGE = (2, 4), (2, 6)
RECT_DIMS = tuple((h, w) for h in range(RECT_H_RANGE[0], RECT_H_RANGE[1] + 1) for w in range(RECT_W_RANGE[0], RECT_W_RANGE[1] + 1))
RECT_MIN_AREA = RECT_H_RANGE[0] * RECT_W_RANGE[0]
RECT_MAX_AREA = RECT_H_RANGE[1] * RECT_W_RANGE[1]

# Marker assignment and foreground density.
KEPT_OBJECT_COUNT = 3
MARKER_TOTAL_RANGE = (9, 14)
KEPT_MARKERS = (0, 1)
REMOVED_MARKERS = (2, 4)
FG_AREA_FACTORS = (5, 9)
FG_AREA_DIVISOR = 2

# Rendering, placement, and retries.
BG_COLOR, DENSE_COLOR, MARKER_COLOR = 0, 1, 8
PLACE_PAD, PLACE_CONN = 1, 8
PLACE_KWARGS = dict(transparent=BG_COLOR, padding=PLACE_PAD, padding_connectivity=PLACE_CONN)
MAX_GENERATION_ATTEMPTS = 300


def _gen_bounded_parts(n: int, total: int, lo: int, hi: int) -> list[int] | None:
    parts: list[int] = []
    remaining = int(total)
    for i in range(int(n)):
        rem = int(n) - i - 1
        low = max(int(lo), remaining - int(hi) * rem)
        high = min(int(hi), remaining - int(lo) * rem)
        if low > high:
            return None
        value = random.randint(low, high)
        parts.append(value)
        remaining -= value
    return parts if remaining == 0 else None


def _gen_marker_counts(n_objects: int, total_markers: int) -> list[tuple[int, bool]] | None:
    kept_count = KEPT_OBJECT_COUNT
    removed_count = int(n_objects) - kept_count
    kept_totals = [
        k
        for k in range(kept_count + 1)
        if REMOVED_MARKERS[0] * removed_count <= int(total_markers) - k <= REMOVED_MARKERS[1] * removed_count
    ]
    if not kept_totals:
        return None

    kept_total = random.choice(kept_totals)
    kept_markers = [KEPT_MARKERS[1]] * kept_total + [KEPT_MARKERS[0]] * (kept_count - kept_total)
    random.shuffle(kept_markers)

    removed_markers = _gen_bounded_parts(removed_count, int(total_markers) - kept_total, *REMOVED_MARKERS)
    if removed_markers is None:
        return None

    objects = [(m, True) for m in kept_markers] + [(m, False) for m in removed_markers]
    random.shuffle(objects)
    return objects


def _gen_rect_dims(n_objects: int, min_area: int, max_area: int) -> list[tuple[int, int]] | None:
    dims: list[tuple[int, int]] = []
    area = 0
    for i in range(int(n_objects)):
        rem = int(n_objects) - i - 1
        feasible = []
        for h, w in RECT_DIMS:
            new_area = area + h * w
            if new_area + rem * RECT_MIN_AREA <= int(max_area) and new_area + rem * RECT_MAX_AREA >= int(min_area):
                feasible.append((h, w))
        if not feasible:
            return None
        h, w = random.choice(feasible)
        dims.append((h, w))
        area += h * w

    if not (int(min_area) <= area <= int(max_area)):
        return None
    random.shuffle(dims)
    return dims


def _gen_pair_dims_counts(dims: list[tuple[int, int]], counts: list[tuple[int, bool]]):
    remaining = list(dims)
    paired: list[tuple[int, int, int, bool]] = []
    for marker_count, keep in sorted(counts, reverse=True):
        compatible = [i for i, (h, w) in enumerate(remaining) if h * w > marker_count]
        if not compatible:
            return None
        idx = random.choice(compatible)
        h, w = remaining.pop(idx)
        paired.append((h, w, marker_count, keep))
    random.shuffle(paired)
    return paired


def _gen_marked_rect(h: int, w: int, marker_count: int) -> np.ndarray:
    rect = np.full((h, w), DENSE_COLOR, dtype=int)
    rect.flat[random.sample(range(h * w), marker_count)] = MARKER_COLOR
    return rect


def _render_specs(rows: int, cols: int, specs: list[tuple[int, int, int, bool]]):
    """Return generated input and expected output, or None if placement fails."""
    inp = np.full((rows, cols), BG_COLOR, dtype=int)
    expected = np.full_like(inp, BG_COLOR)
    occupancy = np.full_like(inp, BG_COLOR)
    order = list(specs)
    random.shuffle(order)
    order.sort(key=lambda item: item[0] * item[1], reverse=True)

    for h, w, marker_count, keep in order:
        patch = np.full((h, w), DENSE_COLOR, dtype=int)
        try:
            r0, c0 = random_free_location(occupancy, patch, **PLACE_KWARGS)
        except ValueError:
            return None

        rect = _gen_marked_rect(h, w, marker_count)
        paste(inp, rect, r0, c0)
        paste(occupancy, patch, r0, c0)
        if keep:
            paste(expected, rect, r0, c0)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*ROW_RANGE)
    cols = random.randint(*COL_RANGE)
    n_objects = random.randint(*OBJECT_RANGE)
    total_markers = random.randint(*MARKER_TOTAL_RANGE)

    grid_area = rows * cols
    min_area = FG_AREA_FACTORS[0] * total_markers
    max_area = min(FG_AREA_FACTORS[1] * total_markers, (grid_area + total_markers - 1) // FG_AREA_DIVISOR)
    if min_area > max_area:
        return None

    dims = _gen_rect_dims(n_objects, min_area, max_area)
    counts = _gen_marker_counts(n_objects, total_markers)
    if dims is None or counts is None:
        return None
    specs = _gen_pair_dims_counts(dims, counts)
    if specs is None:
        return None

    rendered = _render_specs(rows, cols, specs)
    if rendered is None:
        return None
    inp, expected = rendered

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, is_contiguous, paste
import itertools
import random


def _template_mask(component: dict, bbox: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    for r, c in component["coords"]:
        mask[int(r) - r0, int(c) - c0] = True
    return mask


def _copy_starts(positions: list[int], anchor_index: int, anchor_start: int, sprite_len: int) -> list[int]:
    starts: list[int | None] = [None] * len(positions)
    starts[anchor_index] = int(anchor_start)

    for i in range(anchor_index + 1, len(positions)):
        gap = positions[i] - positions[i - 1] - 1
        assert gap >= 0, "control pixels must be in increasing order without duplicates"
        assert starts[i - 1] is not None
        starts[i] = starts[i - 1] + sprite_len + gap

    for i in range(anchor_index - 1, -1, -1):
        gap = positions[i + 1] - positions[i] - 1
        assert gap >= 0, "control pixels must be in increasing order without duplicates"
        assert starts[i + 1] is not None
        starts[i] = starts[i + 1] - sprite_len - gap

    assert all(start is not None for start in starts)
    return [int(start) for start in starts]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Copy the red template sprite along the control-pixel line, preserving control gaps and recoloring each copy.

    Input structure
    The grid has a black background, one 8-connected red template sprite, and
    several isolated control pixels in one row or column.  Exactly one control
    pixel has the template color.

    Rule
    Read the control pixels left-to-right or top-to-bottom.  The copy matching
    the template-color control is the original sprite; each neighboring control
    becomes a same-shape copy in that control color.  The empty cells between
    adjacent control pixels become the empty columns or rows between adjacent
    sprite bboxes.

    Key insight
    The singleton control line is a compressed ordered layout: expanding each
    marker to the template bbox while keeping the inter-marker gaps fixes every
    copy position from the original sprite.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    components = find_components(g, bg=bg, connectivity=8, monochromatic=True)
    sprite_components = [component for component in components if component["area"] > 1]
    assert len(sprite_components) == 1, "expected one non-singleton template sprite"

    sprite = sprite_components[0]
    template_color = int(sprite["color"])
    sr0, sc0, sr1, sc1 = sprite["bbox"]
    template = _template_mask(sprite, sprite["bbox"])
    sprite_h, sprite_w = template.shape

    controls: list[tuple[int, int, int]] = []
    for component in components:
        if component is sprite:
            continue
        assert component["area"] == 1, "all non-template components must be singleton controls"
        r, c = map(int, component["coords"][0])
        controls.append((r, c, int(component["color"])))

    assert len(controls) >= 2, "expected an ordered control line"
    anchor_indices = [i for i, (_, _, color) in enumerate(controls) if color == template_color]
    assert len(anchor_indices) == 1, "expected one control pixel with the template color"

    control_rows = {r for r, _, _ in controls}
    control_cols = {c for _, c, _ in controls}
    if len(control_rows) == 1:
        controls.sort(key=lambda item: item[1])
        positions = [c for _, c, _ in controls]
        anchor_index = next(i for i, (_, _, color) in enumerate(controls) if color == template_color)
        starts = _copy_starts(positions, anchor_index, sc0, sprite_w)
        placements = [(sr0, start, color) for start, (_, _, color) in zip(starts, controls)]
    elif len(control_cols) == 1:
        controls.sort(key=lambda item: item[0])
        positions = [r for r, _, _ in controls]
        anchor_index = next(i for i, (_, _, color) in enumerate(controls) if color == template_color)
        starts = _copy_starts(positions, anchor_index, sr0, sprite_h)
        placements = [(start, sc0, color) for start, (_, _, color) in zip(starts, controls)]
    else:
        raise AssertionError("control pixels must share one row or one column")

    out = g.copy()
    H, W = g.shape
    for r0, c0, color in placements:
        assert 0 <= r0 and 0 <= c0 and r0 + sprite_h <= H and c0 + sprite_w <= W
        target = out[r0 : r0 + sprite_h, c0 : c0 + sprite_w]
        occupied = target[template]
        if color == template_color:
            assert np.all(occupied == template_color), "template-color copy must be the original sprite"
        else:
            assert np.all(occupied == bg), "new copies must land on background"
        target[template] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas and axis bounds.
GRID_HEIGHT_BOUNDS = (13, 23)
GRID_WIDTH_BOUNDS = (14, 24)
HORIZONTAL = "horizontal"
VERTICAL = "vertical"
AXES = [HORIZONTAL, VERTICAL]

# Sprite geometry and colors.
SPRITE_SIZE = 3
SPRITE_AREAS = [6, 7]
BACKGROUND_COLOR = 0
SPRITE_COLOR = 2

# Control-line layout and palette.
CONTROL_COUNTS = [4, 5]
CONTROL_GAP_BOUNDS = (1, 4)
CONTROL_EDGE_COORDS = [1, 2]
CONTROL_TO_SPRITE_MIN_OFFSET = 5
CONTROL_PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
CONTROL_DISTINCT_BOUNDS = (2, 4)
MIN_COPY_SPAN_FRACTION = 0.75

# Retry limits.
GENERATION_RETRIES = 300

def _gen_sprite_mask() -> np.ndarray:
    area = random.choice(SPRITE_AREAS)
    masks: list[np.ndarray] = []
    for cells in itertools.combinations(range(SPRITE_SIZE * SPRITE_SIZE), area):
        mask = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=bool)
        for cell in cells:
            mask[cell // SPRITE_SIZE, cell % SPRITE_SIZE] = True
        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
            continue
        if is_contiguous(mask.astype(int), background=BACKGROUND_COLOR, connectivity=8):
            masks.append(mask)
    return random.choice(masks)


def _gen_gaps(count: int, max_axis_len: int) -> list[int]:
    gap_min, gap_max = CONTROL_GAP_BOUNDS
    choices = [
        list(gaps)
        for gaps in itertools.product(range(gap_min, gap_max + 1), repeat=count - 1)
        if count * SPRITE_SIZE + sum(gaps) <= max_axis_len
    ]
    return random.choice(choices)


def _gen_control_positions(axis_len: int, gaps: list[int]) -> list[int] | None:
    control_span = len(gaps) + 1 + sum(gaps)
    if control_span > axis_len:
        return None
    if control_span <= axis_len - 2:
        start = random.randint(1, axis_len - control_span - 1)
    else:
        start = random.randint(0, axis_len - control_span)
    positions = [start]
    for gap in gaps:
        positions.append(positions[-1] + gap + 1)
    return positions


def _gen_control_colors(count: int, anchor_index: int) -> list[int]:
    distinct_min, distinct_max = CONTROL_DISTINCT_BOUNDS
    distinct_count = random.randint(distinct_min, min(distinct_max, count))
    selected = random.sample(CONTROL_PALETTE, distinct_count - 1)
    other_count = count - 1
    others = selected[:]
    while len(others) < other_count:
        others.append(random.choice(selected))
    random.shuffle(others)

    colors: list[int] = []
    other_i = 0
    for i in range(count):
        if i == anchor_index:
            colors.append(SPRITE_COLOR)
        else:
            colors.append(others[other_i])
            other_i += 1
    return colors


def _gen_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)
    patch[mask] = int(color)
    return patch


def _gen_copy_starts(axis_len: int, copy_span: int, gaps: list[int]) -> list[int]:
    starts = [random.randint(0, axis_len - copy_span)]
    for gap in gaps:
        starts.append(starts[-1] + SPRITE_SIZE + gap)
    return starts


def _origin(axis: str, start: int, fixed_coord: int) -> tuple[int, int]:
    return (fixed_coord, start) if axis == HORIZONTAL else (start, fixed_coord)


def _render_candidate(axis, height, width, mask, starts, control_positions, colors, anchor_index):
    out = np.zeros((height, width), dtype=int)
    fixed_limit = height if axis == HORIZONTAL else width
    control_fixed = random.choice(CONTROL_EDGE_COORDS)
    min_sprite_fixed = control_fixed + CONTROL_TO_SPRITE_MIN_OFFSET
    if min_sprite_fixed > fixed_limit - SPRITE_SIZE:
        return None
    sprite_fixed = random.randint(min_sprite_fixed, fixed_limit - SPRITE_SIZE)

    for start, color in zip(starts, colors):
        r, c = _origin(axis, start, sprite_fixed)
        paste(out, _gen_patch(mask, color), r, c, transparent=BACKGROUND_COLOR)

    for position, color in zip(control_positions, colors):
        r, c = _origin(axis, position, control_fixed)
        out[r, c] = color

    inp = out.copy()
    for i, start in enumerate(starts):
        if i == anchor_index:
            continue
        r, c = _origin(axis, start, sprite_fixed)
        inp[r : r + SPRITE_SIZE, c : c + SPRITE_SIZE][mask] = BACKGROUND_COLOR
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    axis = random.choice(AXES)
    count = random.choice(CONTROL_COUNTS)
    max_axis_len = GRID_WIDTH_BOUNDS[1] if axis == HORIZONTAL else GRID_HEIGHT_BOUNDS[1]
    gaps = _gen_gaps(count, max_axis_len)
    copy_span = count * SPRITE_SIZE + sum(gaps)
    max_len_for_span = min(max_axis_len, int(copy_span / MIN_COPY_SPAN_FRACTION))
    axis_len = random.randint(copy_span, max_len_for_span)
    if axis == HORIZONTAL:
        height, width = random.randint(*GRID_HEIGHT_BOUNDS), axis_len
    else:
        height, width = axis_len, random.randint(*GRID_WIDTH_BOUNDS)

    mask = _gen_sprite_mask()
    anchor_index = random.randrange(count)
    colors = _gen_control_colors(count, anchor_index)
    starts = _gen_copy_starts(axis_len, copy_span, gaps)

