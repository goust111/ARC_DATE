+    random.shuffle(lane_candidates)
+    lanes: list[int] = []
+    for c in lane_candidates:
+        if all(abs(c - other) >= 2 for other in lanes):
+            lanes.append(c)
+        if len(lanes) == object_count - 3:
+            break
