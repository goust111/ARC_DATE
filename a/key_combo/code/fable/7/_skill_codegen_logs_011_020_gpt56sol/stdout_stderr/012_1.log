+    isolated_shape = [(0, 0), (1, 0)]
+    isolated_final = (height - random.randint(6, 8), isolated_c)
+    isolated_lift = random.randint(2, min(4, isolated_final[0]))
+    isolated_input = (isolated_final[0] - isolated_lift, isolated_c)
