+"""ARC task: recolor a rectangular mosaic by following every color pointer twice."""
+
+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as (N, 2) arrays of (row, column)."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    result: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r, c = int(r), int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        queue = deque([(r, c)])
+        cells: list[Coord] = []
+        while queue:
+            rr, cc = queue.popleft()
+            cells.append((rr, cc))
+            for nr, nc in ((rr - 1, cc), (rr + 1, cc),
+                           (rr, cc - 1), (rr, cc + 1)):
+                if (0 <= nr < h and 0 <= nc < w and mask[nr, nc]
+                        and not seen[nr, nc]):
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+        result.append(np.asarray(cells, dtype=int))
+    return result
+
+
+def _bbox(coords: np.ndarray) -> BBox:
+    """Inclusive bbox using the common ARC (row, column) convention."""
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _read_regions(grid: np.ndarray) -> tuple[dict[int, BBox], dict[int, int]]:
+    """Recover each rectangular region and its single embedded color pointer."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a nonempty 2D grid"
+
+    boxes: dict[int, BBox] = {}
+    for color in map(int, np.unique(g)):
+        comps = _components(g == color)
+        assert comps, "every visible color must have a component"
+        areas = [len(comp) for comp in comps]
+        largest = max(areas)
+        assert areas.count(largest) == 1, "each color needs one unique main region"
+        assert largest > 1, "a region color must occupy more than its pointer copy"
+        boxes[color] = _bbox(comps[areas.index(largest)])
+
+    owner = np.full(g.shape, -1, dtype=int)
+    pointers: dict[int, int] = {}
+    for color, (r0, c0, r1, c1) in boxes.items():
+        assert r1 - r0 + 1 >= 3 and c1 - c0 + 1 >= 3
+        view = g[r0:r1 + 1, c0:c1 + 1]
+        foreign = np.argwhere(view != color)
+        assert len(foreign) == 1, "each region must contain exactly one foreign pixel"
+        fr, fc = map(int, foreign[0])
+        assert 0 < fr < view.shape[0] - 1 and 0 < fc < view.shape[1] - 1, (
+            "the pointer must be isolated in the region interior"
+        )
+        pointer = int(view[fr, fc])
+        assert pointer in boxes and pointer != color, "pointer must name another region"
+        pointers[color] = pointer
+        area = owner[r0:r1 + 1, c0:c1 + 1]
+        assert np.all(area == -1), "region rectangles must not overlap"
+        area[:] = color
+
+    assert np.all(owner != -1), "region rectangles must tile the whole grid"
+    assert set(pointers.values()) == set(boxes), "pointers must form disjoint cycles"
+    return boxes, pointers
+
