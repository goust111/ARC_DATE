+        queue = deque([(sr, sc)])
+        cells: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
