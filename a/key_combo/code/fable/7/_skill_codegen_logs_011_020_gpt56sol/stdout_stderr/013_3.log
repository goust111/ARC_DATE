def _gen_cd3c21df_mask_catalog() -> dict[tuple[int, int, int], list[np.ndarray]]:
    catalog: dict[tuple[int, int, int], list[np.ndarray]] = {}
    for h in range(SPRITE_MIN_HEIGHT, SPRITE_MAX_HEIGHT + 1):
        for w in range(SPRITE_MIN_WIDTH, SPRITE_MAX_WIDTH + 1):
            cells = h * w
            for area in range(SPRITE_MIN_AREA, min(SPRITE_MAX_AREA, cells) + 1):
                key = (h, w, area)
                for flat_coords in combinations(range(cells), area):
                    mask = np.zeros((h, w), dtype=int)
                    for k in flat_coords:
                        mask[k // w, k % w] = 1
                    if bbox(mask.astype(bool)) != (0, 0, h - 1, w - 1):
                        continue
                    if is_contiguous(mask, background=0, connectivity=4):
                        catalog.setdefault(key, []).append(mask.astype(bool))
    return catalog


_GEN_CD3C21DF_MASKS = _gen_cd3c21df_mask_catalog()
_GEN_CD3C21DF_KEYS = list(_GEN_CD3C21DF_MASKS)


def _gen_cd3c21df_choose_mask() -> np.ndarray:
    mode = random.choice(MASK_FILTER_MODES)
    if mode == "height":
        h = random.randint(SPRITE_MIN_HEIGHT, SPRITE_MAX_HEIGHT)
        keys = [key for key in _GEN_CD3C21DF_KEYS if key[0] == h]
    elif mode == "width":
        w = random.randint(SPRITE_MIN_WIDTH, SPRITE_MAX_WIDTH)
        keys = [key for key in _GEN_CD3C21DF_KEYS if key[1] == w]
    elif mode == "area":
        area = random.randint(SPRITE_MIN_AREA, SPRITE_MAX_AREA)
        keys = [key for key in _GEN_CD3C21DF_KEYS if key[2] == area]
    else:
        keys = _GEN_CD3C21DF_KEYS
    key = random.choice(keys)
    return random.choice(_GEN_CD3C21DF_MASKS[key]).copy()


def _gen_cd3c21df_color_sets(palette: list[int]) -> list[tuple[int, ...]]:
    colors = palette[:]
    random.shuffle(colors)
    sets = [{colors[i]} for i in range(BASE_SPRITE_COUNT)]
    for color in colors[BASE_SPRITE_COUNT:]:
        choices = [i for i, s in enumerate(sets) if len(s) < MAX_COLORS_PER_SPRITE]
        sets[random.choice(choices)].add(color)
    for s in sets:
        if len(s) < MAX_COLORS_PER_SPRITE and random.random() < EXTRA_COLOR_PROB:
            choices = [color for color in palette if color not in s]
            if choices:
                s.add(random.choice(choices))
    random.shuffle(sets)
    return [tuple(sorted(s)) for s in sets]


def _gen_cd3c21df_colorize(mask: np.ndarray, colors: tuple[int, ...]) -> np.ndarray:
    sprite = np.zeros(mask.shape, dtype=int)
    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
    cols = list(colors)
    random.shuffle(cols)
    if len(cols) == 1:
        sprite[mask] = cols[0]
        return sprite

    random.shuffle(coords)
    split = random.randint(1, len(coords) - 1)
    first = np.array(coords[:split], dtype=int)
    second = np.array(coords[split:], dtype=int)
    sprite[first[:, 0], first[:, 1]] = cols[0]
    sprite[second[:, 0], second[:, 1]] = cols[1]
    return sprite


def _gen_cd3c21df_signature(sprite: np.ndarray) -> tuple[tuple[int, ...], ...]:
    return tuple(tuple(map(int, row)) for row in sprite)


def _gen_cd3c21df_locations(reserved: np.ndarray, sprite_shape: tuple[int, int]) -> list[tuple[int, int]]:
    h, w = sprite_shape
    H, W = reserved.shape
    locs: list[tuple[int, int]] = []
    for r in range(H - h + 1):
        for c in range(W - w + 1):
            r0 = max(0, r - PLACEMENT_PADDING)
            c0 = max(0, c - PLACEMENT_PADDING)
            r1 = min(H, r + h + PLACEMENT_PADDING)
            c1 = min(W, c + w + PLACEMENT_PADDING)
            if not bool(reserved[r0:r1, c0:c1].any()):
                locs.append((r, c))
    random.shuffle(locs)
    if random.random() < INTERIOR_PLACEMENT_FIRST_PROB:
        locs.sort(key=lambda rc: 0 if 0 < rc[0] and 0 < rc[1] and rc[0] + h < H and rc[1] + w < W else 1)
    return locs


def _gen_cd3c21df_place_sprites(H: int, W: int, sprites: list[np.ndarray]) -> np.ndarray | None:
    reserved = np.zeros((H, W), dtype=int)
    locations: list[tuple[int, int] | None] = [None] * len(sprites)
    order = list(range(len(sprites)))
    random.shuffle(order)
    order.sort(key=lambda i: sprites[i].shape[0] * sprites[i].shape[1], reverse=True)

    def place_at(k: int) -> bool:
        if k == len(order):
            return True
        idx = order[k]
        sprite = sprites[idx]
        h, w = sprite.shape
        for r, c in _gen_cd3c21df_locations(reserved, (h, w)):
            reserved[r : r + h, c : c + w] = 1
            locations[idx] = (r, c)
            if place_at(k + 1):
                return True
            locations[idx] = None
            reserved[r : r + h, c : c + w] = 0
        return False

    if not place_at(0):
        return None

    grid = np.zeros((H, W), dtype=int)
    for sprite, loc in zip(sprites, locations):
        assert loc is not None
        paste(grid, sprite, loc[0], loc[1], transparent=BG_COLOR)
    return grid


def _gen_cd3c21df_make_base_sprites(color_sets: list[tuple[int, ...]]) -> list[np.ndarray] | None:
    base_sprites: list[np.ndarray] = []
    signatures: set[tuple[tuple[int, ...], ...]] = set()
    for colors in color_sets:
        sprite = _gen_cd3c21df_colorize(_gen_cd3c21df_choose_mask(), colors)
        sig = _gen_cd3c21df_signature(sprite)
        if sig in signatures:
            return None
        signatures.add(sig)
        base_sprites.append(sprite)
    return base_sprites


def _gen_cd3c21df_passes_oracle(grid: np.ndarray, singleton: np.ndarray) -> bool:
    try:
        actual = main(grid)
    except Exception:
        return False
    return np.array_equal(actual, singleton)


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(CANVAS_MIN_SIZE, CANVAS_MAX_SIZE)
    W = random.randint(CANVAS_MIN_SIZE, CANVAS_MAX_SIZE)
    palette = random.sample(range(FOREGROUND_COLOR_MIN, FOREGROUND_COLOR_MAX + 1), random.choice(PALETTE_SIZE_CHOICES))
    color_sets = _gen_cd3c21df_color_sets(palette)

    base_sprites = _gen_cd3c21df_make_base_sprites(color_sets)
    if base_sprites is None:
        return None

    sprites = [base_sprites[i] for i in SPRITE_COPY_PATTERN]
    random.shuffle(sprites)

    grid = _gen_cd3c21df_place_sprites(H, W, sprites)
    if grid is None or not _gen_cd3c21df_passes_oracle(grid, base_sprites[SPRITE_COPY_PATTERN[-1]]):
        return None
    return grid


def generate_input() -> np.ndarray:
def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("generate_input failed for cd3c21df")
def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend the edge-touching green start bar through the corridor, turning at each teal blocker until the path leaves the grid.

    Input structure:
    - The background is the most common color.
    - Exactly two foreground colors are present: a 2-pixel 4-connected start bar and many blocker pixels.
    - Exactly one pixel of the start bar lies on the grid border.

    Rule:
    - Start from the border pixel of the bar and move through the other bar pixel into the grid.
    - Paint every traversed non-blocker pixel with the start color.
    - When the next cell is a blocker, turn to the unique perpendicular non-blocker neighbor; when the next cell is outside the grid, stop.

    Key insight: The blocker pixels define a one-cell-wide corridor, so every interior collision has exactly one valid 90-degree turn.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape

    bg = int(get_bg(g))
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 2, "expected a path color and a blocker color"

    counts = {c: int(np.count_nonzero(g == c)) for c in fg_colors}
    path_colors = [c for c, n in counts.items() if n == 2]
    assert len(path_colors) == 1, "expected exactly one 2-pixel start bar"
    path_color = int(path_colors[0])
    blocker_color = int([c for c in fg_colors if c != path_color][0])

    start_pixels = [tuple(map(int, rc)) for rc in np.argwhere(g == path_color)]
    assert len(start_pixels) == 2
    (r0, c0), (r1, c1) = start_pixels
    assert abs(r0 - r1) + abs(c0 - c1) == 1, "start bar must be 4-connected"

    def is_border(pixel: tuple[int, int]) -> bool:
        r, c = pixel
        return r == 0 or r == H - 1 or c == 0 or c == W - 1

    border_pixels = [p for p in start_pixels if is_border(p)]
    assert len(border_pixels) == 1, "exactly one start pixel must touch the border"
    border_pixel = border_pixels[0]
    inner_pixel = start_pixels[1] if start_pixels[0] == border_pixel else start_pixels[0]

    dr = int(inner_pixel[0] - border_pixel[0])
    dc = int(inner_pixel[1] - border_pixel[1])
    assert abs(dr) + abs(dc) == 1

    out = g.copy()
    r, c = inner_pixel
    seen_states: set[tuple[int, int, int, int]] = set()

    while True:
        state = (r, c, dr, dc)
        assert state not in seen_states, "path walk should not cycle"
        seen_states.add(state)

        nr, nc = r + dr, c + dc
        if not in_bounds(g.shape, nr, nc):
            break

        if int(g[nr, nc]) != blocker_color:
            out[nr, nc] = path_color
            r, c = int(nr), int(nc)
            continue

        choices: list[tuple[int, int]] = []
        for tdr, tdc in ((-dc, dr), (dc, -dr)):
            tr, tc = r + tdr, c + tdc
            if in_bounds(g.shape, tr, tc) and int(g[tr, tc]) != blocker_color:
                choices.append((int(tdr), int(tdc)))

        assert len(choices) == 1, "each blocker collision must have one valid turn"
        dr, dc = choices[0]

    return out

# --------------- generator (att1) ---------------

# Fixed palette from the observed task examples.
BG_COLOR, PATH_COLOR, BLOCKER_COLOR = 7, 3, 8

# Canvas and trajectory bounds.
MIN_GRID_SIZE, MAX_GRID_SIZE = 5, 8
MIN_DIM_BASE, MIN_DIM_TURN_DIVISOR = 3, 2
MIN_TURNS, MAX_TURNS = 3, 7
MIN_UNIQUE_PATH, MAX_UNIQUE_PATH = 8, 22

# Segment, blocker, and retry limits.
MAX_SEGMENT_LEN = 5
MIN_FWD_FOR_TURN, MIN_FWD_AFTER_TURN, MIN_FWD_WITH_REMAINING_TURNS = 2, 1, 2
MIN_BLOCKERS, MAX_BLOCKERS = 6, 14
MIN_EXTRA_BLOCKERS, MAX_EXTRA_BLOCKERS = 0, 2
GEN_RETRIES = 300

ENTRY_SIDES = ['top', 'bottom', 'left', 'right']
NEIGHBORS_4 = [(0, 1), (0, -1), (1, 0), (-1, 0)]


def _max_forward(r, c, dr, dc, H, W):
    """Return the number of in-bounds cells before leaving the grid."""
    steps = 0
    while True:
        r, c = r + dr, c + dc
        if r < 0 or r >= H or c < 0 or c >= W:
            return steps
        steps += 1


def _choose_entry_bar(H, W):
    """Choose the border start bar and its inward direction."""
    side = random.choice(ENTRY_SIDES)
    if side == 'top':
        c = random.randint(0, W - 1)
        return (0, c), (1, c), 1, 0
    if side == 'bottom':
        c = random.randint(0, W - 1)
        return (H - 1, c), (H - 2, c), -1, 0
    if side == 'left':
        r = random.randint(0, H - 1)
        return (r, 0), (r, 1), 0, 1
    r = random.randint(0, H - 1)
    return (r, W - 1), (r, W - 2), 0, -1


def _extend_path(grid, path_cells, r, c, dr, dc, seg_len=None, allow_path_color=False):
    """Append a bounded segment, or walk until exit when seg_len is None."""
    H, W = grid.shape
    steps = 0
    while True:
        if seg_len is not None and steps == seg_len:
            return r, c
        nr, nc = r + dr, c + dc
        if nr < 0 or nr >= H or nc < 0 or nc >= W:
            return (r, c) if seg_len is None else None
        if grid[nr, nc] != BG_COLOR and not (allow_path_color and grid[nr, nc] == PATH_COLOR):
            return None
        path_cells.append((nr, nc))
        r, c = nr, nc
        steps += 1


def _place_turn_blockers(grid, path_cells, blocker_cells, r, c, dr, dc, num_turns, seg_i):
    """Place the ahead and wrong-side blockers that force one valid turn."""
    H, W = grid.shape
    ahead_r, ahead_c = r + dr, c + dc
    if grid[ahead_r, ahead_c] != BG_COLOR:
        return None

    perps = [(-dc, dr), (dc, -dr)]
    random.shuffle(perps)
    for chosen_dir in perps:
        other_dir = perps[1] if chosen_dir is perps[0] else perps[0]
        cr, cc = r + chosen_dir[0], c + chosen_dir[1]
        otr, otc = r + other_dir[0], c + other_dir[1]
        c_in = 0 <= cr < H and 0 <= cc < W
        o_in = 0 <= otr < H and 0 <= otc < W

        if not c_in or grid[cr, cc] != BG_COLOR:
            continue

        fwd_room = _max_forward(r, c, chosen_dir[0], chosen_dir[1], H, W)
        if fwd_room < MIN_FWD_AFTER_TURN:
            continue
        remaining_turns = num_turns - seg_i - 1
        if remaining_turns > 0 and fwd_room < MIN_FWD_WITH_REMAINING_TURNS:
            continue

        if o_in:
            if grid[otr, otc] == BG_COLOR:
                if (otr, otc) in path_cells:
                    continue
                grid[otr, otc] = BLOCKER_COLOR
                blocker_cells.append((otr, otc))
            elif grid[otr, otc] != BLOCKER_COLOR:
                continue

        grid[ahead_r, ahead_c] = BLOCKER_COLOR
        blocker_cells.append((ahead_r, ahead_c))
        return chosen_dir
    return None


def _scatter_extra_blockers(grid, path_cells, bar_cells, blocker_cells):
    """Add optional distractor blockers that are not adjacent to the path/start."""
    H, W = grid.shape
    occupied = set(path_cells) | bar_cells
    for _ in range(random.randint(MIN_EXTRA_BLOCKERS, MAX_EXTRA_BLOCKERS)):
        free = [
            (rr, cc) for rr in range(H) for cc in range(W)
            if grid[rr, cc] == BG_COLOR and (rr, cc) not in occupied
            and not any((rr + ddr, cc + ddc) in occupied for ddr, ddc in NEIGHBORS_4)
        ]
        if free:
            cell = random.choice(free)
            grid[cell] = BLOCKER_COLOR
            blocker_cells.append(cell)


def _build_validated_input(grid, path_cells) -> np.ndarray | None:
    """Erase sampled path cells and require the solver to reconstruct them."""
    inp = grid.copy()
    for pr, pc in path_cells:
        inp[pr, pc] = BG_COLOR

    try:
        out = main(inp)
    except Exception:
        return None

    expected = inp.copy()
    for pr, pc in path_cells:
        expected[pr, pc] = PATH_COLOR
    return inp if np.array_equal(out, expected) else None


def _gen_attempt() -> np.ndarray | None:
    num_turns = random.randint(MIN_TURNS, MAX_TURNS)
    min_dim = max(MIN_GRID_SIZE, MIN_DIM_BASE + num_turns // MIN_DIM_TURN_DIVISOR)
    H = random.randint(min_dim, MAX_GRID_SIZE)
    W = random.randint(min_dim, MAX_GRID_SIZE)
    grid = np.full((H, W), BG_COLOR, dtype=int)

    border_pixel, inner_pixel, dr, dc = _choose_entry_bar(H, W)
    grid[border_pixel] = PATH_COLOR
    grid[inner_pixel] = PATH_COLOR

    r, c = inner_pixel
    path_cells = []
    blocker_cells = []

    for seg_i in range(num_turns + 1):
        is_final = (seg_i == num_turns)

        if is_final:
            pos = _extend_path(grid, path_cells, r, c, dr, dc)
            if pos is None:
                return None
            r, c = pos
            break

        max_fwd = _max_forward(r, c, dr, dc, H, W)
        if max_fwd < MIN_FWD_FOR_TURN:
            return None

        max_seg = min(MAX_SEGMENT_LEN, max_fwd - 1)
        seg_len = random.choices(range(1, max_seg + 1), weights=range(1, max_seg + 1))[0]
        pos = _extend_path(grid, path_cells, r, c, dr, dc, seg_len, allow_path_color=True)
        if pos is None:
            return None
        r, c = pos

        chosen_dir = _place_turn_blockers(grid, path_cells, blocker_cells, r, c, dr, dc,
                                          num_turns, seg_i)
        if chosen_dir is None:
            return None
        dr, dc = chosen_dir

    unique_path = len(set(path_cells))
    if not (MIN_UNIQUE_PATH <= unique_path <= MAX_UNIQUE_PATH):
        return None

    _scatter_extra_blockers(grid, path_cells, {border_pixel, inner_pixel}, blocker_cells)
    if not (MIN_BLOCKERS <= len(blocker_cells) <= MAX_BLOCKERS):
        return None

    return _build_validated_input(grid, path_cells)


def generate_input() -> np.ndarray:
def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {GEN_RETRIES} attempts")
def main(grid: np.ndarray) -> np.ndarray:
    """
    Within each horizontal pair of two-color panels, swap the motif masks and recolor each pasted mask with the source panel's base color.

    Input structure:
    - A separator color forms full blank rows and at least one full blank column.
    - The non-separator area is split into row bands, each containing exactly two same-shaped rectangular panels.
    - Each panel has a dominant base color and one minority motif color.

    Rule:
    - For every row band, clear each panel to its own base color.
    - Paste the right panel's motif mask into the left panel using the right base color.
    - Paste the left panel's motif mask into the right panel using the left base color.

    Key insight:
    - The motif colors themselves are distractors; only each motif's shape mask and the two panel base colors are exchanged.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "grid must be 2D"

    sep = _separator_color(g)
    row_bands = _bands(np.where(~np.all(g == sep, axis=1))[0])
    col_bands = _bands(np.where(~np.all(g == sep, axis=0))[0])
    assert len(col_bands) == 2, f"expected exactly two panel columns, got {len(col_bands)}"

    out = g.copy()
    (lc0, lc1), (rc0, rc1) = col_bands
    for r0, r1 in row_bands:
        left = g[r0 : r1 + 1, lc0 : lc1 + 1]
        right = g[r0 : r1 + 1, rc0 : rc1 + 1]
        assert left.shape == right.shape, "paired panels must have the same shape"

        left_base, left_motif = _base_and_motif_mask(left)
        right_base, right_motif = _base_and_motif_mask(right)

        new_left = np.full(left.shape, left_base, dtype=int)
        new_right = np.full(right.shape, right_base, dtype=int)
        new_left[right_motif] = right_base
        new_right[left_motif] = left_base

        out[r0 : r1 + 1, lc0 : lc1 + 1] = new_left
        out[r0 : r1 + 1, rc0 : rc1 + 1] = new_right

    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and separator geometry.
NUM_BANDS_MIN, NUM_BANDS_MAX = 2, 4
PANEL_H_MIN, PANEL_H_MAX = 6, 8
PANEL_W_MIN, PANEL_W_MAX = 7, 8
SEPARATOR_H = 2
SEPARATOR_W_MIN, SEPARATOR_W_MAX = 1, 2
MAX_GRID_SIZE = 30

# Motif size and component growth.
MOTIF_MARGIN = 1
MOTIF_FILL_MIN, MOTIF_FILL_MAX = 0.10, 0.30
MAX_MOTIF_COMPONENTS = 4
COMPONENT_WEIGHTS = (0.68, 0.16, 0.10, 0.06)
PART_MIN_SIZE, PART_WEIGHT_OFFSET = 2, 0.2

# Color sampling and retry limits.
PALETTE = tuple(range(1, 10))
SAME_BASE_PROB = 0.25
GENERATION_RETRIES = 300


def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
    out = []
    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
        rr, cc = r + dr, c + dc
        if MOTIF_MARGIN <= rr < h - MOTIF_MARGIN and MOTIF_MARGIN <= cc < w - MOTIF_MARGIN:
            out.append((rr, cc))
    return out


def _partition(total: int, parts: int) -> list[int]:
    mins = [PART_MIN_SIZE] * parts if total >= PART_MIN_SIZE * parts else [1] * parts
    remaining = total - sum(mins)
    weights = [random.random() + PART_WEIGHT_OFFSET for _ in range(parts)]
    sizes = mins[:]
    for _ in range(remaining):
        i = random.choices(range(parts), weights=weights, k=1)[0]
        sizes[i] += 1
    random.shuffle(sizes)
    return sizes


def _touches_other(label: np.ndarray, r: int, c: int, own: int) -> bool:
    h, w = label.shape
    for rr, cc in _neighbors4(r, c, h, w):
        v = int(label[rr, cc])
        if v not in (0, own):
            return True
    return False


def _grow_mask(h: int, w: int, target: int, n_comp: int) -> np.ndarray | None:
    label = np.zeros((h, w), dtype=int)
    cells = [(r, c) for r in range(MOTIF_MARGIN, h - MOTIF_MARGIN) for c in range(MOTIF_MARGIN, w - MOTIF_MARGIN)]
    random.shuffle(cells)

    seeds: list[tuple[int, int]] = []
    for r, c in cells:
        if all(abs(r - sr) + abs(c - sc) > 1 for sr, sc in seeds):
            seeds.append((r, c))
            if len(seeds) == n_comp:
                break
    if len(seeds) != n_comp:
        return None

    sizes = _partition(target, n_comp)
    comps: list[set[tuple[int, int]]] = []
    for i, (r, c) in enumerate(seeds, start=1):
        label[r, c] = i
        comps.append({(r, c)})

    for i, size in enumerate(sizes, start=1):
        while len(comps[i - 1]) < size:
            frontier = set()
            for rr, cc in comps[i - 1]:
                frontier.update(_neighbors4(rr, cc, h, w))
            choices = [
                cell
                for cell in frontier
                if label[cell] == 0 and not _touches_other(label, cell[0], cell[1], i)
            ]
            if not choices:
                return None
            nr, nc = random.choice(choices)
            label[nr, nc] = i
            comps[i - 1].add((nr, nc))

    return label > 0


def _random_motif_mask(h: int, w: int) -> np.ndarray | None:
    area = h * w
    lo = max(1, int(np.ceil(MOTIF_FILL_MIN * area)))
    hi = min((h - 2 * MOTIF_MARGIN) * (w - 2 * MOTIF_MARGIN), int(np.floor(MOTIF_FILL_MAX * area)))
    if lo > hi:
        return None
    target = random.randint(lo, hi)

    max_comp = min(MAX_MOTIF_COMPONENTS, target)
    n_comp = random.choices(range(1, max_comp + 1), weights=COMPONENT_WEIGHTS[:max_comp], k=1)[0]
    return _grow_mask(h, w, target, n_comp)


def _pair_colors() -> tuple[int, int, int, int]:
    colors = list(PALETTE)
    if random.random() < SAME_BASE_PROB:
        base = random.choice(colors)
        left_motif, right_motif = random.sample([c for c in colors if c != base], 2)
        return base, base, left_motif, right_motif
    left_base, right_base, left_motif, right_motif = random.sample(colors, 4)
    return left_base, right_base, left_motif, right_motif


def _choose_layout() -> tuple[int, int, int, int, int]:
    num_bands = random.randint(NUM_BANDS_MIN, NUM_BANDS_MAX)
    panel_h = random.choice([h for h in range(PANEL_H_MIN, PANEL_H_MAX + 1) if num_bands * h + SEPARATOR_H * (num_bands - 1) <= MAX_GRID_SIZE])
    panel_w = random.randint(PANEL_W_MIN, PANEL_W_MAX)
    sep_w = random.randint(SEPARATOR_W_MIN, SEPARATOR_W_MAX)
    return num_bands, panel_h, panel_w, SEPARATOR_H, sep_w


def _make_pair_panels(panel_h: int, panel_w: int) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray] | None:
    """Build the input and output panels for one paired row band."""
    left_base, right_base, left_motif_color, right_motif_color = _pair_colors()
