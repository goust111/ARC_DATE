_GEN_UPPER_TRIANGLE = [(r, c) for r in range(_GEN_QUADRANT_SIZE) for c in range(r, _GEN_QUADRANT_SIZE)]
_GEN_HOLE_ROW_RANGE = (0, _GEN_GRID_SIZE - _GEN_PATCH_SIZE + 1)  # RNG upper exclusive
