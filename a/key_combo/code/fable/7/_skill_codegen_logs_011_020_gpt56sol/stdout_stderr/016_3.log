+    borders = [s["border"] for s in found]
+    assert len(borders) == len(set(borders)), "sprite border colors must be unique"
+    return found
+
+
+def _contact_index(sprite: dict, path_index: dict[tuple[int, int], int]) -> int | None:
+    touched = set()
