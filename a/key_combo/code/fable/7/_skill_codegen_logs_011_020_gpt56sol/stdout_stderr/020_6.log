+    original = wrong.copy()
+    for r, c in np.argwhere(original == MASK_COLOR):
+        source = int(original[wr0 + wr1 - int(r), int(c)])
+        if source in (BACKGROUND, MASK_COLOR):
+            return None
+        wrong[int(r), int(c)] = source
+    return wrong
+
