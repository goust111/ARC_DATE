+        if source not in (BACKGROUND, MASK_COLOR):
+            direct[int(r), int(c)] = source
+    return direct
+
+
+def _semantically_valid(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    bent_before_masks: np.ndarray,
+    mask_cells: set[tuple[int, int]],
+    cross_count: int,
