+        inp, expected = case
+        signature = hashlib.md5(expected.tobytes() + str(expected.shape).encode()).hexdigest()
+        _SEEN_OUTPUT_SIGNATURES.add(signature)
+        return inp
+    raise RuntimeError("failed to generate a valid straighten-then-complete input")

