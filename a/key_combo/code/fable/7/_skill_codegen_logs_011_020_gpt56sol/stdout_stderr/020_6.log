+
+def _wave_shift(distance_from_bottom: int) -> int:
+    """Forward shift used by the bottom-anchored wave."""
+    if distance_from_bottom % 2 == 0:
+        return 0
+    return -1 if (distance_from_bottom // 2) % 2 == 0 else 1
