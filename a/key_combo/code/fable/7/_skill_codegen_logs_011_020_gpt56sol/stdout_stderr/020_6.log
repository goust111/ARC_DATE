        if obstacle_count >= target_count:
            break
        if row_counts[r] >= _GEN_ROW_OBSTACLE_MAX or grid[r, c] != _GEN_BG or (r, c) in used_path:
            continue
        grid[r, c] = _GEN_OBSTACLE
        row_counts[r] += 1
        obstacle_count += 1

    return obstacle_count == target_count

def _gen_choose_blocked_indices(rng):
    blocked_n = int(rng.choice(_GEN_BLOCKED_PATH_COUNT_CHOICES))
    return set(int(i) for i in rng.choice(_GEN_CONTROL_COUNT, size=blocked_n, replace=False))

def _gen_build_paths(grid, row_counts, starts, blocked_indices, rng):
    """Return non-overlapping paths plus their occupied cells, or None on failure."""
    w = grid.shape[1]
    used_path = set()
    paths = []
    for i, col in enumerate(starts):
        is_blocked = i in blocked_indices
        next_col = starts[i + 1] if i < _GEN_CONTROL_COUNT - 1 else w
        if is_blocked and i < _GEN_CONTROL_COUNT - 1:
            right_limit = next_col - 2
            side_limit = next_col - 1
        else:
            right_limit = next_col - 1
            side_limit = w - 1
        if right_limit < col:
            return None, None
        path = _gen_build_path(grid, row_counts, used_path, col, right_limit, side_limit, is_blocked, rng)
        if path is None:
            return None, None
        paths.append(path)
        used_path.update(path)
    return paths, used_path

def _gen_mark_starts(grid, starts):
    bottom = grid.shape[0] - 1
    if any(grid[bottom, col] != _GEN_BG for col in starts):
        return False
    grid[bottom, list(starts)] = _GEN_RED
    return True

def _gen_obstacle_target(grid, row_counts, rng):
    """Choose a legal total obstacle count after reserving one obstacle for empty rows."""
    h, w = grid.shape
    cell_count = h * w
    min_density, max_density = _GEN_DENSITY_PERCENT_RANGE
    min_count = max(
        _GEN_OBSTACLE_COUNT_MIN,
        (min_density * cell_count + _GEN_PERCENT_DENOMINATOR - 1) // _GEN_PERCENT_DENOMINATOR,
    )
    max_count = min(_GEN_OBSTACLE_COUNT_MAX, (max_density * cell_count) // _GEN_PERCENT_DENOMINATOR)
    row_fill_needed = sum(1 for r in range(h - 1) if row_counts[r] == 0)
    min_count = max(min_count, int(np.count_nonzero(grid == _GEN_OBSTACLE)) + row_fill_needed)
    if min_count > max_count:
        return None
    return int(rng.integers(min_count, max_count + 1))

def _gen_obstacles_are_valid(grid, row_counts):
    h, w = grid.shape
    obstacle_count = int(np.count_nonzero(grid == _GEN_OBSTACLE))
    density = obstacle_count / (h * w)
    min_density, max_density = _GEN_DENSITY_PERCENT_RANGE
    if not (
        _GEN_OBSTACLE_COUNT_MIN <= obstacle_count <= _GEN_OBSTACLE_COUNT_MAX
        and min_density / _GEN_PERCENT_DENOMINATOR <= density <= max_density / _GEN_PERCENT_DENOMINATOR
    ):
        return False
    if any(row_counts[r] < 1 or row_counts[r] > _GEN_ROW_OBSTACLE_MAX for r in range(h - 1)):
        return False
    return row_counts[h - 1] <= _GEN_ROW_OBSTACLE_MAX

def _gen_matches_solver(grid, paths):
    """Render expected red paths and compare them with the public solver."""
    expected = grid.copy()
    for path in paths:
        expected[tuple(zip(*path))] = _GEN_RED
    try:
        actual = main(grid)
    except AssertionError:
        return False
    return np.array_equal(actual, expected)

def _gen_attempt():
    rng = _GEN_RNG
    h = int(rng.integers(*_GEN_HEIGHT_RANGE))
    w = int(rng.integers(*_GEN_WIDTH_RANGE))
    starts = _gen_choose_columns(w, rng)
    grid = np.zeros((h, w), dtype=int)
    row_counts = [0] * h

    blocked_indices = _gen_choose_blocked_indices(rng)
    paths, used_path = _gen_build_paths(grid, row_counts, starts, blocked_indices, rng)
    if paths is None:
        return None

    if not _gen_mark_starts(grid, starts):
        return None

    target_count = _gen_obstacle_target(grid, row_counts, rng)
    if target_count is None:
        return None
    if not _gen_scatter_obstacles(grid, row_counts, used_path, target_count, rng):
        return None
    if not _gen_obstacles_are_valid(grid, row_counts):
        return None

    if not _gen_matches_solver(grid, paths):
        return None
    return grid

def generate_input():
    for _ in range(_GEN_ATTEMPT_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, paste, random_free_location
import random
from functools import lru_cache


def _infer_tile(g: np.ndarray, hole: int) -> np.ndarray:
    height, width = map(int, g.shape)
    candidates: list[tuple[int, int, int, np.ndarray]] = []

    for row_period in range(1, height + 1):
        for col_period in range(1, width + 1):
            tile = np.full((row_period, col_period), -1, dtype=int)
            conflict = False
            for r in range(height):
                if conflict:
                    break
                for c in range(width):
                    color = int(g[r, c])
                    if color == hole:
                        continue
                    tr, tc = r % row_period, c % col_period
                    known = int(tile[tr, tc])
                    if known == -1:
                        tile[tr, tc] = color
                    elif known != color:
                        conflict = True
                        break

            if not conflict and np.all(tile != -1):
                candidates.append((row_period * col_period, row_period, col_period, tile))

    assert candidates, "expected a fully observed periodic tile"
    min_area = min(area for area, _, _, _ in candidates)
    smallest = [candidate for candidate in candidates if candidate[0] == min_area]
    assert len(smallest) == 1, "expected a unique smallest periodic tile"

    _, row_period, col_period, tile = smallest[0]
    assert row_period < height and col_period < width, "expected the tile to repeat across the grid"
    return tile


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete the wallpaper by replacing black holes with the colors from the inferred repeating tile.

    Input structure
    - The input is a two-dimensional grid containing a repeated rectangular color tile.
    - Black pixels are holes in that wallpaper, not part of the tile.
    - Every tile phase is visible at least once in a non-black cell.

    Rule
    - Find the unique smallest row and column period whose non-black cells agree by repeated phase.
    - Reconstruct the full grid by writing the tile color at each cell's phase.

    Key insight
    - The corrupted cells are exactly the black pixels; their colors are determined by the repeated phase shared with non-black copies elsewhere.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
    assert np.any(g == Color.BLACK), "expected black holes to fill"

    tile = _infer_tile(g, Color.BLACK)
    assert np.all(tile != Color.BLACK), "black is reserved for holes"

    height, width = map(int, g.shape)
    out = np.empty_like(g)
    for r in range(height):
        for c in range(width):
            out[r, c] = tile[r % tile.shape[0], c % tile.shape[1]]

    assert np.all((g == Color.BLACK) | (g == out)), "non-black input cells must match the inferred tile"
    return out

# --------------- generator (o5x) ---------------

# Canvas and tile geometry.
GEN_GRID_SIZE = 27
GEN_TILE_SIZE = 8
GEN_TILE_REPEATS = 4
GEN_TILE_INTERIOR_SIZE = GEN_TILE_SIZE - 1

# Tile palette.
GEN_HOLE_COLOR = Color.BLACK
GEN_TILE_BASE_COLOR = Color.BLUE
GEN_NON_BLUE_COLORS = tuple(range(2, 10))
GEN_COLOR_COUNT_MIN = 2
GEN_COLOR_COUNT_MAX = 8

# Hole counts and total masked area.
GEN_REGION_COUNT_MIN = 4
GEN_REGION_COUNT_MAX = 5
GEN_TOTAL_BLACK_MIN = 60
GEN_TOTAL_BLACK_MAX = 84

# Hole shape catalog.
GEN_RECT_SIDE_MIN = 2
GEN_RECT_SIDE_MAX = 6
GEN_L_HEIGHT_MAX = 9
GEN_L_WIDTH_MAX = 8
GEN_HOLE_AREA_MIN = 4
GEN_HOLE_AREA_MAX = 45
GEN_MAX_L_PATCHES = 2
GEN_L_COUNT_WEIGHTS = (0.02, 0.68, 0.30)

# Placement spacing and retry policy.
GEN_PLACEMENT_BORDER = 0
GEN_PLACEMENT_PADDING = 1
GEN_PLACEMENT_PADDING_CONNECTIVITY = 8
GEN_ATTEMPT_LIMIT = 300

@lru_cache(maxsize=None)
def _gen_rect_catalog() -> dict[int, tuple[tuple[int, int], ...]]:
    catalog: dict[int, list[tuple[int, int]]] = {}
    dims = range(GEN_RECT_SIDE_MIN, GEN_RECT_SIDE_MAX + 1)
    for h in dims:
        for w in dims:
            catalog.setdefault(h * w, []).append((h, w))
    return {area: tuple(dims) for area, dims in catalog.items()}


@lru_cache(maxsize=None)
def _gen_l_catalog() -> dict[int, tuple[np.ndarray, ...]]:
    catalog: dict[int, list[np.ndarray]] = {}
    seen: set[tuple[tuple[int, ...], ...]] = set()
    dims = range(GEN_RECT_SIDE_MIN, GEN_RECT_SIDE_MAX + 1)
    for h1 in dims:
        for w1 in dims:
            for h2 in dims:
                for w2 in dims:
                    patches: list[np.ndarray] = []
                    if w1 != w2 and h1 + h2 <= GEN_L_HEIGHT_MAX and max(w1, w2) <= GEN_L_WIDTH_MAX:
                        height, width = h1 + h2, max(w1, w2)
                        for c2 in (0, width - w2):
                            patch = np.zeros((height, width), dtype=int)
                            patch[:h1, :w1] = 1
                            patch[h1:, c2 : c2 + w2] = 1
                            patches.append(patch)
                    if h1 != h2 and max(h1, h2) <= GEN_L_HEIGHT_MAX and w1 + w2 <= GEN_L_WIDTH_MAX:
                        height, width = max(h1, h2), w1 + w2
                        for r2 in (0, height - h2):
                            patch = np.zeros((height, width), dtype=int)
                            patch[:h1, :w1] = 1
                            patch[r2 : r2 + h2, w1:] = 1
                            patches.append(patch)

                    for patch in patches:
                        area = int(patch.sum())
                        if not (GEN_HOLE_AREA_MIN <= area <= GEN_HOLE_AREA_MAX and area < patch.size):
                            continue
                        for variant in (
                            patch,
                            np.flipud(patch),
                            np.fliplr(patch),
                            np.flipud(np.fliplr(patch)),
                        ):
                            key = tuple(tuple(map(int, row)) for row in variant)
                            if key in seen:
                                continue
                            seen.add(key)
                            catalog.setdefault(area, []).append(variant.copy())
    return {area: tuple(patches) for area, patches in catalog.items()}


@lru_cache(maxsize=None)
def _gen_rect_area_sums(count: int) -> frozenset[int]:
    if count == 0:
        return frozenset({0})
    areas = tuple(_gen_rect_catalog())
    return frozenset(area + rest for area in areas for rest in _gen_rect_area_sums(count - 1))


@lru_cache(maxsize=None)
def _gen_mixed_area_sums(l_count: int, rect_count: int) -> frozenset[int]:
    if l_count == 0:
        return _gen_rect_area_sums(rect_count)
    l_areas = tuple(_gen_l_catalog())
    return frozenset(
        area + rest
        for area in l_areas
        for rest in _gen_mixed_area_sums(l_count - 1, rect_count)
    )


def _gen_rect_patches(count: int, total: int) -> list[np.ndarray] | None:
    rects = _gen_rect_catalog()
    areas = tuple(rects)
    patches: list[np.ndarray] = []
    remaining = int(total)
    for left in range(int(count), 0, -1):
        feasible = [area for area in areas if remaining - area in _gen_rect_area_sums(left - 1)]
        if not feasible:
            return None
        area = random.choice(feasible)
        h, w = random.choice(rects[area])
        patches.append(np.ones((h, w), dtype=int))
        remaining -= area
    return patches if remaining == 0 else None


def _gen_shuffle_largest_first(patches: list[np.ndarray]) -> list[np.ndarray]:
    random.shuffle(patches)
    return sorted(patches, key=lambda patch: int(patch.sum()), reverse=True)


def _gen_hole_patches(count: int, total: int) -> list[np.ndarray] | None:
    l_shapes = _gen_l_catalog()
    max_l = min(GEN_MAX_L_PATCHES, count - 1)
    l_options = list(range(max_l + 1))
    weights = list(GEN_L_COUNT_WEIGHTS[: len(l_options)])
    preferred_l = random.choices(l_options, weights=weights, k=1)[0]
    l_options.remove(preferred_l)
    random.shuffle(l_options)
    l_options.insert(0, preferred_l)

    for l_count in l_options:
        rect_count = count - l_count
        if total not in _gen_mixed_area_sums(l_count, rect_count):
            continue
        patches: list[np.ndarray] = []
        remaining = int(total)
        for left_l in range(l_count, 0, -1):
            feasible_l_areas = [
                area
                for area in l_shapes
                if remaining - area in _gen_mixed_area_sums(left_l - 1, rect_count)
            ]
            if not feasible_l_areas:
                patches = []
                break
            area = random.choice(feasible_l_areas)
            patches.append(random.choice(l_shapes[area]).copy())
            remaining -= area
        if l_count and not patches:
            continue
        rects = _gen_rect_patches(rect_count, remaining)
        if rects is None:
            continue
        patches.extend(rects)
        return _gen_shuffle_largest_first(patches)

    patches = _gen_rect_patches(count, total)
    if patches is None:
        return None
    return _gen_shuffle_largest_first(patches)


def _gen_tile() -> np.ndarray:
    color_count = random.randint(GEN_COLOR_COUNT_MIN, GEN_COLOR_COUNT_MAX)
    colors = [GEN_TILE_BASE_COLOR] + random.sample(list(GEN_NON_BLUE_COLORS), color_count - 1)
    non_blue = colors[1:]

    tile = np.full((GEN_TILE_SIZE, GEN_TILE_SIZE), GEN_TILE_BASE_COLOR, dtype=int)
    tile[:GEN_TILE_INTERIOR_SIZE, :GEN_TILE_INTERIOR_SIZE] = np.array(
        random.choices(colors, k=GEN_TILE_INTERIOR_SIZE * GEN_TILE_INTERIOR_SIZE),
        dtype=int,
    ).reshape(GEN_TILE_INTERIOR_SIZE, GEN_TILE_INTERIOR_SIZE)

    for r in range(GEN_TILE_INTERIOR_SIZE):
        tile[r, random.randrange(GEN_TILE_INTERIOR_SIZE)] = random.choice(non_blue)
    for c in range(GEN_TILE_INTERIOR_SIZE):
        tile[random.randrange(GEN_TILE_INTERIOR_SIZE), c] = random.choice(non_blue)

    interior = [(r, c) for r in range(GEN_TILE_INTERIOR_SIZE) for c in range(GEN_TILE_INTERIOR_SIZE)]
    random.shuffle(interior)
    for color, (r, c) in zip(non_blue, interior):
        tile[r, c] = color

    tile[GEN_TILE_INTERIOR_SIZE, :] = GEN_TILE_BASE_COLOR
    tile[:, GEN_TILE_INTERIOR_SIZE] = GEN_TILE_BASE_COLOR
    return tile


def _gen_phases_visible(hole_mask: np.ndarray) -> bool:
    visible = np.zeros((GEN_TILE_SIZE, GEN_TILE_SIZE), dtype=bool)
    rows, cols = np.where(~hole_mask)
    visible[rows % GEN_TILE_SIZE, cols % GEN_TILE_SIZE] = True
    return bool(visible.all())


def _gen_place_holes(patches: list[np.ndarray]) -> np.ndarray | None:
    canvas = np.zeros((GEN_GRID_SIZE, GEN_GRID_SIZE), dtype=int)
    for patch in patches:
        try:
            r, c = random_free_location(
                canvas,
                patch,
                transparent=GEN_HOLE_COLOR,
                border=GEN_PLACEMENT_BORDER,
                padding=GEN_PLACEMENT_PADDING,
                padding_connectivity=GEN_PLACEMENT_PADDING_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(canvas, patch, r, c, transparent=GEN_HOLE_COLOR)
    return canvas.astype(bool)


def _gen_attempt() -> np.ndarray | None:
    tile = _gen_tile()
    output = np.tile(tile, (GEN_TILE_REPEATS, GEN_TILE_REPEATS))[:GEN_GRID_SIZE, :GEN_GRID_SIZE]

    region_count = random.randint(GEN_REGION_COUNT_MIN, GEN_REGION_COUNT_MAX)
    total_black = random.randint(GEN_TOTAL_BLACK_MIN, GEN_TOTAL_BLACK_MAX)
    patches = _gen_hole_patches(region_count, total_black)
    if patches is None:
        return None

    hole_mask = _gen_place_holes(patches)
    if hole_mask is None:
        return None
    if int(hole_mask.sum()) != total_black:
        return None
    if not _gen_phases_visible(hole_mask):
        return None

    inp = output.copy()
    inp[hole_mask] = GEN_HOLE_COLOR
    try:
        if not np.array_equal(main(inp), output):
            return None
    except AssertionError:
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPT_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid c663677b input")
from __future__ import annotations

import numpy as np

from arc_utils import get_bg
import random


def _canonicalize(g: np.ndarray, bg: int) -> tuple[np.ndarray, bool]:
    coords = np.argwhere(g != bg)
    assert len(coords) > 0, "expected a non-background diagonal pattern"

    diag_offsets = coords[:, 1] - coords[:, 0]
    anti_offsets = coords[:, 1] + coords[:, 0]
    diag_span = int(diag_offsets.max() - diag_offsets.min())
    anti_span = int(anti_offsets.max() - anti_offsets.min())
    assert diag_span != anti_span, "expected one structurally dominant diagonal direction"

    if diag_span < anti_span:
        return g, False
    return np.fliplr(g), True


def _learn_period(
    g: np.ndarray,
    bg: int,
    min_offset: int,
    max_offset: int,
) -> tuple[int, dict[tuple[int, int], int]]:
    height, width = map(int, g.shape)
    observations: list[tuple[int, int, int]] = []
    for row in range(height):
        for offset in range(min_offset, max_offset + 1):
            col = row + offset
            if 0 <= col < width:
                observations.append((row, offset, int(g[row, col])))

    assert observations, "expected observable diagonal-band cells"
    for period in range(1, height + 1):
        by_phase: dict[tuple[int, int], int] = {}
        ok = True
        for row, offset, color in observations:
            key = (offset, row % period)
            if key in by_phase and by_phase[key] != color:
                ok = False
                break
            by_phase[key] = color
        if ok:
            return period, by_phase

    raise AssertionError("expected a consistent row-periodic diagonal pattern")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extend the input's diagonal color band onto a canvas with doubled height and width.

    Input structure:
    - The background is the dominant color.
    - Foreground cells form a narrow row-periodic band along one diagonal direction.
    - If the band slopes up-right/down-left, a horizontal flip makes it a down-right band in the top-left quadrant.

    Rule:
    - Canonicalize the band so the input is the top-left quadrant of the larger pattern.
    - Learn the occupied diagonal offsets and the smallest row period of colors, including background gaps within the band.
    - Paint the same offset/period rule onto a 2H x 2W background canvas, then undo the horizontal flip if needed.

    Key insight:
    The input is a corner crop of a larger periodic diagonal pattern, not a pixel-scaled image.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)
    assert height > 0 and width > 0, "expected a nonempty grid"

    bg = int(get_bg(g))
    canonical, flipped = _canonicalize(g, bg)
    coords = np.argwhere(canonical != bg)
    offsets = coords[:, 1] - coords[:, 0]
    min_offset = int(offsets.min())
    max_offset = int(offsets.max())

    period, pattern = _learn_period(canonical, bg, min_offset, max_offset)

    out = np.full((2 * height, 2 * width), bg, dtype=int)
    for row in range(2 * height):
        for offset in range(min_offset, max_offset + 1):
            col = row + offset
            if 0 <= col < 2 * width:
                key = (offset, row % period)
                assert key in pattern, "period must define every output band phase"
                color = pattern[key]
                if color != bg:
                    out[row, col] = color

    assert np.array_equal(out[:height, :width], canonical), "learned pattern must reproduce the input crop"
    if flipped:
        out = np.fliplr(out)
    return out

# --------------- generator (o5x) ---------------

# Color palette.
_GEN_BG = 0
_GEN_FG_COLORS = tuple(range(1, 10))

# Canvas and structural bounds.
_GEN_SIZE_RANGE = (5, 12)
_GEN_PERIOD_RANGE = (2, 4)
_GEN_MIN_SIZE_PER_PERIOD = 2
_GEN_BAND_WIDTHS = (1, 3)
_GEN_BAND_OFFSETS = {1: (0,), 3: (-1, 0, 1)}

# Tile color and gap rules.
_GEN_MIN_COLOR_COUNT = 2
_GEN_MAX_COLOR_COUNT = 4
_GEN_MAX_BG_GAPS = 2
_GEN_PERIOD4_TWO_COLOR_ROW_INDICES = (0, 0, 1, 0)

# Rejection sampling.
_GEN_RETRY_LIMIT = 300


def _gen_exact_period(tile: np.ndarray) -> bool:
    period = int(tile.shape[0])
    for smaller in range(1, period):
        if np.array_equal(tile, np.roll(tile, -smaller, axis=0)):
            return False
    return True


def _gen_row_color_indices(period: int, color_count: int) -> list[int]:
    if period == 4 and color_count == 2:
        return list(_GEN_PERIOD4_TWO_COLOR_ROW_INDICES)
    indices = list(range(min(period, color_count)))
    while len(indices) < period:
        indices.append(random.randrange(color_count))
    return indices


def _gen_unprotected_cells(tile: np.ndarray, protected: set[tuple[int, int]]) -> list[tuple[int, int]]:
    period, band_width = map(int, tile.shape)
    return [
        (row, col)
        for row in range(period)
        for col in range(band_width)
        if (row, col) not in protected
    ]


def _gen_make_tile(period: int, band_width: int, colors: list[int]) -> np.ndarray:
    tile = np.empty((period, band_width), dtype=int)
    for row in range(period):
        for col in range(band_width):
            tile[row, col] = random.choice(colors)

    protected: set[tuple[int, int]] = set()
    for row, color_index in enumerate(_gen_row_color_indices(period, len(colors))):
        tile[row, 0] = colors[color_index]
        protected.add((row, 0))

    for col in range(1, band_width):
        row = random.randrange(period)
        tile[row, col] = random.choice(colors)
        protected.add((row, col))

    present = set(int(x) for x in tile.ravel())
    for color in colors:
        if color in present:
            continue
        choices = _gen_unprotected_cells(tile, protected)
        if not choices:
            break
        row, col = random.choice(choices)
        tile[row, col] = color
        protected.add((row, col))
        present.add(color)

    gap_choices = _gen_unprotected_cells(tile, protected)
    random.shuffle(gap_choices)
    gap_count = random.randint(0, min(_GEN_MAX_BG_GAPS, len(gap_choices)))
    for row, col in gap_choices[:gap_count]:
        tile[row, col] = _GEN_BG

    if set(colors) - set(int(x) for x in tile.ravel()):
        raise ValueError("tile lost a required color")
    if any(np.all(tile[:, col] == _GEN_BG) for col in range(band_width)):
        raise ValueError("tile lost a band offset")
    if not _gen_exact_period(tile):
        raise ValueError("tile period collapsed")
    return tile


def _gen_paint_output(size: int, tile: np.ndarray) -> np.ndarray:
    out = np.full((2 * size, 2 * size), _GEN_BG, dtype=int)
    band_width = int(tile.shape[1])
    offsets = _GEN_BAND_OFFSETS[band_width]
    period = int(tile.shape[0])
    for row in range(2 * size):
        for tile_col, offset in enumerate(offsets):
            col = row + offset
            if 0 <= col < 2 * size:
                color = int(tile[row % period, tile_col])
                if color != _GEN_BG:
                    out[row, col] = color
    return out


def _gen_sample_design() -> tuple[int, int, int, list[int]]:
    size = random.randint(*_GEN_SIZE_RANGE)
    min_period, max_period = _GEN_PERIOD_RANGE
    valid_periods = [
        period
        for period in range(min_period, max_period + 1)
        if size >= _GEN_MIN_SIZE_PER_PERIOD * period
    ]
    period = random.choice(valid_periods)
    band_width = random.choice(_GEN_BAND_WIDTHS)
    max_colors = min(_GEN_MAX_COLOR_COUNT, period * band_width)
    color_count = random.randint(_GEN_MIN_COLOR_COUNT, max_colors)
    colors = random.sample(_GEN_FG_COLORS, color_count)
    return size, period, band_width, colors


def _gen_crop_for_direction(canonical_out: np.ndarray, size: int) -> tuple[np.ndarray, np.ndarray]:
    flipped = random.choice([False, True])
    if flipped:
        return np.fliplr(canonical_out[:size, :size]).copy(), np.fliplr(canonical_out)
    return canonical_out[:size, :size].copy(), canonical_out


def _gen_attempt() -> np.ndarray | None:
    size, period, band_width, colors = _gen_sample_design()

    try:
        tile = _gen_make_tile(period, band_width, colors)
    except ValueError:
        return None

    canonical_out = _gen_paint_output(size, tile)
    inp, expected = _gen_crop_for_direction(canonical_out, size)

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {_GEN_RETRY_LIMIT} attempts")

