+
+
+BACKGROUND = 0
+MARKER = 8
+BODY_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+MAX_GENERATION_ATTEMPTS = 500
+
+BBox = tuple[int, int, int, int]
+Line = tuple[str, int]  # ("h", row) or ("v", column)
