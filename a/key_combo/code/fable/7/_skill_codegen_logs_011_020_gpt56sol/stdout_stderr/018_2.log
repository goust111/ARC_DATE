+def _semantic_candidate(maze: np.ndarray, seeds: list[tuple[int, int]]) -> bool:
+    """Reject easy cases that do not demonstrate every stated mechanism."""
+    passable = maze != WALL
+    distances = np.stack([_bfs_dist(passable, p) for p in seeds])
+    floor = maze == FLOOR
