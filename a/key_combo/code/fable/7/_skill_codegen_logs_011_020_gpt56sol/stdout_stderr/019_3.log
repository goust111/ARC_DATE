    (0, 1), (1, -1), (1, 0), (1, 1),
)

# Rejection sampling.
_GEN_ATTEMPT_LIMIT = 300
_GEN_LAST_META: dict[str, int | float] = {}


def _gen_dihedral_arrays(arr: np.ndarray) -> list[np.ndarray]:
    variants = [
        arr,
        np.fliplr(arr),
        np.flipud(arr),
        np.flipud(np.fliplr(arr)),
        arr.T,
        np.fliplr(arr.T),
        np.flipud(arr.T),
        np.flipud(np.fliplr(arr.T)),
    ]
    out: list[np.ndarray] = []
    seen: set[tuple[int, ...]] = set()
    for variant in variants:
        key = tuple(map(int, variant.ravel()))
        if key not in seen:
            seen.add(key)
            out.append(np.array(variant, dtype=int, copy=True))
    return out


def _gen_cells(arr: np.ndarray, color: int) -> list[tuple[int, int]]:
    return [tuple(map(int, rc)) for rc in np.argwhere(arr == int(color))]


def _gen_yellow_bbox_full(mask: np.ndarray) -> bool:
    return bbox(mask) == (0, 0, _GEN_TEMPLATE_SIDE - 1, _GEN_TEMPLATE_SIDE - 1)


def _gen_template_pool(pink_count: int) -> list[np.ndarray]:
    templates: list[np.ndarray] = []
    for pink_flat in itertools.combinations(range(_GEN_TEMPLATE_AREA), pink_count):
        arr = np.full((_GEN_TEMPLATE_SIDE, _GEN_TEMPLATE_SIDE), _GEN_YELLOW, dtype=int)
        for idx in pink_flat:
            arr[idx // _GEN_TEMPLATE_SIDE, idx % _GEN_TEMPLATE_SIDE] = _GEN_PINK
        if not _gen_yellow_bbox_full(arr == _GEN_YELLOW):
            continue
        if len(_gen_dihedral_arrays(arr)) < _GEN_MIN_VARIANT_COUNT:
            continue
        templates.append(arr)
    return templates


def _gen_random_template(pink_count: int) -> np.ndarray:
    return random.choice(_gen_template_pool(pink_count)).copy()


def _gen_sample_parameters() -> tuple[int, int, int, int, int]:
    H = random.randint(*_GEN_ROW_BOUNDS)
    W = random.randint(*_GEN_COL_BOUNDS)
    options: list[tuple[int, int, int]] = []
    for pink_count in range(_GEN_PINK_COUNT_BOUNDS[0], _GEN_PINK_COUNT_BOUNDS[1] + 1):
        for copy_count in range(_GEN_COPY_COUNT_BOUNDS[0], _GEN_COPY_COUNT_BOUNDS[1] + 1):
            fixed_pink = pink_count * (1 + copy_count)
            lo = max(
                _GEN_DISTRACTOR_COUNT_BOUNDS[0],
                math.ceil(_GEN_PINK_DENSITY_BOUNDS[0] * H * W - fixed_pink),
            )
            hi = min(
                _GEN_DISTRACTOR_COUNT_BOUNDS[1],
                math.floor(_GEN_PINK_DENSITY_BOUNDS[1] * H * W - fixed_pink),
            )
            for distractor_count in range(lo, hi + 1):
                options.append((pink_count, copy_count, distractor_count))
    pink_count, copy_count, distractor_count = random.choice(options)
    return H, W, pink_count, copy_count, distractor_count


def _gen_stamp_full(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
    paste(dst, patch, top, left, clip=True)


def _gen_stamp_pink_only(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
    paste(dst, patch, top, left, mask=(patch == _GEN_PINK), clip=True)


def _gen_copy_placements(inp: np.ndarray, out: np.ndarray, patch: np.ndarray) -> list[tuple[int, int]]:
    H, W = inp.shape
    pink_cells = _gen_cells(patch, _GEN_PINK)
    yellow_cells = _gen_cells(patch, _GEN_YELLOW)
    min_pr = min(r for r, _c in pink_cells)
    max_pr = max(r for r, _c in pink_cells)
    min_pc = min(c for _r, c in pink_cells)
    max_pc = max(c for _r, c in pink_cells)
    placements: list[tuple[int, int]] = []

    for top in range(-min_pr, H - max_pr):
        for left in range(-min_pc, W - max_pc):
            visible_yellow = 0
            ok = True
            for r, c in pink_cells:
                rr = top + r
                cc = left + c
                if int(out[rr, cc]) in _GEN_OCCUPIED_COLORS:
                    ok = False
                    break
            if not ok:
                continue

            for r, c in yellow_cells:
                rr = top + r
                cc = left + c
                if not (0 <= rr < H and 0 <= cc < W):
                    continue
                visible_yellow += 1
                if int(out[rr, cc]) in _GEN_OCCUPIED_COLORS:
                    ok = False
                    break
            if ok and visible_yellow:
                placements.append((top, left))
    random.shuffle(placements)
    return placements


def _gen_cluster_cells(
    available: set[tuple[int, int]], seed: tuple[int, int], target_size: int
) -> list[tuple[int, int]]:
    cluster = [seed]
    used = {seed}
    while len(cluster) < target_size:
        frontier: set[tuple[int, int]] = set()
        for r, c in cluster:
            for dr, dc in _GEN_CLUSTER_NEIGHBOR_OFFSETS:
                nxt = (r + dr, c + dc)
                if nxt in available and nxt not in used:
                    frontier.add(nxt)
        if not frontier:
            break
        chosen = random.choice(tuple(frontier))
        used.add(chosen)
        cluster.append(chosen)
    return cluster


def _gen_scatter_distractors(inp: np.ndarray, out: np.ndarray, count: int) -> bool:
    H, W = inp.shape
    available = {
        (r, c)
        for r in range(H)
        for c in range(W)
        if int(inp[r, c]) not in _GEN_OCCUPIED_COLORS
        and int(out[r, c]) not in _GEN_OCCUPIED_COLORS
    }
    remaining = count
    while remaining:
        if not available:
            return False
        seed = random.choice(tuple(available))
        max_cluster = min(_GEN_DISTRACTOR_CLUSTER_BOUNDS[1], remaining)
        want = random.randint(_GEN_DISTRACTOR_CLUSTER_BOUNDS[0], max_cluster)
        cluster = _gen_cluster_cells(available, seed, want)
        if not cluster:
            return False
        for r, c in cluster:
            inp[r, c] = _GEN_PINK
            out[r, c] = _GEN_PINK
            available.remove((r, c))
        remaining -= len(cluster)
    return True


def _gen_make_canvas_pair(H: int, W: int) -> tuple[np.ndarray, np.ndarray]:
    inp = np.random.choice(_GEN_NOISE, size=(H, W)).astype(int)
    return inp, inp.copy()


def _gen_place_complete_template(inp: np.ndarray, out: np.ndarray, template: np.ndarray) -> None:
    H, W = inp.shape
    max_top = H - _GEN_TEMPLATE_SIDE - _GEN_COMPLETE_EDGE_MARGIN
    max_left = W - _GEN_TEMPLATE_SIDE - _GEN_COMPLETE_EDGE_MARGIN
    complete_top = random.randint(_GEN_COMPLETE_EDGE_MARGIN, max_top)
    complete_left = random.randint(_GEN_COMPLETE_EDGE_MARGIN, max_left)
    _gen_stamp_full(inp, template, complete_top, complete_left)
    _gen_stamp_full(out, template, complete_top, complete_left)


def _gen_place_incomplete_copies(
    inp: np.ndarray, out: np.ndarray, variants: list[np.ndarray], copy_count: int
) -> bool:
    for _ in range(copy_count):
        patch = random.choice(variants)
        placements = _gen_copy_placements(inp, out, patch)
        if not placements:
            return False
        top, left = placements[0]
        _gen_stamp_full(out, patch, top, left)
        _gen_stamp_pink_only(inp, patch, top, left)
    return True


def _gen_matches_solver(inp: np.ndarray, out: np.ndarray) -> bool:
    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, out)


def _gen_record_meta(
    inp: np.ndarray,
    H: int,
    W: int,
    pink_count: int,
    copy_count: int,
    distractor_count: int,
    variant_count: int,
) -> None:
    global _GEN_LAST_META
    _GEN_LAST_META = {
        "rows": H,
        "cols": W,
        "pink_cells": pink_count,
        "yellow_cells": _GEN_TEMPLATE_AREA - pink_count,
        "copy_count": copy_count,
        "distractor_count": distractor_count,
        "variant_count": variant_count,
        "pink_density": float(np.count_nonzero(inp == _GEN_PINK) / inp.size),
    }


def _gen_attempt() -> np.ndarray | None:
    H, W, pink_count, copy_count, distractor_count = _gen_sample_parameters()
    inp, out = _gen_make_canvas_pair(H, W)

    template = _gen_random_template(pink_count)
    _gen_place_complete_template(inp, out, template)

    variants = _gen_dihedral_arrays(template)
    if not _gen_place_incomplete_copies(inp, out, variants, copy_count):
        return None
    if not _gen_scatter_distractors(inp, out, distractor_count):
        return None
    if not _gen_matches_solver(inp, out):
        return None

    _gen_record_meta(inp, H, W, pink_count, copy_count, distractor_count, len(variants))
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_ATTEMPT_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 79369cc6 input")
from __future__ import annotations
import numpy as np
from arc_utils import colors_present, crop_bbox, find_components, get_bg, paste, random_free_location
from arc_utils import find_components, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.

    Input structure:
    - bg = background color.
    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).

    Rule:
    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).

    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # Find multicolor connected components of the foreground as a whole.
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (len(comps) != 2)

    infos = []
    for comp in comps:
        patch = crop_bbox(g, comp["bbox"])
        cols = colors_present(patch, exclude={bg})
        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})

    # Building block is the component with >=2 colors (or more unique colors), preferring square.
    infos.sort(
        key=lambda d: (
            len(d["cols"]) >= 2,
            len(d["cols"]),
            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
        ),
        reverse=True,
    )
    block = infos[0]["patch"]
    ctrl = infos[1]["patch"]

    bh, bw = map(int, block.shape)
    ch, cw = map(int, ctrl.shape)

    ctrl_cols = colors_present(ctrl, exclude={bg})
    if not ctrl_cols:
        return np.full((0, 0), int(bg), dtype=int)

    ctrl_col = int(ctrl_cols[0])
    mask = (ctrl == int(ctrl_col))

    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if bool(mask[r, c]):
                paste(out, block, r * bh, c * bw)
    return out

# --------------- generator (Codex#3) ---------------

def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
    seen: set[tuple[int, int]] = set()
    out: list[tuple[list[tuple[int, int]], bool]] = []
    s = int(size)
    for r in range(s):
        for c in range(s):
            if (r, c) in seen:
                continue
            orbit = {
                (r, c),
                (c, s - 1 - r),
                (s - 1 - r, s - 1 - c),
                (s - 1 - c, r),
                (r, s - 1 - c),
                (s - 1 - r, c),
                (c, r),
                (s - 1 - c, s - 1 - r),
            }
            cells = sorted(orbit)
            seen.update(cells)
            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
            out.append((cells, border))
    return out


def _make_tile(bg: int, fg_colors: list[int], rng: np.random.Generator) -> np.ndarray:
    size = int(rng.integers(3, 6))
    n_tile_colors = int(rng.integers(2, 4))
    tile_colors = list(rng.choice(fg_colors, size=n_tile_colors, replace=False))
    orbits = _dihedral_orbits(size)
    rng.shuffle(orbits)

    tile = np.full((size, size), int(bg), dtype=int)
    assignments: dict[int, int] = {}
    for i, color in enumerate(tile_colors):
        assignments[i] = int(color)

    interior_idxs = [i for i, (_cells, border) in enumerate(orbits) if not border and i not in assignments]
    if interior_idxs and rng.random() < 0.25:
        assignments[int(rng.choice(interior_idxs))] = int(bg)

    for i, (_cells, border) in enumerate(orbits):
        if i not in assignments:
            palette = tile_colors if border else tile_colors + ([bg] if interior_idxs else [])
            assignments[i] = int(rng.choice(palette))

    for i, (cells, _border) in enumerate(orbits):
        for r, c in cells:
            tile[r, c] = assignments[i]
    return tile


def _neighbors8(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            rr = r + dr
            cc = c + dc
            if 0 <= rr < h and 0 <= cc < w:
                out.append((rr, cc))
    return out


def _make_ctrl(bg: int, color: int, rng: np.random.Generator) -> np.ndarray:
    h = int(rng.integers(3, 6))
    w = int(rng.integers(3, 6))
    area = h * w
    min_fill = (area + 1) // 2
    max_fill = int(np.floor(0.72 * area))
    target = int(rng.integers(min_fill, max_fill + 1))

    ar = int(rng.integers(0, h))
    ac = int(rng.integers(0, w))
    mask = np.zeros((h, w), dtype=bool)
    mask[:, ac] = True
    mask[ar, :] = True

    while int(mask.sum()) < target:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if any(mask[rr, cc] for rr, cc in _neighbors8(h, w, r, c)):
                    frontier.append((r, c))
        pick = frontier[int(rng.integers(len(frontier)))]
        mask[pick] = True

    ctrl = np.full((h, w), int(bg), dtype=int)
    ctrl[mask] = int(color)
    return ctrl


def _compose_output(tile: np.ndarray, ctrl: np.ndarray, bg: int) -> np.ndarray:
    th, tw = tile.shape
    ch, cw = ctrl.shape
    out = np.full((ch * th, cw * tw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if ctrl[r, c] != bg:
                paste(out, tile, r * th, c * tw)
    return out


def _make_input(tile: np.ndarray, ctrl: np.ndarray, bg: int, rng: np.random.Generator) -> np.ndarray:
    horizontal = bool(rng.integers(0, 2))
    gap = 1

    if horizontal:
        if rng.random() < 0.5:
            left_obj, right_obj = tile, ctrl
        else:
            left_obj, right_obj = ctrl, tile
        lh, lw = left_obj.shape
        rh, rw = right_obj.shape
        H = int(rng.integers(max(10, max(lh, rh)), 19))
        W = int(rng.integers(max(10, lw + rw + gap), 19))
        slack = W - (lw + rw + gap)
        c_left = int(rng.integers(0, slack + 1))
        c_right = int(rng.integers(c_left + lw + gap, W - rw + 1))
        r_left = int(rng.integers(0, H - lh + 1))
        r_right = int(rng.integers(0, H - rh + 1))
        if left_obj is tile:
            tile_pos = (r_left, c_left)
            ctrl_pos = (r_right, c_right)
        else:
            ctrl_pos = (r_left, c_left)
            tile_pos = (r_right, c_right)
    else:
        if rng.random() < 0.5:
            top_obj, bot_obj = tile, ctrl
        else:
            top_obj, bot_obj = ctrl, tile
        th, tw = top_obj.shape
        bh, bw = bot_obj.shape
        H = int(rng.integers(max(10, th + bh + gap), 19))
        W = int(rng.integers(max(10, max(tw, bw)), 19))
        slack = H - (th + bh + gap)
        r_top = int(rng.integers(0, slack + 1))
        r_bot = int(rng.integers(r_top + th + gap, H - bh + 1))
        c_top = int(rng.integers(0, W - tw + 1))
        c_bot = int(rng.integers(0, W - bw + 1))
        if top_obj is tile:
            tile_pos = (r_top, c_top)
            ctrl_pos = (r_bot, c_bot)
        else:
            ctrl_pos = (r_top, c_top)
            tile_pos = (r_bot, c_bot)

    grid = np.full((H, W), int(bg), dtype=int)
    paste(grid, tile, *tile_pos)
    paste(grid, ctrl, *ctrl_pos, transparent=bg)
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    palette = list(rng.choice(np.arange(10, dtype=int), size=5, replace=False))
    bg = int(palette[0])
    fg = [int(x) for x in palette[1:]]

    tile = _make_tile(bg, fg, rng)
    ctrl = _make_ctrl(bg, fg[-1], rng)
    inp = _make_input(tile, ctrl, bg, rng)
    expected = _compose_output(tile, ctrl, bg)

    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    if len(comps) != 2:
        return None
    colors_per_comp = []
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        patch = inp[r0 : r1 + 1, c0 : c1 + 1]
        colors_per_comp.append(sorted(set(int(x) for x in patch.flatten()) - {bg}))
    if sorted(len(cols) for cols in colors_per_comp) != [1, len(set(tile.flatten()) - {bg})]:
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(300):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_coords, components_mask, paste, random_free_location
import random


Rect = tuple[int, int, int, int, int, int]  # (area, color, r0, c0, r1, c1)


def _solid_rectangles(g: np.ndarray) -> list[Rect]:
    rects: list[Rect] = []
    for color in np.unique(g):
        for coords in components_mask(g == int(color), connectivity=4):
            r0, c0, r1, c1 = bbox_coords(coords)
            h = r1 - r0 + 1
            w = c1 - c0 + 1
            area = int(coords.shape[0])
            if h > 1 and w > 1 and area == h * w:
                rects.append((area, int(color), r0, c0, r1, c1))
    return rects


def _period_values(
    g: np.ndarray, blocked: np.ndarray, row_period: int, col_period: int
) -> dict[tuple[int, int], int] | None:
    values: dict[tuple[int, int], int] = {}
    h, w = g.shape
    for r in range(h):
        for c in range(w):
            if blocked[r, c]:
                continue
            key = (r % row_period, c % col_period)
            value = int(g[r, c])
            if key in values and values[key] != value:
                return None
            values[key] = value
    return values


def _reconstruct_rect(
    values: dict[tuple[int, int], int], row_period: int, col_period: int, rect: Rect
) -> np.ndarray:
    _, _, r0, c0, r1, c1 = rect
    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    for rr, r in enumerate(range(r0, r1 + 1)):
        for cc, c in enumerate(range(c0, c1 + 1)):
            key = (r % row_period, c % col_period)
            assert key in values, "period residue must be visible outside the rectangles"
            out[rr, cc] = values[key]
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recover the repeating background pattern hidden under the largest solid rectangle.

    Input structure:
    - The grid is covered by a small row/column periodic pattern.
    - Several non-pattern colors form solid rectangular foreground objects that
      overwrite the pattern.
    - The requested output region is the largest of those solid rectangles.

    Rule:
    - Find every 4-connected monochromatic object whose bounding box is a filled
      rectangle with both dimensions greater than one.
    - Treat those rectangles as masks, infer the smallest repeating tile that is
      consistent with all remaining visible pixels, and repaint the largest
      rectangle's coordinates with that tile.

    Key insight: The rectangle colors are occluders; the visible pixels outside
    them are enough to reconstruct the original periodic background underneath.
    """
    g = np.asarray(grid, dtype=int)
    rects = _solid_rectangles(g)
    assert rects, "expected at least one solid rectangular occluder"

    max_area = max(area for area, *_ in rects)
    targets = [rect for rect in rects if rect[0] == max_area]
    assert len(targets) == 1, "largest rectangle must be unique"
    target = targets[0]

    blocked = np.zeros(g.shape, dtype=bool)
    for _, _, r0, c0, r1, c1 in rects:
        blocked[r0 : r1 + 1, c0 : c1 + 1] = True

    h, w = g.shape
    period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []
    for row_period in range(1, h + 1):
        for col_period in range(1, w + 1):
            values = _period_values(g, blocked, row_period, col_period)
            if values is not None:
                period_candidates.append((row_period, col_period, values))
    assert period_candidates, "visible pixels must define a periodic pattern"

    min_period_area = min(rp * cp for rp, cp, _ in period_candidates)
    outputs = [
        _reconstruct_rect(values, row_period, col_period, target)
        for row_period, col_period, values in period_candidates
        if row_period * col_period == min_period_area
    ]
    assert outputs, "expected at least one minimal period"
    first = outputs[0]
    assert all(np.array_equal(first, out) for out in outputs), "minimal periods must agree"
    return first

# --------------- generator (att2) ---------------

# Tile palette and period choices.
_GEN_COLOR_RANGE = range(10)
_GEN_TILE_SIZES = [3, 4]
_GEN_TILE_COLOR_COUNTS = [3, 4]
_GEN_STEP_CHOICES = {3: [1, 2], 4: [1, 3]}
# Canvas dimensions from the observed task family.
_GEN_HEIGHT_RANGE = (19, 23)
_GEN_WIDTH_RANGE = (19, 22)
# Occluder rectangle count, size, and coverage constraints.
_GEN_RECT_COUNTS = [2, 3]
_GEN_RECT_SIDE_RANGE = range(3, 13)
_GEN_AREA_RANGE = (9, 100)
_GEN_TARGET_AREA_RANGE = (36, 100)
_GEN_COVERAGE_RANGE = (0.18, 0.33)
# Rejection sampling budget.
_GEN_ATTEMPT_LIMIT = 300

_GEN_DIMS_BY_AREA = {
    h * w: [(hh, ww) for hh in _GEN_RECT_SIDE_RANGE for ww in _GEN_RECT_SIDE_RANGE if hh * ww == h * w]
    for h in _GEN_RECT_SIDE_RANGE
    for w in _GEN_RECT_SIDE_RANGE
}


def _gen_tile() -> np.ndarray:
    size = random.choice(_GEN_TILE_SIZES)
    n_colors = random.choice(_GEN_TILE_COLOR_COUNTS) if size == 3 else 4
    colors = random.sample(_GEN_COLOR_RANGE, n_colors)
    step_choices = _GEN_STEP_CHOICES[n_colors]
    row_step = random.choice(step_choices)
    col_step = random.choice(step_choices)
    offset = random.randrange(n_colors)
    tile = np.empty((size, size), dtype=int)
    for r in range(size):
        for c in range(size):
            tile[r, c] = colors[(offset + row_step * r + col_step * c) % n_colors]
    return tile


def _gen_periodic_grid(tile: np.ndarray, height: int, width: int) -> np.ndarray:
    rows = np.arange(height)[:, None] % tile.shape[0]
    cols = np.arange(width)[None, :] % tile.shape[1]
    return tile[rows, cols].astype(int, copy=True)


def _gen_choose_areas(height: int, width: int, count: int) -> tuple[int, ...] | None:
    min_total = int(np.ceil(_GEN_COVERAGE_RANGE[0] * height * width))
    max_total = int(np.floor(_GEN_COVERAGE_RANGE[1] * height * width))
    area_min, area_max = _GEN_AREA_RANGE
    target_min, target_max = _GEN_TARGET_AREA_RANGE
    small_areas = sorted(a for a in _GEN_DIMS_BY_AREA if area_min <= a <= area_max)
    target_areas = [a for a in small_areas if target_min <= a <= target_max]
    possible: dict[int, list[tuple[int, ...]]] = {}
    for total in range(min_total, max_total + 1):
        tuples: list[tuple[int, ...]] = []
        for target in target_areas:
            if count == 2:
                small = total - target
                if small in _GEN_DIMS_BY_AREA and area_min <= small < target:
                    tuples.append((target, small))
            else:
                rem = total - target
                for small1 in small_areas:
                    small2 = rem - small1
                    if (
                        area_min <= small1 < target
                        and area_min <= small2 < target
                        and small2 in _GEN_DIMS_BY_AREA
                    ):
                        tuples.append((target, small1, small2))
        if tuples:
            possible[total] = tuples
    if not possible:
        return None
    total = random.choice(list(possible))
    return random.choice(possible[total])


def _gen_place_rectangles(shape: tuple[int, int], dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
    occupied = np.zeros(shape, dtype=int)
    placed: list[tuple[int, int, int, int]] = []
    for rect_h, rect_w in dims:
        patch = np.ones((rect_h, rect_w), dtype=int)
        try:
            row, col = random_free_location(occupied, patch, transparent=0)
        except ValueError:
            return None
        paste(occupied, patch, row, col)
        placed.append((row, col, rect_h, rect_w))
    return placed


def _gen_all_residues_visible(occupied: np.ndarray, row_period: int, col_period: int) -> bool:
    seen = np.zeros((row_period, col_period), dtype=bool)
    for residue_r in range(row_period):
        for residue_c in range(col_period):
            seen[residue_r, residue_c] = np.any(
                occupied[residue_r::row_period, residue_c::col_period] == 0
            )
    return bool(seen.all())


def _gen_attempt() -> np.ndarray | None:
    tile = _gen_tile()
    height = random.randint(*_GEN_HEIGHT_RANGE)
    width = random.randint(*_GEN_WIDTH_RANGE)
    base = _gen_periodic_grid(tile, height, width)

    count = random.choice(_GEN_RECT_COUNTS)
    areas = _gen_choose_areas(height, width, count)
    if areas is None:
        return None

    dims = [random.choice(_GEN_DIMS_BY_AREA[area]) for area in areas]
    placed = _gen_place_rectangles((height, width), dims)
    if placed is None:
        return None

    occupied = np.zeros((height, width), dtype=int)
    for row, col, rect_h, rect_w in placed:
        occupied[row : row + rect_h, col : col + rect_w] = 1
    if not _gen_all_residues_visible(occupied, tile.shape[0], tile.shape[1]):
        return None

    target_row, target_col, target_h, target_w = placed[0]
    expected = base[target_row : target_row + target_h, target_col : target_col + target_w].copy()
    tile_colors = set(map(int, tile.ravel()))
    occluder_colors = random.sample([c for c in _GEN_COLOR_RANGE if c not in tile_colors], count)

    grid = base.copy()
    for color, (row, col, rect_h, rect_w) in zip(occluder_colors, placed):
        patch = np.full((rect_h, rect_w), color, dtype=int)
        paste(grid, patch, row, col)

    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(_GEN_ATTEMPT_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {_GEN_ATTEMPT_LIMIT} attempts")

