+        left = 0 if mode == "uncentered" else (ow - patch.shape[1]) // 2
+        view = out[top : top + patch.shape[0], left : left + patch.shape[1]]
+        view[patch != bg] = patch[patch != bg]
+    return out
+
+
+def _attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    rng = random.Random()
+    n = rng.choice((2, 3, 4))
