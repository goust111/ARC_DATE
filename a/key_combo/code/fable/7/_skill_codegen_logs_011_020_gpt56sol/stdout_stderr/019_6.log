import numpy as np

from arc_utils import bbox, paste


def main(grid: np.ndarray) -> np.ndarray:
    """Normalize the framed input motif into a 5x5 icon and stamp two copies on a 15x15 canvas.

    Input structure
    The input is a rounded rectangular frame: the four corners are the background
    color, and every other outer-border pixel has one frame color. Non-background
    pixels inside that frame are the motif to preserve.

    Rule
    Make a 5x5 version of the rounded frame with a 3x3 interior. Crop the input
    interior motif to its bounding box, center that crop in the 3x3 interior, and
    paste the resulting 5x5 icon at upper-left positions (2, 2) and (8, 8) in a
    15x15 background canvas.

    Key insight
    The variable-size frame is only a carrier; the meaningful object is the
    compact interior motif, which is normalized to the fixed 3x3 icon interior.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    assert h >= 3 and w >= 3

    corners = (g[0, 0], g[0, w - 1], g[h - 1, 0], g[h - 1, w - 1])
    assert len(set(map(int, corners))) == 1
    bg = int(corners[0])

    border = np.concatenate((g[0, :], g[h - 1, :], g[:, 0], g[:, w - 1]))
    frame_colors = set(map(int, border)) - {bg}
    assert len(frame_colors) == 1
    (frame_color,) = tuple(frame_colors)

    assert np.all(g[0, 1 : w - 1] == frame_color)
    assert np.all(g[h - 1, 1 : w - 1] == frame_color)
    assert np.all(g[1 : h - 1, 0] == frame_color)
    assert np.all(g[1 : h - 1, w - 1] == frame_color)

    icon = np.full((5, 5), bg, dtype=int)
    icon[0, 1:4] = frame_color
    icon[4, 1:4] = frame_color
    icon[1:4, 0] = frame_color
    icon[1:4, 4] = frame_color

    interior = g[1 : h - 1, 1 : w - 1]
    motif_box = bbox(interior != bg)
    assert motif_box is not None
    r0, c0, r1, c1 = motif_box
    motif = interior[r0 : r1 + 1, c0 : c1 + 1]
    mh, mw = motif.shape
    assert mh <= 3 and mw <= 3

    icon_r = 1 + (3 - mh) // 2
    icon_c = 1 + (3 - mw) // 2
    icon[icon_r : icon_r + mh, icon_c : icon_c + mw] = motif

    out = np.full((15, 15), bg, dtype=int)
    out[2:7, 2:7] = icon
    out[8:13, 8:13] = icon
    return out

# --------------- generator (att2) ---------------

# Canvas and color constants.
_GEN_BG = 7
_GEN_FRAME_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]
_GEN_PALETTE = [c for c in range(10) if c != _GEN_BG]

# Input/output geometry.
_GEN_INPUT_H_RANGE = (6, 10)
_GEN_INPUT_W_RANGE = (5, 10)
_GEN_ICON_SIZE = 5
_GEN_ICON_INTERIOR = 3
_GEN_OUTPUT_SIZE = 15
_GEN_OUTPUT_POSITIONS = ((2, 2), (8, 8))

# Motif sampling.
_GEN_MOTIF_DIM_RANGE = (1, 4)
_GEN_NON_BG_COUNT_RANGE = (1, 8)
_GEN_COLOR_COUNT_RANGE = (1, 3)
_GEN_FRAME_COLOR_INJECTION_RATE = 0.35

_GEN_MAX_ATTEMPTS = 300


def _gen_min_pixels_for_bbox(mh, mw):
    return 1 if mh == 1 and mw == 1 else 2


def _gen_choose_motif_shape(rng, non_bg_count):
    choices = []
    for mh in range(*_GEN_MOTIF_DIM_RANGE):
        for mw in range(*_GEN_MOTIF_DIM_RANGE):
            if _gen_min_pixels_for_bbox(mh, mw) <= non_bg_count <= mh * mw:
                choices.append((mh, mw))
    return choices[int(rng.integers(len(choices)))]


def _gen_full_bbox_coords(rng, mh, mw, non_bg_count):
    if mh == 1 and mw == 1:
        return [(0, 0)]

    if mh == 1:
        required = [(0, 0), (0, mw - 1)]
    elif mw == 1:
        required = [(0, 0), (mh - 1, 0)]
    elif int(rng.integers(2)) == 0:
        required = [(0, 0), (mh - 1, mw - 1)]
    else:
        required = [(0, mw - 1), (mh - 1, 0)]

    coords = list(required)
    pool = [(r, c) for r in range(mh) for c in range(mw) if (r, c) not in coords]
    need = non_bg_count - len(coords)
    if need:
        picked = rng.choice(len(pool), size=need, replace=False)
        coords.extend(pool[int(i)] for i in np.atleast_1d(picked))
    return coords


def _gen_make_motif(rng, bg, frame_color):
    non_bg_count = int(rng.integers(*_GEN_NON_BG_COUNT_RANGE))
    mh, mw = _gen_choose_motif_shape(rng, non_bg_count)
    coords = _gen_full_bbox_coords(rng, mh, mw, non_bg_count)

    color_count = 1 if non_bg_count == 1 else int(rng.integers(*_GEN_COLOR_COUNT_RANGE))
    colors = list(rng.choice(_GEN_PALETTE, size=color_count, replace=False))
    if color_count == 2 and frame_color not in colors and rng.random() < _GEN_FRAME_COLOR_INJECTION_RATE:
        colors[int(rng.integers(2))] = frame_color

    motif = np.full((mh, mw), bg, dtype=int)
    rng.shuffle(coords)
    if color_count == 1:
        for r, c in coords:
            motif[r, c] = int(colors[0])
    else:
        motif[coords[0]] = int(colors[0])
        motif[coords[1]] = int(colors[1])
        for r, c in coords[2:]:
            motif[r, c] = int(colors[int(rng.integers(2))])
    return motif


def _gen_draw_rounded_frame(grid, frame_color):
    """Paint the non-corner border cells in-place."""
    h, w = grid.shape
    grid[0, 1 : w - 1] = frame_color
    grid[h - 1, 1 : w - 1] = frame_color
    grid[1 : h - 1, 0] = frame_color
    grid[1 : h - 1, w - 1] = frame_color


def _gen_build_icon(bg, frame_color, motif):
    icon = np.full((_GEN_ICON_SIZE, _GEN_ICON_SIZE), bg, dtype=int)
    _gen_draw_rounded_frame(icon, frame_color)

    mh, mw = motif.shape
    icon_r = 1 + (_GEN_ICON_INTERIOR - mh) // 2
    icon_c = 1 + (_GEN_ICON_INTERIOR - mw) // 2
    paste(icon, motif, icon_r, icon_c)
    return icon


def _gen_build_input(rng, bg, frame_color, motif):
    h = int(rng.integers(*_GEN_INPUT_H_RANGE))
    w = int(rng.integers(*_GEN_INPUT_W_RANGE))
    inp = np.full((h, w), bg, dtype=int)
    _gen_draw_rounded_frame(inp, frame_color)

    mh, mw = motif.shape
    interior_h, interior_w = h - 2, w - 2
    r = int(rng.integers(0, interior_h - mh + 1))
    c = int(rng.integers(0, interior_w - mw + 1))
    paste(inp, motif, 1 + r, 1 + c)
    return inp


def _gen_attempt(rng):
    bg = _GEN_BG
    frame_color = int(rng.choice(_GEN_FRAME_COLORS))
    motif = _gen_make_motif(rng, bg, frame_color)

    icon = _gen_build_icon(bg, frame_color, motif)
    out = np.full((_GEN_OUTPUT_SIZE, _GEN_OUTPUT_SIZE), bg, dtype=int)
    for r, c in _GEN_OUTPUT_POSITIONS:
        paste(out, icon, r, c)

    inp = _gen_build_input(rng, bg, frame_color, motif)
    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input():
    rng = np.random.default_rng()
    for _ in range(_GEN_MAX_ATTEMPTS):
        inp = _gen_attempt(rng)
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate valid db118e2a input")
from __future__ import annotations
import numpy as np
from arc_utils import colors_present, crop_bbox, find_components, get_bg, paste, random_free_location
from arc_utils import find_components, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.

    Input structure:
    - bg = background color.
    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).

    Rule:
    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).

    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # Find multicolor connected components of the foreground as a whole.
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (len(comps) != 2)

    infos = []
    for comp in comps:
        patch = crop_bbox(g, comp["bbox"])
        cols = colors_present(patch, exclude={bg})
        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})

    # Building block is the component with >=2 colors (or more unique colors), preferring square.
    infos.sort(
        key=lambda d: (
            len(d["cols"]) >= 2,
            len(d["cols"]),
            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
        ),
        reverse=True,
    )
    block = infos[0]["patch"]
    ctrl = infos[1]["patch"]

    bh, bw = map(int, block.shape)
    ch, cw = map(int, ctrl.shape)

    ctrl_cols = colors_present(ctrl, exclude={bg})
    if not ctrl_cols:
        return np.full((0, 0), int(bg), dtype=int)

    ctrl_col = int(ctrl_cols[0])
    mask = (ctrl == int(ctrl_col))

    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if bool(mask[r, c]):
                paste(out, block, r * bh, c * bw)
    return out

# --------------- generator (Codex#3) ---------------

def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
    seen: set[tuple[int, int]] = set()
    out: list[tuple[list[tuple[int, int]], bool]] = []
    s = int(size)
    for r in range(s):
        for c in range(s):
            if (r, c) in seen:
                continue
            orbit = {
                (r, c),
                (c, s - 1 - r),
                (s - 1 - r, s - 1 - c),
                (s - 1 - c, r),
                (r, s - 1 - c),
                (s - 1 - r, c),
                (c, r),
                (s - 1 - c, s - 1 - r),
            }
            cells = sorted(orbit)
            seen.update(cells)
            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
            out.append((cells, border))
    return out


def _make_tile(bg: int, fg_colors: list[int], rng: np.random.Generator) -> np.ndarray:
    size = int(rng.integers(3, 6))
    n_tile_colors = int(rng.integers(2, 4))
    tile_colors = list(rng.choice(fg_colors, size=n_tile_colors, replace=False))
    orbits = _dihedral_orbits(size)
    rng.shuffle(orbits)

    tile = np.full((size, size), int(bg), dtype=int)
    assignments: dict[int, int] = {}
    for i, color in enumerate(tile_colors):
        assignments[i] = int(color)

    interior_idxs = [i for i, (_cells, border) in enumerate(orbits) if not border and i not in assignments]
    if interior_idxs and rng.random() < 0.25:
        assignments[int(rng.choice(interior_idxs))] = int(bg)

    for i, (_cells, border) in enumerate(orbits):
        if i not in assignments:
            palette = tile_colors if border else tile_colors + ([bg] if interior_idxs else [])
            assignments[i] = int(rng.choice(palette))

    for i, (cells, _border) in enumerate(orbits):
        for r, c in cells:
            tile[r, c] = assignments[i]
    return tile


def _neighbors8(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            rr = r + dr
            cc = c + dc
            if 0 <= rr < h and 0 <= cc < w:
                out.append((rr, cc))
    return out


def _make_ctrl(bg: int, color: int, rng: np.random.Generator) -> np.ndarray:
    h = int(rng.integers(3, 6))
    w = int(rng.integers(3, 6))
    area = h * w
    min_fill = (area + 1) // 2
    max_fill = int(np.floor(0.72 * area))
    target = int(rng.integers(min_fill, max_fill + 1))

    ar = int(rng.integers(0, h))
    ac = int(rng.integers(0, w))
    mask = np.zeros((h, w), dtype=bool)
    mask[:, ac] = True
    mask[ar, :] = True

    while int(mask.sum()) < target:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if any(mask[rr, cc] for rr, cc in _neighbors8(h, w, r, c)):
                    frontier.append((r, c))
        pick = frontier[int(rng.integers(len(frontier)))]
        mask[pick] = True

    ctrl = np.full((h, w), int(bg), dtype=int)
    ctrl[mask] = int(color)
    return ctrl


def _compose_output(tile: np.ndarray, ctrl: np.ndarray, bg: int) -> np.ndarray:
    th, tw = tile.shape
    ch, cw = ctrl.shape
    out = np.full((ch * th, cw * tw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if ctrl[r, c] != bg:
                paste(out, tile, r * th, c * tw)
    return out


def _make_input(tile: np.ndarray, ctrl: np.ndarray, bg: int, rng: np.random.Generator) -> np.ndarray:
    horizontal = bool(rng.integers(0, 2))
    gap = 1

    if horizontal:
        if rng.random() < 0.5:
            left_obj, right_obj = tile, ctrl
        else:
            left_obj, right_obj = ctrl, tile
        lh, lw = left_obj.shape
        rh, rw = right_obj.shape
        H = int(rng.integers(max(10, max(lh, rh)), 19))
        W = int(rng.integers(max(10, lw + rw + gap), 19))
        slack = W - (lw + rw + gap)
        c_left = int(rng.integers(0, slack + 1))
        c_right = int(rng.integers(c_left + lw + gap, W - rw + 1))
        r_left = int(rng.integers(0, H - lh + 1))
        r_right = int(rng.integers(0, H - rh + 1))
        if left_obj is tile:
            tile_pos = (r_left, c_left)
            ctrl_pos = (r_right, c_right)
        else:
            ctrl_pos = (r_left, c_left)
            tile_pos = (r_right, c_right)
    else:
        if rng.random() < 0.5:
            top_obj, bot_obj = tile, ctrl
        else:
            top_obj, bot_obj = ctrl, tile
        th, tw = top_obj.shape
        bh, bw = bot_obj.shape
        H = int(rng.integers(max(10, th + bh + gap), 19))
        W = int(rng.integers(max(10, max(tw, bw)), 19))
        slack = H - (th + bh + gap)
        r_top = int(rng.integers(0, slack + 1))
        r_bot = int(rng.integers(r_top + th + gap, H - bh + 1))
        c_top = int(rng.integers(0, W - tw + 1))
        c_bot = int(rng.integers(0, W - bw + 1))
        if top_obj is tile:
            tile_pos = (r_top, c_top)
            ctrl_pos = (r_bot, c_bot)
        else:
            ctrl_pos = (r_top, c_top)
            tile_pos = (r_bot, c_bot)

    grid = np.full((H, W), int(bg), dtype=int)
    paste(grid, tile, *tile_pos)
    paste(grid, ctrl, *ctrl_pos, transparent=bg)
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    palette = list(rng.choice(np.arange(10, dtype=int), size=5, replace=False))
    bg = int(palette[0])
    fg = [int(x) for x in palette[1:]]

    tile = _make_tile(bg, fg, rng)
    ctrl = _make_ctrl(bg, fg[-1], rng)
    inp = _make_input(tile, ctrl, bg, rng)
    expected = _compose_output(tile, ctrl, bg)

    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    if len(comps) != 2:
        return None
    colors_per_comp = []
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        patch = inp[r0 : r1 + 1, c0 : c1 + 1]
        colors_per_comp.append(sorted(set(int(x) for x in patch.flatten()) - {bg}))
    if sorted(len(cols) for cols in colors_per_comp) != [1, len(set(tile.flatten()) - {bg})]:
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(300):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate valid input")
import numpy as np
from arc_utils import Color, draw_line
import random


# concepts:
# diagonal lines, repetition

# description:
# In the input you will see a 7x7 grid, with three diagonal lines that stretch from one end of the canvas to the other
# Each line is a different color, and the colors are not black
# The output should be the result of repeating every diagonal line on multiples of 3 offset from the original, which gives an interlacing pattern filling the output canvas


def main(input_grid: np.ndarray) -> np.ndarray:
    """
    Repeat each colored diagonal every three offsets to fill the 7x7 grid with an interlaced pattern.

    Input structure:
    - The input is a 7x7 black grid containing three full diagonals.
    - Each diagonal has a distinct non-black color.
    - The diagonals run in the same slope direction.

    Rule:
    - For every non-black input cell, draw its full diagonal in the output.
    - Redraw that same diagonal color at offsets spaced by three rows.
    - Clip the repeated diagonals to the 7x7 canvas.

    Key insight:
    - A single colored diagonal defines a whole congruence class modulo three; repeating all three
      classes creates the final interlacing.
    """
    output_grid = np.zeros((7, 7), dtype=int)

    # Loop over the input looking for any of the three diagonals
    # If we find one, we will fill the output with the same color in the same pattern
    for i in range(output_grid.shape[0]):
        for j in range(output_grid.shape[1]):
            c = input_grid[i][j]
            if c != Color.BLACK:
                # Fill the output with the same color in the same pattern
                # Loop by multiples of 3 to create the pattern
                # Loop way beyond the canvas (double the canvas size) to make sure we cover everything
                for distance in range(0, output_grid.shape[0]*2, 3):
                    draw_diagonal(output_grid, i-distance, j, c)
                    draw_diagonal(output_grid, i+distance, j, c)
    
    return output_grid

def draw_diagonal(grid, r, cc, c):
    # create diagonal line that stretches from one side of the canvas to the other
    # to do this, draw infinite rays pointing in opposite directions
    L = max(grid.shape) * 3
    draw_line(grid, int(r), int(cc), length=L, color=int(c), direction=(1, -1), clip=True)
    draw_line(grid, int(r), int(cc), length=L, color=int(c), direction=(-1, 1), clip=True)

def generate_input() -> np.ndarray:

    # create a 7x7 grid of black (0)
    grid = np.zeros((7, 7), dtype=int)
    # pick 3 random distinct colors
    c1, c2, c3 = np.random.choice(Color.NOT_BLACK, 3, replace=False)

    # put down the three diagonal lines
    draw_diagonal(grid, np.random.choice(range(7)), np.random.choice(range(7)), c1)
    draw_diagonal(grid, np.random.choice(range(7)), np.random.choice(range(7)), c2)
    draw_diagonal(grid, np.random.choice(range(7)), np.random.choice(range(7)), c3)

    # make sure that the output is completely filled up with the pattern meaning it doesn't contain any black pixels
    if np.any(main(grid) == Color.BLACK):
        return generate_input()
    
    return grid
