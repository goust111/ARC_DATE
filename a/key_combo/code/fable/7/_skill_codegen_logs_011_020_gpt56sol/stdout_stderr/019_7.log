from __future__ import annotations

from collections import defaultdict

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.

    Input structure:
    - The background is the most common color.
    - Foreground objects are solid monochrome rectangles touching a grid corner.
    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.

    Rule:
    - Clear the multiple objects of the repeated color from their original positions.
    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.

    Key insight:
    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    by_color: dict[int, list[dict]] = defaultdict(list)
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        by_color[int(comp["color"])].append(comp)

    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
    assert len(moving_colors) == 1
    moving_color = int(moving_colors[0])
    moving_objects = by_color[moving_color]

    out = g.copy()
    for comp in moving_objects:
        coords = comp["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

    for comp in moving_objects:
        coords = comp["coords"]
        r0, c0, r1, c1 = map(int, comp["bbox"])
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        assert int(comp["area"]) == height * width

        touches_top = r0 == 0
        touches_bottom = r1 == H - 1
        touches_left = c0 == 0
        touches_right = c1 == W - 1
        assert touches_top != touches_bottom
        assert touches_left != touches_right

        dr = height if touches_top else -height
        dc = width if touches_left else -width
        shifted = coords + np.array([dr, dc], dtype=int)
        assert bool(
            np.all(
                (0 <= shifted[:, 0])
                & (shifted[:, 0] < H)
                & (0 <= shifted[:, 1])
                & (shifted[:, 1] < W)
            )
        )

        target = out[shifted[:, 0], shifted[:, 1]]
        assert bool(np.all((target == bg) | (target == moving_color)))
        out[shifted[:, 0], shifted[:, 1]] = moving_color

    return out

# --------------- generator (o5x) ---------------

# Corner and movement model.
CORNERS = ("TL", "TR", "BL", "BR")
DIAGONAL_PAIRS = ({"TL", "BR"}, {"TR", "BL"})
INWARD_STEP_FACTOR = 2
COMPACT_CANVAS_FACTOR = 3

# Canvas, object count, and retry bounds.
GRID_ROW_BOUNDS = (7, 22)
GRID_COL_BOUNDS = (7, 30)
SQUARE_SIZE_BOUNDS = (1, 4)
MOVING_COUNT_BOUNDS = (2, 4)
GENERATION_RETRIES = 300

# Color palette.
COLOR_VALUES = tuple(range(10))

def _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = 0 if corner[0] == "T" else H - s
    col = 0 if corner[1] == "L" else W - s
    return row, col


def _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = s if corner[0] == "T" else H - INWARD_STEP_FACTOR * s
    col = s if corner[1] == "L" else W - INWARD_STEP_FACTOR * s
    return row, col


def _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:
    sizes = []
    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):
        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):
            bg_area = H * W - len(CORNERS) * s * s
            if bg_area <= moving_count * s * s:
                continue
            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:
                continue
            sizes.append((H, W))
    return sizes


def _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:
    if moving_count == len(CORNERS):
        return set(CORNERS)
    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:
        return set(random.choice(DIAGONAL_PAIRS))
    return set(random.sample(CORNERS, moving_count))


def _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:
    ar, ac = a
    br, bc = b
    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s


def _sample_layout():
    """Return a collision-free layout tuple, or None when the sampled size cannot work."""
    s = random.randint(*SQUARE_SIZE_BOUNDS)
    moving_count = random.randint(*MOVING_COUNT_BOUNDS)
    sizes = _valid_sizes(s, moving_count)
    if not sizes:
        return None
    H, W = random.choice(sizes)

    moving = _pick_moving_corners(H, W, s, moving_count)
    singletons = [corner for corner in CORNERS if corner not in moving]

    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}
    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}
    for moved_pos in shifted.values():
        for kept_pos in singleton_pos.values():
            if _overlaps(moved_pos, kept_pos, s):
                return None
    return H, W, s, moving, singletons, shifted, singleton_pos


def _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:
    colors = list(COLOR_VALUES)
    bg = random.choice(colors)
    colors.remove(bg)
    moving_color = random.choice(colors)
    colors.remove(moving_color)
    singleton_colors = random.sample(colors, singleton_count)
    return bg, moving_color, singleton_colors


def _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):
    """Render the matching input/output grids for an accepted layout and palette."""
    rect = np.full((s, s), moving_color, dtype=int)
    out = np.full((H, W), bg, dtype=int)
    for corner in moving:
        paste(out, rect, *shifted[corner])
    for corner, color in zip(singletons, singleton_colors):
        patch = np.full((s, s), color, dtype=int)
        paste(out, patch, *singleton_pos[corner])

    inp = out.copy()
    for corner in moving:
        r, c = shifted[corner]
        inp[r : r + s, c : c + s] = bg
    for corner in moving:
        paste(inp, rect, *_corner_pos(corner, H, W, s))
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    layout = _sample_layout()
    if layout is None:
        return None
    H, W, s, moving, singletons, shifted, singleton_pos = layout
    bg, moving_color, singleton_colors = _sample_colors(len(singletons))
    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)
    try:
        return inp if np.array_equal(main(inp), out) else None
    except AssertionError:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 22208ba4 input")
import numpy as np

from arc_utils import Color, components_mask


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor the smallest black region orange and the largest black region teal.

    Input structure:
    - The grid contains only black background regions and grey one-cell-wide walls.
    - The grey walls partition the black pixels into multiple 4-connected regions.
    - The smallest and largest black regions are each unique.

    Rule:
    - Find all 4-connected black regions.
    - Recolor every pixel of the unique smallest black region orange.
    - Recolor every pixel of the unique largest black region teal.
    - Preserve all grey pixels and all other black regions.

    Key insight:
    - The colors mark extreme region size among the black cells; the region location
      and shape do not otherwise determine the output.
    """
    g = np.asarray(grid, dtype=int)
    colors = set(map(int, g.ravel()))
    assert Color.BLACK in colors
    assert Color.GREY in colors
    assert colors <= {Color.BLACK, Color.GREY}

    regions = components_mask(g == Color.BLACK, connectivity=4)
    assert len(regions) >= 2

    areas = np.array([int(region.shape[0]) for region in regions], dtype=int)
    small_indices = np.flatnonzero(areas == areas.min())
    large_indices = np.flatnonzero(areas == areas.max())
    assert small_indices.size == 1
    assert large_indices.size == 1
    assert int(small_indices[0]) != int(large_indices[0])

    out = g.copy()
    small_region = regions[int(small_indices[0])]
    large_region = regions[int(large_indices[0])]
    out[small_region[:, 0], small_region[:, 1]] = Color.ORANGE
    out[large_region[:, 0], large_region[:, 1]] = Color.TEAL
    return out

# --------------- generator (o5x) ---------------

# Canvas bounds and admissible total area.
CANVAS_ROW_CHOICES = range(5, 16)
CANVAS_COL_CHOICES = range(5, 13)
CANVAS_AREA_RANGE = (60, 150)

# Required black-region and area structure.
REGION_COUNT_CHOICES = (7, 8)
SMALLEST_REGION_AREA_RANGE, LARGEST_REGION_AREA_RANGE = (1, 4), (10, 23)
MIN_LARGE_SMALL_RATIO = 5

# Grey wall layout and validation limits.
GREY_FRACTION_RANGE = (0.35, 0.44)
SIDE_WIDTH_LIMIT, MAX_TRUNK_SHIFTS, TRUNK_SHIFT_CLEARANCE = 4, 4, 1
BRANCH_STRAIGHT_PROB, BRANCH_MIN_BEND_ROOM = 0.35, 3

# Retry budget for rejection sampling.
GENERATION_RETRIES = 300

CANVAS_DIMS = tuple(
    (h, w)
    for h in CANVAS_ROW_CHOICES
    for w in CANVAS_COL_CHOICES
    if CANVAS_AREA_RANGE[0] <= h * w <= CANVAS_AREA_RANGE[1]
)


def _gen_bounded_composition(total, parts, max_each):
    if parts <= 0 or max_each < 1 or total < parts or total > parts * max_each:
        return None

    vals = []
    remaining = total
    for i in range(parts):
        left = parts - i - 1
        lo = max(1, remaining - left * max_each)
        hi = min(max_each, remaining - left)
        if lo > hi:
            return None
        val = int(np.random.randint(lo, hi + 1))
        vals.append(val)
        remaining -= val

    return [int(v) for v in np.random.permutation(vals)]


def _gen_branch_rows(heights):
    rows = []
    r = 0
    for h in heights[:-1]:
        r += int(h)
        rows.append(r)
        r += 1
    return rows


def _gen_all_black_regions_touch_border(grid, regions):
    h, w = grid.shape
    for region in regions:
        rr = region[:, 0]
        cc = region[:, 1]
        if not (
            np.any(rr == 0)
            or np.any(rr == h - 1)
            or np.any(cc == 0)
            or np.any(cc == w - 1)
        ):
            return False
    return True


def _gen_trunk_spans(length, width, start_col, blocked_rows):
    blocked_rows = set(blocked_rows)
    candidates = [
        r
        for r in range(TRUNK_SHIFT_CLEARANCE, length - 2)
        if all(abs(r - blocked) > TRUNK_SHIFT_CLEARANCE for blocked in blocked_rows)
    ]
    if candidates:
        candidates = [int(r) for r in np.random.permutation(candidates)]

    used = []
    max_shifts = min(MAX_TRUNK_SHIFTS, len(candidates))
    shift_goal = int(np.random.randint(0, max_shifts + 1))
    for r in candidates:
        if len(used) >= shift_goal:
            break
        if all(abs(r - prev) > TRUNK_SHIFT_CLEARANCE for prev in used):
            used.append(r)

    shift_rows = set(used)
    spans = []
    c = int(start_col)
    for r in range(length):
        if r in shift_rows:
            directions = []
            if c > 1:
                directions.append(-1)
            if c < width - 2:
                directions.append(1)
            if directions:
                nc = c + int(directions[int(np.random.randint(0, len(directions)))])
                spans.append((min(c, nc), max(c, nc)))
                c = nc
                continue
        spans.append((c, c))
    return spans


def _gen_branch_row_offset(row, length):
    offsets = [0]
    if row > 0:
        offsets.append(-1)
    if row < length - 1:
        offsets.append(1)
    return int(offsets[int(np.random.randint(0, len(offsets)))])


def _gen_paint_straight_branch(grid, row, anchor, left_side):
    if left_side:
        grid[row, : anchor + 1] = Color.GREY
    else:
        grid[row, anchor:] = Color.GREY


def _gen_paint_branch(grid, spans, row, side):
    length, width = grid.shape
    lo, hi = spans[row]
    left_side = side < 0
    anchor = lo if left_side else hi
    room = anchor if left_side else width - anchor - 1

    if room < BRANCH_MIN_BEND_ROOM or np.random.random() < BRANCH_STRAIGHT_PROB:
        _gen_paint_straight_branch(grid, row, anchor, left_side)
        return

    if left_side:
        turn = int(np.random.randint(1, anchor - 1))
    else:
        turn = int(np.random.randint(anchor + 2, width - 1))

    end_row = row + _gen_branch_row_offset(row, length)
    if end_row == row:
        _gen_paint_straight_branch(grid, row, anchor, left_side)
        return

    if left_side:
        grid[row, turn : anchor + 1] = Color.GREY
        grid[min(row, end_row) : max(row, end_row) + 1, turn] = Color.GREY
        grid[end_row, : turn + 1] = Color.GREY
        return

    grid[row, anchor : turn + 1] = Color.GREY
    grid[min(row, end_row) : max(row, end_row) + 1, turn] = Color.GREY
    grid[end_row, turn:] = Color.GREY


def _gen_oriented_frame():
    h, w = CANVAS_DIMS[int(np.random.randint(0, len(CANVAS_DIMS)))]
    target_regions = int(np.random.choice(REGION_COUNT_CHOICES))
    orientations = []
    if target_regions <= 2 * ((h + 1) // 2):
        orientations.append(False)
    if target_regions <= 2 * ((w + 1) // 2):
        orientations.append(True)
    if not orientations:
        return None

    transpose = bool(orientations[int(np.random.randint(0, len(orientations)))])
    length, width = (w, h) if transpose else (h, w)
    return target_regions, transpose, length, width


def _gen_layout_plan(length, width, target_regions):
    max_segments_per_side = (length + 1) // 2
    segment_pairs = [
        (left, target_regions - left)
        for left in range(1, target_regions)
        if left <= max_segments_per_side and target_regions - left <= max_segments_per_side
    ]
    if not segment_pairs:
        return None

    left_segments, right_segments = segment_pairs[
        int(np.random.randint(0, len(segment_pairs)))
    ]
    trunk_choices = []
    for trunk_col in range(1, width - 1):
        left_width = trunk_col
        right_width = width - trunk_col - 1
        if min(left_width, right_width) > SIDE_WIDTH_LIMIT:
            continue

        left_total = length - (left_segments - 1)
        right_total = length - (right_segments - 1)
        if (
            left_total <= left_segments * (LARGEST_REGION_AREA_RANGE[1] // left_width)
            and right_total
            <= right_segments * (LARGEST_REGION_AREA_RANGE[1] // right_width)
        ):
            trunk_choices.append((trunk_col, left_width, right_width))

    if not trunk_choices:
        return None

    trunk_col, left_width, right_width = trunk_choices[
        int(np.random.randint(0, len(trunk_choices)))
    ]

    left_heights = _gen_bounded_composition(
        length - (left_segments - 1),
        left_segments,
        LARGEST_REGION_AREA_RANGE[1] // left_width,
    )
    right_heights = _gen_bounded_composition(
        length - (right_segments - 1),
        right_segments,
        LARGEST_REGION_AREA_RANGE[1] // right_width,
    )
    if left_heights is None or right_heights is None:
        return None

    left_rows = _gen_branch_rows(left_heights)
    right_rows = _gen_branch_rows(right_heights)
    return trunk_col, left_rows, right_rows


def _gen_render_wall_grid(length, width, trunk_col, left_rows, right_rows):
    spans = _gen_trunk_spans(length, width, trunk_col, left_rows + right_rows)

    grid = np.full((length, width), Color.BLACK, dtype=int)
    for r, (lo, hi) in enumerate(spans):
        grid[r, lo : hi + 1] = Color.GREY
    for r in left_rows:
        _gen_paint_branch(grid, spans, r, -1)
    for r in right_rows:
        _gen_paint_branch(grid, spans, r, 1)

    return grid


def _gen_validated_regions(grid, target_regions):
    grey = grid == Color.GREY
    has_2x2_wall = np.any(grey[:-1, :-1] & grey[1:, :-1] & grey[:-1, 1:] & grey[1:, 1:])
    if has_2x2_wall:
        return None

    grey_regions = components_mask(grey, connectivity=4)
    if len(grey_regions) != 1:
        return None

    black_regions = components_mask(grid == Color.BLACK, connectivity=4)
    if len(black_regions) != target_regions:
        return None

    if not _gen_all_black_regions_touch_border(grid, black_regions):
        return None

    grey_fraction = np.count_nonzero(grey) / grid.size
    if not (GREY_FRACTION_RANGE[0] <= grey_fraction <= GREY_FRACTION_RANGE[1]):
        return None

    areas = np.array([int(region.shape[0]) for region in black_regions], dtype=int)
    min_area = int(areas.min())
    max_area = int(areas.max())
    if not (
        SMALLEST_REGION_AREA_RANGE[0] <= min_area <= SMALLEST_REGION_AREA_RANGE[1]
        and LARGEST_REGION_AREA_RANGE[0] <= max_area <= LARGEST_REGION_AREA_RANGE[1]
        and np.count_nonzero(areas == min_area) == 1
        and np.count_nonzero(areas == max_area) == 1
        and min_area != max_area
        and max_area >= MIN_LARGE_SMALL_RATIO * min_area
    ):
        return None

    return black_regions, areas, min_area, max_area


def _gen_attempt() -> np.ndarray | None:
    oriented = _gen_oriented_frame()
    if oriented is None:
        return None

    target_regions, transpose, length, width = oriented
    layout = _gen_layout_plan(length, width, target_regions)
    if layout is None:
        return None

    trunk_col, left_rows, right_rows = layout
    grid = _gen_render_wall_grid(length, width, trunk_col, left_rows, right_rows)
    if transpose:
        grid = grid.T

    region_data = _gen_validated_regions(grid, target_regions)
    if region_data is None:
        return None

    black_regions, areas, min_area, max_area = region_data
    expected = grid.copy()
    small_region = black_regions[int(np.flatnonzero(areas == min_area)[0])]
    large_region = black_regions[int(np.flatnonzero(areas == max_area)[0])]
    expected[small_region[:, 0], small_region[:, 1]] = Color.ORANGE
    expected[large_region[:, 0], large_region[:, 1]] = Color.TEAL

    try:
        solved = main(grid)
    except AssertionError:
        return None
    if not np.array_equal(solved, expected):
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 62ab2642 input")
from __future__ import annotations
import numpy as np
from arc_utils import colors_present, crop_bbox, find_components, get_bg, paste, random_free_location
from arc_utils import find_components, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.

    Input structure:
    - bg = background color.
    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).

    Rule:
    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).

    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # Find multicolor connected components of the foreground as a whole.
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (len(comps) != 2)

    infos = []
    for comp in comps:
        patch = crop_bbox(g, comp["bbox"])
        cols = colors_present(patch, exclude={bg})
        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})

    # Building block is the component with >=2 colors (or more unique colors), preferring square.
    infos.sort(
        key=lambda d: (
            len(d["cols"]) >= 2,
            len(d["cols"]),
            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
        ),
        reverse=True,
    )
    block = infos[0]["patch"]
    ctrl = infos[1]["patch"]

    bh, bw = map(int, block.shape)
    ch, cw = map(int, ctrl.shape)

    ctrl_cols = colors_present(ctrl, exclude={bg})
    if not ctrl_cols:
        return np.full((0, 0), int(bg), dtype=int)

    ctrl_col = int(ctrl_cols[0])
    mask = (ctrl == int(ctrl_col))

    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if bool(mask[r, c]):
                paste(out, block, r * bh, c * bw)
    return out

# --------------- generator (Codex#3) ---------------

def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
    seen: set[tuple[int, int]] = set()
    out: list[tuple[list[tuple[int, int]], bool]] = []
    s = int(size)
    for r in range(s):
        for c in range(s):
            if (r, c) in seen:
                continue
            orbit = {
                (r, c),
                (c, s - 1 - r),
                (s - 1 - r, s - 1 - c),
                (s - 1 - c, r),
                (r, s - 1 - c),
                (s - 1 - r, c),
                (c, r),
                (s - 1 - c, s - 1 - r),
            }
            cells = sorted(orbit)
            seen.update(cells)
            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
            out.append((cells, border))
    return out


def _make_tile(bg: int, fg_colors: list[int], rng: np.random.Generator) -> np.ndarray:
    size = int(rng.integers(3, 6))
    n_tile_colors = int(rng.integers(2, 4))
    tile_colors = list(rng.choice(fg_colors, size=n_tile_colors, replace=False))
    orbits = _dihedral_orbits(size)
    rng.shuffle(orbits)

    tile = np.full((size, size), int(bg), dtype=int)
    assignments: dict[int, int] = {}
    for i, color in enumerate(tile_colors):
        assignments[i] = int(color)

    interior_idxs = [i for i, (_cells, border) in enumerate(orbits) if not border and i not in assignments]
    if interior_idxs and rng.random() < 0.25:
        assignments[int(rng.choice(interior_idxs))] = int(bg)

    for i, (_cells, border) in enumerate(orbits):
        if i not in assignments:
            palette = tile_colors if border else tile_colors + ([bg] if interior_idxs else [])
            assignments[i] = int(rng.choice(palette))

    for i, (cells, _border) in enumerate(orbits):
        for r, c in cells:
            tile[r, c] = assignments[i]
    return tile


def _neighbors8(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            rr = r + dr
            cc = c + dc
            if 0 <= rr < h and 0 <= cc < w:
                out.append((rr, cc))
    return out


def _make_ctrl(bg: int, color: int, rng: np.random.Generator) -> np.ndarray:
    h = int(rng.integers(3, 6))
    w = int(rng.integers(3, 6))
    area = h * w
    min_fill = (area + 1) // 2
    max_fill = int(np.floor(0.72 * area))
    target = int(rng.integers(min_fill, max_fill + 1))

    ar = int(rng.integers(0, h))
    ac = int(rng.integers(0, w))
    mask = np.zeros((h, w), dtype=bool)
    mask[:, ac] = True
    mask[ar, :] = True

    while int(mask.sum()) < target:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if any(mask[rr, cc] for rr, cc in _neighbors8(h, w, r, c)):
                    frontier.append((r, c))
        pick = frontier[int(rng.integers(len(frontier)))]
        mask[pick] = True

    ctrl = np.full((h, w), int(bg), dtype=int)
    ctrl[mask] = int(color)
    return ctrl


def _compose_output(tile: np.ndarray, ctrl: np.ndarray, bg: int) -> np.ndarray:
    th, tw = tile.shape
    ch, cw = ctrl.shape
    out = np.full((ch * th, cw * tw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if ctrl[r, c] != bg:
                paste(out, tile, r * th, c * tw)
    return out


def _make_input(tile: np.ndarray, ctrl: np.ndarray, bg: int, rng: np.random.Generator) -> np.ndarray:
    horizontal = bool(rng.integers(0, 2))
    gap = 1

    if horizontal:
        if rng.random() < 0.5:
            left_obj, right_obj = tile, ctrl
        else:
            left_obj, right_obj = ctrl, tile
        lh, lw = left_obj.shape
        rh, rw = right_obj.shape
        H = int(rng.integers(max(10, max(lh, rh)), 19))
        W = int(rng.integers(max(10, lw + rw + gap), 19))
        slack = W - (lw + rw + gap)
        c_left = int(rng.integers(0, slack + 1))
        c_right = int(rng.integers(c_left + lw + gap, W - rw + 1))
        r_left = int(rng.integers(0, H - lh + 1))
        r_right = int(rng.integers(0, H - rh + 1))
        if left_obj is tile:
            tile_pos = (r_left, c_left)
            ctrl_pos = (r_right, c_right)
        else:
            ctrl_pos = (r_left, c_left)
            tile_pos = (r_right, c_right)
    else:
        if rng.random() < 0.5:
            top_obj, bot_obj = tile, ctrl
        else:
            top_obj, bot_obj = ctrl, tile
        th, tw = top_obj.shape
        bh, bw = bot_obj.shape
        H = int(rng.integers(max(10, th + bh + gap), 19))
        W = int(rng.integers(max(10, max(tw, bw)), 19))
        slack = H - (th + bh + gap)
        r_top = int(rng.integers(0, slack + 1))
        r_bot = int(rng.integers(r_top + th + gap, H - bh + 1))
        c_top = int(rng.integers(0, W - tw + 1))
        c_bot = int(rng.integers(0, W - bw + 1))
        if top_obj is tile:
            tile_pos = (r_top, c_top)
            ctrl_pos = (r_bot, c_bot)
        else:
            ctrl_pos = (r_top, c_top)
            tile_pos = (r_bot, c_bot)

    grid = np.full((H, W), int(bg), dtype=int)
    paste(grid, tile, *tile_pos)
    paste(grid, ctrl, *ctrl_pos, transparent=bg)
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    palette = list(rng.choice(np.arange(10, dtype=int), size=5, replace=False))
    bg = int(palette[0])
    fg = [int(x) for x in palette[1:]]

    tile = _make_tile(bg, fg, rng)
    ctrl = _make_ctrl(bg, fg[-1], rng)
    inp = _make_input(tile, ctrl, bg, rng)
    expected = _compose_output(tile, ctrl, bg)

    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    if len(comps) != 2:
        return None
    colors_per_comp = []
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        patch = inp[r0 : r1 + 1, c0 : c1 + 1]
        colors_per_comp.append(sorted(set(int(x) for x in patch.flatten()) - {bg}))
    if sorted(len(cols) for cols in colors_per_comp) != [1, len(set(tile.flatten()) - {bg})]:
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(300):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate valid input")
import itertools

import numpy as np

from arc_utils import colors_present, components_mask as _gen_components_mask, get_bg, paste as _gen_paste
import itertools as _gen_itertools
import random as _gen_random


def _find_unique_sprite_mask(g: np.ndarray, fg_color: int) -> tuple[tuple[int, int], ...]:
    fg = {tuple(map(int, rc)) for rc in np.argwhere(g == fg_color)}
    assert len(fg) % 4 == 0
    sprite_area = len(fg) // 4
    assert 1 <= sprite_area <= 4

    h, w = g.shape
    offsets = ((0, 0), (0, 1), (1, 0), (1, 1))
    solutions = []
    for mask in itertools.combinations(offsets, sprite_area):
        candidates = []
        for r in range(h - 1):
            for c in range(w - 1):
                cells = frozenset((r + dr, c + dc) for dr, dc in mask)
                if cells <= fg:
                    candidates.append(cells)

        for copies in itertools.combinations(candidates, 4):
            covered = set()
            for cells in copies:
                if covered & cells:
                    break
                covered.update(cells)
            else:
                if covered == fg:
                    solutions.append(mask)

    assert len(solutions) == 1
    return solutions[0]


def main(grid: np.ndarray) -> np.ndarray:
    """Separate four overlapping-looking copies of one 2x2 sprite into the four corners of a 5x5 canvas.

    Input structure
    A 6x6 grid has one background color and one foreground color.  The foreground
    pixels are exactly coverable by four translated copies of one 2x2 sprite mask.

    Rule
    Infer the unique 2x2 sprite mask whose four translated copies cover all
    foreground pixels without overlap, then stamp that mask into the upper-left,
    upper-right, lower-left, and lower-right 2x2 regions of a 5x5 output.

    Key insight
    The tangled input arrangement is only a compact packing of four identical
    small sprites; the output regularizes the packing by inserting a blank middle
    row and column between the copies.
