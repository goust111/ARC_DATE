+            inp[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    for spec in specs:
+        if spec["moving"]:
+            r0, c0, r1, c1 = spec["source"]
+            if np.any(inp[r0 : r1 + 1, c0 : c1 + 1] != BLACK):
+                return None
+            inp[r0 : r1 + 1, c0 : c1 + 1] = mover_color
