+    """Solve a scene already normalized to downward gravity."""
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = Counter(map(int, g.ravel())).most_common(1)[0][0]
+    assert bg != 0, "the black wall and bars must differ from the background"
+    assert np.all(g[-1, :] == 0)
