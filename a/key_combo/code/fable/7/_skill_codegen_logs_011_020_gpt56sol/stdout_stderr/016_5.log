+        return None
+
+    # Random orientation is applied last, preserving the exact wall-based frame.
+    return np.rot90(g, random.randrange(4)).copy()
+
+
+def generate_input() -> np.ndarray:
+    """Generate varied, non-degenerate live-gate gravity scenes."""
+    for _ in range(400):
+        grid = _attempt()
+        if grid is not None:
