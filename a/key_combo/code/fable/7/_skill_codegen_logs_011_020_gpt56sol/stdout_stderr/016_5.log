+                fixed[nr0:nr1 + 1, c0:c0 + ow].any()
+                or sealed[nr0:nr1 + 1, c0:c0 + ow].any()
+                or occupied[nr0:nr1 + 1, c0:c0 + ow].any()
+            )
+            if footprint_blocked:
+                break
