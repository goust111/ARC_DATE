+            + [(r, c1 + 1) for r in range(r0, r1 + 1)]
+        )
+        if all(int(g[r, c]) == WALL for r, c in ring):
+            cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+            warehouses.append((cells, (r0 - 1, c0 - 1, r1 + 1, c1 + 1)))
