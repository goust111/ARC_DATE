+    """Compare two blocks under every row/column cyclic shift in block coordinates."""
+    if a.shape != b.shape:
+        return False
+    height, width = a.shape
+    return any(
+        np.array_equal(np.roll(a, shift=(dr, dc), axis=(0, 1)), b)
+        for dr in range(height)
+        for dc in range(width)
+    )
+
