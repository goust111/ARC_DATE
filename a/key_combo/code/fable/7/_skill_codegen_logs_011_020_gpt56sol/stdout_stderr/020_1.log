# Canvas, palette, and placement margins.
GEN_GRID_ROW_BOUNDS, GEN_GRID_COL_BOUNDS = (13, 15), (14, 15)
GEN_BG, GEN_NO_SHIFT, GEN_FG_BOUNDS = 0, 0, (1, 9)
GEN_VERTICAL_MARGIN, GEN_HORIZONTAL_MARGIN = 1, 2

# Lattice count, gap, and object-size bounds.
GEN_H_BAR_COUNTS, GEN_V_GROUP_COUNTS = range(2, 5), range(2, 4)
GEN_CELL_HEIGHTS, GEN_CELL_WIDTHS = range(2, 12), range(1, 5)
GEN_OBJECT_HEIGHT_MIN, GEN_OBJECT_HEIGHT_MAX = 7, 13
GEN_OBJECT_WIDTH_MIN, GEN_OBJECT_WIDTH_MAX = 5, 9
GEN_GROUP_WIDTH_PATTERNS = {2: ((1, 1),), 3: ((1, 1, 1), (1, 2, 1))}

# Validation and retry limits.
GEN_REQUIRED_COMPONENTS, GEN_MAX_ATTEMPTS = 1, 300


def _gen_shift_for_distance(distance_from_bottom):
    if distance_from_bottom % 2 == 0:
        return GEN_NO_SHIFT
    return -1 if (distance_from_bottom // 2) % 2 == 0 else 1


def _gen_horizontal_options(rows):
    by_count = {}
    for n_hbars in GEN_H_BAR_COUNTS:
        opts = []
        for cell_height in GEN_CELL_HEIGHTS:
            height = n_hbars + (n_hbars - 1) * cell_height
            if GEN_OBJECT_HEIGHT_MIN <= height <= GEN_OBJECT_HEIGHT_MAX and height <= rows - 2 * GEN_VERTICAL_MARGIN:
                opts.append((cell_height, height))
        if opts:
            by_count[n_hbars] = opts
    return by_count


def _gen_vertical_options(cols):
    by_count = {}
    for n_vgroups in GEN_V_GROUP_COUNTS:
        opts = []
        for cell_width in GEN_CELL_WIDTHS:
            for group_widths in GEN_GROUP_WIDTH_PATTERNS[n_vgroups]:
                width = sum(group_widths) + (n_vgroups - 1) * cell_width
                if GEN_OBJECT_WIDTH_MIN <= width <= GEN_OBJECT_WIDTH_MAX and width <= cols - 2 * GEN_HORIZONTAL_MARGIN:
                    opts.append((cell_width, width, group_widths))
        if opts:
            by_count[n_vgroups] = opts
    return by_count


def _gen_lattice_params(rows, cols):
    """Choose one valid lattice geometry for the selected canvas size."""
    horizontal_options = _gen_horizontal_options(rows)
    vertical_options = _gen_vertical_options(cols)
    if not horizontal_options or not vertical_options: return None

    n_hbars = random.choice(list(horizontal_options))
    cell_height, height = random.choice(horizontal_options[n_hbars])

    n_vgroups = random.choice(list(vertical_options))
    cell_width, width, group_widths = random.choice(vertical_options[n_vgroups])

    return height, width, cell_height, cell_width, group_widths


def _gen_lattice(height, width, cell_height, group_widths, cell_width, fg):
    patch = np.zeros((height, width), dtype=int)

    patch[:: cell_height + 1, :] = fg

    c = 0
    for group_width in group_widths:
        patch[:, c : c + group_width] = fg
        c += group_width + cell_width

    return patch


def _gen_apply_wave(grid):
    mask = grid != GEN_BG
    box = bbox(mask)
    if box is None: return None

    r0, _, r1, _ = box
    fg = int(grid[mask][0])
    out = grid.copy()

    for r in range(r0, r1 + 1):
        cols = np.flatnonzero(mask[r])
        if cols.size == 0: return None
        shift = _gen_shift_for_distance(r1 - r)
        if shift == 0:
            continue
        new_cols = cols + shift
        if int(new_cols.min()) < 0 or int(new_cols.max()) >= grid.shape[1]: return None
        out[r, cols] = GEN_BG
        if not np.all(out[r, new_cols] == GEN_BG): return None
        out[r, new_cols] = fg

    return out


def _gen_place_lattice(rows, cols, patch):
    grid = np.zeros((rows, cols), dtype=int)
    height, width = patch.shape

    r0 = random.randint(GEN_VERTICAL_MARGIN, rows - height - GEN_VERTICAL_MARGIN)
    c0 = random.randint(GEN_HORIZONTAL_MARGIN, cols - width - GEN_HORIZONTAL_MARGIN)
    paste(grid, patch, r0, c0, transparent=GEN_BG)
    return grid


def _gen_matches_oracle(grid):
    """Return True when the constructed input satisfies the solver's wave rule."""
    if len(components_mask(grid != GEN_BG, connectivity=4)) != GEN_REQUIRED_COMPONENTS:
        return False

    expected = _gen_apply_wave(grid)
    if expected is None: return False

    try:
        return np.array_equal(main(grid), expected)
    except Exception:
        return False


def _gen_attempt():
    rows = random.randint(*GEN_GRID_ROW_BOUNDS)
    cols = random.randint(*GEN_GRID_COL_BOUNDS)
    fg = random.randint(*GEN_FG_BOUNDS)
    params = _gen_lattice_params(rows, cols)
    if params is None: return None

    height, width, cell_height, cell_width, group_widths = params
    patch = _gen_lattice(height, width, cell_height, group_widths, cell_width, fg)
    grid = _gen_place_lattice(rows, cols, patch)

    if not _gen_matches_oracle(grid):
        return None

    return grid


def generate_input():
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 1c56ad9f input")
from __future__ import annotations

from collections import Counter

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg
import random


def _unique_divider_color(g: np.ndarray, bg: int) -> int:
    counts = Counter(map(int, g.ravel()))
    foreground = [color for color in counts if color != bg]
    assert foreground, "expected non-background divider and legend colors"
    max_count = max(counts[color] for color in foreground)
    candidates = [color for color in foreground if counts[color] == max_count]
    assert len(candidates) == 1, "expected a unique most common non-background divider color"
    return int(candidates[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor the data pixels in each quadrant using the matching entry of the 2x2 legend.

    Input structure:
    - The grid has a dominant background, a thick divider color, one 2x2 corner legend,
      and an opposite rectangular data region.
    - The data region contains background plus one foreground data color.

    Rule:
    - Split the data region into four equal quadrants.
    - For every data-colored pixel, replace it with the color in the same top/bottom and
      left/right position of the 2x2 legend.
    - Keep the background, divider, and legend unchanged.

    Key insight:
    - The 2x2 legend is not moved or copied as a shape; its cells are a quadrant color
      key for the separated data field.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    h, w = g.shape

    bg = get_bg(g)
    divider = _unique_divider_color(g, bg)

    non_field_mask = (g != bg) & (g != divider)
    legend_boxes = []
    for coords in components_mask(non_field_mask, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(coords)
        is_corner = (r0 == 0 or r1 == h - 1) and (c0 == 0 or c1 == w - 1)
        if coords.shape[0] == 4 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2) and is_corner:
            legend_boxes.append((r0, c0, r1, c1))
    assert len(legend_boxes) == 1, "expected exactly one 2x2 legend"
    lr0, lc0, lr1, lc1 = legend_boxes[0]
    legend = g[lr0 : lr1 + 1, lc0 : lc1 + 1]
    assert np.all((legend != bg) & (legend != divider)), "legend should contain only paint colors"

    at_top = lr0 == 0
    at_bottom = lr1 == h - 1
    at_left = lc0 == 0
    at_right = lc1 == w - 1
    assert at_top != at_bottom and at_left != at_right, "legend must sit in one corner"

    data_r0, data_r1 = (lr1 + 1, h - 1) if at_top else (0, lr0 - 1)
    data_c0, data_c1 = (lc1 + 1, w - 1) if at_left else (0, lc0 - 1)
    assert data_r0 <= data_r1 and data_c0 <= data_c1, "expected a nonempty data region"

    assert np.all(g[lr0 : lr1 + 1, data_c0 : data_c1 + 1] == divider)
    assert np.all(g[data_r0 : data_r1 + 1, lc0 : lc1 + 1] == divider)

    data = g[data_r0 : data_r1 + 1, data_c0 : data_c1 + 1]
    data_colors = [int(color) for color in set(map(int, data.ravel())) if color != bg]
    assert len(data_colors) == 1, "data region should contain one foreground color"
    data_color = data_colors[0]
    assert data_color != divider, "divider should not appear inside the data region"

    data_h, data_w = data.shape
    assert data_h % 2 == 0 and data_w % 2 == 0, "data region must split into four equal quadrants"
    half_h, half_w = data_h // 2, data_w // 2

    out = g.copy()
    for qr in range(2):
        for qc in range(2):
            rs = slice(data_r0 + qr * half_h, data_r0 + (qr + 1) * half_h)
            cs = slice(data_c0 + qc * half_w, data_c0 + (qc + 1) * half_w)
            mask = g[rs, cs] == data_color
            block = out[rs, cs]
            block[mask] = int(legend[qr, qc])
    return out

# --------------- generator (o5x) ---------------

GRID_SIZES = (10, 12, 14)
BACKGROUND_COLOR = 0
DIVIDER_COLOR = 8
PAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
LEGEND_SIZE = 2
QUADRANT_AXIS_COUNT = 2
QUADRANT_POSITIONS = ((0, 0), (0, 1), (1, 0), (1, 1))
LEGEND_CELL_COUNT = LEGEND_SIZE * LEGEND_SIZE
MIN_DENSITY_PERCENT = 6
MAX_DENSITY_PERCENT = 25
MIN_PIXELS_PER_QUADRANT = 1
MAX_PIXELS_PER_QUADRANT = 5
MAX_TOTAL_DATA_PIXELS = 20
GENERATION_RETRIES = 300


def _gen_regions(n: int, corner: int) -> tuple[slice, slice, slice, slice]:
    top = corner < QUADRANT_AXIS_COUNT
    left = corner % QUADRANT_AXIS_COUNT == 0
    legend_rs = slice(0, LEGEND_SIZE) if top else slice(n - LEGEND_SIZE, n)
    legend_cs = slice(0, LEGEND_SIZE) if left else slice(n - LEGEND_SIZE, n)
    data_rs = slice(LEGEND_SIZE, n) if top else slice(0, n - LEGEND_SIZE)
    data_cs = slice(LEGEND_SIZE, n) if left else slice(0, n - LEGEND_SIZE)
    return legend_rs, legend_cs, data_rs, data_cs


def _gen_expected_output(inp: np.ndarray, legend: np.ndarray, data_color: int, data_rs: slice, data_cs: slice) -> np.ndarray:
    out = inp.copy()
    half_h = (data_rs.stop - data_rs.start) // QUADRANT_AXIS_COUNT
    half_w = (data_cs.stop - data_cs.start) // QUADRANT_AXIS_COUNT
    for qr, qc in QUADRANT_POSITIONS:
        rs = slice(data_rs.start + qr * half_h, data_rs.start + (qr + 1) * half_h)
        cs = slice(data_cs.start + qc * half_w, data_cs.start + (qc + 1) * half_w)
        block = out[rs, cs]
        block[block == data_color] = int(legend[qr, qc])
    return out


def _gen_quadrant_counts(data_area: int) -> list[int]:
    min_total = max(LEGEND_CELL_COUNT * MIN_PIXELS_PER_QUADRANT, (MIN_DENSITY_PERCENT * data_area + 99) // 100)
    max_total = min(MAX_TOTAL_DATA_PIXELS, (MAX_DENSITY_PERCENT * data_area) // 100)
    total = random.randint(min_total, max_total)
    counts = [MIN_PIXELS_PER_QUADRANT] * LEGEND_CELL_COUNT
    for _ in range(total - LEGEND_CELL_COUNT):
        choices = [i for i, count in enumerate(counts) if count < MAX_PIXELS_PER_QUADRANT]
        counts[random.choice(choices)] += 1
    random.shuffle(counts)
    return counts


def _paint_data_region(grid: np.ndarray, data_rs: slice, data_cs: slice, data_color: int) -> None:
    """Place data-color pixels in all quadrants while avoiding the outer data corner."""
    data_h = data_rs.stop - data_rs.start
    data_w = data_cs.stop - data_cs.start
    half_h = data_h // QUADRANT_AXIS_COUNT
    half_w = data_w // QUADRANT_AXIS_COUNT
    outer_r = 0 if data_rs.start == 0 else data_h - 1
    outer_c = 0 if data_cs.start == 0 else data_w - 1
    forbidden_corner_cell = (outer_r, outer_c)
    quadrant_counts = _gen_quadrant_counts(data_h * data_w)
    for q_index, (qr, qc) in enumerate(QUADRANT_POSITIONS):
        r0 = qr * half_h
        c0 = qc * half_w
        cells = [(r0 + dr, c0 + dc) for dr in range(half_h) for dc in range(half_w)]
        if forbidden_corner_cell in cells:
            cells.remove(forbidden_corner_cell)
        for rr, cc in random.sample(cells, quadrant_counts[q_index]):
            grid[data_rs.start + rr, data_cs.start + cc] = data_color


def _gen_attempt() -> np.ndarray | None:
    n = random.choice(GRID_SIZES)
    corner = random.randrange(LEGEND_CELL_COUNT)
    legend_rs, legend_cs, data_rs, data_cs = _gen_regions(n, corner)
    grid = np.full((n, n), BACKGROUND_COLOR, dtype=int)
    grid[legend_rs, data_cs] = DIVIDER_COLOR
    grid[data_rs, legend_cs] = DIVIDER_COLOR
    colors = random.sample(PAINT_COLORS, LEGEND_CELL_COUNT)
    legend = np.array(colors, dtype=int).reshape(LEGEND_SIZE, LEGEND_SIZE)
    data_color = random.choice(colors)
    grid[legend_rs, legend_cs] = legend

    _paint_data_region(grid, data_rs, data_cs, data_color)

    expected = _gen_expected_output(grid, legend, data_color, data_rs, data_cs)
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 58743b76 input")
from collections import Counter

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Copy the marked sprite window into the marked empty window, aligned by the shared marker.

    Input structure
    - The dominant color is the outer background.
    - There are exactly two solid rectangular non-background windows.
    - Each window has one pixel of a shared marker color; only one window also
      contains the sprite color(s).

    Rule
    - The marker-only window gives the output size and fill color.
    - Translate every non-fill pixel from the sprite window so the source marker
      lands on the destination marker.

    Key insight
    The two equal marker pixels define the offset; the output is cropped to the
    marker-only window, not to the sprite window.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    windows = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert len(windows) == 2

    regions = []
    for window in windows:
        r0, c0, r1, c1 = window["bbox"]
        region = g[r0 : r1 + 1, c0 : c1 + 1]
        assert int(window["area"]) == int(region.size)
        regions.append(region)

    colors = colors_present(g, exclude={bg})
    counts = Counter(map(int, g.ravel()))

    marker_candidates = [
        color
        for color in colors
        if counts[color] == len(regions)
        and all(np.count_nonzero(region == color) == 1 for region in regions)
    ]
    assert len(marker_candidates) == 1
    marker = marker_candidates[0]

    fill_candidates = [
        color
        for color in colors
        if color != marker and all(np.any(region == color) for region in regions)
    ]
    assert len(fill_candidates) == 1
    fill = fill_candidates[0]

    sprite_colors = [color for color in colors if color not in {fill, marker}]
    assert sprite_colors

    classified = []
    for region in regions:
        marker_coords = np.argwhere(region == marker)
        assert marker_coords.shape == (1, 2)
        has_sprite = any(np.any(region == color) for color in sprite_colors)
        classified.append((has_sprite, region, tuple(map(int, marker_coords[0]))))

    source = [item for item in classified if item[0]]
    destination = [item for item in classified if not item[0]]
    assert len(source) == 1
    assert len(destination) == 1

    _, src_region, src_marker = source[0]
    _, dst_region, dst_marker = destination[0]

    out = np.full(dst_region.shape, fill, dtype=int)
    dr = dst_marker[0] - src_marker[0]
    dc = dst_marker[1] - src_marker[1]

    for r, c in np.argwhere(src_region != fill):
        rr = int(r) + dr
        cc = int(c) + dc
        assert 0 <= rr < out.shape[0]
        assert 0 <= cc < out.shape[1]
        out[rr, cc] = src_region[r, c]

    return out

