codex
代码已写入目标路径。当前实现把“判定只看输入前景”落实为先统一计算全部落点、再绘制，因此新增描边不会错误阻挡后续滑块；生成器还强制覆盖就地落下、单/多格外推和越界舍弃，并用去掉障碍后的独立预期结果验证障碍步骤确实影响答案。现在开始运行规定自检。
exec
/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path(\"/home/lixinyu/snap/a/key_combo/code/fable/7/011/7.py\")
mod = SourceFileLoader(\"new_arc_task\", str(p)).load_module()
sigs = set()
shapes = set()
branch_totals = dict(immediate=0, slid=0, long_slide=0, discarded=0)
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f\"input grid exceeds 30x30: {inp.shape}\"
    assert out.ndim == 2 and max(out.shape) <= 30, f\"output grid exceeds 30x30: {out.shape}\"
    expected, records = mod._oracle(inp)
    assert np.array_equal(out, expected)
    assert np.array_equal(out[inp "'!= 0], inp[inp != 0])
    assert {1, 2, 5}.issubset(set(map(int, np.unique(inp))))
    assert {4, 8}.issubset(set(map(int, np.unique(out))))
    branch_totals['"'immediate'] += sum(bool(s) and d == 1 for _, d, s in records)
    branch_totals['slid'] += sum(bool(s) and d > 1 for _, d, s in records)
    branch_totals['long_slide'] += sum(bool(s) and d >= 3 for _, d, s in records)
    branch_totals['discarded'] += sum(not bool(s) for _, _, s in records)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    shapes.add(inp.shape)
print(\"variants\", len(sigs), \"shapes\", len(shapes), \"branches\", branch_totals)
assert len(sigs) >= 20
assert all(branch_totals.values())
