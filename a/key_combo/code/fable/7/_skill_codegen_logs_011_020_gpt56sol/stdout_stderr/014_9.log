from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste
import random

BBox = tuple[int, int, int, int]


def _intersects(a: BBox, b: BBox) -> bool:
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _solid_rectangles(g: np.ndarray, bg: int, color: int) -> list[dict]:
    rectangles: list[dict] = []
    for comp in find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        return_format="dict",
    ):
        h = bbox_h(comp["bbox"])
        w = bbox_w(comp["bbox"])
        if int(comp["area"]) > 1 and int(comp["area"]) == h * w:
            rectangles.append(comp)
    return rectangles


def _find_sprites(g: np.ndarray, bg: int) -> list[tuple[BBox, np.ndarray, int]]:
    sprites: list[tuple[BBox, np.ndarray, int]] = []
    for comp in find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=False,
        return_format="dict",
    ):
        b = comp["bbox"]
        if bbox_h(b) != 3 or bbox_w(b) != 3 or int(comp["area"]) != 9:
            continue

        patch = crop_bbox(g, b)
        border = np.ones((3, 3), dtype=bool)
        border[1, 1] = False
        border_colors = set(map(int, patch[border]))
        if len(border_colors) != 1:
            continue

        body = border_colors.pop()
        center = int(patch[1, 1])
        if body == bg or center == bg or body == center:
            continue
        sprites.append((b, patch, center))

    return sprites


def _direction_to_target(sprite: BBox, target: BBox) -> tuple[int, int]:
    r0, c0, r1, c1 = sprite
    tr0, tc0, tr1, tc1 = target
    row_overlap = not (r1 < tr0 or tr1 < r0)
    col_overlap = not (c1 < tc0 or tc1 < c0)

    directions: list[tuple[int, int]] = []
    if row_overlap and tc0 > c1:
        directions.append((0, 1))
    if row_overlap and tc1 < c0:
        directions.append((0, -1))
    if col_overlap and tr0 > r1:
        directions.append((1, 0))
    if col_overlap and tr1 < r0:
        directions.append((-1, 0))

    assert len(directions) == 1, "expected exactly one cardinal target direction"
    return directions[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.

    Input structure
    - The background is the dominant color.
    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.
    - For every control color, there is exactly one separate solid rectangular object of that color.

    Rule
    - Match each sprite to the unique solid rectangle whose color equals the sprite center.
    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.
    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.

    Key insight
    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h >= 3 and w >= 3

    bg = int(get_bg(g))
    sprites = _find_sprites(g, bg)
    assert sprites, "expected at least one 3x3 control-center sprite"

    out = g.copy()
    for sprite_bbox, patch, center in sprites:
        targets = _solid_rectangles(g, bg, center)
        assert len(targets) == 1, "each control color must have one solid rectangular target"
        target_bbox = targets[0]["bbox"]
        assert not _intersects(sprite_bbox, target_bbox), "sprite and target must start separate"

        dr, dc = _direction_to_target(sprite_bbox, target_bbox)
        r, c = sprite_bbox[0], sprite_bbox[1]

        while True:
            current_bbox = (r, c, r + 2, c + 2)
            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w
            paste(out, patch, r, c)

            if _intersects(current_bbox, target_bbox):
                break

            r += dr * 3
            c += dc * 3

    return out

# --------------- generator (att1) ---------------
# Canvas and colors.
BG_COLOR, COLOR_COUNT = 8, 10
GRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25

# Rectangles.
RECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4
RECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14
RECT_MARGIN, RECT_SPACING_PAD = 1, 5
RECT_PLACEMENT_ATTEMPTS = 50

# Sprites and paths.
SPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5
SPRITE_GAPS = [1, 4, 7, 10]
DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]

# Retry limits.
GENERATION_ATTEMPTS = 300


def _intersects_check(a, b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _has_bg_border(grid, sr, sc, bg):
    H, W = grid.shape
    for r in range(sr, sr + SPRITE_SIZE):
        for c in range(sc, sc + SPRITE_SIZE):
            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W:
                    if not (sr <= nr < sr + SPRITE_SIZE and sc <= nc < sc + SPRITE_SIZE):
                        if grid[nr, nc] != bg:
                            return False
    return True


def _sample_palette(bg):
    all_colors = [c for c in range(COLOR_COUNT) if c != bg]
    random.shuffle(all_colors)
    num_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)
    body_color = all_colors[0]
    target_colors = all_colors[1:1 + num_rects]
    return body_color, target_colors


def _rect_has_spacing(rect, rects, pad):
    r0, c0, r1, c1 = rect
    for rr0, rc0, rr1, rc1, _ in rects:
        if not (r1 + pad < rr0 or rr1 + pad < r0 or c1 + pad < rc0 or rc1 + pad < c0):
            return False
    return True


def _place_rectangles(grid, target_colors):
    H, W = grid.shape
    rects = []
    for color in target_colors:
        for _ in range(RECT_PLACEMENT_ATTEMPTS):
            rh = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, H - 4))
            rw = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, W - 4))
            r0 = random.randint(RECT_MARGIN, H - rh - RECT_MARGIN)
            c0 = random.randint(RECT_MARGIN, W - rw - RECT_MARGIN)
            r1 = r0 + rh - 1
            c1 = c0 + rw - 1
            if _rect_has_spacing((r0, c0, r1, c1), rects, RECT_SPACING_PAD):
                rects.append((r0, c0, r1, c1, color))
                break
        else:
            return None
    for (r0, c0, r1, c1, color) in rects:
        grid[r0:r1 + 1, c0:c1 + 1] = color
    return rects


def _assign_sprites(rects):
    num_rects = len(rects)
    sprite_assignments = []
    for i, (_, _, _, _, color) in enumerate(rects):
        sprite_assignments.append((i, color))
    max_extra = min(SPRITE_TOTAL_MAX - len(sprite_assignments), num_rects)
    if max_extra > 0:
        extra = random.randint(0, max_extra)
        for _ in range(extra):
            i = random.randint(0, num_rects - 1)
            sprite_assignments.append((i, rects[i][4]))
    if len(sprite_assignments) > SPRITE_TOTAL_MAX:
        sprite_assignments = sprite_assignments[:SPRITE_TOTAL_MAX]
    return sprite_assignments


def _candidate_sprite_position(rect, direction, gap, H, W):
    r0, c0, r1, c1, _ = rect
    dr, dc = direction
    if dr == 0 and dc == 1:
        sc = c0 - gap - SPRITE_SIZE
        valid_rows = list(range(max(0, r0), min(H - SPRITE_SIZE, r1) + 1))
        if not valid_rows:
            return None
        sr = random.choice(valid_rows)
    elif dr == 0 and dc == -1:
        sc = c1 + gap + 1
        valid_rows = list(range(max(0, r0), min(H - SPRITE_SIZE, r1) + 1))
        if not valid_rows:
            return None
        sr = random.choice(valid_rows)
    elif dr == 1 and dc == 0:
        sr = r0 - gap - SPRITE_SIZE
        valid_cols = list(range(max(0, c0), min(W - SPRITE_SIZE, c1) + 1))
        if not valid_cols:
            return None
        sc = random.choice(valid_cols)
    else:
        sr = r1 + gap + 1
        valid_cols = list(range(max(0, c0), min(W - SPRITE_SIZE, c1) + 1))
        if not valid_cols:
            return None
        sc = random.choice(valid_cols)
    return sr, sc


def _sprite_in_bounds(sr, sc, H, W):
    return 0 <= sr and sr + SPRITE_SIZE <= H and 0 <= sc and sc + SPRITE_SIZE <= W


def _copy_positions_in_bounds(sr, sc, direction, copies, H, W):
    dr, dc = direction
    for step in range(1, copies + 1):
        nr = sr + dr * SPRITE_SIZE * step
        nc = sc + dc * SPRITE_SIZE * step
        if not _sprite_in_bounds(nr, nc, H, W):
            return False
    return True


def _corridor_clear(grid, sr, sc, direction, copies, bg):
    dr, dc = direction
    for step in range(1, copies):
        nr = sr + dr * SPRITE_SIZE * step
        nc = sc + dc * SPRITE_SIZE * step
        if not np.all(grid[nr:nr + SPRITE_SIZE, nc:nc + SPRITE_SIZE] == bg):
            return False
    return True


def _last_copy_is_valid(grid, sr, sc, direction, copies, rect, bg):
    r0, c0, r1, c1, _ = rect
    dr, dc = direction
    last_r = sr + dr * SPRITE_SIZE * copies
    last_c = sc + dc * SPRITE_SIZE * copies
    last_bbox = (last_r, last_c, last_r + SPRITE_SIZE - 1, last_c + SPRITE_SIZE - 1)
    if not _intersects_check(last_bbox, (r0, c0, r1, c1)):
        return False
    for rr in range(last_r, last_r + SPRITE_SIZE):
        for cc in range(last_c, last_c + SPRITE_SIZE):
            if not (r0 <= rr <= r1 and c0 <= cc <= c1) and grid[rr, cc] != bg:
                return False
    return True


def _overlaps_placed_sprite(sr, sc, placed_sprites):
    for ps_r, ps_c in placed_sprites:
        if not (sr + SPRITE_SIZE < ps_r or ps_r + SPRITE_SIZE < sr or sc + SPRITE_SIZE < ps_c or ps_c + SPRITE_SIZE < sc):
            return True
    return False


def _place_sprite(grid, sr, sc, body_color, center_color):
    patch = np.full((SPRITE_SIZE, SPRITE_SIZE), body_color, dtype=int)
    patch[SPRITE_SIZE // 2, SPRITE_SIZE // 2] = center_color
    grid[sr:sr + SPRITE_SIZE, sc:sc + SPRITE_SIZE] = patch


def _try_place_assigned_sprite(grid, rect, center_color, body_color, placed_sprites, bg):
    H, W = grid.shape
    directions = DIRECTIONS.copy()
    random.shuffle(directions)
    for direction in directions:
        gaps = SPRITE_GAPS.copy()
        random.shuffle(gaps)
        for gap in gaps:
            copies = gap // SPRITE_SIZE + 1
            pos = _candidate_sprite_position(rect, direction, gap, H, W)
            if pos is None:
                continue
            sr, sc = pos
            if not _sprite_in_bounds(sr, sc, H, W):
                continue
            if not _copy_positions_in_bounds(sr, sc, direction, copies, H, W):
                continue
            if not np.all(grid[sr:sr + SPRITE_SIZE, sc:sc + SPRITE_SIZE] == bg):
                continue
            if not _has_bg_border(grid, sr, sc, bg):
                continue
            if not _corridor_clear(grid, sr, sc, direction, copies, bg):
                continue
            if not _last_copy_is_valid(grid, sr, sc, direction, copies, rect, bg):
                continue
            if _overlaps_placed_sprite(sr, sc, placed_sprites):
                continue
            _place_sprite(grid, sr, sc, body_color, center_color)
            placed_sprites.append((sr, sc))
            return True
    return False


def _gen_attempt() -> np.ndarray | None:
    """Generate a single input grid for task 985ae207."""
    H = random.randint(GRID_MIN_SIZE, GRID_MAX_SIZE)
    W = random.randint(GRID_MIN_SIZE, GRID_MAX_SIZE)
    bg = BG_COLOR
    grid = np.full((H, W), bg, dtype=int)

    body_color, target_colors = _sample_palette(bg)
    rects = _place_rectangles(grid, target_colors)
    if rects is None:
        return None

    sprite_assignments = _assign_sprites(rects)
    placed_sprites = []
    for rect_idx, center_color in sprite_assignments:
        if not _try_place_assigned_sprite(grid, rects[rect_idx], center_color, body_color, placed_sprites, bg):
            return None

    try:
        main(grid)
    except Exception:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GENERATION_ATTEMPTS} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, in_bounds
import random


def _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    fg = colors_present(g, exclude={bg})
    assert len(fg) == 2, "expected exactly two foreground colors"

    counts = {color: int(np.count_nonzero(g == color)) for color in fg}
    marker_count = min(counts.values())
    body_count = max(counts.values())
    markers = [color for color, count in counts.items() if count == marker_count]
    bodies = [color for color, count in counts.items() if count == body_count]
    assert marker_count < body_count, "fracture marker color must be the minority foreground color"
    assert len(markers) == 1 and len(bodies) == 1, "foreground roles must be unique"
    return markers[0], bodies[0]


def _set_body(out: np.ndarray, r: int, c: int, color: int) -> None:
    assert in_bounds(out.shape, r, c), "shifted object pixel must stay in bounds"
    assert int(out[r, c]) != int(color), "shifted object pixels must not collide"
    out[r, c] = int(color)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Remove each fracture marker line and push the surrounding object pixels one cell away from it.

    Input structure
    - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.
    - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.

    Rule
    - Erase all marker pixels.
    - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.
    - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.

    Key insight
    - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    marker, body = _role_colors(g, bg)
    out = np.full_like(g, bg)

    objects = find_components(
        g,
        bg=bg,
        connectivity=8,
        monochromatic=False,
        colors=[marker, body],
    )
    assert objects, "expected at least one fractured object"

    for obj in objects:
        coords = obj["coords"]
        r0, c0, r1, c1 = obj["bbox"]
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        assert height != width, "fractured object bbox must determine an orientation"

        vals = g[coords[:, 0], coords[:, 1]]
        assert bool(np.any(vals == marker)), "each object must contain marker pixels"
        assert bool(np.any(vals == body)), "each object must contain body pixels"

        marker_coords = coords[vals == marker]
        if width > height:
            marker_by_row: dict[int, list[int]] = {}
            for r, c in marker_coords:
                marker_by_row.setdefault(int(r), []).append(int(c))
            assert set(marker_by_row) == set(range(r0, r1 + 1)), "wide object needs one marker in each row"
            assert all(len(cols) == 1 for cols in marker_by_row.values()), "wide object marker row must be unique"

            for r, c in coords[vals == body]:
                rr = int(r)
                cc = int(c)
                marker_c = marker_by_row[rr][0]
                assert cc != marker_c, "body pixel cannot occupy the marker column"
                shifted_c = cc - 1 if cc < marker_c else cc + 1
                _set_body(out, rr, shifted_c, body)
        else:
            marker_by_col: dict[int, list[int]] = {}
            for r, c in marker_coords:
                marker_by_col.setdefault(int(c), []).append(int(r))
            assert set(marker_by_col) == set(range(c0, c1 + 1)), "tall object needs one marker in each column"
            assert all(len(rows) == 1 for rows in marker_by_col.values()), "tall object marker column must be unique"

            for r, c in coords[vals == body]:
                rr = int(r)
                cc = int(c)
                marker_r = marker_by_col[cc][0]
                assert rr != marker_r, "body pixel cannot occupy the marker row"
                shifted_r = rr - 1 if rr < marker_r else rr + 1
                _set_body(out, shifted_r, cc, body)

    return out

# --------------- generator (o5x) ---------------

# Canvas, palette, and retry budget.
BACKGROUND_COLOR = 0
FOREGROUND_COLORS = tuple(range(1, 10))
MAX_GRID_SIZE = 19
MIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)
GENERATION_RETRIES = 300

# Object counts, dimensions, and orientations.
MIN_OBJECT_COUNT = 1
MAX_OBJECT_COUNT = 7
SHORT_SIDE_SIZES = (2, 3, 4, 5, 6)
LONG_SIDE_FACTOR = 2
WIDE = "wide"
TALL = "tall"
ORIENTATIONS = [WIDE, TALL]

# Dense layouts try smaller rectangles first while preserving random tie order.
DENSE_COUNT_THRESHOLD = 6
DENSE_PREFERRED_MAX_SHORT_SIDE = 3
PACKED_COUNT_THRESHOLD = 4
PACKED_PREFERRED_MAX_SHORT_SIDE = 4

# Placement and retry constraints.
SHIFT_PADDING = 1
MIN_CHEB_GAP = 2

BBox = tuple[int, int, int, int]
Location = tuple[int, int]
ObjectSpec = tuple[int, int, int, str]


def _interval_sep(a0: int, a1: int, b0: int, b1: int) -> int:
    if a1 < b0:
        return b0 - a1
    if b1 < a0:
        return a0 - b1
    return 0


def _cheb_gap_at_least_2(a: BBox, b: BBox) -> bool:
    dr = _interval_sep(a[0], a[2], b[0], b[2])
    dc = _interval_sep(a[1], a[3], b[1], b[3])
    return max(dr, dc) >= MIN_CHEB_GAP


def _overlap(a: BBox, b: BBox) -> bool:
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _expanded_bbox(r: int, c: int, h: int, w: int) -> BBox:
    if w > h:
        return r, c - SHIFT_PADDING, r + h - 1, c + w - 1 + SHIFT_PADDING
    return r - SHIFT_PADDING, c, r + h - 1 + SHIFT_PADDING, c + w - 1


def _object_dims(short_side: int, orient: str) -> tuple[int, int]:
    if orient == WIDE:
        return short_side, LONG_SIDE_FACTOR * short_side
    return LONG_SIDE_FACTOR * short_side, short_side


def _locations(n: int, h: int, w: int, originals: list[BBox], expanded: list[BBox]) -> list[Location]:
    if w > h:
        row_range = range(0, n - h + 1)
        col_range = range(SHIFT_PADDING, n - w - SHIFT_PADDING + 1)
    else:
        row_range = range(SHIFT_PADDING, n - h - SHIFT_PADDING + 1)
        col_range = range(0, n - w + 1)

    locs: list[Location] = []
    for r in row_range:
        for c in col_range:
            orig = (r, c, r + h - 1, c + w - 1)
            exp = _expanded_bbox(r, c, h, w)
            if any(not _cheb_gap_at_least_2(orig, old) for old in originals):
                continue
            if any(_overlap(exp, old) for old in expanded):
                continue
            locs.append((r, c))
    random.shuffle(locs)
    return locs


def _draw_object(grid: np.ndarray, expected: np.ndarray, r: int, c: int, s: int, orient: str, body: int, marker: int) -> None:
    h, w = _object_dims(s, orient)
    grid[r : r + h, c : c + w] = body
    bits = [0, 1] + [random.randrange(2) for _ in range(s - 2)]
    random.shuffle(bits)

    if orient == WIDE:
        rows = r + np.arange(s)
        marker_cols = c + s - 1 + np.asarray(bits)
        grid[rows, marker_cols] = marker
        for row, marker_c in zip(rows, marker_cols):
            expected[row, c - SHIFT_PADDING : marker_c - SHIFT_PADDING] = body
            expected[row, marker_c + SHIFT_PADDING + 1 : c + w + SHIFT_PADDING] = body
    else:
        cols = c + np.arange(s)
        marker_rows = r + s - 1 + np.asarray(bits)
        grid[marker_rows, cols] = marker
        for col, marker_r in zip(cols, marker_rows):
            expected[r - SHIFT_PADDING : marker_r - SHIFT_PADDING, col] = body
            expected[marker_r + SHIFT_PADDING + 1 : r + h + SHIFT_PADDING, col] = body


def _size_order(count: int) -> list[int]:
    sizes = list(SHORT_SIDE_SIZES)
    random.shuffle(sizes)
    if count >= DENSE_COUNT_THRESHOLD:
        return sorted(sizes, key=lambda s: (s > DENSE_PREFERRED_MAX_SHORT_SIDE, random.random()))
    if count >= PACKED_COUNT_THRESHOLD:
        return sorted(sizes, key=lambda s: (s > PACKED_PREFERRED_MAX_SHORT_SIDE, random.random()))
    return sizes


def _place_objects(n: int, count: int) -> list[ObjectSpec] | None:
    """Pick non-overlapping object specs; return None if this attempt cannot fit them."""
    originals: list[BBox] = []
    expanded: list[BBox] = []
    placed: list[ObjectSpec] = []

    for _ in range(count):
        choices: list[tuple[int, str, list[Location]]] = []
        for s in _size_order(count):
            for orient in random.sample(ORIENTATIONS, 2):
                h, w = _object_dims(s, orient)
                locs = _locations(n, h, w, originals, expanded)
                if locs:
                    choices.append((s, orient, locs))
        if not choices:
            return None

        s, orient, locs = random.choice(choices)
        r, c = random.choice(locs)
        h, w = _object_dims(s, orient)
        originals.append((r, c, r + h - 1, c + w - 1))
        expanded.append(_expanded_bbox(r, c, h, w))
        placed.append((r, c, s, orient))

    return placed


def _gen_attempt() -> np.ndarray | None:
    count = random.randint(MIN_OBJECT_COUNT, MAX_OBJECT_COUNT)
    n = random.randint(MIN_GRID_SIZE_BY_COUNT[count], MAX_GRID_SIZE)

    colors = list(FOREGROUND_COLORS)
    body = random.choice(colors)
    colors.remove(body)
    marker = random.choice(colors)

    placed = _place_objects(n, count)
    if placed is None:
        return None

    grid = np.full((n, n), BACKGROUND_COLOR, dtype=int)
    expected = np.full((n, n), BACKGROUND_COLOR, dtype=int)
    for r, c, s, orient in placed:
        _draw_object(grid, expected, r, c, s, orient, body, marker)

    try:
        out = main(grid)
    except Exception:
        return None
    if not np.array_equal(out, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

