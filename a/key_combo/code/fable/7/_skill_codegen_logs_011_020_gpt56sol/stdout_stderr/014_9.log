+    elif r == height - 1:
+        direction = (-1, 0)
+    elif c == 0:
+        direction = (0, 1)
+    else:
+        direction = (0, -1)
+    return (r, c), direction
+
+
+def _simulate(
+    shape: tuple[int, int],
+    obstacles: set[Coord],
+    start: Coord,
+    direction: Coord,
+    color_count: int,
