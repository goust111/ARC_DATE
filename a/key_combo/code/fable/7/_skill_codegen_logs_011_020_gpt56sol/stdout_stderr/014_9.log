+    """Return obstacle hits and boundary-hit count; stop when colors are exhausted."""
+    position = start
+    hits: list[Coord] = []
+    boundary_hits = 0
+    turn_index = 0
+    seen: set[tuple[Coord, Coord, int, int]] = set()
