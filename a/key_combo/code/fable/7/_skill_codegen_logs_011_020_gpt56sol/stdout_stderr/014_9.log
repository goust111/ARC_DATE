+
+BACKGROUND = 0
+OBSTACLE = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRECTIONS = ((-1, 0), (0, 1), (1, 0), (0, -1))
+GENERATION_ATTEMPTS = 600
