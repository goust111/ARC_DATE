+def _open_ray(shape: tuple[int, int], position: Coord, direction: Coord, obstacles: set[Coord]) -> tuple[list[Coord], Coord | None]:
+    """List free interior cells up to the nearest obstacle or perimeter wall."""
+    free: list[Coord] = []
