+def _is_edge(shape: tuple[int, int], r: int, c: int) -> bool:
+    """Use the shared ARC convention: shape=(rows, cols), coord=(r, c)."""
+    height, width = map(int, shape)
+    return r in (0, height - 1) or c in (0, width - 1)
