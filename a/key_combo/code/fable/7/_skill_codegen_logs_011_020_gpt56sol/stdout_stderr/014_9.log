+
+def _turn(direction: Coord, counterclockwise: bool) -> Coord:
+    """Rotate a screen-grid (dr, dc) vector by one quarter-turn."""
+    dr, dc = direction
+    return (-dc, dr) if counterclockwise else (dc, -dr)
