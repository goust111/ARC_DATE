+
+    occupied: set[tuple[int, int]] = set()
+    h, w = inp.shape
+    for i, sprite in enumerate(sprites):
+        if i == 0:
+            target = control
+        elif i < len(sprites) - 1:
+            target = sprites[i - 1]["marker"]
+        else:  # deliberately unmatched counterexample
