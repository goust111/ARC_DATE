+            r, c = q.popleft()
+            comp.add((r, c))
+            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if (0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1]
