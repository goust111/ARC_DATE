GEN_H_BAR_COUNTS, GEN_V_GROUP_COUNTS = range(2, 5), range(2, 4)
GEN_CELL_HEIGHTS, GEN_CELL_WIDTHS = range(2, 12), range(1, 5)
GEN_OBJECT_HEIGHT_MIN, GEN_OBJECT_HEIGHT_MAX = 7, 13
