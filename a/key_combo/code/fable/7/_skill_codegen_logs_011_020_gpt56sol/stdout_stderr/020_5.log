+
+
+def generate_input() -> np.ndarray:
+    """Generate varied, uniquely solvable exact-cover inventories."""
+    for _ in range(1200):
+        result = _attempt()
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a unique inventory-tiling puzzle")

