        rr0 = r0 + 1 + i
        cc0 = c0 + 1 + i
        rr1 = r1 - 1 - i
        cc1 = c1 - 1 - i
        if i == len(marker_colors) - 1:
            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = color
        else:
            out[rr0, cc0 : cc1 + 1] = color
