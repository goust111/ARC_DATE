+    colors = random.sample(PALETTE, len(boxes))
+    rectangles = [_Rectangle(color, box, miss) for color, box, miss in zip(colors, boxes, missing)]
+    residues: list[tuple[int, int, int]] = []
+    for rect in rectangles:
