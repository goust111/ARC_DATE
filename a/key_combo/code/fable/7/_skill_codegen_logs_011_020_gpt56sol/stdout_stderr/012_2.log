+@dataclass(frozen=True)
+class _Rectangle:
+    color: int
+    bbox: tuple[int, int, int, int]
+    missing: tuple[int, int] | None
+
+
+def _corners(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    return {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+
