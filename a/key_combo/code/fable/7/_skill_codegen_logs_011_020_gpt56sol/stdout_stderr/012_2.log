KEPT_OBJECT_COUNT = 3
MARKER_TOTAL_RANGE = (9, 14)
KEPT_MARKERS = (0, 1)
REMOVED_MARKERS = (2, 4)
FG_AREA_FACTORS = (5, 9)
FG_AREA_DIVISOR = 2

