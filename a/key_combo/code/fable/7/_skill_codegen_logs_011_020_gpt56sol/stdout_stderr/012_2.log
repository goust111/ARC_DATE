+def _corners(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    return {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+
+
+def _strictly_contains(box: tuple[int, int, int, int], point: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    r, c = point
+    return r0 < r < r1 and c0 < c < c1
