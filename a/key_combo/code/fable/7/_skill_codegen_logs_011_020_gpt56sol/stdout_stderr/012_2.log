+
+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 600
+
+
+@dataclass(frozen=True)
+class _Rectangle:
+    color: int
+    bbox: tuple[int, int, int, int]
+    missing: tuple[int, int] | None
+
