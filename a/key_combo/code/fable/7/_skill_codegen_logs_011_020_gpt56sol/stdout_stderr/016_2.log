+            w - 2 - position[1] if dc > 0 else position[1] - 1
+        )
+        min_dist = 5 if turn_index == 0 else 4
+        choices = list(range(min_dist, max_dist + 1))
+        random.shuffle(choices)
+        chosen = None
+        for dist in choices:
