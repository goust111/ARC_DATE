    hole_sizes = _gen_hole_sizes_from_coords(comps[0])
    return len(hole_sizes) == target_holes and all(
        _GEN_HOLE_AREA_MIN <= s <= _GEN_HOLE_AREA_MAX for s in hole_sizes
