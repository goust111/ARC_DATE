        for c in range(_GEN_CENTER_MARGIN, width - _GEN_CENTER_MARGIN):
            if c in occupied_cols:
                continue
            if any(max(abs(r - rr), abs(c - cc)) < _GEN_MARKER_SPAN for rr, cc in centers):
