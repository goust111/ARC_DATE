    return centers + [random.choice(choices)]


def _gen_raw_elbow():
    d0 = random.randint(_GEN_MIN_STEP, _GEN_MAX_STEP)
    d1 = random.randint(_GEN_MIN_STEP, _GEN_MAX_STEP)
