        return False
    area = int(np.sum(sprite == Color.TEAL))
    if not (_GEN_OBJECT_AREA_MIN <= area <= _GEN_OBJECT_AREA_MAX):
        return False
    comps = components_mask(sprite == Color.TEAL, connectivity=4)
    if len(comps) != 1:
