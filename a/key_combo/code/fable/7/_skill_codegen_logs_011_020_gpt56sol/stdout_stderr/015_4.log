def _gen_path_cells(edges):
    cells = set()
    for edge in edges:
        if edge[0] == "H":
            _, r, c0, c1, _ = edge
            gap = _gen_gap_slice(c0, c1)
            cells.update((r, c) for c in range(gap.start, gap.stop))
        else:
            _, c, r0, r1, _ = edge
            gap = _gen_gap_slice(r0, r1)
            cells.update((r, c) for r in range(gap.start, gap.stop))
    return cells


