import numpy as np

from arc_utils import colors_present, find_components, get_bg
import random


def _row_span_interior(g: np.ndarray, coords: np.ndarray, bg: int) -> tuple[tuple[int, int], ...]:
    occupied = {(int(r), int(c)) for r, c in coords}
    interior: list[tuple[int, int]] = []

    for r in sorted({r for r, _ in occupied}):
        cols = sorted(c for rr, c in occupied if rr == r)
        if len(cols) < 2:
            continue
        for c in range(cols[0] + 1, cols[-1]):
            if (r, c) in occupied:
                continue
            assert int(g[r, c]) == int(bg), "outline interior cells must be background"
            interior.append((r, c))

    return tuple(interior)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the source-color pixels into the unique outline interior whose size matches the source count.

    Input structure
    - The grid has a dominant background and exactly two foreground colors.
    - One foreground color forms 8-connected outline objects with row-wise interior cells.
    - The other foreground color supplies a set of source pixels away from the chosen outline.
    Rule
    - For each possible outline color, compute each 8-connected outline object's
      row-span interior: background pixels strictly between the leftmost and
      rightmost outline pixels on each occupied row.
    - Select the unique outline interior whose cell count equals the total
      number of pixels of the other foreground color.
    - Erase the source pixels and paint that matched interior with the source color.
    Key insight
    - The colors are roles, not fixed IDs: the source color is identified by
      counting, and the destination is the outline with a matching interior area.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected exactly two foreground colors"

    candidates: list[tuple[int, tuple[tuple[int, int], ...]]] = []
    for outline_color in colors:
        source_colors = [c for c in colors if c != outline_color]
        assert len(source_colors) == 1
        source_color = int(source_colors[0])
        source_count = int(np.count_nonzero(g == source_color))
        assert source_count > 0, "source color must be present"

        components = find_components(
            g,
            bg=bg,
            connectivity=8,
            monochromatic=True,
            colors=[outline_color],
        )
        assert components, "outline color must have at least one object"

        for component in components:
            interior = _row_span_interior(g, component["coords"], bg)
            if len(interior) == source_count:
                candidates.append((source_color, interior))

    assert len(candidates) == 1, "expected exactly one outline interior matching the source count"
    source_color, interior = candidates[0]

    out = g.copy()
    out[g == source_color] = int(bg)
    for r, c in interior:
        out[r, c] = source_color
    return out

# --------------- generator (att1) ---------------

# Canvas and palette bounds.
GRID_SIZE_RANGE = (13, 16)
ARC_COLOR_IDS = range(10)

# Outline shape constraints.
CAVITY_SIZE_POOL = range(1, 7)
SHAPE_PIXEL_BOUNDS = (3, 8)
SHAPE_HEIGHT_BOUNDS = (2, 3)
SHAPE_WIDTH_BOUNDS = (2, 5)
SHAPE_STRATEGIES = ("funnel", "U", "bridge")
SHAPE_RETRY_LIMIT = 200
FLIP_PROB = 0.5

# Strategy-specific shape knobs.
FUNNEL_TOP_GAP_MAX = 3
U_MAX_FACTOR_GAP = 4
U_ARM_HEIGHT_BOUNDS = (1, 2)
BRIDGE_ARM_GAP_RANGE = (1, 3)
BRIDGE_ARM_ROWS_RANGE = (1, 2)
BRIDGE_EXTEND_PROB = 0.3

# Placement and retry limits.
MAX_FOREGROUND_DENSITY = 0.10
OUTLINE_BBOX_GAP = 1
SOURCE_OUTLINE_PADDING = 3
PLACEMENT_RETRY_LIMIT = 100
GEN_ATTEMPT_LIMIT = 300


def _cavity_rows(pixels):
    rows = {}
    for r, c in pixels:
        rows.setdefault(r, []).append(c)
def _choose_canvas_and_palette():
    H = random.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])
    W = random.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])
    bg = random.randint(0, 9)
    fg = random.sample([c for c in ARC_COLOR_IDS if c != bg], 2)
    outline_color, source_color = fg
    return H, W, bg, outline_color, source_color


def _choose_outline_shapes():
    cavities = random.sample(CAVITY_SIZE_POOL, 2)
    s1, s2 = cavities

    shape1 = _build_outline_shape(s1)
    if shape1 is None:
        return None
    shape2 = _build_outline_shape(s2)
    if shape2 is None:
        return None

    matched_idx = random.choice([0, 1])
    source_count = [s1, s2][matched_idx]
    return shape1, shape2, matched_idx, source_count


def _bboxes_overlap_with_gap(b1, b2, gap):
    return (b1[0] - gap <= b2[2] + gap and b1[2] + gap >= b2[0] - gap and
            b1[1] - gap <= b2[3] + gap and b1[3] + gap >= b2[1] - gap)


def _place_outline_pair(H, W, shape1, shape2):
    sh1_h, sh1_w = _shape_dimensions(shape1)
    sh2_h, sh2_w = _shape_dimensions(shape2)

    for _ in range(PLACEMENT_RETRY_LIMIT):
        r1 = random.randint(0, H - sh1_h)
        c1 = random.randint(0, W - sh1_w)
        r2 = random.randint(0, H - sh2_h)
        c2 = random.randint(0, W - sh2_w)
        b1 = (r1, c1, r1 + sh1_h - 1, c1 + sh1_w - 1)
        b2 = (r2, c2, r2 + sh2_h - 1, c2 + sh2_w - 1)
        if _bboxes_overlap_with_gap(b1, b2, OUTLINE_BBOX_GAP):
            continue
        return (r1, c1, b1), (r2, c2, b2)
    return None


def _paint_cells(grid, cells, color):
    if not cells:
        return
    rr, cc = np.array(cells, dtype=int).T
    grid[rr, cc] = color


def _expanded_bbox(bbox, H, W, pad):
    return (max(0, bbox[0] - pad), max(0, bbox[1] - pad),
            min(H - 1, bbox[2] + pad), min(W - 1, bbox[3] + pad))


def _source_candidates(grid, bg, b1, b2):
    H, W = grid.shape
    ex1 = _expanded_bbox(b1, H, W, SOURCE_OUTLINE_PADDING)
    ex2 = _expanded_bbox(b2, H, W, SOURCE_OUTLINE_PADDING)
    return [(r, c) for r in range(H) for c in range(W)
            if grid[r, c] == bg
            and not (ex1[0] <= r <= ex1[2] and ex1[1] <= c <= ex1[3])
            and not (ex2[0] <= r <= ex2[2] and ex2[1] <= c <= ex2[3])]


def _oracle_checked_input(inp, output):
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        pass
    return None


def _gen_attempt():
    H, W, bg, outline_color, source_color = _choose_canvas_and_palette()
    outline_shapes = _choose_outline_shapes()
    if outline_shapes is None:
        return None
    shape1, shape2, matched_idx, source_count = outline_shapes

    if len(shape1) + len(shape2) + source_count > int(H * W * MAX_FOREGROUND_DENSITY):
        return None

    placement = _place_outline_pair(H, W, shape1, shape2)
    if placement is None:
        return None
    (r1, c1, b1), (r2, c2, b2) = placement

    pos1 = [(r + r1, c + c1) for r, c in shape1]
    pos2 = [(r + r2, c + c2) for r, c in shape2]
    grid = np.full((H, W), bg, dtype=int)
    _paint_cells(grid, pos1 + pos2, outline_color)

    output = grid.copy()
    cavity = _cavity_cells(pos1 if matched_idx == 0 else pos2)
    assert len(cavity) == source_count
    _paint_cells(output, cavity, source_color)

    valid = _source_candidates(grid, bg, b1, b2)
    if len(valid) < source_count:
        return None

    inp = grid.copy()
    _paint_cells(inp, random.sample(valid, source_count), source_color)

    return _oracle_checked_input(inp, output)


def generate_input():
    for _ in range(GEN_ATTEMPT_LIMIT):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_ATTEMPT_LIMIT} attempts")
from __future__ import annotations

import numpy as np
import random
from arc_utils import paste


def _bands(indices: np.ndarray) -> list[tuple[int, int]]:
    assert indices.size > 0, "expected at least one non-separator row/column"
    vals = [int(x) for x in indices]
    bands: list[tuple[int, int]] = []
    start = prev = vals[0]
    for x in vals[1:]:
        if x == prev + 1:
            prev = x
        else:
            bands.append((start, prev))
            start = prev = x
    bands.append((start, prev))
    return bands


def _separator_color(g: np.ndarray) -> int:
    candidates = []
    for color in np.unique(g):
        has_full_row = bool(np.any(np.all(g == int(color), axis=1)))
        has_full_col = bool(np.any(np.all(g == int(color), axis=0)))
        if has_full_row and has_full_col:
            candidates.append(int(color))
    assert len(candidates) == 1, f"expected unique row/column separator color, got {candidates}"
    return candidates[0]


def _base_and_motif_mask(panel: np.ndarray) -> tuple[int, np.ndarray]:
    colors, counts = np.unique(panel, return_counts=True)
    assert len(colors) == 2, f"expected a two-color panel, got {colors.tolist()}"
    max_count = int(counts.max())
    assert int(np.sum(counts == max_count)) == 1, "panel base color must be structurally unique"
    base = int(colors[int(np.argmax(counts))])
    return base, panel != base


def main(grid: np.ndarray) -> np.ndarray:
    """
    Within each horizontal pair of two-color panels, swap the motif masks and recolor each pasted mask with the source panel's base color.

    Input structure:
    - A separator color forms full blank rows and at least one full blank column.
    - The non-separator area is split into row bands, each containing exactly two same-shaped rectangular panels.
    - Each panel has a dominant base color and one minority motif color.

    Rule:
    - For every row band, clear each panel to its own base color.
    - Paste the right panel's motif mask into the left panel using the right base color.
    - Paste the left panel's motif mask into the right panel using the left base color.

    Key insight:
    - The motif colors themselves are distractors; only each motif's shape mask and the two panel base colors are exchanged.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "grid must be 2D"

    sep = _separator_color(g)
    row_bands = _bands(np.where(~np.all(g == sep, axis=1))[0])
    col_bands = _bands(np.where(~np.all(g == sep, axis=0))[0])
    assert len(col_bands) == 2, f"expected exactly two panel columns, got {len(col_bands)}"

    out = g.copy()
    (lc0, lc1), (rc0, rc1) = col_bands
    for r0, r1 in row_bands:
        left = g[r0 : r1 + 1, lc0 : lc1 + 1]
        right = g[r0 : r1 + 1, rc0 : rc1 + 1]
        assert left.shape == right.shape, "paired panels must have the same shape"

        left_base, left_motif = _base_and_motif_mask(left)
        right_base, right_motif = _base_and_motif_mask(right)

        new_left = np.full(left.shape, left_base, dtype=int)
        new_right = np.full(right.shape, right_base, dtype=int)
        new_left[right_motif] = right_base
        new_right[left_motif] = left_base

        out[r0 : r1 + 1, lc0 : lc1 + 1] = new_left
        out[r0 : r1 + 1, rc0 : rc1 + 1] = new_right

    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and separator geometry.
NUM_BANDS_MIN, NUM_BANDS_MAX = 2, 4
PANEL_H_MIN, PANEL_H_MAX = 6, 8
PANEL_W_MIN, PANEL_W_MAX = 7, 8
SEPARATOR_H = 2
SEPARATOR_W_MIN, SEPARATOR_W_MAX = 1, 2
MAX_GRID_SIZE = 30

# Motif size and component growth.
MOTIF_MARGIN = 1
MOTIF_FILL_MIN, MOTIF_FILL_MAX = 0.10, 0.30
MAX_MOTIF_COMPONENTS = 4
COMPONENT_WEIGHTS = (0.68, 0.16, 0.10, 0.06)
PART_MIN_SIZE, PART_WEIGHT_OFFSET = 2, 0.2

# Color sampling and retry limits.
PALETTE = tuple(range(1, 10))
SAME_BASE_PROB = 0.25
GENERATION_RETRIES = 300


def _random_motif_mask(h: int, w: int) -> np.ndarray | None:
    area = h * w
    lo = max(1, int(np.ceil(MOTIF_FILL_MIN * area)))
    hi = min((h - 2 * MOTIF_MARGIN) * (w - 2 * MOTIF_MARGIN), int(np.floor(MOTIF_FILL_MAX * area)))
    if lo > hi:
        return None
    target = random.randint(lo, hi)

    max_comp = min(MAX_MOTIF_COMPONENTS, target)
    n_comp = random.choices(range(1, max_comp + 1), weights=COMPONENT_WEIGHTS[:max_comp], k=1)[0]
    return _grow_mask(h, w, target, n_comp)


def _pair_colors() -> tuple[int, int, int, int]:
    colors = list(PALETTE)
    if random.random() < SAME_BASE_PROB:
        base = random.choice(colors)
        left_motif, right_motif = random.sample([c for c in colors if c != base], 2)
        return base, base, left_motif, right_motif
    left_base, right_base, left_motif, right_motif = random.sample(colors, 4)
    return left_base, right_base, left_motif, right_motif


def _choose_layout() -> tuple[int, int, int, int, int]:
    num_bands = random.randint(NUM_BANDS_MIN, NUM_BANDS_MAX)
    panel_h = random.choice([h for h in range(PANEL_H_MIN, PANEL_H_MAX + 1) if num_bands * h + SEPARATOR_H * (num_bands - 1) <= MAX_GRID_SIZE])
    panel_w = random.randint(PANEL_W_MIN, PANEL_W_MAX)
    sep_w = random.randint(SEPARATOR_W_MIN, SEPARATOR_W_MAX)
    return num_bands, panel_h, panel_w, SEPARATOR_H, sep_w


def _make_pair_panels(panel_h: int, panel_w: int) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray] | None:
    """Build the input and output panels for one paired row band."""
    left_base, right_base, left_motif_color, right_motif_color = _pair_colors()
    left_mask = _random_motif_mask(panel_h, panel_w)
    right_mask = _random_motif_mask(panel_h, panel_w)
    if left_mask is None or right_mask is None:
        return None

    in_left = np.full((panel_h, panel_w), left_base, dtype=int)
    in_right = np.full((panel_h, panel_w), right_base, dtype=int)
    out_left = np.full((panel_h, panel_w), left_base, dtype=int)
    out_right = np.full((panel_h, panel_w), right_base, dtype=int)
    in_left[left_mask] = left_motif_color
    in_right[right_mask] = right_motif_color
    out_left[right_mask] = right_base
    out_right[left_mask] = left_base
    return in_left, in_right, out_left, out_right


def _gen_attempt() -> np.ndarray | None:
    num_bands, panel_h, panel_w, sep_h, sep_w = _choose_layout()
    height = num_bands * panel_h + (num_bands - 1) * sep_h
    width = 2 * panel_w + sep_w
    inp = np.zeros((height, width), dtype=int)
    out = np.zeros((height, width), dtype=int)
    right_c0 = panel_w + sep_w

    for band in range(num_bands):
        r0 = band * (panel_h + sep_h)
        panels = _make_pair_panels(panel_h, panel_w)
        if panels is None:
            return None
        in_left, in_right, out_left, out_right = panels

        paste(inp, in_left, r0, 0)
        paste(inp, in_right, r0, right_c0)
        paste(out, out_left, r0, 0)
        paste(out, out_right, r0, right_c0)

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 5a719d11 input")
from __future__ import annotations

import numpy as np

from arc_utils import components_mask, get_bg
import random


def _color_counts(g: np.ndarray) -> dict[int, int]:
    vals, counts = np.unique(g, return_counts=True)
    return {int(v): int(n) for v, n in zip(vals, counts)}


def _roles(g: np.ndarray) -> tuple[int, int, int, int]:
    bg = get_bg(g)
    counts = _color_counts(g)
    colors = [c for c in counts if c != bg]
    assert len(colors) == 3, "expected wall, door, and marker colors"

    marker_colors = [c for c in colors if counts[c] == 2]
    assert len(marker_colors) == 1, "expected exactly two marker pixels"
    path_color = marker_colors[0]

    remaining = [c for c in colors if c != path_color]
    areas = {c: counts[c] for c in remaining}
    door_area = min(areas.values())
    wall_area = max(areas.values())
    door_colors = [c for c in remaining if counts[c] == door_area]
    wall_colors = [c for c in remaining if counts[c] == wall_area]
    assert len(door_colors) == 1 and len(wall_colors) == 1
    assert door_area < wall_area, "door color must be the smaller non-marker object set"
    return int(bg), int(path_color), int(door_colors[0]), int(wall_colors[0])


def _door_centers(g: np.ndarray, door_color: int) -> tuple[str, list[tuple[int, int]]]:
    comps = components_mask(g == int(door_color), connectivity=4)
    assert comps, "expected door segments"

    orientations: list[str] = []
    centers: list[tuple[int, int]] = []
    for coords in comps:
        assert coords.shape[0] == 3, "each door segment is three pixels long"
        r0, c0 = coords.min(axis=0)
        r1, c1 = coords.max(axis=0)
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        if height == 3 and width == 1:
            orientations.append("vertical")
            centers.append((int(r0 + 1), int(c0)))
        elif height == 1 and width == 3:
            orientations.append("horizontal")
            centers.append((int(r0), int(c0 + 1)))
        else:
            raise AssertionError("door segments must be straight length-3 bars")

    assert len(set(orientations)) == 1, "all doors must share an orientation"
    return orientations[0], centers


def _paint_segment(
    out: np.ndarray,
    start: tuple[int, int],
    end: tuple[int, int],
    color: int,
    allowed: set[int],
) -> None:
    r0, c0 = map(int, start)
    r1, c1 = map(int, end)
    assert r0 == r1 or c0 == c1, "path segments must be orthogonal"
    height, width = out.shape
    assert 0 <= r0 < height and 0 <= r1 < height
    assert 0 <= c0 < width and 0 <= c1 < width

    if r0 == r1:
        for c in range(min(c0, c1), max(c0, c1) + 1):
            assert int(out[r0, c]) in allowed, "path may only cover bg, doors, or markers"
            out[r0, c] = int(color)
    else:
        for r in range(min(r0, r1), max(r0, r1) + 1):
            assert int(out[r, c0]) in allowed, "path may only cover bg, doors, or markers"
            out[r, c0] = int(color)


def _markers(g: np.ndarray, path_color: int) -> list[tuple[int, int]]:
    coords = np.argwhere(g == int(path_color))
    assert coords.shape[0] == 2, "expected two marker pixels"
    return [tuple(map(int, coord)) for coord in coords]


def _solve_vertical_walls(
    g: np.ndarray,
    centers: list[tuple[int, int]],
    markers: list[tuple[int, int]],
    bg: int,
    path_color: int,
    door_color: int,
    wall_color: int,
) -> np.ndarray:
    out = g.copy()
    centers = sorted(centers, key=lambda p: p[1])
    wall_cols = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 1])))
    assert len(wall_cols) == len(centers), "each vertical wall must have one door"
    assert [c for _r, c in centers] == wall_cols
    for _r, c in centers:
        assert np.all(np.isin(g[:, c], [wall_color, door_color]))

    start, end = sorted(markers, key=lambda p: p[1])
    assert start[1] < centers[0][1] and end[1] > centers[-1][1]

    allowed = {int(bg), int(path_color), int(door_color)}
    cur = start
    for door_r, door_c in centers:
        approach = (cur[0], door_c - 1)
        _paint_segment(out, cur, approach, path_color, allowed)
        _paint_segment(out, approach, (door_r, door_c - 1), path_color, allowed)
        _paint_segment(out, (door_r, door_c - 1), (door_r, door_c), path_color, allowed)
        cur = (door_r, door_c)

    _paint_segment(out, cur, (cur[0], end[1]), path_color, allowed)
    _paint_segment(out, (cur[0], end[1]), end, path_color, allowed)
    return out


def _solve_horizontal_walls(
    g: np.ndarray,
    centers: list[tuple[int, int]],
    markers: list[tuple[int, int]],
    bg: int,
    path_color: int,
    door_color: int,
    wall_color: int,
) -> np.ndarray:
    out = g.copy()
    centers = sorted(centers, key=lambda p: p[0])
    wall_rows = sorted(set(map(int, np.argwhere(g == int(wall_color))[:, 0])))
    assert len(wall_rows) == len(centers), "each horizontal wall must have one door"
    assert [r for r, _c in centers] == wall_rows
    for r, _c in centers:
        assert np.all(np.isin(g[r, :], [wall_color, door_color]))

    start, end = sorted(markers, key=lambda p: p[0])
    assert start[0] < centers[0][0] and end[0] > centers[-1][0]

    allowed = {int(bg), int(path_color), int(door_color)}
    cur = start
    for door_r, door_c in centers:
        approach = (door_r - 1, cur[1])
        _paint_segment(out, cur, approach, path_color, allowed)
        _paint_segment(out, approach, (door_r - 1, door_c), path_color, allowed)
        _paint_segment(out, (door_r - 1, door_c), (door_r, door_c), path_color, allowed)
        cur = (door_r, door_c)

    _paint_segment(out, cur, (end[0], cur[1]), path_color, allowed)
    _paint_segment(out, (end[0], cur[1]), end, path_color, allowed)
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw the marker-colored route through the centers of all doors in the parallel wall maze.

    Input structure:
    - The grid has a background, parallel full-span walls, one three-pixel door
      segment in each wall, and two marker pixels sharing a color.
    - Walls are either all vertical or all horizontal, and the markers are on
      opposite outer sides of the wall set.

    Rule:
    - Keep the scene unchanged except for the route.
    - Visit the door centers in wall order from the upper/left marker side to
      the lower/right marker side.
    - In each corridor, draw an orthogonal path to the cell just before the next
      wall, move along that wall to the door center, cross the center, and
      continue to the next corridor; after the last door, connect to the other
      marker.

    Key insight:
    - The three-pixel door segments mark the only crossing points through a set
      of parallel walls, so the output is the corridor path threaded through
      those centers.
    """
    g = np.asarray(grid, dtype=int)
    bg, path_color, door_color, wall_color = _roles(g)
    orientation, centers = _door_centers(g, door_color)
    markers = _markers(g, path_color)

    if orientation == "vertical":
        return _solve_vertical_walls(g, centers, markers, bg, path_color, door_color, wall_color)
    assert orientation == "horizontal"
    return _solve_horizontal_walls(g, centers, markers, bg, path_color, door_color, wall_color)

# --------------- generator (att1) ---------------

# Canvas and color role sampling.
GRID_H = 30
GRID_W = 30
COLOR_POOL = range(10)
N_ROLE_COLORS = 4

# Parallel wall and door geometry.
ORIENTATIONS = ("vertical", "horizontal")
WALL_COUNT_RANGE = (3, 4)
WALL_POS_LO = 4
WALL_POS_HI_MARGIN = 5
WALL_MIN_GAP = 2
DOOR_CENTER_LO = 3
DOOR_CENTER_HI_MARGIN = 4

# Marker placement and retry budget.
MARKER_EDGE_RANGE = (1, 3)
MARKER_FREE_LO = 1
MARKER_FREE_HI_MARGIN = 2
GEN_RETRIES = 300


def _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:
    """Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions."""
    needed = n + (n - 1) * min_gap
    span = hi - lo + 1
    if span < needed:
        return None
    compressed_span = span - (n - 1) * min_gap
    picks = sorted(rng.sample(range(compressed_span), n))
    return [lo + picks[i] + i * min_gap for i in range(n)]


def _sample_wall_layout(orientation: str, n_walls: int, rng: random.Random):
    """Return wall positions and per-wall door centers for the chosen orientation."""
    wall_axis, door_axis = (GRID_W, GRID_H) if orientation == "vertical" else (GRID_H, GRID_W)
    walls = _place_positions(
        n_walls,
        lo=WALL_POS_LO,
        hi=wall_axis - WALL_POS_HI_MARGIN,
        min_gap=WALL_MIN_GAP,
        rng=rng,
    )
    if walls is None:
        return None
    doors = [rng.randint(DOOR_CENTER_LO, door_axis - DOOR_CENTER_HI_MARGIN) for _ in range(n_walls)]
    return walls, doors


def _sample_markers(orientation: str, rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]]:
    """Sample start/end markers on opposite outer corridors."""
    edge_lo, edge_hi = MARKER_EDGE_RANGE
    if orientation == "vertical":
        start_col = rng.randint(edge_lo, edge_hi)
        start_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
        end_col = rng.randint(GRID_W - edge_hi - 1, GRID_W - edge_lo - 1)
        end_row = rng.randint(MARKER_FREE_LO, GRID_H - MARKER_FREE_HI_MARGIN)
    else:
        start_row = rng.randint(edge_lo, edge_hi)
        start_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
        end_row = rng.randint(GRID_H - edge_hi - 1, GRID_H - edge_lo - 1)
        end_col = rng.randint(MARKER_FREE_LO, GRID_W - MARKER_FREE_HI_MARGIN)
    return (start_row, start_col), (end_row, end_col)


def _render_grid(
    orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end
) -> np.ndarray:
    """Render walls, doors, and the two markers into a fresh input grid."""
    grid = np.full((GRID_H, GRID_W), bg, dtype=int)
    if orientation == "vertical":
        for wall_col, door_row in zip(walls, doors):
            grid[:, wall_col] = wall_color
            grid[door_row - 1 : door_row + 2, wall_col] = door_color
    else:
        for wall_row, door_col in zip(walls, doors):
            grid[wall_row, :] = wall_color
            grid[wall_row, door_col - 1 : door_col + 2] = door_color

    grid[start] = marker_color
    grid[end] = marker_color
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = random.Random()
    bg, wall_color, door_color, marker_color = rng.sample(COLOR_POOL, N_ROLE_COLORS)
    orientation = rng.choice(ORIENTATIONS)
    n_walls = rng.randint(*WALL_COUNT_RANGE)

    layout = _sample_wall_layout(orientation, n_walls, rng)
    if layout is None:
        return None
    walls, doors = layout
    start, end = _sample_markers(orientation, rng)
    grid = _render_grid(orientation, bg, wall_color, door_color, marker_color, walls, doors, start, end)

    try:
        main(grid)
    except Exception:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")
from collections import Counter

import numpy as np

from arc_utils import bbox, crop_bbox, find_components, get_bg, is_contiguous, paste
import random
from itertools import combinations


def main(grid: np.ndarray) -> np.ndarray:
    """
    Crop the 4-connected foreground sprite whose colored pattern occurs only once among otherwise duplicated sprites.

    Input structure
    - The background is the dominant color.
    - Foreground pixels form several separated 4-connected sprites.
    - Every distractor sprite has an identical colored bounding-box crop elsewhere in the grid.

    Rule
    - Crop each 4-connected foreground sprite to its bounding box.
    - Compare the exact colored crops, including background pixels inside each crop.
    - Return the only crop whose exact pattern occurs once.

    Key insight
    - The answer is the outlier sprite by repetition count, not by position, color id, or size alone.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)

    assert len(objects) >= 2

    crops: list[tuple[tuple[tuple[int, ...], ...], np.ndarray]] = []
    for obj in objects:
        crop = crop_bbox(g, obj["bbox"])
        assert int(np.sum(crop != bg)) == int(obj["area"])
        signature = tuple(tuple(map(int, row)) for row in crop)
        crops.append((signature, crop))

    counts = Counter(signature for signature, _ in crops)
    assert len(counts) >= 2
    assert any(n > 1 for n in counts.values())

    unique_signatures = [signature for signature, n in counts.items() if n == 1]
    assert len(unique_signatures) == 1

    matches = [crop for signature, crop in crops if signature == unique_signatures[0]]
    assert len(matches) == 1
    return matches[0].copy()

# --------------- generator (o5x) ---------------

# Canvas and background bounds.
BG_COLOR = 0
CANVAS_MIN_SIZE = 11
CANVAS_MAX_SIZE = 13

# Sprite geometry bounds.
SPRITE_MIN_HEIGHT = 1
SPRITE_MAX_HEIGHT = 5
SPRITE_MIN_WIDTH = 1
SPRITE_MAX_WIDTH = 3
SPRITE_MIN_AREA = 3
SPRITE_MAX_AREA = 6

# Palette and color assignment.
FOREGROUND_COLOR_MIN = 1
FOREGROUND_COLOR_MAX = 9
PALETTE_SIZE_CHOICES = (3, 4)
BASE_SPRITE_COUNT = 3
MAX_COLORS_PER_SPRITE = 2
EXTRA_COLOR_PROB = 0.45

# Two duplicate pairs plus the singleton in base sprite order.
SPRITE_COPY_PATTERN = (0, 0, 1, 1, 2)

# Mask selection and placement behavior.
MASK_FILTER_MODES = ("height", "width", "area", "free")
PLACEMENT_PADDING = 1
INTERIOR_PLACEMENT_FIRST_PROB = 0.65

# Retry budget.
MAX_GENERATION_ATTEMPTS = 300


def _gen_cd3c21df_mask_catalog() -> dict[tuple[int, int, int], list[np.ndarray]]:
    catalog: dict[tuple[int, int, int], list[np.ndarray]] = {}
    for h in range(SPRITE_MIN_HEIGHT, SPRITE_MAX_HEIGHT + 1):
        for w in range(SPRITE_MIN_WIDTH, SPRITE_MAX_WIDTH + 1):
            cells = h * w
def _gen_cd3c21df_choose_mask() -> np.ndarray:
    mode = random.choice(MASK_FILTER_MODES)
    if mode == "height":
        h = random.randint(SPRITE_MIN_HEIGHT, SPRITE_MAX_HEIGHT)
        keys = [key for key in _GEN_CD3C21DF_KEYS if key[0] == h]
    elif mode == "width":
        w = random.randint(SPRITE_MIN_WIDTH, SPRITE_MAX_WIDTH)
        keys = [key for key in _GEN_CD3C21DF_KEYS if key[1] == w]
    elif mode == "area":
        area = random.randint(SPRITE_MIN_AREA, SPRITE_MAX_AREA)
        keys = [key for key in _GEN_CD3C21DF_KEYS if key[2] == area]
    else:
        keys = _GEN_CD3C21DF_KEYS
    key = random.choice(keys)
    return random.choice(_GEN_CD3C21DF_MASKS[key]).copy()


def _gen_cd3c21df_color_sets(palette: list[int]) -> list[tuple[int, ...]]:
    colors = palette[:]
    random.shuffle(colors)
    sets = [{colors[i]} for i in range(BASE_SPRITE_COUNT)]
    for color in colors[BASE_SPRITE_COUNT:]:
        choices = [i for i, s in enumerate(sets) if len(s) < MAX_COLORS_PER_SPRITE]
        sets[random.choice(choices)].add(color)
    for s in sets:
        if len(s) < MAX_COLORS_PER_SPRITE and random.random() < EXTRA_COLOR_PROB:
            choices = [color for color in palette if color not in s]
            if choices:
                s.add(random.choice(choices))
    random.shuffle(sets)
    return [tuple(sorted(s)) for s in sets]


def _gen_cd3c21df_colorize(mask: np.ndarray, colors: tuple[int, ...]) -> np.ndarray:
    sprite = np.zeros(mask.shape, dtype=int)
    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
    cols = list(colors)
    random.shuffle(cols)
    if len(cols) == 1:
        sprite[mask] = cols[0]
        return sprite

    random.shuffle(coords)
    split = random.randint(1, len(coords) - 1)
    first = np.array(coords[:split], dtype=int)
    second = np.array(coords[split:], dtype=int)
    sprite[first[:, 0], first[:, 1]] = cols[0]
    sprite[second[:, 0], second[:, 1]] = cols[1]
    return sprite


def _gen_cd3c21df_signature(sprite: np.ndarray) -> tuple[tuple[int, ...], ...]:
    return tuple(tuple(map(int, row)) for row in sprite)


def _gen_cd3c21df_locations(reserved: np.ndarray, sprite_shape: tuple[int, int]) -> list[tuple[int, int]]:
    h, w = sprite_shape
    H, W = reserved.shape
    locs: list[tuple[int, int]] = []
    for r in range(H - h + 1):
        for c in range(W - w + 1):
            r0 = max(0, r - PLACEMENT_PADDING)
            c0 = max(0, c - PLACEMENT_PADDING)
            r1 = min(H, r + h + PLACEMENT_PADDING)
            c1 = min(W, c + w + PLACEMENT_PADDING)
            if not bool(reserved[r0:r1, c0:c1].any()):
                locs.append((r, c))
    random.shuffle(locs)
    if random.random() < INTERIOR_PLACEMENT_FIRST_PROB:
        locs.sort(key=lambda rc: 0 if 0 < rc[0] and 0 < rc[1] and rc[0] + h < H and rc[1] + w < W else 1)
    return locs


def _gen_cd3c21df_place_sprites(H: int, W: int, sprites: list[np.ndarray]) -> np.ndarray | None:
    reserved = np.zeros((H, W), dtype=int)
    locations: list[tuple[int, int] | None] = [None] * len(sprites)
    order = list(range(len(sprites)))
    random.shuffle(order)
    order.sort(key=lambda i: sprites[i].shape[0] * sprites[i].shape[1], reverse=True)

    def place_at(k: int) -> bool:
        if k == len(order):
            return True
        idx = order[k]
        sprite = sprites[idx]
        h, w = sprite.shape
        for r, c in _gen_cd3c21df_locations(reserved, (h, w)):
            reserved[r : r + h, c : c + w] = 1
            locations[idx] = (r, c)
            if place_at(k + 1):
                return True
            locations[idx] = None
            reserved[r : r + h, c : c + w] = 0
        return False

    if not place_at(0):
        return None

    grid = np.zeros((H, W), dtype=int)
    for sprite, loc in zip(sprites, locations):
        assert loc is not None
        paste(grid, sprite, loc[0], loc[1], transparent=BG_COLOR)
    return grid


def _gen_cd3c21df_make_base_sprites(color_sets: list[tuple[int, ...]]) -> list[np.ndarray] | None:
    base_sprites: list[np.ndarray] = []
    signatures: set[tuple[tuple[int, ...], ...]] = set()
    for colors in color_sets:
        sprite = _gen_cd3c21df_colorize(_gen_cd3c21df_choose_mask(), colors)
        sig = _gen_cd3c21df_signature(sprite)
        if sig in signatures:
            return None
        signatures.add(sig)
        base_sprites.append(sprite)
    return base_sprites


def _gen_cd3c21df_passes_oracle(grid: np.ndarray, singleton: np.ndarray) -> bool:
    try:
        actual = main(grid)
    except Exception:
        return False
    return np.array_equal(actual, singleton)


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(CANVAS_MIN_SIZE, CANVAS_MAX_SIZE)
    W = random.randint(CANVAS_MIN_SIZE, CANVAS_MAX_SIZE)
    palette = random.sample(range(FOREGROUND_COLOR_MIN, FOREGROUND_COLOR_MAX + 1), random.choice(PALETTE_SIZE_CHOICES))
    color_sets = _gen_cd3c21df_color_sets(palette)

    base_sprites = _gen_cd3c21df_make_base_sprites(color_sets)
    if base_sprites is None:
        return None

    sprites = [base_sprites[i] for i in SPRITE_COPY_PATTERN]
    random.shuffle(sprites)

    grid = _gen_cd3c21df_place_sprites(H, W, sprites)
    if grid is None or not _gen_cd3c21df_passes_oracle(grid, base_sprites[SPRITE_COPY_PATTERN[-1]]):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("generate_input failed for cd3c21df")

