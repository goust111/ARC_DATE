from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path(\"/home/lixinyu/snap/a/key_combo/code/fable/7/018/3.py\")
mod = SourceFileLoader(\"new_arc_task\", str(p)).load_module()
sigs = set()
out_sigs = set()
scale_counts = {}
ambiguity_counts = {}
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f\"input grid exceeds 30x30: {inp.shape}\"
    assert out.ndim == 2 and max(out.shape) <= 30, f\"output grid exceeds 30x30: {out.shape}\"
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    bg = mod._unique_background(inp)
    n = len(set(map(int, np.unique(inp))) - {bg})
    scales = mod._valid_uniform_scales(inp)
    scale_counts[n] = scale_counts.get(n, 0) + 1
    q = max(scales) // n
    ambiguity_counts[q] = ambiguity_counts.get(q, 0) + 1
    assert n in scales and max(scales) > n
    assert not np.array_equal(mod._compress_uniform_blocks(inp, max(scales)), out)
print(\"variants\", len(sigs))
print(\"output variants\", len(out_sigs))
print(\"encoded scales\", scale_counts)
print(\"ambiguity factors\", ambiguity_counts)
assert len(sigs) >= 20
assert len(out_sigs) == 100
assert set(scale_counts) == {2, 3, 4}
assert set(ambiguity_counts) == {2, 3}
