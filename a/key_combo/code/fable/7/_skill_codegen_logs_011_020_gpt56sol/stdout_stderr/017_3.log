+            if index == 0 and _ray_capacity(box, aggregate_q, (H, W)) < objects[0]["lengths"][aggregate_q]:
+                continue
+            placed = box
+            break
+        if placed is None:
+            return None
+        obj["box"] = placed
+        boxes.append(placed)
