+    return mask, holes
+
+
+def _ray_capacity(box, quadrant: str, shape: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    return {
+        "TL": min(r0, c0),
+        "TR": min(r0, w - 1 - c1),
+        "BL": min(h - 1 - r1, c0),
+        "BR": min(h - 1 - r1, w - 1 - c1),
+    }[quadrant]
+
+
+def _box_at_corner(quadrant: str, h: int, w: int, H: int, W: int):
+    r0 = 1 if quadrant[0] == "T" else H - h - 1
+    c0 = 1 if quadrant[1] == "L" else W - w - 1
+    return r0, c0
+
+
