+    r0, c0, r1, c1 = box
+    for a0, b0, a1, b1 in boxes:
+        if not (r1 + 1 < a0 or a1 + 1 < r0 or c1 + 1 < b0 or b1 + 1 < c0):
+            return False
+    return True
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray, list[dict], bool] | None:
