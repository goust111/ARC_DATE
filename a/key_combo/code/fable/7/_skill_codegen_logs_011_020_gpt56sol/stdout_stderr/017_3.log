    cc2 = cc + dc
    inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
    out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
    return out


def collision(
    *,
    object1: np.ndarray,
    object2: np.ndarray,
