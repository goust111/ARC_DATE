+    found = _sprites(grid, 0)
+    if len(found) != len(objects) or len({x[0] for x in found}) != len(objects):
+        return False
+    by_color = {x[0]: x for x in found}
+    all_q = set()
+    local_vs_global = False
+    wrong_count = grid.copy()
+    for obj in objects:
+        color = obj["color"]
