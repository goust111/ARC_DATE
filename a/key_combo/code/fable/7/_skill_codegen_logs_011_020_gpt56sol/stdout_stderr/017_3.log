+    plans = [[(aggregate_q, 1), (aggregate_q, 2), (other_q, random.randint(2, 4))]]
+
+    remaining = [q for q in QUADRANTS if q not in {aggregate_q, other_q}]
+    q1 = random.choice(remaining)
+    q2 = random.choice([q for q in QUADRANTS if q != q1])
