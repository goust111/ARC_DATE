+    macro = np.full((len(row_intervals), len(col_intervals)), -1, dtype=int)
+    known = np.zeros_like(macro, dtype=bool)
+    for br, (r0, r1) in enumerate(row_intervals):
+        for bc, (c0, c1) in enumerate(col_intervals):
+            block = g[r0:r1, c0:c1]
+            if np.all(block == ERASED):
