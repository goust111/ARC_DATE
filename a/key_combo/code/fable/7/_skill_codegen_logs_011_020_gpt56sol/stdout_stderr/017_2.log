+    least = [(pr, pc, tile) for pr, pc, tile in candidates if pr * pc == least_area]
+    assert len(least) == 1, "the visible evidence does not determine a unique smallest period"
+    pr, pc, tile = least[0]
+    return tile, pr, pc
