+    assert nearby
+    unique = random.choice(nearby)
+
+    palette = [c for c in range(10) if c not in (bg, GREY)]
+    rng.shuffle(palette)
+    needed = 3 + (len(points) - 4 + 1) // 2
+    assert needed <= len(palette)
+    colors = palette[:needed]
