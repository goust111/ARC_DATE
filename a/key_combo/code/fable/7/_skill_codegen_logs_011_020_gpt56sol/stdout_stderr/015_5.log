+    cols = np.arange(grid.shape[1])
+    selected = cols % expected_holes == object_left % expected_holes
+    expected[(grid == YELLOW) & selected[np.newaxis, :]] = PINK
+    try:
+        actual = main(grid)
+    except (AssertionError, ValueError):
