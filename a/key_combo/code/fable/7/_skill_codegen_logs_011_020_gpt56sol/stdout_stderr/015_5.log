+    if not np.array_equal(actual, expected) or np.array_equal(actual, grid):
+        return False
+    if not np.array_equal(actual[grid == TEAL], grid[grid == TEAL]):
+        return False
+    if np.any(actual[grid == BLACK] != BLACK):
+        return False
