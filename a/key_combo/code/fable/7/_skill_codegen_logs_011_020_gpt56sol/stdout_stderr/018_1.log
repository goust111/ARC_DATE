+    grid = np.zeros((height, width), dtype=int)
+    for i, sprite in enumerate(sprites):
+        r, c = placements[i]
+        view = grid[r : r + sprite.shape[0], c : c + sprite.shape[1]]
+        mask = sprite != BACKGROUND
+        view[mask] = sprite[mask]
+    return grid
