pen('a', encoding='utf-8') as mf:             mf.write(json.dumps(rec, ensure_ascii=False) + '\n')  def run_job(task, prompt, target):     start = time.time()     log_path = LOG_DIR / f'{task}_{prompt.stem}.log'     prompt_text = prompt.read_text(encoding='utf-8')     text = PREFIX.format(target=target, prompt=prompt) + prompt_text     cmd = [         'codex', 'exec', '--skip-git-repo-check',         '-s', 'danger-full-access',         '--add-dir', '/home/lixinyu/snap',         '-c', 'model="gpt-5.4"',         '-c', 'reasoning.effort="high"',         text,     ]     rec = {'task': task, 'prompt': str(prompt), 'target': str(target), 'log': str(log_path), 'model': MODEL, 'start': start}     try:         with log_path.open('w', encoding='utf-8') as log:             log.write('[CMD] codex exec --skip-git-repo-check -s danger-full-access --add-dir /home/lixinyu/snap -c model="gpt-5.4" -c reasoning.effort="high" <prompt_text>\n')             log.flush()             proc = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, text=True, timeout=TIMEOUT)         try:             tail = log_path.read_text(encoding='utf-8', errors='replace')[-4000:].lower()         except Exception:             tail = ''         usage_limited = any(pat in tail for pat in USAGE_PATTERNS)         rec.update({'returncode': proc.returncode, 'ok': proc.returncode == 0 and target.exists(), 'target_exists': target.exists(), 'target_size': target.stat().st_size if target.exists() else 0, 'usage_limited': usage_limited})         if usage_limited:             stop_event.set()     except subprocess.TimeoutExpired:         rec.update({'returncode': None, 'ok': False, 'target_exists': target.exists(), 'target_size': target.stat().st_size if target.exists() else 0, 'error': 'timeout', 'usage_limited': False})     except Exception as exc:         rec.update({'returncode': None, 'ok': False, 'target_exists': target.exists(), 'target_size': target.stat().st_size if target.exists() else 0, 'error': repr(ex