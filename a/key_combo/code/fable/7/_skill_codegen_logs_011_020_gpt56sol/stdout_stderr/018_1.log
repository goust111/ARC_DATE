+            random.shuffle(positions)
+            chosen = None
+            for r, c in positions:
+                box = (r, c, r + sh - 1, c + sw - 1)
+                if all(box[2] + 1 < q[0] or q[2] + 1 < box[0] or
+                       box[3] + 1 < q[1] or q[3] + 1 < box[1] for q in boxes):
