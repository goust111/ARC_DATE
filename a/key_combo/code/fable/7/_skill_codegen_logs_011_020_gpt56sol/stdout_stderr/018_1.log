    masks = [sym_mask]
    for _ in range(n_colors - 1):
        mask = _gen_asymmetric_mask()
        if mask is None:
            return None
        masks.append(mask)
    return masks


def _gen_render_valid_grid(h: int, w: int, crops: list[np.ndarray]) -> np.ndarray | None:
    expected = crops[0]
    placed = _gen_place_crops(h, w, crops)
    if placed is None:
