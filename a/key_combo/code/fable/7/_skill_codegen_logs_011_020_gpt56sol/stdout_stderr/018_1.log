+    assembly = _unique_best_packing(piece_masks[0], piece_masks[1])
+    cavity = assembly == 0
+    assert cavity.any(), "the densest assembly must leave a negative-space key"
+    cavity = _normalized_mask(cavity)
+    matches = [i for i, mask in enumerate(candidate_masks) if np.array_equal(mask, cavity)]
+    assert len(matches) == 1, "the cavity must match exactly one gray candidate"
+    return candidate_crops[matches[0]]
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return bool(mask.any()) and len(_components(mask)) == 1
+
+
+def _random_tight_polyomino(h: int, w: int, area: int) -> np.ndarray | None:
+    """Sample a connected mask of exact area that touches all four bbox sides."""
+    if not (max(h, w) <= area <= h * w):
+        return None
+    for _ in range(100):
+        mask = np.zeros((h, w), dtype=bool)
+        start = (random.randrange(h), random.randrange(w))
+        mask[start] = True
+        while int(mask.sum()) < area:
+            frontier = set()
+            for r, c in np.argwhere(mask):
+                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc]:
+                        frontier.add((rr, cc))
+            if not frontier:
+                break
+            weights = []
+            for cell in frontier:
+                rr, cc = cell
+                # Favor missing bbox sides without making the rest deterministic.
+                bonus = 1 + 3 * (rr in (0, h - 1)) + 3 * (cc in (0, w - 1))
+                weights.append(bonus)
+            chosen = random.choices(list(frontier), weights=weights, k=1)[0]
+            mask[chosen] = True
+        if int(mask.sum()) == area and _bbox(mask) == (0, 0, h - 1, w - 1):
+            return mask
+    return None
+
+
+def _make_candidate_set(count: int) -> list[np.ndarray] | None:
+    h, w = random.choice(((3, 3), (3, 4), (4, 3), (4, 4)))
+    low = max(h, w, 5)
+    high = min(h * w - 2, 9)
+    if low > high:
+        return None
+    area = random.randint(low, high)
+    masks: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for _ in range(600):
+        mask = _random_tight_polyomino(h, w, area)
+        if mask is None or mask.tobytes() in seen:
+            continue
+        seen.add(mask.tobytes())
+        masks.append(mask)
+        if len(masks) == count:
+            return masks
+    return None
+
+
+def _split_around_cavity(cavity_shape: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    """Embed a cavity and partition the remaining rectangle into two connected pieces."""
+    ch, cw = cavity_shape.shape
+    height = random.randint(max(6, ch + 3), 8)
+    width = random.randint(max(6, cw + 3), 9)
+    r0 = random.randint(1, height - ch - 1)
+    c0 = random.randint(1, width - cw - 1)
+    cavity = np.zeros((height, width), dtype=bool)
+    cavity[r0 : r0 + ch, c0 : c0 + cw] = cavity_shape
+
