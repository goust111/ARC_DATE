+    piece_b = np.zeros(b.shape, dtype=int)
+    piece_a[a] = color_a
+    piece_b[b] = color_b
+    candidate_sprites = []
+    for mask in candidates:
+        sprite = np.zeros(mask.shape, dtype=int)
+        sprite[mask] = GRAY
+        candidate_sprites.append(sprite)
