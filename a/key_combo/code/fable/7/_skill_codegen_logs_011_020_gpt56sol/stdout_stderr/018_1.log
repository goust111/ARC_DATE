ASYMMETRIC_HEIGHT_RANGE, ASYMMETRIC_WIDTH_RANGE = (2, 8), (4, 9)
ASYMMETRIC_MAX_FILL_RATIO = (3, 4)
ASYMMETRY_BREAK_PIXELS = 1
ASYMMETRY_LR_DIFF = 2
