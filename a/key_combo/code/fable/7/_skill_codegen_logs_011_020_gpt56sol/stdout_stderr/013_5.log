+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if not coords.size:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    steps = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    if connectivity == 8:
+        steps = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc)
+    unseen = mask.astype(bool).copy()
+    result: list[np.ndarray] = []
+    while unseen.any():
+        start = tuple(map(int, np.argwhere(unseen)[0]))
+        unseen[start] = False
+        stack = [start]
+        cells = []
+        while stack:
+            r, c = stack.pop()
+            cells.append((r, c))
+            for dr, dc in steps:
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and unseen[rr, cc]:
+                    unseen[rr, cc] = False
+                    stack.append((rr, cc))
+        result.append(np.asarray(cells, dtype=int))
+    return result
