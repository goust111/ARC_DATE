+
+# ------------------------------ generator ------------------------------
+
+
+def _random_polyomino(min_area: int = 3, max_area: int = 8) -> np.ndarray:
+    area = random.randint(min_area, max_area)
+    cells = {(0, 0)}
+    while len(cells) < area:
