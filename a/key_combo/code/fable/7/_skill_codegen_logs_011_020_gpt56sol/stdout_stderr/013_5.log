+    min_c = min(c for _, c in cells)
+    cells = {(r - min_r, c - min_c) for r, c in cells}
+    h = max(r for r, _ in cells) + 1
+    w = max(c for _, c in cells) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for cell in cells:
+        mask[cell] = True
+    return mask
