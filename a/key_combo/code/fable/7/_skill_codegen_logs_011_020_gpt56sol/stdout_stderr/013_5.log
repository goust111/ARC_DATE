    for chosen_dir in perps:
        other_dir = perps[1] if chosen_dir is perps[0] else perps[0]
        cr, cc = r + chosen_dir[0], c + chosen_dir[1]
        otr, otc = r + other_dir[0], c + other_dir[1]
