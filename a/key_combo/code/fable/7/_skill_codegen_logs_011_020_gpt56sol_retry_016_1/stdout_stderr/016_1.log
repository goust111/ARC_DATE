+    shape: tuple[int, int], n: int, bg: int,
+    colors: dict[tuple[int, int], int],
+    pointers: dict[tuple[int, int], tuple[int, int]],
+) -> np.ndarray:
+    """Generator oracle built directly from the declarative destination rule."""
