+def _can_place(local: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    qh, qw = local.shape
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(qh, r0 + h + 1)
+    cc1 = min(qw, c0 + w + 1)
