+        return None
+    if np.array_equal(truth, inp[gr0 : gr1 + 1, gc0 : gc1 + 1]):
+        return None
+
+    try:
+        pred = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(pred, truth):
+        return None
+    return inp
