def _ceil_fraction(n: int, numerator: int, denominator: int) -> int:
    return (int(numerator) * int(n) + int(denominator) - 1) // int(denominator)


@lru_cache(None)
def _mask_options(h: int, w: int, area: int) -> tuple[tuple[int, ...], ...]:
