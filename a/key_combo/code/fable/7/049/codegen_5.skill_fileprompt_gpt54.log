+BG = 0
+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
