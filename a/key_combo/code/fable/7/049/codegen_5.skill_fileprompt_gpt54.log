+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
