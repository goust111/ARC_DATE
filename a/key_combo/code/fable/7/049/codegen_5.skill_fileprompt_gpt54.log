+def _place_scatter_points(grid: np.ndarray, color_counts: list[tuple[int, int]]) -> bool:
+    pool = _isolated_empty_cells(grid)
+    taken: list[tuple[int, int]] = []
+    for color, count in color_counts:
+        for _ in range(count):
+            placed = False
+            for r, c in pool:
+                if int(grid[r, c]) != BG:
+                    continue
