+        cc = left + int(c)
+        for nr in range(rr - 1, rr + 2):
+            for nc in range(cc - 1, cc + 2):
+                if 0 <= nr < blocked.shape[0] and 0 <= nc < blocked.shape[1]:
+                    blocked[nr, nc] = True
+
