+def _can_place(blocked: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    h, w = patch.shape
+    if top < 0 or left < 0 or top + h > blocked.shape[0] or left + w > blocked.shape[1]:
+        return False
+    coords = np.argwhere(patch != BG)
+    for r, c in coords:
+        if blocked[top + int(r), left + int(c)]:
