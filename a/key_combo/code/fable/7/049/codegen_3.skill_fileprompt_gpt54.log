+        r1, c1 = occupied.max(axis=0)
+        patch = patch[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+        info = _piece_summary(patch)
+        if info["left_color"] == int(left_color) and info["right_color"] == int(right_color):
+            return patch
