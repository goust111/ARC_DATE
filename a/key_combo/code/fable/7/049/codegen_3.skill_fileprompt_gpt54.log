+    h, w = patch.shape
+
+    left = []
+    right = []
+    endpoints = []
+    for r, c in np.argwhere(mask):
+        deg = _degree(mask, int(r), int(c))
+        if deg == 1:
+            endpoints.append((int(r), int(c)))
+            if int(c) == 0:
