+            c0, c1 = min(cols), max(cols)
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+            pieces.append({"bbox": (r0, c0, r1, c1), "patch": patch})
+
+    assert pieces, "expected at least one path segment"
+    return pieces
