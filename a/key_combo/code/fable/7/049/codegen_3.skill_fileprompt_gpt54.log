+    counts: Counter[int] = Counter()
+    for raw in raw_pieces:
+        info = _piece_summary(raw["patch"])
+        info["bbox"] = raw["bbox"]
+        pieces.append(info)
+        counts[info["left_color"]] += 1
+        counts[info["right_color"]] += 1
