+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BODY = 5
+ENDPOINT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+PIECE_ATTEMPTS = 120
+PLACE_ATTEMPTS = 200
