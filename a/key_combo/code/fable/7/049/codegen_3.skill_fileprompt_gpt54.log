+    right_r, right_c = right[0]
+    return {
+        "patch": patch,
+        "left_coord": (left_r, left_c),
+        "right_coord": (right_r, right_c),
+        "left_color": int(patch[left_r, left_c]),
+        "right_color": int(patch[right_r, right_c]),
+        "width": w,
+        "height": h,
+    }
+
+
