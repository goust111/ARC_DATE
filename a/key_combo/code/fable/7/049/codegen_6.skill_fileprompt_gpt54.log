+    height = random.randint(8, 18)
+    total_w = sum(widths) + region_count - 1
+    spans = []
+    cursor = 0
+    wall_cols = []
+    for idx, w in enumerate(widths):
+        spans.append((cursor, cursor + w - 1))
+        cursor += w
