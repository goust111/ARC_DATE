+def _find_frame(grid: np.ndarray) -> tuple[int, int, int, int, int, int]:
+    best = None
+    for color in np.unique(grid):
+        coords = np.argwhere(grid == int(color))
+        if coords.shape[0] < 8:
+            continue
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not (
+            np.all(patch[0, :] == color)
+            and np.all(patch[-1, :] == color)
+            and np.all(patch[:, 0] == color)
+            and np.all(patch[:, -1] == color)
+        ):
+            continue
+
+        perim = 2 * (patch.shape[0] + patch.shape[1]) - 4
+        if int(np.count_nonzero(patch == color)) != perim:
+            continue
+
+        inner = patch[1:-1, 1:-1]
+        inner_colors = np.unique(inner)
+        if len(inner_colors) != 1 or int(inner_colors[0]) == int(color):
+            continue
+
+        score = patch.shape[0] * patch.shape[1]
+        candidate = (int(r0), int(c0), int(r1), int(c1), int(color), int(inner_colors[0]))
+        if best is None or score > best[0]:
+            best = (score, candidate)
+
+    if best is None:
+        raise ValueError("frame not found")
+    return best[1]
+
