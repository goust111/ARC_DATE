+        for c in range(grid.shape[1]):
+            color = int(grid[r, c])
+            if color in (bg, border, fill):
+                continue
+            if r0 < r < r1 and c0 < c < c1:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if not (r0 <= nr <= r1 and c0 <= nc <= c1):
