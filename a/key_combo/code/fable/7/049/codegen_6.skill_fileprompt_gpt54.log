+    r, c = touch
+    out_h = r1 - r0 - 1
+    out_w = c1 - c0 - 1
+    if c == c0:
+        return r - r0 - 1, 0
+    if c == c1:
+        return r - r0 - 1, out_w - 1
+    if r == r0:
