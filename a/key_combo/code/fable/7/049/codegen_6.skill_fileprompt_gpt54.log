+        total = random.randint(1, min(5, len(cells)))
+        max_color_count = min(3, total)
+        if total == 1:
+            color_count = 1
+        else:
+            color_count = random.randint(1, max_color_count)
+            if color_count == total:
+                color_count -= 1
+
+        chosen_colors = random.sample(marker_palette, color_count)
