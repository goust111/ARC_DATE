+        spans = []
+        cursor = 0
+        wall_rows = []
+        for idx, h in enumerate(heights):
+            spans.append((cursor, cursor + h - 1))
+            cursor += h
+            if idx + 1 < region_count:
+                wall_rows.append(cursor)
+                cursor += 1
+        return total_h, width, spans, wall_rows
