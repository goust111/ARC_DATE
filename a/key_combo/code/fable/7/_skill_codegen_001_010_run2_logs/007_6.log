+    if name == "NE":
+        return range(border, mr - ph - gap + 1), range(mc + gap, w - pw - border + 1)
+    if name == "SW":
+        return range(mr + gap, h - ph - border + 1), range(border, mc - pw - gap + 1)
+    if name == "SE":
