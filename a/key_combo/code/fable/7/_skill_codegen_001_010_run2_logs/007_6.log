  "dst": "stack one horizontal bar per frame, ordered by count of enclosed background regions then color id",
  "transform": "bar length = number of enclosed 4-connected background regions; pad right with the scattered color",
  "grid_shape": "height = number of frame colors, width = maximum enclosed-region count"
}
</annotation>
</reference_puzzle>

