+def _pick_quadrants(object_count: int) -> list[str]:
+    axis_a = ["NW", "SE"]
+    axis_b = ["NE", "SW"]
+    mode = random.random()
+    if mode < 0.45:
+        quads = ["NW", "NE", "SW", "SE"]
+    elif mode < 0.8:
+        quads = random.sample(axis_a, 1) + random.sample(axis_b, 1) + [random.choice(list(QUADRANTS))]
+    else:
