+def _random_orientation(sprite_mask: np.ndarray) -> np.ndarray:
+    out = sprite_mask.copy()
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    return out
