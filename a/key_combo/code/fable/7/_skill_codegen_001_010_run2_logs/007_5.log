+    out = blank.copy()
+    patch = np.full(next_mask.shape, int(bg), dtype=int)
+    patch[next_mask] = sprite_color
+    paste(out[1:-1, 1:-1], patch, int(next_pos[0]), int(next_pos[1]), transparent=int(bg))
+    return out
