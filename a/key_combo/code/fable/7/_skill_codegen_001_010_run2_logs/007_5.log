+    states: list[tuple[np.ndarray, tuple[int, int]]] = [(sprite_mask.copy(), pos)]
+    bounces: list[tuple[bool, bool]] = []
+    cur_mask = sprite_mask.copy()
+    cur_pos = pos
+    cur_vel = vel
