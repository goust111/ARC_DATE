+
+def _render_panel(
+    panel_h: int,
+    panel_w: int,
+    *,
+    border: int,
+    bg: int,
+    sprite_color: int,
+    sprite_mask: np.ndarray | None = None,
+    pos: tuple[int, int] | None = None,
