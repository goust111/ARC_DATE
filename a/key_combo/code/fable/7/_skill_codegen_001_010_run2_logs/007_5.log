+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        built = _build_candidate()
+        if built is None:
+            continue
+        grid, meta = built
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        if not np.array_equal(out, meta["expected"]):
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid bouncing-panel ARC input")

