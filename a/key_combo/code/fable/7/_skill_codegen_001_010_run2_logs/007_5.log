+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        built = _build_candidate()
+        if built is None:
+            continue
+        grid, meta = built
+        try:
+            out = main(grid)
+        except Exception:
