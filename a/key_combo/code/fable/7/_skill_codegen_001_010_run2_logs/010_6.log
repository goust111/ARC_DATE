+    info = analyze_scene(grid)
+    out = info["grid"].copy()
+    sprite_coords = info["sprite"]["coords"]
+    out[sprite_coords[:, 0], sprite_coords[:, 1]] = info["bg"]
+
+    patch = info["sprite_variants"][info["transform_index"]]
+    r0, c0, _, _ = info["match_corner"]["bbox"]
