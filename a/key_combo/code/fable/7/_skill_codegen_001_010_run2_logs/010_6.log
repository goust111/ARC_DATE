+    if coords.size == 0:
+        return ()
+    coords = coords - coords.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in coords))
+
+
+def shape_diff_count(mask_a: np.ndarray, mask_b: np.ndarray) -> int:
+    return len(set(shape_key(mask_a)) ^ set(shape_key(mask_b)))
+
+
