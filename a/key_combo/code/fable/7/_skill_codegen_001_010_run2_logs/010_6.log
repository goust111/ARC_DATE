+    return {
+        "grid": g,
+        "bg": bg,
+        "sprite": sprite,
+        "corners": sorted(corners, key=lambda obj: obj["corner"]),
+        "match_corner": matches[0][0],
+        "transform_index": matches[0][1],
+        "sprite_variants": sprite_variants,
+        "sprite_mask_variants": sprite_mask_variants,
+    }
