                pixel_sprite,
                transparent=background_color,
                border=1,
                padding=1,
                padding_connectivity=8,
            )
        except ValueError:
            break
        paste(input_grid, pixel_sprite, pixel_r, pixel_c, transparent=background_color, clip=True)
    
