+    r0, c0, r1, c1 = bbox
+    h, w = grid_shape
+    cr = (r0 + r1) / 2
+    cc = (c0 + c1) / 2
+    return ("T" if cr < h / 2 else "B") + ("L" if cc < w / 2 else "R")
+
