+def _rotate_point_cw(point: tuple[int, int], pivot: tuple[int, int], turns: int) -> tuple[int, int]:
+    pr, pc = pivot
+    dr = int(point[0]) - pr
+    dc = int(point[1]) - pc
+    for _ in range(int(turns) % 4):
