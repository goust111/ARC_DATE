+SPRITE_SIZE = 2
+FRAME_AREA = 12
+SPRITE_AREA = 3
+MISSING_CORNERS = ((0, 0), (0, 1), (1, 0), (1, 1))
+NON_BG_COLORS = tuple(range(1, 10))
