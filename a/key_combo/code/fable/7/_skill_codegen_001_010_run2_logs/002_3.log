+def _missing_corner(crop: np.ndarray) -> tuple[int, int]:
+    holes = np.argwhere(crop == BG)
+    assert holes.shape == (1, 2), "expected exactly one missing corner"
+    return int(holes[0, 0]), int(holes[0, 1])
