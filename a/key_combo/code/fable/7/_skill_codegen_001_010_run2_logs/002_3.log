+def _is_frame_crop(crop: np.ndarray, color: int) -> bool:
+    if crop.shape != (FRAME_SIZE, FRAME_SIZE):
+        return False
+    if np.any(crop[0, :] != color) or np.any(crop[-1, :] != color):
+        return False
+    if np.any(crop[:, 0] != color) or np.any(crop[:, -1] != color):
+        return False
+    return bool(np.all(crop[1:-1, 1:-1] == BG))
