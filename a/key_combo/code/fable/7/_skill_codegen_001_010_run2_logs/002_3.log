    r, c = cell
    return any((r + dr, c + dc) in comp_cells for dr, dc in _GEN_DIRS4)


def _gen_seed_cells(components, reachable, seed_count):
    seeds = set()
    all_reachable = []
    for idx in random.sample(list(reachable), len(reachable)):
