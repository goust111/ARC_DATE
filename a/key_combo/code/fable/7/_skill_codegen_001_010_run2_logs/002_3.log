+def _trace_distinct_hits(
+    shape: tuple[int, int],
+    gap: tuple[int, int],
+    direction: tuple[int, int],
+    frame_coord_map: dict[tuple[int, int], int],
+) -> list[int]:
+    r, c = map(int, gap)
+    dr, dc = map(int, direction)
+    hits: list[int] = []
