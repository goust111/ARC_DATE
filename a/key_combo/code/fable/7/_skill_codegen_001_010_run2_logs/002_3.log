from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/002/3.py')
mod = SourceFileLoader('new_arc_task_independent', str(p)).load_module()

BG = 0

def components(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or grid[r, c] "'!= color:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                rr, cc = stack.pop()
                cells.append((rr, cc))
                for dr, dc in ((-1,0),(1,0),(0,-1),(0,1)):
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == color:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            out.append(cells)
    return out


def parse_independent(grid):
    colors = sorted(int(x) for x in np.unique(grid) if int(x) != BG)
    frames = []
    sprites = []
    for color in colors:
        for cells in components(grid, color):
            rows = [r for r, _ in cells]
            cols = [c for _, c in cells]
            r0, r1 = min(rows), max(rows)
            c0, c1 = min(cols), max(cols)
            h = r1 - r0 + 1
            w = c1 - c0 + 1
            area = len(cells)
            crop = grid[r0:r1+1, c0:c1+1]
            if area == 12 and (h, w) == (4, 4):
                if np.all(crop[0] == color) and np.all(crop[-1] == color) and np.all(crop[:,0] == color) and np.all(crop[:,-1] == color) and np.all(crop[1:3,1:3] == BG):
                    frames.append({'"'bbox': (r0,c0,r1,c1), 'color': color})
                    continue
            if area == 3 and (h, w) == (2, 2):
                holes = np.argwhere(crop == BG)
                if holes.shape == (1, 2) and np.count_nonzero(crop == color) == 3:
                    mr, mc = map(int, holes[0])
                    sprites.append({'bbox': (r0,c0,r1,c1), 'color': color, 'missing': (mr, mc), 'gap': (r0 + mr, c0 + mc)})
                    continue
            raise AssertionError(f'unrecognized component color={color} bbox={(r0,c0,r1,c1)} area={area}')
    frames.sort(key=lambda x: x['bbox'])
    sprites.sort(key=lambda x: x['bbox'])
    return frames, sprites


def border_map(frames):
    mp = {}
    for idx, frame in enumerate(frames):
        r0, c0, r1, c1 = frame['bbox']
        for c in range(c0, c1 + 1):
            mp[(r0, c)] = idx
            mp[(r1, c)] = idx
        for r in range(r0 + 1, r1):
            mp[(r, c0)] = idx
            mp[(r, c1)] = idx
    return mp


def trace(shape, gap, missing, mp):
    dr = -1 if missing[0] == 0 else 1
    dc = -1 if missing[1] == 0 else 1
    r, c = gap
    seen = []
    used = set()
    while True:
        r += dr
        c += dc
        if not (0 <= r < shape[0] and 0 <= c < shape[1]):
            return seen
        idx = mp.get((r, c))
        if idx is not None and idx not in used:
            used.add(idx)
            seen.append(idx)

for _ in range(120):
    inp = mod.generate_input()
    out = mod.main(inp)
    frames, sprites = parse_independent(inp)
    assert 1 <= len(sprites) <= len(frames)
    mp = border_map(frames)
    target_for = {}
    for spr in sprites:
        hits = trace(inp.shape, spr['gap'], spr['missing'], mp)
        assert len(hits) == 1
        target_for[spr['bbox']] = hits[0]
    assert len(set(target_for.values())) == len(sprites)

    for spr in sprites:
        r0, c0, r1, c1 = spr['bbox']
        assert np.all(out[r0:r1+1, c0:c1+1] == BG)

    for idx, frame in enumerate(frames):
        r0, c0, r1, c1 = frame['bbox']
        cavity = out[r0+1:r1, c0+1:c1]
        owners = [spr for spr in sprites if target_for[spr['bbox']] == idx]
        assert len(owners) <= 1
        if not owners:
            assert np.all(cavity == BG)
        else:
            spr = owners[0]
            expected = np.full((2, 2), frame['color'], dtype=int)
            expected[spr['missing']] = BG
            assert np.array_equal(cavity, expected)
        assert np.all(out[r0, c0:c1+1] == frame['color'])
        assert np.all(out[r1, c0:c1+1] == frame['color'])
        assert np.all(out[r0:r1+1, c0] == frame['color'])
        assert np.all(out[r0:r1+1, c1] == frame['color'])

print('independent_semantic_check ok')
