+def _parse_objects(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= 30, "grid must fit ARC size limits"
+
