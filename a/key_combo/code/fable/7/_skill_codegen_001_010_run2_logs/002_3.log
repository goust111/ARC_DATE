+        if area == SPRITE_AREA and _is_sprite_crop(crop, color):
+            r0, c0, r1, c1 = bbox
+            missing = _missing_corner(crop)
+            sprites.append(
+                {
+                    "bbox": bbox,
+                    "color": color,
+                    "missing": missing,
