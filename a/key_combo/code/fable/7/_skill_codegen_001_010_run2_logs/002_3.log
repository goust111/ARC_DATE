+def _available_orientations(
+    shape: tuple[int, int],
+    reserved: np.ndarray,
+    frames: list[dict],
+    frame_coord_map: dict[tuple[int, int], int],
+) -> dict[int, list[tuple[int, int]]]:
+    available: dict[int, list[tuple[int, int]]] = {}
+    H, W = shape
+    for frame_idx in range(len(frames)):
