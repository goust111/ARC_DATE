+SPRITE_SIZE = 2
+FRAME_AREA = 12
+SPRITE_AREA = 3
+MISSING_CORNERS = ((0, 0), (0, 1), (1, 0), (1, 1))
+NON_BG_COLORS = tuple(range(1, 10))
+
+GEN_HEIGHT_RANGE = (18, 28)
+GEN_WIDTH_RANGE = (18, 28)
+GEN_FRAME_COUNT_RANGE = (2, 4)
+GEN_FRAME_BORDER = 1
+GEN_FRAME_PADDING = 2
+GEN_SPRITE_PADDING = 1
+GEN_RETRY_LIMIT = 600
