+        next_remaining = [idx for idx in remaining if idx != best_idx]
+
+        for r0, c0 in best_candidates:
+            paste(grid, patch, r0, c0, transparent=BG)
+            paste(reserved, marker, r0, c0)
+            placements[best_idx] = {
