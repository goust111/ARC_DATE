+    H, W = shape
+    for frame_idx in range(len(frames)):
+        options: list[tuple[int, int]] = []
+        for missing in MISSING_CORNERS:
+            found = False
+            direction = _direction_from_missing(missing)
+            for r0 in range(H - SPRITE_SIZE + 1):
