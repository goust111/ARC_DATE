+                "color": color,
+                "quota": int(obj["quota"]),
+                "initial_coords": list(obj["initial_coords"]),
+                "final_coords": final_coords,
+                "actual_shift": int(moved),
+                "stop_reason": stop_reason,
+                "initial_bottom": int(obj["initial_bottom"]),
+            }
+        )
