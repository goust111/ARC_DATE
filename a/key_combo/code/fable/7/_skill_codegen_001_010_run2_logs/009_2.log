+
+
+def _path_clear(
+    path: list[tuple[int, int]],
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    attachment: tuple[int, int],
+) -> bool:
+    path_set = set(path)
+    if len(path_set) != len(path):
+        return False
+    for idx, cell in enumerate(path):
