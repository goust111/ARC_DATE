+def _grow_blob(
+    endpoint: tuple[int, int],
+    back_dir: tuple[int, int],
+    area: int,
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    rng: np.random.Generator,
+) -> set[tuple[int, int]] | None:
+    try_dirs = list(ORTHO_DIRS)
+    rng.shuffle(try_dirs)
