+                    "frame_bbox": (r0, c0, r0 + frame_side - 1, c0 + frame_side - 1),
+                    "frame_mask": mask,
+                    "wires": wires,
+                    "center_offset": float(center_offset),
+                    "blobs": blobs,
+                    "bg": bg,
+                }
+            )
