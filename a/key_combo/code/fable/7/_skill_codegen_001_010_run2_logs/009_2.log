+            path = str(candidate)
+            if path not in sys.path:
+                sys.path.append(path)
+            return
+    fallback = Path("/home/lixinyu/snap/new/solvers")
+    if fallback.is_dir():
+        path = str(fallback)
+        if path not in sys.path:
+            sys.path.append(path)
+
+
+_ensure_arc_utils_importable()
