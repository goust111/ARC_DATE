+    objects_meta: list[dict] = []
+    for idx in rng.permutation(n):
+        route = routes[int(idx)]
+        blob = _grow_blob(route["path"][-1], route["last_dir"], areas_by_route[int(idx)], grid.shape, occupied, rng)
