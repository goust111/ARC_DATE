+
+GREY = int(Color.GREY)
+BG = int(Color.BLACK)
+PALETTE = [int(c) for c in Color.NOT_BLACK if int(c) != GREY]
+ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
