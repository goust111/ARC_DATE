+                        turn_start = seg1[-1]
+                        seg2 = [_add(turn_start, tangent, k) for k in range(1, len2 + 1)]
+                        seg3_start = seg2[-1] if seg2 else turn_start
+                        seg3 = [_add(seg3_start, outward, k) for k in range(1, len3 + 1)]
+                        path = seg1 + seg2 + seg3
+                        if len(path) in used_lengths:
+                            continue
