+def _ensure_arc_utils_importable() -> None:
+    here = Path(__file__).resolve()
+    for parent in [here.parent, *here.parents]:
+        candidate = parent / "new" / "solvers"
+        if candidate.is_dir():
+            path = str(candidate)
+            if path not in sys.path:
+                sys.path.append(path)
