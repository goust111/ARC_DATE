+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah - 1 + gap < br
+        or br + bh - 1 + gap < ar
+        or ac + aw - 1 + gap < bc
+        or bc + bw - 1 + gap < ac
+    )
