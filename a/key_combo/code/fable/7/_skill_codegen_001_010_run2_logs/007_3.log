+    grid = np.full((H, W), bg, dtype=int)
+    paste(grid, template, top, left)
+    ok = _place_sources(grid, (top, left, template.shape[0], template.shape[1]), cavities, bg)
+    if not ok:
+        raise RuntimeError("source placement failed")
+    return grid, expected
