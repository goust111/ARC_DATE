+    bg = _border_background(inp)
+    base, coords = _largest_template_component(inp, bg)
+    tr0, tc0, tr1, tc1 = bbox_coords(coords)
+    crop = crop_bbox(inp, (tr0, tc0, tr1, tc1))
+    template_mask = np.zeros(crop.shape, dtype=bool)
