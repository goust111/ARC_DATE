+def _border_background(grid: np.ndarray) -> int:
+    border = np.concatenate((grid[0], grid[-1], grid[:, 0], grid[:, -1]))
+    vals, counts = np.unique(border, return_counts=True)
+    return int(vals[np.argmax(counts)])
