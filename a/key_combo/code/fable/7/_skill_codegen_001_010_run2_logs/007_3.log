+    for idx, (r0, c0, h, w) in enumerate(placements):
+        mask = None
+        for _ in range(80):
+            candidate = _random_spanning_sprite(h, w)
+            if candidate is None:
+                continue
+            sig = _mask_signature(candidate)
+            bucket = used_masks_by_size.setdefault((h, w), set())
+            if sig in bucket:
+                continue
+            bucket.add(sig)
+            mask = candidate
+            break
+        if mask is None:
+            return None
+
