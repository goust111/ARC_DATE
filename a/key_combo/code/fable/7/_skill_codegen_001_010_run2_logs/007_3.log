    max_r = _GEN_H - _GEN_SIZE
    max_c = _GEN_W - _GEN_SIZE
    if edge in {"left", "right"}:
        return random.randint(0, max_r), 0 if edge == "left" else max_c
    return 0 if edge == "up" else max_r, random.randint(0, max_c)


