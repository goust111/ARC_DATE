        chosen = route['chosen']
        if chosen is None:
            summary[f'erase_{preferred}'] += 1
            erase_seen.add(preferred)
        elif chosen == preferred:
            summary[f'near_{chosen}'] += 1
        else:
            summary[f'fallback_{preferred}_to_{chosen}'] += 1
            fallback_seen.add((preferred, chosen))

    assert summary['near_0'] >= 1 and summary['near_1'] >= 1
    assert summary['erase_0'] + summary['erase_1'] >= 1
    assert summary['fallback_0_to_1'] + summary['fallback_1_to_0'] >= 1

    if axis == 0:
        orientations.add('rows')
    else:
        orientations.add('cols')

    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

    if perturb_checked < 20:
