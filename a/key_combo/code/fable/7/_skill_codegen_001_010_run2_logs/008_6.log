                continue
            r, c = route['marker']
            preferred_blockers = blockers_on_side(inp, marker, axis, edges[route['preferred']], r, c)
            assert preferred_blockers
            mutated = inp.copy()
            for rr, cc in preferred_blockers:
                mutated[rr, cc] = bg
            mutated_out = mod.main(mutated)
            assert not np.array_equal(mutated_out, out), 'clearing all blockers on the preferred side should change the routing result'
            perturb_checked += 1
            break

print('variants', len(sigs))
print('orientations', orientations)
print('fallback_seen', fallback_seen)
print('erase_seen', erase_seen)
print('perturb_checked', perturb_checked)
assert len(sigs) >= 20
assert orientations == {'rows', 'cols'}
assert fallback_seen == {(0, 1), (1, 0)}
assert erase_seen == {0, 1}
assert perturb_checked >= 10
