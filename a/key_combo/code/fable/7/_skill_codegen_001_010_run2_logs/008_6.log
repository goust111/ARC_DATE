            old = planned.get(cell)
            color = bar_colors[chosen]
            assert old is None or old == color
            planned[cell] = color
    for (r, c), color in planned.items():
        out[r, c] = color
    return out, routes, (bg, axis, edges, bar_colors, marker)


def nearest_blocker(grid, marker, axis, edge, r, c):
    cells = path_cells(axis, edge, r, c)
    cells = [cell for cell in cells if cell "'!= (r, c)]
    if edge < (r if axis == 0 else c):
        cells = cells[::-1]
    for rr, cc in cells:
        if int(grid[rr, cc]) == marker:
            return rr, cc
    return None


sigs = set()
orientations = set()
fallback_seen = set()
erase_seen = set()
perturb_checked = 0
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    exp, routes, meta = solve_independent(inp)
    bg, axis, edges, bar_colors, marker = meta

    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'"'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, exp), 'main does not match independent solver'
    assert np.any(inp == marker), 'expected at least one marker'
