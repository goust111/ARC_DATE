from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
from collections import Counter
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/008/6.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()


def get_bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]


def full_row_bars(grid, bg):
    out = []
    for r in range(grid.shape[0]):
        vals = set(map(int, grid[r, :]))
        if len(vals) == 1:
            color = vals.pop()
            if color "'!= bg:
                out.append((r, color))
    return out


def full_col_bars(grid, bg):
    out = []
    for c in range(grid.shape[1]):
        vals = set(map(int, grid[:, c]))
        if len(vals) == 1:
            color = vals.pop()
            if color != bg:
                out.append((c, color))
    return out


def detect_layout(grid):
    bg = get_bg(grid)
    H, W = grid.shape
    row_bars = sorted(full_row_bars(grid, bg))
    col_bars = sorted(full_col_bars(grid, bg))
    if len(row_bars) == 2 and not col_bars:
        assert [r for r, _ in row_bars] == [0, H - 1]
        return bg, 0, (0, H - 1), (row_bars[0][1], row_bars[1][1])
    assert len(col_bars) == 2 and not row_bars
    assert [c for c, _ in col_bars] == [0, W - 1]
    return bg, 1, (0, W - 1), (col_bars[0][1], col_bars[1][1])


def marker_color(grid, bg, bar_colors):
    colors = sorted(set(map(int, grid.ravel())) - {bg, *bar_colors})
    assert len(colors) == 1
    return colors[0]


def blocked(grid, marker, axis, edge, r, c):
    if axis == 0:
        lo = min(edge, r) + 1
        hi = max(edge, r)
        return hi > lo and np.any(grid[lo:hi, c] == marker)
    lo = min(edge, c) + 1
    hi = max(edge, c)
    return hi > lo and np.any(grid[r, lo:hi] == marker)


def path_cells(axis, edge, r, c):
    if axis == 0:
        if edge < r:
            return [(rr, c) for rr in range(edge + 1, r + 1)]
        return [(rr, c) for rr in range(r, edge)]
    if edge < c:
        return [(r, cc) for cc in range(edge + 1, c + 1)]
    return [(r, cc) for cc in range(c, edge)]


def solve_independent(grid):
    g = np.asarray(grid, dtype=int)
    bg, axis, edges, bar_colors = detect_layout(g)
    marker = marker_color(g, bg, bar_colors)
    markers = [tuple(map(int, rc)) for rc in np.argwhere(g == marker)]
    out = g.copy()
    out[g == marker] = bg
    planned = {}
    routes = []
    for r, c in markers:
        coord = r if axis == 0 else c
        da = coord - edges[0]
        db = edges[1] - coord
        assert da != db
        clear_a = not blocked(g, marker, axis, edges[0], r, c)
        clear_b = not blocked(g, marker, axis, edges[1], r, c)
        preferred = 0 if da < db else 1
        if preferred == 0:
            chosen = 0 if clear_a else (1 if clear_b else None)
        else:
            chosen = 1 if clear_b else (0 if clear_a else None)
        routes.append({
            '"'marker': (r, c),
            'preferred': preferred,
            'chosen': chosen,
            'clear': (clear_a, clear_b),
        })
        if chosen is None:
            continue
        for cell in path_cells(axis, edges[chosen], r, c):
            old = planned.get(cell)
            color = bar_colors[chosen]
            assert old is None or old == color
            planned[cell] = color
    for (r, c), color in planned.items():
        out[r, c] = color
    return out, routes, (bg, axis, edges, bar_colors, marker)


def blockers_on_side(grid, marker, axis, edge, r, c):
    return [cell for cell in path_cells(axis, edge, r, c) if cell "'!= (r, c) and int(grid[cell]) == marker]


sigs = set()
orientations = set()
fallback_seen = set()
erase_seen = set()
perturb_checked = 0
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    exp, routes, meta = solve_independent(inp)
    bg, axis, edges, bar_colors, marker = meta

    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'"'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, exp), 'main does not match independent solver'

    summary = Counter()
    for route in routes:
        preferred = route['preferred']
        chosen = route['chosen']
        if chosen is None:
            summary[f'erase_{preferred}'] += 1
            erase_seen.add(preferred)
        elif chosen == preferred:
            summary[f'near_{chosen}'] += 1
        else:
            summary[f'fallback_{preferred}_to_{chosen}'] += 1
            fallback_seen.add((preferred, chosen))

