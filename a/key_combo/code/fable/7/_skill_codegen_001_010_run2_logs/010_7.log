0074:     output_grid = paste(output_grid, tl, 0, 0, transparent=bg)
0075:     output_grid = paste(output_grid, tr, 0, m - k, transparent=bg)
0076:     output_grid = paste(output_grid, bl, n - k, 0, transparent=bg)
0077:     output_grid = paste(output_grid, br, n - k, m - k, transparent=bg)
0078:     return output_grid
