+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        inp, expected, meta = _build_case()
+        if _validate_case(inp, expected, meta):
+            return inp
+    raise RuntimeError("failed to generate a valid double-mirror reconstruction task")

