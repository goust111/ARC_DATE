+    out = g.copy()
+    out[merged[:, 0], merged[:, 1]] = source_color
+    return out, {
+        "source_color": source_color,
+        "source_quad": source_quad,
+        "hr": hr,
+        "vc": vc,
+        "restored": merged,
+        "anchor": np.array(anchor, dtype=int),
