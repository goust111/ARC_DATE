+    random.shuffle(all_noise_colors)
+    count = random.randint(1, min(3, len(all_noise_colors)))
+    for color in all_noise_colors[:count]:
+        for _ in range(30):
+            kind = random.choice(("dot", "domino_h", "domino_v", "l3"))
+            if kind == "dot":
