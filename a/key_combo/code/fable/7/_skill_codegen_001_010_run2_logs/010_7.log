+        "TR": (slice(0, hr), slice(vc + 1, None)),
+        "BL": (slice(hr + 1, None), slice(0, vc)),
+        "BR": (slice(hr + 1, None), slice(vc + 1, None)),
+    }
+
+
+def _quadrant_pixel_counts(grid: np.ndarray, color: int, hr: int, vc: int) -> dict[str, int]:
