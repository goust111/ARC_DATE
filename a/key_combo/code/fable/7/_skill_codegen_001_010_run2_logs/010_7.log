0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """Reflect the multi-cell foreground mask across each singleton marker so the marker becomes one cell of its colored copy.
0010: 
0011:     Input structure
0012:     A background canvas contains one multi-pixel foreground object and one or more singleton marker colors. Each marker
0013:     shares exactly one row or exactly one column with a pixel of the source object.
0014: 
0015:     Rule
0016:     Keep the source object. For each marker, if it shares a row with exactly one source pixel, reflect the whole source
0017:     object horizontally through the vertical midline between that source pixel and the marker. If it shares a column
0018:     with exactly one source pixel, reflect the whole source object vertically through the horizontal midline between
0019:     them. Paint the reflected mask in the marker color.
0020: 
0021:     Key insight
0022:     The singleton marker is one already-reflected cell of the source object, so its aligned source pixel fixes the
0023:     mirror axis for the entire copy.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     bg = get_bg(g)
0027:     colors = colors_present(g, exclude={bg})
0028:     coords_by_color = {color: np.argwhere(g == color) for color in colors}
0029: 
0030:     source_colors = [color for color, coords in coords_by_color.items() if len(coords) > 1]
0031:     assert len(source_colors) == 1
0032:     source_color = source_colors[0]
0033:     source_coords = coords_by_color[source_color]
0034: 
0035:     marker_colors = [color for color in colors if color != source_color]
0036:     assert marker_colors
0037: 
0038:     out = g.copy()
0039:     height, width = g.shape
0040:     for marker_color in marker_colors:
0041:         marker_coords = coords_by_color[marker_color]
0042:         assert len(marker_coords) == 1
0043:         marker_r, marker_c = map(int, marker_coords[0])
0044: 
0045:         row_anchors = source_coords[source_coords[:, 0] == marker_r]
0046:         col_anchors = source_coords[source_coords[:, 1] == marker_c]
0047:         use_horizontal_reflection = len(row_anchors) == 1
0048:         use_vertical_reflection = len(col_anchors) == 1
0049:         assert use_horizontal_reflection != use_vertical_reflection
0050: 
0051:         targets = []
0052:         if use_horizontal_reflection:
0053:             anchor_c = int(row_anchors[0, 1])
0054:             col_sum = marker_c + anchor_c
0055:             for r, c in source_coords:
0056:                 targets.append((int(r), int(col_sum - c)))
0057:         else:
0058:             anchor_r = int(col_anchors[0, 0])
0059:             row_sum = marker_r + anchor_r
0060:             for r, c in source_coords:
0061:                 targets.append((int(row_sum - r), int(c)))
0062: 
0063:         for r, c in targets:
0064:             assert 0 <= r < height and 0 <= c < width
