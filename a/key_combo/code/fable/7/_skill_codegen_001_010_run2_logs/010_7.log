+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+QUADS = ("TL", "TR", "BL", "BR")
+H_MATE = {"TL": "BL", "TR": "BR", "BL": "TL", "BR": "TR"}
+V_MATE = {"TL": "TR", "TR": "TL", "BL": "BR", "BR": "BL"}
