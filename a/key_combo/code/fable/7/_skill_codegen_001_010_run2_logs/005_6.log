    top, left, bottom, right = box
    g[top, left] = marker
    g[top, left + 1] = marker
    g[top + 1, left] = marker

    g[top, right - 1] = marker
    g[top, right] = marker
    g[top + 1, right] = marker

    g[bottom - 1, left] = marker
    g[bottom, left] = marker
