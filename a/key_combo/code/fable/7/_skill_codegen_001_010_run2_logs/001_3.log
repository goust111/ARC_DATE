+    shape = parsed["shape"]
+    bg = parsed["bg"]
+    tr, tc = parsed["top_anchor"]
+    br, bc = parsed["bottom_anchor"]
+    delta = (tr - br, tc - bc)
+
+    top_set = {tuple(map(int, rc)) for rc in np.argwhere(parsed["top_mask"])}
+    aligned_bottom_set = set()
+    for r, c in np.argwhere(parsed["bottom_mask"]):
+        rr = int(r) + delta[0]
+        cc = int(c) + delta[1]
+        if in_bounds(shape, rr, cc):
