+def _translate_mask(mask: np.ndarray, delta: tuple[int, int], out_shape: tuple[int, int]) -> np.ndarray:
+    dr, dc = map(int, delta)
+    out = np.zeros(out_shape, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r) + dr
+        cc = int(c) + dc
+        if in_bounds(out_shape, rr, cc):
