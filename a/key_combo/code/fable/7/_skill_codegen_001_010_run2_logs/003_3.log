+def _tile_plane(patterns: np.ndarray, crop_box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = crop_box
+    return patterns[r0 : r1 + 1, c0 : c1 + 1].copy()
