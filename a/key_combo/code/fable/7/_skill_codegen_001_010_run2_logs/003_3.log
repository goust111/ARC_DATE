+    # Replace most visible cells with the impostor, then add sparse noise.
+    for ir, ic in visible_cells:
+        tile = true_tile if (ir, ic) in true_cells else impostor_tile
+        src_r0 = ir * th
+        src_c0 = ic * tw
+        dst_r0 = offset_r + src_r0 - top_trim
