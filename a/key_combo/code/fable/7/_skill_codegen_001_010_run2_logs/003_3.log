+    rr0, cc0, rr1, cc1 = region_box
+    tr0, tc0, _tr1, _tc1 = anchor_box
+    th, tw = template.shape
+    rows = (np.arange(rr0, rr1 + 1) - int(tr0)) % int(th)
+    cols = (np.arange(cc0, cc1 + 1) - int(tc0)) % int(tw)
+    return template[np.ix_(rows, cols)]
