+    meta = {
+        "bg": int(bg),
+        "guide_color": int(guide_color),
+        "region_box": region_box,
+        "guide_box": guide_box,
+        "true_tile": true_tile,
+        "impostor_tile": impostor_tile,
+        "visible_cells": visible_cells,
+        "true_cells": true_cells,
