+
+
+def _is_singleton_color(grid: np.ndarray, color: int) -> bool:
+    coords = np.argwhere(grid == int(color))
+    if len(coords) == 0:
+        return False
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and int(grid[nr, nc]) == int(color):
+                return False
