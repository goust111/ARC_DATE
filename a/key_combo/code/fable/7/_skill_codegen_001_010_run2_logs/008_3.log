    assert np.array_equal(got, exp)
    r, c = marker_pos
    if r == 0:
        side_counter['"'top'] += 1
    elif r == inp.shape[0] - 1:
        side_counter['bottom'] += 1
    elif c == 0:
        side_counter['left'] += 1
    else:
