def comps(grid):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            color = int(grid[r, c])
            if color == 0 or seen[r, c]:
                continue
            stack = [(r, c)]
            cells = []
            seen[r, c] = True
            while stack:
                rr, cc = stack.pop()
                cells.append((rr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            out.append((color, cells))
    return out

def classify(grid):
    h, w = grid.shape
    marker = None
    frames = []
    for color, cells in comps(grid):
        rs = [r for r, _ in cells]
        cs = [c for _, c in cells]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        if len(cells) == 1:
            r, c = cells[0]
            assert (r in (0, h - 1)) "'^ (c in (0, w - 1))
            assert marker is None
            marker = (r, c, color)
            continue
        hh = r1 - r0 + 1
        ww = c1 - c0 + 1
        assert hh >= 3 and ww >= 3
        border = {(r0, cc) for cc in range(c0, c1 + 1)} | {(r1, cc) for cc in range(c0, c1 + 1)} | {(rr, c0) for rr in range(r0, r1 + 1)} | {(rr, c1) for rr in range(r0, r1 + 1)}
        assert set(cells) == border
        frames.append((color, (r0, c0, r1, c1)))
    assert marker is not None and frames
    return marker, frames

def expected(grid):
    marker, frames = classify(grid)
    h, w = grid.shape
    r, c, color = marker
    if r == 0:
        crossed = [f for f in frames if f[1][1] < c < f[1][3]]
        crossed.sort(key=lambda x: x[1][0])
    elif r == h - 1:
        crossed = [f for f in frames if f[1][1] < c < f[1][3]]
        crossed.sort(key=lambda x: x[1][2], reverse=True)
    elif c == 0:
        crossed = [f for f in frames if f[1][0] < r < f[1][2]]
        crossed.sort(key=lambda x: x[1][1])
    else:
        crossed = [f for f in frames if f[1][0] < r < f[1][2]]
        crossed.sort(key=lambda x: x[1][3], reverse=True)
    out = grid.copy()
    relay = color
    for frame_color, (r0, c0, r1, c1) in crossed:
        out[r0 + 1:r1, c0 + 1:c1] = relay
        relay = frame_color
    return out, len(crossed), len(frames) - len(crossed), (r, c)

side_counter = Counter()
hit_counter = Counter()
distractor_counter = Counter()
