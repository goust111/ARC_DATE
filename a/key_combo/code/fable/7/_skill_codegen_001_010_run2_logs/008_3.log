+def _sample_hit_boxes(height: int, width: int, ray_c: int, hit_count: int) -> list[tuple[int, int, int, int]] | None:
+    _height = height
+    _width = width
+    rows_height, row_spans = _sample_hit_rows(hit_count)
+    if rows_height != height:
+        return None
+    boxes = []
+    for r0, r1 in row_spans:
+        candidates = []
+        max_rect_w = min(10, width - 2)
