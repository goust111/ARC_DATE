+
+def _sample_partition() -> tuple[list[int], list[int]]:
+    single_row = [option for option in PARTITIONS if len(option[0]) == 1]
+    two_row_distinct = [option for option in PARTITIONS if len(option[0]) == 2 and len(set(option[0])) == 2]
