+    for row in (0, h - 1):
+        cols = np.flatnonzero(grid[row] != int(bg))
+        if len(cols) == 0:
+            continue
+        assert np.all(cols == np.arange(int(cols[0]), int(cols[-1]) + 1)), "legend must be one contiguous edge run"
+        c0 = int(cols[0])
+        c1 = int(cols[-1])
