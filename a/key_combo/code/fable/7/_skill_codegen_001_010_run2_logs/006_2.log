        else:
            raise ValueError(f"unknown recolor mode: {mode}")
        out[r0 : r1 + 1, c0 : c1 + 1] = seq[idx]

    return out


def _parse_puzzle(grid: np.ndarray) -> tuple[int, tuple[int, ...], list[dict]]:
