+    legend_c0: int,
+    legend_c1: int,
+) -> list[dict]:
+    mask = grid != int(bg)
+    mask[int(legend_row), int(legend_c0) : int(legend_c1) + 1] = False
+    components = _components_mask(mask)
+    assert components, "expected at least one solid rectangle"
+
