+        path = [(c0, r0) for r0, c0 in path]
+    return path
+
+
+def _gate_candidates(path: list[tuple[int, int]], shape: tuple[int, int]) -> list[Gate]:
+    path_set = set(path)
+    candidates = []
+    for idx in range(1, len(path) - 1):
