+def _path_neighbors(path_mask: np.ndarray, cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [
+        (nr, nc)
+        for nr, nc in neighbors4(r, c)
+        if in_bounds(path_mask.shape, nr, nc) and bool(path_mask[nr, nc])
