+BG = Color.BLACK
+PATH = Color.GREEN
+GATE_END = Color.RED
+GRAY = Color.GREY
+ORANGE = Color.ORANGE
+MARKER_COLORS = {GRAY, ORANGE}
+PATHLIKE_COLORS = {PATH, GRAY, ORANGE}
