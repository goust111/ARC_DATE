+                (facing_side == "left" and cell[1] == tail["c0"])
+                or (facing_side == "right" and cell[1] == tail["bbox"][3])
+                or (facing_side == "top" and cell[0] == tail["r0"])
+                or (facing_side == "bottom" and cell[0] == tail["bbox"][2])
