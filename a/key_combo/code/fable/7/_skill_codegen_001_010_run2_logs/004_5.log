+    assert frames, "expected at least one frame"
+    start_candidates = [
+        idx
+        for idx, frame in enumerate(frames)
+        if frame["r0"] < seed_r < frame["bbox"][2] and frame["c0"] < seed_c < frame["bbox"][3]
+    ]
