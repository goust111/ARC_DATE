+                trigger(gap_idx)
+                return
+            if int(g[r, c]) == GREY:
+                hit_idx = wall_owner.get((r, c))
+                if hit_idx is not None and not filled[hit_idx]:
+                    trigger(hit_idx)
+                return
+            out[r, c] = fill_color
+            r += dr
+            c += dc
+
+    def trigger(frame_idx: int) -> None:
+        if filled[frame_idx]:
+            return
+        frame = frames[frame_idx]
+        r0, c0, r1, c1 = frame["bbox"]
+        out[r0 + 1 : r1, c0 + 1 : c1] = fill_color
+        filled[frame_idx] = True
+        cast_from(frame_idx)
