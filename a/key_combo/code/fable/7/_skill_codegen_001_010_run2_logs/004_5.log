+
+GREY = 5
+SIDES = ("top", "bottom", "left", "right")
+DIR_BY_SIDE = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ENTRY_SIDE_BY_DIR = {
+    (-1, 0): "bottom",
+    (1, 0): "top",
+    (0, -1): "right",
+    (0, 1): "left",
+}
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_SIZE_RANGE = (22, 30)
+FRAME_H_RANGE = (4, 7)
+FRAME_W_RANGE = (4, 7)
+LINK_DIST_RANGE = (3, 8)
+GEN_RETRIES = 500
