+def _generate_case() -> dict | None:
+    shape = (random.randint(*GRID_SIZE_RANGE), random.randint(*GRID_SIZE_RANGE))
+    seed_color = random.choice(SEED_COLORS)
+    active_len = random.randint(2, 4)
