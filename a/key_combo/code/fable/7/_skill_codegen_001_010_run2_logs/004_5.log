+        return None
+    return case
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        case = _generate_case()
+        if case is None:
+            continue
+        if not np.array_equal(main(case["input"]), case["expected"]):
+            continue
+        return case["input"].copy()
+    raise RuntimeError("failed to generate valid input for task 5")

