+        for offset in _valid_offsets(frame["h"], frame["w"], side):
+            candidate = _make_frame(frame["r0"], frame["c0"], frame["h"], frame["w"], side, offset)
+            ray = _ray_to_edge(candidate["gap"], candidate["dir"], (h, w))
