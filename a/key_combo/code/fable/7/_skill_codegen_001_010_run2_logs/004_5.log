+        "bg": 0,
+        "seed_color": seed_color,
+        "frames": frames,
+        "obstacles": obstacles,
+        "seed_pos": seed_pos,
+        "planned_filled": planned_filled,
+        "final_gap_hit": final_gap_hit,
