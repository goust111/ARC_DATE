+                candidate
+                for candidate in candidates
+                if all(
+                    not any(_inside_bbox(cell, other) for other in frames)
+                    for cell in _ray_to_edge(candidate["gap"], candidate["dir"], shape)[1:]
+                )
+            ]
+
+        if candidates:
