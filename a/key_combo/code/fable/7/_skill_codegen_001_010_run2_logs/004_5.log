+
+def _detect_case(grid: np.ndarray) -> tuple[list[dict], set[tuple[int, int]], int, int]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    other_colors = sorted(int(v) for v in np.unique(g) if int(v) not in (bg, GREY))
