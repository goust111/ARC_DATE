+def _parse_frame_component(grid: np.ndarray, coords: np.ndarray) -> dict | None:
+    if len(coords) < 8:
+        return None
+    r0, c0, r1, c1 = bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
+        border.add((r, c0))
+        border.add((r, c1))
+    cells = {tuple(map(int, p)) for p in coords}
+    if not cells.issubset(border):
+        return None
+    if len(cells) != len(border) - 1:
+        return None
+    gap_candidates = [cell for cell in border if cell not in cells]
+    if len(gap_candidates) != 1:
+        return None
+    gap = gap_candidates[0]
+    if gap in {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}:
+        return None
+    if gap[0] == r0:
+        side = "top"
+        offset = gap[1] - c0
+    elif gap[0] == r1:
+        side = "bottom"
+        offset = gap[1] - c0
+    elif gap[1] == c0:
+        side = "left"
+        offset = gap[0] - r0
+    else:
+        side = "right"
+        offset = gap[0] - r0
