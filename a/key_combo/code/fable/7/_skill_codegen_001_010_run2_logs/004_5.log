+        if (r, c0) != gap:
+            yield (r, c0)
+        if (r, c1) != gap:
+            yield (r, c1)
+
+
+def _frame_interior(frame: dict):
+    r0, c0, r1, c1 = frame["bbox"]
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
