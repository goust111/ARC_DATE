+def _frame_wall_cells(frame: dict):
+    r0, c0, r1, c1 = frame["bbox"]
+    gap = _frame_gap(frame)
+    for c in range(c0, c1 + 1):
+        if (r0, c) != gap:
+            yield (r0, c)
+        if (r1, c) != gap:
+            yield (r1, c)
+    for r in range(r0 + 1, r1):
+        if (r, c0) != gap:
+            yield (r, c0)
+        if (r, c1) != gap:
+            yield (r, c1)
