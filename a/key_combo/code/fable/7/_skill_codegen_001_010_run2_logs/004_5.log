+def _make_frame(r0: int, c0: int, h: int, w: int, side: str, offset: int) -> dict:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if side == "top":
+        gap = (r0, c0 + offset)
+    elif side == "bottom":
+        gap = (r1, c0 + offset)
+    elif side == "left":
+        gap = (r0 + offset, c0)
+    else:
+        gap = (r0 + offset, c1)
+    frame = {
+        "r0": int(r0),
+        "c0": int(c0),
+        "h": int(h),
+        "w": int(w),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "side": side,
+        "offset": int(offset),
+        "gap": gap,
+        "dir": DIR_BY_SIDE[side],
