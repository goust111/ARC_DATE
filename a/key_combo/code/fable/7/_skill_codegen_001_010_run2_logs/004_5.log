+    obstacle_cells: set[tuple[int, int]] = set()
+    for comp in components_mask(g == GREY, connectivity=4):
+        frame = _parse_frame_component(g, comp)
+        if frame is None:
+            obstacle_cells.update(tuple(map(int, p)) for p in comp)
+        else:
