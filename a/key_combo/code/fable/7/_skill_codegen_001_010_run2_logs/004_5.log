+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+GREY = 5
+SIDES = ("top", "bottom", "left", "right")
+DIR_BY_SIDE = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ENTRY_SIDE_BY_DIR = {
+    (-1, 0): "bottom",
+    (1, 0): "top",
+    (0, -1): "right",
+    (0, 1): "left",
+}
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_SIZE_RANGE = (22, 30)
+FRAME_H_RANGE = (4, 7)
+FRAME_W_RANGE = (4, 7)
+LINK_DIST_RANGE = (3, 8)
+GEN_RETRIES = 500
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert connectivity == 4
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _make_frame(r0: int, c0: int, h: int, w: int, side: str, offset: int) -> dict:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if side == "top":
+        gap = (r0, c0 + offset)
+    elif side == "bottom":
+        gap = (r1, c0 + offset)
+    elif side == "left":
+        gap = (r0 + offset, c0)
+    else:
+        gap = (r0 + offset, c1)
+    frame = {
+        "r0": int(r0),
+        "c0": int(c0),
+        "h": int(h),
+        "w": int(w),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "side": side,
+        "offset": int(offset),
+        "gap": gap,
+        "dir": DIR_BY_SIDE[side],
+    }
+    frame["walls"] = set(_frame_wall_cells(frame))
+    return frame
+
+
+def _valid_offsets(h: int, w: int, side: str) -> list[int]:
+    span = w if side in ("top", "bottom") else h
+    return list(range(1, span - 1))
+
+
+def _frame_gap(frame: dict) -> tuple[int, int]:
+    return tuple(frame["gap"])
+
+
+def _frame_wall_cells(frame: dict):
+    r0, c0, r1, c1 = frame["bbox"]
+    gap = _frame_gap(frame)
+    for c in range(c0, c1 + 1):
+        if (r0, c) != gap:
+            yield (r0, c)
+        if (r1, c) != gap:
+            yield (r1, c)
+    for r in range(r0 + 1, r1):
+        if (r, c0) != gap:
+            yield (r, c0)
+        if (r, c1) != gap:
+            yield (r, c1)
+
+
+def _frame_interior(frame: dict):
+    r0, c0, r1, c1 = frame["bbox"]
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            yield (r, c)
+
+
+def _inside_bbox(cell: tuple[int, int], frame: dict) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = frame["bbox"]
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _boxes_clear(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return (
+        ar1 + pad < br0 - pad
+        or br1 + pad < ar0 - pad
+        or ac1 + pad < bc0 - pad
+        or bc1 + pad < ac0 - pad
+    )
+
+
+def _path_cells(start: tuple[int, int], direction: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = direction
+    if dr != 0:
+        if start[1] != end[1] or (end[0] - start[0]) * dr < 0:
+            raise ValueError("end is not reachable from start along the given vertical ray")
+    else:
+        if start[0] != end[0] or (end[1] - start[1]) * dc < 0:
+            raise ValueError("end is not reachable from start along the given horizontal ray")
+    r, c = start
+    out = []
+    while True:
+        out.append((r, c))
+        if (r, c) == end:
+            return out
+        r += dr
+        c += dc
+
+
+def _ray_to_edge(start: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = direction
+    r, c = start
+    out = []
+    while in_bounds(shape, r, c):
+        out.append((r, c))
+        r += dr
+        c += dc
+    return out
+
+
+def _parse_frame_component(grid: np.ndarray, coords: np.ndarray) -> dict | None:
+    if len(coords) < 8:
+        return None
+    r0, c0, r1, c1 = bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0 + 1, r1):
+        border.add((r, c0))
+        border.add((r, c1))
+    cells = {tuple(map(int, p)) for p in coords}
+    if not cells.issubset(border):
+        return None
+    if len(cells) != len(border) - 1:
+        return None
+    gap_candidates = [cell for cell in border if cell not in cells]
+    if len(gap_candidates) != 1:
+        return None
+    gap = gap_candidates[0]
+    if gap in {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}:
+        return None
+    if gap[0] == r0:
+        side = "top"
+        offset = gap[1] - c0
+    elif gap[0] == r1:
+        side = "bottom"
+        offset = gap[1] - c0
+    elif gap[1] == c0:
+        side = "left"
+        offset = gap[0] - r0
+    else:
+        side = "right"
+        offset = gap[0] - r0
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if int(grid[r, c]) == GREY:
