+
+    for _ in range(300):
+        fh = random.randint(*FRAME_H_RANGE)
+        fw = random.randint(*FRAME_W_RANGE)
+        dist = random.randint(*LINK_DIST_RANGE)
+
+        if (dr, dc) == (0, 1):
+            c0 = gap_c + dist
+            if c0 + fw > w_grid:
+                continue
+            lo = max(0, gap_r - (fh - 2))
+            hi = min(h_grid - fh, gap_r - 1)
+            if lo > hi:
