+        return None
+
+    reserved: set[tuple[int, int]] = set()
+    specs = _group_specs(order, rng)
+    placed_groups = 0
+    wrap_groups = 0
+    changed_groups = 0
+    index = {color: i for i, color in enumerate(order)}
+
+    for color, size in specs:
+        group = _grow_group(rng, safe_by_color[color], reserved, size)
+        if group is None:
