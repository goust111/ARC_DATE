+def _crossing_edges(
+    grid: np.ndarray, colors: list[int], masks: dict[int, np.ndarray]
+) -> set[tuple[int, int]]:
+    edges: set[tuple[int, int]] = set()
+    for a, b in combinations(colors, 2):
+        crossing = masks[a] & masks[b]
+        if not crossing.any():
+            continue
+        visible = {int(v) for v in grid[crossing].tolist() if int(v) != BG}
