+def _group_specs(order: list[int], rng: random.Random) -> list[tuple[int, int]]:
+    count = len(order)
+    specs = [
+        (order[-1], 2),
+        (order[0], 2),
+        (order[min(1, count - 1)], 1),
+    ]
