+        for r, c in group:
+            grid[r, c] = color
+        _reserve_with_halo(reserved, group, grid.shape)
+        placed_groups += 1
+        if index[color] + size >= len(order):
+            wrap_groups += 1
+        if order[(index[color] + size) % len(order)] != color:
+            changed_groups += 1
+
+    if placed_groups < max(4, len(order)):
+        return None
+    if wrap_groups == 0 or changed_groups < 3:
+        return None
+    return grid
+
