+
+    for color in order:
+        if rng.random() < 0.75:
+            size = rng.randint(1, count + 2)
+            if size % count == 0:
+                size += 1
+            specs.append((color, min(size, count + 2)))
+
+    extra = rng.randint(1, count)
+    for _ in range(extra):
+        color = rng.choice(order)
+        size = rng.randint(1, count + 2)
