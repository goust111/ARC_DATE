+
+
+def _safe_cells_for_color(
+    bbox: tuple[int, int, int, int], forbidden: np.ndarray
+) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    safe: set[tuple[int, int]] = set()
+    for r in range(r0 + 2, r1 - 1):
+        for c in range(c0 + 2, c1 - 1):
+            if not forbidden[r, c]:
