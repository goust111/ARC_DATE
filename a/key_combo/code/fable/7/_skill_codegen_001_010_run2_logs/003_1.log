+) -> tuple[np.ndarray, dict[int, np.ndarray]]:
+    grid = np.full(shape, BG, dtype=int)
+    masks = {color: _frame_mask(shape, bboxes[color]) for color in order}
+    for color in order:
+        grid[masks[color]] = color
+    return grid, masks
