+def _unique_chain(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:
+    succ = {color: set() for color in colors}
+    indeg = {color: 0 for color in colors}
+    for src, dst in edges:
+        if dst not in succ[src]:
+            succ[src].add(dst)
+            indeg[dst] += 1
