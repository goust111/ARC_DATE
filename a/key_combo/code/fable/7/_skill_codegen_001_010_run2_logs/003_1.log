+def _place_groups(
+    rng: random.Random,
+    frame_grid: np.ndarray,
+    order: list[int],
+    bboxes: dict[int, tuple[int, int, int, int]],
+    masks: dict[int, np.ndarray],
+) -> np.ndarray | None:
