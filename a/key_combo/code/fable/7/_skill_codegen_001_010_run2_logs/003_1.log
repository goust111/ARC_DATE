+
+
+def _sample_bboxes(
+    rng: random.Random, height: int, width: int, order: list[int]
+) -> tuple[dict[int, tuple[int, int, int, int]], dict[int, np.ndarray], np.ndarray] | None:
+    for _ in range(120):
+        bboxes: dict[int, tuple[int, int, int, int]] = {}
+        for i, color in enumerate(order):
+            placed = False
+            for _ in range(120):
