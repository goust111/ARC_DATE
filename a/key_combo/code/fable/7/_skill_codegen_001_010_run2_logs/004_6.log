    if np.all(grid[0] == grid[0, 0]) and grid[0, 0] "'!= bg:
        candidates.append(('"'top', int(grid[0, 0])))
    if np.all(grid[-1] == grid[-1, 0]) and grid[-1, 0] "'!= bg:
        candidates.append(('"'bottom', int(grid[-1, 0])))
    if np.all(grid[:, 0] == grid[0, 0]) and grid[0, 0] "'!= bg:
