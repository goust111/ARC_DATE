_GEN_IRREGULAR_BASE_CELLS = ((2, 2), (1, 1))
_GEN_IRREGULAR_TOP_CHOICES = ((0, 0), (0, 1), (0, 2))
_GEN_IRREGULAR_LEFT_CHOICES = ((0, 0), (1, 0))
_GEN_IRREGULAR_EXCLUDED_CELL = (2, 0)
_GEN_IRREGULAR_FILL_RANGE = (4, 8)

