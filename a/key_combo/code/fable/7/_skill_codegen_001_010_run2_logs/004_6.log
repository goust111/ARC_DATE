_GEN_MARKER_CLEARANCE = 1

_GEN_CORNER_SIGN = {
    "tl": (-1, -1),
    "tr": (-1, 1),
    "bl": (1, -1),
    "br": (1, 1),
}
_GEN_KINDS = ("tl", "tr", "bl", "br")


def _gen_square_corners(r0: int, c0: int, side: int) -> dict[str, tuple[int, int]]:
    return {
        "tl": (r0, c0),
        "tr": (r0, c0 + side),
        "bl": (r0 + side, c0),
        "br": (r0 + side, c0 + side),
    }


def _gen_orient_from_tl_anchor(mask: np.ndarray, sign: tuple[int, int]) -> np.ndarray:
    out = mask.copy()
    if sign[0] > 0:
        out = out[::-1, :]
    if sign[1] > 0:
        out = out[:, ::-1]
    return out


