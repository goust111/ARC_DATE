import itertools, numpy as np
from collections import deque

def find(h,w):
    cells=[(r,c) for r in range(h) for c in range(w)]
    orbits=[]
    seen=set()
    for cell in cells:
        if cell in seen: continue
        m=(h-1-cell[0],w-1-cell[1])
        if m==cell:
            seen.add(cell)
            continue
        seen.add(cell); seen.add(m)
        orbits.append((cell,m))
    n=len(orbits)
    for picks in itertools.product([0,1,2], repeat=n):
        # 0 none,1 first,2 second
        sel=[]
        for pick,(a,b) in zip(picks,orbits):
            if pick==1: sel.append(a)
            elif pick==2: sel.append(b)
        if not sel: continue
        arr=np.zeros((h,w),dtype=int)
        for r,c in sel: arr[r,c]=1
        if not (arr[0].any() and arr[-1].any() and arr[:,0].any() and arr[:,-1].any()):
            continue
        s=set(sel)
        q=deque([sel[0]]); seen2={sel[0]}
        while q:
            r,c=q.popleft()
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                nb=(r+dr,c+dc)
                if nb in s and nb not in seen2:
                    seen2.add(nb); q.append(nb)
        if len(seen2)==len(s):
            return arr
    return None

for shape in [(4,5),(5,4),(5,5)]:
    arr=find(*shape)
    print(shape, arr is not None)
    if arr is not None:
        print(arr)
