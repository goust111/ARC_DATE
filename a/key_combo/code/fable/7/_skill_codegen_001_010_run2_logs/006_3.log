+        return None
+    answer_a, answer_b = answer_pair
+
+    decoy = _gen_decoy_mask(answer_shape, [answer_a, answer_b])
+    if decoy is None:
+        return None
+
+    masks = [answer_a, answer_b, decoy, decoy.copy()]
+
+    if random.random() < 0.45:
