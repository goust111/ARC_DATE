+            def _score(cell: tuple[int, int]) -> tuple[int, float]:
+                r, c = cell
+                hits = int(r == 0) + int(r == h - 1) + int(c == 0) + int(c == w - 1)
+                return hits, random.random()
+
+            frontier = sorted(set(frontier), key=_score, reverse=True)
+            cells.add(frontier[0])
