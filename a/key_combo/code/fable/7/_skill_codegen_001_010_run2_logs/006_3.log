+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0])
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _sprite_patch(
+    grid: np.ndarray,
+    component: dict,
+    bg: int,
+) -> tuple[np.ndarray, np.ndarray]:
