+        return None
+
+    path = []
+    cur = target
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+
+    path_cells = set(path)
+    if antisymmetric and _has_mirror_conflict(path_cells | used, h, w):
+        return None
+    return path
+
+
+def _grow_connected_mask(
+    h: int,
+    w: int,
+    *,
+    antisymmetric: bool,
+    force_not_symmetric: bool,
+) -> np.ndarray | None:
