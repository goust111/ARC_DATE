+def _sample_other_sizes(answer_shape: tuple[int, int], count: int) -> list[tuple[int, int]]:
+    choices = []
+    for h in range(3, 8):
+        for w in range(3, 8):
+            shape = (h, w)
+            if shape != answer_shape:
+                choices.append(shape)
+    random.shuffle(choices)
+    out = []
+    used = {answer_shape}
+    for shape in choices:
+        if shape in used:
+            continue
+        used.add(shape)
+        out.append(shape)
+        if len(out) == count:
+            break
