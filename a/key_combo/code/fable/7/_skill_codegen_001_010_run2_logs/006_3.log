+
+def _grow_connected_mask(
+    h: int,
+    w: int,
+    *,
+    antisymmetric: bool,
+    force_not_symmetric: bool,
+) -> np.ndarray | None:
+    if h < 4 or w < 4:
+        return None
+
+    total_pairs = (h * w) // 2
+    min_area = max(6, h + w - 3)
+    max_area = max(min_area, min(h * w - 2, total_pairs - 1 if antisymmetric else int(0.7 * h * w)))
+    if antisymmetric and max_area < min_area:
+        return None
+
+    for _ in range(200):
