+    H = random.randint(max(18, answer_shape[0] * 2 + 5), 30)
+    W = random.randint(max(18, answer_shape[1] * 2 + 5), 30)
+    grid = _place_patches((H, W), patches, bg)
+    if grid is None:
+        return None
+
+    try:
+        _validate_instance(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
