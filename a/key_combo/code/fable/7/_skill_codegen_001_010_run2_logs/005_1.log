+def _build_pairs(pair_count: int) -> list[dict] | None:
+    pairs = []
+    seen_shapes = set()
+    for _ in range(pair_count):
+        shape = _random_connected_shape()
+        if shape is None:
+            return None
+        sig = _canonical_shape_signature(shape)
+        if sig in seen_shapes:
