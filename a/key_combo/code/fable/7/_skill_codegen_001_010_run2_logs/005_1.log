+def _fits(rect: tuple[int, int, int, int], used: list[tuple[int, int, int, int]], pad: int = PLACEMENT_PAD) -> bool:
+    r0, c0, r1, c1 = rect
+    for ur0, uc0, ur1, uc1 in used:
+        if not (r1 + pad < ur0 or ur1 + pad < r0 or c1 + pad < uc0 or uc1 + pad < c0):
+            return False
+    return True
