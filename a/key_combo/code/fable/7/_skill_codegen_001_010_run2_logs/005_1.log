        return None

    cand_blue = _gen_shift(obj["blue"], canvas.shape, r0, c0)
    cand_block = _gen_shift(obj["block"], canvas.shape, r0, c0)
    for other in placed:
        if np.any(cand_blue & other["block"]) or np.any(cand_block & other["blue"]):
