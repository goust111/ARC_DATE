+def _completed_series(
+    shape: tuple[int, int],
+    visible_anchor: tuple[int, int],
+    orientation: str,
+    length: int,
+    delta: tuple[int, int],
+) -> list[tuple[int, int]]:
+    dr, dc = map(int, delta)
+    assert dr != 0 or dc != 0
+    start = visible_anchor
+    prev = (start[0] - dr, start[1] - dc)
+    while _segment_fits(shape, prev, orientation, length):
+        start = prev
+        prev = (start[0] - dr, start[1] - dc)
