+    length = parsed[0][2]
+    anchors = sorted([item[1] for item in parsed])
+    delta = (anchors[1][0] - anchors[0][0], anchors[1][1] - anchors[0][1])
+    assert delta != (0, 0), "period vector must be non-zero"
