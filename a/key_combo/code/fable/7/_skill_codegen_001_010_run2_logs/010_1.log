  30:     H, W = input_grid.shape
  31: 
  32:     # Infer the square "corner region" side length k from the farthest non-black pixel
  33:     # in each corner, after assigning pixels to their nearest corner.
  34:     coords = np.argwhere(input_grid != bg)
  35:     assert coords.size > 0
  36: 
  37:     # Corner assignments by Manhattan distance to each corner.
  38:     # corner order: TL, TR, BL, BR
  39:     d_tl = coords[:, 0] + coords[:, 1]
  40:     d_tr = coords[:, 0] + (W - 1 - coords[:, 1])
  41:     d_bl = (H - 1 - coords[:, 0]) + coords[:, 1]
  42:     d_br = (H - 1 - coords[:, 0]) + (W - 1 - coords[:, 1])
  43:     ds = np.stack([d_tl, d_tr, d_bl, d_br], axis=1)
  44:     corner_idx = ds.argmin(axis=1)
  45: 
  46:     k_candidates: list[int] = []
  47:     for i in range(4):
