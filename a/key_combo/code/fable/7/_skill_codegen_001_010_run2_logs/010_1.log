  52:         cs = pts[:, 1]
  53:         if i == 0:  # TL
  54:             k_i = max(int(rs.max() + 1), int(cs.max() + 1))
  55:         elif i == 1:  # TR
  56:             k_i = max(int(rs.max() + 1), int(W - cs.min()))
  57:         elif i == 2:  # BL
  58:             k_i = max(int(H - rs.min()), int(cs.max() + 1))
