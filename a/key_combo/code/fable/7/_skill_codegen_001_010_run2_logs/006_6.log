+    grid_w = cols * cell_w + (cols - 1) * DIVIDER_THICKNESS
+    if grid_h > 30 or grid_w > 30:
+        return None
+
+    grid = np.full((grid_h, grid_w), int(divider_color), dtype=int)
+
+    for row in range(rows):
+        r0 = row * (cell_h + DIVIDER_THICKNESS)
+        for col in range(cols):
