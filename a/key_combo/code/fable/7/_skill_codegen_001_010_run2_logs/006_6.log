def parse_independently(grid: np.ndarray):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    row_map = {}
    col_map = {}
    for r in range(H):
        if np.all(g[r] == g[r, 0]):
            row_map.setdefault(int(g[r, 0]), []).append(r)
    for c in range(W):
        if np.all(g[:, c] == g[0, c]):
            col_map.setdefault(int(g[0, c]), []).append(c)
    divider_colors = sorted(set(row_map) & set(col_map))
    assert len(divider_colors) == 1
    divider = divider_colors[0]
    div_r = row_map[divider]
    div_c = col_map[divider]

    def segments(n, divs):
        spans = []
        s = 0
        for d in divs:
            assert d > s
            spans.append((s, d))
            s = d + 1
        spans.append((s, n))
        lens = {b - a for a, b in spans}
        assert len(lens) == 1
        return spans

    row_spans = segments(H, div_r)
    col_spans = segments(W, div_c)
    cells = [[g[r0:r1, c0:c1].copy() for c0, c1 in col_spans] for r0, r1 in row_spans]

    backdrops = []
    diffs = []
    for row in cells:
        keys = [cell.tobytes() for cell in row]
        counts = Counter(keys)
        assert sorted(counts.values()) == [1, len(row) - 1]
        major = counts.most_common(1)[0][0]
        backdrop = next(cell for cell in row if cell.tobytes() == major).copy()
        outlier = next(cell for cell in row if cell.tobytes() "'!= major).copy()
        diff = outlier != backdrop
        assert diff.any()
        pts = np.argwhere(diff)
        r0, c0 = pts.min(axis=0)
        r1, c1 = pts.max(axis=0)
        patch = outlier[r0:r1 + 1, c0:c1 + 1].copy()
        mask = diff[r0:r1 + 1, c0:c1 + 1].copy()
        backdrops.append(backdrop)
        diffs.append((patch, mask, (int(r0), int(c0))))

    for b in backdrops[1:]:
        assert np.array_equal(b, backdrops[0])

    positions = [pos for _patch, _mask, pos in diffs]
    delta = (positions[1][0] - positions[0][0], positions[1][1] - positions[0][1])
    assert delta != (0, 0)
    for i in range(1, len(positions) - 1):
        assert (positions[i + 1][0] - positions[i][0], positions[i + 1][1] - positions[i][1]) == delta

    ref_patch, ref_mask, _ = diffs[0]
    for patch, mask, _ in diffs[1:]:
        assert np.array_equal(mask, ref_mask)
        assert np.array_equal(patch[mask], ref_patch[ref_mask])

    nr = positions[-1][0] + delta[0]
    nc = positions[-1][1] + delta[1]
    out = backdrops[0].copy()
    view = out[nr:nr + ref_patch.shape[0], nc:nc + ref_patch.shape[1]]
    view[ref_mask] = ref_patch[ref_mask]
    return out, delta, len(row_spans), len(col_spans)

