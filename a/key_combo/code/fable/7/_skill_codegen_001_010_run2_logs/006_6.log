+    start, velocity = _choose_motion(cell_h, cell_w, sprite_h, sprite_w, rows)
+    positions = [(start[0] + i * velocity[0], start[1] + i * velocity[1]) for i in range(rows + 1)]
+
+    outlier_cols = [random.randrange(cols) for _ in range(rows)]
