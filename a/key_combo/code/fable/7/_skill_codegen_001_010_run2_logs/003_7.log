        r0, c0, r1, c1 = box
        if gr0 <= r0 and gc0 <= c0 and r1 <= gr1 and c1 <= gc1:
            selected.append(box)

    assert len(selected) == 1, "expected exactly one sprite inside the guide bbox"
    return crop_bbox(g, selected[0])

