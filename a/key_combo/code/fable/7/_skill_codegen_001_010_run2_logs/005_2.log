+
+        sequence = random.sample(PALETTE, layers)
+        grid = np.zeros((h, w), dtype=int)
+        top = random.randint(0, h - side)
+        left = random.randint(0, w - side)
+        legend_bbox = _paint_legend(grid, top, left, sequence, even_side)
+        try:
