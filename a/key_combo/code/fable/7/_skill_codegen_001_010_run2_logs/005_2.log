+
+def _distance_field(shape: tuple[int, int], seed: tuple[int, int], *, metric: str = "chebyshev") -> np.ndarray:
+    rr, cc = np.indices(shape)
+    sr, sc = seed
+    dr = np.abs(rr - int(sr))
+    dc = np.abs(cc - int(sc))
+    if metric == "chebyshev":
+        return np.maximum(dr, dc)
+    if metric == "manhattan":
+        return dr + dc
+    raise ValueError(f"unknown metric: {metric}")
