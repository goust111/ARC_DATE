_GEN_N = 30
_GEN_SYM_SUM = 31
_GEN_MASK = 6
_GEN_COLORS = (1, 2, 3, 4, 5, 7, 8, 9)

# Orbit-color allocation bounds.
_GEN_MIN_COLOR_ORBITS, _GEN_MAX_COLOR_ORBITS = 5, 36

# Mask size and connected-component constraints.
_GEN_TARGET_MIN_CELLS = 39
