+        grid.shape,
+        spec["outer_seed"],
+        spec["inner_seed"],
+        list(spec["sequence"]),
+        metric="manhattan",
+    )
+    wrong_no_ties = _render_competition(
+        grid.shape,
+        spec["outer_seed"],
+        spec["inner_seed"],
+        list(spec["sequence"]),
+        keep_ties_black=False,
+    )
+    if np.array_equal(expected, wrong_same_direction):
