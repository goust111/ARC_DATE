    runs = []
    start = 0
    color = values[0]
    for i in range(1, len(values)):
        if values[i] "'!= color:
            runs.append((start, i - start, color))
            start = i
            color = values[i]
    runs.append((start, len(values) - start, color))
    if len(runs) > 1 and runs[0][2] == runs[-1][2]:
        s_last, l_last, col = runs.pop()
        _s0, l0, _c0 = runs[0]
        runs[0] = (s_last, l_last + l0, col)
    return runs


