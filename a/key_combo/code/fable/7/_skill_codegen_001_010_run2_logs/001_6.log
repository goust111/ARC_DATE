+def _orientation_missing(full_mask: np.ndarray, observed_mask: np.ndarray) -> int | None:
+    if full_mask.shape != observed_mask.shape:
+        return None
+    if np.any(observed_mask & ~full_mask):
+        return None
+    return int(np.sum(full_mask & ~observed_mask))
+
