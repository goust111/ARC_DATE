    return True


def _place_patch(canvas: np.ndarray, occupied: np.ndarray, patch: np.ndarray) -> bool:
    h, w = patch.shape
    H, W = canvas.shape
    mask = patch != BG
    coords = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
    random.shuffle(coords)
