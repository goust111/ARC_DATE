+    h, w = mask.shape
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    for dr, dc in np.argwhere(mask):
+        rr = r0 + int(dr)
+        cc = c0 + int(dc)
