+        if np.array_equal(canvas, target):
+            continue
+        solved = main(canvas)
+        if not np.array_equal(solved, target):
+            continue
+        changed = (canvas != solved)
+        if int(changed.sum()) == 0:
+            continue
+        return canvas, target
