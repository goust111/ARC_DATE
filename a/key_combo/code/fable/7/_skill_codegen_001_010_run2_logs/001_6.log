+
+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, int], tuple[int, ...]]:
+    arr = mask.astype(np.uint8)
+    a = tuple(int(v) for v in arr.flatten())
+    b = tuple(int(v) for v in np.fliplr(arr).flatten())
+    return tuple(mask.shape), min(a, b)
