+        remove_count = random.randint(1, max_remove)
+        removed = set()
+        if preferred:
+            removed.add(random.choice(preferred))
+        pool = [cell for cell in others + preferred if cell not in removed]
+        need = remove_count - len(removed)
+        if need > len(pool):
