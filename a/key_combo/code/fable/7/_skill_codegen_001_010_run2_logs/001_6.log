+        return False
+    for dr, dc in np.argwhere(mask):
+        rr = r0 + int(dr)
+        cc = c0 + int(dc)
+        if occupied[max(0, rr - 1) : min(H, rr + 2), max(0, cc - 1) : min(W, cc + 2)].any():
+            return False
+    return True
