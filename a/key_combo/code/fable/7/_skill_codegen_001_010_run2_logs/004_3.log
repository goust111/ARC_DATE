        other_col_max = max((int(col_counts[c]) for c in range(w) if c not in col_set), default=-1)
        if min(int(row_counts[r]) for r in row_seps) <= other_row_max:
            continue
        if min(int(col_counts[c]) for c in col_seps) <= other_col_max:
            continue

        score = int(mask.sum())
        if best is None or score > best[3]:
            best = (color, row_seps, col_seps, score)

    assert best is not None, "failed to identify separator color"
