+                adj[room_v].add(room_u)
+            else:
+                blocked_edges.add(frozenset((room_u, room_v)))
+
+    dist = _bfs(adj, seed_room)
+    return {
+        "bg": bg,
+        "sep": sep,
+        "row_ranges": row_ranges,
+        "col_ranges": col_ranges,
+        "seed_room": seed_room,
+        "even_color": even_color,
+        "odd_color": odd_color,
+        "adj": adj,
+        "blocked_edges": blocked_edges,
+        "dist": dist,
+    }
