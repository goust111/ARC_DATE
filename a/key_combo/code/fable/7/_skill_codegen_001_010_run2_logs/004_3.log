+        "sep": sep,
+        "row_ranges": row_ranges,
+        "col_ranges": col_ranges,
+        "seed_room": seed_room,
+        "even_color": even_color,
+        "odd_color": odd_color,
+        "adj": adj,
+        "blocked_edges": blocked_edges,
+        "dist": dist,
