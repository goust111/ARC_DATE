代码已经落盘。现在跑强自检：一部分用 `generate_input()` 做多样性和尺寸检查，另一部分用生成时的干净底图做独立 oracle，确认 `main()` 真的是按题义找 defect 而不是碰巧闭环。
exec
/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import Counter
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/003/4.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()


def orbit_positions(r, c, h, w):
    return tuple(sorted({(r, c), (h - 1 - r, c), (r, w - 1 - c), (h - 1 - r, w - 1 - c)}))


def independent_expected(inp):
    g = np.asarray(inp, dtype=int)
    fg = np.argwhere(g "'!= 0)
    assert fg.size > 0
    r0, c0 = fg.min(axis=0)
    r1, c1 = fg.max(axis=0)
    mosaic = g[r0:r1 + 1, c0:c1 + 1]
    assert np.all(mosaic != 0)
    h, w = mosaic.shape
    out = np.zeros_like(mosaic)
    seen = set()
    defect_total = 0
    for r in range(h):
        for c in range(w):
            if (r, c) in seen:
                continue
            orbit = orbit_positions(r, c, h, w)
            seen.update(orbit)
            colors = [int(mosaic[rr, cc]) for rr, cc in orbit]
            counts = Counter(colors)
            if len(orbit) < 4:
                assert len(counts) == 1
                continue
            if len(counts) == 1:
                continue
            assert len(counts) == 2 and sorted(counts.values()) == [1, 3]
            majority = next(color for color, count in counts.items() if count == 3)
            minority = [pos for pos in orbit if counts[int(mosaic[pos])] == 1]
            assert len(minority) == 1
            rr, cc = minority[0]
            out[rr, cc] = majority
            defect_total += 1
    assert defect_total >= 1
    pts = np.argwhere(out != 0)
    rr0, cc0 = pts.min(axis=0)
    rr1, cc1 = pts.max(axis=0)
    return out[rr0:rr1 + 1, cc0:cc1 + 1]


sigs = set()
input_parities = set()
output_shapes = set()
for i in range(120):
    inp = mod.generate_input()
    out = mod.main(inp)
    exp = independent_expected(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'"'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, exp), 'main disagrees with independent orbit-majority oracle'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    fg = np.argwhere(inp "'!= 0)
    r0, c0 = fg.min(axis=0)
    r1, c1 = fg.max(axis=0)
    input_parities.add(((r1 - r0 + 1) % 2, (c1 - c0 + 1) % 2))
    output_shapes.add(out.shape)

print('"'variants', len(sigs))
print('mosaic_parities', sorted(input_parities))
print('distinct_output_shapes', len(output_shapes))
assert len(sigs) >= 20
assert len(input_parities) >= 3
assert len(output_shapes) >= 12

for i in range(40):
    inp, meta = mod._generate_case(return_meta=True)
    out = mod.main(inp)
    assert np.array_equal(out, meta['expected']), 'main disagrees with generator truth'
    clean = meta['clean_mosaic']
    defects = meta['defect_coords']
    for r, c in defects:
        orbit = orbit_positions(r, c, clean.shape[0], clean.shape[1])
        assert len(orbit) == 4
        vals = [int(clean[rr, cc]) for rr, cc in orbit]
        assert len(set(vals)) == 1
print('oracle_cases', 40)
