+
+        meta = {
+            "clean_mosaic": clean_mosaic,
+            "defect_coords": tuple(defect_coords),
+            "expected": expected,
+            "mosaic_bbox": (top, left, top + mosaic_h - 1, left + mosaic_w - 1),
