    needed_outside = sprite_count - 1
    for h in range(_GEN_GRID_H[0], _GEN_GRID_H[1] + 1):
        for w in range(_GEN_GRID_W[0], _GEN_GRID_W[1] + 1):
            for gh in range(_GEN_GUIDE_H[0], _GEN_GUIDE_H[1] + 1):
