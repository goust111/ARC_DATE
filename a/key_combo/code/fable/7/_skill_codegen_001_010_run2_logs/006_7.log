+def _validate_case(grid: np.ndarray, expected: np.ndarray, meta: dict) -> None:
+    assert isinstance(grid, np.ndarray) and isinstance(expected, np.ndarray)
+    assert grid.ndim == 2 and expected.ndim == 2
