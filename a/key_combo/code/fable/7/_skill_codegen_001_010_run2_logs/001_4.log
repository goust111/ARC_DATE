+        offset_size = bbox_w(rect["bbox"])
+    elif dr == -1:
+        assert r == r1, "upward ray must enter the bottom edge"
+        offset = c - c0
+        exit_edge = (mr0, mc0 + offset)
+        offset_size = bbox_w(rect["bbox"])
+    elif dc == 1:
+        assert c == c0, "rightward ray must enter the left edge"
