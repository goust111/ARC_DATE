+    marker = None
+    by_color = {}
+    for comp in comps:
+        color = int(comp["color"])
+        bbox = _normalize_bbox(comp["bbox"])
+        h = bbox_h(bbox)
+        w = bbox_w(bbox)
+        area = int(comp["area"])
