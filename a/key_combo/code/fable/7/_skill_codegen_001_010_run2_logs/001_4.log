+def _trace_segment_oracle(parsed):
+    g = parsed["grid"]
+    out = g.copy()
+    portal_idx = parsed["portal_idx"]
+    dr, dc = parsed["direction"]
+    r, c = parsed["front"]
+    hits = []
+    seen = set()
+    height, width = g.shape
+
+    while True:
