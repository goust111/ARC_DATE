    rect_norm = sorted((r[1], r[2], r[3], r[4], r[5]) for r in rects)
    assert parsed_norm == rect_norm, (i, parsed_norm, rect_norm)
    out = mod.main(grid)
    assert isinstance(out, np.ndarray)
