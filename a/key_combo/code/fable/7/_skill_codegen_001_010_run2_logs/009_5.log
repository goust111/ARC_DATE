+        row_assign = _assign_two_sides(rng, [(rect[1], rect[2]) for rect in base_rects])
+        col_assign = _assign_two_sides(rng, [(rect[3], rect[4]) for rect in base_rects])
+        if row_assign is None or col_assign is None:
