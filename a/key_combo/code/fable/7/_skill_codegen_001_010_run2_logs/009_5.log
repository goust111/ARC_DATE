+def _assign_two_sides(rng: np.random.Generator, spans: list[tuple[int, int]]) -> list[int] | None:
+    order = sorted(range(len(spans)), key=lambda idx: (spans[idx][0], spans[idx][1]))
+    ends = [-10**9, -10**9]
+    assignment = [-1] * len(spans)
+
+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        start, end = spans[idx]
+        side_order = [0, 1]
