+    sr, sc = seed
+    assert any(
+        int(dist[r, c]) > abs(r - sr) + abs(c - sc)
+        for r, c, _color in samples
+    ), "at least one sample must prove obstacle-aware distance"
+    assert np.all(expected[blockers] == Color.GREY)
