from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
from collections import deque
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/002/5.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

BLACK = mod.Color.BLACK
RED = mod.Color.RED
GREY = mod.Color.GREY


def neigh(r, c):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def bfs(passable, seed):
    h, w = passable.shape
    dist = np.full((h, w), -1, dtype=int)
    q = deque([seed])
    dist[seed] = 0
    while q:
        r, c = q.popleft()
        for rr, cc in neigh(r, c):
            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def infer(samples):
    cands = []
    for k in range(1, len(samples) + 1):
        mp = {}
        ok = True
        for d, color in samples:
            r = d % k
            if r in mp and mp[r] "'!= color:
                ok = False
                break
            mp[r] = color
        if ok and len(mp) == k:
            cands.append(tuple(mp[i] for i in range(k)))
    uniq = []
    for cand in cands:
        if cand not in uniq:
            uniq.append(cand)
    assert len(uniq) == 1, (samples, uniq)
    return uniq[0]

sigs = set()
ks = set()
