+        if c < wall:
+            return "near" if str(config["side"]) == "left" else "far"
+        if c >= wall + thickness:
+            return "near" if str(config["side"]) == "right" else "far"
+        return "wall"
+    if r < wall:
+        return "near" if str(config["side"]) == "top" else "far"
+    if r >= wall + thickness:
+        return "near" if str(config["side"]) == "bottom" else "far"
+    return "wall"
