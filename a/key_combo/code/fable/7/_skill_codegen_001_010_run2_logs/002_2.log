+    cols = mismatch_coords[:, 1]
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    r1 = int(rows.max())
+    c1 = int(cols.max())
+    if (r1 - r0 + 1, c1 - c0 + 1) != (4, 4):
+        return None
+    expected = {(r, c1) for r in range(r0, r0 + 3)}
+    expected |= {(r1, c) for c in range(c0, c0 + 3)}
+    got = {tuple(map(int, rc)) for rc in mismatch_coords}
+    if got != expected:
