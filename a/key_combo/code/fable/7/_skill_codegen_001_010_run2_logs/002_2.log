+    anchors = {(cand["r0"], cand["c0"]) for cand in best}
+    assert len(anchors) == 1, "smallest valid period must identify a unique sample"
+    r0, c0 = next(iter(anchors))
+    return crop_bbox(g, (r0, c0, r0 + 2, c0 + 2))
