+    cols = mismatch_coords[:, 1]
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    r1 = int(rows.max())
+    c1 = int(cols.max())
+    if (r1 - r0 + 1, c1 - c0 + 1) != (4, 4):
+        return None
