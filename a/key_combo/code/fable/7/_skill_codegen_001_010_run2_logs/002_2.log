+    mismatch_set = {tuple(map(int, rc)) for rc in np.argwhere(predicted != grid)}
+    expected_mismatch_set = set(_deviation_positions(meta["r0"], meta["c0"]))
+    return mismatch_set == expected_mismatch_set
+
