+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid, expected, meta = _generate_case()
+        except RuntimeError:
+            continue
+        if _valid_generated_case(grid, expected, meta):
