+        return False
+
+    candidates = _solve_candidates(grid)
+    if not candidates:
+        return False
+    best_area = candidates[0]["area"]
+    best = [cand for cand in candidates if cand["area"] == best_area]
+    if len({(cand["r0"], cand["c0"]) for cand in best}) != 1:
