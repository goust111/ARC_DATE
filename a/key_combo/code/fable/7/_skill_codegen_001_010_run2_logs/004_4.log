0031:     out = g.copy()
0032:     components = components_mask(g == Color.GREY, connectivity=4)
0033:     assert components
0034: 
0035:     for coords in components:
0036:         r0, c0, r1, c1 = bbox_coords(coords)
0037:         assert r0 > 0
0038:         assert r1 - r0 + 1 >= 3
0039:         assert c1 - c0 + 1 == 4
0040: 
0041:         assert np.all(g[r0 + 1 : r1, c0] == Color.GREY)
0042:         assert np.all(g[r0 + 1 : r1, c1] == Color.GREY)
0043:         assert np.all(g[r1, c0 : c1 + 1] == Color.GREY)
0044:         assert np.all(g[r0 + 1 : r1, c0 + 1 : c1] == bg)
0045: 
0046:         top = g[r0, c0 : c1 + 1]
0047:         assert np.count_nonzero(top == Color.GREY) == 3
0048:         gap_offsets = np.flatnonzero(top == bg)
