0050:         gap = c0 + int(gap_offsets[0])
0051: 
0052:         left_cap = gap - 2 >= c0 and np.all(g[r0, gap - 2 : gap] == Color.GREY)
0053:         right_cap = gap + 2 <= c1 and np.all(g[r0, gap + 1 : gap + 3] == Color.GREY)
0054:         assert left_cap != right_cap
0055: 
0056:         fill_region = out[r0:r1, c0 + 1 : c1]
0057:         fill_region[g[r0:r1, c0 + 1 : c1] == bg] = Color.RED
