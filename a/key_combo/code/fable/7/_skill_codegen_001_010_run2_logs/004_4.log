+    if not near:
+        raise RuntimeError("expected at least one near-miss distractor")
+
+    chosen = [random.choice(near)]
+    pool = [dims for dims in candidates if dims not in chosen]
+    while len(chosen) < count:
+        dims = random.choice(pool)
+        chosen.append(dims)
