+def _near_miss(h: int, w: int, cavity_h: int, cavity_w: int) -> bool:
+    for a, b in {(h, w), (w, h)}:
+        if (cavity_h % a == 0) ^ (cavity_w % b == 0):
+            return True
+    return False
