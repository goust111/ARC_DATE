+        steps = []
+        if r < end[0]:
+            steps.append((1, 0))
+        elif r > end[0]:
+            steps.append((-1, 0))
+        if c < end[1]:
+            steps.append((0, 1))
+        elif c > end[1]:
+            steps.append((0, -1))
