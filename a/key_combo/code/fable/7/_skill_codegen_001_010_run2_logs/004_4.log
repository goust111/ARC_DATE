0011: # description:
0012: # In the input you will see a small monochromatic pattern with reflectional symmetry (horizontal and vertical), as well as another monochromatic object in one of its quadrants.
0013: # To make the output, reflect the other object across the axes of reflectional symmetry of the small pattern.
0014: 
0015: def main(input_grid):
0016:     """
0017:     Reflect the non-symmetric object across the horizontal and vertical symmetry axes of the separate symmetric marker.
0018: 
0019:     Input structure:
0020:     - The grid contains exactly two monochromatic non-black objects.
0021:     - One object has both horizontal and vertical mirror symmetry.
0022:     - The other object sits in one quadrant relative to those symmetry axes.
0023: 
0024:     Rule:
0025:     - Detect both objects and identify the one with both mirror axes.
0026:     - Use those axes as symmetries for the whole output grid.
0027:     - For every pixel of the other object, paint all reflected orbit positions with its color.
0028: 
0029:     Key insight:
0030:     - The symmetric object defines the reflection axes; the non-symmetric object supplies
0031:       the pixels to replicate.
0032:     """
0033:     # Plan:
0034:     # 1. Detect the pair of objects and divide them by whether or not they are already symmetric
0035:     # 2. Reflect the non-symmetric object across the axes of symmetry of the symmetric object
0036: 
0037:     # 1. Object detection and setup
0038:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
0039:     assert len(objects) == 2
0040: 
0041:     # Find the object that is symmetric.
0042:     #
0043:     # Important: the *other* object can sometimes have >=2 detected mirror symmetries
0044:     # (e.g. if it happens to be symmetric about one axis), so we specifically look for
0045:     # an object that has BOTH a horizontal-only and a vertical-only mirror symmetry.
0046:     best_obj = None
0047:     best_syms = None
0048:     best_score = (-1, -1)  # (has_both_axes, symmetry_count)
0049:     for obj in objects:
0050:         syms = detect_mirror_symmetry(obj, ignore_colors=[], background=Color.BLACK)
0051:         has_r = any(getattr(s, "mirror_r", None) is not None and getattr(s, "mirror_c", None) is None for s in syms)
0052:         has_c = any(getattr(s, "mirror_r", None) is None and getattr(s, "mirror_c", None) is not None for s in syms)
0053:         score = (1 if (has_r and has_c) else 0, len(syms))
0054:         if score > best_score:
0055:             best_score = score
0056:             best_obj = obj
0057:             best_syms = syms
0058: 
0059:     assert best_obj is not None and best_syms is not None, "There should be a symmetric object"
0060:     symmetric_object = best_obj
0061:     symmetries = best_syms
0062: 
0063:     # Find the object that is not symmetric
0064:     non_symmetric_object = next(obj for obj in objects if obj is not symmetric_object)
0065: 
0066:     # 2. Reflect the non-symmetric object across the axes of symmetry of the symmetric object
0067:     output_grid = input_grid.copy()
0068: 
0069:     for r, c in np.argwhere(non_symmetric_object != Color.BLACK):
0070:         original_color = non_symmetric_object[r, c]
0071:         for transformed_r, transformed_c in orbit(output_grid, r, c, symmetries=symmetries):
0072:             output_grid[transformed_r, transformed_c] = original_color
0073:     
0074:     return output_grid
0075:         
