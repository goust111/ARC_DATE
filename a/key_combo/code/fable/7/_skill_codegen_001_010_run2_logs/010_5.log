+                    out[rr, cc] = int(cell_color)
+                return out
+            rc = (r, c)
+            if rc in occupied and rc != active:
+                stop = ray[-1] if ray else active
+                if stop != active:
+                    moved = occupied.pop(active)
+                    occupied[stop] = moved
+                active = rc
+                break
