+    if not candidates:
+        return None
+    return random.choice(candidates)
+
+
+def _candidate_decoys(
+    shape: tuple[int, int],
+    forbidden: set[tuple[int, int]],
+    isolated_from: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    out = []
+    for r in range(h):
+        for c in range(w):
+            rc = (r, c)
+            if rc in forbidden:
+                continue
+            if not _is_isolated(rc, isolated_from):
+                continue
+            out.append(rc)
+    random.shuffle(out)
+    return out
+
+
+def _alt_simulate(grid: np.ndarray) -> np.ndarray:
