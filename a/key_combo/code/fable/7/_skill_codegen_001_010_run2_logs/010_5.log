+
+        grid = np.zeros(shape, dtype=int)
+        for step in steps:
+            sr, sc = step["start"]
+            grid[sr, sc] = COLOR_BY_DIR[step["direction"]]
+        for (r, c), color in decoys:
+            grid[r, c] = int(color)
+        grid[marker] = GREY
+
+        if _is_valid_instance(grid):
+            return grid
+
+    raise RuntimeError("failed to generate a valid collision-relay input")

