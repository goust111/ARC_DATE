+    r, c = current
+    out = []
+    distance = 0
+    while True:
+        distance += 1
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return out
+        rc = (r, c)
+        if rc in blocked_now:
+            return out
+        if rc in initial_pixels:
+            return out
+        if distance >= 2 and _is_isolated(rc, initial_pixels):
