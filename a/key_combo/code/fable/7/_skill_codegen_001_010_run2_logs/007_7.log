+                "dc": dc,
+                "dr": dr,
+                "rect": rect,
+                "occ_color": occ_color,
+            }
+    raise RuntimeError("failed to generate a valid diagonal-period occlusion instance")
+
+
+def generate_input() -> np.ndarray:
+    return _make_instance()[0]

