+            if rect_area < 2 or rect_area > (h * w) // 3:
+                continue
+            if len(set(map(int, np.unique(full[r0 : r1 + 1, c0 : c1 + 1])))) < 2:
+                continue
+            if not _hidden_keys_covered((h, w), rect, pv, dc, dr):
