+    hidden: dict[tuple[int, int], int] = {}
+    for r in range(h):
+        for c in range(w):
+            key = _canon_key(r, c, pv, dc, dr)
+            total[key] = total.get(key, 0) + 1
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                hidden[key] = hidden.get(key, 0) + 1
+    return bool(hidden) and all(total[key] > hidden[key] for key in hidden)
+
