+def _place_decoy(inp: np.ndarray, out: np.ndarray, occupied: set[tuple[int, int]]) -> bool:
+    h, w = inp.shape
+    color = random.choice(DECOY_COLORS)
+    shape = random.choice(_decoy_shapes())
+    for _ in range(60):
