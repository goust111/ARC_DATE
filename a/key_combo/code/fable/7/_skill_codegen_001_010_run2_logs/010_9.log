+
+def _ordered_path(coords: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    adj = _adjacency(coords)
+    endpoints = sorted(rc for rc, nbrs in adj.items() if len(nbrs) == 1)
+    assert len(endpoints) == 2, "expected exactly two path endpoints"
