+SEGMENT_LEN_RANGE = (2, 6)
+EXTRA_MARGIN_RANGE = (1, 6)
+GRID_LIMIT = 30
+DECOY_COUNT_RANGE = (0, 4)
+GENERATION_RETRIES = 400
