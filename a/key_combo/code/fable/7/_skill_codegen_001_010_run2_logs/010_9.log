+
+
+def _abstract_case() -> dict | None:
+    n_reflections = random.choice(REFLECTION_COUNT_CHOICES)
+    lengths = [random.randint(*SEGMENT_LEN_RANGE) for _ in range(n_reflections + 1)]
+    direction = random.choice([(1, 1), (1, -1), (-1, 1), (-1, -1)])
