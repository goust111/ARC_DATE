+    start = endpoints[0]
+    ordered = [start]
+    prev = None
+    curr = start
+    while True:
+        nxts = [nbr for nbr in adj[curr] if nbr != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "path must not branch"
+        nxt = nxts[0]
+        ordered.append(nxt)
+        prev, curr = curr, nxt
