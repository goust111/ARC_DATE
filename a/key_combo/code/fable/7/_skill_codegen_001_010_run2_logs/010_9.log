+    shifted_path = [(r + r_shift, c + c_shift) for r, c in path]
+    shifted_mirrors = [(rec["mirror"][0] + r_shift, rec["mirror"][1] + c_shift) for rec in mirrors]
+    shifted_corner_records = []
