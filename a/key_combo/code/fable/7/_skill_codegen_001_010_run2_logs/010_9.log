+    r, c = rc
+    return [(r - 1, c - 1), (r - 1, c + 1), (r + 1, c - 1), (r + 1, c + 1)]
+
+
+def _orth_neighbors(rc: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = rc
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
