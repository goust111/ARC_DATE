+    if not all(in_bounds((h, w), r, c) for r, c in shifted_mirrors):
+        return None
+    if not in_bounds((h, w), path[-1][0] + r_shift + last_dir[0], path[-1][1] + c_shift + last_dir[1]):
+        return None
+    return shifted_path, shifted_mirrors, shifted_corner_records, h, w
