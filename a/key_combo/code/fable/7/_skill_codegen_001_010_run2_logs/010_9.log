+    adj = _adjacency(coords)
+    degrees = sorted(len(nbrs) for nbrs in adj.values())
+    if degrees[:2] != [1, 1]:
+        return False
+    if any(deg not in (1, 2) for deg in degrees):
+        return False
+    if any(deg != 2 for deg in degrees[2:]):
+        return False
+    return True
