+BG = Color.BLACK
+TAIL = Color.GREY
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+POS_SLOPE_DIRS = [(-1, -1), (1, 1)]
+NEG_SLOPE_DIRS = [(-1, 1), (1, -1)]
+GEN_ATTEMPTS = 400
+INTERSECTION_MARGIN = 6
+MIN_FRAME_SIDE = 4
+MAX_MARKER_DISTANCE = 4
+MIN_MARKER_DISTANCE = 2
