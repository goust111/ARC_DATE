+
+def _group_cells(groups: list[set[tuple[int, int]]]) -> bool:
+    for i, group_a in enumerate(groups):
+        for j, group_b in enumerate(groups):
+            if i >= j:
+                continue
+            for ra, ca in group_a:
+                for rb, cb in group_b:
+                    if max(abs(ra - rb), abs(ca - cb)) <= 1:
+                        return False
