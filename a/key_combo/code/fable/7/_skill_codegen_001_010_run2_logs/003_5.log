+    "_arc_utils_fable_7_003_5", "/home/lixinyu/snap/new/solvers/arc_utils.py"
+).load_module()
+Color = _ARC_UTILS.Color
+find_components = _ARC_UTILS.find_components
+get_bg = _ARC_UTILS.get_bg
