+
+            left_arm = (hband[0], hband[1], hband[2], vband[1] - 1)
+            right_arm = (hband[0], vband[3] + 1, hband[2], hband[3])
+            arm_masks = [rect for rect in (left_arm, right_arm) if rect[1] <= rect[3]]
+            rng.shuffle(arm_masks)
+            placed = False
+            for rect in arm_masks:
