+    bg = int(get_bg(g))
+    corridors, anchor_signatures = _infer_corridors(g)
+    out = g.copy()
+
+    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
+    for comp in comps:
+        if _comp_signature(comp) in anchor_signatures and _is_solid_rectangle(g, comp, min_side=2):
+            continue
