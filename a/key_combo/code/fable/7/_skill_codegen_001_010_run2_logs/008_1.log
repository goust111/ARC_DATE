+    lc0 = left_margin
+    lc1 = lc0 + left_w - 1
+    rc0 = lc1 + 1 + gap_w
+    rc1 = rc0 + right_w - 1
+
+    tr0 = top_margin
+    tr1 = tr0 + top_h - 1
+    br0 = tr1 + 1 + gap_h
+    br1 = br0 + bottom_h - 1
+
+    gap_c0, gap_c1 = lc1 + 1, rc0 - 1
+    gap_r0, gap_r1 = tr1 + 1, br0 - 1
+
+    col_options = [c0 for c0 in range(gap_c0 + 2, gap_c1 - col_w - 1) if c0 + col_w - 1 <= gap_c1 - 2]
