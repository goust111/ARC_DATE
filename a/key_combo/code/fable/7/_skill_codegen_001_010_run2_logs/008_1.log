+
+            shape = _place_motif(
+                rng,
+                base_grid,
+                input_grid,
+                expected_grid,
+                _rect_mask(base_grid.shape, intersection),
+                [h_corr["axis"], v_corr["axis"]],
+                next_color(),
+                blocked_input,
+                blocked_output,
+                motifs,
+                require_change=True,
