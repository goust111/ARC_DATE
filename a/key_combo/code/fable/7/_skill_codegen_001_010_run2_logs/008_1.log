+                    base_grid,
+                    input_grid,
+                    expected_grid,
+                    _rect_mask(base_grid.shape, corridor["band"]),
+                    [corridor["axis"]],
+                    next_color(),
+                    blocked_input,
+                    blocked_output,
+                    motifs,
+                    require_change=True,
