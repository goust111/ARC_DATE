+
+def _outside_mask(shape: tuple[int, int], corridors: list[dict]) -> np.ndarray:
+    mask = np.ones(shape, dtype=bool)
+    for corridor in corridors:
+        r0, c0, r1, c1 = corridor["band"]
+        mask[r0 : r1 + 1, c0 : c1 + 1] = False
