+    rectangles: list[tuple[int, int, int, int, int]],
+    invalid_groups: list[tuple[int, list[tuple[int, int]]]],
+    seed: tuple[int, int],
+) -> np.ndarray:
+    h, w = shape
+    grid = np.full((h, w), Color.BLACK, dtype=int)
+    for color, points in invalid_groups:
