    max_h = min(RECT_HEIGHT[1], H - 2 * EDGE_BORDER)
    max_w = min(RECT_WIDTH[1], W - 2 * EDGE_BORDER)
    if max_h < RECT_HEIGHT[0] or max_w < RECT_WIDTH[0]:
