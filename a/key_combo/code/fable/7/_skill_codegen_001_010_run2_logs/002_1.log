+
+
+def _sample_inner_rect(outer: tuple[int, int, int, int]) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = outer
+    outer_h = r1 - r0 + 1
+    outer_w = c1 - c0 + 1
+    if outer_h < 9 or outer_w < 9:
