+    rows = sorted(rows_to_cols)
+    for i, r0 in enumerate(rows):
+        cols0 = rows_to_cols[r0]
+        for r1 in rows[i + 1 :]:
+            common = sorted(cols0 & rows_to_cols[r1])
+            for j, c0 in enumerate(common):
+                for c1 in common[j + 1 :]:
+                    rects.add((r0, c0, r1, c1))
+    return sorted(rects)
+
