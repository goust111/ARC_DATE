+        if rect is not None:
+            rect_boxes.append(rect)
+
+    palette = list(range(2, 10))
+    random.shuffle(palette)
+    if len(rect_boxes) + 1 > len(palette):
+        return None
+    rectangles = [
+        (rect[0], rect[1], rect[2], rect[3], palette[i]) for i, rect in enumerate(rect_boxes)
+    ]
+
+    walls = set()
+    occupied = set()
