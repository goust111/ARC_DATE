+
+
+def _render_grid(
+    shape: tuple[int, int],
+    rectangles: list[tuple[int, int, int, int, int]],
+    invalid_groups: list[tuple[int, list[tuple[int, int]]]],
+    seed: tuple[int, int],
+) -> np.ndarray:
