+    else:
+        outer = rectangles[0]
+        inner = rectangles[1]
+        candidates = _candidate_cells(
+            h,
+            w,
+            walls,
+            occupied,
+            lambda cell: _point_in_rect(cell, outer[:4], strict=True)
+            and not _point_in_rect(cell, inner[:4], strict=False),
