+
+
+def _place_invalid_group(
+    h: int,
+    w: int,
+    forbidden: set[tuple[int, int]],
+    pattern: list[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    max_r = max(r for r, _ in pattern)
