+    _, walls = _infer_virtual_walls(g)
+    out, _ = _flood_with_virtual_walls(g, seed, walls)
+    return out
+
+
+def _bbox_conflicts(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
