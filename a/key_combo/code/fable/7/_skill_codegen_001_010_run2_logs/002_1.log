+        bottom = random.randint(2, outer_h - top - 4)
+        left = random.randint(2, outer_w - 6)
+        right = random.randint(2, outer_w - left - 4)
+        inner = (r0 + top, c0 + left, r1 - bottom, c1 - right)
+        if inner[2] - inner[0] + 1 >= 4 and inner[3] - inner[1] + 1 >= 4:
