+    bg = int(structure["bg"])
+    row_lines = structure["row_lines"]
+    col_lines = structure["col_lines"]
+
+    color_grid = np.full((MACRO_N, MACRO_N), -1, dtype=int)
+    for (br, bc), color in block_colors.items():
