+        color = color_choice.pop()
+        block = _paint_block(reference_mask, rotation, color, bg)
+        r0, c0, r1, c1 = _block_box(row_lines, col_lines, br, bc)
+        out[r0 : r1 + 1, c0 : c1 + 1] = block
