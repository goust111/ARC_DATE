+def _neighbors4(cell: tuple[int, int], size: int) -> list[tuple[int, int]]:
+    r, c = cell
+    out = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < size and 0 <= cc < size:
+            out.append((rr, cc))
+    return out
