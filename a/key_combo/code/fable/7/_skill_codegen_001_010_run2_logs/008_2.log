+    for br in range(MACRO_N):
+        for bc in range(MACRO_N):
+            r0 = 1 + br * (cell_size + 1)
+            c0 = 1 + bc * (cell_size + 1)
+            inp[r0 : r0 + cell_size, c0 : c0 + cell_size] = bg
+            out[r0 : r0 + cell_size, c0 : c0 + cell_size] = bg
