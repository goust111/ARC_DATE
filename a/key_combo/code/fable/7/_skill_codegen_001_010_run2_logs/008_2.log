+        return None
+    tight = crop_bbox(mask.astype(int), box)
+    if tight.shape[0] < 2 or tight.shape[1] < 2:
+        return None
+
+    rotations = [np.rot90(mask, k) for k in range(MACRO_N)]
+    for i in range(MACRO_N):
+        for j in range(i + 1, MACRO_N):
