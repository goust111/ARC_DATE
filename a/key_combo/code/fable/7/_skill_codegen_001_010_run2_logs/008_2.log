+        if len({(int(rot_square[r, c]), int(color_square[r, c])) for r in range(MACRO_N) for c in range(MACRO_N)}) != MACRO_N * MACRO_N:
+            continue
+
+        blank_cells = _choose_blank_cells(rng, rot_square, color_square)
+        if blank_cells is None:
+            continue
