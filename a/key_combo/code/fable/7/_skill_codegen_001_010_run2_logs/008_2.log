+def _block_box(row_lines: list[int], col_lines: list[int], br: int, bc: int) -> tuple[int, int, int, int]:
+    return row_lines[br] + 1, col_lines[bc] + 1, row_lines[br + 1] - 1, col_lines[bc + 1] - 1
