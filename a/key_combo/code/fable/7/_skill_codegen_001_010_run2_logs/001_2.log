0104: def _gen_choose_plus_centers(height: int, width: int, count: int) -> list[tuple[int, int]] | None:
0105:     """Choose non-overlapping plus centers with the required Manhattan spacing."""
0106:     candidates = [
0107:         (r, c)
0108:         for r in range(PLUS_CENTER_MARGIN, height - PLUS_CENTER_MARGIN)
0109:         for c in range(PLUS_CENTER_MARGIN, width - PLUS_CENTER_MARGIN)
0110:     ]
0111:     random.shuffle(candidates)
0112:     chosen: list[tuple[int, int]] = []
0113: 
0114:     def search(pool: list[tuple[int, int]]) -> bool:
0115:         if len(chosen) == count:
0116:             return True
0117:         if len(pool) < count - len(chosen):
0118:             return False
0119:         random.shuffle(pool)
0120:         for i, pos in enumerate(pool):
0121:             rest = [
0122:                 other
0123:                 for other in pool[i + 1 :]
0124:                 if abs(int(other[0]) - int(pos[0])) + abs(int(other[1]) - int(pos[1])) >= PLUS_MIN_MANHATTAN
0125:             ]
0126:             chosen.append(pos)
0127:             if search(rest):
0128:                 return True
0129:             chosen.pop()
0130:         return False
0131: 
0132:     if search(candidates):
0133:         return chosen.copy()
0134:     return None
0135: 
