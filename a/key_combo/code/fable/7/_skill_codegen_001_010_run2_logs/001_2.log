0014: # Find a path starting from the green line and ending at the red line and color that path green, with the following constraints:
0015: # You can't go through a teal pixel; you can only change direction when you hit a teal pixel; you have to start in the direction of the green line.
0016: 
0017: def main(input_grid):
0018:     """
0019:     Find and color a constrained path from the green start line to the red end line.
0020: 
0021:     Input structure:
0022:     - A black grid contains teal barrier pixels.
0023:     - A short green horizontal or vertical line gives the starting location and initial travel direction.
0024:     - A short red line marks the destination.
0025: 
0026:     Rule:
0027:     - Run breadth-first search over position plus direction states.
0028:     - Move straight through black cells and turn only when a teal pixel blocks the next step.
0029:     - Stop when the next cell in the current direction is red, then color the recovered path green.
0030: 
0031:     Key insight:
0032:     - Teal pixels are not passable walls; they are turn triggers that define where the path may change direction.
0033:     """
0034:     # Plan:
0035:     # 1. Find the start and end points of the pathfinding problem
0036:     # 2. Define the state space, initial state(s), successor function, and goal test
0037:     # 3. Run bfs to find the shortest path from start to end
0038:     # 4. Color the path green
0039: 
0040:     # 1. Parse the input, based on color
0041:     # There is the start object, end object, and barriers object
0042:     background = Color.BLACK
0043:     start_object = input_grid.copy()
0044:     start_object[start_object != Color.GREEN] = background
0045:     end_object = input_grid.copy()
0046:     end_object[end_object != Color.RED] = background
0047:     barriers_object = input_grid.copy()
0048:     barriers_object[barriers_object != Color.TEAL] = background
0049: 
0050:     # Determine the orientation of the start object
0051:     r_coordinates = {r for r, c in np.argwhere(start_object == Color.GREEN)}
0052:     c_coordinates = {c for r, c in np.argwhere(start_object == Color.GREEN)}
0053:     # vertical line?
0054:     if len(r_coordinates) == 1:
0055:         possible_orientations = [(0, 1), (0, -1)]
0056:     # horizontal line?
0057:     elif len(c_coordinates) == 1:
0058:         possible_orientations = [(1, 0), (-1, 0)]
0059:     else:
0060:         assert False, "Start object is not horizontal/vertical"
0061:     
0062:     # 2. Define the state space, initial state(s), successor function, and goal test
0063:     # A state is a tuple of (x, y, orientation)
0064:     # orientation is a tuple of (dx, dy)
0065:         
0066:     # Initially we begin at a point on the line, along the orientation of the line
0067:     initial_states = [(r, c, orientation)
0068:                       for r, c in np.argwhere(start_object == Color.GREEN)
0069:                       for orientation in possible_orientations]
0070:     
0071: 
0072:     def successors(state):
0073:         r, c, orientation = state
0074:         dr, dc = orientation
0075: 
0076:         if not (0 <= r + dr < input_grid.shape[0] and 0 <= c + dc < input_grid.shape[1]):
0077:             return
0078: 
0079:         if barriers_object[r + dr, c + dc] == background:
0080:             yield (r + dr, c + dc, orientation)
0081:         if barriers_object[r + dr, c + dc] != background:
0082:             # right angle turns
0083:             new_orientations = [(dc, dr), (-dc, -dr)]
0084:             for new_orientation in new_orientations:
0085:                 yield (r, c, new_orientation)
0086:     
0087:     def is_goal(state):
0088:         r, c, (dr, dc) = state
0089:         if not (0 <= r + dr < end_object.shape[0] and 0 <= c + dc < end_object.shape[1]):
0090:             return False
0091:         return end_object[r + dr, c + dc] == Color.RED
0092:     
0093:     # 3. Run bfs to find the shortest path from start to end
0094:     queue = list(initial_states)
0095:     visited = set(initial_states)
0096:     parent = {}
0097:     while queue:
0098:         state = queue.pop(0)        
0099:         if is_goal(state):
0100:             break        
0101:         for successor in successors(state):
0102:             if successor not in visited:
0103:                 visited.add(successor)
0104:                 parent[successor] = state
0105:                 queue.append(successor)
0106: 
0107:     assert is_goal(state), "No path found"
0108:     
0109:     path = []
0110:     while state in parent:
0111:         path.append(state)
0112:         state = parent[state]
0113: 
0114:     # 4. Color the path green
0115:     # draw on top of the input grid
0116:     output_grid = input_grid.copy()
0117:     for r, c, _ in path:
0118:         output_grid[r, c] = Color.GREEN
0119: 
0120:     return output_grid
0121: 
