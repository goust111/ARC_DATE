0141:         for dr, dc in NEIGHBOR4_OFFSETS:
0142:             nr, nc = r + dr, c + dc
0143:             if (nr, nc) in own:
0144:                 continue
0145:             if 0 <= nr < height and 0 <= nc < width and int(rect[nr, nc]) == MARKER_COLOR:
0146:                 return True
0147:     return False
0148: 
