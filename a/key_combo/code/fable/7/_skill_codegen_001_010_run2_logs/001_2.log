0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Move each maroon marker toward the blue rectangle and recolor the rectangle red.
0009: 
0010:     Input structure
0011:     A background canvas contains one solid blue rectangular object and several isolated
0012:     maroon marker pixels. Each marker is horizontally or vertically aligned with the
0013:     rectangle and lies outside it.
0014: 
0015:     Rule
0016:     Start with a background canvas, repaint the blue rectangle red, and move each
0017:     maroon marker straight toward the rectangle along its row or column. Exactly one
0018:     marker is strictly closer to the rectangle than all others and enters the
0019:     rectangle boundary; every other marker lands in the adjacent exterior cell just
0020:     outside its aligned side.
0021: 
0022:     Key insight
0023:     The single entering marker is the unique global nearest marker to the rectangle,
0024:     not the nearest marker on each of the four sides.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     bg = get_bg(g)
0028: 
0029:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0030:     rectangles = []
0031:     markers = []
0032:     for comp in components:
0033:         h = bbox_h(comp["bbox"])
0034:         w = bbox_w(comp["bbox"])
0035:         if comp["area"] == h * w and comp["area"] > 1:
0036:             rectangles.append(comp)
0037:         elif comp["area"] == 1:
0038:             markers.append(comp)
0039: 
0040:     assert len(rectangles) == 1
0041:     assert markers
0042:     rect = rectangles[0]
0043:     rect_color = int(rect["color"])
0044:     marker_colors = {int(comp["color"]) for comp in markers}
0045:     assert marker_colors == {Color.MAROON}
0046:     marker_color = Color.MAROON
0047:     assert rect_color == Color.BLUE
0048:     assert set(map(int, g.flat)) == {bg, rect_color, marker_color}
0049: 
0050:     r0, c0, r1, c1 = map(int, rect["bbox"])
0051:     h = bbox_h(rect["bbox"])
0052:     w = bbox_w(rect["bbox"])
0053: 
0054:     out = np.full_like(g, bg)
0055:     out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED
0056: 
0057:     destinations = []
0058:     marker_entries: list[tuple[int, tuple[int, int], bool]] = []
0059:     for comp in markers:
0060:         r, c = map(int, comp["coords"][0])
0061:         candidates = []
0062:         if c0 <= c <= c1 and r < r0:
0063:             d = r0 - r
0064:             enters = d < h
0065:             candidates.append((r0 if enters else r0 - 1, c))
0066:             marker_entries.append((d, (r, c), enters))
0067:         if c0 <= c <= c1 and r > r1:
0068:             d = r - r1
0069:             enters = d < h
0070:             candidates.append((r1 if enters else r1 + 1, c))
0071:             marker_entries.append((d, (r, c), enters))
0072:         if r0 <= r <= r1 and c < c0:
0073:             d = c0 - c
0074:             enters = d < w
0075:             candidates.append((r, c0 if enters else c0 - 1))
0076:             marker_entries.append((d, (r, c), enters))
0077:         if r0 <= r <= r1 and c > c1:
0078:             d = c - c1
0079:             enters = d < w
0080:             candidates.append((r, c1 if enters else c1 + 1))
0081:             marker_entries.append((d, (r, c), enters))
0082: 
0083:         assert len(candidates) == 1
0084:         dr, dc = candidates[0]
0085:         assert in_bounds(g.shape, dr, dc)
0086:         assert (dr, dc) not in destinations
0087:         destinations.append((dr, dc))
0088: 
0089:     min_dist = min(dist for dist, _pos, _enters in marker_entries)
0090:     nearest = [pos for dist, pos, _enters in marker_entries if dist == min_dist]
0091:     entering = [pos for _dist, pos, enters in marker_entries if enters]
0092:     assert len(nearest) == 1, "the nearest marker to the rectangle must be unique"
0093:     assert len(entering) == 1, "exactly one marker may enter the rectangle"
0094:     assert entering[0] == nearest[0], "the entering marker must be the global nearest"
0095: 
0096:     for r, c in destinations:
0097:         out[r, c] = marker_color
0098: 
0099:     return out
