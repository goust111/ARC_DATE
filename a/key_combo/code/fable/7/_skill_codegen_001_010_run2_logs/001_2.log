0005: 
0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """Compare the two stacked half-size masks and emit pink where exactly one mask is filled.
0008: 
0009:     Input structure
0010:     - The input has even height and is vertically partitioned into two equal-size regions.
0011:     - The two regions share one background color, and each region has exactly one foreground color.
0012:     Rule
0013:     - Align the top and bottom regions by position.
0014:     - Output pink at positions where exactly one corresponding input cell is foreground.
0015:     - Output the shared background at positions where both cells agree as background or foreground.
0016:     Key insight
0017:     - The result is the symmetric difference of the two stacked foreground masks.
0018:     """
0019:     g = np.asarray(grid, dtype=int)
0020:     assert g.ndim == 2
0021:     height, width = g.shape
0022:     assert height % 2 == 0
0023: 
0024:     half = height // 2
0025:     top = g[:half, :]
0026:     bottom = g[half:, :]
0027: 
0028:     common_colors = set(colors_present(top)) & set(colors_present(bottom))
0029:     assert len(common_colors) == 1
0030:     bg = common_colors.pop()
0031: 
0032:     top_colors = colors_present(top, exclude={bg})
0033:     bottom_colors = colors_present(bottom, exclude={bg})
0034:     assert len(top_colors) == 1
0035:     assert len(bottom_colors) == 1
0036:     assert top_colors[0] != bottom_colors[0]
0037: 
0038:     out = np.full((half, width), bg, dtype=int)
0039:     out[(top != bg) ^ (bottom != bg)] = Color.PINK
0040:     return out
0041: 
0042: # --------------- generator (o5x) ---------------
0043: # Fixed canvas and colors observed in all task examples.
0044: HALF_HEIGHT, WIDTH = 3, 5
0045: TOTAL_CELLS = HALF_HEIGHT * WIDTH
0046: BACKGROUND_COLOR, TOP_COLOR, BOTTOM_COLOR = Color.BLACK, Color.MAROON, Color.YELLOW
0047: 
0048: # Foreground/overlap ranges and inclusive XOR size bounds.
