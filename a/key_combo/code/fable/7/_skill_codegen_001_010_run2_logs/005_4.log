+    sprite: dict | None = None
+    anchors: list[dict] = []
+    for comp in comps:
+        color = int(comp["color"])
+        coords = np.asarray(comp["coords"], dtype=int)
+        box = tuple(map(int, comp["bbox"]))
+        if _is_solid_2x2(comp, g):
