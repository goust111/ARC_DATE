+
+def _choose_anchor_box(
+    current_coords: np.ndarray, move: str, gap: int
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = _bbox(current_coords)
+    gap = int(gap)
+    if move == "right":
+        ar = random.randint(r0 - 1, r1)
+        ac = c1 + gap + 1
+    elif move == "left":
