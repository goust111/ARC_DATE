+def _paint_coords(out: np.ndarray, coords: np.ndarray, color: int) -> None:
+    for r, c in np.asarray(coords, dtype=int):
+        rr = int(r)
+        cc = int(c)
+        assert 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]
+        assert int(out[rr, cc]) == BG
+        out[rr, cc] = int(color)
+
