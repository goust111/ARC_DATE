from arc_utils import bbox_coords, colors_present, find_components, get_bg
import random
from itertools import product


BLUE = 1

_CORNER_ROLES = {
    ((0, 0), (0, 1), (1, 0)): "TL",
    ((0, 0), (0, 1), (1, 1)): "TR",
    ((0, 0), (1, 0), (1, 1)): "BL",
    ((0, 1), (1, 0), (1, 1)): "BR",
}


def _corner_key(role: str, box: tuple[int, int, int, int]) -> tuple[int, int]:
    r0, c0, r1, c1 = box
    if role == "TL":
        return r0, c0
    if role == "TR":
        return r0, c1
    if role == "BL":
        return r1, c0
    assert role == "BR"
    return r1, c1


