            area = bh * bw
            for n in SOURCE_PIXEL_COUNTS:
                density = n / area
                if not (SOURCE_DENSITY_RANGE[0] <= density <= SOURCE_DENSITY_RANGE[1]):
                    continue
                for combo in itertools.combinations(range(area), n):
