+                continue
+            border = _border_cells(bbox)
+            if set(comp) != border:
+                continue
+            center = ((r0 + r1) // 2, (c0 + c1) // 2)
+            interior_marks = [
+                (r, c)
+                for r in range(r0 + 1, r1)
+                for c in range(c0 + 1, c1)
+                if int(grid[r, c]) != bg and int(grid[r, c]) != color
+            ]
