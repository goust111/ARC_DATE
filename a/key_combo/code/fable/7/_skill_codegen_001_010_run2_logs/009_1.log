+        elif step == (1, 0):
+            for r0 in range(anchor[0] + MIN_SEG_LEN + 1, h - fh):
+                low = max(1, anchor[1] - fw + 1)
+                high = min(anchor[1], w - fw - 1)
+                for c0 in range(low, high + 1):
+                    out.append((r0, c0, r0 + fh - 1, c0 + fw - 1))
+        else:
+            for r0 in range(1, anchor[0] - MIN_SEG_LEN - fh):
