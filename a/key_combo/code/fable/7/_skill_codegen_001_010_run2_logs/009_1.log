def _add(a: tuple[int, int], b: tuple[int, int], k: int = 1) -> tuple[int, int]:
    return a[0] + b[0] * k, a[1] + b[1] * k


def _on_boundary(shape: tuple[int, int], r: int, c: int) -> bool:
