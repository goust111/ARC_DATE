+        center = (random.randint(3, h - 4), random.randint(2, 4))
+    elif init_dir == (0, -1):
+        center = (random.randint(3, h - 4), random.randint(w - 5, w - 3))
+    elif init_dir == (1, 0):
+        center = (random.randint(2, 4), random.randint(3, w - 4))
+    else:
+        center = (random.randint(h - 5, h - 3), random.randint(3, w - 4))
