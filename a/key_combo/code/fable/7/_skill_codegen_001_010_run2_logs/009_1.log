+from __future__ import annotations
+
+from collections import Counter, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MIN_FRAME_SPAN = 5
+FRAME_SPANS = (5, 7, 9)
+GRID_H_RANGE = (16, 27)
+GRID_W_RANGE = (16, 27)
+FRAME_COUNT_CHOICES = (1, 2, 2, 3, 3, 4)
+MIN_SEG_LEN = 2
+FINAL_MIN_RUN = 2
+FUTURE_MIN_RUN = MIN_SEG_LEN + MIN_FRAME_SPAN
+MAX_GEN_ATTEMPTS = 500
+
+
+@dataclass(frozen=True)
+class FrameSpec:
+    bbox: tuple[int, int, int, int]
+    color: int
+    center: tuple[int, int]
+    pointer: tuple[int, int]
+    pointer_dir: tuple[int, int]
+
+
+@dataclass(frozen=True)
+class CaseSpec:
+    shape: tuple[int, int]
+    bg: int
+    bar_color: int
+    control_color: int
+    pointer_color: int
+    bar_cells: tuple[tuple[int, int], tuple[int, int], tuple[int, int]]
+    center: tuple[int, int]
+    control: tuple[int, int]
+    init_dir: tuple[int, int]
+    frames: tuple[FrameSpec, ...]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: list[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
