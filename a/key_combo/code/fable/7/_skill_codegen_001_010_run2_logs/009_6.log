+def _expand_mask(mask: np.ndarray) -> np.ndarray:
+    expanded = np.zeros_like(mask, dtype=bool)
+    for r0, c0 in np.argwhere(mask):
+        r, c = int(r0), int(c0)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if in_bounds(mask.shape, rr, cc):
+                    expanded[rr, cc] = True
+    return expanded
+
