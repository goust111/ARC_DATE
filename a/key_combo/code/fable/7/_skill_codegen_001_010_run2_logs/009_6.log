+def _mark_blocked(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = int(r + dr)
+                cc = int(c + dc)
+                if in_bounds(blocked.shape, rr, cc):
+                    blocked[rr, cc] = True
