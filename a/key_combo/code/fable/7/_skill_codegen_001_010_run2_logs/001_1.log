+def _plan_shape_offsets(
+    dirs: list[str],
+    shape_size: int,
+    canvas_h: int,
+    canvas_w: int,
+    legend_box: tuple[int, int, int, int],
+) -> list[tuple[int, int]] | None:
+    gap = random.randint(2, 3)
+    step = shape_size + gap
+    base = {
+        "up": (0, step),
+        "down": (2 * step, step),
+        "left": (step, 0),
+        "right": (step, 2 * step),
+    }
