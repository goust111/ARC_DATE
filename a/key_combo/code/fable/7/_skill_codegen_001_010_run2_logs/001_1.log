+    raw_boxes = []
+    for d in dirs:
+        rr, cc = base[d]
+        if d in ("up", "down"):
+            cc += random.randint(-1, 1)
+        else:
+            rr += random.randint(-1, 1)
+        raw_boxes.append((rr, cc, rr + shape_size - 1, cc + shape_size - 1))
