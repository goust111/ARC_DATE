+def _legend_mark_positions(h: int, w: int) -> dict[str, tuple[int, int]]:
+    cr = h // 2
+    cc = w // 2
+    return {
+        "up": (cr - max(1, h // 2 - 1), cc),
+        "down": (cr + max(1, h // 2 - 1), cc),
+        "left": (cr, cc - max(1, w // 2 - 1)),
+        "right": (cr, cc + max(1, w // 2 - 1)),
+    }
