+def _plan_shape_offsets(
+    dirs: list[str],
+    shape_size: int,
+    canvas_h: int,
+    canvas_w: int,
+    legend_box: tuple[int, int, int, int],
+) -> list[tuple[int, int]] | None:
+    layout_h = random.randint(shape_size + 4, min(canvas_h - 2, shape_size + 12))
+    layout_w = random.randint(shape_size + 4, min(canvas_w - 2, shape_size + 12))
+    if layout_h < shape_size or layout_w < shape_size:
+        return None
+
+    center_r = (layout_h - shape_size) // 2
+    center_c = (layout_w - shape_size) // 2
+    max_r = layout_h - shape_size
+    max_c = layout_w - shape_size
+
+    base = {
+        "up": (0, center_c),
+        "down": (max_r, center_c),
+        "left": (center_r, 0),
+        "right": (center_r, max_c),
+    }
+
+    offsets: dict[str, tuple[int, int]] = {}
+    for d in dirs:
+        br, bc = base[d]
+        jitter_r = random.randint(-1, 1)
+        jitter_c = random.randint(-1, 1)
+        if d in ("up", "down"):
+            rr = br
+            cc = min(max(0, bc + jitter_c), max_c)
+        else:
+            rr = min(max(0, br + jitter_r), max_r)
+            cc = bc
+        offsets[d] = (rr, cc)
+
+    all_boxes = []
+    for d in dirs:
+        rr, cc = offsets[d]
+        all_boxes.append((rr, cc, rr + shape_size - 1, cc + shape_size - 1))
+    for i in range(len(all_boxes)):
+        for j in range(i + 1, len(all_boxes)):
+            if _rects_overlap(all_boxes[i], all_boxes[j], padding=1):
+                return None
+
+    for _ in range(200):
+        top = random.randint(0, canvas_h - layout_h)
+        left = random.randint(0, canvas_w - layout_w)
+        placed = []
+        for d in dirs:
+            rr, cc = offsets[d]
+            box = (top + rr, left + cc, top + rr + shape_size - 1, left + cc + shape_size - 1)
+            if _rects_overlap(box, legend_box, padding=1):
+                break
+            placed.append((box[0], box[1]))
+        else:
+            return placed
+    return None
