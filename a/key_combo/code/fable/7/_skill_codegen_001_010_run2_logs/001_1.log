+    for idx, mark_idx in enumerate(perm):
+        sr, sc = shape_points[idx]
+        mr, mc = mark_points[mark_idx]
+        dr = sr - mr
+        dc = sc - mc
+        if squared:
+            total += dr * dr + dc * dc
+        else:
+            total += abs(dr) + abs(dc)
+    return total
+
+
+def _best_assignment(
