    bg = int(transparent)

    if h <= 0 or w <= 0:
        raise ValueError("random_free_location: patch must be non-empty")
    if H <= 0 or W <= 0:
        raise ValueError("random_free_location: canvas must be non-empty")

    if border < 0:
        raise ValueError("random_free_location: border must be >= 0")
