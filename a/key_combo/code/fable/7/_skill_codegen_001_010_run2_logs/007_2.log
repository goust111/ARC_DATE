+        if not meta["has_internal_gap"]:
+            continue
+        if max(grid.shape) > CANVAS_LIMIT or max(expected.shape) > CANVAS_LIMIT:
+            continue
+        return grid
+    raise RuntimeError("failed to generate valid input")

