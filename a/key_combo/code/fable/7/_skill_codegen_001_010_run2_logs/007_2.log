+    internal_gap_index = rng.randrange(frame_count)
+    cases: list[dict] = []
+    mods: list[int] = []
+    for idx in range(frame_count):
+        desired_mod = anchor_mod if idx == 0 else None
+        force_internal_gap = idx == internal_gap_index
+        case = _make_frame_case(
