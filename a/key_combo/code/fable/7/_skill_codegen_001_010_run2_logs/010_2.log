+    shared_used = False
+    for idx in range(n_chambers - 1):
+        separator_col = starts[idx] + widths[idx]
+        common = [
+            color
+            for color in list(pending_votes[idx])
+            if pending_votes[idx][color] > 0 and pending_votes[idx + 1][color] > 0
