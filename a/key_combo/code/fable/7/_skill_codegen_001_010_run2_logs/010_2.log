from collections import Counter
import random

PALETTE=[1,2,3,4,6,7,8,9]

def winner(cnt):
    if not cnt:
        return None
    m=max(cnt.values())
    ws=[k for k,v in cnt.items() if v==m]
    return ws[0] if len(ws)==1 else None

def choose_base(target, neighbor_colors, require_nonseed=True, prefer=None):
    # prefer: 'blank','tie',None
    pals=sorted(set(PALETTE[:4]) | set(neighbor_colors) | {target})
    patterns=[]
    def rec(start, left, arr):
        patterns.append(tuple(arr))
        if left==0: return
        for i in range(start, len(pals)):
            arr.append(pals[i])
            rec(i, left-1, arr)
            arr.pop()
    patterns=[]
    rec(0, 3, [])
    cand=[]
    nb=Counter(neighbor_colors)
    for p in patterns:
        b=Counter(p)
        if require_nonseed:
            if winner(b) is not None:
                continue
            if winner(b+nb)"'!=target:
                continue
        else:
            if winner(b)!=target:
                continue
        kind='"'blank' if sum(b.values())==0 else ('tie' if winner(b) is None else 'major')
        cand.append((kind, p))
    if not cand:
        return None
    order=[]
    if prefer=='blank': order=['blank','tie','major']
    elif prefer=='tie': order=['tie','blank','major']
    else: order=['tie','blank','major']
    for k in order:
        xs=[p for kind,p in cand if kind==k]
        if xs:
            return Counter(random.choice(xs))
    return Counter(random.choice([p for _,p in cand]))

