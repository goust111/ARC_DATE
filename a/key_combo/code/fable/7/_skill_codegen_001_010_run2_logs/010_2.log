+            for nr, nc in _neighbors4(rr, cc)
+            if 0 <= nr < h and 0 <= nc < w and chamber_id[nr, nc] >= 0
+        }
+        for left, right in itertools.combinations(sorted(touched), 2):
+            adjacency[left].add(right)
+            adjacency[right].add(left)
