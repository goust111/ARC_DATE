+def _enumerate_vote_patterns(colors: tuple[int, ...], max_len: int = 3) -> list[tuple[int, ...]]:
+    patterns = [()]
+    for length in range(1, max_len + 1):
+        patterns.extend(itertools.combinations_with_replacement(colors, length))
+    return patterns
