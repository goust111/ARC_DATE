+        "bg": int(bg),
+        "wall": int(wall),
+        "chambers": chambers,
+        "chamber_id": chamber_id,
+        "base_votes": base_votes,
+        "adjacency": adjacency,
+    }
+
+
+def _solve_with_details(grid: np.ndarray) -> tuple[np.ndarray, dict]:
