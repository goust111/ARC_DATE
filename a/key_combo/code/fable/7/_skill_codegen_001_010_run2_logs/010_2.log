+
+def _transform_coords(
+    coords: np.ndarray,
+    shape: tuple[int, int],
+    *,
+    transpose: bool,
+    flip_ud: bool,
+    flip_lr: bool,
+) -> tuple[np.ndarray, tuple[int, int]]:
+    arr = coords.copy()
+    h, w = map(int, shape)
+    if transpose:
+        arr = arr[:, [1, 0]]
+        h, w = w, h
+    if flip_ud:
+        arr[:, 0] = h - 1 - arr[:, 0]
+    if flip_lr:
+        arr[:, 1] = w - 1 - arr[:, 1]
+    arr = np.array(sorted((int(r), int(c)) for r, c in arr), dtype=int)
+    return arr, (h, w)
