+        rr = int(r)
+        cc = int(c)
+        touched = {
+            int(chamber_id[nr, nc])
+            for nr, nc in _neighbors4(rr, cc)
+            if 0 <= nr < h and 0 <= nc < w and chamber_id[nr, nc] >= 0
+        }
+        assert 1 <= len(touched) <= 2, "markers must touch one or two chambers"
+        for idx in touched:
