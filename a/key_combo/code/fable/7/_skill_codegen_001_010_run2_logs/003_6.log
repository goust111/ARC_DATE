+def _merge_legend_blocks(a: np.ndarray, b: np.ndarray, bg: int) -> np.ndarray | None:
+    if a.shape != b.shape or a.shape[1] != LEGEND_WIDTH:
+        return None
+    missing = (a == bg) & (b == bg)
+    clash = (a != bg) & (b != bg) & (a != b)
+    if np.any(missing) or np.any(clash):
