+
+def _apply_damage_state(copy_a: np.ndarray, copy_b: np.ndarray, row: int, state: int, bg: int) -> None:
+    if state == 0:
+        return
+    if state == 1:
+        copy_a[row, 0] = bg
+    elif state == 2:
+        copy_a[row, 1] = bg
+    elif state == 3:
+        copy_b[row, 0] = bg
+    elif state == 4:
+        copy_b[row, 1] = bg
+    elif state == 5:
+        copy_a[row, 0] = bg
+        copy_b[row, 1] = bg
+    elif state == 6:
