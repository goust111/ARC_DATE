+        while r < h:
+            if not active[r]:
+                r += 1
+                continue
+            r0 = r
+            while r + 1 < h and active[r + 1]:
+                r += 1
+            r1 = r
+            if r1 - r0 + 1 >= MIN_LEGEND_ROWS:
+                box = (r0, c0, r1, c0 + 1)
+                block = _block(grid, box)
