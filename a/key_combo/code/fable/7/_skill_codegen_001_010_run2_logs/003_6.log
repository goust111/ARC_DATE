+
+
+def _visible_pairs(block: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    for row in block:
+        left = int(row[0])
+        right = int(row[1])
+        if left != bg and right != bg:
+            pairs.append((left, right))
+    return pairs
