+
+
+def _place_legend(grid: np.ndarray, blocked: np.ndarray, block: np.ndarray, rng: random.Random) -> BBox:
+    h, w = grid.shape
+    bh, bw = block.shape
+    for _ in range(PLACEMENT_ATTEMPTS):
