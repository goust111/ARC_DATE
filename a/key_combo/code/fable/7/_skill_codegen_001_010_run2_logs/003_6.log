+    bg = int(get_bg(grid))
+    legend_boxes, merged = _find_legend_pair(grid, bg)
+    pairs = [(int(row[0]), int(row[1])) for row in merged]
+    return _apply_pairs(grid, legend_boxes, pairs, bg)
