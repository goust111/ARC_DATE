+    h, w = grid.shape
+    max_r = max(r for r, _ in offsets)
+    max_c = max(c for _, c in offsets)
+    for _ in range(PLACEMENT_ATTEMPTS):
+        r0 = rng.randint(0, h - max_r - 1)
+        c0 = rng.randint(0, w - max_c - 1)
