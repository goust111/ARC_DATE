+def _moat_is_bg(grid: np.ndarray, box: BBox, bg: int) -> bool:
+    h, w = grid.shape
+    r0, c0, r1, c1 = box
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
+    window = grid[rr0 : rr1 + 1, cc0 : cc1 + 1].copy()
+    window[r0 - rr0 : r1 - rr0 + 1, c0 - cc0 : c1 - cc0 + 1] = bg
+    return bool(np.all(window == bg))
