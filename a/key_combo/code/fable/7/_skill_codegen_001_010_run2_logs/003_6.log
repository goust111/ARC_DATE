+
+def _draw_coords(grid: np.ndarray, coords: list[tuple[int, int]], color: int) -> None:
+    for r, c in coords:
+        grid[r, c] = int(color)
+
+
+def _shape_offsets(kind: str, rng: random.Random) -> list[tuple[int, int]]:
+    if kind == "single":
+        return [(0, 0)]
+    if kind == "hline":
+        length = rng.randint(2, 5)
