+
+        if not _build_target(grid, blocked, merged, chain_colors, bg, rng):
+            continue
+
+        try:
+            _semantic_checks(grid)
+        except AssertionError:
+            continue
+
+        assert grid.ndim == 2 and max(grid.shape) <= MAX_SIDE
+        return grid
