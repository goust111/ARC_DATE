+    unmatched.sort(key=lambda obj: (-int(obj["bbox"][2]), -int(obj["bbox"][0]), int(obj["bbox"][1])))
+    for sprite in unmatched:
+        r0, c0, _r1, _c1 = sprite["bbox"]
