+
+def _fits_with_padding(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int, padding: int = 1) -> bool:
+    h, w = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + h > canvas.shape[0] or c0 + w > canvas.shape[1]:
+        return False
+    pts = np.argwhere(patch != int(bg))
+    for pr, pc in pts:
