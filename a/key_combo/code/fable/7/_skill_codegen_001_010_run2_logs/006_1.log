+    seen = np.zeros((h, w), dtype=bool)
+    holes: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            touches_edge = False
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and (not mask[nr, nc]) and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
