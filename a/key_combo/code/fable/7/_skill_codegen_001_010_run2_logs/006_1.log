+    bg = get_bg(g)
+    comps = _connected_components(g != int(bg))
+    frames: list[dict] = []
+    sprites: list[dict] = []
+    for comp in comps:
+        bbox = _bbox_from_coords(comp)
+        r0, c0, r1, c1 = bbox
+        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
