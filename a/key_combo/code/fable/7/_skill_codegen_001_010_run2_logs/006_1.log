+        else:
+            assert len(all_hits) == 1
+            frame_idx, rot, flip = all_hits[0]
+            assert frame_idx == int(sprite["target_frame"])
+            assert rot == int(sprite["fit_rot"])
+            assert bool(flip) == bool(sprite["fit_flip"])
