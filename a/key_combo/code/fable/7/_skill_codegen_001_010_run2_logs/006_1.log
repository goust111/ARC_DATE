+    sprite_mask = sprite_patch != int(bg)
+    for rot, flip, trans in _transform_variants(sprite_mask):
+        if trans.shape == cavity_mask.shape and np.array_equal(trans, cavity_mask):
+            matches.append((rot, flip))
+    return matches
