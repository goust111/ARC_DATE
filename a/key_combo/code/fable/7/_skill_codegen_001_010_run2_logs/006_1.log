+        sprites.append(
+            {
+                "bbox": bbox,
+                "patch": patch,
+                "mask": mask,
+                "body_color": body_color,
+                "marker_color": marker_color,
+                "marker_rc": marker_rc,
+            }
+        )
+    return bg, frames, sprites
