+
+def _build_expected_from_spec(spec: dict) -> np.ndarray:
+    bg = int(spec["bg"])
+    out = spec["input"].copy()
+    for sprite in spec["sprites"]:
+        r0, c0 = map(int, sprite["pos"])
+        patch = sprite["patch"]
+        out[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]][patch != bg] = bg
