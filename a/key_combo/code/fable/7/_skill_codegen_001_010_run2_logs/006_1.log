+        return None
+    return random.choice(positions)
+
+
+def _random_connected_shape() -> np.ndarray:
+    for _ in range(400):
+        h = random.randint(2, 5)
+        w = random.randint(2, 5)
+        max_area = min(8, h * w - 1)
+        if max_area < 4:
+            continue
