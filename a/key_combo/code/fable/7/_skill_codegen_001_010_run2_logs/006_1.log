+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox_from_coords(coords: list[Coord]) -> BBox:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _bbox(mask: np.ndarray) -> BBox | None:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return None
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(arr: np.ndarray, bbox: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
+
+
+def _connected_components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _enclosed_false_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            touches_edge = False
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and (not mask[nr, nc]) and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if not touches_edge:
+                hole = np.zeros_like(mask, dtype=bool)
+                for rr, cc in comp:
+                    hole[rr, cc] = True
+                holes.append(hole)
