+    if r0 < 0 or c0 < 0 or r0 + h > canvas.shape[0] or c0 + w > canvas.shape[1]:
+        return False
+    mask = patch != int(bg)
+    region = canvas[r0 : r0 + h, c0 : c0 + w]
+    return bool(np.all(region[mask] == int(bg)))
