+    unmatched = [sprite for sprite in spec["sprites"] if sprite["target_frame"] is None]
+    overlap_seen = False
+    for i in range(len(unmatched)):
+        c0a = int(unmatched[i]["pos"][1])
+        c1a = c0a + int(unmatched[i]["patch"].shape[1]) - 1
