+                    "color": int(colors[0]),
+                    "patch": patch,
+                    "cavity_mask": cavity_mask,
+                    "cavity_bbox_local": hole_bbox,
+                    "cavity_top_left": (int(r0 + hole_bbox[0]), int(c0 + hole_bbox[1])),
+                }
