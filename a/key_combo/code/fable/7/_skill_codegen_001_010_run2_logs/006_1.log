+
+def _drop_row(canvas: np.ndarray, patch: np.ndarray, start_r: int, c0: int, bg: int) -> int:
+    h = int(patch.shape[0])
+    for r0 in range(canvas.shape[0] - h, int(start_r) - 1, -1):
+        if _can_place(canvas, patch, r0, int(c0), bg):
