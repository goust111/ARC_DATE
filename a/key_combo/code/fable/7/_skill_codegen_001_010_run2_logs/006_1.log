+    for sprite in sprites:
+        r0, c0, _r1, _c1 = sprite["bbox"]
+        patch = sprite["patch"]
+        region = out[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+        region[patch != int(bg)] = int(bg)
+
+    for sprite, frame, rot, flip in matches:
