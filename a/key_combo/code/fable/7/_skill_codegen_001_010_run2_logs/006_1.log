    r1, c1, r1b, c1b = b1
    r2, c2, r2b, c2b = b2

    # Horizontal between: objects separated along columns, and row overlap is sufficient.
    left, right = ((r1, c1, r1b, c1b), (r2, c2, r2b, c2b)) if c1 <= c2 else ((r2, c2, r2b, c2b), (r1, c1, r1b, c1b))
