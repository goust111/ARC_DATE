+
+
+def _sample_extra_rect(height: int, width: int, placed: list[dict]) -> dict | None:
+    for _ in range(80):
+        rect_h = random.randint(1, min(6, height - 2))
+        rect_w = random.randint(1, min(6, width - 2))
