        if not choices:
            return None
        color = int(choices[int(np.random.randint(len(choices)))])
        legends[legend_i][pos] = color
        used_by_legend[legend_i].add(color)
        color_counts[color] += 1
        repeated.add(color)

    return [tuple(int(v) for v in seq) for seq in legends]


