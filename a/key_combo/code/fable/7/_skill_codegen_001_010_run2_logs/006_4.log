+def _same_or_gap_separated(box_a: dict, box_b: dict, gap: int = 1) -> bool:
+    return (
+        box_a["r1"] + gap < box_b["r0"]
+        or box_b["r1"] + gap < box_a["r0"]
+        or box_a["c1"] + gap < box_b["c0"]
+        or box_b["c1"] + gap < box_a["c0"]
+    )
