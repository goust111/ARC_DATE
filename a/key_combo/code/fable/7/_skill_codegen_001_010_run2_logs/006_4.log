+
+def _overlap_cells(rect_a: dict, rect_b: dict) -> int:
+    rows = max(0, min(rect_a["r1"], rect_b["r1"]) - max(rect_a["r0"], rect_b["r0"]) + 1)
+    cols = max(0, min(rect_a["c1"], rect_b["c1"]) - max(rect_a["c0"], rect_b["c0"]) + 1)
+    return int(rows * cols)
