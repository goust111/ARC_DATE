+def _trace_info(
+    canonical: np.ndarray,
+    bg: int,
+    mapping: dict[int, tuple[int, int]],
+    source: tuple[int, int, int],
+) -> dict:
+    r, c, color = source
+    dr, dc = mapping[color]
+    path: list[tuple[int, int]] = []
+    cur_r, cur_c = int(r), int(c)
+    while True:
+        nr = cur_r + dr
+        nc = cur_c + dc
+        if not in_bounds(canonical.shape, nr, nc):
+            return {
+                "source": source,
+                "vector": (dr, dc),
+                "path": path,
+                "stop": "boundary",
+                "stop_cell": None,
