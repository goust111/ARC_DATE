+    assert g.ndim == 2, "expected a 2D grid"
+    bg = int(get_bg(g))
+    canonical, divider_r, transposed = _find_divider(g, bg)
+    mapping = _extract_mapping(canonical, divider_r, bg)
+    legend_h = int(divider_r)
+    sources = []
+    walls = []
