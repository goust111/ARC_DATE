+    out = main(grid)
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    if np.count_nonzero(out != grid) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid legend-jump input")

