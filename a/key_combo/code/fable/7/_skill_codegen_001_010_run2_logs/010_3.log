+        if int(canonical[nr, nc]) != bg:
+            stop_kind = "wall"
+            if int(canonical[nr, nc]) in mapping:
+                stop_kind = "object"
+            return {
+                "source": source,
+                "vector": (dr, dc),
+                "path": path,
+                "stop": stop_kind,
+                "stop_cell": (nr, nc),
+            }
+        path.append((nr, nc))
+        cur_r, cur_c = nr, nc
