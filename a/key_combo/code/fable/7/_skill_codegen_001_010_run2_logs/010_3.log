+    trace_infos = [
+        _trace_info(parsed["canonical"], parsed["bg"], parsed["mapping"], source)
+        for source in parsed["sources"]
+    ]
+    used_colors = {color for _r, _c, color in parsed["sources"]}
+    return {
+        "parsed": parsed,
+        "traces": trace_infos,
