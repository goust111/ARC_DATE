+def _is_valid_base_slot(slot: np.ndarray) -> bool:
+    if not np.any(slot != SPRITE_BACKGROUND):
+        return False
+    seen = []
+    for variant in (
+        slot,
+        np.rot90(slot, k=-1),
+        np.rot90(slot, k=2),
+        np.rot90(slot, k=1),
+        np.fliplr(slot),
+        np.flipud(slot),
+    ):
+        if any(np.array_equal(variant, prior) for prior in seen):
+            return False
+        seen.append(variant.copy())
+    return True
+
