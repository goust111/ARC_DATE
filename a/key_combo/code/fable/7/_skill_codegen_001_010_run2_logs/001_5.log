873:     h, w = patch.shape
874:     border = int(border)
875:     padding = int(padding)
876:     pad_conn = int(padding_connectivity)
877:     bg = int(transparent)
878: 
879:     if h <= 0 or w <= 0:
880:         raise ValueError("random_free_location: patch must be non-empty")
881:     if H <= 0 or W <= 0:
882:         raise ValueError("random_free_location: canvas must be non-empty")
883: 
884:     if border < 0:
885:         raise ValueError("random_free_location: border must be >= 0")
886:     if padding < 0:
887:         raise ValueError("random_free_location: padding must be >= 0")
888:     if pad_conn not in (4, 8):
889:         raise ValueError("random_free_location: padding_connectivity must be 4 or 8")
890: 
891:     r_min = border
892:     c_min = border
893:     r_max = H - border - h
894:     c_max = W - border - w
895:     if r_max < r_min or c_max < c_min:
896:         raise ValueError("random_free_location: patch cannot fit (border too large or patch too big)")
