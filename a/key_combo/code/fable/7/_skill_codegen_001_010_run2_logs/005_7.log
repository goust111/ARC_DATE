+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _parse_rectangles(grid: np.ndarray) -> dict[int, tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
