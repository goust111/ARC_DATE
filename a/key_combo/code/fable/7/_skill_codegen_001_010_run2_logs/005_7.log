def _edge_component_ids(labels: np.ndarray, n_labels: int) -> set[int]:
    height, width = labels.shape
    edge_ids: set[int] = set()
    for k in range(1, n_labels + 1):
        coords = np.argwhere(labels == k)
        if np.any(
            (coords[:, 0] == 0)
            | (coords[:, 1] == 0)
