+def _orbit_cells(
+    r: int,
+    c: int,
+    row_s: int,
+    col_s: int,
+    row_count: int,
+    col_count: int,
+) -> tuple[tuple[int, int], ...]:
+    rows = {int(r)}
+    rr = int(row_s) - int(r)
+    if 0 <= rr < row_count:
+        rows.add(rr)
+
+    cols = {int(c)}
+    cc = int(col_s) - int(c)
+    if 0 <= cc < col_count:
+        cols.add(cc)
+
+    return tuple(sorted((orow, ocol) for orow in rows for ocol in cols))
