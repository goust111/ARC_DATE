+    for _ in range(200):
+        patch = np.full((cell_h, cell_w), _BG, dtype=int)
+        color_count = random.randint(2, min(4, len(_STAMP_COLORS)))
+        palette = random.sample(_STAMP_COLORS, color_count)
+        fill_count = random.randint(3, min(area - 1, max(4, area - 2)))
