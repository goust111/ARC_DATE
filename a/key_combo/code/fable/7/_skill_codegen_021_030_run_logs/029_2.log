+        row_count, col_count, cell_h, cell_w = random.choice(_LATTICE_OPTIONS)
+        row_s = _choose_axis_constant(row_count)
+        col_s = _choose_axis_constant(col_count)
+        orbits = _partition_orbits(row_count, col_count, row_s, col_s)
