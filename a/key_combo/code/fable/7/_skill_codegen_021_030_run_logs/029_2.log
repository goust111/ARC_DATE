    assert targets, "expected at least one teal target block"
    return starts[0], targets


def _visible_step(g: np.ndarray, bg: int, a: Block, b: Block) -> tuple[str, int] | None:
    ar0, ac0, ar1, ac1 = a["bbox"]
    br0, bc0, br1, bc1 = b["bbox"]

