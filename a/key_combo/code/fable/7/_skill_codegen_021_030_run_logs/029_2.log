def _blocks(g: np.ndarray, bg: int) -> tuple[Block, list[Block]]:
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert objects, "expected colored 2x2 blocks"

    starts = []
    targets = []
