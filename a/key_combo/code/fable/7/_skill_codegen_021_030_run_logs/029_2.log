+        r0 = row_lines[i] + 1
+        r1 = row_lines[i + 1]
+        for j in range(len(col_lines) - 1):
+            c0 = col_lines[j] + 1
+            c1 = col_lines[j + 1]
+            out[r0:r1, c0:c1] = tiles[i][j]
+    return out
