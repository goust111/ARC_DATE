+
+
+def _requires_full_orbit_reasoning(
+    special: tuple[tuple[int, int], ...],
+    visible: set[tuple[int, int]],
+    row_s: int,
+    col_s: int,
+) -> bool:
+    if len(special) != 4 or len(visible) != 1:
