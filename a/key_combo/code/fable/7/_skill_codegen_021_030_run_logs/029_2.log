+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(row_count):
+        for c in range(col_count):
+            if (r, c) in seen:
+                continue
+            orbit = _orbit_cells(r, c, row_s, col_s, row_count, col_count)
+            seen.update(orbit)
+            orbits.append(orbit)
+    return orbits
