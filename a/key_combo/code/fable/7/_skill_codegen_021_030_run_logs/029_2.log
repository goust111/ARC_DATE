def best_axis(tile_keys, axis):
    n = len(tile_keys) if axis == 0 else len(tile_keys[0])
    m = len(tile_keys[0]) if axis == 0 else len(tile_keys)
    candidates = []
    for s in range(2*n - 1):
        ok = True
        pair_count = 0
        compared = 0
        touches_empty = 0
        supported_pairs = 0
        for i in range(n):
            j = s - i
            if not (0 <= j < n) or i > j:
                continue
            pair_count += 1
            for k in range(m):
                a = tile_keys[i][k] if axis == 0 else tile_keys[k][i]
                b = tile_keys[j][k] if axis == 0 else tile_keys[k][j]
                if a is not None and b is not None:
                    if a "'!= b:
                        ok = False
                        break
                    compared += 1
                    if i != j:
                        supported_pairs += 1
                elif (a is None) != (b is None):
                    touches_empty += 1
            if not ok:
                break
        if ok and touches_empty:
            candidates.append((pair_count, compared, supported_pairs, touches_empty, s))
    if not candidates:
        return None, []
    best = max(candidates)
    bests = [c for c in candidates if c[:-1] == best[:-1]]
    return best[-1], candidates

