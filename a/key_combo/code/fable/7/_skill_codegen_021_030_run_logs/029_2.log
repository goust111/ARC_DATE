+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _most_common(values: np.ndarray) -> int:
+    return int(Counter(map(int, values.ravel())).most_common(1)[0][0])
+
+
+def _patch_key(patch: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    return tuple(tuple(int(x) for x in row) for row in patch.tolist())
+
+
+def _orbit_cells(
+    r: int,
+    c: int,
+    row_s: int,
+    col_s: int,
+    row_count: int,
+    col_count: int,
+) -> tuple[tuple[int, int], ...]:
+    rows = {int(r)}
+    rr = int(row_s) - int(r)
+    if 0 <= rr < row_count:
+        rows.add(rr)
+
+    cols = {int(c)}
+    cc = int(col_s) - int(c)
+    if 0 <= cc < col_count:
+        cols.add(cc)
+
+    return tuple(sorted((orow, ocol) for orow in rows for ocol in cols))
+
+
+def _partition_orbits(
+    row_count: int,
+    col_count: int,
+    row_s: int,
+    col_s: int,
+) -> list[tuple[tuple[int, int], ...]]:
+    seen: set[tuple[int, int]] = set()
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(row_count):
+        for c in range(col_count):
+            if (r, c) in seen:
+                continue
+            orbit = _orbit_cells(r, c, row_s, col_s, row_count, col_count)
+            seen.update(orbit)
+            orbits.append(orbit)
+    return orbits
