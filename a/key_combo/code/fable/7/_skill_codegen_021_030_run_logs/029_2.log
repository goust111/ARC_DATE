+    col_steps = [b - a for a, b in zip(col_lines, col_lines[1:])]
+    if len(set(row_steps)) != 1 or len(set(col_steps)) != 1:
+        return None
+    if row_steps[0] <= 1 or col_steps[0] <= 1:
