+    off_center = [value for value in all_values if value != n - 1]
+    if off_center and random.random() < 0.75:
+        return random.choice(off_center)
+    return random.choice(all_values)
+
+
+def _make_pattern(
+    cell_h: int,
+    cell_w: int,
+    used: set[tuple[tuple[int, ...], ...]],
+) -> np.ndarray | None:
