+    rr = int(row_s) - int(r)
+    if 0 <= rr < row_count:
+        rows.add(rr)
+
+    cols = {int(c)}
+    cc = int(col_s) - int(c)
+    if 0 <= cc < col_count:
+        cols.add(cc)
