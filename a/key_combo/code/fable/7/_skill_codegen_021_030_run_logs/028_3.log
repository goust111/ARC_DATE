+    if h == 1 and area == w and w >= MIN_BAR_LEN:
+        return ("H", w, (r0, c0))
+    if w == 1 and area == h and h >= MIN_BAR_LEN:
+        return ("V", h, (r0, c0))
+    return None
+
+
+def _find_instruction_bars(grid: np.ndarray):
+    bg = int(get_bg(grid))
