    draw_line(grid=grid, r=r0 + 1, c=c1, color=Color.GREY, direction=(1, 0), length=box_h - 2)

    # Teal corners.
    grid[r0, c0] = Color.TEAL
    grid[r0, c1] = Color.TEAL
    grid[r1, c0] = Color.TEAL
    grid[r1, c1] = Color.TEAL

