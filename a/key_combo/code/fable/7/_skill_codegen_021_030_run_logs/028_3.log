            for coord_map in D4_MAPS:
                if coord_map(*src_slot) == slot:
                    candidates.append(_transform_mask(src_mask, coord_map))
        completed[slot] = _unique_mask(candidates, slot)

    out = np.zeros_like(g)
    for tile_r, slot_r in enumerate((-1, 0, 1)):
