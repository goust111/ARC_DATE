+def _bar_signature(coords: np.ndarray):
+    rs = coords[:, 0]
+    cs = coords[:, 1]
+    r0 = int(rs.min())
+    r1 = int(rs.max())
+    c0 = int(cs.min())
+    c1 = int(cs.max())
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
