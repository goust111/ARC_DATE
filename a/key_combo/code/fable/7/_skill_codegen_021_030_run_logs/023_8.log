+        return r1, c0
+    return r1, c1
+
+
+def _trace_stair(
+    shape: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+    step: int,
+    corner: str,
+) -> list[tuple[int, int]]:
+    start_r, start_c = _start_corner(bbox, corner)
