+def _render_from_specs(grid: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    bg = int(get_bg(out))
+    for spec in specs:
+        for r, c in spec["stair_cells"]:
