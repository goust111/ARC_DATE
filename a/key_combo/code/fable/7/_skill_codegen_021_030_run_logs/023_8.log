    random.shuffle(candidates)
    picked: list[Cell] = []
    removed: set[Cell] = set()

    for cell in candidates:
        if any((rr, cc) in removed for rr, cc in neighbors4(*cell)):
            continue
        trial = removed | {cell}
        if _connected_after_removal(n, blob, trial):
            picked.append(cell)
            removed.add(cell)
    return picked


