+            chosen_set = set(trial)
+            if all(any(seg_idx in chosen_set for seg_idx in pool) for pool in pools):
+                selected = trial
+                changed = True
+                break
+
+    selected.sort()
+    return [true_cells[idx] for idx in selected]
+
