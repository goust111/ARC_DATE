+        moves.append(
+            {
+                "from_r": r,
+                "from_c": c,
+                "to_r": next_r,
+                "to_c": next_c,
+                "wall_bounces": wall_bounces,
+                "bounced_now": bounced_now,
+            }
+        )
+        r, c, dc = next_r, next_c, next_dc
