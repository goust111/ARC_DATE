+
+def _generate_case(rng: np.random.Generator) -> tuple[np.ndarray, PathResult]:
+    h = int(rng.integers(12, 25))
+    w = int(rng.integers(10, 25))
+    start_col = int(rng.integers(w))
+    init_dc = -1 if int(rng.integers(2)) == 0 else 1
