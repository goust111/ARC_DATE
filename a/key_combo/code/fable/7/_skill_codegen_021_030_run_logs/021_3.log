+                inside_neighbors.append(nxt)
+        random.shuffle(inside_neighbors)
+        for first in inside_neighbors:
+            path = [start, first]
+            visited = {start, first}
+            solved = _dfs_path(shape, length, path, visited)
+            if solved is None:
+                continue
+            if require_turn and _turn_count(solved) == 0:
