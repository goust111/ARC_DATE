+def _random_partition(total: int, parts: int) -> list[int]:
+    assert 1 <= parts <= total
+    for _ in range(200):
+        cuts = sorted(random.sample(range(1, total), parts - 1))
+        values = [cuts[0], *[b - a for a, b in zip(cuts, cuts[1:])], total - cuts[-1]] if cuts else [total]
