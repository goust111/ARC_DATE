+BG = Color.BLACK
+PATH_COLOR = Color.GREY
+SEPARATOR_COLOR = Color.MAROON
+STRIPE_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL]
+MAX_GENERATION_ATTEMPTS = 400
