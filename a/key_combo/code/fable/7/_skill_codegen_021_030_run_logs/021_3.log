+def _analyze_grid(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    h, _w = g.shape
+    candidates = []
+    for sep_row in range(1, h - 1):
+        if not np.all(g[sep_row, :] == g[sep_row, 0]):
+            continue
+        top = _stripe_sequence(g[:sep_row, :])
