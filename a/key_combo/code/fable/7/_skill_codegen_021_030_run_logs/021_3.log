+
+def _generate_path(shape: tuple[int, int], length: int, stripe_side: str, require_turn: bool) -> list[tuple[int, int]] | None:
+    h, w = shape
+    if h < 5 or w < 5 or length < 2:
+        return None
+    if 1 + (h - 2) * (w - 2) < length:
