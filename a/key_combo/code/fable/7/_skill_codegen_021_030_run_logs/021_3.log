+def _render_case(meta: dict) -> tuple[np.ndarray, np.ndarray]:
+    stripe_region = meta["stripe_region"]
+    path_region = np.full(meta["path_shape"], BG, dtype=int)
+    for r, c in meta["path_local"]:
