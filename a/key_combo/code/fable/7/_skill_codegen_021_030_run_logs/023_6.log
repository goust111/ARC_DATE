from collections import deque, Counter
from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/023/6.py')
mod = SourceFileLoader('new_arc_task_verify', str(p)).load_module()

def components(grid, bg):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(grid[r, c]) == bg:
                continue
            color = int(grid[r, c])
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            rs = [x for x, _ in cells]
            cs = [y for _, y in cells]
            r0, r1 = min(rs), max(rs)
            c0, c1 = min(cs), max(cs)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for rr, cc in cells:
                patch[rr - r0, cc - c0] = color
            out.append({'color': color, 'cells': cells, 'bbox': (r0, c0, r1, c1), 'patch': patch})
    return out

def hole_mask(patch, bg):
    h, w = patch.shape
    ext = np.zeros((h, w), dtype=bool)
    q = deque()
    for r in range(h):
        for c in (0, w - 1):
            if patch[r, c] == bg and not ext[r, c]:
                ext[r, c] = True
                q.append((r, c))
    for c in range(w):
        for r in (0, h - 1):
            if patch[r, c] == bg and not ext[r, c]:
                ext[r, c] = True
                q.append((r, c))
    while q:
        r, c = q.popleft()
        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= nr < h and 0 <= nc < w and patch[nr, nc] == bg and not ext[nr, nc]:
                ext[nr, nc] = True
                q.append((nr, nc))
    return (patch == bg) & (~ext)

def count_holes(patch, bg):
    hm = hole_mask(patch, bg)
    h, w = hm.shape
    seen = np.zeros((h, w), dtype=bool)
    n = 0
    for r in range(h):
        for c in range(w):
            if seen[r, c] or not hm[r, c]:
                continue
            n += 1
            q = deque([(r, c)])
            seen[r, c] = True
            while q:
                rr, cc = q.popleft()
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and hm[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
    return n

def filled_signature(patch, bg):
    sig = patch.copy()
    sig[hole_mask(patch, bg)] = 99
    return sig "'!= bg

sigs = set()
key_holes_seen = Counter()
lower_counts_seen = Counter()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray) and isinstance(out, np.ndarray)
    assert inp.ndim == 2 and out.ndim == 2
    assert max(inp.shape) <= 30 and max(out.shape) <= 30

    bg = Counter(map(int, inp.flat)).most_common(1)[0][0]
    sep_rows = [r for r in range(inp.shape[0]) if int(inp[r, 0]) != bg and np.all(inp[r, :] == inp[r, 0])]
    assert len(sep_rows) == 1
    sep = sep_rows[0]
    upper = inp[:sep, :]
    lower = inp[sep + 1 :, :]
    key_comps = components(upper, bg)
    lower_comps = components(lower, bg)
    assert len(key_comps) == 1
    assert len(lower_comps) >= 4

    key = key_comps[0]
    k = count_holes(key['"'patch'], bg)
    key_holes_seen[k] += 1
    lower_counts_seen[len(lower_comps)] += 1
    key_area = int(np.count_nonzero(key['patch'] "'!= bg))
    key_color = key['"'color']
    key_sig = filled_signature(key['patch'], bg)

    counts = [count_holes(obj['patch'], bg) for obj in lower_comps]
    assert len(counts) == len(set(counts))
    matches = [obj for obj, cnt in zip(lower_comps, counts) if cnt == k]
    assert len(matches) == 1
    target = matches[0]

    same_color = [obj for obj, cnt in zip(lower_comps, counts) if obj['color'] == key_color and cnt "'!= k]
    same_area = [obj for obj, cnt in zip(lower_comps, counts) if np.count_nonzero(obj['"'patch'] "'!= bg) == key_area and cnt != k]
    same_shape = [obj for obj, cnt in zip(lower_comps, counts) if cnt != k and np.array_equal(filled_signature(obj['"'patch'], bg), key_sig)]
    assert len(same_color) == 1
    assert len(same_area) == 1
    assert len(same_shape) == 1

    expected = target['patch'].copy()
    expected[hole_mask(expected, bg)] = key_color
    assert np.array_equal(out, expected)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

print('variants', len(sigs))
print('key_holes', dict(sorted(key_holes_seen.items())))
print('lower_object_counts', dict(sorted(lower_counts_seen.items())))
assert len(sigs) >= 20
assert len(key_holes_seen) >= 3
assert len(lower_counts_seen) >= 2
