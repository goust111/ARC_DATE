+    lower_other_colors = [c for c in range(1, 10) if c not in {sep_color, key_color}]
+    if len(lower_other_colors) < 3 + len(extras):
+        return None
+    target_color, shape_color, area_color, *extra_colors = random.sample(lower_other_colors, 3 + len(extras))
+
+    key_patch = _make_rect_object(key_h, key_w, key_color, key_holes)
+    target_patch = _make_rect_object(target_dims[0], target_dims[1], target_color, key_holes)
+    shape_patch = _make_rect_object(key_h, key_w, shape_color, shape_holes)
+    area_dims = random.choice(_dims_for_exact_area(key_area, area_holes, exclude=key_dims))
+    area_patch = _make_rect_object(area_dims[0], area_dims[1], area_color, area_holes)
+    same_color_dims = random.choice(_dims_for_holes(same_color_holes, exclude=key_dims))
+    same_color_patch = _make_rect_object(same_color_dims[0], same_color_dims[1], key_color, same_color_holes)
+
+    lower_patches = [target_patch, shape_patch, area_patch, same_color_patch]
+    for (kind, holes, dims, _), color in zip(extras, extra_colors):
+        assert kind == "extra"
+        lower_patches.append(_make_rect_object(dims[0], dims[1], color, holes))
+
+    max_lower_h = max(p.shape[0] for p in lower_patches)
+    max_lower_w = max(p.shape[1] for p in lower_patches)
+    min_top_h = key_patch.shape[0] + 2
+    top_h = random.randint(min_top_h, min(min_top_h + 4, 30 - 1 - (max_lower_h + 4)))
+    max_bottom_h_allowed = 30 - top_h - 1
+    min_bottom_h = max(max_lower_h + 2, 10)
+    if min_bottom_h > max_bottom_h_allowed:
+        return None
+    bottom_h = random.randint(min_bottom_h, min(max_bottom_h_allowed, min_bottom_h + 6))
+    min_w = max(key_patch.shape[1], max_lower_w) + 2
+    panel_w = random.randint(max(18, min_w), 30)
+
+    key_pos_list = _place_boxes(top_h, panel_w, [key_patch], margin=1)
+    lower_pos_list = _place_boxes(bottom_h, panel_w, lower_patches, margin=1)
+    if key_pos_list is None or lower_pos_list is None:
+        return None
+
+    grid = np.full((top_h + 1 + bottom_h, panel_w), BG, dtype=int)
+    grid[top_h, :] = sep_color
+    paste(grid, key_patch, key_pos_list[0][0], key_pos_list[0][1], transparent=BG)
+    for patch, (r, c) in zip(lower_patches, lower_pos_list):
+        paste(grid, patch, top_h + 1 + r, c, transparent=BG)
+
+    try:
+        info = _analyze_case(grid)
+    except Exception:
+        return None
+    if not np.array_equal(main(grid), info["expected"]):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _build_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid hole-lock ARC input")

