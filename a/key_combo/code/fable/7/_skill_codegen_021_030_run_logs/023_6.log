+def _box_overlaps(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah + pad <= br
+        or br + bh + pad <= ar
+        or ac + aw + pad <= bc
+        or bc + bw + pad <= ac
+    )
+
+
+def _place_boxes(panel_h: int, panel_w: int, patches: list[np.ndarray], margin: int = 1) -> list[tuple[int, int]] | None:
+    order = list(range(len(patches)))
+    random.shuffle(order)
+    placed: list[tuple[int, int] | None] = [None] * len(patches)
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        ph, pw = patches[idx].shape
+        r_lo = 0 if panel_h <= ph + 2 * margin else margin
+        c_lo = 0 if panel_w <= pw + 2 * margin else margin
+        r_hi = panel_h - ph if panel_h <= ph + 2 * margin else panel_h - ph - margin
+        c_hi = panel_w - pw if panel_w <= pw + 2 * margin else panel_w - pw - margin
+        if r_hi < r_lo or c_hi < c_lo:
+            return None
+        for _ in range(400):
+            r = random.randint(r_lo, r_hi)
+            c = random.randint(c_lo, c_hi)
+            box = (r, c, ph, pw)
+            if any(_box_overlaps(box, old, pad=1) for old in boxes):
+                continue
+            boxes.append(box)
