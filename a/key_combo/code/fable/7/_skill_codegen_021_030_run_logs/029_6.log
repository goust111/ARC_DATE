+    counts = Counter(values)
+    ranked = counts.most_common()
+    assert ranked, "empty color vote"
+    if len(ranked) > 1:
+        assert ranked[0][1] > ranked[1][1], "cellwise majority must be unique"
+    return int(ranked[0][0])
