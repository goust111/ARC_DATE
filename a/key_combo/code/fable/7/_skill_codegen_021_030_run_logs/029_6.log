+    else:
+        min_cols = max(16, 2 * w + 5)
+    max_cols = min(30, 3 * w + 8)
+    assert min_rows <= max_rows and min_cols <= max_cols
+    return random.randint(min_rows, max_rows), random.randint(min_cols, max_cols)
+
+
