+    marker_mask = (grid != bg) & ~frame_mask
+    assert marker_mask.any()
+    marker_colors = set(map(int, grid[marker_mask].ravel()))
+    assert len(marker_colors) == 1
+    markers = np.argwhere(marker_mask)
+    return bg, frames, markers
