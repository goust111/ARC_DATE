+    orientation = "horizontal" if _RNG.random() < 0.5 else "vertical"
+    combined: list[tuple[int, int, int, int]] = []
+
+    if orientation == "horizontal":
+        patch_h = max(heights) + int(_RNG.integers(0, 3))
+        x = 0
