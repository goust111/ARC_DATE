+    sorted_caps = sorted(capacities)
+    for _ in range(200):
+        picked = sorted(map(int, _RNG.choice(values, size=count, replace=False)))
+        if any(picked[i] > sorted_caps[i] for i in range(count)):
+            continue
+        for _ in range(50):
+            perm = picked.copy()
+            _RNG.shuffle(perm)
+            if all(perm[i] <= capacities[i] for i in range(count)):
