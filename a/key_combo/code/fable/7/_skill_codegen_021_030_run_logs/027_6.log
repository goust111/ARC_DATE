+def _standalone_region() -> list[tuple[int, int, int, int]]:
+    h = int(_RNG.integers(5, 8))
+    w = int(_RNG.integers(5, 8))
+    return [(0, 0, h - 1, w - 1)]
+
+
+def _chain_region(depth: int) -> list[tuple[int, int, int, int]]:
