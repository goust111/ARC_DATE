_GEN_MAX_FIXED_TILES = 3
_GEN_RETRY_LIMIT = 300


def _gen_edge_bit_cell_count(bits: int) -> int:
    cells = 0
    bit_i = 0
    for _ in _GEN_EDGE_FREE_ROWS:
        for c in _GEN_EDGE_FREE_COLS:
            if bits & (1 << bit_i):
                cells += 1 if c == _GEN_TILE_SIZE // 2 else 2
            bit_i += 1
