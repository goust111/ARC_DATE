def _gen_tile_origin(tile_r: int, tile_c: int) -> tuple[int, int]:
    return _GEN_TILE_OFFSET + _GEN_TILE_STRIDE * tile_r, _GEN_TILE_OFFSET + _GEN_TILE_STRIDE * tile_c


