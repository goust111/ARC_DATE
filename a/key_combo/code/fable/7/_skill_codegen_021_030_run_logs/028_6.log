+        frames = []
+        acc_r = 0
+        acc_c = 0
+        for level in range(depth):
+            frames.append((r0 + acc_r, c0 + acc_c, r0 + outer_h - 1 - acc_r, c0 + outer_w - 1 - acc_c))
