+    def dfs(order: list[int], positions: dict[int, tuple[int, int]], occupied: set[tuple[int, int]]) -> None:
+        curr_idx = order[-1]
+        curr_piece = pieces[curr_idx]
+        if curr_piece.tenon_side is None:
