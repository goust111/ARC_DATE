+    order = list(range(len(pieces)))
+    random.shuffle(order)
+    for idx in order:
+        piece = pieces[idx]
+        ph, pw = piece.crop.shape
+        anchors = [(r, c) for r in range(H - ph + 1) for c in range(W - pw + 1)]
+        random.shuffle(anchors)
+        placed = False
+        for r, c in anchors:
+            rr0 = max(0, r - 1)
+            cc0 = max(0, c - 1)
+            rr1 = min(H, r + ph + 1)
+            cc1 = min(W, c + pw + 1)
+            if blocked[rr0:rr1, cc0:cc1].any():
+                continue
+            paste(grid, piece.crop, r, c, transparent=BG)
+            blocked[rr0:rr1, cc0:cc1] = True
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        sampled = _sample_piece_specs()
+        if sampled is None:
+            continue
+        pieces, expected = sampled
+        grid = _scatter_input(pieces)
+        if grid is None:
+            continue
+        parsed = _pieces_from_grid(grid)
+        assemblies = _enumerate_valid_assemblies(parsed)
+        if len(assemblies) != 1:
+            continue
+        solved = main(grid)
+        if np.array_equal(solved, expected):
+            return grid
+    raise RuntimeError("failed to generate a valid tenon-mortise chain input")

