+
+def _random_directions(link_count: int) -> list[str]:
+    for _ in range(200):
+        dirs = [random.choice(SIDES)]
+        for _idx in range(1, link_count):
+            choices = [side for side in SIDES if side != OPPOSITE[dirs[-1]]]
+            dirs.append(random.choice(choices))
+        if len(set(dirs)) == 1:
