+        body_w = c1 - c0 + 1
+        if min(body_h, body_w) < 3:
+            continue
+
+        body_mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        outside_mask = mask.copy()
+        outside_mask[r0 : r1 + 1, c0 : c1 + 1] = False
+        tenon = _extract_outside(outside_mask, mask, (r0, c0, r1, c1))
+        if tenon is None:
+            continue
+        mortise = _extract_holes(body_mask)
+        if mortise is None:
