+
+def _choose_actual_profile(normalized: tuple[int, ...], side_len: int) -> tuple[int, ...]:
+    max_start = side_len - 1 - max(normalized)
+    start = random.randint(0, max_start)
+    return tuple(int(start + v) for v in normalized)
