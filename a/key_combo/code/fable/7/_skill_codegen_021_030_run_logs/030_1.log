+
+
+def _candidate_lists_from_grid(grid: np.ndarray) -> list[list[Piece]]:
+    candidate_lists = []
+    for comp in find_components(np.asarray(grid, dtype=int), bg=BG, connectivity=4, monochromatic=False):
