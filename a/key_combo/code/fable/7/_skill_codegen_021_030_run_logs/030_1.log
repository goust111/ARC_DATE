+    assert candidates, "failed to identify the body rectangle"
+    best_area = max(area for area, _piece in candidates)
+    best = [piece for area, piece in candidates if area == best_area]
+    assert len(best) == 1, "body rectangle must be unique"
+    return best[0]
+
+
+def _pieces_from_grid(grid: np.ndarray) -> list[Piece]:
+    pieces = []
+    for comp in find_components(np.asarray(grid, dtype=int), bg=BG, connectivity=4, monochromatic=False):
+        crop = crop_bbox(grid, comp["bbox"])
