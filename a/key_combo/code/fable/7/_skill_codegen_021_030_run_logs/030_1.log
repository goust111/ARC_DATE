+    pattern
+    for span in range(3, 5)
+    for size in range(2, min(4, span + 1) + 1)
+    for pattern in itertools.combinations(range(span + 1), size)
+    if pattern[0] == 0 and pattern[-1] == span and _mirror_profile(pattern) != pattern
