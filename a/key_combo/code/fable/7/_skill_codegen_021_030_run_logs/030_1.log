+
+def _extract_holes(body_mask: np.ndarray) -> tuple[str | None, tuple[int, ...]] | None:
+    coords = np.argwhere(~body_mask)
+    if coords.size == 0:
+        return None, ()
+    h, w = body_mask.shape
+    valid: list[tuple[str, tuple[int, ...]]] = []
