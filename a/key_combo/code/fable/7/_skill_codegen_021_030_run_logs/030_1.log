+    min_c = min(box[1] for box in placed_boxes)
+    max_r = max(box[2] for box in placed_boxes)
+    max_c = max(box[3] for box in placed_boxes)
+    out = np.full((max_r - min_r + 1, max_c - min_c + 1), BG, dtype=int)
