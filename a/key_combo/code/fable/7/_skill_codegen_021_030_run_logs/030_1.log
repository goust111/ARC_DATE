+        profile = tuple(sorted(int(c) for _r, c in coords))
+        if len(profile) < w:
+            valid.append(("up", profile))
+    if np.all(coords[:, 0] == h - 1):
+        profile = tuple(sorted(int(c) for _r, c in coords))
+        if len(profile) < w:
+            valid.append(("down", profile))
+    if np.all(coords[:, 1] == 0):
+        profile = tuple(sorted(int(r) for r, _c in coords))
