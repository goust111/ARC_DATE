+        used: set[tuple[int, ...]] = set()
+        profiles: list[tuple[int, ...] | None] = [None] * link_count
+
+        len_a0 = _side_len(*body_shapes[mirror_a], directions[mirror_a])
+        len_a1 = _side_len(*body_shapes[mirror_a + 1], OPPOSITE[directions[mirror_a]])
