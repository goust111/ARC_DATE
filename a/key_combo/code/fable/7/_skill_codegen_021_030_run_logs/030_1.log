+def _scatter_input(pieces: list[Piece]) -> np.ndarray | None:
+    max_h = max(piece.crop.shape[0] for piece in pieces)
+    max_w = max(piece.crop.shape[1] for piece in pieces)
+    H = random.randint(max(18, max_h + 6), 30)
