    for r, c in coords:
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                rr, cc = int(r + dr), int(c + dc)
                if not (0 <= rr < h and 0 <= cc < w):
                    continue
                if (rr, cc) in seen or _gen_in_bbox(rr, cc, core_box):
                    continue
                seen.add((rr, cc))
