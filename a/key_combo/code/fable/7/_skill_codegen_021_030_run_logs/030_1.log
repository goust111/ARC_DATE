+def _match(curr: Piece, nxt: Piece) -> bool:
+    if curr.tenon_side is None or nxt.mortise_side is None:
+        return False
+    return nxt.mortise_side == OPPOSITE[curr.tenon_side] and curr.norm_tenon == nxt.norm_mortise
