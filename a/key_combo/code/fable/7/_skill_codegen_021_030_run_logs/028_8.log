def _gen_make_bboxes(h, w, n):
    layouts = []
    has_pair_split = (
        _gen_has_split(h, _GEN_PAIR_COUNT, _GEN_RECT_HEIGHT_RANGE)
        and _gen_has_split(w, _GEN_PAIR_COUNT, _GEN_RECT_WIDTH_RANGE)
