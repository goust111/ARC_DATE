+    "domino": ((0, 0), (0, 1)),
+    "diag_pair": ((0, 0), (1, 1)),
+    "line3": ((0, 0), (0, 1), (0, 2)),
+    "l3": ((0, 0), (1, 0), (1, 1)),
+    "square2": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "t4": ((0, 0), (0, 1), (0, 2), (1, 1)),
+    "plus5": ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+    "ring8": ((0, 0), (0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1), (2, 2)),
