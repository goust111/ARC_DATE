+        ok = True
+        for comp in comps:
+            box = tuple(map(int, comp["bbox"]))
+            area = int(comp["area"])
+            if area == 4 and bbox_h(box) == 2 and bbox_w(box) == 2:
+                boxes.append(box)
+                continue
+            if area != 1:
+                ok = False
+                break
+        if not ok:
+            continue
+        if len(boxes) != 2 or len(comps) - len(boxes) > 1:
+            continue
