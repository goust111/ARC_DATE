+def _sample_layout(rng: np.random.Generator, num_segments: int, gap_width: int) -> tuple[int, int, list[int], list[int]]:
+    pair_width = gap_width + 2 * MARKER_SIZE
+    extra_height = int(rng.integers(0, 7))
