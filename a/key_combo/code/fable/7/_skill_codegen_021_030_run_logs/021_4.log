+        left, right = sorted(boxes, key=lambda b: (b[1], b[0]))
+        if (left[0], left[2]) != (right[0], right[2]):
+            continue
+
+        gap_width = int(right[1] - left[3] - 1)
+        if gap_width <= 0:
+            continue
+
+        pairs[int(color)] = {
+            "left": left,
+            "right": right,
+            "row": int(left[0]),
+            "gap_width": gap_width,
