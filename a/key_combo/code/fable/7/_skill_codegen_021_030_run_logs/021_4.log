+def _pointer_slots(stripe: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    h, w = stripe.shape
+    assert h == 2
+    slots = []
+    for r in range(h):
+        for c in range(w):
+            if int(stripe[r, c]) != bg:
+                continue
+            clear = True
+            for rr in range(max(0, r - 1), min(h, r + 2)):
+                for cc in range(max(0, c - 1), min(w, c + 2)):
+                    if (rr, cc) == (r, c):
+                        continue
+                    if int(stripe[rr, cc]) != bg:
+                        clear = False
