+        width = int(rng.integers(MIN_PROTO_SIDE, MAX_PROTO_SIDE + 1))
+        area_lo = max(height + width - 2, (height * width) // 2)
+        area_hi = height * width - 2
+        if area_lo > area_hi:
+            continue
