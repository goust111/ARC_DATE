+
+def _mask_points(mask: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, coord)) for coord in np.argwhere(mask)}
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    if not bool(mask.any()):
+        return False
+    _lab, n = label_mask(mask, connectivity=4)
+    return int(n) == 1
+
+
+def _grow_polyomino(height: int, width: int, area: int, rng: np.random.Generator) -> np.ndarray:
+    seed = (int(rng.integers(0, height)), int(rng.integers(0, width)))
+    cells = {seed}
+    while len(cells) < area:
+        frontier: list[tuple[int, int]] = []
+        for r, c in cells:
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                    frontier.append((nr, nc))
+        if not frontier:
+            break
+        cells.add(frontier[int(rng.integers(0, len(frontier)))])
+
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(
+        mask[0].any()
+        and mask[-1].any()
+        and mask[:, 0].any()
+        and mask[:, -1].any()
+    )
+
+
+def _prototype_ok(mask: np.ndarray) -> bool:
+    if not _is_connected(mask):
+        return False
+    if not _touches_all_sides(mask):
+        return False
+    if bool(mask.all()):
+        return False
+    area = int(mask.sum())
+    h, w = mask.shape
+    if area < max(h + w - 2, 7):
+        return False
+    if area > h * w - 2:
+        return False
+    return True
