+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+MAX_PROTO_SIDE = 8
+MIN_PROTO_SIDE = 4
+MIN_COPY_COUNT = 3
+MAX_COPY_COUNT = 4
+MAX_GENERATION_ATTEMPTS = 400
