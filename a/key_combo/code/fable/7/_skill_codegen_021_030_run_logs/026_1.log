+    assert len(library) >= 8
+    return library
+
+
+SYMBOL_LIBRARY = _build_symbol_library()
+
+
+def _render_symbol(mask: np.ndarray) -> np.ndarray:
+    patch = np.zeros((BLOCK, BLOCK), dtype=int)
+    patch[mask.astype(bool)] = GREY
+    return patch
+
