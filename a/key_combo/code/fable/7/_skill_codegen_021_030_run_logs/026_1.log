import numpy as np
# enumerate all 3x3 binary masks with 4-conn and no rotational symmetry; find some diverse canonical classes
from collections import defaultdict

def comps(mask):
    pts = [(r,c) for r in range(3) for c in range(3) if mask[r,c]]
    if not pts:
        return 0
    seen={pts[0]}
    stack=[pts[0]]
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<3 and 0<=nc<3 and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc));stack.append((nr,nc))
    return len(seen)==len(pts)

def canon(mask):
    rots=[np.rot90(mask,k) for k in range(4)]
    strs=[''.join('1' if x else '0' for x in m.flatten()) for m in rots]
    i=min(range(4), key=lambda k:strs[k])
    return strs[i], i

classes=defaultdict(list)
for bits in range(1,1<<9):
    m=np.array([(bits>>i)&1 for i in range(9)],dtype=bool).reshape(3,3)
    if not comps(m):
        continue
    if any(np.array_equal(m,np.rot90(m,k)) for k in (1,2,3)):
        continue
    c,_=canon(m)
    classes[c].append(m)
print('classes',len(classes))
for idx,(c,masks) in enumerate(list(classes.items())[:20]):
    m=masks[0]
    print('class',idx,'area',m.sum())
    for row in m.astype(int):
        print(''.join(map(str,row)))
    print()
