import numpy as np

def connected(mask):
    pts=[(r,c) for r in range(3) for c in range(3) if mask[r,c]]
    if not pts:
        return False
    seen={pts[0]}; stack=[pts[0]]
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<3 and 0<=nc<3 and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(pts)

def bbox(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
    return r0,c0,r1,c1

def key(mask):
    return ''.join('1' if x else '0' for x in mask.flatten())
classes=[]
