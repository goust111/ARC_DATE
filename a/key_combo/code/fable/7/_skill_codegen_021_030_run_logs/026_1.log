+
+
+BLOCK = 3
+GAP = 1
+STEP = BLOCK + GAP
+MASTER_SLOTS = 7
+MASTER_SIZE = 1 + MASTER_SLOTS * STEP
+MASTER_SHAPE = (MASTER_SIZE, MASTER_SIZE)
+GREY = Color.GREY
+BG = Color.BLACK
