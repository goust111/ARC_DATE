  24: def main(grid: np.ndarray) -> np.ndarray:
  25:     """
  26:     Fill unobstructed horizontal gaps between neighboring foreground objects with maroon.
  27: 
  28:     Input structure
  29:     - The grid has one connected background color and one foreground color split into several 4-connected solid rectangles.
  30:     - Foreground rectangles can be horizontally separated while overlapping in their row spans.
  31:     Rule
  32:     - For every pair of foreground rectangles with separated column spans and overlapping row spans, consider the rectangle between their bounding boxes.
  33:     - Paint that between-box region maroon when no third foreground rectangle has a bounding box crossing both that horizontal gap and the same shared row span.
  34:     - Keep all original pixels unchanged.
  35:     Key insight
  36:     - The bridges are determined by adjacency of object bounding boxes in horizontal layers, not by scanning each row independently.
  37:     """
  38:     g = np.asarray(grid, dtype=int)
  39:     assert g.ndim == 2
  40: 
  41:     bg, foreground = _infer_bg_and_foreground(g)
  42:     bridge = Color.MAROON
  43:     assert bridge not in set(map(int, np.unique(g))), "maroon is reserved for the added bridges"
  44: 
  45:     objects = find_components(
  46:         g,
  47:         bg=bg,
  48:         connectivity=4,
  49:         monochromatic=True,
  50:         colors=[foreground],
  51:         return_format="dict",
  52:     )
  53:     assert len(objects) >= 2, "expected multiple foreground rectangles"
  54: 
  55:     boxes = []
  56:     for obj in objects:
  57:         r0, c0, r1, c1 = obj["bbox"]
  58:         expected_area = (r1 - r0 + 1) * (c1 - c0 + 1)
  59:         assert obj["area"] == expected_area, "foreground objects must be solid rectangles"
  60:         boxes.append((r0, c0, r1, c1))
  61: 
  62:     out = g.copy()
  63:     painted_any = False
  64:     for i in range(len(boxes)):
  65:         ar0, ac0, ar1, ac1 = boxes[i]
  66:         for j in range(i + 1, len(boxes)):
  67:             br0, bc0, br1, bc1 = boxes[j]
  68:             if ac1 < bc0:
  69:                 left = (ar0, ac0, ar1, ac1)
  70:                 right = (br0, bc0, br1, bc1)
  71:             elif bc1 < ac0:
  72:                 left = (br0, bc0, br1, bc1)
  73:                 right = (ar0, ac0, ar1, ac1)
  74:             else:
  75:                 continue
  76: 
  77:             lr0, _, lr1, lc1 = left
  78:             rr0, rc0, rr1, _ = right
  79:             row0 = max(lr0, rr0)
  80:             row1 = min(lr1, rr1)
  81:             if row0 > row1:
  82:                 continue
  83: 
  84:             gap0 = lc1 + 1
  85:             gap1 = rc0 - 1
  86:             assert gap0 <= gap1, "separate rectangles should leave a nonempty gap"
  87: 
  88:             blocked = False
  89:             for k, (blocker_r0, blocker_c0, blocker_r1, blocker_c1) in enumerate(boxes):
  90:                 if k in (i, j):
  91:                     continue
  92:                 blocks_gap = _ranges_overlap(gap0, gap1, blocker_c0, blocker_c1)
  93:                 blocks_rows = _ranges_overlap(row0, row1, blocker_r0, blocker_r1)
  94:                 if blocks_gap and blocks_rows:
  95:                     blocked = True
  96:                     break
  97:             if blocked:
  98:                 continue
  99: 
 100:             assert np.all(g[row0 : row1 + 1, gap0 : gap1 + 1] == bg), "bridge region must be empty"
 101:             out[row0 : row1 + 1, gap0 : gap1 + 1] = bridge
 102:             painted_any = True
 103: 
 104:     assert painted_any, "expected at least one horizontal bridge"
 105:     return out
