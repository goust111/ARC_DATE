+
+
+def _resolve_color(key: str, direct: dict[str, int], synonym: dict[str, str]) -> int:
+    seen = set()
+    cur = key
+    while cur not in direct:
+        assert cur in synonym, f"unresolved glyph {cur}"
+        assert cur not in seen, "synonym chain must be acyclic"
+        seen.add(cur)
+        cur = synonym[cur]
