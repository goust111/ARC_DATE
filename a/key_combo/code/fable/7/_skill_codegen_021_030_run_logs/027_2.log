+        cells = list(np.ndindex(h, w))
+        RNG.shuffle(cells)
+        for r, c in cells:
+            if int(mask.sum()) <= target_area:
+                break
+            mask[r, c] = False
+            if not _connected(mask) or not _touches_all_sides(mask):
+                mask[r, c] = True
+        if int(mask.sum()) >= min_area and int(mask.sum()) < h * w and _connected(mask) and _touches_all_sides(mask):
+            return mask
+    return None
