+        return None
+    inner = patch[1:-1, 1:-1]
+    inner_colors = {int(v) for v in inner.ravel()}
+    if len(inner_colors) != 1:
+        return None
+    fill = inner_colors.pop()
+    if fill == bg or fill == border:
+        return None
+    if not np.all(patch[~edge] == fill):
+        return None
