+def _classify_rect_component(
+    grid: np.ndarray,
+    comp: dict,
+    bg: int,
+) -> dict | None:
+    bbox = tuple(map(int, comp["bbox"]))
+    r0, c0, r1, c1 = bbox
+    h, w = _bbox_hw(bbox)
+    if h < 3 or w < 3:
+        return None
+    if int(comp["area"]) != 2 * h + 2 * w - 4:
