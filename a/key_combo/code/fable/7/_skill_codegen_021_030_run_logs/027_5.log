+        return not bool(np.any(obstacles[r0 - 1, c0 : c1 + 1]))
+    if side == "down":
+        if r1 == h - 1:
+            return False
+        return not bool(np.any(obstacles[r1 + 1, c0 : c1 + 1]))
+    if side == "left":
+        if c0 == 0:
+            return False
+        return not bool(np.any(obstacles[r0 : r1 + 1, c0 - 1]))
+    if side == "right":
+        if c1 == w - 1:
+            return False
+        return not bool(np.any(obstacles[r0 : r1 + 1, c1 + 1]))
