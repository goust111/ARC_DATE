+def _make_single_scene() -> tuple[list[dict], tuple[int, int], list[str]]:
+    direction = random.choice(list(OPPOSITE))
+    branch = random.choices(["free", "bounce", "discard"], weights=[2, 3, 2], k=1)[0]
+    while True:
+        h = random.randint(3, 6)
+        w = random.randint(3, 6)
