+    h, w = map(int, shape)
+    if op == "id":
+        return r, c
+    if op == "rot90":
+        return c, h - 1 - r
+    if op == "rot180":
+        return h - 1 - r, w - 1 - c
+    if op == "rot270":
+        return w - 1 - c, r
+    if op == "flip_h":
+        return r, w - 1 - c
+    if op == "flip_v":
+        return h - 1 - r, c
+    raise ValueError(op)
+
+
+def _transform_shape(shape: tuple[int, int], op: str) -> tuple[int, int]:
+    h, w = map(int, shape)
+    if op in {"rot90", "rot270"}:
+        return w, h
+    return h, w
+
+
+def _transform_dir(direction: str, op: str) -> str:
+    if op == "id":
+        return direction
+    if op == "rot90":
+        return ROT90_DIR[direction]
+    if op == "rot180":
+        return ROT90_DIR[ROT90_DIR[direction]]
+    if op == "rot270":
+        return ROT90_DIR[ROT90_DIR[ROT90_DIR[direction]]]
+    if op == "flip_h":
+        return FLIP_H_DIR[direction]
+    if op == "flip_v":
