+
+def _translate_specs(specs: list[dict], dr: int, dc: int) -> list[dict]:
+    out = []
+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        mr, mc = spec["marker"]
+        out.append(
+            {
