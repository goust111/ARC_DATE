+
+DIR_TO_SIDE = {
+    "up": "top",
+    "down": "bottom",
+    "left": "left",
+    "right": "right",
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+ROT90_DIR = {"up": "right", "right": "down", "down": "left", "left": "up"}
+FLIP_H_DIR = {"up": "up", "down": "down", "left": "right", "right": "left"}
+FLIP_V_DIR = {"up": "down", "down": "up", "left": "left", "right": "right"}
