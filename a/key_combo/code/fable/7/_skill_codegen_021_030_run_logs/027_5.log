+def _compose_scenes(
+    scene_defs: list[tuple[list[dict], tuple[int, int], list[str]]]
+) -> tuple[list[dict], tuple[int, int], list[str]] | None:
+    gap = random.randint(2, 4)
+    if len(scene_defs) == 1:
+        specs, shape, tags = scene_defs[0]
