+            break
+    if direction in {"up", "down"}:
+        primary, secondary = _sample_axis_spaces(h, budget, branch)
+        left = random.randint(0, 3)
+        right = random.randint(0, 3)
+        if direction == "up":
+            top, bottom = primary, secondary
+        else:
+            top, bottom = secondary, primary
