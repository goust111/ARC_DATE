+        return None
+
+    info = _analyze_scene(grid)
+    if _mask_key(info["variants"][info["missing_idx"]]) != _mask_key(variants[missing_idx]):
+        return None
+    if _mask_key(info["variants"][info["repeated_idx"]]) != _mask_key(variants[repeated_idx]):
