+def _random_connected_mask(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(MASK_ATTEMPTS):
+        h = int(rng.integers(3, 7))
+        w = int(rng.integers(3, 7))
+        area_low = max(4, int(np.ceil(0.35 * h * w)))
