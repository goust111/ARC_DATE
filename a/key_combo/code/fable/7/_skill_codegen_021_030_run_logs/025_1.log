def indep_dihedral(mask):
    mask = np.asarray(mask, dtype=bool)
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    base = mask[r0:r1+1, c0:c1+1]
    out = []
    seen = set()
    for refl in (base, np.fliplr(base)):
        for k in range(4):
            v = np.rot90(refl, k).copy()
            key = (v.shape, v.tobytes())
            if key not in seen:
                seen.add(key)
                out.append(v)
    return out


def indep_components(grid):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    seen = np.zeros((H, W), dtype=bool)
    comps = []
    for r in range(H):
        for c in range(W):
            if g[r, c] == 0 or seen[r, c]:
                continue
            color = int(g[r, c])
            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                rr, cc = stack.pop()
                cells.append((rr, cc))
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        if dr == 0 and dc == 0:
                            continue
                        nr, nc = rr + dr, cc + dc
                        if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and g[nr, nc] == color:
                            seen[nr, nc] = True
                            stack.append((nr, nc))
            comps.append((color, cells))
    return comps


def indep_analyze(grid):
    comps = indep_components(grid)
    assert len(comps) == 8, len(comps)
    first_color, first_cells = comps[0]
    fr = [r for r, _ in first_cells]
    fc = [c for _, c in first_cells]
    first_mask = np.zeros((max(fr) - min(fr) + 1, max(fc) - min(fc) + 1), dtype=bool)
    for r, c in first_cells:
        first_mask[r - min(fr), c - min(fc)] = True
    variants = indep_dihedral(first_mask)
    assert len(variants) == 8
    key_to_idx = {(v.shape, v.tobytes()): i for i, v in enumerate(variants)}
    counts = [0] * 8
    orient_colors = [[] for _ in range(8)]
    color_counts = Counter()
    for color, cells in comps:
        rows = [r for r, _ in cells]
        cols = [c for _, c in cells]
        mask = np.zeros((max(rows) - min(rows) + 1, max(cols) - min(cols) + 1), dtype=bool)
        for r, c in cells:
            mask[r - min(rows), c - min(cols)] = True
        key = (mask.shape, mask.tobytes())
        assert key in key_to_idx
        idx = key_to_idx[key]
        counts[idx] += 1
        orient_colors[idx].append(color)
        color_counts[color] += 1
    missing = [i for i, n in enumerate(counts) if n == 0]
    repeated = [i for i, n in enumerate(counts) if n == 2]
    assert len(missing) == 1
    assert len(repeated) == 1
    repeated_colors = [color for color, n in color_counts.items() if n == 2]
    assert len(repeated_colors) == 1
    repeated_color = repeated_colors[0]
    missing_mask = variants[missing[0]]
    expected = np.zeros(missing_mask.shape, dtype=int)
    expected[missing_mask] = repeated_color
    return {
        'expected': expected,
        'shape_sig': (missing_mask.shape, missing_mask.tobytes()),
        'repeat_sig': (variants[repeated[0]].shape, variants[repeated[0]].tobytes()),
        'repeated_color': repeated_color,
        'counts': tuple(counts),
    }


sigs = set()
out_sigs = set()
missing_sigs = set()
repeat_sigs = set()
for i in range(150):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    analysis = indep_analyze(inp)
    assert np.array_equal(out, analysis['expected'])
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())
    missing_sigs.add(analysis['shape_sig'])
    repeat_sigs.add(analysis['repeat_sig'])
print('input_variants', len(sigs))
print('output_variants', len(out_sigs))
print('missing_shapes', len(missing_sigs))
print('repeat_shapes', len(repeat_sigs))
assert len(sigs) >= 20
assert len(out_sigs) >= 10
assert len(missing_sigs) >= 8
assert len(repeat_sigs) >= 8
