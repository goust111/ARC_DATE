+        object_count = random.choices(
+            GEN_OBJECT_COUNT_CHOICES, weights=GEN_OBJECT_COUNT_WEIGHTS, k=1
+        )[0]
+        colors = random.sample(GEN_PALETTE, object_count)
+
+        reserved: set[tuple[int, int]] = set()
+        specs: list[dict] = []
+        ok = True
+        for color in colors:
