+def _classify_relative(anchor: tuple[int, int], cell: tuple[int, int]) -> tuple[str, int] | None:
+    ar, ac = anchor
+    r, c = cell
+    if max(abs(r - ar), abs(c - ac)) <= 1:
+        return None
+    dr = r - ar
+    dc = c - ac
+    if dr == 0:
+        return "h", dc
+    if dc == 0:
+        return "v", dr
+    if dr == dc:
+        return "d1", dr
+    if dr == -dc:
+        return "d2", dr
+    return None
