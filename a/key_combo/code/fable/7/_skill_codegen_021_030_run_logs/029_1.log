+
+
+def _spec_counts(spec: dict) -> dict[str, dict[int, int]]:
+    result: dict[str, dict[int, int]] = {}
+    for orientation, side_map in spec["sides"].items():
+        result[orientation] = {-1: len(side_map.get(-1, [])), 1: len(side_map.get(1, []))}
+    return result
+
