0008:     """
0009:     Expand a diagonal-index color table by cycling its non-black header sequence.
0010: 
0011:     Input structure
0012:     - The input is a nonempty square grid.
0013:     - The top row and left column are the same header sequence.
0014:     - Every cell is the header color at index max(row, column); black header cells
0015:       appear only as a trailing blank suffix.
0016: 
0017:     Rule
0018:     - Drop the trailing black blanks from the header.
0019:     - Repeat the remaining header colors until it is twice as long as the input side.
0020:     - Fill the doubled square so each cell again takes the repeated header color
0021:       at index max(row, column).
0022: 
0023:     Key insight
0024:     - The visible pattern is not a 2D tile; it is a one-dimensional header sequence
0025:       projected through the max(row, column) diagonal-index rule.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     assert g.ndim == 2, "expected a 2D grid"
0029:     height, width = map(int, g.shape)
0030:     assert height == width and height > 0, "expected a nonempty square table"
0031: 
0032:     header = g[0, :].copy()
0033:     assert np.array_equal(g[:, 0], header), "expected matching top row and left column"
0034: 
0035:     if np.any(header == Color.BLACK):
0036:         first_blank = int(np.argmax(header == Color.BLACK))
0037:         assert np.all(header[first_blank:] == Color.BLACK), "black header cells must be trailing blanks"
0038:         active_header = header[:first_blank]
0039:     else:
0040:         active_header = header
0041:     assert active_header.size > 0, "expected a nonempty active header"
0042:     assert np.all(active_header != Color.BLACK), "active header must be non-black"
0043: 
0044:     in_index = np.maximum.outer(np.arange(height), np.arange(width))
0045:     assert np.array_equal(g, header[in_index]), "expected a diagonal-index table"
0046: 
0047:     out_size = height * 2
0048:     repeated_header = np.resize(active_header, out_size)
0049:     out_index = np.maximum.outer(np.arange(out_size), np.arange(out_size))
