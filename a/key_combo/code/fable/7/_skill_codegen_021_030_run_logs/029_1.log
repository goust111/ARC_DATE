+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+def _load_arc_utils():
+    candidates = [
+        Path("/home/lixinyu/snap/new/solvers"),
+        Path(__file__).resolve().parents[6] / "new" / "solvers",
+    ]
+    for directory in candidates:
+        if directory.is_dir():
