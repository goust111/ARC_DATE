    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

    inp2, expected, meta = mod._build_case()
    actual = mod.main(inp2)
    assert np.array_equal(actual, expected), 'main disagrees with independently rendered expected output'
    assert not np.array_equal(inp2, expected), 'degenerate case: input equals output'
    for group in meta['groups']:
        if group['bar_count'] == 1:
            stats['single_bar_groups'] += 1
        else:
            stats['multi_bar_groups'] += 1
        stats[f\"{group['side']}_groups\"] += 1
        if group['grey_count'] % 2:
            stats['odd_grey_groups'] += 1
        else:
            stats['even_grey_groups'] += 1
print('variants', len(sigs))
print('stats', stats)
assert len(sigs) >= 20
assert stats['single_bar_groups'] > 0
assert stats['multi_bar_groups'] > 0
assert stats['left_groups'] > 0 and stats['right_groups'] > 0
assert stats['odd_grey_groups'] > 0 and stats['even_grey_groups'] > 0
