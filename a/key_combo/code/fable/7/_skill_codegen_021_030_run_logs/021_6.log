from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/021/6.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
stats = {
    'single_bar_groups': 0,
    'multi_bar_groups': 0,
    'left_groups': 0,
    'right_groups': 0,
    'odd_grey_groups': 0,
    'even_grey_groups': 0,
}
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
