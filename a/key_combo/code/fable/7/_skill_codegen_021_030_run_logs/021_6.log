        grid[row : row + MARKER_SIZE, col : col + MARKER_SIZE] = MARKER_COLOR
        grid[row : row + MARKER_SIZE, col + MARKER_SIZE : right_col] = strip
        grid[row : row + MARKER_SIZE, right_col : right_col + MARKER_SIZE] = MARKER_COLOR
        protected[row : row + MARKER_SIZE, col : right_col + MARKER_SIZE] = True

def _add_noise(rng: np.random.Generator, grid: np.ndarray, protected: np.ndarray, expected: np.ndarray, num_pairs: int) -> bool:
    """Fill unprotected cells while forcing every non-marker color to appear."""
    total = grid.size
    marker_count = 2 * MARKER_SIZE * MARKER_SIZE * num_pairs
    stripe_non_bg = int(np.count_nonzero(expected))
    min_non_marker = max(int(np.ceil(NON_MARKER_DENSITY_MIN * total)), stripe_non_bg + len(GEN_COLORS))
    max_non_marker = min(int(np.floor(NON_MARKER_DENSITY_MAX * total)), total - 2 * marker_count - 1)
    if min_non_marker > max_non_marker:
        return False

    target_non_marker = int(rng.integers(min_non_marker, max_non_marker + 1))
    noise_count = target_non_marker - stripe_non_bg
    free = np.argwhere(~protected)
    if noise_count < len(GEN_COLORS) or noise_count > len(free):
        return False

    noise_coords = free[rng.choice(len(free), size=noise_count, replace=False)]
    noise_colors = rng.choice(GEN_COLORS, size=noise_count, replace=True)
    forced = GEN_COLORS.copy()
    rng.shuffle(forced)
    noise_colors[: len(forced)] = forced
    order = rng.permutation(noise_count)
    grid[noise_coords[order, 0], noise_coords[order, 1]] = noise_colors[order]
    return True

def _passes_oracle(grid: np.ndarray, expected: np.ndarray) -> bool:
    """Check background dominance and solver output match."""
    counts = np.bincount(grid.ravel(), minlength=ARC_COLOR_COUNT)
    if counts[BACKGROUND_COLOR] <= max(counts[1:]):
        return False
    try:
        actual = main(grid)
    except Exception:
        return False
    return np.array_equal(actual, expected)

def _gen_attempt() -> np.ndarray | None:
    """Run one complete generation attempt; callers handle retries."""
    rng = np.random.default_rng()
    layout = _choose_layout(rng)
    if layout is None:
        return None

    height, width, num_pairs, gap_width, row_starts, left_cols = layout
    expected = _gen_output(rng, num_pairs, gap_width)
    grid = np.zeros((height, width), dtype=int)
    protected = np.zeros((height, width), dtype=bool)
    _render_marker_pairs(grid, protected, expected, row_starts, left_cols, gap_width)

    if not _add_noise(rng, grid, protected, expected, num_pairs):
        return None
    return grid if _passes_oracle(grid, expected) else None

def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid aab50785 input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox, colors_present, components_mask, crop_bbox, get_bg, paste


def main(grid: np.ndarray) -> np.ndarray:
    """
    Vertically align all repeated colored sprites to the teal sprite's top row.

    Input structure
    The grid has a uniform background and several foreground colors. Each
    foreground color forms exactly one 4-connected sprite, and all sprites have
    the same normalized mask. The teal sprite is the vertical alignment anchor.

    Rule
    Clear the canvas to background. For every colored sprite, keep its original
    left column and shape, but paste it with its top row equal to the teal
    sprite's original top row.

    Key insight
    The sprites are already horizontally separated copies of the same mask; the
    only missing structure is their common vertical alignment to the teal copy.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert Color.TEAL in colors, "expected one teal anchor sprite"

    bboxes = {}
    sprites = {}
    anchor_sprite = None
    anchor_bbox = None

    for color in colors:
        mask = g == color
        comps = components_mask(mask, connectivity=4)
        assert len(comps) == 1, "each color must form one sprite"

        b = bbox(mask)
        assert b is not None, "sprite mask must be non-empty"
        sprite = crop_bbox(mask, b)
        bboxes[color] = b
        sprites[color] = sprite

        if color == Color.TEAL:
            anchor_sprite = sprite
            anchor_bbox = b

    assert anchor_sprite is not None and anchor_bbox is not None, "missing teal anchor"
    for color, sprite in sprites.items():
        assert sprite.shape == anchor_sprite.shape, "all sprites must have same bbox size"
        assert np.array_equal(sprite, anchor_sprite), "all sprites must have same mask"

    top = anchor_bbox[0]
    out = np.full_like(g, bg)
    for color in colors:
        _r0, c0, _r1, _c1 = bboxes[color]
        sprite = sprites[color]
        patch = np.full(sprite.shape, bg, dtype=int)
        patch[sprite] = color

        target = out[top : top + sprite.shape[0], c0 : c0 + sprite.shape[1]]
        assert target.shape == sprite.shape, "aligned sprite must fit in grid"
        assert np.all(target[sprite] == bg), "aligned sprites must not overlap"
        paste(out, patch, top, c0, transparent=bg)

    return out

