from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
import itertools
import random


def _normalized(coords: np.ndarray) -> np.ndarray:
    pts = np.asarray(coords, dtype=int)
    return pts - pts.min(axis=0)


def _orientations(coords: np.ndarray) -> list[np.ndarray]:
    pts = _normalized(coords)
    transforms = [
        lambda r, c: (r, c),
        lambda r, c: (r, -c),
        lambda r, c: (-r, c),
        lambda r, c: (-r, -c),
        lambda r, c: (c, r),
        lambda r, c: (c, -r),
        lambda r, c: (-c, r),
        lambda r, c: (-c, -r),
    ]

    out = []
    seen = set()
    for transform in transforms:
        variant = np.array([transform(int(r), int(c)) for r, c in pts], dtype=int)
        variant = _normalized(variant)
        key = tuple(sorted(map(tuple, variant.tolist())))
        if key not in seen:
            seen.add(key)
            out.append(variant)
    return out


def _compact_shape(area: int) -> tuple[int, int]:
    factors = [(h, area // h) for h in range(1, int(area**0.5) + 1) if area % h == 0]
    assert factors, "foreground area must admit a rectangular packing"
    return max(factors, key=lambda hw: hw[0])


def _placements(coords: np.ndarray, shape: tuple[int, int]) -> list[tuple[tuple[int, int], ...]]:
    height, width = shape
    out = []
    for orient in _orientations(coords):
        orient_h = int(orient[:, 0].max()) + 1
        orient_w = int(orient[:, 1].max()) + 1
        if orient_h > height or orient_w > width:
            continue
        for row in range(height - orient_h + 1):
            for col in range(width - orient_w + 1):
                cells = tuple(sorted((int(r + row), int(c + col)) for r, c in orient))
                out.append(cells)
    assert out, "each component must fit in the compact rectangle"
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Pack all foreground fragments into a solid compact rectangle while preserving their colors.

    Input structure
    - The background is the dominant color.
    - The foreground is split into monochromatic 4-connected polyomino fragments.
    - The total foreground area is exactly the area of the compact output rectangle.

    Rule
    - Sort fragments by decreasing area, with equal-area fragments ordered left-to-right in the input.
    - For each fragment, try its identity/reflected/rotated orientations in that order and scan placements from top-left to bottom-right.
    - Keep the first set of non-overlapping placements that fills the whole compact rectangle.

    Key insight
    The scattered objects are jigsaw fragments; the output is their canonical top-left packing into the smallest near-square rectangle.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert len(components) >= 2, "expected multiple foreground fragments"

    pieces = []
    for comp in components:
        r0, c0, r1, c1 = comp["bbox"]
        coords = np.asarray(comp["coords"], dtype=int) - np.array([r0, c0], dtype=int)
        pieces.append(
            {
                "color": int(comp["color"]),
                "area": int(comp["area"]),
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "coords": coords,
            }
        )

    total_area = sum(piece["area"] for piece in pieces)
    out_shape = _compact_shape(total_area)
    assert out_shape == (3, 4), "this task packs twelve cells into a 3x4 rectangle"

    order = sorted(
        range(len(pieces)),
        key=lambda idx: (
            -pieces[idx]["area"],
            pieces[idx]["bbox"][1],
            pieces[idx]["bbox"][0],
            pieces[idx]["bbox"][3],
            pieces[idx]["bbox"][2],
        ),
    )
    placement_options = [_placements(pieces[idx]["coords"], out_shape) for idx in order]

    occupied: set[tuple[int, int]] = set()
    chosen: list[tuple[int, tuple[tuple[int, int], ...]]] = []

    def search(k: int) -> bool:
        if k == len(order):
            return len(occupied) == total_area
        piece_idx = order[k]
        for cells in placement_options[k]:
            cell_set = set(cells)
            if occupied & cell_set:
                continue
            occupied.update(cell_set)
            chosen.append((piece_idx, cells))
            if search(k + 1):
                return True
            chosen.pop()
            occupied.difference_update(cell_set)
        return False

    assert search(0), "expected the fragments to tile the compact rectangle"
    assert len(chosen) == len(pieces)

    out = np.full(out_shape, int(bg), dtype=int)
    for piece_idx, cells in chosen:
        for r, c in cells:
            out[r, c] = pieces[piece_idx]["color"]

    assert np.all(out != bg), "the compact rectangle must be completely filled"
    return out

# --------------- generator (o5x) ---------------

# Packed output geometry.
_GEN_OUT_SHAPE = (3, 4)
_GEN_TOTAL_AREA = _GEN_OUT_SHAPE[0] * _GEN_OUT_SHAPE[1]
_GEN_CELLS = tuple((r, c) for r in range(_GEN_OUT_SHAPE[0]) for c in range(_GEN_OUT_SHAPE[1]))
_GEN_NEIGHBOR_STEPS = ((1, 0), (-1, 0), (0, 1), (0, -1))

# Fragment count and area constraints.
_GEN_MIN_PIECES, _GEN_MAX_PIECES = 3, 5
_GEN_MIN_PIECE_AREA, _GEN_MAX_PIECE_AREA = 1, 7
_GEN_MIN_LARGEST_AREA = 5
_GEN_SMALL_AREA_MAX = 2
_GEN_MIN_SMALL_BY_PIECE_COUNT = {4: 2, 5: 4}

# Palette and input canvas constraints.
_GEN_COLOR_COUNT = 3
_GEN_MIN_COLOR, _GEN_MAX_COLOR = 1, 9
_GEN_REPEAT_PAIR_SIZE = 2
_GEN_BG = 0
_GEN_INPUT_HEIGHT = 10
_GEN_MIN_INPUT_WIDTH, _GEN_MAX_INPUT_WIDTH = 10, 13
_GEN_BORDER_PADDING, _GEN_FRAGMENT_PADDING = 1, 1
_GEN_PADDING_CONNECTIVITY = 4

# Rejection sampling bound.
_GEN_MAX_ATTEMPTS = 300


def _gen_neighbors(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = cell
    out = []
    for dr, dc in _GEN_NEIGHBOR_STEPS:
        nb = (r + dr, c + dc)
        if nb in _GEN_CELLS:
            out.append(nb)
    return out


def _gen_is_connected(cells) -> bool:
    cells = set(cells)
    if not cells:
        return False
    seen = {next(iter(cells))}
    stack = list(seen)
    while stack:
        cell = stack.pop()
        for nb in _gen_neighbors(cell):
            if nb in cells and nb not in seen:
                seen.add(nb)
                stack.append(nb)
    return len(seen) == len(cells)


def _gen_components(cells) -> list[set[tuple[int, int]]]:
    remaining = set(cells)
    comps = []
    while remaining:
        start = remaining.pop()
        comp = {start}
        stack = [start]
        while stack:
            cell = stack.pop()
            for nb in _gen_neighbors(cell):
                if nb in remaining:
                    remaining.remove(nb)
                    comp.add(nb)
                    stack.append(nb)
        comps.append(comp)
    return comps


def _gen_component_sizes_fit(cells, sizes: tuple[int, ...]) -> bool:
    caps = tuple(sorted((len(comp) for comp in _gen_components(cells)), reverse=True))
    sizes = tuple(sorted(sizes, reverse=True))

import numpy as np
import random
from arc_utils import Color, colors_present, draw_line, find_components


# concepts:
# line detection, color extraction

# description:
# In the input you will see a grid consisting of stripes that are either horizontal or vertical.
# To make the output, make a grid with one pixel for each stripe whose color is the same color as that stripe.
# If the stripes are vertical, the output should be vertical, and if the stripes are horizontal, the output should be horizontal. The colors should be in the order they appear in the input.

def main(input_grid):
    """
    Compress uniform horizontal or vertical color stripes into a one-pixel-wide color sequence.

    Input structure:
    - The input is made of full-width horizontal stripes or full-height vertical stripes.
    - Stripes may have thickness greater than one cell.
    - Stripe colors appear in order across rows or columns.

    Rule:
    - Detect whether rows or columns are constant.
    - Collapse consecutive duplicate row or column colors into one entry per stripe.
    - Return a column for horizontal stripes or a row for vertical stripes.

    Key insight:
    - Stripe thickness is redundant; only orientation and ordered colors remain.
    """
    H, W = input_grid.shape

    rows_constant = all(np.all(input_grid[r, :] == input_grid[r, 0]) for r in range(H))
    cols_constant = all(np.all(input_grid[:, c] == input_grid[0, c]) for c in range(W))
    if rows_constant and not cols_constant:
        # Horizontal stripes -> output is a vertical list of row colors (top->bottom).
        raw = [int(input_grid[r, 0]) for r in range(H)]
        colors: list[int] = []
        for c in raw:
            if not colors or c != colors[-1]:
                colors.append(c)
        out = np.full((len(colors), 1), Color.BLACK, dtype=int)
        out[:, 0] = colors
        return out
    if cols_constant and not rows_constant:
        # Vertical stripes -> output is a horizontal list of column colors (left->right).
        raw = [int(input_grid[0, c]) for c in range(W)]
        colors: list[int] = []
        for c in raw:
            if not colors or c != colors[-1]:
                colors.append(c)
        out = np.full((1, len(colors)), Color.BLACK, dtype=int)
        out[0, :] = colors
        return out
    # Fallback: pick whichever holds.
    if rows_constant:
        raw = [int(input_grid[r, 0]) for r in range(H)]
        colors: list[int] = []
        for c in raw:
            if not colors or c != colors[-1]:
                colors.append(c)
        out = np.full((len(colors), 1), Color.BLACK, dtype=int)
        out[:, 0] = colors
        return out
    if cols_constant:
        raw = [int(input_grid[0, c]) for c in range(W)]
        colors: list[int] = []
        for c in raw:
            if not colors or c != colors[-1]:
                colors.append(c)
        out = np.full((1, len(colors)), Color.BLACK, dtype=int)
        out[0, :] = colors
        return out
    raise ValueError("The stripes are not aligned in a single axis")
    


def generate_input():
    orientation = random.choice(["horizontal", "vertical"])
    n_stripes = np.random.randint(2, 8)
    stripe_thicknesses = [int(np.random.randint(1, 3)) for _ in range(n_stripes)]
    stripe_colors = [int(c) for c in np.random.choice(list(Color.NOT_BLACK), n_stripes, replace=False)]

    if orientation == "horizontal":
        H = sum(stripe_thicknesses)
        W = int(np.random.randint(3, 12))
        grid = np.full((H, W), Color.BLACK, dtype=int)
        r0 = 0
        for t, col in zip(stripe_thicknesses, stripe_colors):
            grid[r0 : r0 + t, :] = col
            r0 += t
        return grid

    # vertical
    H = int(np.random.randint(3, 12))
    W = sum(stripe_thicknesses)
    grid = np.full((H, W), Color.BLACK, dtype=int)
    c0 = 0
    for t, col in zip(stripe_thicknesses, stripe_colors):
        grid[:, c0 : c0 + t] = col
        c0 += t
    return grid
