+def _gen_turn_count(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    prev_axis = None
+    for a, b in zip(path, path[1:]):
+        axis = _gen_axis(a, b)
+        if prev_axis is not None and axis != prev_axis:
