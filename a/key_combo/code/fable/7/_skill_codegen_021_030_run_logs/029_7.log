+        r1 = max(ar0, br0) - 1
+        if r0 <= r1 and not np.all(grid[r0 : r1 + 1, ac0 : ac1 + 1] == bg):
+            return None
+        return "v", abs(int(br0) - int(ar0))
+
+    return None
