+def _gen_visible_axis(a: tuple[int, int], b: tuple[int, int], positions: list[tuple[int, int]]) -> str | None:
+    axis = _gen_axis(a, b)
+    if axis is None:
+        return None
+    if not _gen_corridor_clear(a, b, positions):
+        return None
+    return axis
