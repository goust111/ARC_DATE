+def _gen_corridor_clear(a: tuple[int, int], b: tuple[int, int], positions: list[tuple[int, int]]) -> bool:
+    rect, axis = _gen_corridor(a, b)
+    if axis is None or rect is None:
+        return False
+    for pos in positions:
