+    if ar0 == br0 and ar1 == br1:
+        c0 = min(ac1, bc1) + 1
+        c1 = max(ac0, bc0) - 1
+        if c0 <= c1 and not np.all(grid[ar0 : ar1 + 1, c0 : c1 + 1] == bg):
+            return None
+        return "h", abs(int(bc0) - int(ac0))
