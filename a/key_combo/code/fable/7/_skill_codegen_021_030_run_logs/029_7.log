+START_COLOR = Color.RED
+BLOCK_SIZE = 2
+TARGET_COLORS = [
+    Color.BLUE,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.GREY,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
