+def _gen_far_from_all(pos: tuple[int, int], positions: list[tuple[int, int]]) -> bool:
+    return all(_gen_blocks_have_gap(pos, other) for other in positions)
+
+
+def _gen_axis(a: tuple[int, int], b: tuple[int, int]) -> str | None:
+    if a[0] == b[0]:
+        return "h"
+    if a[1] == b[1]:
+        return "v"
+    return None
