+
+    if not np.array_equal(actual, expected):
+        return None
+    if not _gen_walk_is_forced(path, distractors):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
