+def _gen_distance(a: tuple[int, int], b: tuple[int, int]) -> int | None:
+    axis = _gen_axis(a, b)
+    if axis == "h":
+        return abs(int(a[1]) - int(b[1]))
+    if axis == "v":
+        return abs(int(a[0]) - int(b[0]))
+    return None
+
