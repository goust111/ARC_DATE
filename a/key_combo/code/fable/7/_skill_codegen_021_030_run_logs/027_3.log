+def _render_case(meta: dict) -> np.ndarray:
+    rows = int(meta["rows"])
+    cols = int(meta["cols"])
+    side = str(meta["side"])
+    row_gap = int(meta["row_gap"])
+    col_gap = int(meta["col_gap"])
+
+    if side == "top":
+        top_margin, bottom_margin = 2, 1
+        left_margin, right_margin = 1, 1
+        marker_r = 0
+        marker_c = None
+        start_r, start_c = 2, 1
+    elif side == "bottom":
+        top_margin, bottom_margin = 1, 2
+        left_margin, right_margin = 1, 1
+        marker_r = None
+        marker_c = None
+        start_r, start_c = 1, 1
+    elif side == "left":
+        top_margin, bottom_margin = 1, 1
+        left_margin, right_margin = 2, 1
+        marker_r = None
+        marker_c = 0
+        start_r, start_c = 1, 2
+    elif side == "right":
+        top_margin, bottom_margin = 1, 1
+        left_margin, right_margin = 1, 2
+        marker_r = None
+        marker_c = None
+        start_r, start_c = 1, 1
+    else:
+        raise ValueError(side)
+
+    height = top_margin + rows * BLOCK + (rows - 1) * row_gap + bottom_margin
+    width = left_margin + cols * BLOCK + (cols - 1) * col_gap + right_margin
+    grid = np.full((height, width), BG, dtype=int)
+
+    if side == "top":
+        grid[0, :] = MARKER
+    elif side == "bottom":
+        grid[-1, :] = MARKER
+    elif side == "left":
+        grid[:, 0] = MARKER
+    elif side == "right":
