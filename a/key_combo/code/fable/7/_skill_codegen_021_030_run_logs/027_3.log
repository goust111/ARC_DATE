+            "#...#",
+            "#...#",
+            "#...#",
+            "#####",
+        ]
+    ),
+    1: _mask_from_rows(
+        [
+            "#####",
+            "#...#",
+            "##..#",
+            "#...#",
+            "#####",
+        ]
+    ),
+    2: _mask_from_rows(
+        [
+            "#####",
+            "#.#.#",
+            "##..#",
+            "#...#",
+            "#####",
+        ]
+    ),
+    3: _mask_from_rows(
+        [
+            "#####",
+            "#.#.#",
+            "#...#",
+            "#.#.#",
+            "#####",
