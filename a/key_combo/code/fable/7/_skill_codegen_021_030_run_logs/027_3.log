+def _build_symbol_records(total: int) -> list[dict]:
+    remaining_ids = set(BASE_MASKS)
+    mandatory_id = int(RNG.choice(ASYMMETRIC_BASE_IDS))
+    remaining_ids.remove(mandatory_id)
