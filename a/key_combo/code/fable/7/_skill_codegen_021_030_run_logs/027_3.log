+        meta = {
+            "bg": BG,
+            "rows": rows,
+            "cols": cols,
+            "side": side,
+            "direction": direction,
+            "row_gap": int(RNG.integers(1, 3)),
+            "col_gap": int(RNG.integers(1, 3)),
+            "items": items,
+            "symbolic": symbolic,
+            "shape_ids": shape_ids,
+            "exact_ids": exact_ids,
