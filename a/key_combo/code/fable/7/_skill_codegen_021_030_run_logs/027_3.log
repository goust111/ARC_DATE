+        left_margin, right_margin = 1, 1
+        marker_r = 0
+        marker_c = None
+        start_r, start_c = 2, 1
+    elif side == "bottom":
+        top_margin, bottom_margin = 1, 2
+        left_margin, right_margin = 1, 1
+        marker_r = None
+        marker_c = None
