+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _trim_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    trimmed = _trim_mask(mask)
+    return tuple(tuple(int(v) for v in row) for row in trimmed.astype(int))
+
+
+def _canonical_shape_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    variants = []
+    for rot in range(4):
+        turned = np.rot90(mask, rot)
+        variants.append(_mask_key(turned))
+        variants.append(_mask_key(np.fliplr(turned)))
+    return min(variants)
+
+
+def _transform_mask(mask: np.ndarray, code: int) -> np.ndarray:
+    rot = int(code) % 4
+    flipped = int(code) >= 4
+    out = np.rot90(mask, rot)
+    if flipped:
+        out = np.fliplr(out)
+    return out
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    coords_list: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords_list.append(np.array(comp, dtype=int))
+    return coords_list
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    bg = ~mask
+    seen = np.zeros_like(bg, dtype=bool)
+    h, w = bg.shape
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_edge = False
+            while stack:
+                rr, cc = stack.pop()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if not touches_edge:
+                return True
+    return False
