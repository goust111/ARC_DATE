+
+def _render_case(meta: dict) -> np.ndarray:
+    rows = int(meta["rows"])
+    cols = int(meta["cols"])
+    side = str(meta["side"])
+    row_gap = int(meta["row_gap"])
+    col_gap = int(meta["col_gap"])
+
+    if side == "top":
+        top_margin, bottom_margin = 2, 1
+        left_margin, right_margin = 1, 1
