+            out[r, : len(vals)] = vals
+    elif direction == "right":
+        for r in range(h):
+            vals = [int(v) for v in symbolic[r] if int(v) != bg]
+            out[r, w - len(vals) :] = vals
+    elif direction == "up":
+        for c in range(w):
+            vals = [int(v) for v in symbolic[:, c] if int(v) != bg]
+            out[: len(vals), c] = vals
+    elif direction == "down":
+        for c in range(w):
+            vals = [int(v) for v in symbolic[:, c] if int(v) != bg]
