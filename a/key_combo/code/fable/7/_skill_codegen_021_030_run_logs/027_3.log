+        left_margin, right_margin = 1, 1
+        marker_r = None
+        marker_c = None
+        start_r, start_c = 1, 1
+    elif side == "left":
+        top_margin, bottom_margin = 1, 1
+        left_margin, right_margin = 2, 1
+        marker_r = None
+        marker_c = 0
+        start_r, start_c = 1, 2
+    elif side == "right":
+        top_margin, bottom_margin = 1, 1
+        left_margin, right_margin = 1, 2
+        marker_r = None
+        marker_c = None
+        start_r, start_c = 1, 1
+    else:
+        raise ValueError(side)
