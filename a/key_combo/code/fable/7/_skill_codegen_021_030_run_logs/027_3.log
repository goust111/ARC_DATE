+            )
+
+    for mask_id in unique_ids:
+        code = int(RNG.integers(0, 8))
+        transformed = _transform_mask(BASE_MASKS[mask_id], code)
+        records.append(
+            {
+                "shape_id": mask_id,
+                "exact_id": hash(_mask_key(transformed)),
+                "mask": transformed,
+            }
+        )
