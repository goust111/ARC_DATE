+        return meta
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        meta = _make_meta()
+        if meta is None:
+            continue
+        grid = _render_case(meta)
+        out = main(grid)
+        if np.array_equal(out, meta["expected"]):
