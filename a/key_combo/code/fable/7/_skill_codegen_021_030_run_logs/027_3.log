+            vals = [int(v) for v in symbolic[:, c] if int(v) != bg]
+            out[: len(vals), c] = vals
+    elif direction == "down":
+        for c in range(w):
+            vals = [int(v) for v in symbolic[:, c] if int(v) != bg]
+            out[h - len(vals) :, c] = vals
