+
+def _canonical_shape_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    variants = []
+    for rot in range(4):
+        turned = np.rot90(mask, rot)
+        variants.append(_mask_key(turned))
+        variants.append(_mask_key(np.fliplr(turned)))
