+
+def _make_meta() -> dict | None:
+    rows = int(RNG.integers(3, 5))
+    cols = int(RNG.integers(3, 5))
+    capacity = rows * cols
+    total = int(RNG.integers(max(rows, cols) + 1, min(8, capacity - 1) + 1))
