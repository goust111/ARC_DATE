+            if not bg[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_edge = False
+            while stack:
+                rr, cc = stack.pop()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
