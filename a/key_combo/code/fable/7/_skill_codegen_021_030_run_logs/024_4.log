+    types = [feature["type"] for feature in info["features"]]
+    shifted = [types[-1]] + types[:-1]
+    return _render_grid(
+        info["grid"].shape,
+        info["bg"],
+        info["fg"],
+        info["rect"],
+        info["features"],
+        shifted,
+    )
+
