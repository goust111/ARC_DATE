    h, w = GRID_SHAPE

    r0 = int(np.random.randint(BLOCK_MARGIN, h - BLOCK_MARGIN - BLOCK_SIZE + 1))
    c0 = int(np.random.randint(BLOCK_MARGIN, w - BLOCK_MARGIN - BLOCK_SIZE + 1))
    row_stop = r0 + BLOCK_SIZE
