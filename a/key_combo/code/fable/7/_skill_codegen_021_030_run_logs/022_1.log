+    "id": lambda a: a.copy(),
+    "lr": _flip_lr,
+    "ud": _flip_ud,
+    "main": _transpose_main,
+    "anti": _transpose_anti,
+    "rot180": _rot180,
+    "rot90": lambda a: np.rot90(a, -1).copy(),
+    "rot270": lambda a: np.rot90(a, 1).copy(),
+}
