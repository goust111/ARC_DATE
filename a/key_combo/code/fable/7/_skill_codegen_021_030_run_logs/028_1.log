+MASK_LIBRARY = {
+    (-1, 0): (
+        ((0, 2), (1, 1), (1, 2), (1, 3)),
+        ((0, 1), (0, 2), (0, 3)),
+        ((0, 2), (1, 2)),
+    ),
+    (1, 0): (
+        ((4, 2), (3, 1), (3, 2), (3, 3)),
+        ((4, 1), (4, 2), (4, 3)),
+        ((4, 2), (3, 2)),
