+    (1, -1): (
+        ((4, 0), (4, 1), (3, 0)),
+        ((4, 0), (3, 0), (3, 1)),
+        ((4, 1), (3, 0)),
+    ),
+    (1, 1): (
+        ((4, 4), (4, 3), (3, 4)),
+        ((4, 4), (3, 4), (3, 3)),
+        ((4, 3), (3, 4)),
