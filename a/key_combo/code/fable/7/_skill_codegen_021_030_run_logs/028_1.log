+BLUE = 1
+RED = 2
+FILL_COLORS = (3, 4, 5, 6, 7, 8, 9)
+TILE_SIZE = 5
+STRIDE = TILE_SIZE + 1
+CENTER = 2.0
+MAX_ATTEMPTS = 400
