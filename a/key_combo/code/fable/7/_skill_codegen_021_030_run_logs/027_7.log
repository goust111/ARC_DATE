+    inp = np.concatenate(
+        [
+            left_panel,
+            np.full((left_h, 1), _SEPARATOR_COLOR, dtype=int),
+            right_panel,
+        ],
+        axis=1,
+    )
+    return {
+        "input": inp,
+        "expected": expected,
+        "hole_specs": hole_specs,
+        "piece_specs": piece_specs,
+    }
+
