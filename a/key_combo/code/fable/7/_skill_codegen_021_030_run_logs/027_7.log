+    subset = {cell_list[int(rng.integers(len(cell_list)))]}
+    while len(subset) < target_size:
+        frontier = []
+        for cell in subset:
+            for nbr in _neighbors4(cell):
+                if nbr in all_cells and nbr not in subset and nbr not in frontier:
+                    frontier.append(nbr)
