+_SEPARATOR_COLOR = Color.GREY
+_PIECE_COLORS = [Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+_GEN_ATTEMPTS = 400
+_HOLE_TEMPLATES = [(7, 2, 5), (9, 3, 6)]
+_DISTRACTOR_AREA = 10
