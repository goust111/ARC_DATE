+        if h < 2 or w < 2 or h > 5 or w > 5:
+            continue
+        if area == h * w and rng.random() < 0.75:
+            continue
+        return mask
+    return None
+
+
+def _partition_mask(mask: np.ndarray, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    cells = {tuple(cell) for cell in np.argwhere(mask)}
+    area = len(cells)
+    for _ in range(300):
+        target = int(rng.integers(2, area - 1))
+        if target > area - 2:
