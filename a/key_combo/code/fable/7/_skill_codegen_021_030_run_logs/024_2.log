+        coords = comp["coords"].astype(int, copy=False)
+        inside_frame_bbox = (
+            (coords[:, 0] >= r0)
+            & (coords[:, 0] <= r1)
+            & (coords[:, 1] >= c0)
+            & (coords[:, 1] <= c1)
+        )
+        assert not np.any(inside_frame_bbox), "outer regions must stay outside the frame"
+        regions.append(comp)
