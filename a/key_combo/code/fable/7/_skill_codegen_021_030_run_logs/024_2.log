+    fr0 = OUTER_MARGIN + top_band + FRAME_GAP
+    fc0 = OUTER_MARGIN + left_band + FRAME_GAP
+    fr1 = fr0 + frame_h - 1
+    fc1 = fc0 + frame_w - 1
+    frame_bbox = (fr0, fc0, fr1, fc1)
