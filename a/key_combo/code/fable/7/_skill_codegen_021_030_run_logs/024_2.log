+    regions: list[dict] = []
+    for comp in find_components(
+        g,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    ):
+        color = int(comp["color"])
+        if color in {FRAME_COLOR, DOT_COLOR}:
