+    bottom = (r1 + FRAME_GAP + 1, h - OUTER_MARGIN - 1)
+    left = (OUTER_MARGIN, c0 - FRAME_GAP - 1)
+    right = (c1 + FRAME_GAP + 1, w - OUTER_MARGIN - 1)
