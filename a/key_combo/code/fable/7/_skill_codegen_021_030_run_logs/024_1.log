+def _make_component_mask(shape: tuple[int, int], component: dict) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    coords = component["coords"].astype(int, copy=False)
+    mask[coords[:, 0], coords[:, 1]] = True
+    return mask
