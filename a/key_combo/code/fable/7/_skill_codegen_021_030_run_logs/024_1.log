+            continue
+
+        shifted = frag_coords + np.array([top, left], dtype=int)
+        if np.any(shifted[:, 0] < 0) or np.any(shifted[:, 0] >= grid_h):
+            continue
+        if np.any(shifted[:, 1] < 0) or np.any(shifted[:, 1] >= grid_w):
