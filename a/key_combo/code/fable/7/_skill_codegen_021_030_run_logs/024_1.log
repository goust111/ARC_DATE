+    used_rows: set[int] = set()
+    for start, size, signature in candidates:
+        rows = set(range(start - 1, start + size + 1))
+        if rows & used_rows:
+            continue
+        used_rows |= rows
+        picked.append((start, _build_fragment_from_left_profile(signature)))
+        if len(picked) == count:
