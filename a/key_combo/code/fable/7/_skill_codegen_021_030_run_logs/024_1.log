+def _scatter_fragment(
+    grid: np.ndarray,
+    fragment: np.ndarray,
+    color: int,
+    bg: int,
+    scatter_c0: int,
+) -> tuple[int, int]:
+    patch = np.full(fragment.shape, bg, dtype=int)
+    patch[fragment] = int(color)
+
+    sub = grid[:, scatter_c0:].copy()
+    r0, c0 = random_free_location(
+        sub,
+        patch,
+        transparent=bg,
+        padding=GEN_SCATTER_PADDING,
