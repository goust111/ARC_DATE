+def _choose_fit_windows(profile: list[int], count: int) -> list[tuple[int, np.ndarray]]:
+    candidates: list[tuple[int, int, tuple[int, ...]]] = []
+    for size in GEN_FIT_HEIGHTS:
+        if size > len(profile):
+            continue
