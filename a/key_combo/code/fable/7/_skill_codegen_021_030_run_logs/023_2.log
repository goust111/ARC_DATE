        if not frame["complete"]:
            continue
        mirrored = np.fliplr(frame["interior"])
        offsets = _match_offsets(mirrored, evidence, bg)
        if offsets:
            matches.append((frame, mirrored))

    assert len(matches) == 1, "expected exactly one intact matching frame"
    return matches[0][1]


