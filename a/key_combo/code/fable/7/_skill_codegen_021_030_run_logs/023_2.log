+    assert frames, "expected at least one frame on the left side"
+    return {
+        "grid": g,
+        "bg": bg,
+        "separator_col": sep_col,
+        "separator_color": sep_color,
+        "left": left,
+        "right": right,
+        "evidence": evidence,
+        "frames": frames,
+    }
