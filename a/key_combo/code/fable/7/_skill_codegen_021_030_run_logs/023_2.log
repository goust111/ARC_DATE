+        assert target_mirror is not None
+
+        other_complete = [m for m, obj in zip(complete_mirrors, [o for o in objects if o["complete"]]) if not np.array_equal(m, target_mirror) or True]
+        other_complete = []
+        for obj in objects:
+            if obj["complete"] and obj["kind"] != "target":
+                other_complete.append(np.fliplr(obj["interior"]))
+
+        fragment = _choose_fragment(rng, target_mirror, other_complete)
+        if fragment is None:
