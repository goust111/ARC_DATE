+        top = int(rng.integers(0, canvas_h - fragment.shape[0] + 1))
+        left = left_w + 1 + int(rng.integers(0, right_w - fragment.shape[1] + 1))
+        mask = fragment != BACKGROUND
+        block = grid[top : top + fragment.shape[0], left : left + fragment.shape[1]]
