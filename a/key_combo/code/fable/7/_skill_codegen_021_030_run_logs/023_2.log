+
+def _match_offsets(canvas: np.ndarray, fragment: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    ch, cw = canvas.shape
+    fh, fw = fragment.shape
+    if fh > ch or fw > cw:
+        return []
+    mask = fragment != bg
+    if not np.any(mask):
