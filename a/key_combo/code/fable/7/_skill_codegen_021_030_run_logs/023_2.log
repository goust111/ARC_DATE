+        min_take = min(max_take, 3)
+        if min_take == max_take:
+            return None
+        take = int(rng.integers(min_take, max_take))
+        chosen = coords[rng.choice(max_take, size=take, replace=False)]
+        probe = np.full_like(target_mirror, BACKGROUND)
+        for r, c in chosen:
