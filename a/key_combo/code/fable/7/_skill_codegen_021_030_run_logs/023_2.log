    raise RuntimeError("failed to sample a non-degenerate interior pattern")


def _remove_border_segment(rng: np.random.Generator, frame: np.ndarray, color: int) -> np.ndarray:
    out = frame.copy()
    h, w = out.shape
    side = int(rng.integers(4))
    if side == 0:
        c = int(rng.integers(1, w - 1))
        out[0, c] = BACKGROUND
