+                rr, cc = frontier[int(rng.integers(len(frontier)))]
+                dr, dc = DIRS4[int(rng.integers(4))]
+                nr = min(max(rr + dr, 0), h - 1)
+                nc = min(max(cc + dc, 0), w - 1)
+            else:
