                length = c1 - c0 + 1
                dist = (sep_col - 1) - c1  # 0 if bar touches left of separator
                bars.append((dist, r, c0, c1, length, col))
        else:
            for c0, c1, col in _iter_runs_1d(g[r, :], sep_col + 1, w, bg=bg):
                length = c1 - c0 + 1
                dist = c0 - (sep_col + 1)  # 0 if bar touches right of separator
                bars.append((dist, r, c0, c1, length, col))

