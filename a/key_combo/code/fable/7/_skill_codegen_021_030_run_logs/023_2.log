            out[min(r + 1, h - 2), 0] = BACKGROUND
    else:
        r = int(rng.integers(1, h - 1))
        out[r, w - 1] = BACKGROUND
        if h > 4 and rng.random() < 0.5:
            out[max(r - 1, 1), w - 1] = BACKGROUND
    return out


def _render_frame(obj: dict) -> np.ndarray:
    oh, ow = obj["outer_shape"]
