+        grid = np.full((canvas_h, left_w + 1 + right_w), BACKGROUND, dtype=int)
+        grid[:, left_w] = separator_color
+
+        for obj, (r0, c0) in zip(objects, placements):
+            tile = _render_frame(obj)
