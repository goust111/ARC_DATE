+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> list[tuple[int, int]]:
+    return DIR4 if connectivity == 4 else DIR8
