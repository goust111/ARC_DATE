        _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
        if _loc is None:
            raise ValueError("no placement")
        r, cc = _loc
        paste(grid, sprite, r, cc, transparent=Color.BLACK, clip=True)

    return grid
