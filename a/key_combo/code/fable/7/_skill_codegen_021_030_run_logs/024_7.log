+    (-1, -1): (-1, -1),
+    (-1, 1): (-1, 2),
+    (1, -1): (2, -1),
+    (1, 1): (2, 2),
+}
+SQUARE_FROM_ENDPOINT = {
+    (-1, -1): (1, 1),
+    (-1, 1): (1, -2),
+    (1, -1): (-2, 1),
+    (1, 1): (-2, -2),
+}
+BAR_DIRECTIONS = {
+    (-1, -1): [(-1, 0), (0, -1)],
+    (-1, 1): [(-1, 0), (0, 1)],
+    (1, -1): [(1, 0), (0, -1)],
+    (1, 1): [(1, 0), (0, 1)],
