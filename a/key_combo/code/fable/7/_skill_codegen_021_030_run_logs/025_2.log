44:def main(grid: np.ndarray) -> np.ndarray:
45:    """
46:    Recolor every non-overlapping green copy of the teal template motif to teal.
47:
48:    Input structure:
49:    - A noisy same-size grid contains one 8-connected teal motif.
50:    - Elsewhere, green pixels contain exact copies of that motif, possibly rotated or reflected, embedded among distractor pixels.
51:
52:    Rule:
53:    - Use the teal motif's bbox-normalized mask as the template.
54:    - Enumerate all unique rotations and reflections of that template.
55:    - Scan the grid in row-major order for placements whose template cells are all green.
56:    - Recolor selected placements to teal, skipping any later placement that overlaps an already selected one.
57:
58:    Key insight:
59:    The teal pixels are not noise; they are the shape key for identifying matching green masks hidden in the field.
60:    """
61:    g = np.asarray(grid, dtype=int)
62:
63:    template_components = components_mask(g == Color.TEAL, connectivity=8)
64:    assert len(template_components) == 1, "expected one 8-connected teal template"
65:    template_coords = template_components[0]
66:    assert len(template_coords) > 0, "teal template must be nonempty"
67:
68:    r0, c0, _r1, _c1 = bbox_coords(template_coords)
69:    template_shape = _normalize(template_coords - np.array([r0, c0]))
70:    variants = _dihedral_variants(template_shape)
71:    assert variants, "expected at least one template variant"
72:
73:    H, W = g.shape
74:    candidates: list[tuple[int, int, frozenset[tuple[int, int]]]] = []
75:    for variant in variants:
76:        h, w = _shape_size(variant)
77:        for r in range(H - h + 1):
78:            for c in range(W - w + 1):
79:                cells = frozenset((r + dr, c + dc) for dr, dc in variant)
80:                if all(g[rr, cc] == Color.GREEN for rr, cc in cells):
81:                    candidates.append((r, c, cells))
