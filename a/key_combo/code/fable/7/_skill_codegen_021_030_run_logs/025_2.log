20:def main(grid: np.ndarray) -> np.ndarray:
21:    """Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.
22:
23:    Input structure
24:    - The grid has a dominant background color.
25:    - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.
26:
27:    Rule
28:    - For each ring, move corner colors one step around the four corners.
29:    - Move side-center colors one step around the four side centers in the opposite direction.
30:    - Leave the background center and all other background pixels unchanged.
31:
32:    Key insight
33:    - Corners and side centers form two separate four-cycles on the same 3x3 ring.
34:    """
35:    g = np.asarray(grid, dtype=int)
36:    bg = get_bg(g)
37:    out = g.copy()
38:
39:    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
40:    assert components
41:
42:    for comp in components:
43:        bbox = comp["bbox"]
44:        r0, c0, r1, c1 = map(int, bbox)
45:        assert bbox_h(bbox) == 3
46:        assert bbox_w(bbox) == 3
47:        assert int(comp["area"]) == 8
48:        assert g[r0 + 1, c0 + 1] == bg
49:
50:        ring_coords = {
51:            (r0 + dr, c0 + dc)
52:            for dr in range(3)
53:            for dc in range(3)
54:            if (dr, dc) != (1, 1)
55:        }
56:        component_coords = {tuple(map(int, coord)) for coord in comp["coords"]}
57:        assert component_coords == ring_coords
58:        assert r1 == r0 + 2
59:        assert c1 == c0 + 2
60:
61:        _rotate_ring(out, g, r0, c0)
62:
63:    return out
