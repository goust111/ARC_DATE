109:    # Create a 2D background
110:    n, m = np.random.randint(15, 30), np.random.randint(15, 30)
111:    grid = np.zeros((m, n), dtype=int)
112:
113:    # Get a framework for pattern
114:    frame_length = np.random.randint(5, 10)
115:    frame_width = 2
116:    frame_color = Color.RED
117:
118:    # Draw a half of the framework
119:    frame_sprite = np.zeros((frame_length, frame_width), dtype=int)
120:    # horizontal bar and two vertical pixels
121:    frame_sprite[:, 0] = frame_color
122:    frame_sprite[0, 1] = frame_color
123:    frame_sprite[-1, 1] = frame_color
124:
125:    # Select the interval for two half frameworks that form one entire framework
126:    frame_interval = np.random.randint(4, 6)
127:    
128:    # Calculate the sizes of two things that we are going to mirror within framwork
129:    pattern_color = Color.GRAY
130:    pattern_length = frame_length - 2
131:    pattern_width = frame_interval // 2
132:    pattern_width_with_padding = frame_interval // 2 + 1
133:
134:    # Generate two patterns out the framwork
135:    pattern_1 = random_sprite(m=pattern_length, n=pattern_width, color_palette=[pattern_color])
136:    pattern_2 = random_sprite(m=pattern_length, n=pattern_width, color_palette=[pattern_color])
137:
138:    # place the pattern in the frame
139:    whole_frame = np.zeros((frame_length, frame_width * 2 + frame_interval + pattern_width_with_padding * 2), dtype=int)
140:    # Place the upper half of the frame
141:    whole_frame = paste(whole_frame, frame_sprite, 0, pattern_width_with_padding, transparent=Color.BLACK, clip=True)
142:    # Place the upper pattern
143:    whole_frame = paste(whole_frame, pattern_1, 1, 0, transparent=Color.BLACK, clip=True)
144:    # Place the lower pattern
145:    whole_frame = paste(whole_frame, pattern_2, 1, frame_width * 2 + frame_interval + pattern_width_with_padding + 1, transparent=Color.BLACK, clip=True)
146:    # Place the lower half of the frame
147:    whole_frame = paste(whole_frame, np.flipud(frame_sprite), 0, frame_width + frame_interval + pattern_width_with_padding, transparent=Color.BLACK, clip=True)
148:
149:    # place the frame in the background
150:    _loc = first_free_location(grid, whole_frame, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
151:    if _loc is None:
