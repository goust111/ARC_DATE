14:def main(input_grid):
15:    """
16:    Mirror gray objects across their nearest red frame so the reflected copies land inside the frames.
17:
18:    Input structure:
19:    - The input is a black grid with red frame objects and gray objects outside them.
20:    - All objects are aligned along one row or one column.
21:    - Each gray object belongs to the closest red frame.
22:
23:    Rule:
24:    - Detect the red frames and gray objects.
25:    - Infer whether the reflection axis is horizontal or vertical from object alignment.
26:    - Reflect each gray object across the center line of its closest frame and redraw the frame.
27:
28:    Key insight:
29:    - The red frames define local mirror axes; each gray object moves by reflection, not by free translation.
30:    """
31:    # Extract the framework
32:    frame_color = Color.RED
33:    object_color = Color.GRAY 
34:    background = Color.BLACK
35:
36:    # Create an empty grid
37:    n, m = input_grid.shape
38:    output_grid = np.zeros((n, m), dtype=int)
39:
40:    # parse the input
41:    objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=True, return_format="objects")
42:    frames = [ obj for obj in objects if frame_color in colors_present(obj, exclude={ background }) ]
43:    mirrored_objects = [ obj for obj in objects if object_color in colors_present(obj, exclude={ background }) ]
44:
45:    # determine if we are doing horizontal or vertical mirroring
46:    # if all the objects have the same X coordinate, we are doing vertical mirroring
47:    # if all the objects have the same Y coordinate, we are doing horizontal mirroring
48:    def _center(b: tuple[int, int, int, int]) -> tuple[float, float]:
49:        r0, c0, r1, c1 = map(int, b)
50:        return (r0 + r1) / 2.0, (c0 + c1) / 2.0
51:
52:    centers: list[tuple[float, float]] = []
53:    for obj in objects:
54:        _b = bbox(obj != background)
55:        assert _b is not None
56:        centers.append(_center(_b))
57:    r_positions = [rc[0] for rc in centers]
58:    c_positions = [rc[1] for rc in centers]
59:
60:    # Legacy note: the seed solver ran under a transpose wrapper, so the axis test swaps here.
61:    if all(c == c_positions[0] for c in c_positions):
62:        orientation = "vertical"
63:    elif all(r == r_positions[0] for r in r_positions):
64:        orientation = "horizontal"
65:    else: raise ValueError(f"The objects are not aligned in a single axis")
66:
67:    # Flip each other object over its closest frame
68:    for mirrored_object in mirrored_objects:
69:        # Find the closest frame
70:        def distance_between_objects(obj1, obj2):
71:            _b = bbox(obj1 != background)
72:            assert _b is not None
73:            r1, c1 = _center(_b)
74:            _b = bbox(obj2 != background)
75:            assert _b is not None
76:            r2, c2 = _center(_b)
77:            return (r1 - r2) ** 2 + (c1 - c2) ** 2        
78:        closest_frame = min(frames, key=lambda frame: distance_between_objects(frame, mirrored_object))
79:
80:        # Build a symmetry object for flipping over the closest frame
81:        _b = bbox(closest_frame != background)
82:        assert _b is not None
83:        frame_r, frame_c = _center(_b)
84:        _b = bbox(mirrored_object != background)
85:        assert _b is not None
86:        this_r, this_c = _center(_b)
87:        # Make it one pixel past the middle of frame
88:        frame_c += 0.5 if this_c > frame_c else -0.5
89:        frame_r += 0.5 if this_r > frame_r else -0.5
90:        # Conjugation note: legacy seeds ran under a transpose wrapper.
91:        # When objects are aligned vertically (same column), we mirror across a horizontal line (mirror_r).
92:        # When objects are aligned horizontally (same row), we mirror across a vertical line (mirror_c).
93:        symmetry = MirrorSymmetry(
94:            mirror_r=frame_r if orientation == "vertical" else None,
95:            mirror_c=frame_c if orientation == "horizontal" else None,
96:        )
97:        
98:        # Flip the object over the symmetry
99:        for r, c in np.argwhere(mirrored_object != background):
100:            r2, c2 = symmetry.apply(r, c)
101:            output_grid[r2, c2] = mirrored_object[r, c]
102:        
103:        # Draw the frame
104:        output_grid = paste(output_grid, closest_frame, 0, 0, transparent=Color.BLACK, clip=True)
105:
106:    return output_grid
