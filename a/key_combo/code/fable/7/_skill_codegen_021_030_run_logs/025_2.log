212:def _gen_candidate_bridge(g: np.ndarray, a: GEN_Rect, b: GEN_Rect) -> GEN_Bridge | None:
213:    ar0, ac0, ar1, ac1 = a
214:    br0, bc0, br1, bc1 = b
215:    candidates: list[GEN_Bridge] = []
216:
217:    shared_r0 = max(ar0, br0)
218:    shared_r1 = min(ar1, br1)
219:    shared_c0 = max(ac0, bc0)
220:    shared_c1 = min(ac1, bc1)
221:    if shared_r1 >= shared_r0 and shared_c1 >= shared_c0:
222:        return None
223:
224:    if shared_r1 - shared_r0 + 1 >= GEN_MIN_OVERLAP and (ac1 < bc0 or bc1 < ac0):
225:        gap_c0, gap_c1 = (ac1 + 1, bc0 - 1) if ac1 < bc0 else (bc1 + 1, ac0 - 1)
226:        if gap_c0 <= gap_c1 and np.all(g[shared_r0 : shared_r1 + 1, gap_c0 : gap_c1 + 1] == GEN_BG):
227:            candidates.append((gap_c1 - gap_c0 + 1, (shared_r0 + 1, gap_c0, shared_r1 - 1, gap_c1)))
