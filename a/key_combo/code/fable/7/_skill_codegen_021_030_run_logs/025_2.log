26:def main(grid: np.ndarray) -> np.ndarray:
27:    """
28:    Fill each enclosed square hole in the gray outlines with the color assigned to that hole size.
29:
30:    Input structure
31:    - The grid is a black canvas containing gray outline objects.
32:    - Each relevant interior is a 4-connected black component fully enclosed by gray pixels.
33:    - Enclosed interiors are solid squares of side length 1, 2, or 3.
34:
35:    Rule
36:    - Keep the gray outlines and the exterior black background unchanged.
37:    - Fill a 1x1 enclosed square with pink, a 2x2 enclosed square with orange, and a 3x3 enclosed square with teal.
38:
39:    Key insight
40:    - The fill color is determined by the size of the enclosed background region, not by the outline's position or full shape.
41:    """
42:    g = np.asarray(grid, dtype=int)
43:    assert g.ndim == 2, "expected a 2D grid"
44:
45:    bg = get_bg(g)
46:    assert bg == Color.BLACK, "expected black to be the empty color"
47:    assert colors_present(g, exclude={bg}) == [Color.GREY], "expected only gray foreground outlines"
48:
49:    side_to_color = {
50:        1: Color.PINK,
51:        2: Color.ORANGE,
52:        3: Color.TEAL,
53:    }
54:
55:    out = g.copy()
56:    filled_any = False
57:    for coords in components_mask(g == bg, connectivity=4):
58:        if _touches_border(coords, g.shape):
59:            continue
60:
61:        box = bbox_coords(coords)
62:        height = bbox_h(box)
63:        width = bbox_w(box)
64:        assert height == width, "enclosed region must be square"
65:        assert coords.shape[0] == height * width, "enclosed square must be solid"
66:        assert height in side_to_color, "unexpected enclosed square size"
67:
68:        out[coords[:, 0], coords[:, 1]] = side_to_color[height]
69:        filled_any = True
70:
71:    assert filled_any, "expected at least one enclosed square"
72:    return out
