126:def main(grid: np.ndarray) -> np.ndarray:
127:    """
128:    Paint teal bridges through the shortest empty gaps needed to connect each color's solid rectangles.
129:
130:    Input structure
131:    - The background is the dominant color and every foreground object is a solid axis-aligned rectangle.
132:    - Rectangles of the same color may face each other horizontally or vertically across empty background.
133:    - Teal is absent from the input and is reserved for the added bridge pixels.
134:
135:    Rule
136:    - Preserve the input and process each foreground color independently.
137:    - Candidate bridges join same-color rectangles whose row or column spans overlap by at least three cells and whose intervening gap is all background.
138:    - Paint the selected gap teal, using the shared span eroded by one pixel on both sides.
139:
140:    Key insight
141:    - The selected bridges are the shortest facing gaps that connect each same-color rectangle group; longer gaps that would only create a cycle are left blank.
142:    """
143:    g = np.asarray(grid, dtype=int)
144:    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
145:
146:    bg = get_bg(g)
147:    assert bg != BRIDGE_COLOR, "background cannot be the bridge color"
148:    out = g.copy()
149:
150:    for rectangles in _rectangles_by_color(g, bg).values():
151:        _paint_shortest_connectors(g, out, bg, rectangles)
152:
153:    return out
