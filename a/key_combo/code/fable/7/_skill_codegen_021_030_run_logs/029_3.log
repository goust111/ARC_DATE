+
+def _frame_border_mask(height: int, width: int) -> np.ndarray:
+    border = np.zeros((height, width), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return border
