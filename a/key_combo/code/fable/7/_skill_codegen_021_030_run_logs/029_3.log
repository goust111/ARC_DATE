+    (1, 5),
+    (5, 1),
+    (2, 4),
+    (4, 2),
+    (3, 3),
+    (1, 6),
+    (6, 1),
+    (2, 5),
+    (5, 2),
+    (3, 4),
+    (4, 3),
+    (2, 6),
+    (6, 2),
+    (3, 5),
+    (5, 3),
+    (4, 4),
+)
+
+
+def get_bg(grid: np.ndarray) -> int:
