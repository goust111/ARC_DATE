+from __future__ import annotations
+
+from collections import Counter
+import itertools
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+FRAME_PADDING = 1
+MIN_SCENE_SIDE = 10
+MAX_SCENE_H = 22
+MAX_SCENE_W = 28
