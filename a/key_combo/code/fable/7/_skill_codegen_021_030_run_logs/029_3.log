+
+    return {
+        "width_fail": width_fail,
+        "height_fail": height_fail,
+        "perimeter_fail": perimeter_fail,
+        "border_fail": border_fail,
+        "has_decoy": has_decoy,
+        "has_unit_interior": any(frame["inner_h"] == 1 and frame["inner_w"] == 1 for frame in frames),
