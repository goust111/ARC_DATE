+BLACK = 0
+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+FRAME_PADDING = 1
+MIN_SCENE_SIDE = 10
+MAX_SCENE_H = 22
+MAX_SCENE_W = 28
+INTERIOR_CANDIDATES = (
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (1, 4),
+    (4, 1),
+    (2, 3),
+    (3, 2),
+    (1, 5),
+    (5, 1),
+    (2, 4),
+    (4, 2),
+    (3, 3),
+    (1, 6),
+    (6, 1),
+    (2, 5),
+    (5, 2),
+    (3, 4),
+    (4, 3),
+    (2, 6),
+    (6, 2),
+    (3, 5),
+    (5, 3),
+    (4, 4),
