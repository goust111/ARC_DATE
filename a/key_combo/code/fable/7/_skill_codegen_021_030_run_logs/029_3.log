+                    "color": int(color),
+                    "length": int(length),
+                    "row": int(row),
+                    "start": int(rng.integers(start_low, start_high + 1)),
+                }
+            )
+        else:
+            scene = _render_scene(scene_h, scene_w, bg, frames, positions)
+            top = _render_top(scene_w, bars)
