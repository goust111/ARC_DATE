+    row_spans: list[Span],
+    col_spans: list[Span],
+    unique_color: int,
+    unique_cell: Coord,
+    corner: Coord,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    r0, r1 = sorted((unique_cell[0], corner[0]))
+    c0, c1 = sorted((unique_cell[1], corner[1]))
+    for rr in range(r0, r1 + 1):
+        rs0, rs1 = row_spans[rr]
+        for cc in range(c0, c1 + 1):
+            cs0, cs1 = col_spans[cc]
