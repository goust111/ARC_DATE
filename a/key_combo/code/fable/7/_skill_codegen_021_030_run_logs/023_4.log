+    for rr, height in enumerate(heights):
+        col_start = 0
+        for cc, width in enumerate(widths):
+            grid[row_start : row_start + height, col_start : col_start + width] = logical[rr, cc]
+            col_start += width
+            if cc < cols - 1:
+                col_start += sep_w
+        row_start += height
+        if rr < rows - 1:
+            row_start += sep_h
+    return grid
