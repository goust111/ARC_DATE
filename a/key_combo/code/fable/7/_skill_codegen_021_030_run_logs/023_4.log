+
+    rr0, rr1 = sorted((unique_cell[0], corner[0]))
+    cc0, cc1 = sorted((unique_cell[1], corner[1]))
+    if rr0 == rr1 and cc0 == cc1:
+        return None
+
+    changed_cells = 0
+    for rr, (r0, r1) in enumerate(row_spans):
+        for cc, (c0, c1) in enumerate(col_spans):
