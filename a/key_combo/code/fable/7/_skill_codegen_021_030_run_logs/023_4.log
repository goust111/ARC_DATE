+    center_c = col_offsets[c] + (widths[c] - 1) / 2.0
+    corners = [(0.0, 0.0), (0.0, w_total - 1.0), (h_total - 1.0, 0.0), (h_total - 1.0, w_total - 1.0)]
+    return [abs(center_r - rr) + abs(center_c - cc) for rr, cc in corners]
