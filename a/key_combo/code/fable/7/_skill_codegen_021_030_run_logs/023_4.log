+            output_block = output[r0 : r1 + 1, c0 : c1 + 1]
+            changed = not np.array_equal(grid[r0 : r1 + 1, c0 : c1 + 1], output[r0 : r1 + 1, c0 : c1 + 1])
+            in_rect = rr0 <= rr <= rr1 and cc0 <= cc <= cc1
+            if in_rect:
