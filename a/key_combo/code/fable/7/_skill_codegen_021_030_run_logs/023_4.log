+
+def _non_separator_spans(mask: np.ndarray) -> list[Span]:
+    spans: list[Span] = []
+    idx = 0
+    while idx < len(mask):
+        if mask[idx]:
+            idx += 1
+            continue
+        start = idx
+        while idx < len(mask) and not mask[idx]:
+            idx += 1
+        spans.append((start, idx - 1))
+    return spans
