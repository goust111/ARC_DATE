+        weighted.append(("interior", 0.6))
+    if grouped["edge"]:
+        weighted.append(("edge", 0.4))
+    if not weighted:
+        return None
+    labels, weights = zip(*weighted)
+    chosen_group = random.choices(labels, weights=weights, k=1)[0]
+    return random.choice(grouped[chosen_group])
