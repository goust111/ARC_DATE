+def _random_composition(total: int, parts: int, minimum: int) -> list[int] | None:
+    if total < parts * minimum:
+        return None
+    values = [minimum] * parts
+    for _ in range(total - parts * minimum):
+        values[random.randrange(parts)] += 1
+    random.shuffle(values)
