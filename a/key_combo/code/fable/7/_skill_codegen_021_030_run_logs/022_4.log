+    cells = [marker, *path]
+    assert len(cells) == len(set(cells)), "single spiral must not self-overlap"
+    return {
+        "marker": marker,
+        "direction": direction,
+        "path": path,
+        "cells": set(cells),
+    }
+
+
+def _find_valid_solutions(shape: tuple[int, int], objects: list[dict]) -> list[tuple[tuple[int, ...], list[dict]]]:
