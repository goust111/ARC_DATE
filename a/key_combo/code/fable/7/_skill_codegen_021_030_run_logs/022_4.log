+        [_build_candidate(shape, obj, 0), _build_candidate(shape, obj, 1)]
+        for obj in objects
+    ]
+    valid: list[tuple[tuple[int, ...], list[dict]]] = []
+
+    for choice_bits in itertools.product((0, 1), repeat=len(objects)):
+        occupied: set[Coord] = set()
+        placements: list[dict] = []
+        ok = True
