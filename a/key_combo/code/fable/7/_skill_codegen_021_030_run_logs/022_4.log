+                continue
+            if output_cells & set(bar):
+                continue
+            if _cells_touch(output_cells, output_occupied):
+                continue
+            if _cells_touch(input_cells, input_occupied):
+                continue
+            if _cells_touch(output_cells, input_occupied):
+                continue
+            if _cells_touch(input_cells, output_occupied):
+                continue
