+    return placed
+
+
+def _draw_input(shape: tuple[int, int], placed: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for obj in placed:
+        color = int(obj["color"])
+        for r, c in obj["input_cells"]:
+            grid[r, c] = color
+    return grid
+
+
+def _draw_output(shape: tuple[int, int], placed: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for obj in placed:
+        color = int(obj["color"])
+        mr, mc = obj["marker"]
