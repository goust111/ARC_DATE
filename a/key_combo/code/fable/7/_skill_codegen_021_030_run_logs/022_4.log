+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(g.shape, nr, nc) and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
