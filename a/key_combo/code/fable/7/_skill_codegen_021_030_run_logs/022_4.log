+UP: Direction = (-1, 0)
+RIGHT: Direction = (0, 1)
+DOWN: Direction = (1, 0)
+LEFT: Direction = (0, -1)
+DIRS: tuple[Direction, ...] = (UP, RIGHT, DOWN, LEFT)
+CW_TURN = {UP: RIGHT, RIGHT: DOWN, DOWN: LEFT, LEFT: UP}
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox(coords: list[Coord]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_color_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
