+    grid[-1, 1:-1] = bottom
+    grid[1:-1, 0] = left
+    grid[1:-1, -1] = right
+    for r, c in gray_cells:
+        grid[r, c] = GRAY
+
+    if np.array_equal(_solve_from_grid(grid), _naive_projection(grid)):
+        return None
+
+    return grid
