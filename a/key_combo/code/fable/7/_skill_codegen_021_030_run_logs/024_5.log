import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/024/5.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

GRAY = 5

def label(shape, cell):
    h, w = shape
    r, c = cell
    d = {
        'top': r,
        'bottom': h - 1 - r,
        'left': c,
        'right': w - 1 - c,
    }
    m = min(d.values())
    winners = [k for k, v in d.items() if v == m]
    return winners[0] if len(winners) == 1 else 'tie'


def reference(inp):
    g = np.asarray(inp, dtype=int)
    h, w = g.shape
    bg = int(g[0, 0])
    top = int(g[0, 1])
    bottom = int(g[-1, 1])
    left = int(g[1, 0])
    right = int(g[1, -1])
    out = g.copy()
    out[1:-1, 1:-1] = bg
    top_cols, bottom_cols, left_rows, right_rows = {}, {}, {}, {}
    for r, c in np.argwhere(g == GRAY):
        r = int(r)
        c = int(c)
        side = label(g.shape, (r, c))
        if side == 'tie':
            out[r, c] = GRAY
        elif side == 'top':
            top_cols.setdefault(c, []).append(r)
        elif side == 'bottom':
            bottom_cols.setdefault(c, []).append(r)
        elif side == 'left':
            left_rows.setdefault(r, []).append(c)
        else:
            right_rows.setdefault(r, []).append(c)
    for c, rows in top_cols.items():
        for i, _r in enumerate(sorted(rows), start=1):
            out[i, c] = top
    for c, rows in bottom_cols.items():
        for i, _r in enumerate(sorted(rows, reverse=True), start=1):
            out[h - 1 - i, c] = bottom
    for r, cols in left_rows.items():
        for i, _c in enumerate(sorted(cols), start=1):
            out[r, i] = left
    for r, cols in right_rows.items():
        for i, _c in enumerate(sorted(cols, reverse=True), start=1):
            out[r, w - 1 - i] = right
    return out


def component_count(mask):
    seen = set()
    count = 0
    for r, c in map(tuple, np.argwhere(mask)):
        if (r, c) in seen:
            continue
        count += 1
        q = deque([(r, c)])
        seen.add((r, c))
        while q:
            rr, cc = q.popleft()
            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
                    seen.add((nr, nc))
                    q.append((nr, nc))
    return count


def naive(inp):
    g = np.asarray(inp, dtype=int)
    h, w = g.shape
    bg = int(g[0, 0])
    top = int(g[0, 1])
    bottom = int(g[-1, 1])
    left = int(g[1, 0])
    right = int(g[1, -1])
    out = g.copy()
    out[1:-1, 1:-1] = bg
    for r, c in np.argwhere(g == GRAY):
        r = int(r)
        c = int(c)
        side = label(g.shape, (r, c))
        if side == 'tie':
            out[r, c] = GRAY
        elif side == 'top':
            out[1, c] = top
        elif side == 'bottom':
            out[h - 2, c] = bottom
        elif side == 'left':
            out[r, 1] = left
        else:
            out[r, w - 2] = right
    return out

sigs = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    ref = reference(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, ref), 'main disagrees with independent reference'

    bg = int(inp[0, 0])
    assert int(inp[0, -1]) == bg and int(inp[-1, 0]) == bg and int(inp[-1, -1]) == bg
    assert len({bg, GRAY, int(inp[0,1]), int(inp[-1,1]), int(inp[1,0]), int(inp[1,-1])}) == 6
    assert set(np.unique(inp[1:-1, 1:-1])).issubset({bg, GRAY})

    labels = {label(inp.shape, (int(r), int(c))) for r, c in np.argwhere(inp == GRAY)}
    assert labels == {'top', 'bottom', 'left', 'right', 'tie'}

    comps = []
    seen = set()
    coords = {tuple(map(int, x)) for x in np.argwhere(inp == GRAY)}
    for cell in list(coords):
        if cell in seen:
            continue
        q = deque([cell])
        seen.add(cell)
        comp = {cell}
        while q:
            rr, cc = q.popleft()
            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                if (nr, nc) in coords and (nr, nc) not in seen:
                    seen.add((nr, nc))
                    comp.add((nr, nc))
                    q.append((nr, nc))
        comps.append(comp)
    assert 3 <= len(comps) <= 7
    assert any('tie' in {label(inp.shape, x) for x in comp} and len({label(inp.shape, x) for x in comp}) >= 2 for comp in comps)
    assert not np.array_equal(out, naive(inp)), 'packing step is not exercised'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
print('variants', len(sigs))
assert len(sigs) >= 20
