+                return component
+    return None
+
+
+def _horizontal_strip(shape: tuple[int, int], occupied: set[tuple[int, int]], side: str) -> set[tuple[int, int]] | None:
+    h, w = shape
+    assert side in {"left", "right"}
+    rows = list(range(1, h - 1))
+    random.shuffle(rows)
+    for r in rows:
