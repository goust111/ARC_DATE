+        for nb in _neighbors4(cell):
+            if not _interior_bounds(shape, nb):
+                continue
+            if nb in blocked or nb in parent:
+                continue
+            parent[nb] = cell
+            queue.append(nb)
+    return None
+
+
+def _connect_anchors(
+    anchors: list[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]] | None:
