    mr0 = random.randint(r0 + MIN_MARKER_GAP, r1 - marker_h - MIN_MARKER_GAP + 1)
    mc0 = random.randint(c0 + MIN_MARKER_GAP, c1 - marker_w - MIN_MARKER_GAP + 1)
