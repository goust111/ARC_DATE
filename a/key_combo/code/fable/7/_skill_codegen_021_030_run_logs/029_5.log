_GEN_ACTIVE_MARKER_COUNTS = (2, 3)
_GEN_TOTAL_OBJECTS_RANGE = (6, 11)
_GEN_OBJECTS_PER_MARKER_RANGE = (1, 5)
_GEN_DISTRACTOR_COUNT_RANGE = (1, 3)
_GEN_DISTRACTOR_COLOR_RANGE = (1, 2)

