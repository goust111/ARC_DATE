+
+
+def _expected_output(
+    input_grid: np.ndarray,
+    rows: list[int],
+    cols: list[int],
+    color_a: int,
+    color_b: int,
+    a_on_parity: int,
+) -> np.ndarray:
+    out = np.asarray(input_grid, dtype=int).copy()
+    row_to_index = {r: i for i, r in enumerate(rows)}
+    col_to_index = {c: j for j, c in enumerate(cols)}
+    for r in rows:
