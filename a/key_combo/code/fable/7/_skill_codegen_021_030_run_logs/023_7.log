+            expected = color_a if parity == a_on_parity else color_b
+            if int(grid[r, c]) != expected:
+                ok = False
+                break
+        if ok:
+            valid_parities.append(a_on_parity)
+
+    if len(valid_parities) != 1:
+        return None
+
+    for r, c in coords:
