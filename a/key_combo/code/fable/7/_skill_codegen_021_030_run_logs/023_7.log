 120: def _gen_orbits(side: int) -> list[dict]:
 121:     """Return unique C4 orbits with ranking fields used by layout selection."""
 122:     seen = set()
 123:     orbits = []
 124:     center = (side - 1) / 2
 125:     for r in range(side):
 126:         for c in range(side):
 127:             cells = tuple(sorted(set(_rot90_orbit(side, r, c))))
 128:             if cells in seen:
 129:                 continue
 130:             seen.add(cells)
 131:             reps = [p for p in cells if p[0] <= p[1] and p[0] + p[1] <= side - 1]
 132:             rep = min(reps) if reps else min(cells)
 133:             maxd = max(max(abs(rr - center), abs(cc - center)) for rr, cc in cells)
 134:             dist = sum((rr - center) ** 2 + (cc - center) ** 2 for rr, cc in cells) / len(cells)
 135:             edge = sum(rr in (0, side - 1) or cc in (0, side - 1) for rr, cc in cells)
 136:             corner = sum(rr in (0, side - 1) and cc in (0, side - 1) for rr, cc in cells)
 137:             orbits.append({"cells": cells, "rep": rep, "size": len(cells), "maxd": maxd, "dist": dist, "edge": edge, "corner": corner})
 138:     return orbits
