+    return visible, area
+
+
+def _available_distractor_cells(
+    shape: tuple[int, int], rows: list[int], cols: list[int]
+) -> dict[str, list[tuple[int, int]]]:
+    height, width = shape
+    active_rows = set(rows)
+    active_cols = set(cols)
+    cells = {"row": [], "col": [], "neither": []}
