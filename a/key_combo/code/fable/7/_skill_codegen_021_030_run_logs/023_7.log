+
+
+def _build_visible_subset(
+    rng: np.random.Generator, row_count: int, col_count: int
+) -> tuple[set[tuple[int, int]], int] | None:
+    area = row_count * col_count
+    min_visible = max(row_count + col_count - 1, (area + 1) // 2, 6)
