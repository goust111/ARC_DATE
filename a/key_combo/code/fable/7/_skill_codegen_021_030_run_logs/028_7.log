+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        segments = _sample_segments(rng)
+        path_color = int(PATH_COLORS[int(rng.integers(0, len(PATH_COLORS)))])
+        grid = _render_input(segments, path_color, rng)
+        out = main(grid)
