  13: def main(input_grid):
  14:     """
  15:     Recolor each green object according to how many bends its shape contains.
  16: 
  17:     Input structure:
  18:     - The grid has several green connected objects on a black background.
  19:     - Each object is a small bent shape with one, two, or three corner bends.
  20:     - The generated inputs include at least one object for each bend count.
  21: 
  22:     Rule:
  23:     - Detect each green object and crop its bounding box.
  24:     - Count L-shaped 2x2 bend patterns across all rotations.
  25:     - Recolor objects with one, two, and three bends to blue, pink, and red respectively.
  26: 
  27:     Key insight:
  28:     - Object color is determined by topology of the mask, not by position or size.
  29:     """
  30:     # Create a copy of the input grid to avoid modifying the original
  31:     output_grid = np.copy(input_grid)
  32: 
  33:     # Find all the green objects in the grid
  34:     object_color = Color.GREEN
  35:     background = Color.BLACK
  36:     objects = find_components(input_grid, bg=background, monochromatic=True, connectivity=4, return_format="objects")
  37:     for obj in objects:
  38:         # Get the bounding box of the sprite and crop the sprite
  39:         b = bbox(obj != background)
  40:         assert b is not None
  41:         r0, c0, r1, c1 = b
  42:         sprite = crop_bbox(obj, b)
  43:         mask = sprite != background
  44: 
  45:         # Determine how many bends the mask has
  46:         # Do this by building an L-shaped mask, and seeing how many times it appears in the sprite
  47:         bend_mask = np.array([[1, 1], [1, 0]])
  48:         rotated_bend_masks = [bend_mask, np.rot90(bend_mask), np.rot90(bend_mask, 2), np.rot90(bend_mask, 3)]
  49: 
  50:         from scipy.ndimage import correlate
  51:         
  52:         n_bends = sum( np.sum( correlate(mask*1, filter*1, mode='constant', cval=0) == np.sum(filter*1) ) for filter in rotated_bend_masks )
  53: 
  54:         # find the new color based on bends
  55:         new_color = {1: Color.BLUE, 2: Color.PINK, 3: Color.RED}[int(n_bends)]
  56:         # color the sprite with the new color
  57:         sprite[sprite == object_color] = new_color
  58:         output_grid = paste(output_grid, sprite, r0, c0, transparent=background)
