+def _render_input(segments: list[tuple[str, int]], path_color: int, rng: np.random.Generator) -> np.ndarray:
+    cells = _cells_from_segments(segments)
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
