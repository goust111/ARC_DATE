+    for r, c in cells[1:]:
+        grid[r + shift_r, c + shift_c] = int(path_color)
+    sr, sc = cells[0]
+    grid[sr + shift_r, sc + shift_c] = START_COLOR
+    return grid
+
+
+def main(input_grid: np.ndarray) -> np.ndarray:
+    """
+    Decompile the marked polyline into a vertical stack of 3x3 glyph instructions.
+
+    Input structure:
