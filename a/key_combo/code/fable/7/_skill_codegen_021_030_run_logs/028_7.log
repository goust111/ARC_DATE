+    prev = None
+    cur = start
+    while True:
+        nxt = [
+            (nr, nc)
+            for nr, nc in neighbors4(*cur)
+            if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and (nr, nc) != prev
+        ]
