+            continue
+        if out.shape[1] != GLYPH_SIZE:
+            continue
+        if out.shape[0] != len(segments) * (GLYPH_SIZE + GLYPH_GAP) - GLYPH_GAP:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid trajectory-decompilation input")

