+        for (r0, c0), patch in zip(positions, damaged_slots):
+            h, w = patch.shape
+            inp[r0 : r0 + h, c0 : c0 + w] = patch
+
+        occupied = np.zeros_like(inp, dtype=bool)
+        for r0, c0 in positions:
