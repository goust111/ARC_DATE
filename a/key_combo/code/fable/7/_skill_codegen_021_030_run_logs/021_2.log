+        positions = _slot_positions(layout)
+        damaged_slots = []
+        normalized_slots = []
+        changed_cells = []
+        any_perfect = False
+
+        for orientation in orientations:
+            clean = _apply_orientation(prototype, orientation)
+            damaged, changed = _damage_patch(rng, clean, orientation)
+            if np.array_equal(clean, damaged):
