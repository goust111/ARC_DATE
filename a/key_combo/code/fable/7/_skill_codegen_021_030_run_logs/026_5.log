_GEN_GRID_SIZE = 10
_GEN_LAST_INDEX = _GEN_GRID_SIZE - 1
_GEN_BACKGROUND = 0
_GEN_FOREGROUND = Color.RED
_GEN_BRIDGE = Color.MAROON

