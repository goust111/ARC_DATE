+def _validate_meta_scene(grid: np.ndarray, meta: list[dict]) -> None:
+    used_source = set()
+    used_reflected = set()
+    used_markers = set()
+    for item in meta:
+        hole = tuple(item["hole"])
+        assert int(grid[hole]) == BG
+        assert hole not in used_source and hole not in used_reflected
