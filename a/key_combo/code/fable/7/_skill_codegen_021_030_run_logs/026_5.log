_GEN_MAX_RECT_HEIGHT = 6
_GEN_MIN_RECT_WIDTH = 1
_GEN_MAX_RECT_WIDTH = 4
_GEN_MIN_RECT_AREA = 4
_GEN_MAX_RECT_AREA = 18
_GEN_MIN_TOTAL_AREA = 24
