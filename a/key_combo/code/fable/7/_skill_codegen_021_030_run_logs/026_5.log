+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": _bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
