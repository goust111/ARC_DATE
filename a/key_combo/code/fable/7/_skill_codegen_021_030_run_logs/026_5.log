+
+from collections import Counter
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+WALL = 9
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
