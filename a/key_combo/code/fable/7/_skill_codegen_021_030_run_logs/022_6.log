+
+    return Container(r0=r0, c0=c0, r1=r1, c1=c1, gap_side=gap_side, gap_row=gap_row)
+
+
+def _detect_containers(grid: np.ndarray) -> list[Container]:
+    g = np.asarray(grid, dtype=int)
