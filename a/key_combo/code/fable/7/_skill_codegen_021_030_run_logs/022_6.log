+
+
+def _try_place_distractor(
+    rng: random.Random,
+    height: int,
+    width: int,
+    forbidden_cols: list[int],
+    existing: list[Container],
+    allow_gap: bool,
+) -> Container | None:
+    for _ in range(120):
+        h = rng.randint(4, 7)
+        w = rng.randint(5, 9)
+        r0 = rng.randint(2, height - h)
+        c0 = rng.randint(0, width - w)
+        r1 = r0 + h - 1
+        c1 = c0 + w - 1
