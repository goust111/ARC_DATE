+    forbidden_cols = _path_drop_columns(path, faucet_col)
+    containers = list(path)
+
+    distractor_target = rng.randint(1, 3)
+    want_gapped = rng.random() < 0.7
+    gapped_added = False
+    for i in range(distractor_target):
