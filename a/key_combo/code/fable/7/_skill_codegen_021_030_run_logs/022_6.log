+        candidate = Container(r0=r0, c0=c0, r1=r1, c1=c1, gap_side=gap_side, gap_row=gap_row)
+        box = (r0, c0, r1, c1)
+        if any(_box_overlaps(box, (other.r0, other.c0, other.r1, other.c1), pad=1) for other in existing):
