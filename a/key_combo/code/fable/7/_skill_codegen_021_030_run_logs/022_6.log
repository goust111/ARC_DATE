+def _box_overlaps(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return max(ar0 - pad, br0 - pad) <= min(ar1 + pad, br1 + pad) and max(ac0 - pad, bc0 - pad) <= min(ac1 + pad, bc1 + pad)
