+            if any(_box_overlaps((candidate.r0, candidate.c0, candidate.r1, candidate.c1), (old.r0, old.c0, old.r1, old.c1), pad=1) for old in containers):
+                continue
+            placed = candidate
+            break
+
+        if placed is None:
