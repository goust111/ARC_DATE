+
+
+def _initial_direction(grid: np.ndarray, bg: int, start: tuple[int, int], wall_to_frame: dict[tuple[int, int], dict]) -> tuple[int, int]:
+    hits = []
+    sr, sc = start
+    for dr, dc in DIRS:
+        r, c = sr + dr, sc + dc
