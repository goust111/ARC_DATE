SPRITE_PADDING = 1
# Pattern, density, and palette controls.
MIN_FILL_CELLS = 2
DISTINCT_MASK_RETRIES = 20
CLUTTER_DENSITY_MIN, CLUTTER_DENSITY_MAX = 0.09, 0.14
FOREGROUND_DENSITY_MIN, FOREGROUND_DENSITY_MAX = 0.35, 0.50
COLOR_COUNT = 10
