+        assert state not in seen_states, "path must terminate rather than loop"
+        seen_states.add(state)
+
+        nr = r + direction[0]
+        nc = c + direction[1]
+        if not in_bounds(g.shape, nr, nc):
+            return out
+
+        value = int(g[nr, nc])
+        if value == bg:
