    border[:, -1] = True
    return np.all(patch[border] == color) and not np.any(patch[~border] == color)

def wall_cells(bbox):
    r0, c0, r1, c1 = bbox
    cells = set()
    for c in range(c0, c1 + 1):
        cells.add((r0, c))
        cells.add((r1, c))
    for r in range(r0 + 1, r1):
        cells.add((r, c0))
        cells.add((r, c1))
    return cells

def extract(grid):
    bg = get_bg(grid)
    starts = np.argwhere(grid == GREEN)
    assert len(starts) == 1
    start = tuple(map(int, starts[0]))
    frames = []
    markers = []
    for color in sorted(set(map(int, grid.ravel())) - {bg}):
        for coords in components(grid == color):
            if color == GREEN:
                assert len(coords) == 1 and tuple(map(int, coords[0])) == start
                continue
            if len(coords) == 1:
                markers.append((int(coords[0,0]), int(coords[0,1]), color))
            else:
                assert is_frame(grid, color, coords)
                bbox = bbox_coords(coords)
                frames.append({'"'bbox': bbox, 'marker': None, 'walls': wall_cells(bbox)})
    assert len(frames) == len(markers) >= 1
    for r, c, color in markers:
        owner = None
        for frame in frames:
            r0, c0, r1, c1 = frame['bbox']
            if r0 < r < r1 and c0 < c < c1:
                assert owner is None
                owner = frame
        assert owner is not None and owner['marker'] is None
        owner['marker'] = (r, c, color)
    wall_to_frame = {}
    for frame in frames:
        assert frame['marker'] is not None
        for cell in frame['walls']:
            assert cell not in wall_to_frame
            wall_to_frame[cell] = frame
    return bg, start, frames, wall_to_frame

def initial_direction(grid, bg, start, wall_to_frame):
    dirs = []
    sr, sc = start
    for dr, dc in DIRS:
        r, c = sr + dr, sc + dc
        while in_bounds(grid.shape, r, c):
            if int(grid[r, c]) "'!= bg:
                if (r, c) in wall_to_frame:
                    dirs.append((dr, dc))
                break
            r += dr
            c += dc
    assert len(dirs) == 1
    return dirs[0]

def turn_left(d):
    dr, dc = d
    return (-dc, dr)

def turn_right(d):
    dr, dc = d
    return (dc, -dr)

def marker_is_left(frame, direction):
    r0, c0, r1, c1 = frame['"'bbox']
    mr, mc, _ = frame['marker']
    center_r = (r0 + r1) / 2.0
    center_c = (c0 + c1) / 2.0
    dr, dc = direction
    left_r, left_c = -dc, dr
    signed = (mr - center_r) * left_r + (mc - center_c) * left_c
    assert signed "'!= 0
    return signed > 0

def simulate(grid):
    bg, start, frames, wall_to_frame = extract(grid)
    out = grid.copy()
    direction = initial_direction(grid, bg, start, wall_to_frame)
    r, c = start
    seen = set()
    turns = []
    while True:
        state = (r, c, direction)
        assert state not in seen
        seen.add(state)
        nr, nc = r + direction[0], c + direction[1]
        if not in_bounds(grid.shape, nr, nc):
            return out, turns, frames, start
        if int(grid[nr, nc]) == bg:
            out[nr, nc] = GREEN
            r, c = nr, nc
            continue
        frame = wall_to_frame[(nr, nc)]
        left = marker_is_left(frame, direction)
        turns.append((frame, direction, left))
        direction = turn_left(direction) if left else turn_right(direction)

def opposite_marker(frame, direction):
    r0, c0, r1, c1 = frame['"'bbox']
    mr, mc, color = frame['marker']
    center_r = (r0 + r1) / 2.0
    center_c = (c0 + c1) / 2.0
    dr, dc = direction
    left_r, left_c = -dc, dr
    current = (mr - center_r) * left_r + (mc - center_c) * left_c
    candidates = []
    for r in range(r0 + 1, r1):
        for c in range(c0 + 1, c1):
            signed = (r - center_r) * left_r + (c - center_c) * left_c
            if signed == 0 or signed * current >= 0:
                continue
            candidates.append((r, c, color))
    assert candidates
    return candidates[0]

