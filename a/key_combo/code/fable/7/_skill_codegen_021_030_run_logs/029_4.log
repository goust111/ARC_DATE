+    center_c = (c0 + c1) / 2.0
+    dr, dc = direction
+    left_r, left_c = -dc, dr
+    signed = (mr - center_r) * left_r + (mc - center_c) * left_c
+    assert signed != 0, "marker may not lie on the heading centerline"
+    return signed > 0
