+
+def _extract_scene(grid: np.ndarray) -> tuple[int, tuple[int, int], dict[tuple[int, int], dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = get_bg(g)
