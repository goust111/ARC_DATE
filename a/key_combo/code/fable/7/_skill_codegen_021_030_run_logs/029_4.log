+    if len(_visible_hit_directions(inp, start)) != 1:
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
