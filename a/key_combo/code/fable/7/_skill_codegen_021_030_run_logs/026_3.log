+    pairs = []
+    for h in range(1, area + 1):
+        if area % h == 0:
+            w = area // h
+            pairs.append((h, w))
+    pairs.sort(key=lambda hw: (abs(hw[0] - hw[1]), max(hw), min(hw)))
+    h, w = pairs[0]
+    if side in (TOP, BOTTOM) and h > w:
+        h, w = w, h
+    if side in (LEFT, RIGHT) and h < w:
