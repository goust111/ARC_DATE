    counts = Counter(map(int, g.reshape(-1)))
    bg = counts.most_common(1)[0][0]
    assert bg == 0
    specs = []
    for color in sorted(int(c) for c in np.unique(g) if int(c) "'!= bg):
        parts = comps(g == color)
        assert len(parts) == 2, (color, [len(p) for p in parts])
        marker = None
        obj = None
