            if len(part) == 1 and border[0]:
                marker = part[0]
            else:
                assert not any(border), (color, part)
                obj = part
        assert marker is not None and obj is not None
        specs.append({'"'color': color, 'marker': marker, 'side': marker_side(marker, g.shape), 'area': len(obj)})
    areas = [s['area'] for s in specs]
    assert len(areas) == len(set(areas))
    return bg, specs


def oracle(grid):
    bg, specs = parse_case(grid)
    out = np.full(grid.shape, bg, dtype=int)
    best = np.full(grid.shape, -1, dtype=int)
    crosses = 0
    claim_counts = Counter()
    for spec in specs:
        out[spec['marker']] = spec['color']
        for cell in ray_cells(grid.shape, spec['marker'], spec['side'], spec['area']):
            claim_counts[cell] += 1
            if spec['area'] > best[cell]:
                best[cell] = spec['area']
                out[cell] = spec['color']
    crosses = sum(1 for v in claim_counts.values() if v > 1)
    return out, specs, crosses

