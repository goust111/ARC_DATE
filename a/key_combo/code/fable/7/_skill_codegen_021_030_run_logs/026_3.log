def comps(mask):
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cur = []
            while q:
                rr, cc = q.popleft()
                cur.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(cur)
    return out


def marker_side(marker, shape):
    r, c = marker
    h, w = shape
    assert not ((r in (0, h - 1)) and (c in (0, w - 1)))
    if r == 0:
        return 'top'
    if r == h - 1:
        return 'bottom'
    if c == 0:
        return 'left'
    if c == w - 1:
        return 'right'
    raise AssertionError


def ray_cells(shape, marker, side, length):
    h, w = shape
    r, c = marker
    if side == 'top':
        assert 1 <= length <= h - 2
        return [(rr, c) for rr in range(1, length + 1)]
    if side == 'bottom':
        assert 1 <= length <= h - 2
        return [(rr, c) for rr in range(h - 2, h - 2 - length, -1)]
    if side == 'left':
        assert 1 <= length <= w - 2
        return [(r, cc) for cc in range(1, length + 1)]
    if side == 'right':
        assert 1 <= length <= w - 2
        return [(r, cc) for cc in range(w - 2, w - 2 - length, -1)]
    raise AssertionError


def parse_case(grid):
