    basins = parse_basins(grid)
    current = min([b for b in basins if b['left'] < inject < b['right']], key=lambda b: b['floor'])
    remaining = c1 - c0 + 1
    out = grid.copy()
    out[bar_r, c0:c1 + 1] = BG
    while remaining > 0:
        fill = min(remaining, current['cap'])
        assert fill % current['width'] == 0
        layers = fill // current['width']
        out[current['floor'] - layers:current['floor'], current['left'] + 1:current['right']] = WATER
        remaining -= fill
        if remaining == 0 or fill < current['cap']:
            break
        current = next_basin(basins, current)
        assert current is not None
    return out

input_sigs = set()
