from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/025/5.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

sigs = set()
output_sigs = set()
meta_success = 0
meta_attempts = 0
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.count_nonzero(inp == mod.WATER) > 0
    assert np.count_nonzero(out == mod.WATER) > 0
    assert np.count_nonzero(out == mod.TERRAIN) == np.count_nonzero(inp == mod.TERRAIN)
    assert np.count_nonzero(out[0] == mod.WATER) == 0
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    output_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())

while meta_success < 30 and meta_attempts < 500:
    meta_attempts += 1
    try:
        inp, meta = mod._generate_case(return_meta=True)
    except Exception:
        continue
    expected = meta['expected']
    got = mod.main(inp)
    assert np.array_equal(expected, got)
    prefix_caps = [b.capacity for b in meta['basins']]
    assert sum(prefix_caps) >= meta['budget'] or len(prefix_caps) > 1
    meta_success += 1

print('variants', len(sigs))
print('output_variants', len(output_sigs))
print('semantic_cases', meta_success, 'attempts', meta_attempts)
assert len(sigs) >= 20
assert len(output_sigs) >= 20
assert meta_success == 30
