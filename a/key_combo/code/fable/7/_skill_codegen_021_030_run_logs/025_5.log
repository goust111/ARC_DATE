    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, exp), 'semantic mismatch'
    input_sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
print('variants', len(input_sigs))
assert len(input_sigs) >= 20
