    col = basin['left'] - 1 if basin['top_left'] > basin['top_right'] else basin['right'] + 1
    candidates = [b for b in basins if b['floor'] > basin['floor'] and b['left'] < col < b['right']]
    return min(candidates, key=lambda b: b['floor']) if candidates else None


def expected_output(grid):
