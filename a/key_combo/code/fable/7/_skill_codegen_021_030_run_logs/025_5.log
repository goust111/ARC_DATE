def components(mask):
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(cells)
    return out


def parse_bar(grid):
    blues = components(grid == WATER)
    bars = []
    for cells in blues:
        rows = {r for r, _ in cells}
        cols = sorted(c for _, c in cells)
        if len(rows) == 1 and cols == list(range(cols[0], cols[-1] + 1)):
            bars.append((next(iter(rows)), cols[0], cols[-1]))
    assert len(bars) == 1
    r, c0, c1 = bars[0]
    assert (c1 - c0 + 1) % 2 == 1
    return (r, c0, c1), c0 + (c1 - c0) // 2


def parse_basins(grid):
    basins = []
    for cells in components(grid == TERRAIN):
        rs = [r for r, _ in cells]
        cs = [c for _, c in cells]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        if c1 - c0 + 1 < 3:
            continue
        cellset = set(cells)
        if any((r1, c) not in cellset for c in range(c0, c1 + 1)):
            continue
        left_rows = [r for r in range(r0, r1 + 1) if (r, c0) in cellset]
        right_rows = [r for r in range(r0, r1 + 1) if (r, c1) in cellset]
        if not left_rows or not right_rows:
            continue
        tl, tr = left_rows[0], right_rows[0]
        if any((r, c0) not in cellset for r in range(tl, r1 + 1)):
            continue
        if any((r, c1) not in cellset for r in range(tr, r1 + 1)):
            continue
        ok = True
        for r, c in cells:
            if r == r1 or c == c0 or c == c1:
                continue
            ok = False
            break
        if not ok:
            continue
        width = c1 - c0 - 1
        spill = max(tl, tr)
        cap = width * (r1 - spill)
        if width < 2 or cap <= 0:
            continue
        basins.append({'left': c0, 'right': c1, 'floor': r1, 'top_left': tl, 'top_right': tr, 'width': width, 'spill': spill, 'cap': cap})
