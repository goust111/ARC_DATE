+    start_r_lo = 1 - min_r
+    start_r_hi = height - 2 - max_r
+    start_c_lo = 3 - min_c
+    start_c_hi = width - 2 - max_c
+    if start_r_lo > start_r_hi or start_c_lo > start_c_hi:
