+            c += dc
+            assert (r, c) not in visited
+            visited.add((r, c))
+            trace.append((r, c, seg_idx))
+    return trace
+
+
+def _render_output(
+    shape: tuple[int, int],
+    bg: int,
+    horizontal_color: int,
+    vertical_color: int,
+    start_color: int,
+    start: tuple[int, int],
+    lengths: list[int],
+) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.full((h, w), int(bg), dtype=int)
+    out[0, 0] = int(horizontal_color)
