        for r0 in range(0, h - box_h + 1)
        for c0 in range(0, w - box_w + 1)
        if not blocked[r0 : r0 + box_h, c0 : c0 + box_w].any()
    ]
    if not candidates:
        return None
    return tuple(map(int, candidates[int(_RNG.integers(0, len(candidates)))]))



