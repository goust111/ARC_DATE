+    return dims
+
+
+def _sample_marker_positions(inner_h: int, inner_w: int, count: int) -> list[tuple[int, int]]:
+    groups = [group for group in _marker_slots(inner_h, inner_w) if len(group) >= count]
+    assert groups
+    group = groups[int(_RNG.integers(0, len(groups)))]
