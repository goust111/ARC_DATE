from collections import Counter, deque
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/027/1.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

def components(grid, bg):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or grid[r, c] == bg:
                continue
            color = int(grid[r, c])
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append((color, coords))
    return out

def border_mask(h, w):
    m = np.zeros((h, w), dtype=bool)
    m[0, :] = True
    m[-1, :] = True
    m[:, 0] = True
    m[:, -1] = True
    return m

def parse_independent(inp):
    g = np.asarray(inp, dtype=int)
    bg = Counter(map(int, g.flat)).most_common(1)[0][0]
    hc, vc = int(g[0, 0]), int(g[0, 1])
    assert hc "'!= bg and vc != bg and hc != vc
    palette_mask = np.zeros_like(g, dtype=bool)
    palette_mask[0, 0] = True
    palette_mask[0, 1] = True

    frame_border = np.zeros_like(g, dtype=bool)
    frame_interiors = np.zeros_like(g, dtype=bool)
    counts = []
    for color, coords in components(g, bg):
        if (0, 0) in coords or (0, 1) in coords:
            continue
        rows = [r for r, _ in coords]
        cols = [c for _, c in coords]
        r0, r1 = min(rows), max(rows)
        c0, c1 = min(cols), max(cols)
        h, w = r1 - r0 + 1, c1 - c0 + 1
        if h < 3 or w < 3:
            continue
        local = np.zeros((h, w), dtype=bool)
        for r, c in coords:
            local[r - r0, c - c0] = True
        bm = border_mask(h, w)
        if np.array_equal(local, bm):
            frame_border[r0:r1 + 1, c0:c1 + 1] |= bm
            inner = g[r0 + 1:r1, c0 + 1:c1] != bg
            count = int(inner.sum())
            assert count > 0
            frame_interiors[r0 + 1:r1, c0 + 1:c1] |= inner
