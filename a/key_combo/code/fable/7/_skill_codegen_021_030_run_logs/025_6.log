def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
    height, width = shape
    rows = coords[:, 0]
    cols = coords[:, 1]
    return (
        int(rows.min()) == 0
        or int(cols.min()) == 0
        or int(rows.max()) == height - 1
        or int(cols.max()) == width - 1
    )


