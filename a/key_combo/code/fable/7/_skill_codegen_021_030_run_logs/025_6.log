+
+def _tile_has_period(tile: np.ndarray, axis: int, shift: int) -> bool:
+    return bool(np.array_equal(tile, np.roll(tile, -int(shift), axis=axis)))
+
+
+def _sample_tile(pr: int, pc: int) -> np.ndarray:
