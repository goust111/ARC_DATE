+    assert candidates, "expected at least one coherent rectangle candidate"
+    candidates.sort(key=lambda item: item["score"], reverse=True)
+    best = candidates[0]
+    best["runner_up_score"] = candidates[1]["score"] if len(candidates) > 1 else None
+    return best
