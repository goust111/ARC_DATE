+def _rect_sum(prefix: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
+    return int(prefix[r1 + 1, c1 + 1] - prefix[r0, c1 + 1] - prefix[r1 + 1, c0] + prefix[r0, c0])
