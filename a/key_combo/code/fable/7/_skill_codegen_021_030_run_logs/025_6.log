+    for rr in range(pr):
+        for cc in range(pc):
+            tile[rr, cc] = _majority_color(grid[rr::pr, cc::pc].ravel())
+    return tile
+
+
+def _rank_shift_phases(grid: np.ndarray, base: np.ndarray, tile: np.ndarray) -> list[tuple[int, int, int]]:
+    mismatch = grid != base
