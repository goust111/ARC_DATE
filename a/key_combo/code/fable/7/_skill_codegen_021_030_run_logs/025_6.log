+                "votes": votes,
+                "rect": rect_info["rect"],
+                "support": rect_info["support"],
+                "outside_visible": rect_info["outside_visible"],
+                "area": rect_info["area"],
+                "score": overall_score,
+                "tile": tile,
+                "base": base,
+                "period": (pr, pc),
+            }
+        )
