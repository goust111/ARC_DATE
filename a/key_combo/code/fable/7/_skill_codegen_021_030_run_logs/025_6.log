+    pr, pc = tile.shape
+    sr, sc = shift
+    rows = (np.arange(shape[0]) + int(sr)) % pr
+    cols = (np.arange(shape[1]) + int(sc)) % pc
+    return tile[np.ix_(rows, cols)]
