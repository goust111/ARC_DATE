+                "rect": rect,
+                "shift": shift,
+                "period": (pr, pc),
+                "tile": tile,
+                "noise": noise,
+            }
+        return grid
+    raise RuntimeError("failed to generate a valid input")
+
+
+def generate_input() -> np.ndarray:
+    return _generate_case(return_meta=False)

