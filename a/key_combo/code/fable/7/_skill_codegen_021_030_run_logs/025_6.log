+                    inside_visible = _rect_sum(prefix_visible, int(r0), int(c0), int(r1), int(c1))
+                    if inside_visible == 0:
+                        continue
+                    inside_changed = _rect_sum(prefix_changed, int(r0), int(c0), int(r1), int(c1))
+                    if inside_visible != inside_changed:
