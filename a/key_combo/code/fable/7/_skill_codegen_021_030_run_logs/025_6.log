+                    if _rect_sum(prefix_visible, int(r1), int(c0), int(r1), int(c1)) == 0:
+                        continue
+                    if _rect_sum(prefix_visible, int(r0), int(c0), int(r1), int(c0)) == 0:
+                        continue
+                    if _rect_sum(prefix_visible, int(r0), int(c1), int(r1), int(c1)) == 0:
+                        continue
