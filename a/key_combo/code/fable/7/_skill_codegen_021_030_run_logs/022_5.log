+def _random_partition(total: int, parts: int, rng: np.random.Generator) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(map(int, rng.choice(np.arange(1, total), size=parts - 1, replace=False)))
+    prev = 0
+    out = []
+    for cut in cuts + [total]:
+        out.append(cut - prev)
+        prev = cut
+    return out
+
