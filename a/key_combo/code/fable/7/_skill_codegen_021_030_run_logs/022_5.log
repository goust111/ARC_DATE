+    r, c = cell
+    out = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < half_h and 0 <= cc < half_w:
+                out.append((rr, cc))
