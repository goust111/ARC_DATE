+    for variant in variant_order:
+        max_r = int(variant[:, 0].max()) + 1
+        max_c = int(variant[:, 1].max()) + 1
+        anchors = [(r0, c0) for r0 in range(height - max_r + 1) for c0 in range(width - max_c + 1)]
+        random.shuffle(anchors)
+        for r0, c0 in anchors:
