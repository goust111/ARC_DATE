+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid chained-contact counting input")

