+            return False
+        if int(scatter[int(r), int(c)]) != bg:
+            return False
+    adjacent = _neighbor_colors(scatter, coords)
+    if not adjacent.issubset(allowed_touch_colors):
+        return False
+    if require_touch_color is not None and require_touch_color not in adjacent:
+        return False
+    return True
