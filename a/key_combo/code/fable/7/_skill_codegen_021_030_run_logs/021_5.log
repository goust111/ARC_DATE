def bfs_components(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(grid[r, c]) "'!= color:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(cells)
    return comps


def oracle(inp):
    counts = Counter(map(int, inp.ravel()))
    bg = counts.most_common(1)[0][0]
    row0 = inp[0]
    legend = []
    c = 0
    while c < inp.shape[1] and int(row0[c]) != bg:
        legend.append(int(row0[c]))
        c += 1
    assert legend and len(set(legend)) == len(legend)
    assert np.all(inp[0, c:] == bg)
    sep = int(inp[1, 0])
    assert sep != bg and sep not in legend and np.all(inp[1] == sep)
    scatter = inp[2:]
    scatter_colors = {int(x) for x in np.unique(scatter)} - {bg}
    assert set(legend).issubset(scatter_colors)
    distractors = sorted(scatter_colors - set(legend))
    by_color = {color: bfs_components(scatter, color) for color in scatter_colors}
    out = []
    counts = []
    for i, color in enumerate(legend):
        comps = by_color.get(color, [])
        if i == 0:
            count = len(comps)
        else:
            prev = legend[i - 1]
            count = 0
            for comp in comps:
                ok = False
                for r, c in comp:
                    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                        if 0 <= nr < scatter.shape[0] and 0 <= nc < scatter.shape[1] and int(scatter[nr, nc]) == prev:
                            ok = True
                            break
                    if ok:
                        break
                count += int(ok)
        counts.append(count)
        out.extend([color] * count)
    return np.array(out, dtype=int).reshape(-1, 1), legend, counts, distractors

sigs = set()
legend_lens = set()
seen_zero = False
seen_zero_then_positive = False
seen_unqualified = False
seen_distractor = False
for i in range(120):
    inp = mod.generate_input()
    out = mod.main(inp)
    exp, legend, counts, distractors = oracle(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'"'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, exp), (inp, out, exp)
    assert len(distractors) >= 1
    seen_distractor = True
    legend_lens.add(len(legend))
    seen_zero |= any(c == 0 for c in counts[1:])
    seen_zero_then_positive |= any(counts[j] == 0 and counts[j + 1] > 0 for j in range(1, len(counts) - 1))
    seen_unqualified |= any(total_color not in counts for total_color in []) or False
    scatter = inp[2:]
    for idx, color in enumerate(legend[1:], start=1):
        total = len(bfs_components(scatter, color))
        if counts[idx] < total:
            seen_unqualified = True
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
print('variants', len(sigs))
print('legend_lengths', sorted(legend_lens))
print('seen_zero', seen_zero)
print('seen_zero_then_positive', seen_zero_then_positive)
print('seen_unqualified', seen_unqualified)
print('seen_distractor', seen_distractor)
assert len(sigs) >= 20
assert len(legend_lens) >= 2
assert seen_zero
assert seen_zero_then_positive
assert seen_unqualified
assert seen_distractor
