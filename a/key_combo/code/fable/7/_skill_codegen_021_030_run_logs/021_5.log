+        if not in_bounds(scatter.shape, int(r), int(c)):
+            return False
+        if int(scatter[int(r), int(c)]) != bg:
+            return False
+    adjacent = _neighbor_colors(scatter, coords)
+    if not adjacent.issubset(allowed_touch_colors):
