+BG = Color.BLACK
+GREY = Color.GREY
+COLOR_POOL = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
+GEN_ATTEMPTS = 400
+
+
+def _scan_platforms(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    mask = np.zeros((h, w), dtype=bool)
+    platforms: list[dict] = []
+    for r in range(h):
+        c = 0
+        while c < w:
+            color = int(grid[r, c])
+            if color == bg:
+                c += 1
+                continue
+            c0 = c
+            while c + 1 < w and int(grid[r, c + 1]) == color:
+                c += 1
