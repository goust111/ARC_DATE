+def _erase_platform_run(grid: np.ndarray, row: int, col: int, bg: int) -> dict:
+    color = int(grid[row, col])
+    c0 = int(col)
+    c1 = int(col)
+    while c0 - 1 >= 0 and int(grid[row, c0 - 1]) == color:
