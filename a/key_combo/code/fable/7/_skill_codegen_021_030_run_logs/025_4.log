+    axis = pair["axis"]
+    if axis is not None:
+        line = axis_cells((0, 0, h - 1, w - 1), axis)
+        assert line
+        assert not (set(line) & pair["coords_a"])
+        assert not (set(line) & pair["coords_b"])
