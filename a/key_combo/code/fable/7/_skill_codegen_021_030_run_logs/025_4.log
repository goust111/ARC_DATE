+        or b[2] + padding < a[0]
+        or a[3] + padding < b[1]
+        or b[3] + padding < a[1]
+    )
+
+
+def _place_patches(pairs: list[dict]) -> tuple[np.ndarray, np.ndarray]:
+    patch_data = []
+    for pair in pairs:
+        inp_patch, out_patch = render_pair_patch(pair)
