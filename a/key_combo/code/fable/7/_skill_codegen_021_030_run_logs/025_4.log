+        pair["color_a"] = random.choice(PALETTE)
+        pair["color_b"] = random.choice(PALETTE)
+    if len(pairs) >= 2:
+        pairs[0]["color_a"] = trap_color
+        pairs[1]["color_a"] = trap_color
