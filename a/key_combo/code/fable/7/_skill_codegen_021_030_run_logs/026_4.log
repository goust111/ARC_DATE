+def _blank_rows_cols(grid: np.ndarray, bg: int) -> tuple[list[int], list[int]]:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == bg)]
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == bg)]
+    return rows, cols
