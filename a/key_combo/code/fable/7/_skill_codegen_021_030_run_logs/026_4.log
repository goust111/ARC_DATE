+def _layout_from_cross(shape: tuple[int, int], fold_r: int, fold_c: int) -> dict:
+    height, width = map(int, shape)
+    top_h = int(fold_r)
+    bottom_h = int(height - fold_r - 1)
+    left_w = int(fold_c)
+    right_w = int(width - fold_c - 1)
