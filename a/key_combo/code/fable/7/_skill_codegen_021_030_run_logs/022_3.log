+            occ_mask = 0
+            for rr, cc in coords:
+                bit = (r + int(rr)) * width + (c + int(cc))
+                occ_mask |= 1 << bit
+            candidates.append(Candidate(r=r, c=c, row_mask=row_mask, col_mask=col_mask, occ_mask=occ_mask))
+    return candidates
