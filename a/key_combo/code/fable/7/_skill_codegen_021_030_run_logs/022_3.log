+        h, w = sprite.shape
+        row_mask |= _interval_mask(cand.r, h)
+        col_mask |= _interval_mask(cand.c, w)
+    row_mask &= (1 << height) - 1
+    col_mask &= (1 << width) - 1
+    return row_mask, col_mask
