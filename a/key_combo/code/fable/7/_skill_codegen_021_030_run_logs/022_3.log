+        order = sorted(range(len(sprites)), key=lambda i: -int(np.count_nonzero(sprites[i])))
+        ok = True
+
+        for idx in order:
+            sprite = sprites[idx]
+            h, w = sprite.shape
+            coords = _sprite_coords(sprite)
+            candidate_positions = []
+            for r in range(height - h + 1):
+                for c in range(width - w + 1):
+                    sprite_mask = np.zeros(scene_shape, dtype=bool)
+                    for rr, cc in coords:
