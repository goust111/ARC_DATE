    pairs = []
    for idx, first in enumerate(coords):
        for second in coords[idx + 1 :]:
            if max(abs(first[0] - second[0]), abs(first[1] - second[1])) == 1:
                pairs.append([first, second])
    return random.choice(pairs) if pairs else []


