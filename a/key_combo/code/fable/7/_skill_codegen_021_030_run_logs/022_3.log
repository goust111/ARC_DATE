+def _parse_input(grid: np.ndarray) -> tuple[tuple[int, int], list[np.ndarray], int, int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    sep_r = _find_separator_row(g)
