+    return int(rows[0])
+
+
+def _extract_sprites(legend: np.ndarray) -> list[np.ndarray]:
+    comps = find_components(legend, bg=BG, connectivity=4, monochromatic=True)
+    assert comps, "expected at least one legend sprite"
