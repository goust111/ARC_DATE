+    dfs(0, 0, 0, 0)
+    return solution_count, first_solution
+
+
+def _assemble_from_solution(
+    scene_shape: tuple[int, int], sprites: list[np.ndarray], solution: list[Candidate]
+) -> np.ndarray:
