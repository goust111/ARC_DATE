+CLUE = Color.GRAY
+SEPARATOR = Color.MAROON
+SPRITE_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL]
