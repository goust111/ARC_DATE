+    height = random.randint(min_h, max_h_scene)
+    width = random.randint(min_w, max_w_scene)
+    return int(height), int(width)
+
+
+def _sample_solution(scene_shape: tuple[int, int], sprites: list[np.ndarray]) -> list[Candidate] | None:
