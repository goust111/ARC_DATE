+        if (row_mask >> r) & 1:
+            scene[r, 0] = CLUE
+    for c in range(width):
+        if (col_mask >> c) & 1:
+            scene[0, c] = CLUE
+    return scene
+
+
+def _layout_legend(sprites: list[np.ndarray], width: int, max_height: int) -> np.ndarray | None:
+    n = len(sprites)
+    indices = list(range(n))
+    random.shuffle(indices)
+    max_rows = min(3, n)
+
+    for row_count in range(1, max_rows + 1):
