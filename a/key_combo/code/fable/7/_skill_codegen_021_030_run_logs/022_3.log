+            i += 1
+            continue
+        j = i
+        while j + 1 < length and ((mask >> (j + 1)) & 1):
+            j += 1
+        segments.append((i, j))
+        i = j + 1
+    return segments
+
+
+def _bbox_masks_from_solution(
