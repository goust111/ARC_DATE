+
+def _sprite_coords(sprite: np.ndarray) -> np.ndarray:
+    return np.argwhere(np.asarray(sprite) != BG)
+
+
+def _enumerate_candidates(
+    scene_shape: tuple[int, int],
+    sprite: np.ndarray,
+    row_target: int,
+    col_target: int,
+) -> list[Candidate]:
