+
+Coord = tuple[int, int]
+Dir = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BLACK = 0
+DIR_UP: Dir = (-1, 0)
+DIR_DOWN: Dir = (1, 0)
+DIR_LEFT: Dir = (0, -1)
+DIR_RIGHT: Dir = (0, 1)
