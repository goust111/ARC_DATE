+
+def rotate_scene(grid: np.ndarray, k: int) -> np.ndarray:
+    return np.rot90(grid, k=k)
+
+
+def generate_case() -> tuple[np.ndarray, np.ndarray, dict]:
+    n_chains = random.choice([2, 3])
+    band_h = 9
+    sep = 1
