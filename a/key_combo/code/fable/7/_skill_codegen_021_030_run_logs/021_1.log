+from __future__ import annotations
+
+import random
+from collections import Counter
+from dataclasses import dataclass
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Dir = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BLACK = 0
+DIR_UP: Dir = (-1, 0)
+DIR_DOWN: Dir = (1, 0)
+DIR_LEFT: Dir = (0, -1)
+DIR_RIGHT: Dir = (0, 1)
+DIR_TO_SIDE = {
+    DIR_UP: "top",
+    DIR_DOWN: "bottom",
+    DIR_LEFT: "left",
+    DIR_RIGHT: "right",
