+
+def opposite(direction: Dir) -> Dir:
+    return (-direction[0], -direction[1])
+
+
+def rotate_dir(direction: Dir, k: int) -> Dir:
+    dr, dc = direction
+    k %= 4
+    for _ in range(k):
