+def free_path_to_boundary(current: Coord, direction: Dir, shape: tuple[int, int], occupied: set[Coord]) -> list[Coord] | None:
+    cells = cells_to_boundary(current, direction, shape)
+    if segment_is_free(cells[1:], occupied):
