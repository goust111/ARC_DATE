+from __future__ import annotations
+
+import random
+from collections import Counter
+from dataclasses import dataclass
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Dir = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BLACK = 0
+DIR_UP: Dir = (-1, 0)
+DIR_DOWN: Dir = (1, 0)
+DIR_LEFT: Dir = (0, -1)
+DIR_RIGHT: Dir = (0, 1)
+DIR_TO_SIDE = {
+    DIR_UP: "top",
+    DIR_DOWN: "bottom",
+    DIR_LEFT: "left",
+    DIR_RIGHT: "right",
+}
+
+
+@dataclass(frozen=True)
+class Marker:
+    color: int
+    coord: Coord
+    direction: Dir
+
+
+@dataclass(frozen=True)
+class Frame:
+    color: int
+    bbox: BBox
+    gap: Coord
+    exit_dir: Dir
+    wall_cells: frozenset[Coord]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)
+
+
+def monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds((h, w), nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": int(coords.shape[0]),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
+
+def bbox_cells(bbox: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = bbox
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def ring_cells(bbox: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def gap_exit_dir(bbox: BBox, gap: Coord) -> Dir | None:
+    r0, c0, r1, c1 = bbox
+    r, c = gap
+    if r == r0 and c0 < c < c1:
+        return DIR_UP
+    if r == r1 and c0 < c < c1:
+        return DIR_DOWN
+    if c == c0 and r0 < r < r1:
+        return DIR_LEFT
+    if c == c1 and r0 < r < r1:
+        return DIR_RIGHT
+    return None
+
+
+def inward_dir(coord: Coord, shape: tuple[int, int]) -> Dir | None:
+    r, c = coord
+    h, w = shape
+    if r == 0 and 0 < c < w - 1:
+        return DIR_DOWN
+    if r == h - 1 and 0 < c < w - 1:
+        return DIR_UP
+    if c == 0 and 0 < r < h - 1:
+        return DIR_RIGHT
+    if c == w - 1 and 0 < r < h - 1:
+        return DIR_LEFT
+    return None
+
+
+def parse_scene(grid: np.ndarray) -> tuple[int, list[Marker], list[Frame]]:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
+    bg = get_bg(g)
+    markers: list[Marker] = []
+    frames: list[Frame] = []
+    for comp in monochrome_components(g, bg):
+        coords = comp["coords"]
+        if comp["area"] == 1:
+            coord = tuple(map(int, coords[0]))
+            direction = inward_dir(coord, g.shape)
+            if direction is None:
+                raise ValueError("singleton foreground cells must be non-corner boundary markers")
+            markers.append(Marker(color=int(comp["color"]), coord=coord, direction=direction))
+            continue
