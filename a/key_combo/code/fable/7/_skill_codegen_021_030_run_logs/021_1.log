+
+
+def bbox_cells(bbox: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = bbox
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def ring_cells(bbox: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def gap_exit_dir(bbox: BBox, gap: Coord) -> Dir | None:
+    r0, c0, r1, c1 = bbox
+    r, c = gap
+    if r == r0 and c0 < c < c1:
+        return DIR_UP
+    if r == r1 and c0 < c < c1:
+        return DIR_DOWN
+    if c == c0 and r0 < r < r1:
+        return DIR_LEFT
+    if c == c1 and r0 < r < r1:
+        return DIR_RIGHT
+    return None
+
+
+def inward_dir(coord: Coord, shape: tuple[int, int]) -> Dir | None:
+    r, c = coord
+    h, w = shape
+    if r == 0 and 0 < c < w - 1:
+        return DIR_DOWN
+    if r == h - 1 and 0 < c < w - 1:
+        return DIR_UP
+    if c == 0 and 0 < r < h - 1:
+        return DIR_RIGHT
+    if c == w - 1 and 0 < r < h - 1:
+        return DIR_LEFT
+    return None
+
+
+def parse_scene(grid: np.ndarray) -> tuple[int, list[Marker], list[Frame]]:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
+    bg = get_bg(g)
+    markers: list[Marker] = []
+    frames: list[Frame] = []
+    for comp in monochrome_components(g, bg):
+        coords = comp["coords"]
+        if comp["area"] == 1:
