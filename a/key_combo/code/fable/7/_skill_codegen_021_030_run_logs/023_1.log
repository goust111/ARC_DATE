BG = 0
GREY = 5

def nbrs(r, c):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def comps_of_color(g, color):
    h, w = g.shape
    seen = set()
    out = []
    for r in range(h):
        for c in range(w):
            if int(g[r, c]) "'!= color or (r, c) in seen:
                continue
            q = deque([(r, c)])
            seen.add((r, c))
            comp = []
            while q:
                rr, cc = q.popleft()
                comp.append((rr, cc))
                for nr, nc in nbrs(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == color and (nr, nc) not in seen:
                        seen.add((nr, nc))
                        q.append((nr, nc))
