+        side, distance, step = _classify_against_rect((r, c), rect)
+        distances.append(distance)
+        movers.append(
+            {
+                "color": int(color),
+                "source": (r, c),
+                "side": side,
+                "distance": int(distance),
+                "step": step,
+                "tail_len": int(comp["area"]),
+                "tail_id": int(tail_id),
