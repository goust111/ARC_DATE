+    for mover in parsed["movers"]:
+        r, c = mover["source"]
+        dr, dc = mover["step"]
+        pos_r, pos_c = r, c
+        for _ in range(mover["tail_len"]):
+            nr = pos_r + dr
+            nc = pos_c + dc
