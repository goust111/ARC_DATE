+    assert len(comps) == 1, "expected exactly one grey object"
+    comp = comps[0]
+    rect = tuple(map(int, comp["bbox"]))
+    area = int(comp["area"])
+    r0, c0, r1, c1 = rect
+    assert area == (r1 - r0 + 1) * (c1 - c0 + 1), "grey object must be a solid rectangle"
