            side, step, dist = 'bottom', (-1, 0), r - rr1 - 1
        if rr0 <= r <= rr1 and c < cc0:
            assert side is None
            side, step, dist = 'left', (0, 1), cc0 - c - 1
        if rr0 <= r <= rr1 and c > cc1:
            assert side is None
            side, step, dist = 'right', (0, -1), c - cc1 - 1
        assert side is not None and dist > 0
        dists.append(dist)
        movers.append({'color': color, 'source': (r, c), 'tail_len': len(tr), 'step': step, 'distance': dist, 'tail_cells': set(tr)})
    assert len(set(dists)) == len(dists)
    assert len(tail_comps) == len(movers)
    return rect, tail_color, sorted(movers, key=lambda m: m['distance'])


def solve_independent(g):
    rect, tail_color, movers = parse_independent(g)
    out = np.zeros_like(g)
    r0, c0, r1, c1 = rect
    out[r0:r1+1, c0:c1+1] = GREY
    finals = []
    for m in movers:
