+                continue
+            dr = nxt[0] - last[0]
+            dc = nxt[1] - last[1]
+            turn_penalty = 0 if len(path) == 1 or (dr, dc) != (path[-1][0] - path[-2][0], path[-1][1] - path[-2][1]) else 1
+            scored.append((turn_penalty, random.random(), nxt))
+        scored.sort()
