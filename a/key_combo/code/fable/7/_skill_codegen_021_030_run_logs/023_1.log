            continue
        pts = np.argwhere(g == color)
        assert pts.shape == (1, 2)
        r, c = map(int, pts[0])
        adj_ids = {label[(nr, nc)] for nr, nc in nbrs(r, c) if (nr, nc) in label}
        assert len(adj_ids) == 1
        tid = next(iter(adj_ids))
        tr = tail_comps[tid]
        touching = [cell for cell in tr if abs(cell[0]-r) + abs(cell[1]-c) == 1]
        assert len(touching) == 1
        side = None
        step = None
        dist = None
        rr0, cc0, rr1, cc1 = rect
        if cc0 <= c <= cc1 and r < rr0:
            side, step, dist = '"'top', (1, 0), rr0 - r - 1
        if cc0 <= c <= cc1 and r > rr1:
