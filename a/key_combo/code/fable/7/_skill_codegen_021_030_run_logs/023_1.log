+
+    for nr, nc, _preferred in first_moves:
+        first = (nr, nc)
+        if not valid(first, [], None):
+            continue
+        if length == 1:
+            return [first]
+        found = dfs([first])
+        if found is not None:
+            return found
+    return None
+
+
+def _build_expected_from_plan(shape: tuple[int, int], rect: tuple[int, int, int, int], movers: list[dict]) -> np.ndarray:
