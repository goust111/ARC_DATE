+    for idx, comp in enumerate(tail_comps):
+        coords = comp["coords"]
+        label_map[coords[:, 0], coords[:, 1]] = idx
+    return tail_comps, label_map
+
+
+def _parse_case(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
