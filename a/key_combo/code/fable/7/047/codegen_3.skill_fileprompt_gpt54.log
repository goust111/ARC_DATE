            guard_mask[r1 - 1, c + 1 + motif_w] = True
        return {
            "bar": bar_mask,
            "fill": fill_mask,
            "motif": motif_mask,
            "input_nonbg": bar_mask | motif_mask,
            "footprint": bar_mask | fill_mask,
            "guard": guard_mask,
            "bar_slice": (slice(r, r1), c),
            "fill_slice": (slice(r, r1), slice(c + 1, c + 1 + motif_w)),
