    bottom = int(top) + int(height) - 1
    right = int(left) + int(width) - 1
    patch[top, left : right + 1] = GEN_OBJECT_COLOR
    patch[bottom, left : right + 1] = GEN_OBJECT_COLOR
    patch[top : bottom + 1, left] = GEN_OBJECT_COLOR
