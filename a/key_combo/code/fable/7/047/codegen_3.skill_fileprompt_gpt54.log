    largest = [obj for obj in objects if obj["largest"]]
    largest.sort(key=lambda obj: int(obj["loc"][1]))
    expected = np.empty((max_area, n_largest), dtype=int)
    for col, obj in enumerate(largest):
        expected[:, col] = int(obj["color"])
    return expected


