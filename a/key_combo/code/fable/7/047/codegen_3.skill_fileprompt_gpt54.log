                if orient == GEN_VERTICAL:
                    yield length, repeats, axis_dim, cross_dim
                else:
                    yield length, repeats, cross_dim, axis_dim


def _gen_placement_ranges(orient: str, length: int, motif_h: int, motif_w: int) -> tuple[range, range]:
