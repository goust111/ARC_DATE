+def _gen_attempt() -> np.ndarray | None:
+    built = _build_containers()
+    if built is None:
+        return None
+    grid, containers = built
+    counts = _assignment_counts(containers)
+    if counts is None:
+        return None
+    areas = _choose_areas(containers, counts)
+    if areas is None:
+        return None
+    if not _place_objects(grid, containers, areas):
+        return None
