+                continue
+            for b in range(1, area_cap + 1):
+                if b == a or b in used:
+                    continue
+                if a + b <= container["capacity"]:
+                    pairs.append((a, b))
+        if not pairs:
+            return None
+        pair = random.choice(pairs)
+        chosen[idx] = [pair[0], pair[1]]
+        used.add(pair[0])
+        used.add(pair[1])
