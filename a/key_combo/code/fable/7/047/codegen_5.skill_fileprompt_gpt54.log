+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return components
+
+
+def _component_mask(component: dict) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in component["coords"]:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _is_u_container(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    mask = _component_mask(component)
+    expected = np.zeros_like(mask)
+    expected[:, 0] = True
+    expected[:, -1] = True
+    expected[-1, :] = True
+    return np.array_equal(mask, expected)
+
+
+def _fill_order(container: dict) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = container["bbox"]
+    cells = []
+    for r in range(r1 - 1, r0 - 1, -1):
+        for c in range(c0 + 1, c1):
+            cells.append((r, c))
+    return cells
