+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h + 2 and 0 <= nc < w + 2 and not seen[nr, nc] and canvas[nr, nc]:
