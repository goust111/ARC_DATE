+    side, tab = candidates[0]
+    return side, (int(tab[0]), int(tab[1]))
+
+
+def _reflect_coords(
+    coords: np.ndarray,
+    side: str,
+    tab: tuple[int, int],
+    marker: tuple[int, int],
+) -> np.ndarray:
+    tr, tc = tab
+    mr, mc = marker
+    if side in LR_SIDES:
