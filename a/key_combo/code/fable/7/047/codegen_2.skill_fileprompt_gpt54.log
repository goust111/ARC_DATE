+
+def _reflect_coords(
+    coords: np.ndarray,
+    side: str,
+    tab: tuple[int, int],
+    marker: tuple[int, int],
+) -> np.ndarray:
+    tr, tc = tab
+    mr, mc = marker
+    if side in LR_SIDES:
+        reflected = coords.copy()
+        reflected[:, 1] = int(tc + mc) - coords[:, 1]
