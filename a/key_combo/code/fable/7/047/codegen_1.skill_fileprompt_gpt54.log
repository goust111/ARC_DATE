+    shape: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+    depth_to_color: dict[int, int],
+) -> np.ndarray:
+    r0, c0, r1, c1 = frame_bbox
+    side = int(r1 - r0 + 1)
+    out = np.full(shape, BLACK, dtype=int)
+
+    out[r0, c0 : c1 + 1] = GREY
+    out[r1, c0 : c1 + 1] = GREY
+    out[r0 : r1 + 1, c0] = GREY
+    out[r0 : r1 + 1, c1] = GREY
