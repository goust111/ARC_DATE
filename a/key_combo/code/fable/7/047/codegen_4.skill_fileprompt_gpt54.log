    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    assert bg != Color.GREEN, "green objects must be foreground"
    assert set(map(int, np.unique(g))) <= {int(bg), Color.GREEN}, "expected only background and green input pixels"

    out = g.copy()
