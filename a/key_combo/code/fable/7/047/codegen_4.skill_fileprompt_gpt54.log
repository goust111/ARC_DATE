+    (0, 1): ((0, 0), (1, 0), (2, 0)),
+    (0, -1): ((0, 2), (1, 2), (2, 2)),
+    (1, 0): ((0, 0), (0, 1), (0, 2)),
+    (-1, 0): ((2, 0), (2, 1), (2, 2)),
+}
+MIDPOINT_TO_SIDE = {
+    (0, 1): "up",
+    (2, 1): "down",
+    (1, 0): "left",
+    (1, 2): "right",
+}
