+    seed_pos, seed_dir, seed_color = _find_seed(g, bg, centers)
+
+    out = g.copy()
+    current_start = seed_pos
+    current_dir = seed_dir
+    current_color = seed_color
+    paint_start = False
+    activated: set[int] = set()
+    trace: list[int] = []
+
+    while True:
+        hit = _trace_ray(
+            g,
+            out,
+            bg,
