+    return out
+
+
+def _draw_generator(grid: np.ndarray, center: tuple[int, int], sequence: list[int]) -> None:
+    for dist, color in enumerate(sequence):
+        for r, c in _ring_cells(grid.shape, center, dist):
+            grid[r, c] = int(color)
