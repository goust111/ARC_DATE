+    for dist, color in enumerate(sequence):
+        for r, c in _ring_cells(grid.shape, center, dist):
+            grid[r, c] = int(color)
+
+
+def _seed_candidates(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
