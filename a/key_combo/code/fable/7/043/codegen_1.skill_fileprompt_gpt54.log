+        except AssertionError:
+            continue
+        if np.array_equal(out, candidate):
+            continue
+        return candidate
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid phase-ring-extension input")

