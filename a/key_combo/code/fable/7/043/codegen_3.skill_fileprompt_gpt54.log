    counts = mins.copy()
    extra = int(total_blues) - int(counts.sum())
    caps = maxs - counts
    while extra > 0:
        open_cells = np.flatnonzero(caps > 0)
        if open_cells.size == 0:
            return counts
        idx = int(np.random.choice(open_cells))
        counts[idx] += 1
        caps[idx] -= 1
        extra -= 1
    return counts


