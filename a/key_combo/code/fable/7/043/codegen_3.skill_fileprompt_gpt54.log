                rr, cc = r + dr, c + dc
                if dr == 0 and dc == 0:
                    value = bg
                elif abs(dr) == 1 and abs(dc) == 1:
                    value = Color.GREY
                else:
                    value = Color.BLUE

                if written[rr, cc]:
                    assert values[rr, cc] == value
                values[rr, cc] = value
                written[rr, cc] = True

    out[written] = values[written]
    return out

