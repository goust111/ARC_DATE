+    visited = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
