+def _neighbors(shape: tuple[int, int], r: int, c: int, connectivity: int) -> tuple[tuple[int, int], ...]:
+    deltas = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    out: list[tuple[int, int]] = []
+    h, w = shape
+    for dr, dc in deltas:
