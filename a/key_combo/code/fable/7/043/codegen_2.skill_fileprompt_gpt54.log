def _gen_grow_blob(grid, size):
    h, w = grid.shape
    seeds = _gen_empty_isolated_cells(grid)
    if not seeds:
        return None

    blob = {seeds[np.random.randint(len(seeds))]}
    while len(blob) < size:
        frontier = set()
        for r, c in blob:
            for rr, cc in _gen_neighbors4(r, c, h, w):
