+def _landing(grid: np.ndarray, pocket: dict) -> tuple[int, np.ndarray]:
+    h, w = grid.shape
+    dr, dc = pocket["dir"]
+    coords = pocket["coords"]
+    for step in range(1, max(h, w) + 1):
+        moved = coords + step * np.array([dr, dc], dtype=int)
+        rr = moved[:, 0]
+        cc = moved[:, 1]
