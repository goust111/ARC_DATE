+    pockets = _extract_pockets(g)
+    out = g.copy()
+    for pocket in pockets:
+        out[pocket["coords"][:, 0], pocket["coords"][:, 1]] = BLUE
+
+    for pocket in pockets:
+        _step, moved = _landing(g, pocket)
+        rr = moved[:, 0]
+        cc = moved[:, 1]
+        assert not np.any(out[rr, cc] == BLUE), "grey stamp must land on background or marker"
+        out[rr, cc] = GREY
+
+    return out
+
