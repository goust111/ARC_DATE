+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREY = 5
+
+SIDE_TO_DIR = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+
+GEN_RETRIES = 400
+GRID_MIN = 18
+GRID_MAX = 27
+OUTER_MIN = 8
+OUTER_MAX = 13
+POCKET_COUNT_RANGE = (2, 4)
+DISTRACTOR_COUNT_RANGE = (1, 3)
