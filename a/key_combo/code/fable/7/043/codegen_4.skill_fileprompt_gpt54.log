+
+def _translation_sets(coords: np.ndarray, dir_: tuple[int, int], shape: tuple[int, int]):
+    h, w = shape
+    dr, dc = dir_
+    result = []
+    for step in range(1, max(h, w) + 1):
+        moved = coords + step * np.array([dr, dc], dtype=int)
+        rr = moved[:, 0]
+        cc = moved[:, 1]
+        if rr.min() < 0 or rr.max() >= h or cc.min() < 0 or cc.max() >= w:
