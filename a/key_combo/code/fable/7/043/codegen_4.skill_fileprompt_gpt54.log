+    inp = np.full((h, w), BLACK, dtype=int)
+    inp[top : top + outer_h, left : left + outer_w] = BLUE
+
+    carved: set[tuple[int, int]] = set()
+    pocket_count = random.randint(*POCKET_COUNT_RANGE)
+    for side in _side_sequence(pocket_count):
+        placed = False
+        for _ in range(80):
