+        r0 = max(0, rr - 1)
+        r1 = min(h, rr + 2)
+        c0 = max(0, cc - 1)
+        c1 = min(w, cc + 2)
+        if np.any(mask[r0:r1, c0:c1]):
+            return False
+    return True
+
+
+def _place_shape(grid: np.ndarray, mask: np.ndarray, color: int, shape: tuple[tuple[int, int], ...]) -> bool:
+    h, w = grid.shape
+    sh, sw = _shape_bbox(shape)
+    anchors = [(r, c) for r in range(h - sh + 1) for c in range(w - sw + 1)]
