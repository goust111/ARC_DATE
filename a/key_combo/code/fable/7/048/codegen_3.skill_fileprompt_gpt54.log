    out = input_grid.copy()

    # Shoot diagonally up-right, bouncing off left/right walls until exiting the top.
    dr, dc = -1, 1
    while 0 <= r < H and 0 <= c < W:
        out[r, c] = Color.BLUE

        nr = r + dr
        nc = c + dc
        if nr < 0:
            break
        if nc < 0 or nc >= W:
            dc = -dc
            nc = c + dc
        r, c = nr, nc

    return out


def generate_input():
    width, height = np.random.randint(2, 15), np.random.randint(10, 30)
    grid = np.full((width, height), Color.BLACK)
    grid[0,-1] = Color.BLUE

    return grid
