+
+def _enumerate_candidates(grid: np.ndarray, exterior: np.ndarray, labels: np.ndarray) -> dict[tuple[str, int], list[Candidate]]:
+    h, w = grid.shape
+    pools: dict[tuple[str, int], list[Candidate]] = {}
+    for key in [("open", 0), ("wall", 0), ("oob", 0)]:
