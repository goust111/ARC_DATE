+def _non_red_exterior(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    queue: deque[Coord] = deque()
+
+    def add(r: int, c: int) -> None:
+        if not _in_bounds(grid.shape, r, c):
+            return
+        if int(grid[r, c]) == RED or exterior[r, c]:
+            return
+        exterior[r, c] = True
+        queue.append((r, c))
+
+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while queue:
+        r, c = queue.popleft()
+        for rr, cc in _neighbors4(r, c):
+            add(rr, cc)
+
+    return exterior
+
+
+def _label_regions(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    label = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            label += 1
+            labels[r, c] = label
+            queue: deque[Coord] = deque([(r, c)])
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = label
+                        queue.append((nr, nc))
