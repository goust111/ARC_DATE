+    bounces: list[tuple[int, int, int]] = []
+    r, c = int(start_r), int(start_c)
+    step_dc = int(dc)
+
+    while True:
+        nr = r - 1
+        if nr < 0:
+            return visited, bounces, "top"
+
+        nc = c + step_dc
+        if nc == 0 or nc == width - 1:
