+        if wall_col == 0:
+            left_wall[row] = BLACK
+        else:
+            right_wall[row] = BLACK
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(10, 24)
+    width = random.randint(6, 12)
+
+    start_r = random.randint(max(5, height // 2), height - 2)
+    start_c = random.randint(1, width - 2)
