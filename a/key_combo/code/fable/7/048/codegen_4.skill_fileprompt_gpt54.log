+
+
+def _restoration_mask(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    passable = grid != RED
+    red_mask = grid == RED
+    restore = np.zeros((h, w), dtype=bool)
+    for comp in _bool_components(passable):
