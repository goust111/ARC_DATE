+    for r, c in coords:
+        rr = int(r) % period_r
+        cc = int(c) % period_c
+        color = int(grid[r, c])
+        if seen[rr, cc]:
+            if int(tile[rr, cc]) != color:
+                return None
+        else:
+            tile[rr, cc] = color
+            seen[rr, cc] = True
+    if not bool(np.all(seen)):
