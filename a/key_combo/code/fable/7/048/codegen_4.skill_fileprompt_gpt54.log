+
+
+def _tile_to_grid(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    out = np.empty((h, w), dtype=int)
+    tr, tc = tile.shape
+    for r in range(h):
