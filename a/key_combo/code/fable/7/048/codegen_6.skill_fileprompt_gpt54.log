+    pr, pc = pivot
+    rotated = set()
+    for r, c in points:
+        dr, dc = r - pr, c - pc
+        nr_off, nc_off = _rotate_offset(dr, dc, steps)
+        rotated.add((pr + nr_off, pc + nc_off))
+    return rotated
+
+
