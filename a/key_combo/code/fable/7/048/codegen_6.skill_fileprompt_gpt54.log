+    frame |= {(r1, c) for c in range(c0, c1 + 1)}
+    frame |= {(r, c0) for r in range(r0, r1 + 1)}
+    frame |= {(r, c1) for r in range(r0, r1 + 1)}
+    return frame
+
+
