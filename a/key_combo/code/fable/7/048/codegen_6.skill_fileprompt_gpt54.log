+    rotated = set()
+    for r, c in points:
+        dr, dc = r - pr, c - pc
+        nr_off, nc_off = _rotate_offset(dr, dc, steps)
+        rotated.add((pr + nr_off, pc + nc_off))
+    return rotated
+
+
+def _all_in_bounds(shape: tuple[int, int], points: set[Coord]) -> bool:
+    return all(_in_bounds(shape, r, c) for r, c in points)
+
+
