+        mask[corner_r : corner_r + vert_len, corner_c] = True
+    else:
+        mask[corner_r + vert_len - 1 : corner_r + vert_len, corner_c : corner_c + hor_len] = True
+        mask[corner_r : corner_r + vert_len, corner_c + hor_len - 1] = True
+
