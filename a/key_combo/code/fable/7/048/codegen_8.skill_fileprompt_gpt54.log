+        mask[corner_r, corner_c : corner_c + hor_len] = True
+    elif orientation == "dl":
+        mask[corner_r : corner_r + vert_len, corner_c + hor_len - 1] = True
+        mask[corner_r, corner_c : corner_c + hor_len] = True
+    elif orientation == "ur":
