+    sprite_rotations = [0]
+    sprite_rotations.extend(random.randrange(4) for _ in range(object_count - 1))
+    if object_count > 1 and all(rot == 0 for rot in sprite_rotations):
+        sprite_rotations[random.randrange(1, object_count)] = random.choice((1, 2, 3))
