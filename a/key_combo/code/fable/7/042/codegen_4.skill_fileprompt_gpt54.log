+    for r0 in range(H - h + 1):
+        for c0 in range(W - w + 1):
+            rr0 = max(0, r0 - gap)
+            cc0 = max(0, c0 - gap)
+            rr1 = min(H, r0 + h + gap)
+            cc1 = min(W, c0 + w + gap)
+            if occupied[rr0:rr1, cc0:cc1].any():
