+        mirrored = np.fliplr(sprite_shape)
+        for j, hole_shape in enumerate(hole_shapes):
+            if i != j and mirrored.shape == hole_shape.shape and np.array_equal(mirrored, hole_shape):
+                return True
+    return False
+
