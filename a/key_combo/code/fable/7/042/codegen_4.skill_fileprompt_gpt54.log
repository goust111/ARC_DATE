+def _find_sprites(grid: np.ndarray, bg: int, frame_mask: np.ndarray) -> list[dict]:
+    fg = (grid != bg) & ~frame_mask
+    lab, n = label(fg, structure=STRUCT4)
+    sprites: list[dict] = []
+    for k in range(1, int(n) + 1):
+        comp = lab == k
+        box = bbox(comp)
+        if box is None:
+            continue
+        r0, c0, r1, c1 = box
+        mask = comp[r0 : r1 + 1, c0 : c1 + 1].copy()
