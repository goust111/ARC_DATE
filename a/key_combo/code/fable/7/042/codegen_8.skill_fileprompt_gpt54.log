+            color = rng.choice(free_colors)
+        else:
+            color = rng.choice(chain)
+        hole_count = rng.randint(0, min(4, edge_count + 1))
+        specs.append((color, hole_count))
+
+    if all(holes > 0 for _, holes in specs):
+        color, _ = specs[-1]
+        specs[-1] = (color, 0)
+    if all(holes == 0 for _, holes in specs):
