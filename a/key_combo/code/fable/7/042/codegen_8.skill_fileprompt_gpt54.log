    rect = mask[r0 : r1 + 1, c0 : c1 + 1]
    assert bool(np.all(rect))
    assert int(mask.sum()) == int(rect.size)
    assert len(components_mask(mask, connectivity=4)) == 1

    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    for r in range(r0, r1 + 1):
