+def _is_template_panel(panel: np.ndarray, bg: int) -> bool:
+    fg = panel != bg
+    if int(fg.sum()) < 2:
+        return False
+    colors = np.unique(panel[fg])
+    if len(colors) != 1:
+        return False
+    if not _has_adjacent_pair(fg):
