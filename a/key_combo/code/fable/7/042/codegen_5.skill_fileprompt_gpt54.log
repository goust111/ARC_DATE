def _symmetry_coords(r: int, c: int, n: int) -> tuple[tuple[int, int], ...]:
    last = n - 1
    return (
        (r, c),
        (r, last - c),
        (last - r, c),
        (last - r, last - c),
        (c, r),
        (last - c, last - r),
        (c, last - r),
        (last - c, r),
    )


