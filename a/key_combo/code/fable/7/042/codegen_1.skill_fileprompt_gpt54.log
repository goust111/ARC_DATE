+    assert g.ndim == 2, "expected a 2D grid"
+    h, w = map(int, g.shape)
+    assert 1 <= h <= 30 and 1 <= w <= 30, "grid must satisfy ARC size bounds"
+    assert w % 2 == 0, "expected an even-width grid"
