+def _cell_slice(index: int, cell_size: int) -> tuple[slice, slice]:
+    br, bc = SPIRAL_ORDER[index]
+    r0 = br * (cell_size + 1)
+    c0 = bc * (cell_size + 1)
+    return slice(r0, r0 + cell_size), slice(c0, c0 + cell_size)
+
