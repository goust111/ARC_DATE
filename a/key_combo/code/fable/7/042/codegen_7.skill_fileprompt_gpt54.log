+import numpy as np
+
+
+BACKGROUND = 0
+ANCHOR_COLOR = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+GRID_SIZE_RANGE = (14, 26)
+ANCHOR_DISTANCE_MIN = 6
+RING_COUNT_OPTIONS = ((1, 2), (2, 1), (2, 2), (1, 3), (3, 1), (2, 3), (3, 2))
+MIN_VISIBLE_RING_CELLS = 5
+MAX_VISIBLE_RING_CELLS = 36
+TARGET_COVERAGE_RANGE = (0.10, 0.42)
