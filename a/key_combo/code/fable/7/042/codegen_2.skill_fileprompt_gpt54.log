+def _arm_clear(gray_points: set[tuple[int, int]], start: tuple[int, int], end: tuple[int, int]) -> bool:
+    segment = _segment(start, end)
+    assert segment is not None
+    return all(cell not in gray_points for cell in segment[1:-1])
