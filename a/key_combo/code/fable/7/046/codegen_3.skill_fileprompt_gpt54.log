+        segments.append((start, end))
+
+    blocked_col = cascade_col - 1
+    if blocked_col < wall_specs[0][1]:
+        blocked_col = cascade_col + 1
+    if not (wall_specs[0][1] <= blocked_col <= wall_specs[0][2]) or blocked_col == cascade_col:
