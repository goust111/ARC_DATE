+        wall_specs.append((wall_rows[3], seg[0], seg[1], extra_col, gate_colors[3]))
+
+    grid = np.zeros((height, width), dtype=int)
+    segments = []
+    for row, start, end, gate_col, gate_color in wall_specs:
