+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    gate_mask = _find_gate_mask(g)
+    particle_mask = (g != BG) & (g != WALL) & ~gate_mask
+
+    static = g.copy()
+    static[particle_mask] = BG
+    out = static.copy()
+
+    meta: list[dict[str, int]] = []
+    h, w = g.shape
+    for c in range(w):
