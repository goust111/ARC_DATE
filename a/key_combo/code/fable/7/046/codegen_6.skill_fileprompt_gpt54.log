def _gen_source_colors(g: np.ndarray, bg: int, wall: int) -> list[int]:
    colors: list[int] = []
    seen = {int(bg), int(wall)}
    for raw in g.ravel():
        color = int(raw)
        if color not in seen:
            seen.add(color)
            colors.append(color)
    return colors

