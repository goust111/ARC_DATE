+                top,
+                left,
+                height,
+                width,
+                bg,
+                outline_color,
+                core_colors[i][j],
+                gap_dirs[i][j],
+            )
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if out.shape != (rows, cols):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
