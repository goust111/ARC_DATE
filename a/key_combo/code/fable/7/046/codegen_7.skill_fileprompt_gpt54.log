        fill = 2 if touches_edge else 5
        out[coords[:, 0], coords[:, 1]] = fill
        edge_components += int(touches_edge)
        enclosed_components += int(not touches_edge)

    assert edge_components > 0
    assert enclosed_components > 0
    return out

