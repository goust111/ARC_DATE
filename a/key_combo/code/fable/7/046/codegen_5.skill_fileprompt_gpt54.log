10: def main(grid: np.ndarray) -> np.ndarray:
11:     """
12:     Compact every non-background pixel downward within its own column.
13: 
14:     Input structure:
15:     - A rectangular 2D grid has one dominant background color.
16:     - Foreground pixels are sparse cells whose columns are independent.
17: 
18:     Rule:
19:     - For each column, read the non-background pixels from top to bottom.
20:     - Clear the column to background, then write those pixels into the bottom
21:       cells of that same column, preserving their read order.
22: 
23:     Key insight:
24:     - This is stable vertical gravity: pixels fall straight down without changing
25:       columns or crossing each other.
26:     """
27:     g = np.asarray(grid, dtype=int)
28:     assert g.ndim == 2, "expected a 2D grid"
29: 
30:     bg = get_bg(g)
31:     height, width = map(int, g.shape)
32:     out = np.full_like(g, bg)
33: 
34:     for col in range(width):
35:         values = g[:, col][g[:, col] != bg]
36:         out[height - values.size :, col] = values
37: 
38:     return out
