+        for r in range(h - 1, -1, -1):
+            cell = int(settled[r, c])
+            if cell == BLACK:
+                has_enclosed_below = has_enclosed_below or bool(enclosed[r, c])
+            elif cell != GREEN and has_enclosed_below:
