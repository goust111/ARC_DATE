+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < box_h and 0 <= nc < box_w and not mask[nr, nc]:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        nr, nc = random.choice(frontier)
+        mask[nr, nc] = True
