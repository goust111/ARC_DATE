+def _surface_rows(terrain: np.ndarray) -> np.ndarray:
+    h, w = map(int, terrain.shape)
+    surface = np.full(w, h, dtype=int)
+    for c in range(w):
+        green_rows = np.flatnonzero(terrain[:, c] == GREEN)
+        if green_rows.size:
