+    h, w = map(int, g.shape)
+    out = np.zeros_like(g)
+    out[g == GREEN] = GREEN
+
+    for c in range(w):
+        blockers = np.flatnonzero(g[:, c] == GREEN).tolist()
+        bounds = [-1, *blockers, h]
+        for lo, hi in zip(bounds, bounds[1:]):
+            start = lo + 1
+            stop = hi
+            if start >= stop:
+                continue
+            falling = [
+                int(g[r, c])
+                for r in range(stop - 1, start - 1, -1)
+                if int(g[r, c]) not in (BLACK, GREEN)
+            ]
+            dest = stop - 1
