+def _carve_cavities(grid: np.ndarray, heights: np.ndarray) -> np.ndarray | None:
+    out = grid.copy()
+    h, w = map(int, out.shape)
+    used = np.zeros((h, w), dtype=bool)
+    target_cavities = random.randint(1, min(MAX_CAVITIES, max(1, w // 6)))
+    carved = 0
