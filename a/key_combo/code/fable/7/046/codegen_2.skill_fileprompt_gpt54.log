BORDER_STYLE_HORIZONTAL, BORDER_STYLE_VERTICAL = 0, 1
BORDER_L_CORNER_COUNT, BORDER_L_ARC_HIGH_OFFSET = 4, 3
BINARY_CHOICE_COUNT = 2
# Corridor row/column sampling.
