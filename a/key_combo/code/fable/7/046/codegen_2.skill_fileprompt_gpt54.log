+
+BLACK = 0
+GREEN = 3
+GREY = 5
+FALLING_COLORS = (1, 2, 4, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+MIN_H = 15
+MAX_H = 24
+MIN_W = 12
+MAX_W = 22
+MIN_TERRAIN = 3
+MAX_TERRAIN = 9
+MAX_CAVITIES = 3
