+def _rotate_rel(rel: list[Coord], turns: int) -> list[Coord]:
+    turns %= 4
+    out: list[Coord] = []
+    for dr, dc in rel:
+        if turns == 0:
+            out.append((dr, dc))
+        elif turns == 1:
+            out.append((dc, -dr))
+        elif turns == 2:
+            out.append((-dr, -dc))
+        else:
+            out.append((-dc, dr))
+    return out
