+
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if not mask[r, c] and not visited[r, c]:
+                visited[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
