GRID_SIZE, BACKGROUND_COLOR = 10, 0
FOREGROUND_COLORS = np.arange(1, 10)
# Rectangle sampling ranges, inclusive.
RECT_COUNT_MIN, RECT_COUNT_MAX = 3, 4
RECT_HEIGHT_MIN, RECT_HEIGHT_MAX = 1, 5
RECT_WIDTH_MIN, RECT_WIDTH_MAX = 1, 4
