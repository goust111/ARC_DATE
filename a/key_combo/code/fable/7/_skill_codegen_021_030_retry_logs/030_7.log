+        visible.sort(key=lambda item: (item[1], item[0][0], item[0][1]))
+        best_dist = visible[0][1]
+        assert sum(1 for _coord, dist in visible if dist == best_dist) == 1, "nearest visible target must be unique"
+        target = visible[0][0]
+
+        steps.append(
