+    return all(int(grid[r, c]) == BACKGROUND for r, c in _exclusive_segment(a, b))
+
+
+def _parse_grid(grid: np.ndarray) -> tuple[np.ndarray, int, int, Coord]:
+    g = np.asarray(grid, dtype=int)
