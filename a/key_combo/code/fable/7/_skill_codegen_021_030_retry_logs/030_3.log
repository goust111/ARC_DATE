+_MIN_SIDE = 11
+_MAX_SIDE = 18
+_MIN_VISIBLE_PIXELS = 2
+_MIN_LINE_LENGTH = 4
+_MAX_ATTEMPTS = 400
+_SYMMETRIES = (
+    "id",
