+            continue
+        if _line_length((h, w), "U", total) < _MIN_LINE_LENGTH:
+            continue
+        candidates.append(int(total))
+    return candidates
+
+
+def _candidate_top_sum_values(
+    h: int,
+    w: int,
+    rt: int,
+    ct: int,
+    r2: int,
+    lower_total: int,
+) -> list[int]:
+    diff = rt - ct
+    candidates = []
