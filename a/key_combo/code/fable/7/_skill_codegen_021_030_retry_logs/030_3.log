+    "rot180",
+    "rot270",
+    "flip_lr",
+    "flip_ud",
+    "transpose",
+    "anti",
+)
+
+
+def _apply_symmetry(grid: np.ndarray, symmetry: str) -> np.ndarray:
+    if symmetry == "id":
+        return grid.copy()
+    if symmetry == "rot90":
+        return np.rot90(grid, 1).copy()
+    if symmetry == "rot180":
+        return np.rot90(grid, 2).copy()
+    if symmetry == "rot270":
+        return np.rot90(grid, 3).copy()
+    if symmetry == "flip_lr":
