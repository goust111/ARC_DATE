import random, itertools
import numpy as np

BLUE=1
RED=2
BG=0

def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[np.argmax(counts)])

def extract(g):
    H,W=g.shape; bg=get_bg(g)
    left_hits={}; right_hits={}; top_hits={}; bottom_hits={}; full_rows=set(); full_cols=set()
    for r in range(H):
        if g[r,0]"'!=bg:
            c=0
            while c<W and g[r,c]!=bg: c+=1
            if c==W: full_rows.add(r)
            else: left_hits[r]=c
        if g[r,W-1]!=bg:
            c=W-1
            while c>=0 and g[r,c]!=bg: c-=1
            if c<0: full_rows.add(r)
            else: right_hits[r]=c
    for c in range(W):
        if g[0,c]!=bg:
            r=0
            while r<H and g[r,c]!=bg: r+=1
            if r==H: full_cols.add(c)
            else: top_hits[c]=r
        if g[H-1,c]!=bg:
            r=H-1
            while r>=0 and g[r,c]!=bg: r-=1
            if r<0: full_cols.add(c)
            else: bottom_hits[c]=r
    return dict(H=H,W=W,bg=bg,left_hits=left_hits,right_hits=right_hits,top_hits=top_hits,bottom_hits=bottom_hits,full_rows=full_rows,full_cols=full_cols)

def intersects(a,b):
    return not (a[2]<b[0] or b[2]<a[0] or a[3]<b[1] or b[3]<a[1])

def covers_row(rect,r): return rect[0]<=r<=rect[2]
def covers_col(rect,c): return rect[1]<=c<=rect[3]

def expected_left(rects,r):
    xs=[rect[1] for rect in rects if covers_row(rect,r)]
    return None if not xs else min(xs)

def expected_right(rects,r):
    xs=[rect[3] for rect in rects if covers_row(rect,r)]
    return None if not xs else max(xs)

def expected_top(rects,c):
    xs=[rect[0] for rect in rects if covers_col(rect,c)]
    return None if not xs else min(xs)

def expected_bottom(rects,c):
    xs=[rect[2] for rect in rects if covers_col(rect,c)]
    return None if not xs else max(xs)

def candidates(ev):
    lefts=sorted(set(ev['"'left_hits'].values())); rights=sorted(set(ev['right_hits'].values()))
    tops=sorted(set(ev['top_hits'].values())); bottoms=sorted(set(ev['bottom_hits'].values()))
    out=[]
    for r0 in tops:
      for r1 in bottoms:
        if r1<r0: continue
        rows=range(r0,r1+1)
        if any(r in ev['full_rows'] for r in rows):
            continue
        for c0 in lefts:
          for c1 in rights:
            if c1<c0: continue
            cols=range(c0,c1+1)
            if any(c in ev['full_cols'] for c in cols):
                continue
            if not any(rr in ev['left_hits'] and ev['left_hits'][rr]==c0 for rr in rows): continue
            if not any(rr in ev['right_hits'] and ev['right_hits'][rr]==c1 for rr in rows): continue
            if not any(cc in ev['top_hits'] and ev['top_hits'][cc]==r0 for cc in cols): continue
            if not any(cc in ev['bottom_hits'] and ev['bottom_hits'][cc]==r1 for cc in cols): continue
            out.append((r0,c0,r1,c1))
    return sorted(set(out))

def solve(g):
    ev=extract(g)
    rects=candidates(ev)
    sols=[]
    for a,b in itertools.combinations(rects,2):
        if intersects(a,b):
            continue
        ok=True
        pair=(a,b)
        for r,c0 in ev['left_hits'].items():
            if expected_left(pair,r)"'!=c0: ok=False; break
        if ok:
          for r,c1 in ev['"'right_hits'].items():
            if expected_right(pair,r)"'!=c1: ok=False; break
        if ok:
          for c,r0 in ev['"'top_hits'].items():
            if expected_top(pair,c)"'!=r0: ok=False; break
        if ok:
          for c,r1 in ev['"'bottom_hits'].items():
            if expected_bottom(pair,c)"'!=r1: ok=False; break
        if ok:
          for r in ev['"'full_rows']:
            if expected_left(pair,r) is not None or expected_right(pair,r) is not None: ok=False; break
        if ok:
          for c in ev['full_cols']:
            if expected_top(pair,c) is not None or expected_bottom(pair,c) is not None: ok=False; break
        if ok: sols.append(pair)
    return sols

def draw(inp, rects, rowsL, rowsR, colsT, colsB, color=RED):
    H,W=inp.shape
    for r in rowsL:
        c=min(rect[1] for rect in rects if rect[0]<=r<=rect[2]) if any(rect[0]<=r<=rect[2] for rect in rects) else W
        inp[r,:c]=color
    for r in rowsR:
        c=max(rect[3] for rect in rects if rect[0]<=r<=rect[2]) if any(rect[0]<=r<=rect[2] for rect in rects) else -1
        inp[r,c+1:]=color
    for c in colsT:
