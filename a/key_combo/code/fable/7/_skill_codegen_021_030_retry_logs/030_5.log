+    right_hits: dict[int, int] = {}
+    top_hits: dict[int, int] = {}
+    bottom_hits: dict[int, int] = {}
+    full_rows: set[int] = set()
+    full_cols: set[int] = set()
+
+    for r in range(h):
+        if g[r, 0] != bg:
+            c = 0
+            while c < w and g[r, c] != bg:
+                c += 1
+            if c == w:
+                full_rows.add(r)
+            else:
+                left_hits[r] = c
+        if g[r, w - 1] != bg:
+            c = w - 1
+            while c >= 0 and g[r, c] != bg:
