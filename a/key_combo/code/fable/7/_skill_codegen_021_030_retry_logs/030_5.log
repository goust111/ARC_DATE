        inp[:r,c]=color
    for c in colsB:
        r=max(rect[2] for rect in rects if rect[1]<=c<=rect[3]) if any(rect[1]<=c<=rect[3] for rect in rects) else -1
        inp[r+1:,c]=color
    return inp

# construct one sample
