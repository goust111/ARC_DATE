+        occupancy = patch != bg
+        masks.append(
+            {
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "center_r": int(r0 + 1),
+                "patch": patch.copy(),
+                "occupancy": occupancy,
