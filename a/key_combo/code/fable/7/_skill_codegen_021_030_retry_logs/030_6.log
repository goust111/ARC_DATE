+
+def _build_mask_catalog() -> dict[int, list[np.ndarray]]:
+    catalog = {1: [], 2: [], 3: [], 4: []}
+    seen = {k: set() for k in catalog}
+    for bits in range(1 << (MASK_SIZE * MASK_SIZE)):
+        mask = np.array([(bits >> i) & 1 for i in range(9)], dtype=bool).reshape(MASK_SIZE, MASK_SIZE)
+        if not mask[1, 1]:
+            continue
+        area = int(mask.sum())
+        if not 5 <= area <= 7:
