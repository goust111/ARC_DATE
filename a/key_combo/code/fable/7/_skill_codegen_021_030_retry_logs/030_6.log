+    bg = int(get_bg(g))
+    palette = _palette_from_top_row(g, bg)
+    assert len(set(map(int, g[1]))) == 1
+
+    main_area = g[2:]
+    masks = _extract_masks(main_area, bg)
+    centers = [item["center_r"] for item in masks]
+    bands = _band_ranges(main_area.shape[0], centers)
