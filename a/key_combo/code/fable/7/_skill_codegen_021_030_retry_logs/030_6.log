+    parsed_ks = [_corner_count(item["occupancy"]) for item in parsed_masks]
+    if parsed_ks != ks:
+        return None
+    if any(not np.any(grid[2 + r0 : 2 + r1 + 1, :] == GREY) for r0, r1 in bands):
