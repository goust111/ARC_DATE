+    if not np.any(main_area == GREY):
+        return None
+
+    grid = np.full((main_h + 2, width), BG, dtype=int)
+    grid[0, :PALETTE_LEN] = np.array(palette, dtype=int)
+    grid[1, :] = int(separator)
