+    used_paths = [required_trace["path_set"]]
+
+    extras = [marker for marker in candidates if marker != required_marker and marker in traces]
+    extras.sort(
+        key=lambda marker: (
+            traces[marker]["teleports"],
+            len(traces[marker]["path"]),
+            marker,
