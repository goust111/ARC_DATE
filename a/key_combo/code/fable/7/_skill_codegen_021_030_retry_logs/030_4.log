            marker = (ar + 1 + length, col)
            endpoint = (ar + ANCHOR_SIZE, col)
        elif side == "left":
            row = int(np.random.choice([ar, ar + 1]))
            marker = (row, ac - length)
            endpoint = (row, ac - 1)
        else:
