+def _render_base_grid(H: int, W: int, bg: int, squares: list[dict]) -> np.ndarray:
+    grid = np.full((H, W), int(bg), dtype=int)
+    for square in squares:
+        r0, c0, r1, c1 = _square_bbox(square)
+        grid[r0 : r1 + 1, c0 : c1 + 1] = int(square["color"])
+    return grid
