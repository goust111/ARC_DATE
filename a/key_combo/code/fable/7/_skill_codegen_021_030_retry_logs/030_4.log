+def _choose_markers(
+    base: np.ndarray,
+    marker_color: int,
+    required_marker: tuple[int, int],
+    target_marker_count: int,
+    required_mode: str,
+) -> list[tuple[int, int]] | None:
+    try:
+        bg, _mc, squares, by_color, _markers, _traces = _analyze_grid(
+            np.where(base == marker_color, int(get_bg(base)), base)
+        )
+    except Exception:
