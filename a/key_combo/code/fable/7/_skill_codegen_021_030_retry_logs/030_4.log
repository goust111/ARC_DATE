+        cells = (
+            [(r, c0 - 1) for r in range(r0, r1 + 1)]
+            + [(r, c1 + 1) for r in range(r0, r1 + 1)]
+            + [(r0 - 1, c) for c in range(c0, c1 + 1)]
+            + [(r1 + 1, c) for c in range(c0, c1 + 1)]
