+
+
+def _gap_ok(r0: int, c0: int, placed: list[dict]) -> bool:
+    r1 = r0 + 2
+    c1 = c0 + 2
+    for square in placed:
+        sr0, sc0, sr1, sc1 = _square_bbox(square)
