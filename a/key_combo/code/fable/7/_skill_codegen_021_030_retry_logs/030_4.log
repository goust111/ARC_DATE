+
+def _candidate_markers(base: np.ndarray, squares: list[dict]) -> list[tuple[int, int]]:
+    H, W = base.shape
+    out: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for square in squares:
