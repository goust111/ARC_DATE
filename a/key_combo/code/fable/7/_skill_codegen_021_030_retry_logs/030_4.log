+            int(comp["area"]) == 9
+            and bbox_h(comp["bbox"]) == 3
+            and bbox_w(comp["bbox"]) == 3
+            and np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color)
+        ):
