+    return True
+
+
+def _place_square(
+    color: int,
+    r0: int,
+    c0: int,
+    H: int,
+    W: int,
+    placed: list[dict],
+) -> dict | None:
+    if not (1 <= r0 <= H - 4 and 1 <= c0 <= W - 4):
