+        for r, c in cells:
+            if not (0 <= r < H and 0 <= c < W):
+                continue
+            if int(base[r, c]) != int(get_bg(base)):
+                continue
+            hits = _adjacent_hits(r, c, squares)
+            if len(hits) == 1 and (r, c) not in seen:
+                seen.add((r, c))
+                out.append((int(r), int(c)))
+    random.shuffle(out)
+    return out
