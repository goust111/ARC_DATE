+    er0, ec0, er1, ec1 = _square_bbox(entry_square)
+    xr0, xc0, xr1, xc1 = _square_bbox(exit_square)
+
+    if direction == (0, 1):
+        offset = r - er0
+        return xr0 + offset, xc1 + 1
+    if direction == (0, -1):
+        offset = r - er0
+        return xr0 + offset, xc0 - 1
+    if direction == (1, 0):
+        offset = c - ec0
+        return xr1 + 1, xc0 + offset
+    assert direction == (-1, 0)
+    offset = c - ec0
+    return xr0 - 1, xc0 + offset
