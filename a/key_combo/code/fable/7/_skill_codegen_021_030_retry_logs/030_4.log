+
+def _square_bbox(square: dict) -> tuple[int, int, int, int]:
+    return square["bbox"]
+
+
+def _portal_squares(grid: np.ndarray, bg: int) -> list[dict]:
+    portals: list[dict] = []
+    for comp in find_components(
+        grid,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
