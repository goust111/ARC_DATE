        out[start : end + 1, 0] = color
        out[start : end + 1, _GEN_W - 1] = color
        out[row, :] = color
        if start == 0:
            out[0, :] = color
        if end == _GEN_H - 1:
            out[_GEN_H - 1, :] = color
        start = end + 1
    return out


def _gen_attempt() -> np.ndarray | None:
    n = int(np.random.randint(_GEN_MARKER_COUNT_MIN, _GEN_MARKER_COUNT_MAX_EXCLUSIVE))
    configs = _GEN_CONFIGS_BY_N[n]
    if not configs:
