from itertools import combinations
from collections import defaultdict, deque
base=(2,3); sup=(2,3,4)
MAX_H=4; MAX_W=5; MAX_AREA=9

def connected(cells):
    cells=set(cells)
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (rr,cc) in cells and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(cells)

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    s=sorted((r-r0,c-c0) for r,c in cells)
    h=max(r for r,c in s)+1; w=max(c for r,c in s)+1
    return tuple(s), h, w

def solve(cells, lengths):
    cells=set(cells); h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1
    occ=[r*w+c for r,c in cells]; cand=[]; by=defaultdict(list)
    for r,c in cells:
        for L in lengths:
            if all((r,cc) in cells for cc in range(c,c+L)):
                bits=0
                for cc in range(c,c+L): bits|=1<<(r*w+cc)
                idx=len(cand); cand.append((bits,'h',L,tuple((r,cc) for cc in range(c,c+L))))
                for cc in range(c,c+L): by[r*w+cc].append(idx)
            if all((rr,c) in cells for rr in range(r,r+L)):
                bits=0
                for rr in range(r,r+L): bits|=1<<(rr*w+c)
                idx=len(cand); cand.append((bits,'v',L,tuple((rr,c) for rr in range(r,r+L))))
                for rr in range(r,r+L): by[rr*w+c].append(idx)
    full=0
    for i in occ: full|=1<<i
    memo={}
    def rec(state):
        if state==0: return 1,()
        if state in memo: return memo[state]
        opts=None
        for i in occ:
            if not (state>>i)&1: continue
            cur=[k for k in by[i] if cand[k][0]&state==cand[k][0]]
            if not cur: memo[state]=(0,()); return memo[state]
            if opts is None or len(cur)<len(opts): opts=cur
        total=0; sol=()
        for k in opts:
            subc,subs=rec(state "'^ cand[k][0])
            if subc:
                if total==0: sol=(k,)+subs
                total += subc
                if total>2: break
        memo[state]=(min(total,2),sol); return memo[state]
    cnt,sol=rec(full)
    return cnt,[cand[k] for k in sol]

seen=set(); found=0
for h in range(1,MAX_H+1):
  for w in range(1,MAX_W+1):
    allc=[(r,c) for r in range(h) for c in range(w)]
    for area in range(4,min(MAX_AREA,h*w)+1):
      for comb in combinations(allc, area):
        if not connected(comb): continue
        n,hh,ww=norm(comb)
        if n in seen: continue
        seen.add(n)
        c1,sol=solve(n,base)
        c2,_=solve(n,sup)
        if c1==1 and c2>1:
          ors={s[1] for s in sol}
          if ors=={'"'h','v'}:
            print(n, sol)
            found+=1
            if found>=12: raise SystemExit
