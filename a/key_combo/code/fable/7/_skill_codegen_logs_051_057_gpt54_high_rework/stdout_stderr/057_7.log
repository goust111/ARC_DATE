+def _separator_row(grid: np.ndarray) -> int:
+    assert grid.ndim == 2 and grid.shape[0] >= 3
+    sep_r = int(grid.shape[0] - 2)
+    sep_color = int(grid[sep_r, 0])
+    assert bool(np.all(grid[sep_r] == sep_color)), "separator row must be uniform"
+    return sep_r
+
