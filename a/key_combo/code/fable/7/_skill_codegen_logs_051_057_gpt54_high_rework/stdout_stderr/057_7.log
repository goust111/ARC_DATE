from itertools import combinations
from collections import defaultdict, deque

families = [((3,4),(2,3,4)), ((2,5),(2,3,5)), ((3,5),(3,4,5))]
MAX_H=4; MAX_W=5; MAX_AREA=9

def connected(cells):
    cells=set(cells)
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (rr,cc) in cells and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(cells)

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    s=sorted((r-r0,c-c0) for r,c in cells)
    h=max(r for r,c in s)+1; w=max(c for r,c in s)+1
    return tuple(s), h, w

def transforms(cells):
    pts=list(cells)
    out=[]
    for rot in range(4):
        for flip in (False,True):
            cur=[]
            for r,c in pts:
                x,y=r,c
                for _ in range(rot):
                    x,y=y,-x
                if flip:
                    y=-y
                cur.append((x,y))
            out.append(norm(cur)[0])
    return set(out)

def reps():
    seen=set(); out=[]
    for h in range(1,MAX_H+1):
        for w in range(1,MAX_W+1):
            allc=[(r,c) for r in range(h) for c in range(w)]
            for area in range(4,min(MAX_AREA,h*w)+1):
                for comb in combinations(allc, area):
                    if not connected(comb): continue
                    n,h1,w1=norm(comb)
                    key=min(transforms(n))
                    if key in seen: continue
                    seen.add(key); out.append((list(n),h1,w1))
    return out

def count(mask, lengths):
    h=len(mask); w=len(mask[0]); occ=[r*w+c for r in range(h) for c in range(w) if mask[r][c]]
    cand=[]; by=defaultdict(list)
    for r in range(h):
        for c in range(w):
            if not mask[r][c]: continue
            for L in lengths:
                if c+L<=w and all(mask[r][cc] for cc in range(c,c+L)):
                    bits=0
                    for cc in range(c,c+L): bits|=1<<(r*w+cc); by[r*w+cc].append(len(cand))
                    cand.append(bits)
                if r+L<=h and all(mask[rr][c] for rr in range(r,r+L)):
                    bits=0
                    for rr in range(r,r+L): bits|=1<<(rr*w+c); by[rr*w+c].append(len(cand))
                    cand.append(bits)
    full=0
    for i in occ: full|=1<<i
    memo={}
    def rec(state):
        if state==0: return 1
        if state in memo: return memo[state]
        opts=None
        for i in occ:
            if not (state>>i)&1: continue
            cur=[b for b in by[i] if cand[b]&state==cand[b]]
            if not cur:
                memo[state]=0; return 0
            if opts is None or len(cur)<len(opts): opts=cur
        total=0
        for k in opts:
            total += rec(state "'^ cand[k])
            if total>2: break
        memo[state]=min(total,2)
        return memo[state]
    return rec(full)

for base, sup in families:
    print('"'\\nfamily', base, 'vs', sup)
    found=0
    for cells,h,w in reps():
        mask=[[False]*w for _ in range(h)]
        for r,c in cells: mask[r][c]=True
        c1=count(mask, base)
        c2=count(mask, sup)
        if c1==1 and c2>1:
            print(' shape',cells,'base unique, sup',c2)
            found+=1
            if found>=10: break
