from itertools import product, combinations
from collections import defaultdict, deque

# Search small connected masks with unique strip tilings under selected length sets.

LSETS = [(2,3),(2,5),(3,4),(3,5),(4,5),(2,3,4),(2,3,5),(3,4,5)]
MAX_H=4
MAX_W=5
MAX_AREA=9

def connected(cells):
    cells=set(cells)
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        r,c=q.popleft()
        for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (rr,cc) in cells and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(cells)

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    s=sorted((r-r0,c-c0) for r,c in cells)
    h=max(r for r,c in s)+1; w=max(c for r,c in s)+1
    return tuple(s), h, w

def transforms(cells):
    pts=list(cells)
    out=[]
    for rot in range(4):
        for flip in (False,True):
            cur=[]
            for r,c in pts:
                x,y=r,c
                for _ in range(rot):
                    x,y=y,-x
                if flip:
                    y=-y
                cur.append((x,y))
            out.append(norm(cur)[0])
    return set(out)

def unique_reps():
    seen=set()
    reps=[]
    for h in range(1,MAX_H+1):
        for w in range(1,MAX_W+1):
            cells=[(r,c) for r in range(h) for c in range(w)]
            for area in range(4,min(MAX_AREA,h*w)+1):
                for comb in combinations(cells, area):
                    if not connected(comb):
                        continue
                    n,h1,w1=norm(comb)
                    key=min(transforms(n))
                    if key in seen:
                        continue
                    seen.add(key)
                    reps.append((list(n), h1, w1))
    return reps

def solve(mask, lengths):
    h=len(mask); w=len(mask[0])
    occ=[r*w+c for r in range(h) for c in range(w) if mask[r][c]]
    occset=set(occ)
    cand=[]; by=defaultdict(list)
    for r in range(h):
        for c in range(w):
            if not mask[r][c]:
                continue
            for L in lengths:
                if c+L<=w and all(mask[r][cc] for cc in range(c,c+L)):
                    bits=0; cells=[]
                    for cc in range(c,c+L):
                        i=r*w+cc; bits|=1<<i; cells.append((r,cc,'h',L))
                    idx=len(cand); cand.append((bits,'h',L,tuple((r,cc) for cc in range(c,c+L))))
                    for cc in range(c,c+L): by[r*w+cc].append(idx)
                if r+L<=h and all(mask[rr][c] for rr in range(r,r+L)):
                    bits=0
                    for rr in range(r,r+L): bits|=1<<(rr*w+c)
                    idx=len(cand); cand.append((bits,'v',L,tuple((rr,c) for rr in range(r,r+L))))
                    for rr in range(r,r+L): by[rr*w+c].append(idx)
    full=0
    for i in occ: full|=1<<i
    memo={}
    def rec(state):
        if state==0: return 1,()
        if state in memo: return memo[state]
        pivot=None; opts=None
        for i in occ:
            if not (state>>i)&1: continue
            cur=[k for k in by[i] if cand[k][0] & state == cand[k][0]]
            if not cur:
                memo[state]=(0,()); return memo[state]
            if opts is None or len(cur)<len(opts):
                pivot=i; opts=cur
        cnt=0; sol=()
        for k in opts:
            subc,subs=rec(state "'^ cand[k][0])
            if subc:
                if cnt==0: sol=(k,)+subs
                cnt += subc
                if cnt>2: break
        memo[state]=(min(cnt,2),sol)
        return memo[state]
    cnt,sol=rec(full)
    return cnt,[cand[k] for k in sol]

reps=unique_reps()
print('"'reps',len(reps))
for lengths in LSETS:
    print('\\nLSET',lengths)
    found=0
    for cells,h,w in reps:
        mask=[[False]*w for _ in range(h)]
        for r,c in cells: mask[r][c]=True
        cnt,sol=solve(mask,lengths)
        if cnt"'!=1: continue
        lens=sorted(seg[2] for seg in sol)
        if len(sol)>=2 and len(set(lens))>=2:
