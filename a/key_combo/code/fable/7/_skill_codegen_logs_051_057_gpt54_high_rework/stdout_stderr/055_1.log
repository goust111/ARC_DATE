# Canvas and palette bounds.
GRID_HEIGHT_BOUNDS = (9, 10)
GRID_WIDTH_BOUNDS = (9, 10)
BACKGROUND_COLOR = 7
WALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
