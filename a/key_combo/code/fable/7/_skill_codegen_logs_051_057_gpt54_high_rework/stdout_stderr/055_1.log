from __future__ import annotations

from collections import Counter
import random

import numpy as np


BG = 0
PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]

# --------------- shared helpers adapted from arc_utils ---------------


def get_bg(grid: np.ndarray) -> int:
    """Background color = most common value in the grid."""
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
    cols = set(map(int, np.unique(grid)))
    if exclude is not None:
        cols -= set(map(int, exclude))
    return sorted(cols)


def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = map(int, shape)
    return 0 <= int(r) < h and 0 <= int(c) < w


def _neighbors8(r: int, c: int):
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            yield int(r + dr), int(c + dc)


def _mirror_point(orient: str, axis: int, point: tuple[int, int]) -> tuple[int, int]:
    r, c = point
    if orient == "h":
        return 2 * int(axis) - int(r), int(c)
    return int(r), 2 * int(axis) - int(c)


def _score_candidate(candidate: dict) -> tuple[int, int]:
    return int(candidate["pair_count"]), int(candidate["pair_distance_count"])


def _evaluate_axis(
    grid: np.ndarray,
    color: int,
    orient: str,
    axis: int,
    bg: int,
) -> dict | None:
    coords = [tuple(map(int, rc)) for rc in np.argwhere(grid == int(color))]
    coord_set = set(coords)
    if len(coord_set) < 5:
        return None

    pair_keys = set()
    pair_distances = set()
    lonely = []
    targets = []

    for point in coords:
        r, c = point
        if (orient == "h" and r == axis) or (orient == "v" and c == axis):
            return None
        mr, mc = _mirror_point(orient, axis, point)
        if not in_bounds(grid.shape, mr, mc):
            return None
        if (mr, mc) in coord_set:
            pair = tuple(sorted((point, (mr, mc))))
            pair_keys.add(pair)
            pair_distances.add(abs(r - axis) if orient == "h" else abs(c - axis))
        else:
            if int(grid[mr, mc]) != int(bg):
                return None
            lonely.append(point)
            targets.append((mr, mc))

    if len(pair_keys) < 2 or len(pair_distances) < 2 or not lonely:
        return None

    return {
        "orient": orient,
        "axis": int(axis),
        "pairs": sorted(pair_keys),
        "pair_count": int(len(pair_keys)),
        "pair_distance_count": int(len(pair_distances)),
        "pair_distances": tuple(sorted(pair_distances)),
        "lonely": tuple(sorted(lonely)),
        "targets": tuple(sorted(targets)),
    }


def _infer_axis(grid: np.ndarray, color: int, bg: int) -> dict:
    h, w = map(int, grid.shape)
    candidates = []
    for axis in range(h):
        cand = _evaluate_axis(grid, color, "h", axis, bg)
        if cand is not None:
            candidates.append(cand)
    for axis in range(w):
        cand = _evaluate_axis(grid, color, "v", axis, bg)
        if cand is not None:
            candidates.append(cand)

    if not candidates:
        raise AssertionError(f"color {color}: no valid hidden axis")

    best = max(_score_candidate(c) for c in candidates)
    best_candidates = [c for c in candidates if _score_candidate(c) == best]
    if len(best_candidates) != 1:
        raise AssertionError(f"color {color}: hidden axis is ambiguous")
    return best_candidates[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Infer each color's hidden row/column mirror axis and complete its lonely markers.

    Input structure:
    - A black background contains several foreground colors, each appearing only as isolated single pixels.
    - Within one color, most pixels already form mirrored pairs across one hidden full row or one hidden full column.
    - Each color also has one or more lonely pixels whose reflected partner is missing, and different colors may use different axes.

    Rule:
    - Group pixels by color.
    - For each color, infer the unique hidden horizontal or vertical axis from the already paired pixels.
    - Reflect every lonely pixel across that color's axis and paint the missing partner in the same color.
    - Keep all existing pixels unchanged.

    Key insight:
    - The symmetry is not global: color membership identifies which sparse points share an axis, so the axis must be inferred separately inside each color group before any completion is possible.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = int(get_bg(g))
    colors = colors_present(g, exclude={bg})
    assert colors, "expected at least one foreground color"

    out = g.copy()
    for color in colors:
        axis_data = _infer_axis(g, int(color), bg)
        for r, c in axis_data["targets"]:
            assert int(out[r, c]) == bg, "completion targets must be background"
            out[r, c] = int(color)
    return out


# --------------- generator ---------------

GRID_HEIGHT_RANGE = (16, 24)
GRID_WIDTH_RANGE = (16, 24)
COLOR_COUNT_RANGE = (2, 4)
PAIR_COUNT_RANGE = (2, 3)
LONELY_COUNT_RANGE = (1, 3)
MAX_GENERATION_ATTEMPTS = 600


def _reserve(blocked: set[tuple[int, int]], shape: tuple[int, int], point: tuple[int, int]) -> None:
    r, c = point
    for rr, cc in _neighbors8(r, c):
        if in_bounds(shape, rr, cc):
            blocked.add((rr, cc))


def _can_claim(
    blocked: set[tuple[int, int]],
    shape: tuple[int, int],
    points: list[tuple[int, int]],
) -> bool:
    return all(in_bounds(shape, r, c) and (r, c) not in blocked for r, c in points)


def _try_place_color(
    shape: tuple[int, int],
    blocked: set[tuple[int, int]],
    orient: str,
    axis: int,
) -> tuple[list[tuple[int, int]], list[tuple[int, int]], tuple[int, ...]] | None:
    h, w = shape
    line_values = list(range(1, w - 1)) if orient == "h" else list(range(1, h - 1))
    max_dist = min(axis, h - 1 - axis) if orient == "h" else min(axis, w - 1 - axis)
    if max_dist < 2:
        return None

    pair_count = random.randint(PAIR_COUNT_RANGE[0], min(PAIR_COUNT_RANGE[1], max_dist))
    pair_dists = random.sample(range(1, max_dist + 1), pair_count)
    lonely_count = random.randint(LONELY_COUNT_RANGE[0], LONELY_COUNT_RANGE[1])

    local_blocked = set(blocked)
    points: list[tuple[int, int]] = []
    targets: list[tuple[int, int]] = []
    used_lines = set()

    shuffled_lines = line_values[:]
    random.shuffle(shuffled_lines)
    for dist in pair_dists:
        placed = False
        for line in shuffled_lines:
            if line in used_lines:
                continue
            cells = (
                [(axis - dist, line), (axis + dist, line)]
                if orient == "h"
                else [(line, axis - dist), (line, axis + dist)]
            )
            if _can_claim(local_blocked, shape, cells):
                used_lines.add(line)
                for cell in cells:
                    points.append(cell)
                    _reserve(local_blocked, shape, cell)
                placed = True
                break
        if not placed:
            return None

    available_lines = [line for line in line_values if line not in used_lines]
    random.shuffle(available_lines)
    for _ in range(lonely_count):
        placed = False
        for line in available_lines:
            if line in used_lines:
                continue
            dists = list(range(1, max_dist + 1))
            random.shuffle(dists)
            for dist in dists:
                sides = [-1, 1]
                random.shuffle(sides)
                for side in sides:
                    if orient == "h":
                        src = (axis + side * dist, line)
                        dst = (axis - side * dist, line)
                    else:
                        src = (line, axis + side * dist)
                        dst = (line, axis - side * dist)
                    if _can_claim(local_blocked, shape, [src, dst]):
                        used_lines.add(line)
                        points.append(src)
                        targets.append(dst)
                        _reserve(local_blocked, shape, src)
                        _reserve(local_blocked, shape, dst)
                        placed = True
                        break
                if placed:
                    break
            if placed:
                break
        if not placed:
            return None

