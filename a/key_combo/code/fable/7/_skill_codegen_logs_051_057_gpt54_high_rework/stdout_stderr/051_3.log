            for h,w in cands[label]:
                for top in range(max(0,r-h+1), min(r,H-h)+1):
                    for left in range(max(0,c-w+1), min(c,W-w)+1):
                        win=board[top:top+h,left:left+w]
                        if np.any(win>=0): continue
                        win[:]=label
                        used.add(label); rec(used); used.remove(label)
                        win[:]=-1
    rec(set())
    return sols

