+def _unique_masks(dim: tuple[int, int]) -> tuple[np.ndarray, np.ndarray]:
+    h, w = dim
+    assert h >= 2 and w >= 2
+    a = np.zeros((h, w), dtype=bool)
+    a[0, 0] = True
+    a[0, min(1, w - 1)] = True
+    a[min(1, h - 1), 0] = True
+    b = ~a
+    return a, b
 
 
