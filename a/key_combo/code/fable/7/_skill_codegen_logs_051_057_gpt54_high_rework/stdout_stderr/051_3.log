import itertools, numpy as np
DIMS=[(1,2),(1,3),(1,4),(1,5),(2,2),(2,3),(2,4),(2,5),(2,6),(3,2),(3,3),(3,4),(3,5),(4,1),(4,2),(4,3),(4,4),(4,5),(5,1),(5,2),(5,3),(5,4),(6,2)]
AMB={
    (2,3):((2,3),(3,2)),
    (3,2):((2,3),(3,2)),
    (3,4):((3,4),(4,3)),
    (4,3):((3,4),(4,3)),
    (2,6):((2,6),(3,4)),
    (4,5):((4,5),(5,4)),
    (5,4):((4,5),(5,4)),
}

def solve(H,W,cands,limit=3):
    board=np.full((H,W),-1,int); sols=[]; n=len(cands)
    def rec(used):
        if len(sols)>=limit:return
        if len(used)==n:
            if np.all(board>=0): sols.append(board.copy())
            return
        empt=np.argwhere(board<0)
        if len(empt)==0:return
        r,c=map(int,empt[0])
        # order by fewest candidate placements rough
        labels=[label for label in range(n) if label not in used]
        labels.sort(key=lambda label: len(cands[label]))
        for label in labels:
            for h,w in cands[label]:
                for top in range(max(0,r-h+1), min(r,H-h)+1):
                    for left in range(max(0,c-w+1), min(c,W-w)+1):
                        win=board[top:top+h,left:left+w]
                        if np.any(win>=0): continue
                        win[:]=label
                        used.add(label); rec(used); used.remove(label)
                        win[:]=-1
    rec(set()); return sols

for H in range(4,10):
  for W in range(4,10):
    area=H*W
    for k in [3,4,5]:
      for dims in itertools.combinations_with_replacement(DIMS,k):
        if sum(h*w for h,w in dims)"'!=area: continue
        true_sols=solve(H,W,[(d,) for d in dims],limit=2)
        if len(true_sols)!=1: continue
        amb_positions=[i for i,d in enumerate(dims) if d in AMB]
        if not amb_positions: continue
        for i in amb_positions:
          cands=[(d,) for d in dims]
          cands[i]=AMB[dims[i]]
          sols=solve(H,W,cands,limit=3)
          if len(sols)==1:
            print('"'FOUND',H,W,'dims',dims,'amb_idx',i,'amb',cands[i])
            print(sols[0])
            raise SystemExit
