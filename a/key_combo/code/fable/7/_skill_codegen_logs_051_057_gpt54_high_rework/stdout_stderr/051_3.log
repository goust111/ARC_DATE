    _bg2, frame2, by_color2, dims2 = _parse_problem(inp)
    sols2 = _solve_unique_tiling(inner_h, inner_w, dims2, limit=128)
    if not sols2:
        return None
    if not any(len(v) >= 2 for v in dims2.values()):
        return None
    chosen2 = _select_tiling(sols2, by_color2, (r0 + 1, c0 + 1))
    if not np.array_equal(chosen2, true_board):
        return None
    if frame2["bbox"] != frame_bbox or set(by_color2) != set(colors):
        return None

    return inp, out


def generate_input() -> np.ndarray:
    for _ in range(_GEN_ATTEMPTS):
        pair = _build_attempt()
        if pair is not None:
            return pair[0]
    raise RuntimeError("failed to generate a valid two-stage assembly puzzle")

