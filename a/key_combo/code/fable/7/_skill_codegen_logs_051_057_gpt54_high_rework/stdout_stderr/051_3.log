    remove_length = np.random.randint(1, sprite_size//4)
    quadrant = np.random.choice(['north', 'south', 'east', 'west'])
    if quadrant == 'north':
        sprite[sprite_size//2 - remove_length : sprite_size//2 + remove_length, : sprite_size//2] = Color.BLACK
    elif quadrant == 'south':
