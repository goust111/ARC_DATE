import itertools, numpy as np
FAMILIES=[
    ('A',((2,3),(3,2)),[(2,3),(3,2)]),
    ('B',((3,4),(4,3)),[(3,4),(4,3)]),
    ('C',((2,6),(3,4)),[(3,4),(2,6)]),
    ('D',((4,5),(5,4)),[(4,5),(5,4)]),
]
UNIQ=[(2,4),(2,5),(3,3),(3,4),(3,5),(4,2),(4,4),(4,5),(5,3),(5,4),(6,2)]

def solve(H,W,cands,limit=3):
    board=np.full((H,W),-1,int); n=len(cands); sols=[]
    areas=[sorted({h*w for h,w in cand})[0] for cand in cands]
    def rec(used):
        if len(sols)>=limit:return
        if len(used)==n:
            if np.all(board>=0): sols.append(board.copy())
            return
        empt=np.argwhere(board<0)
        if len(empt)==0:return
        r,c=map(int,empt[0])
        # heuristic: try labels with fewest placements
        order=[]
        for label in range(n):
            if label in used: continue
            cnt=0
            for h,w in cands[label]:
                cnt += max(0,min(r,H-h)-max(0,r-h+1)+1) * max(0,min(c,W-w)-max(0,c-w+1)+1)
            order.append((cnt,label))
        for _cnt,label in sorted(order):
            for h,w in cands[label]:
                for top in range(max(0,r-h+1), min(r,H-h)+1):
                    for left in range(max(0,c-w+1), min(c,W-w)+1):
                        win=board[top:top+h,left:left+w]
