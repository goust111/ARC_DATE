    elif quadrant == 'east':
        sprite[: sprite_size//2, sprite_size//2 - remove_length : sprite_size//2 + remove_length] = Color.BLACK
    elif quadrant == 'west':
        sprite[sprite_size//2 :, sprite_size//2 - remove_length : sprite_size//2 + remove_length] = Color.BLACK

    paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)

