import numpy as np
from collections import defaultdict

def neighbors4(r,c):
    return ((r-1,c),(r+1,c),(r,c-1),(r,c+1))

def connected(mask):
    coords=np.argwhere(mask)
    if len(coords)==0:return False
    seen={tuple(coords[0])}; stack=[tuple(coords[0])]
    H,W=mask.shape
    while stack:
        r,c=stack.pop()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==mask.sum()

def bbox_coords(coords):
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def coords_to_mask(coords):
    r0,c0,r1,c1=bbox_coords(coords)
    out=np.zeros((r1-r0+1,c1-c0+1),dtype=bool)
    s=coords-np.array([[r0,c0]])
    out[s[:,0],s[:,1]]=True
    return out

def rect_dims_from_pair(a_coords,b_coords):
    a_mask=coords_to_mask(a_coords); b_mask=coords_to_mask(b_coords)
    a=np.argwhere(a_mask); b=np.argwhere(b_mask)
    total=len(a)+len(b)
    dims=set()
    def placements(cells, rh,rw, shape):
        mh,mw=shape
        if mh>rh or mw>rw:return []
        outs=[]
        for top in range(rh-mh+1):
            for left in range(rw-mw+1):
                idx=(cells[:,0]+top)*rw + (cells[:,1]+left)
                outs.append(frozenset(map(int,idx)))
        return outs
    for rh in range(1,total+1):
        if total%rh: continue
        rw=total//rh
        ap=placements(a,rh,rw,a_mask.shape)
        bp=placements(b,rh,rw,b_mask.shape)
        if not ap or not bp: continue
        if any(x.isdisjoint(y) for x in ap for y in bp):
            dims.add((rh,rw))
    return dims

def is_full_bbox(mask):
    coords=np.argwhere(mask)
    r0,c0,r1,c1=bbox_coords(coords)
    return mask[r0:r1+1,c0:c1+1].all()

best=[]
for h,w in [(3,6),(4,6),(5,6)]:
    area=h*w
    lim=1<<(area-1)
    # sample random subsets instead exhaustive if huge
    import random; random.seed(0)
    seen=set()
    tries=min(20000, lim-1)
    for _ in range(tries):
        bits=random.randrange(1, lim)
        if bits in seen: continue
        seen.add(bits)
        a=np.zeros((h,w),dtype=bool)
        for i in range(area):
            if bits>>i &1:a[i//w,i%w]=1
        b=~a
        if a.sum()<2 or b.sum()<2: continue
        if not connected(a) or not connected(b): continue
        if is_full_bbox(a) or is_full_bbox(b): continue
        dims=tuple(sorted(rect_dims_from_pair(np.argwhere(a),np.argwhere(b))))
        if len(dims)>=3:
            best.append((len(dims),h,w,a.sum(),dims,a.copy(),b.copy()))
    print('done',h,w,'found',len(best))
print('total',len(best))
for item in best[:10]:
    n,h,w,sa,dims,a,b=item
    print('rect',h,w,'A',sa,'dims',dims)
    for mask in [a,b]:
        for row in mask:
            print(''.join('#' if x else '.' for x in row))
        print()
    print('---')
