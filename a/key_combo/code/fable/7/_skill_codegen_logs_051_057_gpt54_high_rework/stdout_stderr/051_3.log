import random, numpy as np
random.seed(0)

# exact solver

def solve(H,W,cands,limit=3):
    board=np.full((H,W),-1,int); sols=[]; n=len(cands)
    areas=[next(iter({h*w for h,w in cand})) for cand in cands]
    if sum(areas)"'!=H*W:return []
    def rec(used):
        if len(sols)>=limit:return
        empt=np.argwhere(board<0)
        if len(empt)==0:
            if len(used)==n: sols.append(board.copy())
            return
        r,c=map(int,empt[0])
        labels=[i for i in range(n) if i not in used]
        labels.sort(key=lambda i:(len(cands[i]), -areas[i]))
        for label in labels:
            for h,w in cands[label]:
                for top in range(max(0,r-h+1), min(r,H-h)+1):
                    for left in range(max(0,c-w+1), min(c,W-w)+1):
                        win=board[top:top+h,left:left+w]
                        if np.any(win>=0): continue
                        win[:]=label
                        used.add(label); rec(used); used.remove(label)
                        win[:]=-1
    rec(set()); return sols

# random guillotine partition

def split_rects(H,W,count):
    rects=[(0,0,H,W)]
    while len(rects)<count:
        opts=[i for i,(r,c,h,w) in enumerate(rects) if h>=2 or w>=2]
        if not opts:return None
        i=random.choice(opts)
        r,c,h,w=rects.pop(i)
        choices=[]
        if h>=2: choices.append('"'h')
        if w>=2: choices.append('w')
        axis=random.choice(choices)
        if axis=='h':
            cut=random.randint(1,h-1)
            rects.extend([(r,c,cut,w),(r+cut,c,h-cut,w)])
        else:
            cut=random.randint(1,w-1)
            rects.extend([(r,c,h,cut),(r,c+cut,h,w-cut)])
    return rects

for trial in range(5000):
    H=random.randint(5,12); W=random.randint(5,12); count=random.randint(4,7)
    rects=split_rects(H,W,count)
    if not rects: continue
    dims=[(h,w) for _,_,h,w in rects]
    if len(set(dims))<len(dims):
        continue  # distinct true dims helps
    true_sols=solve(H,W,[(d,) for d in dims],limit=2)
    if len(true_sols)"'!=1:
        continue
    # candidate ambiguous options: same-area different dims that also fit maybe
    for i,(h,w) in enumerate(dims):
        area=h*w
        alts=[(a,area//a) for a in range(1,area+1) if area%a==0 and (a,area//a)!=(h,w)]
        random.shuffle(alts)
