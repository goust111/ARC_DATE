+def _normalize_coords(coords: np.ndarray | list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    arr = np.asarray(coords, dtype=int)
+    r0 = int(arr[:, 0].min())
+    c0 = int(arr[:, 1].min())
+    shifted = arr - np.array([r0, c0], dtype=int)
+    return tuple(sorted((int(r), int(c)) for r, c in shifted))
