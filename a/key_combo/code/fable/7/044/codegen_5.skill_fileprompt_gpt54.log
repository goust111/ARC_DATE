+        if not np.any(bottom_result) or np.array_equal(bottom_result, bottom_left_panel):
+            continue
+
+        grid = _assemble_grid(
+            top_left_panel,
+            top_mid_panel,
+            top_right_panel,
+            bottom_left_panel,
+            bottom_mid_panel,
+            separator_color=GREY,
