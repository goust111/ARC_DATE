+    row1 = slice(panel_h + 1, panel_h * 2 + 1)
+    col0 = slice(0, panel_w)
+    col1 = slice(panel_w + 1, panel_w * 2 + 1)
+    col2 = slice(panel_w * 2 + 2, panel_w * 3 + 2)
