+        in_right = comp["shape"] in right_shapes
+        keep = in_right if op == "intersection" else not in_right
+        if not keep:
+            continue
+        coords = comp["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(comp["color"])
+    return out
+
