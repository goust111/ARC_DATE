+
+
+def _random_shape(rng: random.Random) -> tuple[tuple[int, int], ...]:
+    target_area = rng.randint(2, 5)
+    for _ in range(80):
+        cells = {(0, 0)}
+        while len(cells) < target_area:
+            frontier = set()
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) not in cells:
