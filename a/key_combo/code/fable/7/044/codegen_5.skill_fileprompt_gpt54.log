+def _transform_shape(shape: tuple[tuple[int, int], ...], rotation: int, reflect: bool) -> tuple[tuple[int, int], ...]:
+    pts = np.array(shape, dtype=int)
+    if reflect:
+        pts = pts[:, [0, 1]]
