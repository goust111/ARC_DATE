  58: def main(grid: np.ndarray) -> np.ndarray:
  59:     """Recolor the unique safe route between the two maroon endpoints from teal to maroon.
  60: 
  61:     Input structure
  62:     - A black background contains a teal 4-connected track, exactly two maroon endpoint pixels, and one or more orange blocker pixels embedded near the track.
  63: 
  64:     Rule
  65:     - Treat each orange blocker and its 8-neighborhood as forbidden.
  66:     - In the remaining teal/maroon track graph, there is exactly one simple
  67:       4-connected path between the maroon endpoints.
  68:     - Recolor teal pixels on that path to maroon; leave endpoints, blockers, and all other cells unchanged.
  69: 
  70:     Key insight
  71:     - The orange pixels block nearby teal cells diagonally as well as orthogonally, which removes shorter decoy routes and makes the intended endpoint-to-endpoint path unique.
  72:     """
  73:     g = np.asarray(grid, dtype=int)
  74:     assert g.ndim == 2
  75:     assert set(map(int, np.unique(g))) <= {
  76:         Color.BLACK,
  77:         Color.ORANGE,
  78:         Color.TEAL,
  79:         Color.MAROON,
  80:     }
  81: 
  82:     endpoints = [tuple(map(int, p)) for p in np.argwhere(g == Color.MAROON)]
  83:     blockers = [tuple(map(int, p)) for p in np.argwhere(g == Color.ORANGE)]
  84:     assert len(endpoints) == 2
  85:     assert blockers
