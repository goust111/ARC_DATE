+
+
+def _sample_distinct_shapes(
+    rng: random.Random,
+    count: int,
+    forbidden: set[tuple[tuple[int, int], ...]] | None = None,
+) -> list[tuple[tuple[int, int], ...]]:
+    forbidden = set() if forbidden is None else set(forbidden)
+    shapes = []
+    used = set(forbidden)
+    while len(shapes) < count:
+        shape = _random_shape(rng)
+        if shape in used:
+            continue
+        used.add(shape)
+        shapes.append(shape)
