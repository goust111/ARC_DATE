+    panel_c, panel_d, panel_blank = panels[1]
+    assert np.all(panel_blank == BLACK), "expected the bottom-right panel to be blank"
+    op = _infer_operation(panel_a, panel_b, panel_r)
+    return _apply_operation(panel_c, panel_d, op)
+
