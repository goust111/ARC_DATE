  14: def main(grid: np.ndarray) -> np.ndarray:
  15:     """
  16:     Recolor every object whose shape matches a teal template object to teal.
  17: 
  18:     Input structure
  19:     - A black-background lattice contains many monochrome connected objects in blue or red.
  20:     - One or more teal objects are already drawn in places where such objects have been recolored.
  21:     - Shape identity is translation-normalized and uses 8-connectivity, so diagonal contact can join one template.
  22: 
  23:     Rule
  24:     - Treat each teal connected object as a shape template.
  25:     - Among non-black, non-teal objects, find the unique source color whose object masks match those teal templates.
  26:     - Recolor every object of that source color with a matching normalized mask to teal; preserve all other pixels.
  27: 
  28:     Key insight
  29:     - The teal pixels are examples of completed objects, not a path or paint source; their masks select all same-shaped objects elsewhere in the lattice.
  30:     """
  31:     g = np.asarray(grid, dtype=int)
  32:     bg = Color.BLACK
  33:     marker = Color.TEAL
  34: 
  35:     template_components = find_components(g, bg=bg, connectivity=8, colors=[marker])
  36:     assert template_components
  37:     template_shapes = {_normalized_mask(comp["coords"]) for comp in template_components}
  38:     assert template_shapes
  39: 
  40:     candidate_colors = colors_present(g, exclude={bg, marker})
  41:     candidate_components = find_components(
  42:         g,
  43:         bg=bg,
  44:         connectivity=8,
  45:         colors=candidate_colors,
  46:     )
  47: 
  48:     matches = [
  49:         comp
  50:         for comp in candidate_components
  51:         if _normalized_mask(comp["coords"]) in template_shapes
  52:     ]
  53:     assert matches
  54: 
  55:     matched_shapes = {_normalized_mask(comp["coords"]) for comp in matches}
  56:     assert template_shapes <= matched_shapes
  57: 
  58:     source_colors = {int(comp["color"]) for comp in matches}
  59:     assert len(source_colors) == 1
  60:     source_color = next(iter(source_colors))
  61: 
  62:     out = g.copy()
  63:     for comp in candidate_components:
  64:         assert comp["color"] is not None
  65:         if int(comp["color"]) != source_color:
  66:             continue
  67:         coords = comp["coords"]
  68:         if _normalized_mask(coords) in template_shapes:
  69:             out[coords[:, 0], coords[:, 1]] = marker
  70: 
  71:     return out
