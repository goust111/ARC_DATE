+            continue
+        bottom_mid_panel, _bottom_mid_pos = bottom_mid_render
+
+        top_right_panel = _apply_operation(top_left_panel, top_mid_panel, op)
+        bottom_result = _apply_operation(bottom_left_panel, bottom_mid_panel, op)
