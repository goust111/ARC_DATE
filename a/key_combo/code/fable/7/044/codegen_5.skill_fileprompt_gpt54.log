+def _apply_operation(left: np.ndarray, right: np.ndarray, op: str) -> np.ndarray:
+    left_components = _extract_components(left)
+    right_shapes = {comp["shape"] for comp in _extract_components(right)}
+    out = np.zeros_like(left)
