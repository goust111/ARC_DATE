+
+def _extract_components(panel: np.ndarray) -> list[dict]:
+    seen = np.zeros(panel.shape, dtype=bool)
+    components = []
+    h, w = panel.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(panel[r, c])
+            if color == BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
