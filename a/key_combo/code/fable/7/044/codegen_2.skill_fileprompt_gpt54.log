+    for k in corner_indices:
+        seg1 = segments[k]
+        seg2 = segments[k + 1]
+        length1 = int(seg1["length"])
+        length2 = int(seg2["length"])
+        if length1 < 3 or length2 < 3:
+            continue
+        d1 = tuple(seg1["dir"])
+        d2 = tuple(seg2["dir"])
+        a_values = list(range(2, length1))
+        b_values = list(range(2, length2))
+        random.shuffle(a_values)
+        random.shuffle(b_values)
+        for a in a_values:
