+    for _ in range(800):
+        start = (
+            random.randint(margin, height - 1 - margin),
+            random.randint(margin, width - 1 - margin),
+        )
+        occupied = {start}
+        path = [start]
+        segments: list[dict[str, object]] = []
+
+        def dfs(seg_idx: int, pos: tuple[int, int], prev_dir: tuple[int, int] | None) -> bool:
+            if seg_idx == num_segments:
+                return True
