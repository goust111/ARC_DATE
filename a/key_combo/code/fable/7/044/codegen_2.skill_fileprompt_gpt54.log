+                    cur = pos
+                    ok = True
+                    for _ in range(length):
+                        cur = (cur[0] + direction[0], cur[1] + direction[1])
+                        if not (margin <= cur[0] < height - margin and margin <= cur[1] < width - margin):
+                            ok = False
+                            break
+                        if cur in occupied:
+                            ok = False
+                            break
