+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        queue = deque([(r, c)])
+        seen[r, c] = True
+        coords: list[tuple[int, int]] = []
