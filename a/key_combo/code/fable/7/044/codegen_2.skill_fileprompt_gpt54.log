+            grid[r, c] = TRACK
+        for r, c in obstacles:
+            grid[r, c] = OBSTACLE
+
+        sr, sc = path[0]
+        er, ec = path[-1]
+        grid[sr, sc] = ENDPOINT
+        grid[er, ec] = ENDPOINT
+
+        placed = _place_sprite(grid, sprite)
+        if placed is None:
+            continue
+        if not np.array_equal(main(placed), expected):
+            continue
+        return placed
+
+    raise RuntimeError("failed to generate a valid input")

