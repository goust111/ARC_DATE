                            ok = False
                            break
                        prev_cell = (cur[0] - direction[0], cur[1] - direction[1])
                        for nbr in neighbors4(cur):
                            if nbr in occupied and nbr != prev_cell:
                                ok = False
                                break
                        if not ok:
                            break
                        new_cells.append(cur)
                        occupied.add(cur)
