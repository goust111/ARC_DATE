+    mask = np.zeros(shape, dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _enumerate_paths(
+    mask: np.ndarray,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    *,
+    limit: int,
+) -> list[list[tuple[int, int]]]:
+    cells = set(map(tuple, np.argwhere(mask)))
+    found: list[list[tuple[int, int]]] = []
+    path = [start]
+    seen = {start}
+
+    def dfs(cell: tuple[int, int]) -> None:
+        if len(found) >= limit:
+            return
+        if cell == end:
+            found.append(path.copy())
+            return
