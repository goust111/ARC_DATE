                    for cell in new_cells:
                        occupied.remove(cell)
            return False

        if dfs(0, start, None):
            return path, segments
    return None, None


def add_detour(path, segments, shape):
    safe = set(path)
    corner_indices = list(range(len(segments) - 1))
    random.shuffle(corner_indices)
    for k in corner_indices:
        seg1 = segments[k]
        seg2 = segments[k + 1]
        if seg1["length"] < 3 or seg2["length"] < 3:
            continue
        d1 = seg1["dir"]
        d2 = seg2["dir"]
        a_values = list(range(2, seg1["length"]))
        b_values = list(range(2, seg2["length"]))
        random.shuffle(a_values)
        random.shuffle(b_values)
        for a in a_values:
            s_idx = seg1["end_idx"] - a
            start = path[s_idx]
            for b in b_values:
                e_idx = seg2["start_idx"] + b
                end = path[e_idx]
                detour = [start]
                cur = start
                for _ in range(b):
                    cur = (cur[0] + d2[0], cur[1] + d2[1])
                    detour.append(cur)
                for _ in range(a):
                    cur = (cur[0] + d1[0], cur[1] + d1[1])
                    detour.append(cur)
                if cur != end:
                    continue
                interior = detour[1:-1]
                interior_set = set(interior)
                if any((not in_bounds(shape, r, c)) or (r, c) in safe for r, c in interior):
                    continue
                if any(any(nbr in safe and nbr not in {start, end} for nbr in neighbors4(cell)) for cell in interior):
                    continue
                corner_cell = detour[-2]
                obstacle_dirs = [d2, (-d1[0], -d1[1]), (-d2[0], -d2[1]), d1]
                random.shuffle(obstacle_dirs)
                for od in obstacle_dirs:
                    obstacle = (corner_cell[0] + od[0], corner_cell[1] + od[1])
                    if not in_bounds(shape, obstacle[0], obstacle[1]):
                        continue
                    if obstacle in safe or obstacle in interior_set:
                        continue
                    forbidden = {obstacle, *neighbors8(obstacle)}
                    if any(cell in safe for cell in forbidden):
                        continue
                    visible = safe | interior_set
                    all_visible_paths = enumerate_paths(mask_from_cells(shape, visible), path[0], path[-1], limit=6)
                    if len(all_visible_paths) < 2:
                        continue
                    safe_corner_mod = count_corners(path) % 4
                    if not any(count_corners(candidate) % 4 != safe_corner_mod for candidate in all_visible_paths):
                        continue
                    return interior, [obstacle]
    return None, None


def mask_from_cells(shape, cells):
    mask = np.zeros(shape, dtype=bool)
    for r, c in cells:
        mask[r, c] = True
    return mask


def random_sprite():
    palette = [color for color in range(1, 10) if color not in {OBSTACLE, TRACK, ENDPOINT}]
    for _ in range(200):
        c1, c2 = random.sample(palette, 2)
        bits = np.random.randint(0, 2, size=(3, 3), dtype=int)
        if bits.min() == bits.max():
            continue
        sprite = np.where(bits == 0, c1, c2)
        rotations = {np.rot90(sprite, k=k).tobytes() for k in range(4)}
        if len(rotations) == 4:
            return sprite
    raise RuntimeError('"'sprite fail')


def place_sprite(grid, sprite):
    occupied = set(map(tuple, np.argwhere(grid "'!= BG)))
    blocked = set(occupied)
    for cell in list(occupied):
        for nbr in neighbors8(cell):
            if in_bounds(grid.shape, nbr[0], nbr[1]):
                blocked.add(nbr)
    candidates = []
    for r0 in range(grid.shape[0] - 2):
        for c0 in range(grid.shape[1] - 2):
            cells = [(r, c) for r in range(r0, r0 + 3) for c in range(c0, c0 + 3)]
            if any(cell in blocked for cell in cells):
                continue
            candidates.append((r0, c0))
    if not candidates:
        return None
    r0, c0 = random.choice(candidates)
    out = grid.copy()
    out[r0:r0 + 3, c0:c0 + 3] = sprite
    return out


def generate_input():
    for _ in range(500):
        height = random.randint(18, 26)
        width = random.randint(18, 26)
        rotation = random.randint(0, 3)
        corner_count = (4 if rotation == 0 else rotation) + 4 * random.randint(0, 1)
