+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+OBSTACLE = 7
+TRACK = 8
+ENDPOINT = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PERPENDICULAR = {
+    (-1, 0): [(0, -1), (0, 1)],
