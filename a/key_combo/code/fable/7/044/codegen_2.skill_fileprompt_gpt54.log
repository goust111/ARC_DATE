+    forbidden = np.zeros(g.shape, dtype=bool)
+    for r, c in np.argwhere(g == OBSTACLE):
+        rr = int(r)
+        cc = int(c)
+        forbidden[rr, cc] = True
+        for nr, nc in _neighbors8((rr, cc)):
+            if _in_bounds(g.shape, nr, nc):
+                forbidden[nr, nc] = True
