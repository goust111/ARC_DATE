+def _orbit_local(source_r: int, source_c: int, size: int) -> list[tuple[int, int]]:
+    return [
+        (source_r, source_c),
+        (source_c, size - 1 - source_r),
+        (size - 1 - source_r, size - 1 - source_c),
+        (size - 1 - source_c, source_r),
+    ]
