+    h, w = g.shape
+    assert h == w and h % 2 == 0, "expected an even-sized square collage"
+    half = h // 2
+    return [
+        g[:half, :half],
+        g[:half, half:],
+        g[half:, half:],
+        g[half:, :half],
+    ]
