+def _build_collage(source: np.ndarray) -> np.ndarray:
+    size = source.shape[0]
+    collage = np.full((2 * size, 2 * size), BACKGROUND, dtype=int)
+    collage[:size, :size] = source
+    collage[:size, size:] = np.rot90(source, -1)
+    collage[size:, size:] = np.rot90(source, 2)
+    collage[size:, :size] = np.rot90(source, 1)
+    return collage
