+            values = [int(quadrants[q][r, c]) for q, (r, c) in enumerate(orbit)]
+            consensus = _majority_value(values)
+            for quadrant, ((local_r, local_c), value) in enumerate(zip(orbit, values)):
+                if value == consensus:
