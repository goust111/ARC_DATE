+
+def _random_fake_shape(template: frozenset[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    th, tw = _shape_extent(template)
+    for _ in range(300):
+        h = random.randint(2, min(4, max(2, th + 1)))
+        w = random.randint(2, min(4, max(2, tw + 1)))
