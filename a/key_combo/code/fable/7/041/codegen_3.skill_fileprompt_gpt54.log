+from __future__ import annotations
+
+import math
+import random
+from collections import Counter, defaultdict
+from itertools import permutations
+
+import numpy as np
+
+
+GENERATION_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def _colors_present(grid: np.ndarray, bg: int) -> list[int]:
+    return sorted(int(x) for x in np.unique(grid) if int(x) != bg)
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _normalize_coords(coords: np.ndarray) -> frozenset[tuple[int, int]]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    return frozenset((int(r - r0), int(c - c0)) for r, c in coords)
+
+
+def _shape_extent(shape: frozenset[tuple[int, int]]) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
+
+def _scan_anchors(
+    grid: np.ndarray,
+    shape: frozenset[tuple[int, int]],
+    own_color: int,
+    overlap_color: int,
+) -> list[tuple[int, int]]:
+    h, w = _shape_extent(shape)
+    coords = list(shape)
+    out = []
+    for r0 in range(grid.shape[0] - h + 1):
+        for c0 in range(grid.shape[1] - w + 1):
+            has_own = False
+            ok = True
+            for dr, dc in coords:
+                val = int(grid[r0 + dr, c0 + dc])
+                if val == own_color:
+                    has_own = True
+                elif val != overlap_color:
+                    ok = False
+                    break
+            if ok and has_own:
