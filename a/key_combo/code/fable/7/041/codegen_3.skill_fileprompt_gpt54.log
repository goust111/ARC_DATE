+def _gcd_nonzero(values: list[int]) -> int:
+    vals = [abs(int(v)) for v in values if int(v) != 0]
+    if not vals:
+        return 0
+    g = vals[0]
+    for v in vals[1:]:
+        g = math.gcd(g, v)
+    return g
+
+
+def _infer_lattice(positions: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
