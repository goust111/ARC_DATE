+
+            region_masks[(i, j)] = mask.copy()
+            region = grid[r0 : r1 + 1, c0 : c1 + 1]
+            _paint_mask(region, mask, colors)
+
+            expected_region = expected[r0 : r1 + 1, c0 : c1 + 1]
+            expected_region[mask] = int(target_colors[i, j])
