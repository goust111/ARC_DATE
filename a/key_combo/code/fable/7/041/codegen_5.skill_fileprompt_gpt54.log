+    if h == w and np.all(hole_mask):
+        return "square", None, None
+
+    if h == 5 and w >= 4:
+        shaft_len = w - 3
+        for direction in ("left", "right"):
+            if np.array_equal(hole_mask, _arrow_mask(direction, shaft_len)):
+                return "arrow", direction, shaft_len
+    if w == 5 and h >= 4:
+        shaft_len = h - 3
+        for direction in ("up", "down"):
+            if np.array_equal(hole_mask, _arrow_mask(direction, shaft_len)):
+                return "arrow", direction, shaft_len
