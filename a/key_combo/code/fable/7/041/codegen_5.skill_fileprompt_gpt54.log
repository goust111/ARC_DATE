+def _arrow_group_spec(
+    used_target_colors: set[int],
+    force_extra: bool,
+) -> dict:
+    direction = random.choice(DIRECTIONS)
+    shaft_len = random.randint(1, 3)
+    arrow = _arrow_mask(direction, shaft_len)
+    mt = random.randint(1, 2)
