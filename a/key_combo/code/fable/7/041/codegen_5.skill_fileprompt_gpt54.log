+    patch[mt : mt + arrow.shape[0], ml : ml + arrow.shape[1]][arrow] = BLACK
+
+    axis_offset = mt + arrow.shape[0] // 2 if direction in ("left", "right") else ml + arrow.shape[1] // 2
+    if force_extra:
