+    hits: list[tuple[int, dict]] = []
+
+    for obj in objects:
+        coords = obj["coords"]
+        if direction in ("left", "right"):
+            on_axis = coords[coords[:, 0] == axis]
+            if on_axis.size == 0:
+                continue
+            cols = on_axis[:, 1]
+            if direction == "right":
+                near = int(cols.min())
+                if near <= c1:
+                    continue
+                dist = near - c1
+            else:
+                near = int(cols.max())
+                if near >= c0:
+                    continue
+                dist = c0 - near
+        else:
+            on_axis = coords[coords[:, 1] == axis]
+            if on_axis.size == 0:
