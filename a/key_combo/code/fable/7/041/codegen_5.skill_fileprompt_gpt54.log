+def _place_arrow_group(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    blocked: np.ndarray,
+    ray_forbidden: np.ndarray,
+    used_target_colors: set[int],
+    force_extra: bool,
+) -> bool:
