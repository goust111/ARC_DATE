+        g,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        colors=[GRAY],
+        return_format="dict",
+    )
+    objects = find_components(
+        g,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        colors=OBJECT_COLORS,
+        return_format="dict",
