+                if near <= r1:
+                    continue
+                dist = near - r1
+            else:
+                near = int(rows.max())
+                if near >= r0:
+                    continue
+                dist = r0 - near
+        hits.append((dist, obj))
+
+    hits.sort(key=lambda item: item[0])
+    return hits
