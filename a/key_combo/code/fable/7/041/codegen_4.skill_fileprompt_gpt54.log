+            if r1 - r0 < 3 or c1 - c0 < 3:
+                continue
+            if bbox in seen_boxes:
+                continue
+            if not np.all(grid[r0, c0 : c1 + 1] == color):
+                continue
+            if not np.all(grid[r0 : r1 + 1, c0] == color):
