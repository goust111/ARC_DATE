        connectivity=4,
        monochromatic=True,
        colors=[Color.GREY],
    )
    assert gray_blocks

    marker_positions: set[tuple[int, int]] = set()
    height, width = g.shape
    for block in gray_blocks:
        r0, c0, r1, c1 = block["bbox"]
        block_h = int(r1) - int(r0) + 1
