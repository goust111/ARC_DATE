+def _components(mask: np.ndarray) -> list[tuple[list[tuple[int, int]], tuple[int, int, int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
