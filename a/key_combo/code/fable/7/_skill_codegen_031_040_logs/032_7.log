+        count = random.randint(3, 5)
+        sources = random.sample(slots, count)
+        cycle_len = 2
+    elif mode == "long_cycle":
+        count = random.randint(3, 8)
+        sources = random.sample(slots, count)
+        cycle_len = count
+    else:
