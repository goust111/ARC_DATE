+    for frame in found:
+        assert not (all_walls & set(frame["walls"])), "frames must be distinct"
+        all_walls.update(frame["walls"])
+    return found
+
+
+def _keys(g: np.ndarray, bg: int, frames: list[dict]) -> list[dict]:
