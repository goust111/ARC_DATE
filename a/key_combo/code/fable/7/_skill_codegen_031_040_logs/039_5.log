+            continue
+        color = int(g[start])
+        stack = [start]
+        component: set[Coord] = set()
+        visited.add(start)
+        while stack:
+            r, c = stack.pop()
+            component.add((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
