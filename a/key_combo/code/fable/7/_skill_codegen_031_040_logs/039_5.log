    out[r1, c0 : c1 + 1] = frame_color
    out[r0 : r1 + 1, c0] = frame_color
    out[r0 : r1 + 1, c1] = frame_color

    _place_sprites_in_order(out, sprites, frame_bbox, horizontal=interior_w > interior_h)
    return out

