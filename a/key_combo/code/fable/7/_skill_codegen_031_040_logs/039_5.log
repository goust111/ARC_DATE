        assert not _bboxes_overlap(b, frame_bbox), "sprites must be outside the frame"
        mask = _solidified_mask(coords)
        assert mask.any(), "sprite mask must be nonempty"
        sprites.append({"color": color, "bbox": b, "mask": mask})

    out = g.copy()
