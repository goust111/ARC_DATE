+def _tight_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    result = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    result[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return result
