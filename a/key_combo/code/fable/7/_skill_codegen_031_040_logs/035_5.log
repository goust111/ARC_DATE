+    transform = rng.randrange(8)
+    if transform & 1:
+        grid, expected = np.fliplr(grid), np.fliplr(expected)
+    if transform & 2:
+        grid, expected = np.flipud(grid), np.flipud(expected)
+    if transform & 4:
