+    sh, sw = small.shape
+    lh, lw = large.shape
+    if lh % sh or lw % sw or lh // sh != lw // sw:
+        return None
+    factor = lh // sh
+    if factor < 1 or not np.array_equal(_scale(small, factor), large):
+        return None
+    return factor
+
