+    best: set[tuple[tuple[int, int, int], ...]] = set()
+
+    def search(i: int, used_chambers: set[int], used_factors: set[int], chosen):
+        nonlocal best_size, best
+        if i == n_legends:
+            key = tuple(chosen)
+            size = len(key)
+            if size > best_size:
