+        lower_walls = int(np.sum(g[cut + 1:, :] == wall))
+        assert upper_walls != lower_walls
+        maze_side = (slice(0, cut), slice(None)) if upper_walls > lower_walls else (slice(cut + 1, None), slice(None))
