+    height, width = mask.shape
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        queue = deque([(sr, sc)])
+        cells = []
+        while queue:
