def _gen_neighbors4(r, c, h, w):
    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
        rr, cc = r + dr, c + dc
        if 0 <= rr < h and 0 <= cc < w:
            yield rr, cc


def _gen_boundary_coord(side, h, w):
    low = _GEN_INTERIOR_MARGIN
    if side == "T":
        return 0, random.randint(low, w - 1 - low)
    if side == "B":
        return h - 1, random.randint(low, w - 1 - low)
    if side == "L":
        return random.randint(low, h - 1 - low), 0
    return random.randint(low, h - 1 - low), w - 1


def _gen_inner_neighbor(side, r, c):
    dr, dc = _GEN_DIRS[side]
    return r - dr, c - dc


def _gen_add_path(cells, start, end):
    r, c = start
    er, ec = end
    cells.add((r, c))
    axes = [0, 1]
    random.shuffle(axes)
    for axis in axes:
        while (axis == 0 and r != er) or (axis == 1 and c != ec):
            if axis == 0:
                r += 1 if er > r else -1
            else:
                c += 1 if ec > c else -1
            cells.add((r, c))


def _gen_seed_sprite_cells(h, w, ports):
    port_locs = {}
    cells = set()
    port_sides = {side for _, side in ports}

    for color, side in ports:
        r, c = _gen_boundary_coord(side, h, w)
        port_locs[color] = (r, c)
        cells.add((r, c))
        cells.add(_gen_inner_neighbor(side, r, c))

    for side in _GEN_SIDES:
        if side in port_sides:
            continue
        r, c = _gen_boundary_coord(side, h, w)
        cells.add((r, c))

    return cells, port_locs


def _gen_connect_sprite_cells(cells, h, w):
    low = _GEN_INTERIOR_MARGIN
    center = (random.randint(low, h - 1 - low), random.randint(low, w - 1 - low))
    cells.add(center)
    for cell in list(cells):
        _gen_add_path(cells, cell, center)


def _gen_frontier(cells, h, w):
    return {
        nbr
        for r, c in cells
        for nbr in _gen_neighbors4(r, c, h, w)
        if nbr not in cells
    }


def _gen_grow_sprite_cells(cells, h, w):
    area = h * w
    min_fg = max(len(cells), math.ceil(_GEN_MIN_DENSITY * area))
    max_fg = math.floor(_GEN_MAX_DENSITY * area)
    if min_fg > max_fg:
        return False

    target = random.randint(min_fg, max_fg)
    while len(cells) < target:
        frontier = _gen_frontier(cells, h, w)
        if not frontier:
            return False
        cells.add(random.choice(tuple(frontier)))
    return True


def _gen_paint_sprite(h, w, cells, ports, port_locs):
    sprite = np.full((h, w), _GEN_BG, dtype=int)
    for r, c in cells:
        sprite[r, c] = _GEN_BODY
    for color, _side in ports:
        r, c = port_locs[color]
        sprite[r, c] = color

    for color, side in ports:
        r, c = port_locs[color]
        ir, ic = _gen_inner_neighbor(side, r, c)
        if sprite[ir, ic] != _GEN_BODY:
            return None

    return sprite


def _gen_build_sprite(h, w, ports):
    cells, port_locs = _gen_seed_sprite_cells(h, w, ports)
    _gen_connect_sprite_cells(cells, h, w)
    if not _gen_grow_sprite_cells(cells, h, w):
        return None, None

    sprite = _gen_paint_sprite(h, w, cells, ports, port_locs)
    if sprite is None:
        return None, None
    return sprite, port_locs


def _gen_tree(n):
    edges = []
    for child in range(1, n):
        parent = random.randrange(child)
        edges.append((parent, child))
    return edges


def _gen_unpaired_marker_count(n):
    if n == _GEN_MIN_SPRITES:
        return 1
    if n == _GEN_MID_SPRITES:
        return random.randint(0, 1)
    return 0


def _gen_port_plan(n):
    edges = _gen_tree(n)
    unpaired = _gen_unpaired_marker_count(n)
    colors = random.sample(_GEN_MARKERS, len(edges) + unpaired)
    paired_colors = colors[: len(edges)]
    unpaired_color = colors[-1] if unpaired else None

    used_sides = [set() for _ in range(n)]
    ports = [[] for _ in range(n)]
    edge_records = []

    for (parent, child), color in zip(edges, paired_colors):
        choices = [
            side
            for side in _GEN_SIDES
            if side not in used_sides[parent]
            and _GEN_OPPOSITE[side] not in used_sides[child]
        ]
        if not choices:
            return None
        side = random.choice(choices)
        child_side = _GEN_OPPOSITE[side]
        used_sides[parent].add(side)
        used_sides[child].add(child_side)
        ports[parent].append((color, side))
        ports[child].append((color, child_side))
        edge_records.append((parent, child, color, side))

    if unpaired_color is not None:
        choices = [
            idx
            for idx in range(n)
            if len(ports[idx]) < _GEN_MAX_PORTS_PER_SPRITE
            and any(side not in used_sides[idx] for side in _GEN_SIDES)
        ]
        if not choices:
            return None
        idx = random.choice(choices)
        side = random.choice([side for side in _GEN_SIDES if side not in used_sides[idx]])
        ports[idx].append((unpaired_color, side))
        used_sides[idx].add(side)

    if any(len(p) == 0 or len(p) > _GEN_MAX_PORTS_PER_SPRITE for p in ports):
        return None
    return ports, edge_records


def _gen_dims(n):
    dims = []
    for _ in range(n):
        if n == _GEN_MAX_SPRITES:
            h = random.choice(_GEN_FOUR_SPRITE_HEIGHT_CHOICES)
        elif n == _GEN_MID_SPRITES and random.random() < _GEN_THREE_SPRITE_COMPACT_PROB:
            h = random.randint(*_GEN_COMPACT_HEIGHT_RANGE)
        else:
            h = random.randint(*_GEN_HEIGHT_RANGE)
        w = random.randint(*_GEN_WIDTH_RANGE)
        dims.append((h, w))
    return dims


def _gen_placements(edge_records, port_locs):
    placements = {0: (0, 0)}
    pending = list(edge_records)
    while pending:
        progressed = False
        rest = []
        for parent, child, color, side in pending:
            if parent not in placements:
                rest.append((parent, child, color, side))
                continue
            pr, pc = placements[parent]
            ar, ac = port_locs[parent][color]
            br, bc = port_locs[child][color]
            dr, dc = _GEN_DIRS[side]
            placements[child] = (pr + ar + dr - br, pc + ac + dc - bc)
            progressed = True
        if not progressed:
            return None
        pending = rest
    return placements


def _gen_render_output(sprites, placements):
    coords = []
    seen = set()
    for idx, sprite in enumerate(sprites):
        br, bc = placements[idx]
        for rr, cc in np.argwhere(sprite != _GEN_BG):
            pos = (br + int(rr), bc + int(cc))
            if pos in seen:
                return None
            seen.add(pos)
            coords.append(pos)
    if not coords:
        return None

    r0 = min(r for r, _ in coords)
    c0 = min(c for _, c in coords)
    r1 = max(r for r, _ in coords)
    c1 = max(c for _, c in coords)
    if r1 - r0 + 1 > _GEN_MAX_OUTPUT_SPAN or c1 - c0 + 1 > _GEN_MAX_OUTPUT_SPAN:
        return None

    out = np.full((r1 - r0 + 1, c1 - c0 + 1), _GEN_BG, dtype=int)
    for idx, sprite in enumerate(sprites):
        br, bc = placements[idx]
        rr, cc = br - r0, bc - c0
        target = out[rr : rr + sprite.shape[0], cc : cc + sprite.shape[1]]
        mask = sprite != _GEN_BG
        if target.shape != sprite.shape or np.any((target != _GEN_BG) & mask):
            return None
        paste(out, sprite, rr, cc, transparent=_GEN_BG)
    return out


def _gen_scatter_input(sprites):
    canvas = np.full(_GEN_CANVAS_SHAPE, _GEN_BG, dtype=int)
    shadow = np.full(_GEN_CANVAS_SHAPE, _GEN_SHADOW_BG, dtype=int)
    order = sorted(range(len(sprites)), key=lambda i: sprites[i].size, reverse=True)
    for idx in order:
        sprite = sprites[idx]
        rect = np.ones(sprite.shape, dtype=int)
        try:
            r, c = random_free_location(
                shadow,
                rect,
                transparent=_GEN_SHADOW_BG,
                padding=_GEN_SCATTER_PADDING,
                padding_connectivity=_GEN_PADDING_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(shadow, rect, r, c)
        paste(canvas, sprite, r, c, transparent=_GEN_BG)
    return canvas


def _gen_attempt():
    n = random.choice(_GEN_SPRITE_COUNT_CHOICES)
    plan = _gen_port_plan(n)
    if plan is None:
        return None
    ports, edge_records = plan

    sprites = []
    port_locs = []
    for (h, w), sprite_ports in zip(_gen_dims(n), ports):
        sprite, locs = _gen_build_sprite(h, w, sprite_ports)
        if sprite is None:
            return None
        sprites.append(sprite)
        port_locs.append(locs)

    placements = _gen_placements(edge_records, port_locs)
    if placements is None:
        return None
    out = _gen_render_output(sprites, placements)
    if out is None:
        return None

    inp = _gen_scatter_input(sprites)
    if inp is None:
        return None

    try:
        if not np.array_equal(main(inp), out):
            return None
    except Exception:
        return None
    return inp


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid e9fc42f2 input")
from collections import Counter

import numpy as np

from arc_utils import bbox_coords, components_mask, crop_bbox, paste, random_free_location
import random


NEIGHBORS8 = [
    (dr, dc)
    for dr in (-1, 0, 1)
    for dc in (-1, 0, 1)
    if not (dr == 0 and dc == 0)
]


def _touches(mask: np.ndarray, coords: np.ndarray) -> bool:
    height, width = map(int, mask.shape)
    for r, c in coords:
        for dr, dc in NEIGHBORS8:
            rr, cc = int(r) + dr, int(c) + dc
            if 0 <= rr < height and 0 <= cc < width and mask[rr, cc]:
                return True
    return False


def _component_array(grid: np.ndarray, coords: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
    box = bbox_coords(coords)
    r0, c0, r1, c1 = box
    arr = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    arr[coords[:, 0] - r0, coords[:, 1] - c0] = grid[coords[:, 0], coords[:, 1]]
    return box, arr


def _catalog_background(grid: np.ndarray) -> tuple[int, np.ndarray]:
    comps = []
    for color in sorted(set(map(int, grid.flat)) - {0}):
        for coords in components_mask(grid == color, connectivity=4):
            comps.append((len(coords), color, coords))
    assert comps, "expected a non-black catalog background"
    comps.sort(key=lambda item: item[0], reverse=True)
    assert len(comps) == 1 or comps[0][0] > comps[1][0], "expected a unique largest non-black component"

    _area, color, coords = comps[0]
    mask = np.zeros_like(grid, dtype=bool)
    mask[coords[:, 0], coords[:, 1]] = True
    assert np.any(mask[0, :]) or np.any(mask[-1, :]) or np.any(mask[:, 0]) or np.any(mask[:, -1])
    return int(color), mask


def _templates(grid: np.ndarray, catalog_color: int, catalog_mask: np.ndarray) -> list[dict]:
    templates = []
    visible = (grid != 0) & (grid != catalog_color)
    for coords in components_mask(visible, connectivity=8):
        if not _touches(catalog_mask, coords):
            continue
        box = bbox_coords(coords)
        raw = crop_bbox(grid, box)
        sprite = np.where(raw == catalog_color, 0, raw).astype(int)
        colors = sorted(set(map(int, sprite[sprite != 0].flat)))
        assert len(colors) >= 2, "expected multi-color catalog templates"
        templates.append(
            {
                "grid": sprite,
                "visible": sprite != 0,
                "colors": colors,
                "counts": {color: int(np.sum(sprite == color)) for color in colors},
            }
        )
    assert templates, "expected at least one catalog template"
    return templates


def _color_mask(template: dict, color: int) -> tuple[tuple[int, int], np.ndarray, bool]:
    sprite = template["grid"]
    mask = sprite == color
    coords = np.argwhere(mask)
    assert coords.size > 0, "expected color to be present in template"
    r0, c0, r1, c1 = bbox_coords(coords)
    arr = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    arr[mask[r0 : r1 + 1, c0 : c1 + 1]] = color

    height, width = map(int, sprite.shape)
    touches_border = bool(
        np.any(
            (coords[:, 0] == 0)
            | (coords[:, 0] == height - 1)
            | (coords[:, 1] == 0)
            | (coords[:, 1] == width - 1)
        )
    )
    return (r0, c0), arr, touches_border


def _template_offsets(part: np.ndarray, template: dict) -> list[tuple[int, int]]:
    sprite = template["grid"]
    height, width = map(int, sprite.shape)
    part_height, part_width = map(int, part.shape)
    part_colors = sorted(set(map(int, part[part != 0].flat)))
    assert part_colors, "expected a non-empty workspace object"

    offsets = []

    if (
        part_height == height
        and part_width == width
        and len(part_colors) == 1
        and np.all(part == part_colors[0])
        and part_colors[0] in template["colors"]
    ):
        _offset, _mask, color_touches_border = _color_mask(template, part_colors[0])
        if color_touches_border:
            offsets.append((0, 0))

    if len(part_colors) == 1 and part_colors[0] in template["colors"]:
        color = part_colors[0]
        count_freq = Counter(template["counts"].values())
        if count_freq[template["counts"][color]] == 1:
            offset, mask_arr, _touches_border = _color_mask(template, color)
            if part.shape == mask_arr.shape and np.array_equal(part, mask_arr):
                offsets.append(offset)

    if len(part_colors) >= 2:
        for r in range(height - part_height + 1):
            for c in range(width - part_width + 1):
                sub = sprite[r : r + part_height, c : c + part_width]
                if np.array_equal(part, sub) and (
                    r == 0 or c == 0 or r + part_height == height or c + part_width == width
                ):
                    offsets.append((r, c))

    return offsets


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete partial workspace sprites by matching them to full templates shown in the non-black catalog region.

    Input structure
    - A large non-black connected region is the catalog background.
    - Multi-color template sprites touch that catalog background; all other
      foreground objects lie in the black workspace.
    - Some workspace objects are partial views of a catalog template, while
      distractor objects do not match any template part.

    Rule
    - For each workspace object, find the unique catalog template that it matches:
      either a full template bbox filled with one template border color, a
      uniquely sized single-color mask of the template, or a multi-color boundary
      window of the template.
    - Stamp the full matched template at the aligned position, treating catalog
      background cells inside the template bbox as transparent.
    - Leave workspace objects with no template match unchanged.

    Key insight
    - The colored objects in the catalog are not to be copied in order; they are
      a legend of target sprites, and each incomplete workspace object determines
      its template and alignment from the visible sub-sprite it already contains.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    catalog_color, catalog_mask = _catalog_background(g)
    templates = _templates(g, catalog_color, catalog_mask)

    planned: dict[tuple[int, int], int] = {}
    workspace = (g != 0) & (~catalog_mask)
    for coords in components_mask(workspace, connectivity=8):
        if _touches(catalog_mask, coords):
            continue

        box, part = _component_array(g, coords)
        r0, c0, _r1, _c1 = box
        source_mask = np.zeros_like(g, dtype=bool)
        source_mask[coords[:, 0], coords[:, 1]] = True

        matches = []
        for template in templates:
            sprite = template["grid"]
            for off_r, off_c in _template_offsets(part, template):
                anchor_r, anchor_c = r0 - off_r, c0 - off_c
                height, width = map(int, sprite.shape)
                if not (
                    0 <= anchor_r
                    and 0 <= anchor_c
                    and anchor_r + height <= g.shape[0]
                    and anchor_c + width <= g.shape[1]
                ):
                    continue

                ok = True
                for rr, cc in np.argwhere(template["visible"]):
                    gr, gc = anchor_r + int(rr), anchor_c + int(cc)
                    value = int(sprite[rr, cc])
                    if g[gr, gc] != 0 and not source_mask[gr, gc] and g[gr, gc] != value:
                        ok = False
                        break
                if ok:
                    cells = tuple(
                        (int(rr), int(cc), int(sprite[rr, cc]))
                        for rr, cc in np.argwhere(template["visible"])
                    )
                    matches.append((anchor_r, anchor_c, cells))

        unique_matches = []
        seen = set()
        for match in matches:
            if match not in seen:
                seen.add(match)
                unique_matches.append(match)
        assert len(unique_matches) <= 1, "expected each workspace object to match at most one template"

        if not unique_matches:
            continue

        anchor_r, anchor_c, cells = unique_matches[0]
        for rr, cc, value in cells:
            target = (anchor_r + rr, anchor_c + cc)
            assert planned.get(target, value) == value, "expected overlapping template stamps to agree"
            planned[target] = value

    out = g.copy()
    for (r, c), value in planned.items():
        out[r, c] = value
    return out

# --------------- generator (o5x) ---------------

# Canvas and catalog strip.
GRID_SIZE, CATALOG_COLOR, CATALOG_TEMPLATE_GAP = 30, 3, 1
CATALOG_EDGES, HORIZONTAL_CATALOG_EDGES = ("top", "bottom", "left"), ("top", "bottom")
CATALOG_THICKNESS_RANGE = (6, 8)

# Template shape, style, and palette.
TEMPLATE_COUNT_RANGE, TEMPLATE_SIZE_RANGE = (2, 3), (2, 5)
TEMPLATE_FRAME_MIN_SIZE, TEMPLATE_PATTERN_BORDER_PROB = 3, 0.55
TEMPLATE_STYLES, TEMPLATE_PALETTE = ("frame", "pattern"), (1, 2, 4, 6, 7, 8)

# Workspace object counts and spacing.
TOTAL_OBJECT_COUNT_RANGE = (11, 16)
MATCHED_OBJECT_COUNT_RANGE, DISTRACTOR_COUNT_RANGE = (2, 5), (7, 11)
DISTRACTOR_SIZE_RANGE, PLACEMENT_PADDING = (1, 3), 1

# Generation retry budget.
GENERATION_RETRY_LIMIT = 300


def _gen_template_sprite(height: int, width: int, border_color: int, fill_color: int) -> np.ndarray:
    style = random.choice(TEMPLATE_STYLES)
    sprite = np.full((height, width), int(fill_color), dtype=int)

    if style == "frame" and height >= TEMPLATE_FRAME_MIN_SIZE and width >= TEMPLATE_FRAME_MIN_SIZE:
        sprite[[0, -1], :] = border_color
        sprite[:, [0, -1]] = border_color
        return sprite

    mask = np.zeros((height, width), dtype=bool)
    coords = [(r, c) for r in range(height) for c in range(width)]
    random.shuffle(coords)
    for r, c in coords:
        rr, cc = height - 1 - r, width - 1 - c
        value = random.random() < TEMPLATE_PATTERN_BORDER_PROB
        mask[r, c] = value
        mask[rr, cc] = value

    c = random.randrange(width)
    mask[(0, height - 1), (c, width - 1 - c)] = True
    if not np.any(~mask):
        r, c = random.randrange(height), random.randrange(width)
        mask[(r, height - 1 - r), (c, width - 1 - c)] = False
    sprite[mask] = border_color
    return sprite


def _gen_pack_starts(length: int, sizes: list[int]) -> list[int]:
    base_gaps = [0] + [CATALOG_TEMPLATE_GAP] * (len(sizes) - 1) + [0]
    spare = length - sum(sizes) - sum(base_gaps)
    if spare < 0:
        raise ValueError("templates do not fit in catalog strip")
    extras = [0] * (len(sizes) + 1)
    for _ in range(spare):
        extras[random.randrange(len(extras))] += 1
    gaps = [base + extra for base, extra in zip(base_gaps, extras)]
    starts = []
    pos = gaps[0]
    for i, size in enumerate(sizes):
        starts.append(pos)
        pos += size + gaps[i + 1]
    return starts


def _gen_color_touches_border(sprite: np.ndarray, color: int) -> bool:
    mask = sprite == int(color)
    return bool(np.any(mask[[0, -1], :]) or np.any(mask[:, [0, -1]]))


def _gen_color_mask_is_solid_rect(sprite: np.ndarray, color: int, height: int, width: int) -> bool:
    mask = sprite == int(color)
    coords = np.argwhere(mask)
    if coords.size == 0:
        return False
    r0, c0, r1, c1 = bbox_coords(coords)
    return (r1 - r0 + 1, c1 - c0 + 1) == (height, width) and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1]))


def _gen_solid_matches_template(height: int, width: int, color: int, templates: list[dict]) -> bool:
    for template in templates:
        sprite = template["sprite"]
        colors = template["colors"]
        if color not in colors:
            continue

        if sprite.shape == (height, width) and _gen_color_touches_border(sprite, color):
            return True

        counts = {col: int(np.sum(sprite == col)) for col in colors}
        if (
            list(counts.values()).count(counts[color]) == 1
            and _gen_color_mask_is_solid_rect(sprite, color, height, width)
        ):
            return True
    return False


def _gen_catalog_slice(edge: str, thickness: int) -> tuple[slice, slice]:
    if edge == "top":
        return slice(0, thickness), slice(0, GRID_SIZE)
    if edge == "bottom":
        return slice(GRID_SIZE - thickness, GRID_SIZE), slice(0, GRID_SIZE)
    return slice(0, GRID_SIZE), slice(0, thickness)


def _gen_place_catalog_templates(out: np.ndarray, edge: str, thickness: int, templates: list[dict]) -> None:
    if edge in HORIZONTAL_CATALOG_EDGES:
        starts = _gen_pack_starts(GRID_SIZE, [t["sprite"].shape[1] for t in templates])
        for template, c0 in zip(templates, starts):
            sprite = template["sprite"]
            h, _w = sprite.shape
            local_r = random.randrange(thickness - h + 1)
            r0 = local_r if edge == "top" else GRID_SIZE - thickness + local_r
            paste(out, sprite, r0, c0)
    else:
        starts = _gen_pack_starts(GRID_SIZE, [t["sprite"].shape[0] for t in templates])
        for template, r0 in zip(templates, starts):
            sprite = template["sprite"]
            _h, w = sprite.shape
            c0 = random.randrange(thickness - w + 1)
            paste(out, sprite, r0, c0)


def _gen_workspace_counts() -> tuple[int, int]:
    total = random.randint(*TOTAL_OBJECT_COUNT_RANGE)
    lo = max(MATCHED_OBJECT_COUNT_RANGE[0], total - DISTRACTOR_COUNT_RANGE[1])
    hi = min(MATCHED_OBJECT_COUNT_RANGE[1], total - DISTRACTOR_COUNT_RANGE[0])
    matched = random.randint(lo, hi)
    return matched, total - matched


def _gen_templates(edge: str, thickness: int) -> list[dict] | None:
    template_count = random.randint(*TEMPLATE_COUNT_RANGE)
    palette = list(TEMPLATE_PALETTE)
    random.shuffle(palette)

    templates = []
    used_shape_border_colors: dict[tuple[int, int], set[int]] = {}
    for i in range(template_count):
        height_cap = thickness if edge in HORIZONTAL_CATALOG_EDGES else TEMPLATE_SIZE_RANGE[1]
        width_cap = thickness if edge == "left" else TEMPLATE_SIZE_RANGE[1]
        height = random.randint(TEMPLATE_SIZE_RANGE[0], min(TEMPLATE_SIZE_RANGE[1], height_cap))
        width = random.randint(TEMPLATE_SIZE_RANGE[0], min(TEMPLATE_SIZE_RANGE[1], width_cap))
        border_color, fill_color = palette[2 * i], palette[2 * i + 1]
        if border_color in used_shape_border_colors.setdefault((height, width), set()):
            return None
        used_shape_border_colors[(height, width)].add(border_color)
        templates.append(
            {
                "sprite": _gen_template_sprite(height, width, border_color, fill_color),
                "border_color": border_color,
                "colors": [border_color, fill_color],
            }
        )
    return templates


def _gen_place_workspace_patch(out: np.ndarray, occupied: np.ndarray, patch: np.ndarray) -> tuple[int, int] | None:
    occupied_patch = np.ones(patch.shape, dtype=int)
    try:
        r0, c0 = random_free_location(occupied, occupied_patch, transparent=0, padding=PLACEMENT_PADDING)
    except ValueError:
        return None
    paste(out, patch, r0, c0)
    paste(occupied, occupied_patch, r0, c0)
    return r0, c0


def _gen_place_matched_objects(
    out: np.ndarray, occupied: np.ndarray, templates: list[dict], matched_count: int
) -> list[tuple[int, int, tuple[int, int], int]] | None:
    stamp_records = []
    for _ in range(matched_count):
        template = random.choice(templates)
        sprite = template["sprite"]
        loc = _gen_place_workspace_patch(out, occupied, sprite)
        if loc is None:
            return None
        r0, c0 = loc
        stamp_records.append((r0, c0, sprite.shape, template["border_color"]))
    return stamp_records


def _gen_distractor_options(catalog_color: int, templates: list[dict]) -> list[tuple[int, int, int]]:
    distractor_colors = sorted({catalog_color, *(color for t in templates for color in t["colors"])})
    return [
        (h, w, color)
        for h in range(DISTRACTOR_SIZE_RANGE[0], DISTRACTOR_SIZE_RANGE[1] + 1)
        for w in range(DISTRACTOR_SIZE_RANGE[0], DISTRACTOR_SIZE_RANGE[1] + 1)
        for color in distractor_colors
        if not _gen_solid_matches_template(h, w, color, templates)
    ]


def _gen_place_distractors(
    out: np.ndarray, occupied: np.ndarray, distractors: list[tuple[int, int, int]], count: int
) -> bool:
    for _ in range(count):
        h, w, color = random.choice(distractors)
        patch = np.full((h, w), color, dtype=int)
        if _gen_place_workspace_patch(out, occupied, patch) is None:
            return False
    return True


def _gen_attempt() -> np.ndarray | None:
    edge = random.choice(CATALOG_EDGES)
    thickness = random.randint(*CATALOG_THICKNESS_RANGE)
    out = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
    rs, cs = _gen_catalog_slice(edge, thickness)
    out[rs, cs] = CATALOG_COLOR

    templates = _gen_templates(edge, thickness)
    if templates is None:
        return None
    random.shuffle(templates)
    _gen_place_catalog_templates(out, edge, thickness, templates)

    occupied = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
    occupied[rs, cs] = 1
    matched_count, distractor_count = _gen_workspace_counts()

    stamp_records = _gen_place_matched_objects(out, occupied, templates, matched_count)
    if stamp_records is None:
        return None

    safe_distractors = _gen_distractor_options(CATALOG_COLOR, templates)
    if not safe_distractors:
        return None
    if not _gen_place_distractors(out, occupied, safe_distractors, distractor_count):
        return None

    inp = out.copy()
    for r0, c0, (height, width), color in stamp_records:
        inp[r0 : r0 + height, c0 : c0 + width] = color
    try:
        return inp if np.array_equal(main(inp), out) else None
    except AssertionError:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input for 3ed85e70")

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_h, colors_present, crop_bbox, draw_line, find_components, object_neighbors, paste, random_free_location, random_sprite, scale_sprite

# concepts:
# scaling, puzzle pieces, indicator pixels

# description:
# In the input you will see objects with exactly 2 colors, each with one pixel/rectangle of a different color as an indicator. The indicator color is the same across objects.
# To make the output, one of those objects is a template shape that you are going to translate/recolor/rescale to match indicators with each other object.
# Place the rescaled template on top of the other shape so that the indicators are at the same position, and change color to match what you are placing on top of.

def main(input_grid):
    """
    Complete each partial object by scaling and recoloring the largest template so its indicator aligns with the partial indicator.

    Input structure:
    - The grid contains several two-color objects on a black background.
    - One indicator color appears in every object.
    - One object is the full template; the others are partial scaled objects with their own colors.

    Rule:
    - Find the common indicator color across all objects.
    - Choose the template by largest object size normalized by indicator size.
    - Scale and recolor the template for each other object, then paste it with indicators aligned.

    Key insight:
    - The indicator region supplies both correspondence and scale, while the template supplies
      the missing shape around each partial object.
    """
    # Plan:
    # 1. Parse the input into template object and other objects, and determine the indicator color
    # 2. For each other object, rescale+recolor the template to match indicators

    # 1. Parse the input

    # Extract all the objects from the input grid
    background = Color.BLACK
    objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=False, return_format="objects")

    # The indicator pixel's color appears in all the objects
    possible_indicator_colors = [ color for color in Color.ALL_COLORS
                                 if all( color in colors_present(obj, exclude={ background }) for obj in objects)]
    assert len(possible_indicator_colors) == 1, "There should be exactly one indicator color"
    indicator_color = possible_indicator_colors[0]

    # Find the template object, which is the biggest object after you scale the indicator down to have size 1x1
    object_sizes = [ np.sum(obj != background) for obj in objects]
    indicator_sizes = [ np.sum(obj == indicator_color) for obj in objects]
    rescaled_sizes = [size // indicator_size for size, indicator_size in zip(object_sizes, indicator_sizes)]
    template_index = np.argmax(rescaled_sizes)
    template_object = objects[template_index]
    other_objects = [obj for i, obj in enumerate(objects) if i != template_index]

    _b = bbox(template_object != background)
    assert _b is not None
    template_sprite = crop_bbox(template_object, _b)

    # 2. For each other object, rescale+recolor the template to match indicators
    # Determine the scaling factor by the ratio of the size of the indicator pixel region
    # Determine the color according to the non-indicator color of the object
    # Determine the position so that indicator pixels are overlaid

    # To produce the output we draw on top of the input
    output_grid = input_grid.copy()

    for other_object in other_objects:

        # Find the new shape's color
        new_color = [ color for color in colors_present(other_object, exclude={ background }) if color != indicator_color][0]

        # find the new scale, which is the ratio of the size of the indicator pixel in the original shape to the size of the indicator pixel in the new shape
        b_other = bbox(other_object == indicator_color)
        b_template = bbox(template_object == indicator_color)
        assert b_other is not None and b_template is not None
        new_scale = bbox_h(b_other) // bbox_h(b_template)

        # Scale the original template to the same scale...
        template_sprite_scaled = scale_sprite(template_sprite, new_scale)
        # ...and change its color to the new shape's color
        template_sprite_scaled[(template_sprite_scaled != background) & (template_sprite_scaled != indicator_color)] = new_color

        # Overlay the indicator pixels from the scaled/recolored template sprite with the indicator pixels from the other object
        r = np.min(np.argwhere(other_object == indicator_color)[:,0]) - np.min(np.argwhere(template_sprite_scaled == indicator_color)[:,0])
        c = np.min(np.argwhere(other_object == indicator_color)[:,1]) - np.min(np.argwhere(template_sprite_scaled == indicator_color)[:,1])
        paste(output_grid, template_sprite_scaled, r, c, transparent=Color.BLACK, clip=True)
        
    return output_grid

def generate_input():
    # Generate the background grid
    background = Color.BLACK
    width, height = np.random.randint(15, 30), np.random.randint(15, 30)
    grid = np.full((width, height), background)

    # Randomly select the color of objects and indicator, which should all be distinct
    n_objects = 2
    colors = np.random.choice(Color.NOT_BLACK, n_objects + 1, replace=False)
    indicator_color, template_color, other_colors = colors[0], colors[1], colors[2:]

    # Ensure the shapes after completion do not overlap by having a canvas that shows what things will look like after producing the output
    output_grid = grid.copy()    

    # Generate the original shape
    w, h = np.random.randint(3, 5), np.random.randint(3, 5)
    template_sprite = random_sprite(w, h, color_palette=[template_color], connectivity=4)

    # Randomly turn one pixel into the indicator pixel
    indicator_pixel = random.choice(np.argwhere(template_sprite == template_color))
    template_sprite[indicator_pixel[0], indicator_pixel[1]] = indicator_color

    # Place the template on the grid, and on the predicted output
    r, c = random_free_location(output_grid, template_sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
    paste(grid, template_sprite, r, c, transparent=Color.BLACK, clip=True)
    paste(output_grid, template_sprite, r, c, transparent=Color.BLACK, clip=True)

    # Check which pixels are neighbors of the indicator pixel, which will be included in the other objects
    neighbor_mask = (template_sprite == template_color) & object_neighbors(template_sprite == indicator_color, connectivity=8)
    
    # Place the other objects
    for other_color in other_colors:
        # there is the completed other object which will be in the output, and the uncompleted other object which will be in the input
        complete_other_object = template_sprite.copy()
        complete_other_object[complete_other_object == template_color] = other_color

        # Make the incomplete object, which just has the indicator pixel plus one of its neighbors
        incomplete_other_object = template_sprite.copy()
        incomplete_other_object[incomplete_other_object == template_color] = background        
        neighbor_r, neighbor_c = random.choice(np.argwhere(neighbor_mask))
        incomplete_other_object[neighbor_r, neighbor_c] = other_color

        # Rescale both
        scale = np.random.randint(1, 3)
        complete_other_object = scale_sprite(complete_other_object, scale)
        incomplete_other_object = scale_sprite(incomplete_other_object, scale)

        # Place the complete object on the predicted output
        try:
            r, c = random_free_location(output_grid, complete_other_object, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
        except ValueError:
            break
        paste(output_grid, complete_other_object, r, c, transparent=Color.BLACK, clip=True)

        # place the incomplete object such that its indicators overlap at the same location
        r -= np.min(np.argwhere(complete_other_object == indicator_color)[:,0]) - np.min(np.argwhere(incomplete_other_object == indicator_color)[:,0])
        c -= np.min(np.argwhere(complete_other_object == indicator_color)[:,1]) - np.min(np.argwhere(incomplete_other_object == indicator_color)[:,1])
        paste(grid, incomplete_other_object, r, c, transparent=Color.BLACK, clip=True)

    return grid
from __future__ import annotations

import numpy as np

from arc_utils import get_bg
import random


def _recolor_from_controls(
    block: np.ndarray,
    template: np.ndarray,
    bg: int,
    source_colors: set[int],
) -> np.ndarray:
    mapping: dict[int, int] = {}
    controls = np.argwhere(block != bg)
    assert controls.size, "each block must contain at least one control/template pixel"

    for r, c in controls:
        symbol = int(template[int(r), int(c)])
        color = int(block[int(r), int(c)])
        assert symbol in source_colors, "control pixel must sit over a template symbol"
        if symbol in mapping:
            assert mapping[symbol] == color, "same template symbol must map to one color"
        else:
            mapping[symbol] = color

    out = np.full(template.shape, bg, dtype=int)
    for symbol in source_colors:
        out[template == symbol] = mapping.get(symbol, bg)
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete the four inner quadrants as flipped, recolored copies of the top-left template.

    Input structure:
    - A one-cell background border surrounds a square interior split into a 2x2 block grid.
    - The upper-left block is a complete two-color template.
    - The other blocks contain sparse control pixels placed where their corresponding
      flipped template symbols should take those colors.

    Rule:
    - Use the upper-left block unchanged for the first quadrant.
    - Horizontally flip the template for the upper-right quadrant, vertically flip it
      for the lower-left quadrant, and flip both axes for the lower-right quadrant.
    - In each quadrant, every non-background input pixel maps the transformed
      template symbol under it to that pixel's color; symbols without a control
      pixel become background.

    Key insight: The control pixels are not objects to move; they are a local
    recoloring legend for the transformed template underneath each quadrant.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    h, w = g.shape
    assert h >= 4 and w >= 4, "grid must have an interior"
    assert (h - 2) % 2 == 0 and (w - 2) % 2 == 0, "interior must split into 2x2 blocks"
    block_h = (h - 2) // 2
    block_w = (w - 2) // 2
    assert block_h == block_w, "template blocks must be square"

    assert np.all(g[0, :] == bg) and np.all(g[-1, :] == bg), "top/bottom border must be background"
    assert np.all(g[:, 0] == bg) and np.all(g[:, -1] == bg), "left/right border must be background"

    n = block_h
    base = g[1 : 1 + n, 1 : 1 + n]
    assert not np.any(base == bg), "upper-left template must be complete"
    source_colors = set(map(int, np.unique(base)))
    assert len(source_colors) == 2, "template must use exactly two symbols"

    out = np.full_like(g, bg)
    for br in range(2):
        for bc in range(2):
            r0 = 1 + br * n
            c0 = 1 + bc * n
            template = base
            if br:
                template = np.flipud(template)
            if bc:
                template = np.fliplr(template)

            block = g[r0 : r0 + n, c0 : c0 + n]
            out[r0 : r0 + n, c0 : c0 + n] = _recolor_from_controls(
                block, template, bg, source_colors
            )

    return out

# --------------- generator (o5x) ---------------

# Canvas bounds and palette.
BG = 0
GRID_SHAPE = (10, 10)
BLOCK_SIZE = 4
BORDER = 1
NON_BG_COLORS = range(1, 10)

# Template shape sampling.
TEMPLATE_PRIMARY_COUNT_RANGE = (6, 10)
TEMPLATE_FORCED_PRIMARY = ((0, 0), (0, 1))
TEMPLATE_FORCED_SECONDARY = frozenset({(0, 3), (3, 1)})
TEMPLATE_TRANSFORM_COUNT = 8

# Control mapping and retry limits.
CONTROL_QUADRANTS = ((0, 1), (1, 0), (1, 1))
FULL_QUADRANT_COUNT_CHOICES = (2, 3)
GENERATION_RETRIES = 300


def _gen_template() -> np.ndarray:
    colors = random.sample(NON_BG_COLORS, 2)
    primary_count = random.randint(*TEMPLATE_PRIMARY_COUNT_RANGE)

    bits = np.zeros((BLOCK_SIZE, BLOCK_SIZE), dtype=bool)
    for r, c in TEMPLATE_FORCED_PRIMARY:
        bits[r, c] = True

    fixed_cells = set(TEMPLATE_FORCED_PRIMARY) | TEMPLATE_FORCED_SECONDARY
    free = [
        (r, c) for r in range(BLOCK_SIZE) for c in range(BLOCK_SIZE)
        if (r, c) not in fixed_cells
    ]
    for r, c in random.sample(free, primary_count - len(TEMPLATE_FORCED_PRIMARY)):
        bits[r, c] = True

    template = np.where(bits, colors[0], colors[1]).astype(int)
    transform = random.randrange(TEMPLATE_TRANSFORM_COUNT)
    if transform >= TEMPLATE_TRANSFORM_COUNT // 2:
        template = np.fliplr(template)
    template = np.rot90(template, transform % (TEMPLATE_TRANSFORM_COUNT // 2))
    return template.copy()


def _place_controls(inp, out, template, source_colors, control_palette, full_quadrants) -> None:
    """Add sparse control pixels to input and matching completed blocks to output."""
    for br, bc in CONTROL_QUADRANTS:
        r0 = BORDER + br * BLOCK_SIZE
        c0 = BORDER + bc * BLOCK_SIZE
        flipped = template
        if br:
            flipped = np.flipud(flipped)
        if bc:
            flipped = np.fliplr(flipped)

        if (br, bc) in full_quadrants:
            mapped_symbols = source_colors[:]
            random.shuffle(mapped_symbols)
        else:
            mapped_symbols = [random.choice(source_colors)]

        mapped_colors = random.sample(control_palette, len(mapped_symbols))
        out_block = out[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE]
        for symbol, color in zip(mapped_symbols, mapped_colors):
            coords = np.argwhere(flipped == symbol)
            rr, cc = coords[random.randrange(len(coords))]
            inp[r0 + int(rr), c0 + int(cc)] = int(color)
            out_block[flipped == symbol] = int(color)


def _gen_attempt() -> np.ndarray | None:
    inp = np.full(GRID_SHAPE, BG, dtype=int)
    out = np.full(GRID_SHAPE, BG, dtype=int)

    template = _gen_template()
    source_colors = list(map(int, np.unique(template)))
    control_palette = [color for color in NON_BG_COLORS if color not in source_colors]

    inp[BORDER : BORDER + BLOCK_SIZE, BORDER : BORDER + BLOCK_SIZE] = template
    out[BORDER : BORDER + BLOCK_SIZE, BORDER : BORDER + BLOCK_SIZE] = template

    full_count = random.choice(FULL_QUADRANT_COUNT_CHOICES)
    full_quadrants = set(random.sample(CONTROL_QUADRANTS, full_count))
    _place_controls(inp, out, template, source_colors, control_palette, full_quadrants)

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
