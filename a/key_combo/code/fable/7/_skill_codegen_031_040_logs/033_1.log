+    grid[random.choice(free)] = stray_color
+
+    grid = _rotate(grid)
+    return grid if _semantic_check(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    """Generate varied two/three-frame examples with active and blocked ray branches."""
+    for _ in range(500):
