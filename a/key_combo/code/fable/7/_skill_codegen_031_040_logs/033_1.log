+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]  # inclusive (r0, c0, r1, c1)
+DIRS: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
