+
+
+def _component(grid: np.ndarray, start: Coord, seen: set[Coord]) -> set[Coord]:
+    """Return one same-color 4-connected component."""
+    h, w = grid.shape
+    color = int(grid[start])
+    stack = [start]
+    seen.add(start)
+    cells: set[Coord] = set()
+    while stack:
+        r, c = stack.pop()
+        cells.add((r, c))
+        for dr, dc in DIRS:
+            rr, cc = r + dr, c + dc
+            p = (rr, cc)
+            if 0 <= rr < h and 0 <= cc < w and p not in seen and int(grid[p]) == color:
+                seen.add(p)
+                stack.append(p)
