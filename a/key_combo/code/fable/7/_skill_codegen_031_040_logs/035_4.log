+            if (0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1]
+                    and feasible[rr, cc] and not seen[rr, cc]):
+                seen[rr, cc] = True
+                queue.append((rr, cc))
+    return seen
