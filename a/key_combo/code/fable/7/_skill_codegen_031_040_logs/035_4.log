_GEN_WALL_COUNTS_9 = [32, 33, 34, 35, 36]
_GEN_MAX_WALL_COMPONENT_7, _GEN_MAX_WALL_COMPONENT_9 = 9, 12
# Chamber size ranges.
_GEN_MARKED_SIZE_RANGE, _GEN_UNMARKED_SIZE_RANGE = (3, 13), (1, 10)
# Validation thresholds.
