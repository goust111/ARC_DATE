+def _reachable(feasible: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    seen = np.zeros_like(feasible, dtype=bool)
+    sr, sc = start
+    assert feasible[sr, sc], "mover must begin at a legal placement"
+    seen[sr, sc] = True
+    queue = deque([(sr, sc)])
+    while queue:
