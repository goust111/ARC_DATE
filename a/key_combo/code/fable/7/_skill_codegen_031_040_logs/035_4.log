+    """Return (top, left, side) when mask is exactly one filled square."""
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return None
+    r0, c0 = cells.min(axis=0)
+    r1, c1 = cells.max(axis=0)
+    n = int(r1 - r0 + 1)
+    if n != int(c1 - c0 + 1) or int(cells.shape[0]) != n * n:
+        return None
