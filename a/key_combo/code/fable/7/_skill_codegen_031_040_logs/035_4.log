                cand.append(int(a[0, int(c)]))
        return int(Counter(cand).most_common(1)[0][0])

    sep = _find_sep(g)

    def _full_sep_rows(a: np.ndarray) -> list[int]:
        return [int(r) for r in range(int(a.shape[0])) if bool((a[int(r), :] == int(sep)).all())]

    def _full_sep_cols(a: np.ndarray) -> list[int]:
        return [int(c) for c in range(int(a.shape[1])) if bool((a[:, int(c)] == int(sep)).all())]

    def _split_by_rows(a: np.ndarray) -> list[np.ndarray]:
        rows = _full_sep_rows(a)
        segs: list[np.ndarray] = []
        start = 0
        for r in rows + [int(a.shape[0])]:
            if int(r) > int(start):
                segs.append(a[int(start) : int(r), :].copy())
            start = int(r + 1)
        return segs

    def _split_by_cols(a: np.ndarray) -> list[np.ndarray]:
        cols = _full_sep_cols(a)
        segs: list[np.ndarray] = []
        start = 0
        for c in cols + [int(a.shape[1])]:
            if int(c) > int(start):
                segs.append(a[:, int(start) : int(c)].copy())
            start = int(c + 1)
        return segs

    def _render_strip(blocks: list[np.ndarray], axis: int) -> np.ndarray:
        # axis=0: vertical stack (sep rows), axis=1: horizontal stack (sep cols)
        n = int(len(blocks))
        if int(axis) == 0:
            out = np.full((int(n * 5 + (n - 1)), 5), int(bg), dtype=int)
            rr = 0
            for i, b in enumerate(blocks):
                out[int(rr) : int(rr + 5), :] = b
                rr += 5
                if int(i) < int(n - 1):
                    out[int(rr), :] = int(sep)
                    rr += 1
            return out
        out = np.full((5, int(n * 5 + (n - 1))), int(bg), dtype=int)
        cc = 0
        for i, b in enumerate(blocks):
            out[:, int(cc) : int(cc + 5)] = b
            cc += 5
            if int(i) < int(n - 1):
                out[:, int(cc)] = int(sep)
                cc += 1
        return out

    def _split_blocks() -> list[np.ndarray]:
        """Return list of 5x5 blocks (order doesn't matter; we will match by connect)."""
        rows = _full_sep_rows(g)
        cols = _full_sep_cols(g)
        if rows and cols:
            r = int(rows[0])
            c = int(cols[0])
            return [
                g[:r, :c],
                g[:r, int(c + 1) :],
                g[int(r + 1) :, :c],
                g[int(r + 1) :, int(c + 1) :],
            ]
        if rows:
            return _split_by_rows(g)
        if cols:
            return _split_by_cols(g)
        return []

    def _contacts(block: np.ndarray) -> dict[str, set[int]]:
        """Edge contact sets (offsets) for the block's foreground."""
        bbg = int(_most_common(block))
        m = block != int(bbg)
        top = set(np.where(m[0, :])[0].tolist())
        bot = set(np.where(m[-1, :])[0].tolist())
        left = set(np.where(m[:, 0])[0].tolist())
        right = set(np.where(m[:, -1])[0].tolist())
        return {"top": top, "bot": bot, "left": left, "right": right}

    def _find_chain(blocks: list[np.ndarray], orient: str):
        """Find an ordering p of indices such that consecutive blocks connect in orient."""
        import itertools

        cont = [_contacts(b) for b in blocks]

        def ok(a: int, b: int) -> bool:
            if orient == "h":
                return len(cont[int(a)]["right"] & cont[int(b)]["left"]) > 0
            return len(cont[int(a)]["bot"] & cont[int(b)]["top"]) > 0
    lead_kw, trail_kw = _ORIENT_KW[orient]
    blocks: list[np.ndarray] = []
    for i in range(n):
        kw = {}
        if i > 0:
            kw[lead_kw] = shared_offsets[i - 1]
        if i < n - 1:
            kw[trail_kw] = shared_offsets[i]
        block = _make_block(random.choice(PALETTE), **kw)
        if block is None:
            return None
        blocks.append(block)

    if _count_orders(blocks, orient) != 1 or _count_orders(blocks, _OTHER[orient]) != 0:
        return None

    out = _render_strip(blocks, orient)
    inp = _render_input(blocks, orient)
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"failed to generate a valid input after {MAX_RETRIES} attempts")
from collections import Counter, deque

import numpy as np

from arc_utils import components_mask as _gen_components_mask, get_bg, neighbors4
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Flood-fill each marked chamber bounded by walls with its marker color.

    Input structure
    A same-size grid has a dominant background/open color, one repeated wall color,
    and one-cell colored markers sitting inside some wall-bounded open chambers.

    Rule
    Infer the wall as the unique non-background color that appears more than once.
    Treat wall pixels as barriers. For every 4-connected non-wall component, leave
    it unchanged if it has no marker; otherwise assert it has exactly one marker and
    recolor the whole component with that marker's color.

    Key insight
    The repeated color is a maze wall that partitions the background into chambers;
    the singleton marker inside a chamber supplies the fill color for that chamber.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()
    bg = get_bg(g)

    counts = Counter(map(int, g.ravel()))
    wall_colors = [color for color, count in counts.items() if color != bg and count > 1]
    assert len(wall_colors) == 1
    wall = wall_colors[0]

    marker_colors = [color for color in counts if color not in (bg, wall)]
    assert all(counts[color] == 1 for color in marker_colors)

    h, w = g.shape
    seen = np.zeros(g.shape, dtype=bool)
    for sr in range(h):
        for sc in range(w):
            if seen[sr, sc] or g[sr, sc] == wall:
                continue

            component = []
            markers = []
            queue = deque([(sr, sc)])
            seen[sr, sc] = True
            while queue:
                r, c = queue.popleft()
                component.append((r, c))
                if g[r, c] != bg:
                    markers.append((r, c))
                for nr, nc in neighbors4(r, c):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] != wall:
                        seen[nr, nc] = True
                        queue.append((nr, nc))

            if markers:
                assert len(markers) == 1
                color = int(g[markers[0]])
                for r, c in component:
                    out[r, c] = color

    return out

