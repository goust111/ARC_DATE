                        valid.append(nb)

    if dest_ok:
        tr, tc = dest_r, dest_c
    else:
        best_d = -1
        tr, tc = mover_r, mover_c
        for r in range(h2):
            for c in range(w2):
                if dist[r, c] > best_d:
                    best_d = dist[r, c]
                    tr, tc = r, c

    output = grid.copy()
    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER
    output[tr:tr + n, tc:tc + n] = _MOVER

    if not np.array_equal(main(grid), output):
