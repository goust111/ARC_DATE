+    crossings = [(a, b, p) for a, b, p in crossings if p is not None]
+    if not 2 <= len(crossings) <= 6:
+        return None
+    winner_directions = {
+        min((a, b), key=lambda s: s.length).horizontal for a, b, _ in crossings
