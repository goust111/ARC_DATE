+                continue
+            local = [(rr, cc) for rr in range(max(0, r - 1), min(h, r + 2)) for cc in range(max(0, c - 1), min(w, c + 2))]
+            if any(int(grid[rr, cc]) != bg or (rr, cc) in reserved for rr, cc in local):
