+                assert 0 <= r < h and 0 <= c < w, "ray must fit inside the grid"
+                assert int(g[r, c]) == bg, "ray must pass only through background"
+                assert (r, c) not in claimed, "rays must not overlap"
+                claimed.add((r, c))
+                out[r, c] = color
+    return out
