+def _direction_or_none(center2: Coord, marker: Coord) -> Coord | None:
+    dr2, dc2 = 2 * marker[0] - center2[0], 2 * marker[1] - center2[1]
+    if abs(dr2) == abs(dc2):
+        return None
+    if abs(dr2) > abs(dc2):
+        return (1 if dr2 > 0 else -1, 0)
+    return (0, 1 if dc2 > 0 else -1)
