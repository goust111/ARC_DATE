+    height, width = mask.shape
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        queue = deque([(sr, sc)])
+        cells: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for dr, dc in NEIGHBORS_8:
+                nr, nc = r + dr, c + dc
+                if (
+                    0 <= nr < height
+                    and 0 <= nc < width
+                    and mask[nr, nc]
+                    and not seen[nr, nc]
