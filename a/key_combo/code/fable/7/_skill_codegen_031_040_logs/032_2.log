def _place_markers(sprite_types: list[dict], marker_type_ids: list[int],
                   dst_h: int, dst_w: int, dst_bg: int) -> tuple[np.ndarray, list[tuple[int, int, int]]] | None:
    """Place sprites into the dest interior, returning (stamped_inner, marker_points) or None."""
