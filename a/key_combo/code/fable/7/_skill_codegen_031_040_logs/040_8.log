+    if gaps.size == 0:
+        return None
+    gap0, gap1 = int(gaps[0]), int(gaps[-1])
+    if gap0 == 0 or gap1 == line.size - 1:
+        return None
+    if not np.all(line[gap0 : gap1 + 1] == bg):
+        return None
+    outside = np.concatenate((line[:gap0], line[gap1 + 1 :]))
+    if not np.all(outside == color):
+        return None
+    return color, gap0, gap1
