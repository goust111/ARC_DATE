+def _line_candidate(line: np.ndarray, bg: int):
+    """Recognize a boundary-to-boundary monochrome line with one inner gap."""
+    if line.size < 3 or int(line[0]) == bg or int(line[-1]) == bg:
+        return None
+    color = int(line[0])
+    if int(line[-1]) != color:
+        return None
