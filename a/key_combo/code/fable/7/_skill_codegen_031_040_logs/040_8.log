+    while len(intervals) < count:
+        feasible = [item for item in candidates if _separated(item, intervals)]
+        if not feasible:
+            return None
+        intervals.append(feasible[int(_RNG.integers(len(feasible)))])
+    _RNG.shuffle(intervals)
+    return intervals
+
+
+def _expected_from_plan(
+    inp: np.ndarray,
+    orientation: str,
+    bar_index: int,
+    bar_color: int,
+    gap: tuple[int, int],
+    side: str,
+    sprites: list[dict],
