+            block[br * factor : (br + 1) * factor, bc * factor : (bc + 1) * factor] = True
+            if np.all(block <= np.pad(np.ones((oh, ow), dtype=bool), ((rr, big_h-rr-oh), (cc, big_w-cc-ow)))):
