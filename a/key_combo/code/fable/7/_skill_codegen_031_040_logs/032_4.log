+    inp = np.zeros((grid_h, grid_w), dtype=int)
+    expected = inp.copy()
+    big_in = inp[lr0 : lr1 + 1, lc0 : lc1 + 1]
+    big_out = expected[lr0 : lr1 + 1, lc0 : lc1 + 1]
+    big_in[enlarged] = large_color
+    big_out[enlarged] = large_color
