+    assert np.all(g[gr0 : gr1 + 1, gc0 : gc1 + 1] == OCCLUDER), "occluder must be solid"
+
+    large, matches = _matching_candidates(g)
+    assert len(matches) == 1, "visible evidence must identify exactly one scaled twin"
