+    return mask
+
+
+def _distractors(base: np.ndarray, count: int, hidden: np.ndarray) -> list[np.ndarray] | None:
+    """Add different visible cells, making near-matches that the occluder cannot hide."""
+    choices = []
+    h, w = base.shape
+    for r, c in np.argwhere(~base):
