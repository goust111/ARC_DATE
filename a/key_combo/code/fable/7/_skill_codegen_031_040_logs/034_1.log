+            return False
+    return True
+
+
+def _place_next(
+    shape: tuple[int, int], boxes: list[tuple[int, int, int, int]], out_gap: tuple[int, int], side: int
+) -> tuple[tuple[int, int, int, int], tuple[int, int]] | None:
+    """Place a frame ahead of out_gap and return its bbox and incoming gap."""
+    h_grid, w_grid = shape
+    gr, gc = out_gap
+    for _ in range(100):
