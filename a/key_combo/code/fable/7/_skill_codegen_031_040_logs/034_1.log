+            out[r0 + 1 : r1, c0 + 1 : c1] = color
+            visited.add(next_frame)
+            other = [p for p in frames[next_frame]["gaps"] if p != (r, c)]
+            if not other:
+                break
+            assert len(other) == 1
+            current_frame = next_frame
+            r, c = other[0]
+            direction = _outward((r, c), frames[next_frame]["bbox"])
+            continue
