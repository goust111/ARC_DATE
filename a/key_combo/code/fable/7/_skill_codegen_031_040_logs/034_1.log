+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    """Return 4-connected components using the common ARC (row, column) convention."""
+    seen = np.zeros(mask.shape, dtype=bool)
+    result: list[list[tuple[int, int]]] = []
+    h, w = mask.shape
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        q = deque([(sr, sc)])
+        comp: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            comp.append((r, c))
+            for dr, dc in DIRS:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        result.append(comp)
+    return result
+
+
+def _border(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return [
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    ]
+
+
+def _outward(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r, c = gap
+    r0, c0, r1, c1 = bbox
+    if r == r0 and c0 < c < c1:
+        return -1, 0
+    if r == r1 and c0 < c < c1:
+        return 1, 0
+    if c == c0 and r0 < r < r1:
+        return 0, -1
+    if c == c1 and r0 < r < r1:
+        return 0, 1
+    raise AssertionError("every gap must be a non-corner border cell")
