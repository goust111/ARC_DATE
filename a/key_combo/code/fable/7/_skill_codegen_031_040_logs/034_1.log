+    sources = []
+    for i, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        reds = np.argwhere(g[r0 + 1 : r1, c0 + 1 : c1] == RED)
+        if len(reds):
+            sources.append(i)
+    assert len(sources) == 1 and int(np.count_nonzero(g == RED)) == 1
+    source = sources[0]
+    assert len(frames[source]["gaps"]) == 1
