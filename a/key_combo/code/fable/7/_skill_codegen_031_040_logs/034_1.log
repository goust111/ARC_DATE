+        distance = random.randint(2, 5)
+        incoming_side = side ^ 1
+        if side == 0:
+            r1 = gr - distance
+            r0 = r1 - hh + 1
+            off = random.randint(1, ww - 2)
+            c0, c1 = gc - off, gc - off + ww - 1
+        elif side == 1:
+            r0 = gr + distance
+            r1 = r0 + hh - 1
+            off = random.randint(1, ww - 2)
+            c0, c1 = gc - off, gc - off + ww - 1
+        elif side == 2:
+            c1 = gc - distance
+            c0 = c1 - ww + 1
+            off = random.randint(1, hh - 2)
+            r0, r1 = gr - off, gr - off + hh - 1
+        else:
+            c0 = gc + distance
+            c1 = c0 + ww - 1
+            off = random.randint(1, hh - 2)
