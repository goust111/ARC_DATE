+    targets = {
+        i: _ray_target(i, slots, g.shape)
+        for i, slot in enumerate(slots)
+        if slot.color is None
+    }
+
+    out = g.copy()
+    colors = [slot.color for slot in slots]
+    remaining = set(targets)
+    while remaining:
