round_hist = Counter()
root_hist = Counter()
for _ in range(200):
    g = m.generate_input()
    slots = m._parse_slots(g)
    targets = {i: m._ray_target(i, slots, g.shape) for i, s in enumerate(slots) if s.color is None}
    roots = {i for i, s in enumerate(slots) if s.color is not None}
    reached = set()
    max_depth = 0
    for source in targets:
        seen = {source}
        cur = source
        depth = 0
        while cur not in roots:
            cur = targets[cur]
            assert cur not in seen, 'cycle detected'
            seen.add(cur)
            depth += 1
        reached.add(cur)
        max_depth = max(max_depth, depth)
    assert reached == roots, 'every differently colored seed must affect at least one chain'
    assert max_depth >= 2, 'sample lacks a required delayed relay'
    assert m._nearest_is_not_always_parent([
        m._GenNode(s.box, None, s.direction, 0, 0, int(s.color or 1)) for s in slots
    ]) is False  # helper requires intended parents; generator itself audits this before return
    round_hist[max_depth] += 1
    root_hist[len(roots)] += 1
print('semantic_audit_samples', 200, 'max_chain_depths', dict(round_hist), 'root_counts', dict(root_hist))
