# Tiling
# =============================================================================


def tile_fill(shape: tuple[int, int], tile: np.ndarray, *, offset: Coord = (0, 0)) -> np.ndarray:
    """Return a new grid of `shape` filled by repeating `tile` with a phase offset."""
    H, W = map(int, shape)
    h, w = tile.shape
from __future__ import annotations

from collections import deque

import numpy as np

from arc_utils import find_components, get_bg
import random


DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))


def _component_coords(comp: dict) -> list[tuple[int, int]]:
    return [tuple(map(int, rc)) for rc in comp["coords"]]


def _ordered_straight_run(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
    rows = {r for r, _c in coords}
    cols = {c for _r, c in coords}
    assert len(rows) == 1 or len(cols) == 1, "foreground run must be horizontal or vertical"

    if len(rows) == 1:
        row = next(iter(rows))
        cs = sorted(c for _r, c in coords)
        assert cs == list(range(cs[0], cs[-1] + 1)), "horizontal run must be contiguous"
        return [(row, c) for c in cs]

    col = next(iter(cols))
    rs = sorted(r for r, _c in coords)
    assert rs == list(range(rs[0], rs[-1] + 1)), "vertical run must be contiguous"
    return [(r, col) for r in rs]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete a sparse grid by casting occluding diagonal rays from the longest run and filling the remaining diagonal-connected regions from the short bars.

    Input structure
    - Black-background grid with one unique longest 4-connected foreground object.
    - The longest object is a horizontal or vertical multicolor run; all other foreground objects are shorter monochrome bars.

    Rule
    - On a blank canvas, process the longest run from left to right or top to bottom; each pixel emits four 45-degree rays that stop at the first already-painted pixel.
    - Each remaining monochrome bar fills every still-blank pixel reachable from it by diagonal steps.

    Key insight
    - Earlier pixels in the long run occlude later diagonal rays, and those ray barriers partition the background into diagonal-connected regions for the short bars.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape

    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    assert len(comps) >= 2, "expected a main run plus at least one short bar"

    max_area = max(int(comp["area"]) for comp in comps)
    main_candidates = [comp for comp in comps if int(comp["area"]) == max_area]
    assert len(main_candidates) == 1, "main run must be the unique largest foreground object"

    main = main_candidates[0]
    main_coords = _component_coords(main)
    assert len({int(g[r, c]) for r, c in main_coords}) >= 2, "main run must be multicolor"
    ordered_main = _ordered_straight_run(main_coords)

    out = np.full_like(g, bg)
    for r, c in ordered_main:
        color = int(g[r, c])
        assert color != bg
        assert out[r, c] == bg, "main source pixel unexpectedly already painted"
        out[r, c] = color
        for dr, dc in DIAG_DIRS:
            nr, nc = r + dr, c + dc
            while 0 <= nr < H and 0 <= nc < W and out[nr, nc] == bg:
                out[nr, nc] = color
                nr += dr
                nc += dc

    main_set = set(main_coords)
    base = out.copy()
    fill_regions: list[tuple[int, set[tuple[int, int]]]] = []
    for comp in comps:
        coords = _component_coords(comp)
        if set(coords) == main_set:
            continue

        ordered_bar = _ordered_straight_run(coords)
        colors = {int(g[r, c]) for r, c in ordered_bar}
        assert len(colors) == 1, "short bar must be monochrome"
        color = next(iter(colors))
        assert color != bg
        assert all(base[r, c] == bg for r, c in ordered_bar), "short bar overlaps main rays"

        seen = set(ordered_bar)
        q = deque(ordered_bar)
        while q:
            r, c = q.popleft()
            for dr, dc in DIAG_DIRS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and base[nr, nc] == bg and (nr, nc) not in seen:
                    seen.add((nr, nc))
                    q.append((nr, nc))
        fill_regions.append((color, seen))

    claimed: set[tuple[int, int]] = set()
    for color, region in fill_regions:
        assert claimed.isdisjoint(region), "short-bar diagonal regions must be disjoint"
        claimed.update(region)
        for r, c in region:
            out[r, c] = color

    for r, c in np.argwhere(g != bg):
        assert out[int(r), int(c)] == int(g[int(r), int(c)]), "input foreground must be preserved"

    return out

# --------------- generator (o5x) ---------------

# --- Configuration ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 4, 10
RUN_LENGTH_MIN, RUN_LENGTH_MAX = 3, 7    # main run pixel count
POS_MARGIN = 1                            # perpendicular position inset from grid edges
COLOR_MIN, COLOR_MAX = 1, 9              # non-background color range (inclusive)
MAX_RETRIES = 300                         # generate_input() retry budget

_DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
_ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Edge definitions: (name, pair_generator) -- each yields adjacent cell pairs along one edge.
_EDGE_DEFS = {
    "top":    lambda n: (((0, c), (0, c + 1)) for c in range(n - 1)),
    "bottom": lambda n: (((n - 1, c), (n - 1, c + 1)) for c in range(n - 1)),
    "left":   lambda n: (((r, 0), (r + 1, 0)) for r in range(n - 1)),
    "right":  lambda n: (((r, n - 1), (r + 1, n - 1)) for r in range(n - 1)),
}


def _diag_flood(ray, seeds):
    """BFS all zero-cells in *ray* diag-reachable from *seeds*. Returns the visited set (includes seeds)."""
    n = ray.shape[0]
    seen = set(seeds)
    q = deque(seeds)
    while q:
        r, c = q.popleft()
        for dr, dc in _DIAG_DIRS:
            nr, nc = r + dr, c + dc
            if 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0 and (nr, nc) not in seen:
                seen.add((nr, nc))
                q.append((nr, nc))
    return seen


def _cast_main_rays(n, orientation, length, pos, colors):
    """Place the main run and cast 4 diagonal rays from each pixel (with occlusion). Returns (ray_grid, coords) or (None, None)."""
    ray = np.zeros((n, n), dtype=int)
    if orientation == "H":
        coords = [(pos, c) for c in range(n - length, n)]
    else:
        coords = [(r, pos) for r in range(n - length, n)]

    for (r, c), color in zip(coords, colors):
        if ray[r, c] != 0:
            return None, None
        ray[r, c] = color
        for dr, dc in _DIAG_DIRS:
            nr, nc = r + dr, c + dc
            while 0 <= nr < n and 0 <= nc < n and ray[nr, nc] == 0:
                ray[nr, nc] = color
                nr += dr
                nc += dc
    return ray, coords


def _diag_labels(ray):
    """Label each diagonal-connected zero-region in *ray* with a unique integer. Non-zero cells get -1."""
    n = ray.shape[0]
    labels = np.full_like(ray, -1, dtype=int)
    next_label = 0
    for sr, sc in np.argwhere(ray == 0):
        sr, sc = int(sr), int(sc)
        if labels[sr, sc] >= 0:
            continue
        for cell in _diag_flood(ray, [(sr, sc)]):
            labels[cell] = next_label
        next_label += 1
    return labels


def _touches(cells, blocked):
    """True if any cell in *cells* is orthogonally adjacent to a cell in *blocked*."""
    for r, c in cells:
        for dr, dc in _ORTH_DIRS:
            if (r + dr, c + dc) in blocked:
                return True
    return False


def _edge_pairs(ray, labels, excluded_edge, blocked):
    """Find valid size-2 bar placements along grid edges (excluding *excluded_edge* and cells adjacent to *blocked*)."""
    n = ray.shape[0]
    pairs = []
    for edge_name, gen_fn in _EDGE_DEFS.items():
        if edge_name == excluded_edge:
            continue
        for pair in gen_fn(n):
            if all(ray[p] == 0 for p in pair) and not _touches(pair, blocked):
                pairs.append((pair, frozenset(int(labels[p]) for p in pair)))
    return pairs


def _choose_bars(ray, main_coords, orientation):
    """Select 1 or 2 compatible bar placements from grid edges."""
    excluded_edge = "right" if orientation == "H" else "bottom"
    labels = _diag_labels(ray)
    candidates = _edge_pairs(ray, labels, excluded_edge, set(main_coords))
    if not candidates:
        return None

    compatible_twos = []
    for i, (pair_a, labels_a) in enumerate(candidates):
        for pair_b, labels_b in candidates[i + 1:]:
            if labels_a & labels_b or _touches(pair_b, set(pair_a)):
                continue
            compatible_twos.append((pair_a, pair_b))

    if compatible_twos and random.choice((1, 2)) == 2:
        return list(random.choice(compatible_twos))
    return [random.choice(candidates)[0]]


def _bar_regions_disjoint(ray, bars):
    """Check that the diagonal flood regions of all bars are mutually disjoint."""
    claimed = set()
    for pair in bars:
        region = _diag_flood(ray, list(pair))
        if claimed & region:
            return False
        claimed.update(region)
    return True


def _build_output(ray, bars, bar_colors):
    """Overlay each bar's diagonal flood region onto the ray grid."""
    out = ray.copy()
    for pair, color in zip(bars, bar_colors):
        for r, c in _diag_flood(ray, list(pair)):
            out[r, c] = color
    return out


def _gen_attempt():
    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    orientation = random.choice(("H", "V"))
    length = random.randint(RUN_LENGTH_MIN, min(n - 1, RUN_LENGTH_MAX))
    pos = random.randint(POS_MARGIN, n - 1 - POS_MARGIN)

    colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), length)
    ray, main_coords = _cast_main_rays(n, orientation, length, pos, colors)
    if ray is None:
        return None

    bars = _choose_bars(ray, main_coords, orientation)
    if not bars or not _bar_regions_disjoint(ray, bars):
        return None

    remaining = [c for c in range(COLOR_MIN, COLOR_MAX + 1) if c not in colors]
    bar_colors = random.sample(remaining, len(bars))

    inp = np.zeros((n, n), dtype=int)
    for (r, c), color in zip(main_coords, colors):
        inp[r, c] = color
    for pair, color in zip(bars, bar_colors):
        for r, c in pair:
            inp[r, c] = color

    expected = _build_output(ray, bars, bar_colors)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 1190bc91 input")
from __future__ import annotations

import numpy as np

from arc_utils import components_mask, get_bg, paste
import itertools
import random


def _occupancy(shape: tuple[int, int], objects: list[tuple[np.ndarray, np.ndarray]]) -> np.ndarray:
    occ = np.full(shape, -1, dtype=int)
    for idx, (coords, _values) in enumerate(objects):
        assert np.all(occ[coords[:, 0], coords[:, 1]] == -1), "objects must not overlap"
        occ[coords[:, 0], coords[:, 1]] = idx
    return occ


def _objects_that_can_shift_right(
    objects: list[tuple[np.ndarray, np.ndarray]], occ: np.ndarray
) -> set[int]:
    _, w = occ.shape
    movable = set(range(len(objects)))

    changed = True
    while changed:
        changed = False
        for idx in list(movable):
            coords, _values = objects[idx]
            shifted_cols = coords[:, 1] + 1
            if np.any(shifted_cols >= w):
                movable.remove(idx)
                changed = True
                continue

            labels = occ[coords[:, 0], shifted_cols]
            blockers = {int(label) for label in labels if int(label) not in {-1, idx}}
            if any(blocker not in movable for blocker in blockers):
                movable.remove(idx)
                changed = True

    return movable


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide every foreground object horizontally to the right until it settles against the border or another settled object.

    Input structure
    - The grid has a dominant background color and several separate 4-connected foreground objects.
    - Each foreground object is a small multicolor rectangle-like sprite on the same canvas.
    - Objects may overlap in their row ranges, so rightward movement can make a left object stop behind a right object.

    Rule
    - Treat each 4-connected foreground object as a rigid sprite.
    - Simultaneously move every sprite one column right whenever its next cells are inside the grid and not blocked by a sprite that cannot move.
    - Repeat the simultaneous move until no sprite can move; preserve each sprite's internal colors and shape.

    Key insight
    - The output is the terminal state of eastward gravity on the foreground sprites, not a recoloring or per-row sort.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"

    bg = get_bg(g)
    components = components_mask(g != bg, connectivity=4)
    assert components, "expected at least one foreground object"

    objects = []
    for coords in components:
        coords = coords.astype(int)
        values = g[coords[:, 0], coords[:, 1]].astype(int)
        objects.append((coords.copy(), values))

    h, w = g.shape
    for _step in range(w):
        occ = _occupancy((h, w), objects)
        movable = _objects_that_can_shift_right(objects, occ)
        if not movable:
            break
        for idx in movable:
            objects[idx][0][:, 1] += 1
    else:
        raise AssertionError("rightward gravity did not settle within the grid width")

    out = np.full_like(g, bg)
    for coords, values in objects:
        assert np.all(out[coords[:, 0], coords[:, 1]] == bg), "settled objects must not overlap"
        out[coords[:, 0], coords[:, 1]] = values

    return out

# --------------- generator (o5x) ---------------

# Canvas, colors, and component rules.
GRID_HEIGHT, GRID_WIDTH = 15, 15
BACKGROUND = 0
COLOR_VALUES = tuple(range(1, 10))
CONNECTIVITY = 4

# Sprite and chain structure.
SPRITE_SIDES = (2, 3, 5)
CHAIN_COUNT_OPTIONS, CHAIN_SIZE_OPTIONS = (2, 3), (1, 2, 3)
TOTAL_SPRITES_MIN, TOTAL_SPRITES_MAX = 4, 6
CHAIN_GAP_ROWS = 1
MAX_SETTLED_CHAIN_WIDTH = GRID_WIDTH - 1

# Fork layout constraints.
MIN_FORK_ROOT_SIDE, MIN_FORK_BRANCH_SEPARATION = 3, 2

# Sampling retries and input shifts.
COLOR_PAIR_SHUFFLE_ATTEMPTS, MAX_LEFT_SHIFT, GENERATION_ATTEMPTS = 80, 11, 300


def _gen_checker(side: int, colors: tuple[int, int]) -> np.ndarray:
    rr, cc = np.indices((side, side))
    return np.where((rr + cc) % 2 == 0, colors[0], colors[1]).astype(int)


def _gen_color_pairs(n: int) -> list[tuple[int, int]]:
    colors = list(COLOR_VALUES)
    slots: list[int] = []
    while len(slots) < 2 * n:
        cycle = colors[:]
        random.shuffle(cycle)
        slots.extend(cycle)
    slots = slots[: 2 * n]

    for _ in range(COLOR_PAIR_SHUFFLE_ATTEMPTS):
        random.shuffle(slots)
        pairs: list[tuple[int, int]] = []
        seen: set[tuple[int, int]] = set()
        ok = True
        for i in range(n):
            a, b = slots[2 * i], slots[2 * i + 1]
            key = tuple(sorted((a, b)))
            if a == b or key in seen:
                ok = False
                break
            seen.add(key)
            if random.random() < 0.5:
                a, b = b, a
            pairs.append((a, b))
        if ok:
            return pairs

    all_pairs = list(itertools.combinations(colors, 2))
    random.shuffle(all_pairs)
    return [(a, b) if random.random() < 0.5 else (b, a) for a, b in all_pairs[:n]]


def _gen_chain_sizes() -> tuple[int, ...]:
    choices: list[tuple[int, ...]] = []
    for n_chains in CHAIN_COUNT_OPTIONS:
        for sizes in itertools.product(CHAIN_SIZE_OPTIONS, repeat=n_chains):
            if TOTAL_SPRITES_MIN <= sum(sizes) <= TOTAL_SPRITES_MAX and 1 in sizes:
                choices.append(tuple(sizes))
    return random.choice(choices)


def _gen_overlapping_top(parent_top: int, parent_side: int, child_side: int) -> int:
    lo = parent_top - child_side + 1
    hi = parent_top + parent_side - 1
    return random.randint(lo, hi)


def _gen_normalize_rows(sprites: list[dict]) -> int:
    min_r = min(sp["r"] for sp in sprites)
    for sp in sprites:
        sp["r"] -= min_r
    return max(sp["r"] + sp["side"] for sp in sprites)


def _gen_candidate_chain_layouts(n_sprites: int, sides: list[int]) -> list[tuple[str, tuple[int, ...]]]:
    builders: list[tuple[str, tuple[int, ...]]] = []
    for order in set(itertools.permutations(sides)):
        if n_sprites == 2:
            if sum(order) <= MAX_SETTLED_CHAIN_WIDTH:
                builders.append(("pair", order))
        elif n_sprites == 3:
            if sum(order) <= MAX_SETTLED_CHAIN_WIDTH:
                builders.append(("line", order))
            if (
                order[0] >= MIN_FORK_ROOT_SIDE
                and order[0] + order[1] <= MAX_SETTLED_CHAIN_WIDTH
                and order[0] + order[2] <= MAX_SETTLED_CHAIN_WIDTH
            ):
                builders.append(("fork", order))
    return builders


def _gen_pair_sprites(order: tuple[int, ...]) -> list[dict]:
    root_side, child_side = order
    c0 = GRID_WIDTH - root_side
    return [
        {"side": root_side, "r": 0, "c": c0, "parent": None},
        {
            "side": child_side,
            "r": _gen_overlapping_top(0, root_side, child_side),
            "c": c0 - child_side,
            "parent": 0,
        },
    ]


def _gen_line_sprites(order: tuple[int, ...]) -> list[dict]:
    root_side, mid_side, left_side = order
    c0 = GRID_WIDTH - root_side
    r1 = _gen_overlapping_top(0, root_side, mid_side)
    return [
        {"side": root_side, "r": 0, "c": c0, "parent": None},
        {"side": mid_side, "r": r1, "c": c0 - mid_side, "parent": 0},
        {
            "side": left_side,
            "r": _gen_overlapping_top(r1, mid_side, left_side),
            "c": c0 - mid_side - left_side,
            "parent": 1,
        },
    ]


def _gen_fork_sprites(order: tuple[int, ...]) -> list[dict]:
    root_side, upper_side, lower_side = order
    c0 = GRID_WIDTH - root_side
    upper_bottom = random.randint(0, root_side - MIN_FORK_ROOT_SIDE)
    lower_top = random.randint(upper_bottom + MIN_FORK_BRANCH_SEPARATION, root_side - 1)
    return [
        {"side": root_side, "r": 0, "c": c0, "parent": None},
        {
            "side": upper_side,
            "r": upper_bottom - upper_side + 1,
            "c": c0 - upper_side,
            "parent": 0,
        },
        {"side": lower_side, "r": lower_top, "c": c0 - lower_side, "parent": 0},
    ]


def _gen_build_chain(n_sprites: int, sides: list[int]) -> dict | None:
    if n_sprites == 1:
        side = sides[0]
        return {
            "sprites": [{"side": side, "r": 0, "c": GRID_WIDTH - side, "parent": None}],
            "height": side,
        }

    builders = _gen_candidate_chain_layouts(n_sprites, sides)
    if not builders:
        return None

    kind, order = random.choice(builders)
    if kind == "pair":
        sprites = _gen_pair_sprites(order)
    elif kind == "line":
        sprites = _gen_line_sprites(order)
    else:
        sprites = _gen_fork_sprites(order)

    height = _gen_normalize_rows(sprites)
    return {"sprites": sprites, "height": height}


def _gen_pack_chains(chains: list[dict]) -> bool:
    random.shuffle(chains)
    min_height = sum(ch["height"] for ch in chains) + CHAIN_GAP_ROWS * (len(chains) - 1)
    if min_height > GRID_HEIGHT:
        return False

    extra = GRID_HEIGHT - min_height
    gaps = [0] * (len(chains) + 1)
    for _ in range(extra):
        gaps[random.randrange(len(gaps))] += 1

    row = gaps[0]
    for idx, chain in enumerate(chains):
        for sp in chain["sprites"]:
            sp["r"] += row
        row += chain["height"] + CHAIN_GAP_ROWS + gaps[idx + 1]
    return True


def _gen_parent_tree(sprites: list[dict]) -> tuple[int | None, dict[int, list[int]]]:
    children: dict[int, list[int]] = {idx: [] for idx in range(len(sprites))}
    root = None
    for idx, sp in enumerate(sprites):
        parent = sp["parent"]
        if parent is None:
            root = idx
        else:
            children[parent].append(idx)
    return root, children


def _gen_assign_shifts(chain: dict) -> dict[int, int] | None:
    sprites = chain["sprites"]
    root, children = _gen_parent_tree(sprites)
    if root is None:
        return None

    caps: dict[int, int] = {}

    def visit(idx: int) -> int:
        cap = min(MAX_LEFT_SHIFT, int(sprites[idx]["c"]))
        for child in children[idx]:
            cap = min(cap, visit(child) - 1)
        caps[idx] = cap
        return cap

    if visit(root) < 1:
        return None

    shifts: dict[int, int] = {}

    def assign(idx: int, min_shift: int) -> bool:
        if min_shift > caps[idx]:
            return False
        shifts[idx] = random.randint(min_shift, caps[idx])
        for child in children[idx]:
            if not assign(child, shifts[idx] + 1):
                return False
        return True

    if not assign(root, 1):
        return None
    return shifts


def _gen_place(grid: np.ndarray, patch: np.ndarray, r: int, c: int) -> bool:
    h, w = patch.shape
    if r < 0 or c < 0 or r + h > GRID_HEIGHT or c + w > GRID_WIDTH:
        return False
    if np.any(grid[r : r + h, c : c + w] != BACKGROUND):
        return False
    paste(grid, patch, r, c)
    return True


def _gen_assign_patches(sprites: list[dict]) -> None:
    pairs = _gen_color_pairs(len(sprites))
    for sp, colors in zip(sprites, pairs):
        sp["patch"] = _gen_checker(sp["side"], colors)


def _gen_render_output(sprites: list[dict]) -> np.ndarray | None:
    out = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=int)
    for sp in sprites:
        if not _gen_place(out, sp["patch"], sp["r"], sp["c"]):
            return None
    return out


def _gen_render_input(chains: list[dict]) -> np.ndarray | None:
    inp = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=int)
    for chain in chains:
        shifts = _gen_assign_shifts(chain)
        if shifts is None:
            return None
        for idx, sp in enumerate(chain["sprites"]):
            if not _gen_place(inp, sp["patch"], sp["r"], sp["c"] - shifts[idx]):
                return None
    return inp


def _gen_validates(inp: np.ndarray, out: np.ndarray, sprite_count: int) -> bool:
    if len(components_mask(inp != BACKGROUND, connectivity=CONNECTIVITY)) != sprite_count:
        return False
    return np.array_equal(main(inp), out)


def _gen_attempt() -> np.ndarray | None:
    chain_sizes = list(_gen_chain_sizes())
    sides = [random.choice(SPRITE_SIDES) for _ in range(sum(chain_sizes))]

    chains: list[dict] = []
    pos = 0
    for n_sprites in chain_sizes:
        chain = _gen_build_chain(n_sprites, sides[pos : pos + n_sprites])
        if chain is None:
            return None
        chains.append(chain)
        pos += n_sprites

    if not _gen_pack_chains(chains):
        return None

    all_sprites = [sp for chain in chains for sp in chain["sprites"]]
    _gen_assign_patches(all_sprites)

    out = _gen_render_output(all_sprites)
    if out is None:
        return None

    inp = _gen_render_input(chains)
    if inp is None:
        return None
    if not _gen_validates(inp, out, len(all_sprites)):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid d282b262 input")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, crop_bbox, find_components, get_bg, is_contiguous, paste
import itertools
import random


SpriteCopy = tuple[tuple[int, int, int, int], np.ndarray]


def _sprite_copies_by_color(g: np.ndarray, bg: int, colors: list[int]) -> dict[int, list[SpriteCopy]]:
    copies: dict[int, list[SpriteCopy]] = {color: [] for color in colors}
    for comp in find_components(g, bg=bg, connectivity=8, monochromatic=True):
        color = int(comp["color"])
        assert color in copies, "component color must be one of the two foreground colors"

        b = comp["bbox"]
        region = crop_bbox(g, b)
        assert np.all((region == bg) | (region == color)), "each sprite bbox must contain only its sprite and bg"

        mask = crop_bbox(g == color, b)
        assert int(mask.sum()) == int(comp["area"]), "sprite bbox must not enclose another same-color sprite"
        copies[color].append((b, mask))
    return copies


def _templates(copies: dict[int, list[SpriteCopy]], colors: list[int]) -> dict[int, np.ndarray]:
    out: dict[int, np.ndarray] = {}
    for color in colors:
        masks = [mask for _, mask in copies[color]]
        assert masks, "each foreground color must have at least one sprite"
        shape = masks[0].shape
        assert all(mask.shape == shape for mask in masks), "same-color sprite bboxes must have one size"
        template = masks[0]
        assert all(np.array_equal(mask, template) for mask in masks), "same-color sprites must share one mask"
        out[color] = template
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Exchange the two foreground sprite masks while keeping every copy in its original bounding box.

    Input structure:
    - The dominant color is the background.
    - Exactly two foreground colors are present.
    - Each foreground color forms one or more copies of a single 8-connected sprite mask.
    - The two sprite masks have the same bounding-box size.

    Rule:
    - Clear every sprite bounding box.
    - In each cleared box, draw the other foreground color's template mask in that other color.
    - Apply the replacements simultaneously, so all original boxes are cleared before any template is redrawn.

    Key insight:
    The colors identify two reusable sprite templates, and each template is the replacement shape for the other color.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected exactly two foreground colors"

    copies = _sprite_copies_by_color(g, bg, colors)
    templates = _templates(copies, colors)

    color_a, color_b = colors
    assert templates[color_a].shape == templates[color_b].shape, "the two templates must fit the same bboxes"
    other_color = {color_a: color_b, color_b: color_a}

    out = g.copy()
    for color in colors:
        for (r0, c0, r1, c1), _mask in copies[color]:
            out[r0 : r1 + 1, c0 : c1 + 1] = bg

    for color in colors:
        target_color = other_color[color]
        target_mask = templates[target_color]
        patch = np.full(target_mask.shape, bg, dtype=int)
        patch[target_mask] = target_color
        for (r0, c0, _r1, _c1), _mask in copies[color]:
            paste(out, patch, r0, c0)

    return out

# --------------- generator (o5x) ---------------

# Canvas size bounds.
GRID_HEIGHT_RANGE = (9, 11)
GRID_WIDTH_RANGE = (10, 17)
# Sprite mask shape and density constraints.
SPRITE_BOX_SHAPES = ((2, 2), (2, 3), (3, 3))
MASK_MIN_CELLS = 2
MASK_MAX_CELLS = 6
MASK_MIN_DENSITY = (1, 2)
MASK_MAX_DENSITY = (3, 4)
MASK_CONNECTIVITY = 8
# Color and copy-count sampling.
FOREGROUND_COLOR_IDS = range(1, 10)
REPEAT_COUNT_RANGE = (2, 5)
SINGLETON_FIRST_PROB = 0.5
# Placement constraints and retry limits.
EDGE_GAP = 1
PLACEMENT_NODE_LIMIT = 8000
GENERATION_RETRIES = 300


def _gen_spans_full_box(mask: np.ndarray) -> bool:
    return bool(mask.any() and mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())


def _gen_valid_masks(h: int, w: int) -> tuple[np.ndarray, ...]:
    """Return cached connected masks whose bbox is the full sprite box."""
    key = (int(h), int(w))
    cache = getattr(_gen_valid_masks, "_cache", {})
    if key in cache:
        return cache[key]

    h, w = key
    total = h * w
    min_num, min_den = MASK_MIN_DENSITY
    max_num, max_den = MASK_MAX_DENSITY
    min_area = max(MASK_MIN_CELLS, (total * min_num + min_den - 1) // min_den)
    max_area = min(MASK_MAX_CELLS, (total * max_num) // max_den)
    valid = []
    for area in range(min_area, max_area + 1):
        for combo in itertools.combinations(range(total), area):
            mask = np.zeros((h, w), dtype=bool)
            for idx in combo:
                mask[idx // w, idx % w] = True
            if _gen_spans_full_box(mask) and is_contiguous(mask, background=0, connectivity=MASK_CONNECTIVITY):
                valid.append(mask)

    cache[key] = tuple(valid)
    setattr(_gen_valid_masks, "_cache", cache)
    return cache[key]


def _gen_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.zeros(mask.shape, dtype=int)
    patch[mask] = int(color)
    return patch


def _gen_rect_overlap(a: tuple[int, int], b: tuple[int, int], shape: tuple[int, int]) -> bool:
    ar, ac = a
    br, bc = b
    h, w = shape
    return not (ar + h <= br or br + h <= ar or ac + w <= bc or bc + w <= ac)


def _gen_cells(mask: np.ndarray, r0: int, c0: int) -> list[tuple[int, int]]:
    return [(int(r0 + r), int(c0 + c)) for r, c in np.argwhere(mask)]


def _gen_touching(cells_a: list[tuple[int, int]], cells_b: list[tuple[int, int]]) -> bool:
    for ar, ac in cells_a:
        for br, bc in cells_b:
            if abs(ar - br) <= 1 and abs(ac - bc) <= 1:
                return True
    return False


def _gen_can_place(placed, item, r0: int, c0: int, shape: tuple[int, int], new_cells) -> bool:
    color = item[0]
    for old_color, _old_mask, _old_sep, old_r, old_c, old_cells in placed:
        if _gen_rect_overlap((r0, c0), (old_r, old_c), shape):
            return False
        if old_color == color:
            if _gen_touching(new_cells, old_cells):
                return False
    return True


def _gen_place_boxes(height: int, width: int, items, shape: tuple[int, int]):
    """Place boxes without bbox overlap or same-color 8-touching cells."""
    h, w = shape
    positions = [
        (r, c) for r in range(EDGE_GAP, height - h - EDGE_GAP + 1) for c in range(EDGE_GAP, width - w - EDGE_GAP + 1)
    ]
    random.shuffle(items)
    counts = {color: sum(1 for item_color, _mask, _sep in items if item_color == color) for color, _mask, _sep in items}
    items.sort(key=lambda item: -counts[item[0]])
    placed: list[tuple[int, np.ndarray, np.ndarray, int, int, list[tuple[int, int]]]] = []
    nodes = 0

    def search(idx: int) -> bool:
        nonlocal nodes
        nodes += 1
        if nodes > PLACEMENT_NODE_LIMIT:
            return False
        if idx == len(items):
            return True

        item = items[idx]
        candidates = positions[:]
        random.shuffle(candidates)
        for r0, c0 in candidates:
            color, mask, sep_mask = item
            new_cells = _gen_cells(sep_mask, r0, c0)
            if not _gen_can_place(placed, item, r0, c0, shape, new_cells):
                continue
            placed.append((color, mask, sep_mask, r0, c0, new_cells))
            if search(idx + 1):
                return True
            placed.pop()
        return False

    if not search(0):
        return None
    return [(color, mask, r0, c0) for color, mask, _sep, r0, c0, _cells in placed]


def _gen_copy_counts() -> tuple[int, int]:
    repeat_count = random.randint(*REPEAT_COUNT_RANGE)
    if random.random() < SINGLETON_FIRST_PROB:
        return 1, repeat_count
    return repeat_count, 1


def _gen_items(colors: list[int], masks: tuple[np.ndarray, np.ndarray], counts: tuple[int, int]) -> list[tuple[int, np.ndarray, np.ndarray]]:
    color_a, color_b = colors
    mask_a, mask_b = masks
    count_a, count_b = counts
    sep_mask = mask_a | mask_b
    return [(color_a, mask_a, sep_mask)] * count_a + [(color_b, mask_b, sep_mask)] * count_b


def _gen_render_grids(height: int, width: int, colors, masks, placed):
    """Render the output grid and the swapped-mask input grid."""
    out = np.zeros((height, width), dtype=int)
    inp = np.zeros((height, width), dtype=int)

    color_a, color_b = colors
    mask_a, mask_b = masks
    replacement = {color_a: (color_b, mask_b), color_b: (color_a, mask_a)}

    for color, mask, r0, c0 in placed:
        paste(out, _gen_patch(mask, color), r0, c0)
        other_color, other_mask = replacement[color]
        paste(inp, _gen_patch(other_mask, other_color), r0, c0)

    return inp, out


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*GRID_HEIGHT_RANGE)
    width = random.randint(*GRID_WIDTH_RANGE)
    shape = random.choice(SPRITE_BOX_SHAPES)
    colors = random.sample(FOREGROUND_COLOR_IDS, 2)
    masks = tuple(random.sample(_gen_valid_masks(*shape), 2))
    counts = _gen_copy_counts()

    items = _gen_items(colors, masks, counts)
    placed = _gen_place_boxes(height, width, items, shape)
    if placed is None:
        return None

    inp, out = _gen_render_grids(height, width, colors, masks, placed)
    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 3391f8c0 input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components, is_contiguous as _gen_is_contiguous, paste as _gen_paste, random_free_location as _gen_random_free_location
import random as _gen_random


def _boundary_background(g: np.ndarray) -> int:
    boundary = np.concatenate((g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]))
    colors, counts = np.unique(boundary, return_counts=True)
    assert colors.size > 0, "expected a nonempty grid boundary"

    max_count = int(counts.max())
    winners = [int(color) for color, count in zip(colors, counts) if int(count) == max_count]
    assert len(winners) == 1, "expected a unique boundary background color"
    return winners[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Extract the unique smallest solid monochrome rectangle as the entire output grid.

    Input structure
    - The empty canvas color is the unique most common color on the grid boundary.
    - Non-background pixels form one or more 4-connected monochrome objects.
    - At least one non-background object is a filled axis-aligned rectangle.

    Rule
    - Find every monochrome non-background object whose pixels exactly fill its bounding box.
    - Select the unique filled rectangle with the smallest area.
    - Return a solid grid with the selected rectangle's height, width, and color.

    Key insight
    - Other objects are distractor rectangles or partial rectangles; the output is the
      smallest complete rectangular object, detached from its original position.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert min(g.shape) > 0, "expected a nonempty grid"

    bg = _boundary_background(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert objects, "expected at least one non-background object"

    rectangles = []
    for obj in objects:
        box = obj["bbox"]
        height = bbox_h(box)
        width = bbox_w(box)
        if int(obj["area"]) == height * width:
            rectangles.append((int(obj["area"]), int(obj["color"]), height, width))

    assert rectangles, "expected at least one filled rectangle"
    min_area = min(area for area, _color, _height, _width in rectangles)
    smallest = [rect for rect in rectangles if rect[0] == min_area]
    assert len(smallest) == 1, "expected a unique smallest filled rectangle"

    _area, color, height, width = smallest[0]
    return np.full((height, width), color, dtype=int)

# --------------- generator (o5x) ---------------

# Canvas/object size bounds.
GEN_BACKGROUND = 0
GEN_GRID_MAX_DIM = 20
GEN_MIN_GRID_DIM_BY_OBJECT_COUNT = {2: 10, 3: 10, 4: 12, 5: 14}
GEN_SIZE_CAP_BY_OBJECT_COUNT = {2: 12, 3: 12, 4: 9, 5: 7}

# Counts, palette, and target bounds.
GEN_OBJECT_COUNT_RANGE = (2, 5)
GEN_RECT_NONRECT_COUNTS_BY_OBJECT_COUNT = {
    2: [(0, 1), (1, 0)],
    3: [(0, 2), (1, 1), (2, 0)],
    4: [(1, 2), (2, 1)],
    5: [(2, 2)],
}
GEN_COLOR_RANGE = (1, 9)
GEN_TARGET_HEIGHT_RANGE, GEN_TARGET_WIDTH_RANGE = (2, 3), (2, 4)

# Shape, placement, and retry filters.
GEN_DISTRACTOR_RECT_MIN_DIM, GEN_NONRECT_MIN_DIM = 2, 3
GEN_DISTRACTOR_AREA_RATIO_RANGE = (2, 7)
GEN_NONRECT_FILL_RANGE = (0.67, 0.95)
GEN_CONNECTIVITY = 4
GEN_TOUCHING_BORDER, GEN_INTERIOR_BORDER = 0, 1
GEN_EMBEDDED_NONRECT_PROB, GEN_ALLOW_BOUNDARY_TOUCH_PROB = 0.65, 0.7
GEN_RETRY_LIMIT = 300


def _gen_boundary_bg_ok(g: np.ndarray) -> bool:
    boundary = np.concatenate((g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]))
    colors, counts = np.unique(boundary, return_counts=True)
    max_count = int(counts.max())
    winners = [int(color) for color, count in zip(colors, counts) if int(count) == max_count]
    return winners == [GEN_BACKGROUND]


def _gen_place_patch(canvas: np.ndarray, patch: np.ndarray, border: int) -> bool:
    try:
        r0, c0 = _gen_random_free_location(canvas, patch, transparent=GEN_BACKGROUND, border=border)
    except ValueError:
        return False
    _gen_paste(canvas, patch, r0, c0, transparent=GEN_BACKGROUND)
    return True


def _gen_rect_patch(height: int, width: int, color: int) -> np.ndarray:
    return np.full((int(height), int(width)), int(color), dtype=int)


def _gen_distractor_rect_patch(grid_h: int, grid_w: int, target_area: int, color: int, size_cap: int) -> np.ndarray | None:
    area_ratio_min, area_ratio_max = GEN_DISTRACTOR_AREA_RATIO_RANGE
    lo = area_ratio_min * int(target_area)
    hi = area_ratio_max * int(target_area)
    max_h, max_w = min(int(grid_h) - 1, int(size_cap)), min(int(grid_w) - 1, int(size_cap))
    candidates = [
        (h, w)
        for h in range(GEN_DISTRACTOR_RECT_MIN_DIM, max_h + 1)
        for w in range(GEN_DISTRACTOR_RECT_MIN_DIM, max_w + 1)
        if lo <= h * w <= hi
    ]
    if not candidates:
        return None
    h, w = _gen_random.choice(candidates)
    return _gen_rect_patch(h, w, color)


def _gen_notched_nonrect_patch(grid_h: int, grid_w: int, target_area: int, color: int, size_cap: int) -> np.ndarray | None:
    max_h, max_w = min(int(grid_h) - 1, int(size_cap)), min(int(grid_w) - 1, int(size_cap))
    fill_min, fill_max = GEN_NONRECT_FILL_RANGE
    candidates: list[tuple[int, int, str, int, int, int]] = []
    for h in range(GEN_NONRECT_MIN_DIM, max_h + 1):
        for w in range(GEN_NONRECT_MIN_DIM, max_w + 1):
            area = h * w
            for side in ("top", "bottom"):
                for length in range(1, w - 1):
                    for start in range(1, w - length):
                        for depth in range(1, h):
                            removed = length * depth
                            fill = (area - removed) / area
                            if fill_min <= fill <= fill_max and area - removed > target_area:
                                candidates.append((h, w, side, start, length, depth))
            for side in ("left", "right"):
                for length in range(1, h - 1):
                    for start in range(1, h - length):
                        for depth in range(1, w):
                            removed = length * depth
                            fill = (area - removed) / area
                            if fill_min <= fill <= fill_max and area - removed > target_area:
                                candidates.append((h, w, side, start, length, depth))

    if not candidates:
        return None

    h, w, side, start, length, depth = _gen_random.choice(candidates)
    patch = np.full((h, w), int(color), dtype=int)
    if side == "top":
        patch[:depth, start : start + length] = GEN_BACKGROUND
    elif side == "bottom":
        patch[h - depth :, start : start + length] = GEN_BACKGROUND
    elif side == "left":
        patch[start : start + length, :depth] = GEN_BACKGROUND
    else:
        patch[start : start + length, w - depth :] = GEN_BACKGROUND

    if not _gen_is_contiguous(patch, background=GEN_BACKGROUND, connectivity=GEN_CONNECTIVITY):
        return None
    return patch


def _gen_embedded_nonrect(
    canvas: np.ndarray, target_r: int, target_c: int, target_h: int, target_w: int, color: int, size_cap: int
) -> bool:
    grid_h, grid_w = canvas.shape
    target_area = int(target_h) * int(target_w)
    fill_min, fill_max = GEN_NONRECT_FILL_RANGE
    candidates: list[tuple[int, int, int, int]] = []
    for top in range(1, int(target_r) + 1):
        for bottom in range(1, int(grid_h) - int(target_r) - int(target_h) + 1):
            for left in range(1, int(target_c) + 1):
                for right in range(1, int(grid_w) - int(target_c) - int(target_w) + 1):
                    full_h = int(target_h) + top + bottom
                    full_w = int(target_w) + left + right
                    if full_h > int(size_cap) or full_w > int(size_cap):
                        continue
                    full_area = full_h * full_w
                    fill = (full_area - target_area) / full_area
                    if fill_min <= fill <= fill_max and full_area - target_area > target_area:
                        candidates.append((top, bottom, left, right))
    if not candidates:
        return False

    top, bottom, left, right = _gen_random.choice(candidates)
    full_h = int(target_h) + top + bottom
    full_w = int(target_w) + left + right
    patch = np.full((full_h, full_w), int(color), dtype=int)
    patch[top : top + int(target_h), left : left + int(target_w)] = GEN_BACKGROUND
    if not _gen_is_contiguous(patch, background=GEN_BACKGROUND, connectivity=GEN_CONNECTIVITY):
        return False

    r0 = int(target_r) - top
    c0 = int(target_c) - left
    if np.any((canvas[r0 : r0 + full_h, c0 : c0 + full_w] != GEN_BACKGROUND) & (patch != GEN_BACKGROUND)):
        return False
    _gen_paste(canvas, patch, r0, c0, transparent=GEN_BACKGROUND)
    return True


def _gen_sample_layout() -> tuple[int, int, int, int, int, int]:
    """Sample counts and canvas size; return object/rect/nonrect counts, H/W, size cap."""
    min_objects, max_objects = GEN_OBJECT_COUNT_RANGE
    object_count = _gen_random.randint(min_objects, max_objects)
    rect_count, nonrect_count = _gen_random.choice(
        GEN_RECT_NONRECT_COUNTS_BY_OBJECT_COUNT[object_count]
    )
    min_grid_dim = GEN_MIN_GRID_DIM_BY_OBJECT_COUNT[object_count]
    grid_h = _gen_random.randint(min_grid_dim, GEN_GRID_MAX_DIM)
    grid_w = _gen_random.randint(min_grid_dim, GEN_GRID_MAX_DIM)
    size_cap = GEN_SIZE_CAP_BY_OBJECT_COUNT[object_count]
    return object_count, rect_count, nonrect_count, grid_h, grid_w, size_cap


def _gen_build_distractor_patches(
    grid_h, grid_w, target_area, colors, color_i, rect_count, nonrect_count, size_cap
) -> list[np.ndarray] | None:
    """Build unplaced distractor patches in color order, or None if candidates fail."""
    patches: list[np.ndarray] = []
    for _ in range(rect_count):
        patch = _gen_distractor_rect_patch(grid_h, grid_w, target_area, colors[color_i], size_cap)
        if patch is None:
            return None
        patches.append(patch)
        color_i += 1
    for _ in range(nonrect_count):
        patch = _gen_notched_nonrect_patch(grid_h, grid_w, target_area, colors[color_i], size_cap)
        if patch is None:
            return None
        patches.append(patch)
        color_i += 1
    return patches


def _gen_place_distractor_patches(canvas: np.ndarray, patches: list[np.ndarray]) -> bool:
    """Shuffle and place each distractor, allowing boundary contact at the original rate."""
    _gen_random.shuffle(patches)
    for patch in patches:
        border = GEN_TOUCHING_BORDER if _gen_random.random() < GEN_ALLOW_BOUNDARY_TOUCH_PROB else GEN_INTERIOR_BORDER
        if not _gen_place_patch(canvas, patch, border):
            return False
    return True


def _gen_attempt() -> np.ndarray | None:
    object_count, rect_count, nonrect_count, grid_h, grid_w, size_cap = _gen_sample_layout()
    canvas = np.zeros((grid_h, grid_w), dtype=int)

    target_h = _gen_random.randint(*GEN_TARGET_HEIGHT_RANGE)
    target_w = _gen_random.randint(*GEN_TARGET_WIDTH_RANGE)
    target_area = target_h * target_w
    color_min, color_max = GEN_COLOR_RANGE
    colors = _gen_random.sample(range(color_min, color_max + 1), object_count)
    target_color = colors[0]

    target = _gen_rect_patch(target_h, target_w, target_color)
    try:
        target_r, target_c = _gen_random_free_location(canvas, target, transparent=GEN_BACKGROUND, border=GEN_INTERIOR_BORDER)
    except ValueError:
        return None
    _gen_paste(canvas, target, target_r, target_c, transparent=GEN_BACKGROUND)

    color_i = 1
    if nonrect_count and _gen_random.random() < GEN_EMBEDDED_NONRECT_PROB:
        if _gen_embedded_nonrect(canvas, target_r, target_c, target_h, target_w, colors[color_i], size_cap):
            nonrect_count -= 1
            color_i += 1

    patches = _gen_build_distractor_patches(grid_h, grid_w, target_area, colors, color_i, rect_count, nonrect_count, size_cap)
    if patches is None:
        return None
    if not _gen_place_distractor_patches(canvas, patches):
        return None

    if not _gen_boundary_bg_ok(canvas):
        return None

    expected = np.full((target_h, target_w), target_color, dtype=int)
    try:
        actual = main(canvas)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return canvas


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input")

