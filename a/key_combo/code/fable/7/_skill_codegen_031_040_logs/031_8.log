        red_mask = random.choice(masks).copy()
        return h, w, red_mask, _gen_support_mask(h, w, red_mask)

    h, w = random.choice(_GEN_UNSUPPORTED_DIMS)
    return h, w, np.ones((h, w), dtype=bool), np.zeros((h, w), dtype=bool)


