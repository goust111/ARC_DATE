# Size, palette, and fill bounds.
PANEL_H_RANGE, WIDTH_RANGE = (3, 10), (3, 10)
FOREGROUND_COLORS = range(1, 10)
OUTPUT_FILL_PCT, PANEL_FILL_PCT = (85, 96), (36, 72)
# Structural and retry limits.
MAX_PANEL_COMPONENTS, GENERATION_RETRIES = 8, 300

def _pct_bounds(n, pct_range):
    return (pct_range[0] * n + 99) // 100, (pct_range[1] * n) // 100

def _gen_count_options(n, min_panel, max_panel):
    out_lo, out_hi = _pct_bounds(n, OUTPUT_FILL_PCT)
    by_filled = {}
    for filled in range(out_lo, out_hi + 1):
        triples = []
        for bot_count in range(min_panel, max_panel + 1):
            rem = filled - bot_count
            for top_count in range(1, min(max_panel - 1, rem - 1) + 1):
                mid_count = rem - top_count
                if 1 <= mid_count <= max_panel - 1:
                    triples.append((top_count, mid_count, bot_count))
        if triples:
            by_filled[filled] = triples
    return by_filled

def _sample_visible_plan(n, min_panel, max_panel):
    count_options = _gen_count_options(n, min_panel, max_panel)
    if not count_options:
        return None
    filled = random.choice(list(count_options))
    top_count, mid_count, bot_count = random.choice(count_options[filled])
    colors = random.sample(FOREGROUND_COLORS, 3)
    flat = list(range(n))
    random.shuffle(flat)
    bot_idx = flat[:bot_count]
    top_idx = flat[bot_count : bot_count + top_count]
    mid_idx = flat[bot_count + top_count : bot_count + top_count + mid_count]
    return colors, (top_idx, mid_idx, bot_idx)

def _render_visible_layers(panel_h, width, colors, indices):
    top_idx, mid_idx, bot_idx = indices
    top, middle, bottom = [np.zeros((panel_h, width), dtype=int) for _ in range(3)]
    for panel, idx, color in (
        (top, top_idx, colors[0]),
        (middle, mid_idx, colors[1]),
        (bottom, bot_idx, colors[2]),
    ):
        panel.flat[idx] = color
    out = top + middle + bottom
    return out, top, middle, bottom

def _add_hidden_overlap(top, middle, colors, indices, min_panel, max_panel):
    c_top, c_mid, _ = colors
    top_idx, mid_idx, bot_idx = indices
    top_count, mid_count, bot_count = map(len, (top_idx, mid_idx, bot_idx))
    top_low = max(min_panel, top_count + 1)
    top_high = min(max_panel, top_count + bot_count)
    mid_low = max(min_panel, mid_count + 1)
    mid_high = min(max_panel, mid_count + top_count + bot_count)
    if top_low > top_high or mid_low > mid_high:
        return None

    top_target = random.randint(top_low, top_high)
    top_hidden = random.sample(bot_idx, top_target - top_count)
    top.flat[top_hidden] = c_top
    shared_hidden = random.choice(top_hidden)
    mid_target = random.randint(mid_low, mid_high)
    mid_pool = [i for i in top_idx + bot_idx if i != shared_hidden]
    mid_hidden = [shared_hidden] + random.sample(mid_pool, mid_target - mid_count - 1)
    middle.flat[mid_hidden] = c_mid
    return True

def _panel_component_count(panel):
    return len(find_components((panel != 0).astype(int), bg=0, connectivity=4, monochromatic=True))

def _panels_are_valid(panels, min_panel, max_panel):
    top, middle, bottom = panels
    counts = [int(np.count_nonzero(panel)) for panel in panels]
    overlaps = ((top, middle), (top, bottom), (middle, bottom))
    return (
        all(min_panel <= count <= max_panel for count in counts)
        and all(_panel_component_count(panel) <= MAX_PANEL_COMPONENTS for panel in panels)
        and all(np.any((a != 0) & (b != 0)) for a, b in overlaps)
    )

def _checked_input(panels, out):
    inp = np.vstack(panels)
    try:
        return inp if np.array_equal(main(inp), out) else None
    except Exception:
        return None

def _gen_attempt():
    panel_h, width = random.randint(*PANEL_H_RANGE), random.randint(*WIDTH_RANGE)
    n = panel_h * width
    min_panel, max_panel = _pct_bounds(n, PANEL_FILL_PCT)
    plan = _sample_visible_plan(n, min_panel, max_panel)
    if plan is None:
        return None
    colors, indices = plan
    out, top, middle, bottom = _render_visible_layers(panel_h, width, colors, indices)
    if not _add_hidden_overlap(top, middle, colors, indices, min_panel, max_panel):
        return None

    panels = (top, middle, bottom)
    if not _panels_are_valid(panels, min_panel, max_panel):
        return None
    return _checked_input(panels, out)

def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_anchor, colors_present, draw_line, find_components

# concepts:
# downscaling

# description:
# In the input you will see horizontal and vertical bars/dividers of a particular color that define rectangular regions, with some of the single-pixel vertices colored differently.
# Some rectangular regions are have same color on the four vertices, and some are not.
# To make the output, find the regions colored differently on all vertices and produce a single output pixel of that color in the corresponding part of the output.
# Ignore regions which just have the color of the horizontal and vertical bars at their vertices.

def main(input_grid):
    """
    Convert marked divider-grid cells into pixels colored by matching corner markers.

    Input structure:
    - The input has divider bars of one color forming rectangular regions.
    - Some region vertices are single pixels in colors different from the divider.
    - A valid marked region has all four diagonal corner markers in the same color.

    Rule:
    - Identify the divider color and crop to the area spanned by special vertex pixels.
    - Find black regions bounded by the divider color.
    - Emit the shared corner color for regions with four matching non-divider markers, otherwise black.

    Key insight:
    - Colored vertices label regions, while the divider color only defines the grid structure.
    """
    # Plan:
    # 1. Parse the input into  dividers, regions, and vertices
    # 2. Extract the regions colored differently from the divider on all vertices
    # 3. Produce the output grid by representing each region with a single pixel of the color of its vertices, as long as its color is not the divider

    # 1. Parse the input
    # Detect the objects
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
    
    # The divider color is the most frequent non-background color, and the background is black
    divider_color = max(Color.NOT_BLACK, key=lambda color: np.sum(input_grid == color))

    # Detect the single pixels that form the vertices of the regions (non-divider, non-background).
    pixels: list[tuple[int, int]] = []
    for obj in objects:
        _b = bbox(obj != Color.BLACK)
        if _b is None:
            continue
        r0, c0, r1, c1 = _b
        if r0 == r1 and c0 == c1:
            col = int(input_grid[r0, c0])
            if col != int(Color.BLACK) and col != int(divider_color):
                pixels.append((r0, c0))
    r_positions = [rc[0] for rc in pixels]
    c_positions = [rc[1] for rc in pixels]

    # Ignore regions that are not part of those special pixels
    r_min, r_max = min(r_positions), max(r_positions)
    c_min, c_max = min(c_positions), max(c_positions)
    input_grid = input_grid[r_min:r_max+1, c_min:c_max+1]

    # Extract just the black regions delimited by the divider color
    regions = find_components(input_grid, bg=divider_color, connectivity=4, monochromatic=True, return_format="objects")
    regions = [region for region in regions if colors_present(region, exclude={ divider_color }) == [Color.BLACK]]

    # 2. Analyze vertices, which live on the diagonal corners of the regions, to find the color of the regions
    # Determine their colors by the colors of their vertices, so we are going to have to look at the corners
    def diagonal_corners(obj, background):
        _b = bbox(obj != background)
        assert _b is not None
        r, c, _r1, _c1 = _b
        w = _r1 - r + 1
        h = _c1 - c + 1
        return [(r-1, c-1), (r + w, c-1), (r-1, c + h), (r + w, c + h)]
    
    region_colors = []
    for region in regions:
        corners = [
            (rr, cc)
            for rr, cc in diagonal_corners(region, background=divider_color)
            if 0 <= rr < input_grid.shape[0] and 0 <= cc < input_grid.shape[1]
        ]
        if len(corners) != 4:
            region_colors.append(Color.BLACK)
            continue
        vertex_colors = {int(input_grid[rr, cc]) for rr, cc in corners}
        if len(vertex_colors) == 1 and vertex_colors != {divider_color}:
            region_colors.append(vertex_colors.pop())
        else:
            region_colors.append(Color.BLACK)

    # 3. Produce the output grid, representing each big region as a single pixel
    
    # Find the number distinct X/Y positions of the regions, which tells us the size of the output
    r_positions = sorted({bbox_anchor(bbox(region != divider_color), anchor="upper left")[0] for region in regions})
    c_positions = sorted({bbox_anchor(bbox(region != divider_color), anchor="upper left")[1] for region in regions})

    # Make the output
    output_grid = np.full((len(r_positions), len(c_positions)), Color.BLACK)

    for region, color in zip(regions, region_colors):
        _b = bbox(region != divider_color)
        assert _b is not None
        r, c = bbox_anchor(_b, anchor="upper left")
        output_grid[r_positions.index(r), c_positions.index(c)] = color
    
    return output_grid
            
def generate_input():
    # Grid of square regions separated by divider lines; some regions have same-colored vertices.
    square_size = int(np.random.randint(2, 4))
    square_num = int(np.random.randint(6, 30 // (square_size + 1)))

    H = square_size * square_num + square_num - 1
    W = H
    grid = np.full((H, W), Color.BLACK, dtype=int)

    divider_color = int(np.random.choice(Color.NOT_BLACK))
    other_colors = [int(c) for c in Color.NOT_BLACK if int(c) != divider_color]

    # Full divider rows/cols.
    for r in range(square_size, H, square_size + 1):
        grid[r, :] = divider_color
    for c in range(square_size, W, square_size + 1):
        grid[:, c] = divider_color

    # Choose interior regions (not on the border) and color all 4 vertices the same.
    starts = list(range(0, H, square_size + 1))
    candidates = [
        (r0, c0)
        for r0 in starts
        for c0 in starts
        if r0 > 0 and c0 > 0 and (r0 + square_size) < H and (c0 + square_size) < W
    ]
    random.shuffle(candidates)
    for (r0, c0) in candidates[:6]:
        r1 = r0 + square_size - 1
        c1 = c0 + square_size - 1
        corners = [(r0 - 1, c0 - 1), (r1 + 1, c0 - 1), (r0 - 1, c1 + 1), (r1 + 1, c1 + 1)]
        col = random.choice(other_colors)
        for rr, cc in corners:
            grid[rr, cc] = col

    return grid
import numpy as np

from arc_utils import get_bg
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Move each interior marker to the cell just inside the matching-color frame side.

    Input structure
    The grid has background-colored corners, a one-cell rectangular frame, and a
    background interior containing colored marker pixels.

    Rule
    Clear the frame interior. If an interior marker has the top, bottom, left, or
    right frame-side color, repaint it just inside that side while preserving its
    original column or row. Interior colors not used by any frame side disappear.

    Key insight
    The four side colors are directional labels, so each marker's color selects
    the target side and its orthogonal coordinate supplies the placement.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)

    assert h >= 3 and w >= 3
    assert g[0, 0] == g[0, w - 1] == g[h - 1, 0] == g[h - 1, w - 1] == bg

    top = int(g[0, 1])
    bottom = int(g[h - 1, 1])
    left = int(g[1, 0])
    right = int(g[1, w - 1])
    side_colors = {top, bottom, left, right}

    assert bg not in side_colors
    assert len(side_colors) == 4
    assert np.all(g[0, 1 : w - 1] == top)
    assert np.all(g[h - 1, 1 : w - 1] == bottom)
    assert np.all(g[1 : h - 1, 0] == left)
    assert np.all(g[1 : h - 1, w - 1] == right)

    out = g.copy()
    out[1 : h - 1, 1 : w - 1] = bg

    placements: dict[tuple[int, int], int] = {}
    for rr, cc in np.argwhere(g[1 : h - 1, 1 : w - 1] != bg):
        r = int(rr) + 1
        c = int(cc) + 1
        color = int(g[r, c])

        if color == top:
            target = (1, c)
        elif color == bottom:
            target = (h - 2, c)
        elif color == left:
            target = (r, 1)
        elif color == right:
            target = (r, w - 2)
        else:
            continue

        assert target not in placements or placements[target] == color
        placements[target] = color

    for (r, c), color in placements.items():
        out[r, c] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas and palette.
GRID_MIN, GRID_MAX = 10, 17
BACKGROUND, COLOR_MIN, COLOR_MAX = 0, 1, 9
# Marker count constraints.
SIDE_COUNT, MAX_MARKERS_PER_SIDE, MIN_ACTIVE_SIDES = 4, 3, 3
MATCHING_COUNT_MIN, MATCHING_COUNT_MAX = 5, 10
DISTRACTOR_COUNT_MIN, DISTRACTOR_COUNT_MAX = 1, 3
# Placement and retry policy.
MARKER_GAP, GENERATION_RETRIES = 1, 300
SIDE_NAMES = ("top", "bottom", "left", "right")
HORIZONTAL_SIDES = {"top", "bottom"}

def _gen_count_tuple(total):
    choices = [
        counts
        for counts in np.ndindex(*((MAX_MARKERS_PER_SIDE + 1,) * SIDE_COUNT))
        if sum(counts) == total and sum(v > 0 for v in counts) >= MIN_ACTIVE_SIDES
    ]
    return list(random.choice(choices))


def _gen_choose_targets(h, w, counts):
    side_specs = [
        (SIDE_NAMES[0], 1, range(1, w - 1)),
        (SIDE_NAMES[1], h - 2, range(1, w - 1)),
        (SIDE_NAMES[2], 1, range(1, h - 1)),
        (SIDE_NAMES[3], w - 2, range(1, h - 1)),
    ]
    order = list(range(SIDE_COUNT))
    random.shuffle(order)
    occupied = set()
    by_side = [[] for _ in range(SIDE_COUNT)]

    for idx in order:
        side, fixed, coords = side_specs[idx]
        available = []
        for coord in coords:
            cell = (fixed, coord) if side in HORIZONTAL_SIDES else (coord, fixed)
            if cell not in occupied:
                available.append(coord)
        if len(available) < counts[idx]:
            return None
        chosen = random.sample(available, counts[idx])
        for coord in chosen:
            cell = (fixed, coord) if side in HORIZONTAL_SIDES else (coord, fixed)
            occupied.add(cell)
            by_side[idx].append((side, coord, cell))

    return by_side


def _framed_grid(h, w, side_colors):
    top, bottom, left, right = side_colors
    grid = np.full((h, w), BACKGROUND, dtype=int)
    grid[0, 1 : w - 1] = top
    grid[h - 1, 1 : w - 1] = bottom
    grid[1 : h - 1, 0] = left
    grid[1 : h - 1, w - 1] = right
    return grid


def _is_free_with_gap(cell, occupied):
    r, c = cell
    return cell not in occupied and all(
        max(abs(r - rr), abs(c - cc)) > MARKER_GAP for rr, cc in occupied
    )


def _gen_place_input_marker(inp, marker, color, occupied):
    side, coord, _target = marker
    h, w = inp.shape
    if side in HORIZONTAL_SIDES:
        candidates = [
            (r, coord)
            for r in range(1, h - 1)
            if _is_free_with_gap((r, coord), occupied)
        ]
    else:
        candidates = [
            (coord, c)
            for c in range(1, w - 1)
            if _is_free_with_gap((coord, c), occupied)
        ]
    if not candidates:
        return False
    r, c = random.choice(candidates)
    inp[r, c] = color
    occupied.add((r, c))
    return True


def _render_output_markers(out, targets, side_colors):
    all_markers = []
    for side_idx, markers in enumerate(targets):
        color = side_colors[side_idx]
        for marker in markers:
            r, c = marker[2]
            out[r, c] = color
            all_markers.append((marker, color))
    return all_markers


def _place_matching_input_markers(inp, all_markers):
    occupied = set()
    random.shuffle(all_markers)
    for marker, color in all_markers:
        if not _gen_place_input_marker(inp, marker, color, occupied):
            return None
    return occupied


def _place_distractors(inp, side_colors, occupied):
    h, w = inp.shape
    distractor_colors = [
        c for c in range(COLOR_MIN, COLOR_MAX + 1) if c not in side_colors
    ]
    distractor_count = random.randint(DISTRACTOR_COUNT_MIN, DISTRACTOR_COUNT_MAX)
    for _ in range(distractor_count):
        free_cells = [
            (r, c)
            for r in range(1, h - 1)
            for c in range(1, w - 1)
            if _is_free_with_gap((r, c), occupied)
        ]
        if not free_cells:
            return False
        r, c = random.choice(free_cells)
        inp[r, c] = random.choice(distractor_colors)
        occupied.add((r, c))
    return True


def _gen_attempt():
    h, w = random.randint(GRID_MIN, GRID_MAX), random.randint(GRID_MIN, GRID_MAX)
    side_colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), SIDE_COUNT)

    total = random.randint(MATCHING_COUNT_MIN, MATCHING_COUNT_MAX)
    counts = _gen_count_tuple(total)
    targets = _gen_choose_targets(h, w, counts)
    if targets is None:
        return None

    out = _framed_grid(h, w, side_colors)
    all_markers = _render_output_markers(out, targets, side_colors)

    inp = _framed_grid(h, w, side_colors)
    occupied = _place_matching_input_markers(inp, all_markers)
    if occupied is None:
        return None

    if not _place_distractors(inp, side_colors, occupied):
        return None

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid d687bc17 input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox, is_contiguous
import itertools
import random


BG = 0
RED = 2
GRAY = 5


def _offsets(mask: np.ndarray) -> list[tuple[int, int]]:
    coords = np.argwhere(mask)
    return [(int(r), int(c)) for r, c in coords]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Stamp the red sprite into every matching empty slot in the gray-and-black pattern.

    Input structure
    - The grid uses black empty cells, gray support cells, and one red marker sprite.
    - The red sprite bbox defines the stamp mask.
    - Gray cells inside the sprite bbox define the support signature; if an enclosed interior gray support exists, it is the anchor signature.

    Rule
    - Scan candidate bbox positions from top-left to bottom-right.
    - A candidate matches when every red-mask position is still black and every support-signature position is gray.
    - If the sprite bbox has no gray support cells, only border-touching black slots of the same shape match.
    - Paint each matched red-mask position red, preserving all other cells.

    Key insight
    The red cells are a stamp; gray support inside the stamp window, or the grid border for unsupported solid stamps, identifies the blank copies to complete.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
    assert set(np.unique(g)).issubset({BG, RED, GRAY}), "expected only black, red, and gray"

    red_box = bbox(g == RED)
    assert red_box is not None, "expected a red sprite"
    r0, c0, r1, c1 = map(int, red_box)
    sprite = g[r0 : r1 + 1, c0 : c1 + 1]
    bh, bw = sprite.shape
    assert bh > 0 and bw > 0

    stamp = _offsets(sprite == RED)
    assert stamp, "expected at least one red stamp cell"

    gray_offsets = _offsets(sprite == GRAY)
    interior_gray = [
        (r, c)
        for r, c in gray_offsets
        if 0 < r < bh - 1 and 0 < c < bw - 1
    ]
    support = interior_gray or gray_offsets
    if not support:
        assert np.all(sprite == RED), "unsupported stamp should fill its bbox"

    h, w = g.shape
    out = g.copy()
    painted = 0
    for ar in range(h - bh + 1):
        for ac in range(w - bw + 1):
            cells = [(ar + dr, ac + dc) for dr, dc in stamp]
            if not all(out[r, c] == BG for r, c in cells):
                continue

            if support:
                if not all(g[ar + dr, ac + dc] == GRAY for dr, dc in support):
                    continue
            else:
                touches_border = ar == 0 or ac == 0 or ar + bh == h or ac + bw == w
                if not touches_border:
                    continue

            for r, c in cells:
                out[r, c] = RED
                painted += 1

    assert painted > 0, "expected at least one matching empty slot"
    return out

# --------------- generator (o5x) ---------------

# Palette and fixed canvas.
_GEN_BG, _GEN_RED, _GEN_GRAY = 0, 2, 5
_GEN_H, _GEN_W = 10, 10

# Sprite shape and support selection.
_GEN_SUPPORTED_PROB = 0.7
_GEN_SUPPORTED_DIMS = ((2, 3), (2, 4), (3, 2), (3, 3))
_GEN_UNSUPPORTED_DIMS = ((1, 4), (2, 2), (2, 3), (3, 2))
_GEN_MIN_RED, _GEN_MAX_RED = 4, 6
_GEN_MAX_SUPPORT = 3
_GEN_INTERIOR_SUPPORT_PROB = 0.45
_GEN_CONNECTIVITY = 4

# Placement count and gray density targets.
_GEN_MIN_PLACES, _GEN_MAX_PLACES = 2, 5
_GEN_MIN_GRAY, _GEN_MAX_GRAY = 43, 61

# Rejection-sampling limits.
_GEN_BLOCK_EXTRA_TRIES, _GEN_ATTEMPTS = 120, 300

_GEN_MASK_CACHE: dict[tuple[int, int, int], list[np.ndarray]] = {}


def _gen_offsets(mask: np.ndarray) -> list[tuple[int, int]]:
    return [(int(r), int(c)) for r, c in np.argwhere(mask)]


def _gen_mask_options(h: int, w: int, n: int) -> list[np.ndarray]:
    key = (h, w, n)
    if key in _GEN_MASK_CACHE:
        return _GEN_MASK_CACHE[key]

    opts = []
    for cells in itertools.combinations(range(h * w), n):
        mask = np.zeros((h, w), dtype=bool)
        rr, cc = np.unravel_index(cells, (h, w))
        mask[rr, cc] = True
        rs, cs = np.where(mask)
        if rs.min() != 0 or rs.max() != h - 1 or cs.min() != 0 or cs.max() != w - 1:
            continue
        if is_contiguous(mask.astype(int), background=0, connectivity=_GEN_CONNECTIVITY):
            opts.append(mask)
    _GEN_MASK_CACHE[key] = opts
    return opts


def _gen_touches_border(r: int, c: int, h: int, w: int) -> bool:
    return r == 0 or c == 0 or r + h == _GEN_H or c + w == _GEN_W


def _gen_windows_overlap(a: tuple[int, int], b: tuple[int, int], h: int, w: int) -> bool:
    ar, ac = a
    br, bc = b
    return not (ar + h <= br or br + h <= ar or ac + w <= bc or bc + w <= ac)


def _gen_pick_origins(h: int, w: int, n: int, border_only: bool) -> list[tuple[int, int]] | None:
    candidates = []
    for r in range(_GEN_H - h + 1):
        for c in range(_GEN_W - w + 1):
            if border_only and not _gen_touches_border(r, c, h, w):
                continue
            candidates.append((r, c))
    random.shuffle(candidates)

    picked: list[tuple[int, int]] = []
    for pos in candidates:
        if all(not _gen_windows_overlap(pos, old, h, w) for old in picked):
            picked.append(pos)
            if len(picked) == n:
                return picked
    return None


def _gen_matching_origins(
    grid: np.ndarray,
    h: int,
    w: int,
    stamp: list[tuple[int, int]],
    support: list[tuple[int, int]],
) -> list[tuple[int, int]]:
    matches = []
    for r in range(_GEN_H - h + 1):
        for c in range(_GEN_W - w + 1):
            if any(grid[r + dr, c + dc] != _GEN_BG for dr, dc in stamp):
                continue
            if support:
                if any(grid[r + dr, c + dc] != _GEN_GRAY for dr, dc in support):
                    continue
            elif not _gen_touches_border(r, c, h, w):
                continue
            matches.append((r, c))
    return matches


def _gen_block_extras(
    inp: np.ndarray,
    out: np.ndarray,
    h: int,
    w: int,
    stamp: list[tuple[int, int]],
    support: list[tuple[int, int]],
    targets: set[tuple[int, int]],
    protected: set[tuple[int, int]],
) -> bool:
    for _ in range(_GEN_BLOCK_EXTRA_TRIES):
        matches = _gen_matching_origins(inp, h, w, stamp, support)
        extras = [pos for pos in matches if pos not in targets]
        if not extras:
            return True

        r, c = random.choice(extras)
        stamp_cells = [(r + dr, c + dc) for dr, dc in stamp]
        random.shuffle(stamp_cells)
        for rr, cc in stamp_cells:
            if (rr, cc) not in protected and inp[rr, cc] == _GEN_BG:
                inp[rr, cc] = _GEN_GRAY
                out[rr, cc] = _GEN_GRAY
                break
        else:
            support_cells = [(r + dr, c + dc) for dr, dc in support]
            random.shuffle(support_cells)
            for rr, cc in support_cells:
                if (rr, cc) not in protected and inp[rr, cc] == _GEN_GRAY:
                    inp[rr, cc] = _GEN_BG
                    out[rr, cc] = _GEN_BG
                    break
            else:
                return False
    return False


def _gen_support_mask(h: int, w: int, red_mask: np.ndarray) -> np.ndarray:
    open_cells = [(r, c) for r in range(h) for c in range(w) if not red_mask[r, c]]
    interior = [(r, c) for r, c in open_cells if 0 < r < h - 1 and 0 < c < w - 1]
    support_mask = np.zeros((h, w), dtype=bool)
    if interior and random.random() < _GEN_INTERIOR_SUPPORT_PROB:
        support_mask[random.choice(interior)] = True
    else:
        support_n = random.randint(1, min(_GEN_MAX_SUPPORT, len(open_cells)))
        for r, c in random.sample(open_cells, support_n):
            support_mask[r, c] = True
    return support_mask


