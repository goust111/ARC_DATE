) -> tuple[set[tuple[int, int]], set[tuple[int, int]], set[tuple[int, int]]]:
    protected: set[tuple[int, int]] = set()
    stamp_cells: set[tuple[int, int]] = set()
    support_cells: set[tuple[int, int]] = set()
    for r0, c0 in origins:
