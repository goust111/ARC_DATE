                protected.add((r0 + dr, c0 + dc))
        for dr, dc in stamp:
            stamp_cells.add((r0 + dr, c0 + dc))
        for dr, dc in support:
            support_cells.add((r0 + dr, c0 + dc))
    return protected, stamp_cells, support_cells


