+    colors: list[int] = []
+    top, left, bottom, right = 0, 0, region.shape[0] - 1, region.shape[1] - 1
+    while top <= bottom and left <= right:
+        perimeter: list[int] = []
+        perimeter.extend(map(int, region[top, left : right + 1]))
+        if bottom > top:
+            perimeter.extend(map(int, region[bottom, left : right + 1]))
+        if bottom - top >= 2:
