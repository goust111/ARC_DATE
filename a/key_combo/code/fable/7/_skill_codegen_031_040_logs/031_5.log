+    margin = ring_count + 4
+    if rect_h + 2 * margin > h or rect_w + 2 * margin > w:
+        return None
+    r0 = random.randint(margin, h - rect_h - margin)
+    c0 = random.randint(margin, w - rect_w - margin)
