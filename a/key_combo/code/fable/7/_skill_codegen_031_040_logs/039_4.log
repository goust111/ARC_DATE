import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_anchor, colors_present, crop_bbox, draw_line, find_components, first_free_location, paste, random_sprite, scale_sprite

# concepts:
# puzzle pieces, rescaling

# description:
# In the input you will see a small multicolored object, and a big region bordered by 4 yellow pixels in the corners. The big region contains some colored things.
# To make the output, rescale and translate the small multicolored object so that it is in the big region and matches as much as possible the colors of the things in the big region.
# The output should be just the big region with its 4 yellow pixels (plus the rescaled and translated thing).

def main(input_grid):
    """
    Scale and place the external multicolor object into the yellow-cornered region where it matches existing colors.

    Input structure:
    - The input contains one small multicolor object outside a larger region.
    - Four yellow singleton pixels mark the corners of the larger output region.
    - The marked region contains partial colored evidence from a scaled version of the small object.

    Rule:
    - Use the four yellow pixels to crop the target region.
    - Generate scaled versions of the small object and try all placements inside that crop.
    - Choose a placement whose colored cells cover every existing non-black, non-yellow cell in the target region, then paste it.

    Key insight:
    - The partial colored cells inside the frame are alignment constraints for the scaled miniature;
      the yellow corners define the output crop.
    """
    # Plan:
    # 1. Detect the little object, yellow pixels, and big region
    # 2. Rescale and translate the little object to cover as much of the big region as possible, matching colors whenever they overlap

    # 1. Detect little object, yellow pixels, and big region
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
    yellow_pixel_objects = []
    for obj in objects:
        _b = bbox(obj != Color.BLACK)
        if _b is None:
            continue
        r0, c0, r1, c1 = _b
        if r0 == r1 and c0 == c1 and int(obj[r0, c0]) == int(Color.YELLOW):
            yellow_pixel_objects.append(obj)
    assert len(yellow_pixel_objects) == 4, "There should be exactly 4 yellow pixels"

    # Find the region indicated by the 4 yellow pixels
    yellow_coords = []
    for obj in yellow_pixel_objects:
        _b = bbox(obj != Color.BLACK)
        assert _b is not None
        yellow_coords.append(bbox_anchor(_b, anchor="center"))
    yellow_pixel_min_r = min(r for r, _c in yellow_coords)
    yellow_pixel_max_r = max(r for r, _c in yellow_coords)
    yellow_pixel_min_c = min(c for _r, c in yellow_coords)
    yellow_pixel_max_c = max(c for _r, c in yellow_coords)
    
    # The little object is what is outside that region
    little_objects = []
    for obj in objects:
        _b = bbox(obj != Color.BLACK)
        if _b is None:
            continue
        r, c = bbox_anchor(_b, anchor="center")
        if r < yellow_pixel_min_r or r > yellow_pixel_max_r or c < yellow_pixel_min_c or c > yellow_pixel_max_c:
            # Exclude the yellow corner markers
            if int(obj[r, c]) == int(Color.YELLOW):
                continue
            little_objects.append(obj)
    assert len(little_objects) == 1, "There should be exactly one little object"
    little_object = little_objects[0]

    # The output grid is going to be the region delimited by the yellow pixels
    output_grid = input_grid[yellow_pixel_min_r:yellow_pixel_max_r+1, yellow_pixel_min_c:yellow_pixel_max_c+1].copy()

    # The big region has some colored pixels that we are going to try and match with
    # Extract the content of big region as tuples (x, y, color)
    big_region_pixels = [ (r, c, output_grid[r, c])
                         for r in range(output_grid.shape[0]) for c in range(output_grid.shape[1])
                         if output_grid[r, c] != Color.BLACK and output_grid[r, c] != Color.YELLOW ]

    # 2. Rescale and translate the little object to cover as much of the big region as possible, matching colors whenever they overlap
    _b = bbox(little_object != Color.BLACK)
    assert _b is not None
    little_sprite = crop_bbox(little_object, _b)
    scaled_sprites = [ scale_sprite(little_sprite, factor) for factor in [1, 2, 3, 4, 5, 6] ]
    # A placement solution is a tuple of (x, y, scaled_sprite) where x, y is the top-left corner of the scaled sprite
    possible_solutions = [ (r, c, scaled_sprite) for scaled_sprite in scaled_sprites
                          for r in range(output_grid.shape[0] - scaled_sprite.shape[0] + 1)
                          for c in range(output_grid.shape[1] - scaled_sprite.shape[1] + 1) ]
    
    # Filter placement solutions to only those where the colors of the big region match the colors of the scaled+translated sprite
    def valid_solution(r, c, scaled_sprite):
        # Make a canvas to try putting down the scaled sprite
        test_canvas = np.full_like(output_grid, Color.BLACK)
        paste(test_canvas, scaled_sprite, r, c, transparent=Color.BLACK, clip=True)
        # Check if every big region color is also in the test canvas
        test_colors = [ (r, c, test_canvas[r, c]) for r in range(output_grid.shape[0]) for c in range(output_grid.shape[1]) if test_canvas[r, c] != Color.BLACK ]
        return all( (r, c, color) in test_colors for r, c, color in big_region_pixels )        
    
    possible_solutions = [ solution for solution in possible_solutions if valid_solution(*solution) ]
    if len(possible_solutions) == 0:
        assert False, "No solution found for the little object"
    
    # Pick the first solution and blit the sprite into the output grid
    r, c, scaled_sprite = list(possible_solutions)[0]
    paste(output_grid, scaled_sprite, r, c, transparent=Color.BLACK, clip=True)

    return output_grid

def generate_input():
    # Create a little object and then rescale it to make a big version.
    # Cover up some parts of the big version with black pixels, and put yellow markers in the corners.
    # Finally figure out how to put everything on a big canvas

    little_sprite = random_sprite([2,3,4], [2,3,4], connectivity=4, color_palette=[color for color in Color.NOT_BLACK if color != Color.YELLOW], background=Color.BLACK)
    scaling_factor = np.random.randint(2, 4+1)
    big_sprite = scale_sprite(little_sprite, scaling_factor)

    # Cover up some parts of the big sprite with black pixels
    for _ in range(np.random.randint(1, 3)):
        x0, y0 = np.random.randint(0, big_sprite.shape[0]), np.random.randint(0, big_sprite.shape[1])
        x1, y1 = np.random.randint(x0, big_sprite.shape[0]), np.random.randint(y0, big_sprite.shape[1])
        big_sprite[x0:x1+1, y0:y1+1] = Color.BLACK

    # Create a fixed big canvas so we can safely place corner markers and keep the little object
    # entirely outside the marked big region.
    width = height = 30
    grid = np.full((width, height), Color.BLACK, dtype=int)
    
    # Put the big sprite in the canvas
    _loc = first_free_location(grid, big_sprite, transparent=Color.BLACK, border=6, padding=0, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    paste(grid, big_sprite, r, c, transparent=Color.BLACK, clip=True)

    # Put yellow markers in the corners
    grid[r-1, c-1] = Color.YELLOW
    grid[r-1, c+big_sprite.shape[1]] = Color.YELLOW
    grid[r+big_sprite.shape[0], c-1] = Color.YELLOW
    grid[r+big_sprite.shape[0], c+big_sprite.shape[1]] = Color.YELLOW
    
    # Place the little sprite outside the marked region (top-left corner).
    paste(grid, little_sprite, 0, 0, transparent=Color.BLACK, clip=True)

    return grid
import numpy as np

from arc_utils import Color, colors_present, find_components, get_bg, paste


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill each one-gap rectangular frame in red and let the fill spill straight out through the gap.

    Input structure
    - The grid has a uniform background color and one foreground color.
    - Each 4-connected foreground object is a 4x4 rectangular frame border with exactly one non-corner border pixel missing.
    Rule
    - Preserve the foreground frame pixels.
    - Recolor each frame's 2x2 interior, its missing border pixel, and the background ray continuing outward from that gap to red.
    Key insight
    - The missing border pixel identifies both the leak point and the outward direction for the red fill.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    assert bg != Color.RED, "red is reserved for the output fill"
    frame_colors = colors_present(g, exclude={bg})
    assert len(frame_colors) == 1, "expected exactly one frame color"
    frame_color = frame_colors[0]
    assert frame_color != Color.RED, "input frame color must differ from red"

    frames = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[frame_color],
        return_format="dict",
    )
    assert frames, "expected at least one frame"

    out = g.copy()
    height, width = map(int, g.shape)

    for frame in frames:
        assert frame["color"] == frame_color
        assert frame["area"] == 11, "expected a 4x4 border with one missing pixel"
        r0, c0, r1, c1 = frame["bbox"]
        assert (r1 - r0 + 1, c1 - c0 + 1) == (4, 4), "expected a 4x4 frame"

        coords = {tuple(map(int, rc)) for rc in frame["coords"]}
        border = {
            (r, c)
            for r in range(r0, r1 + 1)
            for c in range(c0, c1 + 1)
            if r in (r0, r1) or c in (c0, c1)
        }
        gaps = list(border - coords)
        assert len(gaps) == 1, "expected exactly one missing frame pixel"
        gap_r, gap_c = gaps[0]

        if gap_r == r0:
            assert c0 < gap_c < c1, "gap must be a non-corner border pixel"
            dr, dc = -1, 0
        elif gap_r == r1:
            assert c0 < gap_c < c1, "gap must be a non-corner border pixel"
            dr, dc = 1, 0
        elif gap_c == c0:
            assert r0 < gap_r < r1, "gap must be a non-corner border pixel"
            dr, dc = 0, -1
        elif gap_c == c1:
            assert r0 < gap_r < r1, "gap must be a non-corner border pixel"
            dr, dc = 0, 1
        else:
            raise AssertionError("gap must lie on the frame border")

        paint = {(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)}
        paint.add((gap_r, gap_c))
        r, c = gap_r + dr, gap_c + dc
        while 0 <= r < height and 0 <= c < width:
            paint.add((r, c))
            r += dr
            c += dc

        for r, c in paint:
            assert g[r, c] == bg, "red fill must only replace background pixels"
            out[r, c] = Color.RED

    return out

# --------------- generator (o5x) ---------------

_GEN_BG_COLORS = (0, 3, 4, 5, 6, 7, 8, 9)

# Canvas and frame counts.
_GEN_MIN_HEIGHT = 7
_GEN_MAX_HEIGHT_EXCL = 12
_GEN_MIN_WIDTH = 9
_GEN_MAX_WIDTH_EXCL = 16
_GEN_THREE_FRAME_MIN_HEIGHT = 9
_GEN_MIN_FRAME_COUNT = 1
_GEN_MAX_FRAME_COUNT_EXCL = 4

# Frame geometry and colors.
_GEN_FRAME_SIZE = 4
_GEN_FRAME_EDGE = _GEN_FRAME_SIZE - 1
_GEN_INTERIOR_MARGIN = 1
_GEN_FRAME_COLOR = Color.BLUE
_GEN_FILL_COLOR = Color.RED
_GEN_GAP_OFFSETS = (1, 2)
_GEN_SIDES = ("top", "bottom", "left", "right")
_GEN_SIDE_DELTAS = {
    "top": (-1, 0),
    "bottom": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}

# Placement and retry limits.
_GEN_MAX_RAY_LEN = 3
_GEN_MIN_BBOX_GAP = 1
_GEN_MAX_ATTEMPTS = 300


def _gen_ray_cells(height, width, gap_r, gap_c, side):
    dr, dc = _GEN_SIDE_DELTAS[side]
    cells = [(gap_r, gap_c)]
    r, c = gap_r + dr, gap_c + dc
    while 0 <= r < height and 0 <= c < width:
        cells.append((r, c))
        r += dr
        c += dc
    return tuple(cells)


def _gen_frame_patch(bg, side, offset):
    patch = np.full((_GEN_FRAME_SIZE, _GEN_FRAME_SIZE), bg, dtype=int)
    patch[0, :] = _GEN_FRAME_COLOR
    patch[_GEN_FRAME_EDGE, :] = _GEN_FRAME_COLOR
    patch[:, 0] = _GEN_FRAME_COLOR
    patch[:, _GEN_FRAME_EDGE] = _GEN_FRAME_COLOR
    gap_r, gap_c = _gen_gap_cell(0, 0, side, offset)
    patch[gap_r, gap_c] = bg
    return patch


def _gen_bbox_cells(box):
    r0, c0, r1, c1 = box
    return {
        (r, c)
        for r in range(r0, r1 + 1)
        for c in range(c0, c1 + 1)
    }


def _gen_bbox_separated(a, b):
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    row_gap = max(br0 - ar1 - 1, ar0 - br1 - 1)
    col_gap = max(bc0 - ac1 - 1, ac0 - bc1 - 1)
    return row_gap >= _GEN_MIN_BBOX_GAP or col_gap >= _GEN_MIN_BBOX_GAP


def _gen_gap_cell(r0, c0, side, offset):
    if side == "top":
        return r0, c0 + offset
    if side == "bottom":
        return r0 + _GEN_FRAME_EDGE, c0 + offset
    if side == "left":
        return r0 + offset, c0
    return r0 + offset, c0 + _GEN_FRAME_EDGE


def _gen_origin_ranges(height, width, side):
    """Return candidate top-left ranges whose outward rays are short enough."""
    last_row = height - _GEN_FRAME_SIZE
    last_col = width - _GEN_FRAME_SIZE

    if side == "top":
        row_start, row_stop = 0, min(_GEN_MAX_RAY_LEN, last_row) + 1
        col_start, col_stop = 0, last_col + 1
    elif side == "bottom":
        row_start = max(0, last_row - _GEN_MAX_RAY_LEN)
        row_stop = last_row + 1
        col_start, col_stop = 0, last_col + 1
    elif side == "left":
        row_start, row_stop = 0, last_row + 1
        col_start, col_stop = 0, min(_GEN_MAX_RAY_LEN, last_col) + 1
    else:
        row_start, row_stop = 0, last_row + 1
        col_start = max(0, last_col - _GEN_MAX_RAY_LEN)
        col_stop = last_col + 1

    return range(row_start, row_stop), range(col_start, col_stop)


def _gen_candidate_specs(height, width):
    """Enumerate all frame placements that satisfy the local ray-length bound."""
    specs = []
    for side in _GEN_SIDES:
        row_choices, col_choices = _gen_origin_ranges(height, width, side)
        for r0 in row_choices:
            for c0 in col_choices:
                for offset in _GEN_GAP_OFFSETS:
                    gap_r, gap_c = _gen_gap_cell(r0, c0, side, offset)
                    box = (r0, c0, r0 + _GEN_FRAME_EDGE, c0 + _GEN_FRAME_EDGE)
                    ray = _gen_ray_cells(height, width, gap_r, gap_c, side)
                    if len(ray) - 1 <= _GEN_MAX_RAY_LEN:
                        specs.append(
                            {
                                "bbox": box,
                                "bbox_cells": _gen_bbox_cells(box),
                                "gap": (gap_r, gap_c),
                                "offset": offset,
                                "ray": frozenset(ray),
                                "side": side,
                            }
                        )
    return specs


def _gen_compatible(candidate, selected):
    for other in selected:
        if not _gen_bbox_separated(candidate["bbox"], other["bbox"]):
            return False
        if candidate["ray"] & other["bbox_cells"]:
            return False
        if other["ray"] & candidate["bbox_cells"]:
            return False
    return True


def _gen_choose(seq):
    return seq[np.random.randint(0, len(seq))]


def _gen_select_frames(candidates, count):
    """Sample compatible frame specs while preserving the side/offset preference order."""
    selected = []
    for _ in range(count):
        compatible = [c for c in candidates if _gen_compatible(c, selected)]
        if not compatible:
            return None

        side = _gen_choose(_GEN_SIDES)
        offset = int(np.random.randint(min(_GEN_GAP_OFFSETS), max(_GEN_GAP_OFFSETS) + 1))
        preferred = [
            c
            for c in compatible
            if c["side"] == side and c["offset"] == offset
        ]
        if not preferred:
            preferred = [c for c in compatible if c["side"] == side]
        if not preferred:
            preferred = compatible

        selected.append(_gen_choose(preferred))
    return selected


def _gen_attempt():
    frame_count = int(np.random.randint(_GEN_MIN_FRAME_COUNT, _GEN_MAX_FRAME_COUNT_EXCL))
    if frame_count == 3:
        height = int(np.random.randint(_GEN_THREE_FRAME_MIN_HEIGHT, _GEN_MAX_HEIGHT_EXCL))
        width = int(np.random.randint(_GEN_MIN_WIDTH, _GEN_MAX_WIDTH_EXCL))
    else:
        height = int(np.random.randint(_GEN_MIN_HEIGHT, _GEN_MAX_HEIGHT_EXCL))
        width = int(np.random.randint(_GEN_MIN_WIDTH, _GEN_MAX_WIDTH_EXCL))

    bg = int(_gen_choose(_GEN_BG_COLORS))
    candidates = _gen_candidate_specs(height, width)
    frames = _gen_select_frames(candidates, frame_count)
    if frames is None:
        return None

    inp = np.full((height, width), bg, dtype=int)
    expected = inp.copy()
    for frame in frames:
        r0, c0, r1, c1 = frame["bbox"]
        patch = _gen_frame_patch(bg, frame["side"], frame["offset"])
        paste(inp, patch, r0, c0)
        paste(expected, patch, r0, c0)
        expected[
            r0 + _GEN_INTERIOR_MARGIN : r1,
            c0 + _GEN_INTERIOR_MARGIN : c1,
        ] = _GEN_FILL_COLOR
        for r, c in frame["ray"]:
            expected[r, c] = _GEN_FILL_COLOR

    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 292dd178 input")
from __future__ import annotations

from collections import Counter

import numpy as np
import random
from arc_utils import paste


def _unique_mode(values: np.ndarray) -> int:
    counts = Counter(map(int, values.reshape(-1)))
    ranked = counts.most_common()
    assert ranked, "expected a nonempty set of values"
    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique dominant color"
    return int(ranked[0][0])


def _separator_lines(g: np.ndarray) -> tuple[int, list[int], list[int]]:
    height, width = map(int, g.shape)
    candidates = []
    for color in np.unique(g):
        color = int(color)
        rows = [r for r in range(height) if np.all(g[r, :] == color)]
        cols = [c for c in range(width) if np.all(g[:, c] == color)]
        if rows and cols:
            candidates.append((color, rows, cols))
    assert len(candidates) == 1, "expected one color to form full separator rows and columns"
    return candidates[0]


def _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:
    spans = []
    start = 0
    for sep in separators:
        assert start < sep, "separator lines must leave nonempty regions"
        spans.append((start, sep - 1))
        start = sep + 1
    assert start < length, "separator lines must leave a final nonempty region"
    spans.append((start, length - 1))
    return spans


def main(grid: np.ndarray) -> np.ndarray:
    """
    Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.

    Input structure
    - Full same-color separator rows and columns partition the grid into equal rectangular tiles.
    - One tile contains the only non-background, non-separator colored sprite.
    - Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.

    Rule
    - Keep the separator lines and the source sprite tile unchanged.
    - Replace each marked target tile with an exact copy of the source tile.
    - Unmarked background-only tiles remain unchanged.

    Key insight
    - The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a nonempty 2D grid"

    separator, sep_rows, sep_cols = _separator_lines(g)
    row_spans = _spans(g.shape[0], sep_rows)
    col_spans = _spans(g.shape[1], sep_cols)

    tile_heights = {r1 - r0 + 1 for r0, r1 in row_spans}
    tile_widths = {c1 - c0 + 1 for c0, c1 in col_spans}
    assert len(tile_heights) == 1 and len(tile_widths) == 1, "expected equal-sized tile rows and columns"
    tile_h = tile_heights.pop()
    tile_w = tile_widths.pop()

    bg = _unique_mode(g[g != separator])
    assert bg != separator, "background and separator colors must differ"
    sprite_colors = [int(color) for color in np.unique(g) if int(color) not in {bg, separator}]
    assert len(sprite_colors) == 1, "expected one sprite color"
    sprite_color = sprite_colors[0]

    source_tiles = []
    marked_origins = []
    for r0, r1 in row_spans:
        for c0, c1 in col_spans:
            tile = g[r0 : r1 + 1, c0 : c1 + 1]
            assert tile.shape == (tile_h, tile_w)
            has_sprite = np.any(tile == sprite_color)
            has_marker = np.any(tile == separator)
            if has_sprite:
                assert not has_marker, "source tile should contain only sprite and background"
                assert set(map(int, np.unique(tile))).issubset({bg, sprite_color})
                source_tiles.append(tile.copy())
            elif has_marker:
                assert set(map(int, np.unique(tile))).issubset({bg, separator})
                marked_origins.append((r0, c0))
            else:
                assert np.all(tile == bg), "unmarked non-source tiles should be plain background"

    assert len(source_tiles) == 1, "expected exactly one source sprite tile"
    source_tile = source_tiles[0]

    out = g.copy()
    for r0, c0 in marked_origins:
        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = source_tile
    return out

# --------------- generator (o5x) ---------------

# Palette: separator, background, and sprite are distinct.
COLOR_POOL = range(10)
PALETTE_SIZE = 3
# Tile grid dimensions and odd square tile sizes.
TILE_ROWS_RANGE = (3, 4)
TILE_COLS_RANGE = (3, 4)
TILE_SIZE_CHOICES = [3, 5]
SEPARATOR_WIDTH = 1
# Sprite density and 4-connected component count by tile size.
SPRITE_PIXEL_RANGES = {3: (3, 4), 5: (8, 11)}
SPRITE_COMPONENT_CAPS = {3: 3, 5: 5}
NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
ORIENTATION_COUNT = 4
FLIP_PROBABILITY = 0.5
# Marker tiles and retry budget.
MARKER_COUNT_RANGE = (3, 5)
MAX_GENERATION_ATTEMPTS = 300


def _gen_neighbors4(r: int, c: int, size: int):
    for dr, dc in NEIGHBOR_OFFSETS_4:
        rr, cc = r + dr, c + dc
        if 0 <= rr < size and 0 <= cc < size:
            yield rr, cc


def _gen_partition(total: int, parts: int) -> list[int]:
    sizes = [1] * parts
    for _ in range(total - parts):
        sizes[random.randrange(parts)] += 1
    random.shuffle(sizes)
    return sizes


def _gen_separate_from_other(labels: np.ndarray, r: int, c: int, label: int) -> bool:
    size = int(labels.shape[0])
    for rr, cc in _gen_neighbors4(r, c, size):
        if labels[rr, cc] not in (0, label):
            return False
    return True


def _gen_sprite_tile(size: int, bg: int, sprite_color: int) -> np.ndarray | None:
    pixel_count = random.randint(*SPRITE_PIXEL_RANGES[size])
    component_count = random.randint(1, min(SPRITE_COMPONENT_CAPS[size], pixel_count))
    labels = np.zeros((size, size), dtype=int)
    for label, component_size in enumerate(_gen_partition(pixel_count, component_count), start=1):
        seed_candidates = [
            (r, c)
            for r in range(size)
            for c in range(size)
            if labels[r, c] == 0 and _gen_separate_from_other(labels, r, c, label)
        ]
        if not seed_candidates:
            return None

        seed = random.choice(seed_candidates)
        labels[seed] = label
        cells = [seed]
        while len(cells) < component_size:
            growth = []
            for r, c in cells:
                for rr, cc in _gen_neighbors4(r, c, size):
                    if labels[rr, cc] == 0 and _gen_separate_from_other(labels, rr, cc, label):
                        growth.append((rr, cc))
            if not growth:
                return None
            cell = random.choice(growth)
            labels[cell] = label
            cells.append(cell)

    tile = np.full((size, size), bg, dtype=int)
    tile[labels > 0] = sprite_color
    tile = np.rot90(tile, random.randrange(ORIENTATION_COUNT))
    if random.random() < FLIP_PROBABILITY:
        tile = np.fliplr(tile)
    if random.random() < FLIP_PROBABILITY:
        tile = np.flipud(tile)
    return tile.copy()


def _gen_tile_origin(tile_r: int, tile_c: int, tile_size: int) -> tuple[int, int]:
    return tile_r * (tile_size + SEPARATOR_WIDTH), tile_c * (tile_size + SEPARATOR_WIDTH)


def _gen_base_grid(tile_rows: int, tile_cols: int, tile_size: int, bg: int, separator: int) -> np.ndarray:
    height = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH
    width = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH
    grid = np.full((height, width), bg, dtype=int)
    grid[tile_size :: tile_size + SEPARATOR_WIDTH, :] = separator
    grid[:, tile_size :: tile_size + SEPARATOR_WIDTH] = separator
    return grid


def _gen_paste_tile(grid: np.ndarray, pos: tuple[int, int], tile: np.ndarray, tile_size: int) -> None:
    r0, c0 = _gen_tile_origin(pos[0], pos[1], tile_size)
    paste(grid, tile, r0, c0)


def _gen_render_pair(tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions):
    expected = _gen_base_grid(tile_rows, tile_cols, tile_size, bg, separator)
    for pos in [source_pos, *marked_positions]:
        _gen_paste_tile(expected, pos, sprite_tile, tile_size)

    inp = expected.copy()
    marker_tile = np.full((tile_size, tile_size), bg, dtype=int)
    marker_tile[tile_size // 2, tile_size // 2] = separator
    for pos in marked_positions:
        _gen_paste_tile(inp, pos, marker_tile, tile_size)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    separator, bg, sprite_color = random.sample(COLOR_POOL, PALETTE_SIZE)
    tile_rows, tile_cols, tile_size = (
        random.randint(*TILE_ROWS_RANGE),
        random.randint(*TILE_COLS_RANGE),
        random.choice(TILE_SIZE_CHOICES),
    )

    sprite_tile = _gen_sprite_tile(tile_size, bg, sprite_color)
    if sprite_tile is None:
        return None

    tile_positions = [(r, c) for r in range(tile_rows) for c in range(tile_cols)]
    source_pos = random.choice(tile_positions)
    marker_count = random.randint(*MARKER_COUNT_RANGE)
    marked_positions = random.sample([pos for pos in tile_positions if pos != source_pos], marker_count)
    inp, expected = _gen_render_pair(
        tile_rows, tile_cols, tile_size, separator, bg, sprite_tile, source_pos, marked_positions
    )
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e734a0e8 input")
from __future__ import annotations
from collections import Counter, deque
import numpy as np
from arc_utils import STRUCT8, components_mask
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.

    Input structure:
    - bg = most common color; water = rarest non-bg; shelf = other non-bg.
    - Sources: water clusters touching top row. Shelves: horizontal segments.

    Rule:
    - Water falls down from sources, painting bg cells as water.
    - On hitting a shelf, it spreads across the shelf span plus one cell past each end.
    - From those overflow positions, water resumes falling independently.

    Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    cnt = Counter(map(int, g.flatten()))
    bg = int(cnt.most_common(1)[0][0])
    non = [int(c) for c in cnt.keys() if int(c) != int(bg)]
    assert not (not non)
    water = int(min(non, key=lambda c: (int(cnt[int(c)]), int(c))))
    other = [int(c) for c in non if int(c) != int(water)]
    assert not (not other)
    shelf = int(other[0])

    out = g.copy()

    # sources: 8-connected components of water that touch the top edge; start from their bottommost row
    sources: list[tuple[int, int]] = []
    for coords in components_mask(g == int(water), connectivity=8):
        if coords.size == 0:
            continue
        if not bool((coords[:, 0] == 0).any()):
            continue
        rmax = int(coords[:, 0].max())
        cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})
        for c in cols:
            sources.append((int(rmax), int(c)))

    # shelf segments (from original grid g)
    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]
    for r in range(H):
        c = 0
        while c < W:
            if int(g[int(r), int(c)]) != int(shelf):
                c += 1
                continue
            c0 = int(c)
            while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):
                c += 1
            shelf_segs[int(r)].append((int(c0), int(c)))
            c += 1

    def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:
        for a, b in shelf_segs[int(r)]:
            if int(a) <= int(c) <= int(b):
                return (int(a), int(b))
        return None

    def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:
        """
        Expand horizontally only through contiguous bg cells on the current row.

        This prevents water from "jumping" over blockers that sit on the spread row.
        """
        left = int(start_col)
        while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):
            left -= 1

        right = int(start_col)
        while right + 1 <= int(max_col) and int(g[int(row), int(right + 1)]) == int(bg):
            right += 1

        return (int(left), int(right))

    seen: set[tuple[int, int]] = set()
    q = deque((int(r), int(c)) for r, c in sources)

    while q:
        r, c = q.popleft()
        if (int(r), int(c)) in seen:
            continue
        seen.add((int(r), int(c)))

        rr, cc = int(r), int(c)
        out[rr, cc] = int(water)

        while True:
            nr = int(rr + 1)
            if nr >= H:
                break
            below = int(g[int(nr), int(cc)])

            if below == int(shelf):
                seg = find_shelf_seg(nr, cc)
                if seg is None:
                    break
                a, b = seg
                left_bound = int(max(0, int(a - 1)))
                right_bound = int(min(int(W - 1), int(b + 1)))
                left, right = spread_limits(rr, cc, left_bound, right_bound)
                for x in range(left, right + 1):
                    if int(g[int(rr), int(x)]) == int(bg):
                        out[int(rr), int(x)] = int(water)
                for nc in {left, right}:
                    if int(nc) != int(cc):
                        q.append((int(rr), int(nc)))
                break

            rr = nr
            out[int(rr), int(cc)] = int(water)

    return out

# --------------- generator (cascade tree top-down construction) ---------------

def _gen_attempt() -> np.ndarray | None:
    """Single attempt to generate a valid input for the waterfall cascade task."""
    BG, WATER, SHELF = 7, 6, 2

    H = random.randint(8, 30)
    W = random.randint(5, 30)

    num_sources = random.choice([1, 2]) if W >= 14 else 1
    if num_sources == 2:
        src1 = random.randint(0, W - 8)
        src2 = random.randint(src1 + 7, W - 1)
        source_cols = [src1, src2]
    else:
        source_cols = [random.randint(0, W - 1)]

    # Track cells reserved for shelf
    shelf_cells: set[tuple[int, int]] = set()
    # Cells that must remain bg (overflow positions, fall paths, source positions)
    reserved_bg: set[tuple[int, int]] = set()

    # Reserve source positions
    for sc in source_cols:
        reserved_bg.add((0, sc))
        reserved_bg.add((1, sc))

    all_shelves: list[tuple[int, int, int]] = []  # (row, a, b)

    def try_add_shelf(r: int, a: int, b: int, is_cascade: bool = False) -> bool:
        """Try to add a shelf segment. Check no conflict with existing shelves or reserved bg cells."""
        cells = [(r, c) for c in range(a, b + 1)]
        for cell in cells:
            if cell in shelf_cells or cell in reserved_bg:
                return False
        for cell in cells:
            shelf_cells.add(cell)
        all_shelves.append((r, a, b))
        return True

    def reserve_overflow_and_fall(spread_row: int, left: int, right: int, incoming_col: int):
        """Reserve overflow positions and their fall paths as must-be-bg."""
        for nc in {left, right}:
            if nc != incoming_col:
                # The overflow position itself must be bg
                reserved_bg.add((spread_row, nc))
                # Fall path below must be bg until next shelf or grid bottom
                # We'll just reserve the overflow position for now;
                # fall path conflicts are handled by checking during shelf placement

    max_depth = random.randint(2, 5)
    if H < max_depth * 2 + 3:
        max_depth = max(2, (H - 3) // 2)

    # Build cascade tree top-down
    # Each stream: (current_row, col, depth)
    streams: list[tuple[int, int, int]] = [(1, sc, 0) for sc in source_cols]
    cascade_shelves: list[tuple[int, int, int]] = []
    processed = set()

    while streams:
        next_streams = []
        random.shuffle(streams)
        for (row, col, depth) in streams:
            if (row, col) in processed:
                continue
            processed.add((row, col))

            if depth >= max_depth or row + 2 >= H:
                continue

            min_shelf_row = row + 2
            max_shelf_row = min(H - 1, row + 8)
            if min_shelf_row > max_shelf_row:
                continue

            # Try a few times to place a shelf
            placed = False
            for _try in range(10):
                shelf_row = random.randint(min_shelf_row, max_shelf_row)
                spread_row = shelf_row - 1
                if spread_row <= row:
                    continue

                # Check fall path from (row+1, col) to (shelf_row-1, col) is clear
                blocked = False
                for r_check in range(row + 1, shelf_row):
                    if (r_check, col) in shelf_cells:
                        blocked = True
                        break
                if blocked:
                    continue

                # Generate shelf segment containing col
                shelf_len = random.randint(2, min(8, W))
                max_start = col
                min_start = max(0, col - shelf_len + 1)
                if min_start > max_start:
                    continue
                a = random.randint(min_start, max_start)
                b = min(a + shelf_len - 1, W - 1)

                # Check shelf cells don't conflict
                conflict = False
                for c in range(a, b + 1):
                    if (shelf_row, c) in shelf_cells or (shelf_row, c) in reserved_bg:
                        conflict = True
                        break
                if conflict:
                    continue

                # Compute overflow positions
                left = max(0, a - 1)
                right = min(W - 1, b + 1)

                # Check overflow positions on spread row are not shelf
                overflow_ok = True
                for nc in {left, right}:
                    if nc != col:
                        if (spread_row, nc) in shelf_cells:
                            overflow_ok = False
                            break
                if not overflow_ok:
                    continue

                # Add the shelf
                if not try_add_shelf(shelf_row, a, b, is_cascade=True):
                    continue

                cascade_shelves.append((shelf_row, a, b))

                # Reserve overflow positions and fall path cells as bg
                reserve_overflow_and_fall(spread_row, left, right, col)

                # Reserve the fall path from current position to shelf
                for r_res in range(row + 1, shelf_row):
                    reserved_bg.add((r_res, col))

                # Add new streams from overflow
                for nc in {left, right}:
                    if nc != col:
                        next_streams.append((spread_row, nc, depth + 1))

                placed = True
                break

            # If no shelf placed, stream just falls to bottom (that's ok)

        streams = next_streams

    if len(cascade_shelves) < 3:
        return None

    # Build the grid
    grid = np.full((H, W), BG, dtype=int)

    # Place sources
    for sc in source_cols:
        grid[0, sc] = WATER
        grid[1, sc] = WATER

    # Place all shelves
    for (r, a, b) in all_shelves:
        for c in range(a, b + 1):
            grid[r, c] = SHELF

    # Add 0-5 distractor shelves (carefully avoiding reserved_bg and shelf_cells)
    num_distractors = random.randint(0, 5)
    for _ in range(num_distractors):
        for _attempt in range(20):
            dr = random.randint(1, H - 1)
            dl = random.randint(1, min(8, W))
            da = random.randint(0, W - dl)
            db = da + dl - 1
            # Check no conflict with shelf_cells or reserved_bg
            conflict = False
            for c in range(da, db + 1):
                if (dr, c) in shelf_cells or (dr, c) in reserved_bg:
                    conflict = True
                    break
            if not conflict:
                # Also check distractor doesn't intersect any active water fall path
                # by ensuring it's not on a column where water falls through
                if try_add_shelf(dr, da, db):
                    for c in range(da, db + 1):
                        grid[dr, c] = SHELF
                    break

    # Verify with solver
    try:
        out = main(grid.copy())
    except Exception:
        return None

    if np.array_equal(out, grid):
        return None

    # Verify shelf cells are preserved in output
    for (r, a, b) in all_shelves:
        for c in range(a, b + 1):
            if out[r, c] != SHELF:
                return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 300 attempts")

