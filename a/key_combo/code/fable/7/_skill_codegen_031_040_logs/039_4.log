+    transform_indices = random.sample(range(8), marker_count)
+    if 0 not in transform_indices:
+        transform_indices[0] = 0
+    if not any(1 <= k <= 3 for k in transform_indices):
+        transform_indices[1] = random.choice((1, 2, 3))
