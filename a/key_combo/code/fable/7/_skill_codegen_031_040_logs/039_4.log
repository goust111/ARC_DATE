+def _d4(tile: np.ndarray) -> tuple[np.ndarray, ...]:
+    """The eight square symmetries, in a fixed but semantically irrelevant order."""
+    reflected = np.fliplr(tile)
+    return tuple(
+        [np.rot90(tile, k).copy() for k in range(4)]
