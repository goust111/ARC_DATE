+    for index, transform_index in target_specs:
+        r0, c0 = origin(index)
+        transformed = variants[transform_index]
+        marker = np.argwhere(transformed == anchor_color)
+        assert len(marker) == 1
+        mr, mc = map(int, marker[0])
