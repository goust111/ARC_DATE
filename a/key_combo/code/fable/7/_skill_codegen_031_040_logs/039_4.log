+    n = random.choice((5, 6, 7))
+    maximum_tiles_per_axis = (30 + 1) // (n + 1)
+    tile_rows = random.randint(3, maximum_tiles_per_axis)
+    tile_cols = random.randint(3, maximum_tiles_per_axis)
