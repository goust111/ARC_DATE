+def generate_input() -> np.ndarray:
+    """Generate varied, semantically checked marker configurations."""
+    for _ in range(3000):
+        h = random.randint(12, 22)
+        w = random.randint(12, 22)
+        count = random.randint(4, 7)
+        colors = random.sample(range(1, 10), count)
