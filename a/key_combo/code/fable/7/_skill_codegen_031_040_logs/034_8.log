+    assert all(b - a >= 2 for a, b in zip(wall_cols, wall_cols[1:]))
+
+    nr, nc = len(wall_rows) - 1, len(wall_cols) - 1
+    adj: dict[Room, list[tuple[Room, int, tuple[int, int]]]] = {
+        (r, c): [] for r in range(nr) for c in range(nc)
+    }
