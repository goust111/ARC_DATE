+            assert len(offsets) <= 1
+            if len(offsets) == 1:
+                c = wall_cols[j] + 1 + int(offsets[0])
+                a, b = (i - 1, j), (i, j)
+                color = int(g[wr, c])
+                adj[a].append((b, color, (wr, c)))
+                adj[b].append((a, color, (wr, c)))
+
+    # A vertical separator segment belongs to exactly the rooms left/right of it.
+    for j in range(1, nc):
