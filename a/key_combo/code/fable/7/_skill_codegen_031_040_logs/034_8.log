+        for i in range(nr):
+            segment = g[wall_rows[i] + 1 : wall_rows[i + 1], wc]
+            offsets = np.flatnonzero(np.isin(segment, DOOR_COLORS))
+            assert len(offsets) <= 1
+            if len(offsets) == 1:
+                r = wall_rows[i] + 1 + int(offsets[0])
+                a, b = (i, j - 1), (i, j)
