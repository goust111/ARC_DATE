+    start: Room,
+    goal: Room,
+):
+    """BFS on (room, previous-door-color), counting shortest state paths."""
+    initial = (start, -1)
+    dist = {initial: 0}
+    ways = {initial: 1}
+    prev: dict[tuple[Room, int], tuple[tuple[Room, int], tuple[int, int]]] = {}
+    queue = deque([initial])
+
+    while queue:
+        state = queue.popleft()
+        room, last_color = state
+        for neighbor, color, door in adj[room]:
+            if color == last_color:
+                continue
+            nxt = (neighbor, color)
+            nd = dist[state] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                ways[nxt] = ways[state]
+                prev[nxt] = (state, door)
+                queue.append(nxt)
+            elif dist[nxt] == nd:
+                ways[nxt] = min(2, ways[nxt] + ways[state])
