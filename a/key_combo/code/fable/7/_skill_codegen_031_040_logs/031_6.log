+    return (
+        (slice(0, cross_r), slice(0, cross_c)),
+        (slice(0, cross_r), slice(cross_c + 1, grid.shape[1])),
+        (slice(cross_r + 1, grid.shape[0]), slice(0, cross_c)),
+        (slice(cross_r + 1, grid.shape[0]), slice(cross_c + 1, grid.shape[1])),
+    )
