+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as arrays of local (row, column) coordinates."""
+    height, width = mask.shape
+    unseen = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
