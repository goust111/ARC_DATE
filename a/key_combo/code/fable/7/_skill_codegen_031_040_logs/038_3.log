+    expected_tail = {
+        (near_end[0] - direction[0] * k, near_end[1] - direction[1] * k)
+        for k in range(len(tail_set))
+    }
+    assert tail_set == expected_tail, "tail must point exactly opposite the motion direction"
+    return bg, objects, active, direction
+
+
+def _simulate(
+    boxes: list[BBox],
