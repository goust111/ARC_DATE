+    tail_set = {tuple(map(int, p)) for p in tail}
+    endpoints = []
+    for cell in tail_set:
+        degree = sum((cell[0] + dr, cell[1] + dc) in tail_set for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)))
+        if degree <= 1:
