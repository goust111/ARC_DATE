+    for er, ec in endpoints:
+        for direction in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = er + direction[0], ec + direction[1]
+            for i, obj in enumerate(objects):
+                r0, c0, r1, c1 = obj["bbox"]
+                if r0 <= nr <= r1 and c0 <= nc <= c1:
+                    attachments.append((i, direction, (er, ec)))
