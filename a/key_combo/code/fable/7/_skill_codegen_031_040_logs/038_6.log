+        c0 = min(c for _, c in pts)
+        r1 = max(r for r, _ in pts)
+        c1 = max(c for _, c in pts)
+        norm = frozenset((r - r0, c - c0) for r, c in pts)
+        result.append({"pts": frozenset(pts), "bbox": (r0, c0, r1, c1),
+                       "shape": norm, "h": r1 - r0 + 1, "w": c1 - c0 + 1})
+    return result
