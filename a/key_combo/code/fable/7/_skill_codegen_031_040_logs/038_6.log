+    """Translation that puts equal bboxes immediately beside one another."""
+    dr, dc = direction
+    if dr == 0:
+        return 0, dc * w
+    if dc == 0:
+        return dr * h, 0
+    distance = min(h, w)
+    return dr * distance, dc * distance
