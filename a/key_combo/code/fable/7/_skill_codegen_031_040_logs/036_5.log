+    return out
+
+
+def _greedy_unique(start: tuple[int, int], targets: list[tuple[int, int]]):
+    current = start
+    unused = set(targets)
+    order = []
+    while unused:
+        ranked = sorted(
+            ((r - current[0]) ** 2 + (c - current[1]) ** 2, (r, c))
+            for r, c in unused
+        )
+        if len(ranked) > 1 and ranked[0][0] == ranked[1][0]:
+            return None
+        current = ranked[0][1]
+        order.append(current)
+        unused.remove(current)
+    return order
+
