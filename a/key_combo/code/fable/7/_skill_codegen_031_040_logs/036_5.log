+    base: np.ndarray,
+    sprite: list[tuple[int, int, int]],
+    anchor: tuple[int, int],
+    turns: int,
+) -> set[tuple[int, int]] | None:
+    h, w = base.shape
+    cells: set[tuple[int, int]] = set()
