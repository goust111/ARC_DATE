def independent_path(n, initial):
    dirs = [(-1, 0), (0, 1), (1, 0), (0, -1)]
    di = dirs.index(initial)
    r = c = 0
    path = []
    arm = 1
    while len(path) < n:
        for _ in range(2):
            dr, dc = dirs[di]
            for _ in range(arm):
                if len(path) == n:
                    return path
                r, c = r + dr, c + dc
                path.append((r, c))
            di = (di + 1) % 4
        arm += 1
    return path

def case(direction, mask):
    g = np.zeros((21, 21), dtype=int)
    mr, mc = 10, 10
    g[mr, mc] = 2
    h, w = mask.shape
    if direction == (-1, 0): r0, c0 = 2, mc - 1
    elif direction == (1, 0): r0, c0 = 16, mc - 1
    elif direction == (0, -1): r0, c0 = mr - 1, 2
    else: r0, c0 = mr - 1, 16
    g[r0:r0+h, c0:c0+w][mask] = 7
    expected = np.zeros_like(g)
    expected[mr, mc] = 2
    for dr, dc in independent_path(int(mask.sum()), direction):
        expected[mr+dr, mc+dc] = 2
    actual = mod.main(g)
    assert np.array_equal(actual, expected), direction
    return g, actual

full = np.ones((3, 4), dtype=bool)
notched = full.copy(); notched[0, 3] = False
outputs = []
for direction in [(-1,0), (0,1), (1,0), (0,-1)]:
    _g, out = case(direction, full)
    outputs.append(out)
g1, o1 = case((0,1), full)
g2, o2 = case((0,1), notched)
assert g1.shape == g2.shape and full.shape == notched.shape
assert not np.array_equal(o1, o2), 'actual blob count must affect stopping point'
assert len({x.tobytes() for x in outputs}) == 4, 'heading must affect result'
assert len({mod.main(mod.generate_input()).tobytes() for _ in range(12)}) > 1
print('semantic checks passed')
