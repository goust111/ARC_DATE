+            r, c = queue.popleft()
+            for dr, dc in _DIRECTIONS:
+                neighbor = (r + dr, c + dc)
+                if neighbor in unseen:
+                    unseen.remove(neighbor)
+                    component.append(neighbor)
+                    queue.append(neighbor)
+        components.append(component)
+    return components
