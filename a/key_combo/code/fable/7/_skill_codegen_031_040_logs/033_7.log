+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    lo = coords.min(axis=0)
+    hi = coords.max(axis=0)
+    return int(lo[0]), int(lo[1]), int(hi[0]), int(hi[1])
