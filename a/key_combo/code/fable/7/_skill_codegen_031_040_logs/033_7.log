+    h, w = mask.shape
+    unseen = mask.astype(bool).copy()
+    result: list[np.ndarray] = []
+    for sr, sc in np.argwhere(unseen):
+        sr, sc = int(sr), int(sc)
+        if not unseen[sr, sc]:
