+    return {
+        "bg": bg,
+        "separator": sep,
+        "color_map": color_map,
+        "pose_index": pose_index,
+        "posed": posed,
+        "motif_mask": reference_mask,
+        "records": records,
+        "row_starts": row_starts,
+        "col_starts": col_starts,
+        "anchor_index": anchor_index,
+        "anchor_color": anchor_color,
+        "default": default,
+    }
