def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete partial workspace sprites by matching them to full templates shown in the non-black catalog region.

    Input structure
    - A large non-black connected region is the catalog background.
    - Multi-color template sprites touch that catalog background; all other
      foreground objects lie in the black workspace.
    - Some workspace objects are partial views of a catalog template, while
      distractor objects do not match any template part.

    Rule
    - For each workspace object, find the unique catalog template that it matches:
      either a full template bbox filled with one template border color, a
      uniquely sized single-color mask of the template, or a multi-color boundary
      window of the template.
    - Stamp the full matched template at the aligned position, treating catalog
      background cells inside the template bbox as transparent.
    - Leave workspace objects with no template match unchanged.

    Key insight
    - The colored objects in the catalog are not to be copied in order; they are
      a legend of target sprites, and each incomplete workspace object determines
      its template and alignment from the visible sub-sprite it already contains.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    catalog_color, catalog_mask = _catalog_background(g)
    templates = _templates(g, catalog_color, catalog_mask)

    planned: dict[tuple[int, int], int] = {}
    workspace = (g != 0) & (~catalog_mask)
    for coords in components_mask(workspace, connectivity=8):
        if _touches(catalog_mask, coords):
            continue

        box, part = _component_array(g, coords)
        r0, c0, _r1, _c1 = box
        source_mask = np.zeros_like(g, dtype=bool)
        source_mask[coords[:, 0], coords[:, 1]] = True

        matches = []
        for template in templates:
            sprite = template["grid"]
            for off_r, off_c in _template_offsets(part, template):
                anchor_r, anchor_c = r0 - off_r, c0 - off_c
                height, width = map(int, sprite.shape)
                if not (
                    0 <= anchor_r
                    and 0 <= anchor_c
                    and anchor_r + height <= g.shape[0]
                    and anchor_c + width <= g.shape[1]
                ):
                    continue

                ok = True
                for rr, cc in np.argwhere(template["visible"]):
                    gr, gc = anchor_r + int(rr), anchor_c + int(cc)
                    value = int(sprite[rr, cc])
                    if g[gr, gc] != 0 and not source_mask[gr, gc] and g[gr, gc] != value:
                        ok = False
                        break
                if ok:
                    cells = tuple(
                        (int(rr), int(cc), int(sprite[rr, cc]))
                        for rr, cc in np.argwhere(template["visible"])
                    )
                    matches.append((anchor_r, anchor_c, cells))

        unique_matches = []
    return True


def _gen_attempt() -> np.ndarray | None:
    edge = random.choice(CATALOG_EDGES)
    thickness = random.randint(*CATALOG_THICKNESS_RANGE)
    out = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
    rs, cs = _gen_catalog_slice(edge, thickness)
    out[rs, cs] = CATALOG_COLOR

    templates = _gen_templates(edge, thickness)
    if templates is None:
        return None
    random.shuffle(templates)
    _gen_place_catalog_templates(out, edge, thickness, templates)

    occupied = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
    occupied[rs, cs] = 1
    matched_count, distractor_count = _gen_workspace_counts()

    stamp_records = _gen_place_matched_objects(out, occupied, templates, matched_count)
    if stamp_records is None:
        return None

    safe_distractors = _gen_distractor_options(CATALOG_COLOR, templates)
    if not safe_distractors:
        return None
    if not _gen_place_distractors(out, occupied, safe_distractors, distractor_count):
        return None

    inp = out.copy()
    for r0, c0, (height, width), color in stamp_records:
        inp[r0 : r0 + height, c0 : c0 + width] = color
    try:
        return inp if np.array_equal(main(inp), out) else None
    except AssertionError:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input for 3ed85e70")
    h = bbox_h(b)
    w = bbox_w(b)

    if anchor == "upperleft":
        rr, cc = r0, c0
    elif anchor == "upperright":
        rr, cc = r0, c1
    elif anchor == "lowerleft":
        rr, cc = r1, c0
    elif anchor == "lowerright":
        rr, cc = r1, c1
    elif anchor == "center":
        rr, cc = r0 + (h - 1) / 2, c0 + (w - 1) / 2
    elif anchor == "uppercenter":
        rr, cc = r0, c0 + (w - 1) / 2
    elif anchor == "lowercenter":
        rr, cc = r1, c0 + (w - 1) / 2
    elif anchor == "leftcenter":
        rr, cc = r0 + (h - 1) / 2, c0
    elif anchor == "rightcenter":
        rr, cc = r0 + (h - 1) / 2, c1
    else:
        raise ValueError("bbox_anchor: invalid anchor")

    return int(round(rr)), int(round(cc))


def crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
    """Crop a grid to bbox (inclusive)."""
    r0, c0, r1, c1 = map(int, bbox)
    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()


# =============================================================================
# Paste (single canonical placement primitive)
# =============================================================================


def paste(
    dst: np.ndarray,
    patch: np.ndarray,
    r0: int,
    c0: int,
    *,
    transparent: int | None = None,
    mask: np.ndarray | None = None,
    overwrite: bool = True,
    clip: bool = False,
) -> np.ndarray:
    """
    Paste `patch` into `dst` at top-left (r0,c0).
    background: int | None = None,
) -> tuple[int, int, int]:
    """
    Score how well `grid` satisfies the symmetry.

    Returns:
        (perfect_mapping, off_canvas, bad_mapping)
    """
    n, m = grid.shape
    if background is None:
        occupied = np.argwhere(~np.isin(grid, ignore_colors))
    else:
        occupied = np.argwhere((~np.isin(grid, ignore_colors)) & (grid != int(background)))

    if occupied.size == 0:
        return 0, 0, 0

    tr, tc = symmetry.apply(occupied[:, 0], occupied[:, 1])
    in_canvas = (tr >= 0) & (tr < n) & (tc >= 0) & (tc < m)
    off_canvas = int(np.sum(~in_canvas))

    tr = tr[in_canvas]
    tc = tc[in_canvas]
    occupied = occupied[in_canvas]

    original = grid[occupied[:, 0], occupied[:, 1]]
    transformed = grid[tr, tc]

    bad = int(np.sum((original != transformed) & (~np.isin(transformed, ignore_colors))))
    perfect = int(np.sum(original == transformed))
    return perfect, off_canvas, bad


def apply_symmetry(sprite: np.ndarray, symmetry_type: str, background: int = Color.BLACK) -> np.ndarray:
    """Apply horizontal/vertical mirror symmetry within sprite bounds."""
    bg = int(background)
    n, m = sprite.shape
    if symmetry_type == "horizontal":
        for c in range(m):
            for r in range(n // 2):
                sprite[r, c] = sprite[n - 1 - r, c] = sprite[r, c] if sprite[r, c] != bg else sprite[n - 1 - r, c]
    elif symmetry_type == "vertical":
        for r in range(n):
            for c in range(m // 2):
                sprite[r, c] = sprite[r, m - 1 - c] = sprite[r, c] if sprite[r, c] != bg else sprite[r, m - 1 - c]
    else:
        raise ValueError(f"Invalid symmetry type {symmetry_type}.")
    return sprite


def apply_diagonal_symmetry(sprite: np.ndarray, background: int = Color.BLACK) -> np.ndarray:
    """Apply diagonal symmetry within bounds (square sprite only)."""
    bg = int(background)
    n, m = sprite.shape
    if n != m:
        raise ValueError("Diagonal symmetry requires a square sprite.")
    for r in range(n):
        for c in range(r + 1, m):
            col = bg
            if sprite[c, r] != bg:
                col = int(sprite[c, r])
            if sprite[r, c] != bg:
                col = int(sprite[r, c])
            sprite[r, c] = sprite[c, r] = col
    return sprite


def is_contiguous(bitmask: np.ndarray, background: int = Color.BLACK, connectivity: int = 4) -> bool:
    """Return True iff the mask contains exactly one connected component."""
    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
    _lab, n = label(bitmask != int(background), structure=struct)
    return int(n) == 1


def generate_sprite(
    n: int,
    m: int,
    symmetry_type: str,
    *,
    fill_percentage: float = 0.5,
    max_colors: int = 9,

