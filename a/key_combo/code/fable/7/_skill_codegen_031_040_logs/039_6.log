+    for (dr, dc), run in lines:
+        r, c = run[0]
+        end = run[-1]
+        while True:
+            old = slopes.get((r, c))
+            assert old is None or old == (dr, dc), "crossing mirror segments are ambiguous"
+            slopes[(r, c)] = (dr, dc)
+            if (r, c) == end:
