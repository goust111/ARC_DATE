+def _source(grid: np.ndarray, bg: int) -> tuple[Coord, int, Direction]:
+    h, w = grid.shape
+    border: list[Coord] = []
+    for c in range(w):
+        border.extend(((0, c), (h - 1, c)))
+    for r in range(1, h - 1):
+        border.extend(((r, 0), (r, w - 1)))
