+import numpy as np
+
+
+Coord = tuple[int, int]
+Direction = tuple[int, int]
+
+_DIAGONALS: tuple[Direction, ...] = ((1, 1), (1, -1))
+_CARDINALS: tuple[Direction, ...] = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
