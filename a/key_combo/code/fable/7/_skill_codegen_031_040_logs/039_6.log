+        first = (random.randint(margin, h - margin - 1), source[1])
+    elif side == "left":
+        source = (random.randint(margin, h - margin - 1), 0)
+        initial = (0, 1)
+        first = (source[0], random.randint(margin, w - margin - 1))
+    else:
+        source = (random.randint(margin, h - margin - 1), w - 1)
+        initial = (0, -1)
+        first = (source[0], random.randint(margin, w - margin - 1))
+
+    turns = [first]
+    slopes: list[Direction] = []
