+    """Return maximal exact two-step diagonal runs containing at least three dots."""
+    lines: list[tuple[Direction, tuple[Coord, ...]]] = []
+    for dr, dc in _DIAGONALS:
+        for start in sorted(points):
+            if (start[0] - 2 * dr, start[1] - 2 * dc) in points:
+                continue
