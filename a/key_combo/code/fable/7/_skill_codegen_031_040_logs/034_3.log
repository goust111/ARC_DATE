import numpy as np


def main(grid: np.ndarray) -> np.ndarray:
    """Build a larger square from the input grid and its three quarter-turn rotations.

    Input structure
    A square grid whose whole contents form the pattern; there is no separate
    background object or marker.

    Rule
    Make a 2n by 2n output from four n by n quadrants: the original grid in the
    upper-left, the grid rotated 90 degrees counterclockwise in the upper-right,
    the grid rotated 180 degrees in the lower-left, and the grid rotated 270
    degrees counterclockwise in the lower-right.

    Key insight
    The output repeats the entire input under rotation, so every input cell
    appears once in each quadrant rather than being expanded in place.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h == w

    top = np.concatenate([g, np.rot90(g, 1)], axis=1)
    bottom = np.concatenate([np.rot90(g, 2), np.rot90(g, 3)], axis=1)
    return np.concatenate([top, bottom], axis=0)

# --------------- generator (o5x) ---------------

# Canvas bounds.
GEN_SIDE_MIN, GEN_SIDE_MAX_EXCLUSIVE = 3, 6
# Color constraints.
GEN_COLOR_VALUES, GEN_COLOR_COUNT = np.arange(1, 10), 4
# Rejection and retry controls.
GEN_ROTATION_STEPS, GEN_RETRY_LIMIT = (1, 2, 3), 300


def _gen_has_quarter_turn_symmetry(grid: np.ndarray) -> bool:
    return any(np.array_equal(grid, np.rot90(grid, k)) for k in GEN_ROTATION_STEPS)


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    n = int(rng.integers(GEN_SIDE_MIN, GEN_SIDE_MAX_EXCLUSIVE))
    colors = rng.choice(GEN_COLOR_VALUES, size=GEN_COLOR_COUNT, replace=False)

    grid = rng.choice(colors, size=(n, n))
    forced = rng.choice(n * n, size=GEN_COLOR_COUNT, replace=False)
    grid.ravel()[forced] = colors

    if _gen_has_quarter_turn_symmetry(grid):
        return None

    expected = np.block([
        [grid, np.rot90(grid, 1)],
        [np.rot90(grid, 2), np.rot90(grid, 3)],
    ])
    if not np.array_equal(main(grid), expected):
        return None

    return grid.astype(int)


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_coords


def main(grid: np.ndarray) -> np.ndarray:
    """
    Use the 2x2 black marker as an eraser that clears its rows and columns except for red pixels.

    Input structure:
    - The grid is otherwise filled with colored pixels.
    - There is exactly one 2x2 black marker.
    - Red pixels are protected cells that may lie in the marker's rows or columns.

    Rule:
    - Select both rows and both columns occupied by the 2x2 black marker.
    - Recolor every selected non-red pixel to black.
    - Leave all unselected pixels and selected red pixels unchanged.

    Key insight:
    - The marker does not expand as a filled rectangle; it defines a two-row and
      two-column cross, with red pixels acting as holes in the erased cross.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    marker = g == Color.BLACK
    assert int(np.count_nonzero(marker)) == 4, "expected exactly four black marker pixels"
    r0, c0, r1, c1 = bbox_coords(np.argwhere(marker))
    assert int(r1 - r0 + 1) == 2 and int(c1 - c0 + 1) == 2, "black marker must be 2x2"
    assert np.all(marker[r0 : r1 + 1, c0 : c1 + 1]), "black marker must be solid"

    erase = np.zeros(g.shape, dtype=bool)
    erase[r0 : r1 + 1, :] = True
    erase[:, c0 : c1 + 1] = True

    out = g.copy()
    out[erase & (g != Color.RED)] = Color.BLACK
    return out

# --------------- generator (o5x) ---------------

# Canvas and fill colors.
GRID_SHAPE = (20, 20)
FILL_COLOR_RANGE = (1, 10)

# Marker placement and retry controls.
MARKER_SIZE = 2
MARKER_TOP_LEFT_MIN = 1
GENERATION_RETRIES = 300


def _gen_attempt() -> np.ndarray:
    h, w = GRID_SHAPE
    lo, hi = FILL_COLOR_RANGE
    g = np.random.randint(lo, hi, size=GRID_SHAPE, dtype=int)

    r = int(np.random.randint(MARKER_TOP_LEFT_MIN, h - MARKER_SIZE))
    c = int(np.random.randint(MARKER_TOP_LEFT_MIN, w - MARKER_SIZE))
    g[r : r + MARKER_SIZE, c : c + MARKER_SIZE] = Color.BLACK
    return g


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        inp = _gen_attempt()

        out = main(inp)
        r0, c0, r1, c1 = bbox_coords(np.argwhere(inp == Color.BLACK))

        expected = inp.copy()
        erase = np.zeros(inp.shape, dtype=bool)
        erase[r0 : r1 + 1, :] = True
        erase[:, c0 : c1 + 1] = True
        expected[erase & (inp != Color.RED)] = Color.BLACK

        if np.array_equal(out, expected):
            return inp

    raise RuntimeError("failed to generate valid input")

