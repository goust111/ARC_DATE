  "match_cond": "s.shape and s.orientation fit d without rotation; assigned slots cover every border pixel exactly once",
  "transform": "translate s into d; fill the frame interior with the background color",
  "grid_shape": "most balanced rectangle whose border pixel count equals the total foreground pixel count"
}
</annotation>
