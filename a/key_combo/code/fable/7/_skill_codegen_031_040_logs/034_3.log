EDGE_MARGIN, MIN_BBOX_GAP = 1, 2

# Layout grouping and orientation.
LAYOUT_GROUP_COUNT_OPTIONS = (2, 3)
FRAMES_PER_GROUP_RANGE = (1, 3)
ROW_LAYOUT_PROBABILITY = 0.5

