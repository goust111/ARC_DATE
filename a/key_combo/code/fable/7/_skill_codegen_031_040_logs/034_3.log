    steps = []
    remaining = total
    for i in range(slots):
        left = slots - i - 1
        lo = max(0, remaining - cap * left)
        hi = min(cap, remaining)
        step = random.randint(lo, hi)
        steps.append(step)
        remaining -= step
    return steps


def _gen_width_profile(span, max_width):
    edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)
    start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
    end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
    min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
    min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
    if min_up + min_down + 1 > span:
        return None

    peak_start = random.randint(min_up, span - 1 - min_down)
    peak_end = random.randint(peak_start, span - 1 - min_down)

    widths = [start_width]
    for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):
        widths.append(widths[-1] + step)

    widths.extend([max_width] * (peak_end - peak_start))

    current = max_width
    for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):
        current -= step
        widths.append(current)

    area = sum(widths)
    if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:
        return None
    return widths


def _choose_source_extent(n, cr):
    valid_spans = [s for s in range(SOURCE_SPAN_RANGE[0], SOURCE_SPAN_RANGE[1] + 1) if s <= n - 2 * MIN_EMPTY_BORDER_ROWS]
    span = random.choice(valid_spans)
    r0_min = max(MIN_EMPTY_BORDER_ROWS, cr - span + 1)
    r0_max = min(cr, n - MIN_EMPTY_BORDER_ROWS - span)
    r0 = random.randint(r0_min, r0_max)
    return span, r0, cr - r0


def _paint_source_cells(out, r0, widths, outer, cc):
    interior = []
    source = []
    for i, width in enumerate(widths):
        r = r0 + i
        c0 = cc - width
        for j in range(width):
            c = c0 + j
            source.append((r, c))
            if j == 0:
                out[r, c] = outer
            else:
                interior.append((r, c, i, j))
    return source, interior


def _gen_color_source(out, r0, widths, colors, cc):
    outer = colors[0]
    inner = colors[1:]
    source, interior = _paint_source_cells(out, r0, widths, outer, cc)
    if len(interior) < len(inner):
        return None

    key = COLORING_KEYS[random.randrange(len(COLORING_KEYS))]
    interior.sort(key=key)
    band_count = len(inner)
    for rank, (r, c, _, _) in enumerate(interior):
        out[r, c] = inner[min(band_count - 1, rank * band_count // len(interior))]

    return source


def _reflect_source(out, source, cr, cc):
    reflected = []
    for r, c in source:
        rr = 2 * cr - r
        rc = 2 * cc - c
        if out[rr, rc] != BG_COLOR:
            return None
        out[rr, rc] = out[r, c]
        reflected.append((rr, rc))
    return reflected


def _gen_attempt():
    n = random.choice(GRID_SIZES)
    cr = cc = n // 2
    out = np.full((n, n), BG_COLOR, dtype=int)
    out[:, cc] = DIVIDER_COLOR
    out[cr, [0, cc, n - 1]] = MARKER_COLOR

    span, r0, center_i = _choose_source_extent(n, cr)
    max_width = random.randint(*SOURCE_MAX_WIDTH_RANGE)
    widths = _gen_width_profile(span, max_width)
    if widths is None:
        return None
    if widths[center_i] >= cc:
        return None

    color_count = random.randint(*SOURCE_COLOR_COUNT_RANGE)
    colors = random.sample(SOURCE_COLORS, color_count)
    source = _gen_color_source(out, r0, widths, colors, cc)
    if source is None:
        return None

    reflected = _reflect_source(out, source, cr, cc)
    if reflected is None:
        return None

    inp = out.copy()
    for r, c in reflected:
        inp[r, c] = BG_COLOR

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input():
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid e729b7be input")
import numpy as np
from functools import reduce
from math import gcd

from arc_utils import bbox_coords, components_mask, get_bg
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete a grid of colored blocks to match a minimap legend in the top-left corner.

    Input structure:
    - bg = most common color.
    - Top-left corner: a small sprite of single colored pixels forming a minimap pattern on a regular lattice.
    - Main area: uniformly colored square blocks (NxN) arranged on a regular grid; some positions are empty (bg).

    Rule:
    - The legend pixels define a color pattern; each pixel's lattice position maps to a block position in the main grid via a fixed scale factor and offset.
    - Existing colored blocks confirm the scale/offset alignment.
    - For every legend pixel whose corresponding grid position is empty, place a new block of that color.

    Key insight: The top-left pixel pattern is a scaled-down minimap of the block layout; the mapping is inferred from blocks already present.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()
    bg = get_bg(g)

    comps = components_mask(g != bg, connectivity=4)
    singles: list[tuple[int, int, int]] = []
    blocks: list[tuple[int, int, int, int]] = []  # (r0,c0,size,color)
    for pts in comps:
        if len(pts) == 1:
            r, c = pts[0]
            singles.append((int(r), int(c), int(g[r, c])))
            continue
        r0, c0, r1, c1 = bbox_coords(pts)
        hh, ww = r1 - r0 + 1, c1 - c0 + 1
        if hh != ww or hh < 2:
            continue
        sub = g[r0 : r1 + 1, c0 : c1 + 1]
        col = int(sub[0, 0])
        if col == bg:
            continue
        if np.all(sub == col) and sub.size == len(pts):
            blocks.append((int(r0), int(c0), int(hh), col))

    assert singles and blocks, "grid must contain legend pixels and main blocks"

    # Legend pixels: singleton colored pixels in a small top-left window.
    win_r = min(h, 12)
    win_c = min(w, 12)
    legend = [(r, c, v) for (r, c, v) in singles if r < win_r and c < win_c]
    assert legend, "top-left legend must contain singleton pixels"

    # Infer legend lattice step (usually 2).
    rs = sorted({r for r, _, _ in legend})
    cs = sorted({c for _, c, _ in legend})
    drs = [rs[i + 1] - rs[i] for i in range(len(rs) - 1)]
    dcs = [cs[i + 1] - cs[i] for i in range(len(cs) - 1)]
    stepL = reduce(gcd, drs + dcs)
    assert stepL > 0, "legend lattice step must be positive"
    rmin = min(r for r, _, _ in legend)
    cmin = min(c for _, c, _ in legend)

    legend_pts: list[tuple[int, int, int]] = []
    for r, c, v in legend:
        rr = (r - rmin) // stepL
        cc = (c - cmin) // stepL
        legend_pts.append((int(rr), int(cc), int(v)))

    # Determine typical block size and step between blocks.
    sizes = [s for _, _, s, _ in blocks]
    _vals, _cnts = np.unique(np.array(sizes, dtype=int), return_counts=True)
    block_size = int(_vals[_cnts.argmax()])
    blocks = [b for b in blocks if b[2] == block_size]
    assert blocks, "must contain at least one block of the dominant block size"

    by_color: dict[int, list[tuple[int, int]]] = {}
    for r0, c0, s, col in blocks:
        by_color.setdefault(int(col), []).append((int(r0), int(c0)))
    for col in by_color:
        by_color[col].sort()

    # Compute step from block top-left positions (gcd of diffs).
    tops = sorted({r0 for r0, _, _, _ in blocks})
    lefts = sorted({c0 for _, c0, _, _ in blocks})
    step_candidates = []
    step_candidates += [tops[i + 1] - tops[i] for i in range(len(tops) - 1)]
    step_candidates += [lefts[i + 1] - lefts[i] for i in range(len(lefts) - 1)]
    step = reduce(gcd, step_candidates)
    assert step > 0, "block step must be positive"

    # Infer base offset: choose base that best maps legend pixels with existing block colors.
    bases: dict[tuple[int, int], int] = {}
    for rr, cc, col in legend_pts:
        if col not in by_color:
            continue
        for br0, bc0 in by_color[col]:
            base_r = br0 - rr * step
            base_c = bc0 - cc * step
            bases[(base_r, base_c)] = bases.get((base_r, base_c), 0) + 1
    assert bases, "existing blocks must determine the legend-to-grid offset"
    max_votes = max(bases.values())
    best_bases = [base for base, votes in bases.items() if votes == max_votes]
    assert len(best_bases) == 1, "legend-to-grid offset must be unique"
    base = best_bases[0]
    base_r, base_c = base

    # Paint blocks for all legend pixels (usually adding missing ones).
    for rr, cc, col in legend_pts:
        tr0 = base_r + rr * step
        tc0 = base_c + cc * step
        assert 0 <= tr0 <= h - block_size and 0 <= tc0 <= w - block_size, \
            "legend block projection must fit in canvas"
        out[tr0 : tr0 + block_size, tc0 : tc0 + block_size] = col
    return out

# --------------- generator (o5x) ---------------

# === CFG: canvas ===
GRID_SIZE_MIN, GRID_SIZE_MAX = 23, 27  # square grid bounds
NUM_COLORS = 10                         # total ARC color palette size

# === CFG: legend lattice ===
LEGEND_ORIGIN = (1, 1)                  # top-left pixel of the legend
LEGEND_STEP = 2                         # pixel spacing between legend dots
LEGEND_ROWS = (3, 4)                    # staircase row count options
LEGEND_COLS = (2, 3)                    # staircase column count options
LEGEND_EMPTIES = (0, 1, 2)             # how many lattice positions may be empty
LEGEND_FILLED_MIN, LEGEND_FILLED_MAX = 6, 10
PALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 2, 4  # distinct non-bg colors in legend
MAX_COUNT_PER_COLOR = 6                 # max legend pixels of one color

# === CFG: block area ===
BLOCK_SIZE_RANGE = range(2, 5)         # NxN block side length
GAP_RANGE = range(1, 4)               # gap between adjacent blocks
STEP_MIN, STEP_MAX = 3, 5             # block_size + gap bounds
BASE_C_MIN = 8                         # minimum block-area column (separates from legend)
BASE_R_MIN = 1                         # minimum block-area row

# === CFG: generation ===
MAX_RETRIES = 300


def _enumerate_staircase_shapes():
    """Enumerate all valid (widths) tuples for the staircase legend shape."""
    shapes = []
    for rows in LEGEND_ROWS:
        for cols in LEGEND_COLS:
            total = rows * cols
            for empties in LEGEND_EMPTIES:
                count = total - empties
                if not (LEGEND_FILLED_MIN <= count <= LEGEND_FILLED_MAX):
                    continue
                def rec(prefix, remaining, r):
                    if r == rows:
                        if remaining == 0 and max(prefix) == cols:
                            shapes.append(tuple(prefix))
                        return
                    left = rows - r - 1
                    lo = max(1, remaining - left * cols)
                    hi = min(cols, remaining - left)
                    for width in range(lo, hi + 1):
                        rec(prefix + [width], remaining - width, r + 1)
                rec([], count, 0)
    return shapes


# Valid (block_size, gap) pairs satisfying STEP_MIN <= block_size+gap <= STEP_MAX
_BLOCK_GAP_PAIRS = [
    (n, g) for n in BLOCK_SIZE_RANGE for g in GAP_RANGE
    if STEP_MIN <= n + g <= STEP_MAX
]
# All valid staircase width tuples, precomputed once
_STAIRCASE_SHAPES = _enumerate_staircase_shapes()


def _pick_staircase():
    """Pick a random staircase shape; return (filled_pts, adjacent_pairs)."""
    widths = random.choice(_STAIRCASE_SHAPES)
    pts = [(r, c) for r, w in enumerate(widths) for c in range(w)]
    pairs = [(r, c) for r, w in enumerate(widths) for c in range(w - 1)]
    return pts, pairs


def _random_color_counts(total, k):
    """Distribute `total` among `k` bins, each in [1, MAX_COUNT_PER_COLOR]."""
    counts = [1] * k
    remaining = total - k
    while remaining:
        open_idxs = [i for i, v in enumerate(counts) if v < MAX_COUNT_PER_COLOR]
        i = random.choice(open_idxs)
        add = random.randint(1, min(remaining, MAX_COUNT_PER_COLOR - counts[i]))
        counts[i] += add
        remaining -= add
    random.shuffle(counts)
    return counts


def _assign_legend_colors(pts, anchor_pair, palette):
    """Assign colors to legend pts via backtracking, ensuring unique anchor-pair identification."""
    pos_set = set(pts)
    first = anchor_pair
    second = (anchor_pair[0], anchor_pair[1] + 1)
    a, b = random.sample(palette, 2)
    counts = dict(zip(palette, _random_color_counts(len(pts), len(palette))))
    colors = {first: a, second: b}
    counts[a] -= 1
    counts[b] -= 1
    if counts[a] < 0 or counts[b] < 0:
        return None

    anchor_colors = (a, b)
    cells = [p for p in pts if p not in colors]

    def allowed(pos, col):
        r, c = pos
        left = (r, c - 1)
        if left in pos_set and left in colors:
            if (colors[left], col) == anchor_colors and (left, pos) != (first, second):
                return False
        right = (r, c + 1)
        if right in pos_set and right in colors:
            if (col, colors[right]) == anchor_colors and (pos, right) != (first, second):
                return False
        return True

    def search():
        if not cells:
            return all(v == 0 for v in counts.values())
        best_i, best_opts = None, None
        for i, pos in enumerate(cells):
            opts = [col for col in palette if counts[col] > 0 and allowed(pos, col)]
            if best_opts is None or len(opts) < len(best_opts):
                best_i, best_opts = i, opts
        if not best_opts:
            return False
        pos = cells.pop(best_i)
        random.shuffle(best_opts)
        for col in best_opts:
            colors[pos] = col
            counts[col] -= 1
            if search():
                return True
            counts[col] += 1
            del colors[pos]
        cells.insert(best_i, pos)
        return False

    if not search():
        return None
    return colors


def _gen_attempt():
    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    block_size, gap = random.choice(_BLOCK_GAP_PAIRS)
    step = block_size + gap
    pts, pairs = _pick_staircase()
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
from functools import lru_cache
import random


def _border(shape: tuple[int, int]) -> frozenset[tuple[int, int]]:
    h, w = shape
    return frozenset(
        (r, c)
        for r in range(h)
        for c in range(w)
        if r == 0 or r == h - 1 or c == 0 or c == w - 1
    )


def _candidate_outputs(
    bg: int, objects: list[dict], total_area: int
) -> list[np.ndarray]:
    outputs: list[tuple[int, np.ndarray]] = []

    for h in range(2, total_area + 1):
        for w in range(2, total_area + 1):
            if 2 * h + 2 * w - 4 != total_area:
                continue

            border = _border((h, w))
            placements_by_object: list[list[frozenset[tuple[int, int]]]] = []
            for obj in objects:
                placements: list[frozenset[tuple[int, int]]] = []
                for r0 in range(h - obj["h"] + 1):
                    for c0 in range(w - obj["w"] + 1):
                        cells = frozenset(
                            (r0 + r, c0 + c) for r, c in obj["rel"]
                        )
                        if cells <= border:
                            placements.append(cells)
                if not placements:
                    break
                placements_by_object.append(placements)
            else:
                order = sorted(
                    range(len(objects)),
                    key=lambda i: (
                        len(placements_by_object[i]),
                        -objects[i]["area"],
                        objects[i]["bbox"][0],
                        objects[i]["bbox"][1],
                    ),
                )
                solved: list[np.ndarray] = []

                def search(
                    k: int,
                    used: frozenset[tuple[int, int]],
                    chosen: list[tuple[int, frozenset[tuple[int, int]]]],
                ) -> None:
                    if k == len(order):
                        if used == border:
                            out = np.full((h, w), bg, dtype=int)
                            for obj_idx, cells in chosen:
                                for r, c in cells:
                                    out[r, c] = objects[obj_idx]["color"]
                            solved.append(out)
                        return

                    obj_idx = order[k]
                    for cells in placements_by_object[obj_idx]:
                        if cells & used:
                            continue
                        search(k + 1, used | cells, chosen + [(obj_idx, cells)])

                search(0, frozenset(), [])

                seen: set[tuple[int, ...]] = set()
                for out in solved:
                    key = tuple(map(int, out.ravel()))
                    if key in seen:
                        continue
                    seen.add(key)
                    outputs.append((abs(h - w), out))

    assert outputs, "the objects must assemble into at least one rectangular frame"
    best_balance = min(balance for balance, _out in outputs)
    best = [out for balance, out in outputs if balance == best_balance]
    unique = {(out.shape, tuple(map(int, out.ravel()))) for out in best}
    assert len(unique) == 1, "the most balanced frame assembly must be unique"
    return best


def main(grid: np.ndarray) -> np.ndarray:
    """Translate the colored objects into the most balanced complete rectangular frame.

    Input structure
    A grid with one dominant background color and several monochromatic
    4-connected foreground objects that are straight bars or corner-like line
    sprites.

    Rule
    Preserve every foreground object exactly, allowing translation only, and
    place the objects so they cover every pixel of a one-cell-thick rectangular
    frame exactly once; the frame interior is the background color.

    Key insight
    The output shape is not copied from the input: the foreground pixel count
    determines possible frame sizes, and the intended output is the valid frame
    assembly with the least difference between height and width.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(
        g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"
    )
    assert components, "at least one foreground object is required"

    objects: list[dict] = []
    for comp in components:
        r0, c0, r1, c1 = comp["bbox"]
        rel = tuple(
            sorted((int(r - r0), int(c - c0)) for r, c in comp["coords"])
        )
        objects.append(
            {
                "color": int(comp["color"]),
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "rel": rel,
                "h": int(r1 - r0 + 1),
                "w": int(c1 - c0 + 1),
                "area": int(comp["area"]),
            }
        )

    objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1], -obj["area"]))
    total_area = sum(obj["area"] for obj in objects)
    best = _candidate_outputs(bg, objects, total_area)
    return best[0]

# --------------- generator (att2) ---------------

# Palette and object mix.
COLOR_COUNT = 10
OBJECT_COUNT_CHOICES = (4, 5)
L_COUNTS_BY_OBJECT_COUNT = {4: (2, 3), 5: (3,)}

# Border arc and sprite shape bounds.
ARC_MIN_LEN, ARC_MAX_LEN = 1, 7
BAR_MIN_AREA, BAR_MAX_AREA = 1, 7
L_MIN_AREA, L_MAX_AREA = 3, 7
L_MIN_HEIGHT, L_MAX_HEIGHT = 2, 6
L_MIN_WIDTH, L_MAX_WIDTH = 2, 5
MIN_LENGTH_VARIETY_BY_COUNT = {4: 2, 5: 3}

# Frame, input canvas, and placement bounds.
FRAME_MIN_SIDE, FRAME_MAX_SIDE = 4, 8
FRAME_SIZE_OFFSETS = ((0, 0), (0, 1), (1, 0))
INPUT_MIN_SIDE, INPUT_MAX_SIDE, INPUT_FRAME_MARGIN = 6, 16, 2
PLACEMENT_BORDER, PLACEMENT_PADDING = 0, 0
GENERATION_ATTEMPTS = 300


def _border_coords(h: int, w: int) -> tuple[tuple[int, int], ...]:
    coords = [(0, c) for c in range(w)]
    coords += [(r, w - 1) for r in range(1, h)]
    coords += [(h - 1, c) for c in range(w - 2, -1, -1)]
    coords += [(r, 0) for r in range(h - 2, 0, -1)]
    return tuple(coords)


def _compositions(total: int, parts: int) -> list[tuple[int, ...]]:
    out: list[tuple[int, ...]] = []

    def rec(remaining: int, n: int, prefix: list[int]) -> None:
        if n == 1:
            if ARC_MIN_LEN <= remaining <= ARC_MAX_LEN:
                out.append(tuple(prefix + [remaining]))
            return
        lo = max(ARC_MIN_LEN, remaining - ARC_MAX_LEN * (n - 1))
        hi = min(ARC_MAX_LEN, remaining - ARC_MIN_LEN * (n - 1))
        for x in range(lo, hi + 1):
            rec(remaining - x, n - 1, prefix + [x])

    rec(total, parts, [])
    return out


def _coord_bounds(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
    rows, cols = zip(*coords)
    return min(rows), min(cols), max(rows), max(cols)


def _arc_kind(coords: tuple[tuple[int, int], ...]) -> str | None:
    r0, c0, r1, c1 = _coord_bounds(coords)
    h, w = r1 - r0 + 1, c1 - c0 + 1
    area = len(coords)

    if h == 1 or w == 1:
        return "bar" if BAR_MIN_AREA <= area <= BAR_MAX_AREA else None

    if not (
        L_MIN_AREA <= area <= L_MAX_AREA
        and L_MIN_HEIGHT <= h <= L_MAX_HEIGHT
        and L_MIN_WIDTH <= w <= L_MAX_WIDTH
    ):
        return None
    if area != h + w - 1:
        return None

    actual = {(r - r0, c - c0) for r, c in coords}
    for elbow_r, elbow_c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)):
        expected = {
            (r, c)
            for r in range(h)
            for c in range(w)
            if r == elbow_r or c == elbow_c
        }
        if actual == expected:
            return "L"
    return None


@lru_cache(maxsize=None)
def _valid_plans(h: int, w: int, count: int, l_count: int):
    border = _border_coords(h, w)
    perimeter = len(border)
    plans: list[tuple[tuple[tuple[int, int], ...], ...]] = []

    for start in range(perimeter):
        for lengths in _compositions(perimeter, count):
            pos = start
            arcs: list[tuple[tuple[int, int], ...]] = []
            kinds: list[str] = []
            for length in lengths:
                coords = tuple(border[(pos + i) % perimeter] for i in range(length))
                kind = _arc_kind(coords)
                if kind is None:
                    break
                arcs.append(coords)
                kinds.append(kind)
                pos = (pos + length) % perimeter
            else:
                if pos != start:
                    continue
                if kinds.count("L") != l_count or kinds.count("bar") != count - l_count:
                    continue
                if len(set(lengths)) < MIN_LENGTH_VARIETY_BY_COUNT[count]:
                    continue
                plans.append(tuple(arcs))

    return tuple(plans)


def _patch_from_arc(coords: tuple[tuple[int, int], ...], bg: int, color: int) -> np.ndarray:
    r0, c0, r1, c1 = _coord_bounds(coords)
    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
    for r, c in coords:
        patch[r - r0, c - c0] = color
    return patch
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox, components_mask, crop_bbox, get_bg, paste, random_free_location
import random


def _template_window(g: np.ndarray, fill_color: int) -> np.ndarray:
    template_bbox = bbox(g == fill_color)
    assert template_bbox is not None, "expected a fill-color template"
    template = crop_bbox(g, template_bbox)
    assert template.shape == (3, 3), "expected a 3x3 template bbox"
    return template


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete each partial copy of the yellow-marked 3x3 template by adding the template's yellow cells.

    Input structure
    - A black background contains scattered blue/teal distractors and one full 3x3 sprite whose yellow pixels mark the cells to add.
    - The yellow pixels' bounding box is the full template window.
    - Partial copies elsewhere already contain the template's non-yellow pixels in the same relative positions.

    Rule
    - Use the yellow bounding box as the 3x3 template.
    - Search every 3x3 window for an exact match to the template's non-yellow pixels.
    - At each matching window, paint yellow into the positions that are yellow in the template.

    Key insight
    - Yellow is not a target marker; it identifies the missing-cell mask to transfer onto every same-layout partial copy.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = int(get_bg(g))
    fill_color = int(Color.YELLOW)
    assert fill_color != bg, "fill color must differ from background"

    template = _template_window(g, fill_color)
    assert np.all(template != bg), "template window should be fully occupied"
    fill_mask = template == fill_color
    support_mask = template != fill_color
    assert np.any(fill_mask), "template must contain fill cells"
    assert np.any(support_mask), "template must contain support cells"

    height, width = map(int, g.shape)
    th, tw = map(int, template.shape)
    origins: list[tuple[int, int]] = []
    partial_count = 0
    for r in range(height - th + 1):
        for c in range(width - tw + 1):
            window = g[r : r + th, c : c + tw]
            if not np.array_equal(window[support_mask], template[support_mask]):
                continue
            if not np.all(np.isin(window[fill_mask], [bg, fill_color])):
                continue
            origins.append((r, c))
            if np.any(window[fill_mask] == bg):
                partial_count += 1

    assert origins, "expected at least the source template to match"
    assert partial_count >= 1, "expected at least one partial copy to complete"

    out = g.copy()
    for r, c in origins:
        patch = out[r : r + th, c : c + tw]
        patch[fill_mask] = fill_color
    return out

# --------------- generator (o5x) ---------------

# Canvas/template structure.
GRID_SHAPE = (22, 22)
TEMPLATE_SIZE = 3
EMPTY_COLOR, FILL_COLOR = 0, int(Color.YELLOW)
SUPPORT_COLORS = (int(Color.BLUE), int(Color.TEAL))
FILL_COUNT_RANGE, PARTIAL_COPY_RANGE = (4, 6), (1, 2)

# Distractor sampling.
DISTRACTOR_TOTAL_RANGE = (47, 85)
DISTRACTOR_CLUSTER_MAX, DISTRACTOR_MISS_LIMIT, DISTRACTOR_CONNECTIVITY = 7, 80, 8
SINGLE_CELL_CLUSTER_PROB = 0.68
ORTHOGONAL_STEPS = ((1, 0), (-1, 0), (0, 1), (0, -1))

# Retry policy.
GENERATION_ATTEMPTS = 300


def _gen_template() -> tuple[np.ndarray, np.ndarray]:
    fill_count = random.randint(*FILL_COUNT_RANGE)
    fill = {
        (0, random.randrange(TEMPLATE_SIZE)),
        (TEMPLATE_SIZE - 1, random.randrange(TEMPLATE_SIZE)),
        (random.randrange(TEMPLATE_SIZE), 0),
        (random.randrange(TEMPLATE_SIZE), TEMPLATE_SIZE - 1),
    }
    remaining = [(r, c) for r in range(TEMPLATE_SIZE) for c in range(TEMPLATE_SIZE) if (r, c) not in fill]
    random.shuffle(remaining)
    for coord in remaining[: fill_count - len(fill)]:
        fill.add(coord)

    template = np.zeros((TEMPLATE_SIZE, TEMPLATE_SIZE), dtype=int)
    fill_mask = np.zeros((TEMPLATE_SIZE, TEMPLATE_SIZE), dtype=bool)
    for r, c in fill:
        fill_mask[r, c] = True
        template[r, c] = FILL_COLOR

    support = [(r, c) for r in range(TEMPLATE_SIZE) for c in range(TEMPLATE_SIZE) if not fill_mask[r, c]]
    support_colors = list(SUPPORT_COLORS)
    support_colors += [random.choice(SUPPORT_COLORS) for _ in range(len(support) - 2)]
    random.shuffle(support_colors)
    for (r, c), color in zip(support, support_colors):
        template[r, c] = color
    return template, fill_mask


def _gen_support_match_origins(
    grid: np.ndarray, template: np.ndarray, intended_origins: set[tuple[int, int]]
) -> list[tuple[int, int]]:
    support_mask = template != FILL_COLOR
    bad: list[tuple[int, int]] = []
    for r in range(grid.shape[0] - TEMPLATE_SIZE + 1):
        for c in range(grid.shape[1] - TEMPLATE_SIZE + 1):
            if (r, c) in intended_origins:
                continue
            window = grid[r : r + TEMPLATE_SIZE, c : c + TEMPLATE_SIZE]
            if np.array_equal(window[support_mask], template[support_mask]):
                bad.append((r, c))
    return bad


def _gen_cluster_offsets(size: int) -> list[tuple[int, int]]:
    cells = [(0, 0)]
    while len(cells) < size:
        r, c = random.choice(cells)
        dr, dc = random.choice(ORTHOGONAL_STEPS)
        nxt = (r + dr, c + dc)
        if nxt not in cells:
            cells.append(nxt)
    min_r = min(r for r, _ in cells)
    min_c = min(c for _, c in cells)
    return [(r - min_r, c - min_c) for r, c in cells]


def _gen_try_place_distractor_cluster(
    grid: np.ndarray,
    offsets: list[tuple[int, int]],
    intended_origins: set[tuple[int, int]],
    reserved_mask: np.ndarray,
    template: np.ndarray,
) -> int:
    colors = [random.choice(SUPPORT_COLORS) for _ in offsets]
    max_r = grid.shape[0] - max(r for r, _ in offsets)
    max_c = grid.shape[1] - max(c for _, c in offsets)
    anchors = [(r, c) for r in range(max_r) for c in range(max_c)]
    random.shuffle(anchors)

    for r0, c0 in anchors:
        coords = [(r0 + dr, c0 + dc) for dr, dc in offsets]
        if any(grid[r, c] != EMPTY_COLOR for r, c in coords):
            continue
        trial = grid.copy()
        for (r, c), color in zip(coords, colors):
            trial[r, c] = color
        if _gen_support_match_origins(trial, template, intended_origins):
            continue
        distractor_mask = (trial != EMPTY_COLOR) & ~reserved_mask
        if any(
            len(comp) > DISTRACTOR_CLUSTER_MAX
            for comp in components_mask(distractor_mask, connectivity=DISTRACTOR_CONNECTIVITY)
        ):
            continue
        grid[:, :] = trial
        return len(coords)
    return 0


def _gen_add_distractors(
    grid: np.ndarray,
    template: np.ndarray,
    intended_origins: set[tuple[int, int]],
    reserved_mask: np.ndarray,
    target: int,
) -> bool:
    placed = 0
    misses = 0
    while placed < target and misses < DISTRACTOR_MISS_LIMIT:
        remaining = target - placed
        if remaining == 1 or random.random() < SINGLE_CELL_CLUSTER_PROB:
            size = 1
        else:
            size = random.randint(2, min(DISTRACTOR_CLUSTER_MAX, remaining))
        offsets = _gen_cluster_offsets(size)
        added = _gen_try_place_distractor_cluster(grid, offsets, intended_origins, reserved_mask, template)
        if added:
            placed += added
            misses = 0
        else:
            misses += 1
    return placed == target


def _gen_place_template_copies(
    grid: np.ndarray, template: np.ndarray
) -> tuple[tuple[int, int], list[tuple[int, int]]]:
    """Place the source template, then output-state copies to hide later."""
    source_origin = random_free_location(grid, template, transparent=EMPTY_COLOR)
    paste(grid, template, *source_origin)

    partial_origins: list[tuple[int, int]] = []
    for _ in range(random.randint(*PARTIAL_COPY_RANGE)):
        origin = random_free_location(grid, template, transparent=EMPTY_COLOR)
        paste(grid, template, *origin)
        partial_origins.append(origin)
    return source_origin, partial_origins


def _gen_attempt() -> np.ndarray | None:
    template, fill_mask = _gen_template()
    out = np.zeros(GRID_SHAPE, dtype=int)

    try:
        source_origin, partial_origins = _gen_place_template_copies(out, template)
    except ValueError:
        return None

    intended_origins = {source_origin, *partial_origins}
    if _gen_support_match_origins(out, template, intended_origins):
        return None

    reserved_mask = np.zeros(GRID_SHAPE, dtype=bool)
    for r, c in intended_origins:
        reserved_mask[r : r + TEMPLATE_SIZE, c : c + TEMPLATE_SIZE] = True

    target = random.randint(*DISTRACTOR_TOTAL_RANGE)
    if not _gen_add_distractors(out, template, intended_origins, reserved_mask, target):
        return None

    inp = out.copy()
    for r, c in partial_origins:
        patch = inp[r : r + TEMPLATE_SIZE, c : c + TEMPLATE_SIZE]
        patch[fill_mask] = EMPTY_COLOR

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise ValueError("failed to generate a valid bb52a14b input")
