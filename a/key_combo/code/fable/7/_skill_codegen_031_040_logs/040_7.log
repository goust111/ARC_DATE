# Canvas, palette, and object counts.
GRID_HEIGHT_RANGE, GRID_WIDTH_RANGE = (5, 9), (9, 13)
OBJECT_COUNT_RANGE, FOREGROUND_COLORS, BACKGROUND_COLOR = (3, 4), range(1, 10), 0

# Blob size, density, and area bounds.
LARGEST_AREA_RANGE, DISTRACTOR_AREA_RANGE = (6, 10), (3, 6)
LARGEST_HEIGHT_RANGE, DISTRACTOR_HEIGHT_RANGE = (3, 4), (2, 4)
BLOB_WIDTH_RANGE, MIN_FILL_NUMERATOR, MIN_FILL_DENOMINATOR = (2, 3), 14, 25

# Placement and retry behavior.
PLACEMENT_PADDING, PLACEMENT_PADDING_CONNECTIVITY, MAX_GENERATION_ATTEMPTS = 1, 8, 300
FOUR_NEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_be94b721_min_fill_area(height: int, width: int) -> int:
    return (MIN_FILL_NUMERATOR * int(height) * int(width) + MIN_FILL_DENOMINATOR - 1) // MIN_FILL_DENOMINATOR


def _gen_be94b721_dim_choices(area: int, *, largest: bool) -> list[tuple[int, int]]:
    row_min, row_max = LARGEST_HEIGHT_RANGE if largest else DISTRACTOR_HEIGHT_RANGE
    choices: list[tuple[int, int]] = []
    for height in range(row_min, row_max + 1):
        for width in range(BLOB_WIDTH_RANGE[0], BLOB_WIDTH_RANGE[1] + 1):
            if area > height * width:
                continue
            if area < _gen_be94b721_min_fill_area(height, width):
                continue
            if area < height + width - 1:
                continue
            choices.append((height, width))
    return choices


def _gen_be94b721_connected_mask(height: int, width: int, area: int) -> np.ndarray:
    mask = np.zeros((height, width), dtype=bool)
    if random.choice([False, True]):
        r, c = 0, random.choice([0, width - 1])
        end_r, end_c = height - 1, width - 1 - c
    else:
        r, c = random.choice([0, height - 1]), 0
        end_r, end_c = height - 1 - r, width - 1

    mask[r, c] = True
    while (r, c) != (end_r, end_c):
        moves = []
        if r != end_r:
            moves.append((r + (1 if end_r > r else -1), c))
        if c != end_c:
            moves.append((r, c + (1 if end_c > c else -1)))
        r, c = random.choice(moves)
        mask[r, c] = True

    while int(mask.sum()) < int(area):
        frontier: set[tuple[int, int]] = set()
        for rr, cc in np.argwhere(mask):
            for dr, dc in FOUR_NEIGHBOR_OFFSETS:
                nr, nc = rr + dr, cc + dc
                if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
                    frontier.add((int(nr), int(nc)))
        if not frontier:
            return mask
        rr, cc = random.choice(tuple(frontier))
        mask[rr, cc] = True
    return mask


def _gen_be94b721_blob(color: int, area: int, *, largest: bool) -> np.ndarray:
    height, width = random.choice(_gen_be94b721_dim_choices(area, largest=largest))
    mask = _gen_be94b721_connected_mask(height, width, area)
    patch = np.zeros((height, width), dtype=int)
    patch[mask] = int(color)
    return patch


def _gen_be94b721_components(colors: list[int]) -> tuple[list[tuple[np.ndarray, int]], np.ndarray]:
    """Build patches in sampling order; the first color is the expected answer."""
    largest_area = random.randint(*LARGEST_AREA_RANGE)
    largest_patch = _gen_be94b721_blob(colors[0], largest_area, largest=True)
    components: list[tuple[np.ndarray, int]] = [(largest_patch, largest_area)]

    max_distractor_area = min(DISTRACTOR_AREA_RANGE[1], largest_area - 1)
    for color in colors[1:]:
        area = random.randint(DISTRACTOR_AREA_RANGE[0], max_distractor_area)
        components.append((_gen_be94b721_blob(color, area, largest=False), area))
    return components, largest_patch


def _gen_be94b721_place_components(canvas: np.ndarray, components: list[tuple[np.ndarray, int]]) -> bool:
    """Place larger patches first; shuffle randomizes same-area tie order."""
    order = list(range(len(components)))
    random.shuffle(order)
    order.sort(key=lambda i: components[i][1], reverse=True)
    for index in order:
        patch, _area = components[index]
        try:
            r0, c0 = random_free_location(
                canvas,
                patch,
                transparent=BACKGROUND_COLOR,
                padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_PADDING_CONNECTIVITY,
            )
        except ValueError:
            return False
        paste(canvas, patch, r0, c0, transparent=BACKGROUND_COLOR)
    return True


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*GRID_HEIGHT_RANGE)
    width = random.randint(*GRID_WIDTH_RANGE)
    n_objects = random.randint(*OBJECT_COUNT_RANGE)
    colors = random.sample(FOREGROUND_COLORS, n_objects)
    components, expected = _gen_be94b721_components(colors)

    canvas = np.zeros((height, width), dtype=int)
    if not _gen_be94b721_place_components(canvas, components):
        return None
    try:
        actual = main(canvas)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return canvas


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid be94b721 input")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg


_BACK_TO_FRONT_QUADRANTS = ((0, 0), (1, 1), (1, 0), (0, 1))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Overlay the four monochrome quadrant masks onto their common half-size canvas.

    Input structure
    The input is a 2x2 arrangement of equal-size regions on a uniform background.
    Each region contains foreground pixels of exactly one color, forming one mask
    at the output scale.

    Rule
    Start with a background output the size of one region. Stamp the masks from
    back to front by quadrant position: top-left, bottom-right, bottom-left,
    then top-right. Later masks overwrite earlier masks where they overlap.

    Key insight
    Folding all four quadrants onto the same coordinates gives the output
    canvas; the quadrant positions encode the visible layer stack.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)
    assert height % 2 == 0 and width % 2 == 0, "input must split into four equal regions"

    region_h, region_w = height // 2, width // 2
    assert region_h > 0 and region_w > 0, "quadrant regions must be nonempty"

    bg = get_bg(g)
    out = np.full((region_h, region_w), bg, dtype=int)

    seen_colors: set[int] = set()
    for qr, qc in _BACK_TO_FRONT_QUADRANTS:
        region = g[qr * region_h : (qr + 1) * region_h, qc * region_w : (qc + 1) * region_w]
        foreground_colors = colors_present(region, exclude=[bg])
        assert len(foreground_colors) == 1, "each quadrant must have exactly one foreground color"

        color = foreground_colors[0]
        assert color not in seen_colors, "quadrant foreground colors must be distinct"
        seen_colors.add(color)

        out[region != bg] = color

    assert len(seen_colors) == 4, "expected four colored masks"
    return out

# --------------- generator (o5x) ---------------

# Canvas geometry and background.
_GEN_REGION_H, _GEN_REGION_W = 4, 4
_GEN_BG = 0

# Mask density, connectivity, and union-coverage constraints.
_GEN_MIN_MASK_AREA, _GEN_MAX_MASK_AREA = 4, 12
_GEN_MIN_COMPONENTS, _GEN_MAX_COMPONENTS = 1, 4
_GEN_CONNECTIVITY = 4
_GEN_MIN_UNION_COVERAGE = 13
_GEN_COMPONENT_VALUES = tuple(range(_GEN_MIN_COMPONENTS, _GEN_MAX_COMPONENTS + 1))

# Quadrant layout, layer order, fixed observed colors, and retry limit.
_GEN_QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
_GEN_BACK_TO_FRONT = ((0, 0), (1, 1), (1, 0), (0, 1))
_GEN_COLORS = {(0, 0): 4, (0, 1): 5, (1, 0): 6, (1, 1): 9}
_GEN_RETRY_LIMIT = 300

_GEN_RNG = np.random.default_rng()


def _gen_build_mask_options() -> dict[tuple[int, int], list[np.ndarray]]:
    """Group every feasible 4x4 mask by (area, component_count)."""
    options: dict[tuple[int, int], list[np.ndarray]] = {
        (area, comp_count): []
        for area in range(_GEN_MIN_MASK_AREA, _GEN_MAX_MASK_AREA + 1)
        for comp_count in _GEN_COMPONENT_VALUES
    }

    for bits in range(1 << (_GEN_REGION_H * _GEN_REGION_W)):
        area = bits.bit_count()
        if not _GEN_MIN_MASK_AREA <= area <= _GEN_MAX_MASK_AREA:
            continue

        vals = np.array(
            [(bits >> i) & 1 for i in range(_GEN_REGION_H * _GEN_REGION_W)],
            dtype=np.uint8,
        ).reshape(_GEN_REGION_H, _GEN_REGION_W)
        comp_count = len(
            find_components(
                vals,
                bg=_GEN_BG,
                connectivity=_GEN_CONNECTIVITY,
                monochromatic=True,
                return_format="dict",
            )
        )
        if _GEN_MIN_COMPONENTS <= comp_count <= _GEN_MAX_COMPONENTS:
            options[(area, comp_count)].append(vals.astype(bool))

    return options


_GEN_MASK_OPTIONS = _gen_build_mask_options()


def _gen_sample_mask() -> np.ndarray:
    area = int(_GEN_RNG.integers(_GEN_MIN_MASK_AREA, _GEN_MAX_MASK_AREA + 1))
    feasible_comp_counts = [
        comp_count
        for comp_count in _GEN_COMPONENT_VALUES
        if _GEN_MASK_OPTIONS[(area, comp_count)]
    ]
    comp_count = int(_GEN_RNG.choice(feasible_comp_counts))
    bucket = _GEN_MASK_OPTIONS[(area, comp_count)]
    return bucket[int(_GEN_RNG.integers(len(bucket)))].copy()


def _gen_render_output(masks: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    out = np.zeros((_GEN_REGION_H, _GEN_REGION_W), dtype=int)
    for quadrant in _GEN_BACK_TO_FRONT:
        out[masks[quadrant]] = _GEN_COLORS[quadrant]
    return out


def _gen_render_input(masks: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    inp = np.zeros((_GEN_REGION_H * 2, _GEN_REGION_W * 2), dtype=int)
    for (qr, qc), mask in masks.items():
        region = inp[
            qr * _GEN_REGION_H : (qr + 1) * _GEN_REGION_H,
            qc * _GEN_REGION_W : (qc + 1) * _GEN_REGION_W,
        ]
        region[mask] = _GEN_COLORS[(qr, qc)]
    return inp


def _gen_matches_main(inp: np.ndarray, out: np.ndarray) -> bool:
    try:
        solved = main(inp)
    except AssertionError:
        return False
    return bool(np.array_equal(solved, out))


def _gen_attempt() -> np.ndarray | None:
    masks = {quadrant: _gen_sample_mask() for quadrant in _GEN_QUADRANTS}
    union = np.logical_or.reduce(list(masks.values()))
    if int(union.sum()) < _GEN_MIN_UNION_COVERAGE:
        return None

    out = _gen_render_output(masks)
    inp = _gen_render_input(masks)
    if not _gen_matches_main(inp, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRY_LIMIT):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate a valid 75b8110e input")

