+_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_SEEN_GENERATED_OUTPUTS: set[tuple[tuple[int, int], bytes]] = set()
+_MAX_GENERATION_ATTEMPTS = 500
