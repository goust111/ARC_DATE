    profiles = []
    for object_count in GEN_OBJECT_COUNT_CHOICES:
        for answer_area in range(GEN_ANSWER_AREA_MIN, GEN_ANSWER_AREA_MAX_EXCLUSIVE):
            max_other = int(answer_area / GEN_ANSWER_TO_SECOND_MIN_RATIO)
            min_total = answer_area + object_count - 1
            max_total = answer_area + (object_count - 1) * max_other
            bg_limited_total = GEN_GRID_CELLS - 1 - clutter_sum - max(clutter_totals)
            lo = max(min_total, GEN_FOREGROUND_TOTAL_MIN - clutter_sum)
            hi = min(max_total, GEN_FOREGROUND_TOTAL_MAX - clutter_sum, bg_limited_total)
            if lo <= hi:
                profiles.append((object_count, answer_area, max_other, lo, hi))

    if not profiles:
        return 0, []

    object_count, answer_area, max_other, lo, hi = random.choice(profiles)
    object_total = random.randint(lo, hi)
    other_areas = _gen_area_tuple(object_count - 1, object_total - answer_area, max_other)
    return answer_area, other_areas


def _gen_rect_patch(area: int, color: int) -> np.ndarray | None:
    pairs = []
    for h in range(1, min(GEN_RECT_MAX_SIDE, area) + 1):
        if area % h == 0:
            w = area // h
            if w <= GEN_RECT_MAX_SIDE and (area <= GEN_TINY_AREA_MAX or min(h, w) >= GEN_RECT_MIN_SIDE):
                pairs.append((h, w))
                if h != w:
                    pairs.append((w, h))
    if not pairs:
        return None
    h, w = random.choice(pairs)
    return np.full((h, w), color, dtype=int)


def _gen_grow_connected_coords(
    h: int,
    w: int,
    area: int,
    coords: set[tuple[int, int]],
) -> set[tuple[int, int]]:
    while len(coords) < area:
        frontier = {
            (r + dr, c + dc)
            for r, c in coords
            for dr, dc in GEN_NEIGHBOR_OFFSETS
            if 0 <= r + dr < h and 0 <= c + dc < w and (r + dr, c + dc) not in coords
        }
        coords.add(random.choice(tuple(frontier)))
    return coords


def _gen_object_patch(area: int, color: int) -> np.ndarray:
    if area <= GEN_TINY_AREA_MAX or random.random() < GEN_RECT_PATCH_PROB:
        rect = _gen_rect_patch(area, color)
        if rect is not None:
            return rect

    dims = []
    for h in range(GEN_OBJECT_BOX_SIDE_MIN, GEN_OBJECT_BOX_SIDE_MAX_EXCLUSIVE):
        for w in range(GEN_OBJECT_BOX_SIDE_MIN, GEN_OBJECT_BOX_SIDE_MAX_EXCLUSIVE):
            box_area = h * w
            if (
                box_area >= area
                and area * 100 >= GEN_OBJECT_DENSITY_PERCENT_MIN * box_area
                and h + w - 1 <= area
            ):
                dims.append((h, w))
    if not dims:
        rect = _gen_rect_patch(area, color)
        if rect is not None:
            return rect
        raise ValueError("no object patch dimensions")

    h, w = random.choice(dims)
    cr = random.randrange(h)
    cc = random.randrange(w)
    coords = {(r, cc) for r in range(h)}
    coords.update((cr, c) for c in range(w))
    coords = _gen_grow_connected_coords(h, w, area, coords)
    patch = np.zeros((h, w), dtype=int)
    arr = np.array(tuple(coords), dtype=int)
    patch[arr[:, 0], arr[:, 1]] = color
    return patch


def _gen_trim_patch(mask: np.ndarray, color: int) -> np.ndarray:
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    patch[coords[:, 0] - r0, coords[:, 1] - c0] = color
    return patch


def _gen_fragment_patch(size: int, color: int) -> np.ndarray:
    if size == 1:
        return np.array([[color]], dtype=int)

    max_side = GEN_FRAGMENT_SMALL_MAX_SIDE if size <= GEN_FRAGMENT_SMALL_SIZE_LIMIT else GEN_FRAGMENT_LARGE_MAX_SIDE
    dims = [
        (h, w)
        for h in range(1, max_side + 1)
        for w in range(1, max_side + 1)
        if h * w >= size and h * w <= size + GEN_FRAGMENT_BOX_AREA_SLACK and h + w > 2
    ]
    h, w = random.choice(dims)
    coords = {(random.randrange(h), random.randrange(w))}
    coords = _gen_grow_connected_coords(h, w, size, coords)

    mask = np.zeros((h, w), dtype=bool)
    arr = np.array(tuple(coords), dtype=int)
    mask[arr[:, 0], arr[:, 1]] = True
    return _gen_trim_patch(mask, color)


def _gen_valid_fragment_locations(canvas: np.ndarray, patch: np.ndarray, color: int) -> list[tuple[int, int]]:
    """Return placements where this fragment neither overlaps nor 4-touches same-color clutter."""
    coords = [tuple(map(int, rc)) for rc in np.argwhere(patch == color)]
    coord_set = set(coords)
    h, w = patch.shape
    rows, cols = canvas.shape
    locations = []

    for r0 in range(rows - h + 1):
        for c0 in range(cols - w + 1):
            ok = True
            for dr, dc in coords:
                r = r0 + dr
                c = c0 + dc
                if canvas[r, c] != GEN_BACKGROUND:
                    ok = False
                    break
                for dr, dc in GEN_NEIGHBOR_OFFSETS:
                    nr, nc = r + dr, c + dc
                    if (nr - r0, nc - c0) in coord_set:
                        continue
                    if 0 <= nr < rows and 0 <= nc < cols and canvas[nr, nc] == color:
                        ok = False
                        break
                if not ok:
                    break
            if ok:
                locations.append((r0, c0))
    return locations


def _gen_place_clutter(canvas: np.ndarray, color: int, total: int, count: int) -> bool:
    for size in _gen_fragment_sizes(total, count):
        placed = False
        for _ in range(GEN_FRAGMENT_PLACEMENT_RETRIES):
            patch = _gen_fragment_patch(size, color)
            locations = _gen_valid_fragment_locations(canvas, patch, color)
            if locations:
                r, c = random.choice(locations)
                _gen_paste(canvas, patch, r, c, transparent=0)
                placed = True
                break
        if not placed:
            return False
    return True


def _gen_validate(
    grid: np.ndarray,
    answer_color: int,
    object_specs: list[tuple[int, int]],
    clutter_specs: list[tuple[int, int, int]],
) -> bool:
    counts = {int(c): int((grid == c).sum()) for c in np.unique(grid)}
    if _gen_get_bg(grid) != 0 or counts[0] <= max(v for k, v in counts.items() if k != 0):
        return False

    for color, area in object_specs:
        comps = _gen_components_mask(grid == color, connectivity=GEN_CONNECTIVITY)
        if len(comps) != 1 or int(comps[0].shape[0]) != area:
            return False

    for color, total, count in clutter_specs:
        comps = _gen_components_mask(grid == color, connectivity=GEN_CONNECTIVITY)
        sizes = [int(comp.shape[0]) for comp in comps]
        if len(comps) != count or sum(sizes) != total:
            return False
        if not (
            GEN_CLUTTER_AVG_FRAGMENT_MIN <= total / count <= GEN_CLUTTER_AVG_FRAGMENT_MAX
            and GEN_FRAGMENT_MAX_SIZE_MIN <= max(sizes) <= GEN_FRAGMENT_MAX_SIZE_MAX
        ):
            return False

    expected = np.full(GEN_OUTPUT_SHAPE, answer_color, dtype=int)
    return bool(np.array_equal(main(grid), expected))


def _gen_sample_scene_plan() -> tuple[list[tuple[int, int]], list[tuple[int, int, int]], int] | None:
    clutter_profiles = [_gen_pick_clutter_profile(), _gen_pick_clutter_profile()]
    clutter_totals = [total for total, _ in clutter_profiles]
    answer_area, other_areas = _gen_pick_object_areas(clutter_totals)
    if answer_area == 0:
        return None

    object_count = len(other_areas) + 1
    colors = random.sample(GEN_PALETTE, object_count + GEN_CLUTTER_COLOR_COUNT)
    object_colors = colors[:object_count]
    clutter_colors = colors[object_count:]
    answer_color = object_colors[0]
    object_specs = [(answer_color, answer_area)]
    object_specs.extend(zip(object_colors[1:], other_areas))
    clutter_specs = [
        (color, total, count)
        for color, (total, count) in zip(clutter_colors, clutter_profiles)
    ]
    return object_specs, clutter_specs, answer_color


def _gen_place_objects(grid: np.ndarray, object_specs: list[tuple[int, int]]) -> bool:
    for color, area in sorted(object_specs, key=lambda item: item[1], reverse=True):
        patch = _gen_object_patch(area, color)
        try:
            r, c = _gen_random_free_location(grid, patch, transparent=GEN_BACKGROUND)
        except ValueError:
            return False
        _gen_paste(grid, patch, r, c, transparent=GEN_BACKGROUND)
    return True


def _gen_attempt() -> np.ndarray | None:
    plan = _gen_sample_scene_plan()
    if plan is None:
        return None

    object_specs, clutter_specs, answer_color = plan
    grid = np.zeros(GEN_GRID_SHAPE, dtype=int)
    if not _gen_place_objects(grid, object_specs):
        return None
    for color, total, count in clutter_specs:
        if not _gen_place_clutter(grid, color, total, count):
            return None

    if not _gen_validate(grid, answer_color, object_specs, clutter_specs):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise AssertionError("failed to generate valid 3194b014 input")
from collections import Counter

import numpy as np

from arc_utils import find_components, get_bg
import random


def _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:
    H, W = shape
    if corner == "TL":
        return int(r), int(c)
    if corner == "TR":
        return int(r), int(W - 1 - c)
    if corner == "BL":
        return int(H - 1 - r), int(c)
    assert corner == "BR"
    return int(H - 1 - r), int(W - 1 - c)


def _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:
    H, W = out.shape
    assert side > 0, "triangle side length must be positive"
    for r in range(H):
        for c in range(W):
            a, b = _corner_distances((H, W), corner, r, c)
            if a + b < side:
                out[r, c] = int(color)


def _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:
    r0 = min(r for r, _ in coords)
    r1 = max(r for r, _ in coords)
    c0 = min(c for _, c in coords)
    c1 = max(c for _, c in coords)
    height = r1 - r0 + 1
    width = c1 - c0 + 1
    if height != width:
        return None
    n = height
    local = {(r - r0, c - c0) for r, c in coords}
    main_ok = all((c, r) in local for r, c in local)
    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)
    if main_ok:
        if (0, 0) in local and (n - 1, n - 1) not in local:
            return "TL"
        if (n - 1, n - 1) in local and (0, 0) not in local:
            return "BR"
    if anti_ok:
        if (0, n - 1) in local and (n - 1, 0) not in local:
            return "TR"
        if (n - 1, 0) in local and (0, n - 1) not in local:
            return "BL"
    return None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.

    Input structure
    - The background is the dominant color.
    - Exactly one grid corner contains a foreground control pixel; it gives the
      corner from which the triangle is painted.
    - There is one unique largest 8-connected monochrome foreground object, the
      motif that remains in the output; all other foreground pixels are controls.
    - Every foreground component outside that motif is a singleton control pixel.
    - The fill color is the unique control color that appears in at least two
      non-corner control pixels.

    Rule
    - Start from a blank background canvas and redraw only the largest motif.
    - Count the non-corner control pixels; that count is the triangle side.
    - Paint the fill color on the right-triangle region where those two distances
      from the marked corner's edges sum to less than the side length.

    Key insight
    - The scattered singleton controls are counted into a compact triangular
      stack at the marked corner; only the largest motif is not part of the count.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape

    corners = {
        "TL": (0, 0),
        "TR": (0, W - 1),
        "BL": (H - 1, 0),
        "BR": (H - 1, W - 1),
    }
    marked_corners = [
        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)
    ]
    assert len(marked_corners) == 1, "expected exactly one foreground corner marker"
    corner, (corner_r, corner_c) = marked_corners[0]

    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)
    assert comps, "expected at least one foreground component"
    max_area = max(int(comp["area"]) for comp in comps)
    motif_candidates = [comp for comp in comps if int(comp["area"]) == max_area]
    assert len(motif_candidates) == 1, "expected a unique largest motif"
    motif = motif_candidates[0]
    motif_color = int(motif["color"])
    motif_coords = {tuple(map(int, coord)) for coord in motif["coords"]}
    motif_direction = _diagonal_direction(motif_coords)
    assert motif_direction is not None, "motif must be square and diagonal-symmetric"
    assert motif_direction == corner, "corner marker must match motif diagonal direction"

    control_coords = [
        (int(r), int(c))
        for r, c in np.argwhere(g != bg)
        if (int(r), int(c)) not in motif_coords
    ]
    assert (corner_r, corner_c) in control_coords, "corner marker must be a control pixel"
    assert len(control_coords) > 1, "expected non-corner control pixels"

    control_components = [comp for comp in comps if comp is not motif]
    assert all(int(comp["area"]) == 1 for comp in control_components), "controls must be singleton components"

    control_counts = Counter(
        int(g[r, c])
        for r, c in control_coords
        if (int(r), int(c)) != (corner_r, corner_c)
    )
    fill_candidates = [
        int(color) for color, count in control_counts.items() if int(count) >= 2
    ]
    assert len(fill_candidates) == 1, "expected one repeated non-corner fill color"
    fill_color = fill_candidates[0]
    side = len(control_coords) - 1

    out = np.full_like(g, bg)
    for r, c in motif_coords:
        out[r, c] = motif_color
    _paint_corner_triangle(out, corner, int(side), fill_color)
    return out

# --------------- generator (att2) ---------------

_GEN_ATTEMPTS = 300

# Canvas and triangle bounds.
_GEN_ROW_BOUNDS = (6, 15)
_GEN_COL_BOUNDS = (9, 14)
_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)

# Color and control-pixel sampling.
_GEN_COLORS = tuple(range(1, 10))
_GEN_MARKER_AVOID_FILL_PROB = 0.8
_GEN_FILL_COUNT_BOUNDS = (2, 3)

# Sparse square motifs observed in the task examples.
_GEN_MOTIF_TEMPLATES = [
    ("..#.", ".#..", "#.#.", "...#"),
    (".#...", "..#..", "..##.", ".#..#", "#...."),
    (
        "...###...",
        "..#......",
        ".##......",
        "#..#.....",
        "#...#....",
        "#....#...",
        "......#..",
        ".......#.",
        "........#",
    ),
    ("#...", ".#.#", "..#.", ".#.."),
    ("...#", "#.#.", "##..", ".##."),
]


def _gen_triangle_mask(shape, corner, side):
    H, W = shape
    rr, cc = np.indices((H, W))
    if corner == "TL":
        return rr + cc < side
    if corner == "TR":
        return rr + (W - 1 - cc) < side
    if corner == "BL":
        return (H - 1 - rr) + cc < side
    return (H - 1 - rr) + (W - 1 - cc) < side


def _gen_dilate8(mask):
    out = mask.copy()
    out[1:, :] |= mask[:-1, :]
    out[:-1, :] |= mask[1:, :]
    out[:, 1:] |= mask[:, :-1]
    out[:, :-1] |= mask[:, 1:]
    out[1:, 1:] |= mask[:-1, :-1]
    out[1:, :-1] |= mask[:-1, 1:]
    out[:-1, 1:] |= mask[1:, :-1]
    out[:-1, :-1] |= mask[1:, 1:]
    return out


def _gen_patch_from_lines(lines):
    return np.array([[ch == "#" for ch in row] for row in lines], dtype=bool)


def _gen_patch_variants(patch):
    variants = []
    seen = set()
    for k in range(4):
        rotated = np.rot90(patch, k)
        for variant in (rotated, np.fliplr(rotated)):
            key = tuple(map(tuple, variant.astype(int)))
            if key not in seen:
                seen.add(key)
                variants.append(variant.copy())
    return variants


def _gen_reflect_anti_diagonal(patch):
    return np.flipud(np.fliplr(patch.T))


def _gen_is_diagonal_symmetric_patch(patch):
    if patch.shape[0] != patch.shape[1]:
        return False
    main_ok = np.array_equal(patch, patch.T)
    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))


def _gen_patch_direction(patch):
    if patch.shape[0] != patch.shape[1]:
        return None
    n = patch.shape[0]
    main_ok = np.array_equal(patch, patch.T)
    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))
    if main_ok:
        if patch[0, 0] and not patch[n - 1, n - 1]:
            return "TL"
        if patch[n - 1, n - 1] and not patch[0, 0]:
            return "BR"
    if anti_ok:
        if patch[0, n - 1] and not patch[n - 1, 0]:
            return "TR"
        if patch[n - 1, 0] and not patch[0, n - 1]:
            return "BL"
    return None


def _gen_symmetric_motif_patch(max_h, max_w):
    candidates = []
    for lines in _GEN_MOTIF_TEMPLATES:
        patch = _gen_patch_from_lines(lines)
        for variant in _gen_patch_variants(patch):
            h, w = variant.shape
            direction = _gen_patch_direction(variant)
            if (
                h <= max_h
                and w <= max_w
                and _gen_is_diagonal_symmetric_patch(variant)
                and direction is not None
            ):
                candidates.append((variant, direction))
    if not candidates:
        return None
    patch, direction = random.choice(candidates)
    return patch.copy(), direction


def _gen_place_patch(forbidden, patch):
    H, W = forbidden.shape
    m, n = patch.shape
    cells = np.argwhere(patch)
    placements = []
    for r0 in range(H - m + 1):
        for c0 in range(W - n + 1):
            if all(not forbidden[r0 + r, c0 + c] for r, c in cells):
                placements.append((r0, c0))
    if not placements:
        return None
    r0, c0 = random.choice(placements)
    return {(int(r0 + r), int(c0 + c)) for r, c in cells}


def _gen_corner_cells(shape):
    H, W = shape
    return {
        "TL": (0, 0),
        "TR": (0, W - 1),
        "BL": (H - 1, 0),
        "BR": (H - 1, W - 1),
    }


def _gen_control_pool(grid, motif_mask, blocked_mask):
    H, W = grid.shape
    near_motif = _gen_dilate8(motif_mask)
    pool = []
    corners = set(_gen_corner_cells((H, W)).values())
    for r in range(H):
        for c in range(W):
            if (r, c) in corners:
                continue
            if grid[r, c] != 0 or near_motif[r, c] or blocked_mask[r, c]:
                continue
            pool.append((r, c))
    return pool


def _gen_choose_scene():
    H = random.randint(*_GEN_ROW_BOUNDS)
    W = random.randint(*_GEN_COL_BOUNDS)
    side = random.randint(*_GEN_TRIANGLE_SIDE_BOUNDS)
    colors = list(_GEN_COLORS)
    fill_color = random.choice(colors)
    motif_color = random.choice([c for c in colors if c != fill_color])
    return H, W, side, colors, fill_color, motif_color


def _gen_place_motif(H, W, side, fill_color, motif_color, motif_patch, corner):
    triangle_mask = _gen_triangle_mask((H, W), corner, side)
    output = np.zeros((H, W), dtype=int)
    output[triangle_mask] = fill_color

    forbidden = _gen_dilate8(triangle_mask)
    for rc in _gen_corner_cells((H, W)).values():
        forbidden[rc] = True
    motif_coords = _gen_place_patch(forbidden, motif_patch)
    if motif_coords is None:
        return None

    motif_mask = np.zeros((H, W), dtype=bool)
    for r, c in motif_coords:
        motif_mask[r, c] = True
        output[r, c] = motif_color
    return output, triangle_mask, motif_mask


def _gen_marker_choices(colors, motif_color, fill_color):
    marker_choices = [c for c in colors if c != motif_color]
    if random.random() < _GEN_MARKER_AVOID_FILL_PROB and len(marker_choices) > 1:
        marker_choices = [c for c in marker_choices if c != fill_color]
    return marker_choices


def _gen_control_colors(colors, side, fill_color):
    fill_count = random.randint(_GEN_FILL_COUNT_BOUNDS[0], min(_GEN_FILL_COUNT_BOUNDS[1], side))
    distractor_count = side - fill_count
    distractor_choices = [c for c in colors if c != fill_color]
    random.shuffle(distractor_choices)
    control_colors = [fill_color] * fill_count + distractor_choices[:distractor_count]
    random.shuffle(control_colors)
    return control_colors


def _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):
    H, W = inp.shape
    corner_rc = _gen_corner_cells((H, W))[corner]
    inp[corner_rc] = random.choice(_gen_marker_choices(colors, motif_color, fill_color))
    control_colors = _gen_control_colors(colors, side, fill_color)

    occupied_controls = np.zeros((H, W), dtype=bool)
    occupied_controls[corner_rc] = True
    blocked_controls = triangle_mask.copy()
    for color in control_colors:
        blocked = blocked_controls | _gen_dilate8(occupied_controls)
        pool = _gen_control_pool(inp, motif_mask, blocked)
        if not pool:
            return False
        r, c = random.choice(pool)
        inp[r, c] = color
        occupied_controls[r, c] = True
    return True


def _gen_attempt():
    H, W, side, colors, fill_color, motif_color = _gen_choose_scene()
    motif_result = _gen_symmetric_motif_patch(H, W)
    if motif_result is None:
        return None
    motif_patch, corner = motif_result

    placed = _gen_place_motif(H, W, side, fill_color, motif_color, motif_patch, corner)
    if placed is None:
        return None
    output, triangle_mask, motif_mask = placed

    inp = output.copy()
    inp[triangle_mask] = 0

    if not _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):
        return None

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, output):
        return None
    return inp


def generate_input():
    for _ in range(_GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 902510d5 input")

