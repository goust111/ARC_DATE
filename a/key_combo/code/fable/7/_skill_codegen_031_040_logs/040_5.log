from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor the one-pixel-inset interior of every solid foreground rectangle to teal.

    Input structure
    - The grid has one dominant background color.
    - Non-background pixels form separated 4-connected monochrome objects.
    - Each foreground object is a filled axis-aligned rectangle at least 3 cells tall and wide.

    Rule
    - Preserve every original pixel except the strict interior of each rectangle.
    - For every foreground rectangle, replace all cells not on its one-pixel border with teal.

    Key insight
    - The output marks rectangle interiors, not whole objects: the original colors remain only as borders.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert min(g.shape) > 0, "expected a nonempty grid"

    bg = get_bg(g)
    assert bg != Color.TEAL, "expected teal to be the added interior color, not background"
    assert not np.any(g == Color.TEAL), "expected no existing teal pixels"

    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert objects, "expected at least one foreground rectangle"

    out = g.copy()
    for obj in objects:
        box = obj["bbox"]
        height = bbox_h(box)
        width = bbox_w(box)
        assert height >= 3 and width >= 3, "expected each rectangle to have an interior"
        assert int(obj["area"]) == height * width, "expected each object to fill its bbox"

        r0, c0, r1, c1 = map(int, box)
        out[r0 + 1 : r1, c0 + 1 : c1] = Color.TEAL

    return out

# --------------- generator (o5x) ---------------

# Canvas and rectangle bounds use np.random.randint's exclusive upper endpoint.
GRID_H_RANGE, GRID_W_RANGE = (12, 15), (11, 16)
RECT_COUNT_RANGE, RECT_H_RANGE, RECT_W_RANGE = (2, 5), (3, 8), (3, 9)
# Rectangle colors and expected interior recolor.
BACKGROUND_COLOR, INTERIOR_COLOR = 0, int(Color.TEAL)
FOREGROUND_COLORS = np.array([1, 2, 3], dtype=int)
DISTINCT_COLOR_MIN, DISTINCT_COLOR_MAX = 2, 3
COLOR_BIN_COUNT = 10
# Layout spacing and retry controls.
RECT_GAP, RECT_BORDER = 1, 1
GEN_MAX_ATTEMPTS = 300

def _gen_feasible_locations(occupied, height, width):
    rows, cols = occupied.shape
    locations = []
    for r in range(rows - height + 1):
        for c in range(cols - width + 1):
            r0 = max(0, r - RECT_GAP)
            c0 = max(0, c - RECT_GAP)
            r1 = min(rows, r + height + RECT_GAP)
            c1 = min(cols, c + width + RECT_GAP)
            if not occupied[r0:r1, c0:c1].any():
                locations.append((r, c))
    return locations

def _gen_pick_colors(rects):
    palette = np.random.permutation(FOREGROUND_COLORS).tolist()
    distinct = int(np.random.randint(DISTINCT_COLOR_MIN, min(DISTINCT_COLOR_MAX, len(rects)) + 1))
    active = palette[:distinct]
    totals = {color: 0 for color in active}
    colors = [None] * len(rects)

    order = sorted(range(len(rects)), key=lambda i: rects[i][0] * rects[i][1], reverse=True)
    for j, idx in enumerate(order):
        area = rects[idx][0] * rects[idx][1]
        if j < distinct:
            color = active[j]
        else:
            least = min(totals.values())
            choices = [color for color in active if totals[color] == least]
            color = int(np.random.choice(choices))
        colors[idx] = color
        totals[color] += area
    return colors

def _gen_place_rectangles(shape, rects):
    """Return top-left placements in rect order, or None if one cannot fit."""
    occupied = np.zeros(shape, dtype=bool)
    placements = [None] * len(rects)
    order = sorted(range(len(rects)), key=lambda i: rects[i][0] * rects[i][1], reverse=True)
    for idx in order:
        rect_h, rect_w = rects[idx]
        locations = _gen_feasible_locations(occupied, rect_h, rect_w)
        if not locations:
            return None
        loc_i = int(np.random.randint(0, len(locations)))
        r, c = locations[loc_i]
        occupied[r : r + rect_h, c : c + rect_w] = True
        placements[idx] = (r, c)
    return placements

def _gen_render_case(shape, rects, colors, placements):
    """Render the input grid and the oracle output expected from main()."""
    grid = np.full(shape, BACKGROUND_COLOR, dtype=int)
    expected = grid.copy()
    for (rect_h, rect_w), color, (r, c) in zip(rects, colors, placements):
        grid[r : r + rect_h, c : c + rect_w] = color
        expected[r : r + rect_h, c : c + rect_w] = color
        expected[r + RECT_BORDER : r + rect_h - RECT_BORDER, c + RECT_BORDER : c + rect_w - RECT_BORDER] = INTERIOR_COLOR
    return grid, expected

def _gen_attempt():
    height = int(np.random.randint(*GRID_H_RANGE))
    width = int(np.random.randint(*GRID_W_RANGE))
    rect_count = int(np.random.randint(*RECT_COUNT_RANGE))
    rects = [
        (int(np.random.randint(*RECT_H_RANGE)), int(np.random.randint(*RECT_W_RANGE)))
        for _ in range(rect_count)
    ]
    colors = _gen_pick_colors(rects)
    shape = (height, width)
    placements = _gen_place_rectangles(shape, rects)
    if placements is None:
        return None
    grid, expected = _gen_render_case(shape, rects, colors, placements)
    counts = np.bincount(grid.ravel(), minlength=COLOR_BIN_COUNT)
    if counts[BACKGROUND_COLOR] <= max(counts[color] for color in FOREGROUND_COLORS):
        return None
    try:
        actual = main(grid)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid

def generate_input():
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 50cb2852 input")
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import bbox, bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Inflate a frame's hole-layout and fill each hole with its matching piece.

    Input structure:
    - bg = most common color. Largest component is a monochrome frame enclosing bg holes.
    - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.

    Rule:
    - Extract connected hole regions inside the frame as slots.
    - Match each piece to a slot by comparing block-level shapes under rotation/flip.
    - Output the layout scaled by k, with pieces placed in slots; frame color as background.

    Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # --- find the largest connected component of foreground (multicolor) ---
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    assert not (not comps)
    frame_comp = max(comps, key=lambda d: int(d["area"]))
    fr0, fc0, fr1, fc1 = map(int, frame_comp["bbox"])

    # The frame is monochrome; use its dominant color as output background.
    frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp["coords"]]
    bgc = int(Counter(frame_cols).most_common(1)[0][0])

    # --- layout = bg holes inside the frame bbox, tight-cropped ---
    sub = crop_bbox(g, (fr0, fc0, fr1, fc1))
    hole = sub == int(bg)
    hole_box = bbox(hole)
    assert hole_box is not None, "frame must enclose at least one bg hole"
    lr0, lc0, lr1, lc1 = map(int, hole_box)
    layout = hole[lr0 : lr1 + 1, lc0 : lc1 + 1]

    # --- slot components in the layout ---
    slots = []
    for coords in components_mask(layout, connectivity=4):
        rr0, cc0, rr1, cc1 = bbox_coords(coords)
        rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))
        h = int(rr1 - rr0 + 1)
        w = int(cc1 - cc0 + 1)
        sm = np.zeros((h, w), dtype=bool)
        sm[coords[:, 0] - rr0, coords[:, 1] - cc0] = True
        slots.append({"area": int(sm.sum()), "r0": int(rr0), "c0": int(cc0), "mask": sm})
    slots.sort(key=lambda s: (-int(s["area"]), int(s["r0"]), int(s["c0"])))

    assert slots, "frame must contain at least one slot"

    # --- pieces = non-singleton foreground components excluding the frame component ---
    pieces = []
    for comp in comps:
        if comp is frame_comp:
            continue
        coords = comp["coords"]
        if coords.size == 0 or int(coords.shape[0]) <= 1:
            continue
        pr0, pc0, pr1, pc1 = map(int, comp["bbox"])
        patch = crop_bbox(g, (pr0, pc0, pr1, pc1))
        ph, pw = map(int, patch.shape)
        pm = np.zeros((ph, pw), dtype=bool)
        pm[coords[:, 0] - pr0, coords[:, 1] - pc0] = True
        pieces.append({"area": int(pm.sum()), "mask": pm, "patch": patch})

    assert pieces, "at least one non-frame piece must exist"

    # --- infer k from the smallest solid square piece ---
    k = None
    for p in pieces:
        h, w = map(int, p["mask"].shape)
        if h == w and int(p["mask"].sum()) == int(h * w):
            k = int(h) if k is None else min(int(k), int(h))
    k = int(k or 1)

    def downsample_blocks(mask: np.ndarray) -> np.ndarray | None:
        hh, ww = mask.shape
        if hh % k != 0 or ww % k != 0:
            return None
        out_h, out_w = int(hh // k), int(ww // k)
        out = np.zeros((out_h, out_w), dtype=bool)
        for r in range(out_h):
            for c in range(out_w):
                block = mask[int(r * k) : int((r + 1) * k), int(c * k) : int((c + 1) * k)]
                if bool(block.all()):
                    out[r, c] = True
                elif bool(block.any()):
                    return None
        return out

    def dihedral_variants(
        patch: np.ndarray, mask: np.ndarray
    ) -> list[tuple[np.ndarray, np.ndarray]]:
        base = []
        for kk in range(4):
            p = np.rot90(patch, int(kk))
            m = np.rot90(mask, int(kk))
            base.append((p, m))
            base.append((np.fliplr(p), np.fliplr(m)))
        uniq = []
        seen = set()
        for p, m in base:
            key = m.tobytes()
            if key in seen:
                continue
            seen.add(key)
            uniq.append((p, m))
        return uniq

    # Precompute all usable (piece,variant) candidates with their block masks.
    candidates = []
    for pi, p in enumerate(pieces):
        for vp, vm in dihedral_variants(p["patch"], p["mask"]):
            um = downsample_blocks(vm)
            if um is None:
                continue
            candidates.append({"pi": int(pi), "area": int(p["area"]), "um": um, "vp": vp, "vm": vm})

    used_piece: set[int] = set()
    placements: list[tuple[dict, dict]] = []
    for s in slots:
        need_area = int(s["area"]) * int(k) * int(k)
        found = None
        for cand in candidates:
            if int(cand["pi"]) in used_piece:
                continue
            if int(cand["area"]) != int(need_area):
                continue
            if cand["um"].shape != s["mask"].shape:
                continue
            if np.array_equal(cand["um"], s["mask"]):
                found = cand
                break
        assert found is not None, "every slot must match a piece"
        used_piece.add(int(found["pi"]))
        placements.append((s, found))

    outH = (int(layout.shape[0]) + 2) * int(k)
    outW = (int(layout.shape[1]) + 2) * int(k)
    out = np.full((outH, outW), int(bgc), dtype=int)

    for s, cand in placements:
        top = (int(s["r0"]) + 1) * int(k)
        left = (int(s["c0"]) + 1) * int(k)
        paste(out, cand["vp"], int(top), int(left), mask=cand["vm"], overwrite=True)
def generate_input() -> np.ndarray:
    for _ in range(GENERATE_MAX_RETRIES):
        res = _gen_attempt()
        if res is not None:
            return res
    raise RuntimeError("generate_input: failed to generate after %d attempts" % GENERATE_MAX_RETRIES)

