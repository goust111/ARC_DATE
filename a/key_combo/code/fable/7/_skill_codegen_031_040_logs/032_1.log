def _place_markers(sprite_types: list[dict], marker_type_ids: list[int],
                   dst_h: int, dst_w: int, dst_bg: int) -> tuple[np.ndarray, list[tuple[int, int, int]]] | None:
    """Place sprites into the dest interior, returning (stamped_inner, marker_points) or None."""
    inner = np.full((dst_h - 2, dst_w - 2), dst_bg, dtype=int)
    marker_points: list[tuple[int, int, int]] = []
    for type_id in marker_type_ids:
        sprite = sprite_types[type_id]
        patch = _render_sprite(sprite["shape_rows"], sprite["body"], sprite["anchor"], dst_bg)
        placed = False
        for _ in range(MARKER_PLACE_RETRIES):
            try:
                r0, c0 = random_free_location(inner, patch, transparent=dst_bg)
            except ValueError:
                return None
            mr, mc = r0 + sprite["anchor_rc"][0], c0 + sprite["anchor_rc"][1]
            if any(abs(mr - pr) + abs(mc - pc) <= 1 for pr, pc, _ in marker_points):
                continue
            paste(inner, patch, r0, c0, transparent=dst_bg)
            marker_points.append((mr, mc, type_id))
            placed = True
            break
        if not placed:
            return None
    return inner, marker_points


def _place_sources(sprite_types: list[dict], source_type_ids: list[int],
                   src_h: int, src_w: int, src_bg: int) -> np.ndarray | None:
    """Place sprites into the source interior, returning stamped_inner or None."""
    inner = np.full((src_h - 2, src_w - 2), src_bg, dtype=int)
    for type_id in source_type_ids:
        sprite = sprite_types[type_id]
        patch = _render_sprite(sprite["shape_rows"], sprite["body"], sprite["anchor"], src_bg)
        try:
            r0, c0 = random_free_location(inner, patch, transparent=src_bg,
                                           border=SOURCE_SPRITE_PADDING, padding=SOURCE_SPRITE_PADDING)
        except ValueError:
            return None
        paste(inner, patch, r0, c0, transparent=src_bg)
    return inner


