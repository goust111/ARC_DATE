        out[r0, c0 : c1 + 1] = FRAME_COLOR
        out[r1, c0 : c1 + 1] = FRAME_COLOR
        out[r0 : r1 + 1, c0] = FRAME_COLOR
        out[r0 : r1 + 1, c1] = FRAME_COLOR
        out[r0 + 1 : r1, c0 + 1 : c1] = FILL_COLOR
