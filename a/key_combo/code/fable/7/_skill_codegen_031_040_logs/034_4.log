+
+def generate_input() -> np.ndarray:
+    """Generate a varied, non-degenerate instance satisfying all solver assumptions."""
+    rng = random.Random()
+    for _ in range(400):
+        grid = _attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid绕墙年轮 instance")

