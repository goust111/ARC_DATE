+    detoured = (dist >= 0) & (dist > manhattan) & ~frame_mask
+    if int(detoured.sum()) < 3 or int(dist.max()) < 2 * len(palette):
+        return None
+
+    expected = grid.copy()
+    for r in range(h):
+        for c in range(w):
