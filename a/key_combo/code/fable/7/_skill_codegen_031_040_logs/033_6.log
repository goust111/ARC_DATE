+    r0, c0 = max(0, r - padding), max(0, c - padding)
+    r1, c1 = min(occupied.shape[0], r + h + padding), min(occupied.shape[1], c + w + padding)
+    return not bool(np.any(occupied[r0:r1, c0:c1]))
