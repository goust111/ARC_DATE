+        moved = cols + int(shifts[r])
+        assert int(moved.min()) >= 0 and int(moved.max()) < right_width, (
+            "shifted object row must remain entirely inside the right region"
+        )
+        right_out[r, cols] = bg
+        right_out[r, moved] = object_color
+    return out
