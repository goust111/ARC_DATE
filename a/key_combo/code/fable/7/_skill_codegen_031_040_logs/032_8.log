+            if shifts[r] != 0 and np.all(grid[r, :sep] == BACKGROUND)
+        ]
+        if not inherited:
+            return False
+
+        # Every visible bar must directly control an object row.  Thus none is
+        # decorative, and both signed branches necessarily alter the result.
