+            )
+            color = int(row[0])
+            assert color in (POSITIVE, NEGATIVE), "field bars must be teal or red"
+            assert np.all(row[:length] == color), "a field bar must be monochromatic"
+            current = length if color == POSITIVE else -length
+        shifts[r] = current
+    return shifts
