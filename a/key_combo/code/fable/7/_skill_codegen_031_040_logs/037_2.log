from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/7/037/2.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
orientations = set()
counts = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, mod._independent_expected(inp))
    bg, sep, roster = mod._parse(inp)
    assert np.all(out[:sep + 1] == inp[:sep + 1])
    assert len(set(np.unique(out[sep + 1:], axis=0).tolist().__str__())) > 0
    counts.add(len(roster))
    for _, color in roster:
        q = np.argwhere(inp[:sep] == color)
        if np.unique(q[:, 0]).size == 1: orientations.add('H')
        elif np.unique(q[:, 1]).size == 1: orientations.add('V')
        elif np.unique(q[:, 0]-q[:, 1]).size == 1: orientations.add('DR')
        else: orientations.add('DL')
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
