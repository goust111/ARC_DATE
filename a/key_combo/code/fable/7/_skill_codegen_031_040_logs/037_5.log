+    # new, visible red; the exact target must remain yellow.
+    expected = grid.copy()
+    for point in positions[: target_index - 1]:
+        if int(expected[point]) != BACKGROUND:
+            return None
+        expected[point] = RED
+    if int(expected[target]) != YELLOW:
+        return None
+    try:
