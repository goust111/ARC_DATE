import numpy as np

from arc_utils import bbox_coords, colors_present, find_components, get_bg
import random


def _rotated_bar_coords(coords: np.ndarray) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox_coords(coords)
    height = r1 - r0 + 1
    width = c1 - c0 + 1
    area = int(coords.shape[0])

    assert height == 1 or width == 1
    length = max(height, width)
    assert area == length
    assert length % 2 == 1

    cr = (r0 + r1) // 2
    cc = (c0 + c1) // 2
    half = length // 2

    if length == 1:
        return [(cr, cc)]
    if height == 1:
        return [(r, cc) for r in range(cr - half, cr + half + 1)]
    return [(cr, c) for c in range(cc - half, cc + half + 1)]


def main(grid: np.ndarray) -> np.ndarray:
    """Rotate every foreground bar 90 degrees around its own center on the same canvas.

    Input structure
    The background is the dominant color, and all foreground pixels share one color.
    Each 4-connected foreground object is a solid one-cell-thick horizontal or vertical
    bar with odd length, with single-pixel bars allowed.

    Rule
    Clear the canvas to the background, then redraw every bar with its midpoint, length,
    and color preserved while swapping horizontal and vertical orientation.

    Key insight
    The bars are independent objects: their centers and lengths identify the output
    placement, so no matching, ordering, or global symmetry is needed.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1

    out = np.full_like(g, bg)
    h, w = g.shape
    components = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=fg_colors,
    )
    assert components

    for comp in components:
        color = int(comp["color"])
        for r, c in _rotated_bar_coords(comp["coords"]):
            assert 0 <= r < h and 0 <= c < w
            assert out[r, c] == bg
            out[r, c] = color

    return out

# --------------- generator (c) ---------------

# Palette and canvas options.
BG_COLOR = 7
FG_COLORS = tuple(c for c in range(10) if c != BG_COLOR)
GRID_SIDES = (9, 11, 13)

# Bar counts and weighted odd-length sampling.
MIN_BARS, EXTRA_LENGTH_CANDIDATES = 5, 5
MAX_BARS_BY_SIDE = {9: 6, 11: 8, 13: 10}
LENGTH_WEIGHT_BY_SIZE = {1: 8, 3: 56, 5: 26, 7: 6, 9: 3}
DEFAULT_LENGTH_WEIGHT = 1
ORIENTATIONS = ("H", "V")

# Retry and placement search limits.
OUTER_ATTEMPTS, INNER_ATTEMPTS = 10, 50
CENTER_TRIAL_LIMIT = 80

def _sample_lengths(N, K):
    possible_lengths = list(range(1, N + 1, 2))
    weights = [LENGTH_WEIGHT_BY_SIZE.get(l, DEFAULT_LENGTH_WEIGHT) for l in possible_lengths]
    lengths = random.choices(possible_lengths, weights=weights, k=K + EXTRA_LENGTH_CANDIDATES)
    lengths.sort(reverse=True)
    return lengths

def _bar_pixels(cr, cc, length, orient):
    half = length // 2
    if orient == "H":
        return {(cr, cc + d) for d in range(-half, half + 1)}
    return {(cr + d, cc) for d in range(-half, half + 1)}

def _place_one_bar(N, length, occupied):
    """Return input pixels for one placed bar, mutating occupied on success."""
    half = length // 2
    lo, hi = half, N - 1 - half
    if lo > hi:
        return None
    orient = random.choice(ORIENTATIONS)
    out_orient = "V" if orient == "H" else "H"
    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]
    random.shuffle(candidates)

    for cr, cc in candidates[:CENTER_TRIAL_LIMIT]:
        inp_pixels = _bar_pixels(cr, cc, length, orient)
        out_pixels = _bar_pixels(cr, cc, length, out_orient)
        footprint = inp_pixels | out_pixels
        if footprint & occupied:
            continue
        occupied |= footprint
        return inp_pixels
    return None

def _place_bars(N, K):
    occupied = set()
    bars_input = []
    for length in _sample_lengths(N, K):
        if len(bars_input) >= K:
            break
        inp_pixels = _place_one_bar(N, length, occupied)
        if inp_pixels is not None:
            bars_input.append(inp_pixels)
    return bars_input if len(bars_input) >= K else None

def _gen_attempt(N: int, K: int) -> np.ndarray | None:
    fg = random.choice(FG_COLORS)
    bars_input = _place_bars(N, K)
    if bars_input is None:
        return None

    grid = np.full((N, N), BG_COLOR, dtype=int)
    for bar_pixels in bars_input:
        for r, c in bar_pixels:
            grid[r, c] = fg

    try:
        main(grid)
    except Exception:
        return None
    return grid

def generate_input() -> np.ndarray:
    for _outer in range(OUTER_ATTEMPTS):
        N = random.choice(GRID_SIDES)
        K = random.randint(MIN_BARS, MAX_BARS_BY_SIDE[N])
        for _ in range(INNER_ATTEMPTS):
            result = _gen_attempt(N, K)
            if result is not None:
                return result
    raise RuntimeError("Failed to generate valid input after many attempts")
import numpy as np

from arc_utils import bbox, colors_present, get_bg
import itertools
import random


def _area(rect: tuple[int, int, int, int]) -> int:
    r0, c0, r1, c1 = rect
    return (r1 - r0 + 1) * (c1 - c0 + 1)


def _contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
    or0, oc0, or1, oc1 = outer
    ir0, ic0, ir1, ic1 = inner
    return or0 <= ir0 and oc0 <= ic0 and ir1 <= or1 and ic1 <= oc1


def _inset(rect: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
    r0, c0, r1, c1 = rect
    return r0 + 1, c0 + 1, r1 - 1, c1 - 1


def _side_matches(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
    return sum((a[0] == b[0], a[1] == b[1], a[2] == b[2], a[3] == b[3]))


def main(grid: np.ndarray) -> np.ndarray:
    """Complete sparse nested rectangular color layers into solid rectangles.

    Input structure
    The background is the dominant color, and every foreground color marks one
    axis-aligned rectangular layer; the layer bboxes have unique areas and are
    nested from outermost to innermost.
    Rule
    Take each color's bbox as its completed rectangle, except that a child bbox
    which already matches at least three sides of its parent's one-pixel inset
    expands to that full inset; repaint the rectangles largest to smallest.
    Key insight
    The scattered pixels are samples of nested rectangular regions, so the
    output is a clean redraw of those regions with inner colors overwriting
    outer colors.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    layers: list[dict[str, int | tuple[int, int, int, int]]] = []
    for color in colors_present(g, exclude={bg}):
        rect = bbox(g == color)
        assert rect is not None
        layers.append({"color": color, "raw": rect, "rect": rect, "area": _area(rect)})

    assert layers
    areas = [layer["area"] for layer in layers]
    assert len(set(areas)) == len(areas)
    layers.sort(key=lambda layer: int(layer["area"]), reverse=True)

    completed: list[dict[str, int | tuple[int, int, int, int]]] = []
    for layer in layers:
        raw = layer["raw"]
        assert isinstance(raw, tuple)
        if completed:
            parents = [
                parent
                for parent in completed
                if _contains(parent["rect"], raw) and parent["rect"] != raw
            ]
            assert parents
            parent = min(parents, key=lambda item: _area(item["rect"]))
            parent_inset = _inset(parent["rect"])
            assert parent_inset[0] <= parent_inset[2] and parent_inset[1] <= parent_inset[3]
            assert _contains(parent_inset, raw)
            matches = _side_matches(raw, parent_inset)
            assert matches in (0, 3, 4)
            if matches >= 3:
                layer["rect"] = parent_inset
        completed.append(layer)

    out = np.full_like(g, bg)
    for layer in layers:
        rect = layer["rect"]
        assert isinstance(rect, tuple)
        r0, c0, r1, c1 = rect
        out[r0 : r1 + 1, c0 : c1 + 1] = int(layer["color"])

    assert np.all(out[g != bg] == g[g != bg])
    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and layer topology.
GEN_GRID_SIZES = (10, 12)
GEN_LAYER_COUNTS = (2, 3)
GEN_OUTER_INSETS = (0, 1)
GEN_GAP_SIZES = (1, 2)
GEN_MIN_INNER_SIDE = 4

# Sparse sampling bounds and bbox-preservation controls.
GEN_MIN_SAMPLE_COUNT = 4
GEN_MIN_SAMPLE_PERCENT = 28
GEN_MAX_SAMPLE_PERCENT = 71
GEN_PERCENT_DENOMINATOR = 100
GEN_PERCENT_CEIL_OFFSET = GEN_PERCENT_DENOMINATOR - 1
GEN_SIDES = ("top", "bottom", "left", "right")
GEN_OMITTED_SIDE_CHOICES = (None, None, "top", "bottom", "left", "right")

# Color and retry controls.
GEN_COLOR_RANGE = range(1, 10)
GEN_RETRY_LIMIT = 300

GenRect = tuple[int, int, int, int]


def _rect_mask(shape: tuple[int, int], rect: GenRect) -> np.ndarray:
    mask = np.zeros(shape, dtype=bool)
    r0, c0, r1, c1 = rect
    mask[r0 : r1 + 1, c0 : c1 + 1] = True
    return mask


def _gen_inset(rect: GenRect, amount: int) -> GenRect:
    r0, c0, r1, c1 = rect
    return r0 + amount, c0 + amount, r1 - amount, c1 - amount


def _target_rect(rect: GenRect, omitted_side: str | None) -> GenRect:
    r0, c0, r1, c1 = rect
    if omitted_side == "top":
        r0 += 1
    elif omitted_side == "bottom":
        r1 -= 1
    elif omitted_side == "left":
        c0 += 1
    elif omitted_side == "right":
        c1 -= 1
    return r0, c0, r1, c1


def _available_mask(visible: np.ndarray, rect: GenRect, omitted_side: str | None) -> np.ndarray:
    allowed = visible.copy()
    r0, c0, r1, c1 = rect
    if omitted_side == "top":
        allowed[r0, c0 : c1 + 1] = False
    elif omitted_side == "bottom":
        allowed[r1, c0 : c1 + 1] = False
    elif omitted_side == "left":
        allowed[r0 : r1 + 1, c0] = False
    elif omitted_side == "right":
        allowed[r0 : r1 + 1, c1] = False
    return allowed


def _side_candidates(allowed: np.ndarray, target: GenRect, side: str) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = target
    if side == "top":
        return [(r0, int(c)) for c in np.flatnonzero(allowed[r0, :])]
    elif side == "bottom":
        return [(r1, int(c)) for c in np.flatnonzero(allowed[r1, :])]
    elif side == "left":
        return [(int(r), c0) for r in np.flatnonzero(allowed[:, c0])]
    return [(int(r), c1) for r in np.flatnonzero(allowed[:, c1])]


def _sample_visible(visible: np.ndarray, rect: GenRect, omitted_side: str | None, count: int) -> np.ndarray | None:
    """Return an exact-count sample mask with every target bbox side represented."""
    allowed = _available_mask(visible, rect, omitted_side)
    target = _target_rect(rect, omitted_side)

    anchors: set[tuple[int, int]] = set()
    for side in GEN_SIDES:
        choices = _side_candidates(allowed, target, side)
        if not choices:
            return None
        anchors.add(random.choice(choices))

    if len(anchors) > count:
        return None

    pool = [tuple(map(int, p)) for p in np.argwhere(allowed)]
    rest = [p for p in pool if p not in anchors]
    random.shuffle(rest)
    selected = list(anchors) + rest[: count - len(anchors)]

    if len(selected) != count:
        return None

    mask = np.zeros(visible.shape, dtype=bool)
    for r, c in selected:
        mask[r, c] = True
    return mask


def _count_options(area: int, allowed_count: int) -> list[int]:
    min_by_rate = (GEN_MIN_SAMPLE_PERCENT * area + GEN_PERCENT_CEIL_OFFSET) // GEN_PERCENT_DENOMINATOR
    lo = max(GEN_MIN_SAMPLE_COUNT, min_by_rate)
    hi = min(allowed_count, (GEN_MAX_SAMPLE_PERCENT * area) // GEN_PERCENT_DENOMINATOR)
    return list(range(lo, hi + 1))


def _choose_sample_counts(n: int, areas: list[int], allowed_counts: list[int]) -> tuple[int, ...] | None:
    """Pick per-layer sample counts while keeping background the dominant color."""
    options = [_count_options(a, b) for a, b in zip(areas, allowed_counts)]
    if any(not opt for opt in options):
        return None
    valid = [
        counts
        for counts in itertools.product(*options)
        if n * n - sum(counts) > max(counts)
    ]
    if not valid:
        return None
    return random.choice(valid)


def _choose_layout() -> tuple[int, list[GenRect], tuple[int, ...]] | None:
    """Choose the canvas and nested square rects before color or sampling choices."""
    n = random.choice(GEN_GRID_SIZES)
    layer_count = random.choice(GEN_LAYER_COUNTS)
    outer_inset = random.choice(GEN_OUTER_INSETS)
    outer_side = n - 2 * outer_inset

    gap_options = [
        gaps
        for gaps in itertools.product(GEN_GAP_SIZES, repeat=layer_count - 1)
        if outer_side - 2 * sum(gaps) >= GEN_MIN_INNER_SIDE
    ]
    if not gap_options:
        return None
    gaps = random.choice(gap_options)

    rects = [(outer_inset, outer_inset, n - outer_inset - 1, n - outer_inset - 1)]
    for gap in gaps:
        rects.append(_gen_inset(rects[-1], gap))

    return n, rects, gaps


def _render_expected(n: int, colors: list[int], rects: list[GenRect]) -> np.ndarray:
    expected = np.zeros((n, n), dtype=int)
    for color, rect in zip(colors, rects):
        r0, c0, r1, c1 = rect
        expected[r0 : r1 + 1, c0 : c1 + 1] = color
    return expected


def _prepare_sampling_plan(n: int, rects: list[GenRect], gaps: tuple[int, ...]):
    """Build per-layer masks, side omissions, ring areas, and allowed counts."""
    visible_masks: list[np.ndarray] = []
    omitted_sides: list[str | None] = []
    target_areas: list[int] = []
    allowed_counts: list[int] = []
    for i, rect in enumerate(rects):
        visible = _rect_mask((n, n), rect)
        if i + 1 < len(rects):
            visible &= ~_rect_mask((n, n), rects[i + 1])
        omitted: str | None = None
        if i > 0 and gaps[i - 1] == 1:
            omitted = random.choice(GEN_OMITTED_SIDE_CHOICES)
        allowed = _available_mask(visible, rect, omitted)
        target = _target_rect(rect, omitted)
        visible_masks.append(visible)
        omitted_sides.append(omitted)
        target_areas.append(_area(target))
        allowed_counts.append(int(allowed.sum()))

    if len(set(target_areas)) != len(target_areas):
        return None

    ring_areas = [int(mask.sum()) for mask in visible_masks]
    return visible_masks, omitted_sides, ring_areas, allowed_counts


def _draw_sparse_input(n, colors, rects, visible_masks, omitted_sides, counts):
    inp = np.zeros((n, n), dtype=int)
    for color, rect, visible, omitted, count in zip(
        colors, rects, visible_masks, omitted_sides, counts
    ):
        sampled = _sample_visible(visible, rect, omitted, count)
        if sampled is None:
            return None
        inp[sampled] = color
    return inp


def _passes_solver_oracle(inp: np.ndarray, expected: np.ndarray) -> bool:
    try:
        solved = main(inp)
    except Exception:
        return False
    return bool(np.array_equal(solved, expected))


def _gen_attempt() -> np.ndarray | None:
    layout = _choose_layout()
    if layout is None:
        return None
    n, rects, gaps = layout

    colors = random.sample(GEN_COLOR_RANGE, len(rects))
    expected = _render_expected(n, colors, rects)

    sampling_plan = _prepare_sampling_plan(n, rects, gaps)
    if sampling_plan is None:
        return None
    visible_masks, omitted_sides, ring_areas, allowed_counts = sampling_plan

    counts = _choose_sample_counts(n, ring_areas, allowed_counts)
    if counts is None:
        return None

    inp = _draw_sparse_input(n, colors, rects, visible_masks, omitted_sides, counts)
    if inp is None:
        return None

    if not _passes_solver_oracle(inp, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {GEN_RETRY_LIMIT} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, draw_line, get_bg
import random


def _is_consecutive(values: np.ndarray) -> bool:
    ordered = np.sort(values)
    return bool(ordered.size <= 1 or np.all(np.diff(ordered) == 1))


def _is_line_segment(coords: np.ndarray) -> bool:
    rows = coords[:, 0]
    cols = coords[:, 1]
    if np.unique(rows).size == 1:
        return _is_consecutive(cols)
    if np.unique(cols).size == 1:
        return _is_consecutive(rows)
    if np.unique(rows - cols).size == 1:
        return np.unique(rows).size == coords.shape[0] and _is_consecutive(rows)
    if np.unique(rows + cols).size == 1:
        return np.unique(rows).size == coords.shape[0] and _is_consecutive(rows)
    return False


def main(grid: np.ndarray) -> np.ndarray:
    """
    Summarize the foreground line objects as ordered horizontal color stripes.

    Input structure:
    - A dominant background fills a rectangular grid.
    - Each non-background color forms one contiguous one-cell-thick line segment.
    - The line segments have distinct topmost rows, and there are at most five of
      them.

    Rule:
    - Sort the foreground colors by the topmost row occupied by their line
      segment.
    - Create a 5x3 output filled with the background color.
    - Place one solid 1x3 row for each foreground color, preserving that
      top-to-bottom order and padding any unused rows above with background.

    Key insight: The exact line length and slope do not matter; only the
    vertical order of the colored line segments is encoded in the output stack.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    ordered: list[tuple[int, int]] = []
    for color in colors_present(g, exclude=[bg]):
        coords = np.argwhere(g == color)
        assert coords.size > 0, "foreground color must occupy at least one pixel"
        assert _is_line_segment(coords), "each foreground color must be one line segment"
        ordered.append((int(coords[:, 0].min()), int(color)))

    assert 0 < len(ordered) <= 5, "expected one to five foreground line segments"
    top_rows = [top for top, _ in ordered]
    assert len(set(top_rows)) == len(top_rows), "line segments must have distinct top rows"

    ordered.sort()
    out = np.full((5, 3), bg, dtype=int)
    start_row = out.shape[0] - len(ordered)
    for out_r, (_, color) in enumerate(ordered, start=start_row):
        out[out_r, :] = color
    return out

# --------------- generator (att2) ---------------

# Canvas, palette, and output shape.
BG, GRID_SIZE = 7, 16
OUTPUT_SHAPE = (5, 3)
FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]

# Segment counts, lengths, and allowed row extents.
LINE_COUNT_BOUNDS = (3, 5)
LINE_LENGTH_BOUNDS = (3, 15)
TOP_ROW_BOUNDS = (2, 15)
BOTTOM_BAND_MIN, BOTTOM_DIAGONAL_TOP_MAX = 12, 13
BOTTOM_ROW = GRID_SIZE - 1

# Rejection sampling limit.
RETRY_LIMIT = 300


def _coords_for_line(top: int, start_col: int, length: int, dc: int) -> set[tuple[int, int]]:
    if dc == 0:
        return {(top, start_col + i) for i in range(length)}
    return {(top + i, start_col + i * dc) for i in range(length)}


def _valid_starts(top: int, length: int, dc: int, occupied: set[tuple[int, int]]) -> list[int]:
    starts = range(0, GRID_SIZE - length + 1) if dc >= 0 else range(length - 1, GRID_SIZE)
    return [
        start_col
        for start_col in starts
        if not (_coords_for_line(top, start_col, length, dc) & occupied)
    ]


def _line_options_for_top(top: int, must_reach_bottom: bool) -> list[tuple[int, int]]:
    options: list[tuple[int, int]] = []
    if BOTTOM_BAND_MIN <= top <= BOTTOM_ROW and not must_reach_bottom:
        for length in range(LINE_LENGTH_BOUNDS[0], LINE_LENGTH_BOUNDS[1] + 1):
            options.append((0, length))

    if top <= BOTTOM_DIAGONAL_TOP_MAX:
        if must_reach_bottom:
            lengths = [GRID_SIZE - top]
        else:
            lo = max(LINE_LENGTH_BOUNDS[0], BOTTOM_BAND_MIN - top + 1)
            hi = GRID_SIZE - top
            lengths = list(range(lo, hi + 1))
        for length in lengths:
            options.append((1, length))
            options.append((-1, length))

    if top == BOTTOM_ROW and must_reach_bottom:
        for length in range(LINE_LENGTH_BOUNDS[0], LINE_LENGTH_BOUNDS[1] + 1):
            options.append((0, length))
    return options


def _build_expected(colors: list[int]) -> np.ndarray:
    expected = np.full(OUTPUT_SHAPE, BG, dtype=int)
    for i, color in enumerate(colors):
        expected[OUTPUT_SHAPE[0] - len(colors) + i, :] = color
    return expected


def _sample_top_rows_and_bottom(n_lines: int) -> tuple[list[int], int] | None:
    top_rows = sorted(random.sample(range(TOP_ROW_BOUNDS[0], TOP_ROW_BOUNDS[1] + 1), n_lines))
    bottom_capable = [i for i, top in enumerate(top_rows) if top <= BOTTOM_DIAGONAL_TOP_MAX or top == BOTTOM_ROW]
    if not bottom_capable:
        return None
    return top_rows, random.choice(bottom_capable)


def _place_segment(
    grid: np.ndarray,
    color: int,
    top: int,
    must_reach_bottom: bool,
    occupied: set[tuple[int, int]],
) -> bool:
    options = _line_options_for_top(top, must_reach_bottom)
    random.shuffle(options)
    for dc, length in options:
        starts = _valid_starts(top, length, dc, occupied)
        if not starts:
            continue
        start_col = random.choice(starts)
        direction = (0, 1) if dc == 0 else (1, dc)
        draw_line(grid, top, start_col, length=length, direction=direction, color=color)
        occupied.update(_coords_for_line(top, start_col, length, dc))
        return True
    return False


def _gen_attempt() -> np.ndarray | None:
    n_lines = random.randint(*LINE_COUNT_BOUNDS)
    colors = random.sample(FG_COLORS, n_lines)
    expected = _build_expected(colors)

    design = _sample_top_rows_and_bottom(n_lines)
    if design is None:
        return None
    top_rows, bottom_idx = design

    grid = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    occupied: set[tuple[int, int]] = set()

    for i, (color, top) in enumerate(zip(colors, top_rows)):
        if not _place_segment(grid, color, top, i == bottom_idx, occupied):
            return None

    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 668eec9a input")
import numpy as np
import random
from arc_utils import Color, draw_line, paste, random_sprite


# concepts:
# translational symmetry, symmetry detection, reflection

# description:
# In the input, you will see a sprite repeated horizontally, and some of those repetitions might be reflected top/down/right/left.
# To make the output, just extract the repeated sprite.

def main(input_grid):
    """
    Return the leftmost repeated slice that can tile the grid horizontally, allowing reflected copies.

    Input structure:
    - The grid is composed of equal-width column blocks.
    - Each block is expected to match the first block directly, upside down, or left-right flipped.
    - The block width divides the overall grid width.

    Rule:
    - Try candidate periods from smallest to largest.
    - Compare each block to the first block and to its vertical and horizontal reflections.
    - Return the first leftmost block whose variants explain all blocks.

    Key insight:
    - The original sprite is recovered as the smallest horizontal period consistent with all reflected repetitions.
    """
    # Find the period along the horizontal repetition axis (columns),
    # allowing each repetition to be a reflection of the base sprite.
    H, W = input_grid.shape
    for period in range(1, W + 1):
        if W % period != 0:
            continue
        sprite = input_grid[:, :period]
        reps = [input_grid[:, i * period : (i + 1) * period] for i in range(W // period)]

        valid = True
        for rep in reps:
            reflections = [rep, np.flipud(rep), np.fliplr(rep)]
            if not any(np.array_equal(sprite, r) for r in reflections):
                valid = False
                break
        if valid:
            return sprite
        
    assert False, "No valid period found"

def generate_input():
    # Create the sprite to be duplicated; pick a trio of random colors
    n = random.randint(2,7)
    sprite = random_sprite(n, n, color_palette=random.sample(list(Color.NOT_BLACK),3))
    
    # Duplicate the sprite 3 times horizontally
    grid = np.zeros((3*n, n),dtype=int)
    for i in range(3):
        paste(grid, sprite, i*n, 0, transparent=Color.BLACK, clip=True)

    return grid
