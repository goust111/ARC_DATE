+    grid = np.full((height, width), BACKGROUND, dtype=int)
+    for point in segment_decoys + off_path + [target]:
+        grid[point] = YELLOW
+    grid[start] = GREEN
+    grid[first] = BLUE
+    grid[second] = BLUE
