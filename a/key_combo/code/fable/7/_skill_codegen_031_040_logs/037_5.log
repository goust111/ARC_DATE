def step(pos, vel, shape):
    v = list(vel); flags = [False, False]
    for a, lim in enumerate(shape):
        if not 0 <= pos[a] + v[a] < lim:
            v[a] *= -1; flags[a] = True
        assert 0 <= pos[a] + v[a] < lim
    return (pos[0] + v[0], pos[1] + v[1]), tuple(v), tuple(flags)

def infer(g):
    s = tuple(np.argwhere(g == 3)[0])
    bs = [tuple(x) for x in np.argwhere(g == 1)]
    ans = []
    for a, b in ((bs[0], bs[1]), (bs[1], bs[0])):
        v = (a[0]-s[0], a[1]-s[1])
        q, w, flags = step(a, v, g.shape)
        if q == b: ans.append((s, a, b, v, w, flags))
    assert len(ans) == 1
    return ans[0]

stats = {'straight': 0, 'bend_row': 0, 'bend_col': 0, 'future_row': 0, 'future_col': 0}
in_sigs, out_sigs = set(), set()
first_branches = []
for i in range(200):
    g = m.generate_input(); out = m.main(g)
    s, b1, b2, initial, vel, hist_flags = infer(g)
    branch = 'straight' if not any(hist_flags) else ('bend_row' if hist_flags[0] else 'bend_col')
    stats[branch] += 1
    if i < 3: first_branches.append(branch)

    pos = b2; seen = {(pos, vel)}; landings = []; bounce_flags = []
    yellow_hits = []
    while True:
        pos, vel, flags = step(pos, vel, g.shape)
        bounce_flags.append(flags); landings.append(pos)
        if g[pos] == 4:
            yellow_hits.append(pos)
            break
        state = (pos, vel)
        assert state not in seen
        seen.add(state)
    assert len(landings) >= 5 and any(any(x) for x in bounce_flags[:-1])
    assert sum(out[x] == 2 for x in landings[:-1]) == len(landings)-1
    assert out[landings[-1]] == 4 and len(yellow_hits) == 1
    assert np.array_equal(out[g == 4], g[g == 4])
    assert np.count_nonzero(out == 2) >= 4
    for flags in bounce_flags:
        stats['future_row'] += int(flags[0])
        stats['future_col'] += int(flags[1])

    # Every sample contains a yellow integer pixel strictly between two
    # consecutive pre-target landings, disproving continuous-line stopping.
    seq = [b2] + landings
    between_yellow = 0
    for a, b in zip(seq[:-1], seq[1:]):
        dr, dc = b[0]-a[0], b[1]-a[1]
        n = max(abs(dr), abs(dc))
        for k in range(1, n):
            if dr*k % n == 0 and dc*k % n == 0:
                q = (a[0]+dr*k//n, a[1]+dc*k//n)
                between_yellow += int(g[q] == 4)
    assert between_yellow >= 2

    # On bend examples, wrongly retaining the green-to-blue velocity must
    # disagree immediately with the inferred post-bounce continuation.
    if any(hist_flags):
        wrong_next, _, _ = step(b2, initial, g.shape)
