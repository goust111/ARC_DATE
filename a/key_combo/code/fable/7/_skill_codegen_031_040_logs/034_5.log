+        if min(mask.sum(axis=0)) == 0 or min(mask.sum(axis=1)) == 0:
+            continue
+        if max(mask.sum(axis=0)) == n or max(mask.sum(axis=1)) == n:
+            continue
+        if not _is_asymmetric(mask):
+            continue
+        return mask
+    raise RuntimeError("failed to sample a non-degenerate seed mask")
+
