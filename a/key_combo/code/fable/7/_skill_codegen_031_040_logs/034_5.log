+
+def _block_view(grid: np.ndarray, n: int, br: int, bc: int) -> np.ndarray:
+    """Return block (br, bc), using the puzzle's block-coordinate frame."""
+    return grid[br * n : (br + 1) * n, bc * n : (bc + 1) * n]
+
