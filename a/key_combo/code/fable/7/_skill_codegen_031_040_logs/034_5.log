+    """Reject masks whose orientation can be mistaken after a dihedral transform."""
+    variants = []
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        variants.extend((rot, np.fliplr(rot)))
+    return all(not np.array_equal(mask, v) for v in variants[1:])
+
