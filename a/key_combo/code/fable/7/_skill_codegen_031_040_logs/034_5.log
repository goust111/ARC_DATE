+        target_cells[br * n : (br + 1) * n, bc * n : (bc + 1) * n] = True
+        if not np.array_equal(out, expected):
+            continue
+        if not np.array_equal(out[~target_cells], inp[~target_cells]):
+            continue
+        if np.unique(out[target_cells]).size != 2:
