GRID_SIZE_RANGE = (15, 30)               # canvas side length S bounds
COLOR_POOL = [0, 1, 2, 4, 6, 7, 8, 9]   # eligible colors (excludes green=3, grey=5)
CELL_PICK_RETRIES = 50                   # retries for _pick_cells connectivity check
