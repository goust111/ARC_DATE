+    touches = (nr0 == 0, nr1 == sub.shape[0] - 1, nc0 == 0, nc1 == sub.shape[1] - 1)
+    assert sum(touches) == 1, "notch must open through exactly one base edge"
+    assert not bool(notch.all()), "notch must be non-rectangular"
