+                continue
+            key = _shape_key(mask)
+            if key not in seen:
+                seen.add(key)
+                candidates.append(mask)
+    return candidates
+
+
+def _place_rect(blocked: np.ndarray, height: int, width: int, gap: int = 1) -> Coord | None:
+    choices: list[Coord] = []
