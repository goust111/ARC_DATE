from __future__ import annotations
import random
import numpy as np
from arc_utils import bbox_coords, is_contiguous, label_mask, paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Connect two sprites using matching connector pixels, then tight-crop.

    Input structure:
    - Background color `bg`, sprite color `obj`, connector color `ctrl` (small, 2 components).
    - Two main foreground sprites, plus possibly tiny detached pixels belonging to one sprite.

    Rule:
    - Identify the **base** sprite (closest to grid top-left).
    - Translate the other sprite so its connector sits one cell above the base's connector.
    - Stamp the plug onto the base; remove connectors (recolor `ctrl` to `obj`).
    - Output is the tight crop around all non-background pixels.

    Key insight: The connector pixels define the unique docking point and direction.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    # Fixed colors (consistent across all eval examples)
    bg, obj, ctrl = 1, 4, 7

    # Build foreground components (8-connected: sprites may touch diagonally)
    lab, n = label_mask(g != bg, connectivity=8)
    best_comps = []
    for k in range(1, int(n) + 1):
        pts = {(int(r), int(c)) for r, c in np.argwhere(lab == int(k))}
        best_comps.append(pts)
    best_comps.sort(key=len, reverse=True)
    assert len(best_comps) == 2  # exactly 2 sprites, no fragments
    A = set(best_comps[0])
    B = set(best_comps[1])

    def bbox_of_pts(pts: set[tuple[int, int]]) -> tuple[int, int, int, int]:
        coords = np.array(list(pts), dtype=int)
        r0, c0, r1, c1 = bbox_coords(coords)
        return int(r0), int(c0), int(r1), int(c1)

    def conn(sprite: set[tuple[int, int]]):
        return {(r, c) for (r, c) in sprite if int(g[int(r), int(c)]) == int(ctrl)}

    connA = conn(A)
    connB = conn(B)
    assert not (not connA or not connB)

    def norm(conn_pts: set[tuple[int, int]]):
        rs = [r for r, _c in conn_pts]
        cs = [c for _r, c in conn_pts]
        r0, c0 = int(min(rs)), int(min(cs))
        shape = {(int(r - r0), int(c - c0)) for r, c in conn_pts}
        return shape, (int(r0), int(c0))

    shpA, (ar0, ac0) = norm(connA)
    shpB, (br0, bc0) = norm(connB)
    assert not (shpA != shpB)

    # base = sprite whose bbox top-left is closest to (0,0)
    r0a, c0a, _r1a, _c1a = bbox_of_pts(A)
    r0b, c0b, _r1b, _c1b = bbox_of_pts(B)
    # Base must be anchored at grid top-left corner
    assert int(r0a + c0a) == 0 or int(r0b + c0b) == 0
    if int(r0a + c0a) <= int(r0b + c0b):
        base, connD = A, connA
        plug, connP = B, connB
    else:
        base, connD = B, connB
        plug, connP = A, connA

    # Connectors dock vertically: base connector's free side faces down,
    # plug connector's free side faces up.
    base_body = base - connD
    plug_body = plug - connP
    for r, c in connD:
        assert (int(r + 1), int(c)) not in base_body  # base: free side down
    for r, c in connP:
        assert (int(r - 1), int(c)) not in plug_body  # plug: free side up

    _sp, (pr0, pc0) = norm(connP)
    _sd, (dr0, dc0) = norm(connD)

    # place plug connector directly above base connector
    tr = int((dr0 - 1) - pr0)
    tc = int(dc0 - pc0)
    plug_shift = {(int(r + tr), int(c + tc)) for r, c in plug}

    # render on minimal bbox
    pts_all = base | plug_shift
    coords_all = np.array(list(pts_all), dtype=int)
    rr0, cc0, rr1, cc1 = bbox_coords(coords_all)
    rr0, cc0, rr1, cc1 = map(int, (rr0, cc0, rr1, cc1))
    # Base must remain at output top-left after tight crop
    base_coords = np.array(list(base), dtype=int)
    br0, bc0 = int(base_coords[:, 0].min()), int(base_coords[:, 1].min())
    assert rr0 == br0 and cc0 == bc0  # plug must not extend above/left of base
    out = np.full((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), int(bg), dtype=int)

    # stamp base first
    for r, c in base:
        out[int(r - rr0), int(c - cc0)] = int(g[int(r), int(c)])

    # stamp plug on top; overlap only allowed at connector docking zone (ctrl meets obj)
    for r, c in plug_shift:
        val = int(g[int(r - tr), int(c - tc)])
        cur = int(out[int(r - rr0), int(c - cc0)])
        if cur != int(bg) and val != int(bg):
            assert cur == int(ctrl) or val == int(ctrl)  # overlap only at connector
        out[int(r - rr0), int(c - cc0)] = int(val)

    # connector disappears -> becomes obj
    out[out == int(ctrl)] = int(obj)

    # tight crop around non-bg
    nz = np.argwhere(out != int(bg))
    if nz.size == 0:
        return np.full((0, 0), int(bg), dtype=int)
    r0, c0, r1, c1 = bbox_coords(nz)
    return out[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]


# ---------------------------------------------------------------------------
# Generator (anchor-first: build base, grow plug on it, then separate)
# ---------------------------------------------------------------------------
import random as _rng


def _grow_shape(mask, target, frontier):
    """Grow a connected shape on mask from frontier up to target pixels."""
    count = int(mask.sum())
    while count < target and frontier:
        idx = _rng.randint(0, len(frontier) - 1)
        r, c = frontier[idx]
        h, w = mask.shape
        nbrs = [(r+dr, c+dc) for dr, dc in ((-1,0),(1,0),(0,-1),(0,1))
                if 0 <= r+dr < h and 0 <= c+dc < w and not mask[r+dr, c+dc]]
        if not nbrs:
            frontier[idx] = frontier[-1]; frontier.pop()
            continue
        nr, nc = _rng.choice(nbrs)
        mask[nr, nc] = True
        count += 1
        frontier.append((nr, nc))


def _thin(mask, keep=None):
    """Remove interior pixels to make a thin-walled shape. keep = set of (r,c) to never remove."""
    h, w = mask.shape
    keep = keep or set()
    pixels = list(zip(*np.where(mask)))
    _rng.shuffle(pixels)
    for r, c in pixels:
        if (r, c) in keep:
            continue
        # Skip if already on boundary (adjacent to False)
        adj_bg = any(not (0 <= r+dr < h and 0 <= c+dc < w) or not mask[r+dr, c+dc]
                     for dr, dc in ((-1,0),(1,0),(0,-1),(0,1)))
        if adj_bg:
            continue  # already thin here
        # Try removing
        mask[r, c] = False
        if is_contiguous(mask, background=0, connectivity=8):
            pass  # keep removed
        else:
            mask[r, c] = True  # restore


def _gen_attempt():
    bg, obj, ctrl = 1, 4, 7

    # Step 1: build base sprite body
    base_h = _rng.randint(2, 7)
    base_w = _rng.randint(3, 10)
    base_target = _rng.randint(5, min(29, base_h * base_w))
    base = np.zeros((base_h, base_w), dtype=bool)
    base[0, 0] = True
    _grow_shape(base, base_target, [(0, 0)])
    if not is_contiguous(base, background=0, connectivity=8):
        return None
    _thin(base)

    # Step 2: place connector on base (can be edge or interior row)
    conn_len = _rng.randint(1, min(3, base_w))
    # Find valid connector positions: row where base has obj, with obj above it
    # (connector free side faces down, body side faces up)
    candidates = []
    for r in range(base_h):
        for c0 in range(base_w - conn_len + 1):
            cols = list(range(c0, c0 + conn_len))
            # All connector cols must have base pixels
            if not all(base[r, c] for c in cols):
                continue
            # Body side (above): all connector cols must have obj above
            if r == 0:
                continue  # need body above
            if not all(base[r - 1, c] for c in cols):
                continue
            candidates.append((r, cols))
    if not candidates:
        return None
    conn_row, conn_cols = _rng.choice(candidates)

    # Build base sprite grid with connector
    base_grid = np.full((base_h, base_w), bg, dtype=int)
    base_grid[base] = obj
    for c in conn_cols:
        base_grid[conn_row, c] = ctrl

    # Verify base still 8-connected with ctrl
    if not is_contiguous(base_grid != bg, background=0, connectivity=8):
        return None

    # Step 3: grow plug from connector downward
    # Plug connector sits 1 row above base connector in docked state.
    # Plug body grows below its connector.
    # In docked coords: plug connector at row conn_row, plug body at conn_row+1..
    # But plug is ON TOP of base, so plug pixels must not overlap base body (except at connector zone)
    max_plug_h = _rng.randint(2, 7)
    plug_h = max_plug_h
    plug_w = _rng.randint(max(conn_len, 2), min(10, base_w + 4))

    # Plug connector col offset so it aligns with base connector
    # plug_conn_c0 in plug-local coords, must map to base conn_cols in docked coords
    # docked: plug placed at (conn_row, dc_offset) where dc_offset aligns connectors
    plug_conn_c0 = _rng.randint(0, plug_w - conn_len)
    dc_offset = conn_cols[0] - plug_conn_c0  # plug col 0 maps to base col dc_offset

    # Plug occupies docked rows conn_row..conn_row+plug_h-1, cols dc_offset..dc_offset+plug_w-1
    # Row conn_row = plug connector row (shared with base connector)
    # Check plug fits in reasonable bounds
    if dc_offset < 0 or conn_row + plug_h > base_h + plug_h:
        pass  # plug can extend beyond base bbox, that's OK

    # Build plug mask in plug-local coords
    plug = np.zeros((plug_h, plug_w), dtype=bool)
    # Seed: connector cols + first body row
    for c in range(plug_conn_c0, plug_conn_c0 + conn_len):
        plug[0, c] = True  # connector row
        if plug_h > 1:
            plug[1, c] = True  # first body row

    plug_max = min(29, plug_h * plug_w)
    if plug_max < 5:
        return None
    plug_target = _rng.randint(5, plug_max)
    _grow_shape(plug, plug_target, list(zip(*np.where(plug))))
    if not is_contiguous(plug, background=0, connectivity=8):
        return None
    # Thin plug but keep connector row pixels
    keep_plug = {(0, c) for c in range(plug_conn_c0, plug_conn_c0 + conn_len)}
    _thin(plug, keep=keep_plug)

    # Verify plug doesn't overlap base body at non-connector positions in docked state
    for r in range(plug_h):
        for c in range(plug_w):
            if not plug[r, c]:
                continue
            dr = conn_row + r  # docked row
            dc = dc_offset + c  # docked col
            if 0 <= dr < base_h and 0 <= dc < base_w:
                if base_grid[dr, dc] == obj:
                    # Overlap with base obj — only OK at connector zone (row 0, connector cols)
                    if r == 0 and c in range(plug_conn_c0, plug_conn_c0 + conn_len):
                        continue  # connector zone, allowed (ctrl meets obj)
                    return None  # non-connector overlap

    # Plug must not extend above or left of base
    plug_min_col = dc_offset
    if plug_min_col < 0:
        return None

    # Build plug sprite grid
    plug_grid = np.full((plug_h, plug_w), bg, dtype=int)
    plug_grid[plug] = obj
    for c in range(plug_conn_c0, plug_conn_c0 + conn_len):
        plug_grid[0, c] = ctrl

    # Verify plug connector adjacency (body below connector)
    for c in range(plug_conn_c0, plug_conn_c0 + conn_len):
        if plug_h < 2 or plug_grid[1, c] != obj:
            return None

    if not is_contiguous(plug_grid != bg, background=0, connectivity=8):
        return None

    # Pixel count checks
    if int(np.sum(base_grid != bg)) < 5 or int(np.sum(plug_grid != bg)) < 5:
        return None

    # Crop both sprites
    def crop(g):
        nz = np.argwhere(g != bg)
        if nz.size == 0:
            return None
        r0, c0, r1, c1 = bbox_coords(nz)
        return g[r0:r1+1, c0:c1+1]

    base_sprite = crop(base_grid)
    plug_sprite = crop(plug_grid)
    if base_sprite is None or plug_sprite is None:
        return None
    bh, bw = base_sprite.shape
    ph, pw = plug_sprite.shape

    # Step 4: place on canvas — base at (0,0), plug elsewhere
    canvas_h = _rng.randint(max(7, max(bh, ph) + 2), 11)
    canvas_w = _rng.randint(max(3, max(bw, pw)), 13)
    if bh > canvas_h or bw > canvas_w or ph > canvas_h or pw > canvas_w:
        return None

    canvas = np.full((canvas_h, canvas_w), bg, dtype=int)
    paste(canvas, base_sprite, 0, 0, transparent=bg)
    try:
        pr, pc = random_free_location(canvas, plug_sprite, transparent=bg, padding=0)
    except ValueError:
        return None
    if pr + pc == 0:
        return None
    paste(canvas, plug_sprite, pr, pc, transparent=bg)

    if np.sum(canvas == bg) <= canvas.size // 2:
        return None

    # Step 5: oracle verify
    try:
        result = main(canvas)
    except Exception:
        return None
    # result should be non-trivial
    if result.size == 0 or not np.any(result != bg):
        return None
    return canvas


def generate_input():
    for _ in range(300):
        g = _gen_attempt()
        if g is not None:
            return g
    raise RuntimeError("generate_input: failed after 300 attempts")
import numpy as np

from arc_utils import colors_present, components_mask, components_mask as _gen_components_mask, get_bg, get_bg as _gen_get_bg, paste as _gen_paste, random_free_location as _gen_random_free_location
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Select the color of the largest contiguous non-background object and return it as a solid 3x3 block.

    Input structure:
    - The background is the dominant color.
    - Some foreground colors are scattered clutter split into many 4-connected components.
    - The meaningful foreground objects are colors whose pixels form exactly one 4-connected object.

    Rule:
    - For each non-background color, count its 4-connected monochrome components.
    - Among the colors with exactly one such object, choose the unique largest by pixel area.
    - Fill the fixed 3x3 output grid with that object's color.

    Key insight:
    - Clutter colors may have high total frequency, but they are fragmented; the answer is the biggest whole object color.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    candidates: list[tuple[int, int]] = []
    for color in colors_present(g, exclude={bg}):
        comps = components_mask(g == color, connectivity=4)
        if len(comps) == 1:
            candidates.append((int(comps[0].shape[0]), int(color)))

    assert candidates, "expected at least one single-component foreground color"
    max_area = max(area for area, _ in candidates)
    winners = [color for area, color in candidates if area == max_area]
    assert len(winners) == 1, "expected a unique largest single-component object color"

    return np.full((3, 3), winners[0], dtype=int)

# --------------- generator (o5x) ---------------

# Canvas, palette, and validation shape.
GEN_GRID_SHAPE, GEN_OUTPUT_SHAPE = (20, 20), (3, 3)
GEN_GRID_CELLS, GEN_BACKGROUND, GEN_CONNECTIVITY = GEN_GRID_SHAPE[0] * GEN_GRID_SHAPE[1], 0, 4
GEN_PALETTE = tuple(range(1, 10))

# Object counts, areas, density, and rectangle rates.
GEN_OBJECT_COUNT_CHOICES = (3, 4)
GEN_ANSWER_AREA_MIN, GEN_ANSWER_AREA_MAX_EXCLUSIVE = 25, 40
GEN_ANSWER_TO_SECOND_MIN_RATIO, GEN_RECT_PATCH_PROB = 1.18, 0.35
GEN_FOREGROUND_TOTAL_MIN, GEN_FOREGROUND_TOTAL_MAX = 220, 256
GEN_RECT_MAX_SIDE, GEN_TINY_AREA_MAX, GEN_RECT_MIN_SIDE = 20, 4, 2
GEN_OBJECT_BOX_SIDE_MIN, GEN_OBJECT_BOX_SIDE_MAX_EXCLUSIVE, GEN_OBJECT_DENSITY_PERCENT_MIN = 2, 13, 54

# Clutter totals, fragmentation, and fragment shape bounds.
GEN_CLUTTER_COLOR_COUNT, GEN_CLUTTER_EXTRA_ROOM_MIN = 2, 9
GEN_CLUTTER_TOTAL_MIN, GEN_CLUTTER_TOTAL_MAX = 65, 95
GEN_CLUTTER_COMPONENT_MIN, GEN_CLUTTER_COMPONENT_MAX_EXCLUSIVE = 38, 55
GEN_CLUTTER_AVG_FRAGMENT_MIN, GEN_CLUTTER_AVG_FRAGMENT_MAX = 1.5, 2.1
GEN_FRAGMENT_MAX_SIZE_MIN, GEN_FRAGMENT_MAX_SIZE_MAX = 4, 10
GEN_FRAGMENT_SOFT_SIZE_MAX, GEN_FRAGMENT_SMALL_SIZE_LIMIT = 3, 8
GEN_FRAGMENT_SMALL_MAX_SIDE, GEN_FRAGMENT_LARGE_MAX_SIDE = 4, 5
GEN_FRAGMENT_BOX_AREA_SLACK = 6

# Retry and neighborhood policy.
GEN_FRAGMENT_PLACEMENT_RETRIES, GEN_ATTEMPTS = 8, 300
GEN_NEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_pick_clutter_profile() -> tuple[int, int]:
    total = random.randint(GEN_CLUTTER_TOTAL_MIN, GEN_CLUTTER_TOTAL_MAX)
    valid_counts = [
        k for k in range(GEN_CLUTTER_COMPONENT_MIN, GEN_CLUTTER_COMPONENT_MAX_EXCLUSIVE)
        if GEN_CLUTTER_AVG_FRAGMENT_MIN <= total / k <= GEN_CLUTTER_AVG_FRAGMENT_MAX
        and total - k >= GEN_CLUTTER_EXTRA_ROOM_MIN
    ]
    return total, random.choice(valid_counts)


def _gen_fragment_sizes(total: int, count: int) -> list[int]:
    sizes = [1] * count
    max_size = random.randint(GEN_FRAGMENT_MAX_SIZE_MIN, GEN_FRAGMENT_MAX_SIZE_MAX)
    big_idx = random.randrange(count)
    sizes[big_idx] = max_size
    extra = total - count - (max_size - 1)

    while extra > 0:
        choices = [i for i in range(count) if i != big_idx and sizes[i] < GEN_FRAGMENT_SOFT_SIZE_MAX]
        if not choices:
            choices = [i for i in range(count) if sizes[i] < max_size]
        i = random.choice(choices)
        sizes[i] += 1
        extra -= 1

    random.shuffle(sizes)
    return sorted(sizes, reverse=True)


def _gen_area_tuple(n: int, total: int, hi: int) -> list[int]:
    if n == 2:
        choices = [(a, total - a) for a in range(1, hi + 1) if 1 <= total - a <= hi]
    else:
        choices = [
            (a, b, total - a - b)
            for a in range(1, hi + 1)
            for b in range(1, hi + 1)
            if 1 <= total - a - b <= hi
        ]
    return list(random.choice(choices))


def _gen_pick_object_areas(clutter_totals: list[int]) -> tuple[int, list[int]]:
    clutter_sum = sum(clutter_totals)
    profiles = []
    for object_count in GEN_OBJECT_COUNT_CHOICES:
        for answer_area in range(GEN_ANSWER_AREA_MIN, GEN_ANSWER_AREA_MAX_EXCLUSIVE):
            max_other = int(answer_area / GEN_ANSWER_TO_SECOND_MIN_RATIO)
            min_total = answer_area + object_count - 1
            max_total = answer_area + (object_count - 1) * max_other
            bg_limited_total = GEN_GRID_CELLS - 1 - clutter_sum - max(clutter_totals)
            lo = max(min_total, GEN_FOREGROUND_TOTAL_MIN - clutter_sum)
            hi = min(max_total, GEN_FOREGROUND_TOTAL_MAX - clutter_sum, bg_limited_total)
            if lo <= hi:
                profiles.append((object_count, answer_area, max_other, lo, hi))

    if not profiles:
        return 0, []

    object_count, answer_area, max_other, lo, hi = random.choice(profiles)
    object_total = random.randint(lo, hi)
    other_areas = _gen_area_tuple(object_count - 1, object_total - answer_area, max_other)
    return answer_area, other_areas


def _gen_rect_patch(area: int, color: int) -> np.ndarray | None:
    pairs = []
    for h in range(1, min(GEN_RECT_MAX_SIDE, area) + 1):
        if area % h == 0:
            w = area // h
            if w <= GEN_RECT_MAX_SIDE and (area <= GEN_TINY_AREA_MAX or min(h, w) >= GEN_RECT_MIN_SIDE):
                pairs.append((h, w))
                if h != w:
                    pairs.append((w, h))
    if not pairs:
        return None
    h, w = random.choice(pairs)
    return np.full((h, w), color, dtype=int)


def _gen_grow_connected_coords(
    h: int,
    w: int,
    area: int,
    coords: set[tuple[int, int]],
) -> set[tuple[int, int]]:
    while len(coords) < area:
        frontier = {
            (r + dr, c + dc)
            for r, c in coords
            for dr, dc in GEN_NEIGHBOR_OFFSETS
            if 0 <= r + dr < h and 0 <= c + dc < w and (r + dr, c + dc) not in coords
        }
        coords.add(random.choice(tuple(frontier)))
    return coords


def _gen_object_patch(area: int, color: int) -> np.ndarray:
    if area <= GEN_TINY_AREA_MAX or random.random() < GEN_RECT_PATCH_PROB:
        rect = _gen_rect_patch(area, color)
        if rect is not None:
            return rect

    dims = []
    for h in range(GEN_OBJECT_BOX_SIDE_MIN, GEN_OBJECT_BOX_SIDE_MAX_EXCLUSIVE):
        for w in range(GEN_OBJECT_BOX_SIDE_MIN, GEN_OBJECT_BOX_SIDE_MAX_EXCLUSIVE):
            box_area = h * w
            if (
                box_area >= area
                and area * 100 >= GEN_OBJECT_DENSITY_PERCENT_MIN * box_area
                and h + w - 1 <= area
            ):
                dims.append((h, w))
    if not dims:
        rect = _gen_rect_patch(area, color)
        if rect is not None:
            return rect
        raise ValueError("no object patch dimensions")

    h, w = random.choice(dims)
    cr = random.randrange(h)
    cc = random.randrange(w)
    coords = {(r, cc) for r in range(h)}
    coords.update((cr, c) for c in range(w))
    coords = _gen_grow_connected_coords(h, w, area, coords)
    patch = np.zeros((h, w), dtype=int)
    arr = np.array(tuple(coords), dtype=int)
    patch[arr[:, 0], arr[:, 1]] = color
    return patch


def _gen_trim_patch(mask: np.ndarray, color: int) -> np.ndarray:
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    patch[coords[:, 0] - r0, coords[:, 1] - c0] = color
    return patch


def _gen_fragment_patch(size: int, color: int) -> np.ndarray:
    if size == 1:
        return np.array([[color]], dtype=int)

    max_side = GEN_FRAGMENT_SMALL_MAX_SIDE if size <= GEN_FRAGMENT_SMALL_SIZE_LIMIT else GEN_FRAGMENT_LARGE_MAX_SIDE
    dims = [
        (h, w)
        for h in range(1, max_side + 1)
        for w in range(1, max_side + 1)
        if h * w >= size and h * w <= size + GEN_FRAGMENT_BOX_AREA_SLACK and h + w > 2
    ]
    h, w = random.choice(dims)
    coords = {(random.randrange(h), random.randrange(w))}
    coords = _gen_grow_connected_coords(h, w, size, coords)

    mask = np.zeros((h, w), dtype=bool)
    arr = np.array(tuple(coords), dtype=int)
    mask[arr[:, 0], arr[:, 1]] = True
    return _gen_trim_patch(mask, color)


def _gen_valid_fragment_locations(canvas: np.ndarray, patch: np.ndarray, color: int) -> list[tuple[int, int]]:
    """Return placements where this fragment neither overlaps nor 4-touches same-color clutter."""
    coords = [tuple(map(int, rc)) for rc in np.argwhere(patch == color)]
    coord_set = set(coords)
    h, w = patch.shape
    rows, cols = canvas.shape
    locations = []

    for r0 in range(rows - h + 1):
        for c0 in range(cols - w + 1):
            ok = True
            for dr, dc in coords:
                r = r0 + dr
                c = c0 + dc
                if canvas[r, c] != GEN_BACKGROUND:
                    ok = False
                    break
                for dr, dc in GEN_NEIGHBOR_OFFSETS:
                    nr, nc = r + dr, c + dc
                    if (nr - r0, nc - c0) in coord_set:
                        continue
                    if 0 <= nr < rows and 0 <= nc < cols and canvas[nr, nc] == color:
                        ok = False
                        break
                if not ok:
                    break
            if ok:
                locations.append((r0, c0))
    return locations


def _gen_place_clutter(canvas: np.ndarray, color: int, total: int, count: int) -> bool:
    for size in _gen_fragment_sizes(total, count):
        placed = False
        for _ in range(GEN_FRAGMENT_PLACEMENT_RETRIES):
            patch = _gen_fragment_patch(size, color)
            locations = _gen_valid_fragment_locations(canvas, patch, color)
            if locations:
                r, c = random.choice(locations)
                _gen_paste(canvas, patch, r, c, transparent=0)
                placed = True
                break
        if not placed:
            return False
    return True


def _gen_validate(
    grid: np.ndarray,
    answer_color: int,
    object_specs: list[tuple[int, int]],
    clutter_specs: list[tuple[int, int, int]],
) -> bool:
    counts = {int(c): int((grid == c).sum()) for c in np.unique(grid)}
    if _gen_get_bg(grid) != 0 or counts[0] <= max(v for k, v in counts.items() if k != 0):
        return False

    for color, area in object_specs:
        comps = _gen_components_mask(grid == color, connectivity=GEN_CONNECTIVITY)
        if len(comps) != 1 or int(comps[0].shape[0]) != area:
            return False

    for color, total, count in clutter_specs:
        comps = _gen_components_mask(grid == color, connectivity=GEN_CONNECTIVITY)
        sizes = [int(comp.shape[0]) for comp in comps]
        if len(comps) != count or sum(sizes) != total:
            return False
        if not (
            GEN_CLUTTER_AVG_FRAGMENT_MIN <= total / count <= GEN_CLUTTER_AVG_FRAGMENT_MAX
            and GEN_FRAGMENT_MAX_SIZE_MIN <= max(sizes) <= GEN_FRAGMENT_MAX_SIZE_MAX
        ):
            return False

    expected = np.full(GEN_OUTPUT_SHAPE, answer_color, dtype=int)
    return bool(np.array_equal(main(grid), expected))


def _gen_sample_scene_plan() -> tuple[list[tuple[int, int]], list[tuple[int, int, int]], int] | None:
    clutter_profiles = [_gen_pick_clutter_profile(), _gen_pick_clutter_profile()]
    clutter_totals = [total for total, _ in clutter_profiles]
    answer_area, other_areas = _gen_pick_object_areas(clutter_totals)
    if answer_area == 0:
        return None

    object_count = len(other_areas) + 1
    colors = random.sample(GEN_PALETTE, object_count + GEN_CLUTTER_COLOR_COUNT)
    object_colors = colors[:object_count]
    clutter_colors = colors[object_count:]
    answer_color = object_colors[0]
    object_specs = [(answer_color, answer_area)]
    object_specs.extend(zip(object_colors[1:], other_areas))
    clutter_specs = [
        (color, total, count)
        for color, (total, count) in zip(clutter_colors, clutter_profiles)
    ]
    return object_specs, clutter_specs, answer_color


def _gen_place_objects(grid: np.ndarray, object_specs: list[tuple[int, int]]) -> bool:
    for color, area in sorted(object_specs, key=lambda item: item[1], reverse=True):
        patch = _gen_object_patch(area, color)
        try:
            r, c = _gen_random_free_location(grid, patch, transparent=GEN_BACKGROUND)
        except ValueError:
            return False
        _gen_paste(grid, patch, r, c, transparent=GEN_BACKGROUND)
    return True


def _gen_attempt() -> np.ndarray | None:
    plan = _gen_sample_scene_plan()
    if plan is None:
        return None

    object_specs, clutter_specs, answer_color = plan
    grid = np.zeros(GEN_GRID_SHAPE, dtype=int)
    if not _gen_place_objects(grid, object_specs):
        return None
    for color, total, count in clutter_specs:
        if not _gen_place_clutter(grid, color, total, count):
            return None

    if not _gen_validate(grid, answer_color, object_specs, clutter_specs):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise AssertionError("failed to generate valid 3194b014 input")
import numpy as np

from arc_utils import crop_bbox, find_components, get_bg, paste
import itertools


def _nearest_unique(candidates, distance):
    assert candidates
    distances = [distance(candidate) for candidate in candidates]
    best = min(distances)
    assert distances.count(best) == 1
    return candidates[distances.index(best)]


def main(grid: np.ndarray) -> np.ndarray:
    """Erase the control bars and tile each matched sprite toward its bar.

    Input structure
    - The background contains colored non-line sprites plus one-cell-thick control
      bars.
    - A horizontal bar has the same column span as a sprite; a vertical bar has
      the same row span as a sprite.

    Rule
    - Remove every control bar.
    - For each bar, find the nearest sprite aligned with the bar's span on the
      perpendicular axis.
    - Repeat that sprite periodically from its original position toward the bar,
      clipping at the grid boundary and leaving sprite-background cells empty.

    Key insight
    - The bar is not copied itself; it gives the direction and terminal line for
      repeating the aligned sprite motif.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)

    sprites = []
    bars = []
    for component in components:
        r0, c0, r1, c1 = component["bbox"]
        height = r1 - r0 + 1
        width = c1 - c0 + 1
        if (height == 1) ^ (width == 1):
            assert component["area"] == height * width
            bars.append(component)
        else:
            assert height > 1 and width > 1
            sprites.append(component)

    assert sprites
    assert bars

    out = g.copy()
    for bar in bars:
        coords = bar["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

    for bar in bars:
        br0, bc0, br1, bc1 = bar["bbox"]
        bar_h = br1 - br0 + 1
        bar_w = bc1 - bc0 + 1

        if bar_h == 1:
            aligned = [
                sprite
                for sprite in sprites
                if sprite["bbox"][1] == bc0 and sprite["bbox"][3] == bc1
            ]
            above = [sprite for sprite in aligned if br0 < sprite["bbox"][0]]
            below = [sprite for sprite in aligned if br0 > sprite["bbox"][2]]
            assert bool(above) ^ bool(below)
            if above:
                sprite = _nearest_unique(above, lambda s: s["bbox"][0] - br0)
            else:
                sprite = _nearest_unique(below, lambda s: br0 - s["bbox"][2])

            sr0, sc0, _sr1, _sc1 = sprite["bbox"]
            motif = crop_bbox(g, sprite["bbox"])
            motif_h, motif_w = motif.shape
            assert motif_w == bar_w

            if br0 < sr0:
                r = sr0
                while r + motif_h - 1 >= br0:
                    paste(out, motif, r, sc0, transparent=bg, clip=True)
                    r -= motif_h
            else:
                r = sr0
                while r <= br0:
                    paste(out, motif, r, sc0, transparent=bg, clip=True)
                    r += motif_h
        else:
            aligned = [
                sprite
                for sprite in sprites
                if sprite["bbox"][0] == br0 and sprite["bbox"][2] == br1
            ]
            left = [sprite for sprite in aligned if bc0 < sprite["bbox"][1]]
            right = [sprite for sprite in aligned if bc0 > sprite["bbox"][3]]
            assert bool(left) ^ bool(right)
            if left:
                sprite = _nearest_unique(left, lambda s: s["bbox"][1] - bc0)
            else:
                sprite = _nearest_unique(right, lambda s: bc0 - s["bbox"][3])

            sr0, sc0, _sr1, _sc1 = sprite["bbox"]
            motif = crop_bbox(g, sprite["bbox"])
            motif_h, motif_w = motif.shape
            assert motif_h == bar_h

            if bc0 < sc0:
                c = sc0
                while c + motif_w - 1 >= bc0:
                    paste(out, motif, sr0, c, transparent=bg, clip=True)
                    c -= motif_w
            else:
                c = sc0
                while c <= bc0:
                    paste(out, motif, sr0, c, transparent=bg, clip=True)
                    c += motif_w

    return out

# --------------- generator (o5x) ---------------

# Canvas and motif geometry.
_GEN_BACKGROUND, _GEN_BAR_COLOR = 0, 1
_GEN_GRID_SIZE_MIN, _GEN_GRID_SIZE_MAX = 17, 24
_GEN_MOTIF_SIZE, _GEN_EDGE_MARGIN = 4, 1

# Palette and direction primitives.
_GEN_COLORS = (2, 3, 4, 5, 6, 7, 8, 9)
_GEN_DIRECTIONS = ("up", "down", "left", "right")

# Structural counts and tiling bounds.
_GEN_DIRECTION_COUNT_MIN, _GEN_DIRECTION_COUNT_MAX = 1, 3
_GEN_SINGLE_SPRITE_DIRECTION_COUNTS = (2, 3)
_GEN_PAIR_DIRECTION_COUNTS = (
    (1, 1), (1, 2), (2, 1), (1, 3),
    (3, 1), (2, 2), (2, 3), (3, 2),
)
_GEN_TILE_COUNT_MIN, _GEN_TILE_COUNT_MAX = 2, 5

# Sampling branch and retry limits.
_GEN_SINGLE_SPRITE_ROLL_VALUES, _GEN_SINGLE_SPRITE_ROLL_PICK = 2, 0
_GEN_RETRY_LIMIT = 300
_GEN_RNG = np.random.default_rng()


def _gen_choice(items):
    return items[int(_GEN_RNG.integers(len(items)))]


def _gen_hollow_motif(color):
    motif = np.zeros((_GEN_MOTIF_SIZE, _GEN_MOTIF_SIZE), dtype=int)
    motif[0, :] = color
    motif[-1, :] = color
    motif[:, 0] = color
    motif[:, -1] = color
    return motif


def _gen_axis_starts(axis_size, motif_size, low_tiles, high_tiles):
    """Return sprite starts that realize the requested edge tile counts."""
    lo = _GEN_EDGE_MARGIN
    hi = axis_size - motif_size - _GEN_EDGE_MARGIN
    if low_tiles is not None:
        lo = max(lo, (low_tiles - 2) * motif_size + _GEN_EDGE_MARGIN, motif_size)
        hi = min(hi, (low_tiles - 1) * motif_size)
    if high_tiles is not None:
        lo = max(lo, axis_size - high_tiles * motif_size)
        hi = min(
            hi,
            axis_size - _GEN_EDGE_MARGIN - (high_tiles - 1) * motif_size,
            axis_size - 2 * motif_size,
        )
    if lo > hi:
        return ()
    return tuple(range(lo, hi + 1))


def _gen_direction_origins(plan, direction, height, width):
    r0, c0 = plan["r0"], plan["c0"]
    origins = []
    if direction == "up":
        r = r0
        while r + _GEN_MOTIF_SIZE - 1 >= 0:
            origins.append((r, c0))
            r -= _GEN_MOTIF_SIZE
    elif direction == "down":
        r = r0
        while r <= height - 1:
            origins.append((r, c0))
            r += _GEN_MOTIF_SIZE
    elif direction == "left":
        c = c0
        while c + _GEN_MOTIF_SIZE - 1 >= 0:
            origins.append((r0, c))
            c -= _GEN_MOTIF_SIZE
    else:
        c = c0
        while c <= width - 1:
            origins.append((r0, c))
            c += _GEN_MOTIF_SIZE
    return origins


def _gen_plan_mask(plan, height, width):
    mask = np.zeros((height, width), dtype=bool)
    for direction in plan["dirs"]:
        for r, c in _gen_direction_origins(plan, direction, height, width):
            r0, c0 = max(0, r), max(0, c)
            r1 = min(height, r + _GEN_MOTIF_SIZE)
            c1 = min(width, c + _GEN_MOTIF_SIZE)
            mask[r0:r1, c0:c1] = True
    return mask


def _gen_plan_has_requested_tiles(plan, height, width):
    return all(
        len(_gen_direction_origins(plan, direction, height, width))
        == plan["tiles"][direction]
        for direction in plan["dirs"]
    )


def _gen_all_plans(height, width):
    """Enumerate all valid sprite layouts for one grid size."""
    plans = []
    tile_range = range(_GEN_TILE_COUNT_MIN, _GEN_TILE_COUNT_MAX + 1)
    for count in range(_GEN_DIRECTION_COUNT_MIN, _GEN_DIRECTION_COUNT_MAX + 1):
        for dirs in itertools.combinations(_GEN_DIRECTIONS, count):
            for tile_values in itertools.product(tile_range, repeat=count):
                tiles = dict(zip(dirs, tile_values))
                rows = _gen_axis_starts(
                    height, _GEN_MOTIF_SIZE, tiles.get("up"), tiles.get("down")
                )
                cols = _gen_axis_starts(
                    width, _GEN_MOTIF_SIZE, tiles.get("left"), tiles.get("right")
                )
                for r0 in rows:
                    for c0 in cols:
                        plan = {
                            "r0": r0,
                            "c0": c0,
                            "dirs": dirs,
                            "tiles": tiles,
                        }
                        if not _gen_plan_has_requested_tiles(plan, height, width):
                            continue
                        plan["mask"] = _gen_plan_mask(plan, height, width)
                        plans.append(plan)
    return plans


def _gen_compatible(first, second):
    if abs(first["r0"] - second["r0"]) < _GEN_MOTIF_SIZE + _GEN_EDGE_MARGIN:
        return False
    if abs(first["c0"] - second["c0"]) < _GEN_MOTIF_SIZE + _GEN_EDGE_MARGIN:
        return False
    return not np.any(first["mask"] & second["mask"])


def _gen_pick_pair(plans_by_count, counts):
    firsts = plans_by_count[counts[0]]
    seconds = plans_by_count[counts[1]]
    if not firsts or not seconds:
        return None

    for i in _GEN_RNG.permutation(len(firsts)):
        first = firsts[int(i)]
        compatible = [
            second
            for second in seconds
            if second is not first and _gen_compatible(first, second)
        ]
        if compatible:
            return [first, _gen_choice(compatible)]
    return None


def _gen_plans_by_direction_count(plans):
    return {
        count: [plan for plan in plans if len(plan["dirs"]) == count]
        for count in range(_GEN_DIRECTION_COUNT_MIN, _GEN_DIRECTION_COUNT_MAX + 1)
    }


def _gen_pick_single(plans_by_count):
    possible = [
        count for count in _GEN_SINGLE_SPRITE_DIRECTION_COUNTS if plans_by_count[count]
    ]
    if not possible:
        return None
    return [_gen_choice(plans_by_count[_gen_choice(possible)])]


def _gen_select_plans(plans):
    plans_by_count = _gen_plans_by_direction_count(plans)

    if (
        int(_GEN_RNG.integers(_GEN_SINGLE_SPRITE_ROLL_VALUES))
        == _GEN_SINGLE_SPRITE_ROLL_PICK
    ):
        return _gen_pick_single(plans_by_count)

    for i in _GEN_RNG.permutation(len(_GEN_PAIR_DIRECTION_COUNTS)):
        picked = _gen_pick_pair(plans_by_count, _GEN_PAIR_DIRECTION_COUNTS[int(i)])
        if picked is not None:
            return picked
    return None


def _gen_edge_bar_index(plan, direction, height, width):
    r0, c0 = plan["r0"], plan["c0"]
    if direction == "up":
        return 0, slice(c0, c0 + _GEN_MOTIF_SIZE)
    if direction == "down":
        return height - 1, slice(c0, c0 + _GEN_MOTIF_SIZE)
    if direction == "left":
        return slice(r0, r0 + _GEN_MOTIF_SIZE), 0
    return slice(r0, r0 + _GEN_MOTIF_SIZE), width - 1


def _gen_build_grids(height, width, motif, plans):
    """Return the generated input grid plus its expected tiled output."""
    out = np.zeros((height, width), dtype=int)
    for plan in plans:
        for direction in plan["dirs"]:
            for r, c in _gen_direction_origins(plan, direction, height, width):
                paste(out, motif, r, c, transparent=_GEN_BACKGROUND, clip=True)

    keep = np.zeros((height, width), dtype=bool)
    for plan in plans:
        r0, c0 = plan["r0"], plan["c0"]
        keep[r0 : r0 + _GEN_MOTIF_SIZE, c0 : c0 + _GEN_MOTIF_SIZE] = True

    inp = out.copy()
    inp[~keep] = _GEN_BACKGROUND
    for plan in plans:
        for direction in plan["dirs"]:
            inp[_gen_edge_bar_index(plan, direction, height, width)] = _GEN_BAR_COLOR
    return inp, out


def _gen_attempt():
    height = int(_GEN_RNG.integers(_GEN_GRID_SIZE_MIN, _GEN_GRID_SIZE_MAX + 1))
    width = int(_GEN_RNG.integers(_GEN_GRID_SIZE_MIN, _GEN_GRID_SIZE_MAX + 1))
    plans = _gen_select_plans(_gen_all_plans(height, width))
    if plans is None:
        return None

    motif = _gen_hollow_motif(_gen_choice(_GEN_COLORS))
    inp, expected = _gen_build_grids(height, width, motif, plans)
    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input():
    for _ in range(_GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid c62e2108 input")
from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor the one-pixel-inset interior of every solid foreground rectangle to teal.

    Input structure
    - The grid has one dominant background color.
    - Non-background pixels form separated 4-connected monochrome objects.
    - Each foreground object is a filled axis-aligned rectangle at least 3 cells tall and wide.

    Rule
    - Preserve every original pixel except the strict interior of each rectangle.
    - For every foreground rectangle, replace all cells not on its one-pixel border with teal.

    Key insight
    - The output marks rectangle interiors, not whole objects: the original colors remain only as borders.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert min(g.shape) > 0, "expected a nonempty grid"

    bg = get_bg(g)
    assert bg != Color.TEAL, "expected teal to be the added interior color, not background"
    assert not np.any(g == Color.TEAL), "expected no existing teal pixels"

    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert objects, "expected at least one foreground rectangle"

    out = g.copy()
    for obj in objects:
        box = obj["bbox"]
        height = bbox_h(box)
        width = bbox_w(box)
        assert height >= 3 and width >= 3, "expected each rectangle to have an interior"
        assert int(obj["area"]) == height * width, "expected each object to fill its bbox"

        r0, c0, r1, c1 = map(int, box)
        out[r0 + 1 : r1, c0 + 1 : c1] = Color.TEAL

    return out

# --------------- generator (o5x) ---------------

# Canvas and rectangle bounds use np.random.randint's exclusive upper endpoint.
GRID_H_RANGE, GRID_W_RANGE = (12, 15), (11, 16)
RECT_COUNT_RANGE, RECT_H_RANGE, RECT_W_RANGE = (2, 5), (3, 8), (3, 9)
# Rectangle colors and expected interior recolor.
BACKGROUND_COLOR, INTERIOR_COLOR = 0, int(Color.TEAL)
FOREGROUND_COLORS = np.array([1, 2, 3], dtype=int)
DISTINCT_COLOR_MIN, DISTINCT_COLOR_MAX = 2, 3
COLOR_BIN_COUNT = 10
# Layout spacing and retry controls.
RECT_GAP, RECT_BORDER = 1, 1
GEN_MAX_ATTEMPTS = 300

def _gen_feasible_locations(occupied, height, width):
    rows, cols = occupied.shape
    locations = []
    for r in range(rows - height + 1):
        for c in range(cols - width + 1):
            r0 = max(0, r - RECT_GAP)
            c0 = max(0, c - RECT_GAP)
            r1 = min(rows, r + height + RECT_GAP)
            c1 = min(cols, c + width + RECT_GAP)
            if not occupied[r0:r1, c0:c1].any():
                locations.append((r, c))
    return locations

def _gen_pick_colors(rects):
    palette = np.random.permutation(FOREGROUND_COLORS).tolist()
    distinct = int(np.random.randint(DISTINCT_COLOR_MIN, min(DISTINCT_COLOR_MAX, len(rects)) + 1))
    active = palette[:distinct]
    totals = {color: 0 for color in active}
    colors = [None] * len(rects)

    order = sorted(range(len(rects)), key=lambda i: rects[i][0] * rects[i][1], reverse=True)
    for j, idx in enumerate(order):
        area = rects[idx][0] * rects[idx][1]
        if j < distinct:
            color = active[j]
        else:
            least = min(totals.values())
            choices = [color for color in active if totals[color] == least]
            color = int(np.random.choice(choices))
        colors[idx] = color
        totals[color] += area
    return colors

def _gen_place_rectangles(shape, rects):
    """Return top-left placements in rect order, or None if one cannot fit."""
    occupied = np.zeros(shape, dtype=bool)
    placements = [None] * len(rects)
    order = sorted(range(len(rects)), key=lambda i: rects[i][0] * rects[i][1], reverse=True)
    for idx in order:
        rect_h, rect_w = rects[idx]
        locations = _gen_feasible_locations(occupied, rect_h, rect_w)
        if not locations:
            return None
        loc_i = int(np.random.randint(0, len(locations)))
        r, c = locations[loc_i]
        occupied[r : r + rect_h, c : c + rect_w] = True
        placements[idx] = (r, c)
    return placements

def _gen_render_case(shape, rects, colors, placements):
    """Render the input grid and the oracle output expected from main()."""
    grid = np.full(shape, BACKGROUND_COLOR, dtype=int)
    expected = grid.copy()
    for (rect_h, rect_w), color, (r, c) in zip(rects, colors, placements):
        grid[r : r + rect_h, c : c + rect_w] = color
        expected[r : r + rect_h, c : c + rect_w] = color
        expected[r + RECT_BORDER : r + rect_h - RECT_BORDER, c + RECT_BORDER : c + rect_w - RECT_BORDER] = INTERIOR_COLOR
    return grid, expected

def _gen_attempt():
    height = int(np.random.randint(*GRID_H_RANGE))
    width = int(np.random.randint(*GRID_W_RANGE))
    rect_count = int(np.random.randint(*RECT_COUNT_RANGE))
    rects = [
        (int(np.random.randint(*RECT_H_RANGE)), int(np.random.randint(*RECT_W_RANGE)))
        for _ in range(rect_count)
    ]
    colors = _gen_pick_colors(rects)
    shape = (height, width)
    placements = _gen_place_rectangles(shape, rects)
    if placements is None:
        return None
    grid, expected = _gen_render_case(shape, rects, colors, placements)
    counts = np.bincount(grid.ravel(), minlength=COLOR_BIN_COUNT)
    if counts[BACKGROUND_COLOR] <= max(counts[color] for color in FOREGROUND_COLORS):
        return None
    try:
        actual = main(grid)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid

def generate_input():
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 50cb2852 input")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg


_BACK_TO_FRONT_QUADRANTS = ((0, 0), (1, 1), (1, 0), (0, 1))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Overlay the four monochrome quadrant masks onto their common half-size canvas.

    Input structure
    The input is a 2x2 arrangement of equal-size regions on a uniform background.
    Each region contains foreground pixels of exactly one color, forming one mask
    at the output scale.

    Rule
    Start with a background output the size of one region. Stamp the masks from
    back to front by quadrant position: top-left, bottom-right, bottom-left,
    then top-right. Later masks overwrite earlier masks where they overlap.

    Key insight
    Folding all four quadrants onto the same coordinates gives the output
    canvas; the quadrant positions encode the visible layer stack.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)
    assert height % 2 == 0 and width % 2 == 0, "input must split into four equal regions"

    region_h, region_w = height // 2, width // 2
    assert region_h > 0 and region_w > 0, "quadrant regions must be nonempty"

    bg = get_bg(g)
    out = np.full((region_h, region_w), bg, dtype=int)

    seen_colors: set[int] = set()
    for qr, qc in _BACK_TO_FRONT_QUADRANTS:
        region = g[qr * region_h : (qr + 1) * region_h, qc * region_w : (qc + 1) * region_w]
        foreground_colors = colors_present(region, exclude=[bg])
        assert len(foreground_colors) == 1, "each quadrant must have exactly one foreground color"

        color = foreground_colors[0]
        assert color not in seen_colors, "quadrant foreground colors must be distinct"
        seen_colors.add(color)

        out[region != bg] = color

    assert len(seen_colors) == 4, "expected four colored masks"
    return out

# --------------- generator (o5x) ---------------

# Canvas geometry and background.
_GEN_REGION_H, _GEN_REGION_W = 4, 4
_GEN_BG = 0

# Mask density, connectivity, and union-coverage constraints.
_GEN_MIN_MASK_AREA, _GEN_MAX_MASK_AREA = 4, 12
_GEN_MIN_COMPONENTS, _GEN_MAX_COMPONENTS = 1, 4
_GEN_CONNECTIVITY = 4
_GEN_MIN_UNION_COVERAGE = 13
_GEN_COMPONENT_VALUES = tuple(range(_GEN_MIN_COMPONENTS, _GEN_MAX_COMPONENTS + 1))

# Quadrant layout, layer order, fixed observed colors, and retry limit.
_GEN_QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
_GEN_BACK_TO_FRONT = ((0, 0), (1, 1), (1, 0), (0, 1))
_GEN_COLORS = {(0, 0): 4, (0, 1): 5, (1, 0): 6, (1, 1): 9}
_GEN_RETRY_LIMIT = 300

_GEN_RNG = np.random.default_rng()


def _gen_build_mask_options() -> dict[tuple[int, int], list[np.ndarray]]:
    """Group every feasible 4x4 mask by (area, component_count)."""
    options: dict[tuple[int, int], list[np.ndarray]] = {
        (area, comp_count): []
        for area in range(_GEN_MIN_MASK_AREA, _GEN_MAX_MASK_AREA + 1)
        for comp_count in _GEN_COMPONENT_VALUES
    }

    for bits in range(1 << (_GEN_REGION_H * _GEN_REGION_W)):
        area = bits.bit_count()
        if not _GEN_MIN_MASK_AREA <= area <= _GEN_MAX_MASK_AREA:
            continue

        vals = np.array(
            [(bits >> i) & 1 for i in range(_GEN_REGION_H * _GEN_REGION_W)],
            dtype=np.uint8,
        ).reshape(_GEN_REGION_H, _GEN_REGION_W)
        comp_count = len(
            find_components(
                vals,
                bg=_GEN_BG,
                connectivity=_GEN_CONNECTIVITY,
                monochromatic=True,
                return_format="dict",
            )
        )
        if _GEN_MIN_COMPONENTS <= comp_count <= _GEN_MAX_COMPONENTS:
            options[(area, comp_count)].append(vals.astype(bool))

    return options


_GEN_MASK_OPTIONS = _gen_build_mask_options()


def _gen_sample_mask() -> np.ndarray:
    area = int(_GEN_RNG.integers(_GEN_MIN_MASK_AREA, _GEN_MAX_MASK_AREA + 1))
    feasible_comp_counts = [
        comp_count
        for comp_count in _GEN_COMPONENT_VALUES
        if _GEN_MASK_OPTIONS[(area, comp_count)]
    ]
    comp_count = int(_GEN_RNG.choice(feasible_comp_counts))
    bucket = _GEN_MASK_OPTIONS[(area, comp_count)]
    return bucket[int(_GEN_RNG.integers(len(bucket)))].copy()


def _gen_render_output(masks: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    out = np.zeros((_GEN_REGION_H, _GEN_REGION_W), dtype=int)
    for quadrant in _GEN_BACK_TO_FRONT:
        out[masks[quadrant]] = _GEN_COLORS[quadrant]
    return out


def _gen_render_input(masks: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    inp = np.zeros((_GEN_REGION_H * 2, _GEN_REGION_W * 2), dtype=int)
    for (qr, qc), mask in masks.items():
        region = inp[
            qr * _GEN_REGION_H : (qr + 1) * _GEN_REGION_H,
            qc * _GEN_REGION_W : (qc + 1) * _GEN_REGION_W,
        ]
        region[mask] = _GEN_COLORS[(qr, qc)]
    return inp


def _gen_matches_main(inp: np.ndarray, out: np.ndarray) -> bool:
    try:
        solved = main(inp)
    except AssertionError:
        return False
    return bool(np.array_equal(solved, out))


def _gen_attempt() -> np.ndarray | None:
    masks = {quadrant: _gen_sample_mask() for quadrant in _GEN_QUADRANTS}
    union = np.logical_or.reduce(list(masks.values()))
    if int(union.sum()) < _GEN_MIN_UNION_COVERAGE:
        return None

    out = _gen_render_output(masks)
    inp = _gen_render_input(masks)
    if not _gen_matches_main(inp, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRY_LIMIT):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate a valid 75b8110e input")

