+    anchors: list[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+    color: int,
+    require_off_forbidden: bool = False,
+):
+    choices = anchors.copy()
+    random.shuffle(choices)
+    for anchor in choices:
+        for cells in _anchored_shapes(anchor):
+            if cells & forbidden:
+                continue
