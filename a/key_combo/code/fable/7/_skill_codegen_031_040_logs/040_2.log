+        {(r, c), (r, c - 1)},
+        {(r, c), (r + 1, c), (r + 1, c + 1)},
+        {(r, c), (r, c + 1), (r - 1, c + 1)},
+    ]
+    random.shuffle(shapes)
+    return shapes
+
+
