+    components = _sprite_components(g, bg, {start, end})
+    assert components, "expected at least one sprite"
+    out = g.copy()
+    for component in components:
+        if component & path:
+            for r, c in component:
+                out[r, c] = bg
+    return out
+
+
+def _expanded(cells: set[tuple[int, int]], shape: tuple[int, int], radius: int = 1):
+    expanded = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < shape[0] and 0 <= nc < shape[1]:
+                    expanded.add((nr, nc))
+    return expanded
+
+
+def _place_shape(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    cells: set[tuple[int, int]],
+    color: int,
+) -> bool:
+    if not cells or any(not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]) for r, c in cells):
+        return False
+    if _expanded(cells, grid.shape) & occupied:
+        return False
+    for r, c in cells:
+        grid[r, c] = color
+    occupied.update(cells)
+    return True
+
+
+def _anchored_shapes(anchor: tuple[int, int]):
+    r, c = anchor
+    shapes = [
+        {(r, c), (r + 1, c)},
+        {(r, c), (r, c + 1)},
+        {(r, c), (r - 1, c)},
+        {(r, c), (r, c - 1)},
+        {(r, c), (r + 1, c), (r + 1, c + 1)},
+        {(r, c), (r, c + 1), (r - 1, c + 1)},
+    ]
+    random.shuffle(shapes)
+    return shapes
+
+
+def _try_anchored(
