+"""ARC task: cast diagonal rays, then settle rigid sprites under gravity."""
+
+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+YELLOW = 4
+CYAN = 8
+SPRITE_COLORS = (1, 2, 3, 5, 6, 7, 9)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
