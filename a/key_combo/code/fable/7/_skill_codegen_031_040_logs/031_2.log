    max_h, max_w = min(int(grid_h) - 1, int(size_cap)), min(int(grid_w) - 1, int(size_cap))
    fill_min, fill_max = GEN_NONRECT_FILL_RANGE
    candidates: list[tuple[int, int, str, int, int, int]] = []
