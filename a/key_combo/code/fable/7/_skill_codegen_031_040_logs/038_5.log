+    # make per-cell recoloring necessary.
+    return bool(np.any(template == 0) and len(set(map(int, template[template != 0]))) >= 2)
+
+
+def generate_input() -> np.ndarray:
+    """Generate varied, non-degenerate instances satisfying all solver assumptions."""
+    for _ in range(1000):
