+        np.s_[:template.shape[0] // 2, :template.shape[1] // 2],
+        np.s_[:template.shape[0] // 2, template.shape[1] // 2:],
+        np.s_[template.shape[0] // 2:, template.shape[1] // 2:],
+        np.s_[template.shape[0] // 2:, :template.shape[1] // 2],
