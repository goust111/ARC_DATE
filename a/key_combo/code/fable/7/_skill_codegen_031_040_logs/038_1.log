+def _reflect(coords: set[Coord], orientation: str, axis2: int) -> set[Coord]:
+    """Reflect across 2*c=axis2 or 2*r=axis2, allowing half-cell axes."""
+    if orientation == "v":
+        return {(r, axis2 - c) for r, c in coords}
+    return {(axis2 - r, c) for r, c in coords}
+
