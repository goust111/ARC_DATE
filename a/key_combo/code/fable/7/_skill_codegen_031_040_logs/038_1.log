+                "target": target,
+                "axis2": axis2,
+                "orientation": orientation,
+                "sprite_color": sprite_colors[index],
+                "fragment_color": fragment_colors[index],
+            }
+        )
+
+    visible: set[Coord] = set().union(*(record["source"] for record in records))
+    for index, record in enumerate(records):
