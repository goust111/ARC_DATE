+            return None
+        source, target, axis2 = placed
+        for r, c in source:
+            grid[r, c] = sprite_colors[index]
+        reserved |= source | target
+        records.append(
+            {
+                "source": source,
+                "target": target,
+                "axis2": axis2,
+                "orientation": orientation,
+                "sprite_color": sprite_colors[index],
+                "fragment_color": fragment_colors[index],
+            }
+        )
