+def _components(mask: np.ndarray) -> list[set[Coord]]:
+    """Return 4-connected components using the common ARC (row, column) convention."""
+    h, w = mask.shape
+    unseen = {tuple(map(int, p)) for p in np.argwhere(mask)}
+    result: list[set[Coord]] = []
+    while unseen:
+        start = unseen.pop()
+        comp = {start}
+        queue = deque([start])
+        while queue:
+            r, c = queue.popleft()
