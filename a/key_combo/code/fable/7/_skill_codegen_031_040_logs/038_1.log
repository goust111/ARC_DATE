+    candidates: dict[tuple, dict] = {}
+    for sprite_index, sprite in enumerate(sprites):
+        source = sprite["coords"]
+        for mr, mc in marks:
+            for sr, sc in source:
+                proposals: list[tuple[str, int]] = []
+                if mr == sr:
+                    proposals.append(("v", mc + sc))
+                if mc == sc:
+                    proposals.append(("h", mr + sr))
