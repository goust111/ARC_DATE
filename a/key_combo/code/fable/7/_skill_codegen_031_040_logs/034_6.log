+    r0, c0, r1, c1 = legend_box
+    scene = g.copy()
+    scene[r0:r1 + 1, c0:c1 + 1] = BG
+
+    mismatches: list[tuple[int, list[np.ndarray]]] = []
+    for color, claimed in rows:
