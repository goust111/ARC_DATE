+                    candidates.append("U")
+                if rr == rh - 1 and cc == (rw - 1) // 2 and rw % 2 == 1:
+                    candidates.append("D")
+                if cc == 0 and rr == (rh - 1) // 2 and rh % 2 == 1:
+                    candidates.append("L")
+                if cc == rw - 1 and rr == (rh - 1) // 2 and rh % 2 == 1:
