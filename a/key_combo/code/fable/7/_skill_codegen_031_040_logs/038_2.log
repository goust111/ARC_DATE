+        return None
+    noise_palette = random.sample([c for c in range(10) if c != bg], 2)
+    for i, (r, c) in enumerate(chosen):
+        grid[r, c] = noise_palette[i % 2] if i < 2 else random.choice(noise_palette)
+    return chosen
+
