+def _generate_attempt() -> np.ndarray | None:
+    nr = random.choice((3, 3, 4))
+    nc = random.choice((3, 3, 4))
+    geometry = _sample_geometry(nr, nc)
+    if geometry is None:
+        return None
+    shape, rows, cols = geometry
+
+    forest_data = None
+    for _ in range(120):
