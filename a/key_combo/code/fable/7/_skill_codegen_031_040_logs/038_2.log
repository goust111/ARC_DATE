+    if direction == "U":
+        grid[r0, (c0 + c1) // 2] = bg
+    elif direction == "D":
+        grid[r1, (c0 + c1) // 2] = bg
+    elif direction == "L":
+        grid[(r0 + r1) // 2, c0] = bg
+    else:
+        grid[(r0 + r1) // 2, c1] = bg
+
+
+def _add_noise(grid: np.ndarray, boxes, bg: int):
