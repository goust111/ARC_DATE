+        for cells in _components_of_color(grid, color):
+            r0, c0 = cells.min(axis=0)
+            r1, c1 = cells.max(axis=0)
+            r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+            rh, rw = r1 - r0 + 1, c1 - c0 + 1
+            if rh < 3 or rw < 3:
+                continue
+            area = int(cells.shape[0])
+            if area not in (rh * rw, rh * rw - 1):
+                continue
