+    mask = grid == int(color)
+    seen = np.zeros(grid.shape, dtype=bool)
+    result: list[np.ndarray] = []
+    h, w = grid.shape
+    for sr, sc in np.argwhere(mask):
+        sr, sc = int(sr), int(sc)
+        if seen[sr, sc]:
+            continue
+        seen[sr, sc] = True
+        todo = [(sr, sc)]
+        cells = []
+        while todo:
+            r, c = todo.pop()
+            cells.append((r, c))
