+    random.shuffle(candidates)
+    chosen = []
+    target = random.randint(5, 10)
+    for pos in candidates:
+        if all(abs(pos[0] - q[0]) + abs(pos[1] - q[1]) > 1 for q in chosen):
+            chosen.append(pos)
+            if len(chosen) == target:
+                break
