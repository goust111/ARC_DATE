+        queue = deque([start])
+        coords: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            coords.append((r, c))
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if 0 <= nr < h and 0 <= nc < w and unseen[nr, nc]:
