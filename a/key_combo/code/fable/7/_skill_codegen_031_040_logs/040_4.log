+    r1, c1 = coords.max(axis=0)
+    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+    height, width = r1 - r0 + 1, c1 - c0 + 1
+    if height < 3 or width < 3 or height == width:
+        return None
