+    steps = [0] * (h - 1) + [1] * (w - 1)
+    rng.shuffle(steps)
+    for step in steps:
+        if step == 0:
+            lr += 1
+        else:
+            lc += 1
+        local.add((lr, lc))
+
+    for rr in range(h):
+        for cc in range(w):
+            if rng.random() < 0.28:
+                local.add((rr, cc))
+
+    if diagonal:
+        # Join the wedge-diagonal cell to the backbone along the bottom row.
+        bottom_cols = [cc for rr, cc in local if rr == h - 1]
+        for cc in range(0, min(bottom_cols) + 1):
+            local.add((h - 1, cc))
+
