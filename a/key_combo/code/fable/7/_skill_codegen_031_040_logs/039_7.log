+    except (AssertionError, ValueError):
+        return None
+    if not np.array_equal(solved, complete):
+        return None
+    changed = solved != inp
+    if int(changed.sum()) != hidden_last - hidden_first + 1:
+        return None
+    if not np.all(changed[hidden_row, hidden_first : hidden_last + 1]):
+        return None
+    return inp
