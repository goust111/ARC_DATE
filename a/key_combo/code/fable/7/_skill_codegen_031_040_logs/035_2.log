+    if side == "top":
+        return grid.copy()
+    if side == "bottom":
+        return np.flipud(grid).copy()
+    if side == "left":
+        return grid.T.copy()
+    if side == "right":
+        return np.flipud(grid.T).copy()
+    raise ValueError(side)
