    if tile is None:
        return None

    out = _gen_repeated(tile)
    holes = _gen_design_holes(n)
    if holes is None:
        return None
    if not _gen_has_enough_observations(n, holes):
        return None

    inp = out.copy()
    inp[holes] = 0
    if not _gen_oracle_accepts(inp, out):
        return None
    return inp


