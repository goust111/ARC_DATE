    assert g[0, 0] == g[0, w - 1] == g[h - 1, 0] == g[h - 1, w - 1] == bg

    top = int(g[0, 1])
    bottom = int(g[h - 1, 1])
    left = int(g[1, 0])
    right = int(g[1, w - 1])
