+                (rng.randrange(h), 0), (rng.randrange(h), w - 1)}
+    target_size = rng.randint(max(5, len(required) + 1), min(h * w - 1, 9))
+    targets = list(required)
+    rng.shuffle(targets)
+    for target in targets:
+        r, c = center
+        axes = [0, 1]
+        rng.shuffle(axes)
+        for axis in axes:
+            goal = target[axis]
+            while (r, c)[axis] != goal:
+                if axis == 0:
+                    r += 1 if goal > r else -1
+                else:
+                    c += 1 if goal > c else -1
