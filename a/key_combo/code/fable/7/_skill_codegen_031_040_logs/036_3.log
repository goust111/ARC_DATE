+    h, w = mask.shape
+    unseen = mask.copy()
+    result: list[np.ndarray] = []
+    for sr, sc in np.argwhere(unseen):
+        sr, sc = int(sr), int(sc)
+        if not unseen[sr, sc]:
+            continue
+        unseen[sr, sc] = False
+        queue = deque([(sr, sc)])
+        cells = []
+        while queue:
+            r, c = queue.popleft()
+            cells.append((r, c))
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and unseen[rr, cc]:
+                    unseen[rr, cc] = False
+                    queue.append((rr, cc))
