+    if not any(len(points) > 1 for points in anchors) and rng.random() < 0.70:
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, validated instance with 2--4 mutually addressed frames."""
