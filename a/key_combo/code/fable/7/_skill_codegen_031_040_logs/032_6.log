    c1 = random.randint(c0 + 1, min(nc - 2, c0 + 4))
    rect = (r0, c0, r1, c1)

    lattice_expected = np.full((nr, nc), bg, dtype=int)
    lattice_input = np.full((nr, nc), bg, dtype=int)
