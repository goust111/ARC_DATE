    grid = np.zeros(GRID_SHAPE, dtype=int)
    grid[_OUTER_FRAME_MASK] = OUTER_FRAME_COLOR
    grid[_INNER_FRAME_MASK] = INNER_FRAME_COLOR

    palette, seq = _gen_palette_and_sequence()
