+def _can_enter_frame(obj: dict, frame: dict, axis: int, direction: int, steps_before_hit: int) -> int | None:
+    if obj["is_frame"] or not obj["is_solid_rect"]:
+        return None
+    if frame["kind"] != "frame" or not frame["empty"]:
