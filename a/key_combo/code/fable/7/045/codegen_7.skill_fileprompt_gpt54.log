+            return None
+        shift = cavity[0] - obj["bbox"][0]
+    else:
+        if (obj["bbox"][0], obj["bbox"][2]) != (cavity[0], cavity[2]):
+            return None
+        shift = cavity[1] - obj["bbox"][1]
+
+    travel = shift * direction
+    if travel <= steps_before_hit:
+        return None
+    return int(shift)
