+            out[r, c] = mover_color
+
+    return out
+
+
+def _is_isolated_input_cell(cell: Coord, occupied: set[Coord]) -> bool:
+    return cell not in occupied and all(nei not in occupied for nei in _neighbors4(cell))
+
+
