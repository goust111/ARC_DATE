+
+def _sample_occluder(structure: np.ndarray, layers: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    side = int(structure.shape[0])
+    masks = _layer_masks(structure, layers)
+    for _ in range(200):
