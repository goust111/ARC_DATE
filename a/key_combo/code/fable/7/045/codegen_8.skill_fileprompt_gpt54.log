+        nxt[thickness:-thickness, thickness:-thickness] = square
+        square = nxt
+    return square
+
+
+def _layer_masks(structure: np.ndarray, layers: list[tuple[int, int]]) -> list[np.ndarray]:
+    return [structure == color for color, _ in layers]
+
+
