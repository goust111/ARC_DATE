+    total = sum(int(height) for _, height in layers)
+    out = np.zeros((total, 1), dtype=int)
+    cursor = total
+    for color, height in layers:
+        cursor -= int(height)
+        out[cursor : cursor + height, 0] = int(color)
+    return out
