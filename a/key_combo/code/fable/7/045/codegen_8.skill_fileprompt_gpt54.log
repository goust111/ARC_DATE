+        width = random.randint(1, side)
+        r0 = random.randint(0, side - height)
+        c0 = random.randint(0, side - width)
+        rect = np.zeros_like(structure, dtype=bool)
+        rect[r0 : r0 + height, c0 : c0 + width] = True
