+
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    if not pts.issubset(corners):
+        return None
+
+    missing = next(iter(corners - pts))
+    return (int(r0), int(c0), int(r1), int(c1)), (int(missing[0]), int(missing[1]))
