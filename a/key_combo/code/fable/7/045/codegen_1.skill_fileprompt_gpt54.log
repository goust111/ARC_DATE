OBJECT_HEIGHTS, OBJECT_WIDTHS = range(6, 9), range(4, 7)
OBJECT_AREA_MIN, OBJECT_AREA_MAX = 13, 23
DENSITY_MIN, DENSITY_MAX = 0.48, 0.72

