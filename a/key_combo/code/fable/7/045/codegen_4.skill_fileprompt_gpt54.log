        if right_frontier:
            choices.extend(["right"] * len(right_frontier))
        if not choices:
            return False

        side = random.choice(choices)
        if side == "left":
            r, c = random.choice(left_frontier)
            left[r, c] = True
        else:
            r, c = random.choice(right_frontier)
            right[r, c] = True
    return True


