+
+
+def _shift_comp(comp: dict, dr: int, dc: int) -> dict[Coord, int]:
+    return {(r + dr, c + dc): color for (r, c), color in comp["colors"].items()}
+
+
+def _divisors(n: int) -> list[int]:
+    out = set()
+    for d in range(1, int(abs(n) ** 0.5) + 1):
+        if n % d == 0:
+            out.add(d)
+            out.add(abs(n) // d)
+    return sorted(out)
