+        w = rng.randint(3, 5)
+        mask = _random_template_mask(rng, h, w)
+        area = int(mask.sum())
+        palette_size = rng.randint(2, min(5, area))
+        palette = rng.sample([1, 2, 3, 4, 5, 6, 7, 8, 9], palette_size)
+        coords = [tuple(map(int, p)) for p in np.argwhere(mask)]
+        rng.shuffle(coords)
