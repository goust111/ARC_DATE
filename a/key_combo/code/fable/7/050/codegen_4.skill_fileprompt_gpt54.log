+        shift_c = -indices[idx] * step[1]
+        for (r, c), color in comp["colors"].items():
+            pos = (r + shift_r, c + shift_c)
+            prev = union.get(pos)
+            if prev is not None and prev != color:
+                return None
+            union[pos] = color
