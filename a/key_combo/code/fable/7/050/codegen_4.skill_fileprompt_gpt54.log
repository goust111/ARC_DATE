+def _vector_options(h: int, w: int, copies: int) -> list[Vector]:
+    opts = []
+    for dr in range(3, 10):
+        for dc in range(3, 10):
+            if np.gcd(dr, dc) != 1:
+                continue
+            if dr <= h + 1 or dc <= w + 1:
+                continue
+            total_h = h + (copies - 1) * dr + 2
+            total_w = w + (copies - 1) * dc + 2
+            if total_h <= 30 and total_w <= 30:
+                opts.append((dr, dc))
+    return opts
