+def _multiple_of(diff: Vector, step: Vector) -> int | None:
+    dr, dc = diff
+    sr, sc = step
+    if sr == 0 and sc == 0:
+        return None
+    if sr == 0:
+        if dr != 0 or sc == 0 or dc % sc != 0:
+            return None
+        return dc // sc
+    if sc == 0:
+        if dc != 0 or dr % sr != 0:
+            return None
+        return dr // sr
+    if dr % sr != 0 or dc % sc != 0:
+        return None
+    kr = dr // sr
+    kc = dc // sc
+    if kr != kc:
+        return None
+    return kr
