+        conflict = False
+        shifted = _shift_comp(comp_b, -k * step[0], -k * step[1])
+        for pos, color in shifted.items():
+            other = comp_a["colors"].get(pos)
+            if other is None:
+                continue
+            if other != color:
+                conflict = True
+                break
+            overlap += 1
+        if conflict or overlap == 0:
+            continue
