+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        built = _build_input(rng)
+        if built is not None:
+            return built[0]
+    raise RuntimeError("failed to generate a valid remnant-composition puzzle")

