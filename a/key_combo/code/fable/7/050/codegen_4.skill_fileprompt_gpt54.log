+        hidden_any = False
+        for _ in range(rng.randint(1, 2)):
+            r0 = rng.randrange(h)
+            r1 = rng.randrange(r0, h)
+            c0 = rng.randrange(w)
+            c1 = rng.randrange(c0, w)
