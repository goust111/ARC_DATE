_GEN_MARKERS = {
    "top_left": ((0, 0), (0, 1), (1, 0)),
    "top_right": ((0, 0), (0, 1), (1, 1)),
    "bottom_left": ((0, 0), (1, 0), (1, 1)),
    "bottom_right": ((0, 1), (1, 0), (1, 1)),
