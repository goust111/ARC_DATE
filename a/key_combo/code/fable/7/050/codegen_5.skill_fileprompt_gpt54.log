+
+def _place_static_objects(
+    left: np.ndarray,
+    right: np.ndarray,
+    masks: list[np.ndarray],
+    colors: list[int],
+) -> tuple[np.ndarray, np.ndarray, list[tuple[np.ndarray, int]], set[tuple[int, int]], np.ndarray] | None:
+    h, w = left.shape
+    left_occ: set[tuple[int, int]] = set()
+    right_occ: set[tuple[int, int]] = set()
