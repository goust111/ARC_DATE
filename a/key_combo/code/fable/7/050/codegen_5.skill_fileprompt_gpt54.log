+GRID_ROWS = (9, 14)
+GRID_COLS = (9, 14)
+MOVER_COUNT = (1, 3)
+STATIC_COUNT = (1, 3)
+AREA_RANGE = (2, 6)
+SHAPE_BOX = (2, 4)
+SPEED_CHOICES = (1, 2, 3)
