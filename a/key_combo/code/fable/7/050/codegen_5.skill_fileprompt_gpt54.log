+    moved = coords + np.array([dr, dc], dtype=int)
+    h, w = static_mask.shape
+    if (
+        int(moved[:, 0].min()) < 0
+        or int(moved[:, 0].max()) >= h
+        or int(moved[:, 1].min()) < 0
+        or int(moved[:, 1].max()) >= w
