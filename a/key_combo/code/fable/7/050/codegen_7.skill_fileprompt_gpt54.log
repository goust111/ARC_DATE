+        height = random.randint(min_height, min(30, min_height + 8))
+    return height, width
+
+
+def _place_track(
+    grid: np.ndarray,
+    orientation: str,
+    ordered_positions: list[int],
+    fixed: int,
+    slider_index: int,
+    occupied: set[int],
+) -> None:
+    for idx, pos in enumerate(ordered_positions):
+        color = GREEN
+        if idx == slider_index:
+            color = RED
+        elif idx in occupied:
+            color = random.choice(BLOCKER_COLORS)
+        _set_line_value(grid, orientation, fixed, pos, color)
+
+
+def _fuel_candidates(
+    shape: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    orientation: str,
+    fixed: int,
+    yellow_rc: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    yr, yc = yellow_rc
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in blocked:
