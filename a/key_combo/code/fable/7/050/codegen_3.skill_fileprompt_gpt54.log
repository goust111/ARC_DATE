+def _adjacent_pairs(cells: set[tuple[int, int]]) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    pairs = []
+    for r, c in cells:
+        for nr, nc in ((r + 1, c), (r, c + 1)):
+            if (nr, nc) in cells:
+                pairs.append(((r, c), (nr, nc)))
