+        expected = expected_by_anchor.get(anchor_key)
+        if expected is None:
+            return None
+        candidates = _candidate_placements(grid, sprite, anchor["color"], anchor["coords"], bg)
+        if len(candidates) != 1:
+            return None
+        if set(candidates[0]["placed"]) != expected:
+            return None
