+    copy_positions = []
+    for idx, shape in enumerate(rotated_shapes):
+        prefer_edge = idx == 0 or turns_list[idx] in (0, 2)
+        pos = _sample_position((height, width), shape, placed_rects, rng, margin=2, prefer_edge=prefer_edge)
