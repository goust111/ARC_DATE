+        for perm in itertools.permutations(anchor_coords):
+            dr = perm[0][0] - domino[0][0]
+            dc = perm[0][1] - domino[0][1]
+            shifted_domino = {(domino[0][0] + dr, domino[0][1] + dc), (domino[1][0] + dr, domino[1][1] + dc)}
+            if shifted_domino != anchor_set:
+                continue
