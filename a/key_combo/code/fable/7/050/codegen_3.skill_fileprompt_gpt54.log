+def _rects_too_close(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    margin: int,
+) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah - 1 + margin < br
+        or br + bh - 1 + margin < ar
+        or ac + aw - 1 + margin < bc
+        or bc + bw - 1 + margin < ac
