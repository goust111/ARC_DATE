+    orig_pos = _sample_position((height, width), sprite.shape, placed_rects, rng, margin=2, prefer_edge=False)
+    if orig_pos is None:
+        return None
+    placed_rects.append((orig_pos[0], orig_pos[1], sprite.shape[0], sprite.shape[1]))
