+    intended = []
+    for color, turns, (top, left) in zip(anchor_colors, turns_list, copy_positions):
+        rotated = np.rot90(sprite, turns)
+        domino = [tuple(map(int, rc)) for rc in np.argwhere(rotated == color)]
+        assert _is_domino(domino)
