+        return r0, c0 + offset
+    if side == "bottom":
+        return r1, c0 + offset
+    if side == "left":
+        return r0 + offset, c0
+    return r0 + offset, c1
+
+
+def _contour_cycle(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    pts: list[tuple[int, int]] = []
+    for c in range(c0 - 1, c1 + 2):
+        pts.append((r0 - 1, c))
+    for r in range(r0, r1 + 2):
+        pts.append((r, c1 + 1))
+    for c in range(c1, c0 - 2, -1):
+        pts.append((r1 + 1, c))
+    for r in range(r1, r0 - 1, -1):
+        pts.append((r, c0 - 1))
+    return pts
