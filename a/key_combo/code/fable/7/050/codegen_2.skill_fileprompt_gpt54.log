+def _parse_rectangles(grid: np.ndarray) -> list[dict]:
+    wall_mask = (grid != BG) & (grid != YELLOW)
+    rects: list[dict] = []
+    for comp in _components(wall_mask):
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
