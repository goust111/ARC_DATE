+def _bboxes_separated(a: dict, b: dict, margin: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    return (
+        ar1 + margin < br0
+        or br1 + margin < ar0
+        or ac1 + margin < bc0
+        or bc1 + margin < ac0
