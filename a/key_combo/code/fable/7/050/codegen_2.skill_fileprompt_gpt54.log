+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+WALL_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+SIDES = ("top", "right", "bottom", "left")
+SIDE_DIRS = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
