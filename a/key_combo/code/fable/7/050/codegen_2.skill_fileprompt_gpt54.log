+def _all_gap_options(rect: dict) -> list[tuple[str, int]]:
+    opts: list[tuple[str, int]] = []
+    _, _, _, _ = rect["bbox"]
+    for side in ("top", "bottom"):
+        for offset in range(1, rect["w"] - 1):
+            opts.append((side, offset))
+    for side in ("left", "right"):
+        for offset in range(1, rect["h"] - 1):
+            opts.append((side, offset))
