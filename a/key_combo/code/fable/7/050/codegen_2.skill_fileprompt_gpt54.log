    out = np.full_like(g, bg)
    arm = h // 2

    seen_corners: set[str] = set()
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert components

    for comp in components:
        assert comp["area"] == 3
        r0, c0, r1, c1 = comp["bbox"]
        assert (r1 - r0, c1 - c0) == (1, 1)

        local = frozenset(
