+    for c in range(c0 - 1, c1 + 2):
+        pts.append((r0 - 1, c))
+    for r in range(r0, r1 + 2):
+        pts.append((r, c1 + 1))
+    for c in range(c1, c0 - 2, -1):
+        pts.append((r1 + 1, c))
+    for r in range(r1, r0 - 1, -1):
+        pts.append((r, c0 - 1))
+    return pts
