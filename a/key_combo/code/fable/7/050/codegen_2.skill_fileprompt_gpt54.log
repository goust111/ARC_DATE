    body_mask[r0 : r1 + 1, c0 : c1 + 1] = True
    stem = moving_mask & ~body_mask
    dr, dc, distance = _stem_shift(stem, body_box)

    body_rows, body_cols = np.where(body_mask)
    new_rows = body_rows + dr * distance
    new_cols = body_cols + dc * distance
    h, w = g.shape
