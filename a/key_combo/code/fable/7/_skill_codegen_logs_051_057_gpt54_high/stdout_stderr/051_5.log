+        dc1 = path[idx][1] - path[idx - 1][1]
+        dr2 = path[idx + 1][0] - path[idx][0]
+        dc2 = path[idx + 1][1] - path[idx][1]
+        if (dr1, dc1) != (dr2, dc2):
