+            counts = Counter(map(int, bucket))
+            best_color, best_count = counts.most_common(1)[0]
+            second = counts.most_common(2)[1][1] if len(counts) > 1 else 0
+            if best_count <= second:
+                valid = False
+                break
+            motif.append(int(best_color))
+        if valid:
