+    colors = np.full((coarse_h, coarse_w), bg, dtype=int)
+
+    for rr in range(coarse_h):
+        for cc in range(coarse_w):
+            patch = sub[rr * block : (rr + 1) * block, cc * block : (cc + 1) * block]
+            vals = set(map(int, patch.flatten()))
+            if vals == {bg}:
