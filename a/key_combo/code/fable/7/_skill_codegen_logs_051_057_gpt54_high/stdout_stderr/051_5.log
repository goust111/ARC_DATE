+def _turn_count(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    for idx in range(1, len(path) - 1):
+        dr1 = path[idx][0] - path[idx - 1][0]
+        dc1 = path[idx][1] - path[idx - 1][1]
+        dr2 = path[idx + 1][0] - path[idx][0]
+        dc2 = path[idx + 1][1] - path[idx][1]
+        if (dr1, dc1) != (dr2, dc2):
+            turns += 1
+    return turns
