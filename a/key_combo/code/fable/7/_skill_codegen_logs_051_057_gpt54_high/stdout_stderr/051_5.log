            labels[0, :] = 1
            labels[RECT_HEIGHT - 1, int(np.random.randint(width))] = 2
        elif mode == "bottom_top":
            labels[RECT_HEIGHT - 1, :] = 1
            labels[0, int(np.random.randint(width))] = 2
        elif mode == "left_right":
