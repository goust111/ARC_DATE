+
+
+def _expected_output(shape: tuple[int, int], path: list[tuple[int, int]], block: int, left_grey: int, motif: list[int], canvas_shape: tuple[int, int], offset: tuple[int, int]) -> np.ndarray:
+    coarse_h, coarse_w = shape
