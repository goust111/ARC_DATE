+
+def _pick_joint_pair(row_labels: np.ndarray, col_labels: np.ndarray) -> tuple[int, int]:
+    pairs = [(r, c) for r in range(len(row_labels)) for c in range(len(col_labels)) if int(row_labels[r]) == int(col_labels[c])]
