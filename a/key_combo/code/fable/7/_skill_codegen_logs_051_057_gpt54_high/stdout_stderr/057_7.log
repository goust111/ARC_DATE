+        if i == parts:
+            if remaining == 0:
+                choices.append(current.copy())
+            return
+        for value in range(low, high + 1):
+            min_rest = (parts - i - 1) * low
+            max_rest = (parts - i - 1) * high
+            if remaining - value < min_rest or remaining - value > max_rest:
+                continue
+            current.append(value)
+            rec(i + 1, remaining - value, current)
