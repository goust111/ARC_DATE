+from __future__ import annotations
+
+from collections import Counter
+from importlib.machinery import SourceFileLoader
+import random
+
+import numpy as np
+
+
+_ARC_UTILS = SourceFileLoader(
+    "_arc_utils_fable_7_057_7",
+    "/home/lixinyu/snap/new/solvers/arc_utils.py",
+).load_module()
+Color = _ARC_UTILS.Color
+find_components = _ARC_UTILS.find_components
+
+
+BG = Color.BLACK
+GREY = Color.GREY
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+ORIENTATIONS = ("h", "v")
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _row_segments(row: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
+    segments: list[tuple[int, int, int]] = []
+    c = 0
+    while c < row.size:
+        color = int(row[c])
+        if color == bg:
+            c += 1
+            continue
+        c0 = c
+        while c + 1 < row.size and int(row[c + 1]) == color:
+            c += 1
+        segments.append((c0, c, color))
+        c += 1
+    return segments
+
+
+def _component_mask(component: dict) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    coords = component["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask, (r0, c0, r1, c1)
+
+
+def _bits_from_cells(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...], width: int) -> int:
+    bits = 0
+    for r, c in cells:
+        bits |= 1 << int(int(r) * width + int(c))
+    return int(bits)
+
+
+def _candidate_strips(mask: np.ndarray, lengths: list[int]) -> tuple[list[dict], list[list[int]]]:
+    h, w = map(int, mask.shape)
+    n = h * w
+    candidates: list[dict] = []
+    by_cell: list[list[int]] = [[] for _ in range(n)]
+
+    for r in range(h):
+        for c0 in range(w):
+            if not mask[r, c0]:
+                continue
+            for length in lengths:
+                c1 = c0 + length
+                if c1 <= w and bool(mask[r, c0:c1].all()):
+                    cells = tuple((r, c) for c in range(c0, c1))
+                    bits = int(_bits_from_cells(cells, w))
+                    idx = len(candidates)
+                    candidates.append({"bits": bits, "length": length, "orientation": "h", "cells": cells})
+                    for rr, cc in cells:
+                        by_cell[rr * w + cc].append(idx)
+
+    for c in range(w):
+        for r0 in range(h):
+            if not mask[r0, c]:
+                continue
+            for length in lengths:
+                r1 = r0 + length
+                if r1 <= h and bool(mask[r0:r1, c].all()):
+                    cells = tuple((r, c) for r in range(r0, r1))
+                    bits = int(_bits_from_cells(cells, w))
+                    idx = len(candidates)
+                    candidates.append({"bits": bits, "length": length, "orientation": "v", "cells": cells})
+                    for rr, cc in cells:
+                        by_cell[rr * w + cc].append(idx)
+
+    return candidates, by_cell
+
+
+def _unique_strip_decomposition(mask: np.ndarray, len_to_color: dict[int, int]) -> list[dict]:
+    lengths = sorted(len_to_color)
+    h, w = map(int, mask.shape)
+    candidates, by_cell = _candidate_strips(mask, lengths)
+    occupied = [int(r * w + c) for r, c in np.argwhere(mask)]
+    full_state = 0
+    for idx in occupied:
+        full_state |= 1 << int(idx)
+
+    for idx in occupied:
+        if not by_cell[idx]:
+            raise AssertionError("each grey cell must belong to at least one allowed strip")
+
+    memo: dict[int, tuple[int, tuple[int, ...]]] = {}
+
+    def solve(state: int) -> tuple[int, tuple[int, ...]]:
+        if state == 0:
+            return 1, ()
+        if state in memo:
+            return memo[state]
+
+        pivot = None
+        pivot_options = None
+        for idx in occupied:
+            if not (int(state) >> int(idx)) & 1:
+                continue
+            options = [
+                k
+                for k in by_cell[idx]
+                if (int(candidates[k]["bits"]) & int(state)) == int(candidates[k]["bits"])
+            ]
+            if not options:
+                memo[state] = (0, ())
+                return memo[state]
+            if pivot_options is None or len(options) < len(pivot_options):
+                pivot = idx
+                pivot_options = options
+                if len(options) == 1:
+                    break
+
+        assert pivot is not None and pivot_options is not None
+        count = 0
+        best_solution: tuple[int, ...] = ()
+        for k in pivot_options:
+            subcount, subsolution = solve(int(state) ^ int(candidates[k]["bits"]))
+            if subcount == 0:
+                continue
+            if count == 0:
+                best_solution = (k,) + subsolution
+            count += subcount
+            if count > 1:
+                memo[state] = (2, best_solution)
+                return memo[state]
+
+        memo[state] = (count, best_solution)
+        return memo[state]
+
+    count, solution_ids = solve(full_state)
+    assert count == 1, "each grey block must admit exactly one strip decomposition"
+    return [candidates[k] for k in solution_ids]
+
+
+def _separator_row(grid: np.ndarray) -> int:
+    h = int(grid.shape[0])
+    assert h >= 3, "expected work area, separator row, and dictionary row"
+    sep_r = h - 2
+    sep_color = int(grid[sep_r, 0])
+    assert sep_color != int(grid[0, 0]) or not bool(np.all(grid[sep_r] == grid[0, 0]))
+    assert bool(np.all(grid[sep_r] == sep_color)), "separator row must be full-width and uniform"
+    return sep_r
+
+
+def _parse_dictionary(grid: np.ndarray) -> tuple[int, dict[int, int], int]:
+    sep_r = _separator_row(grid)
+    work = np.asarray(grid[:sep_r], dtype=int)
+    bg = int(Counter(map(int, work.ravel())).most_common(1)[0][0])
+    dict_row = np.asarray(grid[sep_r + 1], dtype=int)
+    segments = _row_segments(dict_row, bg)
+    assert len(segments) >= 2, "dictionary row must contain multiple colored segments"
+
+    len_to_color: dict[int, int] = {}
+    seen_colors: set[int] = set()
+    sep_color = int(grid[sep_r, 0])
+    for c0, c1, color in segments:
+        length = c1 - c0 + 1
+        assert color != sep_color and color != GREY
+        assert color not in seen_colors, "dictionary colors must be distinct"
+        assert length not in len_to_color, "dictionary lengths must be distinct"
+        seen_colors.add(color)
+        len_to_color[length] = color
+    return sep_r, len_to_color, bg
+
+
+def _paint_axis_runs(grid: np.ndarray, len_to_color: dict[int, int], axis: str) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    sep_r, _parsed, _bg = _parse_dictionary(grid)
+    work = out[:sep_r]
+    if axis == "h":
+        for r in range(work.shape[0]):
+            c = 0
+            while c < work.shape[1]:
+                if int(work[r, c]) != GREY:
+                    c += 1
+                    continue
+                c0 = c
+                while c + 1 < work.shape[1] and int(work[r, c + 1]) == GREY:
+                    c += 1
+                length = c - c0 + 1
+                work[r, c0 : c + 1] = len_to_color.get(length, GREY)
+                c += 1
+        return out
+
+    for c in range(work.shape[1]):
+        r = 0
+        while r < work.shape[0]:
+            if int(work[r, c]) != GREY:
+                r += 1
+                continue
+            r0 = r
+            while r + 1 < work.shape[0] and int(work[r + 1, c]) == GREY:
+                r += 1
+            length = r - r0 + 1
+            work[r0 : r + 1, c] = len_to_color.get(length, GREY)
+            r += 1
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Decompose each grey composite block using the strip-length dictionary written at the bottom, then recolor every strip by the dictionary color for its length.
+
+    Input structure:
+    - The last two rows are a full-width separator line and a bottom dictionary row of separated colored horizontal segments.
+    - Each dictionary segment has a unique length and a unique color, defining a length-to-color mapping.
+    - Above the separator are one or more grey 4-connected composite blocks on the background.
+
+    Rule:
+    - Read the dictionary row so that each segment length maps to that segment's color.
+    - For every grey block in the work area, find the unique partition into one-cell-wide horizontal or vertical strips whose lengths all appear in the dictionary.
+    - Recolor each strip with the color for its length, leaving the separator row and dictionary row unchanged.
+
+    Key insight:
+    - The bottom row is not decoration: it chooses both the legal strip sizes and the output colors, so the same grey shape can imply a different decomposition under a different dictionary.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    sep_r, len_to_color, bg = _parse_dictionary(g)
+    work = g[:sep_r]
+    components = find_components(work, bg=bg, connectivity=4, monochromatic=True, colors=[GREY])
+    assert components, "expected grey work-area blocks"
+    assert np.all((work == bg) | (work == GREY)), "work area should contain only background and grey blocks"
+
+    out = g.copy()
+    for component in components:
+        mask, (r0, c0, _r1, _c1) = _component_mask(component)
+        strips = _unique_strip_decomposition(mask, len_to_color)
+        for strip in strips:
+            color = int(len_to_color[strip["length"]])
+            for rr, cc in strip["cells"]:
+                out[r0 + rr, c0 + cc] = color
+
+    return out
+
+
+def _bar_cells(r0: int, c0: int, length: int, orientation: str) -> list[tuple[int, int]]:
+    if orientation == "h":
+        return [(r0, c0 + d) for d in range(length)]
+    return [(r0 + d, c0) for d in range(length)]
+
+
+def _contact_count(cells: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> int:
+    count = 0
+    for r, c in cells:
+        if (r - 1, c) in occupied or (r + 1, c) in occupied or (r, c - 1) in occupied or (r, c + 1) in occupied:
+            count += 1
+    return count
+
+
+def _normalize_cells(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    min_r = min(rows)
+    min_c = min(cols)
+    normalized = sorted((r - min_r, c - min_c) for r, c in cells)
+    return normalized, (min_r, min_c)
+
+
+def _generate_component(lengths: list[int], len_to_color: dict[int, int]) -> tuple[np.ndarray, list[dict]] | None:
+    scratch_h = scratch_w = 14
+    for _ in range(250):
+        order = list(lengths)
+        random.shuffle(order)
+        occupied: set[tuple[int, int]] = set()
+        placed_bars: list[list[tuple[int, int]]] = []
+
+        first_orientation = random.choice(ORIENTATIONS)
+        first_length = order[0]
+        if first_orientation == "h":
+            first_r = random.randint(4, scratch_h - 5)
+            first_c = random.randint(2, scratch_w - first_length - 2)
+        else:
+            first_r = random.randint(2, scratch_h - first_length - 2)
+            first_c = random.randint(4, scratch_w - 5)
+        first_cells = _bar_cells(first_r, first_c, first_length, first_orientation)
+        occupied.update(first_cells)
+        placed_bars.append(first_cells)
+
+        failed = False
+        for length in order[1:]:
+            candidates: list[list[tuple[int, int]]] = []
+            orientations = list(ORIENTATIONS)
+            random.shuffle(orientations)
+            for orientation in orientations:
+                if orientation == "h":
+                    for r0 in range(scratch_h):
+                        for c0 in range(scratch_w - length + 1):
+                            cells = _bar_cells(r0, c0, length, orientation)
+                            if any(cell in occupied for cell in cells):
+                                continue
+                            if _contact_count(cells, occupied) != 1:
+                                continue
+                            candidates.append(cells)
+                else:
+                    for r0 in range(scratch_h - length + 1):
+                        for c0 in range(scratch_w):
+                            cells = _bar_cells(r0, c0, length, orientation)
+                            if any(cell in occupied for cell in cells):
+                                continue
+                            if _contact_count(cells, occupied) != 1:
+                                continue
+                            candidates.append(cells)
+
+            if not candidates:
+                failed = True
+                break
+            chosen = random.choice(candidates)
+            occupied.update(chosen)
+            placed_bars.append(chosen)
+
+        if failed:
+            continue
+
+        normalized_cells, _origin = _normalize_cells(occupied)
+        comp_h = 1 + max(r for r, _ in normalized_cells)
+        comp_w = 1 + max(c for _, c in normalized_cells)
+        if comp_h > 8 or comp_w > 8:
+            continue
+
+        patch = np.full((comp_h, comp_w), BG, dtype=int)
+        for r, c in normalized_cells:
+            patch[r, c] = GREY
+
+        try:
+            strips = _unique_strip_decomposition(patch == GREY, len_to_color)
+        except AssertionError:
+            continue
+        if len(strips) < 2:
+            continue
+        return patch, strips
+    return None
+
+
+def _sample_counts(total: int, parts: int, low: int, high: int) -> list[int] | None:
+    choices: list[list[int]] = []
+
+    def rec(i: int, remaining: int, current: list[int]) -> None:
+        if i == parts:
+            if remaining == 0:
+                choices.append(current.copy())
+            return
+        for value in range(low, high + 1):
+            min_rest = (parts - i - 1) * low
+            max_rest = (parts - i - 1) * high
+            if remaining - value < min_rest or remaining - value > max_rest:
+                continue
+            current.append(value)
+            rec(i + 1, remaining - value, current)
+            current.pop()
+
+    rec(0, total, [])
+    return random.choice(choices) if choices else None
+
+
+def _place_components(work_h: int, work_w: int, patches: list[np.ndarray]) -> tuple[np.ndarray, list[tuple[int, int]]] | None:
+    grid = np.full((work_h, work_w), BG, dtype=int)
+    blocked = np.zeros((work_h, work_w), dtype=bool)
+    positions: list[tuple[int, int]] = []
+
+    order = list(range(len(patches)))
+    random.shuffle(order)
+    placed_positions: list[tuple[int, int] | None] = [None] * len(patches)
+
+    for idx in order:
+        patch = patches[idx]
+        ph, pw = map(int, patch.shape)
+        candidates = [(r, c) for r in range(work_h - ph + 1) for c in range(work_w - pw + 1)]
+        random.shuffle(candidates)
+        chosen = None
+        for r0, c0 in candidates:
+            mask = patch == GREY
+            sub_blocked = blocked[r0 : r0 + ph, c0 : c0 + pw]
+            if bool(sub_blocked[mask].any()):
+                continue
+            chosen = (r0, c0)
+            break
+        if chosen is None:
+            return None
+
+        r0, c0 = chosen
+        placed_positions[idx] = chosen
+        mask = patch == GREY
+        grid[r0 : r0 + ph, c0 : c0 + pw][mask] = GREY
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(work_h, r0 + ph + 1)
+        cc1 = min(work_w, c0 + pw + 1)
+        blocked[rr0:rr1, cc0:cc1] = True
+
+    assert all(pos is not None for pos in placed_positions)
+    return grid, [(int(r), int(c)) for r, c in placed_positions]  # type: ignore[misc]
+
+
+def _dictionary_row(width: int, lengths: list[int], colors: list[int]) -> np.ndarray | None:
+    perm = list(range(len(lengths)))
+    random.shuffle(perm)
+    ordered_lengths = [lengths[i] for i in perm]
+    ordered_colors = [colors[i] for i in perm]
+    minimum = sum(ordered_lengths) + (len(ordered_lengths) - 1)
+    if minimum > width:
+        return None
+
+    extra = width - minimum
+    gaps = [0] * (len(ordered_lengths) + 1)
+    for _ in range(extra):
+        gaps[random.randrange(len(gaps))] += 1
+
+    row = np.full(width, BG, dtype=int)
+    c = gaps[0]
+    for i, (length, color) in enumerate(zip(ordered_lengths, ordered_colors)):
+        row[c : c + length] = color
+        c += length
+        if i + 1 < len(ordered_lengths):
+            c += 1 + gaps[i + 1]
+    return row
+
+
+def _expected_output(
+    grid: np.ndarray,
+    positions: list[tuple[int, int]],
+    strip_solutions: list[list[dict]],
+    len_to_color: dict[int, int],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for (r0, c0), strips in zip(positions, strip_solutions):
+        for strip in strips:
+            color = int(len_to_color[strip["length"]])
+            for rr, cc in strip["cells"]:
+                out[r0 + rr, c0 + cc] = color
+    return out
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        out = main(grid)
+    except AssertionError:
+        return False
+
+    sep_r, len_to_color, bg = _parse_dictionary(grid)
+    if not np.array_equal(grid[sep_r:], out[sep_r:]):
+        return False
+
+    work = grid[:sep_r]
+    components = find_components(work, bg=bg, connectivity=4, monochromatic=True, colors=[GREY])
+    if len(components) < 2:
+        return False
+
+    used_lengths: list[int] = []
+    used_orientations: set[str] = set()
+    multi_length_component = False
+    for component in components:
+        mask, (r0, c0, _r1, _c1) = _component_mask(component)
+        try:
+            strips = _unique_strip_decomposition(mask, len_to_color)
+        except AssertionError:
+            return False
+        lengths_here = {strip["length"] for strip in strips}
+        multi_length_component |= len(lengths_here) >= 2
+        used_lengths.extend(strip["length"] for strip in strips)
+        used_orientations.update(strip["orientation"] for strip in strips)
+        for strip in strips:
+            color = len_to_color[strip["length"]]
+            for rr, cc in strip["cells"]:
+                if int(out[r0 + rr, c0 + cc]) != int(color):
+                    return False
+
+    if set(used_lengths) != set(len_to_color):
+        return False
+    if used_orientations != {"h", "v"}:
+        return False
+    if not multi_length_component:
+        return False
+    if np.array_equal(_paint_axis_runs(grid, len_to_color, "h"), out):
+        return False
+    if np.array_equal(_paint_axis_runs(grid, len_to_color, "v"), out):
+        return False
+    return True
+
+
+def _generate_case() -> np.ndarray | None:
+    n_lengths = random.randint(2, 4)
+    lengths = sorted(random.sample(range(2, 7), n_lengths))
+    max_total_bars = min(9, n_lengths + 4)
+    max_components = min(4, n_lengths + 1, max_total_bars // 2)
+    n_components = random.randint(2, max_components)
+    total_bars = random.randint(max(2 * n_components, n_lengths + 1), max_total_bars)
+    counts = _sample_counts(total_bars, n_components, 2, 4)
+    if counts is None:
+        return None
+
+    bar_lengths = list(lengths)
+    while len(bar_lengths) < total_bars:
+        bar_lengths.append(random.choice(lengths))
+    random.shuffle(bar_lengths)
+
+    component_lengths: list[list[int]] = []
+    start = 0
+    for count in counts:
+        component_lengths.append(bar_lengths[start : start + count])
+        start += count
+
+    color_pool = random.sample(PALETTE, n_lengths + 1)
+    separator_color = color_pool[0]
+    dict_colors = color_pool[1:]
+    len_to_color = dict(zip(lengths, dict_colors))
+
+    patches: list[np.ndarray] = []
+    strip_solutions: list[list[dict]] = []
+    for lengths_here in component_lengths:
+        generated = _generate_component(lengths_here, len_to_color)
+        if generated is None:
+            return None
+        patch, strips = generated
+        patches.append(patch)
+        strip_solutions.append(strips)
+
+    used_lengths = {strip["length"] for strips in strip_solutions for strip in strips}
+    used_orientations = {strip["orientation"] for strips in strip_solutions for strip in strips}
+    if used_lengths != set(lengths):
+        return None
+    if used_orientations != {"h", "v"}:
+        return None
+    if not any(len({strip["length"] for strip in strips}) >= 2 for strips in strip_solutions):
+        return None
+
+    dict_min_width = sum(lengths) + len(lengths) + 1
+    min_work_w = max(max(patch.shape[1] for patch in patches) + 2, dict_min_width)
+    min_work_h = max(max(patch.shape[0] for patch in patches) + 2, 8)
+    work_w = random.randint(min_work_w, 30)
+    work_h = random.randint(min_work_h, min(28, max(min_work_h, 12 + len(patches))))
+    if work_h + 2 > 30:
+        return None
+
+    placed = _place_components(work_h, work_w, patches)
+    if placed is None:
+        return None
+    work_grid, positions = placed
+
+    dict_row = _dictionary_row(work_w, lengths, dict_colors)
+    if dict_row is None:
+        return None
+
+    grid = np.full((work_h + 2, work_w), BG, dtype=int)
+    grid[:work_h] = work_grid
+    grid[work_h] = separator_color
+    grid[work_h + 1] = dict_row
+    expected = _expected_output(grid, positions, strip_solutions, len_to_color)
+    if not np.array_equal(main(grid), expected):
+        return None
+    if np.array_equal(_paint_axis_runs(grid, len_to_color, "h"), expected):
+        return None
+    if np.array_equal(_paint_axis_runs(grid, len_to_color, "v"), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_case()
+        if grid is not None:
