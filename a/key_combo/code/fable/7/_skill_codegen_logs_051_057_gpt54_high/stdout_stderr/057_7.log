+def _separator_row(grid: np.ndarray) -> int:
+    h = int(grid.shape[0])
+    assert h >= 3, "expected work area, separator row, and dictionary row"
+    sep_r = h - 2
+    sep_color = int(grid[sep_r, 0])
+    assert sep_color != int(grid[0, 0]) or not bool(np.all(grid[sep_r] == grid[0, 0]))
+    assert bool(np.all(grid[sep_r] == sep_color)), "separator row must be full-width and uniform"
