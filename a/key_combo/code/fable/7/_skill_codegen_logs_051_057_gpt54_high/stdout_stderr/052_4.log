+def _normalize(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    arr = np.asarray(cells, dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    coords = sorted((int(r), int(c)) for r, c in arr)
+    return tuple(coords)
