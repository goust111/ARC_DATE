+
+def _rotate_once(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    arr = np.asarray(cells, dtype=int)
+    h = int(arr[:, 0].max()) + 1
+    rot = np.stack([arr[:, 1], h - 1 - arr[:, 0]], axis=1)
+    return _normalize(tuple(map(tuple, rot)))
