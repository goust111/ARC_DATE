+
+def _slide(cells: set[tuple[int, int]], direction: tuple[int, int], blocked: set[tuple[int, int]], shape: tuple[int, int]) -> tuple[set[tuple[int, int]], int]:
+    h, w = shape
+    dr, dc = direction
+    cur = set(cells)
+    steps = 0
+    while True:
+        nxt = {(r + dr, c + dc) for r, c in cur}
