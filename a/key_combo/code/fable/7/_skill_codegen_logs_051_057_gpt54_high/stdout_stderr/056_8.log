+        return False
+    if int(other_eval["conflicts"]) == 0 and int(other_eval["unknown"]) == 0:
+        return False
+
+    known_maps = [np.asarray(item, dtype=bool) for item in true_eval["known_maps"]]
+    full = np.ones(source_mask.shape, dtype=bool)
+    if any(np.array_equal(known, full) for known in known_maps):
+        return False
+
+    for idx in range(4):
+        others = np.zeros(source_mask.shape, dtype=bool)
+        for jdx, known in enumerate(known_maps):
+            if idx != jdx:
+                others |= known
+        if not np.any(known_maps[idx] & ~others):
+            return False
+
+    source_int = source_mask.astype(int)
+    if not np.array_equal(np.asarray(true_eval["mask"], dtype=int), source_int):
+        return False
+    return True
+
+
+def _assemble_grid(panel: np.ndarray, rng: random.Random, bg: int) -> np.ndarray:
+    side = int(panel.shape[0])
+    total_extra_h = rng.randint(4, min(14, 30 - side))
+    total_extra_w = rng.randint(4, min(14, 30 - side))
+    top = rng.randint(1, total_extra_h - 1)
+    left = rng.randint(1, total_extra_w - 1)
+    bottom = total_extra_h - top
+    right = total_extra_w - left
+    grid = np.full((side + top + bottom, side + left + right), int(bg), dtype=int)
+    grid[top : top + side, left : left + side] = panel
+    return grid
+
+
+def _generate_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    bg = 0
+    q = rng.randint(4, 8)
+    structure_name = rng.choice(list(STRUCTURES))
+    colors = rng.sample([1, 2, 3, 4, 6, 7, 8, 9], 4)
+    source_mask = _make_source_mask(q, rng)
+    expected = np.full((q, q), bg, dtype=int)
+    expected[source_mask] = int(colors[0])
+
+    for _ in range(500):
+        hides_source = _structured_hides_source(q, rng)
+        hides = [
+            _apply_transform(hide_src.astype(int), transform).astype(bool)
+            for hide_src, transform in zip(hides_source, STRUCTURES[structure_name])
+        ]
+        panel, quadrants = _render_panel(source_mask, structure_name, colors, hides, bg)
+        if any(len(set(map(int, quadrant.ravel())) - {bg, GREY}) != 1 for quadrant in quadrants):
+            continue
+        if not _instance_semantics_ok(source_mask, structure_name, quadrants, colors, bg):
+            continue
+
+        grid = _assemble_grid(panel, rng, bg)
+        panel_box = _bbox(grid != bg)
+        if panel_box is None:
+            continue
+        cropped = _crop(grid, panel_box)
+        if cropped.shape != panel.shape or not np.array_equal(cropped, panel):
+            continue
+        if _get_bg(grid) != bg:
+            continue
+        if not np.array_equal(main(grid), expected):
+            continue
+        return grid, expected
+    raise RuntimeError("failed to generate a valid puzzle instance")
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(300):
+        grid, _expected = _generate_case(rng)
+        return grid
+    raise RuntimeError("failed to generate input")

