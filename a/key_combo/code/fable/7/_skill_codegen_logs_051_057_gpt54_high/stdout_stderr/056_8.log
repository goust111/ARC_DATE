+        status[visible & (quadrant == int(color))] = 1
+        assert not np.any(visible & ~(np.isin(quadrant, [int(bg), int(color)]))), "unexpected visible color inside quadrant"
+
+        back = _apply_transform(status, INVERSE_TRANSFORM[transform])
