+    if transform == "rot270cw":
+        return np.rot90(arr, 1)
+    raise ValueError(f"unknown transform: {transform}")
+
+
+def _split_quadrants(panel: np.ndarray) -> list[np.ndarray]:
+    h, w = panel.shape
+    assert h == w and h % 2 == 0
+    q = h // 2
+    return [
+        panel[:q, :q].copy(),
+        panel[:q, q:].copy(),
