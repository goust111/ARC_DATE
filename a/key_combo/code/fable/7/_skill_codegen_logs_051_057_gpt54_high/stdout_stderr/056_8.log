+    colors: list[int],
+    bg: int,
+) -> bool:
+    true_eval = _evaluate_candidate(quadrants, colors, bg, structure_name)
+    other_name = "rotate" if structure_name == "mirror" else "mirror"
+    other_eval = _evaluate_candidate(quadrants, colors, bg, other_name)
