+        for jdx, known in enumerate(known_maps):
+            if idx != jdx:
+                others |= known
+        if not np.any(known_maps[idx] & ~others):
+            return False
+
+    source_int = source_mask.astype(int)
+    if not np.array_equal(np.asarray(true_eval["mask"], dtype=int), source_int):
+        return False
+    return True
+
+
+def _assemble_grid(panel: np.ndarray, rng: random.Random, bg: int) -> np.ndarray:
+    side = int(panel.shape[0])
+    total_extra_h = rng.randint(4, min(14, 30 - side))
+    total_extra_w = rng.randint(4, min(14, 30 - side))
+    top = rng.randint(1, total_extra_h - 1)
+    left = rng.randint(1, total_extra_w - 1)
+    bottom = total_extra_h - top
