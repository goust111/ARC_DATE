+
+
+def _render_panel(
+    source_mask: np.ndarray,
+    structure_name: str,
+    colors: list[int],
+    hides: list[np.ndarray],
+    bg: int,
+) -> tuple[np.ndarray, list[np.ndarray]]:
+    transformed_masks = [
+        _apply_transform(source_mask.astype(int), transform).astype(bool)
+        for transform in STRUCTURES[structure_name]
+    ]
+    quadrants: list[np.ndarray] = []
