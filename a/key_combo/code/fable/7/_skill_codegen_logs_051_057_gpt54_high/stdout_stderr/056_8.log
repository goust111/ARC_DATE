+    grid = np.full((side + top + bottom, side + left + right), int(bg), dtype=int)
+    grid[top : top + side, left : left + side] = panel
+    return grid
+
+
+def _generate_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    bg = 0
+    q = rng.randint(4, 8)
