+            continue
+        variants = [_apply_transform(mask.astype(int), t) for t in ("fliplr", "flipud", "rot90cw", "rot180", "rot270cw")]
+        if any(np.array_equal(mask, variant.astype(bool)) for variant in variants):
+            continue
+        return mask
+    raise RuntimeError("failed to generate a non-degenerate source mask")
+
+
+def _structured_hides_source(q: int, rng: random.Random) -> list[np.ndarray]:
+    rh = rng.randint(1, q - 1)
+    cw = rng.randint(1, q - 1)
+
+    tl = np.zeros((q, q), dtype=bool)
