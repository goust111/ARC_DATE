+    assert g.ndim == 2 and 0 < g.shape[0] <= 30 and 0 < g.shape[1] <= 30
+    colors = set(map(int, np.unique(g)))
+    assert colors.issubset({BLACK, BLUE, RED, GREY}), "unexpected input colors"
+    return _paint_territories(g)
