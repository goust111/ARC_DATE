+        branches = _branches_from_midpoint(walkable, midpoint)
+        if len(branches) < 3:
+            continue
+        spare_ok = False
+        if require_spare_branch:
+            spare_ok = any(max(branch) >= 2 for branch in branches if branch)
+        candidates = []
+        for i in range(len(branches)):
+            for j in range(i + 1, len(branches)):
