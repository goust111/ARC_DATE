+    out = main(grid)
+    walkable = grid != GREY
+    red_seed = _seed_position(grid, RED)
+    blue_seed = _seed_position(grid, BLUE)
+    red_dist = _bfs_distances(walkable, red_seed)
+    blue_dist = _bfs_distances(walkable, blue_seed)
