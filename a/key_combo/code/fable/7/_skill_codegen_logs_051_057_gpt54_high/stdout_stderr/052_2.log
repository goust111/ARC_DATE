+    start = cells[rng.randrange(len(cells))]
+    stack = [start]
+    visited = {start}
+    grid[start] = BLACK
+
+    while stack:
+        r, c = stack[-1]
+        options = []
+        for dr, dc in ((-2, 0), (2, 0), (0, -2), (0, 2)):
+            nr, nc = r + dr, c + dc
+            if 1 <= nr < h - 1 and 1 <= nc < w - 1 and (nr, nc) not in visited:
+                options.append((nr, nc, r + dr // 2, c + dc // 2))
+        if not options:
+            stack.pop()
+            continue
+        nr, nc, wr, wc = options[rng.randrange(len(options))]
+        grid[wr, wc] = BLACK
+        grid[nr, nc] = BLACK
+        visited.add((nr, nc))
+        stack.append((nr, nc))
