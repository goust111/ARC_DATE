+    blue_seed = _seed_position(grid, BLUE)
+    red_dist = _bfs_distances(walkable, red_seed)
+    blue_dist = _bfs_distances(walkable, blue_seed)
+
+    out = grid.copy()
+    corridor = grid == BLACK
+    for r, c in np.argwhere(corridor):
+        dr = int(red_dist[r, c])
+        db = int(blue_dist[r, c])
+        if dr == -1 and db == -1:
+            continue
+        if dr == db:
+            out[r, c] = YELLOW
+        elif db == -1 or (dr != -1 and dr < db):
