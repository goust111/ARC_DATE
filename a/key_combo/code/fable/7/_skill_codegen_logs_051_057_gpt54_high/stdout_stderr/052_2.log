+    assert _has_shortest_path_counterexample(grid), "maze must defeat direct-distance shortcuts"
+
+
+def _generate_attempt(rng: random.Random, mode: int) -> np.ndarray | None:
+    side_lo, side_hi = GRID_SIDE_RANGE
