+    walkable = maze == BLACK
+    picked = _pick_seed_pair(walkable, rng)
+    if picked is None:
+        return None
+
+    red_seed, blue_seed, _midpoint = picked
+    grid = maze.copy()
+    require_unreachable = mode != 0
+    if require_unreachable and not _add_unreachable_room(grid, rng, preferred_large=(mode == 2)):
+        return None
+
+    grid[red_seed] = RED
+    grid[blue_seed] = BLUE
+
+    try:
+        _validate_generated_case(grid, require_unreachable=require_unreachable)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    _GEN_CALL_COUNT += 1
+    mode = _GEN_CALL_COUNT % 3
+
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _generate_attempt(rng, mode)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid maze instance")

