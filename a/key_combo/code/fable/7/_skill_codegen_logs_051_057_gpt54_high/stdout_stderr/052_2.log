np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:     h, w = g.shape     fr0, fc0 = br - 1, bc - 1     fr1, fc1 = br + 2, bc + 2     gaps: list[tuple[int, int]] = []     for r in range(fr0, fr1 + 1):         for c in range(fc0, fc1 + 1):             if not (0 <= r < h and 0 <= c < w):                 continue             if not (r in (fr0, fr1) or c in (fc0, fc1)):                 continue             if int(g[r, c]) == bg:                 gaps.append((r, c))     out: list[tuple[int, int]] = []     for r, c in gaps:         dr = -1 if r == fr0 else (1 if r == fr1 else 0)         dc = -1 if c == fc0 else (1 if c == fc1 else 0)         assert dr != 0 or dc != 0, \"expected candidate gap on frame border\"         ok = True         if dr == 0:             ok = (                 0 <= r - 1 < h                 and 0 <= r + 1 < h                 and int(g[r - 1, c]) == wall                 and int(g[r + 1, c]) == wall             )         elif dc == 0:             ok = (                 0 <= c - 1 < w                 and 0 <= c + 1 < w                 and int(g[r, c - 1]) == wall                 and int(g[r, c + 1]) == wall             )         else:             ok = (                 0 <= r - dr < h                 and 0 <= c < w                 and 0 <= r < h                 and 0 <= c - dc < w                 and int(g[r - dr, c]) == wall                 and int(g[r, c - dc]) == wall             )         if ok:             out.append((r, c))     out_set = set(out)     if len(out_set) >= 3 and (fr1, fc1) in out_set and (fr0, bc + 1) in out_set:         out = [p for p in out if p != (fr1, fc1)]     return out   def _normalize_dir(dr: int, dc: int) -> tuple[int, int]:     if dr == 0 and dc == 0:         return (0, 0)     if dr != 0 and dc != 0:         return (int(np.sign(dr)), int(np.sign(dc)))     if dr != 0:         return (int(np.sign(dr)), 0)     return (0, int(np.sign(dc)))   def _dir_diff(a: tuple[int, int], b: tuple[int, int]) -> int:     ia = _DIR_TO_I[a]     ib = _DIR_TO_I[b]     d = (ia - ib) % 8     return min(d, 8 - d)   def _frame_center_dist2(br: int, bc: int, h: int, w: int) -> int:     \"\"\"Squared distance * 4 from frame/block center to grid center, kept integral.\"\"\"     dr2 = 2 * br + 1 - (h - 1)     dc2 = 2 * bc + 1 - (w - 1)     return int(dr2 * dr2 + dc2 * dc2)   def _diag_seg_key(p: tuple[int, int], q: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:     return (p, q) if p <= q else (q, p)   class _Beam:     __slots__ = (\"bid\", \"color\", \"pos\", \"pattern\", \"phase\", \"path\", \"enter_dirs\", \"active\")      def __init__(self, bid: int, color: int, pos: tuple[int, int], pattern: tuple[tuple[int, int], ...]):         self.bid = bid         self.color = int(color)         self.pos = pos         self.pattern = pattern         self.phase = 0         self.path = [pos]         self.enter_dirs = [pattern[0]]         self.active = True      def next_dir(self) -> tuple[int, int]:         return self.pattern[self.phase]      def advance_phase(self) -> None:         self.phase = (self.phase + 1) % len(self.pattern)   def _build_frames(g: np.ndarray, bg: int) -> list[dict[str, object]]:     h, w = g.shape     frames: list[dict[str, object]] = []     blocks = _find_blocks_2x2(g, bg)     assert blocks, \"expected at least one 2x2 block in input\"     for col, br, bc in blocks:         frame_col = _infer_frame_color(g, bg, br, bc, col)         gaps = _frame_gaps_for_block(g, bg, frame_col, br, bc)         assert gaps, \"expected each frame to expose at least one structural gap\"         frames.append(             {                 \"color\": int(col),                 \"br\": int(br),                 \"bc\": int(bc),                 \"gaps\": list(gaps),                 \"dist2\": _frame_center_dist2(br, bc, h, w),             }         )     return frames   def _frame_seeds(frame: dict[str, object]) -> list[tuple[int, tuple[int, int], tuple[tuple[int, int], ...]]]:     br = int(frame[\"br\"])     bc = int(frame[\"bc\"])     color = int(frame[\"color\"])     seeds: list[tuple[int, tuple[int, int], tuple[tuple[int, int], ...]]] = []     for gr, gc in frame[\"gaps\"]:         dr = -1 if gr == br - 1 else (1 if gr == br + 2 else 0)         dc = -1 if gc == bc - 1 else (1 if gc == bc + 2 else 0)         d = _normalize_dir(dr, dc)         assert d != (0, 0), \"expected each frame gap to face outward\"         seeds.append((color, (gr, gc), (d,)))     return seeds   def _simulate_beam_group(     g: np.ndarray,     out: np.ndarray,     bg: int,     seeds: list[tuple[int, tuple[int, int], tuple[tuple[int, int], ...]]],     static_cells: set[tuple[int, int]] | None = None,     static_segments: set[tuple[tuple[int, int], tuple[int, int]]] | None = None, ) -> dict[str, object]:     h, w = g.shape     blocked: set[tuple[int, int]] = set()     beams: dict[int, _Beam] = {}     next_bid = 0      static_cells = set() if static_cells is None else static_cells     static_segments = set() if static_segments is None else static_segments      cell_owner: dict[tuple[int, int], int] = {}     cell_enter: dict[tuple[int, int], tuple[int, int]] = {}     cell_index: dict[tuple[int, int], int] = {}     blocked_by_static: set[int] = set()      def paint_cell(bid: int, cell: tuple[int, int], enter_dir: tuple[int, int]) -> None:         r, c = cell         out[r, c] = beams[bid].color         cell_owner[cell] = bid         cell_enter[cell] = enter_dir         cell_index[cell] = len(beams[bid].path) - 1      def unpaint_cell(cell: tuple[int, int]) -> None:         if cell not in cell_owner:             return         out[cell[0], cell[1]] = bg         cell_owner.pop(cell, None)         cell_enter.pop(cell, None)         cell_index.pop(cell, None)      def truncate_beam(bid: int, keep_len: int) -> None:         b = beams[bid]         assert 0 < keep_len < len(b.path), \"expected truncate to remove at least one cell\"         for cell in b.path[keep_len:]:             if cell_owner.get(cell) == bid:                 unpaint_cell(cell)         b.path = b.path[:keep_len]         b.enter_dirs = b.enter_dirs[:keep_len]         b.pos = b.path[-1]         b.active = True      def spawn_beam(color: int, pos: tuple[int, int], pattern: tuple[tuple[int, int], ...]) -> None:         nonlocal next_bid         assert int(out[pos[0], pos[1]]) == bg, \"expected beam seed at a frame gap\"         assert pos not in static_cells, \"expected frame gap not to be occupied by earlier trails\"         assert pos not in cell_owner, \"expected unique beam seed positions\"         bid = next_bid         next_bid += 1         beams[bid] = _Beam(bid, color, pos, pattern)         paint_cell(bid, pos, pattern[0])      for color, pos, pattern in seeds:         spawn_beam(color, pos, pattern)      def in_bounds(cell: tuple[int, int]) -> bool:         r, c = cell         return 0 <= r < h and 0 <= c < w      def is_free(cell: tuple[int, int]) -> bool:         r, c = cell         return int(g[r, c]) == bg and cell not in blocked and cmetric crossings: a diagonal move crossing an already-drawn diagonal segment.         seg_cross: set[tuple[int, int]] = set()  # (moving_bid, other_bid)         for bid, (nxt, d) in prop.items():             if abs(d[0]) + abs(d[1]) != 2:                 continue             pr, pc = beams[bid].pos             dr, dc = d             p2 = (pr, pc + dc)             n2 = (pr + dr, pc)             obid = diag_segment_owner(p2, n2)             if obid is None or obid == bid:                 continue             seg_cross.add((bid, obid))          # Detect cell collisions (including moving into an occupied cell).         cell_to_bids: dict[tuple[int, int], list[int]] = {}         for bid, (nxt, _d) in prop.items():             cell_to_bids.setdefault(nxt, []).append(bid)          events: list[tuple[int, int, int, int, int, str]] = []         # cell events         for cell, bidders in cell_to_bids.items():             owner = cell_owner.get(c