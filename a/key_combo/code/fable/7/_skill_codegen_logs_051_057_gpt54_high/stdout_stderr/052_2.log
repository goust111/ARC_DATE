+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_SIDE_RANGE = (17, 29)  # odd sizes only, inclusive
+GEN_RETRIES = 300
