+    assert np.any((out == BLUE) & corridor), "expected blue-owned corridor cells"
+    assert np.any((out == YELLOW) & corridor), "expected at least one equidistant corridor cell"
+
+    unreachable = corridor & (red_dist == -1) & (blue_dist == -1)
