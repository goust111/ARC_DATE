 int,                 seeds: list[tuple[tuple[int, int], tuple[int, int]]]) -> bool:     \"\"\"Check that every seed ray travels >= MIN_RAY_STEPS through bg-only cells.\"\"\"     h, w = grid.shape     for (r, c), (dr, dc) in seeds:         steps = 0         nr, nc = r + dr, c + dc         while 0 <= nr < h and 0 <= nc < w:             steps += 1             if int(grid[nr, nc]) != bg:                 return False             nr += dr             nc += dc         if steps < MIN_RAY_STEPS:             return False     return True   def _clear_gap_combos(     obstacles: np.ndarray, bg: int, r0: int, c0: int, ) -> dict[int, list[tuple[tuple[int, int], ...]]]:     \"\"\"For one block at (r0, c0), return {gap_count: [valid_combos]} against obstacle grid.\"\"\"     clear: dict[int, list[tuple[tuple[int, int], ...]]] = {}     for gap_count, combos in _GAP_COMBOS.items():         for combo in combos:             seeds = [((r0 + gr, c0 + gc), _gap_dir((gr, gc))) for gr, gc in combo]             if _rays_clear(obstacles, bg, seeds):                 clear.setdefault(gap_count, []).append(combo)     return clear   def _pick_colors(rng: np.random.Generator, block_count: int) -> tuple[int, int, list[int]]:     \"\"\"Choose bg, frame_color     if ok < 40: sys.exit(1)     \"     ```      如果测试失败，分析错误原因，修改代码，重新测试。反复直到通过。      8. **验证融合行为确实发生**: `main(input)==output` 只能验证求解器不报错，无法验证输入是否真正体现了融合描述中的特征行为——退化为原始行为的输入同样能通过。测试通过后，定义一个量化指标衡量融合核心行为，统计生成样本中该指标的分布。只有当关键控制变量不起作用、样本按融合逻辑执行与按原逻辑执行在相同输入上输出相同结果时，才算退化并需要修正生成器。     9. **审查 `main()` 的新隐式假设**: 修改 `main()` 后，它可能对输入产生原始版本中不存在的新假设（如对象间需特定空间关系、匹配特征需可区分、处理顺序依赖前一步结果等）。逐一检查 `main()` 中的每个循环、匹配和条件分支：这段逻辑对输入做了什么假设？`generate_input()` 是否通过构造保证了这些假设？      ## 参考资源     - `/home/lixinyu/snap/new/solvers/arc_utils.py` — 可用的工具函数     - `/home/lixinyu/snap/new/ARC-data/ARC-AGI-2/data/evaluation/e12f9a14.json` — 原任务的 I/O 样例      ## 输出      将完整的融合变体代码（包含修改后的 `main()` 和 `generate_input()`）保存到:     `/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/47/code.py`  