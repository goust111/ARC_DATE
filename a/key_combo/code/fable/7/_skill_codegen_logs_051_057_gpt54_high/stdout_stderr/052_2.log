+        degrees[(rr, cc)] = sum(1 for nr, nc in _neighbors4(walkable.shape, rr, cc) if walkable[nr, nc])
+    return degrees
+
+
+def _branches_from_midpoint(walkable: np.ndarray, midpoint: tuple[int, int]) -> list[dict[int, list[tuple[int, int]]]]:
+    used = {midpoint}
