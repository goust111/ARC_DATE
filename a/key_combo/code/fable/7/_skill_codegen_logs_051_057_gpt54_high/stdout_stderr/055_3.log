def _gen_frontier_cells(mask: np.ndarray) -> list[tuple[int, int]]:
    h, w = map(int, mask.shape)
    frontier: list[tuple[int, int]] = []
    for r in range(h):
        for c in range(w):
            if mask[r, c]:
                continue
            if (
                (r > 0 and mask[r - 1, c])
                or (r + 1 < h and mask[r + 1, c])
                or (c > 0 and mask[r, c - 1])
                or (c + 1 < w and mask[r, c + 1])
            ):
                frontier.append((r, c))
    return frontier


