+    right_cols: list[int],
+    heights: dict[int, int],
+) -> np.ndarray:
+    grid = np.full((height, width), bg, dtype=int)
+    grid[height - 1, :] = sand_color
+    grid[height - 1, right_cols[0]] = marker_color
