+def _toppled_columns(columns: list[int], heights: dict[int, int], marker_col: int) -> set[int]:
+    start = columns.index(marker_col)
+    toppled = {marker_col}
+    current = start
+    while current + 1 < len(columns):
+        col = columns[current]
+        nxt = columns[current + 1]
+        if heights[col] >= nxt - col:
+            toppled.add(nxt)
+            current += 1
+        else:
