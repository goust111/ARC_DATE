+MIN_HEIGHT = 10
+MAX_HEIGHT = 18
+MIN_WIDTH = 14
+MAX_WIDTH = 30
+MIN_GAP = 2
+MAX_GAP = 5
+MAX_LEFT_PILLARS = 2
+MAX_RIGHT_PILLARS = 5
