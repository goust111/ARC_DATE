+from collections import Counter
+import random
+
+import numpy as np
+
+
+SCENARIOS = (
+    "all",
+    "break",
+    "immediate_break",
+    "overreach_break",
+)
+
+SCENARIO_WEIGHTS = (0.2, 0.3, 0.2, 0.3)
+MAX_GENERATION_ATTEMPTS = 500
