+        variant_path_set = set(variant_trace["path"][1:])
+        variant_lit = {cell for cell in lit | decoy if cell in variant_path_set}
+        if variant_lit == base_lit:
+            return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(12, 24)
