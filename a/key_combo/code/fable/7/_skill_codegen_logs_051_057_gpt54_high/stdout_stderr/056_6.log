+            c1 = c0 + length - 1
+            if c0 < 0 or c1 >= w:
+                continue
+            cells = [(r, cc) for cc in range(c0, c1 + 1)]
+            if _bar_cells_clear(bar_mask, cells, blocked):
+                candidates.append(cells)
