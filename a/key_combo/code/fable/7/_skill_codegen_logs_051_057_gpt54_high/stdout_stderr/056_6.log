+def _trace_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    bar_mask: np.ndarray,
+) -> dict | None:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    path = [(r, c)]
+    collisions: list[tuple[int, int]] = []
+
+    for _ in range(h * w * 2):
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return {"path": path, "collisions": collisions}
+        if bar_mask[nr, nc]:
+            collisions.append((nr, nc))
+            dr = -dr
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(shape, nr, nc):
+                return {"path": path, "collisions": collisions}
+            if bar_mask[nr, nc]:
+                return None
+        r, c = nr, nc
+        path.append((r, c))
+    return None
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
