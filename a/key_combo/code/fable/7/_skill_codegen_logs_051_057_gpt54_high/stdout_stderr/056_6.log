+
+    if not np.array_equal(main(grid), expected):
+        return None
+    if not _semantic_checks(grid, lit, decoy, bars):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
