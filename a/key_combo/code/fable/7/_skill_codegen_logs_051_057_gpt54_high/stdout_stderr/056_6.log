+
+
+def _choose_bar_segment(
+    shape: tuple[int, int],
+    collision: tuple[int, int],
+    bar_mask: np.ndarray,
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    _h, w = shape
+    r, c = collision
+    candidates: list[list[tuple[int, int]]] = []
+    lengths = [3, 4, 5, 6]
