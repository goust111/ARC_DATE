+
+def _build_bars(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    guide: tuple[int, int],
+    direction: tuple[int, int],
+    bounce_count: int,
+) -> tuple[list[list[tuple[int, int]]], dict] | None:
+    bar_mask = np.zeros(shape, dtype=bool)
+    bars: list[list[tuple[int, int]]] = []
+    blocked = {start, guide}
