+    min_decoy_total = max(2, len(bars))
+
+    extra_lit_pool = [
+        cell
+        for cell in true_trace["path"][2:]
+        if cell not in occupied_gray and _basic_gray_candidate(cell, shape, start, guide, full_bar_mask)
