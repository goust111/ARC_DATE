+def _render_scene(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    start_color: int,
+    guide: tuple[int, int],
+    bars: list[list[tuple[int, int]]],
+    lit: set[tuple[int, int]],
+    decoy: set[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full(shape, BLACK, dtype=int)
