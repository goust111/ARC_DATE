+def _bar_cells_clear(bar_mask: np.ndarray, cells: list[tuple[int, int]], blocked: set[tuple[int, int]]) -> bool:
+    h, w = bar_mask.shape
+    for r, c in cells:
+        if (r, c) in blocked or bar_mask[r, c]:
