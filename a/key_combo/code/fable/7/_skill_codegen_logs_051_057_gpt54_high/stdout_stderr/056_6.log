+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+NON_SPECIAL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr != 0 or dc != 0
+    ]
+
+
+def _diag_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r + dr, c + dc) for dr, dc in DIAGONALS]
+
+
+def _chebyshev(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return max(abs(a[0] - b[0]), abs(a[1] - b[1]))
+
+
+def _component_dict(color: int, coords: list[tuple[int, int]]) -> dict:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return {
+        "color": int(color),
+        "coords": np.array(coords, dtype=int),
+        "bbox": (min(rows), min(cols), max(rows), max(cols)),
+        "area": len(coords),
+    }
+
+
+def _find_monochrome_components(grid: np.ndarray, *, excluded: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in excluded:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if not _in_bounds((h, w), nr, nc) or seen[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            comps.append(_component_dict(color, coords))
+    return comps
+
+
+def _trace_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    bar_mask: np.ndarray,
+) -> dict | None:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    path = [(r, c)]
+    collisions: list[tuple[int, int]] = []
+
+    for _ in range(h * w * 2):
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return {"path": path, "collisions": collisions}
+        if bar_mask[nr, nc]:
+            collisions.append((nr, nc))
+            dr = -dr
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(shape, nr, nc):
+                return {"path": path, "collisions": collisions}
+            if bar_mask[nr, nc]:
+                return None
+        r, c = nr, nc
+        path.append((r, c))
+    return None
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
