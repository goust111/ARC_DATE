+
+    out = scene["grid"].copy()
+    out[scene["guide"]] = scene["bg"]
+    for cell in trace["path"][1:]:
+        if cell != scene["guide"] and int(scene["grid"][cell]) == GRAY:
+            out[cell] = scene["start_color"]
