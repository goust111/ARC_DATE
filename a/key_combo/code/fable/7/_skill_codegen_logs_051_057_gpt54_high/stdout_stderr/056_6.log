+        r0, c0, r1, c1 = bar["bbox"]
+        width = c1 - c0 + 1
+        assert r0 == r1, "reflectors must be horizontal bars"
+        assert int(bar["area"]) == width and width >= 2, "reflectors must be solid horizontal bars"
+        for rr, cc in bar["coords"]:
