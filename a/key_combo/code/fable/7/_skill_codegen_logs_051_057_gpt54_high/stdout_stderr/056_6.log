+    extra_lit_count = random.randint(0, 2)
+    lit |= _take_spaced_cells(extra_lit_pool, extra_lit_count, start, guide, occupied_gray)
+    occupied_gray = lit | decoy
+
+    extra_decoy_count = random.randint(0, 2)
+    all_off_path = [
