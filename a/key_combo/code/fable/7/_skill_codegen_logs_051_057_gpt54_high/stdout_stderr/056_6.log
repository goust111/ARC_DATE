+
+def _basic_gray_candidate(
+    cell: tuple[int, int],
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    guide: tuple[int, int],
+    bar_mask: np.ndarray,
+) -> bool:
+    return (
+        _in_bounds(shape, *cell)
+        and not bar_mask[cell]
+        and cell != start
+        and cell != guide
