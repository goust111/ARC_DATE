+
+    expected = grid.copy()
+    expected[guide] = BLACK
+    for cell in lit:
+        expected[cell] = start_color
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    if not _semantic_checks(grid, lit, decoy, bars):
+        return None
+    return grid
