+        if alt_trace is None:
+            return None
+        alt_set = set(alt_trace["path"][1:])
+
+        true_candidates = [
+            cell
+            for cell in true_trace["path"][2:]
+            if cell not in alt_set and _basic_gray_candidate(cell, shape, start, guide, full_bar_mask)
+        ]
+        alt_candidates = [
+            cell
+            for cell in alt_trace["path"][1:]
