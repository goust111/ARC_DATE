+    legend_row[legend_left : legend_left + legend_len] = np.array(legend_colors, dtype=int)
+    grid[-1, :] = legend_row
+
+    expected = np.array([[legend_colors[count - 1]] for count in counts], dtype=int)
+    return grid, expected
+
