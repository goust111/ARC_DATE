+    cuts: list[int] = []
+    col = region_widths[0]
+    cuts.append(col)
+    for idx in range(1, regions - 1):
+        col += 1 + region_widths[idx]
+        cuts.append(col)
+
+    mask = np.zeros((height, width), dtype=bool)
+    for idx, cut in enumerate(cuts):
+        mask[:, cut] = True
+        if idx + 1 == len(cuts):
+            continue
+        next_cut = cuts[idx + 1]
+        row = height - 1 if idx % 2 == 0 else 0
+        c0, c1 = sorted((cut, next_cut))
+        mask[row, c0 : c1 + 1] = True
