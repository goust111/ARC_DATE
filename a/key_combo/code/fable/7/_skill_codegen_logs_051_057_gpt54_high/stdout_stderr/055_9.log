def _quadrant_cells(h: int, w: int, axis_r: int, axis_c: int, quadrant: int) -> list[tuple[int, int]]:
    if quadrant < 2:
        rows = range(0, axis_r)
    else:
        rows = range(axis_r + 1, h)
    if quadrant % 2 == 0:
        cols = range(0, axis_c)
    else:
        cols = range(axis_c + 1, w)
