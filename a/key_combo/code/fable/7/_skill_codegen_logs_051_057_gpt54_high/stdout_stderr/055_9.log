        reflected = ((r, c), (2 * axis_r - r, c), (r, 2 * axis_c - c), (2 * axis_r - r, 2 * axis_c - c))
        for rr, cc in reflected:
            if 0 <= rr < h and 0 <= cc < w:
                if out[rr, cc] not in (BG, color):
