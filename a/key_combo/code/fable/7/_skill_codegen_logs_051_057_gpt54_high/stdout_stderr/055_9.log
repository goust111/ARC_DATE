        c0, c1 = _cols_for_gap(width, gap)
        grid[r, [c0, c1]] = FOREGROUND_COLOR
        if gap == min_gap:
            expected[r, c0 : c1 + 1] = FOREGROUND_COLOR
        else:
            expected[r, [c0, c1]] = FOREGROUND_COLOR
    return grid, expected


