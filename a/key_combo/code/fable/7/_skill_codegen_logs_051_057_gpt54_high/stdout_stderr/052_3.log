+def _split_quadrants(grid: np.ndarray) -> list[np.ndarray]:
+    h, w = grid.shape
+    assert h == w and h % 2 == 0, "expected a 2n x 2n square grid"
+    n = h // 2
+    return [
+        grid[:n, :n].copy(),
+        grid[:n, n:].copy(),
+        grid[n:, :n].copy(),
+        grid[n:, n:].copy(),
+    ]
