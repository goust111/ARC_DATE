                                    padding=PLACEMENT_PADDING,
                                    padding_connectivity=PLACEMENT_PAD_CONNECTIVITY)
    except ValueError:
        return False
    paste(out, patch_out, loc[0], loc[1], transparent=BG)
    paste(inp, patch_in, loc[0], loc[1], transparent=BG)
