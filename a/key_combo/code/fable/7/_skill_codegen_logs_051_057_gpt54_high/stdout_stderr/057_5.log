+_ARC_UTILS_SPEC.loader.exec_module(_ARC_UTILS)
+
+Color = _ARC_UTILS.Color
+get_bg = _ARC_UTILS.get_bg
+in_bounds = _ARC_UTILS.in_bounds
+
+
+BG = Color.BLACK
+RESIDUE = Color.TEAL
+SOURCE = Color.YELLOW
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+GRID_SIDE_RANGE = (13, 26)
+SOURCE_COUNT_WEIGHTS = [(1, 2), (2, 4), (3, 4)]
+MIN_SOURCE_MARGIN = 2
+MIN_SOURCE_CHEB_GAP = 4
+MAX_EXTRA_NOISE = 4
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _ray_coords(shape: tuple[int, int], r: int, c: int, dr: int, dc: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    rr, cc = r + dr, c + dc
+    while in_bounds(shape, rr, cc):
+        out.append((rr, cc))
+        rr += dr
+        cc += dc
+    return out
+
+
+def _beam_cells(shape: tuple[int, int], sources: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for r, c in sources:
+        for dr, dc in DIAGONALS:
+            cells.update(_ray_coords(shape, r, c, dr, dc))
+    return cells
+
+
+def _witness_counts(grid: np.ndarray, r: int, c: int, color: int = RESIDUE) -> tuple[int, int, int, int]:
+    counts: list[int] = []
+    for dr, dc in DIAGONALS:
+        count = 0
+        for rr, cc in _ray_coords(grid.shape, r, c, dr, dc):
+            if int(grid[rr, cc]) == int(color):
+                count += 1
+        counts.append(count)
+    return tuple(counts)  # type: ignore[return-value]
+
+
+def _find_sources(grid: np.ndarray) -> tuple[tuple[int, int], ...]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    sources: list[tuple[int, int]] = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            if int(g[r, c]) != bg:
+                continue
+            if all(count >= 2 for count in _witness_counts(g, r, c)):
+                sources.append((r, c))
+    return tuple(sorted(sources))
+
+
+def _render_output(shape: tuple[int, int], sources: tuple[tuple[int, int], ...]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    for r, c in _beam_cells(shape, sources):
+        out[r, c] = RESIDUE
+    for r, c in sources:
+        out[r, c] = SOURCE
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reconstruct hidden diagonal emitters from cyan residue dots, then redraw their full X-beams.
+
+    Input structure:
+    - The grid has a black background and scattered cyan pixels.
+    - Cyan pixels are a mixture of real diagonal beam residues and same-color noise dots.
+    - True emitter cells themselves are still background and never appear in the input.
+
+    Rule:
+    - Find every background cell whose four diagonal directions each contain at least two cyan pixels aligned on that ray.
+    - Treat each such cell as a hidden emitter, recolor the emitter yellow, and draw cyan diagonals from it to all four grid edges.
+    - Remove every cyan input pixel that does not lie on at least one reconstructed beam.
+
+    Key insight:
+    - The decisive object is absent from the picture: only an empty cell with four-direction double diagonal witness can be the source, and noise is exposed only after those sources are inferred.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = int(get_bg(g))
+    non_bg = set(map(int, np.unique(g))) - {bg}
+    assert non_bg <= {RESIDUE}, "input should contain only cyan foreground residues"
+
+    sources = _find_sources(g)
+    assert sources, "expected at least one hidden emitter"
+
+    out = np.full(g.shape, bg, dtype=int)
+    for r, c in _beam_cells(g.shape, sources):
+        out[r, c] = RESIDUE
+    for r, c in sources:
+        out[r, c] = SOURCE
+    return out
+
+
+def _sample_source_count() -> int:
+    values = [count for count, weight in SOURCE_COUNT_WEIGHTS for _ in range(weight)]
+    return random.choice(values)
+
+
+def _sample_sources(h: int, w: int, n_sources: int) -> list[tuple[int, int]] | None:
+    candidates = [
+        (r, c)
+        for r in range(MIN_SOURCE_MARGIN, h - MIN_SOURCE_MARGIN)
+        for c in range(MIN_SOURCE_MARGIN, w - MIN_SOURCE_MARGIN)
+    ]
+    random.shuffle(candidates)
+
+    chosen: list[tuple[int, int]] = []
+    for r, c in candidates:
+        ok = True
+        for rr, cc in chosen:
+            if max(abs(r - rr), abs(c - cc)) < MIN_SOURCE_CHEB_GAP:
+                ok = False
+                break
+            if (r - c) == (rr - cc) or (r + c) == (rr + cc):
+                ok = False
+                break
+        if ok:
+            chosen.append((r, c))
+            if len(chosen) == n_sources:
+                return sorted(chosen)
+    return None
+
+
+def _sample_residue_subset(shape: tuple[int, int], sources: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    residues: set[tuple[int, int]] = set()
+    per_source_rays: list[list[tuple[int, int]]] = []
+    for r, c in sources:
+        source_cells: list[tuple[int, int]] = []
+        for dr, dc in DIAGONALS:
+            ray = _ray_coords(shape, r, c, dr, dc)
+            assert len(ray) >= 2, "source must have room for two witnesses in each diagonal direction"
+            if len(ray) == 2:
+                keep_count = 2
+            else:
+                upper = len(ray) - 1 if random.random() < 0.8 else len(ray)
+                keep_count = random.randint(2, upper)
+            kept = random.sample(ray, keep_count)
+            residues.update(kept)
+            source_cells.extend(ray)
+        per_source_rays.append(source_cells)
+
+    full_beams = _beam_cells(shape, sources)
+    if residues == full_beams:
+        for cells in per_source_rays:
+            long_cells = [cell for cell in cells if sum(cell in _ray_coords(shape, r, c, dr, dc) for r, c in sources for dr, dc in DIAGONALS) == 1]
+            removable = [cell for cell in long_cells if cell in residues]
+            if removable:
+                residues.remove(random.choice(removable))
+                break
+    return residues
+
+
+def _add_teal(grid: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    for r, c in cells:
+        grid[r, c] = RESIDUE
+
+
+def _try_add_near_miss_decoy(
+    grid: np.ndarray,
+    sources: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+) -> bool:
+    bg_cells = [
+        (r, c)
+        for r in range(grid.shape[0])
+        for c in range(grid.shape[1])
+        if int(grid[r, c]) == BG and (r, c) not in sources
+    ]
+    random.shuffle(bg_cells)
+
+    true_sources = tuple(sorted(sources))
+    occupied = {tuple(map(int, rc)) for rc in np.argwhere(grid == RESIDUE)}
+    forbidden = protected | set(sources)
+
+    for r, c in bg_cells:
+        current_counts = _witness_counts(grid, r, c)
+        if sum(count >= 2 for count in current_counts) >= 3:
+            continue
+
+        available: list[list[tuple[int, int]]] = []
+        for dr, dc in DIAGONALS:
+            ray_available = [
+                cell
+                for cell in _ray_coords(grid.shape, r, c, dr, dc)
+                if cell not in forbidden and cell not in occupied
+            ]
+            available.append(ray_available)
+
+        for weak_idx in range(4):
+            if current_counts[weak_idx] >= 2:
+                continue
+            additions: list[tuple[int, int]] = []
+            ok = True
+            for idx in range(4):
+                if idx == weak_idx:
+                    continue
+                need = max(0, 2 - current_counts[idx])
+                if len(available[idx]) < need:
+                    ok = False
+                    break
+                if need:
+                    additions.extend(random.sample(available[idx], need))
+            if not ok or not additions:
+                continue
+
+            _add_teal(grid, additions)
+            new_counts = _witness_counts(grid, r, c)
+            inferred = _find_sources(grid)
+            if inferred == true_sources and sum(count >= 2 for count in new_counts) == 3:
+                return True
+            for rr, cc in additions:
+                grid[rr, cc] = BG
+
+    return False
+
+
+def _scatter_extra_noise(
+    grid: np.ndarray,
+    sources: list[tuple[int, int]],
+    protected: set[tuple[int, int]],
+) -> None:
+    extra = random.randint(0, MAX_EXTRA_NOISE)
+    if extra == 0:
+        return
+
+    true_sources = tuple(sorted(sources))
+    candidates = [
+        (r, c)
+        for r in range(grid.shape[0])
+        for c in range(grid.shape[1])
+        if int(grid[r, c]) == BG and (r, c) not in protected and (r, c) not in sources
+    ]
+    random.shuffle(candidates)
+
+    placed = 0
+    for r, c in candidates:
+        grid[r, c] = RESIDUE
+        if _find_sources(grid) == true_sources:
+            placed += 1
+            if placed == extra:
+                return
+        else:
+            grid[r, c] = BG
+
+
+def _has_near_miss(grid: np.ndarray, sources: tuple[tuple[int, int], ...]) -> bool:
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            if int(grid[r, c]) != BG or (r, c) in sources:
+                continue
+            if sum(count >= 2 for count in _witness_counts(grid, r, c)) == 3:
+                return True
+    return False
+
+
+def _validate_instance(grid: np.ndarray, sources: list[tuple[int, int]]) -> bool:
+    g = np.asarray(grid, dtype=int)
+    true_sources = tuple(sorted(sources))
+    inferred = _find_sources(g)
+    if inferred != true_sources:
+        return False
+
+    beam_union = _beam_cells(g.shape, true_sources)
+    teal_cells = {tuple(map(int, rc)) for rc in np.argwhere(g == RESIDUE)}
+    if not teal_cells:
+        return False
+
+    noise = teal_cells - beam_union
+    if not noise:
+        return False
+    if beam_union <= teal_cells:
+        return False
+
+    for r, c in true_sources:
+        if int(g[r, c]) != BG:
+            return False
+        if any(count < 2 for count in _witness_counts(g, r, c)):
+            return False
+
+    if not _has_near_miss(g, true_sources):
+        return False
+
+    expected = _render_output(g.shape, true_sources)
+    if not np.array_equal(main(g), expected):
+        return False
+
+    source_count = int(np.sum(expected == SOURCE))
+    if source_count != len(true_sources):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
+    n_sources = _sample_source_count()
+    sources = _sample_sources(h, w, n_sources)
+    if sources is None:
+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    residues = _sample_residue_subset(grid.shape, sources)
+    for r, c in residues:
+        grid[r, c] = RESIDUE
+
+    protected = _beam_cells(grid.shape, sources)
+    if not _try_add_near_miss_decoy(grid, sources, protected):
+        return None
+    _scatter_extra_noise(grid, sources, protected)
+
+    if not _validate_instance(grid, sources):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid hidden-emitter instance")

