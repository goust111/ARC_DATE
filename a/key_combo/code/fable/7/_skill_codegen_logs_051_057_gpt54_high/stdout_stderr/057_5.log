+def _validate_instance(grid: np.ndarray, sources: list[tuple[int, int]]) -> bool:
+    g = np.asarray(grid, dtype=int)
+    true_sources = tuple(sorted(sources))
+    inferred = _find_sources(g)
+    if inferred != true_sources:
+        return False
+
+    beam_union = _beam_cells(g.shape, true_sources)
+    teal_cells = {tuple(map(int, rc)) for rc in np.argwhere(g == RESIDUE)}
+    if not teal_cells:
+        return False
+
+    noise = teal_cells - beam_union
+    if not noise:
+        return False
+    if beam_union <= teal_cells:
+        return False
+
+    for r, c in true_sources:
+        if int(g[r, c]) != BG:
+            return False
+        if any(count < 2 for count in _witness_counts(g, r, c)):
+            return False
+
+    if not _has_near_miss(g, true_sources):
+        return False
+
+    expected = _render_output(g.shape, true_sources)
+    if not np.array_equal(main(g), expected):
+        return False
+
+    source_count = int(np.sum(expected == SOURCE))
+    if source_count != len(true_sources):
+        return False
+    return True
+
