+def _frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                continue
