+    layout = dict(layout)
+    layout["bg"] = int(bg)
+    layout["shape"] = (int(h), int(w))
+    layout["hole1"] = tuple(map(int, hole1))
+    layout["hole2"] = tuple(map(int, hole2))
+    layout["source_side"] = source_side
+    layout["source_mask"] = source_mask
+    return layout
