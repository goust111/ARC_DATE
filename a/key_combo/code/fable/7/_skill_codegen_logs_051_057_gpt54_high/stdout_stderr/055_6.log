+        if len(cols) == 2 and len(rows) == 0:
+            cols = sorted(cols)
+            holes = [(int(np.where(g[:, cols[0]] == bg)[0][0]), cols[0]), (int(np.where(g[:, cols[1]] == bg)[0][0]), cols[1])]
