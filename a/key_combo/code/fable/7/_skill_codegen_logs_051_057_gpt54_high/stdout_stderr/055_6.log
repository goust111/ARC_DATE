+    if patch.shape[0] == patch.shape[1]:
+        variants.extend([np.rot90(patch, 1), np.rot90(patch, 3), patch.T, np.fliplr(patch.T)])
+    return all(not np.array_equal(patch, variant) for variant in variants)
