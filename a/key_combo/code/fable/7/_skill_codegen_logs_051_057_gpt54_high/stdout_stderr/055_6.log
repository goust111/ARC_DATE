+def _random_global_transform(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int)
+    if random.choice([False, True]):
+        out = np.flipud(out)
+    if random.choice([False, True]):
+        out = np.fliplr(out)
+    if random.choice([False, True]):
+        out = out.T
+    return out.copy()
+
+
+def _validate_semantics(inp: np.ndarray, expect_clipped: bool) -> bool:
