+    h1r, h1c = layout["hole1"]
+    h2r, h2c = layout["hole2"]
+
+    first_full: list[tuple[int, int, int]] = []
+    first_visible: list[tuple[int, int, int]] = []
+    second_full: list[tuple[int, int, int]] = []
+
+    for r0, c0 in np.argwhere(source_mask):
+        r = int(r0)
+        c = int(c0)
+        color = int(g[r, c])
