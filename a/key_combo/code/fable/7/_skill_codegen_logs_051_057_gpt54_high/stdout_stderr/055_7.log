+            r0 = random.randrange(h)
+            r1 = random.randrange(r0, h)
+            c0 = random.randrange(w)
+            c1 = random.randrange(c0, w)
+            mask[r0 : r1 + 1, c0 : c1 + 1] = True
+        else:
+            mask[random.randrange(h), random.randrange(w)] = True
