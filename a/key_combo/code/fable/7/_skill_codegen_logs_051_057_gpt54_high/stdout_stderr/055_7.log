+def _sample_distinct_masks(count: int, h: int, w: int) -> list[np.ndarray] | None:
+    masks = []
+    seen = set()
+    for _ in range(200):
+        mask = _random_segment_mask(h, w)
+        area = int(mask.sum())
+        if area == 0 or area == h * w:
+            continue
+        sig = _mask_sig(mask)
+        if sig in seen:
+            continue
+        seen.add(sig)
+        masks.append(mask)
+        if len(masks) == count:
+            return masks
+    return None
