+def _crop(grid: np.ndarray, band_r: tuple[int, int], band_c: tuple[int, int]) -> np.ndarray:
+    r0, r1 = band_r
+    c0, c1 = band_c
+    return grid[r0 : r1 + 1, c0 : c1 + 1]
