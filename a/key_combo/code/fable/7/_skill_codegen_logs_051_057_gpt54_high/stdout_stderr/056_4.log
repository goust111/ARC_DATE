+    def get_bg(grid: np.ndarray) -> int:
+        return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        if not monochromatic or return_format != "dict":
+            raise ValueError("fallback find_components only supports monochromatic dict mode")
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        bg = int(bg)
+        if colors is None:
+            palette = sorted(set(map(int, g.ravel())) - {bg})
+        else:
+            palette = [int(c) for c in colors if int(c) != bg]
+        if connectivity != 4:
+            raise ValueError("fallback find_components only supports 4-connectivity")
+
+        H, W = g.shape
+        seen = np.zeros((H, W), dtype=bool)
+        out: list[dict] = []
+        for color in palette:
+            coords = np.argwhere(g == color)
+            for r, c in coords:
+                rr = int(r)
+                cc = int(c)
+                if seen[rr, cc]:
+                    continue
+                q = deque([(rr, cc)])
+                seen[rr, cc] = True
+                comp: list[tuple[int, int]] = []
+                while q:
+                    cr, cc = q.popleft()
+                    comp.append((cr, cc))
+                    for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                        if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(g[nr, nc]) == color:
+                            seen[nr, nc] = True
+                            q.append((nr, nc))
+                if len(comp) < int(min_area):
+                    continue
+                arr = np.asarray(comp, dtype=int)
+                r0, c0 = arr.min(axis=0)
+                r1, c1 = arr.max(axis=0)
+                out.append(
