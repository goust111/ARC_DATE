def _gen_pair_is_valid(inp: np.ndarray, out: np.ndarray) -> bool:
    wall_fraction = float(np.count_nonzero(inp == _GEN_WALL)) / inp.size
    if not (_GEN_WALL_FRACTION_RANGE[0] <= wall_fraction <= _GEN_WALL_FRACTION_RANGE[1]):
