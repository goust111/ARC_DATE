+        "squares": squares,
+        "gray_coord": gray_coord,
+        "example_ids": example_ids,
+        "source_ids": source_ids,
+        "source_color": source_color,
+        "target_color": target_color,
+        "source_side": source_side,
+        "target_side": target_side,
+    }
