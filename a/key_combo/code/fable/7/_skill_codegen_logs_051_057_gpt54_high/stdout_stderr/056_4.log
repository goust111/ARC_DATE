+def _square_info(comp: dict) -> dict:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    side = int(r1 - r0 + 1)
+    return {
+        "color": int(comp["color"]),
+        "coords": np.asarray(comp["coords"], dtype=int),
+        "bbox": (r0, c0, r1, c1),
+        "side": side,
+        "center": ((r0 + r1) // 2, (c0 + c1) // 2),
