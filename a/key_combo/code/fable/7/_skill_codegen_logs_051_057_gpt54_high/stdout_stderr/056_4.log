+def _expected_output(
+    rows: int,
+    cols: int,
+    bg: int,
+    target_color: int,
+    target_side: int,
+    source_centers: list[tuple[int, int]],
+    distractors: list[tuple[int, tuple[int, int, int, int]]],
+) -> np.ndarray:
