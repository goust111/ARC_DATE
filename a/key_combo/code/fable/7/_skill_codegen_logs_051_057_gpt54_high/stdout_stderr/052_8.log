+    max_w = max(p["input"].shape[1] for p in patches)
+    grid_h = rng.randint(max(18, max_h + 6), 30)
+    grid_w = rng.randint(max(18, max_w + 6), 30)
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    placed_boxes: list[tuple[int, int, int, int]] = []
