+    for rr, cc in np.argwhere(interior):
+        vr = r0 + int(rr)
+        vc = c0 + int(cc)
+        val = int(grid[vr, vc])
+        if val != BG:
+            if val == color:
+                return None
+            seed_pixels.append((vr, vc, val))
