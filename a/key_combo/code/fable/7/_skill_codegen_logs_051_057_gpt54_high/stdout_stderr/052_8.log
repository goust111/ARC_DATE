+    if rng.random() < 0.5:
+        arr[:, 1] *= -1
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    return [tuple(map(int, rc)) for rc in arr]
+
+
+def _render_shape(vertices: list[tuple[int, int]], outline_color: int, seed_color: int, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
