+def _wrong_fill_all_aligned(grid: np.ndarray) -> np.ndarray:
+    chambers, wall, _bg, seed_idx = _extract_chambers(grid)
+    out, _lit, _info = _propagate(grid, chambers, wall, seed_idx, all_aligned=True)
+    return out
