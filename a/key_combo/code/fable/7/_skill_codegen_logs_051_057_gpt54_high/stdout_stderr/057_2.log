+MIN_CHAMBER_SIDE = 4
+MAX_CHAMBER_SIDE = 5
+MIN_LINK_GAP = 2
+MAX_LINK_GAP = 4
+MIN_OUTER_MARGIN = 1
+MAX_OUTER_MARGIN = 3
+GENERATION_RETRIES = 500
