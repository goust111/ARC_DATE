+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_ARC_UTILS_DIR))
+
+from arc_utils import Color, find_components, get_bg, in_bounds, paste
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_TO_SIDE = {v: k for k, v in SIDE_TO_DIR.items()}
+WALL_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.GREY, Color.ORANGE, Color.TEAL, Color.MAROON]
