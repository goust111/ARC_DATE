+def _wall_color(grid: np.ndarray, bg: int) -> int:
+    colors = sorted(set(map(int, np.unique(grid))) - {int(bg)})
+    wall_colors = [color for color in colors if color != Color.YELLOW]
+    assert len(wall_colors) == 1, "expected exactly one wall color"
+    return int(wall_colors[0])
+
+
+def _extract_chambers(grid: np.ndarray) -> tuple[list[Chamber], int, int, int]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    wall = _wall_color(g, bg)
+    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[wall])
+    assert components, "expected wall components"
+
+    chambers: list[Chamber] = []
+    seed_indices: list[int] = []
+    for idx, comp in enumerate(components):
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        assert r1 - r0 + 1 >= MIN_CHAMBER_SIDE
+        assert c1 - c0 + 1 >= MIN_CHAMBER_SIDE
+        assert g[r0, c0] == wall and g[r0, c1] == wall and g[r1, c0] == wall and g[r1, c1] == wall
+
+        openings: list[Opening] = []
+        for c in range(c0 + 1, c1):
+            if int(g[r0, c]) != wall:
+                openings.append(Opening((r0, c), SIDE_TO_DIR["top"], "top"))
+            if int(g[r1, c]) != wall:
+                openings.append(Opening((r1, c), SIDE_TO_DIR["bottom"], "bottom"))
+        for r in range(r0 + 1, r1):
+            if int(g[r, c0]) != wall:
+                openings.append(Opening((r, c0), SIDE_TO_DIR["left"], "left"))
+            if int(g[r, c1]) != wall:
+                openings.append(Opening((r, c1), SIDE_TO_DIR["right"], "right"))
+
+        assert len(openings) == 2, "each chamber must have exactly two single-cell openings"
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        assert interior.size > 0
+        seed = bool((interior == Color.YELLOW).any())
+        if seed:
+            assert np.all(interior == Color.YELLOW), "seed chamber interior must be fully yellow"
+            seed_indices.append(idx)
+        else:
+            assert np.all(interior == bg), "unlit chamber interior must be empty"
+        chambers.append(Chamber(bbox=(r0, c0, r1, c1), openings=(openings[0], openings[1]), seed=seed))
