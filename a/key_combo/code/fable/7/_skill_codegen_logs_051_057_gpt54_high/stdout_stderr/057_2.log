+    seed_targets = [graph[(seed_idx, 0)], graph[(seed_idx, 1)]]
+    assert seed_targets[0] is not None and seed_targets[1] is not None
+    assert seed_targets[0][0] != seed_targets[1][0], "seed must launch along two distinct branches"
