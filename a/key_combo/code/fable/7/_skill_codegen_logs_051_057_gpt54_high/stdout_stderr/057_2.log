+    for ch_idx, chamber in enumerate(chambers):
+        for op_idx, opening in enumerate(chamber.openings):
+            assert opening.pos not in mapping, "openings must be unique grid cells"
+            mapping[opening.pos] = (ch_idx, op_idx)
