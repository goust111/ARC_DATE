+
+def _render_spec(spec: ChamberSpec, wall_color: int, bg: int) -> np.ndarray:
+    patch = np.full((spec.h, spec.w), bg, dtype=int)
+    patch[0, :] = wall_color
+    patch[-1, :] = wall_color
