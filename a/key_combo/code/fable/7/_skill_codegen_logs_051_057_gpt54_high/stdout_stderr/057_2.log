+            return None
+        if int(grid[nr, nc]) == wall:
+            return None
+        r, c = nr, nc
+        out[r, c] = Color.YELLOW
+        hit = mapping.get((r, c))
+        if hit is None or hit[0] == chamber_idx:
+            continue
+        target = chambers[hit[0]].openings[hit[1]]
+        if (dr, dc) == _opposite(target.direction):
+            return hit
