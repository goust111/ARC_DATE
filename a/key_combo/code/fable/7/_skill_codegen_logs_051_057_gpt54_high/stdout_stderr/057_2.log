+DIR_TO_SIDE = {v: k for k, v in SIDE_TO_DIR.items()}
+WALL_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.GREY, Color.ORANGE, Color.TEAL, Color.MAROON]
