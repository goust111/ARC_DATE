+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_TO_SIDE = {v: k for k, v in SIDE_TO_DIR.items()}
+WALL_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.GREY, Color.ORANGE, Color.TEAL, Color.MAROON]
+
+MIN_CHAMBER_SIDE = 4
+MAX_CHAMBER_SIDE = 5
+MIN_LINK_GAP = 2
+MAX_LINK_GAP = 4
+MIN_OUTER_MARGIN = 1
+MAX_OUTER_MARGIN = 3
+GENERATION_RETRIES = 500
+
+
+@dataclass(frozen=True)
+class Opening:
+    pos: tuple[int, int]
+    direction: tuple[int, int]
+    side: str
+
+
+@dataclass(frozen=True)
+class Chamber:
+    bbox: tuple[int, int, int, int]
+    openings: tuple[Opening, Opening]
+    seed: bool
+
+    @property
+    def interior(self) -> tuple[int, int, int, int]:
+        r0, c0, r1, c1 = self.bbox
+        return (r0 + 1, c0 + 1, r1 - 1, c1 - 1)
+
+
+@dataclass
+class ChamberSpec:
+    h: int
+    w: int
