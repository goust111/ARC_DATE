+def _cast_ray(
+    out: np.ndarray,
+    grid: np.ndarray,
+    wall: int,
+    chambers: list[Chamber],
+    mapping: dict[tuple[int, int], tuple[int, int]],
+    chamber_idx: int,
+    opening_idx: int,
+) -> tuple[int, int] | None:
+    r, c = chambers[chamber_idx].openings[opening_idx].pos
+    dr, dc = chambers[chamber_idx].openings[opening_idx].direction
+    out[r, c] = Color.YELLOW
+    while True:
+        nr, nc = r + dr, c + dc
