+
+
+def _cast_ray(
+    out: np.ndarray,
+    grid: np.ndarray,
+    wall: int,
+    chambers: list[Chamber],
+    mapping: dict[tuple[int, int], tuple[int, int]],
+    chamber_idx: int,
+    opening_idx: int,
