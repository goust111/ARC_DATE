+        if _validate_semantics(grid):
+            return grid
+    except (AssertionError, ValueError):
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
