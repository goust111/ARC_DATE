+    a0, a1 = map(int, span)
+    b0, b1 = map(int, other)
+    return a0 < b0 or a1 > b1
+
+
+def _semantic_ok(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    color_a: int,
+    color_b: int,
+    row_a: tuple[int, int],
+    col_a: tuple[int, int],
+    row_b: tuple[int, int],
+    col_b: tuple[int, int],
+) -> bool:
+    if not np.array_equal(main(inp), expected):
+        return False
+
+    bottom = inp[-1, :-1]
+    right = inp[:-1, -1]
