            labels[:, c] = 1
        elif mode == "bottom":
            c = int(np.random.randint(width))
            labels[RECT_HEIGHT - 1, :] = 1
            labels[:, c] = 1
        elif mode == "left":
            r = int(np.random.randint(RECT_HEIGHT))
            labels[:, 0] = 1
            labels[r, :] = 1
        else:
