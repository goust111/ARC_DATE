+
+    mask_a = np.zeros((h, w), dtype=bool)
+    mask_b = np.zeros((h, w), dtype=bool)
+    mask_a[row_a[0] : row_a[1] + 1, col_a[0] : col_a[1] + 1] = True
+    mask_b[row_b[0] : row_b[1] + 1, col_b[0] : col_b[1] + 1] = True
