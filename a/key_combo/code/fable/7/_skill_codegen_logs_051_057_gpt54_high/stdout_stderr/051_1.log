+ACTUAL_COLORS = [1, 2, 4, 5, 6, 7, 8, 9]
+GEN_RETRY_LIMIT = 300
+INTERIOR_SIZE_RANGE = (6, 19)
+
+MODE_PARTIAL = "partial"
+MODE_A_CONTAINS_B = "a_contains_b"
+MODE_B_CONTAINS_A = "b_contains_a"
+MODE_EQUAL = "equal"
+MODES = [MODE_PARTIAL, MODE_A_CONTAINS_B, MODE_B_CONTAINS_A, MODE_EQUAL]
