+    out[:-1, :-1][mask_b] = color_b
+    out[:-1, :-1][mask_a & mask_b] = GREEN
+    return inp, out
+
+
+def _has_direct_visibility(span: tuple[int, int], other: tuple[int, int]) -> bool:
+    a0, a1 = map(int, span)
+    b0, b1 = map(int, other)
+    return a0 < b0 or a1 > b1
+
+
+def _semantic_ok(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    color_a: int,
+    color_b: int,
