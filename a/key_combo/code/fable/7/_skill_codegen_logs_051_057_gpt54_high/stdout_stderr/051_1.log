+        a1 = _randint_inclusive(a0 + 2, n - 1)
+        b0 = _randint_inclusive(a0 + 1, a1 - 1)
+        b1 = _randint_inclusive(b0, a1 - 1)
+        return (a0, a1), (b0, b1)
