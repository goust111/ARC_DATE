+def _monotone_key(start: tuple[int, int], row_step: int, col_step: int, cell: tuple[int, int]) -> tuple[int, int]:
+    r, c = cell
+    rr = 0 if row_step == 0 else row_step * (r - start[0])
+    cc = 0 if col_step == 0 else col_step * (c - start[1])
