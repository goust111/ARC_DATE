+def _interior_open_cells(bounds: tuple[int, int, int, int], corridor: np.ndarray, object_mask: np.ndarray) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bounds
+    cells = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if corridor[r, c] or object_mask[r, c]:
+                continue
+            cells.append((r, c))
+    return cells
