+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        info = _analyze_instance(grid)
+        out = main(grid)
+    except Exception:
+        return False
+
+    if out.shape != grid.shape:
+        return False
+
+    votes = info["votes"]
+    ranked = votes.most_common()
+    if not ranked or (len(ranked) > 1 and ranked[0][1] == ranked[1][1]):
+        return False
