+    cols = random.randint(*SIZE_RANGE)
+    case_type = random.choice(CASE_TYPES)
+
+    colors = random.sample(COLOR_POOL, 6)
+    bg, frame_color, marker_color, winner_color, runner_color, global_color = colors
