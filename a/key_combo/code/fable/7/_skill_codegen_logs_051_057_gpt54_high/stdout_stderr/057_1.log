+        elif case_type == "horiz":
+            if cols < 13:
+                continue
+            row = random.randint(2, rows - 3)
+            c1 = random.randint(4, cols - 13)
+            c2 = random.randint(c1 + 8, cols - 5)
+            ext_a, ext_b = (row, c1), (row, c2)
+            center_a = (row, c1 - 2)
+            center_b = (row, c2 + 2)
+            return [center_a, center_b], [(0, 1), (0, -1)]
+        else:
