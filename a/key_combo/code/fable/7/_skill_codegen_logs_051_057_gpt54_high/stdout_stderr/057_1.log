+    candidate_colors = []
+    for color, items in by_color.items():
+        if len(items) != 2:
+            continue
+        if all(int(comp["area"]) == 7 and bbox_h(comp["bbox"]) == 3 and bbox_w(comp["bbox"]) == 3 for comp in items):
+            candidate_colors.append(color)
