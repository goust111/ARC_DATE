+            if (key_a[0] - key_b[0]) * (key_a[1] - key_b[1]) < 0:
+                return cell_a, cell_b
+    return None
+
+
+def _paint_dust(grid: np.ndarray, color: int, cells: list[tuple[int, int]]) -> None:
+    for r, c in cells:
+        grid[r, c] = color
