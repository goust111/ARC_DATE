+        if _cells_form_single_monotone_path(start, end, winner_cells):
+            return False
+        object_mask = np.zeros(grid.shape, dtype=bool)
+        for doorway in info["doorways"]:
+            r0, c0, r1, c1 = doorway["bbox"] if "bbox" in doorway else (0, 0, -1, -1)
+            if r1 >= r0:
+                object_mask[r0 : r1 + 1, c0 : c1 + 1] |= False
