+        for rr, cc in [(r, c), *list(neighbors4(r, c))]:
+            if in_bounds(grid_shape, rr, cc) and (rr, cc) in blocked:
+                touches_object = True
+                break
+        if not touches_object:
+            out.append((r, c))
