+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+COLOR_POOL = list(range(10))
+GEN_RETRIES = 400
+SIZE_RANGE = (16, 26)
+CASE_TYPES = ("diag", "diag", "horiz", "vert")
+
+
+def _sign(value: int) -> int:
+    if value > 0:
+        return 1
+    if value < 0:
+        return -1
+    return 0
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
