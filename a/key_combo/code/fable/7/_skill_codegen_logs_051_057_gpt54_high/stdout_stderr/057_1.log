+            r1 = random.randint(4, rows - 13)
+            r2 = random.randint(r1 + 8, rows - 5)
+            ext_a, ext_b = (r1, col), (r2, col)
+            center_a = (r1 - 2, col)
+            center_b = (r2 + 2, col)
+            return [center_a, center_b], [(1, 0), (-1, 0)]
