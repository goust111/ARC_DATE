+    return {
+        "bg": bg,
+        "frame_color": frame_color,
+        "doorways": doorways,
+        "marker_cells": marker_cells,
+        "corridor": corridor,
+        "start": start,
+        "end": end,
+        "bounds": bounds,
+        "dust": dust,
+        "votes": votes,
