+        marker_mask = np.zeros(grid.shape, dtype=bool)
+        for r, c in info["marker_cells"]:
+            marker_mask[r, c] = True
+        object_mask = frame_mask | marker_mask
+        r0, c0, r1, c1 = info["bounds"]
+        interior_false_voters = 0
+        for r in range(r0, r1 + 1):
