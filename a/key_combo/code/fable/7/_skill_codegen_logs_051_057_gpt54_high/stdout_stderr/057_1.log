+def _place_frame(
+    grid: np.ndarray,
+    center: tuple[int, int],
+    direction: tuple[int, int],
+    frame_color: int,
+    marker_color: int,
+) -> dict:
+    r, c = center
+    dr, dc = direction
+    gap = (r + dr, c + dc)
+    exterior = (r + 2 * dr, c + 2 * dc)
