+def _reachable(
+    passable: np.ndarray,
+    seed: tuple[int, int],
+    moves: list[tuple[int, int]],
+    bounds: tuple[int, int, int, int],
+) -> np.ndarray:
+    r0, c0, r1, c1 = bounds
+
+    def valid(r: int, c: int) -> bool:
+        return r0 <= r <= r1 and c0 <= c <= c1 and bool(passable[r, c])
+
+    assert valid(*seed)
+    seen = np.zeros(passable.shape, dtype=bool)
+    seen[seed] = True
+    q = deque([seed])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in moves:
+            rr, cc = r + dr, c + dc
+            if valid(rr, cc) and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
