+    ranked = votes.most_common()
+    if not ranked or (len(ranked) > 1 and ranked[0][1] == ranked[1][1]):
+        return False
+    winner = ranked[0][0]
+
+    dust = info["dust"]
+    total_counts = Counter(map(int, grid[dust]))
+    if len(total_counts) < 3:
+        return False
+    global_top = total_counts.most_common(1)[0][0]
+    if global_top == winner:
