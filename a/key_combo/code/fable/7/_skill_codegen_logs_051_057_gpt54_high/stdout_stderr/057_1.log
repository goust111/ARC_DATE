+
+def _frame_mask(shape: tuple[int, int], frame_cells: set[tuple[int, int]], marker_cells: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in frame_cells | marker_cells:
+        mask[r, c] = True
+    return mask
