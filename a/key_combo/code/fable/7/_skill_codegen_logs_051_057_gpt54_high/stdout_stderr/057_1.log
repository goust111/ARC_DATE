+
+def _dust_mask(
+    grid: np.ndarray,
+    bg: int,
+    frame_color: int,
+    marker_cells: set[tuple[int, int]],
+) -> np.ndarray:
+    dust = (np.asarray(grid, dtype=int) != int(bg)) & (np.asarray(grid, dtype=int) != int(frame_color))
+    for r, c in marker_cells:
+        dust[r, c] = False
+    return dust
+
