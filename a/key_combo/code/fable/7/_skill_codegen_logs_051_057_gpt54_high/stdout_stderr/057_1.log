+    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "corridor vote winner must be unique"
+    winner = int(ranked[0][0])
+
+    out = g.copy()
+    out[dust] = bg
+    paint_mask = corridor & (g != frame_color)
+    for r, c in marker_cells:
