+    frame_color = info["frame_color"]
+    for r, c in info["marker_cells"]:
+        if out[r, c] != grid[r, c]:
+            return False
+    if not np.array_equal(out[grid == frame_color], grid[grid == frame_color]):
+        return False
+    if np.any(out[dust & (~info["corridor"])] != info["bg"]):
+        return False
+
