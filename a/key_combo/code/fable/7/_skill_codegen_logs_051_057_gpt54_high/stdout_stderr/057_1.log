+def _pick_cells(
+    grid_shape: tuple[int, int],
+    base_candidates: list[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+    chosen: list[tuple[int, int]],
+    count: int,
+) -> list[tuple[int, int]] | None:
