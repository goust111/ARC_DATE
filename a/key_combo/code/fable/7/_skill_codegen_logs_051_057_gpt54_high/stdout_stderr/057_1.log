+def _sample_doors(rows: int, cols: int, case_type: str) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
+    shape = (rows, cols)
+    ext_cells = [(r, c) for r in range(rows) for c in range(cols)]
+    for _ in range(300):
+        if case_type == "diag":
