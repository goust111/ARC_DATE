    out[s, a0:a1] = Color.YELLOW
    out[s - CONTROL_OFFSET, ctrl_c] = Color.YELLOW
    out[s + 1 :, :] = out[:s, :][::-1]

    inp = out.copy()
    full = _rect_coords(range(s + 1, 2 * s + 1), range(w))
