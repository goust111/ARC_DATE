+        for far_height in range(1, 4):
+            target = far_coeff * far_height
+            for (near1, width1), (near2, width2) in near_pairs:
+                coeff1 = _interval_sum(near1, width1)
+                coeff2 = _interval_sum(near2, width2)
+                for h1 in range(1, 5):
+                    for h2 in range(1, 5):
+                        if coeff1 * h1 + coeff2 * h2 != target:
+                            continue
+                        near_side = [
