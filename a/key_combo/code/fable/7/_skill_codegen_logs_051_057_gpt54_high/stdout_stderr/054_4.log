+    return {"bg": bg, "beam_row": beam_row, "center": center, **metrics}
+
+
+def _expected_output(info: dict) -> np.ndarray:
+    left = info["left"]
+    right = info["right"]
+    if left["torque"] == right["torque"]:
+        color = int(Color.GREY)
+    elif left["torque"] > right["torque"]:
