+
+
+def _make_count_area_branch(center: int) -> tuple[list[dict], list[dict]] | None:
+    winner = [
+        {
+            "near": random.randint(max(3, center - 4), center - 1),
+            "width": random.randint(2, min(3, center)),
+            "height": random.randint(2, 3),
