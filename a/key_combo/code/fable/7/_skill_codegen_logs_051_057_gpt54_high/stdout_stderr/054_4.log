H_WIDTH_RANGE = (6, 10)
V_SOURCE_DEPTH_RANGE = (3, 5)
V_HEIGHT_RANGE = (3, 9)
V_TARGET_DEPTH_CAP = 4
TARGET_DEPTH_REDUCTION_RANGE = (0, 1)
CONTROL_OFFSET = 2

# Shape fill, yellow-axis span, and target damage rates.
AXIS_SPAN_MIN_LEN = 2
AXIS_SPAN_MIN_FRAC = 0.60
