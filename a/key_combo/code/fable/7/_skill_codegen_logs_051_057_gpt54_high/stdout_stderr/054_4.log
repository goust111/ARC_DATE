+        return None if result is None else (result[0], result[1], True)
+    if branch == "far_trap":
+        result = _make_far_branch(center)
+        return None if result is None else (result[0], result[1], True)
+    result = _make_tie_branch(center)
+    return None if result is None else (result[0], result[1], False)
