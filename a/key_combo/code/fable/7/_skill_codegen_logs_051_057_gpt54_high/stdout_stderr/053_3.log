+def _parse_signature(grid: np.ndarray) -> list[tuple]:
+    sig = []
+    for box in _find_frames(grid):
+        protrusions = _find_protrusions(grid, box)
+        sig.append(
+            (
+                tuple(box),
+                tuple(sorted((p["side"], int(p["axis"]), int(p["color"]), tuple(p["coord"])) for p in protrusions)),
+            )
+        )
