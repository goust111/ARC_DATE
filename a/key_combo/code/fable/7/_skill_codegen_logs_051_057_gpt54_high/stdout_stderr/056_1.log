    if not _validate_case(inp, expected, anchor_by_color, template):
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp, expected


def _validate_case(
    inp: np.ndarray,
    expected: np.ndarray,
    anchors: dict[int, tuple[int, int]],
    template: np.ndarray,
) -> bool:
    try:
        parsed_template = _parse_template(inp, BG)
        if not np.array_equal(parsed_template, template):
            return False

        line_pairs = _parse_line_pairs(inp, BG)
        if set(line_pairs) != set(anchors):
            return False

        recovered_anchors = {
            color: _anchor_from_invariants(invariants[1], invariants[-1])
            for color, invariants in line_pairs.items()
        }
        if recovered_anchors != anchors:
            return False

        if len(_cross_color_decoys(inp.shape, list(anchors.values()))) < 1:
            return False

        mask = _stamp_mask(template)
        comps = find_components(inp, bg=BG, connectivity=8, monochromatic=True)
        visible_pixels = set()
        for comp in comps:
            color = int(comp["color"])
            if color == GRAY:
                continue
            orientation, invariant = _diag_signature(comp["coords"])
            line = _line_coords(inp.shape, orientation, invariant)
            intersections = set()
            for other_color, other_anchor in anchors.items():
                if other_color == color:
                    intersections.add(other_anchor)
                else:
                    diff = recovered_anchors[color][0] - recovered_anchors[color][1] if False else None
            for r, c in comp["coords"]:
                cell = (int(r), int(c))
                visible_pixels.add(cell)
                if cell in anchors.values():
                    return False
                if expected[cell] != BG:
                    return False

        for color, anchor in anchors.items():
            patch = np.where(mask, int(color), BG)
            region = expected[
                anchor[0] - template.shape[0] // 2 : anchor[0] + template.shape[0] // 2 + 1,
                anchor[1] - template.shape[1] // 2 : anchor[1] + template.shape[1] // 2 + 1,
            ]
            if not np.array_equal(region, patch):
                return False

        if np.any((inp == GRAY) & (expected != BG)):
            return False
        return True
    except Exception:
        return False


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        built = _build_case()
        if built is not None:
            inp, _expected = built
            return inp
    raise RuntimeError("failed to generate valid hidden-intersection stamp input")

