+from arc_utils import Color, bbox, crop_bbox, find_components, is_contiguous, paste
+
+
+GRAY = Color.GREY
+BG = Color.BLACK
+LINE_COLORS = [c for c in Color.NOT_BLACK if c != GRAY]
+
+GRID_RANGE = (18, 30)
+COLOR_COUNT_RANGE = (2, 4)
+TEMPLATE_SIZES = (3, 5)
+TEMPLATE_ATTEMPTS = 200
+GEN_ATTEMPTS = 400
+ANCHOR_ATTEMPTS = 300
+SEGMENT_LEN_RANGE = (2, 5)
+INTERSECTION_GAP = 1
+PLACEMENT_GAP = 1
