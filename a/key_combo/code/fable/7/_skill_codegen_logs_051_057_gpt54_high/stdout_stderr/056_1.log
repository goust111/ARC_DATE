+        remaining = [rc for rc in coords if rc != (center, center)]
+        random.shuffle(remaining)
+        for rc in remaining[: count - 1]:
+            chosen.add(rc)
+        mask = np.zeros((size, size), dtype=int)
+        for r, c in chosen:
