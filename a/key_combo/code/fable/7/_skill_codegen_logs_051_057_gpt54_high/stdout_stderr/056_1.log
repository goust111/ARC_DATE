    r1, c1 = rows.max(), cols.max()
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    assert h == w >= 2, "diagonal segment must have a square bbox with length >= 2"
    area = int(coords.shape[0])
    assert area == h, "diagonal segment must be one pixel thick with no gaps"

