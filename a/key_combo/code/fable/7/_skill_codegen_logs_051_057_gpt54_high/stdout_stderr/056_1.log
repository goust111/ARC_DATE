+
+def _render_output(shape: tuple[int, int], template: np.ndarray, anchors: dict[int, tuple[int, int]], bg: int) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    side = template.shape[0]
+    radius = side // 2
+    mask = _stamp_mask(template)
