96:    out = g.copy()
97:    h, w = g.shape
98:    for r_raw, c_raw in np.argwhere(g == mirror_color):
99:        r = int(r_raw)
100:        c = int(c_raw)
101:        rr, cc = _reflect(axis, g.shape, r, c)
102:        assert 0 <= rr < h and 0 <= cc < w, "reflected pixel must stay inside the grid"
103:        assert int(out[rr, cc]) in {bg, mirror_color}, "reflection cannot overwrite another foreground object"
