+        if cell not in spec["gaps"]:
+            grid[cell] = spec["wall_color"]
+    for markers in spec["markers"].values():
+        for marker in markers:
+            grid[marker] = spec["marker_color"]
+    return grid
+
+
+def _render_output_from_spec(spec: dict) -> np.ndarray:
