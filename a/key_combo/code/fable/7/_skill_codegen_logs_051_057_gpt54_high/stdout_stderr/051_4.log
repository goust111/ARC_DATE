+def _sample_spaced_distances(limit: int, count: int) -> list[int] | None:
+    choices = list(range(2, limit + 1))
+    for _ in range(80):
+        picked = sorted(random.sample(choices, count))
+        if all(picked[i] - picked[i - 1] >= 2 for i in range(1, count)):
+            return picked
+    return None
+
