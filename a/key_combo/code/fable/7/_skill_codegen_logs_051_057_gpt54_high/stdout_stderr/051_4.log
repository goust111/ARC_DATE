+    if out_marker_coords.shape[0] != sum(len(spec["markers"][gap]) for gap in spec["gaps"]):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        spec = _generate_spec()
+        if spec is None:
+            continue
+        grid = _render_input(spec)
+        if _validate_generated_instance(grid, spec):
