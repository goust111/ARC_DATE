+
+    spec = {
+        "bg": bg,
+        "wall_color": wall_color,
+        "marker_color": marker_color,
+        "height": height,
+        "width": width,
+        "rect": rect,
+        "gaps": gaps,
+        "markers": markers,
+        "side_order": tuple(chosen_sides),
+    }
+    return spec
+
