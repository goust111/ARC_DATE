+        if all(picked[i] - picked[i - 1] >= 2 for i in range(1, count)):
+            return picked
+    return None
+
+
+def _marker_coord_for_gap(gap: tuple[int, int], side: str, dist: int) -> tuple[int, int]:
+    r, c = gap
+    if side == "top":
