+    if side == "top" and mr < gr and mc == gc:
+        return True, gr - mr
+    if side == "bottom" and mr > gr and mc == gc:
+        return True, mr - gr
+    if side == "left" and mc < gc and mr == gr:
+        return True, gc - mc
+    if side == "right" and mc > gc and mr == gr:
+        return True, mc - gc
+    return False, -1
