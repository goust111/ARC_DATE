45:def main(grid: np.ndarray) -> np.ndarray:
46:    """
47:    Recover the bottom-to-top stacking order of overlaid rectangular color frames.
48:
49:    Input structure:
50:    - The background is one color, and every foreground color is a one-cell-thick rectangular frame.
51:    - Overlapping frame pixels show only the color of the frame that is highest at that location.
52:
53:    Rule:
54:    - Reconstruct each frame as the border of the bounding box of its visible pixels.
55:    - At every cell covered by multiple reconstructed frames, the visible frame color is above the other frames covering that cell.
56:    - Return the unique bottom-to-top order of frame colors as a single-column grid.
57:
58:    Key insight:
59:    The hidden parts of each frame do not need to be seen directly; the visible pixels reveal the full frame bbox, and overlap cells reveal the layer constraints.
60:    """
61:    g = np.asarray(grid, dtype=int)
62:    bg = int(get_bg(g))
63:    colors = colors_present(g, exclude={bg})
64:    assert colors, "input must contain foreground frames"
65:
66:    frame_masks: dict[int, np.ndarray] = {}
67:    for color in colors:
68:        visible = g == color
69:        b = bbox(visible)
70:        assert b is not None, "each foreground color must be visible"
71:        mask = _frame_mask(g.shape, b)
72:        assert np.all(mask[visible]), "visible pixels must lie on their reconstructed frame border"
73:        frame_masks[color] = mask
74:
75:    edges: set[tuple[int, int]] = set()
76:    h, w = g.shape
77:    for r in range(h):
78:        for c in range(w):
79:            covering = [color for color in colors if frame_masks[color][r, c]]
80:            if len(covering) < 2:
81:                continue
82:            top = int(g[r, c])
83:            assert top in covering, "an overlap cell must show one of the frames covering it"
84:            for color in covering:
85:                if color != top:
86:                    edges.add((color, top))
87:
88:    assert edges, "frames must overlap to determine their order"
89:    order = _unique_layer_order(colors, edges)
90:    return np.array(order, dtype=int).reshape(-1, 1)
