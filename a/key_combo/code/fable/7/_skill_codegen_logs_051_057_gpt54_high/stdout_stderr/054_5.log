+    if len(spans) < 3:
+        return False
+    if len(objects) < 3 or not inherited or not roots:
+        return False
+    if len(colors_used) < 2:
+        return False
+    if not any(int(obj["color"]) != int(obj["direct_base_color"]) for obj in inherited):
