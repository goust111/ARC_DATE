+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _attempt_generate(np.random.default_rng())
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid sample after {MAX_RETRIES} attempts")

