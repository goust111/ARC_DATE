+                for c0 in range(max(0, boundary - 2), min(boundary + 1, width - root["w"] + 1))
+                if c0 <= boundary < c0 + root["w"] - 1 and left_s <= c0 <= left_e
+            ]
+            if not root_starts:
+                continue
+            rng.shuffle(root_starts)
+            for root_left in root_starts:
