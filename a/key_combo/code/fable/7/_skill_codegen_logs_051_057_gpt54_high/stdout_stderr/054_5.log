+def _stamp(mask: np.ndarray, top: int, left: int, grid: np.ndarray, occupied: np.ndarray) -> None:
+    rr, cc = np.nonzero(mask)
+    grid[top + rr, left + cc] = GREY
+    occupied[top + rr, left + cc] = True
