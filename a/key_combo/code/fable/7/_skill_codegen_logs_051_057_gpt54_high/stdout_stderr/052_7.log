+    corners = {
+        "tl": (0, 0),
+        "tr": (0, w - 1),
+        "bl": (h - 1, 0),
+        "br": (h - 1, w - 1),
+    }
+    found = [name for name, (r, c) in corners.items() if int(arena[r, c]) not in (BLACK, GREY)]
+    assert len(found) == 1
