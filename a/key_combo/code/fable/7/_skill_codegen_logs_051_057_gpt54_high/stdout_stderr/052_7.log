+def _source_info(arena: np.ndarray, legend: list[int]) -> tuple[int, int, int, int]:
+    h, w = arena.shape
+    corners = {
+        "tl": (0, 0),
+        "tr": (0, w - 1),
+        "bl": (h - 1, 0),
+        "br": (h - 1, w - 1),
+    }
+    found = []
+    for name, (r, c) in corners.items():
+        color = int(arena[r, c])
+        if color not in (BLACK, GREY):
