+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+CORNER_TO_DIR = {
+    "tl": (1, 1),
+    "tr": (1, -1),
+    "bl": (-1, 1),
