+    assert safe, "generator must produce reachable stop cells after multiple bounces"
+    assert any(
+        int(item["r"]) == int(target_stop["r"]) and int(item["c"]) == int(target_stop["c"])
+        for item in safe
+    ), "chosen stopper must lie on the valid beam path"
+    if expect_cycle:
+        assert any(
+            int(item["r"]) == int(target_stop["r"]) and int(item["c"]) == int(target_stop["c"])
+            for item in cycle
