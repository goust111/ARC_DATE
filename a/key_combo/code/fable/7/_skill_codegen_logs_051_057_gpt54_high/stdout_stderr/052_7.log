+        steps_since_bounce += 1
+        path.append(
+            {
+                "r": int(nr),
+                "c": int(nc),
+                "bounce_count": int(bounce_count),
+                "color_idx": int(color_idx),
+                "segment_step": int(steps_since_bounce),
