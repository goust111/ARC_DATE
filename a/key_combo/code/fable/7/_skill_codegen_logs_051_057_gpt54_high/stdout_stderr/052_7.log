+    arena[sr, sc] = 1
+    r, c = sr, sc
+    dr, dc = CORNER_TO_DIR[source_corner]
+    color_idx = 0
+    bounce_count = 0
+    steps_since_bounce = 0
+    seen = {(r, c, dr, dc)}
+    path = []
+
+    while True:
+        nr = r + dr
+        nc = c + dc
+        bounced = False
+        if nr < 0 or nr >= h:
+            dr *= -1
+            bounced = True
+        if nc < 0 or nc >= w:
+            dc *= -1
+            bounced = True
+        if bounced:
+            bounce_count += 1
+            color_idx = (color_idx + 1) % legend_len
+            steps_since_bounce = 0
+            nr = r + dr
+            nc = c + dc
+
+        if (nr in (0, h - 1)) and (nc in (0, w - 1)) and (nr, nc) != (sr, sc):
+            # Avoid corner impacts in generated tasks; they complicate bounce counting.
+            break
