+def _trace_beam(
+    arena: np.ndarray,
+    legend: list[int],
+) -> tuple[np.ndarray, list[dict[str, int]]]:
+    h, w = arena.shape
+    out = arena.copy()
+    r, c, dr, dc = _source_info(arena, legend)
+    color_idx = 0
+    steps_since_bounce = 0
+    visited_states = {(r, c, dr, dc, color_idx)}
+    events: list[dict[str, int]] = []
+
+    while True:
+        nr = r + dr
+        nc = c + dc
+        bounced = False
+        if nr < 0 or nr >= h:
+            dr *= -1
+            bounced = True
+        if nc < 0 or nc >= w:
+            dc *= -1
+            bounced = True
+        if bounced:
