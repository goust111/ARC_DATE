+def _build_path(start: tuple[int, int], end: tuple[int, int], ih: int, iw: int, rng: random.Random) -> list[tuple[int, int]]:
+    candidates = []
+    candidates.append([start, (start[0], end[1]), end])
+    candidates.append([start, (end[0], start[1]), end])
