+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+WIRE_COLORS = [1, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 500
+
+
+# Minimal helpers adapted from arc_utils's canonical (r, c), bbox, crop, and component APIs.
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        step = 1 if bc >= ac else -1
+        return [(ar, c) for c in range(ac, bc + step, step)]
+    if ac == bc:
+        step = 1 if br >= ar else -1
+        return [(r, ac) for r in range(ar, br + step, step)]
+    raise ValueError("segments must be axis-aligned")
+
+
+def _path_from_points(points: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    path: list[tuple[int, int]] = []
+    for i in range(len(points) - 1):
+        seg = _segment_cells(points[i], points[i + 1])
+        if not path:
+            path.extend(seg)
+        else:
+            path.extend(seg[1:])
+    if len(set(path)) != len(path):
+        return None
+    return path
+
+
+def _connected(mask: np.ndarray, start: tuple[int, int], goal: tuple[int, int]) -> bool:
+    if not mask[start] or not mask[goal]:
+        return False
+    h, w = mask.shape
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        if (r, c) == goal:
+            return True
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return False
+
