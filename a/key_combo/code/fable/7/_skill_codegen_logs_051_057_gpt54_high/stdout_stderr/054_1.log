+BLACK = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+N8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
