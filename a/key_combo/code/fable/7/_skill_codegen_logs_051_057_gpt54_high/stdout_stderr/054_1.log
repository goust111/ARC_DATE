+    )
+    out = g.copy()
+    out[(out != BLACK) & (out != GREY)] = BLACK
+
+    settled: dict[tuple[int, int], int] = {}
+    traces = []
+    for item in order:
+        r, c = item["pos"]
+        touched: list[int] = []
+
+        while True:
+            below = (r + 1, c)
+            slope_id = cell_to_segment.get(below) if enable_slopes and r + 1 < h else None
+            if slope_id is not None:
