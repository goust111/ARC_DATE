+        direction = int(deltas[0])
+        top = (int(rows[0]), int(cols[0]))
+        slope = {
+            "id": len(slopes),
+            "coords": {tuple(map(int, rc)) for rc in order.tolist()},
+            "top": top,
+            "length": int(len(coords)),
+            "dir": direction,
+        }
