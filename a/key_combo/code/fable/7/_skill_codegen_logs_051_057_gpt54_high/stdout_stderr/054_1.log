        out = np.flipud(out).copy()
    return inp, out


def _gen_vertical_object(fg):
    s = random.randint(*V_SOURCE_DEPTH_RANGE)
    t = _gen_target_depth(s, cap=V_TARGET_DEPTH_CAP)
    h = random.randint(*V_HEIGHT_RANGE)
