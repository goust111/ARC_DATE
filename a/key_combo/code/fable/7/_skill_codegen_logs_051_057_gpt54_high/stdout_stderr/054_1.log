+
+
+def _place_chain(
+    h: int,
+    w: int,
+    n_chain: int,
+) -> tuple[list[dict], int] | None:
+    lengths = [random.randint(2, 4) for _ in range(n_chain)]
+    first_dir = random.choice([-1, 1])
