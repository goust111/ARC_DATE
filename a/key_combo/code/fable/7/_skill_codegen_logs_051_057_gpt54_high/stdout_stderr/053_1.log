    return masks


def _gen_sample_targets(masks: np.ndarray, allowed: np.ndarray, out: np.ndarray) -> list[int] | None:
    """Sample final foreground counts for panels that still need filling."""
    targets = [0, int(masks[_GREEN_PANEL].sum()), 0, 0]
