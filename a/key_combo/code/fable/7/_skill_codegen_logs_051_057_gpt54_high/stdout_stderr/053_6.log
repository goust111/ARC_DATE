HEIGHT_THREE_WEIGHTS = (1.0, 0.35)
COLOR_ALTERNATION_PERIOD, FOREGROUND_COLORS = 2, [int(Color.BLUE), int(Color.TEAL)]
# Validation and transform constants.
BACKGROUND_COLOR, RECOLOR_COLOR = int(Color.BLACK), int(Color.RED)
