        area_window = best_area[r0 : r1 + 1, c0 : c1 + 1]
        mask = area < area_window
        area_window[mask] = area
        owner_window = owner[r0 : r1 + 1, c0 : c1 + 1]
        owner_window[mask] = int(color)
    return cover_count, owner


