+    return False
+
+
+def _build_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    inner_h = random.randint(*_GEN_INNER_H_RANGE)
+    inner_w = random.randint(*_GEN_INNER_W_RANGE)
