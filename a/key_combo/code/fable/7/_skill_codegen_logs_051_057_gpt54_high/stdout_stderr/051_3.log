+    grid_h = random.randint(max(inner_h + 8, 18), _GEN_GRID_H_RANGE[1])
+    grid_w = random.randint(max(inner_w + 8, 18), _GEN_GRID_W_RANGE[1])
+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+    if grid_h <= frame_h + 3 or grid_w <= frame_w + 3:
+        return None
+
+    frame_top = random.randint(2, grid_h - frame_h - 2)
