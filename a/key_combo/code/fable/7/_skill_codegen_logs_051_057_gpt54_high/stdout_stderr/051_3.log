+    selected = {start}
+    frontier: set[Coord] = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in selected:
+                frontier.add((nr, nc))
