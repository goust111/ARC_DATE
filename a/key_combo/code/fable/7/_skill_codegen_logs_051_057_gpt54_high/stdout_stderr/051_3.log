+        if require_ambiguous and len(dims) < 2:
+            continue
+        if not require_ambiguous and len(dims) != 1:
+            continue
+        return _coords_to_mask(a_coords), _coords_to_mask(b_coords), dims
+    return None
+
+
+def _split_rectangles(height: int, width: int, count: int) -> list[tuple[int, int, int, int]] | None:
+    rects = [(0, 0, height, width)]  # r, c, h, w
+    while len(rects) < count:
