+    for comp in comps:
+        color = int(comp["color"])
+        assert color != frame_color
+        cr0, cc0, cr1, cc1 = comp["bbox"]
+        assert cr1 < r0 or cr0 > r1 or cc1 < c0 or cc0 > c1, "fragments must stay outside the frame"
