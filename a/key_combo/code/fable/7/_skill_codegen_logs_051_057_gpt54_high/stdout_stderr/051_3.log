+            return None
+        if not _place_patch(inp, blocked, patch_b, color, frame_bbox):
+            return None
+
+    if len([comp for comp in _find_components(inp, bg) if _is_hollow_frame(comp, inp, bg)]) != 1:
+        return None
+
+    produced = main(inp)
