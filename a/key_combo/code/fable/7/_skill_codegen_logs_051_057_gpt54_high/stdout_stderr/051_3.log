+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(map(int, coords[0]))}
+    stack = [tuple(map(int, coords[0]))]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _is_full_bbox(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].all()
+
+
+def _random_connected_subset(h: int, w: int, size: int) -> np.ndarray:
+    start = (random.randrange(h), random.randrange(w))
+    selected = {start}
+    frontier: set[Coord] = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in selected:
+                frontier.add((nr, nc))
+
+    add_frontier(*start)
+    while len(selected) < size:
+        if not frontier:
+            raise ValueError("frontier exhausted")
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        selected.add(cell)
+        add_frontier(*cell)
