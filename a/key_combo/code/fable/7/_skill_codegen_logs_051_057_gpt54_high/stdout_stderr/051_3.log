+    solutions = _solve_unique_tiling(inner_h, inner_w, candidate_dims)
+    if len(solutions) != 1 or not np.array_equal(solutions[0], true_board):
+        return None
+    if not _critical_ambiguity((inner_h, inner_w), candidate_dims, true_board):
+        return None
+
+    grid_h = random.randint(max(inner_h + 8, 18), _GEN_GRID_H_RANGE[1])
+    grid_w = random.randint(max(inner_w + 8, 18), _GEN_GRID_W_RANGE[1])
+    frame_h = inner_h + 2
