from functools import lru_cache

# candidate dim families
size_to_dims={}
for sv in range(1,5):
  for sh in range(1,5):
    size_to_dims[(2*sv,6*sh)]={(2*sv,6*sh),(3*sv,4*sh)}
    size_to_dims[(3*sv,4*sh)]={(3*sv,4*sh),(2*sv,6*sh)}
