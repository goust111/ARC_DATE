+        true_dim = tuple(map(int, np.argwhere(true_board == color).ptp(axis=0) + 1))
+        alt_dims = set(dims) - {true_dim}
+        if not alt_dims:
+            continue
+        forced = {k: (alt_dims if k == color else v) for k, v in candidate_dims.items()}
+        if len(_solve_unique_tiling(inner_shape[0], inner_shape[1], forced, limit=1)) == 0:
+            return True
+    return False
