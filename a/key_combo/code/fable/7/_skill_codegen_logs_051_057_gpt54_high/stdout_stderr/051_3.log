+
+    def placements(mask_cells: np.ndarray, rect_h: int, rect_w: int, mask_shape: tuple[int, int]) -> list[frozenset[int]]:
+        mask_h, mask_w = mask_shape
+        if mask_h > rect_h or mask_w > rect_w:
