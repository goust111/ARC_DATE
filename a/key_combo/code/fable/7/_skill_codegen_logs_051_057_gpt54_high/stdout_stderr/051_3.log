        # true dim from board
        coords=[(r,c) for r,row in enumerate(board) for c,val in enumerate(row) if val==color]
        rs=[r for r,c in coords]; cs=[c for r,c in coords]
        true_dim=(max(rs)-min(rs)+1,max(cs)-min(cs)+1)
        alt=dims-{true_dim}
        if not alt: continue
        forced={k:(alt if k==color else v) for k,v in cands.items()}
        count2,_=solve(H,W,forced)
        if count2==0:
          ok=True; break
      if ok:
        print('"'FOUND',trial,'frame',(H,W),'combo',combo)
        for row in board: print(row)
        print(cands)
        raise SystemExit
print('none')
