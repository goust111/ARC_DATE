+        grid[rows, cols] = int(color)
+        blocked |= padded
+        return True
+    return False
+
+
+def _critical_ambiguity(
+    inner_shape: tuple[int, int],
+    candidate_dims: dict[int, set[tuple[int, int]]],
+    true_board: np.ndarray,
+) -> bool:
+    for color, dims in candidate_dims.items():
