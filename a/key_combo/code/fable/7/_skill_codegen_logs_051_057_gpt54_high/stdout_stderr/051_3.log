+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]  # (r0, c0, r1, c1), inclusive
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, grid.flatten()))
+    if exclude:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_coords(coords: np.ndarray) -> np.ndarray:
+    r0, c0, _r1, _c1 = _bbox_coords(coords)
+    return coords - np.array([[r0, c0]], dtype=int)
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    shifted = coords - np.array([[r0, c0]], dtype=int)
+    mask[shifted[:, 0], shifted[:, 1]] = True
+    return mask
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_coords(coords),
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _is_hollow_frame(comp: dict, grid: np.ndarray, bg: int) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    shifted = comp["coords"] - np.array([[r0, c0]], dtype=int)
+    mask[shifted[:, 0], shifted[:, 1]] = True
+    border = np.zeros_like(mask)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(mask, border):
+        return False
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    return interior.size > 0 and np.all(interior == int(bg))
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> dict:
+    comps = _find_components(grid, bg)
+    frames = [comp for comp in comps if _is_hollow_frame(comp, grid, bg)]
+    assert len(frames) == 1, "expected exactly one hollow rectangular frame"
+    return frames[0]
+
+
+def _rect_dims_from_pair(a_coords: np.ndarray, b_coords: np.ndarray) -> set[tuple[int, int]]:
+    a_mask = _coords_to_mask(a_coords)
+    b_mask = _coords_to_mask(b_coords)
+    a_cells = np.argwhere(a_mask)
+    b_cells = np.argwhere(b_mask)
+    total_area = int(a_cells.shape[0] + b_cells.shape[0])
+    dims: set[tuple[int, int]] = set()
+
+    def placements(mask_cells: np.ndarray, rect_h: int, rect_w: int, mask_shape: tuple[int, int]) -> list[frozenset[int]]:
+        mask_h, mask_w = mask_shape
+        if mask_h > rect_h or mask_w > rect_w:
+            return []
+        out: list[frozenset[int]] = []
+        for top in range(rect_h - mask_h + 1):
+            for left in range(rect_w - mask_w + 1):
+                idx = (mask_cells[:, 0] + top) * rect_w + (mask_cells[:, 1] + left)
+                out.append(frozenset(map(int, idx)))
+        return out
