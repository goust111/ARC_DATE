+
+
+def _split_rectangles(height: int, width: int, count: int) -> list[tuple[int, int, int, int]] | None:
+    rects = [(0, 0, height, width)]  # r, c, h, w
+    while len(rects) < count:
+        options: list[tuple[int, str]] = []
+        for idx, (_r, _c, h, w) in enumerate(rects):
+            if h >= 2 * _GEN_MIN_CHILD:
+                options.append((idx, "h"))
+            if w >= 2 * _GEN_MIN_CHILD:
+                options.append((idx, "w"))
+        if not options:
+            return None
+        idx, axis = random.choice(options)
+        r, c, h, w = rects.pop(idx)
+        if axis == "h":
+            cut = random.randint(_GEN_MIN_CHILD, h - _GEN_MIN_CHILD)
+            rects.extend([(r, c, cut, w), (r + cut, c, h - cut, w)])
+        else:
+            cut = random.randint(_GEN_MIN_CHILD, w - _GEN_MIN_CHILD)
+            rects.extend([(r, c, h, cut), (r, c + cut, h, w - cut)])
+    random.shuffle(rects)
+    return rects
+
+
+def _render_tiling(rects: list[tuple[int, int, int, int]], colors: list[int], shape: tuple[int, int]) -> np.ndarray:
+    board = np.zeros(shape, dtype=int)
+    for (r, c, h, w), color in zip(rects, colors):
+        board[r : r + h, c : c + w] = int(color)
+    return board
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    cells = np.argwhere(mask)
+    for r_raw, c_raw in cells:
+        r = int(r_raw)
+        c = int(c_raw)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = True
+    return out
+
+
+def _place_patch(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, color: int, frame_bbox: BBox) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    r0, c0, r1, c1 = frame_bbox
+    options = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+    random.shuffle(options)
+    mask = patch.astype(bool)
+
+    for top, left in options[:_GEN_PLACE_TRIES]:
+        coords = np.argwhere(mask) + np.array([[top, left]], dtype=int)
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        if not (np.all((rows < r0) | (rows > r1) | (cols < c0) | (cols > c1))):
+            continue
