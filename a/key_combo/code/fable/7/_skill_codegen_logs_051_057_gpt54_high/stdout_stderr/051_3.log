            continue
        if not require_ambiguous and len(dims) != 1:
            continue
        return _coords_to_mask(a_coords), _coords_to_mask(b_coords), dims
    return None


def _split_rectangles(height: int, width: int, count: int) -> list[tuple[int, int, int, int]] | None:
    rects = [(0, 0, height, width)]  # r, c, h, w
    while len(rects) < count:
        options: list[tuple[int, str]] = []
        for idx, (_r, _c, h, w) in enumerate(rects):
            if h >= 2 * _GEN_MIN_CHILD:
                options.append((idx, "h"))
            if w >= 2 * _GEN_MIN_CHILD:
                options.append((idx, "w"))
        if not options:
            return None
        idx, axis = random.choice(options)
        r, c, h, w = rects.pop(idx)
        if axis == "h":
            cut = random.randint(_GEN_MIN_CHILD, h - _GEN_MIN_CHILD)
            rects.extend([(r, c, cut, w), (r + cut, c, h - cut, w)])
        else:
            cut = random.randint(_GEN_MIN_CHILD, w - _GEN_MIN_CHILD)
            rects.extend([(r, c, h, cut), (r, c + cut, h, w - cut)])
    random.shuffle(rects)
    return rects


def _render_tiling(rects: list[tuple[int, int, int, int]], colors: list[int], shape: tuple[int, int]) -> np.ndarray:
    board = np.zeros(shape, dtype=int)
    for (r, c, h, w), color in zip(rects, colors):
        board[r : r + h, c : c + w] = int(color)
    return board


def _dilate8(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    out = mask.copy()
    cells = np.argwhere(mask)
    for r_raw, c_raw in cells:
        r = int(r_raw)
        c = int(c_raw)
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                rr = r + dr
                cc = c + dc
                if 0 <= rr < h and 0 <= cc < w:
                    out[rr, cc] = True
    return out


def _place_patch(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, color: int, frame_bbox: BBox) -> bool:
    h, w = grid.shape
    ph, pw = patch.shape
    r0, c0, r1, c1 = frame_bbox
    options = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
    random.shuffle(options)
    mask = patch.astype(bool)

    for top, left in options[:_GEN_PLACE_TRIES]:
        coords = np.argwhere(mask) + np.array([[top, left]], dtype=int)
        rows = coords[:, 0]
        cols = coords[:, 1]
        if not (np.all((rows < r0) | (rows > r1) | (cols < c0) | (cols > c1))):
            continue
        if np.any(blocked[rows, cols]):
            continue

        local = np.zeros_like(grid, dtype=bool)
        local[rows, cols] = True
        padded = _dilate8(local)
        if np.any(blocked & padded):
            continue

        grid[rows, cols] = int(color)
        blocked |= padded
        return True
    return False


def _critical_ambiguity(
    inner_shape: tuple[int, int],
    candidate_dims: dict[int, set[tuple[int, int]]],
    true_board: np.ndarray,
) -> bool:
    for color, dims in candidate_dims.items():
        if len(dims) < 2:
            continue
        true_dim = tuple(map(int, np.argwhere(true_board == color).ptp(axis=0) + 1))
        alt_dims = set(dims) - {true_dim}
        if not alt_dims:
            continue
        forced = {k: (alt_dims if k == color else v) for k, v in candidate_dims.items()}
        if len(_solve_unique_tiling(inner_shape[0], inner_shape[1], forced, limit=1)) == 0:
            return True
    return False


def _build_attempt() -> tuple[np.ndarray, np.ndarray] | None:
    inner_h = random.randint(*_GEN_INNER_H_RANGE)
    inner_w = random.randint(*_GEN_INNER_W_RANGE)
    rect_count = random.choice(_GEN_RECT_COUNT)
    rects = _split_rectangles(inner_h, inner_w, rect_count)
    if rects is None:
        return None

    if max(h * w for _r, _c, h, w in rects) < 8:
        return None

    bg = random.choice(_GEN_BG_COLORS)
    palette = [c for c in _GEN_BG_COLORS if c != bg]
    frame_color = random.choice(palette)
    palette.remove(frame_color)
    if len(palette) < rect_count:
        return None
    colors = random.sample(palette, rect_count)

    ambiguous_indices = [idx for idx, (_r, _c, h, w) in enumerate(rects) if h * w >= 8]
    if not ambiguous_indices:
        return None
    ambiguous_idx = random.choice(ambiguous_indices)

    fragment_patches: list[tuple[np.ndarray, np.ndarray, int]] = []
    candidate_dims: dict[int, set[tuple[int, int]]] = {}
    for idx, ((_r, _c, h, w), color) in enumerate(zip(rects, colors)):
        pair = _synthesize_pair(h, w, require_ambiguous=(idx == ambiguous_idx))
        if pair is None:
            return None
        patch_a, patch_b, dims = pair
        fragment_patches.append((patch_a, patch_b, color))
        candidate_dims[color] = dims

    true_board = _render_tiling(rects, colors, (inner_h, inner_w))
    solutions = _solve_unique_tiling(inner_h, inner_w, candidate_dims)
    if len(solutions) != 1 or not np.array_equal(solutions[0], true_board):
        return None
    if not _critical_ambiguity((inner_h, inner_w), candidate_dims, true_board):
        return None

    grid_h = random.randint(max(inner_h + 8, 18), _GEN_GRID_H_RANGE[1])
    grid_w = random.randint(max(inner_w + 8, 18), _GEN_GRID_W_RANGE[1])
    frame_h = inner_h + 2
    frame_w = inner_w + 2
    if grid_h <= frame_h + 3 or grid_w <= frame_w + 3:
        return None

    frame_top = random.randint(2, grid_h - frame_h - 2)
    frame_left = random.randint(2, grid_w - frame_w - 2)
    frame_bbox = (frame_top, frame_left, frame_top + frame_h - 1, frame_left + frame_w - 1)

    inp = np.full((grid_h, grid_w), bg, dtype=int)
    out = np.full((grid_h, grid_w), bg, dtype=int)
    r0, c0, r1, c1 = frame_bbox
    inp[r0, c0 : c1 + 1] = frame_color
    inp[r1, c0 : c1 + 1] = frame_color
    inp[r0 : r1 + 1, c0] = frame_color
    inp[r0 : r1 + 1, c1] = frame_color
    out[:] = inp
    out[r0 + 1 : r1, c0 + 1 : c1] = true_board

    blocked = np.zeros_like(inp, dtype=bool)
    blocked[max(0, r0 - 1) : min(grid_h, r1 + 2), max(0, c0 - 1) : min(grid_w, c1 + 2)] = True
    for patch_a, patch_b, color in fragment_patches:
        if not _place_patch(inp, blocked, patch_a, color, frame_bbox):
            return None
        if not _place_patch(inp, blocked, patch_b, color, frame_bbox):
            return None

    if len([comp for comp in _find_components(inp, bg) if _is_hollow_frame(comp, inp, bg)]) != 1:
        return None

    produced = main(inp)
    if not np.array_equal(produced, out):
        return None

    _bg2, frame2, by_color2, dims2 = _parse_problem(inp)
    if len(_solve_unique_tiling(inner_h, inner_w, dims2)) != 1:
        return None
    if not any(len(v) >= 2 for v in dims2.values()):
        return None
    if not _critical_ambiguity((inner_h, inner_w), dims2, true_board):
        return None
    if frame2["bbox"] != frame_bbox or set(by_color2) != set(colors):
        return None

    return inp, out


def generate_input() -> np.ndarray:
    for _ in range(_GEN_ATTEMPTS):
        pair = _build_attempt()
        if pair is not None:
            return pair[0]
    raise RuntimeError("failed to generate a valid two-stage assembly puzzle")

