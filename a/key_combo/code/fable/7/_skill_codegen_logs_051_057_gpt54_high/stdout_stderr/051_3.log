+    rec(set())
+    return solutions
+
+
+def _parse_problem(grid: np.ndarray) -> tuple[int, dict, dict[int, list[dict]], dict[int, set[tuple[int, int]]]]:
+    bg = _get_bg(grid)
+    frame = _find_frame(grid, bg)
