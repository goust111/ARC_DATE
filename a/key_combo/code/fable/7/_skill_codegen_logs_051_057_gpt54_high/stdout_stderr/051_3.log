+    r0, c0, r1, c1 = frame["bbox"]
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+
+    solutions = _solve_unique_tiling(inner_h, inner_w, candidate_dims, limit=128)
+    chosen = _select_tiling(solutions, by_color, (r0 + 1, c0 + 1))
