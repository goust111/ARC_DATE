+def _is_full_bbox(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].all()
+
