+
+def _synthesize_pair(h: int, w: int, require_ambiguous: bool) -> tuple[np.ndarray, np.ndarray, set[tuple[int, int]]] | None:
+    area = h * w
+    if area < 6:
+        return None
+    for _ in range(_GEN_PAIR_TRIES):
+        size_a = random.randint(2, area - 2)
+        try:
