+def _split_rectangles(height: int, width: int, count: int) -> list[tuple[int, int, int, int]] | None:
+    rects = [(0, 0, height, width)]  # r, c, h, w
+    while len(rects) < count:
+        options: list[tuple[int, str]] = []
+        for idx, (_r, _c, h, w) in enumerate(rects):
+            if h >= 2 * _GEN_MIN_CHILD:
+                options.append((idx, "h"))
+            if w >= 2 * _GEN_MIN_CHILD:
+                options.append((idx, "w"))
+        if not options:
+            return None
+        idx, axis = random.choice(options)
+        r, c, h, w = rects.pop(idx)
+        if axis == "h":
+            cut = random.randint(_GEN_MIN_CHILD, h - _GEN_MIN_CHILD)
+            rects.extend([(r, c, cut, w), (r + cut, c, h - cut, w)])
+        else:
+            cut = random.randint(_GEN_MIN_CHILD, w - _GEN_MIN_CHILD)
