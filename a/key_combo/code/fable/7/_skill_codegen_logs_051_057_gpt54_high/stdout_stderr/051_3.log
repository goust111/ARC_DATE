+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    cells = np.argwhere(mask)
+    for r_raw, c_raw in cells:
+        r = int(r_raw)
+        c = int(c_raw)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = True
+    return out
