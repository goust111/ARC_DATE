+def _render_tiling(rects: list[tuple[int, int, int, int]], colors: list[int], shape: tuple[int, int]) -> np.ndarray:
+    board = np.zeros(shape, dtype=int)
+    for (r, c, h, w), color in zip(rects, colors):
+        board[r : r + h, c : c + w] = int(color)
