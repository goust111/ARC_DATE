+    cells = np.argwhere(mask)
+    for r_raw, c_raw in cells:
+        r = int(r_raw)
+        c = int(c_raw)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = True
+    return out
+
+
+def _place_patch(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, color: int, frame_bbox: BBox) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    r0, c0, r1, c1 = frame_bbox
