+        a_coords = np.argwhere(a_mask)
+        b_coords = np.argwhere(b_mask)
+        dims = _rect_dims_from_pair(a_coords, b_coords)
+        if (h, w) not in dims:
+            continue
+        if require_ambiguous and len(dims) < 2:
+            continue
+        if not require_ambiguous and len(dims) != 1:
+            continue
