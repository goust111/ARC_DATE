+    frame_color = random.choice(palette)
+    palette.remove(frame_color)
+    if len(palette) < rect_count:
+        return None
+    colors = random.sample(palette, rect_count)
+
+    ambiguous_indices = [idx for idx, (_r, _c, h, w) in enumerate(rects) if h * w >= 8]
+    if not ambiguous_indices:
+        return None
+    ambiguous_idx = random.choice(ambiguous_indices)
+
+    fragment_patches: list[tuple[np.ndarray, np.ndarray, int]] = []
+    candidate_dims: dict[int, set[tuple[int, int]]] = {}
+    for idx, ((_r, _c, h, w), color) in enumerate(zip(rects, colors)):
+        pair = _synthesize_pair(h, w, require_ambiguous=(idx == ambiguous_idx))
+        if pair is None:
