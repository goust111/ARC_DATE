+        return None
+    if not any(len(v) >= 2 for v in dims2.values()):
+        return None
+    if not _critical_ambiguity((inner_h, inner_w), dims2, true_board):
+        return None
+    if frame2["bbox"] != frame_bbox or set(by_color2) != set(colors):
+        return None
+
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        pair = _build_attempt()
+        if pair is not None:
+            return pair[0]
