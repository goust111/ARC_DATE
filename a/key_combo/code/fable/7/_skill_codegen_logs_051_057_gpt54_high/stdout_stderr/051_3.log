      size_to_dims.setdefault((bh*sv,bw*sh), {(bh*sv,bw*sh)})

# dedupe in-bounds later

def solve(H,W,cands):
  full=H*W
  order=tuple(sorted(cands))
  pos_cache={}
  def positions(rect_h, rect_w, idx):
    key=(rect_h,rect_w,idx)
    if key in pos_cache: return pos_cache[key]
    r=idx//W; c=idx%W
    out=[]
    top_lo=max(0,r-rect_h+1); top_hi=min(r,H-rect_h)
    left_lo=max(0,c-rect_w+1); left_hi=min(c,W-rect_w)
    for top in range(top_lo, top_hi+1):
      for left in range(left_lo, left_hi+1):
        bits=0
        ok=True
        for rr in range(top, top+rect_h):
          rowbase=rr*W
          for cc in range(left,left+rect_w):
            bits |= 1 << (rowbase+cc)
        out.append(bits)
    pos_cache[key]=out
    return out

  @lru_cache(None)
  def rec(mask, remaining):
    if not remaining:
      return (1 if mask == (1<<full)-1 else 0), None
    # first empty cell
    for idx in range(full):
      if not (mask>>idx)&1:
        break
    count=0; first_sol=None
    rem=list(remaining)
    for i,color in enumerate(rem):
      tail=tuple(rem[:i]+rem[i+1:])
      for rect_h,rect_w in cands[color]:
        for bits in positions(rect_h,rect_w,idx):
          if bits & mask: continue
          subcount, sol = rec(mask|bits, tail)
          if subcount:
            count += subcount
            if first_sol is None:
              first_sol = [(color,bits)] + ([] if sol is None else sol)
            if count >= 2:
              return 2, first_sol
    return count, first_sol

  count, sol = rec(0, order)
  if count "'!= 1:
    return count, None
  board=[[0]*W for _ in range(H)]
  for color,bits in sol:
    for idx in range(full):
      if (bits>>idx)&1:
        board[idx//W][idx%W]=color
  return 1, board

sizes=list(size_to_dims)
random.seed(0)
for trial in range(50000):
  H=random.randint(6,18); W=random.randint(6,18); area=H*W
  k=random.randint(3,6)
  combo=[]; remaining=area
  for i in range(k-1):
    fits=[s for s in sizes if s[0]<=H and s[1]<=W and s[0]*s[1] <= remaining-6*(k-i-1)]
    if not fits: break
    # bias toward ambiguous and bigger pieces
    fits.sort(key=lambda s:(len(size_to_dims[s])>1,s[0]*s[1]), reverse=True)
    s=random.choice(fits[:min(20,len(fits))])
    combo.append(s); remaining-=s[0]*s[1]
  else:
    last=[s for s in sizes if s[0]<=H and s[1]<=W and s[0]*s[1]==remaining]
    if not last: continue
    combo.append(random.choice(last))
    cands={i+1:set(size_to_dims[s]) for i,s in enumerate(combo)}
    if not any(len(v)>1 for v in cands.values()):
      continue
    count, board = solve(H,W,cands)
    if count==1:
