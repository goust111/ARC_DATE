+def _place_patch(grid: np.ndarray, blocked: np.ndarray, patch: np.ndarray, color: int, frame_bbox: BBox) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    r0, c0, r1, c1 = frame_bbox
+    options = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+    random.shuffle(options)
+    mask = patch.astype(bool)
+
+    for top, left in options[:_GEN_PLACE_TRIES]:
+        coords = np.argwhere(mask) + np.array([[top, left]], dtype=int)
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        if not (np.all((rows < r0) | (rows > r1) | (cols < c0) | (cols > c1))):
+            continue
+        if np.any(blocked[rows, cols]):
+            continue
+
+        local = np.zeros_like(grid, dtype=bool)
+        local[rows, cols] = True
+        padded = _dilate8(local)
+        if np.any(blocked & padded):
+            continue
+
+        grid[rows, cols] = int(color)
+        blocked |= padded
+        return True
+    return False
