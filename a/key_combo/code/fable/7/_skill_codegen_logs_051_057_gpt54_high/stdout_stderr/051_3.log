+    frame_cells = {tuple(map(int, cell)) for cell in frame["coords"]}
+    comps = []
+    for comp in _find_components(grid, bg):
+        if int(comp["color"]) != frame_color or comp["bbox"] != frame["bbox"]:
+            comps.append(comp)
