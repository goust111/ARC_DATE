+    start = _find_start(g)
+    start_dir = _start_direction(start, g.shape)
+    components = _find_obstacle_components(g)
+
+    cell_to_size: dict[tuple[int, int], int] = {}
+    for comp in components:
+        for cell in comp["cells"]:
+            cell_to_size[cell] = int(comp["size"])
