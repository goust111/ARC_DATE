def _is_straight_bar(coords: np.ndarray) -> bool:
    rows = coords[:, 0]
    cols = coords[:, 1]

    if np.unique(rows).size == 1:
        ordered = np.sort(cols)
        return bool(np.array_equal(ordered, np.arange(ordered[0], ordered[-1] + 1)))

