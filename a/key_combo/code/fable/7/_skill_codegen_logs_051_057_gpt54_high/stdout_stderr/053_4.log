+    extras: list[list[tuple[int, int]]] = []
+    targets = random.randint(*EXTRA_OBSTACLE_RANGE)
+    anchors = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    random.shuffle(anchors)
