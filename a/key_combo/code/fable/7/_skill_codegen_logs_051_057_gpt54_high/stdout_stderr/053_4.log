+        if (nr, nc) in cell_to_size:
+            real_turn = cell_to_size[(nr, nc)]
+            hit_index = len(hit_sizes)
+            hit_sizes.append(real_turn)
+            turn = real_turn if turn_policy is None else int(turn_policy(hit_index, real_turn))
