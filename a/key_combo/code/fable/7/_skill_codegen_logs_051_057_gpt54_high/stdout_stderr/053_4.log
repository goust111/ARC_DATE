+        move_cells.append(pos)
+        out[nr, nc] = YELLOW
+        state = (nr, nc, dir_idx)
+        assert state not in seen_states, "ray entered a loop"
+        seen_states.add(state)
+
+    raise AssertionError("ray did not exit within the safety bound")
+
