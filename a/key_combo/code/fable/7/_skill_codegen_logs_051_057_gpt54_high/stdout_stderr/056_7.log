+            "color": color,
+            "bbox": (r0, c0, r1, c1),
+            "h": h,
+            "w": w,
+            "k": len(dots),
+            "side": side,
+            "dot_coords": [tuple(map(int, dot["coords"][0])) for dot in dots],
+        }
+
+    return parsed
+
