+    if k == 0:
+        return []
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    out: list[tuple[int, int]] = []
+    for idx in range(k):
+        level = idx // 2
+        col = c0 - 1 if idx % 2 == 0 else c1 + 1
+        if side == "up":
+            row = r0 - 2 - 2 * level
+        else:
+            row = r1 + 2 + 2 * level
+        out.append((int(row), int(col)))
+    return out
+
+
+def _parse_by_color(grid: np.ndarray) -> dict[int, dict]:
+    bg = int(get_bg(grid))
