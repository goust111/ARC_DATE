+from __future__ import annotations
+
+import random
+from importlib.machinery import SourceFileLoader
+from pathlib import Path
+
+import numpy as np
+
+
+_ARC_UTILS = SourceFileLoader(
+    "_arc_utils_fable_7_056_7",
+    "/home/lixinyu/snap/new/solvers/arc_utils.py",
+).load_module()
+
