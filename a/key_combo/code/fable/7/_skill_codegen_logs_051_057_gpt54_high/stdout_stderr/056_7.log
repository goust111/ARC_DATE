+    else:
+        lo = 0
+        hi = grid_h - h
+    if hi < lo:
+        return None
+    return random.randint(int(lo), int(hi))
+
+
+def _semantic_checks(inp: np.ndarray, expected: np.ndarray) -> None:
+    parsed = _parse_by_color(inp)
+    assert len(parsed) == RECT_COUNT
+    sides = [info["side"] for info in parsed.values()]
