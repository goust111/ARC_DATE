+    if not np.array_equal(inferred, expected_output):
+        return None
+
+    if not all(
+        _single_cavity_subset_is_incomplete(visible_phases, bitmap)
+        for visible_phases in visible_phase_sets
+        if visible_phases
+    ):
+        return None
+
+    naive = _naive_local_output(input_grid, wall, empty, seed, cavities)
+    if np.array_equal(naive, expected_output):
+        return None
+
+    return input_grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid global-window tiling task")

