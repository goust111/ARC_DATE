+def _seed_phases_seen_in_cavity(
+    cavity: tuple[int, int, int, int],
+    bitmap: np.ndarray,
+) -> set[tuple[int, int]]:
+    pr, pc = bitmap.shape
+    r0, c0, r1, c1 = cavity
+    phases = set()
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            phase = (r % pr, c % pc)
+            if bitmap[phase]:
+                phases.add(phase)
+    return phases
+
+
+def _assign_visible_phase_subsets(
+    rng: np.random.Generator,
+    cavities: list[tuple[int, int, int, int]],
+    bitmap: np.ndarray,
+) -> list[set[tuple[int, int]]] | None:
+    seed_phases = {(r, c) for r in range(bitmap.shape[0]) for c in range(bitmap.shape[1]) if bitmap[r, c]}
+    availability = [_seed_phases_seen_in_cavity(cavity, bitmap) for cavity in cavities]
+    if set().union(*availability) != seed_phases:
+        return None
+
+    visible = [set() for _ in cavities]
+    phase_list = list(seed_phases)
+    rng.shuffle(phase_list)
+    for phase in phase_list:
+        options = [idx for idx, avail in enumerate(availability) if phase in avail]
+        if not options:
+            return None
+        sizes = [len(visible[idx]) for idx in options]
+        pick = int(options[int(np.argmin(sizes))])
+        visible[pick].add(phase)
+
+    for idx, avail in enumerate(availability):
+        hidden = None
+        if avail == seed_phases:
+            hidden = next(iter(seed_phases - visible[idx])) if seed_phases - visible[idx] else next(iter(seed_phases))
+        extras = list(avail - visible[idx] - ({hidden} if hidden is not None else set()))
+        rng.shuffle(extras)
+        for phase in extras:
+            if rng.random() < 0.75:
