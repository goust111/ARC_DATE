+    for pr in range(1, H + 1):
+        for pc in range(1, W + 1):
+            phases = {(int(r) % pr, int(c) % pc) for r, c in seed_coords}
+            if len(phases) == pr * pc:
+                continue
+            bitmap = _phase_set_to_bitmap(pr, pc, phases)
+            if not _is_primitive_bitmap(bitmap):
+                continue
+            score = (pr * pc, len(phases), pr, pc)
+            rendered = _render_cavity_mask(shape, cavities, bitmap)
+            candidates.append((score, pr, pc, bitmap, rendered))
