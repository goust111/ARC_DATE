+) -> bool:
+    full_phases = {(r, c) for r in range(full_bitmap.shape[0]) for c in range(full_bitmap.shape[1]) if full_bitmap[r, c]}
+    if not visible_phases or visible_phases == full_phases:
+        return False
+    subset_bitmap = _phase_set_to_bitmap(full_bitmap.shape[0], full_bitmap.shape[1], visible_phases)
+    return _is_primitive_bitmap(subset_bitmap)
+
+
+def _naive_local_output(
+    input_grid: np.ndarray,
+    wall: int,
+    empty: int,
+    seed: int,
+    cavities: list[tuple[int, int, int, int]],
+) -> np.ndarray:
+    out = np.full_like(input_grid, wall)
+    for r0, c0, r1, c1 in cavities:
+        region = input_grid[r0 : r1 + 1, c0 : c1 + 1]
+        seed_coords = np.argwhere(region == seed)
+        out[r0 : r1 + 1, c0 : c1 + 1] = empty
+        if seed_coords.size == 0:
+            continue
+
+        best = None
+        h, w = region.shape
+        for pr in range(1, h + 1):
+            for pc in range(1, w + 1):
+                phases = {(int(r) % pr, int(c) % pc) for r, c in seed_coords}
+                if len(phases) == pr * pc:
+                    continue
+                bitmap = _phase_set_to_bitmap(pr, pc, phases)
+                if not _is_primitive_bitmap(bitmap):
+                    continue
+                score = (pr * pc, len(phases), pr, pc)
+                if best is None or score < best[0]:
+                    best = (score, bitmap)
+
+        assert best is not None
+        bitmap = best[1]
+        pr, pc = bitmap.shape
+        rr = np.arange(h)[:, None] % pr
+        cc = np.arange(w)[None, :] % pc
+        out[r0 : r1 + 1, c0 : c1 + 1] = np.where(bitmap[rr, cc], seed, empty)
+    return out
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    H = int(rng.integers(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1] + 1))
+    W = int(rng.integers(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1] + 1))
+    wall, empty, seed = rng.choice(PALETTE, size=3, replace=False)
+    pr = int(rng.integers(PERIOD_HEIGHT_RANGE[0], PERIOD_HEIGHT_RANGE[1] + 1))
+    pc = int(rng.integers(PERIOD_WIDTH_RANGE[0], PERIOD_WIDTH_RANGE[1] + 1))
+
+    bitmap = _sample_primitive_bitmap(rng, pr, pc)
+    if bitmap is None:
+        return None
+
+    cavity_count = int(rng.integers(CAVITY_COUNT_RANGE[0], CAVITY_COUNT_RANGE[1] + 1))
+    cavities = _place_cavities(rng, H, W, cavity_count, pr, pc)
+    if cavities is None:
+        return None
+
+    visible_phase_sets = _assign_visible_phase_subsets(rng, cavities, bitmap)
+    if visible_phase_sets is None:
+        return None
+
+    input_grid = _build_input_grid((H, W), wall, empty, seed, cavities, bitmap, visible_phase_sets)
+    expected_output = _build_output_grid((H, W), wall, empty, seed, cavities, bitmap)
+
+    if np.count_nonzero(input_grid == seed) == 0:
+        return None
+    if np.array_equal(input_grid, expected_output):
+        return None
+
+    inferred = main(input_grid)
+    if not np.array_equal(inferred, expected_output):
+        return None
+
+    if not all(
+        _single_cavity_subset_is_incomplete(visible_phases, bitmap)
+        for visible_phases in visible_phase_sets
+        if visible_phases
+    ):
+        return None
+
+    naive = _naive_local_output(input_grid, wall, empty, seed, cavities)
+    if np.array_equal(naive, expected_output):
+        return None
+
+    return input_grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid global-window tiling task")

