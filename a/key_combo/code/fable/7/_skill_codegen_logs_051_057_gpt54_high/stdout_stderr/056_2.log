+        sizes = [len(visible[idx]) for idx in options]
+        pick = int(options[int(np.argmin(sizes))])
+        visible[pick].add(phase)
+
+    for idx, avail in enumerate(availability):
+        hidden = None
+        if avail == seed_phases:
+            hidden = next(iter(seed_phases - visible[idx])) if seed_phases - visible[idx] else next(iter(seed_phases))
+        extras = list(avail - visible[idx] - ({hidden} if hidden is not None else set()))
+        rng.shuffle(extras)
+        for phase in extras:
+            if rng.random() < 0.75:
+                visible[idx].add(phase)
