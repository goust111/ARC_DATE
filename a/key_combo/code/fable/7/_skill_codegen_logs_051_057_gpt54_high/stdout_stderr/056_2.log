+    assert candidates, "failed to infer any non-degenerate periodic mask"
+    return candidates
+
+
+def _infer_global_bitmap(
+    shape: tuple[int, int],
+    cavities: list[tuple[int, int, int, int]],
+    seed_coords: np.ndarray,
+) -> tuple[int, int, np.ndarray]:
+    candidates = _candidate_outputs(shape, cavities, seed_coords)
+    best_score = min(candidate[0] for candidate in candidates)
+    best = [candidate for candidate in candidates if candidate[0] == best_score]
+    unique_outputs = {candidate[4].tobytes(): candidate for candidate in best}
+    assert len(unique_outputs) == 1, "minimal global pattern must be uniquely determined"
+    _score, pr, pc, bitmap, _rendered = next(iter(unique_outputs.values()))
+    return pr, pc, bitmap
+
+
+def _fill_cavities(
+    grid: np.ndarray,
+    cavities: list[tuple[int, int, int, int]],
+    empty: int,
+    seed: int,
+    bitmap: np.ndarray,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    pr, pc = bitmap.shape
+    for r0, c0, r1, c1 in cavities:
+        rr = np.arange(r0, r1 + 1)[:, None] % pr
+        cc = np.arange(c0, c1 + 1)[None, :] % pc
+        mask = bitmap[rr, cc]
+        out[r0 : r1 + 1, c0 : c1 + 1] = np.where(mask, seed, empty)
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill every wall cavity with one globally phased periodic seed mask inferred from all windows together.
+
+    Input structure:
+    - A dominant wall color forms solid barriers around several rectangular cavities.
+    - Inside the cavities there are exactly two non-wall colors: a cavity floor color and one seed color.
+    - The seed pixels are incomplete observations of one shared two-color periodic pattern indexed by absolute grid coordinates.
+
+    Rule:
+    - Treat all cavities as windows onto the same global periodic mask, not as separate local tilings.
+    - Infer the unique smallest primitive period whose repeated seed phases can explain every visible seed pixel across all cavities.
+    - Repaint each cavity completely with that global mask, using the cavity floor color on non-seed phases and leaving the wall unchanged.
+
+    Key insight:
+    - The decisive constraint is cross-cavity phase agreement in the full grid coordinate system: complementary windows reveal different parts of one absolute pattern.
+    """
+    g = np.asarray(grid, dtype=int)
+    _wall, empty, seed, cavities = _parse_scene(g)
+    seed_coords = np.argwhere(g == seed)
+    pr, pc, bitmap = _infer_global_bitmap(g.shape, cavities, seed_coords)
+    return _fill_cavities(g, cavities, empty, seed, bitmap)
+
+
+def _sample_primitive_bitmap(rng: np.random.Generator, pr: int, pc: int) -> np.ndarray | None:
+    area = pr * pc
+    for _ in range(80):
+        bitmap = rng.random((pr, pc)) < rng.uniform(0.25, 0.6)
+        if bitmap.sum() < 2 or bitmap.sum() > area - 2:
+            continue
+        if not _is_primitive_bitmap(bitmap):
+            continue
+        return bitmap
+    return None
+
+
+def _place_cavities(
+    rng: np.random.Generator,
+    H: int,
+    W: int,
+    count: int,
+    pr: int,
+    pc: int,
+) -> list[tuple[int, int, int, int]] | None:
+    occupied = np.zeros((H, W), dtype=bool)
+    cavities = []
+    for _ in range(count):
+        placed = False
+        for _ in range(120):
+            h_hi = min(CAVITY_SIDE_MAX, H - 2)
+            w_hi = min(CAVITY_SIDE_MAX, W - 2)
+            h_lo = max(CAVITY_SIDE_MIN, min(pr, h_hi))
+            w_lo = max(CAVITY_SIDE_MIN, min(pc, w_hi))
+            if h_lo > h_hi or w_lo > w_hi:
+                return None
+            h = int(rng.integers(h_lo, h_hi + 1))
+            w = int(rng.integers(w_lo, w_hi + 1))
+            r0 = int(rng.integers(1, H - h))
+            c0 = int(rng.integers(1, W - w))
+            r1 = r0 + h - 1
+            c1 = c0 + w - 1
+
+            rr0 = max(0, r0 - PADDING)
+            cc0 = max(0, c0 - PADDING)
+            rr1 = min(H, r1 + PADDING + 1)
+            cc1 = min(W, c1 + PADDING + 1)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+
+            occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+            cavities.append((r0, c0, r1, c1))
+            placed = True
+            break
+        if not placed:
+            return None
+    return cavities
+
+
+def _seed_phases_seen_in_cavity(
+    cavity: tuple[int, int, int, int],
+    bitmap: np.ndarray,
+) -> set[tuple[int, int]]:
+    pr, pc = bitmap.shape
+    r0, c0, r1, c1 = cavity
+    phases = set()
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            phase = (r % pr, c % pc)
+            if bitmap[phase]:
+                phases.add(phase)
+    return phases
+
+
+def _assign_visible_phase_subsets(
+    rng: np.random.Generator,
+    cavities: list[tuple[int, int, int, int]],
+    bitmap: np.ndarray,
+) -> list[set[tuple[int, int]]] | None:
+    seed_phases = {(r, c) for r in range(bitmap.shape[0]) for c in range(bitmap.shape[1]) if bitmap[r, c]}
+    availability = [_seed_phases_seen_in_cavity(cavity, bitmap) for cavity in cavities]
+    if set().union(*availability) != seed_phases:
+        return None
+
+    visible = [set() for _ in cavities]
+    phase_list = list(seed_phases)
+    rng.shuffle(phase_list)
+    for phase in phase_list:
+        options = [idx for idx, avail in enumerate(availability) if phase in avail]
+        if not options:
+            return None
+        pick = int(rng.choice(options))
+        visible[pick].add(phase)
+
+    for idx, avail in enumerate(availability):
+        extras = list(avail - visible[idx])
+        rng.shuffle(extras)
+        for phase in extras:
+            if rng.random() < 0.35:
+                visible[idx].add(phase)
+
+    if any(phases == seed_phases for phases in visible):
+        return None
+    if not any(len(phases) < len(seed_phases) for phases in visible):
+        return None
+    return visible
+
+
+def _build_input_grid(
+    shape: tuple[int, int],
+    wall: int,
+    empty: int,
+    seed: int,
+    cavities: list[tuple[int, int, int, int]],
+    bitmap: np.ndarray,
+    visible_phase_sets: list[set[tuple[int, int]]],
+) -> np.ndarray:
+    H, W = shape
+    pr, pc = bitmap.shape
+    grid = np.full((H, W), wall, dtype=int)
+    for cavity, visible in zip(cavities, visible_phase_sets):
+        r0, c0, r1, c1 = cavity
+        grid[r0 : r1 + 1, c0 : c1 + 1] = empty
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                phase = (r % pr, c % pc)
+                if bitmap[phase] and phase in visible:
+                    grid[r, c] = seed
+    return grid
+
+
+def _build_output_grid(
+    shape: tuple[int, int],
+    wall: int,
+    empty: int,
+    seed: int,
+    cavities: list[tuple[int, int, int, int]],
+    bitmap: np.ndarray,
+) -> np.ndarray:
+    grid = np.full(shape, wall, dtype=int)
+    return _fill_cavities(grid, cavities, empty, seed, bitmap)
+
+
+def _single_cavity_is_sufficient(
+    shape: tuple[int, int],
+    cavities: list[tuple[int, int, int, int]],
+    input_grid: np.ndarray,
+    seed: int,
+    expected_output: np.ndarray,
+    cavity_idx: int,
+) -> bool:
+    seed_coords = np.argwhere(input_grid == seed)
+    cavity = cavities[cavity_idx]
+    r0, c0, r1, c1 = cavity
+    only_this = seed_coords[
+        (seed_coords[:, 0] >= r0)
+        & (seed_coords[:, 0] <= r1)
+        & (seed_coords[:, 1] >= c0)
+        & (seed_coords[:, 1] <= c1)
+    ]
+    if only_this.size == 0:
+        return False
+
+    candidates = _candidate_outputs(shape, cavities, only_this)
+    best_score = min(candidate[0] for candidate in candidates)
+    best = [candidate for candidate in candidates if candidate[0] == best_score]
+    rendered_expected = (expected_output == seed)
+    return all(np.array_equal(candidate[4], rendered_expected) for candidate in best)
+
+
+def _naive_local_output(
+    input_grid: np.ndarray,
+    wall: int,
+    empty: int,
+    seed: int,
+    cavities: list[tuple[int, int, int, int]],
+) -> np.ndarray:
+    out = np.full_like(input_grid, wall)
+    for r0, c0, r1, c1 in cavities:
+        region = input_grid[r0 : r1 + 1, c0 : c1 + 1]
+        seed_coords = np.argwhere(region == seed)
+        out[r0 : r1 + 1, c0 : c1 + 1] = empty
+        if seed_coords.size == 0:
+            continue
+
+        best = None
+        h, w = region.shape
+        for pr in range(1, h + 1):
+            for pc in range(1, w + 1):
+                phases = {(int(r) % pr, int(c) % pc) for r, c in seed_coords}
+                if len(phases) == pr * pc:
+                    continue
+                bitmap = _phase_set_to_bitmap(pr, pc, phases)
+                if not _is_primitive_bitmap(bitmap):
+                    continue
+                score = (pr * pc, len(phases), pr, pc)
+                if best is None or score < best[0]:
+                    best = (score, bitmap)
+
+        assert best is not None
+        bitmap = best[1]
+        pr, pc = bitmap.shape
+        rr = np.arange(h)[:, None] % pr
+        cc = np.arange(w)[None, :] % pc
+        out[r0 : r1 + 1, c0 : c1 + 1] = np.where(bitmap[rr, cc], seed, empty)
+    return out
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    H = int(rng.integers(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1] + 1))
+    W = int(rng.integers(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1] + 1))
+    wall, empty, seed = rng.choice(PALETTE, size=3, replace=False)
+    pr = int(rng.integers(PERIOD_HEIGHT_RANGE[0], PERIOD_HEIGHT_RANGE[1] + 1))
+    pc = int(rng.integers(PERIOD_WIDTH_RANGE[0], PERIOD_WIDTH_RANGE[1] + 1))
+
+    bitmap = _sample_primitive_bitmap(rng, pr, pc)
+    if bitmap is None:
+        return None
+
+    cavity_count = int(rng.integers(CAVITY_COUNT_RANGE[0], CAVITY_COUNT_RANGE[1] + 1))
+    cavities = _place_cavities(rng, H, W, cavity_count, pr, pc)
+    if cavities is None:
+        return None
+
+    visible_phase_sets = _assign_visible_phase_subsets(rng, cavities, bitmap)
+    if visible_phase_sets is None:
+        return None
+
+    input_grid = _build_input_grid((H, W), wall, empty, seed, cavities, bitmap, visible_phase_sets)
+    expected_output = _build_output_grid((H, W), wall, empty, seed, cavities, bitmap)
+
+    if np.count_nonzero(input_grid == seed) == 0:
+        return None
+    if np.array_equal(input_grid, expected_output):
+        return None
+
+    inferred = main(input_grid)
+    if not np.array_equal(inferred, expected_output):
+        return None
+
+    if any(_single_cavity_is_sufficient((H, W), cavities, input_grid, seed, expected_output, idx) for idx in range(len(cavities))):
+        return None
+
+    naive = _naive_local_output(input_grid, wall, empty, seed, cavities)
+    if np.array_equal(naive, expected_output):
+        return None
+
+    return input_grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid global-window tiling task")

