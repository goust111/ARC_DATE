+    r0, c0, r1, c1 = cavity
+    phases = set()
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            phase = (r % pr, c % pc)
+            if bitmap[phase]:
+                phases.add(phase)
+    return phases
