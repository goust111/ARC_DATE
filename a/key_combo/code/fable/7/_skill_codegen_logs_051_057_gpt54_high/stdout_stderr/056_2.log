+
+
+def _place_cavities(
+    rng: np.random.Generator,
+    H: int,
+    W: int,
+    count: int,
+    pr: int,
+    pc: int,
+) -> list[tuple[int, int, int, int]] | None:
+    occupied = np.zeros((H, W), dtype=bool)
+    cavities = []
+    for _ in range(count):
+        placed = False
+        for _ in range(120):
+            h_hi = min(CAVITY_SIDE_MAX, H - 2)
+            w_hi = min(CAVITY_SIDE_MAX, W - 2)
+            h_lo = max(CAVITY_SIDE_MIN, min(pr, h_hi))
+            w_lo = max(CAVITY_SIDE_MIN, min(pc, w_hi))
+            if h_lo > h_hi or w_lo > w_hi:
+                return None
+            h = int(rng.integers(h_lo, h_hi + 1))
+            w = int(rng.integers(w_lo, w_hi + 1))
+            r0 = int(rng.integers(1, H - h))
+            c0 = int(rng.integers(1, W - w))
+            r1 = r0 + h - 1
+            c1 = c0 + w - 1
+
+            rr0 = max(0, r0 - PADDING)
+            cc0 = max(0, c0 - PADDING)
+            rr1 = min(H, r1 + PADDING + 1)
+            cc1 = min(W, c1 + PADDING + 1)
+            if occupied[rr0:rr1, cc0:cc1].any():
+                continue
+
+            occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+            cavities.append((r0, c0, r1, c1))
+            placed = True
+            break
