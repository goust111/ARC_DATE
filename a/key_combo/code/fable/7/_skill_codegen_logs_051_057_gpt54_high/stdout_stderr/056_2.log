+def _sample_primitive_bitmap(rng: np.random.Generator, pr: int, pc: int) -> np.ndarray | None:
+    area = pr * pc
+    for _ in range(80):
+        bitmap = np.ones((pr, pc), dtype=bool)
+        hole_count = int(rng.integers(2, min(area - 1, 4)))
+        holes = rng.choice(area, size=hole_count, replace=False)
+        bitmap.flat[holes] = False
+        if bitmap.sum() < 2 or bitmap.sum() > area - 2:
+            continue
+        if not _is_primitive_bitmap(bitmap):
+            continue
+        return bitmap
+    return None
+
