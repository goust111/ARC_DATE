+
+def _divisors(n: int) -> list[int]:
+    return [d for d in range(1, n + 1) if n % d == 0]
+
+
+def _is_primitive_bitmap(bitmap: np.ndarray) -> bool:
+    pr, pc = bitmap.shape
+    for dr in _divisors(pr):
+        for dc in _divisors(pc):
+            if dr == pr and dc == pc:
+                continue
+            if np.array_equal(bitmap, np.tile(bitmap[:dr, :dc], (pr // dr, pc // dc))):
+                return False
+    return True
+
+
+def _phase_set_to_bitmap(pr: int, pc: int, phases: set[tuple[int, int]]) -> np.ndarray:
+    bitmap = np.zeros((pr, pc), dtype=bool)
+    for r, c in phases:
+        bitmap[r, c] = True
+    return bitmap
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, int, int, list[tuple[int, int, int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    wall = int(get_bg(g))
+    non_wall = sorted(set(map(int, g.ravel())) - {wall})
+    assert len(non_wall) == 2, "expected wall color plus exactly two cavity colors"
+    counts = {color: int(np.count_nonzero(g == color)) for color in non_wall}
+    empty = max(non_wall, key=lambda color: counts[color])
+    seed = min(non_wall, key=lambda color: counts[color])
+
+    cavities = []
+    for comp in find_components(g, bg=wall, connectivity=4, monochromatic=False):
+        r0, c0, r1, c1 = comp["bbox"]
+        mask = np.zeros(g.shape, dtype=bool)
+        coords = comp["coords"]
+        mask[coords[:, 0], coords[:, 1]] = True
+        assert mask[r0 : r1 + 1, c0 : c1 + 1].all(), "every cavity must be a full rectangle"
+        cavities.append((r0, c0, r1, c1))
+
+    assert cavities, "expected at least one cavity"
+    return wall, empty, seed, cavities
+
+
+def _render_cavity_mask(
+    shape: tuple[int, int],
+    cavities: list[tuple[int, int, int, int]],
+    bitmap: np.ndarray,
+) -> np.ndarray:
+    pr, pc = bitmap.shape
+    out = np.zeros(shape, dtype=bool)
+    for r0, c0, r1, c1 in cavities:
+        rr = np.arange(r0, r1 + 1)[:, None] % pr
+        cc = np.arange(c0, c1 + 1)[None, :] % pc
+        out[r0 : r1 + 1, c0 : c1 + 1] = bitmap[rr, cc]
+    return out
+
+
+def _candidate_outputs(
+    shape: tuple[int, int],
+    cavities: list[tuple[int, int, int, int]],
+    seed_coords: np.ndarray,
+) -> list[tuple[tuple[int, int, int, int], int, int, np.ndarray, np.ndarray]]:
+    H, W = shape
+    assert seed_coords.size > 0, "at least one visible seed pixel is required"
+    candidates = []
+
+    for pr in range(1, H + 1):
+        for pc in range(1, W + 1):
+            phases = {(int(r) % pr, int(c) % pc) for r, c in seed_coords}
+            if len(phases) == pr * pc:
+                continue
+            bitmap = _phase_set_to_bitmap(pr, pc, phases)
+            if not _is_primitive_bitmap(bitmap):
+                continue
+            score = (pr * pc, len(phases), pr, pc)
+            rendered = _render_cavity_mask(shape, cavities, bitmap)
+            candidates.append((score, pr, pc, bitmap, rendered))
+
+    assert candidates, "failed to infer any non-degenerate periodic mask"
+    return candidates
+
+
+def _infer_global_bitmap(
+    shape: tuple[int, int],
+    cavities: list[tuple[int, int, int, int]],
+    seed_coords: np.ndarray,
+) -> tuple[int, int, np.ndarray]:
+    candidates = _candidate_outputs(shape, cavities, seed_coords)
+    best_score = min(candidate[0] for candidate in candidates)
+    best = [candidate for candidate in candidates if candidate[0] == best_score]
+    unique_outputs = {candidate[4].tobytes(): candidate for candidate in best}
+    assert len(unique_outputs) == 1, "minimal global pattern must be uniquely determined"
+    _score, pr, pc, bitmap, _rendered = next(iter(unique_outputs.values()))
+    return pr, pc, bitmap
+
+
+def _fill_cavities(
+    grid: np.ndarray,
+    cavities: list[tuple[int, int, int, int]],
+    empty: int,
+    seed: int,
+    bitmap: np.ndarray,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    pr, pc = bitmap.shape
+    for r0, c0, r1, c1 in cavities:
+        rr = np.arange(r0, r1 + 1)[:, None] % pr
+        cc = np.arange(c0, c1 + 1)[None, :] % pc
+        mask = bitmap[rr, cc]
+        out[r0 : r1 + 1, c0 : c1 + 1] = np.where(mask, seed, empty)
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill every wall cavity with one globally phased periodic seed mask inferred from all windows together.
+
+    Input structure:
+    - A dominant wall color forms solid barriers around several rectangular cavities.
+    - Inside the cavities there are exactly two non-wall colors: a cavity floor color and one seed color.
+    - The seed pixels are incomplete observations of one shared two-color periodic pattern indexed by absolute grid coordinates.
+
+    Rule:
+    - Treat all cavities as windows onto the same global periodic mask, not as separate local tilings.
+    - Infer the unique smallest primitive period whose repeated seed phases can explain every visible seed pixel across all cavities.
+    - Repaint each cavity completely with that global mask, using the cavity floor color on non-seed phases and leaving the wall unchanged.
+
+    Key insight:
+    - The decisive constraint is cross-cavity phase agreement in the full grid coordinate system: complementary windows reveal different parts of one absolute pattern.
+    """
+    g = np.asarray(grid, dtype=int)
+    _wall, empty, seed, cavities = _parse_scene(g)
+    seed_coords = np.argwhere(g == seed)
+    pr, pc, bitmap = _infer_global_bitmap(g.shape, cavities, seed_coords)
+    return _fill_cavities(g, cavities, empty, seed, bitmap)
