+
+from arc_utils import find_components, get_bg
+
+
+MAX_GEN_ATTEMPTS = 400
+GRID_SIDE_RANGE = (16, 29)
+PERIOD_HEIGHT_RANGE = (2, 5)
+PERIOD_WIDTH_RANGE = (2, 5)
