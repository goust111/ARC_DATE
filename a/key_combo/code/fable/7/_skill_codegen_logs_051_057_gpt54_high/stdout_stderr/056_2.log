+def _infer_global_bitmap(
+    shape: tuple[int, int],
+    cavities: list[tuple[int, int, int, int]],
+    seed_coords: np.ndarray,
+) -> tuple[int, int, np.ndarray]:
+    candidates = _candidate_outputs(shape, cavities, seed_coords)
+    best_score = min(candidate[0] for candidate in candidates)
+    best = [candidate for candidate in candidates if candidate[0] == best_score]
+    unique_outputs = {candidate[4].tobytes(): candidate for candidate in best}
+    assert len(unique_outputs) == 1, "minimal global pattern must be uniquely determined"
