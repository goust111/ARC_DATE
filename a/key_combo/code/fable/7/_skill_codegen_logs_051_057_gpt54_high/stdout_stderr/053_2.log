+def _component_mask(grid: np.ndarray, comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    return region == int(comp["color"])
+
