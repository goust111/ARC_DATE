+        target_idx = -1
+        for j in range(i + 1, n):
+            if used[j] < capacities[j]:
+                target_idx = j
+                break
+        if target_idx == -1:
+            return None
+        lengths.append(widths[i])
+        used[target_idx] += 1
+
