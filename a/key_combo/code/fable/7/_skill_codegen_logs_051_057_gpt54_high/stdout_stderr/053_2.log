+    grid[container.r0 : container.r1 + 1, container.c1] = container.color
+    grid[container.r1, container.c0 : container.c1 + 1] = container.color
+
+
+def _build_attempt() -> np.ndarray | None:
+    n_containers = random.randint(3, 4)
