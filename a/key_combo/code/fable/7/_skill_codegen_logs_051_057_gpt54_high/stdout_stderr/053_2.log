+def _render_output(grid: np.ndarray, containers: list[Container], bars: list[Bar], placements: list[Placement]) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    for bar in bars:
+        out[bar.row, bar.c0 : bar.c0 + bar.length] = BLACK
