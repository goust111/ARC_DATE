+        return None
+
+    extra = random.randint(0, 30 - total_w)
+    total_w += extra
+
+    starts: dict[int, int] = {}
+    c = left_margin
+    for pos, idx in enumerate(order):
+        starts[idx] = c
+        c += outer_ws[idx]
+        if pos < n - 1:
+            c += gaps[pos]
+    return starts, total_w
+
+
+def _choose_bar_colors(lengths: list[int], container_colors: list[int]) -> list[int]:
