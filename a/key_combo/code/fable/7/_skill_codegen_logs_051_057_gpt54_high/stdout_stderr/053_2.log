+    if not any(overflow for _, _, _, overflow in symbolic):
+        return False
+    if not any(not overflow for _, _, _, overflow in symbolic):
+        return False
+    if not chain_seen and sum(1 for _, _, _, overflow in symbolic if overflow) >= 2:
