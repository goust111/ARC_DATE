+            "seed": seed,
+            "color": int(color),
+            "traces": traces,
+            "border": _border_coords(r0, c0, r1, c1),
+        }
+    return None
+
+
+def _place_partial_square(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    side: int,
