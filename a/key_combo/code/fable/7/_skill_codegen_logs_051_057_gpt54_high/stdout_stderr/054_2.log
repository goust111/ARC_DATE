+def _trace_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    return [
+        (r0 - 1, c0),
+        (r0, c0 - 1),
+        (r0 - 1, c1),
+        (r0, c1 + 1),
+        (r1 + 1, c0),
+        (r1, c0 - 1),
+        (r1 + 1, c1),
+        (r1, c1 + 1),
