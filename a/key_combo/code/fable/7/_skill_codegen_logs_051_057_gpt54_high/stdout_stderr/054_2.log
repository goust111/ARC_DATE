+    return not np.any(reserved[br0 : br1 + 1, bc0 : bc1 + 1])
+
+
+def _place_real_square(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    side: int,
+) -> dict | None:
+    h, w = grid.shape
