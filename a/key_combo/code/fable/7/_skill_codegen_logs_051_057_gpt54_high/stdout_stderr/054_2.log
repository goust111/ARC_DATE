+
+def _border_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        coords.append((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c0))
+        coords.append((r, c1))
+    return coords
+
