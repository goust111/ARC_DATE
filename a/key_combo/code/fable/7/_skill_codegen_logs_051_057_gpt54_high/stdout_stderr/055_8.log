+            assert not np.any(settled[before_touch[:, 0], before_touch[:, 1]])
+        bumped = placed + np.array([0, direction * (obj["blue_count"] + 1)], dtype=int)
+        assert np.any(settled[bumped[:, 0], bumped[:, 1]]) or int(bumped[:, 1].min()) < 0 or int(bumped[:, 1].max()) >= w
