+def _touch_shift(coords: np.ndarray, settled: np.ndarray, direction: int, width: int) -> int:
+    shift = 0
+    while True:
+        candidate = coords + np.array([0, shift + direction], dtype=int)
+        cols = candidate[:, 1]
+        if int(cols.min()) < 0 or int(cols.max()) >= int(width):
+            break
