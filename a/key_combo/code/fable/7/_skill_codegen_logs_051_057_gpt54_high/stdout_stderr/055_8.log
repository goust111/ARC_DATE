+            rr = coords[:, 0] - item["top"]
+            cc = coords[:, 1] - left
+            inp[coords[:, 0], coords[:, 1]] = item["patch"][rr, cc]
+            item["input_coords"] = coords
+            item["input_left"] = int(left)
+            all_coords.append(coords)
