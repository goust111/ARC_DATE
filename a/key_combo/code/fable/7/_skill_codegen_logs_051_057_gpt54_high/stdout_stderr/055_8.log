+                    {
+                        "main_color": int(color),
+                        "blue_count": blue_count,
+                        "patch": patch,
+                        "top": int(top),
+                        "final_left": int(final_left),
+                        "final_coords": coords,
+                        "blocked_by_object": blocked_by_object,
+                    }
+                )
+                chain_hit = chain_hit or blocked_by_object
+                break
+            else:
+                continue
+            break
+        else:
+            return None
+
+    if require_chain and not chain_hit:
+        return None
+    return placed
+
+
+def _spread_offsets(side_items: list[dict], width: int, *, left_side: bool) -> list[int] | None:
+    ordered = sorted(side_items, key=lambda item: item["final_left"] if left_side else -(item["final_left"] + item["patch"].shape[1] - 1))
+    offsets: list[int] = []
+    previous = 0
+    for i, item in enumerate(ordered):
+        if left_side:
+            max_offset = width - 1 - (item["final_left"] + item["patch"].shape[1] - 1) - 1
+        else:
+            max_offset = item["final_left"] - 1
+        min_offset = previous + random.randint(1, 3)
+        if max_offset < min_offset:
+            return None
+        remaining = len(ordered) - i - 1
+        slack = max_offset - min_offset
+        reserve = remaining
+        if slack < reserve:
+            return None
+        offset = min_offset + random.randint(0, max(0, slack - reserve))
+        offsets.append(offset)
+        previous = offset
+    return offsets
+
+
+def _build_input_from_layout(
+    h: int,
+    w: int,
+    bg: int,
+    left_color: int,
+    right_color: int,
+    left_items: list[dict],
+    right_items: list[dict],
+) -> np.ndarray | None:
