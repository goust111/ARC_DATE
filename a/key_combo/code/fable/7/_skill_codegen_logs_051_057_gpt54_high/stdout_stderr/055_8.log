+    inp[:, 0] = int(left_color)
+    inp[:, -1] = int(right_color)
+    all_coords: list[np.ndarray] = []
+
+    for side_items, left_side in ((left_items, True), (right_items, False)):
+        ordered = sorted(side_items, key=lambda item: item["final_left"] if left_side else -(item["final_left"] + item["patch"].shape[1] - 1))
+        offsets = _spread_offsets(ordered, w, left_side=left_side)
+        if offsets is None:
+            return None
+        for item, offset in zip(ordered, offsets):
+            left = int(item["final_left"] + offset) if left_side else int(item["final_left"] - offset)
+            coords = _patch_to_coords(item["patch"], item["top"], left, bg)
+            if np.any(inp[coords[:, 0], coords[:, 1]] != int(bg)):
+                return None
+            for other in all_coords:
+                if _pair_touches(coords, other):
