    r0, c0 = qr * QUADRANT_SIZE, qc * QUADRANT_SIZE
    expected[r0 : r0 + QUADRANT_SIZE, c0 : c0 + QUADRANT_SIZE] = RED
    if np.array_equal(main(grid), expected):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
