        cols = {i % MASK_SIDE for i in combo}
        if edge_indices <= rows and edge_indices <= cols:
            choices.append(combo)
    mask = np.zeros((MASK_SIDE, MASK_SIDE), dtype=bool)
    for idx in random.choice(choices):
