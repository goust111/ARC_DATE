+def _extract_instance(grid: np.ndarray) -> tuple[np.ndarray, list[int], list[int], tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+    bg = _get_bg(g)
