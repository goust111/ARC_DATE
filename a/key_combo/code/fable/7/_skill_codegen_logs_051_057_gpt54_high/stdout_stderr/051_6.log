+    random.shuffle(relevant_order)
+    natural_order = [left_colors[idx] for idx in relevant_order if idx != directory_idx]
+    directory_order = natural_order[:]
+    while directory_order == natural_order:
+        directory_order = natural_order[:]
+        random.shuffle(directory_order)
