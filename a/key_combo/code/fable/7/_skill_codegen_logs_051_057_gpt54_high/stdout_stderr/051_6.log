+def _build_instance() -> tuple[np.ndarray, dict]:
+    width = random.randint(*CONTENT_WIDTH_RANGE)
+    row_count = width + 1
+
+    bg = random.choice(PALETTE)
+    available = [color for color in PALETTE if color != bg]
+    random.shuffle(available)
