+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+try:
+    from arc_utils import Color, crop_bbox, get_bg, paste
+except ModuleNotFoundError:
+    utils_dir = Path("/home/lixinyu/snap/new/solvers")
