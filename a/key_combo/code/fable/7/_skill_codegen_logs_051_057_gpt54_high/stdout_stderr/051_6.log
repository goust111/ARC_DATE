+    segments_by_left: dict[int, np.ndarray] = {}
+    for idx, color in enumerate(content_colors):
+        second = None
+        if width >= 4 and random.random() < 0.5:
+            cand = secondary_positions[idx]
+            if cand != primary_positions[idx]:
+                second = int(cand)
