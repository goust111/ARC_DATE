+def _basic_transform_distinct(grid: np.ndarray) -> bool:
+    variants = [
+        (),
+        (RED,),
+        (RED, RED),
+        (RED, RED, RED),
+        (BLUE,),
+        (YELLOW,),
+        (RED, BLUE),
+        (RED, YELLOW),
