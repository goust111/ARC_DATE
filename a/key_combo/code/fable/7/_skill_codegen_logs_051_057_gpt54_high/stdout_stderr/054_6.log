+            continue
+        if not _sequence_semantics_ok(main_region, seq):
+            continue
+
+        grid = np.full((side + 2, side), BG, dtype=int)
+        start = random.randint(0, side - len(seq))
+        grid[0, start : start + len(seq)] = np.array(seq, dtype=int)
+        grid[2:, :] = main_region
+        return grid
+
+    return None
+
