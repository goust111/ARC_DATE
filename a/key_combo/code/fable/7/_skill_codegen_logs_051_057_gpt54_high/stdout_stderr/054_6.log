+def _grow_connected(h: int, w: int, target_cells: int) -> set[tuple[int, int]]:
+    seed = (random.randrange(h), random.randrange(w))
+    cells = {seed}
+    frontier = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                frontier.add((nr, nc))
+
+    add_frontier(*seed)
+    while len(cells) < target_cells and frontier:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        add_frontier(*cell)
+    return cells
+
+
+def _random_bbox_spanning_component(h: int, w: int, target_cells: int) -> set[tuple[int, int]]:
+    cells = {(0, 0)}
+    r = 0
+    c = 0
+    steps = [(1, 0)] * (h - 1) + [(0, 1)] * (w - 1)
+    random.shuffle(steps)
+    for dr, dc in steps:
+        r += dr
+        c += dc
+        cells.add((r, c))
+
+    frontier = set()
+
+    def add_frontier(rr: int, cc: int) -> None:
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                frontier.add((nr, nc))
+
+    for rr, cc in tuple(cells):
+        add_frontier(rr, cc)
+
+    while len(cells) < target_cells and frontier:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        add_frontier(*cell)
+
+    return cells
+
