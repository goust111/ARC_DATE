+
+
+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+
+OPS = (RED, BLUE, YELLOW)
+MOTIF_PALETTE = (3, 5, 6, 7, 8, 9)
+
+SEQ_LEN1 = (
+    (RED,),
+    (BLUE,),
+    (YELLOW,),
+)
+SEQ_LEN2 = (
+    (RED, BLUE),
+    (BLUE, RED),
+    (RED, YELLOW),
+    (YELLOW, RED),
+)
+SEQ_LEN3 = (
+    (RED, RED, BLUE),
+    (RED, BLUE, RED),
+    (BLUE, RED, RED),
+    (RED, RED, YELLOW),
+    (RED, YELLOW, RED),
+    (YELLOW, RED, RED),
+    (RED, BLUE, YELLOW),
+    (RED, YELLOW, BLUE),
+    (BLUE, RED, YELLOW),
+    (YELLOW, RED, BLUE),
+    (BLUE, YELLOW, RED),
+    (YELLOW, BLUE, RED),
+)
