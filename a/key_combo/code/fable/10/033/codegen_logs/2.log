+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    widths = []
+    prev = 0
+    for cut in cuts + [total]:
+        widths.append(cut - prev)
+        prev = cut
+    return widths
