+    legend = parsed["legend"]
+    bg_mask = parsed["region"] == parsed["bg_color"]
+    for r, c in np.argwhere(bg_mask):
+        d = abs(int(r) - src_r) + abs(int(c) - src_c)
+        if d >= 1:
+            region[r, c] = legend[(d - 1) % len(legend)]
