+        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= rr < h and 0 <= cc < w and dist[rr, cc] < 0 and int(region[rr, cc]) != wall_color:
+                dist[rr, cc] = dist[r, c] + 1
