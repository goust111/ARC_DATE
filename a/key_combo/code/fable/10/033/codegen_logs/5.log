+
+def _render_from_boxes(shape: tuple[int, int], blocks: list[dict], walls: list[dict]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    for item in walls + blocks:
+        r0, c0, r1, c1 = item["bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = item["color"]
