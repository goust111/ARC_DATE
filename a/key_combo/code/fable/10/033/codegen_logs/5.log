_GEN_VALID_RADII = [radius for radius, pairs in _GEN_SHAPE_PARAMS_BY_RADIUS.items() if pairs]


def _gen_shape_params() -> tuple[int, int, int]:
    radius = random.choice(_GEN_VALID_RADII)
