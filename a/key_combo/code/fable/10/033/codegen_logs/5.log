+    palette = random.sample(COLORS, 2 + n_primary + n_exit)
+    launcher_color = palette[0]
+    wall_color = palette[1]
+    primary_colors = [launcher_color] + palette[2 : 2 + n_primary]
+    exit_colors = palette[2 + n_primary :]
