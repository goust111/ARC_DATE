+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIRS = {
+    "R": (0, 1),
+    "L": (0, -1),
+    "D": (1, 0),
+    "U": (-1, 0),
+}
+
+PERPENDICULAR = {
+    "R": ("U", "D"),
+    "L": ("U", "D"),
+    "U": ("L", "R"),
+    "D": ("L", "R"),
+}
+
+COLORS = list(range(1, 10))
+BG = 0
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _touch_side(box: tuple[int, int, int, int], shape: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    sides = []
+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    if len(sides) != 1:
+        return None
+    return sides[0]
+
+
+def _side_to_dir(side: str) -> str:
+    return {"left": "R", "right": "L", "top": "D", "bottom": "U"}[side]
+
+
+def _solid_rect(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return int(comp["coords"].shape[0]) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comp_map = np.full((h, w), -1, dtype=int)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(pts, dtype=int)
+            cid = len(comps)
+            comp_map[coords[:, 0], coords[:, 1]] = cid
+            comps.append(
+                {
+                    "id": cid,
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                }
+            )
+    return comps, comp_map
+
+
+def _lane_band(comp: dict, direction: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = comp["bbox"]
+    if direction in ("R", "L"):
+        return r0, r1
+    return c0, c1
+
+
+def _lane_thickness(comp: dict, direction: str) -> int:
+    r0, c0, r1, c1 = comp["bbox"]
+    return (r1 - r0 + 1) if direction in ("R", "L") else (c1 - c0 + 1)
+
