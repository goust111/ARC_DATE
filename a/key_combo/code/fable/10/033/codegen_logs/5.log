+            cid = len(comps)
+            comp_map[coords[:, 0], coords[:, 1]] = cid
+            comps.append(
+                {
+                    "id": cid,
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                }
+            )
+    return comps, comp_map
+
+
+def _lane_band(comp: dict, direction: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = comp["bbox"]
+    if direction in ("R", "L"):
+        return r0, r1
+    return c0, c1
+
+
+def _lane_thickness(comp: dict, direction: str) -> int:
+    r0, c0, r1, c1 = comp["bbox"]
+    return (r1 - r0 + 1) if direction in ("R", "L") else (c1 - c0 + 1)
+
+
+def _lane_shaped(comp: dict, band: tuple[int, int], direction: str) -> bool:
+    if not _solid_rect(comp):
+        return False
+    r0, c0, r1, c1 = comp["bbox"]
+    if direction in ("R", "L"):
+        return (r0, r1) == band
+    return (c0, c1) == band
+
+
+def _scan_lane(
+    comp_map: np.ndarray,
+    comps: list[dict],
+    band: tuple[int, int],
+    direction: str,
+    start: int,
+) -> list[dict]:
+    h, w = comp_map.shape
+    out = []
+    last_id = None
+    if direction == "R":
+        axis = range(start, w)
+        for c in axis:
+            ids = set(int(x) for x in comp_map[band[0] : band[1] + 1, c] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
+    elif direction == "L":
+        axis = range(start, -1, -1)
+        for c in axis:
+            ids = set(int(x) for x in comp_map[band[0] : band[1] + 1, c] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
+    elif direction == "D":
+        axis = range(start, h)
+        for r in axis:
+            ids = set(int(x) for x in comp_map[r, band[0] : band[1] + 1] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
+    else:
+        axis = range(start, -1, -1)
+        for r in axis:
+            ids = set(int(x) for x in comp_map[r, band[0] : band[1] + 1] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
+    return out
+
+
+def _front_start(comp: dict, direction: str) -> int:
+    r0, c0, r1, c1 = comp["bbox"]
+    if direction == "R":
+        return c1 + 1
+    if direction == "L":
+        return c0 - 1
+    if direction == "D":
+        return r1 + 1
+    return r0 - 1
+
+
+def _gap_to_obstacle(comp: dict, obstacle: dict | None, direction: str, shape: tuple[int, int]) -> int:
+    h, w = shape
+    r0, c0, r1, c1 = comp["bbox"]
+    if obstacle is None:
+        if direction == "R":
+            return w - 1 - c1
+        if direction == "L":
+            return c0
+        if direction == "D":
+            return h - 1 - r1
+        return r0
+    or0, oc0, or1, oc1 = obstacle["bbox"]
+    if direction == "R":
+        return oc0 - c1 - 1
+    if direction == "L":
+        return c0 - oc1 - 1
+    if direction == "D":
+        return or0 - r1 - 1
+    return r0 - or1 - 1
+
+
+def _shift_coords(coords: np.ndarray, direction: str, dist: int) -> np.ndarray:
+    dr, dc = DIRS[direction]
+    delta = np.array([dr * dist, dc * dist], dtype=int)
+    return coords + delta
+
+
+def _detect_corner(
+    comp: dict,
+    incoming: str,
+    comp_map: np.ndarray,
+    comps: list[dict],
+) -> str | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    if not _solid_rect(comp):
+        return None
+    if (r1 - r0) != (c1 - c0):
+        return None
+    band_size = _lane_thickness(comp, incoming)
+    if (r1 - r0 + 1) != band_size or (c1 - c0 + 1) != band_size:
+        return None
+
+    exits = []
+    for direction in PERPENDICULAR[incoming]:
+        if direction in ("U", "D"):
+            band = (c0, c1)
+        else:
+            band = (r0, r1)
+        start = _front_start(comp, direction)
+        seen = _scan_lane(comp_map, comps, band, direction, start)
+        if seen:
+            exits.append(direction)
+    if len(exits) == 1:
+        return exits[0]
+    return None
+
+
+def _parse_lane(
+    comp_map: np.ndarray,
+    comps: list[dict],
+    start_comp: dict,
+    direction: str,
+    shape: tuple[int, int],
+) -> dict:
+    band = _lane_band(start_comp, direction)
+    seen = _scan_lane(comp_map, comps, band, direction, _front_start(start_comp, direction))
+    assert seen, "lane must contain at least one component ahead"
+
+    for comp in seen[:-1]:
+        assert _lane_shaped(comp, band, direction), "intermediate lane blocks must be lane-shaped"
+
+    last = seen[-1]
+    exit_dir = _detect_corner(last, direction, comp_map, comps)
+    if exit_dir is not None:
+        free = seen[:-1]
+        assert free, "corner lane must contain free blocks before the corner"
+        return {
+            "band": band,
+            "movables": [start_comp] + free if start_comp["kind"] == "launcher" else free,
+            "terminal": last,
+            "terminal_kind": "corner",
+            "exit_dir": exit_dir,
+        }
+
+    if _lane_shaped(last, band, direction):
+        free = seen
+        terminal = None
+        terminal_kind = "boundary"
+    else:
+        free = seen[:-1]
+        terminal = last
+        terminal_kind = "wall"
+    if start_comp["kind"] == "launcher":
+        free = [start_comp] + free
+    assert free, "lane must have at least one movable block"
+    return {
+        "band": band,
+        "movables": free,
+        "terminal": terminal,
+        "terminal_kind": terminal_kind,
+        "exit_dir": None,
+    }
+
+
+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    comps, comp_map = _find_components(g, bg)
+    launchers = []
+    for comp in comps:
+        side = _touch_side(comp["bbox"], g.shape)
+        if side is not None and _solid_rect(comp):
+            launchers.append((comp, side))
