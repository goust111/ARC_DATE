+                    "kind": "wall",
+                    "color": wall_color,
+                    "bbox": (wall_top, corner_c0 - 1, wall_top + wall_h - 1, corner_c0 + t),
+                }
+            )
+            terminal = walls[-1]
+        else:
+            terminal = None
+
+    w = corner_c0 + t + right_margin
+    assert h <= 30 and w <= 30
+    assert corner_c0 >= 1 and corner_c0 + t <= w - 1
+
+    for block in primary_blocks:
