+        for c in axis:
+            ids = set(int(x) for x in comp_map[band[0] : band[1] + 1, c] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
+    elif direction == "D":
+        axis = range(start, h)
+        for r in axis:
+            ids = set(int(x) for x in comp_map[r, band[0] : band[1] + 1] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
+    else:
+        axis = range(start, -1, -1)
+        for r in axis:
+            ids = set(int(x) for x in comp_map[r, band[0] : band[1] + 1] if int(x) >= 0)
+            assert len(ids) <= 1
+            if not ids:
+                last_id = None
+                continue
+            cid = next(iter(ids))
+            if cid != last_id:
+                out.append(comps[cid])
+            last_id = cid
