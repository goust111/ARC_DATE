+
+        exit_blocks = []
+        bottom = row0 - corner_gap - 1
+        for i, length in enumerate(exit_lens):
+            top = bottom - length + 1
+            exit_blocks.append({"kind": "free", "color": exit_colors[i], "bbox": (top, corner_c0, bottom, corner_c0 + t - 1)})
+            if i < len(exit_gaps):
