+                None if obstacle is None else {"bbox": obstacle["bbox"]},
+                direction,
+                shape,
+            )
+            r0, c0, r1, c1 = block["bbox"]
+            dr, dc = DIRS[direction]
+            shifted = (r0 + dr * gap, c0 + dc * gap, r1 + dr * gap, c1 + dc * gap)
+            rr0, cc0, rr1, cc1 = shifted
+            out[rr0 : rr1 + 1, cc0 : cc1 + 1] = block["color"]
