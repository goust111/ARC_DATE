+        wall_h = random.randint(1, 2) if exit_wall else 0
+        above = corner_gap + sum(exit_lens) + sum(exit_gaps) + exit_front_gap + top_pad + wall_h
+        row0 = above
+        h = row0 + t + bottom_margin
