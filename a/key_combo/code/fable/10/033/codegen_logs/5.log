+BG = 0
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _touch_side(box: tuple[int, int, int, int], shape: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    sides = []
+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    if len(sides) != 1:
+        return None
+    return sides[0]
+
+
+def _side_to_dir(side: str) -> str:
+    return {"left": "R", "right": "L", "top": "D", "bottom": "U"}[side]
+
+
+def _solid_rect(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return int(comp["coords"].shape[0]) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comp_map = np.full((h, w), -1, dtype=int)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
