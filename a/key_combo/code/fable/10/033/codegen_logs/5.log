+
+DIRS = {
+    "R": (0, 1),
+    "L": (0, -1),
+    "D": (1, 0),
+    "U": (-1, 0),
+}
+
+PERPENDICULAR = {
+    "R": ("U", "D"),
+    "L": ("U", "D"),
+    "U": ("L", "R"),
+    "D": ("L", "R"),
+}
