+
+
+def _front_start(comp: dict, direction: str) -> int:
+    r0, c0, r1, c1 = comp["bbox"]
+    if direction == "R":
+        return c1 + 1
+    if direction == "L":
+        return c0 - 1
+    if direction == "D":
+        return r1 + 1
+    return r0 - 1
+
+
+def _gap_to_obstacle(comp: dict, obstacle: dict | None, direction: str, shape: tuple[int, int]) -> int:
+    h, w = shape
+    r0, c0, r1, c1 = comp["bbox"]
+    if obstacle is None:
+        if direction == "R":
+            return w - 1 - c1
+        if direction == "L":
+            return c0
+        if direction == "D":
+            return h - 1 - r1
