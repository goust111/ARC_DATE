+    placed = _place_rectangles(rng, height, width, sizes)
+    if placed is None:
+        return None
+
+    bg = _randint(rng, 0, 9)
+    palette = [color for color in range(10) if color != bg]
+    rng.shuffle(palette)
+    marker = int(palette[0])
+    corner_colors = [int(color) for color in palette[1 : rect_count + 1]]
