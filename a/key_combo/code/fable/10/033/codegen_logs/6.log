+                continue
+            rect = _rectangle_from_triplet(np.argwhere(grid == color))
+            if rect is None:
+                ok = False
+                break
+            mr, mc = rect["missing"]
+            if int(grid[mr, mc]) != marker:
+                ok = False
+                break
