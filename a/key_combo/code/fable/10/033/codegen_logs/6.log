+    c0, c1 = map(int, cols)
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    present = {(int(r), int(c)) for r, c in coords}
+    missing = list(corners - present)
+    if len(missing) != 1:
+        return None
+
+    return {"r0": r0, "c0": c0, "r1": r1, "c1": c1, "missing": missing[0]}
