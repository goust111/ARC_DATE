+def _rectangles_overlap(a: dict, b: dict) -> bool:
+    return not (
+        a["r1"] < b["r0"]
+        or b["r1"] < a["r0"]
+        or a["c1"] < b["c0"]
+        or b["c1"] < a["c0"]
+    )
