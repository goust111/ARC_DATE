+def _rectangle_from_triplet(coords: np.ndarray) -> dict | None:
+    if coords.shape[0] != 3:
+        return None
+    rows = np.unique(coords[:, 0])
+    cols = np.unique(coords[:, 1])
+    if rows.size != 2 or cols.size != 2:
+        return None
