+
+
+GRID_SIDE_RANGE = (16, 28)
+RECT_COUNT_RANGE = (2, 4)
+RECT_SIDE_RANGE = (5, 9)
+RECT_GAP = 1
+INTERIOR_MARKER_CHOICES = (0, 1, 1, 2, 2, 3)
+OUTSIDE_BAIT_RANGE = (1, 5)
