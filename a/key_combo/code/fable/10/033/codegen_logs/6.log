+    if np.array_equal(expected, _wrong_keep_outside_markers(inp)):
+        return None
+    if np.array_equal(expected, _wrong_unclipped_crosses(inp)):
+        return None
+    if np.array_equal(expected, _wrong_leave_missing_as_marker(inp)):
+        return None
+    return inp, expected
