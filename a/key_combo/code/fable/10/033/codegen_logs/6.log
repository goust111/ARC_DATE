+
+def _build_attempt(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    height = _randint(rng, *GRID_SIDE_RANGE)
+    width = _randint(rng, *GRID_SIDE_RANGE)
+    rect_count = _randint(rng, *RECT_COUNT_RANGE)
