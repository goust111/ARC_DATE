+    area = h * w
+    filled = int(mask.sum())
+    if filled < 3 or filled > area - 2:
+        return False
+    if _occupied_span_count(mask, axis=1) < 2 or _occupied_span_count(mask, axis=0) < 2:
+        return False
+    comps = _component_count(mask)
+    if comps < 1 or comps > 3:
+        return False
+    return True
+
