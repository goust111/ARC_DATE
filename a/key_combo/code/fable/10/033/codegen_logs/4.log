+    h, w = top.shape
+    stamp = top if use_top else bottom
+    out = np.full((h * h, w * w), bg, dtype=int)
+    xor_mask = (top != bg) ^ (bottom != bg)
+    for r, c in np.argwhere(xor_mask):
+        out[r * h : (r + 1) * h, c * w : (c + 1) * w] = stamp
+    return out
+
