+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+    return count
+
