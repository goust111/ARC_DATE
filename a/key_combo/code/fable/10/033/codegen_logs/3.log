+        pts = [(r, c + shear * r) for r, c in pts]
+        pts = _normalize(pts)
+    else:
+        pts = _normalize(pts)
+    h = max(r for r, _c in pts) + 1
+    w = max(c for _r, c in pts) + 1
+    rotated = []
+    for r, c in pts:
+        if rot == 0:
+            rr, cc = r, c
+            h2, w2 = h, w
+        elif rot == 1:
+            rr, cc = c, h - 1 - r
+            h2, w2 = w, h
+        elif rot == 2:
+            rr, cc = h - 1 - r, w - 1 - c
+            h2, w2 = h, w
