+def _is_simple_polygon(cycle: list[tuple[int, int]]) -> bool:
+    n = len(cycle)
+    for i in range(n):
+        a1 = cycle[i]
+        a2 = cycle[(i + 1) % n]
+        for j in range(i + 1, n):
+            if j in {i, (i + 1) % n}:
+                continue
+            if (j + 1) % n == i:
+                continue
+            b1 = cycle[j]
+            b2 = cycle[(j + 1) % n]
