+    vertices = [tuple(map(int, p)) for p in np.argwhere(g == outline_color)]
+    cycle = _angle_cycle(vertices)
+    boundary, interior = _polygon_masks(g.shape, cycle)
+
+    winners = []
+    for r, c in np.argwhere((g != bg) & (g != outline_color)):
+        rr = int(r)
+        cc = int(c)
+        if boundary[rr, cc]:
