+def _is_concave(cycle: list[tuple[int, int]]) -> bool:
+    signs = []
+    n = len(cycle)
+    for i in range(n):
+        val = _cross(cycle[i - 1], cycle[i], cycle[(i + 1) % n])
+        if val != 0:
+            signs.append(1 if val > 0 else -1)
+    return len(set(signs)) > 1
