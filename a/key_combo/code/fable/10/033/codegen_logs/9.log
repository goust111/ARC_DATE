+    grid[r0 : r0 + side, c0] = color
+    grid[r0 : r0 + side, c0 + side - 1] = color
+
+
+def _draw_valid_frame(grid: np.ndarray, r0: int, c0: int, ring_color: int, center_color: int) -> None:
+    for dr, dc in RING_COORDS:
