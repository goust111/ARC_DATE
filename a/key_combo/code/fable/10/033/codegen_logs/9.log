+
+BG = 0
+PALETTE = tuple(range(1, 10))
+RING_COORDS = (
+    (0, 0), (0, 1), (0, 2),
+    (1, 0),         (1, 2),
+    (2, 0), (2, 1), (2, 2),
+)
+
+GEN_RETRIES = 800
+SEEN_INPUT_SIGS: set[tuple[tuple[int, int], bytes]] = set()
+SEEN_OUTPUT_SIGS: set[tuple[tuple[int, int], bytes]] = set()
