    inp, expected = _gen_render(top_mask, bottom_mask)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(GENERATION_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate a valid 31d5ba1a input")

