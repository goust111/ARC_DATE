+        r0, c0, r1, c1 = rect["r0"], rect["c0"], rect["r1"], rect["c1"]
+        if rect["side"] in ("top", "bottom"):
+            coverage[:, c0 : c1 + 1] += 1
+        else:
+            coverage[r0 : r1 + 1, :] += 1
+        dr0, dc0, dr1, dc1 = _destination(rect, shape)
+        dest_mask[dr0 : dr1 + 1, dc0 : dc1 + 1] = True
