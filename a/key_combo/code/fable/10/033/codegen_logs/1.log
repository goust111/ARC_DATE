+def _make_rect(side: str, band0: int, band1: int, depth: int, shape: tuple[int, int]) -> dict[str, int]:
+    h, w = shape
+    if side == "top":
+        return {"side": side, "r0": 0, "c0": band0, "r1": depth - 1, "c1": band1}
+    if side == "bottom":
