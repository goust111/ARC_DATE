  17: def main(grid: np.ndarray) -> np.ndarray:
  18:     """
  19:     Recolor each 8-connected foreground object by whether its normalized shape is repeated or unique.
  20: 
  21:     Input structure
  22:     - The dominant background contains several same-color foreground objects.
  23:     - Objects are 8-connected; diagonal contact joins pixels into the same object.
  24:     - Up to translation within each bbox, exactly one object shape appears once
  25:       and exactly one other object shape appears multiple times.
  26: 
  27:     Rule
  28:     - Group foreground objects by their normalized bbox mask.
  29:     - Recolor the singleton-shape object red.
  30:     - Recolor every repeated-shape object blue.
  31:     - Keep the background unchanged.
  32: 
  33:     Key insight
  34:     - The recolor is determined by object-shape frequency, not by position or size alone.
  35:     """
  36:     g = np.asarray(grid, dtype=int)
  37:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
  38: 
  39:     bg = get_bg(g)
  40:     fg_colors = colors_present(g, exclude={bg})
  41:     assert len(fg_colors) == 1, "expected one foreground color"
  42: 
  43:     components = find_components(
  44:         g,
  45:         bg=bg,
  46:         connectivity=8,
  47:         monochromatic=True,
  48:         colors=fg_colors,
  49:         return_format="dict",
  50:     )
  51:     assert len(components) >= 2, "expected multiple foreground objects"
  52: 
  53:     shape_keys = [_shape_key(component["coords"]) for component in components]
  54:     counts = Counter(shape_keys)
  55:     singleton_shapes = {key for key, count in counts.items() if count == 1}
  56:     repeated_shapes = {key for key, count in counts.items() if count > 1}
  57:     assert len(singleton_shapes) == 1, "expected exactly one singleton object shape"
  58:     assert len(repeated_shapes) == 1, "expected exactly one repeated object shape"
  59: 
  60:     out = g.copy()
  61:     for component, shape_key in zip(components, shape_keys):
  62:         coords = component["coords"]
  63:         color = 2 if shape_key in singleton_shapes else 1
  64:         out[coords[:, 0], coords[:, 1]] = color
  65: 
  66:     return out
