 103: def _gen_random_shape() -> np.ndarray:
 104:     h = random.randint(*SHAPE_HEIGHT_RANGE)
 105:     w = random.randint(*SHAPE_WIDTH_RANGE)
 106:     area = random.randint(max(SHAPE_AREA_RANGE[0], h, w), min(SHAPE_AREA_RANGE[1], h * w))
 107: 
 108:     path_len = random.randint(max(h, w), min(h + w - 1, area))
 109:     diag_count = h + w - 1 - path_len
 110:     steps = (
 111:         [(1, 1)] * diag_count
 112:         + [(1, 0)] * (h - 1 - diag_count)
 113:         + [(0, 1)] * (w - 1 - diag_count)
 114:     )
 115:     random.shuffle(steps)
 116: 
 117:     mask = np.zeros((h, w), dtype=bool)
 118:     r = c = 0
 119:     mask[r, c] = True
 120:     for dr, dc in steps:
 121:         r += dr
 122:         c += dc
 123:         mask[r, c] = True
 124: 
 125:     while int(mask.sum()) < area:
 126:         frontier = set()
 127:         for rr, cc in np.argwhere(mask):
 128:             for dr, dc in NEIGHBOR_DELTAS_8:
 129:                 nr = int(rr) + dr
 130:                 nc = int(cc) + dc
 131:                 if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
 132:                     frontier.add((nr, nc))
 133:         if not frontier:
 134:             break
 135:         nr, nc = random.choice(tuple(frontier))
 136:         mask[nr, nc] = True
