 164: def _gen_mark_col(mask: np.ndarray, col: int, r0: int, r1: int) -> bool:
 165:     rows, cols = mask.shape
 166:     clipped = not 0 <= col < cols or r0 < 0 or r1 >= rows
 167:     if 0 <= col < cols:
 168:         lo = max(0, int(r0))
 169:         hi = min(rows - 1, int(r1))
 170:         if lo <= hi:
 171:             mask[lo : hi + 1, int(col)] = True
 172:     return clipped
