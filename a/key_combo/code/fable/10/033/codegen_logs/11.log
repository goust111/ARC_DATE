1249: def detect_mirror_symmetry(
1250:     grid: np.ndarray,
1251:     ignore_colors: list[int] | None = None,
1252:     background: int | None = None,
1253: ) -> list[Symmetry]:
1254:     """Detect mirror symmetries. Returns a list (possibly empty)."""
1255:     if ignore_colors is None:
1256:         ignore_colors = [Color.BLACK]
1257:     ignore_colors = [int(c) for c in ignore_colors]
1258: 
1259:     n, m = grid.shape
1260:     rc_poss = [MirrorSymmetry(mirror_r=rc + z, mirror_c=cc + z) for rc in range(n) for cc in range(m) for z in (0, 0.5)]
1261:     r_poss = [MirrorSymmetry(mirror_r=rc + z, mirror_c=None) for rc in range(n) for z in (0, 0.5)]
1262:     c_poss = [MirrorSymmetry(mirror_r=None, mirror_c=cc + z) for cc in range(m) for z in (0, 0.5)]
1263: 
1264:     best, best_score = [], 0.0
1265:     for sym in r_poss + c_poss + rc_poss:
1266:         perfectly_preserved, outside_canvas, conflict = _score_symmetry(grid, sym, ignore_colors, background=background)
1267:         score = perfectly_preserved - 0.01 * outside_canvas - 10000 * conflict
1268:         if conflict > 0 or perfectly_preserved == 0:
1269:             continue
1270:         if score > best_score:
1271:             best = [sym]
1272:             best_score = score
1273:         elif score == best_score:
1274:             best.append(sym)
1275:     return best
1276: 
1277: 
1278: def detect_rotational_symmetry(
1279:     grid: np.ndarray,
1280:     ignore_colors: list[int] | None = None,
1281:     background: int | None = None,
1282: ) -> Symmetry | None:
1283:     """Detect best rotational symmetry (90-degree steps). Returns a Symmetry or None."""
1284:     if ignore_colors is None:
1285:         ignore_colors = [Color.BLACK]
1286:     ignore_colors = [int(c) for c in ignore_colors]
1287: 
1288:     class RotationalSymmetry(Symmetry):
1289:         def __init__(self, center_r: float, center_c: float):
1290:             self.center_r, self.center_c = center_r, center_c
1291: 
1292:         def apply(self, r, c, iters: int = 1):
1293:             r, c = r - self.center_r, c - self.center_c
1294:             for _ in range(abs(int(iters))):
1295:                 if int(iters) >= 0:
1296:                     r, c = c, -r
1297:                 else:
1298:                     r, c = -c, r
1299:             r, c = r + self.center_r, c + self.center_c
1300:             if isinstance(r, np.ndarray):
1301:                 r = r.astype(int)
1302:             if isinstance(c, np.ndarray):
1303:                 c = c.astype(int)
1304:             if isinstance(r, float):
1305:                 r = int(round(r))
1306:             if isinstance(c, float):
1307:                 c = int(round(c))
1308:             return r, c
1309: 
1310:         def _iter_range(self, grid_shape: tuple[int, int]):
1311:             return (0, 4)
1312: 
1313:     n, m = grid.shape
1314:     possibilities = [RotationalSymmetry(center_r=rc + z, center_c=cc + z) for rc in range(n) for cc in range(m) for z in (0, 0.5)]
1315: 
1316:     best_sym, best_score = None, 0.0
1317:     for sym in possibilities:
1318:         perfectly_preserved, outside_canvas, conflict = _score_symmetry(grid, sym, ignore_colors, background=background)
1319:         score = perfectly_preserved - 5 * outside_canvas - 1000 * conflict
1320:         if score > best_score:
1321:             best_sym = sym
1322:             best_score = score
1323:     return best_sym
