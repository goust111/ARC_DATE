 103: def _partition_bands(
 104:     total: int, n: int, min_size: int, max_size: int, min_gap: int = 0
 105: ) -> list[tuple[int, int]] | None:
 106:     """Place n non-overlapping inclusive bands inside [0, total - 1]."""
 107:     if n == 0:
 108:         return []
 109: 
 110:     needed = n * min_size + (n - 1) * min_gap
 111:     if needed > total:
 112:         return None
 113: 
 114:     effective_max = min(max_size, total - (n - 1) * (min_size + min_gap))
 115:     if effective_max < min_size:
 116:         return None
 117: 
 118:     widths = [random.randint(min_size, effective_max) for _ in range(n)]
 119:     total_used = sum(widths) + (n - 1) * min_gap
 120:     if total_used > total:
 121:         excess = total_used - total
 122:         indices = list(range(n))
 123:         random.shuffle(indices)
 124:         for i in indices:
 125:             shrink = min(widths[i] - min_size, excess)
 126:             widths[i] -= shrink
 127:             excess -= shrink
 128:             if excess == 0:
 129:                 break
 130:         if excess > 0:
 131:             return None
 132: 
 133:     remaining = total - sum(widths) - (n - 1) * min_gap
 134:     extra_gaps = [0] * (n + 1)
 135:     for _ in range(remaining):
 136:         extra_gaps[random.randint(0, n)] += 1
 137: 
 138:     bands = []
 139:     pos = 0
 140:     for i in range(n):
 141:         pos += extra_gaps[i]
 142:         if i > 0:
 143:             pos += min_gap
 144:         bands.append((pos, pos + widths[i] - 1))
 145:         pos += widths[i]
 146:     return bands
 147: 
