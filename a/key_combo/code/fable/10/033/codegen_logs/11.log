+    r0a, c0a, r1a, c1a = map(int, comp_a["bbox"])
+    r0b, c0b, r1b, c1b = map(int, comp_b["bbox"])
+    sum_r_1 = r0a + r1b
+    sum_r_2 = r1a + r0b
+    sum_c_1 = c0a + c1b
+    sum_c_2 = c1a + c0b
+    if sum_r_1 != sum_r_2 or sum_c_1 != sum_c_2:
+        return None
+
+    sum_r = int(sum_r_1)
+    sum_c = int(sum_c_1)
+    coords_b = _coord_set(comp_b["coords"])
+    mapped = {(sum_r - int(r), sum_c - int(c)) for r, c in comp_a["coords"]}
+    if mapped != coords_b:
