 153: def _gen_mark_row(mask: np.ndarray, row: int, c0: int, c1: int) -> bool:
 154:     rows, cols = mask.shape
 155:     clipped = not 0 <= row < rows or c0 < 0 or c1 >= cols
 156:     if 0 <= row < rows:
 157:         lo = max(0, int(c0))
 158:         hi = min(cols - 1, int(c1))
 159:         if lo <= hi:
 160:             mask[int(row), lo : hi + 1] = True
 161:     return clipped
 162: 
