  11: # In the input you will see two monochromatic objects -- "puzzle pieces"
  12: # To make the output, fit the pieces together so that they form a single tightly-packed rectangular object. The pieces can be translated, but not rotated.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Fit two monochromatic puzzle pieces together into the tightest rectangular assembly.
  17: 
  18:     Input structure:
  19:     - The input is a black grid containing exactly two non-black monochromatic objects.
  20:     - Each object is a puzzle piece that may be translated but not rotated.
  21:     - The pieces come from a compact two-color object.
  22: 
  23:     Rule:
  24:     - Crop the two pieces from the input.
  25:     - Try all non-overlapping translations on a canvas large enough to hold both pieces.
  26:     - Return the placement whose cropped bounding box leaves the fewest black cells.
  27: 
  28:     Key insight:
  29:     - The reconstruction is the densest translation-only packing of the two pieces.
  30:     """
  31:     # Plan:
  32:     # 1. Detect the pieces
  33:     # 2. Consider different ways of placing them together
  34:     # 3. Pick the way which makes them the most tightly packed, meaning that there is as little empty pixels remaining as possible
  35: 
  36:     # 1. Extract puzzle pieces
  37:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
  38:     assert len(objects) == 2, "There should be exactly 2 objects"
  39:     sprites = []
  40:     for obj in objects:
  41:         _b = bbox(obj != Color.BLACK)
  42:         assert _b is not None
  43:         sprites.append(crop_bbox(obj, _b))
  44:     
  45:     width = max(sprite.shape[0] for sprite in sprites) + min(sprite.shape[0] for sprite in sprites)
  46:     height = max(sprite.shape[1] for sprite in sprites) + min(sprite.shape[1] for sprite in sprites)
  47:     output_grid = np.full((width, height), Color.BLACK)
  48: 
  49:     # 2. Try to fit the pieces together
  50:     possible_placements = [ (x1, x2, y1, y2)
  51:                            for x1 in range(width - sprites[0].shape[0] + 1)
  52:                            for x2 in range(width - sprites[1].shape[0] + 1)
  53:                            for y1 in range(height - sprites[0].shape[1] + 1)
  54:                            for y2 in range(height - sprites[1].shape[1] + 1) 
  55:                            if not collision(object1=sprites[0], object2=sprites[1], r1=x1, r2=x2, c1=y1, c2=y2) ]
  56:     
  57:     def score_placement(x1, x2, y1, y2):
  58:         # We are trying to make the puzzle pieces fit together perfectly
  59:         # Therefore, there shouldn't be very many unfilled (black) pixels remaining after we place the pieces
  60:         # So we are minimizing the number of black pixels
  61:         # Equivalently maximizing the negative number of black pixels
  62:         test_canvas = np.full_like(output_grid, Color.BLACK)
  63:         paste(test_canvas, sprites[0], x1, y1, transparent=Color.BLACK, clip=True)
  64:         paste(test_canvas, sprites[1], x2, y2, transparent=Color.BLACK, clip=True)
  65:         _b = bbox(test_canvas != Color.BLACK)
  66:         assert _b is not None
  67:         test_canvas = crop_bbox(test_canvas, _b)
  68:         return -np.sum(test_canvas == Color.BLACK)
  69:     
  70:     # pick the best one
  71:     x1, x2, y1, y2 = max(possible_placements, key=lambda placement: score_placement(*placement))
  72:     paste(output_grid, sprites[0], x1, y1, transparent=Color.BLACK, clip=True)
  73:     paste(output_grid, sprites[1], x2, y2, transparent=Color.BLACK, clip=True)
  74: 
  75:     _b = bbox(output_grid != Color.BLACK)
  76:     assert _b is not None
  77:     return crop_bbox(output_grid, _b)
