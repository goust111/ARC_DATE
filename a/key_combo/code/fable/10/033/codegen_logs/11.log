  47: def main(grid: np.ndarray) -> np.ndarray:
  48:     """
  49:     Paint the unique shortest background path between the two red endpoints yellow.
  50: 
  51:     Input structure
  52:     - The grid contains black background cells, blue blocker cells, and exactly two red endpoint pixels.
  53:     - The endpoints are connected by one shortest 4-neighbor route through non-blue cells.
  54: 
  55:     Rule
  56:     - Keep every original cell unchanged.
  57:     - Find the unique shortest 4-neighbor path from one red endpoint to the other while treating blue cells as blocked.
  58:     - Recolor only the black interior cells of that path to yellow.
  59: 
  60:     Key insight
  61:     - The blue cells form maze walls, and the output is the single shortest corridor between the two red endpoints.
  62:     """
  63:     g = np.asarray(grid, dtype=int)
  64:     assert g.ndim == 2, "expected a 2D grid"
  65:     assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.BLUE, Color.RED}, "unexpected input colors"
  66: 
  67:     red_coords = np.argwhere(g == Color.RED)
  68:     assert red_coords.shape == (2, 2), "expected exactly two red endpoints"
  69:     start = tuple(map(int, red_coords[0]))
  70:     goal = tuple(map(int, red_coords[1]))
  71: 
  72:     out = g.copy()
  73:     for r, c in _unique_shortest_path(g, start, goal):
  74:         assert int(out[r, c]) == Color.BLACK, "path interior should contain only background cells"
  75:         out[r, c] = Color.YELLOW
  76:     return out
