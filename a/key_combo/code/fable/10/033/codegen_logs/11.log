 175: def _gen_paint_shrinking_rows(mask: np.ndarray, row: int, step: int, c0: int, c1: int) -> bool:
 176:     source_length = int(c1) - int(c0) + 1
 177:     clipped = False
 178:     distance = 1
 179:     length = source_length - _GEN_CAP_SHRINK
 180:     while length > 0:
 181:         lo, hi = _gen_centered_span(c0, c1, length)
 182:         clipped |= _gen_mark_row(mask, int(row) + int(step) * distance, lo, hi)
 183:         distance += 1
 184:         length -= _GEN_CAP_SHRINK
 185:     return clipped
