 427:         raise ValueError("find_components: return_format must be 'dict' or 'objects'")
 428: 
 429:     if colors is None:
 430:         colors_set = None
 431:         colors_iter = sorted(set(map(int, grid.flatten())) - {bg})
 432:     else:
 433:         colors_set = {int(c) for c in colors}
 434:         colors_iter = [int(c) for c in colors_set if int(c) != bg]
 435: 
 436:     # Monochromatic = label per-color
 437:     if monochromatic:
 438:         if return_format == "dict":
 439:             out: list[dict] = []
 440:             for col in colors_iter:
 441:                 mask = (grid == col)
 442:                 if not mask.any():
 443:                     continue
 444:                 comps = components_mask(mask, connectivity=connectivity)
 445:                 for coords in comps:
 446:                     if int(coords.shape[0]) < int(min_area):
 447:                         continue
 448:                     out.append(
 449:                         {
 450:                             "color": int(col),
 451:                             "coords": coords,
 452:                             "bbox": bbox_coords(coords),
 453:                             "area": int(coords.shape[0]),
 454:                         }
 455:                     )
 456:             return out
 457: 
 458:         objs: list[np.ndarray] = []
 459:         struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
 460:         for col in colors_iter:
 461:             lab, n = label(grid == int(col), structure=struct)
 462:             for k in range(1, int(n) + 1):
