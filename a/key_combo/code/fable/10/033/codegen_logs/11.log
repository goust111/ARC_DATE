  99: def _gen_width_profile(span, max_width):
 100:     edge_width_hi = min(SOURCE_EDGE_WIDTH_RANGE[1], max_width)
 101:     start_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
 102:     end_width = random.randint(SOURCE_EDGE_WIDTH_RANGE[0], edge_width_hi)
 103:     min_up = (max_width - start_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
 104:     min_down = (max_width - end_width + WIDTH_STEP_CAP - 1) // WIDTH_STEP_CAP
 105:     if min_up + min_down + 1 > span:
 106:         return None
 107: 
 108:     peak_start = random.randint(min_up, span - 1 - min_down)
 109:     peak_end = random.randint(peak_start, span - 1 - min_down)
 110: 
 111:     widths = [start_width]
 112:     for step in _gen_bounded_steps(max_width - start_width, peak_start, WIDTH_STEP_CAP):
 113:         widths.append(widths[-1] + step)
 114: 
 115:     widths.extend([max_width] * (peak_end - peak_start))
 116: 
 117:     current = max_width
 118:     for step in _gen_bounded_steps(max_width - end_width, span - 1 - peak_end, WIDTH_STEP_CAP):
 119:         current -= step
 120:         widths.append(current)
 121: 
 122:     area = sum(widths)
 123:     if not SOURCE_PIXEL_RANGE[0] <= area <= SOURCE_PIXEL_RANGE[1]:
 124:         return None
 125:     return widths
 126: 
