+        mirrored = [(int(sum_r - r), int(sum_c - c)) for r, c in comp["coords"]]
+        for rr, cc in mirrored:
+            assert 0 <= rr < h and 0 <= cc < w, "rotated copy must stay in bounds"
+            assert int(g[rr, cc]) == bg, "rotated copy must land on background"
