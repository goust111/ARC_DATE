  93: def _gen_dihedral_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
  94:     forms = []
  95:     base = mask.astype(bool)
  96:     for k in range(4):
  97:         rot = np.rot90(base, k)
  98:         forms.append(_gen_key(rot))
  99:         forms.append(_gen_key(np.fliplr(rot)))
