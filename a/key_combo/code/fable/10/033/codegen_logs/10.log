+def _piece_placements(piece: dict, slot_h: int, slot_w: int) -> list[tuple[int, int, np.ndarray]]:
+    ph, pw = piece["shape"]
+    if ph > slot_h or pw > slot_w:
+        return []
+    placements = []
+    for r0 in range(slot_h - ph + 1):
+        for c0 in range(slot_w - pw + 1):
