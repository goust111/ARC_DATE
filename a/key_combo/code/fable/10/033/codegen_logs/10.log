+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (int(r0), int(c0))
