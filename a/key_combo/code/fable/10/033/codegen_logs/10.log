+import numpy as np
+
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = list(range(1, 10))
+
+MIN_SLOT_H = 4
+MAX_SLOT_H = 7
+MIN_SLOT_W = 4
+MAX_SLOT_W = 7
+MIN_CANVAS = 18
+MAX_CANVAS = 30
+MIN_TOTAL_PIECES = 4
+MAX_TOTAL_PIECES = 6
+PLACEMENT_PADDING = 1
+MAX_GEN_ATTEMPTS = 500
+MAX_SUB_ATTEMPTS = 300
