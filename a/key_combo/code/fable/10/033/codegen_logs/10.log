+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (int(r0), int(c0))
+
+
+def _connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    stack = [start]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    target = int(color)
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(g[r, c]) != target:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == target:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
