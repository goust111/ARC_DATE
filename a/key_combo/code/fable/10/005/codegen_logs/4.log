+        prev_dir = dirs[idx - 1]
+        cur_dir = dirs[idx]
+        prev_lane = lanes[idx - 1]
+        choices = [
+            lane
+            for lane in (1, 2, 3)
+            if _port_entry(prev_dir, prev_lane) != _port_exit(cur_dir, lane)
