+def _port_entry(direction: tuple[int, int], lane: int) -> tuple[int, int]:
+    dr, dc = direction
+    if (dr, dc) == (0, 1):
+        return int(lane), 1
+    if (dr, dc) == (0, -1):
+        return int(lane), 3
+    if (dr, dc) == (1, 0):
+        return 1, int(lane)
+    if (dr, dc) == (-1, 0):
