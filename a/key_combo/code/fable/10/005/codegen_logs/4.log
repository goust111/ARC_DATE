+def _expected_output(grid: np.ndarray, meta: dict) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    for r, c in meta["teals"]:
+        out[r, c] = BG
+    for r, c in meta["sources"]:
+        out[r, c] = BG
