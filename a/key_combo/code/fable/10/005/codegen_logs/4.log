+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        rng = np.random.default_rng()
+        built = _build_plan(rng)
+        if built is None:
+            continue
+        mh, mw, plan = built
+        grid, meta = _render_scene(mh, mw, plan)
+        if _semantic_ok(grid, meta):
