+def _first_non_black(grid: np.ndarray, teal: tuple[int, int], direction: tuple[int, int]):
+    dr, dc = direction
+    r = teal[0] + dr
+    c = teal[1] + dc
+    traversed = []
+    while _in_bounds(grid.shape, r, c):
+        traversed.append((r, c))
+        if int(grid[r, c]) != BG:
+            return (r, c), traversed
+        r += dr
+        c += dc
+    return None, traversed
