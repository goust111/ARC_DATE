+    labels = np.full(mask.shape, -1, dtype=int)
+    comps: list[list[tuple[int, int]]] = []
+    next_id = 0
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if labels[rr, cc] >= 0:
