+    starts = _shuffle(_free_macro_cells(mh, mw, blocked), rng)
+    max_starts = min(30, len(starts))
+
+    def dfs(
+        path: list[tuple[int, int]],
+        dirs: list[tuple[int, int]],
+        spans: list[int],
+        used: set[tuple[int, int]],
+    ):
