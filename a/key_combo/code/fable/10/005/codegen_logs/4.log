+    shadow_hosts = [chain for chain in chains if len(chain["dirs"]) >= 1]
+    rng.shuffle(shadow_hosts)
+    placed_shadow = False
+    for chain in shadow_hosts:
+        if rng.random() < 0.7:
+            shadow = _try_shadow(chain, mh, mw, used_nodes, reserved, rng)
+            if shadow is not None:
+                chain["shadow"] = shadow
+                placed_shadow = True
