+    next_id = 0
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if labels[rr, cc] >= 0:
+            continue
+        labels[rr, cc] = next_id
+        q = deque([(rr, cc)])
+        coords: list[tuple[int, int]] = []
+        while q:
