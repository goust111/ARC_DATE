+    dormant_regions = []
+    free = _free_macro_cells(mh, mw, used_nodes | reserved)
+    if not free:
+        return None
+    cell = free[int(rng.integers(len(free)))]
+    used_nodes.add(cell)
+    dormant_regions.append(
+        {
+            "cell": cell,
+            "direction": DIRS[int(rng.integers(len(DIRS)))],
+            "lane": int(rng.integers(1, 4)),
