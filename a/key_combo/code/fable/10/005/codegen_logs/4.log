+BG = 0
+GREY = 5
+TEAL = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MACRO = 5
+MAX_ATTEMPTS = 400
