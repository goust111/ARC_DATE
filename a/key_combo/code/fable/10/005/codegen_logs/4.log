+    if (dr, dc) == (1, 0):
+        return 3, int(lane)
+    if (dr, dc) == (-1, 0):
+        return 1, int(lane)
+    raise ValueError("bad direction")
+
+
+def _teal_local(direction: tuple[int, int], lane: int) -> tuple[int, int]:
+    dr, dc = direction
+    if (dr, dc) == (0, 1):
+        return int(lane), 4
+    if (dr, dc) == (0, -1):
+        return int(lane), 0
+    if (dr, dc) == (1, 0):
+        return 4, int(lane)
+    if (dr, dc) == (-1, 0):
+        return 0, int(lane)
+    raise ValueError("bad direction")
+
+
+def _source_local(direction: tuple[int, int], lane: int) -> tuple[tuple[int, int], tuple[int, int]]:
