+
+def _reserve(blocked: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 0) -> None:
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(blocked.shape[0] - 1, r1 + pad)
+    cc1 = min(blocked.shape[1] - 1, c1 + pad)
