+    assert len(winners) == 1, "grey-count winner must be unique"
+    winner = winners[0]
+    r0, c0, r1, c1 = winner["bbox"]
+    return winner, np.asarray(grid, dtype=int)[r0 + 1 : r1, c0 + 1 : c1].copy()
+
