+    if not np.any(produced == GRAY):
+        return False
+    if not np.any(produced == int(winner_colors[-1])):
+        return False
+    return True
+
+
+def _build_attempt() -> tuple[np.ndarray, list[int], np.ndarray] | None:
+    depth = random.choice([2, 3])
+    if depth == 2:
