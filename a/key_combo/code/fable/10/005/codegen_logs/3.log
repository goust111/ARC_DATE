+        return False
+
+    if dfs(0, counts):
+        return assigned
+    return None
+
+
+def _choose_counts(caps: list[int], winner_count: int, desired: int) -> list[int] | None:
+    values = list(range(1, winner_count))
+    if not values:
+        return None
+    desired = min(desired, len(caps), len(values))
+    preferred: list[list[int]] = []
+    if desired >= 2:
+        preferred.append([winner_count - 1, max(1, winner_count - 2)])
+    preferred.append(values[-desired:])
+    for counts in preferred:
+        if len(set(counts)) != len(counts):
+            continue
+        matched = _match_counts_to_boxes(counts, caps)
+        if matched is not None:
+            return matched
+
+    combos = list(combinations(values, desired))
+    random.shuffle(combos)
+    for combo in combos:
+        matched = _match_counts_to_boxes(list(combo), caps)
+        if matched is not None:
+            return matched
+    return None
+
+
+def _sample_cells(cells: list[tuple[int, int]], count: int) -> list[tuple[int, int]]:
+    picks = cells.copy()
+    random.shuffle(picks)
+    return picks[:count]
+
+
+def _make_final_canvas() -> np.ndarray:
+    height = random.randint(3, 5)
+    width = random.randint(3, 5)
+    grid = np.full((height, width), BLACK, dtype=int)
+    area = height * width
+    grey_count = random.randint(3, min(area - 1, 6))
+    cells = [(r, c) for r in range(height) for c in range(width)]
+    for r, c in _sample_cells(cells, grey_count):
+        grid[r, c] = GRAY
+    return grid
+
+
+def _build_layer(
+    child: np.ndarray,
+    winner_color: int,
+    competitor_colors: list[int],
+) -> np.ndarray | None:
+    child = np.asarray(child, dtype=int)
+    child_count = int(np.count_nonzero(child == GRAY))
+    child_h, child_w = child.shape
+
+    for _ in range(150):
+        top = random.randint(0, 3)
+        left = random.randint(0, 3)
+        bottom = random.randint(1, 4)
+        right = random.randint(1, 4)
+        if max(top, left, bottom, right) < 2:
+            continue
+        height = child_h + top + bottom + 2
+        width = child_w + left + right + 2
+        if max(height, width) > MAX_SIZE:
+            continue
+
+        grid = np.full((height, width), BLACK, dtype=int)
+        inner_r = top + 1
+        inner_c = left + 1
+        grid[inner_r : inner_r + child_h, inner_c : inner_c + child_w] = child
+        winner_bbox = (inner_r - 1, inner_c - 1, inner_r + child_h, inner_c + child_w)
+        _paint_corners(grid, winner_bbox, winner_color)
+
+        blocked = np.zeros((height, width), dtype=bool)
+        _reserve(blocked, winner_bbox, pad=1)
+        desired = len(competitor_colors)
+        chosen_boxes: list[tuple[int, int, int, int]] = []
+
+        for _ in range(desired):
+            candidates = _enumerate_boxes((height, width), blocked)
+            if not candidates:
+                break
+            box = candidates[0]
+            chosen_boxes.append(box)
+            _reserve(blocked, box, pad=1)
+        if len(chosen_boxes) != desired:
+            continue
+
+        caps = []
+        for box in chosen_boxes:
+            interior = _interior_cells(box)
+            caps.append(len(interior) - 1)
+        if min(caps) < 1:
+            continue
+        counts = _choose_counts(caps, child_count, desired)
+        if counts is None:
+            continue
