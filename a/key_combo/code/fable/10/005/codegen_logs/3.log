+
+        grid = np.full((height, width), BLACK, dtype=int)
+        inner_r = top + 1
+        inner_c = left + 1
+        grid[inner_r : inner_r + child_h, inner_c : inner_c + child_w] = child
+        winner_bbox = (inner_r - 1, inner_c - 1, inner_r + child_h, inner_c + child_w)
