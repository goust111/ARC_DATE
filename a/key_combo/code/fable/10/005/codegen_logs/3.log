+def _paint_corners(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0] = color
+    grid[r0, c1] = color
+    grid[r1, c0] = color
+    grid[r1, c1] = color
+
+
+def _reserve(blocked: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 0) -> None:
+    r0, c0, r1, c1 = bbox
