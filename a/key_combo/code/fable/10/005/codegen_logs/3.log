+def _make_final_canvas() -> np.ndarray:
+    height = random.randint(3, 5)
+    width = random.randint(3, 5)
+    grid = np.full((height, width), BLACK, dtype=int)
+    area = height * width
+    grey_count = random.randint(3, min(area - 1, 6))
