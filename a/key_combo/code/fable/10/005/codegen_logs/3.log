+def _simulate(grid: np.ndarray) -> tuple[list[dict], list[np.ndarray]]:
+    rounds: list[dict] = []
+    canvases: list[np.ndarray] = [np.asarray(grid, dtype=int).copy()]
+    current = canvases[0]
+    while True:
