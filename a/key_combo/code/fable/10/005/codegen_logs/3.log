+    if not np.array_equal(produced, expected_final):
+        return False
+    if produced.shape != expected_final.shape:
+        return False
+    if not np.any(produced == GRAY):
+        return False
+    if not np.any(produced == int(winner_colors[-1])):
+        return False
+    return True
