+    order = sorted(range(len(caps)), key=lambda idx: caps[idx], reverse=True)
+    assigned = [0] * len(caps)
+
+    def dfs(pos: int, remaining: list[int]) -> bool:
+        if pos == len(order):
+            return not remaining
+        idx = order[pos]
+        for count in list(remaining):
