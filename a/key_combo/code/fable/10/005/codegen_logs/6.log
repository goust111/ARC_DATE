+    for i, sprite in enumerate(sprites):
+        tenon_col = sprite["tenon_col"]
+        if tenon_col is None:
+            continue
+        assert tenon_col not in by_tenon, "each tenon column must identify one follower"
+        by_tenon[int(tenon_col)] = i
