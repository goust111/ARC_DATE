+
+def _sample_counts(n_cells: int, want_visible_mismatch: bool) -> list[int] | None:
+    low = max(4, int(np.ceil(0.16 * n_cells)))
+    high = min(n_cells - 2, max(low + 5, int(np.floor(0.44 * n_cells))))
+    if high - low + 1 < 4:
