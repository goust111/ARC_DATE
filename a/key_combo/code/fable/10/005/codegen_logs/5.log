+        clip_loss_target = int(np.random.randint(2, 5)) if want_visible_mismatch else int(np.random.randint(1, 4))
+
+    used_nonzero = False
+    for name in FULL_ORDER:
+        if name == base_name:
+            continue
+        options = nonzero if (name == clip_name or np.random.rand() < 0.8) else candidates
+        if name == clip_name:
