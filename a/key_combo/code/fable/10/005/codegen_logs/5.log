+    dist2 = np.sum(deltas * deltas, axis=1)
+    weights = 1.0 / (1.0 + dist2)
+    weights = weights / weights.sum()
+    idx = int(np.random.choice(len(coords), p=weights))
+    return int(coords[idx, 0]), int(coords[idx, 1])
