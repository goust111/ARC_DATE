+def _neighbor_mask(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _weighted_pick(coords: np.ndarray, center: tuple[int, int]) -> tuple[int, int] | None:
