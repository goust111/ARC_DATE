+    return coords[int(np.random.randint(min(len(coords), 6)))]
+
+
+def _grow_mask(
+    shape: tuple[int, int],
+    count: int,
+    anchor: tuple[int, int],
+    preferred: tuple[int, int],
+    forced_cells: list[tuple[int, int]],
