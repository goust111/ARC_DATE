+    rr = rows + dr
+    cc = cols + dc
+    out = np.zeros(shape, dtype=bool)
+    keep = (0 <= rr) & (rr < shape[0]) & (0 <= cc) & (cc < shape[1])
+    out[rr[keep], cc[keep]] = True
+    return out
+
+
+def _render_layers(
+    panel_info: dict[str, dict[str, object]],
+    shape: tuple[int, int],
+    order: tuple[str, ...],
+    deltas: dict[str, tuple[int, int]],
+) -> np.ndarray:
