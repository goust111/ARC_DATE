+    _cross_color, cross_r, cross_c = _find_full_cross(g)
+    panels = _split_panels(g, cross_r, cross_c)
+    shapes = {panel.shape for panel in panels.values()}
+    assert len(shapes) == 1
+    shape = next(iter(shapes))
