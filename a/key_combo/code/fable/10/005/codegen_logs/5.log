+        use_frontier = frontier.any() and (np.random.rand() < 0.88 or not np.any(mask))
+        coords = np.argwhere(frontier if use_frontier else (~mask & ~forbidden))
+        picked = _weighted_pick(coords, preferred)
+        if picked is None:
