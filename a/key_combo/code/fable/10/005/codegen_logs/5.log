+
+def _clip_zone(shape: tuple[int, int], delta: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    dr, dc = map(int, delta)
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    rr = rows + dr
+    cc = cols + dc
+    return (rr < 0) | (rr >= h) | (cc < 0) | (cc >= w)
