+            "patch": np.asarray(obj["output_patch"], dtype=int),
+            "missing_corner": str(obj["missing_corner"]),
+            "area": int(obj["outer_area"]),
+        }
+        for obj in specs
+    ]
+    expected = _render_output_from_objects(objects_for_output)
+    return grid, expected
