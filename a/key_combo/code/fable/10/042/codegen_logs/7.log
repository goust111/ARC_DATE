+def _random_mask(h: int, w: int, anchor_corner: str, dense: bool) -> np.ndarray:
+    area = h * w
+    required = {
+        "tl": {(0, 0)},
+        "tr": {(0, w - 1)},
+        "bl": {(h - 1, 0)},
+        "br": {(h - 1, w - 1)},
+    }[anchor_corner]
