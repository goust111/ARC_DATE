+            empties = [(r, c) for r in range(h) for c in range(w) if (r, c) not in cells]
+            if not empties:
+                break
+            candidates = set(empties)
+        pick = random.choice(sorted(candidates))
+        cells.add(pick)
+        frontier = {pick}
