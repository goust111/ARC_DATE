+        if name != missing_corner:
+            obj[r, c] = color
+    obj[1 : h + 1, 1 : w + 1][inner_mask] = GREY
+    return obj
+
+
+def _boxes_separated(boxes: list[tuple[int, int, int, int]], candidate: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = candidate
