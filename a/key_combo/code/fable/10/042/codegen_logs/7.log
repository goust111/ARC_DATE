+                "missing_corner": corner,
+                "output_patch": output_patch,
+                "input_patch": _render_object(mask, color, corner),
+                "outer_area": (h + 2) * (w + 2),
+            }
+        )
+    return specs
+
+
+def _attempt_generate() -> np.ndarray | None:
+    specs = _build_specs()
+    grid, expected = _render_scene(specs)
