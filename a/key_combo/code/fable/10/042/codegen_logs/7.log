+        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+        patch = np.zeros_like(interior)
+        patch[interior == GREY] = color
+        area = int((r1 - r0 + 1) * (c1 - c0 + 1))
+        objects.append(
+            {
+                "color": int(color),
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "missing_corner": missing_corner,
+                "patch": patch,
+                "area": area,
+                "shape": patch.shape,
