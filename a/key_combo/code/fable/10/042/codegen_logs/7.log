+    frontier = set(cells)
+    while len(cells) < target_area:
+        candidates = set()
+        for r, c in frontier:
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in cells:
+                    candidates.add((rr, cc))
