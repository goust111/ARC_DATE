+def _grow_connected_mask(h: int, w: int, target_area: int, required: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    cells = {(int(r), int(c)) for r, c in required}
+    cells.add(random.choice(sorted(cells)))
