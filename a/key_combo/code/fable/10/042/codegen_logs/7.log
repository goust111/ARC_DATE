+def _render_scene(specs: list[dict[str, object]]) -> tuple[np.ndarray, np.ndarray]:
+    canvas_h = random.randint(22, 30)
+    canvas_w = random.randint(22, 30)
+    grid = np.zeros((canvas_h, canvas_w), dtype=int)
