+        "open": open_dirs,
+        "color_cells": color_cells,
+        "wall_cells": wall_cells,
+        "residues": residues,
+    }
+
+
+def _residue_isolated(residues: Iterable[Tuple[int, int]], h: int, w: int) -> bool:
+    points = list(residues)
+    for i, (r0, c0) in enumerate(points):
