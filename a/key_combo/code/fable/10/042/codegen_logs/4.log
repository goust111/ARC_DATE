+    if not (1 <= r < h - 1 and 1 <= c < w - 1):
+        return False
+    if int(grid[r, c]) != BG:
+        return False
+
+    expected: Set[Tuple[int, int]] = set()
+    for _name, dr, dc in DIRS:
+        rr, cc = r + dr, c + dc
+        blocked = False
+        while 0 <= rr < h and 0 <= cc < w:
+            if int(grid[rr, cc]) == WALL:
+                blocked = True
+                break
+            rr += dr
+            cc += dc
+        if blocked:
+            continue
+        endpoint = (rr - dr, cc - dc)
+        expected.add(endpoint)
+    return expected == residues
+
