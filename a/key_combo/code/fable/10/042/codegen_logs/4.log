+        return False
+
+    seen_axis_hidden = False
+    seen_mixed = False
+    for spec in specs:
+        color = int(spec["color"])
+        candidates = _find_candidates_for_color(inp, color)
+        if candidates != [tuple(spec["pos"])]:
