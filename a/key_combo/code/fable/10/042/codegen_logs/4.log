+WALL = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS: Sequence[Tuple[str, int, int]] = (
+    ("U", -1, 0),
+    ("D", 1, 0),
+    ("L", 0, -1),
+    ("R", 0, 1),
+)
