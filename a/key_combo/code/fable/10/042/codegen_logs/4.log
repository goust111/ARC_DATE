+            seen_mixed = True
+
+    if not seen_axis_hidden or not seen_mixed:
+        return False
+    return True
+
+
+def _generate_example() -> Tuple[np.ndarray, np.ndarray]:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
