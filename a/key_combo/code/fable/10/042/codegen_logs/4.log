+def _border_residues(grid: np.ndarray) -> Dict[int, Set[Tuple[int, int]]]:
+    h, w = grid.shape
+    residues: Dict[int, Set[Tuple[int, int]]] = {}
+    for r in range(h):
+        for c in range(w):
+            if not _is_border(h, w, r, c):
+                continue
+            color = int(grid[r, c])
+            if color in (BG, WALL):
