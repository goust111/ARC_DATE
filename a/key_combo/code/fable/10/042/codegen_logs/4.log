+    frozenset(),
+    frozenset({"U"}),
+    frozenset({"D"}),
+    frozenset({"L"}),
+    frozenset({"R"}),
+    frozenset({"U", "L"}),
+    frozenset({"U", "R"}),
+    frozenset({"D", "L"}),
+    frozenset({"D", "R"}),
