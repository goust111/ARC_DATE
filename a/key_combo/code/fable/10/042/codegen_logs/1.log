+def _consistent_tile(grid: np.ndarray, row_period: int, col_period: int) -> np.ndarray | None:
+    tile = np.full((row_period, col_period), -1, dtype=int)
+    for r, c in np.argwhere(grid != MISSING):
+        rr = int(r) % row_period
+        cc = int(c) % col_period
