+def _occlude_quadrant(
+    full: np.ndarray,
+    tile01: np.ndarray,
+    diff_residues: tuple[tuple[int, int], tuple[int, int]],
+    witness_by_residue: dict[tuple[int, int], tuple[int, int]],
+    extra_mask_quota: dict[int, int],
