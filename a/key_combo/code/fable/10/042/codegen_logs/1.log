+    quadrants, _sep_r, _sep_c = _split_quadrants(grid)
+    repaired = [_repair_quadrant(q) for q in quadrants]
+    matches = [sum(np.array_equal(repaired[i], repaired[j]) for j in range(4)) for i in range(4)]
