+        return None
+    if not _validate_generated_instance(
+        inp,
+        outlier_full,
+        outlier_index,
+        common_full,
+        outlier_full,
+        diff_residues,
+        witness_maps,
+        common01.shape,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
