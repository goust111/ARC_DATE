+        outlier_full,
+        outlier_index,
+        common_full,
+        outlier_full,
+        diff_residues,
+        witness_maps,
+        common01.shape,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        inp = _generate_attempt()
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid input for the new ARC task")

