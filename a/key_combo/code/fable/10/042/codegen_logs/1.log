+    color0: int,
+    color1: int,
+    rep_h: int,
+    rep_w: int,
+) -> dict[int, int]:
+    th, tw = map(int, tile01.shape)
+    occurrences_per_residue = rep_h * rep_w
+
+    available = {color0: 0, color1: 0}
+    for rr in range(th):
+        for cc in range(tw):
+            residue = (rr, cc)
+            if residue in diff_residues:
+                continue
+            color = int(common_full[rr, cc])
+            available[color] += occurrences_per_residue - 2
