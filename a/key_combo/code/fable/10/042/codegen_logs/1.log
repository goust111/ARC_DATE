+from __future__ import annotations
+
+import math
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+MISSING = 6
+PATTERN_COLORS = (1, 2, 3, 4, 5, 7, 8, 9)
+TILE_SHAPES = ((2, 2), (2, 3), (3, 2), (3, 3), (2, 4), (4, 2), (3, 4), (4, 3))
+MAX_ATTEMPTS = 400
