def _allowed_mask(size: int) -> np.ndarray:
    allowed = np.ones((size, size), dtype=bool)
    edge_masks = (allowed[0, :], allowed[-1, :], allowed[:, 0], allowed[:, -1])
    edge_masks[random.randrange(len(edge_masks))][:] = False
    return allowed


