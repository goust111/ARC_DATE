   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Repeat the 3x3 input sprite into the first foreground-count slots of a black block grid.
   9: 
  10:     Input structure
  11:     - The input is a 3x3 sprite containing black background and exactly one non-black foreground color.
  12:     - The number of black pixels determines the square block-grid side length.
  13:     - The number of non-black pixels determines how many copies of the sprite are emitted.
  14: 
  15:     Rule
  16:     - Build a black output canvas with black-pixel-count slots per side, where each slot is 3x3.
  17:     - Copy the entire input sprite into the first non-black-pixel-count slots in row-major order.
  18:     - Leave all remaining slots black.
  19: 
  20:     Key insight
  21:     - The colors are not changed; the two pixel counts control the output size and the number of repeated input sprites.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2, "expected a 2D grid"
  25:     assert g.shape == (3, 3), "expected a 3x3 sprite"
  26: 
  27:     colors = set(map(int, np.unique(g)))
  28:     assert Color.BLACK in colors, "expected black background pixels"
  29:     foreground_colors = colors - {Color.BLACK}
  30:     assert len(foreground_colors) == 1, "expected exactly one foreground color"
  31: 
  32:     tile_h, tile_w = g.shape
  33:     slot_count = int(np.sum(g == Color.BLACK))
  34:     copy_count = int(np.sum(g != Color.BLACK))
  35:     assert slot_count > 0, "expected at least one black slot marker"
  36:     assert copy_count > 0, "expected at least one foreground pixel"
  37:     assert copy_count <= slot_count * slot_count, "expected enough row-major slots for all copies"
  38: 
  39:     out = np.full((tile_h * slot_count, tile_w * slot_count), Color.BLACK, dtype=int)
  40:     for index in range(copy_count):
  41:         block_r, block_c = divmod(index, slot_count)
  42:         r0 = block_r * tile_h
  43:         c0 = block_c * tile_w
  44:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = g
  45: 
  46:     return out
