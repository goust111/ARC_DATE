  93: def _slot_lefts(n: int, k: int, width: int) -> list[int]:
  94:     used = int(k * width + (k - 1))
  95:     extra = int(n - used)
  96:     if extra < 0:
  97:         raise ValueError("bars do not fit")
  98:     gaps = _rand_composition(extra, k + 1)
