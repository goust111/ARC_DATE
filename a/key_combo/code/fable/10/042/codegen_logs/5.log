from __future__ import annotations

import itertools
import random

import numpy as np


BLACK = 0
COLOR_POOL = tuple(range(1, 10))
QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
ROW_MAJOR_ORDER = ((0, 0), (0, 1), (1, 0), (1, 1))
REF_OVERLAY_ORDER = ((0, 0), (1, 1), (1, 0), (0, 1))

