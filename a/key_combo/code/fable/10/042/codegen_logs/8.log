+    min_area = min(area for area, _rp, _cp, _tile in candidates)
+    minimal = [(rp, cp, tile) for area, rp, cp, tile in candidates if area == min_area]
+    assert len(minimal) == 1, "minimum-area period must be unique"
+    return minimal[0]
