7: # concepts:
8: # puzzle pieces, rescaling
9: 
10: # description:
11: # In the input you will see a small multicolored object, and a big region bordered by 4 yellow pixels in the corners. The big region contains some colored things.
12: # To make the output, rescale and translate the small multicolored object so that it is in the big region and matches as much as possible the colors of the things in the big region.
13: # The output should be just the big region with its 4 yellow pixels (plus the rescaled and translated thing).
14: 
15: def main(input_grid):
16:     """
17:     Scale and place the external multicolor object into the yellow-cornered region where it matches existing colors.
18: 
19:     Input structure:
20:     - The input contains one small multicolor object outside a larger region.
21:     - Four yellow singleton pixels mark the corners of the larger output region.
22:     - The marked region contains partial colored evidence from a scaled version of the small object.
23: 
24:     Rule:
25:     - Use the four yellow pixels to crop the target region.
26:     - Generate scaled versions of the small object and try all placements inside that crop.
27:     - Choose a placement whose colored cells cover every existing non-black, non-yellow cell in the target region, then paste it.
28: 
29:     Key insight:
30:     - The partial colored cells inside the frame are alignment constraints for the scaled miniature;
31:       the yellow corners define the output crop.
32:     """
33:     # Plan:
34:     # 1. Detect the little object, yellow pixels, and big region
35:     # 2. Rescale and translate the little object to cover as much of the big region as possible, matching colors whenever they overlap
36: 
37:     # 1. Detect little object, yellow pixels, and big region
38:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
39:     yellow_pixel_objects = []
40:     for obj in objects:
41:         _b = bbox(obj != Color.BLACK)
42:         if _b is None:
43:             continue
44:         r0, c0, r1, c1 = _b
45:         if r0 == r1 and c0 == c1 and int(obj[r0, c0]) == int(Color.YELLOW):
46:             yellow_pixel_objects.append(obj)
47:     assert len(yellow_pixel_objects) == 4, "There should be exactly 4 yellow pixels"
48: 
49:     # Find the region indicated by the 4 yellow pixels
50:     yellow_coords = []
51:     for obj in yellow_pixel_objects:
52:         _b = bbox(obj != Color.BLACK)
53:         assert _b is not None
54:         yellow_coords.append(bbox_anchor(_b, anchor="center"))
55:     yellow_pixel_min_r = min(r for r, _c in yellow_coords)
56:     yellow_pixel_max_r = max(r for r, _c in yellow_coords)
57:     yellow_pixel_min_c = min(c for _r, c in yellow_coords)
58:     yellow_pixel_max_c = max(c for _r, c in yellow_coords)
59:     
60:     # The little object is what is outside that region
61:     little_objects = []
62:     for obj in objects:
63:         _b = bbox(obj != Color.BLACK)
64:         if _b is None:
65:             continue
66:         r, c = bbox_anchor(_b, anchor="center")
67:         if r < yellow_pixel_min_r or r > yellow_pixel_max_r or c < yellow_pixel_min_c or c > yellow_pixel_max_c:
68:             # Exclude the yellow corner markers
69:             if int(obj[r, c]) == int(Color.YELLOW):
70:                 continue
