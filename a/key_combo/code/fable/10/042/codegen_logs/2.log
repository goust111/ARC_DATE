spec:
  grid: 8-16 rows x 8-16 cols, square [observed], background=7(orange)
  colors: line=2(red), endpoint_marker=5(gray), hinge_marker=0(black)
  rods:
    count: 1-7 per grid; more rods in larger grids [observed]
    structure: straight 4-connected horizontal or vertical segment, length 3-12
    composition: one gray(5) endpoint at one end, one black(0) hinge in interior, rest red(2)
    fixed_segment: endpoint through hinge inclusive; 0-7 red pixels between them
    tail: 1-5 red pixels on the far side of hinge from endpoint
  fold_rule:
    hinge_asymmetry: perpendicular distances from hinge to opposite grid edges must be strictly unequal
    fold_direction: perpendicular to rod, toward the side with more space to grid edge
    tail_must_fit: tail length <= available space in fold direction
  placement:
