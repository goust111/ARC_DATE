95: # Canvas and plus layout bounds; randint ranges use exclusive stops.
96: GRID_SIZE_RANGE, PLUS_COUNT_RANGE = (10, 31), (2, 6)
97: CENTER_MARGIN, MIN_CENTER_CHEB_DISTANCE = 1, 3
98: # Color assignment and retry settings.
99: BG_COLOR, PLUS_ARM_COLOR, BG_CENTER_FLAG_RANGE = 0, Color.GREEN, (0, 2)
100: MARKER_PALETTE = [1, 2, 4, 5, 6, 7, 8, 9]
101: MAX_GENERATION_ATTEMPTS = 300
102: 
103: def _gen_pick_centers(n: int, count: int) -> list[tuple[int, int]] | None:
104:     """Return separated centers with unique rows and columns, or None."""
105:     center_range = range(CENTER_MARGIN, n - CENTER_MARGIN)
106:     cells = [(r, c) for r in center_range for c in center_range]
107:     chosen: list[tuple[int, int]] = []
108:     used_rows: set[int] = set()
109:     used_cols: set[int] = set()
110: 
111:     def search() -> bool:
112:         if len(chosen) == count:
113:             return True
114: 
115:         candidates = [
116:             (r, c) for r, c in cells
117:             if r not in used_rows and c not in used_cols
118:             and all(max(abs(r - rr), abs(c - cc)) >= MIN_CENTER_CHEB_DISTANCE for rr, cc in chosen)
119:         ]
120: 
121:         if len(candidates) < count - len(chosen):
122:             return False
123: 
124:         np.random.shuffle(candidates)
125:         for r, c in candidates:
126:             chosen.append((r, c))
127:             used_rows.add(r)
128:             used_cols.add(c)
129:             if search():
130:                 return True
131:             used_cols.remove(c)
132:             used_rows.remove(r)
133:             chosen.pop()
134:         return False
135: 
136:     return chosen.copy() if search() else None
137: 
