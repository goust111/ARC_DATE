58: def _grow_region(allowed: np.ndarray, area: int) -> set[tuple[int, int]] | None:
59:     """Grow a random 4-connected set inside `allowed`; return None if growth stalls."""
60:     allowed_cells = list(zip(*np.where(allowed)))
61:     start = random.choice(allowed_cells)
62:     cells = {start}
63:     frontier = {nb for nb in _neighbors(start, allowed)}
64:     while len(cells) < area:
65:         if not frontier:
66:             return None
67:         cell = random.choice(tuple(frontier))
68:         frontier.remove(cell)
69:         cells.add(cell)
70:         for nb in _neighbors(cell, allowed):
71:             if nb not in cells:
72:                 frontier.add(nb)
73:     return cells
74: 
75: 
76: def _paint_region(size: int, cells: set[tuple[int, int]], area: int) -> np.ndarray:
77:     """Split the connected cells into two noisy directional color bands."""
78:     colors = random.sample(NON_BLACK_COLORS, 2)
79:     grid = np.zeros((size, size), dtype=int)
80:     region = list(cells)
81:     dr, dc = random.choice(BAND_DIRECTIONS)
82:     region.sort(key=lambda cell: cell[0] * dr + cell[1] * dc + random.random() * BAND_JITTER)
83:     split = random.randint(1, area - 1)
84:     for color, part in ((colors[0], region[:split]), (colors[1], region[split:])):
85:         rr, cc = zip(*part)
86:         grid[rr, cc] = color
87:     return grid
88: 
