150: def _render_pluses(n: int, centers: list[tuple[int, int]], colors: list[int]) -> np.ndarray:
151:     """Draw five-cell plus frames on a blank square canvas."""
152:     grid = np.zeros((n, n), dtype=int)
153:     for (r, c), color in zip(centers, colors):
154:         grid[r, c] = int(color)
155:         grid[(r - 1, r + 1), c] = PLUS_ARM_COLOR
156:         grid[r, (c - 1, c + 1)] = PLUS_ARM_COLOR
157:     return grid
