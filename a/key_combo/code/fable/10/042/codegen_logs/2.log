56: def main(grid: np.ndarray) -> np.ndarray:
57:     """
58:     Extend each green plus outward as row and column rays in its center color.
59: 
60:     Input structure
61:     - The background is the dominant color.
62:     - Every foreground pixel belongs to a green four-arm plus frame.
63:     - Each plus center is either a marker color or the background color.
64: 
65:     Rule
66:     - From each plus, paint horizontal rays in the center color from just beyond
67:       the left and right green arms until an original foreground pixel blocks the
68:       ray.
69:     - Then paint vertical rays the same way from just beyond the top and bottom
70:       arms, so vertical rays determine line crossings.
71:     - Green frame pixels and non-background centers remain unchanged.
72: 
73:     Key insight
74:     - A background-colored plus is still an emitter: its vertical ray clears
75:       crossings in horizontal colored rays, which creates the visible gaps.
76:     """
77:     g = np.asarray(grid, dtype=int)
78:     bg = get_bg(g)
79:     centers = _plus_centers(g, bg)
80:     blocked = g != bg
81:     out = g.copy()
82: 
83:     for r, c, color in centers:
84:         _paint_ray(out, blocked, r, c - 2, 0, -1, color)
85:         _paint_ray(out, blocked, r, c + 2, 0, 1, color)
86: 
87:     for r, c, color in centers:
88:         _paint_ray(out, blocked, r - 2, c, -1, 0, color)
89:         _paint_ray(out, blocked, r + 2, c, 1, 0, color)
90: 
91:     return out
92: 
