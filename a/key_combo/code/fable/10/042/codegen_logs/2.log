31: REGION_FRACTION_RANGE = (0.20, 0.35)
32: MAX_ATTEMPTS = 300
33: UPSCALE_FACTOR = 2
34: 
35: # Edge protection, connectivity, and color split behavior.
36: NEIGHBOR_DELTAS = ((1, 0), (-1, 0), (0, 1), (0, -1))
37: NON_BLACK_COLORS = tuple(range(1, 10))
38: BAND_DIRECTIONS = ((1, 0), (0, 1), (1, 1), (1, -1))
39: BAND_JITTER = 0.35
40: 
41: 
42: def _allowed_mask(size: int) -> np.ndarray:
43:     allowed = np.ones((size, size), dtype=bool)
44:     edge_masks = (allowed[0, :], allowed[-1, :], allowed[:, 0], allowed[:, -1])
45:     edge_masks[random.randrange(len(edge_masks))][:] = False
46:     return allowed
47: 
48: 
49: def _neighbors(cell: tuple[int, int], allowed: np.ndarray):
50:     h, w = allowed.shape
51:     r, c = cell
52:     for dr, dc in NEIGHBOR_DELTAS:
53:         rr, cc = r + dr, c + dc
54:         if 0 <= rr < h and 0 <= cc < w and allowed[rr, cc]:
55:             yield rr, cc
56: 
