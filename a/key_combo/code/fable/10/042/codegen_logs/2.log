141:     include_bg_center = bool(np.random.randint(*BG_CENTER_FLAG_RANGE))
142:     if include_bg_center:
143:         colors = [BG_COLOR] + list(np.random.choice(MARKER_PALETTE, count - 1, replace=False))
144:     else:
