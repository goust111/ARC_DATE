+
+def _bfs_distances(graph: dict[int, list[tuple[int, int, tuple[int, int]]]], start: int) -> dict[int, int]:
+    dist = {int(start): 0}
+    queue = deque([int(start)])
+    while queue:
+        node = queue.popleft()
+        for nbr, _color, _pos in graph[node]:
+            if nbr in dist:
+                continue
+            dist[nbr] = dist[node] + 1
+            queue.append(nbr)
+    return dist
