+    if len(options) == 2:
+        slack_h = h - (2 * MIN_ROOM_SIDE + 1)
+        slack_w = w - (2 * MIN_ROOM_SIDE + 1)
+        orient = random.choices(options, weights=[slack_h + 1, slack_w + 1])[0]
