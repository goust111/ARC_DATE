+        door_min = c0 + 1 if c1 - c0 >= 2 else c0
+        door_max = c1 - 1 if c1 - c0 >= 2 else c1
+        door_c = random.randint(door_min, door_max)
+        grid[wall_r, c0 : c1 + 1] = GREY
