+    if not _place_features(grid, room_rects, room_by_id, source_room):
+        return None
+    if not _semantic_checks(grid, room_by_id):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
