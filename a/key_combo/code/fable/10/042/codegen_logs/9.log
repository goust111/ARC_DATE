+
+def _place_shape(grid: np.ndarray, room: dict, color: int, shape: tuple[tuple[int, int], ...]) -> bool:
+    max_dr = max(dr for dr, _dc in shape)
+    max_dc = max(dc for _dr, dc in shape)
