+        candidates = [i for i, room in enumerate(rooms) if _feasible_splits(room)]
+        if not candidates:
+            return None
+        weights = []
+        for idx in candidates:
+            rh, rw = _room_size(rooms[idx])
+            weights.append((rh * rw) ** 1.2)
