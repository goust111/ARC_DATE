+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+GREY = 5
+FLOW_COLORS = [1, 2, 4, 6, 7, 8, 9]
+
+MIN_SIDE = 18
+MAX_SIDE = 28
+MIN_ROOM_SIDE = 4
+MIN_ROOMS = 4
+MAX_ROOMS = 7
+MAX_ATTEMPTS = 500
+
