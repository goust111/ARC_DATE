+        up = int(room_labels[r - 1, c]) if r > 0 else -1
+        down = int(room_labels[r + 1, c]) if r + 1 < g.shape[0] else -1
+        left = int(room_labels[r, c - 1]) if c > 0 else -1
+        right = int(room_labels[r, c + 1]) if c + 1 < g.shape[1] else -1
