+                (r, c),
+                (r, a2 - c),
+                (b2 - r, c),
+                (b2 - r, a2 - c),
+            }
+            for pr, pc in orbit:
+                if 0 <= pr < h and 0 <= pc < w:
+                    patch[pr, pc] = int(color)
+
+
+def _make_symmetric_patch(h: int, w: int, rng: random.Random) -> np.ndarray:
+    colors = rng.sample(PALETTE, rng.randint(3, 5))
+    base = colors[0]
+    accents = colors[1:]
+    patch = np.full((h, w), base, dtype=int)
