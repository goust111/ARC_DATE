+
+
+def _choose_hole(
+    patch: np.ndarray,
+    shape: np.ndarray,
+    rng: random.Random,
+) -> tuple[np.ndarray, Counter[int], str]:
+    h, w = patch.shape
+    hs, ws = _coords_to_mask(shape).shape
