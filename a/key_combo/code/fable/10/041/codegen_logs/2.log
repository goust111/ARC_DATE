+
+
+def _mirrored_positions(r: int, c: int, a2: int, b2: int) -> list[tuple[int, int]]:
+    return [
+        (r, a2 - c),
+        (b2 - r, c),
+        (b2 - r, a2 - c),
+    ]
+
