+def _build_example(rng: random.Random) -> tuple[np.ndarray, np.ndarray, dict]:
+    for _ in range(500):
+        try:
+            H = rng.randint(18, 27)
+            W = rng.randint(22, 30)
+            patch_h = rng.randint(10, min(16, H - 4))
+            patch_w = rng.randint(10, min(15, W - 8))
+            side = rng.choice(["left", "right"])
+            field_width = W - patch_w - 4
+            if field_width < 7:
