+            top = rng.randint(1, H - patch_h - 1)
+            left = 1 if side == "left" else W - patch_w - 2
+            grid_in[top : top + patch_h, left : left + patch_w] = patch
+            grid_out[top : top + patch_h, left : left + patch_w] = patch
