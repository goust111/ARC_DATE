+    ordered = repaired_colors.most_common()
+    if len(ordered) < 2 or ordered[0][1] == ordered[1][1]:
+        return False
+    visible_colors = Counter(int(v) for v in sub.ravel() if int(v) != BG)
+    if visible_colors.most_common(1)[0][0] == ordered[0][0]:
+        return False
