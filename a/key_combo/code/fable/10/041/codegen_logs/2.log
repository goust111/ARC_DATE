+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> list[tuple[int, int]]:
+    if connectivity == 4:
+        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+    out = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            out.append((r + dr, c + dc))
