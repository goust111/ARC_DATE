+    fg_components = _components_from_mask(g != bg, connectivity=8)
+    assert fg_components
+    mosaic = max(fg_components, key=len)
+    mosaic_set = {tuple(map(int, rc)) for rc in mosaic}
+    r0, c0, r1, c1 = _bbox(mosaic)
+    a2 = c0 + c1
+    b2 = r0 + r1
