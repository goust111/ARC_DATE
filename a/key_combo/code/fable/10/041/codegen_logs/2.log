+        for r, c in list(pending):
+            colors = []
+            for rr, cc in _mirrored_positions(r, c, a2, b2):
+                if r0 <= rr <= r1 and c0 <= cc <= c1 and (rr, cc) not in hole_set:
+                    val = int(out[rr, cc])
+                    if val != bg:
