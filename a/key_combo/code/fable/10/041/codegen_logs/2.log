+            distractors = [
+                _make_distractor(hole_shape, hole_variants, rng, same_area=True, same_dims=True),
+                _make_distractor(hole_shape, hole_variants, rng, same_area=True, same_dims=False),
+            ]
+            for _ in range(rng.randint(1, 2)):
