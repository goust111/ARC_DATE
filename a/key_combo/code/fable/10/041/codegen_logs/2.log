+
+
+def _place_object(grid: np.ndarray, shape: np.ndarray, color: int, allowed_cols: tuple[int, int], rng: random.Random) -> np.ndarray:
+    patch = _shape_patch(shape, color)
+    h, w = patch.shape
+    rows, cols = grid.shape
+    cmin, cmax = allowed_cols
+    for _ in range(500):
