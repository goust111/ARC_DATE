+    hole_variants = _d4_signatures(hole)
+    object_components = [comp for comp in fg if comp is not mosaic]
+    matched = 0
+    erased = 0
+    winner = ordered[0][0]
+    for comp in object_components:
+        sig = _normalize(comp)
+        out_vals = set(int(expected[r, c]) for r, c in comp)
+        if sig in hole_variants:
