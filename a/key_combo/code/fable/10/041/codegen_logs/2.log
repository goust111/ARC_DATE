+    raise RuntimeError("failed to build example")
+
+
+def _validate_generated(inp: np.ndarray, expected: np.ndarray, meta: dict) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2 or max(inp.shape) > 30 or max(expected.shape) > 30:
