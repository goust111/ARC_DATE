+    hole_variants = _d4_signatures(hole)
+    for comp in fg_components:
+        comp_set = {tuple(map(int, rc)) for rc in comp}
+        if comp_set == mosaic_set:
+            continue
+        if _normalize(comp) in hole_variants:
+            out[comp[:, 0], comp[:, 1]] = winner
+        else:
