+
+
+def _make_distractor(
+    hole_shape: np.ndarray,
+    hole_variants: set[tuple[tuple[int, int], ...]],
+    rng: random.Random,
+    *,
+    same_area: bool,
+    same_dims: bool,
+) -> np.ndarray:
+    dims = _coords_to_mask(hole_shape).shape if same_dims else None
+    area = len(hole_shape) if same_area else None
+    for _ in range(500):
