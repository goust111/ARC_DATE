+            placements[idx] = cand
+            old_reserved = reserved
+            reserved = reserved | src_coords | dst_coords
+            old_blocked = blocked
+            blocked = _blocked_from_reserved(reserved)
+            if backtrack(k + 1):
+                return True
+            reserved = old_reserved
+            blocked = old_blocked
+            placements.pop(idx, None)
+        return False
+
+    if not backtrack(0):
+        return None
