+        tgt_color = int(target[r, c])
+        prev = trial.get(src_color)
+        if prev is None:
+            trial[src_color] = tgt_color
+        elif prev != tgt_color:
+            return None
+    return trial
+
+
+def _reflected_top_left(
+    src_bbox: tuple[int, int, int, int],
+    dst_shape: tuple[int, int],
