+        return False
+    candidates = _candidate_outputs(inp)
+    if len(candidates) != 1:
+        return False
+    if not np.array_equal(candidates[0], expected):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid_shape = (
+            int(rng.integers(19, 28)),
+            int(rng.integers(19, 28)),
