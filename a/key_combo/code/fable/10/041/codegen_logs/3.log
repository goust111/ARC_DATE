# Retry budget.
GENERATION_RETRY_LIMIT = 300

_SHAPE_ORBITS_BY_COUNT = None

def _gen_shape_orbits_by_count():
    import itertools

    global _SHAPE_ORBITS_BY_COUNT
    if _SHAPE_ORBITS_BY_COUNT is not None:
        return _SHAPE_ORBITS_BY_COUNT

