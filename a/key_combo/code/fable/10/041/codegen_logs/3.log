+
+def _paste_nonzero(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    h, w = patch.shape
+    window = dst[top : top + h, left : left + w]
+    mask = patch != BG
+    if np.any(window[mask] != BG):
+        return False
+    window[mask] = patch[mask]
