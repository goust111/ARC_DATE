+    pose: str,
+    color_map: dict[int, int],
+    palette: tuple[int, ...],
+) -> np.ndarray | None:
+    dims = [(3, 3), (3, 5), (5, 3), (5, 5), (4, 4)]
+    for _ in range(300):
+        h, w = dims[int(rng.integers(len(dims)))]
