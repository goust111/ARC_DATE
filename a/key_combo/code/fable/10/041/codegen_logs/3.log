+
+
+def _placement_candidates(
+    src: np.ndarray,
+    dst: np.ndarray,
+    grid_shape: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    border: int = 1,
+) -> list[tuple[int, int, int, int, set[tuple[int, int]], set[tuple[int, int]]]]:
