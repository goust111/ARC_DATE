+
+
+def _candidate_outputs(grid: np.ndarray) -> list[np.ndarray]:
+    comps = _find_components(grid)
+    assert len(comps) >= 3 and len(comps) % 2 == 1
+    pairs, widow = _pair_components(comps, grid.shape)
