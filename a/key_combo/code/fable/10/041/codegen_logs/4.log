        matches = {
            color
            for color, (shape, dims) in legend.items()
            if (marker_shape, marker_dims) in _d4_variants(shape, dims)
        }
        assert len(matches) == 1
        out[r0 : r1 + 1, c0 : c1 + 1] = next(iter(matches))

    return out

