+    strokes: list[tuple[tuple[int, int], int]] = []
+    r = 0
+    c = 0
+
+    strokes.append(((r, c), int(colors[0])))
+    for _ in range(int(lengths[0]) - 1):
+        c += 1
+        strokes.append(((r, c), int(colors[0])))
