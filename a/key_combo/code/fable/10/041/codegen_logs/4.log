+
+    if boundary_count and not np.any(offsets_arr != 0):
+        return None
+    return grid
+
+
+def _expected_output(colors: list[int], thicknesses: list[int]) -> np.ndarray:
+    return _draw_spiral(colors, thicknesses)
+
+
+def _valid_instance(
+    grid: np.ndarray,
