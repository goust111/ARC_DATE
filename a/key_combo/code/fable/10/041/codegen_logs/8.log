+import random
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+GRID_SIZE_CHOICES = (5, 6, 7)
+MIN_FOREGROUND = 6
+MAX_FOREGROUND = 18
+MIN_VISIBLE_FOREGROUND = 4
+MIN_DISTINCT_VISIBLE_COLORS = 2
+GENERATION_RETRIES = 400
