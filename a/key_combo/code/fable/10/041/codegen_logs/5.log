+    ):
+        return None
+
+    expected = grid.copy()
+    expected[layout["main_rows"], layout["main_cols"]] = expected_region
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
