+
+def _find_layout(grid: np.ndarray, bg: int) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    height, width = map(int, g.shape)
+    candidates: list[dict[str, object]] = []
+
+    for color in colors_present(g, exclude={bg}):
+        mask = g == int(color)
