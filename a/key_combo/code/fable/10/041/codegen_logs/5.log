# Canvas and fixed colors.
GRID_SHAPE = (18, 22)
PANEL_COLOR, BASE_COLOR, MARKER_COLOR = 8, 2, 1
LEGEND_COLOR_POOL = np.array([1, 2, 3, 4, 5, 6, 7, 9])

# Legend shape and panel slot sampling.
LEGEND_COUNT, LEGEND_BBOX_SIZE = 4, 3
