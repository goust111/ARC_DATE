+    ):
+        return None
+
+    expected = grid.copy()
+    expected[layout["main_rows"], layout["main_cols"]] = expected_region
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
