+def _paint_border(region: np.ndarray, op_colors: list[int], rng: np.random.Generator) -> None:
+    h, w = region.shape
+    region[0, :] = rng.choice(op_colors, size=w)
+    region[h - 1, :] = rng.choice(op_colors, size=w)
+    region[:, 0] = rng.choice(op_colors, size=h)
