+
+PairKey = tuple[int, int]
+
+
+def _pair_key(a: int, b: int) -> PairKey:
+    a = int(a)
+    b = int(b)
+    return (a, b) if a <= b else (b, a)
+
+
+def _slice_size(s: slice) -> int:
+    return int(s.stop - s.start)
