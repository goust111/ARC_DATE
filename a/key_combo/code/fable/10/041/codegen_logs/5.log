+    candidates = [
+        (int(r), int(c))
+        for r in blocked_rows
+        for c in blocked_cols
+        if (int(r), int(c)) not in positions
+    ]
+    extra_limit = min(EXTRA_BLOCKER_CAP, len(candidates))
+    if extra_limit > 0:
+        extra_count = _sample_int(rng, 0, extra_limit)
+        if extra_count > 0:
