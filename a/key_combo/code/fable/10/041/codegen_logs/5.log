  "src": "complete 4-connected multicolor sprite s in the source panel",
  "dst": "marker mask d in the opposite panel",
  "match_cond": "s.internal marker colors and relative coordinates equal d up to translation; chosen matches cover every target marker pixel exactly once",
  "transform": "stamp s onto d's panel with s.background transparent; output that panel",
  "grid_shape": "one of the two equal input panels"
}
</annotation>
