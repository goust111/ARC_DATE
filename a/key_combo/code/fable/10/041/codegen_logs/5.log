+PANEL_WIDTH = 3
+OP_COLOR_COUNT_CHOICES = (3, 4)
+CORNERS = ("tl", "tr", "bl", "br")
+MAIN_HEIGHT_RANGE = (7, 17)
+MAIN_WIDTH_RANGE = (8, 19)
+CLEAR_ROW_RANGE = (1, 4)
+CLEAR_COL_RANGE = (1, 3)
+EXTRA_BLOCKER_CAP = 8
+GENERATION_RETRIES = 500
