+    max_clear = min(bounds[1], len(interior) - 1)
+    min_clear = min(bounds[0], max_clear)
+    assert max_clear >= 1
+    count = _sample_int(rng, min_clear, max_clear)
+    return set(map(int, rng.choice(interior, size=count, replace=False)))
