+    return out
+
+
+def _axis_orbits(shape: tuple[int, int], orientation: str) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    h, w = shape
+    seen = set()
+    orbits = []
+    for r in range(h):
+        for c in range(w):
+            if orientation == "vertical":
