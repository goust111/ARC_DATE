+def _repair_central_axis(
+    crop: np.ndarray, pair: tuple[int, int], corruption: int, orientation: str
+) -> np.ndarray | None:
+    h, w = crop.shape
+    out = crop.copy()
+
+    if orientation == "vertical":
+        for r in range(h):
+            for c in range(w):
+                cc = w - 1 - c
+                a = int(crop[r, c])
+                b = int(crop[r, cc])
+                if c == cc:
+                    if a == corruption:
+                        return None
+                    continue
+                if a == corruption and b == corruption:
+                    return None
+                if a != corruption and b != corruption and a != b:
+                    return None
+                if a == corruption:
+                    if b not in pair:
+                        return None
+                    out[r, c] = b
+                elif b == corruption:
+                    if a not in pair:
+                        return None
+                    out[r, cc] = a
+    else:
+        for r in range(h):
+            rr = h - 1 - r
+            for c in range(w):
+                a = int(crop[r, c])
+                b = int(crop[rr, c])
+                if r == rr:
+                    if a == corruption:
+                        return None
+                    continue
+                if a == corruption and b == corruption:
+                    return None
+                if a != corruption and b != corruption and a != b:
+                    return None
+                if a == corruption:
+                    if b not in pair:
+                        return None
+                    out[r, c] = b
+                elif b == corruption:
+                    if a not in pair:
+                        return None
+                    out[rr, c] = a
+
+    if np.any(out == corruption):
+        return None
+    if set(map(int, out.ravel())) != set(pair):
+        return None
+    return out
+
+
+def _find_candidate(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
