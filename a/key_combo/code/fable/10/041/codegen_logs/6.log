+            out[:, left_w:] = source[:, : left_w - 1][:, ::-1]
+        else:
+            out[:, left_w:] = source[:, ::-1]
+    else:
+        top_h = (height + 1) // 2
+        out[:top_h, :] = source
+        if height % 2:
