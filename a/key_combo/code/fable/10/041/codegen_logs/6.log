+    count_b = int(np.sum(out == color_b))
+    count_a = int(out.size - count_b)
+    if min(count_a, count_b) < 6:
+        return None
+    ratio = count_b / float(out.size)
+    if not (0.18 <= ratio <= 0.62):
+        return None
