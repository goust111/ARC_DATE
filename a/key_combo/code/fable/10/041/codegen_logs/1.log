+from __future__ import annotations
+
+from collections import Counter, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+SIDE_FROM_DELTA = {(-1, 0): "U", (1, 0): "D", (0, -1): "L", (0, 1): "R"}
+FRAME_SIZES = (5, 7)
+GEN_RETRIES = 400
+
+
+@dataclass(frozen=True)
+class Frame:
+    color: int
+    bbox: tuple[int, int, int, int]
+    kind: str
+    gaps: tuple[str, ...]
+    gap_pos: dict[str, tuple[int, int]]
+    center: tuple[int, int]
+    coords: frozenset[tuple[int, int]]
+
+
+@dataclass(frozen=True)
+class SignalTrace:
+    outcome: str
+    final_pos: tuple[int, int] | None
+    final_color: int | None
+    pipes: tuple[int, ...]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(grid: np.ndarray, bg: int) -> list[tuple[int, set[tuple[int, int]]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, set[tuple[int, int]]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                cells.add((rr, cc))
+                for dr, dc in DIRS.values():
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append((color, cells))
+    return comps
+
+
+def _bbox(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _gap_side(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = gap
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return "U"
+    if r == r1:
+        return "D"
+    if c == c0:
+        return "L"
+    if c == c1:
+        return "R"
+    raise AssertionError("gap must lie on the border")
+
+
+def _is_corner(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    return (r in (r0, r1)) and (c in (c0, c1))
+
+
+def _detect_frames(grid: np.ndarray, bg: int) -> tuple[list[Frame], dict[tuple[int, int], Frame], set[tuple[int, int]]]:
+    frames: list[Frame] = []
+    gap_map: dict[tuple[int, int], Frame] = {}
+    walls: set[tuple[int, int]] = set()
+    for color, cells in _components(grid, bg):
+        if len(cells) == 1:
+            continue
+        r0, c0, r1, c1 = _bbox(cells)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        if (r1 - r0) % 2 != 0 or (c1 - c0) % 2 != 0:
+            continue
+        border = {
+            (r, c)
+            for r in range(r0, r1 + 1)
+            for c in range(c0, c1 + 1)
+            if r in (r0, r1) or c in (c0, c1)
+        }
+        if not cells <= border:
+            continue
+        gaps = tuple(sorted(border - cells))
+        if len(gaps) not in (1, 2):
+            continue
+        if any(_is_corner(gap, (r0, c0, r1, c1)) for gap in gaps):
+            continue
+        sides = tuple(_gap_side(gap, (r0, c0, r1, c1)) for gap in gaps)
+        if len(gaps) == 2:
+            if len(set(sides)) != 2:
+                continue
+            if set(sides) in ({"U", "D"}, {"L", "R"}):
+                continue
+        center = ((r0 + r1) // 2, (c0 + c1) // 2)
+        kind = "room" if len(gaps) == 1 else "pipe"
+        frame = Frame(
+            color=int(color),
+            bbox=(r0, c0, r1, c1),
+            kind=kind,
+            gaps=tuple(sides),
+            gap_pos={side: gap for side, gap in zip(sides, gaps)},
+            center=center,
+            coords=frozenset(cells),
+        )
+        frames.append(frame)
+        walls |= cells
+        for gap in gaps:
+            assert gap not in gap_map, "gaps must be unique"
+            gap_map[gap] = frame
+    assert frames, "expected at least one rectangular frame"
+    return frames, gap_map, walls
+
+
+def _find_beacons(grid: np.ndarray, bg: int, frames: list[Frame]) -> list[tuple[Frame, int]]:
+    frame_cells = set().union(*(frame.coords for frame in frames))
+    centers = {frame.center: frame for frame in frames if frame.kind == "room"}
+    beacons: list[tuple[Frame, int]] = []
+    for pos, frame in centers.items():
+        value = int(grid[pos])
+        if value == bg:
+            continue
+        assert pos not in frame_cells
+        assert value != frame.color
+        beacons.append((frame, value))
+    foreground = {(r, c) for r, c in zip(*np.where(grid != bg))}
+    allowed = frame_cells | {frame.center for frame, _color in beacons}
+    assert foreground <= allowed, "unexpected non-background pixels outside frames or room centers"
+    assert beacons, "expected at least one beacon"
+    return beacons
+
+
+def _trace_signal(
+    grid: np.ndarray,
+    gap_map: dict[tuple[int, int], Frame],
+    walls: set[tuple[int, int]],
+    source_room: Frame,
+    start_color: int,
+) -> SignalTrace:
+    h, w = grid.shape
+    gap_side = source_room.gaps[0]
+    dr, dc = DIRS[gap_side]
+    gap_r, gap_c = source_room.gap_pos[gap_side]
+    cur_r, cur_c = gap_r + dr, gap_c + dc
+    color = int(start_color)
+    pipes: list[int] = []
+
+    while True:
+        nr, nc = cur_r + dr, cur_c + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            return SignalTrace("delete", None, None, tuple(pipes))
+        next_pos = (nr, nc)
+        frame = gap_map.get(next_pos)
+        if frame is not None and OPPOSITE[frame.gaps[0] if frame.kind == "room" else ""] != "":
+            pass
+        if frame is not None:
+            seen_side = SIDE_FROM_DELTA[(-dr, -dc)]
+            if seen_side in frame.gap_pos and frame.gap_pos[seen_side] == next_pos:
+                if frame.kind == "room":
+                    return SignalTrace("room", frame.center, color, tuple(pipes))
+                pipes.append(frame.color)
+                color = frame.color
+                other_side = next(side for side in frame.gaps if side != seen_side)
+                dr, dc = DIRS[other_side]
+                gap_r, gap_c = frame.gap_pos[other_side]
+                cur_r, cur_c = gap_r + dr, gap_c + dc
+                if not (0 <= cur_r < h and 0 <= cur_c < w):
+                    return SignalTrace("delete", None, None, tuple(pipes))
+                continue
+        if next_pos in walls:
+            return SignalTrace("wall", (cur_r, cur_c), color, tuple(pipes))
+        cur_r, cur_c = nr, nc
+
+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, dict[tuple[int, int], SignalTrace]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _get_bg(g)
+    frames, gap_map, walls = _detect_frames(g, bg)
+    beacons = _find_beacons(g, bg, frames)
+
+    out = g.copy()
+    traces: dict[tuple[int, int], SignalTrace] = {}
+    finals: dict[tuple[int, int], int] = {}
+
+    for room, _color in beacons:
+        out[room.center] = bg
+
+    for room, color in beacons:
+        trace = _trace_signal(g, gap_map, walls, room, color)
+        traces[room.center] = trace
+        if trace.final_pos is None:
+            continue
+        assert trace.final_pos not in finals, "two beacons cannot finish in the same cell"
+        finals[trace.final_pos] = int(trace.final_color)
+
+    for pos, color in finals.items():
+        assert out[pos] == bg, "final beacon must land on background"
+        out[pos] = color
+    return out, traces
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Send each room-center beacon out through its room gap, relay it through bend pipes, and stop it at the first valid destination.
+
+    Input structure:
+    - The grid has a dominant background plus several one-cell-thick monochrome rectangular frames.
+    - Each frame is either a room with exactly one non-corner gap or a bend pipe with exactly two non-corner gaps on adjacent sides.
+    - Some room centers contain a single beacon pixel whose color differs from that room frame; other room centers are empty.
+
+    Rule:
+    - Every beacon leaves its source room through that room's gap and travels straight in the gap's outward direction.
+    - If the next encountered border cell is a wall, the beacon stops on the background cell immediately outside that wall.
+    - If the beacon reaches a frame through one of its gaps, it enters that frame: entering a pipe recolors the beacon to the pipe color and sends it out through the other gap, while entering a room stops it at that room's center.
+    - A beacon that exits the grid disappears; all frames stay unchanged, source centers are cleared, and only the final beacon positions remain.
+
+    Key insight:
+    - A gap is a directional doorway, not a leak: single-gap frames are launch or landing rooms, while two-gap frames both turn the travel direction and overwrite the beacon color.
+    """
+    out, _traces = _solve(grid)
+    return out
+
+
+def _rotate_pos(r: int, c: int, k: int) -> tuple[int, int]:
+    for _ in range(k % 4):
+        r, c = c, 2 - r
+    return r, c
+
+
+def _rotate_dir(dr: int, dc: int, k: int) -> tuple[int, int]:
+    for _ in range(k % 4):
+        dr, dc = dc, -dr
+    return dr, dc
+
+
+def _transform_pos(pos: tuple[int, int], rot: int, mirror: bool) -> tuple[int, int]:
+    r, c = _rotate_pos(pos[0], pos[1], rot)
+    if mirror:
+        c = 2 - c
+    return r, c
+
+
+def _transform_side(side: str, rot: int, mirror: bool) -> str:
+    dr, dc = _rotate_dir(*DIRS[side], rot)
+    if mirror:
+        dc = -dc
+    return SIDE_FROM_DELTA[(dr, dc)]
+
+
+def _center_grids(h: int, w: int) -> tuple[list[int], list[int]]:
+    rows = [3, h // 2, h - 4]
+    cols = [3, w // 2, w - 4]
+    assert rows[0] < rows[1] < rows[2]
+    assert cols[0] < cols[1] < cols[2]
+    return rows, cols
+
+
+def _draw_frame(
+    grid: np.ndarray,
+    center: tuple[int, int],
+    size: int,
+    color: int,
+    gaps: tuple[str, ...],
+) -> dict[str, tuple[int, int]]:
+    half = size // 2
+    cr, cc = center
+    r0, c0 = cr - half, cc - half
+    r1, c1 = cr + half, cc + half
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    gap_pos = {
+        "U": (r0, cc),
+        "D": (r1, cc),
+        "L": (cr, c0),
+        "R": (cr, c1),
+    }
+    for side in gaps:
+        grid[gap_pos[side]] = 0
+    return gap_pos
+
+
+def _manual_expected(
+    inp: np.ndarray,
+    objects: dict[str, dict[str, object]],
+) -> np.ndarray:
+    out = inp.copy()
+    for role in ("source_wall", "source_delete", "source_chain", "source_direct"):
+        center = objects[role]["center"]
+        out[center] = 0
+
+    sink_chain_center = objects["sink_chain"]["center"]
+    sink_direct_center = objects["sink_direct"]["center"]
+    out[sink_chain_center] = int(objects["pipe2"]["color"])
+    out[sink_direct_center] = int(objects["source_direct"]["beacon"])
+
+    dir_wall = DIRS[objects["source_wall"]["gap"]]
+    sink_wall_center = objects["sink_chain"]["center"]
+    sink_wall_half = objects["sink_chain"]["size"] // 2
+    wall_pos = (
+        sink_wall_center[0] - dir_wall[0] * (sink_wall_half + 1),
+        sink_wall_center[1] - dir_wall[1] * (sink_wall_half + 1),
+    )
+    out[wall_pos] = int(objects["source_wall"]["beacon"])
+    return out
+
+
+def _validate_layout(objects: dict[str, dict[str, object]], h: int, w: int) -> None:
+    occupied: set[tuple[int, int]] = set()
+    for obj in objects.values():
+        center = obj["center"]
+        size = int(obj["size"])
+        half = size // 2
+        cr, cc = center
+        assert half >= 2
+        assert 0 <= cr - half and cr + half < h
+        assert 0 <= cc - half and cc + half < w
+        bbox_cells = {
+            (r, c)
+            for r in range(cr - half, cr + half + 1)
+            for c in range(cc - half, cc + half + 1)
+        }
+        assert occupied.isdisjoint(bbox_cells)
+        occupied |= bbox_cells
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray]:
+    h = random.randint(26, 29)
+    w = random.randint(26, 29)
+    rows, cols = _center_grids(h, w)
+    grid = np.zeros((h, w), dtype=int)
+
+    rot = random.randint(0, 3)
+    mirror = bool(random.randint(0, 1))
+    palette = random.sample(range(1, 10), 9)
+    pipe_colors = palette[:2]
+    room_colors = palette[2:5]
+    beacon_colors = palette[5:9]
+
+    base = {
+        "source_wall": {"kind": "room", "cell": (0, 0), "gap": "R", "beacon": beacon_colors[0]},
+        "sink_chain": {"kind": "room", "cell": (0, 1), "gap": "D"},
+        "source_delete": {"kind": "room", "cell": (0, 2), "gap": "U", "beacon": beacon_colors[1]},
+        "pipe1": {"kind": "pipe", "cell": (1, 0), "gaps": ("D", "R"), "color": pipe_colors[0]},
+        "pipe2": {"kind": "pipe", "cell": (1, 1), "gaps": ("L", "U"), "color": pipe_colors[1]},
+        "sink_direct": {"kind": "room", "cell": (1, 2), "gap": "D"},
+        "source_chain": {"kind": "room", "cell": (2, 0), "gap": "U", "beacon": beacon_colors[2]},
+        "dummy": {"kind": "room", "cell": (2, 1), "gap": "D"},
+        "source_direct": {"kind": "room", "cell": (2, 2), "gap": "U", "beacon": beacon_colors[3]},
+    }
+
+    room_role_order = [role for role, data in base.items() if data["kind"] == "room"]
+    room_color_map = {role: room_colors[i % len(room_colors)] for i, role in enumerate(room_role_order)}
+
+    objects: dict[str, dict[str, object]] = {}
+    for role, data in base.items():
+        tr, tc = _transform_pos(data["cell"], rot, mirror)
+        center = (rows[tr], cols[tc])
+        size = random.choice(FRAME_SIZES)
+        if data["kind"] == "room":
+            gap = _transform_side(data["gap"], rot, mirror)
+            objects[role] = {
+                "kind": "room",
+                "center": center,
+                "size": size,
+                "gap": gap,
+                "color": room_color_map[role],
+            }
+            if "beacon" in data:
+                objects[role]["beacon"] = int(data["beacon"])
+        else:
+            gaps = tuple(_transform_side(side, rot, mirror) for side in data["gaps"])
+            objects[role] = {
+                "kind": "pipe",
+                "center": center,
+                "size": size,
+                "gaps": gaps,
+                "color": int(data["color"]),
+            }
+
+    _validate_layout(objects, h, w)
+
+    for role, obj in objects.items():
+        gaps = (obj["gap"],) if obj["kind"] == "room" else tuple(obj["gaps"])
+        _draw_frame(grid, obj["center"], int(obj["size"]), int(obj["color"]), gaps)
+        if role.startswith("source_"):
+            grid[obj["center"]] = int(obj["beacon"])
+
+    expected = _manual_expected(grid, objects)
+    return grid, expected
+
+
+def _semantic_ok(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        solved, traces = _solve(inp)
+    except AssertionError:
+        return False
+    if not np.array_equal(solved, expected):
+        return False
+
+    by_outcome = Counter(trace.outcome for trace in traces.values())
+    if by_outcome != Counter({"room": 2, "wall": 1, "delete": 1}):
+        return False
+
+    pipe_lens = sorted(len(trace.pipes) for trace in traces.values())
+    if pipe_lens != [0, 0, 0, 2]:
+        return False
+
+    if len({trace.final_pos for trace in traces.values() if trace.final_pos is not None}) != 3:
+        return False
+
+    room_colors = {trace.final_color for trace in traces.values() if trace.outcome == "room"}
+    wall_colors = {trace.final_color for trace in traces.values() if trace.outcome == "wall"}
+    if len(room_colors) != 2 or len(wall_colors) != 1:
+        return False
+    if room_colors & wall_colors:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        inp, expected = _build_case()
+        if _semantic_ok(inp, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid gate-pipe puzzle input")

