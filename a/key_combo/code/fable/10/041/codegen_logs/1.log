+    base = {
+        "source_wall": {"kind": "room", "cell": (0, 0), "gap": "R", "beacon": beacon_colors[0]},
+        "sink_chain": {"kind": "room", "cell": (0, 1), "gap": "D"},
+        "source_delete": {"kind": "room", "cell": (0, 2), "gap": "U", "beacon": beacon_colors[1]},
+        "pipe1": {"kind": "pipe", "cell": (1, 0), "gaps": ("D", "R"), "color": pipe_colors[0]},
+        "pipe2": {"kind": "pipe", "cell": (1, 1), "gaps": ("L", "U"), "color": pipe_colors[1]},
+        "sink_direct": {"kind": "room", "cell": (1, 2), "gap": "D"},
+        "source_chain": {"kind": "room", "cell": (2, 0), "gap": "U", "beacon": beacon_colors[2]},
+        "dummy": {"kind": "room", "cell": (2, 1), "gap": "D"},
+        "source_direct": {"kind": "room", "cell": (2, 2), "gap": "U", "beacon": beacon_colors[3]},
+    }
+
+    room_role_order = [role for role, data in base.items() if data["kind"] == "room"]
+    room_color_map = {role: room_colors[i % len(room_colors)] for i, role in enumerate(room_role_order)}
+
+    objects: dict[str, dict[str, object]] = {}
+    for role, data in base.items():
+        tr, tc = _transform_pos(data["cell"], rot, mirror)
+        center = (rows[tr], cols[tc])
+        size = random.choice(FRAME_SIZES)
+        if data["kind"] == "room":
+            gap = _transform_side(data["gap"], rot, mirror)
+            objects[role] = {
+                "kind": "room",
+                "center": center,
+                "size": size,
+                "gap": gap,
+                "color": room_color_map[role],
+            }
+            if "beacon" in data:
+                objects[role]["beacon"] = int(data["beacon"])
+        else:
+            gaps = tuple(_transform_side(side, rot, mirror) for side in data["gaps"])
+            objects[role] = {
+                "kind": "pipe",
+                "center": center,
+                "size": size,
