+
+def _validate_layout(objects: dict[str, dict[str, object]], h: int, w: int) -> None:
+    occupied: set[tuple[int, int]] = set()
+    for obj in objects.values():
+        center = obj["center"]
+        size = int(obj["size"])
+        half = size // 2
+        cr, cc = center
+        assert half >= 2
+        assert 0 <= cr - half and cr + half < h
+        assert 0 <= cc - half and cc + half < w
+        bbox_cells = {
+            (r, c)
+            for r in range(cr - half, cr + half + 1)
+            for c in range(cc - half, cc + half + 1)
+        }
+        assert occupied.isdisjoint(bbox_cells)
+        occupied |= bbox_cells
