+                continue
+            if set(sides) in ({"U", "D"}, {"L", "R"}):
+                continue
+        center = ((r0 + r1) // 2, (c0 + c1) // 2)
+        kind = "room" if len(gaps) == 1 else "pipe"
+        frame = Frame(
+            color=int(color),
+            bbox=(r0, c0, r1, c1),
+            kind=kind,
+            gaps=tuple(sides),
