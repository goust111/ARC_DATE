+def _port_cell(center: tuple[int, int], side: str, offset: int, *, size: int = 5) -> tuple[int, int]:
+    half = size // 2
+    cr, cc = center
+    if side == "U":
+        return cr - half, cc + offset
+    if side == "D":
+        return cr + half, cc + offset
+    if side == "L":
+        return cr + offset, cc - half
+    if side == "R":
