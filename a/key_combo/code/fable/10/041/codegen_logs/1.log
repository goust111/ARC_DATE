+def _build_case() -> tuple[np.ndarray, np.ndarray]:
+    base_h = base_w = 26
+    grid = np.zeros((base_h, base_w), dtype=int)
+    palette = random.sample(range(1, 10), 9)
+    beacon_color = palette[-1]
+    frame_colors = palette[:-1]
+    centers = {
