spec:
  grid: 14-17 rows x 14-18 cols, black background
  input:
    markers: exactly 4 non-black pixels on an otherwise black grid
    colors: exactly 2 foreground colors (not grey), each appearing twice
    layout: the 4 pixels sit at corners of an axis-aligned rectangle (2 distinct rows, 2 distinct cols)
    diagonal_pairing: same color on diagonally opposite corners (TL==BR, TR==BL, TL!=TR)
    rectangle: height 5-11, width 5-11 (measured as row/col difference)
    margin: each corner pixel >=1 cell from every grid edge (for 3x3 glyph clearance)
    gap: rectangle height and width both >=4 (so dash gap has >=2 cells)
  output:
    glyphs: each corner marker becomes a 3x3 block; center keeps marker color, 8 neighbors get the other color
    dashes: grey (5) dashed lines along each rectangle side between adjacent glyphs
    dash_rule: gap cells at positions 0..n-1; cell painted grey iff min(i, n-1-i) is even
    gap_span: horizontal gap cols [left+2, right-2], vertical gap rows [top+2, bottom-2]

generation_strategy:
