+
+CANVAS_COLOR = 0
+BAR_COLOR = 5
+PAGE_BG_POOL = (8, 9)
+PANEL_BG_POOL = (4, 6, 7)
+SHAPE_COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MAX_SLOT = 5
+TOP_GUTTER = 5
+LEFT_GUTTER = 5
