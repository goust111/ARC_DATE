+    rows = [r for r, _c in shape]
+    cols = [c for _r, c in shape]
+    patch = np.zeros((max(rows) + 1, max(cols) + 1), dtype=int)
+    for r, c in shape:
+        patch[r, c] = int(body_color)
+    patch[yellow] = int(YELLOW)
+    patch[red] = int(RED)
