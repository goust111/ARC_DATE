+def _normalize_shape(shape: set[Coord]) -> tuple[Coord, ...]:
+    r0 = min(r for r, _c in shape)
+    c0 = min(c for _r, c in shape)
+    return tuple(sorted((r - r0, c - c0) for r, c in shape))
