+        "grey_cols": tuple(grey_cols),
+        "branch_has_hidden_invader": branch_has_hidden_invader,
+        "full_cells": tuple(tuple(_pattern_key(cell) for cell in row) for row in full_cells),
+        "invader_key": _pattern_key(invader_cell),
