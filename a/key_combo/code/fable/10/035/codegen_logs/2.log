spec:
  grid:
    dimensions: odd H x odd W; H and W independently 5-11
    quadrant_size: (H//2) x (W//2), i.e. 2-5 rows x 2-5 cols
    separator: middle row and middle column filled entirely with bg color
  colors:
    bg: 0 (black)
    fg: exactly 1 non-zero color (1-9)
    each quadrant uses only bg and fg (2 colors total)
  quadrants:
    count: 4 (TL, TR, BL, BR), all same size, separated by the bg cross
    pattern: exactly 3 share an identical pixel pattern; 1 is unique (the odd-one-out)
    unique_position: any of the 4 quadrant slots, uniformly chosen
