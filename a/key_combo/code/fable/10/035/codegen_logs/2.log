+def _find_occluder(cells: list[list[np.ndarray]]) -> tuple[int, list[int], np.ndarray]:
+    n = len(cells)
+    by_key: dict[bytes, list[tuple[int, int]]] = defaultdict(list)
+    patch_by_key: dict[bytes, np.ndarray] = {}
