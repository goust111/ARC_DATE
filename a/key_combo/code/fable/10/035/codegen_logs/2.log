+    filled = [[cell.copy() for cell in row] for row in cells]
+    if len(visible_invader_cols) == n:
+        for c in grey_cols:
+            filled[hidden_row][c] = base.copy()
+    else:
+        missing_col = next(c for c in range(n) if c not in visible_invader_cols)
