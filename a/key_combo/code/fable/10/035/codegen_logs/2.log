+
+    line_colors = [int(g[r, 0]) for r in row_lines] + [int(g[0, c]) for c in col_lines]
+    lattice = int(Counter(line_colors).most_common(1)[0][0])
+
+    row_lines = sorted(r for r in row_lines if int(g[r, 0]) == lattice)
