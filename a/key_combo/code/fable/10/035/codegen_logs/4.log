+            max_area=min(6, remaining),
+            max_h=3,
+            max_w=3,
+            must_touch=mask if prefer_touch else None,
+        )
+        if not candidates and prefer_touch:
+            candidates = _rectangle_candidates(
+                extra_allowed, min_area=1, max_area=min(6, remaining), max_h=3, max_w=3
+            )
+        if not candidates:
