+    bg, _sep, left, middle, right = _parse_grid(np.asarray(grid, dtype=int))
+    canvas = left.copy()
+    for panel in (middle, right):
+        canvas, _accepted = _apply_trial(canvas, panel, bg)
+    return canvas
