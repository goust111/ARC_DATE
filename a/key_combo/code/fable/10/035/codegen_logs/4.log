  "dst": "horizontally paired panel d in the same row band",
  "match_cond": "s.panel and d are paired across the separator columns within the same row band",
  "transform": "clear d to its dominant base color and draw s using s.panel base color"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    separator_color: 0 (always black)
    separator_row_thickness: 2 [observed]
    separator_col_thickness: 1-2
    layout: 2 panel columns x 2-4 row bands, all panels identical shape
  panels:
    shape: 6-8 rows x 7-8 cols, uniform across entire grid
    each_panel: exactly 2 colors -- dominant base color (>=70% cells) and 1 minority motif color
    motif_fraction: 10-31% of panel cells
    motif_border: never touches panel edge (>=1 cell margin on all sides)
    motif_connectivity: usually 1 connected component, occasionally 2-4
  pair_colors:
    within_pair: left and right have distinct motif colors; base colors may match or differ
    same_base_frequency: ~25% of pairs share a base color [observed]
    cross-pair: motif color may coincidentally equal another panel's base color (no constraint)
  rule:
    for each row-band pair, swap motif masks between left and right panels
    recolor each swapped mask with the source panel's base color
    when bases match, swapped motif painted in same-base vanishes -- output is uniform base

generation_strategy:
  approach: output-first
  steps:
    1. Choose num_bands (2-4), panel_shape (6-8 x 7-8), sep_row_thickness=2, sep_col_thickness (1-2)
    2. For each band, pick 2 base colors and 2 motif colors (all 4 distinct per pair unless bases match, then 3)
    3. Build output panels -- for each pair, generate two random motif masks (10-31% fill, >=1 margin, connected or few components)
    4. Place right output motif (colored right_base) into left output panel, left output motif (colored left_base) into right output panel
    5. Derive input by un-swapping -- left input gets left motif mask colored with an arbitrary distractor motif color, right input gets right motif mask colored with its own arbitrary distractor motif color
    6. Assemble grid with separator rows/cols of color 0
