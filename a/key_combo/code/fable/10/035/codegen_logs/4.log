+    h, w = map(int, left.shape)
+    out = np.full((h, 3 * w + 2), bg, dtype=int)
+    out[:, w] = sep
+    out[:, 2 * w + 1] = sep
+    out[:, :w] = _mask_to_panel(left, bg, colors[0])
+    out[:, w + 1 : 2 * w + 1] = _mask_to_panel(middle, bg, colors[1])
+    out[:, 2 * w + 2 :] = _mask_to_panel(right, bg, colors[2])
+    return out
