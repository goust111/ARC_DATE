+    groups = defaultdict(list)
+    for coord in interior_coords:
+        side = color_to_side[int(g[coord])]
+        line = _line_key(coord, side)
+        aligned = side == gap_side and line == _line_key(gap, gap_side)
+        if exit_policy == "aligned_only":
