+            "exit": True,
+            "color": side_colors[gap_side],
+            "targets": exit_cells,
+        }
+    )
+    occupied.update(exit_cells)
+
+    for side in SIDES:
+        lines = line_pool[side][:]
+        random.shuffle(lines)
