0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Move red into teal's top marker position, then move teal to the bottom outside corner of the grey rectangle.
0009: 
0010:     Input structure
0011:     - The dominant background surrounds one filled rectangular non-background block.
0012:     - There is exactly one red marker and one teal marker, both in the row immediately above the rectangle.
0013:     - Both markers are horizontally aligned over columns inside the rectangle.
0014: 
0015:     Rule
0016:     - Clear the original red marker.
0017:     - Recolor the original teal marker cell red.
0018:     - Place the teal marker beside the rectangle's bottom row, on the side indicated by the horizontal direction from red to teal.
0019: 
0020:     Key insight
0021:     - The red-to-teal horizontal order chooses the rectangle side where teal exits at the bottom.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     assert g.ndim == 2
0025:     H, W = g.shape
0026:     bg = get_bg(g)
0027: 
0028:     red_coords = np.argwhere(g == Color.RED)
0029:     teal_coords = np.argwhere(g == Color.TEAL)
0030:     assert len(red_coords) == 1, "expected exactly one red marker"
0031:     assert len(teal_coords) == 1, "expected exactly one teal marker"
0032:     red_r, red_c = map(int, red_coords[0])
0033:     teal_r, teal_c = map(int, teal_coords[0])
0034: 
0035:     rect_mask = (g != bg) & (g != Color.RED) & (g != Color.TEAL)
0036:     rect_colors = set(map(int, g[rect_mask]))
0037:     assert len(rect_colors) == 1, "expected one rectangle color besides the markers"
0038: 
0039:     rect_bbox = bbox(rect_mask)
0040:     assert rect_bbox is not None, "expected a filled rectangle"
0041:     r0, c0, r1, c1 = rect_bbox
0042:     rect_h = r1 - r0 + 1
0043:     rect_w = c1 - c0 + 1
0044:     assert int(rect_mask.sum()) == rect_h * rect_w, "rectangle must fill its bbox"
0045:     assert np.all(rect_mask[r0 : r1 + 1, c0 : c1 + 1]), "rectangle bbox must be solid"
0046: 
0047:     assert red_r == teal_r == r0 - 1, "markers must sit directly above the rectangle"
0048:     assert c0 <= red_c <= c1 and c0 <= teal_c <= c1, "markers must align over rectangle columns"
0049:     assert red_c != teal_c, "red and teal markers must be horizontally separated"
0050: 
0051:     side = 1 if teal_c > red_c else -1
0052:     exit_r = r1
0053:     exit_c = c1 + 1 if side > 0 else c0 - 1
0054:     assert 0 <= exit_r < H and 0 <= exit_c < W, "teal exit cell must be inside the grid"
0055:     assert g[exit_r, exit_c] == bg, "teal exit cell must be background"
0056: 
0057:     out = g.copy()
0058:     out[red_r, red_c] = bg
0059:     out[teal_r, teal_c] = Color.RED
0060:     out[exit_r, exit_c] = Color.TEAL
0061:     return out
