0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """
0024:     Move each non-bar foreground pixel one row downward, and splash diagonal rays upward when it lands directly above the bar.
0025: 
0026:     Input structure
0027:     - The background is the dominant color.
0028:     - One foreground color forms a single full-width horizontal bar.
0029:     - The only other foreground color appears as isolated moving pixels off the bar.
0030: 
0031:     Rule
0032:     - Clear the moving pixels from their original locations and paint each one at the same column one row lower.
0033:     - If a moved pixel lands immediately above the horizontal bar, also paint both upward diagonals from that landing pixel until they leave the grid.
0034:     - The full-width bar and all background cells outside those shifted/splashed paths remain unchanged.
0035: 
0036:     Key insight
0037:     - The bar is a trigger line: pixels always shift down one step, but only pixels that become adjacent to the bar emit the diagonal splash.
0038:     """
0039:     g = np.asarray(grid, dtype=int)
0040:     assert g.ndim == 2, "expected a 2D grid"
0041:     H, W = g.shape
0042:     assert H > 1 and W > 0, "grid must have room for downward movement"
0043: 
0044:     bg = get_bg(g)
0045:     bar_r, bar_color = _full_width_bar(g, bg)
0046:     assert bar_r > 0, "bar must have a row above it for splash detection"
0047: 
0048:     moving_colors = [color for color in colors_present(g, exclude={bg, bar_color})]
0049:     assert len(moving_colors) == 1, "expected exactly one moving foreground color"
0050:     moving_color = moving_colors[0]
0051: 
0052:     source_coords = [tuple(map(int, coord)) for coord in np.argwhere(g == moving_color)]
0053:     assert source_coords, "expected at least one moving pixel"
0054:     assert all(r != bar_r for r, _c in source_coords), "moving pixels cannot lie on the bar"
0055: 
0056:     out = g.copy()
0057:     out[g == moving_color] = bg
0058: 
0059:     paint: set[tuple[int, int]] = set()
0060:     for r, c in source_coords:
0061:         moved_r = r + 1
0062:         assert moved_r < H, "moving pixel cannot shift beyond the bottom edge"
0063:         assert moved_r != bar_r, "moving pixel cannot shift into the bar"
