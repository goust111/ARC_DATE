  "path": "from s toward the rectangle side away from the red marker, then down to the background cell beside the rectangle's bottom row",
  "dst": "place s at that bottom-side endpoint",
  "trajectory": "paint only the endpoint teal",
  "transform": "clear the original red marker to background; recolor s.old cell red; keep the rectangle and other background unchanged"
}
</annotation>
<generation_spec>
