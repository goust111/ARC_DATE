+    top_color = _dominant_non_bg(g[r0, c0 : c1 + 1], bg)
+    bottom_color = _dominant_non_bg(g[r1, c0 : c1 + 1], bg)
+    left_color = _dominant_non_bg(g[r0 + 1 : r1, c0], bg)
+    right_color = _dominant_non_bg(g[r0 + 1 : r1, c1], bg)
