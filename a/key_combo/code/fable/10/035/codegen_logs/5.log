0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """Compare the two same-sized motifs and output the cropped mask of cells missing from the damaged copy.
0010: 
0011:     Input structure
0012:     - The black background contains exactly two 4-connected multicolor foreground objects.
0013:     - The two objects have the same rectangular bbox shape and represent aligned copies of the same motif.
0014:     - One object is complete; the other is a damaged copy with only foreground cells removed.
0015: 
0016:     Rule
0017:     - Align the two object crops by their bbox top-left corners.
0018:     - Select the cells that are foreground in the complete crop and background in the damaged crop.
0019:     - Crop that missing-cell mask to its own bbox, recolor selected cells teal, and leave other cells black.
0020: 
0021:     Key insight
0022:     - The output is not one of the colored motifs; it is the shape of the damage after subtracting the smaller motif mask from the larger matching motif mask.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
0026:     assert bg == Color.BLACK, "expected black background"
0027: 
0028:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0029:     assert len(components) == 2, "expected exactly two motif objects"
0030: 
0031:     crops = [crop_bbox(g, component["bbox"]) for component in components]
0032:     assert crops[0].shape == crops[1].shape, "motif bboxes must have the same shape"
0033: 
0034:     candidates = []
0035:     for complete, damaged in ((crops[0], crops[1]), (crops[1], crops[0])):
0036:         complete_mask = complete != bg
0037:         damaged_mask = damaged != bg
0038:         missing = complete_mask & ~damaged_mask
0039:         extra = damaged_mask & ~complete_mask
0040:         overlap = complete_mask & damaged_mask
0041:         if missing.any() and not extra.any() and np.array_equal(complete[overlap], damaged[overlap]):
0042:             candidates.append(missing)
0043: 
0044:     assert len(candidates) == 1, "expected a unique complete-to-damaged mask difference"
0045:     missing = candidates[0]
0046:     missing_bbox = bbox(missing)
