+            if np.array_equal(_wrong_all_gap_color_exit(inp), expected):
+                continue
+            if np.array_equal(_wrong_stop_outside_gap(inp), expected):
+                continue
+        except Exception:
+            continue
+        return inp
+    raise RuntimeError("failed to generate a valid input")

