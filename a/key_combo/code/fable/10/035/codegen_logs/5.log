0071:                     paint.add((rr, cc))
0072:                     rr -= 1
0073:                     cc += dc
0074: 
0075:     for r, c in paint:
0076:         assert out[r, c] == bg, "painted cells must be background after clearing moving pixels"
0077:         out[r, c] = moving_color
0078: 
0079:     return out
