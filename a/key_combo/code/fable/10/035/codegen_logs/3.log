                elif abs(dr) == 1 and abs(dc) == 1:
                    value = Color.GREY
                else:
                    value = Color.BLUE

                if written[rr, cc]:
                    assert values[rr, cc] == value
                values[rr, cc] = value
                written[rr, cc] = True

    out[written] = values[written]
    return out

