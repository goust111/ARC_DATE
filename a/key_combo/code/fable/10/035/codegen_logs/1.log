+    top = random.randint(1, max(1, h - (2 * motif_h + gap + 2) if arrangement == "vertical" else h - motif_h - 2))
+    left = random.randint(1, max(1, w - (2 * motif_w + gap + 2) if arrangement == "horizontal" else w - motif_w - 2))
