+    require_overlap_skip = random.random() < 0.7
+    if require_overlap_skip:
+        for target in selected_entries:
+            options = [
+                entry
+                for entry in valid
+                if entry["cells"] != target["cells"]
+                and not entry["cells"].isdisjoint(target["cells"])
+                and entry["anchor"] > target["anchor"]
