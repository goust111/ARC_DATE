    if inp is None:
        return None

    if not _gen_oracle_accepts(inp, _gen_expected_output(missing)):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
