+    assert len(cols) >= len(left_offsets)
+    chosen_cols = rng.sample(cols, len(left_offsets))
+    rng.shuffle(chosen_cols)
+    for offset, col in zip(left_offsets, chosen_cols):
+        row = v_r0 + offset
+        grid[row, col] = TEAL
