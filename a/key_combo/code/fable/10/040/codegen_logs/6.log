+    grid[v_r0 : v_r1 + 1, 0] = RED
+    _place_top_markers(grid, rng, h_c0, top_offsets, (v_r0, v_r1))
+    _place_left_markers(grid, rng, v_r0, left_offsets, (h_c0, h_c1))
+    return grid
