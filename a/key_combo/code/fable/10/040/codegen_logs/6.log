  red_bars:
    count: exactly 2, one on col 0 (left edge), one on col W-1 (right edge)
    shape: solid vertical segments, equal height 4-6
    row_ranges: non-overlapping with vertical gap >= 4 between them
    margins: each bar has >= 1 row margin from top and bottom grid edges
  teal_markers:
