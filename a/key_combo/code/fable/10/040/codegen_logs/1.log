0016: def main(grid: np.ndarray) -> np.ndarray:
0017:     """
0018:     Expand a 3x3 pattern by replacing each colored pixel with a tile shaped like the pattern's black pixels.
0019: 
0020:     Input structure:
0021:     - The input is a 3x3 grid with black background cells.
0022:     - All non-black pixels share one foreground color.
0023: 
0024:     Rule:
0025:     - Treat the black-cell mask of the whole input as a 3x3 tile template.
0026:     - For each foreground input pixel, place that tile in the corresponding
0027:       3x3 output block using the foreground color.
0028:     - For each black input pixel, leave the corresponding output block black.
0029: 
0030:     Key insight:
0031:     - The input is both the coarse placement mask and, by complement, the local
0032:       tile stamped at every foreground position.
0033:     """
0034:     g = np.asarray(grid, dtype=int)
0035:     assert g.shape == (3, 3), "expected a 3x3 input grid"
0036: 
0037:     color = _single_foreground_color(g)
0038:     source_mask = g == color
0039:     tile_mask = g == Color.BLACK
0040:     assert np.any(source_mask), "expected foreground pixels"
0041:     assert np.any(tile_mask), "expected black template pixels"
0042: 
0043:     out = np.kron(source_mask.astype(int), tile_mask.astype(int)) * color
0044:     assert out.shape == (9, 9), "expanded output must be 9x9"
0045:     return out.astype(int)
