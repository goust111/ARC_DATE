0080: def _quadrant_cells(n: int, dr: int, dc: int) -> list[tuple[int, int]]:
0081:     rows = range(0, n) if dr < 0 else range(n + 1, 2 * n + 1)
0082:     cols = range(0, n) if dc < 0 else range(n + 1, 2 * n + 1)
0083:     return [(r, c) for r in rows for c in cols]
