0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Keep only the center color and redraw it as a diagonal ray to its indicated corner.
0016: 
0017:     Input structure:
0018:     - The grid is an odd square with a unique dominant background color.
0019:     - The center pixel is foreground.
0020:     - Every off-center pixel with the center color lies in the same diagonal
0021:       quadrant relative to the center.
0022: 
0023:     Rule:
0024:     - Fill the whole output with the background color.
0025:     - Use the quadrant of the center-colored pixels to choose one diagonal
0026:       direction from the center.
0027:     - Draw a continuous line of the center color from the center to the grid
0028:       edge in that direction.
0029: 
0030:     Key insight:
0031:     The color at the exact center identifies the surviving color, while the
0032:     other pixels of that color identify which corner the center should connect to.
0033:     """
0034:     g = np.asarray(grid, dtype=int)
0035:     h, w = g.shape
0036:     assert h == w and h % 2 == 1, "grid must be an odd square"
0037: 
0038:     bg = get_bg(g)
0039:     vals, counts = np.unique(g, return_counts=True)
0040:     assert int(np.sum(counts == counts.max())) == 1, "background must be unique"
0041:     assert int(counts[vals == bg][0]) == int(counts.max()), "background must be dominant"
0042: 
0043:     center = (h // 2, w // 2)
0044:     color = int(g[center])
0045:     assert color != bg, "center pixel must be foreground"
0046: 
0047:     directions: set[tuple[int, int]] = set()
0048:     for r, c in np.argwhere(g == color):
0049:         r = int(r)
0050:         c = int(c)
0051:         if (r, c) == center:
0052:             continue
0053:         dr = _sign(r - center[0])
0054:         dc = _sign(c - center[1])
0055:         assert dr != 0 and dc != 0, "center-colored pixels must be diagonal markers"
0056:         directions.add((dr, dc))
0057: 
0058:     assert len(directions) == 1, "center color must indicate one diagonal direction"
0059:     direction = next(iter(directions))
0060: 
0061:     out = np.full_like(g, bg)
0062:     draw_line(out, center[0], center[1], direction=direction, color=color)
0063:     return out
0064: 
