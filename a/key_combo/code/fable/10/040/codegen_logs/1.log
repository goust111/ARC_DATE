+    answer_by_shape = {_rect_shape(rect): rect for rect in answers}
+    for rect in occluders:
+        r0, c0, r1, c1 = rect
+        ar0, ac0, ar1, ac1 = answer_by_shape[_rect_shape(rect)]
+        out[ar0 : ar1 + 1, ac0 : ac1 + 1] = out[r0 : r1 + 1, c0 : c1 + 1]
+
