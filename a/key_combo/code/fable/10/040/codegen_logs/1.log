0086: def _choose_fill_counts(rng: np.random.Generator, n: int) -> list[int]:
0087:     q_area = n * n
0088:     min_k = math.ceil(QUADRANT_FILL_MIN * q_area)
0089:     max_k = math.floor(QUADRANT_FILL_MAX * q_area)
0090:     side = 2 * n + 1
0091:     cells = side * side
0092:     bg_min = math.ceil(BACKGROUND_FILL_MIN * cells)
0093:     bg_max = math.floor(BACKGROUND_FILL_MAX * cells)
0094:     quadrant_count = len(QUADRANT_DIRECTIONS)
0095:     total_min = max(quadrant_count * min_k, cells - CENTER_PIXEL_COUNT - bg_max)
0096:     total_max = min(quadrant_count * max_k, cells - CENTER_PIXEL_COUNT - bg_min)
0097:     target = int(rng.integers(total_min, total_max + 1))
0098: 
0099:     counts: list[int] = []
0100:     remaining = target
0101:     for slots in range(quadrant_count, 0, -1):
0102:         lo = max(min_k, remaining - (slots - 1) * max_k)
0103:         hi = min(max_k, remaining - (slots - 1) * min_k)
0104:         k = int(rng.integers(lo, hi + 1))
0105:         counts.append(k)
0106:         remaining -= k
0107:     rng.shuffle(counts)
0108:     return counts
0109: 
