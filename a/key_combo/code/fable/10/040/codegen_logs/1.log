                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(np.array(coords,dtype=int))
    return out

def solid_rectangles_of_color(grid, color):
    rects=[]
    for coords in connected_components(grid==color):
        r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
        h=r1-r0+1; w=c1-c0+1
        if len(coords)==h*w: rects.append((int(r0),int(c0),int(r1),int(c1)))
    rects.sort(); return rects

def mirror_col(axis, c):
    mc = 2*axis - c
    if abs(mc-round(mc))>1e-9: raise ValueError
    return int(round(mc))

def bbox_from_mask(mask):
    coords=np.argwhere(mask)
    if coords.size==0: return None
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def infer_axis(grid, occs):
