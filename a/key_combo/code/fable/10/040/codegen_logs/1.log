  "type": "move_along_path",
  "src": "the foreground center pixel and the other pixels with the same color",
  "path": "diagonal ray from the center through the quadrant containing the same-color pixels",
  "trajectory": "paint every pixel on the ray with the center color",
  "transform": "clear all other foreground pixels to the dominant background color"
}
</annotation>
