    mask=subject.copy()
    for r0,c0,r1,c1 in occs: mask[r0:r1+1,c0:c1+1]=True
    bb=bbox_from_mask(mask); r0,c0,r1,c1=bb; axis=(c0+c1)/2
    for r,c in np.argwhere(subject):
        mc=mirror_col(axis,int(c)); p=int(grid[int(r),mc])
        if p not in (BLACK,TEAL) and p!=grid[int(r),int(c)]: raise AssertionError
