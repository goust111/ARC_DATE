0112:     """Return directions with the center-color quadrant first and distractors shuffled."""
0113:     directions = list(QUADRANT_DIRECTIONS)
0114:     rng.shuffle(directions)
0115:     directions.remove(answer_direction)
0116:     directions.insert(0, answer_direction)
0117:     return directions
