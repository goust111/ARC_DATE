0001: from __future__ import annotations
0002: 
0003: import numpy as np
0004: 
0005: from arc_utils import find_components, get_bg, paste, random_free_location, random_sprite
0006: import random
0007: 
0008: 
0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Erase the two leftmost columns of every foreground object, leaving the rest of each object in place.
0012: 
0013:     Input structure:
0014:     - A grid has one dominant background color and several monochromatic 4-connected foreground objects.
0015:     - Each foreground object spans at least two columns in its bounding box.
0016: 
0017:     Rule:
0018:     - Find each same-color 4-connected foreground object.
0019:     - Within each object's own bounding box, set foreground pixels in the two leftmost columns to the background color.
0020:     - Leave all other pixels unchanged.
0021: 
0022:     Key insight:
0023:     - The deletion is measured from each object's local left edge, not from the grid edge or from a shared global column.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     bg = get_bg(g)
0027:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0028:     assert components, "expected at least one foreground object"
0029: 
0030:     out = g.copy()
0031:     for component in components:
0032:         coords = component["coords"]
0033:         _r0, c0, _r1, c1 = map(int, component["bbox"])
0034:         assert c1 - c0 + 1 >= 2, "each object must span at least two columns"
0035: 
0036:         erase = coords[coords[:, 1] < c0 + 2]
0037:         out[erase[:, 0], erase[:, 1]] = bg
0038: 
0039:     return out
0040: 
0041: # --------------- generator (att1, Claude) ---------------
0042: # Canvas constraints.
0043: BG = 8
0044: GRID_SIZE_RANGE = (8, 11)
0045: MIN_BACKGROUND_FRACTION = 0.50
0046: # Object sampling constraints.
0047: OBJECT_COUNT = 4
0048: FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]
0049: SPRITE_WIDTH_RANGE = (2, 6)
0050: SPRITE_HEIGHT_RANGE = (2, 5)
0051: SPRITE_PIXEL_RANGE = (4, 14)
0052: SPRITE_RETRIES = 30
0053: SPRITE_CONNECTIVITY = 4
0054: SPRITE_SYMMETRY = "not_symmetric"
0055: # Placement and global retry policy.
0056: PLACEMENT_PADDING = 1
0057: PLACEMENT_CONNECTIVITY = 8
0058: GENERATION_RETRIES = 300
0059: 
0060: def _sample_sprite(color: int) -> np.ndarray | None:
0061:     """Return one connected sprite that lands inside the configured pixel-count range."""
0062:     bw = random.randint(*SPRITE_WIDTH_RANGE)
0063:     bh = random.randint(*SPRITE_HEIGHT_RANGE)
0064:     max_px = bw * bh
0065:     min_px = max(SPRITE_PIXEL_RANGE[0], bw + bh - 1)
0066:     max_target_px = min(SPRITE_PIXEL_RANGE[1], max_px)
0067:     if min_px > max_target_px:
0068:         return None
0069:     target_px = random.randint(min_px, max_target_px)
0070:     density = target_px / max_px
0071:     for _ in range(SPRITE_RETRIES):
0072:         try:
0073:             sprite = random_sprite(bh, bw, density=density, color_palette=[color],
0074:                                    connectivity=SPRITE_CONNECTIVITY, background=BG,
0075:                                    symmetry=SPRITE_SYMMETRY)
0076:         except Exception:
0077:             continue
0078:         px = int(np.sum(sprite != BG))
0079:         if SPRITE_PIXEL_RANGE[0] <= px <= SPRITE_PIXEL_RANGE[1]:
0080:             return sprite
0081:     return None
0082: 
0083: def _place_sprite(grid: np.ndarray, sprite: np.ndarray) -> bool:
0084:     """Paste sprite with the required Chebyshev gap; return False if no slot exists."""
0085:     try:
0086:         r, c = random_free_location(grid, sprite, transparent=BG,
0087:                                     padding=PLACEMENT_PADDING,
0088:                                     padding_connectivity=PLACEMENT_CONNECTIVITY)
0089:     except ValueError:
0090:         return False
0091:     paste(grid, sprite, r, c, transparent=BG)
0092:     return True
0093: 
0094: def _solver_accepts(grid: np.ndarray) -> bool:
0095:     """Return whether the solver accepts the sampled task instance."""
0096:     try:
0097:         out = main(grid)
0098:     except Exception:
0099:         return False
0100:     return out is not None
0101: 
0102: def _gen_attempt() -> np.ndarray | None:
0103:     H = random.randint(*GRID_SIZE_RANGE)
0104:     W = random.randint(*GRID_SIZE_RANGE)
0105:     grid = np.full((H, W), BG, dtype=int)
0106:     for color in random.sample(FOREGROUND_COLORS, OBJECT_COUNT):
0107:         sprite = _sample_sprite(color)
0108:         if sprite is None or not _place_sprite(grid, sprite):
0109:             return None
0110:     if np.sum(grid == BG) / grid.size < MIN_BACKGROUND_FRACTION:
0111:         return None
0112:     return grid if _solver_accepts(grid) else None
0113: 
0114: def generate_input() -> np.ndarray:
0115:     for _ in range(GENERATION_RETRIES):
0116:         result = _gen_attempt()
