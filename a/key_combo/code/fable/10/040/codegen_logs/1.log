0072: QUADRANT_FILL_MIN, QUADRANT_FILL_MAX = 0.33, 0.56
0073: BACKGROUND_FILL_MIN, BACKGROUND_FILL_MAX = 0.63, 0.69
0074: CENTER_PIXEL_COUNT = 1
0075: # Generation retry limit.
