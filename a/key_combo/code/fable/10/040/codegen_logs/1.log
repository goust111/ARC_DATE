from __future__ import annotations
import random
from collections import Counter, deque
import numpy as np

BLACK = 0
GREY = 5
TEAL = 8
SUBJECT_COLORS = [1,2,3,4,6,7,9]
DIR4 = [(-1,0),(1,0),(0,-1),(0,1)]

def connected_components(mask):
    h,w = mask.shape; seen=np.zeros((h,w),dtype=bool); out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=True; coords=[]
            while q:
