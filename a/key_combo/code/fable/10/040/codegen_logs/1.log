1100: def orbit(grid: np.ndarray, r: int, c: int, symmetries: Sequence[Symmetry]) -> list[tuple[int, int]]:
1101:     """Compute the orbit of (r,c) under the provided symmetries."""
1102:     all_possible: list[tuple[int, int]] = []
1103:     possible_iterations = itertools.product(*[list(range(*s._iter_range(grid.shape))) for s in symmetries])
1104:     for iters in possible_iterations:
1105:         rr, cc = int(r), int(c)
1106:         for sym, i in zip(symmetries, iters):
1107:             rr, cc = sym.apply(rr, cc, i)
1108:             if not (0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1]):
1109:                 break
1110:         else:
1111:             all_possible.append((int(rr), int(cc)))
1112:     return list(set(all_possible))
