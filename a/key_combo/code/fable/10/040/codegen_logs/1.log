+        inp[ar0 : ar1 + 1, ac0 : ac1 + 1] = GREY
+        out[ar0 : ar1 + 1, ac0 : ac1 + 1] = full_subject[r0 : r1 + 1, c0 : c1 + 1]
+
+    if not _validate_generated_instance(inp, out, full_subject, axis, occluders, answers):
+        return None
+    return inp
+
