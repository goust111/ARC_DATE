from __future__ import annotations
import random
from collections import deque
import numpy as np

BLACK = 0
GREY = 5
TEAL = 8
SUBJECT_COLORS = [1,2,3,4,6,7,9]
DIR4 = [(-1,0),(1,0),(0,-1),(0,1)]


def bbox_from_mask(mask):
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def connected_components(mask):
    h,w = mask.shape
    seen = np.zeros((h,w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q = deque([(r,c)])
            seen[r,c] = True
            coords = []
            while q:
                rr,cc = q.popleft()
                coords.append((rr,cc))
                for dr,dc in DIR4:
                    nr,nc = rr+dr, cc+dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc] = True
                        q.append((nr,nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def solid_rectangles_of_color(grid, color):
    rects = []
    for coords in connected_components(grid == color):
        r0,c0 = coords.min(axis=0)
        r1,c1 = coords.max(axis=0)
        h = int(r1-r0+1); w = int(c1-c0+1)
        if len(coords) == h*w:
            rects.append((int(r0), int(c0), int(r1), int(c1)))
    rects.sort()
    return rects


def mirror_col(axis, c):
    mc = 2 * axis - c
    if abs(mc - round(mc)) > 1e-9:
        raise ValueError
    return int(round(mc))


def infer_subject_bbox(grid, occluders):
    subject_mask = (grid "'!= BLACK) & (grid != GREY) & (grid != TEAL)
    if not subject_mask.any():
        raise AssertionError
    mask = subject_mask.copy()
    for r0,c0,r1,c1 in occluders:
        mask[r0:r1+1, c0:c1+1] = True
