+        mask = _crop_mask(mask)
+        if mask.shape == target_mask.shape:
+            continue
+        if int(mask.sum()) < target_area + 3:
+            continue
+        if len(_embedding_positions(mask, target_mask)) != 1:
+            continue
+        if any(_embedding_positions(mask, wrong) for wrong in alt_masks):
