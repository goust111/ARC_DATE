+
+
+def _frame_top_left(shape: tuple[int, int], quadrant: tuple[int, int], frame_h: int, frame_w: int) -> tuple[int, int]:
+    r_lo, r_hi, c_lo, c_hi = _quadrant_bounds(shape, quadrant)
