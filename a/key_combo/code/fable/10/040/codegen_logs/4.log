+
+def _quadrant_bounds(shape: tuple[int, int], quadrant: tuple[int, int]) -> tuple[int, int, int, int]:
+    H, W = shape
+    cr = H // 2
+    cc = W // 2
+    if quadrant[0] == 0:
+        r_lo, r_hi = 1, cr - 1
+    else:
+        r_lo, r_hi = cr + 1, H - 2
+    if quadrant[1] == 0:
+        c_lo, c_hi = 1, cc - 1
+    else:
+        c_lo, c_hi = cc + 1, W - 2
