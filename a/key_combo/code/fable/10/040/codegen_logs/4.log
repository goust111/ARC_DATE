    except Exception:
        return None
    if np.array_equal(solved, output_grid):
        return input_grid
    return None


def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 63613498 input")

