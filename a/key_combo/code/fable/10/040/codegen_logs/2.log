+    _, row_runs, col_runs = _parse_lattice(grid)
+    similarities = []
+    for rr, (r0, r1) in enumerate(row_runs):
+        for cc, (c0, c1) in enumerate(col_runs):
+            block = grid[r0 : r1 + 1, c0 : c1 + 1]
+            same = int(np.sum(block == summary))
