from __future__ import annotations
import numpy as np, random

def center_of_sym(coords):
    if not coords:
        return None
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    sr=min(rs)+max(rs); sc=min(cs)+max(cs)
    s=set(coords)
    for r,c in coords:
        if (sr-r, sc-c) not in s:
            return None
    return sr,sc

def choose_center(H,W,rng):
    row_modes=[2*r for r in range(2,H-2)] + [2*r+1 for r in range(1,H-3)]
    col_modes=[2*c for c in range(2,W-2)] + [2*c+1 for c in range(1,W-3)]
    rng.shuffle(row_modes); rng.shuffle(col_modes)
    pairs=[(sr,sc) for sr in row_modes for sc in col_modes if (sr,sc)"'!=(H-1,W-1)]
    return pairs[0]

def all_orbits(H,W,sr,sc):
    out=[]
    for r in range(H):
      for c in range(W):
        rr,cc=sr-r, sc-c
        if not (0<=rr<H and 0<=cc<W):
          continue
        p=(r,c); q=(rr,cc)
        if p>=q or max(abs(r-rr), abs(c-cc))<=1:
          continue
        out.append((p,q))
    return out

def neighbors(cell,H,W):
    r,c=cell
    for dr in (-1,0,1):
      for dc in (-1,0,1):
        rr,cc=r+dr,c+dc
        if 0<=rr<H and 0<=cc<W:
          yield rr,cc

def free(orbit, blocked):
    p,q=orbit
    return p not in blocked and q not in blocked

def add_block(blocked, orbit,H,W):
    for cell in orbit:
      for n in neighbors(cell,H,W): blocked.add(n)

def bbox_center(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    return min(rs)+max(rs), min(cs)+max(cs)

def valid_anchor(pairs, sr, sc):
    pts=[p for pair in pairs for p in pair]
    if len(pts)<4 or center_of_sym(pts)!=(sr,sc): return False
    if len({r for r,c in pts})<3 or len({c for r,c in pts})<3: return False
    offsets={(abs(2*r-sr),abs(2*c-sc)) for r,c in pts}
    return len(offsets)>=3

def build(rng):
    H=rng.randint(16,24); W=rng.randint(16,24)
    sr,sc=choose_center(H,W,rng)
    orbits=all_orbits(H,W,sr,sc)
    rng.shuffle(orbits)
    if len(orbits)<18: return None
    blocked=set(); anchor=[]
    target_anchor=rng.randint(2,4)
    for orb in orbits:
      if free(orb,blocked):
        anchor.append(orb); add_block(blocked,orb,H,W)
        if len(anchor)==target_anchor: break
    if not valid_anchor(anchor,sr,sc): return None
    n_colors=rng.randint(3,5)
    remaining=[orb for orb in orbits if free(orb,blocked)]
    rng.shuffle(remaining)
    for _ in range(n_colors-1):
      need=rng.randint(3,5); pts=[]
      for orb in remaining:
        if not free(orb,blocked): continue
        pts.append(orb[0]); add_block(blocked,orb,H,W)
        if len(pts)==need: break
      if len(pts)<3 or center_of_sym(pts) is not None or bbox_center(pts)==(sr,sc): return None
      remaining=[orb for orb in remaining if free(orb,blocked)]
    return True

success=0
for i in range(1000):
  if build(random.Random()) is not None:
    success +=1
print('"'success', success)
