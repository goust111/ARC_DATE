+    colors = [int(c) for c in np.unique(grid) if int(c) != 0]
+    candidates: list[tuple[int, CenterSums]] = []
+    for color in colors:
+        coords = _color_coords(grid, color)
+        if len(coords) < 4:
+            continue
+        center = _central_symmetry_center(coords)
+        if center is None:
+            continue
