+            mate = (sr - r, sc - c)
+            if not _in_bounds(shape, mate):
+                continue
+            cell = (r, c)
+            if cell >= mate:
+                continue
+            if max(abs(cell[0] - mate[0]), abs(cell[1] - mate[1])) <= 1:
+                continue
+            orbits.append((cell, mate))
+    return orbits
