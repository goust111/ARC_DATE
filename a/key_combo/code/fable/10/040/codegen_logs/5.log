from __future__ import annotations
import numpy as np, random


def center_of_sym(coords):
    if not coords:
        return None
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    sr=min(rs)+max(rs); sc=min(cs)+max(cs)
    s=set(coords)
    for r,c in coords:
        if (sr-r, sc-c) not in s:
            return None
    return sr,sc


def choose_center(H,W,rng):
    row_modes=[]
    for r in range(2,H-2):
        row_modes.append(2*r)
    for r in range(1,H-3):
        row_modes.append(2*r+1)
    col_modes=[]
    for c in range(2,W-2):
        col_modes.append(2*c)
    for c in range(1,W-3):
        col_modes.append(2*c+1)
    rng.shuffle(row_modes); rng.shuffle(col_modes)
    for sr in row_modes:
      for sc in col_modes:
        if (sr,sc)"'!=(H-1,W-1):
          return sr,sc
    raise RuntimeError


def all_orbits(H,W,sr,sc):
    out=[]
    for r in range(H):
      for c in range(W):
        rr,cc=sr-r, sc-c
        if not (0<=rr<H and 0<=cc<W):
          continue
        p=(r,c); q=(rr,cc)
        if p>=q:
          continue
        if max(abs(r-rr), abs(c-cc))<=1:
          continue
        out.append((p,q))
    return out


def neighbors(cell,H,W):
    r,c=cell
    for dr in (-1,0,1):
      for dc in (-1,0,1):
        rr,cc=r+dr,c+dc
        if 0<=rr<H and 0<=cc<W:
          yield rr,cc


def free(orbit, blocked):
    p,q=orbit
    return p not in blocked and q not in blocked


def add_block(blocked, orbit,H,W):
    p,q=orbit
    for cell in (p,q):
      for n in neighbors(cell,H,W):
        blocked.add(n)


def bbox_center(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    return min(rs)+max(rs), min(cs)+max(cs)


def valid_anchor(pairs, sr, sc):
    pts=[p for pair in pairs for p in pair]
    if len(pts)<4: return False
    if center_of_sym(pts)!=(sr,sc): return False
    if len({r for r,c in pts})<3 or len({c for r,c in pts})<3: return False
    offsets={(abs(2*r-sr),abs(2*c-sc)) for r,c in pts}
    return len(offsets)>=3


def build(rng):
    H=rng.randint(16,24); W=rng.randint(16,24)
    sr,sc=choose_center(H,W,rng)
    orbits=all_orbits(H,W,sr,sc)
    if len(orbits)<18:
      return None
    rng.shuffle(orbits)
    blocked=set()
    anchor=[]
    target_anchor=rng.randint(2,4)
    for orb in orbits:
      if not free(orb,blocked):
        continue
      anchor.append(orb)
      add_block(blocked,orb,H,W)
      if len(anchor)==target_anchor:
        break
    if len(anchor)<2 or not valid_anchor(anchor,sr,sc):
      return None
    colors=random.sample(list(range(1,10)), rng.randint(3,5))
    grid=np.zeros((H,W),dtype=int)
    records={colors[0]: [p for pair in anchor for p in pair]}
    for p in records[colors[0]]:
      grid[p]=colors[0]
    remaining=[orb for orb in orbits if free(orb,blocked)]
    rng.shuffle(remaining)
    for color in colors[1:]:
      need=rng.randint(3,5)
      pts=[]; picked=[]
      for orb in remaining:
        if not free(orb,blocked):
          continue
        p,q=orb
        pts.append(p)
        picked.append(orb)
        add_block(blocked,orb,H,W)
        if len(pts)==need:
          break
      if len(pts)<3 or center_of_sym(pts) is not None or bbox_center(pts)==(sr,sc):
        return None
      records[color]=pts
      for p in pts:
        grid[p]=color
      remaining=[orb for orb in remaining if free(orb,blocked)]
    return grid, records, (sr,sc)


def anchor_find(grid):
    cand=[]
    for color in sorted(set(grid.flat)-{0}):
      pts=[tuple(map(int,p)) for p in np.argwhere(grid==color)]
      ctr=center_of_sym(pts)
      if len(pts)>=4 and ctr is not None and all((2*r,2*c)!=ctr for r,c in pts):
        cand.append((color,ctr))
    return cand

for i in range(200):
    rng=random.Random()
    res=build(rng)
    if res is None:
        continue
    grid, records, ctr = res
    cand=anchor_find(grid)
    if len(cand)!=1:
      print('"'bad anchor', i, ctr, cand); break
    ok=True
    for color, pts in records.items():
      if color==cand[0][0]:
        if center_of_sym(pts)"'!=ctr:
          ok=False
