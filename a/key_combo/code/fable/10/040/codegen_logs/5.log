+    col_choices = [2 * c for c in range(2, w - 2)] + [2 * c + 1 for c in range(1, w - 3)]
+    row_choices = [int(x) for x in row_choices]
+    col_choices = [int(x) for x in col_choices]
+    rng.shuffle(row_choices)
+    rng.shuffle(col_choices)
