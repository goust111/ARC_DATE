+    if not _validate_generated_case(grid, anchor_color, center_sums):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
