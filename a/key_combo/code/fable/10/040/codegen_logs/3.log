hedges={(1,0),(1,2)}

def render(mask):
    out=np.zeros((9,9),dtype=int)
    tile=mask.astype(int)
    for r,c in np.argwhere(mask):
        block=tile
        if r"'!=1: block=np.flipud(block)
        if c!=1: block=np.fliplr(block)
        out[r*3:(r+1)*3,c*3:(c+1)*3]=block
    return out

def cats(mask):
    pts={tuple(x) for x in np.argwhere(mask)}
    return {
        '"'center': (1,1) in pts,
        'v_edge': bool(pts & vedges),
        'h_edge': bool(pts & hedges),
        'corner': bool(pts & corners),
    }

def valid(mask):
