+    for slot_r, slot_c in np.argwhere(mask):
+        block = _slot_transform(tile, int(slot_r), int(slot_c))
+        r0 = int(slot_r) * SLOT_SIZE
+        c0 = int(slot_c) * SLOT_SIZE
