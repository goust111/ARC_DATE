+    if not _is_puzzle_valid_mask(mask):
+        return False
+    fg = int(mask.sum())
+    if fg < 4 or fg > 6:
+        return False
+    return not (
+        np.array_equal(mask, np.fliplr(mask))
+        or np.array_equal(mask, np.flipud(mask))
+        or np.array_equal(mask, np.flipud(np.fliplr(mask)))
+    )
