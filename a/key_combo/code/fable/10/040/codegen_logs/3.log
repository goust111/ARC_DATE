  "type": "symmetry/pattern",
  "src": "entire 3x3 input grid used as the source tile",
  "dst": "3x3 array of 3x3 tile slots in the output",
  "transform": "place src in the center; use vertical reflections above/below, horizontal reflections left/right, and 180-degree reflections in the corners",
  "grid_shape": "input height and width multiplied by 3"
}
</annotation>
<generation_spec>
```yaml
spec:
  task_type: symmetry/pattern
  input:
    grid: exactly 3x3
    colors: 3-4 distinct non-black colors (values 1-9)
    no_background: no black (0) cells [observed]
  output:
    grid: exactly 9x9 (3x3 mosaic of tiles)
    layout: |
      The 9x9 output is a 3x3 arrangement of reflected copies of the input tile T:
        [T[::-1,::-1]  T[::-1,:]  T[::-1,::-1]]
        [T[:,::-1]     T          T[:,::-1]    ]
        [T[::-1,::-1]  T[::-1,:]  T[::-1,::-1]]
      Center = original. Vertical neighbors = row-reversed.
      Horizontal neighbors = col-reversed. Corners = both reversed.
      This creates seamless mirror-reflection wallpaper.

generation_strategy:
  approach: direct (input is trivially small)
  steps:
    - Create a 3x3 grid
    - Choose 3-4 distinct non-black colors from 1-9
    - Fill all 9 cells randomly from the chosen palette
    - No further constraints needed; any 3x3 non-black grid is valid
```
</generation_spec>
