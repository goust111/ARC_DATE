+
+    if len(chosen_a) + len(chosen_b) < 2:
+        raise ValueError("need at least two masked cells")
+
+    for idx in chosen_a:
+        r, c = orbits[idx]["a"]
+        local_input[r, c] = MASK_COLOR
+    for idx in chosen_b:
+        r, c = orbits[idx]["b"]
+        local_input[r, c] = MASK_COLOR
