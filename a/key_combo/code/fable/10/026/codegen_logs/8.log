+    decoyable = {"a": [], "b": []}
+    for idx, orbit in enumerate(orbits):
+        for side in ("a", "b"):
+            cell = orbit[side]
+            selectable[side].append(idx)
+            if decoy_fails(cell, orbit["color"]):
+                decoyable[side].append(idx)
+
+    if mode == "both":
+        na = int(rng.integers(1, target))
+        nb = target - na
+    elif mode == "a_only":
+        na, nb = target, 0
+    else:
