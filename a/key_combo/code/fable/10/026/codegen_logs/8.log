+        mr, mc = _mirror_partner(r, c, axis, separator)
+        if not (r0 <= mr <= r1 and c0 <= mc <= c1):
+            decoy_failure = True
+        elif int(inp[mr, mc]) != int(out[r, c]):
+            decoy_failure = True
