+def _pick_masks(
+    rng: np.random.Generator,
+    local_output: np.ndarray,
+    axis: str,
+    orbits: list[dict],
+) -> np.ndarray:
+    local_input = local_output.copy()
+    h, w = local_output.shape
+    separator = h // 2 if axis == "row" else w // 2
