+    try:
+        in_box = bbox(inp != BACKGROUND_COLOR)
+        out_box = bbox(out != BACKGROUND_COLOR)
+        assert in_box == out_box, "input/output bbox must stay aligned"
+        _validate_instance(inp, out)
+    except AssertionError:
