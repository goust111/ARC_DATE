+
+    dr, dc = decoy
+    if actual_slots[dr, dc] != stamp[dr, dc]:
+        return False
+    if stamp[dr, dc] == 0 or actual_slots[dr, dc] == target[dr, dc]:
+        return False
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    stamp_rows, stamp_cols = random.choice(
+        ((2, 3), (3, 2), (2, 4), (4, 2), (3, 3), (3, 4), (4, 3))
