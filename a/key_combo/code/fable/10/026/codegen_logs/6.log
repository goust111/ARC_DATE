+def _build_canvas(slot_colors: np.ndarray, slot_h: int, slot_w: int, bg: int) -> np.ndarray:
+    rows, cols = slot_colors.shape
+    canvas = np.full((rows * slot_h, cols * slot_w), bg, dtype=int)
+    mid = slot_h // 2
+    for r in range(rows):
+        for c in range(cols):
+            color = int(slot_colors[r, c])
+            if color == bg:
+                continue
