+        "axis": axis,
+        "sep": sep,
+        "stamp": stamp,
+        "slot_colors": slot_colors,
+        "slot_h": slot_h,
+        "slot_w": slot_w,
+        "canvas_r0": canvas_r0,
+        "canvas_c0": canvas_c0,
+        "canvas_h": canvas_h,
