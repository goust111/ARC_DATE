+        strip_bbox = _bbox(strip != bg)
+        assert strip_bbox is not None
+        r0, c0, r1, c1 = strip_bbox
+        assert r0 == 0 and r1 == strip.shape[0] - 1
+        assert c0 == 0 or c1 == strip.shape[1] - 1
