+    grey_cols = np.flatnonzero(np.all(grid == GREY, axis=0))
+    if len(grey_rows) == 1 and len(grey_cols) == 0:
+        assert int(np.count_nonzero(grid == GREY)) == grid.shape[1]
+        return "h", int(grey_rows[0])
+    if len(grey_cols) == 1 and len(grey_rows) == 0:
