+        bottom = g[sep + 1 :, :]
+        assert top.size > 0 and bottom.size > 0
+        strip_is_top = top.shape[0] < bottom.shape[0]
+        strip = top if strip_is_top else bottom
+        canvas = bottom if strip_is_top else top
