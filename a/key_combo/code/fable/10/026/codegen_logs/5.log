_GEN_N = 24
_GEN_MASK_COLOR = 2
_GEN_COLORS = np.array([1, 3, 4, 5, 6, 7, 8, 9], dtype=int)
_GEN_PALETTE_SIZE_MIN = 7
_GEN_PALETTE_SIZE_MAX = 8

