+    if len({np.sign(s) for s in src_signs}) != 1 or len({np.sign(s) for s in dst_signs}) != 1:
+        return False
+    if next(iter({np.sign(s) for s in src_signs})) == next(iter({np.sign(s) for s in dst_signs})):
