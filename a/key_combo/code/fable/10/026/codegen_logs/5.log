+    if kind == "row":
+        return 2 * r - param
+    if kind == "col":
+        return 2 * c - param
+    if kind == "main":
+        return c - r - param
+    return r + c - param
+
+
+def _reflect_point(axis: tuple[str, int], r: int, c: int) -> tuple[int, int]:
+    kind, param = axis
+    if kind == "row":
