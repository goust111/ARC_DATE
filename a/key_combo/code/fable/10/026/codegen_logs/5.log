+    set_b = _coords_set(b)
+    axes: list[tuple[str, int]] = []
+    for kind in AXIS_KINDS:
+        params = set()
+        for ra, ca in a:
+            ra = int(ra)
+            ca = int(ca)
+            for rb, cb in b:
+                rb = int(rb)
+                cb = int(cb)
+                if kind == "row":
