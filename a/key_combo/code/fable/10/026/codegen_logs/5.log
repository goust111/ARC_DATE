  "dst": "same canvas with the least-populated non-axis color mask completed across the axis",
  "transform": "mirror every pixel of the unique least-populated non-axis color across the row, column, main-diagonal, or anti-diagonal axis; leave all original pixels unchanged"
}
</annotation>
<generation_spec>
