+    set_b = _coords_set(b)
+    axes: list[tuple[str, int]] = []
+    for kind in AXIS_KINDS:
+        params = set()
+        for ra, ca in a:
+            ra = int(ra)
+            ca = int(ca)
+            for rb, cb in b:
+                rb = int(rb)
+                cb = int(cb)
+                if kind == "row":
+                    params.add(ra + rb)
+                elif kind == "col":
+                    params.add(ca + cb)
+                elif kind == "main":
+                    params.add(ca - rb)
+                else:
+                    params.add(ra + cb)
+        for param in params:
+            axis = (kind, int(param))
+            reflected = {_reflect_point(axis, int(r), int(c)) for r, c in a}
+            if reflected == set_b:
