+
+
+def _base_grid(tile_rows: int, tile_cols: int, tile_size: int, separator: int, bg: int) -> np.ndarray:
+    h = tile_rows * tile_size + (tile_rows - 1) * SEPARATOR_WIDTH
+    w = tile_cols * tile_size + (tile_cols - 1) * SEPARATOR_WIDTH
