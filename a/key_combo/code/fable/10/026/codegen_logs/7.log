+
+
+def _spans_from_size(tile_count: int, tile_size: int) -> list[tuple[int, int]]:
+    return [
+        (idx * (tile_size + SEPARATOR_WIDTH), idx * (tile_size + SEPARATOR_WIDTH) + tile_size - 1)
+        for idx in range(tile_count)
