+    tile_cols: int,
+    tile_size: int,
+    separator: int,
+    bg: int,
+    barrier_r: int,
+    barrier_color: int,
+    stop_specs: dict[int, list[tuple[int, np.ndarray]]],
+    pass_specs: dict[int, tuple[int, np.ndarray]],
