+def _validate_generated_input(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        scene = _extract_scene(inp)
+        actual = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
