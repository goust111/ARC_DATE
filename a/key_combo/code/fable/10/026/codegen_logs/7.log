+    bg: int,
+    sprite: int,
+    barrier_r: int,
+) -> tuple[dict[int, list[tuple[int, np.ndarray]]], dict[int, tuple[int, np.ndarray]]]:
+    cols = list(range(tile_cols))
+    random.shuffle(cols)
+
+    stack_col = cols.pop()
+    stack_count = random.randint(2, min(3, barrier_r - 1))
+    stop_specs: dict[int, list[tuple[int, np.ndarray]]] = {
