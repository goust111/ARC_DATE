+        _paint_tile(inp, row_spans, col_spans, src_row, tc, patch)
+        _paint_tile(out, row_spans, col_spans, barrier_r, tc, np.full((tile_size, tile_size), bg, dtype=int))
+        _paint_tile(out, row_spans, col_spans, tile_rows - 1, tc, patch)
