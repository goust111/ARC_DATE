+def _side_name(cell: tuple[int, int], shape: tuple[int, int]) -> str:
+    r, c = cell
+    h, w = shape
+    if r == 0 and 0 < c < w - 1:
+        return "top"
+    if r == h - 1 and 0 < c < w - 1:
+        return "bottom"
+    if c == 0 and 0 < r < h - 1:
+        return "left"
+    if c == w - 1 and 0 < r < h - 1:
+        return "right"
+    raise ValueError("tooth must lie on a non-corner boundary cell")
