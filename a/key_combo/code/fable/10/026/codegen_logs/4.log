+
+def _paste_transparent(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    ph, pw = patch.shape
+    sub = grid[top : top + ph, left : left + pw]
+    mask = patch != BG
+    sub[mask] = patch[mask]
