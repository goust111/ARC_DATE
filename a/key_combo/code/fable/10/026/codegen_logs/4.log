+    if not mask[0, :].any() or not mask[-1, :].any() or not mask[:, 0].any() or not mask[:, -1].any():
+        return None
+
+    tooth_color, body_a, body_b = random.sample(colors, 3)
+    patch = np.zeros((h, w), dtype=int)
