+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 800
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            comps.append({"coords": coords, "bbox": _bbox_from_coords(coords), "area": int(coords.shape[0])})
+    return comps
+
+
+def _frame_info(grid: np.ndarray, component: dict[str, object], bg: int) -> dict[str, object] | None:
+    coords = component["coords"]
+    assert isinstance(coords, np.ndarray)
+    r0, c0, r1, c1 = component["bbox"]
+    colors = {int(grid[r, c]) for r, c in coords}
+    if len(colors) != 1:
+        return None
+
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros_like(mask)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    if np.any(mask & ~border):
+        return None
+    missing = np.argwhere(border & ~mask)
+    if missing.shape[0] != 1:
+        return None
+    if int(mask.sum()) != int(border.sum()) - 1:
+        return None
+
+    mr, mc = map(int, missing[0])
+    if (mr in (0, h - 1)) and (mc in (0, w - 1)):
+        return None
+
+    inner_h = h - 2
+    inner_w = w - 2
+    if inner_h < 1 or inner_w < 1:
+        return None
+
+    if mr == 0:
+        adj_local = (1, mc)
+    elif mr == h - 1:
+        adj_local = (h - 2, mc)
+    elif mc == 0:
+        adj_local = (mr, 1)
+    else:
+        adj_local = (mr, w - 2)
+
+    return {
+        "color": next(iter(colors)),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
