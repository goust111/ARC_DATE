+    distractor_shapes = []
+    shape_pool = [(h, w) for h in range(2, 7) for w in range(2, 7) if (h, w) not in {even_shape, odd_shape}]
+    random.shuffle(shape_pool)
+    for inner_shape in shape_pool:
