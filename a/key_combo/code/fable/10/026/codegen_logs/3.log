+    w = option["bbox"][3] - option["bbox"][1] + 1
+    step = (option["direction"][0] * (h + 1), option["direction"][1] * (w + 1))
+    rel_coords = coords - np.array([[option["bbox"][0], option["bbox"][1]]])
