+    center_c = (c0 + c1) / 2.0
+    direction = (_sign(ir - center_r), _sign(ic - center_c))
+    assert direction != (0, 0), "indicator must determine a direction"
+    return coords, (r0, c0, r1, c1), (ir, ic), probe, direction
