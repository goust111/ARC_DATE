+def _template_options(mask: np.ndarray) -> list[dict]:
+    coords = np.argwhere(mask).astype(int)
+    r0, c0, r1, c1 = _bbox(coords)
+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
