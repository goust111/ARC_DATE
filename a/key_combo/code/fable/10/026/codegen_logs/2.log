+                occupied[rr0:rr1, cc0:cc1] = True
+                occupied_kind[rr0:rr1, cc0:cc1] = 2
+                events.append(
+                    {
+                        "rect_id": rect["id"],
+                        "rect_color": rect["color"],
+                        "area": rect["area"],
+                        "dir": direction,
+                        "step": step,
+                        "status": "success",
+                        "partial": partial,
