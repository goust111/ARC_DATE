+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is None:
+            continue
+        if _validate_candidate(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid input for the diagonal train puzzle")

