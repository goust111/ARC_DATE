+def _assign_lengths(
+    shape: tuple[int, int],
+    anchor_box: tuple[int, int, int, int],
+    objects: list[dict[str, int | str | tuple[int, int, int, int]]],
+    preferred_pair_order: list[int],
+) -> bool:
