+        )
+        canonical = [0, 1] + list(range(2, len(objects)))
+        pair_swap = [1, 0] + list(range(2, len(objects)))
+        swapped = _simulate_specs(
+            grid.shape,
+            anchor_box,
+            anchor_color,
+            objects,
+            pair_swap,
+            require_positive_move=False,
+        )[0]
