+
+    if np.array_equal(output, grid):
+        return False
+
+    if np.array_equal(
+        _simulate_specs(grid.shape, anchor_box, anchor_color, objects, canonical, require_positive_move=False)[0],
+        swapped,
+    ):
+        return False
+
+    if np.array_equal(output, heuristic):
+        return False
+
+    return True
+
