+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_ATTEMPTS):
+        sampled = _sample_scene()
+        if sampled is None:
+            continue
+        inp, out = sampled
+        if _validate_generated(inp, out):
