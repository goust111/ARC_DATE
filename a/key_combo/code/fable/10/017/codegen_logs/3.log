+    cols = len(tile_grid[0])
+    tile_size = tile_grid[0][0].shape[0]
+    stride = tile_size + 1
+    canvas = np.full((rows * stride + 1, cols * stride + 1), sep, dtype=int)
+    for tr in range(rows):
