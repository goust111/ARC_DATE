+    hidden_eye = _eye_position(hidden_tile, eye_color)
+    if sum(pos == hidden_eye for pos in eye_positions) != 1:
+        return False
+
+    solved = main(inp)
+    if not np.array_equal(solved, out):
+        return False
+    if np.array_equal(inp, solved):
+        return False
+    return True
