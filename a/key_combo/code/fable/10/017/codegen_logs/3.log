+    row_heights = {r1 - r0 + 1 for r0, r1 in row_runs}
+    col_widths = {c1 - c0 + 1 for c0, c1 in col_runs}
+    assert len(row_heights) == 1 and len(col_widths) == 1, "all tiles must share one size"
