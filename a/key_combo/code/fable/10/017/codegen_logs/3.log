+def _base_tile_variants(tile: np.ndarray, eye_color: int) -> list[np.ndarray] | None:
+    variants = _dihedral_variants(tile)
+    if len(variants) != 8:
+        return None
+    eyes = [_eye_position(variant, eye_color) for variant in variants]
+    if len(set(eyes)) != 8:
+        return None
+    return variants
