+    tile_grid_in: list[list[np.ndarray]] = []
+    for tr in range(tile_rows):
+        out_row = []
+        in_row = []
+        for tc in range(tile_cols):
+            tile = variants[orient_map[(tr, tc)]].copy()
+            out_row.append(tile)
