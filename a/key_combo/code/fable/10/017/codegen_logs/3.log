+                er, ec = _eye_position(tile, eye)
+                occluded[er, ec] = eye
+                in_row.append(occluded)
+            else:
+                in_row.append(tile.copy())
+        tile_grid_out.append(out_row)
+        tile_grid_in.append(in_row)
