+    tile_size = random.randint(*_GEN_TILE_SIZE)
+    if max(tile_rows * (tile_size + 1) + 1, tile_cols * (tile_size + 1) + 1) > 30:
+        return None
+
+    colors = random.sample(range(1, 10), 4)
+    bg, body, eye, occlusion = colors
