+
+def _trace_cells(
+    start: tuple[int, int], direction: str, steps: int
+) -> list[tuple[int, int]]:
+    cells = []
+    r, c = start
+    dr, dc = DIRS[direction]
+    for k in range(1, steps + 1):
+        cells.append((r + dr * k, c + dc * k))
+    return cells
+
