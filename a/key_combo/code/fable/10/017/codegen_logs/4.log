        if horizontal_or_vertical == "horizontal":
            r = np.random.randint(0, m)
            just_the_bars[r, :] = color
        else:
            c = np.random.randint(0, n)
            just_the_bars[:, c] = color

        n_pixels = np.random.randint(1, 5)
        for _ in range(n_pixels):
