+
+
+def _search_plan(
+    shape: tuple[int, int],
+    budgets: list[int],
+    events: list[str],
+    start: tuple[int, int],
+    reserved: set[tuple[int, int]],
+) -> list[dict] | None:
+    def rec(
+        idx: int,
+        pos: tuple[int, int],
+        direction: str,
