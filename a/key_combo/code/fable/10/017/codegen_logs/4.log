+    obstacle_indices = random.sample(indices, 2)
+    events = ["none"] * bar_count
+    for idx in obstacle_indices:
+        events[idx] = "obstacle"
+    remaining = [idx for idx in indices if events[idx] == "none"]
+    if remaining and random.random() < 0.72:
