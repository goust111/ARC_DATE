+def _distance_to_edge(shape: tuple[int, int], pos: tuple[int, int], direction: str) -> int:
+    r, c = pos
+    h, w = shape
+    if direction == "E":
+        return w - 1 - c
+    if direction == "W":
+        return c
+    if direction == "S":
