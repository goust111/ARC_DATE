+    for color in colors:
+        coords = np.argwhere(grid == color)
+        if coords.shape[0] < 2:
+            continue
+        rows = np.unique(coords[:, 0])
+        if rows.size != 1:
+            continue
+        row = int(rows[0])
+        cols = coords[:, 1]
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        if coords.shape[0] != c1 - c0 + 1:
