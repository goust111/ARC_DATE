+
+def _partition_total(rng: np.random.Generator, total: int, parts: int, *, lo: int, hi: int) -> list[int] | None:
+    out: list[int] = []
+
+    def rec(remaining: int, slots: int) -> bool:
+        if slots == 0:
+            return remaining == 0
