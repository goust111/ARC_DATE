    return _gen_random.sample(_gen_random.choice(choices), count)


def _gen_render_regions(rows, cols, rects, region_colors):
    grid = np.zeros((rows, cols), dtype=int)
    for rect, color in zip(rects, region_colors):
        r0, c0, r1, c1 = rect
