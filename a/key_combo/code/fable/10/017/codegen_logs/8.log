GRID_COLS = (13, 19)
REGION_COUNTS = (3, 4)
MIN_REGION_SIDE = 4

# Marker count and placement bounds.
MARKER_COUNTS = (3, 11)
MARKER_BORDER_PAD = 1

# Palette and retry limits.
