NUM_COLORS = 10                # ARC color palette size

T1_MIN_PX, T1_MAX_PX = 8, 12  # tile-1 non-bg pixel range
T2_MIN_PX, T2_MAX_PX = 9, 12  # tile-2 non-bg pixel range
