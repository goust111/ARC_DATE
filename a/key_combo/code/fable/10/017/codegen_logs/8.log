+        spans: list[tuple[int, int]] = []
+        for left, right in zip(wall_cols, wall_cols[1:]):
+            if right - left <= 1:
+                continue
+            cols = range(left + 1, right)
+            if any(int(grid[r, c]) == wall for c in cols):
