+        max_here = min(hi, remaining - (slots - 1) * lo)
+        choices = list(range(min_here, max_here + 1))
+        rng.shuffle(choices)
+        for width in choices:
+            out.append(width)
+            if rec(remaining - width, slots - 1):
+                return True
+            out.pop()
+        return False
+
+    return out if rec(total, parts) else None
+
