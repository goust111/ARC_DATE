+def _level_options(mask: np.ndarray, open_row: int, *, allow_full: bool) -> list[dict[str, int]]:
+    options = []
+    cumulative = 0
+    for r in range(mask.shape[0] - 1, open_row, -1):
+        row_count = int(mask[r].sum())
+        if row_count == 0:
+            continue
+        cumulative += row_count
+        if not allow_full and r == open_row + 1:
