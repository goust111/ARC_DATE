+def _find_open_row_and_spans(grid: np.ndarray, wall: int) -> tuple[int, list[tuple[int, int]]]:
+    h, w = grid.shape
+    for r in range(h - 1):
+        wall_cols = [c for c in range(w) if int(grid[r, c]) == wall]
+        if len(wall_cols) < 2:
+            continue
