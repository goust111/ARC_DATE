+        for tr in range(1, h - ht):
+            for tc in range(1, w - wt):
+                if tr + ht < sr - 1 or sr + hs < tr - 1 or tc + wt < sc - 1 or sc + ws < tc - 1:
+                    shadow_positions.append((tr, tc))
+        if shadow_positions:
+            return (sr, sc), rng.choice(shadow_positions)
+    return None
