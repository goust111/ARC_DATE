+
+def solve_candidates(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    colors = sorted(set(map(int, g.ravel())) - {bg})
+    assert len(colors) == 3, "expected exactly three foreground colors"
