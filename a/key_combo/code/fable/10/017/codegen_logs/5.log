+            observed_bbox = bbox_of_mask(observed_mask)
+            if observed_bbox is None:
+                continue
+            r0, c0, r1, c1 = observed_bbox
+            damage_in_bbox = {
+                cell for cell in damage_coords if r0 <= cell[0] <= r1 and c0 <= cell[1] <= c1
