    bbox_height: 2-7
    bbox_width: 3-6
    pixel_count: 6-22
    density_in_bbox: 0.27-1.00
    shape: arbitrary connected blob; may be hollow frame, solid block, or irregular [observed]
    margins: >=1 on all sides from grid edges
  transform:
    anchor: bottom row of object bbox
    rule: each fg pixel at (r,c) moves to (r, c-(bottom-r)); pixels shifted past left edge are clipped
    clipping: 0-3 pixels may be lost; left_margin < obj_height is allowed
