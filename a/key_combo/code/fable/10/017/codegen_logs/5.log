+def shear_relative_coords(source_coords, sign: int) -> set[tuple[int, int]]:
+    anchor_r, anchor_c = bottom_left_anchor(source_coords)
+    rels = set()
+    for r, c in source_coords:
+        dist = anchor_r - r
+        rels.add((-dist, c - anchor_c + sign * dist))
+    return rels
