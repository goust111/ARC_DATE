+
+def generate_source_coords(rng: random.Random) -> set[tuple[int, int]] | None:
+    for _ in range(200):
+        h = rng.randint(4, 7)
+        w = rng.randint(4, 7)
+        max_area = min(h * w - 1, int(0.72 * h * w) + 1)
+        min_area = max(h + 3, 8)
+        if min_area > max_area:
+            continue
+        target = rng.randint(min_area, max_area)
