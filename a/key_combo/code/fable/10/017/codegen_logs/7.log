    if arm == "bottom":
        return list(range(c0, c1 + 1)), list(range(r1 + 1, h))
    if arm == "left":
        return list(range(r0, r1 + 1)), list(range(0, c0))
    return list(range(r0, r1 + 1)), list(range(c1 + 1, w))


def _gen_arm_positions(arm, count, h, w, r0, c0, r1, c1) -> list[tuple[int, int]]:
