+import random
+from collections import Counter
+
+import numpy as np
+
+
+PALETTE = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+GEN_PERIOD_RANGE = (2, 6)
+GEN_REPEATS_RANGE = (3, 5)
+GEN_LINE_LENGTH_RANGE = (9, 18)
