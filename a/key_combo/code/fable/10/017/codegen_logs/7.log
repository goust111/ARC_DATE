def _gen_quadrant_pools(h, w, r0, c0, r1, c1):
    quadrants = [
        (range(0, r0), range(0, c0)),
        (range(0, r0), range(c1 + 1, w)),
        (range(r1 + 1, h), range(0, c0)),
        (range(r1 + 1, h), range(c1 + 1, w)),
    ]
