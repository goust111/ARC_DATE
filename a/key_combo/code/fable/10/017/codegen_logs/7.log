+    lines = grid if by_rows else grid.T
+    return int(sum(_mode_support(line) for line in lines))
+
+
+def _majority_sequence(grid: np.ndarray, by_rows: bool) -> list[int]:
+    lines = grid if by_rows else grid.T
+    return [_unique_mode(line)[0] for line in lines]
