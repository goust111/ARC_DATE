            markers = [(m, by_pos[(m, fixed)]) for m in moving_values if (m, fixed) in by_pos]
            limit = out.shape[0] - 1
        else:
            markers = [(m, by_pos[(fixed, m)]) for m in moving_values if (fixed, m) in by_pos]
            limit = out.shape[1] - 1
        if reverse:
            end = limit
            for moving, color in sorted(markers, reverse=True):
