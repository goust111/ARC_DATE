        return [(r0, c0), (r0, c0 + 1), (r0 + 1, c0)]
    if corner == "tr":
        return [(r0, c1), (r0, c1 - 1), (r0 + 1, c1)]
    if corner == "bl":
        return [(r1, c0), (r1, c0 + 1), (r1 - 1, c0)]
    return [(r1, c1), (r1, c1 - 1), (r1 - 1, c1)]


