+            dominant_color, dominant_count = counts.most_common(1)[0]
+            if dominant_count != len(indices) - 1:
+                valid = False
+                break
+            if len(indices) - 1 < 2:
+                valid = False
+                break
+
+            mismatches = [idx for idx in indices if seq[idx] != dominant_color]
+            if len(mismatches) != 1:
+                valid = False
+                break
