+GRID_ROWS = (15, 24)
+GRID_COLS = (15, 24)
+FRAME_HEIGHTS = (5, 10)
+FRAME_WIDTHS = (5, 10)
+MIN_MARGIN = 1
+MAX_ATTEMPTS = 400
