+    segments: list[list[tuple[int, int]]] = []
+    for seg_idx in range(num_segments):
+        dr, dc = DIRS[direction]
+        length = seg_idx + 2
+        cells: list[tuple[int, int]] = []
+        for _ in range(length):
+            r += dr
+            c += dc
+            cells.append((r, c))
+        segments.append(cells)
+        direction = turn_dir(direction, chirality)
+    return segments
