+    bg = get_bg(grid)
+    colors = [int(v) for v in np.unique(grid) if int(v) != bg]
+    counts = {color: int(np.sum(grid == color)) for color in colors}
+    center_colors = [color for color in colors if counts[color] == 1]
+    assert len(center_colors) == 1, "expected exactly one unique center color"
+
+    center_color = center_colors[0]
+    center_pos = tuple(map(int, np.argwhere(grid == center_color)[0]))
+    residue_colors = [color for color in colors if color != center_color]
+    assert len(residue_colors) == 2, "expected exactly two residue colors"
+    assert all(counts[color] >= 2 for color in residue_colors), "residue colors must repeat"
+
+    r0, c0 = center_pos
+    adjacent = []
+    for direction, (dr, dc) in enumerate(DIRS):
+        nr, nc = r0 + dr, c0 + dc
+        if in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) != bg:
+            adjacent.append((direction, int(grid[nr, nc])))
