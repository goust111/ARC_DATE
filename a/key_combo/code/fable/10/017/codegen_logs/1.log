        grid.shape,
        0,
        center,
        center_color,
        first_dir,
        chirality,
        h_color,
        v_color,
        num_segments - 1,
    )
    if not validate_generated_instance(
        grid,
        expected_output,
        center,
        segments,
        chosen,
        first_dir,
        chirality,
    ):
        return None
    return grid


