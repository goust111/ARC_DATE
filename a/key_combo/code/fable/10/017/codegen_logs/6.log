    """Sample canvas and sprite dimensions that leave the required margin."""
    H = np.random.randint(GRID_HEIGHT_BOUNDS[0], GRID_HEIGHT_BOUNDS[1] + 1)
    W = np.random.randint(GRID_WIDTH_BOUNDS[0], GRID_WIDTH_BOUNDS[1] + 1)
