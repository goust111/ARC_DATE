+        color_a, color_b = random.sample(palette, 2)
+        objects.append(
+            {
+                "mask": shape["orientations"][idx_a].copy(),
+                "color": int(color_a),
+                "signature": shape["signature"],
+                "area": int(shape["area"]),
+                "is_lone": False,
+            }
+        )
+        objects.append(
+            {
+                "mask": shape["orientations"][idx_b].copy(),
+                "color": int(color_b),
+                "signature": shape["signature"],
+                "area": int(shape["area"]),
+                "is_lone": False,
