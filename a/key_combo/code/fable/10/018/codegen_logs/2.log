+    seen: set[ShapeKey] = set()
+    base = _trim_mask(mask)
+    for k in range(4):
+        rotated = np.rot90(base, k)
+        for candidate in (rotated, np.fliplr(rotated)):
+            key = _mask_key(candidate)
+            if key in seen:
+                continue
