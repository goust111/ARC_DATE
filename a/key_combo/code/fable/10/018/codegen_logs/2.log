+    for idx in order:
+        obj = objects[idx]
+        mask = obj["mask"]
+        oh, ow = mask.shape
+        if qh - oh < 2 or qw - ow < 2:
+            return None
+
+        positions = [(r, c) for r in range(1, qh - oh) for c in range(1, qw - ow)]
+        random.shuffle(positions)
+        placed = False
+        for r0, c0 in positions[:PLACEMENT_RETRIES * 4]:
+            coords = np.argwhere(mask) + np.array([r0, c0], dtype=int)
