1115: class TranslationalSymmetry(Symmetry):
1116:     """Translation symmetry by a fixed vector (dr,dc)."""
1117: 
1118:     def __init__(self, dr: int | None = None, dc: int | None = None, **kwargs):
1119:         # Legacy keyword aliases (deprecated): translate_x->dr, translate_y->dc
1120:         tx, used_tx = _consume_alias(kwargs, "dr", ["translate_x"])
1121:         ty, used_ty = _consume_alias(kwargs, "dc", ["translate_y"])
1122:         if dr is None and tx is not None:
1123:             if used_tx == "translate_x":
1124:                 warnings.warn("TranslationalSymmetry: 'translate_x' is deprecated; use 'dr'", DeprecationWarning, stacklevel=2)
1125:             dr = tx
1126:         if dc is None and ty is not None:
1127:             if used_ty == "translate_y":
1128:                 warnings.warn("TranslationalSymmetry: 'translate_y' is deprecated; use 'dc'", DeprecationWarning, stacklevel=2)
1129:             dc = ty
1130:         if dr is None or dc is None:
1131:             raise TypeError("TranslationalSymmetry: must provide dr,dc")
1132:         if kwargs:
1133:             raise TypeError(f"TranslationalSymmetry: unexpected keyword arguments: {sorted(kwargs.keys())}")
1134:         self.dr, self.dc = int(dr), int(dc)
1135: 
1136:     def apply(self, r, c, iters: int = 1):
1137:         r = r + int(iters) * self.dr
1138:         c = c + int(iters) * self.dc
1139:         if isinstance(r, np.ndarray):
1140:             r = r.astype(int)
1141:         if isinstance(c, np.ndarray):
1142:             c = c.astype(int)
1143:         if isinstance(r, float):
1144:             r = int(round(r))
1145:         if isinstance(c, float):
1146:             c = int(round(c))
1147:         return r, c
