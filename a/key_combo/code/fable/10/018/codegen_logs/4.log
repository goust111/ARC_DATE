+        for cc in range(max(0, c - 1), min(w, c + 2)):
+            cells.append((rr, cc))
+    return tuple(cells)
+
+
+def _stamp_cells(center: Coord, h: int, w: int, yellow_mask: np.ndarray) -> tuple[Coord, ...]:
