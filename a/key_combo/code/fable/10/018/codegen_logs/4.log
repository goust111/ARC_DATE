   127	        if pivot < 0 or not cell_to_candidates[pivot]:
   128	            memo[remaining] = None
   129	            return None
   130	
   131	        options = sorted(
   132	            cell_to_candidates[pivot],
   133	            key=lambda idx: (candidates[idx][2] & remaining).bit_count(),
   134	            reverse=True,
   135	        )
   136	        for idx in options:
   137	            next_remaining = remaining & ~candidates[idx][2]
   138	            suffix = search(next_remaining)
   139	            if suffix is not None:
   140	                memo[remaining] = (idx,) + suffix
   141	                return memo[remaining]
   142	
   143	        memo[remaining] = None
   144	        return None
   145	
   146	    return search(full_mask)
   147	
   148	
   149	def _count_solutions_exact(
   150	    candidate_masks: list[int],
   151	    cell_to_candidate_mask: list[int],
   152	    n_blue: int,
   153	    limit: int = 2,
   154	) -> int:
   155	    undecided_all = (1 << len(candidate_masks)) - 1
   156	    memo: dict[tuple[int, int], int] = {}
   157	
   158	    def rec(remaining: int, undecided: int) -> int:
   159	        if remaining == 0:
   160	            return 1 if undecided == 0 else limit
   161	        key = (remaining, undecided)
   162	        if key in memo:
   163	            return memo[key]
   164	
   165	        pivot_options = 0
   166	        best_count = 10**9
   167	        bitset = remaining
   168	        while bitset:
   169	            lsb = bitset & -bitset
   170	            bit = lsb.bit_length() - 1
   171	            options = undecided & cell_to_candidate_mask[bit]
   172	            count = options.bit_count()
   173	            if count == 0:
   174	                memo[key] = 0
   175	                return 0
   176	            if count < best_count:
   177	                best_count = count
   178	                pivot_options = options
   179	                if count == 1:
   180	                    break
   181	            bitset ^= lsb
   182	
   183	        chosen_lsb = pivot_options & -pivot_options
   184	        cand = chosen_lsb.bit_length() - 1
   185	
   186	        total = rec(remaining & ~candidate_masks[cand], undecided & ~chosen_lsb)
   187	        if total < limit:
   188	            total += rec(remaining, undecided & ~chosen_lsb)
   189	        total = min(total, limit)
   190	        memo[key] = total
   191	        return total
   192	
   193	    return rec((1 << n_blue) - 1, undecided_all)
   194	
   195	
   196	def _blue_components(mask: np.ndarray) -> int:
   197	    h, w = mask.shape
   198	    seen = np.zeros_like(mask, dtype=bool)
   199	    count = 0
   200	    for r in range(h):
   201	        for c in range(w):
   202	            if not bool(mask[r, c]) or bool(seen[r, c]):
   203	                continue
   204	            count += 1
   205	            stack = [(r, c)]
   206	            seen[r, c] = True
   207	            while stack:
   208	                rr, cc = stack.pop()
   209	                for dr in (-1, 0, 1):
   210	                    for dc in (-1, 0, 1):
   211	                        if dr == 0 and dc == 0:
   212	                            continue
   213	                        nr, nc = rr + dr, cc + dc
   214	                        if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
   215	                            seen[nr, nc] = True
   216	                            stack.append((nr, nc))
   217	    return count
   218	
   219	
   220	def main(grid: np.ndarray) -> np.ndarray:
   221	    """
   222	    Reverse a blue stamp trace into the unique set of 3x3 stamp centers and mark those centers red.
   223	
   224	    Input structure:
   225	    - A black background contains scattered yellow pixels and one or more blue regions.
   226	    - The blue cells are exactly the union of several solid 3x3 stamps after clipping at the grid border.
   227	    - Yellow pixels are never painted by a stamp, so they can puncture holes inside the blue trace and may even sit on a stamp center.
   228	
   229	    Rule:
   230	    - Find the unique set of stamp centers whose clipped 3x3 neighborhoods, after skipping every yellow cell, cover all and only the blue cells.
   231	    - Output the original grid with each recovered center recolored red.
   232	
   233	    Key insight:
   234	    - The blue shape is not a region to extend or fill; it is the visible residue of overlapping clipped stamps, so the centers must be recovered by exact causal inversion.
   235	    """
   236	    g = np.asarray(grid, dtype=int)
   237	    assert g.ndim == 2
   238	    assert max(g.shape) <= 30
   239	    assert set(map(int, np.unique(g))) <= {BLACK, BLUE, YELLOW}
   240	
   241	    blue_coords, candidates, cell_to_candidates, _cell_to_candidate_mask = _build_candidate_data(g)
   242	    assert blue_coords, "expected at least one blue cell"
   243	    assert all(cell_to_candidates), "every blue cell must be coverable by some candidate stamp center"
   244	
   245	    solution = _solve_one(candidates, cell_to_candidates, len(blue_coords))
   246	    assert solution is not None, "expected a valid stamp decomposition"
   247	
   248	    out = g.copy()
   249	    for idx in solution:
   250	        r, c = candidates[idx][0]
   251	        out[r, c] = RED
   252	    return out
   253	
   254	
   255	# --------------- generator ---------------
   256	
