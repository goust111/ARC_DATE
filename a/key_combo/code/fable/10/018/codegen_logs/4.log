  "dst": "four separated 2x2 corner slots in a 5x5 output",
  "match_cond": "s is the unique 2x2 mask whose four translated copies cover all foreground pixels without overlap",
  "transform": "stamp s into every output corner slot with the foreground color; leave the middle row and column as bg",
  "grid_shape": "6x6 input -> 5x5 output"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    input: 6x6, output: 5x5
  colors:
    bg: 0, fg: any single non-bg color [observed bg=0 fg=8]
  sprite:
    shape: subset of 2x2 bounding box, 3-4 cells (L-triomino or full square)
    all four 3-cell L-rotations and the full 2x2 are valid; sizes 1-2 excluded (ambiguous decomposition)
  input_layout:
    exactly 4 non-overlapping translated copies of the sprite on the 6x6 grid
    total fg pixels: 12 (3-cell sprite) or 16 (4-cell sprite)
    decomposition must be unique -- no other mask+placement can tile the same fg set
    last row (row 5) always empty [observed]; row 4 may have fg pixels
  output_layout:
    5x5 grid; row 2 and col 2 are all bg (separator cross)
    the sprite is stamped identically into 4 corner 2x2 slots at (0,0), (0,3), (3,0), (3,3)

generation_strategy:
  approach: output-first
  steps:
    1. Pick bg and fg colors (any distinct pair from 0-9)
    2. Choose a 2x2 sprite mask with 3 or 4 cells (uniform random from 5 options)
    3. Build the 5x5 output by stamping the mask into four 2x2 corner regions separated by a bg cross
    4. Place 4 non-overlapping copies of the mask on a 6x6 bg grid at random valid positions
       (each copy's top-left anchor ranges over rows 0-4, cols 0-4; cells must stay in-bounds and not overlap)
    5. Uniqueness is guaranteed for 3- and 4-cell masks (verified exhaustively), so no rejection needed
    6. Return (input_grid, output_grid)
