   153	        objects.append(
   154	            {
   155	                "color": comp["color"],
   156	                "coords": comp["coords"],
   157	                "cells": comp["cells"],
   158	                "area": comp["area"],
   159	                "satellite": sat,
   160	                "direction": direction,
   161	            }
   162	        )
   163	    return bg, objects
   164	
   165	
   166	def _render_output(shape: tuple[int, int], bg: int, objects: list[dict]) -> np.ndarray:
   167	    out = np.full(shape, int(bg), dtype=int)
   168	    for obj in objects:
   169	        path, _turns = _trace_folded_ray(shape, obj["satellite"], obj["direction"], obj["area"])
   170	        for cell in path:
   171	            assert int(out[cell]) == bg, "rays must not overlap"
   172	            out[cell] = int(obj["color"])
   173	    return out
   174	
   175	
   176	def main(grid: np.ndarray) -> np.ndarray:
   177	    """
   178	    Compress each object into an equal-area ray that starts from its red nozzle and folds clockwise along borders.
   179	
   180	    Input structure:
   181	    - The grid has a black background, several separated single-color foreground objects, and one red satellite pixel for each object.
   182	    - Each red satellite pixel lies outside its object and is orthogonally adjacent to exactly one object cell.
   183	    - The satellite's side relative to that neighboring object cell encodes the emission direction.
   184	
   185	    Rule:
   186	    - Remove every object and every red satellite, leaving only the background canvas.
   187	    - For each object, start at the satellite cell and draw a ray in the encoded direction using the object's color.
   188	    - The ray length equals the object's area, counting the satellite cell as the first ray cell; whenever the next step would leave the grid, rotate the direction clockwise by 90 degrees and continue until the full length is drawn.
   189	
   190	    Key insight:
   191	    - The object shape only contributes its pixel count, while the single red satellite fixes both the ray's start and direction; long rays must be counted step by step through each clockwise border fold.
   192	    """
   193	    g = np.asarray(grid, dtype=int)
   194	    bg, objects = _analyze_scene(g)
   195	    return _render_output(g.shape, bg, objects)
   196	
   197	
   198	def _boundary_span(
   199	    shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]
   200	) -> int:
   201	    h, w = map(int, shape)
   202	    r, c = start
   203	    if direction == UP:
   204	        return r + 1
   205	    if direction == DOWN:
   206	        return h - r
   207	    if direction == LEFT:
   208	        return c + 1
   209	    return w - c
   210	
   211	
   212	def _step(cell: tuple[int, int], direction: tuple[int, int], amount: int = 1) -> tuple[int, int]:
