+import numpy as np
+
+
+BG = 0
+SATELLITE = 2
+OBJECT_PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+CW = {UP: RIGHT, RIGHT: DOWN, DOWN: LEFT, LEFT: UP}
+
+MIN_SIDE = 14
+MAX_SIDE = 20
+MIN_OBJECTS = 2
+MAX_OBJECTS = 4
+MIN_AREA = 3
+MAX_AREA = 14
+GEN_RETRIES = 400
+RAY_RETRIES = 300
+OBJECT_RETRIES = 200
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen: set[tuple[int, int]] = set()
+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != color or (r, c) in seen:
+                continue
+            q = deque([(r, c)])
+            seen.add((r, c))
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if (
+                        in_bounds(grid.shape, nr, nc)
+                        and (nr, nc) not in seen
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen.add((nr, nc))
+                        q.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _trace_folded_ray(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    length: int,
+) -> tuple[list[tuple[int, int]], int]:
+    assert length >= 1
+    pos = start
+    d = direction
+    coords: list[tuple[int, int]] = []
+    turns = 0
+    for step in range(length):
+        assert in_bounds(shape, pos[0], pos[1]), "ray left the grid"
+        coords.append(pos)
+        if step == length - 1:
+            break
+        nr = pos[0] + d[0]
+        nc = pos[1] + d[1]
+        while not in_bounds(shape, nr, nc):
+            d = CW[d]
+            turns += 1
+            nr = pos[0] + d[0]
+            nc = pos[1] + d[1]
+        pos = (nr, nc)
+    assert len(set(coords)) == len(coords), "ray must not self-overlap"
+    return coords, turns
+
+
+def _analyze_scene(grid: np.ndarray) -> tuple[int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = get_bg(g)
+    colors = sorted(set(map(int, g.ravel())))
+    object_colors = [color for color in colors if color not in (bg, SATELLITE)]
+    assert object_colors, "expected at least one object color"
+
+    components: list[dict] = []
+    cell_to_component: dict[tuple[int, int], int] = {}
+    for color in object_colors:
+        for coords in _components_of_color(g, color):
+            comp_id = len(components)
+            cell_set = set(coords)
+            components.append(
+                {
+                    "id": comp_id,
+                    "color": int(color),
+                    "coords": coords,
+                    "cells": cell_set,
+                    "area": len(coords),
+                }
+            )
+            for cell in coords:
+                cell_to_component[cell] = comp_id
