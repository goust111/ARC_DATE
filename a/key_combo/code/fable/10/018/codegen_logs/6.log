+
+import numpy as np
+
+
+BG = 0
+SATELLITE = 2
+OBJECT_PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
