+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SATELLITE = 2
+OBJECT_PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS = (UP, RIGHT, DOWN, LEFT)
+CW = {UP: RIGHT, RIGHT: DOWN, DOWN: LEFT, LEFT: UP}
+
+MIN_SIDE = 14
+MAX_SIDE = 20
+MIN_OBJECTS = 2
+MAX_OBJECTS = 4
+MIN_AREA = 3
+MAX_AREA = 14
+GEN_RETRIES = 400
+RAY_RETRIES = 300
+OBJECT_RETRIES = 200
