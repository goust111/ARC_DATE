   232	    side = random.choice(["top", "right", "bottom", "left"])
   233	    if side == "top":
   234	        if w < 3:
   235	            return None
   236	        c_hi = w - 3 if require_corner_room else w - 2
   237	        if c_hi < 1:
   238	            return None
   239	        return (0, random.randint(1, c_hi)), UP
   240	    if side == "right":
