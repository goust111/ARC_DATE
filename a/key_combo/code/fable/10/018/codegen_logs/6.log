+        if target == "straight":
+            lo = MIN_AREA
+            hi = min(MAX_AREA, span1)
+        elif target == "fold":
+            lo = max(MIN_AREA, span1 + 1)
+            hi = min(MAX_AREA, span1 + extra1)
+        else:
+            lo = max(MIN_AREA, span1 + extra1 + 1)
+            hi = min(MAX_AREA, span1 + extra2 + extra1)
