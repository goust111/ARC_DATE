    mask = _find_unique_sprite_mask(g, fg_color)
    out = np.full((5, 5), bg, dtype=int)
    for base_r, base_c in ((0, 0), (0, 3), (3, 0), (3, 3)):
        for dr, dc in mask:
            out[base_r + dr, base_c + dc] = fg_color
    return out

