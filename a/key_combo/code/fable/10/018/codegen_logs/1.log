+    dc = int(initial_dc)
+    path = [(0, c)]
+    bounces: list[str] = []
+    forward_targets: list[tuple[int, int]] = []
+
+    for r in range(1, h):
+        target_c = c + dc
+        forward_targets.append((r, target_c))
+        bounced = False
+        if target_c < 0 or target_c >= w:
+            dc = -dc
+            target_c = c + dc
+            bounces.append("wall")
+            bounced = True
+        elif (r, target_c) in blocked:
