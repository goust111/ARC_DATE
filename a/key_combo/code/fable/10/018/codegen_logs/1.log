  colors_input: black (0) and yellow (4) only
  colors_output: black, yellow, orange (7)
  objects:
    count: 2
    color: yellow
    connectivity: 8-connected (may be only 4-connected or require 8-connectivity)
    bbox: exactly 3x3
    yellow_cells: 4-8 per object
    missing_cells: 1-5 per object (black cells within bbox)
    constraint: each object is a single 8-connected component
  placement:
    bboxes must not overlap or touch (gap >= 1 cell between bboxes)
    bboxes may touch grid edges (dist to edge can be 0) [observed]
