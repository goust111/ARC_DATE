# Grid colors and fixed canvas.
GRID_SIZE, GRID_LAST = 10, 9
BG_COLOR, WALL_COLOR = 0, 5
TARGET_COLOR_OFFSET = 1
NUM_COL_BANDS = 3

# Wall row/column layout choices.
THREE_WALL_ROW_PROB = 0.5
THREE_WALL_ROW_MIDDLES = (4, 5)
FOUR_WALL_ROWS = (0, 3, 6, 9)
WALL_COL_MIN = 1
WALL_COL_MAX = 8
