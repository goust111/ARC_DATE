    wall_structures_below_marker: wall top row >= 2 (gap of >=1 empty rows between marker and walls)
    marker_column: avoid placing the falling marker directly above a U side wall; it may be adjacent to a wall column
  rule:
    - erase marker pixel
    - if marker column falls within (left..right inclusive) of the single closed U, fill its interior with marker color
    - if no closed U catches the marker column, fill entire bottom row with marker color
  outcome_mix: ~67% fill-container, ~33% fill-bottom-row

generation_strategy:
