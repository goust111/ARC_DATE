+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GRAY = 5
+CYAN = 8
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+MAX_GENERATION_ATTEMPTS = 600
+PATH_RETRY_LIMIT = 200
+CONTAINER_RETRY_LIMIT = 150
