+    curr = start
+    total = int(np.count_nonzero(mask))
+    while True:
+        nxts = [coord for coord in _neighbors4(mask, curr[0], curr[1]) if coord != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "path must not branch"
+        prev, curr = curr, nxts[0]
+        order.append(curr)
