  "type": "transform_in_place",
  "src": "4-connected background chambers separated by grey walls and colored marker pixels",
  "transform": "fill each chamber with the unique majority color among distinct orthogonally adjacent marker pixels; preserve the walls and markers"
}
</annotation>
<generation_spec>
