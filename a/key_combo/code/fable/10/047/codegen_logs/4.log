+    cor_r, cor_c = _outer_corner(shape, source_quad)
+    off_r = abs(ref_r - cor_r)
+    off_c = abs(ref_c - cor_c)
+    return _bbox_from_outer_offset(shape, target_quad, off_r, off_c, height, width)
