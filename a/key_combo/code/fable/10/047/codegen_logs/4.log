+def _sample_anchor(h: int, w: int) -> tuple[int, int] | None:
+    choices = []
+    for r in range(4, h - 5):
+        top = r
+        bottom = h - r - 2
+        if min(top, bottom) < 4:
+            continue
+        for c in range(4, w - 5):
+            left = c
+            right = w - c - 2
+            if min(left, right) < 4:
+                continue
+            if top == bottom and left == right:
+                continue
+            if abs(top - bottom) + abs(left - right) < 3:
+                continue
+            choices.append((r, c))
+    if not choices:
+        return None
+    return random.choice(choices)
