0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Use the 2x2 black marker as an eraser that clears its rows and columns except for red pixels.
0011: 
0012:     Input structure:
0013:     - The grid is otherwise filled with colored pixels.
0014:     - There is exactly one 2x2 black marker.
0015:     - Red pixels are protected cells that may lie in the marker's rows or columns.
0016: 
0017:     Rule:
0018:     - Select both rows and both columns occupied by the 2x2 black marker.
0019:     - Recolor every selected non-red pixel to black.
0020:     - Leave all unselected pixels and selected red pixels unchanged.
0021: 
0022:     Key insight:
0023:     - The marker does not expand as a filled rectangle; it defines a two-row and
0024:       two-column cross, with red pixels acting as holes in the erased cross.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     assert g.ndim == 2, "expected a 2D grid"
0028: 
0029:     marker = g == Color.BLACK
0030:     assert int(np.count_nonzero(marker)) == 4, "expected exactly four black marker pixels"
0031:     r0, c0, r1, c1 = bbox_coords(np.argwhere(marker))
0032:     assert int(r1 - r0 + 1) == 2 and int(c1 - c0 + 1) == 2, "black marker must be 2x2"
0033:     assert np.all(marker[r0 : r1 + 1, c0 : c1 + 1]), "black marker must be solid"
0034: 
0035:     erase = np.zeros(g.shape, dtype=bool)
0036:     erase[r0 : r1 + 1, :] = True
0037:     erase[:, c0 : c1 + 1] = True
0038: 
0039:     out = g.copy()
0040:     out[erase & (g != Color.RED)] = Color.BLACK
0041:     return out
0042: 
