+        height, width = _bbox_size(comp["bbox"])
+        tr0, tc0, tr1, tc1 = target_bbox
+        assert tr1 - tr0 + 1 == height and tc1 - tc0 + 1 == width
+        target_cells = _coords_from_bbox(target_bbox)
+        for cell in target_cells:
