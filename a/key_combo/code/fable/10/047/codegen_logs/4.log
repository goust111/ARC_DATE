+    inner_r, inner_c = _inner_corner(anchor_r, anchor_c, source_quad)
+    off_r = abs(inner_r - ref_r)
+    off_c = abs(inner_c - ref_c)
+    mirrored = _bbox_from_inner_offset(
+        (target_bbox[2] + 1, target_bbox[3] + 1),
+        anchor_r,
+        anchor_c,
+        target_quad,
+        off_r,
+        off_c,
+        height,
+        width,
