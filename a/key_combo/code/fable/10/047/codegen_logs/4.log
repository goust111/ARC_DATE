0033: def main(grid: np.ndarray) -> np.ndarray:
0034:     """
0035:     Delete each foreign-color object whose bounding box is contained by a larger object of another color.
0036: 
0037:     Input structure
0038:     - The black pixels are the empty canvas, and every other color forms one or more 8-connected monochromatic objects.
0039:     - Some larger foreground objects act as loose U/C-like containers around smaller objects of different colors.
0040:     Rule
0041:     - Find all 8-connected monochromatic non-black objects.
0042:     - Recolor an object to black exactly when its bounding box is contained in the bounding box of a larger object of another color.
0043:     - Keep all other pixels unchanged.
0044:     Key insight
0045:     - The removable objects are identified by containment in another color's rectangular extent, not by their own color or shape.
0046:     """
0047:     g = np.asarray(grid, dtype=int)
0048:     assert g.ndim == 2
