+    moved_target = random.randint(2, object_count - 1)
+    move_flags = [True] * moved_target + [False] * (object_count - moved_target)
+    random.shuffle(move_flags)
+
+    inp = np.full((h, w), BG, dtype=int)
+    out = np.full((h, w), BG, dtype=int)
