0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """Recolor each repeated source sprite from the same-position pixel in the compact colored legend.
0019: 
0020:     Input structure
0021:     - A background grid contains one repeated 8-connected sprite color and a compact legend made from other foreground colors.
0022:     - The legend pixels have the same row/column occupancy pattern as the layout of the repeated sprites.
0023: 
0024:     Rule
0025:     - Rank sprite bounding boxes by their top row and left column, and rank legend pixels by their row and column in the legend.
0026:     - Recolor every pixel of each sprite with the legend color at the matching rank position; leave the legend and background unchanged.
0027: 
0028:     Key insight
0029:     - The legend is a miniature color map for the arrangement of the larger repeated sprites, not a sprite to copy.
0030:     """
0031:     g = np.asarray(grid, dtype=int)
0032:     bg = get_bg(g)
0033: 
0034:     components = find_components(g, bg=bg, connectivity=8, monochromatic=True)
0035:     by_color: dict[int, list[dict]] = defaultdict(list)
0036:     for component in components:
0037:         by_color[int(component["color"])].append(component)
0038: 
0039:     source_colors = []
0040:     for color, color_components in by_color.items():
0041:         shapes = {_normalized_shape(component["coords"]) for component in color_components}
0042:         if (
0043:             len(color_components) >= 2
0044:             and len(shapes) == 1
0045:             and all(int(component["area"]) > 1 for component in color_components)
0046:         ):
0047:             source_colors.append(color)
0048:     assert len(source_colors) == 1
0049:     source_color = source_colors[0]
0050:     sprites = by_color[source_color]
0051: 
0052:     legend_coords = np.argwhere((g != bg) & (g != source_color))
0053:     assert len(legend_coords) == len(sprites)
0054: 
0055:     sprite_rows = sorted({int(sprite["bbox"][0]) for sprite in sprites})
0056:     sprite_cols = sorted({int(sprite["bbox"][1]) for sprite in sprites})
0057:     legend_rows = sorted({int(r) for r, _c in legend_coords})
0058:     legend_cols = sorted({int(c) for _r, c in legend_coords})
0059:     assert len(sprite_rows) == len(legend_rows)
0060:     assert len(sprite_cols) == len(legend_cols)
0061: 
0062:     legend_by_layout: dict[tuple[int, int], int] = {}
0063:     for r, c in legend_coords:
0064:         key = (legend_rows.index(int(r)), legend_cols.index(int(c)))
0065:         assert key not in legend_by_layout
0066:         legend_by_layout[key] = int(g[r, c])
0067: 
0068:     out = g.copy()
0069:     sprite_keys = set()
0070:     for sprite in sprites:
0071:         r0, c0, _r1, _c1 = sprite["bbox"]
0072:         key = (sprite_rows.index(int(r0)), sprite_cols.index(int(c0)))
0073:         assert key in legend_by_layout
0074:         assert key not in sprite_keys
0075:         sprite_keys.add(key)
0076: 
0077:         coords = sprite["coords"]
0078:         out[coords[:, 0], coords[:, 1]] = legend_by_layout[key]
0079: 
0080:     assert sprite_keys == set(legend_by_layout)
0081:     return out
