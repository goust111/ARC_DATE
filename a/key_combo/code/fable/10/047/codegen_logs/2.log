+def _attempt_generate(rng: np.random.Generator) -> np.ndarray | None:
+    source_h = int(rng.integers(11, 16))
+    source_w = int(rng.integers(11, 18))
+    max_level = min((source_h - MIN_FRAME_SIDE) // 2, (source_w - MIN_FRAME_SIDE) // 2)
