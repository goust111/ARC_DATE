def _gen_step_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
    r, c = map(int, start)
    er, ec = map(int, end)
    mask[r, c] = True
    while (r, c) != (er, ec):
        dr = _gen_sign(er - r)
        dc = _gen_sign(ec - c)
