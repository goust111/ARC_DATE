+        assert target_color != obj["color"], "ray must hit a different square"
+        hit = (hit_r, hit_c)
+        assert hit not in seen_hits, "hit cells must be uniquely determined"
+        seen_hits.add(hit)
+        handshakes.append((obj["color"], obj["hole"], hit, target_color))
