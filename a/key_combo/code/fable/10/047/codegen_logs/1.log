+                "source_id": source_id,
+                "target_id": target_id,
+                "decoy_id": decoy_id,
+                "hit": placed["hit"],
+            }
+        )
+
+        placed_bboxes.extend([placed["source_bbox"], placed["target_bbox"], placed["decoy_bbox"]])
+        for cell in placed["corridor"]:
+            protected_bg[cell] = True
