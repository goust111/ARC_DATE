+def _cell_on_ray(origin: tuple[int, int], direction: tuple[int, int], cell: tuple[int, int]) -> bool:
+    rr = cell[0] - origin[0]
+    cc = cell[1] - origin[1]
+    dr, dc = direction
+    if dr == 0:
