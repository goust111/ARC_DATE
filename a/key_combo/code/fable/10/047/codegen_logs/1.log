+    if (dr, dc) == (1, 1):
+        return hr, hc, hr + side - 1, hc + side - 1
+    if (dr, dc) == (-1, -1):
+        return hr - side + 1, hc - side + 1, hr, hc
+    if (dr, dc) == (-1, 1):
+        return hr - side + 1, hc, hr, hc + side - 1
+    if (dr, dc) == (1, -1):
