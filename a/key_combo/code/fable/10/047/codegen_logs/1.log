+        cheb_decoy, man_decoy = _bbox_min_distances(source["hole"], decoy["bbox"])
+        if not (cheb_decoy < cheb_target and man_decoy < man_target):
+            return False
+        if _bbox_on_ray(source["hole"], source["direction"], decoy["bbox"]):
