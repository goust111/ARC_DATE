+        assert int(coords.shape[0]) == expected_area
+        objects.append(
+            {
+                "color": color,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "side": side,
+                "center": (int(r0 + center_local), int(c0 + center_local)),
+                "hole": hole,
+                "direction": direction,
+            }
