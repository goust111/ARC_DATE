+    inp = _render_scene(shape, objects)
+    out = inp.copy()
+    for record in emitter_records:
+        source = objects[record["source_id"]]
+        target = objects[record["target_id"]]
+        out[source["hole"]] = target["color"]
+        out[record["hit"]] = source["color"]
