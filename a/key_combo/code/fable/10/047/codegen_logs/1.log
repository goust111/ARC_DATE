+    if (dr, dc) == (1, -1):
+        return hr, hc - side + 1, hr + side - 1, hc
+    raise AssertionError("invalid direction")
+
+
+def _cell_on_ray(origin: tuple[int, int], direction: tuple[int, int], cell: tuple[int, int]) -> bool:
+    rr = cell[0] - origin[0]
+    cc = cell[1] - origin[1]
+    dr, dc = direction
+    if dr == 0:
+        return rr == 0 and cc * dc > 0
+    if dc == 0:
