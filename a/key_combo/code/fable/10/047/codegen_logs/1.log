+def _place_extra_solid(
+    shape: tuple[int, int],
+    placed_bboxes: list[tuple[int, int, int, int]],
+    protected_bg: np.ndarray,
+) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    for _ in range(120):
