spec:
  type: symmetry/pattern
  input:
    grid: exactly 2x2
    colors: 3-4 distinct non-black colors (no color 0)
    symmetry: must NOT be LR-symmetric (fliplr != original) [observed but important for non-trivial output]
  output:
    grid: exactly 6x6 (3x3 tiling of the 2x2 tile)
    layout: |
      row 0-1: tile tile tile   (normal)
      row 2-3: tile' tile' tile' (LR-mirrored)
      row 4-5: tile tile tile   (normal)
    where tile' = np.fliplr(tile)

generation_strategy:
  approach: direct input generation (trivial 2x2 tile)
