+def _parse_linear_legend(grid: np.ndarray, coords: np.ndarray) -> tuple[list[int], np.ndarray]:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    assert h == 1 or w == 1
+    mask = np.zeros_like(grid, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
