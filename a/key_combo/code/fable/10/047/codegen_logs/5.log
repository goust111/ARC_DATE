+def _room_sequence_along_path(path: list[tuple[int, int]], rooms: list[dict]) -> list[int]:
+    room_hits = []
+    last_room = None
+    for r, c in path:
+        room_id = None
+        for idx, room in enumerate(rooms):
+            if room["mask"][r, c]:
+                room_id = idx
+                break
