+        touches_edge = r0 == 0 or c0 == 0 or r1 == g.shape[0] - 1 or c1 == g.shape[1] - 1
+        if touches_edge and (h == 1 or w == 1) and coords.shape[0] == max(h, w):
+            assert legend_coords is None
+            legend_coords = coords
+            continue
