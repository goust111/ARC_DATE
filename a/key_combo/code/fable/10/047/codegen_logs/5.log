+def _door(room: dict, side: str) -> tuple[int, int]:
+    r = int(room["r"])
+    c = int(room["c"])
+    s = int(room["n"])
+    mid_r = r + s // 2
+    mid_c = c + s // 2
+    if side == "N":
+        return r - 1, mid_c
+    if side == "S":
+        return r + s, mid_c
+    if side == "W":
+        return mid_r, c - 1
+    return mid_r, c + s
