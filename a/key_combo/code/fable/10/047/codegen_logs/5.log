+def _room_top_left(lr: int, lc: int, stride: int, margin: int) -> tuple[int, int]:
+    return margin + lr * stride, margin + lc * stride
+
+
+def _room_outer_box(room: dict) -> tuple[int, int, int, int]:
+    r = int(room["r"])
+    c = int(room["c"])
+    s = int(room["n"])
+    return r - 1, c - 1, r + s, c + s
