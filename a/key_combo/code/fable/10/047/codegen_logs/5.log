+def _find_rooms(grid: np.ndarray, bg: int, wall: int) -> list[dict]:
+    h, w = grid.shape
+    rooms = []
+    seen_boxes = set()
+    max_n = min(6, h - 2, w - 2)
+    for n in range(2, max_n + 1):
+        perim = 4 * (n + 2) - 4
+        for r in range(1, h - n - 1):
+            for c in range(1, w - n - 1):
+                interior = grid[r : r + n, c : c + n]
+                if np.any(interior == wall):
