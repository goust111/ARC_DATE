+    er, ec = end
+    pts = []
+    if sr == er:
+        step = 1 if sc <= ec else -1
+        for c in range(sc, ec + step, step):
+            pts.append((sr, c))
+    else:
+        step = 1 if sr <= er else -1
+        for r in range(sr, er + step, step):
+            pts.append((r, sc))
+    return pts
