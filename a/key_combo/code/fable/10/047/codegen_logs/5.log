        if door[0] == end[0]:
            step = 1 if door[1] <= end[1] else -1
            for c in range(door[1], end[1] + step, step):
                pts.append((door[0], c))
        else:
            step = 1 if door[0] <= end[0] else -1
            for r in range(door[0], end[0] + step, step):
                pts.append((r, door[1]))
        endpoint_corridors.append(pts)
        endpoint_cells.append(end)
