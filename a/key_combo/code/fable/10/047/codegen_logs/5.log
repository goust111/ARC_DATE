+        start = random.randint(1, final_h - len(legend) - 1)
+        for i, color in enumerate(legend):
+            grid[start + i, 0] = int(color)
+    else:
+        start = random.randint(1, final_h - len(legend) - 1)
+        for i, color in enumerate(legend):
