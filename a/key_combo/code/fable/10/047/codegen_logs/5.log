def _gen_small_sprite(area: int, color: int, max_h: int, max_w: int) -> np.ndarray | None:
    area = int(area)
    if area < 1:
        return None
    dims = []
    for h in range(1, min(max_h, area) + 1):
        for w in range(1, min(max_w, area) + 1):
            if h * w >= area and max(h, w) <= area:
