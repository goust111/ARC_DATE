                if side in used_sides[idx] or (idx == 0 and side == start_side) or (idx == len(route_rooms) - 1 and side == end_side):
                    continue
                dr, dc = DIRS[side]
                target = (pos[0] + dr, pos[1] + dc)
                if target in logical_index:
                    continue
                rr, cc = _room_top_left(target[0], target[1], stride, margin)
                room = {"r": rr, "c": cc, "n": room_size}
                box = _room_outer_box(room)
                if any(_boxes_overlap(box, _room_outer_box(other), pad=1) for other in all_rooms):
                    continue
                candidate_dead.append((idx, side, room))
        if candidate_dead:
            idx, side, dead_end_room = random.choice(candidate_dead)
            all_rooms.append(dead_end_room)
            add_room(dead_end_room)
            pts = _carve_line(np.zeros((1, 1), dtype=bool), _door(route_rooms[idx], side), _door(dead_end_room, OPPOSITE[side]))
            passable_pts.update(pts)

    detour_room = None
    detour_direct_segment = None
    candidate_detours = []
    for seg in corridor_segments:
        a = seg["a"]
        b = seg["b"]
        side = seg["side"]
        if side in {"E", "W"}:
            row = a[0]
            c0, c1 = sorted((a[1], b[1]))
            for sign in (-1, 1):
                door_row = row + sign * 3
                left_col = c0
                room = {"r": door_row - room_size // 2, "c": left_col + 1, "n": room_size}
                box = _room_outer_box(room)
                if any(_boxes_overlap(box, _room_outer_box(other), pad=1) for other in all_rooms):
                    continue
                candidate_detours.append((seg, sign, room))
        else:
            col = a[1]
            r0, r1 = sorted((a[0], b[0]))
            for sign in (-1, 1):
                door_col = col + sign * 3
                top_row = r0
                room = {"r": top_row + 1, "c": door_col - room_size // 2, "n": room_size}
                box = _room_outer_box(room)
                if any(_boxes_overlap(box, _room_outer_box(other), pad=1) for other in all_rooms):
                    continue
                candidate_detours.append((seg, sign, room))
    if not candidate_detours:
