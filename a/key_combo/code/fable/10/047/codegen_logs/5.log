+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 8
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+GEN_ATTEMPTS = 400
+
+ROUTE_TEMPLATES = [
+    [(0, 0), (0, 1), (1, 1)],
+    [(0, 0), (0, 1), (1, 1), (1, 2)],
+    [(0, 0), (1, 0), (1, 1), (2, 1)],
+    [(0, 0), (0, 1), (0, 2), (1, 2)],
+    [(0, 0), (1, 0), (2, 0), (2, 1)],
+    [(0, 0), (0, 1), (1, 1), (2, 1), (2, 2)],
+    [(0, 1), (0, 2), (1, 2), (1, 1), (2, 1)],
+]
+
+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+OPPOSITE = {"N": "S", "S": "N", "W": "E", "E": "W"}
