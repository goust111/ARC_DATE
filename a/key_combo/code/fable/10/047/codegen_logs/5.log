+                top = grid[r - 1, c - 1 : c + n + 1]
+                bottom = grid[r + n, c - 1 : c + n + 1]
+                left = grid[r - 1 : r + n + 1, c - 1]
+                right = grid[r - 1 : r + n + 1, c + n]
+                corners = (
+                    int(grid[r - 1, c - 1]) == wall
+                    and int(grid[r - 1, c + n]) == wall
+                    and int(grid[r + n, c - 1]) == wall
+                    and int(grid[r + n, c + n]) == wall
