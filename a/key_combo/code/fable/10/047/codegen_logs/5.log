+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 8
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 9]
+GEN_ATTEMPTS = 400
+
+ROUTE_TEMPLATES = [
+    [(0, 0), (0, 1), (1, 1)],
+    [(0, 0), (0, 1), (1, 1), (1, 2)],
