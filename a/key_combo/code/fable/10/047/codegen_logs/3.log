+def _trail_and_ray(grid: np.ndarray) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int], set[tuple[int, int]]]:
+    red_cells = np.argwhere(grid == RED)
+    assert len(red_cells) == 1, "expected a unique red source"
