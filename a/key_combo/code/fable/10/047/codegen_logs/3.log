+
+        target_hit = None
+        target_cells = None
+        bg_lens = list(range(SEGMENT_BG_RANGE[0], SEGMENT_BG_RANGE[1] + 1))
+        random.shuffle(bg_lens)
+        for bg_len in bg_lens:
+            bg_segment = _segment_cells(current, current_dir, bg_len)
+            hit = _step(current, current_dir, bg_len + 1)
