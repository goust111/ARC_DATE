+def _reflect(direction: tuple[int, int], mirror_kind: str) -> tuple[int, int]:
+    dr, dc = direction
+    if mirror_kind == "/":
+        return -dc, -dr
+    if mirror_kind == "\\":
+        return dc, dr
+    raise AssertionError("unknown mirror kind")
