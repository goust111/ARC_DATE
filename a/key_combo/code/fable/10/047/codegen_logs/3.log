+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        planned = _plan_scene()
+        if planned is None:
+            continue
+        grid = planned["grid"]
+        if _semantic_ok(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid mirror-beam ARC input")

