+        mirrors: list[dict] = []
+
+        current = source
+        current_dir = ray_dir
+        ok = True
+
+        for _mirror_idx in range(reflections_goal):
+            placed = False
+            turn_dirs = _turn_options(current_dir)
+            random.shuffle(turn_dirs)
+            bg_lens = list(range(SEGMENT_BG_RANGE[0], SEGMENT_BG_RANGE[1] + 1))
