+    dirs = DIRS4 if connectivity == 4 else DIRS8
+    seen = {start}
+    q = deque([start])
+    h, w = grid.shape
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors(r, c, dirs):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in seen or int(grid[nr, nc]) != color:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
+    return seen
+
+
+def _components_of_color(mask: np.ndarray, *, connectivity: int) -> list[set[tuple[int, int]]]:
+    h, w = mask.shape
+    dirs = DIRS4 if connectivity == 4 else DIRS8
+    seen: set[tuple[int, int]] = set()
+    comps: list[set[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or (r, c) in seen:
+                continue
+            comp = {(r, c)}
+            seen.add((r, c))
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors(rr, cc, dirs):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if not bool(mask[nr, nc]) or (nr, nc) in seen:
+                        continue
+                    seen.add((nr, nc))
+                    comp.add((nr, nc))
+                    q.append((nr, nc))
+            comps.append(comp)
+    return comps
