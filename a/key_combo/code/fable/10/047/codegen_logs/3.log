+    r, c = start
+    dr, dc = direction
+    seen_states: set[tuple[int, int, int, int]] = set()
+    path_cells: list[tuple[int, int]] = []
+    reflection_count = 0
+
+    while True:
+        state = (r, c, dr, dc)
+        if state in seen_states:
+            raise AssertionError("beam entered a loop")
+        seen_states.add(state)
