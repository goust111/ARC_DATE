+        if target_cells is None or target_hit is None:
+            continue
+
+        blocks: list[set[tuple[int, int]]] = [target_cells]
+
+        if mirrors:
+            first = mirrors[0]
+            for bg_len in range(1, SEGMENT_BG_RANGE[1] + 1):
+                hit = _step(first["cell"], first["in_dir"], bg_len + 1)
+                if not _in_bounds(shape, *hit):
