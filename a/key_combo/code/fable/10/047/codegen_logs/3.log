    if count == 0:
        return []
    if count == 1:
        return [total]
    cuts = np.random.choice(np.arange(1, total), count - 1, replace=False)
    cuts = [0] + sorted(int(c) for c in cuts) + [total]
    return [cuts[i + 1] - cuts[i] for i in range(count)]


