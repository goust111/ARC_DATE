+) -> dict[str, dict] | None:
+    spare = {label: cap - spec["input_count"] for label, spec in green_specs.items()}
+    cands0 = _candidate_red_specs(green_specs[mapping["R0"]]["area"], cap)
+    cands1 = _candidate_red_specs(green_specs[mapping["R1"]]["area"], cap)
