+def _semantic_ok(inp: np.ndarray, out: np.ndarray, scenario: str) -> bool:
+    try:
+        bg, reds, greens = _parse_lanes(inp)
+        pairing = _pair_reds_to_greens(reds, greens)
+    except Exception:
+        return False
