+MARKER_GREEN = 3
+PERIOD = 4
+BOTTOM_GAP = 1
+LANE_WIDTH = 3
+RED_COUNT_BOUNDS = (1, 4)
+GREEN_INPUT_COUNT_BOUNDS = (2, 3)
+GEN_RETRIES = 400
