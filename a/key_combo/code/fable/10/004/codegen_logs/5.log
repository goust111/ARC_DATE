+    mask = SHAPES[shape_name]
+    for top in _stack_tops(count, grid.shape[0]):
+        for rr, cc in np.argwhere(mask):
+            grid[top + int(rr), left + int(cc)] = color
+
+
+def _layout_scenario() -> tuple[str, list[str], dict[str, int], int]:
