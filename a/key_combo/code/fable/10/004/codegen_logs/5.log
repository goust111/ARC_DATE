+SHAPES: dict[str, np.ndarray] = {
+    "tri": np.array(
+        [
+            [1, 0, 0],
+            [1, 1, 0],
+            [0, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    "square": np.array(
+        [
+            [1, 1, 0],
+            [1, 1, 0],
+            [0, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    "rect": np.array(
+        [
+            [1, 1, 1],
+            [1, 1, 1],
+            [0, 0, 0],
+        ],
+        dtype=bool,
+    ),
+    "ring": np.array(
+        [
+            [1, 1, 1],
+            [1, 0, 1],
+            [1, 1, 1],
+        ],
+        dtype=bool,
