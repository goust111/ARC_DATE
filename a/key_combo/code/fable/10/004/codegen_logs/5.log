spec:
  grid: 3-9 rows x 7-30 cols, bg=0
  bars:
    description: bottom-aligned 1-cell-wide vertical bars, all sharing same baseline (last row)
    colors: blue(1) = marker, red(2) = body; only these two colors
    count: 2-9 total, 1-3 blue + 1-6 red
    height: 2-4 cells each; grid rows >= max bar height
    no_overlap: each bar occupies a unique column
  chains:
    rule: starting at each blue bar, greedily chain the next bar if it is red AND its column == current bar's column + current bar's height
    count: 1-3 chains (one per blue bar)
    length: 1-5 bars per chain (including the blue starter)
    fit: last bar's col + height <= grid width (rotated chain must fit)
  unchained_red:
    count: 0-2 red bars not reached by any chain
    reason: gap from preceding bar != that bar's height, or preceding bar is unchained red
    behavior: remain unchanged in output [observed]
  transform:
