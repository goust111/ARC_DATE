+    return _solve(grid, use_area=True)
+
+
+def _stack_tops(count: int, height: int) -> list[int]:
+    bottom_top = height - 5
+    return [bottom_top - PERIOD * step for step in range(count - 1, -1, -1)]
+
+
+def _capacity(height: int) -> int:
+    tops = _stack_tops(1, height)
+    bottom_top = tops[-1]
