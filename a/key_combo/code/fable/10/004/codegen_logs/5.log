+    offsets = [(rr - ref["bbox"][0], cc - ref["bbox"][1]) for rr, cc in ref["coords"]]
+    return {
+        "bar": bar,
+        "center": bar["center"],
+        "color": template_color,
+        "area": template_area,
+        "mask": template_mask,
+        "offsets": offsets,
+        "left": left_anchor,
+        "count": len(sprites),
+        "top_rows": top_rows,
+        "occupied": set(top_rows),
+        "period": period,
+        "bottom_top": max(top_rows),
+    }
