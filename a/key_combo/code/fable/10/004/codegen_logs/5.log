+        gaps = [g0, g1, g2]
+    elif scenario == "split3":
+        ordered = ["G0", "R0", "G1", "R1", "G2"]
+        g0 = random.randint(4, 5)
+        g1 = random.randint(g0 + 1, 6)
+        g2 = random.randint(4, 5)
+        g3 = random.randint(g2 + 1, 6)
