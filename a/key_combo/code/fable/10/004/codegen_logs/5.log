+    top_rows = []
+    for sprite in sprites:
+        assert sprite["area"] == template_area
+        assert sprite["color"] == template_color
+        assert np.array_equal(sprite["mask"], template_mask)
+        assert sprite["bbox"][1] == left_anchor
