+        return False
+
+    if len(greens) < 2 or len(reds) != 2:
+        return False
+    if len({lane["area"] for lane in reds + greens}) < 2:
+        return False
+
+    if scenario.startswith("split"):
+        if pairing[0] == pairing[1]:
+            return False
+    else:
