+
+    for label in green_labels:
+        center = centers[label]
+        inp[-1, center - 1 : center + 2] = MARKER_GREEN
+    for label in red_labels:
+        center = centers[label]
+        inp[-1, center - 1 : center + 2] = MARKER_RED
