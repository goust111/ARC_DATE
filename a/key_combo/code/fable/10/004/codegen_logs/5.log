+def _layout_scenario() -> tuple[str, list[str], dict[str, int], int]:
+    scenario = random.choice(["split2", "split3", "same_middle"])
+    if scenario == "split2":
+        ordered = ["G0", "R0", "G1", "R1"]
+        g0 = random.randint(4, 5)
+        g1 = random.randint(g0 + 1, 6)
+        g2 = random.randint(4, 6)
