+
+def _candidate_red_specs(dest_area: int, max_red_count: int) -> list[dict]:
+    candidates = []
+    for shape_name, area in AREAS.items():
+        for count in range(RED_COUNT_BOUNDS[0], min(RED_COUNT_BOUNDS[1], max_red_count) + 1):
