+
+def _semantic_check(inp: np.ndarray, legends: list[dict], occupancy: list[int]) -> bool:
+    canonical_legends = [_canonical_mask(entry["full_mask"]) for entry in legends]
+    if len(set(canonical_legends)) != len(canonical_legends):
+        return False
