+    _bool_mask(["010", "111", "010"]),
+    _bool_mask(["111", "101", "111"]),
+    _bool_mask(["101", "111"]),
+    _bool_mask(["101", "101", "111"]),
+    _bool_mask(["010", "111", "101"]),
+    _bool_mask(["010", "111", "111"]),
