+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+LATTICE_COLOR = 1
+BACKGROUND_COLOR = 0
+DATA_COLOR = 5
+
+ARRAY_ROWS = 4
+ARRAY_COLS = 4
+CELL_SIZE = 6
+LINE_SIZE = 1
+MAX_GENERATION_ATTEMPTS = 400
+
+LEGEND_COLOR_POOL = (2, 3, 4, 6, 7, 8, 9)
+OUTER_SLOTS_BY_SIDE = {
+    "top": [(0, 1), (0, 2)],
+    "bottom": [(ARRAY_ROWS - 1, 1), (ARRAY_ROWS - 1, 2)],
+    "left": [(1, 0), (2, 0)],
+    "right": [(1, ARRAY_COLS - 1), (2, ARRAY_COLS - 1)],
