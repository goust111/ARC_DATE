+    blocks = mask.reshape(h // 2, 2, w // 2, 2)
+    mins = blocks.min(axis=(1, 3))
+    maxs = blocks.max(axis=(1, 3))
+    assert np.array_equal(mins, maxs), "scaled sprite must be a strict 2x replication"
+    return mins.astype(bool)
