+
+    for (r0, r1, c0, c1), key in data_cells:
+        assert key in codebook, "each interior sprite must match a completed legend"
+        out[r0 : r1 + 1, c0 : c1 + 1][g[r0 : r1 + 1, c0 : c1 + 1] == DATA_COLOR] = codebook[key]
