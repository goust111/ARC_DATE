# Canvas and density bounds.
GRID_HEIGHT_RANGE = (6, 10)
GRID_WIDTH_RANGE = (6, 12)
SPEC_DENSITY_RANGE = (0.10, 0.40)
OBSERVED_DENSITY_RANGE = (0.14, 0.36)

