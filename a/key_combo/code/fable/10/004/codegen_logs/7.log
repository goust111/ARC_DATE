+    if side == "left":
+        rr = r0 + random.randint(1, CELL_SIZE - patch_h - 1)
+        cc = c0
+    elif side == "right":
+        rr = r0 + random.randint(1, CELL_SIZE - patch_h - 1)
+        cc = c0 + CELL_SIZE - patch_w
+    elif side == "top":
+        rr = r0
+        cc = c0 + random.randint(1, CELL_SIZE - patch_w - 1)
+    else:
+        rr = r0 + CELL_SIZE - patch_h
+        cc = c0 + random.randint(1, CELL_SIZE - patch_w - 1)
