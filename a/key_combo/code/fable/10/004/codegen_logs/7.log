+def _gen_attempt() -> np.ndarray | None:
+    grid = _empty_canvas()
+    expected = grid.copy()
+
+    legend_count = random.choice([3, 4])
+    selected_sides = list(OUTER_SLOTS_BY_SIDE)
+    if legend_count == 3:
