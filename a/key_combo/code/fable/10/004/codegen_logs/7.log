def _gen_min_square_inside_pocket(r, c, squares):
    for sr, sc, side in squares:
        fits_rows = sr <= r and r + _GEN_MIN_SELECTED_SIDE <= sr + side
        fits_cols = sc <= c and c + _GEN_MIN_SELECTED_SIDE <= sc + side
        if fits_rows and fits_cols:
