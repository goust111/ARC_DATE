+    row_spans = []
+    prev_end = row_groups[0][1]
+    for start, end in row_groups[1:]:
+        if prev_end + 1 <= start - 1:
+            row_spans.append((prev_end + 1, start - 1))
+        prev_end = end
+
+    col_spans = []
+    prev_end = col_groups[0][1]
+    for start, end in col_groups[1:]:
+        if prev_end + 1 <= start - 1:
+            col_spans.append((prev_end + 1, start - 1))
+        prev_end = end
