+            assert non_bg == {DATA_COLOR}, "interior non-empty cells must contain one grey sprite"
+            sprite_mask = _tight_crop(cell == DATA_COLOR)
+            shrunk = _downscale2(sprite_mask)
+            data_cells.append(((r0, r1, c0, c1), _canonical_mask(shrunk)))
