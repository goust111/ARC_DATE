    """Scatter values into distinct random cells of the fixed canvas."""
    grid = np.zeros(GEN_GRID_SHAPE, dtype=int)
    flat_indices = random.sample(range(GEN_N_CELLS), len(values))
    grid.reshape(-1)[flat_indices] = values
    return grid

