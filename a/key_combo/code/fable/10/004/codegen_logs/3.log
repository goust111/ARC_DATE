+
+    valid_sites = []
+    for r0 in rows:
+        for c0 in cols:
+            rr = r0 + dr
+            cc = c0 + dc
+            if 0 <= rr <= height - ph and 0 <= cc <= width - pw:
+                valid_sites.append((r0, c0))
+    if not valid_sites:
+        raise RuntimeError("no site can host the displaced sprite")
+    defect_anchor = random.choice(valid_sites)
