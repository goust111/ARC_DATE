54:        regions.append((r0, c0, coords))
55:
56:    row_starts = sorted({r0 for r0, _, _ in regions})
57:    col_starts = sorted({c0 for _, c0, _ in regions})
58:    assert len(row_starts) >= 3 and len(col_starts) >= 3, "expected an array with an interior"
59:    positions = {(r0, c0) for r0, c0, _ in regions}
