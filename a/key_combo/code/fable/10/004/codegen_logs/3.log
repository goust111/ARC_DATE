+    for removed in candidates:
+        kept = sorted(value for value in counts if value != removed)
+        if len(kept) < 3:
+            continue
+        diffs = [b - a for a, b in zip(kept, kept[1:])]
+        if len(set(diffs)) != 1 or diffs[0] <= 0:
+            continue
