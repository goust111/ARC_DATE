9:def main(grid: np.ndarray) -> np.ndarray:
10:    """
11:    Replace the sparse scene with a square diagonal marker grid whose side length is the number of foreground objects.
12:
13:    Input structure:
14:    - The grid has one dominant background color and exactly one foreground color.
15:    - The foreground pixels form one or more separated 4-connected objects.
16:
17:    Rule:
18:    - Count the 4-connected foreground objects.
19:    - Return a square grid, filled with the background color, with side length equal to that count.
20:    - Place the foreground color on the main diagonal from upper left to lower right.
21:
22:    Key insight:
23:    - The large foreground shapes are tokens to count; their detailed shapes and positions do not affect the output beyond the object count.
24:    """
25:    g = np.asarray(grid, dtype=int)
26:    bg = int(get_bg(g))
27:    fg_colors = colors_present(g, exclude={bg})
28:    assert len(fg_colors) == 1, "expected exactly one foreground color"
29:    fg = int(fg_colors[0])
30:
31:    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])
32:    n = len(objects)
33:    assert n > 0, "expected at least one foreground object"
34:
35:    out = np.full((n, n), bg, dtype=int)
36:    np.fill_diagonal(out, fg)
37:    return out
