+    return {
+        "bg": bg,
+        "patch": patch,
+        "rows": regular_rows,
+        "cols": regular_cols,
+        "shift": shift,
+        "expected_anchor": expected_anchor,
+        "actual_anchor": actual_anchor,
+    }
