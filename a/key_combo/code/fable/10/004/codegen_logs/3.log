+    pr0 = rr0 - int(r0)
+    pc0 = cc0 - int(c0)
+    view = patch[pr0 : pr0 + (rr1 - rr0), pc0 : pc0 + (cc1 - cc0)]
+    mask = view != bg
+    dst_view = dst[rr0:rr1, cc0:cc1]
