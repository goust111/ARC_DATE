+def _paste_clip(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = patch.shape
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(dst.shape[0], int(r0) + h)
+    cc1 = min(dst.shape[1], int(c0) + w)
