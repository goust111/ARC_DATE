+                        q.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "anchor": (r0, c0),
+                    "patch": patch,
+                }
