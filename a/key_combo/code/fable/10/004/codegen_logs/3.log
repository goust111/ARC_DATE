+def _infer_task(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _get_bg(g)
+    comps = _components(g, bg)
+    assert len(comps) >= 9, "expected a full translation lattice with many instances"
