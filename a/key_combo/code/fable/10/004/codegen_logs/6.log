    unmarked_lanes: 1-2 lanes have no marker
  transformation:
    red_lane_sprites: recolored to grey (5)
    green_lane: gains N new sprites (N = total red-lane sprite count), using the plus shape recolored to green lane's sprite color, stacked upward from bottom in empty period-4 slots
    markers: all removed (set to bg)
    unmarked_lanes: unchanged
    constraint: green_lane existing sprites + N must fit in grid (max ~7 sprites per lane)

generation_strategy:
