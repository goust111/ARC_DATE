+    used_quadrants = set(meta["tamper_quadrants"])
+    if meta["mode"] == "concentrated" and len(used_quadrants) != 1:
+        return False
+    if meta["mode"] == "distributed" and len(used_quadrants) < 2:
+        return False
+
+    for r in range(source.shape[0]):
