+    if quadrant == 1:
+        return r, w - 1 - c
+    if quadrant == 2:
+        return h - 1 - r, c
+    if quadrant == 3:
+        return h - 1 - r, w - 1 - c
+    raise ValueError("quadrant must be in 0..3")
