+    expected = _expected_output(bg, truth_map)
+
+    min_rows = max(GRID_MIN, panel_h + 2)
+    min_cols = max(GRID_MIN, panel_w + 2)
+    rows = random.randint(min_rows, GRID_MAX)
+    cols = random.randint(min_cols, GRID_MAX)
+
