+        if len(set(map(int, source.ravel()))) < target_colors:
+            continue
+        if np.array_equal(source, source[:, ::-1]):
+            continue
+        if np.array_equal(source, source[::-1, :]):
+            continue
+        if np.array_equal(source, source[::-1, ::-1]):
+            continue
+        return source.astype(int)
+    return None
