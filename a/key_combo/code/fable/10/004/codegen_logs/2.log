+        int(panel[r, w - 1 - c]),
+        int(panel[h - 1 - r, c]),
+        int(panel[h - 1 - r, w - 1 - c]),
+    ]
+
+
+def _quadrant_position(panel_shape: tuple[int, int], r: int, c: int, quadrant: int) -> tuple[int, int]:
+    h, w = panel_shape
+    if quadrant == 0:
+        return r, c
+    if quadrant == 1:
+        return r, w - 1 - c
+    if quadrant == 2:
+        return h - 1 - r, c
+    if quadrant == 3:
+        return h - 1 - r, w - 1 - c
+    raise ValueError("quadrant must be in 0..3")
+
