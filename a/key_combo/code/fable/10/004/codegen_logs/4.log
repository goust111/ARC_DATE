+def _frame_fits_bbox(box_h: int, box_w: int, frame: dict) -> tuple[bool, bool]:
+    direct = box_h <= frame["cavity_h"] and box_w <= frame["cavity_w"]
+    rotated = box_w <= frame["cavity_h"] and box_h <= frame["cavity_w"]
