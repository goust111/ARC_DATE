+
+    seen_roles = set()
+    survivor_colors = set()
+    for obj in placed_objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.array_equal(patch, obj["patch"]):
