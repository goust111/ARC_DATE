+            seen_roles.add("plain")
+
+    if seen_roles != {"rotation", "anti", "plain", "erased"}:
+        return False
+    if len(survivor_colors) < 2:
+        return False
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
