+        for box_w in range(2, max_dim + 1):
+            best, direct, rotated = _best_frame_for_bbox(box_h, box_w, frames)
+            if best is None:
+                if any(frame["area"] >= box_h * box_w for frame in frames):
+                    erased.append({"bbox": (box_h, box_w)})
+                continue
+
+            smaller = []
+            for frame in frames:
