+def _simulate_chain(initial_actor: tuple[Coord, ...], anchors: list[dict]) -> tuple[list[dict], tuple[Coord, ...]]:
+    current = tuple(sorted(initial_actor))
+    used: set[int] = set()
+    copies: list[dict] = []
