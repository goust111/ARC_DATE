+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _find_components(grid: np.ndarray, bg: int, connectivity: int = 8) -> list[dict]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return components
+
+
+def _is_connected_mask(mask: np.ndarray) -> bool:
+    pts = [tuple(map(int, p)) for p in np.argwhere(mask)]
+    if not pts:
+        return False
+    seen = {pts[0]}
+    stack = [pts[0]]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors(r, c, 8):
+            if (nr, nc) in seen:
+                continue
