DIRS=['left','right','above','below']


def bbox(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    return min(rs), min(cs), max(rs), max(cs)

def overlap(a0,a1,b0,b1):
    return max(a0,b0)<=min(a1,b1)

def relation(actor, ab):
    r0,c0,r1,c1=bbox(actor)
    ar0,ac0,ar1,ac1=ab
    out=[]
    if c1 < ac0 and overlap(r0,r1,ar0,ar1): out.append(('left',0,ac0-c1-1))
    if c0 > ac1 and overlap(r0,r1,ar0,ar1): out.append(('right',0,ac1+1-c0))
    if r1 < ar0 and overlap(c0,c1,ac0,ac1): out.append(('above',ar0-r1-1,0))
    if r0 > ar1 and overlap(c0,c1,ac0,ac1): out.append(('below',ar1+1-r0,0))
    return out

def mirror(actor, ab, side, dr, dc):
    ar0,ac0,ar1,ac1=ab
    moved=[]; new=[]
    for r,c in actor:
        rr=r+dr; cc=c+dc
        moved.append((rr,cc))
        if side=='left': new.append((rr, 2*ac0-1-cc))
        elif side=='right': new.append((rr, 2*ac1+1-cc))
        elif side=='above': new.append((2*ar0-1-rr, cc))
        else: new.append((2*ar1+1-rr, cc))
    return tuple(sorted(moved)), tuple(sorted(new))

def norm(coords):
    r0,c0,r1,c1=bbox(coords)
    return frozenset((r-r0,c-c0) for r,c in coords)

def connected(mask):
    pts=[p for p,v in np.ndenumerate(mask) if v]
    if not pts: return False
    seen={pts[0]}; q=[pts[0]]
    while q:
        r,c=q.pop()
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==0 and dc==0: continue
                np2=(r+dr,c+dc)
                if np2 in seen: continue
                rr,cc=np2
                if 0<=rr<mask.shape[0] and 0<=cc<mask.shape[1] and mask[rr,cc]:
                    seen.add(np2); q.append(np2)
    return len(seen)==len(pts)

def enumerate_masks():
    masks=[]
    for h,w in [(2,3),(3,2),(3,3),(3,4),(4,3)]:
        for area in range(4, min(6,h*w)+1):
            for cells in itertools.combinations(range(h*w), area):
                m=np.zeros((h,w), dtype=bool)
                for x in cells: m[x//w, x%w]=True
                if not connected(m): continue
                if not (m[0].any() and m[-1].any() and m[:,0].any() and m[:,-1].any()): continue
                if np.array_equal(m, np.fliplr(m)) or np.array_equal(m, np.flipud(m)): continue
                masks.append(m)
    return masks
MASKS=enumerate_masks()
print('masks', len(MASKS))


def rect_cells(ab):
    r0,c0,r1,c1=ab
    return {(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)}


def prefix_ok(states, anchors):
    m=len(anchors)
    for j in range(m):
        cands=[i for i in range(j,m) if relation(states[j], anchors[i])]
        if cands "'!= [j]:
            return False
    return True


def build_once():
    cur=tuple(sorted((int(r),int(c)) for r,c in zip(*np.where(random.choice(MASKS)))))
    steps=random.randint(2,4)
    states=[cur]
    anchors=[]
    copies=[]
    occupied_copies=set()
    for step in range(steps):
        ok=False
        for _ in range(300):
            side=random.choice(DIRS)
            gap=random.randint(2,5)
            r0,c0,r1,c1=bbox(cur)
            if side=='"'left':
                ab=(r0, c1+gap+1, r0+1, c1+gap+2)
            elif side=='right':
                ab=(r0, c0-gap-2, r0+1, c0-gap-1)
            elif side=='above':
                ab=(r1+gap+1, c0, r1+gap+2, c0+1)
            else:
                ab=(r0-gap-2, c0, r0-gap-1, c0+1)
            # collisions input anchors
            acells=rect_cells(ab)
            if any(acells & rect_cells(x) for x in anchors):
                continue
            if acells & set(states[0]):
                continue
            rels=relation(cur, ab)
            if len(rels)"'!=1 or rels[0][0]!=side:
                continue
            _,dr,dc=rels[0]
            moved,new=mirror(cur, ab, side, dr, dc)
            if norm(cur)==norm(new):
                continue
            snew=set(new)
            if snew & occupied_copies:
                continue
            if any(snew & rect_cells(x) for x in anchors):
                continue
            temp_anchors=anchors+[ab]
            temp_states=states+[new]
            if not prefix_ok(temp_states, temp_anchors):
                continue
            anchors=temp_anchors
            states=temp_states
            copies.append(new)
            occupied_copies |= snew
            cur=new
            ok=True
            break
        if not ok:
            return False
    # full check no extra future candidate at final
    if any(relation(states[-1], ab) for ab in anchors):
        return False
    # bounds span
    allpts=set(states[0])|occupied_copies
    for ab in anchors: allpts|=rect_cells(ab)
    rs=[r for r,c in allpts]; cs=[c for r,c in allpts]
    h=max(rs)-min(rs)+1; w=max(cs)-min(cs)+1
    return h<=24 and w<=24

cnt=0
for i in range(500):
    if build_once():
        cnt+=1
