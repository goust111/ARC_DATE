import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste

# concepts:
# growing

# description:
# In the input you will see a grid with some green rectangles. Each rectangle has one red pixel on one of its borders.
# To make the output, you should extend the green region of each rectangle to the border of the grid in the direction of the red pixel, with the extent of the line increasing with the extent of the rectangle.
# Also you should draw a red line from the red pixel to the border of the grid.


def main(input_grid):
    """
    Grow each green rectangle outward from its red border indicator to the canvas edge.

    Input structure:
    - Each foreground object is a green rectangle with one red pixel on its border.
    - Objects sit on a black background.
    - The red pixel indicates the side from which growth should extend.

    Rule:
    - Find each rectangle-and-indicator component.
    - Extend a green band from the rectangle toward the canvas edge on the indicator side.
    - Draw a red line from the indicator pixel to that same edge.

    Key insight:
    - The indicator side controls direction, while the rectangle thickness controls the grown band.
    """
    # Initialize the output grid
    output_grid = np.copy(input_grid)
    
    rectangle_color = Color.GREEN
    indicator_color = Color.RED
    background = Color.BLACK

    # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
    objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
    for obj in objects:
        # find the red indicator
        for red_r, red_c in np.argwhere(obj == indicator_color):
            break

        # Get the dimensions of the object, and its position
        _b = bbox(obj != background)
        assert _b is not None
        r, c, _r1, _c1 = _b
        width = _r1 - r + 1
        height = _c1 - c + 1

        # depending on which side of the rectangle that the indicator is on, we draw in different directions
        # left edge: draw to the left
        if red_r == r:
            # Extend the green rectangle to the left until it reaches the border
            output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
        elif red_r == r + width - 1:
            # Extend the green rectangle to the right until it reaches the border
            output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
        elif red_c == c:
            # Extend the green rectangle to the top until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
        elif red_c == c + height - 1:
            # Extend the green rectangle to the bottom until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
        else:
            assert False, "The red pixel is not on the border of the rectangle"

    return output_grid

def generate_input():
    # Create the background grid
    n, m = np.random.randint(20, 30), np.random.randint(20, 30)
    grid = np.full((m, n), Color.BLACK)

    rectangle_num = 2
    rectangle_color = Color.GREEN
    indicator_color = Color.RED

    # Draw rectangles on the grid
    for i in range(rectangle_num):
        width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        # The width should be twice smaller than the height
        while (width * 2 + 2) >= height:
            width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        green_rectangle = np.full((width, height), rectangle_color)

        # Place one indicator pixel on one random border of the rectangle
        # Spare enough space for the extend line with the same size of width - 1
        r_coord = np.random.choice([0, width - 1])
        c_coord = np.random.choice(range(width + 1, height - (width + 1)))
        green_rectangle[r_coord, c_coord] = indicator_color
        # Randomly rotate the object so that we get a variety of orientations
        if np.random.choice([True, False]):
            green_rectangle = np.rot90(green_rectangle, k=-1)
            r_coord, c_coord = c_coord, r_coord

        # Place the rectangle on the grid
        try:
            _loc = first_free_location(grid, green_rectangle, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        # Check if there is no space for the rectangle
        except:
            return generate_input()
        paste(grid, green_rectangle, r, c, transparent=Color.BLACK, clip=True)


import numpy as np
from typing import *
import random
from arc_utils import Color, collision, contact, draw_line, find_components, paste, random_free_location, random_sprite, translate

# concepts:
# attraction, objects, non-black background

# description:
# In the input you will see a non-black background with a colored rectangle and some colored pixels sprinkled randomly.
# To make the output, draw a horizontal or vertical line connecting each colored pixel to the rectangle (whenever possible: the rectangle and pixel have to be lined up). Color the line the same as the pixel.

def main(input_grid):
    """
    Draw same-colored straight lines from aligned pixels to the largest rectangle on a non-black background.

    Input structure:
    - The background is the most common non-black color.
    - One large monochromatic rectangle and several single colored pixels are present.
    - Some pixels share a row or column with the rectangle.

    Rule:
    - Identify the background, the largest object as the rectangle, and all other objects as pixels.
    - For each pixel, slide in cardinal directions until it contacts the rectangle and the next step would overlap.
    - Draw a line from the pixel to that contact point using the pixel color.

    Key insight:
    - A pixel connects only when row or column alignment lets it reach the rectangle by straight motion.
    """
    # Plan:
    # 1. Find the background color
    # 2. Extract objects, separating the pixels from the rectangle
    # 3. For each pixel, draw a line to the rectangle

    # The background is the most common color
    background = np.bincount(input_grid.flatten()).argmax()

    objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=True, return_format="objects")
    # The rectangle is the largest object
    rectangle_object = max(objects, key=lambda obj: np.sum(obj != background))
    # The pixels are the rest
    pixel_objects = [obj for obj in objects if obj is not rectangle_object]

    for pixel_object in pixel_objects:
        for r, c in np.argwhere(pixel_object != background):
            pixel_color = pixel_object[r, c]

            # Check if the pixel is on a horizontal or vertical line with the rectangle
            # Do this by trying to move the pixel up/down/left/right by different amounts until there is contact
            # After finding contact, double check that going one step further would lead to overlap (collision) to avoid glancing contact
            for dr, dc in [(0, 1), (1, 0), (0, -1), (-1, 0)]: # up, right, down, left
                for distance in range(max(input_grid.shape)):
                    translated_pixel = translate(pixel_object, distance * dr, distance * dc, background=background)
                    if contact(object1=translated_pixel, object2=rectangle_object, background=background) and\
                        collision(object1=translate(pixel_object, (distance + 1) * dr, (distance + 1) * dc, background=background), object2=rectangle_object, background=background):
                        # Draw the line
                        end_r, end_c = r + distance * dr, c + distance * dc
                        draw_line(input_grid, r, c, end_r=end_r, end_c=end_c, color=pixel_color)
                        break
    
    return input_grid
                


def generate_input():
    # Plan:
    # 1. Pick different colors for the background, rectangle, and pixels
    # 2. Randomly place the rectangle
    # 3. Randomly place the pixels
    # 4. Check that at least one pixel will make a line to the rectangle

    background_color, rectangle_color, pixel_color = np.random.choice(Color.NOT_BLACK, size=3, replace=False)
    width, height = np.random.randint(7, 20, size=2)

    input_grid = np.full((width, height), fill_value=background_color)

    rectangle_width, rectangle_height = np.random.randint(2, width//2), np.random.randint(2, height//2)
    rectangle_sprite = random_sprite(rectangle_width, rectangle_height, color_palette=[rectangle_color], density=1)
    rectangle_r, rectangle_c = random_free_location(
        input_grid,
        rectangle_sprite,
        transparent=background_color,
        border=1,
        padding=1,
        padding_connectivity=8,
    )
    paste(input_grid, rectangle_sprite, rectangle_r, rectangle_c, transparent=background_color, clip=True)

    n_pixels = np.random.randint(2, 8)
    for _ in range(n_pixels):
        pixel_sprite = random_sprite(1, 1, color_palette=[pixel_color], density=1)
        try:
            pixel_r, pixel_c = random_free_location(
                input_grid,
                pixel_sprite,
                transparent=background_color,
                border=1,
                padding=1,
                padding_connectivity=8,
            )
        except ValueError:
            break
        paste(input_grid, pixel_sprite, pixel_r, pixel_c, transparent=background_color, clip=True)
    
    # Check that at least one pixel shares an X or Y coordinate with the rectangle
    rectangle_coordinates = np.argwhere(input_grid == rectangle_color)
    pixel_coordinates = np.argwhere(input_grid == pixel_color)
    rectangle_xs, rectangle_ys = set(rectangle_coordinates[:, 0]), set(rectangle_coordinates[:, 1])
    pixel_xs, pixel_ys = set(pixel_coordinates[:, 0]), set(pixel_coordinates[:, 1])
    if not (rectangle_xs & pixel_xs) and not (rectangle_ys & pixel_ys):
        return generate_input()
    
    return input_grid
def main(grid: np.ndarray) -> np.ndarray:
    """
    Expand each colored control pixel into its corresponding fixed 4x4 glyph.

    Input structure:
    - Black background with single-pixel markers in colors 2, 3, 5, and/or 8.
    - Some inputs also show a sample 4x4 glyph in the output color, with a same-rule marker just below-right of the sample.

    Rule:
    - Replace each marker color by its learned 4x4 glyph: 2->yellow frame, 3->blue ring, 5->pink diagonal blocks, 8->orange X.
    - Paint each glyph with its top-left corner at the marker pixel, clipping at the grid boundary.
    - Remove the sample glyphs and skip their below-right label markers.

    Key insight:
    - The colored pixels are control pixels for a fixed glyph alphabet; non-control sample glyphs are only legend entries, not preserved scene objects.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    assert set(np.unique(g)).issubset({0, *GLYPHS.keys(), 1, 4, 6, 7})

    out = np.zeros_like(g)
    seen_marker = False
    for marker_color, (glyph_color, mask) in GLYPHS.items():
        coords = np.argwhere(g == marker_color)
        if coords.size:
            seen_marker = True
        for r, c in coords:
            # Legend labels appear one cell below-right of the sample glyph bbox.
            if _has_source_glyph(g, int(r) - 4, int(c) - 4, glyph_color, mask):
                continue
            _paint_clipped(out, int(r), int(c), glyph_color, mask)

    assert seen_marker
    return out
def main(grid: np.ndarray) -> np.ndarray:
    """Move the colored object from the lower bracket lane to the upper bracket lane and drop it to the bottom edge.

    Input structure
    - The background is the dominant color.
    - One frame color forms exactly two 4-connected bracket objects: a top-edge bracket open downward and a bottom-edge bracket open upward.
    - One other 4-connected foreground object sits in the lower bracket's interior column span.

    Rule
    - Remove the movable object from its original cells.
    - Keep its shape and color unchanged.
    - Paste it with its bbox columns aligned to the top bracket's interior columns and with its bbox bottom aligned to the grid bottom.

    Key insight
    - The lower bracket identifies the object's source lane; the upper bracket provides the target lane, and the final vertical placement is bottom-aligned.
    """
    g = np.asarray(grid, dtype=int)
    height, width = g.shape
    bg = get_bg(g)

    components_by_color = {}
    bracket_candidates = []
    for color in colors_present(g, exclude={bg}):
        components = find_components(
            g,
            bg=bg,
            colors=[color],
            connectivity=4,
            monochromatic=True,
        )
        components_by_color[color] = components
        top = [component for component in components if _is_top_bracket(component)]
        bottom = [
            component for component in components
            if _is_bottom_bracket(component, height)
        ]
        if len(components) == 2 and len(top) == 1 and len(bottom) == 1:
            bracket_candidates.append((color, top[0], bottom[0]))

    assert len(bracket_candidates) == 1
    frame_color, top_bracket, bottom_bracket = bracket_candidates[0]

    movers = [
        component
        for color, components in components_by_color.items()
        if color != frame_color
        for component in components
    ]
    assert len(movers) == 1
    mover = movers[0]

    _, mc0, _, mc1 = mover["bbox"]
    _br0, bc0, _br1, bc1 = bottom_bracket["bbox"]
    _tr0, tc0, _tr1, tc1 = top_bracket["bbox"]
    assert (mc0, mc1) == (bc0 + 1, bc1 - 1)
    assert bbox_w(mover["bbox"]) == tc1 - tc0 - 1

    patch = crop_bbox(g, mover["bbox"])
    dest_r = height - patch.shape[0]
    dest_c = tc0 + 1
    assert dest_r >= 0
    assert dest_c >= 0 and dest_c + patch.shape[1] <= width

    out = g.copy()
    mover_coords = mover["coords"]
    out[mover_coords[:, 0], mover_coords[:, 1]] = bg

    colored_patch = patch != bg
    target = out[dest_r:dest_r + patch.shape[0], dest_c:dest_c + patch.shape[1]]
    assert np.all(target[colored_patch] == bg)

    paste(out, patch, dest_r, dest_c, transparent=bg)
    return out

# --------------- generator (o5x) ---------------

# Fixed task colors.
BG_COLOR, BRACKET_COLOR = 7, 4
MOVER_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]

