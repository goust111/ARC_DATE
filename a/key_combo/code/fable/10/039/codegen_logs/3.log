        i = random.choice(options)
        sizes[i] += 1
        extra -= 1
    random.shuffle(sizes)
    return sizes


def _gen_place_coords(grid, blocked, coords, color):
    h, w = grid.shape
    patch_h = int(coords[:, 0].max()) + 1
    patch_w = int(coords[:, 1].max()) + 1
