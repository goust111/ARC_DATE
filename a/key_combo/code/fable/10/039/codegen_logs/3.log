spec:
  grid: 5-10 rows x 5-10 cols, black background
  colors: input uses only BLACK and BLUE; output adds RED
  bars:
    count: 2-5 horizontal dashed bars per grid
    structure: each bar is a sequence of BLUE pixels at every-other column on a single row (cols spaced by 2), creating 1-cell BLACK gaps between consecutive BLUE pixels
    blue_pixels_per_bar: 2-4
    span: 2*blue_count - 1 columns (3, 5, or 7)
    placement: at most 1 bar per row; bar must fit within grid width
    bar_can_touch_edge: yes (column 0 or W-1 allowed)
  row_layout:
    occupied_rows: 40-50% of total rows contain a bar [observed]
    gap_between_bar_rows: 1-3 empty rows between consecutive bar rows
  transform:
    rule: fill every BLACK cell whose immediate left AND right neighbors are BLUE with RED
    effect: gaps inside each dashed bar become RED; all other cells unchanged

generation_strategy:
  approach: direct construction (task is simple enough)
  steps:
    1. Pick grid size H x W in [5,10]
    2. Pick number of bars N in [2, 5]
    3. Select N distinct rows for bars, ensuring gaps of 1-3 between consecutive bar rows
    4. For each bar row, pick blue_count in [2,4], compute span = 2*blue_count-1, pick random start_col in [0, W-span], place BLUE at start_col, start_col+2, ..., start_col+span-1
    5. Verify at least 1 gap exists (guaranteed since every bar has >=2 blue pixels)
