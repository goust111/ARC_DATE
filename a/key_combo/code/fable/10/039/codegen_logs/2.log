+        origins.setdefault(id(piece), (piece.top, piece.left))
+    return origins
+
+
+def _render_grid(shape: tuple[int, int], tabs: dict[str, dict[int, int]], pieces: list[Piece], origins: dict[int, tuple[int, int]]) -> np.ndarray:
