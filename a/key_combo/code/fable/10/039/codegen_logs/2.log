+        color=int(color),
+        side=side,
+        depth=int(depth),
+        offset=int(offset),
+        top=int(top),
+        left=int(left),
+        height=int(height),
+        width=int(width),
+        mask=_shape_mask(int(height), int(width), side, int(depth), int(offset)),
+        tag=tag,
+    )
+
+
+def _border_color(grid: np.ndarray) -> int:
