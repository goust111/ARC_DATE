+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+MOVE_BY_SIDE = {
