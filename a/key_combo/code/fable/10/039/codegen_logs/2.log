+    return None
+
+
+def _sample_pair(side: str, colors: tuple[int, int], shape: tuple[int, int], tag: str) -> list[Piece] | None:
+    h, w = shape
+    for _ in range(120):
+        height, width, depth, offset = _sample_dims(side)
