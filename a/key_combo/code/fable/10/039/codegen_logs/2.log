+    origins = _simulate_origins(g.shape, g == wall, pieces, movable_ids)
+    out = np.full_like(g, bg)
+    out[g == wall] = wall
+    for piece in pieces:
+        top, left = origins[id(piece)]
+        region = out[top : top + piece.height, left : left + piece.width]
+        region[piece.mask] = piece.color
