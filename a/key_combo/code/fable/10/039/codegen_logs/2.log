+def _shape_mask(height: int, width: int, side: str, depth: int, offset: int) -> np.ndarray:
+    mask = np.ones((height, width), dtype=bool)
+    if side == "top":
+        mask[:depth, offset] = False
+    elif side == "bottom":
+        mask[height - depth :, offset] = False
+    elif side == "left":
+        mask[offset, :depth] = False
+    elif side == "right":
+        mask[offset, width - depth :] = False
+    else:
+        raise ValueError(side)
+    return mask
+
+
+def _make_piece(
+    color: int,
+    side: str,
+    depth: int,
+    offset: int,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    tag: str = "",
+) -> Piece:
+    return Piece(
+        color=int(color),
+        side=side,
+        depth=int(depth),
+        offset=int(offset),
+        top=int(top),
+        left=int(left),
+        height=int(height),
+        width=int(width),
+        mask=_shape_mask(int(height), int(width), side, int(depth), int(offset)),
