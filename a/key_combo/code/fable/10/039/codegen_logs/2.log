    if include_pair:
        pair_side = side_pool.pop()
        used_sides.append(pair_side)
        pair_pieces = mod._sample_pair(pair_side, (colors.pop(), colors.pop()), shape, 'pair0')
        if pair_pieces is None:
            counter['pair_sample_none'] += 1
            continue
        pieces.extend(pair_pieces)
        metas.append({'piece': pair_pieces[0], 'outcome': 'pair_front', 'pair_tag': 'pair0'})
        metas.append({'piece': pair_pieces[1], 'outcome': 'pair_back', 'pair_tag': 'pair0'})
    match_side = side_pool.pop() if side_pool else random.choice(mod.SIDES)
    used_sides.append(match_side)
    match_piece = mod._sample_single(match_side, colors.pop(), shape, 'single_match')
    if match_piece is None:
        counter['match_single_none'] += 1
        continue
    pieces.append(match_piece)
    metas.append({'piece': match_piece, 'outcome': 'match'})
    stay_side = side_pool.pop() if side_pool else random.choice([side for side in mod.SIDES if side not in used_sides] or mod.SIDES)
    used_sides.append(stay_side)
    stay_piece = mod._sample_single(stay_side, colors.pop(), shape, 'single_stay')
    if stay_piece is None:
        counter['stay_single_none'] += 1
        continue
    pieces.append(stay_piece)
    metas.append({'piece': stay_piece, 'outcome': random.choice(('mismatch', 'absent'))})
    if side_pool and random.random() < 0.7:
        extra_side = side_pool.pop()
        extra_piece = mod._sample_single(extra_side, colors.pop(), shape, 'single_extra')
        if extra_piece is None:
            counter['extra_single_none'] += 1
            continue
        pieces.append(extra_piece)
        metas.append({'piece': extra_piece, 'outcome': random.choice(('match', 'mismatch', 'absent'))})
    boxes = [piece.bbox() for piece in pieces]
    bad = False
    for i, box_a in enumerate(boxes):
        for j in range(i + 1, len(boxes)):
            if not mod._boxes_clear(box_a, boxes[j], pad=1):
                counter['boxes_overlap'] += 1
                bad = True
                break
        if bad:
            break
    if bad:
        continue
    tabs = mod._build_tabs(shape, metas)
    if tabs is None:
        counter['tabs_none'] += 1
        continue
    movable_ids = {id(meta['piece']) for meta in metas if meta['outcome'] in ('match', 'pair_front', 'pair_back')}
    wall_only = mod._render_grid(shape, tabs, [], {})
    origins = mod._simulate_origins(shape, wall_only == mod.WALL, pieces, movable_ids)
    expected = mod._render_grid(shape, tabs, pieces, origins)
    inp = mod._render_grid(shape, tabs, pieces, {id(piece): (piece.top, piece.left) for piece in pieces})
    if not mod._semantic_checks(inp, expected, pieces, metas, tabs):
        counter['semantic_fail'] += 1
        continue
    counter['success'] += 1
print(counter)
