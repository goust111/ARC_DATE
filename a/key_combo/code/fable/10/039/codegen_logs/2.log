+def _dock_origin(piece: Piece, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    if piece.side == "top":
+        return (1, piece.left)
+    if piece.side == "bottom":
+        return (h - 1 - piece.height, piece.left)
+    if piece.side == "left":
+        return (piece.top, 1)
+    return (piece.top, w - 1 - piece.width)
