0139:     assert len(fg_colors) == 1, "task expects a single foreground color"
0140:     fg = fg_colors[0]
0141: 
0142:     mask = g == fg
0143:     out = g.copy()
0144: 
0145:     tabs = _tab_sources(mask)
0146:     tab_cells = {cell for cell, _direction, _target in tabs}
0147:     changes = 0
0148: 
0149:     for _cell, _direction, target in tabs:
0150:         if out[target] != bg:
0151:             out[target] = bg
0152:             changes += 1
0153: 
0154:     for r in range(g.shape[0]):
0155:         for c in range(g.shape[1]):
0156:             if bool(mask[r, c]):
0157:                 continue
0158: 
0159:             fg_dirs: list[tuple[int, int]] = []
0160:             bg_dirs: list[tuple[int, int]] = []
0161:             for dr, dc in DIRS4:
0162:                 rr, cc = r + dr, c + dc
0163:                 if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):
0164:                     fg_dirs.append((dr, dc))
