+    pair_meta = []
+    left_phantoms: list[set[tuple[int, int]]] = []
+    right_phantoms: list[set[tuple[int, int]]] = []
+
+    grid = np.full((h, w), YELLOW, dtype=int)
+    grid[:, axis] = GREY
+    grid[:, axis + 1 :] = GREEN
+
+    for state in states:
