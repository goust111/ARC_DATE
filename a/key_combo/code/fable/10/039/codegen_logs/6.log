+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(*_GEN_HEIGHT_RANGE))
+    panel_w = int(rng.integers(*_GEN_PANEL_WIDTH_RANGE))
