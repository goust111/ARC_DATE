0168:             if len(fg_dirs) != 3 or len(bg_dirs) != 1:
0169:                 continue
0170: 
0171:             outside_dr, outside_dc = bg_dirs[0]
0172:             dr, dc = -outside_dr, -outside_dc
0173:             side_a = (r - dc, c + dr)
0174:             side_b = (r + dc, c - dr)
