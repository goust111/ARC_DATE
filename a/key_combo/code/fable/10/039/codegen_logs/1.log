+    _validate_scene(inp, scene_h, rect_specs, placements, mapping)
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        pair = _attempt_generate()
+        if pair is not None:
+            return pair[0]
