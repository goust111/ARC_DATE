+    out = g.copy()
+    for coords in comps:
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        r0 = int(r0)
+        c0 = int(c0)
+        r1 = int(r1)
+        c1 = int(c1)
