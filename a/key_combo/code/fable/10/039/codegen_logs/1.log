+    if pair_key in mirror_pair_keys:
+        continue
+    mirror_pair_keys.add(pair_key)
+    ASYMMETRIC_MIRROR_PAIRS.append((MASK_BY_KEY[pair_key[0]], MASK_BY_KEY[pair_key[1]]))
+
