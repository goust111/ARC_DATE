+BG = 0
+NON_BG = tuple(range(1, 10))
+DICT_GLYPH_SIZE = 3
+DICT_GAP_ROW = 1
+DICT_ZONE_HEIGHT = 5
+SCENE_SEPARATOR_ROWS = 1
+MAX_GENERATION_ATTEMPTS = 400
