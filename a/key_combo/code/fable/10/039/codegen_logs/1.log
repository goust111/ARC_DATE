+    out = g.copy()
+    for coords in comps:
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        r0 = int(r0)
+        c0 = int(c0)
+        r1 = int(r1)
+        c1 = int(c1)
+        key = _rectangle_hole_key(scene, coords)
+        assert key in mapping, "every rectangle hole must match a dictionary glyph"
+        out[r0 : r1 + 1, c0 : c1 + 1] = mapping[key]
