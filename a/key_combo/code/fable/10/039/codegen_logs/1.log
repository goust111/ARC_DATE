+    color = next(iter(colors))
+    assert np.all(patch[0, :] == color)
+    assert np.all(patch[-1, :] == color)
+    assert np.all(patch[:, 0] == color)
+    assert np.all(patch[:, -1] == color)
+    assert np.all((patch == BG) | (patch == color))
+    hole_mask = patch == BG
+    assert np.any(hole_mask), "rectangle must contain at least one hole"
