+    dict_top, label_row, mapping, _label_cols = _parse_dictionary(g)
+    scene = g[: max(dict_top - SCENE_SEPARATOR_ROWS, 0), :]
+    comps = _components(scene != BG)
+    assert len(comps) >= 2, "expected multiple scene rectangles"
