+    for spec in rect_specs:
+        spec["label_color"] = mapping[_mask_key(spec["mask"])]
+
+    width = random.randint(max(16, entry_count * 5 + 2), 30)
+    scene_h = random.randint(9, 24)
+    height = scene_h + SCENE_SEPARATOR_ROWS + DICT_ZONE_HEIGHT
+    if height > 30:
+        return None
+
