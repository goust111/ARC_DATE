+        for r0, c0 in candidates:
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            ok = True
+            for or0, oc0, or1, oc1 in boxes:
+                if not (box[2] + 2 < or0 or or1 + 2 < box[0] or box[3] + 2 < oc0 or oc1 + 2 < box[1]):
