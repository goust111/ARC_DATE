def _gen_render_pair(prototype_mask, other_masks, matching, connectors, nonmatch_masks):
    output = np.zeros(_GEN_GRID_SHAPE, dtype=int)
    input_grid = np.zeros(_GEN_GRID_SHAPE, dtype=int)
