GEN_DEFAULT_TILES_MIN, GEN_DEFAULT_TILES_MAX = 8, 22
GEN_ROW_SPAN_MIN, GEN_ROW_SPAN_MAX = 2, 3
GEN_COL_SPAN_MIN, GEN_COL_SPAN_MAX = 1, 3

