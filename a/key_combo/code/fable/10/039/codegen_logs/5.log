+        return vec, int(d)
+    raise ValueError(side)
+
+
+def _paste_mask(dst: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> None:
+    h, w = mask.shape
+    block = dst[r0 : r0 + h, c0 : c0 + w]
+    block[mask] = int(color)
+
