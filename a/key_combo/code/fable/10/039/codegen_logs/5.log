+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            bbox = _bbox_from_coords(coords)
+            comps.append({"color": color, "coords": coords, "bbox": bbox})
+    return comps
+
+
+def _mask_from_component(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in comp["coords"]:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _classify(grid: np.ndarray):
+    bg = _get_bg(grid)
+    sprites = []
+    lines = []
+    for comp in _find_components(grid, bg):
+        r0, c0, r1, c1 = comp["bbox"]
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        item = {
+            "color": comp["color"],
+            "bbox": comp["bbox"],
+            "mask": _mask_from_component(comp),
+            "h": hh,
+            "w": ww,
+        }
+        if hh > 1 and ww > 1:
+            sprites.append(item)
+        elif hh == 1 or ww == 1:
+            lines.append(item)
+    return bg, sprites, lines
+
+
+def _edge_pattern(mask: np.ndarray, side: str) -> np.ndarray:
+    if side == "left":
+        return mask[:, 0].copy()
+    if side == "right":
+        return mask[:, -1].copy()
+    if side == "top":
+        return mask[0, :].copy()
+    if side == "bottom":
+        return mask[-1, :].copy()
+    raise ValueError(side)
+
+
+def _line_pattern_for_side(sprite: dict, line: dict, side: str) -> tuple[np.ndarray, int] | None:
+    r0, c0, r1, c1 = sprite["bbox"]
+    lr0, lc0, lr1, lc1 = line["bbox"]
+    if side in {"left", "right"}:
+        if lc0 != lc1:
+            return None
+        if lr0 < r0 or lr1 > r1:
+            return None
+        vec = np.zeros(sprite["h"], dtype=bool)
+        vec[lr0 - r0 : lr1 - r0 + 1] = True
+        d = c0 - lc0 if side == "left" else lc0 - c1
+        return vec, int(d)
+    if side in {"top", "bottom"}:
+        if lr0 != lr1:
+            return None
+        if lc0 < c0 or lc1 > c1:
+            return None
+        vec = np.zeros(sprite["w"], dtype=bool)
+        vec[lc0 - c0 : lc1 - c0 + 1] = True
