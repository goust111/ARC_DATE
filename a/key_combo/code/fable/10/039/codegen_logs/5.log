+        out = np.zeros((h, w), dtype=int)
+        for (r, c), group in zip(placements, groups):
+            ph, pw = group["input"].shape
+            inp[r : r + ph, c : c + pw] = group["input"]
+            out[r : r + ph, c : c + pw] = group["output"]
