GEN_COLORS = range(1, 10)
GEN_PERIODS, GEN_INTERIOR_SIZES = range(5, 8), range(1, 4)
GEN_TILE_ROWS, GEN_TILE_COLS = range(4, 6), range(4, 7)
GEN_HEIGHT_MIN, GEN_HEIGHT_MAX = 23, 30
GEN_WIDTH_MIN, GEN_WIDTH_MAX = 28, 30
