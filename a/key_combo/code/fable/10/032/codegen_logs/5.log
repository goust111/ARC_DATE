+        r0, c0, r1, c1 = bbox
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+        patch[coords[:, 0] - r0, coords[:, 1] - c0] = color
+        objects[color] = {"bbox": bbox, "patch": patch, "coords": coords}
+    return objects
+
