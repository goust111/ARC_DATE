+
+def _disjoint_when_aligned(patch_a: np.ndarray, patch_b: np.ndarray, bg: int) -> bool:
+    h = max(patch_a.shape[0], patch_b.shape[0])
+    w = max(patch_a.shape[1], patch_b.shape[1])
