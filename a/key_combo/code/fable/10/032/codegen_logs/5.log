from itertools import combinations

cells = [(r,c) for r in range(4) for c in range(4)]

def norm(shape):
    rmin = min(r for r,c in shape)
    cmin = min(c for r,c in shape)
    return tuple(sorted((r-rmin,c-cmin) for r,c in shape))

def connected(shape):
    shape = set(shape)
    stack = [next(iter(shape))]
    seen = {stack[0]}
    while stack:
        r,c = stack.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (nr,nc) in shape and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(shape)

def bbox(shape):
    rs=[r for r,c in shape]; cs=[c for r,c in shape]
    return max(rs)+1,max(cs)+1

shapes=[]; seen=set()
for k in range(2,7):
    for comb in combinations(cells,k):
        if not connected(comb):
            continue
        s=norm(comb)
        if s in seen:
            continue
        h,w=bbox(s)
        if h<=4 and w<=4:
            seen.add(s); shapes.append(s)
print('shapes',len(shapes))

def disjoint(a,b):
    return set(a).isdisjoint(set(b))
count=0
for i,a in enumerate(shapes):
    for j,b in enumerate(shapes):
        if i>=j: continue
        if disjoint(a,b):
            count+=1
            print('found',a,b)
            raise SystemExit
print('none',count)
