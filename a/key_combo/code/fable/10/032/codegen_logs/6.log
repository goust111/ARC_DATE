+
+def _make_obstacle_mask(h: int, w: int) -> np.ndarray | None:
+    obs_h = random.randint(*OBSTACLE_ROWS_RANGE)
+    obs_w = random.randint(*OBSTACLE_COLS_RANGE)
+    if obs_h + 2 * EDGE_MARGIN > h or obs_w + 2 * EDGE_MARGIN > w:
+        return None
