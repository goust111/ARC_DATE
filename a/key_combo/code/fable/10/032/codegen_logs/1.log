30: def main(grid: np.ndarray) -> np.ndarray:
31:     """Expand the second mask into a block grid by stamping the first mask with the two payload colors.
32: 
33:     Input structure
34:     - A background grid has four panels separated by three full-height separator columns.
35:     - The first two panels contain same-size binary masks; the last two contain solid same-size color squares.
36:     Rule
37:     - Use the second mask as an outer layout. For each foreground cell in that outer mask, place a tile equal to the first mask, coloring its foreground with the first solid-square color and its background with the second solid-square color; outer background cells become all second solid-square color.
38:     Key insight
39:     - The output is the Kronecker product of the two binary masks, with the two right-hand panel colors providing the palette.
40:     """
41:     g = np.asarray(grid, dtype=int)
42:     h, w = g.shape
43:     bg = _unique_dominant_color(g)
44: 
45:     sep_cols = [
