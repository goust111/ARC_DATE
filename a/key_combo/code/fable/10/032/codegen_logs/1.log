29: def main(grid: np.ndarray) -> np.ndarray:
30:     """Crop out the unique region marked by a complete monochrome rectangular frame.
31: 
32:     Input structure
33:     The input is a larger patterned grid containing exactly one color whose pixels
34:     form the full perimeter of a rectangle and appear nowhere else.
35: 
36:     Rule
37:     Find that complete rectangular frame and return the input cells inside its
38:     bounding box, including the frame itself.
39: 
40:     Key insight
41:     The wanted output is not rebuilt from the repeated background pattern; it is
42:     the exact subgrid selected by the only color that forms a complete frame.
43:     """
44:     g = np.asarray(grid, dtype=int)
45:     r0, c0, r1, c1 = _complete_frame_bbox(g)
46:     return g[r0 : r1 + 1, c0 : c1 + 1].copy()
