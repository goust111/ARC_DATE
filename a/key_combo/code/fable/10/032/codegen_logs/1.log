52: BLOCK_SIZES = [2, 5]
53: CONTENT_COUNTS = [2, 3]
54: FRAME_SIDES = [6, 7]
55: # Palette and basis-vector sampling.
56: COLOR_POOL = np.arange(1, 10)
57: BACKGROUND_COLOR = 0
58: PALETTE_EXTRA_COLORS = 2
59: ZERO_PREFIX_POSITIONS = (0, 1)
60: BG_WEIGHT_FLOOR_RANGE = (0.20, 0.45)
61: FORCED_CONTENT_BLOCK_DRAWS = 2
62: # Retry budget.
63: GENERATION_RETRIES = 300
