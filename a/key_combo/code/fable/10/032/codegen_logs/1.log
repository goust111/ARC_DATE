+    (1, 0): np.array([[1, 1, 1], [1, 0, 1], [1, 0, 1]], dtype=bool),
+    (0, -1): np.array([[1, 1, 1], [0, 0, 1], [1, 1, 1]], dtype=bool),
+    (0, 1): np.array([[1, 1, 1], [1, 0, 0], [1, 1, 1]], dtype=bool),
