+    seen: set[int] = set()
+    current = first
+    while True:
+        assert current not in seen, "frame pointer chain must be acyclic"
+        seen.add(current)
+        order.append(current)
+        nxt = _ray_hit(frames[current].gap, frames[current].direction, shape, border_to_frame)
+        if nxt is None:
+            return order
+        current = nxt
