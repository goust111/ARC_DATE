49:     ]
50:     assert len(sep_cols) == 3
51:     sep_colors = {int(g[0, c]) for c in sep_cols}
52:     assert len(sep_colors) == 1
53: 
54:     cuts = [-1, *sep_cols, w]
55:     spans = [(cuts[i] + 1, cuts[i + 1]) for i in range(4)]
56:     assert all(c0 < c1 for c0, c1 in spans)
57: 
58:     masks: list[np.ndarray] = []
59:     colors: list[int] = []
60:     for c0, c1 in spans:
61:         mask, color = _extract_panel_mask(g[:, c0:c1], bg)
