63:         colors.append(color)
64: 
65:     n = masks[0].shape[0]
66:     assert n > 0
67:     assert h == n + 2
68:     assert all(mask.shape == (n, n) for mask in masks)
69:     assert masks[2].all()
70:     assert masks[3].all()
71:     assert colors[2] != colors[3]
72: 
73:     painted = np.kron(masks[1], masks[0])
74:     out = np.full((n * n, n * n), colors[3], dtype=int)
75:     out[painted] = colors[2]
