6: def main(grid: np.ndarray) -> np.ndarray:
7:     """Move each solid colored rectangle upward by exactly its own height.
8: 
9:     Input structure
10:     A black-background grid contains one or more separated monochromatic
11:     foreground objects. Each object is a solid axis-aligned rectangle, with an
12:     equally sized empty region immediately above it.
13: 
14:     Rule
15:     Clear every rectangle from its original position, then paste the same
16:     rectangle directly above that position, offset upward by the rectangle's
17:     height.
18: 
19:     Key insight
20:     The vertical displacement is not shared globally: each rectangle jumps by
21:     its own bbox height, so its new bottom edge is just above its old top edge.
22:     """
23:     g = np.asarray(grid, dtype=int)
24:     bg = get_bg(g)
25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
26:     assert comps, "expected at least one foreground rectangle"
27: 
28:     moves = []
29:     target_mask = np.zeros(g.shape, dtype=bool)
30:     for comp in comps:
31:         color = int(comp["color"])
32:         r0, c0, r1, c1 = comp["bbox"]
33:         h = bbox_h(comp["bbox"])
34:         w = c1 - c0 + 1
35:         assert int(comp["area"]) == h * w, "foreground object must fill its bbox"
36: 
37:         patch = crop_bbox(g, comp["bbox"])
38:         assert np.all(patch == color), "rectangle must be monochromatic and solid"
39: 
40:         dst_r0 = r0 - h
41:         assert dst_r0 >= 0, "rectangle must fit above its original position"
42:         assert np.all(g[dst_r0:r0, c0 : c1 + 1] == bg), "destination must be empty"
43: 
44:         target = target_mask[dst_r0 : dst_r0 + h, c0 : c1 + 1]
45:         assert not np.any(target), "shifted rectangles must not overlap"
46:         target[:, :] = True
47:         moves.append((comp["coords"], patch, dst_r0, c0))
48: 
49:     out = g.copy()
50:     for coords, _patch, _dst_r0, _c0 in moves:
51:         out[coords[:, 0], coords[:, 1]] = bg
52:     for _coords, patch, dst_r0, c0 in moves:
53:         paste(out, patch, dst_r0, c0)
54:     return out
