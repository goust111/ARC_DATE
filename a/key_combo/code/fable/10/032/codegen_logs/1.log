78: def _gen_background_from_vector(v: np.ndarray, order: list[int]) -> np.ndarray:
79:     ranks = np.zeros(len(COLOR_POOL) + 1, dtype=int)
80:     for i, color in enumerate(order):
81:         ranks[color] = i
82: 
83:     vr = ranks[v]
84:     choose_row = vr[:, None] >= vr[None, :]
85:     return np.where(choose_row, v[:, None], v[None, :]).astype(int)
