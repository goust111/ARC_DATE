88: def _gen_fill_basis_vector(
89:     n: int, k: int, content_colors: list[int], sep_color: int
90: ) -> np.ndarray:
91:     v = np.full(n, BACKGROUND_COLOR, dtype=int)
92:     sep_positions = set(range(k, n, k + 1))
93:     for pos in sep_positions:
94:         v[pos] = sep_color
95: 
96:     choices = np.array([BACKGROUND_COLOR] + content_colors, dtype=int)
97:     weights = np.random.dirichlet(np.ones(len(choices)))
98:     weights[0] = max(weights[0], np.random.uniform(*BG_WEIGHT_FLOOR_RANGE))
99:     weights = weights / weights.sum()
100: 
101:     blocks: list[list[int]] = []
102:     for start in range(0, n, k + 1):
103:         block = [pos for pos in range(start, min(start + k, n)) if pos not in sep_positions]
104:         if block:
105:             blocks.append(block)
106:             for pos in block:
107:                 if pos not in ZERO_PREFIX_POSITIONS:
108:                     v[pos] = int(np.random.choice(choices, p=weights))
109: 
110:     usable_blocks = [[pos for pos in block if pos not in ZERO_PREFIX_POSITIONS] for block in blocks]
111:     usable_blocks = [block for block in usable_blocks if block]
112:     for color in content_colors:
113:         replace = len(usable_blocks) < FORCED_CONTENT_BLOCK_DRAWS
114:         block_ids = np.random.choice(len(usable_blocks), size=FORCED_CONTENT_BLOCK_DRAWS, replace=replace)
115:         for block_id in np.atleast_1d(block_ids):
116:             pos = int(np.random.choice(usable_blocks[int(block_id)]))
117:             v[pos] = color
118: 
119:     for pos in ZERO_PREFIX_POSITIONS:
120:         v[pos] = BACKGROUND_COLOR
121:     return v
