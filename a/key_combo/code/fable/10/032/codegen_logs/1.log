+def _frame_candidate(comp: dict, color_counts: Counter[int], grid: np.ndarray) -> Frame | None:
+    if color_counts[int(comp["color"])] != int(comp["area"]):
+        return None
+    color = int(comp["color"])
+    r0, c0, r1, c1 = comp["bbox"]
