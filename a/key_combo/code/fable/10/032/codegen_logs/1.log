65: def _gen_sample_palette(content_count: int) -> tuple[list[int], int, int, list[int]]:
66:     """Return content, separator, frame, and rank-order colors."""
67:     colors = np.random.choice(COLOR_POOL, size=content_count + PALETTE_EXTRA_COLORS, replace=False)
68:     content_colors = [int(x) for x in colors[:content_count]]
69:     sep_color = int(colors[content_count])
70:     frame_color = int(colors[content_count + 1])
71: 
72:     content_order = content_colors[:]
73:     np.random.shuffle(content_order)
74:     order = [BACKGROUND_COLOR] + content_order + [sep_color]
75:     return content_colors, sep_color, frame_color, order
