+            if size_a > size_b and area_a < area_b:
+                return True
+    return False
+
+
+def _build_attempt(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    n_rows, n_cols = LAYOUTS[int(rng.integers(len(LAYOUTS)))]
