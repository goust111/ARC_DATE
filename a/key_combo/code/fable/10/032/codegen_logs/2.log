spec:
  grid: 20-26 rows x 20-26 cols (square)
  background: 0
  colors: 4 distinct non-zero colors; 2 source + 2 halo, disjoint sets
  legend:
    count: 2 markers (one per source color)
    structure: each is a 2x2 block at cols 0-1; left column = source color, right = halo color
    position: bottom-left of grid; last marker ends at final row; gap of 3 rows between markers [observed]
  objects:
    template: each source color has one 5x5 template shape, 4-connected, monochrome
    symmetry: LR-symmetric [observed]
    area: 12-16 cells within the 5x5 bbox
    holes: 0-3 interior bg cells enclosed by the object (preserved in output)
    instances: 1-3 copies of each template per source color (total objects 3-6)
    same_shape: all instances of a source color use the identical template (may be clipped at grid edge)
  placement:
    objects occupy cols >= 2 (never in marker columns 0-1)
    expanded bboxes (bbox + 1 cell padding, clipped to grid) must not overlap between any two objects
    objects may touch grid edges; edge-clipped objects lose their outermost column/row
  transform:
    for each object, expand its tight bbox by 1 cell (clip to grid bounds)
    fill bg cells in expanded region with the paired halo color
