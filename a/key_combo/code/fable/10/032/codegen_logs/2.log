+    cells: list[tuple[int, int, int, int]] = []
+    for ra, rb in zip(line_rows[:-1], line_rows[1:]):
+        assert rb - ra >= 2
+        for ca, cb in zip(line_cols[:-1], line_cols[1:]):
+            assert cb - ca >= 2
+            cells.append((ra + 1, rb - 1, ca + 1, cb - 1))
