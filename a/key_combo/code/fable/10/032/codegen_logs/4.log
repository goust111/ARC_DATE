        coords = np.argwhere(grid == color)
        r0, c0 = coords.min(axis=0)
        r1, c1 = coords.max(axis=0)
        interior = out[r0 + 1 : r1, c0 + 1 : c1]
        rows, cols = np.indices(interior.shape)
        interior[(rows + cols) % 2 == 0] = 0
    return out


