  "transform": "for each object whose color appears in the legend, fill background pixels in its one-cell padded bbox with the paired legend color; preserve the object and any enclosed background holes",
  "symbol_instructions": "left-edge two-column legend maps object color to bbox-fill color"
}
</annotation>
<generation_spec>
