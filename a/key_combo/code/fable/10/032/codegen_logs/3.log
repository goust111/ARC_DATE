+        _render_kronecker(tile, tile, bg, fg),
+        _render_kronecker(tile, full, bg, fg),
+        _render_kronecker(full, layout, bg, fg),
+    )
+    return all(not np.array_equal(output, shortcut) for shortcut in shortcuts)
