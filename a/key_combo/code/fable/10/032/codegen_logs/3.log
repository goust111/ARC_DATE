    'H':        np.array([[1, 0, 1], [1, 1, 1], [1, 0, 1]], dtype=bool),
    'X':        np.array([[1, 0, 1], [0, 1, 0], [1, 0, 1]], dtype=bool),
    '4corners': np.array([[1, 0, 1], [0, 0, 0], [1, 0, 1]], dtype=bool),
