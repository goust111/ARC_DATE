+            if mode == 3 and not (layout_components == 1 and tile_components == 1):
+                continue
+
+            inp = _render_kronecker(layout, tile, 0, 1)
+            out = _render_kronecker(tile, layout, 0, 1)
+            if np.array_equal(inp, out):
+                continue
+            pairs.append((layout, tile))
+
+    if not pairs:
+        return _pick_pair(np.random.default_rng())
+    choice = int(rng.integers(len(pairs)))
+    return pairs[choice][0].copy(), pairs[choice][1].copy()
