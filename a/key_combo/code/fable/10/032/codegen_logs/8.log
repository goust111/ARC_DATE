+def _build_frame_patch(
+    rng: np.random.Generator,
+    h: int,
+    w: int,
+    frame_color: int,
+    hole_arc: list[tuple[tuple[int, int], str]],
+    palette: list[int],
+) -> tuple[np.ndarray, np.ndarray]:
