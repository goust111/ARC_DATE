+    g = np.asarray(grid, dtype=int)
+    info = _find_unique_solution(g)
+    frame = info["solution"]["frame"]
+    r0, c0, r1, c1 = frame["bbox"]
+    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+    for hr, hc in frame["hole"]:
+        out[hr - r0, hc - c0] = frame["color"]
+    return out
