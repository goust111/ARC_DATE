+    hole_set = set(hole)
+    if len(key_a) + len(key_b) != len(hole_set):
+        return None
+    for hr, hc in hole:
+        for ar, ac in key_a:
+            dr = hr - ar
+            dc = hc - ac
+            placed_a = {(r + dr, c + dc) for r, c in key_a}
+            if len(placed_a) != len(key_a) or not placed_a <= hole_set:
+                continue
+            placed_b = hole_set - placed_a
