+    patch[1:-1, 1:-1] = interior
+    for (r, c), _side in hole_arc:
+        patch[r, c] = 0
+    solved = patch.copy()
+    for (r, c), _side in hole_arc:
+        solved[r, c] = frame_color
+    return patch, solved
+
+
+def _semantic_checks(grid: np.ndarray, expected: np.ndarray, target_hole_area: int) -> bool:
