+        for _ in range(300):
+            r0 = int(rng.integers(0, h - kh + 1))
+            c0 = int(rng.integers(0, w - kw + 1))
+            if not _can_place_box(occupied, r0, c0, kh, kw, pad=1):
+                continue
+            _place_patch(grid, patch, r0, c0)
