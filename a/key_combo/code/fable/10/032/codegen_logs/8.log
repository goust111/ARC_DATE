+            if (i, j) == (ti, tj):
+                continue
+            if keys[i]["area"] + keys[j]["area"] == target_area:
+                same_sum_decoy = True
+    if not same_sum_decoy:
+        return False
+    return True
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
