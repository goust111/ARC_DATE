+
+def _border_cycle(h: int, w: int) -> list[tuple[tuple[int, int], str]]:
+    cycle: list[tuple[tuple[int, int], str]] = []
+    for c in range(w):
+        cycle.append(((0, c), "T"))
+    for r in range(1, h - 1):
+        cycle.append(((r, w - 1), "R"))
+    for c in range(w - 1, -1, -1):
