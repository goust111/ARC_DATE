+        return False
+    pr0 = max(0, r0 - pad)
+    pc0 = max(0, c0 - pad)
+    pr1 = min(hh, r0 + h + pad)
+    pc1 = min(ww, c0 + w + pad)
+    return not bool(occupied[pr0:pr1, pc0:pc1].any())
