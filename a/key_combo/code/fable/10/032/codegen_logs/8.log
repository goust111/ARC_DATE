+
+    for _ in range(int(rng.integers(8, 18))):
+        r = int(rng.integers(h))
+        c = int(rng.integers(w))
+        if grid[r, c] != 0:
+            continue
+        ok = True
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] != 0:
