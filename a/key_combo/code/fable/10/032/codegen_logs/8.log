+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _frame_candidates(grid: np.ndarray, bg: int) -> list[dict]:
+    candidates: list[dict] = []
