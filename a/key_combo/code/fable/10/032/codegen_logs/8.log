+    forbidden_key_shapes.add(key_shapes[-1])
+    key_shapes.append(_sample_shape_not_in(rng, len(key_a), forbidden_key_shapes))
+    forbidden_key_shapes.add(key_shapes[-1])
+    key_shapes.append(_sample_shape_not_in(rng, len(key_b), forbidden_key_shapes))
+    forbidden_key_shapes.add(key_shapes[-1])
