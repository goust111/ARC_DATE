+
+def _shape_patch(shape: tuple[tuple[int, int], ...], color: int) -> np.ndarray:
+    h = max(r for r, _ in shape) + 1
+    w = max(c for _, c in shape) + 1
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in shape:
+        patch[r, c] = color
+    return patch
+
+
+def _sample_shape_not_in(
+    rng: np.random.Generator,
+    area: int,
