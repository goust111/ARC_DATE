+import numpy as np
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _normalize(coords: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = list(coords)
+    r0, c0, _, _ = _bbox(pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _component_list(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _border_cycle(h: int, w: int) -> list[tuple[tuple[int, int], str]]:
+    cycle: list[tuple[tuple[int, int], str]] = []
+    for c in range(w):
+        cycle.append(((0, c), "T"))
+    for r in range(1, h - 1):
+        cycle.append(((r, w - 1), "R"))
+    for c in range(w - 1, -1, -1):
+        cycle.append(((h - 1, c), "B"))
+    for r in range(h - 2, 0, -1):
+        cycle.append(((r, 0), "L"))
+    return cycle
+
+
