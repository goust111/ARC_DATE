+def _key_candidates(grid: np.ndarray, frames: list[dict]) -> list[dict]:
+    keys: list[dict] = []
+    bg = _get_bg(grid)
+    for comp in _component_list(grid, bg):
+        if comp["area"] < 2:
+            continue
+        if not _outside_all_frame_boxes(comp["coords"], frames):
+            continue
+        keys.append(
+            {
+                "color": int(comp["color"]),
+                "coords": comp["coords"],
+                "bbox": comp["bbox"],
+                "shape": _normalize(comp["coords"]),
+                "area": int(comp["area"]),
