+
+def _can_place_box(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> bool:
+    hh, ww = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    pr0 = max(0, r0 - pad)
+    pc0 = max(0, c0 - pad)
+    pr1 = min(hh, r0 + h + pad)
+    pc1 = min(ww, c0 + w + pad)
+    return not bool(occupied[pr0:pr1, pc0:pc1].any())
