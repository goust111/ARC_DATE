+        same_len = [opt for opt in options if len(opt[0]) == target_len]
+        pool = same_len if same_len and rng.random() < 0.7 else options
+        return pool[int(rng.integers(len(pool)))]
+    raise RuntimeError("failed to generate decoy hole")
