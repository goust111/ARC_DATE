+def _outside_all_frame_boxes(coords: list[tuple[int, int]], frames: list[dict]) -> bool:
+    for r, c in coords:
+        for frame in frames:
+            r0, c0, r1, c1 = frame["bbox"]
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                return False
+    return True
+
+
+def _key_candidates(grid: np.ndarray, frames: list[dict]) -> list[dict]:
+    keys: list[dict] = []
