+
+def _place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    mask = patch != 0
+    region = grid[r0 : r0 + h, c0 : c0 + w]
+    region[mask] = patch[mask]
