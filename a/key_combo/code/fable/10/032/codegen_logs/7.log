+    stamp_mask: np.ndarray,
+    bg: int,
+    stamp_color: int,
+) -> np.ndarray:
+    h, w = map(int, select_mask.shape)
+    out = np.full((h * h, w * w), bg, dtype=int)
+    tile = np.full((h, w), bg, dtype=int)
+    tile[stamp_mask] = stamp_color
+
+    for r, c in np.argwhere(select_mask):
+        r0 = int(r) * h
+        c0 = int(c) * w
+        out[r0 : r0 + h, c0 : c0 + w] = tile
+    return out
