+    enriched.update(info)
+    if info["kind"] == "moving":
+        enriched["missing_abs"] = np.array([r0 + info["missing"][0], c0 + info["missing"][1]], dtype=int)
+    return enriched
+
+
+def _try_classify_component(comp: dict) -> dict | None:
+    try:
+        return _classify_component(comp)
+    except AssertionError:
