+
+def _render_input(
+    shape: tuple[int, int],
+    bg: int,
+    static_objects: list[dict],
+    moving_objects: list[dict],
+) -> np.ndarray:
+    grid = np.full(shape, bg, dtype=int)
+    for obj in static_objects:
