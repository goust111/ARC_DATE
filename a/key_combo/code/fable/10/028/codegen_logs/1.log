+    return not np.array_equal(out, grid) and np.array_equal(out, expected)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*H_RANGE)
+    w = random.randint(*W_RANGE)
+    bg = random.randrange(10)
