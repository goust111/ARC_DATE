+        while True:
+            area = int(mask.sum())
+            candidates: list[tuple[tuple[int, int], ...]] = []
+            for r, c in map(tuple, np.argwhere(mask)):
+                for dr, dc in DIRS4:
+                    nr, nc = int(r) + dr, int(c) + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
