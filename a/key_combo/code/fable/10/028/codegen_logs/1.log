+        coords.size == 0
+        or (
+            coords[:, 0].min() >= 0
+            and coords[:, 1].min() >= 0
+            and coords[:, 0].max() < h
+            and coords[:, 1].max() < w
+        )
+    )
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
