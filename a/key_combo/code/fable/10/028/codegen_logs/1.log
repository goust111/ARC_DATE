+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MOVE_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+H_RANGE = (14, 20)
+W_RANGE = (14, 20)
+STATIC_COUNT_RANGE = (1, 2)
+MOVING_COUNT_RANGE = (2, 4)
+SHAPE_AREA_RANGE = (5, 12)
+SHAPE_SIZE_RANGE = (3, 6)
+MAX_SHIFT = 7
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], coords: np.ndarray) -> bool:
+    h, w = shape
+    return bool(
+        coords.size == 0
+        or (
+            coords[:, 0].min() >= 0
+            and coords[:, 1].min() >= 0
+            and coords[:, 0].max() < h
+            and coords[:, 1].max() < w
+        )
+    )
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _crop_bool(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    seen = set()
+    stack = [tuple(map(int, pts[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
