+        if not _is_connected(mask):
+            continue
+        cls = _try_classify_mask(mask)
+        if cls is None:
+            continue
+        if cls["kind"] != "static" or axis not in cls["axes"]:
+            continue
+        if require_single_axis and tuple(cls["axes"]) != (axis,):
