+def _random_directions(count: int) -> list[tuple[int, int]]:
+    choices = []
+    if count >= 1:
+        choices.append(random.choice([(0, -1), (0, 1)]))
+    if count >= 2:
+        choices.append(random.choice([(-1, 0), (1, 0)]))
+    while len(choices) < count:
+        choices.append(random.choice(MOVE_DIRS))
