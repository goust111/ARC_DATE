0521:         return
0522:     if int(connectivity) == 4:
0523:         def nbrs(rr: int, cc: int):
0524:             yield rr - 1, cc
0525:             yield rr + 1, cc
0526:             yield rr, cc - 1
0527:             yield rr, cc + 1
0528:     else:
0529:         def nbrs(rr: int, cc: int):
0530:             for dr in (-1, 0, 1):
0531:                 for dc in (-1, 0, 1):
0532:                     if dr == 0 and dc == 0:
0533:                         continue
0534:                     yield rr + dr, cc + dc
0535:     stack: list[Coord] = [(r0, c0)]
0536:     while stack:
0537:         rr, cc = stack.pop()
0538:         if not (0 <= rr < H and 0 <= cc < W):
0539:             continue
0540:         if int(grid[rr, cc]) != old_col:
0541:             continue
0542:         grid[rr, cc] = new_col
0543:         for nr, nc in nbrs(rr, cc):
0544:             stack.append((nr, nc))
