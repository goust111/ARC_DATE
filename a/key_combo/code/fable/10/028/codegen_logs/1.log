+            if int(grid[r, c]) == bg:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) != bg and int(grid[nr, nc]) != int(grid[r, c]):
+                    return False
+
+    infos = []
