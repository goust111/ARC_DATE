+        max_r = max(dr for dr, _ in shape)
+        max_c = max(dc for _, dc in shape)
+        anchor_r = random.randint(0, panel_h - 1 - max_r)
+        anchor_c = random.randint(0, width - 1 - max_c)
+        cells = [(anchor_r + dr, anchor_c + dc) for dr, dc in shape]
