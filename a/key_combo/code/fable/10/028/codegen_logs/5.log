+    colors = {color for edge in edges for color in edge}
+    indeg = {color: 0 for color in colors}
+    graph = {color: set() for color in colors}
+    for winner, loser in edges:
+        if loser not in graph[winner]:
+            graph[winner].add(loser)
+            indeg[loser] += 1
