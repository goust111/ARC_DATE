+                    "row": r,
+                    "col": c,
+                    "top": upper,
+                    "bottom": lower,
+                    "winner": arb,
+                    "loser": lower if arb == upper else upper,
+                    "winner_on_top": arb == upper,
+                }
+            )
+    return out, conflicts
