+            upper = int(top[r, c])
+            lower = int(bottom[r, c])
+            if upper == bg and lower == bg:
+                continue
+            if upper == bg:
+                out[r, c] = lower
+                continue
+            if lower == bg:
+                out[r, c] = upper
+                continue
+            if upper == lower:
+                out[r, c] = upper
+                continue
+            arb = int(divider[c])
+            assert arb in (upper, lower), "divider color must match one of the two conflicting colors"
