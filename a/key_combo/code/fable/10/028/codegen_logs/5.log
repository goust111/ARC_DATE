+def _find_separator_row(grid: np.ndarray, bg: int) -> int:
+    height = int(grid.shape[0])
+    candidates = [
+        row
+        for row in range(height)
+        if np.all(grid[row, :] != bg) and row > 0 and row < height - 1 and (2 * row + 1 == height)
