+
+def _conflict_columns(conflicts: list[dict[str, int | bool]]) -> dict[int, list[dict[str, int | bool]]]:
+    by_col: dict[int, list[dict[str, int | bool]]] = {}
+    for info in conflicts:
+        by_col.setdefault(int(info["col"]), []).append(info)
+    return by_col
