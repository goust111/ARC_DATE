1114:
1115:class TranslationalSymmetry(Symmetry):
1116:    """Translation symmetry by a fixed vector (dr,dc)."""
1117:
1118:    def __init__(self, dr: int | None = None, dc: int | None = None, **kwargs):
1119:        # Legacy keyword aliases (deprecated): translate_x->dr, translate_y->dc
1120:        tx, used_tx = _consume_alias(kwargs, "dr", ["translate_x"])
1121:        ty, used_ty = _consume_alias(kwargs, "dc", ["translate_y"])
1122:        if dr is None and tx is not None:
1123:            if used_tx == "translate_x":
1124:                warnings.warn("TranslationalSymmetry: 'translate_x' is deprecated; use 'dr'", DeprecationWarning, stacklevel=2)
1125:            dr = tx
1126:        if dc is None and ty is not None:
1127:            if used_ty == "translate_y":
1128:                warnings.warn("TranslationalSymmetry: 'translate_y' is deprecated; use 'dc'", DeprecationWarning, stacklevel=2)
1129:            dc = ty
1130:        if dr is None or dc is None:
1131:            raise TypeError("TranslationalSymmetry: must provide dr,dc")
1132:        if kwargs:
1133:            raise TypeError(f"TranslationalSymmetry: unexpected keyword arguments: {sorted(kwargs.keys())}")
1134:        self.dr, self.dc = int(dr), int(dc)
1135:
1136:    def apply(self, r, c, iters: int = 1):
1137:        r = r + int(iters) * self.dr
1138:        c = c + int(iters) * self.dc
1139:        if isinstance(r, np.ndarray):
1140:            r = r.astype(int)
1141:        if isinstance(c, np.ndarray):
1142:            c = c.astype(int)
1143:        if isinstance(r, float):
1144:            r = int(round(r))
1145:        if isinstance(c, float):
1146:            c = int(round(c))
1147:        return r, c
1148:
1149:    def __repr__(self):
1150:        return f"TranslationalSymmetry(dr={self.dr}, dc={self.dc})"
1151:
1152:    def __str__(self):
1153:        return self.__repr__()
1154:
1155:    def _iter_range(self, grid_shape: tuple[int, int]):
1156:        top = 0
1157:        if self.dr != 0:
1158:            top = math.ceil(grid_shape[0] / abs(self.dr))
1159:        if self.dc != 0:
1160:            top = max(top, math.ceil(grid_shape[1] / abs(self.dc)))
1161:        return (-top, top + 1)
1162:
1163:
1164:def detect_translational_symmetry(
1165:    grid: np.ndarray,
1166:    ignore_colors: list[int] | None = None,
1167:    background: int | None = None,
1168:) -> list[Symmetry]:
1169:    """Detect translational symmetries using a scoring heuristic."""
1170:    if ignore_colors is None:
1171:        ignore_colors = [Color.BLACK]
1172:    ignore_colors = [int(c) for c in ignore_colors]
1173:
1174:    n, m = grid.shape
1175:    r_poss = [TranslationalSymmetry(dr=tr, dc=0) for tr in range(1, n)]
1176:    r_poss += [TranslationalSymmetry(dr=-tr, dc=0) for tr in range(1, n)]
1177:    c_poss = [TranslationalSymmetry(dr=0, dc=tc) for tc in range(1, m)]
1178:    c_poss += [TranslationalSymmetry(dr=0, dc=-tc) for tc in range(1, m)]
1179:    rc_poss = [TranslationalSymmetry(dr=tr, dc=tc) for tr in range(1, n) for tc in range(1, m)]
1180:
1181:    def score(sym: Symmetry) -> float:
1182:        perfectly_preserved, outside_canvas, conflict = _score_symmetry(grid, sym, ignore_colors, background=background)
1183:        return perfectly_preserved - 0.01 * outside_canvas - 100000 * conflict
1184:
1185:    r_scores = [score(s) for s in r_poss]
1186:    c_scores = [score(s) for s in c_poss]
1187:    rc_scores = [score(s) for s in rc_poss]
1188:
1189:    r_poss = [(r_poss[i], r_scores[i]) for i in range(len(r_poss)) if r_scores[i] > 0]
1190:    c_poss = [(c_poss[i], c_scores[i]) for i in range(len(c_poss)) if c_scores[i] > 0]
1191:    rc_poss = [(rc_poss[i], rc_scores[i]) for i in range(len(rc_poss)) if rc_scores[i] > 0]
1192:
1193:    detections: list[Symmetry] = []
1194:    if r_poss:
1195:        detections.append(max(r_poss, key=lambda t: (t[1], -abs(t[0].dr)))[0])
1196:    if c_poss:
1197:        detections.append(max(c_poss, key=lambda t: (t[1], -abs(t[0].dc)))[0])
1198:    if not detections and rc_poss:
1199:        detections.append(max(rc_poss, key=lambda t: (t[1], -abs(t[0].dr) - abs(t[0].dc)))[0])
1200:    return detections
