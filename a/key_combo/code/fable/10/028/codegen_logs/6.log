+                "band": int(band_idx),
+                "marker_row": int(marker_row),
+                "marker_color": int(marker_color),
+                "side": side,
+                "input_gap": int(gap),
+                "role": role,
+            }
+    return None
+
+
+def _gen_band_layout(n_bands: int) -> tuple[list[int], list[tuple[int, int]]]:
+    for _ in range(200):
