7: def main(grid: np.ndarray) -> np.ndarray:
8:     """Move each maroon marker toward the blue rectangle and recolor the rectangle red.
9: 
10:     Input structure
11:     A background canvas contains one solid blue rectangular object and several isolated
12:     maroon marker pixels. Each marker is horizontally or vertically aligned with the
13:     rectangle and lies outside it.
14: 
15:     Rule
16:     Start with a background canvas, repaint the blue rectangle red, and move each
17:     maroon marker straight toward the rectangle along its row or column. Exactly one
18:     marker is strictly closer to the rectangle than all others and enters the
19:     rectangle boundary; every other marker lands in the adjacent exterior cell just
20:     outside its aligned side.
21: 
22:     Key insight
23:     The single entering marker is the unique global nearest marker to the rectangle,
24:     not the nearest marker on each of the four sides.
25:     """
26:     g = np.asarray(grid, dtype=int)
27:     bg = get_bg(g)
28: 
29:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
30:     rectangles = []
31:     markers = []
32:     for comp in components:
33:         h = bbox_h(comp["bbox"])
34:         w = bbox_w(comp["bbox"])
35:         if comp["area"] == h * w and comp["area"] > 1:
36:             rectangles.append(comp)
37:         elif comp["area"] == 1:
38:             markers.append(comp)
39: 
40:     assert len(rectangles) == 1
41:     assert markers
42:     rect = rectangles[0]
43:     rect_color = int(rect["color"])
44:     marker_colors = {int(comp["color"]) for comp in markers}
45:     assert marker_colors == {Color.MAROON}
46:     marker_color = Color.MAROON
47:     assert rect_color == Color.BLUE
48:     assert set(map(int, g.flat)) == {bg, rect_color, marker_color}
49: 
50:     r0, c0, r1, c1 = map(int, rect["bbox"])
51:     h = bbox_h(rect["bbox"])
52:     w = bbox_w(rect["bbox"])
53: 
54:     out = np.full_like(g, bg)
55:     out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED
56: 
57:     destinations = []
58:     marker_entries: list[tuple[int, tuple[int, int], bool]] = []
59:     for comp in markers:
60:         r, c = map(int, comp["coords"][0])
61:         candidates = []
62:         if c0 <= c <= c1 and r < r0:
63:             d = r0 - r
64:             enters = d < h
65:             candidates.append((r0 if enters else r0 - 1, c))
66:             marker_entries.append((d, (r, c), enters))
67:         if c0 <= c <= c1 and r > r1:
68:             d = r - r1
69:             enters = d < h
70:             candidates.append((r1 if enters else r1 + 1, c))
71:             marker_entries.append((d, (r, c), enters))
72:         if r0 <= r <= r1 and c < c0:
73:             d = c0 - c
74:             enters = d < w
75:             candidates.append((r, c0 if enters else c0 - 1))
76:             marker_entries.append((d, (r, c), enters))
77:         if r0 <= r <= r1 and c > c1:
78:             d = c - c1
79:             enters = d < w
80:             candidates.append((r, c1 if enters else c1 + 1))
81:             marker_entries.append((d, (r, c), enters))
82: 
83:         assert len(candidates) == 1
84:         dr, dc = candidates[0]
85:         assert in_bounds(g.shape, dr, dc)
86:         assert (dr, dc) not in destinations
87:         destinations.append((dr, dc))
88: 
89:     min_dist = min(dist for dist, _pos, _enters in marker_entries)
90:     nearest = [pos for dist, pos, _enters in marker_entries if dist == min_dist]
91:     entering = [pos for _dist, pos, enters in marker_entries if enters]
92:     assert len(nearest) == 1, "the nearest marker to the rectangle must be unique"
93:     assert len(entering) == 1, "exactly one marker may enter the rectangle"
94:     assert entering[0] == nearest[0], "the entering marker must be the global nearest"
95: 
96:     for r, c in destinations:
97:         out[r, c] = marker_color
98: 
99:     return out
