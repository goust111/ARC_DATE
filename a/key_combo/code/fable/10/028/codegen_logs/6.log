6: def main(grid: np.ndarray) -> np.ndarray:
7:     """
8:     Expand each colored marker into a full-width horizontal band frame determined by marker-row proximity.
9: 
10:     Input structure
11:     - A 2D grid with a dominant background color.
12:     - The foreground consists of isolated one-pixel colored markers.
13:     - Marker rows are unique; marker columns only identify the original pixel and do not affect the frame width.
14: 
15:     Rule
16:     - Sort markers by row and split the grid into horizontal bands at the midpoint between consecutive marker rows.
17:     - For each marker's band, paint the left and right boundary columns with the marker color.
18:     - Paint the marker's own row across the full width; also paint the top or bottom grid edge when the band touches it.
19: 
20:     Key insight
21:     - The single pixels are row anchors for full-width frames: each color owns the rows vertically closest to its marker.
22:     """
23:     g = np.asarray(grid, dtype=int)
24:     assert g.ndim == 2, "expected a 2D grid"
25:     H, W = map(int, g.shape)
26:     assert H > 0 and W >= 2, "expected a nonempty grid with side columns"
27: 
28:     bg = get_bg(g)
29:     marker_coords = np.argwhere(g != bg)
30:     assert marker_coords.size > 0, "expected at least one colored marker"
31: 
32:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)
33:     assert len(comps) == len(marker_coords), "expected foreground to consist of one-pixel markers"
34:     assert all(int(comp["area"]) == 1 for comp in comps), "expected every marker to be a singleton"
35: 
36:     markers = [(int(r), int(c), int(g[r, c])) for r, c in marker_coords]
37:     rows = [r for r, _c, _color in markers]
38:     assert len(rows) == len(set(rows)), "expected marker rows to be unique"
39:     markers.sort(key=lambda item: item[0])
40: 
41:     out = np.full_like(g, bg)
42:     for i, (row, _col, color) in enumerate(markers):
43:         start = 0 if i == 0 else (markers[i - 1][0] + row) // 2 + 1
44:         end = H - 1 if i == len(markers) - 1 else (row + markers[i + 1][0]) // 2
45:         assert start <= row <= end, "marker must lie inside its vertical band"
46: 
47:         out[start : end + 1, 0] = color
48:         out[start : end + 1, W - 1] = color
49:         out[row, :] = color
50:         if start == 0:
51:             out[0, :] = color
52:         if end == H - 1:
53:             out[H - 1, :] = color
54: 
55:     return out
