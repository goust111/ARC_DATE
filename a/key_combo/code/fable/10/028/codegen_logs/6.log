spec:
  grid: 20-25 rows x 20-25 cols, always square [observed]
  background: BLACK (0)
  frames:
    count: 2-4, each a distinct non-black non-grey color
    structure: hollow rectangle with variable border thickness (1-4 per side)
    bbox: 5-12 rows x 5-19 cols
    interior: 3-10 rows x 3-15 cols, contains only bg and grey markers
    placement: bboxes never overlap; 1-3 may touch grid border [observed]
  markers:
    color: GREY (5)
    count_per_frame: 2-8, all counts distinct across frames (required by solver)
    placement: scattered inside frame interior (on bg cells)
  output:
    rows: one per frame, sorted by ascending marker count
    cols: max marker count across all frames
    each row: frame color repeated marker-count times, right-padded with bg

generation_strategy:
  approach: output-first
  steps:
    1. Pick N=2-4 frames. Assign each a distinct color from non-black/grey palette
    2. Choose N distinct marker counts in range 2-8
    3. For each frame, pick interior size >= marker count (h>=3, w>=3, h*w >= count+2)
    4. Pick border thickness per side (1-4) to get bbox = interior + borders
    5. Place frames on a 20-25 square grid with non-overlapping bboxes
    6. Fill frame border with its color, interior with bg
    7. Scatter marker-count grey pixels randomly in interior bg cells
    8. Build output: sort frames by marker count ascending, one row per frame
```
