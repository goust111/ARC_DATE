+
+def _place_object(
+    occupied: np.ndarray,
+    band_rows: tuple[int, int],
+    marker_row: int,
+    side: str,
+    mask: np.ndarray,
+    gap: int,
+    color: int,
+    band_idx: int,
+    marker_color: int,
+    left_options: list[int] | None = None,
+    role: str = "extra",
+) -> dict | None:
+    h, w = mask.shape
+    start, end = band_rows
+    if side == "above":
+        top = int(marker_row - h - gap)
+        if top < start:
+            return None
+    else:
+        top = int(marker_row + gap + 1)
+        if top + h - 1 > end:
+            return None
+    if left_options is None:
+        left_options = list(range(1, occupied.shape[1] - w))
+    random.shuffle(left_options)
+    for left in left_options:
