1083:
1084:class Symmetry:
1085:    """
1086:    Symmetry transformations.
1087:
1088:    Subclasses implement:
1089:        apply(r,c,iters=1) -> (r',c')
1090:        _iter_range(shape) -> (start, stop) range tuple, used by orbit()
1091:    """
1092:
1093:    def apply(self, r, c, iters: int = 1):
1094:        raise NotImplementedError
1095:
1096:    def _iter_range(self, grid_shape: tuple[int, int]):
1097:        raise NotImplementedError
