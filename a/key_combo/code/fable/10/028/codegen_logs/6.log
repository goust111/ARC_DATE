774:def random_sprite(
775:    m,
776:    n,
777:    *,
778:    density: float = 0.5,
779:    symmetry: str | None = None,
780:    color_palette: list[int] | None = None,
781:    connectivity: int = 4,
782:    background: int = Color.BLACK,
783:    no_repeated_colors: bool = False,
784:) -> np.ndarray:
785:    """Generate a contiguous sprite of shape (m,n) with random symmetry and palette (for puzzle generation)."""
786:    if isinstance(m, range):
787:        m = list(m)
788:    if isinstance(n, range):
789:        n = list(n)
790:    if not isinstance(m, list):
791:        m = [m]
792:    if not isinstance(n, list):
793:        n = [n]
794:
795:    m_original, n_original = m, n
796:    density_original, symmetry_original = density, symmetry
797:    palette_original, conn_original, bg_original = color_palette, connectivity, background
798:
799:    can_be_square = any(m_ == n_ for m_ in m for n_ in n)
800:    symmetry_types = ["horizontal", "vertical", "not_symmetric", "mirror"]
801:    if can_be_square:
802:        symmetry_types += ["diagonal", "radial"]
803:    symmetry = symmetry or random.choice(symmetry_types)
804:
805:    has_to_be_square = symmetry in ("diagonal", "radial")
806:    if has_to_be_square:
807:        m, n = random.choice([(m_, n_) for m_ in m_original for n_ in n_original if m_ == n_])
808:    else:
809:        m = random.choice(m)
810:        n = random.choice(n)
811:
812:    if m == 1 or n == 1:
813:        density = 1.0
814:    elif m == 2 or n == 2:
815:        density = max(float(density), 0.6)
816:    elif m == 3 or n == 3:
817:        density = max(float(density), 0.5)
818:    else:
819:        density = max(0.4, min(0.95, random.gauss(float(density), 0.1)))
820:
821:    sprite = generate_sprite(
822:        n=int(m),
823:        m=int(n),
824:        symmetry_type=symmetry,
825:        color_palate=color_palette,
826:        fill_percentage=density,
827:        connectivity=connectivity,
828:        background=background,
829:        no_repeated_colors=no_repeated_colors,
830:    )
831:    assert is_contiguous(sprite, connectivity=connectivity, background=background), "Generated sprite is not contiguous."
832:
833:    bg = int(background)
834:    if (
835:        np.sum(sprite[0, :] != bg) > 0
836:        and np.sum(sprite[-1, :] != bg) > 0
837:        and np.sum(sprite[:, 0] != bg) > 0
838:        and np.sum(sprite[:, -1] != bg) > 0
839:    ):
840:        return sprite
841:
842:    return random_sprite(
843:        m_original,
844:        n_original,
845:        density=density_original,
846:        symmetry=symmetry_original,
847:        color_palette=palette_original,
848:        connectivity=conn_original,
849:        background=bg_original,
850:        no_repeated_colors=no_repeated_colors,
851:    )
