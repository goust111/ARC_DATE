506:# =============================================================================
507:# Geometry
508:# =============================================================================
509:
510:
511:def flood_fill(grid: np.ndarray, r: int, c: int, color: int, *, connectivity: int = 4) -> None:
512:    """Flood fill region containing (r,c) with `color` (in-place)."""
513:    H, W = grid.shape
514:    r0 = int(r)
515:    c0 = int(c)
516:    if not (0 <= r0 < H and 0 <= c0 < W):
517:        return
518:    new_col = int(color)
519:    old_col = int(grid[r0, c0])
520:    if old_col == new_col:
521:        return
522:    if int(connectivity) == 4:
523:        def nbrs(rr: int, cc: int):
524:            yield rr - 1, cc
525:            yield rr + 1, cc
526:            yield rr, cc - 1
527:            yield rr, cc + 1
528:    else:
529:        def nbrs(rr: int, cc: int):
530:            for dr in (-1, 0, 1):
531:                for dc in (-1, 0, 1):
532:                    if dr == 0 and dc == 0:
533:                        continue
534:                    yield rr + dr, cc + dc
535:    stack: list[Coord] = [(r0, c0)]
536:    while stack:
537:        rr, cc = stack.pop()
538:        if not (0 <= rr < H and 0 <= cc < W):
539:            continue
540:        if int(grid[rr, cc]) != old_col:
541:            continue
542:        grid[rr, cc] = new_col
543:        for nr, nc in nbrs(rr, cc):
544:            stack.append((nr, nc))
545:
546:
547:def draw_line(
548:    grid: np.ndarray,
549:    r: int,
550:    c: int,
551:    *,
552:    end_r: int | None = None,
553:    end_c: int | None = None,
554:    length: int | None = None,
555:    direction: tuple[int, int] | None = None,
556:    color: int,
557:    stop_at: set[int] | None = None,
558:    clip: bool = False,
559:) -> Coord:
560:    """
561:    Draw a line starting at (r,c) either to an endpoint or by (length,direction).
562:    Modifies grid in-place. Returns (r_end,c_end) last drawn.
563:
564:    Compatibility note (seed helpers):
565:      - If you provide `direction` and leave `length=None`, the line extends until
566:        it would leave the grid (implemented by using a sufficiently large length).
567:    """
568:    rr = int(r)
569:    cc = int(c)
570:    H, W = grid.shape
571:    col = int(color)
572:    stop_at = set() if stop_at is None else set(map(int, stop_at))
573:
574:    if (end_r is None) != (end_c is None):
575:        raise ValueError("draw_line: either provide both end_r and end_c, or neither")
576:
577:    if end_r is not None and end_c is not None:
578:        er = int(end_r)
579:        ec = int(end_c)
580:        dr = er - rr
581:        dc = ec - cc
582:        length = max(abs(dr), abs(dc)) + 1
583:        dr = 0 if dr == 0 else int(dr / abs(dr))
584:        dc = 0 if dc == 0 else int(dc / abs(dc))
585:    else:
586:        if direction is None:
587:            raise ValueError("draw_line: must provide endpoint or direction")
588:        dr, dc = map(int, direction)
589:        dr = 0 if dr == 0 else int(dr / abs(dr))
590:        dc = 0 if dc == 0 else int(dc / abs(dc))
591:        if length is None:
592:            # Extend until the edge (seed-style behavior). This uses a bound that is
593:            # certainly long enough even if the start is out-of-bounds and clip=True.
594:            length = max(H, W) * 2
595:        length = int(length)
596:
597:    last_r, last_c = rr, cc
598:    for i in range(int(length)):
599:        r2 = rr + i * dr
600:        c2 = cc + i * dc
601:        if not (0 <= r2 < H and 0 <= c2 < W):
602:            if bool(clip):
603:                continue
604:            break
605:        if int(grid[r2, c2]) in stop_at:
606:            break
607:        grid[r2, c2] = col
608:        last_r, last_c = r2, c2
609:    return int(last_r), int(last_c)
610:
611:
612:# =============================================================================
613:# Tiling
614:# =============================================================================
615:
616:
617:def tile_fill(shape: tuple[int, int], tile: np.ndarray, *, offset: Coord = (0, 0)) -> np.ndarray:
618:    """Return a new grid of `shape` filled by repeating `tile` with a phase offset."""
619:    H, W = map(int, shape)
620:    h, w = tile.shape
621:    r_off, c_off = map(int, offset)
622:    out = np.empty((H, W), dtype=tile.dtype)
623:    for r in range(H):
624:        tr = (r - r_off) % h
625:        for c in range(W):
626:            tc = (c - c_off) % w
627:            out[r, c] = tile[tr, tc]
628:    return out
629:
630:
631:
632:
633:# =============================================================================
634:# Motion / interaction (translate, collision/contact)
635:# =============================================================================
636:
637:
638:def translate(obj: np.ndarray, dr: int, dc: int, *, background: int = Color.BLACK) -> np.ndarray:
639:    """Translate a full-grid object by (dr,dc), filling empty with background."""
640:    dr = int(dr)
641:    dc = int(dc)
642:    bg = int(background)
643:    H, W = obj.shape
644:    out = np.full_like(obj, bg)
645:    rr, cc = np.nonzero(obj != bg)
646:    rr2 = rr + dr
647:    cc2 = cc + dc
648:    inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
649:    out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
650:    return out
651:
652:
653:def collision(
654:    *,
655:    object1: np.ndarray,
656:    object2: np.ndarray,
657:    r1: int = 0,
658:    c1: int = 0,
659:    r2: int = 0,
660:    c2: int = 0,
661:    background: int = Color.BLACK,
662:) -> bool:
663:    """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
664:    bg = int(background)
665:    a = object1
666:    b = object2
667:    H1, W1 = a.shape
668:    H2, W2 = b.shape
669:
670:    dr = int(r2) - int(r1)
671:    dc = int(c2) - int(c1)
672:
673:    ra0 = max(0, dr)
674:    ca0 = max(0, dc)
675:    ra1 = min(H1, dr + H2)
676:    ca1 = min(W1, dc + W2)
677:    if ra0 >= ra1 or ca0 >= ca1:
678:        return False
679:
680:    rb0 = ra0 - dr
681:    cb0 = ca0 - dc
682:    rb1 = rb0 + (ra1 - ra0)
683:    cb1 = cb0 + (ca1 - ca0)
684:    return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())
685:
686:
687:def contact(
688:    *,
689:    object1: np.ndarray,
690:    object2: np.ndarray,
691:    r1: int = 0,
692:    c1: int = 0,
693:    r2: int = 0,
694:    c2: int = 0,
695:    background: int = Color.BLACK,
696:    connectivity: int = 4,
697:) -> bool:
698:    """Return True iff objects touch (share edge/diagonal) or overlap."""
699:    bg = int(background)
700:    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
701:    m2 = (object2 != bg)
702:    m2d = ndimage.binary_dilation(m2, structure=struct)
703:    return collision(
704:        object1=(object1 != bg).astype(int),
705:        object2=m2d.astype(int),
706:        r1=r1,
707:        c1=c1,
708:        r2=r2,
709:        c2=c2,
710:        background=0,
711:    )
712:
713:
714:# =============================================================================
715:# Generation helpers
716:# =============================================================================
717:
718:def first_free_location(
719:    canvas: np.ndarray,
720:    patch: np.ndarray,
721:    *,
722:    transparent: int,
723:    border: int = 0,
724:    padding: int = 0,
725:    padding_connectivity: int = 8,
726:) -> Coord | None:
727:    """
728:    Find the first (top-left) location where `patch` fits without overlap.
729:
730:    Args:
731:        transparent: color treated as transparent in both `canvas` and `patch`
732:        border: keep at least this many empty cells to the canvas border
733:        padding: if > 0, treat `canvas` occupancy as dilated by `padding` pixels.
734:                 (useful for “leave a gap” placement constraints)
735:        padding_connectivity: 4 or 8 for the dilation neighborhood
736:
737:    Returns:
738:        (r0,c0) or None if no placement exists.
739:    """
740:    H, W = canvas.shape
741:    h, w = patch.shape
742:    border = int(border)
743:    padding = int(padding)
744:    bg = int(transparent)
745:
746:    if h <= 0 or w <= 0:
747:        return None
748:    if H - h + 1 - border <= border or W - w + 1 - border <= border:
749:        return None
750:
751:    # Occupancy of the canvas (optionally dilated to enforce padding).
752:    occ = (canvas != bg)
753:    if padding > 0:
754:        if int(padding_connectivity) == 4:
755:            struct = STRUCT4
756:        elif int(padding_connectivity) == 8:
757:            struct = STRUCT8
758:        else:
759:            raise ValueError("first_free_location: padding_connectivity must be 4 or 8")
760:        occ = ndimage.binary_dilation(occ, iterations=padding, structure=struct)
761:
762:    patch_mask = (patch != bg)
763:    if not bool(patch_mask.any()):
764:        # Empty patch: any in-bounds location works; choose first.
765:        return int(border), int(border)
766:
767:    for r0 in range(border, H - h + 1 - border):
768:        for c0 in range(border, W - w + 1 - border):
769:            if not bool((occ[r0 : r0 + h, c0 : c0 + w] & patch_mask).any()):
770:                return int(r0), int(c0)
771:    return None
