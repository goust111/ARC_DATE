+        if random.random() < 0.5:
+            gap_ab, gap_bd = gap_bd, gap_ab
+        else:
+            gap_ac, gap_cd = gap_cd, gap_ac
+
+        a = (0, 0, h0 - 1, w0 - 1)
+
+        r1_low = -(h1 - 3)
+        r1_high = h0 - 3
+        r1_candidates = []
+        for r1 in range(r1_low, r1_high + 1):
+            b = (r1, w0 + gap_ab, r1 + h1 - 1, w0 + gap_ab + w1 - 1)
