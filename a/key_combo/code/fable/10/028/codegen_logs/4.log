+    return {
+        "kind": "blocked",
+        "removed": set(),
+        "survive": {gate_id},
+        "expect_chain": False,
+    }
+
+
+def _pattern_single_fuse(
+    grid: np.ndarray,
+    shaft: list[int],
+    colors: list[int],
+    top_tokens: dict[int, int],
+) -> dict:
