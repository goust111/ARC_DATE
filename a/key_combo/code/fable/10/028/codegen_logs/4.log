+    for r, c in np.argwhere((g != bg) & (g != wall) & (~gate_mask)):
+        color = int(g[r, c])
+        if int(r) == 0:
+            source_tokens.append((int(c), color))
+        else:
+            token_grid[int(r), int(c)] = color
+    source_tokens.sort()
