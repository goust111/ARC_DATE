+            "wall": int(parsed["wall"]),
+            "initial_rounds": initial_rounds,
+            "drops": drops,
+            "remaining_gates": [_gate_id(gate) for gate in gates if gate["active"]],
+            "removed_gates": [_gate_id(gate) for gate in gates if not gate["active"]],
+        }
