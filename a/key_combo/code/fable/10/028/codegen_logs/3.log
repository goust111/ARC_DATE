  grid: 21-22 rows x 16-20 cols, background 0
  color_masks:
    count: 4-5 distinct non-background colors, each forming one mask
    bboxes: non-overlapping, min gap >= 1 cell between any pair
    crop_size: 2-8 rows x 4-9 cols, fill ratio 0.40-0.75
    pixels_per_mask: 5-25
  symmetric_mask:
    count: exactly 1 mask is LR-symmetric (crop == fliplr(crop))
    width: always odd [observed]
    no UD symmetry [observed]
    crop is the output
  asymmetric_masks:
    count: N-1 remaining masks (3-4 masks)
    each differs from its LR mirror by exactly 2 cells (1 pixel displaced) [observed]
    no UD or rot180 symmetry [observed]
