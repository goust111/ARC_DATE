+def _swap_map_from_legend(legend: np.ndarray) -> dict[int, int]:
+    assert legend.shape == (2, 2)
+    row0 = [int(legend[0, 0]), int(legend[0, 1])]
+    row1 = [int(legend[1, 0]), int(legend[1, 1])]
