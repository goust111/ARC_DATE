+import numpy as np
+
+
+CORNERS = ("tl", "tr", "bl", "br")
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_MAX_ATTEMPTS = 500
+GEN_COLOR_POOL = tuple(range(1, 10))
+_GEN_CALL_COUNT = 0
+
