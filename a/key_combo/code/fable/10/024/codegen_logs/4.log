+        candidates = [idx for idx in sig_to_sprites.get(frame["sig"], []) if idx not in used]
+        assert len(candidates) == 1, "each hole must match exactly one remaining sprite"
+        sprite = sprites[candidates[0]]
+        used.add(candidates[0])
