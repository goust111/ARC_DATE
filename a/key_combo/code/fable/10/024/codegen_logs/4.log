+def _analyze_scene(grid: np.ndarray) -> tuple[list[dict], list[dict], int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _background_color(g)
+    frames: list[dict] = []
+    sprites: list[dict] = []
