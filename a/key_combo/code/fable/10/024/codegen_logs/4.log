+        out[sprite["coords"][:, 0], sprite["coords"][:, 1]] = bg
+        out[frame["coords"][:, 0], frame["coords"][:, 1]] = int(sprite["color"])
+        out[frame["hole_abs"][:, 0], frame["hole_abs"][:, 1]] = int(frame["color"])
