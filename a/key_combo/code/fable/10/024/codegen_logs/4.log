+        if len(holes) == 1:
+            hole_local = holes[0]
+            hole_mask = _coords_to_mask(hole_local)
+            hole_abs = hole_local + np.array([r0, c0], dtype=int)
+            frames.append(
+                {
+                    "color": int(comp["color"]),
+                    "coords": comp["coords"],
+                    "bbox": comp["bbox"],
+                    "hole_abs": hole_abs,
+                    "hole_mask": hole_mask,
+                    "sig": _shape_signature(hole_mask),
