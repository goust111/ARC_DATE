  "src": "3x3 cell board with a red center diamond sprite and one red neighboring diamond sprite",
  "dst": "the two rotated arm cells of the centered motif",
  "transform": "add a grey sprite 135 degrees clockwise and a teal sprite 135 degrees counterclockwise from the red arm around the center; if both are already present, erase to an all-background 16x16 square",
  "grid_shape": "same for the adding step; completed motif becomes 16x16"
}
</annotation>
