+    return np.repeat(np.repeat(base, row_repeats, axis=0), col_repeats, axis=1)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Recover a stretched square base grid, swap row/column repeat counts, and stretch it again.
+
