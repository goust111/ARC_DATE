+def generate_input() -> np.ndarray:
+    global _GENERATION_CALL_COUNT
+
+    mode = MODE_SEQUENCE[_GENERATION_CALL_COUNT % len(MODE_SEQUENCE)]
+    _GENERATION_CALL_COUNT += 1
+
+    for _ in range(MAX_GENERATION_ATTEMPTS):
