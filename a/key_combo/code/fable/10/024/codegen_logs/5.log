+def _candidate_emitters(h: int, w: int, dr: int, dc: int) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    candidates: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for br in range(1, h - 1):
