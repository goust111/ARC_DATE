from collections import Counter
from math import gcd
A=3;B=1;R=2

def trace(shape,a,b,ac=A,bc=B):
    h,w=shape
    dr=(b[0]>a[0])-(b[0]<a[0])
    dc=(b[1]>a[1])-(b[1]<a[1])
    r,c=b; color=bc; seen=set(); visits=[]; first={}; bounces=0
    while True:
        st=(r,c,dr,dc,color)
        if st in seen: return None
        seen.add(st)
        nr,nc=r+dr,c+dc
        bounced=False
        if not (0<=nr<h): dr=-dr; nr=r+dr; bounced=True
        if not (0<=nc<w): dc=-dc; nc=c+dc; bounced=True
        if bounced:
            bounces+=1; color = ac if color==bc else bc
        r,c=nr,nc
        visits.append((r,c)); first.setdefault((r,c),color)
        if r in (0,h-1) and c in (0,w-1): break
    return {'counts':Counter(visits),'first':first,'bounces':bounces}

def render(shape,a,b,ac,bc):
    t=trace(shape,a,b,ac,bc)
    if not t: return None
    out=[[0]*shape[1] for _ in range(shape[0])]
    out[a[0]][a[1]]=A
    out[b[0]][b[1]]=B
    for p,n in t['counts'].items():
        if p in {a,b}: continue
        out[p[0]][p[1]] = R if n>1 else t['first'][p]
    return tuple(tuple(row) for row in out), t

bad=0; total=0
for H in range(6,18):
  for W in range(6,18):
    if H==W or gcd(H-1,W-1)"'!=1: continue
    for dr,dc in ((1,1),(1,-1),(-1,1),(-1,-1)):
      for br in range(1,H-1):
        for bc in range(1,W-1):
          a=(br-dr,bc-dc); b=(br,bc)
          if not (0<=a[0]<H and 0<=a[1]<W): continue
          if not (0<=br+dr<H and 0<=bc+dc<W): continue
          real=render((H,W),a,b,A,B)
          rev=render((H,W),b,a,B,A)
          if real is None or rev is None: continue
          total+=1
          if real[0]==rev[0]: bad+=1
print('"'same reverse',bad,'/',total)
