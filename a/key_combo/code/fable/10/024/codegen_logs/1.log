+    r0 = random.randint(0, k - arm)
+    c0 = random.randint(0, k - arm)
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    if corner == "tl":
+        mask[r0, c0 : c0 + arm] = True
+        mask[r0 : r0 + arm, c0] = True
+    elif corner == "tr":
