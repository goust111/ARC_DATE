+def _stamp_rect(mask: np.ndarray) -> None:
+    k = mask.shape[0]
+    hh = random.randint(1, min(3, k))
+    ww = random.randint(1, min(3, k))
+    r0 = random.randint(0, k - hh)
+    c0 = random.randint(0, k - ww)
