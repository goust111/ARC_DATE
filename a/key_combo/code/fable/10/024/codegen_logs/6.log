+    occ = np.full((2, n), -1, dtype=int)
+    solutions: list[np.ndarray] = []
+
+    def compatible(pl: dict) -> bool:
+        for side, idx, color in pl["cells"]:
+            if occ[side, idx] != -1:
+                return False
+            other = occ[1 - side, idx]
+            if other != -1 and other != color:
+                return False
+        return True
