+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+GEN_ATTEMPTS = 500
+GEN_TILE_H = (3, 5)
+GEN_TILE_W = (3, 5)
+GEN_COLOR_COUNT = (3, 5)
+GEN_PIECE_COUNT = (4, 5)
+GEN_MIN_PIECE_AREA = 3
+GEN_CANVAS_H = (15, 24)
+GEN_CANVAS_W = (15, 24)
+GEN_GAP = 1
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int).copy()
+
+
+def _piece_from_component(grid: np.ndarray, coords: np.ndarray, bg: int) -> dict:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    cells = []
+    for r, c in coords:
+        rr = int(r - r0)
+        cc = int(c - c0)
+        color = int(grid[r, c])
+        patch[rr, cc] = color
+        cells.append((rr, cc, color))
+    cells.sort()
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "patch": patch,
+        "cells": tuple(cells),
+        "area": len(cells),
+        "h": patch.shape[0],
+        "w": patch.shape[1],
+    }
+
+
+def _factor_pairs(area: int) -> list[tuple[int, int]]:
+    pairs = []
+    for h in range(1, int(area**0.5) + 1):
+        if area % h == 0:
+            w = area // h
+            pairs.append((h, w))
+            if h != w:
+                pairs.append((w, h))
+    return sorted(set(pairs))
+
