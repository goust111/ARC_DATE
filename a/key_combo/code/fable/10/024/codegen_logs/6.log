+
+def _candidate_placements(piece: dict, full_h: int, full_w: int, axis: str) -> tuple[list[dict], list[list[int]], int, tuple[int, int]]:
+    if axis == "v":
+        if full_w % 2:
+            return [], [], 0, (0, 0)
+        tile_h, tile_w = full_h, full_w // 2
+        n = tile_h * tile_w
+    else:
