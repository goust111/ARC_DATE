    min_dim = max(CANVAS_DIM_BOUNDS[0], side + CANVAS_EXTRA_BOUNDS[0])
    max_dim = min(CANVAS_DIM_BOUNDS[1], side + CANVAS_EXTRA_BOUNDS[1])
    return [
        (h, w)
        for h in range(min_dim, max_dim + 1)
