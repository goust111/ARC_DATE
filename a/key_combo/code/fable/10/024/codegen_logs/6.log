+def _solve_shape_axis(pieces: list[dict], full_h: int, full_w: int, axis: str, limit: int = 2) -> list[np.ndarray]:
+    prepared = []
+    for piece in pieces:
+        placements, req_to_pls, n, tile_shape = _candidate_placements(piece, full_h, full_w, axis)
+        if not placements:
