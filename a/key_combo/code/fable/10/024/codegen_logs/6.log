+    def place(pl: dict) -> list[tuple[int, int]]:
+        changed = []
+        for side, idx, color in pl["cells"]:
+            occ[side, idx] = color
+            changed.append((side, idx))
+        return changed
+
+    def undo(changed: list[tuple[int, int]]) -> None:
+        for side, idx in changed:
+            occ[side, idx] = -1
+
