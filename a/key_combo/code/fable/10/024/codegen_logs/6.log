+def _extract_pieces(grid: np.ndarray) -> tuple[int, list[dict]]:
+    bg = _get_bg(grid)
+    comps = _components(grid != bg)
+    pieces = [_piece_from_component(grid, comp, bg) for comp in comps]
+    pieces.sort(key=lambda p: (-p["area"], p["h"], p["w"], p["cells"]))
+    return bg, pieces
