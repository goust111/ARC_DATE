        random.shuffle(order)

    def rec(candidates: list[_GenBox], chosen: list[_GenBox]):
        if len(chosen) == count:
            return chosen
        if len(candidates) < count - len(chosen):
            return None

        next_candidates = list(candidates)
        if randomize:
