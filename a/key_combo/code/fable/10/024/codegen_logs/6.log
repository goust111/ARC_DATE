+    for idx, (r, c) in enumerate(seeds):
+        labels[r, c] = idx
+        piece_cells[idx].add((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and labels[nr, nc] == -1:
+                frontiers[idx].add((nr, nc))
