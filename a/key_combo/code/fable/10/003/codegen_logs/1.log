+                        walls[a + 1 : b, c0] = True
+    return walls
+
+
+def _find_boundary_line(grid: np.ndarray, color: int) -> tuple[list[Coord], Coord, Coord]:
+    pts = [tuple(map(int, rc)) for rc in np.argwhere(grid == color)]
+    assert len(pts) == 2, f"expected exactly one length-2 line of color {color}"
