+
+def _trace_path(grid: np.ndarray) -> tuple[list[Coord], list[dict], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    _, current, direction = _find_boundary_line(g, GREEN)
