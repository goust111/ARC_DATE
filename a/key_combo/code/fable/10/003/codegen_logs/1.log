+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+MARKER_COLORS = (1, 4, 5, 6, 7, 8, 9)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+Coord = tuple[int, int]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _left(d: Coord) -> Coord:
+    dr, dc = d
+    return -dc, dr
+
+
+def _right(d: Coord) -> Coord:
+    dr, dc = d
+    return dc, -dr
+
+
+def _sign(x: int) -> int:
+    return (x > 0) - (x < 0)
