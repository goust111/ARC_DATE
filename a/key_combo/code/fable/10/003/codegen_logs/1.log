+    for r, c in marker_coords:
+        by_color.setdefault(int(g[r, c]), []).append((int(r), int(c)))
+
+    for coords in by_color.values():
+        for i in range(len(coords)):
+            r0, c0 = coords[i]
+            for j in range(i + 1, len(coords)):
+                r1, c1 = coords[j]
+                if r0 == r1:
