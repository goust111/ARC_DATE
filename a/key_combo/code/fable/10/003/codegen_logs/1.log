+def _segment_cells(a: Coord, b: Coord) -> list[Coord]:
+    r0, c0 = a
+    r1, c1 = b
+    if r0 != r1 and c0 != c1:
+        raise ValueError("segments must be axis-aligned")
+    dr = _sign(r1 - r0)
+    dc = _sign(c1 - c0)
