import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/10/003/1.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()
for i in range(100):
    g = mod.generate_input()
    path, turns, walls = mod._trace_path(g)
    assert len(turns) == 4
    assert all(t['cause'] == 'wall' for t in turns)
    assert np.array_equal(walls, mod._wall_mask_from_pairs(g))
    marker_count = int((~np.isin(g, [mod.BLACK, mod.RED, mod.GREEN])).sum())
