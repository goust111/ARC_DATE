+def _can_place(mask: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> bool:
+    h, w = patch.shape
+    if top < 0 or left < 0 or top + h > mask.shape[0] or left + w > mask.shape[1]:
+        return False
+    fg = patch != int(bg)
+    return not bool((mask[top : top + h, left : left + w] & fg).any())
