+def _make_blob_patch(color: int, bg: int) -> np.ndarray:
+    h = random.randrange(2, 5)
+    w = random.randrange(2, 5)
+    target = random.randint(2, max(2, h * w - 1))
+    mask = np.zeros((h, w), dtype=bool)
+    start = (random.randrange(h), random.randrange(w))
+    mask[start] = True
+    frontier = {start}
