+GRID_H_RANGE = (18, 27)
+GRID_W_RANGE = (18, 27)
+CORNER_COUNT_CHOICES = (2, 3, 4)
+CORNER_COUNT_WEIGHTS = (2, 3, 3)
+CORNER_SIZE_RANGE = (5, 9)  # random.randrange high is exclusive
+DISTRACTOR_SIZE_RANGE = (4, 7)
+GEN_MAX_RETRIES = 400
