+def _make_holey_rect(
+    h: int,
+    w: int,
+    color: int,
+    bg: int,
+    hole_count: int,
+    *,
+    force_multi: bool = False,
+) -> np.ndarray | None:
+    comps = _grow_hole_components(h, w, hole_count, force_multi=force_multi)
+    if comps is None:
+        return None
