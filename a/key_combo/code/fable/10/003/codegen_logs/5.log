+        neighbors = []
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                neighbors.append((nr, nc))
+        random.shuffle(neighbors)
+        for nr, nc in neighbors[: random.randint(1, len(neighbors)) if neighbors else 0]:
+            mask[nr, nc] = True
+            frontier.add((nr, nc))
