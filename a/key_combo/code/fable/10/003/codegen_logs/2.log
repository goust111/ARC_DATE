+    {"bases": (4, 5, 8), "scales": (2, 3, 2)},
+    {"bases": (4, 6, 8), "scales": (2, 1, 2)},
+    {"bases": (4, 6, 8), "scales": (2, 2, 2)},
+    {"bases": (3, 4, 5, 8), "scales": (1, 2, 1, 2)},
+    {"bases": (3, 4, 5, 8), "scales": (1, 2, 2, 2)},
+    {"bases": (3, 4, 5, 8), "scales": (1, 2, 3, 2)},
+]
