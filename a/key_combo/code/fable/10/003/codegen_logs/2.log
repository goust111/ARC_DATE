+def _pick_isolated_holes(side: int, count: int) -> list[tuple[int, int]] | None:
+    cells = [(r, c) for r in range(1, side - 1) for c in range(1, side - 1)]
+    for _ in range(120):
+        random.shuffle(cells)
+        chosen = []
+        for r, c in cells:
+            if all(abs(r - rr) + abs(c - cc) > 1 for rr, cc in chosen):
+                chosen.append((r, c))
+                if len(chosen) == count:
