+def _place_patch(canvas: np.ndarray, occ: np.ndarray, patch: np.ndarray, pad: int = 1) -> tuple[int, int] | None:
+    h, w = patch.shape
+    positions = [
+        (r, c)
+        for r in range(canvas.shape[0] - h + 1)
+        for c in range(canvas.shape[1] - w + 1)
