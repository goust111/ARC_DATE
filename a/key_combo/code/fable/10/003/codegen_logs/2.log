+def _can_place(occ: np.ndarray, r: int, c: int, h: int, w: int, pad: int = 1) -> bool:
+    h0, w0 = occ.shape
+    if r < 0 or c < 0 or r + h > h0 or c + w > w0:
+        return False
+    rr0 = max(0, r - pad)
+    cc0 = max(0, c - pad)
+    rr1 = min(h0, r + h + pad)
+    cc1 = min(w0, c + w + pad)
+    return not bool(occ[rr0:rr1, cc0:cc1].any())
