+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            next_id += 1
+            stack = [(r, c)]
+            labels[r, c] = next_id
+            while stack:
+                cr, cc = stack.pop()
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_id
+                        stack.append((nr, nc))
