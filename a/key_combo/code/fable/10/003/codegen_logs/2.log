    for bases in itertools.combinations(range(3,9),n):
        for scales in itertools.product(range(1,5), repeat=n):
            if any(b < min_side[s] for b,s in zip(bases,scales)):
                continue
            targets=[b*s for b,s in zip(bases,scales)]
            if max(targets)>28 or len(set(targets))<n:
                continue
            perms=[]
            for perm in itertools.permutations(range(n)):
                qs=[]; ok=True
                for i,j in enumerate(perm):
                    if targets[j]%bases[i]"'!=0:
                        ok=False; break
                    qs.append(targets[j]//bases[i])
                if ok:
                    perms.append((perm,qs))
            if len(perms)>=2:
                # alternative with at least one quotient != correct scale and all quotients >=1
                good=[p for p in perms if p[0]!=tuple(range(n))]
                if good:
                    res.append((bases,scales,targets,good[:3]))
print('"'count',len(res))
for item in res[:120]:
