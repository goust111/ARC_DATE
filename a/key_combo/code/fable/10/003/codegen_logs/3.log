+    return out
+
+
+def _semantic_validation(
+    input_grid: np.ndarray,
+    expected_output: np.ndarray,
+    template_patch: np.ndarray,
+    placeholders: list[dict[str, object]],
+    distractor: dict[str, object] | None,
+) -> bool:
