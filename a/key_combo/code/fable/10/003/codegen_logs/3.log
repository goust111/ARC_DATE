0022:     bg = int(get_bg(g))
0023: 
0024:     # --- find the largest connected component of foreground (multicolor) ---
0025:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
0026:     assert not (not comps)
0027:     frame_comp = max(comps, key=lambda d: int(d["area"]))
0028:     fr0, fc0, fr1, fc1 = map(int, frame_comp["bbox"])
0029: 
0030:     # The frame is monochrome; use its dominant color as output background.
0031:     frame_cols = [int(g[int(r), int(c)]) for r, c in frame_comp["coords"]]
0032:     bgc = int(Counter(frame_cols).most_common(1)[0][0])
0033: 
0034:     # --- layout = bg holes inside the frame bbox, tight-cropped ---
