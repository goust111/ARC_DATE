+        colored = _scale_patch(np.asarray(variant["patch"], dtype=int), int(scale))
+        colored[colored == int(color)] = BG
+        placeholders.append(
+            {
+                "variant": variant,
+                "color": int(color),
+                "scale": int(scale),
+                "input_patch": solid_patch,
+                "output_patch": colored,
+            }
+        )
+
+    distractor: dict[str, object] | None = None
+    if rng.random() < 0.75:
