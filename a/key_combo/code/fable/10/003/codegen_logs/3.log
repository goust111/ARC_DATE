+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+TEMPLATE_DIMS = ((2, 3), (2, 4), (3, 4))
+MIN_TEMPLATE_AREA = 4
+MAX_TEMPLATE_AREA = 8
