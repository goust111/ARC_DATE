0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Merge same-sized filled rectangular objects by overlaying their internal marker pixels.
0016: 
0017:     Input structure:
0018:     - A dominant background surrounds two or more separated 4-connected foreground objects.
0019:     - Every object is a filled rectangle of the same size.
0020:     - Each rectangle has the same majority base color plus one or more non-base marker pixels.
0021: 
0022:     Rule:
0023:     - Create one output rectangle with the shared object size, filled with the shared base color.
0024:     - For each input rectangle, copy every non-base marker pixel to the same relative location
0025:       in the output.
0026:     - Marker overlays must either land on base color or agree in color with an existing marker.
0027: 
0028:     Key insight:
0029:     The separated rectangles are layers of the same template; their colored marker pixels
0030:     combine by local coordinates while the repeated base fill is just the output canvas.
0031:     """
0032:     g = np.asarray(grid, dtype=int)
0033:     bg = int(get_bg(g))
0034: 
0035:     objects: list[tuple[np.ndarray, int]] = []
0036:     for coords in components_mask(g != bg, connectivity=4):
0037:         r0, c0, r1, c1 = bbox_coords(coords)
0038:         patch = crop_bbox(g, (r0, c0, r1, c1))
0039:         assert np.all(patch != bg)
0040: 
0041:         counts = Counter(map(int, patch.ravel()))
0042:         ranked = counts.most_common()
0043:         assert len(ranked) >= 2
0044:         assert ranked[0][1] > ranked[1][1]
0045:         objects.append((patch, int(ranked[0][0])))
0046: 
0047:     assert len(objects) >= 2
0048: 
0049:     shapes = {patch.shape for patch, _base in objects}
0050:     assert len(shapes) == 1
0051: 
0052:     bases = {base for _patch, base in objects}
0053:     assert len(bases) == 1
0054:     base = next(iter(bases))
0055: 
0056:     h, w = next(iter(shapes))
0057:     out = np.full((h, w), int(base), dtype=int)
0058: 
0059:     has_marker = False
0060:     for patch, _base in objects:
0061:         marker_mask = patch != int(base)
0062:         has_marker = has_marker or bool(marker_mask.any())
0063:         rows, cols = np.where(marker_mask)
0064:         for r, c in zip(rows, cols):
0065:             value = int(patch[int(r), int(c)])
0066:             assert int(out[int(r), int(c)]) in {int(base), value}
0067:             out[int(r), int(c)] = value
0068: 
