+        carved = np.asarray(spec["output_patch"], dtype=int)
+        if not np.any((scaled_source == int(spec["color"])) & (carved == BG)):
+            return False
+        key = (tuple(map(int, carved.shape)), carved.tobytes())
+        if key in patch_keys:
