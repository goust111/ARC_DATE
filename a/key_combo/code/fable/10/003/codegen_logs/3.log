+    mirrored_pool = [v for v in variants if bool(v["mirrored"])]
+    rotated_pool = [v for v in variants if int(v["rot"]) != 0 and not bool(v["mirrored"])]
+    if not mirrored_pool or not rotated_pool:
+        return None
