+        patch_keys.add(key)
+
+    if distractor is not None:
+        dr, dc = map(int, distractor["pos"])
+        dpatch = np.asarray(distractor["patch"], dtype=int)
+        if not np.array_equal(actual[dr : dr + dpatch.shape[0], dc : dc + dpatch.shape[1]], dpatch):
+            return False
