+
+
+def _generate_case(rng: random.Random) -> np.ndarray | None:
+    dims = rng.choice(TEMPLATE_DIMS)
+    mask = rng.choice(ASYM_MASK_LIBRARY[dims]).copy()
+    area = int(mask.sum())
