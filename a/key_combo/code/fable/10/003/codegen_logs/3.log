+MASK_LIBRARY: dict[tuple[int, int], list[np.ndarray]] = {}
+ASYM_MASK_LIBRARY: dict[tuple[int, int], list[np.ndarray]] = {}
+for _dims in {dims for base in TEMPLATE_DIMS for dims in (base, (base[1], base[0]))}:
