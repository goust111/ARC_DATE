+    for match in matches:
+        r0, c0, r1, c1 = map(int, match["bbox"])
+        patch = np.asarray(match["output_patch"], dtype=int)
+        assert patch.shape == (r1 - r0 + 1, c1 - c0 + 1)
+        out[r0 : r1 + 1, c0 : c1 + 1] = patch
