+        return False
+    if parsed_palette != palette:
+        return False
+    if traced_path != intended_path:
+        return False
+    if traced_turns != intended_turns:
+        return False
+    if traced_turns < 2:
+        return False
+
+    out = main(grid)
+    if not np.array_equal(out, expected_output):
+        return False
+
+    if len({out[r, c] for r, c in traced_path}) < 2:
+        return False
+    if marker_col < 0:
+        return False
+    return True
+
+
