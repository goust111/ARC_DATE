+
+def _final_shape(canonical_shape: tuple[int, int], start_edge: str) -> tuple[int, int]:
+    main_len, cross_len = canonical_shape
+    if start_edge in ("top", "bottom"):
+        return main_len, cross_len
+    return cross_len, main_len
