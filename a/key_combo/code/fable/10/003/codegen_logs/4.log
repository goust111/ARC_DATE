+    if not np.array_equal(out, expected_output):
+        return False
+
+    if len({out[r, c] for r, c in traced_path}) < 2:
+        return False
+    if marker_col < 0:
+        return False
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
