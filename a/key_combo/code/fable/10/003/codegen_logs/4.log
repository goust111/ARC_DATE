+        return False
+
+    if parsed_run_len != run_len:
+        return False
+    if parsed_palette != palette:
+        return False
+    if traced_path != intended_path:
+        return False
+    if traced_turns != intended_turns:
+        return False
+    if traced_turns < 2:
+        return False
+
