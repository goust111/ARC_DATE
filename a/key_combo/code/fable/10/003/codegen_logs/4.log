+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+STRUCTURAL_COLORS = {BLACK, GREEN, GREY, TEAL}
+PALETTE_COLOR_POOL = (BLUE, RED, YELLOW, PINK, ORANGE, MAROON)
+
+MAX_GENERATION_ATTEMPTS = 400
+MAIN_LEN_RANGE = (11, 19)
+CROSS_LEN_RANGE = (10, 18)
