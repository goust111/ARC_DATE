+CROSS_LEN_RANGE = (10, 18)
+DETOUR_OPTIONS = (1, 2, 3)
+PALETTE_LEN_OPTIONS = (2, 3, 4)
+RUN_LEN_OPTIONS = (1, 2, 3, 4)
+EXTRA_TEAL_OPTIONS = (0, 1, 2, 3, 4)
