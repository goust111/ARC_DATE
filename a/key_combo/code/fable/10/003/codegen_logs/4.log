+    cols = _sample_columns(cross_len, detours)
+    if rows is None or cols is None:
+        return None
+
+    path = [(0, cols[0])]
+    teal_cells: set[tuple[int, int]] = set()
+    cur_row = 0
+    cur_col = cols[0]
+
+    for turn_row, next_col in zip(rows, cols[1:]):
