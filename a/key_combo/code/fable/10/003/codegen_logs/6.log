+def _label_base_components(grid: np.ndarray):
+    h, w = grid.shape
+    comp_ids = np.full((h, w), -1, dtype=int)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in BASE_COLORS or comp_ids[r, c] != -1:
+                continue
+
+            cid = len(components)
+            queue = deque([(r, c)])
+            comp_ids[r, c] = cid
+            coords: list[tuple[int, int]] = []
+
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(grid.shape, nr, nc):
+                        continue
+                    if comp_ids[nr, nc] != -1 or int(grid[nr, nc]) != color:
+                        continue
+                    comp_ids[nr, nc] = cid
+                    queue.append((nr, nc))
+
+            components.append({"color": color, "coords": coords})
+
+    return components, comp_ids
+
+
+def _build_component_adjacency(comp_ids: np.ndarray, n_components: int):
+    h, w = comp_ids.shape
+    adjacency = [defaultdict(int) for _ in range(n_components)]
+
+    for r in range(h):
+        for c in range(w - 1):
+            a = int(comp_ids[r, c])
+            b = int(comp_ids[r, c + 1])
+            if a >= 0 and b >= 0 and a != b:
+                adjacency[a][b] += 1
+                adjacency[b][a] += 1
+
+    for r in range(h - 1):
+        for c in range(w):
+            a = int(comp_ids[r, c])
+            b = int(comp_ids[r + 1, c])
+            if a >= 0 and b >= 0 and a != b:
+                adjacency[a][b] += 1
+                adjacency[b][a] += 1
+
+    return adjacency
