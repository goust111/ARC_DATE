+    for r in range(h):
+        for c in range(w - 1):
+            a = int(comp_ids[r, c])
+            b = int(comp_ids[r, c + 1])
+            if a >= 0 and b >= 0 and a != b:
+                adjacency[a][b] += 1
+                adjacency[b][a] += 1
+
+    for r in range(h - 1):
+        for c in range(w):
+            a = int(comp_ids[r, c])
+            b = int(comp_ids[r + 1, c])
+            if a >= 0 and b >= 0 and a != b:
+                adjacency[a][b] += 1
+                adjacency[b][a] += 1
+
+    return adjacency
+
