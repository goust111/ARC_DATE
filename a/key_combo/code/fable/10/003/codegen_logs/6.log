+
+
+def _sample_band_sizes(count: int, options: tuple[int, ...]) -> list[int]:
+    sizes = [int(random.choice(options)) for _ in range(count)]
+    if count >= 2 and len(set(options)) > 1 and len(set(sizes)) == 1:
