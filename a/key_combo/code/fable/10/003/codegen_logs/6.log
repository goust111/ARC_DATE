+    if cell_model["max_wave"] < 3:
+        return None
+    if cell_model["later_wave_competitions"] == 0:
+        return None
+
+    markers: list[tuple[int, int, int]] = []
+    for cell, color in seeds.items():
+        r, c = _pick_marker_position(cell_boxes[cell])
+        markers.append((r, c, int(color)))
