+
+def patch_cells(patch: np.ndarray, top_left: tuple[int, int]) -> list[tuple[int, int, int]]:
+    r0, c0 = top_left
+    cells: list[tuple[int, int, int]] = []
+    for r in range(patch.shape[0]):
+        for c in range(patch.shape[1]):
+            color = int(patch[r, c])
+            if color != BACKGROUND:
