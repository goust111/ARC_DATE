def _gen_prefix_run_count(valid_prefixes: list[int], top_widths: list[int]) -> int:
    observed_prefixes = [
        prefix
        for prefix in valid_prefixes
        if _gen_min_prefix_cols(top_widths, prefix) <= GRID_WIDTH - OBSERVED_MIN_SUFFIX_COLS
    ]
