    max_fit = (GRID_HEIGHT - MIN_TOP_GAP - top_height) // (top_height + MIN_GROUP_GAP)
    lower_count = random.randint(MIN_LOWER_GROUPS, min(MAX_LOWER_GROUPS, max_fit))
