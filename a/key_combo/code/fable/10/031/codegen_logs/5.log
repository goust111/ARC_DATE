    end = (SPRITE_SIZE - 1 - start[0], SPRITE_SIZE - 1 - start[1])
    row_step = 1 if end[0] > start[0] else -1
    col_step = 1 if end[1] > start[1] else -1
    moves = [(row_step, 0)] * (SPRITE_SIZE - 1) + [(0, col_step)] * (SPRITE_SIZE - 1)
