    observed_like = list(
        range(
            max(min_prefix_cols, GRID_WIDTH - OBSERVED_MAX_SUFFIX_COLS),
            min(GRID_WIDTH - OBSERVED_MIN_SUFFIX_COLS, GRID_WIDTH - MIN_SUFFIX_COLS) + 1,
