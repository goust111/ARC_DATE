import numpy as np, random
from collections import defaultdict


def overlap(a,b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])

def main(grid):
    g=np.asarray(grid,int)
    colors=[int(c) for c in np.unique(g) if c"'!=0]
    rects=[]
    for color in colors:
        pts=np.argwhere(g==color)
        r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
        rects.append({'"'color':color,'bbox':(int(r0),int(c0),int(r1),int(c1)),'pts':pts})
    n=len(rects)
    idx={r['color']:i for i,r in enumerate(rects)}
    edges={i:set() for i in range(n)}
    indeg=[0]*n
    for i,a in enumerate(rects):
        ar0,ac0,ar1,ac1=a['bbox']
        for j,b in enumerate(rects):
            if i==j or not overlap(a['bbox'], b['bbox']):
                continue
            pts=b['pts']
            inside=((pts[:,0]>=ar0)&(pts[:,0]<=ar1)&(pts[:,1]>=ac0)&(pts[:,1]<=ac1))
            if inside.any() and i not in edges[j]:
                edges[j].add(i)
                indeg[i]+=1
    order=[]
    avail=[i for i,d in enumerate(indeg) if d==0]
    while avail:
        if len(avail)"'!=1:
            raise AssertionError(('"'nonunique', avail, indeg, edges))
        i=avail.pop()
        order.append(rects[i])
        for k in edges[i]:
            indeg[k]-=1
            if indeg[k]==0:
                avail.append(k)
    if len(order)"'!=n:
        raise AssertionError(('"'cycle', indeg, edges))
    hidden=[]
    for r in order:
        b=r['bbox']
        area=(b[2]-b[0]+1)*(b[3]-b[1]+1)
        hidden.append(area-len(r['pts']))
    return [r['color'] for r in order], hidden


def transform_rect(rect, H, W, k):
    r0,c0,r1,c1=rect
    corners=np.array([[r0,c0],[r0,c1],[r1,c0],[r1,c1]],int)
    def tf(pt):
        r,c=map(int,pt)
        if k==0: return (r,c)
        if k==1: return (c,H-1-r)
        if k==2: return (H-1-r,W-1-c)
        if k==3: return (W-1-c,r)
        if k==4: return (r,W-1-c)
        if k==5: return (H-1-r,c)
        if k==6: return (c,r)
        if k==7: return (W-1-c,H-1-r)
    pts=np.array([tf(p) for p in corners])
    r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
    return (int(r0),int(c0),int(r1),int(c1))


def apply_transform_rects(rects,H,W):
    k=random.randrange(8)
    if k in (1,3,6,7):
        newH,newW=W,H
    else:
        newH,newW=H,W
    return [transform_rect(r,H,W,k) for r in rects], newH, newW


def corners_visible(grid,bbox,color):
    r0,c0,r1,c1=bbox
    corners=[(r0,c0),(r0,c1),(r1,c0),(r1,c1)]
    vis=[p for p in corners if grid[p]==color]
    pairs=[{corners[0],corners[3]},{corners[1],corners[2]}]
    return any(pair.issubset(set(vis)) for pair in pairs)


def gen():
    n=random.randint(3,5)
    H0=random.randint(18,24); W0=random.randint(14,20)
    base_r=random.randint(1,3)
    step=random.choice([3,4])
    heights=[random.randint(max(step+1,5),7) for _ in range(n)]
    widths=[random.randint(6,9) for _ in range(n)]
    left_hi=max(2, W0//4)
    right_lo=max(left_hi+2, W0//2-1)
    right_hi=min(W0-7, right_lo+3)
    if right_hi<right_lo:
        return None
    start_side=random.randrange(2)
    rects=[]
    for i in range(n):
        side=(start_side+i)%2
        h,w=heights[i], widths[i]
        r0=base_r+i*step+random.randint(0,1)
        if side==0:
            c0=random.randint(0,left_hi)
        else:
            c0=random.randint(right_lo,right_hi)
        if r0+h>H0 or c0+w>W0:
            return None
        rects.append((r0,c0,r0+h-1,c0+w-1))
    # consecutive overlap and non-consecutive non-overlap
    for i in range(n-1):
        if not overlap(rects[i], rects[i+1]):
            return None
    for i in range(n):
        for j in range(i+2,n):
            if overlap(rects[i],rects[j]):
                return None
    rects,H,W=apply_transform_rects(rects,H0,W0)
    colors=random.sample(range(1,10),n)
    grid=np.zeros((H,W),int)
    for color,rect in zip(colors[::-1], rects[::-1]):
        pass
    # draw back to front
    for color,rect in zip(colors[::-1], rects[::-1]):
        r0,c0,r1,c1=rect
        grid[r0:r1+1,c0:c1+1]=color
    # but above draws back last? Actually rects/colors order front->back. redo.
    grid=np.zeros((H,W),int)
    for color,rect in zip(colors[::-1], rects[::-1]):
        r0,c0,r1,c1=rect
        grid[r0:r1+1,c0:c1+1]=color
    # Wait front should overwrite, so draw back->front. rects list depth front->back; reverse to back->front then overwrite front later.
    # already done.
    depth_colors=colors
    # validations
    for color,rect in zip(depth_colors,rects):
        pts=np.argwhere(grid==color)
        if len(pts)==0:
            return None
        if tuple(pts.min(axis=0).tolist()+pts.max(axis=0).tolist()) "'!= rect:
            return None
        if not corners_visible(grid,rect,color):
            return None
    try:
        order, hidden=main(grid)
    except AssertionError:
        return None
    if order!=depth_colors:
        return None
    if max(hidden)<=0:
        return None
    # reject monotonic hidden
    asc=sorted(hidden)
    desc=sorted(hidden, reverse=True)
    if hidden==asc or hidden==desc:
        return None
    return grid, depth_colors, hidden, rects

ok=0
for _ in range(5000):
    x=gen()
    if x is not None:
        ok+=1
        if ok<=5:
            g,colors,h,rects=x
            print('"'sample', ok, g.shape, colors, h, rects)
            print(g)
        if ok>=20:
            break
print('ok',ok)
