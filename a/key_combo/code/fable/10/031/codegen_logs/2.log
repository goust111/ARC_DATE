+    queue = deque(idx for idx, deg in enumerate(indegree) if deg == 0)
+    order = []
+    while queue:
+        assert len(queue) == 1, "depth order must be uniquely determined"
+        idx = queue.popleft()
+        order.append(rects[idx])
+        for nxt in sorted(edges[idx]):
+            indegree[nxt] -= 1
+            if indegree[nxt] == 0:
