+                & (points[:, 0] <= br1)
+                & (points[:, 1] >= bc0)
+                & (points[:, 1] <= bc1)
+            )
+            if bool(inside.any()) and back_idx not in edges[front_idx]:
+                edges[front_idx].add(back_idx)
+                indegree[back_idx] += 1
