+def _stamp(grid: np.ndarray, sprite: np.ndarray, anchor: tuple[int, int]) -> None:
+    r0, c0 = anchor
+    mask = sprite != BLACK
+    h, w = sprite.shape
+    grid[r0 : r0 + h, c0 : c0 + w][mask] = sprite[mask]
+
+
+def _semantic_ok(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    fg_panel: np.ndarray,
+    composite: np.ndarray,
+    expected_shift: tuple[int, int],
