+    candidates: list[tuple[np.ndarray, np.ndarray, tuple[int, int]]] = []
+    for src, dst in ((left, right), (right, left)):
+        matches = _translation_matches(src, dst)
+        if len(matches) == 1:
+            candidates.append((src, dst, matches[0]))
