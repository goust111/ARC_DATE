+        color = int(obj["color"])
+        obj["missing_abs"] = [pos for pos, clr in missing_abs.items() if clr == color]
+
+    expected = _render_positions(missing_abs)
+    if not _is_semantically_valid(grid, expected, objs):
+        return None
+    return grid
