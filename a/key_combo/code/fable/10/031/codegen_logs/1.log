+        if c < gc:
+            moves.append((r, c + 1))
+        elif c > gc:
+            moves.append((r, c - 1))
+        r, c = random.choice(moves)
+        path.append((r, c))
+    return path
+
+
+def _connected_half_mask(h: int, side_w: int, target_count: int) -> set[tuple[int, int]]:
+    seed = (random.randrange(h), side_w - 1)
