}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 17-28 rows x 19-27 cols
  background: any single color except red (observed: 4, 7, 8)
  foreground: all objects drawn in red (2) on the background
  objects:
    multi_cell:
      count: 3-7
      area: 6-28 per object
      bbox: 3-10 rows x 3-11 cols, density 0.40-0.73
      symmetry: each has exactly one of horizontal (H), vertical (V), or diagonal (D)
      H_count: 2-3, V_count: 1-2, D_count: 0-2; at least 2 symmetry types present [observed]
      diagonal_bbox: must be square; main-diagonal (mask == mask.T) [observed]
      separation: min L1 distance >= 4 between any two multi-cell objects
    singletons:
      count: 3-9 (noise pixels)
      min_L1_to_any_multi: >= 3
  output:
    same shape, all-background canvas
    singletons erased (become background)
    multi-cell objects recolored in place: H -> blue (1), V -> green (3), D -> pink (6)

generation_strategy:
  approach: direct construction (no inversion needed; input == output modulo recoloring)
  steps:
    1. Pick grid size in range and a background color from {0-9} \ {1,2,3,6}.
    2. Decide counts for H, V, D objects (each >= 0, total 3-7, at least 2 types).
    3. For each object, generate a random 4-connected shape with exactly one symmetry axis.
       For H, ensure mask == flip_ud(mask) but != flip_lr(mask) and not diagonal-sym.
       For V, ensure mask == flip_lr(mask) but != flip_ud(mask) and not diagonal-sym.
