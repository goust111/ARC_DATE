+        cc = int(c)
+        mc = int(axis_k) - cc
+        if 0 <= mc < w and bool(mask[rr, mc]):
+            continue
+        unmatched_visible.append((rr, cc))
+        if 0 <= mc < w:
+            missing_cells.append((rr, mc))
