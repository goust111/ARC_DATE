+        return ["right", "left"]
+    middle = random.choice(["left", "right"])
+    return ["right", middle, "left"]
+
+
+def _parity_pattern(n_objects: int) -> list[str]:
+    if n_objects == 2:
+        return random.sample(["odd", "even"], 2)
