+def _bbox_of_positions(positions: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in positions]
+    cols = [c for _, c in positions]
+    return min(rows), min(cols), max(rows), max(cols)
