+    """Return unmatched count, visible unmatched pixels, and mirrored missing cells."""
+    h, w = mask.shape
+    pts = np.argwhere(mask)
+    unmatched_visible: list[tuple[int, int]] = []
+    missing_cells: list[tuple[int, int]] = []
+    for r, c in pts:
