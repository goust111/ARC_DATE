+def _gap_output_from_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
+    gaps: dict[tuple[int, int], int] = {}
