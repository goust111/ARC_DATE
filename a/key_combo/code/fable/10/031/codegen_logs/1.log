+def _axis_unmatched(mask: np.ndarray, axis_k: int) -> tuple[int, list[tuple[int, int]], list[tuple[int, int]]]:
+    """Return unmatched count, visible unmatched pixels, and mirrored missing cells."""
+    h, w = mask.shape
