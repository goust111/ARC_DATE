+            return None
+        c0 = int(coords[:, 1].min())
+        obj["axis_global_k"] = 2 * c0 + int(obj["axis_local_k"])
+
+    expected = _render_positions(missing_abs)
+    if not _is_semantically_valid(grid, expected, objs):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
