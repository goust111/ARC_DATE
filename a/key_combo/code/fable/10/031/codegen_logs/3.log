        c += width
    return c


def _gen_pattern_plan() -> tuple[list[State], list[int], list[int], list[int]] | None:
    run_count = random.randint(1, GRID_WIDTH)
    if run_count == 1:
        top_height = random.randint(SINGLE_RUN_MIN_HEIGHT, SINGLE_RUN_MAX_HEIGHT)
