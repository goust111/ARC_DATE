+def _partition_with_min(total: int, parts: int, min_part: int) -> list[int]:
+    values = [int(min_part)] * int(parts)
+    extra = int(total) - int(parts) * int(min_part)
+    assert extra >= 0
+    for _ in range(extra):
+        values[random.randrange(parts)] += 1
