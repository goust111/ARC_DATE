+    top_points = _sorted_side_points(g, GREEN, bar_row, -1)
+    bottom_points = _sorted_side_points(g, BLUE, bar_row, 1)
+    out, _top_slopes, _bottom_slopes = _render_output(g.shape, bar_row, bar_len, top_points, bottom_points)
