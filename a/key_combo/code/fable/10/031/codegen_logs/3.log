+    if not _case_is_semantic(inp, expected, bar_row, bar_len, top_points, bottom_points):
+        return None
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        inp = _gen_attempt()
+        if inp is not None:
+            return inp
