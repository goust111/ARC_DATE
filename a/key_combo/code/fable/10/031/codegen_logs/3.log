+def _marker_isolation_ok(grid: np.ndarray, markers: list[tuple[int, int]]) -> bool:
+    height, width = grid.shape
+    for r, c in markers:
+        if grid[r, c] == BLACK:
+            return False
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
