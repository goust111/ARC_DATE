+
+
+def _side_mask(
+    shape: tuple[int, int],
+    bar_row: int,
+    bar_len: int,
+    points: list[tuple[int, int]],
+    direction: int,
+    continue_slope: int | None = None,
+) -> tuple[np.ndarray, list[int]]:
