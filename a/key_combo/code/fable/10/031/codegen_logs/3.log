+    mask = np.zeros((height, width), dtype=bool)
+    boundary, slopes = _trace_side(height, (bar_row, bar_len - 1), points, direction, continue_slope)
+    if direction == -1:
+        rows = range(bar_row - 1, -1, -1)
+    else:
+        rows = range(bar_row + 1, height)
+
+    for r in rows:
