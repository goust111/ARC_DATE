+    colors = _sample_colors(4)
+    specs = [
+        _make_spec(outer, colors[0], "open", OPEN_SIDES[(side_offset + 1) % 4]),
+        _make_spec(inner, colors[1], "open", OPEN_SIDES[(side_offset + 3) % 4]),
+        _make_spec(extra, colors[2], "closed"),
+    ]
+    if _RNG.random() < 0.5:
