+import numpy as np
+from collections import deque
+
+
+BLACK = 0
+RED = 2
+CURVE_COLORS = (1, 3, 4, 6, 7, 8, 9)
+OPEN_SIDES = ("top", "right", "bottom", "left")
+_RNG = np.random.default_rng()
+_GEN_COUNTER = 0
+
+
+def _neighbors4(shape, r, c):
+    h, w = shape
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components_from_mask(mask):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(mask.shape, rr, cc):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _monochromatic_components(grid):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(grid.shape, rr, cc):
+                    if grid[nr, nc] == color and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            comps.append({"color": color, "coords": coords})
+    return comps
+
+
+def _inside_mask(barrier):
+    h, w = barrier.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not barrier[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not barrier[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(barrier.shape, r, c):
+            if not barrier[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return (~outside) & (~barrier)
+
+
+def _curve_info(component, shape):
+    coords = component["coords"]
+    color = int(component["color"])
+    mask = np.zeros(shape, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
+    endpoints = []
+    for r, c in coords:
+        degree = sum(1 for nr, nc in _neighbors4(shape, int(r), int(c)) if mask[nr, nc])
+        if degree == 1:
