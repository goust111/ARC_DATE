+def _interior_bbox(spec):
+    r0, c0, r1, c1 = spec["bbox"]
+    top, left, bottom, right = r0 + 1, c0 + 1, r1 - 1, c1 - 1
+    if spec["kind"] == "open":
+        side = spec["side"]
+        if side == "top":
