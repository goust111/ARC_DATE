            inp[r,c]=DAMAGE
        for r,c in right_d:
            inp[r,2*W-c]=DAMAGE
        left_in=inp[:,:W]
        right_in=np.fliplr(inp[:,W+1:])
        sols=[]
        counts_all={int(col):int(np.sum(inp==col)) for col in np.unique(inp)}
        for d in sorted(set(map(int,np.unique(inp))) - {SEP}):
            res=infer(left_in,right_in,d)
            if res is not None:
                sols.append((d,counts_all[d],res[3]+res[4]))
        if sols:
            best=min(sols,key=lambda x:(x[1],x[2],x[0]))
            mins=[s for s in sols if s[1]==best[1]]
            if len(mins)==1 and best[0]==DAMAGE:
                return sols

for i in range(500):
