        sigma={colors[i]:colors[(i+1)%k] for i in range(k)}
        right=np.vectorize(sigma.get)(np.fliplr(left))
        pairs=[(r,c) for r in range(H) for c in range(W)]
        rng.shuffle(pairs)
        clean=counts.copy()
        left_d=[]; right_d=[]
        total_target=int(rng.integers(2,4))
        for side in ['"'L','R']:
            for r,c in pairs:
                col=int(left[r,c])
                if clean[col] <= 1:
                    continue
                if (r,c) in left_d or (r,c) in right_d:
                    continue
                if side=='L': left_d.append((r,c))
                else: right_d.append((r,c))
                clean[col]-=1
                break
        for r,c in pairs:
            if len(left_d)+len(right_d) >= total_target:
                break
            col=int(left[r,c])
            if clean[col] <= 1:
