+    right = np.vectorize(lambda x: sigma[int(x)])(np.fliplr(left)).astype(int)
+    height, width = left.shape
+    grid = np.full((height, 2 * width + 1), SEPARATOR_COLOR, dtype=int)
+    grid[:, :width] = left
+    grid[:, width + 1 :] = right
