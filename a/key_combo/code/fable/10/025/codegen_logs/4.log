                r0=int(rng.integers(0,H-h+1)); c0=int(rng.integers(0,W-w+1))
                if used[r0:r0+h,c0:c0+w].any():
                    continue
                used[r0:r0+h,c0:c0+w]=True
                left[r0:r0+h,c0:c0+w]=col
                placed=True
                break
            if not placed:
                ok=False
                break
        if not ok:
            continue
        for _ in range(int(rng.integers(2,7))):
            col=int(rng.choice(colors))
            h=int(rng.integers(1,min(4,H)+1))
            w=int(rng.integers(1,min(4,W)+1))
