51:def main(grid: np.ndarray) -> np.ndarray:
52-    """
53-    Add red outlines around objects, and mark enclosed holes inside hollow objects.
54-
55-    Input structure:
56-    - A mostly uniform background contains one or more 4-connected foreground objects.
57-    - Some objects may enclose 4-connected background holes inside their bbox.
58-
59-    Rule:
60-    - For every foreground component, draw a one-cell 8-neighborhood outline in red (2).
61-    - If a component has enclosed background holes, recolor the component to teal (8).
62-    - Fill those enclosed holes with magenta (6) before drawing the outline.
63-
64-    Key insight: Holes are treated as part of the object for outlining, while only objects
65-    that actually enclose holes get the teal/magenta interior recoloring.
66-    """
67-    g = np.asarray(grid, dtype=int)
68-    bg = get_bg(g)
69-    out = g.copy()
70-
71-    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):
72-        coords = comp["coords"]
73-        mask = _coords_mask(g.shape, coords)
74-        holes = _interior_holes(mask, coords)
75-
76-        solid = mask.copy()
77-        if holes:
78-            out[mask] = 8
79-            for hole in holes:
80-                out[hole[:, 0], hole[:, 1]] = 6
81-                solid[hole[:, 0], hole[:, 1]] = True
82-
83-        outline = _outline_mask(solid)
84-        out[outline & (out == bg)] = 2
85-
86-    return out
