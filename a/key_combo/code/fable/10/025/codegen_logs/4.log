import numpy as np

SEP=5
DAMAGE=6
PALETTE=[1,2,3,4,7,8,9]

def infer(left,right_aligned,d):
    mapping={}
    inv={}
    left_d=right_d=0
    for (l,r) in zip(left.flat,right_aligned.flat):
        l=int(l); r=int(r)
        if l==d and r==d:
            return None
        if l"'!=d and r!=d:
            if l in mapping and mapping[l]!=r:
                return None
            if r in inv and inv[r]!=l:
                return None
            mapping[l]=r
            inv[r]=l
        elif l==d:
            left_d += 1
        else:
            right_d += 1
    if left_d + right_d == 0:
        return None
    if d in mapping or d in inv:
        return None
    for (l,r) in zip(left.flat,right_aligned.flat):
        l=int(l); r=int(r)
        if l==d:
            if r not in inv:
                return None
        elif r==d:
            if l not in mapping:
                return None
    if not mapping or len(set(mapping.values()))!=len(mapping):
        return None
    if all(k==v for k,v in mapping.items()):
        return None
    repaired_left=left.copy()
    repaired_right=right_aligned.copy()
    H,W=left.shape
    for i in range(H):
        for j in range(W):
            if repaired_left[i,j]==d:
                repaired_left[i,j]=inv[int(repaired_right[i,j])]
            elif repaired_right[i,j]==d:
                repaired_right[i,j]=mapping[int(repaired_left[i,j])]
    for (l,r) in zip(repaired_left.flat,repaired_right.flat):
        if mapping[int(l)] != int(r):
            return None
    return mapping,repaired_left,repaired_right,left_d,right_d

for t in range(200):
    rng=np.random.default_rng()
    H=int(rng.integers(6,11))
    W=int(rng.integers(6,11))
    k=int(rng.integers(3,6))
    colors=list(rng.choice(PALETTE,size=k,replace=False))
    perm=colors[1:]+colors[:1]
    sigma=dict(zip(colors,perm))
    left=np.full((H,W),colors[0],dtype=int)
    for idx,col in enumerate(colors[1:],start=1):
        h=int(rng.integers(1,max(2,H//2+1)))
        w=int(rng.integers(1,max(2,W//2+1)))
        r0=int(rng.integers(0,H-h+1)); c0=int(rng.integers(0,W-w+1))
        left[r0:r0+h,c0:c0+w]=col
    for _ in range(int(rng.integers(3,8))):
        col=int(rng.choice(colors))
        if rng.random()<0.5:
            h=int(rng.integers(1,min(H,4)+1)); w=int(rng.integers(1,min(W,4)+1))
            r0=int(rng.integers(0,H-h+1)); c0=int(rng.integers(0,W-w+1))
            left[r0:r0+h,c0:c0+w]=col
        else:
            left[int(rng.integers(H)),int(rng.integers(W))]=col
    counts={c:int(np.sum(left==c)) for c in colors}
    if min(counts.values())<2:
        continue
    right=np.vectorize(sigma.get)(np.fliplr(left))
    pairs=[(r,c) for r in range(H) for c in range(W)]
    rng.shuffle(pairs)
    left_d=[]; right_d=[]
    clean_counts=counts.copy()
    for r,c in pairs:
        col=int(left[r,c])
        if clean_counts[col] <= 1:
            continue
        if not left_d:
            left_d.append((r,c)); clean_counts[col]-=1
        elif not right_d:
            right_d.append((r,c)); clean_counts[col]-=1
        elif len(left_d)+len(right_d) < 5 and rng.random() < 0.35:
            if rng.random()<0.5:
                left_d.append((r,c))
            else:
                right_d.append((r,c))
            clean_counts[col]-=1
    if not left_d or not right_d:
        continue
    inp=np.full((H,2*W+1),SEP,dtype=int)
    inp[:,:W]=left
    inp[:,W+1:]=right
    for r,c in left_d:
        inp[r,c]=DAMAGE
    for r,c in right_d:
        inp[r,2*W-c]=DAMAGE
    left_in=inp[:,:W]
    right_in=np.fliplr(inp[:,W+1:])
    sols=[]
    for d in sorted(set(map(int,np.unique(inp))) - {SEP}):
        res=infer(left_in,right_in,d)
        if res is not None:
            sols.append((d,res[0],res[3],res[4]))
    if len(sols)!=1:
        print('"'bad',len(sols),H,W,colors,sols,set(np.unique(inp)))
        print(inp)
        break
else:
    print('ok')
