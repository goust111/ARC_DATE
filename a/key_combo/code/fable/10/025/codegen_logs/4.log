+        rect_h = int(rng.integers(2, min(5, height) + 1))
+        rect_w = int(rng.integers(2, min(5, width) + 1))
+        r0 = int(rng.integers(0, height - rect_h + 1))
+        c0 = int(rng.integers(0, width - rect_w + 1))
+        if used[r0 : r0 + rect_h, c0 : c0 + rect_w].any():
