+def _generate_left_half(
+    rng: np.random.Generator, height: int, width: int, colors: list[int]
+) -> np.ndarray | None:
+    base = colors[0]
+    left = np.full((height, width), base, dtype=int)
+    used = np.zeros((height, width), dtype=bool)
