            inp[r0:r0 + sprite_h, stack_left:stack_left + sprite_w] = BACKGROUND
    _gen_paste(inp, legend, legend_r, legend_c)
    try:
        actual = main(inp)
    except Exception:
        return None
    if np.array_equal(actual, out):
        return inp

