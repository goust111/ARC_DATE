        remaining = count - len(chosen) - 1
        for idx in range(start_idx, len(candidates)):
            col = candidates[idx]
            min_possible_last = col + remaining * min_gap
            if min_possible_last > max_last:
                break
            chosen.append(col)
            next_col = col + min_gap
