def _rect_dims(area):
    """Return (h, w) for a rectangle with given area, randomized among valid factorizations."""
    factors = [(i, area // i) for i in range(1, int(area ** 0.5) + 1)
               if area % i == 0 and i <= HOLE_DIM_MAX and area // i <= HOLE_DIM_MAX]
    if not factors:
