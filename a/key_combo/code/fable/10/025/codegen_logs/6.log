+    for bits in range(1, 1 << total):
+        if bits.bit_count() < min_area or bits.bit_count() >= total:
+            continue
+        flat = np.array([(bits >> i) & 1 for i in range(total)], dtype=bool)
+        mask = flat.reshape(size, size)
