        g,
        bg=bg,
        colors=[source_color],
        connectivity=8,
        monochromatic=False,
    )
    assert components

    for comp in components:
        r0, c0, r1, c1 = map(int, comp["bbox"])
        h = bbox_h(comp["bbox"])
        w = bbox_w(comp["bbox"])
        assert h == w and h % 2 == 0
        size = h // 2

        sub = g[r0 : r1 + 1, c0 : c1 + 1]
        occupied: set[tuple[int, int]] = set()
        for br in range(2):
            for bc in range(2):
                block = sub[br * size : (br + 1) * size, bc * size : (bc + 1) * size]
                if np.all(block == source_color):
