            c += 1

    seeds = np.argwhere(g == beam)
    assert seeds.size > 0, "expected at least one beam seed"
    for r_raw, c_raw in seeds:
        r = int(r_raw)
        c = int(c_raw)
        assert c == 0, "beam seeds must be on the left edge"
        run_full_beam(r, c)

    return out

