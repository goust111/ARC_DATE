+    max_br = max((int(comp["bbox"][2] - row_offset) // size) for comp in comps)
+    max_bc = max((int(comp["bbox"][3] - col_offset) // size) for comp in comps)
+    active = np.zeros((max_br + 1, max_bc + 1), dtype=bool)
+    red = np.zeros((max_br + 1, max_bc + 1), dtype=bool)
+    for comp in comps:
+        r0, c0, _, _ = comp["bbox"]
+        br = (int(r0) - row_offset) // size
