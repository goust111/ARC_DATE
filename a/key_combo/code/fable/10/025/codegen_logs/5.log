spec:
  grid: 10 rows x 5-7 cols [observed]; output same size as input
  colors: 1 bg color + 2 fg colors; 3 total distinct colors
  motif:
    location: contiguous block of rows anchored at the bottom of the grid
    height: 4-5 rows
    every_row_has_fg: true
    fg_density: 0.35-0.50 of motif cells are non-bg
    fg_bbox_width: 3-5 cols (subset of grid width)
  blank_region:
    location: all rows above the motif, filled entirely with bg
    height: 5-6 rows, always >= motif height
  transform: |
    Tile the motif upward to fill the entire grid, preserving vertical phase.
    Output row r = motif[(r - top) % motif_h], where top is the first fg row.
    Result: the motif repeats (possibly with a partial cycle at the top).

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dims H in [8,14], W in [5,9]; pick motif_h in [3,6] with blank = H - motif_h >= motif_h and blank >= 1.
    2. Pick 1 bg color and 2 distinct fg colors.
    3. Build motif (motif_h x W) with bg fill; place fg pixels so every motif row has >= 1 fg cell, using both fg colors, density ~0.3-0.5.
    4. Construct input by placing motif_h blank bg rows (or more) on top, then the motif at the bottom. Blank rows = H - motif_h.
    5. Verify blank_rows >= motif_h and motif rows are contiguous at the bottom.
```
