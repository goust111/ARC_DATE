+    expected = _expected_output(inp, _infer_block_layout(inp)[0], _infer_block_layout(inp)[1], _infer_block_layout(inp)[2], active, red)
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
+        return False
+    if Counter(actual.ravel().tolist())[TEAL] == 0:
+        return False
+    return True
+
