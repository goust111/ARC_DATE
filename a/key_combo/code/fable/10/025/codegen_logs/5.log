+    target_count = random.randint(1, min(4, len(candidates)))
+    for r, c in candidates:
+        if int(red.sum()) >= target_count:
+            break
+        if any(abs(r - rr) + abs(c - cc) == 1 for rr, cc in np.argwhere(red)):
+            continue
