+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_monochrome_components(grid: np.ndarray, colors: set[int]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _is_solid_square(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    return h == w and int(component["area"]) == h * w
+
+
+def _infer_block_layout(grid: np.ndarray) -> tuple[int, int, int, list[dict]]:
+    comps = _find_monochrome_components(np.asarray(grid, dtype=int), ACTIVE_INPUT_COLORS | {OBSTACLE_COLOR})
+    assert comps, "expected at least one green or red square block"
+    assert all(_is_solid_square(comp) for comp in comps), "all non-background objects must be solid squares"
+
+    sizes = sorted({int(comp["bbox"][2] - comp["bbox"][0] + 1) for comp in comps})
+    assert len(sizes) == 1, "all blocks must share one side length"
+    size = sizes[0]
+
+    row_offsets = {int(comp["bbox"][0]) % size for comp in comps}
+    col_offsets = {int(comp["bbox"][1]) % size for comp in comps}
+    assert len(row_offsets) == 1 and len(col_offsets) == 1, "blocks must align to one hidden block lattice"
+    row_offset = next(iter(row_offsets))
+    col_offset = next(iter(col_offsets))
+
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        assert (r0 - row_offset) % size == 0 and (c0 - col_offset) % size == 0
+        assert np.all(
+            np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1] == int(comp["color"])
