def _gen_bbox_dims(coords):
    r0, c0, r1, c1 = bbox_coords(np.array(list(coords), dtype=int))
    return r1 - r0 + 1, c1 - c0 + 1


def _gen_normalized_patch(coords):
    coords_arr = np.array(list(coords), dtype=int)
