        if obj is None:
            return None
        objects.append(obj)
    return objects


def _gen_attempt():
    height = _gen_randint(_GEN_GRID_MIN, _GEN_GRID_MAX)
    width = _gen_randint(_GEN_GRID_MIN, _GEN_GRID_MAX)
    n_rim, n_dist = _gen_choice(_GEN_COUNT_PAIRS)

