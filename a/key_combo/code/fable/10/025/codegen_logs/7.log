+            np.any(hole[:, 0] == 0)
+            or np.any(hole[:, 1] == 0)
+            or np.any(hole[:, 0] == local_mask.shape[0] - 1)
+            or np.any(hole[:, 1] == local_mask.shape[1] - 1)
