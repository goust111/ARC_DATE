+
+# --------------- generator ---------------
+
+GRID_H_RANGE = (12, 24)
+GRID_W_RANGE = (12, 24)
+RECT_H_RANGE = (3, 6)
+RECT_W_RANGE = (4, 8)
+EXTRA_OBJECT_COUNT_RANGE = (1, 3)
+EXTRA_AREA_RANGE = (4, 8)
+MAX_ATTEMPTS = 500
