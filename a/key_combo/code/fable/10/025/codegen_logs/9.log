+                & (shifted[:, 0] < g.shape[0])
+                & (0 <= shifted[:, 1])
+                & (shifted[:, 1] < g.shape[1])
+            )
+        )
+        target = out[shifted[:, 0], shifted[:, 1]]
+        assert bool(np.all(target == int(bg))), "translated objects must land on empty background"
+        out[shifted[:, 0], shifted[:, 1]] = color
+
+    return out
