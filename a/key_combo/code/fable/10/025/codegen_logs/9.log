+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == int(bg):
+                continue
+            color = int(grid[r, c])
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
