+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox_from_coords(coords),
+                    "area": int(coords.shape[0]),
+                    "touches_edge": touches_edge(coords, grid.shape),
+                }
+            )
+    return components
