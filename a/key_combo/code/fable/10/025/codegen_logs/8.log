    bg_labels, n_bg = label_mask(grid == Color.BLACK, connectivity=4)
    edge_ids = _gen_edge_ids(bg_labels, n_bg)
    return [np.argwhere(bg_labels == k) for k in range(1, n_bg + 1) if k not in edge_ids]


