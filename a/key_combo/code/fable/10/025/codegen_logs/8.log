+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(RETRY_LIMIT):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid periodic-consensus input")

