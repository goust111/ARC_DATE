+
+def _strict_majority(values: np.ndarray) -> int | None:
+    counts = Counter(map(int, values.tolist()))
+    ranked = counts.most_common()
+    if not ranked:
+        return None
+    if ranked[0][1] * 2 <= len(values):
+        return None
+    if len(ranked) > 1 and ranked[0][1] == ranked[1][1]:
+        return None
+    return int(ranked[0][0])
+
