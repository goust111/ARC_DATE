spec:
  grid: 3-12 rows x 3-6 cols, black background
  foreground:
    color: RED pixels on BLACK background
    touches: exactly one vertical border (left or right), never both
    opposite_border: always has >=1 empty column on the non-touched side [observed]
    pixel_count: 4-18
    density: 0.25-0.56 of grid cells
    connectivity: 1-5 connected components allowed; rows may have non-contiguous fg
    row_coverage: fg present in 60-100% of rows
  output:
    size: same height, double width
    construction: |
      mirror = fliplr(input); remap BLACK->TEAL, RED->BLACK in mirror
      if fg touches left: concat(mirror, input)
      if fg touches right: concat(input, mirror)

generation_strategy:
  approach: direct random input (transformation is trivial, no tight output constraints)
  steps:
    1. Pick height 3-12, width 3-6
    2. Pick touched side (left or right) uniformly
    3. Create black grid; randomly place RED pixels with density ~0.25-0.55
    4. Ensure at least one RED pixel touches the chosen vertical border
    5. Ensure no RED pixel in the opposite border column
    6. Verify fg pixel count >=4 and >=60% of rows contain fg
```
