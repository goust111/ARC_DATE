+        h, w = spec["outer_shape"]
+        grid[r, c : c + w] = FRAME_COLOR
+        grid[r + h - 1, c : c + w] = FRAME_COLOR
+        grid[r : r + h, c] = FRAME_COLOR
+        grid[r : r + h, c + w - 1] = FRAME_COLOR
+        spec["bbox"] = (r, c, r + h - 1, c + w - 1)
