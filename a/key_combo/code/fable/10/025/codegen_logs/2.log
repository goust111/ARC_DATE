        c0, c1 = sorted((a[1], b[1]))
        return {(row_idx, col_idx) for col_idx in range(c0, c1 + 1)}
    col_idx = a[1]
    r0, r1 = sorted((a[0], b[0]))
    return {(row_idx, col_idx) for row_idx in range(r0, r1 + 1)}


