    size = random.choice(sorted(LATTICE_CHOICES_BY_SIZE))
    cell_size, n_walls, tail = random.choice(LATTICE_CHOICES_BY_SIZE[size])
    total_cells = n_walls + (1 if tail else 0)
    return size, cell_size, n_walls, tail, total_cells


