+    else:
+        unique_match_count = random.randint(1, min(3, num_frames - 1))
+        matched_areas = random.sample([2, 3, 4, 5, 6, 7, 8, 9, 10, 12, 14, 15, 16, 18], unique_match_count)
+        duplicate_area = None
+
