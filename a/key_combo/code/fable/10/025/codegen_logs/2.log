+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 2
+SEPARATOR_COLOR = 5
+CODE_PALETTE = (1, 3, 4, 6, 7, 8, 9)
+MIN_COUNT_SUM = 18
+MAX_COUNT_SUM = 30
+MIN_FRAMES = 3
+MAX_FRAMES = 5
+MAX_INNER_DIM = 7
+MIN_TOP_HEIGHT = 8
+MAX_TOP_HEIGHT = 24
+MAX_GENERATION_ATTEMPTS = 400
