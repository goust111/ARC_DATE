def _gen_oriented_endpoint(span: int, axis_len: int) -> tuple[int, int]:
    direction = random.choice(DIRECTIONS)
    if direction < 0:
        start = random.randint(span - 1, axis_len - 1)
        return start, start - span + 1
    start = random.randint(0, axis_len - span)
