+    else:
+        remaining_match_areas = matched_areas
+
+    for area in remaining_match_areas:
+        ih, iw = _choose_shape_for_area(area)
+        frame_specs.append(
+            {
+                "matched": True,
+                "inner_shape": (ih, iw),
+                "inner_area": ih * iw,
+                "outer_shape": (ih + 2, iw + 2),
+            }
