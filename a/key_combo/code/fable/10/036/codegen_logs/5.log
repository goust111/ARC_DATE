+
+
+def _extract_axis_components(grid: np.ndarray) -> tuple[list[AxisSpec], dict[Coord, AxisSpec], set[Coord]]:
+    axis_mask = grid == AXIS
+    seen = np.zeros_like(axis_mask, dtype=bool)
