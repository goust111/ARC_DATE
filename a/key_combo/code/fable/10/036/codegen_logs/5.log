+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+PATH = 5
+AXIS = 8
+
+CARDINALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GRID_MIN = 18
+GRID_MAX = 30
+CHAIN_CHOICES = (1, 2, 3, 4)
+AXIS_LEN_RANGE = (3, 6)
+LEG_LEN_RANGE = (2, 4)
+DECOY_AXIS_CHOICES = (0, 1, 1, 2)
+MAX_GENERATION_ATTEMPTS = 600
+
+
+Coord = tuple[int, int]
+AxisSpec = dict[str, object]
