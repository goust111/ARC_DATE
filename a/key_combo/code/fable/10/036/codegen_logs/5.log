+
+
+def _paint_segment(out: np.ndarray, segment: list[Coord], axis_cells: set[Coord], *, final_red: bool) -> None:
+    for idx, (r, c) in enumerate(segment):
+        if idx == 0 and (r, c) in axis_cells:
+            continue
