+
+
+def _reflect_point(point: Coord, axis: AxisSpec) -> Coord:
+    orient = axis["orient"]
+    if orient == "vertical":
+        col = int(axis["fixed"])
+        return point[0], 2 * col - point[1]
+    row = int(axis["fixed"])
+    return 2 * row - point[0], point[1]
+
+
+def _reflect_segment(segment: list[Coord], axis: AxisSpec) -> list[Coord]:
