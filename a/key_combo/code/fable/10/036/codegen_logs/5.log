+def _paint_initial_segment(grid: np.ndarray, segment: list[Coord]) -> None:
+    grid[segment[0]] = RED
+    for cell in segment[1:-1]:
+        grid[cell] = PATH
+
+
+def _render_expected(shape: tuple[int, int], axes: list[AxisSpec], segments: list[list[Coord]]) -> np.ndarray:
