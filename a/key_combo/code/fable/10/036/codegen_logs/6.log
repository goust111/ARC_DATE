+def _sample_winners(panel_h: int, panel_w: int) -> tuple[np.ndarray, dict[str, list[tuple[int, int]] | tuple[int, int]]]:
+    n = panel_h * panel_w
+    coords = [(r, c) for r in range(panel_h) for c in range(panel_w)]
