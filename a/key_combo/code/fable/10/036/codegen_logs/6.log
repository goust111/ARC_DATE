+
+def _gen_attempt() -> np.ndarray | None:
+    panel_h = random.randint(*PANEL_H_RANGE)
+    panel_w = random.randint(*PANEL_W_RANGE)
+
+    palette = random.sample(range(1, 10), 6)
+    sep_color = palette[0]
+    panel_colors = palette[1:]
