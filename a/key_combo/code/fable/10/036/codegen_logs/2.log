+    width: int,
+    active_colors: list[int],
+    pairs: list[tuple[int, int]],
+    conflict_specs: list[tuple[int, str, tuple[int, ...]]],
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    reps = [(r, c) for r in range(height // 2) for c in range(width // 2)]
+    random.shuffle(reps)
