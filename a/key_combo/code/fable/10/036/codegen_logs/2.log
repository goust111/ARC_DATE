+def _choose_pairs(active_colors: list[int], n_pairs: int) -> list[tuple[int, int]]:
+    if n_pairs == 2:
+        a, b, c = random.sample(active_colors, 3)
+        return [(a, b), (c, a)]
+
+    seq = random.sample(active_colors, n_pairs)
+    return [(seq[i], seq[(i + 1) % n_pairs]) for i in range(n_pairs)]
