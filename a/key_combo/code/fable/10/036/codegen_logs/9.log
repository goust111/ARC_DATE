def _gen_bounded_parts(n: int, total: int, lo: int, hi: int) -> list[int] | None:
    parts: list[int] = []
    remaining = int(total)
    for i in range(int(n)):
        rem = int(n) - i - 1
        low = max(int(lo), remaining - int(hi) * rem)
