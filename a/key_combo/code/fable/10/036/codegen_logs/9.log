  colors: 2 (bg = any color, fg = any different color)
  rectangles:
    count: 4-6 solid monochromatic fg rectangles
    dimensions: max(h,w) in 1-10, min(h,w) in 1-3 [observed]; h+w <= 10 (no band overlap)
    constraint: sum(max(h_i,w_i)) + N-1 <= 30 (output width fits ARC grid)
  input:
    height: max(max(h_i,w_i)) across all rects (3-6 observed)
    width: sum(w_i) + N-1
    layout: rects placed top-aligned in original orientation, 1-col bg gap between each
