    col_starts = [0, col_bands[0] + SEPARATOR_WIDTH, col_bands[0] + col_bands[1] + 2 * SEPARATOR_WIDTH]
    out = inp.copy()
    for (ri, ci), color in PLUS_REGION_FILLS.items():
        r0 = row_starts[ri]
        c0 = col_starts[ci]
        out[r0 : r0 + row_bands[ri], c0 : c0 + col_bands[ci]] = color
