+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+PALETTE = tuple(range(10))
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _coords_mask(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
+    return mask
+
+
+def _enclosed_chambers(grid: np.ndarray, wall: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    passable = grid != wall
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    enclosed = passable & ~outside
+    return _components(enclosed)
+
+
+def _full_plus_centers(grid: np.ndarray, chamber_mask: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    centers: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if not chamber_mask[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color == bg:
+                continue
+            ok = True
+            for dr, dc in PLUS_OFFSETS[1:]:
+                nr, nc = r + dr, c + dc
+                if not chamber_mask[nr, nc] or int(grid[nr, nc]) != color:
+                    ok = False
+                    break
