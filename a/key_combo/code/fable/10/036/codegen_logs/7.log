+    cells = _candidate_cells(inner_box)
+    if not centers:
+        return None
+    frag_color, dot_color = random.sample([c for c in PALETTE if c not in (bg, wall)], 2)
+    center = random.choice(centers)
+    arm_offsets = list(PLUS_OFFSETS[1:])
+    random.shuffle(arm_offsets)
