+        list(range(len(panels))),
+        {i: (OPPOSITE[panels[i]["direction"]], panels[i]["count"]) for i in range(len(panels))},
+    )
+    if np.array_equal(true_out, opposite):
+        return False
+
+    for i in range(len(panels)):
