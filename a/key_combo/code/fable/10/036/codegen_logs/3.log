+def _random_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    rr, cc = b
+    cells = [(r, c)]
+    moves = [0] * abs(rr - r) + [1] * abs(cc - c)
+    random.shuffle(moves)
+    for axis in moves:
+        if axis == 0:
+            r += 1 if rr > r else -1
+        else:
+            c += 1 if cc > c else -1
+        cells.append((r, c))
+    return cells
