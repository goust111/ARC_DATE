+    zero_index = int(RNG.integers(0, n))
+    positive_index = int(RNG.integers(0, n - 1))
+    if positive_index >= zero_index:
+        positive_index += 1
+    for i in range(n):
+        max_count = min(3, capacities[i])
+        if i == zero_index:
+            counts.append(0)
+        elif i == positive_index:
+            counts.append(int(RNG.integers(1, max_count + 1)))
+        else:
