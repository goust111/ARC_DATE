+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == color
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _frame_info(grid: np.ndarray, color: int, coords: np.ndarray) -> dict | None:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    if len(coords) != 2 * (h + w) - 4:
+        return None
+
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.all(patch[border] == color):
+        return None
+    if np.any(patch[~border] == color):
+        return None
+
+    interior = patch[1:-1, 1:-1]
+    count = int(np.count_nonzero(interior != BG))
+    return {
+        "color": int(color),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "h": h,
+        "w": w,
+        "count": count,
+    }
