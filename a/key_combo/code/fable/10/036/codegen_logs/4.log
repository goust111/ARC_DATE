+    for rr, cc in residual_coords:
+        owners = 0
+        for info in frames:
+            r0, c0, r1, c1 = info["bbox"]
+            if r0 < rr < r1 and c0 < cc < c1:
+                owners += 1
+        assert owners == 1, "every non-frame pixel must be a dot inside exactly one frame"
+
+    return frames
+
