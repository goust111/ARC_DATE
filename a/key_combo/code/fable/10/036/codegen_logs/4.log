+    residual_coords: set[tuple[int, int]] = set()
+    for color in sorted(set(map(int, np.unique(g))) - {bg}):
+        for coords in _color_components(g, color):
+            info = _frame_info(g, color, coords)
+            if info is None:
+                residual_coords.update(map(tuple, coords.tolist()))
+            else:
+                frames.append(info)
+
