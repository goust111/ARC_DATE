+
+
+def _mark_blocked(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _place_component(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    template: dict,
+    bg: int,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    candidates = []
+    for r0 in range(h - template["bbox_h"] + 1):
+        for c0 in range(w - template["bbox_w"] + 1):
+            coords = []
+            ok = True
+            for lr, lc, val in template["cells_bbox"]:
+                rr = r0 + lr
+                cc = c0 + lc
+                if blocked[rr, cc]:
+                    ok = False
+                    break
+                coords.append((rr, cc, val))
+            if ok:
