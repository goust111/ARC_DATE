+def _stamp_cells(
+    template: dict,
+    anchor: tuple[int, int],
+    shape: tuple[int, int],
+    *,
+    mode: str = "handle",
+) -> list[tuple[int, int, int]]:
+    if mode == "handle":
+        rel = template["cells_rel"]
+    elif mode == "top_left":
+        rel = template["cells_bbox"]
+    elif mode == "first_cell":
+        rel = template["cells_rel_first"]
+    else:
+        raise ValueError(mode)
