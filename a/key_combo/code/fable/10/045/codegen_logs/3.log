  "transform": "recolor each size-1 component to bg; preserve every component of size greater than one"
}
</annotation>
<generation_spec>
```yaml
task_id: 42a50994
type: transform_in_place

spec:
  grid: 9-19 cols x 11-17 rows
  background: 0 (black)
  foreground: exactly 1 non-zero color (varies per puzzle)
  fg_pixel_fraction: 0.13-0.24
  components:
    connectivity: 8-connected
    total: 14-25
    singletons: 8-13 isolated pixels (no 8-neighbor is fg)
    clusters: 3-13 components of size 2-12
    cluster_sizes: mostly 2-6, occasional up to 12
    cluster_bbox: sparse blobs, density 0.30-1.00 within bbox
  spacing: min Chebyshev distance between any two fg components >= 2
  transform: remove all singletons (set to bg); keep all clusters unchanged
  output_grid: same dimensions, same clusters, singletons erased

generation_strategy:
  approach: direct random placement (constraints are easy to satisfy directly)
  steps:
    1. Pick grid H in [11,17], W in [9,19], fg color from 1-9
    2. Pick n_clusters in [3,13]; for each, generate a random 8-connected
       blob of size 2-6 (occasionally up to 12) by random walk in 8-dirs
    3. Place clusters on grid with Chebyshev gap >= 2 between all components
    4. Pick n_singletons in [8,13]; scatter them on empty cells ensuring
       Chebyshev distance >= 2 from every existing fg pixel
    5. Verify total fg fraction is in [0.13, 0.24]; retry if not
    6. Output = copy grid then zero out all singletons
```
