    for col in source_cols:
        inp[: source_bottom + 1, col] = GEN_SOURCE_COLOR
    _gen_paint_obstacles(inp, obstacle_row, runs)

    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
