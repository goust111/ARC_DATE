+
+    marker_count = int(_RNG.integers(3, min(8, len(candidates)) + 1))
+    chosen = [_RNG.choice(both), _RNG.choice(one_axis)]
+    chosen = [tuple(map(int, a)) for a in chosen]
+
+    if fixed and _RNG.random() < 0.45 and len(chosen) < marker_count:
