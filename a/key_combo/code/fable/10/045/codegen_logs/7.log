+        r, c = _source_cell(address, row_starts, col_starts)
+        grid[r, c] = int(color)
+
+    if not _semantic_check(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRY_LIMIT):
