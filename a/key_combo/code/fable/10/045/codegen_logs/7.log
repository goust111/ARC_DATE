+        expected_sep_cols = {col_starts[k] + region_w for k in range(region_cols - 1)}
+        if set(np.flatnonzero(full_rows)) != expected_sep_rows:
+            continue
+        if set(np.flatnonzero(full_cols)) != expected_sep_cols:
+            continue
