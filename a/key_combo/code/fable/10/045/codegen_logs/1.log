+    if not _decoy_counterexample_ok(seed, hits, decoys):
+        return False
+    return True
+
+
+def _output_signature(out: np.ndarray) -> tuple[int, ...]:
+    return (int(out.shape[1]),) + tuple(map(int, out[0]))
