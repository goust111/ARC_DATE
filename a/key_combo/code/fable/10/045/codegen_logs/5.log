import random, numpy as np

BG = 0
TURN_RIGHT_COLOR = 1
TURN_LEFT_COLOR = 2
SEED_COLOR = 3
MARKER_COLOR = 4
DIRS = [(-1,0),(0,1),(1,0),(0,-1)]
DIR_TO_INDEX = {d:i for i,d in enumerate(DIRS)}
TURN_BY_COLOR = {TURN_RIGHT_COLOR: 1, TURN_LEFT_COLOR: -1}


def get_bg(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])


def trace(lengths, turns, dir_idx, start=(0,0)):
    r,c = start
    pts=[]
    for length, turn in zip(lengths, turns):
        dr,dc = DIRS[dir_idx]
        for _ in range(length):
            r += dr
            c += dc
            pts.append((r,c))
        dir_idx = (dir_idx + turn) % 4
    return pts


def main(grid):
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    assert bg == BG
    seed = np.argwhere(g == SEED_COLOR)
    marker = np.argwhere(g == MARKER_COLOR)
    assert seed.shape == (1,2)
    assert marker.shape == (1,2)
    sr, sc = map(int, seed[0])
    mr, mc = map(int, marker[0])
    dr0, dc0 = mr-sr, mc-sc
    assert (dr0,dc0) in DIR_TO_INDEX
    dir_idx = DIR_TO_INDEX[(dr0,dc0)]

    bar_rows = []
    for r in range(g.shape[0]):
        cols = np.flatnonzero(g[r] "'!= bg)
        if cols.size == 0:
            continue
        colors = set(map(int, g[r, cols]))
        if colors <= set(TURN_BY_COLOR):
            if cols.size < 2:
                raise AssertionError('"'bar too short')
            if len(colors) "'!= 1:
                raise AssertionError('"'bar row must be monochrome')
            if not np.array_equal(cols, np.arange(cols[0], cols[-1] + 1)):
                raise AssertionError('bar row must be contiguous')
            bar_rows.append(r)
    assert len(bar_rows) >= 3
    assert all(b - a == 2 for a,b in zip(bar_rows, bar_rows[1:]))

    out = g.copy()
    r, c = sr, sc
    for row in bar_rows:
        cols = np.flatnonzero(g[row] "'!= bg)
        color = int(g[row, cols[0]])
        step = TURN_BY_COLOR[color]
        dr, dc = DIRS[dir_idx]
        for _ in range(len(cols)):
            r += dr
            c += dc
            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]
            cell = int(g[r, c])
            assert cell in (bg, SEED_COLOR, MARKER_COLOR)
            out[r, c] = SEED_COLOR
        dir_idx = (dir_idx + step) % 4
    return out


def paint(grid, seed, path):
    out = grid.copy()
    for r,c in path:
        out[r,c] = SEED_COLOR
    return out


def build():
    for _ in range(2000):
        n = random.randint(4, 6)
        first_row = random.choice([1,2])
        lengths = [random.randint(2, 6) for _ in range(n)]
        if len(set(lengths)) < 2:
            continue
        turns = [random.choice([1,-1]) for _ in range(n)]
        if 1 not in turns[:-1] or -1 not in turns[:-1]:
            continue
        init_dir = random.randrange(4)
        rel_path = trace(lengths, turns, init_dir)
        if len(set(rel_path)) != len(rel_path):
            continue
        if (0,0) in rel_path:
            continue
        all_pts = [(0,0)] + rel_path
        rs = [r for r,_ in all_pts]; cs = [c for _,c in all_pts]
        if max(rs)-min(rs) < 4 or max(cs)-min(cs) < 4:
            continue
        bar_rows = [first_row + 2*i for i in range(n)]
        starts = [random.randint(0, 2) for _ in range(n)]
        max_bar_end = max(s+l-1 for s,l in zip(starts, lengths))
        min_r, max_r = min(rs), max(rs)
        min_c, max_c = min(cs), max(cs)
        path_left = max_bar_end + random.randint(3, 5)
        seed_c = path_left - min_c
        w = seed_c + max_c + random.randint(2, 4) + 1
        h = max(bar_rows[-1] + 2, max_r - min_r + random.randint(3,6))
        drr, dcc = DIRS[init_dir]
        valid_seed_rows = [r for r in range(1 - min_r, h - max_r) if r not in bar_rows and r+drr not in bar_rows]
        if not valid_seed_rows:
            continue
        seed_r = random.choice(valid_seed_rows)
        if max(h,w) > 30:
            continue
        grid = np.zeros((h,w), dtype=int)
        for row, start, length, turn in zip(bar_rows, starts, lengths, turns):
            color = TURN_RIGHT_COLOR if turn == 1 else TURN_LEFT_COLOR
            grid[row, start:start+length] = color
        sr, sc = seed_r, seed_c
        mr, mc = sr+drr, sc+dcc
        abs_path = [(sr+r, sc+c) for r,c in rel_path]
        all_abs = [(sr,sc)] + abs_path
        if min(r for r,_ in all_abs) < 0 or max(r for r,_ in all_abs) >= h or min(c for _,c in all_abs) < 0 or max(c for _,c in all_abs) >= w:
            continue
        bad = False
        for idx,(r,c) in enumerate(abs_path):
            cell = grid[r,c]
            if idx == 0:
                if (r,c) != (mr,mc):
                    bad = True; break
            if cell not in (BG,):
                bad = True; break
        if bad:
            continue
        if grid[sr,sc] != BG or grid[mr,mc] != BG:
            continue
        grid[sr,sc] = SEED_COLOR
        grid[mr,mc] = MARKER_COLOR
        correct = main(grid)
        expected = paint(grid, (sr,sc), abs_path)
        if not np.array_equal(correct, expected):
            continue
        alts = []
        for alt_turns, alt_dir, alt_lengths in [
            ([-t for t in turns], init_dir, lengths),
            (turns, (init_dir+2)%4, lengths),
            (turns[::-1], init_dir, lengths[::-1]),
            ([1]*n, init_dir, lengths),
            ([-1]*n, init_dir, lengths),
        ]:
            p = trace(alt_lengths, alt_turns, alt_dir)
            if len(set(p)) != len(p):
                alts.append(None); continue
            abs_p = [(sr+r, sc+c) for r,c in p]
            if min(r for r,_ in abs_p+[ (sr,sc) ]) < 0 or max(r for r,_ in abs_p+[ (sr,sc) ]) >= h or min(c for _,c in abs_p+[ (sr,sc) ]) < 0 or max(c for _,c in abs_p+[ (sr,sc) ]) >= w:
                alts.append(None); continue
            ok = True
            for r,c in abs_p:
                if grid[r,c] not in (BG, SEED_COLOR, MARKER_COLOR):
                    ok = False
                    break
            alts.append(frozenset(abs_p) if ok else None)
        correct_set = frozenset(abs_path)
        if any(alt == correct_set for alt in alts):
            continue
        return grid
    raise RuntimeError('"'fail')

for i in range(20):
    g = build()
    o = main(g)
    print(i, g.shape, np.count_nonzero(o==SEED_COLOR))
print('done')
