+    if min(r for r, _ in all_abs) < 0 or max(r for r, _ in all_abs) >= height:
+        return None
+    if min(c for _, c in all_abs) < 0 or max(c for _, c in all_abs) >= width:
+        return None
+    if abs_path[0] != marker_pos:
+        return None
+    if grid[seed_pos] != BG or grid[marker_pos] != BG:
+        return None
+
+    for r, c in abs_path:
+        if int(grid[r, c]) != BG:
