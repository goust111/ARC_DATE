spec:
  grid:
    background: black
    height: 2 * (first_src_row + num_bars - 1), giving 4-10
    width: 3-12, must be > marker_col
  marker:
    single grey (5) pixel in row 0 at marker_col
    marker_col: 2-9, all other row-0 cells are black
  bars:
    count: 1-4 horizontal monochrome bars on black background
    row_placement: every other row starting at first_src_row (1 or 2), spacing exactly 2
    each bar is contiguous, monochrome, length 2-5, entirely left of marker_col
    start_col: 0-2 (varies per bar)
    color: any non-black ARC color (1-9 including grey); bars may share colors
