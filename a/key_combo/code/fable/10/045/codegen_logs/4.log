+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+OUTLINE_COLORS = [1, 2, 3, 5, 6, 7, 8, 9]
+SIDE_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
