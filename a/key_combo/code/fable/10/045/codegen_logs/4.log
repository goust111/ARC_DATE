+            cells = [start]
+            union_ray_cells.add(start)
+            if out[start] == BLACK:
+                out[start] = YELLOW
+            current = start
+            reason = "boundary"
+            target = None
+            while True:
+                nr = current[0] + step[0]
+                nc = current[1] + step[1]
+                if not in_bounds(out.shape, nr, nc):
+                    boundary_stops += 1
+                    reason = "boundary"
+                    break
+                if (nr, nc) in wall_cells:
+                    wall_stops += 1
+                    reason = "wall"
+                    break
+                current = (nr, nc)
+                cells.append(current)
+                union_ray_cells.add(current)
