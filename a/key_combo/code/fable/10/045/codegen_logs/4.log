+    charged = []
+    for idx, cup in enumerate(cups):
+        inside_vals = {int(g[r, c]) for r, c in cup.interior}
+        assert inside_vals <= {BLACK, YELLOW}
+        if inside_vals == {YELLOW}:
+            charged.append(idx)
+        else:
+            assert inside_vals == {BLACK}
