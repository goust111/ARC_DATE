+def compatible_target_sides(incoming: Coord) -> list[str]:
+    dr, dc = incoming
+    sides = []
+    if dr == 1:
+        sides.append("top")
+    if dr == -1:
+        sides.append("bottom")
+    if dc == 1:
+        sides.append("left")
+    if dc == -1:
