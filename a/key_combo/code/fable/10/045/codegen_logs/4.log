+            valid_offsets = [k for k in range(1, cup_w - 1) if 1 <= k + incoming[1] <= cup_w - 2]
+        else:
+            valid_offsets = [k for k in range(1, cup_h - 1) if 1 <= k + incoming[0] <= cup_h - 2]
