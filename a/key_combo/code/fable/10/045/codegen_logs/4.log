+                offsets = sorted(c - c0 for _, c in opening_set)
+                side_len = c1 - c0 + 1
+            elif all(r == r1 for r, _ in opening_set):
+                side = "bottom"
+                offsets = sorted(c - c0 for _, c in opening_set)
+                side_len = c1 - c0 + 1
+            elif all(c == c0 for _, c in opening_set):
+                side = "left"
+                offsets = sorted(r - r0 for r, _ in opening_set)
+                side_len = r1 - r0 + 1
+            else:
+                assert all(c == c1 for _, c in opening_set)
