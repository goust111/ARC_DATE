0044:     r0, c0, r1, c1 = frame_bbox
0045:     mr0, mc0, mr1, mc1 = marker_bbox
0046:     assert r0 < mr0 <= mr1 < r1
0047:     assert c0 < mc0 <= mc1 < c1
0048: 
0049:     frame_mask = np.zeros_like(g, dtype=bool)
0050:     frame_mask[r0 : r1 + 1, c0] = True
0051:     frame_mask[r0 : r1 + 1, c1] = True
0052:     frame_mask[r0, c0 : c1 + 1] = True
0053:     frame_mask[r1, c0 : c1 + 1] = True
0054:     assert np.array_equal(g == frame_color, frame_mask)
