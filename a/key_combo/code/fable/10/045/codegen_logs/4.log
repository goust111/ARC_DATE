+
+@dataclass(frozen=True)
+class Cup:
+    color: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    side: str
+    open_start: int
+    open_len: int
+    opening: tuple[Coord, ...]
+    walls: frozenset[Coord]
+    interior: frozenset[Coord]
+    footprint: frozenset[Coord]
