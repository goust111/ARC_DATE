+def sort_opening(side: str, cells: Iterable[Coord]) -> tuple[Coord, ...]:
+    if side in ("top", "bottom"):
+        return tuple(sorted(cells, key=lambda rc: rc[1]))
+    return tuple(sorted(cells, key=lambda rc: rc[0]))
