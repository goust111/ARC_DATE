+def boxes_with_margin_intersect(a: Cup, b: Cup, margin: int = 1) -> bool:
+    return not (
+        a.r1 + margin < b.r0 - margin
+        or b.r1 + margin < a.r0 - margin
+        or a.c1 + margin < b.c0 - margin
+        or b.c1 + margin < a.c0 - margin
+    )
