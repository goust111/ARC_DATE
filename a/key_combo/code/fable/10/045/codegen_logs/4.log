+                    r0=r0,
+                    c0=c0,
+                    r1=r1,
+                    c1=c1,
+                    side=side,
+                    open_start=offsets[0],
+                    open_len=len(offsets),
+                    opening=opening,
+                    walls=frozenset(wall_set),
+                    interior=interior,
