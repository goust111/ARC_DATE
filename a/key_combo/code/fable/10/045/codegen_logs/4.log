+        if not placed:
+            return None
+
+    start_idx = 0
+    base_input = render_input(cups, start_idx)
+    _, reach_stats = simulate(base_input, cups, start_idx)
+    if len(reach_stats["charged"]) != reachable_count or reach_stats["max_depth"] < 2:
