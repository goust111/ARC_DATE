+    return out, {
+        "charged": charged,
+        "parent": parent,
+        "depth": depth,
+        "max_depth": max(depth.values()),
+        "traces": traces,
+        "ray_cells": union_ray_cells,
+        "wall_stops": wall_stops,
+        "boundary_stops": boundary_stops,
