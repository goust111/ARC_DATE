0011: # In the input you will see a grey rectangle and colored pixels scattered around it.
0012: # To make the output, move each colored pixel toward the grey rectangle until it touches, then turn its color to gray. If multiple colored pixels collide, they stack.
0013: 
0014: def main(input_grid):
0015:     """
0016:     Pull each colored pixel toward the gray rectangle until it touches the accumulated gray mass, then recolor it gray.
0017: 
0018:     Input structure:
0019:     - The grid contains exactly one gray rectangle or bar on a black background.
0020:     - Other non-black, non-gray objects are colored pixels or small objects around it.
0021:     - Objects may appear on any side after rotation.
0022: 
0023:     Rule:
0024:     - Detect the gray object and all other colored objects.
0025:     - For each colored object, find the shortest cardinal displacement that would make it touch the gray object.
0026:     - Move it in that direction until the next step would collide, recolor it gray, and paste it.
0027: 
0028:     Key insight:
0029:     - The gray rectangle acts as both magnet and accumulator; previously moved objects affect
0030:       where later objects stop.
0031:     """
0032:     # Plan:
0033:     # 1. Detect the objects; separate the gray rectangle from the other pixels
0034:     # 2. Move each colored pixel toward the gray rectangle until it touches
0035:     # 3. Change its color once it touches
0036: 
0037:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0038: 
0039:     grey_objects = [ obj for obj in objects if Color.GREY in colors_present(obj, exclude={ Color.BLACK }) ]
0040:     other_objects = [ obj for obj in objects if Color.GREY not in colors_present(obj, exclude={ Color.BLACK }) ]
0041: 
0042:     assert len(grey_objects) == 1, "There should be exactly one grey object"
0043:     
0044:     grey_object = grey_objects[0]
0045: 
0046:     # Make the output grid: Start with the gray object, then add the colored pixels one-by-one
0047:     output_grid = np.full_like(input_grid, Color.BLACK)
0048:     paste(output_grid, grey_object, 0, 0, transparent=Color.BLACK, clip=True)
0049: 
0050:     # Move the colored objects and change their color once they hit grey
0051:     for colored_object in other_objects:
0052:         # First calculate what direction we have to move in order to contact the grey object
0053:         # Consider all displacements, starting with the smallest translations first
0054:         possible_displacements = [ (i*dr, i*dc) for i in range(0, 30) for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)] ]
0055: 
0056:         # Only keep the displacements that cause a contact between the colored object and the grey object
0057:         valid_displacements = [ displacement for displacement in possible_displacements
0058:                                 if contact(object1=translate(colored_object, *displacement), object2=grey_object) ]
0059:         assert valid_displacements, "There should be at least one valid displacement"
0060: 
0061:         # Pick the smallest valid displacement
0062:         displacement = min(valid_displacements, key=lambda displacement: sum(abs(r) for r in displacement))
0063: 
0064:         # Extract the direction from the displacement
0065:         direction = np.sign(displacement, dtype=int)
0066: 
0067:         # Now move the colored object in that direction until there is a collision with something else
0068:         if not all( delta == 0 for delta in direction ):
0069:             while not collision(object1=translate(colored_object, *direction), object2=output_grid):
0070:                 colored_object = translate(colored_object, *direction)
0071:         
0072:         # Finally change the color of the colored object to grey anne draw it onto the outlet
0073:         colored_object[colored_object != Color.BLACK] = Color.GREY
0074:         paste(output_grid, colored_object, 0, 0, transparent=Color.BLACK, clip=True)
0075:     
0076:     return output_grid
