1264:     best, best_score = [], 0.0
1265:     for sym in r_poss + c_poss + rc_poss:
1266:         perfectly_preserved, outside_canvas, conflict = _score_symmetry(grid, sym, ignore_colors, background=background)
1267:         score = perfectly_preserved - 0.01 * outside_canvas - 10000 * conflict
1268:         if conflict > 0 or perfectly_preserved == 0:
1269:             continue
1270:         if score > best_score:
