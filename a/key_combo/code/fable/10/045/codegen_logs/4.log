+                        charged.add(cup_idx)
+                        parent[cup_idx] = src
+                        depth[cup_idx] = depth[src] + 1
+                        for rr, cc in cups[cup_idx].interior:
+                            out[rr, cc] = YELLOW
+                        queue.append(cup_idx)
+                    break
+            traces[(src, ray_idx)] = {
