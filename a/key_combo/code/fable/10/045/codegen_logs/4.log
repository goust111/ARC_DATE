+def ray_specs(cup: Cup) -> list[tuple[Coord, Coord]]:
+    opening = list(cup.opening)
+    center = opening[len(opening) // 2]
+    if cup.side == "top":
+        return [(center, (-1, 0)), (opening[0], (-1, -1)), (opening[-1], (-1, 1))]
