+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+WALL_COLOR = BLUE
+DOOR_COLOR = GREEN
+MARKER_COLOR = YELLOW
+CORRIDOR_COLORS = (BLACK, TEAL, PINK, ORANGE)
+TOGGLE = {
+    BLACK: TEAL,
+    TEAL: BLACK,
+    PINK: ORANGE,
+    ORANGE: PINK,
+}
+
+GEN_RETRIES = 500
+GRID_MIN = 18
+GRID_MAX = 30
+WALL_COUNT_RANGE = (3, 5)
+WALL_MIN_GAP = 3
+WALL_MARGIN = 4
+DOOR_MARGIN = 3
+MARKER_EDGE_RANGE = (1, 3)
+NOISE_RATE_RANGE = (0.08, 0.2)
