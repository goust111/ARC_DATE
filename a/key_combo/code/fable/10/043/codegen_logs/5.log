spec:
  grid: 6-10 rows x 9 cols [observed]
  background:
    colors: BLACK(0) and PINK(6) only, roughly balanced random fill
  yellow_markers:
    count: 1-3 pairs on exactly one axis (row OR column)
    row_axis: YELLOW at (r,0) and (r,w-1) for each selected row
    col_axis: YELLOW at (0,c) and (h-1,c) for each selected column
    position: never on first/last index of the marker axis; min spacing >=2
    no_other_yellow: all YELLOW pixels are paired markers, none elsewhere
  segment_interior:
