+    lr_marker = (target[0], 0 if rng.random() < 0.5 else w - 1)
+    grid[tb_marker] = YELLOW
+    grid[lr_marker] = YELLOW
+
+    specs = []
+    occupied_in = {tb_marker, lr_marker}
+    occupied_out = {tb_marker, lr_marker}
+
+    for ray, rot in zip(rays, rotations):
