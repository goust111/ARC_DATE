+    pointers = []
+    for pivot in pivots:
+        pr, pc = pivot
+        adjacent = []
+        for nr, nc in _neighbors4(pr, pc):
+            if _in_bounds(g.shape, nr, nc) and int(g[nr, nc]) == RED:
