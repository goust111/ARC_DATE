+    h, w = shape
+    tr, tc = target
+    if ray == "left":
+        return tc - 1
+    if ray == "right":
+        return w - 2 - tc
+    if ray == "up":
+        return tr - 1
+    if ray == "down":
+        return h - 2 - tr
+    raise AssertionError("unknown ray")
+
