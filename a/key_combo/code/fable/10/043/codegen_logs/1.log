+def _validate_generated(inp: np.ndarray, expected: np.ndarray, specs: list[dict]) -> bool:
+    try:
+        target, _tb, _lr = _extract_markers(inp)
+        parsed = _parse_pointers(inp, target)
+        actual = main(inp)
+    except Exception:
