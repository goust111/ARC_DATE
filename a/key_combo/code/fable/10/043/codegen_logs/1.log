+    w = rng.randint(GRID_MIN, GRID_MAX)
+    target = (rng.randint(3, h - 4), rng.randint(3, w - 4))
+
+    n_bars = 4 if rng.random() < 0.6 else 3
+    rays = rng.sample(RAYS, n_bars)
+    rotations = rng.sample([0, 1, 2, 3], n_bars)
+    rng.shuffle(rays)
