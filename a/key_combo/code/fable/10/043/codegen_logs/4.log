+        for w in range(MASK_W_RANGE[0], min(MASK_W_RANGE[1], width - 1) + 1):
+            for r0 in range(height - h + 1):
+                for c0 in range(width - w + 1):
+                    c1 = c0 + w - 1
+                    if c1 >= axis and c0 <= axis:
+                        continue
