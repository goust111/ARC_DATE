+        gr0 = pr0 + r0
+        gc0 = pc0 + c0
+        gr1 = pr0 + r1
+        gc1 = pc0 + c1
+        grid[gr0 : gr1 + 1, gc0 : gc1 + 1] = mask_color
+        occupied[gr0 : gr1 + 1, gc0 : gc1 + 1] = True
+
+        if _scatter_pieces(grid, occupied, pieces, rng):
+            return grid
+
+    return None
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    bg: int,
+    pattern: np.ndarray,
+    rect: tuple[int, int, int, int],
+    pieces: list[dict],
+) -> bool:
