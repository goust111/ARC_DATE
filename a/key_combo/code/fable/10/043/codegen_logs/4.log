+        assert chosen is not None and chosen_opts is not None
+        nxt = tuple(idx for idx in remaining if idx != chosen)
+        for option in chosen_opts:
+            changed = []
+            for r, c, color in option:
+                covered[r, c] = True
+                painted[r, c] = color
+                changed.append((r, c))
+            rec(nxt)
+            for r, c in changed:
+                covered[r, c] = False
+                painted[r, c] = bg
+            if len(found) >= limit:
