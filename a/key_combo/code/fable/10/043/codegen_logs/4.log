+                    area = int(sub.sum())
+                    if area < HIDDEN_AREA_RANGE[0] or area > HIDDEN_AREA_RANGE[1]:
+                        continue
+                    if area == h * w:
+                        continue
+                    comps = _local_components(sub)
+                    if len(comps) != 1:
