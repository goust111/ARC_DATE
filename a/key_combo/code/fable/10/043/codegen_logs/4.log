+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+
+    r0, c0, r1, c1 = rect
+    slot_mask = pattern[r0 : r1 + 1, c0 : c1 + 1] != bg
+    if not (0 < int(slot_mask.sum()) < slot_mask.size):
+        return False
+    if len(pieces) < 2:
+        return False
+    if sum(piece["area"] for piece in pieces) != int(slot_mask.sum()):
+        return False
+
