+GEN_ATTEMPTS = 800
+BG_CHOICES = tuple(range(10))
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (20, 30)
+PATTERN_H_RANGE = (8, 13)
+PATTERN_W_OPTIONS = (9, 11, 13, 15)
+MASK_H_RANGE = (3, 6)
+MASK_W_RANGE = (3, 5)
+HIDDEN_AREA_RANGE = (6, 14)
+PIECE_COUNT_RANGE = (2, 4)
+
