+            counts = np.bincount(values, minlength=10)
+            best = int(counts.max())
+            winners = np.flatnonzero(counts == best)
+            if winners.size != 1:
+                return None
+            tile[rr, cc] = int(winners[0])
+            score += best
+
+    return _render_tile(tile, height, width), score
+
+
+def _candidate_scores(grid: np.ndarray) -> list[tuple[int, int, int]]:
