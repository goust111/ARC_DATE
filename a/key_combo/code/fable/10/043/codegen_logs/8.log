+        max_shape_w = (clean.shape[1] + 1) // 2
+        shape = _sample_shape(max_shape_h, max_shape_w)
+        if shape is None:
+            continue
+
+        embedded = _embed_violations(clean, shape)
+        if embedded is None:
+            continue
