+    W = random.randint(max(GRID_RANGE[0], box_w + 6), GRID_RANGE[1])
+    if H > 30 or W > 30:
+        return None
+
+    grid = np.full((H, W), bg, dtype=int)
+    legend_r0 = random.randint(1, H - box_h - 1)
+    legend_c0 = random.randint(1, W - box_w - 1)
