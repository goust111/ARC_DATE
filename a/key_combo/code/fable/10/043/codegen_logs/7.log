+    for c0 in cols:
+        if c0 is None or c0 < 0 or c0 + w > W:
+            continue
+        for r0 in rows:
+            cand = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(_expanded_overlap(cand, box, gap=1) for box in placed_boxes):
