    valid_c = list(range(ODD_ANCHOR_START, max_c + 1, LATTICE_STEP))
    if not valid_r or not valid_c:
        return None

    r0 = random.choice(valid_r)
    c0 = random.choice(valid_c)
    return _pixel_bbox(r0, c0, h_l, w_l)


