+    grid = np.zeros((h, w), dtype=int)
+    objects: list[dict] = []
+    for idx, target in enumerate(layer_targets):
+        region = (capture == target) & safe
+        if layer_area[target] < 3:
+            raise RuntimeError("degenerate layer")
+        success = False
+        for _ in range(60):
