+        outer_h = rects[0][2] - rects[0][0] + 1
+        outer_w = rects[0][3] - rects[0][1] + 1
+        margin_top = int(_RNG.integers(2, 5))
+        margin_bottom = int(_RNG.integers(2, 5))
+        margin_left = int(_RNG.integers(2, 5))
+        margin_right = int(_RNG.integers(2, 5))
