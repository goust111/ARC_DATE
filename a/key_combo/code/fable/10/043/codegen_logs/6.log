+def _find_marker_rectangles(grid: np.ndarray, bg: int) -> tuple[list[tuple[int, int, int, int, int]], np.ndarray]:
+    marker_mask = np.zeros_like(grid, dtype=bool)
+    rectangles: list[tuple[int, int, int, int, int]] = []
