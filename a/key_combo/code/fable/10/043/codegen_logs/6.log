+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        try:
+            return _gen_attempt()
+        except RuntimeError:
+            continue
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid virtual-rectangle parity sample")

