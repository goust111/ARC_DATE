+            shape_mask = _transforms(base)[int(_RNG.integers(0, len(_transforms(base))))]
+            if int(shape_mask.sum()) < 3:
+                continue
+            candidates = _find_candidates(region, blocked, shape_mask)
+            if not candidates:
+                continue
+            r, c = candidates[int(_RNG.integers(0, len(candidates)))]
