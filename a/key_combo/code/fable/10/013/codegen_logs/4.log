+            color = int(g[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(g.shape, rr, cc):
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            coords_arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
