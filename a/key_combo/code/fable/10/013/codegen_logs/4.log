spec:
  grid: 5-9 rows x 6-9 cols
  colors:
    bg: 0 (black) [observed]
    frame: 5 (grey) [observed]
    fill: 8 (azure) [observed]
    exactly 2 non-bg colors required by solver
  u_frame:
    shape: open-top U — left wall, right wall, bottom bar; no top bar
    frame_height: 4-8 (bbox height)
    frame_width: 4-7 (bbox width)
    pixels: exactly left_wall + right_wall + bottom_bar, no extras
    bottom row of frame touches bottom row of grid [observed]
    margins: top 1-2, left 1-2, right 1-2, bottom 0 [observed]
  interior:
    region: rows r0..r1-1, cols c0+1..c1-1 (inside walls, above bottom bar)
    height: 3-7 rows
    width: 2-5 cols
    content: solid fill-color rectangle at bottom, bg above
    empty_rows: 1-9 (bg rows above fill); must be >=1 and <=9
    filled_rows: >=1 (fill rows at bottom)
  output:
    always 3x3
    clockwise spiral from top-left painted with fill_color for empty_rows cells
    spiral order: (0,0)(0,1)(0,2)(1,2)(2,2)(2,1)(2,0)(1,0)(1,1)
