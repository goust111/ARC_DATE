+            common_los[group_idx] = max(common_los[group_idx], lo)
+            common_his[group_idx] = min(common_his[group_idx], hi)
+            center_sums[group_idx] += (lo + hi) / 2.0
+            counts[group_idx] += 1
+        else:
+            groups.append([idx])
+            common_los.append(lo)
+            common_his.append(hi)
+            center_sums.append((lo + hi) / 2.0)
