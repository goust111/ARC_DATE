+def _compact_rectangles(rectangles: list[tuple[int, tuple[int, int, int, int]]]) -> np.ndarray:
+    row_by_rect, row_count = _overlap_groups(
+        [(idx, box[0], box[2]) for idx, (_color, box) in enumerate(rectangles)]
