+    span = end - start + 1
+    common = int(rng.integers(start, end + 1))
+    intervals: list[tuple[int, int]] = []
+    for _ in range(count):
+        length = int(rng.integers(min_len, min(max_len, span) + 1))
+        lo_min = max(start, common - length + 1)
+        lo_max = min(common, end - length + 1)
