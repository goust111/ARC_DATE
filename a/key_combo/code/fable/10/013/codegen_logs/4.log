+from __future__ import annotations
+
+import hashlib
+from collections import Counter, deque
+
+import numpy as np
+
+
+_BG = 0
+_PALETTE = tuple(range(1, 10))
+_MIN_RECT_SIDE = 3
+_MAX_RECT_SIDE = 6
+_GRID_MIN = 22
+_GRID_MAX = 30
+_ROWS_RANGE = (2, 4)
+_COLS_RANGE = (2, 4)
+_GAP_RANGE = (2, 3)
+_BORDER_RANGE = (1, 3)
+_SCALE_MIN = 2
+_SCALE_MAX = 7
+_MAX_ATTEMPTS = 4000
+
+_RNG = np.random.default_rng()
+_SEEN_INPUT_SIGNATURES: set[str] = set()
+_SEEN_OUTPUT_SIGNATURES: set[str] = set()
