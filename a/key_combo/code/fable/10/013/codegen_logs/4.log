+    for color in colors[:scale]:
+        candidates = _singleton_candidates(grid, _BG)
+        if not candidates:
+            return []
+        r, c = candidates[int(rng.integers(0, len(candidates)))]
+        grid[r, c] = int(color)
+        placed.append((r, c))
+    return placed
+
