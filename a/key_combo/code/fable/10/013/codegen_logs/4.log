+    pos = border + int(extras[0])
+    extents: list[tuple[int, int]] = []
+    for idx, length in enumerate(lengths):
+        start = pos
+        end = start + length - 1
+        extents.append((start, end))
+        pos = end + 1
+        if idx < count - 1:
+            pos += gap + int(extras[idx + 1])
+    return extents
