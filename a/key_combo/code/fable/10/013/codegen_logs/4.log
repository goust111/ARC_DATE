+
+def _generate_case(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    rows = int(rng.integers(_ROWS_RANGE[0], _ROWS_RANGE[1] + 1))
+    cols = int(rng.integers(_COLS_RANGE[0], _COLS_RANGE[1] + 1))
