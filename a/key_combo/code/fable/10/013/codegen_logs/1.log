+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.add((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
