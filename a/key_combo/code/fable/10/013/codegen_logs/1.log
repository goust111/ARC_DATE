+    placements = []
+    for shape in shapes:
+        placed = False
+        sh, sw = shape["visible"].shape
+        for _ in range(PLACEMENT_ATTEMPTS):
+            top = random.randint(1, grid_h - sh - 1)
+            left = random.randint(1, grid_w - sw - 1)
