+def _paint_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> set[tuple[int, int]]:
+    placed = set()
+    for r, c in np.argwhere(mask > 0):
+        rr, cc = top + int(r), left + int(c)
+        grid[rr, cc] = color
+        placed.add((rr, cc))
