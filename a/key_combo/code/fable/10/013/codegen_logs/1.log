+            return None
+        if set(match["full_coords"]) != placement["full_coords"]:
+            return None
+
+    damaged = [p for p in placements if int(p["missing"]) > 0]
+    intact = [p for p in placements if int(p["missing"]) == 0]
+    if len(damaged) != 1 or len(intact) != 1:
