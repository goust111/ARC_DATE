+
+
+def _can_place(existing: np.ndarray, mask: np.ndarray, top: int, left: int) -> bool:
+    h, w = mask.shape
+    gh, gw = existing.shape
+    if top < 0 or left < 0 or top + h > gh or left + w > gw:
