spec:
  grid: 3x3, black background
  input:
    colors: only black (0) and blue (1)
    blue_count: 1-4 pixels scattered anywhere on the 3x3 grid
    placement: blue pixels must NOT already be in the tally pattern (see output)
  output:
    colors: only black (0) and red (2)
    red_count: equals blue_count from input
    tally_pattern: |
      first n cells filled red in order: (0,0), (0,1), (0,2), (1,1)
      n=1: top-left only
      n=2: top-left + top-center
      n=3: full top row
      n=4: full top row + center
    all non-tally cells: black
  transform: count blue pixels, clear grid, paint that many red cells in tally order

generation_strategy:
  approach: direct random (task is simple enough)
  steps:
    1. Pick blue_count uniformly from {1, 2, 3, 4}
    2. Choose blue_count distinct cells from the 9 cells of a 3x3 grid
    3. Reject if chosen cells exactly equal the first blue_count tally cells (rare edge case)
    4. Fill a 3x3 black grid with blue at chosen positions
```
