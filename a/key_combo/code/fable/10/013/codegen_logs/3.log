0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Stretch the colored rectangular frame outward until its far edge reaches the lone marker pixel.
0009: 
0010:     Input structure
0011:     - The background is the most common color.
0012:     - A single marker pixel is the only foreground color that appears once.
0013:     - All other foreground pixels form one solid rectangular frame with one border color and one interior color.
0014: 
0015:     Rule
0016:     - If the marker is above or below the frame and its column lies within the frame, extend the frame vertically to the marker row.
0017:     - If the marker is left or right of the frame and its row lies within the frame, extend the frame horizontally to the marker column.
0018:     - Redraw the expanded rectangle with the same border and interior colors; everything outside remains background.
0019: 
0020:     Key insight
0021:     The marker selects which side of the rectangle moves and where the new outer border lies; it is consumed by that border.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     bg = get_bg(g)
0025: 
0026:     colors = colors_present(g, exclude={bg})
0027:     singleton_colors = [color for color in colors if int((g == color).sum()) == 1]
0028:     assert len(singleton_colors) == 1
0029:     marker_color = singleton_colors[0]
0030:     marker_coords = np.argwhere(g == marker_color)
0031:     assert marker_coords.shape == (1, 2)
0032:     marker_r, marker_c = map(int, marker_coords[0])
0033: 
0034:     frame_mask = (g != bg) & (g != marker_color)
0035:     frame_components = components_mask(frame_mask, connectivity=4)
0036:     assert len(frame_components) == 1
0037:     frame_bbox = bbox(frame_mask)
0038:     assert frame_bbox is not None
0039:     r0, c0, r1, c1 = frame_bbox
0040:     assert r1 - r0 + 1 >= 3
0041:     assert c1 - c0 + 1 >= 3
0042: 
0043:     frame = g[r0 : r1 + 1, c0 : c1 + 1]
0044:     h, w = frame.shape
0045:     edge_mask = np.zeros((h, w), dtype=bool)
0046:     edge_mask[0, :] = True
0047:     edge_mask[-1, :] = True
0048:     edge_mask[:, 0] = True
0049:     edge_mask[:, -1] = True
0050: 
0051:     border_colors = set(map(int, frame[edge_mask]))
0052:     interior_colors = set(map(int, frame[~edge_mask]))
0053:     assert len(border_colors) == 1
0054:     assert len(interior_colors) == 1
0055:     border_color = border_colors.pop()
0056:     interior_color = interior_colors.pop()
0057:     assert border_color != bg
0058:     assert interior_color != bg
0059:     assert border_color != interior_color
0060: 
0061:     expected_frame = np.full_like(frame, interior_color)
0062:     expected_frame[edge_mask] = border_color
0063:     assert np.array_equal(frame, expected_frame)
0064: 
0065:     expanded_boxes = []
0066:     if marker_r < r0 and c0 <= marker_c <= c1:
0067:         expanded_boxes.append((marker_r, c0, r1, c1))
0068:     if marker_r > r1 and c0 <= marker_c <= c1:
0069:         expanded_boxes.append((r0, c0, marker_r, c1))
0070:     if marker_c < c0 and r0 <= marker_r <= r1:
0071:         expanded_boxes.append((r0, marker_c, r1, c1))
0072:     if marker_c > c1 and r0 <= marker_r <= r1:
0073:         expanded_boxes.append((r0, c0, r1, marker_c))
0074:     assert len(expanded_boxes) == 1
0075:     nr0, nc0, nr1, nc1 = expanded_boxes[0]
0076:     assert 0 <= nr0 <= nr1 < g.shape[0]
0077:     assert 0 <= nc0 <= nc1 < g.shape[1]
0078:     assert nr1 - nr0 + 1 >= 3
0079:     assert nc1 - nc0 + 1 >= 3
0080: 
