+    mr, mc = marker
+    sr, sc = moved_corner
+    if abs(mr - sr) != abs(mc - sc) or abs(mr - sr) < EXPANSION_MIN:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
