+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _edge_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _draw_framed_rectangle(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    border_color: int,
+    interior_color: int,
+) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0 : r1 + 1, c0 : c1 + 1] = interior_color
+    grid[r0, c0 : c1 + 1] = border_color
+    grid[r1, c0 : c1 + 1] = border_color
+    grid[r0 : r1 + 1, c0] = border_color
+    grid[r0 : r1 + 1, c1] = border_color
+
+
+def _rectangle_info(
+    grid: np.ndarray,
+    bg: int,
+    coords: np.ndarray,
+) -> dict[str, int | tuple[int, int, int, int]] | None:
+    box = _bbox_coords(coords)
+    r0, c0, r1, c1 = box
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3 or coords.shape[0] != h * w:
+        return None
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    mask = _edge_mask(h, w)
+    border_colors = set(map(int, sub[mask]))
+    interior_colors = set(map(int, sub[~mask]))
+    if len(border_colors) != 1 or len(interior_colors) != 1:
