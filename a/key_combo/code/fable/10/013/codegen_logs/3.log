0048: def main(grid: np.ndarray) -> np.ndarray:
0049:     """
0050:     Collapse the lattice of filled rectangular objects into a compact color grid.
0051: 
0052:     Input structure
0053:     - The input has a dominant background with scattered clutter colors.
0054:     - The meaningful objects are monochromatic 4-connected foreground rectangles, each at least 3x3 and exactly filling its bbox.
0055:     - These rectangles form a complete lattice whose same-row and same-column bbox intervals overlap.
0056: 
0057:     Rule
0058:     - Keep only the filled rectangular objects.
0059:     - Group their vertical bbox intervals into output rows and their horizontal bbox intervals into output columns.
0060:     - Fill each compact output cell with the color of the rectangle at the corresponding lattice position.
0061: 
0062:     Key insight
0063:     - The clutter is not a filled 3x3-or-larger rectangle; the rectangles' overlapping bbox bands define the small table axes.
0064:     """
0065:     g = np.asarray(grid, dtype=int)
0066:     assert g.ndim == 2 and g.size > 0, "expected a nonempty 2D grid"
0067: 
0068:     bg = get_bg(g)
0069:     rectangles: list[tuple[int, tuple[int, int, int, int]]] = []
0070:     for component in find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=9):
0071:         box = component["bbox"]
0072:         height = bbox_h(box)
0073:         width = bbox_w(box)
0074:         area = int(component["area"])
0075:         if height >= 3 and width >= 3 and area == height * width:
0076:             rectangles.append((int(component["color"]), box))
0077: 
0078:     assert rectangles, "expected filled rectangular objects"
0079: 
0080:     row_by_rect, row_count = _overlap_groups(
0081:         [(idx, box[0], box[2]) for idx, (_color, box) in enumerate(rectangles)]
0082:     )
0083:     col_by_rect, col_count = _overlap_groups(
0084:         [(idx, box[1], box[3]) for idx, (_color, box) in enumerate(rectangles)]
0085:     )
0086:     assert len(rectangles) == row_count * col_count, "expected a complete rectangle lattice"
0087: 
0088:     out = np.full((row_count, col_count), -1, dtype=int)
0089:     for idx, (color, _box) in enumerate(rectangles):
0090:         row = row_by_rect[idx]
0091:         col = col_by_rect[idx]
0092:         assert out[row, col] == -1, "expected one rectangle per lattice cell"
0093:         out[row, col] = color
0094: 
0095:     assert np.all(out >= 0), "expected every lattice cell to be occupied"
0096:     return out
