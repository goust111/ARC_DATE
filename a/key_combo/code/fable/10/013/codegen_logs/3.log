+    if not _can_place_pixel(grid, blocked_far, bg):
+        return None
+    grid[blocked_far] = marker_color
+
+    horiz = _pick_from_candidates(
+        grid,
+        bg,
+        _horizontal_misdirect_candidates(grid.shape, corner_name, rect_box, final_box),
