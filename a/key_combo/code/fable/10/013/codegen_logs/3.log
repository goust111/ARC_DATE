0008: def _overlap_groups(intervals: list[tuple[int, int, int]]) -> tuple[dict[int, int], int]:
0009:     group_items: list[list[int]] = []
0010:     common_los: list[int] = []
0011:     common_his: list[int] = []
0012:     center_sums: list[float] = []
0013:     counts: list[int] = []
0014: 
0015:     for idx, lo, hi in sorted(intervals, key=lambda item: (item[1], item[2], item[0])):
0016:         matches = [
0017:             group_idx
0018:             for group_idx in range(len(group_items))
0019:             if max(common_los[group_idx], lo) <= min(common_his[group_idx], hi)
0020:         ]
0021:         assert len(matches) <= 1, "expected each interval to belong to at most one band"
0022:         if matches:
0023:             group_idx = matches[0]
0024:             group_items[group_idx].append(idx)
0025:             common_los[group_idx] = max(common_los[group_idx], lo)
0026:             common_his[group_idx] = min(common_his[group_idx], hi)
0027:             center_sums[group_idx] += (lo + hi) / 2
0028:             counts[group_idx] += 1
0029:         else:
0030:             group_items.append([idx])
0031:             common_los.append(lo)
0032:             common_his.append(hi)
0033:             center_sums.append((lo + hi) / 2)
0034:             counts.append(1)
0035: 
0036:     assert group_items, "expected at least one interval group"
0037:     ordered = sorted(
0038:         range(len(group_items)),
0039:         key=lambda group_idx: center_sums[group_idx] / counts[group_idx],
0040:     )
0041:     index_to_rank: dict[int, int] = {}
0042:     for rank, group_idx in enumerate(ordered):
0043:         for idx in group_items[group_idx]:
0044:             index_to_rank[idx] = rank
0045:     return index_to_rank, len(group_items)
