+    for idx_a in range(len(sources)):
+        ra, ca, _ = sources[idx_a]
+        da = ra - ca
+        sa = ra + ca
+        pa = (ra + ca) % 2
+        for idx_b in range(idx_a + 1, len(sources)):
+            rb, cb, _ = sources[idx_b]
+            pb = (rb + cb) % 2
+            if pa != pb:
+                continue
