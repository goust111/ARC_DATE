    w = bbox_w(comp["bbox"])
    assert h != w, "seed bar must be non-square"
    assert int(comp["area"]) == h * w, "seed bar must be a solid rectangle"
    assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "seed bbox must be solid"

