    for obj in objects:
        assert obj["area"] == 3, "each object must contain three pixels"
        r0, c0, r1, c1 = obj["bbox"]
        assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2), "each object must fit a 2x2 box"

