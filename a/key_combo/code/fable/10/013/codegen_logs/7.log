+def _variants(tile: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(tile, dtype=int)
+    lr = np.fliplr(g)
+    ud = np.flipud(g)
+    rot = np.flipud(lr)
+    return [g, lr, ud, rot]
