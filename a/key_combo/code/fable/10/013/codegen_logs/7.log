  "src": "entire input grid as the source tile",
  "dst": "five horizontal tile slots in the output strip",
  "transform": "fill the slots left to right with [src, left-right reflection of src, src, left-right reflection of src, src]",
  "grid_shape": "same height as input; width multiplied by 5"
}
</annotation>
<generation_spec>
