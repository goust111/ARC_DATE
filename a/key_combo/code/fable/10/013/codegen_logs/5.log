+        if idx == 0:
+            top_choices = [r for r in range(0, height - frag["height"] + 1)]
+            top_choices = [r for r in top_choices if 1 <= r + frag["right_row"] <= height - 2] or top_choices
+            top = random.choice(top_choices)
+        else:
