+SEGMENT_COUNT_RANGE = (3, 5)
+GRID_HEIGHT_RANGE = (8, 12)
+LOCAL_HEIGHT_RANGE = (2, 4)
+SEGMENT_WIDTH_RANGE = (2, 6)
+INPUT_GAP_RANGE = (2, 4)
+MAX_TRIES = 400
