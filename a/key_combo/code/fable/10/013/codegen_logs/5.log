+    prev_area = None
+
+    for idx, color in enumerate(colors):
+        connector = None if idx == 0 else int(prev_right_abs)
+        min_area = len(colors) - idx + 2
+        frag = _random_fragment(color, used_areas, connector, height, max_area=prev_area, min_area=min_area)
+        if frag is None:
+            return None
