+    min_r = min(r for r, _ in path)
+    min_c = min(c for _, c in path)
+    coords = sorted({(r - min_r, c - min_c) for r, c in path})
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return {
