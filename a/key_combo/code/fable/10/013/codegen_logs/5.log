def flood_fill(grid: np.ndarray, r: int, c: int, color: int, *, connectivity: int = 4) -> None:
    """Flood fill region containing (r,c) with `color` (in-place)."""
    H, W = grid.shape
    r0 = int(r)
    c0 = int(c)
    if not (0 <= r0 < H and 0 <= c0 < W):
        return
