+
+        frag = dict(frag)
+        frag["bbox"] = (int(top), 0, int(top + frag["height"] - 1), int(frag["width"] - 1))
+        prev_right_abs = int(top + frag["right_row"])
+        prev_area = int(frag["area"])
+        used_areas.add(int(frag["area"]))
+        segments.append(frag)
