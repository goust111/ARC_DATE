+
+def _build_path_from_rows(rows: list[int]) -> list[Coord]:
+    path = [(int(rows[0]), 0)]
+    cur = int(rows[0])
+    for c in range(1, len(rows)):
+        target = int(rows[c])
+        step = 1 if target > cur else -1
+        while cur != target:
+            cur += step
+            path.append((cur, c - 1))
+        path.append((cur, c))
+    return path
