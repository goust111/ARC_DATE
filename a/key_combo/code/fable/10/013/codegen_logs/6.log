    else:
        frame_box = (nr0, nc0, nr1, nc1 - d)
        marker = (random.randint(nr0, nr1), nc1)
    return frame_box, marker


def _gen_render_pair(h, w, frame_box, expanded_box, marker, border_color, interior_color):
