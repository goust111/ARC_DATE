+    incoming: list[list[list[int]]] = [[[] for _ in range(3)] for _ in range(3)]
+    for pr, (r0, r1) in enumerate(row_bands):
+        for pc, (c0, c1) in enumerate(col_bands):
+            region = g[r0:r1, c0:c1]
+            color, missing = _parse_region(region, bg)
