+    coords = np.argwhere(region != bg)
+    assert coords.shape[0] == 3, "each region must contain exactly three foreground cells"
+    colors = set(map(int, region[region != bg]))
+    assert len(colors) == 1, "each L sprite must be monochrome"
+    color = colors.pop()
