def _gen_band_extents(rng: np.random.Generator, count: int) -> list[tuple[int, int]]:
    """Sample disjoint axis bands with enough span for rectangle intervals."""
    available = _GEN_N - _GEN_MIN_GAP * (count - 1)
    lengths: list[int] = []
    used = 0
