+
+def _sample_colors(sprite_choices: list[int]) -> list[list[int]]:
+    pool_size = random.randint(4, min(7, len(sprite_choices)))
+    pool = random.sample(sprite_choices, pool_size)
+    flat = [random.choice(pool) for _ in range(9)]
+    if len(set(flat)) < 4:
