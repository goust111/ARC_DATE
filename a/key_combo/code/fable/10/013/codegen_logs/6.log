+    raise RuntimeError(f"failed to sample missing-corner layout for mode={mode}")
+
+
+def _render_input(
+    bg: int,
+    sep: int,
+    row_heights: list[int],
+    col_widths: list[int],
+    colors: list[list[int]],
+    missings: list[list[tuple[int, int]]],
