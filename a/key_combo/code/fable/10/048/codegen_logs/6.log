+    col_seps = [c for c in range(w) if np.all(g[:, c] == SEPARATOR)]
+    assert len(row_seps) == 1, "expected exactly one horizontal separator row"
+    assert len(col_seps) == 2, "expected exactly two vertical separator columns"
