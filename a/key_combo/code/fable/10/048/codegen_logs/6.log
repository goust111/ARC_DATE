+        w = random.randint(2, min(4, n - 1))
+        r = random.randint(0, n - 1)
+        c0 = random.randint(0, n - w)
+        return [(r, c0 + dc) for dc in range(w)]
+    if kind == "vline":
+        h = random.randint(2, min(4, n - 1))
+        r0 = random.randint(0, n - h)
