+def _generate_case() -> np.ndarray | None:
+    n = random.randint(*PANEL_SIZE_RANGE)
+    pattern = _generate_pattern(n)
+    declared, mismatch_index, wrong_actual = _choose_orientations()
+    actual = declared[:]
+    actual[mismatch_index] = wrong_actual
+
+    panels = [
