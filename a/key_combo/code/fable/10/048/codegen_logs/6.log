+def _make_panel(pattern: np.ndarray, declared: int, actual: int) -> np.ndarray:
+    panel = rotate_cw(pattern, actual).copy()
+    r, c = CORNER_BY_ORIENTATION[int(declared)](int(pattern.shape[0]))
+    panel[r, c] = MARKER
+    return panel
