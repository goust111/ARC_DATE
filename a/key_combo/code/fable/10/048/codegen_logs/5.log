+    low = max(2, int(np.ceil(area * MASK_FILL_RATIO_RANGE[0])))
+    high = min(area - 2, int(np.floor(area * MASK_FILL_RATIO_RANGE[1])))
+    if low > high:
+        low, high = 2, area - 2
+
+    for _ in range(200):
