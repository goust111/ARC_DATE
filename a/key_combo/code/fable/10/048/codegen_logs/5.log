+        mask = np.zeros((h, w), dtype=bool)
+        seed = (random.randrange(h), random.randrange(w))
+        mask[seed] = True
+
+        while int(mask.sum()) < target:
+            frontier = []
+            for r, c in np.argwhere(mask):
+                for nr, nc in _neighbors4(int(r), int(c), h, w):
+                    if not mask[nr, nc]:
