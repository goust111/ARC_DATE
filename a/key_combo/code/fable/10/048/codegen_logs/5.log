+    return True
+
+
+def _sample_panels() -> tuple[np.ndarray, np.ndarray, str, bool]:
+    orientation = random.choice(("horizontal", "vertical"))
+    mask_first = random.choice((False, True))
+
+    if orientation == "horizontal":
