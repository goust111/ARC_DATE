+        non_bg = _non_bg_colors(panel, BACKGROUND)
+        if len(non_bg) < 2:
+            continue
+        if not np.any(panel == BACKGROUND):
+            continue
+        if not np.any(panel == mask_color):
+            continue
+        if not np.any((panel != BACKGROUND) & (panel != mask_color)):
+            continue
+        return panel
+
