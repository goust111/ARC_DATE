+
+
+def generate_input() -> np.ndarray:
+    global _SEEN_INPUT_SIGNATURES, _SEEN_OUTPUT_SIGNATURES
+
+    if len(_SEEN_INPUT_SIGNATURES) > MAX_TRACKED_SIGNATURES:
