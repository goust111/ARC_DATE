    for r in range(n):
        for c in range(n):
            if seen[r, c]:
                continue
            coords = tuple(sorted(set(_symmetry_coords(r, c, n))))
            for rr, cc in coords:
                seen[rr, cc] = True
            orbits.append(coords)
    return orbits

