+        br_subset = rng.choice(br_indices, size=int(rng.integers(1, len(br_indices) + 1)), replace=False)
+        masks[:, br_only_cell[0], br_only_cell[1]] = False
+        masks[np.asarray(br_subset, dtype=int), br_only_cell[0], br_only_cell[1]] = True
