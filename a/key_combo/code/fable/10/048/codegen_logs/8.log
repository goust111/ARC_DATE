+    for r, c in np.asarray(comp["coords"], dtype=int):
+        mask[r - r0, c - c0] = True
+    missing = np.argwhere(~mask)
+    assert missing.shape == (1, 2)
+    return int(missing[0, 0]), int(missing[0, 1])
