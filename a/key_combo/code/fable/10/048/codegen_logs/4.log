+
+def _sample_force_counts(meta: dict, prefer_diagonal: bool) -> tuple[tuple[int, int], tuple[int, int]]:
+    h = meta["obj_h"]
+    w = meta["obj_w"]
+    left_cap = h * meta["left_pad"]
+    right_cap = h * meta["right_pad"]
+    up_cap = w * meta["top_pad"]
+    down_cap = w * meta["bottom_pad"]
