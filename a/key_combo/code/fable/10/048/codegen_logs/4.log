+        coords = np.argwhere(inp == object_colors[idx])
+        coords = coords[(coords[:, 0] >= obj_r0) & (coords[:, 0] < obj_r0 + meta["obj_h"]) & (coords[:, 1] >= obj_c0) & (coords[:, 1] < obj_c0 + meta["obj_w"])]
+        bbox = _bbox(coords)
