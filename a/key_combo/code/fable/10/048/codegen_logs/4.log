+        up = int(np.sum((c0 <= force_coords[:, 1]) & (force_coords[:, 1] <= c1) & (force_coords[:, 0] < r0)))
+        down = int(np.sum((c0 <= force_coords[:, 1]) & (force_coords[:, 1] <= c1) & (force_coords[:, 0] > r1)))
