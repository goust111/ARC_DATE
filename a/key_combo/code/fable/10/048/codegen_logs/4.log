+        zone_r1 = zone_r0 + meta["zone_h"] - 1
+        zone_c1 = zone_c0 + meta["zone_w"] - 1
+
+        obj_r0 = zone_r0 + meta["top_pad"]
+        obj_c0 = zone_c0 + meta["left_pad"]
+        sprite = _gen_sprite(meta["obj_h"], meta["obj_w"], object_colors[idx], bg)
+        sprite_sig = sprite.tobytes()
