+    vectors = []
+    rich_axes = 0
+    balanced_axes = 0
+    any_horizontal = False
+    any_vertical = False
+    for obj in objects:
+        counts = obj["counts"]
+        dr = counts["down"] - counts["up"]
+        dc = counts["right"] - counts["left"]
+        vectors.append((dr, dc))
+        any_horizontal |= dc != 0
+        any_vertical |= dr != 0
+        for a, b in ((counts["left"], counts["right"]), (counts["up"], counts["down"])):
+            if a > 0 and b > 0 and a != b:
+                rich_axes += 1
+            if a > 0 and a == b:
