+
+    out = _expected_output(inp, objects, bg)
+    if not _semantic_checks(inp, out, objects, force_color, bg):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
