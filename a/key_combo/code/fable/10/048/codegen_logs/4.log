+    vert = _weighted_choice(v_pairs, prefer_nonzero=prefer_diagonal)
+    if horiz == (0, 0) and vert == (0, 0):
+        nonzero_h = [pair for pair in h_pairs if pair[0] != pair[1]]
+        nonzero_v = [pair for pair in v_pairs if pair[0] != pair[1]]
+        if nonzero_h:
