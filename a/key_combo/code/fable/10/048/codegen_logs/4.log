+def _weighted_choice(options: list[tuple[int, int]], *, prefer_nonzero: bool) -> tuple[int, int]:
+    weights = []
+    for neg, pos in options:
+        delta = pos - neg
+        weight = 1.0
+        if delta != 0:
+            weight *= 3.0 if prefer_nonzero else 1.2
+        else:
