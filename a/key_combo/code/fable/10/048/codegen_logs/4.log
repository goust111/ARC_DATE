+MAX_DIM = 30
+OUTER_MARGIN = 2
+ROW_GAP_RANGE = (3, 4)
+COL_GAP_RANGE = (3, 4)
+OBJ_COUNT_OPTIONS = (2, 3)
+OBJ_SIZE_RANGE = (2, 3)
+SIDE_MARGIN_RANGE = (1, 2)
+MAX_SHIFT = 2
+MAX_SIDE_COUNT = 3
+MAX_ATTEMPTS = 600
