  "dst": "one-column horizontal target positions d, alternating left then right",
  "match_cond": "rank(s) == rank(d)",
  "transform": "clear the canvas to background; copy each object unchanged to its assigned shifted position"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 12-16 rows x 12-13 cols, single background color
  objects:
    count: 2-4 monochromatic 4-connected foreground objects, each a distinct color (may repeat across groups)
    distinct_top_rows: every object has a unique top bbox row
    shape: irregular blobs with bbox fill ratio 0.79-1.0; may contain bg-colored holes
    bbox_size: 1-5 rows x 3-7 cols
    grouping: objects form vertically-adjacent pairs (gap=0 between consecutive bbox rows) [observed]
    within_pair: both objects share the same column span (bbox left/right cols equal) [observed]
    pairs_separated: gap >= 1 row between pairs when multiple pairs exist [observed]
  clearance: odd-rank objects (0-indexed) need left_clearance >= 1; even-rank need right_clearance >= 1
  border: >= 1 all-bg row at top and bottom [observed]; >= 1 all-bg col on each side after shift
  rule: sort objects by top bbox row; shift rank 0,2,4... one col left; shift rank 1,3,5... one col right
  output: same grid size; shifted objects must stay in bounds and not overlap

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size (12-16 x 12-13), bg color, number of pairs (1-2).
    2. For each pair, choose two distinct non-bg colors and a shared column span width (3-7).
    3. Build each object sprite within the bbox (fill ratio >= 0.75, 4-connected, optionally with bg holes).
    4. Place pair sprites vertically adjacent on the output grid with >= 1 bg row between pairs.
       Ensure the shifted positions (odd-rank left, even-rank right by 1) stay in bounds and don't overlap.
    5. Derive input by reversing the shift: move odd-rank objects 1 col right, even-rank 1 col left.
    6. Verify all objects have distinct top bbox rows and remain in bounds.
