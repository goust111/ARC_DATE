+        bbox = _bbox(coords)
+        meta["bbox"] = bbox
+
+        horiz, vert = _sample_force_counts(meta, prefer_diagonal=(idx % 2 == 0))
+        counts = {
+            "left": int(horiz[0]),
+            "right": int(horiz[1]),
+            "up": int(vert[0]),
+            "down": int(vert[1]),
+        }
+
+        objects.append(
+            {
+                "color": int(object_colors[idx]),
+                "coords": coords,
+                "bbox": bbox,
+                "zone": (zone_r0, zone_c0, zone_r1, zone_c1),
+                "counts": counts,
