+    right_cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c1 + 1, zc1 + 1)]
+    up_cells = [(r, c) for r in range(zr0, r0) for c in range(c0, c1 + 1)]
+    down_cells = [(r, c) for r in range(r1 + 1, zr1 + 1) for c in range(c0, c1 + 1)]
+
+    chosen = []
+    chosen.extend(random.sample(left_cells, counts["left"]))
+    chosen.extend(random.sample(right_cells, counts["right"]))
+    chosen.extend(random.sample(up_cells, counts["up"]))
+    chosen.extend(random.sample(down_cells, counts["down"]))
+    for r, c in chosen:
+        inp[r, c] = int(force_color)
+
