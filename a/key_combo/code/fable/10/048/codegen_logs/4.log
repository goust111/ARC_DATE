+        coords = np.argwhere(mask)
+        assert coords.shape[0] >= 2, "main objects must be multi-cell"
+        assert _is_connected(mask), "each main object color must form one 4-connected object"
+        objects.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": _bbox(coords),
