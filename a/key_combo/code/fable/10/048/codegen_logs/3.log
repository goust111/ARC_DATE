+def _find_components(grid: np.ndarray, colors: Iterable[int]) -> list[dict]:
+    colors = set(int(c) for c in colors)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color not in colors:
