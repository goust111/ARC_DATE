+    grey_f_center_row = center_row_d + half_d + 4
+    if not _add_square(placed, GREY, grey_f_center_row, source_col2, 3, h, w):
+        return None
+
+    direct_row3 = (h - 5) + random.choice([d for d in range(-half_g, half_g + 1)])
+
