+    max_center_row_d = min(h // 2 - 2, h - 8 - (size_d // 2) - size_g)
+    min_center_row_d = max(4 + size_d // 2, h // 3 - 1)
+    if min_center_row_d > max_center_row_d:
+        return None
+    center_row_d = random.randint(min_center_row_d, max_center_row_d)
+    if not _add_square(placed, PINK, center_row_d, mirror_d_center_col, size_d, h, w):
+        return None
+
+    grey_f_center_row = center_row_d + size_d // 2 + 4
+    if grey_f_center_row > h - 4:
