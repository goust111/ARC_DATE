+            elif dr == -1 and sq["r1"] < r:
+                key = -sq["r1"]
+            else:
+                continue
+            if best is None or key < best_key:
+                best = sq
+                best_key = key
+    return best
+
+
+def _trace_ray(
+    grid: np.ndarray,
+    squares: list[dict],
+    source: tuple[int, int],
+    ignore_reflections: frozenset[int] = frozenset(),
+) -> dict:
+    h, w = grid.shape
+    r, c = source
+    dr, dc = _edge_direction((h, w), r, c)
+    pink_hit_index = 0
+    hits = []
+    mirrors = []
+    while True:
