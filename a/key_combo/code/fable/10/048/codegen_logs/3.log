+            return {
+                "source": (int(source[0]), int(source[1])),
+                "endpoint": (int(endpoint[0]), int(endpoint[1])),
+                "absorbed": True,
+                "axis": "H" if dr == 0 else "V",
+                "mirror_count": len(mirrors),
+                "hits": hits,
