+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PINK = 6
+MAROON = 9
+
+_DIRS = {
+    "E": (0, 1),
+    "W": (0, -1),
+    "S": (1, 0),
+    "N": (-1, 0),
+}
+
+_GEN_RETRIES = 1200
+_MIN_GAP = 1
