+    r, c = source
+    dr, dc = _edge_direction((h, w), r, c)
+    pink_hit_index = 0
+    hits = []
+    mirrors = []
+    while True:
+        sq = _next_square(r, c, dr, dc, squares)
+        if sq is None:
+            if dr == 0:
+                endpoint = (r, w - 1 if dc == 1 else 0)
+            else:
+                endpoint = (h - 1 if dr == 1 else 0, c)
