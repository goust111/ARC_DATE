+    if not _add_square(placed, PINK, center_b, col_b + size_b // 2, size_b, h, w):
+        return None
+    if not _add_square(placed, GREY, row_after_b, col_c + 1, 3, h, w):
+        return None
+
+    half_d = size_d // 2
+    mirror_d_center_col_candidates = list(range(w // 2 + 2, w - 5))
+    random.shuffle(mirror_d_center_col_candidates)
+    mirror_d_center_col = None
+    source_col2 = None
+    reflected_col2 = None
+    for center_col in mirror_d_center_col_candidates:
+        offsets_d = [d for d in range(-half_d, half_d + 1) if d != 0]
+        random.shuffle(offsets_d)
+        for offset_d in offsets_d:
+            src_col = center_col + offset_d
+            new_col = center_col - offset_d
+            if not (1 <= src_col <= w - 2 and 1 <= new_col <= w - 2):
+                continue
+            if col_c <= new_col <= w // 2 + 1:
