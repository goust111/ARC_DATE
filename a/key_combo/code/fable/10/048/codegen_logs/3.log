+            for offset_b in offsets_b:
+                center_b = row_after_a - offset_b
+                row_after_b = row_after_a - 2 * offset_b
+                if not (3 + half_b <= center_b < upper_max):
+                    continue
+                if not (2 <= row_after_b <= upper_max + 1):
+                    continue
+                if row_after_b == source_row:
+                    continue
+                if center_b - half_b <= source_row <= center_b + half_b:
+                    continue
+                return source_row, row_after_a, row_after_b, center_a, center_b
+    raise RuntimeError("failed to choose chain1 rows")
+
+
+def _build_attempt() -> np.ndarray | None:
