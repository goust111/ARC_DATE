  "dst": "rectangle immediately right of each vertical bar or below each horizontal bar",
  "transform": "tile the attached motif along the full length of its grey bar, preserving the grey bar and existing motif cells"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10x10, background BLACK
  bars:
    count: 1-2 grey (color 5) straight bars per grid
    orientation: horizontal or vertical (both can coexist)
    length: 4-8 cells
    width: always 1 cell thick
    may_touch_edge: yes (observed in ~half of bars)
  motif:
    position: bottom-right corner of vertical bar; bottom-left corner of horizontal bar
    for_vertical: motif_h x motif_w rectangle right of bar's bottom end; bar_len divisible by motif_h
    for_horizontal: motif_h x motif_w rectangle below bar's left end; bar_len divisible by motif_w
    motif_h: 1-6, motif_w: 1-6 (one dimension often 1)
    repeats: 4-6 times along bar axis
