+    row_after_a = center_a - offset_a
+    offset_b = 1 if offset_a > 0 else -1
+    center_b = row_after_a - offset_b
+    row_after_b = row_after_a - 2 * offset_b
+    if not (2 <= row_after_b <= 13):
