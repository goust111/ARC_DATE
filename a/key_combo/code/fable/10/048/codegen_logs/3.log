+    if not any((not trace["absorbed"]) and trace["mirror_count"] >= 1 for trace in traces):
+        return False
+    if not any(trace["absorbed"] and trace["mirror_count"] == 0 for trace in traces):
+        return False
+    if np.array_equal(main(grid), grid):
