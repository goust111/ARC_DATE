    horizontal_position: each pair at a different left-column offset; left block col 0 to W-10
  stripe_content:
    size: 2 rows x gap_width cols (the rectangle strictly between the two marker blocks)
    fill: mix of background (0) and colors from {1-7,9}; non-bg density ~50-75%
    no_color_8: stripe interiors never contain marker color
  noise:
    colors: all 8 non-bg non-marker colors {1,2,3,4,5,6,7,9} present in every grid
    density: ~33-48% of grid cells are non-bg non-marker (noise + stripe content combined)
    mostly_single_pixels: vast majority are 1-cell components; occasional 2-3 cell clusters
    covers_entire_grid: scattered uniformly outside marker/stripe regions
  output:
    shape: (2 * num_pairs) rows x gap_width cols
    content: vertical stack of stripe interiors in top-to-bottom pair order

generation_strategy:
  approach: output-first
  steps:
    1. Choose num_pairs (1-4), gap_width (3-6), grid dims (H 12-15, W 10-17) ensuring W >= gap_width + 4 + 2
    2. Generate output content -- num_pairs 2-row strips of width gap_width, each ~50-75% non-bg using colors from {1-7,9}
    3. For each pair, pick a unique left-column and a row-span with >=1 row gap between pairs; place 2x2 marker blocks (color 8) flanking the stripe, and copy stripe content between them
    4. Fill all remaining background cells with random single-pixel noise from {1-7,9} at ~35-45% fill rate, ensuring every color in {1-7,9} appears at least once
