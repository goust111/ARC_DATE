                candidates = [nb for nb in _gen_neighbors(head, height, width) if nb in free]
            elif mode == STRAIGHT_GROWTH_MODE:
                nr, nc = head[0] + direction[0], head[1] + direction[1]
                candidates = [(nr, nc)] if (nr, nc) in free else []
            else:
