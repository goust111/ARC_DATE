        width += 1
    bar_width = c1 - c0 + 1
    assert width > 0 and bar_width % width == 0

    tile = g[r + 1 : r + 1 + height, c0 : c0 + width]
    fill = np.tile(tile, (1, bar_width // width))
    target = g[r + 1 : r + 1 + height, c0 : c1 + 1]
