+            cells.append((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+    return cells
+
+
+def _make_stamp_mask() -> np.ndarray:
+    for _ in range(200):
