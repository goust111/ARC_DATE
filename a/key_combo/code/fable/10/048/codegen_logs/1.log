+
+
+def _manhattan_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    tr, tc = end
+    cells = [(r, c)]
+    if random.random() < 0.5:
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
