+def _make_stamp_mask() -> np.ndarray:
+    for _ in range(200):
+        h, w = random.choice(STAMP_DIMS)
+        mask = np.zeros((h, w), dtype=bool)
+        center = (h // 2, w // 2)
+
+        anchors = [
