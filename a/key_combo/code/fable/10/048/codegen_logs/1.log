+def _solid_separator_row(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    rows = []
+    for r in range(grid.shape[0]):
+        color = int(grid[r, 0])
+        if color != bg and np.all(grid[r] == color):
+            rows.append((r, color))
+    assert len(rows) == 1, "expected exactly one solid separator row"
+    return rows[0]
