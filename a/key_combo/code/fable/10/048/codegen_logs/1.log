+    r, c = start
+    tr, tc = end
+    cells = [(r, c)]
+    if random.random() < 0.5:
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            cells.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            cells.append((r, c))
+    return cells
