def _gen_partition(total, parts):
    if parts <= 1:
        return [total]
    cuts = sorted(np.random.choice(np.arange(1, total), size=parts - 1, replace=False).tolist())
    return [b - a for a, b in zip([0] + cuts, cuts + [total])]


