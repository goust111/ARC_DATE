    if orient == GEN_VERTICAL:
        return range(0, GEN_GRID_H + 1 - length), range(0, GEN_GRID_W - motif_w)
    return range(0, GEN_GRID_H - 1 - motif_h), range(0, GEN_GRID_W + 1 - length)


def _gen_placement_is_valid(
    masks: dict,
