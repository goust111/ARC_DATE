spec:
  grid: 3 rows x 10-17 cols
  colors: input uses only black(0) and yellow(4); output adds pink(6)
  lattice:
    row0_top: alternates starting with black or yellow (equal probability)
    row1_middle: solid yellow
    row2_bottom: complement of row0 (yellow<->black swapped)
  transform:
    rule: in every column where col_index % 3 == 0, recolor yellow pixels to pink
    black_pixels: unchanged
    shape: preserved (same dimensions)

generation_strategy:
  approach: direct construction (input is fully determined by width + start_color)
  steps:
    1. pick width W uniformly from 10-17
    2. pick start_color for top row from {black, yellow} with equal probability
    3. build top row as alternating start_color / other for W columns
    4. build middle row as solid yellow
    5. build bottom row as complement of top row (swap yellow<->black)
    6. this is the input; output is derived by recoloring yellow->pink at columns 0, 3, 6, ...
