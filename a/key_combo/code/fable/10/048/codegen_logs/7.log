WINDOW_TOP_MAX = CANVAS_SIZE - WINDOW_SIZE
TOTAL_CELLS = CANVAS_SIZE * CANVAS_SIZE

# Marker layout and red-count distribution.
SELECTED_WINDOW_COUNT, MIN_WINDOW_SEPARATION = 4, 4
