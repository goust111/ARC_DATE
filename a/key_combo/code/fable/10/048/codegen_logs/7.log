+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+MAX_GENERATION_ATTEMPTS = 400
+BAR_LENGTH_VALUES = tuple(range(2, 8))
+BAR_SCENARIOS = ("h_only", "v_only", "mixed")
+SIDES = ("left", "right", "top", "bottom")
