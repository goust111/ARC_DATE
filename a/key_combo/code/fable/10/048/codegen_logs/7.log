def _paint_selected_windows(out, positions, selected_reds) -> None:
    for r, c in positions:
        window = out[r : r + WINDOW_SIZE, c : c + WINDOW_SIZE]
        window[:, :] = GEN_ORANGE
        window[CENTER_OFFSET, CENTER_OFFSET] = GEN_YELLOW
        reds = selected_reds[(r, c)]
