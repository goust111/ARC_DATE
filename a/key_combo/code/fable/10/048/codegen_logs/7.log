+                                candidates.append(
+                                    {
+                                        "orientation": "h",
+                                        "length": length,
+                                        "bar_cells": bar_cells,
+                                        "attachment": attachment,
+                                        "color": color,
+                                        "effect": effect,
+                                        "halo": halo_mask(shape, footprint),
+                                    }
+                                )
+            else:
+                axis_start, axis_end = lattice_bbox[0], lattice_bbox[2]
+                col_values = range(sc0, sc1 + 1)
