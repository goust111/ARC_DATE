+def _analyze(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _bg_color(g)
+    rect = _rectangle_from_markers(g)
+    boundary = _boundary_cycle(rect)
+    corners = _corners(rect)
