+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+BAR_COLORS = [1, 2, 3, 5, 6, 7, 8, 9]
+CASES = [
+    ("top", "TL"),
+    ("top", "TR"),
+    ("bottom", "BL"),
+    ("bottom", "BR"),
+    ("left", "TL"),
+    ("left", "BL"),
+    ("right", "TR"),
+    ("right", "BR"),
