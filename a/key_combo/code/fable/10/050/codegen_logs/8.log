2: import numpy as np
3: from typing import *
4: import random
5: from arc_utils import Color, bbox, crop_bbox, draw_line, find_components
6: 
7: # concepts:
8: # rectangular cells, color guide
9: 
10: # description:
11: # In the input you will see grey horizontal and vertical bars that divide the grid into nine 3x3 rectangular regions, each of which contains 4-5 colored pixels
12: # To make the output, find the region that has exactly 4 colored pixels, and use its colors as a guide to fill in all the other cells
13: 
14: def main(input_grid: np.ndarray) -> np.ndarray:
15:     """
16:     Use the uniquely sparse 3x3 cell as a color key for all cells in the divided grid.
17: 
18:     Input structure:
19:     - The input is a 3-by-3 arrangement of cells separated by one divider color.
20:     - Each cell contains black plus several colored pixels.
21:     - Exactly one cell has four non-black, non-divider pixels; the others have five.
22: 
23:     Rule:
24:     - Split the grid into its divider-separated cells.
25:     - Find the cell with exactly four colored pixels and crop it as the guide sprite.
26:     - Fill every cell uniformly with the guide sprite color at the corresponding cell position.
27: 
28:     Key insight:
29:     - The special sparse cell is a miniature 3-by-3 lookup table: its position-indexed colors
30:       determine the color assigned to every region.
31:     """
32: 
33:     # First identify 
34: 
35:     # Trick for decomposing inputs divided into rectangular regions by horizontal/vertical bars:
36:     # Treat the bar color as the background, and break the input up into connected components with that background color
37: 
38:     # The divider color is the color of the horizontal and vertical bars
39:     divider_colors = [ input_grid[r,c] for r in range(input_grid.shape[0]) for c in range(input_grid.shape[1])
40:                      if np.all(input_grid[r,:] == input_grid[r,0]) or np.all(input_grid[:,c] == input_grid[0,c]) ]
41:     assert len(set(divider_colors)) == 1, "There should be exactly one divider color"
42:     divider_color = divider_colors[0] # background=divider_color
43: 
44:     # Find multicolored regions, which are divided by divider_color, so we treat that as background, because it separates objects
45:     # Within each region there can be multiple colors
46:     regions = find_components(input_grid, bg=divider_color, connectivity=4, monochromatic=False, return_format="objects")
47:     # Tag the regions with their location within the 2D grid of (divided) regions
48:     # First get the bounding-box locations...
49:     locations = []
50:     for region in regions:
51:         _b = bbox(region != divider_color)
52:         assert _b is not None
53:         r, c, _r1, _c1 = _b
54:         w = _r1 - r + 1
55:         h = _c1 - c + 1
56:         locations.append((r, c, region))
57:     # ...then re-index them so that (x, y) is the coordinate within the grid of rectangular regions
58:     grid_of_regions = []
59:     for r, c, region in locations:
60:         num_left_of_region = len({other_r for other_r, other_c, other_region in locations if other_r < r})
61:         num_above_region = len({other_c for other_r, other_c, other_region in locations if other_c < c})
62:         grid_of_regions.append((num_left_of_region, num_above_region, region))
63: 
64:     # Find the region with exactly 4 colors
65:     special_region = None
66:     for region in regions:
67:         not_divider_and_not_black = (region != divider_color) & (region != Color.BLACK)
68:         if np.sum(not_divider_and_not_black) == 4:
69:             assert special_region is None, "More than one special region found"
70:             special_region = region
71:     
72:     # Convert to a sprite
73:     _b = bbox(special_region != divider_color)
74:     assert _b is not None
75:     special_sprite = crop_bbox(special_region, _b)
76:     
77:     # Create the output grid
78:     output_grid = np.zeros_like(input_grid)
79: 
