82: # Input sampling.
83: INPUT_CELL_COUNT = INPUT_SIZE * INPUT_SIZE
84: FOREGROUND_MIN = 1
85: FOREGROUND_MAX = 9
86: 
87: # Rejection guard.
88: GENERATION_ATTEMPTS = 300
