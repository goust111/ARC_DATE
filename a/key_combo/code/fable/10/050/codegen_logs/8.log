34: def main(grid: np.ndarray) -> np.ndarray:
35:     """Expand the single colored pixel into a clipped square-spiral graph on a 9x9 lattice.
36: 
37:     Input structure
38:     - The input is a 3x3 grid with one foreground pixel and eight background pixels.
39: 
40:     Rule
41:     - Map the foreground pixel at input position (r, c) to node (2r, 2c) of a 5x5 output lattice.
42:     - Paint every lattice node, then trace an outward square spiral from that node with step lengths
43:       1, 1, 2, 2, ... in up, right, down, left order.
44:     - Paint only spiral edge midpoints whose two endpoint nodes both lie inside the 5x5 lattice.
45: 
46:     Key insight
47:     - The 9x9 grid is a doubled 5x5 node lattice: even-even cells are nodes, and the colored
48:       cells between adjacent nodes are the clipped edges of one spiral centered on the marker.
49:     """
50:     g = np.asarray(grid, dtype=int)
51:     assert g.shape == (3, 3)
52: 
53:     colors, counts = np.unique(g, return_counts=True)
54:     assert len(colors) == 2
55:     bg = int(colors[np.argmax(counts)])
56:     assert int(counts.max()) == 8
57:     fg_candidates = [int(color) for color in colors if int(color) != bg]
58:     assert len(fg_candidates) == 1
59:     fg = fg_candidates[0]
60: 
61:     coords = np.argwhere(g == fg)
62:     assert coords.shape == (1, 2)
63:     source_r, source_c = map(int, coords[0])
64: 
65:     lattice_size = 5
66:     out = np.full((9, 9), bg, dtype=int)
67:     out[::2, ::2] = fg
68: 
69:     center = (source_r * 2, source_c * 2)
70:     for (r1, c1), (r2, c2) in _clipped_spiral_edges(center, lattice_size):
71:         out[r1 + r2, c1 + c2] = fg
72: 
73:     return out
74: 
75: # --------------- generator (o5x) ---------------
76: 
77: # Canvas and lattice dimensions.
78: INPUT_SIZE = 3
79: OUTPUT_SIZE = 9
80: LATTICE_SIZE = 5
81: 
82: # Input sampling.
83: INPUT_CELL_COUNT = INPUT_SIZE * INPUT_SIZE
84: FOREGROUND_MIN = 1
85: FOREGROUND_MAX = 9
86: 
87: # Rejection guard.
88: GENERATION_ATTEMPTS = 300
89: 
90: 
91: def _sample_input() -> np.ndarray:
92:     """Return a 3x3 grid with one uniformly sampled foreground marker."""
93:     inp = np.zeros((INPUT_SIZE, INPUT_SIZE), dtype=int)
94:     pos = random.randrange(INPUT_CELL_COUNT)
95:     inp[pos // INPUT_SIZE, pos % INPUT_SIZE] = random.randint(FOREGROUND_MIN, FOREGROUND_MAX)
96:     return inp
97: 
98: 
99: def _extract_marker(inp: np.ndarray) -> tuple[int, int, int]:
100:     """Return the single nonzero marker as (row, col, color)."""
101:     fg_coords = np.argwhere(inp != 0)
102:     assert fg_coords.shape == (1, 2)
103:     source_r, source_c = map(int, fg_coords[0])
104:     return source_r, source_c, int(inp[source_r, source_c])
105: 
106: 
107: def _gen_expected_output(inp: np.ndarray) -> np.ndarray:
108:     """Render the deterministic 9x9 output for a sampled input."""
109:     source_r, source_c, fg = _extract_marker(inp)
110:     out = np.zeros((OUTPUT_SIZE, OUTPUT_SIZE), dtype=int)
111:     out[::2, ::2] = fg
112: 
113:     center = (source_r * 2, source_c * 2)
114:     for (r1, c1), (r2, c2) in _clipped_spiral_edges(center, LATTICE_SIZE):
115:         out[r1 + r2, c1 + c2] = fg
116: 
117:     return out
