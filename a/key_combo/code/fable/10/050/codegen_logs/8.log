18: def main(grid: np.ndarray) -> np.ndarray:
19:     """Extend broken horizontal bars vertically through their gap columns.
20: 
21:     Input structure
22:     - The background is empty color, and each control cell is a one-pixel gap
23:       inside a horizontal bar: its immediate left and right neighbors have the
24:       same non-background color.
25:     - Gap cells in the same column form a top-to-bottom stack, with a
26:       non-background vertical marker color somewhere below the last gap.
27:     Rule
28:     - For each gap column, sort its gaps by row. Paint from the top through each
29:       gap row with that row's horizontal-bar color, then paint the remaining
30:       lower part of the column with the marker color found below the last gap.
31:     Key insight
32:     - A gap column is an implicit vertical color ruler: horizontal bars provide
33:       the upper breakpoints, and the lower marker provides the final segment.
34:     """
35:     g = np.asarray(grid, dtype=int)
36:     assert g.ndim == 2
37:     bg = get_bg(g)
38:     gaps = _gap_columns(g, bg)
39:     assert gaps
40: 
41:     out = g.copy()
42:     H, _ = g.shape
43:     for c, entries in gaps.items():
44:         entries = sorted(entries)
45:         rows = [r for r, _ in entries]
46:         assert len(rows) == len(set(rows))
47: 
48:         last_gap_row = rows[-1]
49:         assert last_gap_row + 1 < H
50:         terminal_colors = {int(x) for x in g[last_gap_row + 1 :, c] if int(x) != bg}
51:         assert len(terminal_colors) == 1
52:         terminal_color = terminal_colors.pop()
53: 
54:         start = 0
55:         for r, color in entries:
56:             assert all(int(x) in (bg, color) for x in g[start : r + 1, c])
57:             out[start : r + 1, c] = color
58:             start = r + 1
59: 
60:         assert all(int(x) in (bg, terminal_color) for x in g[start:, c])
61:         out[start:, c] = terminal_color
62: 
63:     return out
64: 
