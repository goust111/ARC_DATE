705: def _gen_attempt() -> np.ndarray | None:
706:     """Single attempt: build grid with 1-3 triples, validate via oracle."""
707:     n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
708:     if n < 11:
709:         max_triples = 1
710:     elif n < 15:
711:         max_triples = 2
712:     else:
713:         max_triples = 3
714:     triple_count = random.randint(1, max_triples)
715: 
716:     bg, bar_color, seg_color, obstacle_color = random.sample(range(10), 4)
717:     inp = np.full((n, n), bg, dtype=int)
718:     out = np.full((n, n), bg, dtype=int)
719:     reserved = np.zeros((n, n), dtype=bool)
720:     placed_triples = []
721: 
722:     for edge in random.sample(list(EDGE_DATA), triple_count):
723:         triple = _make_triple(n)
724:         if triple is None:
725:             return None
726:         placed = _place_triple(triple, edge, n, reserved)
727:         if placed is None:
728:             return None
729: 
730:         paint_coords(inp, placed["bar"], bar_color)
731:         paint_coords(inp, placed["obstacle"], obstacle_color)
732:         paint_coords(inp, placed["input_seg"], seg_color)
733: 
734:         paint_coords(out, placed["bar"], bar_color)
735:         paint_coords(out, placed["obstacle"], obstacle_color)
736:         paint_coords(out, placed["output_seg"], seg_color)
737: 
738:         r0, c0, r1, c1 = placed["reserve"]
739:         reserved[r0 : r1 + 1, c0 : c1 + 1] = True
740:         placed_triples.append(placed)
741: 
742:     if len(placed_triples) > 1:
743:         for i, placed in enumerate(placed_triples):
744:             tr, tc = placed["terminal"]
745:             own = min(abs(r - tr) + abs(c - tc) for r, c in placed["obstacle"])
746:             other = min(
747:                 abs(r - tr) + abs(c - tc)
748:                 for j, other_placed in enumerate(placed_triples)
749:                 if j != i
750:                 for r, c in other_placed["obstacle"]
751:             )
752:             if own >= other:
753:                 return None
754: 
755:     try:
756:         if not np.array_equal(main(inp), out):
757:             return None
758:     except Exception:
759:         return None
760:     return inp
761: 
