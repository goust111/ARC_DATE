+
+def _place_patch(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+) -> tuple[int, int, int, int] | None:
+    h, w = mask.shape
+    H, W = grid.shape
+    positions = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
+    random.shuffle(positions)
+    for r, c in positions:
+        r0 = max(0, r - 1)
+        c0 = max(0, c - 1)
+        r1 = min(H, r + h + 1)
+        c1 = min(W, c + w + 1)
+        if reserved[r0:r1, c0:c1].any():
