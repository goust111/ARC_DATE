604: def _make_triple(n: int) -> dict | None:
605:     """Generate one bar+segment+obstacle triple in local coordinates (origin at terminal)."""
606:     max_bar = min(BAR_LEN_MAX, n - BAR_CLEARANCE)
607:     if max_bar < BAR_LEN_MIN:
608:         return None
609: 
610:     bar_len = random.randint(BAR_LEN_MIN, max_bar)
611:     max_seg = min(SEG_LEN_MAX, n - bar_len + 1)
612:     if max_seg < SEG_LEN_MIN:
613:         return None
614:     seg_len = random.randint(SEG_LEN_MIN, max_seg)
615:     side = random.choice((-1, 1))
616:     bar = [(-k, 0) for k in range(bar_len)]
617:     bar_set = set(bar)
618: 
619:     # Phase lengths: p1 >= 1, p2 >= 0, p3 >= 0, p1+p2+p3 = seg_len-1
620:     remaining = seg_len - 1
621:     p1 = random.randint(1, min(remaining - 1, PHASE_MAX))
622:     remaining -= p1
623:     p2 = random.randint(0, min(remaining, PHASE_MAX))
624:     p3 = remaining - p2
625: 
626:     output_seg = _build_output_path(seg_len, side, p1, p2, p3)
627:     seg_set = set(output_seg)
628: 
629:     # V apex inner: grow obstacle from here
630:     apex = output_seg[p1]
631:     apex_inner = (apex[0], apex[1] - side)
632:     if apex_inner in seg_set or apex_inner in bar_set:
633:         return None
634: 
635:     obs_size = random.randint(OBS_SIZE_MIN, OBS_SIZE_MAX)
636:     obstacle = _grow_obstacle(apex_inner, obs_size, seg_set | bar_set)
637: 
638:     # Manhattan distance from terminal check
639:     nearest_md = min(abs(r) + abs(c) for r, c in obstacle)
640:     if not (OBS_MD_MIN <= nearest_md <= OBS_MD_MAX):
641:         return None
642: 
643:     # Input segment
644:     max_turns = min(INPUT_TURN_MAX, seg_len - 2)
645:     turns = random.randint(INPUT_TURN_MIN, max_turns)
646:     input_seg = _build_input_path(seg_len, turns, side)
647: 
648:     if _is_4adj(input_seg, obstacle):
649:         return None
650: 
651:     union = bar + obstacle + input_seg + output_seg
652:     rs = [r for r, _ in union]
653:     cs = [c for _, c in union]
654: 
655:     return {
656:         "bar_len": bar_len,
657:         "bar": bar,
658:         "obstacle": obstacle,
659:         "input_seg": input_seg,
660:         "output_seg": output_seg,
661:         "bbox": (min(rs), min(cs), max(rs), max(cs)),
662:     }
663: 
664: 
665: def _expanded_bbox(coords: list[tuple[int, int]], n: int) -> tuple[int, int, int, int]:
666:     """Compute bounding box of *coords* expanded by PLACEMENT_PAD, clamped to [0, n-1]."""
667:     rs = [r for r, _ in coords]
668:     cs = [c for _, c in coords]
669:     return (
670:         max(0, min(rs) - PLACEMENT_PAD),
671:         max(0, min(cs) - PLACEMENT_PAD),
672:         min(n - 1, max(rs) + PLACEMENT_PAD),
673:         min(n - 1, max(cs) + PLACEMENT_PAD),
674:     )
675: 
676: 
677: def _place_triple(
678:     triple: dict, edge: str, n: int, reserved: np.ndarray
679: ) -> dict | None:
680:     """Try to place a triple on *edge*, returning global coords or None."""
681:     positions = list(range(n))
682:     random.shuffle(positions)
683:     union = triple["bar"] + triple["obstacle"] + triple["input_seg"] + triple["output_seg"]
684:     bar_len = triple["bar_len"]
685: 
686:     for pos in positions:
687:         union_g = _transform(union, edge, n, bar_len, pos)
688:         if any(r < 0 or c < 0 or r >= n or c >= n for r, c in union_g):
689:             continue
690:         r0, c0, r1, c1 = _expanded_bbox(union_g, n)
691:         if reserved[r0 : r1 + 1, c0 : c1 + 1].any():
692:             continue
693:         placed = {
694:             "bar": _transform(triple["bar"], edge, n, bar_len, pos),
695:             "obstacle": _transform(triple["obstacle"], edge, n, bar_len, pos),
696:             "input_seg": _transform(triple["input_seg"], edge, n, bar_len, pos),
697:             "output_seg": _transform(triple["output_seg"], edge, n, bar_len, pos),
698:             "terminal": _transform([(0, 0)], edge, n, bar_len, pos)[0],
699:             "reserve": (r0, c0, r1, c1),
700:         }
701:         return placed
702:     return None
703: 
