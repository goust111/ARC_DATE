144: def _place_next_frame(prev, prior_cell_sets):
145:     """Sample one frame that crosses the previous frame and stays compatible with older frames."""
146:     pr0, pc0, pr1, pc1 = prev
147:     for _ in range(PLACEMENT_TRIES):
148:         fh, fw = _random_frame_size()
149:         r0 = random.randint(max(0, pr0 - fh + 1), min(GRID_HEIGHT - 1 - fh, pr1))
150:         c0 = random.randint(max(0, pc0 - fw + 1), min(GRID_WIDTH - 1 - fw, pc1))
151:         r1, c1 = r0 + fh, c0 + fw
152: 
153:         if r1 >= GRID_HEIGHT or c1 >= GRID_WIDTH:
154:             continue
155: 
156:         new_bb = (r0, c0, r1, c1)
157:         new_cells = _frame_cells(*new_bb)
158: 
159:         if len(new_cells & prior_cell_sets[-1]) not in REQUIRED_PREV_OVERLAPS:
160:             continue
161: 
162:         if any(len(new_cells & cells) not in ALLOWED_PRIOR_OVERLAPS for cells in prior_cell_sets[:-1]):
163:             continue
164: 
165:         return new_bb, new_cells
166:     return None
