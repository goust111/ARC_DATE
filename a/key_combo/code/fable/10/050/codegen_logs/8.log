21: def _unique_layer_order(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:
22:     above: dict[int, set[int]] = {color: set() for color in colors}
23:     indegree: dict[int, int] = {color: 0 for color in colors}
24: 
25:     for lower, higher in edges:
26:         assert lower != higher, "layer constraint cannot point to itself"
27:         if higher not in above[lower]:
28:             above[lower].add(higher)
29:             indegree[higher] += 1
30: 
31:     order: list[int] = []
32:     placed: set[int] = set()
33:     while len(order) < len(colors):
34:         available = [color for color in colors if color not in placed and indegree[color] == 0]
35:         assert len(available) == 1, "overlap constraints must determine a unique layer order"
36:         color = available[0]
37:         order.append(color)
38:         placed.add(color)
39:         for higher in above[color]:
40:             indegree[higher] -= 1
41: 
42:     return order
