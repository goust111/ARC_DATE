99: def _gen_marker_start(bottom_row: int) -> int:
100:     total_below = GRID_H - 1 - bottom_row
101:     gaps = [
102:         gap
103:         for gap in range(MARKER_GAP_MIN, MARKER_GAP_MAX + 1)
104:         if MARKER_LEN_MIN <= total_below - gap <= MARKER_LEN_MAX
105:     ]
106:     gap = random.choice(gaps)
107:     return bottom_row + 1 + gap
108: 
