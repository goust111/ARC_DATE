+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+SEED_COLOR = 5
+MASK_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _component_count(mask: np.ndarray) -> int:
+    seen = np.zeros(mask.shape, dtype=bool)
+    count = 0
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        count += 1
+        stack = [(r, c)]
+        seen[r, c] = True
+        while stack:
+            rr, cc = stack.pop()
+            for nr, nc in _neighbors4(rr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+    return count
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    rs = coords[:, 0]
+    cs = coords[:, 1]
+    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    b = _bbox(mask)
+    assert b is not None
+    r0, c0, r1, c1 = b
+    return mask[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _spiral_offsets(length: int) -> tuple[list[tuple[int, int]], list[int]]:
+    offsets: list[tuple[int, int]] = []
+    segment_ends: list[int] = []
+    r = 0
+    c = 0
+    step_len = 1
+    directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+    direction_index = 0
+
+    while len(offsets) < length:
+        for _ in range(2):
+            dr, dc = directions[direction_index % 4]
+            for _ in range(step_len):
+                r += dr
+                c += dc
+                offsets.append((r, c))
+                if len(offsets) >= length:
+                    break
+            segment_ends.append(len(offsets))
+            direction_index += 1
+            if len(offsets) >= length:
+                break
+        step_len += 1
+    return offsets, segment_ends
+
+
+def _spiral_path(seed: tuple[int, int], length: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    path: list[tuple[int, int]] = []
+    sr, sc = seed
+    offsets, _ = _spiral_offsets(length)
+    for dr, dc in offsets:
+        r = sr + dr
+        c = sc + dc
+        assert _in_bounds(shape, r, c), "spiral path leaves the grid"
+        path.append((r, c))
+    return path
+
+
+def _render_output(
+    shape: tuple[int, int],
+    bg: int,
+    seed: tuple[int, int],
+    ranked_counts: list[tuple[int, int]],
+) -> np.ndarray:
+    total = sum(count for _, count in ranked_counts)
+    path = _spiral_path(seed, total, shape)
+    out = np.full(shape, bg, dtype=int)
+    out[seed] = SEED_COLOR
+
+    start = 0
+    for color, count in ranked_counts:
+        for r, c in path[start : start + count]:
+            out[r, c] = int(color)
+        start += count
+    assert start == total
+    return out
+
