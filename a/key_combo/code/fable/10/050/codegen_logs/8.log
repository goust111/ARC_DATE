319: def _force_overlap(positions, i, j, frames, grid_h, grid_w):
320:     """Try to reposition frame j so it overlaps frame i. Modifies positions in place."""
321:     fi_h, fi_w = frames[i][2].shape
322:     fj_h, fj_w = frames[j][2].shape
323:     ri, ci = positions[i]
324:     r0_min = max(0, ri - fj_h + 2)
325:     r0_max = min(grid_h - fj_h, ri + fi_h - 2)
326:     c0_min = max(0, ci - fj_w + 2)
327:     c0_max = min(grid_w - fj_w, ci + fi_w - 2)
328:     if r0_min > r0_max or c0_min > c0_max:
329:         return
