340: def _render_frames(frames, positions, render_order, grid_h, grid_w):
341:     """Render frame walls onto grid; return grid and set of visible frame pixel coords."""
342:     grid = np.zeros((grid_h, grid_w), dtype=int)
343:     # Paint walls in render order (later overwrites earlier at overlaps)
344:     for idx in render_order:
345:         r0, c0 = positions[idx]
346:         wall_arr = frames[idx][2]
347:         color = frames[idx][0]
348:         # Vectorized: find wall pixel offsets and stamp color
349:         rs, cs = np.where(wall_arr)
350:         grid[rs + r0, cs + c0] = color
351: 
352:     # Compute visible frame pixels (where grid still shows that frame's color)
353:     frame_mask = np.zeros((grid_h, grid_w), dtype=bool)
354:     for idx in render_order:
355:         r0, c0 = positions[idx]
356:         wall_arr = frames[idx][2]
357:         color = frames[idx][0]
358:         rs, cs = np.where(wall_arr)
359:         abs_rs, abs_cs = rs + r0, cs + c0
360:         visible = grid[abs_rs, abs_cs] == color
361:         frame_mask[abs_rs[visible], abs_cs[visible]] = True
362: 
363:     return grid, frame_mask
