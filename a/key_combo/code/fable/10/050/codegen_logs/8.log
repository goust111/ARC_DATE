354:         p_near = pick_p_near()
355:         walkable[p_near] = True
356:         path_t_to_obs = _greedy_manhattan_path(terminal, p_near, walkable) or _bfs_path(terminal, p_near, walkable)
357:         assert path_t_to_obs is not None, f"no path from terminal {terminal} to obstacle {p_near}"
358:         shifted = [(r + off_r, c + off_c) for r, c in path_t_to_obs]
359:         assert all(0 <= r < h and 0 <= c < w for r, c in shifted), \
360:             "shifted segment path must stay within grid"
361:         assert shifted and shifted[0] == seg_start, \
362:             "shifted path must start at seg_start"
363:         entry = shifted[-1]
364: 
365:         # Obstacle-adjacent skin.
366:         skin = set()
367:         for r, c in obstacle_set:
368:             for nr, nc in neighbors4(r, c):
369:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in obstacle_set:
370:                     skin.add((nr, nc))
371: 
372:         # Pick exit as the farthest walkable skin cell from the terminal (ties resolved by projecting away).
373:         # Use obstacle centroid direction as an 'away' vector.
374:         cr = sum(r for r, _ in obstacle_set) / len(obstacle_set)
375:         cc = sum(c for _, c in obstacle_set) / len(obstacle_set)
376:         away = (cr - terminal[0], cc - terminal[1])
377: 
378:         def skin_ok(p):
379:             r, c = p
380:             return int(g[r, c]) == bg or int(g[r, c]) == seg_col
381: 
382:         skin_candidates = [p for p in skin if skin_ok(p)] + [entry]
383:         def exit_key(p):
384:             r, c = p
385:             md = abs(r - terminal[0]) + abs(c - terminal[1])
386:             dot = (r - terminal[0]) * away[0] + (c - terminal[1]) * away[1]
387:             return (md, dot, -r, -c)
388: 
389:         exit_cell = max(skin_candidates, key=exit_key)
390: 
391:         # BFS along skin (8-neigh) from entry to exit.
392:         skin_walkable = np.zeros((h, w), dtype=bool)
393:         for r, c in skin:
394:             if skin_ok((r, c)):
395:                 skin_walkable[r, c] = True
396:         skin_walkable[entry] = True
397:         skin_walkable[exit_cell] = True
398:         boundary_path = _bfs_path_with_diag_filter(entry, exit_cell, skin_walkable) or [entry]
399: 
400:         # Extension direction is the last step used to reach the exit on the skin path.
401:         assert len(boundary_path) >= 2, "boundary path must have at least 2 cells to derive extension direction"
402:         dr_ext = boundary_path[-1][0] - boundary_path[-2][0]
403:         dc_ext = boundary_path[-1][1] - boundary_path[-2][1]
404: 
405:         route = list(shifted)
406:         if boundary_path and boundary_path[0] == entry:
407:             route.extend(boundary_path[1:])
408: 
409:         cur = route[-1]
410:         while len(route) < L:
411:             nr, nc = cur[0] + dr_ext, cur[1] + dc_ext
412:             if not (0 <= nr < h and 0 <= nc < w):
413:                 break
414:             if int(g[nr, nc]) != bg and int(g[nr, nc]) != seg_col:
415:                 break
416:             route.append((nr, nc))
417:             cur = (nr, nc)
418: 
419:         new_pts = route[:L]
420: 
421:         # Assert: output segment must not overlap obstacle
422:         assert not any(p in obstacle_set for p in new_pts), "output segment passes through obstacle"
423: 
424:         # Assert: output segment has monotone wrapping shape (FL*F*FR* or FR*F*FL*)
425:         rs_bar = [r for r, _ in bar_comp]
426:         cs_bar = [c for _, c in bar_comp]
427:         if len(set(cs_bar)) == 1:
428:             fwd = (1, 0) if min(rs_bar) == 0 else (-1, 0)
429:         else:
430:             fwd = (0, 1) if min(cs_bar) == 0 else (0, -1)
431:         step_classes = []
432:         for j in range(len(new_pts) - 1):
433:             dr = new_pts[j + 1][0] - new_pts[j][0]
434:             dc = new_pts[j + 1][1] - new_pts[j][1]
435:             fwd_comp = dr * fwd[0] + dc * fwd[1]
436:             perp_comp = dr * fwd[1] + dc * (-fwd[0])
437:             if abs(dr) + abs(dc) == 1:
438:                 step_classes.append('F' if fwd_comp > 0 else 'X')
439:             elif fwd_comp > 0 and perp_comp > 0:
440:                 step_classes.append('FR')
441:             elif fwd_comp > 0 and perp_comp < 0:
442:                 step_classes.append('FL')
443:             else:
444:                 step_classes.append('X')
445:         s = ''.join(step_classes)
446:         import re
447:         assert re.fullmatch(r'(FL)*(F)*(FR)*', s) or re.fullmatch(r'(FR)*(F)*(FL)*', s), \
448:             f"output segment not monotone wrap: {' '.join(step_classes)}"
449: 
450:         # Assert: when approach diagonal exists (p1>=1), obstacle must be 4-adj to V apex inner side
451:         first_step = step_classes[0] if step_classes else ''
452:         if first_step in ('FL', 'FR'):
453:             p1_end = 0
454:             for j2, sc in enumerate(step_classes):
455:                 if sc == first_step:
456:                     p1_end = j2 + 1
457:                 else:
458:                     break
459:             apex = new_pts[p1_end]
460:             perp_dir = (seg_start[0] - terminal[0], seg_start[1] - terminal[1])
461:             inner = (-perp_dir[0], -perp_dir[1])
462:             apex_inner = (apex[0] + inner[0], apex[1] + inner[1])
463:             assert apex_inner in obstacle_set, \
464:                 f"obstacle not tight at V apex: apex={apex}, inner={apex_inner}"
465: 
466:         moves.append((seg_comp, seg_col, new_pts))
467: 
468:     # Clear segments first, then repaint.
469:     for seg_comp, seg_col, _ in moves:
470:         for r, c in seg_comp:
471:             out[r, c] = bg
472: 
473:     for _, seg_col, new_pts in moves:
474:         for r, c in new_pts:
475:             if int(out[r, c]) == bg:
476:                 out[r, c] = seg_col
477:     return out
