92:     """Return a 3x3 grid with one uniformly sampled foreground marker."""
93:     inp = np.zeros((INPUT_SIZE, INPUT_SIZE), dtype=int)
94:     pos = random.randrange(INPUT_CELL_COUNT)
95:     inp[pos // INPUT_SIZE, pos % INPUT_SIZE] = random.randint(FOREGROUND_MIN, FOREGROUND_MAX)
96:     return inp
