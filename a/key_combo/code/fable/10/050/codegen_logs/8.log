7: def _gap_columns(g: np.ndarray, bg: int) -> dict[int, list[tuple[int, int]]]:
8:     H, W = g.shape
9:     gaps: dict[int, list[tuple[int, int]]] = {}
10:     for r in range(H):
11:         for c in range(1, W - 1):
12:             left = int(g[r, c - 1])
13:             if int(g[r, c]) == bg and left != bg and left == int(g[r, c + 1]):
14:                 gaps.setdefault(c, []).append((r, left))
15:     return gaps
