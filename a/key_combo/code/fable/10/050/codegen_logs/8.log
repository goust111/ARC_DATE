505: def _terminal_for(edge: str, n: int, bar_len: int, pos: int) -> tuple[int, int]:
506:     """Return the interior endpoint of a bar placed along *edge*."""
507:     if edge == "top":
508:         return (bar_len - 1, pos)
509:     if edge == "bottom":
510:         return (n - bar_len, pos)
511:     if edge == "left":
512:         return (pos, bar_len - 1)
513:     return (pos, n - bar_len)
514: 
515: 
516: def _transform(
517:     locals_: list[tuple[int, int]], edge: str, n: int, bar_len: int, pos: int
518: ) -> list[tuple[int, int]]:
519:     """Map local (fwd, side) coords to global (row, col) for a given edge/pos."""
520:     tr, tc = _terminal_for(edge, n, bar_len, pos)
521:     fr, fc = EDGE_DATA[edge]["fwd"]
522:     sr, sc = EDGE_DATA[edge]["side"]
523:     return [(tr + lr * fr + lc * sr, tc + lr * fc + lc * sc) for lr, lc in locals_]
524: 
525: 
526: def _grow_obstacle(
527:     start: tuple[int, int], max_size: int, forbidden: set[tuple[int, int]]
528: ) -> list[tuple[int, int]]:
529:     """Grow a 4-connected sprite from *start*, avoiding *forbidden* cells."""
530:     obstacle = {start}
531:     for _ in range(max_size - 1):
532:         cands = [
533:             (nr, nc)
534:             for r, c in obstacle
535:             for nr, nc in neighbors4(r, c)
536:             if (nr, nc) not in obstacle and (nr, nc) not in forbidden
537:         ]
538:         if not cands:
539:             break
540:         obstacle.add(random.choice(cands))
541:     return list(obstacle)
542: 
543: 
544: def _build_input_path(seg_len: int, turns: int, side: int) -> list[tuple[int, int]]:
545:     """Build an irregular 8-connected stroke going backward (away from border)."""
546:     remaining = seg_len - 1
547:     coords = [(0, side)]
548:     diag_step = (-1, side)
549:     orth_step = (-1, 0)
550:     last_was_diag = None
551:     turns_left = turns
552:     while remaining > 0:
553:         if turns_left <= 0:
554:             step = diag_step if last_was_diag else orth_step
555:             if last_was_diag is None:
556:                 step = random.choice([diag_step, orth_step])
557:             run = remaining
558:         else:
559:             if last_was_diag is None:
560:                 is_diag = random.random() < DIAG_START_PROB
561:             elif last_was_diag:
562:                 is_diag = random.random() < DIAG_CONTINUE_PROB
563:             else:
564:                 is_diag = random.random() < DIAG_START_PROB
565:             step = diag_step if is_diag else orth_step
566:             if last_was_diag is not None and is_diag != last_was_diag:
567:                 turns_left -= 1
568:             max_run = remaining - turns_left
569:             run = random.randint(1, max(1, min(max_run, remaining)))
570:         last_was_diag = (step == diag_step)
571:         for _ in range(run):
572:             pr, pc = coords[-1]
573:             coords.append((pr + step[0], pc + step[1]))
574:         remaining -= run
575:     return coords
576: 
577: 
578: def _build_output_path(
579:     seg_len: int, side: int, p1: int, p2: int, p3: int
580: ) -> list[tuple[int, int]]:
581:     """Build the 3-phase monotone output segment in local coords."""
582:     coords = [(0, side)]
583:     # (fwd_dr, lateral_dc) for each phase: approach, alongside, exit
584:     phase_steps = [(1, side), (1, 0), (1, -side)]
585:     for phase_len, (dr, dc) in zip([p1, p2, p3], phase_steps):
586:         for _ in range(phase_len):
587:             pr, pc = coords[-1]
588:             coords.append((pr + dr, pc + dc))
589:     return coords
590: 
591: 
592: def _is_4adj(coords_a: list[tuple[int, int]], coords_b: list[tuple[int, int]]) -> bool:
593:     """Return True if any cell in *coords_a* overlaps or is 4-adjacent to *coords_b*."""
594:     bset = set(coords_b)
595:     for r, c in coords_a:
596:         if (r, c) in bset:
597:             return True
598:         for nr, nc in neighbors4(r, c):
599:             if (nr, nc) in bset:
600:                 return True
601:     return False
602: 
