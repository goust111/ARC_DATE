111:     out: np.ndarray, col: int, gap_rows: list[int], colors: list[int]
112: ) -> None:
113:     start = 0
114:     for row, color in zip(gap_rows, colors[:-1]):
115:         out[start : row + 1, col] = color
116:         start = row + 1
117:     out[start:, col] = colors[-1]
