121:     n = random.randint(GAP_COUNT_MIN, GAP_COUNT_MAX)
122:     distance = random.randint(GAP_DISTANCE_MIN, GAP_DISTANCE_MAX)
123:     c1 = random.randint(INTERIOR_COL_MIN, INTERIOR_COL_MAX - distance)
124:     c2 = c1 + distance
125: 
126:     below_count = random.randint(BOTTOM_BELOW_MIN, BOTTOM_BELOW_MAX)
127:     bottom_row = GRID_H - 1 - below_count
128:     above_rows = sorted(random.sample(range(bottom_row), 2 * (n - 1)))
129: 
130:     first_side = random.choice([SIDE_LEFT, SIDE_RIGHT])
131:     second_side = SIDE_RIGHT if first_side == SIDE_LEFT else SIDE_LEFT
132:     sides = [first_side if i % 2 == 0 else second_side for i in range(len(above_rows))]
133:     left_gap_rows = [row for row, side in zip(above_rows, sides) if side == SIDE_LEFT]
134:     right_gap_rows = [row for row, side in zip(above_rows, sides) if side == SIDE_RIGHT]
135:     left_gap_rows.append(bottom_row)
136:     right_gap_rows.append(bottom_row)
137: 
138:     left_colors, right_colors = _gen_color_sequences(n)
139: 
140:     out = np.zeros((GRID_H, GRID_W), dtype=int)
141:     _gen_fill_column(out, c1, left_gap_rows, left_colors)
142:     _gen_fill_column(out, c2, right_gap_rows, right_colors)
143: 
144:     for row, color in zip(left_gap_rows[:-1], left_colors[:-2]):
145:         end_col = random.randint(c1 + LEFT_END_MIN, c2 - LEFT_END_BEFORE_C2)
146:         out[row, : end_col + 1] = color
147: 
148:     for row, color in zip(right_gap_rows[:-1], right_colors[:-2]):
149:         start_col = random.randint(c1 + RIGHT_START_AFTER_C1, c2 - RIGHT_START_BEFORE_C2)
150:         out[row, start_col:] = color
151: 
152:     bottom_left = left_colors[-2]
153:     bottom_right = right_colors[-2]
154:     if bottom_left == bottom_right:
155:         out[bottom_row, :] = bottom_left
156:     else:
157:         split_col = random.randint(c1 + SPLIT_AFTER_C1, c2 - SPLIT_BEFORE_C2)
158:         out[bottom_row, : split_col + 1] = bottom_left
159:         out[bottom_row, split_col + 1 :] = bottom_right
160: 
161:     inp = out.copy()
162:     inp[:, c1] = BG
163:     inp[:, c2] = BG
164: 
165:     left_marker_start = _gen_marker_start(bottom_row)
166:     right_marker_start = _gen_marker_start(bottom_row)
167:     inp[left_marker_start:, c1] = left_colors[-1]
168:     inp[right_marker_start:, c2] = right_colors[-1]
169: 
170:     if np.array_equal(main(inp), out):
171:         return inp
172:     return None
