112:     corners = [
113:         ((0, 0), (h - 1, w - 1)),
114:         ((0, w - 1), (h - 1, 0)),
115:         ((h - 1, 0), (0, w - 1)),
116:         ((h - 1, w - 1), (0, 0)),
117:     ]
118:     (r, c), (er, ec) = random.choice(corners)
119:     steps = []
120:     steps.extend([(1 if er > r else -1, 0)] * abs(er - r))
121:     steps.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
122:     random.shuffle(steps)
