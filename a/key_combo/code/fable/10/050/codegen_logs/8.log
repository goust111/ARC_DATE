+    labels = np.full((h, w), -1, dtype=int)
+    for idx, (r, c) in enumerate(seeds):
+        labels[r, c] = idx
+    sizes = [1] * components
+
+    while sizes != targets:
+        progressed = False
+        order = list(range(components))
+        random.shuffle(order)
+        for idx in order:
