68: GRID_H, GRID_W, BG = 15, 15, 0
69: COLOR_POOL = range(1, 10)
70: MIN_COLORS, MAX_COLORS, MAX_ATTEMPTS = 3, 7, 300
71: 
72: # Gap columns, bar rows, and side order.
73: GAP_COUNT_MIN, GAP_COUNT_MAX = 1, 3
74: GAP_DISTANCE_MIN, GAP_DISTANCE_MAX = 4, 8
75: INTERIOR_COL_MIN, INTERIOR_COL_MAX = 1, 13
76: BOTTOM_BELOW_MIN, BOTTOM_BELOW_MAX = 1, 8
77: SIDE_LEFT, SIDE_RIGHT = "L", "R"
78: 
79: # Horizontal span offsets from the two gap columns.
80: LEFT_END_MIN, LEFT_END_BEFORE_C2 = 2, 1
81: RIGHT_START_AFTER_C1, RIGHT_START_BEFORE_C2 = 1, 2
82: SPLIT_AFTER_C1, SPLIT_BEFORE_C2 = 1, 2
83: 
84: # Terminal-marker gap and length bounds.
85: MARKER_GAP_MIN, MARKER_GAP_MAX = 0, 2
86: MARKER_LEN_MIN, MARKER_LEN_MAX = 1, 6
