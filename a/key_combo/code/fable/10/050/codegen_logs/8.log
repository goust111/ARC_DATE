366: def _scatter_noise(grid, frame_mask, noise_color, grid_h, grid_w):
367:     """Place noise pixels on non-wall cells and damage some wall cells."""
368:     total_cells = grid_h * grid_w
369:     noise_fraction = random.uniform(*_NOISE_FRACTION_RANGE)
370:     noise_count = int(total_cells * noise_fraction)
371: 
372:     # Non-wall positions
373:     nonwall_rs, nonwall_cs = np.where(~frame_mask)
374:     perm = np.random.permutation(len(nonwall_rs))
375:     n_nonwall = min(noise_count, len(perm))
376:     sel = perm[:n_nonwall]
377:     grid[nonwall_rs[sel], nonwall_cs[sel]] = noise_color
378:     placed = n_nonwall
379: 
380:     # Wall damage (up to _WALL_DAMAGE_FRACTION of wall pixels)
381:     wall_rs, wall_cs = np.where(frame_mask)
382:     n_wall = len(wall_rs)
383:     max_damage = min(noise_count - placed, int(_WALL_DAMAGE_FRACTION * n_wall))
384:     if max_damage > 0:
385:         damage_perm = np.random.permutation(n_wall)[:max_damage]
386:         grid[wall_rs[damage_perm], wall_cs[damage_perm]] = noise_color
