5: def _clipped_spiral_edges(center: tuple[int, int], size: int) -> list[tuple[tuple[int, int], tuple[int, int]]]:
6:     def inside(r: int, c: int) -> bool:
7:         return 0 <= r < size and 0 <= c < size
8: 
9:     r, c = center
10:     assert inside(r, c)
11:     visited = {(r, c)}
12:     edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
13:     directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]
14:     step_len = 1
15:     direction_index = 0
16: 
17:     while len(visited) < size * size:
18:         assert step_len <= size * 2
19:         for _ in range(2):
20:             dr, dc = directions[direction_index % len(directions)]
21:             for _ in range(step_len):
22:                 nr, nc = r + dr, c + dc
23:                 if inside(r, c) and inside(nr, nc):
24:                     edges.append(((r, c), (nr, nc)))
25:                 r, c = nr, nc
26:                 if inside(r, c):
27:                     visited.add((r, c))
28:             direction_index += 1
29:         step_len += 1
30: 
31:     return edges
32: 
