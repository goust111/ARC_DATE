88: def _gen_color_sequences(n: int) -> tuple[list[int], list[int]]:
89:     total = random.randint(max(MIN_COLORS, n + 1), min(MAX_COLORS, 2 * n + 2))
90:     palette = random.sample(COLOR_POOL, total)
91: 
92:     left_seq = random.sample(palette, n + 1)
93:     missing_from_left = [color for color in palette if color not in left_seq]
94:     right_seq = missing_from_left + random.sample(left_seq, n + 1 - len(missing_from_left))
95:     random.shuffle(right_seq)
96:     return left_seq, right_seq
97: 
