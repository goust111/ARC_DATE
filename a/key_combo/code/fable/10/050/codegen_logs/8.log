  "trajectory": "paint every lattice node and the midpoint pixel of each retained adjacent-node step with s.color",
  "transform": "use the input background color for all non-painted output pixels",
  "grid_shape": "9x9 doubled 5x5 node lattice"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    input: 3x3
    output: 9x9 (doubled 5x5 lattice; even-even = nodes, odd-even/even-odd = edge midpoints)
  input:
    bg: 0 [observed]
    fg: any non-zero color (1-9), exactly 1 pixel, remaining 8 pixels are bg
    marker_position: any of the 9 cells (r,c) in [0..2]x[0..2]
  output:
    all 25 lattice nodes (even-even positions) painted fg
    spiral_edges: |
      map marker (r,c) to lattice center (2r,2c); trace outward square spiral
      with step lengths 1,1,2,2,3,3,... in direction cycle up,right,down,left;
      for each step whose both endpoints are inside the 5x5 lattice, paint the
      midpoint cell with fg; all other cells remain bg
    fg_cell_count: 45-49 depending on position (center=49, edge=45, corner=45-46 [observed])
    diagonal_cells: always bg (odd-odd positions)

generation_strategy:
  approach: direct (input is trivial to construct; output is deterministic)
  steps:
    1. pick fg color uniformly from 1-9
    2. pick marker position (r,c) uniformly from [0..2]x[0..2]
    3. build 3x3 input with bg=0 everywhere except (r,c)=fg
    4. output is fully determined by solver -- no need to pre-build
