483: # ── CFG: tunable generation parameters ──────────────────────────────────────
484: GRID_SIZE_MIN, GRID_SIZE_MAX = 7, 27       # square grid side length
485: BAR_LEN_MIN, BAR_LEN_MAX = 3, 7           # bar length (px)
486: BAR_CLEARANCE = 4                           # n must exceed bar_len by this much
487: SEG_LEN_MIN, SEG_LEN_MAX = 5, 9           # segment pixel count
488: PHASE_MAX = 3                               # max length for p1 and p2 individually
489: OBS_SIZE_MIN, OBS_SIZE_MAX = 1, 9          # obstacle sprite pixel count
490: OBS_MD_MIN, OBS_MD_MAX = 2, 6             # obstacle manhattan distance from terminal
491: INPUT_TURN_MIN, INPUT_TURN_MAX = 2, 5     # turns in the input irregular stroke
492: DIAG_CONTINUE_PROB = 0.35                  # probability of continuing a diagonal run
493: DIAG_START_PROB = 0.5                       # probability of starting/switching to diagonal
494: MAX_RETRIES = 300                           # generate_input retry budget
495: PLACEMENT_PAD = 1                           # padding around placed triples
496: 
497: EDGE_DATA = {
498:     "top": {"fwd": (1, 0), "side": (0, 1)},
499:     "bottom": {"fwd": (-1, 0), "side": (0, -1)},
500:     "left": {"fwd": (0, 1), "side": (-1, 0)},
501:     "right": {"fwd": (0, -1), "side": (1, 0)},
