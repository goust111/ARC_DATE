9: def _frame_mask(shape: tuple[int, int], b: tuple[int, int, int, int]) -> np.ndarray:
10:     r0, c0, r1, c1 = b
11:     assert r0 < r1 and c0 < c1, "each frame must have positive height and width"
12: 
13:     mask = np.zeros(shape, dtype=bool)
14:     mask[r0 : r1 + 1, c0] = True
15:     mask[r0 : r1 + 1, c1] = True
16:     mask[r0, c0 : c1 + 1] = True
17:     mask[r1, c0 : c1 + 1] = True
18:     return mask
