+        if len(set(candidate)) == k and all(a != b for a, b in zip(candidate, targets)):
+            return candidate
+    return None
+
+
+def _render_input(
+    zone_h: int,
+    zone_w: int,
+    key_zone: tuple[int, int],
+    sprite_zones: list[tuple[int, int]],
+    mask: np.ndarray,
+    key_patch: np.ndarray,
+    sprite_colors: list[int],
+) -> np.ndarray | None:
+    h, w = 3 * zone_h, 3 * zone_w
