+            mask[r, c] = True
+        if int(mask.sum()) != target_area:
+            continue
+        coords = np.argwhere(mask)
+        if _bbox(coords) != (0, 0, h - 1, w - 1):
+            continue
+        if h == 3 and w == 3 and bool(mask.all()):
