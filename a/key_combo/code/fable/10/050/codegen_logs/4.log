+        return mask
+    return None
+
+
+def _pick_key_zone() -> tuple[int, int]:
+    choices = ((1, 1), (1, 2), (2, 1), (2, 2))
+    return choices[int(np.random.randint(len(choices)))]
+
+
+def _pick_sprite_zones(key_zone: tuple[int, int]) -> list[tuple[int, int]] | None:
