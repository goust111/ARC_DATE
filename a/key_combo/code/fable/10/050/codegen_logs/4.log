  "type": "transform_in_place",
  "src": "noisy lattice with complete non-background separator rows/columns and scattered marker-color pixels",
  "transform": "clear marker pixels outside lattice intersections; repaint separator rows/columns with the lattice color and paint every intersection with the marker color"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 13-27 rows x 13-27 cols
  colors:
    bg: 0 (black), always dominant
    line_color: 5 (gray) [observed]
    marker_color: any non-bg, non-line color (one of 1-4 observed)
  lattice:
    separator lines are single-pixel rows and columns spanning full width/height
    uniform spacing S between separators; cell_size = S-1, S in 4-6
    first separator at row/col = cell_size (full first cell)
    num_sep_rows: 2-5, num_sep_cols: 2-6
    last gap (after final separator) can be 0..cell_size (grid may be truncated)
  noise:
    marker_color pixels scattered in three zones of the input:
      1. in cell interiors (bg area) — 5-18% of cell area
      2. on separator rows/cols (replacing line_color) — 3-16% of sep-line cells
      3. at intersections — some may already be marker, most are line_color
    total marker pixels in input: 18-57
  output:
    same size as input
    all cell interiors are bg (noise cleared)
    all separator rows/cols painted with line_color
    every intersection (sep_row x sep_col) painted with marker_color
    marker_color pixels in output = num_sep_rows * num_sep_cols

generation_strategy:
  approach: output-first
  steps:
    1. Pick cell_size in [3,5], num_sep_rows in [2,5], num_sep_cols in [2,6]
    2. Place separators at cell_size, 2*cell_size+1, ... for rows and cols
    3. Choose last_row_gap in [0, cell_size] and last_col_gap in [0, cell_size]
       to set grid dimensions; grid_h = last_sep_row + 1 + last_row_gap, similar for width
    4. Build output — fill bg, paint sep rows/cols with line_color=5, intersections with marker_color
    5. Build input from output — copy output, then add noise:
       a. Scatter marker_color pixels in 5-18% of cell-interior bg cells
       b. Replace 3-16% of line_color cells on sep rows/cols with marker_color
       c. Optionally replace some intersection cells back to line_color (solver tolerates this)
    6. Verify solver constraint — line_color must be uniquely identified as the color
       with max single-row/col count among foreground colors (noise must not exceed line pixels)
