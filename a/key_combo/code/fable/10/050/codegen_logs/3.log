spec:
  grid: 12x12 [observed]
  background: black (0)
  foreground_masks:
    count: exactly 3 distinct non-black colors
    pixel_counts: all three must be distinct; range 3-14 per mask
    total_fg_density: 10-20% of grid cells
    shape: irregular blobs; 1-3 connected components per mask; bbox fill ratio 0.4-0.85
    placement: bounding boxes of different colors must NOT overlap
    colors: 3 distinct non-black colors chosen from 1-9
  output:
    shape: 3x1 column
    content: the 3 foreground colors sorted by descending pixel count

generation_strategy:
  approach: direct (task is simple counting; no complex inversion needed)
  steps:
    1. Pick grid size 12x12 and 3 distinct non-black colors.
    2. Choose 3 distinct pixel counts (e.g. sample from 3-14 ensuring all different).
    3. For each color, pick a random bounding-box position on the grid; reject if any two bboxes overlap (with 1-cell gap for visual clarity).
    4. Within each bbox, randomly place exactly the required number of pixels (1-3 connected components, fill ratio 0.4-0.85).
    5. Output = 3x1 column of colors sorted by descending count.
```
