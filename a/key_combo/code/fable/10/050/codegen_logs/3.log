        ((h - 1, 0), (0, w - 1)),
        ((h - 1, w - 1), (0, 0)),
    ]
    (r, c), (er, ec) = random.choice(corners)
    steps = []
    steps.extend([(1 if er > r else -1, 0)] * abs(er - r))
    steps.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
    random.shuffle(steps)

    mask = np.zeros((h, w), dtype=bool)
