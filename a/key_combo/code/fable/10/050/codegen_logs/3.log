+    for c, filled in enumerate(profile):
+        if height % 2 == 1:
+            reach = (filled - 1) // 2
+            r0 = mid - reach
+            r1 = mid + reach
+        else:
+            reach = (filled - 2) // 2
+            r0 = mid - 1 - reach
+            r1 = mid + reach
