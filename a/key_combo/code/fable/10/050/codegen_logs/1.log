+def _bbox_from_center(center: tuple[int, int], size: tuple[int, int]) -> tuple[int, int, int, int]:
+    r, c = center
+    hh, ww = size
+    hr = hh // 2
+    wc = ww // 2
+    return (r - hr, c - wc, r + hr, c + wc)
