_VCOL_LEFT_PAD = 4                          # min offset from bar_start for vertical corridors
_VCOL_RIGHT_PAD = 2                         # min distance from right edge
_VCOL_WINDOW = (-1, 0, 1)                   # columns reserved per allocated vcol

