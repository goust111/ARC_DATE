+def _render_input(
+    shape: tuple[int, int],
+    bboxes: list[tuple[int, int, int, int]],
+    order: list[int],
+) -> tuple[np.ndarray, list[np.ndarray]]:
+    grid = np.full(shape, BACKGROUND, dtype=int)
+    masks = [_frame_mask(shape, bbox) for bbox in bboxes]
+    for color, mask in zip(order, masks):
+        grid[mask] = int(color)
+    return grid, masks
+
