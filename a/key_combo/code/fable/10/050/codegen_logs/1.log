+
+        return bboxes
+    return None
+
+
+def _segment_bg_budget(grid: np.ndarray, centers: list[tuple[int, int]]) -> list[int]:
+    counts: list[int] = []
+    for a, b in zip(centers, centers[1:]):
+        cells = _segment_open_cells(a, b)
+        counts.append(sum(int(grid[r, c]) == BACKGROUND for r, c in cells))
+    return counts
+
