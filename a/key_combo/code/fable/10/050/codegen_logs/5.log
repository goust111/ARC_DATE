+def _paint_by_segments(base: np.ndarray, path: list[Coord], colors: list[int], lengths: list[int]) -> np.ndarray:
+    assert sum(lengths) == len(path)
+    out = base.copy()
+    idx = 0
+    for color, length in zip(colors, lengths):
+        for _ in range(length):
