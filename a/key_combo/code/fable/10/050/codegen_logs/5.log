+    if len(info["segment_colors"]) < SEGMENT_COUNT_RANGE[0]:
+        return False
+    if not (TURN_COUNT_RANGE[0] <= len(info["turns"]) <= TURN_COUNT_RANGE[1]):
+        return False
+    if not _segment_layout_ok(info["path"], info["segment_lengths"]):
+        return False
