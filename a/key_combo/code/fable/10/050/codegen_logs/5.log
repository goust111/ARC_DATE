+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+ANCHOR_COLOR = 5
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+PATH_COLOR_POOL = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_ROWS_RANGE = (11, 18)
+GRID_COLS_RANGE = (11, 18)
