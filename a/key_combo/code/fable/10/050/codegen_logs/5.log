+    grid = np.full((rows, cols), bg, dtype=int)
+    idx = 0
+    for color, length in zip(colors, seg_lengths):
+        for _ in range(length):
+            r, c = ordered_path[idx]
+            grid[r, c] = int(color)
+            idx += 1
+    grid[anchor_cell] = ANCHOR_COLOR
+
+    if not _semantic_accept(grid):
+        return None
+    return grid
