+def _sample_segment_lengths() -> list[int]:
+    for _ in range(200):
+        k = random.randint(*SEGMENT_COUNT_RANGE)
+        lengths = random.sample(SEGMENT_LENGTH_POOL, k)
+        total = sum(lengths)
+        if TOTAL_PATH_LEN_RANGE[0] <= total <= TOTAL_PATH_LEN_RANGE[1]:
+            random.shuffle(lengths)
+            return lengths
