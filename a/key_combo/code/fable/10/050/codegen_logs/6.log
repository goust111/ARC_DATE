+    if has_corners:
+        for r, c in CORNER_ORBIT:
+            mask[r, c] = True
+    if has_edges:
+        for r, c in EDGE_ORBIT:
+            mask[r, c] = True
+    if has_center:
+        mask[1, 1] = True
+    return mask
+
