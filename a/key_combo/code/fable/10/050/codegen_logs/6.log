+        r0, c0 = _cell_origin(cell_r, cell_c)
+        grid[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE] = 0
+    return grid
+
+
+def _paint_cells(grid: np.ndarray, cells: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
