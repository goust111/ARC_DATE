# Canvas/object ranges are inclusive.
GEN_BG = Color.BLACK
GRID_ROWS = (13, 17)
GRID_COLS = (23, 30)
SPRITE_COUNT = (3, 5)

# Shared sprite geometry/density.
SPRITE_H = (4, 5)
SPRITE_W = (4, 6)
SPRITE_DENSITY = (0.60, 0.80)

# Placement and retry limits.
