+def _analyze_asymmetric_cell(cell: np.ndarray, bg: int) -> dict[str, object] | None:
+    fg_colors = sorted(set(int(v) for v in np.unique(cell)) - {int(bg)})
+    if len(fg_colors) != 1:
+        return None
