+    top = np.zeros(categories.shape, dtype=int)
+    bottom = np.zeros(categories.shape, dtype=int)
+    top[(categories == 1) | (categories == 3)] = top_color
+    bottom[(categories == 2) | (categories == 3)] = bottom_color
+    return top, bottom
