+def _check_semantics(grid: np.ndarray) -> bool:
+    try:
+        top, bottom = _split_panels(grid)
+        if top.shape != bottom.shape:
+            return False
+
+        n, m = top.shape
+        if max(grid.shape) > 30 or n * n > 30 or m * m > 30:
+            return False
