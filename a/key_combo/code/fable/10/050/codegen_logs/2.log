+        top_fg = top != BLACK
+        bottom_fg = bottom != BLACK
+        both_bg = (~top_fg) & (~bottom_fg)
+        top_only = top_fg & (~bottom_fg)
+        bottom_only = (~top_fg) & bottom_fg
+        both_fg = top_fg & bottom_fg
