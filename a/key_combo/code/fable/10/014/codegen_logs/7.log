  "dst": "3x3 grid windows d",
  "match_cond": "d matches s on every non-yellow cell and has bg/yellow at s.yellow-mask cells",
  "transform": "paint s.yellow-mask cells yellow in each matched d; leave all other pixels unchanged"
}
</annotation>
