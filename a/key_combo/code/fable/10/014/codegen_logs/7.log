+    expected = _fill_box(grid, all_rows, all_cols, box)
+    observed_only = _fill_box(grid, marked_rows, marked_cols, box)
+    any_blue_rows = [int(r) for r in np.where(np.any(grid == BLUE, axis=1))[0]]
