+    spans: list[tuple[str, int, int]] = []
+    if start >= 2:
+        spans.append(("before", 0, start - 1))
+    if end - start >= 3:
+        spans.append(("inside", start + 1, end - 1))
+    if size - end - 1 >= 2:
