  49:     # Find the template object, which is the biggest object after you scale the indicator down to have size 1x1
  50:     object_sizes = [ np.sum(obj != background) for obj in objects]
  51:     indicator_sizes = [ np.sum(obj == indicator_color) for obj in objects]
  52:     rescaled_sizes = [size // indicator_size for size, indicator_size in zip(object_sizes, indicator_sizes)]
  53:     template_index = np.argmax(rescaled_sizes)
  54:     template_object = objects[template_index]
  55:     other_objects = [obj for i, obj in enumerate(objects) if i != template_index]
