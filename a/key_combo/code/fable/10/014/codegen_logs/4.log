+            continue
+        move_dirs = _path_move_dirs(path)
+        has_h = any(dc != 0 for _dr, dc in move_dirs)
+        has_v = any(dr != 0 for dr, _dc in move_dirs)
+        if not (has_h and has_v):
+            continue
