+            "bbox": box,
+            "patch": patch,
+            "side": side,
+            "center": center,
+        }
+        tid = len(tiles)
+        tiles.append(tile)
+        for rr in range(r0, r1 + 1):
+            for cc in range(c0, c1 + 1):
+                cell_to_tile[(rr, cc)] = tid
