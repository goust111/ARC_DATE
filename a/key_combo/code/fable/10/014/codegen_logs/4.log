+SIDE_OPTIONS = (3, 5)
+TILE_COUNT_OPTIONS = (3, 4, 5)
+LATTICE_SIDE = 4
+MAX_GENERATION_ATTEMPTS = 600
+RECENT_SIGNATURE_LIMIT = 256
