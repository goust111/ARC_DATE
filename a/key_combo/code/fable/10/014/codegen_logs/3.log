  "dst": "non-anchor control pixels d",
  "match_cond": "a aligns to each d",
  "transform": "stamp s's source-color offsets around every d on a clean background; erase original source mask and all control pixels"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 13x13, background 0
  colors: exactly 3 non-bg colors -- source(8), anchor(3), destination(2) [observed constant colors]
  source_mask:
    color: distinct from anchor and destination colors
    pixels: 4-14
    bbox: 3x5 to 5x5 [observed]
    LR-symmetric about anchor column [observed]
    anchor pixel (color 3) lies inside source bbox but is NOT a source pixel (hole/gap)
    anchor is 4-adjacent to >=2 source pixels (observed 2-4)
    source+anchor form a connected 4-component [observed in 3/4 examples]
  anchor:
    single pixel, unique color (3)
    strongest 4-adjacency contact with source among all singletons
  destinations:
