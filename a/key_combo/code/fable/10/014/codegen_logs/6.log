+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    legend_mask, legend_colors = _find_legend(g, bg)
+    blob_mask = (g != bg) & (~legend_mask)
+    depths = _erosion_depths(blob_mask)
