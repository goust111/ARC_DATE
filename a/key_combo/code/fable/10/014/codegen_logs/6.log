+        patches.append((patch, r0, c0))
+        occupied[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] |= patch
+        forbidden = _dilate8(occupied)
+        forbidden[0, :] = True
+        forbidden[-1, :] = True
+        forbidden[:, 0] = True
+        forbidden[:, -1] = True
+
+    if len(patches) < 2:
+        return None
+
+    for patch, r0, c0 in patches:
+        ph, pw = patch.shape
+        grid[r0 : r0 + ph, c0 : c0 + pw][patch] = blob_color
+
+    if not _validate_grid(grid):
+        return None
+    return grid
