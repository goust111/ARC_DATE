spec:
  grid: fixed 16x11, black background
  layout: 3x2 array of 4x4 sprite cells, 1-cell gaps and margins on all sides
  sprites:
    count: 6 (always)
    color: all red (color 2) in input
    cell_size: 4x4
    pixels_per_sprite: 7-14 (holes = 2-9 per 4x4 cell)
    each_sprite: non-empty (>=1 pixel)
    connectivity: 1-3 components per sprite [observed]
  union_relation:
    exactly one destination sprite d whose mask = mask_a | mask_b for two operand sprites a, b
    each operand contributes >=1 unique pixel (a has pixel not in b, and vice versa)
    operand overlap: 4-12 pixels
    if duplicate operand copies create ambiguous triples, all share the same destination
  distractors: remaining 3 sprites must NOT form any additional union triple with a different destination
  output:
    same grid, same layout
    operand sprites a,b recolored teal (color 8)
    destination sprite d recolored green (color 3)
    other 3 sprites remain red
    no structural changes, only color substitution

generation_strategy:
