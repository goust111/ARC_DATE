 100:         ad = _triangle_apex_and_dir(comp)
 101:         if ad is None:
 102:             continue
 103:         (ar, ac), (dr, dc) = ad
 104:         rr = ar + 5 * dr
 105:         cc = ac + 5 * dc
 106:         if 0 <= rr < h and 0 <= cc < w:
 107:             dest_to_shooters.setdefault((rr, cc), []).append(cid)
 108: 
 109:     hit_components: set[int] = set()
 110:     for dest in dest_to_shooters:
