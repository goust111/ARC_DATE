+    forbidden = _dilate8(occupied)
+    forbidden[0, :] = True
+    forbidden[-1, :] = True
+    forbidden[:, 0] = True
+    forbidden[:, -1] = True
+
+    blob_count = _randint(rng, *GEN_BLOB_COUNT_RANGE)
+    for _ in range(blob_count - 1):
+        shallow_depth = rng.choice([1, 1, 2, 2, 3, min(4, k)])
