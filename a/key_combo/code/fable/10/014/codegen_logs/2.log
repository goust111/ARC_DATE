spec:
  grid: 9-13 rows x 13 cols, black (0) background
  structure: |
    An interrupted rectilinear grid of blue (1) pixels on black.
    "Marked rows" have >=1 horizontally-adjacent blue pair within the bbox.
    "Marked cols" have >=1 vertically-adjacent blue pair within the bbox.
  bbox: 7-9 rows x 7-9 cols, defines the foreground extent
  marked_rows: 2-3; always include first and last row of bbox
  marked_cols: 2-3; always include first and last col of bbox
  spacing: 2-8 between consecutive marked rows; 2-8 between consecutive marked cols
  blue_placement:
    on_marked_lines: each marked row/col has 22-44% gap (black) cells; rest blue
    off_marked_lines: blue appears ONLY at intersections of (non-marked row, marked col); never on (non-marked row, non-marked col)
    each_marked_line: must contain >=1 adjacent blue pair (run of >=2) for detection
  padding: 1-4 black rows/cols on each side between grid edge and bbox
  transform:
    within bbox, fill black cells red (2) on every marked row and marked col
    all existing blue pixels preserved unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size (9-13 x 13) and bbox position with 1-4 padding per side
    2. Choose 2-3 marked rows and 2-3 marked cols within bbox; first/last row and col of bbox must be marked; spacings >=2
