+    counts = [int(mask.sum()) for mask in masks]
+    unmatched_count = counts[leftovers[0]]
+    if Counter(counts)[unmatched_count] < 2:
+        return False
+    if unmatched_count == min(counts) or unmatched_count == max(counts):
