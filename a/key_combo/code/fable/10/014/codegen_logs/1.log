+            return None
+    for color in distractor_colors:
+        if color in debug["fill_colors"]:
+            return None
+    if np.array_equal(grid, out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_candidate()
