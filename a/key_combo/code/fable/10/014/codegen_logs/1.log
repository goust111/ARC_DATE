+def _place_patches(patches: list[np.ndarray]) -> np.ndarray | None:
+    max_h = max(p.shape[0] for p in patches)
+    max_w = max(p.shape[1] for p in patches)
+    reserve_area = sum((p.shape[0] + 4) * (p.shape[1] + 4) for p in patches)
