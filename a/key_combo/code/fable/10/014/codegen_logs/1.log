+            c0 = random.randint(0, w - pw)
+            r1 = max(0, r0 - 2)
+            c1 = max(0, c0 - 2)
+            r2 = min(h, r0 + ph + 2)
+            c2 = min(w, c0 + pw + 2)
+            if reserved[r1:r2, c1:c2].any():
