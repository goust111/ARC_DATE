+    w = random.randint(max(18, min_side), 30)
+    canvas = np.zeros((h, w), dtype=int)
+    reserved = np.zeros((h, w), dtype=bool)
+
+    for patch in sorted(patches, key=lambda p: p.shape[0] * p.shape[1], reverse=True):
+        ph, pw = patch.shape
+        placed = False
