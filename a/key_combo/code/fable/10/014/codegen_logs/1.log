+
+def _make_distractor_patch(color: int) -> np.ndarray:
+    ray_len = random.randint(3, 6)
+    patch = np.zeros((3, ray_len + 3), dtype=int)
+    patch[0, 0] = color
+    patch[2, 0] = color
+    patch[1, 1] = color
+    patch[1, ray_len + 2] = GREY
