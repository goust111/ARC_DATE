+
+
+def _build_expected_output(
+    shape: tuple[int, int],
+    offsets: list[Coord],
+    markers: list[tuple[int, Coord, int]],
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for scale, origin, color in markers:
+        for dr, dc in _relative_stamp_cells(offsets, scale):
+            rr = origin[0] + dr
+            cc = origin[1] + dc
+            if out[rr, cc] not in (0, color):
