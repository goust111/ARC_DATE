+def _square_size(comp: dict) -> int | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != w:
+        return None
+    if comp["size"] != h * w:
+        return None
+    if h not in (1, 2, 3):
