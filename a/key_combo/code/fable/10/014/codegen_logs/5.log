+def _relative_stamp_cells(offsets: list[Coord], scale: int) -> list[Coord]:
+    cells: set[Coord] = set()
+    for dr, dc in offsets:
+        base_r = scale * dr
+        base_c = scale * dc
+        for rr in range(scale):
+            for cc in range(scale):
+                cells.add((base_r + rr, base_c + cc))
+    return sorted(cells)
