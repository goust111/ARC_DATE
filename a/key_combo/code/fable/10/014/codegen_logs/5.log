+_ALL_COLORS = tuple(range(1, 10))
+_GRID_MIN = 22
+_GRID_MAX = 30
+_MARKER_COUNT_CHOICES = (3, 4)
+_MARKER_SIZES = (1, 2, 3)
+_SOURCE_DIM_RANGE = (3, 5)
+_GEN_ATTEMPTS = 400
