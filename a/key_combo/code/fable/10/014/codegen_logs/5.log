+    candidates: list[tuple[int, int, int]] = []
+    for anchor_idx, anchor_comp in enumerate(comps):
+        if anchor_comp["size"] != 1:
+            continue
+        ar, ac = anchor_comp["cells"][0]
+        touch_counts: Counter[int] = Counter()
+        for nr, nc in _neighbors4(ar, ac):
