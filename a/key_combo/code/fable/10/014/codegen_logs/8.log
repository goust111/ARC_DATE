spec:
  grid: 22x22, black background
  colors: black(0) background, blue(1) and azure(8) as support/distractor, yellow(4) as fill marker
  template:
    size: exactly 3x3, all 9 cells non-black
    composition: 3-5 support cells (blue/azure mix) + 4-6 yellow cells; both colors present in support
    yellow_bbox: equals the full 3x3 template (yellow cells define the fill mask)
  partial_copies:
    count: 1-2 copies placed elsewhere on the grid
    structure: support cells identical to template; yellow positions hold black (unfilled)
    no_overlap: 3x3 windows of template and all partials are non-overlapping
  distractors:
