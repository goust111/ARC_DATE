+    bboxes: dict[int, tuple[int, int, int, int]] = {}
+    frames: dict[int, np.ndarray] = {}
+    for color in colors:
+        coords = np.argwhere(grid == color)
+        assert coords.size > 0, "each foreground color must remain visible"
