+    assignments: dict[int, list[dict]] = defaultdict(list)
+    for block in blocks:
+        h = int(block["h"])
+        w = int(block["w"])
+        fits_now = w in width_to_container
+        fits_rotated = h in width_to_container
+        if fits_now and not fits_rotated:
