+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return out
+
+
+def _solid_block(grid: np.ndarray, obj: dict) -> dict | None:
+    r0, c0, r1, c1 = obj["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    h, w = sub.shape
+    color = int(obj["color"])
+    if int(obj["area"]) != h * w:
+        return None
+    if not np.all(sub == color):
+        return None
+    return {
+        "kind": "block",
+        "color": color,
+        "bbox": obj["bbox"],
+        "h": int(h),
+        "w": int(w),
+    }
+
+
+def _open_container(grid: np.ndarray, bg: int, obj: dict) -> dict | None:
+    r0, c0, r1, c1 = obj["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    h, w = sub.shape
+    color = int(obj["color"])
+    if h < 2 or w < 3:
+        return None
+    if int(obj["area"]) != 2 * h + w - 2:
+        return None
+    if not np.all(sub[:, 0] == color) or not np.all(sub[:, -1] == color):
+        return None
+    if not np.all(sub[-1, :] == color):
+        return None
+    if not np.all(sub[:-1, 1:-1] == bg):
+        return None
+    return {
+        "kind": "container",
+        "color": color,
+        "bbox": obj["bbox"],
+        "inner_width": int(w - 2),
+        "inner_height": int(h - 1),
+        "inner_left": int(c0 + 1),
+        "inner_right": int(c1 - 1),
+        "inner_top": int(r0),
+        "floor_row": int(r1 - 1),
+    }
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = get_bg(g)
+    containers: list[dict] = []
+    blocks: list[dict] = []
+    for obj in find_components(g, bg):
+        container = _open_container(g, bg, obj)
+        if container is not None:
+            containers.append(container)
