spec:
  grid: 9x9 [observed], background 0 [observed]
  colors: exactly 2 non-background colors
  sprite:
    description: single 8-connected monochromatic component with area 4-6
    fits_in: 3x3 window centered on its centroid (unique unambiguous centering)
    color: 8 [observed]
  markers:
    description: 1-4 isolated single-pixel components, all same color, different from sprite
    color: 4 [observed]
    placement: scattered across grid, no marker adjacent (8-conn) to sprite or other markers
  output:
    shape: 3 rows x (3 * marker_count) cols
    content: the 3x3 sprite tile repeated marker_count times horizontally

generation_strategy:
