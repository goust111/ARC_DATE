+import numpy as np
+
+
+BACKGROUND = 0
+GENERATION_RETRIES = 500
+INNER_WIDTH_CHOICES = (4, 5, 6, 7)
+BLOCK_HEIGHT_CHOICES = (1, 2, 3)
+COUNT_PATTERNS = ((2, 1, 1), (2, 2, 1), (3, 1, 1))
+GAP_CHOICES = (1, 2)
+PALETTE = tuple(range(1, 10))
