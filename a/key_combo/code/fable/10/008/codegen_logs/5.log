+def _render_container(grid: np.ndarray, container: dict) -> None:
+    r0, c0, r1, c1 = container["bbox"]
+    color = int(container["color"])
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
