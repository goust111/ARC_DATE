+    for target_width, assigned in assignments.items():
+        container = width_to_container[target_width]
+        ordered = sorted(
+            assigned,
+            key=lambda item: (item["bbox"][2], item["bbox"][0], -item["bbox"][1]),
+            reverse=True,
