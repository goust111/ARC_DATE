+    grid[r0 + 2, c0 + 2] = GREY
+    grid[r0 + 2, c0 + 1] = action_to_color[ACTION_LEFT]
+    grid[r0 + 2, c0 + 3] = action_to_color[ACTION_RIGHT]
+    grid[r0 + 1, c0 + 2] = action_to_color[ACTION_STOP]
+
