+        if len(clear_run) < 2 or not _is_edge(shape, *clear_run[-1]):
+            return False
+        path_cells = clear_run
+        blocked.update(path_cells)
+        records.append(
+            {
+                "from": current,
+                "dir": direction,
+                "path_cells": path_cells,
+                "marker": None,
+                "action": "E",
+            }
+        )
+        return True
