+    action = actions[0]
+    candidates = [idx for idx, cell in enumerate(clear_run, start=1) if idx >= 2 and not _is_edge(shape, *cell)]
+    random.shuffle(candidates)
+    for dist in candidates:
+        marker = clear_run[dist - 1]
+        path_cells = clear_run[: dist - 1]
