+    trace = _records_to_color_trace(records, action_to_color)
+    if not _semantic_checks(grid, color_to_action, trace):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
