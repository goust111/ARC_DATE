+    return False
+
+
+def _choose_turn_sequence() -> list[str]:
+    turn_count = random.randint(2, 5)
+    seq = [ACTION_LEFT, ACTION_RIGHT]
+    while len(seq) < turn_count:
+        seq.append(random.choice((ACTION_LEFT, ACTION_RIGHT)))
+    random.shuffle(seq)
+    return seq
+
