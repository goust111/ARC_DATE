+    chosen_blockers: dict[tuple[int, int], tuple[int, int]] = {}
+    for edge in candidates:
+        pair = tuple(sorted(edge["pair"]))
+        cells = _boundary_cells(edge, boxes, room_cols)
+        cell = random.choice(cells)
