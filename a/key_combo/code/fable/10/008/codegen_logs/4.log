def _gen_axis_matches_window(values, offset):
    vals = [int(v) + int(offset) for v in values]
    lo = min(vals)
    hi = max(vals)
    mean = sum(vals) / len(vals)
    try:
        return _axis_start(lo, hi, mean, GRID_SIZE) == int(offset)
    except AssertionError:
