+def _validate_generated(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    true_edges: set[tuple[int, int]],
+    blocker_edges: set[tuple[int, int]],
+    source_room: int,
+    dist: dict[int, int],
+    legend: list[int],
+    meta: dict,
