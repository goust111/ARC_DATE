    col: int,
    color: int,
) -> bool:
    for nr, nc in _gen_neighbors4(int(row), int(col)):
        if not _gen_in_bounds(grid.shape, nr, nc):
            continue
        if block_mask[nr, nc] and int(grid[nr, nc]) == int(color):
