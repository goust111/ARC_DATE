    if markers is None:
        return None
    grid = _gen_render_grid(tile, top, left, markers)
    return grid if _gen_oracle_accepts(grid, expected) else None


def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

