spec:
  grid: 23x23 square [observed, always 23]
  colors: 1..P where P is the cycle period (6-9), plus color 0 as blank
  output_pattern: |
    Cyclic color table. cycle = a rotation of [1..P].
    On/above main diagonal (row <= col): cell = cycle[col % P]
    Below main diagonal (row > col):     cell = cycle[(col+1) % P]
    Result: each column is constant except it shifts by +1 at the diagonal.
  blank_color: 0; completely absent from output
  blank_regions:
    count: 3-5 connected components per grid
    total_cells: 50-73 (9-14% of grid)
    shape: mostly axis-aligned rectangles (2x2 to 5x7); a few are L-shaped unions of 2 rectangles [observed]
    placement: scattered across grid; may touch one boundary edge; no region covers all visible instances of any cycle phase
  solver_constraint: every cycle phase 0..P-1 must have >=1 visible (non-blank) cell so the cycle can be uniquely inferred

generation_strategy:
  approach: output-first
  steps:
    1. Pick P in [6,9], set n=23.
    2. Build cycle as a random rotation of [1..P].
    3. Fill full n x n output using the diagonal phase rule.
    4. Generate 3-5 rectangular blank regions (h in [2,7], w in [2,7], area 4-43 each, total 50-73 cells). Place them at random non-overlapping positions. Optionally merge two adjacent rectangles into an L-shape for variety.
    5. Verify every cycle phase still has visible cells; if not, shrink or shift a region.
    6. Set blank-region cells to 0 to produce the input.
