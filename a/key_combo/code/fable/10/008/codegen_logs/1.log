+    ks = _divisors(math.gcd(h, w))
+    candidates: list[tuple[int, int, np.ndarray]] = []
+    for anomaly in map(int, np.unique(g)):
+        for k in ks:
+            tile = _candidate_tile(g, anomaly, k)
