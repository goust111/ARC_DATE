+    tile = np.empty((k, k), dtype=int)
+    for r in range(k):
+        for c in range(k):
+            counts = Counter(map(int, grid[r::k, c::k].ravel()))
+            anomaly_hits = counts.pop(int(anomaly), 0)
+            if len(counts) != 1:
+                return None
+            clean_color, clean_hits = next(iter(counts.items()))
+            if clean_hits <= anomaly_hits:
