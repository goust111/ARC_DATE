+        spec["r0"] = rr0 + 1
+        spec["c0"] = rc0 + 1
+        _paste(grid, spec["patch"], spec["r0"], spec["c0"])
+
+        side = random.choice(["top", "bottom", "left", "right"])
+        positions = _choose_marker_positions(spec["size"], spec["count"])
+        spec["marker_side"] = side
+        spec["marker_positions"] = positions
+        if side == "top":
