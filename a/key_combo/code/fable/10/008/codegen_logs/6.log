+    er, ec = end
+    cells = [(r, c)]
+    while (r, c) != (er, ec):
+        moves = []
+        if r < er:
+            moves.append((1, 0))
+        elif r > er:
+            moves.append((-1, 0))
+        if c < ec:
+            moves.append((0, 1))
+        elif c > ec:
+            moves.append((0, -1))
