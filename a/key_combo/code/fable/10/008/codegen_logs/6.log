+
+
+def _choose_marker_positions(size: int, count: int):
+    choices = list(range(size))
+    for _ in range(100):
+        picks = sorted(random.sample(choices, count))
+        if all(b - a >= 2 for a, b in zip(picks, picks[1:])):
