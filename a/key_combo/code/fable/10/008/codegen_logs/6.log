+        elif side == "bottom":
+            for pos in positions:
+                grid[spec["r0"] + spec["size"], spec["c0"] + pos] = marker_color
+        elif side == "left":
+            for pos in positions:
+                grid[spec["r0"] + pos, spec["c0"] - 1] = marker_color
+        else:
+            for pos in positions:
