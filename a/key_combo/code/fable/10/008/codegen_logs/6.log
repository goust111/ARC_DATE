+    for cells in _components(inner != BG):
+        coords = np.array(cells, dtype=int)
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        demo_boxes.append((int(r0), int(c0), int(r1), int(c1)))
