+BG = 0
+FRAME = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEOMS = ("rot90", "rot270", "rot180", "flip_lr", "flip_ud")
+GEN_ATTEMPTS = 500
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
