+    for spec in free_specs:
+        r0, c0 = spec["r0"], spec["c0"]
+        size = spec["patch"].shape[0]
+        ring = set()
+        for rr in range(r0 - 1, r0 + size + 1):
+            for cc in range(c0 - 1, c0 + size + 1):
+                if 0 <= rr < inp.shape[0] and 0 <= cc < inp.shape[1]:
