+            size = random.randint(5, 7)
+            patch = _generate_object_patch(size, color_a, color_b)
+            if _patch_supports_count(patch, count, geom, do_swap, color_a, color_b):
+                free_specs.append({"patch": patch, "count": count, "size": size})
+                break
+        else:
