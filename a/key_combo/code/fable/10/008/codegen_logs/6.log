+    right = _crop(inner, demo_boxes[1])
+    assert _infer_operator(left, right, color_a, color_b) == (geom, do_swap)
+
+    marker_cells = set(map(tuple, np.argwhere(~np.isin(inp, [BG, FRAME, color_a, color_b]))))
