+            (r, c)
+            for r in range(k)
+            for c in range(k)
+            if not mask[r, c] and row_counts[r] < k - 1 and col_counts[c] < k - 1
+        ]
+        if not choices:
+            return None
+        r, c = random.choice(choices)
+        mask[r, c] = True
+        row_counts[r] += 1
+        col_counts[c] += 1
+
+    if not _has_both_colors_per_axis(mask):
+        return None
+    if _is_checkerboard(mask):
+        return None
+    if not _enough_structure(mask):
+        return None
+    return mask
+
