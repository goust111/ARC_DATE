+def _is_checkerboard(mask: np.ndarray) -> bool:
+    rows, cols = np.indices(mask.shape)
+    checker = ((rows + cols) % 2).astype(bool)
+    return np.array_equal(mask, checker) or np.array_equal(mask, ~checker)
