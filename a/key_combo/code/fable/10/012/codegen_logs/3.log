spec:
  grid: 2-5 rows x 2-5 cols, always square [observed]
  colors: exactly 2 — black (0) and one non-black foreground color (1-9)
  pattern:
    foreground_fraction: 0.25-0.50 of total pixels [observed]
    both_colors_present: every row and column should contain at least one pixel of each color [observed]
  transform:
    step1: swap black and foreground (invert the pattern)
    step2: tile the swapped grid 2x2 to produce output of size 2H x 2W
  output: same tile repeated in all four quadrants; each tile is the color-inverted input

generation_strategy:
