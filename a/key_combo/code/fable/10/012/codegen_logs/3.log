+    cols = list(range(k))
+    random.shuffle(cols)
+    for r, c in enumerate(cols):
+        mask[r, c] = True
+
+    row_counts = mask.sum(axis=1).astype(int).tolist()
+    col_counts = mask.sum(axis=0).astype(int).tolist()
+
+    for _ in range(ones - k):
