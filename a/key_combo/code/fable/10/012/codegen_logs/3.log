+    k = int(math.isqrt(a.shape[0]))
+    count = 0
+    for r in range(k):
+        for c in range(k):
+            ra = slice(r * k, (r + 1) * k)
+            ca = slice(c * k, (c + 1) * k)
+            if not np.array_equal(a[ra, ca], b[ra, ca]):
