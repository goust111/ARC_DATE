+def _classify_tiles(grid: np.ndarray, k: int, reference: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    inverted = _swap_two_colors(reference)
+    macro = np.full((k, k), -1, dtype=int)
+    tiles = _split_tiles(grid, k)
