+    comps: list[set[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        comp: set[tuple[int, int]] = set()
+        while q:
+            rr, cc = q.popleft()
+            comp.add((rr, cc))
+            for nr, nc in neighbors4(rr, cc):
+                if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
