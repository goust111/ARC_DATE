+    return ["horizontal"] * count
+
+
+def _candidate_spec(
+    height: int,
+    width: int,
+    color: int,
+    orientation: str,
+    used_axes: set[tuple[str, int]],
+    blocked_pad: set[tuple[int, int]],
+) -> dict | None:
+    for _ in range(250):
