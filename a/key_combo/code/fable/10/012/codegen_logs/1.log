+    raise RuntimeError("failed to sample a non-rectangular connected shape")
+
+
+def _all_neighbors8(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    padded = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
