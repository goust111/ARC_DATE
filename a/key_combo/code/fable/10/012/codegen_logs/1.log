+
+
+def _pair_is_isolated(pair: set[tuple[int, int]], others: set[tuple[int, int]]) -> bool:
+    for r, c in pair:
+        for rr, cc in others:
+            if abs(r - rr) <= 1 and abs(c - cc) <= 1:
+                return False
