    """Return n distinct 3x3 masks, or None if retries are exhausted."""
    masks = []
    seen = set()
    for _ in range(GEN_MASK_RETRIES):
        mask = _gen_random_mask()
        key = tuple(map(bool, mask.ravel()))
        if key in seen:
            continue
        masks.append(mask)
        seen.add(key)
        if len(masks) == n_masks:
            return masks
    return None


