+def _reserve_bbox_for_spec(spec: dict, r0: int, c0: int) -> tuple[int, int, int, int]:
+    h = int(spec["h"])
+    w = int(spec["w"])
+    count = int(spec["count"])
+    side = spec["side"]
+    if side == "top":
+        return (r0 - count - 1, c0 - 1, r0 + h, c0 + w)
+    if side == "bottom":
