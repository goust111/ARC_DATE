+def _frame_from_component(component: dict) -> dict | None:
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    rel_coords = {(int(r) - r0, int(c) - c0) for r, c in component["coords"]}
+    perimeter = _full_perimeter(h, w)
+    if not rel_coords <= perimeter:
+        return None
+    missing = list(perimeter - rel_coords)
+    if len(missing) != 1:
+        return None
+    if len(rel_coords) != len(perimeter) - 1:
+        return None
+
+    gap_r, gap_c = missing[0]
+    on_h = gap_r in (0, h - 1)
+    on_v = gap_c in (0, w - 1)
+    if on_h == on_v:
+        return None
+
+    if gap_r == 0:
+        side = "top"
+        out_dir = (-1, 0)
+    elif gap_r == h - 1:
+        side = "bottom"
+        out_dir = (1, 0)
+    elif gap_c == 0:
+        side = "left"
+        out_dir = (0, -1)
+    else:
+        side = "right"
+        out_dir = (0, 1)
