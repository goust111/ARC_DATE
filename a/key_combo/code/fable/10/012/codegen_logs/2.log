+def _full_perimeter(h: int, w: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(w):
+        cells.add((0, c))
+        cells.add((h - 1, c))
+    for r in range(h):
+        cells.add((r, 0))
+        cells.add((r, w - 1))
+    return cells
