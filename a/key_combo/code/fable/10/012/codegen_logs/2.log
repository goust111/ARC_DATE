+BG_COLOR = 0
+FRAME_COLOR = 5
+DOT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_GRID_MIN = 20
+GEN_GRID_MAX = 28
+GEN_FRAME_COUNT_CHOICES = (2, 3)
+GEN_FRAME_SIDE_MIN = 5
+GEN_FRAME_SIDE_MAX = 8
