+def _rects_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _full_perimeter(h: int, w: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(w):
+        cells.add((0, c))
+        cells.add((h - 1, c))
+    for r in range(h):
+        cells.add((r, 0))
+        cells.add((r, w - 1))
+    return cells
+
+
+def _frame_from_component(component: dict) -> dict | None:
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    rel_coords = {(int(r) - r0, int(c) - c0) for r, c in component["coords"]}
+    perimeter = _full_perimeter(h, w)
+    if not rel_coords <= perimeter:
+        return None
+    missing = list(perimeter - rel_coords)
+    if len(missing) != 1:
+        return None
+    if len(rel_coords) != len(perimeter) - 1:
+        return None
+
+    gap_r, gap_c = missing[0]
+    on_h = gap_r in (0, h - 1)
+    on_v = gap_c in (0, w - 1)
+    if on_h == on_v:
+        return None
+
+    if gap_r == 0:
+        side = "top"
+        out_dir = (-1, 0)
+    elif gap_r == h - 1:
+        side = "bottom"
+        out_dir = (1, 0)
+    elif gap_c == 0:
+        side = "left"
+        out_dir = (0, -1)
+    else:
+        side = "right"
+        out_dir = (0, 1)
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "gap": (r0 + gap_r, c0 + gap_c),
+        "gap_rel": (gap_r, gap_c),
+        "side": side,
+        "out_dir": out_dir,
+        "color": int(component["color"]),
+        "coords": component["coords"],
+    }
+
+
+def _bfs_inside_distances(shape: tuple[int, int], gap_rel: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    blocked = np.zeros((h, w), dtype=bool)
+    blocked[0, :] = True
+    blocked[-1, :] = True
+    blocked[:, 0] = True
+    blocked[:, -1] = True
+    blocked[gap_rel] = False
+
+    dist = np.full((h, w), -1, dtype=int)
+    queue = deque([gap_rel])
+    dist[gap_rel] = 0
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds((h, w), nr, nc):
+                continue
+            if blocked[nr, nc] or dist[nr, nc] != -1:
+                continue
+            dist[nr, nc] = dist[r, c] + 1
+            queue.append((nr, nc))
+    return dist
+
