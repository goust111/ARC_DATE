{
  "type": "move_in_order",
  "src": "sparse same-color dot objects and the upper-left source/fill legend",
  "dst": "paint each object's bbox expanded by one pixel",
  "transform": "clear the legend; fill pixels that are not original dots inside each expanded bbox with the paired fill color and preserve the original dots",
  "multi_step": "process legend rows bottom-to-top so earlier rows have priority where expanded bboxes overlap",
  "symbol_instructions": "upper-left source/fill legend maps each dot color to its expanded-bbox fill color"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 20x20, background 0
  legend:
    position: rows 0..N-1, cols 0-1 (N = number of pairs)
    pairs: 2-3 rows, each (source_color, fill_color)
    source colors unique; fill colors unique; all non-zero
    source and fill may overlap (a fill can equal another source) [observed]
  dot_objects:
    count: one per legend pair
    layout: each is a stride-2 rectangular dot grid at positions (r0+2i, c0+2j)
    dot_grid_size: 2-8 dot-rows x 2-5 dot-cols per object
    dots placed on bg; no dot occupies a legend cell
    expanded_bbox: dot bbox padded +1 in each direction (clamped to grid)
  overlaps:
    at_least: 1 pair of objects with overlapping expanded bboxes
    priority: legend index 0 = highest; lower-priority objects lose dots
      in positions that fall inside any higher-priority object's expanded bbox
    remaining dots still define the object's bbox for the solver
  non_overlap: non-overlapping pairs separated by >=1 cell between expanded bboxes [observed]
  output:
    legend cleared; for each object (reverse legend order), fill bg cells inside
    expanded bbox with fill_color; then stamp all original dots on top

generation_strategy:
