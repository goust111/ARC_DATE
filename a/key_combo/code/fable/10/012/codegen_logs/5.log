0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Paint a yellow 3x3 ring around the crossing of the full foreground row and column.
0009: 
0010:     Input structure
0011:     - The grid has a dominant background and two one-cell-wide foreground bars.
0012:     - One bar fills a complete row and the other fills a complete column.
0013:     - Their crossing pixel lies away from the border.
0014: 
0015:     Rule
0016:     - Locate the unique row and unique column that are entirely non-background.
0017:     - Paint the 3x3 neighborhood centered on their crossing yellow.
0018:     - Restore the original crossing pixel, leaving only the eight surrounding cells changed.
0019: 
0020:     Key insight
0021:     - The row/column crossing is the center of a local marker that replaces both nearby bar pixels and nearby background pixels.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     bg = get_bg(g)
0025:     foreground = g != bg
0026: 
0027:     crossing_rows = np.flatnonzero(foreground.all(axis=1))
0028:     crossing_cols = np.flatnonzero(foreground.all(axis=0))
0029:     assert len(crossing_rows) == 1
0030:     assert len(crossing_cols) == 1
0031: 
0032:     r = int(crossing_rows[0])
0033:     c = int(crossing_cols[0])
0034:     height, width = g.shape
0035:     assert 0 < r < height - 1
0036:     assert 0 < c < width - 1
0037: 
0038:     out = g.copy()
0039:     out[r - 1 : r + 2, c - 1 : c + 2] = Color.YELLOW
0040:     out[r, c] = g[r, c]
0041:     return out
