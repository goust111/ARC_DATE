+        if goal_met and _clear_run_to_exit((h, w), (r, c), dir_idx, blocked):
+            exiting = True
+
+        if exiting and straight_ok:
+            r, c = nr, nc
+            blocked.add((r, c))
+            painted.append((r, c, palette[palette_idx]))
+            steps_in_segment += 1
+            continue
+
+        if straight_ok and steps_in_segment < desired_segment_len:
+            r, c = nr, nc
+            blocked.add((r, c))
+            painted.append((r, c, palette[palette_idx]))
+            steps_in_segment += 1
+            continue
