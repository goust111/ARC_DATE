import random
import numpy as np

BG = 0
BLUE = 1
RED = 2
GRAY = 5
PALETTE_CHOICES = [3,4,6,7,8,9]
DIRS = [(-1,0),(0,1),(1,0),(0,-1)]  # U,R,D,L

def get_bg(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[counts.argmax()])

def parse(grid):
    top = grid[0]
    bg = get_bg(grid)
    c = 0
    while c < grid.shape[1] and int(top[c]) == bg:
        c += 1
    palette = []
    while c < grid.shape[1] and int(top[c]) not in (bg, GRAY):
        palette.append(int(top[c]))
        c += 1
    starts = np.where(top == GRAY)[0]
    return palette, int(starts[0])

def trace(grid):
    H, W = grid.shape
    palette, start_c = parse(grid)
    out = grid.copy()
    dir_idx = 2
    color_idx = 0
    r, c = 1, start_c
    painted = []
    used = []
    seen_states = set()
    while 0 <= r < H and 0 <= c < W:
        state = (r, c, dir_idx, color_idx)
        if state in seen_states:
            raise RuntimeError('loop')
        seen_states.add(state)
        out[r, c] = palette[color_idx]
        painted.append((r, c, palette[color_idx]))
        dr, dc = DIRS[dir_idx]
        nr, nc = r + dr, c + dc
        if not (0 <= nr < H and 0 <= nc < W):
            return out, painted, used
        ahead = int(grid[nr, nc])
        if ahead == RED:
            dir_idx = (dir_idx + 1) % 4
            color_idx = (color_idx + 1) % len(palette)
            used.append((nr, nc, ahead))
            dr, dc = DIRS[dir_idx]
            r, c = r + dr, c + dc
        elif ahead == BLUE:
            dir_idx = (dir_idx - 1) % 4
            color_idx = (color_idx + 1) % len(palette)
            used.append((nr, nc, ahead))
            dr, dc = DIRS[dir_idx]
            r, c = r + dr, c + dc
        else:
            r, c = nr, nc
    return out, painted, used

def can_exit_line(shape, pos, dir_idx, blocked):
    H, W = shape
    r, c = pos
    dr, dc = DIRS[dir_idx]
    nr, nc = r + dr, c + dc
    while 0 <= nr < H and 0 <= nc < W:
        if (nr, nc) in blocked:
            return False
        nr += dr
        nc += dc
    return True

def build_one():
    for attempt in range(2000):
        H = random.randint(12, 22)
        W = random.randint(12, 22)
        plen = random.randint(3, 5)
        if W < plen + 6:
            continue
        palette = random.sample(PALETTE_CHOICES, plen)
        start_c = random.randint(plen + 2, W - 2)
        target = random.randint(plen, plen + 2) if random.random() < 0.5 else random.randint(2, max(2, plen))
        grid = np.zeros((H, W), dtype=int)
        for i, color in enumerate(palette):
            grid[0, i] = color
        grid[0, start_c] = GRAY
        reserved = {(0, c) for c in range(W)}
        blocked = set(reserved)
        r, c = 1, start_c
        blocked.add((r, c))
        path = [(r, c)]
        paint = [(r, c, palette[0])]
        markers = []
        dir_idx = 2
        color_idx = 0
        steps_in_seg = 1
        desired_len = random.randint(2, 5)
        turn_colors = []
        exiting = False
        for _ in range(H * W * 4):
            dr, dc = DIRS[dir_idx]
            nr, nc = r + dr, c + dc
            goal_met = len(markers) >= target and {RED, BLUE}.issubset(set(turn_colors))
            if not (0 <= nr < H and 0 <= nc < W):
                if goal_met and len(path) >= 8:
                    break
                else:
                    # cannot exit yet, must fail unless a turn was chosen earlier
                    break
            straight_ok = (nr, nc) not in blocked
            turn_opts = []
            for color, delta in ((RED, 1), (BLUE, -1)):
                nd = (dir_idx + delta) % 4
                tr, tc = nr, nc
                sr, sc = r + DIRS[nd][0], c + DIRS[nd][1]
                if 0 <= tr < H and 0 <= tc < W and 0 <= sr < H and 0 <= sc < W and (tr, tc) not in blocked and (sr, sc) not in blocked:
                    turn_opts.append((color, nd, sr, sc, tr, tc))
            if goal_met and can_exit_line((H, W), (r, c), dir_idx, blocked):
                exiting = True
            if exiting and straight_ok:
                r, c = nr, nc
                blocked.add((r, c))
                path.append((r, c))
                paint.append((r, c, palette[color_idx]))
                steps_in_seg += 1
                continue
            action = None
            if straight_ok and steps_in_seg < desired_len:
                action = ('straight',)
            else:
                choices = []
                if straight_ok:
                    choices += [('straight',)] * 4
                for opt in turn_opts:
                    weight = 2
                    if opt[0] not in turn_colors:
                        weight += 4
                    if len(markers) < target:
                        weight += 2
                    choices += [opt] * weight
                if not choices:
                    break
                action = random.choice(choices)
            if action[0] == 'straight':
                r, c = nr, nc
                blocked.add((r, c))
                path.append((r, c))
                paint.append((r, c, palette[color_idx]))
                steps_in_seg += 1
            else:
                color, nd, sr, sc, tr, tc = action
                grid[tr, tc] = color
                blocked.add((tr, tc))
                markers.append((tr, tc, color))
                turn_colors.append(color)
                dir_idx = nd
                color_idx = (color_idx + 1) % plen
                r, c = sr, sc
                blocked.add((r, c))
                path.append((r, c))
                paint.append((r, c, palette[color_idx]))
                steps_in_seg = 1
                desired_len = random.randint(2, 5)
        else:
            continue
        goal_met = len(markers) >= target and {RED, BLUE}.issubset(set(turn_colors))
        if not goal_met:
            continue
        out_expected = grid.copy()
        for rr, cc, color in paint:
            out_expected[rr, cc] = color
        try:
            out_actual, painted2, used2 = trace(grid)
        except Exception:
            continue
        if not np.array_equal(out_expected, out_actual):
            continue
        if sorted(markers) "'!= sorted(used2):
            continue
        # require actual exit through left/right/bottom
        last_r, last_c = path[-1]
        dr, dc = DIRS[dir_idx]
        if 0 <= last_r + dr < H and 0 <= last_c + dc < W:
            continue
        return grid, out_actual, len(markers), plen, (H, W)
    return None

for i in range(50):
    x = build_one()
    assert x is not None, i
