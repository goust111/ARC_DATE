+def _winner_grid(
+    shape: tuple[int, int],
+    wall_mask: np.ndarray,
+    seed_positions: list[tuple[int, int]],
+    *,
+    connectivity: int,
+) -> np.ndarray:
+    dist = _distance_fields(shape, wall_mask, seed_positions, connectivity=connectivity)
+    inf = int(dist.max())
+    winners = np.full(shape, TIE, dtype=int)
+    winners[wall_mask] = WALL
+
