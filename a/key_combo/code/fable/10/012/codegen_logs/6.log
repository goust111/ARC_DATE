                marker_cells = []
                fill_cells = []
                ok = True
                for rr in range(h):
                    for cc in range(w):
                        r = r0 + rr
                        c = c0 + cc
                        in_bounds = 0 <= r < GRID_SIZE and 0 <= c < GRID_SIZE
                        if transformed[rr, cc]:
                            if not in_bounds:
                                ok = False
                                break
                            marker_cells.append((r, c))
