+    for r in range(shape[0]):
+        for c in range(shape[1]):
+            values = [_chebyshev((r, c), seed) for seed in seed_positions]
+            best = min(values)
+            hits = [idx for idx, value in enumerate(values) if value == best]
+            winners[r, c] = hits[0] if len(hits) == 1 else TIE
+    return winners
+
+
