    output = np.full((height, width), Color.BLACK, dtype=int)

    for r, c, radius in centers:
        output[r - radius : r + radius + 1, c - radius : c + radius + 1] = Color.RED
    for r, c, _ in centers:
        output[r, c] = Color.YELLOW
    for r, c in blockers:
        output[r, c] = Color.GREY
