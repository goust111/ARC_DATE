+    grid[wall_mask] = GREY
+    colors = random.sample(SEED_COLORS, len(seed_positions))
+    for color, (r, c) in zip(colors, seed_positions):
+        grid[r, c] = int(color)
+    return grid
+
+
+def _semantic_ok(grid: np.ndarray) -> bool:
+    try:
+        g, seed_colors, seed_positions, wall_mask = _parse_scene(grid)
+        actual = main(g)
+    except Exception:
+        return False
