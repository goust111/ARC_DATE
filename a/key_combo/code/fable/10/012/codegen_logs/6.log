    return True


def _gen_match_index(
    marker_mask: np.ndarray,
):
    placements = []
    by_cell = [[[] for _ in range(GRID_SIZE)] for _ in range(GRID_SIZE)]

    for transformed in _unique_transforms(marker_mask):
        h, w = map(int, transformed.shape)
