+        assert hint_cell not in used_hint_cells, "hint pixels must be unique"
+        used_hint_cells.add(hint_cell)
+        hints[hint_r, hint_c] = int(color)
+
+    grid = np.full((canvas.shape[0] + 1, canvas.shape[1] + 1), BG, dtype=int)
+    grid[0, 1:] = top
+    grid[1:, 0] = left
+    grid[1:, 1:] = hints
+    expected = np.full_like(grid, BG)
+    expected[1:, 1:] = canvas
+    return grid, expected
