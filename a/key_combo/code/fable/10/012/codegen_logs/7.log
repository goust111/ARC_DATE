   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """Paint a red square around each yellow marker, sized to stop just before the nearest grey marker.
   9: 
  10:     Input structure
  11:     - A black background contains one or more yellow marker pixels and one or more grey blocker pixels.
  12:     - The output has the same shape as the input and preserves the yellow and grey pixels.
  13: 
  14:     Rule
  15:     - For each yellow marker, find the minimum Chebyshev distance to any grey blocker.
  16:     - Fill the centered square of radius one less than that distance with red, changing only background pixels.
  17: 
  18:     Key insight
  19:     - Grey pixels define the first forbidden Chebyshev ring around each yellow marker, so the red square is the
  20:       largest centered square that remains one cell short of every grey blocker.
  21:     """
  22:     g = np.asarray(grid, dtype=int)
  23:     bg = get_bg(g)
  24:     assert bg == Color.BLACK
  25:     assert set(colors_present(g, exclude={bg})) == {Color.YELLOW, Color.GREY}
  26: 
  27:     centers = np.argwhere(g == Color.YELLOW)
  28:     blockers = np.argwhere(g == Color.GREY)
  29:     assert len(centers) >= 1
  30:     assert len(blockers) >= 1
  31: 
  32:     out = g.copy()
  33:     height, width = g.shape
