+def _semantic_checks(inp: np.ndarray, out: np.ndarray, expected: np.ndarray) -> bool:
+    if inp.ndim != 2 or out.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+    if inp.shape != out.shape:
+        return False
+    if not np.array_equal(out, expected):
+        return False
