--- 13: def main(input_grid):
  13: def main(input_grid):
  14:     """
  15:     Draw full grid-spanning lines through the special color's boundary marker pairs.
  16: 
  17:     Input structure:
  18:     - The input contains scattered pixels of several colors.
  19:     - One color appears only as four pixels on the grid boundary.
  20:     - Those boundary pixels mark the rows or columns of the output lines.
  21: 
  22:     Rule:
  23:     - Find the color whose pixels all lie on the boundary.
  24:     - For markers on the top or bottom edge, draw a full vertical line through that column.
  25:     - For markers on the left or right edge, draw a full horizontal line through that row.
  26: 
  27:     Key insight:
  28:     - Boundary-only pixels are line endpoints; all other scattered colors are noise.
  29:     """
  30:     # Find the used color
  31:     all_color = np.unique(input_grid)
  32: 
  33:     # Find the color all on the boundary, which is the lines' color
  34:     def on_boundary(rr, cc):
  35:         return (
  36:             rr == 0
  37:             or rr == input_grid.shape[0] - 1
  38:             or cc == 0
  39:             or cc == input_grid.shape[1] - 1
  40:         )
  41:     
  42:     # Get the color all on the boundary, which is the lines' color
  43:     line_color = None
  44:     for color in all_color:
  45:         coords = np.argwhere(input_grid == color)
  46:         if coords.size == 0:
  47:             continue
  48:         if all(on_boundary(int(rr), int(cc)) for rr, cc in coords):
  49:             line_color = int(color)
  50:             break
  51:     assert line_color is not None
  52:     output_grid = np.zeros_like(input_grid)
  53: 
  54:     # Find the boundary pixels of the line_color and then draw a horizontal/vertical line to its matching pair
  55:     coords = [tuple(map(int, xy)) for xy in np.argwhere(input_grid == line_color)]
  56:     H, W = input_grid.shape
  57:     for r, c in coords:
  58:         if r == 0 or r == H - 1:
  59:             # point on top/bottom => draw vertical line down/up through it
  60:             output_grid[:, c] = line_color
  61:         elif c == 0 or c == W - 1:
  62:             # point on left/right => draw horizontal line across through it
  63:             output_grid[r, :] = line_color
  64:     
  65:     return output_grid
  66: 
