+    canvas = np.full(shape, bg, dtype=int)
+    for idx in order:
+        rect = rects[idx]
+        canvas[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = rect["color"]
+    return canvas
