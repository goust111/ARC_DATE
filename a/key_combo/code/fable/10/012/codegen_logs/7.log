+    left = np.full(h, bg, dtype=int)
+
+    for c in range(w):
+        rows = np.flatnonzero(canvas[:, c] != bg)
+        if rows.size:
+            top[c] = int(canvas[int(rows[0]), c])
+
+    for r in range(h):
+        cols = np.flatnonzero(canvas[r, :] != bg)
+        if cols.size:
+            left[r] = int(canvas[r, int(cols[0])])
+
+    return top, left
+
