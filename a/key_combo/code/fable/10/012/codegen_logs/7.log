spec:
  grid: 12-22 rows x 11-25 cols
  background: 0 (black)
  rectangles:
    count: 2-7 solid axis-aligned rectangles on bg, 4-connected
    fill_color: 1 (blue) for all rectangles [observed]
    dimensions: 3-10 rows x 3-10 cols each
    separation: >=1 bg pixel gap between any two bboxes
    may_touch_border: yes
    markers:
