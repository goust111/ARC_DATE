+    out[counts == 2] = RED
+    return out, counts
+
+
+def _bbox_overlap(a: dict[str, object], b: dict[str, object]) -> tuple[int, int, int]:
+    r0 = max(int(a["r0"]), int(b["r0"]))
+    c0 = max(int(a["c0"]), int(b["c0"]))
