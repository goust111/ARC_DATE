+
+def _point_in_square(spec: dict[str, object], point: tuple[int, int]) -> bool:
+    r, c = point
+    return int(spec["r0"]) <= r <= int(spec["r1"]) and int(spec["c0"]) <= c <= int(spec["c1"])
