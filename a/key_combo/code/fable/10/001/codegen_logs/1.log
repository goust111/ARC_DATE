+def _square_corners(r0: int, c0: int, side: int) -> dict[str, tuple[int, int]]:
+    return {
+        "tl": (r0, c0),
+        "tr": (r0, c0 + side),
+        "bl": (r0 + side, c0),
+        "br": (r0 + side, c0 + side),
