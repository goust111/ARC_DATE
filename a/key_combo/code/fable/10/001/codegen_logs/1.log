+
+
+def _choose_missing_kinds(
+    placed: list[dict[str, object]], rng: random.Random
+) -> list[str] | None:
+    forced: list[str | None] = []
+    for i, spec in enumerate(placed):
+        covered = _covered_corner_kinds(spec, placed[:i] + placed[i + 1 :])
+        if len(covered) > 1:
