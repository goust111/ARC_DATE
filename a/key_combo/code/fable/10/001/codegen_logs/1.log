+        b = _sample_square(shape, side_b, rng)
+        if _pair_is_valid(a, b):
+            return [a, b]
+    return None
+
+
+def _place_third_square(
+    shape: tuple[int, int],
+    side: int,
+    placed: list[dict[str, object]],
+    rng: random.Random,
+) -> dict[str, object] | None:
