+BLACK = 0
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+CORNER_ORDER = ("tl", "tr", "bl", "br")
+FLIP_STATES = ((False, False), (False, True), (True, False), (True, True))
