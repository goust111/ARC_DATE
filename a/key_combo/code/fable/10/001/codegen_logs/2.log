+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid = _build_case(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid anchor-alignment defect case")

