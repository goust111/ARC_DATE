+    assert len(grey_cols) == 1, "expected exactly one full-height grey separator column"
+    sep = grey_cols[0]
+    assert 0 < sep < width - 1, "separator must leave one panel on each side"
+    assert sep == width - sep - 1, "panels must have equal width"
+
+    left = g[:, :sep]
+    right = g[:, sep + 1 :]
