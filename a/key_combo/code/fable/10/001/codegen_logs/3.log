+            direction = matches[0]
+            tip_r = r0 + ARROW_PARSE_DATA[direction]["tip"][0]
+            tip_c = c0 + ARROW_PARSE_DATA[direction]["tip"][1]
+            arrow_cells = set(comp)
+            for cell_r, cell_c in comp:
+                accounted[cell_r, cell_c] = True
+            arrows.append(
