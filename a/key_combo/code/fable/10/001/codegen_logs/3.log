+                _paint_beam_cell(out, nr, nc, color)
+            else:
+                current_color = int(out[nr, nc])
+                if current_color == BLACK:
+                    out[nr, nc] = color
+            current = (nr, nc)
+            painted.append(current)
+
+        info_list.append(
+            {
+                "color": color,
+                "painted": painted,
+                "mirrors": mirror_orients,
+                "termination": termination,
+            }
+        )
