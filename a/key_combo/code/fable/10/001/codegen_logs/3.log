    ((0, 0, 1), (0, 1, 0), (1, 0, 0)): Color.MAROON,
    ((0, 0, 0), (0, 0, 0), (1, 1, 1)): Color.BLUE,
    ((1, 1, 1), (0, 0, 0), (0, 0, 0)): Color.PINK,
}


