+
+def _place_arrow(grid: np.ndarray, top: int, left: int, direction: str, color: int) -> None:
+    pattern = ARROW_PATTERNS[direction]
+    block = grid[top : top + 3, left : left + 3]
+    assert block.shape == (3, 3)
+    assert np.all(block == BLACK)
