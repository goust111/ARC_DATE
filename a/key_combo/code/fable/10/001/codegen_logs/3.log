+    h, w = grid.shape
+    out = grid.copy()
+    arrow_cells = {cell for arrow in arrows for cell in arrow["cells"]}
+    info_list: list[dict] = []
+
+    for arrow in arrows:
+        color = int(arrow["color"])
+        dr, dc = arrow["delta"]
+        current = arrow["tip"]
+        seen_states: set[tuple[int, int, int, int]] = set()
+        painted: list[tuple[int, int]] = []
+        mirror_orients: list[str] = []
+        termination = "edge"
+
+        while True:
