        return None
    r1 = random.randint(r1_low, r1_high)

    c1_low = 10
    c1_high = w - max(6, hit_idx2 + 2)
    if c1_low > c1_high:
        return None
    c1 = random.randint(c1_low, c1_high)

    r2_low = r1 + 6
    r2_high = min(h - 6, h - (len2 - hit_idx2))

