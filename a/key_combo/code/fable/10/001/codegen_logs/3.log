+def _reflect(delta: tuple[int, int], orient: str) -> tuple[int, int]:
+    if orient == "\\":
+        return delta[1], delta[0]
+    if orient == "/":
+        return -delta[1], -delta[0]
+    raise AssertionError(f"unknown mirror orientation: {orient}")
