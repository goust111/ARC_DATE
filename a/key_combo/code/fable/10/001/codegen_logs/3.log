+                if current_color == BLACK:
+                    out[nr, nc] = color
+            current = (nr, nc)
+            painted.append(current)
+
+        info_list.append(
+            {
+                "color": color,
+                "painted": painted,
+                "mirrors": mirror_orients,
+                "termination": termination,
+            }
+        )
+
+    if return_info:
+        return out, info_list
+    return out
