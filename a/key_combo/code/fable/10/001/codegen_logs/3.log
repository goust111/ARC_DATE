+def _simulate(
+    grid: np.ndarray,
+    arrows: list[dict],
+    mirrors: dict[tuple[int, int], str],
+    *,
+    stop_on_arrows: bool = True,
+    use_mirrors: bool = True,
+    use_red_crossing: bool = True,
+    return_info: bool = False,
+) -> tuple[np.ndarray, list[dict]] | np.ndarray:
