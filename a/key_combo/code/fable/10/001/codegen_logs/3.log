def _gen_spaced_positions(size: int, count: int) -> tuple[int, ...]:
    """Sample sorted interior coordinates with the configured pairwise gap."""
    positions = range(_GEN_EDGE_PADDING, size - _GEN_EDGE_PADDING)
    choices = [
