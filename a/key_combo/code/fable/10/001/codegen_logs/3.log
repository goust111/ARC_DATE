+    return _random_symmetry(grid)
+
+
+def _validate_generation(grid: np.ndarray) -> bool:
+    try:
+        arrows = _extract_arrows(grid)
+        mirrors = _extract_mirrors(grid)
+        out, info = _simulate(grid, arrows, mirrors, return_info=True)
