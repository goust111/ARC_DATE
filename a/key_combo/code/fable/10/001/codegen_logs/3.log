+        return delta[1], delta[0]
+    if orient == "/":
+        return -delta[1], -delta[0]
+    raise AssertionError(f"unknown mirror orientation: {orient}")
+
+
+def _paint_beam_cell(out: np.ndarray, r: int, c: int, color: int) -> None:
+    current = int(out[r, c])
+    if current == BLACK:
+        out[r, c] = color
