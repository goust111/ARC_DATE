+
+
+def _diag_segment_cells(
+    hit: tuple[int, int],
+    orient: str,
+    length: int,
+    hit_index: int,
+) -> list[tuple[int, int]]:
+    hr, hc = hit
+    if orient == "\\":
+        start_r = hr - hit_index
+        start_c = hc - hit_index
+        return [(start_r + i, start_c + i) for i in range(length)]
+    start_r = hr - hit_index
+    start_c = hc + hit_index
