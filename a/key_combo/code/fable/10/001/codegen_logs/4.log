  "src": "solid rectangular foreground objects with a uniform frame-color border and one interior marker pixel of another color",
  "transform": "keep each rectangle border in the frame color, clear the rest of its interior to background, and draw an X across the interior in the marker color with center connector cells where the diagonal arms meet"
}
</annotation>
<generation_spec>
