+    for basin_idx, basin in enumerate(basins):
+        wet_mask_present = False
+        for c in range(int(basin["l"]), int(basin["r"]) + 1):
+            if int(basin["surface_r"]) < int(starts[c]):
+                wet_mask_present = True
