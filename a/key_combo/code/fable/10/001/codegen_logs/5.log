+    first_peak = random.randint(peak_lo, peak_hi - span)
+    peaks = [first_peak]
+    for delta in deltas:
+        peaks.append(peaks[-1] + delta)
+    if random.random() < 0.5:
+        peaks = peaks[::-1]
