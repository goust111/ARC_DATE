+    if end >= start:
+        for value in raw:
+            prev = max(prev, int(value))
+            out.append(prev)
+        out[-1] = int(end)
+        for i in range(len(out) - 2, -1, -1):
+            out[i] = min(out[i], out[i + 1])
+    else:
+        for value in raw:
+            prev = min(prev, int(value))
+            out.append(prev)
+        out[-1] = int(end)
+        for i in range(len(out) - 2, -1, -1):
