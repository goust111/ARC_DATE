+            for idx, candidate in enumerate(basins)
+            if candidate["l"] <= seed_c <= candidate["r"] and seed_r < int(starts[seed_c])
+        ]
+        if matches != [basin_idx]:
+            return False
+
+        for c in range(int(basin["l"]), int(basin["r"]) + 1):
+            if int(basin["surface_r"]) < int(starts[c]):
