/bin/bash -lc "python - <<'PY'
import random, numpy as np

def mono(a,b,steps):
    vals=[]
    for i in range(1,steps+1):
        x=a+(b-a)*i/steps
        vals.append(int(round(x)))
    vals[-1]=b
    if a<b:
        for i in range(len(vals)):
            vals[i]=max(vals[i], a if i==0 else vals[i-1])
        vals[-1]=b
        for i in range(len(vals)-2,-1,-1):
            vals[i]=min(vals[i], vals[i+1])
    else:
        for i in range(len(vals)):
            vals[i]=min(vals[i], a if i==0 else vals[i-1])
        vals[-1]=b
        for i in range(len(vals)-2,-1,-1):
            vals[i]=max(vals[i], vals[i+1])
    return vals

def levels(h):
    h=np.array(h)
    return np.minimum(np.maximum.accumulate(h), np.maximum.accumulate(h[::-1])[::-1])

def basins(h):
    lev=levels(h)
    out=[];i=0
    while i<len(h):
        if lev[i]>h[i]:
            L=int(lev[i]);j=i
            while j+1<len(h) and lev[j+1]==L and lev[j+1]>h[j+1]:j+=1
            out.append((i,j,L))
            i=j+1
        else:i+=1
    return out,lev.tolist()

for _ in range(10):
    H=random.randint(12,20); n=random.randint(2,4)
    peak_min=max(5,H//2); peak_max=H-3
    direction=random.choice([1,-1])
    peaks=[random.randint(peak_min, peak_max - (n if direction==1 else 0))]
    if direction==1:
        for i in range(n): peaks.append(peaks[-1]+random.randint(1,2))
    else:
        peaks=[random.randint(peak_min + n, peak_max)]
        for i in range(n): peaks.append(peaks[-1]-random.randint(1,2))
    h=[peaks[0]]*random.randint(1,2)
    for i in range(n):
        p0=peaks[i]; p1=peaks[i+1]
        water=min(p0,p1)
        valley=random.randint(2, water-2)
        h.extend(mono(h[-1], valley, random.randint(2,4)))
        h.extend([valley]*(random.randint(1,3)-1))
        h.extend(mono(h[-1], p1, random.randint(2,4)))
        h.extend([p1]*random.randint(1,2))
    if len(h)>30: continue
    b,l=basins(h)
    print('peaks',peaks)
    print(h)
    print(b)
    print(l)
    print()
