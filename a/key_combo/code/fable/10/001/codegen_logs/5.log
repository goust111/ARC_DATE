import random, numpy as np

def monotone_segment(a,b,steps):
    vals=[]
    for i in range(1, steps+1):
        x=a + (b-a)*i/steps
        vals.append(int(round(x)))
    if a < b:
        prev=a
        out=[]
        for v in vals:
            v=max(v,prev)
            out.append(v)
            prev=v
        out[-1]=b
        for i in range(len(out)-2,-1,-1):
            out[i]=min(out[i], out[i+1])
        return out
    else:
        prev=a
        out=[]
        for v in vals:
            v=min(v,prev)
            out.append(v)
            prev=v
        out[-1]=b
        for i in range(len(out)-2,-1,-1):
            out[i]=max(out[i], out[i+1])
        return out

def water_levels(h):
    left=np.maximum.accumulate(h)
    right=np.maximum.accumulate(h[::-1])[::-1]
    return np.minimum(left,right)

def basins(h):
    h=np.array(h)
    lev=water_levels(h)
    out=[]
    i=0
    while i<len(h):
        if lev[i] > h[i]:
            level=int(lev[i])
            j=i
            while j+1<len(h) and lev[j+1]==level and lev[j+1] > h[j+1]:
                j+=1
            out.append((i,j,level))
            i=j+1
        else:
            i+=1
    return out, lev.tolist()

def gen():
    H=random.randint(12,20)
    n=random.randint(2,4)
    peak_lo=max(5,H//2)
    peak_hi=H-3
    peaks=[random.randint(peak_lo,peak_hi)]
    for _ in range(n):
        peaks.append(max(peak_lo,min(peak_hi, peaks[-1]+random.randint(-2,2))))
    heights=[peaks[0]]*random.randint(1,2)
    for i in range(n):
        p0=peaks[i]; p1=peaks[i+1]
        min_peak=min(p0,p1)
        valley=random.randint(2, min_peak-2)
        left_len=random.randint(2,4)
        bottom_len=random.randint(1,3)
        right_len=random.randint(2,4)
        hold=random.randint(1,2) if i<n-1 else random.randint(1,2)
        heights.extend(monotone_segment(heights[-1], valley, left_len))
        heights.extend([valley]*(bottom_len-1))
        heights.extend(monotone_segment(heights[-1], p1, right_len))
        heights.extend([p1]*hold)
    if len(heights)>30: return None
    b,lev=basins(heights)
    return H, heights, b, lev

for _ in range(20):
    x=gen()
    if x:
        H,h,b,lev=x
        print(H, len(h), h)
        print('basins', b)
        print('lev   ', lev)
        print()
