+def _sample_profile() -> tuple[int, np.ndarray, list[dict[str, int]]] | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
+    basin_count = random.choice(BASIN_COUNT_CHOICES)
+    deltas = [random.randint(1, 2) for _ in range(basin_count)]
+    span = sum(deltas)
+
+    peak_lo = max(5, h // 2 - 1)
