+    if random.random() < 0.5:
+        peaks = peaks[::-1]
+
+    heights = [peaks[0]] * random.randint(1, 2)
+    for basin_i in range(basin_count):
+        water_h = min(peaks[basin_i], peaks[basin_i + 1])
+        if water_h < 5:
