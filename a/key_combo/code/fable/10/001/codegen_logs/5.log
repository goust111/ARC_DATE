    candidates = [
        value
        for value in range(PROFILE_INTERIOR_MIN, span)
        if abs(value - anchor_value) <= MAX_ADJACENT_STEP * distance
    ]
    if not candidates:
        return None
    return int(np.random.choice(candidates))


