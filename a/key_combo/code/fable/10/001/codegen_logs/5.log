+def _render_input(height: int, heights: np.ndarray, terrain: int, seed_plan: list[dict[str, int | str]]) -> np.ndarray:
+    width = len(heights)
+    grid = np.full((height, width), BG_COLOR, dtype=int)
+    starts = height - heights
+    for c in range(width):
