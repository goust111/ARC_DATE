+
+BG_COLOR = 0
+TERRAIN_CHOICES = (1, 5, 6, 7, 8, 9)
+SEED_PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+
+GRID_HEIGHT_RANGE = (13, 20)
+BASIN_COUNT_CHOICES = (2, 3, 4)
+MAX_ATTEMPTS = 500
