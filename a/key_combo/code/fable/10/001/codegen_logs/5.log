+    heights_arr = np.array(heights, dtype=int)
+    basins = _basins_from_heights(heights_arr, h)
+    if len(basins) != basin_count:
+        return None
+    if len({basin["water_h"] for basin in basins}) == 1 and basin_count >= 3:
+        return None
+    return h, heights_arr, basins
