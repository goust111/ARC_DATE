+    for color in sorted(set(map(int, grid.ravel())) - {bg}):
+        rows = [r for r in range(height) if np.all(grid[r, :] == color)]
+        cols = [c for c in range(width) if np.all(grid[:, c] == color)]
+        if rows and cols:
