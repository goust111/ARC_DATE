+            cell = g[r0 : r1 + 1, c0 : c1 + 1]
+            colors = set(map(int, np.unique(cell)))
+            assert divider not in colors, "divider color must not appear inside a cell"
+            assert GREY in colors, "every cell must contain a grey glyph"
