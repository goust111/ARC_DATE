        symbol = tuple(tuple(map(int, row)) for row in (block == Color.GREY))
        assert symbol in _SYMBOL_TO_COLOR, "encountered an unknown grey symbol"
        out[:, col0 : col0 + 3] = _SYMBOL_TO_COLOR[symbol]

    return out

