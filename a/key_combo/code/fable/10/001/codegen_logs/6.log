+                nr, nc = r + dr, c + dc
+                if (nr, nc) in pixels:
+                    continue
+                if 0 <= nr < cell_size and 0 <= nc < cell_size and (nr, nc) in allowed:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        pixels.add(random.choice(frontier))
+
