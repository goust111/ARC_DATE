+    """
+    _legend_bbox, marker, colors_outer_to_inner, widths_outer_to_inner = _analyze_input(grid)
+    return _render_rings(
+        grid.shape,
+        marker,
+        list(reversed(colors_outer_to_inner)),
+        list(reversed(widths_outer_to_inner)),
+    )
+
