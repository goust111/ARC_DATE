+    min_visible_outer_start = total_radius - outermost_width + 1
+    cells: list[Coord] = []
+    for r in range(h):
+        for c in range(w):
+            min_edge = min(r, h - 1 - r, c, w - 1 - c)
+            max_edge = max(r, h - 1 - r, c, w - 1 - c)
+            if clipped:
