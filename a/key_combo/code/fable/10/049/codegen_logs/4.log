    grey = np.argwhere(grey_mask)
    rr, cc = np.indices(GRID_SHAPE)
    diffs_r = rr[:, :, None] - grey[:, 0]
    diffs_c = cc[:, :, None] - grey[:, 1]
    return (diffs_r * diffs_r + diffs_c * diffs_c).min(axis=2)


