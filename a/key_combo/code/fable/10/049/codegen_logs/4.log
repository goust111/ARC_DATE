+        for c0 in range(w - lw + 1):
+            c1 = c0 + lw - 1
+            if r0 - LEGEND_MARKER_GAP <= mr <= r1 + LEGEND_MARKER_GAP and c0 - LEGEND_MARKER_GAP <= mc <= c1 + LEGEND_MARKER_GAP:
+                continue
