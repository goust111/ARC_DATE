    assert first_axis == "v", "path axis must be horizontal or vertical"
    r_step = 1 if r1 >= r0 else -1
    for r in range(r0, r1 + r_step, r_step):
        pts.append((r, c0))
    c_step = 1 if c1 >= c0 else -1
    for c in range(c0 + c_step, c1 + c_step, c_step):
        pts.append((r1, c))
