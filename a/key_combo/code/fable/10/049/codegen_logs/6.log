+def _false_pair_shapes(target_area: int, true_shapes: tuple[tuple[Coord, ...], tuple[Coord, ...]]) -> tuple[tuple[Coord, ...], tuple[Coord, ...]] | None:
+    true_norm = {tuple(true_shapes[0]), tuple(true_shapes[1])}
