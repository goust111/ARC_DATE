    v_offsets = _gen_bar_offsets(random.randint(*BAR_COUNT_RANGE))
    old_h = h_offsets[-1] + 1
    old_w = v_offsets[-1] + 1

    side_count = random.randint(*SIDE_COUNT_RANGE)
