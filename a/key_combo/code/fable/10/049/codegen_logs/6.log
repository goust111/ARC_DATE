+
+
+def _coords_to_mask(coords: Iterable[Coord]) -> np.ndarray:
+    norm = _normalize_coords(coords)
+    h = 1 + max(r for r, _ in norm)
+    w = 1 + max(c for _, c in norm)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in norm:
