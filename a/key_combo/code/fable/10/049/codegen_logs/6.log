+    out[r0 : r1 + 1, c0 : c1 + 1] = int(rect_color)
+    hr0, hc0 = hole_offset
+    for rr, cc in placement_a:
+        out[hr0 + rr, hc0 + cc] = int(color_a)
+    for rr, cc in placement_b:
+        out[hr0 + rr, hc0 + cc] = int(color_b)
+    return out
+
