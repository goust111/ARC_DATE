    _gen_draw_bars(inp, old_rows, old_cols, old_r0, old_c0, old_r1, old_c1, LINE_COLOR)
    _gen_draw_bars(out, new_rows, new_cols, new_r0, new_c0, new_r1, new_c1, LINE_COLOR)

    for r, c in _gen_markers(sides, old_box, new_box):
