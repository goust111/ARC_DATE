+    if sig in _SEEN_OUTPUTS:
+        return None
+    _SEEN_OUTPUTS.add(sig)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        result = _gen_attempt(random)
+        if result is not None:
