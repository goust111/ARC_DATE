+
+
+def _place_instruction(sprite_mask: np.ndarray, op: str, rng: random.Random) -> np.ndarray | None:
+    panel_size = int(sprite_mask.shape[0])
+    crop = _instruction_crop(op, int(sprite_mask.sum()), rng)
