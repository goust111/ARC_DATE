+        return out
+    bbox = bbox_from_coords(coords)
+    crop = crop_bbox(panel_mask.astype(int), bbox).astype(bool)
+    transformed = _apply_op_mask(crop, op)
+    r0, c0, r1, c1 = bbox
+    out[r0 : r1 + 1, c0 : c1 + 1] = transformed
+    return out
+
