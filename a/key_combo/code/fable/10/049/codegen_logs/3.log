+    grid = np.full((panel_size, 3 * panel_size + 2), BLACK, dtype=int)
+    starts = (0, panel_size + 1, 2 * panel_size + 2)
+    for start, panel in zip(starts, panels):
+        grid[:, start : start + panel_size] = panel
+    return grid
