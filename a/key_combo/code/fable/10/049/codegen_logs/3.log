+    return out
+
+
+def _overlay_raw(records: list[dict], bg: int, order: tuple[int, int, int] = (0, 1, 2)) -> np.ndarray:
+    n = int(records[0]["sprite_mask"].shape[0])
+    out = np.full((n, n), int(bg), dtype=int)
+    for idx in order:
+        rec = records[int(idx)]
+        out[rec["sprite_mask"]] = int(rec["color"])
+    return out
