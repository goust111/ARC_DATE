+
+
+def _instruction_crop(op: str, sprite_area: int, rng: random.Random) -> np.ndarray:
+    if op == "flip_ud":
+        return np.ones((1, rng.choice([2, 3])), dtype=bool)
+    if op == "flip_lr":
+        return np.ones((rng.choice([2, 3]), 1), dtype=bool)
