+            if not cand1:
+                continue
+            mask1 = rng.choice(cand1)
+            cand2 = []
+            for m2 in placements[2]:
+                ov0 = _overlap(m2, mask0)
+                ov1 = _overlap(m2, mask1)
+                total = _overlap(m2, mask0 | mask1)
+                if ov0 >= 1 and ov1 >= 1 and total <= 4:
+                    cand2.append(m2)
