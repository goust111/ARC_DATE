+        for r, c in cells:
+            mask[r, c] = True
+        coords = np.argwhere(mask)
+        bbox = bbox_from_coords(coords)
+        crop = crop_bbox(mask.astype(int), bbox).astype(bool)
+        if crop.shape[0] < 2 or crop.shape[1] < 2 or int(crop.sum()) < 5:
+            continue
