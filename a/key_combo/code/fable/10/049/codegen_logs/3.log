+def _overlay_records(records: list[dict], bg: int, ops: tuple[str, str, str], order: tuple[int, int, int] = (0, 1, 2)) -> np.ndarray:
+    n = int(records[0]["sprite_mask"].shape[0])
+    out = np.full((n, n), int(bg), dtype=int)
