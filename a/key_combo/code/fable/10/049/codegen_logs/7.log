        rr = coords[:, 0] + int(dr)
        cc = coords[:, 1] + int(dc)
        out[rr, cc] = color
        occupied[rr, cc] = True

    assert len(set(sprite_colors)) == len(sprite_colors), "panel sprite colors must be distinct"
    return out

