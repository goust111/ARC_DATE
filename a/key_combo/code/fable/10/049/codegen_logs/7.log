+    wrong_phase = _wrong_reanchored_extension(inp.shape, target_box, repaired[:pr, :pc], markers, control, bg)
+    if np.array_equal(wrong_phase, expected):
+        return False
+
+    return True
+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
