+    src_w = pc * rep_c
+
+    exp_top = random.randint(1, 4)
+    exp_bottom = random.randint(1, 4)
+    exp_left = random.randint(1, 4)
+    exp_right = random.randint(1, 4)
+    if exp_top % pr == 0 and exp_left % pc == 0:
+        return None
+
