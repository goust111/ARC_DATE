+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    pr = random.randint(2, 4)
+    pc = random.randint(2, 4)
+    rep_r = random.randint(2, 4)
+    rep_c = random.randint(2, 4)
