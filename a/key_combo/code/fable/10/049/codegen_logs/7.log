+def _wrong_unrepaired_extension(inp: np.ndarray, source_box: BBox, target_box: BBox, control: int, pollution: int, pr: int, pc: int, bg: int) -> np.ndarray | None:
+    sr0, sc0, sr1, sc1 = source_box
