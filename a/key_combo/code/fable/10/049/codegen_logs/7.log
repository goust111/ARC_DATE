spec:
  task: pack scattered polyomino fragments into a solid 3x4 rectangle
  output:
    shape: 3x4 (always)
    content: fully filled with 3 distinct non-zero colors, no background
    each_color_region: one or more 4-connected polyomino pieces that together tile the rectangle
  input:
    grid: 10 rows x 10-13 cols
    background: 0
    border: all background [observed]
    fragments: 3-5 monochromatic 4-connected polyominoes, exactly 3 distinct non-zero colors
    total_area: 12 (= 3x4)
    individual_areas: range 1-7; largest fragment 5-7 cells [observed]
    same_color_fragments: a color may appear in 2 separate fragments (each small, area 1-2)
    separation: min L1 distance between any two fragments >= 2
    density: foreground ~10-12% of grid [observed]
    no_bbox_overlap: fragment bounding boxes do not overlap [observed]
  transform:
    sort_fragments: by decreasing area, ties broken left-to-right in input
    packing: for each fragment try all 8 orientations (identity/rot/reflect), scan placements top-left to bottom-right; backtrack until rectangle is filled
    colors_preserved: each fragment keeps its original color

generation_strategy:
  approach: output-first
  steps:
    - build a 3x4 grid; partition all 12 cells into 3-5 polyomino pieces (4-connected) using 3 distinct non-zero colors; each color gets 1-2 pieces; ensure the partition is valid (all pieces connected, full coverage)
    - verify the solver's backtracking search finds a unique-first-hit tiling (run solver as oracle)
    - for each polyomino piece, optionally apply a random rotation/reflection
    - create a 10 x randint(10,13) grid of background 0
    - scatter the (possibly reoriented) fragments onto the grid with min L1 gap >= 2 between any pair, all cells at least 1 row/col from border
