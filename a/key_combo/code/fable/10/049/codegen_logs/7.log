+def _semantic_checks(inp: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        info = _solve_instance(inp)
+    except Exception:
+        return False
+    if not np.array_equal(main(inp), expected):
+        return False
+    if np.array_equal(inp, expected):
+        return False
