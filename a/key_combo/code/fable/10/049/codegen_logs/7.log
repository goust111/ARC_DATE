+    for rr in range(pr):
+        for cc in range(pc):
+            vals = [int(src[r, c]) for r in range(rr, src.shape[0], pr) for c in range(cc, src.shape[1], pc)]
+            if pollution in vals:
+                residue_colors[(rr, cc)] = pollution
+            else:
+                uniq = set(vals)
+                if len(uniq) != 1:
+                    return None
+                residue_colors[(rr, cc)] = next(iter(uniq))
