+    out = np.full_like(inp, bg)
+    out[inp == control] = control
+    tr0, tc0, tr1, tc1 = target_box
+    for r in range(tr0, tr1 + 1):
+        for c in range(tc0, tc1 + 1):
+            out[r, c] = residue_colors[((r - sr0) % pr, (c - sc0) % pc)]
+    return out
