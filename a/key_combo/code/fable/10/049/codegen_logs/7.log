+
+def _infer_target_bbox(markers: list[Coord], shape: tuple[int, int]) -> BBox | None:
+    rows, cols = shape
+    r_values = [r for r, _ in markers]
+    c_values = [c for _, c in markers]
+    r0 = min(r_values) + 1
+    c0 = min(c_values) + 1
+    r1 = max(r_values) - 1
+    c1 = max(c_values) - 1
