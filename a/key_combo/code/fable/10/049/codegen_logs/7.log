+            counts["top"] += 1
+        elif r == r1 + 1 and c0 <= c <= c1:
+            counts["bottom"] += 1
+        elif c == c0 - 1 and r0 <= r <= r1:
+            counts["left"] += 1
+        elif c == c1 + 1 and r0 <= r <= r1:
+            counts["right"] += 1
+        else:
