+    marker_cells = [winner_cell, decoy_cell]
+    target_marker_count = random.randint(3, 5)
+    extras = _sample_extra_markers(wall_mask, grey_mask, marker_cells, fence_bbox, target_marker_count - 2)
+    if extras is None:
