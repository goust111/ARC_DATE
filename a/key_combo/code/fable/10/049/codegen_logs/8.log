+            "top": ("left", "right"),
+            "bottom": ("left", "right"),
+            "left": ("top", "bottom"),
+            "right": ("top", "bottom"),
+        }[primary_side]
+        second_side = random.choice(adj_sides)
+        second_anchor = grey_center_c if second_side in ("top", "bottom") else grey_center_r
+        gates.add(_gate_position(second_side, fr0, fc0, fr1, fc1, second_anchor + random.randint(-2, 2)))
