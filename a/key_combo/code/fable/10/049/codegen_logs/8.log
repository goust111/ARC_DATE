+
+Coord = tuple[int, int]
+ORTHO_DIRS: tuple[Coord, ...] = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MARKER_COLORS = tuple(c for c in range(10) if c not in (Color.BLACK, Color.GREY, Color.TEAL))
+MAX_GENERATION_ATTEMPTS = 500
