+
+    if abs(winner_cell[0] - decoy_cell[0]) + abs(winner_cell[1] - decoy_cell[1]) <= 1:
+        return None
+
+    grey_mask = grid == Color.GREY
+    if any(grid[r, c] != Color.BLACK for r, c in (winner_cell, decoy_cell)):
