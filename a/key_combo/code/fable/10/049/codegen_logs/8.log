spec:
  grid: 4-6 rows x 4-6 cols
  colors:
    total: exactly 5 distinct colors, none is orange (7)
    top2: the two most-frequent colors; may tie each other but 3rd must be strictly less
    minority: exactly 3 colors, each with count strictly below the 2nd-most-frequent
    gap_2nd_to_3rd: 1-5 [observed]
  pixel_layout: scattered/random; adjacent-different ratio 74-87% [observed]
  minority_fraction: 29-50% of total pixels [observed]
  output:
    same shape as input
    top-2 color pixels preserved in place
    all minority-color pixels replaced with orange (7)
    output contains exactly 3 colors: the two top-2 colors + orange

generation_strategy:
  approach: direct (input-first); transformation is trivial recoloring so input is the hard part
