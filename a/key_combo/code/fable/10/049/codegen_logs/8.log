+    elif primary_side == "bottom":
+        pad_t, pad_b, pad_l, pad_r = near_pad, far_pad, side_pad0, side_pad1
+    elif primary_side == "left":
+        pad_t, pad_b, pad_l, pad_r = side_pad0, side_pad1, far_pad, near_pad
+    else:
