+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Component = dict[str, object]
+
+
+ORTHO_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PAD_DIRS = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1))
+PALETTE = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
