+    moved = 0
+    for comp in comps:
+        reflected = _reflect_global(comp["coords"], axis_kind, axis2)  # type: ignore[arg-type]
+        if reflected != comp["coords"]:
+            moved += 1
+    return moved >= len(comps) - 2
+
+
+def _attempt_generate() -> np.ndarray | None:
