+def _find_components(grid: np.ndarray, bg: int) -> list[Component]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[Component] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: set[Coord] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.add((rr, cc))
+                for dr, dc in ORTHO_DIRS:
