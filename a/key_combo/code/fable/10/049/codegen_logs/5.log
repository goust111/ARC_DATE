+    coords_a = comp_a["coords"]  # type: ignore[assignment]
+    coords_b = comp_b["coords"]  # type: ignore[assignment]
+    bba = comp_a["bbox"]  # type: ignore[assignment]
+    bbb = comp_b["bbox"]  # type: ignore[assignment]
