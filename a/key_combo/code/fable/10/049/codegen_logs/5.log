+    matches: list[tuple[str, int]] = []
+    axis2 = int(bba[1] + bbb[3])
+    if axis2 == int(bba[3] + bbb[1]) and _reflect_global(coords_a, "vertical", axis2) == coords_b:
+        matches.append(("vertical", axis2))
