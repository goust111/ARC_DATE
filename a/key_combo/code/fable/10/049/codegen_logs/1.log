+        occupied[final[:, 0], final[:, 1]] = True
+        settled.append({"color": color, "coords": final, "area": int(obj["area"])})
+        traces.append(
+            {
+                "color": color,
+                "side": side,
+                "area": int(obj["area"]),
+                "gap_before": gap_before,
