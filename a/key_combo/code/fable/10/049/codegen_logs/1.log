+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MARKER = 2
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+SIDES = ("up", "down", "left", "right")
+
+MAX_AREA = 4
+MIN_OBJECTS = 3
+MAX_OBJECTS = 4
