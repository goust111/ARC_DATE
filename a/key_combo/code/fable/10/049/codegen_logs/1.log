+    for color in sorted(int(c) for c in np.unique(g) if int(c) not in (BG, MARKER)):
+        mask = g == color
+        assert _is_connected(mask), "each non-marker color must form one 4-connected object"
+        coords = np.argwhere(mask).astype(int)
