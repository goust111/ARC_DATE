+    for dist in range(1, INPUT_FARTHER_LIMIT + 1):
+        coords = _translate(ring, away_r * dist, away_c * dist)
+        if _coords_in_bounds(coords, shape) and not np.array_equal(coords, final):
+            candidates.append((coords, "farther"))
+
