                    blob.append((nr, nc))
                    break
        if len(blob) != size:
            continue
        blob_set = set(blob)
        touches_same = any(
            0 <= br + dr < H and 0 <= bc + dc < W
            and (br + dr, bc + dc) not in blob_set
            and output[br + dr, bc + dc] == color
            for br, bc in blob for dr, dc in CARDINAL_DIRS
        )
        if not touches_same:
            for br, bc in blob:
                output[br, bc] = color
            return blob
    return None


