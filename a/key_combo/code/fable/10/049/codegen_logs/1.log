+
+
+def _input_candidates(trace: dict, shape: tuple[int, int]) -> list[tuple[np.ndarray, str]]:
+    ring = np.asarray(trace["ring_coords"], dtype=int)
+    final = np.asarray(trace["final_coords"], dtype=int)
