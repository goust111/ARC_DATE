            nxt = coords + step
            in_bounds = (
                np.all(0 <= nxt[:, 0])
                and np.all(nxt[:, 0] < H)
                and np.all(0 <= nxt[:, 1])
                and np.all(nxt[:, 1] < W)
            )
            if not in_bounds or np.any(occupied[nxt[:, 0], nxt[:, 1]]):
                break
            coords = nxt

        assert not np.any(occupied[coords[:, 0], coords[:, 1]]), "settled domino collision"
        out[coords[:, 0], coords[:, 1]] = color
        occupied[coords[:, 0], coords[:, 1]] = True

    return out

