+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if not passable[nr, nc]:
+                continue
+            nd = int(dist[r, c] + 1)
+            if dist[nr, nc] == -1:
+                dist[nr, nc] = nd
+                ways[nr, nc] = ways[r, c]
+                parent[nr, nc] = (r, c)
+                q.append((nr, nc))
+            elif dist[nr, nc] == nd:
+                ways[nr, nc] = min(2, int(ways[nr, nc]) + int(ways[r, c]))
