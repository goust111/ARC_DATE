+    goal_dist = int(dist[goal])
+    goal_ways = int(ways[goal])
+    if goal_dist < 0 or goal_ways != 1:
+        return goal_dist, goal_ways, None
+
+    path_rev = [goal]
+    cur = goal
+    while cur != start:
+        pr, pc = map(int, parent[cur])
+        assert pr >= 0
+        cur = (pr, pc)
+        path_rev.append(cur)
+    path = list(reversed(path_rev))
+    return goal_dist, goal_ways, path
