+    aligned: dict[tuple[int, int], int] = {}
+    for fragment in fragments:
+        patch = fragment["patch"]
+        ar, ac = fragment["anchor"]
+        h, w = patch.shape
+        for rr in range(h):
+            for cc in range(w):
+                value = int(patch[rr, cc])
+                key = (rr - ar, cc - ac)
+                if key in aligned:
+                    assert aligned[key] == value, "aligned overlaps must agree"
+                else:
+                    aligned[key] = value
