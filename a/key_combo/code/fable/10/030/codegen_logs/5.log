+    min_h = max(base, max_h + 2)
+    min_w = max(base, max_w + 2)
+    return random.randint(min_h, 30), random.randint(min_w, 30)
+
+
+def _render_input(patches: list[np.ndarray]) -> np.ndarray | None:
