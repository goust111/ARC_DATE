+            col_step = random.randint(1, 3)
+            offset = random.randrange(color_count)
+            for r, c in body_coords:
+                idx = ((r // row_step) + (c // col_step) + offset) % color_count
+                out[r, c] = palette[idx]
+        elif mode == "tile":
+            tile_h = random.randint(2, 3)
+            tile_w = random.randint(2, 4)
