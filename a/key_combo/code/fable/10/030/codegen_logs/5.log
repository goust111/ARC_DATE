+from __future__ import annotations
+
+from collections import deque
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+ANCHOR = 8
+BODY_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+
+FRAGMENT_COUNT_RANGE = (3, 5)
+OUTPUT_SIDE_RANGE = (6, 12)
+FRAGMENT_AREA_MIN = 6
+PLACEMENT_GAP = 1
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 80
+PLACEMENT_NODE_BUDGET = 6000
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _extract_fragments(grid: np.ndarray) -> list[dict]:
+    comps = _components_mask(grid != BG)
+    assert comps, "expected at least one fragment"
+
+    fragments: list[dict] = []
