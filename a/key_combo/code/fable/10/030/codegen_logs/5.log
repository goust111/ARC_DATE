+        out[anchor_r, anchor_c] = ANCHOR
+        used = sorted(set(map(int, out[(out != BG) & (out != ANCHOR)].flat)))
+        if len(used) < 2:
+            continue
+        return out
+    return None
+
+
+def _fragment_patch(
+    output: np.ndarray, anchor_r: int, anchor_c: int, rect: tuple[int, int, int, int]
