+    cols = [c for _r, c in aligned]
+    min_r, max_r = min(rows), max(rows)
+    min_c, max_c = min(cols), max(cols)
+
+    out = np.full((max_r - min_r + 1, max_c - min_c + 1), BG, dtype=int)
+    for (rr, cc), value in aligned.items():
+        out[rr - min_r, cc - min_c] = int(value)
+    return out
