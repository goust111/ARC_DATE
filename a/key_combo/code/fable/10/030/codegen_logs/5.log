+    if multicolor_fragments < 2:
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    sampled = _sample_fragment_family()
+    if sampled is None:
+        return None
+    rects, anchor_r, anchor_c, h, w = sampled
+
