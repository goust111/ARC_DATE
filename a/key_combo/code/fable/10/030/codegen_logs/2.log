+
+    remaining = [idx for idx in range(total) if idx not in roots]
+    rng.shuffle(remaining)
+    chain_root = rng.choice(roots)
+    mid = remaining.pop()
+    leaf = remaining.pop()
+    parent[mid] = chain_root
+    parent[leaf] = mid
+
+    assigned = set(roots)
+    assigned.add(mid)
+    assigned.add(leaf)
