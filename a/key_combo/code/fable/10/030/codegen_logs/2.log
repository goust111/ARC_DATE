+def _build_forest(n: int, rng: random.Random) -> tuple[list[int], tuple[int, int, int], list[int]]:
+    total = n * n
+    max_roots = min(_ROOT_COUNT_MAX, total - 2)
+    root_count = rng.randint(2, max_roots)
+    roots = rng.sample(range(total), root_count)
