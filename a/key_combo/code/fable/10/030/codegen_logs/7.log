 118: def _exclusion_zone(pixels, dist: int) -> set:
 119:     """Return the set of all coords within Chebyshev `dist` of any pixel."""
 120:     zone = set()
 121:     for r, c in pixels:
 122:         for dr in range(-dist, dist + 1):
 123:             for dc in range(-dist, dist + 1):
 124:                 zone.add((r + dr, c + dc))
 125:     return zone
