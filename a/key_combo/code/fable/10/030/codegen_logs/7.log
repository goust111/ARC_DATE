  74:                 square_pattern[i, j] = line_color
  75: 
  76:         # Place the reconstructed pattern on the output grid
  77:         output_grid = paste(output_grid, square_pattern, r, c, transparent=Color.BLACK, clip=True)
  78: 
  79:     return output_grid
