  52:         width = _r1 - r + 1
  53:         height = _c1 - c + 1
  54:         _b = bbox(obj != line_color)
  55:         assert _b is not None
  56:         square = crop_bbox(obj, _b)
  57:         cropped_squares.append({'x': r, 'y': c, 'len': width, 'pattern': square})
  58: 
  59:     # Sort the squares by their position
