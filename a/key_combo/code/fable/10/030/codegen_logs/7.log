 164:     vertical_sides: dict[int, set[str]] = {}
 165:     for marker, candidate in best_by_marker.items():
 166:         _distance, block_index, _dst, direction = candidate
 167:         if direction in {"down", "up"}:
 168:             side = "above" if direction == "down" else "below"
 169:             vertical_sides.setdefault(block_index, set()).add(side)
 170: 
 171:     moves: list[tuple[Coord, Coord]] = []
 172:     destinations: set[Coord] = set()
 173:     for marker, candidate in best_by_marker.items():
 174:         if _skip_lower_left_distractor(marker, candidate, blocks, vertical_sides):
 175:             continue
 176: 
 177:         _distance, _block_index, dst, _direction = candidate
 178:         assert dst not in destinations, "marker destinations must be unique"
