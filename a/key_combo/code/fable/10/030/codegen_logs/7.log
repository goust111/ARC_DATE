 163:     catalog_color, catalog_mask = _catalog_background(g)
 164:     templates = _templates(g, catalog_color, catalog_mask)
 165: 
 166:     planned: dict[tuple[int, int], int] = {}
 167:     workspace = (g != 0) & (~catalog_mask)
 168:     for coords in components_mask(workspace, connectivity=8):
 169:         if _touches(catalog_mask, coords):
 170:             continue
 171: 
 172:         box, part = _component_array(g, coords)
 173:         r0, c0, _r1, _c1 = box
 174:         source_mask = np.zeros_like(g, dtype=bool)
 175:         source_mask[coords[:, 0], coords[:, 1]] = True
 176: 
 177:         matches = []
 178:         for template in templates:
 179:             sprite = template["grid"]
 180:             for off_r, off_c in _template_offsets(part, template):
 181:                 anchor_r, anchor_c = r0 - off_r, c0 - off_c
 182:                 height, width = map(int, sprite.shape)
 183:                 if not (
 184:                     0 <= anchor_r
 185:                     and 0 <= anchor_c
 186:                     and anchor_r + height <= g.shape[0]
 187:                     and anchor_c + width <= g.shape[1]
 188:                 ):
 189:                     continue
 190: 
 191:                 ok = True
 192:                 for rr, cc in np.argwhere(template["visible"]):
 193:                     gr, gc = anchor_r + int(rr), anchor_c + int(cc)
 194:                     value = int(sprite[rr, cc])
 195:                     if g[gr, gc] != 0 and not source_mask[gr, gc] and g[gr, gc] != value:
 196:                         ok = False
 197:                         break
 198:                 if ok:
 199:                     cells = tuple(
 200:                         (int(rr), int(cc), int(sprite[rr, cc]))
 201:                         for rr, cc in np.argwhere(template["visible"])
 202:                     )
 203:                     matches.append((anchor_r, anchor_c, cells))
 204: 
