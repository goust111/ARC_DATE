 109: def _nearby(r: int, c: int, dist: int, ref: set) -> bool:
 110:     """Return True if any pixel in `ref` is within Chebyshev distance `dist`."""
 111:     for dr in range(-dist, dist + 1):
 112:         for dc in range(-dist, dist + 1):
 113:             if (r + dr, c + dc) in ref:
 114:                 return True
 115:     return False
