+def _bg_degree(grid: np.ndarray, r: int, c: int) -> int:
+    degree = 0
+    for dr, dc in DIR4:
+        nr = r + dr
+        nc = c + dc
+        if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == BG:
+            degree += 1
+    return degree
