+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 3
+SIDES = ("top", "bottom", "left", "right")
+PALETTE = (1, 2, 4, 5, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+INF = 10**9
