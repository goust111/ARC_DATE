+
+
+def _free_background_cells(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    cells = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(grid[r, c]) == BG:
+                cells.append((r, c))
+    return cells
+
+
+def _place_stub(grid: np.ndarray, side_colors: dict[str, int]) -> bool:
