+        given_right = np.asarray(row["given_right"], dtype=int)
+        expected_right = np.asarray(row["expected_right"], dtype=int)
+        grid[r, :width] = left
+        grid[r, width] = opcode
+        grid[r, width + 1 :] = given_right
+        solved[r, :width] = left
+        solved[r, width] = opcode
+        solved[r, width + 1 :] = expected_right
