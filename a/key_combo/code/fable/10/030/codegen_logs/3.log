    nb[:, :-1] += black[:, 1:]
    nb[:, 1:]  += black[:, :-1]

    # Count out-of-bounds sides
    oob = np.zeros((H, W), dtype=int)
    oob[0, :] += 1; oob[-1, :] += 1; oob[:, 0] += 1; oob[:, -1] += 1

