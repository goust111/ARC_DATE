+    for row, inp_row, out_row in zip(rows, grid, solved, strict=True):
+        opcode = int(row["opcode"])
+        left = np.asarray(row["left"], dtype=int)
+        if np.array_equal(inp_row, out_row):
+            if row["kind"] not in {"intact_asym", "intact_sym"}:
+                return False
+        else:
