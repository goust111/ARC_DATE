    return (r1 - r0 + 1, c1 - c0 + 1) == (height, width) and bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1]))


def _gen_solid_matches_template(height: int, width: int, color: int, templates: list[dict]) -> bool:
