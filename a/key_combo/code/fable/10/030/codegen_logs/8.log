+
+def _unique_d4(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen = set()
+    base = np.asarray(mask, dtype=bool)
+    for k in range(4):
+        rot = np.rot90(base, k)
+        for cand in (rot, np.fliplr(rot)):
+            key = _shape_key(cand)
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append(cand.copy())
+    return out
