+
+
+def _random_blocker_segment(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    blocker_colors: list[int],
+    forbidden: set[Coord],
+) -> bool:
+    cells = [(r, c) for r in range(grid.shape[0]) for c in range(grid.shape[1])]
+    random.shuffle(cells)
