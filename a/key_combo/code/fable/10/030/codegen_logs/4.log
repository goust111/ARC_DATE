spec:
  grid: 7-9 rows x 7-9 cols, background 0 (black)
  frame:
    color: 1 (blue) [observed]
    shape: perfect 1-cell-thick hollow rectangle, 4-8 rows x 5-7 cols
    position: touches 1-2 grid edges but does not fill the grid; leaves >=1 row/col of space on remaining sides
    interior: contains only bg and marker pixels; area 8-20
  marker:
    color: any non-bg non-frame color (one color per puzzle)
    inside_count: 1-9 (this is the tally N rendered in the output)
    outside_count: 3-6 distractor pixels scattered on bg cells outside the frame
    no markers on the frame border itself
  output: 3x3 grid, first N cells (row-major) set to marker color, rest bg

generation_strategy:
  approach: direct construction (output is trivially derived from count)
  steps:
    1. Pick grid size H x W in [7,9].
    2. Pick marker count N in [1,9] and a marker color != 0, != 1.
    3. Place a hollow rectangle frame (color 1) of height [4,H-1] and width [5,W-1] so it touches 1-2 grid edges with >=1 row/col gap on other sides. Ensure interior area >= N.
    4. Randomly place N marker pixels on distinct bg cells strictly inside the frame.
    5. Place 3-6 distractor marker pixels on distinct bg cells strictly outside the frame (not on frame border).
    6. Output is a 3x3 bg grid with first N cells row-major set to marker color.
```
