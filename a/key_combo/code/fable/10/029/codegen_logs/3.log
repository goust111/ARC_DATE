+    direction, gap, length = random.choice(options)
+    cells = [(center[0] + direction[0] * k, center[1] + direction[1] * k) for k in range(gap, gap + length)]
+    return cells, gap
+
+
+def _touches_any(cell: Coord, others: set[Coord]) -> bool:
+    r, c = cell
+    for rr, cc in others:
+        if max(abs(r - rr), abs(c - cc)) <= 1:
