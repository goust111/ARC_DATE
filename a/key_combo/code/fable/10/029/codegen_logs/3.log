+def _render_expected(
+    shape: tuple[int, int],
+    slash_cells: list[Coord],
+    backslash_cells: list[Coord],
+    magenta_sources: list[Coord],
+    cyan_sources: list[Coord],
+    center: Coord,
+) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.full(shape, BLACK, dtype=int)
