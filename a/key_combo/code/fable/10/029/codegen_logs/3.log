+GRID_H_RANGE = (14, 25)
+GRID_W_RANGE = (14, 25)
+CENTER_MARGIN = 3
+SEGMENT_LENGTH_RANGE = (2, 5)
+SEGMENT_GAP_RANGE = (1, 4)
