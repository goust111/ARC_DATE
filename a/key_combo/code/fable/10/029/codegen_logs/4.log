+        reachable_sides = {_side_label(sprite["bbox"], g.shape[1]) for sprite in reachables}
+        unreachable_sides = {_side_label(sprite["bbox"], g.shape[1]) for sprite in unreachables}
+        if not (reachable_sides & unreachable_sides):
+            return False
+
+        out = main(g)
