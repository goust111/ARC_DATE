+                    return False
+        return True
+    except Exception:
+        return False
+
+
+def _generate_attempt() -> np.ndarray | None:
+    height = int(_RNG.integers(16, 25))
+    width = int(_RNG.integers(16, 25))
+    bg = int(_RNG.choice(BG_CHOICES))
+
+    grid = np.full((height, width), bg, dtype=int)
