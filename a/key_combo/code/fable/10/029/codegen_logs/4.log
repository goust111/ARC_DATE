    upper_cols = _gen_pair_cols(width)
    lower_cols = _gen_pair_cols(width)
    rows = (upper_rows[0], upper_rows[1], lower_rows[0], lower_rows[1])
    cols = (*upper_cols, *lower_cols)
    return tuple(zip(rows, cols))


