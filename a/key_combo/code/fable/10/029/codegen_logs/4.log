+    return valid
+
+
+def _place_sprite(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    region_mask: np.ndarray,
+    patch: np.ndarray,
+    bg: int,
+) -> bool:
+    choices = _candidate_positions(grid, reserved, region_mask, patch, bg)
+    if not choices:
+        return False
+    r0, c0 = choices[int(_RNG.integers(len(choices)))]
+    h, w = patch.shape
+    dst_c0 = grid.shape[1] - w - c0
