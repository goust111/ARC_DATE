    stamp = np.where(mask, STAMP, BG).astype(int)
    for block_r, block_c in np.argwhere(mask):
        rs = int(block_r) * n
        cs = int(block_c) * n
        out[rs : rs + n, cs : cs + n] = stamp
    return out


