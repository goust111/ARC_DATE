        return None
    all_cells = [
        (row_bands[ri][0], row_bands[ri][1], col_bands[ci][0], col_bands[ci][1])
        for ri in range(GRID_LAYOUT_PARTS)
        for ci in range(GRID_LAYOUT_PARTS)
