        return None

    h = random.randint(min_side, min(max_side, cell_h))
    w = random.randint(min_side, min(max_side, cell_w))
    starts = [
        (r, c)
        for r in range(r0, r1 - h + 1)
        for c in range(c0, c1 - w + 1)
        if not (r == 0 and c == 0)
    ]
    if not starts:
