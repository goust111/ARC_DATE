+        GREEN = 3
+        YELLOW = 4
+        GREY = 5
+        PINK = 6
+        ORANGE = 7
+        TEAL = 8
+        MAROON = 9
+
+
+BG = int(Color.BLACK)
+STAMP = int(Color.GREY)
+PANEL_PALETTE = np.array(
