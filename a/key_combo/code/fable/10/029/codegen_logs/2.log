+_SEEN_OUTPUT_SIGS: set[str] = set()
+
+
+def _signature(grid: np.ndarray) -> str:
+    arr = np.asarray(grid, dtype=int)
+    return hashlib.md5(arr.tobytes() + str(tuple(arr.shape)).encode()).hexdigest()
