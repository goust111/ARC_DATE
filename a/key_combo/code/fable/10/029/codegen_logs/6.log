+    )
+    wrong_variants.append(
+        _false_output(
+            grid,
+            fg_mask,
+            bg=bg,
+            fg=fg,
+            anchor_rc=anchor_rc,
+            anchor_row=r1,
+            anchor_on_left=not anchor_on_left,
+        )
+    )
+    for wrong in wrong_variants:
+        if wrong is not None and np.array_equal(wrong, expected):
+            return False
+    return True
