+    for _ in range(60):
+        picks = sorted(random.sample(interior, need))
+        bars = sorted(required + picks)
+        if min(bars[i + 1] - bars[i] for i in range(len(bars) - 1)) >= 2:
+            return bars
+    return None
+
+
