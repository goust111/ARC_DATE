+        fg=fg2,
+        fg_mask=fg_mask,
+        box=box,
+        anchor_rc=anchor_rc,
+        anchor_on_left=anchor_side,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
