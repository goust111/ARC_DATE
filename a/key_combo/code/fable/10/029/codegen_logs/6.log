    cell_h = r1 - r0
    cell_w = c1 - c0
    min_side, max_side = RECT_SIDE_RANGE
    if cell_h < min_side or cell_w < min_side:
        return None

    h = random.randint(min_side, min(max_side, cell_h))
    w = random.randint(min_side, min(max_side, cell_w))
    starts = [
