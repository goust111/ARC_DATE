+    best = min(
+        (
+            abs(int(r) - hr) + abs(int(c) - hc),
+            -int(dist0[r, c]),
+            int(r),
+            int(c),
+        )
+        for r, c in reachable
+    )
+    target = (best[2], best[3])
+    dist1 = _bfs_dist(mask, target)
