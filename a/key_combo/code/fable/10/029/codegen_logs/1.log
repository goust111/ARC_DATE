        g=render(p,l)
        small=np.array([[g[r:r+s,c:c+s].all() for c in range(g.shape[1]-s+1)] for r in range(g.shape[0]-s+1)],bool)
        large=np.array([[g[r:r+l,c:c+l].all() for c in range(g.shape[1]-l+1)] for r in range(g.shape[0]-l+1)],bool)
        cs=comp(small,p[0]); cl=comp(large,p[0])
        if simple(small,cs) and simple(large,cl):
            ok+=1
    print('l',l,'s',s,'ok',ok)
