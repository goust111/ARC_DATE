+    assert len(squares) >= 2
+    squares.sort(key=lambda s: (s["size"], s["color"]))
+    small, large = squares[0], squares[-1]
+    assert int(small["size"]) < int(large["size"])
+
+    counts = Counter(map(int, g.ravel()))
+    river = None
+    for color, _ in counts.most_common():
