+            active_small = False
+            blocked_now.append("small")
+            reasons["small"] = "width" if cand_small is None else "overlap"
+        if active_large and not move_large:
+            active_large = False
+            blocked_now.append("large")
+            reasons["large"] = "width" if cand_large is None else "overlap"
