import random, numpy as np

def rand_path(n=20, H=10,W=10):
    for _ in range(500):
        start=(random.randrange(H),random.randrange(W))
        path=[start]; seen={start}
        while len(path)<n:
            r,c=path[-1]
            nbr=[(r+dr,c+dc) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)] if 0<=r+dr<H and 0<=c+dc<W and (r+dr,c+dc) not in seen]
            random.shuffle(nbr)
            good=[]
            for x in nbr:
                # avoid nonconsecutive touching
                ok=True
                for y in seen:
                    if y==path[-1]: continue
                    if abs(y[0]-x[0])+abs(y[1]-x[1])==1:
                        ok=False; break
                if ok: good.append(x)
            if not good: break
            path.append(good[0]); seen.add(good[0])
        if len(path)>=n:
            return path
    return None

def render(path,l):
    H=max(r for r,c in path)+l+2; W=max(c for r,c in path)+l+2
    g=np.zeros((H,W),int)
    for r,c in path:
        g[r:r+l,c:c+l]=1
    return g

def comp(mask,start):
    if not mask[start]: return set()
    H,W=mask.shape; st=[start]; seen={start}
    while st:
        r,c=st.pop()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); st.append((rr,cc))
    return seen

def simple(mask,nodes):
    if not nodes: return False
    degs=[]
    for r,c in nodes:
        d=sum(((r+dr,c+dc) in nodes) for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)])
        degs.append(d)
        if d>2: return False
    return degs.count(1) in (0,2)

for l in [3,4]:
  for s in [1,2,3]:
    if s>=l: continue
    ok=0
    for t in range(200):
        p=rand_path(n=15,H=10,W=10)
