DIR4=[(1,0),(-1,0),(0,1),(0,-1)]

def coarse_path(rows, cols):
    edges=[(r,c) for r in range(rows) for c in range(cols) if r in (0,rows-1) or c in (0,cols-1)]
    for _ in range(200):
        s=random.choice(edges)
        cand=sorted(edges,key=lambda p:abs(p[0]-s[0])+abs(p[1]-s[1]),reverse=True)
        t=random.choice(cand[:max(2,len(cand)//2)])
        path=[s]; seen={s}
        while path[-1]"'!=t and len(path)<rows*cols:
            r,c=path[-1]
            nbr=[]
            for dr,dc in DIR4:
                rr,cc=r+dr,c+dc
