+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        desired_branch = random.choices(BRANCHES, weights=(3, 3, 4), k=1)[0]
+        grid = _gen_attempt(desired_branch)
+        if grid is not None:
