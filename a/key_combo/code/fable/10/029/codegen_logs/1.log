def _gen_sprite_patch(rng, colors):
    patch = np.full((SPRITE_SIZE, SPRITE_SIZE), BG, dtype=int)
    if rng.integers(BINARY_CHOICE_COUNT) == 0:
        missing = int(rng.integers(len(SPRITE_CELLS)))
