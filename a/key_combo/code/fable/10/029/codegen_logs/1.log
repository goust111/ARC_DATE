            nbr.sort(key=lambda p: abs(p[0]-t[0])+abs(p[1]-t[1]))
            if not nbr: break
            best=[n for n in nbr if abs(n[0]-t[0])+abs(n[1]-t[1])==abs(nbr[0][0]-t[0])+abs(nbr[0][1]-t[1])]
            nxt=random.choice(best[:2])
