+    cur = (sr, sc)
+    out = [cur]
+    while cur != target:
+        r, c = cur
+        candidates = []
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1]):
