+    feasible_small = _feasible_mask(traversable, int(small["size"]))
+    feasible_large = _feasible_mask(traversable, int(large["size"]))
+    assert bool(feasible_small[small["pos"]])
+    assert bool(feasible_large[large["pos"]])
