+    squares = []
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        side = r1 - r0 + 1
+        if side != c1 - c0 + 1:
+            continue
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        if np.all(patch == int(comp["color"])):
+            squares.append(
