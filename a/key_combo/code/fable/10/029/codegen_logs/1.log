+
+def _bfs_dist(mask: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    dist = -np.ones(mask.shape, dtype=int)
+    sr, sc = map(int, start)
+    assert bool(mask[sr, sc])
+    q = deque([(sr, sc)])
+    dist[sr, sc] = 0
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
