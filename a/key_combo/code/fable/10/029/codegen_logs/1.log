+def _snake_coarse(rows: int, cols: int) -> list[tuple[int, int]]:
+    coarse = []
+    for r in range(rows):
+        cols_iter = range(cols) if r % 2 == 0 else range(cols - 1, -1, -1)
+        for c in cols_iter:
+            coarse.append((r, c))
+    if random.random() < 0.5:
+        coarse.reverse()
+    return coarse
