+    if np.any(river_mask, axis=0).sum() < max(6, int(0.6 * w)):
+        return None
+    if meta["small_path_len"] < 5 or meta["large_path_len"] < 3:
+        return None
+    if meta["small_steps"] == 0 or meta["large_steps"] == 0:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
