+            if int(dist0[nr, nc]) != int(dist0[r, c]) + 1:
+                continue
+            if int(dist1[nr, nc]) < 0:
+                continue
+            if int(dist0[nr, nc]) + int(dist1[nr, nc]) != int(dist0[target]):
+                continue
+            candidates.append((nr, nc))
+        assert candidates
+        candidates.sort(key=lambda p: (abs(p[0] - hr) + abs(p[1] - hc), p[0], p[1]))
+        cur = candidates[0]
