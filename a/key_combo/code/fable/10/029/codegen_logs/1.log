    for r, c in random.sample(cells, n_blockers):
        mask[r, c] = True

    # A few local moves add light random-walk clustering without making solid walls.
    for _ in range(random.randint(0, max(1, n_blockers // _GEN_CLUSTER_DIVISOR))):
