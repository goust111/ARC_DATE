+def _paint_backbone(grid: np.ndarray, path: list[tuple[int, int]], side: int, color: int) -> None:
+    s = int(side)
+    for r, c in path:
+        grid[r : r + s, c : c + s] = int(color)
+
+
+def _carve_neck(
+    grid: np.ndarray,
+    path: list[tuple[int, int]],
+    run: tuple[int, int, str],
+    large_side: int,
+    keep_width: int,
+    bg: int,
+) -> bool:
