        frontier = set()
        for r, c in np.argwhere(mask):
            for dr, dc in GEN_NEIGHBORS_4:
                nr, nc = int(r) + dr, int(c) + dc
                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
