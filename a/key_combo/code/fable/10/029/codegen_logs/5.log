  layout:
    arrangement: 2x2 grid of scattered sprites — two upper, two lower
    upper_lower_separation: when sorted by (row, col), sprite #2's top row < sprite #3's top row (clear row gap >= 3 empty rows between upper-bottom and lower-top)
    within_pair_col_separation: left sprite's right col < right sprite's left col (no col overlap within a pair)
