  "type": "move_in_order",
  "src": "four 8-connected 3x3 foreground sprites s, ordered by input position: two upper sprites then two lower sprites, left-to-right within each pair",
  "dst": "2x2 3x3 output slots d with one bg separator row and column, ordered row-major",
  "match_cond": "rank(s) == rank(d)",
  "transform": "crop each sprite's 3x3 bbox unchanged, preserving bg holes, and paste it into its slot",
  "grid_shape": "7x7 packed atlas"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    input: 16-23 rows x 16-23 cols
    output: always 7x7
  colors:
    bg: 0 (black)
    fg: 2 (red) [observed, solver only requires exactly 1 fg color]
  sprites:
    count: exactly 4
    bbox: each exactly 3x3
    connectivity: each is a single 8-connected component (may be multiple 4-connected parts)
    fg_pixels_per_sprite: 4-9 out of 9
  layout:
    arrangement: 2x2 grid of scattered sprites — two upper, two lower
    upper_lower_separation: when sorted by (row, col), sprite #2's top row < sprite #3's top row (clear row gap >= 3 empty rows between upper-bottom and lower-top)
    within_pair_col_separation: left sprite's right col < right sprite's left col (no col overlap within a pair)
    min_bbox_chebyshev_distance: >= 4 between any two sprite bboxes [observed, >= 2 required for 8-conn separation]
  rule: |
    Crop each sprite's 3x3 bbox, order as 2x2 (upper-left, upper-right, lower-left, lower-right),
    paste into 7x7 output at positions (0,0), (0,4), (4,0), (4,4) with 1 bg separator row/col.

generation_strategy:
  approach: output-first
  steps:
    1. Generate 4 random 3x3 binary sprites (fg/bg), each with 4-9 fg pixels, each 8-connected.
    2. Assemble 7x7 output by placing sprites at (0,0), (0,4), (4,0), (4,4) with bg separators.
    3. Choose input grid size uniformly in 16-23 x 16-23.
    4. Place 4 sprites in a 2x2 spatial arrangement on the input grid such that upper pair rows < lower pair rows with >= 3 row gap, within-pair columns don't overlap, and all pairwise bbox Chebyshev distance >= 4.
    5. Fill remaining cells with bg color.
