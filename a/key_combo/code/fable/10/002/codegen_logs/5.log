+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DOT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRECTIONS = ((1, 1), (1, -1), (-1, 1), (-1, -1))
+SIZE_MIN = 2
+SIZE_MAX = 6
+GRID_H_RANGE = (18, 29)
+GRID_W_RANGE = (18, 29)
+OBJECT_COUNT_CHOICES = (2, 3, 4)
