+def _render_output(shape: tuple[int, int], tasks: list[dict]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    for task in tasks:
+        r0, c0, r1, c1 = task["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(task["color"])
+    for task in tasks:
+        for r, c in task["line_cells"]:
+            out[r, c] = GREY
