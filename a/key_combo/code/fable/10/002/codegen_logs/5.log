+            {
+                "bbox": bbox,
+                "color": int(grid[dot_r, dot_c]),
+                "direction": info["direction"],
+                "size": info["size"],
+                "line_cells": info["line_cells"],
+                "dot": (dot_r, dot_c),
+                "square_cells": tuple(sorted(square_cells)),
+            }
+        )
+
+    return tasks
+
+
+def _render_output(shape: tuple[int, int], tasks: list[dict]) -> np.ndarray:
