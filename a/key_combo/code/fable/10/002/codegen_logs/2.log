+
+
+def _paint_cells(grid: np.ndarray, cells: list[tuple[int, int, int]]) -> None:
+    for r, c, color in cells:
+        grid[r, c] = int(color)
+
+
+def _make_partial_shape(
+    footprint: set[tuple[int, int]],
+    style: str,
+    rng: random.Random,
+) -> tuple[set[tuple[int, int]], int]:
+    if style == "heavy":
