{
  "type": "transform_in_place",
  "src": "isolated blue pixels inside 4-connected open regions separated by multi-cell blue wall segments and colored marker pixels",
  "transform": "for each region containing isolated blue pixels, count distinct colored markers touching the region in the 8-neighborhood; recolor those blue pixels to the unique majority marker color while preserving walls, markers, and bg"
}
</annotation>
<generation_spec>
