+
+def _wrong_no_rotation(
+    grid: np.ndarray,
+    row_segs: list[tuple[int, int]],
+    col_segs: list[tuple[int, int]],
+    template_rc: tuple[int, int],
+    template_mask: np.ndarray,
+) -> np.ndarray:
+    bg = _get_bg(grid)
