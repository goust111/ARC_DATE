+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+PALETTE = list(range(10))
+NON_GREY = [c for c in PALETTE if c != GREY]
+COLOR_DOTS = [c for c in PALETTE if c not in (GREY,)]
+
+GEN_RETRIES = 500
+GEN_SEMANTIC_CHECKS = 12
