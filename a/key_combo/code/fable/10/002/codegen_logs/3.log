+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        rows = [r for r in range(h) if np.all(grid[r, :] == color)]
+        cols = [c for c in range(w) if np.all(grid[:, c] == color)]
+        if rows and cols:
