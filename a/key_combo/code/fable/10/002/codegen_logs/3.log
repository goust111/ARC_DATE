GRID_W_MAX = 26
CUT_GAP_MIN = 4
CUT_GAP_MAX = 12
LAYOUT_LINE_COMBOS = [(1, 2), (2, 1), (1, 3), (3, 1), (2, 2), (1, 4), (4, 1)]

# Wall graph growth limits.
MARKER_COUNT_MIN = 9
