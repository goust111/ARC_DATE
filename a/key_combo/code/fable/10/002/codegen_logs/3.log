MARKERS_PER_COLOR_MAX = 6
COLOR_SOLVE_ATTEMPTS = 40
COLOR_BACKTRACK_CALL_LIMIT = 60000

# Region and dot population limits.
REGION_COUNT_MIN = 6
REGION_COUNT_MAX = 11
DOT_COUNT_MIN = 20
