+def _mask_to_coords(mask: np.ndarray, top: int = 0, left: int = 0) -> np.ndarray:
+    coords = np.argwhere(mask)
+    coords[:, 0] += int(top)
+    coords[:, 1] += int(left)
+    return coords
+
