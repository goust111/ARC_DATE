+        if (r0, c0, r1, c1) != (0, 0, h - 1, w - 1):
+            continue
+        if mask.sum() == h * w:
+            continue
+        border_count = 2 * h + 2 * w - 4
+        if (
+            int(mask[0, :].sum())
+            + int(mask[-1, :].sum())
+            + int(mask[1:-1, 0].sum())
+            + int(mask[1:-1, -1].sum())
+        ) == border_count:
