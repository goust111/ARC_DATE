+def _normalize(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    rel = np.asarray(coords, dtype=int) - np.min(coords, axis=0, keepdims=True)
+    order = np.lexsort((rel[:, 1], rel[:, 0]))
+    return tuple(map(tuple, rel[order]))
+
