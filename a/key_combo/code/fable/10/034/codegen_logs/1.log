0006: 
0007: # concepts:
0008: # holes, objects, distracters, topology, puzzle piece
0009: 
0010: # description:
0011: # In the input you will see multiple grey rectangular objects, each with a black hole inside of it. There are also monochromatic objects somewhere exactly the same shape as each hole, and random other distracter objects (distracters all the same color). 
0012: # To make the output, check to see if each non-distracter object perfectly fits inside the black hole inside of a gray object, like it is a puzzle piece. If it does, place it inside the black hole. If it doesn't, leave it where it is.
0013: 
0014: def main(input_grid):
0015:     """
0016:     Move each non-distractor puzzle piece into the matching black hole inside a gray object.
0017: 
0018:     Input structure:
0019:     - Gray rectangular objects contain black interior holes.
0020:     - Colored objects outside the rectangles may match those hole shapes.
0021:     - Distractor objects share the most common non-gray object color.
0022: 
0023:     Rule:
0024:     - Extract gray objects and their black interior masks.
0025:     - Treat the most common non-gray object color as the distractor color.
0026:     - For every other colored sprite, compare its mask to each hole mask and paste exact matches into the hole.
0027: 
0028:     Key insight:
0029:     - Fit is determined by binary shape equality, not by the piece color or its original position.
0030:     """
0031:     # Plan:
0032:     # 1. Parse the input into objects, sprites, and black holes inside the grey objects
0033:     # 2. Identify color of distracter objects.
0034:     # 3. Turn each object into a sprite
0035:     # 4. Check if each sprite can be moved into a black hole, and if so, move it there
0036:     
0037:     # Parse, separating greys from other objects
0038:     grey_input = input_grid.copy()
0039:     grey_input[input_grid != Color.GREY] = Color.BLACK
0040:     grey_objects = find_components(grey_input, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0041: 
0042:     # extracting a mask for the black region is tricky, because black is also the color of the background
0043:     # get the black region inside the object by getting the interior mask, then just the black pixels
0044:     interior_black_regions = [ object_interior(obj, background=Color.BLACK) & (obj == Color.BLACK)
0045:                                for obj in grey_objects ]
0046: 
0047:     not_grey_input = input_grid.copy()
0048:     not_grey_input[input_grid == Color.GREY] = Color.BLACK
0049:     not_grey_objects = find_components(not_grey_input, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0050: 
0051:     # Get the sprites
0052:     not_grey_sprites = []
0053:     for obj in not_grey_objects:
0054:         _b = bbox(obj != Color.BLACK)
0055:         if _b is None:
0056:             continue
0057:         not_grey_sprites.append(crop_bbox(obj, _b))
0058: 
0059:     # Get the color of the distracter objects
0060:     # This is the most common color of the non-grey objects
0061:     color_of_each_object = [ np.unique(obj[obj!=Color.BLACK])[0] for obj in not_grey_objects ]
0062:     distracter_color = max(set(color_of_each_object), key=color_of_each_object.count)
0063:     
0064:     # Check if each sprite perfectly fits in a black hole/black interior region
0065:     # do this by checking if it has the same shape as a black interior region
0066:     # if it does, place it there
0067:     output_grid = np.copy(input_grid)
0068:     for sprite, obj, color in zip(not_grey_sprites, not_grey_objects, color_of_each_object):
0069:         # Try to find a perfect fit (if it is not the distracter color)
0070:         if color == distracter_color:
0071:             continue
0072:         
0073:         for interior_obj_mask in interior_black_regions:
0074:             # check the sprite masks are the same, meaning that they have the same shape
0075:             # to convert a sprite to a mask you check if it is not background (black)
0076:             sprite_mask = sprite != Color.BLACK
0077:             # to convert an object to a spright you crop it
0078:             _b = bbox(interior_obj_mask)
0079:             if _b is None:
0080:                 continue
0081:             interior_sprite_mask = crop_bbox(interior_obj_mask, _b)
0082:             perfect_fit = np.array_equal(sprite_mask, interior_sprite_mask)
0083: 
0084:             if perfect_fit:
0085:                 # remove the object from its original location
0086:                 object_mask = obj != Color.BLACK
0087:                 output_grid[object_mask] = Color.BLACK
0088: 
0089:                 # place the sprite in the black hole by blitting it
0090:                 _b = bbox(interior_obj_mask)
0091:                 assert _b is not None
0092:                 interior_r, interior_c, _r1, _c1 = _b
0093:                 interior_width = _r1 - interior_r + 1
0094:                 interior_height = _c1 - interior_c + 1
0095:                 paste(output_grid, sprite, interior_r, interior_c, transparent=Color.BLACK, clip=True)
0096:                 break
0097: 
0098:     return output_grid            
0099:     
