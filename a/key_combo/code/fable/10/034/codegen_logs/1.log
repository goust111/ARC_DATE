+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PAYLOAD_COLORS = [RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]
+FRAME_PAD = 1
+GEN_ATTEMPTS = 400
