0008: # punching holes, geometric pattern
0009: 
0010: # description:
0011: # In the input you will see a grid with some rectangles. Each rectangle is three pixels along its short side, and is monochromatic.
0012: # To make the output, you should draw black pixels along the middle of each rectangle with a period of 2 starting one pixel in.
0013: # Effectively punching holes in the middle of each rectangle, skipping alternating pixels.
0014: 
0015: def main(input_grid):
0016:     """
0017:     Punch alternating black holes through the center line of each monochromatic 3-wide rectangle.
0018: 
0019:     Input structure:
0020:     - The grid contains one or more separated non-black monochromatic rectangles.
0021:     - Each rectangle has short side length 3 and an odd long side.
0022:     - Rectangles may be horizontal or vertical on a black background.
0023: 
0024:     Rule:
0025:     - Detect each rectangle and rotate vertical ones into a horizontal working orientation.
0026:     - Set every other pixel along the middle line, starting one pixel in, to black.
0027:     - Restore the original orientation and paste the edited rectangle back onto a black output.
0028: 
0029:     Key insight:
0030:     - The hole pattern is defined along the rectangle's long axis, so orientation is handled
0031:       by canonicalizing the rectangle before editing it.
0032:     """
0033:     # Plan:
0034:     # 1. Extract the rectangles from the input grid
0035:     # 2. Canonicalize the rectangles: ensure that they are horizontal (remember to rotate back otherwise)
0036:     # 3. Draw black pixels inside each rectangle (horizontally, skipping every other pixel)
0037:     # 4. Rotate the rectangle back if it was not originally horizontal
0038: 
0039:     # 1. Extract the rectangles from the input grid
0040:     rectangle_objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0041: 
0042:     output_grid = np.full_like(input_grid, Color.BLACK)
0043:     for rectangle_object in rectangle_objects:
0044:         # 2. Canonicalize the rectangle sprite
0045:         _b = bbox(rectangle_object != Color.BLACK)
0046:         assert _b is not None
0047:         original_r, original_c, _r1, _c1 = _b
0048:         width = _r1 - original_r + 1
0049:         height = _c1 - original_c + 1
0050:         # crop to convert object to sprite
0051:         _b = bbox(rectangle_object != Color.BLACK)
0052:         assert _b is not None
0053:         rectangle_sprite = crop_bbox(rectangle_object, _b)
0054: 
0055:         # Flip it to be horizontal if it isn't already
0056:         is_horizontal = width > height
0057:         if not is_horizontal:
0058:             rectangle_sprite = np.rot90(rectangle_sprite)
0059:             width, height = height, width
0060: 
0061:         # 3. Punch holes through the middle of the rectangle
0062:         # The inner row is y=height//2
0063:         for r in range(1, width, 2):
0064:             rectangle_sprite[r, height//2] = Color.BLACK
0065:         
0066:         # 4. Rotate back if it was originally vertical, and then draw it to the output grid
0067:         if not is_horizontal:
0068:             rectangle_sprite = np.rot90(rectangle_sprite, k=-1)
0069:         
0070:         # draw it back in its original location
0071:         paste(output_grid, rectangle_sprite, original_r, original_c, transparent=Color.BLACK, clip=True)
0072: 
0073:     return output_grid
