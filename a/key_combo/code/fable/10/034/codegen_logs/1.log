0057: def main(grid: np.ndarray) -> np.ndarray:
0058:     """
0059:     Fill each solid rectangle with a size-adjusted copy of the multicolor exemplar rectangle.
0060: 
0061:     Input structure
0062:     - The background separates several solid rectangular foreground objects.
0063:     - Exactly one rectangle is a multicolor exemplar; its four corners share the outer color.
0064:     - Every other foreground rectangle is solid and uses that same outer color.
0065: 
0066:     Rule
0067:     - Run-length encode the exemplar's identical rows and identical columns.
0068:     - In each axis, keep all boundary runs fixed and resize the single interior run:
0069:       choose the run whose representative line has the most colors, using unique
0070:       run width/height only for the degenerate equal-complexity stripe case.
0071:     - Replace each solid outer-color rectangle by the resulting stretched exemplar pattern.
0072: 
0073:     Key insight
0074:     - The exemplar is not scaled geometrically; only its interior row and column runs stretch while the visible bands stay fixed.
0075:     """
0076:     g = np.asarray(grid, dtype=int)
0077:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0078: 
0079:     bg = get_bg(g)
0080:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0081:     assert len(components) >= 2, "expected one exemplar and at least one target rectangle"
0082: 
0083:     regions: list[tuple[tuple[int, int, int, int], np.ndarray]] = []
0084:     for component in components:
0085:         b = component["bbox"]
0086:         patch = crop_bbox(g, b)
0087:         assert int(component["area"]) == bbox_h(b) * bbox_w(b), "components must be solid rectangles"
0088:         assert np.all(patch != bg), "component bbox must not contain background holes"
0089:         regions.append((b, patch))
0090: 
0091:     exemplar_regions = [(b, patch) for b, patch in regions if len(np.unique(patch)) > 1]
0092:     assert len(exemplar_regions) == 1, "expected exactly one multicolor exemplar"
0093:     exemplar_bbox, exemplar = exemplar_regions[0]
0094: 
0095:     outer = int(exemplar[0, 0])
0096:     corners = [exemplar[0, 0], exemplar[0, -1], exemplar[-1, 0], exemplar[-1, -1]]
0097:     assert all(int(corner) == outer for corner in corners), "exemplar corners must share outer color"
0098: 
0099:     out = g.copy()
0100:     for b, patch in regions:
0101:         if b == exemplar_bbox:
0102:             continue
0103:         colors = np.unique(patch)
0104:         assert len(colors) == 1 and int(colors[0]) == outer, "targets must be solid outer-color rectangles"
0105:         r0, c0, r1, c1 = b
0106:         out[r0 : r1 + 1, c0 : c1 + 1] = _stretch_pattern(exemplar, patch.shape)
0107: 
0108:     return out
