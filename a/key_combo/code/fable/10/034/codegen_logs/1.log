+
+def _corridor_until_edge(shape: tuple[int, int], gap: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = direction
+    rr, cc = gap[0] + dr, gap[1] + dc
+    cells = []
+    while in_bounds(shape, rr, cc):
+        cells.append((rr, cc))
+        rr += dr
+        cc += dc
+    return cells
