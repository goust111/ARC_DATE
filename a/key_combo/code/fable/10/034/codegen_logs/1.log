+    if r == r1:
+        return 1, 0
+    if c == c0:
+        return 0, -1
+    assert c == c1
+    return 0, 1
+
+
+def _frame_border_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
