+def _reserve_bbox(reserved: np.ndarray, bbox: tuple[int, int, int, int], pad: int = FRAME_PAD) -> None:
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(reserved.shape[0] - 1, r1 + pad)
+    cc1 = min(reserved.shape[1] - 1, c1 + pad)
+    reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
