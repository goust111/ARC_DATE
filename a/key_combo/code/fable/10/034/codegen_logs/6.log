+def _random_connected_mask(height: int, width: int, *, require_alternative: bool) -> np.ndarray | None:
+    area = height * width
+    min_fill = max(height + width - 2, (area + 1) // 2)
+    max_fill = area - 1
+    if min_fill > max_fill:
+        return None
