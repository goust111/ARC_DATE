+    max_canvas_w = min(22, 30 - (left_band_w + 1))
+    if min_canvas_h > max_canvas_h or min_canvas_w > max_canvas_w:
+        return None
+
+    canvas_h = int(RNG.integers(min_canvas_h, max_canvas_h + 1))
+    canvas_w = int(RNG.integers(min_canvas_w, max_canvas_w + 1))
+
