+TEMPLATE_COLOR = 2
+SEPARATOR_COLOR = 4
+SHADOW_COLOR = 5
+DISTRACTOR_COLORS = (1, 3, 6, 7, 8, 9)
+GEN_RETRIES = 400
+RNG = np.random.default_rng()
