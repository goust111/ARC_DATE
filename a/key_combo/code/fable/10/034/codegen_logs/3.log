+    mask = _block_mask(block)
+    colors = {int(v) for v in block[mask]}
+    assert len(colors) == 1, "each block must be monochrome"
+    return int(next(iter(colors)))
+
+
+def _edge_signature(block: np.ndarray, side: str) -> tuple[int, ...]:
+    mask = _block_mask(block)
+    if side == "left":
