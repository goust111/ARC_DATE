+def _extract_blocks(grid: np.ndarray) -> list[np.ndarray]:
+    sep = _find_separator(grid)
+    row_spans = _segments(grid.shape[0], _full_indices(grid, sep, axis=0))
+    col_spans = _segments(grid.shape[1], _full_indices(grid, sep, axis=1))
