#   orient -> (leading_kw, trailing_kw)
_ORIENT_KW = {"h": ("left", "right"), "v": ("top", "bottom")}


def _edge_sets(block: np.ndarray) -> dict[str, set[int]]:
    """Return sets of fg-pixel offsets on each edge of a 5x5 block."""
    mask = block != BG
