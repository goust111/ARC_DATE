+    color_short = sum(count if color == 8 else -count for count, color in zip(counts, colors))
+    input_short = _alt_sum([int(_block_mask(block).sum()) for block in input_blocks])
+    reverse_short = _alt_sum(list(reversed(counts)))
+    desc_short = _alt_sum([counts[i] for i in np.argsort([-v for v in counts])])
+    asc_short = _alt_sum([counts[i] for i in np.argsort(counts)])
