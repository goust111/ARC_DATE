+        return None
+
+    perm = list(range(n))
+    for _ in range(BLOCK_BUILD_ATTEMPTS):
+        random.shuffle(perm)
+        if perm != list(range(n)) and perm != list(reversed(range(n))) and perm[0] != 0:
