+        grid[:, c : c + BLOCK_SIZE] = block
+        c += BLOCK_SIZE
+        if i < len(blocks) - 1:
+            grid[:, c] = SEP
+            c += 1
+    return grid
+
+
+def _choose_signatures(n: int) -> tuple[list[tuple[int, ...]], tuple[int, ...], tuple[int, ...]]:
+    while True:
+        internal = random.sample(SIGNATURES, n - 1)
