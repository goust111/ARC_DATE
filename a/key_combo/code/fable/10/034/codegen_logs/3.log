+def _valid_chains(blocks: list[np.ndarray], *, use_sizes_only: bool = False) -> list[tuple[int, ...]]:
+    left = [_edge_signature(block, "left") for block in blocks]
+    right = [_edge_signature(block, "right") for block in blocks]
