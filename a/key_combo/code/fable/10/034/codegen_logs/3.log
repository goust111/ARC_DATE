+            if not (0 <= nr < BLOCK_SIZE and 0 <= nc < BLOCK_SIZE):
+                continue
+            if cell in forbidden or mask[nr, nc]:
+                continue
+            out.add(cell)
+    return list(out)
+
+
+def _make_mask(
+    left_sig: tuple[int, ...], right_sig: tuple[int, ...], target_area: int
+) -> np.ndarray | None:
