+import numpy as np
+
+
+BG = 0
+SEP = 5
+FG_COLORS = (2, 8)  # red, teal
+BLOCK_SIZE = 5
+MAX_GENERATE_ATTEMPTS = 500
+BLOCK_BUILD_ATTEMPTS = 60
+SIGNATURES = [
+    sig
+    for size in (1, 2)
+    for sig in itertools.combinations(range(BLOCK_SIZE), size)
