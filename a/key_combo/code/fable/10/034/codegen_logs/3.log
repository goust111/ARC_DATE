+            candidates.append((sep_count, color))
+    assert candidates, "failed to identify separator color"
+    candidates.sort(reverse=True)
+    return int(candidates[0][1])
+
+
+def _extract_blocks(grid: np.ndarray) -> list[np.ndarray]:
