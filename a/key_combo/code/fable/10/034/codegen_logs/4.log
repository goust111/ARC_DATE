+    return False
+
+
+def _pairwise_shortcuts(a: np.ndarray, b: np.ndarray, c: np.ndarray) -> Iterable[np.ndarray]:
+    yield a
+    yield b
+    yield c
+    yield a & b
+    yield a & c
+    yield b & c
+    yield np.logical_xor(a, b)
+    yield np.logical_xor(a, c)
+    yield np.logical_xor(b, c)
+    yield a | b
+    yield a | c
+    yield b | c
+
