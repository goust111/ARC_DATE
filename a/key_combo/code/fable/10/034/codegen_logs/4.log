        for r0 in _gen_shuffled(candidates):
            intervals.append((r0, r0 + h - 1))
            result = rec(i + 1)
            if result is not None:
                return result
            intervals.pop()
        return None

    for start in starts:
        intervals[:] = [(start, start + heights[0] - 1)]
        result = rec(1)
        if result is not None:
            return result
    return None


