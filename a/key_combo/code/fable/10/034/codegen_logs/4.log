+    c = _pattern_mask(pattern_grid, 0)
+    area = int(pattern_grid.size)
+    fills = [int(mask.sum()) for mask in (a, b, c)]
+    min_fill = max(3, area // 7)
+    max_fill = int(area * 0.7)
+    if any(fill < min_fill or fill > max_fill for fill in fills):
+        return False
