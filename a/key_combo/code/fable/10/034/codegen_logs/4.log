  "path": "straight outward ray perpendicular to the side containing the gap, continuing through black background to the grid edge",
  "trajectory": "paint the gap and ray pixels teal",
  "transform": "fill every blue frame's bbox interior teal and preserve the blue border pixels"
}
</annotation>
