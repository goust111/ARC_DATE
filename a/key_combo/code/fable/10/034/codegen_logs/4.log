+
+def _difference_patterns(
+    top_op: str,
+    bottom_op: str,
+    top_is_thick: bool,
+    alt_top_op: str,
+    alt_bottom_op: str,
+    alt_top_is_thick: bool,
+) -> set[int]:
+    return {
+        pid
+        for pid in range(8)
+        if _final_scalar(pid, top_op, bottom_op, top_is_thick)
+        != _final_scalar(pid, alt_top_op, alt_bottom_op, alt_top_is_thick)
+    }
