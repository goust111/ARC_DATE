+def _semantic_ok(pattern_grid: np.ndarray, top_op: str, bottom_op: str, top_is_thick: bool) -> bool:
+    a = _pattern_mask(pattern_grid, 2)
+    b = _pattern_mask(pattern_grid, 1)
+    c = _pattern_mask(pattern_grid, 0)
