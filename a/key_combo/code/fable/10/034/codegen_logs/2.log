+def _remove_solid(grid: np.ndarray, block: dict) -> np.ndarray:
+    alt = grid.copy()
+    top = int(block["top"])
+    left = int(block["left"])
+    alt[top : top + 2, left : left + 2] = BLACK
+    return alt
+
+
+def _validate_semantics(grid: np.ndarray, planned: dict[int, list[tuple[str, tuple[int, int]]]], blocks: list[dict]) -> bool:
+    try:
