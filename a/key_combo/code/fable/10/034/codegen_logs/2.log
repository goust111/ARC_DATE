+BLACK = 0
+RED = 2
+GREY = 5
+ORANGE = 7
+CYAN = 8
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+LEFT = {0: 3, 1: 0, 2: 1, 3: 2}
+RIGHT = {0: 1, 1: 2, 2: 3, 3: 0}
+OPPOSITE_TURN = {"L": "R", "R": "L"}
