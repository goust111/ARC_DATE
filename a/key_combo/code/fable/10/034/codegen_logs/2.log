+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2), "grey block must be 2x2"
+        assert coords.shape[0] == 4
+        key = (r0, c0)
+        blocks[key] = {"block_type": "solid", "top": r0, "left": c0}
+        for cell in _bbox_cells(r0, c0):
