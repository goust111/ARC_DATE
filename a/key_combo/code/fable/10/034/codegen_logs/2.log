  bridging_rule:
    for_each_pair: with horizontally separated columns AND overlapping row spans
    bridge: fill the gap rectangle (shared-row-span x column-gap) with MAROON
    blocking: skip if any third rectangle's bbox crosses both the gap columns and the shared row span
