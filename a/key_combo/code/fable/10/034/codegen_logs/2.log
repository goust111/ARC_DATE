+            max_k = min(MAX_SEG_LEN, max(shape))
+            k_choices = list(range(MIN_SEG_LEN, max_k + 1))
+            random.shuffle(k_choices)
+            for length in k_choices:
+                segment = _segment_cells(pos, dir_idx, length)
