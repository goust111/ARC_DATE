+    target_anchor: tuple[int, int] | None = None
+    for coords in comps:
+        vals = g[coords[:, 0], coords[:, 1]]
+        gray_locs = coords[vals == GRAY]
+        if gray_locs.shape == (1, 2) and coords.shape[0] > 1 and np.any(vals != GRAY):
