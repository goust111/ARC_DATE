+    local_anchor: tuple[int, int],
+    patch_shape: tuple[int, int],
+    grid_shape: tuple[int, int],
+) -> bool:
+    ar, ac = local_anchor
+    h, w = patch_shape
+    r, c = anchor_pos
+    return ar <= r <= grid_shape[0] - h + ar and ac <= c <= grid_shape[1] - w + ac
