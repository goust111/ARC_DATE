+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(_GRID_MIN, _GRID_MAX + 1))
+    w = int(rng.integers(_GRID_MIN, _GRID_MAX + 1))
