+
+def _mirrored_anchor(anchor: tuple[int, int], shape: tuple[int, int], axis: str) -> tuple[int, int]:
+    ar, ac = anchor
+    h, w = shape
+    if axis == "lr":
+        return ar, w - 1 - ac
+    return h - 1 - ar, ac
