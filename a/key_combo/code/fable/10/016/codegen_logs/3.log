+def enumerate_all_moves(
+    canvas: np.ndarray,
+    red_counts: dict[tuple[int, int], int],
+    remaining: list[dict],
+) -> list[dict]:
+    all_moves: list[dict] = []
+    for frontier, count in sorted(red_counts.items()):
+        if count == 1:
