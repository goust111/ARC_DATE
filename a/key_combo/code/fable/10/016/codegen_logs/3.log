+
+def frontier_coords(red_counts: dict[tuple[int, int], int]) -> list[tuple[int, int]]:
+    return [coord for coord, count in red_counts.items() if count == 1]
+
+
+def occupied_bbox(canvas: np.ndarray) -> tuple[int, int, int, int]:
