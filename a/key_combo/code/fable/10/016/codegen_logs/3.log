+def crop_non_bg(arr: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(arr != BG)
+    r0, c0, r1, c1 = bbox_coords(pts)
+    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def grid_key(arr: np.ndarray) -> tuple[tuple[int, int], bytes]:
