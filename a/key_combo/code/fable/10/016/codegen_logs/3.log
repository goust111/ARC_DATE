+    arr = np.zeros((h, w), dtype=int)
+    r0 = random.choice([1, h - 2])
+    c1 = random.choice([w - 3, w - 2])
+    turn_r = max(1, min(h - 2, r0 + (2 if r0 == 1 else -2)))
+    draw_path(arr, [(r0, 0), (r0, c1), (turn_r, c1)], color)
