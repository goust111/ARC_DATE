+
+def oriented_piece(attach_side: str, exit_side: str | None, color: int) -> np.ndarray | None:
+    for _ in range(80):
+        k = next(k for k in range(4) if rotate_side("left", k) == attach_side)
+        if exit_side is None:
+            base = canonical_leaf_left(color)
+        else:
+            base_exit = rotate_side(exit_side, (-k) % 4)
+            if base_exit == "right":
+                base = canonical_left_to_right(color)
+            elif base_exit == "top":
+                base = canonical_left_to_top(color)
+            elif base_exit == "bottom":
+                base = canonical_left_to_bottom(color)
+            else:
+                continue
+        arr = np.rot90(base, k).copy()
+        if len(unique_rotations(arr)) < 4:
+            continue
+        if exit_side is not None:
+            reds = np.argwhere(arr == RED)
+            if reds.shape[0] != 2:
+                continue
+            try:
+                red_coord_on_side(arr, attach_side)
+                red_coord_on_side(arr, exit_side)
+            except AssertionError:
+                continue
+        else:
+            if np.count_nonzero(arr == RED) != 1:
+                continue
+            try:
+                red_coord_on_side(arr, attach_side)
+            except AssertionError:
+                continue
+        return arr
+    return None
