+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(arr, k).copy()
+        key = grid_key(rot)
+        if key not in seen:
+            seen.add(key)
+            out.append((k, rot))
