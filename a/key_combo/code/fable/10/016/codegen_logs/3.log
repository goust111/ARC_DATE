+
+def flank_delta(side: str, kind: int) -> tuple[int, int]:
+    if side == "top":
+        return (0, 1) if kind == 0 else (0, -1)
+    if side == "right":
+        return (1, 0) if kind == 0 else (-1, 0)
+    if side == "bottom":
+        return (0, -1) if kind == 0 else (0, 1)
+    return (-1, 0) if kind == 0 else (1, 0)
