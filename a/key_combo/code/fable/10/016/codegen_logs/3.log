+def side_of_red(arr: np.ndarray, coord: tuple[int, int]) -> str:
+    r, c = coord
+    if r == 0:
+        return "top"
+    if r == arr.shape[0] - 1:
+        return "bottom"
+    if c == 0:
+        return "left"
+    if c == arr.shape[1] - 1:
+        return "right"
+    raise AssertionError("red connector must lie on the boundary")
