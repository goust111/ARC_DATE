+    nxt = canvas.copy()
+    nxt_sub = nxt[top : top + h, left : left + w]
+    nxt_sub[mask] = arr[mask]
+    return nxt, next_counts
+
+
+def enumerate_moves_for_frontier(
+    canvas: np.ndarray,
+    red_counts: dict[tuple[int, int], int],
+    remaining: list[dict],
+    frontier: tuple[int, int],
