+        if not stamp_flank(anchor, anchor_side, red_coord_on_side(anchor, anchor_side), frontier_kind, YELLOW):
+            continue
+        ah, aw = anchor.shape
+        ar0 = hidden_H // 2 - ah // 2
+        ac0 = hidden_W // 2 - aw // 2
+        placed = place_at(out, anchor, ar0, ac0)
