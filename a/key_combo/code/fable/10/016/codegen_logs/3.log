+def place_at(canvas: np.ndarray, arr: np.ndarray, top: int, left: int) -> np.ndarray | None:
+    h, w = arr.shape
+    H, W = canvas.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return None
+    sub = canvas[top : top + h, left : left + w]
