+        crop = out[r0 : r1 + 1, c0 : c1 + 1].copy()
+        ch, cw = crop.shape
+        min_h = max(GRID_RANGE[0], ch + 8)
+        min_w = max(GRID_RANGE[0], cw + 8)
+        if min_h > GRID_RANGE[1] or min_w > GRID_RANGE[1]:
+            continue
