+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+CLOCKWISE = {"top": "right", "right": "bottom", "bottom": "left", "left": "top"}
+COUNTERCLOCKWISE = {"top": "left", "left": "bottom", "bottom": "right", "right": "top"}
