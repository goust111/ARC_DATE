+                left = tc - cc
+                dedup_key = (idx, arr_key, int(top), int(left))
+                if dedup_key in seen:
+                    continue
+                seen.add(dedup_key)
+                applied = apply_move(canvas, red_counts, arr, int(top), int(left), frontier)
+                if applied is None:
