+            if reds.shape[0] != 2:
+                continue
+            try:
+                red_coord_on_side(arr, attach_side)
+                red_coord_on_side(arr, exit_side)
+            except AssertionError:
+                continue
+        else:
+            if np.count_nonzero(arr == RED) != 1:
+                continue
+            try:
+                red_coord_on_side(arr, attach_side)
+            except AssertionError:
+                continue
