+                    "k": k,
+                    "arr": rot,
+                    "reds": [tuple(map(int, rc)) for rc in np.argwhere(rot == RED)],
+                }
+                for k, rot in unique_rotations(arr)
+            ],
+            "reds": [tuple(map(int, rc)) for rc in np.argwhere(arr == RED)],
+            "is_anchor": contains_yellow_3x3(arr),
