+def stamp_flank(arr: np.ndarray, side: str, coord: tuple[int, int], kind: int, color: int) -> bool:
+    dr, dc = flank_delta(side, kind)
+    rr = coord[0] + dr
+    cc = coord[1] + dc
+    if not (0 <= rr < arr.shape[0] and 0 <= cc < arr.shape[1]):
+        return False
+    if arr[rr, cc] == RED:
+        return False
+    arr[rr, cc] = color
+    return True
