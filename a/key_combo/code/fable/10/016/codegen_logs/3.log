+def apply_move(
+    canvas: np.ndarray,
+    red_counts: dict[tuple[int, int], int],
+    arr: np.ndarray,
+    top: int,
+    left: int,
+    frontier: tuple[int, int],
+) -> tuple[np.ndarray, dict[tuple[int, int], int]] | None:
+    h, w = arr.shape
+    H, W = canvas.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return None
