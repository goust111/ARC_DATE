+    next_counts = dict(red_counts)
+    for pr, pc in np.argwhere(arr == RED):
+        coord = (int(top + pr), int(left + pc))
+        if next_counts.get(coord, 0) >= 2:
+            return None
+        next_counts[coord] = next_counts.get(coord, 0) + 1
