+    r0 = random.choice([h - 2, h - 3])
+    c1 = random.randint(2, w - 3)
+    draw_path(arr, [(r0, 0), (r0, c1), (0, c1)], color)
+    nub_c = max(1, c1 - random.randint(1, min(2, c1)))
+    nub_r = min(h - 1, r0 + 1)
+    arr[nub_r, nub_c] = color
+    arr[r0, 0] = RED
+    arr[0, c1] = RED
+    if not stamp_flank(arr, "left", (r0, 0), left_kind, color):
