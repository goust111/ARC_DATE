+def red_coord_on_side(arr: np.ndarray, side: str) -> tuple[int, int]:
+    matches = []
+    for r, c in np.argwhere(arr == RED):
+        r = int(r)
+        c = int(c)
+        if side == "top" and r == 0:
+            matches.append((r, c))
+        elif side == "bottom" and r == arr.shape[0] - 1:
+            matches.append((r, c))
+        elif side == "left" and c == 0:
+            matches.append((r, c))
+        elif side == "right" and c == arr.shape[1] - 1:
+            matches.append((r, c))
