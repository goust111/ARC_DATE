+
+def canonical_left_to_top(color: int) -> np.ndarray:
+    h = random.randint(5, 7)
+    w = random.randint(5, 7)
+    arr = np.zeros((h, w), dtype=int)
+    r0 = random.choice([h - 2, h - 3])
+    c1 = random.choice([max(2, w - 3), w - 2])
