+            candidates: list[tuple[np.ndarray, np.ndarray, dict[tuple[int, int], int], int, int, str | None]] = []
+
+            exit_options = [None] if degree == 1 else [side for side in SIDES if side != attach_side]
+            random.shuffle(exit_options)
+            for exit_side in exit_options:
