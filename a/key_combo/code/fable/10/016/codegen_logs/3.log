+
+def canonical_left_to_bottom(color: int) -> np.ndarray:
+    arr = np.flipud(canonical_left_to_top(color)).copy()
+    return arr
+
+
+def canonical_leaf_left(color: int) -> np.ndarray:
+    h = random.randint(5, 7)
+    w = random.randint(5, 7)
+    arr = np.zeros((h, w), dtype=int)
+    r0 = random.choice([1, h - 2])
+    c1 = random.choice([w - 3, w - 2])
