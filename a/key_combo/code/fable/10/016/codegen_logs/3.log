+    if side == "bottom":
+        cols = list(range(1, w - 1)) or list(range(w))
+        return h - 1, random.choice(cols)
+    if side == "left":
+        rows = list(range(1, h - 1)) or list(range(h))
+        return random.choice(rows), 0
