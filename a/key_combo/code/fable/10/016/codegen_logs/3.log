+def anchor_array() -> np.ndarray:
+    arr = np.zeros((5, 5), dtype=int)
+    arr[1:4, 1:4] = YELLOW
+    side = random.choice(SIDES)
+    if side == "top":
+        arr[0, 2] = RED
+    elif side == "bottom":
+        arr[4, 2] = RED
+    elif side == "left":
+        arr[2, 0] = RED
+    else:
