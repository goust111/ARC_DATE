+        piece = {
+            "id": idx,
+            "bbox": (int(r0), int(c0), int(r1), int(c1)),
+            "arr": arr,
+            "rots": [
+                {
+                    "k": k,
+                    "arr": rot,
+                    "reds": [tuple(map(int, rc)) for rc in np.argwhere(rot == RED)],
+                }
+                for k, rot in unique_rotations(arr)
