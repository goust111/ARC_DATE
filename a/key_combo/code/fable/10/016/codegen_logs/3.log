+                    if piece is None:
+                        continue
+                    attach_r, attach_c = red_coord_on_side(piece, attach_side)
+                    top = frontier[0] - attach_r
+                    left = frontier[1] - attach_c
+                    applied = apply_move(out, red_counts, piece, top, left, frontier)
+                    if applied is None:
+                        continue
+                    nxt, next_counts = applied
+                    next_frontiers = frontier_coords(next_counts)
+                    if degree == 2 and len(next_frontiers) != 1:
+                        continue
+                    if degree == 1 and next_frontiers:
+                        continue
+                    bbox = occupied_bbox(nxt)
+                    if bbox[2] - bbox[0] + 1 > max_span or bbox[3] - bbox[1] + 1 > max_span:
+                        continue
+                    if rem_after > 0 and margin_to_edge((hidden_H, hidden_W), next_frontiers[0]) < 6:
+                        continue
+                    candidates.append((piece, nxt, next_counts, top, left, exit_side))
+                if candidates:
