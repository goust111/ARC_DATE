+def greedy_unique_rebuild(inp: np.ndarray, expected: np.ndarray) -> bool:
+    anchor, remaining = extract_pieces(inp)
+    H, W = inp.shape
+    canvas = np.zeros((H, W), dtype=int)
+    ar0, ac0, _, _ = anchor["bbox"]
+    canvas = place_at(canvas, anchor["arr"], ar0, ac0)
