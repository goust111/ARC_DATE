+
+        def extend(
+            cur: np.ndarray,
+            counts: dict[tuple[int, int], int],
+            cur_frontier_side: str,
+            idx: int,
+            acc: list[dict],
+            history: list[tuple[np.ndarray, dict[tuple[int, int], int]]],
