+                        "piece_id": piece["id"],
+                        "rot_k": rot["k"],
+                        "arr": arr,
+                        "top": int(top),
+                        "left": int(left),
+                        "canvas": nxt,
+                        "red_counts": next_counts,
+                    }
+                )
+    out.sort(key=lambda m: (m["piece_id"], m["rot_k"], m["top"], m["left"]))
+    return out
+
+
+def enumerate_all_moves(
+    canvas: np.ndarray,
+    red_counts: dict[tuple[int, int], int],
+    remaining: list[dict],
+) -> list[dict]:
+    all_moves: list[dict] = []
+    for frontier, count in sorted(red_counts.items()):
+        if count == 1:
