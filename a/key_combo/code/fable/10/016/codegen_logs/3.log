+    sub = canvas[top : top + h, left : left + w]
+    mask = arr != BG
+    overlap_pts = np.argwhere(mask & (sub != BG))
+    if overlap_pts.shape[0] != 1:
+        return None
+    rr, cc = map(int, overlap_pts[0])
