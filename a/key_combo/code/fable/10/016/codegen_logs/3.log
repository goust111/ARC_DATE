+    anchors = [p for p in pieces if p["is_anchor"]]
+    assert len(anchors) == 1, "expected exactly one anchor piece containing a 3x3 yellow block"
+    anchor = anchors[0]
+    rest = [p for p in pieces if p is not anchor]
+    return anchor, rest
