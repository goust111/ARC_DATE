+
+
+def oriented_piece(
+    attach_side: str,
+    exit_side: str | None,
+    color: int,
+    attach_kind: int,
+    exit_kind: int | None,
+) -> np.ndarray | None:
+    for _ in range(40):
+        k = next(k for k in range(4) if rotate_side("left", k) == attach_side)
+        if exit_side is None:
+            base = canonical_leaf_left(color, attach_kind)
