+    def dfs(cur: np.ndarray, rem: list[dict], counts: dict[tuple[int, int], int]) -> None:
+        if len(solutions) >= 2:
+            return
+        if not rem:
+            if counts and all(v == 2 for v in counts.values()):
+                solutions[grid_key(cur)] = cur.copy()
+            return
