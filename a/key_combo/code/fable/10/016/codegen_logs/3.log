+    rr = coord[0] + dr
+    cc = coord[1] + dc
+    if not (0 <= rr < arr.shape[0] and 0 <= cc < arr.shape[1]):
+        return False
+    if arr[rr, cc] == RED:
+        return False
+    arr[rr, cc] = color
+    return True
