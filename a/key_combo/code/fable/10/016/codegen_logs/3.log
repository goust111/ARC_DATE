+    arr[r1, w - 1] = RED
+    if not stamp_flank(arr, "left", (r0, 0), left_kind, color):
+        return None
+    if not stamp_flank(arr, "right", (r1, w - 1), right_kind, color):
+        return None
+    return crop_non_bg(arr)
