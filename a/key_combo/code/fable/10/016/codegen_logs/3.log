+
+def build_output() -> tuple[np.ndarray, list[dict]]:
+    for _ in range(GEN_RETRIES):
+        H = random.randint(*GRID_RANGE)
+        W = random.randint(*GRID_RANGE)
+        n_pieces = random.randint(*PIECE_COUNT_RANGE)
