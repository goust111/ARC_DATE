    for i, cell in enumerate(gap):
        allowed = {visible} if i == 0 else set()
        if any(nbr in path_cells and nbr not in allowed for nbr in neighbors4(*cell)):
            return None
    if _gen_min_distance({marker}, path_cells) < _GEN_MIN_OBJECT_DISTANCE:
        return None
    return gap, marker


