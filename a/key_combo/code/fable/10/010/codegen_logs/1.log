    work = grid if axis == 0 else grid.T
    return any(np.array_equal(work[i - 1], work[i]) for i in range(1, work.shape[0]))


def _has_adjacent_compatible(grid: np.ndarray, axis: int) -> bool:
    work = grid if axis == 0 else grid.T
