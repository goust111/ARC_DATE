+def _compress_axis(grid: np.ndarray, axis: int) -> np.ndarray:
+    work = grid if axis == 0 else grid.T
+    merged: list[np.ndarray] = []
+    rep = work[0].copy()
+
+    for idx in range(1, work.shape[0]):
+        line = work[idx]
+        if _compatible_line(rep, line):
