+def _child_candidates(parent: dict, direction: tuple[int, int], size: int, h: int, w: int) -> list[tuple[int, int]]:
+    pr0, pc0, ps = parent["r0"], parent["c0"], parent["size"]
+    pr1, pc1 = pr0 + ps - 1, pc0 + ps - 1
+    pmr = pr0 + ps // 2
+    pmc = pc0 + ps // 2
+    out = []
+    if direction == (-1, 0):
+        row_choices = range(0, pr0 - size - 1 + 1)
