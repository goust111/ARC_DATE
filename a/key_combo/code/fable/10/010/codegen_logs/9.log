+        row_lo = max(0, pmr - size + 1)
+        row_hi = min(h - size, pmr)
+        for c0 in col_choices:
+            gap = pc0 - (c0 + size)
+            if gap < 2:
+                continue
+            for r0 in range(row_lo, row_hi + 1):
+                out.append((r0, c0))
