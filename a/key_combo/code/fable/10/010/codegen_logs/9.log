+    return None
+
+
+def _collect_known_boundary_rays(
+    rec: dict,
+    child_map: dict,
+    placed: list[dict],
+    occupied: set[tuple[int, int]],
+    h: int,
+    w: int,
+    start: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    out: list[tuple[int, int]] = []
+    seen = set(occupied)
+    for direction in DIRS:
+        if direction in child_map:
+            continue
+        cells = _boundary_ray_cells(rec, direction, h, w)
+        if start in cells:
