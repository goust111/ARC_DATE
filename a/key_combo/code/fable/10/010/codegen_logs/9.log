+ACTIVE_CHOICES = [1, 2, 3, 4, 5]
+ACTIVE_WEIGHTS = [1, 3, 4, 3, 2]
+DISTRACTOR_CHOICES = [0, 1, 2]
+DISTRACTOR_WEIGHTS = [2, 4, 2]
