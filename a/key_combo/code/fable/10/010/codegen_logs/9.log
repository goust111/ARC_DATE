def _path_between(parent: dict, child: dict, direction: tuple[int, int]) -> list[tuple[int, int]] | None:
    dr, dc = direction
    r, c = _midpoint(parent, direction)
    r += dr
    c += dc
    child_border = set(_border_cells(child))
    out = []
    guard = parent["size"] + child["size"] + 70
