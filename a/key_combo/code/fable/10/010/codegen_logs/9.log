+            continue
+        if not _reserve_known_boundary_rays(rec, child_children, placed + [rec], reserved_rays | set(path), h, w, start):
+            continue
+        return rec, path
+    return None
+
+
+def _place_distractor(
+    h: int,
+    w: int,
+    placed: list[dict],
+    forbidden: set[tuple[int, int]],
+    start: tuple[int, int],
+    border: int,
+    inner: int,
+) -> dict | None:
+    candidates = []
+    for size in random.sample(SIZE_CHOICES, k=len(SIZE_CHOICES)):
