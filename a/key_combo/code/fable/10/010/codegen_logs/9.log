+
+
+def _pick_start(record: dict, h: int, w: int) -> tuple[int, int] | None:
+    cands = []
+    r0, c0, size = record["r0"], record["c0"], record["size"]
+    r1, c1 = r0 + size - 1, c0 + size - 1
+    mid = size // 2
