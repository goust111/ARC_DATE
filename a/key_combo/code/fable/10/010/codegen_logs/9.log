MAX_BLOB_COUNT = 4                 # chain + distractors combined
MAX_DISTRACTORS = 1

# --- Placement ---
MIN_GAP_FIRST = 4   # along-axis gap between start and first blob
MIN_GAP_CHAIN = 3   # along-axis gap between successive chain blobs

