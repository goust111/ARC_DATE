+def _recolor_extreme_regions(connected_grid: np.ndarray) -> tuple[np.ndarray, list[int]]:
+    g = np.asarray(connected_grid, dtype=int)
+    bg = _get_bg(g)
+    regions = _background_regions(g, bg)
