    g=np.full((n,n),bg,int)
    min_gap=s+2+random.randint(0,2)
    if side=='left': lo,hi=s+2,n-s-1
    else: lo,hi=0,n-2*s-2
    upper=hi-(min_gap-1)*(k-1)
    if upper < lo + k - 1: return None
    bases=sorted(random.sample(range(lo, upper+1), k))
    params=[b+i*(min_gap-1) for i,b in enumerate(bases)]
    for color,a in zip(colors,params):
      g[0:s,a:a+s]=color
      if side=='left':
        g[a:a+s,0:s]=color
      else:
