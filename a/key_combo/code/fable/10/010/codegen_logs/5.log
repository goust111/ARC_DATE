        for comp in comps(g==color):
            rs=[p[0] for p in comp]; cs=[p[1] for p in comp]
            box=(min(rs),min(cs),max(rs),max(cs))
            cl.append({'color':color,'coords':comp,'bbox':box,'area':len(comp)})
        out.extend(cl)
    return out

