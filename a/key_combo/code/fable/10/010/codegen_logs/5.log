spec:
  grid: 16x16, background color 7
  foreground_pairs: 3-5 distinct colors, each appearing as exactly 2 same-size solid rectangles
  rectangle_sizes:
    per_pair: both rectangles identical; either 2x2 or 3x3
    mix: 1 pair is 3x3, rest are 2x2 [observed]
  pair_geometry:
    vertical_separation: upper rect bottom row < lower rect top row (no row overlap)
    horizontal_separation: column ranges do not overlap (diagonally offset)
    facing_corners: the nearest corners of the two rects lie on an exact 45-degree diagonal
    diagonal_gap: 2-6 pixels between facing corners (exclusive of endpoints)
