    return [int(v) for v in np.unique(g) if int(v) not in ex]

def comps(mask):
    H,W=mask.shape; seen=np.zeros((H,W),bool); out=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                q=deque([(r,c)]); seen[r,c]=1; cur=[]
                while q:
                    x,y=q.popleft(); cur.append((x,y))
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        xx,yy=x+dx,y+dy
