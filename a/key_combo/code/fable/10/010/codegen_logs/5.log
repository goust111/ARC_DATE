+def _background_regions(grid: np.ndarray, bg: int | None = None) -> list[np.ndarray]:
+    bg_color = _get_bg(grid) if bg is None else int(bg)
+    return _components_from_mask(np.asarray(grid, dtype=int) == bg_color)
+
