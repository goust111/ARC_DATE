        r0,c0,r1,c1=box
        if len(comp)!=(r1-r0+1)*(c1-c0+1): raise AssertionError
        boxes.append(box)
      boxes.sort(key=lambda b:(b[0],b[1]))
      start,end=facing(*boxes)
      dc=1 if end[1]>start[1] else -1
      rr,cc=start[0]+1,start[1]+dc; seg=[]
      while (rr,cc)!=end:
        if out[rr,cc]!=bg: raise AssertionError
        out[rr,cc]=color; seg.append((rr,cc)); rr+=1; cc+=dc
      segs.append((color,seg))
    return out,segs

def fill_extremes(connected):
    bg=get_bg(connected); out=connected.copy(); regs=comps(connected==bg); areas=[len(r) for r in regs]
    if min(areas)==max(areas): raise AssertionError
    mn,mx=min(areas),max(areas)
    for reg in regs:
      color=FILL_MIN if len(reg)==mn else FILL_MAX if len(reg)==mx else None
      if color is not None:
        for r,c in reg: out[r,c]=color
    return out,areas

def solve(g):
    conn,segs=connect_only(g)
    out,areas=fill_extremes(conn)
    return out,conn,segs,areas

def make_candidate():
    n=random.randint(20,30)
    side=random.choice(['"'left','right'])
    s=random.choice([2,3])
    k=random.randint(3,5)
    bg=random.choice([0,5,7])
