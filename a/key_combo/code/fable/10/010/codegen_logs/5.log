        if color2==color: continue
        for r,c in seg2: alt[r,c]=color2
      try:
        alt_out,_=fill_extremes(alt)
      except AssertionError:
        continue
      if np.array_equal(alt_out,out): return None
    return g,out,areas,side,s,k,n,params

