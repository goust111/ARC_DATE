BARRIER_WIDTH_MAX, BARRIER_LANE_WIDTH, BARRIER_MIN_GAP = 12, 2, 1
BARRIER_MIN_MOVES_PER_PATH, BARRIER_MAX_MOVES_PER_PATH = 1, 5
