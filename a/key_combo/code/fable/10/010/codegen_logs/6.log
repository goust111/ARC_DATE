  "type": "move_along_path",
  "src": "non-border 8-connected foreground objects matching a full-width border bar color",
  "path": "vertical path toward the same-color top or bottom border bar",
  "dst": "touch the same-color border bar",
  "trajectory": "translate each object to the adjacent row of that bar; a downward one-column segment whose landing overlaps its source fills the continuous swept segment",
  "transform": "redraw the border bars and moved objects on the bg"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 16x16 (all examples identical)
  colors: exactly 3 — bg=7, top_bar color, bottom_bar color (all distinct, non-7)
  bars:
    top: row 0 filled with top_color
    bottom: row H-1 filled with bottom_color
  objects:
    count: 3-5 per color, 6-9 total
    color: matches exactly one bar (top or bottom)
    connectivity: 8-connected monochrome
    bbox: 1x1 to 4x5, area 1-6 pixels, density 0.33-1.0
    placement: entirely within interior rows [1, H-2]
    shapes: irregular small sprites, no consistent symmetry [observed]
  non_overlap:
    input: objects may share rows across colors but not pixels; in every column, all top-color pixels must be above all bottom-color pixels (no path crossing)
    output: after sliding, same-color objects must not collide pixel-wise
    output_zones: top-zone and bottom-zone have >=5 empty bg rows between them
  swept_segment:
    applies only to bottom-color single-column objects where move distance < object height
    fills continuous column from original top row to final bottom row
    rare — only 1 instance across all examples
  transform:
    top-colored objects slide up so bbox top = row 1
    bottom-colored objects slide down so bbox bottom = row H-2
    columns and shape preserved; only vertical translation

generation_strategy:
  approach: output-first
  steps:
    1. Pick 3 distinct colors for bg (7), top_bar, bottom_bar.
    2. Build output grid (16x16) with bars at rows 0 and H-1.
    3. Place 3-5 top-color objects touching row 1, 3-5 bottom-color objects
       touching row H-2. Use small random sprites (area 1-6, bbox <=4x5).
       Ensure no pixel collisions and >=5 empty rows separating the two zones.
    4. Derive input by sliding each top object down by a random offset (1-9 rows)
       and each bottom object up by a random offset (1-9 rows), keeping all
       within interior rows [1, H-2]. Verify no pixel collisions in input.
    5. Optionally include one single-column bottom object placed so the swept
       segment case triggers (source overlaps destination).
