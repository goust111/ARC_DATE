+        sprite[0, 0] = 0
+        sprite[0, 1] = 0
+        sprite[-1, -2] = 0
+        sprite[-1, -1] = 0
+    assert _count_holes(sprite.astype(bool)) == 0
+    return sprite
+
+
+def _small_sprite(hole_count: int, rng: np.random.Generator) -> np.ndarray:
+    sprite = np.ones((5, 5), dtype=np.uint8)
+    choices = {
+        1: [
