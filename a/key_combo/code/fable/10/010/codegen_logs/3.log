+import numpy as np
+from collections import deque
+
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BG = 0
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            coords = []
+
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        queue.append((nr, nc))
+
+            coord_arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": coord_arr,
+                    "bbox": _bbox_from_coords(coord_arr),
+                    "area": int(coord_arr.shape[0]),
+                }
+            )
+
+    return components
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    queue = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                queue.append((nr, nc))
+
+    holes = 0
+    seen = exterior.copy()
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            holes += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                cr, cc = queue.popleft()
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+    return holes
+
+
+def _scale_mask(mask: np.ndarray, factor: int) -> np.ndarray:
+    return np.kron(mask.astype(np.uint8), np.ones((factor, factor), dtype=np.uint8)).astype(bool)
+
+
+def _rects_with_gap_disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
+
+
+def _paint_binary_sprite(grid: np.ndarray, sprite: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = sprite.shape
+    region = grid[top : top + h, left : left + w]
+    region[sprite.astype(bool)] = int(color)
+
+
+def _plain_shared_sprite(hole_count: int, tall: bool, rng: np.random.Generator) -> np.ndarray:
+    if tall:
+        sprite = np.ones((5, 7), dtype=np.uint8)
+        choices = {
+            1: [
+                [(2, 2, 2, 3)],
