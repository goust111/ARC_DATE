+
+        cropped, shifted_specs = _crop_canvas(canvas, specs, rng)
+        try:
+            _validate_instance(cropped, shifted_specs)
+        except AssertionError:
+            continue
+        return cropped
+    raise RuntimeError("failed to generate a valid puzzle instance")
