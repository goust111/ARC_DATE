+        scaled = _scale_mask(local_mask, k)
+        h, w = scaled.shape
+        assert r0 + h <= g.shape[0] and c0 + w <= g.shape[1], "scaled object must stay in bounds"
+        region = out[r0 : r0 + h, c0 : c0 + w]
+        assert not np.any(region[scaled] != bg), "scaled objects must not overlap"
+        region[scaled] = color
+
+    return out

