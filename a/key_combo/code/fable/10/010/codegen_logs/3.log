+        },
+        {
+            "name": "plain_b",
+            "family": "plain_shared",
+            "role": "same_shape_high",
+            "k": 3,
+            "sprite": _plain_shared_sprite(3, tall_plain, rng),
+            "color": colors[1],
+        },
+        {
+            "name": "tabbed",
+            "family": "tabbed",
+            "role": "same_holes_diff_shape",
+            "k": duplicate_k,
