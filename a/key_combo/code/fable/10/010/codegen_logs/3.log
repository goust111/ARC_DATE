+    return sprite
+
+
+def _small_sprite(hole_count: int, rng: np.random.Generator) -> np.ndarray:
+    sprite = np.ones((5, 5), dtype=np.uint8)
+    choices = {
+        1: [
+            [(2, 2, 2, 2)],
+            [(1, 2, 3, 2)],
+        ],
+        2: [
+            [(1, 1, 1, 1), (3, 3, 3, 3)],
+            [(1, 3, 1, 3), (3, 1, 3, 1)],
+        ],
+        3: [
+            [(1, 1, 1, 1), (1, 3, 1, 3), (3, 2, 3, 2)],
+        ],
