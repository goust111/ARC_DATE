+    grid: np.ndarray, cell: tuple[int, int], colors: list[int], forbidden: set[tuple[int, int]]
+) -> bool:
+    r, c = cell
+    if (r, c) in forbidden:
+        return False
+    if int(grid[r, c]) != _get_bg(grid):
+        return False
+    color = _choose_obstacle_color(grid, r, c, colors)
