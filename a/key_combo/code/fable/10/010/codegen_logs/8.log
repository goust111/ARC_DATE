+        "axis": axis,
+        "center": (center_r, center_c),
+        "control": control,
+        "ray": ray,
+        "blank_rows": blank_rows,
+        "blank_cols": blank_cols,
+        "pos_lines": pos_lines,
+        "neg_lines": neg_lines,
+        "parallel_lines": parallel_lines,
