  64:         col_delta = int(end[1] - start[1])
  65:         assert row_delta > 0, "connector must go downward from the upper rectangle"
  66:         assert abs(row_delta) == abs(col_delta), "facing corners must be diagonally aligned"
  67: 
  68:         dr = 1
