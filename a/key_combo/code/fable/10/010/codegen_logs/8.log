+def _sample_spaced(candidates: list[int], count_range: tuple[int, int]) -> list[int] | None:
+    counts = list(range(count_range[0], count_range[1] + 1))
+    random.shuffle(counts)
+    for want in counts:
+        if want == 0:
+            return []
+        for _ in range(80):
