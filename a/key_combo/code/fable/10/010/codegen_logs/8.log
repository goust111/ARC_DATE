+def _apply_stamps(
+    grid: np.ndarray,
+    centers: list[tuple[int, int]],
+    stamp_color: int,
+    bg: int,
+    *,
+    only_bg: bool,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+    for r, c in centers:
+        for rr in range(r - 1, r + 2):
