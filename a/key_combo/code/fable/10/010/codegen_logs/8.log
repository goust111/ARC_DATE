+        return [(r, center[1]) for r in rows if (r - center[0]) * ray[0] > 0]
+    cols = _blank_cols(grid, bg)
+    return [(center[0], c) for c in cols if (c - center[1]) * ray[1] > 0]
+
+
+def _apply_stamps(
+    grid: np.ndarray,
+    centers: list[tuple[int, int]],
+    stamp_color: int,
+    bg: int,
+    *,
+    only_bg: bool,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
