+    while q:
+        r, c = q.popleft()
+        out.append((r, c))
+        for dr, dc in ORTH4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in seen and int(grid[rr, cc]) == color:
+                seen.add((rr, cc))
+                q.append((rr, cc))
+    return out
+
