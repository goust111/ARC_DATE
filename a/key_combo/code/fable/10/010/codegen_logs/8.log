+                    controls.append((rr, cc))
+            if len(controls) != 1:
+                continue
+            control = controls[0]
+            ray = (center[0] - control[0], center[1] - control[1])
+            candidates.append(
+                {
+                    "bar_color": bar_color,
+                    "control_color": int(g[control]),
+                    "center": center,
+                    "control": control,
+                    "ray": ray,
+                    "axis": axis,
+                }
+            )
