        sprite = object_by_width[width]["sprite"]
        h, w = sprite.shape
        assert h == 2
        assert w == width
        top = shelf - h + 1
        assert top >= 0
        assert np.all(out[top : shelf + 1, start : end + 1] == bg)
        out[top : shelf + 1, start : end + 1] = sprite

    return out

