+    wall_r = top_space
+    wall_c = left_space
+    grid[wall_r : wall_r + wall_h, wall_c : wall_c + wall_w] = wall_patch
+
+    for zone, patch in assign.items():
+        ph, pw = patch.shape
+        if zone == "top":
+            r0 = rng.randint(1, top_space - ph - 1)
