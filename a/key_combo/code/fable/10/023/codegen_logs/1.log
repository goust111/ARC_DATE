+    body: tuple[tuple[int, int], ...],
+    lock: tuple[int, int],
+) -> set[tuple[tuple[tuple[int, int], ...], tuple[int, int]]]:
+    return {_transform_pair(body, lock, tfm) for tfm in ROT_REFLECTS}
