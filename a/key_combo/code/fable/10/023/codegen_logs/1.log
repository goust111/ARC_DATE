+    color_idx = 0
+    for group_size in groups:
+        built = _make_shape_with_locks(group_size, used_shapes, rng)
+        if built is None:
+            return None
+        body, locks, shape_key = built
+        used_shapes.add(shape_key)
+        for lock in locks:
+            items.append(
+                {
+                    "body": body,
+                    "lock": lock,
+                    "body_color": int(body_colors[color_idx]),
+                    "lock_color": int(lock_color),
+                    "bg": int(bg),
+                }
