+def _shape_canonical(body: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    variants = []
+    for tfm in ROT_REFLECTS:
+        rr_r, rr_c, cc_r, cc_c = tfm
+        pts = []
+        for r, c in body:
+            pts.append((rr_r * r + rr_c * c, cc_r * r + cc_c * c))
+        variants.append(_normalize_shape(pts))
