+    for step in range(count - 1):
+        remaining_outer = count - 2 - step
+        h_lo = cur_h + 3
+        h_hi = min(cur_h + 6, outer_limit - 3 * remaining_outer)
+        w_lo = cur_w + 3
+        w_hi = min(cur_w + 6, outer_limit - 3 * remaining_outer)
