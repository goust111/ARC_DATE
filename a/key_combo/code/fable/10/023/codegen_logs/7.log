+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+CTRL = 8
+FRAME_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
+QUADRANTS = ("nw", "ne", "sw", "se")
+
+_RNG = random.Random()
