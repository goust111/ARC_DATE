+    colors = random.sample(INPUT_COLORS, len(raw_masks))
+    result = []
+    for color, raw in zip(colors, raw_masks):
+        if raw["name"] in {"F", "Z"}:
+            pattern = PLUS_PATTERN
+        else:
+            pattern = _sample_pattern(raw["required_corner"], exact_counts[raw["name"]])
+        result.append(
