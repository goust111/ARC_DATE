+BLACK = 0
+RED = 2
+INPUT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+CORNER_SPECS = {
+    "NW": ((0, 0), (-1, -1)),
+    "NE": ((0, 2), (-1, 1)),
+    "SW": ((2, 0), (1, -1)),
+    "SE": ((2, 2), (1, 1)),
