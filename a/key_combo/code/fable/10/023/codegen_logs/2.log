+    return None
+
+
+def _build_cluster_two(boxes: list[tuple[int, int, int, int]]) -> tuple[list[dict], dict] | None:
+    shape = LOCAL_SHAPE
+    for _ in range(160):
+        r0 = random.randint(15, 17)
+        c0 = random.randint(1, 3)
