+                "color": int(color),
+                "top_left": tuple(map(int, raw["top_left"])),
+                "pattern": pattern,
+            }
+        )
+    return result
+
+
+def _build_final_grid(masks: list[dict], targets: dict[str, tuple[int, int]]) -> tuple[np.ndarray, dict[str, tuple[int, int]]]:
+    top = random.randint(0, 5)
+    bottom = random.randint(0, 5)
