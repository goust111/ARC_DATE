15:def main(input_grid):
16:    """
17:    Draw red segments toward the gray divider and blue segments away from it.
18:
19:    Input structure:
20:    - The input is a black grid with one straight gray row or column.
21:    - Red and blue pixels appear on both sides of the gray divider.
22:    - The gray divider stops lines that are drawn toward it.
23:
24:    Rule:
25:    - Detect whether the gray divider is horizontal or vertical.
26:    - Draw red lines from red pixels toward the divider.
27:    - Draw blue lines from blue pixels away from the divider toward the edge.
28:
29:    Key insight:
30:    - The gray line is an axis of attraction for red and repulsion for blue.
31:    """
32:    # copy the input grid to the output grid
33:    output_grid = np.copy(input_grid)
34:
35:    # Find the grey line and determine whether it's horizontal (a row) or vertical (a column).
36:    grey_coords = np.argwhere(output_grid == Color.GREY)
37:    grey_rows = np.unique(grey_coords[:, 0])
38:    grey_cols = np.unique(grey_coords[:, 1])
39:
40:    red_coords = np.argwhere(output_grid == Color.RED)
41:    blue_coords = np.argwhere(output_grid == Color.BLUE)
42:
43:    if len(grey_rows) == 1:
44:        # Horizontal line at row = grey_r
45:        grey_r = int(grey_rows[0])
46:
47:        # Red pixels: draw toward the line (down if above, up if below).
48:        for r, c in red_coords:
49:            r = int(r)
50:            c = int(c)
51:            dr = 1 if r < grey_r else -1
52:            draw_line(output_grid, r, c, length=None, color=Color.RED, direction=(dr, 0), stop_at={Color.GREY})
53:
54:        # Blue pixels: draw away from the line (up if above, down if below).
55:        for r, c in blue_coords:
56:            r = int(r)
57:            c = int(c)
58:            dr = -1 if r < grey_r else 1
59:            draw_line(output_grid, r, c, length=None, color=Color.BLUE, direction=(dr, 0), stop_at={Color.GREY})
60:
61:    elif len(grey_cols) == 1:
62:        # Vertical line at col = grey_c
63:        grey_c = int(grey_cols[0])
64:
65:        # Red pixels: draw toward the line (right if left, left if right).
66:        for r, c in red_coords:
67:            r = int(r)
68:            c = int(c)
69:            dc = 1 if c < grey_c else -1
70:            draw_line(output_grid, r, c, length=None, color=Color.RED, direction=(0, dc), stop_at={Color.GREY})
71:
72:        # Blue pixels: draw away from the line (left if left, right if right).
73:        for r, c in blue_coords:
74:            r = int(r)
75:            c = int(c)
76:            dc = -1 if c < grey_c else 1
77:            draw_line(output_grid, r, c, length=None, color=Color.BLUE, direction=(0, dc), stop_at={Color.GREY})
78:
79:    else:
80:        raise ValueError("Expected a single straight grey line (one row or one column).")
81:
82:    return output_grid
