+    placements: list[tuple[int, int, int]] = []
+    events: list[dict] = []
+    phase = 0
+    for row in range(motif_len, h):
+        event = {
+            "row": row,
+            "entry_lane": lane,
+            "bar": None,
+            "exit_lane": lane,
+        }
+        bar = component_at.get((row, lane))
+        if bar is not None:
+            if int(bar["color"]) == BLUE:
+                lane = int(bar["start"]) - 1
+            else:
+                lane = int(bar["end"]) + 1
+            event["bar"] = dict(bar)
+            event["exit_lane"] = lane
