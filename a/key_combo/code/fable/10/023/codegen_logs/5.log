+
+def _trace_path(parsed: dict) -> tuple[list[tuple[int, int, int]], list[dict]]:
+    h = int(parsed["h"])
+    motif_len = int(parsed["motif_len"])
+    motif_colors = list(parsed["motif_colors"])
+    lane = int(parsed["motif_col"])
+    component_at = dict(parsed["component_at"])
