6:def main(grid: np.ndarray) -> np.ndarray:
7:    """Draw the red trace from its border marker, detouring around each blue/green bar it hits.
8:
9:    Input structure
10:    - The grid has a background, one red marker on the border, and blue/green
11:      one-cell-thick bars perpendicular to the marker's inward direction.
12:
13:    Rule
14:    - The red marker travels straight inward from its border.
15:    - When the trace hits a blue bar, it passes around the bar on the left side
16:      relative to its direction of travel.
17:    - When the trace hits a green bar, it passes around the bar on the right
18:      side relative to its direction of travel.
19:    - Existing bars are preserved; only background cells on the trace become red.
20:
21:    Key insight
22:    - The trace keeps the same overall forward direction; each hit bar only
23:      shifts the current lane by forcing a detour one cell before the obstacle.
24:    """
25:    g = np.asarray(grid, dtype=int)
26:    h, w = g.shape
27:    bg = get_bg(g)
28:    red = Color.RED
29:    blue = Color.BLUE
30:    green = Color.GREEN
31:    assert set(map(int, np.unique(g))) <= {bg, red, blue, green}
32:
33:    starts = np.argwhere(g == red)
34:    assert starts.shape == (1, 2)
35:    r, c = map(int, starts[0])
36:    if r == 0:
37:        dr, dc = 1, 0
38:    elif r == h - 1:
39:        dr, dc = -1, 0
40:    elif c == 0:
41:        dr, dc = 0, 1
42:    elif c == w - 1:
43:        dr, dc = 0, -1
44:    else:
45:        raise AssertionError("red marker must be on the border")
46:
47:    components = find_components(g, bg=bg, connectivity=4, colors=[blue, green])
48:    component_at = {}
49:    for comp in components:
50:        r0, c0, r1, c1 = comp["bbox"]
51:        if dr:
52:            assert r0 == r1
53:        else:
54:            assert c0 == c1
55:        for rr, cc in comp["coords"]:
56:            key = (int(rr), int(cc))
57:            assert key not in component_at
58:            component_at[key] = comp
59:
60:    out = g.copy()
61:
62:    def paint_cell(rr: int, cc: int) -> None:
63:        assert in_bounds(g.shape, rr, cc)
64:        assert int(g[rr, cc]) in (bg, red)
65:        out[rr, cc] = red
66:
67:    def paint_line(a: tuple[int, int], b: tuple[int, int]) -> None:
68:        ar, ac = a
69:        br, bc = b
70:        if ar == br:
71:            step = 1 if bc >= ac else -1
72:            for cc in range(ac, bc + step, step):
73:                paint_cell(ar, cc)
74:        elif ac == bc:
75:            step = 1 if br >= ar else -1
76:            for rr in range(ar, br + step, step):
77:                paint_cell(rr, ac)
78:        else:
79:            raise AssertionError("trace segments must be horizontal or vertical")
80:
81:    paint_cell(r, c)
82:    while True:
83:        rr, cc = r + dr, c + dc
84:        hit = None
85:        while in_bounds(g.shape, rr, cc):
86:            val = int(g[rr, cc])
87:            if val in (blue, green):
88:                hit = (rr, cc)
89:                break
90:            assert val in (bg, red)
91:            rr += dr
92:            cc += dc
93:
94:        if hit is None:
95:            last = (rr - dr, cc - dc)
96:            if (r, c) != last:
97:                paint_line((r + dr, c + dc), last)
98:            break
99:
100:        hr, hc = hit
101:        turn_start = (hr - dr, hc - dc)
102:        if (r, c) != turn_start:
103:            paint_line((r + dr, c + dc), turn_start)
104:
105:        comp = component_at[hit]
106:        color = int(comp["color"])
107:        normal = (-dc, dr) if color == blue else (dc, -dr)
108:        r0, c0, r1, c1 = comp["bbox"]
109:        if normal[0] < 0:
110:            side = (r0 - 1, hc)
111:        elif normal[0] > 0:
112:            side = (r1 + 1, hc)
113:        elif normal[1] < 0:
114:            side = (hr, c0 - 1)
115:        else:
116:            side = (hr, c1 + 1)
117:        assert in_bounds(g.shape, side[0], side[1])
118:        assert int(g[side]) == bg
119:
120:        turn_end = (side[0] - dr, side[1] - dc)
121:        assert in_bounds(g.shape, turn_end[0], turn_end[1])
122:        paint_line(turn_start, turn_end)
123:        paint_cell(side[0], side[1])
124:        r, c = side
125:
126:    return out

