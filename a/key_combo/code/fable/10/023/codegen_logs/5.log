7:def main(grid: np.ndarray) -> np.ndarray:
8:    """Add the four colored diagonal corner markers around every grey 2x2 square.
9:
10:    Input structure
11:    - The grid has black background pixels and one or more 4-connected grey
12:      foreground objects.
13:    - Every grey object is a solid 2x2 square with a one-cell black margin at
14:      each diagonal outside corner.
15:
16:    Rule
17:    - Preserve the input grid.
18:    - For each grey square, paint blue at the northwest outside corner, red at
19:      the northeast outside corner, green at the southwest outside corner, and
20:      yellow at the southeast outside corner.
21:
22:    Key insight
23:    - The grey squares are fixed anchors; the output is a local decoration of
24:      each square's bounding box, not a movement or matching problem.
25:    """
26:    g = np.asarray(grid, dtype=int)
27:
28:    bg = get_bg(g)
29:    assert bg == Color.BLACK
30:    assert set(map(int, np.unique(g))).issubset({Color.BLACK, Color.GREY})
31:
32:    out = g.copy()
33:    squares = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[Color.GREY])
34:    assert squares
35:
36:    for square in squares:
37:        assert square["color"] == Color.GREY
38:        assert square["area"] == 4
39:        r0, c0, r1, c1 = square["bbox"]
40:        assert r1 - r0 + 1 == 2
41:        assert c1 - c0 + 1 == 2
42:        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.GREY)
43:
44:        markers = [
45:            (r0 - 1, c0 - 1, Color.BLUE),
46:            (r0 - 1, c1 + 1, Color.RED),
47:            (r1 + 1, c0 - 1, Color.GREEN),
48:            (r1 + 1, c1 + 1, Color.YELLOW),
49:        ]
50:        for r, c, color in markers:
51:            assert in_bounds(g.shape, r, c)
52:            assert g[r, c] == bg
53:            assert out[r, c] == bg
54:            out[r, c] = color
55:
56:    return out
