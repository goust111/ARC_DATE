99:        if len(placed) + 1 < k:
100:            remaining = k - len(placed) - 1
101:            viable = []
102:            for pos in available:
103:                next_placed = placed + [pos]
104:                future_count = sum(fits(other, next_placed) for other in candidates)
105:                if future_count >= remaining:
106:                    viable.append(pos)
107:            if viable:
108:                available = viable
109:        placed.append(random.choice(available))
110:    return placed
