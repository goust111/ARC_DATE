+    parsed = _parse_grid(np.asarray(grid, dtype=int))
+    out = parsed["grid"].copy()
+    for row, col, color in _trace_path(parsed)[0]:
+        assert int(out[row, col]) == BLACK, "train path may only paint background cells"
+        out[row, col] = int(color)
+    return out
