9:def main(grid: np.ndarray) -> np.ndarray:
10:    """
11:    Shift every foreground horizontal segment one cell left and replace the old background with grey.
12:
13:    Input structure:
14:    - The grid has one dominant background color and exactly one foreground color.
15:    - The foreground pixels form one or more 4-connected horizontal one-cell-thick segments.
16:
17:    Rule:
18:    - Create an output grid of the same shape filled with grey.
19:    - Move every foreground pixel one column left; pixels shifted past the left edge are clipped.
20:    - Paint all shifted foreground pixels with their original foreground color.
21:
22:    Key insight:
23:    - The output is not an extension of the segments; it is a global one-cell west translation of the foreground mask over a newly grey background.
24:    """
25:    g = np.asarray(grid, dtype=int)
26:    assert g.ndim == 2, "expected a 2D grid"
27:
28:    bg = get_bg(g)
29:    assert bg != Color.GREY, "background must be recolored to grey"
30:    fg_colors = colors_present(g, exclude={bg})
31:    assert len(fg_colors) == 1, "expected exactly one foreground color"
32:    fg = int(fg_colors[0])
33:    assert fg != Color.GREY, "foreground color must differ from grey fill"
34:
35:    segments = find_components(g, bg=bg, connectivity=4, monochromatic=True)
36:    assert segments, "expected at least one foreground segment"
37:    for segment in segments:
38:        assert int(segment["color"]) == fg, "all foreground segments must share one color"
39:        r0, c0, r1, c1 = segment["bbox"]
40:        assert r0 == r1, "foreground components must be one row high"
41:        assert int(segment["area"]) == int(c1 - c0 + 1), "foreground components must be solid horizontal segments"
42:
43:    mask = g == fg
44:    shifted = np.zeros_like(mask, dtype=bool)
45:    shifted[:, :-1] = mask[:, 1:]
46:
47:    out = np.full(g.shape, Color.GREY, dtype=int)
48:    out[shifted] = fg
49:    return out
