7:def main(grid: np.ndarray) -> np.ndarray:
8:    """Continue the grey-bracketed top motif downward through the empty suffix.
9:
10:    Input structure
11:    The grid has a black background. A contiguous run of grey pixels begins at
12:    the top of the leftmost column; those grey pixels mark the rows of a colored
13:    motif. Below the marked rows there may be other foreground rows, followed by
14:    an all-background suffix.
15:
16:    Rule
17:    Copy the marked rows as a motif after changing the grey marker cells to
18:    background. Starting just below the lowest existing foreground row, write
19:    those motif rows cyclically into the empty suffix, preserving the original
20:    grid everywhere else.
21:
22:    Key insight
23:    The grey segment is a bracket for the motif height; the fill below the
24:    existing drawing restarts from the first marked row rather than continuing
25:    from any unmarked foreground row.
26:    """
27:    g = np.asarray(grid, dtype=int)
28:    assert g.ndim == 2, "expected a 2D grid"
29:    assert min(g.shape) > 0, "expected a nonempty grid"
30:
31:    bg = get_bg(g)
32:    assert bg == Color.BLACK, "expected black background"
33:
34:    marker_rows = np.flatnonzero(g[:, 0] == Color.GREY)
35:    assert marker_rows.size > 0, "expected grey marker rows"
36:    assert np.array_equal(marker_rows, np.arange(marker_rows.size)), "grey marker must be a top-left run"
37:    assert np.count_nonzero(g == Color.GREY) == marker_rows.size, "grey pixels are only the row markers"
38:
39:    motif = g[: marker_rows.size].copy()
40:    motif[:, 0] = bg
41:    assert np.all(np.any(motif != bg, axis=1)), "each marked row must contain motif pixels"
42:
43:    foreground_rows = np.flatnonzero(np.any(g != bg, axis=1))
44:    assert foreground_rows.size > 0, "expected foreground"
45:    start = int(foreground_rows[-1]) + 1
46:    assert np.all(g[start:] == bg), "suffix below the drawing must be empty"
47:
48:    out = g.copy()
49:    for r in range(start, g.shape[0]):
50:        motif_row = motif[(r - start) % motif.shape[0]]
51:        paint = motif_row != bg
52:        out[r, paint] = motif_row[paint]
53:    return out
