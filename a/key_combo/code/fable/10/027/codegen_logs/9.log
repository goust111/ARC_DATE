+    for r, c in np.argwhere(fg):
+        neighbors = []
+        for dr, dc in dirs:
+            rr, cc = int(r) + dr, int(c) + dc
+            if 0 <= rr < h and 0 <= cc < w and fg[rr, cc]:
+                neighbors.append((dr, dc))
+        if len(neighbors) != 2:
+            out[r, c] = True
+            continue
