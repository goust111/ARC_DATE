  "dst": "yellow skeleton bbox used as the stretched canvas",
  "transform": "match prototype vertex rows/columns to yellow anchor rows/columns in order; stretch each colored horizontal and vertical prototype segment through the mapped intervals, dropping yellow and grey cells",
  "grid_shape": "same height and width as the yellow skeleton bbox"
}
</annotation>
<generation_spec>
```yaml
spec:
  task: stretch compact colored grid-graph prototype onto sparse yellow skeleton canvas
  input:
    layout: two panels side-by-side (proto | skeleton or skeleton | proto) separated by 1 grey column; proto can be left or right
    proto:
      structure: (2*NH+1) x (2*NV+1) grid-graph; NH full-width H-lines at odd rows (1,3,...), NV full-height V-lines at odd cols (1,3,...); remaining fg only at intersections
      NH: 1-2, NV: 1-3, NH+NV >= 3 [observed]
      line_colors: each H-line has a single color, each V-line has a single color; all from {BLUE,RED,GREEN}; adjacent lines may share colors
      intersection_color: each crossing pixel takes either its H-line or V-line color (free choice, varies per intersection)
      all_three_colors_used: true [observed]
    skeleton:
      size: spans full grid height; width = 2*NV+1 to 2*NV+1 stretched; 7-12 rows x 7-7 cols observed
      anchors: yellow dots at positions matching the proto vertex boolean pattern; first/last anchor at row/col 0 and max
      anchor_gaps: 1-5 per adjacent pair; for pairs with internal proto rows/cols (between consecutive H/V lines), gap >= 1 (stretch factor >= 1)
    grey_fill: separator column is all grey; proto panel area below proto height filled with grey
    grid: 7-12 rows x 11-15 cols
  output:
    size: same as skeleton bbox
    content: proto stretched onto skeleton canvas; colored line segments fill intervals between anchors; yellow dots replaced by line colors

generation_strategy:
  approach: output-first
  steps:
    - pick NH in {1,2}, NV in {1,3} with NH+NV >= 3
    - assign a color from {BLUE,RED,GREEN} to each H-line and V-line; ensure all 3 colors used across all lines
    - for each intersection, choose H-line or V-line color freely
    - build the (2*NH+1) x (2*NV+1) proto from these assignments
    - compute vertex rows = {0, h-1} union H-line rows; vertex cols = {0, w-1} union V-line cols
    - choose anchor positions; first/last at boundaries; for each pair of adjacent vertices with gap>1, ensure anchor gap >= vertex gap - 1; target skeleton 7-12 rows x 7-12 cols
    - place yellow dots in the skeleton at vertex-pattern positions
    - randomly place proto left or right of skeleton; add 1-col grey separator; fill remaining proto-panel space with grey
```
