+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+PALETTE = (BLUE, RED, GREEN, PINK, ORANGE, TEAL, MAROON)
+GEN_ATTEMPTS = 400
+MIN_SKELETON_SIZE = 7
+MAX_SKELETON_SIZE = 18
