        primary = (dr, dc)
        if dr:
            turn_dirs = [(0, -1), (0, 1)]
        else:
            turn_dirs = [(-1, 0), (1, 0)]

        dir_sequences = [[primary] * (length - 1)]
        for turn_dir in turn_dirs:
            for turn_after in range(length - 1):
                dir_sequences.append([primary] * turn_after + [turn_dir] * (length - 1 - turn_after))

        for dirs in dir_sequences:
