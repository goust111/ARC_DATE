  "type": "move_to_match",
  "src": "3x3 tile s containing the singleton yellow marker in the grey-separated 3x3 tile grid",
  "dst": "3x3 tile slot d in the same grey-separated grid",
  "match_cond": "d.macro_row == yellow_marker.local_row_in_s and d.macro_col == yellow_marker.local_col_in_s",
  "transform": "clear all non-separator cells, preserve the grey separator grid, and stamp s into d"
}
</annotation>
