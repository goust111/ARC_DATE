GENERATION_RETRIES = 300


def _valid_bbox_sizes(height: int, width: int) -> list[tuple[int, int]]:
    """Return bbox sizes whose margin/aspect constraints match the spec."""
    box_heights = range(
        BBOX_HEIGHT_RANGE[0],
