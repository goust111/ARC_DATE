+    n = int(aligned_tiles[0].shape[0])
+    pattern = np.empty((n, n), dtype=int)
+    for r in range(n):
+        for c in range(n):
+            votes = [
+                int(aligned_tiles[idx][r, c])
+                for idx in honest
+                if visible[idx][r, c]
