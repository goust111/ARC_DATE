+def _reflect(tile: np.ndarray, kind: str) -> np.ndarray:
+    if kind == "lr":
+        return np.fliplr(tile).copy()
+    if kind == "ud":
+        return np.flipud(tile).copy()
+    if kind == "diag":
+        return tile.T.copy()
+    if kind == "anti":
+        return np.flipud(np.fliplr(tile.T)).copy()
+    raise ValueError(f"unknown reflection kind: {kind}")
