+DISPLAY_ROTATIONS = (0, -1, 2, 1)
+ALIGN_ROTATIONS = (0, 1, 2, -1)
+REFLECTION_KINDS = ("lr", "ud", "diag", "anti")
+ALL_COLORS = tuple(range(10))
+GEN_ATTEMPTS = 500
