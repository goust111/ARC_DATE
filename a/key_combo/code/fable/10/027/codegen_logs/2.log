+def _pattern_is_rigid(pattern: np.ndarray) -> bool:
+    transforms = [
+        np.rot90(pattern, 1),
+        np.rot90(pattern, 2),
+        np.rot90(pattern, 3),
+        np.fliplr(pattern),
+        np.flipud(pattern),
+        pattern.T,
+        np.flipud(np.fliplr(pattern.T)),
+    ]
+    return all(not np.array_equal(pattern, variant) for variant in transforms)
