+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
