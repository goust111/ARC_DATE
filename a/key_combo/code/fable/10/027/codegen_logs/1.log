+def _landing_shift(obj: dict, platforms: list[dict], catch_colors: set[int], height: int, *, strategy: str = "true") -> int:
+    coords = np.array(obj["coords"], dtype=int)
+    bottom_shift = int(height - 1 - coords[:, 0].max())
+    assert bottom_shift >= 0
