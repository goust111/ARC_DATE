+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+
+# Generator layout.
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (24, 28)
+LEGEND_ZONE_W = 5
+PLAY_LEFT = LEGEND_ZONE_W + 2
+LANE_GAP = 2
+LANE_W_RANGE = (3, 4)
+PLATFORM_COUNT = 5
+PLATFORM_START_MIN = 4
+PLATFORM_START_MAX = 6
+PLATFORM_ROW_STEP = 4
+OBJECT_H_RANGE = (2, 3)
+MAX_LIFT = 20
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": _bbox(coords),
+                }
+            )
+    return comps
+
+
+def _is_legend(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return int(comp["area"]) == 2 and r0 == r1 and c1 == c0 + 1
+
+
+def _is_platform(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return r0 == r1 and int(comp["area"]) == (c1 - c0 + 1) and (c1 - c0 + 1) >= 3
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, dict[int, set[int]], list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    comps = _find_components(g, bg)
+    assert comps, "expected at least one non-background component"
+
+    legends: dict[int, set[int]] = {}
+    platforms: list[dict] = []
+    objects: list[dict] = []
+
+    for comp in comps:
+        if _is_legend(comp):
+            r0, c0, _, _ = comp["bbox"]
+            platform_color = int(g[r0, c0])
+            object_color = int(g[r0, c0 + 1])
+            assert platform_color != object_color, "legend halves must differ"
+            legends.setdefault(object_color, set()).add(platform_color)
+        elif _is_platform(comp):
+            r0, c0, _, c1 = comp["bbox"]
+            platforms.append(
+                {
+                    "color": int(comp["color"]),
+                    "row": int(r0),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                }
+            )
+        else:
+            objects.append(comp)
