    inp[:, axis_c] = out[:, axis_c] = cross_color
    for (r, c), color in zip(marker_cells, assignments):
        inp[r, c] = color
        reflected = ((r, c), (2 * axis_r - r, c), (r, 2 * axis_c - c), (2 * axis_r - r, 2 * axis_c - c))
