+    if np.array_equal(inp, out):
+        return False
+    if np.array_equal(nearest_any, out):
+        return False
+    if np.array_equal(lowest_match, out):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    spec = _scene_spec()
+    if spec is None:
+        return None
+    inp, out = _build_pair(spec)
+    if not _validate_pair(inp, out, spec):
