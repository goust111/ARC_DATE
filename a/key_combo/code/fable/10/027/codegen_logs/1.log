+    if bg != BG:
+        return False
+    if len(platforms) != PLATFORM_COUNT:
+        return False
+    if len(objects) != len(spec["lanes"]):
+        return False
+    if not {"top_multi", "lower", "bottom_platform"}.issubset({lane["mode"] for lane in spec["lanes"]}):
+        return False
+
+    for lane in spec["lanes"]:
