+def _candidate_platform_shifts(obj: dict, platforms: list[dict]) -> list[tuple[int, dict]]:
+    coords = np.array(obj["coords"], dtype=int)
+    cols = coords[:, 1]
+    candidates: list[tuple[int, dict]] = []
