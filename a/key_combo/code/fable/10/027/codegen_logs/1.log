+    try:
+        solved = main(inp)
+        nearest_any = _render_with_strategy(inp, "nearest_any")
+        lowest_match = _render_with_strategy(inp, "lowest_match")
+    except Exception:
+        return False
+
+    if not np.array_equal(solved, out):
