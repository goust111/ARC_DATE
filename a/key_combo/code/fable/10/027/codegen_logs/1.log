+        if lane["mode"] == "top_multi" and len(legends.get(lane["object_color"], set())) != 2:
+            return False
+        if lane["mode"] == "lower":
+            catch = legends.get(lane["object_color"], set())
+            if catch != {lane["platforms"][-1]["color"]}:
