+    inp = np.zeros((height, width), dtype=int)
+    out = np.zeros((height, width), dtype=int)
+
+    all_platforms = []
+    for lane in spec["lanes"]:
+        for platform in lane["platforms"]:
+            r = int(platform["row"])
+            c0 = int(platform["c0"])
+            c1 = int(platform["c1"])
+            color = int(platform["color"])
+            inp[r, c0 : c1 + 1] = color
+            out[r, c0 : c1 + 1] = color
