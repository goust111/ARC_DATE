+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+
+# Generator layout.
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (24, 28)
+LEGEND_ZONE_W = 5
+PLAY_LEFT = LEGEND_ZONE_W + 2
+LANE_GAP = 2
+LANE_W_RANGE = (3, 4)
