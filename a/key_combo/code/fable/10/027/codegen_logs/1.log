+BG = 0
+PALETTE = tuple(range(1, 10))
+
+# Generator layout.
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (24, 28)
+LEGEND_ZONE_W = 5
+PLAY_LEFT = LEGEND_ZONE_W + 2
+LANE_GAP = 2
+LANE_W_RANGE = (3, 4)
+PLATFORM_COUNT = 5
+PLATFORM_START_MIN = 4
+PLATFORM_START_MAX = 6
+PLATFORM_ROW_STEP = 4
+OBJECT_H_RANGE = (2, 3)
+MAX_LIFT = 20
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": _bbox(coords),
+                }
+            )
+    return comps
+
+
+def _is_legend(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return int(comp["area"]) == 2 and r0 == r1 and c1 == c0 + 1
+
+
+def _is_platform(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return r0 == r1 and int(comp["area"]) == (c1 - c0 + 1) and (c1 - c0 + 1) >= 3
+
+
+def _legend_pairs(grid: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
+    h, w = grid.shape
+    used: set[tuple[int, int]] = set()
+    pairs = []
+    for r in range(h):
+        for c in range(w - 1):
+            if (r, c) in used or (r, c + 1) in used:
+                continue
+            left = int(grid[r, c])
+            right = int(grid[r, c + 1])
+            if left == bg or right == bg or left == right:
+                continue
+            pair_cells = {(r, c), (r, c + 1)}
+            isolated = True
+            for rr, cc in pair_cells:
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        nr, nc = rr + dr, cc + dc
+                        if not (0 <= nr < h and 0 <= nc < w):
+                            continue
+                        if (nr, nc) in pair_cells:
+                            continue
+                        if int(grid[nr, nc]) != bg:
+                            isolated = False
+                            break
+                    if not isolated:
