+BG = 0
+PALETTE = tuple(range(1, 10))
+
+# Generator layout.
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (24, 28)
+LEGEND_ZONE_W = 5
+PLAY_LEFT = LEGEND_ZONE_W + 2
+LANE_GAP = 2
+LANE_W_RANGE = (3, 4)
+PLATFORM_COUNT = 5
+PLATFORM_START_MIN = 4
+PLATFORM_START_MAX = 6
+PLATFORM_ROW_STEP = 4
+OBJECT_H_RANGE = (2, 3)
+MAX_LIFT = 20
