+    queue = deque([start])
+    prev = {start: None}
+    H, W = grid.shape
+    while queue:
+        r, c = queue.popleft()
+        if (r, c) == end:
+            break
+        steps = list(STEP2)
+        random.shuffle(steps)
+        for dr, dc in steps:
+            nr, nc = r + dr, c + dc
+            mid = (r + dr // 2, c + dc // 2)
+            nb = (nr, nc)
+            if nb in prev:
+                continue
