def _assert_mask_preserves_non_bg_extents(g: np.ndarray, out: np.ndarray) -> None:
    mask = g == UNKNOWN
    bg = _background_color(out)

    for color, comp in _same_color_components(out):
        if color == bg:
            continue

        hidden = [(r, c) for r, c in comp if mask[r, c]]
