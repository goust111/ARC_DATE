+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+GREY = 5
+CARDINALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+STEP2 = [(-2, 0), (2, 0), (0, -2), (0, 2)]
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[int(np.argmax(counts))])
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_by_color(grid: np.ndarray, skip: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0]:
+                continue
+            color = int(grid[r0, c0])
+            if color in skip:
+                continue
+            seen[r0, c0] = True
+            stack = [(r0, c0)]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for dr, dc in CARDINALS:
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and int(grid[rr, cc]) == color:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _is_hollow_frame(comp: dict, grid: np.ndarray, bg: int) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 7:
+        return False
+    expected = set()
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    if set(comp["coords"]) != expected:
+        return False
+    return bool(np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == bg))
+
+
+def _path_components(grid: np.ndarray, path_color: int) -> list[list[tuple[int, int]]]:
+    nodes = {tuple(map(int, rc)) for rc in np.argwhere(grid == path_color)}
+    comps: list[list[tuple[int, int]]] = []
+    seen: set[tuple[int, int]] = set()
+    for start in nodes:
+        if start in seen:
+            continue
+        queue = deque([start])
+        seen.add(start)
+        comp: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            comp.append((r, c))
+            for dr, dc in STEP2:
+                nb = (r + dr, c + dc)
+                if nb in nodes and nb not in seen:
+                    seen.add(nb)
+                    queue.append(nb)
+        comps.append(sorted(comp))
+    return comps
