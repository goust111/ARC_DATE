+def _frame_cells(frame: dict) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = frame["bbox"]
+    cells: set[tuple[int, int]] = set()
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
