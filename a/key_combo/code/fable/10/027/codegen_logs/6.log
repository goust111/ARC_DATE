+
+    for frame, count in zip(frames, counts):
+        r0, c0, r1, c1 = frame["bbox"]
+        row = (r0 + r1) // 2
+        color = int(frame["color"])
+        for i in range(int(count)):
+            col = c1 - 2 - 2 * i
+            if col > c0:
