+FRAME_GAP_RANGE = (2, 4)
+GRID_H_RANGE = (19, 30)
+GRID_W_RANGE = (23, 30)
+TOTAL_PATH_RANGE = (3, 7)
+EXTRA_COLOR_CHOICES = (1, 2)
