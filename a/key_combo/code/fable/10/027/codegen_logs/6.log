 120:     r = int(r)
 121:     c = int(c)
 122:     for dr in (-1, 0, 1):
 123:         for dc in (-1, 0, 1):
 124:             if dr == 0 and dc == 0:
 125:                 continue
 126:             yield r + dr, c + dc
