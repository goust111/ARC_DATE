+                continue
+            if int(grid[mid]) != bg:
+                continue
+            exempt = frame_exempt if (r, c) == start and nb != start else set()
+            if nb != end and not _node_ok(grid, bg, gray_nodes, nb, exempt=exempt):
+                continue
+            if nb == end and not _node_ok(grid, bg, gray_nodes, nb, exempt=exempt):
+                continue
+            prev[nb] = (r, c)
+            queue.append(nb)
+    if end not in prev:
+        return None
+    path: list[tuple[int, int]] = []
+    cur = end
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
