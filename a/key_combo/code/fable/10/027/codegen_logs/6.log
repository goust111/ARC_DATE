+    bg: int,
+    gray_nodes: set[tuple[int, int]],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    frame_exempt: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    queue = deque([start])
+    prev = {start: None}
+    H, W = grid.shape
+    while queue:
+        r, c = queue.popleft()
+        if (r, c) == end:
+            break
+        steps = list(STEP2)
+        random.shuffle(steps)
+        for dr, dc in steps:
