+        variants = [set(base)]
+        for _ in range(3):
+            variants.append(_rotate(variants[-1]))
+        all_forms = variants + [_reflect(v) for v in variants]
+        for form in all_forms:
+            if (0, 0) not in form:
+                continue
+            key = tuple(sorted(form))
+            if key not in seen:
