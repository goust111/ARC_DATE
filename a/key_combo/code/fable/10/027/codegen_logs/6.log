+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _make_output(shape: tuple[int, int], bg: int, frames: list[dict], counts: list[int]) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
