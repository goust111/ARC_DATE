+        row = (r0 + r1) // 2
+        for i in range(int(count)):
+            out[row, c1 - 2 - 2 * i] = int(frame["color"])
+    return out
+
+
+def _clean_frame_input(shape: tuple[int, int], bg: int, frames: list[dict]) -> np.ndarray:
+    inp = np.full(shape, bg, dtype=int)
+    for frame in frames:
