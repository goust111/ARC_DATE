  84: def _quadrant_cells(h: int, w: int, axis_r: int, axis_c: int, quadrant: int) -> list[tuple[int, int]]:
  85:     if quadrant < 2:
  86:         rows = range(0, axis_r)
  87:     else:
  88:         rows = range(axis_r + 1, h)
  89:     if quadrant % 2 == 0:
  90:         cols = range(0, axis_c)
  91:     else:
  92:         cols = range(axis_c + 1, w)
  93:     return [(r, c) for r in rows for c in cols]
  94: 
  95: 
  96: def _valid_counts(area: int) -> list[int]:
  97:     min_count, max_count = MARKER_COUNT_RANGE
  98:     min_density, max_density = MARKER_DENSITY_RANGE
  99:     return [n for n in range(min_count, max_count + 1) if min_density <= n / area <= max_density]
