  66: BG = 7
  67: PALETTE = tuple(range(10))
  68: # Canvas and cross-axis bounds.
  69: GRID_SIZE_RANGE = (8, 17)
  70: AXIS_ROW_RANGE = (4, 6)
  71: AXIS_COL_RANGE = (3, 8)
  72: AXIS_END_MARGIN = 4
