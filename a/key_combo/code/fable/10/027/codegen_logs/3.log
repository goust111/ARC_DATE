+    for color_idx, sprite_idx in enumerate(order):
+        choice = _choose_target_ring(
+            (h, w),
+            traces[sprite_idx],
+            sprites[sprite_idx]["min_reflections"],
+            blocked,
+            all_sprite_cells,
+            prior_prefix_cells,
