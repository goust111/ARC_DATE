+    out = g.copy()
+    out[ir0 : ir1 + 1, ic0 : ic1 + 1] = BG
+    out[dr0 : dr1 + 1, dc0 : dc1 + 1] = BG
+    row_shift = dr0 - ir0
+    col_shift = dc0 - ic0
