+    assert not np.any(g[-1, :] == moving), "moving color must stay off the bottom row"
+    return bg, obstacle, moving
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
