spec:
  grid: 8-17 rows x 8-17 cols
  background: 7 [observed]
  cross:
    structure: one color filling exactly one complete row and one complete column, forming a + axis
    color: any non-bg color, distinct from all marker colors
    position: row 4-6, col 3-8; not on grid edge; splits grid into 4 quadrants
  markers:
    count: 7-12 sparse pixels placed in exactly one quadrant (all 4 in the same quadrant)
    colors: 5-7 distinct non-bg non-cross colors; some colors may repeat (2-3 pixels)
    placement: no marker on the cross row or cross column; density 25-45% of quadrant area
    constraint: reflected copies (across row-axis, col-axis, and both) must not conflict in color
  output_rule: |
    Copy each marker to its 3 reflected positions (horizontal, vertical, diagonal through cross intersection).
    Reflected positions outside the grid are clipped (not placed). Input is otherwise unchanged.

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size H in [8,17], W in [8,17].
    2. Pick cross row r in [3, H-4] and cross col c in [3, W-4]. Choose cross_color != bg.
    3. Choose one of the 4 quadrants as the populated quadrant.
    4. Pick 5-7 distinct marker colors (all != bg, != cross_color).
    5. Place 7-12 marker pixels in the chosen quadrant at random positions, density ~30%.
       Allow color repeats but ensure no two markers at the same cell.
    6. Verify no reflection conflicts: for each pair of markers, their 4 reflected positions
       must not map to the same cell with different colors. Retry placement on conflict.
    7. Fill the cross row and column with cross_color. Fill the rest with bg. Place markers.
    8. The 3 empty quadrants (plus possibly parts of the populated quadrant's reflections
       that land out of bounds) are left as bg -- this is the input.
