0021: def main(grid: np.ndarray) -> np.ndarray:
0022:     """
0023:     Complete the sparse colored marker pattern by reflecting it across a full-row/full-column cross.
0024: 
0025:     Input structure
0026:     The grid has a dominant background and one non-background cross color that
0027:     fills exactly one complete row and one complete column. All other foreground
0028:     pixels are sparse markers away from that cross.
0029: 
0030:     Rule
0031:     Keep the input unchanged, and for each marker pixel copy its color to the
0032:     positions obtained by reflecting it across the cross row, across the cross
0033:     column, and across both axes. Reflected positions outside the grid are
0034:     clipped.
0035: 
0036:     Key insight
0037:     The full cross is not a copied object; it is the pair of mirror axes for
0038:     completing the quadrant pattern.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     bg = get_bg(g)
0042:     axis_color, axis_r, axis_c = _find_cross_axes(g, bg)
0043: 
0044:     marker_coords = np.argwhere((g != bg) & (g != axis_color))
0045:     assert marker_coords.size > 0, "expected sparse markers off the cross"
0046: 
0047:     out = g.copy()
0048:     for r0, c0 in marker_coords:
0049:         r = int(r0)
0050:         c = int(c0)
0051:         color = int(g[r, c])
0052:         assert r != axis_r and c != axis_c, "marker pixels must not lie on the cross axes"
0053: 
0054:         for rr in (r, 2 * axis_r - r):
0055:             for cc in (c, 2 * axis_c - c):
0056:                 if not in_bounds(g.shape, rr, cc):
0057:                     continue
0058:                 existing = int(out[rr, cc])
0059:                 assert existing in (bg, color), "reflected marker pixels must not conflict"
0060:                 out[rr, cc] = color
0061: 
0062:     return out
0063: 
