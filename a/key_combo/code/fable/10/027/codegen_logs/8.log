0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Select the majority interior marker color, then redraw the framed board as that color's frame plus its bounding-box outline.
0020: 
0021:     Input structure:
0022:     - The top row is a copied palette made from adjacent equal color pairs.
0023:     - Below it is a one-cell-thick rectangular frame around a black interior.
0024:     - Non-black, non-frame interior pixels are marker colors; one marker color has
0025:       the unique highest count.
0026: 
0027:     Rule:
0028:     - Keep the palette row unchanged.
0029:     - Pick the uniquely most frequent interior marker color.
0030:     - Clear the lower board to black, recolor its outer frame with the picked color,
0031:       and draw the picked color's interior bounding-box border.
0032: 
0033:     Key insight:
0034:     - The noisy marker cloud is not preserved as pixels; only the majority marker
0035:       color and its spatial extent define the output.
0036:     """
0037:     g = np.asarray(grid, dtype=int)
0038:     assert g.ndim == 2, "expected a 2D grid"
0039:     height, width = map(int, g.shape)
0040:     assert height >= 4 and width >= 4, "expected room for a palette row, frame, and interior"
0041: 
0042:     palette = g[0, :].copy()
