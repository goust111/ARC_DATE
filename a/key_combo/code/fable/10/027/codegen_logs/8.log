+    chamber_choices = {
+        0: [(1, 2), (2, 2), (1, 3)],
+        1: [(1, 1), (1, 2), (2, 1), (2, 2)],
+        2: [(1, 2), (2, 1), (2, 2), (1, 3), (3, 1)],
+        3: [(1, 3), (3, 1), (2, 2)],
+    }
+    for _ in range(200):
+        hr, hc = random.choice(chamber_choices[holes])
+        mask = np.ones((2 * hr + 1, 2 * hc + 1), dtype=bool)
+        if holes > 0:
