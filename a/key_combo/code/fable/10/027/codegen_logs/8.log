0096: def _valid_counts(area: int) -> list[int]:
0097:     min_count, max_count = MARKER_COUNT_RANGE
0098:     min_density, max_density = MARKER_DENSITY_RANGE
0099:     return [n for n in range(min_count, max_count + 1) if min_density <= n / area <= max_density]
