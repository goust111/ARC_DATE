        rr, cc = q.popleft()
        for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not ext[nr, nc]:
                ext[nr, nc] = True
                q.append((nr, nc))
    return ext


def _make_object_mask(holes: int) -> np.ndarray:
    chamber_choices = {
        0: [(1, 2), (2, 2), (1, 3)],
        1: [(1, 1), (1, 2), (2, 1), (2, 2)],
        2: [(1, 2), (2, 1), (2, 2), (1, 3), (3, 1)],
