0003: from arc_utils import bbox_h, bbox_w, find_components, get_bg
0004: from arc_utils import paste, random_free_location
0005: 
0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Count same-color patterns per frame and represent the tally as dots inside.
0009: 
0010:     Input structure:
0011:     - bg = most common color.
0012:     - Hollow rectangular frames in various colors.
0013:     - Small monochrome pattern sprites scattered outside frames.
0014: 
0015:     Rule:
0016:     - Remove all small patterns from the grid.
0017:     - For each frame of color C, count how many patterns share color C.
0018:     - Draw that many dots along the frame's center row, spaced by 2, starting from the right.
0019: 
0020:     Key insight: Frames act as tally displays — scattered same-color patterns are "absorbed" and their count is shown as interior dots.
0021:     """
0022:     g = np.array(grid, dtype=int)
0023:     out = g.copy()
0024:     bg = int(get_bg(g))
0025: 
0026:     regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0027: 
0028:     frames: list[dict] = []
0029:     patterns: list[dict] = []
0030:     for comp in regions:
0031:         b = comp["bbox"]
0032:         h = bbox_h(b)
0033:         w = bbox_w(b)
0034:         area = int(comp["area"])
0035:         is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))
0036:         if is_frame:
0037:             frames.append(comp)
0038:         else:
0039:             patterns.append(comp)
0040: 
0041:     # Remove patterns from output.
0042:     for p in patterns:
0043:         for r, c in p["coords"]:
0044:             out[int(r), int(c)] = bg
0045: 
0046:     # For each frame, count matching patterns and draw dots.
0047:     for f in frames:
0048:         col = int(f["color"])
0049:         num_patterns = sum(1 for p in patterns if int(p["color"]) == col)
0050:         if num_patterns <= 0:
0051:             continue
0052: 
0053:         r0, c0, r1, c1 = map(int, f["bbox"])
0054:         r_mid = (r0 + r1) // 2
0055:         for i in range(int(num_patterns)):
0056:             cc = int(c1 - 2 - 2 * i)
0057:             if cc > int(c0):
0058:                 out[int(r_mid), int(cc)] = col
0059: 
0060:     return out
0061: 
