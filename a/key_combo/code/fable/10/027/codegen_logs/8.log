0084: def _quadrant_cells(h: int, w: int, axis_r: int, axis_c: int, quadrant: int) -> list[tuple[int, int]]:
0085:     if quadrant < 2:
0086:         rows = range(0, axis_r)
0087:     else:
0088:         rows = range(axis_r + 1, h)
0089:     if quadrant % 2 == 0:
0090:         cols = range(0, axis_c)
0091:     else:
0092:         cols = range(axis_c + 1, w)
0093:     return [(r, c) for r in rows for c in cols]
0094: 
