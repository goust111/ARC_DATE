0044: def main(grid: np.ndarray) -> np.ndarray:
0045:     """Clean a noisy regular array by reconstructing its repeated rectangular sprite and erasing everything outside the slots.
0046: 
0047:     Input structure
0048:     - The background is the most common color.
0049:     - Non-background cells form a regular grid of solid rectangular sprite slots, plus sparse stray foreground noise.
0050:     - Every slot contains a corrupted copy of the same sprite, preserving non-background occupancy.
0051: 
0052:     Rule
0053:     - Find the dense row bands and dense column bands of the slot array.
0054:     - For each relative position inside the sprite rectangle, take the unique majority color across all slots.
0055:     - Fill every slot with that recovered sprite and set all other cells to background.
0056: 
0057:     Key insight
0058:     - The intended sprite support is the Cartesian product of dense row bands and dense column bands; noise is too sparse to enter the high-density bands consistently.
0059:     """
0060:     g = np.asarray(grid, dtype=int)
0061:     bg = get_bg(g)
0062:     fg = g != bg
0063: 
0064:     row_runs = _dense_runs(fg.sum(axis=1))
0065:     col_runs = _dense_runs(fg.sum(axis=0))
0066:     slot_h = row_runs[0][1] - row_runs[0][0]
0067:     slot_w = col_runs[0][1] - col_runs[0][0]
0068:     assert slot_h > 1 and slot_w > 1
0069:     assert len(row_runs) * len(col_runs) >= 4
0070: 
0071:     blocks = []
0072:     for r0, r1 in row_runs:
0073:         for c0, c1 in col_runs:
0074:             block = g[r0:r1, c0:c1]
0075:             assert block.shape == (slot_h, slot_w)
0076:             assert np.all(block != bg)
0077:             blocks.append(block)
0078: 
0079:     sprite = np.empty((slot_h, slot_w), dtype=int)
0080:     for r in range(slot_h):
0081:         for c in range(slot_w):
0082:             sprite[r, c] = _mode_color([int(block[r, c]) for block in blocks])
0083: 
0084:     out = np.full_like(g, bg)
0085:     for r0, r1 in row_runs:
0086:         for c0, c1 in col_runs:
0087:             out[r0:r1, c0:c1] = sprite
0088:     return out
0089: 
