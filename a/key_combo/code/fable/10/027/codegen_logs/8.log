0016: def main(input_grid):
0017:     """
0018:     Replace the red anchor pixel with a fixed four-corner color pattern.
0019: 
0020:     Input structure:
0021:     - The input is black except for one red pixel.
0022:     - The red pixel marks the center of the output pattern.
0023:     - The output keeps the input shape.
0024: 
0025:     Rule:
0026:     - Locate the red pixel.
0027:     - Create a blank black output canvas.
0028:     - Paste a 3x3 pattern with colored diagonal corners centered on the red pixel.
0029: 
0030:     Key insight:
0031:     - The red pixel is only an anchor and is not copied into the output.
0032:     """
0033:     # Find the red pixel position.
0034:     coords = np.argwhere(input_grid == Color.RED)
0035:     assert coords.shape[0] == 1
0036:     red_r, red_c = map(int, coords[0])
0037: 
0038:     # Construct the specific pattern that is going to be drawn where the red pixel was
0039:     pattern = np.array(
0040:         [
0041:             [Color.GREEN, Color.BLACK, Color.PINK],
0042:             [Color.BLACK, Color.BLACK, Color.BLACK],
0043:             [Color.TEAL, Color.BLACK, Color.ORANGE],
0044:         ]
0045:     )
0046:     
0047:     # Because sprites are anchored by the upper left corner, we are going to need to calculate where the pattern's upper left corner should be
0048:     pattern_r0, pattern_c0 = red_r - 1, red_c - 1
0049: 
0050:     # The output grid is the same size of input grid
0051:     # start with a blank canvas and then lit the pattern
0052:     output_grid = np.full(input_grid.shape, Color.BLACK)
0053:     output_grid = paste(output_grid, pattern, pattern_r0, pattern_c0, clip=True)
0054: 
0055:     return output_grid
