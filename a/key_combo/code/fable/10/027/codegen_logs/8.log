0051:     assert np.all(g[1, :] == frame_color), "top of lower frame must be solid"
0052:     assert np.all(g[-1, :] == frame_color), "bottom of lower frame must be solid"
0053:     assert np.all(g[1:, 0] == frame_color), "left side of lower frame must be solid"
0054:     assert np.all(g[1:, -1] == frame_color), "right side of lower frame must be solid"
0055: 
