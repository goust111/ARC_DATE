+    cur = endpoints[0]
+    while True:
+        nxts = [nbr for nbr in adjacency[cur] if nbr != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "pipe walk must be deterministic"
+        nxt = nxts[0]
+        order.append(nxt)
+        prev, cur = cur, nxt
+    assert len(order) == len(coords), "pipe must be a single connected path"
+    return order
