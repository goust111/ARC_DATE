+        a = (nodes[i][0] - nodes[i - 1][0], nodes[i][1] - nodes[i - 1][1])
+        b = (nodes[i + 1][0] - nodes[i][0], nodes[i + 1][1] - nodes[i][1])
+        if a != b:
