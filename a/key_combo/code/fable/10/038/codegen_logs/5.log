+
+    weighted = [pair for pair in params if pair[0] > 0]
+    first_seed, period = random.choice(weighted or params)
+    second_seed = first_seed + period
+
+    checkpoint_choice = _choose_checkpoint_positions(second_seed, period, path_len)
