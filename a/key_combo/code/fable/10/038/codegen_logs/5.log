+def _render_output(scene: dict) -> np.ndarray:
+    g = scene["grid"]
+    out = g.copy()
+    order = scene["order"]
+    seed_color = scene["seed_color"]
+    seed0, seed1 = scene["seed_indices"]
+    period = scene["period"]
+    checkpoints = scene["checkpoints"]
