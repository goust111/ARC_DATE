+
+def _expand_path(nodes: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
+    for i, (r, c) in enumerate(nodes):
+        fr, fc = 2 * r + 1, 2 * c + 1
+        if i == 0:
+            order.append((fr, fc))
+            continue
+        pr, pc = order[-1]
+        mr, mc = (pr + fr) // 2, (pc + fc) // 2
+        order.append((mr, mc))
+        order.append((fr, fc))
