spec:
  grid: 10-19 rows x 10-19 cols, single bg color (any color 0-9)
  legend:
    position: vertical stack of 2-col-wide rows near bottom-left (col 0-2), bottom row at or within 1 of grid bottom
    entries: 2-5 rows, each row = (marker_color, fill_color); read bottom-to-top for processing order
