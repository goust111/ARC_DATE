+    patch = np.zeros((total, 1), dtype=int)
+    if next_color is None:
+        patch[:, 0] = body_color
+    elif cap_left:
+        patch[0, 0] = next_color
+        patch[1:, 0] = body_color
+    else:
+        patch[:-1, 0] = body_color
+        patch[-1, 0] = next_color
+    return patch
+
+
+def _distractor_patch(kind: str, orientation: str, colors: list[int]) -> np.ndarray:
