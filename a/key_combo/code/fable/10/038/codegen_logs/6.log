+
+def _valid_locations(grid: np.ndarray, reserved: np.ndarray, patch: np.ndarray, padding: int = 1) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    locs: list[tuple[int, int]] = []
+    for r0 in range(h - ph + 1):
