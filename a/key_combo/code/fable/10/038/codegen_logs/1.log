    return out


def _gen_bbox_gap(
    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
) -> int:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    if ar1 < br0:
        row_gap = br0 - ar1
    elif br1 < ar0:
        row_gap = ar0 - br1
    else:
