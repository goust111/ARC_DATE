    paste(inp, control, ctl_r, ctl_c)
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    rows, cols = _GEN_VALID_DIMS[int(np.random.randint(len(_GEN_VALID_DIMS)))]
    template = _gen_template_mask()
    control = _gen_control_matrix(rows, cols)
