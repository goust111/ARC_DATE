            continue
        if not np.all(control_mask[r0 : r1 + 1, c0 : c1 + 1]):
            continue

        candidates.append((color, rows, cols, by_anchor, control_bbox))

    assert len(candidates) == 1, "expected one template lattice with a matching control matrix"
    return candidates[0]


