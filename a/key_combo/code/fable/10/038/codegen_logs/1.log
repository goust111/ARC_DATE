+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+SIDE_TO_ROT_K = {
+    "top": 0,
+    "right": 3,   # clockwise 90
+    "bottom": 2,
+    "left": 1,    # counterclockwise 90
+}
+SIDES = ("top", "right", "bottom", "left")
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+BG_COLOR = 0
+N_RANGE = (3, 5)
+TEMPLATE_DENSITY_RANGE = (0.32, 0.62)
+EXTRA_SOURCE_PIXELS_RANGE = (0, 3)
+GEN_RETRIES = 400
