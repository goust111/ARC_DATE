+
+def _extra_mover(
+    grid_shape: tuple[int, int],
+    occupied: np.ndarray,
+    blocked: np.ndarray,
+    direction: str,
+    driver_color: int,
+    body_color: int,
+    used_distances: set[int],
+) -> dict | None:
+    gh, gw = grid_shape
+    for _ in range(100):
+        h, w = _random_shape()
+        distances = [d for d in _available_distance_values(gh, gw) if d not in used_distances]
+        if not distances:
+            return None
+        d = random.choice(distances)
+        if direction == "top":
+            top = 1 + d
+            if top + h - 1 > gh - 2:
+                continue
+            left = random.randint(1, gw - w - 1)
+        elif direction == "bottom":
+            top = gh - 1 - h - d
+            if top < 1:
