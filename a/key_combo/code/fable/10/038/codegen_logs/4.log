+def _path_box(
+    top: int,
+    left: int,
+    h: int,
+    w: int,
+    side: str,
+    grid_shape: tuple[int, int],
+    *,
+    blocked_top: int | None = None,
+    blocked_left: int | None = None,
+) -> tuple[int, int, int, int]:
