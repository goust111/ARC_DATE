+        if extra_static is not None:
+            ph, pw = extra_static["patch"].shape
+            _mark(occupied, (extra_static["top"], extra_static["left"], extra_static["top"] + ph - 1, extra_static["left"] + pw - 1))
+            objects.append(extra_static)
