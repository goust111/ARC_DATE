+def _touches_reserved(mask: np.ndarray, box: tuple[int, int, int, int], *, pad: int = 1) -> bool:
+    r0, c0, r1, c1 = box
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(mask.shape[0] - 1, r1 + pad)
+    cc1 = min(mask.shape[1] - 1, c1 + pad)
