+    core_rear = [obj for obj in moving if obj.get("core") == "rear"]
+    if len(core_front) != 1 or len(core_rear) != 1:
+        return False
+    front = core_front[0]
+    rear = core_rear[0]
+    front_h, front_w = front["patch"].shape
+    rear_h, rear_w = rear["patch"].shape
+    if core_direction == "top":
