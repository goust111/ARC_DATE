            paste(out, np.where(template, control[i, j], _GEN_BACKGROUND_COLOR), rr, cc)
            paste(inp, input_cell, rr, cc)
    paste(out, control, ctl_r, ctl_c)
    paste(inp, control, ctl_r, ctl_c)
    return inp, out


