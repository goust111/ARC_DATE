+            local_pixels.append((r - r0, c - c0, color))
+        objects.append(
+            {
+                "coords": abs_coords,
+                "bbox": (r0, c0, r1, c1),
+                "driver_color": driver_color,
+                "body_color": body_color,
+                "driver_cell": driver_cells[0],
+                "pixels": local_pixels,
+                "shape": (r1 - r0 + 1, c1 - c0 + 1),
