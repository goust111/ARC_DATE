+        if sum(counts) != n_markers or max(counts) < 2:
+            continue
+        return counts
+
+
+def _build_token_sequence(length: int, counts: list[int], rng: random.Random) -> list[tuple[str, int | None]]:
+    n_markers = sum(counts)
