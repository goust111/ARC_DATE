+        next_is_head = ring_vals[next_idx] not in {bg, frame_color, tail_color}
+        assert prev_is_head ^ next_is_head, "each tail must touch exactly one head"
+        if next_is_head:
+            directions.add(1)
+            head_idx = next_idx
