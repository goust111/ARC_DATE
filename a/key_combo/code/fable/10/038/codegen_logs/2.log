+def _positive_composition(total: int, parts: int, rng: random.Random) -> list[int]:
+    assert total >= parts >= 1
+    cuts = sorted(rng.sample(range(1, total), parts - 1))
+    out: list[int] = []
+    prev = 0
+    for cut in cuts + [total]:
+        out.append(cut - prev)
+        prev = cut
+    return out
+
