def _signal_direction(g: np.ndarray, bg: int) -> tuple[int, int, int]:
    edges = [
        ("top", g[0, :], (-1, 0)),
        ("bottom", g[-1, :], (1, 0)),
        ("left", g[:, 0], (0, -1)),
        ("right", g[:, -1], (0, 1)),
