+        if int(piece_a_full[h - 1 - r, w - 1 - c]) != int(piece_b_full[h - 1 - r, w - 1 - c]):
+            local_shortcut_fail = True
+    for r, c in hole_targets_b:
+        if int(piece_b_full[h - 1 - r, w - 1 - c]) != int(piece_a_full[h - 1 - r, w - 1 - c]):
+            local_shortcut_fail = True
+    if not local_shortcut_fail:
+        return None
+
+    min_h = max(h + 4, 18)
+    min_w = max(w + 4, 18)
