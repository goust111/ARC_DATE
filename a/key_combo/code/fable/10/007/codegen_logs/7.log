+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, transparent: int) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != transparent
+    assert not np.any((view != transparent) & mask)
+    view[mask] = patch[mask]
+
+
+def find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return components
+
+
+def connector_dir(sprite: np.ndarray, r: int, c: int) -> tuple[int, int]:
+    h, w = sprite.shape
+    dirs = []
+    if r == 0:
+        dirs.append((-1, 0))
+    if r == h - 1:
+        dirs.append((1, 0))
+    if c == 0:
+        dirs.append((0, -1))
+    if c == w - 1:
+        dirs.append((0, 1))
+    assert len(dirs) == 1
+    return dirs[0]
+
+
+def rot180(arr: np.ndarray) -> np.ndarray:
+    return arr[::-1, ::-1].copy()
+
+
+def internal_hole_mask(grid: np.ndarray, bg: int) -> np.ndarray:
+    h, w = grid.shape
+    bg_mask = grid == bg
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
