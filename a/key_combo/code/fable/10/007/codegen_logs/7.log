+
+
+def _scatter_positions(shape: tuple[int, int], patch_shape: tuple[int, int], rng: random.Random) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    h, w = patch_shape
+    H, W = shape
+    positions = []
+    for _ in range(200):
