+    h, w = mask.shape
+    accent_pool = [(r, c) for r, c in _interior_candidates(mask) if (r, c) not in port_rows]
+    rng.shuffle(accent_pool)
+
+    accent_count = rng.randint(3, min(7, max(3, len(accent_pool))))
