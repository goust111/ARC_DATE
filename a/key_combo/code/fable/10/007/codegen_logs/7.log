+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, transparent: int) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != transparent
+    assert not np.any((view != transparent) & mask)
+    view[mask] = patch[mask]
+
+
+def find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
