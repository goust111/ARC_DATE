  "type": "symmetry/pattern",
  "src": "identical foreground sprites occupying a complete row and a complete column of a rectangular lattice",
  "dst": "empty row-column intersections of that sprite lattice",
  "transform": "stamp each missing intersection with the same sprite mask in teal, preserving the original foreground sprites"
}
</annotation>
