+    h, w = out.shape
+    for rr, cc in np.argwhere(holes):
+        r = int(rr)
+        c = int(cc)
+        sr = h - 1 - r
+        sc = w - 1 - c
+        assert int(out[sr, sc]) != bg
+        out[r, c] = int(out[sr, sc])
