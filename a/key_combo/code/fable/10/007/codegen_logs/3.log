+    inp: np.ndarray,
+    out: np.ndarray,
+    row_masks: list[np.ndarray],
+    col_masks: list[np.ndarray],
+    full: list[list[np.ndarray]],
+    occ: np.ndarray,
+    rows: list[int],
+    cols: list[int],
