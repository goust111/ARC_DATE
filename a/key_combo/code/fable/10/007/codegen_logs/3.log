+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    out = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            out.append((r + dr, c + dc))
+    return out
