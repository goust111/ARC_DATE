+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+SLOT = 3
+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+ROW_COUNT_RANGE = (3, 4)
+COL_COUNT_RANGE = (3, 4)
+GAP_RANGE = (4, 7)
+MARGIN_RANGE = (1, 3)
+MAX_DIM = 30
+MAX_ATTEMPTS = 400
