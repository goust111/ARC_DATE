+    out = g.copy()
+    for r in rows:
+        for c in cols:
+            if (r, c) in occupied:
+                continue
+            mask = row_templates[r] & col_templates[c]
+            assert mask.any(), "every synthesized sprite must be visible"
+            assert _mask_connected(mask), "synthesized sprites must stay 8-connected"
