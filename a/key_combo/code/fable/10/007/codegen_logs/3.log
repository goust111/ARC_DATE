+    col_axis = _sample_axis(len(col_masks))
+    assert row_axis is not None and col_axis is not None
+    h, rows = row_axis
+    w, cols = col_axis
+    color = random.choice(PALETTE)
+
+    inp = np.zeros((h, w), dtype=int)
+    out = np.zeros((h, w), dtype=int)
