+
+
+def _build_candidates() -> list[np.ndarray]:
+    out = []
+    for bits in range(1 << (SLOT * SLOT)):
+        if (bits & 1) == 0:
+            continue
+        mask = np.zeros((SLOT, SLOT), dtype=bool)
