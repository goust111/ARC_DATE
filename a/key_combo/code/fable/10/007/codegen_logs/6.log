+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+BLOCK = 2
+EDGE_MARGIN = 1
+VISIT_CYCLE = (BLUE, YELLOW, GREEN)
+
+GEN_ATTEMPTS = 400
+GEN_ROW_RANGE = (20, 29)
+GEN_COL_RANGE = (20, 29)
+GEN_EXTRA_PATH_MAX = 3
+GEN_ISOLATED_MAX = 2
