+    return all(not _overlaps(pos, other) for other in occupied)
+
+
+def _shares_band_with_any(pos: tuple[int, int], blocks: list[tuple[int, int]], *, allow: set[tuple[int, int]] | None = None) -> bool:
+    allow = allow or set()
+    for block in blocks:
+        if block in allow:
+            continue
+        if pos[0] == block[0] or pos[1] == block[1]:
