+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    shape = (
+        int(rng.integers(GEN_ROW_RANGE[0], GEN_ROW_RANGE[1])),
+        int(rng.integers(GEN_COL_RANGE[0], GEN_COL_RANGE[1])),
+    )
+
+    axis_in = int(rng.choice((0, 1)))
