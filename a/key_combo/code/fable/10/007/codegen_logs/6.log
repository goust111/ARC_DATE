+    return False
+
+
+def _render_grid(shape: tuple[int, int], start: tuple[int, int], targets: list[tuple[int, int]]) -> np.ndarray:
+    grid = np.full(shape, BLACK, dtype=int)
+    sr, sc = start
+    grid[sr : sr + BLOCK, sc : sc + BLOCK] = RED
+    for r, c in targets:
