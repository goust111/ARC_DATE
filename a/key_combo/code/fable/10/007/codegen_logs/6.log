+
+    visited = set(order)
+    for index, block in enumerate(order):
+        r, c = block
+        if not np.all(out[r : r + BLOCK, c : c + BLOCK] == VISIT_CYCLE[index % len(VISIT_CYCLE)]):
+            return False
+    for block in targets:
+        if block in visited:
+            continue
+        r, c = block
+        if not np.all(out[r : r + BLOCK, c : c + BLOCK] == GREY):
