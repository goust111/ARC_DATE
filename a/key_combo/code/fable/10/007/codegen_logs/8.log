+            if not _rotation_ambiguity(stamps):
+                continue
+            solutions = _full_solutions(grid.shape, stamps)
+            if len(solutions) != 1:
+                continue
+            try:
+                out = main(grid)
+            except Exception:
+                continue
+            if out.shape != grid.shape:
+                continue
+            if np.count_nonzero(out != grid) != int(shape_mask.sum()) * 2:
+                continue
+            return grid
+    return None
+
