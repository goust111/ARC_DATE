+
+def _rotate_cw(mask: np.ndarray, turns: int) -> np.ndarray:
+    return np.rot90(mask, -int(turns))
+
+
+def _mask_key(mask: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in mask.ravel())
