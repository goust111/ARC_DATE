+    rng.shuffle(start_pairs)
+    margin_choices = [(r, s, b) for r in range(0, 3) for s in range(1, 4) for b in range(0, 3)]
+    rng.shuffle(margin_choices)
+
+    for start_a, start_b in start_pairs:
+        pos_a = _sequence_positions(start_a, first_gap_a, len_a)
+        pos_b = _sequence_positions(start_b, first_gap_b, len_b)
