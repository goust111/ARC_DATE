+    len_a = rng.choice([3, 4])
+    len_b = rng.choice([3, 4])
+    first_gap_a = rng.randint(1, 4)
+    first_gap_b = rng.randint(1, 4)
+    current_gap_a = first_gap_a + len_a - 2
+    current_gap_b = first_gap_b + len_b - 2
+    if current_gap_a == current_gap_b:
+        return None
+    if not _overlapping_gap_ranges(first_gap_a, len_a, first_gap_b, len_b):
+        return None
+
+    start_ori_a = rng.randint(0, 3)
+    start_ori_b = rng.randint(0, 3)
+    ori_a = [(start_ori_a + i) % 4 for i in range(len_a)]
+    ori_b = [(start_ori_b + i) % 4 for i in range(len_b)]
+    if ori_a[-1] == ori_b[-1]:
+        return None
+    canonical_shape = min([_rotate_cw(shape_mask, k) for k in range(4)], key=_mask_key)
+    start_pairs = [(a, b) for a in range(0, 12) for b in range(0, 12) if a != b]
+    rng.shuffle(start_pairs)
+    margin_choices = [(r, s, b) for r in range(0, 3) for s in range(1, 4) for b in range(0, 3)]
+    rng.shuffle(margin_choices)
+
+    for start_a, start_b in start_pairs:
+        pos_a = _sequence_positions(start_a, first_gap_a, len_a)
+        pos_b = _sequence_positions(start_b, first_gap_b, len_b)
+        existing = pos_a + pos_b
+        if any(
+            abs(existing[i] - existing[j]) < BOX
+            for i in range(len(existing))
+            for j in range(i + 1, len(existing))
+        ):
+            continue
+
+        next_a = pos_a[-1] + BOX + current_gap_a + 1
+        next_b = pos_b[-1] + BOX + current_gap_b + 1
+        future = [next_a, next_b]
+        if abs(next_a - next_b) < BOX:
+            continue
+        if any(abs(nxt - cur) < BOX for nxt in future for cur in existing):
+            continue
+
+        left_to_right = sorted(
+            [(p, "A", o) for p, o in zip(pos_a, ori_a)] + [(p, "B", o) for p, o in zip(pos_b, ori_b)]
+        )
+        labels = [label for _p, label, _o in left_to_right]
+        if _switch_count(labels) < MIN_SWITCHES:
+            continue
+        alternating_a = ["A" if i % 2 == 0 else "B" for i in range(len(labels))]
+        alternating_b = ["B" if i % 2 == 0 else "A" for i in range(len(labels))]
+        if labels == alternating_a or labels == alternating_b:
+            continue
+        if not _global_orientation_misdirection(left_to_right):
+            continue
+
+        for row_margin, side_margin, bottom_margin in margin_choices:
+            abstract_all = existing + future
+            t_min = min(abstract_all)
+            t_max = max(abstract_all)
+            width = (t_max - t_min) + BOX + side_margin * 2
+            height = row_margin + BOX + bottom_margin
+            if width > 30 or height > 30:
+                continue
+
+            grid = _render_instance(
+                shape_mask,
+                color,
+                sign,
+                (pos_a, ori_a),
+                (pos_b, ori_b),
+                row_margin=row_margin,
+                side_margin=side_margin,
+                bottom_margin=bottom_margin,
+                canvas_positions=abstract_all,
