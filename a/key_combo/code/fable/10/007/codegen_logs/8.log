+    len_a = rng.choice([3, 4])
+    len_b = rng.choice([3, 4])
+    first_gap_a = rng.randint(1, 4)
+    first_gap_b = rng.randint(1, 4)
+    current_gap_a = first_gap_a + len_a - 2
+    current_gap_b = first_gap_b + len_b - 2
+    if current_gap_a == current_gap_b:
+        return None
+    if not _overlapping_gap_ranges(first_gap_a, len_a, first_gap_b, len_b):
+        return None
+
+    start_ori_a = rng.randint(0, 3)
+    start_ori_b = rng.randint(0, 3)
+    ori_a = [(start_ori_a + i) % 4 for i in range(len_a)]
+    ori_b = [(start_ori_b + i) % 4 for i in range(len_b)]
