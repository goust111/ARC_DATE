import numpy as np, random
from collections import deque


def connected(mask):
    pts = np.argwhere(mask)
    if len(pts)==0: return False
    H,W=mask.shape
    q=deque([tuple(pts[0])])
    seen={tuple(pts[0])}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc));q.append((nr,nc))
    return len(seen)==len(pts)

def rot(mask,k):
    return np.rot90(mask,-k)

def pool():
    out=[]
    for bits in range(1,1<<9):
        m=np.zeros((3,3),dtype=bool)
        for i in range(9):
            if bits>>i & 1: m[i//3,i%3]=1
        if not (4<=m.sum()<=6): continue
        if not connected(m): continue
        if not (m[0,:].any() and m[2,:].any() and m[:,0].any() and m[:,2].any()): continue
        rots=[rot(m,k) for k in range(4)]
        enc={tuple(x.flatten()) for x in rots}
        if len(enc)"'!=4: continue
        out.append(m)
    return out
