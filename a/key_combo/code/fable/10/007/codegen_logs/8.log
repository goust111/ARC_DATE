+    pos_b, ori_b = seq_b
+    all_t = list(pos_a + pos_b) if canvas_positions is None else list(canvas_positions)
+    t_min = min(all_t)
+    t_max = max(all_t)
+    width = (t_max - t_min) + BOX + side_margin * 2
+    height = row_margin + BOX + bottom_margin
+    grid = np.zeros((height, width), dtype=int)
+    row = row_margin
