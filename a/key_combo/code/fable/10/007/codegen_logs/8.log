import itertools
BOX=3

def seq_positions(start,g0,n):
    ps=[start]
    for i in range(n-1): ps.append(ps[-1]+BOX+g0+i)
    return ps

def matches(stamps, indices, sign, req_gap, req_rot):
    order=sorted(indices,key=lambda i: sign*stamps[i][0])
    gaps=[sign*(stamps[order[i+1]][0]-stamps[order[i]][0])-BOX for i in range(len(order)-1)]
    if any(g<0 for g in gaps): return False
    if req_gap and any(gaps[i+1]"'!=gaps[i]+1 for i in range(len(gaps)-1)): return False
    ors=[stamps[i][1] for i in order]
    if req_rot and any((ors[i+1]-ors[i])%4!=1 for i in range(len(ors)-1)): return False
    return True

def full_solutions(stamps,W):
    n=len(stamps)
    out=[]
    for sign in (1,-1):
        for mask in range(1<<(n-1)):
            A=[0];B=[]
            for j,idx in enumerate(range(1,n)):
                (B if ((mask>>j)&1) else A).append(idx)
            if min(len(A),len(B))<2: continue
            if not matches(stamps,tuple(A),sign,True,True): continue
            if not matches(stamps,tuple(B),sign,True,True): continue
            nexts=[]
            for G in (A,B):
                order=sorted(G,key=lambda i: sign*stamps[i][0])
                gaps=[sign*(stamps[order[i+1]][0]-stamps[order[i]][0])-BOX for i in range(len(order)-1)]
                nc=stamps[order[-1]][0]+sign*(BOX+gaps[-1]+1)
                if not (0<=nc<=W-BOX):
                    break
                nexts.append(nc)
            else:
                if abs(nexts[0]-nexts[1])<BOX: continue
                if any(abs(n-p[0])<BOX for n in nexts for p in stamps): continue
                out.append((sign,tuple(A),tuple(B),tuple(nexts)))
    return out

def rot_parts(stamps):
    n=len(stamps); cnt=0
    for sign in (1,-1):
        for mask in range(1<<(n-1)):
            A=[0];B=[]
            for j,idx in enumerate(range(1,n)):
                (B if ((mask>>j)&1) else A).append(idx)
            if min(len(A),len(B))<2: continue
            if matches(stamps,tuple(A),sign,False,True) and matches(stamps,tuple(B),sign,False,True):
                cnt+=1
    return cnt

seen=0
for lens in [(2,3),(3,2),(2,4),(4,2),(3,3)]:
