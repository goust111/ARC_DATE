+            abs(existing[i] - existing[j]) < BOX
+            for i in range(len(existing))
+            for j in range(i + 1, len(existing))
+        ):
+            continue
+
+        next_a = pos_a[-1] + BOX + current_gap_a + 1
+        next_b = pos_b[-1] + BOX + current_gap_b + 1
+        future = [next_a, next_b]
