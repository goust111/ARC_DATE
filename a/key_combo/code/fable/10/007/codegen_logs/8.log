+
+def _paint_patch(grid: np.ndarray, mask: np.ndarray, r: int, c: int, color: int, orientation: int) -> None:
+    patch = _rotate_cw(mask, orientation)
+    grid[r : r + BOX, c : c + BOX][patch] = int(color)
