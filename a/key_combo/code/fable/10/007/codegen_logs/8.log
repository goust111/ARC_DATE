+            height = row_margin + BOX + bottom_margin
+            if width > 30 or height > 30:
+                continue
+
+            grid = _render_instance(
+                shape_mask,
+                color,
+                sign,
+                (pos_a, ori_a),
+                (pos_b, ori_b),
+                row_margin=row_margin,
+                side_margin=side_margin,
+                bottom_margin=bottom_margin,
+            )
