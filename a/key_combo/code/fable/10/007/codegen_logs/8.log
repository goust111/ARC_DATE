+        mask = patch != bg
+        key = _mask_key(mask)
+        assert key in orientation_map, "all components must be rotated copies of one footprint"
+        top_rows.add(int(r0))
+        stamps.append({"r": int(r0), "c": int(c0), "o": int(orientation_map[key])})
