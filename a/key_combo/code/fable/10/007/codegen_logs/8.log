+    order = _ordered_indices(stamps, indices, sign)
+    gaps = [
+        sign * (stamps[order[i + 1]]["c"] - stamps[order[i]]["c"]) - BOX
+        for i in range(len(order) - 1)
+    ]
+    if any(gap <= 0 for gap in gaps):
+        return None
+    next_gap = gaps[-1] + 1
+    last = stamps[order[-1]]
+    next_c = last["c"] + sign * (BOX + next_gap)
+    next_r = last["r"]
