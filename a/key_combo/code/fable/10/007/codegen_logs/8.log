+            cs = [p[1] for p in cells]
+            r0 = min(rs)
+            r1 = max(rs)
+            c0 = min(cs)
+            c1 = max(cs)
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            components.append(
