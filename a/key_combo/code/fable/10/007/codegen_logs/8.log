                            stamps=sorted([(p,o) for p,o in zip(pa,oria)] + [(p,o) for p,o in zip(pb,orib)])
                            future=[pa[-1]+BOX+(g0a+la-2)+1,pb[-1]+BOX+(g0b+lb-2)+1]
                            W=(max(pa+pb+future)-min(pa+pb+future))+BOX+2
                            if W>30: continue
                            sols=full_solutions(stamps,W)
                            if len(sols)==1:
                                labels=[]
                                for p,o in stamps:
                                    labels.append('"'A' if (p,o) in list(zip(pa,oria)) else 'B')
                                print('lens',lens,'g',g0a,g0b,'s',sa,sb,'o',oa,ob,'labels',''.join(labels),'rotparts',rot_parts(stamps),'W',W,'sol',sols[0])
                                found+=1
                                if found>=10: raise SystemExit
    print('done',lens,found)
