+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rs = [p[0] for p in cells]
+            cs = [p[1] for p in cells]
+            r0 = min(rs)
+            r1 = max(rs)
+            c0 = min(cs)
+            c1 = max(cs)
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            components.append(
