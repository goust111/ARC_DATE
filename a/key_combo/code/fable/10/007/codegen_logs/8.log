+
+def _connected_4(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(coords)
+
+
+def _shape_pool() -> list[np.ndarray]:
+    pool: list[np.ndarray] = []
+    for bits in range(1, 1 << (BOX * BOX)):
+        mask = np.zeros((BOX, BOX), dtype=bool)
+        for bit in range(BOX * BOX):
+            if (bits >> bit) & 1:
+                mask[bit // BOX, bit % BOX] = True
+        count = int(mask.sum())
+        if not (4 <= count <= 6):
+            continue
+        if not _connected_4(mask):
+            continue
+        if not (mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
+        rotations = [_rotate_cw(mask, k) for k in range(4)]
+        if len({_mask_key(rot) for rot in rotations}) != 4:
+            continue
+        pool.append(mask)
+    assert pool, "expected at least one usable footprint shape"
+    return pool
+
+
+SHAPE_POOL = _shape_pool()
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict[str, object]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rs = [p[0] for p in cells]
+            cs = [p[1] for p in cells]
+            r0 = min(rs)
+            r1 = max(rs)
+            c0 = min(cs)
+            c1 = max(cs)
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            components.append(
+                {
+                    "color": color,
+                    "cells": tuple(cells),
+                    "bbox": (r0, c0, r1, c1),
+                    "patch": patch.copy(),
