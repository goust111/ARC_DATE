+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BOX = 3
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 2000
+MIN_SWITCHES = 2
