+def _direct_seed_info(rects, seeds):
+    descendants = [[] for _ in rects]
+    for i, rect in enumerate(rects):
+        for j, other in enumerate(rects):
+            if i != j and _strict_contains(rect, other):
+                descendants[i].append(j)
+
+    counts = [0] * len(rects)
+    colors = [None] * len(rects)
