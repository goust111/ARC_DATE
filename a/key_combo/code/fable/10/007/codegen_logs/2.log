+        c0, c1 = c1, c0
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _border_cells(rect):
+    r0, c0, r1, c1 = rect
+    cells = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _interior_cells(rect):
+    r0, c0, r1, c1 = rect
+    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+
