_DISTRACTOR_HEIGHTS, _DISTRACTOR_WIDTHS = range(3, 8), range(4, 8)
_DISTRACTOR_CELLS_RANGE = range(8, 33)
_DISTRACTOR_HOLE_MIN_AREA, _SNAKE_HOLE_WIDTH = 3, 3
