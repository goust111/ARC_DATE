SPRITE_MASK[SPRITE_CENTER, SPRITE_CENTER] = False
BLUE_PATCH = np.where(SPRITE_MASK, ORIGINAL_COLOR, BACKGROUND_COLOR)
TEAL_PATCH = np.where(SPRITE_MASK, FILL_COLOR, BACKGROUND_COLOR)
