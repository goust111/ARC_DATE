+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color in {bg, GREEN, YELLOW}:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            cells = [(r, c)]
+            while queue:
+                cr, cc = queue.popleft()
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+                    cells.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return objects
