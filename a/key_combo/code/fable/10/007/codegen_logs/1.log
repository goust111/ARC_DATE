_GAP_HEIGHTS, _GAP_WIDTHS = range(1, 4), range(1, 3)
_GAP_SHAPES = [(r, c) for r in _GAP_HEIGHTS for c in _GAP_WIDTHS]
_TARGET_SAME_SHAPE_CHOICES = [False, True]

