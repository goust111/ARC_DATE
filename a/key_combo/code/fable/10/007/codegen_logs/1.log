+        new_pos = slot_positions[int(new_slot)]
+        delta = new_pos - old_pos
+        coords = obj["coords"]
+        rr = coords[:, 0] + (delta if axis == "v" else 0)
+        cc = coords[:, 1] + (delta if axis == "h" else 0)
