+    slots = [int(obj["slot_index"]) for obj in objects]
+    occupied = {slot: idx for idx, slot in enumerate(slots)}
+    events = []
+
+    for idx in order:
+        start = slots[idx]
+        occupied.pop(start)
+        dest = start
+        blocked = False
+        capped = False
+        steps = 1 if unit_steps else int(objects[idx]["area"])
+        for _ in range(steps):
+            cand = dest + 1
+            if cand >= slot_count:
+                capped = True
+                break
+            if cand in occupied:
+                blocked = True
+                break
+            dest = cand
+            if dest == slot_count - 1:
+                capped = True
+                break
+        slots[idx] = dest
+        occupied[dest] = idx
+        events.append(
+            {
+                "object": idx,
+                "start": start,
+                "end": dest,
+                "blocked": blocked,
+                "capped": capped,
+            }
+        )
