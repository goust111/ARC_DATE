+def _make_tile(pr: int, pc: int, colors: list[int]) -> np.ndarray | None:
+    for _ in range(200):
+        tile = np.random.choice(colors, size=(pr, pc))
+        if len(np.unique(tile)) < min(len(colors), 3):
