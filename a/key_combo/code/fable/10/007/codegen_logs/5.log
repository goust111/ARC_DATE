   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """Move every object above the solid bottom stripe upward by its own pixel count.
   9: 
  10:     Input structure
  11:     The grid has a dominant background, exactly one full-width non-background row
  12:     that acts as a fixed stripe, and one or more 4-connected monochrome objects
  13:     above that stripe.
  14: 
  15:     Rule
  16:     Clear each object from its original cells, then translate it straight upward
  17:     by the number of pixels in that object, preserving its shape and color. Leave
  18:     the full-width stripe unchanged.
  19: 
  20:     Key insight
  21:     Each object's area is also its vertical displacement; the full-width row is a
  22:     fixed baseline, not a moving object.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     h, w = g.shape
  26:     bg = get_bg(g)
  27: 
  28:     stripe_rows = [
  29:         r
  30:         for r in range(h)
  31:         if np.unique(g[r]).size == 1 and int(g[r, 0]) != bg
  32:     ]
  33:     assert len(stripe_rows) == 1
  34:     stripe_row = stripe_rows[0]
  35:     assert stripe_row == h - 1
  36: 
  37:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  38:     stripe_components = []
  39:     moving_objects = []
  40:     for component in components:
  41:         coords = component["coords"]
  42:         is_stripe = int(component["area"]) == w and np.all(coords[:, 0] == stripe_row)
  43:         if is_stripe:
  44:             stripe_components.append(component)
  45:         else:
  46:             assert np.all(coords[:, 0] < stripe_row)
  47:             moving_objects.append(component)
  48: 
  49:     assert len(stripe_components) == 1
  50:     assert moving_objects
  51: 
  52:     out = g.copy()
  53:     for component in moving_objects:
  54:         coords = component["coords"]
  55:         out[coords[:, 0], coords[:, 1]] = bg
  56: 
  57:     occupied = np.zeros(g.shape, dtype=bool)
  58:     occupied[stripe_row, :] = True
  59: 
  60:     for component in moving_objects:
  61:         coords = component["coords"]
  62:         target = coords.copy()
  63:         target[:, 0] -= int(component["area"])
  64: 
  65:         assert np.all(target[:, 0] >= 0)
  66:         assert not np.any(occupied[target[:, 0], target[:, 1]])
  67: 
  68:         occupied[target[:, 0], target[:, 1]] = True
  69:         out[target[:, 0], target[:, 1]] = int(component["color"])
  70: 
  71:     return out
