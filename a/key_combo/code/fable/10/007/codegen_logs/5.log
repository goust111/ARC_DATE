 193: def _gen2_symmetric_sprite(color):
 194:     """Generate one connected LR+UD symmetric sprite with a filled center."""
 195:     h = random.choice(SPRITE_HEIGHT_CHOICES)
 196:     w = random.choice(SPRITE_WIDTH_CHOICES)
 197:     if random.random() < SPRITE_DIM_SWAP_PROB:
 198:         h, w = w, h
 199: 
 200:     if h == 1 and w == 1:
 201:         return np.array([[color]])
 202: 
 203:     half_h = h // 2 + 1
 204:     half_w = w // 2 + 1
 205:     sprite = np.zeros((h, w), dtype=int)
 206:     cr, cc = h // 2, w // 2
 207:     sprite[cr, cc] = color
 208: 
 209:     for r in range(half_h):
 210:         for c in range(half_w):
 211:             if random.random() < SPRITE_QUADRANT_FILL_PROB:
 212:                 sprite[r, c] = color
 213:                 sprite[r, w - 1 - c] = color
 214:                 sprite[h - 1 - r, c] = color
 215:                 sprite[h - 1 - r, w - 1 - c] = color
 216: 
 217:     sprite[cr, cc] = color
 218: 
 219:     from arc_utils import is_contiguous
 220:     mask = (sprite != 0)
