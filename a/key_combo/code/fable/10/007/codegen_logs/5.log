  "type": "transform_in_place",
  "src": "4-connected black components on a grey field",
  "transform": "within each component, find all solid black rectangles with height and width at least 2; recolor every maximum-area rectangle red, including ties, and leave all other pixels unchanged"
}
</annotation>
<generation_spec>
