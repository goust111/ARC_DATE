+def _candidate_centers(shape: tuple[int, int], side: str) -> list[tuple[int, int]]:
+    h, w = shape
+    coords = []
+    if side == "top":
+        for r in range(3, h - 2):
+            for c in range(2, w - 2):
+                coords.append((r, c))
+    elif side == "bottom":
