+        inner = int(sprite["inner"])
+        stamp = tuple(sprite["stamp"])
+        side = str(sprite["side"])
+
+        if side in ("top", "bottom"):
+            out[stamp[0]] = outer
+            out[stamp[1]] = inner
+            out[stamp[2]] = outer
+        else:
+            out[stamp[0]] = outer
+            out[stamp[1]] = inner
+            out[stamp[2]] = outer
+
+    return out
+
+
+GRID_HEIGHT_RANGE = (14, 23)
+GRID_WIDTH_RANGE = (14, 23)
+SPRITE_COUNT_RANGE = (2, 5)
