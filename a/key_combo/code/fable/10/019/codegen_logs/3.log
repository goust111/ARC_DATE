+            expanded = _expanded_body(center, shape)
+            path, hit, stamp = _ray_geometry(shape, center, side)
+            path_set = set(path)
+            stamp_set = set(stamp)
+
+            if body & used_body_cells:
+                continue
+            if any(expanded & other for other in expanded_bodies):
+                continue
+            if body & used_path_cells:
+                continue
+            if path_set & used_body_cells:
+                continue
+            if path_set & used_path_cells:
+                continue
+            if stamp_set & used_stamp_cells:
+                continue
+
+            sprite = {
+                "center": center,
+                "outer": outer,
+                "inner": inner,
+                "side": side,
+                "body": body,
+                "path": path,
+                "hit": hit,
+                "stamp": stamp,
+            }
+            placed.append(sprite)
+            used_body_cells.update(body)
+            used_path_cells.update(path_set)
+            used_stamp_cells.update(stamp_set)
+            expanded_bodies.append(expanded)
+
+            if search(i + 1):
+                return True
+
+            placed.pop()
+            used_body_cells.difference_update(body)
+            used_path_cells.difference_update(path_set)
+            used_stamp_cells.difference_update(stamp_set)
+            expanded_bodies.pop()
+
+        return False
+
+    return placed if search(0) else None
+
+
+def _choose_scene() -> dict[str, object] | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
+    w = random.randint(*GRID_WIDTH_RANGE)
+    shape = (h, w)
+
+    bar_colors = random.sample(range(1, 10), 4)
