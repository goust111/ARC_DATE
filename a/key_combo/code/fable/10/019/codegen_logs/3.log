+            used_path_cells.difference_update(path_set)
+            used_stamp_cells.difference_update(stamp_set)
+            expanded_bodies.pop()
+
+        return False
+
+    return placed if search(0) else None
+
+
+def _choose_scene() -> dict[str, object] | None:
