+    for sprite in scene["sprites"]:
+        stamp = sprite["stamp"]
+        outer = sprite["outer"]
+        inner = sprite["inner"]
+        out[stamp[0]] = outer
+        out[stamp[1]] = inner
+        out[stamp[2]] = outer
+    return out
+
+
+def _candidate_centers(shape: tuple[int, int], side: str) -> list[tuple[int, int]]:
+    h, w = shape
+    coords = []
+    if side == "top":
+        for r in range(3, h - 2):
+            for c in range(2, w - 2):
+                coords.append((r, c))
+    elif side == "bottom":
+        for r in range(2, h - 3):
+            for c in range(2, w - 2):
+                coords.append((r, c))
+    elif side == "left":
+        for r in range(2, h - 2):
+            for c in range(3, w - 2):
+                coords.append((r, c))
+    elif side == "right":
+        for r in range(2, h - 2):
+            for c in range(2, w - 3):
+                coords.append((r, c))
