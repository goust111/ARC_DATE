+    if side == "top":
+        for r in range(3, h - 2):
+            for c in range(2, w - 2):
+                coords.append((r, c))
+    elif side == "bottom":
+        for r in range(2, h - 3):
+            for c in range(2, w - 2):
+                coords.append((r, c))
+    elif side == "left":
+        for r in range(2, h - 2):
+            for c in range(3, w - 2):
+                coords.append((r, c))
+    elif side == "right":
+        for r in range(2, h - 2):
