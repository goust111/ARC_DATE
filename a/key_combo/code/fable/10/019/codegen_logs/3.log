+    side_counts = Counter(sprite["side"] for sprite in placed)
+    assert len(side_counts) >= 2
+    assert any(count >= 2 for count in side_counts.values()) or len(side_counts) >= 3
+    return scene
+
+
+def generate_input() -> np.ndarray:
