+def _choose_scene() -> dict[str, object] | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
+    w = random.randint(*GRID_WIDTH_RANGE)
+    shape = (h, w)
+
+    bar_colors = random.sample(range(1, 10), 4)
