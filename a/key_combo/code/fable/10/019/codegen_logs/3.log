+        outer = sprite["outer"]
+        inner = sprite["inner"]
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                grid[r + dr, c + dc] = outer
+        grid[r, c] = inner
+    return grid
+
+
+def _oracle_output(scene: dict[str, object]) -> np.ndarray:
+    out = _render_scene(scene)
+    for sprite in scene["sprites"]:
