+
+
+def _place_sprites(
+    shape: tuple[int, int], side_colors: dict[str, int], side_order: list[str], inner_colors: list[int]
+) -> list[dict[str, object]] | None:
+    candidates = {side: _candidate_centers(shape, side) for side in SIDES}
