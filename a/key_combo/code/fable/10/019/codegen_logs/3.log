+        inner = sprite["inner"]
+        out[stamp[0]] = outer
+        out[stamp[1]] = inner
+        out[stamp[2]] = outer
+    return out
+
+
+def _candidate_centers(shape: tuple[int, int], side: str) -> list[tuple[int, int]]:
+    h, w = shape
