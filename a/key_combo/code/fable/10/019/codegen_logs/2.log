+def _paint_random_l(tile: np.ndarray, color: int) -> None:
+    n = tile.shape[0]
+    corner = random.choice([(0, 0), (0, n - 1), (n - 1, 0), (n - 1, n - 1)])
+    arm_a = random.randint(2, n)
+    arm_b = random.randint(2, n)
+    rr, cc = corner
+    if rr == 0:
+        rows = slice(0, arm_a)
+    else:
