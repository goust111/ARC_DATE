def _gen_mask_key(mask: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, int], ...]]:
    coords = np.argwhere(mask)
    r0, c0, _, _ = bbox_coords(coords)
    offsets = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
