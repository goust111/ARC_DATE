+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, int], ...]]:
+    mask = np.asarray(mask, dtype=bool)
+    coords = np.argwhere(mask)
+    return tuple(mask.shape), tuple(tuple(map(int, p)) for p in coords.tolist())
