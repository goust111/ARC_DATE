+        w = random.randint(min_w, 30)
+        ring_r = random.randint(1, h - ring_side - 1)
+        ring_c = random.randint(1, w - ring_side - 1)
+        snake_r = random.randint(1, h - snake_h - 1)
+        snake_c = random.randint(1, w - snake_w - 1)
+        ring_cells = {
