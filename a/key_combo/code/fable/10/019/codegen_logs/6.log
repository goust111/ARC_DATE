GEN_CANVAS_SIZES = (6, 8, 10)
GEN_NUM_COLORS = 3
GEN_PALETTE_SIZE = 10
GEN_MAX_ATTEMPTS = 300


def _gen_paint_ring(grid: np.ndarray, offset: int, color: int) -> None:
    n = int(grid.shape[0])
    r0 = c0 = offset
    r1 = c1 = n - 1 - offset
    grid[r0, c0 : c1 + 1] = color
    grid[r1, c0 : c1 + 1] = color
    grid[r0 : r1 + 1, c0] = color
