+
+def _find_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _trace_path(component: list[tuple[int, int]], start: tuple[int, int]) -> list[tuple[int, int]]:
+    cells = set(component)
+    order = [start]
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
+        nxts = [p for p in _neighbors4(*cur) if p in cells and p != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1
+        nxt = nxts[0]
+        order.append(nxt)
+        prev, cur = cur, nxt
+    return order
+
+
+def _analyze_snake(grid: np.ndarray, component: list[tuple[int, int]]) -> dict | None:
+    cells = set(component)
+    if len(cells) < 2:
+        return None
+    degrees = {
+        cell: sum(1 for n in _neighbors4(*cell) if n in cells)
+        for cell in cells
+    }
+    if any(d > 2 for d in degrees.values()):
+        return None
+    endpoints = sorted([cell for cell, d in degrees.items() if d == 1])
+    if len(endpoints) != 2:
+        return None
+    order = _trace_path(component, endpoints[0])
+    if len(order) != len(component):
+        return None
+    return {
