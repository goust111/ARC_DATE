+def _make_snake_colors(length: int, outer_color: int, bg: int) -> list[int]:
+    palette = [c for c in range(10) if c not in {bg, GREY}]
+    if outer_color not in palette:
+        palette.append(outer_color)
+    colors = [outer_color]
+    for idx in range(1, length):
