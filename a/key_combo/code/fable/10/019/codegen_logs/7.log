+    center = ((r0 + r1) / 2.0, (c0 + c1) / 2.0)
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    np.random.shuffle(cells)
+    candidates: list[tuple[tuple[int, int], list[tuple[int, int]], str]] = []
+
+    for r, c in cells:
