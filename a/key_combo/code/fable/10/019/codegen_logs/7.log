+
+def _sample_legend() -> tuple[int, int, int, int, int, int]:
+    h = _randint_inclusive(MIN_SIZE, MAX_SIZE - 1)
+    w = _randint_inclusive(MIN_SIZE, MAX_SIZE - 1)
