+    for r, c in scene["seeds"]:
+        color = int(out[r, c])
+        dr, dc = scene["color_to_dir"][color]
+        rr, cc = r, c
+        while _in_bounds(out.shape, rr, cc):
+            out[rr, cc] = color
+            rr += dr
+            cc += dc
+    return out
