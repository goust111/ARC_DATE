+
+    def rec(
+        idx: int,
+        current_input: set[tuple[int, int]],
+        current_paths: set[tuple[int, int]],
+    ) -> bool:
+        if idx == len(specs):
+            return True
+
+        color, want_kind = specs[idx]
+        direction = color_to_dir[color]
+        candidates = _candidate_cells(
+            shape,
+            bbox,
+            color,
+            direction,
+            want_kind,
+            current_input,
+            current_paths,
+            blocked,
