+BLACK = 0
+GREY = 5
+PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+CORNER_DIRS = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
