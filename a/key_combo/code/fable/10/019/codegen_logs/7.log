+    for r, c in seeds:
+        assert int(g[r, c]) in color_to_dir, "seed color must appear in the legend"
+        for nr, nc in _neighbors8(r, c):
+            if _in_bounds((h, w), nr, nc):
+                assert g[nr, nc] == BLACK, "seed pixels must be isolated in the input"
