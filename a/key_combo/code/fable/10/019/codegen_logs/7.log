+    rect_w = _randint_inclusive(RECT_W_RANGE[0], min(RECT_W_RANGE[1], w - 6))
+    r0 = _randint_inclusive(2, h - rect_h - 3)
+    c0 = _randint_inclusive(2, w - rect_w - 3)
+    return h, w, r0, c0, rect_h, rect_w
