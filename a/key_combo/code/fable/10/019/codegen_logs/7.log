+    gray_coords = np.argwhere(g == GREY)
+    assert gray_coords.size > 0, "expected one grey rectangle"
+    r0, c0 = gray_coords.min(axis=0).astype(int).tolist()
+    r1, c1 = gray_coords.max(axis=0).astype(int).tolist()
