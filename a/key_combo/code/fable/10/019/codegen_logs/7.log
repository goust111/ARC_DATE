+def _rect_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def _sign_against_center(value: int, center: float) -> int:
+    if value < center:
+        return -1
+    if value > center:
+        return 1
+    return 0
