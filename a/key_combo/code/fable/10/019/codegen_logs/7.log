+        if pos in occupied_input:
+            continue
+        if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
+            continue
+        if any(_in_bounds(shape, nr, nc) and (nr, nc) in occupied_input for nr, nc in _neighbors8(r, c)):
