+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+NON_BLACK = tuple(range(1, 10))
+GEN_RETRIES = 300
+MIN_CENTER_GAP = 4
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _palette(patch: np.ndarray) -> set[int]:
+    return {int(color) for color in np.unique(patch) if int(color) != BLACK}
+
+
+def _find_squares(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    squares: list[dict] = []
+    for coords in _find_components(g != BLACK):
+        if coords.shape[0] != 9:
+            continue
+        r0, c0, r1, c1 = _bbox(coords)
+        if r1 - r0 != 2 or c1 - c0 != 2:
+            continue
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        if np.any(patch == BLACK):
+            continue
+        squares.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "center": (r0 + 1, c0 + 1),
+                "patch": patch.copy(),
+            }
+        )
+    squares.sort(key=lambda sq: (sq["center"][0], sq["center"][1]))
+    return squares
+
+
+def _corridor_clear(grid: np.ndarray, a: dict, b: dict) -> tuple[bool, str | None]:
+    (ra, ca), (rb, cb) = a["center"], b["center"]
+    if ra == rb:
+        c0, c1 = sorted((ca, cb))
+        if c1 - c0 < 4:
+            return False, None
+        return bool(np.all(grid[ra, c0 + 2 : c1 - 1] == BLACK)), "horizontal"
+    if ca == cb:
+        r0, r1 = sorted((ra, rb))
