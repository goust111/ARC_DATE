+def _gen_attempt() -> np.ndarray | None:
+    n_segments = random.randint(MIN_SEGMENTS, MAX_SEGMENTS)
+    max_seg_w = min(MAX_SEGMENT_W, (30 - (n_segments - 1)) // n_segments)
+    if max_seg_w < MIN_SEGMENT_W:
