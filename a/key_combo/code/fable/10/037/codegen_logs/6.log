/bin/bash -lc "python - <<'PY'
import random, numpy as np

BG=0
COLORS=list(range(1,10))

def build_tokens(n, reverse_left=True, mirror_left=True):
    tokens=[(0,False)]
    for i in range(1,n):
        left=tokens[::-1] if reverse_left else tokens[:]
        moved=[(seg, (not flip) if mirror_left else flip) for seg,flip in left]
        tokens=[(i,False)] + moved
    return tokens

def render(segments, tokens, top_nonblack=True):
    bg=0
    layers=[]
    for seg, flip in tokens:
        layer=np.fliplr(segments[seg]) if flip else segments[seg]
        layers.append(layer)
    if top_nonblack:
        out=np.full(layers[0].shape,bg,int)
        filled=np.zeros(layers[0].shape,bool)
        for layer in layers[::-1]:
            mask=(layer"'!=bg)&(~filled)
            out[mask]=layer[mask]
            filled|=mask
        return out
    return layers[-1].copy()

def visible_ids(segments,tokens):
    H,W=segments[0].shape
    out=-np.ones((H,W),int)
    layers=[]
    for seg,flip in tokens:
        layers.append((seg,np.fliplr(segments[seg]) if flip else segments[seg]))
    filled=np.zeros((H,W),bool)
    for seg,layer in layers[::-1]:
        mask=(layer!=0)&(~filled)
        out[mask]=seg
        filled|=mask
    return set(int(x) for x in out[out>=0].ravel())

def pick_cell(h,w,used,require_asym=False,avoid_mirror_used=False):
    cand=[]
    for r in range(h):
        for c in range(w):
            if (r,c) in used:
                continue
            if require_asym and c==w-1-c:
                continue
            if avoid_mirror_used and (r,w-1-c) in used:
                continue
            cand.append((r,c))
    return random.choice(cand) if cand else None

def set_final(segments, flips, seg, cell, color):
    r,c=cell
    w=segments[seg].shape[1]
    src_c=w-1-c if flips[seg] else c
    segments[seg][r,src_c]=color

def gen():
    n=random.randint(3,5)
    maxw=min(6,(30-(n-1))//n)
    w=random.randint(4,maxw)
    h=random.randint(4,8)
    fold=random.choice(COLORS)
    palette=[c for c in COLORS if c!=fold]
    segs=[np.zeros((h,w),int) for _ in range(n)]
    tok=build_tokens(n)
    tok_rev=build_tokens(n, reverse_left=False, mirror_left=True)
    tok_nom=build_tokens(n, reverse_left=True, mirror_left=False)
    flips={seg:flip for seg,flip in tok}
    pos={seg:i for i,(seg,_) in enumerate(tok)}
    posr={seg:i for i,(seg,_) in enumerate(tok_rev)}
    inv=[]
    for a in range(n):
        for b in range(a+1,n):
            if (pos[a]-pos[b])*(posr[a]-posr[b])<0:
                inv.append((a,b))
    if not inv:
        return None
    flipped=[seg for seg,flip in flips.items() if flip]
    if not flipped:
        return None
    mirror_seg=random.choice(flipped)
    used=set()
    # dedicated visible cell for each segment
    for seg in range(n):
        if seg==mirror_seg:
            cell=pick_cell(h,w,used,require_asym=True,avoid_mirror_used=True)
            if cell is None: return None
            used.add(cell); used.add((cell[0],w-1-cell[1]))
        else:
            cell=pick_cell(h,w,used)
            if cell is None: return None
            used.add(cell)
        set_final(segs, flips, seg, cell, random.choice(palette))
    a,b=random.choice(inv)
    inv_cell=pick_cell(h,w,used)
    if inv_cell is None: return None
    ca,cb=random.sample(palette,2)
    set_final(segs, flips, a, inv_cell, ca)
    set_final(segs, flips, b, inv_cell, cb)
    correct=render(segs,tok)
    if visible_ids(segs,tok)!=set(range(n)):
        return None
    if np.array_equal(correct, render(segs,tok_rev)):
        return None
    if np.array_equal(correct, render(segs,tok_nom)):
        return None
    if np.array_equal(correct, render(segs,tok, top_nonblack=False)):
        return None
    return n,h,w,mirror_seg,a,b,correct,segs

ok=0
for i in range(200):
    x=gen()
    if x is not None:
        ok+=1
print('"'ok',ok)
