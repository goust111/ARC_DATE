+
+        gap_a = random.randint(2, 4)
+        gap_b = random.randint(2, 4)
+        gap_c = random.randint(2, 4)
+        gap_d = random.randint(2, 4)
+
+        v0_c = sink0_c + random.randint(0, w_s - w_v)
+        v0_r = sink0_r - gap_a - h_v
+        h0_r = v0_r + random.randint(0, max(0, h_v - h_h - 1))
