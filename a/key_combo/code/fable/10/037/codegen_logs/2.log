+    _validate_layout(layout)
+    return layout
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    layout = _build_layout()
+    if layout is None:
+        return None
+    inp = _render_from_layout(layout, mode="input")
+    expected = _render_from_layout(layout, mode="output")
