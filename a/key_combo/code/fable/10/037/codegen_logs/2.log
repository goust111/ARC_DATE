+        {"sink": "sink1", "kinds": ["V", "H", "S"]},
+    ]
+    extra_patterns = [["H", "V", "H", "S"], ["V", "H", "V", "S"], ["H", "S"], ["V", "S"]]
+    if random.random() < 0.85:
+        path_specs.append({"sink": random.choice(("sink0", "sink1")), "kinds": random.choice(extra_patterns)})
+    if random.random() < 0.35:
+        path_specs.append({"sink": random.choice(("sink0", "sink1")), "kinds": random.choice((["H", "S"], ["V", "S"]))})
+
+    nodes: dict[str, dict] = {
+        "sink0": {"kind": "S", "bbox": sinks[0], "dest": None},
+        "sink1": {"kind": "S", "bbox": sinks[1], "dest": None},
+    }
+    used = list(sinks)
+    sources: list[str] = []
+
+    for path_idx, spec in enumerate(path_specs):
