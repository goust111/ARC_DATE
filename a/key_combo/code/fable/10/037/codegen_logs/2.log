+def _node_size(kind: str, core: int) -> tuple[int, int]:
+    if kind == "H":
+        return core + 2, core + 4
+    if kind == "V":
+        return core + 4, core + 2
+    if kind == "S":
+        return core + 4, core + 4
+    raise ValueError(kind)
