+            cc = sic0 + dc
+            assert sir0 <= rr <= sir1 and sic0 <= cc <= sic1, "motif must fit every routed frame"
+            assert int(out[rr, cc]) == BG, "constructed examples must avoid sink overlap"
+            out[rr, cc] = int(color)
