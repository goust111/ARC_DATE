+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _inner_bbox(box: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    return r0 + 1, c0 + 1, r1 - 1, c1 - 1
+
+
+def _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return max(a0, b0) <= min(a1, b1)
+
+
+def _frame_kind(box: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = box
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h == w:
+        return "S"
+    return "H" if w > h else "V"
+
+
+def _color_components(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _is_rectangular_frame(coords: list[tuple[int, int]]) -> bool:
+    if len(coords) < 8:
+        return False
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    border_area = 2 * (h + w) - 4
+    if len(coords) != border_area:
+        return False
+    coord_set = set(coords)
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
