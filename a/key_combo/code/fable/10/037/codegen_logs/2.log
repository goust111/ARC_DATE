+
+        sr0, sc0, sr1, sc1 = src["bbox"]
+        sir0, sic0, sir1, sic1 = src["inner"]
+        candidates: list[tuple[int, int]] = []
+        for j, dst in enumerate(frames):
+            if i == j:
+                continue
+            dr0, dc0, dr1, dc1 = dst["bbox"]
+            dir0, dic0, dir1, dic1 = dst["inner"]
+            if kind == "H":
