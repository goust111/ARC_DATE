+def _frame_border_mask(shape: tuple[int, int], frames: list[dict]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for fr in frames:
+        for r, c in fr["coords"]:
+            mask[r, c] = True
+    return mask
