+    ph, pw = _node_size(kind, core)
+    cr0, cc0, cr1, cc1 = child_box
+    for _ in range(120):
+        gap = random.randint(2, 5)
+        if kind == "H":
+            c0 = cc0 - gap - pw
+            if c0 < 1:
+                continue
+            row_lo = max(1, cr0 - ph + 3)
+            row_hi = min(canvas_h - ph - 1, cr1 - 2)
+            if row_lo > row_hi:
