+def _sink_index(start: int, dests: list[int | None]) -> int:
+    seen: set[int] = set()
+    cur = start
+    while dests[cur] is not None:
+        assert cur not in seen, "routing graph must be acyclic"
+        seen.add(cur)
+        cur = int(dests[cur])
+    return cur
