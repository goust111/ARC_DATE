+    _validate_layout(layout)
+    return layout
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    layout = _build_layout()
+    if layout is None:
+        return None
+    inp = _render_from_layout(layout, one_hop=True)
+    expected = _render_from_layout(layout, one_hop=False)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        case = _build_case()
+        if case is None:
+            continue
+        inp, _expected = case
+        return inp
+    raise AssertionError("failed to generate a valid aspect-ratio-routing input")

