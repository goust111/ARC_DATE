+        "sink1": {"kind": "S", "bbox": sinks[1], "dest": None},
+    }
+    used = list(sinks)
+    sources: list[str] = []
+
+    for path_idx, spec in enumerate(path_specs):
+        child_name = spec["sink"]
+        child_box = nodes[child_name]["bbox"]
+        created: list[tuple[str, str, tuple[int, int, int, int], str | None]] = []
+        for step_rev, kind in enumerate(reversed(spec["kinds"][:-1])):
