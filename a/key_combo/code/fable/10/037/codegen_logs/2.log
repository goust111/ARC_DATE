    shape: 3x3, top-left at row 0, column varies freely within grid width
    structure: top 2 rows all pass_color(9); bottom row is control strip mixing stop(1) and pass(9)
    control_patterns: 1-3 stop cols + 0-2 pass cols; at least 1 stop col
    must not overlap any obstacle pixel
  obstacles:
    pixel_count: 8-12% of grid area (21-31 pixels)
    components: 7-9 connected components (4-conn), sizes range 1-11
