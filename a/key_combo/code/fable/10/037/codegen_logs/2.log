+    r0, c0, r1, c1 = box
+    for ur0, uc0, ur1, uc1 in used:
+        if max(r0 - pad, ur0 - pad) <= min(r1 + pad, ur1 + pad) and max(c0 - pad, uc0 - pad) <= min(c1 + pad, uc1 + pad):
