+    while queue:
+        i = queue.popleft()
+        for j in range(n):
+            if j in seen:
+                continue
+            if _intervals_overlap(intervals[i], intervals[j]):
+                seen.add(j)
+                queue.append(j)
+    return len(seen) == n
