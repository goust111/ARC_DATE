        chosen: list[tuple[int, int]] = []
        used_lengths: set[int] = set()

        def backtrack(i: int) -> bool:
            if i == len(roles):
                return True
            role = roles[i]
            for left, right in pools[role]:
                length = right - left + 1
                if length in used_lengths or (left, right) in chosen:
