+    h, w = shape
+    bounced = False
+    if not (0 <= r + dr < h):
+        dr = -dr
+        bounced = True
+    if not (0 <= c + dc < w):
+        dc = -dc
+        bounced = True
+    return (dr, dc), bounced
+
