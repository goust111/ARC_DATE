+    assert coords.shape[0] == 1, "each moving color must occupy exactly one cell"
+    r, c = map(int, coords[0])
+    return r - 1, c - 1
+
+
+def _bounce_velocity(pos: tuple[int, int], vel: tuple[int, int], shape: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+    r, c = pos
