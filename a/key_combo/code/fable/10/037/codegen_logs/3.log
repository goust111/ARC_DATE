    return out


def _place_rectangles(grid: np.ndarray, colors, sizes, order):
    rects: list[tuple[int, int, int, int]] = []
    for i in order:
        h, w = sizes[i]
        patch = np.full((h, w), colors[i], dtype=int)
        try:
