+def _segment_lengths(cuts: list[int], total: int) -> list[int]:
+    lengths: list[int] = []
+    start = 0
+    for cut in cuts:
+        lengths.append(cut - start)
+        start = cut + 1
+    lengths.append(total - start)
+    return lengths
