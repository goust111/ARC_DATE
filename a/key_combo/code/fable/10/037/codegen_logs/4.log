+def _apply_step(tile: np.ndarray, name: str) -> np.ndarray:
+    if name == "id":
+        return tile.copy()
+    if name == "rot90":
+        return np.rot90(tile, -1).copy()
+    if name == "rot180":
+        return np.rot90(tile, 2).copy()
+    if name == "rot270":
+        return np.rot90(tile, 1).copy()
+    if name == "flip_h":
+        return np.fliplr(tile).copy()
+    if name == "flip_v":
+        return np.flipud(tile).copy()
+    raise ValueError(f"unknown transform: {name}")
