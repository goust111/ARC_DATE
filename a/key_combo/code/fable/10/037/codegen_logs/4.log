+    3: (
+        {
+            "steps": (0, 1, 2, 0, 1, 2, 0),
+            "filled": (True, True, True, True, False, False, True, False),
+        },
+        {
+            "steps": (0, 1, 2, 1, 0, 2, 1),
+            "filled": (True, True, True, True, False, True, False, False),
+        },
+    ),
+    4: (
+        {
+            "steps": (0, 1, 2, 3, 0, 1, 2),
+            "filled": (True, True, True, True, True, False, False, True),
+        },
+        {
+            "steps": (0, 1, 2, 3, 1, 0, 2),
+            "filled": (True, True, True, True, True, False, False, True),
+        },
+    ),
