+    hg, wg = random.randint(4, 6), random.randint(4, 6)
+    hb, wb = random.randint(4, 6), random.randint(4, 6)
+    hd, wd = random.randint(4, 6), random.randint(4, 6)
+    hx, wx = random.randint(4, 6), random.randint(4, 6)
+
