+    g_gap_off = random.randint(1, wg - 2)
+    g = Tank(1, a.c1 + top_gap_2, hg, a.c1 + top_gap_2 + wg - 1, None, False)
+    g = Tank(g.r0, g.c0, g.r1, g.c1, (g.r1, g.c0 + g_gap_off), False)
