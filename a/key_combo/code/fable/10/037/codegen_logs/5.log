spec:
  grid: 7-17 rows x same cols (always square), bg=0
  marked_columns:
    count: 1-3
    marker: bottom row (row H-1) has color 5 (gray); color 5 appears ONLY here
    spacing: >=3 columns apart [observed]
    input_pixels: 2-5 non-bg pixels per column (including bottom-row gray-5)
    output_bands: 2-4 contiguous color bands filling entire column top-to-bottom; bottom band is always gray-5; band height 1-13 rows
  input_pixel_placement: |
    Each output band has exactly 1 input pixel at its bottom row.
    ~11% of bands get a second redundant interior pixel of the same color.
    Consecutive bands may share a color (observed in ~30% of columns).
  noise_pixels:
    scattered single non-bg pixels in unmarked columns, density 0-17%
    color 5 never used in noise [observed]; colors may overlap with band colors
  output_rule: |
    Scan each marked column bottom-to-top; track current color (starts at bottom pixel).
    Replace each bg cell with current color; update current when hitting a non-bg pixel.
    Result: each band's color propagates upward through bg gaps to row 0 or next band pixel.

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size N in [7..17]; create NxN grid of bg=0.
    2. Pick K=1-3 marked columns, spaced >=3 apart.
