        r0, c0 = loc
        paste(inp, source["patch"], r0, c0, transparent=BG)

    point = np.array([[DISTRACTOR_COLOR]], dtype=int)
    for _ in range(random.choice(DISTRACTOR_COUNTS)):
        loc = _free_location(inp, point)
        if loc is None:
            return None
        r, c = loc
        inp[r, c] = DISTRACTOR_COLOR
    return inp


