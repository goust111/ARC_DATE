+    assert len(lower_fg) == 1, "lower layer must have one foreground color"
+    top_fg = int(next(iter(upper_fg)))
+    bottom_fg = int(next(iter(lower_fg)))
+    assert top_fg != bottom_fg
+
+    return upper, lower, bg, top_fg, bottom_fg
