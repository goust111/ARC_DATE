+
+    sep, row_bands, col_bands = _cell_regions(inp)
+    if sep == BG:
+        return False
+
+    cells_in: dict[tuple[int, int], np.ndarray] = {}
+    counts = {}
+    for br, (r0, r1) in enumerate(row_bands):
+        for bc, (c0, c1) in enumerate(col_bands):
