+    output_key = (expected.shape, expected.tobytes())
+    if output_key in _SEEN_OUTPUTS:
+        return None
+    if not _validate_instance(inp, expected, template_pos, completion_ids):
+        return None
+
+    _SEEN_OUTPUTS.add(output_key)
+    return inp, expected
