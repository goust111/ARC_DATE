+    if len(selected) > max_keep:
+        return None
+    wanted = random.randint(max(2, len(selected)), max_keep)
+    random.shuffle(unused)
+    selected.extend(unused[: wanted - len(selected)])
+
+    residue = np.zeros_like(target)
+    for r, c in selected:
