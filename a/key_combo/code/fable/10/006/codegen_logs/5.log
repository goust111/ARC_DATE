+    if len(used_ids) < 3:
+        return False
+    if not any(idx < 4 for idx in used_ids):
+        return False
+    if not any(idx >= 4 for idx in used_ids):
+        return False
+
+    variant_map = {idx: arr for idx, arr in variants}
+    if not any(not np.array_equal(arr, template) for arr in variant_map.values()):
+        return False
+
