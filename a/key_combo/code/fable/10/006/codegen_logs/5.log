+            for rr, cc in cells:
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < side and 0 <= nc < side and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
