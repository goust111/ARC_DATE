+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+ROWS_RANGE = (2, 4)
+COLS_RANGE = (2, 4)
+CELL_SIDE_RANGE = (4, 6)
+TEMPLATE_COLOR_COUNT_RANGE = (2, 3)
+TEMPLATE_FG_RANGE = (7, 12)
+MAX_ATTEMPTS = 500
