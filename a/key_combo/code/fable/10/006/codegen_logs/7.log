+def _stamp_patch(out: np.ndarray, patch: np.ndarray, center: tuple[int, int], *, bg: int = BG) -> None:
+    h, w = patch.shape
+    ar = h // 2
+    ac = w // 2
+    r0 = int(center[0]) - ar
+    c0 = int(center[1]) - ac
