+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _find_color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    seen: set[tuple[int, int]] = set()
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        cell = (int(r), int(c))
+        if cell in seen:
+            continue
+        q = deque([cell])
+        seen.add(cell)
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                nxt = (nr, nc)
+                if _in_bounds(grid.shape, nr, nc) and bool(mask[nr, nc]) and nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+        comps.append(np.array(comp, dtype=int))
+    return comps
