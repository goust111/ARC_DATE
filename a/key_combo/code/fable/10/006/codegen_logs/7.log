+    path: list[tuple[int, int]] = []
+    lanes: list[list[tuple[int, int]]] = []
+    for lane in range(lane_count):
+        row = lane * gap
+        if lane == 0:
+            cols = list(range(width))
+        elif lane % 2 == 1:
+            cols = list(range(width - 1, -1, -1))
+        else:
+            cols = list(range(width))
+
+        if lane == 0:
+            lane_cells = [(row, c) for c in cols]
+            path.extend(lane_cells)
+        else:
