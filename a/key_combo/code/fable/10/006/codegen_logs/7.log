+        return (r, c), (h, w)
+    if mode == 1:
+        return (c, h - 1 - r), (w, h)
+    if mode == 2:
+        return (h - 1 - r, w - 1 - c), (h, w)
+    if mode == 3:
+        return (w - 1 - c, r), (w, h)
+    raise ValueError("unsupported transform mode")
