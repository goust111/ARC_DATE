+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PATH = 5
+MARKER = 8
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 9)
+SPECIAL_COLORS = {BG, PATH, MARKER}
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SHAPE_DIMS = ((3, 3), (3, 5), (5, 3))
+MIN_SPRITES = 3
+MAX_SPRITES = 5
+GRID_MIN = 18
+GRID_MAX = 30
+GEN_RETRIES = 400
+PLACEMENT_PADDING = 1
+STAMP_MARGIN = 2
