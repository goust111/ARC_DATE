+    block_cells: set[tuple[int, int]],
+    sprites: list[dict],
+) -> tuple[list[dict], np.ndarray] | None:
+    grid = np.full(grid_shape, BG, dtype=int)
+    reserved = np.zeros(grid_shape, dtype=bool)
+    for r, c in path_cells | block_cells:
+        reserved[r, c] = True
