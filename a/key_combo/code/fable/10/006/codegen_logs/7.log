def _gen_mask_options(center_required: bool) -> dict[int, list[np.ndarray]]:
    options = {k: [] for k in range(PIXEL_COUNT_BOUNDS[0], PIXEL_COUNT_BOUNDS[1] + 1)}
    for bits in range(1 << (SPRITE_SHAPE[0] * SPRITE_SHAPE[1])):
