+def _compose_input(
+    grid_shape: tuple[int, int],
+    layout: dict,
+    source_grid: np.ndarray,
+) -> np.ndarray:
+    grid = source_grid.copy()
+    for r, c in layout["block"]:
+        grid[r, c] = PATH
+    for r, c in layout["path"]:
+        grid[r, c] = PATH
+    for r, c in layout["markers"]:
+        grid[r, c] = MARKER
