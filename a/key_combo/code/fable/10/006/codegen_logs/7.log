+        center_idx = (h // 2) * w + (w // 2)
+        for bits in range(1 << total):
+            if not ((bits >> center_idx) & 1):
+                continue
+            mask = np.array([(bits >> i) & 1 for i in range(total)], dtype=bool).reshape(h, w)
+            area = int(mask.sum())
+            if area < 4:
