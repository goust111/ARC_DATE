+def _translate_layout(layout: dict, offset: tuple[int, int]) -> dict:
+    dr, dc = offset
+    return {
+        "path": [(r + dr, c + dc) for r, c in layout["path"]],
+        "markers": [(r + dr, c + dc) for r, c in layout["markers"]],
+        "block": {(r + dr, c + dc) for r, c in layout["block"]},
+        "shape": layout["shape"],
+    }
