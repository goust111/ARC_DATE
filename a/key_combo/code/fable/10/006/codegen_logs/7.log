+        mapped, new_shape = _transform_coord(cell, shape, mode)
+        path.append(mapped)
+    markers = []
+    for cell in layout["markers"]:
+        mapped, new_shape = _transform_coord(cell, shape, mode)
+        markers.append(mapped)
+    block = set()
+    for cell in layout["block"]:
+        mapped, new_shape = _transform_coord(cell, shape, mode)
+        block.add(mapped)
+    return {"path": path, "markers": markers, "block": block, "shape": new_shape}
