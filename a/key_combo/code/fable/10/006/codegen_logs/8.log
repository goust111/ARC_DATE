def _gen_attempt() -> np.ndarray | None:
    _gen_dominant, _gen_nondom = _gen_choose_palette()
    _gen_input_d_count, _gen_pair_count, _gen_noise_count, _gen_span, _gen_top = _gen_choose_blob_parameters()
