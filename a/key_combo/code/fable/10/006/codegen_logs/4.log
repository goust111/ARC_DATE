+    rs, cs = _quadrant_slice(grid.shape[0], quadrant)
+    return grid[rs, cs].copy()
+
+
+def _extract_local_code_pixels(grid: np.ndarray) -> tuple[int, int, list[tuple[int, int, int]]]:
