+
+def _build_input_grid(
+    side: int,
+    code_corner: int,
+    corner_colors: dict[int, int],
+    horizontal_colors: dict[int, int],
+    vertical_colors: dict[int, int],
+    horizontal_positions: dict[int, int],
+    vertical_positions: dict[int, int],
