+import numpy as np
+
+
+BG = 0
+RED = 2
+CODE_COLORS = [1, 3, 4, 5, 6, 7, 8, 9]
+CORNERS = (0, 1, 2, 3)  # TL, TR, BL, BR
+MAX_GENERATION_ATTEMPTS = 500
