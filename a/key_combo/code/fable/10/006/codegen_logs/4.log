+        side,
+        code_corner,
+        corner_colors,
+        horizontal_colors,
+        vertical_colors,
+        horizontal_positions,
+        vertical_positions,
+        red_position,
+    )
+
+    try:
+        decoded_lattice_n, decoded_corner, local_pixels = _extract_local_code_pixels(grid)
+        decoded_corners, decoded_h, decoded_v = _decode_rings(local_pixels, decoded_lattice_n)
