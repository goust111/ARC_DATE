+        row_top = _grid_coord(lo)
+        row_bottom = _grid_coord(hi)
+        for ci in range(lo + 1, hi):
+            gc = _grid_coord(ci)
+            out[row_top, gc] = int(color)
+            out[row_bottom, gc] = int(color)
