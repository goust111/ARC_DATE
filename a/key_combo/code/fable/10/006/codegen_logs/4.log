+def _quadrant_from_coord(r: int, c: int, center: int) -> int:
+    top = int(r) < center
+    left = int(c) < center
+    if top and left:
+        return 0
+    if top and not left:
+        return 1
+    if not top and left:
+        return 2
+    return 3
