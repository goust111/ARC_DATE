    layout: |
      rows 0-2: three 3x3 filled squares at col-ranges [0-2, 4-6, 8-10], separated by bg columns 3 and 7
      row 3: all bg
      row 4: three singleton marker pixels at cols 1, 5, 9 (center column of each sprite), each a unique color
