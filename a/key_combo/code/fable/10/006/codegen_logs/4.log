+def _quadrant_candidates(side: int, quadrant: int) -> list[tuple[int, int]]:
+    rs, cs = _quadrant_slice(side, quadrant)
+    return [(r, c) for r in range(rs.start, rs.stop) for c in range(cs.start, cs.stop)]
+
