+    corner_colors: dict[int, int],
+    horizontal_colors: dict[int, int],
+    vertical_colors: dict[int, int],
+) -> np.ndarray:
+    lattice_n = (side - 1) // 2
+    out = np.full((side, side), BG, dtype=int)
+
+    for depth, color in corner_colors.items():
+        lo = int(depth)
+        hi = lattice_n - 1 - lo
+        for ri in (lo, hi):
+            for ci in (lo, hi):
