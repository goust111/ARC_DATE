+    (1, 5),
+    (1, 7),
+    (3, 1),
+    (3, 3),
+    (3, 5),
+    (5, 1),
+]
+
+
+def _rot180(shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:
+    h, w = shape
+    return h - 1 - r, w - 1 - c
+
+
+def _bbox_of_color(grid: np.ndarray, color: int) -> tuple[int, int, int, int]:
+    coords = np.argwhere(grid == color)
