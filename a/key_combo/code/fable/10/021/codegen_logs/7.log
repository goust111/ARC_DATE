+    assert matched + erased == len(family_sizes)
+    assert np.any(expected != grid)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    matched_count = random.randint(2, 4)
+    max_extra = min(2, 5 - matched_count)
+    if max_extra == 0:
