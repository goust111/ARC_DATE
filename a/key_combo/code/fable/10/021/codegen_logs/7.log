spec:
  grid: 15x15 [observed]
  colors:
    background: any single color (largest 4-connected component); 0 in all eval [observed]
    fill: any color != bg (more total pixels than marker); 3 in all eval [observed]
    marker: any color != bg and != fill (fewer total pixels); 9 in all eval [observed]
  rectangles:
    count: 4-6 solid axis-aligned rectangles on background
    dimensions: each side 2-7, area 6-42
    content: filled with fill color + scattered marker pixels
    markers_per_rect: 1-7, each rect has >=1 marker
    marker_density: 4%-33% of rect area
