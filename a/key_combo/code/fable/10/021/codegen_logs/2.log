+_BG = 0
+_SIZE_RANGE = (10, 13)
+_MARGIN_CHOICES = (1, 2)
+_HOLE_SHAPES = ((1, 1), (1, 2), (2, 1), (2, 2))
+_COLOR_POOL = tuple(range(1, 10))
+_MAX_TRIES = 400
+
