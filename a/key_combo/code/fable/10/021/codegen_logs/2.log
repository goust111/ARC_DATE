{
  "type": "move_in_order",
  "src": "largest-area monochromatic foreground objects, ordered left-to-right by bbox left edge",
  "dst": "output columns in the same left-to-right order",
  "match_cond": "s.left_edge.order == d.column.order",
  "transform": "replace each selected object by a solid same-color column whose height is the object area",
  "grid_shape": "height is largest object area; width is number of largest objects"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10x10, background always 0 [observed]
  objects:
    count: 2-5 monochromatic 4-connected foreground objects
    colors: each object has a unique non-zero color (1-9)
    shape: arbitrary connected blobs; bbox 1-6 rows x 1-3 cols [observed]
    separation: all objects pairwise non-touching (even 8-connected)
  largest_class:
    count: 1-3 objects share the maximum area
    area: 3-9 cells
    left_edges: each largest object has a distinct bbox left-column (enables unambiguous L-R ordering)
  distractors:
    count: 0-3 objects with area strictly less than max_area
    area: at least 1 less than max_area; range 2 to max_area-1
  output:
    height: max_area, width: number of largest objects
    each column is a solid vertical bar of one largest-object color, ordered left-to-right by input bbox left edge

generation_strategy:
  approach: direct construction (simple enough to not need output-first)
  steps:
    1. Pick n_largest in [1,3], n_distractor in [0,3], total 2-5
    2. Pick max_area in [3,9]; assign each distractor an area in [2, max_area-1]
    3. Assign distinct non-zero colors to all objects
    4. For each object, generate a random 4-connected blob of its area
