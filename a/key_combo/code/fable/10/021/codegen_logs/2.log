+    ordered_by_area = [holes for holes, _area in sorted(areas.items(), key=lambda item: item[1])]
+    if ordered_by_area == [4, 3, 2, 1] or ordered_by_area == [1, 2, 3, 4]:
+        return None
+    return masks
