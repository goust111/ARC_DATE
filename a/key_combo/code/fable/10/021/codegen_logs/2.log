   269	        needed = bonus_targets[holes]
   270	        candidates = _appendage_candidates(masks[holes])
   271	        random.shuffle(candidates)
   272	        used = np.zeros_like(masks[holes], dtype=bool)
   273	        added = 0
   274	        for patch in candidates:
   275	            patch = patch & ~masks[holes] & ~used
   276	            if not np.any(patch):
   277	                continue
   278	            masks[holes] |= patch
   279	            used |= patch
   280	            added += int(patch.sum())
   281	            if added >= needed:
   282	                break
   283	
   284	    areas = {holes: int(mask.sum()) for holes, mask in masks.items()}
   285	    ordered_by_area = [holes for holes, _area in sorted(areas.items(), key=lambda item: item[1])]
