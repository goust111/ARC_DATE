+    assert grid.shape[0] - cross_r - 1 == top_h
+    assert grid.shape[1] - cross_c - 1 == left_w
+    quadrants = [
+        grid[:cross_r, :cross_c],
+        grid[:cross_r, cross_c + 1 :],
+        grid[cross_r + 1 :, :cross_c],
+        grid[cross_r + 1 :, cross_c + 1 :],
