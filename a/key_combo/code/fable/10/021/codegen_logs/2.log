+        tl_c = random.randint(1, split_c - tl_w)
+        tr_r = random.randint(1, split_r - tr_h)
+        tr_c = random.randint(split_c + 1, w - tr_w - 1)
+        bl_r = random.randint(split_r + 1, h - bl_h - 1)
+        bl_c = random.randint(1, split_c - bl_w)
