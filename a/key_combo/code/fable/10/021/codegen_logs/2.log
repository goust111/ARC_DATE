+def _boxes_are_separate(boxes: list[tuple[int, int, int, int]]) -> bool:
+    for i, (r0, c0, h0, w0) in enumerate(boxes):
+        a0, a1 = r0, r0 + h0 - 1
+        b0, b1 = c0, c0 + w0 - 1
