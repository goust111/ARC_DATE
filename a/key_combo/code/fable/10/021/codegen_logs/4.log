+    while _in_bounds(shape, pos):
+        cells.append(pos)
+        pos = _add(pos, direction)
+    return cells
+
+
+def _perpendiculars(direction: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    dr, dc = direction
+    if dr != 0:
+        return (0, -1), (0, 1)
+    return (-1, 0), (1, 0)
