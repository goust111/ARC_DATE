+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+PALETTE = (1, 3, 4, 6, 7, 8, 9)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
