+        vals = grid[:, c][grid[:, c] != bg]
+        if len(vals) == h - 1 and len(set(map(int, vals))) == 1:
+            candidates.append(("v", c, int(holes[0]), c, int(vals[0])))
+
+    assert len(candidates) == 1, "expected exactly one separator line with one pinhole"
+    return candidates[0]
+
