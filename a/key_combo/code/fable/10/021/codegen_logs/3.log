+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    mask = grid == color
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
