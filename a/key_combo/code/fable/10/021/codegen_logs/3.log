+    candidates: list[tuple[int, int, BBox]] = []
+    for color in _colors_present(grid, exclude={bg, sep_color}):
+        coords = np.argwhere(grid == color)
+        if coords.size == 0:
+            continue
+        bbox = _bbox_from_coords(coords)
+        r0, c0, r1, c1 = bbox
+        area = (r1 - r0 + 1) * (c1 - c0 + 1)
+        if area != len(coords):
+            continue
+        if r0 == r1 or c0 == c1:
+            continue
