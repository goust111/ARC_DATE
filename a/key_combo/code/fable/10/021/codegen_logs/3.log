+        holes = np.flatnonzero(grid[r] == bg)
+        if len(holes) != 1:
+            continue
+        vals = grid[r][grid[r] != bg]
+        if len(vals) == w - 1 and len(set(map(int, vals))) == 1:
+            candidates.append(("h", r, r, int(holes[0]), int(vals[0])))
