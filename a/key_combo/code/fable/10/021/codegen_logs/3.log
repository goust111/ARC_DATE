+    uncropped = inp.copy()
+    for coord, color in source_colors.items():
+        rr, cc = _project_through_hole(hole[0], hole[1], coord[0], coord[1])
+        if 0 <= rr < h and 0 <= cc < w:
+            uncropped[rr, cc] = color
+    if np.array_equal(uncropped, out):
+        return None
