+        row_lo = 0 if source_side < 0 else axis + 2
+        row_hi = axis - 2 if source_side < 0 else h - 1
+        if row_hi - row_lo + 1 < 4:
+            return None
+        src_h = random.randint(3, min(6, row_hi - row_lo + 1))
+        src_w = random.randint(3, min(6, w - 2))
