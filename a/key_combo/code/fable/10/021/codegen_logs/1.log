110: def _gen_frontier_cells(mask: np.ndarray) -> list[tuple[int, int]]:
111:     h, w = map(int, mask.shape)
112:     frontier: list[tuple[int, int]] = []
113:     for r in range(h):
114:         for c in range(w):
115:             if mask[r, c]:
116:                 continue
117:             if (
118:                 (r > 0 and mask[r - 1, c])
119:                 or (r + 1 < h and mask[r + 1, c])
120:                 or (c > 0 and mask[r, c - 1])
121:                 or (c + 1 < w and mask[r, c + 1])
122:             ):
123:                 frontier.append((r, c))
124:     return frontier
125: 
