28:     - The background is the dominant color, and each panel contains exactly three same-color 4-connected foreground objects.
29: 
30:     Rule
31:     - Build a new HxH background canvas.
32:     - From the left panel copy its leftmost object, from the middle panel copy its middle object, and from the right panel copy its rightmost object.
33: 
34:     Key insight
35:     - The separator bars create three aligned layers, and the panel's own left-to-right object order selects which object survives in the merged output.
36:     """
37:     g = np.asarray(grid, dtype=int)
38:     assert g.ndim == 2, "expected a 2D grid"
39:     H, W = g.shape
40:     assert W == 3 * H + 2, "expected three square panels separated by two columns"
41: 
42:     bg = get_bg(g)
43:     sep_a = int(g[0, H])
44:     sep_b = int(g[0, 2 * H + 1])
45:     assert sep_a == sep_b and sep_a != bg, "separator bars must use the same non-bg color"
46:     assert bool(np.all(g[:, H] == sep_a)), "first separator column must be solid"
47:     assert bool(np.all(g[:, 2 * H + 1] == sep_a)), "second separator column must be solid"
48: 
49:     panels = [
50:         g[:, :H],
51:         g[:, H + 1 : 2 * H + 1],
52:         g[:, 2 * H + 2 :],
53:     ]
54:     assert all(panel.shape == (H, H) for panel in panels), "panels must be HxH"
55: 
56:     out = np.full((H, H), bg, dtype=int)
57:     for panel_index, panel in enumerate(panels):
58:         obj = _ordered_objects(panel, bg)[panel_index]
59:         color = int(obj["color"])
60:         for r, c in obj["coords"]:
61:             rr, cc = int(r), int(c)
62:             assert out[rr, cc] == bg, "selected objects must not overlap"
63:             out[rr, cc] = color
64: 
65:     return out
66: 
