24: def main(grid: np.ndarray) -> np.ndarray:
25:     """
26:     Mirror the colored object across the full separator line while swapping its two colors in the original location.
27: 
28:     Input structure
29:     - A background grid contains exactly one full foreground row or column separator.
30:     - All other foreground pixels form a source mask entirely on one side of the separator.
31:     - The source mask uses exactly two colors, and its mirror positions on the other side are background.
32: 
33:     Rule
34:     - Copy each source pixel to its reflection across the full separator line, preserving its original color.
35:     - Recolor the source pixel in place by swapping the two source colors.
36:     - Leave the separator and all background cells otherwise unchanged.
37: 
38:     Key insight
39:     - The separator is an axis of reflection, and the asymmetric two-color source mask is both copied across the axis and color-inverted at its starting side.
40:     """
41:     g = np.asarray(grid, dtype=int)
42:     assert g.ndim == 2, "expected a 2D grid"
43:     bg = int(get_bg(g))
44:     height, width = map(int, g.shape)
45: 
46:     orient, axis, sep_color = _separator_line(g, bg)
47:     source_mask = (g != bg) & (g != sep_color)
48:     source_coords = [(int(r), int(c)) for r, c in np.argwhere(source_mask)]
49:     assert source_coords, "expected source pixels away from the separator"
50: 
51:     source_colors = set(map(int, g[source_mask]))
52:     assert len(source_colors) == 2, "source mask must use exactly two colors"
53:     color_a, color_b = tuple(source_colors)
54:     swapped = {color_a: color_b, color_b: color_a}
55: 
56:     out = g.copy()
57:     if orient == "h":
58:         above = sum(r < axis for r, _c in source_coords)
59:         below = sum(r > axis for r, _c in source_coords)
60:         assert above + below == len(source_coords), "source pixels cannot lie on the separator"
61:         assert (above == 0) ^ (below == 0), "source mask must be entirely on one side"
62: 
63:         for r, c in source_coords:
64:             mirror_r = 2 * axis - r
65:             assert 0 <= mirror_r < height, "reflected row must remain in bounds"
66:             assert int(g[mirror_r, c]) == bg, "reflected target cell must be background"
67:             out[mirror_r, c] = int(g[r, c])
68:             out[r, c] = swapped[int(g[r, c])]
69:     else:
70:         left = sum(c < axis for _r, c in source_coords)
71:         right = sum(c > axis for _r, c in source_coords)
72:         assert left + right == len(source_coords), "source pixels cannot lie on the separator"
73:         assert (left == 0) ^ (right == 0), "source mask must be entirely on one side"
74: 
75:         for r, c in source_coords:
76:             mirror_c = 2 * axis - c
77:             assert 0 <= mirror_c < width, "reflected column must remain in bounds"
78:             assert int(g[r, mirror_c]) == bg, "reflected target cell must be background"
79:             out[r, mirror_c] = int(g[r, c])
80:             out[r, c] = swapped[int(g[r, c])]
81: 
82:     return out
83: 
