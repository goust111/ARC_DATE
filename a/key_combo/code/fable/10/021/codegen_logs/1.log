50:         area = int(coords.shape[0])
51:         if area == 1:
52:             continue
53:         assert area == 2, "red objects must be isolated pixels or dominoes"
54:         r0, c0, r1, c1 = bbox_coords(coords)
55:         assert (r1 - r0) + (c1 - c0) == 1, "domino must be edge-connected"
56:         _paint_expanded_border(out, (r0, c0, r1, c1))
57:         domino_count += 1
