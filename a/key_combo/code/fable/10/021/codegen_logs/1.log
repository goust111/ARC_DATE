+
+
+def _build_case(
+    panel_h: int,
+    panel_w: int,
+    bg: int,
+    sep: int,
+    color: int,
+    sprite: np.ndarray,
+    anchors: list[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full((panel_h, 3 * panel_w + 2), bg, dtype=int)
+    grid[:, panel_w] = sep
