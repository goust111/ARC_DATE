+        _paint_sprite(panel, sprite, r, c, bg)
+        start = starts[i]
+        grid[:, start : start + panel_w] = panel
+    return grid
+
+
+def _validate_generated_case(
+    grid: np.ndarray,
+    sprite: np.ndarray,
+    anchors: list[tuple[int, int]],
+    delta: tuple[int, int],
+    branch: tuple[bool, bool],
