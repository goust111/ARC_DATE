14: def main(input_grid):
15:     """
16:     Move the single colored marker down one row and draw alternating yellow columns above it.
17: 
18:     Input structure:
19:     - The input is a black grid with exactly one non-black, non-yellow marker pixel.
20:     - The marker is not on the bottom row.
21:     - The marker's column defines the parity of the stripe pattern.
22: 
23:     Rule:
24:     - Move the marker color one row downward and clear its original cell.
25:     - From the top through the marker's original row, color yellow every other column aligned with the marker column.
26:     - Leave all other cells black.
27: 
28:     Key insight:
29:     - The marker supplies both a dropped object and a phase reference for the repeated vertical
30:       yellow stripe pattern.
31:     """
32:     # Plan:
33:     # 1. Extract the pixel from the input grid
34:     # 2. Move the pixel one pixel down
35:     # 3. Draw a yellow line from the pixel to the top of the grid, repeating it horizontally left/right with a period of 2 pixels
36: 
37:     # Locate the single non-black pixel.
38:     coords = np.argwhere(input_grid != Color.BLACK)
39:     assert coords.shape[0] == 1
40:     r, c = map(int, coords[0])
41:     pixel_color = int(input_grid[r, c])
42: 
43:     output_grid = input_grid.copy()
44: 
45:     # Move the pixel down by one row.
46:     output_grid[r + 1, c] = pixel_color
47:     output_grid[r, c] = Color.BLACK
48: 
49:     # Draw repeating yellow vertical bars (period=2) from the top down to the original row r.
50:     for cc in range(0, output_grid.shape[1]):
51:         if (cc - c) % 2 == 0:
52:             output_grid[0 : r + 1, cc] = Color.YELLOW
53:     return output_grid
54: 
