85: # Random-growth shape controls.
86: _FRONTIER_COMPACT_BIAS = 0.35
87: _FRONTIER_COMPACT_TOP_K = 3
88: _NEIGHBOR_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))
89: 
90: # Retry limit for rejecting failed growth or oracle mismatches.
91: _MAX_ATTEMPTS = 300
