14: def main(input_grid):
15:     """
16:     Use a 2x2 color guide to recolor the four quadrants of a 6x6 green mask.
17: 
18:     Input structure:
19:     - The input is a 9x9 grid split by one teal row and one teal column.
20:     - One region contains a 2x2 guide with four non-black, non-green colors.
21:     - The opposite region contains a 6x6 green sprite on black.
22: 
23:     Rule:
24:     - Separate the teal-divided regions and identify the color guide and green sprite.
25:     - Split the green sprite into four equal quadrants.
26:     - Recolor green pixels in each quadrant with the corresponding guide color in the same relative position.
27: 
28:     Key insight:
29:     - The teal cross only organizes the two artifacts; the 2x2 guide is a miniature color map for
30:       the 6x6 sprite's four 3x3 quadrants.
31:     """
32:     # Detect four parts seperated by two intersected teal lines.
33:     sub_grids = find_components(input_grid, bg=Color.TEAL, connectivity=4, monochromatic=False, return_format="objects")
34: 
35:     # Find the green pattern and square with four colors as a coloring guidance.
36:     for sub_grid in sub_grids:
37:         b = bbox(sub_grid != Color.TEAL)
38:         if b is None:
39:             continue
40:         cropped_sub_grid = crop_bbox(sub_grid, b)
41: 
42:         # If this part is the color guide, then store the color guide.
43:         if np.all(cropped_sub_grid != Color.BLACK) and np.all(cropped_sub_grid != Color.GREEN):
44:             color_guide = cropped_sub_grid
45: 
46:         # If this part is the green pattern, then store the green pattern.s
47:         elif np.any(cropped_sub_grid == Color.GREEN):
48:             green_pattern = cropped_sub_grid
49:     
50:     # Caculate the size of four sub-sprites on green pattern to be colored.
51:     height_green, width_green = green_pattern.shape
52:     height_green_half, width_green_half = height_green // 2, width_green // 2
53:     
54:     # Color each sub-sprite on the green pattern follow the color guide: with the color in same relative position.
55:     green_pattern[0:height_green_half, 0:width_green_half][green_pattern[0:height_green_half, 0:width_green_half] == Color.GREEN] = color_guide[0, 0]
56:     green_pattern[height_green_half:height_green, 0:width_green_half][green_pattern[height_green_half:height_green, 0:width_green_half] == Color.GREEN] = color_guide[1, 0]
57:     green_pattern[0:height_green_half, width_green_half:width_green][green_pattern[0:height_green_half, width_green_half:width_green] == Color.GREEN] = color_guide[0, 1]
58:     green_pattern[height_green_half:height_green, width_green_half:width_green][green_pattern[height_green_half:height_green, width_green_half:width_green] == Color.GREEN] = color_guide[1, 1]
59: 
60:     output_grid = green_pattern
61:     return output_grid
62: 
