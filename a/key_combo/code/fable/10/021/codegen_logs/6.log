+    for pr in range(1, h + 1):
+        for pc in range(1, w + 1):
+            if len(coords) < pr * pc:
+                continue
+            tile = np.full((pr, pc), -1, dtype=int)
+            seen = np.zeros((pr, pc), dtype=bool)
+            ok = True
+            for r, c in coords:
+                rr = int(r) % pr
+                cc = int(c) % pc
+                value = int(grid[r, c])
+                if seen[rr, cc]:
