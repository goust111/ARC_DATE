    random.shuffle(coords)
    first = _gen_choose_first_color_coords(coords)

    sprite = np.zeros((h, w), dtype=int)
    sprite[mask] = colors[1]
    for r, c in first:
        sprite[r, c] = colors[0]
    return sprite


