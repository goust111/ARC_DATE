        reflected = np.fliplr(sprite)
        rr0 = r0
        rc0 = 2 * axis - (c0 + sw - 1)

    paste(out, _gen_swapped_sprite(sprite, colors), r0, c0, transparent=BG_COLOR)
    paste(out, reflected, rr0, rc0, transparent=BG_COLOR)
    return out, reflected, rr0, rc0


