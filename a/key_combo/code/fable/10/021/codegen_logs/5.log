+    if side == "bottom":
+        return bool(mask[-1, :].any())
+    if side == "left":
+        return bool(mask[:, 0].any())
+    if side == "right":
+        return bool(mask[:, -1].any())
+    raise ValueError(f"unknown side: {side}")
+
+
+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
