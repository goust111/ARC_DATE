+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(coords[0])}
+    stack = [tuple(coords[0])]
+    cells = {tuple(rc) for rc in coords.tolist()}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in cells and (nr, nc) not in seen:
