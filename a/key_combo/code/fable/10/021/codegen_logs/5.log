+            hits: list[tuple[str, tuple[tuple[int, int], ...]]] = []
+            for side in SIDES:
+                full_mask = _mirror_complete(comp["mask"], side)
+                key = _normalized_key_from_mask(full_mask)
+                if key in placeholder_by_key:
