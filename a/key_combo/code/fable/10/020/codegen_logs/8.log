+    stop_partial_out, _ = _stamp_copies(
+        inp.shape,
+        motif_coords,
+        motif_color,
+        vector,
+        bar_colors,
+        bg,
+        priority=True,
+        cycle=True,
+        stop_on_partial_exit=True,
+    )
+    if np.array_equal(stop_partial_out, expected):
+        return False
+    return True
+
