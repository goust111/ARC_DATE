+def _normalize(coords: list[Coord]) -> list[Coord]:
+    min_r = min(r for r, _ in coords)
+    min_c = min(c for _, c in coords)
+    return _sorted_coords([(r - min_r, c - min_c) for r, c in coords])
+
+
+def _bbox(coords: list[Coord]) -> tuple[int, int]:
