+        stats.append(
+            {
+                "copy_idx": copy_idx,
+                "color": color,
+                "inside_count": len(in_bounds),
+                "overlap_count": overlap_count,
+                "new_count": new_count,
+                "all_inside": len(in_bounds) == motif_size,
+                "coords": tuple(in_bounds),
+            }
+        )
+        copy_idx += 1
