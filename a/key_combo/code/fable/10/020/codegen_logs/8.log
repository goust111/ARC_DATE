+                    continue
+                out[r, c] = color
+                occupied[r, c] = True
+                new_count += 1
+        else:
+            for r, c in in_bounds:
+                out[r, c] = color
+                if not occupied[r, c]:
+                    new_count += 1
+                occupied[r, c] = True
+
+        stats.append(
+            {
+                "copy_idx": copy_idx,
+                "color": color,
+                "inside_count": len(in_bounds),
+                "overlap_count": overlap_count,
+                "new_count": new_count,
+                "all_inside": len(in_bounds) == motif_size,
+                "coords": tuple(in_bounds),
