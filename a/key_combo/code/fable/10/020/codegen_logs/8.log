+    need_wrap = bool(rng.integers(0, 2))
+    vector = _gen_vector(rng, motif_h, motif_w, need_overlap)
+    if vector is None:
+        return None
+
+    visible_copies, bar_len = _choose_counts(rng, need_wrap)
