+            inp.shape,
+            motif_coords,
+            motif_color,
+            vector,
+            bar_colors,
+            bg,
+            priority=True,
+            cycle=False,
+            stop_on_partial_exit=False,
+        )
+        if np.array_equal(no_cycle_out, expected):
+            return False
