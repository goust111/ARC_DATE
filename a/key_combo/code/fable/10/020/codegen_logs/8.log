+                if occupied[r, c]:
+                    continue
+                out[r, c] = color
+                occupied[r, c] = True
+                new_count += 1
+        else:
+            for r, c in in_bounds:
+                out[r, c] = color
+                if not occupied[r, c]:
+                    new_count += 1
+                occupied[r, c] = True
