+        if orientation == "vertical":
+            if need_overlap:
+                if motif_h < 2:
+                    continue
+                return int(rng.integers(1, motif_h)), 0
+            return int(rng.integers(motif_h, motif_h + 4)), 0
+
+        if need_overlap:
