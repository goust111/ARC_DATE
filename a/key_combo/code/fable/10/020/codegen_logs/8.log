+
+
+def _bbox(coords: list[Coord]) -> tuple[int, int]:
+    return max(r for r, _ in coords) + 1, max(c for _, c in coords) + 1
+
+
+def _gen_polyomino(rng: np.random.Generator) -> list[Coord] | None:
+    for _ in range(100):
+        box_h = int(rng.integers(2, 5))
