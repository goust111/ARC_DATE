+    bar_options = _bar_slots((h, w), bar_len, blocked)
+    if not bar_options:
+        return None
+    bar_coords = bar_options[int(rng.integers(len(bar_options)))]
+    _mark_blocked(blocked, bar_coords)
+
+    marker_options = _marker_slots((h, w), vector, blocked)
+    if not marker_options:
