+        return False
+
+    if np.array_equal(crop, _virtual_crop(seed_mask, 0, 0, height, width, bg, primary, secondary)):
+        return False
+
+    if height * width < 6:
+        return False
+    return True
+
+
+def _sample_frame(
+    shape: tuple[int, int],
+    seed_mask: np.ndarray,
+    bg: int,
+    primary: int,
+    secondary: int,
