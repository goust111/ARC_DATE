+
+    if np.array_equal(crop, _simple_mask_crop(seed_mask, row0, col0, height, width, bg, primary)):
+        return False
+
+    if np.array_equal(crop, _virtual_crop(seed_mask, 0, 0, height, width, bg, primary, secondary)):
+        return False
+
