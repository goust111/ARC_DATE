+    grid[r0 : r1 + 1, c0] = FRAME_COLOR
+    grid[r0 : r1 + 1, c1] = FRAME_COLOR
+    return grid
+
+
+def _simple_mask_crop(
+    seed_mask: np.ndarray,
+    row0: int,
+    col0: int,
+    height: int,
+    width: int,
