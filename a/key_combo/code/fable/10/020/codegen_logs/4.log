+            continue
+        if len({tuple(map(int, col)) for col in mask.astype(int).T}) < 2:
+            continue
+        return mask
+    return None
+
+
+def _render_input(
+    shape: tuple[int, int],
+    seed_mask: np.ndarray,
+    bg: int,
+    primary: int,
+    secondary: int,
+    frame_bbox: tuple[int, int, int, int],
