+    sr, sc = spec["spike_local"]
+    h_grid, w_grid = shape
+    rows = range(sr, h_grid - (h - sr) + 1)
+    cols = range(sc, w_grid - (w - sc) + 1)
+    return [(int(r), int(c)) for r in rows for c in cols]
