+
+def _cell_in_bbox(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
