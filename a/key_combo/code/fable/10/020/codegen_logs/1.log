+def _settle_emissions(base: np.ndarray, cups: list[dict]) -> tuple[np.ndarray, dict]:
+    out = np.array(base, dtype=int, copy=True)
+    bg = _get_bg(out)
+
+    occupied: dict[tuple[int, int], int] = {}
+    for r, c in np.argwhere(out != bg):
+        occupied[(int(r), int(c))] = -1
+
