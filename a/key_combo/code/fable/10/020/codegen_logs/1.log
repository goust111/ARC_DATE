+    h, w = patch.shape
+    if direction == "U":
+        return patch.copy(), spike, list(mouth)
+    if direction == "D":
+        return np.flipud(patch).copy(), (h - 1 - spike[0], spike[1]), _rotate_coords(mouth, (h, w), "D")
+    if direction == "L":
+        return np.rot90(patch, 1).copy(), (w - 1 - spike[1], spike[0]), _rotate_coords(mouth, (h, w), "L")
