+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+EDGE_ORDER = ("U", "D", "L", "R")
+NON_BG_COLORS = tuple(range(1, 10))
+
+GRID_MIN = 14
+GRID_MAX = 22
+MAX_CUPS = 3
+MAX_CONTENT = 6
+GEN_RETRIES = 500
