HORIZONTAL_HALF_WIDTHS = (4, 6, 8, 10, 12, 14)
VERTICAL_HALF_HEIGHTS = (2, 4, 6, 8, 10)
VERTICAL_WIDTHS = tuple(range(8, 31, 2))

