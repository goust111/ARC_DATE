+    indexer: Callable[[int, int], int],
+) -> tuple[int, dict[int, int], dict[int, list[int]]] | None:
+    g = np.asarray(grid, dtype=int)
+    by_color = _color_indices(g, indexer)
+    if not by_color:
+        return None
