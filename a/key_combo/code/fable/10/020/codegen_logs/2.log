def _gen_add_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
    r, c = start
    er, ec = end
    mask[r, c] = True

    if random.random() < GEN_PATH_HORIZONTAL_FIRST_PROB:
        while c != ec:
            c += 1 if ec > c else -1
            mask[r, c] = True
        while r != er:
            r += 1 if er > r else -1
            mask[r, c] = True
    else:
        while r != er:
            r += 1 if er > r else -1
            mask[r, c] = True
        while c != ec:
            c += 1 if ec > c else -1
