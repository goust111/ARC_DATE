+    for inner, outer in ((a, b), (b, a)):
+        direction = (outer[0] - inner[0], outer[1] - inner[1])
+        trace = _trace_to_absorber(grid, bg, set(bar), outer, direction)
+        candidates.append(
+            {
+                "inner": inner,
+                "outer": outer,
+                "dir": direction,
+                "run": _forward_run(grid.shape, outer, direction),
+                "trace": trace,
+            }
+        )
