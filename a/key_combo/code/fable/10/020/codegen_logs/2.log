+
+
+def _path_without_absorbers(
+    shape: tuple[int, int],
+    outer: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[dict[str, object]]:
+    h, w = shape
+    r, c = outer
+    dr, dc = direction
+    seen_states = {(r, c, dr, dc)}
+    seen_cells: set[tuple[int, int]] = set()
+    bounce_events = 0
+    path: list[dict[str, object]] = []
+
+    for _ in range(8 * h * w):
+        bounced = False
+        if not (0 <= r + dr < h):
+            dr *= -1
+            bounced = True
+        if not (0 <= c + dc < w):
+            dc *= -1
+            bounced = True
+        if bounced:
+            bounce_events += 1
+
+        r += dr
+        c += dc
+        if (r, c) in seen_cells:
+            break
+        seen_cells.add((r, c))
+        path.append({"cell": (r, c), "dir": (dr, dc), "bounces": bounce_events})
+        state = (r, c, dr, dc)
+        if state in seen_states:
+            break
+        seen_states.add(state)
+    return path
+
+
+def _margin_cells(shape: tuple[int, int], cells: Iterable[tuple[int, int]], margin: int = 1) -> set[tuple[int, int]]:
+    h, w = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-margin, margin + 1):
+            for dc in range(-margin, margin + 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
