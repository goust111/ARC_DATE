+    h, w = grid.shape
+    r, c = outer
+    dr, dc = direction
+    seen_states = {(r, c, dr, dc)}
+    path: list[tuple[int, int]] = []
+    bounce_events = 0
+
+    for _ in range(8 * h * w):
+        bounced = False
+        if not (0 <= r + dr < h):
