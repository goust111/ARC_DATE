+
+def _absorber_cells(grid: np.ndarray, bg: int) -> tuple[set[tuple[int, int]], dict[tuple[int, int], int]]:
+    cells = set()
+    colors: dict[tuple[int, int], int] = {}
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
