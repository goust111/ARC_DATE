+        true_dist = abs(int(ray["endpoint"][0]) - outer[0]) + abs(int(ray["endpoint"][1]) - outer[1])
+        sizes = BLOCK_SIZES[:]
+        random.shuffle(sizes)
+        cells = [(r, c) for r in range(h) for c in range(w)]
+        random.shuffle(cells)
