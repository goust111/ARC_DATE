+                        "outer": outer,
+                        "dir": direction,
+                        "path": tuple(prefix),
+                        "endpoint": endpoint,
+                        "color": color,
+                        "absorber_cells": tuple(block_cells),
+                        "bounces": int(step["bounces"]),
+                        "launch_kind": launch_kind,
+                    }
+                )
+                break
+            prefix.append(endpoint)
