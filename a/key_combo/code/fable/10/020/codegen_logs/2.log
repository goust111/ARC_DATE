+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+BLOCK_SIZES = [(2, 2), (2, 3), (3, 2), (1, 1)]
+LAUNCH_KINDS = ("row", "col", "corner")
