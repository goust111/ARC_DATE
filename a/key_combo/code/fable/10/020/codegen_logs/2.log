+
+
+def _trace_to_absorber(
+    grid: np.ndarray,
+    bg: int,
+    bar_cells: set[tuple[int, int]],
+    outer: tuple[int, int],
+    direction: tuple[int, int],
+) -> dict[str, object] | None:
