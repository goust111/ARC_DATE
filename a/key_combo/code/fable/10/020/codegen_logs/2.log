+        seen_states.add(state)
+
+    return None
+
+
+def _pick_bar_orientation(
+    grid: np.ndarray,
+    bg: int,
+    bar: list[tuple[int, int]],
+) -> dict[str, object]:
+    assert len(bar) == 2
+    a, b = sorted(bar)
+    assert abs(a[0] - b[0]) == 1 and abs(a[1] - b[1]) == 1
