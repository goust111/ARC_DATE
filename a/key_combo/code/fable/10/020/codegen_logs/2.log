+                    continue
+                if any(cell in exact_blocked for cell in block_cells):
+                    continue
+                if any(cell in prefix for cell in block_cells):
+                    continue
+                if any(cell in object_margin_blocked for cell in block_cells):
+                    continue
+                candidates.append(
