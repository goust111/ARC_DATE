+
+
+def _sample_wrong_signature(frame_sig: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    palette = list(range(1, 10))
+    top_bottom = {frame_sig[0], frame_sig[1]}
+    left_right = {frame_sig[2], frame_sig[3]}
+    while True:
+        sig = _sample_frame_signature()
