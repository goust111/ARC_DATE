    assert bool(col_gutters.any())

    gutter_mask = (row_gutters[:, None] | col_gutters[None, :]) & (g == bg)

    out = g.copy()
    out[gutter_mask & inside_block_bbox] = Color.RED
    out[gutter_mask & ~inside_block_bbox] = Color.BLUE
