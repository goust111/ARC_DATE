+    start: tuple[int, int],
+    end: tuple[int, int],
+    color: int,
+) -> None:
+    row_step = _sign(end[0] - start[0])
+    col_step = _sign(end[1] - start[1])
+
+    for i, j in np.argwhere(mask):
+        r = start[0] + row_step * int(i)
+        c = start[1] + col_step * int(j)
+        out[r, c] = color
