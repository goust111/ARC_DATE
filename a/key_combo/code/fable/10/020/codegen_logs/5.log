+    raise RuntimeError("failed to sample bottlenecks")
+
+
+def _base_free_mask(dh: int, dw: int, checkpoints: list[tuple[int, int]]) -> np.ndarray:
+    free = np.ones((dh + 1, dw + 1), dtype=bool)
+    for checkpoint in checkpoints:
