+
+def _find_doorways(grid: np.ndarray, bg: int) -> list[dict[str, tuple[int, int] | int]]:
+    doors: list[dict[str, tuple[int, int] | int]] = []
+    h, w = grid.shape
+
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            center_color = int(grid[r, c])
+            if center_color == bg:
