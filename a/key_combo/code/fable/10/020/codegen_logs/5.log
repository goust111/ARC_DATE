        row_gutters[prev_e + 1 : next_s] = True
    for (_prev_s, prev_e), (next_s, _next_e) in zip(col_bands, col_bands[1:]):
        assert next_s > prev_e + 1
        col_gutters[prev_e + 1 : next_s] = True
