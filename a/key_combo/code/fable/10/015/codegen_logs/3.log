spec:
  grid: 20-26 rows x 20-26 cols
  background: 0 (black), always dominant color
  foreground_colors: exactly 2 distinct non-bg colors
  mosaic:
    structure: square bounding box of side 3*tile_size, partitioned into a 3x3 lattice of sub-tiles
    tile_size: 3-5
    each_sub_tile: either fully filled with tile_color or entirely empty (no partial fills)
    filled_tiles: 4-6 out of 9 (neither all filled nor all empty)
    placement: anywhere in grid with margins >=1 on all sides [observed]
