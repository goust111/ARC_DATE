+                if all(np.all(side == side[0]) and int(side[0]) in NONBLACK for side in sides):
+                    if (left[0] == YELLOW or right[0] == YELLOW) and (top[0] == YELLOW or bottom[0] == YELLOW):
+                        rect = (r0, c0, r1, c1)
+                        ok = True
+                        if left[0] == YELLOW:
+                            ok &= _ray_side_ok(g, rect, "left")
+                        if right[0] == YELLOW:
