+                if grid[r, c] != YELLOW:
+                    return False
+        return True
+    if side == "up":
+        for c in range(c0, c1 + 1):
+            for r in range(r0 - 1, -1, -1):
+                if grid[r, c] == BLUE:
+                    break
+                if grid[r, c] != YELLOW:
+                    return False
+        return True
+    if side == "down":
+        for c in range(c0, c1 + 1):
+            for r in range(r1 + 1, grid.shape[0]):
