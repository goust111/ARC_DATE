+def _find_cavities(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    runs_by_span: dict[tuple[int, int], list[int]] = {}
+    black_ps = _prefix_sum(g == BLACK)
