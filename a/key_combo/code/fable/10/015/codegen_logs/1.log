+def _prefix_sum(mask: np.ndarray) -> np.ndarray:
+    ps = np.zeros((mask.shape[0] + 1, mask.shape[1] + 1), dtype=int)
+    ps[1:, 1:] = mask.astype(int)
+    ps = ps.cumsum(axis=0).cumsum(axis=1)
+    return ps
