+                        rect = (r0, c0, r1, c1)
+                        ok = True
+                        if left[0] == YELLOW:
+                            ok &= _ray_side_ok(g, rect, "left")
+                        if right[0] == YELLOW:
+                            ok &= _ray_side_ok(g, rect, "right")
+                        if top[0] == YELLOW:
+                            ok &= _ray_side_ok(g, rect, "up")
+                        if bottom[0] == YELLOW:
