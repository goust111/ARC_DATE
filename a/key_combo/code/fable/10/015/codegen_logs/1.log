+    found: list[tuple[int, int, int, int]] = []
+    for (c0, c1), rows in runs_by_span.items():
+        rows = sorted(rows)
+        start = rows[0]
+        prev = rows[0]
+        for r in rows[1:] + [rows[-1] + 2]:
+            if r == prev + 1:
+                prev = r
+                continue
+            r0, r1 = start, prev
+            area = (r1 - r0 + 1) * (c1 - c0 + 1)
+            if _rect_sum(black_ps, r0, c0, r1, c1) == area:
+                left = g[r0 : r1 + 1, c0 - 1]
+                right = g[r0 : r1 + 1, c1 + 1]
+                top = g[r0 - 1, c0 : c1 + 1]
+                bottom = g[r1 + 1, c0 : c1 + 1]
