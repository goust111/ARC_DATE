+
+            row_in = 0 <= rr < h
+            col_in = 0 <= cc < w
+
+            orbit = {(r, c)}
+            if row_in:
+                orbit.add((rr, c))
+            if col_in:
+                orbit.add((r, cc))
+            if row_in and col_in:
+                orbit.add((rr, cc))
+
+            key = frozenset(orbit)
+            if key in seen:
+                continue
+            seen.add(key)
+
+            if row_in and col_in:
+                kind = "full"
+            elif row_in:
+                kind = "row_only"
+            elif col_in:
+                kind = "col_only"
+            else:
