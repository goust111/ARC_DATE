+    teal_cluster = _connected_cluster(teal_cells, teal_boundary, axis_c + 1)
+    grey_cluster = _connected_cluster(grey_cells, grey_boundary, axis_r + 1)
+    if teal_cluster is None or grey_cluster is None:
