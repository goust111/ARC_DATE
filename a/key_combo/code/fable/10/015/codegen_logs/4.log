+        frontier = []
+        for r, c in chosen:
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if (nr, nc) in allowed and (nr, nc) not in chosen:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        chosen.add(random.choice(frontier))
+    return chosen
