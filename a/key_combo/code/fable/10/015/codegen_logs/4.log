spec:
  grid: 6x6 [observed]
  background: BLACK
  foreground:
    color: single non-black color, not RED or GREY (always azure/8 in eval [observed])
    density: 50-64% of cells (18-23 pixels)
    connectivity: not required to be a single connected component (3-4 components observed)
    vertical_symmetry: the pattern must NOT be fully vertically symmetric (some asymmetric pixels required)
    symmetric_pixels: 8-14 pixels whose vertically-reflected counterpart is also foreground
    asymmetric_pixels: 9-12 pixels whose vertically-reflected counterpart is background
    both_types_required: at least 1 symmetric AND 1 asymmetric pixel must exist
  output:
    same_size: true
    background: unchanged (BLACK stays BLACK)
    symmetric_foreground_pixels: recolored to RED
    asymmetric_foreground_pixels: recolored to GREY

generation_strategy:
  approach: direct random generation (simple pixel task, no complex constraints)
  steps:
    1. Choose grid size 6x6
    2. Pick a foreground color from non-black, non-red, non-grey palette
    3. Generate a random binary mask with ~50-65% density
    4. Compute vertical reflection; verify both symmetric and asymmetric pixels exist (>=8 each)
    5. If not, resample (high acceptance rate at these densities)
    6. Fill foreground pixels with chosen color; rest is BLACK
```
