+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _mirror_positions(r: int, c: int, axis_r: int, axis_c: int) -> list[tuple[int, int]]:
+    return [
+        (r, 2 * axis_c - c),
+        (2 * axis_r - r, c),
+        (2 * axis_r - r, 2 * axis_c - c),
+    ]
+
