+        if not np.array_equal(cavity.mask, np.fliplr(cavity.mask)):
+            continue
+        for piece in grouped.get(cavity.shape_key, []):
+            feasible = _feasible_patches(piece, cavity)
+            sym_fits = [patch for patch in feasible if np.array_equal(patch, np.fliplr(patch))]
+            if len(feasible) >= 2 and len({patch.tobytes() for patch in sym_fits}) == 1:
+                axis_orbit_ok = True
+                break
