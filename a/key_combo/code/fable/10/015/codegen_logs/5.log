+def _all_transforms(arr: np.ndarray) -> list[np.ndarray]:
+    out = []
+    seen = set()
+    for flip in (False, True):
+        base = np.fliplr(arr) if flip else arr
+        for k in range(4):
+            cur = np.rot90(base, k)
+            key = (cur.shape, cur.tobytes())
+            if key not in seen:
+                seen.add(key)
+                out.append(cur.copy())
+    return out
