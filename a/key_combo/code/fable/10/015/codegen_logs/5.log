+    axis_shape = None
+    if include_axis:
+        axis_candidates = [SYM_SHAPES[0], SYM_SHAPES[1]]
+        axis_shape = random.choice(axis_candidates)
+    return pair_shapes, axis_shape
+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray]:
