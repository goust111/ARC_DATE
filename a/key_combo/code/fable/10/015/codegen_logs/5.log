+        for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+            if 0 <= nr < h and 0 <= nc < w and occ[nr, nc] and (nr, nc) not in new_cells:
+                return False
+    return True
