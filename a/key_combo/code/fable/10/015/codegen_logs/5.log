+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, mask: np.ndarray | None = None) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if mask is None:
+        view[:] = patch
+    else:
+        view[mask] = patch[mask]
