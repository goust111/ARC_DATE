+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PIECE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GEN_ATTEMPTS = 400
