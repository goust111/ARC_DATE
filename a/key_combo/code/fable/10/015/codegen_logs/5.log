+
+def _random_piece_from_target(patch: np.ndarray, mask: np.ndarray) -> np.ndarray:
+    variants = [cur_patch for cur_patch, _cur_mask in _all_patch_mask_transforms(patch, mask)]
+    return random.choice(variants).copy()
