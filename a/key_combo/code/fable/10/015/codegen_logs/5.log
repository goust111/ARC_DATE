+    best_area = -1
+    best_bbox: tuple[int, int, int, int] | None = None
+    for color in colors:
+        for coords in _components(g == color, connectivity=8):
+            area = int(coords.shape[0])
+            if area > best_area:
+                best_area = area
+                best_bbox = _bbox_from_coords(coords)
+    assert best_bbox is not None
+    return best_bbox
