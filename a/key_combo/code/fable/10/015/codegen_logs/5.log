+        cavity = cavities[orbit[0]]
+        if not np.array_equal(cavity.mask, np.fliplr(cavity.mask)):
+            continue
+        for piece in grouped.get(cavity.shape_key, []):
+            if len(_feasible_patches(piece, cavity)) >= 2:
+                sym_orbit_ok = True
+                break
+    if not sym_orbit_ok:
+        raise RuntimeError("missing symmetric ambiguous orbit")
+
+    return inp, out_crop
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        try:
+            inp, _out = _build_instance()
+            return inp
