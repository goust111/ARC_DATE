+                    "base_key": _canonical_key(base),
+                    "left_mask": left_mask,
+                    "right_mask": right_mask,
+                    "left_pos": (r, c),
+                    "right_pos": (r, rc),
+                    "symmetric_shape": np.array_equal(left_mask, np.fliplr(left_mask)),
