+def _extract_cavities(sub: np.ndarray) -> list[Cavity]:
+    holes = []
+    for coords in _components(sub == BG, connectivity=4):
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
