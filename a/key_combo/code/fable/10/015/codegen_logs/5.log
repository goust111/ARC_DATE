+    blocked: list[tuple[int, int, int, int]] = [(r0 - 1, c0 - 1, r1 + 1, c1 + 1)]
+    order = sorted(patches, key=lambda p: -int((p != BG).sum()))
+    for patch in order:
+        ph, pw = patch.shape
+        choices = []
+        for rr in range(h - ph + 1):
+            for cc in range(w - pw + 1):
