+def _place_group(occ: np.ndarray, placements: list[tuple[np.ndarray, int, int]]) -> None:
+    for mask, r0, c0 in placements:
+        mh, mw = mask.shape
+        occ[r0 : r0 + mh, c0 : c0 + mw][mask] = True
