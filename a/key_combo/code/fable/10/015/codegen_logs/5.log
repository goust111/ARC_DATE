+    for i, cavity in enumerate(cavities):
+        if i in used:
+            continue
+        refl = np.fliplr(cavity.full_mask)
+        j = lookup[refl.tobytes()]
+        if j == i:
+            orbits.append([i])
+            used.add(i)
+        else:
+            orbit = sorted([i, j], key=lambda idx: cavities[idx].bbox[1])
+            orbits.append(orbit)
+            used.update(orbit)
