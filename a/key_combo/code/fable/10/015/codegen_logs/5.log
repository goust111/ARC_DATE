+        style = random.choice(["random", "checker", "row", "col", "diag"])
+        for r, c in coords:
+            if len(colors) == 1:
+                val = colors[0]
+            elif style == "checker":
+                val = colors[(r + c) % 2]
+            elif style == "row":
+                val = colors[r % 2]
+            elif style == "col":
+                val = colors[c % 2]
+            elif style == "diag":
+                val = colors[(r <= c)]
+            else:
+                val = random.choice(colors)
+            patch[r, c] = val
