+    if len(orbits) < 2:
+        raise RuntimeError("too few cavity orbits")
+
+    grouped: dict[tuple[tuple[int, int], bytes], list[Piece]] = {}
+    for piece in pieces:
+        grouped.setdefault(piece.shape_key, []).append(piece)
+
+    axis_orbit_ok = False
+    for orbit in orbits:
+        if len(orbit) != 1:
+            continue
+        cavity = cavities[orbit[0]]
+        if not np.array_equal(cavity.mask, np.fliplr(cavity.mask)):
+            continue
+        for piece in grouped.get(cavity.shape_key, []):
+            feasible = _feasible_patches(piece, cavity)
+            sym_fits = [patch for patch in feasible if np.array_equal(patch, np.fliplr(patch))]
+            if len(feasible) >= 2 and len({patch.tobytes() for patch in sym_fits}) == 1:
+                axis_orbit_ok = True
+                break
+    if axis_shape is not None and not axis_orbit_ok:
+        raise RuntimeError("missing symmetric ambiguous orbit")
+
+    return inp, out_crop
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        try:
+            inp, _out = _build_instance()
+            return inp
+        except Exception:
+            continue
+    raise RuntimeError("failed to generate a valid input")

