+def _can_place_group(
+    occ: np.ndarray,
+    placements: list[tuple[np.ndarray, int, int]],
+    shape: tuple[int, int],
+) -> bool:
+    h, w = shape
+    new_cells = set()
+    for mask, r0, c0 in placements:
+        mh, mw = mask.shape
+        if r0 < 1 or c0 < 1 or r0 + mh > h - 1 or c0 + mw > w - 1:
+            return False
