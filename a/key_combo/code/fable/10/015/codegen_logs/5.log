+def _scatter_pieces(
+    grid_shape: tuple[int, int],
+    template_bbox: tuple[int, int, int, int],
+    patches: list[np.ndarray],
+) -> list[tuple[np.ndarray, int, int]] | None:
+    h, w = grid_shape
+    r0, c0, r1, c1 = template_bbox
