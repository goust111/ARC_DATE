+            cur_mask = np.rot90(base_mask, k)
+            key = (cur_mask.shape, cur_mask.tobytes(), cur_patch.tobytes())
+            if key not in seen:
+                seen.add(key)
+                out.append((cur_patch.copy(), cur_mask.copy()))
