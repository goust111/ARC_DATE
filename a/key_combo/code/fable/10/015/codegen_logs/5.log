+def _random_non_lr_patch(mask: np.ndarray, palette: list[int]) -> np.ndarray:
+    h, w = mask.shape
+    coords = np.argwhere(mask)
+    for _ in range(200):
+        patch = np.zeros((h, w), dtype=int)
