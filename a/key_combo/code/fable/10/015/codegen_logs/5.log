+                    left = patch
+                    right = np.fliplr(left)
+                else:
+                    right = patch
+                    left = np.fliplr(right)
+                candidates[(left.tobytes(), right.tobytes())] = (left.copy(), right.copy())
+    else:
+        assert len(pieces) == 2
+        for left_piece, right_piece in ((pieces[0], pieces[1]), (pieces[1], pieces[0])):
