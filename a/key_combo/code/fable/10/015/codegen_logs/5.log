+    candidates = []
+    for patch in _feasible_patches(pieces[0], cavity):
+        if np.array_equal(patch, np.fliplr(patch)):
+            candidates.append(patch)
+    uniq = {(cand.shape, cand.tobytes()): cand for cand in candidates}
+    assert len(uniq) == 1
+    return next(iter(uniq.values()))
