+    if len(orbits) < 2:
+        raise RuntimeError("too few cavity orbits")
+
+    grouped: dict[tuple[tuple[int, int], bytes], list[Piece]] = {}
+    for piece in pieces:
+        grouped.setdefault(piece.shape_key, []).append(piece)
+
+    axis_orbit_ok = False
+    for orbit in orbits:
+        if len(orbit) != 1:
+            continue
