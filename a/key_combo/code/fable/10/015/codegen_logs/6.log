+        for c in range(w):
+            color = int(grid[r, c])
+            if visited[r, c] or color in (BG, RED):
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
