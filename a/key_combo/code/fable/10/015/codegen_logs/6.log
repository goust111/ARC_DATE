+    red_points = {tuple(map(int, rc)) for rc in np.argwhere(g == RED)}
+    origins = [sprite.origin for sprite in sprites]
+    headings = [0 for _ in sprites]
+    terminated = [False for _ in sprites]
+
+    trace = {
+        "turns_total": 0,
+        "moves_total": 0,
+        "stops_total": 0,
+        "wait_blocked_total": 0,
+        "wait_conflict_total": 0,
