+    return out
+
+
+def _place_patches(shape: tuple[int, int], patches: list[np.ndarray]) -> list[tuple[int, int]] | None:
+    occupied = np.zeros(shape, dtype=bool)
+    blocked = np.zeros(shape, dtype=bool)
