+        return _polyline_path(base, start_horizontal=random.choice([True, False]))
+
+    raise ValueError(f"unknown family: {family}")
+
+
+def _dilate_path(path: list[tuple[int, int]], radius: int) -> np.ndarray:
+    pts: set[tuple[int, int]] = set()
