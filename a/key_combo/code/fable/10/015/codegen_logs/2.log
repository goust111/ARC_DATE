+def _peel_depth(mask: np.ndarray) -> int:
+    """Number of 4-neighbor boundary peels needed to erase a solid blob."""
+    cur = np.asarray(mask, dtype=bool).copy()
+    depth = 0
+    while cur.any():
+        depth += 1
+        nxt = np.zeros_like(cur)
+        if cur.shape[0] >= 3 and cur.shape[1] >= 3:
+            nxt[1:-1, 1:-1] = (
+                cur[1:-1, 1:-1]
+                & cur[:-2, 1:-1]
+                & cur[2:, 1:-1]
+                & cur[1:-1, :-2]
+                & cur[1:-1, 2:]
+            )
+        cur = nxt
+    return depth
