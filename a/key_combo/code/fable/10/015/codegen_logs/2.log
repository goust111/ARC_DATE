+
+
+def _expand8(mask: np.ndarray) -> np.ndarray:
+    padded = np.pad(mask, 1, constant_values=False)
+    out = np.zeros_like(mask, dtype=bool)
+    h, w = mask.shape
+    for dr in range(3):
+        for dc in range(3):
