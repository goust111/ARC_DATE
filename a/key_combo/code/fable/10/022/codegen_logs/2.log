+        for dr, dc in piece["cells"]:
+            r = top + dr
+            c = left + dc
+            occ[r, c] = True
+            out[r, c] = int(piece["color"])
+
+        if trace:
+            steps.append(
+                {
+                    "color": int(piece["color"]),
+                    "top": int(top),
+                    "left": int(left),
+                    "choices": [len(v) for v in all_landings],
+                }
+            )
