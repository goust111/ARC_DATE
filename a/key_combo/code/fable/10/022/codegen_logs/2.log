+        placed = False
+        for left, right in _candidate_spans(w, prev_span):
+            segment = heights[left:right]
+            low = int(segment.min())
+            high = int(segment.max())
+            if high >= max_ceiling:
+                continue
+            ceiling_lo = high + 1
+            ceiling_hi = min(low + max_piece_height, max_ceiling)
+            if ceiling_lo > ceiling_hi:
