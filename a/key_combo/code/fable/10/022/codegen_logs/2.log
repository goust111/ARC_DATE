+        for rr, cc in norm:
+            by_col[int(cc)] = max(by_col.get(int(cc), -1), int(rr))
+        pieces.append(
+            {
+                "color": color,
+                "cells": [(int(r), int(c)) for r, c in norm],
+                "h": h,
+                "w": w,
+                "bottoms": by_col,
+            }
+        )
+    return pieces
+
