+def _enumerate_lines(shape: tuple[int, int], orientation: str) -> list[dict[str, object]]:
+    h, w = shape
+    lines: list[dict[str, object]] = []
+    if orientation == "main":
+        keys = range(-(w - 1), h)
+    else:
+        keys = range(h + w - 1)
+    for key in keys:
+        line = _candidate_line(shape, orientation, key)
+        if line is not None:
+            lines.append(line)
+    return lines
+
