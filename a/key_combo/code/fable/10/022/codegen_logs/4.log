+    mains: list[dict[str, object]], antis: list[dict[str, object]]
+) -> tuple[list[dict[str, object]], np.ndarray]:
+    count = len(mains) + len(antis)
+    colors = random.sample(COLOR_POOL, count)
+    colored_lines: list[dict[str, object]] = []
+    for line, color in zip(mains + antis, colors):
+        inst = dict(line)
+        inst["color"] = int(color)
+        colored_lines.append(inst)
