  "type": "move_along_path",
  "src": "red four-pixel hollow-plus markers; each marker's empty center is an anchor",
  "dst": "connect to the nearest marker anchor sharing the same row or column",
  "path": "straight horizontal or vertical background gap between adjacent anchors, from one marker's outer arm to the other's opposing arm",
  "trajectory": "paint every visited background pixel blue",
  "transform": "preserve all red marker pixels and their empty centers"
}
</annotation>
