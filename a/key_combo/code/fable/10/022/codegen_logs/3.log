+
+
+def _placed_center(obj: dict[str, object]) -> tuple[float, float]:
+    top, left = obj["top_left"]
+    patch = np.asarray(obj["patch"], dtype=int)
+    rr, cc = np.nonzero(patch != BG)
+    return float(top + rr.mean()), float(left + cc.mean())
