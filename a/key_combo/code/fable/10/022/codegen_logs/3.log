+            continue
+        ih = int(inner[:, 0].max()) + 1
+        iw = int(inner[:, 1].max()) + 1
+
+        outer = {(r, c) for r in range(ih + 2) for c in range(iw + 2)}
+        inner_shifted = {(int(r) + 1, int(c) + 1) for r, c in inner}
