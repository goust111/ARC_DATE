+    for obj in ordered:
+        footprint = np.asarray(obj["footprint"], dtype=bool)
+        ph, pw = footprint.shape
+        candidates = [
+            (r, c)
+            for r in range(h - ph + 1)
+            for c in range(w - pw + 1)
+            if _can_place(reserved, footprint, r, c)
