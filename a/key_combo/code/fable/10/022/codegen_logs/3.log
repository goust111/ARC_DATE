def _gen_choose_rectangles(
    output: np.ndarray, min_erased: int, max_erased: int
) -> list[tuple[int, int, int, int]] | None:
    foreground = output != GEN_BACKGROUND
    candidates = _gen_rect_candidates(foreground)
