+    w = int(coords[:, 1].max()) + 1
+    patch = np.zeros((h, w), dtype=int)
+    patch[coords[:, 0], coords[:, 1]] = int(color)
+    return patch
+
+
+def _make_ring(color: int, hole_area: int, *, compact: bool) -> dict[str, object] | None:
