    base: np.ndarray,
    piece_specs: list[dict],
    max_terrain_height: int,
) -> np.ndarray | None:
    h, w = base.shape
    grid = base.copy()
    blocked = base != BG
    top_band = h - int(max_terrain_height) - 3
    if top_band < 3:
        return None

    order = sorted(piece_specs, key=lambda rec: (-rec["h"], -rec["w"]))
    for rec in order:
        cells = rec["cells"]
        ph = int(rec["h"])
        pw = int(rec["w"])
        candidates: list[tuple[int, int]] = []
        for top in range(0, max(1, top_band - ph + 1)):
