spec:
  grid: 9-14 rows x 15-16 cols, background BLACK
  markers:
    count: 3-5 hollow-plus shapes, all one color (RED) [observed]
    shape: 4 pixels at N/S/E/W of center; center cell is background; 3x3 bounding box
    placement: center >=1 cell from every grid edge; no two 3x3 bboxes overlap (center Chebyshev distance >=3)
  connections:
    rule: for each row/column containing >=2 marker centers, sort them and connect each adjacent pair
    gap: 1-5 background cells between the outer arms of adjacent aligned markers; gap must be all background
    fill_color: BLUE painted over every gap cell
    total_connections: 2-4 per puzzle (must be >=1)
  unconnected_markers: 0-1 markers that share no row or column with any other marker [observed]
  constraint: no marker or other foreground pixel may lie on any connection path

generation_strategy:
