+
+
+def _covers_constraints(chosen: list[dict[str, object]]) -> bool:
+    if len(chosen) < 3:
+        return False
+    first_dirs = {int(info["first_dir"]) for info in chosen}
+    has_gap_effect = any(
+        bool(info["used_gap"]) and int(info["gapless_final_col"]) != int(info["final_col"])
+        for info in chosen
