+def _lattice_neighbors(node: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = node
+    out = []
+    for dr, dc in N4:
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < 4 and 0 <= nc < 3:
+            out.append((nr, nc))
+    return out
