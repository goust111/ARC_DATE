+import numpy as np
+
+
+BG = 0
+GREY = 5
+STATION_SIZE = 5
+INNER_SLICE = slice(1, 4)
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TEMP_CANVAS = 30
+GEN_RETRIES = 600
+
+STAMP_MASKS = (
+    np.array(
