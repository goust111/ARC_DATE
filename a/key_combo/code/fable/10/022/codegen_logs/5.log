+    node_set = {start}
+    graph: dict[tuple[int, int], set[tuple[int, int]]] = {start: set()}
+    while len(nodes) < node_count:
+        choices = []
+        for node in nodes:
+            if len(graph[node]) >= 3:
+                continue
+            for nxt in _lattice_neighbors(node):
+                if nxt not in node_set:
+                    choices.append((node, nxt))
