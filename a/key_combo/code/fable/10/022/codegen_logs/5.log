+def _bfs_dist(graph: dict[int, set[int]], start: int) -> dict[int, int]:
+    dist = {start: 0}
+    q = deque([start])
+    while q:
+        node = q.popleft()
+        for nxt in graph[node]:
+            if nxt not in dist:
+                dist[nxt] = dist[node] + 1
+                q.append(nxt)
+    return dist
+
+
+def _nonempty_colors(stamp: np.ndarray) -> set[int]:
+    return {int(v) for v in np.unique(stamp) if int(v) != BG}
+
