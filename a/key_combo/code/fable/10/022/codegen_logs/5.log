+) -> dict[tuple[int, int], dict[tuple[int, int], int]]:
+    dists = {}
+    for node in nodes:
+        q = deque([node])
+        dist = {node: 0}
+        while q:
+            cur = q.popleft()
+            for nxt in graph[cur]:
+                if nxt not in dist:
+                    dist[nxt] = dist[cur] + 1
