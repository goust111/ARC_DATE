+    tops: dict[tuple[int, int], tuple[int, int]],
+) -> dict[frozenset[tuple[int, int]], int] | None:
+    edge_lengths: dict[frozenset[tuple[int, int]], int] = {}
+    done: set[frozenset[tuple[int, int]]] = set()
+    for node in nodes:
+        for nxt in graph[node]:
