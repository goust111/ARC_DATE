+            [1, 1, 0],
+            [0, 1, 0],
+            [0, 1, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1, 1],
+            [0, 1, 0],
+            [1, 0, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
