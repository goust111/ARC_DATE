+    right_top: tuple[int, int],
+) -> tuple[list[list[tuple[int, int]]], set[tuple[int, int]]]:
+    lr, lc = left_top
+    rr, rc = right_top
+    row = lr + 2
+    start = (row, lc + 5)
+    end = (row, rc - 1)
+    left_port = (lr + 2, lc + 4)
+    right_port = (rr + 2, rc)
+    gap = end[1] - start[1] + 1
