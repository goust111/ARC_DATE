+    if gap >= 5:
+        shifts = [-2, -1, 1, 2]
+        random.shuffle(shifts)
+        for shift in shifts:
+            bend_row = row + shift
+            c1 = start[1] + 1
+            c2 = end[1] - 1
+            path = _line_cells(start, (row, c1))
+            path += _line_cells((row, c1), (bend_row, c1))[1:]
+            path += _line_cells((bend_row, c1), (bend_row, c2))[1:]
+            path += _line_cells((bend_row, c2), (row, c2))[1:]
+            path += _line_cells((row, c2), end)[1:]
