+        col_steps = [random.randint(9, 12) for _ in range(2)]
+        rows = [row0]
+        cols = [col0]
+        for step in row_steps:
+            rows.append(rows[-1] + step)
+        for step in col_steps:
+            cols.append(cols[-1] + step)
