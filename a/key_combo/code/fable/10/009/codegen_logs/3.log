+        sub = grid[r0 : r0 + patch.shape[0], target_c0 : target_c0 + patch.shape[1]]
+        sub[patch == BLACK] = BLACK
+
+    for r, (c, color) in controls.items():
+        grid[r, c] = color
+    return grid
+
