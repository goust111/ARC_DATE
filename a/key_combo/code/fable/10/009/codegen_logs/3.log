+        r0 = sprite["row"]
+        c0 = sprite["col"]
+        max_delta = c0
+        assert max_delta >= 1
+        delta = random.randint(1, max_delta)
+        if zero_delta_budget and random.random() < 0.5:
+            delta = 0
+            zero_delta_budget -= 1
