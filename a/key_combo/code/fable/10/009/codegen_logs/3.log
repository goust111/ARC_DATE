+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+BG_CHOICES = [4, 6, 7, 8]
+
+MAX_GENERATION_ATTEMPTS = 400
+MIN_SPRITES = 2
+MAX_SPRITES = 4
+LEFT_W_RANGE = (7, 14)
