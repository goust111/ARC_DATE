+def _find_separator_col(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == GREY)]
+    assert len(cols) == 1, f"expected one full-height grey separator, got {cols}"
+    return int(cols[0])
