+    r0, c0 = a
+    r1, c1 = b
+    dr = r1 - r0
+    dc = c1 - c0
+    length = max(abs(dr), abs(dc))
+    assert length > 0
+    assert abs(dr) in (0, length)
+    assert abs(dc) in (0, length)
+    sr = _sign(dr)
+    sc = _sign(dc)
+    return [(r0 + i * sr, c0 + i * sc) for i in range(length + 1)]
