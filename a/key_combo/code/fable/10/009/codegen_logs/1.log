    r, c = random_free_location(grid, sprite, transparent=Color.BLACK, border=1, padding=0, padding_connectivity=8)
    paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)

    # randomly rotate
    grid = np.rot90(grid,-(random.randint(0, 4)))

    return grid

    

