+    return out
+
+
+def _choose_lengths() -> tuple[int, int]:
+    diag_len = random.randint(3, 6)
+    straight_len = random.randint(2, 6)
+    return diag_len, straight_len
+
+
+def _sample_geometry() -> tuple[
+    tuple[int, int],
+    tuple[int, int],
+    tuple[int, int],
+    tuple[int, int],
+    tuple[int, int],
+    tuple[int, int],
+]:
