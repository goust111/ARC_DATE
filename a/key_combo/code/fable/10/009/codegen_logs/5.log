+    return {
+        "bg": bg,
+        "top_r0": top_r0,
+        "top_r1": top_r1,
+        "sep_r": sep_r,
+        "blocks": blocks,
+        "keys": keys,
+        "source_to_dest": source_to_dest,
+    }
+
+
+def _render_output(grid, info):
+    out = np.full_like(grid, info["bg"])
+    top_r0 = info["top_r0"]
+    top_r1 = info["top_r1"]
+    blocks = info["blocks"]
