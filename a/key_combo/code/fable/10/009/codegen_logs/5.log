+        if key["dest_slot"] != dst_slot:
+            return None
+
+    if not np.array_equal(main(grid), true_out):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
