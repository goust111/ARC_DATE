+BLOCK_COUNT_CHOICES = (3, 4)
+BLOCK_WIDTH_CHOICES = (6, 7)
+TOP_HEIGHT_RANGE = (6, 8)
+BOTTOM_HEIGHT_RANGE = (5, 8)
+OUTER_MARGIN_CHOICES = (0, 1)
+VERTICAL_MARGIN_CHOICES = (0, 1, 2)
+MAX_ATTEMPTS = 400
