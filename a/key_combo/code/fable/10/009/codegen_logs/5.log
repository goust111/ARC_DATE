+        rs = [r for r, _ in coords]
+        cs = [c for _, c in coords]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        shape = frozenset((int(r - r0), int(c - c0)) for r, c in coords)
