+    return frozenset(coords)
+
+
+SHAPE_LIBRARY = [
+    _shape(["11", "10"]),
+    _shape(["11", "01"]),
+    _shape(["111", "010"]),
+    _shape(["010", "111"]),
+    _shape(["110", "011"]),
+    _shape(["011", "110"]),
+    _shape(["111", "100"]),
+    _shape(["001", "111"]),
+    _shape(["110", "111"]),
+    _shape(["011", "111"]),
+    _shape(["111", "101"]),
+    _shape(["010", "111", "010"]),
