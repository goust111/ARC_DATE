+    _shape(["111", "010"]),
+    _shape(["010", "111"]),
+    _shape(["110", "011"]),
+    _shape(["011", "110"]),
+    _shape(["111", "100"]),
+    _shape(["001", "111"]),
+    _shape(["110", "111"]),
+    _shape(["011", "111"]),
+    _shape(["111", "101"]),
+    _shape(["010", "111", "010"]),
+    _shape(["110", "010", "011"]),
+]
+
+
+def _normalize(coords):
+    cells = list(coords)
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return frozenset((int(r - r0), int(c - c0)) for r, c in cells)
