+    if sum(len(branches) >= 2 for branches in branches_by_role.values()) < 2:
+        return False
+
+    out = main(grid)
+    if out.shape != (GRID_SHAPE[0] * GRID_SHAPE[0], GRID_SHAPE[1] * GRID_SHAPE[1]):
+        return False
+
+    for r in range(GRID_SHAPE[0]):
