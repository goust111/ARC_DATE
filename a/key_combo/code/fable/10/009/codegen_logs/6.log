7: def main(grid: np.ndarray) -> np.ndarray:
8:     """Build a right-aligned histogram of foreground colors by their object counts.
9: 
10:     Input structure
11:     A background canvas contains multiple solid monochromatic foreground objects;
12:     objects are counted separately per color using 4-connectivity.
13: 
14:     Rule
15:     Count the 4-connected objects of each non-background color. Sort the colors by
16:     decreasing object count, requiring those counts to be unique, and create one
17:     output row per color. The output width is the largest count; each row is
18:     background on the left and that row's color repeated count times on the right.
19: 
20:     Key insight
21:     The small output does not preserve object positions or object sizes; it is a
22:     ranked histogram of how many separate objects each color has.
23:     """
24:     g = np.asarray(grid, dtype=int)
25:     bg = get_bg(g)
