spec:
  grid: 16x16, background 0
  objects:
    type: filled solid-color squares, sizes 2x2 to 5x5
    colors: 3-4 distinct non-zero foreground colors, all counts unique
    per_color_count: 1-5 objects per color; counts form a set of distinct positive integers
    separation: no two objects 8-adjacent (min 1-cell gap everywhere)
    total_objects: 6-11
  output:
    height: number of foreground colors (3-4)
    width: largest per-color object count (3-5)
    structure: |
      right-aligned histogram; row i (top=0) corresponds to the color with
      the i-th largest count. Rightmost count cells filled with that color,
      rest background.
  constraints:
