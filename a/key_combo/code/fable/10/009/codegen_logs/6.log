6: def main(grid: np.ndarray) -> np.ndarray:
7:     """Fill the interior implied by a left half-outline and its horizontal mirror.
8: 
9:     Input structure
10:     A 2D grid contains one background color and one foreground color. The
11:     foreground is the left half of a horizontally symmetric closed outline, with
12:     its global right edge immediately left of the vertical symmetry axis.
13: 
14:     Rule
15:     Clear the outline. For each row containing foreground, take the foreground
16:     pixel closest to the axis as the left boundary, mirror it across the
17:     half-column axis just to the right of the global right edge, and fill only
18:     the cells strictly between those two boundary pixels.
19: 
20:     Key insight
21:     Row segments near the top and bottom are outline, not fill; the row's
22:     rightmost foreground pixel is the inner boundary that determines that row's
23:     hidden symmetric interior span.
24:     """
25:     g = np.asarray(grid, dtype=int)
26:     bg = get_bg(g)
27:     fg_colors = colors_present(g, exclude={bg})
28:     assert len(fg_colors) == 1
29:     color = fg_colors[0]
30: 
31:     coords = np.argwhere(g == color)
32:     assert coords.size > 0
33:     axis_left = int(coords[:, 1].max())
34: 
35:     out = np.full_like(g, bg)
36:     for r in np.unique(coords[:, 0]):
37:         row_cols = np.sort(coords[coords[:, 0] == r, 1])
38:         assert np.array_equal(row_cols, np.arange(row_cols[0], row_cols[-1] + 1))
39: 
40:         inner_left = int(row_cols[-1])
41:         right_boundary = 2 * axis_left + 1 - inner_left
42:         assert right_boundary < g.shape[1]
43: 
44:         if inner_left + 1 < right_boundary:
45:             out[int(r), inner_left + 1 : right_boundary] = color
46: 
47:     return out
