40: 
41: # Grid geometry.
42: SEED_SIZE, BACKGROUND_COLOR = 4, 0
43: CELL_COUNT = SEED_SIZE * SEED_SIZE
44: # Numpy randint bounds; high values are exclusive.
45: FOREGROUND_COLOR_BOUNDS = (1, 10)
46: FOREGROUND_COUNT_BOUNDS = (4, 11)
47: GENERATION_RETRY_LIMIT = 300
48: 
49: def _gen_attempt() -> np.ndarray | None:
50:     color = int(np.random.randint(*FOREGROUND_COLOR_BOUNDS))
51:     fg_count = int(np.random.randint(*FOREGROUND_COUNT_BOUNDS))
52:     inp = np.zeros((SEED_SIZE, SEED_SIZE), dtype=int)
53:     cells = np.random.choice(CELL_COUNT, size=fg_count, replace=False)
54:     inp.flat[cells] = color
55:     out = np.zeros((CELL_COUNT, CELL_COUNT), dtype=int)
56:     for r in range(SEED_SIZE):
57:         for c in range(SEED_SIZE):
58:             if inp[r, c] != BACKGROUND_COLOR:
59:                 out[r * SEED_SIZE : (r + 1) * SEED_SIZE, c * SEED_SIZE : (c + 1) * SEED_SIZE] = inp
60:     if not np.array_equal(main(inp), out):
61:         return None
62:     return inp
