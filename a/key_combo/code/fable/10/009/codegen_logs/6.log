6: def main(grid: np.ndarray) -> np.ndarray:
7:     """
8:     Expand a monochrome seed grid by stamping the whole seed into every foreground-marked block.
9: 
10:     Input structure
11:     - The input is a 4x4 grid using black as the blank background and one non-black foreground color.
12:     - The same grid is both the seed sprite and the placement mask.
13: 
14:     Rule
15:     - Create a black output divided into 4x4 blocks, one block per input pixel.
16:     - For each non-background input pixel, copy the whole input grid into the corresponding output block.
17:     - For each background input pixel, leave the corresponding output block black.
18: 
19:     Key insight
20:     - The foreground mask selects locations for full self-copies; this is a self-similar block expansion, not a nearest-neighbor scale-up.
21:     """
22:     g = np.asarray(grid, dtype=int)
23:     assert g.ndim == 2, "expected a 2D grid"
24:     h, w = map(int, g.shape)
25:     assert (h, w) == (4, 4), "expected a 4x4 seed grid"
26: 
27:     bg = Color.BACKGROUND
28:     assert np.any(g == bg), "expected at least one background cell"
29:     foreground_colors = colors_present(g, exclude={bg})
30:     assert len(foreground_colors) == 1, "expected exactly one foreground color"
31: 
32:     out = np.full((h * h, w * w), bg, dtype=int)
33:     for r in range(h):
34:         for c in range(w):
35:             if int(g[r, c]) != bg:
36:                 out[r * h : (r + 1) * h, c * w : (c + 1) * w] = g
37:     return out
38: 
