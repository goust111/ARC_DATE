    ((1, 0, 1), (0, 1, 0), (1, 1, 1)): Color.GREEN,
    ((1, 1, 1), (1, 0, 1), (0, 1, 0)): Color.ORANGE,
}


def _normalized_mask(g: np.ndarray, color: int) -> tuple[tuple[int, ...], ...]:
    box = bbox(g == color)
