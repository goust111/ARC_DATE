+def _render_structure_patch(depth: int, direction: int, bg: int, sc: int) -> np.ndarray:
+    width = depth + 2
+    patch = np.full((STRUCTURE_HEIGHT, width), sc, dtype=int)
+    mid = STRUCTURE_HEIGHT // 2
+    if direction == 1:
+        patch[mid, depth : depth + 2] = bg
+    else:
