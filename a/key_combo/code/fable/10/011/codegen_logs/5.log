+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+
+MAX_ATTEMPTS = 400
+GRID_MAX = 30
+STRUCTURE_HEIGHT = 5
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _sign(x: int) -> int:
+    return 0 if x == 0 else (1 if x > 0 else -1)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_from_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _detect_socket_and_direction(
+    grid: np.ndarray, bg: int, bbox: tuple[int, int, int, int]
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    candidates: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if int(grid[r, c]) != bg:
+                continue
+            exit_dirs: list[tuple[int, int]] = []
+            for dr, dc in DIRS4:
+                rr, cc = r + dr, c + dc
+                advanced = False
+                while r0 <= rr <= r1 and c0 <= cc <= c1 and int(grid[rr, cc]) == bg:
+                    advanced = True
+                    rr += dr
+                    cc += dc
+                if advanced and not (r0 <= rr <= r1 and c0 <= cc <= c1):
+                    exit_dirs.append((dr, dc))
+            if len(exit_dirs) == 1:
+                candidates.append(((r, c), exit_dirs[0]))
+    assert len(candidates) == 1, "each structure must contain exactly one detectable socket"
+    return candidates[0]
+
+
+def _nearest_visible_red(
+    grid: np.ndarray,
+    bg: int,
+    red_at: dict[tuple[int, int], int],
+    remaining_reds: set[int],
+    socket: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[int, tuple[int, int], int] | None:
+    dr, dc = direction
+    r, c = socket
+    dist = 0
+    while True:
+        r += dr
+        c += dc
+        dist += 1
+        if not _in_bounds(grid.shape, r, c):
+            return None
+        val = int(grid[r, c])
+        if val == RED:
+            rid = red_at[(r, c)]
+            if rid in remaining_reds:
+                return rid, (r, c), dist
+            continue
+        if val == bg:
+            continue
+        return None
