+
+
+BLACK = 0
+RED = 2
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+
+MAX_ATTEMPTS = 400
+GRID_MAX = 30
+STRUCTURE_HEIGHT = 5
