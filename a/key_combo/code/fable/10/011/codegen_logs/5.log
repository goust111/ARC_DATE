+def _simulate_line(
+    sockets: list[tuple[int, int]],
+    reds: list[int],
+) -> tuple[list[tuple[int, int, int]], dict[int, int]] | None:
+    remaining = set(reds)
+    unresolved = set(range(len(sockets)))
+    history: list[tuple[int, int, int]] = []
+    initial_targets: dict[int, int] = {}
