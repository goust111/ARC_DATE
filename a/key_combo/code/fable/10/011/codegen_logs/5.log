+    red_components = _components_from_mask(g == RED)
+    assert red_components, "expected at least one red component"
+    red_at: dict[tuple[int, int], int] = {}
+    for rid, coords in enumerate(red_components):
+        for cell in coords:
+            red_at[cell] = rid
