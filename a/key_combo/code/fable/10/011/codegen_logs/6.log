+
+
+def _make_pattern(
+    rng: np.random.Generator, h: int, w: int, fill_pool: list[int]
+) -> np.ndarray:
+    max_colors = min(3, len(fill_pool))
+    for _ in range(120):
+        chosen = [int(c) for c in rng.choice(fill_pool, size=int(rng.integers(2, max_colors + 1)), replace=False)]
