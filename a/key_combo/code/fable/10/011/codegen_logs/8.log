+def _identify_roles(grid: np.ndarray) -> tuple[int, int, list[tuple[int, int]], int, int, set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
