+    colors = list(expected_chain)
+    top_order = _ordering_signature(info, colors, lambda line: (line["bbox"][0], line["bbox"][1]))
+    left_order = _ordering_signature(info, colors, lambda line: (line["bbox"][1], line["bbox"][0]))
