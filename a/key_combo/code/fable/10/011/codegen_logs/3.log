+                if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc]:
+                    out.append((rr, cc))
+        return out
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors=None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        assert monochromatic and return_format == "dict"
+        if colors is None:
+            colors = sorted(set(map(int, g.ravel())) - {int(bg)})
+        comps: list[dict] = []
+        for color in colors:
+            mask = g == int(color)
+            seen = np.zeros_like(mask, dtype=bool)
+            for r, c in np.argwhere(mask):
+                r = int(r)
+                c = int(c)
+                if seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in _neighbors(mask, rr, cc, connectivity):
+                        if not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
