+RNG = np.random.default_rng()
+PALETTE = tuple(range(10))
+CHAIN_LEN_RANGE = (4, 6)
+DISTRACTOR_RANGE = (1, 3)
+CELL_SIZE_CHOICES = (6, 7)
+LINE_LENGTH_BY_CELL = {6: (3, 4), 7: (3, 5)}
+MAX_ATTEMPTS = 400
+DIRS = ((0, 1), (1, 0), (1, 1), (1, -1))
+FOUR = ((-1, 0), (1, 0), (0, -1), (0, 1))
