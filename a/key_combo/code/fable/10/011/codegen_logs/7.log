+def _draw_grid(shape: tuple[int, int], bg: int, rects: list[dict[str, int]]) -> np.ndarray:
+    grid = np.full(shape, int(bg), dtype=int)
+    for rect in rects:
+        grid[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = rect["color"]
+    return grid
