_GEN_BG = 0
_GEN_RED = 2
_GEN_GREEN = 3
_GEN_YELLOW = 4
_GEN_MARKER = 6
_GEN_ORANGE = 7
_GEN_TEAL = 8

# Canvas and marker bounds.
_GEN_MIN_MARKERS = 1
_GEN_MAX_MARKERS = 3
_GEN_MIN_HEIGHT = 17
_GEN_MAX_HEIGHT = 28
_GEN_MIN_WIDTH = 10
_GEN_MAX_WIDTH = 29

# Lane and obstacle geometry.
_GEN_MIN_LANE_WIDTH = 3
_GEN_LANE_GAP_WIDTH = 1
_GEN_MIN_ORANGE_RUN = 1
_GEN_MAX_ORANGE_RUN = 7
_GEN_NOTCH_SIDE_MARGIN = 1

