+    for obj in orders["top"]:
+        out[0, obj["c0"] : obj["c1"] + 1] = obj["color"]
+    for obj in orders["bottom"]:
+        out[h - 1, obj["c0"] : obj["c1"] + 1] = obj["color"]
+    for obj in orders["left"]:
+        out[obj["r0"] : obj["r1"] + 1, 0] = obj["color"]
