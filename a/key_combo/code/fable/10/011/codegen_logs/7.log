+            return False
+        if np.array_equal(out, own_only):
+            return False
+
+        if len({obj["edge"] for obj in objects}) < 4:
+            return False
+        if not _has_foreign_occlusion(grid.shape, objects):
+            return False
+        if not _has_visible_but_noncasting_ray(grid.shape, objects):
