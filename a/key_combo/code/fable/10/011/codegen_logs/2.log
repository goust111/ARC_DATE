+
+def _solve_assignments(grid: np.ndarray) -> list[tuple[dict, dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    receptors = _parse_receptors(g, bg)
+    donors = _parse_donors(g, bg)
