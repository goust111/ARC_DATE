+        if kind == "mirror":
+            assert key in mirror_keys and key_counts[key] == 1
+        elif kind == "trap":
+            assert key in visible_keys and key_counts[key] == 1
+            trap_count += 1
+        else:
+            assert key not in visible_keys and key not in mirror_keys
+            extra_count += 1
+    assert trap_count >= 1
+    assert extra_count >= 1
+
+
