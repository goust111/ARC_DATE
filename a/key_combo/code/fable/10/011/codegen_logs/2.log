+def _random_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = start
+    tr, tc = end
+    mask[r, c] = True
+    while (r, c) != (tr, tc):
+        moves = []
+        if r < tr:
+            moves.append((1, 0))
+        elif r > tr:
+            moves.append((-1, 0))
+        if c < tc:
+            moves.append((0, 1))
+        elif c > tc:
+            moves.append((0, -1))
+        dr, dc = random.choice(moves)
+        r += dr
+        c += dc
+        mask[r, c] = True
