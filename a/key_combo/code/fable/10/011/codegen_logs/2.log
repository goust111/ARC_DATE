  "dst": "shared centered output canvas",
  "transform": "complete every corner-L layer to all four corners of its implied odd square, keep centered self-symmetric objects unchanged, and center all layers on the input background color",
  "grid_shape": "odd square whose side is the largest completed layer"
}
</annotation>
<generation_spec>
