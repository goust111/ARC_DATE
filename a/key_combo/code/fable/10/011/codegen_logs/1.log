+
+def _orientation_sequence(n: int) -> list[str]:
+    if n <= len(CORNER_NAMES) and random.random() < 0.75:
+        return random.sample(CORNER_NAMES, n)
+    seq: list[str] = []
+    prev = None
+    for _ in range(n):
+        choices = [name for name in CORNER_NAMES if name != prev]
+        nxt = random.choice(choices)
+        seq.append(nxt)
+        prev = nxt
