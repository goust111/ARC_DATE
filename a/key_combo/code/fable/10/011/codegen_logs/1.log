+
+
+def _reachability(rects: list[dict], edges: set[tuple[int, int]]) -> list[list[bool]]:
+    n = len(rects)
+    adj: list[list[int]] = [[] for _ in range(n)]
+    for src, dst in edges:
+        adj[int(src)].append(int(dst))
