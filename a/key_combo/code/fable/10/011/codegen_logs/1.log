+    if corner_name == "tl":
+        return miss_r, miss_c, ur1 + row_ext, uc1 + col_ext
+    if corner_name == "tr":
+        return miss_r, uc0 - col_ext, ur1 + row_ext, miss_c
+    if corner_name == "bl":
+        return ur0 - row_ext, miss_c, miss_r, uc1 + col_ext
