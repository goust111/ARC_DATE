+    _, shape = _normalize_bboxes(rects_top_down)
+    if max(shape) > MAX_STACK_SPAN:
+        return False
+
+    for idx, bbox in enumerate(rects_top_down):
+        higher = rects_top_down[:idx]
+        hidden = _hidden_corner_names(bbox, higher)
+        if idx == 0:
