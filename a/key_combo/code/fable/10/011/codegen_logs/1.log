+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+CORNER_NAMES = ("tl", "tr", "bl", "br")
+
+GEN_ATTEMPTS = 500
+STACK_ATTEMPTS = 200
+PRIMARY_LENGTHS = (2, 3)
+SECONDARY_LENGTHS = (1, 2)
+SECONDARY_PROB = 0.55
+TOP_HEIGHTS = (4, 5)
+TOP_WIDTHS = (4, 5)
+EXT_CHOICES = (1, 2)
+MAX_STACK_SPAN = 11
+MARGINS = (1, 2, 3)
+GAPS = (2, 3, 4)
