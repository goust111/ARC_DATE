+    for i in range(len(rects)):
+        for j in range(i + 1, len(rects)):
+            if not _overlap(rects[i]["bbox"], rects[j]["bbox"]):
+                continue
+            ij = reach[i][j]
+            ji = reach[j][i]
+            assert ij ^ ji, "every overlapping pair must have a unique layer order"
+
+    order = _topological_order(rects, edges)
