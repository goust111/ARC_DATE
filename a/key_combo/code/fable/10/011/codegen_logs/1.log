0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.
0012: 
0013:     Input structure
0014:     - The top row is a palette row with exactly one background gap.
0015:     - Below it, the only foreground is one vertical marker bar of a single color.
0016:     - The marker bar is either in the gap column or immediately beside it.
0017: 
0018:     Rule
0019:     - Clear the grid to background.
0020:     - Starting at the top of the marker bar, each next row copies one more
0021:       column of the top-row palette on both sides of the gap.
0022:     - Fill the gap column with the marker color, and keep the vertical marker bar.
0023: 
0024:     Key insight
0025:     - The lone background cell in the top row is the center of the expanding
0026:       copy; the lower vertical bar provides the center color and the row where
0027:       the expansion begins.
0028:     """
0029:     g = np.asarray(grid, dtype=int)
0030:     assert g.ndim == 2
0031:     height, width = g.shape
0032: 
0033:     bg = get_bg(g)
0034:     top = g[0, :]
0035:     gap_cols = np.flatnonzero(top == bg)
0036:     assert gap_cols.size == 1, "expected exactly one background gap in the top row"
0037:     gap_col = int(gap_cols[0])
0038: 
0039:     lower_coords = np.argwhere(g[1:, :] != bg)
0040:     assert lower_coords.size > 0, "expected a lower marker bar"
0041:     lower_coords[:, 0] += 1
0042: 
0043:     marker_colors = {int(g[r, c]) for r, c in lower_coords}
0044:     marker_cols = {int(c) for _r, c in lower_coords}
0045:     assert len(marker_colors) == 1, "expected one lower marker color"
0046:     assert len(marker_cols) == 1, "expected one lower marker column"
0047:     marker = marker_colors.pop()
0048:     line_col = marker_cols.pop()
0049:     line_start = int(lower_coords[:, 0].min())
0050: 
0051:     assert np.all(g[1:line_start, :] == bg), "rows before the marker bar must be background"
0052:     assert np.all(g[line_start:, line_col] == marker), "marker bar must be solid"
0053:     assert lower_coords.shape[0] == height - line_start, "marker bar must be the only lower foreground"
0054:     assert line_col == gap_col or abs(line_col - gap_col) == 1
0055:     if line_col != gap_col:
0056:         assert top[line_col] == marker
0057:     assert np.all(top[np.arange(width) != gap_col] != bg), "only the gap may be background in the palette row"
0058: 
0059:     out = np.full_like(g, bg)
0060:     out[line_start:, line_col] = marker
0061: 
0062:     for r in range(line_start, height):
0063:         radius = r - line_start
0064:         c0 = max(0, gap_col - radius)
0065:         c1 = min(width - 1, gap_col + radius)
0066:         for c in range(c0, c1 + 1):
0067:             if radius == 0 and c == gap_col and line_col != gap_col:
0068:                 continue
0069:             out[r, c] = marker if c == gap_col else int(top[c])
0070:         out[r, line_col] = marker
0071: 
