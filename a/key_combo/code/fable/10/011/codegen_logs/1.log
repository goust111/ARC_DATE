+        left = random.choice(MARGINS)
+        bottom = random.choice(MARGINS)
+        right = random.choice(MARGINS)
+        extra_h = random.randint(0, 2)
+        extra_w = random.randint(0, 2)
+        H = h + top + bottom + extra_h
+        W = w + left + right + extra_w
