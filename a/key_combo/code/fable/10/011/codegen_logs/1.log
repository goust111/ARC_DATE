+
+def _hidden_corner_names(
+    bbox: tuple[int, int, int, int], higher_bboxes: list[tuple[int, int, int, int]]
+) -> list[str]:
+    hidden: list[str] = []
+    for name, point in _corners(bbox).items():
+        if any(_point_interior(point, other) for other in higher_bboxes):
+            hidden.append(name)
+    return hidden
+
