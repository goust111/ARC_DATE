+
+
+def _layout_stacks(
+    stacks_top_down: list[list[tuple[int, int, int, int]]]
+) -> tuple[list[list[tuple[int, int, int, int]]], tuple[int, int]] | None:
+    stacks = stacks_top_down[:]
+    random.shuffle(stacks)
+    shapes = [_normalize_bboxes(stack)[1] for stack in stacks]
+
+    if len(stacks) == 1:
+        h, w = shapes[0]
