+    n = len(rects)
+    adj: list[list[int]] = [[] for _ in range(n)]
+    for src, dst in edges:
+        adj[int(src)].append(int(dst))
+    reach = [[False] * n for _ in range(n)]
+    for start in range(n):
+        stack = list(adj[start])
+        seen = set()
+        while stack:
+            cur = stack.pop()
+            if cur in seen:
+                continue
