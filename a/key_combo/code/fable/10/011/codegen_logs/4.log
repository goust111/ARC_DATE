    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    # For each structure, find its best (red, dir, anchor) triple.
    struct_best: list[tuple[tuple[int, int], int, tuple[int, int], tuple[int, int], int]] = []
    # entries: ((hit_count, -min_dist), rid, dir, anchor, sid)

