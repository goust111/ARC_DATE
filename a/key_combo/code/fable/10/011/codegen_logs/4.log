def _runs(rows: np.ndarray) -> list[tuple[int, int]]:
    rows = np.array(sorted(int(r) for r in rows), dtype=int)
    if rows.size == 0:
        return []
    out: list[tuple[int, int]] = []
    start = prev = int(rows[0])
    for value in rows[1:]:
        value = int(value)
        if value != prev + 1:
