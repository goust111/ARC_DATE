    start = (width - teeth) // 2
    g[0, :] = sc                         # back wall
    g[1, 1] = g[1, width - 2] = sc       # side walls row 1
    g[2:4, 1] = g[2:4, width - 2] = sc   # side walls rows 2-3
    g[1, start:start + teeth] = sc        # teeth
    return g


