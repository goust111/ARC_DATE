+def _tab_side(mask_or_patch: np.ndarray) -> str:
+    mask = np.asarray(mask_or_patch, dtype=bool)
+    h, w = map(int, mask.shape)
+    boundary_counts = {
+        "top": int(mask[0, :].sum()),
+        "bottom": int(mask[h - 1, :].sum()),
+        "left": int(mask[:, 0].sum()),
+        "right": int(mask[:, w - 1].sum()),
