+
+def _stamp_mask(
+    canvas: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    color: int,
+    *,
+    overwrite: bool,
+    clip: bool,
+) -> None:
+    patch = np.full(mask.shape, BG, dtype=int)
+    patch[np.asarray(mask, dtype=bool)] = int(color)
+    paste(canvas, patch, int(top), int(left), transparent=BG, overwrite=overwrite, clip=clip)
