+paste = _ARC_UTILS.paste
+
+
+BG = int(Color.BLACK)
+GREEN = int(Color.GREEN)
+COPY_COLORS = [int(c) for c in Color.NOT_BLACK if int(c) != GREEN]
+SIDE_LR = ("left", "right")
+SIDE_TB = ("top", "bottom")
+ALL_SIDES = SIDE_LR + SIDE_TB
