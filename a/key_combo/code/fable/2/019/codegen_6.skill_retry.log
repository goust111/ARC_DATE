+            tab_offset = random.randrange(tab_limit)
+            mask = _make_outline_mask(side, frame_h, frame_w, tab_offset)
+            signature = (tuple(map(int, mask.shape)), tuple(int(v) for v in mask.ravel()))
+            if signature in seen_signatures:
