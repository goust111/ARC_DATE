+
+def _visible_cells(mask: np.ndarray, top: int, left: int, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    cells = set()
+    for rr, cc in np.argwhere(mask):
+        r = int(top) + int(rr)
+        c = int(left) + int(cc)
+        if 0 <= r < h and 0 <= c < w:
