+    assert int(recovered["copy_color"]) == int(copy_color)
+    assert int(recovered["gap"]) == int(gap)
+    assert bool(recovered["same_side"]) == bool(same_side)
+    assert tuple(recovered["exemplar_bbox"]) == exemplar_bbox
