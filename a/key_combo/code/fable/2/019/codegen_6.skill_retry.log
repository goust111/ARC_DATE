+        if idx == exemplar_idx:
+            _stamp_mask(
+                inp,
+                spec["mirror_mask"],
+                placement["copy_top"],
+                placement["copy_left"],
+                copy_color,
+                overwrite=True,
+                clip=False,
+            )
+            _stamp_mask(
+                out,
+                spec["mirror_mask"],
+                placement["copy_top"],
+                placement["copy_left"],
+                copy_color,
+                overwrite=True,
+                clip=False,
+            )
