+            return None
+        if cc1 < c0:
+            gap = c0 - cc1 - 1
+            copy_side = "left"
+        elif cc0 > c1:
+            gap = cc0 - c1 - 1
+            copy_side = "right"
+        else:
+            return None
+        same_side = (side == "left" and copy_side == "left") or (side == "right" and copy_side == "right")
+    else:
+        if cc0 != c0 or cc1 != c1:
+            return None
+        if rr1 < r0:
+            gap = r0 - rr1 - 1
