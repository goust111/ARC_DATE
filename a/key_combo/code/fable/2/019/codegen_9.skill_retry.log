+def _solve_winners_by_crossing_bfs(
+    crossings: list[dict[str, int | tuple[int, int]]],
+    h_incident: list[list[int]],
+    v_incident: list[list[int]],
+    anchor_cid: int,
+    anchor_state: int,
+) -> list[int]:
+    states: list[int | None] = [None] * len(crossings)
