+        from_h = int(h_phase[hid]) ^ (int(cross["h_order"]) & 1)
+        from_v = int(v_phase[vid]) ^ (int(cross["v_order"]) & 1)
+        assert from_h == from_v, "horizontal and vertical phase propagation disagree"
