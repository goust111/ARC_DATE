+        else:
+            phase = v_phase[idx]
+            assert phase is not None
+            for cid in v_incident[idx]:
+                cross = crossings[cid]
+                state = int(phase) ^ int(cross["v_order"])
+                hid = int(cross["hid"])
+                expected = int(state) ^ int(cross["h_order"])
+                if h_phase[hid] is None:
+                    h_phase[hid] = int(expected)
