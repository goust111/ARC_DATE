+RNG = np.random.default_rng()
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _sorted_points(coords: np.ndarray) -> list[tuple[int, int]]:
+    return sorted((int(r), int(c)) for r, c in coords.tolist())
+
+
+def _parse_input(grid: np.ndarray):
