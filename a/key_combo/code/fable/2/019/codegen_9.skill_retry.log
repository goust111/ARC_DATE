+        new_right = int(RNG.integers(max(new_left, right[-1]), nv))
+        left.append(new_left)
+        right.append(new_right)
+    right[-1] = nv - 1
+
+    matrix = np.zeros((nh, nv), dtype=bool)
+    for ridx in range(nh):
+        matrix[ridx, left[ridx] : right[ridx] + 1] = True
