        valid_dims = [
            (h, w)
            for h, w in _GEN_RECT_DIMS
            if remaining - h * w in sums_by_count[left]
        ]
        h, w = valid_dims[int(rng.integers(0, len(valid_dims)))]
        dims.append((h, w))
        remaining -= h * w

    rng.shuffle(dims)
    return dims


