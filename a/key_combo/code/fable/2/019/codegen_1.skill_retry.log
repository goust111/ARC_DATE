+
+def _sample_permutation(colors: list[int], style: str) -> dict[int, int]:
+    colors = list(colors)
+    mapping = {color: color for color in colors}
+
+    if style == "with_fixed":
+        cycle = random.sample(colors, random.randint(2, len(colors) - 1))
+        random.shuffle(cycle)
