+    moved = sum(int(mapping[color] != color) for color in colors)
+    if moved == 0:
+        return None
+    if not _semantic_check(grid, expected, mapping, top_lefts):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
