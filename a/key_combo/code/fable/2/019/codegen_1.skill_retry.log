    orbits, _, _ = _gen_symmetry_data()
    palette_size = int(
        rng.integers(_GEN_PALETTE_SIZE_MIN, _GEN_PALETTE_SIZE_MAX + 1)
    )
    palette = rng.choice(_GEN_COLORS, size=palette_size, replace=False)

