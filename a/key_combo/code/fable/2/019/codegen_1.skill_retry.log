+    random.shuffle(order)
+    if len(order) == 4:
+        groups = [order[:2], order[2:]]
+    else:
+        pivot = random.choice([2, 3])
+        groups = [order[:pivot], order[pivot:]]
+
+    out = {}
+    for group in groups:
+        for src, dst in zip(group, group[1:] + group[:1]):
+            out[src] = dst
