+            mapping[src] = dst
+        return mapping
+
+    if style == "single_cycle":
+        cycle = colors[:]
+        random.shuffle(cycle)
+        return {src: dst for src, dst in zip(cycle, cycle[1:] + cycle[:1])}
+
+    assert style == "split_cycles"
