_GEN_RECT_COUNT_MIN = 2
_GEN_RECT_COUNT_MAX = 4
_GEN_RECT_HEIGHT_MIN = 2
_GEN_RECT_HEIGHT_MAX = 6
_GEN_RECT_WIDTH_MIN = 2
_GEN_RECT_WIDTH_MAX = 6
_GEN_MASK_AREA_MIN = 18
_GEN_MASK_AREA_MAX = 96

