+MIN_SHAPES = 3
+MAX_SHAPES = 5
+SLOT_H = 7
+SLOT_W = 7
+MIN_GAP = 2
+OUTER_MARGIN = 1
+MAX_GRID = 30
+MAX_ATTEMPTS = 400
+OUTLINE_COLORS = [int(c) for c in Color.NOT_BLACK]
+
+_COUNT_BAG: list[int] = []
+_STYLE_BAG: list[str] = []
