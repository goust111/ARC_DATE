+import numpy as np
+
+
+BACKGROUND = 0
+MARKER_COLOR = 2
+SEGMENT_COLORS = np.array([1, 3, 4, 5, 6, 7, 8, 9], dtype=int)
+
+_RNG = np.random.default_rng()
+_GEN_CALL_COUNT = 0
+
+MAX_GENERATION_ATTEMPTS = 400
+HORIZONTAL_SIZE_RANGE = ((10, 18), (15, 25))
+VERTICAL_SIZE_RANGE = ((15, 25), (10, 18))
