+
+def _spaced_slots(size: int) -> list[int]:
+    start = int(_RNG.integers(1, 3))
+    slots = list(range(start, size - 1, 2))
+    if len(slots) < 3:
+        slots = list(range(1, size - 1, 2))
+    return slots
