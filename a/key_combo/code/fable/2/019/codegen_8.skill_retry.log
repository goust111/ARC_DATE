+def _fits_shape(occupied: np.ndarray, square_bbox: tuple[int, int, int, int], shape: list[tuple[int, int]], r0: int, c0: int) -> bool:
+    height, width = occupied.shape
+    r1 = r0 + max(r for r, _ in shape)
+    c1 = c0 + max(c for _, c in shape)
