+    if width > height:
+        for color in colors:
+            row = sr0 - 1 if sr0 > 0 else sr1 + 1
+            if 0 <= row < height and not occupied[row, width // 2]:
+                grid[row, width // 2] = int(color)
+                occupied[row, width // 2] = True
