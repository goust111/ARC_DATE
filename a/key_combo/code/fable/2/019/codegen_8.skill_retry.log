+ORBIT_CACHE: dict[tuple[int, tuple[int, ...]], tuple[tuple[tuple[int, int], ...], ...]] = {}
+COMPOSITION_TABLE: tuple[tuple[int, ...], ...] | None = None
+GROUP_BAG: list[tuple[str, tuple[int, ...]]] = []
+
+
+def get_bg(grid: np.ndarray) -> int:
