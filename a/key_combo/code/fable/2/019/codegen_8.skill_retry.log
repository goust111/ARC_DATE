+def _transform_maps(side: int) -> tuple[tuple[np.ndarray, np.ndarray], ...]:
+    side = int(side)
+    cached = TRANSFORM_CACHE.get(side)
+    if cached is not None:
+        return cached
+
+    rr, cc = np.indices((side, side))
+    last = side - 1
+    maps = (
+        (rr, cc),
+        (cc, last - rr),
+        (last - rr, last - cc),
+        (last - cc, rr),
+        (rr, last - cc),
+        (last - rr, cc),
+        (cc, rr),
+        (last - cc, last - rr),
+    )
+    TRANSFORM_CACHE[side] = maps
