+    if group_name.startswith("mirror") and side < 5:
+        return None
+    if not _semantic_ok(inp, out, square_bbox, mask_color, ops):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
