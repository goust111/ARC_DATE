+    if op == 1:
+        return int(c), int(last - r)
+    if op == 2:
+        return int(last - r), int(last - c)
+    if op == 3:
+        return int(last - c), int(r)
+    if op == 4:
+        return int(r), int(last - c)
+    if op == 5:
