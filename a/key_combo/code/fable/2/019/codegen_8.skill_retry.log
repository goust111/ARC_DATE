        reverse=True,
    )[:n_accent]
    accent_ids = {id(orb) for orb in accent_orbs}

    for orb in full_orbs + partial_orbs:
        color = accent_color if id(orb) in accent_ids else body_color
        for pos in orb["cells"]:
            patch[pos] = color

