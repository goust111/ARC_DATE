+    if get_bg(inp) != bg:
+        return None
+    if not _semantic_ok(inp, out, square_bbox, mask_color, ops):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a unique hidden-repair scene")

