+            if 0 <= row < height and not occupied[row, width // 2]:
+                grid[row, width // 2] = int(color)
+                occupied[row, width // 2] = True
+
+
+def _semantic_ok(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    square_bbox: tuple[int, int, int, int],
+    mask_color: int,
+    ops: tuple[int, ...],
+) -> bool:
+    candidates = _enumerate_candidates(inp)
+    if len(candidates) != 1:
