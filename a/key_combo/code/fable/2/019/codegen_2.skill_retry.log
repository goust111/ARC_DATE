def _gen_all_separated(new_bboxes: list[GenBBox], existing_bboxes: list[GenBBox]) -> bool:
    for i, bbox_a in enumerate(new_bboxes):
        for bbox_b in new_bboxes[i + 1 :]:
            if not _gen_bboxes_separated(bbox_a, bbox_b):
                return False
