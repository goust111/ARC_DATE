+    height = m * m + m + 1
+    width = n * n + n + 2
+    grid = np.full((height, width), bg, dtype=int)
+
+    row_lines = [k * (m + 1) for k in range(m + 1)]
+    col_lines = [1 + k * (n + 1) for k in range(n + 1)]
+    for r in row_lines:
+        grid[r, 1:] = divider
+    for c in col_lines:
