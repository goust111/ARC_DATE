+            continue
+        if not any(int(mask[r].sum()) < n for r in range(m)):
+            continue
+        if not any(int(mask[r].sum()) >= 2 for r in range(m)):
+            continue
+        if not any(int(mask[:, c].sum()) < m for c in range(n)):
+            continue
