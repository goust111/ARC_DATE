+            lc = left + label_c
+            r0 = min(top, lr)
+            c0 = min(left, lc)
+            r1 = max(top + ph - 1, lr)
+            c1 = max(left + pw - 1, lc)
+            if not _box_is_free(occupied, r0, c0, r1, c1):
+                continue
+
+            patch = region[top : top + ph, left : left + pw]
+            patch[mask] = GREY
+            region[lr, lc] = int(label_color)
+            _reserve_box(occupied, r0, c0, r1, c1)
