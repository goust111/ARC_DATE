import random, numpy as np
from collections import deque

BLACK=0
GRAY=5
PALETTE=[1,2,3,4,6,7,8,9]

def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[counts.argmax()])

def find_components(grid, bg=0, colors=None):
    H,W = grid.shape
    allowed = set(colors) if colors is not None else set(int(x) for x in np.unique(grid) if int(x)"'!=bg)
    seen = np.zeros((H,W), bool)
    out=[]
    for r in range(H):
        for c in range(W):
            col=int(grid[r,c])
            if seen[r,c] or col==bg or col not in allowed:
                continue
            dq=deque([(r,c)]); seen[r,c]=True; coords=[]
            while dq:
                rr,cc=dq.popleft(); coords.append((rr,cc))
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and int(grid[nr,nc])==col:
                        seen[nr,nc]=True; dq.append((nr,nc))
            arr=np.array(coords)
            r0,c0=arr.min(axis=0); r1,c1=arr.max(axis=0)
            out.append({'"'color':col,'coords':arr,'bbox':(int(r0),int(c0),int(r1),int(c1)),'area':len(coords)})
    return out

def max_empty_rectangles(empty_mask, min_h=2, min_w=2):
    H,W = empty_mask.shape
    best_area=0
    best=[]
    for r0 in range(H):
        good=np.ones(W,dtype=bool)
        for r1 in range(r0,H):
            good &= empty_mask[r1]
            h=r1-r0+1
            if h<min_h:
                continue
            c=0
            while c<W:
                if not good[c]:
                    c+=1; continue
                s=c
                while c<W and good[c]:
                    c+=1
                e=c-1
                w=e-s+1
                if w>=min_w:
                    area=h*w
                    rect=(r0,s,r1,e)
                    if area>best_area:
                        best_area=area; best=[rect]
                    elif area==best_area:
                        best.append(rect)
    return best_area, best

def solve_tiling(h,w,pieces):
    total=sum(ph*pw for ph,pw,_ in pieces)
    if total"'!=h*w:
        return []
    filled=np.zeros((h,w),dtype=bool)
    used=[False]*len(pieces)
    placement=[None]*len(pieces)
    solutions=[]
    order=sorted(range(len(pieces)), key=lambda i:(-(pieces[i][0]*pieces[i][1]),-pieces[i][0],-pieces[i][1],i))
    def dfs(k=0):
        if len(solutions)>=2:
            return
        if k==len(pieces):
            solutions.append(placement.copy()); return
        idx=np.argwhere(~filled)
        if idx.size==0:
            solutions.append(placement.copy()); return
        r,c = map(int, idx[0])
        for i in order:
            if used[i]:
                continue
            ph,pw,_ = pieces[i]
            if r+ph>h or c+pw>w:
                continue
            if filled[r:r+ph,c:c+pw].any():
                continue
            filled[r:r+ph,c:c+pw]=True
            used[i]=True
            placement[i]=(r,c)
            dfs(k+1)
            used[i]=False
            placement[i]=None
            filled[r:r+ph,c:c+pw]=False
    dfs()
    return solutions

def random_partition(h,w,count):
    rects=[(0,0,h,w)]
    orientations=[]
    while len(rects)<count:
        cand=[]
        for idx,(r,c,rh,rw) in enumerate(rects):
            for cut in range(1,rh):
                a=(r,c,cut,rw); b=(r+cut,c,rh-cut,rw)
                if cut*rw>=2 and (rh-cut)*rw>=2:
                    cand.append((idx,'"'H',cut,a,b))
            for cut in range(1,rw):
                a=(r,c,rh,cut); b=(r,c+cut,rh,rw-cut)
                if rh*cut>=2 and rh*(rw-cut)>=2:
                    cand.append((idx,'V',cut,a,b))
        if not cand:
            return None
        idx,ori,cut,a,b=random.choice(cand)
        rects=rects[:idx]+[a,b]+rects[idx+1:]
        orientations.append(ori)
    dims=[(rh,rw) for _,_,rh,rw in rects]
    if len(set(dims))"'!=len(dims):
        return None
    if len(set(r for r,_,_,_ in rects))<2 or len(set(c for _,c,_,_ in rects))<2:
        return None
    if '"'H' not in orientations or 'V' not in orientations:
        return None
    return rects

def place_pieces(H,W,container,pieces):
    grid=np.zeros((H,W),dtype=int)
    r0,c0,r1,c1=container
    occupied=np.zeros((H,W),dtype=bool)
    occupied[r0:r1+1,c0:c1+1]=True
    placements=[]
    piece_shapes=sorted([(ph,pw,col) for ph,pw,col in pieces], key=lambda x:-(x[0]*x[1]))
    for ph,pw,col in piece_shapes:
        cand=[]
        for rr in range(H-ph+1):
            for cc in range(W-pw+1):
                if occupied[max(0,rr-1):min(H,rr+ph+1), max(0,cc-1):min(W,cc+pw+1)].any():
                    continue
                cand.append((rr,cc,col,ph,pw))
        if not cand:
            return None
        rr,cc,col,ph,pw=random.choice(cand)
        grid[rr:rr+ph,cc:cc+pw]=col
        occupied[rr:rr+ph,cc:cc+pw]=True
        placements.append((rr,cc,ph,pw,col))
    return grid, occupied, placements

def break_rectangles(grid, container, occupied):
    H,W=grid.shape
    cr0,cc0,cr1,cc1=container
    target=container
    target_area=(cr1-cr0+1)*(cc1-cc0+1)
    protected=occupied.copy()
    protected[cr0:cr1+1,cc0:cc1+1]=True
    for step in range(200):
        area, rects=max_empty_rectangles(grid==BLACK)
        rects=[tuple(map(int,x)) for x in rects]
        if area==target_area and rects==[target]:
            return True
        bad=[r for r in rects if r"'!=target] if area==target_area else rects
        if area<target_area:
            return False
        # choose rectangle that is not target or extends beyond target
        rect=random.choice(bad)
        r0,c0,r1,c1=rect
        cand=[]
        center=((r0+r1)/2,(c0+c1)/2)
        for r in range(r0,r1+1):
            for c in range(c0,c1+1):
                if not (grid[r,c]==BLACK):
                    continue
                if cr0<=r<=cr1 and cc0<=c<=cc1:
                    continue
                if protected[r,c]:
                    continue
                # avoid touching pieces if possible
                near_piece=False
                for nr in range(max(0,r-1),min(H,r+2)):
                    for nc in range(max(0,c-1),min(W,c+2)):
                        if occupied[nr,nc]:
                            near_piece=True
                score=(abs(r-center[0])+abs(c-center[1]), near_piece)
                cand.append((score,r,c))
        if not cand:
            return False
        cand.sort(key=lambda x:(x[0][1], x[0][0]))
        _,r,c=cand[0]
        grid[r,c]=GRAY
    return False

for trial in range(200):
    H=random.randint(16,24); W=random.randint(16,24)
    ch=random.randint(4,8); cw=random.randint(4,8)
    count=random.randint(3,5)
    part=random_partition(ch,cw,count)
    if not part:
        continue
    area=ch*cw
    sols=solve_tiling(ch,cw,[(rh,rw,i) for _,_,rh,rw in part])
    if len(sols)!=1:
        continue
    cr0=random.randint(1,H-ch-1); cc0=random.randint(1,W-cw-1)
    container=(cr0,cc0,cr0+ch-1,cc0+cw-1)
    colors=random.sample(PALETTE,count)
    pieces=[(rh,rw,col) for (_,_,rh,rw),col in zip(part,colors)]
    res=place_pieces(H,W,container,pieces)
    if res is None:
        continue
    inp, occupied, placements = res
    if break_rectangles(inp,container,occupied):
        area2,rects=max_empty_rectangles(inp==BLACK)
        if area2==area and rects==[container]:
            print('"'success',trial,H,W,container,[(p[2],p[3]) for p in placements],len(np.argwhere(inp==GRAY)))
            break
else:
    print('no success')
