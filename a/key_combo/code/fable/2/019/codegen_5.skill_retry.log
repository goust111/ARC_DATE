+        orientation = random.choice(ORIENTATIONS)
+        max_piece_h = max(rect_h for _r0, _c0, rect_h, _rect_w in slot_rects)
+        max_piece_w = max(rect_w for _r0, _c0, _rect_h, rect_w in slot_rects)
