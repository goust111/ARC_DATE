+    return None
+
+
+def _ensure_unique_container(inp: np.ndarray, cavity: tuple[int, int, int, int], bg: int) -> bool:
+    """Add gray blockers until the sampled cavity is the unique largest empty rectangle."""
+    cr0, cc0, cr1, cc1 = cavity
