+        color = int(component["color"])
+        patch = crop_bbox(grid, component["bbox"])
+        assert np.all(patch == color), "every colored object must be a solid rectangle"
+        pieces.append(
+            {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "shape": tuple(map(int, patch.shape)),
+                "area": int(component["area"]),
+            }
+        )
