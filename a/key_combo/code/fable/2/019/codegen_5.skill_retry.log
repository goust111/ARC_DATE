    assert len(rects) == 1, 'expected a unique largest empty rectangle'
    r0, c0, r1, c1 = rects[0]
    assert area == sum(p['area'] for p in pieces)
    container_patch, placements = pack_by_order((r1-r0+1, c1-c0+1), pieces)
    out = g.copy()
    for p in pieces:
        pr0, pc0, pr1, pc1 = p['bbox']
        out[pr0:pr1+1, pc0:pc1+1] = BLACK
