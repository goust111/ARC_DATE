+                    continue
+                if protected[r, c]:
+                    continue
+                if cr0 <= r <= cr1 and cc0 <= c <= cc1:
+                    continue
+                near_fg = bool(
+                    np.any(
+                        inp[max(0, r - 1) : min(height, r + 2), max(0, c - 1) : min(width, c + 2)] != int(bg)
+                    )
+                )
+                dist = abs(r - center_r) + abs(c - center_c)
+                candidates.append((near_fg, dist, r, c))
