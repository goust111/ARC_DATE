    pieces = []
    for comp in comps:
        r0, c0, r1, c1 = map(int, comp['bbox'])
        patch = crop_bbox(grid, comp['bbox'])
        color = int(comp['color'])
        if not np.all(patch == color):
            raise AssertionError('every colored object must be a solid rectangle')
        pieces.append({'color': color, 'bbox': (r0,c0,r1,c1), 'shape': patch.shape, 'area': int(comp['area'])})
    pieces.sort(key=lambda p: (p['bbox'][0], p['bbox'][1], p['shape'][0], p['shape'][1], p['color']))
    tops = [(p['bbox'][0], p['bbox'][1]) for p in pieces]
    assert len(set(tops)) == len(tops)
    return pieces


def pack_by_order(container_shape, pieces):
    H, W = map(int, container_shape)
    out = np.full((H, W), BLACK, dtype=int)
    filled = np.zeros((H, W), dtype=bool)
    placements = []
    for piece in pieces:
        coords = np.argwhere(~filled)
        if coords.size == 0:
            raise AssertionError('container filled too early')
        r0, c0 = map(int, coords[0])
        h, w = map(int, piece['shape'])
        if r0 + h > H or c0 + w > W:
            raise AssertionError('piece sequence does not fit container bounds')
        if filled[r0:r0+h, c0:c0+w].any():
            raise AssertionError('piece sequence overlaps earlier placements')
        out[r0:r0+h, c0:c0+w] = int(piece['color'])
        filled[r0:r0+h, c0:c0+w] = True
        placements.append((r0, c0, h, w, int(piece['color'])))
    if not filled.all():
        raise AssertionError('piece sequence leaves holes inside the container')
    return out, placements


def solve(grid: np.ndarray):
    g = np.asarray(grid, dtype=int)
    pieces = extract_pieces(g)
