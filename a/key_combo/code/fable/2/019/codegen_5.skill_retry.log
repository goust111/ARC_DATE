    rects.sort(key=lambda x: (x[0], x[1], x[2], x[3]))
    dims = [(rh, rw) for _, _, rh, rw in rects]
    tops = {r for r, _, _, _ in rects}
    lefts = {c for _, c, _, _ in rects}
    if len(set(dims)) "'!= len(dims):
        return None
    if len(tops) < 2 or len(lefts) < 2:
