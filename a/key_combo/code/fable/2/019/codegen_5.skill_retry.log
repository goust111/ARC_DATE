+
+
+def _expected_output_from_layout(
+    inp: np.ndarray,
+    slot_rects: list[tuple[int, int, int, int]],
+    colors: list[int],
+    cavity: tuple[int, int, int, int],
+    bg: int,
+) -> np.ndarray:
+    """Construct the semantic target independently of the solver."""
+    out = inp.copy()
