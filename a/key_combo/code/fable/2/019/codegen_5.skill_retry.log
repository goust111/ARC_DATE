+    packed, placements = _pack_by_source_order((r1 - r0 + 1, c1 - c0 + 1), pieces, bg)
+    out = g.copy()
+    for piece in pieces:
+        pr0, pc0, pr1, pc1 = piece["bbox"]
+        out[pr0 : pr1 + 1, pc0 : pc1 + 1] = int(bg)
