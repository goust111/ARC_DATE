def composition(total: int, parts: int):
    if parts == 1:
        return [total]
    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
    cuts = [-1] + cuts + [total + parts - 1]
    return [b - a - 1 for a, b in zip(cuts, cuts[1:])]


def place_source_pieces(grid, rects, colors, orientation):
