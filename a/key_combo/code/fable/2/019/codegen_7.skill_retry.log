+K_SQUARE = "square"
+K_HBAR = "hbar"
+K_VBAR = "vbar"
+KIND_ORDER = {K_SQUARE: 0, K_HBAR: 1, K_VBAR: 2}
+
+OFFSETS = {
+    K_SQUARE: ((0, 0), (0, 1), (1, 0), (1, 1)),
+    K_HBAR: ((0, 0), (0, 1), (0, 2)),
+    K_VBAR: ((0, 0), (1, 0), (2, 0)),
+}
+OUTPUT_COLORS = {
+    K_SQUARE: TEAL,
+    K_HBAR: BLUE,
+    K_VBAR: RED,
+}
+INPUT_MARGIN = 3
+GRID_ROWS = (15, 24)
+GRID_COLS = (15, 24)
