+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        built = _build_case()
+        if built is None:
+            continue
+        grid, _out, _pieces = built
+        return grid
+    raise RuntimeError(f"failed to generate a valid puzzle instance after {GEN_ATTEMPTS} attempts")

