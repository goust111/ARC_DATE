+    kind = str(piece["kind"])
+    top = int(piece["top"])
+    left = int(piece["left"])
+    if kind == K_SQUARE:
+        return _piece_cells(kind, top, left)
+    if kind == K_HBAR:
+        return _piece_cells(kind, top, 0)
+    if kind == K_VBAR:
+        return _piece_cells(kind, 0, left)
