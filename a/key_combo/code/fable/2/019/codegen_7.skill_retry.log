+def _cover_solutions(mask: np.ndarray, limit: int = 2) -> list[list[dict]]:
+    candidates = _enumerate_candidates(mask)
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    cell_to_candidates: list[list[int]] = [[] for _ in cells]
