+    full_cover = (1 << len(cells)) - 1
+    solutions: list[list[dict]] = []
+
+    def search(covered: int, chosen: list[int]) -> None:
+        if len(solutions) >= int(limit):
+            return
+        if covered == full_cover:
+            solutions.append([candidates[idx] for idx in chosen])
