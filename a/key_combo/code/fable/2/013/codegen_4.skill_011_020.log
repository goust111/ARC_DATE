+
+    local_mask = np.zeros((h, w), dtype=bool)
+    coords = component["coords"]
+    local_mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    if h > 2 and w > 2 and np.any(local_mask[1:-1, 1:-1]):
