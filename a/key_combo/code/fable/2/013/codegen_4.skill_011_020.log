import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_anchor, draw_line, find_components, paste, random_free_location

# concepts:
# cups, filling

# description:
# In the input you will see a cups, meaning an almost-enclosed shape with a small opening on one of its sides, and empty space (black pixels) inside.
# To make the output grid, you should fill the interior of each cup with yellow, then shoot yellow out of the opening of the cup both straight out and diagonally from the edges of the opening.
# 

def main(input_grid):
    """
    Fill the cup interior with yellow and emit yellow rays from its opening.

    Input structure:
    - The grid contains one non-black cup shape on black background.
    - The cup encloses black interior cells and has an opening on one side.
    - The cup may be rotated to face any direction.

    Rule:
    - Find the cup bounding box and the black cells inside it.
    - Fill those interior cells yellow.
    - Draw yellow straight out through the opening and diagonally from the opening endpoints until blocked.

    Key insight:
    - The opening position relative to the cup center determines the outward direction of the fill.
    """
    # Plan:
    # 1. Detect the cup
    # 2. Find the mask of the inside of the cup
    # 3. Find the mask of the opening of the cup (on one of its sides)
    # 4. Fill the cup with yellow
    # 5. Shoot pixels outward from the opening (straight out)
    # 6. Shoot pixels outward from the opening (diagonally out, from the edges)
    
    # 1. Detect cup
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
    assert len(objects) == 1, "There should be exactly one cup"
    obj = list(objects)[0]

    output_grid = input_grid.copy()

    # 2. Extract what's inside the cup (as its own object), which is everything in the bounding box that is not the object itself
    _b = bbox(obj != Color.BLACK)
    assert _b is not None
    cup_r, cup_c, _r1, _c1 = _b
    cup_width = _r1 - cup_r + 1
    cup_height = _c1 - cup_c + 1
    inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
    inside_cup_mask[cup_r:cup_r+cup_width, cup_c:cup_c+cup_height] = True
    inside_cup_mask = inside_cup_mask & (obj == Color.BLACK)

    # 3. Extract the hole in the cup, which is what's inside and on the boundary of the bounding box
    # what's inside...
    hole_mask = inside_cup_mask.copy()
    # ...and then we need to remove anything not on the boundary
    hole_mask[cup_r+1 : cup_r+cup_width-1, cup_c+1 : cup_c+cup_height-1] = False

    # 4. Fill the cup with yellow
    output_grid[inside_cup_mask] = Color.YELLOW

    # 5. Shoot pixels outward from the opening (straight out)
    # Find the direction of the opening, which is the unit vector that points from the center of the cup to the hole
    _b = bbox(hole_mask != Color.BLACK)
    assert _b is not None
    hole_r, hole_c = bbox_anchor(_b, anchor='center')
    _b = bbox(obj != Color.BLACK)
    assert _b is not None
    cup_r, cup_c = bbox_anchor(_b, anchor='center')
    direction = (int(np.sign(hole_r - cup_r)), int(np.sign(hole_c - cup_c)))
    # Loop over every boundary pixel and shoot outward
    for r, c in np.argwhere(hole_mask):
        draw_line(output_grid, r, c, direction=direction, color=Color.YELLOW)

    # 6. Shoot pixels outward from the opening (diagonally out, from the edges)
    # Find the two extremal points on the boundary of the hole, which are the points farthest away from each other
    points_on_boundary = np.argwhere(hole_mask)
    pt1, pt2 = max({ ( (x1,y1), (x2,y2) ) for x1,y1 in points_on_boundary for x2,y2 in points_on_boundary },
                   key=lambda pair: np.linalg.norm(np.array(pair[0]) - np.array(pair[1])))
    
    # For each of those points, shoot diagonal lines in all directions, but stop as soon as you hit something that's not black
    for pt in [pt1, pt2]:
        for direction in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:
            draw_line(output_grid, pt[0]+direction[0], pt[1]+direction[1], direction=direction, color=Color.YELLOW, stop_at=Color.NOT_BLACK)
    
    return output_grid

def generate_input():
    # Generate the grid with random size
    # Pick a random width/height for this cup
    cup_width = np.random.randint(4, 8)
    cup_height = np.random.randint(3, 8)
    width = np.random.randint(max(8, cup_width + 3), 30)
    height = np.random.randint(max(8, cup_height + 3), 30)
    grid = np.full((width, height), Color.BLACK)

    # Make a sprite, which is just going to be a blue outline of a rectangle with a hole at the top
    sprite = np.full((cup_width, cup_height), Color.BLACK)
    color = np.random.choice([ color for color in Color.NOT_BLACK if color != Color.YELLOW ])
    sprite[0, :] = color
    sprite[-1, :] = color
    sprite[:, 0] = color
    sprite[:, -1] = color

    # Make an opening on one side (not in the corners).
    hole_c = 0
    hole_len = int(np.random.randint(1, max(2, cup_width - 2)))
    hole_r0 = int(np.random.randint(1, cup_width - 1 - hole_len + 1))
    sprite[hole_r0 : hole_r0 + hole_len, hole_c] = Color.BLACK

    # Find a random free location for it
    free_r, free_c = random_free_location(grid, sprite, transparent=Color.BLACK, border=1, padding=1, padding_connectivity=8)
    paste(grid, sprite, free_r, free_c, transparent=Color.BLACK, clip=True)

    # Do a random rotation, so the cup can face any direction
    grid = np.rot90(grid,-(np.random.randint(0, 4)))

    return grid    

import numpy as np
from typing import *
import random
from arc_utils import Color, collision, colors_present, contact, draw_line, find_components, first_free_location, paste, random_sprite, translate

# concepts:
# attraction, magnetism, translation5

# description:
# In the input you will see a green object and a red bar
# To make the output, move the green object to touch the red bar. Finally put a teal bar on the other side of the green object.

def main(input_grid):
    """
    Move the green object until it touches the red bar, then place a teal copy of the bar beyond it.

    Input structure:
    - The grid contains exactly one red bar and exactly one green object.
    - Both objects sit on a black background.
    - The scene may be rotated.

    Rule:
    - Find the shortest cardinal displacement that makes the green object touch the red bar.
    - Paste the green object at that touching position.
    - Recolor a copy of the red bar teal and translate it opposite the movement direction until clear.

    Key insight:
    - The red bar is both the contact target and the template for the teal bar placed on
      the far side of the moved green object.
    """
    # Plan:
    # 1. Detect the objects; separate the green thing from the red bar
    # 2. Move the green object to touch the red bar
    # 3. Add a teal bar on the other side of the green object

    # 1. Object detection and setup
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")

    red_objects = [ obj for obj in objects if Color.RED in colors_present(obj, exclude={ Color.BLACK }) ]
    green_objects = [ obj for obj in objects if Color.GREEN in colors_present(obj, exclude={ Color.BLACK }) ]

    assert len(red_objects) == 1, "There should be exactly one red object"
    assert len(green_objects) == 1, "There should be exactly one green object"
    
    red_object = red_objects[0]
    green_object = green_objects[0]

    # Make the output grid: Start with the red object, then add the green object and the teal bar
    output_grid = np.full_like(input_grid, Color.BLACK)
    paste(output_grid, red_object, 0, 0, transparent=Color.BLACK, clip=True)

    # 2. Move the green object to touch the red bar
    # First calculate what direction we have to move in order to contact the grey object
    # Consider all displacements, starting with the smallest translations first
    possible_displacements = [ (i*dr, i*dc) for i in range(0, 30) for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)] ]

    # Only keep the displacements that cause a contact between the colored object and the grey object
    valid_displacements = [ displacement for displacement in possible_displacements
                            if contact(object1=translate(green_object, *displacement), object2=red_object) ]
    assert valid_displacements, "There should be at least one valid displacement"

    # Pick the smallest valid displacement
    displacement = min(valid_displacements, key=lambda displacement: sum(abs(r) for r in displacement))

    # Extract the direction from the displacement
    direction = np.sign(displacement, dtype=int)

    # Translate and draw on the canvas
    green_object = translate(green_object, *displacement)
    paste(output_grid, green_object, 0, 0, transparent=Color.BLACK, clip=True)

    # 3. Add a teal bar on the other side of the green object
    # It should be the same shape as the red bar, but teal
    # To place it correctly, it needs to be on the other side so we go in the opposite direction that the green object moved
    teal_object = red_object.copy()
    teal_object[teal_object != Color.BLACK] = Color.TEAL
    opposite_direction = -direction
    # Move the teal object until it doesn't collide with anything
    while collision(object1=teal_object, object2=output_grid):
        teal_object = translate(teal_object, *opposite_direction)
    # Draw the teal object on the canvas
    paste(output_grid, teal_object, 0, 0, transparent=Color.BLACK, clip=True)
    
    return output_grid

def generate_input():
    # Make a long skinny grid with a green thing and a red vertical bar
    # Then randomly rotate to get a variety of orientations

    width, height = np.random.randint(10, 25), np.random.randint(3, 8)
    grid = np.full((width, height), Color.BLACK)

    bar_r = np.random.randint(0, width)
    grid[bar_r, :] = Color.RED

    green_sprite = random_sprite(3, height, color_palette=[Color.GREEN])
    _loc = first_free_location(grid, green_sprite, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    paste(grid, green_sprite, r, c, transparent=Color.BLACK, clip=True)

    # random rotation
    grid = np.rot90(grid,-(np.random.randint(0, 4)))

    return grid
from collections import Counter

import numpy as np

from arc_utils import get_bg


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw vertical bars for the colors whose bottom code-row frequency equals the marker count.

    Input structure
    The grid has a dominant background, one solid full-width separator row, a
    single contiguous marker run above the separator, and one non-background
    code row below the separator.

    Rule
    Count the marker pixels above the separator. In the code row, find every
    color that appears exactly that many times. For each occurrence of such a
    color, fill that column for the same number of cells immediately above the
    separator, using the code-row color.

    Key insight
    The marker run is the histogram target count, and the code row gives both
    the colors to test and the columns where matching bars must be drawn.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height = int(g.shape[0])
    bg = get_bg(g)

    separator_rows = [
        r
        for r in range(height)
        if np.all(g[r, :] == int(g[r, 0])) and int(g[r, 0]) != bg
    ]
    assert len(separator_rows) == 1, "expected one solid non-background separator row"
    separator_row = separator_rows[0]

    marker_mask = g[:separator_row, :] != bg
    assert marker_mask.any(), "expected marker pixels above the separator"
    marker_rows = np.flatnonzero(marker_mask.any(axis=1))
    assert len(marker_rows) == 1, "marker pixels must occupy one row"
    marker_row = int(marker_rows[0])
    marker_cols = np.flatnonzero(marker_mask[marker_row])
    assert len(marker_cols) == int(marker_mask.sum()), "expected no other foreground above the separator"
    assert len(set(map(int, g[marker_row, marker_cols]))) == 1, "marker run must be monochromatic"
    assert np.all(np.diff(marker_cols) == 1), "marker pixels must form a contiguous run"
    marker_count = len(marker_cols)

    code_rows = [r for r in range(separator_row + 1, height) if np.all(g[r, :] != bg)]
    assert len(code_rows) == 1, "expected one non-background code row below the separator"
    code = g[code_rows[0], :]

    start_row = separator_row - marker_count
    assert start_row >= 0, "marker count must fit above the separator"

    code_counts = Counter(map(int, code))
    selected_cols = [c for c, color in enumerate(map(int, code)) if code_counts[color] == marker_count]
    assert selected_cols, "expected at least one code color with marker-count frequency"

    out = g.copy()
    for col in selected_cols:
        color = int(code[col])
        assert np.all(out[start_row:separator_row, col] == bg), "bar target cells must be background"
        out[start_row:separator_row, col] = color

    return out

