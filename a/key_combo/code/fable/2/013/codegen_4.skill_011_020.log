+        "bbox": (r0, c0, r1, c1),
+        "color": int(color),
+        "open_side": open_side,
+        "leak_index": leak_index,
+        "opening_start": int(gap_map[open_side][0]),
+        "opening_len": int(len(gap_map[open_side])),
