+
+def _analyze_cup_mask(mask: np.ndarray, color: int) -> dict | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
