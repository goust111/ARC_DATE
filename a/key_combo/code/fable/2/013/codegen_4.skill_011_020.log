+    if cup["open_side"] == "bottom":
+        return slice(r0 + 1, r1 + 1), slice(c0 + 1, c1)
+    if cup["open_side"] == "left":
+        return slice(r0 + 1, r1), slice(c0, c1)
+    return slice(r0 + 1, r1), slice(c0 + 1, c1 + 1)
+
