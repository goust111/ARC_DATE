+    gap_map = {side: _edge_gaps(local_mask, side) for side in SIDES}
+    opening_sides = [side for side, gaps in gap_map.items() if len(gaps) >= 2 and _is_consecutive(gaps)]
+    if len(opening_sides) != 1:
+        return None
