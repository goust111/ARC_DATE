    g = np.asarray(grid, dtype=int)
    if g.ndim != 2:
        return False
    h, w = g.shape
    if h == 0 or w == 0 or h % 2 or w % 2:
        return False
    if h * h > 30 or w * w > 30:
        return False

    fg_mask = g != BACKGROUND
    fg_count = int(fg_mask.sum())
    if fg_count < 4 or fg_count > h * w - 2:
