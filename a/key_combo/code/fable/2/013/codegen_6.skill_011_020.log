+def _mode_for_call() -> tuple[bool, bool]:
+    global _GEN_CALL_COUNT
+    idx = _GEN_CALL_COUNT % 3
+    _GEN_CALL_COUNT += 1
+    if idx == 0:
+        return True, False
+    if idx == 1:
+        return False, True
+    return random.random() < 0.5, True
