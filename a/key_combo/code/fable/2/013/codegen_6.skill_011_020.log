+def _bfs_distances(walkable: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    dist = np.full(walkable.shape, INF, dtype=int)
+    if not walkable[start]:
+        return dist
+    q = deque([start])
+    dist[start] = 0
+    while q:
+        r, c = q.popleft()
