+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(walkable.shape, nr, nc) and walkable[nr, nc] and dist[nr, nc] == INF:
+                dist[nr, nc] = nd
+                q.append((nr, nc))
+    return dist
