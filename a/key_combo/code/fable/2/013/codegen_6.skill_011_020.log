+def _seed_candidates(main_mask: np.ndarray, require_branchy_red: bool) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    mids = [tuple(map(int, cell)) for cell in np.argwhere(main_mask)]
+    random.shuffle(mids)
