+def _validate_generated(inp: np.ndarray, require_pocket: bool, require_branchy_red: bool) -> bool:
+    if inp.ndim != 2 or max(inp.shape) > 30:
+        return False
+    if np.count_nonzero(inp == ORANGE) != 1 or np.count_nonzero(inp == BLUE) != 1:
+        return False
