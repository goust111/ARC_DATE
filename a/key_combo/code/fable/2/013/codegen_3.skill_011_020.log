+def _solve_fixpoint(grid: np.ndarray) -> np.ndarray:
+    """Generic fixpoint solver: supports any number of yellow/red sources."""
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    walls = out == Color.GREY
