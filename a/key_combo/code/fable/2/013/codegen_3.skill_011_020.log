+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    """Small self-contained 4-connected components helper for generator validation."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
