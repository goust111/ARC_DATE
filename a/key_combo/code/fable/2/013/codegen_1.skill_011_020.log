   213	    panels, frame, fill, stride = _split_panels(grid)
   214	    height, panel_w = panels[0].shape
   215	
   216	    first = _extract_panel_parts(panels[0], fill)
   217	    sprite_patch, sprite_mask, first_top, sprite_left, bar_patch, bar_mask, bar_top, bar_left = first
   218	
   219	    top_rows = [first_top]
   220	    for panel in panels[1:]:
