   227	        assert np.array_equal(cur_bar_mask, bar_mask)
   228	        top_rows.append(cur_top)
   229	
   230	    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]
   231	    assert deltas and len(set(deltas)) == 1
   232	    total_steps = _round_half_up(Fraction(deltas[0] * panel_w, stride))
   233	    assert total_steps != 0
   234	
   235	    out, _sprite_top, _bar_top = _simulate_output(
   236	        height,
   237	        panel_w,
   238	        frame,
   239	        fill,
   240	        sprite_patch,
   241	        sprite_mask,
   242	        top_rows[-1],
   243	        sprite_left,
   244	        bar_patch,
   245	        bar_mask,
   246	        bar_top,
   247	        bar_left,
   248	        total_steps,
   249	    )
   250	    return out
