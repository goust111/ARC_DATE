+    top_rows: list[int],
+    sprite_left: int,
+    bar_patch: np.ndarray,
+    bar_top: int,
+    bar_left: int,
+) -> np.ndarray:
+    stride = panel_w - 1
+    width = num_panels * stride + 1
+    grid = np.full((height, width), int(fill), dtype=int)
+    grid[0, :] = frame
+    grid[-1, :] = frame
