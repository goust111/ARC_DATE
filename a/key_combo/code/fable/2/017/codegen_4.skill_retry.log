+    rest: list[int] = []
+    for color, count in remaining.items():
+        rest.extend([int(color)] * int(count))
+    random.shuffle(rest)
+    flat.extend(rest)
+
+    pattern = np.array(flat, dtype=int).reshape(index_h, index_w)
+    assert _first_appearance_order(pattern) == [int(color) for color in first_order]
+    return pattern
