+SIDE_MARGIN_RANGE = (0, 3)
+RIGHT_MARGIN_RANGE = (0, 3)
+STENCIL_FILL_RANGE = (0.40, 0.78)
+STENCIL_RETRIES = 120
+GEN_RETRIES = 400
