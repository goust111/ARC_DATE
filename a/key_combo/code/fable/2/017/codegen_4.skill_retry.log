+        block_w = random.randint(*TEMPLATE_W_RANGE)
+
+        max_index_h = min(INDEX_H_RANGE[1], 30 // block_h)
+        max_index_w = min(INDEX_W_RANGE[1], 30 // block_w)
+        if max_index_h < INDEX_H_RANGE[0] or max_index_w < INDEX_W_RANGE[0]:
+            continue
+
