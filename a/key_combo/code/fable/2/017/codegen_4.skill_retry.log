+def _first_appearance_order(pattern: np.ndarray) -> list[int]:
+    order: list[int] = []
+    seen: set[int] = set()
+    for color in map(int, pattern.ravel()):
+        if color not in seen:
+            seen.add(color)
+            order.append(color)
+    return order
