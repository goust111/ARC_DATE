+def _different_first_order(rank_colors: list[int]) -> list[int]:
+    for _ in range(50):
+        order = rank_colors[:]
+        random.shuffle(order)
+        if order != rank_colors and order[0] != rank_colors[0]:
+            return order
+    return rank_colors[1:] + rank_colors[:1]
