+    assert chain_cells, "expected at least one pointer cell"
+
+    for cell_rc, parsed in chain_cells.items():
+        step = parsed["step"]
+        if step is None:
+            terminal_count += 1
+            continue
+        nr = cell_rc[0] + int(step[0])
+        nc = cell_rc[1] + int(step[1])
