+        if separator_color != SEPARATOR_COLOR:
+            return False
+        if len(row_spans) * len(col_spans) != len(path) + len(noise_assignment):
+            return False
+        path_index = {cell: idx for idx, cell in enumerate(path)}
+        observed_distractors = set()
+        for r in range(len(row_spans)):
