+    def paste(
+        dst: np.ndarray,
+        patch: np.ndarray,
+        r0: int,
+        c0: int,
+        *,
+        mask: np.ndarray | None = None,
+        transparent: int | None = None,
+        overwrite: bool = True,
+        clip: bool = False,
+    ) -> np.ndarray:
+        H, W = dst.shape
+        h, w = patch.shape
+        if not clip and (r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W):
+            raise ValueError("paste out of bounds")
+        rr0 = max(0, int(r0))
+        cc0 = max(0, int(c0))
+        rr1 = min(H, int(r0) + h)
+        cc1 = min(W, int(c0) + w)
+        if rr0 >= rr1 or cc0 >= cc1:
+            return dst
+        pr0 = rr0 - int(r0)
+        pc0 = cc0 - int(c0)
+        pr1 = pr0 + (rr1 - rr0)
+        pc1 = pc0 + (cc1 - cc0)
+        dst_view = dst[rr0:rr1, cc0:cc1]
+        patch_view = patch[pr0:pr1, pc0:pc1]
+        use = np.ones_like(patch_view, dtype=bool)
+        if mask is not None:
+            use &= mask[pr0:pr1, pc0:pc1]
+        if transparent is not None:
+            use &= patch_view != int(transparent)
+            if not overwrite:
+                use &= dst_view == int(transparent)
+        dst_view[use] = patch_view[use]
+        return dst
