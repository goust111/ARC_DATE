+def _has_turn(path: list[tuple[int, int]]) -> bool:
+    for i in range(1, len(path) - 1):
+        a = (path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1])
+        b = (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        if a != b:
