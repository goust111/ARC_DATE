+def _neighbors(cell_rc: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    r, c = cell_rc
+    out = []
+    for dr, dc in DIRS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < rows and 0 <= nc < cols:
