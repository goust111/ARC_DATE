+GRID_WIDTH_RANGE = (18, 30)
+TOTAL_CUP_RANGE = (2, 5)
+CHAIN_LENGTH_CAP = 4
+
+CUP_HEIGHT_RANGE = (4, 7)
+CUP_WIDTH_RANGE = (5, 9)
+MIN_BLANK_ROWS = 1
+EDGE_MARGIN = 1
