+def _rot_bbox(bbox: tuple[int, int, int, int], H: int, W: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return int(H - 1 - r1), int(W - 1 - c1), int(H - 1 - r0), int(W - 1 - c0)
+
