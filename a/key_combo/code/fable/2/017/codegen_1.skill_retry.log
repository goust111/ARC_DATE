+
+
+def _place_occluders(
+    rng: np.random.Generator,
+    pattern_bbox: tuple[int, int, int, int],
+    H: int,
+    W: int,
+    route_colors: list[int],
+    sizes: list[int],
+) -> list[dict[str, object]] | None:
+    pr0, pc0, pr1, pc1 = pattern_bbox
