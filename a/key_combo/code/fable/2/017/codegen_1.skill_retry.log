+    for _ in range(n_lines):
+        color = int(rng.choice(colors))
+        if bool(rng.integers(0, 2)):
+            sh = 1
+            sw = int(rng.integers(2, min(6, c1 - c0 + 1) + 1))
+        else:
+            sh = int(rng.integers(2, min(6, r1 - r0 + 1) + 1))
