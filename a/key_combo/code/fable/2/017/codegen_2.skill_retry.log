+def _rotate_shape(shape: tuple[int, int]) -> tuple[int, int]:
+    return shape if random.random() < 0.5 else (shape[1], shape[0])
+
+
+def _expand_bbox_cells(r0: int, c0: int, r1: int, c1: int, shape: tuple[int, int]) -> set[tuple[int, int]]:
