+import numpy as np
+
+
+SLASH_COLOR = 8
+BACKSLASH_COLOR = 2
+FRAME_COLOR_CHOICES = [1, 3, 4, 5, 6, 7, 9]
+EMITTER_COLOR_CHOICES = [1, 3, 4, 5, 6, 7, 9]
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
