+    suffix = dfs(start, start_dir, int(turn_target), {start})
+    if suffix is None:
+        return None
+    return {
+        "side": side,
+        "slot": int(slot),
+        "start": start,
+        "direction": start_dir,
+        "bg_cells": [start] + suffix["bg_cells"],
+        "mirrors": suffix["mirrors"],
+    }
+
