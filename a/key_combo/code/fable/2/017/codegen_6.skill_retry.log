+        "bg": int(bg),
+        "frame_color": int(frame_color),
+        "frame_bbox": frame_bbox,
+        "emitters": emitters,
+        "mirror_coords": mirror_coords,
+        "used_mirror_coords": used_mirror_coords,
+        "used_mirror_colors": used_mirror_colors,
+        "traces": traces,
