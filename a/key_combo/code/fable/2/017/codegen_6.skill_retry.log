+        return (0, int(slot)), DIRS["D"]
+    if side == "bottom":
+        return (height - 1, int(slot)), DIRS["U"]
+    if side == "left":
+        return (int(slot), 0), DIRS["R"]
+    if side == "right":
+        return (int(slot), width - 1), DIRS["L"]
+    raise ValueError(side)
+
