+                    "color": int(color),
+                    "side": "bottom",
+                    "slot": c - (c0 + 1),
+                    "start": (r1 - 1, c),
+                    "direction": DIRS["U"],
+                    "emitter": (r, c),
+                }
+            )
+        elif c == c0 - 1 and r0 < r < r1:
+            emitters.append(
+                {
+                    "color": int(color),
+                    "side": "left",
+                    "slot": r - (r0 + 1),
+                    "start": (r, c0 + 1),
+                    "direction": DIRS["R"],
+                    "emitter": (r, c),
+                }
+            )
+        elif c == c1 + 1 and r0 < r < r1:
+            emitters.append(
