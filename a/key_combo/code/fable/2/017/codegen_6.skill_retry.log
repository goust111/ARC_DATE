+            pos = (nr, nc)
+
+        traces.append(
+            {
+                "color": color,
+                "side": emitter["side"],
+                "slot": emitter["slot"],
+                "bg_cells": bg_cells,
+                "mirrors": mirrors_on_path,
+            }
