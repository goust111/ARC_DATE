+
+def _local_to_global(
+    cell: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+) -> tuple[int, int]:
+    r0, c0, _r1, _c1 = frame_bbox
+    return r0 + 1 + int(cell[0]), c0 + 1 + int(cell[1])
+
+
+def _emitter_global(
+    side: str,
+    slot: int,
+    frame_bbox: tuple[int, int, int, int],
+    height: int,
+    width: int,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame_bbox
+    if side == "top":
+        return r0 - 1, c0 + 1 + int(slot)
+    if side == "bottom":
+        return r1 + 1, c0 + 1 + int(slot)
+    if side == "left":
