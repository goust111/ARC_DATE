+    frame_color = int(rng.choice(FRAME_COLOR_CHOICES))
+    emitter_palette = [color for color in EMITTER_COLOR_CHOICES if color not in {frame_color, SLASH_COLOR, BACKSLASH_COLOR}]
+    path_count = int(rng.integers(2, 5))
