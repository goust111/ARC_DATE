import math
import random
from collections import Counter

import numpy as np


BG = 0
MARKER = 5
OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
NEIGHBORS8 = tuple(
    (dr, dc)
    for dr in (-1, 0, 1)
    for dc in (-1, 0, 1)
    if not (dr == 0 and dc == 0)
)

GENERATION_RETRIES = 500
ANGLE_EPS = 0.16
MARKER_SIDE_EPS = 0.14
_GEN_CALLS = 0
