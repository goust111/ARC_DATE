  "type": "transform_in_place",
  "src": "4-connected foreground fragments on the background; fragments whose bboxes share a row or column span form one incomplete rectangle group",
  "transform": "for each group, fill bg cells in its inclusive bbox red; preserve foreground pixels and bg outside group bboxes"
}
</annotation>
</reference_puzzle>

