@lru_cache(maxsize=None)
def _gen_can_sum_rect_areas(total, rect_count):
    if rect_count == 0:
        return total == 0
    return any(
        _gen_can_sum_rect_areas(total - h * w, rect_count - 1)
        for h, w in _GEN_RECT_DIMS
