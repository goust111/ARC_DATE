+        if has_same_area_distractor:
+            break
+    if not has_same_area_distractor:
+        return False
+
+    lock_centers = [_bbox_center(lock["bbox"]) for lock in locks]
+    nearest_wrong = False
+    for key_idx, key in enumerate(keys):
+        key_center = _bbox_center(key["bbox"])
