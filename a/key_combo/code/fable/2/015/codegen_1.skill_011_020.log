+    for _ in range(120):
+        width = random.randint(min_w, 30)
+        height = random.randint(min_h, 30)
+        actual_slot_w = (width - (count + 1) * col_gap) // count
+        if actual_slot_w < max(max_lock_w, max_key_w):
