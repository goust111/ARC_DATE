+def _random_polyomino(area: int, max_dim: int = 4) -> np.ndarray | None:
+    for _ in range(200):
+        cells = {(0, 0)}
+        while len(cells) < area:
+            frontier = set()
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) not in cells:
+                        frontier.add((nr, nc))
+            cells.add(random.choice(tuple(frontier)))
