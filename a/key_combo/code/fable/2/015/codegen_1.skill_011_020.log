+        out[coords[:, 0] + r0, coords[:, 1] + c0] = BG
+    for color, hole_local, (r0, c0) in zip(key_colors, hole_locals, lock_pos):
+        out[hole_local[:, 0] + r0, hole_local[:, 1] + c0] = color
+    return out
