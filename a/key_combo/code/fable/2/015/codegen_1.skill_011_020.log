+            h, w = patch.shape
+            r = lock_top + random.randint(0, lock_band_h - h)
+            c = col_starts[idx] + random.randint(0, actual_slot_w - w)
+            lock_pos.append((r, c))
+        for idx, patch in enumerate(key_patches):
+            h, w = patch.shape
+            slot = perm[idx]
+            r = key_top + random.randint(0, key_band_h - h)
