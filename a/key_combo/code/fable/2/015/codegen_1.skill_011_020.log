+        for idx, ((r, c), patch) in enumerate(zip(key_pos, key_patches)):
+            key_center = _bbox_center((r, c, r + patch.shape[0] - 1, c + patch.shape[1] - 1))
+            dists = [(key_center[0] - lr) ** 2 + (key_center[1] - lc) ** 2 for lr, lc in lock_centers]
