+        patch = _crop_bbox(g, comp["bbox"])
+        color = comp["color"]
+        if _is_lock_component(g, comp):
+            hole_full = patch == BG
+            hole_abs = np.argwhere(hole_full) + np.array([r0, c0], dtype=int)
+            locks.append(
