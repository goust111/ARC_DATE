+        if np.any(out[coords[:, 0], coords[:, 1]] != BG):
+            return False
+    for key_idx, (lock_idx, _rot) in matches.items():
+        hole_abs = locks[lock_idx]["hole_abs"]
+        if not np.all(out[hole_abs[:, 0], hole_abs[:, 1]] == keys[key_idx]["color"]):
+            return False
