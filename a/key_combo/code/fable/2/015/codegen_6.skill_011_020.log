+    bg = _get_bg(g)
+    comps = _components_mask(g != bg)
+    out = g.copy()
+
+    for comp in comps:
+        body_color, stem_color, body_bbox, direction, _attach = _extract_structure(g, comp, bg)
+        body_r0, body_c0, body_r1, body_c1 = body_bbox
