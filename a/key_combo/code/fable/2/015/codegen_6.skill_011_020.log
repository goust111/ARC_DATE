+        assert cols == list(range(cols[0], cols[-1] + 1)), "horizontal stem must be contiguous"
+        if cols[-1] == c0 - 1:
+            return "left", c0 - cols[0], attach
+        if cols[0] == c1 + 1:
+            return "right", cols[-1] - c1, attach
+    if len(cols) == 1:
