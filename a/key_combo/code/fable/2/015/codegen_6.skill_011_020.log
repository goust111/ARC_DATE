+        for rr in range(br + obj.body_h, br + obj.body_h + obj.stem_len):
+            cells.append((rr, col))
+    else:
+        col = bc + obj.attach_offset
+        for rr in range(br - obj.stem_len, br):
+            cells.append((rr, col))
+    return cells
