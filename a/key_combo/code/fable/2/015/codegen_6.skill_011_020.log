+    placements: list[tuple[int, int] | None] = [None] * len(blueprints)
+
+    def backtrack(k: int) -> bool:
+        if k == len(order):
+            return True
+        idx = order[k]
+        bp = blueprints[idx]
+        bbox_h, bbox_w = _bbox_size(bp)
