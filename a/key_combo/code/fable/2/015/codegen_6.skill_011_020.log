+        r_hi = h - bbox_h
+        for r0 in range(r_lo, r_hi + 1):
+            for c0 in range(0, w - bbox_w + 1):
+                positions.append((r0, c0))
+    else:
+        r_hi = min(step - 1, h - bbox_h)
+        for r0 in range(0, r_hi + 1):
+            for c0 in range(0, w - bbox_w + 1):
