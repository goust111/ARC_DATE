+
+def _gen_attempt() -> np.ndarray | None:
+    count = random.choices(COUNT_CHOICES, weights=COUNT_WEIGHTS, k=1)[0]
+    min_h, min_w = GRID_MIN_BY_COUNT[count]
+    h = random.randint(min_h, GRID_MAX)
+    w = random.randint(min_w, GRID_MAX)
