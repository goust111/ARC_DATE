_GEN_STEM_LENGTHS = range(3, 6)

# Layout choices and retry budget.
_GEN_HORIZONTAL_SIDES = ("left", "right")
_GEN_BODY_FIRST_SIDES = ("left", "above")
_GEN_SIDES = (*_GEN_HORIZONTAL_SIDES, "above", "below")
_GEN_RETRY_LIMIT = 300

