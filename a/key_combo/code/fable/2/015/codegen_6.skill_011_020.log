+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+DIRECTIONS = ("up", "down", "left", "right")
+DIR_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+@dataclass(frozen=True)
+class Blueprint:
+    direction: str
+    body_h: int
+    body_w: int
+    stem_len: int
+    copies: int
+    attach_offset: int
+
+
+@dataclass(frozen=True)
+class Structure:
+    direction: str
+    body_h: int
+    body_w: int
+    stem_len: int
+    copies: int
+    attach_offset: int
+    body_color: int
+    stem_color: int
+    bbox_r: int
+    bbox_c: int
