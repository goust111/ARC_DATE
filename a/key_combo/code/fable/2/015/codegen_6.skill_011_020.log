+            direction=bp.direction,
+            body_h=bp.body_h,
+            body_w=bp.body_w,
+            stem_len=bp.stem_len,
+            copies=bp.copies,
+            attach_offset=bp.attach_offset,
+            body_color=colors[2 * i],
+            stem_color=colors[2 * i + 1],
+            bbox_r=placements[i][0],
+            bbox_c=placements[i][1],
