+def _stem_cells(obj: Structure) -> list[Coord]:
+    br, bc = _body_top_left(obj)
+    cells: list[Coord] = []
+    if obj.direction == "right":
+        row = br + obj.attach_offset
+        for cc in range(bc + obj.body_w, bc + obj.body_w + obj.stem_len):
