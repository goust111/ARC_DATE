+    inp = _render_input(structures, h, w)
+    out = _render_output(structures, h, w)
+    if _validate_structures(inp, out, structures):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
