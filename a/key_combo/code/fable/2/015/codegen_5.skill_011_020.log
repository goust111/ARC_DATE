+    out[0, :] = rect.color
+    out[-1, :] = rect.color
+    out[:, 0] = rect.color
+    out[:, -1] = rect.color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reconstruct the latent rectangle chosen by the yellow marker and output only its hollow frame.
+
+    Input structure:
