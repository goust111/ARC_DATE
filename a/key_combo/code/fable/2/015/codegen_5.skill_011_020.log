        Color.GREY,
        Color.PINK,
        Color.ORANGE,
        Color.TEAL,
        Color.MAROON,
    ]
    weights = [3, 3, 1, 1, 1, 1, 1, 1, 1]
    return int(random.choices(palette, weights=weights, k=1)[0])


