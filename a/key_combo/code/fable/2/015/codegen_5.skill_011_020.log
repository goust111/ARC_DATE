/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:18:        "transform": "replace each marker pixel by the matching pixel from its horizontal/vertical reflection orbit; use the transposed top/left-strip counterpart when that orbit is also hidden",
/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:19:        "grid_shape": "crop to marker bbox"
/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:24:        "catalog:marker_pixels",
