+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+BG = Color.BLACK
+MARKER = Color.YELLOW
+BAR_COLORS = (
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.GREY,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+)
+
+COUNT_RANGE = (2, 5)
+GRID_EXTRA_RANGE = (0, 12)
+MIN_BAR_LEN = 2
+GEN_RETRIES = 400
+
+
+@dataclass(frozen=True)
+class CandidateRect:
+    color: int
+    r0: int
+    r1: int
+    c0: int
+    c1: int
+
+    @property
+    def height(self) -> int:
+        return int(self.r1 - self.r0 + 1)
+
+    @property
+    def width(self) -> int:
+        return int(self.c1 - self.c0 + 1)
