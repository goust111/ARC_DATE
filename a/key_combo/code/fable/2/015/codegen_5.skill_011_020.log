        h = bbox_h(frame["bbox"])
        w = bbox_w(frame["bbox"])
        assert h != w, "frame bbox must have a clear orientation"

        box_mask = np.zeros(g.shape, dtype=bool)
        box_mask[r0 : r1 + 1, c0 : c1 + 1] = True
