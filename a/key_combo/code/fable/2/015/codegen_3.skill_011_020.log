+
+    if len(comps) == 2:
+        return [crop_bbox(g, comp["bbox"]) for comp in comps]
+
+    best_score = None
+    best_pair = None
+    n = len(comps)
+    for mask_bits in range(1, 1 << (n - 1)):
+        left = [0]
+        right = []
+        for idx in range(1, n):
