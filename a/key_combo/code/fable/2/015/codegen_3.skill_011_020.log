+        fg_colors = colors_present(patch, exclude={Color.BLACK})
+        if len(fg_colors) == 2:
+            assert set(fg_colors) == {Color.RED, Color.BLUE}, "map must use red and blue"
+            assert map_patch is None, "expected a single two-color map"
+            map_patch = patch
+        elif len(fg_colors) == 1:
