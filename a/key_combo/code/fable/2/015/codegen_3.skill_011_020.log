+            else:
+                assert cell == Color.BLUE, "map cells must be black, red, or blue"
+                mask = flipped_mask if rotate_blue else brush_mask
+            stamp = np.where(mask, cell, Color.BLACK).astype(int)
+            paste(out, stamp, r * brush_h, c * brush_w)
+    return out
