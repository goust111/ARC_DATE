+        next_coords = stationary.pop(ejected)
+        event["touched_colors"] = sorted(touched)
+        event["group_colors"] = sorted(group)
+        event["ejected_color"] = int(ejected)
+        trace.append(event)
+
+        moving_color = int(ejected)
+        moving_coords = next_coords.copy()
+    else:
