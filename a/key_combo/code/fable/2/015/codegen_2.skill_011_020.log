    return padded


def _paint_device_input(grid: np.ndarray, device: Device) -> None:
    pr, pc = device.pivot
    grid[pr, pc] = PIVOT
    for r, c in _arm_coords(device.pivot, device.direction, device.length):
        grid[r, c] = SOURCE_ARM
    for r, c in _counter_coords(device.pivot, device.counter_height):
