+DEVICE_COUNT_RANGE = (2, 4)
+ARM_LENGTH_RANGE = (2, 6)
+COUNTER_HEIGHT_OPTIONS = {
+    0: (4, 8),
+    1: (5, 9),
+    2: (6, 10),
