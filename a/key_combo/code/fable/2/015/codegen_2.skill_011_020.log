+
+def _validate_straight_bar(comp: dict, *, vertical_only: bool = False) -> set[tuple[int, int]]:
+    coords = _line_coord_set(comp["coords"])
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    if vertical_only:
