        for _ in range(steps):
            r += dr
            c += dc
            assert 0 <= r < out.shape[0] and 0 <= c < out.shape[1], "path must stay in bounds"
            assert not onion_mask[r, c], "path may not overwrite the onion"
            out[r, c] = WHITE
