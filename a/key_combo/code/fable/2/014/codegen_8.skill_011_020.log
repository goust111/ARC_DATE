def _gen_scatter(coords_list: list[np.ndarray], colors: list[int]) -> np.ndarray | None:
    width = random.randint(_GEN_MIN_INPUT_WIDTH, _GEN_MAX_INPUT_WIDTH)
    inp = np.full((_GEN_INPUT_HEIGHT, width), _GEN_BG, dtype=int)
