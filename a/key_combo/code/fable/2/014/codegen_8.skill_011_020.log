+    _paint_patch(out, (r0, cm, rm, c1), patch[:half, half:])
+    _paint_patch(out, (rm, c0, r1, cm), patch[half:, :half])
+    _paint_patch(out, (rm, cm, r1, c1), patch[half:, half:])
