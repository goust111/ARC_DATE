+
+    for spec in placed:
+        r0, c0 = spec["origin"]
+        h = int(spec["h"])
+        w = int(spec["w"])
+        rect = (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))
+        inp[r0:r0 + h, c0:c0 + w] = GREY
