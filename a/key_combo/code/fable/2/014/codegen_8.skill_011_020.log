+        rm = r0 + h // 2
+        cm = c0 + w // 2
+        regions = [
+            (r0, c0, rm, cm),
+            (r0, cm, rm, c1 + 1),
+            (rm, c0, r1 + 1, cm),
+            (rm, cm, r1 + 1, c1 + 1),
+        ]
+        for region, patch in zip(regions, patches):
+            _paint_patch(out, region, patch)
