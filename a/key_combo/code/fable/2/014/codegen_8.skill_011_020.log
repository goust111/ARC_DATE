+def _marker_depth_plan(max_depths: list[int]) -> list[int] | None:
+    plans: list[int] = []
+    for md in max_depths:
+        if md == 0:
+            plans.append(0)
+            continue
+        choices = list(range(md + 1))
+        weights = [2, 4, 2][: md + 1]
+        plans.append(random.choices(choices, weights=weights, k=1)[0])
