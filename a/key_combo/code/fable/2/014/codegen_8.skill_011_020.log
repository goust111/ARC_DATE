+    for spec in specs:
+        h = int(spec["h"])
+        w = int(spec["w"])
+        md = _max_corner_depth(h, w)
+        legends = []
+        depths = depth_plan[offset:offset + 4]
+        offset += 4
+        if not any(depth == 0 for depth in depths):
