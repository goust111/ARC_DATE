    r0, c0, r1, c1 = region
    h = int(r1 - r0)
    w = int(c1 - c0)
    side = int(patch.shape[0])
    assert patch.shape == (side, side)
    assert h > 0 and w > 0
    assert h % side == 0 and w % side == 0

