# Colors and palette.
_BG = Color.ORANGE
_TEAL = Color.TEAL
_RECT_COLORS = [c for c in Color.ALL_COLORS if c not in {_BG, _TEAL}]
# Canvas/object sampling.
_GRID_SIZES = [10, 11]
