+def _max_corner_depth(h: int, w: int) -> int:
+    half_h = int(h) // 2
+    half_w = int(w) // 2
+    depth = 0
+    side = 2
+    while side <= half_h and side <= half_w and half_h % side == 0 and half_w % side == 0 and depth < MAX_DEPTH:
+        depth += 1
+        side *= 2
