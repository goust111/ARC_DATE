+    for spec in ordered:
+        h = int(spec["h"])
+        w = int(spec["w"])
+        sizes = [_render_legend(legend).shape[0] for legend in spec["legends"]]
+        tl, tr, bl, br = map(int, sizes)
+        top = max(tl, tr)
+        bottom = max(bl, br)
+        left = max(tl, bl)
+        right = max(tr, br)
