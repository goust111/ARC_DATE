+def _legend_depth(legend: Legend) -> int:
+    if isinstance(legend, int):
+        return 0
+    return 1 + max(_legend_depth(child) for child in legend)
+
+
+def _render_legend(legend: Legend, side: int | None = None) -> np.ndarray:
