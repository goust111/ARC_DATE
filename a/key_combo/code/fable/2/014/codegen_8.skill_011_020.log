+def _is_power_of_two(n: int) -> bool:
+    n = int(n)
+    return n > 0 and (n & (n - 1)) == 0
+
+
+def _corner_patch_bounds(rect: BBox, corner: str, side: int) -> tuple[int, int, int, int] | None:
