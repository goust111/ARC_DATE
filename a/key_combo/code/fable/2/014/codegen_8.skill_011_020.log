+        out[r0:r1, c0:c1] = int(legend)
+        return
+
+    assert (r1 - r0) % 2 == 0 and (c1 - c0) % 2 == 0
+    rm = r0 + (r1 - r0) // 2
+    cm = c0 + (c1 - c0) // 2
