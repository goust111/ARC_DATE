+MAX_ARC_SIZE = 30
+MAX_DEPTH = 2  # 1 -> 2x2 marker, 2 -> recursively nested 4x4 marker
+GEN_RETRIES = 400
+RECT_COUNT_OPTIONS = [1, 2, 2, 3]
+RECT_SIZE_OPTIONS = [4, 8, 12, 16]
+CANVAS_MIN = 18
+CANVAS_MAX = 30
+PLACEMENT_TRIES = 500
