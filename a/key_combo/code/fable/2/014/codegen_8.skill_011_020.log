+def _grid_is_clear(inp: np.ndarray, out: np.ndarray, specs: list[dict[str, object]]) -> bool:
+    if inp.ndim != 2 or out.ndim != 2:
+        return False
+    if max(inp.shape) > MAX_ARC_SIZE or max(out.shape) > MAX_ARC_SIZE:
+        return False
