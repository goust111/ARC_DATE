+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+FILL_COLORS = [3, 4, 5, 6, 7, 8, 9]
+
+EDGE_ORDER = ("top", "right", "bottom", "left")
+DIM_OPTIONS = [(3, 5), (5, 3), (3, 3), (5, 5)]
+DIM_WEIGHTS = [4, 4, 1, 1]
+MIN_START_GAP = 2
+GEN_RETRIES = 400
