+def _ray_events(strip: np.ndarray, panel_w: int, *, bg: int = BG, obstacle: int = OBSTACLE) -> list[dict]:
+    g = np.asarray(strip, dtype=int)
+    h, w = g.shape
+    source_mask = (g != int(bg)) & (g != int(obstacle))
