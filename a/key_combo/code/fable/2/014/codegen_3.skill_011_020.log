+def _ray_events(strip: np.ndarray, panel_w: int) -> list[dict]:
+    g = np.asarray(strip, dtype=int)
+    h, w = g.shape
+    source_mask = (g != BG) & (g != OBSTACLE)
+    blocker_mask = source_mask | (g == OBSTACLE)
