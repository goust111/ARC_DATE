+def _core_bbox(outer_bbox: tuple[int, int, int, int], depth: int) -> tuple[int, int, int, int]:
+    inset = 1 + 2 * (depth - 1)
+    r0, c0, r1, c1 = outer_bbox
+    return r0 + inset, c0 + inset, r1 - inset, c1 - inset
