+        max_depth = random.choice([1, 2, 2, 3, 3])
+        marker_depths = {max_depth}
+        if random.random() < 0.65:
+            marker_depths.add(0)
+        if max_depth > 1 and random.random() < 0.55:
+            marker_depths.add(random.randint(1, max_depth - 1))
