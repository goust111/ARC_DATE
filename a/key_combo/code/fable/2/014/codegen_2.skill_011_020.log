+neighbors4 = _ARC_UTILS.neighbors4
+
+BG = Color.BLACK
+GREEN = Color.GREEN
+GRAY = Color.GREY
+LEGEND_PALETTE = [c for c in Color.ALL_COLORS if c not in {BG, GREEN}]
+
+WORK_SIZE = 30
+FAMILY_GAP = 2
+MARKER_SEP = 2
+GEN_RETRIES = 400
