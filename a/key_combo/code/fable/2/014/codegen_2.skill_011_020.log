+def _loop_bboxes(outer_bbox: tuple[int, int, int, int], depth: int) -> list[tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = outer_bbox
+    return [(r0 + 2 * i, c0 + 2 * i, r1 - 2 * i, c1 - 2 * i) for i in range(depth)]
