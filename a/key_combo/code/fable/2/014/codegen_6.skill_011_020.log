+    step_choices = [2, 3, 4, 5]
+    random.shuffle(step_choices)
+    step_choices = step_choices[:_MAX_STEP_TRIES]
+    orbit_lengths = [2, 3, 4]
+    random.shuffle(orbit_lengths)
