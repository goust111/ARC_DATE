+                    continue
+                if _pure_rotation(red_src, red_dst):
+                    continue
+                if _pure_axis_mirror(red_src, red_dst):
+                    continue
+
+                occupied = [red_src, red_dst]
+                for blue_steps in orbit_lengths:
+                    blue_orbits = blue_options_by_len[blue_steps]
+                    if not blue_orbits:
