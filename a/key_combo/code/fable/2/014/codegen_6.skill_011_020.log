+        out = np.empty_like(pts)
+        out[:, 0] = int(axis2) - pts[:, 0]
+        out[:, 1] = pts[:, 1] + int(step)
+        return out
+    out = np.empty_like(pts)
+    out[:, 0] = pts[:, 0] + int(step)
+    out[:, 1] = int(axis2) - pts[:, 1]
+    return out
