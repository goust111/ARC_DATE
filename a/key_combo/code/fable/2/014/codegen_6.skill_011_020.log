+def _expanded(cells: set[tuple[int, int]], pad: int = 1) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                out.add((int(r + dr), int(c + dc)))
+    return out
