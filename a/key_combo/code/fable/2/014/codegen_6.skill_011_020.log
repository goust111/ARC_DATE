+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+
+_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+_MAX_GEN_ATTEMPTS = 500
+_SHAPE_ATTEMPTS = 200
+_MAX_RED_OPTIONS = 36
