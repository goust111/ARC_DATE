+def _candidate_from_pair(src: np.ndarray, dst: np.ndarray, orient: str) -> dict[str, int | str] | None:
+    sr0, sc0, sr1, sc1 = _bbox_coords(src)
+    tr0, tc0, tr1, tc1 = _bbox_coords(dst)
+    sh, sw = sr1 - sr0 + 1, sc1 - sc0 + 1
+    th, tw = tr1 - tr0 + 1, tc1 - tc0 + 1
+    if (sh, sw) != (th, tw):
+        return None
+
+    if orient == "h":
+        step = tc0 - sc0
+        if step <= 0:
+            return None
+        axis2_a = sr0 + tr1
+        axis2_b = sr1 + tr0
+        if axis2_a != axis2_b:
+            return None
+        axis2 = int(axis2_a)
+    else:
+        step = tr0 - sr0
+        if step <= 0:
+            return None
+        axis2_a = sc0 + tc1
+        axis2_b = sc1 + tc0
+        if axis2_a != axis2_b:
+            return None
+        axis2 = int(axis2_a)
