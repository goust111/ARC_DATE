+def _orbit_positions(
+    mask: np.ndarray,
+    grid_shape: tuple[int, int],
+    orient: str,
+    axis2: int,
+    step: int,
+    extra_steps: int,
+    *,
+    require_prev_oob: bool,
+    require_next_oob: bool,
+) -> list[list[np.ndarray]]:
+    h, w = map(int, grid_shape)
+    base = np.argwhere(mask).astype(int)
+    mh = int(mask.shape[0])
+    mw = int(mask.shape[1])
+    options: list[list[np.ndarray]] = []
