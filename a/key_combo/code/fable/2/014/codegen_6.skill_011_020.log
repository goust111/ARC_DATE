+        mask = np.zeros((hh, ww), dtype=bool)
+        mask[coords[:, 0], coords[:, 1]] = True
+        if mask.sum() == hh * ww:
+            continue
+        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
+        if orient == "h" and np.array_equal(mask, np.flipud(mask)):
