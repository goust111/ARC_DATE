+            blue_options_by_len: dict[int, list[list[np.ndarray]]] = {}
+            for blue_steps in orbit_lengths:
+                blue_orbits = _orbit_positions(
+                    blue_mask,
+                    grid_shape,
+                    orient,
+                    axis2,
+                    step,
+                    blue_steps,
+                    require_prev_oob=True,
+                    require_next_oob=True,
