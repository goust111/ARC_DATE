+    ars, acs = _cell_bounds_from_n(n, a)
+    brs, bcs = _cell_bounds_from_n(n, b)
+    patch_a = out[ars, acs].copy()
+    patch_b = out[brs, bcs].copy()
+    out[ars, acs] = patch_b
+    out[brs, bcs] = patch_a
+    return out
+
+
+def _build_grid(n, sep, majority, minority, blank_pos, minority_positions):
+    size = n * (n + 1) + 1
+    grid = np.full((size, size), int(sep), dtype=int)
+    for i in range(n):
+        for j in range(n):
+            pos = (i, j)
+            if pos == blank_pos:
+                patch = np.full((n, n), int(_get_bg(majority)), dtype=int)
+            elif pos in minority_positions:
