    info = _enrich_info(_parse_grid(grid))
    out = np.asarray(grid, dtype=int).copy()

    br, bc = info["blank_pos"]
    rs = _cell_region(info["rows"], br)
    cs = _cell_region(info["cols"], bc)
    out[rs, cs] = _thumbnail(info)
