    sep, rows, cols, n = _infer_separator_grid(g)

    cells = {}
    for i in range(n):
        for j in range(n):
            bbox = _cell_bbox(rows, i, j)
            cell = _crop_bbox(g, bbox)
            assert cell.shape == (n, n)
