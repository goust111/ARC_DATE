+            arr[int(r), int(c)] = int(accent)
+    else:
+        if accent is not None and len(active) >= 2 and roll < 0.35:
+            r, c = random.choice(active)
+            arr[int(r), int(c)] = int(accent)
+        elif accent is not None and inactive and roll < 0.7:
+            r, c = random.choice(inactive)
+            arr[int(r), int(c)] = int(accent)
+
+    return arr
+
+
