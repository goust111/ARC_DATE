+    return {
+        "grid": g,
+        "n": int(n),
+        "sep": int(sep),
+        "bg": int(bg),
+        "rows": rows,
+        "cols": cols,
+        "cells": cells,
+        "blank_pos": pat_positions[blank_pat][0],
+        "majority_arr": pat_arrays[majority_pat],
