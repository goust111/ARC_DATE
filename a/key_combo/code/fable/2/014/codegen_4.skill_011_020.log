+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[:, 0] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[:, -1] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[0, :] = True
+    mask[:, 0] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[-1, :] = True
+    mask[:, -1] = True
+    add(mask)
+
+    add((rr + cc) % 2 == 0)
+    add(np.eye(n, dtype=bool) | np.fliplr(np.eye(n, dtype=bool)))
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[n // 2, :] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[:, n // 2] = True
