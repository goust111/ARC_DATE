+    try:
+        info = _enrich_info(_parse_grid(grid))
+        thumb = _thumbnail(info)
+        if np.array_equal(thumb, majority) or np.array_equal(thumb, minority):
+            return None
+        _semantic_checks(grid)
+    except AssertionError:
+        return None
+
+    return grid
