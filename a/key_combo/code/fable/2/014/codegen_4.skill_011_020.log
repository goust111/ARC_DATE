+    mask = np.zeros((n, n), dtype=bool)
+    mask[0, :] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[-1, :] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[:, 0] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
+    mask[:, -1] = True
+    add(mask)
+
+    mask = np.zeros((n, n), dtype=bool)
