+CORNER_OFFSETS = {
+    "nw": (0, 0),
+    "ne": (0, 1),
+    "sw": (1, 0),
+    "se": (1, 1),
+}
+OFFSET_TO_CORNER = {offset: corner for corner, offset in CORNER_OFFSETS.items()}
+OPPOSITE_CORNER = {
+    "nw": "se",
+    "ne": "sw",
+    "sw": "ne",
+    "se": "nw",
+}
+DIRECTION_TO_MARKER = {
+    (1, 1): "nw",
+    (1, -1): "ne",
+    (-1, 1): "sw",
+    (-1, -1): "se",
+}
+DIRECTIONS = tuple(DIRECTION_TO_MARKER)
