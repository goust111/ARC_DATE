+        squares.append(
+            {
+                "id": idx,
+                "tl": (r0, c0),
+                "seed": is_seed,
+                "marker_corner": marker_corner,
+            }
+        )
+
+    assert seed_count == 1, "expected exactly one seed square"
+    return squares
