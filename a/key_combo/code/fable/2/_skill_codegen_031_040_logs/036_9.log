+    if distractors == 0:
+        return None
+    if not _validate_case(grid, chain):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid relay-ray ARC input")

