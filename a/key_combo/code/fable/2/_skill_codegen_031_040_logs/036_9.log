+def _parse_squares(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert int(get_bg(g)) == BLACK
+    assert set(map(int, np.unique(g))).issubset({BLACK, GREY, RED})
