+    marker_corner = seed["marker_corner"]
+    marker = _corner_coord(seed["tl"], marker_corner)
+    emit = _corner_coord(seed["tl"], OPPOSITE_CORNER[marker_corner])
+    direction = (int(emit[0] - marker[0]), int(emit[1] - marker[1]))
