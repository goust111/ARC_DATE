+def _erase_square(grid: np.ndarray, top_left: tuple[int, int]) -> np.ndarray:
+    g = np.asarray(grid, dtype=int).copy()
+    for r, c in _square_cells(top_left):
+        g[r, c] = BLACK
+    return g
