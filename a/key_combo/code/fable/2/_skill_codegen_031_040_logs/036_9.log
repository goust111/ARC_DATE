+def _square_halo(top_left: tuple[int, int], pad: int = 1) -> set[tuple[int, int]]:
+    r0, c0 = map(int, top_left)
+    return {
+        (rr, cc)
+        for rr in range(r0 - pad, r0 + 2 + pad)
+        for cc in range(c0 - pad, c0 + 2 + pad)
+    }
+
