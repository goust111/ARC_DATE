+def _square_cells(top_left: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0 = map(int, top_left)
+    return {
+        (r0, c0),
+        (r0, c0 + 1),
+        (r0 + 1, c0),
+        (r0 + 1, c0 + 1),
+    }
+
