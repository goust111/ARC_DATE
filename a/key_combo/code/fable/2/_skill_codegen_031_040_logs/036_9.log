+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        assert patch.shape == (2, 2)
+        assert np.all(patch != BLACK)
+        colors = set(map(int, patch.ravel()))
+        assert colors.issubset({GREY, RED})
