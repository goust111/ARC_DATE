+def _validate_case(grid: np.ndarray, planned: dict) -> bool:
+    trace = _trace_ray(grid)
+    hits = trace["hits"]
+    shift_r, shift_c = map(int, planned["shift"])
+    planned_relays = [
+        (int(tl[0] + shift_r), int(tl[1] + shift_c))
+        for tl in planned["square_tls"][1:]
