+        exit_corner = OPPOSITE_CORNER[hit_corner]
+        current = _corner_coord(square["tl"], exit_corner)
+        hits.append(
+            {
+                "square_id": int(square["id"]),
+                "tl": tuple(map(int, square["tl"])),
+                "hit_corner": str(hit_corner),
+                "exit_corner": str(exit_corner),
