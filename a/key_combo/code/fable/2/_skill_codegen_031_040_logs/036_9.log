+CHAIN_RELAY_RANGE = (2, 4)
+CHAIN_GAP_RANGE = (1, 3)
+TAIL_LENGTH_RANGE = (2, 5)
+CANVAS_MARGIN_RANGE = (1, 4)
+DISTRACTOR_COUNT_RANGE = (1, 3)
+MAX_GENERATION_ATTEMPTS = 500
