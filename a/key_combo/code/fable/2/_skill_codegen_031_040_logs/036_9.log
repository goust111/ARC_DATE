+
+    top = random.randint(*CANVAS_MARGIN_RANGE)
+    bottom = random.randint(*CANVAS_MARGIN_RANGE)
+    left = random.randint(*CANVAS_MARGIN_RANGE)
+    right = random.randint(*CANVAS_MARGIN_RANGE)
