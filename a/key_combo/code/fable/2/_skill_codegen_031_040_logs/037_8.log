0056:         assert len(components) == 2, "each foreground color must have exactly two objects"
0057: 
0058:         rectangles = [_assert_solid_rectangle(g, int(color), component) for component in components]
0059:         rectangles.sort(key=lambda b: b[0])
0060:         upper, lower = rectangles
