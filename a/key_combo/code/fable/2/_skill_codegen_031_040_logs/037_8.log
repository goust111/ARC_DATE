0070:         r, c = int(start[0] + dr), int(start[1] + dc)
0071:         while (r, c) != end:
0072:             assert int(out[r, c]) == bg, "connector path must pass through background"
0073:             out[r, c] = int(color)
0074:             r += dr
0075:             c += dc
