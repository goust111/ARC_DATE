0062: 
0063:         row_delta = int(end[0] - start[0])
0064:         col_delta = int(end[1] - start[1])
0065:         assert row_delta > 0, "connector must go downward from the upper rectangle"
0066:         assert abs(row_delta) == abs(col_delta), "facing corners must be diagonally aligned"
0067: 
0068:         dr = 1
