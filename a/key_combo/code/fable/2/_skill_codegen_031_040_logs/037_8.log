0938: def randomly_spaced_indices(max_len: int, n_indices: int, border_size: int = 1, padding: int = 1) -> np.ndarray:
0939:     """Generate randomly-spaced indices guaranteed to not be adjacent."""
0940:     max_len = int(max_len)
0941:     n_indices = int(n_indices)
0942:     border_size = int(border_size)
0943:     padding = int(padding)
0944: 
0945:     if border_size > 0:
0946:         return (
0947:             randomly_spaced_indices(max_len - border_size - 2, n_indices, border_size=0, padding=padding) + border_size
0948:         )
0949: 
0950:     indices = [0 for _ in range(max_len)]
0951:     while sum(indices) < n_indices:
0952:         possible = [
0953:             i
0954:             for i in range(max_len)
0955:             if sum(indices[max(0, i - padding) : min(i + 1 + padding, max_len)]) == 0
0956:         ]
0957:         if not possible:
0958:             raise ValueError("randomly_spaced_indices: no feasible placement")
0959:         indices[random.choice(possible)] = 1
0960:     return np.argwhere(indices).flatten()
0961: 
