+    priority = sorted(
+        remaining,
+        key=lambda cand: (
+            int(cand["after_branch"]),
+            int(turn_bucket(cand["turns"]) == "even_positive"),
+            cand["depth"],
+        ),
+        reverse=True,
+    )
+    for cand in priority:
+        if len(selected) >= target_count:
+            break
+        if can_add(cand):
+            selected.append(cand)
+            used_margin |= cand["bulb"]["margin"]
+            used_sockets.add(cand["socket"])
