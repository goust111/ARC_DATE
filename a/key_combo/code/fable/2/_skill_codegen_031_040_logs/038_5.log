+    if not (0.15 <= coverage <= 0.55):
+        return False
+
+    solution_sets, candidates, by_key = _solve_candidate_sets(main, patterns, bg, limit=2)
+    if len(solution_sets) != 1:
+        return False
+
+    actual_ids = set()
+    for kind, r0, c0 in placements:
+        key = (kind, r0, c0)
+        if key not in by_key:
