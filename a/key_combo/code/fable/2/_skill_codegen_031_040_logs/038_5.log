+def _footprint_bits(r0: int, c0: int, width: int) -> int:
+    bits = 0
+    for dr in range(PATTERN_SIZE):
+        for dc in range(PATTERN_SIZE):
+            bits |= _cell_bit(r0 + dr, c0 + dc, width)
+    return bits
