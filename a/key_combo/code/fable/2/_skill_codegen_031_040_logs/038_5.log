    rectangles = candidates[0]
    out = g.copy()
    for r0, c0, r1, c1 in rectangles:
        rows = np.arange(r0, r1 + 1)[:, None]
        cols = np.arange(c0, c1 + 1)[None, :]
        depth = np.minimum(
            np.minimum(rows - r0, r1 - rows),
            np.minimum(cols - c0, c1 - cols),
