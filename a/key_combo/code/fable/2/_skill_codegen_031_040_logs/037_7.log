+    bg = int(get_bg(g))
+    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)
+    assert len(objects) >= 4, "expected several separated rectangles"
+
+    owner = np.full(g.shape, -1, dtype=int)
+    rects: list[dict] = []
+    start_candidates: list[int] = []
