+    r0, c0, r1, c1 = spec.bbox
+    rr0 = max(0, int(r0 - 1))
+    cc0 = max(0, int(c0 - 1))
+    rr1 = min(CANVAS_LIMIT - 1, int(r1 + 1))
+    cc1 = min(CANVAS_LIMIT - 1, int(c1 + 1))
