+
+
+def _sample_next_spec(
+    source: RectSpec,
+    occupied: np.ndarray,
+    blocked: np.ndarray,
+    reserved: np.ndarray,
+    marker_color: int,
+    terminal_signatures: set[tuple[tuple[int, int], int]],
+    terminal: bool,
+) -> tuple[RectSpec, tuple[int, int]] | None:
+    assert source.missing_corner is not None
+    dr, dc = CORNER_TO_DIR[source.missing_corner]
