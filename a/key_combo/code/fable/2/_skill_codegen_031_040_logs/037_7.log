+
+def _first_hit(
+    owner: np.ndarray, start: tuple[int, int], direction: tuple[int, int], self_idx: int
+) -> int:
+    dr, dc = map(int, direction)
+    r, c = int(start[0] + dr), int(start[1] + dc)
+    while in_bounds(owner.shape, r, c):
+        hit = int(owner[r, c])
