+    incoming = [0] * len(rects)
+    pointer_targets: list[int] = []
+    for info in rects:
+        if info["next_idx"] is None:
+            continue
+        nxt = int(info["next_idx"])
+        incoming[nxt] += 1
+        pointer_targets.append(nxt)
+    assert len(pointer_targets) == len(set(pointer_targets)), "chains must stay disjoint"
