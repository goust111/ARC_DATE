+        if placed is None:
+            return None
+        chain, occupied, blocked, reserved = placed
+        terminal_signatures.add(_terminal_signature(chain[-1]))
+        chains.append(chain)
+        if chain_index == 0:
+            expected = _rect_patch(chain[-1])
