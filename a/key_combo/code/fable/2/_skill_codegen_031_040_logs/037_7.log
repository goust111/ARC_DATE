+def _place_chain(
+    occupied: np.ndarray,
+    blocked: np.ndarray,
+    reserved: np.ndarray,
+    marker_color: int,
+    terminal_signatures: set[tuple[tuple[int, int], int]],
+    *,
+    is_start: bool,
+    missing_count: int,
