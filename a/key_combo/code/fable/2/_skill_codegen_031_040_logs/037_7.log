+BG = Color.BLACK
+CANVAS_LIMIT = 30
+MAX_GENERATION_ATTEMPTS = 500
+CHAIN_RETRIES = 160
+PALETTE = tuple(int(color) for color in Color.NOT_BLACK)
+CORNERS = ("tl", "tr", "bl", "br")
+CORNER_TO_DIR = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
+DIR_TO_ARRIVAL = {
+    (-1, -1): "br",
+    (-1, 1): "bl",
+    (1, -1): "tr",
+    (1, 1): "tl",
+}
