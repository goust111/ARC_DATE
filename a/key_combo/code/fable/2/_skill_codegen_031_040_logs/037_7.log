+CORNERS = ("tl", "tr", "bl", "br")
+CORNER_TO_DIR = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
+DIR_TO_ARRIVAL = {
+    (-1, -1): "br",
+    (-1, 1): "bl",
+    (1, -1): "tr",
+    (1, 1): "tl",
+}
