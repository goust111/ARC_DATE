+    assert len(components) >= 3
+
+    frames: list[Frame] = []
+    border_colors: set[int] = set()
+    sizes: set[int] = set()
+
+    for coords in components:
+        bbox = bbox_coords(coords)
+        r0, c0, r1, c1 = bbox
+        size = int(r1 - r0 + 1)
+        assert size == int(c1 - c0 + 1)
+        assert size >= 5
+        patch = crop_bbox(g, bbox)
+        sizes.add(size)
