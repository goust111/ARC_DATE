+
+def _render_instance(
+    bboxes: list[BBox],
+    size: int,
+    bg: int,
+    border_color: int,
+    fill_colors: list[int],
+    port_specs: list[set[tuple[str, int]]],
+) -> np.ndarray:
+    grid = np.full((27, 27), int(bg), dtype=int)
