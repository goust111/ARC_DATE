+                key = (src_port.coord, dst_port.coord, path)
+                if key in seen:
+                    continue
+                seen.add(key)
+                kind = "straight" if len({cell[0] for cell in path}) == 1 or len({cell[1] for cell in path}) == 1 else "L"
