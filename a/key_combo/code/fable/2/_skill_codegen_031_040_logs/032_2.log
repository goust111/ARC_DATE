+        except AssertionError:
+            continue
+        if np.array_equal(produced, cropped_expected):
+            return cropped_inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
