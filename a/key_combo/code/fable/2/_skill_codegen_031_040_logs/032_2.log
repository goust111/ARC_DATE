+        if not candidates:
+            return None
+        src_key, dst_key, path, kind = random.choice(candidates)
+        used_specs[index].add(src_key)
+        used_specs[index + 1].add(dst_key)
+        paths.append(path)
+        path_cells.update(path)
+        kinds.append(kind)
+
+    return used_specs, paths, kinds
