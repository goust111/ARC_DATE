+    assert int(in_scene["wall_left"]) == int(out_scene["wall_left"])
+    assert np.array_equal(inp[:, in_scene["wall_left"] :], out[:, out_scene["wall_left"] :])
+    assert len(in_scene["bands"]) == len(out_scene["bands"])
