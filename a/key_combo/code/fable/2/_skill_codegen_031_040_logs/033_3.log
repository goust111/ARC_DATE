+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+PALETTE = list(range(10))
+WALL_WIDTH = 1
+MAX_GEN_ATTEMPTS = 400
+HEIGHT_RANGE = (4, 6)
+WIDTH_RANGE = (4, 6)
+EXTRA_GAP_RANGE = (0, 2)
