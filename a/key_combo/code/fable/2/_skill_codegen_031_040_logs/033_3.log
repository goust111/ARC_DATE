+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+PALETTE = list(range(10))
+WALL_WIDTH = 1
+MAX_GEN_ATTEMPTS = 400
+HEIGHT_RANGE = (4, 6)
+WIDTH_RANGE = (4, 6)
+EXTRA_GAP_RANGE = (0, 2)
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((int(nr), int(nc)))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _hole_stats(local_mask: np.ndarray) -> tuple[int, int]:
+    h, w = local_mask.shape
+    empty = ~local_mask
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[Coord] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if empty[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if empty[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and empty[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = empty & ~outside
+    return int(holes.sum()), len(_mask_components(holes))
+
+
+def _component_from_cells(grid: np.ndarray, cells: list[Coord], color: int) -> dict:
+    coords = np.asarray(cells, dtype=int)
+    box = _bbox_coords(coords)
+    r0, c0, r1, c1 = box
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
