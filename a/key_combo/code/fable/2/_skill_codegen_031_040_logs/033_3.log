+            if seen[r, c] or wall_mask[r, c] or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while stack:
