+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
