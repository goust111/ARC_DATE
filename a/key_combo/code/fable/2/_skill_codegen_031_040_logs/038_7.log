+
+
+def _is_shifted_consecutive(gaps: list[int]) -> bool:
+    if not gaps:
+        return False
+    inc = all(gaps[i + 1] - gaps[i] == 1 for i in range(len(gaps) - 1)) and gaps[0] > 1
+    dec = all(gaps[i] - gaps[i + 1] == 1 for i in range(len(gaps) - 1)) and gaps[-1] > 1
+    return inc or dec
