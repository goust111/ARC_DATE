            for cc in range(3):
                color = int(LEGEND[rr, cc])
                if color == bg:
                    continue
                grid_r = int(r0) + rr + 1
                grid_c = int(c0) + cc + 1
                if g[grid_r, grid_c] == Color.BLACK:
