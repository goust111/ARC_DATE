    center = mask.shape[0] // 2
    row_sum = int((coords[:, 0] - center).sum())
    col_sum = int((coords[:, 1] - center).sum())
    return (
        0 if row_sum == 0 else (-1 if row_sum < 0 else 1),
        0 if col_sum == 0 else (-1 if col_sum < 0 else 1),
    )


