+def _swap_array(arr: np.ndarray, color_a: int, color_b: int) -> np.ndarray:
+    out = np.array(arr, copy=True)
+    mask_a = out == int(color_a)
+    mask_b = out == int(color_b)
+    out[mask_a] = int(color_b)
+    out[mask_b] = int(color_a)
+    return out
