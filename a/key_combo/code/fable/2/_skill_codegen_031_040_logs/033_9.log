+
+def _occlude_grid(clean: np.ndarray, masks_tl_frame: list[np.ndarray], occluder: int) -> np.ndarray:
+    inp = np.array(clean, copy=True)
+    sep_r, sep_c = clean.shape[0] // 2, clean.shape[1] // 2
+    slices = (
