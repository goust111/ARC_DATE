+
+def _toggle_anti_diagonal(mask: np.ndarray) -> None:
+    h, w = mask.shape
+    offset = random.randint(0, h + w - 2)
+    band = random.randint(1, 2)
+    rr, cc = np.indices(mask.shape)
+    sel = np.abs((rr + cc) - offset) < band
+    mask[sel] = ~mask[sel]
