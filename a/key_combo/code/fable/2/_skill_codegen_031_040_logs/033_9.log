+
+def _toggle_l_shape(mask: np.ndarray) -> None:
+    h, w = mask.shape
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    arm_h = random.randint(2, h)
+    arm_w = random.randint(2, w)
+    thickness = random.randint(1, min(2, h, w))
