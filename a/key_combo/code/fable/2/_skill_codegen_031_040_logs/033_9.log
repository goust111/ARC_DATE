+    tr = np.array(grid[:sep_r, sep_c + 1 :], copy=True)
+    bl = np.array(grid[sep_r + 1 :, :sep_c], copy=True)
+    br = np.array(grid[sep_r + 1 :, sep_c + 1 :], copy=True)
