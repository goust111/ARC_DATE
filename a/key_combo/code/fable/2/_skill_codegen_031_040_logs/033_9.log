+        (slice(0, sep_r), slice(sep_c + 1, clean.shape[1])),
+        (slice(sep_r + 1, clean.shape[0]), slice(0, sep_c)),
+        (slice(sep_r + 1, clean.shape[0]), slice(sep_c + 1, clean.shape[1])),
