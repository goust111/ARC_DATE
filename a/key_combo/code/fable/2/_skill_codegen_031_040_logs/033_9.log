+    if quadrant == 0:
+        local = np.array(canonical_tl, copy=True)
+    elif quadrant == 1:
+        local = np.fliplr(canonical_tl)
+    elif quadrant == 2:
+        local = np.flipud(canonical_tl)
+    elif quadrant == 3:
+        local = np.rot90(canonical_tl, 2)
+    else:
+        raise ValueError("invalid quadrant index")
