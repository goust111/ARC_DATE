+            continue
+        if int(mask[:, 0].sum()) == 0 or int(mask[:, -1].sum()) == 0:
+            continue
+        return mask
+    return None
+
+
+def _build_sprite_crop(
+    h: int,
+    w: int,
+    *,
+    color: int,
+    bg: int,
+    key_r: int,
+    flip_flag: bool,
+    rng: np.random.Generator,
+) -> np.ndarray | None:
+    cols = range(w // 2, w) if bool(flip_flag) else range(0, w // 2)
+    col_choices = [int(c) for c in cols]
+    rng.shuffle(col_choices)
