  21:     assert g.ndim == 2
  22:     h, w = g.shape
  23: 
  24:     bg = get_bg(g)
  25:     non_bg = colors_present(g, exclude={bg})
  26:     assert len(non_bg) == 2
  27: 
  28:     guide_specs = []
  29:     for color in non_bg:
  30:         comps = find_components(g, bg=bg, colors=[color], connectivity=4)
  31:         horizontal_rows = [r for r in range(h) if g[r, 0] == color and g[r, w - 1] == color]
