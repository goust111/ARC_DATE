+    return None
+
+
+def _sample_left_cols(n: int, w: int, rng: np.random.Generator) -> list[int]:
+    min_total = n * w + (n - 1) + 2
+    assert min_total <= 30
+    slack = 30 - min_total
+    used_extra = int(rng.integers(0, slack + 1))
+    parts = [1] + [1] * (n - 1) + [1]
+    for _ in range(used_extra):
+        parts[int(rng.integers(0, len(parts)))] += 1
