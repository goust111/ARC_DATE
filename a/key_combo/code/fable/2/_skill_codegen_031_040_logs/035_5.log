+        global_rows = [tops[i] + i for i in range(n)]
+        if len(set(tops)) < 2:
+            continue
+        if len(set(global_rows)) < n:
+            continue
+        if sorted(range(n), key=lambda i: global_rows[i]) == list(range(n)):
+            continue
