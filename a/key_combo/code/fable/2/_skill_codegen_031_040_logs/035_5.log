+
+def _line(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    (r0, c0), (r1, c1) = a, b
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        return [(int(r0), int(c)) for c in range(int(c0), int(c1) + step, step)]
+    if c0 == c1:
