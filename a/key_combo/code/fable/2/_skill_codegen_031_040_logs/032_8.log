+
+def _make_full_pattern(main_h: int, main_w: int, palette: list[int]) -> np.ndarray:
+    coarse = _make_coarse_pattern(main_h // 2, main_w // 2, palette)
+    full = np.kron(coarse, np.ones((2, 2), dtype=int))
