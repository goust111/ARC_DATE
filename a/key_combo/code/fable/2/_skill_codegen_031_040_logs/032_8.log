+    for comp in comps:
+        if comp is main_comp:
+            continue
+        patch = crop_bbox(g, comp["bbox"])
+        assert patch.shape == (hole_size, hole_size), "all detached components must be square patches"
+        assert not np.any(patch == int(bg)), "patches should be fully filled"
