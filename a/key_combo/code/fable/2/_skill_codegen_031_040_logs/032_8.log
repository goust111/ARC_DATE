+def _place_patches(count: int, side: str) -> tuple[list[tuple[int, int]], int, int]:
+    if side == "right":
+        rows = random.choice([count, max(2, (count + 1) // 2)])
+        cols = (count + rows - 1) // rows
+    else:
+        cols = random.choice([count, max(2, (count + 1) // 2)])
+        rows = (count + cols - 1) // cols
