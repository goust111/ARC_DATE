+        bbox = bbox_coords(coords)
+        r0, c0, r1, c1 = bbox
+        if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+            continue
+        side_h = r1 - r0 + 1
+        side_w = c1 - c0 + 1
+        if side_h != side_w:
+            continue
+        if int(coords.shape[0]) != side_h * side_w:
