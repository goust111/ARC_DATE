+    count = 0
+    count += int(np.array_equal(patch[0, :], target["top"]))
+    count += int(np.array_equal(patch[-1, :], target["bottom"]))
+    count += int(np.array_equal(patch[:, 0], target["left"]))
+    count += int(np.array_equal(patch[:, -1], target["right"]))
+    return count
