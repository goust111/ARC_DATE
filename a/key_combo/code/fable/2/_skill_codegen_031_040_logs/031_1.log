+    expected = np.tile(tile, (repeat_r, repeat_c))
+    diff = np.argwhere(grid != expected)
+    diff_count = int(diff.shape[0])
+    if diff_count == 0:
+        return None
+    if float(diff_count) / float(grid.size) > MAX_ANOMALY_RATIO:
