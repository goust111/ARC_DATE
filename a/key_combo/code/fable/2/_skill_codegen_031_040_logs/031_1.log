+
+def _find_candidates(grid: np.ndarray) -> list[dict]:
+    height, width = grid.shape
+    candidates = []
+    for period_r in _divisors(height):
+        for period_c in _divisors(width):
+            info = _candidate_info(grid, period_r, period_c)
+            if info is not None:
+                candidates.append(info)
