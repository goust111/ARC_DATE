0265: def _make_template(h: int, w: int, bg: int, deco: int) -> np.ndarray:
0266:     out = np.full((h, w), bg, dtype=int)
0267:     area = h * w
0268:     min_deco = max(TEMPLATE_MIN_DECO_CELLS, int(np.ceil(area * TEMPLATE_DECO_MIN_RATIO)))
0269:     max_deco = max(min_deco, int(np.floor(area * TEMPLATE_DECO_MAX_RATIO)))
