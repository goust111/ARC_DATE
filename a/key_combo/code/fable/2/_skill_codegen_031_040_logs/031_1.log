+    if len(valid_pairs) < pair_count:
+        return None
+
+    def search(used: set[int], need: int) -> list[tuple[int, int]] | None:
+        if need == 0:
+            return []
+        options = valid_pairs[:]
+        random.shuffle(options)
+        for a, b in options:
+            if a in used or b in used:
+                continue
+            tail = search(used | {a, b}, need - 1)
+            if tail is not None:
+                return [(a, b)] + tail
+        return None
