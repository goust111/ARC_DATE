+def _render_output(base: np.ndarray, pairs: list[tuple[tuple[int, int], tuple[int, int]]]) -> np.ndarray:
+    out = base.copy()
+    for (r0, c0), (r1, c1) in pairs:
+        if r0 == r1:
+            out[r0, c0 + 1 : c1] = GREEN
+        else:
