+    candidates = _find_candidates(inp)
+    if not candidates:
+        return False
+    if candidates[0]["periods"] != (true_period_r, true_period_c):
+        return False
+    if not np.array_equal(candidates[0]["expected"], base):
+        return False
+    if len(candidates) > 1:
