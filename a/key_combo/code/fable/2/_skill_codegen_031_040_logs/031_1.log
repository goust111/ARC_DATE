+    assert candidates, "no valid periodic explanation found"
+    best = candidates[0]
+    if len(candidates) > 1:
+        runner_up = candidates[1]
+        assert (best["area"], best["diff_count"]) != (
+            runner_up["area"],
+            runner_up["diff_count"],
+        ), "ambiguous periodic explanation"
+    return best
