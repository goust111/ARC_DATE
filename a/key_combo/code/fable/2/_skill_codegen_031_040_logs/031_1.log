0271:     orbits = _sym_orbits(h, w)
0272:     random.shuffle(orbits)
0273:     count = 0
0274:     for orbit in orbits:
0275:         if count >= target:
0276:             break
0277:         if count + len(orbit) > max_deco and count >= min_deco:
0278:             continue
0279:         for r, c in orbit:
0280:             out[r, c] = deco
0281:         count += len(orbit)
0282:     return out
