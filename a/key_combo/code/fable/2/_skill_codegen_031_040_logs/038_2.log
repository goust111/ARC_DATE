+    assert len(upper_coords) > len(keyholes), "need repeated color usage to expose same-color grouping"
+    r0, c0, r1, c1 = bbox_coords(upper_coords)
+    assert (r1 > r0) or (c1 > c0), "upper pattern must not collapse to a singleton"
+
