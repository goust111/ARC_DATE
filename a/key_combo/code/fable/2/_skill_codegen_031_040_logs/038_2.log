+        first = random.choice(base_pool)
+        points.append(first)
+        local_upper.add(first)
+        local_lower.add(_project_pixel(wall_r, key_col, first[0], first[1]))
+
+        while len(points) < count:
+            grow_candidates: set[tuple[int, int]] = set()
+            for r, c in points:
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    cand = (r + dr, c + dc)
