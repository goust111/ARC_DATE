+    out = g.copy()
+    lower_hits: set[tuple[int, int]] = set()
+    grouped: dict[int, list[tuple[int, int]]] = {}
+    for color, key_col in keyholes.items():
+        grouped[color] = []
+        for r0, c0 in np.argwhere(g[:wall_r] == color):
+            r = int(r0)
+            c = int(c0)
