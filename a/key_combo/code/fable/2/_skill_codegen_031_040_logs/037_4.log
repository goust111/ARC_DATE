+            out.append((c0, c1))
+    random.shuffle(out)
+    return out
+
+
+def _non_overlapping(span: tuple[int, int], chosen: list[tuple[int, int]]) -> bool:
+    c0, c1 = span
+    for old0, old1 in chosen:
+        if not (c1 + 1 < old0 or old1 + 1 < c0):
+            return False
+    return True
+
+
+def _choose_spans(shelves: list[dict]) -> list[tuple[int, int]] | None:
