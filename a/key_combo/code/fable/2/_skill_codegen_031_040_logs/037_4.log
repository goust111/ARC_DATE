+def _stop_index_for_span(c0: int, c1: int, shelves: list[dict]) -> int:
+    for idx, shelf in enumerate(shelves):
+        if not _inside_gap(c0, c1, shelf["gap"]):
+            return idx
+    raise AssertionError("the solid bottom shelf must stop every block")
