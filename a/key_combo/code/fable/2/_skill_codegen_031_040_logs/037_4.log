+def _width_only_stop_index(width: int, shelves: list[dict]) -> int:
+    for idx, shelf in enumerate(shelves):
+        gap = shelf["gap"]
+        if gap is None:
+            return idx
+        if width > gap[1] - gap[0] + 1:
