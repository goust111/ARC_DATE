+    if not np.array_equal(_render_alignment(aligns[0], bg=bg), expected):
+        return False
+    out = main(grid)
+    if not np.array_equal(out, expected):
+        return False
+    solved_comps = _find_components(expected, bg=0, connectivity=4)
+    return len(solved_comps) == 1
