+    dr_min = int(a_r0 - b_r1 - (MAX_SIDE - 1))
+    dr_max = int(a_r1 - b_r0 + (MAX_SIDE - 1))
+    dc_min = int(a_c0 - b_c1 - (MAX_SIDE - 1))
+    dc_max = int(a_c1 - b_c0 + (MAX_SIDE - 1))
