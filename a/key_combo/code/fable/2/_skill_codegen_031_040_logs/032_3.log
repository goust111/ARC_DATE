+    grid[int(r_top) : int(r_top) + ht, int(c_top) : int(c_top) + wt] = top_patch
+    grid[int(r_bot) : int(r_bot) + hb2, int(c_bot) : int(c_bot) + wb2] = bot_patch
+    if top_first:
+        return grid
+    grid = np.full((H, W), int(bg), dtype=int)
+    grid[int(r_bot) : int(r_bot) + hb2, int(c_bot) : int(c_bot) + wb2] = bot_patch
+    grid[int(r_top) : int(r_top) + ht, int(c_top) : int(c_top) + wt] = top_patch
+    return grid
