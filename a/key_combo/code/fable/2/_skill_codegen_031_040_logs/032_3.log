+    solved_comps = _find_components(expected, bg=bg, connectivity=4)
+    return len(solved_comps) == 1
+
+
+def _generate_one() -> np.ndarray | None:
+    bg = random.choice(GEN_BG_CHOICES)
+    built = _build_solved_example(bg=bg)
+    if built is None:
+        return None
