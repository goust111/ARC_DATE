    return vals


def grow_mask(h,w,area):
    start=(random.randrange(h), random.randrange(w))
    cells={start}
    front=[]
    def add_front(cell):
        r,c=cell
        for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells:
                front.append((nr,nc))
    add_front(start)
    while len(cells)<area and front:
