+
+def _bbox_coords(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    coords = list(coords)
+    rs = [int(r) for r, _c in coords]
+    cs = [int(c) for _r, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
