+    left_map, palette = colored
+    right_rows = [int(r) for r in range(h) if bool(left_mask[int(r), w - 1])]
+    axis_rows = random.sample(right_rows, random.randint(1, min(3, len(right_rows))))
+    axis_map: dict[tuple[int, int], int] = {}
+    for r in axis_rows:
