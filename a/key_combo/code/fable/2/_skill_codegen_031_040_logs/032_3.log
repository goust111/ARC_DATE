+        else:
+            color_map[coord] = int(random.choice(palette))
+    return color_map, palette
+
+
+def _build_solved_example(
+    *,
+    bg: int,
+) -> tuple[dict[tuple[int, int], int], dict[tuple[int, int], int], np.ndarray] | None:
+    left_mask = _gen_left_half()
