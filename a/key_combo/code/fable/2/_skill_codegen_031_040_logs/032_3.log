from collections import Counter, deque

GREEN=3

def bbox_coords(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    return min(rs), min(cs), max(rs), max(cs)

def is_conn(cells):
    cells=set(cells)
    if not cells: return False
    q=deque([next(iter(cells))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
            nb=(r+dr,c+dc)
            if nb in cells and nb not in seen:
                seen.add(nb); q.append(nb)
    return seen==cells

def sym(map_):
    if not map_: return False
    cols=[c for _,c in map_]
    x2=min(cols)+max(cols)
    for (r,c),col in map_.items():
        if map_.get((r,x2-c))"'!=col:
            return False
    return True

