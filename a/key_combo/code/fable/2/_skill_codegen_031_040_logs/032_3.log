+def _add_placeholders(
+    frag_a: dict[tuple[int, int], int],
+    frag_b: dict[tuple[int, int], int],
+    expected: np.ndarray,
+) -> tuple[dict[tuple[int, int], int], dict[tuple[int, int], int]] | None:
+    width = int(expected.shape[1])
+    axis_col = int(width // 2)
