+    return mask
+
+
+def _gen_left_half() -> np.ndarray | None:
+    for _ in range(100):
+        h = random.randint(5, 9)
+        w = random.randint(3, 6)
+        area_lo = max(h + 1, w + 2, (h * w + 2) // 3)
+        area_hi = min(h * w - 1, int(h * w * 0.78))
