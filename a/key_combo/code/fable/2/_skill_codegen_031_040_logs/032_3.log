+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+PLACEHOLDER = 3
+MAX_SIDE = 30
+MAX_GEN_TRIES = 400
+GEN_BG_CHOICES = [0, 1, 2, 4, 5, 6, 7, 8, 9]
+GEN_COLOR_POOL = [1, 2, 4, 5, 6, 7, 8, 9]
