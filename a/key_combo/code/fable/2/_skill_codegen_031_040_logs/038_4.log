+# --------------- generator ---------------
+
+GRID_MIN = 22
+GRID_MAX = 30
+CAGE_COUNT_CHOICES = (2, 3)
+BOX_SIDE_MIN = 6
+BOX_SIDE_MAX = 9
+OPEN_MARKERS = (3, 4)
+CLOSED_MARKERS = (2, 4)
+SCENE_ATTEMPTS = 350
+CAGE_ATTEMPTS = 160
+MARKER_ATTEMPTS = 240
