+    for c in range(c0, c1 + 1):
+        grid[r0, c] = frame_color
+        grid[r1, c] = frame_color
+    for r in range(r0, r1 + 1):
+        grid[r, c0] = frame_color
+        grid[r, c1] = frame_color
