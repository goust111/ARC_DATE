+    gr, gc = gap
+    if side == "top":
+        axial = r - gr
+        lateral = abs(c - gc)
+    elif side == "bottom":
+        axial = gr - r
+        lateral = abs(c - gc)
+    elif side == "left":
+        axial = c - gc
+        lateral = abs(r - gr)
+    else:
