    return np.array_equal(solved, out)


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    H = int(rng.integers(*GRID_HEIGHT_RANGE))
    W = int(rng.integers(*GRID_WIDTH_RANGE))

    made = _gen_sprite(rng)
    if made is None:
