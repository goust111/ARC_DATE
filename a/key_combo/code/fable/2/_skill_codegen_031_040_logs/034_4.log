+def _rect_conflict(a: BBox, b: BBox, padding: int = 1) -> bool:
+    return not (
+        a[2] + padding < b[0]
+        or b[2] + padding < a[0]
+        or a[3] + padding < b[1]
+        or b[3] + padding < a[1]
+    )
+
+
+def _place_patches(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    patches: dict[str, Grid],
+) -> dict[str, tuple[int, int]] | None:
