+def _corrupt_large(
+    rng: np.random.Generator,
+    patch: Grid,
+    bg: int,
+    k: int,
+    source_patch: Grid,
+    forbidden_cell: tuple[int, int],
+) -> tuple[Grid, tuple[int, int], tuple[int, int], int]:
