+
+
+def _semantic_ok(
+    inp: Grid,
+    expected: Grid,
+    *,
+    small_bbox: BBox,
+    large_bbox: BBox,
+    small_bad_cell: tuple[int, int],
+    large_bad_cell: tuple[int, int],
+    k: int,
+) -> bool:
