+
+def _compose(shape: tuple[int, int], bg: int, patches: dict[str, Grid], positions: dict[str, tuple[int, int]]) -> Grid:
+    canvas = np.full(shape, int(bg), dtype=int)
+    for role, patch in patches.items():
