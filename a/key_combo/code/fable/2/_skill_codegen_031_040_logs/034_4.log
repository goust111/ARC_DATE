    ar, ac = anchor
    target_mask = sprite != BACKGROUND_COLOR
    target_mask[ar, ac] = False
    patch = inp[tr0:tr0 + sprite.shape[0], tc0:tc0 + sprite.shape[1]]
    patch[target_mask] = BACKGROUND_COLOR
    patch[ar, ac] = MARKER_COLOR
