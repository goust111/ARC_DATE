+
+
+def _gen_corridor_clear(a: Coord, b: Coord, positions: list[Coord]) -> bool:
+    rect, axis = _gen_corridor(a, b)
+    if axis is None:
+        return False
+    if rect is None:
+        return True
+    for pos in positions:
