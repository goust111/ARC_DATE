+    if bg is None:
+        bg = get_bg(g)
+    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
+    if monochromatic:
+        out: list[Block] = []
+        for color in colors:
+            for coords in components_mask(g == color, connectivity=connectivity):
+                if int(coords.shape[0]) < int(min_area):
+                    continue
