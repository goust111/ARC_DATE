    sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)
    sprite[mask] = OBJECT_COLOR

    out = _render_output((H, W), marker_cells, sprite, target_r, target_c)

    offsets = _gen_valid_offsets(mask, (H, W), target_r, target_c, marker_cells)
    if not offsets:
