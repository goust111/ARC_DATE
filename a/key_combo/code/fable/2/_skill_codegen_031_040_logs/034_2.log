+    return steps
+
+
+def _gen_candidate_positions(rows: int, cols: int, occupied: list[Coord]) -> list[Coord]:
+    candidates = []
+    occupied_set = set(occupied)
+    for r in _gen_position_range(rows):
+        for c in _gen_position_range(cols):
+            pos = (r, c)
+            if pos in occupied_set:
