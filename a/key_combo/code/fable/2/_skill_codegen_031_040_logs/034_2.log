+def _gen_corridor(a: Coord, b: Coord) -> tuple[BBox | None, str | None]:
+    axis = _gen_axis(a, b)
+    if axis == "h":
+        r = a[0]
+        c0 = min(a[1], b[1]) + BLOCK_SIZE
+        c1 = max(a[1], b[1]) - 1
+        if c0 <= c1:
+            return (r, c0, r + BLOCK_SIZE - 1, c1), axis
+        return None, axis
+    if axis == "v":
+        c = a[1]
+        r0 = min(a[0], b[0]) + BLOCK_SIZE
+        r1 = max(a[0], b[0]) - 1
+        if r0 <= r1:
+            return (r0, c, r1, c + BLOCK_SIZE - 1), axis
+        return None, axis
