+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    scenario = SCENARIOS[_GEN_CALL_COUNT % len(SCENARIOS)]
+    _GEN_CALL_COUNT += 1
+    rng = random.Random()
