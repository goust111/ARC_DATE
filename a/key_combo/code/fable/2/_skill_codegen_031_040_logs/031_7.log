+        for (c0, c1), rows in rows_by_span.items():
+            if len(rows) < 2:
+                continue
+            for i, r0 in enumerate(rows):
+                for r1 in rows[i + 1 :]:
+                    box = (int(r0), int(c0), int(r1), int(c1))
+                    info = _valid_frame_candidate(g, bg, int(color), box)
+                    if info is None:
