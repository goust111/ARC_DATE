    return True


def _gen_render_input(masks: np.ndarray) -> np.ndarray:
    """Render the four panel masks into the 10x10 solver input grid."""
    inp = np.zeros(_INPUT_SHAPE, dtype=int)
    for panel_i, (r0, c0) in enumerate(_PANEL_ORIGINS):
