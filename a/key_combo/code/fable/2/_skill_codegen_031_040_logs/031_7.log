+
+    expected_fg = border.copy()
+    expected_fg[r0 - seed_len : r0, seed_c] = True
+    if not np.array_equal(grid != bg, expected_fg):
+        return None
+
+    palette = [int(grid[r0 - d, seed_c]) for d in range(1, seed_len + 1)]
+    return seed_c, palette
+
+
