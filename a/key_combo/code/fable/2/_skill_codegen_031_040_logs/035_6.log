    return grid[r, c] == Color.BLACK and grid[r, _gen_mirror_col(c)] == Color.BLACK


def _gen_is_isolated_from_grey(grid, cells):
    cell_set = set(cells)
    for r, c in cells:
        for nr, nc in _gen_neighbors4(r, c):
            if (nr, nc) not in cell_set and grid[nr, nc] == Color.GREY:
                return False
    return True


