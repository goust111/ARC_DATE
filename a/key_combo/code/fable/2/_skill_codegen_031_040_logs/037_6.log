+BG = 0
+COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GRID_MIN = 22
+GRID_MAX = 30
+PAD = 2
+MAX_ATTEMPTS = 400
+BASE_PLUS = np.array(
