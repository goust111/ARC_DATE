MAX_INTERIOR_FILL = 0.56
MIN_INTERIOR_CELLS = 3

# Angular placement.
ANGLE_PERTURB_RANGE = (-0.3, 0.3)
MIN_RADIUS_PAD = 1
MAX_RADIUS_PAD = 1
ANGLE_EPS = 1e-6

# Connector constraints and retry budgets.
MAX_TWO_TURN_TRIES = 20
CONNECTOR_LENGTH_RANGE = (2, 24)
