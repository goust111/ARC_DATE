+    min_w = max(GRID_MIN, max_w + 2)
+    if min_h > GRID_MAX or min_w > GRID_MAX:
+        return None
+    gh = random.randint(min_h, GRID_MAX)
+    gw = random.randint(min_w, GRID_MAX)
