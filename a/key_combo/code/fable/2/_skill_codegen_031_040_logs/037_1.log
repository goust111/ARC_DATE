+
+
+def _sprite_meta_for_pair(chamber_bbox_a: BBox, chamber_bbox_b: BBox) -> tuple[dict, dict] | None:
+    ch_h = chamber_bbox_a[2] - chamber_bbox_a[0] + 1
+    ch_w = chamber_bbox_a[3] - chamber_bbox_a[1] + 1
