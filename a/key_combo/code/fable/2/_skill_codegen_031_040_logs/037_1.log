+    return out
+
+
+def _shortcut_swap_keep_colors(grid: np.ndarray, floor_color: int, chambers: list[dict], pairs: list[tuple[int, int, int]]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
