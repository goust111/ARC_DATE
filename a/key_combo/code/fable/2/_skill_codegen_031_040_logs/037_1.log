+def _paint_sprite(out: np.ndarray, patch: np.ndarray, top_left: Coord, color: int) -> None:
+    r0, c0 = map(int, top_left)
+    rows, cols = np.nonzero(patch)
+    out[r0 + rows, c0 + cols] = int(color)
