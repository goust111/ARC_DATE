+            for rr, cc in frontier:
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                        candidates.add((nr, nc))
+            if not candidates:
+                break
+            chosen = random.choice(list(candidates))
+            mask[chosen] = True
+            frontier.add(chosen)
+        if mask.all():
+            continue
+        if not mask[0, :].any() or not mask[-1, :].any():
+            continue
+        if not mask[:, 0].any() or not mask[:, -1].any():
+            continue
