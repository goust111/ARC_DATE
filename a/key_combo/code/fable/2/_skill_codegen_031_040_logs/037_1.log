+    for rows, cols in LAYOUTS:
+        for ch_h, ch_w in CHAMBER_SIZES:
+            for gap_r in GAPS:
+                for gap_c in GAPS:
+                    for margin in MARGINS:
+                        height = 2 * margin + rows * ch_h + (rows - 1) * gap_r
+                        width = 2 * margin + cols * ch_w + (cols - 1) * gap_c
+                        if max(height, width) <= 30:
