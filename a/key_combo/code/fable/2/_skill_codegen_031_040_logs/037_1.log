+                    "bbox": (r0, c0, r1, c1),
+                    "floor_color": color,
+                    "sprite_color": sprite_color,
+                    "sprite_coords": sprite_coords_global,
+                    "sprite_bbox": (r0 + sr0, c0 + sc0, r0 + sr1, c0 + sc1),
+                    "sprite_patch": sprite_patch,
