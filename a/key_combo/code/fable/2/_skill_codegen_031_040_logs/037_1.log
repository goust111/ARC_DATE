+
+LAYOUTS = [(2, 2), (2, 3), (3, 2)]
+CHAMBER_SIZES = [(5, 5), (5, 6), (6, 5), (6, 6)]
+GAPS = [3, 4]
+MARGINS = [2, 3]
+SPRITE_BOXES = [(2, 2), (2, 3), (3, 2), (3, 3)]
