+
+def _paint_pipe_cell(grid: np.ndarray, r: int, c: int) -> None:
+    assert 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]
+    assert int(grid[r, c]) in {BLACK, GREY}
