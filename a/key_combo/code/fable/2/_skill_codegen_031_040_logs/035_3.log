            color = int(g[r_top, c])
            if color == bg or int(g[r_bottom, c]) != color:
                continue
            if has_horizontal_peer(r_top, c, color) or has_horizontal_peer(r_bottom, c, color):
                continue
            c0, c1 = col_spans[c]
            out[r0:r1, c0:c1] = color

    return out

