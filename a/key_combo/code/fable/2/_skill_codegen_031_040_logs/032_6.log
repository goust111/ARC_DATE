+    grid = np.full((rows * block_h + rows + 1, cols * block_w + cols + 1), int(sep), dtype=int)
+
+    for i in range(rows):
+        for j in range(cols):
+            block = _rolled(template, i, j)
+            if (i, j) == damaged_block:
+                block = block.copy()
+                block[np.roll(damage_mask, shift=(int(i), int(j)), axis=(0, 1))] = int(bg)
