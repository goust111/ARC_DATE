+                expected[np.roll(damage_mask, shift=(int(i), int(j)), axis=(0, 1))] = int(bg)
+            observed = grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+            assert np.array_equal(observed, expected)
+            pristine_blocks.append(_rolled(template, i, j))
