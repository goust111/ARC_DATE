+
+        return template
+
+    return None
+
+
+def _compose_input(
+    template: np.ndarray,
+    sep: int,
+    bg: int,
+    rows: int,
+    cols: int,
+    damaged_block: tuple[int, int],
+    damage_mask: np.ndarray,
