+    top_lo = 0 if a == 0 else rows[a - 1] + 1
+    top_hi = rows[a] - k - 1
+    bottom_lo = rows[b] + k + 1
+    bottom_hi = height - 1 if b == len(rows) - 1 else rows[b + 1] - 1
