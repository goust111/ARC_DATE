+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+SPRITE_COLOR_POOL = [3, 4, 5, 6, 7, 8, 9]
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    """Minimal ARC-style connected components in canonical (r, c) coordinates."""
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    if connectivity == 4:
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        steps = [
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr, dc) != (0, 0)
+        ]
+
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in steps:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _corner_origin(shape: tuple[int, int], size: int, corner: str) -> Coord:
+    h, w = shape
+    if corner == "tl":
+        return 0, 0
+    if corner == "tr":
+        return 0, w - size
+    if corner == "bl":
+        return h - size, 0
+    if corner == "br":
+        return h - size, w - size
+    raise ValueError(f"unknown corner: {corner}")
+
+
+def _sprite_offsets(sprite_mask: np.ndarray) -> list[Coord]:
+    size = sprite_mask.shape[0]
+    k = size // 2
+    coords = np.argwhere(sprite_mask)
+    return [(int(r - k), int(c - k)) for r, c in coords]
+
+
+def _stamp(
+    out: np.ndarray,
+    center: Coord,
+    offsets: list[Coord],
+    color: int,
+    occupied: np.ndarray | None = None,
+) -> None:
+    h, w = out.shape
+    cells: list[Coord] = []
+    for dr, dc in offsets:
+        r = center[0] + dr
+        c = center[1] + dc
+        assert 0 <= r < h and 0 <= c < w, "stamp leaves the grid"
+        cells.append((r, c))
+    if occupied is not None:
+        for r, c in cells:
+            assert not occupied[r, c], "stamp footprints overlap"
+    for r, c in cells:
+        out[r, c] = int(color)
+        if occupied is not None:
+            occupied[r, c] = True
+
+
+def _mask_from_corner(sprite_mask: np.ndarray, shape: tuple[int, int], corner: str) -> np.ndarray:
+    size = sprite_mask.shape[0]
+    r0, c0 = _corner_origin(shape, size, corner)
+    mask = np.zeros(shape, dtype=bool)
+    coords = np.argwhere(sprite_mask)
+    mask[r0 + coords[:, 0], c0 + coords[:, 1]] = True
+    return mask
