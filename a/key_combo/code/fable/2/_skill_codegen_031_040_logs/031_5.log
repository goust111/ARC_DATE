+def _extract_sprite(g: np.ndarray) -> tuple[int, np.ndarray, str]:
+    colors = sorted(set(map(int, g.ravel())) - {BG, RED, BLUE})
+    assert len(colors) == 1, "expected one sprite color besides red and blue"
+    color = colors[0]
