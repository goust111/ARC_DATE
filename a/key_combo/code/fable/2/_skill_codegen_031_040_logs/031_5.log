+    sprite[local[:, 0], local[:, 1]] = color
+    return color, sprite, matching[0]
+
+
+def _solve_from_parts(
+    g: np.ndarray,
+    red_pairs: dict[int, tuple[int, int]],
+    blue_pairs: dict[int, tuple[int, int]],
+    sprite_color: int,
