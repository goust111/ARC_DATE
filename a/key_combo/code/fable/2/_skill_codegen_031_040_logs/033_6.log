+GEN_RETRIES = 400
+HEIGHT_RANGE = (8, 11)
+SOURCE_COUNT_OPTIONS = (2, 3)
+CORRIDOR_GAP_RANGE = (1, 3)
+EXTRA_WIDTH_CAP = 6
