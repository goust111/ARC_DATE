+    cells, _colors, _moves = _simulate_drop(clear_mask, start_col, RED)
+    return cells
+
+
+def _valid_sample(grid: np.ndarray, path_specs: list[dict]) -> bool:
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
