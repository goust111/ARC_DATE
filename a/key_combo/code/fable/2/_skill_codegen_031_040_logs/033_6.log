+    v_total = random.randint(1, min(2, length - 2))
+    d_total = length - v_total
+    assert d_total >= 2
+    d1, d2 = _positive_parts(d_total, 2)
+    return ["D"] * d1 + ["V"] * v_total + ["D"] * d2
