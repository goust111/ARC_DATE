+
+def _required_width(sequence: list[str], stop_early: bool) -> int:
+    diag_steps = int(sequence.count("D"))
+    needs_blocker_column = stop_early or ("V" in sequence)
+    return diag_steps + (2 if needs_blocker_column else 1)
