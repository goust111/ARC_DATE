+def _trace_planned_path(
+    height: int, width: int, start_col: int, sequence: list[str], stop_early: bool
+) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    r, c = 0, int(start_col)
+    cells = [(r, c)]
+    blockers: set[tuple[int, int]] = set()
