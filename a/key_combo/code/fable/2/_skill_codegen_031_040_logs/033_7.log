+def _place_sprites(
+    rng: random.Random,
+    grid: np.ndarray,
+    panel_bbox: tuple[int, int, int, int],
+    class_specs: list[dict],
+) -> tuple[bool, list[dict]]:
+    gh, gw = grid.shape
