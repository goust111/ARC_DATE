+        mh, mw = mask.shape
+        positions = []
+        for r0 in range(1, gh - mh):
+            for c0 in range(1, gw - mw):
+                rs, cs = _expanded_slice(r0, c0, mh, mw, gh, gw)
+                if occupied[rs, cs].any():
