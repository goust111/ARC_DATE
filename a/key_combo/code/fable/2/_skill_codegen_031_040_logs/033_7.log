+    r0, c0, r1, c1 = bbox
+    if r0 < 0 or c0 < 0 or r1 < r0 or c1 < c0:
+        return None
+    if r1 - r0 + 1 < 5 or c1 - c0 + 1 < 5:
+        return None
+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(region[0, :] == color):
+        return None
+    if not np.all(region[-1, :] == color):
+        return None
+    if not np.all(region[:, 0] == color):
+        return None
+    if not np.all(region[:, -1] == color):
+        return None
+    if not np.any(region != color):
+        return None
