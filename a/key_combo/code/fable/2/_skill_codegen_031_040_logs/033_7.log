+    for corner, (r, c) in {
+        "tl": (0, 0),
+        "tr": (0, w - 1),
+        "bl": (h - 1, 0),
+        "br": (h - 1, w - 1),
+    }.items():
+        color = int(grid[r, c])
+        if color == bg:
+            continue
+        bbox = _corner_panel_bbox(grid, corner, color)
+        if bbox is not None:
