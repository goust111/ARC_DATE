+def _stamp_panel(grid: np.ndarray, panel: np.ndarray, corner: str) -> tuple[int, int, int, int]:
+    gh, gw = grid.shape
+    ph, pw = panel.shape
+    if corner == "tl":
+        r0, c0 = 0, 0
+    elif corner == "tr":
+        r0, c0 = 0, gw - pw
+    elif corner == "bl":
+        r0, c0 = gh - ph, 0
+    else:
+        r0, c0 = gh - ph, gw - pw
+    grid[r0 : r0 + ph, c0 : c0 + pw] = panel
+    return r0, c0, r0 + ph - 1, c0 + pw - 1
