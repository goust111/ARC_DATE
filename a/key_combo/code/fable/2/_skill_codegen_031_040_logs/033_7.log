+
+
+def _extract_gray_sprites(
+    grid: np.ndarray, panel_bbox: tuple[int, int, int, int], bg: int
+) -> tuple[int, list[dict]]:
+    work = grid.copy()
+    r0, c0, r1, c1 = panel_bbox
+    work[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
+    colors = sorted(set(map(int, work.ravel())) - {int(bg)})
