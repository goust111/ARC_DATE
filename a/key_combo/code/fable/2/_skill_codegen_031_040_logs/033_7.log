+        if rotation == 0:
+            rr, cc = r, c
+            h2, w2 = h, w
+        elif rotation == 1:
+            rr, cc = w - 1 - c, r
+            h2, w2 = w, h
+        elif rotation == 2:
+            rr, cc = h - 1 - r, w - 1 - c
+            h2, w2 = h, w
+        else:
