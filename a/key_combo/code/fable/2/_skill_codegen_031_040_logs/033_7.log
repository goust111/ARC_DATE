+def _expanded_slice(top: int, left: int, h: int, w: int, grid_h: int, grid_w: int) -> tuple[slice, slice]:
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(grid_h, top + h + 1)
+    c1 = min(grid_w, left + w + 1)
+    return slice(r0, r1), slice(c0, c1)
