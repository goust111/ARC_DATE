+def _layout_options(n: int) -> list[tuple[int, int]]:
+    options = []
+    for rows in range(1, n + 1):
+        cols = (n + rows - 1) // rows
+        if rows * cols >= n:
+            options.append((rows, cols))
+    return [rc for rc in options if max(rc) <= 4]
