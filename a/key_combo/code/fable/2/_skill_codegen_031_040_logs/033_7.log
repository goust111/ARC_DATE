+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+GREY = 5
+PALETTE = tuple(range(10))
+LEGEND_SLOT = 5
+PANEL_GAP = 1
+PANEL_BORDER = 1
+GRID_MIN = 23
+GRID_MAX = 30
+GEN_RETRIES = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _normalize_coords(coords: np.ndarray | list[tuple[int, int]]) -> tuple[tuple[tuple[int, int], ...], tuple[int, int]]:
+    pts = np.asarray(coords, dtype=int)
+    assert pts.ndim == 2 and pts.shape[1] == 2 and pts.shape[0] > 0
+    r0, c0, r1, c1 = bbox_coords(pts)
+    shifted = pts - np.array([r0, c0], dtype=int)
+    key = tuple(sorted((int(r), int(c)) for r, c in shifted))
+    return key, (int(r1 - r0 + 1), int(c1 - c0 + 1))
+
+
+def _transform_key(
+    key: tuple[tuple[int, int], ...], dims: tuple[int, int], rotation: int, flip: bool
+) -> tuple[tuple[tuple[int, int], ...], tuple[int, int]]:
+    h, w = dims
+    out: list[tuple[int, int]] = []
+    for r, c in key:
+        if rotation == 0:
+            rr, cc = r, c
+            h2, w2 = h, w
+        elif rotation == 1:
+            rr, cc = w - 1 - c, r
+            h2, w2 = w, h
+        elif rotation == 2:
+            rr, cc = h - 1 - r, w - 1 - c
+            h2, w2 = h, w
+        else:
+            rr, cc = c, h - 1 - r
+            h2, w2 = w, h
+        if flip:
+            cc = w2 - 1 - cc
+        out.append((int(rr), int(cc)))
+    return _normalize_coords(out)
+
