+def _panel_size(rows: int, cols: int) -> tuple[int, int]:
+    height = PANEL_BORDER * 2 + rows * LEGEND_SLOT + (rows - 1) * PANEL_GAP
+    width = PANEL_BORDER * 2 + cols * LEGEND_SLOT + (cols - 1) * PANEL_GAP
