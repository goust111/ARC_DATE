+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+GREY = 5
+PALETTE = tuple(range(10))
+LEGEND_SLOT = 5
+PANEL_GAP = 1
+PANEL_BORDER = 1
+GRID_MIN = 23
+GRID_MAX = 30
+GEN_RETRIES = 400
