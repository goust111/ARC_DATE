+    min_h = max(GRID_MIN, panel_h + 8)
+    min_w = max(GRID_MIN, panel_w + 8)
+    if min_h > GRID_MAX or min_w > GRID_MAX:
+        return None
+    grid_h = rng.randint(min_h, GRID_MAX)
+    grid_w = rng.randint(min_w, GRID_MAX)
