+
+def _detect_panel(grid: np.ndarray, bg: int) -> tuple[tuple[int, int, int, int], int]:
+    h, w = grid.shape
+    candidates: list[tuple[tuple[int, int, int, int], int]] = []
+    for corner, (r, c) in {
+        "tl": (0, 0),
+        "tr": (0, w - 1),
+        "bl": (h - 1, 0),
+        "br": (h - 1, w - 1),
+    }.items():
+        color = int(grid[r, c])
+        if color == bg:
