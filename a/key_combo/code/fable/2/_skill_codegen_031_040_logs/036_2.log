            candidates.sort()
            for start in range(len(candidates) - extra_width + 1):
                chunk = candidates[start : start + extra_width]
                if chunk[-1] - chunk[0] + 1 == extra_width:

 succeeded in 122ms:
                    pits |= set(chunk)
