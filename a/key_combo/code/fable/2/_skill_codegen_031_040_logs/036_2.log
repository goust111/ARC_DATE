  "type": "transform_in_place",
  "src": "one thick monochrome foreground object on a dominant background, with one-pixel boundary tabs and missing edge pixels",
  "transform": "for each foreground tab, remove the opposite edge pixel on the same row or column; for each missing edge pixel, add a foreground tab just outside the opposite edge, ignoring gaps immediately beside a tab source"
}
</annotation>
</reference_puzzle>

