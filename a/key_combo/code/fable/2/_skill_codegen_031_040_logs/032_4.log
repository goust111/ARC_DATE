        _loc = first_free_location(grid, arrowhead, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
        if _loc is None:
            raise ValueError("no placement")
        r, c = _loc
        paste(grid, arrowhead, r, c, transparent=Color.BLACK, clip=True)
 
    return grid



    

