+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Dir = tuple[int, int]
+
+BLACK = 0
+NOT_BLACK = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+STEP = 4
+MIN_SIDE = 18
+MAX_SIDE = 28
+MIN_REFLECTIONS = 3
+MAX_REFLECTIONS = 5
+MAX_GENERATE_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors8(r: int, c: int) -> Iterable[Coord]:
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox_coords(coords: list[Coord]) -> tuple[int, int, int, int]:
+    rs = [r for r, _c in coords]
+    cs = [c for _r, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _components_mask(mask: np.ndarray, connectivity: int = 8) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[Coord]] = []
+    if connectivity == 4:
+        nbrs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
