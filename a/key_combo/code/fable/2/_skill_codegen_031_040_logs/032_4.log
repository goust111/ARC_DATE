+
+def _line_candidates(size: int) -> list[int]:
+    vals = list(range(2, size - 2, STEP))
+    return [v for v in vals if 1 <= v <= size - 2]
+
+
+def _perpendiculars(direction: Dir) -> list[Dir]:
