+    step = 1 if r1 > r0 else -1
+    return [(r, c0) for r in range(r0 + step, r1 + step, step)]
+
+
+def _exit_cells(start: Coord, direction: Dir, shape: tuple[int, int]) -> list[Coord]:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    out: list[Coord] = []
+    while True:
