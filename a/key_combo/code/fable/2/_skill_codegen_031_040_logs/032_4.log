+    raise AssertionError("every mirror component must be one contiguous diagonal segment")
+
+
+def _marker_and_mirrors(grid: np.ndarray) -> tuple[Coord, dict[Coord, tuple[int, str]]]:
+    h, w = grid.shape
+    boundary: list[Coord] = []
+    for r in range(h):
+        for c in range(w):
