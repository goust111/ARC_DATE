+import numpy as np
+
+
+Coord = tuple[int, int]
+Dir = tuple[int, int]
+
+BLACK = 0
+NOT_BLACK = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+STEP = 4
+MIN_SIDE = 18
+MAX_SIDE = 28
