+
+    sums = {r + c for r, c in pts}
+    if len(sums) == 1:
+        sigma = next(iter(sums))
+        r0, _c0, r1, _c1 = _bbox_coords(list(pts))
+        expected = {(r, sigma - r) for r in range(r0, r1 + 1)}
+        if expected == pts:
+            return "/"
