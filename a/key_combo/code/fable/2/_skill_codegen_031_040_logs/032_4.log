+    return dirs[0]
+
+
+def _reflect(direction: Dir, orient: str) -> Dir:
+    dr, dc = direction
+    if orient == "\\":
+        return dc, dr
+    if orient == "/":
+        return -dc, -dr
+    raise ValueError("invalid mirror orientation")
+
+
+def _turn_to_orient(in_dir: Dir, out_dir: Dir) -> str:
