+        "shape": (h, w),
+        "marker": marker,
+        "start_dir": start_dir,
+        "reflections": reflections,
+    }
+
+
+def _segment_midpoint_cell(start: Coord, end: Coord) -> Coord | None:
+    cells = _segment_cells(start, end)
+    bg_cells = cells[:-1]
+    if len(bg_cells) < 3:
+        return None
+    return bg_cells[len(bg_cells) // 2]
+
