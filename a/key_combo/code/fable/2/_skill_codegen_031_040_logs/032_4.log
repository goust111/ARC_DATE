+
+    deltas = {r - c for r, c in pts}
+    if len(deltas) == 1:
+        delta = next(iter(deltas))
+        r0, _c0, r1, _c1 = _bbox_coords(list(pts))
+        expected = {(r, r - delta) for r in range(r0, r1 + 1)}
+        if expected == pts:
