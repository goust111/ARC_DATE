+        return None
+
+    edge = random.choice(["top", "bottom", "left", "right"])
+    if edge == "top":
+        marker = (0, random.choice(cols))
+        start_dir = (1, 0)
+    elif edge == "bottom":
+        marker = (h - 1, random.choice(cols))
+        start_dir = (-1, 0)
+    elif edge == "left":
+        marker = (random.choice(rows), 0)
+        start_dir = (0, 1)
+    else:
+        marker = (random.choice(rows), w - 1)
+        start_dir = (0, -1)
