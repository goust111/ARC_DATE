import random, numpy as np
DIRS=[(-1,-1),(-1,1),(1,-1),(1,1)]


def solve_count(grid,palette,limit=20):
    n=grid.shape[0]
    p=list(palette)
    idx={c:i for i,c in enumerate(p)}
    full=(1<<n)-1
    g=grid.copy()
    row_used=[0]*n; col_used=[0]*n; blanks=[]
    for r in range(n):
        for c in range(n):
            v=int(g[r,c])
            if v==0: blanks.append((r,c)); continue
            b=1<<idx[v]
            if row_used[r]&b or col_used[c]&b: return 0,None
            row_used[r]|=b; col_used[c]|=b
    count=0; sol=None
    def rec():
        nonlocal count,sol
        if count>=limit: return
        best=None; bestmask=0; bestbits=99
        for r,c in blanks:
            if g[r,c]"'!=0: continue
            mask=full & ~row_used[r] & ~col_used[c]
            bits=mask.bit_count()
            if bits==0: return
            if bits<bestbits:
                best=(r,c); bestmask=mask; bestbits=bits
                if bits==1: break
        if best is None:
            count+=1
            if sol is None: sol=g.copy()
            return
        r,c=best
        for i,v in enumerate(p):
            if bestmask>>i & 1:
                b=1<<i
                g[r,c]=v; row_used[r]|=b; col_used[c]|=b
                rec()
                row_used[r]''^=b; col_used[c]''^=b; g[r,c]=0
                if count>=limit: return
    rec()
    return count,sol


def first_blank(blank_mask, cell, d):
    n=blank_mask.shape[0]
    r,c=cell; dr,dc=d
    rr,cc=r,c
    while 0 <= rr-dr < n and 0 <= cc-dc < n:
        rr-=dr; cc-=dc
    while 0 <= rr < n and 0 <= cc < n:
        if blank_mask[rr,cc]:
            return (rr,cc)==(r,c)
        rr+=dr; cc+=dc
    return False


def entry_cell(cell,d,n):
    r,c=cell; dr,dc=d
    rr,cc=r,c
    while 0 <= rr-dr < n and 0 <= cc-dc < n:
        rr-=dr; cc-=dc
    return rr,cc


def bbox_from_tip(tip,d):
    tr,tc=tip; dr,dc=d
    r0 = tr-2 if dr==1 else tr+1
    c0 = tc-2 if dc==1 else tc+1
    return (r0,c0,r0+1,c0+1)


def gen_one():
    n=6 if random.random()<0.65 else 4
    colors=random.sample([1,2,3,4,5,6,7,8,9], n+1)
    bg=colors[0]; palette=colors[1:]
    rp=list(range(n)); random.shuffle(rp)
    cp=list(range(n)); random.shuffle(cp)
    colperm=palette[:]; random.shuffle(colperm)
    sol=np.array([[colperm[(rp[r]+cp[c])%n] for c in range(n)] for r in range(n)],dtype=int)
    row_pairs=[]; seen=set()
    for i in range(n):
        j=next(j for j in range(n) if (rp[j]-rp[i])%n==n//2)
        a,b=sorted((i,j))
        if (a,b) not in seen: seen.add((a,b)); row_pairs.append((a,b))
    col_pairs=[]; seen=set()
    for i in range(n):
        j=next(j for j in range(n) if (cp[j]-cp[i])%n==n//2)
        a,b=sorted((i,j))
        if (a,b) not in seen: seen.add((a,b)); col_pairs.append((a,b))
    random.shuffle(row_pairs); random.shuffle(col_pairs)
    k=1 if n==4 else (2 if random.random()<0.7 else 1)
    blocks=[]
    blank=np.zeros((n,n),dtype=bool)
    for rr,cc in zip(row_pairs[:k], col_pairs[:k]):
        r1,r2=rr; c1,c2=cc
        cells=[(r1,c1),(r1,c2),(r2,c1),(r2,c2)]
        blocks.append(cells)
        for rc in cells: blank[rc]=1
    partial=sol.copy(); partial[blank]=0
    cnt,_=solve_count(partial,palette,limit=8)
    if cnt<=1: return False,'"'not ambiguous'
    arrows=[]
    used_dirs=set()
    for cells in blocks:
        cand=[]
        for cell in cells:
            for d in DIRS:
                if first_blank(blank,cell,d):
                    score=(d not in used_dirs, random.random())
                    cand.append((score,cell,d))
        if not cand: return False,'no cand'
        cand.sort(reverse=True)
        _,cell,d=cand[0]
        used_dirs.add(d)
        arrows.append((cell,d))
    clued=partial.copy()
    for cell,d in arrows:
        clued[cell]=sol[cell]
    cnt2,sol2=solve_count(clued,palette,limit=3)
    if cnt2"'!=1 or not np.array_equal(sol2,sol): return False,'"'not unique after clues'
    for i,(cell,d) in enumerate(arrows):
        tmp=partial.copy()
        for j,(cell2,d2) in enumerate(arrows):
            if i==j: continue
            tmp[cell2]=sol[cell2]
        cnt3,_=solve_count(tmp,palette,limit=3)
        if cnt3<=1: return False,'clue redundant'
    top,bottom,left,right=[random.randint(4,6) for _ in range(4)]
    H=n+top+bottom; W=n+left+right
    if H>30 or W>30: return False,'size'
    occ=np.zeros((H,W),dtype=bool)
    occ[top:top+n,left:left+n]=True
    placements=[]
    for cell,d in arrows:
        er,ec=entry_cell(cell,d,n)
        tip0=(top+er-d[0], left+ec-d[1])
        gaps=list(range(0,8))
        random.shuffle(gaps)
        placed=False
        for gap in gaps:
            tip=(tip0[0]-gap*d[0], tip0[1]-gap*d[1])
            r0,c0,r1,c1=bbox_from_tip(tip,d)
            if r0<0 or c0<0 or r1>=H or c1>=W: continue
            rr0=max(0,r0-1); cc0=max(0,c0-1); rr1=min(H-1,r1+1); cc1=min(W-1,c1+1)
            if occ[rr0:rr1+1, cc0:cc1+1].any():
                continue
            # ensure ray reaches table through bg only before entry
            rr,cc=tip
            ok=False
            while 0<=rr+d[0]<H and 0<=cc+d[1]<W:
                rr+=d[0]; cc+=d[1]
                if top<=rr<top+n and left<=cc<left+n:
                    ok=True
                    break
                if occ[rr,cc]:
                    ok=False
                    break
            if not ok: continue
            occ[r0:r1+1,c0:c1+1]=True
            placements.append((cell,d,tip,(r0,c0,r1,c1)))
            placed=True
            break
        if not placed:
            return False,'place fail'
    # render and emulate
    g=np.full((H,W),bg,dtype=int)
    g[top:top+n,left:left+n]=partial
    for cell,d,tip,bbox in placements:
        r0,c0,r1,c1=bbox
        patch=np.full((2,2), sol[cell], dtype=int)
        mr=1 if d[0]==1 else 0
        mc=1 if d[1]==1 else 0
        patch[mr,mc]=bg
        g[r0:r1+1,c0:c1+1]=np.where(patch==bg,g[r0:r1+1,c0:c1+1],patch)
    # emulate arrows
    table=g[top:top+n,left:left+n].copy()
    for cell,d,tip,bbox in placements:
        rr,cc=tip
        while 0<=rr+d[0]<H and 0<=cc+d[1]<W:
            rr+=d[0]; cc+=d[1]
            if top<=rr<top+n and left<=cc<left+n:
                lr,lc=rr-top,cc-left
                if table[lr,lc]==0:
                    table[lr,lc]=sol[cell]
                    break
    if np.count_nonzero(table==0)==0:
        return False,'no blanks left'
    cnt4,sol4=solve_count(table,palette,limit=3)
    if cnt4"'!=1 or not np.array_equal(sol4,sol):
        return False,'"'after arrow solve bad'
    # palette visibility
    vis=set(table[table"'!=0].tolist()) | {sol[cell] for cell,d,tip,bbox in placements}
    if len(vis)!=n: return False,'"'palette missing'
    return True,(n,k,H,W,[d for _,d,_,_ in placements])

ok=0
for i in range(500):
    good,info=gen_one()
    if good:
        ok+=1
    else:
        print('fail',info)
        break
print('ok',ok)
