+def _spaced_positions(low: int, high: int, count: int) -> list[int] | None:
+    if count <= 0:
+        return []
+    for _ in range(100):
+        picks = sorted(random.sample(range(low, high + 1), count))
+        if all(b - a >= 2 for a, b in zip(picks, picks[1:], strict=False)):
+            return picks
+    return None
