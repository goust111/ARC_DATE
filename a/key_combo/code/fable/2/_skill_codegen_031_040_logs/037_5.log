        gap_cols = [left_gap if (i % 2 == 0) == start_left else right_gap for i in range(n_walls)]
        for row, gap_col in zip(rows, gap_cols, strict=True):
            panel[row, :] = WALL
            panel[row, gap_col] = BG
        start = (0, gap_cols[0])
        end = (height - 1, gap_cols[-1])

