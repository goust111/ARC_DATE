            grid[:, :w0] = maze_panel
            grid[:, w0] = DIVIDER
            grid[:, w0 + 1 :] = strip_panel
            return grid, (slice(None), slice(w0 + 1, None))
        grid[:, :w1] = strip_panel
        grid[:, w1] = DIVIDER
