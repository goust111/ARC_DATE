+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+BG = 0
+DIVIDER = 5
+WALL = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+MAX_GENERATION_ATTEMPTS = 400
+_GEN_COUNTER = 0
