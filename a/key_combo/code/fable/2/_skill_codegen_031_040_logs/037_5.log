+
+def _extract_maze_info(panel: np.ndarray, bg: int) -> dict:
+    colors = sorted(int(v) for v in np.unique(panel) if int(v) != bg)
+    endpoint_color = None
+    endpoints: list[Coord] = []
+    for color in colors:
+        coords = [tuple(map(int, rc)) for rc in np.argwhere(panel == color)]
+        if len(coords) != 2:
+            continue
