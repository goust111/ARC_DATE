+        platform_row = next(track["platform_row"] for track in tracks if track["group"] == group)
+        c0, c1 = spans[group]
+        for c in range(c0, c1 + 1):
+            assert grid[platform_row, c] == BLACK
+            grid[platform_row, c] = GREY
