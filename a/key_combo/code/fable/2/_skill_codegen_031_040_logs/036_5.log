+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+
+TRACK_COUNT = 4
+ZONE_WIDTH = 6
+ZONE_GAP = 1
+BASE_CONTENT_WIDTH = TRACK_COUNT * ZONE_WIDTH + (TRACK_COUNT - 1) * ZONE_GAP
+MAX_GEN_ATTEMPTS = 400
