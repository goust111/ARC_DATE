+
+
+def _platform_spans(tracks: list[dict]) -> dict[str, tuple[int, int]]:
+    spans: dict[str, tuple[int, int]] = {}
+    for group in ("A", "B"):
+        cols = [track["final"][1] for track in tracks if track["group"] == group]
+        spans[group] = (min(cols) - 1, max(cols) + 1)
+    return spans
