+    out = inp.copy()
+    for track in tracks:
+        sr, sc = track["start"]
+        out[sr, sc] = BLACK
+    for track in tracks:
+        fr, fc = track["final"]
+        out[fr, fc] = int(track["final_color"])
+    return out
