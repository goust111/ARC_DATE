+    for sand in sorted(sands, key=lambda item: item["pos"]):
+        rr, cc, color = _settle_sand(sand["pos"], sand["color"], g.shape, platform_cells, slope_lookup)
+        assert (rr, cc) not in occupied, "settled grains must not overlap"
+        occupied.add((rr, cc))
+        out[rr, cc] = int(color)
