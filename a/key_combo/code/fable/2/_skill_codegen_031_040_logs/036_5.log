    comps = components_mask(base == int(hole_col), connectivity=4)
    for coords in comps:
        pts_list = [(int(r), int(c)) for r, c in coords]
        if len(pts_list) <= 3:
            preserve.update(pts_list)
            continue
        for r, c in pts_list:
            nb = 0
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                rr = int(r + dr)
                cc = int(c + dc)
                if 0 <= rr < H and 0 <= cc < W and int(base[rr, cc]) == int(hole_col):
                    nb += 1
            if nb <= 1:
