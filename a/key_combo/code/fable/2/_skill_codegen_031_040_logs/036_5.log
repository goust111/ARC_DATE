+    shape: tuple[int, int],
+    platform_cells: set[tuple[int, int]],
+    slope_lookup: dict[tuple[int, int], dict],
+) -> tuple[int, int, int]:
+    h, _w = map(int, shape)
+    r, c = map(int, start)
+    color = int(start_color)
+
+    for _ in range(h * max(shape) * 2):
