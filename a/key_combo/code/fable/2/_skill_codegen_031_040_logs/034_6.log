  40: def main(grid: np.ndarray) -> np.ndarray:
  41:     """
  42:     Slide each foreground object horizontally to the edge indicated by whether its shape has an open notch.
  43: 
  44:     Input structure:
  45:     - Yellow is the background and there is one blue foreground color.
  46:     - The foreground is split into separated 4-connected objects.
  47:     - Each object keeps its row span and shape in the output.
  48: 
  49:     Rule:
  50:     - If an object's bbox border contains a background gap flanked by object pixels along that same border, slide it to the right edge and recolor it green.
  51:     - Otherwise slide the object to the left edge and recolor it red.
  52:     - Start from a blank background canvas; no moved objects overlap.
  53: 
  54:     Key insight:
  55:     - The target side is encoded by the object's shape, not by its original position: open notches go right, while closed or solid shapes go left.
  56:     """
  57:     g = np.asarray(grid, dtype=int)
  58:     bg = int(get_bg(g))
  59:     fg_colors = colors_present(g, exclude={bg})
  60:     assert len(fg_colors) == 1, "expected exactly one foreground color"
  61:     fg = int(fg_colors[0])
  62: 
