+def _turn_count(path: list[tuple[int, int]]) -> int:
+    if len(path) < 3:
+        return 0
+    dirs = [(b[0] - a[0], b[1] - a[1]) for a, b in zip(path, path[1:])]
+    return sum(dirs[i] != dirs[i - 1] for i in range(1, len(dirs)))
