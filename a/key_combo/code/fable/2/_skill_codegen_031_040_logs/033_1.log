+    start: tuple[int, int],
+    direction: tuple[int, int],
+    bg: int,
+) -> bool:
+    r, c = add(start, direction)
+    while in_bounds(grid.shape, r, c):
+        if obstacle_mask[r, c]:
+            return True
+        if int(grid[r, c]) != int(bg):
+            return False
+        r, c = add((r, c), direction)
