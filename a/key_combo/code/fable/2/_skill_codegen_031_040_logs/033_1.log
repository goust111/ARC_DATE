+    parsed = _parse_instance(np.asarray(grid, dtype=int))
+    out = parsed["grid"].copy()
+    bg = int(parsed["bg"])
+
+    for r, c in parsed["ribbon_order"]:
+        out[r, c] = bg
+    for (r, c), color in zip(parsed["track"], parsed["colors"]):
+        out[r, c] = int(color)
+    return out
