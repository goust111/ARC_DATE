+    except AssertionError:
+        return None
+
+    track = parsed["track"]
+    if len(track) != length:
+        return None
+    if len(set(track)) != len(track):
+        return None
+    if _turn_count(track) < min_turns:
+        return None
+
+    face_lengths = parsed["face_lengths"]
+    if len(set(face_lengths.values())) != 2:
+        return None
