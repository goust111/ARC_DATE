+def _trace_track(
+    obstacle_mask: np.ndarray,
+    head: tuple[int, int],
+    approach: tuple[int, int],
+    length: int,
+) -> tuple[list[tuple[int, int]], tuple[int, int], tuple[int, int], dict[tuple[int, int], int]]:
+    assert length >= 1
+    track = [head]
+    current = head
+    while len(track) < length:
+        nxt = add(current, approach)
