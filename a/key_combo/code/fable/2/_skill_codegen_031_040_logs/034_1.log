+        exp_r, exp_c = positions[expected]
+        act_r, act_c = positions[actual]
+        vector = (int(act_r - exp_r), int(act_c - exp_c))
+        vectors.append(vector)
+        total_r += vector[0]
+        total_c += vector[1]
