def _gen_neighbors4(r, c, h, w):
    for dr, dc in NEIGHBORS4:
        rr, cc = r + dr, c + dc
        if 0 <= rr < h and 0 <= cc < w:
            yield rr, cc


def _gen_has_green_neighbor(grid, r, c):
    h, w = grid.shape
    for rr, cc in _gen_neighbors4(r, c, h, w):
        if grid[rr, cc] == Color.GREEN:
            return True
    return False


