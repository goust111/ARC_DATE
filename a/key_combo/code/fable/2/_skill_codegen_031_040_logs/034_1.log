    size_options = []
    if num_multi == 1:
        for a in range(BLOB_AREA_MIN, BLOB_AREA_MAX + 1):
            total_green = a + num_single
            if min_green <= total_green <= max_green:
                size_options.append((a,))
    else:
        for a in range(BLOB_AREA_MIN, BLOB_AREA_MAX + 1):
            for b in range(BLOB_AREA_MIN, BLOB_AREA_MAX + 1):
                total_green = a + b + num_single
