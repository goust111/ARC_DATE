+def _candidate_tiles(grid: np.ndarray) -> list[dict]:
+    rows, cols = grid.shape
+    candidates: list[dict] = []
+    for tile_h in _divisors(rows):
+        for tile_w in _divisors(cols):
+            tile = np.empty((tile_h, tile_w), dtype=int)
+            total_matches = 0
+            min_margin = None
+            valid = True
