+    for i, item in enumerate(walls):
+        color = int(item["color"])
+        c = 1 + 2 * i
+        if int(item["dir"]) == UP:
+            grid[h - 2, c] = GREY
+            grid[h - 1, c] = color
+            legend_mask[h - 2, c] = True
+            legend_mask[h - 1, c] = True
+        else:
+            grid[h - 2, c] = color
+            grid[h - 1, c] = GREY
+            legend_mask[h - 2, c] = True
+            legend_mask[h - 1, c] = True
+
+    return grid, wall, legend_mask, legend_map
+
+
+def _candidate_rows(
+    h: int,
+    wall: np.ndarray,
+    legend_map: dict[int, int],
+) -> list[dict[str, object]]:
