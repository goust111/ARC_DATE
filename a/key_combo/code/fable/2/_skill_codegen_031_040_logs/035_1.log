+    pick = int(rng.choice(len(valid), p=weights))
+    rows, expected, _area = valid[pick]
+    return rows, expected
+
+
+def _attempt_generate(rng: np.random.Generator) -> np.ndarray | None:
+    wall_count = int(rng.integers(2, 5))
