+def _wall_grid(grid: np.ndarray, legend_map: dict[int, int], legend_mask: np.ndarray) -> np.ndarray:
+    wall = np.zeros_like(grid)
+    for color in legend_map:
+        mask = (grid == int(color)) & (~legend_mask)
+        wall[mask] = int(color)
+    return wall
