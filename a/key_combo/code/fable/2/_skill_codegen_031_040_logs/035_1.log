+            grid[h - 1, c] = color
+            legend_mask[h - 2, c] = True
+            legend_mask[h - 1, c] = True
+        else:
+            grid[h - 2, c] = color
+            grid[h - 1, c] = GREY
+            legend_mask[h - 2, c] = True
+            legend_mask[h - 1, c] = True
+
+    return grid, wall, legend_mask, legend_map
+
