+
+    for item in walls:
+        color = int(item["color"])
+        c = int(item["col"])
+        r0 = int(item["r0"])
+        r1 = int(item["r1"])
+        grid[r0 : r1 + 1, c] = color
+        wall[r0 : r1 + 1, c] = color
