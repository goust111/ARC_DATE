+def _trace_particle(start_r: int, wall: np.ndarray, legend_map: dict[int, int]) -> tuple[np.ndarray, list[int]]:
+    h, w = wall.shape
+    r = int(start_r)
+    c = 0
+    vertical = 0
+    visited = np.zeros((h, w), dtype=bool)
+    visited[r, c] = True
+    hits: list[int] = []
+
+    for _ in range(h * w * 4):
+        if vertical == 0:
+            if c == w - 1:
+                return visited, hits
+            color = int(wall[r, c + 1])
+            if color == 0:
+                c += 1
+                visited[r, c] = True
+                continue
+            vertical = int(legend_map[color])
+            hits.append(color)
