+import itertools
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PARTICLE = 8
+GREY = 5
+WALL_COLORS = (1, 2, 3, 4, 6, 7, 9)
+UP = -1
+DOWN = 1
+GEN_RETRIES = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.reshape(-1))).most_common(1)[0][0])
