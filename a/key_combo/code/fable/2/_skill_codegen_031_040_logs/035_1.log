+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        rng = np.random.default_rng()
+        grid = _attempt_generate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid legend-detour ARC input")

