+
+
+def _combo_output(
+    base: np.ndarray,
+    wall: np.ndarray,
+    legend_mask: np.ndarray,
+    rows: list[int],
+    legend_map: dict[int, int],
+) -> np.ndarray | None:
+    try:
+        return _render_output(base, wall, legend_mask, rows, legend_map)
+    except AssertionError:
+        return None
+
+
+def _choose_start_rows(
+    rng: np.random.Generator,
+    base: np.ndarray,
+    wall: np.ndarray,
