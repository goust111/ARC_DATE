+    r0, c0, r1, c1 = bbox
+    template = grid[r0 : r1 + 1, c0 : c1 + 1]
+    depths = _row_depths(template, base, side)
+    channels: list[dict] = []
+    rr = 0
+    while rr < len(depths):
+        depth = int(depths[rr])
+        if depth == 0:
+            rr += 1
+            continue
+        start = rr
+        while rr < len(depths) and int(depths[rr]) == depth:
+            rr += 1
+        end = rr - 1
