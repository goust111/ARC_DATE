+CHANNEL_HEIGHT_MIN = 2
+CHANNEL_HEIGHT_MAX = 4
+TEMPLATE_WIDTH_MIN = 8
+TEMPLATE_WIDTH_MAX = 12
+DEPTH_MIN = 2
+DEPTH_MAX = 6
+SOLID_BAND_MIN = 1
+SOLID_BAND_MAX = 2
+OUTER_MARGIN_MIN = 1
+OUTER_MARGIN_MAX = 4
+APPROACH_MARGIN_MIN = 7
