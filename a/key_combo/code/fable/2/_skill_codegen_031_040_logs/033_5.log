SEGMENT_STEPS_MIN, SEGMENT_STEPS_MAX = 1, 7

# Direction and color sampling.
DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
PATH_COLORS = [1, 2, 4, 5, 6, 7, 9]
PALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 6, 7

# Generation retry budget.
