+DIR_TO_VEC = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_TO_SIDE = {
+    "up": "top",
+    "right": "right",
+    "down": "bottom",
+    "left": "left",
+}
+BASE_GLYPHS = {
+    "up": np.array([[1, 1, 1], [0, 1, 0], [0, 1, 0]], dtype=int),
+    "right": np.array([[0, 0, 1], [1, 1, 1], [0, 0, 1]], dtype=int),
+    "down": np.array([[0, 1, 0], [0, 1, 0], [1, 1, 1]], dtype=int),
+    "left": np.array([[1, 0, 0], [1, 1, 1], [1, 0, 0]], dtype=int),
+}
