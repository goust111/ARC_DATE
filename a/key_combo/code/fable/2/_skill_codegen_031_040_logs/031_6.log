    from arc_utils import is_contiguous
    mask = (sprite != 0)
    if not mask.any():
        sprite[cr, cc] = color
        mask = (sprite != 0)
    if not is_contiguous(mask, background=0, connectivity=8):
        return None

    if not np.any(sprite[0, :]) or not np.any(sprite[-1, :]):
