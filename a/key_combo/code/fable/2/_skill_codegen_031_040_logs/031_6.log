    dy = dx * random.choice([-1, 1])
    rot = random.choice(TRIANGLE_ROTATIONS)
    a_r = random.randint(radius_r + 1, size - 1 - radius_r - 1)
    a_c = random.randint(radius_c + 1, size - 1 - radius_c - 1)

