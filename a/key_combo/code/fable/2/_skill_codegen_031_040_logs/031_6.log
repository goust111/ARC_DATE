+        return None
+    return inp if _semantic_ok(inp, commands, boundary_indices) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        candidate = _gen_attempt()
+        if candidate is not None:
