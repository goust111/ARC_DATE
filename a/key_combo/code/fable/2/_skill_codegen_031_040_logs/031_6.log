+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    if _arc_crop_bbox is not None:
+        return np.asarray(_arc_crop_bbox(grid, box), dtype=grid.dtype)
+    r0, c0, r1, c1 = map(int, box)
