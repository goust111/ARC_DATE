+            margins[side] += 1
+
+    for side in expandable_h:
+        margins[side] += random.randint(*EXTRA_MARGIN_RANGE)
+
+    expandable_v = [side for side in ("top", "bottom") if side not in boundary_sides]
+    for side in expandable_v:
+        margins[side] += random.randint(*EXTRA_MARGIN_RANGE)
