+    covered: set[int] = set()
+    missing_specs: list[dict] = []
+    pair_score = 0
+
+    for idx, rec in enumerate(records):
+        centers = orbit_centers(rec["center_r2"], rec["center_c2"], axis_r2, axis_c2)
+        if len(centers) != 4:
+            return None
+        if centers in seen_orbits:
+            continue
+        seen_orbits.add(centers)
+
