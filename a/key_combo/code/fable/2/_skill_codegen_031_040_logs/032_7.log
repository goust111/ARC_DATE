+    rows = sorted({int(center_r2), int(2 * axis_r2 - center_r2)})
+    cols = sorted({int(center_c2), int(2 * axis_c2 - center_c2)})
+    return tuple(sorted((int(r2), int(c2)) for r2 in rows for c2 in cols))
