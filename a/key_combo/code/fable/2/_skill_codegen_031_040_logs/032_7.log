+
+
+def _choose_unique_shape(used: set[tuple[tuple[int, int], bytes]]) -> np.ndarray | None:
+    for _ in range(MAX_SHAPE_TRIES):
+        h = random.randint(*SHAPE_H_RANGE)
+        w = random.randint(*SHAPE_W_RANGE)
