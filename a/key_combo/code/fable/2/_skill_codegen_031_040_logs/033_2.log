+PATH_LEN_MIN = 9
+PATH_LEN_MAX = 20
+REGION_MIN = 9
+REGION_MAX = 12
+GRID_MIN = 18
+GRID_MAX = 30
+SPIRAL_PATH_PADDING = 2
+PATH_BUILD_ATTEMPTS = 80
+MAX_GENERATION_ATTEMPTS = 500
+SEQUENCE_COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
