+
+def _connected_mask(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    seen = set()
+    stack = [tuple(map(int, pts[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and (rr, cc) not in seen:
+                stack.append((rr, cc))
+    return len(seen) == int(mask.sum())
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int = BG,
+    colors: tuple[int, ...] | list[int] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if colors is None:
+        palette = sorted(int(v) for v in np.unique(g) if int(v) != int(bg))
+    else:
+        palette = [int(v) for v in colors if int(v) != int(bg)]
+
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for color in palette:
+        locs = np.argwhere(g == color)
+        for start_r, start_c in locs:
+            sr = int(start_r)
+            sc = int(start_c)
+            if seen[sr, sc]:
+                continue
+            stack = [(sr, sc)]
+            coords: list[tuple[int, int]] = []
+            seen[sr, sc] = True
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and int(g[rr, cc]) == color:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            arr = np.array(coords, dtype=int)
+            out.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
