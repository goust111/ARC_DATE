+        used_openings: set[tuple[int, int]] = set()
+        steps = 0
+        row0 = int(component["bbox"][0])
+        row1 = int(component["bbox"][2])
+        fit_openings = tuple(_opening_index_for_span(wall, row0, row1) for wall in walls)
