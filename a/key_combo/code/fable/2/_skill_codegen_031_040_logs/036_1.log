    draw_line(out, red_r, red_c, direction=GEN_RED_DIR, color=GEN_RED)

    inp = out.copy()
    for r, c in (blue_ray - blue_square) | (red_ray - red_square):
        inp[r, c] = GEN_BG
    return inp, out


