+                "final_bbox": bbox_coords(current),
+                "row_span": (row0, row1),
+                "steps": int(steps),
+                "fit_openings": fit_openings,
+                "used_openings": tuple(sorted(used_openings)),
+                "stop_reason": stop_reason,
+                "blocker": blocker,
+            }
