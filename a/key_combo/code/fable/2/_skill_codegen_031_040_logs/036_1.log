+                return [
+                    {
+                        "role": "primary",
+                        "span": primary_span,
+                        "expect_used": {(0, int(primary_idx1)), (1, int(primary_idx2))},
+                    },
+                    {
+                        "role": "between_fail",
+                        "span": random.choice(between_spans),
+                        "expect_used": {(0, int(between_idx))},
+                        "expect_stop": ("wall", 1),
