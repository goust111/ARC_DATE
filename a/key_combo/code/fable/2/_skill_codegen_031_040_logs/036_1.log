+    if n_walls == 1:
+        last_wall = wall1_col
+        width = last_wall + random.randint(7, 11)
+        wall_cols = [wall1_col]
+    else:
+        corridor = random.randint(4, 6)
+        wall2_col = wall1_col + corridor
+        last_wall = wall2_col
+        width = last_wall + random.randint(7, 10)
+        wall_cols = [wall1_col, wall2_col]
