+    if int(np.count_nonzero(grid == bg)) <= grid.size // 2:
+        return None
+    if not _validate_generated_scene(grid, compact_mask, template_color, actual_frame_specs, bg):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
