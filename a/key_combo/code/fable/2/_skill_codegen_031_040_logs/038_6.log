+            return None
+        r0, c0 = pos
+        ph, pw = obj["patch"].shape
+        grid[r0 : r0 + ph, c0 : c0 + pw] = obj["patch"]
+        occupied[r0 : r0 + ph, c0 : c0 + pw] = True
