+
+def _find_placement(
+    rng: random.Random,
+    occupied: np.ndarray,
+    patch_shape: tuple[int, int],
+) -> tuple[int, int] | None:
+    h, w = occupied.shape
+    ph, pw = map(int, patch_shape)
