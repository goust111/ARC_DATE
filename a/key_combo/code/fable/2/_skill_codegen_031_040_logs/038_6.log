+def _compact_sparse_template(comp: dict) -> np.ndarray | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
