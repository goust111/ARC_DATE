+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+NEIGHBORS4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PALETTE: tuple[int, ...] = tuple(range(10))
+MAX_GRID_SIDE = 30
+GEN_ATTEMPTS = 600
+FRAME_COUNT_CHOICES: tuple[int, ...] = (2, 3)
+FRAME_SCALE_CHOICES: tuple[int, ...] = (2, 3, 4, 5)
+OBJECT_PADDING = 1
+EDGE_MARGIN = 1
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
+    k = int(factor)
+    assert k >= 1
+    return np.kron(sprite, np.ones((k, k), dtype=sprite.dtype))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            seen[r, c] = True
+            queue: deque[Coord] = deque([(r, c)])
+            cells: list[Coord] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+
+    return components
+
+
+def _mask_is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    queue: deque[Coord] = deque([start])
+    seen = {start}
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr = r + dr
+            nc = c + dc
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if not bool(mask[nr, nc]) or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            queue.append((nr, nc))
+
+    return len(seen) == int(mask.sum())
+
+
+def _is_hollow_frame(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+
+    expected_area = 2 * h + 2 * w - 4
+    if int(comp["area"]) != expected_area:
+        return False
+
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.array_equal(mask, border))
+
+
+def _compact_sparse_template(comp: dict) -> np.ndarray | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    rel = comp["coords"] - np.array([r0, c0], dtype=int)
+
+    if np.any(rel[:, 0] % 2 != 0) or np.any(rel[:, 1] % 2 != 0):
+        return None
+
+    sparse = np.zeros((h, w), dtype=bool)
+    sparse[rel[:, 0], rel[:, 1]] = True
+    nonempty_rows = np.any(sparse, axis=1)
+    nonempty_cols = np.any(sparse, axis=0)
+    compact = sparse[nonempty_rows][:, nonempty_cols]
+    if compact.size == 0:
+        return None
+    if compact.shape == sparse.shape:
+        return None
+    if compact.shape[0] < 2 or compact.shape[1] < 2:
+        return None
+    if not _mask_is_connected(compact):
+        return None
+    return compact
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, dict, list[dict]]:
+    bg = _get_bg(grid)
+    components = _find_components(grid, bg)
+    assert components, "expected non-background objects"
+
+    frames: list[dict] = []
+    templates: list[dict] = []
+    others: list[dict] = []
+    for comp in components:
+        if _is_hollow_frame(comp):
+            frames.append(comp)
+            continue
+        compact = _compact_sparse_template(comp)
+        if compact is None:
+            others.append(comp)
