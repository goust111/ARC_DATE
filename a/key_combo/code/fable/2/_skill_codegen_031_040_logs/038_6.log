+    if len(cells) != target_area:
+        return None
+
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+
+    if not np.all(mask.any(axis=1)) or not np.all(mask.any(axis=0)):
+        return None
