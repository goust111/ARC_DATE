+
+def _place_objects(
+    rng: random.Random,
+    objects: list[dict],
+    grid_shape: tuple[int, int],
+    bg: int,
+) -> tuple[np.ndarray, list[dict]] | None:
+    grid = np.full(grid_shape, bg, dtype=int)
+    occupied = np.zeros(grid_shape, dtype=bool)
+    placed_specs: list[dict] = []
+
