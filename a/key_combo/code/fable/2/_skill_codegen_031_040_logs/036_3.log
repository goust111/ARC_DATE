    row_parities = []
    cursor = 0
    for count in row_counts:
        row_parities.append(parity_plan[cursor : cursor + count])
        cursor += count
    random.shuffle(row_parities)

    row_heights = _gen_choose_row_heights(n, row_parities)
    if row_heights is None:
