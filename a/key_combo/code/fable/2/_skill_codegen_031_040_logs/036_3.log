+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter
+from importlib.machinery import SourceFileLoader
+
+import numpy as np
+
+try:
+    from arc_utils import (
+        Color,
+        crop_bbox,
+        find_components,
+        get_bg,
+        paste,
+        random_free_location,
+        random_sprite,
+    )
+except ImportError:
