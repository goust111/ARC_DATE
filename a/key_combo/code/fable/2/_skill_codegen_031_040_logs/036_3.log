+def _transform_coord(coord: tuple[int, int], shape: tuple[int, int], transform: int) -> tuple[int, int]:
+    r, c = map(int, coord)
+    h, w = map(int, shape)
+    if transform == 0:
+        return r, c
+    if transform == 1:
+        return w - 1 - c, r
+    if transform == 2:
+        return h - 1 - r, w - 1 - c
+    if transform == 3:
