+    if transform == 4:
+        return r, w - 1 - c
+    if transform == 5:
+        return c, r
+    if transform == 6:
+        return h - 1 - r, c
+    if transform == 7:
+        return w - 1 - c, h - 1 - r
+    raise ValueError(f"unknown transform {transform}")
