+                local_t = (int(cr) - member["shift"][0], int(cc) - member["shift"][1])
+                local = _inverse_transform_coord(local_t, obj["shape"], member["transform"])
+                abs_r = obj["bbox"][0] + local[0]
+                abs_c = obj["bbox"][1] + local[1]
