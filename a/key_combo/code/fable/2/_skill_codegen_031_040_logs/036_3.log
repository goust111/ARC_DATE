+def _transform_coord(coord: tuple[int, int], shape: tuple[int, int], transform: int) -> tuple[int, int]:
+    r, c = map(int, coord)
+    h, w = map(int, shape)
+    if transform == 0:
+        return r, c
+    if transform == 1:
+        return w - 1 - c, r
+    if transform == 2:
+        return h - 1 - r, w - 1 - c
+    if transform == 3:
+        return c, h - 1 - r
+    if transform == 4:
+        return r, w - 1 - c
+    if transform == 5:
+        return c, r
+    if transform == 6:
+        return h - 1 - r, c
+    if transform == 7:
+        return w - 1 - c, h - 1 - r
+    raise ValueError(f"unknown transform {transform}")
+
+
+def _inverse_transform_coord(
+    coord: tuple[int, int],
+    shape: tuple[int, int],
+    transform: int,
+) -> tuple[int, int]:
+    r, c = map(int, coord)
+    h, w = map(int, shape)
+    if transform == 0:
+        return r, c
+    if transform == 1:
+        return c, w - 1 - r
+    if transform == 2:
+        return h - 1 - r, w - 1 - c
+    if transform == 3:
+        return h - 1 - c, r
+    if transform == 4:
+        return r, w - 1 - c
+    if transform == 5:
+        return c, r
+    if transform == 6:
