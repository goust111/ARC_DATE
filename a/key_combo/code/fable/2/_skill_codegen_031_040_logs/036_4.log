+def _has_same_count_diff_length(bars: list[dict]) -> bool:
+    for i, a in enumerate(bars):
+        for b in bars[i + 1 :]:
+            if int(a["count"]) == int(b["count"]) and int(a["length"]) != int(b["length"]):
+                return True
+    return False
+
