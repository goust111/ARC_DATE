    direction: tuple[int, int],
    color: int,
    bg: int,
) -> None:
    height, width = map(int, g.shape)
    r, c = start
    dr, dc = direction
    while 0 <= r < height and 0 <= c < width:
        assert int(g[r, c]) in {int(bg), int(color)}, "ray path must not cross the other block"
        r += dr
        c += dc


