+def _has_same_length_diff_count(bars: list[dict]) -> bool:
+    for i, a in enumerate(bars):
+        for b in bars[i + 1 :]:
+            if int(a["length"]) == int(b["length"]) and int(a["count"]) != int(b["count"]):
+                return True
+    return False
