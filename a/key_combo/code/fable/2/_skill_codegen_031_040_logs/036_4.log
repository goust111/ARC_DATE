+def generate_input() -> np.ndarray:
+    mode = _gen_mode()
+    for _ in range(GEN_ATTEMPTS):
+        attempt = _render_attempt(mode)
+        if attempt is None:
+            continue
+        inp, expected, meta = attempt
+        if not _validate_attempt(inp, expected, meta["mode"]):
