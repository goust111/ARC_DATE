+def _has_mirror_pair(bars: list[dict]) -> bool:
+    for i, a in enumerate(bars):
+        for b in bars[i + 1 :]:
+            if (
+                int(a["length"]) == int(b["length"])
+                and int(a["count"]) == int(b["count"])
+                and a["orientation"] == b["orientation"]
+                and a["start_side"] != b["start_side"]
+            ):
+                return True
+    return False
