+        while len(coords) < area:
+            frontier = []
+            for r, c in coords:
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if (nr, nc) in coords:
+                        continue
+                    trial = coords | {(nr, nc)}
+                    rows = [p[0] for p in trial]
+                    cols = [p[1] for p in trial]
+                    if max(rows) - min(rows) + 1 <= 4 and max(cols) - min(cols) + 1 <= 4:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            coords.add(frontier[int(rng.integers(len(frontier)))])
