+    top = g[:panel_start]
+    scene = g[panel_start:]
+    _bg, by4, by8, _per_color = _scene_maps(scene)
+
+    out = g.copy()
+    for bar in _bar_specs(top):
+        if bar["orientation"] == "h":
+            color = by4[bar["length"]]
+        else:
+            color = by8[bar["length"]]
+        coords = bar["coords"]
+        out[coords[:, 0], coords[:, 1]] = int(color)
+    return out
