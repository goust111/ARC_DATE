+def _corner_filled(mask: np.ndarray, corner: str) -> bool:
+    if corner == "tl":
+        return bool(mask[0, 0])
+    if corner == "tr":
+        return bool(mask[0, -1])
+    if corner == "bl":
+        return bool(mask[-1, 0])
+    if corner == "br":
+        return bool(mask[-1, -1])
