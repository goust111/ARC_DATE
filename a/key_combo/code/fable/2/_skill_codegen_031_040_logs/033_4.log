+    return tiles
+
+
+def _parity(pos: tuple[int, int]) -> int:
+    return int((int(pos[0]) + int(pos[1])) % 2)
+
+
+def _occluded_tile(grid: np.ndarray, tiles: dict[tuple[int, int], np.ndarray]) -> tuple[tuple[int, int], int]:
+    g = np.asarray(grid, dtype=int)
