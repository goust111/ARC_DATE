def frame_cells(r0,c0,s):
    cells=set(); r1=r0+s-1; c1=c0+s-1
    for c in range(c0,c1+1): cells.add((r0,c)); cells.add((r1,c))
    for r in range(r0,r1+1): cells.add((r,c0)); cells.add((r,c1))
    return cells

def rect_cells(r0,c0,h,w):
    return {(r,c) for r in range(r0,r0+h) for c in range(c0,c0+w)}

def comps(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); out=[]
