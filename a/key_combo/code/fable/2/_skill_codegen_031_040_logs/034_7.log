    trails = [_gen_trail_len(n, r0 + rr, c0 + cc, dr, dc) for rr, cc, dr, dc in active]
    return (
        SOLID_H_MIN <= sh <= SOLID_H_MAX
        and SOLID_W_MIN <= sw <= SOLID_W_MAX
        and all(TRAIL_LEN_MIN <= t <= TRAIL_LEN_MAX for t in trails)
    )


