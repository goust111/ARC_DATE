import numpy as np
from collections import defaultdict
H=W=20
bg=0; rc=2; fc=3

def build(frame_r, frame_c, s, gaps, rect_h, rect_w):
    gt,gb,gl,gr = gaps
    rr0=frame_r+1+gt; cc0=frame_c+1+gl
    rr1=rr0+rect_h-1; cc1=cc0+rect_w-1
    fr1=frame_r+s-1; fc1=frame_c+s-1
    g=np.zeros((H,W),int)
    g[rr0:rr1+1, cc0:cc1+1]=rc
    g[frame_r, frame_c:fc1+1]=fc
    g[fr1, frame_c:fc1+1]=fc
    g[frame_r:fr1+1, frame_c]=fc
    g[frame_r:fr1+1, fc1]=fc
    return g,(rr0,cc0,rr1,cc1),(frame_r,frame_c,fr1,fc1)

def comps(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; cur=[]
            while st:
                rr,cc=st.pop(); cur.append((rr,cc))
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    r2,c2=rr+dr,cc+dc
                    if 0<=r2<H and 0<=c2<W and mask[r2,c2] and not seen[r2,c2]: seen[r2,c2]=1; st.append((r2,c2))
            out.append(cur)
    return out

def solve(g,rb,fb):
    out=g.copy(); corners={(fb[0],fb[1]),(fb[0],fb[3]),(fb[2],fb[1]),(fb[2],fb[3])}; active=[]
    rays=[((rb[0],rb[1]),(-1,-1),'TL'),((rb[0],rb[3]),(-1,1),'TR'),((rb[2],rb[1]),(1,-1),'BL'),((rb[2],rb[3]),(1,1),'BR')]
    for (r,c),(dr,dc),name in rays:
        rr,cc=r+dr,c+dc
        while 0<=rr<H and 0<=cc<W and g[rr,cc]==bg:
            rr+=dr; cc+=dc
        if 0<=rr<H and 0<=cc<W and g[rr,cc]==fc and (rr,cc) in corners:
            active.append(name)
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc]==bg: out[rr,cc]=rc
                rr+=dr;cc+=dc
    ray=(out==rc)&(g==bg)
    fills=[]
    for comp in comps(out==bg):
        S=set(comp)
        touch=any(r in (0,H-1) or c in (0,W-1) for r,c in S)
        if not touch: continue
        ok=True
        for r,c in S:
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                rr,cc=r+dr,c+dc
                if not (0<=rr<H and 0<=cc<W): continue
                if (rr,cc) in S: continue
                if not ray[rr,cc]:
                    ok=False; break
            if not ok: break
        if ok: fills.append(len(S))
    return active, fills

