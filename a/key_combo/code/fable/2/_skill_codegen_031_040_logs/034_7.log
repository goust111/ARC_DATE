import numpy as np
H=W=18
bg=0; rc=2; fc=3

def frame_cells(r0,c0,h,w):
    cells=set(); r1=r0+h-1; c1=c0+w-1
    for c in range(c0,c1+1): cells.add((r0,c)); cells.add((r1,c))
    for r in range(r0,r1+1): cells.add((r,c0)); cells.add((r,c1))
    return cells

def rect_cells(r0,c0,h,w):
    return {(r,c) for r in range(r0,r0+h) for c in range(c0,c0+w)}

def comps(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; cur=[]
            while st:
                rr,cc=st.pop(); cur.append((rr,cc))
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    r2,c2=rr+dr,cc+dc
                    if 0<=r2<H and 0<=c2<W and mask[r2,c2] and not seen[r2,c2]: seen[r2,c2]=1; st.append((r2,c2))
            out.append(cur)
    return out

def solve(rbox,fbox):
    rr0,cc0,rh,rw=rbox
    fr0,fc0,fh,fw=fbox
    rect=rect_cells(rr0,cc0,rh,rw)
    frame=frame_cells(fr0,fc0,fh,fw)
    g=np.zeros((H,W),int)
    for r,c in rect: g[r,c]=rc
    for r,c in frame: g[r,c]=fc
    rb=(rr0,cc0,rr0+rh-1,cc0+rw-1)
    fb=(fr0,fc0,fr0+fh-1,fc0+fw-1)
    corners={(fb[0],fb[1]),(fb[0],fb[3]),(fb[2],fb[1]),(fb[2],fb[3])}
    out=g.copy(); active=[]
    for (r,c),(dr,dc),name in [((rb[0],rb[1]),(-1,-1),'TL'),((rb[0],rb[3]),(-1,1),'TR'),((rb[2],rb[1]),(1,-1),'BL'),((rb[2],rb[3]),(1,1),'BR')]:
        rr,cc=r+dr,c+dc; first=None
        while 0<=rr<H and 0<=cc<W:
            if g[rr,cc]"'!=bg: first=(rr,cc,int(g[rr,cc])); break
            rr+=dr;cc+=dc
        if first and first[2]==fc and (first[0],first[1]) in corners:
            active.append((name,first[:2]))
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc]==bg: out[rr,cc]=rc
                rr+=dr;cc+=dc
    fills=[]
    for comp in comps(out==bg):
        S=set(comp)
        touch=any(r in (0,H-1) or c in (0,W-1) for r,c in S)
        if not touch: continue
        ok=True
        for r,c in S:
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                rr,cc=r+dr,c+dc
                if not (0<=rr<H and 0<=cc<W):
                    continue
                if (rr,cc) in S:
                    continue
                if not (g[rr,cc]==0 and out[rr,cc]==rc):
                    ok=False; break
            if not ok: break
        if ok: fills.append(len(S))
    return active,fills

