还有一个更贴题的几何族：把方框贴边，让它的角作为“选通器”而不是被填区域里的障碍。这样射线和外边界更容易真正在视觉上围出空地。我先枚举这种贴边布局，看看能不能得到干净的小区域。
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
H=W=18
bg=0; rc=2; fc=3

def frame_cells(r0,c0,s):
    cells=set(); r1=r0+s-1; c1=c0+s-1
    for c in range(c0,c1+1): cells.add((r0,c)); cells.add((r1,c))
    for r in range(r0,r1+1): cells.add((r,c0)); cells.add((r,c1))
    return cells

def rect_cells(r0,c0,h,w):
    return {(r,c) for r in range(r0,r0+h) for c in range(c0,c0+w)}

def comps(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; cur=[]
            while st:
                rr,cc=st.pop(); cur.append((rr,cc))
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    r2,c2=rr+dr,cc+dc
                    if 0<=r2<H and 0<=c2<W and mask[r2,c2] and not seen[r2,c2]: seen[r2,c2]=1; st.append((r2,c2))
            out.append(cur)
    return out

def solve(rect, frame):
    g=np.zeros((H,W),int)
    for r,c in rect: g[r,c]=rc
    for r,c in frame: g[r,c]=fc
    rb=(min(r for r,c in rect), min(c for r,c in rect), max(r for r,c in rect), max(c for r,c in rect))
    fb=(min(r for r,c in frame), min(c for r,c in frame), max(r for r,c in frame), max(c for r,c in frame))
    corners={(fb[0],fb[1]),(fb[0],fb[3]),(fb[2],fb[1]),(fb[2],fb[3])}
    out=g.copy(); active=[]
    for (r,c),(dr,dc) in [((rb[0],rb[1]),(-1,-1)),((rb[0],rb[3]),(-1,1)),((rb[2],rb[1]),(1,-1)),((rb[2],rb[3]),(1,1))]:
        rr,cc=r+dr,c+dc; first=None
        while 0<=rr<H and 0<=cc<W:
            if g[rr,cc]"'!=bg: first=(rr,cc,int(g[rr,cc])); break
            rr+=dr;cc+=dc
        if first and first[2]==fc and (first[0],first[1]) in corners:
            active.append((r,c,dr,dc,first[:2]))
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc]==bg: out[rr,cc]=rc
                rr+=dr;cc+=dc
    return g,out,active

found=0
for rr0 in range(4,12):
  for cc0 in range(4,12):
    rect=rect_cells(rr0,cc0,3,4)
    for side in ['"'top','bottom','left','right']:
