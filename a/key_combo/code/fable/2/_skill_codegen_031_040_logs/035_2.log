# Canvas and palette.
_GEN_BG = 7
_GEN_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
_GEN_SIZE_MIN = 7
_GEN_SIZE_MAX = 10

# Bar counts and color diversity.
_GEN_H_COUNT_MIN = 2
_GEN_H_COUNT_MAX = 3
_GEN_V_COUNT_MIN = 1
_GEN_V_COUNT_MAX = 4
_GEN_TOTAL_COUNT_MIN = 4
_GEN_TOTAL_COUNT_MAX = 7
