    h, w = grid.shape
    cell_set = set(cells)
    for r, c in cells:
        if grid[r, c] != _GEN_BG:
            return False
        for dr, dc in _GEN_DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in cell_set and grid[rr, cc] == color:
