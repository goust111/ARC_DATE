+def _carve_notch(local: np.ndarray, side: str, depth: int, start: int, span: int) -> None:
+    if side == "top":
+        local[:depth, start : start + span] = False
+    elif side == "bottom":
+        local[-depth:, start : start + span] = False
+    elif side == "left":
+        local[start : start + span, :depth] = False
+    else:
+        local[start : start + span, -depth:] = False
+
