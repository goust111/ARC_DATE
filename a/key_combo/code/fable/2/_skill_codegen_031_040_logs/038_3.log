+
+def _valid_depth_subsets(interior_depths: list[int], outside_candidates: dict[int, list[tuple[int, int]]]) -> list[tuple[int, ...]]:
+    eligible = [d for d in interior_depths if d >= 2 and outside_candidates.get(d)]
