+from __future__ import annotations
+
+from collections import Counter, deque
+import hashlib
+import itertools
+import random
+
+import numpy as np
+
+
+GEN_ATTEMPTS = 400
+GRID_MIN_SIZE = 20
+GRID_MAX_SIZE = 30
+SOLID_MIN_SIZE = 11
+SOLID_MAX_SIZE = 19
+MIN_GRID_MARGIN = 3
+MIN_INTERIOR_DEPTH = 5
