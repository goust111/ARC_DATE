+                return False
+        d = int(dist[rr, cc])
+        color = int(grid[rr, cc])
+        if d in seen_depths or color in seen_colors or depth_to_color.get(d) != color:
+            return False
+        seen_depths.add(d)
+        seen_colors.add(color)
