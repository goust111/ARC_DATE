+    out_sig = _signature(expected)
+    if in_sig in _SEEN_INPUT_SIGNATURES or out_sig in _SEEN_OUTPUT_SIGNATURES:
+        return None
+    _SEEN_INPUT_SIGNATURES.add(in_sig)
+    _SEEN_OUTPUT_SIGNATURES.add(out_sig)
+    return grid
+
+
+def generate_input() -> np.ndarray:
