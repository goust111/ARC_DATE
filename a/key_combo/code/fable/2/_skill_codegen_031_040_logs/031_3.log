def _gen_marker_bounds(area: int) -> tuple[int, int]:
    lo = max(_GEN_MARKER_COUNT_MIN, int(math.ceil(_GEN_MARKER_DENSITY_MIN * area)))
    hi = min(_GEN_MARKER_COUNT_MAX, int(math.floor(_GEN_MARKER_DENSITY_MAX * area)))
