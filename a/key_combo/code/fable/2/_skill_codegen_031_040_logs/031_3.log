+    return [(r, c) for r in range(n_rows) for c in range(n_cols)]
+
+
+def _l_mask(length: int, orientation: int) -> np.ndarray:
+    mask = np.zeros((length, length), dtype=bool)
+    if orientation == 0:
+        mask[0, :] = True
+        mask[:, 0] = True
+    elif orientation == 1:
+        mask[0, :] = True
+        mask[:, -1] = True
+    elif orientation == 2:
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif orientation == 3:
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError("orientation must be in 0..3")
+    return mask
+
+
