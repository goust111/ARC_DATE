+            cell_h, cell_w, state[1], state[0], fg, bg
+        )
+    return board
+
+
+def _row_major_has_violation(
+    n_rows: int,
+    n_cols: int,
+    states_by_cell: dict[Coord, State],
+    blank_cell: Coord,
+    grow: int,
+) -> bool:
+    sequence = [
+        None if cell == blank_cell else states_by_cell[cell]
+        for cell in _row_major_coords(n_rows, n_cols)
