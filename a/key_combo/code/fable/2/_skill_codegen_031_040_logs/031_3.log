+    if orientation == 0:
+        mask[0, :] = True
+        mask[:, 0] = True
+    elif orientation == 1:
+        mask[0, :] = True
+        mask[:, -1] = True
+    elif orientation == 2:
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif orientation == 3:
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError("orientation must be in 0..3")
+    return mask
