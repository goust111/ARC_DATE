+        br0, bc0, br1, bc1 = local["block_bbox"]
+        hr, hc = local["hole"]
+        wr0, wc0, wr1, wc1 = local["target_wall_bbox"]
+        local["block_bbox"] = (zr0 + br0, zc0 + bc0, zr0 + br1, zc0 + bc1)
+        local["hole"] = (zr0 + hr, zc0 + hc)
