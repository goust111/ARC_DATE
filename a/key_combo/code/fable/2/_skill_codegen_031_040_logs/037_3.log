+
+
+def _wall_distance(block: dict, wall: dict, direction: str) -> int | None:
+    br0, bc0, br1, bc1 = block["bbox"]
+    wr0, wc0, wr1, wc1 = wall["bbox"]
+
+    if direction == "right":
