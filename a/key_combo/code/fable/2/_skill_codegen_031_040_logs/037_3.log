+def _nearest_wall_plans(blocks: list[dict], walls: list[dict]) -> list[dict]:
+    plans = []
+    for block in blocks:
+        candidates = []
+        for direction in CARDINALS:
+            try:
+                dist, wall = _choose_wall(block, walls, direction)
+            except AssertionError:
