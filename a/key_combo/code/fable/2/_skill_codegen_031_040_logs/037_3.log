+        return None
+    if not all(rec["target_gap"] > rec["opposite_gap"] for rec in records):
+        return None
+
+    expected = _manual_output(grid, records)
+    return grid, expected, records
+
+
+def _semantic_ok(inp: np.ndarray, expected: np.ndarray, records: list[dict]) -> bool:
+    try:
