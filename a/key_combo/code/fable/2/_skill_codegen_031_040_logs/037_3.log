+BBox = tuple[int, int, int, int]
+
+BG = 0
+CARDINALS = ("up", "down", "left", "right")
+DIR_STEP = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
