+        assert block_h_choices
+        block_h = random.choice(block_h_choices)
+        block_w, near_gap, far_gap, slack_w = random.choice(_horizontal_specs(zone_w))
+        extra_left = random.randint(0, slack_w)
+        extra_right = slack_w - extra_left
+
+        if direction == "right":
