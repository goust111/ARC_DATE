+        "block_color": block_color,
+        "target_wall_color": target_color,
+        "target_gap": int(target_gap),
+        "opposite_gap": int(opposite_gap),
+        "block_bbox": (block_r0, block_c0, block_r1, block_c1),
+        "hole": (hole_r, hole_c),
+        "size": (block_r1 - block_r0 + 1, block_c1 - block_c0 + 1),
