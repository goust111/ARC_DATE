 131:     if min(*upper, *lower) < 0 or max(upper[2], upper[3], lower[2], lower[3]) >= N:
 132:         return None
 133:     if not _bbox_gap_ok(upper, lower):
 134:         return None
 135:     diag = [(start[0] + k, start[1] + direction * k) for k in range(1, gap + 1)]
 136:     return upper, lower, diag
