+    passable = g == corridor_bg
+    passable[entry] = True
+    passable[exit_cell] = True
+    route = _trace_simple_route(passable, entry, exit_cell)
+    assert route[1] == profiles[entry]["bg_neighbors"][0]
+    assert route[-2] == profiles[exit_cell]["bg_neighbors"][0]
