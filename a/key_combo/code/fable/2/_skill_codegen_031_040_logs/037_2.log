   9: # description:
  10: # In the input you will see grey horizontal and vertical bars that divide rectangular regions. Each rectangular region is black with some colored pixels added.
  11: # To make the output, fill the rectangular region with the most colored pixels. Fill it with is color. Fill the other rectangular regions with black.   
  12: 
  13: def main(input_grid: np.ndarray) -> np.ndarray:
  14:     """
  15:     Keep only the divider region or regions with the most colored pixels and fill them with their color.
  16: 
  17:     Input structure:
  18:     - Full divider rows and columns split the grid into rectangular regions.
  19:     - Each region is mostly black with scattered pixels of one non-black, non-divider color.
  20:     - The divider color appears as a full constant row or column.
  21: 
  22:     Rule:
  23:     - Detect the divider color and extract all separated regions.
  24:     - Count non-black, non-divider colored pixels in each region.
  25:     - Fill regions tied for the maximum count with their single color and fill all other regions black.
  26: 
  27:     Key insight:
  28:     - The scattered pixels are votes for a region; only the densest region contents survive.
  29:     """
  30:     # Create a copy of the input grid to avoid modifying the original
  31:     output_grid = np.copy(input_grid)  
  32: 
  33:     # Get all the rectangular regions seperated by horizontal and vertical dividers
  34:     # The dividers are colored grey, but more generally their color is just whatever color stretches all the way horizontally or vertically
  35:     for r in range(input_grid.shape[0]):
  36:         if np.all(input_grid[r, :] == input_grid[r, 0]):
  37:             divider_color = input_grid[r, 0]
  38:             break
  39:     # For this problem you could also do: divider_color = Color.GRAY
  40:     regions = find_components(output_grid, bg=divider_color, connectivity=4, monochromatic=False, return_format="objects")
  41: 
  42:     # Find the region with the most colored pixels inside of it
  43:     num_colored_pixels = [ np.sum((region != divider_color) & (region != Color.BLACK)) for region in regions ]
  44:     max_colored_pixels = max(num_colored_pixels)
  45: 
  46:     # Fill the region with the most colored pixels with its color
  47:     # Fill the other regions with black
  48:     for region_obj in regions:
  49:         # Figure out if it is one of the max colored regions to determine what the target color is that we are going to fill with
  50:         num_colored_pixels_in_this_region = np.sum((region_obj != divider_color) & (region_obj != Color.BLACK))
  51:         if num_colored_pixels_in_this_region == max_colored_pixels:
  52:             colors = [ color for color in colors_present(region_obj, exclude={ divider_color }) if color != Color.BLACK ]
  53:             assert len(colors) == 1, "Each region should have only one color"
  54:             target_color = colors[0]
  55:         else:
  56:             target_color = Color.BLACK
  57: 
  58:         # Fill the region with the target color
  59:         output_grid[region_obj != divider_color] = target_color
