+            for nr, nc in neighbors4(*cur)
+            if in_bounds(mask.shape, nr, nc) and (nr, nc) in component and (nr, nc) != prev
+        ]
+        assert len(nxt) == 1, "the corridor route must be unique"
+        prev, cur = cur, nxt[0]
+        route.append(cur)
