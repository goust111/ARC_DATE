+
+def _build_route(shape: tuple[int, int]) -> list[tuple[int, int]] | None:
+    max_len = min(PATH_MAX_LEN, max(PATH_MIN_LEN, ((shape[0] - 2) * (shape[1] - 2)) // 4))
+    for _ in range(ROUTE_ATTEMPTS):
