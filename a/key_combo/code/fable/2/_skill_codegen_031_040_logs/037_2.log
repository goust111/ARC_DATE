 374:     H, W = out.shape
 375:     v = int(color)
 376:     for r, c in coords:
 377:         rr = int(r)
 378:         cc = int(c)
 379:         if 0 <= rr < H and 0 <= cc < W:
 380:             out[rr, cc] = v
