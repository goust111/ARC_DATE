+                end_r, end_c = _planned_end_state(center, direction)
+                if remain > 0 and not (2 <= end_c <= W - 3):
+                    continue
+                if remain == 0 and not (1 <= end_c <= W - 2):
+                    continue
+
+                chosen_center = center
+                current_r, c = end_r, end_c
+                break
