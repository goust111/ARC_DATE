+        return None
+    if {
+        (tuple(d["center"]), tuple(d["direction"]), int(d["radius"]))
+        for d in inferred
+    } != {
+        (tuple(d["center"]), tuple(d["direction"]), int(d["radius"]))
+        for d in deflectors
+    }:
+        return None
+
+    out = main(grid)
