+        path.append((r, c))
+        if r == H - 1:
+            break
+
+        center = (r + 1, c)
+        if center in deflectors:
+            dr, dc = deflectors[center]
+            nr = r + (1 if dr > 0 else 0)
+            nc = c + dc
+            hits.append(center)
+        else:
