+def _corner_cells(center: tuple[int, int], radius: int, direction: tuple[int, int]) -> set[tuple[int, int]]:
+    cr, cc = map(int, center)
+    k = int(radius)
+    corners = {
+        (cr - k, cc - k),
+        (cr - k, cc + k),
+        (cr + k, cc - k),
+        (cr + k, cc + k),
+    }
+    missing = (cr + k * direction[0], cc + k * direction[1])
+    corners.remove(missing)
