+
+
+def _assign_radii(
+    shape: tuple[int, int],
+    deflectors: list[dict],
+    path_cells: set[tuple[int, int]],
+) -> list[dict] | None:
+    H, W = map(int, shape)
+    ordered = list(deflectors)
+    random.shuffle(ordered)
+    ordered.sort(
+        key=lambda d: min(
+            3,
+            d["center"][0] - 2,
+            H - 2 - d["center"][0],
+            d["center"][1] - 1,
+            W - 2 - d["center"][1],
+        )
+    )
+
+    chosen: list[dict] = []
+    occupied_corners: set[tuple[int, int]] = set()
+
+    def search(i: int) -> bool:
+        if i == len(ordered):
+            return True
+
+        base = ordered[i]
+        cr, cc = base["center"]
+        max_k = min(3, cr - 2, H - 2 - cr, cc - 1, W - 2 - cc)
+        if max_k < 1:
+            return False
