+
+def _build_repaired_panels(
+    panel_count: int,
+    panel_size: int,
+    bg: int,
+    panel_colors: list[int],
+) -> tuple[list[np.ndarray], list[tuple[int, int]], dict[tuple[int, int], tuple[int, int]]]:
+    pool = _off_axis_positions(panel_size)
