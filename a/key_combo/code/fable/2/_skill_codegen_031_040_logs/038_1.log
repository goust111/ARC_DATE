+
+        sub = g[r0 : r1 + 1, c0 : c1 + 1]
+        expected = np.zeros((height, width), dtype=bool)
+        expected[0, :] = True
+        expected[-1, :] = True
+        for j in range(panel_count + 1):
+            expected[:, j * (panel_size + 1)] = True
+
+        if np.array_equal(sub == color, expected):
