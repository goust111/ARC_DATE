    ((2, 0), frozenset({(2,2),(1,3),(0,4),(3,3),(4,4)})),          # NE+SE
]


def _flood_inside(wall: frozenset, indicator: tuple[int, int]) -> set[tuple[int, int]]:
    tmp = np.zeros((TILE_SZ, TILE_SZ), dtype=int)
