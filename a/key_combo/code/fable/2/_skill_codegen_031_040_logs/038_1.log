+        panel_size,
+        bg,
+        border_color,
+        impurity_colors,
+    )
+    _semantic_checks(
+        grid,
+        repaired_panels,
+        damaged_panels,
+        spatial_order,
+        layer_order,
+        bg,
+        private_positions,
+        panel_colors,
+        impurity_colors,
+    )
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        try:
+            grid = _generate_attempt()
+        except AssertionError:
