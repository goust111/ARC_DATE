+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _paint_pair(panel: np.ndarray, r: int, c: int, color: int) -> None:
+    mirror_c = panel.shape[1] - 1 - c
+    panel[r, c] = int(color)
+    panel[r, mirror_c] = int(color)
