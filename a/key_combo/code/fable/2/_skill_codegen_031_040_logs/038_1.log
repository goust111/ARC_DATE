+            out = main(grid)
+            signature = out.tobytes() + str(out.shape).encode()
+            if signature in _SEEN_OUTPUT_SIGNATURES:
+                continue
+            _SEEN_OUTPUT_SIGNATURES.add(signature)
+            return grid
