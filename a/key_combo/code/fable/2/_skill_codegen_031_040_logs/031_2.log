+def _neighbors4(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    h, w = shape
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
