GEN_BAND_SLOPES = [-1, 1]
GEN_MIN_PLATEAU_ROWS = 2
# Canvas and placement controls.
GEN_GRID_HEIGHTS = range(14, 28)
GEN_GRID_WIDTHS = range(18, 24)
GEN_BORDER_MARGIN = 1
GEN_BACKGROUND_AREA_FACTOR = 2
# Retry limits.
