+from arc_utils import get_bg, paste
+
+
+QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
+COMMON_POSITION_ORDERS = (
+    (0, 1, 2, 3),
+    (0, 3, 2, 1),
+    (3, 2, 1, 0),
+    (1, 0, 3, 2),
+)
+GEN_ATTEMPTS = 400
