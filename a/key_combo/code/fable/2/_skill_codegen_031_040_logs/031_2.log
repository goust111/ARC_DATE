+import numpy as np
+
+_ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_PATH) not in sys.path:
+    sys.path.insert(0, str(_ARC_UTILS_PATH))
