+        if (hr in (r0, r1)) and (hc in (c0, c1)):
+            return None
+        if hr == r0:
+            side = "up"
+        elif hr == r1:
+            side = "down"
+        elif hc == c0:
+            side = "left"
+        else:
+            side = "right"
