+    return inp, out
+
+
+def _validate_scene(inp: np.ndarray, expected: np.ndarray) -> bool:
+    if np.array_equal(inp, expected):
+        return False
+
+    comps = find_components(inp, bg=BG, connectivity=4, monochromatic=True)
+    container_meta = []
+    object_comps = []
+    for comp in comps:
