+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if visited[r, c] or color == int(bg):
+                continue
+            visited[r, c] = True
+            q = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in deltas:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < H and 0 <= nc < W):
