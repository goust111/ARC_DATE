+    valid = []
+    for hole_r, hole_c in border_cells:
+        top = int(hole_r - tooth_r)
+        left = int(hole_c - tooth_c)
+        ok = True
+        for rr, cc in coords:
+            gr = int(top + rr)
+            gc = int(left + cc)
+            if not (0 <= gr < outer_h and 0 <= gc < outer_w):
+                ok = False
+                break
+            if (gr, gc) == (hole_r, hole_c):
+                continue
+            if not (1 <= gr <= outer_h - 2 and 1 <= gc <= outer_w - 2):
