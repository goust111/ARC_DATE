+
+def _rotate_patch_to_side(patch: np.ndarray, target_side: str, bg: int) -> tuple[np.ndarray, dict]:
+    candidates: list[tuple[np.ndarray, dict]] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
