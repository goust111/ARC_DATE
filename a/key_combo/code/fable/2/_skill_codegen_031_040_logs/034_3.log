+def _crop_pair(inp: np.ndarray, out: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    coords = np.argwhere((inp != BG) | (out != BG))
+    r0, c0, r1, c1 = bbox_coords(coords)
