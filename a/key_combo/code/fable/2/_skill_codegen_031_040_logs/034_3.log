+
+def _draw_border(dst: np.ndarray, color: int, hole: tuple[int, int] | None) -> None:
+    dst[0, :] = int(color)
+    dst[-1, :] = int(color)
+    dst[:, 0] = int(color)
+    dst[:, -1] = int(color)
