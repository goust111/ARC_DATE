+                    if visited[nr, nc] or int(g[nr, nc]) == int(bg):
+                        continue
+                    if monochromatic and int(g[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
