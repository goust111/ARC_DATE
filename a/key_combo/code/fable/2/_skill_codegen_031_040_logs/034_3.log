+def _scene_pair() -> tuple[np.ndarray, np.ndarray] | None:
+    n = random.randint(*GEN_CONTAINER_COUNT_RANGE)
+    locked_count = random.randint(1, n - 1)
+    closed_count = n - locked_count
+    assert closed_count >= 1
