+                assert r0 < gr < r1 and c0 < gc < c1, "all non-tooth key pixels must remain inside the container"
+                assert int(out[gr, gc]) == int(bg), "inserted key must not overwrite existing pixels"
+            out[gr, gc] = int(obj["color"])
