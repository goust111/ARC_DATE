+    if len(cells) != len(border):
+        return None
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "color": int(comp["color"]),
+        "has_hole": False,
+        "hole": None,
+        "hole_side": None,
+    }
+
+
+def _coords_inside(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
