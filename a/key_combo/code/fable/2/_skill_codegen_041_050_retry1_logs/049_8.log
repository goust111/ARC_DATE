+    for paper_color, sprite_color in ((colors[0], colors[1]), (colors[1], colors[0])):
+        paper_coords = np.argwhere(g == int(paper_color))
+        sprite_coords = np.argwhere(g == int(sprite_color))
+        if paper_coords.size == 0 or sprite_coords.size == 0:
+            continue
