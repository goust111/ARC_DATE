+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+ORIENTATIONS = ("tl", "tr", "bl", "br")
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 400
