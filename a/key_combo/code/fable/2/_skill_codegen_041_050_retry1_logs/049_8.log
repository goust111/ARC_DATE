+
+    patch = _compose_patch(ph, pw, paper_color, sprite_color, groups)
+    return {
+        "bg": int(bg),
+        "paper_color": int(paper_color),
+        "sprite_color": int(sprite_color),
+        "box": tuple(map(int, box)),
+        "orient": orient,
+        "local_cells": set(local_cells),
+        "groups": groups,
+        "patch": patch,
