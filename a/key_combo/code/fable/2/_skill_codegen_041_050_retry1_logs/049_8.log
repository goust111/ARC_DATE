+    cells = _grow_connected_shape(
+        cells,
+        u_min=-up,
+        u_max=ih - 1,
+        v_min=-left,
+        v_max=iw - 1,
+        target_area=target_area,
+    )
+    return cells
+
+
+def _paper_edge_visibility(
+    input_grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    paper_color: int,
+) -> bool:
+    r0, c0, r1, c1 = box
+    patch = input_grid[r0 : r1 + 1, c0 : c1 + 1]
