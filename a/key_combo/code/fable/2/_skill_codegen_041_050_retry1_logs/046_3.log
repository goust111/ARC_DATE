import random
import numpy as np

TRANSFORMS = {
    'I': lambda a: a.copy(),
    'R90': lambda a: np.rot90(a, 1).copy(),
    'R180': lambda a: np.rot90(a, 2).copy(),
    'R270': lambda a: np.rot90(a, 3).copy(),
    'FH': lambda a: np.fliplr(a).copy(),
    'FV': lambda a: np.flipud(a).copy(),
    'FD': lambda a: a.T.copy(),
    'FA': lambda a: np.fliplr(np.flipud(a)).T.copy(),
}
PAIRS = [
    ('FD', ('R270', 'FH')),
    ('FD', ('R90', 'FV')),
    ('FA', ('R90', 'FH')),
    ('FA', ('R270', 'FV')),
]

def apply(name, a):
    return TRANSFORMS[name](a)

def contiguous(mask):
    pts = np.argwhere(mask)
    if len(pts)==0:
        return False
    seen = {tuple(map(int, pts[0]))}
    stack = [tuple(map(int, pts[0]))]
    H,W = mask.shape
    while stack:
        r,c = stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc = r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==len(pts)

def symmetrize(base, diag):
    n = base.shape[0]
    out = base.copy()
    for r in range(n):
        for c in range(n):
            if base[r,c]:
                if diag=='FD':
                    out[c,r] = True
                else:
                    out[n-1-c,n-1-r] = True
    return out

def make_sprite(n, diag):
    for _ in range(10000):
        base = np.zeros((n,n), dtype=bool)
        for r in range(n):
            for c in range(n):
                if diag=='FD' and r>c:
                    continue
                if diag=='FA' and r+c>n-1:
                    continue
                if random.random() < 0.45:
                    base[r,c] = True
        # force both edge pairs so bbox is full
        if diag=='FD':
            c1 = random.randrange(n)
            c2 = random.randrange(n)
            base[0,c1] = True
            base[c1,0] = True
            base[n-1,c2] = True
            base[c2,n-1] = True
        else:
            c1 = random.randrange(n)
            c2 = random.randrange(n)
            base[0,c1] = True
            base[n-1-c1,n-1-0] = True
            base[n-1,c2] = True
            base[n-1-c2,0] = True
        mask = symmetrize(base, diag)
        if mask.sum() < n+2 or mask.sum() > n*n-2:
            continue
        if not mask[0].any() or not mask[-1].any() or not mask[:,0].any() or not mask[:,-1].any():
            continue
        if not contiguous(mask):
            continue
        stabs = [name for name in TRANSFORMS if np.array_equal(apply(name, mask), mask)]
        if set(stabs) "'!= {'"'I', diag}:
            continue
        return mask
    return None

ok = 0
for n in [3,4]:
    for diag,pair in PAIRS:
        for _ in range(50):
            s = make_sprite(n, diag)
            if s is None:
                print('failed sprite', n, diag)
                raise SystemExit
            c12 = [name for name in TRANSFORMS if np.array_equal(apply(name, s), apply(pair[0], s))]
            if set(c12) "'!= set(pair):
                print('"'bad pair', n, diag, pair, c12, s.astype(int), sep='\\n')
                raise SystemExit
            # choose either as true, other false, and see 2-step disambiguation from panel2->4
            for true in pair:
                p2 = apply(true, s)
                p4 = apply(true, apply(true, p2))
                cands = [name for name in TRANSFORMS if np.array_equal(apply(name, s), p2)]
                if len(cands) "'!= 2:
                    print('"'not 2 candidates 1->2', n, diag, true, cands)
                    raise SystemExit
                cands45 = [name for name in TRANSFORMS if np.array_equal(apply(name, p4), apply(true, p4))]
                if len(cands45) "'!= 2:
                    print('"'not 2 candidates 4->5', n, diag, true, cands45)
                    raise SystemExit
                winners = [name for name in cands if np.array_equal(apply(name, apply(name, p2)), p4)]
                if winners "'!= [true]:
                    print('"'bad two-step', n, diag, true, cands, winners)
                    raise SystemExit
            ok += 1
print('ok', ok)
