+            base[a, 0] = True
+            base[size - 1, b] = True
+            base[b, size - 1] = True
+        else:
+            base[0, a] = True
+            base[size - 1 - a, size - 1] = True
+            base[size - 1, b] = True
+            base[size - 1 - b, 0] = True
