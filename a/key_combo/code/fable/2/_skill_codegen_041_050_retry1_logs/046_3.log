+
+    expected = np.full_like(panels[2], int(bg))
+    _paste_mask(expected, patches[2], row0, c0 + 2 * dc, sprite_color)
+
+    grid = _stack_panels(panels, sep_color)
+    if not _validate_semantics(grid, true_transform, expected):
+        return None
+    return grid
