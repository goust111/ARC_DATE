+    info1 = _extract_sprite(panels[0], bg)
+    info2 = _extract_sprite(panels[1], bg)
+    info4 = _extract_sprite(panels[3], bg)
+    info5 = _extract_sprite(panels[4], bg)
+    assert all(info is not None for info in (info1, info2, info4, info5))
