    assert np.array_equal(apply(t,p4),p5)
    return out


def gen():
    for _ in range(1000):
        bg, sprite_color, sep = random.sample(range(10), 3)
        n = random.choice([3,4])
        diag, pair = random.choice(PAIR_FAMILIES)
        t = random.choice(pair)
        sprite = make_sprite(n, diag)
        if sprite is None:
            continue
        dc = random.choice([-3,-2,-1,1,2,3])
        min_w = n + 4*abs(dc) + 2
        if min_w > 30:
            continue
        W = random.randint(max(min_w, 14), 26)
        row = 1 if n == 4 else random.choice([1,2])
        low = 1 + max(0, -4*dc)
        high = W - n - 1 - max(0, 4*dc)
        if low > high:
            continue
        c1 = random.randint(low, high)
        patches = [sprite]
        for _step in range(4):
            patches.append(apply(t, patches[-1]))
        panels = [np.full((PANEL_H, W), bg, dtype=int) for _ in range(5)]
        for idx in [0,1,3,4]:
            paste(panels[idx], patches[idx], row, c1 + idx*dc, sprite_color)
        # semantics
        c12 = [name for name in TRANSFORMS if np.array_equal(apply(name, patches[0]), patches[1])]
        c45 = [name for name in TRANSFORMS if np.array_equal(apply(name, patches[3]), patches[4])]
        if len(c12) != 2 or len(c45) != 2:
            continue
        winners = [name for name in c12 if np.array_equal(apply(name, apply(name, patches[1])), patches[3])]
        if winners != [t]:
            continue
        rows = []
        for i,p in enumerate(panels):
            rows.append(p)
            if i < 4:
                rows.append(np.full((1,W), sep, dtype=int))
        grid = np.vstack(rows)
        out = main(grid)
        if not np.array_equal(out, np.where(patches[2], sprite_color, bg)):
            print('"'mismatch')
            return None
        return grid
    return None

sigs = set()
for i in range(500):
    g = gen()
    if g is None:
        print('gen failed at', i)
        break
    sigs.add(hashlib.md5(g.tobytes()+str(g.shape).encode()).hexdigest())
print('variants', len(sigs))
