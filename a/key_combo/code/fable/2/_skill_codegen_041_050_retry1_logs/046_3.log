+    for _ in range(4):
+        patches.append(_apply_transform(true_transform, patches[-1]))
+
+    panels = [np.full((PANEL_H, panel_w), int(bg), dtype=int) for _ in range(5)]
+    for idx in (0, 1, 3, 4):
