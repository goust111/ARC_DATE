+def _step_candidates(src_patch: np.ndarray, dst_patch: np.ndarray) -> list[str]:
+    matches = []
+    for name in TRANSFORMS:
+        pred = _apply_transform(name, src_patch)
+        if pred.shape == dst_patch.shape and np.array_equal(pred, dst_patch):
