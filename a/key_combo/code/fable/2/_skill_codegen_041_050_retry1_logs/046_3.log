import random
from collections import Counter
import hashlib
import numpy as np

PANEL_H = 5
GEN_ATTEMPTS = 500

TRANSFORMS = {
    'I': lambda a: a.copy(),
    'R90': lambda a: np.rot90(a, 1).copy(),
    'R180': lambda a: np.rot90(a, 2).copy(),
    'R270': lambda a: np.rot90(a, 3).copy(),
    'FH': lambda a: np.fliplr(a).copy(),
    'FV': lambda a: np.flipud(a).copy(),
    'FD': lambda a: a.T.copy(),
    'FA': lambda a: np.fliplr(np.flipud(a)).T.copy(),
}
PAIR_FAMILIES = [
    ('FD', ('R270', 'FH')),
    ('FD', ('R90', 'FV')),
    ('FA', ('R90', 'FH')),
    ('FA', ('R270', 'FV')),
]

def get_bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]

def bbox(mask):
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0,c0 = coords.min(axis=0)
    r1,c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)

def crop_bbox(grid, b):
    r0,c0,r1,c1 = b
    return grid[r0:r1+1, c0:c1+1].copy()

def paste(dst, patch, r0, c0, val):
    m = patch.astype(bool)
    dst[r0:r0+patch.shape[0], c0:c0+patch.shape[1]][m] = val

def apply(name, a):
    return TRANSFORMS[name](a)

def contiguous(mask):
    pts = np.argwhere(mask)
    if len(pts)==0:
        return False
    seen = {tuple(map(int, pts[0]))}
    stack = [tuple(map(int, pts[0]))]
    H,W = mask.shape
    while stack:
        r,c = stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc = r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                seen.add((rr,cc)); stack.append((rr,cc))
    return len(seen)==len(pts)

def symmetrize(base, diag):
    n = base.shape[0]
    out = base.copy()
    for r in range(n):
        for c in range(n):
            if base[r,c]:
                if diag=='FD':
                    out[c,r] = True
                else:
                    out[n-1-c,n-1-r] = True
    return out

def make_sprite(n, diag):
    for _ in range(1000):
        base = np.zeros((n,n), dtype=bool)
        for r in range(n):
            for c in range(n):
                if diag=='FD' and r>c:
                    continue
                if diag=='FA' and r+c>n-1:
                    continue
                if random.random() < 0.45:
                    base[r,c] = True
        if diag=='FD':
            c1 = random.randrange(n)
            c2 = random.randrange(n)
            base[0,c1] = True
            base[c1,0] = True
            base[n-1,c2] = True
            base[c2,n-1] = True
        else:
            c1 = random.randrange(n)
            c2 = random.randrange(n)
            base[0,c1] = True
            base[n-1-c1,n-1] = True
            base[n-1,c2] = True
            base[n-1-c2,0] = True
        mask = symmetrize(base, diag)
        if mask.sum() < n+2 or mask.sum() > n*n-2:
            continue
        if not mask[0].any() or not mask[-1].any() or not mask[:,0].any() or not mask[:,-1].any():
            continue
        if not contiguous(mask):
            continue
        stabs = [name for name in TRANSFORMS if np.array_equal(apply(name, mask), mask)]
        if set(stabs) "'!= {'"'I', diag}:
            continue
        return mask
    return None

def split_panels(grid):
    bg = get_bg(grid)
    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == grid[r,0]) and int(grid[r,0]) "'!= int(bg)]
    cuts = [-1] + rows + [grid.shape[0]]
    panels = [grid[cuts[i]+1:cuts[i+1]] for i in range(len(cuts)-1)]
    return panels, bg

def extract(panel, bg):
    mask = panel != bg
    b = bbox(mask)
    if b is None:
        return None
    patch = crop_bbox(mask, b)
    color = int(panel[mask][0])
    return b, patch, color

def main(grid):
    g = np.asarray(grid, dtype=int)
    panels, bg = split_panels(g)
    f1,f2,f3,f4,f5 = panels
    e1,e2,e4,e5 = [extract(p, bg) for p in (f1,f2,f4,f5)]
    b1,p1,col = e1
    b2,p2,_ = e2
    b4,p4,_ = e4
    b5,p5,_ = e5
    d = (b2[0]-b1[0], b2[1]-b1[1])
    cands = [name for name in TRANSFORMS if apply(name,p1).shape==p2.shape and np.array_equal(apply(name,p1),p2)]
    cands = [name for name in cands if (b4[0]-b2[0], b4[1]-b2[1]) == (2*d[0],2*d[1]) and np.array_equal(apply(name, apply(name, p2)), p4)]
    assert len(cands)==1
    t = cands[0]
    out = np.full_like(f3, bg)
