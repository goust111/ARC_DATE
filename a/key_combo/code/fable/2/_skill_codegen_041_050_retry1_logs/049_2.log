+N_RANGE = (2, 6)
+PALETTE_COLORS = tuple(range(1, 10))
+PALETTE_SIZE_RANGE = (2, 5)
+REPEAT_MIN = 1
+REPEAT_MAX = 5
+
+
+def _sample_repeats(n: int) -> list[int]:
+    upper = min(REPEAT_MAX, 30 // n)
+    assert upper >= REPEAT_MIN
+    while True:
