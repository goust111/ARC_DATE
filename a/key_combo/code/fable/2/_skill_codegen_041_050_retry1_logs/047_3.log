def _solid_panel_boxes(g: np.ndarray) -> tuple[int, list[tuple[int, int, int, int]]]:
    candidates = []
    for color in np.unique(g):
        bg = int(color)
        components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
        if len(components) < 2:
            continue

        boxes = []
        valid = True
