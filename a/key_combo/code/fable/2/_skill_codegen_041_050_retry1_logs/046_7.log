    cc = np.arange(c0, c0 + w) % p
    np.add.at(counts, (rr[:, None], cc[None, :]), 1)
    return counts


def _gen_place_holes_29ec7d0e(p: int, rects: list[tuple[int, int]]) -> np.ndarray | None:
