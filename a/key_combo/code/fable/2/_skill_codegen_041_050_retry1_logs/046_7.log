+def _build_candidate_grid(shape: tuple[int, int], pixel_count: int) -> np.ndarray | None:
+    infos = _candidate_infos(shape)
+    victim_pool = [
+        info
+        for info in infos
+        if 0 < info["pos"][0] < shape[0] - 1 and 0 < info["pos"][1] < shape[1] - 1
