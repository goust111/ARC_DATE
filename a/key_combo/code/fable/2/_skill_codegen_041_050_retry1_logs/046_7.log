                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
                    frontier.append((nr, nc))
        cells.add(_gen_choice(frontier))

    patch = np.full((h, w), BACKGROUND, dtype=int)
    coords = np.asarray(list(cells), dtype=int)
    patch[coords[:, 0], coords[:, 1]] = color
    return patch


