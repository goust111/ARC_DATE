+
+BACKGROUND = 0
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+HEIGHT_RANGE = (8, 15)
+WIDTH_RANGE = (8, 15)
+PIXEL_COUNT_CHOICES = (2, 3, 4)
+PIXEL_COUNT_WEIGHTS = (1, 4, 3)
+MAX_GENERATION_ATTEMPTS = 800
