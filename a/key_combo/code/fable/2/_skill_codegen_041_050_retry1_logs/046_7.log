+    grid = np.full(shape, BACKGROUND, dtype=int)
+    for pos, color in zip(positions, colors):
+        grid[pos] = int(color)
+    return np.array_equal(main(grid), out) and tuple(pair_dists) == tuple(sorted(pair_dists))
