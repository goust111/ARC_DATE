    cells.update((r, spine_c) for r in range(h))
    area = h * w
    min_cells = max(MIN_SPRITE_CELLS, (area + 1) // 2, len(cells))
    max_cells = min(MAX_SPRITE_CELLS, area)
    target = int(np.random.randint(min_cells, max_cells + 1))

