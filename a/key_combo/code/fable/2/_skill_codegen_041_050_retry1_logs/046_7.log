+        colors = random.sample(COLOR_POOL, k=pixel_count)
+        grid = np.full(shape, BACKGROUND, dtype=int)
+        for info, color in zip(selected, colors):
+            grid[info["pos"]] = int(color)
+        return grid
+    return None
+
