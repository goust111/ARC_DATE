    r0, c0, r1, c1 = b
    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
        return None

    expected = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    expected[0, :] = True
    expected[-1, :] = True
    expected[:, 0] = True
    expected[:, -1] = True
    if not np.array_equal(mask[r0 : r1 + 1, c0 : c1 + 1], expected):
        return None
    return b


