            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)]); seen[r,c]=True; pts=[]
            while q:
                rr,cc=q.popleft(); pts.append((rr,cc))
                for dr,dc in nbrs:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(np.array(pts,dtype=int))
    return out


def fill_component(shape, coords):
    mask = np.zeros(shape, dtype=bool)
    for r in np.unique(coords[:,0]):
        cols = coords[coords[:,0]==r,1]
        mask[r, int(cols.min()):int(cols.max())+1] = True
