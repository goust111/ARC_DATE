import numpy as np
from collections import deque

# generic helpers

def components(mask, connectivity=8):
    H, W = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    nbrs = [(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if (dr,dc)"'!=(0,0)] if connectivity==8 else [(-1,0),(1,0),(0,-1),(0,1)]
    out=[]
    for r in range(H):
