    if random.random()<0.5:
        lefts.reverse(); rights.reverse()
    coords=[]; spans=[]
    for r,(l,rr) in enumerate(zip(lefts,rights)):
        coords.extend([(r,l),(r,rr)])
        spans.append((r,l,rr))
    coords=np.array(coords,dtype=int)
    width=int(coords[:,1].max())+1
    fill=fill_component((height,width), coords)
    return {'"'coords':coords,'spans':spans,'height':height,'width':width,'fill':fill,'area':int(fill.sum())}


def find_nested():
