+def _spans_to_coords(spans: list[tuple[int, int]]) -> np.ndarray:
+    pts = []
+    for r, (left, right) in enumerate(spans):
+        pts.append((r, left))
+        pts.append((r, right))
+    return np.asarray(pts, dtype=int)
+
