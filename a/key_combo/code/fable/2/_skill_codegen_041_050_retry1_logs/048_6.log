import random
import numpy as np
from collections import deque

# helper funcs from previous prototype omitted for brevity; keeping only essentials

def get_bg(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])

def components(mask, connectivity=8):
    H, W = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    nbrs = [(dr, dc) for dr in (-1,0,1) for dc in (-1,0,1) if (dr, dc)"'!=(0,0)]
    comps=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            pts=[]
            while q:
                rr,cc=q.popleft(); pts.append((rr,cc))
                for dr,dc in nbrs:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            comps.append(np.array(pts,dtype=int))
    return comps

def fill_component(shape, coords):
    mask=np.zeros(shape,dtype=bool)
    for r in np.unique(coords[:,0]):
