+
+    for node, color in color_by_window.items():
+        r0, r1 = analysis["windows"][node]["row_span"]
+        c0, c1 = analysis["windows"][node]["col_span"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+
+    return out
+
+
+def _expected_output(analysis: dict[str, object]) -> np.ndarray:
