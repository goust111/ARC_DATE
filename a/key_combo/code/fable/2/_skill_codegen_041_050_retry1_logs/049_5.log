+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+WINDOW_GRID = tuple((r, c) for r in range(3) for c in range(3))
+NEIGHBORS8 = {
+    node: tuple(
+        (node[0] + dr, node[1] + dc)
