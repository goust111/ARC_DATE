+
+def _window_top_left(cell_h: int, cell_w: int, wr: int, wc: int) -> tuple[int, int]:
+    return wr * (cell_h + 1), wc * (cell_w + 1)
+
+
+def _analyze_input(grid: np.ndarray) -> dict[str, object]:
