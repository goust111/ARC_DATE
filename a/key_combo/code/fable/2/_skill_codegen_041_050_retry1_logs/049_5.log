+    (4, 2),
+    (5,),
+    (3, 3),
+    (4, 3),
+    (3, 2, 2),
+    (5, 2),
+    (4, 2, 2),
+    (6,),
+    (5, 3),
+    (4, 4),
+)
+WINDOW_SIZES = (3, 5, 7, 9)
+MAX_GENERATION_ATTEMPTS = 400
