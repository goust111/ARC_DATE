+    center_r = cell_h // 2
+    center_c = cell_w // 2
+    offsets = {node: (0, 0) for node in WINDOW_GRID}
+
+    for path in paths:
+        for current, nxt in zip(path, path[1:]):
+            offsets[current] = (int(nxt[0] - current[0]), int(nxt[1] - current[1]))
+        offsets[path[-1]] = (0, 0)
+
+    for node in isolates:
+        offsets[node] = (0, 0)
+
+    for wr, wc in WINDOW_GRID:
