+def recolor_patch(patch: np.ndarray, mapping: dict[int, int], bg: int = BG) -> np.ndarray:
+    out = np.asarray(patch, dtype=int).copy()
+    for src, dst in mapping.items():
+        out[out == int(src)] = int(dst)
+    out[out == int(bg)] = int(bg)
+    return out
+
