+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+DIVIDER = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIRS8 = DIRS4 + ((-1, -1), (-1, 1), (1, -1), (1, 1))
+
+ALL_TRANSFORMS = (
+    "identity",
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_lr",
+    "flip_ud",
+    "transpose",
+    "flip_anti",
+)
+RULE_TRANSFORMS = ALL_TRANSFORMS[1:]
+
+GEN_ATTEMPTS = 500
+SPRITE_ATTEMPTS = 200
