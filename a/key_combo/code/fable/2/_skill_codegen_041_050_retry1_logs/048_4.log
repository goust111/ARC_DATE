    random.shuffle(jobs)

    cells = list(zip(*np.where(allowed)))
    if len(cells) < len(jobs):
        return False

    if len(jobs) * GEN_SPARSE_CELL_RATIO <= len(cells):
        chosen = _gen_sparse_marker_cells(cells, len(jobs))
