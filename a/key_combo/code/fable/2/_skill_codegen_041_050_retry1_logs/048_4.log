+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return np.asarray(grid)[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+) -> np.ndarray:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = map(int, patch.shape)
+    assert 0 <= r0 and 0 <= c0 and r0 + h <= dst.shape[0] and c0 + w <= dst.shape[1]
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+    else:
+        mask = patch != int(transparent)
+        view[mask] = patch[mask]
+    return dst
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 8,
+) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    seen = np.zeros(g.shape, dtype=bool)
+    dirs = DIRS4 if int(connectivity) == 4 else DIRS8
+    comps: list[dict[str, object]] = []
+
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            if seen[r, c] or int(g[r, c]) == int(bg):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) == int(bg):
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            comps.append({"coords": arr, "bbox": bbox_coords(arr), "area": int(arr.shape[0])})
+    return comps
