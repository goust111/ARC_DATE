+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+
+BG = 0
+WALL = 8
+WATER = 2
+
+FRAME_MIN = 4
+FRAME_MAX = 7
+SEGMENT_MIN = 5
+SEGMENT_MAX = 9
+CHAIN_LENGTHS = (2, 3, 3, 4)
+GEN_ATTEMPTS = 400
+CHAIN_TRIES = 180
+ISOLATED_TRIES = 180
+COUNT_MAX_PER_FRAME = 4
+
+CORNER_RAYS = {
+    frozenset((UP, LEFT)): "TL",
+    frozenset((UP, RIGHT)): "TR",
+    frozenset((DOWN, LEFT)): "BL",
+    frozenset((DOWN, RIGHT)): "BR",
+}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, grid.ravel()))
+    if exclude is not None:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _opp(direction: tuple[int, int]) -> tuple[int, int]:
+    return (-direction[0], -direction[1])
+
+
+def _perpendiculars(direction: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    if direction in (UP, DOWN):
+        return LEFT, RIGHT
+    return UP, DOWN
+
+
+def _bbox_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            queue = deque([(r, c)])
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _border_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _inside_bbox(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _bbox_far(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    return (
+        a[2] + pad < b[0]
+        or b[2] + pad < a[0]
+        or a[3] + pad < b[1]
+        or b[3] + pad < a[1]
+    )
+
+
+def _gap_rays(bbox: tuple[int, int, int, int], gap: tuple[int, int]) -> tuple[tuple[int, int], ...] | None:
+    r0, c0, r1, c1 = bbox
+    gr, gc = gap
+    if gap == (r0, c0):
+        return (UP, LEFT)
+    if gap == (r0, c1):
+        return (UP, RIGHT)
+    if gap == (r1, c0):
+        return (DOWN, LEFT)
+    if gap == (r1, c1):
+        return (DOWN, RIGHT)
+    if gr == r0 and c0 < gc < c1:
+        return (UP,)
+    if gr == r1 and c0 < gc < c1:
