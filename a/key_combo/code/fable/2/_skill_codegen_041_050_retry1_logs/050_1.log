+        for direction, j in targets.items():
+            if port_targets[j].get(_opp(direction)) != i:
+                return None
+            adjacency[i].add(j)
+
+    chains: list[list[int]] = []
+    isolated: list[int] = []
+    seen: set[int] = set()
+
+    for start in range(len(frames)):
+        if start in seen:
+            continue
+        queue = deque([start])
+        component: list[int] = []
+        seen.add(start)
