   455	    r0, c0, r1, c1 = bbox
   456	    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
   457	
   458	
   459	def _cells_clear_of_bboxes(cells: list[tuple[int, int]], specs: list[dict]) -> bool:
   460	    for cell in cells:
   461	        if any(_inside_bbox(cell, spec["bbox"]) for spec in specs):
   462	            return False
   463	    return True
   464	
   465	
   466	def _available_run(
   467	    shape: tuple[int, int], gap: tuple[int, int], direction: tuple[int, int], specs: list[dict], path_cells: set[tuple[int, int]]
   468	) -> int:
   469	    count = 0
   470	    r, c = gap
   471	    dr, dc = direction
   472	    r += dr
   473	    c += dc
   474	    while _in_bounds(shape, r, c) and (r, c) not in path_cells and _cells_clear_of_bboxes([(r, c)], specs):
   475	        count += 1
   476	        r += dr
   477	        c += dc
   478	    return count
   479	
   480	
   481	def _choose_water_cells(spec: dict, count: int) -> list[tuple[int, int]]:
   482	    interior = _interior_cells(spec["bbox"])
   483	    assert 0 < count <= len(interior)
   484	    return random.sample(interior, count)
   485	
   486	
   487	def _render_input(shape: tuple[int, int], specs: list[dict]) -> np.ndarray:
   488	    grid = np.full(shape, BG, dtype=int)
   489	    for spec in specs:
   490	        r0, c0, r1, c1 = spec["bbox"]
   491	        grid[r0, c0 : c1 + 1] = WALL
   492	        grid[r1, c0 : c1 + 1] = WALL
   493	        grid[r0 : r1 + 1, c0] = WALL
   494	        grid[r0 : r1 + 1, c1] = WALL
   495	        grid[spec["gap"]] = BG
   496	        for cell in spec["water_cells"]:
   497	            grid[cell] = WATER
   498	    return grid
   499	
   500	
   501	def _spec_fits(
   502	    spec: dict, shape: tuple[int, int], existing_specs: list[dict], path_cells: set[tuple[int, int]]
   503	) -> bool:
   504	    if not _bbox_in_bounds(spec["bbox"], shape):
   505	        return False
   506	    if any(not _bbox_far(spec["bbox"], other["bbox"], pad=1) for other in existing_specs):
   507	        return False
   508	    if any(cell in path_cells for cell in _bbox_cells(spec["bbox"])):
   509	        return False
   510	    return True
   511	
   512	
   513	def _try_add_chain(shape: tuple[int, int], specs: list[dict], items: list[dict], path_cells: set[tuple[int, int]]) -> bool:
   514	    for _ in range(CHAIN_TRIES):
   515	        length = random.choice(CHAIN_LENGTHS)
   516	        edge_dirs = [random.choice(DIRS)]
   517	        for _step in range(length - 2):
   518	            edge_dirs.append(random.choice(_perpendiculars(edge_dirs[-1])))
   519	        drain_dir = random.choice(_perpendiculars(edge_dirs[-1]))
   520	
   521	        local_specs: list[dict] = []
   522	        local_paths: set[tuple[int, int]] = set()
   523	
   524	        h = random.randint(FRAME_MIN, FRAME_MAX)
   525	        w = random.randint(FRAME_MIN, FRAME_MAX)
   526	        offset = random.randint(1, h - 2) if edge_dirs[0] in (LEFT, RIGHT) else random.randint(1, w - 2)
   527	        start_gap = (random.randint(0, shape[0] - 1), random.randint(0, shape[1] - 1))
   528	        start_spec = _make_side_spec(start_gap, edge_dirs[0], h, w, offset)
   529	        if not _spec_fits(start_spec, shape, specs, path_cells):
   530	            continue
   531	        local_specs.append(start_spec)
   532	
   533	        prev_gap = start_gap
   534	        ok = True
   535	        for step in range(1, length):
   536	            segment_len = random.randint(SEGMENT_MIN, SEGMENT_MAX)
   537	            next_gap = (
   538	                prev_gap[0] + edge_dirs[step - 1][0] * segment_len,
   539	                prev_gap[1] + edge_dirs[step - 1][1] * segment_len,
   540	            )
   541	            next_out = drain_dir if step == length - 1 else edge_dirs[step]
   542	            rays = (_opp(edge_dirs[step - 1]), next_out)
   543	            h = random.randint(FRAME_MIN, FRAME_MAX)
   544	            w = random.randint(FRAME_MIN, FRAME_MAX)
   545	            spec = _make_corner_spec(next_gap, rays, h, w)
   546	
   547	            segment = _cells_between(prev_gap, next_gap)
   548	            if not segment or not _cells_clear_of_bboxes(segment, specs + local_specs):
   549	                ok = False
   550	                break
   551	            if any(cell in path_cells or cell in local_paths for cell in segment):
   552	                ok = False
   553	                break
   554	            if not _spec_fits(spec, shape, specs + local_specs, path_cells | local_paths):
   555	                ok = False
   556	                break
   557	
   558	            local_paths.update(segment)
   559	            local_specs.append(spec)
   560	            prev_gap = next_gap
   561	
   562	        if not ok:
   563	            continue
   564	
   565	        counts = []
   566	        for spec in local_specs:
   567	            cap = min(COUNT_MAX_PER_FRAME, len(_interior_cells(spec["bbox"])))
   568	            counts.append(random.randint(1, cap))
   569	        total = sum(counts)
   570	
   571	        terminal = local_specs[-1]
   572	        max_run = _available_run(shape, terminal["gap"], drain_dir, specs + local_specs, path_cells | local_paths)
   573	        if total > max_run:
   574	            continue
   575	        drain = _ray_cells(terminal["gap"], drain_dir, total)
   576	        if any(cell in path_cells or cell in local_paths for cell in drain):
   577	            continue
   578	        if not _cells_clear_of_bboxes(drain, specs + local_specs):
   579	            continue
   580	
   581	        base = len(specs)
   582	        indices = []
   583	        for spec, count in zip(local_specs, counts):
   584	            spec["water_count"] = count
   585	            spec["water_cells"] = _choose_water_cells(spec, count)
   586	            specs.append(spec)
   587	            indices.append(base)
   588	            base += 1
   589	
   590	        path_cells.update(local_paths)
   591	        path_cells.update(drain)
   592	        items.append({"kind": "chain", "frames": indices, "drain_dir": drain_dir})
   593	        return True
   594	
   595	    return False
   596	
   597	
   598	def _try_add_isolated(shape: tuple[int, int], specs: list[dict], items: list[dict], path_cells: set[tuple[int, int]]) -> bool:
   599	    for _ in range(ISOLATED_TRIES):
   600	        direction = random.choice(DIRS)
   601	        h = random.randint(FRAME_MIN, FRAME_MAX)
   602	        w = random.randint(FRAME_MIN, FRAME_MAX)
   603	        offset = random.randint(1, h - 2) if direction in (LEFT, RIGHT) else random.randint(1, w - 2)
   604	        gap = (random.randint(0, shape[0] - 1), random.randint(0, shape[1] - 1))
   605	        spec = _make_side_spec(gap, direction, h, w, offset)
   606	        if not _spec_fits(spec, shape, specs, path_cells):
   607	            continue
   608	
   609	        cap = min(COUNT_MAX_PER_FRAME, len(_interior_cells(spec["bbox"])))
   610	        max_run = _available_run(shape, spec["gap"], direction, specs + [spec], path_cells)
   611	        if max_run <= 0:
   612	            continue
   613	        count = random.randint(1, min(cap, max_run))
   614	        drain = _ray_cells(spec["gap"], direction, count)
   615	        if any(cell in path_cells for cell in drain):
   616	            continue
   617	        if not _cells_clear_of_bboxes(drain, specs + [spec]):
   618	            continue
   619	
   620	        spec["water_count"] = count

