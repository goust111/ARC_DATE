+    for length in _candidate_turn_lengths(edge_steps):
+        segment_cells = [_add(pos, direction, k) for k in range(1, length + 1)]
+        if any(cell == entry or cell in used_cells or cell in mirror_heads for cell in segment_cells):
+            continue
+
