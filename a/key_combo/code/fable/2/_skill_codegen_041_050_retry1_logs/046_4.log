+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        shape = (random.randint(GRID_MIN, GRID_MAX), random.randint(GRID_MIN, GRID_MAX))
+        entry = _random_entry(shape)
