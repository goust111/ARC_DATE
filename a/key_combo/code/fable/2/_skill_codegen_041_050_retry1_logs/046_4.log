  "dst": "empty fourth cell of each same-color 2x2 block",
  "transform": "reflect the present cell-local sprite masks horizontally and/or vertically around the 2x2 block center; paint the unique agreed reflected sprite into the empty cell and preserve the lattice"
}
</annotation>
</reference_puzzle>

