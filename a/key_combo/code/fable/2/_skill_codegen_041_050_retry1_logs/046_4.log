+
+
+def _mirror_options(
+    shape: tuple[int, int],
+    head: tuple[int, int],
+    orientation: str,
+    blocked: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    other_heads: set[tuple[int, int]],
+) -> list[list[tuple[int, int]]]:
