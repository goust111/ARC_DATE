+    assert len(used_red) == int(np.count_nonzero(g == RED)), "all red pixels must belong to exactly one port ray"
+
+    adjacency = [[] for _ in range(n_blobs)]
+    indegree = [0] * n_blobs
+    for src, dst in edges:
+        adjacency[src].append(dst)
