+        assert ray_cells, "each port must emit a non-empty ray"
+        assert _in_bounds(rr, cc, g.shape) and int(blob_of[rr, cc]) >= 0, "each ray must end on another grey blob"
+        dst = int(blob_of[rr, cc])
