  10: # In the input you will see a single blue pixel on a black background
  11: # To make the output, shoot the blue pixel diagonally up and to the right, having it reflect and bounce off the walls until it exits at the top of the grid
  12: 
  13: def main(input_grid):
  14:     """
  15:     Trace the blue pixel diagonally upward while bouncing off side walls.
  16: 
  17:     Input structure:
  18:     - The grid is black except for one blue pixel.
  19:     - The blue pixel is the starting point of the path.
  20:     - The grid boundaries act as the reflecting walls.
  21: 
  22:     Rule:
  23:     - Move diagonally up and right from the start pixel.
  24:     - Paint every visited cell blue.
  25:     - Reverse horizontal direction at the left or right edge and stop when exiting the top.
  26: 
  27:     Key insight:
  28:     - Only the horizontal direction changes on a bounce; the path always moves upward.
  29:     """
  30:     # Plan:
  31:     # 1. Detect the pixel
  32:     # 2. Shoot each line of the reflection one-by-one, bouncing (changing horizontal direction) when it hits a (horizontal) wall/edge of canvas
  33: 
  34:     # Locate the blue pixel.
  35:     coords = np.argwhere(input_grid == Color.BLUE)
  36:     assert coords.shape[0] == 1
  37:     r, c = map(int, coords[0])
  38: 
  39:     H, W = input_grid.shape
  40:     out = input_grid.copy()
  41: 
  42:     # Shoot diagonally up-right, bouncing off left/right walls until exiting the top.
  43:     dr, dc = -1, 1
  44:     while 0 <= r < H and 0 <= c < W:
  45:         out[r, c] = Color.BLUE
  46: 
  47:         nr = r + dr
  48:         nc = c + dc
  49:         if nr < 0:
  50:             break
  51:         if nc < 0 or nc >= W:
  52:             dc = -dc
  53:             nc = c + dc
  54:         r, c = nr, nc
  55: 
  56:     return out
  57: 
  58: 
