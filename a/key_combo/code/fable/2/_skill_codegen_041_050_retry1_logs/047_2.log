 204: def bbox(mask: np.ndarray) -> BBox | None:
 205:     """
 206:     Bounding box (bbox) of a boolean mask.
 207: 
 208:     Args:
 209:         mask: boolean array where True indicates foreground.
 210: 
 211:     Returns:
 212:         (r0,c0,r1,c1) inclusive, or None if the mask has no True values.
 213:     """
 214:     coords = np.argwhere(mask)
 215:     if coords.size == 0:
 216:         return None
 217:     return bbox_coords(coords)
 218: 
 219: 
 220: def bbox_mask(mask: np.ndarray) -> np.ndarray:
 221:     """
 222:     Return a boolean mask that is True exactly inside the bbox of `mask`.
 223: 
 224:     This corresponds to `bounding_box_mask(...)` in the legacy seeds API.
 225:     If `mask` is empty, returns an all-False mask.
 226:     """
 227:     out = np.zeros_like(mask, dtype=bool)
 228:     b = bbox(mask)
 229:     if b is None:
 230:         return out
 231:     r0, c0, r1, c1 = b
 232:     out[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True
 233:     return out
 234: 
 235: 
 236: def bbox_union(bboxes: Iterable[BBox]) -> BBox | None:
 237:     """Union of bboxes, or None for empty input."""
 238:     bbs = list(bboxes)
 239:     if not bbs:
 240:         return None
 241:     r0 = min(b[0] for b in bbs)
 242:     c0 = min(b[1] for b in bbs)
 243:     r1 = max(b[2] for b in bbs)
 244:     c1 = max(b[3] for b in bbs)
 245:     return int(r0), int(c0), int(r1), int(c1)
 246: 
 247: 
 248: def bbox_h(b: BBox) -> int:
 249:     r0, _c0, r1, _c1 = b
 250:     return int(r1 - r0 + 1)
 251: 
 252: 
 253: def bbox_w(b: BBox) -> int:
 254:     _r0, c0, _r1, c1 = b
 255:     return int(c1 - c0 + 1)
 256: 
 257: 
 258: def bbox_anchor(b: BBox, *, anchor: str = "upper left") -> Coord:
 259:     """
 260:     Return an anchor point (r,c) for a bbox.
 261: 
 262:     anchor:
 263:         upper left/right, lower left/right,
 264:         center,
 265:         upper center, lower center,
 266:         left center, right center
 267:     """
 268:     anchor = anchor.lower().replace(" ", "").replace("top", "upper").replace("bottom", "lower")
 269:     r0, c0, r1, c1 = map(int, b)
 270:     h = bbox_h(b)
 271:     w = bbox_w(b)
 272: 
 273:     if anchor == "upperleft":
 274:         rr, cc = r0, c0

