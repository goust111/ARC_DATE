+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _gen_attempt(_RNG)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid double-gate fold input")

