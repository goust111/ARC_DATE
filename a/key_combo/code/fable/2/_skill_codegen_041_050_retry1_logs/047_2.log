 303: # =============================================================================
 304: # Paste (single canonical placement primitive)
 305: # =============================================================================
 306: 
 307: 
 308: def paste(
 309:     dst: np.ndarray,
 310:     patch: np.ndarray,
 311:     r0: int,
 312:     c0: int,
 313:     *,
 314:     transparent: int | None = None,
 315:     mask: np.ndarray | None = None,
 316:     overwrite: bool = True,
 317:     clip: bool = False,
 318: ) -> np.ndarray:
 319:     """
 320:     Paste `patch` into `dst` at top-left (r0,c0).
 321: 
 322:     This is the ONE placement primitive solver examples should use.
 323: 
 324:     - Opaque paste: `paste(dst, patch, r0, c0)`
 325:     - Transparent overlay: `paste(dst, patch, r0, c0, transparent=bg)`
 326:     - Masked paste: `paste(dst, patch, r0, c0, mask=m)`
 327:     - Non-overwriting overlay: `paste(dst, patch, r0, c0, transparent=bg, overwrite=False)`
 328:     - Strict vs clip: default `clip=False` (fail fast); set `clip=True` to clip out-of-bounds.
 329:     """
 330:     H, W = dst.shape
 331:     r0 = int(r0)
 332:     c0 = int(c0)
 333:     h, w = map(int, patch.shape)
 334: 
 335:     if not clip:
 336:         if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
 337:             raise ValueError("paste: patch out of bounds (set clip=True to allow clipping)")
 338:         rr0, cc0 = r0, c0
 339:         rr1, cc1 = r0 + h, c0 + w
 340:         pr0, pc0 = 0, 0
 341:     else:
 342:         rr0 = max(0, r0)
 343:         cc0 = max(0, c0)
 344:         rr1 = min(H, r0 + h)
 345:         cc1 = min(W, c0 + w)
 346:         if rr0 >= rr1 or cc0 >= cc1:
 347:             return dst
 348:         pr0 = rr0 - r0
 349:         pc0 = cc0 - c0
 350: 
 351:     pr1 = pr0 + (rr1 - rr0)
 352:     pc1 = pc0 + (cc1 - cc0)
 353: 
 354:     dst_view = dst[rr0:rr1, cc0:cc1]
 355:     patch_view = patch[pr0:pr1, pc0:pc1]
 356: 
 357:     m = np.ones(patch_view.shape, dtype=bool)
 358:     if mask is not None:
 359:         m &= mask[pr0:pr1, pc0:pc1].astype(bool)
 360:     if transparent is not None:
 361:         m &= (patch_view != int(transparent))
 362:         if not overwrite:
 363:             m &= (dst_view == int(transparent))
 364:     else:
 365:         if not overwrite:
 366:             raise ValueError("paste: overwrite=False requires transparent to be set")
 367: 

