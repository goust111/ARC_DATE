 338:         rr0, cc0 = r0, c0
 339:         rr1, cc1 = r0 + h, c0 + w
 340:         pr0, pc0 = 0, 0
 341:     else:
 342:         rr0 = max(0, r0)
 343:         cc0 = max(0, c0)
 344:         rr1 = min(H, r0 + h)
 345:         cc1 = min(W, c0 + w)
 346:         if rr0 >= rr1 or cc0 >= cc1:
 347:             return dst
 348:         pr0 = rr0 - r0
 349:         pc0 = cc0 - c0
 350: 
 351:     pr1 = pr0 + (rr1 - rr0)
 352:     pc1 = pc0 + (cc1 - cc0)
