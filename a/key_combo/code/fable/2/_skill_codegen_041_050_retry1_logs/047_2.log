+    gate1_a = _sample_mask(width, rng, 1)
+    gate1_b = _sample_mask(width, rng, 1)
+    while np.any(gate1_a & gate1_b):
+        gate1_b = _sample_mask(width, rng, 1)
+    gate1_left = gate1_a
+    gate1_mid = gate1_a | gate1_b
+    gate1_right = empty.copy()
+    gate1_block = [
