+def _apply_gate_rows(a: np.ndarray, b: np.ndarray, gate_colors: np.ndarray) -> np.ndarray:
+    use_union = np.asarray(gate_colors, dtype=int) == BLUE
+    return np.where(use_union[:, None], np.logical_or(a, b), np.logical_xor(a, b))
