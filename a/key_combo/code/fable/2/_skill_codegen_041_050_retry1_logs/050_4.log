+def _detect_shape(patch: np.ndarray, color: int, bg: int) -> int | None:
+    if not np.all((patch == bg) | (patch == color)):
+        return None
+    mask = patch == color
+    for shape_id, template in enumerate(SHAPE_MASKS):
+        if np.array_equal(mask, template):
+            return shape_id
+    return None
