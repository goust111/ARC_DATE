0044:     out = g.copy()
0045:     if same_rows:
0046:         left, right = sorted(comps, key=lambda comp: comp["bbox"][1])
0047:         _lr0, _lc0, _lr1, lc1 = left["bbox"]
0048:         _rr0, rc0, _rr1, _rc1 = right["bbox"]
0049:         gap = rc0 - lc1 - 1
0050:         assert gap >= 1
0051:         span = gap // 2
