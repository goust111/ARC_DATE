+
+def _inward_direction(shape: tuple[int, int], start: Coord) -> Direction:
+    h, w = map(int, shape)
+    r, c = map(int, start)
+    choices: list[Direction] = []
+    if r == 0:
+        choices.append((1, 0))
+    if r == h - 1:
+        choices.append((-1, 0))
+    if c == 0:
+        choices.append((0, 1))
+    if c == w - 1:
+        choices.append((0, -1))
+    assert len(choices) == 1, "start marker must lie on exactly one edge"
+    return choices[0]
