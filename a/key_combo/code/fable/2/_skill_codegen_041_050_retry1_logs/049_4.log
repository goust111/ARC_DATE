+def generate_input() -> np.ndarray:
+    edge, pattern = _scenario()
+    for _ in range(MAX_ATTEMPTS):
+        grid = _build_candidate(edge, pattern)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ray-turn input")

