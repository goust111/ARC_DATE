+
+def _trace_records(
+    grid: np.ndarray,
+) -> tuple[np.ndarray, tuple[Coord, ...], tuple[Coord, ...], tuple[tuple[Coord, Direction], ...]]:
+    g = np.asarray(grid, dtype=int)
