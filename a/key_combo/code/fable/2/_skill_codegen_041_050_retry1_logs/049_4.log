+    ("bottom", "R"),
+    ("left", "LR"),
+    ("right", "RL"),
+    ("top", "LRL"),
+    ("bottom", "RLR"),
+    ("left", "LRRL"),
+    ("right", "RLL"),
+)
+_GEN_COUNTER = 0
