+def _general_distractor_candidates(shape: tuple[int, int], blocked: set[Coord]) -> list[Coord]:
+    h, w = map(int, shape)
+    cells = [
+        (r, c)
+        for r in range(1, h - 1)
+        for c in range(1, w - 1)
+        if (r, c) not in blocked
+    ]
+    random.shuffle(cells)
+    return cells
