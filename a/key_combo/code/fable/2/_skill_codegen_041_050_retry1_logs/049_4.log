+def _render_expected(grid: np.ndarray, start_color: int, painted: set[Coord]) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    for r, c in painted:
+        if int(out[r, c]) != HINGE:
+            out[r, c] = int(start_color)
