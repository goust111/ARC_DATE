+        direction = _inward_direction(shape, pos)
+        if _turn_side(shape, pos, direction) != first_turn:
+            continue
+        if _edge_distance(shape, pos, direction) <= MIN_SEG_LEN:
+            continue
+        candidates.append((pos, direction))
+    if not candidates:
+        return None
+    return random.choice(candidates)
