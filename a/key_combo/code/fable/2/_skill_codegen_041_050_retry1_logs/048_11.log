+    for r in range(h):
+        for c in range(w):
+            if int(g[r, c]) == wall or region_ids[r, c] != -1:
+                continue
+            rid = len(regions)
+            stack = [(int(r), int(c))]
+            region_ids[r, c] = rid
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and region_ids[nr, nc] == -1 and int(g[nr, nc]) != wall:
+                        region_ids[nr, nc] = rid
+                        stack.append((nr, nc))
+            regions.append(coords)
