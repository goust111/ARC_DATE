+def _sample_unique_votes(
+    area: int,
+    majority_color: int,
+    allowed_minor_colors: list[int],
+    rng: np.random.Generator,
+) -> Counter[int] | None:
+    max_noise = min(int(area) - 1, 7)
+    if max_noise < 3 or not allowed_minor_colors:
+        return None
+
+    majority_min = 2 if max_noise == 3 else 3
