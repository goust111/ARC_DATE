+        weights: list[int] = []
+        for idx, (r0, c0, r1, c1) in enumerate(rectangles):
+            rect_height = r1 - r0 + 1
+            rect_width = c1 - c0 + 1
+            area = rect_height * rect_width
+            if rect_height >= 2 * MIN_REGION_SIDE + 1:
+                options.append((idx, "h"))
+                weights.append(area)
+            if rect_width >= 2 * MIN_REGION_SIDE + 1:
+                options.append((idx, "v"))
+                weights.append(area)
