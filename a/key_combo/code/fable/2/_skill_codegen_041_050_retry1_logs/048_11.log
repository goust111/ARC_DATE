+            if 0 < r < h - 1:
+                a = int(region_ids[r - 1, c])
+                b = int(region_ids[r + 1, c])
+                if a >= 0 and b >= 0 and a != b:
+                    shared_lengths[tuple(sorted((a, b)))] += 1
