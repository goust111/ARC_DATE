+            {
+                "patch": patch,
+                "complete": True,
+                "side": gap_meta["side"],
+                "gap_start": gap_meta["gap_start"],
+                "gap_length": gap_meta["gap_length"],
+                "orientation": gap_meta["orientation"],
+                "local_gap": gap_meta["local_gap"],
+            }
+        )
