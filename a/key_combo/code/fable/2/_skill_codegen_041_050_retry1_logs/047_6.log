+        int(bar["color"]),
+        tuple(int(v) for v in bar["bbox"]),
+        bar["orientation"],
+        int(bar["length"]),
+    )
+
+
+def _validate_scene(input_grid: np.ndarray, expected: np.ndarray, locks: list[dict], bars: list[dict]) -> None:
