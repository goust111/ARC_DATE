+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            area = int(coords.shape[0])
+            if h == 1 and area == w:
+                orientation = "horizontal"
+                length = w
+            elif w == 1 and area == h:
+                orientation = "vertical"
+                length = h
+            else:
+                raise AssertionError("each colored object must be a straight one-cell-thick bar")
+            bars.append(
