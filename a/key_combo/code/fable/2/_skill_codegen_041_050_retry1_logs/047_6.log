+        tuple(int(v) for v in lock["bbox"]),
+        bool(lock["complete"]),
+        lock["side"],
+        -1 if lock["gap_start"] is None else int(lock["gap_start"]),
+        int(lock["gap_length"]),
+    )
+
+
+def _bar_signature(bar: dict):
