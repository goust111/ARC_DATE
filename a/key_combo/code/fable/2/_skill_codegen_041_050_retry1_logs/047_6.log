+    assert locks, "expected at least one gray hollow rectangle"
+    return sorted(
+        locks,
+        key=lambda lock: (
+            lock["bbox"],
+            lock["complete"],
+            lock["side"] if lock["side"] is not None else "",
+            -lock["gap_length"],
