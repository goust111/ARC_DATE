+        assert candidates, "shape growth must retain a frontier"
+        candidates.sort(reverse=True)
+        best = candidates[: max(3, len(candidates) // 3)]
+        _neighbors, r, c = random.choice(best)
+        mask[r, c] = True
+
+    for _ in range(random.randint(1, 4)):
