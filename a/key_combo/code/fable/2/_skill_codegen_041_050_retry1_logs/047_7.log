+        odd_count = int(np.count_nonzero(mask & local_even))
+    return even_count, odd_count
+
+
+def _candidate_positions(grid_shape: tuple[int, int], mask_shape: tuple[int, int], desired_parity: int) -> list[tuple[int, int]]:
+    gh, gw = grid_shape
