    return counts, winner


def _gen_blue_count(area, red_count):
    area = int(area)
    red_count = int(red_count)
    teal_over_red = area - 2 * red_count - _GEN_TEAL_MARGIN
    teal_over_blue = (area - red_count - _GEN_TEAL_MARGIN) // 2
