+def _fragment_patch(fragment_cells: set[Coord], color: int) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_of_coords(fragment_cells)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    for r, c in fragment_cells:
