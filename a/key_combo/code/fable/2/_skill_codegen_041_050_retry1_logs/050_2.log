+    r0, c0, r1, c1 = _bbox_of_coords(template)
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    for fragment, cells in zip(fragments, aligned):
+        for r, c in template - cells:
+            rr = r - r0
+            cc = c - c0
