+def _positive_partition(total: int, parts: int, max_part: int) -> list[int] | None:
+    for _ in range(80):
+        values = [1] * parts
+        remaining = total - parts
+        while remaining > 0:
+            idx = random.randrange(parts)
+            if values[idx] >= max_part:
+                continue
+            values[idx] += 1
+            remaining -= 1
+        if max(values) > 1:
+            random.shuffle(values)
+            return values
+    return None
