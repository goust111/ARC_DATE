+def _cells_to_mask(cells: set[Coord] | frozenset[Coord]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_of_coords(cells)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+    return mask
