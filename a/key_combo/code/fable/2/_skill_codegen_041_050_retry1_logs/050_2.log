+            positions[idx] = (r0, c0)
+            rr0 = max(0, r0 - PLACEMENT_PAD)
+            cc0 = max(0, c0 - PLACEMENT_PAD)
+            rr1 = min(h, r0 + ph + PLACEMENT_PAD)
+            cc1 = min(w, c0 + pw + PLACEMENT_PAD)
+            occupied[rr0:rr1, cc0:cc1] = True
