+        "frames": frames,
+        "combs": combs,
+        "matched_signatures": matched_signatures,
+        "unmatched_signatures": unmatched_signatures,
+        "frame_inner_width": frame_inner_width,
+        "bar_width": bar_width,
+    }
+    return scene if _validate_scene(scene) else None
