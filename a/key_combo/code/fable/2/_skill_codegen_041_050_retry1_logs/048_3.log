+                    gap_local_cols = [idx + 1 for idx, value in enumerate(top_inside) if int(value) == bg]
+                    if len(gap_local_cols) < 2 or len(gap_local_cols) == top_inside.size:
+                        continue
+                    if not np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == bg):
+                        continue
