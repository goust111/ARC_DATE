+        return None
+
+    gap_local_cols = [idx + 1 for idx, filled in enumerate(top_inside) if not filled]
+    if len(gap_local_cols) < 2:
+        return None
+
+    return {
+        "kind": "frame",
+        "color": int(comp["color"]),
+        "coords": comp["coords"],
+        "bbox": (r0, c0, r1, c1),
+        "shape": (h, w),
+        "gap_local_cols": gap_local_cols,
+        "gap_abs_cols": [c0 + col for col in gap_local_cols],
