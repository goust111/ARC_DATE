+    seen_bboxes: set[tuple[int, int, int, int]] = set()
+    unique_frames: list[dict] = []
+    for frame in frames:
+        if frame["bbox"] in seen_bboxes:
+            continue
+        seen_bboxes.add(frame["bbox"])
+        unique_frames.append(frame)
+
+    return frame_color, unique_frames
