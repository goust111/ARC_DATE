+
+    mask = _component_mask(comp)
+    if not np.all(mask[:, 0]) or not np.all(mask[:, -1]) or not np.all(mask[-1, :]):
+        return None
+    if not mask[0, 0] or not mask[0, -1]:
+        return None
+    if not np.all(~mask[1:-1, 1:-1]):
