+                    frames.append(
+                        {
+                            "kind": "frame",
+                            "color": frame_color,
+                            "bbox": (r0, c0, r1, c1),
+                            "shape": (r1 - r0 + 1, c1 - c0 + 1),
+                            "gap_local_cols": gap_local_cols,
+                            "gap_abs_cols": [c0 + col for col in gap_local_cols],
+                            "signature": _relative_signature(gap_local_cols),
+                        }
+                    )
