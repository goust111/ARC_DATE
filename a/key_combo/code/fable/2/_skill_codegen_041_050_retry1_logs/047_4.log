+
+    if meta["transform"] != transform:
+        return False
+    if meta["source_color"] != int(source_color) or meta["image_color"] != int(image_color):
+        return False
+    if _orbit_keys(source_mask) != source_orbit:
+        return False
+    if _orbit_keys(target_mask) != target_orbit:
+        return False
