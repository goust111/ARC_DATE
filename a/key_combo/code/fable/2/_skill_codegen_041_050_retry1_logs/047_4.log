+    "rot180",
+    "rot270",
+    "flip",
+    "flip_rot90",
+    "flip_rot180",
+    "flip_rot270",
+)
+NON_ID_TRANSFORMS = TRANSFORMS[1:]
+
+GEN_MAX_ATTEMPTS = 500
+GRID_ROWS = (18, 26)
