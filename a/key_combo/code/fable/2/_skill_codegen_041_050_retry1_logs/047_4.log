+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        built = _generate_case()
+        if built is None:
+            continue
+        grid, _expected = built
+        return grid
+    raise RuntimeError("failed to generate a valid who-mirrors-whom ARC input")

