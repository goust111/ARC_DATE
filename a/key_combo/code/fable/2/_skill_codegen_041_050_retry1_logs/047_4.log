+def _next_transform() -> str:
+    global _TRANSFORM_CYCLE
+    if not _TRANSFORM_CYCLE:
+        _TRANSFORM_CYCLE = list(NON_ID_TRANSFORMS)
+        random.shuffle(_TRANSFORM_CYCLE)
+    return _TRANSFORM_CYCLE.pop()
