+    if len(_RECENT_OUTPUT_SIGS) > RECENT_OUTPUT_LIMIT:
+        del _RECENT_OUTPUT_SIGS[0]
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    *,
+    transform: str,
+    source_color: int,
+    image_color: int,
+    source_orbit: set[tuple[tuple[int, int], bytes]],
+    target_orbit: set[tuple[tuple[int, int], bytes]],
+    expected: np.ndarray,
+) -> bool:
