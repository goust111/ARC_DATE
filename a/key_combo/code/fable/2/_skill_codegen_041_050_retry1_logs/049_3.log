+            out[top, c0 : c1 + 1] = int(ring_color)
+        if 0 <= bottom < h:
+            out[bottom, c0 : c1 + 1] = int(ring_color)
+        if 0 <= left < w:
+            out[r0 : r1 + 1, left] = int(ring_color)
+        if 0 <= right < w:
+            out[r0 : r1 + 1, right] = int(ring_color)
