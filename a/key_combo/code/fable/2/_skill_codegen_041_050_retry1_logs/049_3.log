+    elif side == "bottom":
+        row = cr + radius
+        if not (0 <= row < h):
+            return None
+        lo = max(0, cc - radius + 1)
+        hi = min(w - 1, cc + radius - 1)
+        orientation, fixed = "h", row
+    elif side == "left":
