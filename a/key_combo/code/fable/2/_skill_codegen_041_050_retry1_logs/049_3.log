+
+def _center_is_uniquely_known(
+    shape: tuple[int, int],
+    segments: list[dict],
+    color: int,
+    center: tuple[int, int],
+) -> bool:
+    sols = _subset_solutions(shape, segments, color)
+    return len(sols) == 1 and sols[0][0] == center
