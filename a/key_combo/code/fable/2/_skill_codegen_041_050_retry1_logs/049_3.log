+def _choose_fragment(run: dict, center: tuple[int, int]) -> dict:
+    axis_center = int(center[1] if run["orientation"] == "h" else center[0])
+    lo = int(run["lo"])
+    hi = int(run["hi"])
+    run_len = hi - lo + 1
