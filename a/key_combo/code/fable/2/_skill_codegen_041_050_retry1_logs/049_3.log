+def _semantic_checks(
+    shape: tuple[int, int],
+    segments: list[dict],
+    color: int,
+    center: tuple[int, int],
+    radii: tuple[int, ...],
+) -> bool:
+    if len(segments) < 3 or len(radii) < 2:
