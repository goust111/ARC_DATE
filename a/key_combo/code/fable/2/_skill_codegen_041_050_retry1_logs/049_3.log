+
+def _solve_puzzle(grid: np.ndarray) -> tuple[tuple[int, int], tuple[int, ...], int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    assert max(g.shape) <= 30
