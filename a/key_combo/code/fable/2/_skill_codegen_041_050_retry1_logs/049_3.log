+def _render_output(shape: tuple[int, int], center: tuple[int, int], radii: tuple[int, ...], ring_color: int) -> np.ndarray:
+    h, w = map(int, shape)
+    cr, cc = map(int, center)
+    out = np.full((h, w), BG, dtype=int)
+    for d in radii:
+        top = cr - d
+        bottom = cr + d
+        left = cc - d
+        right = cc + d
+        c0 = max(0, left)
+        c1 = min(w - 1, right)
