0035: 
0036: def _gen_attempt() -> np.ndarray | None:
0037:     h = np.random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE + 1)
0038:     w = np.random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE + 1)
0039:     color = np.random.randint(MIN_FOREGROUND_COLOR, MAX_FOREGROUND_COLOR + 1)
