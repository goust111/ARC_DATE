+def _ring_is_clipped(shape: tuple[int, int], center: tuple[int, int], radius: int) -> bool:
+    h, w = map(int, shape)
+    cr, cc = map(int, center)
+    return cr - radius < 0 or cr + radius >= h or cc - radius < 0 or cc + radius >= w
