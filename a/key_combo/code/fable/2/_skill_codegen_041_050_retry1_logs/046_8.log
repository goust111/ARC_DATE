+    p, q = tile.shape
+    rows = (np.arange(shape[0]) + int(shift[0])) % p
+    cols = (np.arange(shape[1]) + int(shift[1])) % q
+    hidden_mask = np.zeros(shape, dtype=bool)
+    for rr, cc in hidden:
+        hidden_mask |= (rows[:, None] == int(rr)) & (cols[None, :] == int(cc))
