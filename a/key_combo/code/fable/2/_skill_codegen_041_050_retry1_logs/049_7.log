+                "frame_bbox": (fr0, fc0, fr1, fc1),
+                "rect_bbox": tuple(map(int, rect["bbox"])),
+                "area": area,
+                "inner_w": inner_w,
+                "interior_h": interior_h,
+                "fill_h": fill_h,
+                "rect_h": int(rect["bbox"][2] - rect["bbox"][0] + 1),
+                "rect_w": int(rect["bbox"][3] - rect["bbox"][1] + 1),
