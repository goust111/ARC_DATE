+
+def _describe_object(grid: np.ndarray, coords: np.ndarray, bg: int) -> dict[str, object]:
+    bbox = _bbox_coords(coords)
+    r0, c0, _r1, _c1 = bbox
+    crop = _crop_bbox(grid, bbox)
+    local = coords - np.array([r0, c0], dtype=int)
