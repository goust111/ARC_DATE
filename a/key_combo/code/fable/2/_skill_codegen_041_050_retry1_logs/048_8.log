import itertools, random
import numpy as np

def corners(mask):
    m=np.pad(mask.astype(int),1)
    cnt=0
    for r in range(m.shape[0]-1):
        for c in range(m.shape[1]-1):
            s=m[r:r+2,c:c+2].sum()
            if s in (1,3):
                cnt+=1
    return cnt

def has_hole(mask):
    h,w=mask.shape
    bg=~mask
    seen=np.zeros_like(mask,dtype=bool)
    from collections import deque
    q=deque()
    for r in range(h):
        for c in (0,w-1):
            if bg[r,c] and not seen[r,c]:
                seen[r,c]=True;q.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if bg[r,c] and not seen[r,c]:
                seen[r,c]=True;q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and bg[rr,cc] and not seen[rr,cc]:
                seen[rr,cc]=True;q.append((rr,cc))
    return int(np.any(bg & ~seen))

bases=[]
# rectangles
for h in range(2,5):
  for w in range(2,6):
    m=np.ones((h,w),dtype=bool)
    bases.append((f'rect{h}x{w}',m))
for h in range(3,6):
  for w in range(3,6):
    for t in (1,2):
      if t>=min(h,w):
        continue
      m=np.zeros((h,w),dtype=bool)
      m[:, :t]=True
      m[-t:, :]=True
      bases.append((f'L{h}x{w}t{t}',m))
for h in range(3,6):
  for w in range(3,7,2):
    stem=max(1,w//3)
    m=np.zeros((h,w),dtype=bool)
    m[0,:]=True
    c0=(w-stem)//2
    m[:,c0:c0+stem]=True
    bases.append((f'T{h}x{w}',m))
for h in range(3,6):
  for w in range(3,6):
    m=np.ones((h,w),dtype=bool); m[1:-1,1:-1]=False
    bases.append((f'ring{h}x{w}',m))
for h,w in [(3,5),(4,5),(5,5)]:
    m=np.zeros((h,w),dtype=bool)
    m[0,:3]=True; m[1:,:1]=True; m[h-1,2:]=True; m[:h-1,4]=True
    bases.append((f'U{h}x{w}',m))

pool=[]
for name,m in bases:
  area=int(m.sum())
  bends=corners(m)
  hole=has_hole(m)
  for color_count in (1,2,3):
    pool.append({'name':name,'area':area,'bends':bends,'hole':hole,'color_count':color_count})

DIMS=['area','bends','hole','color_count']

def valid_outlier(items, dim):
  vals=[it[dim] for it in items]
  uniq=sorted(set(vals))
  if len(uniq)"'!=2:
    return None
  counts={v:vals.count(v) for v in uniq}
  singleton=[v for v,c in counts.items() if c==1]
  common=[v for v,c in counts.items() if c==len(vals)-1]
  if len(singleton)==1 and len(common)==1:
    return vals.index(singleton[0])
  return None

solutions=0
