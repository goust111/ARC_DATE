+def _random_transform(mask: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = np.asarray(mask, dtype=bool)
+    if int(rng.integers(2)):
+        out = np.fliplr(out)
+    return np.rot90(out, int(rng.integers(4))).copy()
