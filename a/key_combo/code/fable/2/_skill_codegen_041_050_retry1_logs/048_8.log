+    holespace = ~filled
+    if not holespace.any():
+        return 0
+
+    h, w = holespace.shape
+    seen = np.zeros_like(holespace, dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if holespace[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if holespace[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and holespace[rr, cc] and not seen[rr, cc]:
