+
+def _build_shape_library() -> list[dict[str, object]]:
+    shapes: list[dict[str, object]] = []
+
+    for h in range(2, 5):
+        for w in range(2, 6):
+            shapes.append({"family": "rect", "name": f"rect_{h}x{w}", "mask": _rect(h, w)})
