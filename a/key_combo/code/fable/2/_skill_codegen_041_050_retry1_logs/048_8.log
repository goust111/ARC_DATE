+def _rect(h: int, w: int) -> np.ndarray:
+    return np.ones((h, w), dtype=bool)
+
+
+def _l_shape(h: int, w: int, thickness: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[:, :thickness] = True
+    mask[-thickness:, :] = True
+    return mask
+
+
+def _t_shape(h: int, w: int) -> np.ndarray:
+    stem = max(1, w // 3)
+    c0 = (w - stem) // 2
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[:, c0 : c0 + stem] = True
+    return mask
+
