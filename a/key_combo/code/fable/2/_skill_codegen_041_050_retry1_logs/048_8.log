+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            parts.append(np.asarray(coords, dtype=int))
+    return parts
+
+
+def _count_bends(mask: np.ndarray) -> int:
+    padded = np.pad(np.asarray(mask, dtype=int), 1)
+    quad_sums = padded[:-1, :-1] + padded[:-1, 1:] + padded[1:, :-1] + padded[1:, 1:]
+    return int(np.count_nonzero((quad_sums == 1) | (quad_sums == 3)))
+
+
+def _has_hole(mask: np.ndarray) -> int:
+    filled = np.asarray(mask, dtype=bool)
+    holespace = ~filled
+    if not holespace.any():
+        return 0
+
+    h, w = holespace.shape
+    seen = np.zeros_like(holespace, dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if holespace[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if holespace[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and holespace[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                queue.append((rr, cc))
