+
+def _ordered_coords(mask: np.ndarray, mode: int) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if mode == 0:
+        order = np.lexsort((coords[:, 1], coords[:, 0]))
+    elif mode == 1:
