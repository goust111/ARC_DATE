+    for h, w in ((3, 5), (4, 5), (5, 5)):
+        shapes.append({"family": "U", "name": f"U_{h}x{w}", "mask": _u_shape(h, w)})
+
+    for i, shape in enumerate(shapes):
+        mask = np.asarray(shape["mask"], dtype=bool)
+        shape["base_index"] = i
+        shape["area"] = int(mask.sum())
