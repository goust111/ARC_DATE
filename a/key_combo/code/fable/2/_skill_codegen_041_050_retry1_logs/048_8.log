+def _ring(h: int, w: int) -> np.ndarray:
+    mask = np.ones((h, w), dtype=bool)
+    mask[1:-1, 1:-1] = False
+    return mask
+
+
+def _u_shape(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :3] = True
+    mask[1:, 0] = True
+    mask[-1, 2:] = True
+    mask[:-1, -1] = True
+    return mask
