  # second target not already singled on full set by any dim
  target_idx=[j for j in range(5) if j!=i1][j2]
  bad=False
  for d in DIMS:
    oi=valid_outlier(items,d)
    if oi==target_idx:
      bad=True
  if bad: continue
  solutions+=1
  if solutions<8:
    print('"'sol',d1,i1,'->',d2,target_idx,[(it['name'],it['area'],it['bends'],it['hole'],it['color_count']) for it in items])
