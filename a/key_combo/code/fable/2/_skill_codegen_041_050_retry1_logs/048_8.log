+            rr1 = min(height, r0 + h + PLACEMENT_GAP)
+            cc1 = min(width, c0 + w + PLACEMENT_GAP)
+            blocked[rr0:rr1, cc0:cc1] = True
+            placements[i] = (r0, c0)
