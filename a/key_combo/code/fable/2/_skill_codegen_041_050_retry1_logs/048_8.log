+def _extract_objects(grid: np.ndarray) -> tuple[int, list[dict[str, object]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    objects = [_describe_object(g, coords, bg) for coords in _components(g != bg)]
+    return bg, objects
