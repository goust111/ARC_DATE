+
+
+def _semantic_check(grid: np.ndarray, expected_first: str, expected_second: str, object_count: int) -> bool:
+    bg, objects = _extract_objects(grid)
+    if bg != BACKGROUND:
+        return False
+    if len(objects) != object_count:
