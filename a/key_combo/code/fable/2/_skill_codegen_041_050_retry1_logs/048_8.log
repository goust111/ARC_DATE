+    target = objects[target_idx]
+    if any(_count_same_value(objects, key, target_idx) == 1 for key in FEATURE_KEYS):
+        return False
+    if sum(obj["crop"].shape == target["crop"].shape for obj in objects) < 2:
+        return False
