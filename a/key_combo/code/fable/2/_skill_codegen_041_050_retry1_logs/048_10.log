+def _gen_attempt() -> np.ndarray | None:
+    specs = _sample_specs()
+    if specs is None:
+        return None
+
+    total_scatter = sum(_spec_capacity(spec) for spec in specs)
+    reserve_area = sum((spec["inner_h"] + 4) * (spec["inner_w"] + 4) for spec in specs)
