+def _place_frames(
+    shape: tuple[int, int],
+    specs: list[dict],
+    body_color: int,
+    marker_color: int,
+) -> tuple[np.ndarray, list[dict]] | None:
+    h, w = shape
+    grid = np.full((h, w), BG, dtype=int)
+    occupied = np.zeros((h, w), dtype=int)
+    records = [None] * len(specs)
+
+    order = sorted(
+        range(len(specs)),
+        key=lambda idx: (specs[idx]["inner_h"] + 2) * (specs[idx]["inner_w"] + 2),
+        reverse=True,
+    )
+    for idx in order:
+        spec = specs[idx]
