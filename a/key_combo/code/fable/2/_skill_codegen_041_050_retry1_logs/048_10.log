+    items.sort(key=lambda item: _spec_capacity(item[1]), reverse=True)
+    for color, record in items:
+        capacity = _spec_capacity(record)
+        for _ in range(capacity):
+            candidates = np.argwhere((out == BG) & ~forbidden)
