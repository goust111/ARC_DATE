+from __future__ import annotations
+
+from collections import Counter
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(ARC_UTILS_DIR))
+
+from arc_utils import Color, crop_bbox, find_components, get_bg, paste, random_free_location
+
+
+BG = Color.BLACK
+BLOCK_COLOR = Color.GREY
+CORNER_TO_LOCAL = {
+    0: (0, 0),   # top-left
+    1: (0, -1),  # top-right
+    2: (-1, 0),  # bottom-left
+    3: (-1, -1),  # bottom-right
+}
+HIGH_PHASE_CORNERS = (0, 3)
+LOW_PHASE_CORNERS = (1, 2)
+
+FRAME_COUNT_RANGE = (3, 5)
+PAIR_ODD_SIDES = (3, 5)
+EXTRA_SIDE_RANGE = (3, 6)
+MAX_GENERATION_ATTEMPTS = 500
+MAX_EXTRA_SPEC_ATTEMPTS = 120
