+from __future__ import annotations
+
+from collections import Counter
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(ARC_UTILS_DIR) not in sys.path:
