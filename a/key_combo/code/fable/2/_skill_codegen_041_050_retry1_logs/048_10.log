+        occupied[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = 1
+        paste(grid, patch, r0, c0, transparent=BG)
+        records[idx] = {
+            **spec,
+            "bbox": (int(r0), int(c0), int(r0 + patch.shape[0] - 1), int(c0 + patch.shape[1] - 1)),
+        }
