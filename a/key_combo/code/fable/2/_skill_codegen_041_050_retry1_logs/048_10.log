+        r0, c0, r1, c1 = record["bbox"]
+        fill_mask = _phase_mask(record["inner_h"], record["inner_w"], record["corner_idx"]) & ~record["blocked_mask"]
+        out[r0 + 1 : r1, c0 + 1 : c1][fill_mask] = int(color)
+    return out
