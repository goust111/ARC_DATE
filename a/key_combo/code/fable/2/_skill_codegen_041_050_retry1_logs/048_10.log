+def _variant_differs(grid: np.ndarray, expected: np.ndarray, **kwargs) -> bool:
+    try:
+        variant = _solve_grid(grid, **kwargs)
+    except AssertionError:
+        return True
+    return not np.array_equal(variant, expected)
