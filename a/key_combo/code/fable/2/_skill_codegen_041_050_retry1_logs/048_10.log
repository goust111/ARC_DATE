+BG = Color.BLACK
+BLOCK_COLOR = Color.GREY
+CORNER_TO_LOCAL = {
+    0: (0, 0),   # top-left
+    1: (0, -1),  # top-right
+    2: (-1, 0),  # bottom-left
+    3: (-1, -1),  # bottom-right
+}
