+        "inner_h": int(inner_h),
+        "inner_w": int(inner_w),
+        "corner_idx": int(corner_idx),
+        "blocked_local": tuple(sorted(chosen_active + chosen_inactive)),
+        "blocked_mask": blocked_mask,
+        "active_blocks": int(active_blocks),
+        "inactive_blocks": int(inactive_blocks),
