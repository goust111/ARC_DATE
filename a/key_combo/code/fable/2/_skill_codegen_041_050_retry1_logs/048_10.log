+def _render_expected(grid: np.ndarray, records: list[dict], fill_colors: list[int]) -> np.ndarray:
+    out = grid.copy()
+    bbox_mask = np.zeros_like(out, dtype=bool)
+    for record in records:
+        r0, c0, r1, c1 = record["bbox"]
+        bbox_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    out[~bbox_mask] = BG
+
