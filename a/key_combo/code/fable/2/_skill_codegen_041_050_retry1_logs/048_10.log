+    inactive_cells = [tuple(map(int, coord)) for coord in np.argwhere(~phase)]
+    chosen_active = _pick_cells(active_cells, active_blocks)
+    chosen_inactive = _pick_cells(inactive_cells, inactive_blocks)
+
