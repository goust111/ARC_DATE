+    grid = np.full((small_h * BLOCK_SIZE, small_w * BLOCK_SIZE), BACKGROUND, dtype=int)
+
+    for r, c, color, (dr, dc) in assignments:
+        r0 = int(r) * BLOCK_SIZE
+        c0 = int(c) * BLOCK_SIZE
+        grid[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE] = int(color)
+        grid[r0 + 1 + int(dr), c0 + 1 + int(dc)] = GREY
+
+    return grid
