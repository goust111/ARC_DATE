+
+            rr = r + dr
+            cc = c + dc
+            if not (0 <= rr < small_h and 0 <= cc < small_w):
+                continue
+
+            dst = (rr, cc)
+            if dst in destinations:
+                continue
+            if dst != (r, c) and dst in occupied:
+                continue
+            candidates.append((r, c))
+
+        if not candidates:
+            return None
+
+        r, c = candidates[int(rng.integers(len(candidates)))]
+        dst = (r + dr, c + dc)
+        sources.append((r, c))
+        occupied.add((r, c))
+        if dst != (r, c):
