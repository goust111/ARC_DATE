+    out = np.full_like(compressed, bg)
+    small_h, small_w = compressed.shape
+
+    for r, c, color, dr, dc in movers:
+        rr = r + dr
+        cc = c + dc
+        assert 0 <= rr < small_h and 0 <= cc < small_w, "movement must stay inside the compressed grid"
