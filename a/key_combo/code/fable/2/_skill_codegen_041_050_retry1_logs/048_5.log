# Canvas and object size bounds.
GEN_INTERIOR_SIZES = [3, 4, 5]
GEN_CANVAS_HEIGHTS = [14, 15, 16]
GEN_CANVAS_WIDTHS = [15, 16]
GEN_MIN_FRAME_MASK_GAP = 3

# Palette.
GEN_BACKGROUND = 0
GEN_MASK_COLOR = 8
GEN_SIDE_COLOR_POOL = list(range(1, 8))

# Mask structure.
