            )

            r0, r1 = row_ranges[missing_r]
            c0, c1 = col_ranges[missing_c]
            assert np.all(out[r0 : r1 + 1, c0 : c1 + 1] == bg), "target cell must be empty"
            out[r0 : r1 + 1, c0 : c1 + 1] = pred

