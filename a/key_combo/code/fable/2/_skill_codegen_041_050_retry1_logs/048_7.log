+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(GRID_MIN_SIDE, GRID_MAX_SIDE + 1))
+    w = int(rng.integers(GRID_MIN_SIDE, GRID_MAX_SIDE + 1))
+    grid = np.full((h, w), BACKGROUND, dtype=int)
