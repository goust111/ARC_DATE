+BACKGROUND = 0
+ARROW_COLOR = 2
+BODY_COLOR = 3
+EDGE_COLOR_POOL = np.array([1, 4, 5, 6, 7, 8, 9], dtype=int)
+
+SIDES = ("top", "right", "bottom", "left")
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
