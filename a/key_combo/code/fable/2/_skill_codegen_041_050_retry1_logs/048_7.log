+    for index in range(len(pointers)):
+        _resolve_pointer_color(pointers, index, set())
+
+    return {
+        "bg": int(bg),
+        "side_colors": side_colors,
+        "pointers": pointers,
+    }
+
+
+def _render_output(grid: np.ndarray, analysis: dict[str, object]) -> np.ndarray:
