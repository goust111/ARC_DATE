+    side_colors: dict[str, int] = {}
+    for side, segment in side_slices.items():
+        assert segment.size > 0, "border side segment must be non-empty"
+        color = int(segment[0])
+        assert np.all(segment == color), f"{side} edge segment must be uniform"
