def _gen_place_frames(output: np.ndarray, frames: list[dict[str, object]]) -> bool:
    occupied = np.zeros(output.shape, dtype=bool)
    for frame in sorted(frames, key=lambda f: int(f["ih"]) * int(f["iw"]), reverse=True):
