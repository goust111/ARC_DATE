+
+
+def _analyze_scene(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= 30, "ARC grids must fit within 30x30"
