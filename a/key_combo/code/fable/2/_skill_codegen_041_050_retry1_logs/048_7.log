+def _paint_edges(grid: np.ndarray, side_colors: dict[str, int]) -> None:
+    grid[0, 1:-1] = int(side_colors["top"])
+    grid[-1, 1:-1] = int(side_colors["bottom"])
+    grid[1:-1, 0] = int(side_colors["left"])
+    grid[1:-1, -1] = int(side_colors["right"])
