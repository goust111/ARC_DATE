+        c = int(bc + 2 * dc)
+        side = DIR_TO_SIDE[(int(dr), int(dc))]
+
+        while _in_bounds(grid.shape, r, c):
+            color = int(grid[r, c])
+            if color == bg:
+                r += int(dr)
+                c += int(dc)
+                continue
+
+            coord = (int(r), int(c))
+            if coord in cell_to_pointer:
