+    above = [r for r in range(0, r0 - 1)]
+    below = [r for r in range(r1 + 2, h)]
+    if above and random.random() < 0.6:
+        full_rows.add(random.choice(above))
+    if below and random.random() < 0.6:
+        full_rows.add(random.choice(below))
