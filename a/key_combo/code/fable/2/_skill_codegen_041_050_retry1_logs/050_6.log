+            full_v_cols.add(int(c))
+
+    left: list[dict[str, int]] = []
+    right: list[dict[str, int]] = []
+    top: list[dict[str, int]] = []
+    bottom: list[dict[str, int]] = []
+
+    for r in range(h):
+        if r in full_h_rows:
+            continue
+        if g[r, 0] != bg:
