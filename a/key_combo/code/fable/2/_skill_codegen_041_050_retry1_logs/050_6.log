+def _build_horizontal_case() -> tuple[np.ndarray, np.ndarray]:
+    h = random.randint(10, 18)
+    w = random.randint(12, 24)
+    rect_h = random.randint(3, 5)
+    rect_w = random.randint(3, min(8, w - 4))
