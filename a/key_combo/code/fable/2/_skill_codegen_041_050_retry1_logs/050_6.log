+    for c in range(w):
+        if c in full_v_cols:
+            continue
+        if g[0, c] != bg:
+            color = int(g[0, c])
+            r = 0
+            while r + 1 < h and int(g[r + 1, c]) == color:
+                r += 1
+            if r < h - 1 and int(g[r + 1, c]) == bg:
+                top.append({"col": int(c), "end": int(r), "color": color})
+        if g[h - 1, c] != bg:
