+def _candidate_rectangles_from_rays(grid: np.ndarray, rays: dict[str, list[dict[str, int]]] | None = None) -> list[tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    rays = _parse_rays(g) if rays is None else rays
