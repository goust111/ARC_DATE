+    rows = list(range(r0, r1 + 1))
+    left_rows = {r0}
+    right_rows = {r1}
+    inner_rows = [r for r in rows if r not in left_rows | right_rows]
+    random.shuffle(inner_rows)
+    for r in inner_rows:
+        choice = random.choice(("left", "right", "none"))
