EDGE_DIRS = {
    'TL': ((+1, 0), (0, +1)),
    'TR': ((+1, 0), (0, -1)),
    'BL': ((-1, 0), (0, +1)),
    'BR': ((-1, 0), (0, -1)),
}
# Outward-from-corner directions; cells here must not be 0 (guards mid-edge false positives).
OUT_DIRS = {
    'TL': ((-1, 0), (0, -1)),
    'TR': ((-1, 0), (0, +1)),
    'BL': ((+1, 0), (0, -1)),
    'BR': ((+1, 0), (0, +1)),
