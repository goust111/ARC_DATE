+        "panel": panel.copy(),
+    }
+
+
+def _extract_problem(grid: np.ndarray) -> tuple[dict, np.ndarray]:
+    mode, idx, divider = _find_separator(grid)
+    if mode == "row":
+        parts = [grid[:idx, :], grid[idx + 1 :, :]]
