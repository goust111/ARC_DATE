+    if chosen[0][1] == chosen[1][1]:
+        chosen[1] = (chosen[1][0], (chosen[1][1] + 1) % side)
+    if chosen[0] == chosen[1]:
+        chosen[1] = ((chosen[1][0] + 1) % side, (chosen[1][1] + 2) % side)
+    return chosen
