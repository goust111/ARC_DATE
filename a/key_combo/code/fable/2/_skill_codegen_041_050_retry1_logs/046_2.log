+    coords = np.argwhere(source != BG)
+    values = [int(source[r, c]) for r, c in coords]
+    permuted = np.zeros_like(source)
+    shifted_coords = np.roll(coords, shift=1, axis=0)
+    for (r, c), value in zip(shifted_coords, values):
