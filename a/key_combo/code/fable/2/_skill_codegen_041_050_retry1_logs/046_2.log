    source_mask = g[sr0 : sr1 + 1, sc0 : sc1 + 1] == source_color
    out = g.copy()
    out_dest = out[sr0 : sr1 + 1, dst_c0 : dst_c1 + 1]
    out_dest[np.fliplr(source_mask)] = source_color
    return out

