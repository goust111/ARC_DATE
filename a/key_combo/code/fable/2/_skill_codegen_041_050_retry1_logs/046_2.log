+    else:
+        parts = [grid[:, :idx], grid[:, idx + 1 :]]
+    assert all(part.size > 0 for part in parts), "separator must split the grid into two non-empty sides"
+
+    parsed = [_try_parse_lattice(part, divider) for part in parts]
+    good = [i for i, item in enumerate(parsed) if item is not None]
+    assert len(good) == 1, "expected exactly one lattice side"
+
+    lattice = parsed[good[0]]
+    assert lattice is not None
+    source = np.asarray(parts[1 - good[0]], dtype=int)
+    assert source.ndim == 2 and source.shape[0] == source.shape[1], "source panel must be square"
+    assert source.shape[0] > 0, "source panel must be non-empty"
+    assert not np.any(source == int(divider)), "divider color must not appear inside the source panel"
+    return lattice, source
