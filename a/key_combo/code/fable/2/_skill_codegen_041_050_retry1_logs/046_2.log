+    return permuted
+
+
+def _validate_semantics(grid: np.ndarray) -> None:
+    lattice, source = _extract_problem(grid)
+    missing_mask = lattice["missing_mask"]
+    present_masks = lattice["present_masks"]
+    correct = _stamp_from_source(missing_mask, source)
