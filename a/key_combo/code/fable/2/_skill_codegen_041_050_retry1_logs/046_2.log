+        if bits == (1 << area) - 1:
+            continue
+        mask = np.zeros((cell_size, cell_size), dtype=bool)
+        for idx in range(area):
+            if bits & (1 << idx):
+                r, c = divmod(idx, cell_size)
+                mask[r, c] = True
+        if len(components_mask(mask, connectivity=4)) != 1:
+            continue
+        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
