+    distractor_count = random.randint(2, 4)
+    distractor_patch = _make_distractor(sprite, body_colors)
+    for _ in range(distractor_count):
+        pos = _random_position((h, w), distractor_patch.shape, placed_boxes)
+        if pos is None:
