    anchor_top, displaced_tops = top_choice

    colors = _gen_colors(count)
    inp, out = _gen_render_grids(rows, cols, mask, colors, lefts, anchor_top, displaced_tops)

    if np.array_equal(main(inp), out):
        return inp
    return None

