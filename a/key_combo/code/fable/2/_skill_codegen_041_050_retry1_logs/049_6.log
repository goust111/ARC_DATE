        int(color): _multi_source_distances(adjacency, set(nodes))
        for color, nodes in sources_by_color.items()
    }
    owners: dict[Coord | int, int] = {}
    meta: dict[Coord | int, tuple[str, int | None, tuple[int, ...]]] = {}

