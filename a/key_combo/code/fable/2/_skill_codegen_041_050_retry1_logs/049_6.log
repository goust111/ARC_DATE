+    out = np.array(g, copy=True)
+    out[info["marker_mask"]] = int(info["bg"])
+    labels = info["labels"]
+    for comp, color in owners.items():
+        if int(color) != GREY:
+            out[labels == int(comp)] = int(color)
+    return out
