            owners[node] = GREY
            meta[node] = ("unreachable", None, ())
        elif len(best_colors) == 1:
            owners[node] = int(best_colors[0])
            meta[node] = ("unique", int(best_dist), tuple(best_colors))
        else:
            owners[node] = GREY
            meta[node] = ("tie", int(best_dist), tuple(sorted(best_colors)))

