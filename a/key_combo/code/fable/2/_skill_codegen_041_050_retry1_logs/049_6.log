+            int(colors[0]): {main_path[0]},
+            int(colors[1]): {main_path[-1]},
+        }
+
+        adjacency = _graph_adjacency(occupied)
+        owners, meta = _resolve_ownership(adjacency, sources_by_color)
+        center = main_path[len(main_path) // 2]
