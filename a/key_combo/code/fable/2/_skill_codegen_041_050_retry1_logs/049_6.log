+        assert meta[isolated][0] == "unreachable"
+        assert any(
+            meta[node][0] == "unique" and meta[node][1] is not None and int(meta[node][1]) > 0
+            for node in occupied
+        )
+        assert any(int(color) != GREY for color in owners.values())
