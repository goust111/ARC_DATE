+def _generate_main_path() -> list[Coord]:
+    target_len = int(random.choice(MAIN_LENGTHS))
+    for _ in range(MAX_PATH_ATTEMPTS):
+        path = [(0, 0)]
+        used = {(0, 0)}
+        if _extend_simple_diag_path(path, used, target_len):
+            return path
