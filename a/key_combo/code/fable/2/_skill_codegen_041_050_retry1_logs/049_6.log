+        for c in range(min(cols) - 4, max(cols) + 5):
+            node = (r, c)
+            if (r + c) % 2 != 0:
+                continue
+            if node in occupied:
+                continue
+            if any(_diag_adj(node, other) for other in occupied):
+                continue
