    for rectangle, (r, c) in rectangles:
        # num_lines = np.random.randint(1, 4)
        num_lines = 0
        directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        indices = np.random.choice(len(directions), num_lines, replace=False)
        directions = [directions[i] for i in indices]

