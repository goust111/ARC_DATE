+        output_intervals = [seg["output_indices"] for seg in segments]
+        if not _indices_overlap_free(input_intervals, ring_len, require_gap=True):
+            continue
+        if not _indices_overlap_free(output_intervals, ring_len, require_gap=True):
+            continue
