+def _indices_overlap_free(intervals: list[list[int]], ring_len: int, *, require_gap: bool) -> bool:
+    owner = np.full(int(ring_len), -1, dtype=int)
+    for seg_id, interval in enumerate(intervals):
+        for idx in interval:
