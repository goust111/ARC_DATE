+    try:
+        scene = _extract_scene(grid)
+        out = _scene_output(scene)
+        if out is None:
+            return None
+        if not _scene_is_semantic(scene, out):
+            return None
+        if not np.array_equal(main(grid), out):
+            return None
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random
