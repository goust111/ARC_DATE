+
+def _render_shifted(scene: dict, shift_by_color: dict[int, int]) -> np.ndarray | None:
+    out = np.full(scene["shape"], BG, dtype=int)
+    ring = scene["ring"]
+    ring_len = int(scene["ring_len"])
+    for seg in scene["segments"]:
