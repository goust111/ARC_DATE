                    for dr, dc in DIR4:
                        nr = int(r + dr)
                        nc = int(c + dc)
                        if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
                            frontier.append((nr, nc))
                if not frontier:
                    break
                cells.add(rng.choice(frontier))
            if len(cells) != area:
                continue
            mask = np.zeros((h, w), dtype=bool)
            for r, c in cells:
                mask[int(r), int(c)] = True
