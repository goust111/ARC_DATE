+
+def _random_composition(total: int, parts: int, rng: random.Random) -> list[int]:
+    if parts == 1:
+        return [int(total)]
+    bars = sorted(rng.sample(range(total + parts - 1), parts - 1))
+    out: list[int] = []
+    prev = -1
+    for bar in bars + [total + parts - 1]:
+        out.append(int(bar - prev - 1))
+        prev = int(bar)
+    return out
