+                "color": int(color),
+                "start": int(ordered[0]),
+                "length": int(len(ordered)),
+                "ordered_indices": [int(x) for x in ordered],
+                "area": int(coords.shape[0]),
+                "bbox": box,
+                "bbox_area": bbox_area,
+                "object_coords": coords.astype(int),
+                "irregular": int(coords.shape[0]) < bbox_area,
