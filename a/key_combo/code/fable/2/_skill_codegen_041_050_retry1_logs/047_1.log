+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 800
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, np.unique(grid)))
+    if exclude is not None:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> np.ndarray:
+    h, w = patch.shape
+    view = dst[int(r0) : int(r0) + h, int(c0) : int(c0) + w]
+    if transparent is None:
+        view[...] = patch
+    else:
+        mask = patch != int(transparent)
+        view[mask] = patch[mask]
+    return dst
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert int(connectivity) == 4, "this task only uses 4-connected components"
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r0 = int(r)
+        c0 = int(c)
+        if bool(seen[r0, c0]):
+            continue
+        stack = [(r0, c0)]
+        seen[r0, c0] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((int(cr), int(cc)))
+            for dr, dc in DIR4:
+                nr = int(cr + dr)
+                nc = int(cc + dc)
+                if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
