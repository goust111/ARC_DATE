+            left = int(rng.integers(1, min(3, int(c0)) + 1))
+            bottom = int(rng.integers(1, min(3, canvas.shape[0] - 1 - int(r1)) + 1))
+            right = int(rng.integers(1, min(3, canvas.shape[1] - 1 - int(c1)) + 1))
