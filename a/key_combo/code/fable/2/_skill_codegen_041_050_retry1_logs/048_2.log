+    if len(path) < 3:
+        return 0
+
+    bends = 0
+    prev_dir = (path[1][0] - path[0][0], path[1][1] - path[0][1])
+    for i in range(1, len(path) - 1):
+        next_dir = (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        if next_dir != prev_dir:
