+        if _validate_generated(inp, expected):
+            return inp, expected
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        rng = np.random.default_rng()
+        generated = _generate_candidate(rng)
+        if generated is not None:
