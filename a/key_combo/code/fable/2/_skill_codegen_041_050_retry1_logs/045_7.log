+        right = np.full((height, panel_w), bg, dtype=int)
+        objects_for_expected = []
+        for rec, (r0, c0) in zip(object_records, object_positions):
+            patch = rec["patch"]
+            _paste(right, patch, r0, c0, transparent=bg)
+            objects_for_expected.append(rec)
