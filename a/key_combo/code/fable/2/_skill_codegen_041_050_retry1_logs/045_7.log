+
+
+def _make_object_patch(
+    mask: np.ndarray,
+    main_color: int,
+    marker_color: int,
+    rng: np.random.Generator,
+) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = int(main_color)
+    coords = np.argwhere(mask)
+    marker_idx = int(rng.integers(0, len(coords)))
