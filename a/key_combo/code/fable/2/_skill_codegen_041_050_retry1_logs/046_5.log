+        return None
+
+    if not np.array_equal(actual, out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        case = _build_case()
+        if case is not None:
