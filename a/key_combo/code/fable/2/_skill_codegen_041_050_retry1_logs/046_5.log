+    best_weight = min(info["weight"] for info in path_infos)
+    winners = [info for info in path_infos if info["weight"] == best_weight]
+    if len(winners) != 1:
+        return None
+    winner = winners[0]
+
+    decoys = [
+        info
+        for info in path_infos
+        if info["hops"] < winner["hops"] and info["weight"] > winner["weight"]
