+        out2 = np.flipud(out2)
+    return inp2.copy(), out2.copy()
+
+
+def _render_case(
+    nodes: dict[str, dict[str, int]],
+    edges: list[tuple[str, str]],
+    size: int,
+    bg: int,
+    winning_path: list[str],
+) -> tuple[np.ndarray, np.ndarray]:
+    occupied_nodes = set()
+    for info in nodes.values():
+        r0 = int(info["r"])
+        c0 = int(info["c"])
+        for r in range(r0, r0 + size):
