+    adj: dict[str, dict[str, int]] = defaultdict(dict)
+    for a, b in edges:
+        weight = len(_track_cells_between((nodes[a]["r"], nodes[a]["c"]), (nodes[b]["r"], nodes[b]["c"]), size))
