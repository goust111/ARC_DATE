+def _render_input(
+    nrows: int,
+    ncols: int,
+    cell_size: int,
+    bg: int,
+    sep_color: int,
+    arrows: dict[tuple[int, int], dict],
+) -> np.ndarray:
+    h = nrows * cell_size + (nrows + 1)
+    w = ncols * cell_size + (ncols + 1)
+    grid = np.full((h, w), sep_color, dtype=int)
+    glyphs = _glyph_offsets(cell_size)
+    pitch = cell_size + 1
+
