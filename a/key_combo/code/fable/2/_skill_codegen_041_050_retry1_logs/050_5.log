+    interior_mask = np.ones_like(g, dtype=bool)
+    interior_mask[row_lines, :] = False
+    interior_mask[:, col_lines] = False
+    bg = _mode(g[interior_mask].ravel())
+    glyphs = _glyph_offsets(cell_size)
