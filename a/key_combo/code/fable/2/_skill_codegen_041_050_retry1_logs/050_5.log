+
+def _glyph_offsets(cell_size: int) -> dict[str, frozenset[tuple[int, int]]]:
+    s = int(cell_size)
+    return {
+        "NW": frozenset({(0, 0), (0, 1), (1, 0)}),
+        "NE": frozenset({(0, s - 2), (0, s - 1), (1, s - 1)}),
+        "SW": frozenset({(s - 2, 0), (s - 1, 0), (s - 1, 1)}),
+        "SE": frozenset({(s - 2, s - 1), (s - 1, s - 2), (s - 1, s - 1)}),
+    }
