+        "NE": frozenset({(0, s - 2), (0, s - 1), (1, s - 1)}),
+        "SW": frozenset({(s - 2, 0), (s - 1, 0), (s - 1, 1)}),
+        "SE": frozenset({(s - 2, s - 1), (s - 1, s - 2), (s - 1, s - 1)}),
+    }
