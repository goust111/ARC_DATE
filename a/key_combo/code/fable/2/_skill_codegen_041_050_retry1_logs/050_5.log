+        if pitch < 3:
+            continue
+        if row_lines[0] != 0 or row_lines[-1] != h - 1:
+            continue
+        if col_lines[0] != 0 or col_lines[-1] != w - 1:
+            continue
+        if (h - 1) % pitch != 0 or (w - 1) % pitch != 0:
