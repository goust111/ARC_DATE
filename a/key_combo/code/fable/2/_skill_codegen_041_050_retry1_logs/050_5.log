+        if bounced:
+            bounces += 1
+        if (nr, nc) in arrow_cells:
+            if (nr, nc) == start:
+                return None
+            return {"target": (nr, nc), "path": path, "bounces": bounces}
+        path.append((nr, nc))
+        r, c = nr, nc
+        state = (r, c, dr, dc)
+        if state in seen:
+            return None
+        seen.add(state)
