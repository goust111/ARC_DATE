+
+def _separator_candidates(grid: np.ndarray) -> list[tuple[int, int, list[int], list[int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = []
+    for color in map(int, np.unique(g)):
