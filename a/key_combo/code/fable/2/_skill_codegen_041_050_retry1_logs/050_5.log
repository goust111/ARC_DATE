+    weights = [weight for _, weight in SCENARIO_WEIGHTS]
+    return random.choices(labels, weights=weights, k=1)[0]
+
+
+def _valid_positions(nrows: int, ncols: int, parity: int) -> list[tuple[int, int]]:
