+    cell_size = layout["cell_size"]
+    rr = layout["row_lines"][r] + 1 + cell_size // 2
+    cc = layout["col_lines"][c] + 1 + cell_size // 2
+    return rr, cc
+
+
+def _paint_output(layout: dict, traces: dict) -> np.ndarray:
