+        for c in range(ncols):
+            r0 = r * pitch + 1
+            c0 = c * pitch + 1
+            grid[r0 : r0 + cell_size, c0 : c0 + cell_size] = bg
+
+    for (r, c), info in arrows.items():
+        r0 = r * pitch + 1
+        c0 = c * pitch + 1
+        for dr, dc in glyphs[info["dir"]]:
+            grid[r0 + dr, c0 + dc] = int(info["color"])
+
