+def _reflect_step(r: int, c: int, dr: int, dc: int, nrows: int, ncols: int) -> tuple[int, int, int, int, bool]:
+    ndr, ndc = int(dr), int(dc)
+    bounced = False
+    if not (0 <= r + ndr < nrows):
