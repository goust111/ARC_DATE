+
+def _validate_instance(
+    grid: np.ndarray,
+    nrows: int,
+    ncols: int,
+    cell_size: int,
+    bg: int,
+    sep_color: int,
+    arrows: dict[tuple[int, int], dict],
+    traces: dict,
+) -> bool:
+    parsed = _parse_grid(grid)
