+
+def _trace_path(
+    start: tuple[int, int],
+    initial_dir: tuple[int, int],
+    turns: list[int],
+    lengths: list[int],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[int]]:
+    dirs = [initial_dir]
+    current_dir = initial_dir
+    for turn in turns:
+        idx = DIR_TO_IDX[current_dir]
+        current_dir = DIRS[(idx + turn) % 4]
+        dirs.append(current_dir)
+
+    path = [start]
