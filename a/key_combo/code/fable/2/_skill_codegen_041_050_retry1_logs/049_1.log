+    for center, rot in zip(corners, rotations):
+        _stamp(out, sprite, center, sprite_color, rot)
+    final_rotation = rotations[-1] if rotations else 0
+    _stamp(out, sprite, ordered[-1], sprite_color, final_rotation)
+    return out
