+def _bbox_intersects(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
