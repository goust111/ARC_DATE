+            cc0 = c0 + tc * (tile_size + 1)
+            tile_bboxes.append((rr0, cc0, rr0 + tile_size - 1, cc0 + tile_size - 1))
+
+    return {
+        "divider_color": int(component["color"]),
+        "board_bbox": (r0, c0, r1, c1),
+        "tile_size": tile_size,
+        "tile_bboxes": tile_bboxes,
+    }
