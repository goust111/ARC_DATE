+
+def _bbox_inside(inner: BBox, outer: BBox) -> bool:
+    ir0, ic0, ir1, ic1 = inner
+    or0, oc0, or1, oc1 = outer
+    return or0 <= ir0 <= ir1 <= or1 and oc0 <= ic0 <= ic1 <= oc1
+
+
+def _interior_area(bbox: BBox) -> int:
+    r0, c0, r1, c1 = bbox
