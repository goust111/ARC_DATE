+    blocked: set[Coord],
+    color: int,
+    orient: str,
+    size: tuple[int, int],
+) -> dict | None:
+    h, w = shape
+    bh, bw = size
+    positions = [(r0, c0) for r0 in range(h - bh + 1) for c0 in range(w - bw + 1)]
+    random.shuffle(positions)
+    for r0, c0 in positions:
+        bbox = (r0, c0, r0 + bh - 1, c0 + bw - 1)
+        cells = _cells_for_bracket_bbox(bbox, orient)
