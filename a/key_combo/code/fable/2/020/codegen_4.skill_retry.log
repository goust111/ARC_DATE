+            left3 = random.randint(left3_min, w - 6)
+            right3 = random.randint(left3 + 4, w - 2)
+            top3 = random.randint(2, max(2, h // 2))
+            bottom3 = random.randint(top3 + 5, min(h - 2, top3 + 9))
