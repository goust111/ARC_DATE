+        bottom, right = b["elbow"]
+    elif pair == ("BR", "TL"):
+        top, left = b["elbow"]
+        bottom, right = a["elbow"]
+    elif pair == ("TR", "BL"):
+        top, right = a["elbow"]
+        bottom, left = b["elbow"]
+    elif pair == ("BL", "TR"):
