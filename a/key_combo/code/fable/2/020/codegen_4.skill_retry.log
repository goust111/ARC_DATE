+            {"color": region["color"], "bbox": (top, right - w1 + 1, top + h1 - 1, right), "orient": "TR"},
+            {"color": region["color"], "bbox": (bottom - h2 + 1, left, bottom, left + w2 - 1), "orient": "BL"},
