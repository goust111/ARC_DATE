+        rr0 = max(0, r)
+        cc0 = max(0, c)
+        rr1 = min(gh, r + int(spec["h"]))
+        cc1 = min(gw, c + int(spec["w"]))
+        if rr0 >= rr1 or cc0 >= cc1:
