+    out = g.copy()
+    for solid in sorted(solids, key=lambda item: (int(item["r"]), int(item["c"]), int(item["color"]))):
+        h = int(solid["h"])
+        w = int(solid["w"])
+        color = int(solid["color"])
+        k = 1
+        while True:
+            r = int(solid["r"]) + k * h
+            c = int(solid["c"]) + k * w
+            frame_color = frame_lookup.get((r, c, h, w))
+            if frame_color is not None:
+                out[r : r + h, c : c + w] = frame_color
