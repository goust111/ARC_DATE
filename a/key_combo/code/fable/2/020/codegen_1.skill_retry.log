+            continue
+        r0 = random.randint(0, max_r)
+        c0 = random.randint(0, max_c)
+        spec = {
+            "color": color,
+            "r": r0,
+            "c": c0,
+            "h": h,
+            "w": w,
+            "capture_step": capture_step,
+            "frame_color": frame_color,
