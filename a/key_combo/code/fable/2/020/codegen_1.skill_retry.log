+
+def _place_decoy_frame(
+    shape: tuple[int, int],
+    color: int,
+    size_options: list[tuple[int, int]],
+    occupied_actual: set[tuple[int, int]],
+    occupied_buffered: set[tuple[int, int]],
+) -> dict | None:
+    gh, gw = shape
+    option_order = size_options[:]
+    random.shuffle(option_order)
