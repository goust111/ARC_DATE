+    for frame in frames:
+        if frame.get("kind") != "decoy":
+            continue
+        r = int(frame["inner_r"])
+        c = int(frame["inner_c"])
+        h = int(frame["h"])
+        w = int(frame["w"])
+        if np.any(solved[r : r + h, c : c + w] != BG):
