+            cc0 = max(0, c)
+            rr1 = min(gh, r + h)
+            cc1 = min(gw, c + w)
+            if rr0 >= rr1 or cc0 >= cc1:
+                break
+            out[rr0:rr1, cc0:cc1] = color
+            k += 1
+    for frame in frames:
+        for r, c in _frame_border_cells(int(frame["inner_r"]), int(frame["inner_c"]), int(frame["h"]), int(frame["w"])):
+            out[r, c] = int(frame["color"])
+    return out
