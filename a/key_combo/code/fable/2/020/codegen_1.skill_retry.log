+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _rect_cells(r0: int, c0: int, h: int, w: int, shape: tuple[int, int] | None = None) -> set[tuple[int, int]]:
+    cells = {
+        (rr, cc)
+        for rr in range(r0, r0 + h)
+        for cc in range(c0, c0 + w)
+    }
+    if shape is None:
+        return cells
+    gh, gw = shape
+    return {(r, c) for r, c in cells if 0 <= r < gh and 0 <= c < gw}
+
+
+def _frame_border_cells(inner_r: int, inner_c: int, h: int, w: int) -> set[tuple[int, int]]:
+    top = inner_r - 1
+    left = inner_c - 1
+    bottom = inner_r + h
+    right = inner_c + w
+    cells = set()
+    for c in range(left, right + 1):
+        cells.add((top, c))
+        cells.add((bottom, c))
+    for r in range(top, bottom + 1):
+        cells.add((r, left))
+        cells.add((r, right))
+    return cells
+
+
+def _expand_cells(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    gh, gw = shape
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < gh and 0 <= cc < gw:
+                    out.add((rr, cc))
