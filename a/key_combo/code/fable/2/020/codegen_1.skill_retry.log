+    comps = _find_components(g, bg=BG)
+    solids: list[dict] = []
+    frames: list[dict] = []
+    for comp in comps:
+        if _is_solid_rect(comp):
+            r0, c0, r1, c1 = comp["bbox"]
+            solids.append(
+                {
+                    "color": int(comp["color"]),
+                    "r": int(r0),
+                    "c": int(c0),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                }
+            )
+        elif _is_hollow_rect(g, comp, bg=BG):
+            r0, c0, r1, c1 = comp["bbox"]
+            frames.append(
+                {
+                    "color": int(comp["color"]),
+                    "inner_r": int(r0 + 1),
+                    "inner_c": int(c0 + 1),
+                    "h": int(r1 - r0 - 1),
+                    "w": int(c1 - c0 - 1),
