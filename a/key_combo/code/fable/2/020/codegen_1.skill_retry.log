+        frames.append(decoy2)
+        border2 = _frame_border_cells(int(decoy2["inner_r"]), int(decoy2["inner_c"]), int(decoy2["h"]), int(decoy2["w"]))
+        occupied_actual |= border2
+        occupied_buffered |= _expand_cells(border2, shape)
