+            solids.append(
+                {
+                    "color": int(comp["color"]),
+                    "r": int(r0),
+                    "c": int(c0),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                }
+            )
+        elif _is_hollow_rect(g, comp, bg=BG):
