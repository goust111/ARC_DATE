+            {
+                "kind": "stamp",
+                "step": k,
+                "r": r,
+                "c": c,
+                "rr0": rr0,
+                "cc0": cc0,
+                "rr1": rr1,
+                "cc1": cc1,
+                "clipped": rr0 != r or cc0 != c or rr1 != r + int(spec["h"]) or cc1 != c + int(spec["w"]),
