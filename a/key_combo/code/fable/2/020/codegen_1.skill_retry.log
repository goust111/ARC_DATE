+    frame_lookup = {
+        (int(frame["inner_r"]), int(frame["inner_c"]), int(frame["h"]), int(frame["w"])): int(frame["color"])
+        for frame in frames
+    }
+    assert len(frame_lookup) == len(frames), "frame interiors must be unique"
