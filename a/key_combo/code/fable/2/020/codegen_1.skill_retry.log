+    return cells
+
+
+def _frame_box_clear(
+    inner_r: int,
+    inner_c: int,
+    h: int,
+    w: int,
+    occupied_actual: set[tuple[int, int]],
+) -> bool:
+    for rr in range(inner_r - 1, inner_r + h + 1):
+        for cc in range(inner_c - 1, inner_c + w + 1):
+            if (rr, cc) in occupied_actual:
