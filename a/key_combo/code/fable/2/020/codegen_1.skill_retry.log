+    top = inner_r - 1
+    left = inner_c - 1
+    bottom = inner_r + h
+    right = inner_c + w
+    cells = set()
+    for c in range(left, right + 1):
+        cells.add((top, c))
+        cells.add((bottom, c))
+    for r in range(top, bottom + 1):
+        cells.add((r, left))
+        cells.add((r, right))
+    return cells
