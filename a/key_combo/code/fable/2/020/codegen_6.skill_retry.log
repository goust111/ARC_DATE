+            Frame(
+                idx=-1,
+                color=int(comp["color"]),
+                bbox=bbox,
+                gap=gap,
+                direction=_gap_direction(gap, bbox),
+                area=(r1 - r0 + 1) * (c1 - c0 + 1),
