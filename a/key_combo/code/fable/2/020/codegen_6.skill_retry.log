+
+
+def _apply_transform(grid: np.ndarray, op: int) -> np.ndarray:
+    out = np.rot90(grid, op % 4)
+    if op >= 4:
+        out = np.fliplr(out)
+    return out.copy()
+
+
+def _crop_with_margin(grid: np.ndarray) -> np.ndarray:
