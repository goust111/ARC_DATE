+            impact_rows = [r for r in range(r_e0 + 1, r_e0 + h_e - 1) if r != gap_row]
+            e_markers = [(random.choice(impact_rows or [r_e0 + 1]), c_e0 + 2, _marker_color(marker_pool))]
