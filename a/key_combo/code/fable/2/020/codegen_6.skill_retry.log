+_PALETTE = tuple(range(1, 10))
+_MAX_GEN_ATTEMPTS = 400
+_CANVAS = 30
+
+
+@dataclass(frozen=True)
+class Frame:
+    idx: int
+    color: int
+    bbox: BBox
+    gap: Coord
+    direction: Direction
+    area: int
