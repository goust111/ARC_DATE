+
+
+def _build_stack_spec(frame_color: int, marker_pool: list[int]) -> dict:
+    for _ in range(80):
+        h_f, w_f = random.randint(5, 7), random.randint(5, 7)
+        r_f0 = random.randint(2, 9)
+        c_f0 = random.randint(22, 29 - w_f)
