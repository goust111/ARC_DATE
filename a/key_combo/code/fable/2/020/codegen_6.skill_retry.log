+        color_set = None if colors is None else {int(c) for c in colors}
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c] or int(grid[r, c]) == int(bg):
+                    continue
+                color = int(grid[r, c])
+                if color_set is not None and color not in color_set:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for dr, dc in dirs:
