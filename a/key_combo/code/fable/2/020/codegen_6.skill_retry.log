+
+    def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+        return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        min_area: int = 1,
+        return_format: str = "dict",
+        colors=None,
+    ):
+        assert return_format == "dict"
+        assert monochromatic
+        if bg is None:
+            bg = get_bg(grid)
+        h, w = grid.shape
+        seen = np.zeros((h, w), dtype=bool)
+        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        out = []
+        color_set = None if colors is None else {int(c) for c in colors}
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c] or int(grid[r, c]) == int(bg):
+                    continue
+                color = int(grid[r, c])
+                if color_set is not None and color not in color_set:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for dr, dc in dirs:
+                        nr, nc = rr + dr, cc + dc
+                        if (
+                            0 <= nr < h
+                            and 0 <= nc < w
+                            and not seen[nr, nc]
+                            and int(grid[nr, nc]) == color
+                        ):
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                if len(coords) < int(min_area):
+                    continue
+                arr = np.array(coords, dtype=int)
+                r0, c0 = arr.min(axis=0)
+                r1, c1 = arr.max(axis=0)
+                out.append(
