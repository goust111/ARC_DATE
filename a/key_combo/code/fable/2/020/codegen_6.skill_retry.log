+        "final": (int(r), int(c)),
+        "origin": origin,
+        "direction": (int(dr), int(dc)),
+        "color": int(marker["color"]),
+        "left_origin": bool(left_origin),
+        "entered_frames": entered_frames,
+        "stop_reason": stop_reason,
