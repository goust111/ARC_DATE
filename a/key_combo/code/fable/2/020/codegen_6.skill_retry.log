+    for comp in comps:
+        bbox = tuple(map(int, comp["bbox"]))
+        r0, c0, r1, c1 = bbox
+        if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+            continue
+        coords = {tuple(map(int, cell)) for cell in comp["coords"]}
+        border = _border_cells(bbox)
+        if coords - border:
+            continue
+        missing = border - coords
+        if len(missing) != 1:
