+        steps += 1
+        now = _containing_frame_ids(frames, (r, c))
+        if origin not in now:
+            left_origin = True
+        for frame_id in sorted(now - prev_containing):
+            if frame_id != origin and frame_id not in entered_frames:
+                entered_frames.append(frame_id)
