+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        min_area: int = 1,
+        return_format: str = "dict",
+        colors=None,
+    ):
