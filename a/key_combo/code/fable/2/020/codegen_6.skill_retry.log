ort annotations\\\\n\\\\nfrom collections import deque\\\\nimport random\\\\n\\\\nimport numpy as np\\\\n\\\\n\\\\ndef _background(g: np.ndarray) -> int:\\\\n    vals, counts = np.unique(g, return_counts=True)\\\\n    return int(vals[int(np.argmax(counts))])\\\\n\\\\n\\\\ndef _neighbors8(r: int, c: int, h: int, w: int):\\\\n    for dr in (-1, 0, 1):\\\\n        for dc in (-1, 0, 1):\\\\n            if dr == 0 and dc == 0:\\\\n                continue\\\\n            rr, cc = r + dr, c + dc\\\\n            if 0 <= rr < h and 0 <= cc < w:\\\\n                yield rr, cc\\\\n\\\\n\\\\ndef _mask_connected(mask: np.ndarray) -> bool:\\\\n    pts = np.argwhere(mask)\\\\n    if len(pts) == 0:\\\\n        return False\\\\n    h, w = mask.shape\\\\n    start = (int(pts[0, 0]), int(pts[0, 1]))\\\\n    seen = {start}\\\\n    q = deque([start])\\\\n    while q:\\\\n        r, c = q.popleft()\\\\n        for nr, nc in _neighbors8(r, c, h, w):\\\\n            if bool(mask[nr, nc]) and (nr, nc) not in seen:\\\\n                seen.add((nr, nc))\\\\n                q.append((nr, nc))\\\\n    return len(seen) == len(pts)\\\\n\\\\n\\\\ndef _full_bbox(mask: np.ndarray) -> bool:\\\\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\\\\n\\\\n\\\\ndef _find_slots(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int, int]]:\\\\n    h, w = g.shape\\\\n    slots: list[tuple[int, int, int, int, int, int]] = []\\\\n    for r0 in range(h - 2):\\\\n        for r1 in range(r0 + 2, h):\\\\n            for c0 in range(w - 2):\\\\n                a = int(g[r0, c0])\\\\n                if a == bg:\\\\n                    continue\\\\n                for c1 in range(c0 + 2, w):\\\\n                    b = int(g[r1, c0 + 1])\\\\n                    if b == bg or b == a:\\\\n                        continue\\\\n                    if int(g[r1, c1]) != a:\\\\n                        continue\\\\n                    if not np.all(g[r0, c0 : c1 + 1] == a):\\\\n                        continue\\\\n                    if not np.all(g[r0 : r1 + 1, c0] == a):\\\\n                        continue\\\\n                    if not np.all(g[r1, c0 + 1 : c1] == b):\\\\n                        continue\\\\n                    if not np.all(g[r0 + 1 : r1, c1] == b):\\\\n                        continue\\\\n                    if not np.all(g[r0 + 1 : r1, c0 + 1 : c1] == bg):\\\\n                        continue\\\\n                    slots.append((r0, c0, r1, c1, a, b))\\\\n    return slots\\\\n\\\\n\\\\ndef _slot_border_mask(shape: tuple[int, int], slots: list[tuple[int, int, int, int, int, int]]) -> np.ndarray:\\\\n    mask = np.zeros(shape, dtype=bool)\\\\n    for r0, c0, r1, c1, _a, _b in slots:\\\\n        mask[r0, c0 : c1 + 1] = True\\\\n        mask[r1, c0 : c1 + 1] = True\\\\n        mask[r0 : r1 + 1, c0] = True\\\\n        mask[r0 : r1 + 1, c1] = True\\\\n    return mask\\\\n\\\\n\\\\ndef _components_by_color(g: np.ndarray, bg: int) -> dict[int, list[dict]]:\\\\n    h, w = g.shape\\\\n    seen = np.zeros((h, w), dtype=bool)\\\\n    comps: dict[int, list[dict]] = {}\\\\n    for sr in range(h):\\\\n        for sc in range(w):\\\\n            color = int(g[sr, sc])\\\\n            if color == bg or seen[sr, sc]:\\\\n                continue\\\\n            coords = []\\\\n            q = deque([(sr, sc)])\\\\n            seen[sr, sc] = True\\\\n            while q:\\\\n                r, c = q.popleft()\\\\n                coords.append((r, c))\\\\n                for nr, nc in _neighbors8(r, c, h, w):\\\\n                    if not seen[nr, nc] and int(g[nr, nc]) == color:\\\\n                        seen[nr, nc] = True\\\\n                        q.append((nr, nc))\\\\n            arr = np.array(coords, dtype=int)\\\\n            r0, c0 = arr.min(axis=0)\\\\n            r1, c1 = arr.max(axis=0)\\\\n            comps.setdefault(color, []).append(\\\\n                {\\\\n                    \\\\\\\"coords\\\\\\\": arr,\\\\n                    \\\\\\\"bbox\\\\\\\": (int(r0), int(c0), int(r1), int(c1)),\\\\n                }\\\\n            )\\\\n    return comps\\\\n\\\\n\\\\ndef _component_mask(comp: dict) -> np.ndarray:\\\\n    r0, c0, r1, c1 = comp[\\\\\\\"bbox\\\\\\\"]\\\\n    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)\\\\n    coords = comp[\\\\\\\"coords\\\\\\\"]\\\\n    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True\\\\n    return mask\\\\n\\\\n\\\\ndef _select_fragment(comps: dict[int, list[dict]], color: int, shape: tuple[int, int]) -> dict:\\\\n    matches = []\\\\n    for comp in comps.get(color, []):\\\\n        r0, c0, r1, c1 = comp[\\\\\\\"bbox\\\\\\\"]\\\\n        if (r1 - r0 + 1, c1 - c0 + 1) == shape:\\\\n            matches.append(comp)\\\\n    assert len(matches) == 1, \\\\\\\"each slot color must identify one matching fragment\\\\\\\"\\\\n    return matches[0]\\\\n\\\\n\\\\ndef main(grid: np.ndarray) -> np.ndarray:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Pair colored fragments with two-color rectangular slots and assemble each slot interior.\\\\n\\\\n    Input structure:\\\\n    - The background is the dominant color.\\\\n    - Several small monochrome 8-connected fragments are scattered away from the slots, with a unique color for each fragment.\\\\n    - Each empty rectangular slot has a one-pixel border: its top and left sides use color A, its bottom and right sides use color B, and all four corner pixels use color A.\\\\n    - The two border colors of every slot match exactly two fragment colors; those fragment bboxes have the same height and width as the slot interior.\\\\n\\\\n    Rule:\\\\n    - For each slot, use the top/left color A and bottom/right color B to find the matching two fragments.\\\\n    - Clear all original fragment pixels back to the background.\\\\n    - Align the two fragment bboxes to the slot interior and paste their filled pixels in their own colors.\\\\n    - Leave the two-color slot border unchanged.\\\\n\\\\n    Key insight:\\\\n    The split-colored border is a pairing code: its two colors name the two complementary fragments whose aligned masks tile the empty rectangle.\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    g = np.asarray(grid, dtype=int)\\\\n    assert g.ndim == 2\\\\n    bg = _background(g)\\\\n\\\\n    slots = _find_slots(g, bg)\\\\n    assert slots, \\\\\\\"expected at least one two-color rectangular slot\\\\\\\"\\\\n    border = _slot_border_mask(g.shape, slots)\\\\n\\\\n    without_borders = g.copy()\\\\n    without_borders[border] = bg\\\\n    comps = _components_by_color(without_borders, bg)\\\\n\\\\n    out = g.copy()\\\\n    placements = []\\\\n    used_colors: set[int] = set()\\\\n    used_components: list[dict] = []\\\\n    for r0, c0, r1, c1, a, b in slots:\\\\n        assert a not in used_colors and b not in used_colors\\\\n        used_colors.update({a, b})\\\\n\\\\n        ih, iw = r1 - r0 - 1, c1 - c0 - 1\\\\n        shape = (ih, iw)\\\\n        frag_a = _select_fragment(comps, a, shape)\\\\n        frag_b = _select_fragment(comps, b, shape)\\\\n        mask_a = _component_mask(frag_a)\\\\n        mask_b = _component_mask(frag_b)\\\\n        assert mask_a.shape == shape and mask_b.shape == shape\\\\n        assert not np.any(mask_a & mask_b)\\\\n        assert np.all(mask_a | mask_b)\\\\n\\\\n        used_components.extend([frag_a, frag_b])\\\\n        placements.append((r0 + 1, c0 + 1, a, b, mask_a, mask_b))\\\\n\\\\n    for comp in used_components:\\\\n        coords = comp[\\\\\\\"coords\\\\\\\"]\\\\n        out[coords[:, 0], coords[:, 1]] = bg\\\\n\\\\n    for ir, ic, a, b, mask_a, mask_b in placements:\\\\n        ih, iw = mask_a.shape\\\\n        target = out[ir : ir + ih, ic : ic + iw]\\\\n        assert np.all(target == bg)\\\\n        target[mask_a] = a\\\\n        target[mask_b] = b\\\\n\\\\n    return out\\\\n\\\\n\\\\n# --------------- generator ---------------\\\\n\\\\nGEN_ATTEMPTS = 400\\\\nMASK_ATTEMPTS = 1000\\\\nCOLOR_COUNT = 10\\\\n\\\\n\\\\ndef _sample_mask_pair(height: int, width: int) -> tuple[np.ndarray, np.ndarray]:\\\\n    for _ in range(MASK_ATTEMPTS):\\\\n        p = random.uniform(0.35, 0.65)\\\\n        mask = np.array(\\\\n            [[random.random() < p for _c in range(width)] for _r in range(height)],\\\\n            dtype=bool,\\\\n        )\\\\n        other = ~mask\\\\n        if (\\\\n            _full_bbox(mask)\\\\n            and _full_bbox(other)\\\\n            and _mask_connected(mask)\\\\n            and _mask_connected(other)\\\\n        ):\\\\n            if random.choice([True, False]):\\\\n                mask = np.flipud(mask)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/_codegen_logs/run_20260618_122058_gpt55_xhigh_missing/10__codegen_prompts__4.log:40:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_21\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/bash -lc \\\\\\\"sed -n '1,220p' /home/lixinyu/snap/a/des/code/combo_new/seed1030756833/10/7.py\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/_codegen_logs/run_20260618_122058_gpt55_xhigh_missing/10__codegen_prompts__4.log:41:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_21\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/bash -lc \\\\\\\"sed -n '1,220p' /home/lixinyu/snap/a/des/code/combo_new/seed1030756833/10/7.py\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"from __future__ import annotations\\\\n\\\\nfrom collections import deque\\\\nimport random\\\\n\\\\nimport numpy as np\\\\n\\\\n\\\\nORANGE = 7\\\\nMAX_GENERATION_ATTEMPTS = 500\\\\n\\\\n\\\\ndef _background_color(grid: np.ndarray) -> int:\\\\n    values, counts = np.unique(grid, return_counts=True)\\\\n    return int(values[int(np.argmax(counts))])\\\\n\\\\n\\\\ndef _bbox(points: np.ndarray) -> tuple[int, int, int, int]:\\\\n    r0, c0 = points.min(axis=0)\\\\n    r1, c1 = points.max(axis=0)\\\\n    return int(r0), int(c0), int(r1), int(c1)\\\\n\\\\n\\\\ndef _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:\\\\n    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))\\\\n\\\\n\\\\ndef _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:\\\\n    h, w = mask.shape\\\\n    seen = np.zeros_like(mask, dtype=bool)\\\\n    comps: list[list[tuple[int, int]]] = []\\\\n    for sr, sc in np.argwhere(mask):\\\\n        sr, sc = int(sr), int(sc)\\\\n        if seen[sr, sc]:\\\\n            continue\\\\n        q: deque[tuple[int, int]] = deque([(sr, sc)])\\\\n        seen[sr, sc] = True\\\\n        comp: list[tuple[int, int]] = []\\\\n        while q:\\\\n            r, c = q.popleft()\\\\n            comp.append((r, c))\\\\n            for nr, nc in _neighbors4(r, c):\\\\n                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\\\\n                    seen[nr, nc] = True\\\\n                    q.append((nr, nc))\\\\n        comps.append(comp)\\\\n    return comps\\\\n\\\\n\\\\ndef _is_connected(mask: np.ndarray) -> bool:\\\\n    return bool(np.any(mask)) and len(_components(mask)) == 1\\\\n\\\\n\\\\ndef _touches_all_edges(mask: np.ndarray) -> bool:\\\\n    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())\\\\n\\\\n\\\\ndef main(grid: np.ndarray) -> np.ndarray:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    Complete each colored damaged copy by using the orange sprite as a shape template.\\\\n\\\\n    Input structure:\\\\n    - The dominant color is the background. Exactly one complete orange shape is\\\\n      placed in a corner area and acts as a reference template.\\\\n    - Elsewhere there are three or four differently colored copies whose full\\\\n      shape has the same bounding-box size as the orange template.\\\\n    - Each non-orange copy has some template pixels missing, shown as background,\\\\n      while enough visible pixels remain to keep the same bounding box.\\\\n\\\\n    Rule:\\\\n    - Take the orange shape's bounding box as the template coordinate frame.\\\\n    - For every non-background, non-orange color, align that color's bounding box\\\\n      to the template bounding box.\\\\n    - Wherever the template contains orange and the aligned copy contains\\\\n      background, fill that cell with the copy's own color.\\\\n    - Leave the orange template and all already visible copy pixels unchanged.\\\\n\\\\n    Key insight:\\\\n    - The orange object is not another copy to recolor; it supplies only the\\\\n      shape mask. Missing pixels are restored in each damaged copy's own color.\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    g = np.asarray(grid, dtype=int)\\\\n    assert g.ndim == 2\\\\n    bg = _background_color(g)\\\\n    assert bg != ORANGE\\\\n\\\\n    template_points = np.argwhere(g == ORANGE)\\\\n    assert len(template_points) > 0, \\\\\\\"expected one orange template\\\\\\\"\\\\n    tr0, tc0, tr1, tc1 = _bbox(template_points)\\\\n    template_mask = g[tr0 : tr1 + 1, tc0 : tc1 + 1] == ORANGE\\\\n    th, tw = template_mask.shape\\\\n    assert _touches_all_edges(template_mask), \\\\\\\"template bbox must be tight\\\\\\\"\\\\n\\\\n    out = g.copy()\\\\n    for color in np.unique(g):\\\\n        color = int(color)\\\\n        if color in (bg, ORANGE):\\\\n            continue\\\\n\\\\n        points = np.argwhere(g == color)\\\\n        if len(points) == 0:\\\\n            continue\\\\n        r0, c0, r1, c1 = _bbox(points)\\\\n        assert (r1 - r0 + 1, c1 - c0 + 1) == (th, tw), \\\\\\\"copy bbox must match template bbox\\\\\\\"\\\\n\\\\n        patch = g[r0 : r1 + 1, c0 : c1 + 1]\\\\n        assert np.all((patch == bg) | (patch == color)), \\\\\\\"copy bbox must not contain other colors\\\\\\\"\\\\n        assert np.all((patch != color) | template_mask), \\\\\\\"copy pixels must lie on template cells\\\\\\\"\\\\n        missing = template_mask & (patch == bg)\\\\n        out[r0 : r1 + 1, c0 : c1 + 1][missing] = color\\\\n\\\\n    return out\\\\n\\\\n\\\\ndef _draw_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:\\\\n    r, c = start\\\\n    er, ec = end\\\\n    if random.choice([False, True]):\\\\n        step = 1 if er >= r else -1\\\\n        for rr in range(r, er + step, step):\\\\n            mask[rr, c] = True\\\\n        step = 1 if ec >= c else -1\\\\n        for cc in range(c, ec + step, step):\\\\n            mask[er, cc] = True\\\\n    else:\\\\n        step = 1 if ec >= c else -1\\\\n        for cc in range(c, ec + step, step):\\\\n            mask[r, cc] = True\\\\n        step = 1 if er >= r else -1\\\\n        for rr in range(r, er + step, step):\\\\n            mask[rr, ec] = True\\\\n\\\\n\\\\ndef _grow_template_mask() -> np.ndarray | None:\\\\n    h = random.randint(5, 8)\\\\n    w = random.randint(5, 8)\\\\n    mask = np.zeros((h, w), dtype=bool)\\\\n    center = (random.randint(1, h - 2), random.randint(1, w - 2))\\\\n    edge_targets = [\\\\n        (0, random.randint(0, w - 1)),\\\\n        (h - 1, random.randint(0, w - 1)),\\\\n        (random.randint(0, h - 1), 0),\\\\n        (random.randint(0, h - 1), w - 1),\\\\n    ]\\\\n    random.shuffle(edge_targets)\\\\n    for target in edge_targets:\\\\n        _draw_path(mask, center, target)\\\\n\\\\n    max_area = max(int(h * w * 0.68), int(mask.sum()))\\\\n    max_area = min(max_area, h * w - 1)\\\\n    min_area = max(15, int(mask.sum()))\\\\n    if min_area > max_area:\\\\n        min_area = int(mask.sum())\\\\n    target_area = random.randint(min_area, max_area)\\\\n\\\\n    while int(mask.sum()) < target_area:\\\\n        frontier: list[tuple[int, int]] = []\\\\n        for r, c in np.argwhere(mask):\\\\n            for nr, nc in _neighbors4(int(r), int(c)):\\\\n                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:\\\\n                    frontier.append((nr, nc))\\\\n        if not frontier:\\\\n            break\\\\n        mask[random.choice(frontier)] = True\\\\n\\\\n    if random.choice([False, True]):\\\\n        mask = np.fliplr(mask)\\\\n    if random.choice([False, True]):\\\\n        mask = np.flipud(mask)\\\\n    k = random.randint(0, 3)\\\\n    if k:\\\\n        mask = np.rot90(mask, k)\\\\n\\\\n    if int(mask.sum()) < 15 or not _touches_all_edges(mask) or not _is_connected(mask):\\\\n        return None\\\\n    return mask.copy()\\\\n\\\\n\\\\ndef _partial_mask(template: np.ndarray, missing_count: int) -> np.ndarray | None:\\\\n    coords = [tuple(map(int, p)) for p in np.argwhere(template)]\\\\n    total = len(coords)\\\\n    for _ in range(300):\\\\n        removed = set(random.sample(coords, missing_count))\\\\n        keep = template.copy()\\\\n        for r, c in removed:\\\\n            keep[r, c] = False\\\\n        if int(keep.sum()) * 2 <= total:\\\\n            continue\\\\n        if not _touches_all_edges(keep):\\\\n            continue\\\\n        if not _is_connected(keep):\\\\n            continue\\\\n        return keep\\\\n    return None\\\\n\\\\n\\\\ndef _paint(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:\\\\n    h, w = mask.shape\\\\n    region = grid[r0 : r0 + h, c0 : c0 + w]\\\\n    region[mask] = int(color)\\\\n\\\\n\\\\ndef _mark_occupied(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:\\\\n    rows, cols = occupied.shape\\\\n    occupied[max(0, r0 - 1) : min(rows, r0 + h + 1), max(0, c0 - 1) : min(cols, c0 + w + 1)] = True\\\\n\\\\n\\\\ndef _available_positions(occupied: np.ndarray, h: int, w: int) -> list[tuple[int, int]]:\\\\n    rows, cols = occupied.shape\\\\n    positions: list[tuple[int, int]] = []\\\\n    for r0 in range(rows - h + 1):\\\\n        for c0 in range(cols - w + 1):\\\\n            if not occupied[max(0, r0 - 1) : min(rows, r0 + h + 1), max(0, c0 - 1) : min(cols, c0 + w + 1)].any():\\\\n                positions.append((r0, c0))\\\\n    return positions\\\\n\\\\n\\\\ndef _corner_position(rows: int, cols: int, h: int, w: int) -> tuple[int, int]:\\\\n    margin = random.randint(0, 2)\\\\n    corner = random.choice([\\\\\\\"tl\\\\\\\", \\\\\\\"tr\\\\\\\", \\\\\\\"bl\\\\\\\", \\\\\\\"br\\\\\\\"])\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/_codegen_logs/run_20260618_122058_gpt55_xhigh_missing/10__codegen_prompts__4.log:43:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/10/4.py\\\",\\\"kind\\\":\\\"add\\\"}],\\\"status\\\":\\\"in_progress\\\"}}\\n/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/_codegen_logs/run_20260618_122058_gpt55_xhigh_missing/10__codegen_prompts__4.log:44:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"file_change\\\",\\\"changes\\\":[{\\\"path\\\":\\\"/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/10/4.py\\\",\\\"kind\\\":\\\"add\\\"}],\\\"status\\\":\\\"completed\\\"}}\\n/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/_codegen_logs/run_20260618_122058_gpt55_xhigh_missing/10__codegen_prompts__4.log:46:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_25\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/bash -lc \\\\\\\"python - <<'PY'\\\\nfrom importlib.machinery import SourceFileLoader\\\\nfrom pathlib import Path\\\\nimport hashlib\\\\nimport numpy as np\\\\n\\\\np = Path(\\\\\\\\\\\\\\\"/home/lixinyu/snap/a/des/code/combo_new/seed1030756833/10/4.py\\\\\\\\\\\\\\\")\\\\nmod = SourceFileLoader(\\\\\\\\\\\\\\\"new_arc_task\\\\\\\\\\\\\\\", str(p)).load_module()\\\\nsigs = set()\\\\nfor i in range(100):\\\\n    inp = mod.generate_input()\\\\n    out = mod.main(inp)\\\\n    assert isinstance(inp, np.ndarray)\\\\n    assert isinstance(out, np.