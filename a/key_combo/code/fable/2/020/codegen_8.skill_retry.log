+        if side > 0:
+            return pair_shape, (0, 0), (0, width + gap)
+        return pair_shape, (0, width + gap), (0, 0)
+
+    pair_shape = (2 * height + gap, width)
+    if side > 0:
+        return pair_shape, (0, 0), (height + gap, 0)
+    return pair_shape, (height + gap, 0), (0, 0)
+
