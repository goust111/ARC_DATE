+GRID_WIDTH_RANGE = (18, 29)
+SPRITE_COUNT_CHOICES = (2, 2, 3)
+SPRITE_HEIGHT_RANGE = (2, 4)
+SPRITE_WIDTH_RANGE = (3, 5)
