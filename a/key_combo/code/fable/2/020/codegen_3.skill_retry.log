+def _random_sprite_mask(
+    height: int,
+    width: int,
+    *,
+    require_axis_distinction: bool,
+) -> np.ndarray:
+    total = height * width
+    min_area = max(3, (total + 3) // 4)
+    max_area = min(total - 1, (3 * total) // 4 + 1)
+    if min_area > max_area:
+        min_area = max_area
+    for _ in range(500):
+        anchors = [
+            (0, random.randrange(width)),
