+
+
+def _sign(value: int) -> int:
+    return (value > 0) - (value < 0)
+
+
+def _path_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    out: list[tuple[int, int]] = []
+    while (r, c) != b:
+        dr = _sign(b[0] - r)
+        dc = _sign(b[1] - c)
