+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+BRACKET_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+OPENINGS = ("left", "right", "up", "down")
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+NEIGHBORS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+GEN_RETRIES = 400
