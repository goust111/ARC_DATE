+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1 if opening == "left" else 0] = True
+    elif opening in ("up", "down"):
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1 if opening == "up" else 0, :] = True
+    else:
+        raise ValueError(f"unknown opening: {opening}")
