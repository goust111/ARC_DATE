+    b: tuple[int, int, int, int],
+    gap: int,
+) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah + gap <= br
+        or br + bh + gap <= ar
+        or ac + aw + gap <= bc
+        or bc + bw + gap <= ac
+    )
+
+
+def _place_layout(height: int, width: int, items: list[dict]) -> bool:
+    placed_rects: list[tuple[int, int, int, int]] = []
+    order = sorted(range(len(items)), key=lambda idx: items[idx]["height"] * items[idx]["width"], reverse=True)
+    for idx in order:
+        item = items[idx]
+        h = int(item["height"])
+        w = int(item["width"])
+        r_min = c_min = 1
+        r_max = height - h - 1
+        c_max = width - w - 1
+        if r_min > r_max or c_min > c_max:
+            return False
+        candidates = [(r, c) for r in range(r_min, r_max + 1) for c in range(c_min, c_max + 1)]
+        random.shuffle(candidates)
+        placed = False
+        for r0, c0 in candidates:
+            rect = (r0, c0, h, w)
+            if any(_rect_conflict(rect, prev, gap=1) for prev in placed_rects):
+                continue
+            item["r0"] = r0
+            item["c0"] = c0
+            placed_rects.append(rect)
+            placed = True
+            break
+        if not placed:
