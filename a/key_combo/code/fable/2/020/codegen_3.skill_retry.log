+def _rect_conflict(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    gap: int,
+) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return not (
+        ar + ah + gap <= br
+        or br + bh + gap <= ar
+        or ac + aw + gap <= bc
+        or bc + bw + gap <= ac
