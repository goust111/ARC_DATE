+    return grid
+
+
+def _validate_generated_grid(grid: np.ndarray, specs: Sequence[dict]) -> None:
+    analyzed_out, metadata = _solve_with_metadata(grid)
+    assert len(metadata) == len(specs)
+
+    output_bands = _extract_bands(analyzed_out, BG)
