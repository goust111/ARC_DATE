+        if len(np.unique(tile)) >= 3:
+            return tile
+
+
+def _make_band_tiles(height: int, width: int, axis: int, pair: tuple[int, int]) -> tuple[list[np.ndarray], tuple[int, ...]]:
+    perm_length = height if axis == 0 else width
+    for _ in range(200):
