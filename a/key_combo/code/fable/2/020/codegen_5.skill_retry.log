+    for axis in _band_axes(band_count):
+        pair = random.choice(pairs)
+        tiles, perm = _make_band_tiles(tile_h, tile_w, axis, pair)
+        specs.append({"axis": axis, "pair": pair, "perm": perm, "tiles": tiles})
