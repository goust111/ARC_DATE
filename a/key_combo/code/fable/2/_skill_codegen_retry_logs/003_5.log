    _paint_rect_border(out, object_bbox, draw_color)
    for marker in markers:
        out[marker] = MARKER_COLOR
    inp = out.copy()
    _paint_rect_border(inp, frame_bbox, BACKGROUND_COLOR)
    return inp, out


