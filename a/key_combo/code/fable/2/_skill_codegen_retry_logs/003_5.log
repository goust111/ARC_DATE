+def _candidate_spec(bg: int, sprite_colors: list[int]) -> tuple[np.ndarray, np.ndarray]:
+    branch = random.choice(["enlarge", "shrink"])
+    rot_k = 0 if random.random() < 0.5 else random.choice([1, 3])
+    scale = random.randint(2, 3)
