+GEN_RETRIES = 400
+PLACEMENT_PADDING = 1
+TARGET_PADDING = 2
+GRID_MIN = 22
+GRID_MAX = 30
+DISTRACTOR_COUNT_RANGE = (2, 4)
+DISTRACTOR_DIM_MIN = 2
+DISTRACTOR_DIM_MAX = 12
