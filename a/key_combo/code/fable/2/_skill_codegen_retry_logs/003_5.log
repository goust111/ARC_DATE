+    min_fill = max(int(np.ceil(0.55 * h * w)), int(mask.sum()))
+    max_fill = max(min_fill, int(np.floor(0.82 * h * w)))
+    target_fill = random.randint(min_fill, max_fill)
+    mask = _grow_mask(mask, target_fill)
