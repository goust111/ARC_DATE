+    if not coords:
+        raise AssertionError("rot180 sprite must be nonempty")
+    p = random.choice(coords)
+    q = (h - 1 - p[0], w - 1 - p[1])
+    for r, c in _path_between(p, q):
+        mask[r, c] = True
+    mask |= np.rot90(mask, 2)
+
+    assert _is_connected_mask(mask), "rot180 sprite must stay connected"
