+
+def _make_rot180_sprite(h: int, w: int, bg: int, sprite_colors: list[int]) -> np.ndarray:
+    base = _make_logical_sprite(h, w, bg, sprite_colors)
+    mask = (base != bg) | (np.rot90(base, 2) != bg)
