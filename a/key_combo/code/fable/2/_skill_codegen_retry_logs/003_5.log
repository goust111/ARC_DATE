+
+def _dimension_profile(shape: tuple[int, int], target_shape: tuple[int, int]) -> tuple[bool, bool, bool]:
+    h, w = map(int, shape)
+    target_h, target_w = map(int, target_shape)
+    valid = False
+    unequal = False
+    one_axis = False
