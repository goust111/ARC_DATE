    obj_w = int(np.random.randint(*OBJECT_SIZE_RANGE))
    obj_r0 = int(np.random.randint(r0 + OBJECT_FRAME_GAP, r1 - obj_h))
    obj_c0 = int(np.random.randint(c0 + OBJECT_FRAME_GAP, c1 - obj_w))
