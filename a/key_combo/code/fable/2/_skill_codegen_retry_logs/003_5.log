+
+def _path_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    out = [(r, c)]
+    vertical_first = random.random() < 0.5
+    if vertical_first:
+        while r != tr:
+            r += 1 if tr > r else -1
+            out.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            out.append((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            out.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            out.append((r, c))
+    return out
