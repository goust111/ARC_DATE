+                "source": source,
+                "target": target,
+                "missing": missing_cell,
+            }
+        )
+    return inp, out, specs
+
+
+def _semantic_check(
+    inp: np.ndarray,
+    out: np.ndarray,
+    prototype: np.ndarray,
+    specs: list[dict[str, object]],
+) -> bool:
