+def _choose_target_counts(phase: int) -> tuple[int, int, int, int]:
+    counts = [1, 1, 1, 1]
+    if 1 <= phase <= 4:
+        counts[phase - 1] = 0
+
+    allowed = [idx for idx in range(4) if counts[idx] > 0]
+    extra_lo, extra_hi = (3, 5) if phase == 5 else (1, 4)
