MIN_PIXELS_PER_COLOR, MAX_PIXELS_PER_COLOR = 2, 8
CONNECTIVITY, MAX_GENERATION_ATTEMPTS = 4, 300


def _gen_valid_dims(area: int) -> list[tuple[int, int]]:
    dims = []
    for h in OBJECT_HEIGHTS:
