            choices = [0]
            if bends_used < bend_budget:
                if c > 0:
                    choices.append(-1)
                if c + 1 < w:
                    choices.append(1)
            step = random.choice(choices)
            c = prev_c + step
            mask[r, prev_c] = True
            mask[r, c] = True
            bends_used += int(step != 0)
        mask[random.randrange(INTERIOR_MARGIN, h - INTERIOR_MARGIN), :] = True
    else:
        r = random.randrange(INTERIOR_MARGIN, h - INTERIOR_MARGIN)
        mask[r, 0] = True
        bends_used = 0
        for c in range(1, w):
