+
+
+def _classify_chain(cols: list[int], heights: list[int], trigger_index: int) -> dict:
+    n = len(cols)
+    order = [trigger_index]
+    frontier = cols[trigger_index] + heights[trigger_index]
+    j = trigger_index + 1
+    while j < n and cols[j] <= frontier:
