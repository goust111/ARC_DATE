+            ok = True
+            for i in range(start + 1, stop - 1):
+                lower = cols[i + 1] - cols[i]
+                upper = max_heights[i] if stop == n else min(max_heights[i], cols[stop] - cols[i] - 1)
+                if lower > upper:
