+
+
+def _assign_profile_heights(profile: str, cols: list[int], max_heights: list[int]) -> tuple[list[int], int] | None:
+    n = len(cols)
+    heights = _random_heights(max_heights)
+
+    if profile == "no_chain":
+        options = _feasible_no_chain(cols, max_heights)
+        if not options:
