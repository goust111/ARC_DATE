            choices = [0]
            if bends_used < bend_budget:
                if r > 1:
                    choices.append(-1)
                if r + 2 < h:
                    choices.append(1)
            step = random.choice(choices)
            r = prev_r + step
            mask[prev_r, c] = True
            mask[r, c] = True
            bends_used += int(step != 0)
        mask[:, random.randrange(INTERIOR_MARGIN, w - INTERIOR_MARGIN)] = True

