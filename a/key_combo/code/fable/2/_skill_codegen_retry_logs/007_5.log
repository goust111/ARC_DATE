        _gen_paint_slot(input_grid, slot_r, slot_c, mask, in_color)
    return input_grid, output


def _gen_validated_input(input_grid: np.ndarray, output: np.ndarray) -> np.ndarray | None:
    try:
        if np.array_equal(main(input_grid), output):
            return input_grid
    except Exception:
        return None
    return None

