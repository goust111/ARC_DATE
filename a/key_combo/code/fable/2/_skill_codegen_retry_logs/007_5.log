+def _validate_case(
+    inp: np.ndarray,
+    clean_tile: np.ndarray,
+    defect_colors: dict[tuple[int, int], int],
+    expected: np.ndarray,
+) -> bool:
+    tile_h, tile_w = clean_tile.shape
+    full_h, full_w = inp.shape
+    if full_h > 30 or full_w > 30:
