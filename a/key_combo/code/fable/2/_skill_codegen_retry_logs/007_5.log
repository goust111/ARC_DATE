    moves = [(1, 0)] * (n - 1) + [(0, 1)] * (n - 1)
    random.shuffle(moves)
    r = c = 0
    cells = {(0, 0)}
    for dr, dc in moves:
        r += dr
        c += dc
        cells.add((r, c))
    return cells


