+def _divisors(n: int) -> list[int]:
+    return [d for d in range(1, n + 1) if n % d == 0]
+
+
+def _best_color(counter: Counter[int]) -> int:
+    best = max(counter.values())
+    return min(color for color, count in counter.items() if count == best)
+
+
+def _row_period_cost(grid: np.ndarray, period: int) -> int:
+    h, w = grid.shape
+    cost = 0
+    for phase_r in range(period):
+        rows = range(phase_r, h, period)
+        for c in range(w):
+            counts = Counter(int(grid[r, c]) for r in rows)
+            cost += len(counts) and len(range(phase_r, h, period)) - max(counts.values())
+    return int(cost)
+
+
+def _col_period_cost(grid: np.ndarray, period: int) -> int:
+    h, w = grid.shape
+    cost = 0
+    for phase_c in range(period):
+        cols = range(phase_c, w, period)
+        for r in range(h):
+            counts = Counter(int(grid[r, c]) for c in cols)
+            cost += len(counts) and len(range(phase_c, w, period)) - max(counts.values())
+    return int(cost)
+
+
+def _infer_axis_period(length: int, cost_fn) -> int:
+    divisors = _divisors(length)
+    scored = [(period, int(cost_fn(period))) for period in divisors]
+    best_cost = min(cost for _period, cost in scored)
+    return min(period for period, cost in scored if cost == best_cost)
+
