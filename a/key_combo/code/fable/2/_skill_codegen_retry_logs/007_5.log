+ARC_COLORS = tuple(range(10))
+PERIOD_H_RANGE = (2, 6)
+PERIOD_W_RANGE = (2, 6)
+REPEAT_MIN = 1
+REPEAT_MAX = 5
+GRID_SIDE_MIN = 6
+PALETTE_SIZE_RANGE = (3, 5)
+DEFECT_COUNT_MAX = 5
+GENERATION_RETRIES = 500
