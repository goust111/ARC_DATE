    if distractors.size:
        distractors = np.random.permutation(distractors)

    if not _gen_place_distractors(grid, distractors):
        return None
    if not _gen_is_valid(grid, center_color):
        return None
    return grid


def generate_input():
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
