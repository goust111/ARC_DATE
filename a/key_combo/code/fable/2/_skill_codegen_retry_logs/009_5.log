+                mask = np.ones((k, k + 1), dtype=bool)
+                col = 0 if random.random() < 0.5 else k
+                row = random.randrange(k)
+                mask[row, col] = False
+            else:
+                mask = np.ones((k + 1, k), dtype=bool)
+                row = 0 if random.random() < 0.5 else k
+                col = random.randrange(k)
+                mask[row, col] = False
