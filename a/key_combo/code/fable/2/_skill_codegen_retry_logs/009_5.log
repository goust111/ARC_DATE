+    integral = np.pad(mask.astype(int).cumsum(axis=0).cumsum(axis=1), ((1, 0), (1, 0)))
+    need = int(k * k)
+    positions: list[tuple[int, int]] = []
+    for r0 in range(h - k + 1):
+        for c0 in range(w - k + 1):
