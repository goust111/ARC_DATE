+
+def _random_transform(mask: np.ndarray) -> np.ndarray:
+    out = np.rot90(mask, k=random.randint(0, 3))
+    if random.random() < 0.5:
+        out = out[:, ::-1]
+    if random.random() < 0.5:
+        out = out[::-1, :]
+    return out.copy()
+
+
+def _gen_unique_mask(k: int) -> np.ndarray:
+    for _ in range(200):
