+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
