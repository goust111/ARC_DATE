+        r0, c0, r1, c1 = outline["bbox"]
+        scaled = scale_sprite(sprite["patch"], outline["factor"])
+        view = out[r0 : r1 + 1, c0 : c1 + 1]
+        view[outline["interior"]] = scaled[outline["interior"]]
+        view[outline["outline"]] = Color.GREY
