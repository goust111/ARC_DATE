+    outline = filled & ~eroded
+    interior = filled & ~outline
+    if not interior.any():
+        return None
+    if len(components_mask(outline, connectivity=4)) != 1:
+        return None
+    if len(components_mask(interior, connectivity=4)) != 1:
+        return None
+    if not np.array_equal(binary_fill_holes(outline), filled):
+        return None
+    return {
+        "filled": filled,
+        "outline": outline,
+        "interior": interior,
+    }
+
+
