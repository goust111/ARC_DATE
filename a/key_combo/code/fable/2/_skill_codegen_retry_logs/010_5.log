+        view = out[r0 : r1 + 1, c0 : c1 + 1]
+        view[outline["interior"]] = scaled[outline["interior"]]
+        view[outline["outline"]] = Color.GREY
+    return out
+
+
+def _semantic_edges(grid: np.ndarray) -> set[tuple[tuple[int, int, int, int], tuple[int, int, int, int], int]]:
+    bg = get_bg(grid)
