+_GEN_BG_COLOR_COUNT = (3, 5)
+_GEN_BG_BLOCK = (1, 3)
+_GEN_SHAPE_HEIGHT = (5, 10)
+_GEN_SHAPE_WIDTH_MIN = 5
+_GEN_SHAPE_WIDTH_MAX = 11
+_GEN_QUADRANTS = ("tl", "tr", "bl", "br")
+_GEN_COLORS = tuple(range(1, 10))
