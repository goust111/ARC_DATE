+        for idx, unit in enumerate(units):
+            if idx in assignments:
+                continue
+            options = unit["options"]
+            hole_options = [opt for opt in options if opt[0] in _PAIR_HIDDEN_STATUSES]
+            both_options = [opt for opt in options if opt[0] == "both"]
