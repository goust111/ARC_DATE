GEN_ANSWER_TO_SECOND_MIN_RATIO, GEN_RECT_PATCH_PROB = 1.18, 0.35
GEN_FOREGROUND_TOTAL_MIN, GEN_FOREGROUND_TOTAL_MAX = 220, 256
GEN_RECT_MAX_SIDE, GEN_TINY_AREA_MAX, GEN_RECT_MIN_SIDE = 20, 4, 2
