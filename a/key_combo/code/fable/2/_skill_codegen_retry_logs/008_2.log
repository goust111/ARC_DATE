def _gen_attempt() -> np.ndarray | None:
    colors = random.sample(COLOR_POOL, LEGEND_CELLS)
    legend = np.array(colors, dtype=int).reshape(LEGEND_SHAPE)

    mask = _gen_object_mask()
    if mask is None:
