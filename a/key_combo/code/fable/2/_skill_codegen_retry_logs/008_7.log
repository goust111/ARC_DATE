+    expected = liar["correct_patch"]
+    return grid, expected, tile, specs, liar_idx, wrong_shift
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    tile: np.ndarray,
+    specs: list[dict],
