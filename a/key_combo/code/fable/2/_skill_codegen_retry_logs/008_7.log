+    random.shuffle(options)
+    wrong_shift = None
+    wrong_patch = None
+    for shift in options:
+        candidate = _sample_tile(
+            tile,
+            liar["top"][0] + shift[0],
+            liar["top"][1] + shift[1],
+            liar["shape"][0],
+            liar["shape"][1],
+        )
+        if not np.array_equal(candidate, liar["correct_patch"]):
+            wrong_shift = shift
+            wrong_patch = candidate
