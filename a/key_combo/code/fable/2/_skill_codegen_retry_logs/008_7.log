+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+ARC_COLORS = tuple(range(10))
+FOREGROUND_COLORS = tuple(range(1, 10))
+
+GEN_MAX_ATTEMPTS = 600
+GEN_GRID_H = (20, 28)
+GEN_GRID_W = (20, 28)
+GEN_WINDOW_COUNT = (4, 6)
+GEN_PERIOD = (1, 5)
+GEN_INNER_H = (3, 7)
+GEN_INNER_W = (3, 7)
+GEN_PADDING = 1
