+    for (r0, c0, r1, c1), (inner_h, inner_w) in zip(boxes, inner_sizes):
+        top = (r0 + 1, c0 + 1)
+        specs.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "top": top,
+                "shape": (inner_h, inner_w),
+                "correct_patch": _sample_tile(tile, top[0], top[1], inner_h, inner_w),
+            }
+        )
