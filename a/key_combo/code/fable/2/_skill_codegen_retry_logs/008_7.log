+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        try:
+            grid, expected, tile, specs, liar_idx, wrong_shift = _build_puzzle()
+        except ValueError:
+            continue
+        if _validate_generated(grid, expected, tile, specs, liar_idx, wrong_shift):
