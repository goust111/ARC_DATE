+    expected = liar["correct_patch"]
+    return grid, expected, tile, specs, liar_idx, wrong_shift
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    tile: np.ndarray,
+    specs: list[dict],
+    liar_idx: int,
+    wrong_shift: tuple[int, int],
+) -> bool:
+    detected = _detect_windows(grid)
+    if len(detected) != len(specs):
