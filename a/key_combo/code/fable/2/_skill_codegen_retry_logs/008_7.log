+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _sample_tile(tile: np.ndarray, top: int, left: int, height: int, width: int) -> np.ndarray:
+    pr, pc = tile.shape
+    patch = np.zeros((height, width), dtype=int)
+    for r in range(height):
+        for c in range(width):
+            patch[r, c] = int(tile[(top + r) % pr, (left + c) % pc])
+    return patch
+
+
+def _periodic_under(tile: np.ndarray, pr: int, pc: int) -> bool:
+    rows, cols = tile.shape
+    for r in range(rows):
+        for c in range(cols):
+            if int(tile[r, c]) != int(tile[r % pr, c % pc]):
+                return False
