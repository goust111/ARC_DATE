+    best_rank = _candidate_rank(best)
+    conflicting = [
+        cand
+        for cand in candidates
+        if _candidate_rank(cand) == best_rank
+        and (
+            cand["liar_idx"] != liar_idx
+            or cand["expected"].shape != expected.shape
+            or cand["expected"].tobytes() != expected.tobytes()
+        )
+    ]
+    if conflicting:
+        return False
+
+    return True
