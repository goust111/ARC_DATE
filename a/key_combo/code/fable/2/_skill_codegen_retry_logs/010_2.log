from __future__ import annotations

import numpy as np


BG = 0
WALL = 5
MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
GEN_ATTEMPTS = 400


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
    mask = grid == int(color)
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[np.ndarray] = []
    h, w = grid.shape
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for dr, dc in DIRS4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    out: list[tuple[int, int]] = []
    for c in range(c0, c1 + 1):
        out.append((r0, c))
        out.append((r1, c))
    for r in range(r0 + 1, r1):
        out.append((r, c0))
        out.append((r, c1))
    return out


def _gap_side(room: dict, gap: tuple[int, int]) -> str:
    r0, c0, r1, c1 = room["bbox"]
    r, c = gap
    if c == c0:
        return "left"
    if c == c1:
        return "right"
    if r == r0:
        return "top"
    return "bottom"


def _detect_rooms(grid: np.ndarray) -> list[dict]:
    rooms: list[dict] = []
    for coords in _components_of_color(grid, WALL):
        r0, c0, r1, c1 = _bbox_coords(coords)
        if r1 - r0 < 3 or c1 - c0 < 3:
            continue
        coord_set = {tuple(map(int, rc)) for rc in coords.tolist()}
        border = _perimeter_cells((r0, c0, r1, c1))
        border_set = set(border)
        if any(pt not in border_set for pt in coord_set):
            continue

        gaps: list[tuple[int, int]] = []
        ok = True
        for r, c in border:
            v = int(grid[r, c])
            if v == WALL:
                continue
            if v == BG and r not in (r0, r1) or v == BG and c not in (c0, c1):
                ok = False
                break
            if v == BG and (r, c) not in ((r0, c0), (r0, c1), (r1, c0), (r1, c1)):
                gaps.append((r, c))
                continue
            ok = False
            break
        if not ok or not (1 <= len(gaps) <= 2):
            continue

        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
        if interior.size == 0 or np.any(interior != BG):
            continue

        if len(coord_set) != len(border) - len(gaps):
            continue

        rooms.append(
            {
                "bbox": (r0, c0, r1, c1),
                "gaps": tuple(gaps),
                "gap_set": set(gaps),
                "interior_slice": (slice(r0 + 1, r1), slice(c0 + 1, c1)),
            }
        )
    return rooms


def _marker_direction(shape: tuple[int, int], r: int, c: int) -> tuple[int, int] | None:
    h, w = shape
    if r == 0 and 0 < c < w - 1:
        return (1, 0)
    if r == h - 1 and 0 < c < w - 1:
        return (-1, 0)
    if c == 0 and 0 < r < h - 1:
        return (0, 1)
    if c == w - 1 and 0 < r < h - 1:
        return (0, -1)
    return None


def _is_entry_gap(room: dict, gap: tuple[int, int], dr: int, dc: int) -> bool:
    side = _gap_side(room, gap)
    return (
        (dr, dc) == (0, 1)
        and side == "left"
        or (dr, dc) == (0, -1)
        and side == "right"
        or (dr, dc) == (1, 0)
        and side == "top"
        or (dr, dc) == (-1, 0)
        and side == "bottom"
    )


def _opposite_wall_cell(room: dict, gap: tuple[int, int], dr: int, dc: int) -> tuple[int, int]:
    r0, c0, r1, c1 = room["bbox"]
    r, c = gap
    if (dr, dc) == (0, 1):
        return (r, c1)
    if (dr, dc) == (0, -1):
        return (r, c0)
    if (dr, dc) == (1, 0):
        return (r1, c)
    return (r0, c)


def _trace_marker(
    grid: np.ndarray,
    rooms: list[dict],
    gap_to_room: dict[tuple[int, int], int],
    marker: tuple[int, int],
) -> dict | None:
    drdc = _marker_direction(grid.shape, marker[0], marker[1])
    if drdc is None:
        return None
    dr, dc = drdc
    r, c = marker[0] + dr, marker[1] + dc
    passed: list[int] = []

    while _in_bounds(grid.shape, r, c):
        value = int(grid[r, c])
        if value == WALL:
            return None
        if value != BG:
            return None

        gap = (r, c)
        room_idx = gap_to_room.get(gap)
        if room_idx is not None:
            room = rooms[room_idx]
            if _is_entry_gap(room, gap, dr, dc):
                exit_gap = _opposite_wall_cell(room, gap, dr, dc)
                if exit_gap in room["gap_set"] and exit_gap != gap:
                    passed.append(room_idx)
                    r, c = exit_gap[0] + dr, exit_gap[1] + dc
                    continue
                return {
                    "marker": marker,
                    "color": int(grid[marker]),
                    "room_idx": room_idx,
                    "entry_gap": gap,
                    "passed_rooms": tuple(passed),
                }
        r += dr
        c += dc

    return None


def _solve(grid: np.ndarray, *, return_debug: bool = False):
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    rooms = _detect_rooms(g)
    gap_to_room: dict[tuple[int, int], int] = {}
    for idx, room in enumerate(rooms):
        for gap in room["gaps"]:
            gap_to_room[gap] = idx

    markers: list[tuple[int, int]] = []
    h, w = g.shape
    for r in range(h):
        for c in range(w):
            if r not in (0, h - 1) and c not in (0, w - 1):
                continue
            if int(g[r, c]) not in MARKER_COLORS:
                continue
            if _marker_direction(g.shape, r, c) is None:
                continue
            markers.append((r, c))
    markers.sort()

    raw_events = []
    for marker in markers:
        event = _trace_marker(g, rooms, gap_to_room, marker)
        if event is not None:
            raw_events.append(event)

    chosen_events: list[dict] = []
    used_rooms: set[int] = set()
    for event in raw_events:
        if event["room_idx"] in used_rooms:
            continue
        used_rooms.add(event["room_idx"])
        chosen_events.append(event)

    out = g.copy()
    for event in chosen_events:
        room = rooms[event["room_idx"]]
        rs, cs = room["interior_slice"]
        fill_mask = out[rs, cs] == BG
        out[rs, cs][fill_mask] = event["color"]
        er, ec = event["entry_gap"]
        out[er, ec] = WALL
        mr, mc = event["marker"]
        out[mr, mc] = BG

    if return_debug:
        return out, {"rooms": rooms, "markers": markers, "events": chosen_events, "raw_events": raw_events}
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fire each edge marker straight through room doors so only the ray trapped inside a room captures it.

    Input structure:
    - Black background with several gray one-cell-thick hollow rectangles acting as rooms.
    - Each room has one or two one-cell wall gaps.

