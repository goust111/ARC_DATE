+            footprint = _stamp_cells(anchor, rel_source, cell)
+            if any(not in_bounds(grid_shape, rr, cc) for rr, cc in footprint):
+                continue
+            if any(_too_close(footprint, region, gap=1) for region in forbidden_regions):
