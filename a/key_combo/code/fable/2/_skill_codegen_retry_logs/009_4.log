+    start = next(iter(cells))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in NEIGH4:
+            nbr = (r + dr, c + dc)
+            if nbr in cells and nbr not in seen:
+                seen.add(nbr)
+                stack.append(nbr)
+    return len(seen) == len(cells)
+
