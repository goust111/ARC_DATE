+def build_candidate_tiles(correct_patch: np.ndarray, palette: list[int], count: int) -> list[np.ndarray]:
+    tiles: list[np.ndarray] = [np.rot90(correct_patch, random.randrange(4))]
+    near_one = mutate_patch(correct_patch, palette, 1)
+    near_two = mutate_patch(correct_patch, palette, 2)
+    tiles.append(np.rot90(near_one, random.randrange(4)))
+    tiles.append(np.rot90(near_two, random.randrange(4)))
+    while len(tiles) < count:
+        if random.random() < 0.5:
+            extra = mutate_patch(correct_patch, palette, random.choice((1, 2)))
+        else:
+            extra = random_patch(correct_patch.shape[0], palette)
+        tiles.append(np.rot90(extra, random.randrange(4)))
+    random.shuffle(tiles)
+    return tiles
