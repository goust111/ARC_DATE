+    side: int,
+    left_box: tuple[int, int, int, int],
+    right_box: tuple[int, int, int, int],
+) -> list[tuple[int, int, int, int]]:
+    h, w = pattern.shape
+    blocked = [left_box, right_box]
+    options: list[tuple[int, int, int, int]] = []
+    for r0 in range(1, h - side):
