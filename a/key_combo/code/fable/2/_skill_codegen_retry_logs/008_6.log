+def mutate_patch(tile: np.ndarray, palette: list[int], changes: int) -> np.ndarray:
+    out = tile.copy()
+    cells = random.sample([(r, c) for r in range(tile.shape[0]) for c in range(tile.shape[1])], changes)
+    for r, c in cells:
