+
+    unique_outputs: dict[bytes, np.ndarray] = {}
+    for item in passed:
+        out = item["output"]
+        unique_outputs[out.tobytes() + str(out.shape).encode()] = out
+    assert len(unique_outputs) == 1, "expected a unique repaired output"
