+def fill_box(dst: np.ndarray, box: tuple[int, int, int, int], tile: np.ndarray) -> None:
+    r0, c0, r1, c1 = box
+    assert tile.shape == (r1 - r0 + 1, c1 - c0 + 1)
+    dst[r0 : r1 + 1, c0 : c1 + 1] = tile
