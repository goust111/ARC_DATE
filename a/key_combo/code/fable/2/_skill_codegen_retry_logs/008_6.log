+        shown = np.rot90(source, random.randrange(4))
+        if min_dihedral_distance(shown, correct_patch) == 0:
+            return False
+        if any(min_dihedral_distance(shown, existing) == 0 for existing in tiles):
+            return False
+        tiles.append(shown)
+        return True
+
+    while len(tiles) < min(count, 3):
