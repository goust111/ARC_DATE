+        center = np.array([random.choice(palette) for _ in range(height)], dtype=int)[:, None]
+        pattern = np.concatenate([left, center, np.fliplr(left)], axis=1)
+    else:
+        pattern = np.concatenate([left, np.fliplr(left)], axis=1)
