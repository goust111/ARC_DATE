+    for tile_idx, tile in enumerate(tiles):
+        for rot in range(4):
+            oriented = np.rot90(tile, rot)
+            for anchor_left in (True, False):
+                trial = pattern.copy()
+                if anchor_left:
+                    left_tile = oriented
+                    right_tile = np.fliplr(oriented)
+                else:
+                    right_tile = oriented
+                    left_tile = np.fliplr(oriented)
