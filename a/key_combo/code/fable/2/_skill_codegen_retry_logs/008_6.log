+            fill_box(holed, left_box, np.zeros((side, side), dtype=int))
+            fill_box(holed, right_box, np.zeros((side, side), dtype=int))
+
+            grid = assemble_grid(holed, tiles)
+            if grid is None:
+                continue
+            if semantic_checks(grid):
+                return grid
+    return None
