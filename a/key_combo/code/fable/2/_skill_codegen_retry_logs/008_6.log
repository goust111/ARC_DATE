+    info = {
+        "pattern": pattern,
+        "singleton": singleton,
+        "left_box": left_box,
+        "right_box": right_box,
+        "tiles": tiles,
+        "passed": passed,
+    }
+    return next(iter(unique_outputs.values())).copy(), info
