0041:     The colored marker pixels are ports: matching colors specify which objects must touch, and
0042:     the marker's side of its object determines the direction of the translation.
0043:     """
0044:     g = np.asarray(grid, dtype=int)
0045:     bg = get_bg(g)
0046: 
0047:     fg = g[g != bg]
0048:     assert fg.size > 0
0049:     values, counts = np.unique(fg, return_counts=True)
0050:     max_count = int(counts.max())
0051:     body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]
0052:     assert len(body_candidates) == 1
0053:     body = body_candidates[0]
0054:     marker_colors = {int(v) for v in values if int(v) != body}
0055:     assert marker_colors
0056: 
0057:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0058:     assert len(components) >= 2
