0092: def main(grid: np.ndarray) -> np.ndarray:
0093:     """Copy the existing foreground sprite into every three-marker corner frame, reflecting it to the frame's missing corner.
0094: 
0095:     Input structure
0096:     - The background is the dominant color.
0097:     - One non-background color forms singleton marker pixels; every three markers are three corners of a same-size square.
0098:     - The other non-background color forms one sprite mask already placed at the missing corner of one marker square.
0099: 
0100:     Rule
0101:     - Find the source marker square whose missing corner touches the corresponding corner of the sprite bbox.
0102:     - For every marker square with the same side length, place a copy of that sprite outside the square at its missing corner.
0103:     - Reflect the sprite vertically and/or horizontally when the target missing corner lies in a different quadrant from the source missing corner.
0104:     - If the source bbox is a complete hollow square border, keep the corner-bracket motif selected by the source anchor.
0105: 
0106:     Key insight
0107:     - The yellow three-corner squares are control frames: their absent fourth corner gives both the anchor point and the quadrant for the red sprite copy.
0108:     """
0109:     g = np.asarray(grid, dtype=int)
0110:     bg = get_bg(g)
0111:     colors = colors_present(g, exclude={bg})
0112:     assert len(colors) == 2
0113: 
0114:     singleton_colors = [
0115:         color
0116:         for color in colors
0117:         if all(len(component) == 1 for component in components_mask(g == color, connectivity=8))
0118:     ]
0119:     assert len(singleton_colors) == 1
0120:     marker_color = singleton_colors[0]
0121:     sprite_colors = [color for color in colors if color != marker_color]
0122:     assert len(sprite_colors) == 1
0123:     sprite_color = sprite_colors[0]
0124: 
0125:     sprite_coords = np.argwhere(g == sprite_color)
0126:     assert len(sprite_coords) > 0
0127:     sprite_box = bbox_coords(sprite_coords)
0128:     r0, c0, r1, c1 = sprite_box
0129:     sprite = np.where(g[r0 : r1 + 1, c0 : c1 + 1] == sprite_color, sprite_color, bg)
0130:     sprite_h, sprite_w = sprite.shape
0131:     assert sprite_h == sprite_w
0132: 
0133:     source_controls = [
0134:         control
0135:         for control in _three_corner_squares(g, marker_color)
0136:         if _corner_matches_bbox(control["missing_kind"], control["missing"], sprite_box)
0137:     ]
0138:     assert len(source_controls) == 1
0139:     source = source_controls[0]
0140: 
0141:     controls = _three_corner_squares(g, marker_color, side=source["side"])
0142:     marker_coords = [tuple(map(int, p)) for p in np.argwhere(g == marker_color)]
0143:     used_markers = [marker for control in controls for marker in control["markers"]]
0144:     assert sorted(used_markers) == sorted(marker_coords)
0145: 
0146:     out = g.copy()
0147:     H, W = g.shape
0148:     source_sign = CORNER_SIGN[source["missing_kind"]]
0149:     sprite = _corner_border_motif(sprite, sprite_color, bg, source_sign)
0150:     out[g == sprite_color] = bg
0151: 
0152:     for control in controls:
0153:         target_sign = CORNER_SIGN[control["missing_kind"]]
0154:         oriented = sprite.copy()
0155:         if source_sign[0] != target_sign[0]:
0156:             oriented = oriented[::-1, :]
0157:         if source_sign[1] != target_sign[1]:
0158:             oriented = oriented[:, ::-1]
0159: 
0160:         anchor_r, anchor_c = control["missing"]
0161:         paste_r = anchor_r - sprite_h + 1 if target_sign[0] < 0 else anchor_r
0162:         paste_c = anchor_c - sprite_w + 1 if target_sign[1] < 0 else anchor_c
0163:         assert 0 <= paste_r and 0 <= paste_c
0164:         assert paste_r + sprite_h <= H and paste_c + sprite_w <= W
0165: 
0166:         sprite_mask = oriented == sprite_color
0167:         target = out[paste_r : paste_r + sprite_h, paste_c : paste_c + sprite_w]
0168:         assert np.all((target[sprite_mask] == bg) | (target[sprite_mask] == sprite_color))
0169:         target[sprite_mask] = sprite_color
0170: 
0171:     return out
0172: 
