1079: # =============================================================================
1080: # Symmetry + sprite generation (ported from seeds/common.py, but canonical r/c semantics)
1081: # =============================================================================
1082: 
1083: 
1084: class Symmetry:
1085:     """
1086:     Symmetry transformations.
1087: 
1088:     Subclasses implement:
1089:         apply(r,c,iters=1) -> (r',c')
1090:         _iter_range(shape) -> (start, stop) range tuple, used by orbit()
1091:     """
1092: 
1093:     def apply(self, r, c, iters: int = 1):
1094:         raise NotImplementedError
1095: 
1096:     def _iter_range(self, grid_shape: tuple[int, int]):
1097:         raise NotImplementedError
1098: 
1099: 
1100: def orbit(grid: np.ndarray, r: int, c: int, symmetries: Sequence[Symmetry]) -> list[tuple[int, int]]:
1101:     """Compute the orbit of (r,c) under the provided symmetries."""
1102:     all_possible: list[tuple[int, int]] = []
1103:     possible_iterations = itertools.product(*[list(range(*s._iter_range(grid.shape))) for s in symmetries])
1104:     for iters in possible_iterations:
1105:         rr, cc = int(r), int(c)
1106:         for sym, i in zip(symmetries, iters):
1107:             rr, cc = sym.apply(rr, cc, i)
1108:             if not (0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1]):
1109:                 break
1110:         else:
1111:             all_possible.append((int(rr), int(cc)))
1112:     return list(set(all_possible))
1113: 
1114: 
1115: class TranslationalSymmetry(Symmetry):
1116:     """Translation symmetry by a fixed vector (dr,dc)."""
1117: 
1118:     def __init__(self, dr: int | None = None, dc: int | None = None, **kwargs):
1119:         # Legacy keyword aliases (deprecated): translate_x->dr, translate_y->dc
1120:         tx, used_tx = _consume_alias(kwargs, "dr", ["translate_x"])
1121:         ty, used_ty = _consume_alias(kwargs, "dc", ["translate_y"])
1122:         if dr is None and tx is not None:
1123:             if used_tx == "translate_x":
1124:                 warnings.warn("TranslationalSymmetry: 'translate_x' is deprecated; use 'dr'", DeprecationWarning, stacklevel=2)
1125:             dr = tx
1126:         if dc is None and ty is not None:
1127:             if used_ty == "translate_y":
1128:                 warnings.warn("TranslationalSymmetry: 'translate_y' is deprecated; use 'dc'", DeprecationWarning, stacklevel=2)
1129:             dc = ty
1130:         if dr is None or dc is None:
1131:             raise TypeError("TranslationalSymmetry: must provide dr,dc")
1132:         if kwargs:
1133:             raise TypeError(f"TranslationalSymmetry: unexpected keyword arguments: {sorted(kwargs.keys())}")
1134:         self.dr, self.dc = int(dr), int(dc)
1135: 
1136:     def apply(self, r, c, iters: int = 1):
1137:         r = r + int(iters) * self.dr
1138:         c = c + int(iters) * self.dc
1139:         if isinstance(r, np.ndarray):
1140:             r = r.astype(int)
1141:         if isinstance(c, np.ndarray):
1142:             c = c.astype(int)
