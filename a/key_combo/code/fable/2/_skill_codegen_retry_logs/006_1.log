0001: from __future__ import annotations
0002: import numpy as np
0003: from arc_utils import bbox_h, find_components, get_bg, randomly_spaced_indices
0004: from arc_utils import paste
0005: 
0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Sort vertical bars by height and redistribute them across fixed colored slots.
0009: 
0010:     Input structure:
0011:     - bg background; a horizontal base line of a single color spans the full grid width.
0012:     - Several monochrome vertical bars of distinct colors rise upward from the base line.
0013: 
0014:     Rule:
0015:     - Rank bar shapes by height (shortest to tallest).
0016:     - Rank original x-positions (slots) left to right.
0017:     - Place the i-th shortest shape into the i-th leftmost slot, recoloring it to that slot's original color.
0018:     - The base line is preserved unchanged.
0019: 
0020:     Key insight: Each slot keeps its x-position and color identity; only the bar silhouettes are redistributed among slots by height order.
0021:     """
0022:     g = np.array(grid, dtype=int)
0023:     H, W = g.shape
0024:     bg = int(get_bg(g))
0025: 
0026:     # Base row/color = (row,color) with maximal count on that row (excluding bg).
0027:     best = None  # (count, row, color)
0028:     for r in range(H):
0029:         vals, counts = np.unique(g[r, :], return_counts=True)
0030:         for v, cnt in zip(vals, counts):
0031:             v = int(v)
0032:             cnt = int(cnt)
0033:             if v == bg:
0034:                 continue
0035:             if best is None or cnt > best[0]:
0036:                 best = (cnt, int(r), int(v))
0037:     assert not (best is None)
0038:     _cnt, base_r, base_col = best
0039: 
0040:     objects: list[dict[str, object]] = []
0041:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
0042:         col = int(comp["color"])
0043:         if col in {int(bg), int(base_col)}:
0044:             continue
0045: 
0046:         pts = comp["coords"]
0047:         b = comp["bbox"]
0048:         height = int(bbox_h(b))
0049: 
0050:         base_cols = sorted(int(c) for r, c in pts if int(r) == int(base_r))
0051:         if base_cols:
0052:             anchor = int(base_cols[len(base_cols) // 2])
0053:         else:
0054:             cols_sorted = sorted(int(c) for _r, c in pts)
0055:             anchor = int(cols_sorted[len(cols_sorted) // 2])
0056: 
0057:         rel = [(int(r) - int(base_r), int(c) - int(anchor)) for r, c in pts]
0058:         objects.append(
0059:             {
0060:                 "color": int(col),
0061:                 "anchor": int(anchor),
0062:                 "height": int(height),
0063:                 "size": int(len(rel)),
0064:                 "rel": rel,
0065:             }
0066:         )
0067: 
0068:     # Slots are determined by original x-positions; slot colors must be preserved.
0069:     slots = sorted(objects, key=lambda o: (int(o["anchor"]), int(o["color"])))
0070:     # Shapes are ordered by height (shortest -> tallest).
0071:     shapes = sorted(objects, key=lambda o: (int(o["height"]), int(o["size"]), int(o["anchor"]), int(o["color"])))
0072: 
0073:     out = np.full_like(g, bg)
