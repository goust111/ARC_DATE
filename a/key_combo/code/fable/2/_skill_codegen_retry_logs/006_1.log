0071: GEN_BACKGROUND, GEN_FOREGROUND, GEN_FRAME = Color.BLACK, Color.RED, Color.GREEN
0072: GEN_NEIGHBOR4_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))
0073: GEN_ORIENTATION_COUNT = 2
0074: GEN_MAX_ATTEMPTS = 300
