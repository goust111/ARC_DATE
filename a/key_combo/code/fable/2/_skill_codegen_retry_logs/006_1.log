0091: def main(grid: np.ndarray) -> np.ndarray:
0092:     """
0093:     Rotate each 2x2 block's four diagonal corner colors clockwise, then extend the rotated colors outward as diagonal rays.
0094: 
0095:     Input structure
0096:     - The background is the dominant color.
0097:     - One foreground color forms one or more solid 2x2 blocks.
0098:     - Each block has four non-background, non-block corner pixels diagonally adjacent to it.
0099: 
0100:     Rule
0101:     - Around every block, move the NW corner color to NE, NE to SE, SE to SW, and SW to NW.
0102:     - From each rotated corner, paint along the outward diagonal until the grid edge or another 2x2 block is reached.
0103:     - If a ray reaches a same-colored outgoing corner of another block that has its own visible continuation, stop the incoming ray at that junction.
0104: 
0105:     Key insight
0106:     - The 2x2 blocks are color rotators and ray blockers; the corner pixels are not independent dots but the four ports of each block.
0107:     """
0108:     g = np.asarray(grid, dtype=int)
0109:     assert g.ndim == 2
0110:     bg = int(get_bg(g))
0111:     block_color = _block_color(g, bg)
0112: 
0113:     rays: list[Ray] = []
0114:     h, w = g.shape
0115:     for r0, c0 in _blocks(g, block_color, bg):
0116:         corner_colors: dict[str, int] = {}
0117:         for corner, (dr, dc) in CORNER_OFFSETS.items():
0118:             r = r0 + dr
0119:             c = c0 + dc
0120:             assert 0 <= r < h and 0 <= c < w, "expected all four block corners in bounds"
0121:             color = int(g[r, c])
0122:             assert color != bg and color != block_color, "expected colored corner ports around each block"
0123:             corner_colors[corner] = color
0124: 
0125:         for corner, offset in CORNER_OFFSETS.items():
0126:             start = (r0 + offset[0], c0 + offset[1])
0127:             color = corner_colors[ROTATED_SOURCE[corner]]
0128:             path = _ray_path(g, start, DIAGONAL_DIRS[corner], block_color)
0129:             rays.append((start, color, path))
0130: 
0131:     starts_by_color: dict[int, set[tuple[int, int]]] = {}
0132:     path_len: dict[tuple[int, tuple[int, int]], int] = {}
0133:     for start, color, path in rays:
0134:         starts_by_color.setdefault(color, set()).add(start)
0135:         path_len[(color, start)] = len(path)
0136: 
0137:     planned: dict[tuple[int, int], int] = {}
0138:     for start, color, path in rays:
0139:         keep = len(path)
0140:         other_starts = starts_by_color[color] - {start}
0141:         for i, cell in enumerate(path):
0142:             if i == 0:
0143:                 continue
0144:             for nr, nc in neighbors4(*cell):
0145:                 other_start = (int(nr), int(nc))
0146:                 if other_start in other_starts and path_len[(color, other_start)] > 1:
0147:                     keep = i + 1
0148:                     break
0149:             if keep != len(path):
0150:                 break
0151: 
0152:         for cell in path[:keep]:
0153:             previous = planned.get(cell)
0154:             assert previous is None or previous == color, "conflicting rays must not overlap"
0155:             planned[cell] = color
0156: 
0157:     out = g.copy()
0158:     for (r, c), color in planned.items():
0159:         out[r, c] = color
0160:     return out
0161: 
