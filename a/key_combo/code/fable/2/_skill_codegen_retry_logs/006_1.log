0001: from __future__ import annotations
0002: 
0003: import numpy as np
0004: 
0005: from arc_utils import find_components, get_bg, paste
0006: import random
0007: 
0008: 
0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Summarize the largest foreground object-size class as solid vertical color bars.
0012: 
0013:     Input structure:
0014:     - The input has a dominant background color and several monochromatic
0015:       4-connected foreground objects.
0016:     - Each foreground color appears as exactly one object.
0017:     - The largest objects have distinct left edges, giving a unique left-to-right
0018:       ordering.
0019: 
0020:     Rule:
0021:     - Find the maximum foreground object area.
0022:     - Keep exactly the objects with that area.
0023:     - Build an output whose height is that maximum area and whose columns are
0024:       filled with the kept object colors in left-to-right input order.
0025: 
0026:     Key insight:
0027:     - The original shapes are distractors; only object area and horizontal order
0028:       survive, so each selected object collapses to a same-color vertical bar.
0029:     """
0030:     g = np.asarray(grid, dtype=int)
0031:     assert g.ndim == 2, "expected a 2D grid"
0032: 
0033:     bg = get_bg(g)
0034:     objects = find_components(
0035:         g,
0036:         bg=bg,
0037:         connectivity=4,
0038:         monochromatic=True,
0039:         return_format="dict",
0040:     )
0041:     assert objects, "expected at least one foreground object"
0042: 
0043:     colors = [int(obj["color"]) for obj in objects]
0044:     assert len(colors) == len(set(colors)), "each foreground color must form one object"
0045: 
0046:     max_area = max(int(obj["area"]) for obj in objects)
0047:     largest = [obj for obj in objects if int(obj["area"]) == max_area]
0048: 
0049:     left_edges = [int(obj["bbox"][1]) for obj in largest]
0050:     assert len(left_edges) == len(
0051:         set(left_edges)
0052:     ), "largest objects need unique left-to-right order"
0053:     largest.sort(key=lambda obj: int(obj["bbox"][1]))
0054: 
0055:     out = np.empty((max_area, len(largest)), dtype=int)
0056:     for col, obj in enumerate(largest):
0057:         out[:, col] = int(obj["color"])
0058:     return out
0059: 
0060: # --------------- generator (o5x) ---------------
0061: 
0062: # Canvas and palette.
0063: CANVAS_SHAPE = (10, 10)
0064: BACKGROUND = 0
0065: COLOR_MIN, COLOR_MAX = 1, 9
0066: 
0067: # Blob shape bounds.
0068: BLOB_MIN_HEIGHT, BLOB_MAX_HEIGHT = 1, 6
0069: BLOB_MIN_WIDTH, BLOB_MAX_WIDTH = 1, 3
0070: FOUR_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))
0071: 
0072: # Object counts and sizes.
0073: COUNT_PAIRS = (
0074:     (1, 1), (1, 2), (1, 3), (2, 0), (2, 1),
0075:     (2, 2), (2, 3), (3, 0), (3, 1), (3, 2),
0076: )
0077: LARGEST_AREA_MIN = 3
0078: LARGEST_AREA_MAX = 9
0079: DISTRACTOR_AREA_MIN = 2
0080: 
0081: # Placement and retry policy.
