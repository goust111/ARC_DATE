0064:         sprites.append(sprite)
0065:         marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))
0066:         assert marker_locs.size > 0
0067:         for rr, cc in marker_locs:
0068:             r, c = int(rr), int(cc)
0069:             direction = _connector_dir(sprite, r, c)
0070:             marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))
0071: 
0072:     adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]
0073:     paired_markers = 0
0074:     for occurrences in marker_occurrences.values():
0075:         assert len(occurrences) in (1, 2)
