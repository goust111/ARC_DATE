+    side = random.choice(("top", "bottom", "left", "right"))
+    if side == "top":
+        return (0, random.randint(1, w - 2)), (1, 0)
+    if side == "bottom":
+        return (h - 1, random.randint(1, w - 2)), (-1, 0)
+    if side == "left":
+        return (random.randint(1, h - 2), 0), (0, 1)
