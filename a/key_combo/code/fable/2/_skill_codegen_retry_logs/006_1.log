0024: def main(grid: np.ndarray) -> np.ndarray:
0025:     """
0026:     Draw a green one-cell border around every adjacent red pair while leaving isolated red pixels unchanged.
0027: 
0028:     Input structure
0029:     - The grid is a black background containing only red foreground pixels.
0030:     - Each 4-connected red object is either a single pixel or a two-pixel horizontal/vertical domino.
0031: 
0032:     Rule
0033:     - Preserve all input pixels.
0034:     - For each red domino, expand its bounding box by one cell in all directions, clipped to the grid.
0035:     - Paint the perimeter of that expanded box green wherever it is currently black.
0036: 
0037:     Key insight
0038:     - The green marks are not drawn around all red pixels, only around the 4-connected red objects of area two.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     assert g.ndim == 2
0042:     assert set(np.unique(g)).issubset({Color.BLACK, Color.RED})
0043: 
0044:     red_objects = components_mask(g == Color.RED, connectivity=4)
0045:     assert red_objects
0046: 
0047:     out = g.copy()
0048:     domino_count = 0
0049:     for coords in red_objects:
0050:         area = int(coords.shape[0])
0051:         if area == 1:
0052:             continue
0053:         assert area == 2, "red objects must be isolated pixels or dominoes"
0054:         r0, c0, r1, c1 = bbox_coords(coords)
0055:         assert (r1 - r0) + (c1 - c0) == 1, "domino must be edge-connected"
0056:         _paint_expanded_border(out, (r0, c0, r1, c1))
0057:         domino_count += 1
0058: 
0059:     assert domino_count > 0
0060:     return out
