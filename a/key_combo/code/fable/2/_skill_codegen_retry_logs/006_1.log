+    options: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            red = (r, c)
+            for dr, dc in DIRS:
+                green = (r + dr, c + dc)
+                if not _can_place_pair(shape, red, green, blocked):
+                    continue
+                if red in forbidden_cells or green in forbidden_cells:
