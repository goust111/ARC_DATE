+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+EMITTER_COLORS = (1, 4, 5, 6, 7, 8, 9)
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GEN_ATTEMPTS = 400
+MIN_CONTACT_STEP = 2
+MIN_EXIT_STEPS = 2
+
+
+def _in_bounds(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
+    r, c = cell
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _is_boundary(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
+    r, c = cell
+    h, w = shape
+    return r == 0 or c == 0 or r == h - 1 or c == w - 1
+
+
+def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _ray_cells(
+    shape: tuple[int, int], pos: tuple[int, int], direction: tuple[int, int]
+) -> list[tuple[int, int]]:
+    r, c = pos
+    dr, dc = direction
+    out: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, (r, c)):
+            return out
+        out.append((r, c))
+
+
+def _step_on_ray(
+    pos: tuple[int, int], direction: tuple[int, int], cell: tuple[int, int]
+) -> int | None:
+    pr, pc = pos
+    dr, dc = direction
+    r, c = cell
+    if dr != 0:
+        if c != pc:
+            return None
+        delta = r - pr
+        if delta * dr <= 0:
+            return None
+        return delta // dr
+    if r != pr:
+        return None
+    delta = c - pc
+    if delta * dc <= 0:
+        return None
+    return delta // dc
+
+
+def _rg_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    mask = (grid == RED) | (grid == GREEN)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
