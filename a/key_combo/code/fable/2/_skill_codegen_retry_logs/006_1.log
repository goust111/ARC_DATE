0208: def main(grid: np.ndarray) -> np.ndarray:
0209:     """
0210:     Convert a rough nested line drawing into a clean canonical frame-and-dot diagram.
0211: 
0212:     Input structure:
0213:     - The grid has one background color and one foreground color.
0214:     - Foreground 4-connected objects are rough closed frames or small filled blobs.
0215:     - Frames may contain other frames/blobs; blobs outside a frame remain outside it.
0216: 
0217:     Rule:
0218:     - Detect the containment tree of foreground objects using holes of each frame object.
0219:     - Replace every blob with one foreground pixel.
0220:     - Replace every frame with a rectangular border padded two cells around its direct children.
0221:     - Place siblings by their original row/column overlap and order, with one empty cell between canonical objects.
0222: 
0223:     Key insight: The exact wobbly geometry is irrelevant; only enclosure plus relative sibling positions define the output.
0224:     """
0225:     g = np.asarray(grid, dtype=int)
0226:     bg = int(get_bg(g))
0227:     fg_colors = sorted(set(map(int, g.flatten())) - {bg})
0228:     assert len(fg_colors) == 1
0229:     fg = int(fg_colors[0])
0230: 
0231:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg], return_format="dict")
0232:     assert comps
0233: 
0234:     nodes: list[_Node] = []
0235:     holes: list[list[np.ndarray]] = []
0236:     for comp in comps:
0237:         coords = np.asarray(comp["coords"], dtype=int)
0238:         node = _Node(
0239:             coords=coords,
0240:             bbox=tuple(map(int, comp["bbox"])),
0241:             center=coords.mean(axis=0),
0242:         )
0243:         node_holes = _component_holes(g.shape, coords)
0244:         node.is_frame = bool(node_holes)
0245:         nodes.append(node)
0246:         holes.append(node_holes)
0247: 
0248:     assert any(node.is_frame for node in nodes)
0249:     for node_i, node in enumerate(nodes):
0250:         containers = []
0251:         for frame_i, frame in enumerate(nodes):
0252:             if node_i == frame_i or not frame.is_frame:
0253:                 continue
0254:             if any(np.all(hole[tuple(node.coords.T)]) for hole in holes[frame_i]):
0255:                 containers.append(frame)
0256:         if containers:
0257:             node.parent = min(containers, key=lambda item: int(item.coords.shape[0]))
0258:             node.parent.children.append(node)
0259: 
0260:     roots = [node for node in nodes if node.parent is None]
0261:     mask = _layout_root(roots)
0262:     out = np.full(mask.shape, bg, dtype=int)
0263:     out[mask] = fg
0264:     return out
