0386: def _turn_ratio(path):
0387:     """Fraction of direction changes along a cyclic path."""
0388:     dirs = []
0389:     cyc = path + [path[0]]
0390:     for (r0, c0), (r1, c1) in zip(cyc, cyc[1:]):
0391:         dirs.append((r1 - r0, c1 - c0))
0392:     turns = sum(1 for a, b in zip(dirs, dirs[1:] + [dirs[0]]) if a != b)
0393:     return turns / len(path)
