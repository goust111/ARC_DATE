+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
+MOVE_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
