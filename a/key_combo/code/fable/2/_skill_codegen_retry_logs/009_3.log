+
+    return (
+        anchored_by_color[int(Color.GREY)] >= 1
+        and anchored_by_color[int(Color.RED)] >= 1
+        and deleted_by_color[int(Color.GREY)] >= 1
+        and deleted_by_color[int(Color.RED)] >= 1
