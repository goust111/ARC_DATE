/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

path = Path('/home/lixinyu/snap/a/key_combo/code/fable/2/006/2.py')
mod = SourceFileLoader('arc_fix_target_validate', str(path)).load_module()

variants = set()
max_input_dim = 0
max_output_dim = 0
for i in range(200):
    grid = mod.generate_input()
    if not isinstance(grid, np.ndarray) or grid.ndim "'!= 2:
        raise AssertionError(f'"'input #{i} is not 2D ndarray')
    out = mod.main(grid)
    if not isinstance(out, np.ndarray) or out.ndim "'!= 2:
        raise AssertionError(f'"'output #{i} is not 2D ndarray')
    max_input_dim = max(max_input_dim, *grid.shape)
    max_output_dim = max(max_output_dim, *out.shape)
    if max(grid.shape) > 30:
        raise AssertionError(f'input #{i} exceeds 30: {grid.shape}')
    if max(out.shape) > 30:
        raise AssertionError(f'output #{i} exceeds 30: {out.shape}')
    variants.add((tuple(grid.shape), tuple(grid.ravel().tolist())))

print({
    'runs': 200,
    'input_variants': len(variants),
    'max_input_dim': max_input_dim,
    'max_output_dim': max_output_dim,
})
