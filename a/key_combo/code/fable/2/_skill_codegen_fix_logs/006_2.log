from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import Counter
import numpy as np
import random

path = Path('/home/lixinyu/snap/a/key_combo/code/fable/2/006/2.py')
mod = SourceFileLoader('arc_fix_target_diag3', str(path)).load_module()

def alt_place_structures(patches):
    sizes = [tuple(map(int, patch.shape)) for patch in patches]
    packed = mod._pack_rectangles(
        sizes,
        gap=2,
        min_h=max(max(h for h, _w in sizes), 16),
        min_w=max(max(w for _h, w in sizes), 16),
        max_h=mod.MAX_GRID_SIDE,
        max_w=mod.MAX_GRID_SIDE,
        tries_per_canvas=60,
    )
    if packed is None:
        return None
    base_h, base_w, positions = packed
    total_fg = sum(int(patch.sum()) for patch in patches)
    for _ in range(30):
        extra_h = random.randint(0, mod.MAX_GRID_SIDE - base_h)
        extra_w = random.randint(0, mod.MAX_GRID_SIDE - base_w)
        grid_h = base_h + extra_h
        grid_w = base_w + extra_w
        if grid_h * grid_w <= total_fg * 2:
            continue
        shift_r = random.randint(0, extra_h)
        shift_c = random.randint(0, extra_w)
        shifted = [(r + shift_r, c + shift_c) for r, c in positions]
        return grid_h, grid_w, shifted
    return None

reasons = Counter()
for i in range(500):
    built = mod._build_structure_patches()
    if built is None:
        reasons['build_none'] += 1
        continue
    patches, outlier_index, outlier_patch = built
    placed = alt_place_structures(patches)
    if placed is None:
        reasons['place_none'] += 1
        continue
    grid_h, grid_w, positions = placed
    colors = list(range(10))
    bg = random.choice(colors)
    fg = random.choice([color for color in colors if color "'!= bg])
    grid = np.full((grid_h, grid_w), bg, dtype=int)
    for patch, (r0, c0) in zip(patches, positions):
        h, w = patch.shape
        grid[r0:r0+h, c0:c0+w][patch] = fg
    expected = mod._paint_patch(outlier_patch, bg, fg)
    if mod._get_bg(grid) != bg:
        reasons['"'bg_mismatch'] += 1
        continue
    try:
        actual = mod.main(grid)
    except AssertionError:
        reasons['main_assert'] += 1
        continue
    if not np.array_equal(actual, expected):
        reasons['actual_mismatch'] += 1
        continue
    reasons['success'] += 1
print(reasons)
