reasons = Counter()
for i in range(300):
    try:
        built = mod._build_structure_patches()
    except Exception as e:
        reasons[f'build_exc:{type(e).__name__}:{e}'] += 1
        continue
    if built is None:
        reasons['build_none'] += 1
        continue
    patches, outlier_index, outlier_patch = built
    placed = mod._place_structures(patches)
