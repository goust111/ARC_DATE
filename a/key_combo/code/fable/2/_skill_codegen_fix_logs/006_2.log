        continue
    if mod._get_bg(grid) "'!= bg:
        reasons['"'bg_mismatch'] += 1
        continue
    try:
        actual = mod.main(grid)
    except AssertionError as e:
        reasons[f'main_assert:{e.args[0] if e.args else \"\"}'] += 1
        continue
    except Exception as e:
        reasons[f'main_exc:{type(e).__name__}:{e}'] += 1
        continue
    if not np.array_equal(actual, expected):
        reasons['actual_mismatch'] += 1
        continue
    reasons['success'] += 1

print(reasons)
