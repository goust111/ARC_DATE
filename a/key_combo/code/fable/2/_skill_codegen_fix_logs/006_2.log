    built = mod._build_structure_patches()
    if built is None:
        continue
    patches, outlier_index, outlier_patch = built
    placed = mod._place_structures(patches)
    if placed is None:
        continue
    grid_h, grid_w, positions = placed
    bg, fg = 0, 1
    grid = np.full((grid_h, grid_w), bg, dtype=int)
    for idx, (patch, (r0, c0)) in enumerate(zip(patches, positions)):
        h, w = patch.shape
        grid[r0:r0+h, c0:c0+w][patch] = fg
    try:
        out = mod.main(grid)
    except AssertionError:
        records = mod._component_records(grid, bg)
        roots = [idx for idx, rec in enumerate(records) if rec['parent'] is None]
        sigs = {root: mod._tree_signature(root, records) for root in roots}
        print('attempt', attempt)
        print('num_records', len(records), 'roots', roots)
        print('root sig counts', Counter(sigs.values()))
        print('patch shapes', [p.shape for p in patches], 'outlier', outlier_index)
        print('positions', positions)
        for i, p in enumerate(patches):
            print('PATCH', i)
            print(show(p))
            print()
        print('GRID')
        print(show(grid))
        break
else:
    print('no failing placed case found')
