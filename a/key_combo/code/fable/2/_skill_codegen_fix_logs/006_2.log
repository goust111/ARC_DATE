        h, w = patch.shape
        grid[r0 : r0 + h, c0 : c0 + w][patch] = fg

    expected = mod._paint_patch(outlier_patch, bg, fg)
    if max(grid.shape) > mod.MAX_GRID_SIDE or max(expected.shape) > mod.MAX_GRID_SIDE:
