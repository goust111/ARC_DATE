+def _choose_dimensions(steps: list[int]) -> tuple[int, int, list[int]] | None:
+    wall_count = len(steps)
+    top_gap = random.randint(1, 3)
+    between_gaps = [random.randint(1, 3) for _ in range(wall_count - 1)]
+    bottom_gap = random.randint(2, 4)
