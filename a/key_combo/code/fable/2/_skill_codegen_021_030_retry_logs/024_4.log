+        random.shuffle(positions)
+        placed = None
+        for dr, dc in positions[:200]:
+            cells = _translate_coords(shape, dr, dc)
+            footprint = _expanded(cells, (h, w))
+            if any(blocked[r, c] for r, c in footprint):
