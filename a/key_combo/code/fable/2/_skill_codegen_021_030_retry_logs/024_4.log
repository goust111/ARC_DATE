def _gen_bbox_for_bar(r: int, c: int, length: int, orientation: str) -> tuple[int, int, int, int]:
    radius = (length - 1) // 2
    if orientation == "H":
        return r - radius, c, r + radius, c + length - 1
    return r, c - radius, r + length - 1, c + radius


