+    border.extend(map(int, grid[h - 1, :]))
+    if h > 2:
+        border.extend(map(int, grid[1 : h - 1, 0]))
+        border.extend(map(int, grid[1 : h - 1, w - 1]))
+    return int(Counter(border).most_common(1)[0][0])
