def _gen_transform_grid(g: np.ndarray, side: str) -> np.ndarray:
    if side == "top":
        return g.copy()
    if side == "bottom":
        return np.flipud(g).copy()
    if side == "left":
        return np.rot90(g, 1).copy()
    if side == "right":
