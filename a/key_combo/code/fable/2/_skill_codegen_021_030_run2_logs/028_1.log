+    settled_occ = np.zeros(g.shape, dtype=bool)
+
+    for anchor in anchors:
+        coords = anchor["coords"]
+        out[coords[:, 0], coords[:, 1]] = anchor["color"]
+        anchor_occ[coords[:, 0], coords[:, 1]] = True
+
