+    return _transformed(grid)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            grid = _build_canonical()
+        except (AssertionError, RuntimeError, ValueError):
+            continue
+        if _validate_instance(grid):
+            return grid
