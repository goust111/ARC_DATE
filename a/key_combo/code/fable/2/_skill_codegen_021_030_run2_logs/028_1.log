+        if _symmetry_kind(mask) == "anchor":
+            return mask
+    raise RuntimeError("failed to generate a biaxial anchor shape")
+
+
+def _fits(occupied: np.ndarray, mask: np.ndarray, r0: int, c0: int, *, padding: int = 1) -> bool:
+    H, W = occupied.shape
+    coords = np.argwhere(mask)
+    for rr, cc in coords:
