+from arc_utils import Color, find_components, get_bg, paste
+
+
+BG = Color.BLACK
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+GEN_RETRIES = 400
+SHAPE_RETRIES = 120
+EXTRA_ANCHOR_PROB = 0.55
