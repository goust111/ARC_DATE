+def _mask_from_profile(profile: list[int], width: int) -> np.ndarray:
+    h = len(profile)
+    w = int(width)
+    mask = np.zeros((h, w), dtype=bool)
+    if w % 2 == 1:
+        center = w // 2
+        for r, ext in enumerate(profile):
+            mask[r, center - ext : center + ext + 1] = True
