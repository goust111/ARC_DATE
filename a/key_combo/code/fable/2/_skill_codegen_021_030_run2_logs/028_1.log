+def _make_vertical_mask(height: int, width: int) -> np.ndarray:
+    max_ext = width // 2 if width % 2 else width // 2 - 1
+    for _ in range(SHAPE_RETRIES):
+        profile = [random.randint(0, max_ext) for _ in range(height)]
