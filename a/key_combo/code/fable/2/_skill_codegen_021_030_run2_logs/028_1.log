+    w = int(width)
+    mask = np.zeros((h, w), dtype=bool)
+    if w % 2 == 1:
+        center = w // 2
+        for r, ext in enumerate(profile):
+            mask[r, center - ext : center + ext + 1] = True
+    else:
+        left_center = w // 2 - 1
+        right_center = w // 2
+        for r, ext in enumerate(profile):
+            mask[r, left_center - ext : right_center + ext + 1] = True
