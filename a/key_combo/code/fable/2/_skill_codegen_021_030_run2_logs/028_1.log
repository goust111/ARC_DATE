+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    if a["step"][0] != 0:
+        return _overlap_1d(ac0, ac1, bc0, bc1)
+    return _overlap_1d(ar0, ar1, br0, br1)
