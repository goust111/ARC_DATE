+
+def _stamp(grid: np.ndarray, occupied: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    patch = np.where(mask, int(color), BG).astype(int)
+    paste(grid, patch, int(r0), int(c0), transparent=BG)
