+            if not ignore_anchors and np.any(anchor_occ[nxt[:, 0], nxt[:, 1]]):
+                stop_reason = "anchor"
+                break
+            if np.any(settled_occ[nxt[:, 0], nxt[:, 1]]):
+                stop_reason = "settled"
+                break
+            coords = nxt
+
+        out[coords[:, 0], coords[:, 1]] = obj["color"]
+        settled_occ[coords[:, 0], coords[:, 1]] = True
+        if return_trace:
+            trace.append(
