def _gen_expand_lattice(cells: np.ndarray, cell_size: int, separator_color: int) -> np.ndarray:
    n = cells.shape[0]
    side = n * cell_size + (n - 1)
    grid = np.full((side, side), separator_color, dtype=int)
    for r in range(n):
        r0 = r * (cell_size + 1)
        for c in range(n):
            c0 = c * (cell_size + 1)
            grid[r0 : r0 + cell_size, c0 : c0 + cell_size] = cells[r, c]
    return grid


