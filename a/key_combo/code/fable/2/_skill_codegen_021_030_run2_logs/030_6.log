+    sides = ["top", "bottom", "left", "right"]
+    if kind == "repair_ring":
+        side = str(_RNG.choice(sides))
+        offset = int(_RNG.integers(1, w - 1)) if side in ("top", "bottom") else int(_RNG.integers(1, h - 1))
+        pts.remove(_gap_cell(h, w, side, offset))
+    elif kind == "double_gap_ring":
