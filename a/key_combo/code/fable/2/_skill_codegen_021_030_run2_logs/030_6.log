+
+def _build_wall(
+    shape: tuple[int, int],
+    repairable: bool,
+) -> tuple[np.ndarray, tuple[int, int, int, int], np.ndarray]:
+    h, w = shape
+    blocked = np.zeros(shape, dtype=bool)
+    orient = str(_RNG.choice(["v", "h"]))
+    small_span = int(_RNG.integers(2, 6))
+    side = str(_RNG.choice(["near_start", "near_end"]))
