+        off1 = int(_RNG.integers(1, w - 1)) if side1 in ("top", "bottom") else int(_RNG.integers(1, h - 1))
+        off2 = int(_RNG.integers(1, w - 1)) if side2 in ("top", "bottom") else int(_RNG.integers(1, h - 1))
+        pts.remove(_gap_cell(h, w, str(side1), off1))
+        pts.remove(_gap_cell(h, w, str(side2), off2))
