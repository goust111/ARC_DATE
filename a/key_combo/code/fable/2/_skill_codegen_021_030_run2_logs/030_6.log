+
+ORANGE = 7
+GREY = 5
+YELLOW = 4
+TEAL = 8
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+_RNG = np.random.default_rng()
+_GEN_COUNTER = 0
+
+GRID_MIN = 20
+GRID_MAX = 30
+MAX_GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 80
