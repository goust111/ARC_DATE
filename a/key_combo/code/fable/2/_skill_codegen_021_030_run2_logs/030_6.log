+    repairs: list[tuple[tuple[int, int], np.ndarray]] = []
+    for cell in _adjacent_background_cells(solid):
+        solid[cell] = True
+        split_components = _components_from_mask(~solid, connectivity=8)
+        solid[cell] = False
+        if len(split_components) != 2:
