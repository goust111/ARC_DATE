+        grid[wall_coords[:, 0], wall_coords[:, 1]] = GREY
+        blocked |= wall_blocked
+        objects.append({"coords": wall_coords, "rep": tuple(map(int, wall_coords[0])), "kind": "repairable" if family == 1 else "separator"})
