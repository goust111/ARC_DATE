+def _adjacent_background_cells(solid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = solid.shape
+    cells = set()
+    for r, c in np.argwhere(solid):
+        rr, cc = int(r), int(c)
+        for dr, dc in DIR8:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and not solid[nr, nc]:
+                cells.add((nr, nc))
+    return sorted(cells)
