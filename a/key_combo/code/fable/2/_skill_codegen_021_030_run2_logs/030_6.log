+
+def _gen_attempt(family: int) -> np.ndarray | None:
+    h = int(_RNG.integers(GRID_MIN, GRID_MAX + 1))
+    w = int(_RNG.integers(GRID_MIN, GRID_MAX + 1))
+    grid = np.full((h, w), ORANGE, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
