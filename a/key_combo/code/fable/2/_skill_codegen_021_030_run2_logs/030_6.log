+
+def _mark_rect(blocked: np.ndarray, bbox: tuple[int, int, int, int], margin: int = 1) -> None:
+    r0 = max(0, bbox[0] - margin)
+    c0 = max(0, bbox[1] - margin)
+    r1 = min(blocked.shape[0] - 1, bbox[2] + margin)
+    c1 = min(blocked.shape[1] - 1, bbox[3] + margin)
