+        {(0, 0), (0, 1), (0, 2), (1, 1)},
+        {(0, 1), (1, 0), (1, 1), (2, 1)},
+        {(0, 0), (1, 1), (2, 0), (2, 1)},
+    ]
+    pts = presets[int(_RNG.integers(0, len(presets)))]
+    if _RNG.random() < 0.35:
