+        fill_r, fill_c = analysis["fill"]
+        out[fill_r, fill_c] = TEAL
+        smaller = analysis["smaller"]
+        for r, c in smaller:
+            rr, cc = int(r), int(c)
+            if out[rr, cc] == ORANGE:
+                out[rr, cc] = YELLOW
+    return out
+
+
+def _normalize_coords(coords: set[tuple[int, int]]) -> np.ndarray:
+    arr = np.asarray(sorted(coords), dtype=int)
+    r0, c0, _, _ = _bbox_coords(arr)
+    arr[:, 0] -= r0
