+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+ORANGE = 7
+GREY = 5
+YELLOW = 4
+TEAL = 8
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+_RNG = np.random.default_rng()
