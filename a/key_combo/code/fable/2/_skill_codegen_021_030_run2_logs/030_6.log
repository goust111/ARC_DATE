+def _make_blob_local() -> np.ndarray:
+    box_h = int(_RNG.integers(3, 7))
+    box_w = int(_RNG.integers(3, 7))
+    target_area = int(_RNG.integers(4, min(9, box_h * box_w) + 1))
+    start = (int(_RNG.integers(0, box_h)), int(_RNG.integers(0, box_w)))
