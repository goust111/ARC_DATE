+        return 0, offset
+    if side == "bottom":
+        return h - 1, offset
+    if side == "left":
+        return offset, 0
+    if side == "right":
+        return offset, w - 1
+    raise ValueError("invalid side")
+
+
+def _make_ring_kind(kind: str) -> np.ndarray:
