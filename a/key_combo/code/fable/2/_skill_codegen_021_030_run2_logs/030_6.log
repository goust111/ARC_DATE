+def _components_from_mask(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    dirs = DIR8 if connectivity == 8 else DIR4
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.asarray(comp, dtype=int))
+    return out
+
+
+def _grey_components(grid: np.ndarray) -> list[np.ndarray]:
+    return _components_from_mask(grid == GREY, connectivity=8)
+
+
+def _adjacent_background_cells(solid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = solid.shape
+    cells = set()
+    for r, c in np.argwhere(solid):
