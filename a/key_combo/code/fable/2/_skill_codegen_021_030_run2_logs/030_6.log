+        gap_r = int(_RNG.integers(2, h - 2))
+        pts = {(r, c) for r in range(h)}
+        if repairable:
+            pts.remove((gap_r, c))
+            pts.add((gap_r, c + 1 if side == "near_start" else c - 1))
+        coords = np.asarray(sorted(pts), dtype=int)
+        if side == "near_start":
+            blocked[:, : c + 3] = True
+            allowed = (1, c + 3, h - 2, w - 2)
+        else:
