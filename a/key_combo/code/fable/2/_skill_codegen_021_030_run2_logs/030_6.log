+        for dr, dc in DIR8:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and not solid[nr, nc]:
+                cells.add((nr, nc))
+    return sorted(cells)
+
+
+def _analyze_component(shape: tuple[int, int], coords: np.ndarray) -> dict[str, object]:
+    solid = np.zeros(shape, dtype=bool)
