+
+def _sample_bands(height: int, width: int, row_period: int, rng: random.Random) -> list[tuple[int, int, int]] | None:
+    phase_limits = [(count - 1) // 2 for count in _phase_counts(height, row_period)]
+    total_limit = (height - 1) // 2
