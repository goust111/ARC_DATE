    width = int(rows.shape[1])
    for period in range(1, width + 1):
        if all(np.array_equal(row[:-period], row[period:]) for row in rows):
            return period
    return width


def _vertical_period(row_keys: list[tuple[int, ...]]) -> int:
    height = len(row_keys)
    for period in range(1, height + 1):
