    max_ext = min(GEN_V_LEN_RANGE[1] - base_len, up_cap + down_cap)
    if up_cap < GEN_VERTICAL_ENDPOINT_MARGIN or down_cap < GEN_VERTICAL_ENDPOINT_MARGIN or max_ext < min_ext:
        return None

    total_ext = random.randint(min_ext, max_ext)
