+
+            total_shifted += end - start
+            for r in range(start, end):
+                shifted_by_phase[r % row_period] += 1
+
+            left = max(0, start - 1)
+            right = min(height, end + 1)
+            blocked[left:right] = True
+
+            if band_index + 1 == target_bands:
