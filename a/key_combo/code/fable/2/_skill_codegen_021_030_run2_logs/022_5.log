+def _vertical_period(row_keys: list[tuple[int, ...]]) -> int:
+    height = len(row_keys)
+    for period in range(1, height + 1):
+        if all(row_keys[r] == row_keys[r % period] for r in range(height)):
+            return period
+    return height
