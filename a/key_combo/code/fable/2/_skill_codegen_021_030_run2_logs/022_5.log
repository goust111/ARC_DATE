+def _apply_bands(wallpaper: np.ndarray, bands: list[tuple[int, int, int]]) -> np.ndarray:
+    grid = wallpaper.copy()
+    for start, end, shift in bands:
+        for r in range(start, end):
+            grid[r] = np.roll(grid[r], shift)
+    return grid
+
+
+def _validate_instance(
