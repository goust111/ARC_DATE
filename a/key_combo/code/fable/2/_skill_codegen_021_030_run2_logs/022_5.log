+
+def _generate_phase_rows(row_period: int, col_period: int, width: int, rng: random.Random) -> np.ndarray | None:
+    palette_size = rng.randint(3, min(6, len(PALETTE)))
+    palette = rng.sample(PALETTE, palette_size)
