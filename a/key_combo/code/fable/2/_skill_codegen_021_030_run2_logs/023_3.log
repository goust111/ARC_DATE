+    for panel_index, blocks in enumerate(block_lists):
+        count = 0
+        for r0, c0 in blocks:
+            contested = False
+            for other_index in range(PANEL_COUNT):
+                if other_index == panel_index:
+                    continue
+                if np.any(fg_masks[other_index][r0 : r0 + 2, c0 : c0 + 2]):
+                    contested = True
+                    break
