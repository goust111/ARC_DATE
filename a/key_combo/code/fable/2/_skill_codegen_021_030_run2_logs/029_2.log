+def _objective_vec(seed_vec: np.ndarray, pair_matrix: np.ndarray, total_ones: int) -> int:
+    k = int(seed_vec.sum())
+    quadratic = int(seed_vec @ pair_matrix @ seed_vec)
+    return int(total_ones + k * k - 2 * quadratic)
