+        delta = 1 - 2 * int(seed_vec[best_index])
+        seed_vec[best_index] += delta
+        k += delta
+        quadratic += delta * (int(row_sums[best_index]) + int(col_sums[best_index])) + int(pair_matrix[best_index, best_index])
