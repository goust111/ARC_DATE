+import math
+
+import numpy as np
+
+
+RNG = np.random.default_rng()
+BACKGROUND = 0
+FOREGROUND_COLORS = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+N_CHOICES = (3, 4, 5)
+GENERATION_ATTEMPTS = 500
