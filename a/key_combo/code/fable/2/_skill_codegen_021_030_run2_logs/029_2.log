+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    n = int(RNG.choice(N_CHOICES))
+    seed = _random_seed(n)
+    mode = "ambiguous" if RNG.random() < 0.55 else "clear"
+    noisy_binary = _apply_noise(seed, mode)
