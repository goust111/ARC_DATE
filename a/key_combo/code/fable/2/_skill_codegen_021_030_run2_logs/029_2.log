+        cols = seed.sum(axis=0)
+        empty_rows = n - rows
+        empty_cols = n - cols
+        if np.count_nonzero(rows) < 2 or np.count_nonzero(cols) < 2:
+            continue
+        if np.count_nonzero(empty_rows) < 2 or np.count_nonzero(empty_cols) < 2:
+            continue
