+        base[order[:k]] = 1
+        add(base.reshape(n, n))
+
+        tail = order[max(0, k - tail_size) : k]
+        head = order[k : min(total, k + head_size)]
+        for src in tail:
+            for dst in head:
+                swapped = base.copy()
+                swapped[src] = 0
+                swapped[dst] = 1
+                add(swapped.reshape(n, n))
+
+    return masks
