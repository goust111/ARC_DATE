+    if len(coords) == 0:
+        return np.zeros(mask.shape, dtype=np.uint8)
+    stack = np.array([blocks[r, c] for r, c in coords], dtype=np.uint8)
+    votes = stack.sum(axis=0)
+    return (votes * 2 > len(stack)).astype(np.uint8)
