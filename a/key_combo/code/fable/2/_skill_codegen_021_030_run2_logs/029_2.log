+def main(grid: np.ndarray) -> np.ndarray:
+    """Recover the unique n x n seed sprite from a noisy self-similar n^2 x n^2 expansion.
+
+    Input structure:
+    - The grid is square with side n^2, black background, and exactly one foreground color.
