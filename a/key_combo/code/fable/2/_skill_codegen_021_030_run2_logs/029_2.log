+            score_delta = 2 * delta * (k - int(row_sums[idx]) - int(col_sums[idx])) + 1 - 2 * int(pair_matrix[idx, idx])
+            if score_delta < best_delta:
+                best_delta = int(score_delta)
+                best_index = idx
