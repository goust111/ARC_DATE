+    seed = _random_seed(n)
+    mode = "ambiguous" if RNG.random() < 0.55 else "clear"
+    noisy_binary = _apply_noise(seed, mode)
+    if not _validate_case(seed, noisy_binary, mode):
+        raise RuntimeError("generated case failed semantic validation")
