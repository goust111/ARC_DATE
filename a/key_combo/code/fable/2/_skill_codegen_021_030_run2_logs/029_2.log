+    RNG.shuffle(shuffled)
+    used = {cell: 0 for cell in shuffled}
+    picked: list[tuple[int, int]] = []
+    cursor = 0
+    while len(picked) < count:
+        cell = shuffled[cursor % len(shuffled)]
+        cursor += 1
+        if used[cell] >= cap:
