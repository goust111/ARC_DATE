def objective(s, A, total):
    k = int(s.sum())
    q = int(s @ A @ s)
    return total + k * k - 2 * q

def hill_climb(seed, A, total):
    s = seed.astype(np.int16).ravel().copy()
    k = int(s.sum())
    row = A @ s
    col = A.T @ s
    q = int(s @ row)
    cur = int(total + k * k - 2 * q)
    m = len(s)
    while True:
        best_delta = 0
        best_i = -1
        for i in range(m):
            d = 1 - 2 * int(s[i])
            delta = 2 * d * (k - int(row[i]) - int(col[i])) + 1 - 2 * int(A[i, i])
            if delta < best_delta:
                best_delta = int(delta)
                best_i = i
        if best_i < 0:
            return s.astype(np.uint8), cur
        i = best_i
        d = 1 - 2 * int(s[i])
        s[i] += d
        k += d
        q += d * (int(row[i]) + int(col[i])) + int(A[i, i])
        row = row + d * A[:, i]
        col = col + d * A[i, :]
        cur += best_delta

