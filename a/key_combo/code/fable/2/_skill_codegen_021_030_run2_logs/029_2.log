+    def add(mask: np.ndarray) -> None:
+        flat = tuple(int(x) for x in mask.ravel())
+        if 0 < sum(flat) < total and flat not in seen:
+            seen.add(flat)
+            masks.append(mask.astype(np.uint8, copy=True))
