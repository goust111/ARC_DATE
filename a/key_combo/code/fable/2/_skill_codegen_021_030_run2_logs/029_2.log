            continue
        used[cell] += 1
        picked.append(cell)
    return picked


def _apply_noise(seed: np.ndarray, mode: str) -> np.ndarray:
    n = seed.shape[0]
    area = int(seed.sum())
    noisy = _expand_seed(seed)
