+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            grid, _seed = _generate_case()
+        except RuntimeError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid self-similar noisy expansion")

