+
+def _anchor_candidates(item: dict, height: int, width: int, inp_occ: np.ndarray, out_occ: np.ndarray) -> list[tuple[int, int]]:
+    min_r = 0
+    max_r = height - 1
+    min_c = 0
+    max_c = width - 1
