+        same = pts[pts[:, 0] == r, 1]
+        assert len(same) > 0
+        delta = int(same.min()) - c
+    elif side == "right":
+        same = pts[pts[:, 0] == r, 1]
+        assert len(same) > 0
+        delta = c - int(same.max())
+    elif side == "up":
+        same = pts[pts[:, 1] == c, 0]
+        assert len(same) > 0
+        delta = int(same.min()) - r
+    else:
+        same = pts[pts[:, 1] == c, 0]
+        assert len(same) > 0
+        delta = r - int(same.max())
+    assert delta > 0
+    return int(delta)
+
+
+def _shift_vector(side: str, delta: int) -> tuple[int, int]:
+    if side == "left":
+        return 0, -int(delta)
+    if side == "right":
+        return 0, int(delta)
+    if side == "up":
+        return -int(delta), 0
+    return int(delta), 0
+
+
+def _apply_color_rule(main_comp: dict, singleton: tuple[int, int] | None) -> np.ndarray:
