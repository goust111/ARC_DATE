+            abs_in = [(ar + r, ac + c) for r, c in item["input_cells"]]
+            abs_out = [(ar + r, ac + c) for r, c in item["output_cells"]]
+            if not _coords_clear(abs_in, inp_occ):
+                continue
+            if not _coords_clear(abs_out, out_occ):
