def _gen_is_vertically_symmetric(mask):
    return np.array_equal(mask, np.flipud(mask))


def _gen_row_patterns(w, component_count):
    mid = w // 2
    patterns = []
    for bits in range(1 << (mid + 1)):
        left = [bool(bits & (1 << c)) for c in range(mid + 1)]
