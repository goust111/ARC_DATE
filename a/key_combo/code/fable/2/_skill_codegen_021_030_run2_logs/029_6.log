  "type": "move_to_match",
  "src": "solid same-color rectangular objects s",
  "dst": "empty horizontal or vertical gap d between facing same-color rectangles",
  "match_cond": "same color, overlapping perpendicular span, and all-bg gap; selected gaps connect each color group by shortest gap length",
  "transform": "paint d teal using the shared span eroded by one pixel; keep all input pixels unchanged",
  "multi_step": "process candidate gaps by increasing gap length; skip a gap once its two same-color rectangle groups are already connected"
}
</annotation>
</reference_puzzle>

