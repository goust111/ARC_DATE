+        local_coords = frozenset((int(r), int(c)) for r, c in np.argwhere(piece_mask))
+        piece_plans.append(
+            {
+                "coords": _absolute_coords(local_coords, top_left),
+                "matched_color": None,
+                "area": int(piece_mask.sum()),
+                "rotated": False,
+            }
