+from __future__ import annotations
+
+import random
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import numpy as np
+
+_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS_DIR) not in sys.path:
