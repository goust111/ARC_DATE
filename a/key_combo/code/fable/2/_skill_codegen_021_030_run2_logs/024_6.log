+
+def _shift_cells(cells: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
+    return {(r + int(dr), c + int(dc)) for r, c in cells}
+
+
+def _coords_to_set(coords: np.ndarray) -> set[tuple[int, int]]:
