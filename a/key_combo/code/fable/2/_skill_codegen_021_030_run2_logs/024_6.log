+        comps = _components_from_mask(grid == int(color))
+        for coords in comps:
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": int(coords.shape[0]),
