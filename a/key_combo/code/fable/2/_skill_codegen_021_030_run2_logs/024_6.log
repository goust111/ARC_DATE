+def _mark_blocked(blocked: np.ndarray, cells: set[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        for dr, dc in DIRS8:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
