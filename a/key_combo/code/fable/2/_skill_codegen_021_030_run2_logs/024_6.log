+            score = 1
+            if (dr, dc) == last_dir:
+                score += 3
+            if (dr, dc) == preferred_dir:
+                score += 2
+            if abs(nxt[0]) + abs(nxt[1]) > abs(current[0]) + abs(current[1]):
+                score += 1
+            if (preferred_dir[0] and dr == preferred_dir[0]) or (preferred_dir[1] and dc == preferred_dir[1]):
+                score += 1
+            options.append((nxt, score))
+        if not options:
