+    down_hi = min(5, h - r - 1)
+    if up_hi < 2 or down_hi < 2:
+        return None
+    seed_a = (
+        r - int(rng.integers(2, up_hi + 1)),
+        int(np.clip(mid + int(rng.integers(-2, 3)), 1, w - 2)),
+    )
+    seed_b = (
+        r + int(rng.integers(2, down_hi + 1)),
+        int(np.clip(mid + int(rng.integers(-2, 3)), 1, w - 2)),
+    )
+    return segments, [seed_a, seed_b]
