    bg, _separator, schedule, pieces, well_shape = _parse_input(g)
    settled, _stats = _simulate(pieces, schedule, well_shape, bg=bg, clear_mode="step", use_input_rows=True)

    out = np.full_like(g, int(bg))
    out[0] = g[0]
    out[1] = g[1]
    out[2:] = settled
    return out


