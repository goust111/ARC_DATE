+    return board, {
+        "landing_rows": landing_rows,
+        "clear_events": clear_events,
+        "total_lines": int(sum(event["lines"] for event in clear_events)),
+        "max_rounds": int(max((event["rounds"] for event in clear_events), default=0)),
