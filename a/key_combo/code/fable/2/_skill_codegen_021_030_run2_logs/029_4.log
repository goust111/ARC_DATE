+            use_input_rows=True,
+        )
+        if left_variant is not None and np.array_equal(left_variant, target):
+            return False
+
+        top_order = _order_by_top(pieces)
+        if top_order == schedule:
+            return False
+        top_variant = _simulate_safe(
+            pieces,
+            top_order,
+            well_shape,
+            bg=bg,
+            clear_mode="step",
+            use_input_rows=True,
+        )
+        if top_variant is not None and np.array_equal(top_variant, target):
+            return False
+
+        reverse_order = list(reversed(schedule))
+        if reverse_order == schedule:
+            return False
+        reverse_variant = _simulate_safe(
+            pieces,
+            reverse_order,
+            well_shape,
+            bg=bg,
+            clear_mode="step",
+            use_input_rows=True,
+        )
+        if reverse_variant is not None and np.array_equal(reverse_variant, target):
+            return False
+
+        return True
+    except AssertionError:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    want_chain_bias = bool(_RNG.integers(4) == 0)
+
+    for _ in range(GENERATION_RETRIES):
+        well_h = int(_RNG.integers(WELL_HEIGHT_RANGE[0], WELL_HEIGHT_RANGE[1] + 1))
+        well_w = int(_RNG.integers(WELL_WIDTH_RANGE[0], WELL_WIDTH_RANGE[1] + 1))
+        count = int(PIECE_COUNT_OPTIONS[int(_RNG.integers(len(PIECE_COUNT_OPTIONS)))])
+        schedule = _RNG.choice(INPUT_COLORS, size=count, replace=False).astype(int).tolist()
+        _RNG.shuffle(schedule)
+
+        pieces: dict[int, dict] = {}
+        try:
+            for color in schedule:
+                mask = _random_shape(well_w)
+                c0 = int(_RNG.integers(0, well_w - mask.shape[1] + 1))
+                pieces[int(color)] = {
+                    "color": int(color),
+                    "mask": mask,
+                    "c0": int(c0),
+                    "start_r": 0,
+                }
+        except RuntimeError:
+            continue
+
+        overlap_degree = _overlap_degree(pieces)
+        if any(degree == 0 for degree in overlap_degree.values()):
+            continue
+
+        if _order_by_left(pieces) == schedule:
+            continue
+
+        try:
+            abstract_board, stats = _simulate(
+                pieces,
+                schedule,
+                (well_h, well_w),
+                bg=BG,
+                clear_mode="step",
+                use_input_rows=False,
+            )
+        except AssertionError:
+            continue
+
+        if stats["total_lines"] < 1 or not stats["clear_events"]:
+            continue
+        if stats["clear_events"][0]["piece_index"] >= len(schedule) - 1:
+            continue
+        if any(landing <= 0 for landing in stats["landing_rows"].values()):
+            continue
+        if want_chain_bias and stats["max_rounds"] < 2:
+            continue
+
+        no_clear = _simulate_safe(
+            pieces,
+            schedule,
+            (well_h, well_w),
+            bg=BG,
+            clear_mode="none",
+            use_input_rows=False,
+        )
+        if no_clear is None or np.array_equal(no_clear, abstract_board):
+            continue
+
+        clear_at_end = _simulate_safe(
+            pieces,
+            schedule,
+            (well_h, well_w),
+            bg=BG,
+            clear_mode="end",
+            use_input_rows=False,
+        )
+        if clear_at_end is None or np.array_equal(clear_at_end, abstract_board):
+            continue
+
+        reverse_variant = _simulate_safe(
+            pieces,
+            list(reversed(schedule)),
+            (well_h, well_w),
+            bg=BG,
+            clear_mode="step",
+            use_input_rows=False,
+        )
+        if reverse_variant is not None and np.array_equal(reverse_variant, abstract_board):
+            continue
+
+        packed_rows = _pack_start_rows(pieces, stats["landing_rows"], (well_h, well_w), schedule)
+        if packed_rows is None:
+            continue
+
+        input_pieces = {
+            color: {
+                "color": piece["color"],
+                "mask": piece["mask"].copy(),
+                "c0": int(piece["c0"]),
+                "start_r": int(packed_rows[color]),
+            }
+            for color, piece in pieces.items()
+        }
+        if _order_by_top(input_pieces) == schedule:
+            continue
+
+        grid = _build_input_grid(schedule, input_pieces, (well_h, well_w))
+        if _semantic_checks(grid):
+            return grid
+
+    raise RuntimeError("failed to generate a non-degenerate timetable-drop ARC input")

