+    try:
+        spec = spec_from_file_location("_shared_arc_utils_fable_2_029_4", str(path))
+        if spec is None or spec.loader is None:
+            return None
+        mod = module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        return mod
+    except Exception:
+        return None
+
+
+_ARC_UTILS = _load_arc_utils()
