+def _fits(board: np.ndarray, mask: np.ndarray, r0: int, c0: int, bg: int) -> bool:
+    h, w = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > board.shape[0] or c0 + w > board.shape[1]:
+        return False
+    region = board[r0 : r0 + h, c0 : c0 + w]
+    return not np.any(region[mask] != int(bg))
