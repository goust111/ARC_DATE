+    if clear_mode == "end":
+        board, cleared_lines, cleared_rounds = _clear_full_rows(board, bg)
+        if cleared_lines:
+            clear_events.append(
+                {
+                    "piece_index": len(order),
+                    "color": -1,
+                    "lines": int(cleared_lines),
+                    "rounds": int(cleared_rounds),
+                }
+            )
