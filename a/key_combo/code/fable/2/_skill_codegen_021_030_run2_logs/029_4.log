+                assignment[color] = int(start_r)
+                prev_blocked = blocked.copy()
+                blocked.update(_touching_cells(coords))
+                if dfs(index + 1):
+                    return True
+                blocked.clear()
+                blocked.update(prev_blocked)
+                del assignment[color]
+            return False
+
+        if dfs(0):
