+BG = Color.BLACK
+SEPARATOR = Color.GREY
+INPUT_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
