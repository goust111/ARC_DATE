+    r0, c0, r1, c1 = bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].astype(bool)
+
+
+def _shape_cells(mask: np.ndarray, r0: int = 0, c0: int = 0) -> np.ndarray:
+    coords = np.argwhere(mask)
+    return coords + np.array([int(r0), int(c0)])
