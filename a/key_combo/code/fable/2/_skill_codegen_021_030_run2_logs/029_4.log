+    def try_with_cap(cap: int) -> dict[int, int] | None:
+        assignment: dict[int, int] = {}
+        blocked: set[tuple[int, int]] = set()
+
+        def dfs(index: int) -> bool:
+            if index == len(colors):
+                return True
+            color = int(colors[index])
