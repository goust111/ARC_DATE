+def _touching_cells(coords: Iterable[tuple[int, int]]) -> set[tuple[int, int]]:
+    cells = set()
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                cells.add((int(r) + dr, int(c) + dc))
+    return cells
