    for combo in itertools.product(names, repeat=5):
        # cap search a bit
        if combo.count('V2') + combo.count('V3') == 0:
            continue
        masks = [shapes[name] for name in combo]
        pos_ranges = [range(W - m.shape[1] + 1) for m in masks]
        for cols in itertools.product(*pos_ranges):
            pieces = {
                i+1: {'color': i+1, 'mask': masks[i], 'c0': cols[i], 'start_r': 0}
                for i in range(5)
            }
            try:
                board, stats = mod._simulate(pieces, [1,2,3,4,5], (H,W), bg=0, clear_mode='step', use_input_rows=False)
            except AssertionError:
                continue
            if stats['total_lines'] < 1 or not stats['clear_events'] or stats['clear_events'][0]['piece_index'] >= 4:
                continue
            end = mod._simulate_safe(pieces, [1,2,3,4,5], (H,W), bg=0, clear_mode='end', use_input_rows=False)
            rev = mod._simulate_safe(pieces, [5,4,3,2,1], (H,W), bg=0, clear_mode='step', use_input_rows=False)
            if end is None or np.array_equal(end, board):
                continue
            if rev is not None and np.array_equal(rev, board):
                continue
            print('W', W, 'combo', combo, 'cols', cols, 'clear', stats['clear_events'], 'land', stats['landing_rows'])
            print(board)
            print('end diff? ', not np.array_equal(end, board))
            found += 1
            if found >= 8:
                raise SystemExit
print('done')
