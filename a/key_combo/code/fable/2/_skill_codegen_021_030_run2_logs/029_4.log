+def _simulate(
+    pieces: dict[int, dict],
+    order: list[int],
+    well_shape: tuple[int, int],
+    *,
+    bg: int = BG,
+    clear_mode: str = "step",
+    use_input_rows: bool = False,
+) -> tuple[np.ndarray, dict]:
+    board = np.full(well_shape, int(bg), dtype=int)
+    landing_rows: dict[int, int] = {}
+    clear_events: list[dict] = []
