+def _clear_full_rows(board: np.ndarray, bg: int) -> tuple[np.ndarray, int, int]:
+    total_lines = 0
+    rounds = 0
+    current = board.copy()
+    while True:
+        full = np.all(current != int(bg), axis=1)
+        if not np.any(full):
+            return current, total_lines, rounds
+        rounds += 1
+        total_lines += int(np.count_nonzero(full))
+        kept = current[~full]
