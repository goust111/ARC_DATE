+def _parse_input(grid: np.ndarray) -> tuple[int, int, list[int], dict[int, dict], tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] >= 3 and g.shape[1] >= 4
