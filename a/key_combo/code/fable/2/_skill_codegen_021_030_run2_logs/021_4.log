+@dataclass
+class Scene:
+    frame_color: int
+    cue_color: int
+    m: int
+    frames: tuple[Frame, ...]
+    step_types: tuple[str, ...]
+    patches: tuple[np.ndarray, ...]
+    cue_cells: tuple[tuple[int, int], ...]
