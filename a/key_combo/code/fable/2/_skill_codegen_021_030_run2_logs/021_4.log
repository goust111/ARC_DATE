+    scene = Scene(
+        frame_color=frame_color,
+        cue_color=cue_color,
+        m=int(scenario["m"]),
+        frames=frames,
+        step_types=step_types,
+        patches=tuple(patches),
+        cue_cells=cue_cells,
+    )
+    grid = _render_scene(scene)
+    if max(grid.shape) > 30:
+        return None
+    return scene
