+def _safe_cue_sides(head: tuple[int, int], nxt: tuple[int, int]) -> list[str]:
+    dr = int(nxt[0] - head[0])
+    dc = int(nxt[1] - head[1])
+    sides = ["N", "S", "W", "E"]
+    if dr > 0 and "S" in sides:
+        sides.remove("S")
+    if dr < 0 and "N" in sides:
+        sides.remove("N")
+    if dc > 0 and "E" in sides:
+        sides.remove("E")
+    if dc < 0 and "W" in sides:
+        sides.remove("W")
+    return sides
+
