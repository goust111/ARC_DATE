+
+BG = 0
+SIDE = 5
+INNER = SIDE - 2
+PALETTE = tuple(range(1, 10))
+ORTH_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIAG_DIRS = ((1, 1), (1, -1), (-1, 1), (-1, -1))
+ALL_DIRS = ORTH_DIRS + DIAG_DIRS
+MAX_GENERATION_ATTEMPTS = 600
