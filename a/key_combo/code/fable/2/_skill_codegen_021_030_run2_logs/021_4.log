+def _prefix(mask: np.ndarray) -> np.ndarray:
+    pref = np.zeros((mask.shape[0] + 1, mask.shape[1] + 1), dtype=int)
+    pref[1:, 1:] = np.cumsum(np.cumsum(mask.astype(int), axis=0), axis=1)
