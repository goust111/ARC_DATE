        [cell for cell in all_cells if cell not in {(1, 1), (0, 0)}],  # 7 pixels (2 holes)
        [cell for cell in all_cells if cell not in {(1, 1), (0, 0), (2, 2)}],  # 6 pixels (3 holes)
        [(1, 1), (0, 1), (2, 1), (1, 0), (1, 2)],  # plus shape (5 pixels / 4 holes)
    ]
