import random
from collections import Counter
import numpy as np


def get_bg(grid):
    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])

def colors_present(grid, exclude=None):
    cols = set(map(int, grid.flatten()))
    if exclude is not None:
        cols -= set(map(int, exclude))
    return sorted(cols)

def sample_union_rows(h, count):
    if count == 0:
        return np.zeros(h, dtype=bool)
    if count == h:
        return np.ones(h, dtype=bool)
    mask = np.zeros(h, dtype=bool)
    if count == 1 or random.random() < 0.65:
        start = random.randint(0, h - count)
        mask[start:start+count] = True
        return mask
    first = random.randint(1, count - 1)
    second = count - first
    gap = random.randint(1, h - count)
    start1 = random.randint(0, h - count - gap)
    start2 = start1 + first + gap
    mask[start1:start1+first] = True
    mask[start2:start2+second] = True
    return mask

def choose_rows(rows, k):
    rows = np.array(rows, dtype=int)
    if k == 0:
        return np.empty(0, dtype=int)
    if k == len(rows):
        return rows.copy()
    return np.sort(np.random.choice(rows, size=k, replace=False))

def build_masks(h, union_size, top_count, bottom_count):
    overlap = top_count + bottom_count - union_size
    if not (0 <= overlap <= min(top_count, bottom_count)):
        raise ValueError((h, union_size, top_count, bottom_count, overlap))
    union_mask = sample_union_rows(h, union_size)
    union_rows = np.flatnonzero(union_mask)
    overlap_rows = choose_rows(union_rows, overlap)
    remaining = np.array([r for r in union_rows if r not in set(overlap_rows.tolist())], dtype=int)
    top_only = choose_rows(remaining, top_count - overlap)
    top_only_set = set(top_only.tolist())
    bottom_only = np.array([r for r in remaining if r not in top_only_set], dtype=int)
    top = np.zeros(h, dtype=bool)
    bottom = np.zeros(h, dtype=bool)
    top[overlap_rows] = True
    bottom[overlap_rows] = True
    top[top_only] = True
    bottom[bottom_only] = True
    assert top.sum() == top_count and bottom.sum() == bottom_count
    assert np.logical_or(top, bottom).sum() == union_size
    return top, bottom

def strict_conflict(scores, metric, metric_prefers_higher=True):
    w = len(scores)
    for i in range(w):
        for j in range(w):
            if scores[i] > scores[j]:
                if metric_prefers_higher and metric[i] < metric[j]:
                    return True
                if not metric_prefers_higher and metric[i] > metric[j]:
                    return True
    return False

