+    bottom_margin = random.randint(1, 3)
+    while height - top_margin - bottom_margin < 9:
+        top_margin = random.randint(1, 3)
+        bottom_margin = random.randint(1, 3)
+    band_r0 = top_margin
+    band_r1 = height - bottom_margin - 1
+
