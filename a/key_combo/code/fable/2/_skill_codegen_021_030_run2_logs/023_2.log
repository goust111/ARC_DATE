+    out = np.asarray(grid, dtype=int).copy()
+    n = len(order)
+    for idx, color in enumerate(order):
+        fill_color = order[idx - 1] if use_prev else order[(idx + 1) % n]
+        r0, c0, r1, c1 = band_by_color[color]["bbox"]
+        patch = out[r0 : r1 + 1, c0 : c1 + 1]
