+    grid[r0 : r0 + size, c0 : c0 + size] = int(color)
+
+
+def _carve_band_gaps(grid: np.ndarray, r0: int, r1: int, c0: int, c1: int) -> None:
+    width = int(c1 - c0 + 1)
+    height = int(r1 - r0 + 1)
+    if width == 2:
+        spine = random.choice([0, 1])
+        gap_cols = [1 - spine]
+    else:
