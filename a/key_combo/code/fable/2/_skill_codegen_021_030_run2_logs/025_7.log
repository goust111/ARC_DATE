0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Pack the bottom-grounded foreground rectangles into an overlapping diagonal chain starting at the upper-left.
0011: 
0012:     Input structure
0013:     The background is the most common color. Every foreground object is a solid
0014:     monochrome rectangle touching the bottom row, and the rectangles have unique
0015:     left edges that define their left-to-right order.
0016: 
0017:     Rule
0018:     Clear the canvas to the background. Copy the rectangles in left-to-right
0019:     order, placing the first at the upper-left corner. After placing a rectangle
0020:     of height h and width w, place the next rectangle h-1 rows lower and w-1
0021:     columns to the right, so later rectangles overwrite the shared corner cell.
0022: 
0023:     Key insight
0024:     The bottom arrangement is a horizontal list of rectangles; the output keeps
0025:     the list order and rectangle shapes while converting the list into a compact
0026:     diagonal chain of overlapping bounding-box corners.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     assert g.ndim == 2, "expected a 2D grid"
0030:     height, width = map(int, g.shape)
0031:     bg = int(get_bg(g))
0032: 
0033:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0034:     assert objects, "expected at least one foreground rectangle"
0035: 
0036:     left_edges = [int(obj["bbox"][1]) for obj in objects]
0037:     assert len(set(left_edges)) == len(left_edges), "expected unique left-to-right object order"
0038: 
0039:     out = np.full_like(g, bg)
0040:     row = 0
0041:     col = 0
0042:     for obj in sorted(objects, key=lambda item: int(item["bbox"][1])):
0043:         r0, c0, r1, c1 = map(int, obj["bbox"])
0044:         assert r1 == height - 1, "each object must touch the bottom row"
0045: 
0046:         patch = crop_bbox(g, (r0, c0, r1, c1))
0047:         assert np.all(patch == int(obj["color"])), "each object must be a solid rectangle"
0048: 
0049:         h, w = map(int, patch.shape)
0050:         assert row + h <= height and col + w <= width, "packed chain must fit on the canvas"
0051:         paste(out, patch, row, col)
0052:         row += h - 1
0053:         col += w - 1
0054: 
0055:     return out
