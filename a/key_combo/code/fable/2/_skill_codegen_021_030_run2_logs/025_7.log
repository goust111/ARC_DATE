+    if not decoy_found:
+        return False
+
+    expected = _expected_output(grid, cups, blobs)
+    actual = main(grid)
+    return np.array_equal(actual, expected)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_cups = int(np.random.randint(2, 5))
+    cups = _sample_cups(n_cups)
