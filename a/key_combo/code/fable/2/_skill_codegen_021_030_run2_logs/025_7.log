+    footprint = sum(cup["patch"].shape[0] * cup["patch"].shape[1] for cup in cups)
+    footprint += sum(blob["patch"].shape[0] * blob["patch"].shape[1] for blob in blobs)
+    side_min = max(18, int(math.ceil(math.sqrt(footprint * 2.8))))
