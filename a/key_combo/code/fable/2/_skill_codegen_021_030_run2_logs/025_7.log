+    decoy_found = False
+    for blob in blobs:
+        for cup in cups:
+            if blob["area"] == cup["capacity"]:
+                continue
+            if _fit_mask_in_cavity(blob["mask"], cup["cavity_mask"]):
+                decoy_found = True
+                break
+        if decoy_found:
