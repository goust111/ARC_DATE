0093: def main(grid: np.ndarray) -> np.ndarray:
0094:     """
0095:     Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.
0096: 
0097:     Input structure:
0098:     - The background is the dominant color.
0099:     - Two same-color solid rectangular anchors of the same size sit on opposite
0100:       diagonal corners, with the first anchor above-left of the second.
0101:     - The upper-left anchor has two one-cell-thick vertical control bars to its
0102:       right and two one-cell-thick horizontal control bars below it.
0103: 
0104:     Rule:
0105:     - Copy the anchor rectangle into the two missing corners of the implied
0106:       larger rectangle.
0107:     - Repeat the right-side control bars horizontally between the left and right
0108:       anchors, using their spacing as the period, and draw the outer top and
0109:       bottom borders in the first right-control color.
0110:     - Repeat the below-side control bars vertically between the top and bottom
0111:       anchors, using the same period, and draw the outer left and right borders
0112:       in the first below-control color.
0113: 
0114:     Key insight: The small control bars are the first two ticks of two periodic
0115:     frame patterns; the diagonal anchor supplies the opposite corner and the
0116:     missing two anchor copies.
0117:     """
0118:     g = np.asarray(grid, dtype=int)
0119:     bg = get_bg(g)
0120:     source, dest, right_controls, below_controls = _find_structure(g, bg)
0121: 
0122:     sr0, sc0, sr1, sc1 = source["bbox"]
0123:     dr0, dc0, dr1, dc1 = dest["bbox"]
0124:     anchor_color = int(source["color"])
0125:     assert int(dest["color"]) == anchor_color, "anchor colors must match"
0126:     assert bbox_h(source["bbox"]) == bbox_h(dest["bbox"]), "anchor heights must match"
0127:     assert bbox_w(source["bbox"]) == bbox_w(dest["bbox"]), "anchor widths must match"
0128:     assert sr0 > 0 and sc0 > 0, "upper-left anchor must have space for outer frame"
0129:     assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], "lower-right anchor must have space for outer frame"
0130: 
0131:     right_offsets = [int(comp["bbox"][1] - sc1) for comp in right_controls]
0132:     below_offsets = [int(comp["bbox"][0] - sr1) for comp in below_controls]
0133:     assert right_offsets == below_offsets and right_offsets[0] == 1, "control offsets must match from the anchor edge"
0134:     step = int(right_offsets[1] - right_offsets[0])
0135:     assert step > 0, "control bars must be separated"
0136:     period = 2 * step
0137:     assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, "right frame must close next to the destination anchor"
0138:     assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, "below frame must close next to the destination anchor"
0139: 
0140:     right_colors = [int(comp["color"]) for comp in right_controls]
0141:     below_colors = [int(comp["color"]) for comp in below_controls]
0142:     out = g.copy()
0143: 
0144:     _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)
0145:     _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)
0146: 
0147:     first_c = int(sc1 + right_offsets[0])
0148:     last_c = int(dc0 - 1)
0149:     for c in range(first_c, last_c + 1):
0150:         offset = int(c - sc1)
0151:         if (offset - right_offsets[0]) % period == 0:
0152:             color = right_colors[0]
0153:         elif (offset - right_offsets[1]) % period == 0:
0154:             color = right_colors[1]
0155:         else:
0156:             continue
0157:         _paint_rect(out, bg, sr0, c, sr1, c, color)
0158:         _paint_rect(out, bg, dr0, c, dr1, c, color)
0159: 
0160:     _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])
0161:     _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])
0162: 
0163:     first_r = int(sr1 + below_offsets[0])
0164:     last_r = int(dr0 - 1)
0165:     left_c = int(sc0 - 1)
0166:     right_c = int(dc1 + 1)
0167:     for r in range(first_r, last_r + 1):
0168:         _paint(out, bg, r, left_c, below_colors[0])
0169:         _paint(out, bg, r, right_c, below_colors[0])
0170: 
0171:         offset = int(r - sr1)
0172:         if (offset - below_offsets[0]) % period == 0:
0173:             _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])
0174:             _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])
0175:         elif (offset - below_offsets[1]) % period == 0:
0176:             _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])
0177:             _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])
0178: 
0179:     return out
