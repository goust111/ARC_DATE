+    top = [(r - k, cc) for cc in range(c - k, c + k + 1)]
+    bottom = [(r + k, cc) for cc in range(c - k, c + k + 1)]
+    left = [(rr, c - k) for rr in range(r - k + 1, r + k)]
+    right = [(rr, c + k) for rr in range(r - k + 1, r + k)]
+    return top + bottom + left + right
