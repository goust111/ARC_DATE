0216: def _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:
0217:     """Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions."""
0218:     needed = n + (n - 1) * min_gap
0219:     span = hi - lo + 1
0220:     if span < needed:
0221:         return None
0222:     compressed_span = span - (n - 1) * min_gap
0223:     picks = sorted(rng.sample(range(compressed_span), n))
0224:     return [lo + picks[i] + i * min_gap for i in range(n)]
