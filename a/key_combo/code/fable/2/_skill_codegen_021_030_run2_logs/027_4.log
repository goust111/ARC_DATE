0011: # The output should be what the black rectangle should be in order to make it perfectly symmetric.
0012: # In other words, the output should be the missing part of the pattern, and it should be the same dimensions as the black rectangle.
0013: 
0014: def main(input_grid):
0015:     """
0016:     Recover the black occluded rectangle from a translationally symmetric pattern.
0017: 
0018:     Input structure:
0019:     - The input is a repeated color pattern with no true background color.
0020:     - A black rectangle masks part of the pattern.
0021:     - Non-black cells elsewhere reveal the translational symmetry.
0022: 
0023:     Rule:
0024:     - Treat black cells as the occlusion mask.
0025:     - Detect translational symmetries while ignoring black.
0026:     - Fill each black cell from a non-black cell in its symmetry orbit, then crop the filled rectangle.
0027: 
0028:     Key insight:
0029:     - Symmetry orbits provide equivalent unoccluded samples for each missing cell, and
0030:       the answer is only the reconstructed occluded region.
0031:     """
0032:     # Plan:
0033:     # 1. Find the black rectangle
0034:     # 2. Find the symmetry
0035:     # 3. Fill in the missing part
0036:     # 4. Extract the part that you filled in, which is the final output
0037: 
0038:     # Find the black rectangle and save where it is
0039:     # Do this first because we will need to know where it was after we fill it in
0040:     occlusion_color = Color.BLACK
0041:     black_rectangle_mask = (input_grid == occlusion_color)
0042: 
0043:     # Find the symmetry. Notice that black is not the background, but instead is the occlusion color. In fact there is no well-defined background color.
0044:     symmetries = detect_translational_symmetry(input_grid, ignore_colors=[occlusion_color], background=None)
0045: 
0046:     # Fill in the missing part
0047:     for occluded_r, occluded_c in np.argwhere(black_rectangle_mask):
0048:         for sym_r, sym_c in orbit(input_grid, int(occluded_r), int(occluded_c), symmetries):
0049:             if int(input_grid[sym_r, sym_c]) != occlusion_color:
0050:                 input_grid[int(occluded_r), int(occluded_c)] = input_grid[sym_r, sym_c]
0051:                 break
0052:     
0053:     # Extract the region that we filled in, ultimately as a 2D sprite
0054:     # first, get just the part of the final image which corresponds to what used to be included
0055:     filled_in_region = np.full_like(input_grid, occlusion_color)
0056:     filled_in_region[black_rectangle_mask] = input_grid[black_rectangle_mask]
0057:     # then, crop it to obtain the sprite
0058:     b = bbox(filled_in_region != occlusion_color)
0059:     assert b is not None
0060:     filled_in_region = crop_bbox(filled_in_region, b)
0061: 
0062:     return filled_in_region
0063:     
