+        (r - k, c - k - 1),
+        (r - k - 1, c + k),
+        (r - k, c + k + 1),
+        (r + k + 1, c - k),
+        (r + k, c - k - 1),
+        (r + k + 1, c + k),
+        (r + k, c + k + 1),
+    ]
