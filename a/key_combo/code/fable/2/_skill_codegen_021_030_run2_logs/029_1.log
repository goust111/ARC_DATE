+            "erased": erased,
+            "kept": kept,
+            "bar_color": bar_color,
+            "bar_cells": bar_cells,
+            "control_color": control_color,
+            "control": control,
+            "ray": ray,
+        }
+        if _validate_generated_case(inp, expected, hidden):
+            return inp, expected
+    return None
+
