+    line_colors = [int(item["color"]) for item in hidden["selected"]]
+    erased = tuple(map(int, hidden["erased"]))
+    kept = tuple(map(int, hidden["kept"]))
+    ray = list(hidden["ray"])
+
+    if len(erased) < 2 or not kept:
