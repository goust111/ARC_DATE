+
+    needed_colors = 4 + int(core_box is not None)
+    usable = [color for color in PALETTE if color != bg]
+    if len(usable) < needed_colors:
+        return None
+    colors = random.sample(usable, needed_colors)
+    marker_color = colors[0]
+    rect_colors = colors[1:]
