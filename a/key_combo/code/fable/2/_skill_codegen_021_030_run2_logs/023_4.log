+
+def _strictly_contains(box: BBox, r: int, c: int) -> bool:
+    r0, c0, r1, c1 = box
+    return int(r0) < int(r) < int(r1) and int(c0) < int(c) < int(c1)
+
+
+def _bbox_distance(box: BBox, r: int, c: int) -> int:
+    r0, c0, r1, c1 = box
+    return max(r0 - r, 0, r - r1) + max(c0 - c, 0, c - c1)
