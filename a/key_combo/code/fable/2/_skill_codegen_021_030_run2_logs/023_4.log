+    marker_color = colors[0]
+    rect_colors = colors[1:]
+
+    outer = Rect("outer", rect_colors[0], outer_box)
+    inner = Rect("inner", rect_colors[1], inner_box)
+    occluder_box, ghost_coord, ghost_side = _sample_occluder((h, w), outer_box)
