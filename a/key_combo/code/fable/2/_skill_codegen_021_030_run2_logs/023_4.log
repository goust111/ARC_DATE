+
+def _apply_rule(grid: np.ndarray, bg: int, frame_boxes: dict[int, BBox], marker_color: int) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    for r_raw, c_raw in np.argwhere(grid == marker_color):
+        r = int(r_raw)
+        c = int(c_raw)
