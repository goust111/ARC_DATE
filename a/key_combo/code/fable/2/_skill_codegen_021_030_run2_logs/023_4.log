+        return None
+    box = _bbox(grid == color)
+    if box is None:
+        return None
+
+    r0, c0, r1, c1 = box
+    seen_top = False
+    seen_bottom = False
+    seen_left = False
+    seen_right = False
+
+    for r_raw, c_raw in coords:
+        r = int(r_raw)
+        c = int(c_raw)
+        on_border = False
+        if r == r0:
+            seen_top = True
+            on_border = True
+        if r == r1:
+            seen_bottom = True
+            on_border = True
+        if c == c0:
+            seen_left = True
+            on_border = True
+        if c == c1:
+            seen_right = True
+            on_border = True
+        if not on_border:
+            return None
+
+    if seen_top and seen_bottom and seen_left and seen_right:
+        return box
+    return None
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, dict[int, BBox], int]:
+    bg = _get_bg(grid)
+    frame_boxes: dict[int, BBox] = {}
+    marker_colors: list[int] = []
+
+    for color in _colors_present(grid, exclude={bg}):
+        box = _visible_frame_box(grid, color)
+        if box is None:
+            marker_colors.append(color)
+        else:
