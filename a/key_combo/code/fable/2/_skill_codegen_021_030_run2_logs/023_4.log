+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _visible_frame_box(grid: np.ndarray, color: int) -> BBox | None:
+    coords = np.argwhere(grid == color)
