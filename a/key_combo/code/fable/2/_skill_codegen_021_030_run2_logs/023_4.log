+
+def _truth_output(grid: np.ndarray, bg: int, marker_color: int, rects: list[Rect]) -> np.ndarray:
+    frame_boxes = {rect.color: rect.box for rect in rects}
+    return _apply_rule(grid, bg, frame_boxes, marker_color)
