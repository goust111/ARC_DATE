+
+
+def _sample_nested_box(container: BBox, min_side: int, gap: int) -> BBox | None:
+    r0, c0, r1, c1 = container
+    avail_h = (r1 - r0 + 1) - 2 * gap
+    avail_w = (c1 - c0 + 1) - 2 * gap
+    if avail_h < min_side or avail_w < min_side:
