+        return False
+    if not any(len(owners) >= 2 for owners in owners_by_marker.values()):
+        return False
+    if len(owners_by_marker.get(ghost_coord, [])) != 1:
+        return False
+    if owners_by_marker[ghost_coord][0].name != "outer":
