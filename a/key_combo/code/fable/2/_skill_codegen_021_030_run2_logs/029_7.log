+                    "color": int(color),
+                    "canonical": canonical,
+                    "patch_shape": patch_shape,
+                    "missing_pos": (int(miss_pos[0]), int(miss_pos[1])),
+                    "missing_orientation": int((phase + rot_step * miss_idx) % 4),
+                    "step": (int(step[0]), int(step[1])),
