+                    (
+                        int(ref[0] + idx * step[0]),
+                        int(ref[1] + idx * step[1]),
+                        int((phase + rot_step * idx) % 4),
+                    )
+                    for idx in range(t0, t1 + 1)
+                ]
+                key = _solution_key(frames)
+                explanations[key] = {
