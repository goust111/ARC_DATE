+
+def _neighbors4(r: int, c: int, size: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr = r + dr
+        cc = c + dc
