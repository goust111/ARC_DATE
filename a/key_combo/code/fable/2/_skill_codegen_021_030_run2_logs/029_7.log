+            for miss_idx in missing_indices:
+                miss_pos = (ref[0] + miss_idx * step[0], ref[1] + miss_idx * step[1])
+                if not _fits(g.shape, miss_pos, patch_shape):
+                    continue
+
+                window = g[
+                    miss_pos[0] : miss_pos[0] + patch_shape[0],
+                    miss_pos[1] : miss_pos[1] + patch_shape[1],
