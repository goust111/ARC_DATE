+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0, "sprite masks must be non-empty"
+    return crop_bbox(mask.astype(int), bbox_coords(coords)).astype(bool)
