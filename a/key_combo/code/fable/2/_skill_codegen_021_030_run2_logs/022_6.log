+        if _spec is None or _spec.loader is None:
+            raise ImportError(f"cannot load arc_utils from {_ARC_UTILS_PATH}")
+        _arc_utils = importlib.util.module_from_spec(_spec)
+        _spec.loader.exec_module(_arc_utils)
