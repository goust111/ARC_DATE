+            dest = move["dest"]
+            region = move["next_region"]
+            steps += 1
+            assert steps <= 2, "two nested walls allow at most two escapes"
+        rr, cc = dest
+        assert out[rr, cc] in (bg, color), "moved markers must not collide"
+        out[rr, cc] = color
+    return out
