+def _generate_inner_fill(shape: tuple[int, int], outer_meta: dict) -> tuple[np.ndarray, dict] | None:
+    h, w = shape
+    c0 = outer_meta["c0"]
+    tops_o = outer_meta["tops"]
+    bottoms_o = outer_meta["bottoms"]
+    outer_width = len(tops_o)
