+        grid[r, c] = gate["color"]
+    for marker in marker_plan:
+        r, c = marker["final"]
+        grid[r, c] = marker["color"]
+    return grid
+
+
+def _validate_generated(inp: np.ndarray, expected: np.ndarray, meta: dict) -> bool:
+    try:
