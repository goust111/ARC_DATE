+def _boundary_from_fill(fill: np.ndarray) -> np.ndarray:
+    h, w = fill.shape
+    boundary = np.zeros_like(fill, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not fill[r, c]:
+                continue
+            for nr, nc in neighbors4(r, c):
+                if not (0 <= nr < h and 0 <= nc < w) or not fill[nr, nc]:
+                    boundary[r, c] = True
+                    break
+    return boundary
