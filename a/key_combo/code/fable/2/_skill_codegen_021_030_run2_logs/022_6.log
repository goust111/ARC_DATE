+def _foreground_mode(grid: np.ndarray, bg: int) -> int:
+    counts = Counter(int(v) for v in grid.flatten() if int(v) != bg)
+    if not counts:
+        raise AssertionError("expected foreground pixels")
+    return counts.most_common(1)[0][0]
