+        for c in range(w):
+            val = int(grid[r, c])
+            if val in (bg, wall_color):
+                continue
+            horizontal = (
+                0 < c < w - 1
+                and int(grid[r, c - 1]) == wall_color
+                and int(grid[r, c + 1]) == wall_color
+            )
+            vertical = (
+                0 < r < h - 1
+                and int(grid[r - 1, c]) == wall_color
+                and int(grid[r + 1, c]) == wall_color
+            )
+            if horizontal and vertical:
+                raise AssertionError("gate cannot lie at a crossing")
+            if horizontal:
+                gates[(r, c)] = "h"
+            elif vertical:
+                gates[(r, c)] = "v"
+    return gates
