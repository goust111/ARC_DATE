+        if len(chosen) == count:
+            return chosen
+    return None
+
+
+def _build_expected(shape: tuple[int, int], wall_color: int, outer_boundary: np.ndarray, inner_boundary: np.ndarray,
+                    gate_plan: dict[str, dict], marker_plan: list[dict]) -> np.ndarray:
