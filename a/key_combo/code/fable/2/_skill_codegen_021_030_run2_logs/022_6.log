+            if horiz == vert:
+                continue
+
+            if horiz:
+                side_a = (r - 1, c)
+                side_b = (r + 1, c)
+            else:
+                side_a = (r, c - 1)
+                side_b = (r, c + 1)
+
+            in_a = bool(fill[side_a])
+            in_b = bool(fill[side_b])
+            if in_a == in_b:
+                continue
+            outward = side_a if not in_a else side_b
+            inward = side_b if not in_a else side_a
