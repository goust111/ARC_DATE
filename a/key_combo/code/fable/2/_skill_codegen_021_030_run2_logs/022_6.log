+        t1, t2 = tops[i], tops[i + 1]
+        if t2 > t1:
+            wall[t1 : t2 + 1, c] = True
+            wall[t2, c + 1] = True
+        elif t2 < t1:
+            wall[t1, c + 1] = True
+            wall[t2 : t1 + 1, c + 1] = True
+        else:
+            wall[t1, c + 1] = True
