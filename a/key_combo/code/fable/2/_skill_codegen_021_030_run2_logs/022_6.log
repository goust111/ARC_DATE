+                ext = random.randint(2, ext_hi)
+                _paint_rect(fill, top - ext, seg_left, top - 1, seg_right)
+            else:
+                limit_bottom = shape[0] - 1 if outer_limits is None else outer_limits[2]
+                ext_hi = min(3, limit_bottom - bottom)
+                if ext_hi < 2:
