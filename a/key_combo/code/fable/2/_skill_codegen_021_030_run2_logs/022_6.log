+def _generate_rectilinear_nested_fills(shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray] | None:
+    h, w = shape
+    margin = 3
+    min_outer_h = 12
+    min_outer_w = 12
+    max_outer_h = h - 2 * margin - 2
+    max_outer_w = w - 2 * margin - 2
+    if max_outer_h < min_outer_h or max_outer_w < min_outer_w:
+        return None
+
+    outer_h = random.randint(min_outer_h, max_outer_h)
+    outer_w = random.randint(min_outer_w, max_outer_w)
+    outer_top = random.randint(margin, h - margin - outer_h)
+    outer_left = random.randint(margin, w - margin - outer_w)
+    outer_bottom = outer_top + outer_h - 1
+    outer_right = outer_left + outer_w - 1
+    outer_box = (outer_top, outer_left, outer_bottom, outer_right)
+    outer_fill = _build_rectilinear_fill(shape, outer_box, max_bulges=2)
+
+    gap = 4
+    inner_top_lo = outer_top + gap
+    inner_left_lo = outer_left + gap
+    inner_bottom_hi = outer_bottom - gap
+    inner_right_hi = outer_right - gap
+    if inner_bottom_hi - inner_top_lo + 1 < 7 or inner_right_hi - inner_left_lo + 1 < 7:
+        return None
+
+    inner_h = random.randint(7, inner_bottom_hi - inner_top_lo + 1)
+    inner_w = random.randint(7, inner_right_hi - inner_left_lo + 1)
+    inner_top = random.randint(inner_top_lo, inner_bottom_hi - inner_h + 1)
+    inner_left = random.randint(inner_left_lo, inner_right_hi - inner_w + 1)
+    inner_bottom = inner_top + inner_h - 1
+    inner_right = inner_left + inner_w - 1
+    inner_box = (inner_top, inner_left, inner_bottom, inner_right)
+    inner_limits = (outer_top + 2, outer_left + 2, outer_bottom - 2, outer_right - 2)
+    inner_fill = _build_rectilinear_fill(shape, inner_box, outer_limits=inner_limits, max_bulges=2)
+
+    if not np.all(inner_fill <= outer_fill):
+        return None
+
+    outer_boundary = _boundary_from_fill(outer_fill)
+    inner_boundary = _boundary_from_fill(inner_fill)
+    if np.any(outer_boundary & inner_boundary):
+        return None
+
+    wall_labels, wall_count = _label_mask(outer_boundary | inner_boundary)
+    if wall_count != 2:
+        return None
+    region_labels, region_count = _label_mask(~(outer_boundary | inner_boundary))
+    if region_count != 3:
+        return None
+    return outer_fill, inner_fill, outer_boundary, inner_boundary
