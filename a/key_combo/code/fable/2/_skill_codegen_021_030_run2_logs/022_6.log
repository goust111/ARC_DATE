+def _generate_nested_fills(shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray] | None:
+    h, w = shape
+    transpose = random.random() < 0.5
+    local_shape = (w, h) if transpose else (h, w)
+    outer = _generate_outer_fill(local_shape)
+    if outer is None:
+        return None
