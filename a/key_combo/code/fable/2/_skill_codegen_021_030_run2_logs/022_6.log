+
+def _fill_from_profiles(shape: tuple[int, int], c0: int, tops: list[int], bottoms: list[int]) -> np.ndarray:
+    h, w = shape
+    fill = np.zeros((h, w), dtype=bool)
+    for i, (top, bottom) in enumerate(zip(tops, bottoms)):
+        fill[top : bottom + 1, c0 + i] = True
+    return fill
