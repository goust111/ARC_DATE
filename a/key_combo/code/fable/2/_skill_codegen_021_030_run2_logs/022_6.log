+            span_hi = min(max_span, spans[-1] + 1, row_hi - top + 1)
+            for span in range(span_lo, span_hi + 1):
+                candidates.append((top, span))
+        if not candidates:
+            return None
+        top, span = random.choice(candidates)
+        tops.append(top)
+        spans.append(span)
