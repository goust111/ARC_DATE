+
+
+def _pick_separated(candidates: list[dict], count: int, blocked: set[Coord], min_sep: int = 3) -> list[dict] | None:
+    chosen: list[dict] = []
+    for cand in candidates:
+        pos = cand["pos"]
+        if pos in blocked:
+            continue
+        too_close = False
+        for other in chosen:
+            if _chebyshev(pos, other["pos"]) < min_sep:
+                too_close = True
+                break
+        if too_close:
+            continue
+        chosen.append(cand)
+        if len(chosen) == count:
+            return chosen
+    return None
+
+
+def _safe_region_cells(region_mask: np.ndarray, barrier_mask: np.ndarray) -> list[Coord]:
+    h, w = region_mask.shape
+    safe = []
+    for r, c in np.argwhere(region_mask):
+        rr = int(r)
+        cc = int(c)
+        if rr in (0, h - 1) or cc in (0, w - 1):
+            continue
+        near_barrier = False
+        for nr, nc in neighbors4(rr, cc):
+            if barrier_mask[nr, nc]:
+                near_barrier = True
+                break
+        if not near_barrier:
+            safe.append((rr, cc))
+    if safe:
+        random.shuffle(safe)
