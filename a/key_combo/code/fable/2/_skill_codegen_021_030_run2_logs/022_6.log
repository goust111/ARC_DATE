+            "gate": (r, c),
+            "axis": axis,
+            "wall": int(barrier_labels[r, c]),
+        }
+        gate_records.append(
+            {
+                "pos": (r, c),
+                "color": int(g[r, c]),
+                "axis": axis,
+                "from_region": reg_a,
+                "to_region": reg_b,
+                "wall": int(barrier_labels[r, c]),
+                "dest": outward_cells[0],
