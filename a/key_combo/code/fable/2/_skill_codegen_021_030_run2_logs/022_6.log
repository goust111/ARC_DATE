+def _generate_rectilinear_nested_fills(shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray] | None:
+    h, w = shape
+    outer_margin = 3
+    gap = 4
+    min_outer_h = 14
+    min_outer_w = 14
