        print('marker levels', sorted(m['level'] for m in analyzed['markers']))
        diff = np.argwhere(solved "'!= expected)
        print('"'diff count', len(diff))
        if len(diff):
            for r,c in diff[:20]:
                print('diff', (int(r),int(c)), solved[r,c], expected[r,c], inp[r,c])
    except Exception as e:
        print('analysis exception', type(e).__name__, e)
    break
else:
    print('no candidate')
