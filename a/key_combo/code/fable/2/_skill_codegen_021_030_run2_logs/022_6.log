+                continue
+            next_id += 1
+            queue = deque([(r, c)])
+            labels[r, c] = next_id
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_id
+                        queue.append((nr, nc))
+    return labels, next_id
