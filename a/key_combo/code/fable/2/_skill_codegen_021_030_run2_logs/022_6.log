+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    bg = info["bg"]
+
+    for marker in info["markers"]:
+        r, c = marker["pos"]
+        out[r, c] = bg
+
+    for marker in info["markers"]:
+        color = marker["color"]
+        region = marker["region"]
+        dest = marker["pos"]
+        steps = 0
+        while (region, color) in info["transitions"]:
