+            seg_len = random.randint(4, max(4, span - 4))
+            seg_left = random.randint(left + 2, right - 1 - seg_len)
+            seg_right = seg_left + seg_len - 1
+            if side == "top":
+                limit_top = 0 if outer_limits is None else outer_limits[0]
+                ext_hi = min(3, top - limit_top)
+                if ext_hi < 2:
