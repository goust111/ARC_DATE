    test_idx = remaining[0]

    src_a = inners[pair[0]][1]
    src_b = inners[pair[1]][1]
    test_inner = inners[test_idx][1]

    def stable_colors(src, dst):
        st = set()
        for c in set(int(x) for x in np.unique(src)):
            if c == 0:
                continue
            if np.array_equal(src == c, dst == c):
