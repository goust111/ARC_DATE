+        assert coords.size > 0
+        (r0, c0), (r1, c1) = coords.min(axis=0), coords.max(axis=0)
+        r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+
+        if r0 == r1:
+            span = g[r0, c0 : c1 + 1]
+            assert np.all((span == bg) | (span == color)), "row object must be monochrome with background holes"
