+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+GRID_ROWS = (22, 30)
+GRID_COLS = (20, 30)
+SPRITE_HEIGHT_RANGE = (2, 5)
+SPRITE_WIDTH_CHOICES = tuple(range(3, 9))
+PLACEMENT_PADDING = 1
+SHAPE_RETRIES = 80
+GENERATION_RETRIES = 500
+_GEN_CALL_COUNT = 0
