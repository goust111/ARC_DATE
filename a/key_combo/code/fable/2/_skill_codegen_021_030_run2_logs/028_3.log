+            idx != int(bar["sprite_index"])
+            and _vertical_gap(int(bar["row"]), sprite) < _vertical_gap(int(bar["row"]), sprites[int(bar["sprite_index"])])
+            for idx, sprite in enumerate(sprites)
+        )
+        for bar in bars
+    ):
