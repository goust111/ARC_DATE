+
+        patch_mask = patch != bg
+        region = out[r0 : r0 + h, c0 : c0 + w]
+        assert not np.any(region[patch_mask] != bg), "copy placement must not overwrite existing objects"
+        paste(out, patch, r0, c0, transparent=bg, clip=False)
