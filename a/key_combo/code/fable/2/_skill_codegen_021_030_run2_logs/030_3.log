+def _tight_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise ValueError("expected a non-empty mask")
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].astype(bool)
