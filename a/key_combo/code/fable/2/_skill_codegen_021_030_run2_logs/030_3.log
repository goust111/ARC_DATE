+    if int(base[r, c]) not in (int(bg), RED):
+        raise AssertionError("path attempted to overwrite an obstacle")
+    out[r, c] = RED
+
+
+def _paint_line(
+    out: np.ndarray,
+    base: np.ndarray,
+    a: tuple[int, int],
+    b: tuple[int, int],
+    bg: int,
+) -> None:
+    ar, ac = map(int, a)
+    br, bc = map(int, b)
+    if ar == br:
+        step = 1 if bc >= ac else -1
+        for cc in range(ac, bc + step, step):
+            _paint_cell(out, base, ar, cc, bg)
+        return
+    if ac == bc:
