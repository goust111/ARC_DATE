+
+def _mark_rect(blocked: np.ndarray, r0: int, c0: int, r1: int, c1: int, margin: int = 0) -> None:
+    h, w = blocked.shape
+    rr0 = max(0, int(r0) - int(margin))
+    cc0 = max(0, int(c0) - int(margin))
