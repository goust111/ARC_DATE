+        if c0 + w > width - 2:
+            continue
+        return c0
+    return None
+
+
+def _place_off_path(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    lane_c: int,
+) -> bool:
+    h, w = map(int, mask.shape)
+    H, W = grid.shape
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(1, H - h):
+        for c0 in range(1, W - w):
+            c1 = c0 + w - 1
+            if not (c1 < lane_c - 2 or c0 > lane_c + 2):
+                continue
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(H - 1, r0 + h)
+            cc1 = min(W - 1, c0 + w)
