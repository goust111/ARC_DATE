+        normal = (-dc, dr) if repeat_by_id[int(hit_idx)] else (dc, -dr)
+        side_front, side_back = _side_points(front, back, comp["bbox"], normal)
+        for point in (front, back, side_front, side_back):
+            if not _in_bounds(g.shape, point[0], point[1]):
