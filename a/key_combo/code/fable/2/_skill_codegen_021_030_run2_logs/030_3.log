+
+def _find_components(grid: np.ndarray, bg: int) -> tuple[list[dict], dict[tuple[int, int], int]]:
+    mask = (grid != int(bg)) & (grid != RED)
+    h, w = grid.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    coord_to_idx: dict[tuple[int, int], int] = {}
