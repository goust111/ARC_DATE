    out[r0 : r1 + 1, c0 : c1 + 1] = _apply_swaps(out[r0 : r1 + 1, c0 : c1 + 1], swaps)
    return out


def _gen_attempt() -> np.ndarray | None:
    horizontal = random.choice((False, True))
    n_frames = random.randint(3, 4)
