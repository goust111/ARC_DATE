+    out = []
+    for coords in comps:
+        if int(coords.shape[0]) < int(min_area):
+            continue
+        obj = np.full_like(grid, bg)
+        obj[coords[:, 0], coords[:, 1]] = grid[coords[:, 0], coords[:, 1]]
+        out.append(obj)
