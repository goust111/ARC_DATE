+if _arc_utils is not None:
+    bbox = _arc_utils.bbox
+    get_bg = _arc_utils.get_bg
+    find_components = _arc_utils.find_components
+else:
+    bbox = _fallback_bbox
+    get_bg = _fallback_get_bg
