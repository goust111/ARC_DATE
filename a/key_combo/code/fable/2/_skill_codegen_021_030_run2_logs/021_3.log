+        for coords in comps:
+            if int(coords.shape[0]) < int(min_area):
+                continue
+            mask = np.zeros_like(grid, dtype=bool)
+            mask[coords[:, 0], coords[:, 1]] = True
+            out.append({"color": None, "coords": coords, "bbox": _fallback_bbox(mask), "area": int(coords.shape[0])})
