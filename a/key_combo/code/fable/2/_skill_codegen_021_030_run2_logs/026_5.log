+    grid = np.zeros((height, width), dtype=int)
+
+    for idx, center in enumerate(all_centers):
+        _paint_square(grid, center, side, colors[idx], white_core=(idx == 0))
+
+    if not _validate_generated(grid):
+        return None
+    return grid
