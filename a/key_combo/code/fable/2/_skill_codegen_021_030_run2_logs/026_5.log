+
+def _bbox_from_centers(centers: list[tuple[int, int]], side: int) -> tuple[int, int, int, int]:
+    half = side // 2
+    rows = [r for r, _ in centers]
+    cols = [c for _, c in centers]
+    return min(rows) - half, min(cols) - half, max(rows) + half, max(cols) + half
+
+
+def _build_relative_centers(template_name: str, side: int) -> list[tuple[int, int]]:
+    edges = ACTIVE_TEMPLATES[template_name]
+    turns = random.randrange(4)
+    centers = [(0, 0)]
+    half = side // 2
+    offsets = [delta for delta in range(-half, half + 1) if delta != 0]
+
+    for parent_idx, base_dir in edges:
+        dname = _rotate_dir(base_dir, turns)
+        gap = side + random.randint(2, 4)
+        off = random.choice(offsets)
+        pr, pc = centers[parent_idx]
+
+        if dname == "R":
+            child = (pr + off, pc + gap)
+        elif dname == "L":
+            child = (pr + off, pc - gap)
+        elif dname == "D":
+            child = (pr + gap, pc + off)
+        else:
+            child = (pr - gap, pc + off)
+
+        centers.append(child)
+
+    return centers
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+
+
+def _place_decoy_centers(
