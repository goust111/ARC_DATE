    rel = build_chain(side,n)
    half = side//2
    minr=min(r for r,_ in rel)-half
    maxr=max(r for r,_ in rel)+half
    minc=min(c for _,c in rel)-half
    maxc=max(c for _,c in rel)+half
    span_h=maxr-minr+1
    span_w=maxc-minc+1
