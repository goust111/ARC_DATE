+def _build_chain_centers(side: int, orientation: str, count: int) -> list[tuple[int, int]]:
+    centers = [(0, 0)]
+    half = side // 2
+    offsets = [delta for delta in range(-half, half + 1) if delta != 0]
+
+    for _ in range(count - 1):
