+def _simulate(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg, squares, root_idx, occ = _parse_squares(g)
+
+    out = g.copy()
+    queue = deque([root_idx])
+    fired: set[int] = {root_idx}
+    depth = {root_idx: 0}
