+    half = side // 2
+    boxes = []
+    for r, c in all_centers:
+        if not (half <= r < height - half and half <= c < width - half):
+            return None
+        box = (r - half, c - half, r + half, c + half)
+        if any(_boxes_overlap(box, prev) for prev in boxes):
