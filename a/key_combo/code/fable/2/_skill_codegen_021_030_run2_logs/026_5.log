        box=(r-half,c-half,r+half,c+half)
        if any(mod._boxes_overlap(box, prev) for prev in boxes):
            bad=True;break
        boxes.append(box)
    if bad:
        continue
    colors=random.sample(mod.PALETTE,len(allc))
    grid=np.zeros((height,width),dtype=int)
    for idx,center in enumerate(allc):
        mod._paint_square(grid, center, side, colors[idx], white_core=(idx==0))
    if mod._validate_generated(grid, expect_branch=False):
        ok += 1
print('"'ok', ok)
