+        r, c = square.r0 - 1, cc
+    elif dr == 1:
+        r, c = square.r1 + 1, cc
+    elif dc == -1:
+        r, c = cr, square.c0 - 1
+    else:
+        r, c = cr, square.c1 + 1
+
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        hit = int(occ[r, c])
+        if hit >= 0:
