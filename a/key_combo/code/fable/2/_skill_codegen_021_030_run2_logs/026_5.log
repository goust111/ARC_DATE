+
+def _trace_ray(square: Square, dr: int, dc: int, occ: np.ndarray) -> tuple[list[tuple[int, int]], int | None]:
+    h, w = occ.shape
+    cr, cc = square.center
+
+    if dr == -1:
+        r, c = square.r0 - 1, cc
+    elif dr == 1:
+        r, c = square.r1 + 1, cc
+    elif dc == -1:
+        r, c = cr, square.c0 - 1
+    else:
+        r, c = cr, square.c1 + 1
