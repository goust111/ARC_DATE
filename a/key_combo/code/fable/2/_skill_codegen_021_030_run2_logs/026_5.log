+    span_w = c1 - c0 + 1
+    if span_h > 24 or span_w > 24:
+        return None
+
+    free_h = 30 - span_h
+    free_w = 30 - span_w
+    if free_h < 4 or free_w < 4:
+        return None
+
+    top = random.randint(1, max(1, free_h - 1))
+    left = random.randint(1, max(1, free_w - 1))
+    height = span_h + top + random.randint(1, free_h - top)
+    width = span_w + left + random.randint(1, free_w - left)
+
+    dr = top - r0
+    dc = left - c0
+    active_centers = [(r + dr, c + dc) for r, c in active_centers]
+
+    decoy_count = random.randint(1, 3)
+    decoy_centers = _place_decoy_centers(active_centers, side, height, width, decoy_count)
+    if len(decoy_centers) != decoy_count:
+        return None
+
+    all_centers = active_centers + decoy_centers
+    half = side // 2
+    boxes = []
+    for r, c in all_centers:
+        if not (half <= r < height - half and half <= c < width - half):
+            return None
+        box = (r - half, c - half, r + half, c + half)
+        if any(_boxes_overlap(box, prev) for prev in boxes):
+            return None
+        boxes.append(box)
+
+    colors = random.sample(PALETTE, len(all_centers))
+    root_idx = random.randrange(len(active_centers))
+    grid = np.zeros((height, width), dtype=int)
+
+    for idx, center in enumerate(all_centers):
+        _paint_square(grid, center, side, colors[idx], white_core=(idx == root_idx))
+
+    if not _validate_generated(grid, expect_branch=branch_mode):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid chain-ignition input")

