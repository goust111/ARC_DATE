+    depth: dict[int, int] = info["depth"]
+    rays = info["rays"]
+    out = info["output"]
+
+    if len(active) < 3 or len(squares) - len(active) < 1:
+        return False
+    if max(depth.values()) < 2:
+        return False
+    if np.array_equal(out, grid):
