+    "snake4": [(0, "R"), (1, "D"), (2, "R")],
+    "snake5": [(0, "R"), (1, "D"), (2, "R"), (3, "U")],
+    "branch4": [(0, "R"), (0, "D"), (1, "D")],
+    "branch5": [(0, "R"), (0, "D"), (1, "D"), (2, "R")],
+}
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+
+
+@dataclass(frozen=True)
+class Square:
+    idx: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    side: int
+    color: int
+    has_white_core: bool
