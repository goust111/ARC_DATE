+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        hit = int(occ[r, c])
+        if hit >= 0:
+            return cells, hit
+        cells.append((int(r), int(c)))
+        r += dr
+        c += dc
