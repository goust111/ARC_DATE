+def _parse_squares(grid: np.ndarray) -> tuple[int, list[Square], int, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = int(get_bg(g))
+
+    comps = components_mask(g != bg, connectivity=4)
+    assert comps, "expected at least one square"
