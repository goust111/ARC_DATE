+def _split_quadrants(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    h, w = map(int, g.shape)
+    assert h == w and h % 2 == 0, "expected an even square grid"
+    n = h // 2
+    return (
+        g[:n, :n].copy(),
+        g[:n, n:].copy(),
+        g[n:, :n].copy(),
+        g[n:, n:].copy(),
+    )
