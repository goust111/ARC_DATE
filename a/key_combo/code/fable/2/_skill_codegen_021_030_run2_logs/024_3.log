+def _apply_map(tile: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    lut = np.arange(10, dtype=int)
+    for src, dst in mapping.items():
+        lut[int(src)] = int(dst)
+    return lut[np.asarray(tile, dtype=int)]
