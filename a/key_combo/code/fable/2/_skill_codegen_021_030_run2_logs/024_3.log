+    inverses = [{dst: src for src, dst in mapping.items()} for mapping in perms]
+    n = int(aligned[0].shape[0])
+    completed = [np.zeros_like(aligned[0]) for _ in range(4)]
+
+    for r in range(n):
+        for c in range(n):
+            candidates = []
+            for q in range(4):
+                val = int(aligned[q][r, c])
+                if val != BLACK:
