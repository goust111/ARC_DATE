from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/2/024/3.py')
mod = SourceFileLoader('new_arc_task_semantics', str(p)).load_module()
for i in range(100):
    inp = mod.generate_input()
    aligned = mod._align_quadrants(inp)
    perms = mod._solve_permutations(aligned)
    assert mod._has_required_composition_case(aligned, perms)
    out = mod.main(inp)
    assert not np.any(out == 0)
    assert not np.array_equal(mod._wrong_rotate_only(inp), out)
print('semantic_checks', 100)
