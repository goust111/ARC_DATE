+
+def _neighbors4(r: int, c: int, n: int) -> list[tuple[int, int]]:
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < n:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < n:
+        out.append((r, c + 1))
+    return out
+
+
+def _boundary_mask(tile: np.ndarray) -> np.ndarray:
+    n = int(tile.shape[0])
+    mask = np.zeros_like(tile, dtype=bool)
+    for r in range(n):
+        for c in range(n):
+            color = int(tile[r, c])
+            for nr, nc in _neighbors4(r, c, n):
+                if int(tile[nr, nc]) != color:
+                    mask[r, c] = True
+                    break
