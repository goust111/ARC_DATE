+    for i, ob_a in enumerate(obstacles):
+        for ob_b in obstacles[i + 1 :]:
+            assert not _boxes_overlap((ob_a.r0, ob_a.c0, ob_a.r1, ob_a.c1), (ob_b.r0, ob_b.c0, ob_b.r1, ob_b.c1))
