+@dataclass(frozen=True)
+class Obstacle:
+    color: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    markers: tuple[tuple[int, int], tuple[int, int]]
+
+
+@dataclass(frozen=True)
