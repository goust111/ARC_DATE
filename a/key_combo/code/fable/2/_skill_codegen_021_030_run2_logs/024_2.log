+
+_BG = 0
+_GEN_CALL_COUNT = 0
+_SCENARIOS = (
+    (2, (2, 1)),
+    (3, (1, 2, 1)),
+    (2, (3, 1)),
+    (3, (2, 1, 2)),
+)
