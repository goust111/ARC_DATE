+def _component_sizes(mask: np.ndarray) -> list[int]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    sizes: list[int] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            size = 0
+            while stack:
