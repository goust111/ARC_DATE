+def _aligned_to_original_coord(q_idx: int, r: int, c: int, n: int) -> tuple[int, int]:
+    if q_idx == 0:
+        return r, c
+    if q_idx == 1:
+        return c, n - 1 - r
+    if q_idx == 2:
+        return n - 1 - r, n - 1 - c
+    if q_idx == 3:
+        return n - 1 - c, r
