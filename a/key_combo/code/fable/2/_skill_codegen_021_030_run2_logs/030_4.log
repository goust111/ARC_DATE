+        score += np.linspace(random.uniform(-0.8, 0.8), random.uniform(-0.8, 0.8), n)[:, None]
+        score += np.linspace(random.uniform(-0.8, 0.8), random.uniform(-0.8, 0.8), n)[None, :]
+        score += np.random.normal(scale=0.06, size=(n, n))
