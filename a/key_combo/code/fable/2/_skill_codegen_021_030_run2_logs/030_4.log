+    quads = [
+        g[:sep, :sep].copy(),
+        g[:sep, sep + 1 :].copy(),
+        g[sep + 1 :, sep + 1 :].copy(),
+        g[sep + 1 :, :sep].copy(),
+    ]
+    n = sep
+    assert all(q.shape == (n, n) for q in quads), "expected four equal square quadrants"
+    return sep_color, sep, n, quads
