+        flat = score.reshape(-1)
+        order = np.argsort(flat, kind="mergesort")
+        bits = np.zeros(flat.size, dtype=bool)
+        bits[order[-(flat.size // 2) :]] = True
+        bits = bits.reshape(n, n)
