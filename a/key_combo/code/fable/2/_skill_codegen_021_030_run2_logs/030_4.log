+
+
+def _build_grid(separator_color: int, quads: list[np.ndarray]) -> np.ndarray:
+    n = int(quads[0].shape[0])
+    grid = np.full((2 * n + 1, 2 * n + 1), int(separator_color), dtype=int)
+    for idx, quad in enumerate(quads):
