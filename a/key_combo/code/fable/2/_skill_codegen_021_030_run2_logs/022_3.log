+    rows = list(range(legend_top + 1, height))
+    options = []
+    for combo in itertools.combinations(rows, 3):
+        if combo[1] - combo[0] >= 2 and combo[2] - combo[1] >= 2:
+            options.append(tuple(int(v) for v in combo))
+    return options
+
