+    if min_height > GEN_HEIGHT_RANGE[1]:
+        return None
+    height = rng.randint(min_height, GEN_HEIGHT_RANGE[1])
+    width = rng.randint(*GEN_WIDTH_RANGE)
+    canvas_h = height - legend_h
+    legend_top = canvas_h
+
+    diamonds = _place_diamonds(canvas_h, width, specs, rng)
+    if diamonds is None:
