+    coords: set[tuple[int, int]] = set()
+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        if dc == 0:
+            coords.add((cr + dr, cc))
+        else:
+            coords.add((cr + dr, cc - dc))
+            coords.add((cr + dr, cc + dc))
+    return coords
