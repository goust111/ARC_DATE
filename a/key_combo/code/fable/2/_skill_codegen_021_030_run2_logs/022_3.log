+def _diamond_fill_coords(cr: int, cc: int, radius: int) -> set[tuple[int, int]]:
+    cr = int(cr)
+    cc = int(cc)
+    radius = int(radius)
+    coords: set[tuple[int, int]] = set()
+    for dr in range(-radius, radius + 1):
+        span = radius - abs(dr)
+        rr = cr + dr
+        for dc in range(-span, span + 1):
+            coords.add((rr, cc + dc))
+    return coords
