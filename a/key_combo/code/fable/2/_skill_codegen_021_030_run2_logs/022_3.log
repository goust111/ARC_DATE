+    wrong_assignments = [
+        _assignment_from_orders(bars_by_len, diamonds_left),
+        _assignment_from_orders(bars_by_len, diamonds_top),
+        _assignment_from_orders(bars_left, diamonds_left),
+        _assignment_from_orders(bars_top, diamonds_top),
