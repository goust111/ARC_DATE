+    row_options = _bar_row_options(legend_top, height)
+    if not row_options:
+        return None
+
+    for _ in range(GEN_BAR_TRIES):
+        rows = list(rng.choice(row_options))
+        rng.shuffle(rows)
+        rank_order = list(range(len(BAR_LENGTHS)))
+        rng.shuffle(rank_order)
