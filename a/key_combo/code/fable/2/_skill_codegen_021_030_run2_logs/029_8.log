    shared_r1 = min(ar1, br1)
    shared_c0 = max(ac0, bc0)
    shared_c1 = min(ac1, bc1)
    if shared_r1 >= shared_r0 and shared_c1 >= shared_c0:
        return None

    if shared_r1 - shared_r0 + 1 >= GEN_MIN_OVERLAP and (ac1 < bc0 or bc1 < ac0):
