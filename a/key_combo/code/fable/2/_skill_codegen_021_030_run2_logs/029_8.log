        if gap_r0 <= gap_r1 and np.all(g[gap_r0 : gap_r1 + 1, shared_c0 : shared_c1 + 1] == GEN_BG):
            candidates.append((gap_r1 - gap_r0 + 1, (gap_r0, shared_c0 + 1, gap_r1, shared_c1 - 1)))

