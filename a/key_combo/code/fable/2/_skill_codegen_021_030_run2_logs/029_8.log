spec:
  grid: 10x10 [observed], background 0
  markers:
    placement: every odd row (1,3,5,7 and optionally 9) has exactly two foreground pixels at columns 0 and W-1; even rows are entirely background
    count: 4-5 marked rows [observed]
    colors: each marker is a non-zero color (1-9); 4-5 distinct foreground colors total [observed]
    match_vs_mismatch: 0-2 rows have left==right (matching pair); rest have left!=right
    no_color_reuse_on_same_row_pair: left and right on a mismatch row are always different colors
  transform:
    matching rows (left==right) get entirely filled with that color
    mismatching rows and unmarked rows are unchanged

generation_strategy:
  approach: direct (simple enough to build forward)
  steps:
    1. Use a 10x10 grid of zeros.
    2. Pick num_marked from {4,5}; mark odd rows 1,3,5,7 (and 9 if 5).
    3. Pick num_match from 0..num_marked (prefer 0-2 for variety).
    4. Choose num_match rows to be matching; rest are mismatching.
    5. Sample 4-5 distinct non-zero colors. For each marked row, assign left/right from the color pool -- matching rows get same color both sides, mismatching rows get two different colors.
    6. Place markers at (row, 0) and (row, W-1).

