def _gen_shift_rect(rect: GEN_Rect, dr: int, dc: int) -> GEN_Rect:
    r0, c0, r1, c1 = rect
    return r0 + dr, c0 + dc, r1 + dr, c1 + dc


def _gen_rects_shape(rects: list[GEN_Rect]) -> tuple[int, int]:
    return max(r[2] for r in rects) + 1, max(r[3] for r in rects) + 1


