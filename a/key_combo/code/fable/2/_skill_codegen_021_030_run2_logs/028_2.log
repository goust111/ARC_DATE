+
+    expected = _build_expected(input_grid, objects)
+    if np.array_equal(input_grid, expected):
+        return None
+    if max(input_grid.shape) > 30 or max(expected.shape) > 30:
+        return None
+    if not _validate_instance(input_grid, expected, objects):
+        return None
+    return input_grid
+
