+def _free_positions(blocked: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    patch_h, patch_w = map(int, shape)
+    positions: list[tuple[int, int]] = []
+    for r in range(h - patch_h + 1):
+        for c in range(w - patch_w + 1):
