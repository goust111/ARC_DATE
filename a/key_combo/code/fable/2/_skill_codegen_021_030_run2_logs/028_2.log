+
+def _rows_to_mask(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _shape_entry(name: str, rows: list[str]) -> dict:
+    mask = _rows_to_mask(rows)
