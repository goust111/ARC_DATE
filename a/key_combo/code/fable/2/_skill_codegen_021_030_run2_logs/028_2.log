+
+def _choose_gap_shapes(rect_count: int) -> list[dict]:
+    first = SHAPE_BY_NAME[random.choice(("t4", "z4"))]
+    second_pool = [SHAPE_BY_NAME[name] for name in AREA4_NAMES if name != first["name"]]
+    second = random.choice(second_pool)
