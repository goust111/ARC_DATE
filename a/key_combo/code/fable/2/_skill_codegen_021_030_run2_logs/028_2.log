+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+MAX_GENERATION_ATTEMPTS = 400
+GRID_MIN = 22
+GRID_MAX = 30
+RECT_COUNT_CHOICES = (2, 3)
+DISTRACTOR_COUNT_CHOICES = (1, 2)
+RECT_SIZE_MIN = 4
+RECT_SIZE_MAX = 8
+PLACEMENT_MARGIN = 1
+FOREGROUND_COLORS = tuple(range(1, 10))
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return components
+
+
+def _component_mask(component: dict) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    coords = component["coords"]
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+
+    h, w = mask.shape
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _shape_signature(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    assert mask.any(), "shape signature requires a non-empty mask"
+    signatures: list[tuple[tuple[int, int], ...]] = []
+    for k in range(4):
+        rotated = np.rot90(mask, k)
+        coords = np.argwhere(rotated)
+        coords = coords - coords.min(axis=0)
+        signatures.append(tuple((int(r), int(c)) for r, c in coords))
+    return min(signatures)
