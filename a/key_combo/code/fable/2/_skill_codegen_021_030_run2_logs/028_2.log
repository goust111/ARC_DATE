+SHAPE_BY_NAME = {shape["name"]: shape for shape in SHAPES}
+AREA4_NAMES = ("square2", "line4", "t4", "z4")
+IRREGULAR_NAMES = {"l3", "t4", "z4", "u5", "p5"}
