+                "kind": "distractor",
+                "pair_id": rect_count + idx,
+                "patch": _make_sprite_patch(distractor_colors[idx], distractor_mask),
+                "color": int(distractor_colors[idx]),
+                "shape_sig": shape["sig"],
+                "shape_area": int(shape["area"]),
