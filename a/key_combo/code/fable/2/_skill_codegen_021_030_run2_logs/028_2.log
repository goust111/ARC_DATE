+    pool = [shape for shape in SHAPES if shape["name"] not in used]
+    while len(distractors) < distractor_count:
+        shape = random.choice(pool)
+        distractors.append(shape)
+        used.add(shape["name"])
+        pool = [item for item in pool if item["name"] != shape["name"]]
+    return distractors
