+SHAPES = [
+    _shape_entry("domino", ["11"]),
+    _shape_entry("line3", ["111"]),
+    _shape_entry("l3", ["10", "11"]),
+    _shape_entry("square2", ["11", "11"]),
+    _shape_entry("line4", ["1111"]),
+    _shape_entry("t4", ["010", "111"]),
+    _shape_entry("z4", ["110", "011"]),
