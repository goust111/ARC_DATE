+    assert inner_w == 5, "legend panel width must encode 3x3 mask + gap + color dot"
+    assert inner_h >= 3 and (inner_h + 1) % 4 == 0, "legend entries must be vertically stacked 3x3 blocks"
+    count = (inner_h + 1) // 4
