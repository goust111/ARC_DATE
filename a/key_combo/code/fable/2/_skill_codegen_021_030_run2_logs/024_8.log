+
+def _outline_mask(shape: tuple[int, int], color: int) -> np.ndarray:
+    h, w = shape
+    patch = np.full((h, w), BG, dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
