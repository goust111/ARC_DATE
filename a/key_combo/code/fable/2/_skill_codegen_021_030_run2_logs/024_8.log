+    for br in range(3):
+        for bc in range(3):
+            block = mask[br * k : (br + 1) * k, bc * k : (bc + 1) * k]
+            val = bool(block[0, 0])
+            assert np.all(block == val), "each scale block must be uniform"
+            small[br, bc] = val
+    return small
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Decode a corner legend of 3x3 masks, match each framed scaled-rotated copy, and fill the frame interior with the legend color.
+
+    Input structure:
+    - One corner contains a bordered legend panel with vertically stacked 3x3 one-color symbol masks, each paired with a single adjacent decode-color dot.
+    - Elsewhere, several hollow rectangular frames contain one monochrome copy of a legend mask after integer scaling and a quarter-turn rotation, sometimes padded by background inside the frame.
+    - The interior symbol colors are decoys chosen from other legend decode colors.
+
+    Rule:
+    - Read every legend entry as a binary 3x3 mask paired with its dot color.
+    - For each non-legend frame, crop the bbox of the interior symbol, recover the scale from bbox_side / 3, downsample each k-by-k block back to a 3x3 binary mask, and compare all four rotations against the legend masks until exactly one match remains.
+    - Fill the entire interior of that frame with the matched legend entry's decode color, leaving the legend panel and all frame borders unchanged.
+
+    Key insight:
+    - Size, orientation, and current color are all unreliable; only the crop -> normalize -> rotate -> match pipeline recovers the symbol identity from the in-grid legend.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    bg = int(get_bg(g))
+    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
+
+    panel_candidates = [
+        comp
+        for comp in components
+        if _is_rect_outline(comp) and _touches_corner(comp["bbox"], g.shape)
+    ]
+    assert len(panel_candidates) == 1, "expected exactly one corner legend panel"
+    panel = panel_candidates[0]
+    legend_entries = _extract_legend(g, panel["bbox"])
+
+    out = g.copy()
+    panel_box = tuple(panel["bbox"])
+    frame_candidates = [
+        comp
+        for comp in components
+        if _is_rect_outline(comp) and tuple(comp["bbox"]) != panel_box
+    ]
+    assert frame_candidates, "expected at least one framed symbol"
+
+    legend_masks = [mask for mask, _color in legend_entries]
+    legend_colors = [color for _mask, color in legend_entries]
+
+    for frame in frame_candidates:
+        r0, c0, r1, c1 = frame["bbox"]
+        assert r1 - r0 >= 2 and c1 - c0 >= 2, "frame interior must exist"
+        inner = g[r0 + 1 : r1, c0 + 1 : c1]
+        symbol_box = bbox(inner != bg)
+        assert symbol_box is not None, "frame interior must contain a symbol"
+        symbol_crop = crop_bbox(inner, symbol_box)
+        small = _downsample_symbol(symbol_crop != bg)
+
+        matches = []
+        for idx, legend_mask in enumerate(legend_masks):
+            if any(np.array_equal(np.rot90(small, rot), legend_mask) for rot in range(4)):
+                matches.append(idx)
+        assert len(matches) == 1, "normalized symbol must match exactly one legend entry"
+
+        fill_color = int(legend_colors[matches[0]])
+        out[r0 + 1 : r1, c0 + 1 : c1] = fill_color
+
+    return out
+
+
+def _random_derangement(n: int) -> list[int]:
+    items = list(range(n))
+    while True:
+        perm = items[:]
+        random.shuffle(perm)
+        if all(i != perm[i] for i in items):
+            return perm
+
+
+def _panel_outer_shape(symbol_count: int) -> tuple[int, int]:
+    return 4 * symbol_count + 1, 7
+
+
+def _place_panel(grid: np.ndarray, symbols: list[np.ndarray], decode_colors: list[int], corner: str) -> tuple[int, int, int, int]:
+    panel_h, panel_w = _panel_outer_shape(len(symbols))
+    h, w = grid.shape
+    if corner == "tl":
+        r0, c0 = 0, 0
+    elif corner == "tr":
+        r0, c0 = 0, w - panel_w
+    elif corner == "bl":
+        r0, c0 = h - panel_h, 0
+    else:
+        r0, c0 = h - panel_h, w - panel_w
+
+    paste(grid, _outline_mask((panel_h, panel_w), LEGEND_BORDER), r0, c0)
+    for idx, (symbol, decode_color) in enumerate(zip(symbols, decode_colors)):
+        er = r0 + 1 + idx * 4
+        ec = c0 + 1
+        patch = np.where(symbol, LEGEND_INK, BG).astype(int)
+        paste(grid, patch, er, ec, transparent=BG)
+        grid[er + 1, ec + 4] = int(decode_color)
+    return int(r0), int(c0), int(r0 + panel_h - 1), int(c0 + panel_w - 1)
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int = 0) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 + margin < br0 or br1 + margin < ar0 or ac1 + margin < bc0 or bc1 + margin < ac0)
+
+
+def _expand_box(box: tuple[int, int, int, int], shape: tuple[int, int], pad: int = 1) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
+
+
+def _frame_patch(symbol: np.ndarray, scale: int, rotation: int, trap_color: int, pads: tuple[int, int, int, int]) -> np.ndarray:
+    scaled = scale_sprite(np.rot90(symbol, rotation).astype(int), scale)
+    symbol_patch = np.where(scaled, trap_color, BG).astype(int)
+    top, bottom, left, right = pads
+    inner_h = symbol_patch.shape[0] + top + bottom
+    inner_w = symbol_patch.shape[1] + left + right
+    outer = _outline_mask((inner_h + 2, inner_w + 2), FRAME_BORDER)
+    outer[1 + top : 1 + top + symbol_patch.shape[0], 1 + left : 1 + left + symbol_patch.shape[1]] = symbol_patch
+    return outer
+
+
+def _build_specs(symbol_count: int, decode_colors: list[int]) -> list[dict]:
+    perm = _random_derangement(symbol_count)
+    repeated_symbol = random.randrange(symbol_count)
+
+    specs: list[dict] = []
+    for symbol_idx in range(symbol_count):
+        specs.append(
+            {
+                "symbol_idx": symbol_idx,
+                "trap_color": int(decode_colors[perm[symbol_idx]]),
+            }
+        )
+
+    extra_trap_choices = [color for color in decode_colors if color != decode_colors[repeated_symbol] and color != specs[repeated_symbol]["trap_color"]]
+    if not extra_trap_choices:
+        extra_trap_choices = [color for color in decode_colors if color != decode_colors[repeated_symbol]]
+    specs.append({"symbol_idx": repeated_symbol, "trap_color": int(random.choice(extra_trap_choices))})
+
+    for spec in specs:
+        spec["scale"] = int(random.choice(SCALE_VALUES))
+        spec["rotation"] = int(random.randrange(4))
+        spec["pads"] = (
+            int(random.randrange(3)),
+            int(random.randrange(3)),
+            int(random.randrange(3)),
+            int(random.randrange(3)),
+        )
+
+    if not any(spec["rotation"] for spec in specs):
+        specs[random.randrange(len(specs))]["rotation"] = int(random.choice((1, 2, 3)))
+    if not any(spec["scale"] > 1 for spec in specs):
+        specs[random.randrange(len(specs))]["scale"] = 2
+    if not any(sum(spec["pads"]) > 0 for spec in specs):
+        chosen = specs[random.randrange(len(specs))]
+        chosen["pads"] = (1, 0, 0, 0)
+
+    extra_spec = specs[-1]
+    base_spec = specs[repeated_symbol]
+    if (
+        extra_spec["trap_color"] == base_spec["trap_color"]
+        and extra_spec["scale"] == base_spec["scale"]
+        and extra_spec["rotation"] == base_spec["rotation"]
+        and extra_spec["pads"] == base_spec["pads"]
+    ):
+        extra_spec["rotation"] = (int(extra_spec["rotation"]) + 1) % 4
+
+    random.shuffle(specs)
+    return specs
+
+
+def _candidate_positions(shape: tuple[int, int], patch_shape: tuple[int, int], blocked: list[tuple[int, int, int, int]]) -> list[tuple[int, int]]:
+    h, w = shape
+    ph, pw = patch_shape
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(1, h - ph):
+        for c0 in range(1, w - pw):
+            box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if any(_boxes_overlap(box, other, margin=1) for other in blocked):
+                continue
+            candidates.append((r0, c0))
+    random.shuffle(candidates)
+    return candidates
+
+
+def _semantic_assertions(grid: np.ndarray, metadata: dict) -> None:
+    out = main(grid)
+    assert out.shape == grid.shape
+    assert not np.array_equal(out, grid), "output must differ from input"
+    frames = metadata["frames"]
+    symbols = [frame["symbol_idx"] for frame in frames]
+    trap_colors = [frame["trap_color"] for frame in frames]
+    rotations = [frame["rotation"] for frame in frames]
+    scales = [frame["scale"] for frame in frames]
+    assert len(set(symbols)) >= 2, "scene must include at least two symbol identities"
+    assert any(rot != 0 for rot in rotations), "scene must include a rotated symbol"
+    assert any(scale > 1 for scale in scales), "scene must include a scaled symbol"
+    assert any(sum(frame["pads"]) > 0 for frame in frames), "scene must require interior cropping"
+
+    by_symbol: dict[int, set[int]] = {}
+    for frame in frames:
+        by_symbol.setdefault(int(frame["symbol_idx"]), set()).add(int(frame["trap_color"]))
+        assert int(frame["trap_color"]) != int(metadata["decode_colors"][frame["symbol_idx"]])
+    assert any(len(colors) >= 2 for colors in by_symbol.values()), "some symbol must appear in two wrong colors"
+
+    input_to_output = {}
+    for frame in frames:
+        input_to_output.setdefault(int(frame["trap_color"]), set()).add(int(metadata["decode_colors"][frame["symbol_idx"]]))
+    assert any(len(targets) >= 2 for targets in input_to_output.values()) or any(
+        len(colors) >= 2 for colors in by_symbol.values()
+    ), "current color alone must not determine the output color"
+
+    for frame in frames:
+        r0, c0, r1, c1 = frame["box"]
+        fill = out[r0 + 1 : r1, c0 + 1 : c1]
+        expected_color = int(metadata["decode_colors"][frame["symbol_idx"]])
+        assert np.all(fill == expected_color), "frame interior must be recolored by decoded identity"
+
+
+def _generate_scene() -> tuple[np.ndarray, dict] | None:
+    symbol_count = int(random.choice(SYMBOL_COUNT_CHOICES))
+    symbols = [BASE_SYMBOLS[idx].copy() for idx in random.sample(range(len(BASE_SYMBOLS)), symbol_count)]
+    decode_colors = list(random.sample(DECODE_COLOR_POOL, symbol_count))
+    random.shuffle(symbols)
+    random.shuffle(decode_colors)
+
+    specs = _build_specs(symbol_count, decode_colors)
+    specs.sort(key=lambda spec: -(3 * spec["scale"] + sum(spec["pads"]) + 2) ** 2)
+
+    panel_h, panel_w = _panel_outer_shape(symbol_count)
+    min_h = max(GRID_MIN, panel_h + 3)
+    min_w = max(GRID_MIN, panel_w + 3)
+    h = random.randint(min_h, GRID_MAX)
+    w = random.randint(min_w, GRID_MAX)
+    grid = np.full((h, w), BG, dtype=int)
+
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    panel_box = _place_panel(grid, symbols, decode_colors, corner)
+
+    blocked = [_expand_box(panel_box, grid.shape, pad=1)]
+    placed_frames: list[dict] = []
+
+    for spec in specs:
+        symbol = symbols[spec["symbol_idx"]]
+        patch = _frame_patch(symbol, spec["scale"], spec["rotation"], spec["trap_color"], spec["pads"])
+        candidates = _candidate_positions(grid.shape, patch.shape, blocked)
+        if not candidates:
+            return None
+        r0, c0 = candidates[0]
+        paste(grid, patch, r0, c0)
+        box = (r0, c0, r0 + patch.shape[0] - 1, c0 + patch.shape[1] - 1)
+        blocked.append(_expand_box(box, grid.shape, pad=1))
+        placed_frames.append({**spec, "box": box, "patch_shape": patch.shape})
+
+    metadata = {
+        "symbols": symbols,
+        "decode_colors": decode_colors,
+        "panel_box": panel_box,
+        "frames": placed_frames,
+    }
+    try:
+        _semantic_assertions(grid, metadata)
+    except AssertionError:
+        return None
+    return grid, metadata
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        scene = _generate_scene()
+        if scene is not None:
+            return scene[0]
+    raise RuntimeError("failed to generate a valid legend-decoding scene")

