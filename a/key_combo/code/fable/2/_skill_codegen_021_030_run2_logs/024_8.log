+    if h < 2 or w < 2:
+        return False
+    expected = 2 * (h + w) - 4
+    if int(component["area"]) != expected:
+        return False
+    coords = {(int(r), int(c)) for r, c in component["coords"]}
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if on_border != ((r, c) in coords):
