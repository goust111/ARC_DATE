+
+
+def _downsample_symbol(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    assert h == w and h % 3 == 0, "scaled symbol bbox must be a square with side divisible by three"
+    k = h // 3
+    small = np.zeros((3, 3), dtype=bool)
+    for br in range(3):
