+def _shape_signature(patch: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    cropped = _crop_nonzero((patch != Color.BLACK).astype(int))
+    return cropped.shape, np.ascontiguousarray(cropped).tobytes()
