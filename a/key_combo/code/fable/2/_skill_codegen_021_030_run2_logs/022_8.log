+    for r in range(rows):
+        r0 = 1 + r * (chamber_h + 1)
+        for c in range(cols):
+            c0 = 1 + c * (chamber_w + 1)
+            out[r0 : r0 + chamber_h, c0 : c0 + chamber_w] = contents[r, c]
+    return out
+
+
+def _solve_contents(contents: np.ndarray) -> np.ndarray:
+    rows, cols, _ch, _cw = contents.shape
