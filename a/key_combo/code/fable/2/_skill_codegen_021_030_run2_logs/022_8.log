+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+FRAME_COLOR = Color.TEAL
+SPRITE_COLORS = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.GREY,
+    Color.PINK,
+    Color.ORANGE,
+    Color.MAROON,
