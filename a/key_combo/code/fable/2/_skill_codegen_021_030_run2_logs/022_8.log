+def _constant_step(positions: np.ndarray) -> int | None:
+    if positions.size < 2:
+        return None
+    diffs = np.diff(positions)
+    if np.any(diffs <= 1):
+        return None
+    if not np.all(diffs == diffs[0]):
+        return None
+    return int(diffs[0])
