+
+def _segment_cells(orientation: str, fixed: int, start: int, end: int) -> list[tuple[int, int]]:
+    if orientation == "h":
+        return [(fixed, c) for c in range(start, end + 1)]
+    return [(r, fixed) for r in range(start, end + 1)]
+
