+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+NON_WALL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+QUADRANTS = ("tl", "tr", "bl", "br")
+LAYOUTS = ((1, 2), (2, 1), (2, 2), (1, 3), (3, 1))
+GEN_ATTEMPTS = 400
