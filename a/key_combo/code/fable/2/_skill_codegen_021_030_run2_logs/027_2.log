+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _unique_colors(grid: np.ndarray, exclude: tuple[int, ...] = ()) -> list[int]:
+    return [int(color) for color in np.unique(grid) if int(color) not in exclude]
+
+
+def _compartment_boxes(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    boxes = []
+    for comp in _components(grid != GRAY):
+        box = _bbox(comp)
+        r0, c0, r1, c1 = box
+        assert len(comp) == (r1 - r0 + 1) * (c1 - c0 + 1), "compartment interior must be rectangular"
+        boxes.append(box)
+    return sorted(boxes)
