+            return False
+        if parsed_markers != set(spec["marker_global"]):
+            return False
+        if parsed_targets != _targets_from_spec(spec):
+            return False
+        if info["marker_color"] != spec["marker_color"] or info["pattern_color"] != spec["pattern_color"]:
