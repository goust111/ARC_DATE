+    assert not np.any(scene == GRAY), "scene must not contain gray cells"
+    coords = np.argwhere(mask)
+    assert coords.size > 0, "scene must contain color-code pixels"
+    return coords
+
+
+def _render_scene(
+    scene: np.ndarray,
+    mapping: dict[int, np.ndarray],
+    bg: int,
+    *,
+    full_block: bool = False,
+    recolor: bool = True,
