+    start = tuple(map(int, starts[0]))
+    direction = _border_direction(g.shape, start)
+
+    portals: list[dict] = []
+    cell_to_portal: dict[tuple[int, int], int] = {}
+    centers = np.argwhere(g == YELLOW)
+    assert len(centers) >= 2
+
+    for rr, cc in centers:
+        r = int(rr)
+        c = int(cc)
