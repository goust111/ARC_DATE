+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+ARM_COLORS = [BLUE, GREEN, GREY, PINK, ORANGE, TEAL, MAROON]
+ORIENTATIONS = ("down", "up", "right", "left")
+MAX_GEN_ATTEMPTS = 400
