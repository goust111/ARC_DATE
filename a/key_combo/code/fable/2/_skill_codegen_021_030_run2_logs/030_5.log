+        "start": start,
+        "direction": direction,
+        "portals": portals,
+        "cell_to_portal": cell_to_portal,
+        "color_to_portals": color_to_portals,
+    }
+
+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, dict]:
