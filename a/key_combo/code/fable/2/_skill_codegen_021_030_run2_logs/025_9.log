+        for gs in range(1, side_total - gap_len):
+            ge = gs + gap_len - 1
+            out.append((gs, ge))
+    return out
+
+
+def choose_interval_for_gap(
+    rng: random.Random,
+    side_total: int,
+    gap_local: tuple[int, int],
+    want_class: str,
+) -> tuple[int, int] | None:
