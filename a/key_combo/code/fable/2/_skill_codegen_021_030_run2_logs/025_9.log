+        "bottom": [(c0 + 1 + a, c0 + 1 + b) for a, b in bottom],
+        "left": [(r0 + 1 + a, r0 + 1 + b) for a, b in left],
+        "right": [(r0 + 1 + a, r0 + 1 + b) for a, b in right],
