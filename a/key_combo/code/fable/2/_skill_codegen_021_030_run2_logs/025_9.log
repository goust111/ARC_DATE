+
+def classify_interval(side_total: int, gap: tuple[int, int], interval: tuple[int, int]) -> str | None:
+    gs, ge = gap
+    bs, be = interval
+    gap_len = ge - gs + 1
+    block_len = be - bs + 1
+    if block_len <= gap_len:
+        return None
+    os = max(bs, gs)
+    oe = min(be, ge)
+    if os > oe:
+        return None
+    overlap_len = oe - os + 1
