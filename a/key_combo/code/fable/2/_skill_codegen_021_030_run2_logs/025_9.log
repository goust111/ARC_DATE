+    bottom = intervals_where(grid[r1, c0 + 1 : c1], lambda v: v != WALL_COLOR)
+    left = intervals_where(grid[r0 + 1 : r1, c0], lambda v: v != WALL_COLOR)
+    right = intervals_where(grid[r0 + 1 : r1, c1], lambda v: v != WALL_COLOR)
