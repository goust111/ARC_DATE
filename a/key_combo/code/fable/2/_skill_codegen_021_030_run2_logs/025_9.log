+    occupied = (out != BACKGROUND)
+    for spec in specs:
+        moved = move_component_cells(spec["coords"], spec["bbox"], spec["side"], spec["overlap_global"], wall_box)
+        for rr, cc in moved:
+            if not (0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]):
+                return None
+            if occupied[rr, cc]:
