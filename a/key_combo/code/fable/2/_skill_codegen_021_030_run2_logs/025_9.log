+
+
+def render_output(
+    grid: np.ndarray,
+    components: list[dict],
+    wall_box: tuple[int, int, int, int],
+    gaps: dict[str, list[tuple[int, int]]],
+) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
