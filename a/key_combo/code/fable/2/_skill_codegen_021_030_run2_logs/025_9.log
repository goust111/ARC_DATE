+        candidates.append("top")
+    if r0 > wr1 and c0 <= wc1 and c1 >= wc0:
+        candidates.append("bottom")
+    if c1 < wc0 and r0 <= wr1 and r1 >= wr0:
+        candidates.append("left")
+    if c0 > wc1 and r0 <= wr1 and r1 >= wr0:
+        candidates.append("right")
