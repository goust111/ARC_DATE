+    if side == "top":
+        r1 = wr0 - START_GAP - 1
+        r0 = r1 - motion_len + 1
+        box = (r0, span0, r1, span1)
+    elif side == "bottom":
+        r0 = wr1 + START_GAP + 1
+        r1 = r0 + motion_len - 1
+        box = (r0, span0, r1, span1)
+    elif side == "left":
