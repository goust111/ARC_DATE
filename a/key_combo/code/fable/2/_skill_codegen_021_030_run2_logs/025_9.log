+    return candidates[0]
+
+
+def match_gap(
+    side: str,
+    block_box: tuple[int, int, int, int],
+    gaps: dict[str, list[tuple[int, int]]],
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = block_box
+    if side in ("top", "bottom"):
+        span0, span1 = c0, c1
+        block_span = c1 - c0 + 1
+    else:
+        span0, span1 = r0, r1
+        block_span = r1 - r0 + 1
+    matches = []
+    for g0, g1 in gaps[side]:
+        o0 = max(span0, g0)
+        o1 = min(span1, g1)
