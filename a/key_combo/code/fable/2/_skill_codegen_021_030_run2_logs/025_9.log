+
+def side_capacity(side: str, wall_box: tuple[int, int, int, int], shape: tuple[int, int]) -> tuple[int, int]:
+    wr0, wc0, wr1, wc1 = wall_box
+    h, w = shape
+    if side == "top":
+        return wr1 - wr0 + 1, wr0 - START_GAP
+    if side == "bottom":
+        return wr1 - wr0 + 1, (h - wr1 - 1) - START_GAP
+    if side == "left":
