+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+WALL_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+START_GAP = 2
+MAX_GENERATION_ATTEMPTS = 500
