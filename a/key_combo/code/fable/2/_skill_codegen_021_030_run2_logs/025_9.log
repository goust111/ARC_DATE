+
+def build_component_from_spec(
+    side: str,
+    span_global: tuple[int, int],
+    motion_len: int,
+    wall_box: tuple[int, int, int, int],
+) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    wr0, wc0, wr1, wc1 = wall_box
