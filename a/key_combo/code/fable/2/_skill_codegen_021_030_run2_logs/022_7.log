_GEN_MARKER_ARM_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))

# Center-to-center spacing; connector gaps are spacing minus marker span.
_GEN_MIN_STEP = 4
_GEN_MAX_STEP = 8
