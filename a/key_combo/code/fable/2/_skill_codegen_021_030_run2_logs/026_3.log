def _gen_palette() -> np.ndarray:
    k = int(np.random.randint(PALETTE_SIZE_MIN, PALETTE_SIZE_MAX_EXCLUSIVE))
    palette = np.random.choice(PALETTE_COLORS, size=k, replace=False)
