+
+def _visible_vertical_mismatches(grid: np.ndarray, mask_color: int) -> int:
+    n = int(grid.shape[0])
+    count = 0
+    for r in range(n):
+        for c in range(n // 2):
+            left = int(grid[r, c])
+            right = int(grid[r, n - 1 - c])
+            if left == int(mask_color) or right == int(mask_color):
+                continue
+            if left != right:
+                count += 1
+    return int(count)
