    palette = _gen_palette()
    k = len(palette)

    grid = np.empty((GRID_SIZE, GRID_SIZE), dtype=int)
    orbit_order = np.random.permutation(len(GRID_ORBITS))
    for i, orbit_i in enumerate(orbit_order):
