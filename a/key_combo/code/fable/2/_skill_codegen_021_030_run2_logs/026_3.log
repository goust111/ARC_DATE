+        (int(n - 1 - r), int(c)),
+        (int(r), int(n - 1 - c)),
+        (int(n - 1 - r), int(n - 1 - c)),
+    )
+
+
+def _swap_color(color: int, pair: tuple[int, int]) -> int:
+    a, b = pair
+    if int(color) == int(a):
+        return int(b)
+    if int(color) == int(b):
+        return int(a)
+    return int(color)
+
+
+def _swap_array(arr: np.ndarray, pair: tuple[int, int]) -> np.ndarray:
+    a, b = pair
+    out = np.array(arr, dtype=int, copy=True)
+    mask_a = out == int(a)
+    mask_b = out == int(b)
+    out[mask_a] = int(b)
+    out[mask_b] = int(a)
+    return out
