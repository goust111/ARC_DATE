+
+def _shortcut_horizontal(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    mask_color: int,
+) -> np.ndarray | None:
+    n = int(grid.shape[0])
+    r0, c0, r1, c1 = box
+    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r in range(r0, r1 + 1):
