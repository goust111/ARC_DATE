+        r0, c0, r1, c1 = box
+        masked[r0 : r1 + 1, c0 : c1 + 1] = int(mask_color)
+        if _validate_instance(masked, full, box, mask_color, mode, swap_pair):
+            return masked
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _generate_one()
+        if grid is not None:
