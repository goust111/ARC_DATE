   175	def _scene_relations(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
   176	    g = np.asarray(grid, dtype=int)
   177	    bg, frames, owner = _extract_frames(g)
   178	    incoming: dict[int, int] = {}
   179	    for frame in frames:
   180	        target, hit_cell = _trace_from_gap(g, owner, frame["gap"], frame["dir"], bg)
   181	        frame["target"] = target
   182	        frame["hit_cell"] = hit_cell
   183	        if target is not None:
   184	            assert target != int(frame["index"])
   185	            assert target not in incoming, "each target frame must have at most one incoming ray"
   186	            incoming[target] = int(frame["index"])
   187	    return g, frames
