+    expected_targets = [cand["target"] for cand in assignment]
+    expected_gaps = [cand["gap"] for cand in assignment]
+    actual_targets = [frame["target"] for frame in scene_frames]
+    actual_gaps = [frame["gap"] for frame in scene_frames]
