    93	def _extract_frames(grid: np.ndarray) -> tuple[int, list[dict], np.ndarray]:
    94	    g = np.asarray(grid, dtype=int)
    95	    bg = int(get_bg(g))
    96	    assert bg == Color.BLACK
    97	
    98	    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    99	    assert comps, "expected at least one colored frame"
   100	    comps = sorted(comps, key=_bbox_sort_key)
   101	
   102	    colors = [int(comp["color"]) for comp in comps]
   103	    assert len(set(colors)) == len(colors), "frame colors must be unique"
   104	
   105	    owner = np.full(g.shape, -1, dtype=int)
   106	    frames: list[dict] = []
   107	    for idx, comp in enumerate(comps):
   108	        color = int(comp["color"])
   109	        r0, c0, r1, c1 = map(int, comp["bbox"])
   110	        h = r1 - r0 + 1
   111	        w = c1 - c0 + 1
   112	        assert h >= 3 and w >= 3, "frame bbox must be at least 3x3"
   113	
   114	        coords = {tuple(map(int, rc)) for rc in comp["coords"]}
   115	        expected_border: set[tuple[int, int]] = set()
   116	        for r in range(r0, r1 + 1):
   117	            expected_border.add((r, c0))
   118	            expected_border.add((r, c1))
   119	        for c in range(c0, c1 + 1):
   120	            expected_border.add((r0, c))
   121	            expected_border.add((r1, c))
   122	
   123	        missing = [cell for cell in sorted(expected_border) if int(g[cell]) == bg]
   124	        assert len(missing) == 1, "each frame must have exactly one border gap"
   125	        gap = missing[0]
   126	        side = _gap_side(gap, comp["bbox"])
   127	        if side in ("top", "bottom"):
   128	            assert c0 < gap[1] < c1, "gap must be non-corner"
   129	        else:
   130	            assert r0 < gap[0] < r1, "gap must be non-corner"
   131	
   132	        assert coords == expected_border - {gap}, "frame component must be a rectangle border with one gap"
   133	        assert int(comp["area"]) == len(expected_border) - 1
   134	        if r1 - r0 > 1 and c1 - c0 > 1:
   135	            assert np.all(g[r0 + 1 : r1, c0 + 1 : c1] == bg), "frame interior must be black"
   136	
   137	        for r, c in coords:
   138	            owner[r, c] = idx
   139	
   140	        frames.append(
   141	            {
   142	                "index": idx,
   143	                "color": color,
   144	                "bbox": (r0, c0, r1, c1),
   145	                "gap": gap,
   146	                "side": side,
   147	                "dir": _SIDE_DIRS[side],
   148	            }
   149	        )
   150	
   151	    return bg, frames, owner
