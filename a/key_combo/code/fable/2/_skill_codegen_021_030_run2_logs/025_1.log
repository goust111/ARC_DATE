   190	def main(grid: np.ndarray) -> np.ndarray:
   191	    """
   192	    Use each frame gap as a sightline cannon that fills the struck frame and reports the target color back to the source gap.
   193	
   194	    Input structure:
   195	    - The grid has a black background with several non-touching monochrome hollow rectangular frames of distinct colors.
   196	    - Every frame border has exactly one missing non-corner cell, and every frame interior is black.
   197	    - Looking straight outward from a gap, the sightline either crosses only black cells and hits another frame border, or leaves the grid.
   198	
   199	    Rule:
   200	    - For every frame, follow the ray that starts at its gap and goes outward perpendicular to that border side.
   201	    - If the ray first hits another frame, fill the struck frame interior with the source frame color and recolor the source gap cell with the struck frame color.
   202	    - If the ray leaves the grid without hitting a frame, keep that gap black; never draw the ray itself.
   203	
   204	    Key insight:
   205	    - A gap is simultaneously an emitter and an identifier port: it sends its own color into the first frame on its sightline, while the color that seals the gap tells you which frame was hit.
   206	    """
   207	    g, frames = _scene_relations(grid)
   208	    out = g.copy()
   209	
   210	    for frame in frames:
   211	        target = frame["target"]
   212	        if target is None:
   213	            continue
   214	        source_color = int(frame["color"])
   215	        r0, c0, r1, c1 = map(int, frames[target]["bbox"])
   216	        out[r0 + 1 : r1, c0 + 1 : c1] = source_color
   217	
   218	    for frame in frames:
   219	        target = frame["target"]
   220	        if target is None:
   221	            continue
   222	        r, c = map(int, frame["gap"])
   223	        out[r, c] = int(frames[target]["color"])
   224	
   225	    return out
   226	
