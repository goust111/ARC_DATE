   228	def _random_frames(shape: tuple[int, int]) -> list[dict] | None:
   229	    h, w = map(int, shape)
   230	    count = _randint(*_FRAME_COUNT_RANGE)
   231	    colors = [int(c) for c in np.random.choice(np.array(Color.NOT_BLACK), size=count, replace=False)]
   232	
   233	    frames: list[dict] = []
   234	    for color in colors:
   235	        placed = False
   236	        for _ in range(_PLACEMENT_ATTEMPTS):
   237	            fh = _randint(*_FRAME_HEIGHT_RANGE)
   238	            fw = _randint(*_FRAME_WIDTH_RANGE)
   239	            if fh + 2 * _EDGE_MARGIN > h or fw + 2 * _EDGE_MARGIN > w:
   240	                return None
   241	            r0 = _randint(_EDGE_MARGIN, h - fh - _EDGE_MARGIN)
   242	            c0 = _randint(_EDGE_MARGIN, w - fw - _EDGE_MARGIN)
   243	            bbox = (r0, c0, r0 + fh - 1, c0 + fw - 1)
   244	            if any(_bboxes_too_close(bbox, other["bbox"]) for other in frames):
   245	                continue
   246	            frames.append({"color": int(color), "bbox": bbox})
   247	            placed = True
   248	            break
   249	        if not placed:
   250	            return None
   251	
   252	    frames.sort(key=_bbox_sort_key)
   253	    for idx, frame in enumerate(frames):
   254	        frame["index"] = idx
   255	    return frames
   256	
   257	
   258	def _build_closed_scene(shape: tuple[int, int], frames: list[dict]) -> tuple[np.ndarray, np.ndarray]:
   259	    grid = np.full(shape, Color.BLACK, dtype=int)
   260	    owner = np.full(shape, -1, dtype=int)
   261	    for frame in frames:
   262	        idx = int(frame["index"])
   263	        _paint_border(grid, frame["bbox"], int(frame["color"]))
   264	        _paint_border(owner, frame["bbox"], idx)
   265	    return grid, owner
   266	
   267	
   268	def _raw_candidates(shape: tuple[int, int], frames: list[dict]) -> list[list[dict]]:
   269	    grid, owner = _build_closed_scene(shape, frames)
   270	    per_frame: list[list[dict]] = []
   271	    for frame in frames:
   272	        frame_idx = int(frame["index"])
   273	        frame_candidates: list[dict] = []
   274	        for side, direction in _SIDE_DIRS.items():
   275	            for gap in _side_cells(frame["bbox"], side):
   276	                target, hit_cell = _trace_from_gap(grid, owner, gap, direction, Color.BLACK)
   277	                frame_candidates.append(
   278	                    {
   279	                        "source": frame_idx,
   280	                        "gap": gap,
   281	                        "side": side,
   282	                        "dir": direction,
   283	                        "target": target,
   284	                        "hit_cell": hit_cell,
   285	                    }
   286	                )
   287	        assert frame_candidates
   288	        per_frame.append(frame_candidates)
   289	    return per_frame
   290	
   291	
   292	def _sample_candidates(group: list[dict], limit: int) -> list[dict]:
   293	    if len(group) <= limit:
   294	        return list(group)
   295	    picks = np.random.choice(len(group), size=limit, replace=False)
   296	    return [group[int(i)] for i in picks]
   297	
   298	
   299	def _reduced_candidates(raw: list[list[dict]]) -> list[list[dict]]:
   300	    reduced: list[list[dict]] = []
   301	    for frame_candidates in raw:
   302	        hits_by_target: dict[int, list[dict]] = {}
   303	        misses_by_side: dict[str, list[dict]] = {}
   304	        for cand in frame_candidates:
   305	            if cand["target"] is None:
   306	                misses_by_side.setdefault(str(cand["side"]), []).append(cand)
   307	            else:
   308	                hits_by_target.setdefault(int(cand["target"]), []).append(cand)
   309	
   310	        kept: list[dict] = []
   311	        for target in sorted(hits_by_target):
   312	            kept.extend(_sample_candidates(hits_by_target[target], _HIT_SAMPLES_PER_TARGET))
   313	        for side in sorted(misses_by_side):
   314	            kept.extend(_sample_candidates(misses_by_side[side], _MISS_SAMPLES_PER_SIDE))
   315	
   316	        if not kept:
   317	            kept = list(frame_candidates)
   318	        reduced.append(kept)
   319	    return reduced
