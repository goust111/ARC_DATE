+
+
+def _generate_case() -> np.ndarray | None:
+    height = _randint(*_GRID_SIZE_RANGE)
+    width = _randint(*_GRID_SIZE_RANGE)
+    frames = _random_frames((height, width))
+    if frames is None:
+        return None
