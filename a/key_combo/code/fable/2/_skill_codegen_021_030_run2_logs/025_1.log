   154	def _trace_from_gap(
   155	    grid: np.ndarray,
   156	    owner: np.ndarray,
   157	    gap: tuple[int, int],
   158	    direction: tuple[int, int],
   159	    bg: int,
   160	) -> tuple[int | None, tuple[int, int] | None]:
   161	    h, w = map(int, grid.shape)
   162	    dr, dc = map(int, direction)
   163	    r = int(gap[0] + dr)
   164	    c = int(gap[1] + dc)
   165	    while 0 <= r < h and 0 <= c < w:
   166	        if int(grid[r, c]) != bg:
   167	            target = int(owner[r, c])
   168	            assert target >= 0
   169	            return target, (r, c)
   170	        r += dr
   171	        c += dc
   172	    return None, None
   173	
