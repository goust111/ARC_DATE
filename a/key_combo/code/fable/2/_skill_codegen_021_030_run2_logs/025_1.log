+
+def _expected_output(inp: np.ndarray, frames: list[dict], assignment: list[dict]) -> np.ndarray:
+    out = np.asarray(inp, dtype=int).copy()
+    for cand in assignment:
+        target = cand["target"]
+        if target is None:
+            continue
+        source = int(cand["source"])
