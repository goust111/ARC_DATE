+    return relations
+
+
+def _analyze(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg, objects = _extract_objects(g)
+    assert objects, "expected at least one sprite"
