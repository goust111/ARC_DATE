+def _rotate_coord(r: int, c: int, pivot2: tuple[int, int], turns: int) -> tuple[int, int]:
+    turns %= 4
+    if turns == 0:
+        return int(r), int(c)
+
+    pr2, pc2 = map(int, pivot2)
+    r = int(r)
+    c = int(c)
+
+    if turns == 1:
+        nr_num = pr2 + pc2 - 2 * c
+        nc_num = pc2 - pr2 + 2 * r
+        assert nr_num % 2 == 0 and nc_num % 2 == 0
+        return nr_num // 2, nc_num // 2
+
+    if turns == 2:
+        return pr2 - r, pc2 - c
+
+    nr_num = pr2 - pc2 + 2 * c
+    nc_num = pr2 + pc2 - 2 * r
+    assert nr_num % 2 == 0 and nc_num % 2 == 0
+    return nr_num // 2, nc_num // 2
