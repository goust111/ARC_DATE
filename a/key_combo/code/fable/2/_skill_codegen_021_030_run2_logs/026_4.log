+        nc_num = pc2 - pr2 + 2 * r
+        assert nr_num % 2 == 0 and nc_num % 2 == 0
+        return nr_num // 2, nc_num // 2
+
+    if turns == 2:
+        return pr2 - r, pc2 - c
+
+    nr_num = pr2 - pc2 + 2 * c
+    nc_num = pr2 + pc2 - 2 * r
+    assert nr_num % 2 == 0 and nc_num % 2 == 0
+    return nr_num // 2, nc_num // 2
