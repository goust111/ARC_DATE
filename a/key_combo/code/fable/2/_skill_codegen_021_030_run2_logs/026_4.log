+    out = g.copy()
+    for r, c, color in analysis["missing_pixels"]:
+        assert out[int(r), int(c)] == analysis["bg"]
+        out[int(r), int(c)] = int(color)
+    return out
+
+
+def _frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = map(int, mask.shape)
+    cells = []
+    for r in range(h):
