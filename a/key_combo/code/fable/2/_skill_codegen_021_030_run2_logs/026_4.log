    palette = np.random.choice(PALETTE_COLORS, size=k, replace=False)
    return palette[np.random.permutation(k)]

def _gen_d4_orbits(n: int) -> list[tuple[tuple[int, int], ...]]:
    seen = np.zeros((n, n), dtype=bool)
    orbits = []
    for r in range(n):
        for c in range(n):
            if seen[r, c]:
