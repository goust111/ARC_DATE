+    best_support = max(pivot_counts.values())
+    best_pivots = [pivot2 for pivot2, count in pivot_counts.items() if count == best_support]
+    assert len(best_pivots) == 1, "expected a unique common pivot"
+    pivot2 = best_pivots[0]
