+    return {
+        "bg": bg,
+        "objects": objects,
+        "relations": relations,
+        "pivot2": pivot2,
+        "pivot_counts": pivot_counts,
+        "best_support": best_support,
+        "orbits": orbits,
+        "missing_pixels": missing_variants[0],
