            if index == 0:
                r0 = random.randint(1, height - h - 1)
                c0 = random.randint(1, width - w - 1)
                rects.append((r0, c0, r0 + h - 1, c0 + w - 1))
                used_top_lefts.add((r0, c0))
                continue

            candidates: list[BBox] = []
            for r0 in range(1, height - h):
                for c0 in range(1, width - w):
                    if (r0, c0) in used_top_lefts:
                        continue
                    rect = (r0, c0, r0 + h - 1, c0 + w - 1)
                    if any(not _pair_geometry_ok(rect, prev) for prev in rects):
                        continue
                    if not any(_overlap_area(rect, prev) > 0 for prev in rects):
                        continue
                    candidates.append(rect)
            if not candidates:
                break
            rect = random.choice(candidates)
            rects.append(rect)
            used_top_lefts.add((rect[0], rect[1]))
        else:
            rects = _sort_rects(rects)
            if not _overlap_graph_connected(rects):
                continue
            if _overlap_area(rects[-2], rects[-1]) == 0:
                continue
            if _center2(rects[-2]) == _center2(rects[-1]):
                continue
            marker_mask = _marker_mask((height, width), rects)
            cover = _cover_counts((height, width), rects)
            local_zones = [_stable_local_zone(i, rects, marker_mask, cover) for i in range(len(rects))]
            if any(len(zone) < 3 for zone in local_zones):
                continue
            if len(_relay_zone(rects[-2], rects[-1], marker_mask)) < 2:
                continue
            return rects
    return None


def _neighbors8(cell: Coord, shape: tuple[int, int]) -> list[Coord]:
    h, w = shape
    r, c = cell
    out: list[Coord] = []
    for nr in range(max(0, r - 1), min(h, r + 2)):
        for nc in range(max(0, c - 1), min(w, c + 2)):
            if nr == r and nc == c:
                continue
            out.append((nr, nc))
    return out


def _can_place(cells: tuple[Coord, ...], allowed: set[Coord], occupied: np.ndarray) -> bool:
    cell_set = set(cells)
    h, w = occupied.shape
    for r, c in cells:
        if not (0 <= r < h and 0 <= c < w):
            return False
        if (r, c) not in allowed or occupied[r, c]:
            return False
        for nr in range(max(0, r - 1), min(h, r + 2)):
            for nc in range(max(0, c - 1), min(w, c + 2)):
                if (nr, nc) in cell_set:
                    continue
                if occupied[nr, nc]:
                    return False
    return True


def _place_shape(
    grid: np.ndarray,
    occupied: np.ndarray,
    allowed: set[Coord],
    color: int,
    *,
    motion_rect: BBox | None = None,
) -> tuple[Coord, ...] | None:
    anchors = list(allowed)
    random.shuffle(anchors)
    size_groups = sorted({len(shape) for shape in SHAPES}, reverse=True)
    for size in size_groups:
        shapes = [shape for shape in SHAPES if len(shape) == size]
        random.shuffle(shapes)
        placements: list[tuple[Coord, ...]] = []
        for shape in shapes:
            for ar, ac in anchors:
                cells = tuple(sorted((ar + dr, ac + dc) for dr, dc in shape))
                if motion_rect is not None and _rotate_cells(motion_rect, cells) == cells:
                    continue
                if _can_place(cells, allowed, occupied):
                    placements.append(cells)
        if placements:
            chosen = random.choice(placements)
            for r, c in chosen:
                grid[r, c] = int(color)
                occupied[r, c] = True
            return chosen
    return None


def _outside_zone(height: int, width: int, rects: list[BBox], marker_mask: np.ndarray) -> set[Coord]:
    zone: set[Coord] = set()
    for r in range(height):
        for c in range(width):
            if marker_mask[r, c]:
                continue
            if any(_inside(rect, (r, c)) for rect in rects):
                continue
            zone.add((r, c))
    return zone


def _generate_candidate() -> tuple[np.ndarray, list[MarkerRect]] | None:
    rect_count = random.choice((2, 2, 3))
    height = random.randint(20, 28)
    width = random.randint(20, 28)
    rect_bboxes = _sample_rectangles(height, width, rect_count)
    if rect_bboxes is None:
        return None

    marker_colors = random.sample(ALL_COLORS, rect_count)
    remaining = [color for color in ALL_COLORS if color not in marker_colors]
    outside_count = 2 if rect_count == 2 or random.random() < 0.6 else 1
    shape_color_count = rect_count + 1 + outside_count
    shape_colors = random.sample(remaining, shape_color_count)

    rects = [
        MarkerRect(color=color, bbox=rect, corners=_corners(rect))
        for color, rect in zip(marker_colors, rect_bboxes)
    ]

