+    assert rects, "expected at least one marker rectangle"
+    top_lefts = {(rect.bbox[0], rect.bbox[1]) for rect in rects}
+    assert len(top_lefts) == len(rects), "marker rectangles must have unique top-left corners"
+    return rects
