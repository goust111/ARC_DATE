+    dst[movable] = BG
+    fill_mask = movable & ~incoming_marker
+    dst[fill_mask] = rotated[fill_mask]
+    return out
+
+
+def _apply_one_rotation_slow(grid: np.ndarray, rect: BBox, marker_mask: np.ndarray) -> np.ndarray:
