+    shapes: list[tuple[Coord, ...]] = []
+    for shape in base:
+        cur = _normalize_shape(shape)
+        for _ in range(4):
+            if cur not in seen:
+                seen.add(cur)
+                shapes.append(cur)
+            cur = _rot90_shape(cur)
