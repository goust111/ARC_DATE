+        actual = {tuple(map(int, coord)) for coord in coords.tolist()}
+        if actual != expected:
+            continue
+        rects.append(
+            MarkerRect(
+                color=color,
+                bbox=(rows[0], cols[0], rows[1], cols[1]),
+                corners=tuple(sorted(expected)),
