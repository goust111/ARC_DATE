+        hh = random.randint(5, 7)
+        wh = random.randint(10, min(15, width - 4))
+        hv = random.randint(10, min(15, height - 4))
+        wv = random.randint(5, 7)
+        if hh + 4 > hv or wv + 4 > wh:
