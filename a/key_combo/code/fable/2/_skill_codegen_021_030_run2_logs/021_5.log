+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return None
+    return (r0, c0, r1, c1)
+
+
+def _overlap_area(a: BBox, b: BBox) -> int:
+    ov = _overlap_bbox(a, b)
+    return 0 if ov is None else _rect_area(ov)
+
+
+def _rotate_point(rect: BBox, cell: Coord) -> Coord:
+    r0, c0, r1, c1 = rect
+    r, c = cell
+    return (r0 + r1 - r, c0 + c1 - c)
