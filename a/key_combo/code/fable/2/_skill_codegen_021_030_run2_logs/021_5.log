+
+def _corners(rect: BBox) -> tuple[Coord, Coord, Coord, Coord]:
+    r0, c0, r1, c1 = rect
+    return ((r0, c0), (r0, c1), (r1, c0), (r1, c1))
+
+
+def _rect_area(rect: BBox) -> int:
+    r0, c0, r1, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
