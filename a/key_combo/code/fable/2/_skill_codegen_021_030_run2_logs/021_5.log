+
+def _pair_geometry_ok(a: BBox, b: BBox) -> bool:
+    if _center2(a) == _center2(b):
+        return False
+    overlap = _overlap_bbox(a, b)
+    if overlap is None:
+        return True
+    for corner in _corners(a):
+        if _inside(b, corner):
+            return False
+    for corner in _corners(b):
+        if _inside(a, corner):
