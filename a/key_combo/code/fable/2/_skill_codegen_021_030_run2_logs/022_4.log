171: def _random_edge_center(shape, max_r):
172:     """Sample a center just outside one edge, matching the original clipped placement."""
173:     h, w = shape
174:     edge = random.choice(EDGES)
175:     if edge == "top":
176:         return (
177:             random.randint(max(-max_r + 1, -max_r), min(max_r - 2, 0)),
178:             random.randint(max_r, w - 1 - max_r),
179:         )
180:     if edge == "bottom":
181:         return (
182:             random.randint(
183:                 max(h - 1, h - max_r + 1),
184:                 min(h + max_r - 2, h + max_r - 1),
185:             ),
186:             random.randint(max_r, w - 1 - max_r),
187:         )
188:     if edge == "left":
189:         return (
190:             random.randint(max_r, h - 1 - max_r),
191:             random.randint(max(-max_r + 1, -max_r), min(max_r - 2, 0)),
192:         )
193:     return (
194:         random.randint(max_r, h - 1 - max_r),
195:         random.randint(
196:             max(w - 1, w - max_r + 1),
197:             min(w + max_r - 2, w + max_r - 1),
198:         ),
199:     )

