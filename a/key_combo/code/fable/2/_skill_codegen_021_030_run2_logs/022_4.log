80: def main(grid: np.ndarray) -> np.ndarray:
81:     """Red diamond outlines contract by one layer and gray diamond outlines expand by one layer while other objects stay fixed.
82: 
83:     Input structure
84:     - A 16x16 orange-background grid contains one-cell-thick Manhattan-diamond outlines.
85:     - Red and gray outlines are the changing objects; other colored diamond outlines are static.
86:     - Some outlines may be clipped by the grid boundary, but their visible pixels still fit a clipped Manhattan-distance contour.
87:     Rule
88:     - Clear all red and gray pixels.
89:     - Red objects are redrawn with the same diamond center and radius minus one.
90:     - Gray objects are redrawn with radius plus one; an ambiguous edge-clipped growing arc continues away from the nearest perpendicular edge.
91:     Key insight
92:     - The task is not about moving whole objects: each changing object is a contour of a diamond, and the visible operation is one step of contour contraction or expansion.
93:     """
94:     g = np.asarray(grid, dtype=int)
95:     assert g.shape == (16, 16)
96:     bg = get_bg(g)
97:     assert bg not in (RED, GRAY)
98: 
99:     colors = set(map(int, g.flatten()))
100:     assert RED in colors and GRAY in colors
101: 
102:     out = g.copy()
103:     changing = np.isin(g, [RED, GRAY])
104:     protected = (g != bg) & ~changing
105:     out[changing] = bg
106:     painted = np.zeros(g.shape, dtype=bool)
107: 
108:     for comp in find_components(g, bg=bg, connectivity=8, colors=[RED], return_format="dict"):
109:         cr, cc, radius, _ = _minimal_diamond_fit(comp["coords"], g.shape)
110:         assert radius >= 1
111:         _paint_checked(out, _diamond_outline(g.shape, cr, cc, radius - 1), RED, protected, painted)
112: 
113:     for comp in find_components(g, bg=bg, connectivity=8, colors=[GRAY], return_format="dict"):
114:         _paint_checked(out, _gray_outline(comp["coords"], g.shape), GRAY, protected, painted)
115: 
116:     return out
