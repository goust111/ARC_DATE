143: def _gen_overlap_slices(shape, dr, dc):
144:     h, w = shape
145:     r0 = max(0, -dr)
146:     r1 = min(h, h - dr)
147:     c0 = max(0, -dc)
148:     c1 = min(w, w - dc)
149:     return r0, r1, c0, c1
