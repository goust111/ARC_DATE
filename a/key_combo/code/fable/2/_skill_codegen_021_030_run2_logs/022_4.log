141: def _gen_diamond_pixels(shape, cr, cc, radius):
142:     """Get visible pixels of a diamond outline clipped to grid."""
143:     h, w = shape
144:     if radius == 0:
145:         if 0 <= cr < h and 0 <= cc < w:
146:             return {(cr, cc)}
147:         return set()
148:     pts = set()
149:     for i in range(radius):
150:         for r, c in [(cr - radius + i, cc + i), (cr + i, cc + radius - i),
151:                      (cr + radius - i, cc - i), (cr - i, cc - radius + i)]:
152:             if 0 <= r < h and 0 <= c < w:
153:                 pts.add((r, c))
154:     return pts
155: 
