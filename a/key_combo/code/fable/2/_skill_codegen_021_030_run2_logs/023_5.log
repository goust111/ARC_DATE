+    gap_masks = [np.zeros(width, dtype=bool) for _ in range(n_bars)]
+    for route in routes:
+        col = int(route["col"])
+        for bar_idx, status in enumerate(route["statuses"]):
+            ok = True
+            if status == "single":
+                ok = _mark_single_gap(gap_masks[bar_idx], col)
+            elif status == "wide":
+                ok = _mark_wide_gap(gap_masks[bar_idx], col)
+            if not ok:
