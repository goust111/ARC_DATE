+
+def _pad8(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = int(r) + int(dr)
+                cc = int(c) + int(dc)
