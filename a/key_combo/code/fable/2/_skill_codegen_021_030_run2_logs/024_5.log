+    out[out == RED] = bg
+    for obj in objects:
+        moved = obj["coords"] + np.array([[int(dr), int(dc)]], dtype=int)
+        rr = moved[:, 0]
+        cc = moved[:, 1]
+        assert np.all(0 <= rr) and np.all(rr < g.shape[0])
+        assert np.all(0 <= cc) and np.all(cc < g.shape[1])
