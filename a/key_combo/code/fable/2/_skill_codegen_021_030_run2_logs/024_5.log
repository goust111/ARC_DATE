 130:     areas: list[int] = []
 131:     remaining = int(total)
 132:     for slots in range(int(count), 0, -1):
 133:         if slots == 1:
 134:             if remaining not in values:
 135:                 return None
 136:             areas.append(remaining)
 137:             break
 138:         feasible = [v for v in values if can_make(remaining - v, slots - 1)]
 139:         if not feasible:
 140:             return None
 141:         area = random.choice(feasible)
 142:         areas.append(area)
 143:         remaining -= area
 144:     random.shuffle(areas)
 145:     return areas
