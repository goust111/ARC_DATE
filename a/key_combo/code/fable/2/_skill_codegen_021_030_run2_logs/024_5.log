 114: def _gen_split_areas(total: int, count: int, values: list[int]) -> list[int] | None:
 115:     memo: dict[tuple[int, int], bool] = {}
 116: 
 117:     def can_make(remaining: int, slots: int) -> bool:
 118:         key = (remaining, slots)
 119:         if key in memo:
 120:             return memo[key]
 121:         if slots == 0:
 122:             ok = remaining == 0
 123:         elif remaining < slots * values[0] or remaining > slots * values[-1]:
 124:             ok = False
 125:         else:
 126:             ok = any(can_make(remaining - v, slots - 1) for v in values)
 127:         memo[key] = ok
 128:         return ok
