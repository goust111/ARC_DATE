+
+def _normalize_shape(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    arr = np.array(cells, dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return tuple((int(arr[i, 0]), int(arr[i, 1])) for i in order)
