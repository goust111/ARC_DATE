  42: def main(grid: np.ndarray) -> np.ndarray:
  43:     """
  44:     Fill black holes by restoring the diagonal cyclic color pattern they interrupt.
  45: 
  46:     Input structure
  47:     - The grid is a rectangular cyclic pattern of non-black colors with some
  48:       black pixels removed.
  49:     - All non-black colors in the cycle remain visible somewhere in the input.
  50:     - Each diagonal residue modulo the number of non-black colors has one color.
  51: 
  52:     Rule
  53:     - Infer the diagonal direction and residue-to-color cycle from the visible
  54:       non-black pixels.
  55:     - Replace every black pixel with the color assigned to its diagonal residue.
  56:     - Preserve every non-black pixel.
  57: 
  58:     Key insight
  59:     - The blanks are not objects; they are missing cells in a global repeating
  60:       diagonal tile, so their colors are determined by row + column modulo the
  61:       cycle length.
  62:     """
  63:     g = np.asarray(grid, dtype=int)
  64:     assert g.ndim == 2, "expected a 2D grid"
  65: 
  66:     mode, residue_to_color = _diagonal_cycle(g)
  67:     period = len(residue_to_color)
  68: 
  69:     out = g.copy()
  70:     for r, c in np.argwhere(out == Color.BLACK):
  71:         key = _residue(int(r), int(c), period, mode)
  72:         out[r, c] = residue_to_color[key]
  73:     return out
