+    shapes = [candidates[int(i)] for i in chosen_indices]
+    placed = _place_pairs(rng, h, w, shapes, true_vector)
+    if placed is None:
+        return None
+    for idx, item in enumerate(placed):
+        item["index"] = int(idx)
+
