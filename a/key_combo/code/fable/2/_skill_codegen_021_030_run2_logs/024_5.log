+            continue
+        if len(unique_objects) >= 2:
+            return False
+        if len(unique_objects) >= 1:
+            wrong_but_plausible = True
+    if not wrong_but_plausible:
+        return False
+
+    try:
+        solved = main(inp)
+    except AssertionError:
+        return False
+    return bool(np.array_equal(solved, out))
+
