  55: def main(grid: np.ndarray) -> np.ndarray:
  56:     """
  57:     Paint the long hidden blank corridors green while preserving the colored clutter.
  58: 
  59:     Input structure:
  60:     - The grid has a dominant background color and one visible clutter color.
  61:     - Green is absent from the input and is used as the output fill color.
  62:     - The intended hidden corridors are long all-background rectangular bars, but
  63:       random background gaps can touch them or create small blank pockets.
  64: 
  65:     Rule:
  66:     - First keep only background pixels whose whole in-grid 3x3 neighborhood is background.
  67:     - Enumerate maximal rectangles inside that clear-background mask.
  68:     - In descending rectangle area, accept rectangles whose major axis spans at least
  69:       half a grid side and add only newly exposed 4-connected portions at least one
  70:       third of a grid side in area.
  71:     - Recolor the accepted background mask green.
  72: 
  73:     Key insight:
  74:     - The object to reveal is negative space: true corridors survive a one-pixel
  75:       clearance test and contribute long new rectangular growth, while incidental
  76:       gaps are either short or add only tiny disconnected fragments.
  77:     """
  78:     g = np.asarray(grid, dtype=int)
  79:     assert g.ndim == 2, "expected a 2D grid"
  80:     height, width = map(int, g.shape)
  81:     assert min(height, width) >= 3, "expected room for 3x3 blank neighborhoods"
  82: 
  83:     bg = get_bg(g)
  84:     colors = set(map(int, np.unique(g)))
  85:     assert Color.GREEN not in colors, "green is reserved for the revealed corridors"
  86:     assert len(colors - {bg}) == 1, "expected exactly one visible clutter color"
  87: 
  88:     clear = _clear_neighborhood_mask(g, bg)
  89:     min_major = min(height, width) // 2
  90:     min_new = min(height, width) // 3
  91: 
  92:     reveal = np.zeros_like(clear, dtype=bool)
  93:     for _area, h, w, r0, c0, r1, c1 in _maximal_true_rectangles(clear):
  94:         if max(h, w) < min_major:
  95:             continue
  96: 
  97:         rect = np.zeros_like(clear, dtype=bool)
  98:         rect[r0 : r1 + 1, c0 : c1 + 1] = True
  99:         new_cells = rect & ~reveal
 100: 
 101:         kept_new_cells = np.zeros_like(clear, dtype=bool)
 102:         for coords in components_mask(new_cells, connectivity=4):
 103:             if int(coords.shape[0]) >= min_new:
 104:                 kept_new_cells[coords[:, 0], coords[:, 1]] = True
 105: 
 106:         if np.any(kept_new_cells):
 107:             reveal |= kept_new_cells
 108: 
 109:     assert np.any(reveal), "expected at least one long hidden corridor"
 110:     assert np.all(g[reveal] == bg), "only background pixels may be revealed"
 111: 
