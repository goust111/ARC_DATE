   339	    reserved = _pad8(set().union(*(item["object_cells"] | item["shadow_cells"] for item in placed)), h, w)
   340	    used_vectors: set[tuple[int, int]] = set()
   341	    decoys: list[set[tuple[int, int]]] = []
   342	    candidates = [(i, vector) for i in range(len(placed)) for vector in _wrong_vector_pool(true_vector)]
   343	    rng.shuffle(candidates)
   344	
   345	    for obj_idx, wrong_vector in candidates:
   346	        if wrong_vector in used_vectors:
   347	            continue
   348	        object_cells = placed[obj_idx]["object_cells"]
   349	        decoy_cells = _translate_cell_set(object_cells, wrong_vector[0], wrong_vector[1])
   350	        if not all(0 <= r < h and 0 <= c < w for r, c in decoy_cells):
   351	            continue
   352	        if decoy_cells & reserved:
   353	            continue
   354	        decoys.append(decoy_cells)
   355	        reserved |= _pad8(decoy_cells, h, w)
   356	        used_vectors.add(wrong_vector)
   357	        if len(decoys) == int(decoy_count):
   358	            return decoys
   359	    return None
   360	
   361	
   362	def _render_scene(
   363	    h: int,
   364	    w: int,
   365	    colors: list[int],
   366	    placed: list[dict],
   367	    keep_indices: set[int],
   368	    decoys: list[set[tuple[int, int]]],
   369	) -> tuple[np.ndarray, np.ndarray]:
   370	    inp = np.full((h, w), BACKGROUND, dtype=int)
   371	    out = np.full((h, w), BACKGROUND, dtype=int)
   372	    for color, item in zip(colors, placed):
   373	        for r, c in item["object_cells"]:
   374	            inp[r, c] = int(color)
   375	            out[r, c] = int(color)
   376	        for r, c in item["shadow_cells"]:
   377	            out[r, c] = RED
   378	            if item["index"] in keep_indices:
   379	                inp[r, c] = RED
   380	    for decoy in decoys:
   381	        for r, c in decoy:
   382	            inp[r, c] = RED
   383	    return inp, out
   384	
   385	
   386	def _build_attempt(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray, tuple[int, int]] | None:
   387	    h = int(rng.integers(18, 29))
   388	    w = int(rng.integers(18, 29))
   389	    object_count = int(rng.integers(3, 6))
   390	    true_vector = _sample_true_vector(rng)
   391	
   392	    candidates = [shape for shape in SHAPE_LIBRARY if not _shape_overlaps_shift(shape, true_vector[0], true_vector[1])]
   393	    if len(candidates) < object_count:
   394	        return None
   395	
   396	    chosen_indices = rng.choice(len(candidates), size=object_count, replace=False)
   397	    shapes = [candidates[int(i)] for i in chosen_indices]
   398	    placed = _place_pairs(rng, h, w, shapes, true_vector)
   399	    if placed is None:
   400	        return None
   401	    for idx, item in enumerate(placed):
   402	        item["index"] = int(idx)
   403	
   404	    colors = list(map(int, rng.choice(OBJECT_COLORS, size=object_count, replace=False)))
   405	    keep_count = int(rng.integers(2, object_count))
   406	    keep_order = list(range(object_count))
   407	    rng.shuffle(keep_order)
   408	    keep_indices = set(keep_order[:keep_count])
   409	
   410	    decoy_count = 1 if rng.random() < 0.6 else 2
   411	    decoys = _place_decoys(rng, h, w, placed, true_vector, decoy_count)
   412	    if decoys is None:
   413	        return None
   414	
   415	    inp, out = _render_scene(h, w, colors, placed, keep_indices, decoys)
   416	    return inp, out, true_vector
   417	
   418	
   419	def _semantic_checks(inp: np.ndarray, out: np.ndarray, true_vector: tuple[int, int]) -> bool:
   420	    if inp.shape != out.shape or max(inp.shape) > 30:
   421	        return False
   422	    if get_bg(inp) != BACKGROUND or get_bg(out) != BACKGROUND:
   423	        return False
   424	    if np.array_equal(inp, out):
   425	        return False
   426	
   427	    input_red = inp == RED
   428	    output_red = out == RED
   429	    if not np.any(input_red & ~output_red):
   430	        return False
   431	    if not np.any(output_red & ~input_red):
   432	        return False
   433	
   434	    try:
   435	        bg, objects, shadows = _extract_scene(inp)
   436	        inferred, true_pairs, all_vectors = _infer_vector(objects, shadows)
   437	    except AssertionError:
   438	        return False
   439	
   440	    if bg != BACKGROUND or inferred != tuple(map(int, true_vector)):
   441	        return False
   442	
   443	    paired_objects = {i for i, _j in true_pairs}
   444	    paired_shadows = {_j for _i, _j in true_pairs}
   445	    if len(paired_objects) < 2:
   446	        return False
   447	    if len(paired_objects) >= len(objects):
   448	        return False
   449	    if len(paired_shadows) >= len(shadows):
   450	        return False
   451	
   452	    wrong_but_plausible = False
   453	    for vector, pairs in all_vectors.items():
   454	        unique_objects = {i for i, _j in pairs}
   455	        if vector == tuple(map(int, true_vector)):
   456	            continue
   457	        if len(unique_objects) >= 2:
   458	            return False
   459	        if len(unique_objects) >= 1:
   460	            wrong_but_plausible = True
   461	    if not wrong_but_plausible:
   462	        return False
   463	
   464	    try:
   465	        solved = main(inp)
   466	    except AssertionError:
   467	        return False
   468	    return bool(np.array_equal(solved, out))
   469	
   470	
   471	def generate_input() -> np.ndarray:
   472	    rng = np.random.default_rng()
   473	    for _ in range(MAX_GENERATION_ATTEMPTS):
   474	        built = _build_attempt(rng)
   475	        if built is None:
   476	            continue
   477	        inp, out, true_vector = built
   478	        if _semantic_checks(inp, out, true_vector):
   479	            return inp
   480	    raise RuntimeError("failed to generate a valid shadow-forensics input")

