+paste = _ARC_UTILS.paste
+
+
+MIN_RECT_COUNT = 3
+MAX_RECT_COUNT = 5
+MIN_RECT_SIDE = 3
+MAX_RECT_SIDE = 6
+MIN_CANVAS_H = 20
+MIN_CANVAS_W = 24
+MAX_CANVAS = 30
+ZONE_ROWS = 2
+ZONE_COLS = 3
+ZONE_MARGIN = 1
+ZONE_GAP = 2
+MAX_GENERATION_ATTEMPTS = 500
