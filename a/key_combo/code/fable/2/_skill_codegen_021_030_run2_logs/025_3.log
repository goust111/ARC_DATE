+    chain = []
+    seen = set()
+    color = heads[0]
+    while True:
+        assert color not in seen, "chain may not contain a cycle"
+        rect = by_color[color]
+        chain.append(rect)
+        seen.add(color)
+        if rect["marker_color"] is None:
