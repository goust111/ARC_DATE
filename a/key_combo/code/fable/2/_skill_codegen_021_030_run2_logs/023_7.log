    max_t=max(H,W)
    sols=[]
    common={c:[tuple(map(int,rc)) for rc in np.argwhere((left==c)&(right==c))] for c in colors}
    deltas={c:[tuple(map(int,rc)) for rc in np.argwhere((left"'!=c)&(right==c))] for c in colors}
    rights={c:[tuple(map(int,rc)) for rc in np.argwhere(right==c)] for c in colors}
    lefts={c:[tuple(map(int,rc)) for rc in np.argwhere(left==c)] for c in colors}
    for T in range(max_t+1):
        candmap={}
        ok=True
        for color in colors:
            cand=[]
            positions=common[color] if common[color] else rights[color]
            for sr,sc in positions:
                if not all(max(abs(r-sr),abs(c-sc))<=T for r,c in lefts[color]):
                    continue
                if not all(max(abs(r-sr),abs(c-sc))<=T+1 for r,c in rights[color]):
                    continue
                if not all(max(abs(r-sr),abs(c-sc))==T+1 for r,c in deltas[color]):
                    continue
                cand.append((sr,sc,color))
            if not cand:
                ok=False; break
            candmap[color]=cand
        if not ok:
            continue
        order=sorted(colors, key=lambda c: len(candmap[c]))
        used=set(); chosen=[]
