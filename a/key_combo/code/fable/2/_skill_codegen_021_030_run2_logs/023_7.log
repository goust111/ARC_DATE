            if len(sols)>1:
                return
            if i==len(order):
                seeds=chosen.copy()
                if np.array_equal(frame(seeds,T), left) and np.array_equal(frame(seeds,T+1), right):
                    sols.append((T, tuple(sorted(seeds))))
                return
            c=order[i]
            for seed in candmap[c]:
                if seed[:2] in used:
                    continue
                used.add(seed[:2]); chosen.append(seed)
                bt(i+1)
