+_BG = 0
+_PANEL_SIZE_RANGE = (9, 13)
+_TIME_RANGE = (1, 3)
+_SEED_COUNT_CHOICES = (3, 3, 3, 4)
+_PALETTE = tuple(range(1, 10))
+_MIN_SEED_GAP = 2
+_RIGHT_FILL_LIMIT = 0.58
+_OUTPUT_FILL_LIMIT = 0.68
