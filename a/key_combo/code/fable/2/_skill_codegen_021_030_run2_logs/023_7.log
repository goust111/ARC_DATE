            r=random.randint(0,H-1); c=random.randint(0,W-1)
            if (r,c) in used:
                continue
            used.add((r,c)); seeds.append((r,c,colors[len(seeds)]))
        left,_,_,_,_=simulate((H,W),seeds,T)
