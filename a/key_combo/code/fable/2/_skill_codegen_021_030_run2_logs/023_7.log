/bin/bash -lc "python - <<'PY'
import random, itertools, math
import numpy as np

BG=0

def simulate(shape, seeds, t, bg=0):
    H,W=shape
    out=np.full((H,W), bg, dtype=int)
    seed_arr=np.array([(r,c) for r,c,_ in seeds], dtype=int)
    colors=np.array([col for _,_,col in seeds], dtype=int)
    rr=np.arange(H)[:,None]
    cc=np.arange(W)[None,:]
    dists=np.maximum(np.abs(seed_arr[:,0,None,None]-rr), np.abs(seed_arr[:,1,None,None]-cc))
    min_d=dists.min(axis=0)
    winners=(dists==min_d)
    unique=winners.sum(axis=0)==1
    idx=dists.argmin(axis=0)
    mask=unique & (min_d<=t)
    out[mask]=colors[idx[mask]]
    return out, dists, min_d, unique, idx


def step_stats(shape, seeds, step):
    _, dists, min_d, unique, idx = simulate(shape, seeds, step)
    new=(unique & (min_d==step))
    conflict=((min_d==step) & (~unique))
    blocked=np.any(dists==step, axis=0) & (min_d<step)
    return new.sum(), conflict.sum(), blocked.sum()


def solve(inp):
    H,WW=inp.shape
    sep=WW//2
    left=inp[:,:sep]
    right=inp[:,sep+1:]
    H,W=left.shape
    bg=0
    colors=sorted(set(np.unique(left)).union(np.unique(right))-{bg, int(inp[0,sep])})
    left=np.array(left)
    right=np.array(right)

    def simulate_only(seeds,t):
        return simulate((H,W),seeds,t,bg)[0]

    max_t=max(H,W)
    solutions=[]
    common={c:[tuple(map(int,rc)) for rc in np.argwhere((left==c)&(right==c))] for c in colors}
    deltas={c:[tuple(map(int,rc)) for rc in np.argwhere((left"'!=c)&(right==c))] for c in colors}
    rights={c:[tuple(map(int,rc)) for rc in np.argwhere(right==c)] for c in colors}
    lefts={c:[tuple(map(int,rc)) for rc in np.argwhere(left==c)] for c in colors}
    for T in range(max_t+1):
        candmap={}
        ok=True
        for color in colors:
            cand=[]
            positions=common[color] or rights[color]
            for sr,sc in positions:
                if not all(max(abs(r-sr),abs(c-sc))<=T for r,c in lefts[color]):
                    continue
                if not all(max(abs(r-sr),abs(c-sc))<=T+1 for r,c in rights[color]):
                    continue
                if not all(max(abs(r-sr),abs(c-sc))==T+1 for r,c in deltas[color]):
                    continue
                cand.append((sr,sc,color))
            candmap[color]=cand
            if not cand:
                ok=False
                break
        if not ok:
            continue
        order=sorted(colors, key=lambda c: len(candmap[c]))
        used=set()
        chosen=[]
        def bt(i):
            if len(solutions)>1:
                return
            if i==len(order):
                seeds=chosen.copy()
                if np.array_equal(simulate_only(seeds,T), left) and np.array_equal(simulate_only(seeds,T+1), right):
                    solutions.append((T,tuple(sorted(seeds))))
                return
            c=order[i]
            for seed in candmap[c]:
                pos=seed[:2]
                if pos in used:
                    continue
                used.add(pos); chosen.append(seed)
                bt(i+1)
                chosen.pop(); used.remove(pos)
        bt(0)
        if len(solutions)>1:
            break
    return solutions


def gen_one():
    for attempt in range(10000):
        H=random.randint(8,13)
        W=random.randint(8,13)
        n=random.randint(3,4)
        T=random.randint(1,3)
        colors=random.sample([1,2,3,4,5,6,7,8,9], n+1)
        sep_col=colors[-1]
        colors=colors[:-1]
        seeds=[]
        # force one near edge
        edge_seed=(random.randint(0,H-1), random.choice([random.randint(0,min(T+1,W-1)), random.randint(max(0,W-T-2),W-1)]), colors[0])
        seeds.append(edge_seed)
        used={edge_seed[:2]}
        while len(seeds)<n:
            r=random.randint(0,H-1); c=random.randint(0,W-1)
            if (r,c) in used: continue
            used.add((r,c)); seeds.append((r,c,colors[len(seeds)]))
        left,_,_,_,_=simulate((H,W),seeds,T)
        right, dists, min_d, unique, idx = simulate((H,W),seeds,T+1)
        out, *_ = simulate((H,W),seeds,T+2)
        # visibility
        if any(np.count_nonzero((right==c)&(left!=c))==0 for c in colors):
            continue
        if any(np.count_nonzero((out==c)&(right!=c))==0 for c in colors):
            continue
        # semantics every sample
        conf1=np.count_nonzero((min_d==T+1)&(~unique))
        conf2=np.count_nonzero(simulate((H,W),seeds,T+2)[2]==T+2) # nonsense
        _,d2,m2,u2,_=simulate((H,W),seeds,T+2)
        conf2=np.count_nonzero((m2==T+2)&(~u2))
        blocked1=np.count_nonzero(np.any(dists==T+1,axis=0)&(min_d<T+1))
        blocked2=np.count_nonzero(np.any(d2==T+2,axis=0)&(m2<T+2))
        clip1=any(min(r,c,H-1-r,W-1-c)<T+1 for r,c,_ in seeds)
        clip2=any(min(r,c,H-1-r,W-1-c)<T+2 for r,c,_ in seeds)
        if not (conf1 and conf2 and blocked1 and blocked2 and (clip1 or clip2)):
            continue
        inp=np.hstack([left, np.full((H,1), sep_col,int), right])
        sols=solve(inp)
        if len(sols)!=1 or sols[0][0]!=T:
            continue
        if np.array_equal(left,right) or np.array_equal(right,out) or np.array_equal(left,out):
            continue
        return H,W,T,seeds, conf1,conf2,blocked1,blocked2, inp, out, sols
    return None

for i in range(20):
    res=gen_one()
    if not res:
        print('"'failed')
        break
    H,W,T,seeds,c1,c2,b1,b2,inp,out,sols=res
    print(i, 'ok', (H,W), 'T',T, 'seeds',seeds, 'conf',c1,c2,'blocked',b1,b2, 'sol', sols[0][0])
