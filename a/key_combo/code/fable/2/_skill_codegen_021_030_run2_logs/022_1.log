import numpy as np

BLACK, GREEN, GREY, PINK, TEAL = 0,3,5,6,8
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]

def turn(d, inst):
    return (d + (1 if inst==PINK else -1))%4

def simulate(arena, instructions):
    pts=np.argwhere(arena==GREEN)
    r,c=map(int,pts[0])
    sides=[]
    if r==0: sides.append(2)
    if r==arena.shape[0]-1: sides.append(0)
    if c==0: sides.append(1)
    if c==arena.shape[1]-1: sides.append(3)
    d=sides[0]
    out=arena.copy()
    i=0
    while True:
        dr,dc=DIRS[d]
        nr,nc=r+dr,c+dc
        blocked=not (0<=nr<arena.shape[0] and 0<=nc<arena.shape[1]) or arena[nr,nc]==GREY
        if blocked:
            if i>=len(instructions):
                break
            d=turn(d,instructions[i])
            i+=1
            continue
        r,c=nr,nc
        out[r,c]=GREEN
    return out

def build(H=10,W=12,r0=4,pc=5,upper=True,ending=1):
    a=np.zeros((H,W),int)
