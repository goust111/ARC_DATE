    else:
        inst+=[PINK,PINK,TEAL]
        if ending==0: inst+=[PINK]
        else:
            inst+=[TEAL]
            if ending==2: inst+=[TEAL]
    return a,inst

base,inst=build(upper=True,ending=2)
for k in range(4):
