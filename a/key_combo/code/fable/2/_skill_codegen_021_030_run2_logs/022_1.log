import numpy as np
BLACK,GREEN,GREY,PINK,TEAL=0,3,5,6,8
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]

def turn(d, inst):
    return (d + (1 if inst==PINK else -1))%4

def simulate(arena, instructions):
    pts=np.argwhere(arena==GREEN)
    r,c=map(int,pts[0])
    dirs=[]
    if r==0: dirs.append(2)
    if r==arena.shape[0]-1: dirs.append(0)
    if c==0: dirs.append(1)
    if c==arena.shape[1]-1: dirs.append(3)
    if len(dirs)"'!=1: return None
    d=dirs[0]
    out=arena.copy(); i=0
    while True:
        dr,dc=DIRS[d]; nr,nc=r+dr,c+dc
        blocked=not (0<=nr<arena.shape[0] and 0<=nc<arena.shape[1]) or arena[nr,nc]==GREY
        if blocked:
            if i>=len(instructions): break
            d=turn(d,instructions[i]); i+=1; continue
        r,c=nr,nc; out[r,c]=GREEN
    return out

def build(H=10,W=12,r0=4,pc=5,upper=True,ending=1):
    a=np.zeros((H,W),int)
    a[r0,0]=GREEN
    a[r0,pc+1]=GREY
    a[r0-1 if upper else r0+1,pc]=GREY
