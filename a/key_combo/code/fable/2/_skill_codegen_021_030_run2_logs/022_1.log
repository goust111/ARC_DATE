    else:
        inst+=[PINK,PINK,TEAL]
        if ending==0:
            inst+=[PINK]
        else:
            inst+=[TEAL]
            if ending==2:
                inst+=[TEAL]
    return a,inst

for upper in [True,False]:
  for ending in [0,1,2]:
    a,inst=build(upper=upper,ending=ending)
    out=simulate(a,inst)
    print('upper',upper,'ending',ending,'inst',inst,'green',np.argwhere(out==GREEN)[:10], 'count',np.sum(out==GREEN))
    print(out)
    print()
