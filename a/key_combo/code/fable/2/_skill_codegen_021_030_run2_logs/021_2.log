+def _scale_skeleton(skeleton: np.ndarray, row_factor: int, col_factor: int) -> np.ndarray:
+    return np.repeat(np.repeat(np.asarray(skeleton, dtype=int), row_factor, axis=0), col_factor, axis=1)
