+
+def _infer_positions(vertex_count: int, h_neighbors, v_neighbors, known_positions, max_rounds=None):
+    positions = {int(k): (int(v[0]), int(v[1])) for k, v in known_positions.items()}
+    depths = {int(k): 0 for k in positions}
+    rounds = 0
