+                        edges.append((idx, other, axis, color))
+                        if axis == "h":
+                            h_neighbors[idx].append(other)
+                            h_neighbors[other].append(idx)
+                        else:
+                            v_neighbors[idx].append(other)
+                            v_neighbors[other].append(idx)
+                    break
