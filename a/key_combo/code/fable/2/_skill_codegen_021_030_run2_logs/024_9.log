+        length = random.randint(*EXTRA_RUN_LENGTH_BOUNDS)
+        starts = [c0 for c0 in range(0, width - length + 1) if np.any(union_mask[row, c0 : c0 + length])]
+        if not starts:
+            continue
+        start = int(random.choice(starts))
+        blockers[row, start : start + length] = True
