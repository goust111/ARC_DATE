+    blockers = np.zeros((height, width), dtype=bool)
+    blocked_rows: set[int] = set()
+
+    if not _place_mandatory_run(blockers, seed_cols[0], blocked_rows):
+        return None
+    if not _place_mandatory_run(blockers, seed_cols[1], blocked_rows):
