+    grid = _build_input((height, width), seed_cols, seed_colors, blockers)
+    grid = _prune_redundant_blockers(grid)
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
