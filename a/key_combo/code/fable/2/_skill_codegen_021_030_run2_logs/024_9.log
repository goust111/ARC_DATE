import random
from collections import Counter
import numpy as np
BLACK=0; GREEN=3; GREY=5
SEED_COLORS=[1,2,4,6,7,8,9]

def full_cone(shape, sc):
    h,w=shape
    rr,cc=np.indices((h,w))
    return np.abs(cc-sc) <= rr

def propagate(shape, sc, blockers):
    h,w=shape
    lit=np.zeros((h,w),dtype=bool)
    lit[0,sc]=True
    for r in range(1,h):
        c0=max(0, sc-r)
        c1=min(w-1, sc+r)
        for c in range(c0,c1+1):
            if blockers[r,c]:
                continue
            if lit[r-1,max(0,c-1):min(w,c+2)].any():
                lit[r,c]=True
    return lit

def shadow_mask(shape, sc, blockers):
    full=full_cone(shape, sc)
    h,w=shape
    shadow=np.zeros((h,w),dtype=bool)
    for r,c in np.argwhere(blockers & full):
        r=int(r); c=int(c)
        for rr in range(r+1,h):
            span=rr-r
            shadow[rr,max(0,c-span):min(w,c+span+1)] = True
    return full & ~blockers & ~shadow

def merge(shape, blockers, seed_colors, masks, overlap_green=True):
    out=np.zeros(shape,dtype=int)
    out[blockers]=GREY
    a,b=masks
    c1,c2=seed_colors
    if overlap_green:
        out[a & ~b & ~blockers]=c1
        out[b & ~a & ~blockers]=c2
        out[a & b & ~blockers]=GREEN
    else:
        out[a & ~blockers]=c1
        out[b & ~blockers]=c2
    return out

def parse(grid):
    cols=[c for c,v in enumerate(grid[0]) if int(v) not in (BLACK,GREEN,GREY)]
    return cols,[int(grid[0,c]) for c in cols], grid==GREY

def build(shape, seed_cols, seed_colors, blockers):
    g=np.zeros(shape,dtype=int)
    for c,col in zip(seed_cols, seed_colors): g[0,c]=col
    g[blockers]=GREY
    return g

def correct_output(grid):
    cols, colors, blockers = parse(grid)
    masks=[propagate(grid.shape, sc, blockers) for sc in cols]
    return merge(grid.shape, blockers, colors, masks), masks

def informative(grid):
    seed_cols, seed_colors, blockers = parse(grid)
    out, masks = correct_output(grid)
    a,b=masks
    fulls=[full_cone(grid.shape, sc) & ~blockers for sc in seed_cols]
    tri=[shadow_mask(grid.shape, sc, blockers) for sc in seed_cols]
    no_shadow=merge(grid.shape, blockers, seed_colors, fulls)
    tri_out=merge(grid.shape, blockers, seed_colors, tri)
    no_green=merge(grid.shape, blockers, seed_colors, masks, overlap_green=False)
    green=np.count_nonzero(a&b)
    ex1=np.count_nonzero(a&~b)
    ex2=np.count_nonzero(b&~a)
    shadow=np.count_nonzero(((fulls[0]|fulls[1]) & ~(a|b) & ~blockers))
    bypass=np.count_nonzero((a & ~tri[0]) | (b & ~tri[1]))
    blocker_count=np.count_nonzero(blockers)
    lit = np.count_nonzero(a|b)
    return green,ex1,ex2,shadow,bypass,blocker_count, lit, np.array_equal(out,no_shadow), np.array_equal(out,tri_out), np.array_equal(out,no_green)

