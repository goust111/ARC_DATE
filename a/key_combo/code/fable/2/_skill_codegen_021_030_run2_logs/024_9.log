def get_bg(grid):
    return Counter(map(int, grid.flatten())).most_common(1)[0][0]


def full_cone(shape, sc):
    h,w=shape
    rr,cc=np.indices((h,w))
    return np.abs(cc-sc) <= rr


def propagate(shape, sc, blockers):
    h,w=shape
    lit=np.zeros((h,w),dtype=bool)
    lit[0,sc]=True
    for r in range(1,h):
        c0=max(0, sc-r)
        c1=min(w-1, sc+r)
        for c in range(c0,c1+1):
            if blockers[r,c]:
                continue
            left=max(0,c-1)
            right=min(w,c+2)
            if lit[r-1,left:right].any():
                lit[r,c]=True
    return lit


def shadow_mask(shape, sc, blockers):
    full=full_cone(shape, sc)
    h,w=shape
    shadow=np.zeros((h,w),dtype=bool)
    for r,c in np.argwhere(blockers & full):
        r=int(r); c=int(c)
        for rr in range(r+1,h):
            span=rr-r
            cc0=max(0,c-span)
            cc1=min(w-1,c+span)
            shadow[rr,cc0:cc1+1]=True
    return full & ~blockers & ~shadow


def merge(shape, blockers, seed_cols, seed_colors, masks, overlap_green=True):
    out=np.zeros(shape,dtype=int)
    out[blockers]=GREY
    a,b=masks
    c1,c2=seed_colors
    if overlap_green:
        out[a & ~b & ~blockers]=c1
        out[b & ~a & ~blockers]=c2
        out[a & b & ~blockers]=GREEN
    else:
        out[a & ~blockers]=c1
        out[b & ~blockers]=c2
    return out


def parse(grid):
    top=[c for c,v in enumerate(grid[0]) if int(v) not in (BLACK,GREEN,GREY)]
    cols=top
    colors=[int(grid[0,c]) for c in cols]
    return cols,colors,grid==GREY


def build(shape, seed_cols, seed_colors, blockers):
    g=np.zeros(shape,dtype=int)
    for c,col in zip(seed_cols, seed_colors):
        g[0,c]=col
    g[blockers]=GREY
    return g


def correct_output(grid):
    seed_cols, seed_colors, blockers = parse(grid)
    masks=[propagate(grid.shape, sc, blockers) for sc in seed_cols]
    return merge(grid.shape, blockers, seed_cols, seed_colors, masks), masks


def informative(grid):
    seed_cols, seed_colors, blockers = parse(grid)
    out, masks = correct_output(grid)
    a,b=masks
    fulls=[full_cone(grid.shape, sc) & ~blockers for sc in seed_cols]
    tri=[shadow_mask(grid.shape, sc, blockers) for sc in seed_cols]
    no_shadow=merge(grid.shape, blockers, seed_cols, seed_colors, fulls)
    tri_out=merge(grid.shape, blockers, seed_cols, seed_colors, tri)
    no_green=merge(grid.shape, blockers, seed_cols, seed_colors, masks, overlap_green=False)
    green=np.count_nonzero(a&b)
    ex1=np.count_nonzero(a&~b)
    ex2=np.count_nonzero(b&~a)
    shadow=np.count_nonzero(((fulls[0]|fulls[1]) & ~(a|b) & ~blockers))
    bypass=np.count_nonzero((a & ~tri[0]) | (b & ~tri[1]))
    blocker_count=np.count_nonzero(blockers)
    return {
        'green':green,'ex1':ex1,'ex2':ex2,'shadow':shadow,'bypass':bypass,'blockers':blocker_count,
        'good': green>=3 and ex1>=6 and ex2>=6 and shadow>=2 and bypass>=1 and blocker_count>=4 \\
            and not np.array_equal(out, no_shadow) and not np.array_equal(out, tri_out) and not np.array_equal(out, no_green)
    }


def prune(grid):
    seed_cols, seed_colors, blockers = parse(grid)
    base,_=correct_output(grid)
    cells=list(map(tuple,np.argwhere(blockers)))
    random.shuffle(cells)
    for r,c in cells:
        blockers[r,c]=False
        g=build(grid.shape, seed_cols, seed_colors, blockers)
        out,_=correct_output(g)
        if not np.array_equal(out, base):
            blockers[r,c]=True
    return build(grid.shape, seed_cols, seed_colors, blockers)


def gen_once():
    h=random.randint(12,22)
    w=random.randint(12,26)
    max_gap=min(w-4, h-3, 10)
    if max_gap < 4:
        return None
    gap=random.randint(4,max_gap)
    c1=random.randint(1,w-gap-2)
    c2=c1+gap
    colors=random.sample(SEED_COLORS,2)
