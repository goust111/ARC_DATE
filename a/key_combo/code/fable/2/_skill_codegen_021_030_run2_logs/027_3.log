+    inp[source_pos] = source_color
+
+    return {
+        "input": inp,
+        "wall_color": wall_color,
+        "source_color": source_color,
+        "source_pos": source_pos,
+        "breaches": breaches,
+        "pieces": pieces,
+    }
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        rng = random.Random()
+        layout = _build_attempt(rng)
+        if layout is None:
