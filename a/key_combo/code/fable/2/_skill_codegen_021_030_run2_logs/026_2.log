+            key = (frame.r0, c)
+            if frame.gap_side == "top" and c == frame.gap_c:
+                assert key not in top_gap_map and key not in top_shelf_map
+                top_gap_map[key] = idx
+            else:
+                assert key not in top_gap_map and key not in top_shelf_map
+                top_shelf_map[key] = idx
