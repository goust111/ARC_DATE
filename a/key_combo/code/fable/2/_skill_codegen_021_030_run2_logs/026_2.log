+            side_gap_map.setdefault((frame.gap_r, frame.c0 - 1), []).append(idx)
+        elif frame.gap_side == "right" and frame.c1 + 1 < width:
+            side_gap_map.setdefault((frame.gap_r, frame.c1 + 1), []).append(idx)
