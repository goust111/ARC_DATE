    all_shelves: list[tuple[int, int, int]] = []  # (row, a, b)

    def try_add_shelf(r: int, a: int, b: int, is_cascade: bool = False) -> bool:
        """Try to add a shelf segment. Check no conflict with existing shelves or reserved bg cells."""
