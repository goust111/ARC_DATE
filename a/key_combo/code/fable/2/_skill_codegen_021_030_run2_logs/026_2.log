+def _simulate(grid: np.ndarray, want_trace: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    height, width = map(int, g.shape)
+    assert 0 < height <= 30 and 0 < width <= 30
