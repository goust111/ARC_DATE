+    out = g.copy()
+    seen: set[tuple[int, int]] = set()
+    q = deque((0, c) for c in range(width) if int(g[0, c]) == int(water))
+
+    trace = {
+        "bg": bg,
+        "water": water,
+        "frame_color": frame_color,
+        "frames": frames,
+        "top_gap": set(),
+        "top_shelf": set(),
+        "side_fill": set(),
+        "activated": set(),
+    }
+
+    while q:
+        rr, cc = q.popleft()
+        rr = int(rr)
+        cc = int(cc)
+        while 0 <= rr < height and 0 <= cc < width:
+            if (rr, cc) in seen:
+                break
+            seen.add((rr, cc))
