        def sym_fill_base(a):
            y = np.zeros_like(a)
            for t in (lambda z: z, np.fliplr, np.flipud, lambda z: np.flipud(np.fliplr(z))):
                zz = t(a)
                rr, cc = np.where(zz != 0)
                for r, c in zip(rr.tolist(), cc.tolist()):
                    val = int(zz[r, c])
                    if y[r, c] != 0 and int(y[r, c]) != val:
                        return None
                    y[r, c] = val
            return y

