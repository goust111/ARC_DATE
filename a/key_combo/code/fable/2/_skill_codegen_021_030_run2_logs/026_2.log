+    frames = _parse_frames(g, frame_color, bg)
+
+    top_gap_map: dict[tuple[int, int], int] = {}
+    top_shelf_map: dict[tuple[int, int], int] = {}
+    side_gap_map: dict[tuple[int, int], list[int]] = {}
+    for idx, frame in enumerate(frames):
