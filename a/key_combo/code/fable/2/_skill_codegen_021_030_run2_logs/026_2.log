        if np.array_equal(dst == 0, src != 0):
            nz = np.argwhere(dst != 0)
            if nz.size > 0:
                even_cols = set()
                odd_cols = set()
                for r, c in nz:
                    col = int(dst[int(r), int(c)])
                    if ((int(r) + int(c)) & 1) == 0:
                        even_cols.add(col)
                    else:
                        odd_cols.add(col)
                if len(even_cols) == 1 and len(odd_cols) == 1:
