+    while q:
+        rr, cc = q.popleft()
+        rr = int(rr)
+        cc = int(cc)
+        while 0 <= rr < height and 0 <= cc < width:
+            if (rr, cc) in seen:
+                break
+            seen.add((rr, cc))
