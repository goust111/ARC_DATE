+                trace["activated"].add(frame_idx)
+                break
+
+            if (nr, cc) in top_shelf_map:
+                frame_idx = int(top_shelf_map[(nr, cc)])
+                frame = frames[frame_idx]
+                _paint_row(out, g, frame_color, water, rr, frame.c0 - 1, frame.c1 + 1)
