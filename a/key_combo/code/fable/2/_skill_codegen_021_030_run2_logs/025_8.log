+def _split_panels(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    height, total_width = map(int, g.shape)
