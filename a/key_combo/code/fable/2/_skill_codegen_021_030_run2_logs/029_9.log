+    while np.any(labels < 0):
+        frontier: list[tuple[int, int]] = []
+        for r in range(h):
+            for c in range(w):
+                if labels[r, c] >= 0:
+                    continue
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
