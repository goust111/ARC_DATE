    extras = total_pixels - count
    caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)

    if clustered == 0:
