+def _pair_signature(
+    grid: np.ndarray,
+    bg: int,
+    *,
+    allow_conflicts: bool = False,
+) -> frozenset[tuple[int, int, int, tuple[str, ...]]] | None:
+    details = _pair_details(grid, bg, allow_conflicts=allow_conflicts)
+    if details is None:
+        return None
+    return frozenset(
+        (
+            int(r),
+            int(c),
+            int(info["color"]),
+            tuple(sorted(str(orient) for orient in info["orients"])),
