+        neighbor_labels = []
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and labels[rr, cc] >= 0:
