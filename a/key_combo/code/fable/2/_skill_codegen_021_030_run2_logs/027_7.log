+        return None
+    if any(int(inp[r, c]) != int(GEN_BG) for r, c in connectors):
+        return None
+    if any(int(expected[r, c]) != int(marker_color) for r, c in connectors):
+        return None
+    if any(int(inp[r, c]) == int(marker_color) for r, c in missing_pixels):
+        return None
