+    missing_pixels = {
+        (r, c)
+        for r in range(mr0, mr1 + 1)
+        for c in range(mc0, mc1 + 1)
+    }
+    changed = {tuple(map(int, coord)) for coord in np.argwhere(inp != expected)}
