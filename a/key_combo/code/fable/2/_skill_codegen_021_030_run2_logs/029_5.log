+MAX_GENERATION_ATTEMPTS = 400
+GRID_COLOR_POOL = tuple(range(10))
+PARTITION_COUNT_RANGE = (2, 4)
+PARTITION_SIZE_RANGE = (4, 6)
+MAX_EXTRA_OCCUPIED = 2
+LINE_OBJECT_COUNT_CAP = 3
+LINE_SEGMENT_LEN_RANGE = (2, 3)
+BLOB_SIZE_RANGE = (1, 4)
