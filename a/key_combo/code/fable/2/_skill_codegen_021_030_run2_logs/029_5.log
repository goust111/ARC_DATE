+    for size in range(1, len(candidate_rows) + 1):
+        row_subsets.extend(combinations(candidate_rows, size))
+    col_subsets = []
+    for size in range(1, len(candidate_cols) + 1):
+        col_subsets.extend(combinations(candidate_cols, size))
