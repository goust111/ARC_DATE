+def _initial_col_candidates(grid: np.ndarray, color: int) -> list[int]:
+    cols: list[int] = []
+    for c in range(grid.shape[1]):
+        runs = _line_runs_1d(grid[:, c], color)
+        if len(runs) >= 2 and max(stop - start for start, stop in runs) >= 2:
+            cols.append(c)
+    return cols
