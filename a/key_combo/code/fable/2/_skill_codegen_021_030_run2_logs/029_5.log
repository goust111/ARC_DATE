+
+def _band_layout(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int], int]:
+    bands: list[tuple[int, int]] = []
+    separators: list[int] = []
+    pos = 0
+    for idx, size in enumerate(sizes):
+        bands.append((pos, pos + int(size)))
+        pos += int(size)
+        if idx + 1 < len(sizes):
+            separators.append(pos)
+            pos += 1
