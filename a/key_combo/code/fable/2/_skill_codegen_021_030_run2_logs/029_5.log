+        count += 1
+        dq: deque[tuple[int, int]] = deque([(int(r), int(c))])
+        seen[r, c] = True
+        while dq:
+            rr, cc = dq.popleft()
+            for nr, nc in _neighbors4(rr, cc):
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    dq.append((nr, nc))
