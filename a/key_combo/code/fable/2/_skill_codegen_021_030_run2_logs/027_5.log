from __future__ import annotations
import random, math
from collections import deque
import numpy as np

BLACK=0
COLORS=tuple(range(1,10))

def wrap_period(a,axis):
    size=a.shape[axis]
    for p in range(1,size+1):
        if np.array_equal(a, np.roll(a, -p, axis=axis)):
            return p
    return size

def shift_rates(g,axis):
    rates={}
    size=g.shape[axis]
    for step in range(1,size):
        if axis==0:
            a,b=g[:-step,:],g[step:,:]
        else:
            a,b=g[:,:-step],g[:,step:]
        rates[step]=float(np.count_nonzero(a"'!=b))/float(a.size)
    return rates

def low_cluster(rates):
    pairs=sorted((rate,step) for step,rate in rates.items())
    if len(pairs)==1:
        return [pairs[0][1]], pairs[0][0]
    upto=min(len(pairs)-1,7)
    split=1
    best=-1.0
    for i in range(upto):
        gap=pairs[i+1][0]-pairs[i][0]
        if gap>best+1e-12:
            best=gap
            split=i+1
    left=pairs[split-1][0]
    right=pairs[split][0] if split < len(pairs) else left
    thr=(left+right)/2 if split < len(pairs) else left+1e-9
    low=sorted(step for step,rate in rates.items() if rate<=thr+1e-12)
    return low,thr

def gcd_list(nums):
    g=0
    for n in nums:
        g=math.gcd(g,int(n))
    return g

def detect(g,axis):
