+
+        box = _bbox(mask)
+        if box is None:
+            continue
+        r0, c0, r1, c1 = box
+        if r0 == r1 or c0 == c1:
+            continue
+        if mode in {"cross_row", "cross_both"} and not (r0 < row_boundary <= r1):
+            continue
+        if mode in {"cross_col", "cross_both"} and not (c0 < col_boundary <= c1):
+            continue
