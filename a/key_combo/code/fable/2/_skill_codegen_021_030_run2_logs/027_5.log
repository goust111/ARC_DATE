+        cells = set(_manhattan_path(a, b))
+        target_area = random.randint(max(3, len(cells)), max_area)
+        while len(cells) < target_area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
