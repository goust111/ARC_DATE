def neighbors4(r,c):
    yield r-1,c; yield r+1,c; yield r,c-1; yield r,c+1

def connected(coords):
    s=set(coords)
    q=deque([next(iter(s))]); seen={q[0]}
    while q:
        r,c=q.popleft()
