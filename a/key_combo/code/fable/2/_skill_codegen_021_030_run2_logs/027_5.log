    r0,c0=coords.min(axis=0)
    r1,c1=coords.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def orbit_mask(g,pr,pc):
    h,w=g.shape
    out=np.zeros((h,w),dtype=bool)
    for rr in range(pr):
        for cc in range(pc):
            block=g[rr::pr, cc::pc]
            vals,counts=np.unique(block,return_counts=True)
            k=int(np.argmax(counts))
