+def _manhattan_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = map(int, a)
+    tr, tc = map(int, b)
+    path = [(r, c)]
+    if random.random() < 0.5:
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+    return path
+
