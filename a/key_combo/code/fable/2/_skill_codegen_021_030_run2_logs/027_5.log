+    return True
+
+
+def _generate_candidate() -> np.ndarray | None:
+    row_period = random.randint(*PERIOD_RANGE)
+    col_period = random.randint(*PERIOD_RANGE)
+    row_repeats = random.randint(*REPEAT_RANGE)
