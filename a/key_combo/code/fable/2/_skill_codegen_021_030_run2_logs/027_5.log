+def _exact_axis_period(tile: np.ndarray, axis: int) -> int:
+    size = tile.shape[axis]
+    for step in range(1, size + 1):
+        if np.array_equal(tile, np.roll(tile, -step, axis=axis)):
+            return int(step)
+    return int(size)
