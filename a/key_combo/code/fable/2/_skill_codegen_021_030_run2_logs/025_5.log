        while len(cells) < target_area and frontier:
            frontier_list = list(frontier)
            choice = frontier_list[int(rng.integers(len(frontier_list)))]
            frontier.remove(choice)
            cells.add(choice)
            for nbr in _neighbors8((height, width), *choice):
                if nbr not in cells:
