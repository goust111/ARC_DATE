        if not _mask_connected(mask):
            continue
        if min(mask.shape) < 3:
            continue
        if int(mask.sum()) < 9:
            continue
        if int(mask.sum()) == mask.size:
            continue
        return mask
    raise RuntimeError("failed to generate a connected hidden mask")


