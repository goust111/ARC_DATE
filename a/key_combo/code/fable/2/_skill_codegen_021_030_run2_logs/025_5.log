+        _SEEN_OUTPUT_SIGS.add(output_sig)
+
+        if np.array_equal(_simple_overlay(relative_maps, reverse=False), truth):
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid fragmented-consensus input")

