+    relative_maps: list[dict[tuple[int, int], int]] = []
+    for obj in components:
+        b = bbox(obj != BACKGROUND)
+        assert b is not None
+        sprite = crop_bbox(obj, b)
+        rel, _ = _relative_map(sprite)
+        relative_maps.append(rel)
+    return relative_maps
