+) -> list[tuple[int, int]] | None:
+    order = sorted(range(len(candidates_per_copy)), key=lambda i: len(candidates_per_copy[i]))
+    assigned: list[tuple[int, int] | None] = [None] * len(candidates_per_copy)
+    used: set[tuple[int, int]] = set()
