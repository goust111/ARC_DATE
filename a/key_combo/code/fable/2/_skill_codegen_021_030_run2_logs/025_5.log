+    out = np.full((max(rows) - min(rows) + 1, max(cols) - min(cols) + 1), BACKGROUND, dtype=int)
+    row_shift = -min(rows)
+    col_shift = -min(cols)
+    for rel in ordered:
+        for (rr, cc), color in rel.items():
+            out[rr + row_shift, cc + col_shift] = int(color)
