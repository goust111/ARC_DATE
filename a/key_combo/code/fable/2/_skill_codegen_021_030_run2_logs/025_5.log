+
+def _random_connected_mask(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(80):
+        height = int(rng.integers(4, 9))
+        width = int(rng.integers(4, 9))
+        target_area = int(rng.integers(max(9, (height * width) // 2), min(height * width, 19)))
