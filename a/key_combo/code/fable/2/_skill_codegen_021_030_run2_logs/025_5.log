+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors8(mask.shape, r, c):
+            if mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
