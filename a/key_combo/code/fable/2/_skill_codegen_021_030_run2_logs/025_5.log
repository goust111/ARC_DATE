+def _neighbors8(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    out: list[tuple[int, int]] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr = int(r + dr)
+            nc = int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w:
+                out.append((nr, nc))
