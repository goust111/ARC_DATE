+    return tuple(mask.shape), mask.astype(np.uint8).tobytes()
+
+
+def _interior_coords(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    return [
+        (r, c)
+        for r in range(1, h - 1)
+        for c in range(1, w - 1)
