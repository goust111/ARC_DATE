+def _carve_corner(mask: np.ndarray) -> None:
+    h, w = mask.shape
+    notch_h = random.randint(1, max(1, h - 3))
+    notch_w = random.randint(1, max(1, w - 3))
+    corner = random.choice(("tl", "tr", "bl", "br"))
