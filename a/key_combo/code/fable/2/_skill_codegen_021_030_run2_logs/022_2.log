            if vec == (0, 0):
                return False
            if _gen_norm_sq(vec) <= n1:
                return False
            if abs(vec[0]) < GEN_HEIGHT and abs(vec[1]) < GEN_WIDTH and _gen_support_area(vec) >= s1:
                return False
    return True


