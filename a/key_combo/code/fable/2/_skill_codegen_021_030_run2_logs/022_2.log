+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+
+    h, w = mask.shape
+    start = tuple(int(v) for v in coords[0])
+    stack = [start]
+    seen = {start}
