+            if np.array_equal(crop, prototype):
+                return False
+            missing = np.argwhere(prototype & ~crop)
+            if len(missing) in (1, 2) and all(0 < int(r) < h - 1 and 0 < int(c) < w - 1 for r, c in missing):
