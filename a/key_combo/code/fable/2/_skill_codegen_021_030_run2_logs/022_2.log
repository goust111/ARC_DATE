+        )[0])
+
+    colors = random.sample(list(Color.NOT_BLACK), n_groups)
+    specs: list[dict] = []
+    seen_signatures: set[tuple[tuple[int, int], bytes]] = set()
+
+    for idx, (size, color) in enumerate(zip(sizes, colors)):
+        for _ in range(GEN_GROUP_TRIES):
