+        if specs is None:
+            continue
+
+        rendered = _render_scene(specs)
+        if rendered is None:
+            continue
+
+        inp, expected = rendered
+        if _validate_scene(inp, expected):
+            return inp
+
+    raise RuntimeError("failed to generate valid input")

