+    for color, prototype, copy_mask in placements:
+        h, w = copy_mask.shape
+        bbox_patch = np.ones((h, w), dtype=int)
+        try:
+            r0, c0 = random_free_location(
+                occupied,
+                bbox_patch,
+                transparent=0,
+                padding=GEN_PADDING,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
