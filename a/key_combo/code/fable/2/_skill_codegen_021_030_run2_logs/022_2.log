    down_cap = height - 1 - GEN_VERTICAL_ENDPOINT_MARGIN - r_max
    min_ext = max(2 * GEN_VERTICAL_ENDPOINT_MARGIN, GEN_V_LEN_RANGE[0] - base_len)
    max_ext = min(GEN_V_LEN_RANGE[1] - base_len, up_cap + down_cap)
