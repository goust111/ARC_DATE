+        _dominant_direction(r - center_r, c - center_c)
+        for r, c in scene["controls"]
+    ]
+    assert all(direction is not None for direction in desired_dirs)
+    return _render_copies(
+        scene["grid"],
+        scene["sprite"],
+        scene["controls"],
+        desired_dirs,  # type: ignore[arg-type]
+        scene["tip_dir"],
+        scene["bg"],
+    )
