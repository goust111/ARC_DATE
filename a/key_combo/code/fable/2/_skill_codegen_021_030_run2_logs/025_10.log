+        top_len = random.randint(2, size - 2)
+        bottom_choices = [length for length in range(2, size - 1) if length != top_len]
+        bottom_len = random.choice(bottom_choices)
+        mask[0, 1 : 1 + top_len] = True
+        mask[-1, 1 : 1 + bottom_len] = True
