+        "bg": bg,
+        "sprite": sprite,
+        "template_bbox": (r0, c0, r1, c1),
+        "center": center,
+        "tip_dir": tip_dir,
+        "controls": controls,
+    }
+
+
+def _render_copies(
+    grid: np.ndarray,
+    sprite: np.ndarray,
+    controls: list[tuple[int, int]],
+    desired_dirs: list[str],
+    tip_dir: str,
