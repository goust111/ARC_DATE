+    from arc_utils import Color, crop_bbox, find_components, get_bg, paste
+except ModuleNotFoundError:
+    _ARC_UTILS = SourceFileLoader(
+        "_arc_utils_fable_2_025_10",
+        str(Path("/home/lixinyu/snap/new/solvers/arc_utils.py")),
+    ).load_module()
