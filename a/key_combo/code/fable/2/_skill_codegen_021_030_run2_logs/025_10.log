+    center_bar_mask[half, :] = mask[half, :]
+    sprite[center_bar_mask] = colors[2]
+
+    top_mask = np.zeros_like(mask)
+    top_mask[0, :] = mask[0, :]
+    sprite[top_mask] = colors[3]
+
+    bottom_mask = np.zeros_like(mask)
+    bottom_mask[-1, :] = mask[-1, :]
