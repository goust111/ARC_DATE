            for i, (v, cap) in enumerate(zip(ribbon_steps, ribbon_caps)):
                if v < cap:
                    choices.append(("yellow", i))
            if not choices:
                break
            kind, i = random.choice(choices)
            if kind == "red":
                red_lengths[i] += 1
            else:
                ribbon_steps[i] += 1
