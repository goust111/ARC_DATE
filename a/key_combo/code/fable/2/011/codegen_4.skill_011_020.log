    n = g.shape[0]
    for name, coords in categories.items():
        want = oriented_blocks[name]
        for r, c in coords:
            block = actual[r * n : (r + 1) * n, c * n : (c + 1) * n]
            if not np.array_equal(block, want):
                return False

    return True


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
