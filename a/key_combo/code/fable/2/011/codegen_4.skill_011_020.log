    c0 = random.randint(SQUARE_MARGIN, w - SQUARE_MARGIN - SQUARE_SIZE)
    r1 = r0 + SQUARE_SIZE - 1
    c1 = c0 + SQUARE_SIZE - 1
    rm = r0 + 1
    cm = c0 + 1
    return r0, c0, r1, c1, rm, cm


def _gen_path_specs(square):
    r0, c0, r1, c1, rm, cm = square
    red_specs = [
        ((r0 - 1, c0 - 1), (-1, -1)),
        ((r0 - 1, c1 + 1), (-1, 1)),
        ((r1 + 1, c0 - 1), (1, -1)),
        ((r1 + 1, c1 + 1), (1, 1)),
    ]
    yellow_specs = [
        ((r0 - 1, cm), (-1, 1), "h", "asc"),
        ((rm, c0 - 1), (-1, -1), "v", "desc"),
        ((r1 + 1, cm), (1, -1), "h", "desc"),
        ((rm, c1 + 1), (1, 1), "v", "asc"),
    ]
    return red_specs, yellow_specs


