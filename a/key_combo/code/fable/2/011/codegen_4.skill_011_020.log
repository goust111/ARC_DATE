        for i, v in enumerate(ribbon_steps):
            if v > 1:
                choices.append(("yellow", i))
        if not choices:
            break
        kind, i = random.choice(choices)
        if kind == "red":
            red_lengths[i] -= 1
        else:
            ribbon_steps[i] -= 1

    return None, None


def _gen_add_paint(painted, color, cells):
    for cell in cells:
        old = painted.get(cell)
        if old is not None and old != color:
            return False
    for cell in cells:
        painted[cell] = color
    return True


def _gen_red_side_neighbors(cells, shape):
    side = set()
    for r, c in cells:
        for cc in (c - 1, c + 1):
            if _in_bounds(shape, r, cc):
                side.add((r, cc))
    return side


def _gen_blocker_component_sizes(blockers):
    unseen = set(blockers)
    sizes = []
    while unseen:
        stack = [unseen.pop()]
        size = 0
        while stack:
            r, c = stack.pop()
            size += 1
            for nb in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if nb in unseen:
                    unseen.remove(nb)
                    stack.append(nb)
        sizes.append(size)
    return sizes


def _gen_discard_neighbors(allowed, cells, shape):
