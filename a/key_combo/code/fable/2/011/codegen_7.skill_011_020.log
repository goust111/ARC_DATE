+    chosen: list[tuple[int, int]] = []
+    for cell in candidates:
+        if any(_too_close(cell, other) for other in chosen):
+            continue
+        chosen.append(cell)
+        if len(chosen) == count:
+            return chosen
+    return None
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    sprite: np.ndarray,
+    box: tuple[int, int, int, int],
+    strip_box: tuple[int, int, int, int],
