+    parsed_coords, parsed_box, parsed_sprite, parsed_colors = _extract_template(grid, bg)
+    del parsed_coords
+    if parsed_box != tuple(map(int, box)):
+        return False
+    if not np.array_equal(parsed_sprite, sprite):
