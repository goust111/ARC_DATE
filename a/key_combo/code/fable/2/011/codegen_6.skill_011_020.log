+    if int(np.sum(expected != inp)) < GEN_MIN_PAINTED_CELLS:
+        return None
+    if not ({Color.RED, Color.TEAL} <= set(turn_colors)):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
