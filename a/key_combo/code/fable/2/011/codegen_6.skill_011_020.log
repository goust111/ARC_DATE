+def _dir_index(direction: Direction) -> int:
+    return DIRS.index(direction)
+
+
+def _turn_right(direction: Direction) -> Direction:
+    return DIRS[(_dir_index(direction) + 1) % 4]
+
+
+def _turn_left(direction: Direction) -> Direction:
+    return DIRS[(_dir_index(direction) - 1) % 4]
+
