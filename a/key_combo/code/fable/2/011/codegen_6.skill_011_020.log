+        if not _in_bounds(g.shape, nr, nc):
+            break
+
+        value = int(g[nr, nc])
+        if value == Color.RED:
+            direction = _turn_right(direction)
+            continue
+        if value == Color.TEAL:
+            direction = _turn_left(direction)
+            continue
+
+        assert value in {Color.BLACK, Color.GREEN}, "only routers may block the ray"
+        r, c = nr, nc
