def _gen_blocker_component_sizes(blockers):
    unseen = set(blockers)
    sizes = []
    while unseen:
        stack = [unseen.pop()]
        size = 0
        while stack:
            r, c = stack.pop()
            size += 1
            for nb in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if nb in unseen:
                    unseen.remove(nb)
                    stack.append(nb)
        sizes.append(size)
    return sizes


def _gen_discard_neighbors(allowed, cells, shape):
