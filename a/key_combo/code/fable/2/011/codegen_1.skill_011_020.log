+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_separator_row(grid: np.ndarray) -> int:
+    h, w = grid.shape
