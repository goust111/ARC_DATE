+        else:
+            if bool(terrain_mask[rr + 1, cc]):
+                kinds.add("terrain")
+            if bool(settled_mask[rr + 1, cc]):
+                kinds.add("sprite")
+        for nr, nc in ((rr - 1, cc), (rr, cc - 1), (rr, cc + 1)):
