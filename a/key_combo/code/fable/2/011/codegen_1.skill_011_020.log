+    overlap_r = min(shaft_inner_r - upper_shape.shape[1], lower_left + lower_shape.shape[1] - 1)
+    if overlap_l > overlap_r:
+        return None
+    upper_left = int(rng.integers(overlap_l, overlap_r + 1))
