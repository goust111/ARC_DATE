+    return False
+
+
+def _build_heights(
+    rng: np.random.Generator,
+    panel_h: int,
+    panel_w: int,
+    shaft_start: int,
+    shaft_w: int,
+    hill_start: int,
+    hill_w: int,
+) -> list[int]:
+    max_hill = panel_h - 4
+    plateau = int(rng.integers(2, max_hill + 1))
+    heights = [0] * panel_w
+
+    for c in range(hill_start, hill_start + hill_w):
+        heights[c] = plateau
+
+    for c in range(panel_w):
+        if shaft_start <= c < shaft_start + shaft_w:
+            heights[c] = 0
