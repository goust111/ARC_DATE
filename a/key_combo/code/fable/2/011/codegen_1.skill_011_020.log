+
+def _support_kinds(coords: np.ndarray, terrain_mask: np.ndarray, settled_mask: np.ndarray) -> set[str]:
+    h, w = terrain_mask.shape
+    kinds: set[str] = set()
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        if rr == h - 1:
