+    if extra_shape is not None:
+        order.append(("extra", extra_shape.shape[1] + 1 + int(rng.integers(0, 2))))
+    rng.shuffle(order)
+    for name, width in order:
+        gap = int(rng.integers(1, 3 if regions else 2))
+        cursor += gap
+        if cursor + width > panel_w:
