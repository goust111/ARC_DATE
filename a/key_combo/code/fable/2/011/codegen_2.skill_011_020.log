+    return r0, width - 1 - c1, r1, width - 1 - c0
+
+
+def _flip_bbox_v(bbox: tuple[int, int, int, int], height: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return height - 1 - r1, c0, height - 1 - r0, c1
