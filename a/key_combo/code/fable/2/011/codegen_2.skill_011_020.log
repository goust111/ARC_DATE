+from __future__ import annotations
+
+from collections import defaultdict
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = list(range(1, 10))
+
+OBJECT_COUNT_RANGE = (2, 4)
+SPRITE_H_RANGE = (3, 6)
+SPRITE_W_RANGE = (2, 5)
