+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            inp, expected = _generate_case()
+        except RuntimeError:
+            continue
+
+        out = main(inp)
+        if np.array_equal(out, expected):
