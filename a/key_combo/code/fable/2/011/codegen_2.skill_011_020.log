+            col_span = tuple(sorted((c1, c2)))
+            candidates = [i for i, box in enumerate(sprite_boxes) if (box[1], box[3]) == col_span]
+
+        assert len(candidates) == 1, "marker pair must match exactly one sprite bbox span"
+        sprite_id = candidates[0]
