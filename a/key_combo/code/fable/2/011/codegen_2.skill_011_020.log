+def _solve_assignments(grid: np.ndarray) -> list[tuple[np.ndarray, str, int, int]]:
+    bg = _most_common_color(grid)
+    comps = _components_from_mask(grid != bg, connectivity=8)
+    assert comps, "expected foreground components"
