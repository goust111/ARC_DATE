+    inp, out, src_bbox = _build_vertical_patch(sprite_color, marker_color)
+    inp = inp.T.copy()
+    out = out.T.copy()
+    src_bbox = _transpose_bbox(src_bbox)
+
+    if random.random() < 0.5:
