            b_ind = bbox(indicator_obj != bg)
            assert b_ind is not None
            ind_r, ind_c = bbox_anchor(b_ind, anchor="center")
            tpl_r, tpl_c = bbox_anchor(b_template, anchor="center")

            dr = int(np.sign(ind_r - tpl_r))
            dc = int(np.sign(ind_c - tpl_c))
