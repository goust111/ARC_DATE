+
+
+Coord = tuple[int, int]
+
+
+MARKER_COLORS = (2, 3, 4, 6, 7, 8, 9)
+OBJECT_SHAPES = (
+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1], [0, 1]], dtype=bool),
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1], [1], [1]], dtype=bool),
+    np.array([[1, 1], [1, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1], [0, 1]], dtype=bool),
+    np.array([[0, 1, 0], [1, 1, 1]], dtype=bool),
+)
+
