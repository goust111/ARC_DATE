+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _distance_map(grid: np.ndarray, starts: list[Coord]) -> np.ndarray:
+    dist = np.full(grid.shape, -1, dtype=int)
+    q = deque()
+    for r, c in starts:
+        dist[r, c] = 0
+        q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(grid.shape, nr, nc):
+                continue
+            if dist[nr, nc] != -1 or int(grid[nr, nc]) == Color.BLUE:
+                continue
+            dist[nr, nc] = dist[r, c] + 1
+            q.append((nr, nc))
+    return dist
