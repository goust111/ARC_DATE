from collections import deque
import random, numpy as np

BLACK=0; RED=2; YELLOW=4
COLORS=[1,3,5,6,7,8,9]


def neighbors4(r,c):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        yield r+dr,c+dc


def carve_maze(rows, cols):
    grid=np.ones((2*rows+1,2*cols+1),dtype=int)  # 1 as wall placeholder
    seen=[[False]*cols for _ in range(rows)]
    stack=[(random.randrange(rows), random.randrange(cols))]
    seen[stack[0][0]][stack[0][1]]=True
    grid[2*stack[0][0]+1, 2*stack[0][1]+1]=0
    while stack:
        r,c=stack[-1]
        opts=[]
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<rows and 0<=nc<cols and not seen[nr][nc]:
                opts.append((nr,nc,dr,dc))
        if not opts:
            stack.pop(); continue
