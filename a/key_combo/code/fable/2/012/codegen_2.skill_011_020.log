from collections import deque
import random, numpy as np

def neighbors4(r,c):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        yield r+dr,c+dc

def shortest(passable,start,goal):
    H,W=passable.shape
    dist=np.full((H,W),-1,int)
    q=deque([start])
    dist[start]=0
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and passable[nr,nc] and dist[nr,nc]<0:
                dist[nr,nc]=dist[r,c]+1
                q.append((nr,nc))
    if dist[goal] <0: return None,0
    cells=[(int(r),int(c)) for r,c in np.argwhere(dist>=0)]
    cells.sort(key=lambda rc: dist[rc])
    ways=np.zeros((H,W),int); ways[start]=1
    for r,c in cells:
        d=dist[r,c]
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and dist[nr,nc]==d+1:
                ways[nr,nc]=min(2,ways[nr,nc]+ways[r,c])
    return dist,int(ways[goal])

def rect_ring(mask,b):
    r0,c0,r1,c1=b
    mask[r0:r1+1,c0]=1; mask[r0:r1+1,c1]=1; mask[r0,c0:c1+1]=1; mask[r1,c0:c1+1]=1

def trial():
    H=random.randint(12,18); W=random.randint(16,24)
    k=random.randint(2,4)
    gap=random.randint(2,4)
    width=random.randint(3,5)
    xs=[]
    x=2
    for i in range(k):
        xs.append(x)
        x += width + gap
    if x+2>=W: return False,None
    mask=np.zeros((H,W),bool)
    bboxes=[]
    top=True
    for x in xs:
        if top:
            r1=random.randint(H//3, H-4)
            b=(0,x,r1,x+width-1)
        else:
            r0=random.randint(3, 2*H//3)
            b=(r0,x,H-1,x+width-1)
        bboxes.append(b)
        rect_ring(mask,b)
        top=not top
    passable=~mask
    # sample endpoints on left/right edges
    ls=[(r,0) for r in range(H) if passable[r,0]]
    rs=[(r,W-1) for r in range(H) if passable[r,W-1]]
    random.shuffle(ls); random.shuffle(rs)
    for s in ls[:20]:
      for g in rs[:20]:
        dist,ways=shortest(passable,s,g)
        if ways==1 and dist[g]>=12:
            return True,(H,W,bboxes,s,g,dist[g])
    return False,(H,W,bboxes)

ok=0
for i in range(500):
    good,info=trial()
    ok+=good
print('ok',ok)
