+        if degree == 1:
+            leaves.append((rr, cc))
+    return leaves
+
+
+def _long_leaf_path(maze_open: np.ndarray) -> list[Coord] | None:
+    leaves = _corridor_leaves(maze_open)
+    best_path: list[Coord] | None = None
+    for i, start in enumerate(leaves):
