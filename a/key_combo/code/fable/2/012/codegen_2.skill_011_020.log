+    dg = np.full((h, w), -1, dtype=int)
+    q = deque([goal])
+    dg[goal] = 0
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dg[nr, nc] < 0:
+                dg[nr, nc] = dg[r, c] + 1
+                q.append((nr, nc))
