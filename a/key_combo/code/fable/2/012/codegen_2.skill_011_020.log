+    start = (random.randrange(cell_rows), random.randrange(cell_cols))
+    stack = [start]
+    seen[start] = True
+    maze[2 * start[0] + 1, 2 * start[1] + 1] = 0
+
+    while stack:
+        r, c = stack[-1]
+        options: list[tuple[int, int, int, int]] = []
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
