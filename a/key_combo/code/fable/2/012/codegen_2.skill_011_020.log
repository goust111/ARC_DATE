+
+
+def _place_outside_ring(grid: np.ndarray, reserved: np.ndarray, allowed: np.ndarray, color: int) -> list[Coord] | None:
+    h, w = map(int, grid.shape)
+    candidates: list[tuple[int, int, int, int]] = []
+    for height in (3, 4, 5):
+        for width in (3, 4, 5):
+            for r0 in range(h - height + 1):
