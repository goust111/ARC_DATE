+    ways[start] = 1
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and ds[nr, nc] == ds[r, c] + 1:
+                ways[nr, nc] = min(2, ways[nr, nc] + ways[r, c])
