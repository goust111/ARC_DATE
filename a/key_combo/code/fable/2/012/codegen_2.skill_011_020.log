+    return best_path
+
+
+def _outside_region(shape: tuple[int, int], maze_bbox: tuple[int, int, int, int], gap: int = 1) -> np.ndarray:
+    h, w = map(int, shape)
+    r0, c0, r1, c1 = maze_bbox
+    allowed = np.ones((h, w), dtype=bool)
