+        nr, nc, dr, dc = random.choice(options)
+        seen[nr, nc] = True
+        maze[2 * nr + 1, 2 * nc + 1] = 0
+        maze[2 * r + 1 + dr, 2 * c + 1 + dc] = 0
+        stack.append((nr, nc))
+    return maze
+
+
