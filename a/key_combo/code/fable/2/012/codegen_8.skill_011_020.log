+BG = 0
+MARKER_COLOR = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
+FRAME_COUNT_RANGE = (3, 5)
+FRAME_H_RANGE = (5, 8)
+FRAME_W_RANGE = (5, 8)
+SPRITE_SIDE_RANGE = (2, 4)
+SCALE_RANGE = (2, 5)
+EDGE_MARGIN = 1
+FRAME_GAP = 1
+FRAME_PLACEMENT_ATTEMPTS = 120
+SPRITE_ATTEMPTS = 80
