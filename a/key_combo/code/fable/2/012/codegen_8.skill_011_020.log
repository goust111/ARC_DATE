+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
+FRAME_COUNT_RANGE = (3, 5)
+FRAME_H_RANGE = (5, 8)
+FRAME_W_RANGE = (5, 8)
+SPRITE_SIDE_RANGE = (2, 4)
+SCALE_RANGE = (2, 5)
