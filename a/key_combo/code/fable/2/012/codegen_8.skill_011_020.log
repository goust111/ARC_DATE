+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
+    k = int(factor)
+    if k <= 0:
+        raise ValueError("scale factor must be positive")
+    return np.repeat(np.repeat(sprite, k, axis=0), k, axis=1)
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _is_rectangular_frame(coords: np.ndarray) -> bool:
+    if coords.shape[0] < 8:
+        return False
+    r0, c0, r1, c1 = bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if coords.shape[0] != 2 * (h + w) - 4:
+        return False
+    present = {tuple(map(int, rc)) for rc in coords}
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if ((r, c) in present) != on_border:
+                return False
+    return True
+
+
+def _coords_to_mask(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    box = bbox_coords(coords)
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
