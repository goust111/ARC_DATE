+def _matching_ops(a: np.ndarray, b: np.ndarray, out: np.ndarray) -> list[str]:
+    return [name for name, func in OPS.items() if np.array_equal(func(a, b), out)]
+
+
+def _combo_counts(a: np.ndarray, b: np.ndarray) -> dict[str, int]:
+    return {
+        "00": int((~a & ~b).sum()),
+        "10": int((a & ~b).sum()),
+        "01": int((~a & b).sum()),
+        "11": int((a & b).sum()),
+    }
+
