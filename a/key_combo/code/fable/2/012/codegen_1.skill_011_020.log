+                    ok = True
+                    for i in range(seed_len):
+                        rr = r + i * dr
+                        cc = c + i * dc
+                        if not in_bounds(shape, rr, cc) or (rr, cc) in blocked:
+                            ok = False
+                            break
+                        cells.append((rr, cc))
+                    if not ok:
+                        continue
+                    nr = cells[-1][0] + dr
+                    nc = cells[-1][1] + dc
+                    if not in_bounds(shape, nr, nc) or (nr, nc) in blocked:
+                        continue
+                    out.append((r, c, dr, dc, cells))
+    random.shuffle(out)
+    return out
