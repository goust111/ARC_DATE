+        def find_components(
+            grid: np.ndarray,
+            *,
+            bg: int | None = None,
+            connectivity: int = 4,
+            monochromatic: bool = True,
+            colors: list[int] | tuple[int, ...] | None = None,
+            min_area: int = 1,
+            return_format: str = "dict",
+        ) -> list[dict]:
+            g = np.asarray(grid, dtype=int)
+            if bg is None:
+                bg = get_bg(g)
