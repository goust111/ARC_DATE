+def _expected_output(grid: np.ndarray, path_info: list[tuple[int, int, int, int]]) -> np.ndarray:
+    out = grid.copy()
+    for r, c, color, _idx in path_info:
+        if int(out[r, c]) == int(Color.BLACK):
