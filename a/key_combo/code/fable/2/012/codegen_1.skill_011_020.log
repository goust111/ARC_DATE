+    seed_len = random.choice(GEN_SEED_LENGTHS)
+    starts = _candidate_start_states(shape, seed_len, blocked)
+    if not starts:
+        return None
+
+    for _r0, _c0, dr, dc, seed_cells in starts[:20]:
