+def _bbox_size(box: BBox) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
+def _legend_bbox(shape: tuple[int, int], rows: int, corner: str) -> BBox:
+    h, w = map(int, shape)
+    rows = int(rows)
+    if corner == "tl":
+        return 0, 0, rows - 1, 1
+    if corner == "tr":
+        return 0, w - 2, rows - 1, w - 1
+    if corner == "bl":
+        return h - rows, 0, h - 1, 1
+    if corner == "br":
+        return h - rows, w - 2, h - 1, w - 1
