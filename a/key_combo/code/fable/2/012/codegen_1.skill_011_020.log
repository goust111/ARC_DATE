+def _initial_state(shape: tuple[int, int], seed: set[Coord]) -> tuple[int, int, int, int]:
+    if len({r - c for r, c in seed}) == 1:
+        first = min(seed)
+        last = max(seed)
+        endpoints = ((first, (-1, -1)), (last, (1, 1)))
+    else:
+        top = min(seed)
+        bottom = max(seed)
+        endpoints = ((top, (-1, 1)), (bottom, (1, -1)))
