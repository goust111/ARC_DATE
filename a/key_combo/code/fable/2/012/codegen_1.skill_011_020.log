+def _free_run(shape: tuple[int, int], start: Coord, dr: int, dc: int, blocked: set[Coord]) -> tuple[list[Coord], bool]:
+    cells: list[Coord] = []
+    r, c = start
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not in_bounds(shape, nr, nc):
+            return cells, True
+        if (nr, nc) in blocked:
+            return cells, False
+        cells.append((nr, nc))
+        r, c = nr, nc
