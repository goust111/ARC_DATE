+def _gen_attempt() -> np.ndarray | None:
+    shape = (
+        random.randint(*GEN_HEIGHT_RANGE),
+        random.randint(*GEN_WIDTH_RANGE),
+    )
+    reflections = random.choices(GEN_REFLECTIONS, weights=GEN_REFLECTION_WEIGHTS, k=1)[0]
