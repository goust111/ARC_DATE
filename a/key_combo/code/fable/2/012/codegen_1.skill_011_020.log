+GEN_REFLECTIONS = (1, 2, 3)
+GEN_REFLECTION_WEIGHTS = (2, 4, 3)
+GEN_SEED_LENGTHS = (2, 3)
+GEN_MIN_SEG = 3
+GEN_MIN_FINAL_SEG = 3
+GEN_MIN_BAR = 2
+GEN_MAX_BAR = 8
