+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        bh, bw = _bbox_size((r0, c0, r1, c1))
+        if bh == 1:
+            assert area == bw, "horizontal segment must be contiguous"
+            orientation = "horizontal"
+        elif bw == 1:
