+    existing_objects: set[Coord],
+    bar_forbidden: set[Coord],
+    path_set: set[Coord],
+) -> DecoyPlan | None:
+    h, w = map(int, shape)
+    for _ in range(40):
+        orientation = random.choice(["horizontal", "vertical"])
+        if orientation == "horizontal":
+            anchor = (random.randrange(h), random.randrange(w))
+        else:
+            anchor = (random.randrange(h), random.randrange(w))
+        decoy = _place_decoy_through_path(
+            shape,
+            anchor,
+            color,
+            existing_objects,
+            bar_forbidden,
+            path_set=set(),
