+                    if allow is not None and color not in allow:
+                        continue
+                    seen[r, c] = True
+                    stack = [(r, c)]
+                    coords: list[tuple[int, int]] = []
+                    while stack:
+                        rr, cc = stack.pop()
+                        coords.append((rr, cc))
+                        for dr, dc in deltas:
+                            nr = rr + dr
+                            nc = cc + dc
+                            if not (0 <= nr < h and 0 <= nc < w):
