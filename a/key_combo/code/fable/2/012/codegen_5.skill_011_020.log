+        swapped[0], swapped[1] = swapped[1], swapped[0]
+        candidates.append(swapped)
+    if len(correct) >= 3:
+        swapped_tail = correct[:]
+        swapped_tail[-2], swapped_tail[-1] = swapped_tail[-1], swapped_tail[-2]
+        candidates.append(swapped_tail)
