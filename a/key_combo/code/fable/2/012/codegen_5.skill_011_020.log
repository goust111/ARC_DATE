+        key = lambda item: (-item[1].bbox[2], item[1].bbox[0], item[1].bbox[1], item[0])
+    elif side == "up":
+        key = lambda item: (item[1].bbox[0], item[1].bbox[1], item[1].bbox[2], item[0])
+    elif side == "left":
+        key = lambda item: (item[1].bbox[1], item[1].bbox[0], item[1].bbox[3], item[0])
+    else:
