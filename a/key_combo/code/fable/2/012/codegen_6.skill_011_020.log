+
+def _semantic_check(inp: np.ndarray, out: np.ndarray, meta: dict) -> bool:
+    in_quads, mid = _split_quadrants(inp)
+    out_quads, _ = _split_quadrants(out)
+
+    if not np.array_equal(inp[mid, :], out[mid, :]):
+        return False
+    if not np.array_equal(inp[:, mid], out[:, mid]):
+        return False
