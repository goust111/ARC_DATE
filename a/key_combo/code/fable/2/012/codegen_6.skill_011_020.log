+def _split_quadrants(grid: np.ndarray) -> tuple[list[np.ndarray], int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] == g.shape[1], "expected a square 2D grid"
+    side = int(g.shape[0])
+    assert side % 2 == 1, "expected an odd side length"
