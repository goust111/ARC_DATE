+BLACK = 0
+ALL_COLORS = tuple(range(10))
+QUAD_ORDER = ("tl", "tr", "br", "bl")  # clockwise around the separator cross
+REFLECTION_KINDS = ("vertical", "horizontal", "diag", "anti")
