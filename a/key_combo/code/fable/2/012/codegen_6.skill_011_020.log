+    mid = side // 2
+    quads = [
+        g[:mid, :mid].copy(),
+        g[:mid, mid + 1 :].copy(),
+        g[mid + 1 :, mid + 1 :].copy(),
+        g[mid + 1 :, :mid].copy(),
+    ]
+    for quad in quads[1:]:
+        assert quad.shape == quads[0].shape, "all quadrants must have the same shape"
+    return quads, mid
