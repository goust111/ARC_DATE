+    col_guides = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c])]
+
+    assert len(row_guides) == 1, "expected exactly one uniform guide row"
+    assert len(col_guides) == 1, "expected exactly one uniform guide column"
+
