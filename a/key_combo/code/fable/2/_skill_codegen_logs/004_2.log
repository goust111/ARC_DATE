def _gen_solver_accepts(inp, out):
    """Return whether the solver maps this generated input to the planned output."""
    if get_bg(inp) != 0:
        return False
    try:
        solved = main(inp)
    except Exception:
        return False
    return np.array_equal(solved, out)


