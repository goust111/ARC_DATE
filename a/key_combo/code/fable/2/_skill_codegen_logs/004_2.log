        r, c = random.choice(tuple(candidates))
        inp[r, c] = random.choice(marker_palette)
        reserved.add((r, c))
        for dr, dc in FOUR_NEIGHBOR_OFFSETS:
            nr, nc = r + dr, c + dc
            candidates.discard((nr, nc))
            reserved.add((nr, nc))
        candidates.discard((r, c))
