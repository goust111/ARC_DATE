+    raise RuntimeError("failed to build matched vertical feature")
+
+
+def _build_mismatch_horizontal() -> list[dict]:
+    for _ in range(100):
+        h1, w1 = _sample_room_size()
+        h2, w2 = _sample_room_size()
+        gap = random.randint(*PAIR_GAP_RANGE)
