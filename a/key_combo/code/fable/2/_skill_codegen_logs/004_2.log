            overlap = _gen_overlap_len(pc0 + 1, pc1 - 1, c0 + 1, c1 - 1)
            if GEN_OVERLAP_MIN <= overlap <= GEN_OVERLAP_MAX:
                upper = (pr0 - gap - h, c0, pr0 - gap - 1, c1)
                lower = (pr1 + gap + 1, c0, pr1 + gap + h, c1)
                by_overlap.setdefault(overlap, []).extend([upper, lower])

