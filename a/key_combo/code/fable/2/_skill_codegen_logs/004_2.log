   246	    assert g.ndim == 2, "expected a 2D grid"
   247	    bg, color, _rooms, openings = _extract_rooms_and_openings(g)
   248	    pairs = _find_pairs(g, bg, openings)
   249	
   250	    out = g.copy()
   251	    paired_ids = {i for pair in pairs for i in pair}
   252	    for op in openings:
   253	        if op["id"] not in paired_ids:
   254	            _seal_opening(out, op, color)
   255	    for i, j in pairs:
   256	        _draw_corridor(out, color, openings[i], openings[j])
   257	    return out
