+
+def _find_components(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": _bbox_coords(coords),
+                    "area": int(len(cells)),
+                }
+            )
+    return comps
+
+
+def _bg_runs(values: np.ndarray, offset: int, bg: int) -> list[tuple[int, int]]:
+    runs = []
+    start = None
+    for idx, value in enumerate(values):
+        if int(value) == int(bg):
+            if start is None:
+                start = idx
+        elif start is not None:
+            runs.append((offset + start, offset + idx - 1))
+            start = None
+    if start is not None:
+        runs.append((offset + start, offset + len(values) - 1))
+    return runs
