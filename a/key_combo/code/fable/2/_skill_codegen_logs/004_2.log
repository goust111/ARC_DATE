+        left = _room_box(0, 0, h1, w1)
+        right = _room_box(top2, w1 + gap, h2, w2)
+        blocker_w = 3
+        blocker_h = 3
+        blocker_c0 = w1 + 1
+        if blocker_c0 + blocker_w >= w1 + gap:
+            continue
+        blocker_r0 = max(0, min(span[0] - 1, max(h1 - blocker_h, top2 + h2 - blocker_h)))
