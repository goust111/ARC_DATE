+        left = _room_box(0, 0, h1, w1)
+        right = _room_box(top2, w1 + gap, h2, w2)
+        left["openings"].append({"side": "right", "span": span, "key": key})
+        right["openings"].append({"side": "left", "span": span, "key": key})
+        return [left, right]
