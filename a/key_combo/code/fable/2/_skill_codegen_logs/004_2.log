+    border_mask = np.zeros_like(patch, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    assert np.all((patch == color) <= border_mask), "foreground must stay on room border"
