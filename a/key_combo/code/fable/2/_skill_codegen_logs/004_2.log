+    for side, values, offset, wall in (
+        ("top", patch[0, 1:-1], c0 + 1, r0),
+        ("bottom", patch[-1, 1:-1], c0 + 1, r1),
+        ("left", patch[1:-1, 0], r0 + 1, c0),
