+    g = np.asarray(grid, dtype=int)
+    matches = _all_matches(g)
+    assert len(matches) == 1, "expected exactly one matching block/rotation"
+    patch, rot, scale = matches[0]
+    return scale_sprite(np.rot90(patch, rot), scale)
+
