+    if big_h != big_w or small_side <= 0 or big_h % small_side != 0:
+        return None
+    scale = big_h // small_side
+    if scale < 1:
+        return None
+
+    small_mask = np.zeros((small_side, small_side), dtype=bool)
+    for r in range(small_side):
+        for c in range(small_side):
