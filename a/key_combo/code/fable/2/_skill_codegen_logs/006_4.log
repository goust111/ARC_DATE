+def _independent_expected(grid: np.ndarray) -> np.ndarray:
+    parsed = _parse_scene(grid)
+    return _crop_bbox(grid, parsed["target"]["bbox"])
+
+
+def _validate_sample(grid: np.ndarray, relation: str) -> bool:
+    try:
+        parsed = _parse_scene(grid)
