+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+
+    primary_relation = _GEN_BRANCHES[_GEN_CALL_COUNT % len(_GEN_BRANCHES)]
+    _GEN_CALL_COUNT += 1
+    relation_order = [primary_relation] + [rel for rel in _GEN_BRANCHES if rel != primary_relation]
