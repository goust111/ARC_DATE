                    continue
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
                    candidates.add((nr, nc))
    return candidates


def _plus_blob() -> np.ndarray:
    mask = np.zeros((PLUS_SHAPE_SIZE, PLUS_SHAPE_SIZE), dtype=bool)
    center = PLUS_SHAPE_SIZE // 2
    mask[center, :] = True
    mask[:, center] = True
    return mask


