+        rot_canon, rot_sig = _canonical_rotation(mask)
+        mirror_canon, mirror_sig = _canonical_rotation(np.fliplr(mask))
+        rec["rot_canon"] = rot_canon
+        rec["rot_sig"] = rot_sig
+        rec["mirror_sig"] = mirror_sig
