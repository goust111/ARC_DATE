+    for _ in range(SHAPE_RETRY_LIMIT):
+        h = random.randint(BASE_BOX_MIN, BASE_BOX_MAX)
+        w = random.randint(BASE_BOX_MIN, BASE_BOX_MAX)
+        area = random.randint(BASE_AREA_MIN, min(BASE_AREA_MAX, h * w - 1))
