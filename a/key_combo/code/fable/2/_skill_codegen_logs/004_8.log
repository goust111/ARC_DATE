+        "obj": obj,
+        "base": base,
+        "ref_orientation": int(ref_orientation),
+        "real_counts": tuple(map(int, real_counts)),
+        "objects": specs,
+    }
+    expected = _build_expected(inp.shape, bg, specs)
+    return inp, expected, meta
