+    for spec in specs:
+        if spec["kind"] == "mirror":
+            continue
+        paste(out, spec["output_patch"], spec["r0"], spec["c0"], transparent=bg)
+    return out
+
+
+def _check_case_semantics(inp: np.ndarray, expected: np.ndarray, meta: dict) -> bool:
