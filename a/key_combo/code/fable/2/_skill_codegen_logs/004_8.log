+                    "orientation": int(orientation),
+                    "input_patch": input_patch,
+                    "output_patch": output_patch,
+                }
+            )
+
+    for _ in range(mirror_count):
+        orientation = random.randrange(4)
+        patch_mask = np.rot90(mirror, orientation)
