+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], tuple[int, ...]]:
+    arr = np.asarray(mask, dtype=np.uint8)
+    return tuple(map(int, arr.shape)), tuple(map(int, arr.ravel()))
