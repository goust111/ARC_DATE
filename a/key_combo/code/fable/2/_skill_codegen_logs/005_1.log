+def _trace_ray(
+    shape: tuple[int, int],
+    obstacle_bbox: tuple[int, int, int, int],
+    head: tuple[int, int],
+    direction: tuple[int, int],
+    segment_count: int,
+) -> tuple[list[list[tuple[int, int]]], list[dict[str, object]]]:
+    h, w = shape
+    r, c = map(int, head)
+    dr, dc = map(int, direction)
+    assert 0 <= r < h and 0 <= c < w
