+        color = int(shell_vals[0])
+        assert np.all(shell_vals == color), "each ring must be monochromatic"
+        assert color not in (BG, TAIL_COLOR, HEAD_COLOR), "ring colors must not reuse launcher colors"
+        outer_to_inner.append(color)
