+def _parse_scene(grid: np.ndarray) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int], tuple[int, int, int, int], list[int]]:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise AssertionError("expected a 2D grid")
