+                if _cell_kind(shape, obstacle_bbox, *tail) is not None:
+                    continue
+                if _cell_kind(shape, obstacle_bbox, *head) is not None:
+                    continue
+                if not _launcher_ok(obstacle_bbox, tail, head):
+                    continue
