+    side = side_h
+    layer_count = (side + 1) // 2
+    rr, cc = np.indices(sub.shape)
+    shell_index = np.minimum.reduce([rr, cc, side - 1 - rr, side - 1 - cc])
+    outer_to_inner: list[int] = []
+    for d in range(layer_count):
