+    side_h = r1 - r0 + 1
+    side_w = c1 - c0 + 1
+    assert side_h == side_w >= 3, "block must be a square"
+    sub = g[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all(sub != BG), "block must fill its bbox"
