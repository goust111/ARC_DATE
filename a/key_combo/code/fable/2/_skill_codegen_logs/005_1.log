+import numpy as np
+
+
+BG = 0
+TAIL_COLOR = 1
+HEAD_COLOR = 2
+RING_PALETTE = (3, 4, 5, 6, 7, 8, 9)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+GEN_ATTEMPTS = 1200
+SCENARIOS = ("mixed", "obstacle_corner", "boundary_corner")
