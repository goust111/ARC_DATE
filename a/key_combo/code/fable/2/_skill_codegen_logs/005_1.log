+) -> list[tuple[tuple[int, int], tuple[int, int], list[list[tuple[int, int]]], list[dict[str, object]]]]:
+    h, w = shape
+    candidates: list[tuple[tuple[int, int], tuple[int, int], list[list[tuple[int, int]]], list[dict[str, object]]]] = []
