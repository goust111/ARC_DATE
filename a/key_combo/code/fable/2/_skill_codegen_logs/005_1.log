+def _paint_segments(
+    grid: np.ndarray,
+    segments: list[list[tuple[int, int]]],
+    layer_colors_inner_to_outer: list[int],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for color, segment in zip(layer_colors_inner_to_outer, segments):
+        for r, c in segment:
+            out[r, c] = int(color)
