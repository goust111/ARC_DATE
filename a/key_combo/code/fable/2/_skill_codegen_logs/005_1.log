+    tail_coords = np.argwhere(g == TAIL_COLOR)
+    head_coords = np.argwhere(g == HEAD_COLOR)
+    assert tail_coords.shape == (1, 2), "expected one launcher tail pixel"
+    assert head_coords.shape == (1, 2), "expected one launcher head pixel"
