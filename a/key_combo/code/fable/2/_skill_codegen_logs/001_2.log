        objects.append((stretched, solid))

    placed = _place_objects(objects, height, GRID_WIDTH)
    if placed is None:
        return None

    inp, out = placed
    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


