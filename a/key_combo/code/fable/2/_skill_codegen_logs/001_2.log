+PANEL_HEIGHT_RANGE = (7, 10)
+PANEL_WIDTH_RANGE = (5, 8)
+AREA_VALUE_RANGE = (6, 15)
+MAX_GENERATION_ATTEMPTS = 800
+MAX_PANEL_ATTEMPTS = 120
+MAX_COMPONENT_ATTEMPTS = 80
