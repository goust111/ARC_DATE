+    width: int,
+    color: int,
+    component_count: int,
+    total_area: int,
+    anchor: tuple[int, int],
+) -> np.ndarray | None:
+    for _ in range(MAX_PANEL_ATTEMPTS):
+        sizes = _sample_sizes(component_count, total_area)
+        blocked = np.zeros((height, width), dtype=bool)
+        fg_cells: set[tuple[int, int]] = set()
+
