+    center_sum: tuple[int, int],
+    grid_shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    want_in_bounds: bool,
+) -> list[tuple[set[tuple[int, int]], set[tuple[int, int]]]]:
+    h, w = grid_shape
+    max_r = max(r for r, _ in shape)
+    max_c = max(c for _, c in shape)
