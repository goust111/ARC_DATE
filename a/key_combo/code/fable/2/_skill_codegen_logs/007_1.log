+DIRS8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1))
+COLORS = tuple(range(10))
+PAIR_AREA_RANGE = (3, 6)
+LONE_AREA_RANGE = (3, 6)
+GRID_H_RANGE = (11, 19)
+GRID_W_RANGE = (11, 19)
