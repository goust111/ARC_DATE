+def _regions_between(lines: list[int], limit: int) -> list[tuple[int, int]]:
+    bounds = [-1, *sorted(int(x) for x in lines), int(limit)]
+    return [(a + 1, b - 1) for a, b in zip(bounds, bounds[1:]) if a + 1 <= b - 1]
