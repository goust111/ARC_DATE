    tile = np.full((3, 3), bg, dtype=int)
    rr = sprite_coords[:, 0] - top
    cc = sprite_coords[:, 1] - left
    assert bool(np.all((0 <= rr) & (rr < 3) & (0 <= cc) & (cc < 3)))
    tile[rr, cc] = sprite_color

    return np.tile(tile, (1, marker_count))

