+def _choose_assignments(num_cells: int, count_max: int, col_count: int, n_sources: int, mode: str) -> list[tuple[int, int]]:
+    all_sources = list(range(1, num_cells + 1))
+    targetable_sources = list(range(1, count_max + 1))
