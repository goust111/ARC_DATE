+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        h, w = _bbox_hw(comp["bbox"])
+        if horizontal_path:
+            if w != 1 or h < 2:
+                continue
+            groups.setdefault(int(c0), []).append(comp)
+        else:
+            if h != 1 or w < 2:
+                continue
+            groups.setdefault(int(r0), []).append(comp)
+    return groups
