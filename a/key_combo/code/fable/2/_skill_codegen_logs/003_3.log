+    final = marker
+    for pos in positions:
+        state = _gate_state(groups.get(int(pos), []), path_coord, horizontal_path)
+        if state == "closed":
+            break
+        final = (path_coord, int(pos)) if horizontal_path else (int(pos), path_coord)
+        if state == "open":
+            color = int(legend_map[color])
+
+    out = g.copy()
+    out[marker] = bg
+    out[final] = color
+    return out
