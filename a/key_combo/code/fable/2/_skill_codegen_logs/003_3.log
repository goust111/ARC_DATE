    r0, c0, r1, c1 = map(int, b)
    h = bbox_h(b)
    w = bbox_w(b)

    if anchor == "upperleft":
        rr, cc = r0, c0
    elif anchor == "upperright":
        rr, cc = r0, c1
    elif anchor == "lowerleft":
        rr, cc = r1, c0
    elif anchor == "lowerright":
        rr, cc = r1, c1
    elif anchor == "center":
