+def _gate_state(segments: list[dict], path_coord: int, horizontal_path: bool) -> str | None:
+    if not segments:
+        return None
+
+    if horizontal_path:
+        start_idx, end_idx = 0, 2
+    else:
+        start_idx, end_idx = 1, 3
