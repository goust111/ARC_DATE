+        anchor_end = anchor_start + block_size - 1
+        marker = anchor_start - dist
+
+        def to_abs(step: int) -> int:
+            return int(marker + step)
+
+    else:
+        anchor_end = random.randint(block_size, axis_len - dist - 2)
+        anchor_start = anchor_end - block_size + 1
