+        r0, c0, r1, c1 = comp["bbox"]
+        h, w = _bbox_hw(comp["bbox"])
+        coords = [(int(r), int(c)) for r, c in comp["coords"]]
+        if h == 1 and w == 2:
+            coords.sort(key=lambda rc: rc[1])
+        elif h == 2 and w == 1:
