    paste(out, sprite, paste_r, paste_c, transparent=_GEN_BG)
    return out


def _gen_input_grid(marker_col: int, sprite: np.ndarray) -> np.ndarray | None:
    inp = _gen_blank_grid()
    _gen_place_marker(inp, _GEN_LOWER_ROW0, marker_col)
    lower = inp[_GEN_LOWER_ROW0:, :]
