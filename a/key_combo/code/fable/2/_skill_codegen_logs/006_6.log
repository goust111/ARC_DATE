+def _try_place_final(pieces: dict[int, Piece], parent: dict[int, int | None], children: dict[int, list[int]], edge_color_by_child: dict[int, int]) -> tuple[dict[int, tuple[int, int]], dict[tuple[int, int], int]] | None:
