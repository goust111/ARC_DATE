+def _port_pairs(pieces: list[Piece]) -> tuple[dict[int, list[tuple[int, str, tuple[int, int]]]], dict[int, list[int]]]:
+    pairs: dict[int, list[tuple[int, str, tuple[int, int]]]] = {}
