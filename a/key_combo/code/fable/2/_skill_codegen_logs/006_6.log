# Canvas, layout, and retry bounds.
_GEN_GRID_SIZE_RANGE = (8, 12)
_GEN_BLOCK_COUNT_RANGE = (1, 3)
_GEN_MAX_ATTEMPTS = 300
# Block geometry and palette.
_GEN_BACKGROUND_COLOR = 0
_GEN_BLOCK_COLOR = 2
_GEN_BLOCK_SIZE = 2
_GEN_BOX_SIZE = 4
