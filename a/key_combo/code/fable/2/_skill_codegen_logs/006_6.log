+def _assert_tree(anchor: int, pieces: list[Piece], port_pairs: dict[int, list[tuple[int, str, tuple[int, int]]]]) -> None:
+    graph = {piece.idx: set() for piece in pieces}
+    for endpoints in port_pairs.values():
