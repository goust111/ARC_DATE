+    inp = _scatter_input(scrambled_pieces, BG_COLOR)
+    if inp is None:
+        return None
+
+    if not _semantic_checks(inp, expected, final_pieces, scrambled_pieces, mirror_by_child):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
