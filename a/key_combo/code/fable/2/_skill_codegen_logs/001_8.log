+        row_step = row_steps.pop()
+        col_step = col_steps.pop()
+        cell_h = row_step - 1
+        cell_w = col_step - 1
+        if cell_h != cell_w or cell_h < 3 or cell_h % 2 == 0:
+            continue
+        if row_lines[0] != 0 or row_lines[-1] != height - 1:
+            continue
+        if col_lines[0] != 0 or col_lines[-1] != width - 1:
+            continue
