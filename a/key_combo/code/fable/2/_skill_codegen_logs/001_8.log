+        row_steps = {row_lines[i + 1] - row_lines[i] for i in range(len(row_lines) - 1)}
+        col_steps = {col_lines[i + 1] - col_lines[i] for i in range(len(col_lines) - 1)}
+        if len(row_steps) != 1 or len(col_steps) != 1:
+            continue
