            opts = []
            weights = []
            for dr,dc in DIRS.values():
                rr,cc = r+dr,c+dc
                if not (0<=rr<R and 0<=cc<C) or (rr,cc) in path:
                    continue
                opts.append((rr,cc))
                w = 1.0
                if prev_dir is not None and (dr,dc) != prev_dir:
