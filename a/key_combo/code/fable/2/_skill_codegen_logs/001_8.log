+
+    grid = _render_grid(cell_rows, cell_cols, cell_size, line_color, specs)
+    expected = _expected_output(grid, cell_size, path, start_color)
+    if np.array_equal(grid, expected):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
