+    rays = {
+        "up": patch[:mid, mid],
+        "down": patch[mid + 1 :, mid],
+        "left": patch[mid, :mid],
+        "right": patch[mid, mid + 1 :],
+    }
+    for name, ray in rays.items():
+        present = bool(np.all(ray == color))
+        if not present:
+            missing.append(name)
+            if name == "up":
+                expected[:mid, mid] = bg
+            elif name == "down":
+                expected[mid + 1 :, mid] = bg
+            elif name == "left":
+                expected[mid, :mid] = bg
+            else:
