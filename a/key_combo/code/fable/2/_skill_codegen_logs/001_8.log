+        assert len(candidates) <= 1, "route must be unambiguous"
+        if not candidates:
+            return route
+
+        nxt = candidates[0]
+        assert nxt not in seen, "route must not cycle"
+        route.append(nxt)
+        seen.add(nxt)
+        current = nxt
