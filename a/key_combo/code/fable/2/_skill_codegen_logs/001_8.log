+def _render_cross(size: int, color: int, missing: str | None, *, bg: int = _BG) -> np.ndarray:
+    patch = np.full((size, size), int(bg), dtype=int)
+    mid = size // 2
+    patch[mid, :] = int(color)
+    patch[:, mid] = int(color)
+    if missing == "up":
