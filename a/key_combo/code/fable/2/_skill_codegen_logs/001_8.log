+def _find_lattice(grid: np.ndarray) -> tuple[int, int, list[int], list[int]]:
+    height, width = map(int, grid.shape)
+    candidates = []
+    for color in sorted(set(map(int, np.unique(grid)))):
+        row_lines = [r for r in range(height) if np.all(grid[r, :] == color)]
