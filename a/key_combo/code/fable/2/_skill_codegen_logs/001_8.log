+        remaining_after_move = length - len(path) - 1
+
+        options = []
+        for dr, dc in _DIRS.values():
+            nr, nc = current[0] + dr, current[1] + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < cell_rows and 0 <= nc < cell_cols):
