            trial = mask.copy()
            trial[r, c] = True
            new_count = _gen_component_count(trial)
            if new_count <= best_count:
                if new_count < best_count:
                    choices = []
                    best_count = new_count
                choices.append((r, c))
        if not choices:
            return None
        r, c = _gen_choice(choices)
        mask[r, c] = True
    return mask


def _gen_add_keeps_components(mask, r, c):
    if mask[r, c]:
        return True
    trial = mask.copy()
    trial[r, c] = True
    return _gen_component_count(trial) <= _GEN_MAX_COMPONENTS


