def _gen_bbox_distance(box_a, box_b):
    ar0, ac0, ar1, ac1 = box_a
    br0, bc0, br1, bc1 = box_b
    dr = max(0, ar0 - br1, br0 - ar1)
    dc = max(0, ac0 - bc1, bc0 - ac1)
    return dr + dc


