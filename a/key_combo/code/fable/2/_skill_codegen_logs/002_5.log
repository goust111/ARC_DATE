+            trace["edge_hit"] = True
+            break
+
+        colliders = []
+        for idx, target in enumerate(state):
+            if idx == moving_idx:
+                continue
+            if _box_overlap(trial, target):
+                colliders.append(idx)
+        assert len(colliders) <= 1, "collision target must be unique"
+
+        if colliders:
+            moving_idx = colliders[0]
+            trace["collisions"] += 1
+            continue
+
+        mover["r0"] += dr
+        mover["r1"] += dr
+        mover["c0"] += dc
+        mover["c1"] += dc
+        remaining -= 1
