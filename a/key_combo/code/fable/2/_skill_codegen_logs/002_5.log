+
+    distractors = _place_distractors(grid.shape, direction, lane_box, occupied_boxes[:], palette)
+    if not distractors:
+        return None
+    for patch, r0, c0 in distractors:
+        paste(grid, patch, r0, c0)
+
+    if np.bincount(grid.ravel(), minlength=10).argmax() != BACKGROUND:
