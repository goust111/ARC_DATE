+    for r in range(h):
+        for c in (0, w - 1):
+            if panel[r, c] == BLACK and not reachable[r, c]:
+                reachable[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if panel[r, c] == BLACK and not reachable[r, c]:
+                reachable[r, c] = True
+                queue.append((r, c))
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < h and 0 <= nc < w and panel[nr, nc] == BLACK and not reachable[nr, nc]:
+                reachable[nr, nc] = True
+                queue.append((nr, nc))
