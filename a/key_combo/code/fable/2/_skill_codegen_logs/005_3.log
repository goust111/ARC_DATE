+    top = grid[:sep_r]
+    bottom = grid[sep_r + 1 :]
+    top_has_grey = bool(np.any(top == GREY))
+    bottom_has_grey = bool(np.any(bottom == GREY))
+    assert top_has_grey ^ bottom_has_grey, "expected exactly one grey work panel"
