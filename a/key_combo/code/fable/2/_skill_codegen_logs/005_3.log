+    return grid, expected, matched_count, template_count
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        try:
+            grid, expected, matched_count, template_count = _generate_instance()
+        except RuntimeError:
