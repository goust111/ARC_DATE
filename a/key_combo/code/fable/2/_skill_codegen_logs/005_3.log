+    colors = list(map(int, rng.choice(palette, size=color_count, replace=False)))
+    patch = np.zeros(mask.shape, dtype=int)
+    accent_count = min(len(coords), max(1, color_count - 1))
+    for index, (r, c) in enumerate(coords):
