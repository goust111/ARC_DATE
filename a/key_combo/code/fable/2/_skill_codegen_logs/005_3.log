+def _shape_has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    empty = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    queue = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if empty[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
