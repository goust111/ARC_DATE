+        patch = crop_bbox(panel, box)
+        templates.append(
+            {
+                "bbox": box,
+                "patch": patch,
+                "mask": patch != BLACK,
+                "variants": _variant_records(patch),
+            }
+        )
+    templates.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return templates
