+def _apply_variant(arr: np.ndarray, variant: int) -> np.ndarray:
+    out = np.array(arr, copy=True)
+    if int(variant) >= 4:
+        out = np.fliplr(out)
+    return np.rot90(out, int(variant) % 4)
