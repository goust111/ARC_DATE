+            continue
+
+        grid = np.full((height, width), int(bg), dtype=int)
+        marker_cells: set[tuple[int, int]] = set()
+        bbox_mask = np.zeros((height, width), dtype=bool)
+        pocket_candidates: list[tuple[int, int]] = []
+
+        for spec, (top, left) in zip(specs, positions):
