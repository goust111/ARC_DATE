        if not candidates:
            break
        pick = list(candidates)[int(rng.integers(0, len(candidates)))]
        mask[pick[0], pick[1]] = True
        pixels.append(pick)
    return mask


def _growth_candidates(mask: np.ndarray, pixels: list[tuple[int, int]]) -> set:
    h, w = mask.shape
    candidates = set()
    for r, c in pixels:
