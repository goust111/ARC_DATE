+GEN_MODES = ("full", "stop_immediate", "stop_late")
+
+
+@dataclass(frozen=True)
+class Pillar:
+    color: int
+    base_col: int
+    height: int
+    top_row: int
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[np.ndarray, list[Pillar], int, int]:
+    g = np.asarray(grid, dtype=int)
