+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+CARDINAL_PATTERN = (TEAL, TEAL, YELLOW)
+
+DIRECTION_STEPS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
