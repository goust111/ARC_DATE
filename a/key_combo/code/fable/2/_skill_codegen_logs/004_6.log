+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+CARDINAL_PATTERN = (TEAL, TEAL, YELLOW)
+
+DIRECTION_STEPS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SW": (1, -1),
+    "SE": (1, 1),
+}
+ALL_DIRECTIONS = ("N", "S", "W", "E", "NW", "NE", "SW", "SE")
+CARDINAL_DIRECTIONS = ("N", "S", "W", "E")
+DIAGONAL_DIRECTIONS = ("NW", "NE", "SW", "SE")
+OPPOSITE_PAIRS = (("N", "S"), ("W", "E"), ("NW", "SE"), ("NE", "SW"))
