+    fragments = _extract_fragments(g)
+    center = _solve_center(g, fragments)
+    return _paint_full_star(g.shape, center)
+
+
+GRID_MIN = 11
+GRID_MAX = 30
+CENTER_MARGIN = 4
+GEN_RETRY_LIMIT = 500
+FRAGMENT_MAX_LEN = 5
+
+
+def _direction_family(direction: str) -> str:
+    if direction in ("N", "S"):
