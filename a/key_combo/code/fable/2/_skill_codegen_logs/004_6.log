+
+    assert len(fragments) >= 2, "expected several residual fragments"
+    return fragments
+
+
+def _intersect_lines(a: dict, b: dict) -> tuple[int, int] | None:
+    ka = a["kind"]
+    kb = b["kind"]
+    va = int(a["const"])
+    vb = int(b["const"])
+    if ka == kb:
