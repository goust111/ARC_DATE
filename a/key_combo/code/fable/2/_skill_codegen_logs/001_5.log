0014: def main(input_grid):
0015:     """
0016:     Reconstruct scattered fragments by placing scaled and rotated copies of the multicolor template.
0017: 
0018:     Input structure:
0019:     - The background is a non-black color.
0020:     - One object is the multicolor template with the largest variety of colors.
0021:     - Other objects are partial scaled and rotated fragments of that template.
0022: 
0023:     Rule:
0024:     - Treat the most common non-black color as the background.
0025:     - Try rotations and scale factors of the template against the remaining fragments.
0026:     - Iteratively paste the best color-compatible placement and erase the matched fragment pixels.
0027: 
0028:     Key insight:
0029:     - The complete template is distinguished by color variety, while fragments are partial observations of transformed copies.
0030:     """
0031:     # Plan:
0032:     # 1. Detect the object, separating the small multicolored puzzle piece from its fragments
0033:     # 2. Rescale/rotate/translate the small object
0034:     # 3. Find the transformation covering as much of the fragments as possible, matching colors whenever they overlap
0035:     # 4. Copy the resulting transformation to the output grid; delete the fragments from the input
0036:     # 5. Repeat until all the fragments are gone
0037: 
0038:     # 1. object detection
0039:     # because the background is not black, set it to be the most common color
0040:     background = max(Color.NOT_BLACK, key=lambda color: np.sum(input_grid == color))
0041:     # detect the objects and figure out which is the template puzzle piece, which is going to be the one with the largest variety of colors
0042:     objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=False, return_format="objects")
0043:     template_object = max(objects, key=lambda obj: len(colors_present(obj, exclude={ background })))
0044:     _b = bbox(template_object != background)
0045:     assert _b is not None
0046:     template_sprite = crop_bbox(template_object, _b)
0047: 
0048:     output_grid = np.full_like(input_grid, background)
0049: 
0050:     # 2. rescale/rotate/translate the small object to cover as much of the fragments as possible, matching colors whenever they overlap
0051:     rescaled_and_rotated = [ np.rot90(scale_sprite(template_sprite, scale), k=rot)
0052:                             for scale in [1, 2, 3, 4]
0053:                             for rot in range(4) ]
0054:     # A placement solution is a tuple of (x, y, sprite) where x, y is the top-left corner of the rotated/scaled sprite
0055:     possible_solutions = [ (r, c, sprite)
0056:                           for sprite in rescaled_and_rotated
0057:                           for r in range(output_grid.shape[0] - sprite.shape[0])
0058:                           for c in range(output_grid.shape[1] - sprite.shape[1]) ]
0059:     
0060:     # Keep on looping until we are out of things to copy to the output
0061:     while np.any(input_grid != background):
0062: 
0063:         def score_solution(r, c, sprite):
0064:             # The score is -inf if the placement violates non-background colors
0065:             # Otherwise it is the number of pixels that match in color between the sprite and the input
0066:             test_canvas = np.full_like(input_grid, background)
0067:             paste(test_canvas, sprite, r, c, transparent=Color.BLACK, clip=True)
0068: 
0069:             if np.any( (test_canvas != background) & (input_grid != background) & (test_canvas != input_grid) ):
0070:                 return float("-inf")
0071:             
0072:             return np.sum( (test_canvas == input_grid) & (input_grid != background) )
0073:         
0074:         # Remove -inf solutions, and zero solutions
0075:         possible_solutions = [ solution for solution in possible_solutions if score_solution(*solution) > 0 ]
0076:         
0077:         best_r, best_c, best_sprite = max(possible_solutions, key=lambda solution: score_solution(*solution))
0078: 
0079:         # 4. Copy the resulting transformation to the output grid; delete the fragments from the input
0080:         # Copy output
0081:         paste(output_grid, best_sprite, best_r, best_c, transparent=Color.BLACK, clip=True)
0082:         # Delete from input
0083:         for dr, dc in np.argwhere(best_sprite != background):
0084:             input_grid[best_r + dr, best_c + dc] = background
0085:         
0086:         # 5. Repeat until all the fragments are gone
0087:     
0088:     return output_grid
