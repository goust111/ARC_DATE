+        if spec["top_notch"] is not None:
+            notch = spec["top_notch"]
+            board_patch = grid[top_board_r : top_board_r + notch.shape[0], c : c + w]
+            board_patch[notch] = BACKGROUND
+        if spec["bottom_notch"] is not None:
