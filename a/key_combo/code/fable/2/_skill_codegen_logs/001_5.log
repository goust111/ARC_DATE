+def _drop_until_contact(board_mask: np.ndarray, sprite_mask: np.ndarray, start_r: int, c0: int) -> int:
+    h, w = sprite_mask.shape
+    H, W = board_mask.shape
+    r = int(start_r)
+    c0 = int(c0)
+    assert 0 <= c0 and c0 + w <= W
+    assert 0 <= r and r + h <= H
