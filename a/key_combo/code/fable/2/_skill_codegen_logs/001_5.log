+            if spec["bottom_notch"] is None:
+                continue
+            notch = spec["bottom_notch"]
+            bottom_board_mask[bottom_board_r : bottom_board_r + notch.shape[0], spec["c0"] : spec["c1"] + 1][notch] = False
+
