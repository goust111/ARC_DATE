0011: # In the input you will see a large monochromatic object, and a smaller square object with many colors.
0012: # To make the output, first downscale the large object so that it is the same size as the small multicolor square, and then use the large object as a binary mask to zero out pixels in the square. Return the resulting masked sprite.
0013: 
0014: def main(input_grid):
0015:     """
0016:     Use a downscaled monochrome pattern as a mask on the multicolor square.
0017: 
0018:     Input structure:
0019:     - The input is a black grid with one large single-color pattern object.
0020:     - A smaller dense multicolor square appears elsewhere.
0021:     - The pattern is an integer scale-up of a square mask.
0022: 
0023:     Rule:
0024:     - Separate the monochrome pattern from the multicolor square.
0025:     - Crop both objects and downsample the pattern to the square's size.
0026:     - Keep square pixels where the downsampled pattern is non-black and set the rest to black.
0027: 
0028:     Key insight:
0029:     - The large object is a binary stencil that aligns with the square after integer downscaling.
0030:     """
0031:     # find all the objects in the input grid
0032:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
0033: 
0034:     # figure out which object is the pattern and which object is the multi-colored square
0035:     pattern = square = None
0036:     for obj in objects:
0037:         # if the object has only one color and black, it is the pattern. Otherwise, it is the multi-colored square.
0038:         if len(set(obj.flatten())) == 2:
0039:             pattern = obj
0040:         else:
0041:             square = obj
0042:     
0043:     # get the square location and cut out the bounding box
0044:     _b = bbox(square != Color.BLACK)
0045:     assert _b is not None
0046:     r, c, _r1, _c1 = _b
0047:     width = _r1 - r + 1
0048:     height = _c1 - c + 1
0049:     square_sprite = square[r:r+width, c:c+height]
0050: 
0051:     # cut out the bounding box of the pattern
0052:     _b = bbox(pattern != Color.BLACK)
0053:     assert _b is not None
0054:     x2, y2, _r1, _c1 = _b
0055:     width2 = _r1 - x2 + 1
0056:     height2 = _c1 - y2 + 1
0057:     # make sure the pattern is square
0058:     if width2 != height2:
0059:         width2 = height2 = max(width2, height2)
0060:     pattern_sprite = pattern[x2:x2+width2, y2:y2+height2]
0061: 
0062:     # figure out how much bigger the pattern is than the square
0063:     scale = width2 // width
0064: 
0065:     # scale down the pattern to fit the square
0066:     scaled_pattern = np.zeros_like(square_sprite) 
0067:     for i in range(width):
0068:         for j in range(height):
0069:             scaled_pattern[i,j] = pattern_sprite[i * scale, j * scale]
0070:     
0071:     # if the pixel is in the pattern, keep the color from the square otherwise make it black in the output grid
0072:     output_grid = np.where(scaled_pattern, square_sprite, Color.BLACK)
0073: 
0074:     return output_grid
0075: 
0076: 
