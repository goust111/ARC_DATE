+def _mask_from_cells(cells: set[tuple[int, int]]) -> np.ndarray:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+    return mask
