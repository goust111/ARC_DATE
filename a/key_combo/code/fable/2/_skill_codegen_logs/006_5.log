+    candidates = [
+        (r, c)
+        for r in range(n)
+        for c in range(n)
+        if (r, c) not in {CORNER_COORDS[name](n) for name in CORNER_COORDS}
+    ]
+    while len(positions) < total_markers:
+        pick = _choose_coord(candidates[:], chosen)
