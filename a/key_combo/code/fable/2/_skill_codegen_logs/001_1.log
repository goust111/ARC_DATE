+def _max_seed_count(width: int) -> int:
+    return 1 + len(range(0, width - 1, MIN_SEED_GAP))
+
+
+def _sample_seed_columns(width: int, seed_count: int) -> list[int] | None:
+    cols = [width - 1]
+    pool = list(range(width - 1))
+    random.shuffle(pool)
+    for c in pool:
