+BACKGROUND = 0
+GREY = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+HEIGHT_RANGE = (10, 18)
+WIDTH_RANGE = (10, 18)
+SEED_COUNT_RANGE = (3, 4)
+UNHIT_BLOCK_COUNT_RANGE = (1, 2)
+MIN_SEED_GAP = 2
+MAX_GENERATION_ATTEMPTS = 600
