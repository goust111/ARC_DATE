+    cell_to_block: dict[tuple[int, int], tuple[int, int]] = {}
+    for anchor in blocks:
+        r0, c0 = anchor
+        assert 0 < r0 < height - 2 and 0 < c0 < width - 2, "gray blocks must float in the interior"
+        for cell in _block_cells(anchor):
+            cell_to_block[cell] = anchor
