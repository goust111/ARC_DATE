+    seed_cols = [int(c) for c in np.flatnonzero((g[-1] != BACKGROUND) & (g[-1] != GREY))]
+    seed_colors = [int(g[-1, c]) for c in seed_cols]
+    assert len(seed_colors) == len(set(seed_colors)), "seed colors must be distinct"
