+    r = height - 1
+    c = int(start_col)
+    dc = -1 if c == width - 1 else 1
+
+    while True:
+        nr = r - 1
+        if nr < 0:
+            return None
+        nc = c + dc
+        if nc < 0 or nc >= width:
+            dc *= -1
+            nc = c + dc
+        r, c = nr, nc
