    inp = out.copy()
    for i in match_indices:
        _, _, r0, c0 = content_cells[i]
        inp_cell = inp[r0 : r0 + _GEN_CELL_SIZE, c0 : c0 + _GEN_CELL_SIZE]
        inp_cell[mask] = _GEN_BLUE
    return inp


