+    bounce_counts: list[list[int]],
+    seed_idx: int,
+    shape: tuple[int, int],
+) -> list[dict]:
+    height, width = shape
+    other_path_cells = set()
+    for other_idx, other_path in enumerate(paths):
+        if other_idx != seed_idx:
+            other_path_cells.update(other_path)
