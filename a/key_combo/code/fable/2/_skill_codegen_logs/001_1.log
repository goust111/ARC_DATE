+    hits: dict[tuple[int, int], int] = {}
+    for c, color in zip(seed_cols, seed_colors):
+        anchor = _simulate_seed_hit(height, width, c, cell_to_block)
+        if anchor is None:
+            continue
+        assert anchor not in hits, "a gray block must not be hit by multiple seeds"
