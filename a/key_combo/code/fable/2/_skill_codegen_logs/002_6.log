def _gen_valid_match_keys(grid: np.ndarray, marker_color: int, placements):
    keys = set()
    for _, _, _, marker_cells, fill_set, _ in placements:
        if all(int(grid[r, c]) == marker_color for r, c in marker_cells) and all(
