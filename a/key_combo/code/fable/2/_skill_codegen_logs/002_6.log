+def _choose_layout(size: int, total_objects: int) -> tuple[int, int, int, int, int, int] | None:
+    pitch = size + 4
+    layouts = []
+    for rows in range(1, min(4, total_objects) + 1):
+        cols = (total_objects + rows - 1) // rows
+        base_h = rows * pitch + 1
+        base_w = cols * pitch + 1
