+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+ROTATION_POSES = [1, 2, 3]
+MIRROR_POSES = [4, 5, 6, 7]
