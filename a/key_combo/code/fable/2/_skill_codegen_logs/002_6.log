+    if pose == 1:
+        return np.rot90(square, 1).copy()
+    if pose == 2:
+        return np.rot90(square, 2).copy()
+    if pose == 3:
+        return np.rot90(square, 3).copy()
+    if pose == 4:
+        return np.fliplr(square).copy()
+    if pose == 5:
+        return np.fliplr(np.rot90(square, 1)).copy()
+    if pose == 6:
+        return np.fliplr(np.rot90(square, 2)).copy()
+    if pose == 7:
