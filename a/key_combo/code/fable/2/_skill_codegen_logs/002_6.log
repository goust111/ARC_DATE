+    patch[0, 0], patch[0, -1], patch[-1, 0], patch[-1, -1] = corners
+    if size >= 3:
+        patch[size // 2, size // 2] = core[(salt + size) % len(core)]
+        patch[size // 2, 0] = core[(salt + 1) % len(core)]
+        patch[0, size // 2] = core[(salt + 2) % len(core)]
+    return patch
