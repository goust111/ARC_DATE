+        total_h[spec["corner"]] += h
+        total_w[spec["corner"]] += w
+
+    min_h = max(
+        total_h["top_left"] + total_h["bottom_left"],
+        total_h["top_right"] + total_h["bottom_right"],
+        total_h["top_left"] + total_h["bottom_right"],
+        total_h["top_right"] + total_h["bottom_left"],
+        max(total_h.values()),
