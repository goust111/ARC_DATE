+    pr0, pc0, pr1, pc1 = map(int, prev_bbox)
+    if corner == "top_left":
+        return pr1 + 1, pc1 + 1
+    if corner == "top_right":
+        return pr1 + 1, pc0 - w
+    if corner == "bottom_left":
+        return pr0 - h, pc1 + 1
+    assert corner == "bottom_right"
+    return pr0 - h, pc0 - w
