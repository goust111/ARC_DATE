+            if max(abs(int(ra) - int(rb)), abs(int(ca) - int(cb))) == 1:
+                return True
+    return False
+
+
+def _bbox_corner_distance(
+    bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
