+def _bbox_corner_distance(
+    bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
+    corner: str,
+) -> int:
+    h, w = map(int, shape)
+    r0, c0, r1, c1 = map(int, bbox)
+    if corner == "top_left":
+        return max(r0, c0)
+    if corner == "top_right":
+        return max(r0, w - 1 - c1)
+    if corner == "bottom_left":
+        return max(h - 1 - r1, c0)
+    assert corner == "bottom_right"
+    return max(h - 1 - r1, w - 1 - c1)
