+def _corner_multiset() -> list[str]:
+    active_count = random.randint(2, 4)
+    active = random.sample(list(CORNERS), active_count)
+    corners = active[:]
+    for _ in range(random.randint(1, 3)):
+        corners.append(random.choice(active))
+    random.shuffle(corners)
