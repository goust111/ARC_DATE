+        total_w["bottom_left"] + total_w["bottom_right"],
+        total_w["top_left"] + total_w["bottom_right"],
+        total_w["top_right"] + total_w["bottom_left"],
+        max(total_w.values()),
+        GEN_MIN_SIZE,
+    )
+
+    min_h += 2
+    min_w += 2
+    if min_h > GEN_MAX_SIZE or min_w > GEN_MAX_SIZE:
