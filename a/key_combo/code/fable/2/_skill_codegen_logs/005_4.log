+    return patch
+
+
+def _make_marker_patch(bg: int, corner: str) -> np.ndarray:
+    patch = np.full((2, 2), bg, dtype=int)
+    for r, c in MARKER_CELLS[corner]:
+        patch[r, c] = RED
