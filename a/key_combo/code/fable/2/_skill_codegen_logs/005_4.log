+GEN_MAX_SIZE = 30
+GEN_COLOR_POOL = tuple(range(10))
+GEN_STYLE_SOLID = "solid"
+GEN_STYLE_FRAME = "frame"
+GEN_STYLE_PUNCTURE = "puncture"
+
+
+def _marker_corner_from_coords(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, _r1, _c1 = bbox
