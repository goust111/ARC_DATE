+
+def _first_bbox(corner: str, patch_shape: tuple[int, int], grid_shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = map(int, patch_shape)
+    gh, gw = map(int, grid_shape)
+    if corner == "top_left":
+        return 0, 0
+    if corner == "top_right":
+        return 0, gw - w
+    if corner == "bottom_left":
+        return gh - h, 0
+    assert corner == "bottom_right"
+    return gh - h, gw - w
