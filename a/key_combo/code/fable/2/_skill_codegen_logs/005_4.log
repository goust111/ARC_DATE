+def _touches8(coords_a: np.ndarray, coords_b: np.ndarray) -> bool:
+    for ra, ca in coords_a:
+        for rb, cb in coords_b:
+            if max(abs(int(ra) - int(rb)), abs(int(ca) - int(cb))) == 1:
+                return True
+    return False
