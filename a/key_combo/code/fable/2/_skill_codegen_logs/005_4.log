+
+
+def _output_min_shape(specs: list[dict]) -> tuple[int, int] | None:
+    total_h = {corner: 0 for corner in CORNERS}
+    total_w = {corner: 0 for corner in CORNERS}
+    for spec in specs:
+        h, w = map(int, spec["sprite_patch"].shape)
+        total_h[spec["corner"]] += h
