def _gen_paint_expected_border(out: np.ndarray, box: tuple[int, int, int, int]) -> None:
    h, w = out.shape
    r0, c0, r1, c1 = box
    er0 = max(0, r0 - 1)
    ec0 = max(0, c0 - 1)
    er1 = min(h - 1, r1 + 1)
