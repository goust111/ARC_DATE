    elif anchor == "leftcenter":
        rr, cc = r0 + (h - 1) / 2, c0
    elif anchor == "rightcenter":
        rr, cc = r0 + (h - 1) / 2, c1
    else:
        raise ValueError("bbox_anchor: invalid anchor")

    return int(round(rr)), int(round(cc))


