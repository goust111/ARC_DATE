        if int(coverage.max()) < 2:
            continue
        overlap_cells = int(np.count_nonzero(coverage >= 2))
        if overlap_cells > int(0.35 * h * w):
            continue

        areas = [_rect_area(rect) for rect in rects]
        if areas == sorted(areas) or areas == sorted(areas, reverse=True):
