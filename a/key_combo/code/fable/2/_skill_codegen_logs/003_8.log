    return None


def _build_input(
    rect_specs: list[dict[str, int]],
    bg: int,
    divider_color: int,
    h: int,
    w: int,
) -> np.ndarray:
    n = len(rect_specs)
    grid = np.full((n + 1 + h, n + 1 + w), int(bg), dtype=int)
