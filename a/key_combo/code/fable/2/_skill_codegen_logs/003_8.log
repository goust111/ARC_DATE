+    max_h = max(min_h, min(h, max(RECT_SIDE_MIN, int(np.floor(h * RECT_SIDE_MAX_RATIO)))))
+    max_w = max(min_w, min(w, max(RECT_SIDE_MIN, int(np.floor(w * RECT_SIDE_MAX_RATIO)))))
