+def _find_divider(grid: np.ndarray) -> tuple[int, int, int]:
+    h, w = grid.shape
+    full_rows = [(r, int(grid[r, 0])) for r in range(h) if np.all(grid[r, :] == grid[r, 0])]
+    full_cols = [(c, int(grid[0, c])) for c in range(w) if np.all(grid[:, c] == grid[0, c])]
