        grid[rank, n + 1 + layer["c0"] : n + 1 + layer["c1"] + 1] = color
        grid[n + 1 + layer["r0"] : n + 1 + layer["r1"] + 1, rank] = color
    return grid


def _semantic_ok(inp: np.ndarray, rect_specs: list[dict[str, int]], bg: int) -> bool:
    h = max(layer["r1"] for layer in rect_specs) + 1
