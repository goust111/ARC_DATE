+        return None
+
+    counts = Counter(map(int, band[band != BG].ravel()))
+    if len(colors) == 1:
+        main_color = colors[0]
+        if counts[main_color] < 2:
+            return None
+        mask = band != BG
+        return {"main_color": main_color, "pointer_color": None, "mask": mask}
