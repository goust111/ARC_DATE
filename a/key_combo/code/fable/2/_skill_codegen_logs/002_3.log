+
+
+def _make_case() -> dict | None:
+    n_layers = random.randint(*LAYER_COUNT_RANGE)
+    band_h = random.choice(_valid_band_heights(n_layers))
+    band_w = random.randint(max(9, 2 * n_layers + 2), 16)
