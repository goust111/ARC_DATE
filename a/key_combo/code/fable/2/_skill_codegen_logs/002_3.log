+    matches = []
+    for n_layers in range(LAYER_COUNT_RANGE[0], LAYER_COUNT_RANGE[1] + 1):
+        if h_total % n_layers != 0:
+            continue
+        band_h = h_total // n_layers
+        bands = [g[i * band_h : (i + 1) * band_h, :] for i in range(n_layers)]
+        specs = []
