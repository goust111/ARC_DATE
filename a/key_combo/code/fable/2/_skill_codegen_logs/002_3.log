+
+def _overlay_specs(specs: list[dict], order: list[int], band_shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray]:
+    out = np.zeros(band_shape, dtype=int)
+    owner = np.full(band_shape, -1, dtype=int)
