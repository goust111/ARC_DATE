        coords = [(r0 + r, c0 + c) for r, c in obj["shape"]]
        placements.append((obj["is_placeholder"], coords))
    return placements


def _gen_attempt():
    k = random.randint(GEN_PAIR_MIN, GEN_PAIR_MAX)
    min_n = min(GEN_CANVAS_MAX, GEN_CANVAS_FIT_BASE + GEN_CANVAS_FIT_STEP * (k - 1))
