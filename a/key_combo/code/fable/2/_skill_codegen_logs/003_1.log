+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
+    w = random.randint(*GRID_WIDTH_RANGE)
+    n_frames = random.randint(*FRAME_COUNT_RANGE)
