+def _alternative_orders(order: list[int]) -> list[list[int]]:
+    alts = [list(reversed(order))]
+    for i in range(len(order) - 1):
+        alt = order[:]
+        alt[i], alt[i + 1] = alt[i + 1], alt[i]
+        alts.append(alt)
+    return alts
+
+
+def _semantic_ok(
+    inp: np.ndarray,
+    expected_order: list[int],
+    boxes: list[tuple[int, int, int, int]],
+) -> bool:
