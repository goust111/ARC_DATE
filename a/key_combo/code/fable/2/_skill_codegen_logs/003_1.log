def _gen_pair_objects(shapes, colors):
    objects = [
        {"pair_id": pair_id, "is_placeholder": is_placeholder, "shape": shape, "color": color}
        for pair_id, (shape, color) in enumerate(zip(shapes, colors))
        for is_placeholder in (False, True)
