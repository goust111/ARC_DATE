+
+    for color in order:
+        coords = coords_by_color[color]
+        assert not occupied[coords[:, 0], coords[:, 1]].any(), "a falling frame cannot start inside a settled frame"
+
+        shift = 0
+        reason = "ground"
+        while True:
+            next_rows = coords[:, 0] + shift + 1
+            cols = coords[:, 1]
+            if int(next_rows.max()) >= h:
+                reason = "ground"
+                break
