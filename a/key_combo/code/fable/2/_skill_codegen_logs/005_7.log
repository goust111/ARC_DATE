+
+def _random_connected_mask() -> np.ndarray:
+    for _ in range(100):
+        h = _rand_range(SHAPE_H_RANGE)
+        w = _rand_range(SHAPE_W_RANGE)
+        if h == 1 and w == 1:
+            continue
+        area = random.randint(2, min(MAX_AREA, h * w))
+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        while len(cells) < area:
