    for variable_side in ORIGINAL_SIDE_RANGE:
        for d in EXPANSION_DISTANCE_RANGE:
            expanded_side = variable_side + d
            if EXPANDED_SIDE_MIN <= expanded_side <= min(axis_limit, EXPANDED_SIDE_MAX):
