+        col_limit = panel_w - spec["shape"][1]
+        row_final, row_bounce = _single_bounce_axis(bottom_bbox[0], dr, row_limit)
+        col_final, col_bounce = _single_bounce_axis(bottom_bbox[1], dc, col_limit)
