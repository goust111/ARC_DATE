+GEN_MAX_ATTEMPTS = 400
+SPRITE_ATTEMPTS = 250
+SPRITE_COUNT = 4
+SPRITE_BRANCHES = [
+    (True, True),
+    (True, False),
+    (False, True),
+    (False, False),
+]
+PANEL_H_RANGE = (9, 14)
+PANEL_W_RANGE = (11, 16)
+SHAPE_H_RANGE = (1, 4)
+SHAPE_W_RANGE = (1, 4)
+MAX_AREA = 5
+SPEED_VALUES = (-3, -2, -1, 1, 2, 3)
+PADDING = 1
