  38:     red_bbox: list[tuple[int, int, int, int]] = []
  39:     red_at: dict[tuple[int, int], int] = {}
  40: 
  41:     for rid, coords in enumerate(red_comps):
  42:         pts = [(int(r), int(c)) for r, c in coords]
  43:         red_coords.append(pts)
  44:         red_bbox.append(tuple(map(int, bbox_coords(coords))))
  45:         for rc in pts:
  46:             red_at[rc] = int(rid)
  47: 
  48:     # --- connected components: structures (non-bg, non-red) ---
  49:     struct_mask = (g != int(bg)) & (g != int(RED))
  50:     struct_comps = components_mask(struct_mask, connectivity=4)
  51:     assert struct_comps, "expected at least one non-bg non-red structure to dock into"
  52: 
  53:     struct_coords: list[set[tuple[int, int]]] = []
  54:     struct_bbox: list[tuple[int, int, int, int]] = []
  55:     for coords in struct_comps:
  56:         pts = {(int(r), int(c)) for r, c in coords}
  57:         struct_coords.append(pts)
  58:         struct_bbox.append(tuple(map(int, bbox_coords(coords))))
  59: 
  60:     dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
  61: 
  62:     # For each structure, find its best (red, dir, anchor) triple.
  63:     struct_best: list[tuple[tuple[int, int], int, tuple[int, int], tuple[int, int], int]] = []
  64:     # entries: ((hit_count, -min_dist), rid, dir, anchor, sid)
