+        run_count = 0
+        while pos < width and run_count < 4:
+            run_len = random.randint(1, min(3, width - pos))
+            row[pos : pos + run_len] = random.choice(palette)
+            run_count += 1
+            pos += run_len + random.randint(1, 2)
