  61:         r = cr + dr
  62:         c = cc + dc
  63:         while in_bounds(g.shape, r, c):
  64:             assert int(out[r, c]) == bg, "diagonal ray must cross only background"
  65:             out[r, c] = Color.BLUE
  66:             r += dr
