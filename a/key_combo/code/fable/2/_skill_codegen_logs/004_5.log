+            r0 = random.randint(0, height - 1)
+            r1 = random.randint(r0, min(height - 1, r0 + random.randint(1, 2)))
+            color = int(motif[r0, col]) if int(motif[r0, col]) != BG and random.random() < 0.6 else random.choice(palette)
