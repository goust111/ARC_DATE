  85: def main(grid: np.ndarray) -> np.ndarray:
  86:     """
  87:     Move each isolated colored pixel into the one-cell frame around a grey 2x2 block.
  88: 
  89:     Input structure:
  90:     - Background is the dominant color.
  91:     - Grey foreground objects are solid 2x2 anchor blocks.
  92:     - Every other non-background, non-grey cell is a colored singleton source.
  93: 
  94:     Rule:
  95:     - Keep the grey anchors fixed and clear all colored singleton source pixels.
  96:     - For each singleton and each anchor, the normal destination is the cell reached by
  97:       clamping the pixel into the anchor's one-cell outer frame.
  98:     - If a diagonally outside singleton has an exact 8-direction sightline into an anchor,
  99:       also allow the cell just before the first grey pixel on that ray.
 100:     - Choose distinct destinations that minimize total king-move distance; at equal
 101:       distance prefer exact sightlines, then the shorter Manhattan movement.
 102: 
 103:     Key insight: The grey 2x2 blocks define magnetic frames; conflicts are resolved
 104:     structurally by nearest-frame assignment rather than by color identity.
 105:     """
 106:     g = np.asarray(grid, dtype=int)
 107:     bg = get_bg(g)
 108:     blocks = _grey_blocks(g, bg)
 109:     dots = [tuple(map(int, p)) for p in np.argwhere((g != bg) & (g != GREY))]
 110:     assert dots, "expected colored singleton pixels"
 111: 
 112:     candidates: list[tuple[int, tuple[int, int], int]] = []
 113:     for i, p in enumerate(dots):
 114:         for b in blocks:
 115:             target = _frame_clamp(p, b)
 116:             candidates.append((i, target, 1))
 117:             ray = _ray_target(g, p, b)
 118:             if ray is not None and ray != target:
 119:                 candidates.append((i, ray, 0))
 120: 
 121:     targets = sorted({target for _i, target, _kind in candidates})
 122:     assert len(targets) >= len(dots), "expected enough destination frame cells"
 123:     target_index = {target: i for i, target in enumerate(targets)}
 124: 
 125:     h, w = g.shape
 126:     kind_weight = 100
 127:     cheb_weight = 10_000
 128:     assert 2 * max(h, w) < kind_weight < cheb_weight, "cost weights must preserve lexicographic geometry"
 129: 
 130:     costs = np.full((len(dots), len(targets)), 10**9, dtype=int)
 131:     for i, target, kind_penalty in candidates:
 132:         r, c = target
 133:         assert 0 <= r < h and 0 <= c < w, "destination must stay inside the grid"
 134:         assert int(g[r, c]) != GREY, "destination cannot be inside a grey anchor"
 135:         dr = abs(r - dots[i][0])
 136:         dc = abs(c - dots[i][1])
 137:         cheb = max(dr, dc)
 138:         manhattan = dr + dc
 139:         cost = cheb * cheb_weight + kind_penalty * kind_weight + manhattan
 140:         j = target_index[target]
 141:         costs[i, j] = min(costs[i, j], cost)
 142: 
 143:     rows, cols = linear_sum_assignment(costs)
 144:     assert len(rows) == len(dots), "every colored pixel must receive a destination"
 145:     assert all(costs[r, c] < 10**9 for r, c in zip(rows, cols)), "all assignments must be valid"
 146: 
 147:     out = g.copy()
 148:     for r, c in dots:
 149:         out[r, c] = bg
 150:     for r, c in zip(rows, cols):
 151:         out[targets[c]] = int(g[dots[r]])
 152:     return out
