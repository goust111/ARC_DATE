  84:                 while 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(bg):
  85:                     rr += int(dr)
  86:                     cc += int(dc)
  87: 
  88:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(RED):
  89:                     rid = int(red_at[(int(rr), int(cc))])
  90:                     rec = hits[rid]
  91:                     rec[0] += 1
  92:                     dist = abs(int(rr) - int(r)) + abs(int(cc) - int(c))
  93:                     if int(dist) < int(rec[1]):
  94:                         rec[1] = int(dist)
  95:                         rec[2] = (int(r), int(c))
  96: 
  97:             if not hits:
