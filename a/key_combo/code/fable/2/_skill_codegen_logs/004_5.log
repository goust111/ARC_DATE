 168: def main(grid: np.ndarray) -> np.ndarray:
 169:     """
 170:     Connect hollow rectangular frames into one shortest visible corridor network.
 171: 
 172:     Input structure
 173:     - A single foreground color forms disconnected hollow rectangular frames on the background.
 174:     - A visible candidate gap is horizontal or vertical, has overlapping frame interiors, and is clear background between the two frames.
 175: 
 176:     Rule
 177:     - Select the minimum-length spanning set of visible frame-to-frame gaps.
 178:     - For a horizontal selected gap, paint the two boundary rows of the overlapping interiors across the gap, then erase the facing wall cells strictly between those rows.
 179:     - For a vertical selected gap, do the transposed operation with boundary columns and the facing top/bottom wall cells.
 180: 
 181:     Key insight
 182:     - The connector is determined by the overlap of the rooms' interiors, and longer redundant visible gaps are ignored once the shortest spanning network connects all frames.
 183:     """
 184:     g = np.asarray(grid, dtype=int)
 185:     bg = get_bg(g)
 186:     color, rects = _rectangles(g, bg)
 187:     edges = _candidate_edges(g, bg, rects)
 188:     chosen = _spanning_edges(edges, len(rects))
 189: 
 190:     out = g.copy()
 191:     for edge in chosen:
 192:         _apply_edge(out, bg, color, rects, edge)
 193: 
 194:     comps = find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[color])
 195:     assert len(comps) == 1
 196:     return out
