 114:     for _score, rid, (dr, dc), anchor, _sid in struct_best:
 115:         if int(rid) in used_red or anchor is None:
 116:             continue
 117:         used_red.add(int(rid))
 118:         assignments.append((int(rid), (int(dr), int(dc)), (int(anchor[0]), int(anchor[1]))))
