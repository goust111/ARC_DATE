 100:             rid_best = max(hits.keys(), key=lambda k: (int(hits[k][0]), -int(hits[k][1])))
 101:             cnt, mind, anchor = hits[rid_best]
 102:             cand = (int(cnt), -int(mind), int(rid_best), (int(dr), int(dc)), anchor)
 103:             if best is None or cand > best:
