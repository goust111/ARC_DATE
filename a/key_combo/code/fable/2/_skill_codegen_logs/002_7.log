        top+=1
        for r in range(top,bottom+1): coords.append((r,right))
        right-=1
        if top<=bottom:
            for c in range(right,left-1,-1): coords.append((bottom,c))
            bottom-=1
        if left<=right:
            for r in range(bottom,top-1,-1): coords.append((r,left))
            left+=1
    return coords

def ccw_spiral_coords(h,w):
    coords=[]; top=left=0; bottom=h-1; right=w-1
    while top<=bottom and left<=right:
        for r in range(top,bottom+1): coords.append((r,left))
        left+=1
        for c in range(left,right+1): coords.append((bottom,c))
        bottom-=1
        if left<=right:
            for r in range(bottom,top-1,-1): coords.append((r,right))
            right-=1
        if top<=bottom:
            for c in range(right,left-1,-1): coords.append((top,c))
            top+=1
    return coords

def row_coords(h,w): return [(r,c) for r in range(h) for c in range(w)]
def col_coords(h,w): return [(r,c) for c in range(w) for r in range(h)]

def visible_runs(seq):
    runs=[]; start=None
    for i,v in enumerate(seq):
        if v"'!=BLACK and start is None: start=i
        elif v==BLACK and start is not None: runs.append((start,list(seq[start:i]))); start=None
    if start is not None: runs.append((start,list(seq[start:])))
    return runs

def min_period(run):
    for p in range(1,len(run)+1):
        if all(run[i]==run[i-p] for i in range(p,len(run))): return p
    raise AssertionError

def infer_period(seq):
    candidates=sorted({min_period(run) for _,run in visible_runs(seq)})
    for p in candidates:
        colors=[None]*p
        ok=True
        for i,v in enumerate(seq):
            if v==BLACK: continue
            k=i%p
            if colors[k] is None: colors[k]=v
            elif colors[k]!=v: ok=False; break
        if ok and all(c is not None for c in colors): return p, colors
    raise AssertionError

def complete(grid, coords):
    seq=[int(grid[r,c]) for r,c in coords]
    p, colors=infer_period(seq)
    out=np.array(grid,copy=True)
    for i,(r,c) in enumerate(coords):
        if out[r,c]==BLACK: out[r,c]=colors[i%p]
    return out

def primitive_pattern(p):
    if random.random()<0.45:
        return random.sample(COLORS,p)
    for _ in range(500):
        palette=random.sample(COLORS, random.randint(2,min(5,p)))
        arr=[random.choice(palette) for _ in range(p)]
        if len(set(arr))<2: continue
        if all(not (p%q==0 and all(arr[i]==arr[i%q] for i in range(p))) for q in range(1,p)):
            return arr
    raise RuntimeError

def ring_depth(h,w,coord):
    r,c=coord
    return min(r,c,h-1-r,w-1-c)

def turn_count(coords):
    dirs=[]
    for (r0,c0),(r1,c1) in zip(coords,coords[1:]):
        dirs.append((r1-r0,c1-c0))
    return sum(d0!=d1 for d0,d1 in zip(dirs,dirs[1:]))

def choose_missing(coords,p):
    n=len(coords); h=max(r for r,_ in coords)+1; w=max(c for _,c in coords)+1
    max_missing=min(max(7,n//5),18)
    witness_len=random.randint(2*p, min(n-5, max(2*p,3*p+6)))
    if witness_len >= n: return None
    witness_start=random.randint(0,n-witness_len)
    vis=np.ones(n,dtype=bool)
    protected=np.zeros(n,dtype=bool); protected[witness_start:witness_start+witness_len]=True
    target_missing=random.randint(max(5,p//2+1), min(max_missing,n-witness_len))
    for _ in range(2000):
        if np.count_nonzero(~vis) >= target_missing: break
        span=random.choice([1,1,2,2,3,4])
        s=random.randint(0,n-span)
        if protected[s:s+span].any() or (~vis[s:s+span]).any(): continue
        vis[s:s+span]=False
    miss=np.flatnonzero(~vis)
    if miss.size<5: return None
    if len({i%p for i in miss})<min(3,p): return None
    if any(not np.any(vis[np.arange(r,n,p)]) for r in range(p)): return None
    if len(visible_runs([1 if x else 0 for x in vis])) < 3: return None
    if len({ring_depth(h,w,coords[i]) for i in miss}) < 2: return None
    witness_coords=coords[witness_start:witness_start+witness_len]
    if turn_count(witness_coords) < 2: return None
    return vis

ok=0; fails=[]
for _ in range(5000):
    h,w=random.randint(5,10), random.randint(5,12)
    if h*w<30: fails.append('"'small'); continue
    p=random.randint(3,min(8,max(3,(h*w)//4)))
