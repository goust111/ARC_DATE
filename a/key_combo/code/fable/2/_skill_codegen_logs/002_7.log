def choose_missing(n,p):
    max_gap=min(max(6, n//6), 18)
    witness_len=random.randint(2*p, min(n-max_gap, max(2*p, min(n-4, 3*p+6))))
    witness_start=random.randint(0,n-witness_len)
    vis=np.ones(n,dtype=bool)
