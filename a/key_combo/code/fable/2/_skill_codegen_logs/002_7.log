                                break
                            marker_cells.append((r, c))
                        elif in_bounds:
                            fill_cells.append((r, c))
                    if not ok:
                        break
                if not ok or not fill_cells:
                    continue

                marker_tuple = tuple(marker_cells)
                fill_set = frozenset(fill_cells)
                footprint = frozenset(marker_cells + fill_cells)

