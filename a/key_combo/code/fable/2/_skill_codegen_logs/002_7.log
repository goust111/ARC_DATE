+
+        visible, witness = sampled
+        inp = out.copy()
+        for idx, keep in enumerate(visible):
+            if not keep:
+                r, c = coords[idx]
+                inp[r, c] = BLACK
+
+        if _validate_sample(inp, out, period_len, coords, witness):
+            return inp
+
+    raise RuntimeError("failed to generate a valid spiral-period completion puzzle")

