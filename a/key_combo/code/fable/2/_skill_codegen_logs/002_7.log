+def _spiral_coords(h: int, w: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    top, left = 0, 0
+    bottom, right = h - 1, w - 1
+
+    while top <= bottom and left <= right:
+        for c in range(left, right + 1):
+            coords.append((top, c))
