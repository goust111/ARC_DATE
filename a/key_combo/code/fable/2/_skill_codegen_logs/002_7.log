    inp=out.copy()
    for i,(r,c) in enumerate(coords):
        if not vis[i]: inp[r,c]=0
    if not np.array_equal(complete(inp,coords), out): fails.append('wrong'); continue
    bad=False
    for alt in (row_coords(h,w), col_coords(h,w), ccw_spiral_coords(h,w)):
        try:
            if np.array_equal(complete(inp,alt), out): bad=True; break
        except Exception:
            pass
    if bad: fails.append('alt'); continue
    ok+=1
print('ok',ok,'fails',len(fails))
from collections import Counter
print(Counter(fails).most_common())
