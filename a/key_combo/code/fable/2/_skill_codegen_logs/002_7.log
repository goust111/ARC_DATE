def col_coords(h,w):
    return [(r,c) for c in range(w) for r in range(h)]

def visible_runs(seq):
    runs=[]; start=None
    for i,v in enumerate(seq):
        if v"'!=BLACK and start is None: start=i
        elif v==BLACK and start is not None:
            runs.append((start, seq[start:i].tolist()))
            start=None
    if start is not None: runs.append((start, seq[start:].tolist()))
    return runs

def min_period(run):
    L=len(run)
    for p in range(1,L+1):
        ok=True
        for i in range(p,L):
            if run[i]!=run[i-p]: ok=False; break
        if ok: return p
    raise AssertionError

def infer_period(seq):
    runs=visible_runs(seq)
    cand=[]
    for start, run in runs:
        if len(run)>=2:
            cand.append(min_period(run))
        elif len(run)==1:
            cand.append(1)
