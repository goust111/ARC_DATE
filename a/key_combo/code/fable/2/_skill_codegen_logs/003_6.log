    seen: set[Coord] = set()
    result: list[set[Coord]] = []
    for r in range(size):
        for c in range(size):
            if (r, c) in seen:
                continue
            orb = _orbit((r, c), size, margin)
            seen.update(orb)
            result.append(orb)
    return result


