+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if not (0 <= rr < height and 0 <= cc < width):
+                    continue
+                if band0 <= rr <= band1:
+                    continue
+                if occupied[rr, cc] and (rr, cc) not in coords:
+                    return False
+    return True
