+def _find_band(grid: np.ndarray) -> tuple[int, int, int]:
+    full_rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == grid[r, 0])]
+    candidates = [r for r in full_rows if int(grid[r, 0]) != int(get_bg(grid))]
