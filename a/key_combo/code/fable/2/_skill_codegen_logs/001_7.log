+    mask_coords = np.argwhere(patch != BG)
+    out = np.zeros(shape, dtype=bool)
+    for step in range(int(jumps) + 1):
+        rows = mask_coords[:, 0] + int(top) + step * dr
+        cols = mask_coords[:, 1] + int(left) + step * dc
+        out[rows, cols] = True
