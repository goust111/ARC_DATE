+) -> bool:
+    final_bbox = _shift_bbox(bbox, jumps, vector)
+    r0, c0, r1, c1 = map(int, final_bbox)
+    dr, dc = map(int, vector)
+    height, width = map(int, shape)
+    checks: list[bool] = []
+
+    if dr > 0:
+        gap = height - 1 - r1
+        checks.append(0 < gap < dr)
+    elif dr < 0:
+        gap = r0
+        checks.append(0 < gap < -dr)
+
+    if dc > 0:
+        gap = width - 1 - c1
+        checks.append(0 < gap < dc)
+    elif dc < 0:
+        gap = c0
+        checks.append(0 < gap < -dc)
