+            paste(expected, patch, dest_top, dest_left, transparent=BG)
+            reserved_dilated |= _dilate8(path)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    if not _scene_is_semantic(grid, expected):
+        return None
+    return grid, expected
+
+
