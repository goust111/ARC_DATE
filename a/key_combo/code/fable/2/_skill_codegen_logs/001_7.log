+        candidates.append((rr, cc, dr, dc, step))
+    return candidates
+
+
+def _grow_body_mask(height: int, width: int) -> np.ndarray:
+    area = int(height) * int(width)
+    lo = max(4, int(np.ceil(0.42 * area)))
+    hi = max(lo, int(np.ceil(0.78 * area)))
