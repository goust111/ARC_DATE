+            target = rebuilt[dest_top : dest_top + patch.shape[0], dest_left : dest_left + patch.shape[1]]
+            if np.any(target[patch != BG] != BG):
+                return False
+            paste(rebuilt, patch, dest_top, dest_left, transparent=BG)
