+
+def _instruction_candidates(
+    mask: np.ndarray,
+    category: str,
+    *,
+    min_step: int,
+) -> list[tuple[int, int, int, int, int]]:
+    center_r = mask.shape[0] // 2
+    center_c = mask.shape[1] // 2
