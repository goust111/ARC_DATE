+        rr = int(r)
+        cc = int(c)
+        dr = rr - center_r
+        dc = cc - center_c
+        if dr == 0 and dc == 0:
+            continue
+        if category == "horizontal" and dr != 0:
+            continue
+        if category == "vertical" and dc != 0:
