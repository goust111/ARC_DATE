+            r0, c0 = coord_arr.min(axis=0)
+            r1, c1 = coord_arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coord_arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(len(coords)),
+                }
+            )
+    return comps
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
