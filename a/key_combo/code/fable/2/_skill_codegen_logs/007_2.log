+
+SOURCE_BG = 0
+TARGET_BG = 1
+RED = 2
+DIVIDER = 4
+REMNANT = 5
+SPRITE_COLORS = (3, 6, 7, 8, 9)
+
+PANEL_H_RANGE = (12, 14)
