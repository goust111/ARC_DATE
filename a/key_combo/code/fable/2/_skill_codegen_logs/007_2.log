+
+SOURCE_BG = 0
+TARGET_BG = 1
+RED = 2
+DIVIDER = 4
+REMNANT = 5
+SPRITE_COLORS = (3, 6, 7, 8, 9)
+
+PANEL_H_RANGE = (12, 14)
+PANEL_W_RANGE = (12, 14)
+SPRITE_H_RANGE = (4, 7)
+SPRITE_W_RANGE = (4, 7)
+SPRITE_COUNT_CHOICES = (3, 4)
+REMNANT_COUNT_CHOICES = (2, 3)
+PLACEMENT_BORDER = 1
