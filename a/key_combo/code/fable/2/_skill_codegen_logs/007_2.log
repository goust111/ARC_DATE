+
+def _write_panel(dst: np.ndarray, box: tuple[int, int, int, int], panel: np.ndarray) -> None:
+    r0, c0, r1, c1 = box
+    assert panel.shape == (r1 - r0 + 1, c1 - c0 + 1)
