+            return np.hstack(
+                [
+                    source_panel,
+                    np.full((source_panel.shape[0], 1), DIVIDER, dtype=int),
+                    target_panel,
+                ]
+            )
+        return np.hstack(
+            [
+                target_panel,
+                np.full((source_panel.shape[0], 1), DIVIDER, dtype=int),
+                source_panel,
+            ]
+        )
+    if source_first:
+        return np.vstack(
+            [
+                source_panel,
+                np.full((1, source_panel.shape[1]), DIVIDER, dtype=int),
+                target_panel,
+            ]
+        )
+    return np.vstack(
+        [
+            target_panel,
+            np.full((1, source_panel.shape[1]), DIVIDER, dtype=int),
+            source_panel,
+        ]
+    )
+
+
+def _build_panels() -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    panel_h = random.randint(*PANEL_H_RANGE)
