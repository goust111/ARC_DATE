+
+def _apply_global_transform(inp: np.ndarray, out: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    choice = random.randrange(6)
+    if choice == 0:
+        return inp, out
+    if choice == 1:
+        return np.rot90(inp, 1).copy(), np.rot90(out, 1).copy()
+    if choice == 2:
+        return np.rot90(inp, 2).copy(), np.rot90(out, 2).copy()
+    if choice == 3:
