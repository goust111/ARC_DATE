    colors: tuple[int, int, int],
    canvas_shape: tuple[int, int],
) -> np.ndarray:
    bg, body_color, anchor_color = colors
    grid = np.full(canvas_shape, bg, dtype=int)
    for fragment, (top, left) in zip(fragments, positions):
        patch = np.full((h, w), bg, dtype=int)
        for r, c in fragment:
