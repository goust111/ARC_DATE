+def _stable_cells(cells: set[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    for cell in cells:
+        remainder = set(cells)
+        remainder.remove(cell)
+        if remainder and _is_connected(remainder, h, w):
+            out.append((int(cell[0]), int(cell[1])))
+    return out
+
