+    h, w = pattern.shape
+    ph, pw = patch.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return False
+    for dr, dc in np.argwhere(patch):
+        rr = top + int(dr)
+        cc = left + int(dc)
+        r0 = max(0, rr - 1)
+        c0 = max(0, cc - 1)
+        r1 = min(h, rr + 2)
+        c1 = min(w, cc + 2)
+        if np.any(pattern[r0:r1, c0:c1] != bg):
