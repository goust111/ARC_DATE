+    for k in (1, 2, 3):
+        if np.array_equal(pattern, np.rot90(pattern, k)):
+            return True
+    mirrored = np.fliplr(pattern)
+    for k in range(4):
+        if np.array_equal(pattern, np.rot90(mirrored, k)):
+            return True
+    return False
