+        return None
+
+    visibility = _sample_visibility(rng, base != bg)
+    if visibility is None:
+        return None
+
+    orientations = tuple(int(x) for x in rng.permutation(4))
+    grid, quadrants = _build_input_grid(base, visibility, orientations, bg, divider)
