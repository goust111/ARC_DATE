+    for r, c in coords:
+        count = int(rng.choice(VISIBLE_COUNT_OPTIONS, p=VISIBLE_COUNT_PROBS))
+        chosen = rng.choice(4, size=count, replace=False)
+        visibility[chosen, int(r), int(c)] = True
+        coverage[int(r), int(c)] = count
