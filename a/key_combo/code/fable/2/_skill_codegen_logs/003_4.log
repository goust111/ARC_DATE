+def _naive_union(quadrants: list[np.ndarray], bg: int) -> np.ndarray | None:
+    merged = np.full_like(quadrants[0], int(bg))
+    for quad in quadrants:
+        mask = quad != bg
+        conflict = mask & (merged != bg) & (merged != quad)
+        if np.any(conflict):
+            return None
+        merged[mask] = quad[mask]
+    return merged
