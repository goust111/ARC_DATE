+    bg: int,
+    divider: int,
+) -> bool:
+    candidates = _candidate_solutions(grid)
+    if len(candidates) != 4:
+        return False
+    outputs = [item[2] for item in candidates]
+    if not all(np.array_equal(outputs[0], out) for out in outputs[1:]):
+        return False
