+    for color in colors:
+        placed = False
+        for _ in range(120):
+            box_h = int(rng.integers(COMPONENT_BOX_MIN, min(COMPONENT_BOX_MAX, n - 1) + 1))
+            box_w = int(rng.integers(COMPONENT_BOX_MIN, min(COMPONENT_BOX_MAX, n - 1) + 1))
