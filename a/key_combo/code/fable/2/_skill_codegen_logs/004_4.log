+    out = np.full((h, w), bg, dtype=int)
+    inp[0, :] = stripe_color
+    out[0, :] = stripe_color
+    for spec in specs:
+        _paint_mask(inp, spec["mask"], spec["input_r"], spec["final_c"], spec["color"], bg)
