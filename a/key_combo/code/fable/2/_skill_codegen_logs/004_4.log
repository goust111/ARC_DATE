+
+def _overlaps(occ: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > occ.shape[0] or c0 + w > occ.shape[1]:
+        return True
+    return bool((occ[r0 : r0 + h, c0 : c0 + w] & mask).any())
