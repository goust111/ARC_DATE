+    _stamp_occ(final_occ, anchor_mask, anchor_final_r, anchor_c)
+    _stamp_occ(input_occ, anchor_mask, anchor_input_r, anchor_c)
+    _stamp_occ(lane_final_occ, anchor_mask, anchor_final_r, anchor_c)
