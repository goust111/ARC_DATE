+
+def _detect_stripe(g: np.ndarray, bg: int) -> tuple[str, int]:
+    h, w = g.shape
+    candidates: list[tuple[str, int]] = []
+    if int(g[0, 0]) != bg and np.all(g[0, :] == g[0, 0]):
