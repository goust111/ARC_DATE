+                    for shift in shifts:
+                        input_r = final_r + shift
+                        if input_r + mask.shape[0] > h:
+                            continue
+                        if input_r in used_front_rows:
+                            continue
+                        if not _fits(input_occ, mask, input_r, final_c):
