DIAGONAL_DIRECTIONS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
CARDINAL_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))
CARDINAL_PATTERN = (Color.TEAL, Color.TEAL, Color.YELLOW)

# Validation retry limit.
GEN_RETRY_LIMIT = 300


def _gen_expected_output(inp: np.ndarray) -> np.ndarray:
    out = inp.copy()
    h, w = out.shape
