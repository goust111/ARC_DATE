+def _column_options(ranges: list[tuple[int, int]], width: int) -> list[int]:
+    cols: list[int] = []
+    for c0, c1 in ranges:
+        for c in range(c0, c1 - width + 2):
+            cols.append(c)
+    random.shuffle(cols)
+    return cols
+
