+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        try:
+            inp, expected = _build_instance()
+        except RuntimeError:
+            continue
+        if _validate_generated(inp, expected):
+            return inp
