+                        specs.append(
+                            {
+                                "mask": mask,
+                                "color": next(color_iter),
+                                "final_r": final_r,
+                                "final_c": final_c,
+                                "input_r": input_r,
+                                "status": target_status,
+                            }
+                        )
+                        _stamp_occ(final_occ, mask, final_r, final_c)
+                        _stamp_occ(input_occ, mask, input_r, final_c)
+                        used_front_rows.add(input_r)
