+                        specs.append(
+                            {
+                                "mask": mask,
+                                "color": next(color_iter),
+                                "final_r": final_r,
+                                "final_c": final_c,
+                                "input_r": input_r,
+                                "status": target_status,
+                            }
+                        )
+                        _stamp_occ(final_occ, mask, final_r, final_c)
