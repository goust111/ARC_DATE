+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg, side, stripe_color, objects = _parse_scene(g)
+    dr, dc = _movement(side)
+    out, occupied = _init_output(g.shape, bg, side, stripe_color)
