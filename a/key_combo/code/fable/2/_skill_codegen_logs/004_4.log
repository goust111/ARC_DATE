+        out[0, :] = int(stripe_color)
+        occ[0, :] = True
+    elif side == "bottom":
+        out[-1, :] = int(stripe_color)
+        occ[-1, :] = True
+    elif side == "left":
+        out[:, 0] = int(stripe_color)
+        occ[:, 0] = True
+    else:
+        out[:, -1] = int(stripe_color)
+        occ[:, -1] = True
