                out[dst_r, c0 : c1 + 1] = g[src_r, c0 : c1 + 1]
        else:
            source_side = _single_side({-1 if c < axis else 1 for _, c in yellow if c != axis})
            cols = range(c0, axis) if source_side < 0 else range(axis + 1, c1 + 1)
            for src_c in cols:
