+from arc_utils import Color, bbox_coords, colors_present, crop_bbox, find_components, get_bg, paste
+
+
+OPS = ("rot90", "rot180", "flip_ud", "flip_lr")
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GRID_LIMIT = 30
+GEN_ATTEMPTS = 300
+OUTER_MARGIN = 1
+PLACEMENT_GAP = 1
+BG_COLOR = Color.BLACK
