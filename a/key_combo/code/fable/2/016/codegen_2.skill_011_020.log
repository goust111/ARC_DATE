+
+def _block_area(blocked: np.ndarray, r0: int, c0: int, h: int, w: int, gap: int) -> None:
+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(blocked.shape[0], r0 + h + gap)
+    cc1 = min(blocked.shape[1], c0 + w + gap)
+    blocked[rr0:rr1, cc0:cc1] = True
