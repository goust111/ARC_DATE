+def _random_polyomino(
+    rng: np.random.Generator,
+    *,
+    size_range: tuple[int, int],
+    max_height: int,
+    max_width: int,
+    require_non_square: bool,
+) -> np.ndarray:
+    lo, hi = size_range
+    for _ in range(200):
+        size = int(rng.integers(lo, hi + 1))
+        cells = {(0, 0)}
+        while len(cells) < size:
