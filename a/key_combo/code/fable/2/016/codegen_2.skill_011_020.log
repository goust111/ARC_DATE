+    meta = {
+        "divider_color": int(divider_color),
+        "divider_r": int(divider_r),
+        "divider_c": int(divider_c),
+        "color_to_op": dict(color_to_op),
+        "legend_canons": set(legend_canons),
+        "queries": queries_meta,
+        "shared_canon": shared_canon,
