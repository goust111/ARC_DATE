+
+        residue_pos = _find_location(occupied, spec["residue_full_mask"].shape)
+        if residue_pos is None:
+            return None
+        rr, rc = residue_pos
+        occupied[rr : rr + spec["residue_full_mask"].shape[0], rc : rc + spec["residue_full_mask"].shape[1]] = True
