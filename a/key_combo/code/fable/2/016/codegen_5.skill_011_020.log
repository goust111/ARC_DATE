+        sr0, sc0, sr1, sc1 = _mask_bbox(survivor_full)
+        shifted = sr0 > 0 or sc0 > 0
+        if require_shift != shifted:
+            continue
+        residue_crop = survivor_full[sr0 : sr1 + 1, sc0 : sc1 + 1].copy()
+        placements = _find_embeddings(template_display_mask, residue_crop)
