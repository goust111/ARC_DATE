+            continue
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        mask = _tight_crop_mask(mask)
+        if min(mask.shape) < 3:
+            continue
+        if not _is_connected(mask):
