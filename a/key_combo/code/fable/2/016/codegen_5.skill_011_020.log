+        for c0 in range(w):
+            color = int(g[r0, c0])
+            if color == bg or seen[r0, c0]:
+                continue
+            queue = deque([(r0, c0)])
+            seen[r0, c0] = True
+            cells: list[Coord] = []
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                for nr, nc in _neighbors4(r, c):
