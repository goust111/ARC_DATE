+    side_groups = []
+    top_cells = {(r, c) for r, c in coords if r == 0}
+    left_cells = {(r, c) for r, c in coords if c == 0}
+    if 1 <= len(top_cells) <= max_remove:
+        side_groups.append(top_cells)
+    if 1 <= len(left_cells) <= max_remove:
