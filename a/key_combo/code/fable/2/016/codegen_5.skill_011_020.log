+
+def _pick_residue(
+    template_display_mask: np.ndarray,
+    residue_full_mask: np.ndarray,
+    *,
+    require_shift: bool,
+) -> tuple[np.ndarray, np.ndarray]:
+    full = np.asarray(residue_full_mask, dtype=bool)
+    fh, fw = full.shape
