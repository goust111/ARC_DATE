+GEN_BG = 0
+GEN_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GEN_PAIR_COUNT_RANGE = (2, 3)
+GEN_GRID_RANGES = {2: ((18, 24), (18, 24)), 3: ((23, 30), (23, 30))}
+GEN_SHAPE_BBOX_RANGE = (3, 6)
+GEN_SHAPE_AREA_RANGE = (7, 11)
