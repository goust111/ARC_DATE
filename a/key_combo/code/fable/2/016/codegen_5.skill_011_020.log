+            bbox = _bbox_coords(coords)
+            bh = bbox[2] - bbox[0] + 1
+            bw = bbox[3] - bbox[1] + 1
+            mask = np.zeros((bh, bw), dtype=bool)
+            mask[coords[:, 0] - bbox[0], coords[:, 1] - bbox[1]] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "area": int(coords.shape[0]),
+                    "mask": mask,
+                }
