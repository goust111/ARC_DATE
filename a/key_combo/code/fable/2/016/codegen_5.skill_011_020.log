+        full_c0 = int(bbox[1]) - int(dc)
+        assert 0 <= full_r0 <= out.shape[0] - fh, "completed residue must stay in bounds"
+        assert 0 <= full_c0 <= out.shape[1] - fw, "completed residue must stay in bounds"
