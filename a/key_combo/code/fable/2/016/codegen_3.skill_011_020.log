        if c < ec:
            steps.append((r, c + 1))
        elif c > ec:
            steps.append((r, c - 1))
        r, c = random.choice(steps)
        mask[r, c] = True


def _frontier_coords(mask):
    """Return empty cells 4-adjacent to the mask in row-major order."""
    adjacent = np.zeros_like(mask, dtype=bool)
    adjacent[1:, :] |= mask[:-1, :]
    adjacent[:-1, :] |= mask[1:, :]
    adjacent[:, 1:] |= mask[:, :-1]
    adjacent[:, :-1] |= mask[:, 1:]
    return np.argwhere(adjacent & ~mask)



