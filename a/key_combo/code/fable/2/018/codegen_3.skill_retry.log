+                "start": int(start),
+                "end": int(end),
+                "input_seq": list(teacher_seq[start : end + 1]),
+                "grow_colors": list(teacher_seq[end + 1 :]),
+                "inner_h": random.randint(1, 2),
+                "inner_w": random.randint(1, 2),
