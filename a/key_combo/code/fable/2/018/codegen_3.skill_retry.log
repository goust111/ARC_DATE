+def _sequence_match_indices(chain: list[int], seq: list[int]) -> list[int]:
+    matches = []
+    for start in range(len(chain) - len(seq) + 1):
+        if chain[start : start + len(seq)] == seq:
+            matches.append(start)
+    return matches
