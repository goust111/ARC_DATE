+    for _ in range(PLACEMENT_TRIES):
+        r0 = random.randint(r_lo, r_hi)
+        c0 = random.randint(c_lo, c_hi)
+        bbox = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
