+    out = g.copy()
+    for obj in objects:
+        if obj is teacher:
+            continue
+
+        seq = list(obj["seq"])
+        matches = _sequence_match_indices(teacher_seq, seq)
+        assert len(matches) == 1, "each seed sequence must align uniquely inside the teacher chain"
+        start = matches[0]
+        end = start + len(seq) - 1
+
+        growth_colors: list[int] = []
+        cur = int(seq[-1])
+        while True:
+            nxt = int(transition[cur])
