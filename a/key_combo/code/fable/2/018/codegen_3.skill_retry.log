+def _place_full_bbox(
+    box_h: int,
+    box_w: int,
+    grid_h: int,
+    grid_w: int,
+    placed: list[tuple[int, int, int, int]],
+    *,
+    prefer_interior: bool,
+) -> tuple[int, int, int, int] | None:
