+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    bg = int(get_bg(grid))
+    objects = []
+    for comp in find_components(grid, bg=bg, connectivity=4, monochromatic=False):
+        sub = crop_bbox(grid, comp["bbox"])
+        seq = _parse_nest(sub, bg)
