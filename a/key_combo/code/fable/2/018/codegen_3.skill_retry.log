+        final_len = len(teacher_seq) - int(spec["start"])
+        spec["final_h"] = int(spec["inner_h"] + 2 * (final_len - 1))
+        spec["final_w"] = int(spec["inner_w"] + 2 * (final_len - 1))
+        spec["grow_count"] = len(spec["grow_colors"])
