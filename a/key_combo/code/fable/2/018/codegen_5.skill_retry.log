+    for goal in [(h - 1, random.randint(1, w - 1)), (random.randint(1, h - 1), w - 1)]:
+        gr, gc = goal
+        if mask[gr, gc]:
+            continue
+        rr, cc = 1, 1
+        while rr != gr or cc != gc:
+            step_options = []
+            if rr < gr:
+                step_options.append((rr + 1, cc))
+            elif rr > gr:
+                step_options.append((rr - 1, cc))
+            if cc < gc:
+                step_options.append((rr, cc + 1))
+            elif cc > gc:
+                step_options.append((rr, cc - 1))
+            rr, cc = random.choice(step_options)
