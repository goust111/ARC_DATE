+        key_r, key_c = variant["key_pos"]
+        anchor = (spec["bbox"][0] + key_r, spec["bbox"][1] + key_c)
+        pointer = (anchor[0] + variant["dir"][0], anchor[1] + variant["dir"][1])
+        used.add(anchor)
