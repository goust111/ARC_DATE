+        if abs(r1 - r2) != 1 or abs(c1 - c2) != 1:
+            continue
+        colors = [int(grid[r1, c1]), int(grid[r2, c2])]
+        if Counter(colors) != Counter({key_color: 1, body_color: 1}):
+            continue
+        if int(grid[r1, c1]) == key_color:
+            anchor, pointer = (r1, c1), (r2, c2)
