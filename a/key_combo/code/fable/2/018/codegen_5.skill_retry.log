+    assert len(candidates) == 1, f"expected one template, found {len(candidates)}"
+    return candidates[0]
+
+
+def _find_markers(grid: np.ndarray, bg: int, key_color: int, body_color: int) -> list[dict]:
+    markers = []
+    for coords in _components(grid != bg, connectivity=8):
