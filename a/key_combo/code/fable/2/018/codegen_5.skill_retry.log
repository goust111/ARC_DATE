+        if len(singleton_colors) != 1:
+            continue
+        key_color = int(singleton_colors[0])
+        body_color = int(next(color for color in counts if color != key_color))
+        key_global = tuple(map(int, coords[np.array(colors) == key_color][0]))
+        r0, c0, r1, c1 = bbox
