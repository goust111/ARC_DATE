+        kr, kc = variant["key_pos"]
+        dr, dc = variant["dir"]
+        anchor = (bbox[0] + kr, bbox[1] + kc)
+        pointer = (anchor[0] + dr, anchor[1] + dc)
+        if int(variant["grid"][kr + dr, kc + dc]) != body_color:
