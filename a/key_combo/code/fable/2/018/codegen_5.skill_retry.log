+            anchor, pointer = (r2, c2), (r1, c1)
+        markers.append(
+            {
+                "anchor": anchor,
+                "direction": (pointer[0] - anchor[0], pointer[1] - anchor[1]),
+            }
+        )
+    markers.sort(key=lambda item: (item["anchor"][0], item["anchor"][1]))
