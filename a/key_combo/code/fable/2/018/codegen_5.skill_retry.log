+            {
+                "grid": rotated,
+                "key_pos": key_pos,
+                "dir": _corner_dir(key_pos, rotated.shape),
+            }
+        )
+    return out
+
+
+def _find_template(grid: np.ndarray, bg: int) -> dict:
+    candidates = []
+    for coords in _components(grid != bg, connectivity=8):
