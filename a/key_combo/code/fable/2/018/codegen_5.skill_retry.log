+def _corner_dir(key_pos: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int]:
+    kr, kc = key_pos
+    h, w = shape
+    assert kr in (0, h - 1) and kc in (0, w - 1)
+    return (1 if kr == 0 else -1, 1 if kc == 0 else -1)
