+def _paste_non_bg(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != bg
+    view[mask] = patch[mask]
