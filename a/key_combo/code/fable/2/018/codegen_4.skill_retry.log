+    branch = random.choice([False, True])
+
+    source_cell = (anchor_r + 1, anchor_c)
+    first_relay_cell = (anchor_r + 1, anchor_c + 1)
+    second_relay_cell = (anchor_r if turn_up else anchor_r + 2, anchor_c + 1)
