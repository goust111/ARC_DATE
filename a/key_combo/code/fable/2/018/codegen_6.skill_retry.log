+        outside_input = int(np.count_nonzero(inp == minority)) - sum(int(inp[r, c] == minority) for r, c in orbit)
+        outside_clean = int(np.count_nonzero(clean == minority)) - sum(int(clean[r, c] == minority) for r, c in orbit)
