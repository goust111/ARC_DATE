def detect_translational_symmetry(
    grid: np.ndarray,
    ignore_colors: list[int] | None = None,
    background: int | None = None,
) -> list[Symmetry]:
    """Detect translational symmetries using a scoring heuristic."""
    if ignore_colors is None:
        ignore_colors = [Color.BLACK]
