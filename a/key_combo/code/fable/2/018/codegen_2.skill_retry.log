+            continue
+
+        tile_h = random.randint(4, max_h)
+        tile_w = random.randint(4, max_w)
+        tile_area = tile_h * tile_w
+        max_sprite_area = min(tile_area // 2, 2 * rows + 3)
+        if max_sprite_area < rows:
+            continue
