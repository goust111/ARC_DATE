+    used: set[int] = set()
+    cur: dict[int, tuple[int, int]] = {}
+
+    def dfs(depth: int) -> None:
+        if len(solutions) > 1:
+            return
+        if depth == len(order):
+            solutions.append(cur.copy())
+            return
+        hi = order[depth]
+        for pi, factor in candidates[hi]:
+            if pi in used:
+                continue
+            used.add(pi)
+            cur[hi] = (pi, factor)
+            dfs(depth + 1)
+            cur.pop(hi, None)
+            used.remove(pi)
