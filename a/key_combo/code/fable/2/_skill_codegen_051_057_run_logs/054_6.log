+    rect_bbox, holes = _extract_rect_and_holes(g)
+    assert rect_bbox is not None
+    assert holes, "expected at least one hole"
+    pieces = _extract_pieces(g)
+    assignment, _ = _unique_assignment(pieces, holes)
