+
+def _normalize_shape(coords: list[tuple[int, int]] | np.ndarray) -> tuple[tuple[int, int], ...]:
+    arr = np.array(coords, dtype=int)
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    items = sorted((int(r), int(c)) for r, c in arr.tolist())
