+def _apply_rule(grid: np.ndarray, turn_selector, *, strict: bool) -> np.ndarray | None:
+    g, bg, _anchor, anchor_coords, anchor_top, sprites = _parse_scene(grid)
+    H, W = g.shape
+    out = g.copy()
+
+    for comp in sprites:
+        out[tuple(comp["coords"].T)] = bg
