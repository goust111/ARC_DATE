9:def main(grid: np.ndarray) -> np.ndarray:
10-    """Flood-fill black background regions connected to original blue pixels, turning them blue while leaving blockers unchanged.
11-
12-    Input structure:
13-    - A rectangular grid has black background cells, one or more blue seed pixels, and other non-black colors acting as blockers.
14-    Rule:
15-    - Starting from every original blue pixel, traverse 4-neighbor black cells and recolor each reached black cell blue.
16-    - Leave every non-black pixel unchanged.
17-    Key insight:
18-    - Black cells remain black exactly when no orthogonal path of black cells connects them to an original blue seed.
19-    """
20-    g = np.asarray(grid, dtype=int)
21-    assert g.ndim == 2
22-    assert get_bg(g) == Color.BLACK
23-
24-    seeds = [tuple(map(int, rc)) for rc in np.argwhere(g == Color.BLUE)]
25-    assert seeds
26-
27-    out = g.copy()
28-    seen = np.zeros(g.shape, dtype=bool)
29-    q: deque[tuple[int, int]] = deque()
30-    for r, c in seeds:
31-        seen[r, c] = True
32-        q.append((r, c))
33-
34-    while q:
35-        r, c = q.popleft()
36-        for rr, cc in neighbors4(r, c):
37-            if not in_bounds(g.shape, rr, cc) or seen[rr, cc] or g[rr, cc] != Color.BLACK:
38-                continue
39-            seen[rr, cc] = True
40-            out[rr, cc] = Color.BLUE
41-            q.append((rr, cc))
42-
43-    return out
