+def _shape_cell_distances(coords: set[tuple[int, int]], anchor_coords: list[tuple[int, int]]) -> set[int]:
+    return {
+        _min_anchor_distance([(int(r), int(c))], anchor_coords, metric="chebyshev")
+        for r, c in coords
+    }
