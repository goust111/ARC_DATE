+                if strict:
+                    raise AssertionError("rotated sprite left the grid")
+                return None
+            if strict:
+                assert (rr, cc) not in written, "rotated sprites must not overlap"
+            out[rr, cc] = int(comp["color"])
+            written.add((rr, cc))
+    return out
+
