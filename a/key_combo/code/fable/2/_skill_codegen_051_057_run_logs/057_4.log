+def _parse_scene(grid: np.ndarray) -> tuple[np.ndarray, int, dict, list[tuple[int, int]], tuple[int, int], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
