+    while int(mask.sum()) < target_area:
+        frontier = []
+        seen = set()
+        for r, c in np.argwhere(mask):
+            rr, cc = int(r), int(c)
+            for nr, nc in _neighbors4(rr, cc, side):
+                if mask[nr, nc] or (nr, nc) in seen:
