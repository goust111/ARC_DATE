+    cells = {(0, 0)}
+    while len(cells) < target_size:
+        frontier = []
+        for dr, dc in cells:
+            for step_r, step_c in FOUR_NEIGHBORS:
+                nxt = (dr + step_r, dc + step_c)
+                if nxt in component and nxt not in cells:
