+def _paint_transformed(
+    source_region: np.ndarray,
+    src_fill: int,
+    src_marker: tuple[int, int],
+    dst_shape: tuple[int, int],
+    dst_fill: int,
+    dst_marker: tuple[int, int],
+    axis: str,
+) -> np.ndarray:
