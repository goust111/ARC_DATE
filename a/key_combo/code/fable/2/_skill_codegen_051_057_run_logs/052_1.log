+        if np.array_equal(naive, clean):
+            return False
+        mismatched = False
+        for r, c in np.argwhere(inp == noise):
+            if int(clean[int(r), int(c)]) != int(naive[int(r), int(c)]):
+                mismatched = True
+                break
+        if not mismatched:
+            return False
