+def _naive_pixel_mirror_restore(grid: np.ndarray, noise: int) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    width = g.shape[1]
+    for r, c in np.argwhere(g == int(noise)):
+        out[int(r), int(c)] = g[int(r), width - 1 - int(c)]
+    return out
+
