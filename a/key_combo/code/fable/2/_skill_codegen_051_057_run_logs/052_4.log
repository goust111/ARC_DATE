   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Connect the innermost mirrored marker pair(s) by filling their horizontal span.
  12: 
  13:     Input structure
  14:     - The grid has one background color and one foreground color.
  15:     - Each foreground row contains exactly two foreground pixels mirrored across the vertical center.
  16: 
  17:     Rule
  18:     - Find the foreground row pair(s) with the smallest horizontal gap between the two markers.
  19:     - Fill every pixel between those two markers in each selected row with the foreground color.
  20:     - Leave all other pixels unchanged.
  21: 
  22:     Key insight
  23:     - Wider marker pairs are context; the closest marker pair(s) show the unresolved horizontal segment.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     bg = get_bg(g)
  27:     foreground = colors_present(g, exclude={bg})
  28:     assert len(foreground) == 1, "expected exactly one foreground color"
  29:     color = foreground[0]
  30: 
  31:     pairs = []
  32:     w = g.shape[1]
  33:     for r, row in enumerate(g):
  34:         cols = np.flatnonzero(row == color)
  35:         assert len(cols) in (0, 2), "foreground rows must contain exactly two markers"
  36:         if len(cols) == 2:
  37:             c0, c1 = map(int, cols)
  38:             assert c0 + c1 == w - 1, "marker pairs must be horizontally mirrored"
  39:             pairs.append((c1 - c0, r, c0, c1))
  40: 
  41:     assert pairs, "expected at least one foreground marker pair"
  42:     min_gap = min(gap for gap, _r, _c0, _c1 in pairs)
  43: 
  44:     out = g.copy()
  45:     for gap, r, c0, c1 in pairs:
  46:         if gap == min_gap:
  47:             out[r, c0 : c1 + 1] = color
  48:     return out
