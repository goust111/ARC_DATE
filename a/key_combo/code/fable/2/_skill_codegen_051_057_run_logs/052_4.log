  33: def main(grid: np.ndarray) -> np.ndarray:
  34:     """
  35:     Complete a rectangular table of identical sprites by stamping teal copies at the empty row-column intersections.
  36: 
  37:     Input structure
  38:     - A black background contains one foreground color forming identical connected sprites.
  39:     - The sprites sit on a rectangular row/column lattice.
  40:     - The occupied lattice slots include at least one complete row and at least one complete column.
  41: 
  42:     Rule
  43:     - Find the common sprite mask and the top-left position of every existing sprite.
  44:     - Use the existing sprite row starts and column starts as the table lattice.
  45:     - Preserve existing sprites and paste a teal copy of the same mask into every unoccupied lattice slot.
  46: 
  47:     Key insight
  48:     The present sprites are the row and column headers of a table; the missing Cartesian-product slots are the cells to fill.
  49:     """
  50:     g = np.asarray(grid, dtype=int)
  51:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
  52: 
  53:     bg = int(get_bg(g))
  54:     sprites = _instances(g, bg)
  55:     rows = sorted({int(r) for r, _c, _mask in sprites})
  56:     cols = sorted({int(c) for _r, c, _mask in sprites})
  57:     assert len(rows) >= 2 and len(cols) >= 2, "expected a row-column sprite lattice"
  58: 
  59:     occupied = {(int(r), int(c)) for r, c, _mask in sprites}
  60:     assert len(occupied) == len(sprites), "sprite top-left positions must be unique"
  61:     assert any(all((r, c) in occupied for c in cols) for r in rows), "expected a complete sprite row"
  62:     assert any(all((r, c) in occupied for r in rows) for c in cols), "expected a complete sprite column"
  63: 
  64:     sprite_mask = sprites[0][2]
  65:     h, w = map(int, sprite_mask.shape)
  66:     fill_patch = np.full((h, w), bg, dtype=int)
  67:     fill_patch[sprite_mask] = Color.TEAL
