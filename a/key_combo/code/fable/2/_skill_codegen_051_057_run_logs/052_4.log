  51:         _b = bbox(frame != Color.BLACK)
  52:         assert _b is not None
  53:         cropped_frame = crop_bbox(frame, _b)
  54:         framework.append({"x": r, "y": c, "w": w, "h": h, "frame": cropped_frame})
  55:         # Place the frame in the output grid
