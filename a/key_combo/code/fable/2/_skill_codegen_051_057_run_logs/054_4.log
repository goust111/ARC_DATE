+        if mask is None:
+            continue
+
+        interior, boundary = _interior_boundary_masks(mask)
+        color_a, color_b = _choose_two_colors(rng)
+        fill_color = color_a if int(rng.integers(0, 2)) == 0 else color_b
+        other_color = color_b if fill_color == color_a else color_a
+
