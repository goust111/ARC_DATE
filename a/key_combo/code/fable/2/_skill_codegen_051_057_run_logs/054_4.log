+def _winner_from_counts(counts: Counter[int]) -> int:
+    if not counts:
+        return BACKGROUND
+    best = max(counts.values())
+    winners = [color for color, count in counts.items() if count == best]
+    return int(winners[0]) if len(winners) == 1 else GRAY
