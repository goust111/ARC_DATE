+    colors = sorted(set(int(v) for v in grid[comp_mask]) - {BACKGROUND})
+    boundary_counts = _count_values(grid[boundary])
+    total_counts = _count_values(grid[comp_mask])
+    bbox_counts = _count_values(local_grid[bbox_ring])
