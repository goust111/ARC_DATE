+
+BACKGROUND = 0
+GRAY = 5
+INPUT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+OFFSETS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+OFFSETS8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
+MAX_GENERATION_ATTEMPTS = 400
+MAX_MASK_ATTEMPTS = 120
+MAX_PLACEMENT_ATTEMPTS = 120
