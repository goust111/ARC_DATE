+    if tr < br0:
+        return "up"
+    if tr > br1:
+        return "down"
+    raise AssertionError("tip must lie outside the body bbox along one cardinal axis")
+
+
+def _stamp_arrow(
+    grid: np.ndarray,
+    anchor: tuple[int, int],
+    direction: str,
