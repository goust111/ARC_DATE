+    if _minimal_row_period(motif) != pr or _minimal_col_period(motif) != pc:
+        return None
+
+    min_band = max(4, pc + 2)
+    widths = (
+        rng.randint(min_band, min_band + 3),
+        rng.randint(min_band, min_band + 3),
+        rng.randint(min_band, min_band + 3),
+    )
+    width = sum(widths)
+    if width > 28:
+        return None
+
+    height = rng.randint(max(8, 2 * pr + 2), min(18, 5 * pr + 4))
+    if height > 30:
+        return None
+
+    d1 = rng.randint(1, pr - 1)
+    d2 = rng.randint(1, pr - 1)
