+        coords = np.argwhere(grid == int(color))
+        if coords.size == 0:
+            continue
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        area = h * w
+        if h < 2 or w < 2:
+            continue
+        if area != len(coords):
+            continue
+        cand = (area, h, w, r0, c0, int(color))
+        if best is None or cand > best:
+            best = cand
