+    prefix = np.zeros((pr, w + 1, pr, pc, 10), dtype=np.int16)
+    for off in range(pr):
+        shifted = np.roll(col_counts, shift=off, axis=1)
+        for c in range(w):
+            prefix[off, c + 1] = prefix[off, c]
+            prefix[off, c + 1, :, c % pc, :] += shifted[c]
