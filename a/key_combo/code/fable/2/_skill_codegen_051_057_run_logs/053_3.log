+    area, h, w, r0, c0, color = best
+    mask = np.zeros_like(grid, dtype=bool)
+    mask[r0 : r0 + h, c0 : c0 + w] = True
+    return {
+        "color": int(color),
+        "bbox": (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)),
+        "mask": mask,
+        "area": int(area),
+    }
