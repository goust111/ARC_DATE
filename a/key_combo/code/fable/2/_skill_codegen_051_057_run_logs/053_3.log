   101	def _build_prefix(grid: np.ndarray, visible: np.ndarray, pr: int, pc: int) -> np.ndarray:
   102	    h, w = grid.shape
   103	    col_counts = np.zeros((w, pr, 10), dtype=np.int16)
   104	    coords = np.argwhere(visible)
   105	    for r, c in coords:
   106	        col_counts[int(c), int(r % pr), int(grid[r, c])] += 1
   107	
   108	    prefix = np.zeros((pr, w + 1, pr, pc, 10), dtype=np.int16)
   109	    for off in range(pr):
   110	        shifted = np.roll(col_counts, shift=off, axis=1)
   111	        for c in range(w):
   112	            prefix[off, c + 1] = prefix[off, c]
   113	            prefix[off, c + 1, :, c % pc, :] += shifted[c]
   114	    return prefix
