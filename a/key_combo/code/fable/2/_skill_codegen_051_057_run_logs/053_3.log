+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    branch = _GEN_CALL_COUNT % 3
+    _GEN_CALL_COUNT += 1
+    for _ in range(_GEN_MAX_ATTEMPTS):
