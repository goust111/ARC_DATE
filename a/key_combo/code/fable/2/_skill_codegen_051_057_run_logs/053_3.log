   387	def _gen_attempt(branch: int) -> np.ndarray | None:
   388	    rng = random.Random(random.randrange(1 << 30))
   389	
   390	    pr = rng.randint(2, 5)
   391	    pc = rng.randint(2, 5)
   392	    palette = list(range(10))
   393	    rng.shuffle(palette)
   394	    motif_colors = palette[: rng.randint(3, 5)]
   395	    spare_colors = palette[len(motif_colors) :]
   396	    if len(spare_colors) < 3:
   397	        return None
   398	
   399	    motif = rng.choices(motif_colors, k=pr * pc)
   400	    motif = np.asarray(motif, dtype=int).reshape(pr, pc)
