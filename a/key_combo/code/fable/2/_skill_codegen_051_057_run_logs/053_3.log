+def _period_candidates(grid: np.ndarray, blocked: np.ndarray, axis: int) -> list[int]:
+    dim = grid.shape[axis]
+    max_p = min(_MAX_PERIOD, dim - 1)
+    if max_p < 2:
+        return []
