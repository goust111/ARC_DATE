   427	    occ_r0, occ_c0, occ_r1, occ_c1 = _choose_occluder(height, widths, pr, branch, rng)
   428	    occ_mask = np.zeros_like(clean, dtype=bool)
   429	    occ_mask[occ_r0 : occ_r1 + 1, occ_c0 : occ_c1 + 1] = True
   430	
   431	    reserved = occ_mask.copy()
   432	    distractor_count = 1 + ((branch + _GEN_CALL_COUNT) % 2)
   433	    if not _try_place_distractors(clean, reserved, distractor_colors, rng, distractor_count):
