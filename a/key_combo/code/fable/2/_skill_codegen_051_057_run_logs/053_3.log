+            total = int(mask.sum())
+            if total == 0:
+                continue
+            matches = int(np.count_nonzero((grid[:-p, :] == grid[p:, :]) & mask))
+        else:
+            mask = ~blocked[:, :-p] & ~blocked[:, p:]
+            total = int(mask.sum())
+            if total == 0:
+                continue
+            matches = int(np.count_nonzero((grid[:, :-p] == grid[:, p:]) & mask))
+        ratio = matches / total
+        items.append((ratio, matches, p))
+    items.sort(key=lambda x: (x[0], x[1], -x[2]), reverse=True)
+    if not items:
+        return list(range(2, max_p + 1))
