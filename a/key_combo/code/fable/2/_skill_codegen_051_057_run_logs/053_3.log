+
+    inp = clean.copy()
+    inp[occ_mask] = int(occ_color)
+    out = clean.copy()
+
+    b1 = widths[0]
+    b2 = widths[0] + widths[1]
+    if not _phase_coverage(inp.shape, occ_mask, pr, pc, b1, b2, offsets).all():
