+    global _GEN_CALL_COUNT
+    branch = _GEN_CALL_COUNT % 3
+    _GEN_CALL_COUNT += 1
+    for _ in range(_GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt(branch)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid multi-fault repair input")

