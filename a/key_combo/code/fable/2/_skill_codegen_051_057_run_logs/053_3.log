   190	def main(grid: np.ndarray) -> np.ndarray:
   191	    """
   192	    Repair the occluded cells of a three-band faulted translational tiling without straightening the faults.
   193	
   194	    Input structure:
   195	    - The whole canvas is filled by a multicolor 2D translational motif.
   196	    - Two hidden vertical fault lines split the grid into three column bands; each band keeps the same horizontal phase but has its own vertical phase offset.
   197	    - One unique-color rectangle occludes part of the tiling and may cross one or both faults; small non-rectangular distractors may also be present.
   198	
   199	    Rule:
   200	    - Detect the occluder rectangle and ignore it while inferring the underlying motif.
   201	    - Recover the motif period, the two fault columns, and the vertical phase offset of each band from the still-visible cells.
   202	    - Repaint only the occluded rectangle so each covered cell receives the motif color for its own band phase; keep the faults, offsets, and every non-occluder cell unchanged.
   203	
   204	    Key insight:
   205	    - The grid is not globally periodic: the same motif repeats with different vertical phase shifts in three vertical bands, so completion must be done band-by-band rather than with one global tile.
   206	    """
   207	    g = np.asarray(grid, dtype=int)
   208	    occ = _find_occluder(g)
   209	    model = _infer_model(g, occ["mask"])
   210	    out = g.copy()
   211	    pr = int(model["pr"])
   212	    pc = int(model["pc"])
   213	    b1 = int(model["b1"])
   214	    b2 = int(model["b2"])
   215	    o1 = int(model["o1"])
   216	    o2 = int(model["o2"])
   217	    motif = np.asarray(model["motif"], dtype=int)
   218	
   219	    for r, c in np.argwhere(occ["mask"]):
   220	        rr = int(r)
   221	        cc = int(c)
   222	        band = _band_of_col(cc, b1, b2)
   223	        off = 0 if band == 0 else o1 if band == 1 else o2
   224	        out[rr, cc] = int(motif[(rr + off) % pr, cc % pc])
   225	    return out
