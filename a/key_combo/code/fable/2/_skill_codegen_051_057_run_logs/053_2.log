+        size,
+        positions,
+        step,
+        color_a,
+        color_b,
+        bg,
+        swap_phase_on_bounce=True,
+    )
+    counterfactual, no_swap_meta = _simulate_sequence(
+        shape,
+        size,
+        positions,
+        step,
+        color_a,
+        color_b,
