+    r, c = map(int, pos)
+    h, w = map(int, shape)
+    s = int(size)
+    return 0 <= r and 0 <= c and r + s <= h and c + s <= w
+
+
+def _rectangles_overlap(a: tuple[int, int], b: tuple[int, int], size: int) -> bool:
+    ar, ac = map(int, a)
+    br, bc = map(int, b)
+    s = int(size)
+    return not (ar + s <= br or br + s <= ar or ac + s <= bc or bc + s <= ac)
