    occ=ps[:]; cur=occ[-1]; vv=v; phase=0; b=0; pab=0
    while True:
        cand=(cur[0]+vv[0],cur[1]+vv[1])
        if not inside(cand,s,H,W):
            vv=(-vv[0] if cand[0]<0 or cand[0]+s>H else vv[0], -vv[1] if cand[1]<0 or cand[1]+s>W else vv[1])
            phase"'^=1; b+=1; cand=(cur[0]+vv[0],cur[1]+vv[1])
            if not inside(cand,s,H,W): return dict(b=b,pab=pab,t='"'oob',n=len(occ))
        if any(overlap(cand,p,s) for p in occ): return dict(b=b,pab=pab,t='overlap',n=len(occ))
        occ.append(cand); cur=cand
        if b: pab+=1
        if len(occ)>100: return dict(b=b,pab=pab,t='loop',n=len(occ))

def ranges_for_coordinate(max_top,d,m,sign,first_bounce,will_bounce):
    # coordinate of p0 along one axis, top-left max=max_top
    vals=[]
    for p0 in range(1, max_top): # initial not touching boundaries
        ok_init = 1 <= (p0 + sign*2*d) <= max_top-1
        if not ok_init:
            continue
        current = p0 + sign*(2+m)*d
        nxt = p0 + sign*(3+m)*d
        if not (0 <= current <= max_top):
            continue
        this_bounce = not (0 <= nxt <= max_top)
        if will_bounce:
            if this_bounce:
                vals.append(p0)
        else:
            if 0 <= nxt <= max_top:
                vals.append(p0)
