import random

def inside(pos,s,H,W):
    r,c=pos
    return 0<=r and 0<=c and r+s<=H and c+s<=W

def overlap(a,b,s):
    ar,ac=a;br,bc=b
    return not (ar+s<=br or br+s<=ar or ac+s<=bc or bc+s<=ac)

def sim(H,W,s,p0,v):
    ps=[p0,(p0[0]+v[0],p0[1]+v[1]),(p0[0]+2*v[0],p0[1]+2*v[1])]
    if not all(inside(p,s,H,W) for p in ps): return None
    occ=ps[:]; cur=occ[-1]; vv=v; phase=0; b=0; pab=0
    while True:
        cand=(cur[0]+vv[0],cur[1]+vv[1])
        if not inside(cand,s,H,W):
            vv=(-vv[0] if cand[0]<0 or cand[0]+s>H else vv[0], -vv[1] if cand[1]<0 or cand[1]+s>W else vv[1])
            phase"'^=1; b+=1; cand=(cur[0]+vv[0],cur[1]+vv[1])
            if not inside(cand,s,H,W): return dict(b=b,pab=pab,t='"'oob',n=len(occ))
        if any(overlap(cand,p,s) for p in occ): return dict(b=b,pab=pab,t='overlap',n=len(occ))
        occ.append(cand); cur=cand
        if b: pab+=1
        if len(occ)>100: return dict(b=b,pab=pab,t='loop',n=len(occ))

def allowed(max_top,d,m,sign,needs_bounce):
    vals=[]
    for p0 in range(1,max_top):
        if not (1 <= p0 + sign*2*d <= max_top-1):
            continue
        current = p0 + sign*(2+m)*d
        nxt = p0 + sign*(3+m)*d
        if not (0 <= current <= max_top):
            continue
        b = not (0 <= nxt <= max_top)
        if needs_bounce == b:
            vals.append(p0)
    return vals

def sample():
    H=random.randint(16,30); W=random.randint(16,30); s=random.randint(2,4)
    maxd=min(8,H-s-2,W-s-2)
    if maxd < s+1: return None
    d=random.randint(s+1,maxd)
    sr=random.choice([-1,1]); sc=random.choice([-1,1]); m=random.randint(0,3); axis=random.choice([0,1])
    rowvals=allowed(H-s,d,m,sr, axis==0)
    colvals=allowed(W-s,d,m,sc, axis==1)
    if not rowvals or not colvals: return None
    return H,W,s,(random.choice(rowvals), random.choice(colvals)),(sr*d,sc*d)

for name, pred in [
    ('modeA', lambda r:r['b']>=2 and r['pab']>=2 and 5<=r['n']<=9 and r['t']=='overlap'),
    ('modeB', lambda r:r['b']>=3 and r['pab']>=4 and 7<=r['n']<=12 and r['t']=='overlap'),
]:
    hits=0
    N=20000
    for _ in range(N):
        s=sample()
        if s is None: continue
        r=sim(*s)
        if r and pred(r): hits+=1
    print(name,hits,'rate',hits/N)
