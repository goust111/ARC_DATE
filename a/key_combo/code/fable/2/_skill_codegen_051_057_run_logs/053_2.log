+    row_vals = _axis_start_candidates(h - size, size, step_mag, pre_bounce_steps, sr, first_bounce_axis == 0)
+    col_vals = _axis_start_candidates(w - size, size, step_mag, pre_bounce_steps, sc, first_bounce_axis == 1)
