+        cand = (int(cur[0] + vr), int(cur[1] + vc))
+        if not _inside_square(cand, size, shape):
+            new_vr = -vr if cand[0] < 0 or cand[0] + size > h else vr
+            new_vc = -vc if cand[1] < 0 or cand[1] + size > w else vc
