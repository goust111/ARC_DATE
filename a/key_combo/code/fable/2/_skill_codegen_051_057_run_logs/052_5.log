+        side = _marker_side(g.shape, rr, cc, center_r, center_c)
+        assert side not in seen_sides, "expected at most one marker per side"
+        seen_sides.add(side)
+        markers.append({"side": side, "color": int(g[rr, cc]), "coord": (rr, cc)})
