        stamp_coords = coords[g[coords[:, 0], coords[:, 1]] == stamp_color]
        assert len(stamp_coords) > 0
        for r, c in stamp_coords:
            stamp_offsets.append((int(r) - marker_r, int(c) - marker_c))
