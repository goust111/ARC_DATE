+        )
+        layers.append({"bbox": bbox, "gaps": set(gaps_by_layer[depth])})
+
+    marker_coords = {
+        "top": (0, center_c),
+        "bottom": (height - 1, center_c),
+        "left": (center_r, 0),
+        "right": (center_r, width - 1),
+    }
+    markers = [
+        {"side": side, "color": int(side_to_color[side]), "coord": marker_coords[side]}
+        for side in sides
