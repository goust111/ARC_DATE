) -> None:
    height, width = solid.shape
    for r in range(1, height - 1):
        for c in range(1, width - 1):
            if solid[r, c]:
                continue
            is_one_cell_top_left_gap = (
                solid[r, c + 1]
                and solid[r + 1, c]
                and solid[r + 1, c + 1]
                and not solid[r + 1, c - 1]
