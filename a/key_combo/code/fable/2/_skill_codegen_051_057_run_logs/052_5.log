+    inset = 0
+    while True:
+        bbox = (r0 + 2 * inset, c0 + 2 * inset, r1 - 2 * inset, c1 - 2 * inset)
+        rr0, cc0, rr1, cc1 = bbox
+        if rr1 - rr0 + 1 < 3 or cc1 - cc0 + 1 < 3:
+            break
+
+        gap_coords = {side: _side_gap_coord(bbox, side) for side in SIDES}
+        border = _border_coords(bbox)
+        gaps = set()
