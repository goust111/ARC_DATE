+            color = random.choice(choices)
+            row[c0:c1] = color
+            last = color
+        for _ in range(random.randint(1, 2)):
+            idx = random.randrange(width)
+            choices = [color for color in palette if color != int(row[idx])]
+            row[idx] = random.choice(choices)
