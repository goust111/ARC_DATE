+    cols = np.where(np.any(inp != BG, axis=0))[0]
+    bbox = inp[int(rows[0]) : int(rows[-1]) + 1, int(cols[0]) : int(cols[-1]) + 1]
+    return all(not _period_consistent(bbox, d) for d in range(1, bbox.shape[0]))
