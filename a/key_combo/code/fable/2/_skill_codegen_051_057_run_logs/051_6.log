+    return [obj for obj in placed if obj is not None]
+
+
+def _candidate_marker_cells(shape: tuple[int, int], objects: list[dict], center: np.ndarray) -> list[dict]:
+    h, w = shape
+    occupied = set()
+    for obj in objects:
