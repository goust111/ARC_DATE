+    pos = next(i for i, obj in enumerate(ordered) if int(obj["color"]) == start_color)
+    if clockwise:
+        return [ordered[(pos + k) % len(ordered)] for k in range(len(ordered))]
+    return [ordered[(pos - k) % len(ordered)] for k in range(len(ordered))]
