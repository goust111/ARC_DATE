+from __future__ import annotations
+
+import math
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MARKER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+
+GENERATION_RETRIES = 500
+ANGLE_EPS = 0.16
+MARKER_SIDE_EPS = 0.14
+_GEN_CALLS = 0
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    for dr, dc in NEIGHBORS4:
+        yield int(r + dr), int(c + dc)
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for sr, sc in np.argwhere(mask):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        cells: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            cells.append((r, c))
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+        comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _clockwise_angle(point: np.ndarray, center: np.ndarray) -> float:
+    dr = float(point[0] - center[0])
+    dc = float(point[1] - center[1])
+    angle = math.atan2(dc, -dr)
+    if angle < 0:
+        angle += 2.0 * math.pi
+    return angle
+
+
+def _signed_cw_delta(base: float, target: float) -> float:
+    delta = (float(target) - float(base)) % (2.0 * math.pi)
+    if delta > math.pi:
+        delta -= 2.0 * math.pi
+    return delta
+
+
