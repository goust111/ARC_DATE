+
+def _place_weighted_template_objects(shape: tuple[int, int], colors: list[int], rng: random.Random) -> list[dict] | None:
+    offsets = _transform_offsets(WEIGHTED_TEMPLATE_OFFSETS, rng.randrange(8))
