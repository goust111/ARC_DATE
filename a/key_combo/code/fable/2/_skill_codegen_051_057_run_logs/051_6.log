+    obj_center = np.mean([obj["centroid"] for obj in objects], axis=0)
+    wrong_center_rows = _ordered_cycle(objects, obj_center, start_idx, clockwise)
+    if require_wrong_center_diff and np.array_equal(_barcode_from_sequence(wrong_center_rows), expected):
