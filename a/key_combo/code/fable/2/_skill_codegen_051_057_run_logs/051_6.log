+    h, w = shape
+    center = np.array([h / 2.0 + rng.uniform(-1.0, 1.0), w / 2.0 + rng.uniform(-1.0, 1.0)], dtype=float)
+    max_radius = int(min(center[0] - 3, h - center[0] - 4, center[1] - 3, w - center[1] - 4))
+    if max_radius < 6:
