+)
+
+GENERATION_RETRIES = 500
+ANGLE_EPS = 0.16
+MARKER_SIDE_EPS = 0.14
+_GEN_CALLS = 0
+WEIGHTED_TEMPLATE_OFFSETS = np.array(
+    [
+        (7.0, 0.0),
+        (4.33, 2.5),
+        (4.0, 6.93),
+        (0.0, 8.0),
+        (-4.33, -2.5),
+    ],
+    dtype=float,
+)
+WEIGHTED_TEMPLATE_AREAS = (4, 7, 8, 5, 3)
