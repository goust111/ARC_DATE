+
+def _rotated_sequence(base: list[dict], start_color: int, forward: bool) -> list[dict]:
+    seq = list(base)
+    if not forward:
+        seq = list(reversed(seq))
+    pos = next(i for i, obj in enumerate(seq) if int(obj["color"]) == int(start_color))
