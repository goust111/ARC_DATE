+    areas = [obj["area"] for obj in objects]
+    assert len(set(areas)) == len(areas), "object areas must be unique"
+    return objects
+
+
+def _sort_by_angle(objects: list[dict], center: np.ndarray) -> list[dict]:
+    ranked = []
+    for obj in objects:
