+
+    for idx in order:
+        spec = specs[idx]
+        local = spec["poly"]
+        local_center = local.astype(float).mean(axis=0)
+        radii = list(range(max(5, max_radius - 3), max_radius + 1))
+        rng.shuffle(radii)
