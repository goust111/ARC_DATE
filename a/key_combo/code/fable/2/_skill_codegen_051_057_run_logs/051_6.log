+    if np.array_equal(_barcode_from_sequence(_rotated_sequence(area_base, start_color, True)), expected):
+        return False
+    if np.array_equal(_barcode_from_sequence(_rotated_sequence(area_base, start_color, False)), expected):
+        return False
