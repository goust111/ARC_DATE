+    true_angles = [float(_clockwise_angle(obj["centroid"], center)) for obj in sorted_true]
+    true_gaps = [
+        (true_angles[(i + 1) % len(true_angles)] - true_angles[i]) % (2.0 * math.pi)
+        for i in range(len(true_angles))
+    ]
+    if min(true_gaps) < ANGLE_EPS:
