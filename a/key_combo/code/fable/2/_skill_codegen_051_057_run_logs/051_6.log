+def _barcode(rows: list[dict]) -> np.ndarray:
+    widths = [int(obj["area"]) for obj in rows]
+    out = np.zeros((len(rows), max(widths)), dtype=int)
+    for r, obj in enumerate(rows):
+        out[r, : int(obj["area"])] = int(obj["color"])
+    return out
