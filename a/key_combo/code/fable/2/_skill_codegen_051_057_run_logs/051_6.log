+    colors = sorted(set(map(int, np.unique(grid))) - {int(bg), MARKER})
+    objects: list[dict] = []
+    for color in colors:
+        comps = components_mask(grid == int(color))
+        assert len(comps) == 1, "each non-marker color must form exactly one 4-connected object"
+        coords = comps[0]
