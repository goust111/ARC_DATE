/bin/bash -lc "python - <<'PY'
import math, random, itertools, numpy as np

def ang(pt, center):
    dr = pt[0]-center[0]
    dc = pt[1]-center[1]
    a = math.atan2(dc, -dr)
    return a + 2*math.pi if a < 0 else a

def order(pts, center):
    return tuple(sorted(range(len(pts)), key=lambda i: ang(pts[i], center)))

# Search hand-crafted ring points with weighted centroid order "'!= unweighted centroid order.
slots = []
for a in range(0, 360, 15):
    for r in (5,6,7,8):
        slots.append((a,r))

for n in (4,5):
    for _ in range(200000):
        choice = random.sample(slots, n)
        pts=[]
        for a_deg, rad in choice:
            a = math.radians(a_deg)
            pts.append(np.array([-rad*math.cos(a), rad*math.sin(a)]))
        pts = np.array(pts)
        # ensure some close pair but no too-close duplicates
        angs = sorted(ang(p, np.array([0.0,0.0])) for p in pts)
        gaps = [ (angs[(i+1)%n]-angs[i])%(2*math.pi) for i in range(n) ]
        if min(gaps) < 0.35 or max(gaps) > 3.0:
            continue
        areas = random.sample(range(3,10), n)
        wc = (pts * np.array(areas)[:,None]).sum(axis=0) / sum(areas)
        uc = pts.mean(axis=0)
        o1 = order(pts, wc)
        o2 = order(pts, uc)
        if o1 != o2:
            print('"'n',n)
            print('pts',[(round(float(p[0]),2), round(float(p[1]),2)) for p in pts])
            print('areas',areas)
            print('wc',wc,'uc',uc)
            print('o1',o1,'o2',o2)
            raise SystemExit
print('none found')
