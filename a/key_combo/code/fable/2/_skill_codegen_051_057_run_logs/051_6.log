    n = len(ordered)
    shift = hole_count % n
    colors = [int(region["color"]) for region in ordered]

    out = g.copy()
    for index, region in enumerate(ordered):
        new_color = colors[(index - shift) % n]
        coords = region["coords"]
        out[coords[:, 0], coords[:, 1]] = new_color
    return out


