+    for marker in marker_candidates:
+        trial_grid = grid.copy()
+        mr, mc = marker["cell"]
+        trial_grid[mr, mc] = MARKER
+        start_idx = int(marker["obj_idx"])
+        if _semantic_checks(trial_grid, objects, start_idx, required_clockwise, require_wrong_center_diff):
+            return trial_grid
