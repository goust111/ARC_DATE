+    grid[mr, mc] = MARKER
+
+    if not _semantic_checks(grid, objects, start_idx, required_clockwise):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALLS
+    _GEN_CALLS += 1
+    required_clockwise = bool(_GEN_CALLS % 2)
+    seed = random.randrange(1 << 30)
