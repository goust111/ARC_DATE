+            "color": int(spec["color"]),
+            "area": int(spec["area"]),
+            "coords": placed_here.astype(int),
+            "coord_set": {tuple(map(int, rc)) for rc in placed_here},
+            "centroid": placed_here.astype(float).mean(axis=0),
+        }
