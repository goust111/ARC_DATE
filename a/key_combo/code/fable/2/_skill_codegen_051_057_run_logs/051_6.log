+
+def _transform_offsets(offsets: np.ndarray, mode: int) -> np.ndarray:
+    pts = np.array(offsets, dtype=float)
+    if mode >= 4:
+        pts[:, 1] *= -1.0
+        mode -= 4
+    for _ in range(mode):
+        pts = np.column_stack([pts[:, 1], -pts[:, 0]])
+    return pts
