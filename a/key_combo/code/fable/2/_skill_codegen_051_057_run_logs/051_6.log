+from __future__ import annotations
+
+import math
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MARKER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
