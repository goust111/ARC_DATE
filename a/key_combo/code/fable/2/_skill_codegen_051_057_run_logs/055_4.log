+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+GREY = 5
+CELL_SIZE = 3
+CELL_GAP = 1
+CELL_STRIDE = CELL_SIZE + CELL_GAP
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+STATE_NONE = 0
+STATE_LEFT = 1
+STATE_RIGHT = 2
+STATE_BOTH = 3
+GEN_ATTEMPTS = 600
