+
+def _all_color_inside(grid: np.ndarray, color: int, bbox: tuple[int, int, int, int]) -> bool:
+    coords = np.argwhere(grid == int(color))
+    if coords.size == 0:
+        return False
+    r0, c0, r1, c1 = bbox
+    return bool(np.all((coords[:, 0] >= r0) & (coords[:, 0] <= r1) & (coords[:, 1] >= c0) & (coords[:, 1] <= c1)))
