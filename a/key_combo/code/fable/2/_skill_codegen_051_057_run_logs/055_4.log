+        right_bbox = (row_start, right_c0, row_start + rows_count - 1, right_c0 + cols_count - 1)
+        panel_bbox = (row_start, left_c0, row_start + rows_count - 1, right_c0 + cols_count - 1)
+        if _bboxes_overlap(panel_bbox, lattice_bbox):
