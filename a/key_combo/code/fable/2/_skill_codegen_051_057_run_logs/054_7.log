+    unclaimed_ids = {obj["id"] for obj in objects if obj["id"] not in claimed_ids}
+    if not claimed_ids or not unclaimed_ids:
+        return False
+
+    multi_claim_ok = False
+    for obj_id, obj_claims in claims.items():
