+
+
+def _place_in_region(
+    rng: np.random.Generator,
+    occupied: set[tuple[int, int]],
+    h: int,
+    w: int,
+    row_range: tuple[int, int],
+    col_range: tuple[int, int],
+    extra_check=None,
+    attempts: int = 80,
+) -> dict | None:
+    row_lo, row_hi = row_range
+    col_lo, col_hi = col_range
