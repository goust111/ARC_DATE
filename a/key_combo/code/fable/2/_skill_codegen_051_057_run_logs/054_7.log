            return False
        for dr, dc in DIRS8 + [(0, 0)]:
            if (r + dr, c + dc) in occupied:
                return False
    return True


def _place_in_region(
    rng: np.random.Generator,
    occupied: set[tuple[int, int]],
    h: int,
    w: int,
    row_range: tuple[int, int],
    col_range: tuple[int, int],
    extra_check=None,
    attempts: int = 80,
