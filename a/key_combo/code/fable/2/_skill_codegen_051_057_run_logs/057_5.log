+        assert half <= r < g.shape[0] - half
+        assert half <= c < g.shape[1] - half
+        patch = out[r - half : r + half + 1, c - half : c + half + 1]
+        assert patch.shape == motif.shape
+        assert not np.any(patch[motif] != bg)
+        patch[motif] = int(color)
+    return out
+
+
