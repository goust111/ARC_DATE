+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q: deque[tuple[int, int]] = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc]:
