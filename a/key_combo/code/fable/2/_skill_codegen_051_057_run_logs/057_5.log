    upper_cells = [(r, c) for r in range(n) for c in range(r, n)]
    tile = np.zeros((n, n), dtype=int)
    for r, c in upper_cells:
        color = random.choice(colors)
        tile[r, c] = color
        tile[c, r] = color

    forced = upper_cells[:]
    random.shuffle(forced)
    for color, (r, c) in zip(colors, forced):
        tile[r, c] = color
        tile[c, r] = color
    return tile


