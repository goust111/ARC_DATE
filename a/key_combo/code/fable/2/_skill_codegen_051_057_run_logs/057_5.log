+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
+LOCAL_FRAGMENT_ATTEMPTS = 300
+PLACEMENT_ATTEMPTS = 300
+CANVAS_CHOICES = tuple(range(18, 31))
+MOTIF_SIZES = (5, 7, 9)
+MARKER_COUNT_RANGE = (2, 5)
+AREA_MARGIN = 1
