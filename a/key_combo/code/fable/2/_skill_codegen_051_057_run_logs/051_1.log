+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
