+def _scene_input(
+    shape: tuple[int, int],
+    frames: list[tuple[int, int, int, int]],
+    legend: list[int],
+    legend_row0: int,
+    launcher_color: int,
+    base: tuple[int, int],
+    cap: tuple[int, int],
+) -> np.ndarray:
