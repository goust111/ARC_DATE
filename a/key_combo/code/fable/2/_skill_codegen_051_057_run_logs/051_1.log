+def _segment_cells(start: tuple[int, int], direction: tuple[int, int], steps: int) -> list[tuple[int, int]]:
+    r, c = start
+    dr, dc = direction
+    return [(r + k * dr, c + k * dc) for k in range(1, steps + 1)]
