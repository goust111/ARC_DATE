+        r0, c0, r1, c1 = _bbox_coords(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert h >= 3 and w >= 3, "grey components must be nontrivial hollow rectangles"
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros((h, w), dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
