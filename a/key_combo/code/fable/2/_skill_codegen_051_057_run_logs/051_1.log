+    options = []
+    for row0 in range(0, h - legend_len + 1):
+        rows = set(range(row0, row0 + legend_len))
+        if rows & blocked_rows:
+            continue
+        if rows & edge_rows_used:
+            continue
+        options.append(row0)
+    return random.choice(options) if options else None
