+        r0, c0, r1, c1 = bbox
+        ids[r0, c0 : c1 + 1] = idx
+        ids[r1, c0 : c1 + 1] = idx
+        ids[r0 : r1 + 1, c0] = idx
+        ids[r0 : r1 + 1, c1] = idx
