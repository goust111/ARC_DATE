+def _trace_ray(
+    rect_ids: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> dict:
+    h, w = rect_ids.shape
+    r, c = map(int, start)
+    dr, dc = map(int, direction)
+    assert abs(dr) == 1 and abs(dc) == 1
+    assert 0 <= r < h and 0 <= c < w
