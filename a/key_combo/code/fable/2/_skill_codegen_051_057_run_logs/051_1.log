+) -> bool:
+    r0, c0, r1, c1 = bbox
+    if not (1 <= r0 < r1 <= h - 2 and 2 <= c0 < c1 <= w - 2):
+        return False
+    if _bbox_too_close(bbox, reserve, gap=0):
