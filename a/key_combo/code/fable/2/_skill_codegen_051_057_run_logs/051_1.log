+    if {event["kind"] for event in first_hits} != {"vertical", "horizontal"}:
+        return None
+    if not _simple_orders_ok(frames, hit_ids, cap):
+        return None
+
+    total_frames = len(frames)
+    if total_frames > len(PALETTE) - 1:
