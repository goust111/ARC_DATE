+def _scene_input(
+    shape: tuple[int, int],
+    frames: list[tuple[int, int, int, int]],
+    legend: list[int],
+    legend_row0: int,
+    launcher_color: int,
+    base: tuple[int, int],
+    cap: tuple[int, int],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for bbox in frames:
+        _draw_frame(grid, bbox, GREY)
+    for idx, color in enumerate(legend):
+        grid[legend_row0 + idx, 0] = color
+    grid[base] = launcher_color
+    grid[cap] = launcher_color
