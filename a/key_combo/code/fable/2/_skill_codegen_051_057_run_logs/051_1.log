+            "base": (2, 2),
+            "cap": (3, 3),
+            "reserve": (0, 0, 5, 5),
+            "blocked_legend_rows": set(range(0, 6)),
+        }
+    if direction == (-1, 1):
+        return {
+            "base": (h - 3, 2),
+            "cap": (h - 4, 3),
+            "reserve": (h - 6, 0, h - 1, 5),
+            "blocked_legend_rows": set(range(h - 6, h)),
+        }
+    if direction == (1, -1):
