+
+GRID_H_RANGE = (22, 28)
+GRID_W_RANGE = (22, 28)
+VISITED_COUNT_RANGE = (3, 3)
+EXTRA_COUNT_RANGE = (1, 2)
+FRAME_H_RANGE = (4, 7)
+FRAME_W_RANGE = (4, 7)
+TRAVEL_STEPS_RANGE = (2, 5)
+STEP_RETRIES = 500
+EXTRA_RETRIES = 400
