+    assert len(capacities) >= 2, "need multiple cups"
+    assert len(capacities) == len(set(capacities)), "cup capacities must be distinct"
+    cups.sort(key=lambda cup: (cup["bbox"][0], cup["bbox"][1]))
+    return outline, cups
