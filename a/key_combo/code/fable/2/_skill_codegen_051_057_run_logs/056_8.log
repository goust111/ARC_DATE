+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_RETRIES = 600
+CUP_COUNT_OPTIONS = (2, 3, 4)
+TOTAL_CAPACITY_BOUNDS = {
