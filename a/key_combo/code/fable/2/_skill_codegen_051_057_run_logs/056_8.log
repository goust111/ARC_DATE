+    phase_r = random.randint(0, 1)
+    phase_c = random.randint(0, 1)
+    available = _drop_candidates(grid.shape[0], grid.shape[1], top_stop, phase_r, phase_c)
+    if len(available) < sum(color_counts.values()):
+        return None
