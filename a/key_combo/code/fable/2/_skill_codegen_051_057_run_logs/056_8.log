+def _pair_centroid(assignments: dict[int, list[Coord]], colors: tuple[int, int]) -> tuple[float, float]:
+    pts = assignments[colors[0]] + assignments[colors[1]]
+    rs = [p[0] for p in pts]
+    cs = [p[1] for p in pts]
