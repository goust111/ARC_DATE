+            continue
+        if len({_euclid_sq_from_marker(base, cell) for cell in cells}) != len(cells):
+            continue
+
+        ranked_true = sorted((int(true_dist[r, c]), r, c) for r, c in cells)
+        ranked_wrong = sorted(
+            ((int(wrong_dist[r, c]), r, c) for r, c in cells),
