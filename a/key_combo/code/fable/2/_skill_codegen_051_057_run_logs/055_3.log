+
+    shortlist: list[tuple[int, int]] = []
+    for group in (
+        sorted(
+            sensitive_cells,
+            key=lambda cell: (
+                -(int(wrong_dist[cell[0], cell[1]]) - int(true_dist[cell[0], cell[1]])),
