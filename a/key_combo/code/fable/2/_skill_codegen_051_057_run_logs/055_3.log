+    gap2_start = rng.randint(1, 2)
+
+    for r in range(h):
+        if not (gap1_start <= r < gap1_start + gap1_len):
+            grid[r, c1] = WALL
+        if not (gap2_start <= r < gap2_start + gap2_len):
