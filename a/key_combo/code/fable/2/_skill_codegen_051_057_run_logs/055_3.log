+        c = int(c)
+        d = int(dist[r, c])
+        assert d >= 0, "all grey tiles must be reachable"
+        assert d not in seen, "grey-tile geodesic distances must be unique"
+        seen.add(d)
+        ranked.append((d, r, c))
