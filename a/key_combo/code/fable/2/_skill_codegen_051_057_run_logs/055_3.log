+    grid = np.full((h, w), BG, dtype=int)
+
+    gap1_len = rng.randint(2, 4)
+    gap2_len = rng.randint(2, 4)
+    gap1_start = h - gap1_len - rng.randint(1, 2)
+    gap2_start = rng.randint(1, 2)
+
+    for r in range(h):
+        if not (gap1_start <= r < gap1_start + gap1_len):
