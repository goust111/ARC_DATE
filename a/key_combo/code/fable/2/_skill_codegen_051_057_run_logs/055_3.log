+
+    meta = {
+        "c1": c1,
+        "c2": c2,
+        "c3": c3,
+        "gap1_start": gap1_start,
+        "gap2_start": gap2_start,
+        "gap2_len": gap2_len,
+        "n": n,
+    }
+    return grid, meta
+
+
+def _sample_tiles(base: np.ndarray, meta: dict[str, int], rng: random.Random) -> np.ndarray | None:
+    c1 = meta["c1"]
+    c2 = meta["c2"]
+    c3 = meta["c3"]
+    gap1_start = meta["gap1_start"]
+    n = meta["n"]
+
+    true_dist = _bfs_dist(base, ignore_decor=True)
+    wrong_dist = _bfs_dist(base, ignore_decor=False)
+    marker = _find_unique_marker(base)
+
+    pool = []
+    for r, c in np.argwhere((base == BG) & (true_dist >= 0)):
+        r = int(r)
+        c = int(c)
+        if (r, c) == marker:
+            continue
+        if r in (0, base.shape[0] - 1) or c in (0, base.shape[1] - 1):
+            continue
+        pool.append((r, c))
+
+    if len(pool) < n + 3:
+        return None
+
+    left_cells = [cell for cell in pool if cell[1] < c1]
+    across_cells = [cell for cell in pool if c1 < cell[1] < c2 and cell[0] < gap1_start - 1]
+    decor_cells = [
+        cell
+        for cell in pool
+        if wrong_dist[cell[0], cell[1]] >= 0
+        and wrong_dist[cell[0], cell[1]] - true_dist[cell[0], cell[1]] >= 2
+    ]
+    if not left_cells or not across_cells or not decor_cells:
+        return None
+
+    def can_add(cell: tuple[int, int], chosen: list[tuple[int, int]], used_true: set[int], used_euclid: set[int]) -> bool:
+        r, c = cell
+        d = int(true_dist[r, c])
+        e = _euclid_sq_from_marker(base, cell)
+        if d in used_true or e in used_euclid:
+            return False
+        return all(abs(r - rr) + abs(c - cc) >= 2 for rr, cc in chosen)
+
+    def add_best(
+        ordered: list[tuple[int, int]],
+        chosen: list[tuple[int, int]],
+        used_true: set[int],
+        used_euclid: set[int],
+    ) -> bool:
+        for cell in ordered:
+            if can_add(cell, chosen, used_true, used_euclid):
+                chosen.append(cell)
+                used_true.add(int(true_dist[cell[0], cell[1]]))
+                used_euclid.add(_euclid_sq_from_marker(base, cell))
+                return True
+        return False
+
+    across_order = sorted(
+        across_cells,
+        key=lambda cell: (
+            -(int(true_dist[cell[0], cell[1]]) - _euclid_sq_from_marker(base, cell)),
+            _euclid_sq_from_marker(base, cell),
+            cell,
+        ),
+    )
+    decor_order = sorted(
+        decor_cells,
+        key=lambda cell: (
+            -(int(wrong_dist[cell[0], cell[1]]) - int(true_dist[cell[0], cell[1]])),
+            int(true_dist[cell[0], cell[1]]),
+            cell,
+        ),
+    )
+    left_order = sorted(left_cells, key=lambda cell: (int(true_dist[cell[0], cell[1]]), cell))
+
+    all_order = pool[:]
+    rng.shuffle(all_order)
+    all_order.sort(
+        key=lambda cell: (
+            0 if c1 < cell[1] < c2 else 1,
+            int(true_dist[cell[0], cell[1]]),
+            rng.random(),
+        )
+    )
+
+    total_tiles = n + rng.randint(3, 5)
+    for _ in range(40):
+        chosen: list[tuple[int, int]] = []
+        used_true: set[int] = set()
+        used_euclid: set[int] = set()
+        if not add_best(across_order, chosen, used_true, used_euclid):
+            continue
+        if not add_best(decor_order, chosen, used_true, used_euclid):
+            continue
+        if not add_best(left_order, chosen, used_true, used_euclid):
+            continue
+        for cell in all_order:
+            if len(chosen) >= total_tiles:
+                break
+            if can_add(cell, chosen, used_true, used_euclid):
+                chosen.append(cell)
+                used_true.add(int(true_dist[cell[0], cell[1]]))
+                used_euclid.add(_euclid_sq_from_marker(base, cell))
+        if len(chosen) < total_tiles:
+            continue
+
+        grid = base.copy()
+        for r, c in chosen:
+            grid[r, c] = GREY
+        if _validate_generated_case(grid):
+            return grid
+    return None
+
+
+def _transform_case(grid: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = np.rot90(grid, k=rng.randrange(4))
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    return np.asarray(out, dtype=int)
+
+
+def _validate_generated_case(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2 or max(g.shape) > 30:
+        return False
+
+    try:
+        marker = _find_unique_marker(g)
+        if marker not in {
+            (0, 0),
+            (0, g.shape[1] - 1),
+            (g.shape[0] - 1, 0),
+            (g.shape[0] - 1, g.shape[1] - 1),
+        }:
+            return False
+        structural = _structural_wall_mask(g)
+        decor = (g == WALL) & ~structural
+        if not structural.any() or not decor.any():
+            return False
+        bar = _find_energy_bar(g)
+        n = int(bar.shape[0])
+        true_dist = _bfs_dist(g, ignore_decor=True)
+        wrong_dist = _bfs_dist(g, ignore_decor=False)
+        ranked = _ranked_grey_tiles(g, true_dist)
+        if len(ranked) <= n:
+            return False
+        grey_cells = [(r, c) for _d, r, c in ranked]
+        euclid = [(_euclid_sq_from_marker(g, (r, c)), r, c) for _d, r, c in ranked]
+        euclid.sort()
+        if len({d for d, _r, _c in euclid}) != len(euclid):
+            return False
+        if not any(
+            wrong_dist[r, c] >= 0 and wrong_dist[r, c] - true_dist[r, c] >= 2
+            for _d, r, c in ranked
+        ):
+            return False
+
+        chosen_true = {(r, c) for _d, r, c in ranked[:n]}
+        chosen_euclid = {(r, c) for _e, r, c in euclid[:n]}
+
+        wrong_ranked = []
+        for _d, r, c in ranked:
+            wd = int(wrong_dist[r, c])
+            if wd < 0:
+                wd = 10_000
+            wrong_ranked.append((wd, r, c))
+        wrong_ranked.sort()
+        chosen_wrong = {(r, c) for _wd, r, c in wrong_ranked[:n]}
+
+        if chosen_true == chosen_euclid or chosen_true == chosen_wrong:
+            return False
+
+        out = main(g)
+        if out.shape != g.shape:
+            return False
+        bg = get_bg(g)
+        if not np.all(out[decor] == bg):
+            return False
+        if not np.all(out[bar[:, 0], bar[:, 1]] == GREY):
+            return False
+        for r, c in grey_cells:
+            expect = ORANGE if (r, c) in chosen_true else GREY
+            if int(out[r, c]) != expect:
+                return False
+        if int(out[marker[0], marker[1]]) != MARKER:
+            return False
+        return True
+    except AssertionError:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        try:
+            base, meta = _make_base_layout(rng)
+            tiled = _sample_tiles(base, meta, rng)
+            if tiled is None:
+                continue
+            grid = _transform_case(tiled, rng)
+            if _validate_generated_case(grid):
+                return grid
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid geodesic-charge ARC input")

