+    grid[door_r, wall_a + 2] = BG
+    grid[door_r - 1, wall_a + 1] = BG
+    grid[door_r + 1, wall_a + 1] = BG
+    grid[door_r, wall_a + 1] = WALL
+
+    n = rng.randint(2, 3)
+    bar_r0 = rng.randint(1, h - n - 1)
