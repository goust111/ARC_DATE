+
+def _can_place_decor(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 < r < h - 1 and 0 < c < w - 1):
+            return False
+        if int(grid[r, c]) != BG:
+            return False
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in cell_set:
+                continue
