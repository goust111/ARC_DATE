+
+        chosen_true = {(r, c) for _d, r, c in ranked_true[:n]}
+        chosen_wrong = {(r, c) for _d, r, c in ranked_wrong[:n]}
+        chosen_euclid = {(r, c) for _d, r, c in ranked_euclid[:n]}
+        if chosen_true == chosen_wrong or chosen_true == chosen_euclid:
