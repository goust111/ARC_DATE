+    sensitive_cells = [
+        cell
+        for cell in pool
+        if wrong_dist[cell[0], cell[1]] >= 0
+        and wrong_dist[cell[0], cell[1]] - true_dist[cell[0], cell[1]] >= 6
+    ]
+    misleading_cells = [
+        cell
+        for cell in pool
+        if int(true_dist[cell[0], cell[1]]) - _euclid_sq_from_marker(base, cell) >= 15
+    ]
+    easy_cells = sorted(pool, key=lambda cell: (int(true_dist[cell[0], cell[1]]), cell))
+    if not sensitive_cells or not misleading_cells:
+        return None
