+
+def _euclid_sq_from_marker(grid: np.ndarray, cell: tuple[int, int]) -> int:
+    mr, mc = _find_unique_marker(grid)
+    r, c = cell
+    return int((r - mr) ** 2 + (c - mc) ** 2)
