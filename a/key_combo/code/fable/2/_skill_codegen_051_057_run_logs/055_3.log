+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        cells = []
+        while q:
+            rr, cc = q.popleft()
+            cells.append((rr, cc))
+            for nr, nc in neighbors4(rr, cc):
