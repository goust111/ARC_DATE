+def _ranked_grey_tiles(grid: np.ndarray, dist: np.ndarray) -> list[tuple[int, int, int]]:
+    grey = np.argwhere(grid == GREY)
+    ranked = []
+    seen = set()
+    for r, c in grey:
+        r = int(r)
+        c = int(c)
