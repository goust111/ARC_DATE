+def _bfs_dist(grid: np.ndarray, ignore_decor: bool) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    marker = _find_unique_marker(g)
+    structural = _structural_wall_mask(g)
+    if ignore_decor:
+        blocked = structural.copy()
+    else:
+        blocked = g == WALL
+    blocked |= g == ORANGE
