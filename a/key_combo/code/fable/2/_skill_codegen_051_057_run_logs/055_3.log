+
+def _make_base_layout(rng: random.Random) -> tuple[np.ndarray, dict[str, int]]:
+    left_w = rng.randint(4, 6)
+    mid_w = rng.randint(5, 7)
+    right_w = rng.randint(5, 7)
+    chamber_w = rng.randint(2, 4)
