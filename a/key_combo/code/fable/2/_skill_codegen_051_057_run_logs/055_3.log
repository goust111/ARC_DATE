+    return int(coords[0, 0]), int(coords[0, 1])
+
+
+def _structural_wall_mask(grid: np.ndarray) -> np.ndarray:
+    mask = np.zeros_like(grid, dtype=bool)
+    blue = np.asarray(grid == WALL, dtype=bool)
+    for comp in components_mask(blue):
