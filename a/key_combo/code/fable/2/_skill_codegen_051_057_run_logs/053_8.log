+
+def _colorize_mask(mask: np.ndarray, bg: int, palette: list[int]) -> np.ndarray:
+    tile = np.full((3, 3), int(bg), dtype=int)
+    coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    if not coords:
