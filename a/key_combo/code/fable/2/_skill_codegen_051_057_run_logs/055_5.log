+        "sprite_mask": sprite_mask,
+        "sprite_h": sprite_h,
+        "sprite_w": sprite_w,
+        "placed": placed,
+        "placed_ranks": placed_ranks,
+        "missing_ranks": missing_ranks,
+        "stride": stride,
+        "stack_top": stack_top,
+        "stack_left": stack_left,
