+            compliant_per_row[row_idx] += 1
+            compliant_per_col[col_idx] += 1
+    if min(compliant_per_row) < 2 or min(compliant_per_col) < 2:
+        return False
+
+    shape_slot = meta["shape_slot"]
+    shape_rec = info["exact_slots"].get(shape_slot)
+    if shape_rec is None:
+        return False
