+def _unique_mode(values: list) -> object:
+    counts = Counter(values)
+    top = counts.most_common(2)
+    assert top, "expected at least one vote"
+    if len(top) > 1:
+        assert top[0][1] > top[1][1], "expected a unique majority vote"
+    return top[0][0]
