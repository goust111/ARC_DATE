+ROW_COUNT = 4
+COL_CHOICES = (3, 4)
+SPRITE_SIZE = 3
+ROW_GAP_RANGE = (5, 7)
+COL_GAP_RANGE = (5, 7)
+MARGIN_RANGE = (1, 3)
+MAX_GENERATION_ATTEMPTS = 400
+CLUSTER_TOLERANCE = 2
+MOVE_DELTAS = (-2, -1, 1, 2)
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
