+        for ar, ac in anchor_matches:
+            r0 = int(anchor[0]) - int(ar)
+            c0 = int(anchor[1]) - int(ac)
+            if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+                continue
+
+            ok = True
+            for rr, cc, color in residues:
+                lr = int(rr) - r0
+                lc = int(cc) - c0
+                if local_map.get((lr, lc)) != int(color):
