+def _render_with_residues(
+    shape: tuple[int, int],
+    sprite_patch: np.ndarray,
+    sprite_top_left: tuple[int, int],
+    residue_top_left: tuple[int, int],
+    residues_local: list[tuple[int, int, int]],
