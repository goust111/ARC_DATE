+        grid_h = random.randint(min_h, min(30, min_h + 8))
+        grid_w = random.randint(min_w, min(30, min_w + 8))
+
+        placements = _place_two_copies((grid_h, grid_w), sprite_patch.shape)
+        if placements is None:
