+            bg = get_bg(grid)
+        bg = int(bg)
+        if connectivity != 4:
+            raise ValueError("fallback find_components only supports connectivity=4")
+
+        h, w = grid.shape
+        visited = np.zeros((h, w), dtype=bool)
+        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        out: list[dict] = []
