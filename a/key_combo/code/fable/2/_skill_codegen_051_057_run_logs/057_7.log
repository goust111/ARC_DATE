+            bg = get_bg(grid)
+        bg = int(bg)
+        if connectivity != 4:
+            raise ValueError("fallback find_components only supports connectivity=4")
+
+        h, w = grid.shape
+        visited = np.zeros((h, w), dtype=bool)
+        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        out: list[dict] = []
+
+        allowed = None if colors is None else {int(c) for c in colors}
+
+        for r in range(h):
+            for c in range(w):
+                if visited[r, c]:
+                    continue
+                color = int(grid[r, c])
+                if color == bg:
+                    continue
+                if allowed is not None and color not in allowed:
+                    continue
+
+                visited[r, c] = True
+                q = deque([(r, c)])
+                coords: list[tuple[int, int]] = []
+                while q:
+                    rr, cc = q.popleft()
+                    coords.append((rr, cc))
+                    for dr, dc in dirs:
+                        nr = rr + dr
+                        nc = cc + dc
+                        if not (0 <= nr < h and 0 <= nc < w) or visited[nr, nc]:
