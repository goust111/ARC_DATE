+        allowed = None if colors is None else {int(c) for c in colors}
+
+        for r in range(h):
+            for c in range(w):
+                if visited[r, c]:
+                    continue
+                color = int(grid[r, c])
+                if color == bg:
+                    continue
+                if allowed is not None and color not in allowed:
+                    continue
+
+                visited[r, c] = True
+                q = deque([(r, c)])
+                coords: list[tuple[int, int]] = []
+                while q:
+                    rr, cc = q.popleft()
+                    coords.append((rr, cc))
+                    for dr, dc in dirs:
+                        nr = rr + dr
+                        nc = cc + dc
+                        if not (0 <= nr < h and 0 <= nc < w) or visited[nr, nc]:
+                            continue
+                        ncolor = int(grid[nr, nc])
+                        if ncolor == bg:
+                            continue
+                        if allowed is not None and ncolor not in allowed:
+                            continue
+                        if monochromatic and ncolor != color:
+                            continue
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
