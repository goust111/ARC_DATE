+
+def _rect_overlap(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    pad: int = 0,
+) -> bool:
+    return not (
+        a[2] + int(pad) < b[0]
+        or b[2] + int(pad) < a[0]
+        or a[3] + int(pad) < b[1]
+        or b[3] + int(pad) < a[1]
+    )
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
