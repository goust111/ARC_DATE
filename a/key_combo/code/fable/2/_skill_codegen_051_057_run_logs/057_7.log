+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _random_connected_mask(height: int, width: int, target_area: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
