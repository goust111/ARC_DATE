+def _best_sparse_pool(cells: list[tuple[int, int, int]]) -> list[tuple[int, int, int]]:
+    best: list[tuple[int, int, int]] = []
+    for _ in range(INDEPENDENT_SET_ATTEMPTS):
+        order = cells[:]
+        random.shuffle(order)
+        chosen: list[tuple[int, int, int]] = []
+        for cell in order:
