+                if len(coords) < int(min_area):
+                    continue
+                arr = np.array(coords, dtype=int)
+                r0, c0 = arr.min(axis=0)
+                r1, c1 = arr.max(axis=0)
+                out.append(
+                    {
+                        "color": color if monochromatic else None,
+                        "coords": arr,
+                        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                        "area": int(len(coords)),
