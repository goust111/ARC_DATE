+        mask[nr, nc] = True
+
+    return _crop_mask(mask)
+
+
+def _build_sprite_patch() -> np.ndarray | None:
+    for _ in range(SPRITE_ATTEMPTS):
+        height = random.randint(4, 7)
+        width = random.randint(4, 7)
