+        c = 1
+        for col_width, region in zip(col_widths, row_regions):
+            assert region.shape == (row_height, col_width)
+            grid[r : r + row_height, c : c + col_width] = region
+            c += col_width + 1
+        r += row_height + 1
+    return grid
