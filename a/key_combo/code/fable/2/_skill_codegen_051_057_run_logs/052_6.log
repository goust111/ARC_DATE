+
+
+def _adjacent_duplicate_rows(patch: np.ndarray) -> bool:
+    return any(np.array_equal(patch[r], patch[r - 1]) for r in range(1, patch.shape[0]))
+
+
+def _adjacent_duplicate_cols(patch: np.ndarray) -> bool:
