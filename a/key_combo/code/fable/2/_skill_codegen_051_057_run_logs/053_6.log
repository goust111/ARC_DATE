+def _paint_fallen(out: np.ndarray, base_row: int, col: int, direction: int, length: int, color: int) -> None:
+    for step in range(int(length)):
+        cc = int(col + direction * step)
+        if 0 <= cc < out.shape[1]:
+            out[base_row, cc] = int(color)
