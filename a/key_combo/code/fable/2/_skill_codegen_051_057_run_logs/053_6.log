+    while True:
+        cur = ordered[idx]
+        triggered_cols.append(int(cur["c"]))
+        if idx == len(ordered) - 1:
+            stop_reason = "end"
+            break
+        nxt = ordered[idx + 1]
+        dist = abs(int(nxt["c"]) - int(cur["c"]))
