+    idx = 0
+    stop_reason = "end"
+    while True:
+        cur = ordered[idx]
+        cur_col = int(cur["c"])
+        out[int(cur["top"]) : base_row + 1, cur_col] = BACKGROUND
+        if idx == len(ordered) - 1:
