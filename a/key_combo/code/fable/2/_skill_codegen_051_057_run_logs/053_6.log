+        for i in range(n)
+    ]
+    push_gaps = [0] * (n - 1)
+
+    if mode == "anchor":
+        anchor_idx = random.randint(2, n - 1)
+        push_pillars[anchor_idx]["anchor"] = True
+        for i in range(anchor_idx):
