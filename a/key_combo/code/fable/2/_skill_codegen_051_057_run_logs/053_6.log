+def _find_arrow(grid: np.ndarray) -> tuple[int, set[tuple[int, int]]]:
+    coords = np.argwhere(grid == ARROW_COLOR)
+    assert coords.shape[0] == 5, "expected exactly one 5-cell arrow sprite"
+    r0, c0, r1, c1 = _bbox(coords)
