+    assert h >= 5 and g.ndim == 2
+    ground = int(g[h - 1, 0])
+    assert np.all(g[h - 1, :] == ground), "bottom row must be the ground row"
+    direction, arrow_cells = _find_arrow(g)
+    pillars = _extract_pillars(g, arrow_cells)
