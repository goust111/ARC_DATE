+    _out, info = _simulate(inp)
+    if not np.array_equal(_out, expected):
+        return False
+    if str(info["stop_reason"]) != stop_reason or str(info["stop_reason"]) != mode:
+        return False
+    if list(info["triggered_cols"]) != triggered_cols:
+        return False
+    if int(info["triggered_count"]) < 2:
+        return False
