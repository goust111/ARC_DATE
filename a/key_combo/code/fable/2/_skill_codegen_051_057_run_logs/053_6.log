+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+ARROW_COLOR = 2
+GROUND_COLOR = 3
+ANCHOR_COLOR = 5
+BODY_COLORS = [1, 4, 6, 7, 8, 9]
+
+LEFT_ARROW = np.array(
+    [
+        [1, 0, 0],
+        [1, 1, 1],
+        [1, 0, 0],
+    ],
+    dtype=bool,
+)
+RIGHT_ARROW = np.array(
+    [
+        [0, 0, 1],
+        [1, 1, 1],
+        [0, 0, 1],
+    ],
+    dtype=bool,
+)
+
+MAX_ATTEMPTS = 400
+MODE_CYCLE = ("anchor", "short", "end")
