        candidates: list[tuple[int, int, int, int, np.ndarray]] = []  # (area, bbox_area, r0, c0, mask)

        comps_col = find_components(g, bg=bg, connectivity=8, monochromatic=True, colors=[int(bcol)], return_format="dict")
