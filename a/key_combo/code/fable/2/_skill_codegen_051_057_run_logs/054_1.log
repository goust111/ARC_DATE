+def _random_connected_mask(n: int, forbidden: tuple[int, int], rng: random.Random) -> np.ndarray:
+    available = [(r, c) for r in range(n) for c in range(n) if (r, c) != forbidden]
+    max_cells = min(n + 2, n * n - 2)
