+        start = rng.choice(available)
+        mask = np.zeros((n, n), dtype=bool)
+        mask[start] = True
+        filled = {start}
+
+        while len(filled) < size:
+            frontier: set[tuple[int, int]] = set()
+            for r, c in filled:
