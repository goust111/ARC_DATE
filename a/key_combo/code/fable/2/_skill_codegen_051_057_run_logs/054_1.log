+    try:
+        _validate_case(grid, patterns, targets, bg)
+    except AssertionError:
+        return None
+    return grid
+
+
+_GEN_RNG = random.Random()
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_SCENE_ATTEMPTS):
+        grid = _try_generate_case(_GEN_RNG)
+        if grid is not None:
