        rows, cols = np.indices(inp.shape)
        expected = np.full_like(inp, BACKGROUND_COLOR)
        expected[(rows % 2 == LATTICE_PHASE) | (cols % 2 == LATTICE_PHASE)] = LINE_COLOR
        if np.array_equal(main(inp), expected):
