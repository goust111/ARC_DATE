+        return False
+
+    dists, _ = _distance_stack(g, metric="chebyshev")
+    min_d = dists.min(axis=2)
+    winners = dists == min_d[:, :, None]
+    tie = winners.sum(axis=2) > 1
+    bg = g == BLACK
+
+    added_color = bg & (~tie) & ((min_d % 2) == 0)
+    odd_territory = bg & (~tie) & ((min_d % 2) == 1)
+    gray_front = bg & tie
+
+    if not added_color.any():
