+        _solve_ignore_parity(g),
+        _solve_ignore_ties(g),
+        _solve_overlay_even_rings(g),
+    )
+    if any(np.array_equal(out, wrong) for wrong in wrong_outputs):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
