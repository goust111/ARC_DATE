+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GEN_HEIGHT_RANGE)
+    width = random.randint(*GEN_WIDTH_RANGE)
+    origin = _sample_origin(height, width)
+    anchor_pair = _choose_anchor_pair(height, width, origin)
