    """Return the single nonzero marker as (row, col, color)."""
    fg_coords = np.argwhere(inp != 0)
    assert fg_coords.shape == (1, 2)
    source_r, source_c = map(int, fg_coords[0])
    return source_r, source_c, int(inp[source_r, source_c])


