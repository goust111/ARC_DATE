+    expected, _order = _oracle_expected(grid, origin, objects)
+    if not _validate_case(grid, expected, anchor_cells):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
