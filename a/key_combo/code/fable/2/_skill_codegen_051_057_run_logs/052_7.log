+
+    for idx, color in enumerate(colors[2:], start=2):
+        min_area = 3 if idx == 2 else GEN_EXTRA_AREA_RANGE[0]
+        area = random.randint(min_area, GEN_EXTRA_AREA_RANGE[1])
+        mask = _random_polyomino(area=area, max_span=GEN_MAX_SPAN)
