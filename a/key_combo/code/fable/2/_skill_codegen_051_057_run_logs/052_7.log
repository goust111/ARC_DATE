+    a, b = anchor_list[0], anchor_list[1]
+    sdiff = index_map[(a[0] - origin[0], a[1] - origin[1])] - index_map[(b[0] - origin[0], b[1] - origin[1])]
+    rdiff = (a[0] * width + a[1]) - (b[0] * width + b[1])
