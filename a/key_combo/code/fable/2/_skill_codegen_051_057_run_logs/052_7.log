+
+
+SPIRAL_DIRS = ((-1, 0), (0, 1), (1, 0), (0, -1))  # up, right, down, left
+GEN_COLOR_POOL = [c for c in Color.NOT_BLACK if c != Color.GREY]
+
+GEN_HEIGHT_RANGE = (14, 24)
+GEN_WIDTH_RANGE = (14, 24)
+GEN_OBJECT_COUNT_RANGE = (4, 6)
+GEN_EXTRA_AREA_RANGE = (2, 6)
+GEN_MAX_SPAN = 4
+GEN_PADDING = 1
+GEN_ATTEMPTS = 600
