+        raise ValueError(side)
+    if len(cells) >= 2:
+        non_corner = []
+        h, w = mask.shape
+        for r, c in cells:
+            if r in {0, h - 1} and c in {0, w - 1}:
+                continue
+            non_corner.append((r, c))
+        if non_corner:
+            cells = non_corner
+    return cells
