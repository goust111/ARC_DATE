+def _group_depth(objects: list[dict], side: str) -> int:
+    if side in {"top", "bottom"}:
+        return int(sum(obj["final_patch"].shape[0] for obj in objects))
+    return int(sum(obj["final_patch"].shape[1] for obj in objects))
