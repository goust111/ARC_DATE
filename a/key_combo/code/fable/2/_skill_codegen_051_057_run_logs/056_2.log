+    if not np.all(g[h - 1, :] == bottom):
+        raise ValueError("bottom bar is not solid")
+    if not np.all(g[1 : h - 1, 0] == left):
+        raise ValueError("left bar is not solid")
+    if not np.all(g[1 : h - 1, w - 1] == right):
