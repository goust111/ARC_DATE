+
+def _max_input_offset(final_top_left: tuple[int, int], input_patch: np.ndarray, side: str, shape: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = final_top_left
+    ph, pw = input_patch.shape
+    if side == "top":
+        return int((h - 1 - ph) - r)
+    if side == "bottom":
