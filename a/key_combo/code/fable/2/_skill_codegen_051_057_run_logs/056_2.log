+    if side == "top":
+        edge = int(coords[:, 0].min())
+        cells = [(int(r), int(c)) for r, c in coords if int(r) == edge]
+    elif side == "bottom":
+        edge = int(coords[:, 0].max())
+        cells = [(int(r), int(c)) for r, c in coords if int(r) == edge]
+    elif side == "left":
+        edge = int(coords[:, 1].min())
+        cells = [(int(r), int(c)) for r, c in coords if int(c) == edge]
+    elif side == "right":
+        edge = int(coords[:, 1].max())
+        cells = [(int(r), int(c)) for r, c in coords if int(c) == edge]
