+def _random_connected_mask(h: int, w: int, area: int) -> np.ndarray:
+    cells = {(random.randrange(h), random.randrange(w))}
+    while len(cells) < area:
+        frontier = []
+        for r, c in cells:
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
