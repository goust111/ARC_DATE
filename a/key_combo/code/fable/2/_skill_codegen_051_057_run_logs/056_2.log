+    max0 = _max_input_offset(objects[0]["final_top_left"], objects[0]["input_patch"], side, shape)
+    max1 = _max_input_offset(objects[1]["final_top_left"], objects[1]["input_patch"], side, shape)
+    if min(max0, max1) < 3 or max1 < 5:
