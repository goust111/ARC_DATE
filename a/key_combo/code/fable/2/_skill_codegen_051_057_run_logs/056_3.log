+def _row_marker(grid: np.ndarray, row: int, bg: int) -> tuple[int, int] | None:
+    if grid.shape[1] <= 1:
+        return None
+    cols = np.flatnonzero(grid[int(row), 1:] != bg)
+    assert cols.size <= 1, "each row must contain at most one marker pixel"
+    if cols.size == 0:
