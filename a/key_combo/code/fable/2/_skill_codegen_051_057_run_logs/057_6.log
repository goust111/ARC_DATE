+            if best_dist is None or dist < best_dist:
+                best_dist = dist
+                best_colors = {int(color)}
+            elif dist == best_dist:
+                best_colors.add(int(color))
+        out[r, c] = GREY if len(best_colors) > 1 else next(iter(best_colors))
+    return out
