+def _resolve_head(color: int, mapping: dict[int, int]) -> int:
+    cur = int(color)
+    seen: set[int] = set()
+    while cur in mapping:
+        assert cur not in seen, "legend replacement graph must be acyclic"
+        seen.add(cur)
+        cur = int(mapping[cur])
+    return cur
+
