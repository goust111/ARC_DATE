+    min_sizes = [3 if color in chain_colors_in_target else 4 for color in blob_colors]
+    min_blob_sum = sum(min_sizes)
+
+    choices = []
+    for h in range(6, 11):
+        for w in range(6, 11):
+            area = h * w
+            base_min = max(8, area // 3)
+            if area - base_min >= min_blob_sum:
