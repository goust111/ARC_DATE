+    for rr in range(h):
+        add(rr, 0)
+        add(rr, w - 1)
+    for cc in range(w):
+        add(0, cc)
+        add(h - 1, cc)
+
+    while queue:
+        rr, cc = queue.popleft()
+        for nr, nc in _neighbors4(rr, cc):
+            add(nr, nc)
+
+    inside = ~boundary & ~exterior
+    return {(int(rr + r0), int(cc + c0)) for rr, cc in np.argwhere(inside)}
+
+
+def _paint_coords(grid: np.ndarray, coords: set[tuple[int, int]], color: int) -> None:
+    h, w = grid.shape
+    for r, c in coords:
+        if 0 <= r < h and 0 <= c < w:
+            grid[r, c] = color
