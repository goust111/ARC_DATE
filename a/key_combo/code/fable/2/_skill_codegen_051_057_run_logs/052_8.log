+
+def _sample_decoy_object() -> dict:
+    transforms = ("id", "rot90", "rot180", "rot270", "flip_h", "flip_v", "diag", "anti")
+    for _ in range(OBJECT_ATTEMPTS):
+        span = random.randint(5, 9)
+        end_row = random.choice((-1, 1)) * random.randint(2, 5)
