+
+def _place_objects(objects: list[dict]) -> tuple[np.ndarray, np.ndarray, list[dict]] | None:
+    ordered = sorted(objects, key=lambda obj: int(np.count_nonzero(obj["reserve_mask"])), reverse=True)
