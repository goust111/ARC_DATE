+def _sample_trigger_object(axis_kind: str) -> dict:
+    for _ in range(OBJECT_ATTEMPTS):
+        span = random.randint(5, 9)
+        max_depth = random.randint(2, 5)
+        interior = [random.randint(1, max_depth) for _ in range(span - 1)]
+        if sum(interior) < 5:
