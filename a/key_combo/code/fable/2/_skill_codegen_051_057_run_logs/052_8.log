            local["r0"] = r0
            local["c0"] = c0
            local["patch_h"] = patch_h
            local["patch_w"] = patch_w
            placed.append(local)
            placed_ok = True
            break

        if not placed_ok:
            return None

    return inp, expected, placed


def _absolute_mask(shape: tuple[int, int], obj: dict, key: str) -> np.ndarray:
