        reserve_mask = _dilate8(out != BLACK)
        return {
            "kind": "d",
            "input_patch": inp,
            "output_patch": out,
            "change_mask": np.zeros_like(inp, dtype=bool),
            "reserve_mask": reserve_mask,
            "red_mask": out == RED,
            "yellow_mask": out == YELLOW,
        }
