+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+
+GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 160
+SCENARIOS = [
+    ("h", "v", "d"),
+    ("h", "d", "d"),
+    ("v", "d", "d"),
+    ("h", "h", "d"),
+    ("v", "v", "d"),
+    ("h", "v", "d", "d"),
+    ("h", "v", "h", "d"),
+    ("h", "v", "v", "d"),
+]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_set(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _simple_open_curve(coords: np.ndarray) -> bool:
+    pts = {tuple(map(int, rc)) for rc in coords}
+    endpoints = 0
+    for r, c in pts:
+        deg = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        if deg == 1:
+            endpoints += 1
+        elif deg == 2:
+            continue
+        else:
+            return False
+    return endpoints == 2
+
+
+def _classify_transformable(coords: np.ndarray) -> dict | None:
+    pts = {tuple(map(int, rc)) for rc in coords}
+    degrees: dict[tuple[int, int], int] = {}
+    endpoints: list[tuple[int, int]] = []
+    for r, c in pts:
+        deg = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        degrees[(r, c)] = deg
+        if deg == 1:
+            endpoints.append((r, c))
+        elif deg == 2:
+            continue
+        else:
+            return None
+
+    if len(endpoints) != 2:
+        return None
+
+    a, b = endpoints
+    interior = [rc for rc in pts if rc not in {a, b}]
+    if not interior:
+        return None
+
+    if a[0] == b[0]:
+        axis_kind = "h"
+        axis = a[0]
+        side_values = {np.sign(r - axis) for r, _ in interior}
+        if side_values != {-1} and side_values != {1}:
+            return None
+        ordered = tuple(sorted(endpoints, key=lambda rc: rc[1]))
+        return {"axis_kind": axis_kind, "axis": axis, "side": int(next(iter(side_values))), "endpoints": ordered}
+
+    if a[1] == b[1]:
+        axis_kind = "v"
+        axis = a[1]
+        side_values = {np.sign(c - axis) for _, c in interior}
+        if side_values != {-1} and side_values != {1}:
+            return None
+        ordered = tuple(sorted(endpoints, key=lambda rc: rc[0]))
+        return {"axis_kind": axis_kind, "axis": axis, "side": int(next(iter(side_values))), "endpoints": ordered}
+
+    return None
