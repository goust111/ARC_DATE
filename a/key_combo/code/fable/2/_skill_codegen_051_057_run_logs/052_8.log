+BLACK = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+
+GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 160
+SCENARIOS = [
