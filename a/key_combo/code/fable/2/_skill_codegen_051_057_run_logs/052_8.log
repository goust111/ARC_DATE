+            "kind": axis_kind,
+            "desc": desc,
+            "axis_local": desc["axis"] - (origin[0] if axis_kind == "h" else origin[1]),
+            "input_patch": inp,
+            "output_patch": out,
+            "change_mask": change_mask,
+            "reserve_mask": reserve_mask,
+            "red_mask": out == RED,
+            "yellow_mask": out == YELLOW,
+        }
+    raise RuntimeError(f"failed to sample trigger object: {axis_kind}")
