+    for comp in _components(g == curve_color):
+        completion = _completion_for_component(comp)
+        if completion is None:
+            continue
+
+        _paint_coords(out, completion["mirror"], curve_color)
+        h, w = out.shape
+        for r, c in completion["fill"]:
