+def _sample_scene() -> np.ndarray | None:
+    scenario = random.choice(SCENARIOS)
+    objects = []
+    for kind in scenario:
+        if kind == "h":
+            objects.append(_sample_trigger_object("h"))
+        elif kind == "v":
