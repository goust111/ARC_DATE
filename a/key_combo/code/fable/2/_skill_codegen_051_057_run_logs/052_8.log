+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr0 = max(0, dr)
+            rr1 = h + min(0, dr)
+            cc0 = max(0, dc)
+            cc1 = w + min(0, dc)
+            out[rr0:rr1, cc0:cc1] |= mask[rr0 - dr : rr1 - dr, cc0 - dc : cc1 - dc]
+    return out
+
