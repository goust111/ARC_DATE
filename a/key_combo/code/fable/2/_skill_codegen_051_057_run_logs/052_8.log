+def _absolute_mask(shape: tuple[int, int], obj: dict, key: str) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    local = obj[key]
+    h, w = local.shape
+    out[obj["r0"] : obj["r0"] + h, obj["c0"] : obj["c0"] + w] |= local
