+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+
+GEN_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 160
+SCENARIOS = [
+    ("h", "v", "d"),
+    ("h", "d", "d"),
+    ("v", "d", "d"),
+    ("h", "h", "d"),
+    ("v", "v", "d"),
+    ("h", "v", "d", "d"),
+    ("h", "v", "h", "d"),
+    ("h", "v", "v", "d"),
+]
