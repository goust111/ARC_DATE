+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+STRONG_SHAPES = ((3, 3), (3, 4), (4, 3), (3, 5), (5, 3), (4, 4), (4, 5), (5, 4))
+BOUNDARY_SHAPES = ((2, 4), (4, 2), (2, 5), (5, 2))
+GEN_ATTEMPTS = 500
