+            positions.append(positions[-1] + gap)
+        return size, tuple(positions)
+    return None
+
+
+def _max_extra_row_cols(n_rows: int, n_cols: int) -> int:
+    return min(n_cols - 1, (n_rows * n_cols - 1) // (n_rows + 1))
