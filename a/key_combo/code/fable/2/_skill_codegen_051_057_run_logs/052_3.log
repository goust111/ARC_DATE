+    out = np.full(shape, bg, dtype=int)
+    r0, r1 = rows[0], rows[-1]
+    c0, c1 = cols[0], cols[-1]
+    for r in rows:
+        out[r, c0 : c1 + 1] = fg
+    for c in cols:
+        out[r0 : r1 + 1, c] = fg
+    return out
