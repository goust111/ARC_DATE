+    for c in cols:
+        assert np.all(expected[rows[0] : rows[-1] + 1, c] == fg)
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        built = _build_attempt()
