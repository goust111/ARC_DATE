+        candidates = _closed_bicliques_from_row_masks(row_masks, len(cols))
+        actual = [
+            {
+                "rows": tuple(rows[i] for i in cand["rows_idx"]),
+                "cols": tuple(cols[j] for j in cand["cols_idx"]),
+                "area": cand["area"],
+            }
+            for cand in candidates
+        ]
+    else:
+        col_masks = [0] * len(cols)
+        for r, c in points:
