+            return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    max_depth = random.choice((2, 2, 3))
+    legend_len = max_depth + random.choice((0, 1))
+    wall_count = max_depth + 1
+    if legend_len + wall_count > len(COLOR_POOL):
