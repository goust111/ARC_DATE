+                h, w = item.shape
+                row = margin_top + random.randint(0, canvas.shape[0] - margin_top - margin_bottom - h)
+                window = canvas[row : row + h, col : col + w]
+                assert not np.any((window != BLACK) & (item != BLACK))
+                window[item != BLACK] = item[item != BLACK]
