+
+def _boundary_mask(filled: np.ndarray) -> np.ndarray:
+    h, w = filled.shape
+    boundary = np.zeros_like(filled, dtype=bool)
+    for r, c in np.argwhere(filled):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIRS:
