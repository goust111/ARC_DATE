+def _adjacent_black_components(wall_labels: np.ndarray, black_labels: np.ndarray, wall_id: int) -> set[int]:
+    coords = np.argwhere(wall_labels == int(wall_id))
+    neighbors: set[int] = set()
+    h, w = wall_labels.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIRS:
