+    edge_ids = set(map(int, black_labels[0, :]))
+    edge_ids |= set(map(int, black_labels[-1, :]))
+    edge_ids |= set(map(int, black_labels[:, 0]))
+    edge_ids |= set(map(int, black_labels[:, -1]))
+    boundary = {cid for cid in edge_ids if cid > 0}
