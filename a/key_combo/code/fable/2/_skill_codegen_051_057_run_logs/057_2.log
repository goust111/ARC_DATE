+                bump_h = random.randint(2, base_h - 2)
+                start = random.randint(1, base_h - bump_h - 1)
+                rows = slice(base_r0 + start, base_r0 + start + bump_h)
+                if side == "left":
+                    filled[rows, base_c0 - bump_w : base_c0] = True
+                else:
+                    filled[rows, base_c0 + base_w : base_c0 + base_w + bump_w] = True
