+def _layout_canvas(stacks: list[np.ndarray]) -> np.ndarray:
+    canvas_max_h = 30
+    canvas_max_w = 28
+    items = [np.asarray(stack, dtype=int) for stack in stacks]
+    random.shuffle(items)
