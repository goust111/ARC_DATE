        return False

    row_uniform = any(len(set(map(int, obs[i, :]))) == 1 for i in range(obs.shape[0]))
    col_uniform = any(len(set(map(int, obs[:, j]))) == 1 for j in range(obs.shape[1]))
    if not (row_uniform or col_uniform):
