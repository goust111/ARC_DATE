+    program: list[tuple[int, int]],
+    *,
+    seed_color: int,
+    start_dir_index: int = 0,
+) -> np.ndarray | None:
+    out = np.zeros(shape, dtype=int)
+    sr, sc = map(int, seed)
+    if not _in_bounds(shape, sr, sc):
+        return None
+    out[sr, sc] = int(seed_color)
