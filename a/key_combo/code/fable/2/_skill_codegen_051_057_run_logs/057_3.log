+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (0, 1), (1, 0), (0, -1))  # up, right, down, left
+GEN_ATTEMPTS = 400
