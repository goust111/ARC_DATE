+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        built = _build_case()
+        if built is not None:
+            inp, _out = built
+            return inp
+    raise RuntimeError("failed to generate a valid instruction-stripe polyline input")

