+def _non_separator_spans(is_separator: np.ndarray) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    i = 0
+    n = int(is_separator.size)
+    while i < n:
+        if bool(is_separator[i]):
+            i += 1
+            continue
+        j = i
+        while j < n and not bool(is_separator[j]):
+            j += 1
+        spans.append((i, j))
+        i = j
+    return spans
