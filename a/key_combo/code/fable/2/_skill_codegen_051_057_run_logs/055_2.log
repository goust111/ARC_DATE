+    row_spans = _non_separator_spans(np.all(g == SEP, axis=1))
+    col_spans = _non_separator_spans(np.all(g == SEP, axis=0))
+    assert len(row_spans) >= 2 and len(col_spans) >= 2, "expected a separator-defined block matrix"
