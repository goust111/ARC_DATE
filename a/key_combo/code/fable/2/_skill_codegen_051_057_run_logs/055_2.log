+def _render_matrix(matrix: np.ndarray, row_sizes: list[int], col_sizes: list[int]) -> np.ndarray:
+    rows = len(row_sizes)
+    cols = len(col_sizes)
+    h = sum(row_sizes) + rows - 1
+    w = sum(col_sizes) + cols - 1
+    grid = np.full((h, w), SEP, dtype=int)
