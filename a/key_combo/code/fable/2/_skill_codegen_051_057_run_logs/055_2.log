+    choice_pool = [self_color] + [color for pair in swap_pairs for color in pair] * 2
+    for orbit in pair_orbits:
+        _assign_orbit(hidden, orbit, random.choice(choice_pool), mapping)
+    for orbit in fixed_orbits:
