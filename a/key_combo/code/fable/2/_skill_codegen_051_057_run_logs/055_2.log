+def _orbits(shape: tuple[int, int], transform: str) -> list[list[tuple[int, int]]]:
+    h, w = map(int, shape)
+    seen: set[tuple[int, int]] = set()
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in seen:
+                continue
+            mate = _partner(shape, transform, r, c)
+            orbit = sorted({(r, c), mate})
+            seen.update(orbit)
+            out.append(orbit)
+    return out
