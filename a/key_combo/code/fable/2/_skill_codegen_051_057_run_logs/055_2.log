import numpy as np
import random


def main(grid: np.ndarray) -> np.ndarray:
    """Shear the rectangular input down-left onto a black canvas.

    Input structure
    A rectangular grid of colored pixels with no internal empty region to infer.

    Rule
    Create a black output with the same height and width W + H - 1, then copy
    each input row r unchanged starting at column H - 1 - r.

    Key insight
    The colors and row contents are preserved; only the row offsets change so
    the left edge forms a descending diagonal.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h > 0 and w > 0

    out = np.zeros((h, w + h - 1), dtype=int)
    for r in range(h):
        start = h - 1 - r
        out[r, start : start + w] = g[r]
    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and palette bounds.
MIN_HEIGHT, MAX_HEIGHT = 2, 10
MIN_WIDTH, MAX_WIDTH = 1, 9
MIN_COLOR_COUNT, MAX_COLOR_COUNT = 4, 5
MAX_CELLS, MAX_OUTPUT_WIDTH = 36, 30
PALETTE_VALUES = range(1, 10)

# Fill pattern controls.
FILL_MODES = ("noise", "row_runs", "column_bands", "diagonal_bands")
MAX_ROW_RUN_CUTS = 3
COLUMN_NOISE_PROB = 0.5
MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3
DIAGONAL_FLIP_PROB = 0.5

# Generation safety.
GENERATION_RETRIES = 300


def _ensure_palette_coverage(arr, palette):
    positions = random.sample(range(arr.size), len(palette))
    rows, cols = np.divmod(positions, arr.shape[1])
    arr[rows, cols] = palette


def _fill_grid(h, w, palette):
    k = len(palette)
    mode = random.choice(FILL_MODES)
    arr = np.zeros((h, w), dtype=int)

    if mode == "noise":
        arr[:] = np.random.choice(palette, size=(h, w))
    elif mode == "row_runs":
        for r in range(h):
            cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []
            starts = [0] + cuts
            ends = cuts + [w]
            last = None
            for c0, c1 in zip(starts, ends):
                choices = [c for c in palette if c != last] or list(palette)
                last = random.choice(choices)
                arr[r, c0:c1] = last
    elif mode == "column_bands":
        for c in range(w):
            arr[:, c] = random.choice(palette)
        if random.random() < COLUMN_NOISE_PROB:
            for r in range(h):
                arr[r, random.randrange(w)] = random.choice(palette)
    else:
        band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)
        phase = random.randrange(k)
        rows, cols = np.indices((h, w))
        arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]
        if random.random() < DIAGONAL_FLIP_PROB:
            arr = np.fliplr(arr)

    _ensure_palette_coverage(arr, palette)
    return arr


def _gen_attempt():
    k = random.randint(MIN_COLOR_COUNT, MAX_COLOR_COUNT)
    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)
    widths = [
        w
        for w in range(MIN_WIDTH, MAX_WIDTH + 1)
        if h * w >= k and h * w <= MAX_CELLS and w + h - 1 <= MAX_OUTPUT_WIDTH
    ]
    if not widths:
        return None
    w = random.choice(widths)
    palette = random.sample(PALETTE_VALUES, k)
    return _fill_grid(h, w, palette)


def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations
from collections import Counter, defaultdict
import numpy as np
from scipy.ndimage import label
from arc_utils import STRUCT4, bbox_coords, colors_present, components_mask, paste
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Move bordered containers toward same-colored destination markers, charging gray cells to orange.

    Input structure:
    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.
    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.

    Rule:
    - Each container translates toward its destination along the head-to-dest axis.
    - Steps = min(head-to-dest distance, number of gray interior cells).
    - Gray cells become orange from the head-facing side inward, one per step.

    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    BORDER = 0
    GREY = 5
    FILL = 7
    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    # True background is dominant non-border color (border can dominate in some cases).
    cnt = Counter(map(int, g.flatten()))
    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))

    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):
        for c in range(c0, c1 + 1):
            yield (r0, c)
            yield (r1, c)
        for r in range(r0 + 1, r1):
            yield (r, c0)
            yield (r, c1)

    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---
    containers = []
    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):
        if pts.size == 0:
            continue
        ir0, ic0, ir1, ic1 = bbox_coords(pts)
        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)
        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:
            continue
        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):
            continue
        inner = g[r0 + 1 : r1, c0 + 1 : c1]
        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):
            continue
        containers.append({"box": (r0, c0, r1, c1)})

    assert not (not containers)

    # head + destination are in some non-bg, non-border color (not GREY/FILL)
    out = g.copy()

    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]

    # Precompute components for each head color.
    comp_by_color: dict[int, list[dict]] = defaultdict(list)
    for col in all_head_colors:
        labc, nc = label(g == int(col), structure=STRUCT4)
        for k in range(1, int(nc) + 1):
            coords = np.argwhere(labc == int(k))
            if coords.size == 0:
                continue
            r0, c0, r1, c1 = bbox_coords(coords)
            pts = {(int(r), int(c)) for r, c in coords}
            shape = {(int(r - r0), int(c - c0)) for r, c in pts}
            comp_by_color[int(col)].append({"pts": pts, "shape": shape, "tl": (int(r0), int(c0))})

    def pick_head_for_container(box_):
        r0, c0, r1, c1 = box_
        head_seeds = []
        for r, c in rect_border_coords(r0, c0, r1, c1):
            for dr, dc in DIR4:
                rr, cc = r + dr, c + dc
                if 0 <= rr < H and 0 <= cc < W:
                    val = int(g[rr, cc])
                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):
                        head_seeds.append((rr, cc, val))
        if not head_seeds:
            return None

        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])
        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}
        cands = comp_by_color.get(hc, [])
        comp0 = None
        for comp in cands:
            if comp["pts"] & seed_pts:
                comp0 = comp
                break
        if comp0 is None:
            return None

        # Split head vs destination even if same-color pixels touch:
        # head pixels are those with minimal manhattan distance to this container border.
        border_pts = list(rect_border_coords(r0, c0, r1, c1))
        best_d = None
        dist = {}
        for pr, pc in comp0["pts"]:
            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)
            dist[(int(pr), int(pc))] = int(d)
            if best_d is None or d < best_d:
                best_d = int(d)
        if best_d is None:
            return None
        head_pts = {p for p, d in dist.items() if int(d) == int(best_d)}

        # direction from head bbox relative to container box
        coords = np.array(list(head_pts), dtype=int)
        hr0, hc0, hr1, hc1 = bbox_coords(coords)
        if hc1 < c0:
            direction = (0, -1)
        elif hc0 > c1:
            direction = (0, 1)
        elif hr1 < r0:
            direction = (-1, 0)
        elif hr0 > r1:
            direction = (1, 0)
        else:
            direction = (0, 0)

        # normalized head shape + top-left
        r00, c00 = int(hr0), int(hc0)
        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}
        return {
            "color": hc,
            "head_pts": head_pts,
            "head_shape": head_shape,
            "head_tl": (r00, c00),
            "comp_pts": set(comp0["pts"]),
            "dir": direction,
        }

    for cont in containers:
        box_ = cont["box"]
        r0, c0, r1, c1 = box_

        head_info = pick_head_for_container(box_)
        if head_info is None:
            continue
        hc = int(head_info["color"])
        head_pts = set(head_info["head_pts"])
        head_shape = head_info["head_shape"]
        head_tl = head_info["head_tl"]
        comp_pts = set(head_info["comp_pts"])
        direction = head_info["dir"]
        if direction == (0, 0):
            continue

        # destination candidates
        dests = []
        for d in comp_by_color.get(hc, []):
            if d["shape"] != head_shape:
                continue
            if d["pts"] == comp_pts:
                continue
            dests.append(d)

        # add split-from-same-component destinations (when dest touches head by color)
        rem = comp_pts - head_pts
        if rem:
            mask_rem = np.zeros((H, W), dtype=bool)
            for rr, cc in rem:
                mask_rem[int(rr), int(cc)] = True
            labr, nr = label(mask_rem, structure=STRUCT4)
            for k in range(1, int(nr) + 1):
                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}
                if not pts:
                    continue
                # reject if adjacent to BORDER
                adj = False
                for r, c in pts:
                    for dr, dc in DIR4:
                        rr, cc = int(r + dr), int(c + dc)
                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):
                            adj = True
                            break
                    if adj:
                        break
                if adj:
                    continue
                rs = [r for r, _c in pts]
                cs = [c for _r, c in pts]
                r00, c00 = int(min(rs)), int(min(cs))
                shp = {(int(r - r00), int(c - c00)) for r, c in pts}
                if shp != head_shape:
                    continue
                dests.append({"pts": pts, "shape": shp, "tl": (r00, c00)})

        if not dests:
            continue

        best = None
        best_dest = None
        for d in dests:
            tr0 = int(d["tl"][0] - head_tl[0])
            tc0 = int(d["tl"][1] - head_tl[1])
            if direction[0] != 0 and tc0 != 0:
                continue
            if direction[1] != 0 and tr0 != 0:
                continue
            if direction[0] == 1 and tr0 <= 0:
                continue
            if direction[0] == -1 and tr0 >= 0:
                continue
            if direction[1] == 1 and tc0 <= 0:
                continue
            if direction[1] == -1 and tc0 >= 0:
                continue
            dist = abs(tr0) + abs(tc0)
            if best is None or dist < best:
                best = dist
                best_dest = d
        if best_dest is None:
            continue

        # translation to overlap head onto destination, capped by number of GREY cells
        tr0 = int(best_dest["tl"][0] - head_tl[0])
        tc0 = int(best_dest["tl"][1] - head_tl[1])
        steps = abs(tr0) + abs(tc0)

        inner = g[r0 + 1 : r1, c0 + 1 : c1]
        grey_coords = [
            (int(r0 + 1 + rr), int(c0 + 1 + cc))
            for rr in range(inner.shape[0])
            for cc in range(inner.shape[1])
            if int(inner[rr, cc]) == GREY
        ]
        steps = min(int(steps), int(len(grey_coords)))

        dr, dc = direction
        tr = int(dr * steps)
        tc = int(dc * steps)

        # choose which greys to fill in order from head side inward
        if direction == (0, 1):
            order = sorted(grey_coords, key=lambda p: (-p[1], p[0]))
        elif direction == (0, -1):
            order = sorted(grey_coords, key=lambda p: (p[1], -p[0]))
        elif direction == (1, 0):
            order = sorted(grey_coords, key=lambda p: (-p[0], -p[1]))
        else:  # (-1,0)
            order = sorted(grey_coords, key=lambda p: (p[0], p[1]))
        to_fill = set(order[:steps])

        # erase original container rect and original head pixels (destination stays)
        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
        for r, c in head_pts:
            if int(out[int(r), int(c)]) == int(hc):
                out[int(r), int(c)] = int(bg)

import numpy as np
import random
from arc_utils import Color, draw_line, find_components, paste, random_sprite, translate



# concepts:
# sliding objects

# description:
# In the input you will see a 3x3 grid with a contiguous shape on it.
# Slide the shape down by one pixel.

def main(input_grid):
    """
    Slide the single colored object down by one pixel on a black 3 by 3 grid.

    Input structure:
    - The grid contains one monochromatic connected object.
    - The background is black.
    - The object has room to move down one row.

    Rule:
    - Detect the object's connected component.
    - Translate that component by one row downward.
    - Return the translated object on a black background.

    Key insight:
    - The whole connected shape moves rigidly; no cells are added, removed, or recolored.
    """
    # find the connected component, which is a monochromatic object
    objects = find_components(
        input_grid,
        bg=Color.BLACK,
        connectivity=8,
        monochromatic=True,
        return_format="objects",
    )
    obj = objects[0]

    # translate the object down by one pixel
    output_grid = translate(obj, dr=1, dc=0, background=Color.BLACK)

    return output_grid


def generate_input():
    # first create blank grid
    grid = np.zeros((3, 3), dtype=int)

    # while the grid is empty
    while grid.sum() == 0:

        # generate a random up to 3x3 sprite
        n = random.randint(1, 3)
        m = random.randint(1, 2)
        random_sprite_to_add = random_sprite(n, m, symmetry='not_symmetric', color_palette=[random.choice(Color.NOT_BLACK)])

        # choose a random location on the grid, ensuring the bottom row is empty
        r = random.randint(0, 2)
        c = random.randint(0, 2 - m)

        # place the sprite onto the grid
        paste(grid, random_sprite_to_add, r, c, transparent=Color.BLACK, clip=True)

    return grid
