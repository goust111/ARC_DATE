+def _paint_blocks(
+    template: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    matrix: np.ndarray,
+) -> np.ndarray:
+    out = np.array(template, copy=True)
+    for i, (r0, r1) in enumerate(row_spans):
+        for j, (c0, c1) in enumerate(col_spans):
+            out[r0:r1, c0:c1] = int(matrix[i, j])
+    return out
