+    max_gray = len(pair_orbits) - n_swaps - self_uses_pair
+    if max_gray < 1:
+        return None
+    n_gray = 1 + int(max_gray >= 2 and random.random() < 0.5)
+    n_gray = min(n_gray, max_gray)
