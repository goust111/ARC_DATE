+    candidates: list[np.ndarray] = []
+    scores: list[int] = []
+    for transform_id in range(8):
+        aligned = _apply_d4(right, transform_id)
+        candidates.append(aligned)
+        scores.append(int(np.count_nonzero(left != aligned)))
