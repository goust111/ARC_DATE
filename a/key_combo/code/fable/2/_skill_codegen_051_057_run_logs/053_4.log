+
+def _paint_shape(panel: np.ndarray, mask: np.ndarray, coords: list[tuple[int, int]], r0: int, c0: int, color: int) -> None:
+    for dr, dc in coords:
+        rr = int(r0 + dr)
+        cc = int(c0 + dc)
+        panel[rr, cc] = int(color)
+        mask[rr, cc] = True
