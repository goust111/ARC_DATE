+def _render_output(main_patch: np.ndarray, n: int, color_to_mask: dict[int, np.ndarray], bg: int) -> np.ndarray:
+    mh, mw = main_patch.shape
+    out = np.full((mh * n, mw * n), bg, dtype=int)
