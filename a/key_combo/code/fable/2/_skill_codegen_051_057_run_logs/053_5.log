+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+N_CHOICES = (2, 3, 4, 5)
+GEN_RETRIES = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
