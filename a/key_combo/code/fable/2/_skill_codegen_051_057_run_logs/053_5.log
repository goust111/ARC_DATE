+    for _ in range(60):
+        holes = rng.randint(1, max_holes)
+        cells = [(r, c) for r in range(n) for c in range(n)]
+        hole_cells = set(rng.sample(cells, holes))
+        mask = np.ones((n, n), dtype=bool)
+        for r, c in hole_cells:
+            mask[r, c] = False
