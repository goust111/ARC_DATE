+    if c0 < 0 or c0 + n > w or r + 1 + n > h:
+        return None
+
+    row_span = grid[r, c0 : c0 + n]
+    if int(row_span[offset]) in (bg, GREY):
+        return None
+    if np.count_nonzero(row_span != bg) != 1:
+        return None
