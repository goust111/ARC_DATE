+    if blocked[r - 1, c] and blocked[r + 1, c]:
+        a = int(labels[r, c - 1])
+        b = int(labels[r, c + 1])
+    else:
+        a = int(labels[r - 1, c])
+        b = int(labels[r + 1, c])
+
+    assert a >= 0 and b >= 0 and a != b
+    return a, b
+
