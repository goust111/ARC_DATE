+            out[rr0:rr1, cc0:cc1] = legend_colors[depth[(r, c)] - 1]
+
+    for (a, b) in internal_doors:
+        (r1, c1), (r2, c2) = a, b
+        if r1 == r2:
+            wall_col = bc0 + col_bounds[min(c1, c2)][1] + 1
