+def _label_components(open_mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = open_mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    components: list[np.ndarray] = []
+
+    for sr in range(h):
+        for sc in range(w):
+            if not open_mask[sr, sc] or labels[sr, sc] != -1:
+                continue
+
+            cid = len(components)
+            queue = deque([(sr, sc)])
+            labels[sr, sc] = cid
+            coords = []
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                for nr, nc in _neighbors4(r, c):
