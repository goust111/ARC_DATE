+    for r in range(rows):
+        r0, r1 = row_bounds[r]
+        for c in range(cols):
+            c0, c1 = col_bounds[c]
+            rr0 = br0 + r0
+            rr1 = br0 + r1 + 1
+            cc0 = bc0 + c0
+            cc1 = bc0 + c1 + 1
