+
+
+def _boundary_sides(node: tuple[int, int], rows: int, cols: int) -> list[str]:
+    r, c = node
+    sides = []
+    if r == 0:
+        sides.append("top")
+    if r == rows - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == cols - 1:
+        sides.append("right")
+    return sides
