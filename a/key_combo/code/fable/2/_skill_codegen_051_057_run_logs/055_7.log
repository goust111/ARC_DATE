+    fh = r1 - r0 + 1
+    fw = c1 - c0 + 1
+    if fh < 3 or fw < 3:
+        return False
+    border_area = 2 * fh + 2 * fw - 4
+    if int(coords.shape[0]) != border_area:
+        return False
