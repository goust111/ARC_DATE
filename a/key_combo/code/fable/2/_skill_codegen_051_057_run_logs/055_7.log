+    for _ in range(200):
+        tile = np.array([[random.choice(colors) for _ in range(pw)] for _ in range(ph)], dtype=int)
+        if len(set(map(int, tile.ravel()))) < 2:
+            continue
+        if _minimal_period(tile) != (ph, pw):
