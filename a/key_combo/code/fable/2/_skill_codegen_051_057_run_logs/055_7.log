+def _gen_attempt() -> np.ndarray | None:
+    n_frames = random.randint(*FRAME_COUNT_RANGE)
+    fh = random.randint(*FRAME_OUTER_H_RANGE)
+    fw = random.randint(*FRAME_OUTER_W_RANGE)
+    ih = fh - 2
+    iw = fw - 2
