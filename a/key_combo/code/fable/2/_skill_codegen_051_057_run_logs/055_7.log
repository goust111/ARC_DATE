+    for ph in range(1, h + 1):
+        for pw in range(1, w + 1):
+            mapping: dict[tuple[int, int], int] = {}
+            ok = True
+            for r0, c0 in coords:
+                r = int(r0)
+                c = int(c0)
+                key = (r % ph, c % pw)
+                value = int(g[r, c])
+                prev = mapping.get(key)
+                if prev is None:
+                    mapping[key] = value
+                elif prev != value:
+                    ok = False
+                    break
+            if ok:
+                candidates.append((ph, pw, mapping))
