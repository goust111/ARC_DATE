+def _period_candidates(grid: np.ndarray, observed_mask: np.ndarray) -> list[tuple[int, int, dict[tuple[int, int], int]]]:
+    g = np.asarray(grid, dtype=int)
+    coords = np.argwhere(observed_mask)
+    h, w = g.shape
