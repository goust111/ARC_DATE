    ca0 = max(0, dc)
    ra1 = min(H1, dr + H2)
    ca1 = min(W1, dc + W2)
    if ra0 >= ra1 or ca0 >= ca1:
        return False

    rb0 = ra0 - dr
    cb0 = ca0 - dc
    rb1 = rb0 + (ra1 - ra0)
    cb1 = cb0 + (ca1 - ca0)
    return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())


