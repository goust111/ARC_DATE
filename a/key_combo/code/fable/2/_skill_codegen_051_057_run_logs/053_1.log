+
+def _growth_candidates(
+    shape: tuple[int, int],
+    open_cells: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    rows, cols = map(int, shape)
+    out: set[tuple[int, int]] = set()
+    for cell in open_cells:
+        for nr, nc in neighbors4(*cell):
