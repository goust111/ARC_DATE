+_PLACEMENTS = ("left", "right")
+_LEGEND_STEPS = (2, 3)
+_BLOCK_SIZES = (2, 3, 4)
+_GRID_SIDE_RANGE = range(4, 7)
+_ORIGIN_CHOICES = (1, 2)
+_GAP_RANGE = range(2, 7)
+_MAX_ATTEMPTS = 600
