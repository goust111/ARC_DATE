+def _inverse_snake_fill(seq: list[int], h: int, w: int) -> np.ndarray:
+    block = np.full((h, w), BG, dtype=int)
+    idx = 0
+    for r in range(h):
+        cols = range(w) if r % 2 == 0 else range(w - 1, -1, -1)
+        for c in cols:
+            block[r, c] = seq[idx]
+            idx += 1
