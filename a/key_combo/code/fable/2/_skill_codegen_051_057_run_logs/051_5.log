+    col = 0
+    first = segment_by_color[seq[0]]
+    first_top = first["bbox"][0]
+    _paste(out, first["patch"], first_top, 0, transparent=bg)
+    prev_right_row = first_top + first["right_row"]
+    col += first["patch"].shape[1]
