+        tuple(sorted(parsed_infos, key=lambda color: -parsed_infos[color]["bbox"][1])),
+        tuple(sorted(parsed_infos, key=lambda color: (parsed_infos[color]["bbox"][0], parsed_infos[color]["bbox"][1]))),
