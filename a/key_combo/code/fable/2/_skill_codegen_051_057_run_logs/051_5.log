+BG = 0
+PROGRAM_SHAPES = ((2, 2), (2, 3), (3, 2))
+SEGMENT_HEIGHTS = (3, 4, 5)
+SEGMENT_WIDTHS = (2, 3)
+HEIGHT_RANGE = (10, 16)
