+    placements: dict[int, dict] = {}
+    col = strip_start
+    by_color = {item["color"]: item for item in chain}
+    for index, color in enumerate(strip_order):
+        item = by_color[color]
+        top = tops[color]
+        _paste(grid, item["patch"], top, col, transparent=BG)
