+            chain.append(
+                {
+                    "color": color,
+                    "patch": _render_path(chosen["path"], *chosen["patch_shape"], color),
+                    "left_row": chosen["left_row"],
+                    "right_row": chosen["right_row"],
+                    "output_top": chosen["top"],
+                    "turned": chosen["turned"],
