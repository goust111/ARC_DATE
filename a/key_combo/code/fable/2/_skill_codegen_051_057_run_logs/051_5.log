    c0 = tc - _GEN_FRAME_PAD
    c1 = tc + _GEN_SAMPLE_SIZE + _GEN_FRAME_PAD
    g[r0:r1, c0] = value
    g[r0:r1, c1 - 1] = value
    g[r0, c0:c1] = value
    g[r1 - 1, c0:c1] = value


