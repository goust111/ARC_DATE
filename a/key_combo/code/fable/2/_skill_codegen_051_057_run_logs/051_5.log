    cells.extend((r1, c0 + dc) for dc in range(_FRAME_WIDTH))

    return cells


def _gen_ray_info(frame):
    r0, c0, _h, side = frame
    gap = c0 + _gen_gap_offset(side)
    if side == "left":
        return r0 - 1, slice(0, gap + 1)
    return r0 - 1, slice(gap, _GEN_W)


