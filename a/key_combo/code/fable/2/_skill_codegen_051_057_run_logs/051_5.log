    distinct_min, distinct_max = _GEN_SAMPLE_DISTINCT_MIN_MAX
    nonzero_count = int(rng.integers(nz_min, nz_stop))
    distinct_count = int(rng.integers(distinct_min, min(distinct_max, nonzero_count) + 1))

