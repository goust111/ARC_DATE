+
+def _gen_attempt() -> np.ndarray | None:
+    prog_h, prog_w = _choose_program_shape()
+    seq = random.sample(list(range(1, 10)), prog_h * prog_w)
+    h = random.randint(*HEIGHT_RANGE)
+    program_block = _inverse_snake_fill(seq, prog_h, prog_w)
