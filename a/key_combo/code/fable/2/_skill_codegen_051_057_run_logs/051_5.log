+
+    uniq = []
+    seen = set()
+    for path in paths:
+        if path not in seen:
+            seen.add(path)
+            uniq.append(path)
+    return tuple(uniq)
+
+
+def _choose_program_shape() -> tuple[int, int]:
+    return random.choice(PROGRAM_SHAPES)
+
+
+def _inverse_snake_fill(seq: list[int], h: int, w: int) -> np.ndarray:
+    block = np.full((h, w), BG, dtype=int)
+    idx = 0
+    for r in range(h):
