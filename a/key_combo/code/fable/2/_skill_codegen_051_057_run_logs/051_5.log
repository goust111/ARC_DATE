+    degrees: dict[tuple[int, int], int] = {}
+    endpoints = []
+    for r, c in map(tuple, np.argwhere(mask)):
+        deg = 0
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < patch.shape[0] and 0 <= nc < patch.shape[1] and mask[nr, nc]:
