+        if obj["symmetric"] and below:
+            top = below[0]["row"] - h
+            final_sprite = sprite
+        else:
+            top = g.shape[0] - h
+            final_sprite = np.fliplr(sprite) if (not obj["symmetric"] and len(below) % 2 == 1) else sprite
