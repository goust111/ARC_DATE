+            r0, c0, r1, c1 = _bbox(np.isin(np.indices(grid.shape).transpose(1, 2, 0), coords).all(axis=2))  # type: ignore[arg-type]
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+            sprite[coords[:, 0] - r0, coords[:, 1] - c0] = color
