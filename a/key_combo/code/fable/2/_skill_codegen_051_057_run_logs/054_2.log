+
+def _sprite_from_heights(heights: np.ndarray, color: int) -> np.ndarray:
+    h = int(heights.max())
+    w = int(heights.size)
+    sprite = np.zeros((h, w), dtype=int)
+    for c, col_h in enumerate(heights.tolist()):
+        sprite[h - int(col_h) :, c] = color
+    return sprite
