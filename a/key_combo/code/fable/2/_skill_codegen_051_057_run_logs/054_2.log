+    view[mask] = patch[mask]
+
+
+def _is_lr_symmetric(sprite: np.ndarray) -> bool:
+    mask = sprite != BLACK
+    return bool(np.array_equal(mask, np.fliplr(mask)))
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
