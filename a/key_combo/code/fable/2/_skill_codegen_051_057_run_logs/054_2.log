+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int = BLACK) -> None:
+    h, w = patch.shape
+    r1, c1 = r0 + h, c0 + w
+    assert 0 <= r0 <= r1 <= dst.shape[0]
+    assert 0 <= c0 <= c1 <= dst.shape[1]
