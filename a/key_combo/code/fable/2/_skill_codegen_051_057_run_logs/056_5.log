+
+def _is_solid_square(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    side_r = int(r1 - r0 + 1)
+    side_c = int(c1 - c0 + 1)
+    return side_r == side_c and int(comp["area"]) == side_r * side_c
