+            placements.append((cargo, (r0, c0)))
+            next_col = c0 - 1
+        return placements
+    if direction == "left":
+        ordered = sorted(cargos, key=lambda cargo: cargo["bbox"][1])
+        next_col = 1
+        for cargo in ordered:
+            size = int(cargo["size"])
+            r0 = int(cargo["bbox"][0])
+            c0 = int(next_col)
+            placements.append((cargo, (r0, c0)))
+            next_col = c0 + size
