135:def _corner_path(h: int, w: int) -> set[tuple[int, int]]:
136:    """Generate a diagonal path from one corner of an (h,w) bbox to the opposite."""
137:    if h == 1 and w == 1:
138:        return {(0, 0)}
139:    r0 = random.choice([0, h - 1])
140:    c0 = random.choice([0, w - 1])
141:    r1 = h - 1 - r0
142:    c1 = w - 1 - c0
143:    steps = max(h, w)
144:    cells: set[tuple[int, int]] = set()
145:    for k in range(steps):
146:        t = 0.0 if steps == 1 else k / (steps - 1)
147:        cells.add((int(round(r0 + (r1 - r0) * t)),
148:                    int(round(c0 + (c1 - c0) * t))))
149:    return cells
152:def _random_sprite(color: int) -> np.ndarray:
153:    """Create a small random 8-connected sprite with the given color on BG."""
154:    area = random.randint(SPRITE_AREA_MIN, SPRITE_AREA_MAX)
155:    choices = [
156:        (sh, sw)
157:        for sh in range(1, SPRITE_H_MAX + 1)
158:        for sw in range(1, SPRITE_W_MAX + 1)
159:        if max(sh, sw) <= area <= sh * sw
160:        and area / (sh * sw) >= SPRITE_DENSITY_MIN
161:    ]
162:    sh, sw = random.choice(choices)
163:    cells = _corner_path(sh, sw)
164:    while len(cells) < area:
165:        frontier = []
166:        for r, c in cells:
167:            for dr in (-1, 0, 1):
168:                for dc in (-1, 0, 1):
169:                    if dr == 0 and dc == 0:
170:                        continue
171:                    rr, cc = r + dr, c + dc
172:                    if 0 <= rr < sh and 0 <= cc < sw and (rr, cc) not in cells:
173:                        frontier.append((rr, cc))
174:        cells.add(random.choice(frontier))
176:    sprite = np.full((sh, sw), BG, dtype=int)
177:    rs, cs = zip(*cells)
178:    sprite[rs, cs] = color
179:    return sprite
