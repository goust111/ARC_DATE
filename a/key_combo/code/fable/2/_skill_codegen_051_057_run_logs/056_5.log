+    if direction == "up":
+        ordered = sorted(cargos, key=lambda cargo: cargo["bbox"][0])
+        next_row = 1
+        for cargo in ordered:
+            size = int(cargo["size"])
+            r0 = int(next_row)
+            c0 = int(cargo["bbox"][1])
