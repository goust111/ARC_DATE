+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        try:
+            grid, arrows, cargos, bg = _generate_scene()
+        except ValueError:
+            continue
+        expected = _validate_scene(grid, arrows, cargos, bg)
+        if expected is None:
+            continue
+        if max(grid.shape) > 30 or max(expected.shape) > 30:
+            continue
+        return grid
