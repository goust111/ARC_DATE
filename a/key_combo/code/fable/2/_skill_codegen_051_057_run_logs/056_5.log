20:def main(grid: np.ndarray) -> np.ndarray:
21:    """
22:    Move each colored object vertically until it touches the matching top or bottom border bar.
24:    Input structure:
25:    - The background is the dominant color.
26:    - The top row is a full-width bar in one foreground color and the bottom row is a full-width bar in another.
27:    - All other foreground pixels are 8-connected monochrome objects whose color matches one of those bars.
29:    Rule:
30:    - Top-bar-colored objects move upward so their bbox top is row 1.
31:    - Bottom-bar-colored objects move downward so their bbox bottom is the row above the bottom bar.
32:    - A downward-moving one-column segment whose landing overlaps its source becomes the continuous vertical segment swept between them.
34:    Key insight:
35:    The horizontal bars are destination anchors: color determines which border an object slides toward, while columns and object shape are otherwise preserved.
36:    """
37:    g = np.asarray(grid, dtype=int)
38:    assert g.ndim == 2
39:    h, w = g.shape
40:    assert h >= 3 and w >= 1
42:    bg = int(get_bg(g))
43:    top_color = int(g[0, 0])
44:    bottom_color = int(g[h - 1, 0])
46:    assert top_color != bg
47:    assert bottom_color != bg
48:    assert top_color != bottom_color
49:    assert bool(np.all(g[0, :] == top_color))
50:    assert bool(np.all(g[h - 1, :] == bottom_color))
51:    assert set(map(int, np.unique(g))) == {bg, top_color, bottom_color}
53:    for c in range(w):
54:        top_rows = [r for r in range(1, h - 1) if int(g[r, c]) == top_color]
55:        bot_rows = [r for r in range(1, h - 1) if int(g[r, c]) == bottom_color]
56:        if top_rows and bot_rows:
57:            assert max(top_rows) < min(bot_rows), "top-color objects must be above bottom-color objects in every column"
59:    out = np.full_like(g, bg)
60:    out[0, :] = top_color
61:    out[h - 1, :] = bottom_color
63:    for color, target_side in ((top_color, "top"), (bottom_color, "bottom")):
64:        components = find_components(
65:            g,
66:            bg=bg,
67:            connectivity=8,
68:            monochromatic=True,
69:            colors=[color],
70:            return_format="dict",
71:        )
72:        for comp in components:
73:            if _is_full_width_border(comp, h, w):
74:                continue
76:            coords = np.asarray(comp["coords"], dtype=int)
77:            r0, c0, r1, c1 = map(int, comp["bbox"])
78:            assert 0 < r0 <= r1 < h - 1
80:            if target_side == "top":
81:                dr = 1 - r0
82:                assert dr <= 0
83:                paint = coords + np.array([dr, 0], dtype=int)
84:            else:
85:                dr = (h - 2) - r1
86:                assert dr >= 0
87:                paint = coords + np.array([dr, 0], dtype=int)
88:                if dr > 0 and r0 + dr <= r1:
89:                    assert c0 == c1
90:                    rows = np.arange(r0, r1 + dr + 1, dtype=int)
91:                    paint = np.column_stack([rows, np.full(rows.shape, c0, dtype=int)])
93:            assert bool(np.all((0 <= paint[:, 0]) & (paint[:, 0] < h)))
94:            assert bool(np.all((0 <= paint[:, 1]) & (paint[:, 1] < w)))
95:            assert bool(np.all(out[paint[:, 0], paint[:, 1]] == bg))
96:            out[paint[:, 0], paint[:, 1]] = color
98:    return out
