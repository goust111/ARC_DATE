+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+ARROW_TEMPLATES = {
+    "up": {
+        "shape": (4, 3),
+        "cells": {(0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (3, 1)},
+        "tip": (0, 1),
+        "delta": (-1, 0),
+    },
+    "down": {
+        "shape": (4, 3),
+        "cells": {(0, 1), (1, 1), (2, 0), (2, 1), (2, 2), (3, 1)},
+        "tip": (3, 1),
+        "delta": (1, 0),
+    },
+    "left": {
+        "shape": (3, 4),
+        "cells": {(0, 1), (1, 0), (1, 1), (1, 2), (1, 3), (2, 1)},
+        "tip": (1, 0),
+        "delta": (0, -1),
