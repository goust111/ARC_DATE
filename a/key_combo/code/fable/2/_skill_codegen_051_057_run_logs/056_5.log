+            next_col = c0 - 1
+        return placements
+    if direction == "left":
+        ordered = sorted(cargos, key=lambda cargo: cargo["bbox"][1])
+        next_col = 1
+        for cargo in ordered:
+            size = int(cargo["size"])
+            r0 = int(cargo["bbox"][0])
+            c0 = int(next_col)
+            placements.append((cargo, (r0, c0)))
+            next_col = c0 + size
+        return placements
+    if direction == "down":
+        ordered = sorted(cargos, key=lambda cargo: cargo["bbox"][0], reverse=True)
+        next_row = h - 2
+        for cargo in ordered:
+            size = int(cargo["size"])
+            r0 = int(next_row - size + 1)
+            c0 = int(cargo["bbox"][1])
+            placements.append((cargo, (r0, c0)))
+            next_row = r0 - 1
