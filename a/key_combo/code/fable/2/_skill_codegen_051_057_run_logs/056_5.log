+        dtype=int,
+    )
+    return {
+        "kind": "cargo",
+        "color": int(color),
+        "coords": coords,
+        "bbox": (int(r0), int(c0), int(r0 + size - 1), int(c0 + size - 1)),
+        "size": int(size),
