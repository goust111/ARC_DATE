53:    heights = [int(np.random.randint(1, 5)) for _ in range(n_runs)]
54:    if heights[0] + 2 * sum(heights[1:]) > 30:
55:        return None
56:    cols: list[int] = []
57:    prev = None
58:    for _ in range(n_runs):
