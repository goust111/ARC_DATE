+        if family == "horizontal":
+            r0 = random.randint(1, h - 1 - size)
+            if any((r0 + delta) in lanes for delta in range(size)):
+                continue
+            c0 = random.randint(1, w - 1 - size)
+        else:
+            c0 = random.randint(1, w - 1 - size)
+            if any((c0 + delta) in lanes for delta in range(size)):
+                continue
+            r0 = random.randint(1, h - 1 - size)
