4:def main(grid: np.ndarray) -> np.ndarray:
5:    """
6:    Build nested square frames from a stack of horizontal color stripes.
8:    Input structure:
9:    - Full-width horizontal stripes of distinct non-bg colors, stacked vertically.
10:    - Each stripe has uniform color and variable height (1-4 rows).
12:    Rule:
13:    - Read stripes bottom to top.
14:    - Bottom stripe becomes the center solid square with side length = stripe height.
15:    - Each subsequent stripe wraps the current shape with a square frame of thickness = stripe height, in that stripe's color.
17:    Key insight: Stripe height doubles as both frame thickness and (for the innermost) center-square side length; output dimensions are fully determined by the stripe heights.
18:    """
19:    g = np.array(grid, dtype=int)
20:    H, _W = g.shape
22:    # Parse stripe runs from bottom to top.
23:    runs: list[tuple[int, int]] = []  # (color, height), bottom -> top
24:    r = int(H - 1)
25:    while r >= 0:
26:        col = int(g[int(r), 0])
27:        h = 1
28:        rr = int(r - 1)
29:        while rr >= 0 and bool((g[int(rr)] == int(col)).all()):
30:            h += 1
31:            rr -= 1
32:        runs.append((int(col), int(h)))
33:        r = int(rr)
35:    assert not (not runs)
37:    c0, h0 = runs[0]
38:    cur = np.full((int(h0), int(h0)), int(c0), dtype=int)
40:    for col, h in runs[1:]:
41:        h = int(h)
42:        new_n = int(cur.shape[0] + 2 * h)
43:        nxt = np.full((new_n, new_n), int(col), dtype=int)
44:        nxt[h : h + cur.shape[0], h : h + cur.shape[1]] = cur
45:        cur = nxt
47:    return cur
