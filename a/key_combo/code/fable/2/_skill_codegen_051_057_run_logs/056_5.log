+
+def _random_same_lane_spectator(
+    family: str,
+    direction: str,
+    lane: int,
+    tip: int,
+    size: int,
+    color: int,
+    shape: tuple[int, int],
+) -> dict | None:
+    h, w = shape
+    if family == "horizontal":
+        if direction == "right":
+            hi = tip - size - 3
+            if hi < 1:
+                return None
+            c0 = random.randint(1, hi)
+        else:
+            lo = tip + 4
+            hi = w - 1 - size
+            if lo > hi:
+                return None
+            c0 = random.randint(lo, hi)
+        return _square_object(lane, c0, size, color)
+    if direction == "down":
+        hi = tip - size - 3
+        if hi < 1:
+            return None
+        r0 = random.randint(1, hi)
+    else:
+        lo = tip + 4
+        hi = h - 1 - size
+        if lo > hi:
+            return None
+        r0 = random.randint(lo, hi)
+    return _square_object(r0, lane, size, color)
+
+
+def _place_random_offlane_spectator(
+    grid: np.ndarray,
+    occupancy: np.ndarray,
+    cargo_occupancy: np.ndarray,
+    family: str,
+    lanes: set[int],
+    cargo_color: int,
+) -> dict | None:
+    h, w = grid.shape
+    for _ in range(200):
