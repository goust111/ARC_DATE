+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+
+    for sr, sc in np.argwhere(mask):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in NEIGHBORS8:
+                rr = r + dr
+                cc = c + dc
