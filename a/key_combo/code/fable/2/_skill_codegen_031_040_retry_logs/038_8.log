+    if branch != 0 and not any(i != winner_idx and area > areas[winner_idx] for i, area in enumerate(areas)):
+        return False
+    if clipped_required and not _object_touches_room_edge(objects[winner_idx]["coords"], objects[winner_idx]["room"]):
