+
+
+def _touches_object(grid: np.ndarray, r: int, c: int, object_color: int) -> bool:
+    for dr, dc in NEIGHBORS4:
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and int(grid[nr, nc]) == int(object_color):
