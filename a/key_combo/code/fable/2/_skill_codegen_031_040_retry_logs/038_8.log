+            queue: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[Coord] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or not bool(mask[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
