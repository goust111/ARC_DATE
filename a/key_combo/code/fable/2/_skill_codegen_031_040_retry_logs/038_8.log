    return False


def _mark(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
    for r, c in coords:
        blocked[r, c] = True


def _place_sequence(
    shape: tuple[int, int],
    blocked: np.ndarray,
    orientation: str,
    lawful: bool,
    kind: str,
    rng: random.Random,
) -> dict | None:
