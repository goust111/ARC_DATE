+    return False
+
+
+def _marker_candidates(grid: np.ndarray, room: Room, bg: int, object_color: int, placed: list[Coord]) -> list[Coord]:
+    r0, c0, r1, c1 = room
+    candidates: list[Coord] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if int(grid[r, c]) != int(bg):
