def _carve_path(mask: np.ndarray, start: tuple[int, int], target: tuple[int, int]) -> tuple[int, int]:
    r, c = start
    tr, tc = target
    mask[r, c] = True
    while (r, c) != (tr, tc):
        choices: list[tuple[int, int]] = []
        if r < tr:
