+
+MIN_GRID_SIZE = 24
+MAX_GRID_SIZE = 30
+KEY_COUNT_RANGE = (2, 4)
+SHAPE_H_RANGE = (3, 5)
+SHAPE_W_RANGE = (3, 6)
+SHAPE_AREA_RANGE = (5, 10)
+GENERATION_ATTEMPTS = 800
+SHAPE_ATTEMPTS = 400
+PLACE_ATTEMPTS = 1000
+PAD = 1
+MARGIN = 1
