    (0, 1): OP_CW,
    (1, 0): OP_MIRROR_LR,
    (1, 1): OP_FLIP_UD,
}
OP_TO_MISSING = {op: corner for corner, op in MISSING_TO_OP.items()}


def _same_grid(a: np.ndarray, b: np.ndarray) -> bool:
