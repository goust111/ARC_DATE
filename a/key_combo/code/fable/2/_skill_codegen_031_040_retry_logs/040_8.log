        paste(expected, out_patch, r, c, transparent=GEN_BG)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    pair = _gen_pair_shapes()
    if pair is None:
        return None
    try:
        inp, expected = _render_candidate(*pair)
        actual = main(inp)
    except Exception:
