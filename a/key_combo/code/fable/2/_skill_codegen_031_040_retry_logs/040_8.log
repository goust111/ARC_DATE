+            stack = [(start_r, start_c)]
+            seen[start_r, start_c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in DIR4:
+                    nr = r + dr
+                    nc = c + dc
+                    if (
