+    shelf_mask, gaps_by_row = _shelves_and_gaps(g)
+    blocks = _find_blocks(g)
+
+    out = g.copy()
+    for b in blocks:
+        r, c, n = int(b["r"]), int(b["c"]), int(b["n"])
+        out[r : r + n, c : c + n] = BG
