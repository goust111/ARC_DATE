+        for gw in sorted(gap_widths, reverse=True):
+            choices = list(range(1, width - gw))
+            random.shuffle(choices)
+            placed = False
+            for start in choices:
+                end = start + gw - 1
+                if all(end < a - 1 or start > b + 1 for a, b in gaps):
+                    gaps.append((start, end))
+                    placed = True
+                    break
+            if not placed:
+                break
