+def _draw_shelves(
+    shape: tuple[int, int],
+    rows: list[int],
+    gap_specs: dict[int, list[tuple[int, int]]],
+) -> np.ndarray:
+    h, w = shape
+    g = np.full((h, w), BG, dtype=int)
+    for r in rows:
