+def _solve_with_log(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h <= 30 and w <= 30
