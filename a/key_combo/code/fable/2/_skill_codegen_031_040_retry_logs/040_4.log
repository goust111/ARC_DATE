+        return None
+    if not any(kind in event_kinds for kind in ("vertical_collision", "horizontal_collision")):
+        return None
+    if "slide" not in event_kinds or "pass_gap" not in event_kinds:
+        return None
+    if max(pass_counts, default=0) < 2:
