+    shelf_count = random.choice([3, 4])
+    rows = [first_shelf]
+    for _ in range(shelf_count - 1):
+        rows.append(rows[-1] + random.randint(4, 6))
+    if rows[-1] > h - 4:
+        return None
+
+    gap_specs: dict[int, list[tuple[int, int]]] = {}
