+    c_choices: list[int],
+    first_shelf: int,
+    pad: int = 1,
+) -> bool:
+    random.shuffle(r_choices)
+    random.shuffle(c_choices)
+    for r in r_choices:
+        if r < 0 or r + n > first_shelf:
+            continue
+        for c in c_choices:
+            if c < 0:
+                continue
+            if _overlaps_existing(blocks, r, c, n, pad=pad):
