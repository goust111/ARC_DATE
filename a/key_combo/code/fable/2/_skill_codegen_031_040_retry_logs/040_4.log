+def _overlaps_existing(blocks: list[dict], r: int, c: int, n: int, pad: int = 0) -> bool:
+    r0, c0, r1, c1 = r - pad, c - pad, r + n - 1 + pad, c + n - 1 + pad
+    for b in blocks:
