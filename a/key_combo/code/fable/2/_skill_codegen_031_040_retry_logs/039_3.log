+        if bool(np.all(g[r, :] == g[r, 0]))
+    ]
+    col_candidates = [
+        (c, int(g[0, c]))
+        for c in range(cols)
+        if bool(np.all(g[:, c] == g[0, c]))
+    ]
+
+    matches: list[tuple[int, int, int]] = []
+    for r, row_color in row_candidates:
+        if r != rows - r - 1:
+            continue
+        for c, col_color in col_candidates:
+            if c != cols - c - 1:
