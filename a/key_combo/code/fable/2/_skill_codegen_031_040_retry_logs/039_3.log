+def _gen_attempt(call_index: int) -> np.ndarray | None:
+    n = random.randint(6, 10)
+    palette = list(range(10))
+    bg = random.choice(palette)
+    rest = [color for color in palette if color != bg]
+    sep = random.choice(rest)
