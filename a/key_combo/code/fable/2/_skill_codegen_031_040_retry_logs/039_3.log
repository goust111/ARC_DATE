+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+_D4_NAMES = ("id", "r90", "r180", "r270", "flip_h", "flip_v", "diag", "anti")
+_QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
+_ROW_MAJOR = ((0, 0), (0, 1), (1, 0), (1, 1))
+_OLD_QUADRANT_ORDER = ((0, 0), (1, 1), (1, 0), (0, 1))
+_GEN_RETRIES = 500
+_GEN_CALL_COUNT = 0
