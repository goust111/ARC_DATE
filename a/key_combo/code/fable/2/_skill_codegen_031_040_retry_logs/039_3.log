+def _find_separator(g: np.ndarray) -> tuple[int, int, int]:
+    rows, cols = g.shape
+    row_candidates = [
+        (r, int(g[r, 0]))
+        for r in range(rows)
+        if bool(np.all(g[r, :] == g[r, 0]))
+    ]
+    col_candidates = [
+        (c, int(g[0, c]))
+        for c in range(cols)
+        if bool(np.all(g[:, c] == g[0, c]))
