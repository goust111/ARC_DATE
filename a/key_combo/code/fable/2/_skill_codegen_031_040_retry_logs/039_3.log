def _normalized_mask(g: np.ndarray, color: int) -> tuple[tuple[int, ...], ...]:
    box = bbox(g == color)
    assert box is not None, "color must be present"
    r0, c0, r1, c1 = box
    mask = (g[r0 : r1 + 1, c0 : c1 + 1] == color).astype(int)
    return tuple(tuple(int(v) for v in row) for row in mask)


