def _gen_nearest_mask_coord(mask, point):
    coords = np.argwhere(mask)
    pr, pc = point
    distances = np.maximum(np.abs(coords[:, 0] - pr), np.abs(coords[:, 1] - pc))
    best = coords[distances == distances.min()]
    r, c = random.choice(best).tolist()
