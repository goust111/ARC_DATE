+def _render_input_and_expected() -> tuple[np.ndarray, np.ndarray] | None:
+    outer_h = random.randint(6, 9)
+    outer_w = random.randint(7, 11)
+    if outer_h == outer_w:
+        outer_w += 1
+    master_anchor = random.choice(ROLES)
+    if random.random() < 0.65:
