+    internal = np.zeros(grid.shape, dtype=bool)
+    for row_span in row_spans[1:]:
+        for col_span in col_spans[1:]:
+            r0, r1 = row_span
+            c0, c1 = col_span
+            internal[r0 : r1 + 1, c0 : c1 + 1] = True
+    changed_internal = (actual != grid) & internal
+    if not changed_internal.any():
+        return None
+    return grid
