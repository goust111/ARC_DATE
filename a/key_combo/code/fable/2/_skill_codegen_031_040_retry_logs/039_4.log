+    locks = [_extract_lock(_block(g, row_spans[0], col_spans[j]), bg) for j in range(1, len(col_spans))]
+
+    out = g.copy()
+    for ri, row_span in enumerate(row_spans[1:]):
+        for cj, col_span in enumerate(col_spans[1:]):
+            source = _block(g, row_span, col_span)
