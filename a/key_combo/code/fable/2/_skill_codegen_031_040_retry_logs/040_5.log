+        path: list[Room] = []
+        for i in range(rows):
+            ordered_cols = range(cols) if i % 2 == 0 else range(cols - 1, -1, -1)
+            path.extend((i, j) for j in ordered_cols)
+    else:
+        path = []
+        for j in range(cols):
+            ordered_rows = range(rows) if j % 2 == 0 else range(rows - 1, -1, -1)
+            path.extend((i, j) for i in ordered_rows)
