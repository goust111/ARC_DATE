+    move_dirs = {(b[0] - a[0], b[1] - a[1]) for a, b in zip(path, path[1:])}
+    if not any(dr != 0 for dr, _dc in move_dirs):
+        return None
+    if not any(dc != 0 for _dr, dc in move_dirs):
+        return None
