+def _carve_path(mask: np.ndarray, start: tuple[int, int], target: tuple[int, int]) -> tuple[int, int]:
+    r, c = start
+    tr, tc = target
+    mask[r, c] = True
+    while (r, c) != (tr, tc):
+        choices: list[tuple[int, int]] = []
+        if r < tr:
+            choices.append((1, 0))
+        elif r > tr:
+            choices.append((-1, 0))
+        if c < tc:
+            choices.append((0, 1))
+        elif c > tc:
+            choices.append((0, -1))
+        dr, dc = random.choice(choices)
+        r += dr
+        c += dc
+        mask[r, c] = True
+    return int(r), int(c)
