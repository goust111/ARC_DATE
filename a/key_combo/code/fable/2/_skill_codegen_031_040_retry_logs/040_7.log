+
+def _apply_op(sprite: np.ndarray, op: str) -> np.ndarray:
+    if op == OP_CCW:
+        return np.rot90(sprite, 1).copy()
+    if op == OP_CW:
+        return np.rot90(sprite, -1).copy()
+    if op == OP_MIRROR_LR:
+        return np.fliplr(sprite).copy()
+    if op == OP_FLIP_UD:
+        return np.flipud(sprite).copy()
+    raise AssertionError(f"unknown operation {op}")
