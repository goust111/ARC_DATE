+
+BLACK = Color.BLACK
+RED = Color.RED
+GREY = Color.GREY
+
+OP_CCW = "rotate_ccw"
+OP_CW = "rotate_cw"
+OP_MIRROR_LR = "mirror_lr"
+OP_FLIP_UD = "flip_ud"
+OPS = (OP_CCW, OP_CW, OP_MIRROR_LR, OP_FLIP_UD)
+
+MISSING_TO_OP = {
+    (0, 0): OP_CCW,
+    (0, 1): OP_CW,
+    (1, 0): OP_MIRROR_LR,
+    (1, 1): OP_FLIP_UD,
