+def _apply_program(sprite: np.ndarray, ops: list[str] | tuple[str, ...]) -> np.ndarray:
+    out = np.asarray(sprite, dtype=int).copy()
+    for op in ops:
+        out = _apply_op(out, op)
+    return out
