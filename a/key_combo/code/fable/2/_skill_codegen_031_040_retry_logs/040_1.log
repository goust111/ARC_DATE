+    rect, _runs = _infer_hidden_rectangle(g)
+    return _render(g, rect)
+
+
+def _paint_stopped_segments(
+    grid: np.ndarray,
+    rect: tuple[int, int, int, int],
+    line_color: int,
+    left_rows: list[int],
+    right_rows: list[int],
+    top_cols: list[int],
+    bottom_cols: list[int],
+) -> None:
