+        elif v_candidates:
+            v_count = 1
+
+    for r in h_candidates[:h_count]:
+        grid[r, :] = line_color
+        specs.append(("h", r))
+    for c in v_candidates[:v_count]:
+        grid[:, c] = line_color
+        specs.append(("v", c))
+    return specs
+
+
+def _path_clear(
+    grid: np.ndarray,
+    path: list[tuple[int, int]],
+    reserved_paths: set[tuple[int, int]],
+) -> bool:
