+            rect,
+            side,
+            pixel_colors[color_index % len(pixel_colors)],
+            reserved_paths,
+        )
+        color_index += 1
+        if placed is not None:
+            aligned.append(placed)
+
+    distractors: list[tuple[int, int, int]] = []
+    for _ in range(random.randint(1, 3)):
