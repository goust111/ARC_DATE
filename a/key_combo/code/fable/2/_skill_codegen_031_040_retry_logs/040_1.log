+
+from arc_utils import Color, in_bounds, neighbors8
+
+
+BG = Color.BLACK
+GREY = Color.GREY
+MIN_SEGMENT_LEN = 2
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
