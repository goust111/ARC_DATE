+def _boundary_runs(grid: np.ndarray) -> dict[str, list[dict[str, int]]]:
+    height, width = map(int, grid.shape)
+    runs: dict[str, list[dict[str, int]]] = {
+        "left": [],
+        "right": [],
+        "top": [],
+        "bottom": [],
+        "full_h": [],
+        "full_v": [],
+    }
+
+    for r in range(height):
+        color = int(grid[r, 0])
+        if color != BG:
