+    specs: list[tuple[str, int]] = []
+
+    h_candidates = [r for r in range(1, height - 1) if r <= top - 2 or r >= bottom + 2]
+    v_candidates = [c for c in range(1, width - 1) if c <= left - 2 or c >= right + 2]
