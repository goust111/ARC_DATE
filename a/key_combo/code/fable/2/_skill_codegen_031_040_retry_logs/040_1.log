+    for c in top_cols:
+        grid[:top, c] = line_color
+    for c in bottom_cols:
+        grid[bottom + 1 : height, c] = line_color
+
+
+def _paint_full_distractor_lines(
+    grid: np.ndarray,
+    rect: tuple[int, int, int, int],
+    line_color: int,
+) -> list[tuple[str, int]]:
+    top, left, bottom, right = rect
