+def _wrong_global_interior(
+    shape: tuple[int, int],
+    frames: list[tuple[int, int, int, int, int]],
+    cycle: tuple[int, ...],
+) -> np.ndarray:
+    out = np.full(shape, BLACK, dtype=int)
+    for r0, c0, r1, c1, color in frames:
