+def _separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if bool(np.all(grid[r, :] == GREY))]
+    assert len(rows) == 1, "expected exactly one full-width grey separator row"
+    return int(rows[0])
