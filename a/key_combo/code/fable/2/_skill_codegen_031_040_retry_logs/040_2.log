+    top_anchor, top_mask, top_color = _panel_anchor_and_mask(top)
+    bottom_anchor, bottom_mask, bottom_color = _panel_anchor_and_mask(bottom)
+    assert top_color != bottom_color, "the two panel masks must use different colors"
