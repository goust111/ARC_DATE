+
+def _partition_mask(mask: np.ndarray, areas: list[int]) -> list[np.ndarray] | None:
+    if len(areas) == 1:
+        return [mask.copy()] if int(mask.sum()) == int(areas[0]) and _is_connected_mask(mask) else None
+
+    first = int(areas[0])
+    if first <= 0 or first >= int(mask.sum()):
+        return None
