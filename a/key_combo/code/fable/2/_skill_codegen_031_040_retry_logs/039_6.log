+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(h, r + height + pad)
+    c1 = min(w, c + width + pad)
+    reserved[r0:r1, c0:c1] = True
+
+
+def _draw_frame(grid: np.ndarray, r: int, c: int, height: int, width: int, color: int) -> dict:
