+    placements: list[tuple[int, int, int]] = []
+    seen: set[int] = set()
+    for pr in range(height - piece["h"] + 1):
+        for pc in range(width - piece["w"] + 1):
+            bits = 0
+            for lr, lc in piece["cells"]:
+                bits |= 1 << ((pr + lr) * width + pc + lc)
+            if bits not in seen:
+                seen.add(bits)
+                placements.append((bits, pr, pc))
