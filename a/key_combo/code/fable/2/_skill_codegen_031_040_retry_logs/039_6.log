+    grid[r : r + height + 2, c] = color
+    grid[r : r + height + 2, c + width + 1] = color
+    return {
+        "color": color,
+        "bbox": (r, c, r + height + 1, c + width + 1),
+        "origin": (r + 1, c + 1),
+        "shape": (height, width),
+        "area": height * width,
+    }
