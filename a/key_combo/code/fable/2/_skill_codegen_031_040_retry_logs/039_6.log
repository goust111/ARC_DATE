+
+def _piece_from_component(comp: dict) -> dict:
+    r0, c0, r1, c1 = comp["bbox"]
+    local = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in comp["coords"]))
+    return {
+        "color": int(comp["color"]),
+        "cells": local,
+        "h": r1 - r0 + 1,
+        "w": c1 - c0 + 1,
+        "area": int(comp["area"]),
+        "source": tuple(sorted((int(r), int(c)) for r, c in comp["coords"])),
