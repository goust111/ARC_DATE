+
+def _place_scene(pieces: list[dict], design_frames: list[dict]) -> tuple[np.ndarray, np.ndarray] | None:
+    rows = random.randint(MIN_CANVAS, MAX_CANVAS)
+    cols = random.randint(MIN_CANVAS, MAX_CANVAS)
