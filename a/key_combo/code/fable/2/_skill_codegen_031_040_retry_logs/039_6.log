+
+
+def _frame_from_component(comp: dict) -> dict:
+    r0, c0, r1, c1 = comp["bbox"]
+    return {
+        "color": int(comp["color"]),
+        "bbox": (r0, c0, r1, c1),
+        "origin": (r0 + 1, c0 + 1),
+        "shape": (r1 - r0 - 1, c1 - c0 - 1),
+        "area": (r1 - r0 - 1) * (c1 - c0 - 1),
