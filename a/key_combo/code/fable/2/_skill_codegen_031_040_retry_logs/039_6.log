+        for frame_idx, bits, pr, pc in best_feasible:
+            assigned[best_piece] = (frame_idx, bits, pr, pc)
+            if frame_idx == 0:
+                new_occ0, new_occ1 = occ0 | bits, occ1
+            else:
+                new_occ0, new_occ1 = occ0, occ1 | bits
