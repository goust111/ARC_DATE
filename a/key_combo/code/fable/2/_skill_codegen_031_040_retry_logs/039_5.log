                            ("BL", (bottom, left)),
                            ("BR", (bottom, right)),
                        ]
                    )

    total_corners = sum(len(by_role) for by_role in corners.values())
    assert len(used) == total_corners
    assert len(set(used)) == total_corners
    assert len(frames) > 0
    return frames


