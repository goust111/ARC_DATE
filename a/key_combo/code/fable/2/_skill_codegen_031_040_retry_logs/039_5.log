+
+def _inside_box(r: int, c: int, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _missing_rect(grid: np.ndarray, axis: int) -> tuple[tuple[int, int, int, int], str]:
+    black = grid == BLACK
+    box = _bbox(black)
