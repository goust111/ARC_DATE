+
+def _learn_left_to_right(
+    grid: np.ndarray, axis: int, hole: tuple[int, int, int, int]
+) -> tuple[dict[int, int], dict[int, int]]:
+    h, _w = grid.shape
+    mapping: dict[int, int] = {}
+    inverse: dict[int, int] = {}
