+    assert int(np.count_nonzero(black)) == (r1 - r0 + 1) * (c1 - c0 + 1), "no black outside the missing rectangle"
+
+    if c1 < axis:
+        side = "left"
+    elif c0 > axis:
+        side = "right"
+    else:
+        raise AssertionError("missing rectangle must lie strictly on one side of the separator")
+    return box, side
+
+
+def _learn_left_to_right(
