+
+BLACK = 0
+BLUE = 1
+YELLOW = 4
+MAGENTA = 6
+ORANGE = 7
+
+Coord = tuple[int, int]
+
+
+def _in_bounds(shape: tuple[int, int], p: Coord) -> bool:
+    r, c = p
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
