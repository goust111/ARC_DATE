+def _trace(shape: tuple[int, int], source: Coord, pivots: tuple[Coord, ...]) -> tuple[list[Coord], list[Coord]]:
+    used: set[Coord] = set()
+    pivot_steps: list[Coord] = []
+    landings: list[Coord] = []
+    current = source
+
