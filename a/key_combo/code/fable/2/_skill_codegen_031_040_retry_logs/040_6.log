+    candidates: list[Coord] = []
+    for r in range(h):
+        for c in range(w):
+            p = (r, c)
+            if p in occupied:
+                continue
+            if not _separated(p, occupied):
+                continue
+            if any(_aligned(p, q) for q in trajectory):
+                continue
+            candidates.append(p)
+
+    if len(candidates) < count:
