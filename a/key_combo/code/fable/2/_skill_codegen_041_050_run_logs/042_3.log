    chain_colors = [HEAD_BORDER] + chain_tail
    centers = chain_colors[1:] + [BACKGROUND]
    specs = [{"border": border, "center": center} for border, center in zip(chain_colors, centers)]

    min_side = max(12, 5 * math.ceil(math.sqrt(n_boxes)) - 1)
