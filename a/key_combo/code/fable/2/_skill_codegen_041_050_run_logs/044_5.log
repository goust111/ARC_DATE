+        colors[group["odd_corner"]] = feature_color
+        grid[r0, c0] = colors["tl"]
+        grid[r0, c1] = colors["tr"]
+        grid[r1, c0] = colors["bl"]
+        grid[r1, c1] = colors["br"]
