+def _neighbors8(shape: tuple[int, int], r: int, c: int):
+    h, w = shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                yield nr, nc
+
+
+def _foreground_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(g[r, c]) == bg:
+                continue
+
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            colors: set[int] = set()
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                colors.add(int(g[rr, cc]))
+                for nr, nc in _neighbors8((h, w), rr, cc):
+                    if visited[nr, nc] or int(g[nr, nc]) == bg:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            components.append(
+                {
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                    "colors": colors,
