+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+PALETTE = tuple(range(10))
+TEMPLATE_BODY_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+CORNER_NAMES = ("tl", "tr", "bl", "br")
+CORNER_OFFSETS = {
+    "tl": (0, 0),
+    "tr": (0, -1),
+    "bl": (-1, 0),
+    "br": (-1, -1),
