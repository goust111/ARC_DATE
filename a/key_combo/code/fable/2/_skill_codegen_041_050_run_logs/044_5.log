+def _render_without_rotation(
+    grid: np.ndarray,
+    template: np.ndarray,
+    groups: list[dict],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for group in groups:
+        r0, c0, r1, c1 = group["outer_bbox"]
+        scaled = scale_sprite(template, group["scale"])
+        out[r0 + 1 : r1, c0 + 1 : c1] = scaled
+    return out
+
