+        rotated = _rotate_to_corner(template, feature_color, group["odd_corner"])
+        scaled = scale_sprite(rotated, group["scale"])
+        assert scaled.shape == (r1 - r0 - 1, c1 - c0 - 1)
+        out[r0 + 1 : r1, c0 + 1 : c1] = scaled
