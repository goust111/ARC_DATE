+                            "interior_bbox": (int(r0 + 1), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+                            "markers": frozenset(corners.values()),
+                            "odd_corner": odd_corner,
+                            "scale": int(side // template_size),
+                        }
