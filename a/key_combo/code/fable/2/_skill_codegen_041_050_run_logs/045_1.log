+        if max_row < 0:
+            return None
+        candidates = []
+        for row in range(max_row + 1):
+            for col in range(width - shape["width"] + 1):
+                box = (row, col, row + shape["height"] - 1, col + shape["width"] - 1)
+                if box[2] >= height - 1:
+                    continue
+                if any(_box_touches(box, other, padding=1) for other in placed_boxes):
