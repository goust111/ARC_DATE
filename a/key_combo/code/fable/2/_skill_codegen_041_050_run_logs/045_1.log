+        "bbox": (r0, c0, r1, c1),
+        "area": int(coords.shape[0]),
+        "height": int(r1 - r0 + 1),
+        "width": int(c1 - c0 + 1),
+    }
+
+
+def _extract_scene(grid: np.ndarray) -> tuple[int, int, int, list[dict], list[int]]:
