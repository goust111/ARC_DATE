+        key = lambda obj: (-obj["area"], obj["bbox"][1], obj["bbox"][0])
+    elif pair_mode == "size_asc":
+        key = lambda obj: (obj["area"], obj["bbox"][1], obj["bbox"][0])
+    elif pair_mode == "source_x":
+        key = lambda obj: (
+            obj["bbox"][1] + obj["bbox"][3],
+            obj["bbox"][1],
+            -obj["area"],
