+
+def _component_record(coords: np.ndarray) -> dict:
+    r0, c0, r1, c1 = _bbox(coords)
+    return {
+        "coords": coords.astype(int),
+        "bbox": (r0, c0, r1, c1),
+        "area": int(coords.shape[0]),
+        "height": int(r1 - r0 + 1),
+        "width": int(c1 - c0 + 1),
+    }
