+def _frame_mask(shape: tuple[int, int], box: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
