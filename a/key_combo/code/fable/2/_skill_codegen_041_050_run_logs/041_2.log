+    order: list[int] = []
+    ready = sorted(node for node in nodes if indegree[node] == 0)
+    while ready:
+        assert len(ready) == 1, "crossing constraints must determine a unique layer order"
+        node = ready.pop()
+        order.append(node)
+        for dst in sorted(edges[node]):
