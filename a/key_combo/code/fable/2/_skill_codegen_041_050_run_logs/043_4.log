+def _orbit_positions(r: int, c: int, h: int, w: int) -> tuple[tuple[int, int], ...]:
+    pts = {
+        (int(r), int(c)),
+        (int(h - 1 - r), int(c)),
+        (int(r), int(w - 1 - c)),
+        (int(h - 1 - r), int(w - 1 - c)),
+    }
+    return tuple(sorted(pts))
+
