+            vals = [int(patch[rr, cc]) for rr, cc in orbit]
+            fg_colors = {v for v in vals if v != bg}
+            if len(fg_colors) != 1:
+                continue
+            if all(v == bg for v in vals) or all(v != bg for v in vals):
