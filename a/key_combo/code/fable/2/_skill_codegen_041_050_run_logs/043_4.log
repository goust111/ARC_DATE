+    defect_mask = _find_defect_mask(patch, bg)
+    defect_box = bbox(defect_mask)
+    assert defect_box is not None, "expected a non-empty hidden defect"
+    defect_crop = crop_bbox(defect_mask.astype(int), defect_box).astype(bool)
