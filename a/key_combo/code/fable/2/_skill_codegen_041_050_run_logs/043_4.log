+        rot = np.rot90(mask, k)
+        for candidate in (rot, np.fliplr(rot)):
+            key = candidate.shape.__repr__().encode() + candidate.astype(np.uint8).tobytes()
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(candidate.copy())
