+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+EMPTY = -1
+PALETTE = tuple(range(10))
+CLUTTER_SHAPES = (
+    np.array([[1]], dtype=bool),
+    np.array([[1, 1]], dtype=bool),
+    np.array([[1], [1]], dtype=bool),
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1], [1], [1]], dtype=bool),
