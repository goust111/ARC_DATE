_GEN_BG, _GEN_FG = 0, 2
_GEN_SPRITE_SIZE, _GEN_SPRITE_COUNT, _GEN_PAIR_COUNT = 3, 4, 2
_GEN_MIN_FG_PIXELS, _GEN_MAX_FG_PIXELS = 4, 9
_GEN_INPUT_MIN_SIZE, _GEN_INPUT_MAX_SIZE = 16, 23
_GEN_OUTPUT_SIZE, _GEN_MAX_ATTEMPTS = 7, 300
