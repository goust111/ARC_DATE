+def _sample_canvas(panel_h: int, panel_w: int) -> tuple[int, int, int, int] | None:
+    for _ in range(100):
+        extra_h = random.randint(3, 30 - panel_h)
+        extra_w = random.randint(3, 30 - panel_w)
+        top = random.randint(0, extra_h)
+        bottom = extra_h - top
+        left = random.randint(0, extra_w)
+        right = extra_w - left
