+        while int(mask.sum()) < target_size:
+            rows, cols = np.argwhere(mask).T
+            have_top = bool(np.any(rows < h // 2))
+            have_bottom = bool(np.any(rows >= h // 2))
+            have_left = bool(np.any(cols < w // 2))
+            have_right = bool(np.any(cols >= w // 2))
+            frontier: set[Coord] = set()
+            for r, c in map(tuple, np.argwhere(mask)):
+                for nr, nc in _neighbors4(int(r), int(c)):
+                    if not allowed(nr, nc):
+                        continue
+                    if mask[nr, nc]:
+                        continue
+                    if _orbit_key(h, w, nr, nc) in used_keys:
+                        continue
+                    frontier.add((nr, nc))
+            if not frontier:
+                break
