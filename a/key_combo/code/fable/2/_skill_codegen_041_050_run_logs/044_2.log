+import numpy as np
+
+
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
+PALETTE = tuple(range(10))
+GEN_RETRIES = 500
+SPRITE_CATEGORY_WEIGHTS = (
+    ("one_quadrant", 1),
+    ("vertical_cross", 2),
+    ("horizontal_cross", 2),
+    ("double_cross", 2),
+)
