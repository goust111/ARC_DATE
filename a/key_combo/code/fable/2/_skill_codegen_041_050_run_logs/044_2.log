+                    frontier.add((nr, nc))
+            if not frontier:
+                break
+            best = max(_candidate_priority(mask, category, cell) for cell in frontier)
+            options = [cell for cell in frontier if _candidate_priority(mask, category, cell) == best]
+            nr, nc = random.choice(options)
+            mask[nr, nc] = True
+            used_keys.add(_orbit_key(h, w, nr, nc))
