/bin/bash -lc "python - <<'PY'
import random, math
import numpy as np


def divisors(n):
    return [d for d in range(1,n+1) if n%d==0]

def minimal_period(tile):
    h,w=tile.shape
    best=(h,w)
    best_area=h*w
    for pr in divisors(h):
        for pc in divisors(w):
            ok=True
            for r in range(h):
                for c in range(w):
                    if tile[r,c] "'!= tile[r%pr,c%pc]:
                        ok=False; break
                if not ok: break
            if ok:
                area=pr*pc
                if area<best_area or (area==best_area and (pr,pc)<best):
                    best=(pr,pc); best_area=area
    return best

def sample_primitive(h,w,palette):
    for _ in range(1000):
        t=np.random.choice(palette,size=(h,w))
        if len(set(map(int,t.ravel())))<2:
            continue
        if minimal_period(t)==(h,w):
            return t
    raise RuntimeError('"'no tile')

def phase_table(cells,pr,pc):
    tile=np.full((pr,pc),-1,dtype=int)
    for r,c,color in cells:
        tr,tc=r%pr,c%pc
        known=tile[tr,tc]
        if known==-1:
            tile[tr,tc]=color
        elif known"'!=color:
            return None
    return tile

def fill_table(tile,cells):
    t=tile.copy()
    for r,c,color in cells:
        tr,tc=r%t.shape[0],c%t.shape[1]
        known=t[tr,tc]
        if known==-1:
            t[tr,tc]=color
        elif known!=color:
            return None
    return t

def gen_once():
    branch=random.choice(['"'row','col','both'])
    pr=random.choice([6,8,9])
    pc=random.choice([5,6,8,9])
    row_divs=[d for d in divisors(pr) if d<pr]
    col_divs=[d for d in divisors(pc) if d<pc]
    if branch=='row':
        if not row_divs: return None
        fr=random.choice([d for d in row_divs if pr//d>=2])
        fc=pc
    elif branch=='col':
        if not col_divs: return None
        fr=pr
        fc=random.choice([d for d in col_divs if pc//d>=2])
    else:
        if not row_divs or not col_divs: return None
        fr=random.choice([d for d in row_divs if pr//d>=2])
        fc=random.choice([d for d in col_divs if pc//d>=2])
    if pr < 5 or pc < 5: return None
    if 30//pr < 3 or 30//pc < 3: return None
    reps_r=random.randint(3,30//pr)
    reps_c=random.randint(3,30//pc)
    if reps_r*reps_c < 9: return None
    palette=random.sample(list(range(1,10)), random.randint(3,5))
    false_tile=sample_primitive(fr,fc,palette)
    true_tile=np.tile(false_tile,(pr//fr,pc//fc))
    rr=random.randint(1,pr-4)
    cc=random.randint(1,pc-4)
    rect=[(r,c) for r in range(rr,rr+3) for c in range(cc,cc+3)]
    used_extra=set(map(int,true_tile.ravel()))
    all_colors=list(range(1,10))
    for r,c in rect:
        options=[x for x in all_colors if x"'!=int(true_tile[r,c])]
        true_tile[r,c]=random.choice(options)
    if minimal_period(true_tile)!=(pr,pc):
        return None
    out=np.tile(true_tile,(reps_r,reps_c))
    inp=out.copy()
    rect_copies=[]
    for i in range(reps_r):
        for j in range(reps_c):
            r0=rr+i*pr
            c0=cc+j*pc
            inp[r0:r0+3,c0:c0+3]=0
            rect_copies.append((r0,c0))
    random.shuffle(rect_copies)
    for (lr,lc),(r0,c0) in zip(rect,rect_copies):
        inp[r0+(lr-rr), c0+(lc-cc)] = out[r0+(lr-rr), c0+(lc-cc)]
    outer=[]; surv=[]
    inside=np.zeros_like(inp,dtype=bool)
    for r0,c0 in rect_copies:
        inside[r0:r0+3,c0:c0+3]=True
    for r in range(inp.shape[0]):
        for c in range(inp.shape[1]):
            if inp[r,c]==0: continue
            (surv if inside[r,c] else outer).append((r,c,int(inp[r,c])))
    outer_cands=[]; final=[]
    H,W=inp.shape
    for rper in range(1,H+1):
        for cper in range(1,W+1):
            t=phase_table(outer,rper,cper)
            if t is None: continue
