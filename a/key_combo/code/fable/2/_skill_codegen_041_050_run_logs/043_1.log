+    try:
+        rectangles = _detect_rectangles(inp)
+        if len(rectangles) != int(expected_rectangles):
+            return False
+        if any((r1 - r0 + 1, c1 - c0 + 1) != (RECT_SIZE, RECT_SIZE) for r0, c0, r1, c1 in rectangles):
+            return False
