def _transform_mask(mask: np.ndarray) -> np.ndarray:
    out = np.array(mask, dtype=bool, copy=True)
    out = np.rot90(out, random.randrange(4))
    if random.random() < 0.5:
        out = np.fliplr(out)
    return out.copy()


def _make_rect_mask() -> np.ndarray:
    h = random.randint(2, 4)
    w = random.randint(2, 5)
    return np.ones((h, w), dtype=bool)


def _make_l_mask() -> np.ndarray:
    h = random.randint(3, 5)
    w = random.randint(3, 5)
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[:, 0] = True
    return mask


def _make_c_mask() -> np.ndarray:
    h = random.randint(3, 5)
    w = random.randint(3, 5)
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    return mask


def _make_t_mask() -> np.ndarray:
    h = random.randint(3, 5)
    w = random.choice((3, 5))
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[:, w // 2] = True
    return mask


def _make_stair_mask() -> np.ndarray:
    h = random.randint(3, 5)
    w = random.randint(3, 5)
    mask = np.zeros((h, w), dtype=bool)
    span = min(h, w)
    for idx in range(span):
        mask[idx, idx] = True
        if idx + 1 < w:
            mask[idx, idx + 1] = True
    return mask


