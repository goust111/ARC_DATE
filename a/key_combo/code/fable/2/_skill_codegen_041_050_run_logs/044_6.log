from __future__ import annotations
import numpy as np
from arc_utils import colors_present, crop_bbox, find_components, get_bg, paste, random_free_location
from arc_utils import find_components, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.

    Input structure:
    - bg = background color.
    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).

    Rule:
    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).

    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # Find multicolor connected components of the foreground as a whole.
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (len(comps) != 2)

    infos = []
    for comp in comps:
        patch = crop_bbox(g, comp["bbox"])
        cols = colors_present(patch, exclude={bg})
        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})

    # Building block is the component with >=2 colors (or more unique colors), preferring square.
    infos.sort(
        key=lambda d: (
            len(d["cols"]) >= 2,
            len(d["cols"]),
            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
        ),
        reverse=True,
    )
    block = infos[0]["patch"]
    ctrl = infos[1]["patch"]

    bh, bw = map(int, block.shape)
    ch, cw = map(int, ctrl.shape)

    ctrl_cols = colors_present(ctrl, exclude={bg})
    if not ctrl_cols:
        return np.full((0, 0), int(bg), dtype=int)

    ctrl_col = int(ctrl_cols[0])
    mask = (ctrl == int(ctrl_col))

    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if bool(mask[r, c]):
                paste(out, block, r * bh, c * bw)
    return out

# --------------- generator (Codex#3) ---------------

def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
    seen: set[tuple[int, int]] = set()
    out: list[tuple[list[tuple[int, int]], bool]] = []
    s = int(size)
    for r in range(s):
        for c in range(s):
            if (r, c) in seen:
                continue
            orbit = {
                (r, c),
                (c, s - 1 - r),
                (s - 1 - r, s - 1 - c),
                (s - 1 - c, r),
                (r, s - 1 - c),
                (s - 1 - r, c),
                (c, r),
                (s - 1 - c, s - 1 - r),
            }
            cells = sorted(orbit)
            seen.update(cells)
            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
            out.append((cells, border))
    return out


def _make_tile(bg: int, fg_colors: list[int], rng: np.random.Generator) -> np.ndarray:
    size = int(rng.integers(3, 6))
    n_tile_colors = int(rng.integers(2, 4))
    tile_colors = list(rng.choice(fg_colors, size=n_tile_colors, replace=False))
    orbits = _dihedral_orbits(size)
    rng.shuffle(orbits)

    tile = np.full((size, size), int(bg), dtype=int)
    assignments: dict[int, int] = {}
    for i, color in enumerate(tile_colors):
        assignments[i] = int(color)

    interior_idxs = [i for i, (_cells, border) in enumerate(orbits) if not border and i not in assignments]
    if interior_idxs and rng.random() < 0.25:
        assignments[int(rng.choice(interior_idxs))] = int(bg)

    for i, (_cells, border) in enumerate(orbits):
        if i not in assignments:
            palette = tile_colors if border else tile_colors + ([bg] if interior_idxs else [])
            assignments[i] = int(rng.choice(palette))

    for i, (cells, _border) in enumerate(orbits):
        for r, c in cells:
            tile[r, c] = assignments[i]
    return tile


def _neighbors8(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            rr = r + dr
            cc = c + dc
            if 0 <= rr < h and 0 <= cc < w:
                out.append((rr, cc))
    return out


def _make_ctrl(bg: int, color: int, rng: np.random.Generator) -> np.ndarray:
    h = int(rng.integers(3, 6))
    w = int(rng.integers(3, 6))
    area = h * w
    min_fill = (area + 1) // 2
    max_fill = int(np.floor(0.72 * area))
    target = int(rng.integers(min_fill, max_fill + 1))

    ar = int(rng.integers(0, h))
    ac = int(rng.integers(0, w))
    mask = np.zeros((h, w), dtype=bool)
    mask[:, ac] = True
    mask[ar, :] = True

    while int(mask.sum()) < target:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if any(mask[rr, cc] for rr, cc in _neighbors8(h, w, r, c)):
                    frontier.append((r, c))
        pick = frontier[int(rng.integers(len(frontier)))]
        mask[pick] = True

    ctrl = np.full((h, w), int(bg), dtype=int)
    ctrl[mask] = int(color)
    return ctrl


def _compose_output(tile: np.ndarray, ctrl: np.ndarray, bg: int) -> np.ndarray:
    th, tw = tile.shape
    ch, cw = ctrl.shape
    out = np.full((ch * th, cw * tw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if ctrl[r, c] != bg:
                paste(out, tile, r * th, c * tw)
    return out


def _make_input(tile: np.ndarray, ctrl: np.ndarray, bg: int, rng: np.random.Generator) -> np.ndarray:
    horizontal = bool(rng.integers(0, 2))
    gap = 1

    if horizontal:
        if rng.random() < 0.5:
            left_obj, right_obj = tile, ctrl
        else:
            left_obj, right_obj = ctrl, tile
        lh, lw = left_obj.shape
        rh, rw = right_obj.shape
        H = int(rng.integers(max(10, max(lh, rh)), 19))
        W = int(rng.integers(max(10, lw + rw + gap), 19))
        slack = W - (lw + rw + gap)
        c_left = int(rng.integers(0, slack + 1))
        c_right = int(rng.integers(c_left + lw + gap, W - rw + 1))
        r_left = int(rng.integers(0, H - lh + 1))
        r_right = int(rng.integers(0, H - rh + 1))
        if left_obj is tile:
            tile_pos = (r_left, c_left)
            ctrl_pos = (r_right, c_right)
        else:
            ctrl_pos = (r_left, c_left)
            tile_pos = (r_right, c_right)
    else:
        if rng.random() < 0.5:
            top_obj, bot_obj = tile, ctrl
        else:
            top_obj, bot_obj = ctrl, tile
        th, tw = top_obj.shape
        bh, bw = bot_obj.shape
        H = int(rng.integers(max(10, th + bh + gap), 19))
        W = int(rng.integers(max(10, max(tw, bw)), 19))
        slack = H - (th + bh + gap)
        r_top = int(rng.integers(0, slack + 1))
        r_bot = int(rng.integers(r_top + th + gap, H - bh + 1))
        c_top = int(rng.integers(0, W - tw + 1))
        c_bot = int(rng.integers(0, W - bw + 1))
        if top_obj is tile:
            tile_pos = (r_top, c_top)
            ctrl_pos = (r_bot, c_bot)
        else:
            ctrl_pos = (r_top, c_top)
            tile_pos = (r_bot, c_bot)

    grid = np.full((H, W), int(bg), dtype=int)
    paste(grid, tile, *tile_pos)
    paste(grid, ctrl, *ctrl_pos, transparent=bg)
    return grid


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    palette = list(rng.choice(np.arange(10, dtype=int), size=5, replace=False))
    bg = int(palette[0])
    fg = [int(x) for x in palette[1:]]

    tile = _make_tile(bg, fg, rng)
    ctrl = _make_ctrl(bg, fg[-1], rng)
    inp = _make_input(tile, ctrl, bg, rng)
    expected = _compose_output(tile, ctrl, bg)

    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    if len(comps) != 2:
        return None
    colors_per_comp = []
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        patch = inp[r0 : r1 + 1, c0 : c1 + 1]
        colors_per_comp.append(sorted(set(int(x) for x in patch.flatten()) - {bg}))
    if sorted(len(cols) for cols in colors_per_comp) != [1, len(set(tile.flatten()) - {bg})]:
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(300):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate valid input")
import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Cycle each solid odd-sided square to the next smaller centered square, wrapping a single pixel to a 9x9 square.

    Input structure:
    - The grid has one dominant background color.
    - Every foreground object is a separated 4-connected monochrome solid square.
    - Square side lengths are odd and belong to the cycle 1, 3, 5, 7, 9.

    Rule:
    - Clear the canvas to the background.
    - Keep each square's color and center.
    - Replace side length n by n - 2 when n > 1; replace side length 1 by side length 9.

    Key insight:
    - The visible operation is on square size, not color: side lengths cycle 1 -> 9 -> 7 -> 5 -> 3 -> 1.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert components, "expected at least one foreground square"

    out = np.full_like(g, bg)
    painted = np.zeros(g.shape, dtype=bool)
    H, W = g.shape

    for obj in components:
        color = int(obj["color"])
        r0, c0, r1, c1 = obj["bbox"]
        side = int(r1 - r0 + 1)
        assert side == int(c1 - c0 + 1), "foreground object must have a square bbox"
        assert side in {1, 3, 5, 7, 9}, "square side length must be in the odd-size cycle"
        assert int(obj["area"]) == side * side, "foreground object must fill its bbox"
        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "foreground object must be solid"

        new_side = 9 if side == 1 else side - 2
        center_r = int((r0 + r1) // 2)
        center_c = int((c0 + c1) // 2)
        nr0 = center_r - new_side // 2
        nc0 = center_c - new_side // 2
        nr1 = nr0 + new_side
        nc1 = nc0 + new_side
        assert 0 <= nr0 < nr1 <= H and 0 <= nc0 < nc1 <= W, "transformed square must fit in the grid"

        region = (slice(nr0, nr1), slice(nc0, nc1))
        assert not painted[region].any(), "transformed squares must not overlap"
        out[region] = color
        painted[region] = True

    return out

# --------------- generator (att2, o5x) ---------------

# Canvas and palette.
GRID_SIZE = 16
BACKGROUND_COLOR = 7
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
INPUT_SIDE_FROM_OUTPUT = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
# Object and side sampling.
SQUARE_COUNT_RANGE = (3, 5)
BASE_OUTPUT_SIDE_CHOICES = [1, 3, 5]
OUTPUT_SIDE_7_PROB = 0.45
OUTPUT_SIDE_9_PROB = 0.35
# Placement and retry policy.
OUTPUT_CLEARANCE_GAP = 1
INPUT_CLEARANCE_GAP = 0
MAX_GENERATION_ATTEMPTS = 300


def _bbox(center_r, center_c, side):
    d = side // 2
    return center_r - d, center_c - d, center_r + d, center_c + d


def _separated(a, b, gap=0):
    return (
        a[2] + gap + 1 <= b[0]
        or b[2] + gap + 1 <= a[0]
        or a[3] + gap + 1 <= b[1]
        or b[3] + gap + 1 <= a[1]
    )


def _clear(rect, rects, gap=0):
    return all(_separated(rect, other, gap) for other in rects)


def _draw_square(grid, color, box):
    r0, c0, r1, c1 = box
    shape = (r1 - r0 + 1, c1 - c0 + 1)
    paste(grid, np.full(shape, int(color), dtype=int), r0, c0)


def _choose_output_sides(count):
    sides = [random.choice(BASE_OUTPUT_SIDE_CHOICES) for _ in range(count)]
    slots = list(range(count))
    random.shuffle(slots)

    if random.random() < OUTPUT_SIDE_7_PROB:
        sides[slots.pop()] = 7
    if slots and random.random() < OUTPUT_SIDE_9_PROB:
        sides[slots.pop()] = 9

    random.shuffle(sides)
    return sides


def _sample_objects():
    """Sample color and side specs, returning larger required footprints first."""
    count = random.randint(*SQUARE_COUNT_RANGE)
    colors = random.sample(FOREGROUND_COLORS, count)
    out_sides = _choose_output_sides(count)
    in_sides = [INPUT_SIDE_FROM_OUTPUT[s] for s in out_sides]

    # Keep the configured background as the solver's dominant color.
    areas = [s * s for s in in_sides]
    if GRID_SIZE * GRID_SIZE - sum(areas) <= max(areas):
        return None

    objects = [
        {"color": color, "out_side": out_side, "in_side": in_side}
        for color, out_side, in_side in zip(colors, out_sides, in_sides)
    ]
    random.shuffle(objects)
    objects.sort(key=lambda obj: (max(obj["out_side"], obj["in_side"]), obj["out_side"]), reverse=True)
    return objects


def _place_objects(objects):
    """Place each object at a center valid for both input and output squares."""
    placed = []
    output_boxes = []
    input_boxes = []

    for obj in objects:
        out_side = obj["out_side"]
        in_side = obj["in_side"]
        margin = max(out_side // 2, in_side // 2)
        rows = range(margin, GRID_SIZE - margin)
        centers = [(r, c) for r in rows for c in rows]
        random.shuffle(centers)

        for r, c in centers:
            out_box = _bbox(r, c, out_side)
            in_box = _bbox(r, c, in_side)
            if _clear(out_box, output_boxes, OUTPUT_CLEARANCE_GAP) and _clear(in_box, input_boxes, INPUT_CLEARANCE_GAP):
                placed.append((obj["color"], out_box, in_box))
                output_boxes.append(out_box)
                input_boxes.append(in_box)
                break
        else:
            return None
    return placed


def _render_grid(placed, box_index):
    """Render one phase from placed tuples: 1 for output boxes, 2 for input boxes."""
    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
    for item in placed:
        _draw_square(grid, item[0], item[box_index])
    return grid


def _gen_attempt():
    objects = _sample_objects()
    if objects is None:
        return None

    placed = _place_objects(objects)
    if placed is None:
        return None

    out = _render_grid(placed, 1)
    inp = _render_grid(placed, 2)
    return inp if np.array_equal(main(inp), out) else None


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 522fdd07 input")
