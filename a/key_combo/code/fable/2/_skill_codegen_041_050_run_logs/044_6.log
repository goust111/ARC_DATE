+
+
+def _build_critical_spec(color: int) -> dict | None:
+    for _ in range(_SPEC_RETRIES):
+        mask = _random_mask("critical")
+        critical = _ring_candidates(mask, 1, require_bbox_only=True)
+        if not critical:
