+
+
+def _build_duplicate_spec(color: int) -> dict | None:
+    for _ in range(_SPEC_RETRIES):
+        mask = _random_mask("duplicate")
+        good_choices = []
+        for j in _RING_DISTANCE_CHOICES:
+            chosen = _pick_points(_ring_candidates(mask, j), 2)
+            if chosen is not None:
