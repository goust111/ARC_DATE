+    r, c = point
+    r0, c0, r1, c1 = bbox
+    dr = r0 - r if r < r0 else r - r1 if r > r1 else 0
+    dc = c0 - c if c < c0 else c - c1 if c > c1 else 0
+    return int(max(dr, dc))
