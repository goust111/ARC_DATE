+    used = [] if used is None else list(used)
+    pool = list(candidates)
+    random.shuffle(pool)
+    chosen: list[tuple[int, int]] = []
+    for point in pool:
+        if _is_far_from_coords(point, used + chosen):
+            chosen.append(point)
+            if len(chosen) == count:
+                return chosen
+    return None
+
