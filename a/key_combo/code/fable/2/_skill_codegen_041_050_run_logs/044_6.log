+    for c in range(cc0, cc1 + 1):
+        paint_cell(rr0, c)
+        paint_cell(rr1, c)
+    for r in range(rr0 + 1, rr1):
+        paint_cell(r, cc0)
+        paint_cell(r, cc1)
