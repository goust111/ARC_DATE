+def _tile_fill(shape: tuple[int, int], tile: np.ndarray, row_phase: int, col_phase: int) -> np.ndarray:
+    h, w = shape
+    th, tw = tile.shape
+    out = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = int(tile[(r + row_phase) % th, (c + col_phase) % tw])
