+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
