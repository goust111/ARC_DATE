            left_col = left_cols[int(idx)]
            expected[top_row : top_row + BLOCK_SIZE, left_col : left_col + BLOCK_SIZE] = OUTPUT_BLOCK_COLOR

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


