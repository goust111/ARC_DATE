+def _anchor_options(mask: np.ndarray) -> list[tuple[int, int, int, int]]:
+    h, w = mask.shape
+    options = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIRS4:
+            er, ec = rr + dr, cc + dc
+            if 0 <= er < h and 0 <= ec < w and mask[er, ec]:
