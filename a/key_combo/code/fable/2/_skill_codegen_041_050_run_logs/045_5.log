+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _dilate(mask: np.ndarray, connectivity: int = 4) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    dirs = DIRS4 if connectivity == 4 else DIRS8
+    for r, c in np.argwhere(mask):
+        for dr, dc in dirs:
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
+
+
+def _mask_from_coords(shape: tuple[int, int], coords: list[tuple[int, int]] | np.ndarray) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    if len(coords) == 0:
+        return out
+    arr = np.asarray(coords, dtype=int)
+    out[arr[:, 0], arr[:, 1]] = True
+    return out
+
+
+def _find_object_components(grid: np.ndarray) -> list[dict]:
+    objects = []
