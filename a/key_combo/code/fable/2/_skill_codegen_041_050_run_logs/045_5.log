+    endpoints: list[tuple[int, int]] = []
+    for r, c in cells:
+        degree = sum((r + dr, c + dc) in cells for dr, dc in DIRS4)
+        assert degree in (1, 2), "grey components must be simple paths"
+        if degree == 1:
