+        rr = obj["coords"][:, 0] + int(dr)
+        cc = obj["coords"][:, 1] + int(dc)
+        assert rr.min() >= 0 and cc.min() >= 0
+        assert rr.max() < g.shape[0] and cc.max() < g.shape[1]
+        out[rr, cc] = int(obj["color"])
