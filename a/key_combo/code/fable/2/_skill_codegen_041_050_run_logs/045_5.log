+def _render_input(base: np.ndarray, specs: list[dict]) -> np.ndarray:
+    inp = base.copy()
+    for spec in specs:
+        for r, c in spec["current"]:
+            inp[r, c] = int(spec["color"])
+        for r, c in spec["trail"]:
+            inp[r, c] = GREY
