+    matched = {}
+    translations: dict[int, tuple[int, int]] = {}
+    hidden = np.zeros(g.shape, dtype=bool)
+    for obj in objects:
+        coords = obj["coords"]
+        hidden[coords[:, 0], coords[:, 1]] = True
