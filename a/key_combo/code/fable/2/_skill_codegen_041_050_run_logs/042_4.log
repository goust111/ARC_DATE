  40: def main(grid: np.ndarray) -> np.ndarray:
  41:     """
  42:     Keep the larger sprite from each separated panel and overlay those sprites into one 5x5 canvas.
  43: 
  44:     Input structure:
  45:     - The input is a 5x17 grid: three 5x5 panels separated by one-cell black columns.
  46:     - Each panel has the same background color and exactly one foreground color split into two 4-connected components.
  47: 
  48:     Rule:
  49:     - In each panel, discard the smaller foreground component and keep the unique largest component as the sprite.
  50:     - Process panels left to right, placing each sprite at its panel coordinates on a 5x5 background canvas.
  51:     - If a sprite would cover an already placed sprite, slide it by the unique nearest in-bounds offset that avoids overlap.
  52: 
  53:     Key insight:
  54:     - The extra same-colored component in each panel is a distractor; the final answer is the non-overlapping overlay of the three largest components.
  55:     """
  56:     g = np.asarray(grid, dtype=int)
  57:     H, W = g.shape
  58:     panel_size = 5
  59:     assert H == panel_size and W == 3 * panel_size + 2, "expected three 5x5 panels"
  60: 
  61:     bg = int(get_bg(g))
  62:     sep = int(g[0, panel_size])
  63:     assert sep != bg, "separator color must differ from panel background"
  64:     assert np.all(g[:, panel_size] == sep) and np.all(
  65:         g[:, 2 * panel_size + 1] == sep
  66:     ), "panels must be separated by uniform columns"
  67: 
  68:     out = np.full((panel_size, panel_size), bg, dtype=int)
  69:     occupied = np.zeros_like(out, dtype=bool)
  70:     sprite_colors: list[int] = []
  71: 
  72:     for c0 in (0, panel_size + 1, 2 * panel_size + 2):
  73:         panel = g[:, c0 : c0 + panel_size]
  74:         panel_colors = [int(c) for c in np.unique(panel) if int(c) != bg]
  75:         assert len(panel_colors) == 1, "each panel must contain one foreground color"
  76:         color = panel_colors[0]
  77:         sprite_colors.append(color)
  78: 
  79:         comps = find_components(panel, bg=bg, connectivity=4, monochromatic=True, colors=[color])
  80:         assert len(comps) == 2, "each panel must contain exactly two components"
  81:         areas = [int(comp["area"]) for comp in comps]
  82:         largest = max(areas)
  83:         assert areas.count(largest) == 1, "largest component must be unique"
  84:         sprite = comps[areas.index(largest)]
  85:         coords = np.asarray(sprite["coords"], dtype=int)
  86: 
  87:         dr, dc = _nearest_non_overlapping_shift(coords, occupied)
  88:         rr = coords[:, 0] + int(dr)
  89:         cc = coords[:, 1] + int(dc)
  90:         out[rr, cc] = color
  91:         occupied[rr, cc] = True
  92: 
  93:     assert len(set(sprite_colors)) == len(sprite_colors), "panel sprite colors must be distinct"
  94:     return out
  95: 
