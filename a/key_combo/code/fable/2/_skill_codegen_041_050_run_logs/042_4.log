 124: def _coords_in_bounds(coords: np.ndarray, shape: tuple[int, int]) -> bool:
 125:     return (
 126:         int(coords[:, 0].min()) >= 0
 127:         and int(coords[:, 1].min()) >= 0
 128:         and int(coords[:, 0].max()) < shape[0]
 129:         and int(coords[:, 1].max()) < shape[1]
 130:     )
 131: 
 132: 
 133: def _shift_is_valid(coords: np.ndarray, occupied: np.ndarray, dr: int, dc: int) -> bool:
 134:     rr = coords[:, 0] + dr
 135:     cc = coords[:, 1] + dc
 136:     return (
 137:         int(rr.min()) >= 0
 138:         and int(cc.min()) >= 0
 139:         and int(rr.max()) < occupied.shape[0]
 140:         and int(cc.max()) < occupied.shape[1]
 141:         and not bool(occupied[rr, cc].any())
 142:     )
 143: 
 144: 
 145: def _nearest_non_overlapping_shift(coords: np.ndarray, occupied: np.ndarray) -> tuple[int, int] | None:
 146:     if _shift_is_valid(coords, occupied, 0, 0):
 147:         return 0, 0
 148: 
 149:     candidates = []
 150:     for dr in range(-(occupied.shape[0] - 1), occupied.shape[0]):
 151:         for dc in range(-(occupied.shape[1] - 1), occupied.shape[1]):
 152:             if _shift_is_valid(coords, occupied, dr, dc):
 153:                 candidates.append((abs(dr) + abs(dc), dr, dc))
 154:     if not candidates:
 155:         return None
 156: 
 157:     best_distance = min(dist for dist, _dr, _dc in candidates)
 158:     best = [(dr, dc) for dist, dr, dc in candidates if dist == best_distance]
 159:     return best[0] if len(best) == 1 else None
