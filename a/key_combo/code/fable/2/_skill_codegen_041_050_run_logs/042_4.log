+    core_end = core_start + core_len - 1
+
+    possible_lengths = []
+    for length in range(2, min(6, width) + 1):
+        lo = max(z0, core_end - length + 1)
+        hi = min(core_start, z1 - length + 1)
+        if lo <= hi:
