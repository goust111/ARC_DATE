  91: 
  92: # Grid and cyclic palette bounds.
  93: GRID_SIZE, BLANK_COLOR = 23, 0
  94: PERIOD_MIN, PERIOD_MAX = 6, 9
  95: 
  96: # Blank region counts and sizes.
