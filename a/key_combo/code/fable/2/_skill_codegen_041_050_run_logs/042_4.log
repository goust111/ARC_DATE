  50: def main(grid: np.ndarray) -> np.ndarray:
  51:     """
  52:     Fill blank gaps in a triangular cyclic color table.
  53: 
  54:     Input structure:
  55:     - The grid is a square table with one blank color masking missing cells.
  56:     - The visible non-blank pixels follow a repeated color cycle by column.
  57:     - Cells on or above the main diagonal use the column's cycle phase; cells
  58:       below the diagonal use the next cycle phase.
  59: 
  60:     Rule:
  61:     - Infer the unique blank color and the ordered color cycle from all visible
  62:       pixels.
  63:     - Reconstruct the complete table with phase col mod n above/on the diagonal
  64:       and phase col+1 mod n below it.
  65:     - Replace only blank pixels with their reconstructed colors.
  66: 
  67:     Key insight:
  68:     - The apparent holes are not independent objects; they are missing samples
  69:       from one global periodic pattern with a diagonal phase shift.
  70:     """
  71:     g = np.asarray(grid, dtype=int)
  72:     assert g.ndim == 2, "expected a 2D grid"
  73:     height, width = map(int, g.shape)
  74:     assert height == width, "expected a square cyclic table"
  75: 
  76:     blank, cycle = _infer_blank_and_cycle(g)
  77:     assert np.any(g == blank), "expected at least one blank pixel to fill"
  78:     period = len(cycle)
  79:     cycle_array = np.asarray(cycle, dtype=int)
  80: 
  81:     rows, cols = np.indices(g.shape)
  82:     phase = np.where(rows <= cols, cols % period, (cols + 1) % period)
  83:     full_pattern = cycle_array[phase]
  84:     assert np.array_equal(g[g != blank], full_pattern[g != blank]), "visible pixels must match the inferred table"
  85: 
  86:     out = g.copy()
  87:     out[g == blank] = full_pattern[g == blank]
  88:     return out
  89: 
