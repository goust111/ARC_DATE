 678:         return False
 679: 
 680:     rb0 = ra0 - dr
 681:     cb0 = ca0 - dc
 682:     rb1 = rb0 + (ra1 - ra0)
 683:     cb1 = cb0 + (ca1 - ca0)
 684:     return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())
