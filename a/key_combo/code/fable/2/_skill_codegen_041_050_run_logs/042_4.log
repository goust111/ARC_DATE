  10: # description:
  11: # In the input you will see horizontal/vertical bars and individual coloured pixels sprinkled on a black background
  12: # Move each colored pixel to the bar that has the same colour until the pixel touches the bar.
  13: # If a colored pixel doesn't have a corresponding bar, it should be deleted.
  14: 
  15: def main(input_grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Slide each loose pixel until it touches the full bar with the same color, deleting unmatched pixels.
  18: 
  19:     Input structure:
  20:     - The input contains full horizontal or vertical bars and single colored pixels on black.
  21:     - Bars are monochromatic and span the full height or width.
  22:     - Some loose pixels share colors with bars and some may not.
  23: 
  24:     Rule:
  25:     - Copy all bars unchanged to the output.
  26:     - For each loose pixel with a matching-color bar, slide it in a cardinal direction until it contacts that bar.
  27:     - Drop any loose pixel whose color has no corresponding bar.
  28: 
  29:     Key insight:
  30:     - Bar color is the destination label: matching pixels move until first contact with their same-color
  31:       full-line anchor.
  32:     """
  33:     output_grid = np.zeros_like(input_grid)
  34: 
  35:     # each object is either a bar or pixel, all uniform color
  36:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  37: 
  38:     # separate the bars from the pixels
  39:     bars, pixels = [], []
  40:     for obj in objects:
  41:         b = bbox(obj != Color.BLACK)
  42:         assert b is not None
  43:         h = bbox_h(b)
  44:         w = bbox_w(b)
  45:         if h == input_grid.shape[0] or w == input_grid.shape[1]:
  46:             bars.append(obj)
  47:         else:
  48:             pixels.append(obj)
  49:     
  50:     # copy the bars to the output grid
  51:     for bar in bars:
  52:         paste(output_grid, bar, 0, 0, transparent=Color.BLACK, clip=True)
  53:     
  54:     # slide each pixel until it just barely touches the bar with the matching color
  55:     for pixel in pixels:
  56:         color = np.unique(pixel)[1]
  57:         matching_bars = [bar for bar in bars if np.unique(bar)[1] == color]
  58: 
  59:         # if there is no matching bar, delete the pixel
  60:         if len(matching_bars) == 0:
  61:             continue
  62: 
  63:         # consider sliding in the 4 cardinal directions, and consider sliding as far as possible
  64:         possible_displacements = [ (slide_distance*dr, slide_distance*dc)
  65:                                    for slide_distance in range(max(input_grid.shape))
  66:                                    for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)] ]
  67:         for dr, dc in possible_displacements:
  68:             new_pixel = translate(pixel, dr, dc, background=Color.BLACK)
  69:             if contact(object1=matching_bars[0], object2=new_pixel):
  70:                 paste(output_grid, new_pixel, 0, 0, transparent=Color.BLACK, clip=True)
  71:                 break
  72:     
  73:     return output_grid
