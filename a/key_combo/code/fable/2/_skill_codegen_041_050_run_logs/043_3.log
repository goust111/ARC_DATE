+def _mask_from_bits(bits: int) -> np.ndarray:
+    return np.array([(bits >> k) & 1 for k in range(GLYPH_SIZE * GLYPH_SIZE)], dtype=bool).reshape(
+        GLYPH_SIZE, GLYPH_SIZE
