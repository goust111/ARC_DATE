+    tile_h, tile_w = map(int, tile_shape)
+    out = {(r, c): [] for r in range(tile_h) for c in range(tile_w)}
+    for r in range(shape[0]):
+        for c in range(shape[1]):
+            out[(r % tile_h, c % tile_w)].append((r, c))
+    return out
