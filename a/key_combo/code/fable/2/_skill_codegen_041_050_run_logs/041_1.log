+            TILE_COLOR_COUNT_RANGE[0],
+            min(TILE_COLOR_COUNT_RANGE[1], area - 1, len(NON_BLACK_COLORS)),
+        )
+        palette = random.sample(NON_BLACK_COLORS, color_count)
