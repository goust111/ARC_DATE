+def _minimal_period(tile: np.ndarray) -> tuple[int, int]:
+    h, w = map(int, tile.shape)
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    for tile_h in range(1, h + 1):
