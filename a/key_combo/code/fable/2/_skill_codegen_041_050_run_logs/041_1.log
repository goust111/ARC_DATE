+def _render_revealed_phases(tile: np.ndarray, hit_phases: list[tuple[int, int]]) -> np.ndarray:
+    out = np.zeros(tile.shape, dtype=int)
+    for phase in hit_phases:
+        out[phase] = int(tile[phase])
+    return out
