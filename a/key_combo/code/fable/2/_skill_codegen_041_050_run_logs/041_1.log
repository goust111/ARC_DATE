+    extra_h = random.randint(0, min(tile_h - 1, 30 - row_repeats * tile_h))
+    extra_w = random.randint(0, min(tile_w - 1, 30 - col_repeats * tile_w))
+    return row_repeats * tile_h + extra_h, col_repeats * tile_w + extra_w
