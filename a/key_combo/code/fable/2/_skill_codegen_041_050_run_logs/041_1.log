+        visible = values[values != BLACK]
+        if not np.all(visible == int(tile[phase])):
+            return False
+        if phase in hit_set:
+            if black_count == 0 or visible.size == 0:
+                return False
+        elif black_count != 0:
+            return False
+        black_per_phase[phase] = black_count
