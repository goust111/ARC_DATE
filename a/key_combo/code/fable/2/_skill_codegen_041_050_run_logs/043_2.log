+    rows = [r for r, _c in pixels]
+    cols = [c for _r, c in pixels]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    for (r, c), color in pixels.items():
+        out[r - r0, c - c0] = color
+    return out
