+        return False
+    occupied_neighbors = [
+        nbr
+        for nbr in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+        if nbr in occupied
+    ]
+    return occupied_neighbors == [tail] or (len(occupied_neighbors) == 1 and occupied_neighbors[0] == tail)
