+    return None
+
+
+def _render_input(
+    shape: tuple[int, int],
+    bg: int,
+    palette: list[int],
+    palette_col: int,
+    path: list[tuple[int, int]],
+    start_index: int,
+) -> np.ndarray:
+    grid = np.full(shape, int(bg), dtype=int)
