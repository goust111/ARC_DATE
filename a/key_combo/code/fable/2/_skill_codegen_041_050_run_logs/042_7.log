+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GREY = 5
+ARC_COLORS = tuple(range(10))
+
+GRID_H_RANGE = (10, 18)
+GRID_W_RANGE = (10, 18)
+PALETTE_LEN_RANGE = (3, 6)
