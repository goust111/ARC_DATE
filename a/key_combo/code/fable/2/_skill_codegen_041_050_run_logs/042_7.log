+
+
+def _path_colors(
+    palette: list[int],
+    start_index: int,
+    corner_flags: list[bool],
+    *,
+    mode: str = "at_corner",
+) -> list[int]:
+    phase = int(start_index)
+    colors = [int(palette[phase])]
+    for i in range(1, len(corner_flags)):
+        step = 1
+        if mode == "at_corner" and bool(corner_flags[i]):
+            step = 2
+        elif mode == "after_corner" and bool(corner_flags[i - 1]):
