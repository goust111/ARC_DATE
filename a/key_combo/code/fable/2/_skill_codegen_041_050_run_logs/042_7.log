+        prev_dir = (path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1])
+        next_dir = (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        flags[i] = prev_dir != next_dir
