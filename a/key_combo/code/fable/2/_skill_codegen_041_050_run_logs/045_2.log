+    placements = _place_specs(specs)
+    if placements is None:
+        return None
+
+    inp, expected = _render_pair(specs, placements)
+    inp, expected = _crop_canvas(inp, expected)
+    if not _validate_generated_pair(inp, expected):
+        return None
+    return inp
