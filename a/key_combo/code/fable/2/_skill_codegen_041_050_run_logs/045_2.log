  17: def main(grid: np.ndarray) -> np.ndarray:
  18:     """Fill each left-template hole with the color of the right-side object whose shape matches that hole.
  19: 
  20:     Input structure
  21:     The input is split into two equal-width panels.  The left panel is a single-color
  22:     template on the background, with disconnected background hole-regions; the right
  23:     panel contains one monochromatic object for each hole-region.
  24: 
  25:     Rule
  26:     Return the left panel only.  For every background hole-region in the left panel,
  27:     normalize its mask to its bounding box, find the unique right-panel object with
  28:     the same normalized mask, and recolor that hole-region with the object's color.
  29: 
  30:     Key insight
  31:     The right-panel objects are not copied by position; their shapes are a palette
  32:     that names which color belongs in each matching left-panel hole.
  33:     """
  34:     g = np.asarray(grid, dtype=int)
  35:     _, w = g.shape
  36:     assert w % 2 == 0
  37:     mid = w // 2
  38:     bg = get_bg(g)
  39:     left = g[:, :mid]
  40:     right = g[:, mid:]
  41: 
  42:     frame_colors = set(map(int, np.unique(left))) - {bg}
  43:     assert len(frame_colors) == 1
  44: 
  45:     shape_to_color: dict[tuple[tuple[int, int], tuple[tuple[int, int], ...]], int] = {}
  46:     for obj in find_components(right, bg=bg, connectivity=4, monochromatic=True):
  47:         key = _shape_key(obj["coords"])
  48:         assert key not in shape_to_color
  49:         shape_to_color[key] = int(obj["color"])
  50: 
  51:     slots = components_mask(left == bg, connectivity=4)
  52:     assert len(slots) == len(shape_to_color)
  53: 
  54:     out = left.copy()
  55:     for coords in slots:
  56:         key = _shape_key(coords)
  57:         assert key in shape_to_color
  58:         out[coords[:, 0], coords[:, 1]] = shape_to_color[key]
  59: 
  60:     assert not np.any(out == bg)
  61:     return out
  62: 
