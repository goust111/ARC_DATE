+    return mask
+
+
+def _make_object_mask(size: int, marker_name: str) -> np.ndarray:
+    for _ in range(SHAPE_RETRIES):
+        mask = _build_random_mask(size, marker_name)
+        if _valid_mask(mask, marker_name):
+            return mask
