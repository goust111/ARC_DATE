+        random.choice(SLOT_FAMILIES["flip_ud"]),
+        random.choice(SLOT_FAMILIES["flip_lr"]),
+        random.choice(SLOT_FAMILIES["diag_main"]),
+        random.choice(SLOT_FAMILIES["diag_anti"]),
