 143: def _make_canvas(separator: int, rng: np.random.Generator):
 144:     """Sample the canvas and return it with quadrant boxes as r0/c0/h/w."""
 145:     height = int(rng.integers(*CANVAS_HEIGHT_RANGE))
 146:     width = int(rng.integers(*CANVAS_WIDTH_RANGE))
 147:     cross_row = int(rng.integers(SPRITE_SIZE, height - SPRITE_SIZE))
 148:     cross_col = int(rng.integers(SPRITE_SIZE, width - SPRITE_SIZE))
 149: 
 150:     grid = np.zeros((height, width), dtype=int)
 151:     grid[cross_row, :] = separator
 152:     grid[:, cross_col] = separator
 153:     quadrants = [
 154:         (0, 0, cross_row, cross_col),
 155:         (0, cross_col + 1, cross_row, width - cross_col - 1),
 156:         (cross_row + 1, 0, height - cross_row - 1, cross_col),
 157:         (cross_row + 1, cross_col + 1, height - cross_row - 1, width - cross_col - 1),
 158:     ]
 159:     return grid, quadrants
