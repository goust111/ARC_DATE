  23:     - Separate the main object from the red pixels.
  24:     - Infer a mirror axis just outside the touched side of the main object's bounding box.
  25:     - Reflect every main-object pixel across that axis, then recolor all remaining black background green.
  26: 
  27:     Key insight:
  28:     - The red pixels are directional markers to be covered by the reflection, not output objects to preserve.
  29:     """
  30:     # Plan:
  31:     # 1. Find the main object and the red pixels
  32:     # 2. Calculate the axis over which to mirror depending on which side the red pixels are on
  33:     # 3. Do the mirroring
  34:     # 4. Change background to green
  35:     
  36:     # 1. Input parsing
  37:     bg = Color.BLACK
  38:     objects = find_components(input_grid, bg=bg, connectivity=8, monochromatic=True, return_format="objects")
  39:     assert len(objects) == 2, "There should be exactly two objects"
  40: 
  41:     # Find the main object
  42:     main_object = next(obj for obj in objects if Color.RED not in colors_present(obj, exclude={bg}))
  43:     # Find the red pixels
  44:     red_pixels = next(obj for obj in objects if Color.RED in colors_present(obj, exclude={bg}))
  45: 
  46:     # 2. Axis calculation
  47: 
  48:     # Figure out what side of the object the red pixels are on
  49:     b = bbox(main_object != bg)
  50:     assert b is not None
  51:     r1, c1 = bbox_anchor(b, anchor="upper left")
  52:     r2, c2 = bbox_anchor(b, anchor="lower right")
  53:     # on the right?
  54:     if collision(object1=translate(main_object, dr=0, dc=1, background=bg), object2=red_pixels, background=bg):
  55:         # the +/- 0.5 is to clobber the red pixels, otherwise we'd reflect over them and leave them be, which would also be a reasonable thing to do
  56:         symmetry = MirrorSymmetry(mirror_r=None, mirror_c=c2 + 0.5)
  57:     # on the left?
  58:     elif collision(object1=translate(main_object, dr=0, dc=-1, background=bg), object2=red_pixels, background=bg):
  59:         symmetry = MirrorSymmetry(mirror_r=None, mirror_c=c1 - 0.5)
  60:     # on the top?
  61:     elif collision(object1=translate(main_object, dr=-1, dc=0, background=bg), object2=red_pixels, background=bg):
  62:         symmetry = MirrorSymmetry(mirror_r=r1 - 0.5, mirror_c=None)
  63:     # on the bottom?
  64:     elif collision(object1=translate(main_object, dr=1, dc=0, background=bg), object2=red_pixels, background=bg):
  65:         symmetry = MirrorSymmetry(mirror_r=r2 + 0.5, mirror_c=None)
  66:     else:
  67:         assert False, "Red pixels are not on any side of the main object"
  68:     
  69:     # 3. Mirror the main object
  70:     output_grid = main_object.copy()
  71:     for r, c in np.argwhere(main_object != bg):
  72:         rr = int(r)
  73:         cc = int(c)
  74:         for r2, c2 in orbit(output_grid, rr, cc, symmetries=[symmetry]):
  75:             if 0 <= r2 < output_grid.shape[0] and 0 <= c2 < output_grid.shape[1]:
  76:                 output_grid[r2, c2] = main_object[rr, cc]
  77:     
  78:     # 4. Change the background to green
  79:     output_grid[output_grid == bg] = Color.GREEN
  80: 
  81:     return output_grid
  82: 
