  84: @lru_cache(None)
  85: def _gen_shape_catalog(height: int, max_width: int) -> tuple[tuple[int, int, tuple, np.ndarray], ...]:
  86:     catalog = []
  87:     for width in range(SHAPE_MIN_WIDTH, max_width + 1):
  88:         min_area = int(np.ceil(SHAPE_MIN_FILL_RATIO * height * width))
  89:         n_cells = height * width
  90:         for bits in range(1, 1 << n_cells):
  91:             area = bits.bit_count()
  92:             if area < min_area:
  93:                 continue
  94:             mask = np.array(
  95:                 [(bits >> i) & 1 for i in range(n_cells)], dtype=bool
  96:             ).reshape(height, width)
  97:             if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
  98:                 continue
  99:             if len(components_mask(mask, connectivity=SHAPE_CONNECTIVITY)) != 1:
 100:                 continue
 101:             catalog.append((width, area, _gen_mask_key(mask), mask))
 102:     return tuple(catalog)
