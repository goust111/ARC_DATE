+    return parts
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int = Color.BLACK,
+    colors: list[int] | tuple[int, ...] | None = None,
+) -> list[dict]:
+    if colors is None:
+        colors = sorted(set(map(int, np.unique(grid))) - {int(bg)})
+    out = []
+    for color in colors:
+        col = int(color)
