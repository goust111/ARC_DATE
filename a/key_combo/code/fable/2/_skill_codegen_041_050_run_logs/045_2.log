 108: def _gen_full_bbox_masks() -> dict[int, tuple[np.ndarray, ...]]:
 109:     cells = [(r, c) for r in range(SPRITE_SIZE) for c in range(SPRITE_SIZE)]
 110:     full_extent = set(range(SPRITE_SIZE))
 111:     masks_by_count: dict[int, tuple[np.ndarray, ...]] = {}
