 105: def _gen_choose_shapes(height: int, inner_width: int, count: int) -> list[np.ndarray] | None:
 106:     groups = {}
 107:     for width, area, key, mask in _gen_shape_catalog(height, inner_width):
 108:         groups.setdefault((width, area), []).append((key, mask))
 109: 
 110:     chosen = []
 111:     used_keys = set()
 112:     for _ in range(count):
 113:         available = [
 114:             [item for item in items if item[0] not in used_keys]
 115:             for items in groups.values()
 116:         ]
 117:         available = [items for items in available if items]
 118:         if not available:
 119:             return None
 120:         key, mask = random.choice(random.choice(available))
 121:         used_keys.add(key)
 122:         chosen.append(mask.copy())
 123:     return chosen
