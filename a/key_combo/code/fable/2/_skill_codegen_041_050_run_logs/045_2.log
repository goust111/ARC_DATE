+def _rect_separated(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = PLACEMENT_GAP
+) -> bool:
+    return (
+        a[2] + gap < b[0]
+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
+    )
+
+
+def _place_specs(specs: list[dict]) -> list[tuple[int, int]] | None:
