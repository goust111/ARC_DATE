  10: # description:
  11: # In the input you will see a translationally symmetric pattern randomly occluded by black pixels.
  12: # To make the output, remove the occluding black pixels to reveal the translationally symmetric pattern.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Restore black occlusions in a translationally periodic pattern using matching orbit colors.
  17: 
  18:     Input structure:
  19:     - The input is a colored periodic tiling with some cells replaced by black.
  20:     - Black represents missing data rather than the pattern background.
  21:     - Non-black cells reveal at least one translational symmetry.
  22: 
  23:     Rule:
  24:     - Detect translations that preserve the visible non-black colors.
  25:     - For each black cell, collect the non-black colors in its translational orbit.
  26:     - Fill the cell with the unique color found in that orbit.
  27: 
  28:     Key insight:
  29:     - Symmetry turns each missing pixel into a constraint-satisfaction problem over its orbit; the
  30:       matching visible copies reveal the hidden color.
  31:     """
  32:     # Plan:
  33:     # 1. Find the translational symmetries
  34:     # 2. Reconstruct the sprite by ignoring the black pixels and exploiting the symmetry
  35: 
  36:     w, h = input_grid.shape
  37: 
  38:     # Identify the translational symmetries. Note that there is no background color for this problem.
  39:     translations = detect_translational_symmetry(input_grid, ignore_colors=[Color.BLACK], background=None)
  40:     assert len(translations) > 0, "No translational symmetry found"
  41: 
  42:     # Reconstruct the occluded black pixels by replacing them with colors found in the orbit of the symmetries
  43:     output_grid = np.copy(input_grid)
  44:     for r in range(w):
  45:         for c in range(h):
  46:             if output_grid[r, c] == Color.BLACK:
  47:                 # Use the translational symmetry to fill in the occluded pixels
  48:                 # to do this we compute the ORBIT of the current pixel under the translations
  49:                 # and take the most common non-black color in the orbit
  50: 
  51:                 # Compute the orbit into the output
  52:                 orbit_pixels = orbit(output_grid, r, c, translations)
  53:                 orbit_colors = {input_grid[transformed_r, transformed_c]
  54:                                 for transformed_r, transformed_c in orbit_pixels}
  55:                 
  56:                 # occluded by black, so whatever color it is, black doesn't count
  57:                 orbit_colors = orbit_colors - {Color.BLACK}
  58: 
  59:                 # Copy the color
  60:                 assert len(orbit_colors) == 1, "Ambiguity: multiple colors in the orbit"
  61:                 output_grid[r, c] = orbit_colors.pop()
  62:     
  63:     return output_grid
