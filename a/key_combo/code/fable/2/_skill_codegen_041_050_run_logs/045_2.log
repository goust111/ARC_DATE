  77: def _gen_mask_key(mask: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, int], ...]]:
  78:     coords = np.argwhere(mask)
  79:     r0, c0, _, _ = bbox_coords(coords)
  80:     offsets = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
  81:     return (int(mask.shape[0]), int(mask.shape[1])), offsets
