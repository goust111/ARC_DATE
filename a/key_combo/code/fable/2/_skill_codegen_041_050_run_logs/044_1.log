+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+ALL_COLORS = tuple(range(10))
+
+MAX_GENERATION_ATTEMPTS = 400
+SHAPE_RETRIES = 200
+LAYOUT_RETRIES = 120
+PANEL_HEIGHT_RANGE = (8, 14)
