def abs_cells(pos,gap):
    r0,c0=pos
    return {(r0+r,c0+c) for r,c in MASKS[gap]}

def in_bounds(cells,H,W):
    return all(0<=r<H and 0<=c<W for r,c in cells)

def overlap(a,b):
