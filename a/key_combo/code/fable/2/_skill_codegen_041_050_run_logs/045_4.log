+        scenario = preferred if attempt < GENERATION_RETRIES // 2 else random.choice(SCENARIOS)
+        grid = _gen_attempt(scenario)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid relay-ring input")

