        if scenario.get('need_cardinal') and not any(dr==0 or dc==0 for dr,dc in dirs): continue
        if scenario.get('need_corner_gap') and not any(gr and gc for gr,gc in gaps): continue
        if any(dirs[i]==dirs[i+1] for i in range(k-1)):
            continue
        break
    else:
        return None
    rings=[{'gap':g} for g in gaps]
    # last ring choose pos
    last=k-1
    last_opts=[(r,c) for r in range(H-2) for c in range(W-2)]
    random.shuffle(last_opts)
    for pos in last_opts:
        steps=max_wall_steps(pos,gaps[last],H,W)
        if 2<=steps<=8:
            rings[last]['pos']=pos
            break
    else:
        return None
    # predecessors backward
    for i in range(k-2,-1,-1):
        dr,dc=(-gaps[i][0],-gaps[i][1])
        target_pos=rings[i+1]['pos']
        cands=REL[(gaps[i],gaps[i+1])][:]
        random.shuffle(cands)
        found=False
        later=range(i+1,k)
        for rel in cands:
            stop=(target_pos[0]+rel[0], target_pos[1]+rel[1])
            for L in random.sample(list(range(1,8)),7):
                start=(stop[0]-L*dr, stop[1]-L*dc)
                start_cells=abs_cells(start,gaps[i])
                stop_cells=abs_cells(stop,gaps[i])
                if not in_bounds(start_cells,H,W) or not in_bounds(stop_cells,H,W):
                    continue
                # no overlap initial with later rings
                if any(overlap(start_cells, abs_cells(rings[j]['pos'],gaps[j])) for j in later):
                    continue
                # path clear until stop; next hits only target i+1
                good=True
                cur=start
                for step in range(L+1):
                    cur_cells=abs_cells(cur,gaps[i])
                    for j in later:
                        if overlap(cur_cells, abs_cells(rings[j]['pos'],gaps[j])):
                            good=False
                            break
                    if not good: break
                    if step<L:
                        cur=(cur[0]+dr, cur[1]+dc)
                if not good:
                    continue
                next_pos=(stop[0]+dr, stop[1]+dc)
                next_cells=abs_cells(next_pos,gaps[i])
                hits=[j for j in later if overlap(next_cells, abs_cells(rings[j]['pos'],gaps[j]))]
                if hits"'!=[i+1]:
                    continue
                rings[i]['"'pos']=start
                found=True
                break
            if found:
                break
        if not found:
            return None
    order,seg,pos=trace(rings,H,W,0)
    if order"'!=list(range(k)):
        return None
    if seg[-1][1]!='"'wall':
        return None
    return H,W,rings,seg

