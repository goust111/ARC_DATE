+def _parse_ring(component: dict, grid: np.ndarray, bg: int) -> dict | None:
+    if int(component["area"]) != 7:
+        return None
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    if r1 != r0 + 2 or c1 != c0 + 2:
+        return None
