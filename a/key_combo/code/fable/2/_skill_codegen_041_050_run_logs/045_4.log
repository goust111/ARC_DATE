+
+def _build_local_ring_coords() -> dict[tuple[int, int], np.ndarray]:
+    out = {}
+    for gap in GAP_OFFSETS:
+        coords = []
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (dr, dc) == (0, 0) or (dr, dc) == gap:
+                    continue
+                coords.append((1 + dr, 1 + dc))
+        out[gap] = np.array(coords, dtype=int)
