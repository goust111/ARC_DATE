+    if len(gaps) != 1:
+        return None
+
+    gap = gaps[0]
+    return {
+        "color": color,
+        "gap": gap,
+        "move": _move_from_gap(gap),
+        "top_left": (r0, c0),
+        "bbox": (r0, c0, r1, c1),
