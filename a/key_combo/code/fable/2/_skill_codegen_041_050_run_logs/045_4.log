+def _front_spark_offsets(move: tuple[int, int]) -> set[tuple[int, int]]:
+    move_r, move_c = move
+    blocked = set()
+    if move_r < 0:
+        blocked.add((-1, 1))
+    if move_r > 0:
+        blocked.add((3, 1))
+    if move_c < 0:
+        blocked.add((1, -1))
+    if move_c > 0:
