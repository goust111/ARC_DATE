+    grid = _scene_grid(scene)
+    expected_chain_colors = [int(scene["rings"][idx]["color"]) for idx in range(int(scene["chain_len"]))]
+    if not _semantic_checks(grid, expected_chain_colors, len(scene["rings"])):
+        return None
+    return grid
