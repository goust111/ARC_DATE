+    def get_bg(grid: np.ndarray) -> int:
+        return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+    def _components_bool(mask: np.ndarray) -> list[np.ndarray]:
+        h, w = mask.shape
+        seen = np.zeros((h, w), dtype=bool)
+        parts: list[np.ndarray] = []
+        for r, c in np.argwhere(mask):
+            rr = int(r)
+            cc = int(c)
+            if seen[rr, cc]:
+                continue
+            stack = [(rr, cc)]
+            seen[rr, cc] = True
+            coords = []
+            while stack:
+                cr, cc2 = stack.pop()
+                coords.append((cr, cc2))
+                for nr, nc in ((cr - 1, cc2), (cr + 1, cc2), (cr, cc2 - 1), (cr, cc2 + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+        return parts
+
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int = 0,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | tuple[int, ...] | None = None,
+        min_area: int = 1,
+    ) -> list[dict]:
+        assert connectivity == 4
+        assert monochromatic
+        if colors is None:
+            colors = sorted(set(map(int, np.unique(grid))) - {int(bg)})
+        out = []
+        for color in colors:
+            if int(color) == int(bg):
+                continue
+            for coords in _components_bool(grid == int(color)):
+                if int(coords.shape[0]) < int(min_area):
+                    continue
+                r0, c0 = coords.min(axis=0)
+                r1, c1 = coords.max(axis=0)
+                out.append(
+                    {
+                        "color": int(color),
+                        "coords": coords,
+                        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                        "area": int(coords.shape[0]),
+                    }
+                )
+        return out
+
