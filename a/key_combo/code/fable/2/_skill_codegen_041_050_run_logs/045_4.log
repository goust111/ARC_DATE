def rel_stop_candidates(g1,g2):
    dr,dc=(-g1[0],-g1[1])
    t=abs_cells((0,0),g2)
    cands=[]
    for rr in range(-4,5):
        for cc in range(-4,5):
            cur=abs_cells((rr,cc),g1)
            nxt=abs_cells((rr+dr,cc+dc),g1)
            if overlap(cur,t):
                continue
            if overlap(nxt,t):
                cands.append((rr,cc))
    return cands
REL={(g1,g2):rel_stop_candidates(g1,g2) for g1 in GAPS for g2 in GAPS}

def trace(rings,H,W,start=0):
    pos={i:r['pos'] for i,r in enumerate(rings)}
    active=start
    order=[active]
    seg=[]
    seen={active}
    while True:
        g=rings[active]['gap']
        dr,dc=(-g[0],-g[1])
        cur=pos[active]
        steps=0
        while True:
            nxt=(cur[0]+dr,cur[1]+dc)
            nc=abs_cells(nxt,g)
            if not in_bounds(nc,H,W):
                pos[active]=cur
                seg.append((active,'wall',steps,None))
                return order,seg,pos
            hits=[]
            for j,r in enumerate(rings):
                if j==active: continue
                if overlap(nc, abs_cells(pos[j], r['gap'])):
                    hits.append(j)
            if hits:
                if len(hits)"'!=1:
                    return None,[('"'multi',active,tuple(hits))],pos
                pos[active]=cur
                hit=hits[0]
                seg.append((active,'hit',steps,hit))
                if hit in seen:
                    return None,[('revisit',active,hit)],pos
                active=hit
                order.append(active)
                seen.add(active)
                break
            cur=nxt
            steps+=1

