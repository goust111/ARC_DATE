    cur=pos;steps=0
    dr,dc=(-gap[0],-gap[1])
    while True:
        nxt=(cur[0]+dr,cur[1]+dc)
        if not in_bounds(abs_cells(nxt,gap),H,W):
            return steps
        cur=nxt;steps+=1

