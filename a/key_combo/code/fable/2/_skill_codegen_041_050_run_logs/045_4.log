            if (dr,dc)==(0,0) or (dr,dc)==gap:
                continue
            cells.append((r0+1+dr,c0+1+dc))
    return tuple(cells)

def in_bounds(cells,H,W):
    return all(0<=r<H and 0<=c<W for r,c in cells)

def overlap(a,b):
    bs=set(b)
    return any(x in bs for x in a)

def sim(active_id, rings, H, W):
    positions={i:r['pos'] for i,r in enumerate(rings)}
    activated=[active_id]
    while True:
        ring=rings[active_id]
        dr,dc=(-ring['gap'][0], -ring['gap'][1])
        pos=positions[active_id]
        steps=0
