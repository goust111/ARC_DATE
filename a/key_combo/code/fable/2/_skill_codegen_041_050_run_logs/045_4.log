+    rings = _place_chain_rings(shape, chain_gaps, colors)
+    if rings is None:
+        return None
+
+    if not _add_distractors(shape, rings, int(scenario["distractors"]), colors, int(scenario["chain_len"])):
+        return None
+
+    scene = {
