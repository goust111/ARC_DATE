+            rings.append(
+                {
+                    "id": len(rings),
+                    "color": int(color),
+                    "gap": gap,
+                    "move": _move_from_gap(gap),
+                    "top_left": top_left,
+                    "role": "distractor",
+                }
+            )
+            test_scene = {
+                "shape": shape,
+                "bg": BG,
+                "rings": rings,
+                "start_id": 0,
