def scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
    """
    Scale a sprite by an integer factor using nearest-neighbor replication.

    Returns an array of shape (h*factor, w*factor).
    """
    k = int(factor)
    if k <= 0:
