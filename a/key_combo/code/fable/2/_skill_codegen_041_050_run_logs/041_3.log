def _gen_grow_cells(h: int, w: int, size: int, seeds: set[tuple[int, int]]) -> set[tuple[int, int]] | None:
    cells = set(seeds)
    if len(cells) > size:
        return None
    while len(cells) < size:
        frontier = set()
        for r, c in cells:
            for dr, dc in FOUR_NEIGHBOR_DELTAS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
                    frontier.add((nr, nc))
