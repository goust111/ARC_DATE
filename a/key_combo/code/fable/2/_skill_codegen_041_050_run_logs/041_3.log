+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _is_single_component(mask: np.ndarray) -> bool:
+    parts = _mask_components(mask)
+    return len(parts) == 1
+
