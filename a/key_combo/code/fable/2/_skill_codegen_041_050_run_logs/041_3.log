+
+def _semantic_flags(scene: dict) -> list[bool]:
+    flags: list[bool] = []
+    for sprite in scene["sprites"]:
+        notch = _pair_notch(sprite["bbox"], scene["notches"])
+        sprite_mask = _coords_to_mask(sprite["coords"])
+        aligned = _aligned_sprite_canvas(sprite_mask, notch["mask"].shape, scene["side"])
+        flags.append(
+            aligned is not None and np.array_equal(aligned, ~notch["mask"])
+        )
+    return flags
+
+
+def _generate_attempt() -> np.ndarray | None:
+    count = random.randint(*NOTCH_COUNT_RANGE)
