+            sprite_mask = ~notch_mask
+        elif random.random() < 0.55:
+            sprite_mask = notch_mask.copy()
+        else:
+            sprite_mask = _random_other_mask(
+                h,
+                notch_w,
+                {notch_mask.tobytes(), (~notch_mask).tobytes()},
