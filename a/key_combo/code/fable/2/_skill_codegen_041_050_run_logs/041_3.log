+        sprite_coords = np.argwhere(item["sprite_mask"]) + np.array([r0, item["sprite_c0"]], dtype=int)
+        out[sprite_coords[:, 0], sprite_coords[:, 1]] = int(spec["bg"])
+        moved = _slide_coords(sprite_coords, wall_mask, item["dc"], grid.shape)
+        if item["fits"]:
