+    spec = {
+        "height": height,
+        "width": width,
+        "bg": bg,
+        "wall_color": wall_color,
+        "side": side,
+        "wall_thickness": wall_thickness,
+        "items": items,
+    }
+    grid = _render_input(spec)
+    expected = _expected_output(spec, grid)
