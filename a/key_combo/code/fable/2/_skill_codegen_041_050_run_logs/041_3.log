+def _build_wall_mask(shape: tuple[int, int], wall_coords: np.ndarray) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[wall_coords[:, 0], wall_coords[:, 1]] = True
+    return mask
+
