+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def get_bg(grid: np.ndarray) -> int:
+    counts = Counter(map(int, np.asarray(grid).ravel()))
+    return int(counts.most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    return np.asarray(grid)[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(cells, dtype=int))
+    return parts
+
+
+def find_components(grid: np.ndarray, bg: int | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = get_bg(g)
+    comps: list[dict] = []
+    for color in sorted(set(map(int, g.ravel())) - {int(bg)}):
+        for coords in _mask_components(g == int(color)):
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    box = bbox_coords(coords)
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    return crop_bbox(mask, bbox_coords(coords))
+
+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    rr, cc = np.nonzero(mask)
+    grid[rr + int(r0), cc + int(c0)] = int(color)
+
+
+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _is_single_component(mask: np.ndarray) -> bool:
+    parts = _mask_components(mask)
+    return len(parts) == 1
+
+
+def _random_dual_mask(height: int, width: int) -> np.ndarray:
+    assert height >= 4 and width >= 4
+    max_end = min(width - 2, height - 1)
+    end = random.randint(1, max_end)
+    step_rows = sorted(random.sample(range(height - 1), end))
+    path = [0]
+    cur = 0
+    for row in range(height - 1):
+        if row in step_rows:
+            cur += 1
+        path.append(cur)
+
+    sprite_canvas = np.zeros((height, width), dtype=bool)
+    for r, edge in enumerate(path):
+        lo = max(0, edge - 1)
+        sprite_canvas[r, lo : edge + 1] = True
+
+    notch_mask = ~sprite_canvas
+    assert _is_single_component(sprite_canvas)
+    assert _is_single_component(notch_mask)
+    assert _touches_all_edges(notch_mask)
+    return notch_mask
+
+
+def _aligned_sprite_canvas(sprite_mask: np.ndarray, notch_shape: tuple[int, int], side: str) -> np.ndarray | None:
+    notch_h, notch_w = map(int, notch_shape)
+    sprite_h, sprite_w = map(int, sprite_mask.shape)
+    if sprite_h != notch_h or sprite_w > notch_w:
+        return None
+    canvas = np.zeros((notch_h, notch_w), dtype=bool)
+    if side == "right":
+        canvas[:, :sprite_w] = sprite_mask
+    else:
+        canvas[:, notch_w - sprite_w :] = sprite_mask
+    return canvas
+
+
+def _random_other_mask(height: int, width: int, side: str, notch_mask: np.ndarray) -> np.ndarray:
+    target = ~notch_mask
+    for _ in range(800):
+        candidate_notch = _random_dual_mask(height, width)
+        candidate_canvas = ~candidate_notch
+        if side == "left":
+            candidate_canvas = np.fliplr(candidate_canvas)
+        sprite_mask = _crop_mask(candidate_canvas)
+        aligned = _aligned_sprite_canvas(sprite_mask, notch_mask.shape, side)
+        if aligned is None:
+            continue
+        if np.array_equal(aligned, target):
+            continue
+        if np.array_equal(sprite_mask, _crop_mask(target)):
+            continue
+        return sprite_mask
+    raise RuntimeError("failed to sample a jam mask")
+
+
+def _wall_side(box: BBox, width: int) -> str:
+    touch_left = int(box[1]) == 0
+    touch_right = int(box[3]) == width - 1
+    assert touch_left ^ touch_right, "wall must touch exactly one vertical border"
+    return "left" if touch_left else "right"
+
+
+def _build_wall_mask(shape: tuple[int, int], wall_coords: np.ndarray) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[wall_coords[:, 0], wall_coords[:, 1]] = True
+    return mask
+
+
+def _extract_notches(grid: np.ndarray, wall_mask: np.ndarray, wall_box: BBox, side: str, bg: int) -> list[dict]:
+    r0, c0, r1, c1 = map(int, wall_box)
+    inside = np.zeros(grid.shape, dtype=bool)
+    inside[r0 : r1 + 1, c0 : c1 + 1] = True
+    bg_inside = inside & (np.asarray(grid) == int(bg)) & (~wall_mask)
+    edge_col = c1 if side == "left" else c0
