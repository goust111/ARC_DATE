+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.array(cells, dtype=int))
+    return parts
+
+
+def find_components(grid: np.ndarray, bg: int | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = get_bg(g)
+    comps: list[dict] = []
+    for color in sorted(set(map(int, g.ravel())) - {int(bg)}):
+        for coords in _mask_components(g == int(color)):
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    box = bbox_coords(coords)
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    rr, cc = np.nonzero(mask)
+    grid[rr + int(r0), cc + int(c0)] = int(color)
