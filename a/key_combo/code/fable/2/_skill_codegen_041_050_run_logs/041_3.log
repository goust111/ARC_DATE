import itertools
import numpy as np

def comps(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),bool)
    n=0
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            n+=1
            stack=[(r,c)]
            seen[r,c]=1
            while stack:
                rr,cc=stack.pop()
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=1
                        stack.append((nr,nc))
    return n

def touch(mask):
    return mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()

for h in range(3,6):
