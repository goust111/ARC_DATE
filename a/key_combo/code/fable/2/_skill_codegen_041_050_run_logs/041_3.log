+    for item in spec["items"]:
+        r0, c0, r1, c1 = item["notch_bbox"]
+        notch_patch = np.full((r1 - r0 + 1, c1 - c0 + 1), spec["wall_color"], dtype=int)
+        notch_patch[item["notch_mask"]] = spec["bg"]
