+
+def _validate_instance(grid: np.ndarray) -> bool:
+    try:
+        analysis = _analyze_grid(grid)
+    except AssertionError:
+        return False
+
+    thumb = analysis["thumbnail"]
+    if thumb.shape[0] < 2 or thumb.shape[1] < 2:
+        return False
