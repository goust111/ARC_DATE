+
+def _get_bg(grid: np.ndarray) -> int:
+    counts = np.bincount(np.asarray(grid, dtype=int).ravel(), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    runs: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+            continue
+        runs.append((start, prev))
+        start = prev = idx
+    runs.append((start, prev))
+    return runs
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1]).copy()
+
+
+def _normalize_mask(mask: np.ndarray) -> np.ndarray:
+    bbox = _bbox_from_mask(mask)
+    assert bbox is not None, "expected a nonempty mask"
+    return _crop_bbox(mask.astype(bool), bbox).astype(bool)
+
+
+def _component_patch(coords: np.ndarray) -> np.ndarray:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    patch = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    patch[coords[:, 0] - int(r0), coords[:, 1] - int(c0)] = True
+    return patch
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
