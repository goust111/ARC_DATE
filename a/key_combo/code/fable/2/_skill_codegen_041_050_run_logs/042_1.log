+            bbox = (
+                int(arr[:, 0].min()),
+                int(arr[:, 1].min()),
+                int(arr[:, 0].max()),
+                int(arr[:, 1].max()),
+            )
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox,
+                    "area": int(arr.shape[0]),
+                    "mask": _component_patch(arr),
+                }
