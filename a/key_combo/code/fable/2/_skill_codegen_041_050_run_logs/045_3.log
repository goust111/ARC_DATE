                "index": int(index),
                "main": int(main_color),
                "foreign": foreign_color,
                "block": block,
                "count": int(coords.shape[0]),
                "top_row": height if coords.size == 0 else int(coords[:, 0].min()),
            }
        )
    return stripes


def _chain_order(stripes: list[dict]) -> tuple[list[int], int, int]:
    mains = [int(stripe["main"]) for stripe in stripes]
