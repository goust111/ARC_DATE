    for block_i, (c0, c1) in enumerate(bounds):
        base = colors[block_i]
        for color in colors:
            if color != base:
                grid[color_rows[color], _gen_marker_col(c0, c1)] = color


def _gen_nonconsecutive_rows(height, block_count):
