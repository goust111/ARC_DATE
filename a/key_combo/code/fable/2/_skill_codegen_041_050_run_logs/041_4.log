+def _build_tile() -> np.ndarray | None:
+    tile_h = random.randint(*TILE_H_RANGE)
+    tile_w = random.randint(*TILE_W_RANGE)
+    area = tile_h * tile_w
+    max_colors = min(5, 1 + (area - 1) // 2)
+    n_colors = random.randint(3, max_colors)
