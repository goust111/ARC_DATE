+    turns = 0
+    for i in range(2, len(path)):
+        prev = (path[i - 1][0] - path[i - 2][0], path[i - 1][1] - path[i - 2][1])
+        cur = (path[i][0] - path[i - 1][0], path[i][1] - path[i - 1][1])
+        turns += prev != cur
+    return turns
