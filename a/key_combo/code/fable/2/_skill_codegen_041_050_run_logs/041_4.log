+    stack = [next(iter(coords))]
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nbr in neighbors4(*cell):
+            if nbr in coords and nbr not in seen:
+                stack.append(nbr)
