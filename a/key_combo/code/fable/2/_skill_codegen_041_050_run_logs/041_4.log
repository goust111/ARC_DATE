    sprites = [_gen_sprite() for _ in range(_GEN_SPRITE_COUNT)]
    expected = _gen_render((_GEN_OUTPUT_SIZE, _GEN_OUTPUT_SIZE), sprites, _GEN_ATLAS_POSITIONS)
    height = _gen_randint(_GEN_INPUT_MIN_SIZE, _GEN_INPUT_MAX_SIZE)
