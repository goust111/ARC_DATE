+    best_count = 0
+    best_tile = None
+    for tile_h in range(1, h + 1):
+        for tile_w in range(1, w + 1):
+            tile = np.full((tile_h, tile_w), -1, dtype=int)
+            valid = True
+            for r, c in known:
+                tr = int(r) % tile_h
+                tc = int(c) % tile_w
+                value = int(g[r, c])
+                if tile[tr, tc] == -1:
+                    tile[tr, tc] = value
+                elif tile[tr, tc] != value:
+                    valid = False
