+    if tuple(parsed["marker_pos"]) != tuple(meta["marker_pos"]):
+        return False
+    if int(parsed["marker_color"]) != int(meta["marker_color"]):
+        return False
+    if len(_candidate_partial_tops(parsed["full_sprite"], parsed["partial_cells"], grid.shape)) != 1:
