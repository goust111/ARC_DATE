+            dr = large_r
+            dc = small_c
+        else:
+            dr = small_r
+            dc = large_c
+    if random.random() < 0.5:
+        dr = -dr
+    if random.random() < 0.5:
+        dc = -dc
+    return int(dr), int(dc)
+
+
+def _candidate_layouts(
+    sprite: np.ndarray,
+    step: tuple[int, int],
+    grid_shape: tuple[int, int],
+    mode: str,
+) -> list[dict]:
+    h, w = sprite.shape
+    gh, gw = grid_shape
+    candidates: list[dict] = []
+
+    for pr in range(gh - h + 1):
+        for pc in range(gw - w + 1):
