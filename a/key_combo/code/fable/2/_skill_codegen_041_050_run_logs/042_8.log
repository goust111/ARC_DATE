+    if mode == "row" and (not row_bounce or col_bounce):
+        return False
+    if mode == "col" and (row_bounce or not col_bounce):
+        return False
+    if mode == "both" and (not row_bounce or not col_bounce):
+        return False
+    if mode != "none":
