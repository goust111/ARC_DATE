+def _step_signature(states: list[dict], final_idx: int) -> tuple[bool, bool]:
+    row = any("row" in state["bounce_axes"] for state in states[1 : final_idx + 1])
+    col = any("col" in state["bounce_axes"] for state in states[1 : final_idx + 1])
+    return row, col
