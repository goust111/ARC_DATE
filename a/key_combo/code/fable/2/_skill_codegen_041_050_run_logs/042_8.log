+        {
+            "top": tuple(partial_top),
+            "sprite": sprite.copy(),
+            "bounce_axes": (),
+        }
+    ]
+    current_top = tuple(partial_top)
+    current_sprite = sprite.copy()
+    current_step = tuple(step)
+    for _ in range(max_future_steps):
