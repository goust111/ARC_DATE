+
+def _expected_from_meta(grid: np.ndarray, meta: dict) -> np.ndarray:
+    scene = {
+        "bg": 0,
+        "full_sprite": meta["sprite"],
+        "partial_top": meta["partial_top"],
+        "marker_pos": meta["marker_pos"],
+        "marker_color": meta["marker_color"],
+        "step": meta["step"],
