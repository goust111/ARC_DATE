+        "partial_top": tuple(layout["partial_top"]),
+        "partial_subset": partial_subset,
+        "states": states,
+        "final_idx": int(final_idx),
+        "marker_pos": tuple(marker_pos),
+        "marker_color": int(marker_color),
+    }
