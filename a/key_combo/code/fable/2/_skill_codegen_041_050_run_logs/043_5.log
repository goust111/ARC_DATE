+def _can_place_bbox(reserved: np.ndarray, r: int, c: int, h: int, w: int, pad: int) -> bool:
+    hh, ww = reserved.shape
+    if r < 0 or c < 0 or r + h > hh or c + w > ww:
+        return False
+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(hh, r + h + pad)
+    c1 = min(ww, c + w + pad)
+    return not bool(reserved[r0:r1, c0:c1].any())
