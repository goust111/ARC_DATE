 258: def bbox_anchor(b: BBox, *, anchor: str = "upper left") -> Coord:
 259:     """
 260:     Return an anchor point (r,c) for a bbox.
 261: 
 262:     anchor:
 263:         upper left/right, lower left/right,
 264:         center,
 265:         upper center, lower center,
 266:         left center, right center
 267:     """
 268:     anchor = anchor.lower().replace(" ", "").replace("top", "upper").replace("bottom", "lower")
 269:     r0, c0, r1, c1 = map(int, b)
 270:     h = bbox_h(b)
 271:     w = bbox_w(b)
 272: 
 273:     if anchor == "upperleft":
 274:         rr, cc = r0, c0
 275:     elif anchor == "upperright":
 276:         rr, cc = r0, c1
 277:     elif anchor == "lowerleft":
 278:         rr, cc = r1, c0
 279:     elif anchor == "lowerright":
 280:         rr, cc = r1, c1
 281:     elif anchor == "center":
 282:         rr, cc = r0 + (h - 1) / 2, c0 + (w - 1) / 2
 283:     elif anchor == "uppercenter":
 284:         rr, cc = r0, c0 + (w - 1) / 2
 285:     elif anchor == "lowercenter":
 286:         rr, cc = r1, c0 + (w - 1) / 2
 287:     elif anchor == "leftcenter":
 288:         rr, cc = r0 + (h - 1) / 2, c0
 289:     elif anchor == "rightcenter":
 290:         rr, cc = r0 + (h - 1) / 2, c1
 291:     else:
 292:         raise ValueError("bbox_anchor: invalid anchor")
 293: 
 294:     return int(round(rr)), int(round(cc))
