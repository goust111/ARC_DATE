  14: def main(input_grid):
  15:     """
  16:     Move gray puzzle pieces into holes in a red shape and recolor the placed pieces blue.
  17: 
  18:     Input structure:
  19:     - The input has one red object on a black background.
  20:     - Gray puzzle pieces are separate from the red object.
  21:     - Black gaps inside the red object's bounding area are holes to be plugged.
  22: 
  23:     Rule:
  24:     - Crop each gray puzzle piece.
  25:     - Greedily place pieces where they do not collide with the red object and cover the most hole cells.
  26:     - Paste all placed pieces and then recolor gray pixels to blue.
  27: 
  28:     Key insight:
  29:     - The red object's bounding area identifies the target holes, so the best placements maximize plugged black cells.
  30:     """
  31:     # Plan:
  32:     # 1. Detect the puzzle pieces and red thing
  33:     # 2. Extract the sprites of each puzzle piece
  34:     # 3. Try moving the puzzle pieces (but not so much that they collide with the red thing). You can translate but not rotate. Plug as much of the holes in the red thing as possible.
  35:     # 4. Change the color of the puzzle pieces to blue (just change everything that's grey to blue)
  36: 
  37:     # 1. Separate puzzle pieces from the red object
  38:     bg = Color.BLACK
  39:     red_objects = detect_objects(grid=input_grid, colors=[Color.RED], monochromatic=True, connectivity=8, background=bg)
  40:     assert len(red_objects) == 1, "There should be exactly one fully red object"
  41:     red_object = red_objects[0]
  42:     
  43:     puzzle_pieces = detect_objects(grid=input_grid, colors=[Color.GREY], monochromatic=True, connectivity=4, background=bg)
  44: 
  45:     # 2. Extract sprites by cropping
  46:     sprites = []
  47:     for piece in puzzle_pieces:
  48:         b = bbox(piece != bg)
  49:         assert b is not None
  50:         sprites.append(crop_bbox(piece, b))
  51: 
  52:     # Output begins with just the red and then we add stuff to it
  53:     output_grid = red_object.copy()
  54:     red_bbox_rect = bbox_mask(red_object != bg)
  55: 
  56:     # 3. Try moving the puzzle pieces, plugging as much of the red object is possible
  57:     sprites_to_move = list(sprites)
  58:     while sprites_to_move:
  59:         possible_solutions = [
  60:             (r0, c0, sprite)
  61:             for sprite in sprites_to_move
  62:             for r0 in range(output_grid.shape[0] - sprite.shape[0] + 1)
  63:             for c0 in range(output_grid.shape[1] - sprite.shape[1] + 1)
  64:         ]
  65: 
  66:         def score_solution(r0, c0, sprite):
  67:             # The score is -inf if it collides with the red object
  68:             # Otherwise it is the number of black pixels that are plugged by the sprite
  69: 
  70:             # Make a canvas by trying putting down the sprite
  71:             test_canvas = np.full_like(output_grid, bg)
  72:             test_canvas = paste(test_canvas, sprite, int(r0), int(c0), transparent=bg)
  73: 
  74:             # Check for collision
  75:             if collision(object1=test_canvas, object2=output_grid, background=bg):
  76:                 return float("-inf")
  77:             
  78:             # Count the number of black pixels that are plugged by the sprite, only counting those within the bounding box of the red object
  79:             red_object_mask = red_object != bg
  80:             test_object_mask = test_canvas != bg
  81:             plugged_pixels = test_object_mask & ~red_object_mask & red_bbox_rect
  82:             
  83:             return np.sum(plugged_pixels)
  84:         
  85:         best_r, best_c, best_sprite = max(possible_solutions, key=lambda solution: score_solution(*solution))
  86: 
  87:         # Blit the sprite into the output grid
  88:         output_grid = paste(output_grid, best_sprite, int(best_r), int(best_c), transparent=bg)
  89: 
  90:         # Remove the sprite from the list of sprites to move
  91:         sprites_to_move = [ sprite for sprite in sprites_to_move if sprite is not best_sprite ]
  92: 
  93:     # 4. grey->blue
  94:     output_grid[output_grid == Color.GREY] = Color.BLUE
  95: 
  96:     return output_grid
