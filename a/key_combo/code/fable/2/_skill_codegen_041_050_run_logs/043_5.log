+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        candidate = _gen_attempt()
+        if candidate is not None:
+            return candidate
+    raise RuntimeError("failed to generate a valid negative-shape hole puzzle")

