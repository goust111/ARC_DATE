   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Inflate a frame's hole-layout and fill each hole with its matching piece.
   9: 
  10:     Input structure:
  11:     - bg = most common color. Largest component is a monochrome frame enclosing bg holes.
  12:     - Outside pieces composed of k×k blocks; k = side of smallest solid square piece.
  13: 
  14:     Rule:
  15:     - Extract connected hole regions inside the frame as slots.
  16:     - Match each piece to a slot by comparing block-level shapes under rotation/flip.
  17:     - Output the layout scaled by k, with pieces placed in slots; frame color as background.
  18: 
  19:     Key insight: Pieces are k×k-block-scaled versions of holes; downsampling reveals shape matches under all 8 orientations.
  20:     """
  21:     g = np.array(grid, dtype=int)
  22:     bg = int(get_bg(g))
  23: 
  24:     # --- find the largest connected component of foreground (multicolor) ---
  25:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
