+        if _semantic_checks(input_grid, expected, hole_masks, hole_specs, placed_piece_specs):
+            return input_grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        candidate = _gen_attempt()
+        if candidate is not None:
