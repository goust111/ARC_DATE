+
+def _explicit_output(
+    input_grid: np.ndarray,
+    host_pos: tuple[int, int],
+    hole_specs: list[tuple[np.ndarray, tuple[int, int], int]],
+    piece_specs: list[tuple[np.ndarray, tuple[int, int]]],
