+HOLE_LIBRARY = _build_hole_library()
+AMBIGUOUS_BUCKETS = tuple(sorted(HOLE_LIBRARY))
+ALL_LIBRARY_ITEMS = tuple(
+    (bucket, mask.copy())
+    for bucket, masks in sorted(HOLE_LIBRARY.items())
+    for mask in masks
+)
