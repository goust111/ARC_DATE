+
+def _reserve_bbox(reserved: np.ndarray, r: int, c: int, h: int, w: int, pad: int) -> None:
+    hh, ww = reserved.shape
+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(hh, r + h + pad)
+    c1 = min(ww, c + w + pad)
+    reserved[r0:r1, c0:c1] = True
