+    out = np.asarray(input_grid, dtype=int).copy()
+    for piece_patch, (r0, c0) in piece_specs:
+        ph, pw = piece_patch.shape
+        piece_mask = piece_patch != BG
+        out[r0 : r0 + ph, c0 : c0 + pw][piece_mask] = BG
