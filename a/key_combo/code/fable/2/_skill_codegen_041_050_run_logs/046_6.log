+    ]
+    if path_order == manhattan_order:
+        return False
+
+    if np.array_equal(inp, out):
+        return False
+
+    out_bead_positions = [tuple(coord) for coord in spec["trunk"][: len(beads)]]
+    if len(set(out_bead_positions)) != len(out_bead_positions):
+        return False
