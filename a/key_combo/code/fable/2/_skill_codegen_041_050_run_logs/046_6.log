+    branch_beads.sort(key=lambda bead: bead["distance"])
+    labels = "".join(bead["branch"] for bead in branch_beads)
+    switches = sum(labels[i] != labels[i - 1] for i in range(1, len(labels)))
+    if switches < 2:
