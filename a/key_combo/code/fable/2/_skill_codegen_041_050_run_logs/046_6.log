+    return None
+
+
+def _assign_beads(layout: dict) -> dict | None:
+    trunk = layout["trunk"]
+    upper = layout["upper"]
+    lower = layout["lower"]
+
+    branch_pick = _choose_interleaved_branch_offsets(len(upper), len(lower))
