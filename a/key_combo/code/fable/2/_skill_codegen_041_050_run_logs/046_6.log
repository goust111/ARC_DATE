+    out = np.full_like(g, bg)
+    out[sink_mask] = SINK
+    out[path_mask] = TRACK
+    for i, (_d, _cell, color) in enumerate(bead_order):
+        r, c = trunk[i]
+        out[int(r), int(c)] = int(color)
+    return out
