+    column_to_bar: dict[int, int] = {}
+    for bar_index, bar in enumerate(bars):
+        for c in range(bar["c0"], bar["c1"] + 1):
+            assert c not in column_to_bar, "bar column intervals must not overlap"
+            column_to_bar[c] = int(bar_index)
