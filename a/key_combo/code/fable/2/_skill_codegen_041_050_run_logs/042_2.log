+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        built = _build_case()
+        if built is None:
+            continue
+        grid, metadata = built
+        try:
+            _semantic_checks(grid, metadata)
+        except AssertionError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid input for the repulsive-bar puzzle")

