+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLUE = 1
+GEN_BACKGROUND = 0
+GEN_NON_BLUE_COLORS = [2, 3, 4, 5, 6, 7, 8, 9]
+GEN_MAX_ATTEMPTS = 400
