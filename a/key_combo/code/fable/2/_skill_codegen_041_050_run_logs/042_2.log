+                    "row": int(r),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "length": int(run_len),
+                    "body_color": body_color,
+                    "blue_count": int(len(blue_cols)),
+                    "blue_cols": blue_cols,
+                    "body_cols": body_cols,
+                }
