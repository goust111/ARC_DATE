+def _scan_non_bg_runs(row: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    c = 0
+    width = int(row.shape[0])
+    while c < width:
+        if int(row[c]) == bg:
+            c += 1
+            continue
+        c0 = c
+        while c + 1 < width and int(row[c + 1]) != bg:
+            c += 1
+        runs.append((c0, c))
+        c += 1
+    return runs
