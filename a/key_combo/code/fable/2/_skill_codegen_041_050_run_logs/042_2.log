+        random.shuffle(remaining_bars)
+        for idx in remaining_bars:
+            bar = bars[idx]
+            col = _pick_spaced_column(list(range(int(bar["c0"]), int(bar["c1"]) + 1)), used_cols)
+            if col is None:
