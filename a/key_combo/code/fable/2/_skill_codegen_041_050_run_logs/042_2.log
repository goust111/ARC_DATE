+def _render_case(height: int, width: int, baseline_color: int, bars: list[dict], particles: list[dict]) -> np.ndarray:
+    grid = np.full((int(height), int(width)), GEN_BACKGROUND, dtype=int)
+    grid[-1, :] = int(baseline_color)
