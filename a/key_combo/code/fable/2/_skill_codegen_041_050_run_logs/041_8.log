+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        sample = _scene_attempt(rng)
+        if sample is None:
+            continue
+        inp, _ = sample
+        assert inp.ndim == 2 and max(inp.shape) <= 30
+        return inp
