    global _gen_sprite_bank_cache
    if _gen_sprite_bank_cache is not None:
        return _gen_sprite_bank_cache

    bank = {n: [] for n in range(_GEN_MIN_FG_PIXELS, _GEN_MAX_FG_PIXELS + 1)}
