+def _wall_cells(bbox: BBox, opening: str) -> list[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells: set[Coord] = set()
+    if opening == "up":
+        for c in range(c0, c1 + 1):
+            cells.add((r1, c))
+        for r in range(r0, r1 + 1):
+            cells.add((r, c0))
+            cells.add((r, c1))
+    elif opening == "down":
+        for c in range(c0, c1 + 1):
+            cells.add((r0, c))
+        for r in range(r0, r1 + 1):
