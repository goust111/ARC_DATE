+
+@dataclass(frozen=True)
+class DetectedContainer:
+    bbox: BBox
+    wall_color: int
+    opening: str
+    sealed: bool
+    lid_color: int | None
+
+
+@dataclass(frozen=True)
+class SceneContainer:
+    name: str
+    bbox: BBox
+    wall_color: int
+    opening: str
+    sealed: bool
+    lid_color: int | None
