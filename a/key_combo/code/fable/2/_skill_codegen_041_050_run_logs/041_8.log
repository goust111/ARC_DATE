    if rng.integers(0, 2) == 0:
        required = {(0, 0), (tile_h - 1, tile_w - 1)}
    else:
        required = {(0, tile_w - 1), (tile_h - 1, 0)}
    coords = [(r, c) for r in range(tile_h) for c in range(tile_w) if (r, c) not in required]
