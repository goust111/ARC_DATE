+    if left_inner_w > 1 and rng.random() < 0.5:
+        left_col = left_box[1] + 2
+    add_pixel("left_a", "lefty", (left_rows[0], left_col))
+    add_pixel("left_b", "lefty", (left_rows[1], left_col))
+    if len(left_rows) >= 3 and left_inner_w >= 2:
