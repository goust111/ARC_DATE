MIN_GRID_SIZE = 12
MAX_GRID_SIZE_EXCLUSIVE = 26
GRID_SIZE_PER_FRAME = 2
GRID_SIZE_PADDING = 2
MIN_FRAME_DIM = 3
MAX_FRAME_DIM = 13

