+def _find_components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": _bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return out
+
+
+def _is_rect_frame(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    hh = r1 - r0 + 1
+    ww = c1 - c0 + 1
+    if hh < 3 or ww < 3:
+        return False
+    if int(coords.shape[0]) != 2 * (hh + ww) - 4:
+        return False
+    local = np.zeros((hh, ww), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros((hh, ww), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(local, expected))
