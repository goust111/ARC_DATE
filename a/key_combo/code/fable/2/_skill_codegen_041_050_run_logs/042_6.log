+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros((hh, ww), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return bool(np.array_equal(local, expected))
