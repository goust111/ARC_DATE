+    global_counts = Counter(
+        int(v) for v in grid.reshape(-1) if int(v) not in (BG, GREY)
+    )
+    ranked = global_counts.most_common()
+    if ranked and ranked[0][0] == int(majority_color):
+        return False
+    return True
