+    r, c = start
+    path = [start]
+    mirrors: dict[tuple[int, int], int] = {}
+    segment_lengths: list[int] = []
+    visited = {start}
+    segment_steps = 0
+
+    for _ in range(h * w + 5):
+        nr = r + direction[0]
+        nc = c + direction[1]
+        if not in_bounds(grid.shape, nr, nc):
+            segment_lengths.append(segment_steps)
+            return {
+                "start": start,
+                "color": color,
+                "path": path,
+                "mirrors": mirrors,
+                "segment_lengths": segment_lengths,
+            }
