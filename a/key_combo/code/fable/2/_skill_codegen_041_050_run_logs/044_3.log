+        candidates = [
+            idx
+            for idx, cell in enumerate(free_prefix, start=1)
+            if TURN_SEGMENT_MIN <= idx <= TURN_SEGMENT_MAX and not _is_boundary(shape, cell)
+        ]
+        random.shuffle(candidates)
