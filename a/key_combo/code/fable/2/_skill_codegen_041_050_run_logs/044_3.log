+    for c in range(w):
+        if grid[0, c] != BACKGROUND:
+            markers.add((0, c))
+        if grid[h - 1, c] != BACKGROUND:
+            markers.add((h - 1, c))
+    for r in range(1, h - 1):
+        if grid[r, 0] != BACKGROUND:
+            markers.add((r, 0))
+        if grid[r, w - 1] != BACKGROUND:
+            markers.add((r, w - 1))
