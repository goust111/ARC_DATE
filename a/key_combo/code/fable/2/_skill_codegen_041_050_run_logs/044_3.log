+    return {"start": start, "path": path, "mirrors": mirrors, "segment_lengths": segment_lengths}
+
+
+def _build_ray(
+    shape: tuple[int, int],
+    side: str,
+    color: int,
+    occupied: set[tuple[int, int]],
