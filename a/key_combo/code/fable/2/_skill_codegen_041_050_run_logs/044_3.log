+    inp, out = _render_input_output(shape, rays)
+    if _validate_generated(inp, out, rays):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_SAMPLE_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
