+    path = [start]
+    mirrors: dict[tuple[int, int], int] = {}
+    segment_lengths: list[int] = []
+
+    def dfs(
+        current: tuple[int, int],
+        current_dir: tuple[int, int],
+        reflections_left: int,
+        used: set[tuple[int, int]],
+    ) -> bool:
