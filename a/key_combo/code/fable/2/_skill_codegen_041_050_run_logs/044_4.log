    out = _render_grid(placed, 1)
    inp = _render_grid(placed, 2)
    return inp if np.array_equal(main(inp), out) else None


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 522fdd07 input")

