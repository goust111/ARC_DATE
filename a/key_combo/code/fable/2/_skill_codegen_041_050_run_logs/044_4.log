+    H, W = canvas_shape
+    order = sorted(range(len(item_shapes)), key=lambda i: item_shapes[i][0] * item_shapes[i][1], reverse=True)
+    positions: list[tuple[int, int] | None] = [None] * len(item_shapes)
+    boxes: list[tuple[int, int, int, int]] = []
