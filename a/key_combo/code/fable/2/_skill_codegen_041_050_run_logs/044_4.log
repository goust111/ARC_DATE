+            return None
+
+        candidates = [(r, c) for r in range(r_min, r_max + 1) for c in range(c_min, c_max + 1)]
+        rng.shuffle(candidates)
+        for r, c in candidates:
+            box = (r, c, r + h - 1, c + w - 1)
+            if all(_boxes_separated(box, other, pad=_PLACEMENT_PADDING) for other in boxes):
+                positions[idx] = (r, c)
+                boxes.append(box)
