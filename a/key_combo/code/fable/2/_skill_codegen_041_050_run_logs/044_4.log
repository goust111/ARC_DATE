+    seen_axes = set()
+    seen_big_scale = False
+    for spec in pair_specs:
+        color = int(spec["color"])
+        assert color in beacon_pairs
+        coords = beacon_pairs[color]
+        assert coords == spec["beacons"]
+        seen_axes.add(spec["axis"])
