+def _make_stamp_mask(rng: np.random.Generator) -> np.ndarray:
+    h, w = _STAMP_SHAPES[int(rng.integers(len(_STAMP_SHAPES)))]
+    mask = np.zeros((h, w), dtype=bool)
+    mid_r = h // 2
+    mid_c = w // 2
+
