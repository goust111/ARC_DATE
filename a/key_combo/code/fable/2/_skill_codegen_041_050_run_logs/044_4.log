+    for idx in order:
+        h, w = item_shapes[idx]
+        r_min = _PLACEMENT_MARGIN
+        c_min = _PLACEMENT_MARGIN
+        r_max = H - h - _PLACEMENT_MARGIN
+        c_max = W - w - _PLACEMENT_MARGIN
