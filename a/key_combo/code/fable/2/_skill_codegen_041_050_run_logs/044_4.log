+
+_RNG = np.random.default_rng()
+_STAMP_SHAPES = ((5, 3), (7, 3), (3, 5), (7, 5))
+_PAIR_COUNT_BY_WIDTH = {3: (2, 4), 5: (2, 3)}
+_MAX_GENERATION_ATTEMPTS = 400
+_PLACEMENT_PADDING = 1
+_PLACEMENT_MARGIN = 1
+_PALETTE = tuple(range(1, 10))
