+        r0 = mid_r - copy.shape[0] // 2
+        c0 = mid_c - copy.shape[1] // 2
+        r1 = r0 + copy.shape[0]
+        c1 = c0 + copy.shape[1]
+        assert 0 <= r0 < r1 <= g.shape[0] and 0 <= c0 < c1 <= g.shape[1], "stamped copy must stay in-bounds"
