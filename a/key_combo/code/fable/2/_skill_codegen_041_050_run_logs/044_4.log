+def _parse_scene(
+    grid: np.ndarray,
+) -> tuple[int, int, np.ndarray, dict[int, tuple[tuple[int, int], tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
