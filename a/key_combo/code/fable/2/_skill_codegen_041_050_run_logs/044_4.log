+    stamp_comps = find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[stamp_color], return_format="dict")
+    assert len(stamp_comps) == 1
+    assert tuple(map(int, stamp_comps[0]["bbox"])) == stamp_box
