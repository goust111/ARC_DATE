+        expected = _recolor_scaled(oriented, int(spec["scale"]), color, bg)
+        expected_span = oriented.shape[1] if spec["axis"] == "H" else oriented.shape[0]
+        assert _pair_span(coords) == expected_span * int(spec["scale"])
+
