+        rel_a = (ordered[0][0] - r0, ordered[0][1] - c0)
+        rel_b = (ordered[1][0] - r0, ordered[1][1] - c0)
+        assert copy[rel_a] == spec["color"] and copy[rel_b] == spec["color"]
+        inp[ordered[0]] = spec["color"]
