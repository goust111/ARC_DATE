+    red = set() if ignore_red else set(scene["red"])
+    propagation = _propagate(scene["blocks"], grid.shape, red, int(scene["initial"]))
+    output = _render_output(
+        scene["grid"],
+        tuple(scene["yellow"]),
+        set(scene["red"]),
+        set(propagation["reachable"]),
