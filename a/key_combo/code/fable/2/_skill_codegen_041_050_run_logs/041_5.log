+def _marker_candidates(
+    block: tuple[int, int],
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    red: set[tuple[int, int]],
+    blocks: list[tuple[int, int]],
+    initial_idx: int,
+) -> list[tuple[int, int]]:
+    r, c = block
+    segments = [
+        ((r, c - 1), (r + 1, c - 1)),
+        ((r, c + 2), (r + 1, c + 2)),
+        ((r - 1, c), (r - 1, c + 1)),
+        ((r + 2, c), (r + 2, c + 1)),
