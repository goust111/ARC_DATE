    cols = (*upper_cols, *lower_cols)
    return tuple(zip(rows, cols))


def _gen_matches_solver(inp, expected):
    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, expected)


def _gen_attempt():
