+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+NOISE_COLORS = (1, 3, 5, 6, 7, 8, 9)
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+HORIZONTAL = "h"
+VERTICAL = "v"
+LEFT = "left"
+RIGHT = "right"
+UP = "up"
+DOWN = "down"
