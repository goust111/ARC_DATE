+        candidates: list[tuple[np.ndarray, np.ndarray]] = []
+        damaged_transforms = _distinct_transforms(damaged)
+        rng.shuffle(damaged_transforms)
+        missing_transforms = _distinct_transforms(missing)
+        rng.shuffle(missing_transforms)
