+
+def _place_holes_in_frame(
+    rng: np.random.Generator, hole_masks: list[np.ndarray]
+) -> tuple[int, int, list[tuple[int, int, np.ndarray]]]:
+    max_h = max(mask.shape[0] for mask in hole_masks)
