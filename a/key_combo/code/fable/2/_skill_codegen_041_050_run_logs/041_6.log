+    out: list[np.ndarray] = []
+    for flip in (False, True):
+        cur = np.flipud(base) if flip else base
+        for k in range(4):
+            m = np.rot90(cur, k)
+            key = _mask_key(m)
+            if key not in seen:
+                seen.add(key)
+                out.append(m.copy())
+    return out
+
