+        for shift in _subset_translations(complete, damaged):
+            missing = _missing_from_alignment(complete, damaged, shift)
+            candidates.append(
+                {
+                    "order": order,
+                    "shift": shift,
+                    "missing": missing,
+                    "complete": complete,
+                    "damaged": damaged,
+                }
+            )
