spec:
  grid: 17-24 rows x 17-24 cols, background 0
  sprite:
    count: 1-2, all identical within an example
    shape: 4x4 hollow rectangle (border filled, 2x2 interior is bg) [observed]
    color: single non-bg, non-1 color
    size: height > 1 and width > 1 (solver requires)
  bar:
    count: 2-5 total, 1-3 per sprite
    color: always 1
    thickness: 1 cell (horizontal bar has height 1, vertical has width 1)
    placement: always on grid edge (row 0, last row, col 0, or last col)
    span: exactly matches the sprite's col-span (horizontal bar) or row-span (vertical bar)
    matching: each bar matches exactly one sprite via span alignment; nearest unique on perpendicular axis
    direction: bar is strictly above/below/left/right of its matched sprite (not adjacent)
  tiling:
    tiles_per_bar: 2-5 (including original sprite position)
    gap: distance from sprite edge to bar >= 1 sprite dimension (so >=1 new copy)
    overlap: tile paths from different bars or sprites never overlap outside the original sprite bbox
  output:
    bars erased; sprite tiled periodically from original position toward each bar, clipping at grid boundary
    bg cells within sprite bbox stay bg (transparent paste)

generation_strategy:
