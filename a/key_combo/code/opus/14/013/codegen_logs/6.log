+                "bar": bar,
+                "mirrored": mirrored,
+                "area": int(sprite["area"]),
+                "bbox_area": (sr1 - sr0 + 1) * (sc1 - sc0 + 1),
+                "sort_anchor": (sr0, sc0, sr1, sc1),
