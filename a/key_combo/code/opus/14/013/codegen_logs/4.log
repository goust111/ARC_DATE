+def _bounded_shapes(
+    shapes: list[frozenset[tuple[int, int]]],
+    *,
+    sizes: tuple[int, ...],
+    max_h: int,
+    max_w: int,
+) -> list[frozenset[tuple[int, int]]]:
+    picked = []
+    for shape in shapes:
+        sh, sw = _shape_bbox(shape)
+        if len(shape) in sizes and sh <= max_h and sw <= max_w:
+            picked.append(shape)
