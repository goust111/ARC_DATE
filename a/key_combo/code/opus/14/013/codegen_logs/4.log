+def _expand_forbidden(coords: list[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    banned: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for dr, dc in NEIGHBORS8 + [(0, 0)]:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                banned.add((nr, nc))
+    return banned
