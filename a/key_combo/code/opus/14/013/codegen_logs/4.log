+def _independent_expected(inp: np.ndarray) -> np.ndarray:
+    h, w = inp.shape
+    regions = _color_regions(inp)
+    coord_to_kind: dict[tuple[int, int], str] = {}
+    for region in regions:
+        for cell in region["coords"]:
+            coord_to_kind[cell] = region["kind"]
