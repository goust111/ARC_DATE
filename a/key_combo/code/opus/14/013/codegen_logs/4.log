+            color = int(inp[r, c])
+            if color == 0:
+                if np.any(block != 0):
+                    return False
+                continue
+            kind = next(region["kind"] for region in regions if (r, c) in set(region["coords"]))
+            if kind == "solid":
+                if not np.all(block == color):
+                    return False
+            else:
+                if not np.array_equal(block, np.where(inp == color, color, 0)):
+                    return False
+                if np.all(block == color):
+                    return False
+    return True
+
+
+def _attempt_generate(rng: random.Random) -> np.ndarray | None:
+    h, w = rng.choice([(5, 5), (5, 4), (4, 5)])
+    num_regions = rng.choice([3, 4])
+    specs = _choose_specs(rng, num_regions)
+    placed = _place_specs(h, w, specs, rng)
+    if placed is None:
+        return None
+
+    colors = rng.sample(PALETTE, k=len(placed))
+    grid = np.zeros((h, w), dtype=int)
+    for spec, color in zip(placed, colors, strict=False):
+        for r, c in spec["coords"]:
+            grid[r, c] = color
+
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_generate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 4")

