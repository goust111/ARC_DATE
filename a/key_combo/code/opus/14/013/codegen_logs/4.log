+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    profiles = [((5, 5), 3), ((5, 5), 4), ((5, 4), 3), ((4, 5), 3)]
+    weights = [4, 3, 2, 2]
+    for _ in range(GEN_ATTEMPTS):
+        (h, w), num_regions = rng.choices(profiles, weights=weights, k=1)[0]
+        grid = _attempt_generate_profile(rng, h, w, num_regions)
+        if grid is not None:
+            return grid
