+
+
+def _choose_specs(rng: random.Random, num_regions: int) -> list[dict]:
+    overlap_size = rng.choice([3, 4, 5])
+    chain_pool = [shape for shape in CHAIN_SHAPES if len(shape) == overlap_size]
+    solid_pool = [shape for shape in SOLID_SHAPES if len(shape) == overlap_size]
