+    all_chain = _bounded_shapes(CHAIN_SHAPES, sizes=allowed_sizes, max_h=h, max_w=w)
+    all_solid = _bounded_shapes(SOLID_SHAPES, sizes=allowed_sizes, max_h=h, max_w=w)
