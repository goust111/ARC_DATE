+                        q.append((nr, nc))
+            region_mask = np.zeros((h, w), dtype=bool)
+            for rr, cc in coords:
+                region_mask[rr, cc] = True
+            lobes = _component_coords(region_mask, connectivity=4)
+            regions.append(
