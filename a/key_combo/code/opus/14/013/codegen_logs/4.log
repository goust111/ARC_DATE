+        specs.append({"kind": "chain", "shape": rng.choice(all_chain)})
+    while sum(spec["kind"] == "solid" for spec in specs) < solid_count:
+        specs.append({"kind": "solid", "shape": rng.choice(all_solid)})
+    rng.shuffle(specs)
+    return specs
