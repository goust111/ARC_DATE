0013: 
0014: 
0015: def main(input_grid: np.ndarray) -> np.ndarray:
0016:     """
0017:     Repeat each colored diagonal every three offsets to fill the 7x7 grid with an interlaced pattern.
0018: 
0019:     Input structure:
0020:     - The input is a 7x7 black grid containing three full diagonals.
0021:     - Each diagonal has a distinct non-black color.
0022:     - The diagonals run in the same slope direction.
0023: 
0024:     Rule:
0025:     - For every non-black input cell, draw its full diagonal in the output.
0026:     - Redraw that same diagonal color at offsets spaced by three rows.
0027:     - Clip the repeated diagonals to the 7x7 canvas.
0028: 
0029:     Key insight:
0030:     - A single colored diagonal defines a whole congruence class modulo three; repeating all three
0031:       classes creates the final interlacing.
0032:     """
0033:     output_grid = np.zeros((7, 7), dtype=int)
0034: 
0035:     # Loop over the input looking for any of the three diagonals
0036:     # If we find one, we will fill the output with the same color in the same pattern
0037:     for i in range(output_grid.shape[0]):
0038:         for j in range(output_grid.shape[1]):
0039:             c = input_grid[i][j]
0040:             if c != Color.BLACK:
0041:                 # Fill the output with the same color in the same pattern
0042:                 # Loop by multiples of 3 to create the pattern
0043:                 # Loop way beyond the canvas (double the canvas size) to make sure we cover everything
0044:                 for distance in range(0, output_grid.shape[0]*2, 3):
0045:                     draw_diagonal(output_grid, i-distance, j, c)
0046:                     draw_diagonal(output_grid, i+distance, j, c)
0047:     
0048:     return output_grid
