+    targets = _extract_blocks(grid, TARGET_COLOR)
+    assert len(starts) == 1, "expected exactly one red 2x2 start block"
+    assert 3 <= len(targets) <= 5, "expected 3-5 teal 2x2 target blocks"
+    return starts[0], targets
