+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        count = random.randint(*RECT_COUNT_RANGE)
+        rects = _generate_relative_chain(count)
+        if rects is None:
+            continue
+        fitted = _fit_chain_to_grid(rects)
