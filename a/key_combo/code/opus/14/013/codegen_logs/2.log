+def _sample_frame_chain(rng: np.random.Generator) -> list[tuple[int, int, int, int]] | None:
+    frame_count = int(rng.choice([2, 3], p=[0.45, 0.55]))
+    margins = [int(rng.integers(1, 3)) for _ in range(4)]
