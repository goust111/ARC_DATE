+    assert frames
+    for i, frame in enumerate(frames):
+        containers = [j for j, other in enumerate(frames) if i != j and _strictly_contains(other["bbox"], frame["bbox"])]
+        if containers:
+            parent = min(containers, key=lambda j: _bbox_area(frames[j]["bbox"]))
+            frame["parent"] = parent
