    chosen = []
    for _ in range(n):
        if not available:
            return None
        cell = _gen_choose(available)
        chosen.append(cell)
        used.append(cell)
        available = [other for other in available if max(abs(other[0] - cell[0]), abs(other[1] - cell[1])) >= MARKER_SPACING]
    return chosen


