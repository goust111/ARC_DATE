    for row_i, row_h in enumerate(row_heights):
        if row_i % 2 == 0:
            c0 = 0
            for col_i, col_w in enumerate(col_widths):
                if col_i % 2 == 0:
                    grid[r0 : r0 + row_h, c0 : c0 + col_w] = min_color
