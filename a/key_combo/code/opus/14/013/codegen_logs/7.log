    return cell not in occupied and all(n not in occupied for n in _gen_neighbors4(cell))


def _gen_pair_candidates(
    occupied: set[tuple[int, int]],
) -> list[tuple[tuple[int, int], tuple[int, int]]]:
    candidates = []
