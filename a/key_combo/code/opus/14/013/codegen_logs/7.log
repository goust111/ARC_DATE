import numpy as np

def mask(H,W,greens):
    ch=np.zeros((H,W),dtype=int)
    for r,c in greens:
        for rr in range(H):
            cc1=c+(rr-r)
            cc2=c-(rr-r)
            if 0<=cc1<W: ch[rr,cc1]=1
            if 0<=cc2<W: ch[rr,cc2]=1
    return ch

def run_lengths(H,W,greens):
    ch=mask(H,W,greens)
    for r,c in greens:
        ch[r,c]=1
    out=[]
    for r in range(H):
        pos=1
        while pos+1<W and ch[r,pos+1]:
            if (r,pos+1) in greens: break
            pos+=1
        out.append(pos-1)
    return out,ch

for W,gspec in {
    8:[(4,4,2),(4,5,2),(4,5,1),(4,6,1)],
    9:[(5,5,3),(5,5,2),(5,5,1),(5,6,1)],
    10:[(5,5,3),(5,6,3),(5,5,1),(5,6,1)],
}.items():
    H=12; rf=6
    greens=[(rf-d,c) for _,c,d in gspec]
    runs,ch=run_lengths(H,W,greens)
    print('W',W,'greens',greens)
    print('runs',runs)
    for r in range(H):
        row=''.join('G' if (r,c) in greens else ('#' if ch[r,c] else '.') for c in range(W))
        print(r,row,'run',runs[r])
    print()
