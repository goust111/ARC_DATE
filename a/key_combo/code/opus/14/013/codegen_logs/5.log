+def _place_outside_shape(
+    grid: np.ndarray,
+    boxes: list[tuple[int, int, int, int]],
+    intended_centers: set[tuple[int, int]],
+) -> bool:
+    h, w = grid.shape
+    templates = OUTSIDE_SHAPES[:]
+    random.shuffle(templates)
