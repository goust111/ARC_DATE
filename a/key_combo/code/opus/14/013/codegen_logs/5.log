    H, W = grid.shape
    candidates = [(r, c), (r-1, c), (r+1, c), (r, c-1), (r, c+1)]
    for cr, cc in candidates:
        if cr < 1 or cr >= H-1 or cc < 1 or cc >= W-1:
            continue
        all_fg = True
        for dr, dc in [(0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)]:
            nr, nc = cr + dr, cc + dc
            if nr < 0 or nr >= H or nc < 0 or nc >= W:
                all_fg = False
