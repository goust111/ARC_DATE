+            if any(abs(cand[0] - rr) + abs(cand[1] - cc) < 6 for rr, cc in centers):
+                continue
+            if any(not _boxes_separated(box, other, pad=1) for other in boxes):
+                continue
+            centers.append(cand)
+            boxes.append(box)
+            if len(centers) == k:
+                break
+
+        if len(centers) == k:
+            return centers
+    return None
