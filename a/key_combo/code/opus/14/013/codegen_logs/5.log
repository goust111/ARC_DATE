+        return False
+
+    component_sizes = [_component_size(grid, center) for center in centers]
+    if max(component_sizes, default=0) <= 5:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_HEIGHT_RANGE)
+    w = random.randint(*GRID_WIDTH_RANGE)
