+def _gen_attempt() -> tuple[np.ndarray, np.ndarray, list[dict]] | None:
+    height = random.randint(23, 29)
+    width = random.randint(23, 29)
+    count = 4 if min(height, width) >= 25 and random.random() < 0.4 else 3
