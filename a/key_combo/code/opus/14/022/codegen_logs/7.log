+
+def _paint_ring(out: np.ndarray, bbox: tuple[int, int, int, int], radius: int, color: int, bg: int) -> None:
+    r0, c0, r1, c1 = bbox
+    rr0, cc0 = r0 - radius, c0 - radius
+    rr1, cc1 = r1 + radius, c1 + radius
+    for c in range(cc0, cc1 + 1):
+        if int(out[rr0, c]) == bg:
+            out[rr0, c] = color
+        if int(out[rr1, c]) == bg:
+            out[rr1, c] = color
+    for r in range(rr0 + 1, rr1):
+        if int(out[r, cc0]) == bg:
+            out[r, cc0] = color
+        if int(out[r, cc1]) == bg:
+            out[r, cc1] = color
