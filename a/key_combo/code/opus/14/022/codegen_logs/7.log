+                    if any(_boxes_overlap(reserve, prev) for prev in reserved):
+                        continue
+                    candidates.append((r0, c0, reserve))
+            if not candidates:
+                ok = False
+                break
+            r0, c0, reserve = random.choice(candidates)
+            placed[idx] = (r0, c0)
+            reserved.append(reserve)
