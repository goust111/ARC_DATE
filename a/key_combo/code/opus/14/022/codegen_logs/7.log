+            color = assignments[idx][2]
+            changed = rebuilt[r0 - block["holes"] : r1 + block["holes"] + 1, c0 - block["holes"] : c1 + block["holes"] + 1]
+            assert np.any(changed == color), "each envelope must add visible pixels"
