+
+
+def _sample_markers(blocks: list[dict], colors: list[int], shape: tuple[int, int]) -> list[tuple[int, int, int]] | None:
+    block_boxes = [block["bbox"] for block in blocks]
+    block_centers = [block["center"] for block in blocks]
