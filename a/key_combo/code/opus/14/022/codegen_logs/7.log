+from __future__ import annotations
+
+from collections import Counter
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+MARKER_COLORS = (1, 2, 3)
+BLOCK_SIZE = 5
+MAX_RADIUS = 3
+GEN_ATTEMPTS = 500
