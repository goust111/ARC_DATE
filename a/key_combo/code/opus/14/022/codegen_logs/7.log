+def _hole_patterns(count: int) -> list[tuple[tuple[int, int], ...]]:
+    patterns = []
+    for combo in combinations(_INTERIOR_CELLS, count):
+        ok = True
+        for (r1, c1), (r2, c2) in combinations(combo, 2):
+            if abs(r1 - r2) + abs(c1 - c2) == 1:
+                ok = False
+                break
