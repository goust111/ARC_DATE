+
+        inp_sig = grid.tobytes() + str(grid.shape).encode()
+        out = main(grid)
+        out_sig = out.tobytes() + str(out.shape).encode()
+        if inp_sig in _SEEN_INPUTS or out_sig in _SEEN_OUTPUTS:
