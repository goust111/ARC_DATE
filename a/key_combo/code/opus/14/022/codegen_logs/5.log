    out: list[list[tuple[int, int]]] = []
    for ar, ac, dr, dc in anchors:
        path = [(ar + dr * k, ac + dc * k) for k in range(1, length + 1)]
        if any(not in_bounds(g.shape, r, c) or g[r, c] != _GEN_BLACK for r, c in path):
