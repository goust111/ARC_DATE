def _sample_guide_rows(height: int, count: int) -> list[int] | None:
    candidates = [r for r in range(3, height - 1)]
    rows = []
    for _ in range(count):
        valid = [r for r in candidates if not rows or r - rows[-1] >= 4]
        remaining = count - len(rows) - 1
        valid = [r for r in valid if r + 4 * remaining <= height - 2]
        if not valid:
            return None
        rows.append(random.choice(valid))
        candidates = [r for r in candidates if r > rows[-1]]
    return rows


def _interval_cols(start: int, width: int, total_w: int) -> set[int]:
    return {int((start + dc) % total_w) for dc in range(width)}


def _fits_non_wrapped(existing: list[tuple[int, int]], left: int, width: int, total_w: int) -> bool:
    cols = _interval_cols(left, width, total_w)
    return all(not (cols & _interval_cols(old_left, old_width, total_w)) for old_left, old_width in existing)


