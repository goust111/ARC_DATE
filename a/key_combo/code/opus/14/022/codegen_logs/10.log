    grid[r, c] = GEN_MARKER
    grid[gap] = GEN_BG
    return gap, exterior


def _gen_expected_output(
    base: np.ndarray, doors: list[tuple[tuple[int, int], tuple[int, int]]]
) -> np.ndarray:
    start = doors[0][1]
    end = doors[1][1]
    row_step = _sign(end[0] - start[0])
    col_step = _sign(end[1] - start[1])
    assert row_step != 0 and col_step != 0

