from __future__ import annotations

import random
from dataclasses import dataclass

import numpy as np


BG = 0
BLUE = 1
RED = 2
GREEN = 3
INPUT_RECT_COLORS = (1, 4, 5, 6, 7, 8, 9)
MAX_ATTEMPTS = 600


@dataclass(frozen=True)
class Rect:
    color: int
    top: int
    left: int
    height: int
    width: int
    guide_row: int


@dataclass(frozen=True)
class Move:
    rect: Rect
    new_left: int
    target_guide_row: int | None


def _find_guide_rows(grid: np.ndarray) -> list[int]:
    guides = [int(r) for r in range(grid.shape[0]) if np.all(grid[r] "'!= BG)]
    assert 2 <= len(guides) <= 3, "expected 2-3 full-width guide rows"
    assert guides == sorted(guides)
    assert all(guides[i + 1] - guides[i] >= 4 for i in range(len(guides) - 1))
    return guides


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.asarray(coords, dtype=int))
    return comps


def _extract_rectangles(grid: np.ndarray, guide_rows: list[int]) -> list[Rect]:
    fg = (grid != BG) & (grid != RED)
    rects: list[Rect] = []
    for coords in _components(fg):
        rows = coords[:, 0]
        cols = coords[:, 1]
        r0, r1 = int(rows.min()), int(rows.max())
        c0, c1 = int(cols.min()), int(cols.max())
        height = r1 - r0 + 1
        width = c1 - c0 + 1
        color = int(grid[r0, c0])
        assert color not in (BG, RED, GREEN)
        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
        assert np.all(patch == color), "foreground objects must be solid monochrome rectangles"
        assert coords.shape[0] == height * width
        assert r1 in guide_rows, "rectangle bottom edge must lie on a guide row"
        rects.append(Rect(color=color, top=r0, left=c0, height=height, width=width, guide_row=r1))

    assert rects, "expected at least one rectangle"
    per_guide = {r: 0 for r in guide_rows}
    for rect in rects:
        per_guide[rect.guide_row] += 1
        assert 2 <= rect.height <= 3
        assert 2 <= rect.width <= 4
    assert all(1 <= per_guide[row] <= 2 for row in guide_rows)
    return sorted(rects, key=lambda item: (item.guide_row, item.left))


def _compute_moves(rects: list[Rect], guide_rows: list[int], width: int) -> list[Move]:
    next_guide = {guide_rows[i]: guide_rows[i + 1] for i in range(len(guide_rows) - 1)}
    next_guide[guide_rows[-1]] = None
    moves: list[Move] = []
    by_row: dict[int, list[tuple[int, int, Rect]]] = {row: [] for row in guide_rows}
    for rect in rects:
        new_left = (rect.left + rect.width) % width
        target = next_guide[rect.guide_row]
        moves.append(Move(rect=rect, new_left=new_left, target_guide_row=target))
        cols = {int((new_left + dc) % width) for dc in range(rect.width)}
        by_row[rect.guide_row].append((min(cols), max(cols), rect))

    for row, row_moves in by_row.items():
        used: set[int] = set()
        for _mn, _mx, rect in row_moves:
            move = next(item for item in moves if item.rect == rect)
            cols = [(move.new_left + dc) % width for dc in range(rect.width)]
            assert len(set(cols)) == rect.width
            assert not (set(cols) & used), "translated rectangles on one guide row must not overlap"
            used.update(cols)
    return moves


def _paint_wrapped_rect(out: np.ndarray, rect: Rect, new_left: int) -> None:
    h, w = out.shape
    for dr in range(rect.height):
        rr = rect.top + dr
        assert 0 <= rr < h
        for dc in range(rect.width):
            out[rr, (new_left + dc) % w] = rect.color


def main(grid: np.ndarray) -> np.ndarray:
    """Move each guide-line rectangle right by its own width, then drop a ray to the next guide line.

    Input structure:
    - Black background with 2-3 full-width horizontal red guide lines.
    - Each guide line carries 1-2 solid non-red rectangles whose bottom edges lie on that guide line.
    - Rectangles are separated, axis-aligned, and have height 2-3 and width 2-4.

    Rule:
    - For every rectangle, erase it from its old position, restoring black above the guide line and red on the guide-line row.
    - Repaint the same rectangle shifted right by exactly its own width, wrapping around the left edge if needed.
    - From the shifted rectangle'"'s top-left column, emit a blue vertical ray downward, painting only black cells until the next lower red guide line; replace that guide-line hit cell with a green marker. Rectangles on the lowest guide line only move.

    Key insight:
    - The rectangle's own width determines the horizontal translation, and that new anchor column then determines where the downward ray meets the next guide line.
    \"\"\"
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    guide_rows = _find_guide_rows(g)
    rects = _extract_rectangles(g, guide_rows)
    moves = _compute_moves(rects, guide_rows, g.shape[1])

    out = g.copy()
    for rect in rects:
        if rect.height > 1:
            out[rect.top : rect.guide_row, rect.left : rect.left + rect.width] = BG
        out[rect.guide_row, rect.left : rect.left + rect.width] = RED

    for move in moves:
        _paint_wrapped_rect(out, move.rect, move.new_left)

    for move in moves:
        if move.target_guide_row is None:
            continue
        ray_col = move.new_left
        start_row = move.rect.top
        stop_row = move.target_guide_row
        for rr in range(start_row, stop_row):
            if out[rr, ray_col] == BG:
                out[rr, ray_col] = BLUE
            elif out[rr, ray_col] == RED:
                raise AssertionError(\"ray encountered a guide line before the next guide row\")
        assert out[stop_row, ray_col] == RED, \"ray must hit exposed red guide-line cell\"
        out[stop_row, ray_col] = GREEN

    return out


