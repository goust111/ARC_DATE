                    old_cols = set(range(left, left + width)) if left + width <= total_w else _interval_cols(left, width, total_w)
                    if len(old_cols) != width:
                        continue
                    if any(old_cols & set(range(other.left, other.left + other.width)) for other in placed):
                        continue
                    new_left = (left + width) % total_w
                    new_cols = _interval_cols(new_left, width, total_w)
                    if any(new_cols & cols for cols in translated_cols):
                        continue
                    if not is_bottom:
                        if new_left in prev_targets or new_left in ray_targets:
                            continue
                    candidates.append((height, width, left))
        if not candidates:
            return None
        height, width, left = random.choice(candidates)
        color = color_choices[idx]
        rect = Rect(color=color, top=guide_row - height + 1, left=left, height=height, width=width, guide_row=guide_row)
        placed.append(rect)
        translated_cols.append(_interval_cols((left + width) % total_w, width, total_w))
        if not is_bottom:
            ray_targets.add((left + width) % total_w)

    placed.sort(key=lambda item: item.left)
    if len(placed) == 2:
        gap_cols = sorted([placed[0].left + placed[0].width - 1, placed[1].left])
        if gap_cols[1] - gap_cols[0] <= 1:
            return None
    return placed


def _render_input(height: int, width: int, guide_rows: list[int], rects: list[Rect]) -> np.ndarray:
    grid = np.zeros((height, width), dtype=int)
    grid[guide_rows, :] = RED
    for rect in rects:
        grid[rect.top : rect.guide_row + 1, rect.left : rect.left + rect.width] = rect.color
    return grid


def _structure_ok(grid: np.ndarray) -> bool:
    try:
        guides = _find_guide_rows(grid)
        rects = _extract_rectangles(grid, guides)
    except Exception:
        return False
    if len(rects) < 3:
        return False
    if not any((rect.left + rect.width) > grid.shape[1] - 1 for rect in rects):
        pass
    return True


def _semantic_check(inp: np.ndarray, out: np.ndarray) -> None:
    guides = _find_guide_rows(inp)
    rects = _extract_rectangles(inp, guides)
    moves = _compute_moves(rects, guides, inp.shape[1])

    for move in moves:
        rect = move.rect
        orig_mask = np.zeros(inp.shape, dtype=bool)
        orig_mask[rect.top : rect.guide_row + 1, rect.left : rect.left + rect.width] = True
        if rect.height > 1:
            assert np.all(out[rect.top : rect.guide_row, rect.left : rect.left + rect.width] == BG)
        assert np.all(out[rect.guide_row, rect.left : rect.left + rect.width] != rect.color)
        new_cols = [(move.new_left + dc) % inp.shape[1] for dc in range(rect.width)]
        for dr in range(rect.height):
            rr = rect.top + dr
            assert all(out[rr, cc] == rect.color for cc in new_cols)
        if move.target_guide_row is None:
            assert GREEN not in out[rect.guide_row + 1 :, :]
            continue
        ray_col = move.new_left
        hit = move.target_guide_row
        assert out[hit, ray_col] == GREEN
        for rr in range(rect.top, hit):
            if rr <= rect.guide_row and ray_col in new_cols:
                continue
            assert out[rr, ray_col] in (BG, BLUE)

    top_moves = [m for m in moves if m.target_guide_row is not None]
    assert top_moves, "need at least one ray-emitting rectangle"
    assert any(m.new_left < m.rect.left for m in moves), "need wrap-around examples in the distribution"



def _gen_attempt() -> np.ndarray | None:
    height = random.randint(16, 24)
    width = random.randint(14, 22)
    guide_count = random.choice([2, 3, 3])
    guide_rows = _sample_guide_rows(height, guide_count)
    if guide_rows is None:
        return None

    all_rects: list[Rect] = []
    next_line_covered: set[int] = set()
    row_specs: list[list[Rect]] = [None] * guide_count  # type: ignore[list-item]

    future_targets: set[int] = set()
    for idx in range(guide_count - 1, -1, -1):
        row = guide_rows[idx]
        is_bottom = idx == guide_count - 1
        rects = _build_row_rects(width, row, future_targets, is_bottom)
        if rects is None:
            return None
        row_specs[idx] = rects
        future_targets |= {((rect.left + rect.width) % width) for rect in rects}

    for rects in row_specs:
        all_rects.extend(rects)

    inp = _render_input(height, width, guide_rows, all_rects)
    try:
        out = main(inp)
        if not _structure_ok(inp):
            return None
        _semantic_check(inp, out)
    except Exception:
        return None
    return inp



def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input for puzzle 10")
