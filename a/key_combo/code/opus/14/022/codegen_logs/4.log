+
+def _target_anchor(block: BlockSpec, *, reverse: bool = True, distance_override: int | None = None) -> tuple[int, int]:
+    side_dr, side_dc = SIDE_NORMALS[block.marker_side]
+    move_dr, move_dc = -side_dr, -side_dc
