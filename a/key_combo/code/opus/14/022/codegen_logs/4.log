+                dr, dc = SIDE_NORMALS[side]
+                src_r0 = target[0] + dr * distance
+                src_c0 = target[1] + dc * distance
+                block = BlockSpec(
+                    color=colors[idx],
+                    src_r0=int(src_r0),
+                    src_c0=int(src_c0),
