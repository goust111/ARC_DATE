+        side_choices = all_sides[:]
+        random.shuffle(side_choices)
+        if idx == 2 and len({block.distance for block in blocks}) == 1:
+            candidate_distances = [d for d in (1, 2, 3) if d != blocks[0].distance]
+        else:
