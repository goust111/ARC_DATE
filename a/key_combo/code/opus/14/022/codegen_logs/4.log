+        side_markers = {
+            "up": [(r0 - 1, c) for c in range(c0, c1 + 1) if r0 > 0 and g[r0 - 1, c] == MARKER],
+            "down": [(r1 + 1, c) for c in range(c0, c1 + 1) if r1 + 1 < g.shape[0] and g[r1 + 1, c] == MARKER],
+            "left": [(r, c0 - 1) for r in range(r0, r1 + 1) if c0 > 0 and g[r, c0 - 1] == MARKER],
