+
+BACKGROUND = 0
+MARKER = 9
+BLOCK_SIZE = 3
+GEN_ATTEMPTS = 800
+GRID_MIN = 15
+GRID_MAX = 20
+MIN_SOURCE_GAP = 2
+
+SIDE_NORMALS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+OVERLAP_DELTAS = [
+    (-2, 0),
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -2),
+    (0, -1),
+    (0, 1),
