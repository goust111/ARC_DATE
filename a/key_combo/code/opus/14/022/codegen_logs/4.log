+    all_markers = {(int(r), int(c)) for r, c in np.argwhere(g == MARKER)}
+    assert claimed_markers == all_markers, "every marker must belong to exactly one block"
+    assert 3 <= len(blocks) <= 4
+    return blocks
+
+
+def _render_output(
+    shape: tuple[int, int],
