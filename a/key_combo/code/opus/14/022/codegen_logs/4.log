+        c0 = random.randint(3, w - BLOCK_SIZE - 3)
+        other_r0 = r0 + overlap_delta[0]
+        other_c0 = c0 + overlap_delta[1]
+        if 0 <= other_r0 <= h - BLOCK_SIZE and 0 <= other_c0 <= w - BLOCK_SIZE:
+            target_a = (int(r0), int(c0))
+            target_b = (int(other_r0), int(other_c0))
+            break
