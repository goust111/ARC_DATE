+        _render_output(grid.shape, blocks, distance_override=1),
+        _render_output(grid.shape, blocks, distance_override=3),
+        _render_output(grid.shape, blocks, shorter_on_top=False),
+        _render_output(grid.shape, blocks, smaller_row_on_top=False),
