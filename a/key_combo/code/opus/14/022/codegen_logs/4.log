+            "left": [(r, c0 - 1) for r in range(r0, r1 + 1) if c0 > 0 and g[r, c0 - 1] == MARKER],
+            "right": [(r, c1 + 1) for r in range(r0, r1 + 1) if c1 + 1 < g.shape[1] and g[r, c1 + 1] == MARKER],
