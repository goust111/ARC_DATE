+    if not (0 <= block.src_r0 <= h - BLOCK_SIZE and 0 <= block.src_c0 <= w - BLOCK_SIZE):
+        return False
+    for r, c in _marker_cells(block):
+        if not (0 <= r < h and 0 <= c < w):
+            return False
