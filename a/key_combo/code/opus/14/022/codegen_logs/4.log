        w = max(grid.shape[1], max(_target_anchor(block)[1] + BLOCK_SIZE for block in blocks))
        full_h = max(h, max(r for block in blocks for r, _ in _marker_cells(block)) + 1)
        full_w = max(w, max(c for block in blocks for _, c in _marker_cells(block)) + 1)
        shape = (full_h, full_w)
        grid = _render_input(shape, blocks)
        if max(shape) > 30:
            continue
        if _validate_generated(grid):
            return grid
    raise RuntimeError("failed to generate a valid marked-projection ARC input")

