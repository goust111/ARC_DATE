+    target_boxes = [_bbox_from_anchor(*_target_anchor(block)) for block in blocks]
+    overlap_pairs = sum(
+        _overlap_area(target_boxes[i], target_boxes[j]) > 0
+        for i in range(len(target_boxes))
+        for j in range(i + 1, len(target_boxes))
