+            mask = np.zeros((3, 3), dtype=bool)
+            mask.flat[list(cells)] = True
+            if not _pattern_has_full_bbox(mask):
+                continue
+            if len(_find_components(mask)) != 1:
+                continue
+            patch = np.full((3, 3), BLACK, dtype=int)
+            patch[mask] = YELLOW
+            patterns.append(patch)
+    assert patterns
+    return patterns
