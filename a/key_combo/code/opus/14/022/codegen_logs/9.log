+def _bbox_h(box: tuple[int, int, int, int]) -> int:
+    return int(box[2] - box[0] + 1)
+
+
+def _bbox_w(box: tuple[int, int, int, int]) -> int:
+    return int(box[3] - box[1] + 1)
+
