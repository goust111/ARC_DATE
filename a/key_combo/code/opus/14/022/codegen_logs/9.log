+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    count = random.choice([3, 4])
+    h = random.randint(20, 24)
+    w = random.randint(20, 24)
+    layouts = _choose_layouts(h, w, count)
+    if layouts is None:
