+    for marker_index, block_index in intended_pairs.items():
+        fill_color = int(markers[marker_index]["fill_color"])
+        r0, c0, r1, c1 = blocks[block_index]["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1][grid[r0 : r1 + 1, c0 : c1 + 1] == BLACK] = fill_color
