+    block_meta: list[dict] = []
+    marker_meta: list[dict] = []
+    intended_pairs: dict[int, int] = {}
+
+    for i, ((_zone_index, (br, bc, dr, dc)), type_id, pattern) in enumerate(zip(layouts, type_ids, patterns)):
+        mr = br + dr
+        mc = bc + dc
+        glyph = GLYPH_ITEMS[type_id][1]
