+        assert _bbox_h(box) == BLOCK_SIZE and _bbox_w(box) == BLOCK_SIZE
+        r0, c0, r1, c1 = box
+        region = grid[r0 : r1 + 1, c0 : c1 + 1]
+        sig = _mask_signature(region, GREY)
+        assert sig in GLYPH_TO_COLOR
+        markers.append(
