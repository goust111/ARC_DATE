0073:                     boundary.add((nr, nc))
0074:         regions.append((region, boundary, touches, len(region)))
0075: 
0076:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
0077:     outside_idxs = set()
0078:     for i, (reg, _, _, _) in enumerate(regions):
0079:         if any(p in reg for p in corners if int(g[p]) == bg):
0080:             outside_idxs.add(i)
0081: 
0082:     cavities = []
0083:     for i, (reg, bnd, _, _) in enumerate(regions):
0084:         if i in outside_idxs or not bnd:
0085:             continue
0086:         bcols = {int(g[p]) for p in bnd}
0087:         cavities.append((reg, bnd, bcols))
