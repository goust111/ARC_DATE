+    random.shuffle(filled)
+    assignments = colors + [random.choice(colors) for _ in range(len(filled) - color_count)]
+    random.shuffle(assignments)
+    for (r, c), color in zip(filled, assignments):
+        motif[int(r), int(left + c)] = int(color)
+    return motif
