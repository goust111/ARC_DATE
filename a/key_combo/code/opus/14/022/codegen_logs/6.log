0101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:
0102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)
0103:     return [
0104:         tuple(int(x) for x in lengths)
