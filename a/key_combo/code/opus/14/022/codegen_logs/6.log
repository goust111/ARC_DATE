0034:     marker_rows = np.flatnonzero(g[:, 0] == Color.GREY)
0035:     assert marker_rows.size > 0, "expected grey marker rows"
0036:     assert np.array_equal(marker_rows, np.arange(marker_rows.size)), "grey marker must be a top-left run"
0037:     assert np.count_nonzero(g == Color.GREY) == marker_rows.size, "grey pixels are only the row markers"
