+    multiples = [w for w in range(3 * period, WIDTH_MAX + 1, period)]
+    if random.random() < 0.5 and non_multiple:
+        return int(random.choice(non_multiple))
+    if multiples:
+        return int(random.choice(multiples))
+    return int(random.choice(non_multiple))
