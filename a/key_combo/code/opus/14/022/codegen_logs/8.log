+
+def _matches_period(grid: np.ndarray, bg: int, period: int) -> bool:
+    if period <= 0:
+        return False
+    visible = _visible_width(grid, bg)
+    if visible < 2 * period:
+        return False
+
+    tile = np.asarray(grid[:, :period], dtype=int)
+    if not np.any(tile != bg):
+        return False
