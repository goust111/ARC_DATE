+        return False
+    if np.count_nonzero(inp == BACKGROUND) <= np.count_nonzero(inp != BACKGROUND):
+        return False
+    if period not in PERIOD_CHOICES:
+        return False
+    if not np.all(inp[:, 2 * period :] == BACKGROUND):
