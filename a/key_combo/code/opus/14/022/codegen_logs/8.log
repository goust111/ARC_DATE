        if empty_rows.size:
            tile[int(random.choice(empty_rows)), col] = color
    return tile


def _stair_tile(height: int, period: int, color: int) -> np.ndarray:
    tile = np.zeros((height, period), dtype=int)
    current = random.randint(1, height - 1)
    for col in range(period):
