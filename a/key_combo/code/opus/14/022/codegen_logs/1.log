0112:         if any(int(g[int(r), int(c)]) in extra_colors for r, c in comp["coords"])
0113:     ]
0114:     assert len(ref_indices) == 1, "expected exactly one fully marked reference motif"
0115:     ref_index = ref_indices[0]
