+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+BOX_SIZE = 5
+INTERIOR_RANGE = range(1, 4)
+CORNERS = ("TL", "TR", "BR", "BL")
+CORNER_INDEX = {corner: i for i, corner in enumerate(CORNERS)}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+NONZERO_COLORS = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
