+    _HOLE_PATTERNS[hole_count] = tuple(patterns)
+
+
+def _make_corner_patch(color: int, holes: int) -> np.ndarray:
+    patch = np.full((BOX_SIZE, BOX_SIZE), int(color), dtype=int)
+    for r, c in random.choice(_HOLE_PATTERNS[int(holes)]):
