+
+
+def _stamp_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    mask = patch != BG
+    window = grid[r0 : r0 + h, c0 : c0 + w]
