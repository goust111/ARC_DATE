+
+
+def _box_cells(r0: int, c0: int, h: int, w: int, *, pad: int, height: int, width: int) -> set[tuple[int, int]]:
+    cells = set()
+    for r in range(max(0, r0 - pad), min(height, r0 + h + pad)):
+        for c in range(max(0, c0 - pad), min(width, c0 + w + pad)):
+            cells.add((r, c))
