+        for r, c in obj["coords"]:
+            nr = dst_r0 + (r - r0)
+            nc = dst_c0 + (c - c0)
+            assert 0 <= nr < height and 0 <= nc < width
+            if int(g[nr, nc]) != bg and (nr, nc) not in source_cells:
+                raise AssertionError("corner move would overwrite a distractor")
