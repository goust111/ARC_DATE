+        dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, BOX_SIZE, BOX_SIZE)
+        reserved |= _box_cells(dst_r0, dst_c0, BOX_SIZE, BOX_SIZE, pad=1, height=height, width=width)
