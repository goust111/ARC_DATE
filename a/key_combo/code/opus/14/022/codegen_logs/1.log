+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            objects.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
+            )
+    return objects
+
