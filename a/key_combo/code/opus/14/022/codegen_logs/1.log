+    touches += int(c0 + w == width)
+    return touches
+
+
+def _can_place_distractor(
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    height: int,
+    width: int,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
