+            planned[(nr, nc)] = color
+
+    for (r, c), color in planned.items():
+        out[r, c] = color
+    return out
+
+
+_HOLE_CELLS = tuple((r, c) for r in INTERIOR_RANGE for c in INTERIOR_RANGE)
+_HOLE_PATTERNS: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {}
+for hole_count in (1, 2, 3):
+    patterns = []
