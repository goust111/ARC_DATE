+    decoy_pool = [decoy_pool[int(i)] for i in RNG.permutation(len(decoy_pool))]
+    one_cell = decoy_pool[0]
+    three_cell = decoy_pool[1]
+
+    counts = np.zeros((n, n), dtype=int)
