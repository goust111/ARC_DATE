+                break
+            pick = random.choice(valid)
+            chosen_by_index[idx] = pick
+            chosen_list.append(pick)
+        if failed:
+            continue
+        objects = [chosen_by_index[i] for i in range(3)]
+        if _semantic_checks(grid_shape, objects, want_overlap):
+            return objects
