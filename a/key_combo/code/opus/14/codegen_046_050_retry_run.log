+            if not bool((sub[0, :] == color).all() and (sub[-1, :] == color).all() and (sub[:, 0] == color).all() and (sub[:, -1] == color).all()):
+                raise AssertionError("rectangle border must stay solid")
+
+            grey_local = np.argwhere(sub == GREY)
