+        for corner in corners
+        if corner != missing and (corner[0] == missing[0] or corner[1] == missing[1])
+    ]
+    assert len(adjacent) == 2
+    directions = [(_sign(ar - missing[0]), _sign(ac - missing[1])) for ar, ac in adjacent]
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "side": side,
+        "missing": missing,
+        "adjacent": adjacent,
+        "directions": directions,
+        "inner_marker": inner,
+    }
+
