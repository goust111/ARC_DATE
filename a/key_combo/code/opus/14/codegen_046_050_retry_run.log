+def _is_connected(cells: tuple[tuple[int, int], ...]) -> bool:
+    cell_set = set(cells)
+    seen = {cells[0]}
+    stack = [cells[0]]
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(r, c):
+            if (rr, cc) in cell_set and (rr, cc) not in seen:
