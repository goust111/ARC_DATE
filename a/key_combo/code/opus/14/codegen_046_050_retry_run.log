+                "row": int(row),
+                "c0": int(c0),
+                "c1": int(c1),
+                "length": int(len(coords)),
+                "color": color,
+            }
+        )
+    comps.sort(key=lambda item: (item["row"], item["c0"]))
+    return comps
+
+
+def _legend_mapping(grid: np.ndarray, bg: int) -> dict[int, int]:
