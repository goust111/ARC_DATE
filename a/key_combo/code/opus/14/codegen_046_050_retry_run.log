+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _region_classes(vertices: np.ndarray) -> list[list[str]]:
+    rows = vertices.shape[0] - 1
+    cols = vertices.shape[1] - 1
+    out: list[list[str]] = []
+    for i in range(rows):
+        row: list[str] = []
+        for j in range(cols):
+            corners = [
+                int(vertices[i, j]),
+                int(vertices[i, j + 1]),
+                int(vertices[i + 1, j]),
+                int(vertices[i + 1, j + 1]),
+            ]
+            if len(set(corners)) == 1 and corners[0] not in (BG, SEP):
+                row.append("valid")
+            elif any(color in (BG, SEP) for color in corners):
+                row.append("missing")
+            else:
+                row.append("mixed")
+        out.append(row)
+    return out
