+        "tr": {"src": (r0 + 1, c1 - 1), "outer": (r0 - 1, c1 + 1), "dir": (-1, 1)},
+        "bl": {"src": (r1 - 1, c0 + 1), "outer": (r1 + 1, c0 - 1), "dir": (1, -1)},
