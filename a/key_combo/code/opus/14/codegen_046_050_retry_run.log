+def _contour_lengths_from_start(
+    bbox: tuple[int, int, int, int], start: tuple[int, int]
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    sr, sc = start
+    if sr == r0 - 1 and c0 <= sc <= c1:
+        a = sc - c0
+        b = c1 - sc
+    elif sr == r1 + 1 and c0 <= sc <= c1:
+        a = sc - c0
+        b = c1 - sc
+    elif sc == c0 - 1 and r0 <= sr <= r1:
