+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+PINK = 6
+
+DIAGONAL_COLORS = (BLUE, RED, GREEN)
+GEN_ATTEMPTS = 500
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.array(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int, copy=True)
+
+
+def _find_components(mask: np.ndarray) -> list[dict[str, object]]:
+    H, W = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(H):
+        for c in range(W):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if len(cells) == 0:
+        return False
+    start_r, start_c = map(int, cells[0])
+    seen = np.zeros_like(mask, dtype=bool)
+    q = deque([(start_r, start_c)])
+    seen[start_r, start_c] = True
+    reached = 0
+    while q:
+        r, c = q.popleft()
+        reached += 1
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return reached == int(mask.sum())
