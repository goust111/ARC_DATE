+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6)
+GREY = 5
+
+GEN_ATTEMPTS = 500
+LAYOUT_ATTEMPTS = 600
+POSITION_ATTEMPTS = 1200
+GAP = 2
+
+LENGTHS = (2, 3, 4, 5, 6)
+ORIENTATIONS = ((1, 1), (1, -1))
