+            "reached_top": [],
+            "stop_reason": [],
+            "occupied_blocked": [],
+        }
+
+    occupied = g == GREY
+    bends = [0 for _ in starts]
+    cells = [[(h - 1, c)] for c in starts]
+    heads = [(h - 1, c) for c in starts]
+    reached_top = [False for _ in starts]
+    stop_reason = [None for _ in starts]
+    occupied_blocked = [False for _ in starts]
+    active = [True for _ in starts]
+
+    for c in starts:
+        occupied[h - 1, c] = True
+
+    max_steps = h + w + 5
+    for _ in range(max_steps):
+        if not any(active):
+            break
+        for i in range(len(starts)):
+            if not active[i]:
+                continue
+            r, c = heads[i]
+            if r == 0:
+                active[i] = False
+                reached_top[i] = True
+                stop_reason[i] = "top"
+                continue
+
+            up_r, up_c = r - 1, c
+            if occupied[up_r, up_c]:
+                right_c = c + 1
+                if right_c >= w:
+                    active[i] = False
+                    stop_reason[i] = "boundary"
+                    continue
+                if occupied[r, right_c]:
+                    active[i] = False
+                    stop_reason[i] = "occupied" if g[r, right_c] != GREY else "obstacle"
+                    occupied_blocked[i] = g[r, right_c] != GREY
+                    continue
+                bends[i] += 1
+                heads[i] = (r, right_c)
+                cells[i].append((r, right_c))
+                occupied[r, right_c] = True
+                continue
+
+            heads[i] = (up_r, up_c)
+            cells[i].append((up_r, up_c))
+            occupied[up_r, up_c] = True
+            if up_r == 0:
+                active[i] = False
+                reached_top[i] = True
+                stop_reason[i] = "top"
+
+    return {
+        "starts": starts,
+        "bends": bends,
+        "cells": cells,
+        "heads": heads,
+        "reached_top": reached_top,
+        "stop_reason": stop_reason,
+        "occupied_blocked": occupied_blocked,
+    }
+
+
+def _simulate_independent(grid: np.ndarray) -> dict[str, Any]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    starts = _start_columns(g)
+
+    bends: list[int] = []
+    cells: list[list[tuple[int, int]]] = []
+    reached_top: list[bool] = []
+    stop_reason: list[str | None] = []
+
+    for c in starts:
+        single = np.zeros((h, w), dtype=int)
+        single[g == GREY] = GREY
+        single[h - 1, c] = RED
+        result = _simulate(single)
+        bends.append(int(result["bends"][0]))
+        cells.append(list(result["cells"][0]))
+        reached_top.append(bool(result["reached_top"][0]))
+        stop_reason.append(result["stop_reason"][0])
+
+    return {
+        "starts": starts,
+        "bends": bends,
+        "cells": cells,
+        "reached_top": reached_top,
+        "stop_reason": stop_reason,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Grow all bottom starts upward together, then recolor each finished path by its bend count.
+
+    Input structure:
+    - The grid is a black background with several red start pixels on the bottom row.
+    - Gray obstacle pixels appear only in interior rows and are pairwise non-adjacent.
+    - Every non-black, non-gray path cell created during growth belongs to exactly one start.
+
+    Rule:
+    - Treat all starts as simultaneously active heads, resolved left-to-right within each step to encode the
+      "leftmost start wins" competition rule for contested cells.
+    - Each active head first tries to grow one cell upward; if that target cell is already non-black or gray,
+      it instead tries to grow one cell to the right and counts one bend.
+    - If the right cell is also blocked or outside the grid, that path stops; a path also stops once it reaches
+      the top row.
+    - After all paths finish, recolor every cell of each path by its total bend count: 0->blue, 1->green,
+      2->yellow, 3 or more->orange. Preserve gray obstacles and black background.
+
+    Key insight:
+    - The final color is determined by simulating interacting upward/rightward growth, because other paths occupy
+      space and can change when a bend succeeds or fails.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = np.zeros_like(g)
+    out[g == GREY] = GREY
+
+    sim = _simulate(g)
+    for bends, path_cells in zip(sim["bends"], sim["cells"]):
+        color = _bend_color(int(bends))
+        for r, c in path_cells:
+            out[int(r), int(c)] = color
+    return out
+
+
+def _non_adjacent(existing: set[tuple[int, int]], r: int, c: int) -> bool:
+    for rr, cc in existing:
+        if max(abs(int(rr) - int(r)), abs(int(cc) - int(c))) <= 1:
+            return False
+    return True
+
+
+def _competition_obstacles(h: int, start_c: int, gap: int) -> list[tuple[int, int]]:
+    return [(h - 2 - 2 * j, start_c + j) for j in range(gap)]
+
+
+def _success_obstacles(h: int, start_c: int, count: int, row_offset: int) -> list[tuple[int, int]]:
+    return [(h - 2 - row_offset - 2 * j, start_c + j) for j in range(count)]
+
+
+def _valid_obstacle_positions(
+    h: int,
+    w: int,
+    starts: list[int],
+    obstacles: list[tuple[int, int]],
+) -> bool:
+    seen: set[tuple[int, int]] = set()
+    for r, c in obstacles:
+        if not (0 < r < h - 1 and 0 <= c < w):
+            return False
+        if c in starts and r == h - 1:
+            return False
+        if not _non_adjacent(seen, r, c):
+            return False
+        seen.add((int(r), int(c)))
+    return True
+
+
+def _build_candidate(rng: random.Random) -> np.ndarray | None:
+    path_count = rng.randint(3, 5)
+    gaps = [rng.choice((2, 3)) for _ in range(path_count - 1)]
+    left_margin = rng.randint(0, 2)
+    starts = [left_margin]
+    for gap in gaps:
+        starts.append(starts[-1] + gap)
+
+    comp_i = rng.randrange(path_count - 1)
+    comp_gap = starts[comp_i + 1] - starts[comp_i]
+
+    outside = [i for i in range(path_count) if i not in {comp_i, comp_i + 1}]
+    success_i = max(outside) if rng.random() < 0.7 else rng.choice(outside)
+
+    success_cap = 3
+    if success_i < path_count - 1:
+        success_cap = min(success_cap, starts[success_i + 1] - starts[success_i] - 1)
+    success_bends = rng.randint(1, max(1, success_cap))
+
+    right_margin = rng.randint(3, 5)
+    if success_i == path_count - 1:
+        right_margin = max(right_margin, success_bends + 2)
+    w = starts[-1] + right_margin + 1
+    if w > 16:
+        return None
+
+    max_bend_count = max(comp_gap, success_bends)
+    h = rng.randint(max(11, 2 * max_bend_count + 6), 15)
+
+    obstacles = _competition_obstacles(h, starts[comp_i], comp_gap)
+    row_offset = rng.choice((0, 1))
+    obstacles.extend(_success_obstacles(h, starts[success_i], success_bends, row_offset))
+
+    if not _valid_obstacle_positions(h, w, starts, obstacles):
+        return None
+
+    obstacle_set = {(int(r), int(c)) for r, c in obstacles}
+
+    max_extra = min(8 - len(obstacle_set), 2)
+    extra_count = rng.randint(0, max_extra)
+    extra_candidates = [
+        (r, c)
+        for r in range(1, h - 1)
+        for c in range(w)
+        if (r, c) not in obstacle_set and _non_adjacent(obstacle_set, r, c)
+    ]
+    rng.shuffle(extra_candidates)
+    for r, c in extra_candidates:
+        if len(obstacle_set) >= len(obstacles) + extra_count:
+            break
+        if _non_adjacent(obstacle_set, r, c):
+            obstacle_set.add((int(r), int(c)))
+
+    if not (3 <= len(obstacle_set) <= 8):
+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    for c in starts:
+        grid[h - 1, c] = RED
+    for r, c in obstacle_set:
+        grid[r, c] = GREY
+    return grid
+
+
+def _validate_semantics(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    if g.ndim != 2 or max(g.shape) > 30:
+        return False
+
+    starts = _start_columns(g)
+    if not (3 <= len(starts) <= 5):
+        return False
+    if np.count_nonzero(g[:-1] == RED) != 0:
+        return False
+    if any(starts[i + 1] - starts[i] < 2 for i in range(len(starts) - 1)):
+        return False
+
+    obstacle_coords = [tuple(map(int, rc)) for rc in np.argwhere(g == GREY)]
+    if not (3 <= len(obstacle_coords) <= 8):
+        return False
+    for r, c in obstacle_coords:
+        if not (0 < r < h - 1):
+            return False
+    for i, (r0, c0) in enumerate(obstacle_coords):
+        for r1, c1 in obstacle_coords[i + 1 :]:
+            if max(abs(r0 - r1), abs(c0 - c1)) <= 1:
+                return False
+
+    sim = _simulate(g)
+    independent = _simulate_independent(g)
+
+    if len(set(sim["bends"])) == 1:
+        return False
+    if len(set(_bend_color(b) for b in sim["bends"])) < 2:
+        return False
+
+    for bends, top in zip(sim["bends"], sim["reached_top"]):
+        if not top and bends < 1:
+            return False
+
+    if not any(int(a) != int(b) for a, b in zip(sim["bends"], independent["bends"])):
+        return False
+    if not any(sim["occupied_blocked"]):
+        return False
+    if not any(b > 0 for b in sim["bends"]):
+        return False
+    if not any(b >= 2 for b in sim["bends"]):
+        return False
+
+    out = main(g)
+    if out.shape != g.shape:
+        return False
+    if np.any(out[g == GREY] != GREY):
+        return False
+    if np.any(out[(g == BLACK) & (out == RED)]):
+        return False
+
+    unique_path_colors = {int(out[r, c]) for path in sim["cells"] for r, c in path}
+    if len(unique_path_colors) < 2:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(800):
+        grid = _build_candidate(rng)
+        if grid is not None and _validate_semantics(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid competitive-growth instance")

diff --git a/key_combo/code/opus/14/050/3.py b/key_combo/code/opus/14/050/3.py
new file mode 100644
index 0000000000000000000000000000000000000000..168ecf5692267c3f284d2b2d2e357ad7b27e9336
--- /dev/null
+++ b/key_combo/code/opus/14/050/3.py
@@ -0,0 +1,422 @@
+from __future__ import annotations
+
+import random
+from typing import TypedDict
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+PINK = 6
+
+GRID_HEIGHT_RANGE = (12, 15)
+GRID_WIDTH_RANGE = (13, 15)
+PAIR_COUNT_RANGE = (3, 5)
+PAIR_DISTANCE_RANGE = (1, 4)
+MAX_GENERATION_ATTEMPTS = 600
+
+
+Coord = tuple[int, int]
+
+
+class Triple(TypedDict):
+    pivot: Coord
+    source: Coord
+    target: Coord | None
+    category: str
+    same_row: bool
+    direction: str
+    source_panel: str
+    pivot_panel: str
+    target_panel: str | None
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _panel_name(c: int, divider_c: int) -> str:
+    if c < divider_c:
+        return "left"
+    if c > divider_c:
+        return "right"
+    return "divider"
+
+
+def _panel_background(c: int, divider_c: int) -> int:
+    return BLUE if c < divider_c else RED
+
+
+def _landing_color(c: int, divider_c: int) -> int:
+    # Using the opposite panel color keeps the landing result observable.
+    return RED if c < divider_c else BLUE
+
+
+def _find_divider_col(grid: np.ndarray) -> int:
+    cols = np.where(np.all(grid == GREY, axis=0))[0]
+    assert len(cols) == 1, f"expected exactly one full-height divider column, got {cols.tolist()}"
+    return int(cols[0])
+
+
+def _coords_of(grid: np.ndarray, color: int) -> list[Coord]:
+    return [(int(r), int(c)) for r, c in np.argwhere(grid == color)]
+
+
+def _rotate_ccw(source: Coord, pivot: Coord) -> Coord:
+    sr, sc = source
+    pr, pc = pivot
+    dr = sr - pr
+    dc = sc - pc
+    return pr - dc, pc + dr
+
+
+def _segment_cells(a: Coord, b: Coord) -> list[Coord]:
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        step = 1 if bc >= ac else -1
+        return [(ar, c) for c in range(ac, bc + step, step)]
+    if ac == bc:
+        step = 1 if br >= ar else -1
+        return [(r, ac) for r in range(ar, br + step, step)]
+    raise ValueError("segment_cells requires row- or col-aligned endpoints")
+
+
+def _nearest_pairs(sources: list[Coord], pivots: list[Coord]) -> list[tuple[Coord, Coord]]:
+    pairs: list[tuple[Coord, Coord]] = []
+    used_pivots: set[Coord] = set()
+    for source in sources:
+        candidates: list[tuple[int, Coord]] = []
+        for pivot in pivots:
+            if source[0] == pivot[0] or source[1] == pivot[1]:
+                dist = abs(source[0] - pivot[0]) + abs(source[1] - pivot[1])
+                candidates.append((dist, pivot))
+        assert candidates, f"source {source} has no aligned pivot"
+        best = min(dist for dist, _pivot in candidates)
+        best_pivots = [pivot for dist, pivot in candidates if dist == best]
+        assert len(best_pivots) == 1, f"source {source} has ambiguous nearest pivots {best_pivots}"
+        pivot = best_pivots[0]
+        assert pivot not in used_pivots, f"pivot {pivot} matched more than once"
+        used_pivots.add(pivot)
+        pairs.append((source, pivot))
+    assert len(used_pivots) == len(pivots), "every pivot should be used exactly once"
+    return pairs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Rotate each magenta source 90 degrees counterclockwise around its matched green pivot, then color the landing pixel by the landing panel.
+
+    Input structure:
+    - A single full-height grey divider column splits the grid into a blue left panel and a red right panel.
+    - Green pivot pixels and magenta source pixels are scattered on the two colored panels.
+    - Each source has exactly one nearest aligned pivot in the same row or column.
+
+    Rule:
+    - Match every source to its unique nearest aligned pivot.
+    - Erase the magenta sources back to their panel background colors.
+    - Rotate each source 90 degrees counterclockwise around its pivot, preserving distance.
+    - If the landing cell stays in-bounds and off the grey divider, draw a pixel whose color is determined by the landing panel.
+    - Keep the divider and all green pivots unchanged; drop rotations that land on the divider or outside the grid.
+
+    Key insight:
+    - Geometry picks the landing coordinates, but the landing coordinates alone do not finish the task: you must also use which side of the divider they fall on to choose the final color.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    divider_c = _find_divider_col(g)
+
+    sources = _coords_of(g, PINK)
+    pivots = _coords_of(g, GREEN)
+    assert len(sources) == len(pivots) >= 1, "expected equal non-zero source and pivot counts"
+
+    out = g.copy()
+    for sr, sc in sources:
+        assert sc != divider_c, "sources cannot be on the divider"
+        out[sr, sc] = _panel_background(sc, divider_c)
+
+    for source, pivot in _nearest_pairs(sources, pivots):
+        tr, tc = _rotate_ccw(source, pivot)
+        if not _in_bounds(g.shape, tr, tc):
+            continue
+        if tc == divider_c:
+            continue
+        if g[tr, tc] == GREEN:
+            continue
+        out[tr, tc] = _landing_color(tc, divider_c)
+
+    return out
+
+
+def _choose_divider(width: int) -> int:
+    center = width // 2
+    choices = [center + delta for delta in (-2, -1, 1, 2)]
+    choices = [c for c in choices if 2 <= c <= width - 3]
+    return random.choice(choices)
+
+
+def _all_triples(shape: tuple[int, int], divider_c: int) -> list[Triple]:
+    h, w = shape
+    triples: list[Triple] = []
+    for pr in range(h):
+        for pc in range(w):
+            if pc == divider_c:
+                continue
+            for dist in range(PAIR_DISTANCE_RANGE[0], PAIR_DISTANCE_RANGE[1] + 1):
+                for dr, dc, direction in ((-dist, 0, "up"), (dist, 0, "down"), (0, -dist, "left"), (0, dist, "right")):
+                    sr = pr + dr
+                    sc = pc + dc
+                    if not _in_bounds(shape, sr, sc) or sc == divider_c:
+                        continue
+                    tr, tc = _rotate_ccw((sr, sc), (pr, pc))
+                    if not _in_bounds(shape, tr, tc):
+                        category = "oob"
+                        target = None
+                        target_panel = None
+                    elif tc == divider_c:
+                        category = "divider"
+                        target = (tr, tc)
+                        target_panel = None
+                    else:
+                        category = _panel_name(tc, divider_c)
+                        target = (tr, tc)
+                        target_panel = category
+                    triples.append(
+                        {
+                            "pivot": (pr, pc),
+                            "source": (sr, sc),
+                            "target": target,
+                            "category": category,
+                            "same_row": dr == 0,
+                            "direction": direction,
+                            "source_panel": _panel_name(sc, divider_c),
+                            "pivot_panel": _panel_name(pc, divider_c),
+                            "target_panel": target_panel,
+                        }
+                    )
+    random.shuffle(triples)
+    return triples
+
+
+def _compatible(candidate: Triple, chosen: list[Triple]) -> bool:
+    pivot = candidate["pivot"]
+    source = candidate["source"]
+    target = candidate["target"]
+
+    occupied_input = {triple["pivot"] for triple in chosen} | {triple["source"] for triple in chosen}
+    if pivot in occupied_input or source in occupied_input or pivot == source:
+        return False
+
+    for triple in chosen:
+        old_source = triple["source"]
+        old_pivot = triple["pivot"]
+        if old_source[0] == pivot[0] or old_source[1] == pivot[1]:
+            return False
+        if source[0] == old_pivot[0] or source[1] == old_pivot[1]:
+            return False
+
+    visible_targets = {triple["target"] for triple in chosen if triple["target"] is not None and triple["category"] in {"left", "right"}}
+    if target is not None and candidate["category"] in {"left", "right"}:
+        if target in occupied_input or target in visible_targets or target == pivot or target == source:
+            return False
+
+    path_cells = set(_segment_cells(source, pivot)[1:-1])
+    if target is not None and candidate["category"] in {"left", "right"}:
+        path_cells |= set(_segment_cells(pivot, target)[1:])
+    for cell in occupied_input:
+        if cell in path_cells:
+            return False
+
+    return True
+
+
+def _requirement_list(pair_count: int) -> list[tuple[str, bool]]:
+    requirements: list[tuple[str, bool]] = [
+        ("left", True),
+        ("right", False),
+        (random.choice(("divider", "oob")), random.choice((True, False))),
+    ]
+    extras = pair_count - len(requirements)
+    pool = [
+        ("left", random.choice((True, False))),
+        ("right", random.choice((True, False))),
+        ("divider", random.choice((True, False))),
+        ("oob", random.choice((True, False))),
+    ]
+    for _ in range(extras):
+        requirements.append(random.choice(pool))
+    random.shuffle(requirements)
+    return requirements
+
+
+def _select_triples(shape: tuple[int, int], divider_c: int, requirements: list[tuple[str, bool]]) -> list[Triple] | None:
+    triples = _all_triples(shape, divider_c)
+    buckets: dict[tuple[str, bool], list[Triple]] = {}
+    for req in requirements:
+        if req not in buckets:
+            category, same_row = req
+            buckets[req] = [triple for triple in triples if triple["category"] == category and triple["same_row"] == same_row]
+            if not buckets[req]:
+                return None
+
+    ordered_reqs = sorted(requirements, key=lambda req: len(buckets[req]))
+
+    def search(i: int, chosen: list[Triple]) -> list[Triple] | None:
+        if i == len(ordered_reqs):
+            return chosen.copy()
+        req = ordered_reqs[i]
+        candidates = buckets[req][:]
+        random.shuffle(candidates)
+        for candidate in candidates:
+            if not _compatible(candidate, chosen):
+                continue
+            chosen.append(candidate)
+            result = search(i + 1, chosen)
+            if result is not None:
+                return result
+            chosen.pop()
+        return None
+
+    return search(0, [])
+
+
+def _render_input(shape: tuple[int, int], divider_c: int, triples: list[Triple]) -> np.ndarray:
+    h, w = shape
+    grid = np.empty((h, w), dtype=int)
+    for c in range(w):
+        if c == divider_c:
+            grid[:, c] = GREY
+        elif c < divider_c:
+            grid[:, c] = BLUE
+        else:
+            grid[:, c] = RED
+    for triple in triples:
+        pr, pc = triple["pivot"]
+        sr, sc = triple["source"]
+        grid[pr, pc] = GREEN
+        grid[sr, sc] = PINK
+    return grid
+
+
+def _expected_output(shape: tuple[int, int], divider_c: int, triples: list[Triple]) -> np.ndarray:
+    out = _render_input(shape, divider_c, [])
+    for triple in triples:
+        pr, pc = triple["pivot"]
+        out[pr, pc] = GREEN
+    for triple in triples:
+        target = triple["target"]
+        if target is None or triple["category"] not in {"left", "right"}:
+            continue
+        tr, tc = target
+        out[tr, tc] = _landing_color(tc, divider_c)
+    return out
+
+
+def _semantic_rich_enough(triples: list[Triple]) -> bool:
+    categories = {triple["category"] for triple in triples}
+    if "left" not in categories or "right" not in categories:
+        return False
+    if not categories.intersection({"divider", "oob"}):
+        return False
+    if not any(triple["same_row"] for triple in triples):
+        return False
+    if not any(not triple["same_row"] for triple in triples):
+        return False
+
