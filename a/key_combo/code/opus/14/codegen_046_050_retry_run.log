+    out = g.copy()
+    infos: list[dict[str, object]] = []
+    for comp in _find_components(g != BG):
+        info = _component_info(g, comp)
+        infos.append(info)
+        if not info["active"]:
+            continue
+        marker = info["marker"]
+        parking = info["parking"]
+        gate_center = info["gate_center"]
