+        r0_high = h - outer_h - 1
+        c0_low = 1
+        c0_high = w - outer_w - 1
+        r0 = int(rng.integers(r0_low, r0_high + 1))
+        c0 = int(rng.integers(c0_low, c0_high + 1))
