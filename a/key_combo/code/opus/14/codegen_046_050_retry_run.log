+def _segment_cells(segment: dict[str, int | str]) -> list[tuple[int, int]]:
+    orient = str(segment["orient"])
+    color = int(segment["color"])
+    _ = color
+    r0 = int(segment["r0"])
+    c0 = int(segment["c0"])
+    r1 = int(segment["r1"])
+    c1 = int(segment["c1"])
+    if orient == "horizontal":
+        return [(r0, c) for c in range(c0, c1 + 1)]
+    return [(r, c0) for r in range(r0, r1 + 1)]
