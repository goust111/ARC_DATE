+def _dihedral_arrays(arr: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    for k in range(4):
+        rot = np.rot90(arr, k)
+        out.append(np.array(rot, dtype=arr.dtype, copy=True))
+        out.append(np.array(np.fliplr(rot), dtype=arr.dtype, copy=True))
+    return out
