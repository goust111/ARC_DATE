+def _place_template(grid: np.ndarray, template: np.ndarray, corner: str) -> tuple[int, int, int, int]:
+    h, w = template.shape
+    gh, gw = grid.shape
+    if corner == "tl":
+        r0, c0 = 0, 0
+    elif corner == "tr":
+        r0, c0 = 0, gw - w
+    elif corner == "bl":
