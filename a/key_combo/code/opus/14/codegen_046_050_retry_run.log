+        (top_demo_row, top_demo_col),
+        (bottom_demo_row, bottom_demo_col),
+        (suppress_row, suppress_col),
+    }
+
+    for _ in range(target_extra):
+        r = int(rng.integers(panel_h))
+        c = int(rng.integers(width))
+        if (r, c) in protected:
