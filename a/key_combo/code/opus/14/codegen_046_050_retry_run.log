+        "mirror_bar": frozenset(mirror_bar),
+        "mirror_shadow": frozenset(mirror_shadow),
+        "input_cells": frozenset(set(bar_cells) | {indicator}),
+        "side": side,
+        "start": start,
+        "attach": attach,
+    }
