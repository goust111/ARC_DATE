+def _infer_track_cols(visible_cols, covered_col):
+    base = sorted(set(int(c) for c in visible_cols) | {int(covered_col)})
+    assert len(base) >= 6
+    diffs = [b - a for a, b in zip(base, base[1:])]
+    spacing = 0
