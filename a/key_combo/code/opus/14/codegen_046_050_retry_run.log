+def _apply_winner_transform(grid: np.ndarray, winner: dict) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    r0, c0, r1, c1 = winner["bbox"]
+    color = int(winner["color"])
+    for r in range(r0 + 1, r1):
