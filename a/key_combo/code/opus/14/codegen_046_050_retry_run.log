+    for r, c in scene["sprite_coords"]:
+        out[r, c] = BG
+    for c in scene["track_cols"]:
+        out[scene["track_row"], c] = GREEN
+
+    balance_col = scene["track_cols"][scene["balance_idx"]]
+    dc = balance_col - scene["sprite_center"][1]
