+    for r, c in np.argwhere(symmetric):
+        d = _chebyshev((int(r), int(c)), control)
+        out[int(r), int(c)] = YELLOW if d % 2 == 1 else GREEN
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
