    backward = _reachable(g, bg, end, [(-dr, -dc) for dr, dc in moves], bounds)
    path = forward & backward
    assert path[start]
    assert path[end]

    out = g.copy()
    out[path] = Color.YELLOW
    for gap, _ in doors:
        assert g[gap] == bg
        out[gap] = Color.YELLOW
    return out

