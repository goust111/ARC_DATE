+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    if np.any(out == GREY):
+        return False
+    if not np.array_equal(out[(grid != GREY)], grid[(grid != GREY)]):
+        return False
+
+    for comp in grey_comps:
+        area = len(comp)
+        target = mapping[area]
+        if any(int(out[r, c]) != int(target) for r, c in comp):
+            return False
+
+    return True
+
