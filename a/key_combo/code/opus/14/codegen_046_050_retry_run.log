+    if max_side < SIDE_MIN:
+        return None
+
+    side = random.randint(SIDE_MIN, max_side)
+    r0 = random.randint(1, h - side - 2)
+    c0 = random.randint(1, w - side - 2)
+    r1, c1 = r0 + side, c0 + side
