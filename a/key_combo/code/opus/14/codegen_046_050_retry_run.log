+            if state in (2, 3):
+                bottom[r, c] = _rand_color(rng)
+        else:
+            if rng.random() < 0.72:
+                continue
+            if rng.random() < 0.5:
+                if top[r, c] == BLACK and bottom[r, c] == BLACK:
+                    top[r, c] = _rand_color(rng)
+            elif top[r, c] == BLACK:
+                bottom[r, c] = _rand_color(rng)
+
+    if np.count_nonzero(top) < 3:
+        for _ in range(30):
+            r = int(rng.integers(panel_h))
+            c = int(rng.choice(normal_cols))
+            if top[r, c] == BLACK and bottom[r, c] == BLACK:
+                top[r, c] = _rand_color(rng)
+                if np.count_nonzero(top) >= 3:
+                    break
+
+    if np.count_nonzero(bottom) < 3:
+        for _ in range(30):
+            r = int(rng.integers(panel_h))
+            c = int(rng.choice(normal_cols))
+            if top[r, c] == BLACK and bottom[r, c] == BLACK:
+                bottom[r, c] = _rand_color(rng)
