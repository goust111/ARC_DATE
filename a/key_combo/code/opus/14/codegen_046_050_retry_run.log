+    order = sorted(range(3), key=lambda idx: len(candidate_lists[idx]))
+    for _ in range(MAX_LAYOUT_TRIES):
+        chosen_by_index: dict[int, dict] = {}
+        chosen_list: list[dict] = []
+        failed = False
