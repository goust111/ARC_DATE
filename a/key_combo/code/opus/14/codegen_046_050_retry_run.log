+BG = 0
+FRAME = 1
+CONTROL = 2
+
+DIRS = [
+    ("up", (-1, 0)),
+    ("right", (0, 1)),
+    ("down", (1, 0)),
+    ("left", (0, -1)),
+]
+DIR_INDEX = {name: i for i, (name, _delta) in enumerate(DIRS)}
