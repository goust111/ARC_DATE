+
+
+def _sample_sizes(
+    rng: random.Random,
+    lengths: list[int],
+    winner_idx: int,
+) -> list[tuple[int, int]]:
+    winner_length = lengths[winner_idx]
+    winner_min = max(5, winner_length + 2)
+    winner_h = rng.randint(winner_min, min(9, winner_min + 1))
+    winner_w = rng.randint(winner_min, min(9, winner_min + 1))
+    sizes: list[tuple[int, int] | None] = [None] * len(lengths)
+    sizes[winner_idx] = (winner_h, winner_w)
+
+    losers = [idx for idx in range(len(lengths)) if idx != winner_idx]
+    big_idx = rng.choice(losers)
+
+    for idx, length in enumerate(lengths):
+        if idx == winner_idx:
+            continue
+        min_side = max(5, length + 2)
+        if idx == big_idx:
+            h_lo = max(min_side, winner_h)
+            w_lo = max(min_side, winner_w)
+            h = rng.randint(h_lo, min(9, max(h_lo, winner_h + 1)))
+            w = rng.randint(w_lo, min(9, max(w_lo, winner_w + 1)))
+            if h * w <= winner_h * winner_w:
+                if h < 9:
+                    h += 1
+                elif w < 9:
+                    w += 1
+        else:
+            h = rng.randint(min_side, min(9, min_side + 2))
+            w = rng.randint(min_side, min(9, min_side + 2))
+        sizes[idx] = (h, w)
+
+    return [(int(h), int(w)) for h, w in sizes]
+
+
+def _place_bboxes(
+    rng: random.Random,
+    shape: tuple[int, int],
+    sizes: list[tuple[int, int]],
+) -> list[tuple[int, int, int, int]] | None:
+    h, w = shape
+    order = sorted(range(len(sizes)), key=lambda idx: sizes[idx][0] * sizes[idx][1], reverse=True)
+    placed: list[tuple[int, int, int, int] | None] = [None] * len(sizes)
+    committed: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        rh, rw = sizes[idx]
+        options = []
