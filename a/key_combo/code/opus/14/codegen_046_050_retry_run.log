+    forbidden_cols = {int(path["visible_endpoint"][1]) for path in paths}
+    pink_slot = _choose_run_slot(h, w, sep, t, paths, selected_indices, forbidden_cols)
+    if pink_slot is None:
+        return None
+    pink_row, pink_start = pink_slot
