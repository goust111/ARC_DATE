+def _is_connected(cells: set[tuple[int, int]]) -> bool:
+    start = next(iter(cells))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nbr in _neighbors4(r, c):
+            if nbr in cells and nbr not in seen:
+                seen.add(nbr)
+                stack.append(nbr)
+    return seen == cells
