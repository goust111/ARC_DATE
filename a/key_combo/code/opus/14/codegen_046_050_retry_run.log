+            inner_w = int(rng.integers(5, 9))
+        else:
+            inner_h = int(rng.integers(5, 7))
+            inner_w = int(rng.integers(5, 7))
+        sizes.append((inner_h, inner_w))
+    return sizes
+
+
+def _choose_column_counts(
+    inner_h: int,
+    inner_w: int,
