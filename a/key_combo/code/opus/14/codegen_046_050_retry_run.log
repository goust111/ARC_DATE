+    out = g.copy()
+    lengths: dict[tuple[int, int, int, int], dict[str, int]] = {}
+    for obj in objs:
+        bbox = obj["bbox"]
+        depth = int(obj["depth"])
+        color = int(obj["outer"])
+        lengths[obj["id"]] = {}
+        for side in SIDES:
+            actual = 0
+            for step in range(1, depth + 1):
+                cells = _ray_cells(bbox, side, step)
+                if not cells:
+                    break
+                if any((not _in_bounds(out.shape, r, c)) or out[r, c] != bg for r, c in cells):
+                    break
+                for r, c in cells:
+                    out[r, c] = color
+                actual = step
+            lengths[obj["id"]][side] = actual
