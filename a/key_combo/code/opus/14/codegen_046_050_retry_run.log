+
+    actual = _union_targets(two_cells, dirs, n)
+    ge2 = _union_targets({cell for cell in ordinary if int(counts[cell]) in (2, 3) and cell in safe}, dirs, n)
+    nonzero = _union_targets({cell for cell in ordinary if int(counts[cell]) in (1, 2, 3) and cell in safe}, dirs, n)
+    allsafe = _union_targets({cell for cell in ordinary if cell in safe}, dirs, n)
+    one_only = _union_targets(one_safe, dirs, n)
+    three_only = _union_targets(three_safe, dirs, n)
+
+    if not actual:
+        return False
+    if exemplar in actual:
