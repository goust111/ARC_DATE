+            (fh, fw)
+            for fh in range(FRAME_SIDE_MIN, min(OTHER_SIDE_MAX, h - 4) + 1)
+            for fw in range(FRAME_SIDE_MIN, min(OTHER_SIDE_MAX, w - 4) + 1)
