+    h = sum(row_heights) + region_rows + 1
+    w = sum(col_widths) + region_cols + 1
+    grid = np.full((h, w), BG, dtype=int)
+
+    row_lines = [0]
+    cur = 0
+    for size in row_heights:
+        cur += 1 + size
+        row_lines.append(cur)
+    col_lines = [0]
+    cur = 0
+    for size in col_widths:
+        cur += 1 + size
