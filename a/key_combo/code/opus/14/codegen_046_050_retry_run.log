+    down = []
+    for col in track_cols:
+        up.append(_scan_hit(g, track_row, col, -1))
+        down.append(_scan_hit(g, track_row, col, 1))
+
+    balance = [
+        idx
+        for idx, ((d_up, _), (d_down, _)) in enumerate(zip(up, down))
+        if math.isfinite(d_up) and d_up == d_down
