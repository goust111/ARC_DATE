+
+def _iter_earlier_pairs(shape: tuple[int, int], row_period: int, col_period: int):
+    h, w = shape
+    for rr in range(2, h + 1):
+        for cc in range(2, w + 1):
+            if (rr, cc) == (row_period, col_period):
