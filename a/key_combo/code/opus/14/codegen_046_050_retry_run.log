+
+_BG = 0
+_COLORS = (1, 2, 3, 4)
+_FRAME_COUNT_CHOICES = (3, 4)
+_GRID_RANGE = (15, 20)
+_FRAME_MIN_SIZE = 4
+_FRAME_MAX_SIZE = 8
+_MAX_DEPTH = max(_FRAME_COUNT_CHOICES)
+_OUTER_MARGIN = _MAX_DEPTH
+_GEN_ATTEMPTS = 600
