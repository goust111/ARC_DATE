+
+
+def _strict_interior_cells(spec: dict) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = spec["bbox"]
+    cells = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if _strict_interior(spec, r, c):
+                cells.append((r, c))
