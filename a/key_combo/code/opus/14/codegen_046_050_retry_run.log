+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(GRID_BOUNDS[0], GRID_BOUNDS[1])
+    w = random.randint(GRID_BOUNDS[0], GRID_BOUNDS[1])
+    count = random.randint(OBJECT_COUNT_RANGE[0], OBJECT_COUNT_RANGE[1])
