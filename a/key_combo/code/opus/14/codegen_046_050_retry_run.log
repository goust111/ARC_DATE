+
+def _sample_full_anchor(
+    grid_shape: tuple[int, int],
+    full_shape: tuple[int, int],
+    template_box: tuple[int, int, int, int],
+) -> tuple[int, int] | None:
+    gh, gw = grid_shape
+    fh, fw = full_shape
+    choices = []
+    for r0 in range(1, gh - fh):
