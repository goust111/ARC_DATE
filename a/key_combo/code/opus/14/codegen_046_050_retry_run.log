+
+    actual_targets = _union_targets(two_cells, dirs, n)
+    model = {
+        "n": n,
+        "cell_size": cell_size,
+        "dirs": dirs,
+        "exemplar": exemplar,
+        "template_cells": tuple(sorted(template_cells)),
+        "counts": counts,
+        "actual_targets": actual_targets,
+    }
+    return model
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
