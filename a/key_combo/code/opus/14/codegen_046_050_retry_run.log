+    }
+
+    counts = model["counts"]
+    two_cells = {cell for cell in ordinary if int(counts[cell]) == 2}
+    one_safe = {cell for cell in ordinary if int(counts[cell]) == 1 and cell in safe}
+    three_safe = {cell for cell in ordinary if int(counts[cell]) == 3 and cell in safe}
+    zero_safe = {cell for cell in ordinary if int(counts[cell]) == 0 and cell in safe}
+
+    if len(two_cells) < 2 or not one_safe or not three_safe:
+        return False
+    if any(cell not in safe for cell in two_cells):
+        return False
+    if not _is_asymmetric(dirs):
