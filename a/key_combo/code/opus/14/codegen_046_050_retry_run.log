0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """Repeat the foreground row band vertically to fill the whole grid.
0008: 
0009:     Input structure
0010:     - The input is a 2D grid with a background color and one contiguous horizontal
0011:       band of rows containing all non-background pixels.
0012:     - Rows outside that band are entirely background.
0013: 
0014:     Rule
0015:     - Use the full-width foreground band as a vertical tile.
0016:     - Repeat that tile upward and downward over the original canvas, keeping the
0017:       original band row aligned with its input row position.
0018: 
0019:     Key insight
0020:     - The sparse input is a phase marker for a vertical row pattern, not a set of
0021:       separate objects to move or recolor.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     assert g.ndim == 2, "input must be a 2D grid"
0025: 
0026:     bg = int(get_bg(g))
0027:     active_rows = np.any(g != bg, axis=1)
0028:     rows = np.flatnonzero(active_rows)
0029:     assert rows.size > 0, "grid must contain a foreground row band"
0030: 
0031:     r0 = int(rows[0])
0032:     r1 = int(rows[-1])
0033:     assert np.array_equal(rows, np.arange(r0, r1 + 1)), "foreground rows must form one contiguous band"
0034:     assert np.all(g[:r0] == bg) and np.all(g[r1 + 1 :] == bg), "rows outside the band must be background"
