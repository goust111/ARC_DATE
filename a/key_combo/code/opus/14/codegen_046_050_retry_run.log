+def _make_extra_object() -> dict:
+    depth = random.choices((2, 3, 4), weights=(4, 4, 1))[0]
+    min_h = 2 * depth - 1
+    min_w = 2 * depth - 1
+    h = random.randint(min_h, min(8, min_h + 2))
+    w = random.randint(min_w, min(8, min_w + 2))
