+    r0, c0, r1, c1 = frame
+    inner_r0 = r0 + 1
+    inner_c0 = c0 + 1
+    inner_r1 = r1 - 1
+    inner_c1 = c1 - 1
+
+    freeze_cols = set()
+    if r1 + 1 < src.shape[0]:
+        for c in range(inner_c0, inner_c1 + 1):
+            if int(src[r1 + 1, c]) == RED:
+                freeze_cols.add(c)
+
+    yellow_positions: list[tuple[int, int]] = []
+    for r in range(inner_r0, inner_r1 + 1):
+        for c in range(inner_c0, inner_c1 + 1):
+            if int(src[r, c]) == YELLOW:
+                yellow_positions.append((r, c))
+                dst[r, c] = BG
+
+    counts: dict[int, int] = {}
+    for r, c in yellow_positions:
+        if c in freeze_cols:
+            dst[r, c] = YELLOW
+        else:
+            counts[c] = counts.get(c, 0) + 1
+
+    for c, count in counts.items():
+        for r in range(inner_r1 - count + 1, inner_r1 + 1):
+            dst[r, c] = YELLOW
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Freeze marked columns inside each grey frame while the other yellow pixels fall and stack, then erase the red markers.
+
+    Input structure:
+    - The grid has a black background with one or two grey one-pixel-thick hollow rectangular frames.
+    - Yellow movable pixels lie strictly inside each frame, and red control pixels sit on the row immediately below a frame, aligned with some interior columns.
+    - Grey borders stay intact; the red controls are outside the enclosed region and indicate which interior columns are frozen.
+
+    Rule:
+    - Detect every grey hollow rectangular frame and read its freeze columns from the red pixels directly below that frame.
+    - Inside the frame, yellow pixels in frozen columns stay at their original cells.
+    - Yellow pixels in all other columns fall straight down within their own columns and stack against the frame's bottom interior edge.
+    - After processing all frames, erase every red control pixel to black; keep the grey borders and other black cells unchanged.
+
+    Key insight:
+    - The crucial clue is cross-region control: red pixels outside a frame determine which yellow columns inside that frame ignore gravity, while the remaining columns still undergo normal vertical stacking.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    out = g.copy()
+    frames = _find_frames(g)
+    assert frames, "expected at least one grey hollow frame"
+
+    for frame in frames:
+        _apply_gravity_to_frame(g, out, frame)
+
+    out[out == RED] = BG
+    return out
+
+
+def _random_composition(total: int, parts: int, rng: np.random.Generator) -> list[int]:
+    if parts == 1:
+        return [total]
+    return list(map(int, rng.multinomial(total, np.full(parts, 1.0 / parts))))
+
+
+def _choose_layout(
+    rng: np.random.Generator,
+    region_sizes: list[tuple[int, int]],
+) -> tuple[int, int, list[tuple[int, int, int, int]]]:
+    count = len(region_sizes)
+    outer_sizes = [(h + 2, w + 2) for h, w in region_sizes]
+
+    if count == 1:
+        outer_h, outer_w = outer_sizes[0]
+        h = max(10, outer_h + 3) + int(rng.integers(0, 3))
+        w = max(10, outer_w + 3) + int(rng.integers(0, 3))
+        r0_low = 1
+        r0_high = h - outer_h - 1
+        c0_low = 1
+        c0_high = w - outer_w - 1
+        r0 = int(rng.integers(r0_low, r0_high + 1))
+        c0 = int(rng.integers(c0_low, c0_high + 1))
+        return h, w, [(r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)]
+
+    (outer_h_a, outer_w_a), (outer_h_b, outer_w_b) = outer_sizes
+    h_min = outer_h_a + outer_h_b + 2
+    w_min = outer_w_a + outer_w_b + 2
+    h = h_min + int(rng.integers(0, 2))
+    w = w_min + int(rng.integers(0, 2))
+
+    extra_h = h - h_min
+    extra_w = w - w_min
+    top_margin, middle_h, bottom_margin = _random_composition(extra_h, 3, rng)
+    left_margin, middle_w, right_margin = _random_composition(extra_w, 3, rng)
+
+    mode = "tl_br" if rng.random() < 0.5 else "tr_bl"
+    if mode == "tl_br":
+        a_r0 = top_margin
+        a_c0 = left_margin
+        b_r0 = a_r0 + outer_h_a + 1 + middle_h
+        b_c0 = a_c0 + outer_w_a + 1 + middle_w
+    else:
+        a_r0 = top_margin
+        a_c0 = w - right_margin - outer_w_a
+        b_r0 = a_r0 + outer_h_a + 1 + middle_h
+        b_c0 = left_margin
+
+    assert b_r0 + outer_h_b < h
+    assert a_r0 + outer_h_a < h
+    assert a_c0 + outer_w_a <= w - 1
+    assert b_c0 + outer_w_b <= w - 1
+    _ = bottom_margin  # kept for symmetry with the sampled layout composition
+
+    return h, w, [
+        (a_r0, a_c0, a_r0 + outer_h_a - 1, a_c0 + outer_w_a - 1),
+        (b_r0, b_c0, b_r0 + outer_h_b - 1, b_c0 + outer_w_b - 1),
+    ]
+
+
+def _sample_region_sizes(rng: np.random.Generator, region_count: int) -> list[tuple[int, int]]:
+    sizes = []
+    for _ in range(region_count):
+        if region_count == 1:
+            inner_h = int(rng.integers(5, 9))
+            inner_w = int(rng.integers(5, 9))
+        else:
+            inner_h = int(rng.integers(5, 7))
+            inner_w = int(rng.integers(5, 7))
+        sizes.append((inner_h, inner_w))
+    return sizes
+
+
+def _choose_column_counts(
+    inner_h: int,
+    inner_w: int,
+    rng: np.random.Generator,
+) -> tuple[list[int], dict[int, int]]:
+    usable_cols = list(range(1, inner_w - 1))
+    max_freeze = min(3, len(usable_cols) - 1)
+    freeze_count = int(rng.integers(1, max_freeze + 1))
+    freeze_cols = sorted(map(int, rng.choice(usable_cols, size=freeze_count, replace=False)))
+    unfrozen_cols = [c for c in usable_cols if c not in freeze_cols]
+
+    counts: dict[int, int] = {}
+    for col in freeze_cols:
+        counts[col] = 1 + int(rng.random() < 0.35)
+
+    stack_col = int(rng.choice(unfrozen_cols))
+    max_stack = 2 if inner_h == 5 else 3
+    counts[stack_col] = int(rng.integers(2, max_stack + 1))
+
+    if len(unfrozen_cols) >= 2 and rng.random() < 0.7:
+        other_choices = [c for c in unfrozen_cols if c != stack_col]
+        other_col = int(rng.choice(other_choices))
+        counts[other_col] = 1 + int(rng.random() < 0.4)
+
+    target_total = int(rng.integers(4, 9))
+    max_per_col = inner_h - 2
+    all_cols = usable_cols[:]
+    while sum(counts.values()) < target_total:
+        candidates = [c for c in all_cols if counts.get(c, 0) < max_per_col]
+        if not candidates:
+            break
+        chosen = int(rng.choice(candidates))
+        counts[chosen] = counts.get(chosen, 0) + 1
+
+    while sum(counts.values()) > 8:
+        shrinkable = [c for c in all_cols if counts.get(c, 0) > (1 if c in freeze_cols else 0)]
+        if not shrinkable:
+            break
+        chosen = int(rng.choice(shrinkable))
+        counts[chosen] -= 1
+        if counts[chosen] == 0:
+            del counts[chosen]
+
+    assert any(col not in freeze_cols and counts[col] >= 2 for col in counts)
+    assert all(counts.get(col, 0) >= 1 for col in freeze_cols)
+    return freeze_cols, counts
+
+
+def _choose_input_rows(
+    inner_h: int,
+    count: int,
+    rng: np.random.Generator,
+) -> list[int]:
+    valid_rows = list(range(1, inner_h - 1))
+    rows = list(map(int, rng.choice(valid_rows, size=count, replace=False)))
+    rows.sort()
+    return rows
+
+
+def _build_region_spec(
+    bbox: tuple[int, int, int, int],
+    inner_h: int,
+    inner_w: int,
+    rng: np.random.Generator,
+) -> dict:
+    r0, c0, r1, c1 = bbox
+    freeze_cols_local, counts = _choose_column_counts(inner_h, inner_w, rng)
+    yellow_positions: list[tuple[int, int]] = []
+
+    for local_c, count in counts.items():
+        rows = _choose_input_rows(inner_h, count, rng)
+        for local_r in rows:
+            yellow_positions.append((r0 + 1 + local_r, c0 + 1 + local_c))
+
+    spec = {
+        "bbox": bbox,
+        "freeze_cols": [c0 + 1 + local_c for local_c in freeze_cols_local],
+        "yellow_positions": sorted(yellow_positions),
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+    }
+    return spec
+
+
+def _render_input(shape: tuple[int, int], specs: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        grid[r0, c0 : c1 + 1] = GREY
+        grid[r1, c0 : c1 + 1] = GREY
+        grid[r0 : r1 + 1, c0] = GREY
+        grid[r0 : r1 + 1, c1] = GREY
+        for col in spec["freeze_cols"]:
+            grid[r1 + 1, col] = RED
+        for r, c in spec["yellow_positions"]:
+            grid[r, c] = YELLOW
+    return grid
+
+
+def _expected_from_specs(inp: np.ndarray, specs: list[dict], *, freeze_all: bool = False) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        inner_r1 = r1 - 1
+        inner_c0 = c0 + 1
+        inner_c1 = c1 - 1
+        freeze_cols = set() if freeze_all else set(spec["freeze_cols"])
+
+        counts: dict[int, int] = {}
+        for r, c in spec["yellow_positions"]:
+            out[r, c] = BG
+            if c in freeze_cols:
+                out[r, c] = YELLOW
+            else:
+                counts[c] = counts.get(c, 0) + 1
+
+        for c, count in counts.items():
+            for r in range(inner_r1 - count + 1, inner_r1 + 1):
+                assert inner_c0 <= c <= inner_c1
+                out[r, c] = YELLOW
+
+    out[out == RED] = BG
+    return out
+
+
+def _check_semantics(inp: np.ndarray, specs: list[dict]) -> bool:
+    try:
+        actual = main(inp)
+    except Exception:
+        return False
+
+    expected = _expected_from_specs(inp, specs)
+    if not np.array_equal(actual, expected):
+        return False
+
+    erase_only = inp.copy()
+    erase_only[erase_only == RED] = BG
+    if np.array_equal(erase_only, expected):
+        return False
+
+    all_drop = _expected_from_specs(inp, specs, freeze_all=True)
+    if np.array_equal(all_drop, expected):
+        return False
+
+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        inner_r1 = r1 - 1
+        freeze_cols = set(spec["freeze_cols"])
+        by_col: dict[int, list[int]] = {}
+        for r, c in spec["yellow_positions"]:
+            by_col.setdefault(c, []).append(r)
+
+        if not freeze_cols or not all(col in by_col for col in freeze_cols):
+            return False
+
+        moved_nonfreeze = False
+        changed_frozen_if_dropped = False
+        for col, rows in by_col.items():
+            rows = sorted(rows)
+            if col in freeze_cols:
+                dropped_rows = list(range(inner_r1 - len(rows) + 1, inner_r1 + 1))
+                if rows != dropped_rows:
+                    changed_frozen_if_dropped = True
+            else:
+                dropped_rows = list(range(inner_r1 - len(rows) + 1, inner_r1 + 1))
+                if rows != dropped_rows:
+                    moved_nonfreeze = True
+
+        if not moved_nonfreeze or not changed_frozen_if_dropped:
+            return False
+
+        controls = {c for c in range(c0 + 1, c1) if int(inp[r1 + 1, c]) == RED}
+        if controls != freeze_cols:
+            return False
+
+    return True
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    region_count = 1 if rng.random() < 0.55 else 2
+    region_sizes = _sample_region_sizes(rng, region_count)
+    h, w, boxes = _choose_layout(rng, region_sizes)
+    specs = [
+        _build_region_spec(box, inner_h, inner_w, rng)
+        for box, (inner_h, inner_w) in zip(boxes, region_sizes)
+    ]
+    inp = _render_input((h, w), specs)
+
+    if not _check_semantics(inp, specs):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid frozen-column gravity input")

diff --git a/key_combo/code/opus/14/048/6.py b/key_combo/code/opus/14/048/6.py
new file mode 100644
index 0000000000000000000000000000000000000000..96360c34ade80d7554057840c919d21b679839cf
--- /dev/null
+++ b/key_combo/code/opus/14/048/6.py
@@ -0,0 +1,409 @@
+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6)
+GREY = 5
+
+GEN_ATTEMPTS = 500
+LAYOUT_ATTEMPTS = 600
+POSITION_ATTEMPTS = 1200
+GAP = 2
+
+LENGTHS = (2, 3, 4, 5, 6)
+ORIENTATIONS = ((1, 1), (1, -1))
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    neighbor_fn = _neighbors4 if connectivity == 4 else _neighbors8
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbor_fn(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _boxes_far_enough(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = GAP) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_gap = max(br0 - ar1 - 1, ar0 - br1 - 1, 0)
+    col_gap = max(bc0 - ac1 - 1, ac0 - bc1 - 1, 0)
+    return row_gap >= gap or col_gap >= gap
+
+
+def _analyze_diagonal(cells: list[tuple[int, int]]) -> tuple[int, tuple[int, int]]:
+    if len(cells) < 2:
+        raise AssertionError("diagonal segment must have length >= 2")
+
+    cell_set = set(cells)
+    if len(_components(_cells_to_mask(cells), connectivity=8)) != 1:
+        raise AssertionError("grey cells must form one 8-connected segment")
+
+    if len({r - c for r, c in cells}) == 1:
+        ordered = sorted(cells)
+        deltas = [(ordered[i + 1][0] - ordered[i][0], ordered[i + 1][1] - ordered[i][1]) for i in range(len(ordered) - 1)]
+        if all(delta == (1, 1) for delta in deltas):
+            return len(cells), (1, 1)
+
+    if len({r + c for r, c in cells}) == 1:
+        ordered = sorted(cells)
+        deltas = [(ordered[i + 1][0] - ordered[i][0], ordered[i + 1][1] - ordered[i][1]) for i in range(len(ordered) - 1)]
+        if all(delta == (1, -1) for delta in deltas):
+            return len(cells), (1, -1)
+
+    raise AssertionError("grey cells must form a contiguous 45-degree diagonal segment")
+
+
+def _cells_to_mask(cells: list[tuple[int, int]]) -> np.ndarray:
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    r0, c0 = min(rs), min(cs)
+    r1, c1 = max(rs), max(cs)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _describe_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    rectangles = []
+    used_grey = set()
+
+    for color in PALETTE:
+        comps = _components(g == color, connectivity=4)
+        for coords in comps:
+            r0, c0, r1, c1 = _bbox(coords)
+            height = r1 - r0 + 1
+            width = c1 - c0 + 1
+            if height < 5 or width < 5:
+                raise AssertionError("every rectangle must be at least 5x5")
+
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            allowed = (sub == color) | (sub == GREY)
+            if not bool(allowed.all()):
+                raise AssertionError("rectangle bbox may only contain its color and the grey segment")
+
+            if not bool((sub[0, :] == color).all() and (sub[-1, :] == color).all() and (sub[:, 0] == color).all() and (sub[:, -1] == color).all()):
+                raise AssertionError("rectangle border must stay solid")
+
+            grey_local = np.argwhere(sub == GREY)
+            if grey_local.size == 0:
+                raise AssertionError("each rectangle needs one grey diagonal segment")
+
+            grey_cells = [(int(r0 + rr), int(c0 + cc)) for rr, cc in grey_local]
+            if any(rr in (r0, r1) or cc in (c0, c1) for rr, cc in grey_cells):
+                raise AssertionError("grey segment must stay strictly inside the rectangle")
+
+            length, orientation = _analyze_diagonal(grey_cells)
+            used_grey.update(grey_cells)
+            rectangles.append(
+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                    "height": height,
+                    "width": width,
+                    "area": height * width,
+                    "grey_cells": grey_cells,
+                    "length": length,
+                    "orientation": orientation,
+                }
+            )
+
+    all_grey = {(int(r), int(c)) for r, c in np.argwhere(g == GREY)}
+    if used_grey != all_grey:
+        raise AssertionError("every grey cell must belong to exactly one rectangle")
+
+    if not 3 <= len(rectangles) <= 5:
+        raise AssertionError("expected 3 to 5 rectangles")
+
+    for i, rect_a in enumerate(rectangles):
+        for rect_b in rectangles[i + 1 :]:
+            if not _boxes_far_enough(rect_a["bbox"], rect_b["bbox"], gap=GAP):
+                raise AssertionError("rectangles must be separated by at least two background cells")
+
+    lengths = [rect["length"] for rect in rectangles]
+    if len(set(lengths)) != len(lengths):
+        raise AssertionError("diagonal lengths must be distinct")
+
+    return rectangles
+
+
+def _apply_winner_transform(grid: np.ndarray, winner: dict) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    r0, c0, r1, c1 = winner["bbox"]
+    color = int(winner["color"])
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if ((r - (r0 + 1)) + (c - (c0 + 1))) % 2 == 0:
+                out[r, c] = BG
+            else:
+                out[r, c] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Replace the interior of the rectangle containing the longest grey diagonal segment with a checkerboard.
+
+    Input structure:
+    - The grid has a black background plus 3-5 separated solid colored rectangles.
+    - Each rectangle uses one color from {blue, red, green, yellow, magenta} and contains
+      exactly one strictly interior grey diagonal segment.
+    - Rectangle borders stay solid, while the grey segment may interrupt only interior cells.
+
+    Rule:
+    - Recover every rectangle and measure the length of its interior grey diagonal segment.
+    - Select the unique rectangle whose grey segment is longest.
+    - Keep that rectangle's 1-cell border unchanged, then checkerboard its strict interior:
+      interior cells at even parity from the interior top-left become black, and odd-parity
+      interior cells become the rectangle's own color. All other rectangles stay unchanged.
+
+    Key insight:
+    - The grey diagonals are only a hidden selection signal: the longest one chooses which
+      rectangle gets transformed, and the winning diagonal itself disappears under the checkerboard.
+    """
+    rectangles = _describe_rectangles(np.asarray(grid, dtype=int))
+    winner = max(rectangles, key=lambda rect: rect["length"])
+    return _apply_winner_transform(grid, winner)
+
+
+def _sample_count(rng: random.Random) -> int:
+    return rng.choice((3, 4, 5))
+
+
+def _sample_canvas(rng: random.Random, count: int) -> tuple[int, int]:
+    if count == 3:
+        return rng.randint(15, 19), rng.randint(15, 19)
+    if count == 4:
+        return rng.randint(17, 22), rng.randint(17, 22)
+    return rng.randint(21, 25), rng.randint(21, 25)
+
+
+def _sample_orientations(rng: random.Random, count: int, winner_idx: int) -> list[tuple[int, int]]:
+    winner_orientation = rng.choice(ORIENTATIONS)
+    orientations = [winner_orientation]
+    orientations.append(winner_orientation)
+    orientations.append((1, -winner_orientation[1]))
+    while len(orientations) < count:
+        orientations.append(rng.choice(ORIENTATIONS))
+    rng.shuffle(orientations)
+    orientations.insert(winner_idx, winner_orientation)
+    return orientations[:count]
+
+
+def _sample_sizes(
+    rng: random.Random,
