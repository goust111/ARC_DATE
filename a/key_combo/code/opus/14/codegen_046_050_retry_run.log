+
+
+def _attempt_generate(rng: random.Random) -> np.ndarray | None:
+    count = _sample_count(rng)
+    lengths = rng.sample(LENGTHS, count)
+    winner_idx = max(range(count), key=lambda idx: lengths[idx])
