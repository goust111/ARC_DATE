+def _diagonal_cells_for_bbox(
+    rng: random.Random,
+    bbox: tuple[int, int, int, int],
+    length: int,
+    orientation: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    assert inner_h >= length and inner_w >= length
