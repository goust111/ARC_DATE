+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+MAGENTA = 6
+TEAL = 8
+PAIR_COLORS = (BLUE, RED, YELLOW, MAGENTA)
+GEN_ATTEMPTS = 400
+
+
+Rect = tuple[int, int, int, int]
+Frame = dict[str, int | Rect]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> Rect:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rect_area(rect: Rect) -> int:
+    r0, c0, r1, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _interval_overlap(a0: int, a1: int, b0: int, b1: int) -> tuple[int, int] | None:
+    lo = max(a0, b0)
+    hi = min(a1, b1)
+    if lo > hi:
+        return None
+    return lo, hi
+
+
+def _find_frames(grid: np.ndarray) -> list[Frame]:
+    g = np.asarray(grid, dtype=int)
