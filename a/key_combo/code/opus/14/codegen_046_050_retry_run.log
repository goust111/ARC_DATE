def _gen_marker_block(side: str) -> np.ndarray:
    block = np.full((3, 3), _GEN_BG, dtype=int)
    for r, c in _GEN_MARKER_COORDS[side]:
        block[r, c] = _GEN_MARKER
    return block


def _gen_cross_block() -> np.ndarray:
    block = np.full((3, 3), _GEN_BG, dtype=int)
    block[1, 1] = _GEN_CENTER
    for (r, c), color in zip(_GEN_ARM_POSITIONS, random.sample(_GEN_ARM_COLORS, 4)):
        block[r, c] = color
    return block


def _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:
    marker = _gen_marker_block(side)
    if side == "left":
        return np.concatenate([marker, cross], axis=1)
    if side == "right":
        return np.concatenate([cross, marker], axis=1)
    if side == "top":
        return np.concatenate([marker, cross], axis=0)
    return np.concatenate([cross, marker], axis=0)


def _gen_input_from_output(side: str, patch: np.ndarray) -> np.ndarray:
    out = patch.copy()
    if side == "left":
        out[:, 3:] = np.rot90(out[:, 3:], 2)
    elif side == "right":
        out[:, :3] = np.rot90(out[:, :3], 2)
    elif side == "top":
        out[3:, :] = np.rot90(out[3:, :], 2)
    else:
        out[:3, :] = np.rot90(out[:3, :], 2)
    return out


def _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:
    h, w = patch.shape
    H, W = canvas.shape
    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
        return False
    for dr, dc in np.argwhere(patch != _GEN_BG):
        r = int(r0 + dr)
        c = int(c0 + dc)
        r1 = max(0, r - padding)
        r2 = min(H, r + padding + 1)
        c1 = max(0, c - padding)
        c2 = min(W, c + padding + 1)
        if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):
            return False
    return True


def _gen_output_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:
    if side == "left":
        return [(r, W - _GEN_HORIZONTAL_SIZE[1]) for r in range(H - _GEN_EDGE_GAP)]
    if side == "right":
        return [(r, 0) for r in range(H - _GEN_EDGE_GAP)]
    if side == "top":
        return [(H - _GEN_VERTICAL_SIZE[0], c) for c in range(W - _GEN_EDGE_GAP)]
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import crop_bbox, find_components, get_bg, paste


def mask_from_coords(coords, shape: tuple[int, int]) -> np.ndarray:
    """Local helper: build a boolean mask from bbox-relative component coordinates."""
    m = np.zeros(shape, dtype=bool)
    H, W = shape
    for r, c in coords:
        rr = int(r)
        cc = int(c)
        assert 0 <= rr < H and 0 <= cc < W
        m[rr, cc] = True
    return m


def canonical_shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:
    """Canonicalize a boolean mask up to rotation and horizontal reflection."""
    canon = np.asarray(mask, dtype=bool)
    best = (canon.tobytes(), tuple(map(int, canon.shape)))
    for _ in range(4):
        canon = np.rot90(canon)
        for v in (canon, np.fliplr(canon)):
            key = (v.tobytes(), tuple(map(int, v.shape)))
            if key < best:
                best = key
    return best

def main(grid: np.ndarray) -> np.ndarray:
    """
    Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.

    Input structure:
    - bg = most common color.
    - Several multicolor connected components (8-connected) scattered across the grid.

    Rule:
    - Compute each object's canonical shape (binary mask, invariant to rotation and flip).
    - Objects whose shape appears in two or more components → translate to TOP edge (row 0).
    - Objects whose shape is unique → translate to BOTTOM edge (row H−h).
    - Horizontal position (left column) is preserved; only vertical translation changes.

    Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (not comps)

    extracted = []
    for comp in comps:
        r0, c0, r1, c1 = map(int, comp["bbox"])
        patch = crop_bbox(g, (r0, c0, r1, c1))

        # Isolate this component exactly (bbox rectangle may include background).
        rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp["coords"]]
        m = mask_from_coords(rel_coords, patch.shape)
        pat = np.full_like(patch, bg)
        pat[m] = patch[m]

        extracted.append(
            {
                "c0": int(c0),
                "pat": pat,
                "shape_key": canonical_shape_key(m),
            }
        )

    freq = Counter(d["shape_key"] for d in extracted)
    out = np.full((H, W), int(bg), dtype=int)

    for d in extracted:
        pat = d["pat"]
        h, w = map(int, pat.shape)
        dest_r0 = 0 if int(freq[d["shape_key"]]) >= 2 else int(H - h)
        dest_c0 = int(d["c0"])
        paste(out, pat, dest_r0, dest_c0, transparent=int(bg))

    return out

