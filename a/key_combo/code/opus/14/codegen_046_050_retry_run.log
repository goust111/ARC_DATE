        assert len(coords) == height * width, "foreground component must fill its bbox"
        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "rectangle bbox must be solid"

        out[r0 + 1 : r1, c0 + 1 : c1] = bg

