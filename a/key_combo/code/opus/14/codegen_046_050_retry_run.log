+    clean_bottom = bottom.copy()
+    clean_top[clean_top == RED] = BLACK
+    clean_bottom[clean_bottom == GREEN] = BLACK
+
+    top_key = _shape_key(clean_top != BLACK)
+    bottom_key = _shape_key(clean_bottom != BLACK)
+    if top_key == bottom_key:
+        return False
