+        cc = c + dc
+        dist = 1
+        while 0 <= rr < h and 0 <= cc < w:
+            if int(grid[rr, cc]) == FRAME:
+                visible.append((dist, name, int(frame_lookup[rr, cc])))
+                break
+            rr += dr
+            cc += dc
+            dist += 1
