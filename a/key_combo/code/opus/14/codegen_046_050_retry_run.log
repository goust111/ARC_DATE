+    depths = [obj["depth"] for obj in objects]
+    if len(set(depths)) < 2:
+        return False
+    same_size_diff_depth = any(
+        a["h"] == b["h"] and a["w"] == b["w"] and a["depth"] != b["depth"]
+        for i, a in enumerate(objects)
+        for b in objects[i + 1 :]
