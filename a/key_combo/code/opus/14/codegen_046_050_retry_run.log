+    half = h // 2
+    top = g[:half, :].copy()
+    bottom = g[half:, :].copy()
+
+    row_gap = int(np.count_nonzero(top == RED))
+    col_gap = int(np.count_nonzero(bottom == GREEN))
+    assert 1 <= row_gap <= 3 and 1 <= col_gap <= 3, "indicator counts must be in 1..3"
