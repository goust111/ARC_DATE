+        for anchor in dests:
+            for rr, cc in _absolute_cells(anchor, list(source["full_offsets"])):
+                if not _in_bounds(expected.shape, rr, cc):
+                    return False
+                if int(expected[rr, cc]) != sprite_color:
+                    return False
+            if int(expected[anchor]) != marker_color:
+                return False
