+from __future__ import annotations
+
+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+FRAME = 1
+CONTROL = 2
+
+DIRS = [
+    ("up", (-1, 0)),
+    ("right", (0, 1)),
+    ("down", (1, 0)),
+    ("left", (0, -1)),
+]
+DIR_INDEX = {name: i for i, (name, _delta) in enumerate(DIRS)}
+
+GRID_SIDE_RANGE = (20, 25)
+FRAME_COUNT_CHOICES = (3, 4)
+FRAME_SIDE_MIN = 4
+WINNER_SIDE_MAX = 16
+OTHER_SIDE_MAX = 10
+FRAME_GAP = 2
+GENERATION_RETRY_LIMIT = 600
+SELECTION_RETRY_LIMIT = 120
+
+_MODE_CYCLE = (
+    {"prefer_tie": "up", "winner_not_largest": True},
+    {"prefer_tie": "right", "winner_not_largest": False},
+    {"prefer_tie": "down", "winner_not_largest": True},
+    {"prefer_tie": None, "winner_not_largest": False},
+)
+_GEN_CALL_COUNT = 0
+_USED_OUTPUT_SHAPES: set[tuple[int, int]] = set()
+
+
+@dataclass(frozen=True)
+class Frame:
+    index: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def height(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def width(self) -> int:
+        return self.c1 - self.c0 + 1
+
+    @property
+    def interior_area(self) -> int:
+        return (self.height - 2) * (self.width - 2)
+
+
+@dataclass(frozen=True)
+class ControlVote:
+    coord: tuple[int, int]
+    target: tuple[int, int]
+    frame_index: int
+    chosen_dir: str
+    min_dist: int
+    tie_dirs: tuple[str, ...]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _frame_from_coords(coords: np.ndarray, index: int) -> Frame | None:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    if len(coords) != 2 * h + 2 * w - 4:
+        return None
+
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(local, expected):
+        return None
+    return Frame(index=index, r0=int(r0), c0=int(c0), r1=int(r1), c1=int(c1))
+
+
+def _extract_frames(grid: np.ndarray) -> tuple[list[Frame], np.ndarray, np.ndarray]:
+    blue = grid == FRAME
+    comps = _components(blue)
+    frames: list[Frame] = []
+    frame_lookup = np.full(grid.shape, -1, dtype=int)
+    bbox_mask = np.zeros(grid.shape, dtype=bool)
+
+    for comp in comps:
+        frame = _frame_from_coords(comp, len(frames))
+        assert frame is not None, "all blue components must be single-pixel rectangular frames"
+        frames.append(frame)
+        frame_lookup[comp[:, 0], comp[:, 1]] = frame.index
+        bbox_mask[frame.r0 : frame.r1 + 1, frame.c0 : frame.c1 + 1] = True
+
+    assert len(frames) >= 3, "expected at least three frames"
+    areas = [frame.interior_area for frame in frames]
+    assert len(set(areas)) == len(areas), "frame interior areas must be unique"
+    return frames, frame_lookup, bbox_mask
+
+
+def _vote_for_position(
+    grid: np.ndarray,
+    frame_lookup: np.ndarray,
+    bbox_mask: np.ndarray,
+    r: int,
+    c: int,
+    *,
+    strict: bool,
+) -> ControlVote | None:
+    if int(grid[r, c]) != BG or bool(bbox_mask[r, c]):
+        return None
+
+    visible: list[tuple[int, str, int]] = []
+    h, w = grid.shape
+    for name, (dr, dc) in DIRS:
+        rr = r + dr
+        cc = c + dc
+        dist = 1
+        while 0 <= rr < h and 0 <= cc < w:
+            if int(grid[rr, cc]) == FRAME:
+                visible.append((dist, name, int(frame_lookup[rr, cc])))
+                break
+            rr += dr
+            cc += dc
+            dist += 1
+
+    if not visible:
+        return None
+
+    min_dist = min(dist for dist, _name, _idx in visible)
+    tie_dirs = tuple(name for name, _delta in DIRS if any(dist == min_dist and d == name for dist, d, _idx in visible))
+    chosen_dir = tie_dirs[0]
+    dr, dc = DIRS[DIR_INDEX[chosen_dir]][1]
+    target = (r + dr, c + dc)
+    if min_dist < 2 or int(grid[target]) != BG:
+        if strict:
+            raise AssertionError("control pixels must extend into a background cell before reaching the frame")
+        return None
+    frame_index = next(idx for dist, name, idx in visible if dist == min_dist and name == chosen_dir)
+    return ControlVote(
+        coord=(r, c),
+        target=target,
+        frame_index=frame_index,
+        chosen_dir=chosen_dir,
+        min_dist=min_dist,
+        tie_dirs=tie_dirs,
+    )
+
+
+def _analyze_grid(grid: np.ndarray) -> tuple[list[Frame], list[ControlVote], Frame]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30
+    assert set(np.unique(g)).issubset({BG, FRAME, CONTROL})
+
+    frames, frame_lookup, bbox_mask = _extract_frames(g)
+    controls: list[ControlVote] = []
+    votes = [0] * len(frames)
+
+    control_coords = np.argwhere(g == CONTROL)
+    assert len(control_coords) > 0, "expected at least one control pixel"
+    for r0, c0 in control_coords:
+        r = int(r0)
+        c = int(c0)
+        assert not bool(bbox_mask[r, c]), "control pixels must be outside all frame bounding boxes"
+        vote = _vote_for_position(g, frame_lookup, bbox_mask, r, c, strict=True)
+        assert vote is not None, "every control must see at least one frame edge"
+        controls.append(vote)
+        votes[vote.frame_index] += 1
+
+    scored = sorted(
+        ((votes[frame.index], frame.interior_area, -frame.index, frame) for frame in frames),
+        reverse=True,
+    )
+    assert scored[0][0] > scored[1][0], "generated inputs must have a unique vote winner"
+    return frames, controls, scored[0][3]
+
+
+def _crop_frame(grid: np.ndarray, frame: Frame) -> np.ndarray:
+    crop = np.array(grid[frame.r0 : frame.r1 + 1, frame.c0 : frame.c1 + 1], dtype=int, copy=True)
+    crop[crop == FRAME] = CONTROL
+    return crop
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Crop the most-voted rectangular frame and recolor its border to the control color.
+
+    Input structure:
+    - The grid uses black background, several blue one-pixel-thick hollow rectangular frames,
+      and red single control pixels outside every frame bbox.
+    - Each control lies on at least one row or column that can see a frame border pixel.
+    - Frames do not overlap, and their enclosed interior areas are pairwise distinct.
+
+    Rule:
+    - For each red control pixel, look up, right, down, and left for the nearest visible blue
+      frame border pixel in each direction.
+    - Choose the shortest such distance, breaking ties by direction priority
+      `up > right > down > left`; the control casts one vote to that frame and conceptually
+      extends one red cell toward it.
+    - Select the frame with the most votes, breaking ties by larger enclosed interior area,
+      crop that frame's bbox, and recolor every blue border pixel in the crop to red.
+
+    Key insight:
+    - The red pixels do not mark the output directly; they induce directional votes whose
+      winner decides which existing frame is cropped, so frame geometry and control placement
+      must be interpreted together.
+    """
+    g = np.asarray(grid, dtype=int)
+    _frames, _controls, winner = _analyze_grid(g)
+    return _crop_frame(g, winner)
+
+
+def _output_shape_pool(h: int, w: int) -> list[tuple[int, int]]:
+    return [
+        (fh, fw)
+        for fh in range(FRAME_SIDE_MIN, min(WINNER_SIDE_MAX, h - 4) + 1)
+        for fw in range(FRAME_SIDE_MIN, min(WINNER_SIDE_MAX, w - 4) + 1)
+    ]
+
+
+def _choose_winner_shape(h: int, w: int) -> tuple[int, int]:
+    choices = [shape for shape in _output_shape_pool(h, w) if shape not in _USED_OUTPUT_SHAPES]
+    if not choices:
+        _USED_OUTPUT_SHAPES.clear()
+        choices = _output_shape_pool(h, w)
+    return random.choice(choices)
+
+
+def _random_bbox(shape: tuple[int, int], height: int, width: int) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0 = random.randint(0, h - height)
+    c0 = random.randint(0, w - width)
+    return (r0, c0, r0 + height - 1, c0 + width - 1)
+
+
+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = FRAME_GAP) -> bool:
+    return not (
+        a[2] + gap < b[0]
+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
+    )
+
+
+def _paint_frame(grid: np.ndarray, box: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
+
+
+def _choose_frame_dims(
+    h: int,
+    w: int,
+    frame_count: int,
+    winner_shape: tuple[int, int],
+    winner_not_largest: bool,
+) -> tuple[list[tuple[int, int]], int] | None:
+    winner_area = (winner_shape[0] - 2) * (winner_shape[1] - 2)
+    used_areas = {winner_area}
+    dims = [winner_shape]
+
+    if winner_not_largest:
+        larger_choices = [
+            (fh, fw)
+            for fh in range(FRAME_SIDE_MIN, min(OTHER_SIDE_MAX, h - 4) + 1)
+            for fw in range(FRAME_SIDE_MIN, min(OTHER_SIDE_MAX, w - 4) + 1)
+            if (fh - 2) * (fw - 2) > winner_area
+        ]
+        if not larger_choices:
+            return None
+        larger_shape = random.choice(larger_choices)
+        dims.append(larger_shape)
+        used_areas.add((larger_shape[0] - 2) * (larger_shape[1] - 2))
+
+    while len(dims) < frame_count:
+        fh = random.randint(FRAME_SIDE_MIN, min(OTHER_SIDE_MAX, h - 4))
+        fw = random.randint(FRAME_SIDE_MIN, min(OTHER_SIDE_MAX, w - 4))
+        area = (fh - 2) * (fw - 2)
+        if area in used_areas:
+            continue
+        dims.append((fh, fw))
+        used_areas.add(area)
+
+    random.shuffle(dims)
+    winner_index = dims.index(winner_shape)
+    return dims, winner_index
+
+
+def _place_frames(shape: tuple[int, int], dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
+    boxes: list[tuple[int, int, int, int]] = []
+    for height, width in sorted(dims, key=lambda x: x[0] * x[1], reverse=True):
+        placed = False
+        for _ in range(120):
+            box = _random_bbox(shape, height, width)
+            if any(_boxes_too_close(box, other) for other in boxes):
+                continue
+            boxes.append(box)
+            placed = True
+            break
+        if not placed:
+            return None
+    return boxes
+
+
+def _build_frame_grid(shape: tuple[int, int], boxes: list[tuple[int, int, int, int]]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for box in boxes:
+        _paint_frame(grid, box)
+    return grid
+
+
+def _candidate_controls(frame_grid: np.ndarray) -> tuple[list[list[ControlVote]], list[ControlVote]]:
+    frames, frame_lookup, bbox_mask = _extract_frames(frame_grid)
+    by_frame: list[list[ControlVote]] = [[] for _ in frames]
+    all_votes: list[ControlVote] = []
+    for r in range(frame_grid.shape[0]):
+        for c in range(frame_grid.shape[1]):
+            vote = _vote_for_position(frame_grid, frame_lookup, bbox_mask, r, c, strict=False)
+            if vote is None:
+                continue
+            by_frame[vote.frame_index].append(vote)
+            all_votes.append(vote)
+    return by_frame, all_votes
+
+
+def _choose_vote_counts(frame_count: int, winner_index: int) -> list[int]:
+    counts = [1] * frame_count
+    counts[winner_index] = random.randint(4, 6)
+    for i in range(frame_count):
+        if i == winner_index:
+            continue
+        counts[i] += random.randint(0, 2)
+    runner = max(counts[i] for i in range(frame_count) if i != winner_index)
+    if counts[winner_index] <= runner:
+        counts[winner_index] = runner + 1
+    return counts
+
+
+def _conflicts(candidate: ControlVote, chosen: list[ControlVote]) -> bool:
+    cr, cc = candidate.coord
+    tr, tc = candidate.target
+    for other in chosen:
+        orr, occ = other.coord
+        otr, otc = other.target
+        if candidate.coord == other.coord or candidate.coord == other.target:
+            return True
+        if candidate.target == other.coord or candidate.target == other.target:
+            return True
+        if max(abs(cr - orr), abs(cc - occ)) <= 1:
+            return True
+        if max(abs(tr - otr), abs(tc - otc)) <= 0:
+            return True
+    return False
+
+
+def _select_controls(
+    by_frame: list[list[ControlVote]],
+    counts: list[int],
+    prefer_tie: str | None,
+) -> list[ControlVote] | None:
+    for _ in range(SELECTION_RETRY_LIMIT):
+        chosen: list[ControlVote] = []
+        remaining = counts[:]
+
+        if prefer_tie is not None:
+            tie_pool = [
+                vote
+                for votes in by_frame
+                for vote in votes
+                if len(vote.tie_dirs) > 1 and vote.chosen_dir == prefer_tie and remaining[vote.frame_index] > 0
+            ]
+            random.shuffle(tie_pool)
+            special = next((vote for vote in tie_pool if not _conflicts(vote, chosen)), None)
+            if special is None:
+                continue
+            chosen.append(special)
+            remaining[special.frame_index] -= 1
+
+        order = sorted(range(len(by_frame)), key=lambda i: (-remaining[i], i))
+        ok = True
+        for frame_index in order:
+            if remaining[frame_index] <= 0:
+                continue
+            pool = by_frame[frame_index][:]
+            random.shuffle(pool)
+            frame_picks = 0
+            for vote in pool:
+                if _conflicts(vote, chosen):
+                    continue
+                chosen.append(vote)
+                frame_picks += 1
+                if frame_picks == remaining[frame_index]:
+                    break
+            if frame_picks != remaining[frame_index]:
+                ok = False
+                break
+
+        if ok:
+            return chosen
+    return None
+
+
+def _grid_from_controls(frame_grid: np.ndarray, controls: list[ControlVote]) -> np.ndarray:
+    grid = np.array(frame_grid, copy=True)
+    for vote in controls:
+        r, c = vote.coord
+        grid[r, c] = CONTROL
+    return grid
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    prefer_tie: str | None,
+    winner_not_largest: bool,
+) -> bool:
+    try:
+        frames, controls, winner = _analyze_grid(grid)
+    except Exception:
+        return False
+
+    if prefer_tie is not None and not any(len(v.tie_dirs) > 1 and v.chosen_dir == prefer_tie for v in controls):
+        return False
+
+    if winner_not_largest and winner.interior_area == max(frame.interior_area for frame in frames):
+        return False
+
+    vote_receivers = {vote.frame_index for vote in controls}
+    if len(vote_receivers) < len(frames):
+        return False
+
+    expected = _crop_frame(grid, winner)
+    return bool(np.array_equal(main(grid), expected))
+
+
+def _attempt_generate(mode: dict[str, object]) -> np.ndarray | None:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
+    winner_shape = _choose_winner_shape(h, w)
+    frame_count = random.choice(FRAME_COUNT_CHOICES)
+
+    dims_info = _choose_frame_dims(
+        h,
+        w,
+        frame_count,
+        winner_shape,
+        bool(mode["winner_not_largest"]),
+    )
+    if dims_info is None:
+        return None
+    dims, winner_index = dims_info
+
+    boxes = _place_frames((h, w), dims)
+    if boxes is None:
+        return None
+
+    frame_grid = _build_frame_grid((h, w), boxes)
+    frames, _frame_lookup, _bbox_mask = _extract_frames(frame_grid)
+    shape_to_index = {(frame.height, frame.width): frame.index for frame in frames}
+    winner_index = shape_to_index[winner_shape]
+
+    by_frame, all_votes = _candidate_controls(frame_grid)
+    if not all(len(votes) >= 2 for votes in by_frame):
+        return None
+
+    if mode["prefer_tie"] is not None:
+        if not any(len(v.tie_dirs) > 1 and v.chosen_dir == mode["prefer_tie"] for v in all_votes):
+            return None
+
+    counts = _choose_vote_counts(len(frames), winner_index)
+    controls = _select_controls(by_frame, counts, mode["prefer_tie"])
+    if controls is None:
+        return None
+
+    grid = _grid_from_controls(frame_grid, controls)
+    if not _validate_generated(grid, mode["prefer_tie"], bool(mode["winner_not_largest"])):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    mode = _MODE_CYCLE[_GEN_CALL_COUNT % len(_MODE_CYCLE)]
+    for _ in range(GENERATION_RETRY_LIMIT):
+        grid = _attempt_generate(mode)
+        if grid is None:
+            continue
+        out_shape = tuple(map(int, main(grid).shape))
+        if out_shape in _USED_OUTPUT_SHAPES:
+            continue
+        _USED_OUTPUT_SHAPES.add(out_shape)
+        _GEN_CALL_COUNT += 1
+        return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

diff --git a/key_combo/code/opus/14/049/4.py b/key_combo/code/opus/14/049/4.py
new file mode 100644
index 0000000000000000000000000000000000000000..973f1e451eaf2c622c5cc4595b80362e81c61c66
--- /dev/null
+++ b/key_combo/code/opus/14/049/4.py
@@ -0,0 +1,522 @@
+from __future__ import annotations
+
+import random
+from collections import deque
+from itertools import permutations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+RANK_TO_DIR = {
+    1: (0, 1),
+    2: (1, 0),
+    3: (1, 1),
+}
+SIDES = ("top", "bottom", "left", "right")
+MAX_GENERATION_ATTEMPTS = 400
+MAX_LAYOUT_TRIES = 220
+
+
+def _neighbors4(cell: tuple[int, int]) -> tuple[tuple[int, int], ...]:
+    r, c = cell
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4((cr, cc)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _analyze_bar(coords: list[tuple[int, int]]) -> dict:
+    rows = sorted({r for r, _ in coords})
+    cols = sorted({c for _, c in coords})
+    area = len(coords)
+
+    if len(rows) == 1:
+        ordered_cols = sorted(c for _, c in coords)
+        assert ordered_cols == list(range(ordered_cols[0], ordered_cols[0] + area)), "horizontal bar must be gapless"
+        return {
+            "orientation": "H",
+            "length": area,
+            "start": (rows[0], ordered_cols[0]),
+            "cells": tuple(sorted(coords)),
+        }
+
+    if len(cols) == 1:
+        ordered_rows = sorted(r for r, _ in coords)
+        assert ordered_rows == list(range(ordered_rows[0], ordered_rows[0] + area)), "vertical bar must be gapless"
+        return {
+            "orientation": "V",
+            "length": area,
+            "start": (ordered_rows[0], cols[0]),
+            "cells": tuple(sorted(coords)),
+        }
+
+    raise AssertionError("each gray component must be a straight one-cell-thick bar")
+
+
+def _bar_cells(start_r: int, start_c: int, length: int, orientation: str) -> tuple[tuple[int, int], ...]:
+    if orientation == "H":
+        return tuple((start_r, start_c + dc) for dc in range(length))
+    return tuple((start_r + dr, start_c) for dr in range(length))
+
+
+def _indicator_from_bar(
+    start_r: int,
+    start_c: int,
+    length: int,
+    orientation: str,
+    side: str,
+    attach: int,
+) -> tuple[int, int]:
+    if orientation == "H":
+        if side == "top":
+            return start_r - 1, start_c + attach
+        if side == "bottom":
+            return start_r + 1, start_c + attach
+        if side == "left":
+            return start_r, start_c - 1
+        if side == "right":
+            return start_r, start_c + length
+    else:
+        if side == "left":
+            return start_r + attach, start_c - 1
+        if side == "right":
+            return start_r + attach, start_c + 1
+        if side == "top":
+            return start_r - 1, start_c
+        if side == "bottom":
+            return start_r + length, start_c
+    raise AssertionError("invalid side/orientation combination")
+
+
+def _point_reflect(center: tuple[int, int], cell: tuple[int, int]) -> tuple[int, int]:
+    cr, cc = center
+    r, c = cell
+    return 2 * cr - r, 2 * cc - c
+
+
+def _all_adjacent_indicators(cells: tuple[tuple[int, int], ...], orientation: str) -> list[tuple[int, int]]:
+    ordered = sorted(cells)
+    if orientation == "H":
+        row = ordered[0][0]
+        cols = [c for _, c in ordered]
+        out = [(row - 1, c) for c in cols] + [(row + 1, c) for c in cols]
+        out.extend([(row, cols[0] - 1), (row, cols[-1] + 1)])
+    else:
+        col = ordered[0][1]
+        rows = [r for r, _ in ordered]
+        out = [(r, col - 1) for r in rows] + [(r, col + 1) for r in rows]
+        out.extend([(rows[0] - 1, col), (rows[-1] + 1, col)])
+    dedup: list[tuple[int, int]] = []
+    seen = set()
+    for cell in out:
+        if cell not in seen:
+            seen.add(cell)
+            dedup.append(cell)
+    return dedup
+
+
+def _object_from_bar_and_indicator(
+    grid_shape: tuple[int, int],
+    bar_cells: tuple[tuple[int, int], ...],
+    orientation: str,
+    length: int,
+    rank: int,
+    indicator: tuple[int, int],
+    side: str | None = None,
+    start: tuple[int, int] | None = None,
+    attach: int | None = None,
+) -> dict | None:
+    h, w = grid_shape
+    shadow_dir = RANK_TO_DIR[rank]
+    shadow_cells = tuple((r + shadow_dir[0], c + shadow_dir[1]) for r, c in bar_cells)
+    mirror_bar = tuple(_point_reflect(indicator, cell) for cell in bar_cells)
+    mirror_shadow = tuple(_point_reflect(indicator, cell) for cell in shadow_cells)
+    all_cells = list(bar_cells) + [indicator] + list(shadow_cells) + list(mirror_bar) + list(mirror_shadow)
+    if not all(0 <= r < h and 0 <= c < w for r, c in all_cells):
+        return None
+    return {
+        "cells": frozenset(bar_cells),
+        "orientation": orientation,
+        "length": length,
+        "rank": rank,
+        "indicator": indicator,
+        "shadow_dir": shadow_dir,
+        "shadow_cells": frozenset(shadow_cells),
+        "mirror_bar": frozenset(mirror_bar),
+        "mirror_shadow": frozenset(mirror_shadow),
+        "input_cells": frozenset(set(bar_cells) | {indicator}),
+        "side": side,
+        "start": start,
+        "attach": attach,
+    }
+
+
+def _render_input(grid_shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    out = np.zeros(grid_shape, dtype=int)
+    for obj in objects:
+        for r, c in obj["cells"]:
+            out[r, c] = GREY
+        ir, ic = obj["indicator"]
+        out[ir, ic] = RED
+    return out
+
+
+def _render_output(grid_shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    out = _render_input(grid_shape, objects)
+    indicators = {obj["indicator"] for obj in objects}
+
+    for obj in objects:
+        for r, c in obj["shadow_cells"]:
+            if (r, c) in indicators or out[r, c] == GREY:
+                continue
+            out[r, c] = BLUE
+
+    for obj in sorted(objects, key=lambda item: item["rank"]):
+        for r, c in obj["mirror_shadow"]:
+            if (r, c) in indicators:
+                continue
+            out[r, c] = YELLOW
+        for r, c in obj["mirror_bar"]:
+            if (r, c) in indicators:
+                continue
+            out[r, c] = GREEN
+
+    for ir, ic in indicators:
+        out[ir, ic] = RED
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Rank the three gray bars by length, add rank-directed blue shadows, then point-mirror each bar-shadow pair across its red indicator.
+
+    Input structure:
+    - A black background contains exactly three gray one-cell-thick straight bars and exactly three red indicator pixels.
+    - Each gray object is a single horizontal or vertical 4-connected bar, and the three bar lengths are all different.
+    - Each red pixel is 4-neighbor-adjacent to exactly one gray bar and serves as that bar's mirror center.
+
+    Rule:
+    - Sort the three gray bars by length from longest to shortest.
+    - Give rank 1 a blue shadow shifted one cell right, rank 2 a blue shadow shifted one cell down, and rank 3 a blue shadow shifted one cell down-right; gray bar pixels stay gray when a shadow overlaps them.
+    - Point-reflect each bar together with its shadow through its attached red indicator pixel; recolor mirrored bar pixels green and mirrored shadow pixels yellow.
+    - Mirrored pixels overwrite earlier gray/blue pixels, but the red indicator pixels remain red.
+
+    Key insight:
+    - Length ranking does not choose colors directly; it chooses the shadow direction, while the red indicator independently fixes the 180-degree mirror center that relocates the whole annotated bar.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    colors = set(int(v) for v in np.unique(g))
+    assert colors <= {BLACK, RED, GREY}, "input should only contain black, red, and gray"
+
+    bar_components = _components_of_color(g, GREY)
+    indicator_components = _components_of_color(g, RED)
+    assert len(bar_components) == 3, "expected exactly three gray bars"
+    assert len(indicator_components) == 3, "expected exactly three red indicators"
+    assert all(len(comp) == 1 for comp in indicator_components), "each indicator must be a singleton"
+
+    analyzed = []
+    indicator_to_bar: dict[tuple[int, int], int] = {}
+    for idx, comp in enumerate(bar_components):
+        info = _analyze_bar(comp)
+        analyzed.append(info)
+        bar_cells = set(info["cells"])
+        for red_comp in indicator_components:
+            indicator = red_comp[0]
+            if any(nbr in bar_cells for nbr in _neighbors4(indicator)):
+                assert indicator not in indicator_to_bar, "indicator touches multiple bars"
+                indicator_to_bar[indicator] = idx
+
+    assert len(indicator_to_bar) == 3, "each indicator must touch exactly one bar"
+    bar_to_indicator: dict[int, tuple[int, int]] = {}
+    for indicator, idx in indicator_to_bar.items():
+        assert idx not in bar_to_indicator, "bar must have exactly one indicator"
+        bar_to_indicator[idx] = indicator
+    assert len(bar_to_indicator) == 3, "each bar must have exactly one indicator"
+
+    lengths = [info["length"] for info in analyzed]
+    assert len(set(lengths)) == 3, "bar lengths must be distinct"
+
+    objects = []
+    sorted_indices = sorted(range(3), key=lambda i: analyzed[i]["length"], reverse=True)
+    rank_by_index = {idx: rank for rank, idx in enumerate(sorted_indices, start=1)}
+    for idx, info in enumerate(analyzed):
+        obj = _object_from_bar_and_indicator(
+            g.shape,
+            info["cells"],
+            info["orientation"],
+            info["length"],
+            rank_by_index[idx],
+            bar_to_indicator[idx],
+        )
+        assert obj is not None, "all transformed pixels must stay in bounds"
+        objects.append(obj)
+
+    return _render_output(g.shape, objects)
+
+
+def _enumerate_candidates(
+    grid_shape: tuple[int, int],
+    length: int,
+    orientation: str,
+    side: str,
+    rank: int,
+) -> list[dict]:
+    h, w = grid_shape
+    candidates: list[dict] = []
+
+    if orientation == "H":
+        row_range = range(2, h - 2)
+        col_range = range(2, w - length - 1)
+        attach_range = range(length) if side in ("top", "bottom") else range(1)
+    else:
+        row_range = range(2, h - length - 1)
+        col_range = range(2, w - 2)
+        attach_range = range(length) if side in ("left", "right") else range(1)
+
+    for r in row_range:
+        for c in col_range:
+            bar_cells = _bar_cells(r, c, length, orientation)
+            for attach in attach_range:
+                indicator = _indicator_from_bar(r, c, length, orientation, side, attach)
+                obj = _object_from_bar_and_indicator(
+                    grid_shape,
+                    bar_cells,
+                    orientation,
+                    length,
+                    rank,
+                    indicator,
+                    side=side,
+                    start=(r, c),
+                    attach=attach,
+                )
+                if obj is not None:
+                    candidates.append(obj)
+    random.shuffle(candidates)
+    return candidates
+
+
+def _touches4(set_a: frozenset[tuple[int, int]], set_b: frozenset[tuple[int, int]]) -> bool:
+    if len(set_a) > len(set_b):
+        set_a, set_b = set_b, set_a
+    for cell in set_a:
+        if any(nbr in set_b for nbr in _neighbors4(cell)):
+            return True
+    return False
+
+
+def _input_compatible(candidate: dict, chosen: list[dict]) -> bool:
+    for other in chosen:
+        if candidate["input_cells"] & other["input_cells"]:
+            return False
+        if _touches4(candidate["input_cells"], other["input_cells"]):
+            return False
+    return True
+
+
+def _cross_overlap_cells(objects: list[dict]) -> set[tuple[int, int]]:
+    base_union = set()
+    for obj in objects:
+        base_union |= set(obj["cells"])
+        base_union |= set(obj["shadow_cells"])
+    overlap = set()
+    for obj in objects:
+        overlap |= (set(obj["mirror_bar"]) | set(obj["mirror_shadow"])) & base_union
+    return overlap
+
+
+def _mirror_pairwise_clean(objects: list[dict]) -> bool:
+    mirror_sets = [set(obj["mirror_bar"]) | set(obj["mirror_shadow"]) for obj in objects]
+    for i in range(len(mirror_sets)):
+        for j in range(i + 1, len(mirror_sets)):
+            if mirror_sets[i] & mirror_sets[j]:
+                return False
+    return True
+
+
+def _indicators_clear(objects: list[dict]) -> bool:
+    indicators = {obj["indicator"] for obj in objects}
+    for obj in objects:
+        if indicators & set(obj["shadow_cells"]):
+            return False
+        if indicators & set(obj["mirror_bar"]):
+            return False
+        if indicators & set(obj["mirror_shadow"]):
+            return False
+    return True
+
+
+def _direction_uniqueness(grid_shape: tuple[int, int], objects: list[dict], expected: np.ndarray) -> bool:
+    h, w = grid_shape
+    ordered = sorted(objects, key=lambda item: item["rank"])
+    true_dirs = tuple(obj["shadow_dir"] for obj in ordered)
+    for perm in permutations((RANK_TO_DIR[1], RANK_TO_DIR[2], RANK_TO_DIR[3])):
+        if perm == true_dirs:
+            continue
+        alt_objects = []
+        for obj, alt_dir in zip(ordered, perm):
+            alt = dict(obj)
+            alt["shadow_dir"] = alt_dir
+            alt["shadow_cells"] = frozenset((r + alt_dir[0], c + alt_dir[1]) for r, c in obj["cells"])
+            alt["mirror_shadow"] = frozenset(_point_reflect(obj["indicator"], cell) for cell in alt["shadow_cells"])
+            all_cells = set(alt["cells"]) | set(alt["shadow_cells"]) | set(alt["mirror_bar"]) | set(alt["mirror_shadow"]) | {alt["indicator"]}
+            if not all(0 <= r < h and 0 <= c < w for r, c in all_cells):
+                alt_objects = []
+                break
+            alt_objects.append(alt)
+        if not alt_objects:
+            continue
+        if np.array_equal(_render_output(grid_shape, alt_objects), expected):
+            return False
+    return True
+
+
+def _indicator_uniqueness(grid_shape: tuple[int, int], objects: list[dict], expected: np.ndarray) -> bool:
+    for idx, obj in enumerate(objects):
+        candidates = _all_adjacent_indicators(tuple(sorted(obj["cells"])), obj["orientation"])
+        for alt_indicator in candidates:
+            if alt_indicator == obj["indicator"]:
+                continue
+            alt_obj = _object_from_bar_and_indicator(
+                grid_shape,
+                tuple(sorted(obj["cells"])),
+                obj["orientation"],
+                obj["length"],
+                obj["rank"],
+                alt_indicator,
+                side=obj["side"],
+                start=obj["start"],
+                attach=obj["attach"],
+            )
+            if alt_obj is None:
+                continue
+            alt_objects = list(objects)
+            alt_objects[idx] = alt_obj
+            if np.array_equal(_render_output(grid_shape, alt_objects), expected):
+                return False
+    return True
+
+
+def _semantic_checks(grid_shape: tuple[int, int], objects: list[dict], want_overlap: bool) -> bool:
+    if not _mirror_pairwise_clean(objects):
+        return False
+    if not _indicators_clear(objects):
+        return False
+
+    overlap_cells = _cross_overlap_cells(objects)
+    if want_overlap:
+        if not (1 <= len(overlap_cells) <= 3):
+            return False
+    elif overlap_cells:
+        return False
+
+    expected = _render_output(grid_shape, objects)
+    if np.count_nonzero(expected == BLUE) < 3 or np.count_nonzero(expected == YELLOW) < 3:
+        return False
+    colors = set(int(v) for v in np.unique(expected))
+    if not {RED, GREY, BLUE, GREEN, YELLOW} <= colors:
+        return False
+    if not _direction_uniqueness(grid_shape, objects, expected):
+        return False
+    if not _indicator_uniqueness(grid_shape, objects, expected):
+        return False
+
+    inp = _render_input(grid_shape, objects)
+    try:
+        solved = main(inp)
+    except AssertionError:
+        return False
+    return np.array_equal(solved, expected)
+
+
+def _sample_specs() -> tuple[bool, tuple[int, int], list[tuple[int, int, str, str]]]:
+    want_overlap = random.random() < 0.35
+    if want_overlap:
+        h = random.randint(13, 16)
+        w = random.randint(15, 18)
+    else:
+        h = random.randint(14, 18)
+        w = random.randint(16, 20)
+
+    lengths = random.sample(range(3, 8), 3)
+    count_h = random.choice((1, 2))
+    orientations = ["H"] * count_h + ["V"] * (3 - count_h)
+    random.shuffle(orientations)
+    sides = random.sample(SIDES, 3)
+
+    sorted_indices = sorted(range(3), key=lambda i: lengths[i], reverse=True)
+    ranks = [0, 0, 0]
+    for rank, idx in enumerate(sorted_indices, start=1):
+        ranks[idx] = rank
+
+    specs = [(lengths[i], ranks[i], orientations[i], sides[i]) for i in range(3)]
+    return want_overlap, (h, w), specs
+
+
+def _try_layout(grid_shape: tuple[int, int], specs: list[tuple[int, int, str, str]], want_overlap: bool) -> list[dict] | None:
+    candidate_lists = [
+        _enumerate_candidates(grid_shape, length, orientation, side, rank)
+        for length, rank, orientation, side in specs
+    ]
+    if any(not candidates for candidates in candidate_lists):
+        return None
+
+    order = sorted(range(3), key=lambda idx: len(candidate_lists[idx]))
+    for _ in range(MAX_LAYOUT_TRIES):
+        chosen_by_index: dict[int, dict] = {}
+        chosen_list: list[dict] = []
+        failed = False
+        for idx in order:
+            valid = [cand for cand in candidate_lists[idx] if _input_compatible(cand, chosen_list)]
+            if not valid:
+                failed = True
+                break
+            pick = random.choice(valid)
+            chosen_by_index[idx] = pick
+            chosen_list.append(pick)
+        if failed:
+            continue
+        objects = [chosen_by_index[i] for i in range(3)]
+        if _semantic_checks(grid_shape, objects, want_overlap):
+            return objects
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        want_overlap, grid_shape, specs = _sample_specs()
+        objects = _try_layout(grid_shape, specs, want_overlap)
+        if objects is not None:
+            return _render_input(grid_shape, objects)
+        if want_overlap:
+            objects = _try_layout(grid_shape, specs, False)
+            if objects is not None:
+                return _render_input(grid_shape, objects)
+    raise RuntimeError("failed to generate a valid input")

