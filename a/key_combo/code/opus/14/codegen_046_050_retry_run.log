+    min_dist: int
+    tie_dirs: tuple[str, ...]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _frame_from_coords(coords: np.ndarray, index: int) -> Frame | None:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    if len(coords) != 2 * h + 2 * w - 4:
+        return None
+
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    if not np.array_equal(local, expected):
+        return None
+    return Frame(index=index, r0=int(r0), c0=int(c0), r1=int(r1), c1=int(c1))
+
+
+def _extract_frames(grid: np.ndarray) -> tuple[list[Frame], np.ndarray, np.ndarray]:
+    blue = grid == FRAME
+    comps = _components(blue)
