+            if need_h > 20 or need_w > 20:
+                continue
+            h = rng.randint(max(16, need_h), 20)
+            w = rng.randint(max(16, need_w), 20)
+            left_w = rng.randint(wp, w - 1 - max(wa, wb))
+            top_h = rng.randint(ha, h - 1 - hb)
+            regs = [None, None, None]
