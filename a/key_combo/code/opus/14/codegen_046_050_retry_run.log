+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6)
+GREY = 5
+
+GEN_ATTEMPTS = 500
+GAP = 2
+
+LENGTHS = (2, 3, 4, 5, 6)
+ORIENTATIONS = ((1, 1), (1, -1))
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    neighbor_fn = _neighbors4 if connectivity == 4 else _neighbors8
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbor_fn(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _boxes_far_enough(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = GAP) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_gap = max(br0 - ar1 - 1, ar0 - br1 - 1, 0)
+    col_gap = max(bc0 - ac1 - 1, ac0 - bc1 - 1, 0)
+    return row_gap >= gap or col_gap >= gap
+
+
+def _analyze_diagonal(cells: list[tuple[int, int]]) -> tuple[int, tuple[int, int]]:
