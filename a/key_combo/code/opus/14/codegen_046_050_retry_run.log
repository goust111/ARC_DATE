  63:     Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.
  64: 
  65:     Input structure
  66:     The grid is partitioned by black separator rows and columns into equal-size
  67:     square blocks. Each block is either a copy of one two-color sprite or a
  68:     uniform blank block of the sprite's minority color; grey pixels are erased
  69:     cells that act as wildcards.
  70: 
  71:     Rule
  72:     Infer the repeated sprite from fully visible mixed-color blocks. Replace a
  73:     block matching that sprite, ignoring grey erasures, with a solid block of
  74:     the sprite's majority color. Replace a uniform blank block with the sprite.
  75:     Separator rows and columns, including grey erasures on them, become black.
  76: 
  77:     Key insight
  78:     The small sprite is a block-level code for one macro-cell state, and the
  79:     uniform minority-color block is the other state; the output renders the
  80:     opposite code in each macro-cell while cleaning erased pixels.
  81:     """
  82:     g = np.asarray(grid, dtype=int)
  83:     H, W = g.shape
  84: 
  85:     row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]
  86:     col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]
  87:     row_intervals = _regular_intervals(row_separators, H)
  88:     col_intervals = _regular_intervals(col_separators, W)
  89:     block_heights = {r1 - r0 for r0, r1 in row_intervals}
  90:     block_widths = {c1 - c0 for c0, c1 in col_intervals}
  91:     assert block_heights == block_widths, "encoded blocks must be square"
  92: 
  93:     payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})
  94:     assert len(payload_colors) == 2, "expected exactly two non-separator payload colors"
  95:     sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)
  96:     foreground, blank = _foreground_and_blank(sprite, payload_colors)
  97: 
  98:     out = np.zeros_like(g)
  99:     for r0, r1 in row_intervals:
 100:         for c0, c1 in col_intervals:
 101:             block = g[r0:r1, c0:c1]
 102:             known = block != ERASED
 103:             assert known.any(), "each block must expose at least one non-grey cell"
 104:             matches_sprite = bool(np.all(block[known] == sprite[known]))
 105:             matches_blank = bool(np.all(block[known] == blank))
 106:             assert matches_sprite != matches_blank, "each block must unambiguously match the sprite or blank state"
 107:             out[r0:r1, c0:c1] = foreground if matches_sprite else sprite
 108: 
 109:     return out
 110: 
 111: # --------------- generator (att2) ---------------
 112: 
 113: # Canvas and palette bounds.
 114: GRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)
 115: PAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
 116: PAYLOAD_COLOR_COUNT = 2
 117: GEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)
 118: 
 119: # Sprite composition constraints.
 120: SPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)
 121: SPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2
 122: 
 123: # Macro-cell state constraints.
 124: MIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2
 125: 
 126: # Grey overlay constraints.
 127: GREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25
 128: GREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30
 129: GREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300
 130: 
 131: NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
 132: 
 133: 
 134: def _separator_indices(n: int, block_size: int) -> set[int]:
 135:     return {(i + 1) * block_size + i for i in range(n - 1)}
 136: 
 137: 
 138: def _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:
 139:     return br * (block_size + 1), bc * (block_size + 1)
 140: 
 141: 
 142: def _has_symmetry(mask: np.ndarray) -> bool:
 143:     return (
 144:         np.array_equal(mask, np.fliplr(mask))
 145:         or np.array_equal(mask, np.flipud(mask))
 146:         or np.array_equal(mask, np.rot90(mask, 2))
 147:     )
 148: 
 149: 
 150: def _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:
 151:     area = block_size * block_size
 152:     min_num, min_den = SPRITE_FG_MIN_RATIO
 153:     max_num, max_den = SPRITE_FG_MAX_RATIO
 154:     fg_min = math.ceil(area * min_num / min_den)
 155:     fg_max = math.floor(area * max_num / max_den)
 156:     if fg_min > fg_max:
 157:         fg_min = fg_max = round(area * min_num / min_den)
 158:     fg_count = random.randint(fg_min, fg_max)
 159:     blank_count = area - fg_count
 160: 
 161:     for _ in range(SPRITE_ATTEMPTS):
 162:         mask = np.ones((block_size, block_size), dtype=bool)
 163:         if block_size == TINY_BLOCK_SIZE:
 164:             blanks = [random.randrange(area)]
 165:         else:
 166:             cols = list(range(block_size))
 167:             random.shuffle(cols)
 168:             blanks = [r * block_size + cols[r] for r in range(block_size)]
 169:             extra = blank_count - block_size
 170:             if extra > 0:
 171:                 pool = [i for i in range(area) if i not in blanks]
 172:                 blanks.extend(random.sample(pool, extra))
 173: 
 174:         for idx in blanks:
 175:             mask[idx // block_size, idx % block_size] = False
 176: 
 177:         if block_size > TINY_BLOCK_SIZE:
 178:             row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))
 179:             col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))
 180:             if not row_mixed or not col_mixed:
 181:                 continue

 357:     return inp
 358: 
 359: 
 360: def generate_input() -> np.ndarray:
 361:     for _ in range(GENERATION_ATTEMPTS):
 362:         grid = _gen_attempt()
 363:         if grid is not None:
 364:             return grid
 365:     raise RuntimeError("failed to generate valid input")


