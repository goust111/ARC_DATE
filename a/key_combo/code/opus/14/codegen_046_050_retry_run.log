+def _render_bars(grid: np.ndarray, analysis: dict, *, selected_paths: set[int] | None = None, endpoint_only: bool = False) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    sep = int(analysis["separator"])
+    t = int(analysis["t"])
