+def _ray_distance_to_exit(current: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> int:
+    r, c = current
+    dr, dc = direction
+    dist = 0
+    while _in_bounds(shape, r + dr, c + dc):
