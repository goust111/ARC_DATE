+                return None
+            current = (current[0] + direction[0], current[1] + direction[1])
+            planned.append(("T", None))
+        else:
+            axes = ["H", "V"]
+            random.shuffle(axes)
+            cells = None
+            chosen_axis = None
+            for axis in axes:
+                trial = _choose_shape_for_event((h, w), current, direction, "R", axis, occupied, forbidden)
+                if trial is not None:
