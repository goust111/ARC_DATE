+        pr, pc = triple["pivot"]
+        sr, sc = triple["source"]
+        grid[pr, pc] = GREEN
+        grid[sr, sc] = PINK
+    return grid
+
+
+def _expected_output(shape: tuple[int, int], divider_c: int, triples: list[Triple]) -> np.ndarray:
