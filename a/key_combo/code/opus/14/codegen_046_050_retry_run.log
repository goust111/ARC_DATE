+
+def _dir_transforms() -> list:
+    return [
+        lambda dr, dc: (dr, dc),
+        lambda dr, dc: (dr, -dc),
+        lambda dr, dc: (-dr, dc),
+        lambda dr, dc: (-dr, -dc),
+        lambda dr, dc: (dc, dr),
+        lambda dr, dc: (dc, -dr),
+        lambda dr, dc: (-dc, dr),
+        lambda dr, dc: (-dc, -dr),
+    ]
+
+
+def _is_asymmetric(dirs: Iterable[tuple[int, int]]) -> bool:
+    base = frozenset(tuple(map(int, d)) for d in dirs)
+    transforms = _dir_transforms()[1:]
+    return all(frozenset(transform(dr, dc) for dr, dc in base) != base for transform in transforms)
+
+
+def _safe_cells(n: int, dirs: tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
+    safe: set[tuple[int, int]] = set()
+    for r in range(n):
+        for c in range(n):
+            if all(0 <= r + dr < n and 0 <= c + dc < n for dr, dc in dirs):
