+    row_sizes = {r1 - r0 for r0, r1 in row_spans}
+    col_sizes = {c1 - c0 for c0, c1 in col_spans}
+    assert len(row_sizes) == 1 and len(col_sizes) == 1 and row_sizes == col_sizes
