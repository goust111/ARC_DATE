+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                    "height": height,
+                    "width": width,
+                    "area": height * width,
+                    "grey_cells": grey_cells,
+                    "length": length,
+                    "orientation": orientation,
+                }
