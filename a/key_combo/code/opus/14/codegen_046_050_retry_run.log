+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+SEP = 5
+ORANGE = 7
+BASE_COLORS = (BLUE, RED, GREEN, YELLOW)
+PANEL_ORDER = ("tl", "tr", "bl", "br")
+PANEL_TO_RC = {"tl": (0, 0), "tr": (0, 1), "bl": (1, 0), "br": (1, 1)}
+CORNER_COORDS = {
+    "tl": (0, 0),
+    "tr": (0, -1),
+    "bl": (-1, 0),
+    "br": (-1, -1),
+}
+DIAGONALS = (("tl", "br"), ("tr", "bl"))
+GEN_ATTEMPTS = 400
