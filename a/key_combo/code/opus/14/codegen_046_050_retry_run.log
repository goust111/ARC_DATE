+    patch = np.zeros((outer_h, outer_w), dtype=int)
+    inner = np.full((outer_h - 2, outer_w - 2), GREY, dtype=int)
+    order = _interior_order(outer_h - 2, outer_w - 2, direction)
+    for rr, cc in order[:orange_count]:
