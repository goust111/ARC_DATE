    min_cells, max_cells = _GEN_COVERAGE_CELLS
    choices = [
        combo
        for combo in _gen_itertools.combinations(_GEN_DIMS, int(panel_count))
        if min_cells <= sum(h * w for h, w in combo) <= max_cells
