+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+PANEL_COLORS = (BLUE, GREEN)
+
+_MAX_GEN_ATTEMPTS = 400
