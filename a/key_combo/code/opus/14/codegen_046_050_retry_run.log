+
+def _attempt_generate() -> np.ndarray | None:
+    side_h = random.randrange(*GRID_SIDE_RANGE)
+    side_w = random.randrange(*GRID_SIDE_RANGE)
+    shape = (int(side_h), int(side_w))
+
