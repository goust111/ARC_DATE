+        ordered = sorted(cells)
+        deltas = [(ordered[i + 1][0] - ordered[i][0], ordered[i + 1][1] - ordered[i][1]) for i in range(len(ordered) - 1)]
+        if all(delta == (1, 1) for delta in deltas):
+            return len(cells), (1, 1)
+
+    if len({r + c for r, c in cells}) == 1:
+        ordered = sorted(cells)
+        deltas = [(ordered[i + 1][0] - ordered[i][0], ordered[i + 1][1] - ordered[i][1]) for i in range(len(ordered) - 1)]
+        if all(delta == (1, -1) for delta in deltas):
+            return len(cells), (1, -1)
