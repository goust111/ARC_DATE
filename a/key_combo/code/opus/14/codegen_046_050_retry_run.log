+    try:
+        top, top_mask = _make_half(
+            rng,
+            half_h=half_h,
+            width=width,
+            main_color=BLUE,
+            accent_colors=_TOP_ACCENTS,
+            indicator_color=RED,
+            indicator_count=row_gap,
+            top_half=True,
