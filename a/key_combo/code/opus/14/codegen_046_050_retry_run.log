+
+
+def _mark_blocked(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in coords:
+        for dr, dc in DIRS8 + ((0, 0),):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                blocked[nr, nc] = True
+
+
+def _place_shape(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    shape: list[tuple[int, int]],
+    color: int,
+    legend_bottom: int,
+    legend_right: int,
