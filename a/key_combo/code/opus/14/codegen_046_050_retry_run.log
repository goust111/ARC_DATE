+        points.add((h - 1, random.choice(bottom_cols)))
+    if corner not in ("tl", "bl"):
+        points.add((random.choice(late_rows), 0))
+    if corner not in ("tr", "br"):
+        points.add((random.choice(late_rows), w - 1))
