+        return None
+    base_patch = _make_base_patch(side, palette, signature)
+
+    copy_count = random.randint(3, 5)
+    chosen = _choose_orientations(base_patch, copy_count)
+    if chosen is None:
+        return None
+    orientations, complete_index = chosen
