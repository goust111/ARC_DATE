+    n = int(g.shape[0])
+    bg_colors = set(_top_two_colors(g))
+    assert bg_colors == set(CHECKER_COLORS), "background must be the black/grey checkerboard"
+    top_left = int(g[0, 0])
+    assert top_left in bg_colors
+
+    r0, c0, block = _find_block(g, bg_colors)
+    out = g.copy()
+
