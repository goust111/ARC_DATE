+from __future__ import annotations
+
+import itertools
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+ORANGE = 7
+
+CARDINAL_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+RNG = np.random.default_rng()
+
+GRID_COUNTS = [3, 4]
+CELL_SIZES = [3, 5]
