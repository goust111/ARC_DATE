+        for c in range(c0 + 1, c1):
+            if not _in_triangle(spec, r, c):
+                cells.append((r, c))
+    return cells
+
+
+def _shadow_path(
+    shape: tuple[int, int],
+    boundary_mask: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    dr, dc = direction
+    rr, cc = start
+    cells: list[tuple[int, int]] = []
+    while True:
+        rr += dr
+        cc += dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            return cells
+        if boundary_mask[rr, cc]:
