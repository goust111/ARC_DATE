+            colors.add(color)
+        if len(residues) < 2:
+            continue
+        if len(colors) < 2:
+            continue
+        return patch, info
+    return None
+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray, dict[str, object]] | None:
+    side = random.choice((4, 5))
+    palette = tuple(random.sample(list(DIAGONAL_COLORS), 3))
+    signature = _random_signature(side)
