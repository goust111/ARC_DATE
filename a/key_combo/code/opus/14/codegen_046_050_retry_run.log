+        return None
+
+    if classes.count("valid") < 3 or classes.count("mixed") < 1 or classes.count("missing") < 1:
+        return None
+
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        candidate = _generate_case()
+        if candidate is not None:
+            return candidate
