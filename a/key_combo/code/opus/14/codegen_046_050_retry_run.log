@@ -0,0 +1,426 @@
+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+PANEL_NAMES = ("UL", "UR", "LL", "LR")
+OVERLAY_ORDER = ("UL", "LR", "LL", "UR")
+TEMPLATES = ("ur_ll_hollow", "ur_lr_hollow", "ll_lr_hollow")
+BACKGROUND = 0
+MAX_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_by_color(grid: np.ndarray, bg: int) -> list[tuple[int, np.ndarray]]:
+    h, w = grid.shape
+    comps: list[tuple[int, np.ndarray]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != int(bg)):
+        mask = grid == color
+        seen = np.zeros_like(mask, dtype=bool)
+        for r in range(h):
+            for c in range(w):
+                if not mask[r, c] or seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                cells: list[tuple[int, int]] = []
+                while stack:
+                    rr, cc = stack.pop()
+                    cells.append((rr, cc))
+                    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                        nr = rr + dr
+                        nc = cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                comps.append((color, np.asarray(cells, dtype=int)))
+    return comps
+
+
+def _rect_size(rect: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _rect_area(rect: tuple[int, int, int, int]) -> int:
+    h, w = _rect_size(rect)
+    return h * w
+
+
+def _overlap_area(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return 0
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _gap_disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    return (
+        a[2] + gap < b[0]
+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
+    )
+
+
+def _draw_rect(grid: np.ndarray, rect: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = rect
+    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+
+
+def _rect_inside(
+    inner: tuple[int, int, int, int],
+    outer: tuple[int, int, int, int],
+) -> bool:
+    return outer[0] <= inner[0] <= inner[2] <= outer[2] and outer[1] <= inner[1] <= inner[3] <= outer[3]
+
+
+def _hollow_rect(grid: np.ndarray, rect: tuple[int, int, int, int], bg: int) -> None:
+    r0, c0, r1, c1 = rect
+    if r1 - r0 >= 2 and c1 - c0 >= 2:
+        grid[r0 + 1 : r1, c0 + 1 : c1] = int(bg)
+
+
+def _split_panels(grid: np.ndarray) -> dict[str, np.ndarray]:
+    h, w = grid.shape
+    panel_h = h // 2
+    panel_w = w // 2
+    return {
+        "UL": grid[:panel_h, :panel_w],
+        "UR": grid[:panel_h, panel_w:],
+        "LL": grid[panel_h:, :panel_w],
+        "LR": grid[panel_h:, panel_w:],
+    }
+
+
+def _compose_panels(panels: dict[str, np.ndarray], bg: int) -> tuple[np.ndarray, np.ndarray]:
+    sample = next(iter(panels.values()))
+    out = np.full(sample.shape, bg, dtype=int)
+    coverage = np.zeros(sample.shape, dtype=int)
+    for panel in panels.values():
+        coverage += (panel != bg).astype(int)
+    for name in OVERLAY_ORDER:
+        panel = panels[name]
+        mask = panel != bg
+        out[mask] = panel[mask]
+    return out, coverage
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Transparently overlay the four quadrant panels, then hollow only the visible rectangles that hide multi-panel overlap.
+
+    Input structure:
+    - The grid has black background and conceptually splits into four equal panels: upper-left, upper-right, lower-left, and lower-right.
+    - Each panel contains one or two solid axis-aligned rectangles, all drawn in that panel's single foreground color.
+    - Corresponding local panel coordinates refer to the same output cell after overlay.
+
+    Rule:
+    - Split the input into the four equal panels and overlay them onto one panel-sized canvas in the fixed order upper-left, lower-right, lower-left, upper-right; later non-background pixels overwrite earlier ones.
+    - Simultaneously count, for every output cell, how many panels contribute a non-background pixel at that local coordinate.
+    - In the composite image, inspect each monochrome 4-connected component that fully fills its own bounding box, i.e. each visible solid rectangle.
+    - If any cell of that visible rectangle has coverage count at least 2, keep its one-pixel border and set its strict interior to black; otherwise leave it solid.
+
+    Key insight:
+    - The same overlay yields two necessary signals at once: visible color comes from layer priority, but the decision to hollow comes from hidden multi-layer coverage that may be invisible in the final composite.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    h, w = g.shape
+    assert h % 2 == 0 and w % 2 == 0, "grid must split into four equal panels"
+
+    bg = _get_bg(g)
+    panels = _split_panels(g)
+    composite, coverage = _compose_panels(panels, bg)
+
+    out = composite.copy()
+    for color, coords in _components_by_color(composite, bg):
+        r0, c0, r1, c1 = _bbox(coords)
+        block = composite[r0 : r1 + 1, c0 : c1 + 1]
+        if coords.shape[0] != block.size or not np.all(block == color):
+            continue
+        if np.any(coverage[r0 : r1 + 1, c0 : c1 + 1] >= 2):
+            _hollow_rect(out, (r0, c0, r1, c1), bg)
+    return out
+
+
+def _zone_bounds(panel_h: int, panel_w: int) -> dict[str, tuple[int, int, int, int]]:
+    return {
+        "A": (0, panel_h // 2 - 1, 0, panel_w // 2 - 1),
+        "B": (panel_h // 2 + 1, panel_h - 1, 0, panel_w // 2 - 1),
+        "C": (0, panel_h - 1, panel_w // 2 + 1, panel_w - 1),
+    }
+
+
+def _sample_rect_in_zone(
+    zone: tuple[int, int, int, int],
+    min_h: int,
+    min_w: int,
+) -> tuple[int, int, int, int] | None:
+    zr0, zr1, zc0, zc1 = zone
+    zone_h = zr1 - zr0 + 1
+    zone_w = zc1 - zc0 + 1
+    if zone_h < min_h or zone_w < min_w:
+        return None
+    height = random.randint(min_h, zone_h)
+    width = random.randint(min_w, zone_w)
+    r0 = random.randint(zr0, zr1 - height + 1)
+    c0 = random.randint(zc0, zc1 - width + 1)
+    return (r0, c0, r0 + height - 1, c0 + width - 1)
+
+
+def _sample_support(outer: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = outer
+    height, width = _rect_size(outer)
+    inner_h = random.randint(3, height)
+    inner_w = random.randint(3, width)
+    sr0 = random.randint(r0, r1 - inner_h + 1)
+    sc0 = random.randint(c0, c1 - inner_w + 1)
+    return (sr0, sc0, sr0 + inner_h - 1, sc0 + inner_w - 1)
+
+
+def _render_input(
+    panel_h: int,
+    panel_w: int,
+    panel_colors: dict[str, int],
+    panel_rects: dict[str, list[tuple[int, int, int, int]]],
+) -> tuple[np.ndarray, dict[str, np.ndarray]]:
+    panels: dict[str, np.ndarray] = {}
+    for name in PANEL_NAMES:
+        panel = np.full((panel_h, panel_w), BACKGROUND, dtype=int)
+        for rect in panel_rects[name]:
+            _draw_rect(panel, rect, panel_colors[name])
+        panels[name] = panel
+
+    full = np.full((panel_h * 2, panel_w * 2), BACKGROUND, dtype=int)
+    full[:panel_h, :panel_w] = panels["UL"]
+    full[:panel_h, panel_w:] = panels["UR"]
+    full[panel_h:, :panel_w] = panels["LL"]
+    full[panel_h:, panel_w:] = panels["LR"]
+    return full, panels
+
+
+def _independent_expected(scene: dict) -> np.ndarray:
+    composite = scene["composite"].copy()
+    for name, info in scene["visible_regions"].items():
+        if info["hollow"]:
+            _hollow_rect(composite, info["rect"], BACKGROUND)
+    return composite
+
+
+def _validate_scene(scene: dict) -> bool:
+    panel_h = scene["panel_h"]
+    panel_w = scene["panel_w"]
+    panel_colors = scene["panel_colors"]
+    panel_rects = scene["panel_rects"]
+    panels = scene["panels"]
+    composite = scene["composite"]
+    coverage = scene["coverage"]
+    visible_regions = scene["visible_regions"]
+    inp = scene["input"]
+
+    if inp.shape != (panel_h * 2, panel_w * 2):
+        return False
+    if max(inp.shape) > 30:
+        return False
+
+    for name in PANEL_NAMES:
+        rects = panel_rects[name]
+        if not (1 <= len(rects) <= 2):
+            return False
+        for rect in rects:
+            h, w = _rect_size(rect)
+            if h < 3 or w < 3:
+                return False
+        if len(rects) == 2 and not _gap_disjoint(rects[0], rects[1], gap=1):
+            return False
+        comps = _components_by_color(panels[name], BACKGROUND)
+        if len(comps) != len(rects):
+            return False
+        for color, coords in comps:
+            if color != panel_colors[name]:
+                return False
+            r0, c0, r1, c1 = _bbox(coords)
+            if coords.shape[0] != _rect_area((r0, c0, r1, c1)):
+                return False
+
+    overlap_pairs = 0
+    all_panel_rects: list[tuple[str, tuple[int, int, int, int]]] = []
+    for name in PANEL_NAMES:
+        all_panel_rects.extend((name, rect) for rect in panel_rects[name])
+    for i, (name_a, rect_a) in enumerate(all_panel_rects):
+        for name_b, rect_b in all_panel_rects[i + 1 :]:
+            if name_a == name_b:
+                continue
+            area = _overlap_area(rect_a, rect_b)
+            if area > 0:
+                if area < 9:
+                    return False
+                overlap_pairs += 1
+    if overlap_pairs < 2:
+        return False
+
+    actual_panels = _split_panels(inp)
+    if any(not np.array_equal(actual_panels[name], panels[name]) for name in PANEL_NAMES):
+        return False
+    actual_composite, actual_coverage = _compose_panels(actual_panels, BACKGROUND)
+    if not np.array_equal(actual_composite, composite):
+        return False
+    if not np.array_equal(actual_coverage, coverage):
+        return False
+
+    actual_visible = {
+        (int(color), _bbox(coords))
+        for color, coords in _components_by_color(composite, BACKGROUND)
+    }
+    intended_visible = {
+        (panel_colors[info["owner"]], info["rect"])
+        for info in visible_regions.values()
+    }
+    if actual_visible != intended_visible:
+        return False
+
+    hollow_count = 0
+    solid_count = 0
+    for info in visible_regions.values():
+        rect = info["rect"]
+        r0, c0, r1, c1 = rect
+        if not np.all(composite[r0 : r1 + 1, c0 : c1 + 1] == panel_colors[info["owner"]]):
+            return False
+        has_overlap = bool(np.any(coverage[r0 : r1 + 1, c0 : c1 + 1] >= 2))
+        if has_overlap != info["hollow"]:
+            return False
+        if info["hollow"]:
+            hollow_count += 1
+        else:
+            solid_count += 1
+    if hollow_count < 1 or solid_count < 1:
+        return False
+
+    expected = _independent_expected(scene)
+    if not np.array_equal(main(inp), expected):
+        return False
+    return True
+
+
+def _attempt_scene() -> dict | None:
+    panel_h = random.randint(9, 12)
+    panel_w = random.randint(9, 12)
+    zone = _zone_bounds(panel_h, panel_w)
+    template = random.choice(TEMPLATES)
+    colors = random.sample(list(range(1, 10)), 4)
+    panel_colors = {name: color for name, color in zip(PANEL_NAMES, colors)}
+
+    hollow_regions: dict[str, bool]
+    if template == "ur_ll_hollow":
+        hollow_regions = {"A": True, "B": True, "C": False}
+    elif template == "ur_lr_hollow":
+        hollow_regions = {"A": True, "B": False, "C": True}
+    else:
+        hollow_regions = {"A": False, "B": True, "C": True}
+
+    visible_rects: dict[str, tuple[int, int, int, int]] = {}
+    for region_name in ("A", "B", "C"):
+        min_side = 4 if hollow_regions[region_name] else 3
+        rect = _sample_rect_in_zone(zone[region_name], min_side, min_side)
+        if rect is None:
+            return None
+        visible_rects[region_name] = rect
+
+    if not _gap_disjoint(visible_rects["A"], visible_rects["C"], gap=1):
+        return None
+    if not _gap_disjoint(visible_rects["B"], visible_rects["C"], gap=1):
+        return None
+
+    panel_rects: dict[str, list[tuple[int, int, int, int]]] = {name: [] for name in PANEL_NAMES}
+    visible_regions: dict[str, dict[str, object]] = {}
+
+    if template == "ur_ll_hollow":
+        panel_rects["UR"].append(visible_rects["A"])
+        panel_rects["LL"].append(visible_rects["B"])
+        panel_rects["LR"].append(visible_rects["C"])
+        panel_rects["UL"].append(_sample_support(visible_rects["A"]))
+        panel_rects["UL"].append(_sample_support(visible_rects["B"]))
+        panel_rects["LR"].append(_sample_support(visible_rects["A"]))
+        visible_regions = {
+            "A": {"rect": visible_rects["A"], "owner": "UR", "hollow": True},
+            "B": {"rect": visible_rects["B"], "owner": "LL", "hollow": True},
+            "C": {"rect": visible_rects["C"], "owner": "LR", "hollow": False},
+        }
+    elif template == "ur_lr_hollow":
+        panel_rects["UR"].append(visible_rects["A"])
+        panel_rects["LL"].append(visible_rects["B"])
+        panel_rects["LR"].append(visible_rects["C"])
+        panel_rects["UL"].append(_sample_support(visible_rects["A"]))
+        panel_rects["UL"].append(_sample_support(visible_rects["C"]))
+        panel_rects["LL"].append(_sample_support(visible_rects["A"]))
+        visible_regions = {
+            "A": {"rect": visible_rects["A"], "owner": "UR", "hollow": True},
+            "B": {"rect": visible_rects["B"], "owner": "LL", "hollow": False},
+            "C": {"rect": visible_rects["C"], "owner": "LR", "hollow": True},
+        }
+    else:
+        panel_rects["UR"].append(visible_rects["A"])
+        panel_rects["LL"].append(visible_rects["B"])
+        panel_rects["LR"].append(visible_rects["C"])
+        panel_rects["UL"].append(_sample_support(visible_rects["B"]))
+        panel_rects["UL"].append(_sample_support(visible_rects["C"]))
+        panel_rects["LR"].append(_sample_support(visible_rects["B"]))
+        visible_regions = {
+            "A": {"rect": visible_rects["A"], "owner": "UR", "hollow": False},
+            "B": {"rect": visible_rects["B"], "owner": "LL", "hollow": True},
+            "C": {"rect": visible_rects["C"], "owner": "LR", "hollow": True},
+        }
+
+    for info in visible_regions.values():
+        if info["hollow"]:
+            h, w = _rect_size(info["rect"])
+            if h < 4 or w < 4:
+                return None
+
+    for name in PANEL_NAMES:
+        for rect in panel_rects[name]:
+            h, w = _rect_size(rect)
+            if h < 3 or w < 3:
+                return None
+
+    inp, panels = _render_input(panel_h, panel_w, panel_colors, panel_rects)
+    composite, coverage = _compose_panels(panels, BACKGROUND)
+    scene = {
+        "template": template,
+        "panel_h": panel_h,
+        "panel_w": panel_w,
+        "panel_colors": panel_colors,
+        "panel_rects": panel_rects,
+        "visible_regions": visible_regions,
+        "input": inp,
+        "panels": panels,
+        "composite": composite,
+        "coverage": coverage,
+    }
+    if not _validate_scene(scene):
+        return None
+    return scene
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        scene = _attempt_scene()
+        if scene is not None:
+            return scene["input"].copy()
+    raise RuntimeError("failed to generate a valid transparent-overlay hollowing input")

diff --git a/key_combo/code/opus/14/049/2.py b/key_combo/code/opus/14/049/2.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e08d483ece4c2b0f7fadbcb44eba2729f97d439
--- /dev/null
+++ b/key_combo/code/opus/14/049/2.py
@@ -0,0 +1,516 @@
+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SEED = 5
+LINE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 500
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    colors = sorted(int(x) for x in np.unique(grid))
+    if exclude is None:
+        return colors
+    return [color for color in colors if color not in exclude]
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _extract_segments(grid: np.ndarray) -> tuple[list[dict[str, int | str]], int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _most_common_color(g)
+    horizontal_owner = np.full(g.shape, -1, dtype=int)
+    vertical_owner = np.full(g.shape, -1, dtype=int)
+    segments: list[dict[str, int | str]] = []
+
+    for color in _colors_present(g, exclude={bg, SEED}):
+        coords = np.argwhere(g == color)
+        assert coords.shape == (2, 2), "each line color must appear exactly twice as endpoints"
+        (r0, c0), (r1, c1) = coords.tolist()
+        r0 = int(r0)
+        c0 = int(c0)
+        r1 = int(r1)
+        c1 = int(c1)
+        assert r0 == r1 or c0 == c1, "same-color endpoints must share a row or a column"
+
+        if r0 == r1:
+            c_start, c_end = sorted((c0, c1))
+            for c in range(c_start, c_end + 1):
+                assert horizontal_owner[r0, c] == -1, "horizontal lines must not overlap each other"
+                horizontal_owner[r0, c] = color
+            segments.append(
+                {"orient": "horizontal", "color": color, "r0": r0, "c0": c_start, "r1": r1, "c1": c_end}
+            )
+        else:
+            r_start, r_end = sorted((r0, r1))
+            for r in range(r_start, r_end + 1):
+                assert vertical_owner[r, c0] == -1, "vertical lines must not overlap each other"
+                vertical_owner[r, c0] = color
+            segments.append(
+                {"orient": "vertical", "color": color, "r0": r_start, "c0": c0, "r1": r_end, "c1": c1}
+            )
+
+    assert segments, "expected at least one colored endpoint pair"
+    return segments, bg
+
+
+def _segment_cells(segment: dict[str, int | str]) -> list[tuple[int, int]]:
+    orient = str(segment["orient"])
+    color = int(segment["color"])
+    _ = color
+    r0 = int(segment["r0"])
+    c0 = int(segment["c0"])
+    r1 = int(segment["r1"])
+    c1 = int(segment["c1"])
+    if orient == "horizontal":
+        return [(r0, c) for c in range(c0, c1 + 1)]
+    return [(r, c0) for r in range(r0, r1 + 1)]
+
+
+def _line_geometry(
+    shape: tuple[int, int], segments: list[dict[str, int | str]]
+) -> tuple[np.ndarray, np.ndarray, dict[tuple[int, int], list[tuple[str, int]]], int]:
+    line_mask = np.zeros(shape, dtype=bool)
+    visible = np.zeros(shape, dtype=int)
+    pos_to_incidence: dict[tuple[int, int], list[tuple[str, int]]] = defaultdict(list)
+
+    for segment in segments:
+        if segment["orient"] != "horizontal":
+            continue
+        color = int(segment["color"])
+        for pos in _segment_cells(segment):
+            line_mask[pos] = True
+            visible[pos] = color
+            pos_to_incidence[pos].append(("horizontal", color))
+
+    for segment in segments:
+        if segment["orient"] != "vertical":
+            continue
+        color = int(segment["color"])
+        for pos in _segment_cells(segment):
+            line_mask[pos] = True
+            visible[pos] = color
+            pos_to_incidence[pos].append(("vertical", color))
+
+    crossing_count = sum(1 for incidences in pos_to_incidence.values() if len(incidences) > 1)
+    return line_mask, visible, pos_to_incidence, crossing_count
+
+
+def _region_components(line_mask: np.ndarray) -> list[dict[str, object]]:
+    h, w = line_mask.shape
+    seen = np.zeros_like(line_mask, dtype=bool)
+    regions: list[dict[str, object]] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if line_mask[r0, c0] or seen[r0, c0]:
+                continue
+            queue = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            touches_border = False
+
+            while queue:
+                r, c = queue.popleft()
+                coords.append((r, c))
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not line_mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            boundary_positions: set[tuple[int, int]] = set()
+            for r, c in coords:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and line_mask[nr, nc]:
+                        boundary_positions.add((nr, nc))
+
+            regions.append(
+                {
+                    "coords": coords,
+                    "closed": not touches_border,
+                    "boundary_positions": boundary_positions,
+                }
+            )
+
+    return regions
+
+
+def _nearest_line_choice(
+    seed: tuple[int, int],
+    boundary_positions: set[tuple[int, int]],
+    pos_to_incidence: dict[tuple[int, int], list[tuple[str, int]]],
+) -> tuple[int, str]:
+    best_distance: int | None = None
+    best_hits: list[tuple[str, int]] = []
+
+    for r, c in boundary_positions:
+        dist = abs(seed[0] - r) + abs(seed[1] - c)
+        if best_distance is None or dist < best_distance:
+            best_distance = dist
+            best_hits = list(pos_to_incidence[(r, c)])
+        elif dist == best_distance:
+            best_hits.extend(pos_to_incidence[(r, c)])
+
+    assert best_distance is not None and best_hits, "closed seeded region must have boundary line pixels"
+
+    vertical_colors = {color for orient, color in best_hits if orient == "vertical"}
+    horizontal_colors = {color for orient, color in best_hits if orient == "horizontal"}
+
+    if vertical_colors:
+        assert len(vertical_colors) == 1, "nearest-distance tie among multiple vertical colors is ambiguous"
+        if horizontal_colors:
+            return next(iter(vertical_colors)), "tie_vertical"
+        return next(iter(vertical_colors)), "vertical"
+
+    assert len(horizontal_colors) == 1, "nearest-distance tie among multiple horizontal colors is ambiguous"
+    return next(iter(horizontal_colors)), "horizontal"
+
+
+def _solve_details(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+    segments, bg = _extract_segments(g)
+    line_mask, visible_lines, pos_to_incidence, crossing_count = _line_geometry(g.shape, segments)
+    regions = _region_components(line_mask)
+
+    out = g.copy()
+    out[line_mask] = visible_lines[line_mask]
+
+    closed_seeded = 0
+    for region in regions:
+        coords = list(region["coords"])
+        seeds = [(r, c) for r, c in coords if int(g[r, c]) == SEED]
+        region["seeds"] = seeds
+        if not bool(region["closed"]):
+            region["fill_color"] = None
+            region["fill_mode"] = None
+            continue
+        assert len(seeds) <= 1, "each closed region must contain at most one seed"
+        if not seeds:
+            region["fill_color"] = None
+            region["fill_mode"] = None
+            continue
+        fill_color, fill_mode = _nearest_line_choice(
+            seeds[0],
+            set(region["boundary_positions"]),
+            pos_to_incidence,
+        )
+        for r, c in coords:
+            out[r, c] = fill_color
+        region["fill_color"] = fill_color
+        region["fill_mode"] = fill_mode
+        closed_seeded += 1
+
+    return {
+        "output": out,
+        "segments": segments,
+        "bg": bg,
+        "line_mask": line_mask,
+        "visible_lines": visible_lines,
+        "pos_to_incidence": pos_to_incidence,
+        "crossing_count": crossing_count,
+        "regions": regions,
+        "closed_seeded": closed_seeded,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Connect aligned color pairs into crossing lines, then flood-fill each enclosed seeded region using the nearest boundary segment color.
+
+    Input structure:
+    - The background is black, with several non-gray colors each appearing exactly twice as aligned endpoints.
+    - Each endpoint pair defines a horizontal or vertical one-pixel-wide segment, and gray pixels are fill seeds.
+    - After the segments are drawn, some non-line cells become fully enclosed regions while other cells remain connected to the grid boundary.
+
+    Rule:
+    - Draw every endpoint pair as an inclusive straight segment of its own color.
+    - If a horizontal and a vertical segment cross on the same cell, the visible crossing color is the vertical one.
+    - Find every region of non-line cells that is completely cut off from the grid boundary; for each such region with a gray seed, compute the seed's minimum Manhattan distance to the region's boundary line pixels and use the corresponding segment color as the fill color, breaking distance ties in favor of vertical segments.
+    - Flood-fill the entire enclosed region, including the seed cell, with that chosen color; leave non-enclosed gray seeds unchanged.
+
+    Key insight:
+    - The fillable areas do not exist in the input directly; they emerge only after the aligned endpoint pairs are connected into a crossing line network, and the same vertical-priority logic governs both crossings and nearest-boundary tie resolution.
+    """
+    return np.asarray(_solve_details(grid)["output"], dtype=int)
+
+
+def _random_partition(total: int, parts: int, rng: random.Random) -> list[int]:
+    buckets = [0] * parts
+    for _ in range(total):
+        buckets[rng.randrange(parts)] += 1
+    return buckets
+
+
+def _sample_axis(limit: int, count: int, rng: random.Random) -> list[int] | None:
+    slack = limit - 5 - 4 * (count - 1)
+    if slack < 0:
+        return None
+    parts = _random_partition(slack, count + 1, rng)
+    positions = [2 + parts[0]]
+    for gap_extra in parts[1:count]:
+        positions.append(positions[-1] + 4 + gap_extra)
+    if positions[-1] > limit - 3:
+        return None
+    return positions
+
+
+def _build_framework(rng: random.Random) -> tuple[np.ndarray, list[dict[str, int | str]], list[int], list[int]] | None:
+    height = rng.randint(14, 22)
+    width = rng.randint(14, 22)
+    possible_h = [count for count in (3, 4) if _sample_axis(height, count, rng) is not None]
+    possible_v = [count for count in (3, 4) if _sample_axis(width, count, rng) is not None]
+    if not possible_h or not possible_v:
+        return None
+
+    n_h = rng.choice(possible_h)
+    n_v = rng.choice(possible_v)
+    rows = _sample_axis(height, n_h, rng)
+    cols = _sample_axis(width, n_v, rng)
+    if rows is None or cols is None:
+        return None
+
+    colors = list(LINE_COLORS)
+    rng.shuffle(colors)
+    if n_h + n_v > len(colors):
+        return None
+
+    segments: list[dict[str, int | str]] = []
+    color_index = 0
+    for row in rows:
+        c0 = rng.randint(1, cols[0] - 1)
+        c1 = rng.randint(cols[-1] + 1, width - 2)
+        segments.append({"orient": "horizontal", "color": colors[color_index], "r0": row, "c0": c0, "r1": row, "c1": c1})
+        color_index += 1
+    for col in cols:
+        r0 = rng.randint(1, rows[0] - 1)
+        r1 = rng.randint(rows[-1] + 1, height - 2)
+        segments.append({"orient": "vertical", "color": colors[color_index], "r0": r0, "c0": col, "r1": r1, "c1": col})
+        color_index += 1
+
+    grid = np.zeros((height, width), dtype=int)
+    for segment in segments:
+        color = int(segment["color"])
+        r0 = int(segment["r0"])
+        c0 = int(segment["c0"])
+        r1 = int(segment["r1"])
+        c1 = int(segment["c1"])
+        if segment["orient"] == "horizontal":
+            if grid[r0, c0] != BG or grid[r1, c1] != BG:
+                return None
+            grid[r0, c0] = color
+            grid[r1, c1] = color
+        else:
+            if grid[r0, c0] != BG or grid[r1, c1] != BG:
+                return None
+            grid[r0, c0] = color
+            grid[r1, c1] = color
+    return grid, segments, rows, cols
+
+
+def _region_candidates(
+    region: dict[str, object], pos_to_incidence: dict[tuple[int, int], list[tuple[str, int]]]
+) -> list[dict[str, object]]:
+    candidates: list[dict[str, object]] = []
+    boundary_positions = set(region["boundary_positions"])
+    for cell in region["coords"]:
+        try:
+            fill_color, fill_mode = _nearest_line_choice(cell, boundary_positions, pos_to_incidence)
+        except AssertionError:
+            continue
+        candidates.append({"cell": cell, "fill_color": fill_color, "fill_mode": fill_mode})
+    return candidates
+
+
+def _choose_seed_layout(
+    closed_regions: list[dict[str, object]],
+    pos_to_incidence: dict[tuple[int, int], list[tuple[str, int]]],
+    rng: random.Random,
+    force_tie: bool,
+) -> tuple[dict[int, tuple[int, int]], dict[int, str], dict[int, int]] | None:
+    candidate_map: dict[int, list[dict[str, object]]] = {}
+    mode_map: dict[int, dict[str, list[dict[str, object]]]] = {}
+    for idx, region in enumerate(closed_regions):
+        region_candidates = _region_candidates(region, pos_to_incidence)
+        if not region_candidates:
+            return None
+        candidate_map[idx] = region_candidates
+        modes: dict[str, list[dict[str, object]]] = defaultdict(list)
+        for cand in region_candidates:
+            modes[str(cand["fill_mode"])].append(cand)
+        mode_map[idx] = dict(modes)
+
+    assignments: dict[int, tuple[int, int]] = {}
+    modes: dict[int, str] = {}
+    colors: dict[int, int] = {}
+
+    if force_tie:
+        tie_regions = [idx for idx, grouped in mode_map.items() if "tie_vertical" in grouped]
+        if not tie_regions:
+            return None
+        tie_idx = rng.choice(tie_regions)
+        cand = rng.choice(mode_map[tie_idx]["tie_vertical"])
+        assignments[tie_idx] = tuple(cand["cell"])
+        modes[tie_idx] = "tie_vertical"
+        colors[tie_idx] = int(cand["fill_color"])
+
+    horizontal_regions = [idx for idx, grouped in mode_map.items() if "horizontal" in grouped and idx not in assignments]
+    if not horizontal_regions:
+        return None
+    horizontal_idx = rng.choice(horizontal_regions)
+    cand = rng.choice(mode_map[horizontal_idx]["horizontal"])
+    assignments[horizontal_idx] = tuple(cand["cell"])
+    modes[horizontal_idx] = "horizontal"
+    colors[horizontal_idx] = int(cand["fill_color"])
+
+    if not force_tie:
+        vertical_regions = [idx for idx, grouped in mode_map.items() if "vertical" in grouped and idx not in assignments]
+        if not vertical_regions:
+            return None
+        vertical_idx = rng.choice(vertical_regions)
+        cand = rng.choice(mode_map[vertical_idx]["vertical"])
+        assignments[vertical_idx] = tuple(cand["cell"])
+        modes[vertical_idx] = "vertical"
+        colors[vertical_idx] = int(cand["fill_color"])
+
+    for idx in range(len(closed_regions)):
+        if idx in assignments:
+            continue
