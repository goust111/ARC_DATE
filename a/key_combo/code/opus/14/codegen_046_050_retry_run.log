+                continue
+            _add_group(orange, group)
+            return True
+    return False
+
+
+def _try_place_unpaired_component(
+    rng: np.random.Generator,
+    box: tuple[int, int, int, int],
+    orange: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+    protected_empty: set[tuple[int, int]],
