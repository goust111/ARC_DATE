+
+    out[g == GREY] = GREY
+    out[g == ORANGE] = ORANGE
+    out[g == BLUE] = BLUE
+    return out
+
+
+def _all_direction_sets() -> list[tuple[tuple[int, int], ...]]:
+    direction_sets = []
+    for size in range(1, 4):
+        for subset in itertools.combinations(CARDINAL_DIRS, size):
+            if _is_asymmetric(subset):
