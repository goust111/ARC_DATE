+
+
+def _gen_attempt() -> np.ndarray | None:
+    w = random.randint(16, 20)
+    sep = random.randint(9, 12)
+    h = random.randint(max(15, sep + 4), 19)
+    t = random.randint(2, 4)
+
+    selected_count = random.choice((1, 2))
