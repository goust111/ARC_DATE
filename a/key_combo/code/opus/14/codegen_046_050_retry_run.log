+    t = int(analysis["t"])
+    chosen = {
+        i
+        for i, path in enumerate(analysis["paths"])
+        if int(sep - path["visible_endpoint"][0]) == t
+    }
+    return _render_bars(grid, analysis, selected_paths=chosen)
+
+
+def _shortcut_endpoint_columns_only(grid: np.ndarray) -> np.ndarray:
