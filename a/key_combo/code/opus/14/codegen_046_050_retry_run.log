+                        break
+                    mirrors.append((gr, mc))
+                if not valid:
+                    continue
+                if not _can_place_group((r1 + 1, c1 + 1), group, orange, blocked, protected_empty):
+                    continue
+                _add_group(orange, group)
+                protected_empty.update(mirrors)
+                return True
+    return False
