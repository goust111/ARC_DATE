+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PATH = 3
+MARKER = 5
+GATE_END = 9
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
