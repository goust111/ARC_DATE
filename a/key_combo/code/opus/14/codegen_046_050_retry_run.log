+from __future__ import annotations
+
+import random
+from typing import Any
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+COLOR_BY_BENDS = {
+    0: BLUE,
+    1: GREEN,
+    2: YELLOW,
+}
+
+
+def _bend_color(bends: int) -> int:
