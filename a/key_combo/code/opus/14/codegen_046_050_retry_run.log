+def _transform_coords(coords: set[tuple[int, int]], side: int, orientation: int) -> set[tuple[int, int]]:
+    mapper = _orientation_maps(side)[orientation]["base_to_oriented"]
+    return {tuple(map(int, mapper[r, c])) for r, c in coords}
