+    order = sorted(range(len(sizes)), key=lambda idx: sizes[idx][0] * sizes[idx][1], reverse=True)
+    placed: list[tuple[int, int, int, int] | None] = [None] * len(sizes)
+    committed: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        rh, rw = sizes[idx]
+        options = []
+        for _ in range(POSITION_ATTEMPTS):
+            r0 = rng.randint(0, h - rh)
+            c0 = rng.randint(0, w - rw)
+            candidate = (r0, c0, r0 + rh - 1, c0 + rw - 1)
+            if all(_boxes_far_enough(candidate, other, gap=GAP) for other in committed):
