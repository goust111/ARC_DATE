+SPRITE_COLORS = (1, 3, 4)
+ANCHOR_COLORS = (2, 5, 6, 7, 8)
+DISTRACTOR_COLOR = 9
+GRID_SIDE_RANGE = (14, 19)
+SOURCE_COUNT_CHOICES = (2, 2, 1)
+DEST_COUNT_CHOICES = (2, 2, 3)
+FULL_WIDTH_CHOICES = (4, 6)
+FULL_HEIGHT_CHOICES = (2, 3, 4)
+SPRITE_AREA_RANGE = (3, 6)
