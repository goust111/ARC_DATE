+
+def _paint_shape(
+    canvas: np.ndarray,
+    shape_mask: np.ndarray,
+    *,
+    anchor_r: int,
+    anchor_c: int,
+    main_color: int,
+    accent_colors: tuple[int, int],
+    rng: np.random.Generator,
