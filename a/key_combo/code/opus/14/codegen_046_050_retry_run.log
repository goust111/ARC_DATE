    memo: dict[tuple[int, int], bool] = {}

    def can_make(remaining: int, slots: int) -> bool:
        key = (remaining, slots)
        if key in memo:
            return memo[key]
        if slots == 0:
            ok = remaining == 0
        elif remaining < slots * values[0] or remaining > slots * values[-1]:
            ok = False
