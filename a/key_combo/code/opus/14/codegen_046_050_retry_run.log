+def _neighbors4(cell: Tuple[int, int], h: int, w: int) -> List[Tuple[int, int]]:
+    r, c = cell
+    out: List[Tuple[int, int]] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr, nc = r + dr, c + dc
