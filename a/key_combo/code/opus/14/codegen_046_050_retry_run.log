+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
