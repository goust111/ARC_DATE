+            h_conn = h_connect_options[int(rng.integers(0, len(h_connect_options)))]
+            v_conn = v_connect_options[int(rng.integers(0, len(v_connect_options)))]
+            return h_block, v_block, h_conn, v_conn
+    return None
+
