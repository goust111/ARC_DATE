+        row_range = range(2, h - 2)
+        col_range = range(2, w - length - 1)
+        attach_range = range(length) if side in ("top", "bottom") else range(1)
+    else:
+        row_range = range(2, h - length - 1)
+        col_range = range(2, w - 2)
