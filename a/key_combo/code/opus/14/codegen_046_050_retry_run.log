+def _line_geometry(
+    shape: tuple[int, int], segments: list[dict[str, int | str]]
+) -> tuple[np.ndarray, np.ndarray, dict[tuple[int, int], list[tuple[str, int]]], int]:
+    line_mask = np.zeros(shape, dtype=bool)
+    visible = np.zeros(shape, dtype=int)
