+    stack = list(seen)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in NEIGHBORS4:
+            nbr = (r + dr, c + dc)
+            if nbr in cells and nbr not in seen:
+                seen.add(nbr)
+                stack.append(nbr)
