+def _valid_block_positions(n: int, radius: int) -> list[tuple[int, int]]:
+    dist = _diamond_distance_mask(n)
+    outline = dist == int(radius)
+    forbidden = outline.copy()
+    for r, c in np.argwhere(outline):
+        r = int(r)
+        c = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < n and 0 <= nc < n:
