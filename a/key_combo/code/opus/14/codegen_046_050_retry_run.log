+
+def _blocked_vertical_choices(rows: int, cols: int) -> list[tuple[tuple[int, int], tuple[int, int], tuple[int, int], str]]:
+    choices = []
+    for c, direction in ((0, "left"), (cols - 1, "right")):
+        for r in range(rows - 1):
