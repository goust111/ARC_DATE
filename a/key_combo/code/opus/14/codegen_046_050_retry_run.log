            if inp[r, v_seg["c"]] != 0:
                return None
            inp[r, v_seg["c"]] = v_seg["color"]
    return inp


def _gen_attempt() -> np.ndarray | None:
    rows = int(np.random.randint(ROWS_MIN, ROWS_MAX_EXCL))
