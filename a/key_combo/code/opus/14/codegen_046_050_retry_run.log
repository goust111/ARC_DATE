+                if 1 <= d <= depth:
+                    expected = YELLOW if d % 2 == 1 else ORANGE
+                    assert int(out[r, c]) == expected
+                    filled += 1
+                else:
+                    assert int(out[r, c]) == BACKGROUND
+                    if d > depth:
