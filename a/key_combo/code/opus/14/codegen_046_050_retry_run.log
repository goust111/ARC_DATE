+
+def _boxes_overlap(b1: tuple[int, int, int, int], b2: tuple[int, int, int, int]) -> bool:
+    return not (b1[2] < b2[0] or b2[2] < b1[0] or b1[3] < b2[1] or b2[3] < b1[1])
+
