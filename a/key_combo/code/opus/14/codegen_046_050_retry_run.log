+
+def _choose_noise_block(
+    wall: np.ndarray,
+    holes: set[tuple[int, int]],
+    existing_noise: set[tuple[int, int]],
+    colors: tuple[int, ...],
+) -> tuple[list[tuple[int, int]], int] | None:
+    h, w = wall.shape
+    candidates: list[tuple[list[tuple[int, int]], int]] = []
+    for shape in SHAPES:
+        shape_h = max(r for r, _ in shape) + 1
