+    for _ in range(_MAX_GEN_ATTEMPTS):
+        grid = _build_candidate(rng)
+        try:
+            _semantic_checks(grid)
+        except AssertionError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid separator-overlay puzzle")

