            box = (r, c, r + h - 1, c + w - 1)
            if not _gen_rects_clear(box, placed):
                continue
            placed.append(box)
            if search(i + 1):
                return True
            placed.pop()
        return False

    if search(0):
        return placed.copy()
    return None


