+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < height and 0 <= nc < half_w and not mask[nr, nc]:
+                    frontier.add((int(nr), int(nc)))
+        if not frontier:
+            return None
+        pick = random.choice(sorted(frontier))
+        mask[pick] = True
