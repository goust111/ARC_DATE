  "src": "edge-relative marker run s in a marked rectangle aligned with the plain rectangle row band",
  "dst": "run d in the plain rectangle crop",
  "match_cond": "s.nearest_edge_offsets == d.nearest_edge_offsets",
  "transform": "paint each matched d with the shared marker color; keep base rectangle fill elsewhere",
  "grid_shape": "same shape as the plain rectangle"
}
</annotation>
