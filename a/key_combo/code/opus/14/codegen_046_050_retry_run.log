+    colors = random.sample(SPRITE_COLORS, sprite_count_target)
+    used_color_idx = 0
+    occupied = set(seed_cells)
+    forbidden = _expanded(occupied, (h, w), radius=1)
+    sprite_cells = []
+    planned = []
+
+    for idx, event in enumerate(events):
+        advance = random.randint(2, 5)
