+            marker = (r0 - gap - 1, c0 + offset)
+        elif direction == (1, 0):
+            marker = (r1 + gap + 1, c0 + offset)
+        elif direction == (0, -1):
+            marker = (r0 + offset, c0 - gap - 1)
+        else:
+            marker = (r0 + offset, c1 + gap + 1)
