+                        if up_r < 0 or int(g[up_r, c]) == BLOCK:
+                            break
+                        nr = up_r
+                    if int(g[nr, c]) != BG:
+                        break
+                    r = nr
+                    out[r, c] = RAY
+                    spent += 1
+                    continue
+                if int(g[r, next_c]) != BG:
