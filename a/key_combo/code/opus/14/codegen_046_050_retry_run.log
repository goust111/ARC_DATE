+        coord=(r, c),
+        target=target,
+        frame_index=frame_index,
+        chosen_dir=chosen_dir,
+        min_dist=min_dist,
+        tie_dirs=tie_dirs,
+    )
+
+
+def _analyze_grid(grid: np.ndarray) -> tuple[list[Frame], list[ControlVote], Frame]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30
