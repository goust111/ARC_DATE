+                slots.add((nr, nc))
+    return sorted(slots)
+
+
+def _choose_slots(
+    candidates: list[tuple[int, int]],
+    count: int,
+    *,
+    reverse: bool,
+) -> list[tuple[int, int]] | None:
+    ordered = sorted(candidates, reverse=reverse)
+    chosen: list[tuple[int, int]] = []
+    for cell in ordered:
+        if all(abs(cell[0] - r) + abs(cell[1] - c) > 1 for r, c in chosen):
+            chosen.append(cell)
+            if len(chosen) == count:
+                return chosen
+    return None
