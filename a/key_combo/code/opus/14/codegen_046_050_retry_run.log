+_MODE_CYCLE = (
+    {"prefer_tie": "up", "winner_not_largest": True},
+    {"prefer_tie": "right", "winner_not_largest": False},
+    {"prefer_tie": "down", "winner_not_largest": True},
+    {"prefer_tie": None, "winner_not_largest": False},
+)
+_GEN_CALL_COUNT = 0
+_USED_OUTPUT_SHAPES: set[tuple[int, int]] = set()
+
