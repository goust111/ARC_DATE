+        middles_ok = all(degrees[cell] == 2 for cell in path_sub - endpoints)
+        if endpoints != {gate["parking"], far_end} or not middles_ok:
+            return info
+        q = deque([gate["parking"]])
+        seen = {gate["parking"]}
+        while q:
+            cell = q.popleft()
