+        if winner_not_largest:
+            max_other_area = (min(OTHER_SIDE_MAX, h - 4) - 2) * (min(OTHER_SIDE_MAX, w - 4) - 2)
+            choices = [shape for shape in choices if (shape[0] - 2) * (shape[1] - 2) < max_other_area]
