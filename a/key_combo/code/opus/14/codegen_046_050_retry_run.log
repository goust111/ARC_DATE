+def _palette_from_standard(patch: np.ndarray) -> tuple[int, int, int] | None:
+    if patch.shape[0] != patch.shape[1]:
+        return None
+    side = int(patch.shape[0])
+    palette: list[int | None] = [None, None, None]
+    for r in range(side):
+        for c in range(side):
