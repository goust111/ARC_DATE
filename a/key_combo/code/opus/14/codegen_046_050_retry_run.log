+        colors = random.sample(INPUT_COLORS, n_objects)
+        objects = []
+        ok = True
+        for slot_idx, color in zip(chosen_slots, colors):
+            obj = _sample_object_for_slot(random, slots[slot_idx], color)
+            if obj is None:
+                ok = False
+                break
