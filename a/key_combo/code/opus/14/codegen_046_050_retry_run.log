        return None

    grid = _build_sparse_grid(lattice)
    out = main(grid)
    if out.shape != EXPECTED_OUTPUT_SHAPE:
        return None
    return grid


def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 33067df9 input")

