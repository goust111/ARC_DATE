+    for r0, c0 in np.argwhere(g == CONTROL):
+        base_r, base_c = int(r0), int(c0)
+        left_budget, right_budget = _count_row_counters(g[base_r], base_c)
+        out[base_r, base_c] = RAY
+
+        for direction, budget in [(-1, left_budget), (1, right_budget)]:
+            r, c = base_r, base_c
+            spent = 0
+            while spent < budget:
