+        sc = 0 if tc == c else (1 if tc > c else -1)
+        if sr != 0 and sc != 0:
+            opts.append((r + sr, c + sc))
+        if sr != 0:
+            opts.append((r + sr, c))
+        if sc != 0:
+            opts.append((r, c + sc))
