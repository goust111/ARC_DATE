+    full_offsets: set[tuple[int, int]] = set()
+    for r, c in sprite_coords:
+        dr = int(r - anchor[0])
+        dc = int(c - anchor[1])
+        left_offsets.append((dr, dc))
+        local_c = int(c - sc0)
+        mirror_dc = int((2 * half_w - 1 - local_c) - anchor_local_c)
+        full_offsets.add((dr, dc))
+        full_offsets.add((dr, mirror_dc))
+
