_GEN_RED_WIN_MARGIN, _GEN_MIN_BLUE, _GEN_MAX_BLUE = 1, 1, 5
_GEN_TEAL_MARGIN, _GEN_PLACEMENT_PADDING, _GEN_PADDING_CONNECTIVITY = 1, 1, 8
_GEN_MAX_ATTEMPTS = 300


