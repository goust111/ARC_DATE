+import numpy as np
+
+
+BG = 0
+BLUE = 1
+SPRITE_COLORS = (2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 500
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _normalize(cells: set[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return frozenset((r - r0, c - c0) for r, c in cells)
+
+
+def _transform(cells: frozenset[tuple[int, int]], op: int) -> frozenset[tuple[int, int]]:
+    pts = []
+    for r, c in cells:
+        if op == 0:
+            rr, cc = r, c
+        elif op == 1:
+            rr, cc = r, -c
+        elif op == 2:
+            rr, cc = -r, c
+        elif op == 3:
+            rr, cc = -r, -c
+        elif op == 4:
+            rr, cc = c, r
+        elif op == 5:
+            rr, cc = c, -r
+        elif op == 6:
+            rr, cc = -c, r
+        else:
+            rr, cc = -c, -r
+        pts.append((rr, cc))
+    return _normalize(set(pts))
+
+
+def _all_variants(cells: frozenset[tuple[int, int]]) -> list[frozenset[tuple[int, int]]]:
+    seen = set()
+    out = []
+    for op in range(8):
+        variant = _transform(cells, op)
+        if variant not in seen:
+            seen.add(variant)
+            out.append(variant)
