+    out = np.array(restored, copy=True)
+    for container in containers:
+        box = container["box"]
+        direction = container["direction"]
+        tail_length = int(container["tail_length"])
+        grey_count = int(np.sum(container["patch"][1:-1, 1:-1] == GREY))
