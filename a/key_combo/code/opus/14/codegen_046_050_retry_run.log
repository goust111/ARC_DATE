+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+RANK_TO_DIR = {
+    1: (0, 1),
+    2: (1, 0),
+    3: (1, 1),
+}
+SIDES = ("top", "bottom", "left", "right")
