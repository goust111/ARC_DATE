+    axes = {("vertical" if _sightline_info(g, obj["marker"], obj["color"], BACKGROUND)[0][0] != 0 else "horizontal") for obj in objects}
+    assert len(axes) == 2, "each sample should include both horizontal and vertical sightlines"
