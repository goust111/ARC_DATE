+        grid[_diamond_outline(n, radius)] = DIAMOND_COLOR
+        grid[r0 : r0 + 2, c0 : c0 + 2] = block
+
+        try:
+            _validate_instance(grid, radius, top_left, block)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

