+                spec["outer"][1] + (depth - 1) * spec["dir"][1],
+            )
+            if not (0 <= dst[0] < shape[0] and 0 <= dst[1] < shape[1]):
+                continue
+            if dst in used_dst or dst in used_src or dst in all_borders:
+                continue
+            chosen[color] = {"corner": corner, "marker_spec": spec, "marker": src}
+            used_src.add(src)
+            used_dst.add(dst)
+            if backtrack(pos + 1):
+                return True
+            used_src.remove(src)
+            used_dst.remove(dst)
+            del chosen[color]
