    marked_top = {c0 + idx for idx in marked["top"]}
    marked_bottom = {c0 + idx for idx in marked["bottom"]}
    marked_left = {r0 + idx for idx in marked["left"]}
    marked_right = {r0 + idx for idx in marked["right"]}
