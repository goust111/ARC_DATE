# Grid, colors, and acceptance bounds.
GRID_HEIGHT, GRID_WIDTH = 15, 10
BACKGROUND_COLOR, COMPLETION_COLOR = 0, Color.BLUE
FOREGROUND_PALETTE = (2, 3, 4, 5, 6, 7, 8, 9)
OBSERVED_FOREGROUND_COLOR, OBSERVED_FOREGROUND_PROB = 8, 0.6
