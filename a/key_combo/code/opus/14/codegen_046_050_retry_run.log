+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        return [(r0 - step, c) for c in range(c0 + 1, c1)]
+    if side == "bottom":
+        return [(r1 + step, c) for c in range(c0 + 1, c1)]
+    if side == "left":
+        return [(r, c0 - step) for r in range(r0 + 1, r1)]
+    return [(r, c1 + step) for r in range(r0 + 1, r1)]
