+                    raise AssertionError("downward detour left the grid")
+                if int(grid[curr_r + 1, curr_c]) != BG or (curr_r + 1, curr_c) in reserved_path_cells:
+                    raise AssertionError("downward detour blocked during generation")
+            else:
