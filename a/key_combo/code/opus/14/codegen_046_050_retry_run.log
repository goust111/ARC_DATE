Ray = tuple[tuple[int, int], int, list[tuple[int, int]]]

CORNER_OFFSETS = {
    "NW": (-1, -1),
    "NE": (-1, 2),
    "SW": (2, -1),
    "SE": (2, 2),
}

DIAGONAL_DIRS = {
    "NW": (-1, -1),
    "NE": (-1, 1),
    "SW": (1, -1),
    "SE": (1, 1),
}

ROTATED_SOURCE = {
