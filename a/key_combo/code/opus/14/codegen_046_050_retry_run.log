+) -> int:
+    h, w = obstacle_mask.shape
+    r0, c0, r1, c1 = box
+    dr, dc = direction
+    boundary = {
+        (0, 1): w - 1 - c1,
+        (0, -1): c0,
+        (1, 0): h - 1 - r1,
+        (-1, 0): r0,
+    }[(dr, dc)]
