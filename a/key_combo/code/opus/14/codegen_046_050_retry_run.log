+        cols = sorted(c for _, c in coords)
+        assert len(rows) == 1, "legend entries must be horizontal segments"
+        row = next(iter(rows))
+        c0, c1 = cols[0], cols[-1]
+        assert len(coords) == c1 - c0 + 1, "legend segments must be contiguous"
+        color = int(grid[coords[0]])
+        comps.append(
