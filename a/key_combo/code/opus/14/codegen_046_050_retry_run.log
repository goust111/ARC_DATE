+    patterns = [
+        np.array([[3, 4], [4, 3]], dtype=int),
+        np.array([[4, 3], [3, 4]], dtype=int),
+        np.array([[3, 3], [4, 4]], dtype=int),
+        np.array([[4, 4], [3, 3]], dtype=int),
