+    out = g.copy()
+    for r in range(n):
+        for c in range(n):
+            if (r, c) == (ex_r, ex_c):
+                continue
+            orange_count = int(np.sum(_cell(g, row_spans, col_spans, r, c) == ORANGE))
+            if orange_count != 2:
+                continue
+            for dr, dc in dirs:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < n and 0 <= nc < n):
+                    continue
