+
+
+def _build_event_grid() -> tuple[np.ndarray, dict] | None:
+    h = random.randint(18, 24)
+    w = random.randint(18, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    outer, direction = _random_corner_and_dir(h, w)
