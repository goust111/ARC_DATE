        _gen_forbid_neighbors(available, r, c)
        available.discard(target)

    expected = _gen_expected_output(g, orientation, color_a, color_b, MARKER_COLOR)
    if expected is None:
        return None
    try:
        actual = main(g)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return g


def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        g = _gen_attempt()
        if g is not None:
            return g
