+def _rand_box(h: int, w: int, box_h: int, box_w: int) -> tuple[int, int, int, int]:
+    r0 = random.randint(0, h - box_h)
+    c0 = random.randint(0, w - box_w)
+    return r0, c0, r0 + box_h - 1, c0 + box_w - 1
+
+
+def _free_box(
+    shape: tuple[int, int],
+    box_h: int,
+    box_w: int,
+    forbidden: list[tuple[int, int, int, int]],
+    tries: int = 200,
