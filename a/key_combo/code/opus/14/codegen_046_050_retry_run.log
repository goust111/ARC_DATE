+        {
+            "active": True,
+            "marker": marker,
+            "gate_center": gate["center"],
+            "gate_ends": gate["gate_ends"],
+            "parking": gate["parking"],
+            "path_sub": path_sub,
+            "far_end": far_end,
+            "shape_kind": "elbow" if turn_count else "straight",
+        }
+    )
+    return info
+
+
+def _settled_scene(grid: np.ndarray) -> tuple[np.ndarray, list[dict[str, object]]]:
