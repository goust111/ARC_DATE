+        while 0 <= nr < n and 0 <= nc < n and int(out[nr, nc]) in bg_colors:
+            out[nr, nc] = int(color)
+            nr += dr
+            nc += dc
+
+    return out
+
+
+def _ray_length(grid: np.ndarray, start: tuple[int, int], direction: tuple[int, int], color: int) -> int:
+    n = grid.shape[0]
+    r, c = start
+    dr, dc = direction
+    length = 0
+    r += dr
+    c += dc
+    while 0 <= r < n and 0 <= c < n and int(grid[r, c]) == int(color):
+        length += 1
+        r += dr
+        c += dc
+    return length
+
