+            seeds[0],
+            set(region["boundary_positions"]),
+            pos_to_incidence,
+        )
+        for r, c in coords:
+            out[r, c] = fill_color
+        region["fill_color"] = fill_color
+        region["fill_mode"] = fill_mode
