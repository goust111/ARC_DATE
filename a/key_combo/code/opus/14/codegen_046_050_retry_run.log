+
+
+def _attempt() -> np.ndarray | None:
+    h = random.randint(3, 5)
+    w = random.randint(4, 6)
+    k = random.choice(SCALES)
+    m = random.randint(2, h - 1)
+    corner = random.choice(CORNERS)
+
+    template = _make_template(h, w, m, corner)
+    if template is None:
