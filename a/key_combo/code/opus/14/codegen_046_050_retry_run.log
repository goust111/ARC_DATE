    if _gen_randint(*GEN_ORIENTATION_RANGE) == GEN_TL_BR_ORIENTATION:
        left_c = _gen_randint(*GEN_LEFT_COLS)
        right_c = _gen_randint(max(GEN_RIGHT_COLS[0], left_c + GEN_MIN_SEP), GEN_RIGHT_COLS[1])
