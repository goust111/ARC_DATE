+    assert all(pink_cols[i + 1] == pink_cols[i] + 1 for i in range(len(pink_cols) - 1)), "pink marker must be contiguous"
+    t = len(pink_cols)
+
+    paths: list[dict] = []
+    coord_to_path: dict[tuple[int, int], int] = {}
+    for color in PATH_COLORS:
