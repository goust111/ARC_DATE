+            regs = [None, None, None]
+            regs[pivot] = (0, 0, top_h, w)
+            regs[a] = (top_h + 1, 0, h - top_h - 1, left_w)
+            regs[b] = (top_h + 1, left_w + 1, h - top_h - 1, w - left_w - 1)
+        else:
