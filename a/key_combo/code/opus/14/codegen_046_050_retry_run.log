+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return np.asarray(grid, dtype=int)
+    raise RuntimeError("failed to generate a valid enclosed-line flood-fill input")

