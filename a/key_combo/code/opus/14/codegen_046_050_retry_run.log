+
+    return h, w, [
+        (a_r0, a_c0, a_r0 + outer_h_a - 1, a_c0 + outer_w_a - 1),
+        (b_r0, b_c0, b_r0 + outer_h_b - 1, b_c0 + outer_w_b - 1),
+    ]
+
+
+def _sample_region_sizes(rng: np.random.Generator, region_count: int) -> list[tuple[int, int]]:
+    sizes = []
+    for _ in range(region_count):
+        if region_count == 1:
