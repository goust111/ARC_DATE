+            fill = int(rotated[i, j]) if valid else BG
+            rr0 = gr0 + line_rows[i] + 1
+            rr1 = gr0 + line_rows[i + 1]
+            cc0 = gc0 + line_cols[j] + 1
+            cc1 = gc0 + line_cols[j + 1]
+            out[rr0:rr1, cc0:cc1] = fill
