+def _render_input(
+    shape: tuple[int, int],
+    frames: dict[int, dict],
+    order: tuple[int, ...],
+) -> np.ndarray:
+    grid = np.full(shape, _BG, dtype=int)
+    for color in order:
+        _paint_frame(grid, frames[color]["bbox"], color)
+        grid[frames[color]["marker"]] = color
