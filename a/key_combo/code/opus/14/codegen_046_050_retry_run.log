+                int(grid_crop[line_rows[i], line_cols[j + 1]]),
+                int(grid_crop[line_rows[i + 1], line_cols[j]]),
+                int(grid_crop[line_rows[i + 1], line_cols[j + 1]]),
+            ]
+            valid = len(set(corners)) == 1 and corners[0] not in (BG, SEP)
+            valid_mask[i, j] = valid
