+import numpy as np
+
+
+PALETTE = (1, 2, 3, 4, 6, 7)
+SIDES = ("top", "bottom", "left", "right")
+GRID_BOUNDS = (18, 22)
+OBJECT_COUNT_RANGE = (2, 3)
+MIN_OBJECT_GAP = 5
+GENERATE_ATTEMPTS = 600
