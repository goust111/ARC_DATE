+def _make_template(h: int, w: int, m: int, corner: str) -> np.ndarray | None:
+    for _ in range(120):
+        mask = _grow_mask(h, w, m, corner)
+        if mask is None:
+            continue
+        template = _colorize(mask)
+        if _template_ok(template, m, corner):
