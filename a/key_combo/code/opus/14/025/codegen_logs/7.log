def _gen_triangle_mask(shape, corner, side):
    H, W = shape
    rr, cc = np.indices((H, W))
    if corner == "TL":
        return rr + cc < side
    if corner == "TR":
        return rr + (W - 1 - cc) < side
    if corner == "BL":
