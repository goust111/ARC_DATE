    ne_sum = sum(ne_lengths)
    if nw_sum == ne_sum:
        _break_equal_orientation_lengths(nw_lengths, ne_lengths, sum(lengths))

    specs = [(NW_SE, length) for length in nw_lengths]
    specs.extend((NE_SW, length) for length in ne_lengths)
