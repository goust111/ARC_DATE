+def _find_components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    components: list[dict[str, object]] = []
+
+    for r0 in range(H):
+        for c0 in range(W):
+            if seen[r0, c0] or int(g[r0, c0]) == bg:
