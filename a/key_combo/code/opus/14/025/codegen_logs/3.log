+    h = left_visible.shape[0]
+    grid = np.full((h, INPUT_WIDTH), BACKGROUND, dtype=int)
+    grid[:, PANEL_WIDTH] = SEPARATOR_COLOR
+    grid[:, :PANEL_WIDTH][left_visible] = LEFT_COLOR
+    grid[:, PANEL_WIDTH + 1 :][right_visible] = RIGHT_COLOR
+    return grid
+
+
