+    colors = [winner_color]
+    alt_colors = [color for color in MARKER_COLORS if color != winner_color]
+    colors.append(random.choice(alt_colors))
+    while len(colors) < len(chosen):
+        colors.append(random.choice(MARKER_COLORS))
