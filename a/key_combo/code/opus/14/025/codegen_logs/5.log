    assignments = _gen_assign_colors(cells, counts)
    if assignments is None:
        return None
    for (r, c), color in assignments.items():
        grid[r, c] = color

    if not np.array_equal(main(grid), _gen_expected_output(grid, marker_color)):
        return None
    return grid


