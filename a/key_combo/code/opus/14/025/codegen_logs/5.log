+    ranked = sorted(
+        candidates,
+        key=lambda item: (
+            int(item["distance"]),
+            0 if item["kind"] == "row" else 1,
+            tuple(item["cell"]),
+        ),
+    )
+    best = ranked[0]
+    best_key = (
+        int(best["distance"]),
+        0 if best["kind"] == "row" else 1,
