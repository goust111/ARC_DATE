+    placements = []
+    for item, color in zip(chosen, colors):
+        placements.append(
+            {
+                "cell": tuple(item["cell"]),
+                "kind": str(item["kind"]),
+                "distance": int(item["distance"]),
+                "color": int(color),
+            }
+        )
