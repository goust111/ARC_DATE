spec:
  grid: 10x10 [observed]
  input_colors: exactly {0 (black), 1 (blue), 3 (green)}
  output_colors: exactly {1, 2 (red), 3, 5 (grey)} — no black remains
  barrier:
    composition: blue(1) + green(3) pixels scattered across grid, 54-65% of cells
    both colors present in nearly every row and column [observed]
    blue_pixels: 24-36; green_pixels: 23-39
    4-connected barrier components: 3-10; largest typically >=24
  black_regions:
