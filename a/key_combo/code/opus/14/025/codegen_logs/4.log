+    for c in range(0, w, tile_w + 1):
+        grid[:, c] = SEP
+    return grid
+
+
+def _place_template(grid: np.ndarray, tile: tuple[int, int], patch: np.ndarray, tile_h: int, tile_w: int) -> None:
+    r0, c0, r1, c1 = _tile_bounds(tile, tile_h, tile_w)
+    grid[r0 : r1 + 1, c0 : c1 + 1] = patch
