+def _shortest_path(
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    rows: int,
+    cols: int,
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    queue = deque([start])
+    prev = {start: None}
+    while queue:
+        tile = queue.popleft()
+        if tile == goal:
+            path = []
+            cur = tile
+            while cur is not None:
+                path.append(cur)
+                cur = prev[cur]
+            return list(reversed(path))
+        for nxt in _tile_neighbors(tile, rows, cols):
+            if nxt in blocked or nxt in prev:
+                continue
+            prev[nxt] = tile
+            queue.append(nxt)
