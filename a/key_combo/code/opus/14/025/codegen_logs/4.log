+def _tile_bounds(tile: tuple[int, int], tile_h: int, tile_w: int) -> tuple[int, int, int, int]:
+    tr, tc = tile
+    r0 = 1 + tr * (tile_h + 1)
+    c0 = 1 + tc * (tile_w + 1)
