+        if not (
+            np.all(inp[r0 - 1, c0 : c1 + 1] == SEP)
+            and np.all(inp[r1 + 1, c0 : c1 + 1] == SEP)
+            and np.all(inp[r0 : r1 + 1, c0 - 1] == SEP)
+            and np.all(inp[r0 : r1 + 1, c1 + 1] == SEP)
+        ):
