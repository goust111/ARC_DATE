+def _choose_closed_pair(
+    rows: int,
+    cols: int,
+    template_tile: tuple[int, int],
+    forbidden: set[tuple[int, int]],
+    rng: random.Random,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    candidates = []
+    for r in range(rows):
+        for c in range(cols):
+            tile = (r, c)
+            if tile == template_tile or tile in forbidden:
+                continue
+            for nxt in _tile_neighbors(tile, rows, cols):
