+def _tile_spans(separators: list[int]) -> list[tuple[int, int]]:
+    spans = []
+    for a, b in zip(separators, separators[1:]):
+        assert b - a > 1, "separator rows/cols must leave non-empty tile interiors"
+        spans.append((a + 1, b - 1))
+    return spans
