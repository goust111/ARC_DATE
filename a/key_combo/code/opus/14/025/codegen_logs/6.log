+        return None
+
+    used_columns = set()
+    pocket_candidates = [c for c in open_columns if all(abs(c - u) >= 2 for u in used_columns)]
+    if len(pocket_candidates) < 1:
+        return None
+
+    open_choice = random.choice(pocket_candidates)
