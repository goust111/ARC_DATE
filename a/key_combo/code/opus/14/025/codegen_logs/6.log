+def _paint_obstacles(grid: np.ndarray, obstacle_mask: np.ndarray) -> None:
+    rows, cols = np.nonzero(obstacle_mask)
+    for r, c in zip(rows.tolist(), cols.tolist()):
+        grid[r, c] = PINK if (r + 2 * c) % 3 else MAROON
