+def _basin_mask(grid: np.ndarray, separator_row: int) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = grid.shape
+    lower = grid[separator_row + 1 :] == BLACK
+    comps = _components_mask(lower)
+    basin = np.zeros((h, w), dtype=bool)
