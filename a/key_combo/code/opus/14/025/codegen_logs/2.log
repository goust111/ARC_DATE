+
+    if count == 3:
+        g = gap()
+        if mode == "row":
+            singleton_c = random.randint(1, g)
+            return {(0, 0), (0, g + 1), (2, singleton_c)}
+        if mode == "col":
+            singleton_r = random.randint(1, g)
+            return {(0, 0), (g + 1, 0), (singleton_r, 2)}
