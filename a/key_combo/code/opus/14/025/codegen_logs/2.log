+def _line_pattern(count: int, mode: str) -> set[tuple[int, int]]:
+    gap = lambda: random.randint(2, 5)
+
+    if count == 2:
+        g = gap()
+        if mode == "row":
+            return {(0, 0), (0, g + 1)}
+        if mode == "col":
+            return {(0, 0), (g + 1, 0)}
