+            moved_pattern = _translate(pattern, _bbox(placed_footprint)[0] - min(r for r, _ in pattern), _bbox(placed_footprint)[1] - min(c for _, c in pattern))
+            if moved_pattern != placed_footprint & moved_pattern | moved_pattern:
+                pass
+            if len(moved_pattern) != count:
