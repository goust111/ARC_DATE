+
+
+def _wrong_swapped_axes(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    nw_pixels, ne_pixels = _classify_pixels(grid)
+    out = np.full_like(grid, BG)
+    by_row_nw: dict[int, list[int]] = defaultdict(list)
