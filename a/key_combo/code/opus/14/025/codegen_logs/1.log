+            start = h - len(rows)
+            for offset, _r in enumerate(rows):
+                rr = start + offset
+                if out[rr, c] != BG:
+                    return out
+                out[rr, c] = color
+    return out
+
+
+def _wrong_all_horizontal(grid: np.ndarray) -> np.ndarray:
+    _h, w = grid.shape
+    nw_pixels, ne_pixels = _classify_pixels(grid)
+    out = np.full_like(grid, BG)
+    groups = ((nw_pixels, NW_COLOR), (ne_pixels, NE_COLOR))
