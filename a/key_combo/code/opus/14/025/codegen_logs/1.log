+def _classify_pixels(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    """Split every foreground pixel into the unique diagonal orientation it belongs to."""
+    h, w = grid.shape
+    fg = grid == FG
