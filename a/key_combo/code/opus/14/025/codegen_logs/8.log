+        out_tile = actual[r0 : r1 + 1, c0 : c1 + 1]
+        want = np.rot90(template, CORNER_TO_ROT[marker["corner"]])
+        assert np.array_equal(out_tile, want), "marker tiles must receive the correctly rotated template"
