+        grid = _build_grid(
+            tile_rows=tile_rows,
+            tile_cols=tile_cols,
+            template=template,
+            template_positions=template_positions,
+            marker_assignments=marker_assignments,
+            distractor_tiles=distractor_tiles,
+        )
