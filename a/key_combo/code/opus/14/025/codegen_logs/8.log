+
+def _random_connected_mask(rng: np.random.Generator, cells: int) -> np.ndarray:
+    mask = np.zeros((TILE_SIZE, TILE_SIZE), dtype=bool)
+    start = tuple(int(x) for x in rng.integers(0, TILE_SIZE, size=2))
