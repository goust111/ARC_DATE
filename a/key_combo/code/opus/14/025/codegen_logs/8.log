+        for r, c in np.argwhere(mask):
+            for dr, dc in NEIGHBORS4:
+                nr, nc = int(r + dr), int(c + dc)
+                if 0 <= nr < TILE_SIZE and 0 <= nc < TILE_SIZE and not mask[nr, nc]:
