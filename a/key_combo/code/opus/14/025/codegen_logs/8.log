  grid: 10-15 rows x 13-15 cols, background=0
  sprites:
    count: 4-6 separated 4-connected multicolor foreground sprites
    bbox_size: 2-5 rows x 2-4 cols per sprite
    fg_cells: 5-9 per sprite (bbox contains bg holes)
    colors_per_sprite: 2-4 distinct non-bg colors
    separation: min Manhattan distance >= 2 between any two sprites
  duplication:
