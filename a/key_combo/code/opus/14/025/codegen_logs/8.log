  "type": "move_to_match",
  "src": "3x3 sprite corner s with a singleton marker diagonally outside it",
  "dst": "sprite corner d touched by the missing corner of the three-marker square",
  "match_cond": "the singleton-marked corner s maps to the missing-corner target d",
  "transform": "rotate the sprite in place by the unique quarter-turn mapping s to d; clear all four markers and paint one marker at the three-marker square center",
  "symbol_instructions": "marker pixels encode source and target sprite corners"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10-12 rows x 10-11 cols, background 0
  sprite:
    size: 3x3, fully filled (no background pixels)
    colors: exactly 2 distinct non-bg non-marker colors [observed always 1 and 8]
    color_split: 3-6 pixels of one color, remainder of the other
    asymmetry: must NOT be invariant under any rot90 k=1,2,3
    position: centered with margins >=3 on all sides
  markers:
    count: 4 singleton pixels, all same color, distinct from bg and sprite colors [observed always 4/yellow]
    L-group: 3 markers forming an L at 3 corners of a 2x2 square centered 1 cell diag-outside the dst sprite corner; the 4th square corner is the dst sprite corner itself
    singleton: 1 marker at the cell 1 diag-outside the src sprite corner
    src != dst corner; rotation steps 1-3 (no identity) [observed]
  output:
    sprite rotated in-place by the unique quarter-turn mapping src corner to dst corner
    all 4 input markers removed
    1 marker pixel placed at the center of the L-group's 2x2 square
generation_strategy:
  approach: output-first
  steps:
    - Pick grid size 10-12 x 10-11
    - Choose 3 distinct non-bg colors for sprite_c1, sprite_c2, marker_color
    - Build a 3x3 sprite patch with sprite_c1 and sprite_c2, no bg, verify it is asymmetric under all rot90 k=1,2,3
    - Pick src_corner and dst_corner (two distinct corners from NW/NE/SW/SE)
    - Compute rotation k that maps src to dst; the OUTPUT sprite is the patch as-is
    - Compute the INPUT sprite as rot90(patch, 4-k) (inverse rotation)
    - Place sprite so all margins >= 3 (need >=2 for L-group side, >=1 for singleton, but use >=3 for safety)
    - Place L-group 3 markers around dst corner of the INPUT sprite position
    - Place singleton marker at diag-outside of src corner of the INPUT sprite position
    - Verify all 4 markers and sprite are within bounds and on background
