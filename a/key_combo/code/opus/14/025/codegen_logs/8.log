+        r0, c0 = _tile_origin(tr, tc)
+        grid[r0 : r0 + TILE_SIZE, c0 : c0 + TILE_SIZE] = tile
+    for (tr, tc), corner in marker_assignments.items():
+        r0, c0 = _tile_origin(tr, tc)
+        rr, cc = CORNER_TO_COORD[corner]
+        grid[r0 + rr, c0 + cc] = GREY
+    return grid
