+        r0, r1, c0, c1 = sprite["bounds"]
+        if sprite["key"] == parsed["template_key"]:
+            out[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+    for marker in parsed["markers"]:
+        r0, r1, c0, c1 = marker["bounds"]
