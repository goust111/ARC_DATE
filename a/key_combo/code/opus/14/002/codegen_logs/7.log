+    template, _origin = _find_template(g)
+    filled = _scan_fill(g)
+    out = filled.copy()
+
+    rotations = [np.rot90(template, -k) for k in range(4)]
+    for coords in sorted(_components_of_color(filled, RED), key=lambda arr: tuple(arr.min(axis=0))):
