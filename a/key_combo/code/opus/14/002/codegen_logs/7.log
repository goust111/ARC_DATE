+        found_shapes.append((bbox[2] - bbox[0] + 1, bbox[3] - bbox[1] + 1))
+    if unmatched:
+        return None
+
+    if template_shape not in found_shapes or (template_shape[1], template_shape[0]) not in found_shapes:
