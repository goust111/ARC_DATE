+                "color": color,
+                "bbox": box,
+                "scale": int(scales[idx]),
+            }
+        )
+
+    if _get_bg(inp) != 0:
+        return None
+
+    expected = _render_expected_output(inp, template, frame_records, bg=0)
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
