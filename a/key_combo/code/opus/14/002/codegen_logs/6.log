    for r, c in coords:
        children[(r, c)] = [(r + 1, c + dc) for dc in DIAGONAL_DIRECTIONS if (r + 1, c + dc) in coords]
        parents[(r, c)] = [(r - 1, c + dc) for dc in DIAGONAL_DIRECTIONS if (r - 1, c + dc) in coords]

