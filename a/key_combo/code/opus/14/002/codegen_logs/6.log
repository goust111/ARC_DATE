    seen_edges = set()
    for p in sorted(coords):
        for ch in sorted(children[p]):
            edge = (p, ch)
            if edge in seen_edges:
                continue
            direction = ch[1] - p[1]
            start = len(parents[p]) != 1 or len(children[p]) != 1
            if not start and parents[p]:
                start = p[1] - parents[p][0][1] != direction
