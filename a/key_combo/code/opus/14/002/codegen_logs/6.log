+    col_margin = 1 if c1 - c0 + 1 >= 3 else 0
+    rr0, rr1 = r0 + row_margin, r1 - row_margin
+    cc0, cc1 = c0 + col_margin, c1 - col_margin
+    if rr0 > rr1:
+        rr0, rr1 = r0, r1
+    if cc0 > cc1:
