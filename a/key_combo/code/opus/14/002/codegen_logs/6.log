+GREY = 5
+MAGENTA = 6
+PALETTE = (1, 2, 3, 4, 7, 8, 9)
+GEN_RETRIES = 400
+ORTH_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
