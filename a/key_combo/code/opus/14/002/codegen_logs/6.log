            seen_edges.add(edge)
            cur = ch
            while len(parents[cur]) == 1 and len(children[cur]) == 1:
                nxt = children[cur][0]
                if nxt[1] - cur[1] != direction:
                    break
                seen_edges.add((cur, nxt))
                seg.append(nxt)
                cur = nxt
