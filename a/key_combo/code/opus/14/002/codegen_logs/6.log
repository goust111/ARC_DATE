+    h, w = mask.shape
+    q = deque([start])
+    labels[start] = label
+    comp = [start]
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if mask[nr, nc] and labels[nr, nc] < 0:
