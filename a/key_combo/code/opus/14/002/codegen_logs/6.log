+        for j in range(i + 1, len(rects)):
+            br0, br1, bc0, bc1 = rects[j]
+            if ac1 + 2 == bc0 or bc1 + 2 == ac0:
+                overlap = min(ar1, br1) - max(ar0, br0) + 1
+                if overlap > 0:
