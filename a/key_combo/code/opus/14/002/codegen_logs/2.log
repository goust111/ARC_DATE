    for (r, c), color in assignments.items():
        grid[r, c] = color

    if not np.array_equal(main(grid), _gen_expected_output(grid, marker_color)):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
