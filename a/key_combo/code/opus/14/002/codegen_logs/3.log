+        if len(usable_cells) < MIN_REGION_SIZE or len(region) < MIN_REGION_SIZE:
+            continue
+
+        scored = sorted(
+            ((cell, _cell_score(cell, region, normal_ray.shape)) for cell in usable_cells),
+            key=lambda item: (item[1], item[0][0], item[0][1]),
+            reverse=True,
+        )
