+    assert out[r0, c0] == BG, "marker must start in a background cell after ray casting"
+
+    q = deque([(r0, c0)])
+    out[r0, c0] = color
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ORTH_DIRS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1] and out[nr, nc] == BG:
+                out[nr, nc] = color
+                q.append((nr, nc))
