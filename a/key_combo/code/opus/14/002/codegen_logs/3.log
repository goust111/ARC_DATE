+            if rev_label == -1:
+                best_sensitive = (cell, score)
+                region_changed = True
+                break
+            if reverse_regions[rev_label] != region:
+                best_sensitive = (cell, score)
+                region_changed = True
+                break
+
+        chosen_cell, chosen_score = best_sensitive if best_sensitive is not None else best_any
+        records.append(
+            {
+                "label": idx,
+                "region": region,
+                "size": len(region),
+                "cell": chosen_cell,
+                "score": chosen_score,
+                "sensitive": region_changed,
+            }
+        )
