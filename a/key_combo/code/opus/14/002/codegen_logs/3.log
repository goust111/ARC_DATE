    # create a 9x9 grid of black (0)
    grid = np.zeros((9, 9), dtype=int)
    # sparsely populate it with gray
    for r in range(9):
        for c in range(9):
            if np.random.random() < 0.05:
                grid[r, c] = Color.GRAY
    return grid
