+        best_sensitive: tuple[tuple[int, int], int] | None = None
+        region_changed = False
+        for cell, score in scored:
+            r, c = cell
+            if reverse_ray[r, c] != BG:
+                best_sensitive = (cell, score)
+                region_changed = True
+                break
