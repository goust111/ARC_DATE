+        colors = random.sample(MARKER_COLORS, marker_counts[quadrant])
+        fills[quadrant] = list(zip(markers, colors))
+        q_r0, q_c0 = _quadrant_origin(quadrant, qh, qw)
+        for (mr, mc), color in fills[quadrant]:
