+import numpy as np
+
+
+BLUE = 1
+MARKER_COLORS = (2, 3, 4, 6, 7)
+MAX_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _enclosed_hole_mask(sprite: np.ndarray) -> np.ndarray:
+    hole_mask = np.zeros_like(sprite, dtype=bool)
+    for comp in _components(sprite == 0):
+        if any(r == 0 or c == 0 or r == sprite.shape[0] - 1 or c == sprite.shape[1] - 1 for r, c in comp):
+            continue
+        for r, c in comp:
+            hole_mask[r, c] = True
+    return hole_mask
+
+
+def _transform(sprite: np.ndarray, quadrant: str) -> np.ndarray:
+    if quadrant == "tr":
+        return np.fliplr(sprite)
+    if quadrant == "bl":
+        return np.flipud(sprite)
+    if quadrant == "br":
+        return np.flipud(np.fliplr(sprite))
+    raise ValueError(f"unknown quadrant {quadrant}")
