+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _parse_markers(grid: np.ndarray) -> list[tuple[int, int]]:
+    markers = [tuple(map(int, rc)) for rc in np.argwhere(grid == GREY)]
