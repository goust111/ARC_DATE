+    return [mask0, mask1, mask2]
+
+
+def _mandatory_variant(full_mask: np.ndarray, variant: str) -> np.ndarray | None:
+    mask = full_mask.copy()
+    if variant in {"drop_bottom", "drop_both"}:
+        mask[-1, :] = False
+    if variant in {"drop_right", "drop_both"}:
