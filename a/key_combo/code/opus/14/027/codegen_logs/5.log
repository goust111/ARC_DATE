+    largest_w = random.randint(*LARGEST_DIM_RANGE)
+    bbox_area = largest_h * largest_w
+
+    area0_lo = max(largest_h + largest_w - 1, int(np.ceil(0.62 * bbox_area)))
+    area0_hi = int(np.floor(0.74 * bbox_area))
