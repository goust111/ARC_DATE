+    low, high = _target_area_bounds(full_area, copy_count, strong_damage)
+    targets = []
+    for partial in partials:
+        current_area = int(partial.sum())
+        lo = min(max(low, 1), current_area - 1)
+        hi = min(high, current_area - 1)
