+    visible1 = padded[1] & ~padded[2]
+    visible2 = padded[2]
+    return visible0, visible1, visible2
+
+
+def _place_objects(objects: list[dict]) -> np.ndarray | None:
+    total_bbox_area = sum(obj["mask"].shape[0] * obj["mask"].shape[1] for obj in objects)
+    for _ in range(60):
