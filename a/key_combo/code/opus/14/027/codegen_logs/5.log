+
+def _generate_connected_mask(h: int, w: int, target_area: int) -> np.ndarray | None:
+    min_area = h + w - 1
+    if target_area < min_area or target_area > h * w:
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    r = c = 0
+    mask[r, c] = True
+    steps = ["D"] * (h - 1) + ["R"] * (w - 1)
+    random.shuffle(steps)
+    for step in steps:
+        if step == "D":
+            r += 1
+        else:
+            c += 1
+        mask[r, c] = True
+
+    while int(mask.sum()) < target_area:
+        frontier = _frontier(mask)
+        if not frontier:
+            return None
+        rr, cc = random.choice(frontier)
+        mask[rr, cc] = True
+
+    if (
+        mask[0, 0]
+        and mask[-1].any()
+        and mask[:, -1].any()
+        and mask[-1, :-1].any()
+        and mask[:-1, -1].any()
+        and _is_connected(mask)
+    ):
+        return mask
+    return None
+
+
+def _choose_full_masks() -> list[np.ndarray] | None:
