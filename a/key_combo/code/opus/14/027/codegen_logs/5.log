+
+
+def _choose_variants(copy_count: int, strong_damage: bool) -> list[str]:
+    if strong_damage and copy_count == 2:
+        return random.choice([["drop_bottom", "keep"], ["drop_right", "keep"]])
+    if copy_count == 2:
+        return random.choice(
