+def _frontier(mask: np.ndarray) -> list[Coord]:
+    h, w = mask.shape
+    cells = set()
+    for r, c in np.argwhere(mask):
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                cells.add((int(nr), int(nc)))
+    return list(cells)
