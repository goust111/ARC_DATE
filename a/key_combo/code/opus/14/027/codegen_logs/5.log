+        return ["drop_bottom", "drop_right"]
+    if copy_count == 2:
+        return random.choice(
+            [
+                ["drop_bottom", "drop_right"],
+                ["drop_both", "keep"],
+                ["drop_bottom", "keep"],
+                ["drop_right", "keep"],
