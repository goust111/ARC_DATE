+            return None
+        targets.append(random.randint(lo, hi))
+
+    order = list(range(copy_count))
+    random.shuffle(order)
+    for idx in order:
+        mask = partials[idx]
+        target = targets[idx]
+        attempts = 0
+        while int(mask.sum()) > target and attempts < 200:
+            attempts += 1
+            candidates = [
+                tuple(map(int, rc))
+                for rc in np.argwhere(mask)
+                if tuple(map(int, rc)) not in protect[idx] and coverage[tuple(map(int, rc))] > 1
+            ]
+            if not candidates:
+                break
+            random.shuffle(candidates)
+            removed = False
+            for cell in candidates:
+                trial = mask.copy()
+                trial[cell] = False
+                if not _valid_partial(trial):
+                    continue
+                mask = trial
+                partials[idx] = mask
+                coverage[cell] -= 1
+                removed = True
+                break
