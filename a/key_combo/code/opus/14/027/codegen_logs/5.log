+            return False
+        if not np.array_equal(group["mask"], expected_mask):
+            return False
+        if group["area"] != int(expected_mask.sum()):
+            return False
+        shapes = [partial.shape for partial in group["partials"]]
+        if len(set(shapes)) > 1:
