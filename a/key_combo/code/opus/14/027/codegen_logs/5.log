+    colors = sorted(set(map(int, np.unique(g))) - {bg})
+    assert colors
+
+    groups = [_group_info(g, color) for color in colors]
+    areas = [group["area"] for group in groups]
+    assert len(set(areas)) == len(areas), "recovered sprite areas must be distinct"
