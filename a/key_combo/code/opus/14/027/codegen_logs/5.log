+
+def _render_stack_masks(masks: list[np.ndarray]) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    largest_h, largest_w = masks[0].shape
+    padded = []
+    for mask in masks:
+        canvas = np.zeros((largest_h, largest_w), dtype=bool)
+        h, w = mask.shape
+        canvas[:h, :w] = mask
+        padded.append(canvas)
