+                c0 = random.randint(0, width - w)
+                box = (r0, c0, r0 + h - 1, c0 + w - 1)
+                if any(
+                    not (
+                        box[2] + 1 < other[0]
+                        or other[2] + 1 < box[0]
+                        or box[3] + 1 < other[1]
+                        or other[3] + 1 < box[1]
+                    )
+                    for other in placed_boxes
+                ):
+                    continue
