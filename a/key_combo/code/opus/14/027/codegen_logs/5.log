+    max_w = max(partial.shape[1] for partial in partials)
+    restored = np.zeros((max_h, max_w), dtype=bool)
+    for partial in partials:
+        h, w = partial.shape
+        restored[:h, :w] |= partial
+
+    return {
+        "color": int(color),
+        "partials": partials,
+        "mask": restored,
+        "area": int(restored.sum()),
+        "visible": int(mask.sum()),
