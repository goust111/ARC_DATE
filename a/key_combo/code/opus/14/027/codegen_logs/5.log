+
+    area0 = random.randint(area0_lo, area0_hi)
+    area1 = random.randint(area1_lo, min(area1_hi, area0 - 2))
+
+    dim2_choices = []
+    for h2 in range(SMALLER_DIM_MIN, largest_h + 1):
