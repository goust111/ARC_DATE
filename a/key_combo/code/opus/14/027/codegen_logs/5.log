+    partials: list[np.ndarray] = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        partials.append(local)
