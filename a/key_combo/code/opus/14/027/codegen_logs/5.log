+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+GEN_RETRY_LIMIT = 500
+GRID_SIDE_MIN = 18
+GRID_SIDE_MAX = 24
+LARGEST_DIM_RANGE = (6, 8)
+SMALLER_DIM_MIN = 4
