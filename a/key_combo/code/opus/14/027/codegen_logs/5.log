+    mask[r, c] = True
+    steps = ["D"] * (h - 1) + ["R"] * (w - 1)
+    random.shuffle(steps)
+    for step in steps:
+        if step == "D":
+            r += 1
+        else:
+            c += 1
+        mask[r, c] = True
