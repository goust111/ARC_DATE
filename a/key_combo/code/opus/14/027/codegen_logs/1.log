/bin/bash -lc "python - <<'PY'
import numpy as np
BLACK=0
GREY=5
PALETTE=[1,2,3,4,6,7,8,9]

def distinct_scan(vals):
    out=[]
    for v in vals:
        if not out or out[-1]"'!=v:
            out.append(int(v))
    return out

def main(grid):
    g=np.asarray(grid,dtype=int)
    H,W=g.shape
    color_coords=np.argwhere((g!=BLACK)&(g!=GREY))
    assert color_coords.size>0
    rows=np.unique(color_coords[:,0]); cols=np.sort(color_coords[:,1])
    assert len(rows)==1
    r=int(rows[0])
    assert r in (0,H-1)
    assert np.array_equal(cols, np.arange(cols[0], cols[-1]+1))
    assert cols[0]==0 or cols[-1]==W-1
    guide=[int(g[r,c]) for c in cols]
    assert len(guide)==len(set(guide))
    work=g.copy(); work[color_coords[:,0], color_coords[:,1]]=BLACK
    mask=work==GREY
    row_ids=np.where(mask.any(axis=1))[0]
    col_ids=np.where(mask.any(axis=0))[0]
    left=[]; right=[]
    for rr in row_ids:
        cs=np.where(mask[rr])[0]
        assert np.array_equal(cs, np.arange(cs[0], cs[-1]+1))
        left.append(int(cs[0])); right.append(int(cs[-1]))
    top=[]; bottom=[]
    for cc in col_ids:
        rs=np.where(mask[:,cc])[0]
        assert np.array_equal(rs, np.arange(rs[0], rs[-1]+1))
        top.append(int(rs[0])); bottom.append(int(rs[-1]))
    for seq in (left,right,top,bottom):
        assert all(seq[i] <= seq[i+1] for i in range(len(seq)-1))
    tops=distinct_scan(top); lefts=distinct_scan(left); bottoms=distinct_scan(bottom); rights=distinct_scan(right)
    n=len(guide)
    assert len(tops)==len(lefts)==len(bottoms)==len(rights)==n
    counts=np.zeros_like(g)
    recon=np.zeros_like(mask)
    rects=[]
    for i in range(n):
        r0,c0,r1,c1=tops[i],lefts[i],bottoms[i],rights[i]
        assert r1-r0+1>=2 and c1-c0+1>=2
        counts[r0:r1+1,c0:c1+1]+=1
        recon[r0:r1+1,c0:c1+1]=True
        rects.append((r0,c0,r1,c1))
    assert np.array_equal(recon, mask)
    assert counts.max()==n
    assert set(np.unique(counts[mask]))==set(range(1,n+1))
    out=np.zeros_like(g)
    for d,color in enumerate(guide, start=1):
        out[counts==d]=color
    return out, rects, counts

def gen():
    rng=np.random.default_rng()
    for _ in range(1000):
        H=int(rng.integers(13,19)); W=int(rng.integers(13,19)); n=int(rng.integers(3,6))
        def sample_offsets():
            for _ in range(200):
                a=sorted(rng.choice(np.arange(0,6), size=n, replace=False).tolist(), reverse=True)
                b=sorted(rng.choice(np.arange(0,6), size=n, replace=False).tolist())
                if all(1 <= a[i]+b[i]+1 <= 6 for i in range(n)):
                    return a,b
            return None
        v=sample_offsets(); h=sample_offsets()
        if v is None or h is None:
            continue
        up,down=v; left,right=h
        min_r=1+max(up); max_r=H-2-max(down)
        min_c=1+max(left); max_c=W-2-max(right)
        if min_r>max_r or min_c>max_c:
            continue
        cr=int(rng.integers(min_r,max_r+1)); cc=int(rng.integers(min_c,max_c+1))
        rects=[]
        for i in range(n):
            rects.append((cr-up[i], cc-left[i], cr+down[i], cc+right[i]))
        grid=np.zeros((H,W),dtype=int)
        for r0,c0,r1,c1 in rects:
            grid[r0:r1+1,c0:c1+1]=GREY
        colors=rng.choice(np.array(PALETTE), size=n, replace=False).tolist()
        corner=int(rng.integers(4))
        if corner==0:
            grid[0,:n]=colors
        elif corner==1:
            grid[0,W-n:W]=colors
        elif corner==2:
            grid[H-1,:n]=colors
        else:
            grid[H-1,W-n:W]=colors
        out, rr, counts = main(grid)
        # Expected
        exp=np.zeros_like(grid)
        pure=np.zeros_like(grid)
        for r0,c0,r1,c1 in rects:
            pure[r0:r1+1,c0:c1+1]+=1
        if pure.max()!=n or set(np.unique(pure[pure>0]))!=set(range(1,n+1)):
            continue
        for d,color in enumerate(colors, start=1):
            exp[pure==d]=color
        if not np.array_equal(out, exp):
