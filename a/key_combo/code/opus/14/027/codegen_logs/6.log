+def _find_separator(grid: np.ndarray) -> int:
+    sep_cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == SEP)]
+    assert len(sep_cols) == 1, "expected exactly one grey separator column"
+    return int(sep_cols[0])
