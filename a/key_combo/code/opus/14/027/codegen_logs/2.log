+        axis_value = (r0 + r1) / 2.0
+        assert opening in {"up", "down"}, "column-band grey is only valid for vertical-opening cups"
+        if opening == "up":
+            assert gr < r0, "up-opening cup must have grey pixel on its mouth side"
+        else:
