+        [pair[0] for pair in OBJECT_COUNT_WEIGHTS],
+        weights=[pair[1] for pair in OBJECT_COUNT_WEIGHTS],
+        k=1,
+    )[0]
+
+    specs = [{"control": BLUE, "mode": "stop"}, {"control": MAROON, "mode": "pass"}]
+    if object_count == 3:
