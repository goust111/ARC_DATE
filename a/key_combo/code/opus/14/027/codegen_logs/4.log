            rr = r + dr
            cc = c + dc
            if 0 <= rr < n and 0 <= cc < n and occupied[rr, cc]:
                return True
    return False


def _marker_candidates(n: int, occupied: np.ndarray, mover_cols: set[int]) -> dict[int, list[tuple[np.ndarray, int, int]]]:
    by_area: dict[int, list[tuple[np.ndarray, int, int]]] = {}
