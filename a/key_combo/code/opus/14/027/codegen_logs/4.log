+def _place_extra_obstacles(grid: np.ndarray, reserved_cols: set[int], reserved_cells: set[tuple[int, int]]) -> None:
+    h, w = grid.shape
+    top = max(h // 3 + 1, 4)
+    target = random.randint(3, 7)
