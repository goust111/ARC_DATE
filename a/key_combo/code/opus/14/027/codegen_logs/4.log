+def _paint_object(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    mask: np.ndarray,
+    body: int,
+    control: int,
+    control_local: tuple[int, int],
+) -> tuple[tuple[int, int], ...]:
+    coords: list[tuple[int, int]] = []
