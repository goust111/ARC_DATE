+    for dr, dc in DIRS4:
+        rr = endpoint[0] + dr
+        cc = endpoint[1] + dc
+        if not _in_bounds(shape, rr, cc) or (rr, cc) in path_set:
+            continue
+        bad = False
+        for nr, nc in _neighbors4(rr, cc):
+            if (nr, nc) != endpoint and (nr, nc) in path_set:
+                bad = True
+                break
