+def _normalize(coords: list[Coord]) -> tuple[Coord, ...]:
+    min_r = min(r for r, _ in coords)
+    min_c = min(c for _, c in coords)
+    norm = sorted((r - min_r, c - min_c) for r, c in coords)
+    return tuple(norm)
