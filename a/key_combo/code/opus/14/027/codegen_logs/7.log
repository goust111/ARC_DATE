+def _render_blue_output(
+    blue_components: list[np.ndarray],
+    shape: tuple[int, int],
+    vector: tuple[int, int],
+    *,
+    area_mode: str = "count",
+    endpoint_vector: tuple[int, int] | None = None,
+    force_all: str | None = None,
