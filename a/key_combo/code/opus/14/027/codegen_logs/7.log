+            path_set = set(path)
+            start = path[0]
+            end = path[-1]
+            red_dirs = _valid_color_dirs(start, path_set, (H, W))
+            yellow_dirs = _valid_color_dirs(end, path_set, (H, W))
+            pairs = []
+            for rdir in red_dirs:
+                for ydir in yellow_dirs:
+                    if rdir == ydir:
+                        continue
