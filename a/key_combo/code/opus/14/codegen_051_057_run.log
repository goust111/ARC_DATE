+        progressed = False
+        for idx, ray in enumerate(rays):
+            if not ray.active:
+                continue
+            if ray.path:
+                nr = ray.path[-1][0] + ray.direction[0]
+                nc = ray.path[-1][1] + ray.direction[1]
+            else:
+                nr, nc = ray.start
+            if not in_bounds(base.shape, nr, nc):
+                ray.active = False
+                continue
+            if int(base[nr, nc]) != BG or int(ray_grid[nr, nc]) != BG:
+                ray.active = False
+                continue
