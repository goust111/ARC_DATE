+            arr = np.asarray(coords, dtype=int)
+            r0 = int(arr[:, 0].min())
+            c0 = int(arr[:, 1].min())
+            r1 = int(arr[:, 0].max())
+            c1 = int(arr[:, 1].max())
+            local_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            local_mask[arr[:, 0] - r0, arr[:, 1] - c0] = True
+            objects.append(
