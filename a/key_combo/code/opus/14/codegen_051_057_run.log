+def _make_independent_box(
+    rng: random.Random,
+    h: int,
+    w: int,
+    blocked: list[tuple[int, int, int, int]],
+) -> tuple[int, int, int, int]:
+    for _ in range(400):
+        fh = rng.choice((8, 10))
+        fw = rng.choice((8, 10))
+        r0 = rng.randint(2, h - fh - 3)
+        c0 = rng.randint(2, w - fw - 3)
+        box = (r0, c0, r0 + fh - 1, c0 + fw - 1)
