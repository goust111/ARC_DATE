+        holes,
+        key=lambda obj: (
+            _corner_distance(
+                _bbox_center2_from_bbox(obj["bbox"]),
+                CORNER_BY_COLOR[obj["color"]][1],
+            ),
+            obj["bbox"][0],
+            obj["bbox"][1],
