+        ((0, 1), (1, 0)): (r - 1, c),
+        ((1, 0), (0, -1)): (r, c),
+        ((0, -1), (-1, 0)): (r, c - 1),
+        ((-1, 0), (0, 1)): (r - 1, c - 1),
+    }
+    return mapping.get((d1, d2))
