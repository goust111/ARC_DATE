+
+def _paint_shape(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    shape: list[tuple[int, int]],
+    color: int,
+) -> None:
+    r0, c0, _r1, _c1 = box
+    for dr, dc in shape:
