+SINGLE_PATTERNS = [
+    {"h": 2, "w": 2, "cells": [(0, 0), (1, 0), (1, 1)]},
+    {"h": 2, "w": 3, "cells": [(0, 0), (0, 1), (1, 1), (1, 2)]},
+    {"h": 2, "w": 3, "cells": [(0, 1), (1, 0), (1, 1), (1, 2)]},
