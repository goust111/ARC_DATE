+    dc = end[1] - start[1]
+    assert dr == 0 or dc == 0 or abs(dr) == abs(dc), "markers must share a row, column, or 45-degree diagonal"
+    step = (
+        0 if dr == 0 else dr // abs(dr),
+        0 if dc == 0 else dc // abs(dc),
