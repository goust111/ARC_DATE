+                ir0, ic0, ir1, ic1 = input_box
+                if ir0 < 0 or ic0 < 0 or ir1 >= h or ic1 >= w:
+                    continue
+                if any(_boxes_overlap(input_box, box, pad=1) for box in blocked_input):
+                    continue
