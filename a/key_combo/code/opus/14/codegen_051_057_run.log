+        door_centers_local.append(door)
+    if not any(dc not in col_values for dc in door_centers_local):
+        return None
+
+    sep_c = LEFT_PANEL_W
+    mapping_abs = _template_anchor_map(template_name, row_map, col_map, sep_c)
