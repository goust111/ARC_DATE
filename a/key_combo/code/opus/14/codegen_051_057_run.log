+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MARKER_COLORS = (BLUE, GREEN, YELLOW)
+SIDES = ("top", "bottom", "left", "right")
+
+PAIR_COUNT_RANGE = (2, 3)
+HEIGHT_RANGE_BY_PAIRS = {2: (18, 24), 3: (22, 28)}
+WIDTH_RANGE = (19, 26)
+INNER_MARGIN = 4
+ZONE_MIN_HEIGHT = 4
+ZONE_GAP = 1
+MIN_ROW_DROP = 2
+MIN_HORIZONTAL_SPAN = 5
+MAX_SPRITE_EXTENT = 2
+GEN_ATTEMPTS = 500
