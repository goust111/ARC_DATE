+        {"duplicate_count": 1, "same_row": True, "extra_noise": 1},
+        {"duplicate_count": 2, "same_row": False, "extra_noise": 2},
+        {"duplicate_count": 1, "same_row": False, "extra_noise": 0},
+    ]
+    profile = profiles[_GEN_CALL_COUNT % len(profiles)]
