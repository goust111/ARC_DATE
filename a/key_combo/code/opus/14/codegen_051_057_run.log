+    out: list[tuple[int, int]] = []
+    avoid = [] if avoid is None else list(avoid)
+    for cell in candidates:
+        if all(max(abs(cell[0] - r), abs(cell[1] - c)) >= 2 for r, c in out + avoid):
+            out.append(cell)
+            if len(out) == count:
