+    ["S.X.", "..XX", "XXX."],
+    ["S.X.", "..X.", "XXXX"],
+    ["S.X", "..X", "XXX", "X.."],
+    ["S.X", "..X", "XXX", ".X."],
+    ["S.X", "..X", "XXX", "..X"],
+    ["..X", "S.X", "..X", "XXX"],
+    [".S.X", "...X", "XXXX"],
+]
+
+EDGE_MERGE_PATTERNS = [
+    ["S.XX", "..XX", ".XXX"],
+]
+
+STATIC_PATTERNS = [
+    ["XX", "X."],
+    ["XXX", ".X."],
+    ["XX", ".X", ".X"],
+    ["XXX", "X.."],
+    ["XX", "XX"],
+    ["XX.", ".XX"],
+]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in N4:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr, dc in N8:
+        yield r + dr, c + dc
