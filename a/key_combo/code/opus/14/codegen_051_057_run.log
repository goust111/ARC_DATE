+    mask = np.zeros((region_h, region_w), dtype=bool)
+    mask[off_r : off_r + sh, off_c : off_c + sw] = shape
+    return mask
+
+
+def _choose_sources_and_targets(k: int) -> dict[int, int] | None:
+    upper = list(range(1, 7))
+    all_regions = list(range(1, 10))
+    for _ in range(400):
