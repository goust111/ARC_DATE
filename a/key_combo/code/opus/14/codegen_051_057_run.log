0512:     """Flood fill region containing (r,c) with `color` (in-place)."""
0513:     H, W = grid.shape
0514:     r0 = int(r)
0515:     c0 = int(c)
0516:     if not (0 <= r0 < H and 0 <= c0 < W):
0517:         return
0518:     new_col = int(color)
0519:     old_col = int(grid[r0, c0])
0520:     if old_col == new_col:
0521:         return
0522:     if int(connectivity) == 4:
0523:         def nbrs(rr: int, cc: int):
0524:             yield rr - 1, cc
0525:             yield rr + 1, cc
0526:             yield rr, cc - 1
0527:             yield rr, cc + 1
0528:     else:
0529:         def nbrs(rr: int, cc: int):
0530:             for dr in (-1, 0, 1):
0531:                 for dc in (-1, 0, 1):
0532:                     if dr == 0 and dc == 0:
0533:                         continue
0534:                     yield rr + dr, cc + dc
0535:     stack: list[Coord] = [(r0, c0)]
0536:     while stack:
0537:         rr, cc = stack.pop()
0538:         if not (0 <= rr < H and 0 <= cc < W):
0539:             continue
0540:         if int(grid[rr, cc]) != old_col:
0541:             continue
0542:         grid[rr, cc] = new_col
0543:         for nr, nc in nbrs(rr, cc):
0544:             stack.append((nr, nc))
0545: 
0546: 
0547: def draw_line(
0548:     grid: np.ndarray,
0549:     r: int,
0550:     c: int,
0551:     *,
0552:     end_r: int | None = None,
0553:     end_c: int | None = None,
0554:     length: int | None = None,
0555:     direction: tuple[int, int] | None = None,
0556:     color: int,
0557:     stop_at: set[int] | None = None,
0558:     clip: bool = False,
0559: ) -> Coord:
0560:     """
0561:     Draw a line starting at (r,c) either to an endpoint or by (length,direction).
0562:     Modifies grid in-place. Returns (r_end,c_end) last drawn.
0563: 
0564:     Compatibility note (seed helpers):
0565:       - If you provide `direction` and leave `length=None`, the line extends until
0566:         it would leave the grid (implemented by using a sufficiently large length).
0567:     """
0568:     rr = int(r)
0569:     cc = int(c)
0570:     H, W = grid.shape
0571:     col = int(color)
0572:     stop_at = set() if stop_at is None else set(map(int, stop_at))
0573: 
0574:     if (end_r is None) != (end_c is None):
0575:         raise ValueError("draw_line: either provide both end_r and end_c, or neither")
0576: 
0577:     if end_r is not None and end_c is not None:
0578:         er = int(end_r)
0579:         ec = int(end_c)
0580:         dr = er - rr

