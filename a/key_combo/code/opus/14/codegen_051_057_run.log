+    placements[biggest] = first
+    big_cells = shapes[biggest] + np.array(first)
+    occupied[big_cells[:, 0], big_cells[:, 1]] = True
+
+    second_range = (first[0] + int(shapes[biggest][:, 0].max()) + 1, upper_band - 2)
