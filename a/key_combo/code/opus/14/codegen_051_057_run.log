+def _seed_counts(
+    grid: np.ndarray, boxes: list[list[tuple[int, int, int, int]]]
+) -> tuple[int, int, list[tuple[int, int]], list[tuple[int, int]]]:
+    n_rows = len(boxes)
+    n_cols = len(boxes[0])
+    edge_seeds: list[tuple[int, int]] = []
+    inner_seeds: list[tuple[int, int]] = []
+    for i, row in enumerate(boxes):
