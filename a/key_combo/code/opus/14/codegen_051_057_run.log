+    if not unique or len(set(chosen)) < 2:
+        return False
+
+    actual = main(g)
+    no_mirror = _solve_grid(g, mirror_mode="none")
+    always_mirror = _solve_grid(g, mirror_mode="always_mirror")
+    first_choice = _solve_grid(g, chooser="first")
+    path_only = _draw_path_only(g)
