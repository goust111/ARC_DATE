+        band[r, c] = color
+    if state in (STATE_COMPLETE, STATE_SHELL_ONLY):
+        for dr, dc in offsets:
+            band[r + dr, c + dc] = color
+
+
+def _build_case() -> tuple[np.ndarray, tuple[tuple[int, int], ...], dict[str, tuple[int, int]], str]:
