+    "up": ((-3, 0), (-2, 0)),
+    "down": ((2, 0), (3, 0)),
+    "left": ((0, -3), (0, -2)),
+    "right": ((0, 2), (0, 3)),
+}
+GAP_OFFSETS: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BAR_NAMES: tuple[str, ...] = ("up", "down", "left", "right")
+
+MIN_CENTER_COUNT = 3
+MAX_CENTER_COUNT = 5
+MARGIN = 3
+CORNER_DEPTH = 3
+MAX_GEN_ATTEMPTS = 500
