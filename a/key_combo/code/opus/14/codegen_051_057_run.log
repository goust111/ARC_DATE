+def _choose_orientations(n_panels: int) -> tuple[list[int], bool]:
+    use_rare = random.random() < 0.25
+    pool = RARE_PATTERNS[n_panels] if use_rare else COMMON_PATTERNS[n_panels]
+    return list(random.choice(pool)), use_rare
+
