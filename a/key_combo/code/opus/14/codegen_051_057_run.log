0092: _GEN_BORDER_WALL_THICKNESS = 2
0093: _GEN_CAVITY_START_GAP = 3
0094: _GEN_MIN_CAVITY_AREA = min(h * w for h, w in _GEN_CAVITY_DIMS)
0095: _GEN_MAX_CAVITY_AREA = max(h * w for h, w in _GEN_CAVITY_DIMS)
0096: _GEN_CAVITY_WIDTH_WEIGHT_POWER = 2
