+) -> bool:
+    h, w = grid.shape
+    sh, sw = shape.shape
+    positions = [(r, c) for r in range(h - sh + 1) for c in range(w - sw + 1)]
+    random.shuffle(positions)
+    for r0, c0 in positions:
+        if np.any((shape == 1) & (grid[r0 : r0 + sh, c0 : c0 + sw] != 0)):
