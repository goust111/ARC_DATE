+
+def _border_color(r: int, c: int, bbox: tuple[int, int, int, int], pair_side: str) -> int:
+    r0, c0, r1, c1 = bbox
+    if pair_side in ("top", "bottom"):
+        cut_low = (r0 + r1) // 2
+        cut_high = (r0 + r1 + 1) // 2
+        if pair_side == "top":
+            return GREEN if r <= cut_low else BLUE
+        return GREEN if r >= cut_high else BLUE
+
+    cut_low = (c0 + c1) // 2
