+def _choose_hole_corners(count: int) -> list[str]:
+    if count == 2:
+        options = [
+            ("TL", "TR"),
+            ("BL", "BR"),
+            ("TL", "BL"),
+            ("TR", "BR"),
+            ("TL", "BR"),
+            ("TR", "BL"),
+        ]
+        weights = [4, 4, 2, 2, 1, 1]
