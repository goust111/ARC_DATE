+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MARKER_COLORS = (BLUE, GREEN, YELLOW)
+SIDES = ("top", "bottom", "left", "right")
+
+PAIR_COUNT_RANGE = (2, 3)
+HEIGHT_RANGE_BY_PAIRS = {2: (18, 24), 3: (22, 28)}
+WIDTH_RANGE = (18, 26)
