0098: # Tile dimensions, repetition, and density.
0099: _GEN_TILE_HEIGHT_RANGE = (2, 3)
0100: _GEN_TILE_WIDTH_RANGE = (2, 5)
0101: _GEN_REPS_PER_AXIS_RANGE = (2, 5)
0102: _GEN_TILE_DENSITY_PCT_RANGE = (56, 78)
0103: 
0104: # Retry limits.
0105: _GEN_MAX_ATTEMPTS = 300
0106: _GEN_PERCENT_DENOM = 100
