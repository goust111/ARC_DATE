+    rr0 = max(1, r0 - pad)
+    cc0 = max(1, c0 - pad)
+    rr1 = min(height - 2, r1 + pad)
+    cc1 = min(width - 2, c1 + pad)
+    reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _chebyshev_far_enough(cells: Iterable[tuple[int, int]], candidate: tuple[int, int], gap: int = 1) -> bool:
