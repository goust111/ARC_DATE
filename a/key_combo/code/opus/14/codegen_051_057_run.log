+def _is_vertical(mask: np.ndarray) -> bool:
+    return bool(np.array_equal(mask, mask[:, ::-1]))
+
+
+def _is_horizontal(mask: np.ndarray) -> bool:
+    return bool(np.array_equal(mask, mask[::-1, :]))
