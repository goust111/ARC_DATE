    return symmetric, asymmetric


def _gen_place_sprites(n: int, sprites: list[np.ndarray]) -> np.ndarray | None:
    items = list(sprites)
    random.shuffle(items)

    canvas = np.full((n, n), BACKGROUND_COLOR, dtype=int)
    placed: list[tuple[int, int, int, int]] = []

    for sprite in items:
