import random, numpy as np
from collections import deque
H=W=15
random.seed(0)

def seg_cells(p,q):
 r0,c0=p;r1,c1=q
 if abs(r1-r0)"'!=abs(c1-c0) or r0==r1:return None
 dr=1 if r1>r0 else -1
 dc=1 if c1>c0 else -1
 return [(r0+k*dr,c0+k*dc) for k in range(abs(r1-r0)+1)]

def add_seg(g,p,q,col=1):
 for r,c in seg_cells(p,q):g[r,c]=col

def add_ray(g,p,ori,col=6):
 dirs=[(-1,1),(1,-1)] if ori=='"'/' else [(-1,-1),(1,1)]
 for dr,dc in dirs:
  r,c=p
  while 0<=r<H and 0<=c<W:
   if g[r,c]==0:g[r,c]=col
   r+=dr;c+=dc

def enclosed(g):
 seen=np.zeros((H,W),bool);res=[]
 for r in range(H):
  for c in range(W):
   if g[r,c]"'!=0 or seen[r,c]:continue
   q=deque([(r,c)]);seen[r,c]=1;cells=[];touch=False
   while q:
    x,y=q.popleft();cells.append((x,y));touch|=x in (0,H-1) or y in (0,W-1)
    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
