+    for guide in guides:
+        for r, c in guide["cells"]:
+            grid[r, c] = GUIDE_COLOR
+    for seed in seeds:
+        for r, c in seed["cells"]:
+            grid[r, c] = int(seed["color"])
+    return grid
+
+
+def _render_expected(instance: dict[str, object]) -> np.ndarray:
