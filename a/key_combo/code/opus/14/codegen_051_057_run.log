_TOTAL_COLORED_MAX = 10     # max colored pixels
_OCCUPIED_CELLS_MIN = 4     # min non-center sub-cells containing >=1 colored pixel
_OCCUPIED_CELLS_MAX = 7     # max non-center sub-cells containing >=1 colored pixel
