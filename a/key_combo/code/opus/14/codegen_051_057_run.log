+    if np.count_nonzero(inp) != 2 * len(specs):
+        return False
+    if np.array_equal(out, _wrong_diagonal_output(inp)):
+        return False
+    if np.array_equal(out, _wrong_rectangle_output(inp)):
+        return False
+    if not np.array_equal(main(inp), out):
