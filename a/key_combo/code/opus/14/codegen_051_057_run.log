+    all_away = clean.copy()
+    for marker in markers:
+        r, c = marker["marker"]
+        all_toward[r, c] = ORANGE
+        all_away[r, c] = ORANGE
+    for marker in markers:
+        _apply_marker_instruction(all_toward, marker["marker"], RED)
+        _apply_marker_instruction(all_away, marker["marker"], BLUE)
