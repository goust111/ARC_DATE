+def _reserve_halo(reserved: np.ndarray, cells: set[tuple[int, int]], top: int, left: int) -> None:
+    for r, c in cells:
+        gr = top + r
+        gc = left + c
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = gr + dr
+                nc = gc + dc
+                if _in_bounds(reserved.shape, nr, nc):
+                    reserved[nr, nc] = True
+
+
+def _place_objects(
+    shape: tuple[int, int],
+    objects: list[dict],
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, dict] | None:
+    h, w = shape
+    grid = np.zeros(shape, dtype=int)
+    reserved = np.zeros(shape, dtype=bool)
+    placed_meta = {
+        "merge_singletons": [],
+        "far_singletons": [],
+        "markers": [],
+        "merge_markers": [],
+        "static_markers": [],
+    }
+
+    ordering = sorted(
+        range(len(objects)),
+        key=lambda i: (
+            -len(objects[i]["future_cells"]),
+            -(objects[i]["height"] * objects[i]["width"]),
