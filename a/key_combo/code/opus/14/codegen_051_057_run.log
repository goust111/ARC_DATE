+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+LEFT_COLORS = (1, 2, 3)
+RIGHT_COLORS = (4, 6, 7)
+GRID_H_RANGE = (13, 19)
+SIDE_WIDTH_RANGE = (6, 11)
+GAP_WIDTHS = (3, 4, 5, 6, 7)
+COUNT_RANGE = (2, 4)
+HEIGHT_RANGE = (2, 3)
+WIDTH_RANGE = (2, 4)
+GEN_ATTEMPTS = 600
