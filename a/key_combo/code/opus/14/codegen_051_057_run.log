+def _sample_band_lengths() -> tuple[int, int, int]:
+    options = [(a, b, c) for a in (4, 5) for b in (4, 5) for c in (4, 5)]
+    weights = np.array([1 if len({a, b, c}) == 1 else 3 for a, b, c in options], dtype=float)
+    weights /= weights.sum()
