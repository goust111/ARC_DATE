+    ordered = _sort_objects(objects, sort_mode)
+    meta_objects = []
+
+    for obj in ordered:
+        coords = np.asarray(obj["coords"], dtype=int)
+        color = int(obj["color"])
+        area = int(obj["area"])
+        bbox = obj["bbox"]
+        profiles = _column_profiles(coords)
