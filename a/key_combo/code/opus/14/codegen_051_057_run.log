+    ordered = sorted(rects, key=lambda rect: rect.c0)
+    for left, right in zip(ordered, ordered[1:]):
+        if left.c1 >= right.c0:
+            return False
+    return True
+
+
+def _semantic_checks(inp: np.ndarray, specs: list[Rect], expected: np.ndarray) -> bool:
+    try:
