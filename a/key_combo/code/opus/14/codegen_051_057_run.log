+def structural_input(grid: np.ndarray, blocks: list[Block], markers: list[tuple[int, int, int]]) -> np.ndarray:
+    base = np.asarray(grid, dtype=int).copy()
+    for r, c, _color in markers:
+        base[r, c] = BG
