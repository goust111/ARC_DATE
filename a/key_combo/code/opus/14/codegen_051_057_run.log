+    c1 = c0 + w - 1
+    if r0 < 0 or c0 < 0 or r1 >= hh or c1 >= ww:
+        return False
+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(hh - 1, r1 + gap)
+    cc1 = min(ww - 1, c1 + gap)
