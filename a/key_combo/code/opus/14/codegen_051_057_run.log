+TEMPLATE_CENTER = (1, 1)
+ARROW_BBOXES = ((2, 3), (3, 2))
+CORNER_TO_CW = {
+    (0, 0): 0,
+    (0, 1): 1,
+    (1, 1): 2,
+    (1, 0): 3,
