0108: 
0109: def _gen_floor_percent(percent: int, value: int) -> int: return (percent * value) // _GEN_PERCENT_DENOM
0110: 
0111: 
0112: def _gen_ceil_percent(percent: int, value: int) -> int: return (percent * value + _GEN_PERCENT_DENOM - 1) // _GEN_PERCENT_DENOM
0113: 
0114: 
0115: def _gen_factor_options(length: int, lo: int, hi: int) -> list[int]:
0116:     rep_min, rep_max = _GEN_REPS_PER_AXIS_RANGE
0117:     return [d for d in range(lo, hi + 1) if length % d == 0 and rep_min <= length // d <= rep_max]
0118: 
