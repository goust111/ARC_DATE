0175: def _gen_place_cavities(rng: np.random.Generator, rows: int, cols: int, dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
0176:     placed: list[tuple[int, int, int, int]] = []
0177:     for h, w in sorted(dims, key=lambda x: x[0] * x[1], reverse=True):
0178:         positions: list[tuple[int, int, int, int]] = []
0179:         for r0 in range(_GEN_BORDER_WALL_THICKNESS, rows - h - _GEN_BORDER_WALL_THICKNESS + 1):
0180:             for c0 in range(_GEN_BORDER_WALL_THICKNESS, cols - w - _GEN_BORDER_WALL_THICKNESS + 1):
0181:                 rect = (r0, c0, r0 + h - 1, c0 + w - 1)
0182:                 if _gen_rect_is_clear(rect, placed):
0183:                     positions.append(rect)
0184:         if not positions:
0185:             return None
0186:         placed.append(positions[int(rng.integers(0, len(positions)))])
0187:     return placed
