+    for marker_pos in meta["static_markers"]:
+        entry = comps_by_marker.get(marker_pos)
+        if entry is None:
+            return False
+        interiors = _interior_pixels(expanded.shape, entry["coords"])
+        if interiors:
+            return False
+        untouched_without_interior += 1
