+        "name": "noncollision_four",
+        "blocks": [((0, 4), (0, 2)), ((0, 10), (1, 3)), ((6, 0), (1, 3)), ((6, 6), (1, 0))],
+        "collision": False,
+        "marker_mode": "two_regions",
+    },
+    {
+        "name": "collision_four",
+        "blocks": [((0, 1), (3, 2)), ((4, 8), (2, 0)), ((8, 0), (1, 3)), ((10, 10), (2, 0))],
+        "collision": True,
+        "marker_mode": "one_region",
+    },
+)
+
+
+@dataclass
+class Block:
+    color: int
+    frame_r: int
+    frame_c: int
+    gap: tuple[int, int]
+    direction: tuple[int, int]
+
+    @property
+    def gap_abs(self) -> tuple[int, int]:
+        return self.frame_r + self.gap[0], self.frame_c + self.gap[1]
+
+
+@dataclass
+class Ray:
+    color: int
+    start: tuple[int, int]
+    direction: tuple[int, int]
+    path: list[tuple[int, int]]
+    active: bool = True
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def neighbors8(r: int, c: int):
+    for dr, dc in DIR8:
+        yield r + dr, c + dc
+
+
+def components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(cells, dtype=int))
+    return parts
+
+
+def label_regions(mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    regions: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] >= 0:
+                continue
+            idx = len(regions)
+            q = deque([(r, c)])
+            labels[r, c] = idx
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] < 0:
+                        labels[nr, nc] = idx
+                        q.append((nr, nc))
+            regions.append(np.array(cells, dtype=int))
