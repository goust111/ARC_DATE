0040:     counts = Counter(signature for signature, _ in crops)
0041:     assert len(counts) >= 2
0042:     assert any(n > 1 for n in counts.values())
0043: 
0044:     unique_signatures = [signature for signature, n in counts.items() if n == 1]
0045:     assert len(unique_signatures) == 1
0046: 
0047:     matches = [crop for signature, crop in crops if signature == unique_signatures[0]]
0048:     assert len(matches) == 1
0049:     return matches[0].copy()
