+def _add_sprite(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = mask.shape
+    view = grid[top : top + h, left : left + w]
+    assert np.all(view[mask] == BG), "sprite placement must land on background"
