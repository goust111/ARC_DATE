+
+def _bbox_shape(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _bbox_area(box: tuple[int, int, int, int]) -> int:
