+
+def _reserve_halo(reserved: np.ndarray, cells: set[tuple[int, int]], top: int, left: int) -> None:
+    for r, c in cells:
+        gr = top + r
+        gc = left + c
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
