+    all_seeds = [(r, c) for r in range(q) for c in range(q)]
+    central = [
+        (r, c)
+        for r, c in all_seeds
+        if r != c and r >= max(0, q // 2 - 1) and c >= max(0, q // 2 - 1)
+    ]
+    if len(central) < len(colors) - 1:
+        return None
