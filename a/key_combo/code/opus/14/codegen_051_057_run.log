+                    input_box = (fr0 - gap - sh, orth, fr0 - gap - 1, orth + sw - 1)
+                elif side == "below":
+                    input_box = (fr1 + gap + 1, orth, fr1 + gap + sh, orth + sw - 1)
+                elif side == "left":
+                    input_box = (orth, fc0 - gap - sw, orth + sh - 1, fc0 - gap - 1)
+                else:
+                    input_box = (orth, fc1 + gap + 1, orth + sh - 1, fc1 + gap + sw)
