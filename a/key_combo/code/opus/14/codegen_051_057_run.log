import random

def perimeter_coords(box):
    r0,c0,r1,c1=box
    pts=[]
    for c in range(c0,c1+1):
        pts.append((r0,c)); pts.append((r1,c))
    for r in range(r0+1,r1):
        pts.append((r,c0)); pts.append((r,c1))
    return pts

def side_positions(box, side):
    r0,c0,r1,c1=box
    if side=='top': return [(r0,c) for c in range(c0+1,c1)]
    if side=='bottom': return [(r1,c) for c in range(c0+1,c1)]
    if side=='left': return [(r,c0) for r in range(r0+1,r1)]
    return [(r,c1) for r in range(r0+1,r1)]

def legal_gap_positions(box):
    return side_positions(box,'top')+side_positions(box,'bottom')+side_positions(box,'left')+side_positions(box,'right')

def box_contains(box,p):
    r,c=p; r0,c0,r1,c1=box
    return r0<=r<=r1 and c0<=c<=c1

def emitter_dir(box,p):
    r,c=p; r0,c0,r1,c1=box
    mr=(r0+r1)/2.0; mc=(c0+c1)/2.0
    if r==r0: return (-1,-1 if c<mc else 1)
    if r==r1: return (1,-1 if c<mc else 1)
    if c==c0: return (-1 if r<mr else 1,-1)
    if c==c1: return (-1 if r<mr else 1,1)
    raise ValueError

def build_maps(boxes, colors, gaps, emitter):
    wall={}
    owner={}
    gapset=set()
    for i,(box,col,gap) in enumerate(zip(boxes,colors,gaps)):
        for p in perimeter_coords(box):
            owner[p]=i
            if gap is not None and p==gap:
                gapset.add(p)
            else:
                wall[p]=4 if p==emitter else col
    if emitter not in wall:
        wall[emitter]=4; owner[emitter]=0
    return wall, owner, gapset

def boundary_kind(box,p):
    r,c=p; r0,c0,r1,c1=box
    if (r,c) in {(r0,c0),(r0,c1),(r1,c0),(r1,c1)}: return 'corner'
    if r in (r0,r1): return 'horizontal'
    return 'vertical'

def region_id(p, boxes, owner):
    if p in owner: return None
    if box_contains(boxes[0], p): return None
    for i in range(len(boxes)-1):
        if box_contains(boxes[i+1], p) and not box_contains(boxes[i], p):
            return i
    if not box_contains(boxes[-1], p): return len(boxes)-1
    return None

def simulate(H,W,boxes,colors,gaps,emitter,max_steps=2000):
    wall,owner,gapset=build_maps(boxes,colors,gaps,emitter)
    pos=emitter
    dr,dc=emitter_dir(boxes[0],emitter)
    color=4
    cur_region=None
    entry_color=None
    fills=[]
    hits=[]
    gap_cross=[]
    seen=set()
    for step in range(max_steps):
        st=(pos,dr,dc,color,cur_region)
        if st in seen: return None
        seen.add(st)
        nxt=(pos[0]+dr,pos[1]+dc)
        if not (0<=nxt[0]<H and 0<=nxt[1]<W):
            if cur_region is not None and cur_region not in [r for r,_ in fills]:
                fills.append((cur_region,entry_color))
            return {'fills':fills,'hits':hits,'gap_cross':gap_cross,'steps':step+1,'end':pos,'dir':(dr,dc)}
        if nxt in owner:
            if nxt in gapset:
                if cur_region is not None and cur_region not in [r for r,_ in fills]:
                    fills.append((cur_region,entry_color))
                pos=nxt
                cur_region=None
                gap_cross.append(nxt)
                continue
            color=wall[nxt]
            kind=boundary_kind(boxes[owner[nxt]], nxt)
            if kind in ('horizontal','corner'):
                dr=-dr
            if kind in ('vertical','corner'):
                dc=-dc
            hits.append((nxt,owner[nxt],kind,color))
            continue
        pos=nxt
        new_region=region_id(pos, boxes, owner)
        if new_region "'!= cur_region:
            if cur_region is not None and cur_region not in [r for r,_ in fills]:
                fills.append((cur_region,entry_color))
            cur_region=new_region
            if cur_region is not None:
                entry_color=color
    return None

def sample_boxes():
    n=random.choice([2,3])
    inner=random.randint(5,8)
    deltas=[random.randint(3,5) for _ in range(n-1)]
    sizes=[inner]
    for d in deltas: sizes.append(sizes[-1]+2*d)
    outer=sizes[-1]
    H=outer+random.randint(3,8)
    W=outer+random.randint(3,8)
    r0=random.randint(1,H-outer-1)
    c0=random.randint(1,W-outer-1)
    boxes=[(r0,c0,r0+outer-1,c0+outer-1)]
    for inset in deltas[::-1]:
        a,b,c,d=boxes[-1]
        boxes.append((a+inset,b+inset,c-inset,d-inset))
    return H,W,boxes[::-1]

def choose_emitter(box,gap):
    mr=(box[0]+box[2])/2.0; mc=(box[1]+box[3])/2.0
    cands=[]
    for s in ['"'top','bottom','left','right']:
        for p in side_positions(box,s):
            if p==gap or abs(p[0]-gap[0])+abs(p[1]-gap[1])==1: continue
            if s in ('top','bottom') and p[1]==mc: continue
            if s in ('left','right') and p[0]==mr: continue
            cands.append(p)
    return random.choice(cands)

success=0
for attempt in range(1000):
    H,W,boxes=sample_boxes()
    colors=random.sample([1,2,3,5,6,7,8,9], len(boxes))
    gap0=random.choice(legal_gap_positions(boxes[0]))
    emitter=choose_emitter(boxes[0],gap0)
    # sequentially choose outer gaps from first hit on that ring in closed sim
    gaps=[gap0]
    ok=True
    while len(gaps)<len(boxes):
        partial=gaps+[None]*(len(boxes)-len(gaps))
        res=simulate(H,W,boxes,colors,partial,emitter)
        if res is None:
            ok=False; break
        target_ring=len(gaps)
        candidates=[hit[0] for hit in res['hits'] if hit[1]==target_ring and hit[0] not in gaps]
        # legal and non-corner gap positions only
        candidates=[p for p in candidates if p in legal_gap_positions(boxes[target_ring])]
        if not candidates:
            ok=False; break
        # choose first distinct candidate
        gaps.append(candidates[0])
    if not ok: continue
    res=simulate(H,W,boxes,colors,gaps,emitter)
    if res is None: continue
    fill_cols=[c for _,c in res['fills']]
    if len(res['fills'])"'!=len(boxes):
        continue
    if len(set(fill_cols))<2 or all(c==4 for c in fill_cols):
        continue
    if len(res['"'hits'])<1 or len(res['gap_cross'])"'!=len(boxes)-1:
        continue
    print('"'success', attempt, 'n', len(boxes), 'shape', (H,W), 'fills', res['fills'], 'hitkinds', [h[2] for h in res['hits'][:10]], 'gaps', gaps, 'em', emitter)
    success+=1
    if success>=10: break
print('successes', success)
