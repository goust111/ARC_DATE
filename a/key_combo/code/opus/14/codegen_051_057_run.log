0207: def _gen_tile(rng: np.random.Generator, tile_h: int, tile_w: int, color: int, count: int) -> np.ndarray:
0208:     if rng.integers(0, 2) == 0:
0209:         required = {(0, 0), (tile_h - 1, tile_w - 1)}
0210:     else:
0211:         required = {(0, tile_w - 1), (tile_h - 1, 0)}
0212:     coords = [(r, c) for r in range(tile_h) for c in range(tile_w) if (r, c) not in required]
0213:     extra = count - len(required)
0214:     if extra > 0:
0215:         chosen = rng.choice(len(coords), size=extra, replace=False)
0216:         required.update(coords[int(i)] for i in np.atleast_1d(chosen))
0217: 
0218:     tile = np.full((tile_h, tile_w), _GEN_EMPTY, dtype=int)
0219:     for r, c in required:
0220:         tile[r, c] = color
0221:     return tile
