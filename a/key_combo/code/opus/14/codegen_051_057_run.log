+    claims: dict[tuple[int, int], set[int]] = defaultdict(set)
+    for pair in pairs:
+        for row in range(h):
+            offset = _step_offset(row, pair["r0"], pair["r1"], step)
+            left = int(pair["left"]) - offset
+            right = int(pair["right"]) + offset
+            if 0 <= left < w:
