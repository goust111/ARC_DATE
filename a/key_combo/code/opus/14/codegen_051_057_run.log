+    if not set(map(int, np.unique(inp))).issubset({BLACK, BLUE, RED, GREY, ORANGE}):
+        return False
+
+    expected_colors = {marker["expected"] for marker in markers}
+    if expected_colors != {BLUE, RED}:
+        return False
+    if not (2 <= len(markers) <= 4):
