+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        grid = _generate_attempt(rng)
+        if grid is None:
+            continue
+        if _scene_is_semantically_valid(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid sliding-direction ARC input")

