+            bottom_count = int(candidate_bottom.sum())
+            if top_count in (0, mask_h * mask_w) or bottom_count in (0, mask_h * mask_w):
+                continue
+            top_mask = candidate_top
+            bottom_mask = candidate_bottom
+            break
+        if top_mask is None or bottom_mask is None:
