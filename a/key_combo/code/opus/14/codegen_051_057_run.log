+        "bottom": "top",
+        "left": "right",
+        "right": "left",
+    }[side]
+
+
+def _side_of_point(r: int, c: int, bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    matches = []
+    if r == r0:
+        matches.append("top")
+    if r == r1:
+        matches.append("bottom")
+    if c == c0:
+        matches.append("left")
+    if c == c1:
+        matches.append("right")
+    assert len(matches) == 1, "each marker must lie on exactly one bbox side"
+    return matches[0]
