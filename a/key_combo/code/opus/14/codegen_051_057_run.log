+    ["S.X", "..X", "XXX", "..X"],
+    ["..X", "S.X", "..X", "XXX"],
+    [".S.X", "...X", "XXXX"],
+]
+
+EDGE_MERGE_PATTERNS = [
+    ["S.XX", "..XX", ".XXX"],
+]
+
+STATIC_PATTERNS = [
+    ["XX", "X."],
+    ["XXX", ".X."],
