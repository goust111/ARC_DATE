+    if left_width < 9 or grid_h <= ctl_h + 2:
+        return None
+
+    try:
+        placements = _place_sprites(grid_h, left_width, sprites)
+    except ValueError:
+        return None
+
+    ctl_top = int(np.random.randint(1, grid_h - ctl_h))
+    grid = np.zeros((grid_h, grid_w), dtype=int)
