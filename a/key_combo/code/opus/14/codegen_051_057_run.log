+
+def _validate_instance(grid: np.ndarray) -> bool:
+    try:
+        start, end, step, steps = _marker_pair(grid)
+        obstacle_comps = _components(grid == GREY)
+        if len(obstacle_comps) != 1 or not (3 <= len(obstacle_comps[0]) <= 5):
+            return False
