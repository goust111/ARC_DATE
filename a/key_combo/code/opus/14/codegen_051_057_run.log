+def _solve(grid: np.ndarray, *, left_target_mode: str = "half", collisions: bool = True) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    bg = BG
+    rects, (gap_start, gap_end) = _extract_rectangles(g, bg)
