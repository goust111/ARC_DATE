+            box_j = comps[j]["bbox"]
+            hi = box_i[2] - box_i[0] + 1
+            wi = box_i[3] - box_i[1] + 1
+            hj = box_j[2] - box_j[0] + 1
+            wj = box_j[3] - box_j[1] + 1
