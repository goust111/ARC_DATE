+    ph, pw = proto.shape
+    if ph > right_h or pw > LEFT_PANEL_W:
+        return None
+    proto_top = random.randint(0, right_h - ph)
+    proto_left = random.randint(0, LEFT_PANEL_W - pw)
+
+    col_values = list(col_map.values())
+    door_centers_local = []
+    for _wr in wall_rows:
+        door = random.randint(1, right_w - 2)
