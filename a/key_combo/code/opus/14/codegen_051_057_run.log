+        sub = out[stamp_box[0] : stamp_box[2] + 1, stamp_box[1] : stamp_box[3] + 1]
+        stamp_mask = stamp != BG
+        assert np.all(sub[stamp_mask] == int(final_color))
+        if containers[color] is not None:
+            assert int(final_color) != int(color)
+        else:
+            assert int(final_color) == int(color)
