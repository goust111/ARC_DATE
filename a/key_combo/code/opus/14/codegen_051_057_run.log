+
+def _slide(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    direction_code: int,
+    obstacle_grid: np.ndarray,
+):
+    r, c = start
+    dr, dc = DIRS[int(direction_code)]
+    if dr == 0 and dc == 0:
+        return (r, c), None
+
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not _in_bounds(shape, nr, nc):
+            return (r, c), None
+        if obstacle_grid[nr, nc] != 0:
+            return (r, c), int(obstacle_grid[nr, nc])
+        r, c = nr, nc
