+def _full_neighborhood_inside(mask: np.ndarray, r: int, c: int) -> bool:
+    h, w = mask.shape
+    if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+        return False
+    return bool(mask[r - 1 : r + 2, c - 1 : c + 2].all())
+
