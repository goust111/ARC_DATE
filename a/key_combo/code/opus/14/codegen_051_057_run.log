+    vr_index = {r: i for i, r in enumerate(vertex_rows)}
+    vc_index = {c: i for i, c in enumerate(vertex_cols)}
+    ar_index = {r: i for i, r in enumerate(anchor_rows)}
+    ac_index = {c: i for i, c in enumerate(anchor_cols)}
