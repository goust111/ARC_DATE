+            crop_i = _crop_bbox(grid, box_i)
+            crop_j = _crop_bbox(grid, box_j)
+            for complete_idx, damaged_idx, complete, damaged in (
+                (i, j, crop_i, crop_j),
+                (j, i, crop_j, crop_i),
