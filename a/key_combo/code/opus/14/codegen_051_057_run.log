+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+MAROON = 9
+
+INPUT_COLORS = (RED, GREEN, ORANGE, MAROON)
+
