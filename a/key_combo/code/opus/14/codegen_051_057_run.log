0115: PAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
0116: PAYLOAD_COLOR_COUNT = 2
0117: GEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)
0118: 
0119: # Sprite composition constraints.
0120: SPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)
0121: SPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2
0122: 
0123: # Macro-cell state constraints.
0124: MIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2
0125: 
0126: # Grey overlay constraints.
0127: GREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25
0128: GREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30
