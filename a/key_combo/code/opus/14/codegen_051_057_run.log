+    missing_global[r0 : r0 + bbox_h, c0 : c0 + bbox_w] = missing_mask
+
+    overlap = int(np.sum((right == BLUE) & missing_global))
+    non_overlap = int(np.sum((right == BLACK) & missing_global))
+    if overlap < 2 or non_overlap < 2:
+        return None
