+    active_cols = {int(c) for c in np.where(np.any(lower == CYAN, axis=0))[0]}
+    marker_pts = [(int(r), int(c), int(lower[r, c])) for r, c in np.argwhere(np.isin(lower, marker_colors))]
+    if not marker_pts:
