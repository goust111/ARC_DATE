+TILE_SIZE = 3
+BG = 0
+SEP = 5
+PATH_COLORS = (1, 2, 3, 4, 7)
+SLOT_ORIGINS = (0, 4, 8)
+INPUT_SLOTS = [(r, c) for r in SLOT_ORIGINS for c in SLOT_ORIGINS]
+OUTPUT_SLOTS = [(r, c) for r in reversed(SLOT_ORIGINS) for c in SLOT_ORIGINS]
