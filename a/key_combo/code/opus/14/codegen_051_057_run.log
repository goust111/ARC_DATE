+        "edges": [(0, 2), (1, 2), (2, 3)],
+    },
+    "TVERT4": {
+        "vertices": [(0, 2), (2, 0), (2, 2), (4, 2)],
+        "edges": [(0, 2), (1, 2), (2, 3)],
