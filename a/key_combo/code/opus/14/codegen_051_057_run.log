+    r1 = min(h, h - dr)
+    c0 = max(0, -dc)
+    c1 = min(w, w - dc)
+    return r0, r1, c0, c1
+
+
+def _best_translation(g: np.ndarray, missing: int = BG) -> tuple[tuple[int, int], list[tuple[int, int]], int]:
