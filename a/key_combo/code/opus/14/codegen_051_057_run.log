+
+def _scene_is_semantically_valid(grid: np.ndarray) -> bool:
+    try:
+        g, control, rows, cols, sprite_map, obstacle_grid = _extract_scene(grid)
+        out, records = _transform_with_records(grid)
+    except AssertionError:
