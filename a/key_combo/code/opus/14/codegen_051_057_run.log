+def _seed_ok(mask: np.ndarray) -> bool:
+    area = int(mask.size)
+    ones = int(mask.sum())
+    if ones < 2 or ones > area - 2:
+        return False
+    if ones == 0 or ones == area:
+        return False
+    asym_ud, asym_lr = _axis_asymmetric(mask)
+    return asym_ud and asym_lr
