+    crop_left = left[r0 : r0 + bbox_h, c0 : c0 + bbox_w]
+    if np.sum((crop_left == TEAL) & (crop_right == BLUE)) < 1:
+        return None
+    if np.sum((crop_left == TEAL) & (crop_right == BLACK)) < 1:
+        return None
+    if np.sum(right == BLUE) < 4 or np.sum(right == BLACK) < 4:
+        return None
