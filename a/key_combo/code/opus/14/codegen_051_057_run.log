+def _layer_index_grid(h: int, w: int) -> np.ndarray:
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    return np.minimum(np.minimum(rows, cols), np.minimum(h - 1 - rows, w - 1 - cols))
