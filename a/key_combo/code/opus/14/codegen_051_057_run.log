+def _obstacle_from_template(
+    shape: tuple[tuple[int, int], ...],
+    pivot_code: int,
+) -> set[tuple[int, int]]:
+    pivot = (pivot_code // 100, pivot_code % 100)
+    return {(pivot[0] + r, pivot[1] + c) for r, c in shape}
