+
+def _sample_counts_and_frame(
+    rng: np.random.Generator,
+) -> tuple[
+    tuple[int, int, int, int],
+    tuple[int, int],
+    dict[int, int],
+]:
+    exact_fit = bool(rng.integers(0, 2))
+    if exact_fit:
+        interior_h = 8
+        interior_w = 8 if bool(rng.integers(0, 2)) else int(rng.integers(8, 11))
+        n_colors = 4
