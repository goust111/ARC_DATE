+        return False
+    for rect in ranked[2:]:
+        block = expected[rect.r0 : rect.r1 + 1, rect.c0 : rect.c1 + 1]
+        if np.any(block == YELLOW):
+            return False
+        if np.count_nonzero(block == BLUE) != 4:
