+            assert int(out[r1, c]) == BG, "horizontal path cells must be background in the input"
+            out[r1, c] = GREY
+        for r in range(r1 + 1, r2):
+            assert int(out[r, c2]) == BG, "vertical path cells must be background in the input"
+            out[r, c2] = GREY
+
