+    )
+    if not (left_blocked or right_blocked):
+        return False
+
+    left_side_blue = np.any(out[:, 1 : g.shape[1] // 2] == RIGHT_WALL)
+    right_side_red = np.any(out[:, g.shape[1] // 2 : -1] == LEFT_WALL)
+    if not (left_side_blue and right_side_red):
+        return False
+
+    return True
