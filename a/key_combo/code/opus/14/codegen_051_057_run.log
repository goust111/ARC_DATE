+
+
+def pick_spaced_cells(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    out: list[tuple[int, int]] = []
+    for cell in candidates:
+        if all(max(abs(cell[0] - r), abs(cell[1] - c)) >= 2 for r, c in out):
+            out.append(cell)
+            if len(out) == count:
