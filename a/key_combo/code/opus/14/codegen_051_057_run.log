+    for a, b in pairs:
+        path = set(_line_cells(a, b)[1:-1])
+        line_trigger_count = 0
+        for pt in magenta_points:
+            if pt in path:
+                memberships[pt] += 1
+                line_trigger_count += 1
+        if line_trigger_count > 1:
