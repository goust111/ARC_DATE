+            frontier = []
+            for r, c in cells:
+                for dr, dc in NEIGHBORS4:
+                    nxt = (r + dr, c + dc)
+                    if nxt not in cells:
+                        frontier.append(nxt)
+            cells.add(rng.choice(frontier))
