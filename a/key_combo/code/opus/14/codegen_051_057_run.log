+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+PALETTE = (1, 2, 3, 5, 6, 7, 8, 9)
+EMITTER_COLOR = 4
+BACKGROUND = 0
+GEN_ATTEMPTS = 300
+TRACE_LIMIT = 800
+
+
