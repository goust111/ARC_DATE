+        if not (3 <= len(glyphs) <= 5):
+            return False
+        parsed = sorted((g["source_id"], g["target_id"], g["area"], g["color"]) for g in glyphs)
+        expected = sorted((m["source_id"], m["target_id"], m["area"], m["color"]) for m in metadata)
+        if parsed != expected:
+            return False
