+BLACK = 0
+GREY = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+AREA_TO_REGION = {3: 1, 4: 2, 5: 3, 6: 4, 7: 5, 8: 6}
+REGION_TO_AREA = {region: area for area, region in AREA_TO_REGION.items()}
+GLYPH_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
