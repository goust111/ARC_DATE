+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+ORANGE = 7
+
+CARDINALS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+
+SIDE_ORDER = ("up", "right", "down", "left")
