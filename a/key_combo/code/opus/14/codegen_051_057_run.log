+        cell = random.choice(choices)
+        masks.add(cell)
+        mask_counts[orbit] += 1
+
+    return masks
+
+
+def _render_input_and_output(
+    clean: np.ndarray,
+    orbit_colors: dict[tuple[tuple[int, int], ...], int],
+    markers: list[dict],
+    masks: set[tuple[int, int]],
