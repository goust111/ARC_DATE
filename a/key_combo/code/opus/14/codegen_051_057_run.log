+    template_index = int(np.random.randint(sprite_count))
+    sprites[template_index], sprites[-1] = sprites[-1], sprites[template_index]
+
+    grid_h = int(np.random.randint(18, 27))
+    grid_w = int(np.random.randint(20, 27))
