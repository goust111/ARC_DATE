+    vertex_cols = sorted({c for _, c in vertices})
+    anchor_rows = sorted({r for r, _ in anchors})
+    anchor_cols = sorted({c for _, c in anchors})
+    assert len(vertex_rows) == len(anchor_rows)
+    assert len(vertex_cols) == len(anchor_cols)
