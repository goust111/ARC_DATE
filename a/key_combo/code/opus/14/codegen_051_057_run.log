+
+def _best_translation(g: np.ndarray, missing: int = BG) -> tuple[tuple[int, int], list[tuple[int, int]], int]:
+    h, w = g.shape
+    best_support = -1
+    best: list[tuple[int, int]] = []
+    for dr in range(-(h - 1), h):
+        for dc in range(-(w - 1), w):
+            if dr == 0 and dc == 0:
+                continue
+            r0, r1, c0, c1 = _overlap_slices(g.shape, dr, dc)
+            if r0 >= r1 or c0 >= c1:
+                continue
+            a = g[r0:r1, c0:c1]
+            b = g[r0 + dr : r1 + dr, c0 + dc : c1 + dc]
+            visible = (a != missing) & (b != missing)
+            support = int(np.count_nonzero(visible))
+            if support == 0:
+                continue
+            if not np.all(a[visible] == b[visible]):
+                continue
+            if support > best_support:
+                best_support = support
+                best = [(int(dr), int(dc))]
+            elif support == best_support:
+                best.append((int(dr), int(dc)))
