from __future__ import annotations

import random
from typing import Sequence

import numpy as np


SEED_COLORS = (6, 7)
SEPARATOR_COLOR = 5
BASE_PALETTE = (1, 2, 3, 4, 8, 9)

BASE_ROWS_RANGE = (6, 8)
BASE_COLS_RANGE = (6, 8)
RUN_CHOICES = (2, 3)
