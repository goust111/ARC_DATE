+) -> tuple[np.ndarray, np.ndarray, tuple[int, int, int, int], str, str]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert set(map(int, np.unique(g))) <= {BACKGROUND, RED}, "input must contain only black and red"
+
+    coords = np.argwhere(g == RED)
+    assert coords.shape == (3, 2), "expected exactly three red marker pixels"
+    assert int(np.count_nonzero(g)) == 3, "only the three markers may be non-background"
+
+    bbox = _bbox_from_coords(coords)
+    r0, c0, r1, c1 = bbox
+    assert r1 - r0 + 1 >= 4 and c1 - c0 + 1 >= 4, "bbox must be at least 4x4"
+
+    side_counts = {side: 0 for side in ("top", "bottom", "left", "right")}
+    for r_raw, c_raw in coords:
+        side_counts[_side_of_point(int(r_raw), int(c_raw), bbox)] += 1
+
+    pair_sides = [side for side, count in side_counts.items() if count == 2]
+    single_sides = [side for side, count in side_counts.items() if count == 1]
+    assert len(pair_sides) == 1 and len(single_sides) == 1, "marker distribution must be 2-vs-1"
+
+    pair_side = pair_sides[0]
+    single_side = single_sides[0]
+    assert _opposite(pair_side) == single_side, "single marker must be on the side opposite the pair"
+    return g, coords, bbox, pair_side, single_side
