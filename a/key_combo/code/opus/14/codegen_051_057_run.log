0034: 
0035:     a, b = comps
0036:     ar0, ac0, ar1, ac1 = a["bbox"]
0037:     br0, bc0, br1, bc1 = b["bbox"]
0038:     assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)
0039: 
