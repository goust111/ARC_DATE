+    if pair_side in ("left", "right") and (c1 - c0 + 1) % 2 == 1:
+        mid = (c0 + c1) // 2
+        assert int(out[r0, mid]) == GREEN and int(out[r1, mid]) == GREEN
+
+
+def generate_input() -> np.ndarray:
