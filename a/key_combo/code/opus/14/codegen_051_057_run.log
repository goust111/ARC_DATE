+
+def _outside_cell(edge: tuple[tuple[int, int], tuple[int, int]]) -> tuple[int, int]:
+    (r1, c1), (r2, c2) = edge
+    if r1 == r2 and c2 == c1 + 1:
+        return (r1 - 1, c1)
+    if c1 == c2 and r2 == r1 + 1:
+        return (r1, c1)
+    if r1 == r2 and c2 == c1 - 1:
+        return (r1, c2)
+    assert c1 == c2 and r2 == r1 - 1
+    return (r2, c1 - 1)
