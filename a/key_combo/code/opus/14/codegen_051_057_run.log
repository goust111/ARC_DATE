+    expected = _expected_from_meta(frames)
+    if max(expected.shape) > 30:
+        return None
+    if not _matches_metadata(grid, frames, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt()
+        if grid is not None:
