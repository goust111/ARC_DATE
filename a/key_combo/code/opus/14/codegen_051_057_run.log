+        return None
+    left_components = _components(grid[:, :ctl_left - 1] != 0, connectivity=8)
+    if not (3 <= len(left_components) <= 4):
+        return None
+    symmetric_count = 0
+    for coords in left_components:
+        sprite = _mask_from_coords(coords)
