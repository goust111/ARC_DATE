+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+GRID_SHAPE = (16, 16)
+BAND_HEIGHT = 4
+BAND_COLORS = (2, 1, 3, 4)
+PRIORITY = (0, 1, 3, 2)
+NATURAL_PRIORITY = (0, 1, 2, 3)
