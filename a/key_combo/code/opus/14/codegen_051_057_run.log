+        "kind": "merge",
+        "height": proto["height"],
+        "width": proto["width"],
+        "input_cells": colors,
+        "future_cells": set(proto["future"]),
+        "singleton": proto["singleton"],
+        "marker_local": marker,
+        "future_interiors": list(proto["interior_after"]),
