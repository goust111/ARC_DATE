+    if totals is None:
+        return None
+
+    left = _build_left_panel(mask, selected_map, totals)
+    grid = _render_input(left, mask)
+    _validate_semantics(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
