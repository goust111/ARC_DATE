+            j += 1
+        rows.append(row.copy())
+        runs.append(j - i)
+        i = j
+
+    out = np.stack(rows, axis=0)
+    return out, runs
+
+
+def _nearest_fill_rows(comp: np.ndarray) -> np.ndarray:
+    h, w = comp.shape
+    seed_rows = [(r, int(comp[r, 0])) for r in range(h) if _is_seed_row(comp[r])]
+    assert 2 <= len(seed_rows) <= 3, "expected 2-3 seed rows after compression"
+
+    out = np.empty_like(comp)
+    for r in range(h):
+        if _is_seed_row(comp[r]):
+            out[r, :] = comp[r, 0]
+            continue
+
+        distances = [abs(r - sr) for sr, _color in seed_rows]
+        best = min(distances)
+        nearest_colors = [color for (sr, color), dist in zip(seed_rows, distances) if dist == best]
+        if len(set(nearest_colors)) == 1:
+            out[r, :] = nearest_colors[0]
+        else:
+            out[r, :] = SEPARATOR_COLOR
+    assert out.shape == (h, w)
+    return out
+
+
+def _expand(grid: np.ndarray, row_runs: Sequence[int], col_runs: Sequence[int]) -> np.ndarray:
+    return np.repeat(np.repeat(grid, row_runs, axis=0), col_runs, axis=1)
+
+
+def _solve_core(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, list[int], list[int]]:
+    cols_compressed, col_runs = _compress_columns(grid)
+    comp, row_runs = _compress_rows_with_seed_groups(cols_compressed)
+    filled = _nearest_fill_rows(comp)
+    return comp, filled, row_runs, col_runs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Compress duplicated row/column runs, fill rows from the nearest seed strip, then re-expand by the original run lengths.
+
+    Input structure:
+    - The grid has no black background and is formed by repeating each row and each column of a smaller color pattern 2-3 times.
+    - Some repeated row groups have one internal row replaced by a full-width seed strip in magenta(6) or orange(7).
+    - Adjacent equal rows/columns encode the hidden compression factors; seed strips interrupt only row groups.
+
+    Rule:
+    - Collapse identical adjacent column runs to one column each, and collapse row groups by treating a `pattern, seed, pattern` triple as one repeated row group of length 3.
+    - In the compressed grid, keep each seed strip as its row and recolor every other row by the nearest seed-strip row using compressed-row distance.
+    - If a row is equally close to nearest seed strips of different colors, recolor the whole row grey(5); equal-distance same-color ties keep that shared seed color.
+    - Re-expand the filled compressed grid by the recorded row and column run lengths.
+
+    Key insight:
+    - Visual pixel distance is misleading because row groups were stretched before one copy was overwritten; the correct nearest-seed partition only appears after undoing the hidden row/column duplication.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] > 0 and g.shape[1] > 0
+    assert max(g.shape) <= 30
+
+    _comp, filled, row_runs, col_runs = _solve_core(g)
+    out = _expand(filled, row_runs, col_runs)
+    assert out.shape == g.shape
+    return out
+
+
+def _generate_base_pattern(rows: int, cols: int, n_colors: int) -> np.ndarray | None:
+    palette = random.sample(BASE_PALETTE, n_colors)
+    for _ in range(200):
+        base = np.array([[random.choice(palette) for _ in range(cols)] for _ in range(rows)], dtype=int)
+        if len(set(map(int, base.flat))) != n_colors:
+            continue
+        if any(len(set(map(int, base[r]))) < 2 for r in range(rows)):
+            continue
+        if any(len(set(map(int, base[:, c]))) < 2 for c in range(cols)):
+            continue
+        if any(np.array_equal(base[r], base[r + 1]) for r in range(rows - 1)):
+            continue
+        if any(np.array_equal(base[:, c], base[:, c + 1]) for c in range(cols - 1)):
+            continue
+        return base
+    return None
+
+
+def _choose_seed_layout(rows: int) -> tuple[list[int], list[int]] | None:
+    scenario = random.choice(("two_diff", "three_alt", "three_pair"))
+
+    if scenario == "two_diff":
+        gap = random.choice((3, 4, 5))
+        start_choices = [r for r in range(rows - gap)]
+        if not start_choices:
+            return None
+        r0 = random.choice(start_choices)
+        positions = [r0, r0 + gap]
+        colors = [6, 7] if random.random() < 0.5 else [7, 6]
+        return positions, colors
+
+    if rows < 7:
+        scenario = "two_diff"
+
+    if scenario == "three_alt":
+        for _ in range(100):
+            positions = sorted(random.sample(range(rows), 3))
+            gaps = [positions[1] - positions[0], positions[2] - positions[1]]
+            if min(gaps) < 2:
+                continue
+            if any(g < 3 for g, a, b in zip(gaps, (6, 7), (7, 6)) if a != b):
+                continue
+            colors = random.choice(([6, 7, 6], [7, 6, 7]))
+            return positions, list(colors)
+        return None
+
+    for _ in range(100):
+        positions = sorted(random.sample(range(rows), 3))
+        gaps = [positions[1] - positions[0], positions[2] - positions[1]]
+        color_triplets = ([6, 6, 7], [7, 7, 6], [6, 7, 7], [7, 6, 6])
+        colors = list(random.choice(color_triplets))
+        ok = True
+        for gap, c0, c1 in zip(gaps, colors, colors[1:]):
+            if c0 != c1 and gap < 3:
+                ok = False
+        if ok and min(gaps) >= 2:
+            return positions, colors
+    return None
+
+
+def _row_runs_for_seed_positions(rows: int, seed_rows: Sequence[int]) -> list[int]:
+    seed_set = set(seed_rows)
+    runs = []
+    for r in range(rows):
+        if r in seed_set:
+            runs.append(3)
+        else:
+            runs.append(random.choice(RUN_CHOICES))
+    if len(set(runs)) == 1:
+        idx = random.choice([r for r in range(rows) if r not in seed_set])
+        runs[idx] = 2 if runs[idx] == 3 else 3
+    return runs
+
+
+def _col_runs(cols: int) -> list[int]:
+    runs = [random.choice(RUN_CHOICES) for _ in range(cols)]
+    if len(set(runs)) == 1:
+        runs[random.randrange(cols)] = 2 if runs[0] == 3 else 3
+    return runs
+
+
+def _render_input(
+    base: np.ndarray,
+    row_runs: Sequence[int],
+    col_runs: Sequence[int],
+    seed_rows: Sequence[int],
+    seed_colors: Sequence[int],
+) -> np.ndarray:
+    inp = _expand(base, row_runs, col_runs)
+    row_offsets = np.cumsum([0, *row_runs[:-1]])
+    for base_r, color in zip(seed_rows, seed_colors):
+        expanded_r = int(row_offsets[base_r] + 1)
+        inp[expanded_r, :] = int(color)
+    return inp
+
+
+def _naive_pixel_distance_fill(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    seed_rows = [(r, int(g[r, 0])) for r in range(g.shape[0]) if _is_seed_row(g[r])]
+    out = np.empty_like(g)
+    for r in range(g.shape[0]):
+        if _is_seed_row(g[r]):
+            out[r, :] = g[r, 0]
+            continue
+        distances = [abs(r - sr) for sr, _color in seed_rows]
+        best = min(distances)
+        nearest_colors = [color for (sr, color), dist in zip(seed_rows, distances) if dist == best]
+        out[r, :] = nearest_colors[0] if len(set(nearest_colors)) == 1 else SEPARATOR_COLOR
+    return out
+
+
+def _simple_row_compress_count(grid: np.ndarray) -> int:
+    starts, _runs = _run_starts(grid)
+    return len(starts)
+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    base: np.ndarray,
+    row_runs: Sequence[int],
+    col_runs: Sequence[int],
+    seed_rows: Sequence[int],
+    seed_colors: Sequence[int],
+) -> bool:
+    if inp.ndim != 2 or max(inp.shape) > 30:
+        return False
+
+    cols_compressed, detected_col_runs = _compress_columns(inp)
+    if list(detected_col_runs) != list(col_runs):
+        return False
+
+    comp, filled, detected_row_runs, _ = _solve_core(inp)
+    if comp.shape != base.shape:
+        return False
+    if list(detected_row_runs) != list(row_runs):
+        return False
+
+    if [r for r in range(comp.shape[0]) if _is_seed_row(comp[r])] != list(seed_rows):
+        return False
+    if [int(comp[r, 0]) for r in seed_rows] != list(seed_colors):
+        return False
+
+    expected = _expand(filled, row_runs, col_runs)
+    if not np.array_equal(main(inp), expected):
+        return False
+
+    if np.array_equal(_naive_pixel_distance_fill(inp), expected):
+        return False
+
+    if _simple_row_compress_count(cols_compressed) == len(row_runs):
+        return False
+
+    if len(set(map(int, expected.flat))) < 2:
+        return False
+
+    if np.array_equal(inp, expected):
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rows = random.randint(*BASE_ROWS_RANGE)
+    cols = random.randint(*BASE_COLS_RANGE)
+
+    seed_layout = _choose_seed_layout(rows)
+    if seed_layout is None:
+        return None
+    seed_rows, seed_colors = seed_layout
+
+    base = _generate_base_pattern(rows, cols, random.choice((2, 3)))
+    if base is None:
+        return None
+
+    row_runs = _row_runs_for_seed_positions(rows, seed_rows)
+    col_runs = _col_runs(cols)
+    inp = _render_input(base, row_runs, col_runs, seed_rows, seed_colors)
+
+    if not _semantic_checks(inp, base, row_runs, col_runs, seed_rows, seed_colors):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

diff --git a/key_combo/code/opus/14/051/10.py b/key_combo/code/opus/14/051/10.py
new file mode 100644
index 0000000000000000000000000000000000000000..a13738deebd0a1bfd1bf9c2a78ea1dcd431cdcf5
--- /dev/null
+++ b/key_combo/code/opus/14/051/10.py
@@ -0,0 +1,466 @@
+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+def _run_starts_and_counts(lines: np.ndarray) -> tuple[list[int], np.ndarray]:
+    starts = [0]
+    counts: list[int] = []
+    count = 1
+    for idx in range(1, lines.shape[0]):
+        if np.array_equal(lines[idx], lines[idx - 1]):
+            count += 1
+        else:
+            counts.append(count)
+            starts.append(idx)
+            count = 1
+    counts.append(count)
+    return starts, np.array(counts, dtype=int)
+
+
+def _compress_grid(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    row_starts, row_runs = _run_starts_and_counts(grid)
+    row_compressed = grid[row_starts, :]
+    col_starts, col_runs = _run_starts_and_counts(row_compressed.T)
+    compressed = row_compressed[:, col_starts]
+    return compressed, row_runs, col_runs
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _find_wallpaper_colors(grid: np.ndarray) -> tuple[int, int]:
+    counts = Counter(map(int, grid.flat))
+    colors = [int(color) for color, _ in counts.most_common(2)]
+    assert len(colors) == 2, "expected exactly two wallpaper colors to dominate the compressed grid"
+    return colors[0], colors[1]
+
+
+def _extract_rectangles(grid: np.ndarray, wallpaper_colors: tuple[int, int]) -> list[dict]:
+    wallpaper = set(map(int, wallpaper_colors))
+    comps = _components(~np.isin(grid, list(wallpaper)))
+    items: list[dict] = []
+    for coords in comps:
+        colors = {int(grid[r, c]) for r, c in coords}
+        assert len(colors) == 1, "foreground component must be monochrome"
+        color = next(iter(colors))
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        local = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+        if np.all(local):
+            kind = "solid"
+        else:
+            border = np.zeros_like(local, dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            assert np.array_equal(local, border), "foreground component must be a solid rectangle or a hollow frame"
+            kind = "frame"
+        items.append(
+            {
+                "color": int(color),
+                "kind": kind,
+                "h": int(h),
+                "w": int(w),
+                "area": int(h * w),
+                "r0": int(r0),
+                "c0": int(c0),
+                "r1": int(r1),
+                "c1": int(c1),
+            }
+        )
+    items.sort(key=lambda item: item["area"], reverse=True)
+    areas = [item["area"] for item in items]
+    assert len(items) >= 3 and len(areas) == len(set(areas)), "need 3-4 rectangles with unique compressed bbox areas"
+    return items
+
+
+def _usable_region(item: dict, top: int, left: int) -> tuple[int, int, int, int]:
+    if item["kind"] == "frame":
+        return int(top + 1), int(left + 1), int(item["h"] - 2), int(item["w"] - 2)
+    return int(top), int(left), int(item["h"]), int(item["w"])
+
+
+def _draw_item(canvas: np.ndarray, item: dict, top: int, left: int, clip_right: int) -> None:
+    h, w, color = int(item["h"]), int(item["w"]), int(item["color"])
+    for dr in range(h):
+        rr = top + dr
+        if rr < 0 or rr >= canvas.shape[0]:
+            continue
+        for dc in range(w):
+            cc = left + dc
+            if cc < 0 or cc >= canvas.shape[1] or cc > clip_right:
+                continue
+            if item["kind"] == "solid" or dr in (0, h - 1) or dc in (0, w - 1):
+                canvas[rr, cc] = color
+
+
+def _render_nested(items: list[dict]) -> np.ndarray:
+    outer = items[0]
+    canvas = np.zeros((int(outer["h"]), int(outer["w"])), dtype=int)
+    top = 0
+    left = 0
+    _draw_item(canvas, outer, top, left, outer["w"] - 1)
+    prev_top, prev_left = top, left
+
+    for idx in range(1, len(items)):
+        parent = items[idx - 1]
+        item = items[idx]
+        ur, uc, uh, uw = _usable_region(parent, prev_top, prev_left)
+        assert item["h"] <= uh and item["w"] <= uw, "child must fit in the parent's unshifted usable region"
+        top = int(ur + uh - item["h"])
+        left = int(uc + item["offset"])
+        clip_right = int(uc + uw - 1)
+        _draw_item(canvas, item, top, left, clip_right)
+        prev_top, prev_left = top, left
+
+    return canvas
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Compress a wallpaper grid, read row-duplication offsets, and rebuild the rectangles as a shifted nesting.
+
+    Input structure:
+    - The grid is a 2-color wallpaper made of black/gray periodic cells, overlaid by 3-4 non-wallpaper rectangles.
+    - Each foreground rectangle is either a solid block or a hollow rectangular frame with a unique color.
+    - The whole scene has been expanded by repeating adjacent identical rows and columns.
+
+    Rule:
+    - Collapse every maximal run of identical neighboring rows and columns, keeping only the first row/column of each run.
+    - In the compressed grid, ignore the two wallpaper colors and detect each monochrome rectangular component.
+    - Sort those rectangles by compressed bbox area from largest to smallest, create a black canvas the size of the largest one,
+      then place the chain largest-first: the largest at the top-left, each later rectangle bottom-aligned in the previous
+      rectangle's usable lower-left corner, but shifted right by the sum of removed duplicate rows across that rectangle's
+      original compressed row span; pixels beyond the parent's usable right edge are clipped.
+
+    Key insight:
+    - Compression is not just cleanup: the dropped row repetitions encode the horizontal offsets needed for the nesting layout.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    compressed, row_runs, _col_runs = _compress_grid(g)
+    wallpaper = _find_wallpaper_colors(compressed)
+    items = _extract_rectangles(compressed, wallpaper)
+    for item in items:
+        item["offset"] = int(np.sum(row_runs[item["r0"] : item["r1"] + 1] - 1))
+    offsets = [item["offset"] for item in items]
+    assert len(offsets) == len(set(offsets)) and max(offsets) <= 3, "row-duplication offsets must be unique and small"
+    return _render_nested(items)
+
+
+_RNG = np.random.default_rng()
+_FG_COLORS = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+_GEN_ATTEMPTS = 600
+
+
+def _choice(rng: np.random.Generator, seq):
+    return seq[int(rng.integers(len(seq)))]
+
+
+def _usable_dims(kind: str, h: int, w: int) -> tuple[int, int]:
+    if kind == "frame":
+        return h - 2, w - 2
+    return h, w
+
+
+def _build_items(rng: np.random.Generator) -> list[dict] | None:
+    count = int(rng.integers(3, 5))
+    colors = list(map(int, rng.choice(_FG_COLORS, size=count, replace=False)))
+
+    kinds = ["frame"]
+    for idx in range(1, count):
+        if idx == count - 1:
+            kinds.append("solid")
+        else:
+            kinds.append(_choice(rng, ["solid", "frame"]))
+    if "solid" not in kinds[1:]:
+        kinds[-1] = "solid"
+
+    outer_h = int(rng.integers(8, 12 + 1))
+    outer_w = int(rng.integers(8, 12 + 1))
+    items = [{"kind": "frame", "h": outer_h, "w": outer_w, "area": outer_h * outer_w}]
+    used_areas = {outer_h * outer_w}
+
+    def rec(parent: dict, kind_seq: list[str], acc: list[dict]) -> list[dict] | None:
+        if not kind_seq:
+            return acc
+        ph, pw = _usable_dims(parent["kind"], int(parent["h"]), int(parent["w"]))
+        kind = kind_seq[0]
+        h_min = 3 if kind == "frame" else 2
+        w_min = 3 if kind == "frame" else 2
+        if ph < h_min or pw < w_min:
+            return None
+
+        candidates = [
+            (h, w)
+            for h in range(h_min, ph + 1)
+            for w in range(w_min, pw + 1)
+            if h * w < parent["area"] and h * w not in used_areas
+        ]
+        rng.shuffle(candidates)
+        for h, w in candidates:
+            item = {"kind": kind, "h": int(h), "w": int(w), "area": int(h * w)}
+            uh, uw = _usable_dims(kind, int(h), int(w))
+            if len(kind_seq) > 1:
+                next_kind = kind_seq[1]
+                need_h = 3 if next_kind == "frame" else 2
+                need_w = 3 if next_kind == "frame" else 2
+                if uh < need_h or uw < need_w:
+                    continue
+            used_areas.add(item["area"])
+            out = rec(item, kind_seq[1:], acc + [item])
+            if out is not None:
+                return out
+            used_areas.remove(item["area"])
+        return None
+
+    inner = rec(items[0], kinds[1:], [])
+    if inner is None:
+        return None
+    full = items + inner
+    for item, color in zip(full, colors):
+        item["color"] = int(color)
+    return full
+
+
+def _place_items(rng: np.random.Generator, h: int, w: int, items: list[dict]) -> list[tuple[int, int]] | None:
+    placements: list[tuple[int, int]] = []
+    occupied = np.zeros((h, w), dtype=bool)
+    for item in items:
+        ih, iw = int(item["h"]), int(item["w"])
+        candidates = [
+            (r, c)
+            for r in range(1, h - ih)
+            for c in range(1, w - iw)
+            if not occupied[r - 1 : r + ih + 1, c - 1 : c + iw + 1].any()
+        ]
+        if not candidates:
+            return None
+        rng.shuffle(candidates)
+        r, c = candidates[0]
+        placements.append((int(r), int(c)))
+        occupied[r - 1 : r + ih + 1, c - 1 : c + iw + 1] = True
+    return placements
+
+
+def _wallpaper(h: int, w: int, phase: int) -> np.ndarray:
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    return np.where(((rows + cols + phase) % 2) == 0, 0, 5).astype(int)
+
+
+def _paint_input_rect(grid: np.ndarray, item: dict, top: int, left: int) -> None:
+    h, w, color = int(item["h"]), int(item["w"]), int(item["color"])
+    if item["kind"] == "solid":
+        grid[top : top + h, left : left + w] = color
+        return
+    grid[top, left : left + w] = color
+    grid[top + h - 1, left : left + w] = color
+    grid[top : top + h, left] = color
+    grid[top : top + h, left + w - 1] = color
+
+
+def _adjacent_unique(grid: np.ndarray) -> bool:
+    for r in range(grid.shape[0] - 1):
+        if np.array_equal(grid[r], grid[r + 1]):
+            return False
+    for c in range(grid.shape[1] - 1):
+        if np.array_equal(grid[:, c], grid[:, c + 1]):
+            return False
+    return True
+
+
+def _offsets_from_rows(row_runs: np.ndarray, items: list[dict]) -> list[int]:
+    return [
+        int(np.sum(row_runs[int(item["r0"]) : int(item["r1"]) + 1] - 1))
+        for item in items
+    ]
+
+
+def _clip_occurs(items: list[dict], offsets: list[int]) -> bool:
+    placed = [(0, 0)]
+    for idx in range(1, len(items)):
+        parent = items[idx - 1]
+        pr, pc = placed[idx - 1]
+        ur, uc, _uh, uw = _usable_region(parent, pr, pc)
+        if int(items[idx]["w"]) + int(offsets[idx]) > int(uw):
+            return True
+        top = int(ur + _uh - int(items[idx]["h"]))
+        left = int(uc + int(offsets[idx]))
+        placed.append((top, left))
+    return False
+
+
+def _stretch_bbox_area(item: dict, row_runs: np.ndarray, col_runs: np.ndarray) -> int:
+    hh = int(np.sum(row_runs[int(item["r0"]) : int(item["r1"]) + 1]))
+    ww = int(np.sum(col_runs[int(item["c0"]) : int(item["c1"]) + 1]))
+    return int(hh * ww)
+
+
+def _render_with_offsets(items: list[dict], offsets: list[int]) -> np.ndarray:
+    copied = [{**item, "offset": int(offset)} for item, offset in zip(items, offsets)]
+    return _render_nested(copied)
+
+
+def _safe_render(items: list[dict], offsets: list[int]) -> np.ndarray | None:
+    try:
+        return _render_with_offsets(items, offsets)
+    except AssertionError:
+        return None
+
+
+def _semantic_checks(
+    base: np.ndarray,
+    items: list[dict],
+    row_runs: np.ndarray,
+    col_runs: np.ndarray,
+    stretched: np.ndarray,
+) -> bool:
+    compressed, got_row_runs, got_col_runs = _compress_grid(stretched)
+    if not np.array_equal(base, compressed):
+        return False
+    if not np.array_equal(row_runs, got_row_runs) or not np.array_equal(col_runs, got_col_runs):
+        return False
+
+    wallpaper = _find_wallpaper_colors(base)
+    extracted = _extract_rectangles(base, wallpaper)
+    if [(it["kind"], it["h"], it["w"], it["color"]) for it in extracted] != [
+        (it["kind"], it["h"], it["w"], it["color"]) for it in items
+    ]:
+        return False
+
+    offsets = _offsets_from_rows(row_runs, items)
+    if len(offsets) != len(set(offsets)) or max(offsets) > 3 or not any(offset > 0 for offset in offsets[1:]):
+        return False
+
+    expected = _render_with_offsets(items, offsets)
+    if not np.array_equal(main(stretched), expected):
+        return False
+
+    if np.array_equal(_render_with_offsets(items, [0] * len(items)), expected):
+        return False
+
+    stretched_order = sorted(
+        range(len(items)),
+        key=lambda idx: _stretch_bbox_area(items[idx], row_runs, col_runs),
+        reverse=True,
+    )
+    if stretched_order == list(range(len(items))):
+        return False
+
+    wrong_items = [items[idx] for idx in stretched_order]
+    wrong_offsets = [offsets[idx] for idx in stretched_order]
+    wrong_output = _safe_render(wrong_items, wrong_offsets)
+    if wrong_output is not None and np.array_equal(wrong_output, expected):
+        return False
+
+    if max(stretched.shape) > 30 or max(expected.shape) > 30:
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+    want_clip = bool(rng.integers(2))
+    items = _build_items(rng)
+    if items is None:
+        return None
+
+    min_h = max(12, int(max(item["h"] for item in items)) + 2)
+    min_w = max(13, int(max(item["w"] for item in items)) + 2)
+    h = int(rng.integers(min_h, min(16, max(min_h, 16)) + 1))
+    w = int(rng.integers(min_w, min(18, max(min_w, 18)) + 1))
+    placements = _place_items(rng, h, w, items)
+    if placements is None:
+        return None
+
+    base = _wallpaper(h, w, int(rng.integers(2)))
+    for item, (top, left) in zip(items, placements):
+        _paint_input_rect(base, item, top, left)
+        item["r0"] = int(top)
+        item["c0"] = int(left)
+        item["r1"] = int(top + item["h"] - 1)
+        item["c1"] = int(left + item["w"] - 1)
+
+    if not _adjacent_unique(base):
+        return None
+
+    counts = Counter(map(int, base.flat))
+    if counts[0] <= max(counts[int(item["color"])] for item in items):
+        return None
+    if counts[5] <= max(counts[int(item["color"])] for item in items):
+        return None
+
+    for _ in range(1200):
+        row_runs = np.ones(h, dtype=int)
+        extra_rows = int(rng.integers(1, min(6, h) + 1))
+        chosen_rows = rng.choice(h, size=extra_rows, replace=False)
+        for row in chosen_rows:
+            row_runs[int(row)] = 3 if rng.random() < 0.18 else 2
+        offsets = _offsets_from_rows(row_runs, items)
+        if len(offsets) != len(set(offsets)) or max(offsets) > 3 or not any(offset > 0 for offset in offsets[1:]):
+            continue
+        if _clip_occurs(items, offsets) != want_clip:
+            continue
+
+        for _ in range(500):
+            col_runs = np.ones(w, dtype=int)
+            boost_idx = int(rng.integers(1, len(items)))
+            c0 = int(items[boost_idx]["c0"])
+            c1 = int(items[boost_idx]["c1"])
+            boost_width = int(rng.integers(1, c1 - c0 + 2))
+            boosted = rng.choice(np.arange(c0, c1 + 1), size=boost_width, replace=False)
+            col_runs[boosted] = 2
+
+            sprinkle = int(rng.integers(0, min(4, w - boost_width) + 1))
+            if sprinkle > 0:
+                others = [c for c in range(w) if col_runs[c] == 1]
+                if others:
+                    chosen = rng.choice(others, size=min(sprinkle, len(others)), replace=False)
+                    col_runs[chosen] = 2
+
+            stretched = np.repeat(np.repeat(base, row_runs, axis=0), col_runs, axis=1)
+            if not _semantic_checks(base, items, row_runs, col_runs, stretched):
+                continue
+            return stretched
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 10")

