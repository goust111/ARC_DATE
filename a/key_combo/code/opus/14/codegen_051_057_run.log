+        elbow = (r1, c2)
+        offsets = sprites[color]
+        rel_path = _relative_path_cells(c1, c2, r1, r2)
+        if not any(offset not in rel_path for offset in offsets):
+            return False
+        for dr, dc in offsets:
+            cell = (elbow[0] + dr, elbow[1] + dc)
