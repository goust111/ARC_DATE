+    placed_pair = None
+    for (far_rc, near_rc) in pair_positions:
+        temp = grid.copy()
+        if not _place_input_patch(temp, pair_patches[0], far_rc[0], far_rc[1]):
+            continue
+        if not _place_input_patch(temp, pair_patches[1], near_rc[0], near_rc[1]):
