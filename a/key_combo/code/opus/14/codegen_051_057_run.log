# exhaustive search for sample config pairs
from itertools import product

def perimeter_coords(box):
    r0,c0,r1,c1=box
    pts=[]
    for c in range(c0,c1+1): pts.append((r0,c)); pts.append((r1,c))
    for r in range(r0+1,r1): pts.append((r,c0)); pts.append((r,c1))
    return pts

def side_positions(box, side):
    r0,c0,r1,c1=box
    if side=='top': return [(r0,c) for c in range(c0+1,c1)]
    if side=='bottom': return [(r1,c) for c in range(c0+1,c1)]
    if side=='left': return [(r,c0) for r in range(r0+1,r1)]
    return [(r,c1) for r in range(r0+1,r1)]

def legal_gap_positions(box):
    return set(side_positions(box,'top')+side_positions(box,'bottom')+side_positions(box,'left')+side_positions(box,'right'))

def box_contains(box,p):
    r,c=p; r0,c0,r1,c1=box
    return r0<=r<=r1 and c0<=c<=c1

def emitter_dir(box,p):
    r,c=p; r0,c0,r1,c1=box
    mr=(r0+r1)/2.0; mc=(c0+c1)/2.0
    if r==r0: return (-1,-1 if c<mc else 1)
    if r==r1: return (1,-1 if c<mc else 1)
    if c==c0: return (-1 if r<mr else 1,-1)
    return (-1 if r<mr else 1,1)

def build_maps(boxes, colors, gaps, emitter):
    wall={}; owner={}; gapset=set()
    for i,(box,col,gap) in enumerate(zip(boxes,colors,gaps)):
        for p in perimeter_coords(box):
            owner[p]=i
            if gap is not None and p==gap: gapset.add(p)
            else: wall[p]=4 if p==emitter else col
    if emitter not in wall: wall[emitter]=4; owner[emitter]=0
    return wall,owner,gapset

def boundary_kind(box,p):
    r,c=p; r0,c0,r1,c1=box
    if (r,c) in {(r0,c0),(r0,c1),(r1,c0),(r1,c1)}: return 'corner'
    if r in (r0,r1): return 'horizontal'
    return 'vertical'

def region_id(p, boxes, owner):
    if p in owner: return None
    if box_contains(boxes[0], p): return None
    for i in range(len(boxes)-1):
        if box_contains(boxes[i+1], p) and not box_contains(boxes[i], p): return i
    if not box_contains(boxes[-1], p): return len(boxes)-1
    return None

def simulate(H,W,boxes,colors,gaps,emitter,max_steps=500):
    wall,owner,gapset=build_maps(boxes,colors,gaps,emitter)
    pos=emitter; dr,dc=emitter_dir(boxes[0],emitter); color=4; cur_region=None; entry_color=None; fills=[]; hits=[]; gap_cross=[]; seen=set()
    for step in range(max_steps):
        st=(pos,dr,dc,color,cur_region)
        if st in seen: return None
        seen.add(st)
        nxt=(pos[0]+dr,pos[1]+dc)
        if not (0<=nxt[0]<H and 0<=nxt[1]<W):
            if cur_region is not None and cur_region not in [r for r,_ in fills]: fills.append((cur_region,entry_color))
            return {'fills':fills,'hits':hits,'gap_cross':gap_cross,'steps':step+1}
        if nxt in owner:
            if nxt in gapset:
                if cur_region is not None and cur_region not in [r for r,_ in fills]: fills.append((cur_region,entry_color))
                pos=nxt; cur_region=None; gap_cross.append(nxt); continue
            color=wall[nxt]; kind=boundary_kind(boxes[owner[nxt]],nxt)
            if kind in ('horizontal','corner'): dr=-dr
            if kind in ('vertical','corner'): dc=-dc
            hits.append((nxt,owner[nxt],kind,color)); continue
        pos=nxt; nr=region_id(pos,boxes,owner)
        if nr"'!=cur_region:
            if cur_region is not None and cur_region not in [r for r,_ in fills]: fills.append((cur_region,entry_color))
            cur_region=nr
            if nr is not None: entry_color=color
    return None

boxes=[(8,8,14,14),(5,5,17,17),(2,2,20,20)]
colors=[2,1,3]
gap0=(8,10); emitter=(8,12)
leg1=legal_gap_positions(boxes[1]); leg2=legal_gap_positions(boxes[2])
sol=[]
for g1,g2 in product(leg1,leg2):
    res=simulate(26,26,boxes,colors,[gap0,g1,g2],emitter)
    if res and len(res['"'fills'])==3 and len(res['gap_cross'])==2 and res['gap_cross'][0]==g1 and res['gap_cross'][1]==g2:
        cols=[c for _,c in res['fills']]
        if len(set(cols))>=2 and any(c"'!=4 for c in cols):
            sol.append((g1,g2,cols,[h[2] for h in res['"'hits']]))
            if len(sol)>=20: break
print('solutions',len(sol))
for s in sol[:10]: print(s)
