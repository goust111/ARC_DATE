+
+
+def _changed_cells(
+    inp: np.ndarray,
+    out: np.ndarray,
+    boxes: list[list[tuple[int, int, int, int]]],
+    fill_color: int,
+) -> set[tuple[int, int]]:
+    changed = np.argwhere((inp != out) & (out == fill_color))
+    cells: set[tuple[int, int]] = set()
+    for r, c in changed:
+        try:
+            cells.add(_cell_of(boxes, int(r), int(c)))
+        except AssertionError:
