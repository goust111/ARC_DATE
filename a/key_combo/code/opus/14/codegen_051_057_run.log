+    dr, dc = direction
+    path: list[tuple[int, int]] = []
+    while 0 <= r < n and 0 <= c < n:
+        path.append((r, c))
+        r += dr
+        c += dc
+    return path
+
+
+def _pattern_from_orbits(size: int) -> np.ndarray:
