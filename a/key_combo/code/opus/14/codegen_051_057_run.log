+                colored = sprite.copy()
+                sprite_coords = np.argwhere(colored != BG)
+                sprite_box = (
+                    ir0 + int(sprite_coords[:, 0].min()),
+                    ic0 + int(sprite_coords[:, 1].min()),
+                    ir0 + int(sprite_coords[:, 0].max()),
+                    ic0 + int(sprite_coords[:, 1].max()),
