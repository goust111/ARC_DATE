import numpy as np
from collections import deque

def family(H,W,orient,spacing,L,t1,t2):
 g=np.zeros((H,W),int)
 if orient=='\\\\':
  s1=(2,2); s2=(2+spacing,2)
  segs=[s1,s2]
  if s2[0]+L>=H or s1[1]+L>=W:return None
  for sr,sc in segs:
   for k in range(L+1): g[sr+k,sc+k]=1
  trigs=[(s1[0]+t1,s1[1]+t1),(s2[0]+t2,s2[1]+t2)]
  dirs=[(-1,1),(1,-1)]
 else:
  s1=(2,W-3); s2=(2+spacing,W-3)
  if s2[0]+L>=H or s1[1]-L<0:return None
  for sr,sc in [s1,s2]:
   for k in range(L+1): g[sr+k,sc-k]=1
  trigs=[(s1[0]+t1,s1[1]-t1),(s2[0]+t2,s2[1]-t2)]
  dirs=[(-1,-1),(1,1)]
 for tp in trigs:
  for dr,dc in dirs:
   r,c=tp
   while 0<=r<H and 0<=c<W:
    if g[r,c]==0:g[r,c]=6
    r+=dr;c+=dc
  g[tp]=6
 return g

def enclosed(g):
 H,W=g.shape
 seen=np.zeros((H,W),bool);res=[]
 for r in range(H):
  for c in range(W):
   if g[r,c]"'!=0 or seen[r,c]:continue
   q=[(r,c)];seen[r,c]=1;cells=[];touch=False
   while q:
    x,y=q.pop();cells.append((x,y));touch|=x in(0,H-1) or y in(0,W-1)
    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
      nx,ny=x+dx,y+dy
      if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not seen[nx,ny]:seen[nx,ny]=1;q.append((nx,ny))
   if not touch:
    b=set()
    for x,y in cells:
      for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
        nx,ny=x+dx,y+dy
        if 0<=nx<H and 0<=ny<W and g[nx,ny]!=0:b.add(int(g[nx,ny]))
    res.append((len(cells),tuple(sorted(b))))
 return res

for orient in ['"'\\\\','/']:
 print('orient',orient)
 for spacing in range(2,6):
  for L in range(5,11):
   good=[]
   for t1 in range(1,L):
    for t2 in range(1,L):
      g=family(20,20,orient,spacing,L,t1,t2)
      if g is None: continue
      regs=enclosed(g)
      bsets={b for _,b in regs}
      if {(1,), (6,), (1,6)} <= bsets and len(regs)>=2:
        good.append((t1,t2,[(a,b) for a,b in regs]))
   if good:
    print(' spacing',spacing,'L',L,'count',len(good),'example',good[:5])
