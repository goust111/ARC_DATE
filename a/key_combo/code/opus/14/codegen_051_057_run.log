+    for color, area, edge in zip(colors, areas, edges):
+        dims = AREA_TO_DIMS[area][:]
+        rng.shuffle(dims)
+        placed = None
+        for rh, rw in dims:
+            positions = _edge_positions(edge, rh, rw, h, w)
+            rng.shuffle(positions)
