                        continue
                    yield rr + dr, cc + dc
    stack: list[Coord] = [(r0, c0)]
    while stack:
        rr, cc = stack.pop()
        if not (0 <= rr < H and 0 <= cc < W):
            continue
        if int(grid[rr, cc]) != old_col:
            continue
        grid[rr, cc] = new_col
        for nr, nc in nbrs(rr, cc):
            stack.append((nr, nc))


