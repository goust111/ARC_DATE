+    n = board.shape[0]
+    colors = [int(c) for c in np.unique(board)]
+    counts = Counter(map(int, board.flat))
+    candidates: list[tuple[int, int, int, int]] = []
+    for h, w in ((3, 4), (4, 3)):
+        for r0 in range(1, n - h):
