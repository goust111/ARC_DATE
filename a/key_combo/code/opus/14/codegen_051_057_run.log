+
+def _draw_ray(
+    out: np.ndarray,
+    blockers: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    color: int,
+) -> None:
+    h, w = out.shape
+    r, c = start
+    dr, dc = direction
+    while 0 <= r < h and 0 <= c < w and int(blockers[r, c]) != ORANGE:
+        out[r, c] = color
+        r += dr
+        c += dc
