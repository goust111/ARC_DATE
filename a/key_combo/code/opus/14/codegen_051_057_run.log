+    if r0 < 0 or c0 < 0 or r0 + h > grid.shape[0] or c0 + w > grid.shape[1]:
+        return False
+    if _touches_foreground(grid, patch, r0, c0):
+        return False
+    _paste(grid, patch, r0, c0)
+    return True
+
