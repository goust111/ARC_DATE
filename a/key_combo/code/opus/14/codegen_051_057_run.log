+            grid[r, c] = cell_color
+            occupied[r, c] = True
+        return True
+    return False
+
+
+def _choose_pair_rows(h: int, pair_count: int) -> list[tuple[int, int]]:
+    inner_rows = h - 2 * INNER_MARGIN
