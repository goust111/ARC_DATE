+def select_layout(rng: np.random.Generator) -> tuple[list[str], bool]:
+    collision = bool(rng.random() < 0.6)
+    count = 4 if rng.random() < 0.6 else 3
+    if count == 4:
+        return ["tl", "tr", "bl", "br"], collision
+    if collision:
+        options = [
+            ["tl", "tr", "bl"],
+            ["tl", "tr", "br"],
+            ["tl", "bl", "br"],
+            ["tr", "bl", "br"],
+        ]
+        return list(options[int(rng.integers(len(options)))]), collision
+    options = [
+        ["tl", "tr", "bl"],
+        ["tl", "tr", "br"],
+        ["tl", "bl", "br"],
+        ["tr", "bl", "br"],
+    ]
+    return list(options[int(rng.integers(len(options)))]), collision
+
+
+def choose_gaps(
+    rng: np.random.Generator,
+    anchors: list[str],
+    collision: bool,
+    positions: dict[str, tuple[int, int]],
+) -> dict[str, tuple[int, int]] | None:
+    if not collision:
+        return {anchor: OUTWARD_GAPS[anchor][int(rng.integers(2))] for anchor in anchors}
+
+    gaps = {anchor: COLLISION_GAPS[anchor] for anchor in anchors}
+    if {"tl", "tr"}.issubset(anchors):
+        if (positions["tr"][1] - positions["tl"][1]) % 2 == 0:
+            return None
+    if {"bl", "br"}.issubset(anchors):
+        if (positions["br"][1] - positions["bl"][1]) % 2 == 0:
+            return None
+    return gaps
+
+
+def eligible_marker_cells(structure: np.ndarray, coords: np.ndarray) -> list[tuple[int, int]]:
+    h, w = structure.shape
+    chosen: list[tuple[int, int]] = []
+    for r, c in sorted(map(tuple, coords.tolist())):
+        if r in (0, h - 1) or c in (0, w - 1):
+            continue
+        if any(int(structure[nr, nc]) != BG for nr, nc in neighbors8(r, c)):
+            continue
+        chosen.append((r, c))
+    return chosen
+
+
+def pick_spaced_cells(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    out: list[tuple[int, int]] = []
+    for cell in candidates:
+        if all(max(abs(cell[0] - r), abs(cell[1] - c)) >= 2 for r, c in out):
+            out.append(cell)
+            if len(out) == count:
+                return out
+    return None
+
+
+def place_marker_plan(
+    structure: np.ndarray,
+    regions: list[dict],
+) -> list[tuple[int, int, int]] | None:
+    plans = [
+        [4, 2, 4, 2],     # tie, earliest marker color = 4
+        [4, 1, 1, 1, 2],  # strict majority = 1, earliest marker color = 4
+        [2, 4, 4],        # strict majority = 4
+    ]
+    enriched: list[tuple[int, list[tuple[int, int]], dict]] = []
+    for info in regions:
+        eligible = eligible_marker_cells(structure, info["coords"])
+        info["eligible"] = eligible
+        enriched.append((len(eligible), eligible, info))
+    enriched.sort(key=lambda item: item[0], reverse=True)
+    if len(enriched) < 4:
+        return None
+
+    chosen_markers: list[tuple[int, int, int]] = []
+    used_regions: list[dict] = []
+    required_sizes = [len(plan) for plan in plans]
+    viable = [item for item in enriched if item[0] >= 3]
+    if len(viable) < 4:
+        return None
+
+    for plan in plans:
+        placed = False
+        for _size, eligible, info in viable:
+            if info in used_regions:
+                continue
+            cells = pick_spaced_cells(eligible, len(plan))
+            if cells is None:
+                continue
+            for (r, c), color in zip(cells, plan):
+                chosen_markers.append((r, c, color))
+            used_regions.append(info)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    if len(chosen_markers) != 12:
+        return None
+    return chosen_markers
+
+
+def rayless_fill(base: np.ndarray, markers: list[tuple[int, int, int]]) -> np.ndarray:
+    out, _ = fill_regions(base, markers)
+    return out
+
+
+def validate_generated(grid: np.ndarray, require_collision: bool) -> bool:
+    details = solve_with_details(grid)
+    markers = details["markers"]
+    regions = details["regions"]
+    rays = details["rays"]
+
+    if len(markers) != 12:
+        return False
+    if require_collision and not details["collisions"]:
+        return False
+    if len(regions) < 4:
+        return False
+    if sum(1 for region in regions if region["markers"]) != 3:
+        return False
+    if not any(not region["markers"] for region in regions):
+        return False
+    if any(len(ray.path) < 2 for ray in rays):
+        return False
+
+    fills = [region["fill"] for region in regions if region["markers"]]
+    if len(set(fills)) < 2:
+        return False
+
+    marker_regions = [region for region in regions if region["markers"]]
+    tie_regions = []
+    strict_regions = []
+    for region in marker_regions:
+        counts = Counter(color for _r, _c, color in region["markers"])
+        ranked = counts.most_common()
+        if len(ranked) > 1 and ranked[0][1] == ranked[1][1]:
+            tie_regions.append(region)
+        else:
+            strict_regions.append(region)
+    if not tie_regions or len(strict_regions) < 2:
+        return False
+
+    if tie_regions[0]["fill"] != 4:
+        return False
+    if strict_regions[0]["markers"][0][2] == strict_regions[0]["fill"]:
+        return False
+
+    rayless = rayless_fill(details["base"], markers)
+    if np.array_equal(rayless, details["output"]):
+        return False
+
+    _, before_regions = label_regions(details["base"] == BG)
+    if len(before_regions) >= len(regions):
+        return False
+
+    for region in regions:
+        if region["markers"]:
+            region_cells = {tuple(cell) for cell in region["coords"].tolist()}
+            if any((r, c) not in region_cells for r, c, _color in region["markers"]):
+                return False
+    return True
+
+
+def gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(17, 23))
+    w = int(rng.integers(17, 23))
+    positions = choose_positions(rng, h, w)
+    if positions is None:
+        return None
+
+    anchors, collision = select_layout(rng)
+    gaps = choose_gaps(rng, anchors, collision, positions)
+    if gaps is None:
+        return None
+
+    colors = list(rng.choice(BLOCK_COLORS, size=len(anchors), replace=False))
+    grid = np.full((h, w), BG, dtype=int)
+    for anchor, color in zip(anchors, colors):
+        fr, fc = positions[anchor]
+        stamp_block(grid, fr, fc, int(color), gaps[anchor])
+
+    details = solve_with_details(grid)
+    if collision and not details["collisions"]:
+        return None
+    if len(details["regions"]) < 4:
+        return None
+
+    markers = place_marker_plan(details["structure"], details["regions"])
+    if markers is None:
+        return None
+    for r, c, color in markers:
+        grid[r, c] = color
+
+    if not validate_generated(grid, collision):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ray-partition voting grid")

