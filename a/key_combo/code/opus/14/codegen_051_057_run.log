+def _blue_paths_do_not_cross(grid: np.ndarray) -> bool:
+    pairs = _find_blue_pairs(grid)
+    occupied: set[tuple[int, int]] = set()
+    for a, b in pairs:
+        path = set(_line_cells(a, b))
+        if occupied & path:
+            return False
+        occupied |= path
+    return True
