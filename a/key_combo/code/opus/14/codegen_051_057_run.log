+def _slide_to_corner(
+    out: np.ndarray, patch: np.ndarray, start: tuple[int, int], corner_name: str
+) -> tuple[tuple[int, int], int, str]:
+    r, c = start
+    target, _color = CORNER_BY_NAME[corner_name]
+    dr = _sign(target[0] - r)
+    dc = _sign(target[1] - c)
