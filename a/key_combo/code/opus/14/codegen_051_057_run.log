+def _unique_ordered(cells: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    seen: set[tuple[int, int]] = set()
+    out: list[tuple[int, int]] = []
+    for cell in cells:
+        if cell not in seen:
+            seen.add(cell)
+            out.append(cell)
+    return out
