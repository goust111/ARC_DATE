+    coords: list[Coord] = []
+    c_step = 1 if ec > sc else -1
+    for cc in range(sc + c_step, ec + c_step, c_step):
+        coords.append((sr, cc))
+
+    r_step = 1 if er > sr else -1
+    for rr in range(sr + r_step, er + r_step, r_step):
+        coords.append((rr, ec))
+    return coords
