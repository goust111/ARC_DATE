        wrong_seed_cells = mod._coords_to_cells(wrong_meta['edge_seeds'] if wrong_kind == 'edge' else wrong_meta['inner_seeds'], boxes)
        wrong_changed_cells = mod._changed_cells(grid, wrong_out, boxes, wrong_meta['fill_color'])
        print('wrong crosses?', bool(wrong_changed_cells - wrong_seed_cells), wrong_changed_cells, wrong_seed_cells)
        passable_out, _ = mod._simulate(grid, active_kind=active_kind, ignore_obstacles=True)
        print('obstacle matters?', not np.array_equal(passable_out, out))
        print('inactive preserved?', all(int(out[r,c]) == mod.YELLOW for r,c in inactive_seeds))
        comps = mod._obstacle_components(grid)
        print('obs comps', [(c,len(comp), mod._coords_to_cells(comp, boxes)) for c,comp in comps])
        print('main equal oracle?', np.array_equal(mod.main(grid), out))
    except Exception as e:
        print('simulate failed', type(e), e)
