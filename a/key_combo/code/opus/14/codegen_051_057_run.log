+    return True
+
+
+def _side_ranges(
+    side: str,
+    grid_shape: tuple[int, int],
+    blob_shape: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    h, w = map(int, grid_shape)
+    bh, bw = map(int, blob_shape)
+    r0, c0, r1, c1 = frame_bbox
