    n = int(np.random.randint(*GRID_SIZE_RANGE))
    rect_h, rect_w = _gen_rect_dims(n)
    r0 = int(np.random.randint(RECT_EDGE_MARGIN, n - rect_h - RECT_EDGE_MARGIN + 1))
