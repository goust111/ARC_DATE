+
+    if pair_count == 3 and not any(
+        any(offset in _relative_path_cells(c1, c2, r1, r2) for offset in sprite_offsets_by_color[color])
+        for color, (r1, r2), (c1, c2) in zip(colors, row_pairs, col_pairs)
