+
+BG = 0
+GREY = 5
+ANCHOR = 8
+PALETTE = [1, 2, 3, 4, 6, 7, 9]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GEN_ATTEMPTS = 500
