+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+GRID_SIZES = (9, 11, 13, 15)
+MAX_GENERATION_ATTEMPTS = 500
+EXTRA_BLOCKED_MARKER_PROB = 0.45
+PREFER_MARKER_MASK_ORBIT_PROB = 0.5
