+def _validate_semantics(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    clean: np.ndarray,
+    orbit_colors: dict[tuple[tuple[int, int], ...], int],
+    markers: list[dict],
+    masks: set[tuple[int, int]],
+) -> bool:
+    n = inp.shape[0]
+    if inp.shape != expected.shape or inp.shape != clean.shape:
+        return False
+    if inp.ndim != 2 or inp.shape[0] != inp.shape[1] or n > 30:
