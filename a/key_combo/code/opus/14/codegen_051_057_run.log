+    ranked = _rank_rectangles(provisional)
+    ranked_colors = _assign_colors_by_rank(rng, count)
+    color_by_rank = {rect: ranked_colors[rank - 1] for rank, rect in enumerate(ranked, start=1)}
+
+    specs = [
