+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SIDE_ORDER = ("top", "right", "bottom", "left")
+SIDE_COLORS = {
+    "top": RED,
+    "right": BLUE,
+    "bottom": GREEN,
+    "left": YELLOW,
+}
+
+MAX_RETRIES = 500
+GRID_SIDE_RANGE = (17, 23)
+OPTIONAL_TIE_PROB = 0.45
+
+PAIR_PATTERNS = [
+    {
+        "h": 5,
+        "w": 4,
+        "outer": [(0, 0), (1, 0), (2, 0), (3, 0), (4, 0), (4, 1), (4, 2), (4, 3)],
+        "inner": [(1, 2), (1, 3), (2, 3)],
+    },
+    {
+        "h": 4,
+        "w": 5,
+        "outer": [(0, 0), (0, 1), (0, 2), (0, 3), (0, 4), (1, 4), (2, 4), (3, 4)],
+        "inner": [(2, 1), (3, 1), (3, 2)],
+    },
+]
+
+SINGLE_PATTERNS = [
+    {"h": 2, "w": 2, "cells": [(0, 0), (1, 0), (1, 1)]},
+    {"h": 2, "w": 3, "cells": [(0, 0), (0, 1), (1, 1), (1, 2)]},
+    {"h": 2, "w": 3, "cells": [(0, 1), (1, 0), (1, 1), (1, 2)]},
+    {"h": 3, "w": 3, "cells": [(0, 0), (1, 0), (1, 1), (2, 1), (2, 2)]},
+    {"h": 2, "w": 3, "cells": [(0, 0), (0, 1), (0, 2), (1, 0)]},
+    {"h": 3, "w": 2, "cells": [(0, 1), (1, 0), (1, 1), (2, 1)]},
+]
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _bbox_contains(outer: tuple[int, int, int, int], inner: tuple[int, int, int, int]) -> bool:
+    return outer[0] <= inner[0] and outer[1] <= inner[1] and inner[2] <= outer[2] and inner[3] <= outer[3]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
