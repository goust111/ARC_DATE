from collections import Counter,defaultdict

def boundary_edges(cells):
    edges=[]
    for r,c in cells:
        edges += [((r,c),(r,c+1)), ((r,c+1),(r+1,c+1)), ((r+1,c+1),(r+1,c)), ((r+1,c),(r,c))]
    cnt=Counter(tuple(sorted(e)) for e in edges)
    kept=[e for e in edges if cnt[tuple(sorted(e))]==1]
    out=defaultdict(list)
    for a,b in kept: out[a].append(b)
    start=min(out)
    cyc=[]; cur=start
    while True:
        nxt=out[cur][0]
        cyc.append((cur,nxt))
        cur=nxt
        if cur==start: break
        if len(cyc)>200: raise RuntimeError
    return cyc

def dir_of(e):
    (r1,c1),(r2,c2)=e
    return (r2-r1,c2-c1)

def outcell(e):
    (r1,c1),(r2,c2)=e
    if r1==r2 and c2==c1+1: return (r1-1,c1)
    if c1==c2 and r2==r1+1: return (r1,c1)
    if r1==r2 and c2==c1-1: return (r1,c2)
    if c1==c2 and r2==r1-1: return (r2,c1-1)
    raise

def corner(v,d1,d2):
    r,c=v
    mp={((0,1),(1,0)):(r-1,c),((1,0),(0,-1)):(r,c),((0,-1),(-1,0)):(r,c-1),((-1,0),(0,1)):(r-1,c-1)}
    return mp.get((d1,d2))

def ring(cells):
    edges=boundary_edges(cells)
    seq=[]
    n=len(edges)
    for i,e in enumerate(edges):
        seq.append(outcell(e))
        d1=dir_of(e); d2=dir_of(edges[(i+1)%n]); v=e[1]
        cor=corner(v,d1,d2)
        if cor is not None:
            seq.append(cor)
    out=[]
    for p in seq:
        if not out or p"'!=out[-1]: out.append(p)
    if out and out[0]==out[-1]: out.pop()
    return out

for cells in [[(0,0)],[(0,0),(1,0)],[(0,0),(1,0),(1,1)],[(0,1),(1,0),(1,1),(1,2)],[(0,0),(0,1),(1,1),(2,1)],[(0,0),(1,0),(2,0),(1,1)]]:
    seq=ring(cells)
    print('"'cells',cells,'len',len(seq),seq)
    ds=[max(abs(a[0]-b[0]),abs(a[1]-b[1])) for a,b in zip(seq,seq[1:]+seq[:1])]
    print('adj',set(ds))
