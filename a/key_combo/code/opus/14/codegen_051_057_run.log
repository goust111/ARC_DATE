  "dst": "marker-only rectangular window d",
  "match_cond": "s.marker.color == d.marker.color; align s.marker to d.marker",
  "transform": "fill d with the shared window fill color and paint translated s",
  "grid_shape": "d.bbox shape"
}
</annotation>
