import random, time
# compact functions

def perimeter_coords(box):
    r0,c0,r1,c1=box
    return [(r0,c) for c in range(c0,c1+1)] + [(r1,c) for c in range(c0,c1+1)] + [(r,c0) for r in range(r0+1,r1)] + [(r,c1) for r in range(r0+1,r1)]

def side_positions(box, side):
    r0,c0,r1,c1=box
    if side=='top': return [(r0,c) for c in range(c0+1,c1)]
    if side=='bottom': return [(r1,c) for c in range(c0+1,c1)]
    if side=='left': return [(r,c0) for r in range(r0+1,r1)]
    return [(r,c1) for r in range(r0+1,r1)]

def legal_gap_positions(box): return side_positions(box,'top')+side_positions(box,'bottom')+side_positions(box,'left')+side_positions(box,'right')

def box_contains(box,p): r,c=p; r0,c0,r1,c1=box; return r0<=r<=r1 and c0<=c<=c1

def emitter_dir(box,p):
    r,c=p; r0,c0,r1,c1=box; mr=(r0+r1)/2.0; mc=(c0+c1)/2.0
    if r==r0: return (-1,-1 if c<mc else 1)
    if r==r1: return (1,-1 if c<mc else 1)
    if c==c0: return (-1 if r<mr else 1,-1)
    return (-1 if r<mr else 1,1)

def build_maps(boxes, colors, gaps, emitter):
    wall={}; owner={}; gapset=set()
    for i,(box,col,gap) in enumerate(zip(boxes,colors,gaps)):
        for p in perimeter_coords(box): owner[p]=i; (gapset.add(p) if p==gap else wall.setdefault(p,4 if p==emitter else col))
    wall[emitter]=4; owner[emitter]=0
    return wall,owner,gapset

def boundary_kind(box,p):
    r,c=p; r0,c0,r1,c1=box
    if (r,c) in {(r0,c0),(r0,c1),(r1,c0),(r1,c1)}: return 'corner'
    if r in (r0,r1): return 'horizontal'
    return 'vertical'

def region_id(p, boxes, owner):
    if p in owner or box_contains(boxes[0],p): return None
    for i in range(len(boxes)-1):
        if box_contains(boxes[i+1],p) and not box_contains(boxes[i],p): return i
    return len(boxes)-1 if not box_contains(boxes[-1],p) else None

def simulate(H,W,boxes,colors,gaps,emitter,max_steps=600):
    wall,owner,gapset=build_maps(boxes,colors,gaps,emitter)
    pos=emitter; dr,dc=emitter_dir(boxes[0],emitter); color=4; cur_region=None; entry_color=None; records=[]; hits=[]; gap_cross=[]; seen=set(); filled=set()
    for _ in range(max_steps):
        st=(pos,dr,dc,color,cur_region)
        if st in seen: return None
