+    except Exception:
+        return False
+    if len(detected) != len(frames):
+        return False
+
+    want = {
+        (frame["color"], frame["row"], frame["col"], frame["bbox"][2], frame["bbox"][3]): frame
+        for frame in frames
+    }
+    for det in detected:
