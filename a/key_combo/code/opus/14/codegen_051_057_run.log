0120: def _gen_choose_grid(rng: np.random.Generator, count: int) -> tuple[int, int] | None:
0121:     choices = []
0122:     min_cavity_area = _GEN_MIN_CAVITY_AREA * count
0123:     max_cavity_area = _GEN_MAX_CAVITY_AREA * count
0124:     for rows in _GEN_GRID_ROWS:
0125:         for cols in _GEN_GRID_COLS:
0126:             area = rows * cols
0127:             if min_cavity_area <= _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area) and max_cavity_area >= _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area):
0128:                 choices.append((rows, cols))
0129:     if not choices:
0130:         return None
0131:     return choices[int(rng.integers(0, len(choices)))]
0132: 
0133: 
0134: def _gen_choose_cavity_dims(rng: np.random.Generator, rows: int, cols: int, count: int) -> list[tuple[int, int]] | None:
0135:     area = rows * cols
0136:     min_area = _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area)
0137:     max_area = _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area)
0138:     max_h = rows - 2 * _GEN_BORDER_WALL_THICKNESS
0139:     max_w = cols - 2 * _GEN_BORDER_WALL_THICKNESS
0140:     options = [(h, w) for h, w in _GEN_CAVITY_DIMS if h <= max_h and w <= max_w]
0141:     combos: list[tuple[tuple[int, int], ...]] = []
0142: 
0143:     def rec(start: list[tuple[int, int]], area: int) -> None:
0144:         if len(start) == count:
0145:             if min_area <= area <= max_area:
0146:                 combos.append(tuple(start))
0147:             return
0148:         remaining = count - len(start)
0149:         if area + remaining * _GEN_MIN_CAVITY_AREA > max_area:
0150:             return
0151:         if area + remaining * _GEN_MAX_CAVITY_AREA < min_area:
0152:             return
0153:         order = rng.permutation(len(options))
0154:         for idx in order:
0155:             h, w = options[int(idx)]
0156:             rec(start + [(h, w)], area + h * w)
0157: 
0158:     rec([], 0)
0159:     if not combos:
0160:         return None
0161:     weights = np.array([(sum(w for _, w in combo) / count) ** _GEN_CAVITY_WIDTH_WEIGHT_POWER for combo in combos], dtype=float)
0162:     weights /= weights.sum()
0163:     return list(combos[int(rng.choice(len(combos), p=weights))])
