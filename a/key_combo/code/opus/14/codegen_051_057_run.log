+def _drop_rectangles(rects: list[Rect], shape: tuple[int, int]) -> list[Rect]:
+    h, _w = shape
+    settled_mask = np.zeros(shape, dtype=bool)
+    settled: list[Rect] = []
+
+    order = sorted(rects, key=lambda rect: (-rect.r1, -rect.r0, rect.c0))
+    for rect in order:
