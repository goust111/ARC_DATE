+    row_map = {r: anchor_rows[vr_index[r]] for r in vertex_rows}
+    col_map = {c: anchor_cols[vc_index[c]] for c in vertex_cols}
+    return {(r, c): (row_map[r], col_map[c]) for r, c in vertices}
