+        grey_count = sum(v == GREY for v in inp_values)
+        orange_count = sum(v == ORANGE for v in inp_values)
+        visible_count = sum(v in (BLUE, RED) for v in inp_values)
+        if grey_count > 0 and visible_count < 1:
