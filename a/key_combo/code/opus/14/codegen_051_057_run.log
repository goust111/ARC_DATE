+
+
+def _candidate_input(
+    h: int,
+    w: int,
+    pair_count: int,
+    trigger_indices: list[int],
+    orientation: str,
+    length: int,
+    base_r: int,
+    base_c: int,
+    trigger_steps: dict[int, int],
