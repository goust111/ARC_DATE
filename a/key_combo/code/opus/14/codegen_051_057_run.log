+    layer_seeds: dict[int, list[tuple[int, int]]] = {color: [] for color in colors[1:]}
+    random.shuffle(central)
+    for color in cue_colors:
+        seed = central.pop()
+        used.add(seed)
+        layer_seeds[color].append(seed)
