def _gen_bbox_distance(a, b):
    dr = 0
    if a[2] < b[0]:
        dr = b[0] - a[2]
    elif b[2] < a[0]:
        dr = a[0] - b[2]
    dc = 0
    if a[3] < b[1]:
        dc = b[1] - a[3]
    elif b[3] < a[1]:
        dc = a[1] - b[3]
    return dr + dc


def _gen_place_patch(canvas, patch, placed_bboxes):
