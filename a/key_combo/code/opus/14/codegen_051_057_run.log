+                {
+                    "cells": picked,
+                    "vector": vec,
+                    "distance": abs(vec[0]) + abs(vec[1]),
+                    "size": len(picked),
+                }
+            )
+            occupied |= picked
+        if ok and len(guides) == 3:
+            return guides
+    return None
