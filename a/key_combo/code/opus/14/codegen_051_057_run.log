+            ["tl", "tr", "br"],
+            ["tl", "bl", "br"],
+            ["tr", "bl", "br"],
+        ]
+        return list(options[int(rng.integers(len(options)))]), collision
+    options = [
+        ["tl", "tr", "bl"],
+        ["tl", "tr", "br"],
+        ["tl", "bl", "br"],
+        ["tr", "bl", "br"],
+    ]
+    return list(options[int(rng.integers(len(options)))]), collision
