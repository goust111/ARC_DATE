+                    continue
+                if nc + nw + 1 >= fc:
+                    continue
+                if _center_distance(_bbox_center2_from_top_left(fr, fc, far_patch.shape), CENTER) <= _center_distance(
+                    _bbox_center2_from_top_left(nr, nc, near_patch.shape), CENTER
+                ):
