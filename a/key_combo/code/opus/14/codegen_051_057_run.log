import numpy as np

def ring(shape_cells):
    rs=[r for r,c in shape_cells]; cs=[c for r,c in shape_cells]
    H=max(rs)+5; W=max(cs)+5
    off=2
    g=np.zeros((H,W),dtype=bool)
    for r,c in shape_cells:g[r+off,c+off]=True
    dil=np.zeros_like(g)
    for r,c in np.argwhere(g):
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                rr=r+dr; cc=c+dc
                if 0<=rr<H and 0<=cc<W: dil[rr,cc]=True
    ring=dil & ~g
    # outer boundary of dilated shape? ring & has outside 4-neighbor false?
    outer=np.zeros_like(g)
    for r,c in np.argwhere(ring):
