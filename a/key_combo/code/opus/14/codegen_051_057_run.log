+
+
+BG = 0
+SEP = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 500
+COMMON_PATTERNS = {
+    3: (
+        (0, 2, 1),
+        (2, 0, 1),
+    ),
+    4: (
+        (0, 1, 2, 3),
+        (2, 3, 0, 1),
+        (0, 1, 2, 1),
+        (2, 1, 0, 1),
+    ),
