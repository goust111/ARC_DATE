+    order = sorted(range(len(sprites)), key=lambda i: (sprites[i]["height"], i))
+    return {
+        "sprites": sprites,
+        "aligned_masks": aligned_masks,
+        "align_steps": align_steps,
+        "ref_index": ref_index,
+        "ref_mask": ref_mask,
+        "order": order,
+    }
