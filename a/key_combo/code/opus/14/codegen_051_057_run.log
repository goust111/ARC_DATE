+
+def _analyze_regions(line_grid: np.ndarray):
+    g = np.asarray(line_grid, dtype=int)
+    seen = np.zeros(g.shape, dtype=bool)
+    regions = []
+    h, w = g.shape
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if int(g[r0, c0]) != BLACK or seen[r0, c0]:
+                continue
+
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            cells = []
+            touches_edge = False
+
+            while q:
+                r, c = q.popleft()
+                cells.append((r, c))
+                if r == 0 or r == h - 1 or c == 0 or c == w - 1:
