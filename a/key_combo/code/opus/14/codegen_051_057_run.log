+
+    colors = _sample_path_colors(len(canonical_path), trigger_index)
+    if colors is None:
+        return None
+
+    inp = _paint_path(shape, canonical_path, colors)
+    out = _semantic_checks(inp)
+    if out is None:
+        return None
+    return inp, out
