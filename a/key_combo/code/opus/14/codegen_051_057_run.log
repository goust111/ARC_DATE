+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+PAIR_COUNT_RANGE = (2, 4)
+TRIANGLE_LENGTH_RANGE = (2, 6)
+
+MAX_GENERATION_ATTEMPTS = 400
+MAX_FILL_RATIO = 0.35
