+def _fits(occupied: np.ndarray, r0: int, c0: int, h: int, w: int, gap: int = 1) -> bool:
+    hh, ww = occupied.shape
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if r0 < 0 or c0 < 0 or r1 >= hh or c1 >= ww:
+        return False
+    rr0 = max(0, r0 - gap)
+    cc0 = max(0, c0 - gap)
+    rr1 = min(hh - 1, r1 + gap)
+    cc1 = min(ww - 1, c1 + gap)
+    return not occupied[rr0 : rr1 + 1, cc0 : cc1 + 1].any()
