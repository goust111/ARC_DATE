+
+    green_row_choices = [
+        r
+        for r in range(2, height - 2)
+        if r not in {k, k + 1, k + 2, blue_high[0], blue_low[0], blue_obstacle[0]}
+    ]
+    if not green_row_choices:
+        return None
+    green_row = rng.choice(green_row_choices)
