+    routes: list[list[tuple[int, int]]] = []
+    for edge in sorted(edge_records, key=_edge_sort_key):
+        a, b = edge["endpoints"]
+        route = _route_cells(mapping_abs[a], mapping_abs[b], wall_doors_abs)
+        _paint_route(out, route, edge["color"])
+        routes.append(route)
+    return out, routes
