+            a_is_edge = _is_edge(i, j, n_cells)
+            if (loser_kind == "edge" and not a_is_edge) or (loser_kind == "inner" and a_is_edge):
+                continue
+            for dr, dc in ((0, 1), (1, 0), (0, -1), (-1, 0)):
