+    ray_union: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[dict[str, object]] | None:
+    colors = rng.sample(list(SEED_COLORS), 3)
+    areas = rng.sample(sorted(AREA_TO_DIMS), 3)
+    if rng.random() < 0.7:
