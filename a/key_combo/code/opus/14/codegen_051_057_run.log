0190: def _gen_tile_specs(rng: np.random.Generator, cavity_h: int, cavity_w: int) -> tuple[int, int, int] | None:
0191:     groups: dict[int, list[tuple[int, int, int]]] = {}
0192:     for tile_h in _gen_factor_options(cavity_h, *_GEN_TILE_HEIGHT_RANGE):
0193:         for tile_w in _gen_factor_options(cavity_w, *_GEN_TILE_WIDTH_RANGE):
0194:             area = tile_h * tile_w
0195:             min_pixels = _gen_ceil_percent(_GEN_TILE_DENSITY_PCT_RANGE[0], area)
0196:             max_pixels = _gen_floor_percent(_GEN_TILE_DENSITY_PCT_RANGE[1], area)
0197:             for count in range(min_pixels, max_pixels + 1):
0198:                 density_key = int(round(_GEN_PERCENT_DENOM * count / area))
0199:                 groups.setdefault(density_key, []).append((tile_h, tile_w, count))
0200:     if not groups:
0201:         return None
0202:     density_key = list(groups)[int(rng.integers(0, len(groups)))]
0203:     choices = groups[density_key]
0204:     return choices[int(rng.integers(0, len(choices)))]
