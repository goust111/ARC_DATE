+    r0, c0, r1, c1 = box
+
+    rect = left[r0 : r1 + 1, c0 : c1 + 1].copy()
+    aligned_mask = right[r0 : r1 + 1, c0 : c1 + 1]
+    missing = rect == BLACK
+
+    rect[missing & (aligned_mask == BLUE)] = RED
+    rect[missing & (aligned_mask == BLACK)] = GREEN
+    return rect
