+        return None
+
+    grid = _render_input(height, width, left_rects, right_rects)
+    try:
+        if not _semantic_checks(grid, collision_mode, tie_side):
+            return None
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
