+                best_support = support
+                best = [(int(dr), int(dc))]
+            elif support == best_support:
+                best.append((int(dr), int(dc)))
+    assert best_support > 0
+    positive = [v for v in best if v[0] > 0 or (v[0] == 0 and v[1] > 0)]
+    assert len(positive) == 1
+    return positive[0], best, best_support
