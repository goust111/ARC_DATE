+
+def _place_objects(
+    shape: tuple[int, int],
+    objects: list[dict],
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, dict] | None:
+    h, w = shape
+    grid = np.zeros(shape, dtype=int)
+    reserved = np.zeros(shape, dtype=bool)
+    placed_meta = {
+        "merge_singletons": [],
+        "far_singletons": [],
+        "markers": [],
+        "merge_markers": [],
+        "static_markers": [],
+    }
+
+    ordering = sorted(
+        range(len(objects)),
+        key=lambda i: (
+            -len(objects[i]["future_cells"]),
+            -(objects[i]["height"] * objects[i]["width"]),
+            objects[i]["kind"],
