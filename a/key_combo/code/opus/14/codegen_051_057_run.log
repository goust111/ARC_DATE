+
+def _place_sprite_on_grid(grid: np.ndarray, sprite: np.ndarray, box: tuple[int, int, int, int]) -> None:
+    r0, c0, _r1, _c1 = box
+    mask = sprite != BG
+    rr, cc = np.where(mask)
+    grid[r0 + rr, c0 + cc] = sprite[rr, cc]
