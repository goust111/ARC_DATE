+def _build_example() -> np.ndarray | None:
+    height = int(RNG.integers(9, 17))
+    left_w = int(RNG.integers(7, 15))
+    bbox_h, bbox_w = _choose_bbox_dims(height, left_w)
+    area = bbox_h * bbox_w
+    interior = (bbox_h - 2) * (bbox_w - 2)
