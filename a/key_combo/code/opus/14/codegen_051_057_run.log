+def _can_place_bar(grid: np.ndarray, cells: list[Coord]) -> bool:
+    h, w = grid.shape
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(grid[r, c]) != BLACK:
+            return False
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cell_set:
