+        else:
+            assert int(final_color) == int(color)
+
+    assert axis_kinds == {"h", "v"}
+    assert any(g == 0 for g in gap_values)
+    assert any(g > 0 for g in gap_values)
+    assert np.array_equal(out, expected)
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(600):
+        h = rng.randint(26, 30)
+        w = rng.randint(26, 30)
