+
+    out = main(grid)
+    expected = _fill_output(
+        grid.shape,
+        (top, left, top + region.shape[0] - 1, left + region.shape[1] - 1),
+        expected_region,
+    )
+    if not np.array_equal(out, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is not None:
