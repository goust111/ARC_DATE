+def _parse_pattern(rows: list[str]) -> dict:
+    singleton = None
+    cluster: list[tuple[int, int]] = []
+    for r, row in enumerate(rows):
+        for c, ch in enumerate(row):
+            if ch == "S":
+                singleton = (r, c)
+            elif ch == "X":
+                cluster.append((r, c))
