+        _SEEN_INPUTS.add(inp_sig)
+        _SEEN_OUTPUTS.add(out_sig)
+        _GENERATION_COUNT += 1
+        return inp
+    raise RuntimeError("failed to generate a valid local-reversal ARC input")

