+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _bbox_shape(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _bbox_area(box: tuple[int, int, int, int]) -> int:
+    h, w = _bbox_shape(box)
+    return h * w
