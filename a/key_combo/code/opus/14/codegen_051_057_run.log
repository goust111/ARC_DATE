+        [1, 1, 3],
+        [1, 2, 2],
+        [2, 2, 3],
+    ]
+    candidates_by_size = {size: _connected_subsets(center_cells, size) for size in (1, 2, 3)}
+    for _ in range(200):
+        order = list(range(3))
+        rng.shuffle(order)
+        sizes = list(rng.choice(size_patterns))
+        rng.shuffle(sizes)
