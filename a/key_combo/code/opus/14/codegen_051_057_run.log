+        "grid": g,
+        "bg": bg,
+        "divider_col": divider_col,
+        "divider_color": divider_color,
+        "left": left,
+        "right": right,
+        "lattice_color": lattice_color,
+        "lattice_rows": lattice_rows,
+        "lattice_cols": lattice_cols,
+        "hole_rows": hole_rows,
+        "hole_cols": hole_cols,
+        "template": template,
