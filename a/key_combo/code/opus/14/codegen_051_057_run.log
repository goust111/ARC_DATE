+    blue_obstacle_row_max = height - 3
+    if blue_obstacle_row_min > blue_obstacle_row_max:
+        return None
+    blue_obstacle = (rng.randint(blue_obstacle_row_min, blue_obstacle_row_max), blue_col)
+    blue_low = (blue_obstacle[0] - 2, blue_col)
