+) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int], str]:
+    h, w = grid.shape
+    fr0, fc0, fr1, fc1 = frame_box
+    sh, sw = sprite.shape
+    sides = ["above", "below", "left", "right"]
