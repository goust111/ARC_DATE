+def _overlay(aligned_masks: list[np.ndarray], colors: list[int], order: list[int], shape: tuple[int, int]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    for idx in order:
+        out[aligned_masks[idx]] = int(colors[idx])
+    return out
