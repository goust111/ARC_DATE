+SPRITE_COLORS = (5, 6, 7, 8, 9)
+OBSTACLE_COLORS = (1, 2, 3)
+CONTROL_CODES = (0, 1, 2, 3, 4)
+DIRS = {
+    0: (0, 0),   # stay
+    1: (0, 1),   # right
+    2: (1, 0),   # down
+    3: (-1, 0),  # up
+    4: (0, -1),  # left
