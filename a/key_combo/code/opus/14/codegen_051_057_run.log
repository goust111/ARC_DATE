+def _build_input(primitive_mask: np.ndarray, row_colors: list[int], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    grid[:PRIMITIVE_SIZE, :PRIMITIVE_SIZE][primitive_mask] = PRIMITIVE
