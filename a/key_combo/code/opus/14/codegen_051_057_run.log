+        sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest()
+        if sig in seen:
+            continue
+        seen.add(sig)
+        generate_input._seen_outputs = seen
+        return grid
+    raise RuntimeError("failed to generate a valid non-duplicate example")

