+
+        c_step = 1 if c2 > c1 else -1
+        for c in range(c1 + c_step, c2 + c_step, c_step):
+            assert int(out[r1, c]) == BG, "horizontal path cells must be background in the input"
+            out[r1, c] = GREY
+        for r in range(r1 + 1, r2):
