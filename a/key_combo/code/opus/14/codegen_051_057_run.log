+PATH_LIBRARY = _enumerate_simple_paths()
+PATHS_BY_LENGTH: dict[int, list[dict]] = {}
+for entry in PATH_LIBRARY:
+    PATHS_BY_LENGTH.setdefault(entry["length"], []).append(entry)
