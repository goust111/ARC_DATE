+
+
+def _overlay_bands(bands: list[np.ndarray], priority: tuple[int, int, int, int]) -> np.ndarray:
+    out = np.zeros_like(bands[0])
+    for band_index in reversed(priority):
+        mask = bands[band_index] != 0
