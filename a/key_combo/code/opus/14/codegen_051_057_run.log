+        values = [int(patch[r, c]) for r, c in orbit]
+        visible = {v for v in values if v in (BLUE, RED)}
+        assert len(visible) == 1, "each fourfold orbit must expose one visible color"
+        color = visible.pop()
+        for r, c in orbit:
+            if int(patch[r, c]) == GREY:
+                patch[r, c] = color
