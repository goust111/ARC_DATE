+def _paint_rect(out: np.ndarray, rect: Rect, rank: int) -> None:
+    if rank == 1:
+        border_color = YELLOW
+        interior_color = RED
+    elif rank == 2:
+        border_color = YELLOW
+        interior_color = rect.color
+    else:
+        border_color = rect.color
+        interior_color = rect.color
