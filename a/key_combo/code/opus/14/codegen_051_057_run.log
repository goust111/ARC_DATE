+
+
+def _expand_isolated_singletons(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for r, c in _find_isolated_gray_singletons(out):
+        for dr in (0, 1):
+            for dc in (0, 1):
+                nr, nc = r + dr, c + dc
+                if _in_bounds(out.shape, nr, nc) and int(out[nr, nc]) == BG:
+                    out[nr, nc] = GRAY
