+GRID_SIZE = 15
+CENTER = (GRID_SIZE // 2, GRID_SIZE // 2)
+
+CORNER_SPECS = (
+    ("TL", (0, 0), 2),
+    ("TR", (0, GRID_SIZE - 1), 1),
+    ("BL", (GRID_SIZE - 1, 0), 3),
+    ("BR", (GRID_SIZE - 1, GRID_SIZE - 1), 4),
+)
+CORNER_BY_NAME = {name: (coord, color) for name, coord, color in CORNER_SPECS}
+CORNER_BY_COLOR = {color: (name, coord) for name, coord, color in CORNER_SPECS}
