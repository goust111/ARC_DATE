+    objects = _extract_objects(g)
+    holes = [obj for obj in objects if obj["has_hole"]]
+    solids = [obj for obj in objects if not obj["has_hole"]]
+
+    hole_traces: list[dict] = []
+    solid_traces: list[dict] = []
+
+    hole_order = sorted(
+        holes,
+        key=lambda obj: (
+            _corner_distance(
+                _bbox_center2_from_bbox(obj["bbox"]),
