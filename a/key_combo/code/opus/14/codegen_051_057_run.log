+
+def _sample_layer_seeds(n: int, colors: list[int], cue_colors: list[int]) -> dict[int, list[tuple[int, int]]] | None:
+    q = n // 2
+    all_seeds = [(r, c) for r in range(q) for c in range(q)]
+    central = [
