import numpy as np
from collections import deque
H=W=20

def draw_seg(g,p,q,col=1):
 r0,c0=p;r1,c1=q
 dr=1 if r1>r0 else -1
 dc=1 if c1>c0 else -1
 for k in range(abs(r1-r0)+1):g[r0+k*dr,c0+k*dc]=col

def ray(g,p,ori,col=6):
 dirs=[(-1,1),(1,-1)] if ori=='/' else [(-1,-1),(1,1)]
 for dr,dc in dirs:
  r,c=p
  while 0<=r<H and 0<=c<W:
   if g[r,c]==0:g[r,c]=col
   r+=dr;c+=dc

def enclosed(g):
 seen=np.zeros((H,W),bool);res=[]
 for r in range(H):
  for c in range(W):
   if g[r,c]"'!=0 or seen[r,c]:continue
   q=deque([(r,c)]);seen[r,c]=1;cells=[];touch=False
   while q:
    x,y=q.popleft();cells.append((x,y));touch|=x in(0,H-1) or y in(0,W-1)
    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
      nx,ny=x+dx,y+dy
      if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not seen[nx,ny]:seen[nx,ny]=1;q.append((nx,ny))
   if not touch:
    b=set()
    for x,y in cells:
      for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
        nx,ny=x+dx,y+dy
        if 0<=nx<H and 0<=ny<W and g[nx,ny]!=0:b.add(int(g[nx,ny]))
    res.append((len(cells),tuple(sorted(b)),cells))
 return res

best=[]
for orient in ['"'\\\\','/']:
  perp='/' if orient=='\\\\' else '\\\\'
  for nseg in [2,3]:
    for spacing in range(2,7):
      for L in range(5,13):
        starts=[]
        if orient=='\\\\':
          starts=[(2+i*spacing,2) for i in range(nseg)]
          if any(r+L>=H or c+L>=W for r,c in starts): continue
        else:
          starts=[(2+i*spacing,W-3) for i in range(nseg)]
          if any(r+L>=H or c-L<0 for r,c in starts): continue
        from itertools import combinations,product
        for k in range(1,nseg+1):
          for idxs in combinations(range(nseg),k):
            for ts in product(range(1,L), repeat=k):
              g=np.zeros((H,W),int)
              for s in starts:
                e=(s[0]+L,s[1]+(L if orient=='\\\\' else -L))
                draw_seg(g,s,e)
              for idx,t in zip(idxs,ts):
                s=starts[idx]
                p=(s[0]+t,s[1]+(t if orient=='\\\\' else -t))
                ray(g,p,perp)
              res=enclosed(g)
              if len(res)>=2:
                sizes=[a for a,_,_ in res]
                bsets={b for _,b,_ in res}
                score=(max(sizes), sum(sizes), len(res), len(bsets))
                if max(sizes)>=3 and len(bsets)>=2:
                  best.append((score,orient,nseg,spacing,L,list(zip(idxs,ts)),sorted((a,b) for a,b,_ in res)))
best=sorted(best, reverse=True)[:30]
