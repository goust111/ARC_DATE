0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """
0012:     Crop the 4-connected foreground sprite whose colored pattern occurs only once among otherwise duplicated sprites.
0013: 
0014:     Input structure
0015:     - The background is the dominant color.
0016:     - Foreground pixels form several separated 4-connected sprites.
0017:     - Every distractor sprite has an identical colored bounding-box crop elsewhere in the grid.
0018: 
0019:     Rule
0020:     - Crop each 4-connected foreground sprite to its bounding box.
0021:     - Compare the exact colored crops, including background pixels inside each crop.
0022:     - Return the only crop whose exact pattern occurs once.
0023: 
0024:     Key insight
0025:     - The answer is the outlier sprite by repetition count, not by position, color id, or size alone.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     bg = get_bg(g)
0029:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0030: 
0031:     assert len(objects) >= 2
0032: 
0033:     crops: list[tuple[tuple[tuple[int, ...], ...], np.ndarray]] = []
0034:     for obj in objects:
0035:         crop = crop_bbox(g, obj["bbox"])
0036:         assert int(np.sum(crop != bg)) == int(obj["area"])
0037:         signature = tuple(tuple(map(int, row)) for row in crop)
0038:         crops.append((signature, crop))
