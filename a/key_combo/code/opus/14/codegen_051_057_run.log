+    int,
+]:
+    h = random.randint(12, 18)
+    w = random.randint(12, 18)
+    direction = random.choice((DIR_E, DIR_S, DIR_SE, DIR_SW))
+    max_steps = {
+        DIR_E: w - 5,
+        DIR_S: h - 5,
+        DIR_SE: min(h, w) - 5,
+        DIR_SW: min(h, w) - 5,
