+
+def _gap_runs(grid: np.ndarray, bg: int = BG) -> list[tuple[int, int]]:
+    full_bg = np.all(grid == bg, axis=0)
+    runs: list[tuple[int, int]] = []
+    c = 0
+    while c < grid.shape[1]:
+        if not full_bg[c]:
+            c += 1
+            continue
+        start = c
+        while c + 1 < grid.shape[1] and full_bg[c + 1]:
