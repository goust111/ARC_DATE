+    if top < 1 or left < 1 or top + h >= hh or left + w >= ww:
+        return False
+    r0 = max(0, top - padding)
+    c0 = max(0, left - padding)
+    r1 = min(hh, top + h + padding)
+    c1 = min(ww, left + w + padding)
+    return not occupied[r0:r1, c0:c1].any()
