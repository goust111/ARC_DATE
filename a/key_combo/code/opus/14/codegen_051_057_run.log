+
+def _convex_corner(
+    vertex: tuple[int, int],
+    d1: tuple[int, int],
+    d2: tuple[int, int],
+) -> tuple[int, int] | None:
+    r, c = vertex
+    mapping = {
+        ((0, 1), (1, 0)): (r - 1, c),
+        ((1, 0), (0, -1)): (r, c),
+        ((0, -1), (-1, 0)): (r, c - 1),
+        ((-1, 0), (0, 1)): (r - 1, c - 1),
+    }
+    return mapping.get((d1, d2))
