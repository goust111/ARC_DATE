+    merged_with_interior = 0
+    untouched_without_interior = 0
+
+    for marker_pos in meta["merge_markers"]:
+        entry = comps_by_marker.get(marker_pos)
+        if entry is None:
+            return False
+        interiors = _interior_pixels(expanded.shape, entry["coords"])
+        if not interiors:
