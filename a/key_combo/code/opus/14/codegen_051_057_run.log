+def _stop_reason(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> str:
+    h, w = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + h > dst.shape[0] or c0 + w > dst.shape[1]:
+        return "boundary"
+    return "occupied"
