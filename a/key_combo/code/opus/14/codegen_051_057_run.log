        return [(0, 0, a - 1, n - 1), (a + gap, 0, n - 1, n - 1)]

    if n >= GEN_THREE_STRIP_MIN_SIZE and bool(rng.integers(0, 2)):
        parts = _gen_split_three(rng, n, gap=gap)
        if parts is not None:
            a, b, _c = parts
            if bool(rng.integers(0, 2)):
