+    out[rect.r0, rect.c0 : rect.c1 + 1] = border_color
+    out[rect.r1, rect.c0 : rect.c1 + 1] = border_color
+    out[rect.r0 : rect.r1 + 1, rect.c0] = border_color
+    out[rect.r0 : rect.r1 + 1, rect.c1] = border_color
