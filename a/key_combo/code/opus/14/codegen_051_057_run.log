+
+def _connected_subsets(cells: set[tuple[int, int]], size: int) -> list[set[tuple[int, int]]]:
+    out: list[set[tuple[int, int]]] = []
+    ordered = sorted(cells)
+    for combo in combinations(ordered, size):
