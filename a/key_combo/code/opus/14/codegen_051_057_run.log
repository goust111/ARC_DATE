+        matches.append("top")
+    if r == r1:
+        matches.append("bottom")
+    if c == c0:
+        matches.append("left")
+    if c == c1:
+        matches.append("right")
+    assert len(matches) == 1, "each marker must lie on exactly one bbox side"
+    return matches[0]
+
