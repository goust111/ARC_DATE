+        colors[-1] = palette[-1]
+    for flat_idx, color in zip(cells, colors):
+        r, c = divmod(int(flat_idx), inner_w)
+        interior[r, c] = int(color)
+    patch[1:-1, 1:-1] = interior
+    return patch
+
