0015: def main(input_grid):
0016:     """
0017:     Expand a small sprite into a block grid by stamping the whole sprite wherever the original has a non-black pixel.
0018: 
0019:     Input structure:
0020:     - The input is a small rectangular sprite on a black background.
0021:     - Non-black pixels mark which output blocks should receive a copy of the sprite.
0022:     - The output dimensions are the input height squared by the input width squared.
0023: 
0024:     Rule:
0025:     - Partition the output into input-sized blocks, one block per input cell.
0026:     - For each non-black input cell, copy the full input sprite into the corresponding output block.
0027:     - Leave blocks corresponding to black input cells entirely black.
0028: 
0029:     Key insight:
0030:     - The input acts as both the stencil and the stamp: colored cells select block positions,
0031:       and the same sprite is pasted into each selected block.
0032:     """
0033:     # creates an empty 9x9 output grid 
0034:     output_grid = np.zeros((input_grid.shape[0]**2,input_grid.shape[1]**2),dtype=int)
0035: 
0036:     input_sprite = input_grid
0037: 
0038:     # Go through the input grid. If an input grid pixel is not black, 
0039:     # then copy the input grid to the corresponding location on the output grid
0040:     H, W = input_grid.shape
0041:     for r in range(H):
0042:         for c in range(W):
0043:             if int(input_grid[r, c]) != Color.BLACK:
0044:                 output_grid = paste(output_grid, input_sprite, r * H, c * W, transparent=Color.BLACK)
0045:     
0046:     return output_grid
0047: 
