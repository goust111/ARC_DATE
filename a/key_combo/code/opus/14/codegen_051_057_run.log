+    groups: list[tuple[tuple[int, int], ...]] = []
+    for r in range(size):
+        for c in range(size):
+            orbit = _rot4_orbit(size, r, c)
+            if orbit not in seen:
+                seen.add(orbit)
+                groups.append(orbit)
