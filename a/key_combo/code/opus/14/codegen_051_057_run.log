+
+    @property
+    def c1(self) -> int:
+        return self.c0 + self.w - 1
+
+    @property
+    def interior_area(self) -> int:
+        return (self.h - 2) * (self.w - 2)
+
+    @property
+    def outer_area(self) -> int:
+        return self.h * self.w
+
+    def shifted(self, dr: int) -> "Rect":
+        return Rect(self.color, self.r0 + dr, self.c0, self.h, self.w)
