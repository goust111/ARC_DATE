+
+def _touches_foreground(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch.shape
+    mask = patch != BG
+    for rr, cc in np.argwhere(mask):
+        gr = r0 + int(rr)
+        gc = c0 + int(cc)
