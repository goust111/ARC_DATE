+    sr0, sc0, sr1, sc1 = sprite_box
+    sh, sw = sprite.shape
+    mid_low_r = (fr0 + fr1 + 1) // 2
+    mid_high_r = (fr0 + fr1) // 2
+    mid_low_c = (fc0 + fc1 + 1) // 2
