+    mask[coords[:, 0], coords[:, 1]] = True
+    return mask
+
+
+def _coords_have_hole(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    shifted = coords - np.array([r0, c0])
