+
+    center_min = 1 + max(upper["size"][1] // 2, lower["size"][1] // 2)
+    center_max = crop_w - 2 - max(upper["size"][1] // 2, lower["size"][1] // 2)
+    if center_min > center_max:
+        return None
+    shared_c = random.randint(center_min, center_max)
