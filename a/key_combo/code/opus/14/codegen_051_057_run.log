+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SIDE_ORDER = ("top", "right", "bottom", "left")
+SIDE_COLORS = {
+    "top": RED,
+    "right": BLUE,
+    "bottom": GREEN,
+    "left": YELLOW,
