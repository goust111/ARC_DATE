+from __future__ import annotations
+
+from collections import deque
+import hashlib
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3)
+_SEEN_INPUT_SIGS: set[str] = set()
+_SEEN_OUTPUT_SIGS: set[str] = set()
