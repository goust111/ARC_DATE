+    ]
+    right_shorter = [
+        i
+        for i in range(2, path_len - 2)
+        if i > path_len - i - 1 and path_len - i - 1 >= 2
+    ]
+    primary = left_shorter if prefer_left_shorter else right_shorter
+    secondary = right_shorter if prefer_left_shorter else left_shorter
+    if primary:
