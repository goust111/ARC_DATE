+    max_length = min(LENGTH_MAX, h - (2 * pair_count + 3), w - 5)
+    if orientation == "/":
+        max_length = min(max_length, w - 5)
+    if max_length < LENGTH_MIN:
+        return None
+    length = random.randint(LENGTH_MIN, max_length)
+
+    max_base_r = h - (length + 2 * (pair_count - 1)) - 3
+    if orientation == "\\":
+        max_base_c = w - length - 3
