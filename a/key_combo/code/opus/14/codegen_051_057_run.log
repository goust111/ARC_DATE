+def _extract_template(grid: np.ndarray) -> np.ndarray:
+    template = np.zeros(TEMPLATE_SHAPE, dtype=int)
+    patch = grid[:3, :3]
+    template[patch == TEMPLATE_COLOR] = TEMPLATE_COLOR
+    return template
