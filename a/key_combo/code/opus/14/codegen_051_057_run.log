+        template_name,
+        edge_records,
+        anchors_abs,
+        wall_doors_abs,
+        mapping_abs,
+        routes,
+        overlap_expected,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
