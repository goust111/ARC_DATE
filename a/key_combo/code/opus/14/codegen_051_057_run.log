+PAIR_PATTERNS = [
+    {
+        "h": 5,
+        "w": 4,
+        "outer": [(0, 0), (1, 0), (2, 0), (3, 0), (4, 0), (4, 1), (4, 2), (4, 3)],
+        "inner": [(1, 2), (1, 3), (2, 3)],
+    },
+    {
+        "h": 4,
+        "w": 5,
+        "outer": [(0, 0), (0, 1), (0, 2), (0, 3), (0, 4), (1, 4), (2, 4), (3, 4)],
+        "inner": [(2, 1), (3, 1), (3, 2)],
+    },
+]
+
