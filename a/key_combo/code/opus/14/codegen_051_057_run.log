        (r - 2 * dr, c - 2 * dc),
        (r - dr + pr, c - dc + pc),
        (r - dr - pr, c - dc - pc),
        (r + 2 * pr, c + 2 * pc),
        (r - 2 * pr, c - 2 * pc),
    )
    open_side = (
        (r + 2 * dr, c + 2 * dc),
        (r + dr + pr, c + dc + pc),
        (r + dr - pr, c + dc - pc),
