    'nc3': [((0,12),(2,0)), ((7,7),(1,0)), ((8,0),(0,2))],
    'nc4a': [((0,8),(3,2)), ((1,0),(3,2)), ((7,8),(2,0)), ((10,1),(0,2))],
    'nc4b': [((0,4),(0,2)), ((0,10),(1,3)), ((6,0),(1,3)), ((6,6),(1,0))],
