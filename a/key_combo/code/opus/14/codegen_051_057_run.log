+            if np.any(global_occ[coords[:, 0], coords[:, 1]]):
+                continue
+            chosen = (r0, c0, coords)
+            break
+        if chosen is None:
+            return None
+        r0, c0, coords = chosen
+        side_occ[coords[:, 0], coords[:, 1]] = True
+        global_occ[coords[:, 0], coords[:, 1]] = True
+        placements.append(
