+def _render_output(grid: np.ndarray, centers: list[Coord], start: Coord) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for r, c in centers:
+        out[r, c] = YELLOW
+
+    cursor = start
+    for waypoint in centers:
+        for r, c in _manhattan_segment(cursor, waypoint):
+            if out[r, c] == BLACK:
