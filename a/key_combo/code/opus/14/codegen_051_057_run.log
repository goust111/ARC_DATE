+    {
+        "name": "collision_four",
+        "blocks": [((0, 1), (3, 2)), ((4, 8), (2, 0)), ((8, 0), (1, 3)), ((10, 10), (2, 0))],
+        "collision": True,
+        "marker_mode": "one_region",
