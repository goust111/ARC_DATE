+MERGE_PATTERNS = [
+    ["S.XX", "..X.", "XXX."],
+    ["S.X.", "..XX", "XXX."],
+    ["S.X.", "..X.", "XXXX"],
+    ["S.X", "..X", "XXX", "X.."],
+    ["S.X", "..X", "XXX", ".X."],
+    ["S.X", "..X", "XXX", "..X"],
+    ["..X", "S.X", "..X", "XXX"],
+    [".S.X", "...X", "XXXX"],
+]
+
+STATIC_PATTERNS = [
+    ["XX", "X."],
+    ["XXX", ".X."],
+    ["XX", ".X", ".X"],
+    ["XXX", "X.."],
+    ["XX", "XX"],
+    ["XX.", ".XX"],
+]
