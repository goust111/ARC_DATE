+        routed = [cell for cell in clockwise_route if cell not in {start, end}]
+        if len(routed) < 4:
+            return False
+        if not any(int(grid[r, c]) == BLUE for r, c in routed):
+            return False
+        if not any(int(grid[r, c]) == BLACK for r, c in routed):
+            return False
