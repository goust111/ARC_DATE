+                continue
+            if corner_name == "TR" and (r < 4 or c + w > GRID_SIZE - 4):
+                continue
+            if corner_name == "BL" and (r + h > GRID_SIZE - 4 or c < 4):
+                continue
+            if corner_name == "BR" and (r + h > GRID_SIZE - 4 or c + w > GRID_SIZE - 4):
