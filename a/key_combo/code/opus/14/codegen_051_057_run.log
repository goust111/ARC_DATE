+
+
+def _wrong_diagonal_output(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for pair in _extract_pairs(out):
+        rows, cols = np.array(
+            _diagonal_cells(pair["start_r"], pair["start_c"], pair["length"], pair["direction"])
