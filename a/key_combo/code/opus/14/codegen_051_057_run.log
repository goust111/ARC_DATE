+    source_ids = sorted(source_to_target)
+    colors = [int(x) for x in RNG.choice(np.array(GLYPH_COLORS, dtype=int), size=k, replace=False)]
+    metadata: list[dict] = []
+    for source_id, color in zip(source_ids, colors):
