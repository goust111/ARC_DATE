+            shapes[i],
+            h,
+            w,
+            upper_band,
+            left_pref=random.choice(prefs),
+            top_range=(1, upper_band - 1),
+        )
+        if pos is None:
+            return None
+        placements[i] = pos
+        cells = shapes[i] + np.array(pos)
+        occupied[cells[:, 0], cells[:, 1]] = True
