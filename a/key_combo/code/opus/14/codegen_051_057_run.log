+    remaining = [i for i in range(n) if i not in placements]
+    lane3 = random.randint(max(0, anchor_c - 5), min(w - 4, anchor_c + 2))
+    for i in remaining:
+        pos = _try_place(
+            occupied,
+            shapes[i],
+            h,
+            w,
+            upper_band,
+            left_pref=random.choice([lane1, lane2, lane3, None]),
+            top_range=(1, upper_band - 1),
