from itertools import combinations
from collections import deque
cells=[(r,c) for r in range(6) for c in range(6)]
N4=[(1,0),(-1,0),(0,1),(0,-1)]
N8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]

def conn(comp):
    comp=set(comp); q=deque([next(iter(comp))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in N4:
            p=(r+dr,c+dc)
            if p in comp and p not in seen: seen.add(p); q.append(p)
    return len(seen)==len(comp)

def bbox(comp):
    rs=[r for r,c in comp]; cs=[c for r,c in comp]
    return min(rs),min(cs),max(rs),max(cs)

def bbox_dist1_manh(p,b):
    r,c=p; r0,c0,r1,c1=b
    if r0<=r<=r1 and c0<=c<=c1: return False
    dr=0 if r0<=r<=r1 else min(abs(r-r0),abs(r-r1))
    dc=0 if c0<=c<=c1 else min(abs(c-c0),abs(c-c1))
    return dr+dc==1

def isolated8(p, fg):
    r,c=p
    return all((r+dr,c+dc) not in fg for dr,dc in N8)

def interior(U):
    U=set(U); ins=[]
    for r,c in U:
        ok=True
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if (r+dr,c+dc) not in U: ok=False
        if ok: ins.append((r,c))
    return ins

for n in [6,7,8]:
  found=0
  for comp in combinations(cells,n):
    comp=set(comp)
    if not conn(comp) or interior(comp): continue
    b=bbox(comp)
    for p in cells:
        if p in comp or not bbox_dist1_manh(p,b) or not isolated8(p, comp): continue
        B={p,(p[0],p[1]+1),(p[0]+1,p[1]),(p[0]+1,p[1]+1)}
        U=comp|B
        ins=interior(U)
        if ins:
            print('n',n,'comp',sorted(comp),'p',p,'bbox',b,'interior',ins[:3])
            raise SystemExit
  print('checked n',n)
print('none')
