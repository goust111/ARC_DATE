        anchors.append((r1, c, 1, 0))
    for r in range(r0 + 1, r1):
        anchors.append((r, c0, 0, -1))
        anchors.append((r, c1, 0, 1))
    random.shuffle(anchors)

    out: list[list[tuple[int, int]]] = []
    for ar, ac, dr, dc in anchors:
