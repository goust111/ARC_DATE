+
+
+def _place_glyph(grid: np.ndarray, bounds: tuple[int, int, int, int], area: int, color: int) -> np.ndarray:
+    r0, c0, r1, c1 = bounds
+    region_h = r1 - r0 + 1
+    region_w = c1 - c0 + 1
