+        if orientation == "\\":
+            c0 = base_c
+            a = (r0, c0)
+            b = (r0 + length, c0 + length)
+            trigger = (r0 + trigger_steps[idx], c0 + trigger_steps[idx]) if idx in trigger_steps else None
+        else:
+            c0 = base_c
+            a = (r0, c0)
+            b = (r0 + length, c0 - length)
+            trigger = (r0 + trigger_steps[idx], c0 - trigger_steps[idx]) if idx in trigger_steps else None
