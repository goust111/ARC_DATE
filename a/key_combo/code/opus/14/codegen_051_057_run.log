+        step = 1 if end[0] > start[0] else -1
+        cur_col = start[1]
+        crossed_rows = [
+            wr
+            for wr in sorted(wall_doors_abs, reverse=step < 0)
+            if min(start[0], end[0]) < wr < max(start[0], end[0])
+        ]
+        for wr in crossed_rows:
