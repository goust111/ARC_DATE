+    if not _validate_scene(
+        inp,
+        expected_out,
+        template_name,
+        edge_records,
+        anchors_abs,
+        wall_doors_abs,
+        mapping_abs,
+        routes,
+        overlap_expected,
+    ):
+        return None
+    return inp
+
