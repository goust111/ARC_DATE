+    grid_h = max(grid_h, _GEN_MIN_SIZE)
+    grid_h = max(grid_h, max(rect.r1 for rect in specs) + 1)
+    grid_w = max(rect.c1 for rect in specs) + 1
+    shape = (grid_h, grid_w)
+
+    inp = np.zeros(shape, dtype=int)
+    for rect in specs:
