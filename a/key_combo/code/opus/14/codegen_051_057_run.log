from collections import Counter,defaultdict

def boundary_edges(cells):
    edges=[]
    for r,c in cells:
        edges += [((r,c),(r,c+1)), ((r,c+1),(r+1,c+1)), ((r+1,c+1),(r+1,c)), ((r+1,c),(r,c))]
    cnt=Counter(tuple(sorted(e)) for e in edges)
    kept=[e for e in edges if cnt[tuple(sorted(e))]==1]
    out=defaultdict(list)
    for a,b in kept: out[a].append(b)
    start=min(out)
    cyc=[]; cur=start
    while True:
        nxt=out[cur][0]
        cyc.append((cur,nxt))
        cur=nxt
        if cur==start: break
        if len(cyc)>200: raise RuntimeError
    return cyc

def outcell(e):
    (r1,c1),(r2,c2)=e
    if r1==r2 and c2==c1+1: return (r1-1,c1)
    if c1==c2 and r2==r1+1: return (r1,c1)
    if r1==r2 and c2==c1-1: return (r1,c2)
