+
+def _place_blob(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    allowed: np.ndarray,
+    blob: np.ndarray,
+    color: int,
+    side: str,
+    frame_bbox: tuple[int, int, int, int],
+    rng: np.random.Generator,
+) -> bool:
