+            hit_color = int(wall_color[nxt])
+            kind = _boundary_kind(boxes[boundary_owner[nxt]], nxt)
+            if kind in ("horizontal", "corner"):
+                dr = -dr
+            if kind in ("vertical", "corner"):
+                dc = -dc
+            current_color = hit_color
+            hits.append(
+                {
+                    "cell": nxt,
+                    "ring": int(boundary_owner[nxt]),
+                    "kind": kind,
+                    "color": hit_color,
+                }
+            )
+            continue
