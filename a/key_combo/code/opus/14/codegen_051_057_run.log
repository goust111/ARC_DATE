+from __future__ import annotations
+
+from collections import deque
+from itertools import permutations
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLORS = (5, 7, 8)
+SPRITE_COLORS = (2, 1, 3)
+RNG = np.random.default_rng()
+MAX_ATTEMPTS = 400
