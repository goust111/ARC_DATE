+                    out[i][r, c] = color
+    return out
+
+
+def _role_patch(center: tuple[int, int], offsets: tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
+    r, c = center
+    return {(r, c)} | {(r + dr, c + dc) for dr, dc in offsets}
+
+
+def _assert_semantics(
