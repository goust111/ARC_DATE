+def choose_positions(rng: np.random.Generator, h: int, w: int) -> dict[str, tuple[int, int]] | None:
+    if h < 17 or w < 17:
+        return None
+    top_lo, top_hi = 2, max(3, h // 3 + 1)
+    bot_lo, bot_hi = max(h // 2, top_hi + 2), h - 4
+    left_lo, left_hi = 2, max(3, w // 3 + 1)
+    right_lo, right_hi = max(w // 2, left_hi + 2), w - 4
+    if top_lo >= top_hi or bot_lo >= bot_hi or left_lo >= left_hi or right_lo >= right_hi:
+        return None
+
+    top_row = int(rng.integers(top_lo, top_hi))
+    bottom_row = int(rng.integers(bot_lo, bot_hi))
+    left_col = int(rng.integers(left_lo, left_hi))
+    right_col = int(rng.integers(right_lo, right_hi))
+    if right_col - left_col < 7 or bottom_row - top_row < 7:
+        return None
+    return {
+        "tl": (top_row, left_col),
+        "tr": (top_row, right_col),
+        "bl": (bottom_row, left_col),
+        "br": (bottom_row, right_col),
+    }
+
+
+def select_layout(rng: np.random.Generator) -> tuple[list[str], bool]:
+    collision = bool(rng.random() < 0.6)
+    count = 4 if rng.random() < 0.6 else 3
+    if count == 4:
+        return ["tl", "tr", "bl", "br"], collision
+    if collision:
+        options = [
+            ["tl", "tr", "bl"],
+            ["tl", "tr", "br"],
+            ["tl", "bl", "br"],
+            ["tr", "bl", "br"],
+        ]
+        return list(options[int(rng.integers(len(options)))]), collision
+    options = [
+        ["tl", "tr", "bl"],
+        ["tl", "tr", "br"],
+        ["tl", "bl", "br"],
+        ["tr", "bl", "br"],
+    ]
+    return list(options[int(rng.integers(len(options)))]), collision
+
+
+def choose_gaps(
+    rng: np.random.Generator,
+    anchors: list[str],
+    collision: bool,
+    positions: dict[str, tuple[int, int]],
+) -> dict[str, tuple[int, int]] | None:
+    if not collision:
+        return {anchor: OUTWARD_GAPS[anchor][int(rng.integers(2))] for anchor in anchors}
+
+    gaps = {anchor: COLLISION_GAPS[anchor] for anchor in anchors}
+    if {"tl", "tr"}.issubset(anchors):
+        if (positions["tr"][1] - positions["tl"][1]) % 2 == 0:
+            return None
+    if {"bl", "br"}.issubset(anchors):
+        if (positions["br"][1] - positions["bl"][1]) % 2 == 0:
+            return None
+    return gaps
