+        for frame in frames
+    }
+    for det in detected:
+        key = (det["color"], det["bbox"][0], det["bbox"][1], det["bbox"][2], det["bbox"][3])
+        if key not in want:
+            return False
+        src = want[key]
+        if det["count"] != src["count"]:
