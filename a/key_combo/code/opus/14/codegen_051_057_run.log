from itertools import combinations
from collections import deque

cells=[(r,c) for r in range(5) for c in range(5)]
N4=[(1,0),(-1,0),(0,1),(0,-1)]
N8=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]

def conn(comp):
    comp=set(comp)
    q=deque([next(iter(comp))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in N4:
            p=(r+dr,c+dc)
            if p in comp and p not in seen:
                seen.add(p); q.append(p)
    return len(seen)==len(comp)

def bbox(comp):
    rs=[r for r,c in comp]; cs=[c for r,c in comp]
    return min(rs),min(cs),max(rs),max(cs)

def bbox_dist1(p,b):
    r,c=p; r0,c0,r1,c1=b
    dr=0 if r0<=r<=r1 else min(abs(r-r0),abs(r-r1))
    dc=0 if c0<=c<=c1 else min(abs(c-c0),abs(c-c1))
    # Chebyshev? Manhattan? likely bbox distance maybe min gap cells. Use Chebyshev=1 but outside.
    cheb=max(dr,dc)
    return cheb==1 and not (r0<=r<=r1 and c0<=c<=c1)

def isolated8(p, fg):
    r,c=p
    return all((r+dr,c+dc) not in fg for dr,dc in N8)

def interior(U):
    U=set(U)
    ins=[]
    for r,c in U:
        ok=True
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if (r+dr,c+dc) not in U:
                    ok=False
        if ok: ins.append((r,c))
    return ins

found=0
for comp in combinations(cells,6):
    comp=set(comp)
    if not conn(comp):
        continue
    if interior(comp):
        continue
    b=bbox(comp)
    # choose singleton within 0..4 maybe maybe expansion within larger canvas no matter.
    for p in cells:
        if p in comp: continue
        if not bbox_dist1(p,b): continue
        fg=comp|{p}
        if not isolated8(p, comp): continue
        B={p,(p[0],p[1]+1),(p[0]+1,p[1]),(p[0]+1,p[1]+1)}
        U=comp|B
        ins=interior(U)
        if ins:
            print('comp',sorted(comp),'p',p,'bbox',b,'interior',ins[:3],'U',sorted(U))
            found+=1
            raise SystemExit
