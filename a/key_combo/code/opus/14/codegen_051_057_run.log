+        changed = connected != g
+        changed_coords = {(int(rr), int(cc)) for rr, cc in np.argwhere(changed)}
+        expected_added = {(int(r), int(c)) for c in range(int(c0) + 1, int(c1))}
+        if changed_coords != expected_added:
+            return False
+        if len(changed_coords) != int(gap):
+            return False
+
