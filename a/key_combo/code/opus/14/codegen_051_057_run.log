+    rng.shuffle(pool)
+    valid: list[tuple[list[tuple[int, int]], bool]] = []
+    for combo in combinations(pool, 3):
+        dists = [abs(dr) + abs(dc) for dr, dc in combo]
+        if len(set(dists)) != 3:
+            continue
+        if len({_direction_key(vec) for vec in combo}) != 3:
+            continue
+        count = Counter()
+        for vec in combo:
+            _copies, covered = _ray_geometry(center_cells, vec, shape)
+            for cell in covered:
