+    orbits = _orbit_groups(size)
+    for orbit in orbits:
+        color = random.choice((BLUE, RED))
+        for r, c in orbit:
+            patch[r, c] = color
+    if len(set(map(int, patch.flatten()))) == 1:
+        orbit = random.choice([o for o in orbits if len(o) > 1])
+        new_color = RED if int(patch[orbit[0]]) == BLUE else BLUE
+        for r, c in orbit:
