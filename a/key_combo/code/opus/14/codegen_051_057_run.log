+        on_count = random.randint(3, 7)
+        for idx in random.sample(range(PRIMITIVE_SIZE * PRIMITIVE_SIZE), on_count):
+            mask[idx // PRIMITIVE_SIZE, idx % PRIMITIVE_SIZE] = True
+        if _valid_primitive(mask):
