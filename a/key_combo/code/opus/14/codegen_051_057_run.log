MAX_ATTEMPTS = 300


def _gen_frame_patch(color: int) -> np.ndarray:
    patch = np.full((OBJECT_SIZE, OBJECT_SIZE), int(color), dtype=int)
    patch[1:-1, 1:-1] = BG
