+def _build_specs(rng: np.random.Generator) -> tuple[tuple[int, int], list[Rect]] | None:
+    count = int(rng.integers(3, 5))
+    dims = _sample_dimensions(rng, count)
+    if dims is None:
+        return None
+
+    order = list(range(count))
+    rng.shuffle(order)
