+    fg = proto != BLACK
+    vertex_set = set(vertices)
+    seen: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    edges: list[dict] = []
+    for vr, vc in sorted(vertices):
+        for dr, dc in DIRS4:
+            rr, cc = vr + dr, vc + dc
+            if not _in_bounds(proto.shape, rr, cc) or not fg[rr, cc]:
+                continue
+            cells = [(vr, vc)]
+            while _in_bounds(proto.shape, rr, cc) and fg[rr, cc]:
