    and _GEN_LOOP_PERIMETER_MIN <= _gen_perimeter((h, w)) <= _GEN_LOOP_PERIMETER_MAX
)

_GEN_COMBOS_BY_TOTAL: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {}
