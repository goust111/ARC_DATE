+
+    object_mask = (grid != bg) & (grid != frame_color)
+    for comp in _components(object_mask, connectivity=8):
+        colors = set(map(int, grid[comp[:, 0], comp[:, 1]]))
+        if len(colors) != 1:
+            return False
