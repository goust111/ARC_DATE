+
+    outside = info["left"].copy()
+    outside[hole_rows[0] : hole_rows[1] + 1, hole_cols[0] : hole_cols[1] + 1] = BG
+    if not np.any((outside != BG) & (outside != LATTICE)):
+        return False
+
+    if info["slot_count"] > 1 and len(info["marked_slots"]) >= info["slot_count"]:
