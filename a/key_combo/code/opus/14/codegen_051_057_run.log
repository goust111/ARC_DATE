+def _rot4_orbit(size: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    last = size - 1
+    return tuple(
+        sorted(
+            {
+                (r, c),
+                (c, last - r),
+                (last - r, last - c),
+                (last - c, r),
+            }
+        )
+    )
+
+
