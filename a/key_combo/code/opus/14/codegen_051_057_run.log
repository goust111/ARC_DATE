+    placements[blocker_target] = second
+    cells = shapes[blocker_target] + np.array(second)
+    occupied[cells[:, 0], cells[:, 1]] = True
+
+    third_left_pref = lane2
+    third_top_range = (max(1, upper_band - 4), upper_band - 1)
+    if scenario == "object":
