+
+def _area_probe(inp: np.ndarray, glyphs: list[dict], regions: list[tuple[int, int, int, int]]) -> bool:
+    base_out = main(inp)
+    used_areas = {glyph["area"] for glyph in glyphs}
+    for glyph in glyphs:
