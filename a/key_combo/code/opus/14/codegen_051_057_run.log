        options.extend((r, wall_cols[j - 1], color) for r in rows)
    if j < NUM_COL_BANDS - 1 and target[i][j + 1] == color and col_counts[wall_cols[j]] < COL_MARKER_MAX:
        options.extend((r, wall_cols[j], color) for r in rows)
