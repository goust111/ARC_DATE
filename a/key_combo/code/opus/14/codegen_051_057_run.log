  "type": "move_along_path",
  "src": "red marker pixel s",
  "path": "horizontal segment from s along s.row to the green marker column, then vertical segment along that column toward the green marker, stopping before the marker",
  "dst": "green marker pixel d",
  "trajectory": "paint every background cell on the L path teal",
  "transform": "keep the red and green marker pixels unchanged"
}
</annotation>
