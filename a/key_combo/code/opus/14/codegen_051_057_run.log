+
+def _make_far_singleton() -> dict:
+    return {
+        "kind": "far_singleton",
+        "height": 2,
+        "width": 2,
+        "input_cells": {(0, 0): GRAY},
+        "future_cells": {(0, 0), (0, 1), (1, 0), (1, 1)},
