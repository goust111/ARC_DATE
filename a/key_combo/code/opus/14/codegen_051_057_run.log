/bin/bash -lc "python - <<'PY'
import random
import numpy as np
from collections import Counter


def perimeter_coords(box):
    r0,c0,r1,c1 = box
    pts=[]
    for c in range(c0,c1+1):
        pts.append((r0,c)); pts.append((r1,c))
    for r in range(r0+1,r1):
        pts.append((r,c0)); pts.append((r,c1))
    return pts

def side_positions(box, side):
    r0,c0,r1,c1=box
    if side=='top': return [(r0,c) for c in range(c0+1,c1)]
    if side=='bottom': return [(r1,c) for c in range(c0+1,c1)]
    if side=='left': return [(r,c0) for r in range(r0+1,r1)]
    return [(r,c1) for r in range(r0+1,r1)]

def legal_gap_positions(box):
    return side_positions(box,'top')+side_positions(box,'bottom')+side_positions(box,'left')+side_positions(box,'right')

def build_maps(H,W,boxes,ring_colors,gaps,emitter):
    wall_color={}
    boundary_owner={}
    gap_set=set()
    for i,(box,col,gap) in enumerate(zip(boxes,ring_colors,gaps)):
        for p in perimeter_coords(box):
            boundary_owner[p]=i
            if gap is not None and p==gap:
                gap_set.add(p)
            else:
                wall_color[p]=4 if p==emitter else col
    if emitter not in wall_color:
        wall_color[emitter]=4
        boundary_owner[emitter]=0
    return wall_color,boundary_owner,gap_set

def box_contains(box,p):
    r,c=p; r0,c0,r1,c1=box
    return r0<=r<=r1 and c0<=c<=c1

def region_id(p, boxes, boundary_owner):
    if p in boundary_owner:
        return None
    if box_contains(boxes[0], p):
        return None
    for i in range(len(boxes)-1):
        if box_contains(boxes[i+1], p) and not box_contains(boxes[i], p):
            return i
    if not box_contains(boxes[-1], p):
        return len(boxes)-1
    return None

def emitter_dir(box,p):
    r,c=p; r0,c0,r1,c1=box
    mid_r=(r0+r1)/2.0; mid_c=(c0+c1)/2.0
    if r==r0: return (-1, -1 if c < mid_c else 1)
    if r==r1: return (1, -1 if c < mid_c else 1)
    if c==c0: return (-1 if r < mid_r else 1, -1)
    if c==c1: return (-1 if r < mid_r else 1, 1)
    raise ValueError

def simulate(H,W,boxes,ring_colors,gaps,emitter,max_steps=2000):
    wall_color,boundary_owner,gap_set=build_maps(H,W,boxes,ring_colors,gaps,emitter)
    boundary_set=set(boundary_owner)
    dr,dc=emitter_dir(boxes[0], emitter)
    pos=emitter; color=4; cur_region=None; entry_color=None
    bounces=[]; gap_cross=[]; fills=[]; seen=set(); steps=0
    while steps<max_steps:
        steps+=1
        state=(pos,dr,dc,color,cur_region)
        if state in seen:
            return None
        seen.add(state)
        nr,nc=pos[0]+dr,pos[1]+dc
        if not (0<=nr<H and 0<=nc<W):
            if cur_region is not None and cur_region not in [r for r,_ in fills]:
                fills.append((cur_region,entry_color))
            return {'fills':fills,'bounces':bounces,'gap_cross':gap_cross,'final_dir':(dr,dc),'final_pos':pos,'steps':steps}
        nxt=(nr,nc)
        if nxt in wall_color:
            color=wall_color[nxt]
            dr,dc=-dr,-dc
            bounces.append(('corner',nxt,color))
            continue
