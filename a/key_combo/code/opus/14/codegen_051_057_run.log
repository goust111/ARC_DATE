+        sizes.append(int(comp.shape[0]))
+        rr = comp[:, 0]
+        cc = comp[:, 1]
+        if rr.max() < r0 - 1:
+            sides.add("top")
+        elif rr.min() > r1 + 1:
+            sides.add("bottom")
+        elif cc.max() < c0 - 1:
+            sides.add("left")
+        elif cc.min() > c1 + 1:
+            sides.add("right")
+    return sizes, sides
+
+
+def _semantic_expected(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    color_counts: dict[int, int],
+) -> np.ndarray:
+    palette = _sorted_palette(grid, color_counts)
+    return _paint_nested_bands(grid, frame_bbox, palette)
