/bin/bash -lc "python - <<'PY'
import numpy as np
from collections import deque

H=W=15

def draw_line(grid,p,q,color):
    r0,c0=p; r1,c1=q
    dr=1 if r1>r0 else -1
    dc=1 if c1>c0 else -1
    for k in range(abs(r1-r0)+1):
        grid[r0+k*dr,c0+k*dc]=color

def draw_ray(grid,p,diag_type,color):
    # diag_type '/' means dirs (-1,1),(1,-1); '\\\\' means (-1,-1),(1,1)
    dirs=[(-1,1),(1,-1)] if diag_type=='/' else [(-1,-1),(1,1)]
    for dr,dc in dirs:
        r,c=p
        while 0<=r<H and 0<=c<W:
            if grid[r,c]==0:
                grid[r,c]=color
            r+=dr; c+=dc

def comps(grid):
    seen=np.zeros((H,W),bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if grid[r,c]"'!=0 or seen[r,c]:
                continue
            q=deque([(r,c)]); seen[r,c]=1; cells=[]; touch=False
            while q:
                x,y=q.popleft(); cells.append((x,y))
                if x in (0,H-1) or y in (0,W-1): touch=True
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and grid[nx,ny]==0 and not seen[nx,ny]:
                        seen[nx,ny]=1; q.append((nx,ny))
            if not touch:
                b=set()
                for x,y in cells:
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                        nx,ny=x+dx,y+dy
                        if 0<=nx<H and 0<=ny<W and grid[nx,ny]!=0:
                            b.add(int(grid[nx,ny]))
                out.append((len(cells),tuple(sorted(b)),cells))
    return out

def show(g):
    chars={0:'"'.',1:'B',6:'M'}
    for row in g:
        print(''.join(chars.get(int(v),str(int(v))) for v in row))

# family: 3 parallel backslash blue lines, 2 slash magenta lines through triggers on top and bottom
for offset in [2,3,4]:
  for L in [6,7,8,9]:
    g=np.zeros((H,W),int)
    # base starts
    starts=[(2,2),(2+offset,2),(2+2*offset,2)]
    ok=True
    for s in starts:
      if s[0]+L>=H or s[1]+L>=W: ok=False
    if not ok: continue
    for s in starts:
      draw_line(g,s,(s[0]+L,s[1]+L),1)
    # trigger positions along first and third at t1,t2
    for t1 in [2,3,4]:
      for t2 in [2,3,4]:
        gg=g.copy()
        p1=(starts[0][0]+t1,starts[0][1]+t1)
        p2=(starts[2][0]+t2,starts[2][1]+t2)
        draw_ray(gg,p1,'/',6)
        draw_ray(gg,p2,'/',6)
        cs=comps(gg)
        if len(cs)>=2:
          print('offset',offset,'L',L,'t',t1,t2,'regions',[(a,b) for a,b,_ in cs])
          show(gg)
          raise SystemExit
print('none')
