+def _instance_to_grid(
+    h: int,
+    w: int,
+    center_cells: set[tuple[int, int]],
+    guides: list[dict[str, object]],
+    seeds: list[dict[str, object]],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
