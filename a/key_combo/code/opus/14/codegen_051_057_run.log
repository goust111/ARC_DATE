+        stack = [(r, c)]
+        seen[r, c] = True
+        coords = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for dr, dc in neighbors:
+                nr, nc = cr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
