+    for i in range(n):
+        coords = shapes[i] + np.array(placements[i])
+        grid[coords[:, 0], coords[:, 1]] = colors[i]
+    return grid, scenario, want_tie
+
+
+def _semantic_checks(grid: np.ndarray, scenario: str, want_tie: bool) -> bool:
+    try:
+        correct, meta = _solve(grid)
+    except Exception:
+        return False
