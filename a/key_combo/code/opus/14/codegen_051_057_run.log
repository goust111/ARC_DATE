+
+def _orbit_cells(n: int, r: int, c: int) -> list[tuple[int, int]]:
+    return [(r, c), (r, n - 1 - c), (n - 1 - r, c), (n - 1 - r, n - 1 - c)]
+
+
+def _seed_set_breaks_90_symmetry(seeds: list[tuple[int, int]]) -> bool:
