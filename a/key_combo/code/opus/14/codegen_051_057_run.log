+    if left_target_mode == "half":
+        left_boundary = int(gap_start + half - 1)
+        right_boundary = int(gap_end - half + 1)
+    elif left_target_mode == "outer":
+        left_boundary = int(gap_start - 1)
+        right_boundary = int(gap_end + 1)
