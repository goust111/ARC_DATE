+    _validate_input_grid(g)
+    offsets = _infer_shell_offsets(g)
+    completed = [
+        _complete_band(g[_band_slice(i), :], BAND_COLORS[i], offsets)
+        for i in range(4)
+    ]
+    return _overlay_bands(completed, PRIORITY)
