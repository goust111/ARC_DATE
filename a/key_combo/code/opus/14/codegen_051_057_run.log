+    out = expanded.copy()
+    for comp in _components(expanded != BG):
+        marker = _marker_info(expanded, comp)
+        if marker is None:
+            continue
+        marker_color, _marker_pos = marker
+        for r, c in _interior_pixels(expanded.shape, comp):
+            out[r, c] = marker_color
