+
+def _enumerate_simple_paths() -> list[dict]:
+    all_paths = set()
+
+    def dfs(path: list[Coord], used: set[Coord]) -> None:
+        if len(path) >= 2:
+            canon = min(tuple(path), tuple(reversed(path)))
+            all_paths.add(canon)
