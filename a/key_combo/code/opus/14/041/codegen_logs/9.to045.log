+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+GRID_SIDE_MIN = 15
+GRID_SIDE_MAX = 20
+DOMINO_COUNT_MIN = 3
+DOMINO_COUNT_MAX = 5
+SINGLE_COUNT_MIN = 3
+SINGLE_COUNT_MAX = 5
