+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _domino_outline(coords: list[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    r0, c0, r1, c1 = _bbox(coords)
+    er0 = max(0, r0 - 1)
+    ec0 = max(0, c0 - 1)
+    er1 = min(h - 1, r1 + 1)
+    ec1 = min(w - 1, c1 + 1)
+    domino = set(coords)
+    outline: set[tuple[int, int]] = set()
+    for r in range(er0, er1 + 1):
+        for c in range(ec0, ec1 + 1):
+            if r in (er0, er1) or c in (ec0, ec1):
