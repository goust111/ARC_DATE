+    leg = 2
+    direction_index = 0
+    path: list[tuple[int, int]] = []
+    while leg <= max_leg:
+        dr, dc = DIRS4[direction_index]
+        for _ in range(leg):
+            r += dr
+            c += dc
+            if _in_bounds(shape, r, c):
