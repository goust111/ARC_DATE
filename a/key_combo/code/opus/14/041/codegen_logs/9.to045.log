+        require_clipped = True if need_clipped_extra else None
+        candidates = _all_domino_candidates(
+            shape,
+            seed,
+            occupied_red,
+            occupied_outline,
+            protected_blockers,
+            require_clipped=require_clipped,
+        )
+        if not candidates and require_clipped is True:
+            need_clipped_extra = False
