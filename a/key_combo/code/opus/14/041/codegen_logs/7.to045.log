+
+
+def _find_cavities(
+    grid: np.ndarray, bg: int, frame_color: int, frame_bbox: tuple[int, int, int, int]
+) -> tuple[list[dict], np.ndarray]:
+    r0, c0, r1, c1 = frame_bbox
