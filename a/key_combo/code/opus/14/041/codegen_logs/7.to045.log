+BG = 0
+FRAME = 1
+MARKER = 2
+TRAIL = 6
+SPRITE_COLORS = (3, 4, 5, 7, 8, 9)
+
+DIRS4 = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+
+SIDE_TO_TRAIL = {
+    "top": "up",
+    "bottom": "down",
+    "left": "left",
+    "right": "right",
+}
+
+SIDE_TO_PERP = {
+    "top": ("left", "right"),
+    "bottom": ("left", "right"),
+    "left": ("up", "down"),
+    "right": ("up", "down"),
+}
+
+CAVITY_DIMS = (
+    (2, 2),
+    (2, 3),
+    (2, 4),
+    (3, 2),
+    (3, 3),
+    (3, 4),
+)
