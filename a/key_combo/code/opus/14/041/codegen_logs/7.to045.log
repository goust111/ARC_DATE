+                sprite_mask = _make_connected_sprite(sh, sw)
+        if not placed:
+            return None
+
+    try:
+        _semantic_checks(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
+            return result
