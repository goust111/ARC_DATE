   249	    assert g.ndim == 2
   250	
   251	    out = g.copy()
   252	    components = _nonzero_components(g)
   253	    halo_infos: list[tuple[int, int, int, set[tuple[int, int]]]] = []
   254	    for index, coords in enumerate(components):
   255	        cells = {tuple(map(int, cell)) for cell in coords}
   256	        size = len(cells)
   257	        diagonal = size % 2 == 0
   258	        depth = size // 2 if diagonal else (size - 1) // 2
   259	        mark_color = YELLOW if diagonal else ORANGE
