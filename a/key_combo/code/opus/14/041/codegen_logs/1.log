+
+def _distance_halo(
+    cells: set[tuple[int, int]],
+    shape: tuple[int, int],
+    diagonal: bool,
+    depth: int,
+) -> tuple[set[tuple[int, int]], dict[tuple[int, int], int]]:
+    height, width = map(int, shape)
+    moves = DIAG_DIRS if diagonal else ORTHO_DIRS
+    dist = {cell: 0 for cell in cells}
+    queue = deque(cells)
+    while queue:
+        r, c = queue.popleft()
+        if dist[(r, c)] >= depth:
