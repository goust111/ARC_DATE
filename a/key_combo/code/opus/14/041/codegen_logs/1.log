spec:
  grid: 3x3
  background: color 0 (black)
  foreground:
    count: 2-5 non-background pixels
    colors: each fg pixel has a distinct non-zero color (no repeats) [observed]
    placement: scattered among bg cells; no two fg pixels share a color
  transform:
    scale_factor: N = number of fg pixels
    rule: replace every input cell with an NxN block of the same color
    output_size: 3N x 3N (ranges 6x6 to 15x15)

generation_strategy:
