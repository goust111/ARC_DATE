+        "color": int(color),
+        "cells_local": cells_local,
+        "cells_local_set": cells_set,
+        "halo_local": halo_local,
+        "shape_h": int(shape_h),
+        "shape_w": int(shape_w),
+        "diagonal": bool(diagonal),
+        "depth": int(depth),
+        "mark_color": YELLOW if diagonal else ORANGE,
+        "force_edge": bool(force_edge),
