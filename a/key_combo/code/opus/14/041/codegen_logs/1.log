+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+ORANGE = 7
+INPUT_COLORS = (1, 2, 3, 5, 6, 8, 9)
+
+ORTHO_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+
+GENERATE_ATTEMPTS = 400
+PLACE_ATTEMPTS = 120
