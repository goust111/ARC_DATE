+    for index, coords in enumerate(components):
+        cells = {tuple(map(int, cell)) for cell in coords}
+        size = len(cells)
+        diagonal = size % 2 == 0
+        depth = size // 2 if diagonal else (size - 1) // 2
+        mark_color = YELLOW if diagonal else ORANGE
