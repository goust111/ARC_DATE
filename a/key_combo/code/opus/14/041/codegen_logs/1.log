+def _expand_unbounded(
+    cells: set[tuple[int, int]],
+    diagonal: bool,
+    depth: int,
+) -> set[tuple[int, int]]:
+    moves = DIAG_DIRS if diagonal else ORTHO_DIRS
+    frontier = set(cells)
+    visited = set(cells)
+    halo: set[tuple[int, int]] = set()
+    for _ in range(depth):
+        next_frontier: set[tuple[int, int]] = set()
+        for r, c in frontier:
+            for dr, dc in moves:
+                nr, nc = r + dr, c + dc
+                if (nr, nc) not in visited and (nr, nc) not in next_frontier:
+                    next_frontier.add((nr, nc))
+        if not next_frontier:
+            break
+        visited.update(next_frontier)
+        halo.update(next_frontier)
+        frontier = next_frontier
+    return halo
+
+
+def _expand_bounded(
+    cells: set[tuple[int, int]],
+    shape: tuple[int, int],
+    diagonal: bool,
+    depth: int,
+) -> set[tuple[int, int]]:
+    height, width = map(int, shape)
+    moves = DIAG_DIRS if diagonal else ORTHO_DIRS
+    frontier = set(cells)
+    visited = set(cells)
+    halo: set[tuple[int, int]] = set()
+    for _ in range(depth):
+        next_frontier: set[tuple[int, int]] = set()
+        for r, c in frontier:
+            for dr, dc in moves:
+                nr, nc = r + dr, c + dc
+                if not (0 <= nr < height and 0 <= nc < width):
+                    continue
+                if (nr, nc) not in visited and (nr, nc) not in next_frontier:
+                    next_frontier.add((nr, nc))
+        if not next_frontier:
+            break
+        visited.update(next_frontier)
+        halo.update(next_frontier)
+        frontier = next_frontier
+    return halo
+
+
+def _distance_halo(
+    cells: set[tuple[int, int]],
+    shape: tuple[int, int],
+    diagonal: bool,
+    depth: int,
+) -> tuple[set[tuple[int, int]], dict[tuple[int, int], int]]:
+    height, width = map(int, shape)
+    moves = DIAG_DIRS if diagonal else ORTHO_DIRS
+    dist = {cell: 0 for cell in cells}
+    queue = deque(cells)
+    while queue:
+        r, c = queue.popleft()
+        if dist[(r, c)] >= depth:
+            continue
+        for dr, dc in moves:
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < height and 0 <= nc < width):
+                continue
+            if (nr, nc) in dist:
+                continue
+            dist[(nr, nc)] = dist[(r, c)] + 1
+            queue.append((nr, nc))
+    halo = {cell for cell, value in dist.items() if 1 <= value <= depth}
+    return halo, dist
+
