+        for dr, dc in moves:
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < height and 0 <= nc < width):
+                continue
+            if (nr, nc) in dist:
+                continue
+            dist[(nr, nc)] = dist[(r, c)] + 1
+            queue.append((nr, nc))
