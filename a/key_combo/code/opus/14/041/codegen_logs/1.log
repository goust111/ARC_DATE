+        seen: set[tuple[int, int]] = set()
+        for r, c in cells:
+            for dr, dc in ORTHO_DIRS:
+                nr, nc = r + dr, c + dc
+                if (nr, nc) in cells or (nr, nc) in seen:
+                    continue
+                seen.add((nr, nc))
+                shared = sum((nr + rr, nc + cc) in cells for rr, cc in ORTHO_DIRS)
+                frontier.append(((nr, nc), 1 + 3 * shared))
