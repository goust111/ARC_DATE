    out=g.copy()
    for r,c in centers:
      sq={(r+dr,c+dc) for dr in (-1,0,1) for dc in (-1,0,1) if not (dr==0 and dc==0)}
      for rr,cc in [(r-1,c-1),(r-1,c+1),(r+1,c-1),(r+1,c+1)]:
        keep=False
        for nr,nc in [(rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)]:
          if 0<=nr<H and 0<=nc<W and g[nr,nc]==3 and (nr,nc) not in sq:
            keep=True
            break
        if not keep: out[rr,cc]=0
      out[r,c]=2
    return out, centers

def enclosed(g):
    H,W=g.shape
    vis=np.zeros((H,W),bool)
    dq=deque()
    for r in range(H):
      for c in [0,W-1]:
        if g[r,c]==0 and not vis[r,c]: vis[r,c]=1; dq.append((r,c))
    for c in range(W):
      for r in [0,H-1]:
        if g[r,c]==0 and not vis[r,c]: vis[r,c]=1; dq.append((r,c))
    while dq:
      r,c=dq.popleft()
      for nr,nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]:
        if 0<=nr<H and 0<=nc<W and g[nr,nc]==0 and not vis[nr,nc]: vis[nr,nc]=1; dq.append((nr,nc))
    regs=[]
    seen=np.zeros((H,W),bool)
    for r in range(H):
      for c in range(W):
        if g[r,c]==0 and not vis[r,c] and not seen[r,c]:
          reg=[]; seen[r,c]=1; dq=deque([(r,c)])
          while dq:
            rr,cc=dq.popleft(); reg.append((rr,cc))
            for nr,nc in [(rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)]:
              if 0<=nr<H and 0<=nc<W and g[nr,nc]==0 and not vis[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; dq.append((nr,nc))
