    t,centers=transform(g)
    if len(centers)"'!=1: continue
    b=regions(g); a=regions(t)
    # subtract square center cavity from before count
    if sum(len(x) for x in b) <= 1: continue
    if sum(len(x) for x in b) <= sum(len(x) for x in a)+1: continue
    # want simple bbox and at least one leaked region size >=2 maybe or after fewer comps
    if len(b)==0: continue
    cg=crop(g)
