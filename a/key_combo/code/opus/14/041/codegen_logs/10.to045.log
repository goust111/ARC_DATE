+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNER_OFFSETS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+EDGE_OFFSETS = [(-1, 0), (0, -1), (0, 1), (1, 0)]
