+            mr0, mc0, _, _ = mover_layout["bbox"]
+            tr0, tc0, tr1, tc1 = target_layout["bbox"]
+            mover = _make_rect(mr0, mc0, mh, mw, outlier_color, _dir_to_corner(direction, (mh, mw)))
