+
+
+def _boundary_candidates(
+    shape: tuple[int, int],
+    direction: tuple[int, int],
+    mover_size: tuple[int, int],
+) -> list[dict]:
+    h, w = shape
+    dr, dc = direction
+    mh, mw = mover_size
+    out: list[dict] = []
+    for r0 in range(h - mh + 1):
