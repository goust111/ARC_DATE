+    color = colors.pop()
+    expected = np.full((h, w), color, dtype=int)
+    expected[corner] = TEAL
+    assert np.array_equal(region, expected), "component must be a filled rectangle with one replaced corner"
+    return {
+        "bbox": bbox,
+        "r0": r0,
+        "c0": c0,
+        "h": h,
+        "w": w,
+        "color": color,
+        "corner": corner,
+        "marker_abs": (r0 + corner[0], c0 + corner[1]),
