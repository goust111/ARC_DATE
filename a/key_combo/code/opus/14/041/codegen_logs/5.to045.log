+                        if not _bbox_in_bounds(start_bbox, shape):
+                            continue
+                        ok = True
+                        current = start_bbox
+                        for _ in range(steps + 1):
+                            if _bboxes_overlap(current, target_rect["bbox"]):
+                                ok = False
+                                break
+                            current = _shift_bbox(current, dr, dc)
+                        if ok:
+                            mover_rect = {"bbox": start_bbox, "final_bbox": final_bbox}
