+    return None
+
+
+def _validate_scene(scene: dict) -> None:
+    rects = scene["rects"]
+    assert len(rects) == 4
+    shape = scene["shape"]
+    for i, rect in enumerate(rects):
+        assert _bbox_in_bounds(rect["bbox"], shape)
+        for other in rects[i + 1 :]:
+            assert not _bboxes_overlap(rect["bbox"], other["bbox"])
