+    assert np.all(out[fr0 : fr1 + 1, fc0 : fc1 + 1] == BG), "mover destination must be empty"
+    out[fr0 : fr1 + 1, fc0 : fc1 + 1] = mover["color"]
+
+    if collision_rect is not None:
+        tr0, tc0, tr1, tc1 = collision_rect["bbox"]
+        out[tr0 : tr1 + 1, tc0 : tc1 + 1] = BG
