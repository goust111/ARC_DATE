+def _rect_cell_values(rect: dict, full: bool) -> dict[tuple[int, int], int]:
+    cells: dict[tuple[int, int], int] = {}
+    mr, mc = rect["corner"]
+    for rr in range(rect["h"]):
+        for cc in range(rect["w"]):
+            value = rect["color"]
+            if not full and (rr, cc) == (mr, mc):
+                value = TEAL
+            cells[(rect["r0"] + rr, rect["c0"] + cc)] = value
+    return cells
+
