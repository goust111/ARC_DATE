+
+def _generate_scene() -> dict | None:
+    shape = (random.randint(18, 24), random.randint(18, 24))
+    common_color, outlier_color = random.sample(FG_COLORS, 2)
+    direction = random.choice([(-1, -1), (-1, 1), (1, -1), (1, 1)])
