+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+CUP_COLORS = (1, 2, 3, 6, 7, 8, 9)
+OPENINGS = ("up", "right", "down", "left")
+DIR_VECTORS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
