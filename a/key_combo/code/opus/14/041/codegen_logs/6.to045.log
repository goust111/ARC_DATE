+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_distance(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    r0a, c0a, r1a, c1a = a
+    r0b, c0b, r1b, c1b = b
+    dr = max(0, r0b - r1a - 1, r0a - r1b - 1)
+    dc = max(0, c0b - c1a - 1, c0a - c1b - 1)
+    return dr + dc
+
+
+def _components_by_color(grid: np.ndarray) -> list[dict]:
+    seen = np.zeros(grid.shape, dtype=bool)
+    comps: list[dict] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
