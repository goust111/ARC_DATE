+    if cup["opening"] == "down":
+        return cup["height"] - 1, cup["gap_start"] + (cup["gap_len"] - 1) // 2
+    if cup["opening"] == "left":
+        return cup["gap_start"] + (cup["gap_len"] - 1) // 2, 0
+    return cup["gap_start"] + (cup["gap_len"] - 1) // 2, cup["width"] - 1
+
+
