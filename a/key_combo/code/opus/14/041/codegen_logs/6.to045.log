+
+    cup_grid = _build_grid(shape, cups, placements, set())
+    if not _solve_ok(cup_grid):
+        return None
+
+    obstacles = _try_add_targeted_grey(cup_grid)
+    full_grid = _build_grid(shape, cups, placements, obstacles)
+    obstacles = _add_random_obstacles(full_grid, obstacles)
+    full_grid = _build_grid(shape, cups, placements, obstacles)
+
+    if not _valid_input_semantics(full_grid):
+        return None
+    if not np.array_equal(main(full_grid), _solve(full_grid, trace=False)):
+        return None
+    return full_grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle input")

