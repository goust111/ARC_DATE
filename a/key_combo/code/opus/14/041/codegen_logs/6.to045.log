+                continue
+            if _adjacent_to_nonblack(grid, r, c):
+                continue
+            candidates.append((r, c))
+    return candidates
+
+
+def _try_add_targeted_grey(grid: np.ndarray) -> set[tuple[int, int]]:
+    obstacles: set[tuple[int, int]] = set()
+    if random.random() >= 0.45:
