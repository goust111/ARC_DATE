+        traces.append(
+            {
+                "cup_id": cup["id"],
+                "color": cup["color"],
+                "area": cup["area"],
+                "bbox": cup["bbox"],
+                "opening": cup["opening"],
+                "painted": painted,
+                "painted_count": len(painted),
+                "stop_reason": stop_reason,
+                "stop_cell": stop_cell,
