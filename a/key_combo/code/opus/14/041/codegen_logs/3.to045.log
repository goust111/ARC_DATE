+        frame_w = random.randint(min_w, min(18, min_w + 5))
+        order = list(range(len(shapes)))
+        order.sort(key=lambda i: -(shapes[i][0] * shapes[i][1]))
+        placed: dict[int, tuple[int, int, int, int]] = {}
+        ok = True
+        for idx in order:
