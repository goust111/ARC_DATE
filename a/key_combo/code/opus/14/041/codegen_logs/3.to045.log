+def _place_holes(shapes: list[tuple[int, int]]) -> tuple[int, int, list[tuple[int, int, int, int]]]:
+    hs = [h for h, _ in shapes]
+    ws = [w for _, w in shapes]
+    min_h = max(max(hs) + 2, (sum(hs) + 1) // 2 + 4)
+    min_w = max(max(ws) + 2, (sum(ws) + 1) // 2 + 4)
+    for _ in range(400):
