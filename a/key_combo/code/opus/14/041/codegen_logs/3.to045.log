+    out = frame_crop.copy()
+    for sprite in sprites:
+        factor = int(sprite["count"])
+        scaled = _scale_patch(sprite["patch"], factor)
+        shape = tuple(map(int, scaled.shape))
+        assert shape in cavity_by_shape
+        cavity = cavity_by_shape.pop(shape)
