import numpy as np
from collections import deque

def box(g,r,c):
  for dr in (-1,0,1):
    for dc in (-1,0,1):
      if dr or dc: g[r+dr,c+dc]=3

def room(g,r0,c0,r1,c1,preserve=False,bb=1):
  r,c=r0+1,c0+1
  box(g,r,c)
  g[r0,c0+3:c1+1]=3
  g[r0+3:r1+1,c0]=3
  g[r0:r1+1,c1]=3
  g[r1,c0:c1+1]=3
  if preserve:
    g[bb:r0,c0]=3
  else:
    mid=min(c1-1,c0+4)
    g[bb:r0,mid]=3

def leakbox(g,r,c,bb=1):
  box(g,r,c)
  g[bb:r,c]=3

def find_boxes(g):
  H,W=g.shape
  out=[]
  for r in range(1,H-1):
    for c in range(1,W-1):
      if g[r,c]"'!=0: continue
      ok=True
      for dr in (-1,0,1):
        for dc in (-1,0,1):
          if dr==0 and dc==0: continue
          if g[r+dr,c+dc]!=3: ok=False
      if ok: out.append((r,c))
  return out

def transform(g):
  g=g.copy()
  boxes=find_boxes(g)
  for r,c in boxes:
    boxcells={(r+dr,c+dc) for dr in (-1,0,1) for dc in (-1,0,1)}
    for rr,cc in [(r-1,c-1),(r-1,c+1),(r+1,c-1),(r+1,c+1)]:
      keep=False
      for nr,nc in [(rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)]:
        if 0<=nr<g.shape[0] and 0<=nc<g.shape[1] and (nr,nc) not in boxcells and g[nr,nc]==3:
          keep=True
      if not keep:
        g[rr,cc]=0
    g[r,c]=2
  H,W=g.shape
  vis=np.zeros((H,W),bool)
  q=deque()
  for r in range(H):
    for c in [0,W-1]:
      if g[r,c]==0 and not vis[r,c]: vis[r,c]=1;q.append((r,c))
  for c in range(W):
    for r in [0,H-1]:
      if g[r,c]==0 and not vis[r,c]: vis[r,c]=1;q.append((r,c))
  while q:
    r,c=q.popleft()
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
      rr,cc=r+dr,c+dc
      if 0<=rr<H and 0<=cc<W and g[rr,cc]==0 and not vis[rr,cc]: vis[rr,cc]=1;q.append((rr,cc))
  g[(g==0)&(~vis)]=4
  return g

def show(g):
  chars={0:'"'.',3:'#',2:'R',4:'Y'}
  for row in g:
    print(''.join(chars.get(int(x),str(int(x))) for x in row))
  print()

H,W=20,26
bb=1
g=np.zeros((H,W),int)
g[bb,1:W-1]=3
room(g,4,2,11,10,True,bb)
room(g,5,14,13,23,False,bb)
leakbox(g,8,12,bb)
show(g)
out=transform(g)
show(out)
print('boxes',find_boxes(g))
print('yellow',np.sum(out==4))
