import numpy as np
from collections import deque

def enclosed(g):
    H,W=g.shape
    vis=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if g[r,c]==0 and not vis[r,c]: vis[r,c]=1;q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if g[r,c]==0 and not vis[r,c]: vis[r,c]=1;q.append((r,c))
