        for c in [0,W-1]:
            if g[r,c]==0 and not vis[r,c]: vis[r,c]=1;q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if g[r,c]==0 and not vis[r,c]: vis[r,c]=1;q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and g[rr,cc]==0 and not vis[rr,cc]:
                vis[rr,cc]=1;q.append((rr,cc))
    return set(map(tuple,np.argwhere((g==0)&(~vis))))

def replace(g,r,c):
    g=g.copy()
    box={(r+dr,c+dc) for dr in (-1,0,1) for dc in (-1,0,1)}
    corners=[(r-1,c-1),(r-1,c+1),(r+1,c-1),(r+1,c+1)]
    for rr,cc in corners:
