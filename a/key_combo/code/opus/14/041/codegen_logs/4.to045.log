+def _gen_attempt() -> np.ndarray | None:
+    tile_h = random.choice(TILE_HEIGHT_OPTIONS)
+    width = random.randint(*GRID_WIDTH_RANGE)
+    height = tile_h * TILE_COUNT
+
+    asym_tile = random.randrange(TILE_COUNT)
