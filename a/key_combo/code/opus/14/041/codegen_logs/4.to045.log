+    center = height // 2
+    candidates = [r0 + offset for offset in range(tile_h)]
+    distances = sorted({abs(r - center) for r in candidates})
+    keep = distances[: min(2, len(distances))]
+    return [r for r in candidates if abs(r - center) in keep]
+
