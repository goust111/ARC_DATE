+
+def _render_grid(
+    tile_h: int,
+    width: int,
+    seeds: list[tuple[int, int]],
+    blockers_by_tile: list[set[tuple[int, int]]],
+) -> np.ndarray:
+    grid = np.zeros((tile_h * TILE_COUNT, width), dtype=int)
+    for tile_idx, (r, c) in enumerate(seeds):
+        grid[r, c] = SEED
