+
+
+def _oracle_output(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    tile_h, seeds, _blockers_by_tile, active_tile = _split_metadata(g)
+    out = g.copy()
+    for tile_idx, (r, c) in enumerate(seeds):
