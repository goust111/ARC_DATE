+
+
+def _construct_blockers(
+    shape: tuple[int, int],
+    tile_h: int,
+    seeds: list[tuple[int, int]],
+    asym_tile: int,
+    hit_idx: int,
+    hit_cell: tuple[int, int],
+    hit_tile: int,
+    hit_local: tuple[int, int],
