+        assert len(values) == 1
+        color = next(iter(values))
+        assert color not in top_colors
+        lower_colors.add(color)
+    assert len(lower_colors) == len(components)
+    assert any(area < k for area in areas)
+    assert any(area >= k for area in areas)
+    assert k in areas
+    assert any(area > k for area in areas)
+    if k > 4:
+        assert (k - 1) in areas
