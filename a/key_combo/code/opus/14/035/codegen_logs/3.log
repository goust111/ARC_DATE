            key = (variant.shape, variant.tobytes())
            if key not in seen:
                seen.add(key)
                variants.append(variant.copy())
    return variants


def _gen_colored_key(patch, colors):
    coords = [
        (int(r), int(c), int(patch[r, c]))
        for r, c in np.argwhere(np.isin(patch, list(colors)))
