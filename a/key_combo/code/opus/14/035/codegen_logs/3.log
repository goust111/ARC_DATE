import random, numpy as np

def sign(x): return (x>0)-(x<0)

def path(a,b):
    br,bc=a; rr,rc=b
    dr=sign(rr-br); dc=sign(rc-bc)
    rd=abs(rr-br); cd=abs(rc-bc)
    cells=[]
    r,c=br,bc
    for _ in range(min(rd,cd)):
        r+=dr; c+=dc; cells.append((r,c))
    if rd>cd:
        for _ in range(rd-cd-1):
            r+=dr; cells.append((r,c))
    else:
        for _ in range(cd-rd-1):
            c+=dc; cells.append((r,c))
    assert max(abs(rr-br),abs(rc-bc))-1==len(cells)
    return cells

def analyze(H,W,blue,red,green):
    p=path(blue,red)
    blockers={blue:1,red:2,**{x:5 for x in p}}
    res=[]
    for d in [(1,1),(-1,1),(1,-1),(-1,-1)]:
        r,c=green; ray=[]
        while True:
            nr,nc=r+d[0],c+d[1]
            if not (0<=nr<H and 0<=nc<W):
                res.append((d,ray,'edge',None)); break
            if (nr,nc) in blockers:
                res.append((d,ray,'block',blockers[(nr,nc)])); break
            ray.append((nr,nc)); r,c=nr,nc
    return p,res

random.seed(0)
count=0
for _ in range(1000):
    H=W=random.randint(13,18)
    br,bc=random.randrange(1,H-1),random.randrange(1,W-1)
    rd=random.randint(2,6)
    cd=random.randint(2,6)
    if abs(rd-cd)<2: continue
    sr=random.choice([-1,1]); sc=random.choice([-1,1])
    rr,rc=br+sr*rd, bc+sc*cd
    if not (1<=rr<H-1 and 1<=rc<W-1): continue
    p,_=analyze(H,W,(br,bc),(rr,rc),(0,0))
    cands=[]
    for gr in range(1,H-1):
        for gc in range(1,W-1):
            if (gr,gc) in p or (gr,gc)==(br,bc) or (gr,gc)==(rr,rc): continue
            if gr in {br,rr} or gc in {bc,rc}: continue
            ar=(rr-br)*(gc-bc)-(rc-bc)*(gr-br)
            if ar==0: continue
            _,res=analyze(H,W,(br,bc),(rr,rc),(gr,gc))
            blocked=[x for x in res if x[2]=='block' and x[3]==5 and len(x[1])>0]
            edge=[x for x in res if x[2]=='edge' and len(x[1])>0]
            if len(blocked)>=2 and len(edge)>=1:
                cands.append((gr,gc,res))
    if cands:
        count+=1
print('count',count)
