+    visible_straight = random.randint(*VISIBLE_STRAIGHT_STEPS_RANGE)
+    row_dist = diag_len + visible_straight + 1 if longer_axis == "row" else diag_len
+    col_dist = diag_len if longer_axis == "row" else diag_len + visible_straight + 1
+
