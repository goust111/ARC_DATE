+    start: tuple[int, int],
+    direction: tuple[int, int],
+) -> dict:
+    dr, dc = direction
+    r, c = start
+    cells: list[tuple[int, int]] = []
+
+    while True:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return {
+                "direction": direction,
+                "cells": cells,
+                "stop": "edge",
+                "blocker": None,
+                "blocker_color": None,
+            }
+        if (nr, nc) in blockers:
+            return {
+                "direction": direction,
+                "cells": cells,
