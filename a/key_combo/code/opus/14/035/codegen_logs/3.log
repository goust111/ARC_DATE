+            max(edge_lengths),
+            total_orange,
+            random.random(),
+        )
+        scored.append((score, green))
+
+    if not scored:
+        return None
+    scored.sort(reverse=True)
+    top_choices = [green for _score, green in scored[: min(8, len(scored))]]
+    return random.choice(top_choices)
+
