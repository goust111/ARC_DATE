+
+
+def _sample_endpoints() -> tuple[int, int, tuple[int, int], tuple[int, int]] | None:
+    h = random.randint(*GRID_ROWS_RANGE)
+    w = random.randint(*GRID_COLS_RANGE)
+
+    longer_axis = random.choice(("row", "col"))
