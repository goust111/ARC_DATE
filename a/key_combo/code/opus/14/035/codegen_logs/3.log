+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+ORANGE = 7
+
+DIAGONAL_DIRS = ((1, 1), (-1, 1), (1, -1), (-1, -1))
+GRID_ROWS_RANGE = (13, 19)
+GRID_COLS_RANGE = (13, 19)
