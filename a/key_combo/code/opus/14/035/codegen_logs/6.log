+        new = proto_b if spec["kind"] == "A" else proto_a
+        color = RED if spec["kind"] == "A" else BLUE
+        rr, cc = np.where(old)
+        wrong[r0 + rr, c0 + cc] = BG
+        _paste_mask(wrong, new, r0, c0, color)
+    return wrong
+
+
+def _build_wrong_no_swap(
