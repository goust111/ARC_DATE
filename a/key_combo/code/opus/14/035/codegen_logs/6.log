+        ref_mask = _mask_from_coords(ref_coords)
+        ref_color = int(grid[ref_coords[0, 0], ref_coords[0, 1]])
+        references.append(
+            {
+                "box_bbox": (r0, c0, r1, c1),
+                "coords": ref_coords,
+                "mask": ref_mask,
+                "color": ref_color,
+            }
+        )
+    return references
+
+
