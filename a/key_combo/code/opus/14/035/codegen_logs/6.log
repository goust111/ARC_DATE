+        c0 = spec["c"]
+        old = proto_a if spec["kind"] == "A" else proto_b
+        rr, cc = np.where(old)
+        wrong[r0 + rr, c0 + cc] = RED if spec["kind"] == "A" else BLUE
+    return wrong
+
