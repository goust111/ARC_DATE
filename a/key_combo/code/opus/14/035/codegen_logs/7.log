+    for r in seed_rows:
+        hit = False
+        for c in range(1, w):
+            if int(g[r, c]) == Color.GREY:
+                hit = True
+                for rr in (r - 1, r + 1):
+                    if in_bounds(g.shape, rr, c) and int(g[rr, c]) == Color.BLACK:
