+    stack: list[tuple[Cell, set[Cell]]] = [(start, {start})]
+    while stack:
+        cell, seen = stack.pop()
+        if cell == end:
+            count += 1
+            if count >= limit:
+                return count
+            continue
+        r, c = cell
+        nxts = []
+        for nr, nc in neighbors4(r, c):
+            nxt = (nr, nc)
+            if nxt in passable and nxt not in seen:
+                nxts.append(nxt)
+        for nxt in sorted(nxts, reverse=True):
