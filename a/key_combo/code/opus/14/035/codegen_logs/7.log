+        return False
+
+    simulated = _simulate_rays(grid)
+    original_track = (grid == Color.TEAL) | (grid == Color.MAROON)
+    if np.any((simulated == Color.YELLOW) & original_track):
+        return False
+    if np.any((grid == Color.GREY) & original_track):
+        return False
