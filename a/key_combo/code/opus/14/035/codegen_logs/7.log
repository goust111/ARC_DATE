0058: def main(grid: np.ndarray) -> np.ndarray:
0059:     """Recolor the unique safe route between the two maroon endpoints from teal to maroon.
0060: 
0061:     Input structure
0062:     - A black background contains a teal 4-connected track, exactly two maroon endpoint pixels, and one or more orange blocker pixels embedded near the track.
0063: 
0064:     Rule
0065:     - Treat each orange blocker and its 8-neighborhood as forbidden.
0066:     - In the remaining teal/maroon track graph, there is exactly one simple
0067:       4-connected path between the maroon endpoints.
0068:     - Recolor teal pixels on that path to maroon; leave endpoints, blockers, and all other cells unchanged.
0069: 
0070:     Key insight
0071:     - The orange pixels block nearby teal cells diagonally as well as orthogonally, which removes shorter decoy routes and makes the intended endpoint-to-endpoint path unique.
0072:     """
0073:     g = np.asarray(grid, dtype=int)
0074:     assert g.ndim == 2
0075:     assert set(map(int, np.unique(g))) <= {
0076:         Color.BLACK,
0077:         Color.ORANGE,
0078:         Color.TEAL,
0079:         Color.MAROON,
0080:     }
0081: 
0082:     endpoints = [tuple(map(int, p)) for p in np.argwhere(g == Color.MAROON)]
0083:     blockers = [tuple(map(int, p)) for p in np.argwhere(g == Color.ORANGE)]
0084:     assert len(endpoints) == 2
0085:     assert blockers
0086: 
0087:     forbidden = np.zeros(g.shape, dtype=bool)
0088:     for r, c in blockers:
0089:         forbidden[r, c] = True
0090:         for nr, nc in neighbors8(r, c):
0091:             if in_bounds(g.shape, nr, nc):
0092:                 forbidden[nr, nc] = True
0093:     assert all(not forbidden[r, c] for r, c in endpoints)
0094: 
0095:     passable = ((g == Color.TEAL) | (g == Color.MAROON)) & ~forbidden
0096:     assert _has_unique_simple_path(passable, endpoints[0], endpoints[1])
0097:     path = _unique_shortest_path(passable, endpoints[0], endpoints[1])
0098: 
0099:     out = g.copy()
0100:     for r, c in path:
0101:         if g[r, c] == Color.TEAL:
0102:             out[r, c] = Color.MAROON
0103:     return out
