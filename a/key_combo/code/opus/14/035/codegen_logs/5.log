+    if reflect:
+        for obj, (color, sheared) in zip(objects, sheared_sets):
+            del obj
+            for r, c in sheared:
+                rr = 2 * cr - int(r)
+                rc = 2 * cc - int(c)
+                if 0 <= rr < h and 0 <= rc < w and rc != cc and out[rr, rc] != MARKER:
+                    out[rr, rc] = color
