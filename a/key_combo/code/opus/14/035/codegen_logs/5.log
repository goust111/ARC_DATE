+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+DIVIDER = 4
+MARKER = 9
+OBJECT_COLORS = (1, 2, 3, 6)
+GRID_HEIGHTS = (17, 19, 21, 23, 25)
+GRID_WIDTHS = (19, 21, 23, 25, 27)
+GEN_ATTEMPTS = 500
+MASK_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 120
+MIN_ROW_GAP = 2
