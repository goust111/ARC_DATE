+DIVIDER = 4
+MARKER = 9
+OBJECT_COLORS = (1, 2, 3, 6)
+GRID_HEIGHTS = (17, 19, 21, 23, 25)
+GRID_WIDTHS = (19, 21, 23, 25, 27)
+GEN_ATTEMPTS = 500
+MASK_ATTEMPTS = 200
