+    for obj in objs:
+        side = int(obj["side"])
+        notch_side = obj["notch_side"]
+        steps = 1 if notch_side in STEP1_SIDES else 2
+        out_side = _advance_side(side, steps)
+        color = LEFT_COLOR if notch_side in MOVE_LEFT_SIDES else RIGHT_COLOR
