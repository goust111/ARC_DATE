+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        specs = _sample_specs()
+        height = _sample_height(specs)
+        if height is None:
+            continue
+        width = random.randint(*GRID_W_RANGE)
+        placed = _place_rows(specs, height)
+        inp = _render_input(height, width, placed)
