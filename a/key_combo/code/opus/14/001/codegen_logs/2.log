+    return min(distances)
+
+
+def _pattern_score(
+    slot: dict, marker: tuple[int, int], top_left: tuple[int, int]
+) -> tuple[int, int, int]:
+    mr, mc = marker
+    tr, tc = top_left
+    rows = range(tr, tr + 3)
+    cols = range(tc, tc + 3)
+    outward = 0
+    avoids_axis = 0
+    if slot["kind"] == "row":
+        if slot["side"] == "left" and tc + 2 <= mc - 2:
+            outward = 1
+        if slot["side"] == "right" and tc >= mc + 2:
