+def _find_color_components(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(grid == int(color))]
+    points = set(coords)
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for start in coords:
+        if start in seen:
+            continue
+        queue = deque([start])
+        seen.add(start)
+        comp: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            comp.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in points and (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    queue.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    points = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if not points:
+        return False
+    seen = {points[0]}
+    queue = deque([points[0]])
+    point_set = set(points)
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in point_set and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return len(seen) == len(points)
+
