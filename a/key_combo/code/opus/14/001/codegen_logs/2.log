+
+def _marker_box_distance(marker: tuple[int, int], top_left: tuple[int, int]) -> int:
+    mr, mc = marker
+    tr, tc = top_left
+    distances = [
+        abs(mr - r) + abs(mc - c)
+        for r in range(tr, tr + 3)
+        for c in range(tc, tc + 3)
