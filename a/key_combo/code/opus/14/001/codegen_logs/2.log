+    return outward, avoids_axis, center_bias
+
+
+def _choose_pattern_box(
+    slot: dict,
+    marker: tuple[int, int],
+    H: int,
+    W: int,
+    reserved: np.ndarray,
+    path_cells: set[tuple[int, int]],
