+
+def _choose_pattern_box(
+    slot: dict,
+    marker: tuple[int, int],
+    H: int,
+    W: int,
+    reserved: np.ndarray,
+    path_cells: set[tuple[int, int]],
+) -> tuple[int, int] | None:
+    candidates: list[tuple[tuple[int, int, int], tuple[int, int]]] = []
+    for tr in range(H - 2):
+        for tc in range(W - 2):
+            box_cells = {(r, c) for r in range(tr, tr + 3) for c in range(tc, tc + 3)}
