+    points = set(coords)
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for start in coords:
+        if start in seen:
+            continue
+        queue = deque([start])
+        seen.add(start)
+        comp: list[tuple[int, int]] = []
+        while queue:
+            r, c = queue.popleft()
+            comp.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in points and (nr, nc) not in seen:
