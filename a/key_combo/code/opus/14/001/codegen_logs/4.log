+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 5
+GUIDE = 3
+INPUT_COLORS = (1, 2, 4, 6, 7, 9)
+OUTPUT_CYCLE = (2, 8, 9)
+GEN_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    return int(np.bincount(values).argmax())
