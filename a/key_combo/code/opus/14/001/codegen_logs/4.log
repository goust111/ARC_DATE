+    sizes = _partition_sizes(group_count, total_pixels)
+    if sizes is None:
+        return None
+    if random.random() < 0.65 and 1 not in sizes and group_count < total_pixels:
+        return None
+
+    specs = [_make_group_spec(size, row_major) for size in sizes]
