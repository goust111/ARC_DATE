+    ("outer35", ((1, 0), (1, 4), (3, 0), (3, 4))),
+    ("outer53", ((0, 1), (0, 3), (4, 1), (4, 3))),
+    ("diamond55", ((0, 2), (2, 0), (2, 4), (4, 2))),
+    ("zig53_a", ((0, 2), (1, 1), (3, 3), (4, 2))),
+    ("zig53_b", ((0, 2), (1, 3), (3, 1), (4, 2))),
+    ("zig35_a", ((1, 1), (2, 0), (2, 4), (3, 3))),
+    ("zig35_b", ((1, 3), (2, 0), (2, 4), (3, 1))),
