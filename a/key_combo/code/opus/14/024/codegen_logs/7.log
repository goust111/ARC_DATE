+
+
+def _place_sprite_in_chamber(
+    grid: np.ndarray,
+    reserved: set[tuple[int, int]],
+    path_set: set[tuple[int, int]],
+    anchor: tuple[int, int],
+    orientation: str,
+    color: int,
+    template: set[tuple[int, int]],
