+
+
+def _turn_blockers_from_path(path: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    path_set = set(path)
+    blockers: set[tuple[int, int]] = set()
+    for i in range(1, len(path) - 1):
+        pr, pc = path[i - 1]
+        cr, cc = path[i]
+        nr, nc = path[i + 1]
+        d0 = (cr - pr, cc - pc)
+        d1 = (nr - cr, nc - cc)
+        if d0 == d1:
