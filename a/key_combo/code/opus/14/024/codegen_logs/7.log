+            if _in_bounds(g.shape, tr, tc) and int(g[tr, tc]) in (BLACK, GREEN):
+                choices.append((tdr, tdc))
+        assert len(choices) == 1, "each blocker collision must force a unique 90-degree turn"
+        dr, dc = choices[0]
