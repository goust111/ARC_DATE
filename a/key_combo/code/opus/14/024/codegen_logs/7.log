+    pixel_to_sprite: dict[tuple[int, int], int] = {}
+    for color in colors:
+        comps = comp_map[color]
+        assert len(comps) == 1, "each sprite color must form exactly one component"
+        coords = comps[0]
+        assert 3 <= len(coords) <= 6, "sprite area must be 3..6"
