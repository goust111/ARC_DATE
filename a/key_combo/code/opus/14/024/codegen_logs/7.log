+    if not any(abs(anchor[0] - r) + abs(anchor[1] - c) == 1 for r, c in sprite_cells):
+        return None
+
+    for r, c in wall_cells:
+        grid[r, c] = BLOCKER
+    for r, c in sprite_cells:
+        grid[r, c] = color
