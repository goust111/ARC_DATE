    sizes = list(random.choice(choices))
    leftover = total - sum(sizes) - _GEN_MIN_AXIS_GAP * (n - 1)
    extras = _gen_composition(leftover, n + 1)
    spans = []
    pos = extras[0]
    for i, size in enumerate(sizes):
