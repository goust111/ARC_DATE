+
+def _rotate_grid_and_crops(grid: np.ndarray, crops: list[np.ndarray], k: int) -> tuple[np.ndarray, list[np.ndarray]]:
+    return np.rot90(grid, k).copy(), [_rotated_crop(crop, k) for crop in crops]
