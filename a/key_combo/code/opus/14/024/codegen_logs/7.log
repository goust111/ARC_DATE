+
+    def plan_key(item: tuple[int, tuple[int, int]]) -> tuple[int, int, int]:
+        seg_idx, anchor = item
+        seg_cells = list(segments[seg_idx]["cells"])
+        return seg_idx, seg_cells.index(anchor), anchor[0] * 100 + anchor[1]
+
+    return sorted(plan, key=plan_key)
