+        assert r1 - r0 + 1 <= 3 and c1 - c0 + 1 <= 3, "sprite bbox must fit in 3x3"
+        sprite_id = len(sprites)
+        sprites.append({"color": color, "coords": coords, "bbox": (r0, c0, r1, c1)})
+        for rc in coords:
