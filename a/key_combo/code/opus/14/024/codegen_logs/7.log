+def _transform_local(anchor: tuple[int, int], side: str, locals_: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    ar, ac = anchor
+    out = set()
+    for lr, lc in locals_:
+        if side == "right":
+            out.add((ar + lr - 1, ac + lc + 1))
+        elif side == "left":
+            out.add((ar + lr - 1, ac - lc - 1))
+        elif side == "down":
+            out.add((ar + lc + 1, ac + lr - 1))
+        else:
