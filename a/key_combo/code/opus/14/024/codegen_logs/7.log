+        out[color] = comps
+    return out
+
+
+def _sprite_index(grid: np.ndarray) -> tuple[list[dict[str, object]], dict[tuple[int, int], int]]:
+    colors = sorted(set(map(int, np.unique(grid))) - {BLACK, GREEN, BLOCKER})
+    comp_map = _components_by_color(grid, colors)
