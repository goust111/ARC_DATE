+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+BLOCKER = 8
+
+SPRITE_PALETTE = (RED, YELLOW, GREY, PINK, ORANGE)
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
