+    path = [(0, cols[0]), (1, cols[0])]
+    segments: list[dict[str, object]] = []
+    current = path[-1]
+
+    for i, vlen in enumerate(vertical_lengths):
+        seg_cells = [current]
+        for _ in range(vlen):
