+
+    if need_trunc and sep == 5 and right_max == 6:
+        d_left = rng.randint(2, 5)
+        distances.append((d_left, 6))
+        truncation = True
+    elif need_trunc and right_room == 5 and left_max == 6:
+        d_right = rng.randint(2, 5)
+        distances.append((6, d_right))
+        truncation = True
