spec:
  grid: 3x3
  colors:
    num_distinct: 2-4
    no_gray: gray (5) must not appear in input
    majority: exactly one color has strictly the largest pixel count
    majority_count: 3-7 pixels (out of 9)
    runner_up_count: 1-3 pixels [observed]
    gap_to_second: >=1 (uniqueness required)
  transform:
    keep: pixels of the unique most-frequent color stay unchanged
    replace: all other pixels become gray (5)
    output_size: same 3x3

generation_strategy:
  approach: direct random (grid is tiny, constraints are easy to satisfy)
  steps:
