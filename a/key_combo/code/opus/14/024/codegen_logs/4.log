    expected = np.full_like(inp, BACKGROUND_COLOR)
    expected[[0, -1], :] = marker_color
    expected[:, [0, -1]] = marker_color
    return expected


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        inp = _gen_attempt()
