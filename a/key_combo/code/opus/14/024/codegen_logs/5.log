+    out[:, sep_col] = SEP
+    for spec, top in zip(shape_specs, top_rows):
+        patch = spec["patch"]
+        left = sep_col - patch.shape[1]
+        out[top : top + patch.shape[0], left : left + patch.shape[1]][patch == BLACK] = BLACK
