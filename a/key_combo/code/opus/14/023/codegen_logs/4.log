+        h = 2 * qh + 1
+        w = 2 * qw + 1
+        grid = np.zeros((h, w), dtype=int)
+        grid[qh, :] = GREY
+        grid[:, qw] = GREY
+        grid[:qh, :qw] = tl_noisy
+        grid[qh + 1 :, qw + 1 :] = br_noisy
+
+        out = main(grid)
+        _validate_generated(grid, out)
+        return grid
