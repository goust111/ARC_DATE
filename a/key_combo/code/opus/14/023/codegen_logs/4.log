+def _score_axis(block: np.ndarray, axis_k: int) -> int:
+    h, w = block.shape
+    score = 0
+    for color in SHAPE_COLORS:
+        for r, c in np.argwhere(block == color):
+            cc = axis_k - int(c)
+            if 0 <= cc < w and int(block[int(r), cc]) == color:
