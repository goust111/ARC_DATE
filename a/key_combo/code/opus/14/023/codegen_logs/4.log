+    total_counts = {color: int(np.count_nonzero(block == color)) for color in SHAPE_COLORS}
+    for r in range(h):
+        seen: set[tuple[int, int]] = set()
+        for c in range(w):
+            cc = axis_k - c
+            if cc < 0 or cc >= w:
+                continue
+            pair = tuple(sorted((int(c), int(cc))))
+            if pair in seen:
