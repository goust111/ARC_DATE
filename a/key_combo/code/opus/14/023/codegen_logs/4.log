+def _mirror_swap(block: np.ndarray) -> np.ndarray:
+    mirrored = np.fliplr(block)
+    swapped = mirrored.copy()
+    swapped[mirrored == BLUE] = RED
+    swapped[mirrored == RED] = BLUE
