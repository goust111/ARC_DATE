+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    mid_r, mid_c = _full_grey_cross(g)
+    tl = g[:mid_r, :mid_c]
+    tr = g[:mid_r, mid_c + 1 :]
+    bl = g[mid_r + 1 :, :mid_c]
+    br = g[mid_r + 1 :, mid_c + 1 :]
