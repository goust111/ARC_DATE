+    mask[:, -1] = True
+    if kind == "frame":
+        return mask
+    if kind == "double_v":
+        cols = [w // 2] if w % 2 == 1 else [w // 2 - 1, w // 2]
+        for col in cols:
+            mask[1:-1, col] = True
+        return mask
+    if kind == "double_h":
+        row = h // 2
+        mask[row, 1:-1] = True
+        return mask
