+def _transform(coords: tuple[tuple[int, int], ...], rotation: int, reflect: bool) -> tuple[tuple[int, int], ...]:
+    transformed = list(coords)
+    if reflect:
+        transformed = [(r, -c) for r, c in transformed]
+    for _ in range(rotation % 4):
