+def _stable_ranks(values: list[int]) -> list[int]:
+    order = sorted(range(len(values)), key=lambda idx: (values[idx], idx))
+    ranks = [0] * len(values)
+    for rank, idx in enumerate(order, start=1):
+        ranks[idx] = rank
+    return ranks
