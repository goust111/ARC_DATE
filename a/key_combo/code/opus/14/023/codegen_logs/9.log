+def _gen_attempt() -> np.ndarray | None:
+    cell_size = int(np.random.choice(np.array(CELL_SIZE_CHOICES, dtype=int)))
+    full_size = GRID_PARTS * cell_size + (GRID_PARTS - 1)
+    grid = np.full((full_size, full_size), BG, dtype=int)
