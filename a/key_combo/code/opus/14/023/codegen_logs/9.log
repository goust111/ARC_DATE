+def _randint(lo: int, hi: int) -> int:
+    return int(np.random.randint(lo, hi + 1))
+
+
+def _choose_offset(slack: int) -> int:
+    if slack >= 2:
+        return _randint(1, slack - 1)
+    return _randint(0, slack)
+
+
+def _paint_shape(
+    grid: np.ndarray,
+    cell_row: int,
+    cell_col: int,
+    cell_size: int,
+    coords: tuple[tuple[int, int], ...],
+    color: int,
+) -> None:
