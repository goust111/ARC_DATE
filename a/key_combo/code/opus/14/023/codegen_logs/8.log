+    assert (n_rows, n_cols) in COUNT_PAIRS
+    assert block.shape[0] >= 2 and block.shape[1] >= 2
+    assert int(np.count_nonzero(np.isin(block, SHAPE_COLORS))) == int(np.count_nonzero(shape_mask))
