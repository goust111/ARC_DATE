+
+    row_pool = list(range(0, top)) + list(range(bottom + 1, h))
+    orange_rows = random.sample(row_pool, n_cols)
+    pink_rows = random.sample(row_pool, n_rows)
+    grid[orange_rows, 0] = ORANGE
+    grid[pink_rows, w - 1] = PINK
+    return True
+
