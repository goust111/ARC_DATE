+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+
+SHAPE_COLORS = (RED, GREEN, YELLOW)
+COUNT_PAIRS = ((2, 3), (2, 4), (3, 2), (3, 4), (4, 2), (4, 3))
+ORIENTATIONS = ("H", "V")
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 600
+
+_SEEN_OUTPUTS: set[str] = set()
+_GEN_SUCCESS_COUNT = 0
