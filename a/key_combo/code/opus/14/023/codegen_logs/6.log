+    full_rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == GREY)]
+    full_cols = [c for c in range(g.shape[1]) if np.all(g[:, c] == GREY)]
+    assert not (full_rows and full_cols), "expected one separator orientation"
