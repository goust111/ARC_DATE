def _gen_output(rng: np.random.Generator) -> np.ndarray:
    n_colors = int(rng.integers(*OUTPUT_COLOR_COUNT_RANGE))
    colors = rng.choice(OUTPUT_PALETTE, size=n_colors, replace=False)
    values: dict[tuple[int, int], int] = {}
