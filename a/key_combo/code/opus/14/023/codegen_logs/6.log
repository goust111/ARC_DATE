                (row, col),
                (col, row),
                (row, GRID_SIZE - 1 - col),
                (GRID_SIZE - 1 - row, col),
                (GRID_SIZE - 1 - row, GRID_SIZE - 1 - col),
                (col, GRID_SIZE - 1 - row),
                (GRID_SIZE - 1 - col, row),
                (GRID_SIZE - 1 - col, GRID_SIZE - 1 - row),
            }
        )
    )


def _gen_reflection_orbit(row: int, col: int) -> tuple[tuple[int, int], ...]:
    return tuple(
