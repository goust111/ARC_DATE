+    out: list[tuple[tuple[int, int], ...]] = []
+    for r in range(h):
+        for c in range(w):
+            orbit = _reflection_orbit(r, c, h, w)
+            if orbit not in seen:
+                seen.add(orbit)
+                out.append(orbit)
+    return out
