+def _connected(cells) -> bool:
+    cells = set(cells)
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return len(seen) == len(cells)
+
