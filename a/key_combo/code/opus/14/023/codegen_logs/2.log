+    if direction == "L":
+        return int(r0), int(tc - distance - w + 1)
+    if direction == "D":
+        return int(tr + distance), int(c0)
+    return int(tr - distance - h + 1), int(c0)
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
