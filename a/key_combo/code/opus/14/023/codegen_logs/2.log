+
+def _rect_overlap(a_r0, a_c0, a_h, a_w, b_r0, b_c0, b_h, b_w):
+    rr0 = max(a_r0, b_r0)
+    cc0 = max(a_c0, b_c0)
+    rr1 = min(a_r0 + a_h, b_r0 + b_h)
+    cc1 = min(a_c0 + a_w, b_c0 + b_w)
