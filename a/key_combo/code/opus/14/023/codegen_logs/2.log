+        "tail": tail,
+        "direction": direction,
+        "all_candidates": [item[1] for item in candidates],
+        "best_candidates": [item[1] for item in best],
+        "centroid": centroid,
+    }
+
+
+def _make_patch(body_cells, color: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
