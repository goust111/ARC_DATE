+            analysis = _tail_analysis(coords)
+            tail = analysis["tail"]
+            direction = analysis["direction"]
+            cells = {tuple(map(int, p)) for p in coords}
+            body_cells = sorted(cells - {tail})
+            patch, body_bbox = _make_patch(body_cells, color)
