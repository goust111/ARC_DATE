+    best = [item for item in candidates if abs(item[0] - best_dist) < 1e-9]
+    best.sort(key=lambda item: item[1])
+    _, tail, body_nbr = best[0]
+    dr = int(tail[0] - body_nbr[0])
+    dc = int(tail[1] - body_nbr[1])
+    direction = DIR_FROM_VEC[(dr, dc)]
