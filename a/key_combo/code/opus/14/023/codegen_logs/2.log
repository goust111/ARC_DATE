+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if visited[r, c]:
+            continue
+        queue = deque([(r, c)])
+        visited[r, c] = True
+        coords = []
+        while queue:
+            rr, cc = queue.popleft()
+            coords.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if _in_bounds(grid.shape, nr, nc) and mask[nr, nc] and not visited[nr, nc]:
