+            objects.append(
+                {
+                    "color": int(color),
+                    "count": int(len(cells)),
+                    "tail": tuple(map(int, tail)),
+                    "direction": direction,
+                    "coords": sorted(cells),
+                    "body_cells": body_cells,
+                    "patch": patch,
+                    "body_bbox": body_bbox,
+                    "dst": (int(dst_r0), int(dst_c0)),
+                    "best_tail_count": len(analysis["best_candidates"]),
