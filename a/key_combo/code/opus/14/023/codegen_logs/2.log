+
+def _generate_shape_spec(rng: np.random.Generator, color: int, count: int) -> dict:
+    direction = str(rng.choice(tuple(DIRS)))
+    dr, dc = DIRS[direction]
+    body_size = count - 1
+    for _ in range(500):
