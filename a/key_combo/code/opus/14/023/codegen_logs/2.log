+    b_patch = spec_b["patch"]
+    overlap = _rect_overlap(pos_a[0], pos_a[1], a_patch.shape[0], a_patch.shape[1], pos_b[0], pos_b[1], b_patch.shape[0], b_patch.shape[1])
