            elif even_step:
                out[r, c] = cross_color if step == near_step else v_base
            else:
                out[r, c] = h_base if offset % 2 == 0 else cross_color
    return grid, out


def _gen_attempt() -> np.ndarray | None:
    layout = _sample_layout()
    if layout is None:
