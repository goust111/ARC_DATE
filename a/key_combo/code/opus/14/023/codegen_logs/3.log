+    grey_count = int(grey_mask.sum())
+    assert 3 <= grey_count <= 5, "template must contain 3-5 grey pixels"
+    template = _crop_bbox(grey_mask, grey_box)
+    assert _is_connected(template), "template must be 4-connected"
