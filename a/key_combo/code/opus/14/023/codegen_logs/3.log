+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+) -> None:
+    h, w = patch.shape
+    r1 = r0 + h
+    c1 = c0 + w
+    assert 0 <= r0 <= r1 <= dst.shape[0]
+    assert 0 <= c0 <= c1 <= dst.shape[1]
+    view = dst[r0:r1, c0:c1]
+    if transparent is None:
+        view[:] = patch
+    else:
+        mask = patch != int(transparent)
+        view[mask] = patch[mask]
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    remaining = {tuple(map(int, rc)) for rc in coords}
+    stack = [next(iter(remaining))]
+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nbr in _neighbors4(*cell):
+            if nbr in remaining and nbr not in seen:
+                stack.append(nbr)
+    return seen == remaining
+
+
+def _template_library() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for bits in range(1 << 9):
+        mask = np.array([(bits >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)
+        count = int(mask.sum())
+        if count < 3 or count > 5:
+            continue
+        if not mask[1, 1]:
+            continue
+        if not _is_connected(mask):
+            continue
