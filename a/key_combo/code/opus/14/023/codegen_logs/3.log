+BG = 0
+GREY = 5
+TEAL = 8
+MARKER_PALETTE = (1, 2, 3, 4, 6, 7)
+
+GRID_SHORT_RANGE = (13, 18)
+GRID_LONG_RANGE = (16, 24)
+MARKER_COUNT_RANGE = (4, 6)
