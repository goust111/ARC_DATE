+                continue
+            choice = cell
+            break
+        if choice is None:
+            return None
+        picked.append(choice)
+
+    extras = [cell for key in ("other", "empty") for cell in candidates[key]]
+    rng.shuffle(extras)
+    for cell in extras:
+        if len(picked) >= total_count:
+            break
+        if cell in picked or mirror(cell) in picked:
+            continue
