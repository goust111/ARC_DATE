+        cols = np.where(mask.any(axis=0))[0]
+        if len(rows) < 2 or len(cols) < 2:
+            continue
+        if axis_side == "right" and not np.any(mask[:, :-1]):
+            continue
+        if axis_side == "bottom" and not np.any(mask[:-1, :]):
