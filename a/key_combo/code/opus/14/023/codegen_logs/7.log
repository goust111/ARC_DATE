+    return int(scores[true_k]), int(scores[true_k] - max(others))
+
+
+def _horizontal_axis_gap(mask: np.ndarray) -> tuple[int, int]:
+    h, w = mask.shape
+    pts = np.argwhere(mask)
+    true_k = h - 1
+    scores: list[int] = []
+    for k in range(2 * h - 1):
+        score = 0
+        for r, c in pts:
+            rr = int(k) - int(r)
+            if 0 <= rr < h and mask[rr, int(c)]:
