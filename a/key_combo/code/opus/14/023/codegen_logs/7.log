+def _mirror_vertical_from_half(half_mask: np.ndarray, full_width: int) -> np.ndarray:
+    h, half_w = map(int, half_mask.shape)
+    out = np.zeros((h, full_width), dtype=bool)
+    for r, c in np.argwhere(half_mask):
