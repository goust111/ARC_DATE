+    blue_candidates = _blue_noise_candidates(blue_clean, red_clean, red_noise)
+    blue_noise = _pick_noise(
+        rng,
+        blue_candidates,
+        total_count=int(rng.integers(2, 4)),
+        layer="blue",
+        shape=(h, w),
