+            weights: list[float] = []
+            for r, c in np.argwhere(mask):
+                rr = int(r)
+                cc = int(c)
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w) or mask[nr, nc]:
