+def _weighted_choice(rng: np.random.Generator, items: list[tuple[int, int]], weights: list[float]) -> tuple[int, int]:
+    probs = np.asarray(weights, dtype=float)
+    probs /= probs.sum()
+    idx = int(rng.choice(len(items), p=probs))
+    return items[idx]
