+def _vertical_axis_gap(mask: np.ndarray) -> tuple[int, int]:
+    h, w = mask.shape
+    pts = np.argwhere(mask)
+    true_k = w - 1
+    scores: list[int] = []
+    for k in range(2 * w - 1):
+        score = 0
+        for r, c in pts:
+            cc = int(k) - int(c)
+            if 0 <= cc < w and mask[int(r), cc]:
