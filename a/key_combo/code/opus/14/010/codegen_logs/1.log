+        inp[row0:, col] = DIVIDER
+    for idx, side in enumerate(range(3, 2 * slot_count + 3, 2)):
+        c0 = start_col + idx * (SLOT_W + SEP_W) + SEP_W
+        mask = GLYPHS[side]
+        inp[row0 : row0 + SLOT_W, c0 : c0 + SLOT_W][mask] = STAMP
