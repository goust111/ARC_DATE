+    row0 = inp.shape[0] - LEGEND_H
+    glyph_map = {side: GLYPHS[side] for side in range(3, 2 * slot_count + 3, 2)}
+    for r0, c0, side in sorted(squares):
+        if side % 2 == 0:
+            continue
+        out[r0 : r0 + side, c0 : c0 + side] = BG
+        cr = r0 + side // 2
+        cc = c0 + side // 2
+        mask = glyph_map[side]
+        for dr in range(SLOT_W):
+            for dc in range(SLOT_W):
+                if mask[dr, dc]:
