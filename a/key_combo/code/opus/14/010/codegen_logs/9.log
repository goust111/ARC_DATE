spec:
  grid: 16x16, background 7 [observed]
  colors: 3 distinct — background + marker_color + object_color
  marker:
    shape: 3x3 plus sign (5 pixels), unique color different from object_color
    count: exactly 1
  squares:
    color: single object_color shared by all squares
    shape: solid NxN squares, side lengths 1-7
    count: 5-11 total, at least 1 odd-sided, 0+ even-sided
    odd_count: 2-8; even_count: 3 [observed]
    separation: min Manhattan distance >=2 between any two components (including marker)
    may touch grid edges
  transform:
    odd_squares: center pixel recolored to marker_color
    even_squares: unchanged
    marker_erasure: |
      compute bounding box of all odd-square centers;
      if marker center is inside that bbox, preserve marker; else erase to background

generation_strategy:
  approach: output-first
  steps:
    1. Pick bg=7, marker_color, object_color (3 distinct colors).
    2. Choose N_odd in [2,8], N_even in [1,4]. Assign side lengths (odd: from {1,3,5,7}; even: from {2,4,6}).
    3. Place all squares on a 16x16 grid with >=1 cell gap between any two components (greedy random placement).
    4. Compute odd-square centers. Decide marker_preserved (coin flip).
    5. If marker_preserved: place marker so its center is inside the bounding box of odd centers.
       If not: place marker so its center is outside that bounding box.
       Ensure >=1 cell gap from all squares.
    6. Build output: copy grid, recolor each odd-square center to marker_color; if not marker_preserved, erase marker to bg.
    7. Input = output with odd-square centers reverted to object_color, marker restored (if erased), marker pixels set to marker_color (if it was erased in output).
```
