+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    coord_set = set(coords)
+    expected_area = 2 * h + 2 * w - 4
+    if len(coord_set) != expected_area:
+        return None
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if on_border != ((r, c) in coord_set):
+                return None
+    return r0, c0, r1, c1
+
+
+def _checkerboard_capacity(frame_bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = frame_bbox
+    ih = r1 - r0 - 1
+    iw = c1 - c0 - 1
+    return (ih * iw + 1) // 2
+
+
+def _minimal_period(block: np.ndarray) -> tuple[int, int]:
+    h, w = block.shape
+    best = (h, w)
+    best_area = h * w
+    for ph in range(1, h + 1):
+        for pw in range(1, w + 1):
+            area = ph * pw
+            if area > best_area:
+                continue
+            ok = True
+            for r in range(h):
+                for c in range(w):
+                    if int(block[r, c]) != int(block[r % ph, c % pw]):
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok and (area < best_area or (area == best_area and (ph, pw) < best)):
+                best = (ph, pw)
+                best_area = area
+    return best
+
+
+def _tile_full(tile: np.ndarray, h: int, w: int) -> np.ndarray:
+    rr = np.arange(h)[:, None] % tile.shape[0]
+    cc = np.arange(w)[None, :] % tile.shape[1]
+    return tile[rr, cc]
+
