+        blocked[r, c] = True
+        allowed[r, c] = False
+    return True
+
+
+def _build_expected_output(inp: np.ndarray) -> np.ndarray:
+    return main(inp)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    top_input, top_full, target_n = _design_top_patch()
