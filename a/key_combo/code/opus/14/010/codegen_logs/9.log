    return candidates


def _gen_place_records(records, rows, cols):
    """Render every full motif variant and return the output grid plus placements."""
    out = np.zeros((rows, cols), dtype=int)
    occupied = []
    placements = []
    order = list(range(len(records)))
    random.shuffle(order)

    for index in order:
