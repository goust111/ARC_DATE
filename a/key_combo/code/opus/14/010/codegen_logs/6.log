+import numpy as np
+
+
+BG = 0
+SPRITE = 1
+MARKER = 2
+
+GRID_MIN = 20
+GRID_MAX_EXCLUSIVE = 29
+MARKER_COUNT_CHOICES = (3, 4, 5)
