+            chosen_markers,
+            shape,
+            require_unique=True,
+            require_no_accidental_cover=True,
+        )
+    except ValueError:
+        return None
+
+    if len(order) != marker_count:
+        return None
+
+    expected = np.zeros_like(grid)
+    for r, c in final_coords:
+        expected[r, c] = SPRITE
+    if not np.array_equal(main(grid), expected):
+        return None
