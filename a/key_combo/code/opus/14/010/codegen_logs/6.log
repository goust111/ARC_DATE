+    current_center = _bbox_center(current_box)
+    state_boxes = [_bbox(state) for state in states]
+    candidates: list[tuple[tuple[int, int], set[tuple[int, int]], int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            point = (r, c)
