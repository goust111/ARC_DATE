+    output = np.zeros((height, width), dtype=int)
+    output[:, :catalog_width] = CATALOG_BG
+
+    y = 1
+    template_bboxes = []
+    for item in templates_data:
+        sprite = item["sprite"]
+        th, tw = sprite.shape
