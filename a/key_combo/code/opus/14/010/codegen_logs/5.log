+def _patch_from_component(grid: np.ndarray, coords: list[tuple[int, int]], bg: int) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    bbox = _bbox_from_coords(coords)
+    r0, c0, r1, c1 = bbox
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    for r, c in coords:
