+
+CATALOG_BG = 5
+WORK_BG = 0
+ORIENTATIONS = ("orig", "hflip", "vflip", "hvflip")
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _largest_component_mask(mask: np.ndarray) -> np.ndarray:
+    comps = _components(mask)
+    assert comps, "expected a grey catalog background"
+    largest = max(comps, key=len)
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in largest:
+        out[r, c] = True
+    return out
+
+
+def _touches_mask(coords: list[tuple[int, int]], mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    for r, c in coords:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                return True
+    return False
