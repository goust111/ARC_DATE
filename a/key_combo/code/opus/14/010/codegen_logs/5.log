+        patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+        for r, c in coords:
+            patch[r - r0, c - c0] = int(stamp[r, c])
+        match = _unique_match(patch, templates)
+        if match == (tidx, orientation, r0, c0):
