        # Make and draw the frame
        frame_len = square_len * 2
        green_frame = np.full((frame_len, frame_len), frame_color)
        paste(output_grid, green_frame, r - square_len // 2, c - square_len // 2, transparent=Color.BLACK, clip=True)
    
