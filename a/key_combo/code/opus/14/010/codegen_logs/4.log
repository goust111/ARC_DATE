+def _shear_positions(mask: np.ndarray, shape: tuple[int, int], by_rows: bool) -> set[tuple[int, int]]:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    h, w = shape
+    shifted = set()
+
+    if by_rows:
+        base = int(coords[:, 0].min())
+        for r0, c0 in coords:
+            r, c = int(r0), int(c0)
+            nc = c + (r - base)
+            if nc < w:
