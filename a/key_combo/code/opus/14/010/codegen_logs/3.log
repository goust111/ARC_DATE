+                for sr, sc in np.argwhere(shape):
+                    ar = int(r0 + sr)
+                    ac = int(c0 + sc)
+                    if occupancy[ar, ac]:
+                        ok = False
+                        break
+                    for nr, nc in _neighbors4(ar, ac):
