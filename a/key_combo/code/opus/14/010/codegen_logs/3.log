ACTIVE_HEIGHTS, SHORT_ACTIVE_TOPS = [7, 8], [1, 2]
FULL_ACTIVE_HEIGHT, FULL_ACTIVE_TOP = 8, 1
BAND_COUNTS = [2, 3, 4]
BAND_LEN_MIN, BAND_LEN_MAX = 1, 4
BAND_PALETTE = [int(c) for c in Color.NOT_BLACK if int(c) != FILL_COLOR]

