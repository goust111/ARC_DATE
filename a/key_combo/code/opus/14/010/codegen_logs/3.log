+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+CONTROL_COLORS = (BLUE, GREEN, YELLOW, PINK)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in NEIGHBORS4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _shape_signature(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0, c0, _, _ = _bbox_from_coords(coords)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+
+
+def _coords_by_row(coords: np.ndarray) -> dict[int, list[int]]:
+    rows: dict[int, list[int]] = {}
+    for r, c in coords:
+        rows.setdefault(int(r), []).append(int(c))
+    return rows
+
