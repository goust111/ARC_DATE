+                            ok = False
+                            break
+                    if not ok:
+                        break
+                if ok:
+                    candidates.append((r0, c0))
+        if not candidates:
+            return None
+        r0, c0 = random.choice(candidates)
+        coords = np.argwhere(shape).astype(int)
+        coords[:, 0] += r0
+        coords[:, 1] += c0
+        positions.append(coords)
+        occupancy[coords[:, 0], coords[:, 1]] = True
