    stack: list[Coord] = [start]
    seen_states: set[Coord] = set()

    while stack:
        r, c = stack.pop()
        if (r, c) in seen_states:
            continue
        seen_states.add((r, c))
        assert in_bounds(g.shape, r, c)
        assert g[r, c] != wall
        out[r, c] = marker

        cr, cc = r, c
        while True:
            nr, nc = cr + dr, cc + dc
            if not in_bounds(g.shape, nr, nc):
