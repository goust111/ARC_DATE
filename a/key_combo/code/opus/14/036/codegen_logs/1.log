+        arrangement = random.choice(("row", "col"))
+        gap = random.randint(*GEN_REGION_GAP_RANGE)
+        top = random.randint(*GEN_MARGIN_RANGE)
+        left = random.randint(*GEN_MARGIN_RANGE)
+        bottom = random.randint(*GEN_MARGIN_RANGE)
