+
+
+def _erase_markers_only(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for marker in _find_markers(out):
+        for r, c in marker["coords"]:
+            out[r, c] = BLACK
