spec:
  grid: 10-20 rows x 10-20 cols
  colors:
    bg: 8 (azure), wall: 1 (blue), marker: 6 (magenta), fill: 7 (orange)
  marker: single pixel at bottom-left corner (always BL) [observed]
  structural_walls:
    count: 1-4 border-touching 4-connected components adjacent to marker-reachable region
    shapes: solid rectangles, vertical/horizontal lines, or irregular staircases; each touches >=1 grid edge
    total_pixels: 5-15% of grid area
    role: together with grid edges, form the boundary of the reachable region from marker
  decoration_walls:
    count: 0-3 wall-colored components that are NOT border-touching or NOT adjacent to initial reach
    placement: either inside reachable region (kept in output) or outside (erased to bg in output)
  reachable_region: flood-fill from marker blocked only by structural walls; covers 38-87% of grid
  output_rule: |
    1. Erase decoration walls outside reachable region to bg.
    2. Keep decoration walls inside reachable region as wall color.
    3. Paint orange on every reachable bg cell that is on a grid edge, 8-adjacent to a structural wall, or 4-adjacent to an unreachable cell.
    Result: 1-cell-thick orange inner border lining the reachable region boundary.

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size H x W (10-20 each).
    2. Build the reachable region boundary by placing 1-4 structural wall components on grid edges (lines, rectangles, or staircases). Ensure they form a connected barrier with grid edges that encloses a contiguous reachable region containing BL corner, covering 35-90% of grid.
    3. Place marker (color 6) at (H-1, 0).
    4. Optionally place 0-3 decoration wall components -- small wall-colored blobs either inside the reachable region (not border-touching) or behind structural walls (unreachable side).
    5. Fill all remaining cells with bg (color 8).
    6. Validate by flood-filling from marker: reachable region must have interior depth >= 2 cells so orange border leaves visible bg interior.
```
</generation_spec>
