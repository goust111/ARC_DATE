+    return grid_shape, region_specs
+
+
+def _draw_region(grid: np.ndarray, region: dict) -> None:
+    r0 = region["r0"]
+    c0 = region["c0"]
+    h = region["h"]
+    w = region["w"]
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
