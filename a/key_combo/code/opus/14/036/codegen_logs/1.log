+        gap_len = random.randint(GEN_GAP_LEN_RANGE[0], min(GEN_GAP_LEN_RANGE[1], width - 3))
+        start = random.randint(1, width - gap_len - 1)
+        marker_start = random.randint(start + 1, start + gap_len - 3)
+        return {
+            "side": side,
+            "gap_start": start,
+            "gap_len": gap_len,
+            "marker_start": marker_start,
+            "orientation": "h",
