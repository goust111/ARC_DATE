+            total_w = left + max(w0, w1) + right
+            r0 = top
+            r1 = top + h0 + gap
+            c0 = left + random.randint(0, max(w0, w1) - w0)
+            c1 = left + random.randint(0, max(w0, w1) - w1)
+            grid_shape = (total_h, total_w)
+            regions = [
+                {"r0": r0, "c0": c0, "h": h0, "w": w0},
+                {"r0": r1, "c0": c1, "h": h1, "w": w1},
+            ]
