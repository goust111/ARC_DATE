+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+MARKER_COLORS = (BLUE, RED, GREEN, YELLOW)
+SIDES = ("top", "bottom", "left", "right")
