+GEN_MARKER_COUNT_RANGE = (2, 4)
+GEN_REGION_COUNT_CHOICES = (1, 2)
+GEN_RECT_SIZE_RANGE = (8, 10)
+GEN_MARGIN_RANGE = (1, 2)
+GEN_REGION_GAP_RANGE = (3, 4)
