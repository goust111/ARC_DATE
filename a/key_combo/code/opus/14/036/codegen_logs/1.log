+            grid[list(rows), c0] = BLACK
+            grid[r0 + marker_start : r0 + marker_start + 2, c0] = color
+        else:
+            rows = range(r0 + start, r0 + end + 1)
+            grid[list(rows), c1] = BLACK
+            grid[r0 + marker_start : r0 + marker_start + 2, c1] = color
