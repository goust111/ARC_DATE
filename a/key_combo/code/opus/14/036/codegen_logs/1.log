+    completed, _markers, _ray_records = _apply_markers(g)
+    exterior = _exterior_black_mask(completed)
+
+    out = completed.copy()
+    out[exterior] = GREEN
+    out[out == BLACK] = RED
+    return out
+
+
+GEN_MARKER_COUNT_RANGE = (2, 4)
+GEN_REGION_COUNT_CHOICES = (1, 2)
+GEN_RECT_SIZE_RANGE = (8, 10)
+GEN_MARGIN_RANGE = (1, 2)
