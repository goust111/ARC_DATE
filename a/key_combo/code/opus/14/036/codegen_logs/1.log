+    gap_len = random.randint(GEN_GAP_LEN_RANGE[0], min(GEN_GAP_LEN_RANGE[1], height - 3))
+    start = random.randint(1, height - gap_len - 1)
+    marker_start = random.randint(start + 1, start + gap_len - 3)
