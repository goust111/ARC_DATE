+
+def diag_cells(corner: str, anchor: tuple[int, int, int, int], length: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = anchor
+    if corner == "ul":
+        start = (r0 - 1, c0 - 1)
+        step = (-1, -1)
+    elif corner == "ur":
+        start = (r0 - 1, c1 + 1)
+        step = (-1, 1)
+    elif corner == "dl":
+        start = (r1 + 1, c0 - 1)
+        step = (1, -1)
+    elif corner == "dr":
+        start = (r1 + 1, c1 + 1)
+        step = (1, 1)
+    else:
+        raise AssertionError(corner)
