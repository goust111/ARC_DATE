+    return anchors[0]
+
+
+def ray_info(
+    coord: tuple[int, int], anchor: tuple[int, int, int, int]
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    r, c = coord
+    r0, c0, r1, c1 = anchor
+
+    if r0 <= r <= r1 and c < c0:
+        return (r, c0 - 1), (0, 1)
+    if r0 <= r <= r1 and c > c1:
+        return (r, c1 + 1), (0, -1)
+    if c0 <= c <= c1 and r < r0:
+        return (r0 - 1, c), (1, 0)
+    if c0 <= c <= c1 and r > r1:
+        return (r1 + 1, c), (-1, 0)
