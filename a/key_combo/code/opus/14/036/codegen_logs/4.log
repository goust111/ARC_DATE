+    used_diag = False
+
+    def cells_ok(cells: list[tuple[int, int]]) -> bool:
+        for rr, cc in cells:
+            if not in_bounds((h, w), rr, cc) or (rr, cc) in occupied:
+                return False
+        return True
+
+    while options and wanted > 0:
