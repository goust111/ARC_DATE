+def fill_line(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
+    for r, c in cells:
+        assert grid[r, c] == BLACK
+        grid[r, c] = color
+
+
+def side_cells(side: str, anchor: tuple[int, int, int, int], length: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = anchor
+    cells: list[tuple[int, int]] = []
+    if side == "right":
+        for r in range(r0, r1 + 1):
+            for k in range(length):
+                cells.append((r, c1 + 1 + k))
+    elif side == "left":
+        for r in range(r0, r1 + 1):
+            for k in range(length):
+                cells.append((r, c0 - 1 - k))
+    elif side == "up":
+        for c in range(c0, c1 + 1):
+            for k in range(length):
+                cells.append((r0 - 1 - k, c))
+    elif side == "down":
+        for c in range(c0, c1 + 1):
+            for k in range(length):
+                cells.append((r1 + 1 + k, c))
+    else:
+        raise AssertionError(side)
+    return cells
+
+
+def diag_cells(corner: str, anchor: tuple[int, int, int, int], length: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = anchor
+    if corner == "ul":
+        start = (r0 - 1, c0 - 1)
+        step = (-1, -1)
+    elif corner == "ur":
+        start = (r0 - 1, c1 + 1)
+        step = (-1, 1)
+    elif corner == "dl":
+        start = (r1 + 1, c0 - 1)
+        step = (1, -1)
+    elif corner == "dr":
+        start = (r1 + 1, c1 + 1)
+        step = (1, 1)
+    else:
+        raise AssertionError(corner)
+    return [(start[0] + i * step[0], start[1] + i * step[1]) for i in range(length)]
+
+
+def scatter_from_output(
+    shape: tuple[int, int],
+    terminal: tuple[int, int],
+    away: tuple[int, int],
+    count: int,
+    occupied: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    tr, tc = terminal
+    dr, dc = away
+    cells: list[tuple[int, int]] = []
+    max_dist = 0
+    nr, nc = tr + dr, tc + dc
+    while in_bounds(shape, nr, nc):
+        max_dist += 1
+        nr += dr
+        nc += dc
+    if max_dist < count:
+        return None
+
+    choices = list(range(1, max_dist + 1))
+    rng.shuffle(choices)
+    choices.sort()
+
+    used: list[int] = []
+    for dist in choices:
+        pos = (tr + dr * dist, tc + dc * dist)
+        if pos in occupied:
+            continue
+        used.append(dist)
+        occupied.add(pos)
+        cells.append(pos)
+        if len(cells) == count:
+            return cells
+    return None
