    if int((actual == mod.ORANGE).sum()) < 8:
        counts['few_orange'] += 1; continue
    reach = mod.flood_reachable_black(compacted)
    if not ((expected_output == mod.BLACK) & (~reach)).any():
        counts['no_enclosed'] += 1; continue
    if not ((input_grid == mod.BLUE) & (expected_output == mod.BLACK)).any():
        counts['no_blue_removed'] += 1; continue
    if np.array_equal(mod.naive_without_compaction(input_grid), expected_output):
        counts['naive_same'] += 1; continue
    loose_by_color = 0
    for color in mod.ANCHOR_COLORS:
        mask = input_grid == color
        if not mask.any():
            continue
        try:
            anchor = mod.find_anchor(mask)
        except AssertionError:
            counts['bad_anchor_post'] += 1; loose_by_color = -999; break
        r0,c0,r1,c1 = anchor
        for rr,cc in np.argwhere(mask):
            r=int(rr); c=int(cc)
            if r0<=r<=r1 and c0<=c<=c1:
                continue
            mod.ray_info((r,c), anchor)
            loose_by_color += 1
    if loose_by_color < 8:
        counts['few_loose'] += 1; continue
    counts['success'] += 1
print(counts)
