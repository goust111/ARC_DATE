+
+
+def build_barrier_blue(
+    h: int,
+    w: int,
+    rt: int,
+    cl: int,
+    rb: int,
+    cr: int,
+    corridor_side: str,
+    rng: random.Random,
+) -> np.ndarray:
+    g = np.zeros((h, w), dtype=int)
+    g[rt, cl : cr + 1] = BLUE
+    g[rb, cl : cr + 1] = BLUE
+    g[rt : rb + 1, cl] = BLUE
+    g[rt : rb + 1, cr] = BLUE
+
+    if corridor_side == "top":
+        col = rng.randint(cl + 1, cr - 1)
+        g[0 : rt + 1, col] = BLUE
+    elif corridor_side == "bottom":
