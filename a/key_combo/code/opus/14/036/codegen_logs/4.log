+    if "top" in sides:
+        low = cl + 2 + (4 if "left" in sides else 0)
+        high = cr - 4 - (4 if "right" in sides else 0)
+        pos["top"] = min(max(mid_c - 1 + jitter_c, low), high)
+    if "bottom" in sides:
+        low = cl + 2 + (4 if "left" in sides else 0)
+        high = cr - 4 - (4 if "right" in sides else 0)
+        pos["bottom"] = min(max(mid_c - 1 - jitter_c, low), high)
