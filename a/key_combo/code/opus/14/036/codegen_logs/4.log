+
+        wanted -= 1
+
+    if require_diag and not used_diag:
+        diag_map = {
+            "right": ("ur", "dr"),
+            "left": ("ul", "dl"),
+            "top": ("ul", "ur"),
+            "bottom": ("dl", "dr"),
+        }
