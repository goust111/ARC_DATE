+    mid_r = (rt + rb) // 2
+    mid_c = (cl + cr) // 2
+    jitter_r = rng.randint(-1, 1)
+    jitter_c = rng.randint(-1, 1)
+
+    if "left" in sides:
+        low = rt + 2 + (4 if "top" in sides else 0)
+        high = rb - 4 - (4 if "bottom" in sides else 0)
+        pos["left"] = min(max(mid_r - 1 + jitter_r, low), high)
+    if "right" in sides:
+        low = rt + 2 + (4 if "top" in sides else 0)
+        high = rb - 4 - (4 if "bottom" in sides else 0)
+        pos["right"] = min(max(mid_r - 1 - jitter_r, low), high)
+    if "top" in sides:
+        low = cl + 2 + (4 if "left" in sides else 0)
+        high = cr - 4 - (4 if "right" in sides else 0)
+        pos["top"] = min(max(mid_c - 1 + jitter_c, low), high)
+    if "bottom" in sides:
+        low = cl + 2 + (4 if "left" in sides else 0)
+        high = cr - 4 - (4 if "right" in sides else 0)
+        pos["bottom"] = min(max(mid_c - 1 - jitter_c, low), high)
