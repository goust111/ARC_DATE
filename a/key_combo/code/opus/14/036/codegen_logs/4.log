+    if corridor_side == "top":
+        col = random.randint(cl + 1, cr - 1)
+        g[0 : rt + 1, col] = BLUE
+    elif corridor_side == "bottom":
+        col = random.randint(cl + 1, cr - 1)
+        g[rb:h, col] = BLUE
+    elif corridor_side == "left":
+        row = random.randint(rt + 1, rb - 1)
+        g[row, 0 : cl + 1] = BLUE
+    else:
+        row = random.randint(rt + 1, rb - 1)
+        g[row, cr:w] = BLUE
