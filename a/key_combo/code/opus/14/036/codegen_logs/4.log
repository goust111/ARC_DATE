+    elif corner == "ur":
+        start = (r0 - 1, c1 + 1)
+        step = (-1, 1)
+    elif corner == "dl":
+        start = (r1 + 1, c0 - 1)
+        step = (1, -1)
+    elif corner == "dr":
+        start = (r1 + 1, c1 + 1)
+        step = (1, 1)
