+    cl: int,
+    rb: int,
+    cr: int,
+    corridor_side: str,
+) -> np.ndarray:
+    g = np.zeros((h, w), dtype=int)
+    g[rt, cl : cr + 1] = BLUE
+    g[rb, cl : cr + 1] = BLUE
+    g[rt : rb + 1, cl] = BLUE
+    g[rt : rb + 1, cr] = BLUE
