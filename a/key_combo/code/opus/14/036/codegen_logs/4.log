+    cl: int,
+    rb: int,
+    cr: int,
+    corridor_side: str,
+    rng: random.Random,
+) -> np.ndarray:
+    g = np.zeros((h, w), dtype=int)
+    g[rt, cl : cr + 1] = BLUE
+    g[rb, cl : cr + 1] = BLUE
+    g[rt : rb + 1, cl] = BLUE
+    g[rt : rb + 1, cr] = BLUE
+
+    if corridor_side == "top":
+        col = rng.randint(cl + 1, cr - 1)
+        g[0 : rt + 1, col] = BLUE
+    elif corridor_side == "bottom":
+        col = rng.randint(cl + 1, cr - 1)
+        g[rb:h, col] = BLUE
+    elif corridor_side == "left":
+        row = rng.randint(rt + 1, rb - 1)
+        g[row, 0 : cl + 1] = BLUE
+    else:
+        row = rng.randint(rt + 1, rb - 1)
+        g[row, cr:w] = BLUE
+    return g
