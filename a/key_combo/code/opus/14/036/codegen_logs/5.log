0041: def main(grid: np.ndarray) -> np.ndarray:
0042:     """
0043:     Fill enclosed regions along a line seeded by unique border pixels.
0044: 
0045:     Input structure:
0046:     - bg = most common color.
0047:     - Colored lines/drawings on the grid.
0048:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.
0049: 
0050:     Rule:
0051:     - Each border seed pixel connects (8-connected) to a line drawing.
0052:     - Find closed bg cavities whose boundary touches that line.
0053:     - Flood-fill each such cavity with the seed pixel's color.
0054: 
0055:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.
0056:     """
0057:     g = np.asarray(grid, dtype=int)
0058:     h, w = g.shape
0059:     bg = get_bg(g)
0060: 
0061:     out = g.copy()
0062: 
0063:     # Precompute background regions (4-connected). Exclude those containing background corners as "outside".
0064:     bg_comps = _components_mask(g == bg, conn8=False)
0065:     regions = []  # list of (set_pts, boundary_set, touches_border, size)
0066:     for pts in bg_comps:
0067:         region = set(pts)
0068:         touches = _touches_border(pts, h, w)
0069:         boundary = set()
0070:         for r, c in region:
0071:             for nr, nc in neighbors4(r, c):
0072:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:
0073:                     boundary.add((nr, nc))
0074:         regions.append((region, boundary, touches, len(region)))
0075: 
0076:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
