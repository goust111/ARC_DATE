+    inp_sig = hashlib.md5(grid.tobytes() + str(grid.shape).encode()).hexdigest()
+    out_sig = hashlib.md5(expected_tile.tobytes() + str(expected_tile.shape).encode()).hexdigest()
+    return inp_sig, out_sig
