+    rows = np.flatnonzero(~sep_rows)
+    cols = np.flatnonzero(~sep_cols)
+    assert rows.size > 0 and cols.size > 0
+    core = np.asarray(grid[np.ix_(rows, cols)], dtype=int)
+    assert core.size > 0
+    assert not np.any(core == SEPARATOR)
+    return rows, cols, core
+
