0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Connect framed squares via colored bridges following a control-pixel sequence.
0009: 
0010:     Input structure:
0011:     - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.
0012:     - Control row below squares: colored pixels read left-to-right encode visitation order.
0013: 
0014:     Rule:
0015:     - Start at the square matching first control color c0.
0016:     - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.
0017:     - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.
0018: 
0019:     Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.
0020:     """
0021:     g = np.array(grid, dtype=int)
0022:     H, W = g.shape
0023:     bg = int(get_bg(g))
0024: 
0025:     # border color = most common non-bg color
0026:     cnt = Counter(map(int, g.flatten()))
0027:     border = None
0028:     for col, _k in cnt.most_common():
0029:         if int(col) != int(bg):
0030:             border = int(col)
0031:             break
0032:     assert not (border is None)
0033: 
0034:     # detect framed squares as connected components of the border color
0035:     lab, n = label_mask(g == int(border), connectivity=4)
0036:     frames: list[dict] = []
0037:     for cid in range(1, int(n) + 1):
0038:         pts = np.argwhere(lab == int(cid))
0039:         if int(pts.shape[0]) < 8:
0040:             continue
0041:         r0, c0 = pts.min(axis=0)
0042:         r1, c1 = pts.max(axis=0)
0043:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
0044:         h = int(r1 - r0 + 1)
0045:         w = int(c1 - c0 + 1)
0046:         if h < 3 or w < 3:
0047:             continue
0048: 
0049:         t = None
0050:         inner_col = None
0051:         for tt in range(1, int(min(h, w) // 2) + 1):
0052:             inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]
0053:             if inner.size == 0:
0054:                 continue
0055:             if bool((inner == int(border)).any()):
0056:                 continue
0057:             u = set(map(int, inner.flatten()))
0058:             if len(u) != 1:
0059:                 continue
0060: 
0061:             ok = True
0062:             if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):
0063:                 ok = False
0064:             if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):
0065:                 ok = False
0066:             if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):
0067:                 ok = False
0068:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):
0069:                 ok = False
0070:             if not ok:
0071:                 continue
0072: 
0073:             t = int(tt)
0074:             inner_col = int(next(iter(u)))
0075:             break
0076: 
0077:         if t is None or inner_col is None:
0078:             continue
0079: 
0080:         frames.append(
0081:             {
0082:                 "bbox": (int(r0), int(c0), int(r1), int(c1)),
0083:                 "t": int(t),
0084:                 "inner": int(inner_col),
0085:                 "inner_bbox": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),
0086:             }
0087:         )
0088: 
0089:     assert not (not frames)
0090: 
0091:     by: dict[int, list[dict]] = defaultdict(list)
0092:     for f in frames:
0093:         by[int(f["inner"])].append(f)
0094: 
0095:     max_frame_r = max(int(f["bbox"][2]) for f in frames)
0096: 
0097:     # control row = bottom-most row below the squares with >=2 non-bg pixels
0098:     ctrl_r = None
0099:     for r in range(int(H - 1), int(max_frame_r), -1):
0100:         if int((g[int(r)] != int(bg)).sum()) >= 2:
0101:             ctrl_r = int(r)
0102:             break
0103:     assert not (ctrl_r is None)
0104: 
0105:     ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]
0106:     assert not (len(ctrl) < 2)
0107: 
0108:     def center(f: dict) -> tuple[int, int]:
0109:         r0, c0, r1, c1 = map(int, f["bbox"])
0110:         return int((r0 + r1) // 2), int((c0 + c1) // 2)
0111: 
0112:     def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:
0113:         a = f1["inner_bbox"]
0114:         b = f2["inner_bbox"]
0115:         same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))
0116:         same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))
0117:         return same_row, same_col
0118: 
0119:     # choose start frame
0120:     start_color = int(ctrl[0])
0121:     assert not (start_color not in by)
0122:     start_cands = by[start_color]
0123:     if len(start_cands) == 1:
0124:         cur = start_cands[0]
0125:     else:
0126:         nxt_color = int(ctrl[1])
0127:         nxt_cands = by.get(nxt_color, [])
0128:         best = None
0129:         bestf = None
0130:         for f in start_cands:
0131:             for g2 in (nxt_cands if nxt_cands else [f]):
0132:                 sr, sc = aligned(f, g2)
0133:                 al = 1 if (sr or sc) else 0
0134:                 (r1_, c1_) = center(f)
0135:                 (r2_, c2_) = center(g2)
0136:                 d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))
0137:                 cand = (int(al), -int(d))
0138:                 if best is None or cand > best:
0139:                     best = cand
0140:                     bestf = f
0141:         cur = bestf
0142: 
0143:     out = g.copy()
0144: 
0145:     def draw_bridge(fa: dict, fb: dict, color: int) -> None:
0146:         (r0a, c0a, r1a, c1a) = map(int, fa["bbox"])
0147:         (r0b, c0b, r1b, c1b) = map(int, fb["bbox"])
0148:         ia = fa["inner_bbox"]
0149:         sr, sc = aligned(fa, fb)
0150:         if sr:
0151:             rr0, rr1 = int(ia[0]), int(ia[2])
0152:             if int(c1a) < int(c0b):
0153:                 cc0, cc1 = int(c1a + 1), int(c0b - 1)
0154:             else:
0155:                 cc0, cc1 = int(c1b + 1), int(c0a - 1)
0156:             for r in range(int(rr0), int(rr1) + 1):
0157:                 for c in range(int(cc0), int(cc1) + 1):
0158:                     if 0 <= r < H and 0 <= c < W:
0159:                         out[int(r), int(c)] = int(color)
0160:             return
0161:         if sc:
0162:             cc0, cc1 = int(ia[1]), int(ia[3])
0163:             if int(r1a) < int(r0b):
0164:                 rr0, rr1 = int(r1a + 1), int(r0b - 1)
0165:             else:
0166:                 rr0, rr1 = int(r1b + 1), int(r0a - 1)
0167:             for r in range(int(rr0), int(rr1) + 1):
0168:                 for c in range(int(cc0), int(cc1) + 1):
0169:                     if 0 <= r < H and 0 <= c < W:
0170:                         out[int(r), int(c)] = int(color)
0171: 
0172:     for i in range(int(len(ctrl)) - 1):
0173:         a = int(ctrl[i])
0174:         b = int(ctrl[i + 1])
0175:         assert int(cur["inner"]) == int(a)
0176:         assert b in by, f"control color {b} has no matching frame"
0177:         cands = by[b]
0178:         best = None
0179:         bestf = None
0180:         for f in cands:
0181:             sr, sc = aligned(cur, f)
0182:             al = 1 if (sr or sc) else 0
0183:             (r1_, c1_) = center(cur)
0184:             (r2_, c2_) = center(f)
0185:             d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))
0186:             cand = (int(al), -int(d))
0187:             if best is None or cand > best:
0188:                 best = cand
0189:                 bestf = f
0190:         nxt = bestf
0191:         draw_bridge(cur, nxt, int(a))
0192:         cur = nxt
0193: 
0194:     return out
0195: 
