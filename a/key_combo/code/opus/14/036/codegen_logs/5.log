+def _majority_color(values: np.ndarray) -> int:
+    counts = Counter(map(int, np.asarray(values).flat))
+    top = counts.most_common()
+    assert len(top) >= 1
+    if len(top) >= 2:
+        assert top[0][1] > top[1][1], "expected a unique majority color"
+    return int(top[0][0])
