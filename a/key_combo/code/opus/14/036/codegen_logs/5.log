+def _count_bands(separator_mask: np.ndarray) -> int:
+    bands = 0
+    in_band = False
+    for is_separator in map(bool, separator_mask):
+        if is_separator:
+            in_band = False
+        elif not in_band:
+            bands += 1
+            in_band = True
+    return bands
