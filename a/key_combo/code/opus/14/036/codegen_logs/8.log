+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+INPUT_COLORS = (1, 2, 3, 4)
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
