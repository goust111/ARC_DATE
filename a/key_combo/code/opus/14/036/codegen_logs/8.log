+) -> np.ndarray | None:
+    area_values = random.sample(list(BASE_TEMPLATES), 4)
+    area_values.sort()
+    winner_area = area_values[-1]
+    loser_areas = area_values[:-1]
+    random.shuffle(loser_areas)
