+    intersections: list[tuple[int, int]] = []
+    vertical_sides = [side for side in ("top", "bottom") if side in ray_by_side]
+    horizontal_sides = [side for side in ("left", "right") if side in ray_by_side]
+    for v_side in vertical_sides:
