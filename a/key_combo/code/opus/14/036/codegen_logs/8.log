+        top_row = r0 - random.randint(2, 3)
+        tips["left"] = (top_row - 1, left_col)
+        tips["top"] = (top_row, left_col - 1)
+    elif pair == ("right", "top"):
+        right_col = c1 + random.randint(2, 3)
+        top_row = r0 - random.randint(2, 3)
+        tips["right"] = (top_row - 1, right_col)
