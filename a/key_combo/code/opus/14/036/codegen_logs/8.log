+    5: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1)],
+    6: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1)],
+    7: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1), (-2, -1)],
+    8: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1), (-2, -1), (-3, 0)],
+    9: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1), (-2, -1), (-3, 0), (-3, 1)],
+    10: [
+        (0, 0),
+        (-1, 0),
+        (-2, 0),
+        (-1, 1),
+        (-1, -1),
+        (-2, 1),
+        (-2, -1),
+        (-3, 0),
+        (-3, 1),
+        (-3, -1),
+    ],
+}
