+    out, _meta = _independent_transform(np.asarray(grid, dtype=int))
+    return out
+
+
+def _transform_template(base: list[tuple[int, int]], side: str, mirror: bool) -> list[tuple[int, int]]:
+    rels = [(dr, -dc) if mirror else (dr, dc) for dr, dc in base]
+    out = []
+    for dr, dc in rels:
+        if side == "top":
+            rr, cc = dr, dc
+        elif side == "bottom":
+            rr, cc = -dr, -dc
+        elif side == "left":
+            rr, cc = -dc, dr
+        else:
+            rr, cc = dc, -dr
+        out.append((rr, cc))
+    return out
