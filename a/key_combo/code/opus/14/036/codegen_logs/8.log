+
+    row_centers = {_bbox_center(obj)[0] for obj in objects}
+    col_centers = {_bbox_center(obj)[1] for obj in objects}
+    assert len(row_centers) >= 3 and len(col_centers) >= 3, "objects must occupy four cardinal roles"
