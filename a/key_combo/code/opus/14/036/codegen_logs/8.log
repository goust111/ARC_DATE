+
+
+def _center_gap_bbox(side_map: dict[str, dict], grid: np.ndarray) -> tuple[int, int, int, int]:
+    top = side_map["top"]["bbox"]
+    bottom = side_map["bottom"]["bbox"]
+    left = side_map["left"]["bbox"]
+    right = side_map["right"]["bbox"]
