+    objects: dict[str, list[tuple[int, int]]] = {}
+    for side in ("top", "bottom", "left", "right"):
+        coords = _render_object(side, tips[side], side_to_area[side], mirror=bool(random.getrandbits(1)))
+        objects[side] = coords
