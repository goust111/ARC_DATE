+
+def _choose_gap(h: int, w: int) -> tuple[int, int, int, int]:
+    gap_h = random.randint(2, 4)
+    gap_w = random.randint(2, 4)
+    r0 = random.randint(5, h - gap_h - 6)
+    c0 = random.randint(5, w - gap_w - 6)
