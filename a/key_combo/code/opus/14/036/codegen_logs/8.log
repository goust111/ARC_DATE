+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+INPUT_COLORS = (1, 2, 3, 4)
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+# Base templates use a top-side tip at (0, 0) and grow outward/upward.
+BASE_TEMPLATES = {
+    4: [(0, 0), (-1, 0), (-2, 0), (-1, 1)],
+    5: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1)],
+    6: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1)],
+    7: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1), (-2, -1)],
+    8: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1), (-2, -1), (-3, 0)],
+    9: [(0, 0), (-1, 0), (-2, 0), (-1, 1), (-1, -1), (-2, 1), (-2, -1), (-3, 0), (-3, 1)],
+    10: [
+        (0, 0),
+        (-1, 0),
+        (-2, 0),
+        (-1, 1),
+        (-1, -1),
+        (-2, 1),
+        (-2, -1),
+        (-3, 0),
+        (-3, 1),
+        (-3, -1),
+    ],
+}
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(grid: np.ndarray, bg: int = BLACK) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
