+
+    if np.any(g[r0 : r1 + 1, c0 : c1 + 1] != BLACK):
+        return None
+    return g
+
+
+def _validate_example(inp: np.ndarray, desired_collision: bool) -> bool:
+    if not isinstance(inp, np.ndarray) or inp.ndim != 2 or max(inp.shape) > 30:
+        return False
+
+    try:
+        out, meta = _independent_transform(inp)
