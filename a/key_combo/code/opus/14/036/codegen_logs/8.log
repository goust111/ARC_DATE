+def _pair_candidates(winner_side: str) -> list[tuple[str, str]]:
+    all_pairs = [("top", "left"), ("top", "right"), ("bottom", "left"), ("bottom", "right")]
+    return [pair for pair in all_pairs if winner_side not in pair]
+
+
+def _place_objects(
+    h: int,
+    w: int,
+    gap_bbox: tuple[int, int, int, int],
+    winner_side: str,
