  "trajectory": "paint every pixel along the row or column with the marker color",
  "transform": "draw vertical column bars first, then horizontal row bars so rows overwrite columns at intersections; leave all off-bar pixels as background"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 7-10 rows x 7-10 cols, square [observed], background color 7
  dominoes:
    description: every foreground object is a 4-connected same-color 2-pixel domino
    horizontal: 2-3 dominoes, each marks its row for painting
    vertical: 1-4 dominoes, each marks its column for painting
    total: 4-7 dominoes
    placement: no two dominoes share a pixel; may sit on each other's marked row/col
    colors: each marked row gets one color; each marked col gets one color; same color may label multiple rows or multiple cols, and may appear in both orientations
    unique_colors: 3-5 distinct foreground colors total
  output:
    same_size: true
    rule: start with bg grid; paint each marked column fully with its color; then paint each marked row fully with its color (rows overwrite columns at crossings)

generation_strategy:
  approach: output-first
  steps:
    1. pick grid size N x N, N in 7-10
    2. choose h_count in 2-3 and v_count in 1-4 (total 4-7)
    3. pick h_count distinct rows (avoid row 0 and N-1 [observed]) and v_count distinct columns for bars
    4. assign a non-bg color to each bar; allow color reuse across bars; ensure 3-5 unique foreground colors
    5. build the output by painting columns then rows onto a bg grid
    6. for each bar place a 2-pixel domino marker on the input grid at an arbitrary position along that row/col (H domino: pick any col c where cells (r,c) and (r,c+1) are free; V domino: pick any row r where cells (r,c) and (r+1,c) are free); ensure no domino pixels overlap another domino
    7. fill all remaining input cells with bg color 7
