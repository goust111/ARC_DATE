+            base,
+            np.fliplr(base),
+            np.flipud(base),
+            np.rot90(base, 2),
+        )
+    )
+
+
+def _smallest_period_width(grid: np.ndarray) -> int:
+    g = np.asarray(grid, dtype=int)
+    _, width = g.shape
+    for period in range(1, width + 1):
+        if width % period != 0:
+            continue
+        base = g[:, :period]
+        ok = True
+        for start in range(0, width, period):
