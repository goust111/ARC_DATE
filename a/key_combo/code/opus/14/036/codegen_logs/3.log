+            continue
+        if _smallest_period_width(block) != width:
+            continue
+        return block
+    return None
+
+
+def _build_compressed_grid(block: np.ndarray) -> tuple[np.ndarray, list[str]] | None:
+    width = int(block.shape[1])
+    tile_count = random.randint(3, 4)
+    scenario = random.choice(
