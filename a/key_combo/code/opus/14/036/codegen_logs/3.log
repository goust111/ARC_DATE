+from __future__ import annotations
+
+import hashlib
+import random
+
+import numpy as np
+
+
+BG = 0
+FG_PALETTE = (1, 2, 3, 4)
+MAX_ATTEMPTS = 800
+_SEEN_OUTPUTS: set[str] = set()
+
+
