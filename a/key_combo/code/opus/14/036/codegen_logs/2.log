+    return {
+        "grid": g,
+        "line": line,
+        "step": step,
+        "patterns": patterns,
+        "cell_keys": cell_keys,
+        "counts": counts,
+        "a_key": a_key,
+        "b_key": b_key,
+        "m_key": m_key,
+        "a_count": a_count,
+        "b_count": b_count,
+        "m_count": m_count,
+        "a_pattern": a_pattern,
+        "b_pattern": b_pattern,
