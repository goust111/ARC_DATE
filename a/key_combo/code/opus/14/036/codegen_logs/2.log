+
+def _mask_key(mask: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(x) for x in mask.ravel())
+
+
+ALL_MASKS_2X2 = tuple(
+    np.array(
+        [[(bits >> 0) & 1, (bits >> 1) & 1], [(bits >> 2) & 1, (bits >> 3) & 1]],
+        dtype=bool,
+    )
+    for bits in range(1, 16)
