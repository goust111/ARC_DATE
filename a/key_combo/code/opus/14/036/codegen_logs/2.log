+def _extract_cells(grid: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    n_rows = (grid.shape[0] - 1) // step
+    n_cols = (grid.shape[1] - 1) // step
