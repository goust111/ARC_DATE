+    overlap = info["a_full"] & info["b_full"]
+    a_only = info["a_full"] - info["b_full"]
+    b_only = info["b_full"] - info["a_full"]
+    if not overlap or not a_only or not b_only:
+        return False
+
+    changed_overlap = [
+        pos
+        for pos in overlap
+        if info["cell_keys"][pos[0]][pos[1]] != info["a_key"]
