+    b_mask = random.choice(MASKS_WITH_3_OR_4).copy()
+    majority_choices = [mask for mask in MAJORITY_MASKS if _mask_key(mask) not in {_mask_key(a_mask), _mask_key(b_mask)}]
+    majority_mask = random.choice(majority_choices).copy()
