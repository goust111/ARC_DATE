+def _infer_cell_grid_params(grid: np.ndarray) -> tuple[int, int]:
+    h, w = grid.shape
+    line = int(grid[0, 0])
+    row_divs = [r for r in range(h) if np.all(grid[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(grid[:, c] == line)]
