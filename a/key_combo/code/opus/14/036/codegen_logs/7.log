+def _frame_from_color(grid: np.ndarray, color: int) -> dict:
+    mask = grid == int(color)
+    box = _bbox(mask)
+    assert box is not None
+    r0, c0, r1, c1 = box
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    local_mask = patch == int(color)
+    h, w = local_mask.shape
+    assert h >= 3 and w >= 3
+    assert np.array_equal(local_mask, _border_mask(h, w))
+    return {
+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
