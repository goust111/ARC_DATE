    inp = np.zeros_like(out)
    occupancy = np.zeros_like(out)
    match_locs: list[tuple[int, int]] = []

    try:
        for color in match_colors:
            r, c = _gen_stamp_frame((out, inp), occupancy, template_h, template_w, color, motif)
