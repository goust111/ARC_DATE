+        c0 = 0
+        r1 = h - 1
+        c1 = w - 1
+        boxes = [(r0, c0, r1, c1)]
+        for _layer in range(length - 1):
+            top = random.randint(2, 3)
+            bottom = random.randint(2, 3)
+            left = random.randint(2, 3)
+            right = random.randint(2, 3)
+            r0 -= top
+            c0 -= left
+            r1 += bottom
+            c1 += right
+            boxes.append((r0, c0, r1, c1))
