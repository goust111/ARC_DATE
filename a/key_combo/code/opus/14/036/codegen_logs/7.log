+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+FRAME_COLORS = (BLUE, RED, GREEN, YELLOW, GREY)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
