        for i, (r, c) in enumerate(match_locs):
            if i == source_i:
                continue
            inp[r + 1 : r + template_h - 1, c + 1 : c + template_w - 1] = 0

        shape_pool = [
            (h, w)
            for h in DISTRACTOR_H
            for w in DISTRACTOR_W
            if (h, w) != (template_h, template_w)
