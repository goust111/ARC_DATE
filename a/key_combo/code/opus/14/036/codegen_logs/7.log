+            left_shift = (random.randint(0, 2), 0)
+            right_shift = (random.randint(0, 2), left_w + gap)
+        else:
+            left_shift = (0, random.randint(0, 2))
+            right_shift = (left_h + gap, random.randint(0, 2))
