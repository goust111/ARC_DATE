+        boxes: list[tuple[int, int, int, int]] = []
+        for r0, c0, r1, c1 in left_chain:
+            boxes.append((r0 + left_shift[0], c0 + left_shift[1], r1 + left_shift[0], c1 + left_shift[1]))
