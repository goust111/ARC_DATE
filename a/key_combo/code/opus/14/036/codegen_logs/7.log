+            leaf_a[1] + offset_a[1],
+            leaf_a[2] + offset_a[0],
+            leaf_a[3] + offset_a[1],
+        )
+        placed_leaf_b = (
+            leaf_b[0] + offset_b[0],
+            leaf_b[1] + offset_b[1],
+            leaf_b[2] + offset_b[0],
+            leaf_b[3] + offset_b[1],
+        )
+        placed_mid_b = (
+            mid_b[0] + offset_b[0],
+            mid_b[1] + offset_b[1],
+            mid_b[2] + offset_b[0],
+            mid_b[3] + offset_b[1],
+        )
+
+        min_r = min(placed_leaf_a[0], placed_mid_b[0])
+        min_c = min(placed_leaf_a[1], placed_mid_b[1])
+        max_r = max(placed_leaf_a[2], placed_mid_b[2])
+        max_c = max(placed_leaf_a[3], placed_mid_b[3])
+        outer = (
