+        left_w = max(c1 for _r0, _c0, _r1, c1 in left_chain) + 1
+        right_h = max(r1 for _r0, _c0, r1, _c1 in right_chain) + 1
+        right_w = max(c1 for _r0, _c0, _r1, c1 in right_chain) + 1
+        gap = random.randint(2, 4)
+
