+    for comp in _components(g == BLACK):
+        r, c = map(int, comp[0])
+        region_depth = 0
+        for frame in frames:
+            r0, c0, r1, c1 = frame["bbox"]
+            if r0 < r < r1 and c0 < c < c1:
+                region_depth = max(region_depth, int(frame["depth"]))
+        out[comp[:, 0], comp[:, 1]] = _depth_color(region_depth)
