+    neighbor_fn = _neighbors4 if connectivity == 4 else _neighbors8
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
