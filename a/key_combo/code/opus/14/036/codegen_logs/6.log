+def _cells_to_mask(cells: tuple[Coord, ...]) -> np.ndarray:
+    h = max(r for r, _ in cells) + 1
+    w = max(c for _, c in cells) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
