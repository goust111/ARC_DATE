+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        grid = _sample_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

