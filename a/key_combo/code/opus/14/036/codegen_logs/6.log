+_INPUT_COLS = tuple(range(9, 13))
+_AREA_COMBINATIONS = tuple(itertools.combinations(range(3, 9), 4))
+_FG_COLORS = tuple(range(1, 10))
+_MAX_GENERATION_ATTEMPTS = 600
