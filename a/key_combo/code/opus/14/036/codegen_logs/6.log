+def _compact_enough(groups: list[set[Coord]], shape: tuple[int, int]) -> bool:
+    coords = np.array(sorted(set().union(*groups)), dtype=int)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    bbox_h = r1 - r0 + 1
+    bbox_w = c1 - c0 + 1
+    h, w = shape
+    return bbox_h >= h - 3 and bbox_w >= w - 3
+
