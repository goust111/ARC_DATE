+        ("tl", "tr", "bl", "br"),
+        ("bl", "br", "tl", "tr"),
+        ("br", "bl", "tr", "tl"),
+    ]
+    for order in tested_orders:
+        if np.array_equal(_overlay_in_order(transformed, order), out):
+            return False
+
+    for pos in POSITIONS:
+        color = int(np.max(transformed[pos]))
+        if color == BLACK or int(np.count_nonzero(out == color)) == 0:
+            return False
+    return True
+
