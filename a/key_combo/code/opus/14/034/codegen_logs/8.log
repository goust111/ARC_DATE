+        solved = main(grid)
+        if not np.array_equal(solved, oracle):
+            return False
+        for slot_idx in visit_order:
+            c0, c1 = slots[slot_idx]
+            band = solved[band_r0 : band_r1 + 1, c0:c1]
+            if not np.isin(band, [BLUE, RED, BLACK, GREEN, MAROON]).all():
+                return False
+        return True
+    except Exception:
+        return False
+
