+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+MAROON = 9
+
+SLOT_COUNT = 6
+SLOT_W = 4
+SLOT_H = 6
+GRID_H = SLOT_H + 2
