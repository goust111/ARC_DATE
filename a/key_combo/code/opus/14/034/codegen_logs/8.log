+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+MAROON = 9
+
+SLOT_COUNT = 6
+SLOT_W = 4
+SLOT_H = 6
+GRID_H = SLOT_H + 2
+DIVIDER_W = 1
+MAX_GEN_ATTEMPTS = 400
