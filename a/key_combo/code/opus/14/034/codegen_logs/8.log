+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        candidate = _generate_candidate()
+        if candidate is not None:
+            return candidate
+    raise RuntimeError("failed to generate a valid puzzle instance")

