+        if found_slot != template_slot:
+            return False
+        if len({_rotate_cw_times(template_crop, k).tobytes() for k in range(4)}) != 4:
+            return False
+        recovered = _simulate_path(grid, band_r0, band_r1, slots, template_slot)
+        if recovered != visit_order:
