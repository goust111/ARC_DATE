+    if not cells:
+        return False
+    seen = {cells[0]}
+    stack = [cells[0]]
+    all_cells = set(cells)
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in all_cells and (nr, nc) not in seen:
