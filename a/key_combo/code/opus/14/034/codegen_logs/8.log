+    return slot_idx * (SLOT_W + DIVIDER_W)
+
+
+def _base_grid() -> np.ndarray:
+    grid = np.full((GRID_H, SLOT_COUNT * SLOT_W + (SLOT_COUNT - 1) * DIVIDER_W), BLACK, dtype=int)
