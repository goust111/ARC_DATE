+        return False
+    start = next(iter(cells))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nb in neighbors4(r, c):
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return len(seen) == len(cells)
