+
+
+def simulate_cascade(shapes: list[dict], seed_id: int, bridges: list[dict]) -> tuple[set[int], dict[tuple[int, int], int]]:
+    completed: set[int] = set()
+    pending: set[int] = {seed_id}
+    activated_bridges: dict[tuple[int, int], int] = {}
