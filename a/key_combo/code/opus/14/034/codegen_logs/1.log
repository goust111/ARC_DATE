+                "r0": r0,
+                "c0": c0,
+                "side": side,
+                "color": color,
+                "visible": visible,
+                "full": full,
+                "has_seed": has_seed,
+            }
+        )
+        if has_seed:
+            seed_id = len(shapes) - 1
