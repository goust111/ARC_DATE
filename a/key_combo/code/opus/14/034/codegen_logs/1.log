+from __future__ import annotations
+
+from collections import deque
+import itertools
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+SHAPE_COLORS = (1, 5, 6, 7, 8, 9)
+SIDES = ("N", "E", "S", "W")
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
+
+def rotate_orbit(side: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    last = side - 1
+    return (
+        (r, c),
+        (c, last - r),
+        (last - r, last - c),
+        (last - c, r),
+    )
+
+
+def orbit_by_side(side: int, rep: tuple[int, int]) -> dict[str, tuple[int, int]]:
+    pts = rotate_orbit(side, rep[0], rep[1])
+    return dict(zip(SIDES, pts))
+
+
+def is_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nb in neighbors4(r, c):
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return len(seen) == len(cells)
+
+
+def complete_visible_shape(r0: int, c0: int, side: int, visible: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    full: set[tuple[int, int]] = set()
