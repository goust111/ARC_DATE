+        visible = {(r0 + r, c0 + c) for r, c in local_visible}
+        full = complete_visible_shape(r0, c0, side, visible)
+        shapes_meta.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "side": side,
+                "color": color,
+                "visible": visible,
+                "full": full,
+            }
+        )
