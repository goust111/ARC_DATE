+                            continue
+                        rs = [r for r, _ in visible]
+                        cs = [c for _, c in visible]
+                        if min(rs) != 0 or max(rs) != side - 1 or min(cs) != 0 or max(cs) != side - 1:
+                            continue
+                        candidates.append(visible)
