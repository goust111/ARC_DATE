+    inp = np.full((h, w), BACKGROUND, dtype=int)
+
+    for bridge in bridges_meta:
+        br, bc = bridge["coord"]
+        inp[br, bc] = GREEN
+
+    for shape in shapes_meta:
+        paint_cells(inp, shape["visible"], shape["color"])
