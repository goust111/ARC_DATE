+        np.fliplr,
+        np.flipud,
+        lambda g: np.flipud(np.fliplr(g)),
+        np.transpose,
+        lambda g: np.fliplr(np.transpose(g)),
+        lambda g: np.flipud(np.transpose(g)),
+        lambda g: np.flipud(np.fliplr(np.transpose(g))),
