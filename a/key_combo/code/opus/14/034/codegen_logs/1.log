+
+def choose_visible_local(side: int, hidden_sides: set[str]) -> set[tuple[int, int]]:
+    spec = full_local_shape(side)
+    core = {spec["center"]}
+    core.update(spec["inner"].values())
+    core.update(spec["diag"].values())
