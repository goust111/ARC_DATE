+        "inner": orbit_by_side(side, (mid - 1, mid)),
+        "diag": orbit_by_side(side, (mid - 1, mid - 1)),
+        "side": orbit_by_side(side, (0, mid)),
+        "edge": orbit_by_side(side, (0, mid - 1)),
+    }
