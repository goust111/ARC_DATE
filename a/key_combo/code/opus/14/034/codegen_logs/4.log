+    slots = list(range(2, height - 3, 3))
+    assert len(slots) >= count
+    shift = (2 * c0 + count + group_index) % len(slots)
+    rotated = slots[shift:] + slots[:shift]
+    rows = sorted(rotated[:count])
+    return [int(r) for r in rows]
