+
+def _settle_sprites(sprites: list[dict], shape: tuple[int, int]) -> list[dict]:
+    h, w = shape
+    occupied = np.zeros((h, w), dtype=bool)
+    occupied[h - 1, :] = True
+    settled: list[dict] = []
