+        top = int(sprite["r0"])
+        c0 = int(sprite["c0"])
+        while not occupied[top + 2, c0] and not occupied[top + 2, c0 + 1]:
+            top += 1
+        occupied[top : top + 2, c0 : c0 + 2] = True
