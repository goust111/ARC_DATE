+
+def _right(dr: int, dc: int) -> tuple[int, int]:
+    return int(dc), -int(dr)
+
+
+def _bfs_component(mask: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    stack = [start]
+    seen = {start}
