+
+
+def _stamp_sets_for_validation(
+    turns: list[tuple[int, int]],
+    patch: np.ndarray,
+    anchor: tuple[int, int],
+) -> list[set[tuple[int, int]]]:
+    return [_stamp_cells(patch, anchor, turn) for turn in turns]
+
+
+def _validate_instance(grid: np.ndarray) -> None:
