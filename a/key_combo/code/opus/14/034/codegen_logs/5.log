+
+def _boundary_body_locals(mask: np.ndarray, side: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int]] = []
+    for r, c in _mask_cells(mask):
+        nr = r + side[0]
+        nc = c + side[1]
+        if not _in_bounds((h, w), nr, nc) or not mask[nr, nc]:
+            out.append((r, c))
+    return out
+
