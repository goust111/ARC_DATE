+        base = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            var = np.rot90(base, k)
+            key = var.astype(np.uint8).tobytes() + bytes(var.shape)
+            if key not in seen:
+                seen.add(key)
+                variants.append(var.copy())
+    return variants
