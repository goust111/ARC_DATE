+        else:
+            assert port_counts[bid] >= 1, "each blob must have at least one port"
+        blob["ports"].sort(key=lambda port: port["cell"])
+
+    orange_pts = [tuple(map(int, pt)) for pt in np.argwhere(g == ORANGE)]
+    if enforce_input_constraints:
