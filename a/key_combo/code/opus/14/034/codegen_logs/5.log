+    else:
+        if len(b_blob["ports"]) == 1:
+            blocked = _try_add_dead_port(rng, grid, blocked, b_blob)
+        if len(b_blob["ports"]) == 1 and rng.random() < 0.45:
+            blocked = _try_add_dead_port(rng, grid, blocked, b_blob)
