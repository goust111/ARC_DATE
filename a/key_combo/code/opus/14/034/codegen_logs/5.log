+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _centroid(cells: list[tuple[int, int]]) -> tuple[float, float]:
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    return float(sum(rs) / len(rs)), float(sum(cs) / len(cs))
+
+
+def _infer_direction_from_centroid(body_cells: list[tuple[int, int]], port: tuple[int, int]) -> tuple[int, int] | None:
+    cr, cc = _centroid(body_cells)
+    pr, pc = port
+    dr = pr - cr
+    dc = pc - cc
+    if abs(dr) >= abs(dc) and pr < cr:
+        return UP
+    if abs(dc) >= abs(dr) and pc > cc:
+        return RIGHT
+    if abs(dr) >= abs(dc) and pr > cr:
+        return DOWN
+    if abs(dc) >= abs(dr) and pc < cc:
+        return LEFT
+    return None
