 108: def neighbors4(r: int, c: int) -> Iterator[Coord]:
 109:     """4-neighborhood of (r,c)."""
 110:     r = int(r)
 111:     c = int(c)
 112:     yield r - 1, c
 113:     yield r + 1, c
 114:     yield r, c - 1
 115:     yield r, c + 1
