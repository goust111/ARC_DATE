+    if abs(dc) >= abs(dr) and pc > cc:
+        return RIGHT
+    if abs(dr) >= abs(dc) and pr > cr:
+        return DOWN
+    if abs(dc) >= abs(dr) and pc < cc:
+        return LEFT
+    return None
