+            stop_reason = "blocked"
+            break
+
+        traces.append(
+            {
+                "label": label,
+                "start": start,
+                "initial_dir": direction,
+                "final_dir": dir_now,
+                "painted": painted,
+                "turns": turns,
+                "hit_blob": hit_blob,
+                "stop_reason": stop_reason,
+            }
+        )
