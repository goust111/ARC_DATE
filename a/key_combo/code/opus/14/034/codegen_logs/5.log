+
+    return {
+        "grid": g,
+        "shape": g.shape,
+        "seed": (yr - 1, yc),
+        "yellow": (yr, yc),
+        "blobs": blobs,
+        "blob_at": blob_at,
+        "orange": orange_pts,
+    }
+
+
+def _simulate(
+    grid: np.ndarray,
+    *,
+    treat_obstacles_as_black: bool = False,
+    initial_only: bool = False,
+    strict_input: bool = False,
