+
+
+def _place_blob(
+    rng: random.Random,
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    hit: tuple[int, int] | None = None,
+    ray_dir: tuple[int, int] | None = None,
+    required_port_sides: list[tuple[int, int]] | None = None,
