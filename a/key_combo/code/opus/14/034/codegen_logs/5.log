+            if out[nr, nc] == RED or g[nr, nc] in (GREEN, YELLOW):
+                stop_reason = "red_or_green"
+                break
+
+            if g[nr, nc] == ORANGE and not treat_obstacles_as_black:
+                turns += 1
+                dir_now = CW[dir_now]
+                stop_reason = "turned"
+                continue
+
+            bid = int(blob_at[nr, nc])
+            if bid != -1:
+                activate(bid)
+                hit_blob = bid
+                stop_reason = "blob"
+                break
+
+            if g[nr, nc] in (BLACK, ORANGE):
+                out[nr, nc] = RED
+                painted.append((nr, nc))
+                current = (nr, nc)
+                stop_reason = "advance"
+                continue
