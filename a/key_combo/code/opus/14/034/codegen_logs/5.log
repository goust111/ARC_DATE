+    # At least one activated ray beyond the seed must exist.
+    if len(full["traces"]) < 2:
+        return False
+
+    # All activated blobs must have had at least one port in the input.
+    if any(len(blob["ports"]) < 1 for blob in parsed["blobs"]):
