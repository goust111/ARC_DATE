+    g = parsed["grid"]
+    out = g.copy()
+    blobs = parsed["blobs"]
+    blob_at = parsed["blob_at"]
+
+    activated: set[int] = set()
+    queue: deque[int] = deque()
+    activation_order: list[int] = []
+    traces: list[dict] = []
+
+    def activate(bid: int) -> None:
+        if bid in activated:
+            return
+        activated.add(bid)
+        activation_order.append(bid)
+        for r, c in blobs[bid]["cells"]:
+            out[r, c] = RED
+        if not initial_only:
