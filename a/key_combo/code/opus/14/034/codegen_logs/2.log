+    for r, c in np.argwhere(grid == GREY):
+        colors = _visible_colors(grid, _translation_positions(int(r), int(c), side))
+        assert len(colors) <= 1, f"translation conflict at {(int(r), int(c))}: {colors}"
+        if colors:
