+
+def _translated_cells(cells: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
+    return {(r + dr, c + dc) for r, c in cells}
+
+
+def _cells_with_padding(cells: set[tuple[int, int]], pad: int) -> set[tuple[int, int]]:
