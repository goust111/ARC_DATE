+        tr0, tc0 = sprite["top"]
+        if not (tr0 + rr0 <= sr[0] <= tr0 + rr1 and tc0 + rc0 <= sr[1] <= tc0 + rc1):
+            return False
+        rect_center = ((tr0 + rr0 + tr0 + rr1) // 2, (tc0 + rc0 + tc0 + rc1) // 2)
+        bbox_center = (
+            tr0 + sprite["shape"][0] // 2,
+            tc0 + sprite["shape"][1] // 2,
