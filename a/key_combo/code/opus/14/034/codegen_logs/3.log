+    return True
+
+
+def _place_originals(h: int, w: int, templates: list[dict], mode: str) -> list[dict] | None:
+    source_limit = w // 2 - 2 if mode == "horizontal" else h // 2 - 2
+    occupied: set[tuple[int, int]] = set()
