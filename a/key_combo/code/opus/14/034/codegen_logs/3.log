+            target = (r0 + ar, c0 + ac)
+            if not _can_place(copy_cells, output_occupied, h, w, pad=1):
+                continue
+            if not (1 <= target[0] < h - 1 and 1 <= target[1] < w - 1):
+                continue
+            if target in copy_cells or target in targets:
