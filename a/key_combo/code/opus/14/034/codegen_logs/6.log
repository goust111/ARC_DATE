+
+def _dihedral_variants(shape: tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
+    mask = _shape_mask(shape)
+    out = []
+    seen = set()
+    for k in range(4):
+        rotated = np.rot90(mask, k)
+        for arr in (rotated, np.fliplr(rotated)):
+            key = _normalize_shape(np.argwhere(arr))
+            if key not in seen:
+                seen.add(key)
+                out.append(key)
