+
+def _is_connected(coords) -> bool:
+    cells = {tuple(map(int, p)) for p in coords}
+    start = next(iter(cells))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS4:
+            nb = (r + dr, c + dc)
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                stack.append(nb)
+    return seen == cells
