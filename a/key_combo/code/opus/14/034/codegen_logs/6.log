+    assert grey_coords.size > 0, "expected a grey lattice on the left"
+    r0 = int(grey_coords[:, 0].min())
+    c0 = int(grey_coords[:, 1].min())
+    r1 = int(grey_coords[:, 0].max())
+    c1 = int(grey_coords[:, 1].max())
