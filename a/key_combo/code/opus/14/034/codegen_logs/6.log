            assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique majority marker color"

            out[rr, cc] = int(ranked[0][0])
            filled_regions += 1

    assert filled_regions > 0, "expected at least one enclosed region to fill"
