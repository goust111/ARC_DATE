+        rotated = np.rot90(mask, k)
+        for arr in (rotated, np.fliplr(rotated)):
+            key = _normalize_shape(np.argwhere(arr))
+            if key not in seen:
+                seen.add(key)
+                out.append(key)
+    return out
+
+
+def _is_connected(coords) -> bool:
+    cells = {tuple(map(int, p)) for p in coords}
