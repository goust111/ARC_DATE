+    comps: list[np.ndarray] = []
+    nbrs = _neighbors(connectivity)
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in nbrs:
+                    nr = rr + dr
+                    nc = cc + dc
