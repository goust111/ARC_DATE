+def _frame_base_color(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> int:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    border = []
+    border.extend(map(int, grid[fr0, fc0 : fc1 + 1]))
