+    return cases
+
+
+VALID_CASES = _build_valid_case_pool()
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Expand the black-cell mask by a Kronecker self-product, then stamp only the expanded convex corners.
