+                continue
+            if any(int(grid[nr, nc]) == BACKGROUND for nr, nc in _neighbors4(r, c)):
+                count += 1
+    return count
+
+
+def _stamp_all_boundary_pixels(grid: np.ndarray, fg: int) -> np.ndarray:
+    h, w = grid.shape
+    out = np.asarray(grid, dtype=int).copy()
+    for r in range(1, h - 1):
