+        r1 = min(h, r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(w, c + 2)
+        patch = out[r0:r1, c0:c1]
+        patch[patch == BACKGROUND] = fg
+    return out
+
+
+def _boundary_pixel_count(grid: np.ndarray, fg: int) -> int:
+    h, w = grid.shape
+    count = 0
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
