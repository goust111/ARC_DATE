+def _foreground_color(grid: np.ndarray) -> int:
+    colors = sorted(int(v) for v in np.unique(grid) if int(v) != BACKGROUND)
+    assert len(colors) == 1, "expected exactly one foreground color"
+    return colors[0]
+
