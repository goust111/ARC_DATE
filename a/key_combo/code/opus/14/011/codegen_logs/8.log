+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+TARGET = 8
+NON_TARGET_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+SIDES = ("top", "bottom", "left", "right")
+MOVE_TO_TARGET = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
