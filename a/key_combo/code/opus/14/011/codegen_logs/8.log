+SPRITE_COUNT_RANGE = (2, 4)
+INPUT_GAP_RANGE = (2, 6)
+GEN_RETRIES = 500
+
+
+SHAPE_LIBRARY = [
+    {
+        "cells": [(0, 0), (0, 1), (0, 2)],
+        "inner": [(0, 1)],
+    },
+    {
+        "cells": [(0, 0), (1, 0), (1, 1)],
+        "inner": [(1, 0)],
