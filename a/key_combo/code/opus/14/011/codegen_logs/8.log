+    occupied: set[tuple[int, int]] = set()
+    bands: dict[int, set[tuple[int, int]]] = {}
+
+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        item = items[idx]
+        gaps = list(range(INPUT_GAP_RANGE[0], item["max_gap"] + 1))
+        random.shuffle(gaps)
+        for gap in gaps:
+            inp_cells = _input_cells_for_gap(item["landed"], item["side"], gap)
