+    if mode == "rowcol":
+        return sorted(objects, key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
+    if mode == "reverse_colrow":
+        return sorted(objects, key=lambda obj: (obj["bbox"][1], obj["bbox"][0]), reverse=True)
