+def _make_shape(area: int, height: int, width: int) -> np.ndarray | None:
+    all_cells = [(r, c) for r in range(height) for c in range(width)]
+    for _ in range(120):
+        start = random.choice(all_cells)
+        cells = {start}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
