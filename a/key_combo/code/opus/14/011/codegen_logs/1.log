+
+_PALETTE = tuple(range(1, 10))
+_GRID_H_RANGE = (14, 19)
+_GRID_W_RANGE = (15, 20)
+_OBJECT_COUNT_RANGE = (3, 5)
+_MAX_ATTEMPTS = 600
+
+
+def _normalize(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    r0 = min(r for r, _c in cells)
+    c0 = min(c for _r, c in cells)
+    return {(r - r0, c - c0) for r, c in cells}
