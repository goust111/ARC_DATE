+    occupied = np.zeros((height, width), dtype=bool)
+    placements: list[tuple[int, int]] = [(-1, -1)] * count
+    overlap_pair = None
+    want_overlap = random.random() < 0.7 and count >= 2
+    want_same_col = random.random() < 0.55 and count >= 2
