+def _extract_objects(
+    grid: np.ndarray, legend_map: dict[int, int], legend_cells: set[tuple[int, int]]
+) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    objects: list[dict[str, object]] = []
