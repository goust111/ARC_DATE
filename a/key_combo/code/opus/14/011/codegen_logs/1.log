+            continue
+        for _ in range(160):
+            if want_edge_touch and idx == count - 1 and random.random() < 0.7:
+                r0 = random.choice([0, height - patch.shape[0]])
+                c0 = random.randint(4, width - patch.shape[1])
+            else:
+                r0 = random.randint(0, height - patch.shape[0])
+                c0 = random.randint(4, width - patch.shape[1])
