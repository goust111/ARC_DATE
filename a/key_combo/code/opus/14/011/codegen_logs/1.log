+def _render_halos(
+    grid: np.ndarray,
+    legend_map: dict[int, int],
+    legend_mask: np.ndarray,
+    objects: list[dict[str, object]],
+    *,
+    order_mode: str = "colrow",
+    neighbor_mode: str = "cyclic_right",
+    paint_mode: str = "forward",
