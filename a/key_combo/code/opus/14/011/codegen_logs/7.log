+    def backtrack(k: int) -> bool:
+        if k == len(order):
+            return True
+        idx = order[k]
+        h, w = sizes[idx]
+        rows = list(range(2, CANVAS_SIZE - h))
+        cols = list(range(0, CANVAS_SIZE - w + 1))
+        random.shuffle(rows)
+        random.shuffle(cols)
