+
+
+def _two_hole_exemplar() -> np.ndarray:
+    a, c = random.sample(INNER_COLORS, 2)
+    patch = np.array(
+        [
+            [ORANGE, ORANGE, ORANGE, ORANGE, ORANGE, ORANGE],
+            [ORANGE, a, a, a, a, ORANGE],
+            [ORANGE, a, BACKGROUND, c, BACKGROUND, ORANGE],
+            [ORANGE, a, c, a, a, ORANGE],
+            [ORANGE, a, a, a, a, ORANGE],
+            [ORANGE, ORANGE, ORANGE, ORANGE, ORANGE, ORANGE],
+        ],
+        dtype=int,
