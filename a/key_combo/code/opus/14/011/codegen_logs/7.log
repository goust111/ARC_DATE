+        [
+            [ORANGE, ORANGE, ORANGE, ORANGE, ORANGE],
+            [ORANGE, a, a, a, ORANGE],
+            [ORANGE, a, BACKGROUND, b, ORANGE],
+            [ORANGE, a, c, a, ORANGE],
+            [ORANGE, ORANGE, ORANGE, ORANGE, ORANGE],
+        ],
+        dtype=int,
+    )
