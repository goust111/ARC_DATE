+                box = (r0, c0, r0 + h - 1, c0 + w - 1)
+                if box[2] >= CANVAS_SIZE or box[3] >= CANVAS_SIZE:
+                    continue
+                if any(
+                    other is not None and _boxes_overlap(_expanded_box(box), _expanded_box(other))
+                    for other in boxes
