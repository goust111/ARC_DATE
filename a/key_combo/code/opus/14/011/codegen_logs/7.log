+
+def _crop_canvas(inp: np.ndarray, out: np.ndarray) -> tuple[np.ndarray, np.ndarray, int]:
+    coords = np.argwhere(inp != BACKGROUND)
+    r0 = 0
+    c0 = max(0, int(coords[:, 1].min()) - random.randint(0, 2))
