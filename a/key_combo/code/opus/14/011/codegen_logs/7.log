+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+CONTROL_COLORS = (BLUE, RED, YELLOW)
+INNER_COLORS = (GREEN, PINK, TEAL, MAROON)
+GEN_MAX_ATTEMPTS = 500
+CANVAS_SIZE = 30
