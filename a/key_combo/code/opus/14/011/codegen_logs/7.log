+        colors = sorted(set(map(int, np.unique(patch))) - {bg})
+        assert len(colors) >= 2 and ORANGE in colors, "exemplar must be multicolor and include orange"
+        exemplar_candidates.append(box)
+        exemplar_patch = patch
