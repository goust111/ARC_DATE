+    out = g.copy()
+    for r in range(H):
+        left = int(g[r, 0])
+        right = int(g[r, W - 1])
+        if left != right:
+            continue
+        for c in range(1, W - 1):
+            cell = int(g[r, c])
+            if cell == OBSTACLE:
