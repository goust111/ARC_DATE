+                return False
+        if int(out[r, 0]) != left or int(out[r, W - 1]) != right:
+            return False
+
+    alt = g.copy()
+    mismatch_row = mismatch[0]
+    alt[mismatch_row, -1] = alt[mismatch_row, 0]
+    if np.array_equal(main(alt), out):
