spec:
  grid: 10x10 [observed], background 0
  markers:
    placement: every odd row (1,3,5,7 and optionally 9) has exactly two foreground pixels at columns 0 and W-1; even rows are entirely background
    count: 4-5 marked rows [observed]
    colors: each marker is a non-zero color (1-9); 4-5 distinct foreground colors total [observed]
    match_vs_mismatch: 0-2 rows have left==right (matching pair); rest have left!=right
    no_color_reuse_on_same_row_pair: left and right on a mismatch row are always different colors
  transform:
