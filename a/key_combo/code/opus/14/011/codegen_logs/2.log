+    if profile == "early":
+        low = 2
+        high = min(width - 4, max(2, width // 2))
+    elif profile == "late":
+        low = max(3, width // 2)
+        high = width - 4
+    else:
+        low = 2
+        high = width - 4
+    if low > high:
+        low = high = width - 4
+    first = random.randint(low, high)
+    positions = [first]
+    can_add_second = first + 2 <= width - 2
+    if can_add_second and random.random() < 0.4:
+        positions.append(random.randint(first + 2, width - 2))
