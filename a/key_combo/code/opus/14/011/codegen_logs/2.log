    return all(0 <= r < GRID_SIZE and 0 <= c < GRID_SIZE for r, c in cells)


def _cells_are_bg(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
    return all(int(grid[r, c]) == BG for r, c in cells)


