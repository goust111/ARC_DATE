+    bridge_color = rng.choice(MARKER_COLORS)
+    gap1 = rng.randint(1, 4)
+    gap2 = rng.randint(1, 4)
+    c_a = rng.randint(0, 2)
+    c_b = c_a + 6 + gap1
+    c_c = c_b + 6 + gap2
+
+    min_w = c_c + 2
