+    if (col1 - col0 + 1) < 1:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        rng = random.Random()
+        grid = _construct_case(rng)
+        if _validate_case(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 4")

