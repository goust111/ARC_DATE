+        right = min(2, w - c1 - 1)
+
+        specs = [
+            (int(marker[0, 0]), r1 + 1, r1 + down, c1 + 1, c1 + right, "br"),
+            (int(marker[0, 1]), r1 + 1, r1 + down, c0 - left, c0 - 1, "bl"),
+            (int(marker[1, 0]), r0 - up, r0 - 1, c1 + 1, c1 + right, "tr"),
+            (int(marker[1, 1]), r0 - up, r0 - 1, c0 - left, c0 - 1, "tl"),
+        ]
