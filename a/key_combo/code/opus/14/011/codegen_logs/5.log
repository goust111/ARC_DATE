+
+BG = 5
+FG = 3
+MARKER_COLORS = (1, 2, 4)
+DIRS4 = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+PHASE_OFFSETS = (
