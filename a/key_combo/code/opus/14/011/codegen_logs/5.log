+                continue
+            cells = ((r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1))
+            idx = len(candidates)
+            candidates.append(cells)
+            for cell in cells:
+                cell_to_candidates[cell].append(idx)
+
+    if any(cell not in cell_to_candidates for cell in fg_set):
+        return 0, None
+
+    covered = set()
+    partial = []
+    solution = None
+    count = 0
+
+    def dfs():
+        nonlocal solution, count
+        if count >= limit:
+            return
+        if len(covered) == len(fg_set):
+            count += 1
+            if count == 1:
