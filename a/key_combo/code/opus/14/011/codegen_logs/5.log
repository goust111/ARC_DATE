+def _component_count(mask: np.ndarray) -> int:
+    points = [tuple(coord) for coord in np.argwhere(mask)]
+    if not points:
+        return 0
+    unseen = set(points)
+    count = 0
+    while unseen:
+        count += 1
+        start = unseen.pop()
+        queue = deque([start])
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in unseen:
+                    unseen.remove((nr, nc))
+                    queue.append((nr, nc))
+    return count
