+    elif red_side == "bottom":
+        patch[r0 + h, c0 : c0 + w] = RED
+    elif red_side == "left":
+        patch[r0 : r0 + h, c0 - 1] = RED
+    else:
+        patch[r0 : r0 + h, c0 + w] = RED
+
+    if blue_side == "top":
