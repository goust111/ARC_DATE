+        (BLUE, "left", c0 > 0 and np.all(grid[r0 : r1 + 1, c0 - 1] == BLUE)),
+        (BLUE, "right", c1 + 1 < w and np.all(grid[r0 : r1 + 1, c1 + 1] == BLUE)),
