                transparent=BACKGROUND,
                border=PLACEMENT_BORDER,
                padding=PLACEMENT_PADDING,
            )
            paste(out, out_patch, r, c)
            paste(inp, in_patch, r, c)
    except ValueError:
        return None
    return inp, out


