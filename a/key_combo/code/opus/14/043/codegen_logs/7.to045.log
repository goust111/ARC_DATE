+            continue
+        if not (6 <= len(cells) <= 15):
+            continue
+
+        norm = {(r, c - int(cols.min())) for r, c in cells}
+        mask_h = int(rows.max()) + 1
+        mask_w = int(max(c for _r, c in norm)) + 1
