+    candidates: list[tuple[int, list[int]]] = []
+    for k in STRIPE_PERIODS:
+        residues = {int(r % k) for r in visible_rows}
+        if len(residues) != 1:
+            continue
+        residue = next(iter(residues))
+        stripe_rows = list(range(residue, h, k))
+        if any(np.any(g[r] == RED) for r in stripe_rows):
