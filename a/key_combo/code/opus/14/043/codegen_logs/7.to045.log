+def _generate_once() -> np.ndarray | None:
+    k = random.choice(STRIPE_PERIODS)
+    max_stripes = min(6, (30 + 1) // k - 1)
+    num_stripes = random.randint(4, max_stripes)
+    counts = random.choice(_count_profiles(k))[:]
+    random.shuffle(counts)
