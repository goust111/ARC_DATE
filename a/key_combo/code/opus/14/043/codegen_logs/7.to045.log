+        [3, 3, 4, 5],
+        [3, 4, 4, 5],
+        [3, 3, 4, 4, 5],
+        [3, 3, 4, 5, 5],
+        [3, 4, 4, 5, 5],
+    ]
+
+
+def _build_object_patch(k: int, fragments: int) -> set[tuple[int, int]] | None:
+    islands_needed = fragments - 3
+    max_base_size = 15 - 3 * islands_needed
