+
+    cut_mask = (g == GREEN).copy()
+    cut_mask[stripe_rows, :] = False
+    fragments = _components(cut_mask)
+
+    grouped: dict[int, list[np.ndarray]] = {idx: [] for idx in range(len(objects))}
+    for frag in fragments:
