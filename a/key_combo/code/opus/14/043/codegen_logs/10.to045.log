+def _compare_halves(top: np.ndarray, bottom: np.ndarray) -> np.ndarray:
+    out = np.zeros(top.shape, dtype=int)
+    top_fg = top != BG
+    bottom_fg = bottom != BG
+    out[top_fg & bottom_fg] = WALL
+    out[top_fg & ~bottom_fg] = GREEN
+    out[~top_fg & bottom_fg] = ORANGE
+    return out
+
