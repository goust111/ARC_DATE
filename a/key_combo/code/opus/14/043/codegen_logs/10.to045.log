+    return None
+
+
+def _place_loops(n: int) -> list[dict] | None:
+    loop_count = 3 if random.random() < 0.55 else 2
+    roles = ["green", "orange"]
+    if loop_count == 3:
+        roles.append(random.choices(["empty", "green", "orange"], weights=[6, 2, 2], k=1)[0])
