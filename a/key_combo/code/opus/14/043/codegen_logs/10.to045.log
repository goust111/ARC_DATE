    h, w = labels.shape
    choices = []
    for r in range(h):
        for c in range(w):
            if labels[r, c] != 0:
                continue
            touches_label = False
            touches_other = False
            for nr, nc in _gen_neighbors4(r, c, h, w):
                neighbor = int(labels[nr, nc])
                if neighbor == label:
