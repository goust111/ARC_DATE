+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+WALL = 5
+ORANGE = 7
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+COLORED_LOOP_SIZES = ((3, 4), (4, 3), (4, 4))
+EMPTY_LOOP_SIZES = ((3, 3), (3, 4), (4, 3))
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for sr in range(h):
+        for sc in range(w):
+            if not mask[sr, sc] or seen[sr, sc]:
+                continue
+            queue = deque([(sr, sc)])
+            seen[sr, sc] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = r + dr, c + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _ring_cells(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells = set()
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    return cells
+
+
+def _interior_cells(box: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+
+
+def _expanded_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + pad < br0 - pad
+        or br1 + pad < ar0 - pad
+        or ac1 + pad < bc0 - pad
+        or bc1 + pad < ac0 - pad
+    )
+
+
+def _adjacent_mask(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        out[rr, cc] = True
+        for dr, dc in NEIGHBORS4:
+            nr, nc = rr + dr, cc + dc
+            if _in_bounds(mask.shape, nr, nc):
+                out[nr, nc] = True
+    return out
+
+
+def _polyomino(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:
+    candidates = [tuple(map(int, rc)) for rc in np.argwhere(allowed)]
+    random.shuffle(candidates)
+    for seed in candidates[:80]:
+        cells = {seed}
+        while len(cells) < size:
+            frontier: list[tuple[int, int]] = []
+            for r, c in cells:
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = r + dr, c + dc
+                    if _in_bounds(allowed.shape, nr, nc) and allowed[nr, nc] and (nr, nc) not in cells:
+                        frontier.extend([(nr, nc)] * (1 + sum((nr + er, nc + ec) in cells for er, ec in NEIGHBORS4)))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) == size:
+            return cells
+    return None
+
+
+def _multisource_path(
+    shape: tuple[int, int],
+    starts: set[tuple[int, int]],
+    targets: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    queue = deque()
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {}
+    for cell in starts:
+        queue.append(cell)
+        prev[cell] = None
+    while queue:
+        cell = queue.popleft()
+        if cell in targets:
+            path = [cell]
+            while prev[path[-1]] is not None:
+                path.append(prev[path[-1]])
+            path.reverse()
+            return path
+        r, c = cell
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if nxt in prev or nxt in blocked or not _in_bounds(shape, nr, nc):
+                continue
+            prev[nxt] = cell
+            queue.append(nxt)
+    return None
+
