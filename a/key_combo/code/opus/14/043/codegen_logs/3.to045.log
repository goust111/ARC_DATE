+
+
+def _interior_from_loop(loop_mask: np.ndarray) -> np.ndarray:
+    h, w = loop_mask.shape
+    blocked = np.pad(loop_mask, 1, constant_values=False)
+    outside = np.zeros_like(blocked, dtype=bool)
