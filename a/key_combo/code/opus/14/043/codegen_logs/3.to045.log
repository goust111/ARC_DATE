+    path.extend(_chain_from_vertices(bottom_vertices)[1:])
+    path.extend(_chain_from_vertices(left_vertices)[1:])
+    if path[-1] != path[0]:
+        return None
+    path = path[:-1]
+    if len(set(path)) != len(path):
+        return None
