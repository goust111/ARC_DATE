+
+
+def _random_loop(h: int, w: int, sprite_shape: tuple[int, int], rng: np.random.Generator) -> np.ndarray | None:
+    sh, sw = sprite_shape
+    outer_h_min = max(10, sh + 6)
+    outer_w_min = max(10, sw + 6)
