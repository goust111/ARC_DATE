+        dirs = [(nr - r, nc - c) for nr, nc in neighbors[(r, c)]]
+        total_dr = dirs[0][0] + dirs[1][0]
+        total_dc = dirs[0][1] + dirs[1][1]
+        outward = (-1 if total_dr > 0 else 1, -1 if total_dc > 0 else 1)
+        bends.append(
+            {
+                "coord": (r, c),
+                "sign": sign,
+                "is_convex": sign == convex_sign,
+                "outward": outward,
