+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        for dr, dc in DIR8:
+            nr, nc = int(r + dr), int(c + dc)
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
