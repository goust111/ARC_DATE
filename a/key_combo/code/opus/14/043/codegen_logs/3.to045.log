+    neighbors: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in cells:
+        nbs = [(nr, nc) for nr, nc in neighbors4(r, c) if (nr, nc) in cells]
+        assert len(nbs) == 2, "loop pixels must have degree 2"
+        neighbors[(r, c)] = nbs
+    return neighbors
+
