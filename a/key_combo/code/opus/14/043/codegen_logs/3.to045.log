+def _trace_cycle(loop_mask: np.ndarray) -> list[tuple[int, int]]:
+    neighbors = _loop_neighbors(loop_mask)
+    start = min(neighbors)
+    path = [start]
+    prev = None
+    cur = start
+    while True:
+        nbs = neighbors[cur]
+        if prev is None:
+            nxt = min(nbs)
+        else:
+            nxt = nbs[0] if nbs[0] != prev else nbs[1]
+        if nxt == start:
+            assert len(path) == len(neighbors), "cycle did not visit every loop pixel exactly once"
+            return path
+        path.append(nxt)
+        prev, cur = cur, nxt
+
+
+def _turn_data(path: list[tuple[int, int]]) -> tuple[dict[tuple[int, int], int], Counter]:
+    n = len(path)
+    signs: dict[tuple[int, int], int] = {}
+    counts: Counter = Counter()
+    for i, (r, c) in enumerate(path):
+        pr, pc = path[i - 1]
+        nr, nc = path[(i + 1) % n]
+        incoming = (r - pr, c - pc)
+        outgoing = (nr - r, nc - c)
+        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
+        if cross == 0:
+            continue
+        sign = 1 if cross > 0 else -1
+        signs[(r, c)] = sign
+        counts[sign] += 1
+    return signs, counts
+
