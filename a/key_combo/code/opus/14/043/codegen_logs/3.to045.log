+
+
+def _find_sprite_slot(interior: np.ndarray, loop_mask: np.ndarray, sprite: np.ndarray, rng: np.random.Generator):
+    h, w = interior.shape
+    sh, sw = sprite.shape
+    forbidden = _dilate8(loop_mask)
+    safe = interior & ~forbidden
+    placements = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
