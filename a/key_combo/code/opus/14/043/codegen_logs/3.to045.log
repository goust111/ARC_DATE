GEN_ATTEMPTS = 400


def _random_sprite(rng: np.random.Generator) -> np.ndarray:
    base = SPRITE_TEMPLATES[int(rng.integers(len(SPRITE_TEMPLATES)))]
    sprite = np.rot90(base, int(rng.integers(4)))
    if sprite.shape not in {(2, 3), (3, 2)}:
        return _random_sprite(rng)
    if np.array_equal(sprite == RED, np.fliplr(sprite == RED)):
        return _random_sprite(rng)
    coords = components_mask(sprite == RED, connectivity=4)
    if len(coords) != 1 or not (3 <= int(coords[0].shape[0]) <= 4):
        return _random_sprite(rng)
    return sprite.copy()


def _compute_boundary(region: np.ndarray) -> np.ndarray:
    h, w = region.shape
    boundary = np.zeros_like(region, dtype=bool)
    for r in range(h):
        for c in range(w):
            if not region[r, c]:
                continue
            for nr, nc in neighbors4(r, c):
                if not (0 <= nr < h and 0 <= nc < w) or not region[nr, nc]:
                    boundary[r, c] = True
                    break
    return boundary


def _random_region(h: int, w: int, sprite_shape: tuple[int, int], rng: np.random.Generator) -> np.ndarray | None:
    sh, sw = sprite_shape
    outer_h_min = max(10, sh + 6)
    outer_w_min = max(10, sw + 6)
    outer_h_max = h - 2 * sh
    outer_w_max = w - 2 * sw
    if outer_h_max < outer_h_min or outer_w_max < outer_w_min:
        return None

    outer_h = int(rng.integers(outer_h_min, outer_h_max + 1))
    outer_w = int(rng.integers(outer_w_min, outer_w_max + 1))
    top = int(rng.integers(sh, h - outer_h - sh + 1))
    left = int(rng.integers(sw, w - outer_w - sw + 1))

    region = np.zeros((h, w), dtype=bool)
    region[top : top + outer_h, left : left + outer_w] = True

    eligible = []
    if outer_w >= 9 and outer_h >= 8:
        eligible.extend(["top", "bottom"])
    if outer_h >= 9 and outer_w >= 8:
        eligible.extend(["left", "right"])
    if not eligible:
        return None

    notch_count = int(rng.choice([1, 2], p=[0.6, 0.4]))
    notch_count = min(notch_count, len(eligible))
    chosen_sides = list(rng.choice(eligible, size=notch_count, replace=False))
    for side in chosen_sides:
        if side in {"top", "bottom"}:
            notch_w = int(rng.integers(3, outer_w - 3))
            notch_depth = int(rng.integers(2, outer_h - 4))
            offset = int(rng.integers(2, outer_w - notch_w - 1))
            c0 = left + offset
            c1 = c0 + notch_w
            if side == "top":
                r0 = top
                r1 = top + notch_depth
            else:
                r0 = top + outer_h - notch_depth
                r1 = top + outer_h
            region[r0:r1, c0:c1] = False
        else:
            notch_h = int(rng.integers(3, outer_h - 3))
            notch_depth = int(rng.integers(2, outer_w - 4))
            offset = int(rng.integers(2, outer_h - notch_h - 1))
            r0 = top + offset
            r1 = r0 + notch_h
            if side == "left":
                c0 = left
                c1 = left + notch_depth
            else:
                c0 = left + outer_w - notch_depth
                c1 = left + outer_w
            region[r0:r1, c0:c1] = False
    return region


def _dilate8(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    out = mask.copy()
    coords = np.argwhere(mask)
    for r, c in coords:
        for dr, dc in DIR8:
            nr, nc = int(r + dr), int(c + dc)
            if 0 <= nr < h and 0 <= nc < w:
                out[nr, nc] = True
    return out


def _find_sprite_slot(region: np.ndarray, loop_mask: np.ndarray, sprite: np.ndarray, rng: np.random.Generator):
    h, w = region.shape
    sh, sw = sprite.shape
    forbidden = _dilate8(loop_mask)
    safe = region & ~forbidden
    placements = []
    for r0 in range(h - sh + 1):
        for c0 in range(w - sw + 1):
            patch = safe[r0 : r0 + sh, c0 : c0 + sw]
            if np.all(patch):
                placements.append((r0, c0))
    if not placements:
        return None
    return placements[int(rng.integers(len(placements)))]


