+        slot = _find_sprite_slot(region, loop_mask, sprite, rng)
+        if slot is None:
+            continue
+        r0, c0 = slot
+        grid = np.zeros((h, w), dtype=int)
+        grid[loop_mask] = BLUE
+        sprite_mask = sprite == RED
+        grid[r0 : r0 + sprite.shape[0], c0 : c0 + sprite.shape[1]][sprite_mask] = RED
+        if _validate_generated(grid, sprite):
+            return grid
