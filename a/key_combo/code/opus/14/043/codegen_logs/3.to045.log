+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        h = int(rng.integers(20, 27))
+        w = int(rng.integers(20, 27))
+        sprite = _random_sprite(rng)
+        region = _random_region(h, w, sprite.shape, rng)
