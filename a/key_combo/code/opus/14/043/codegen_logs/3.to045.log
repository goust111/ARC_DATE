+    counts: Counter = Counter()
+    for i, (r, c) in enumerate(path):
+        pr, pc = path[i - 1]
+        nr, nc = path[(i + 1) % n]
+        incoming = (r - pr, c - pc)
+        outgoing = (nr - r, nc - c)
