    return _render_output(loop_mask, sprite)


def _validate_generated(grid: np.ndarray, sprite: np.ndarray) -> bool:
    if grid.ndim != 2 or max(grid.shape) > 30:
        return False
    if set(map(int, np.unique(grid))) != {BLACK, BLUE, RED}:
