+        path.extend(cells)
+    else:
+        assert path[-1] == cells[0]
+        path.extend(cells[1:])
+
+
+def _chain_from_vertices(vertices: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    path: list[tuple[int, int]] = []
+    for a, b in zip(vertices, vertices[1:]):
+        _append_segment(path, a, b)
