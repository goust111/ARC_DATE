+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_from_mask(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[Coord]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q: deque[Coord] = deque([(r, c)])
+        seen[r, c] = True
+        comp: list[Coord] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        components.append(comp)
+    return components
+
+
+def _components_from_cells(cells: list[Coord] | tuple[Coord, ...]) -> list[list[Coord]]:
+    remaining = set((int(r), int(c)) for r, c in cells)
+    components: list[list[Coord]] = []
+    while remaining:
+        start = remaining.pop()
+        q: deque[Coord] = deque([start])
+        comp = [start]
+        while q:
+            rr, cc = q.popleft()
+            for nr, nc in _neighbors4(rr, cc):
+                if (nr, nc) in remaining:
+                    remaining.remove((nr, nc))
+                    q.append((nr, nc))
+                    comp.append((nr, nc))
+        components.append(comp)
+    return components
