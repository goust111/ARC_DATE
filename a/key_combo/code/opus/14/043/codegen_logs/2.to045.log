+
+def _shape_mask(shape: Shape) -> np.ndarray:
+    h = max(r for r, _ in shape) + 1
+    w = max(c for _, c in shape) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in shape:
+        mask[r, c] = True
+    return mask
+
+
