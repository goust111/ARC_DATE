+                options.append(("h", (r0, c0, r1, c1)))
+        if not options:
+            return None
+        orient, (r0, c0, r1, c1) = random.choice(options)
+        if orient == "v":
+            wall_c = random.randint(c0 + MIN_ROOM_SIDE, c1 - MIN_ROOM_SIDE)
+            grid[r0 : r1 + 1, wall_c] = WALL
+        else:
