+    split_r = random.randint(MIN_ROOM_SIDE, h - MIN_ROOM_SIDE - 1)
+    split_c = random.randint(MIN_ROOM_SIDE, w - MIN_ROOM_SIDE - 1)
+    grid[split_r, :] = WALL
+    grid[:, split_c] = WALL
