spec:
  grid: 5-30 rows x 5-30 cols
  colors:
    bg: most common color (7/orange in eval)
    water: rarest non-bg color (6/magenta in eval), flow marker
    shelf: other non-bg color (2/red in eval), horizontal barriers
  water_sources:
    count: 1-2 independent 8-connected components touching row 0
    shape: 1-col-wide x 2-rows-tall vertical bar at rows 0-1
    placement: any column including grid edges
  shelves:
    form: horizontal contiguous runs of shelf color per row
    total_segments: 3-8 across all rows
    segment_length: 1-18 pixels
    row_range: rows 2 to H-1 (shelves on row 1 at different cols from sources also valid [observed])
    adjacent_rows: allowed
    can_touch_grid_edges: yes
  constraints:
    pixel_count_order: count(bg) >> count(shelf) > count(water)
    water must be strictly rarest non-bg for solver color detection
  transformation:
    water falls vertically from source bottom row
    on hitting shelf below, spreads horizontally across shelf span +1 cell each side on current row
    flow splits at left/right spread edges and continues downward
    BFS with visited set avoids revisiting (row, col) positions

generation_strategy:
  approach: direct construction (input is sources + shelves on bg; output derived by solver)
  steps:
    1. Pick H, W in [8, 25]
    2. Fill grid with bg
    3. Place 1-2 water sources as 1x2 vertical bars at rows 0-1, random distinct cols
    4. Choose 3-7 distinct rows in [2, H-1] for shelf segments
    5. For first shelves, bias placement to intersect water source columns for interesting flow
    6. For each row, place shelf segment of random length [2, min(W-1, 15)]
    7. Ensure count(water) < count(shelf); add extra shelf segment if needed
    8. Validate main(grid) succeeds
```
