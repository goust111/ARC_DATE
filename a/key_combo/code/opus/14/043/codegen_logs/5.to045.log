+BG = 0
+BLOCK = 5
+RAY = 7
+
+START_OFFSETS = {
+    "NW": (-1, -1),
+    "NE": (-1, 2),
+    "SE": (2, 2),
+    "SW": (2, -1),
+}
+
+DIAGONAL_DIRS = {
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SE": (1, 1),
+    "SW": (1, -1),
+}
+
+COUNT_TO_COLOR = {
+    0: 1,
+    1: 3,
+    2: 4,
+}
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
