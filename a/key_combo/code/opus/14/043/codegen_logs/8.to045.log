+    return _simulate(np.asarray(grid, dtype=int))
+
+
+def _choose_span(
+    width: int,
+    required_cols: list[int],
+    min_margin: int,
+    min_width: int,
+    max_width: int,
+) -> tuple[int, int] | None:
+    req = sorted(required_cols)
+    needed = 0 if not req else req[-1] - req[0] + 3
+    lo_w = max(min_width, needed)
+    hi_w = max_width
+    if lo_w > hi_w:
+        return None
+    band_w = random.randint(lo_w, hi_w)
+
+    if not req:
