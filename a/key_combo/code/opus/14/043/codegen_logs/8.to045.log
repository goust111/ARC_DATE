+        bottom = _choose_span(width, [], 2, min_band_w, max_band_w)
+        if bottom is None:
+            return None
+        l2, r2 = bottom
+        top_sources = random.sample(list(range(l2 + 2, r2 - 1)), random.choice([1, 2]))
+        top_band = _choose_span(width, top_sources, 2, min_band_w, max_band_w)
+        if top_band is None:
+            return None
+        l1, r1 = top_band
+        spans = [(l1, r1), (l2, r2)]
