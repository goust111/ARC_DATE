+    seen_launches: set[tuple[int, int]] = set()
+    meta = {
+        "spread_events": 0,
+        "overflow_launches": 0,
+        "merge_hits": 0,
+        "max_spread_depth": -1,
+        "vertical_cells": set(),
+        "spread_cells": set(),
+        "events": [],
+    }
+
+    while launches:
+        r, c, depth = launches.popleft()
+        if (r, c) in seen_launches:
+            continue
