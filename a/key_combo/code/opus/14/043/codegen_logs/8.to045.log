+
+
+def _add_defect_component(
+    grid: np.ndarray,
+    top: int,
+    height: int,
+    left: int,
+    right: int,
+    used_cells: set[tuple[int, int]],
+    used_cols: set[int],
+    avoid_cols: set[int],
+    forced_col: int | None = None,
+    prefer_size2: bool = False,
