from __future__ import annotations

from collections import Counter

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def _shape_key(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor each 8-connected foreground object by whether its normalized shape is repeated or unique.

    Input structure
    - The dominant background contains several same-color foreground objects.
    - Objects are 8-connected; diagonal contact joins pixels into the same object.
    - Up to translation within each bbox, exactly one object shape appears once
      and exactly one other object shape appears multiple times.

    Rule
    - Group foreground objects by their normalized bbox mask.
    - Recolor the singleton-shape object red.
    - Recolor every repeated-shape object blue.
    - Keep the background unchanged.

    Key insight
    - The recolor is determined by object-shape frequency, not by position or size alone.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"

    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1, "expected one foreground color"

    components = find_components(
        g,
        bg=bg,
        connectivity=8,
        monochromatic=True,
        colors=fg_colors,
        return_format="dict",
    )
    assert len(components) >= 2, "expected multiple foreground objects"

    shape_keys = [_shape_key(component["coords"]) for component in components]
    counts = Counter(shape_keys)
    singleton_shapes = {key for key, count in counts.items() if count == 1}
    repeated_shapes = {key for key, count in counts.items() if count > 1}
    assert len(singleton_shapes) == 1, "expected exactly one singleton object shape"
    assert len(repeated_shapes) == 1, "expected exactly one repeated object shape"

    out = g.copy()
    for component, shape_key in zip(components, shape_keys):
        coords = component["coords"]
        color = 2 if shape_key in singleton_shapes else 1
        out[coords[:, 0], coords[:, 1]] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas/colors.
GEN_GRID_SHAPE = (10, 10)
GEN_BG, GEN_FG = 0, 8
GEN_OUT_REPEATED, GEN_OUT_SINGLETON = 1, 2
# Shape sampling.
SHAPE_HEIGHT_RANGE = (2, 4)
SHAPE_WIDTH_RANGE = (2, 5)
SHAPE_AREA_RANGE = (4, 10)
SHAPE_FLIP_PROB = 0.5
SHAPE_PAIR_RETRIES = 60
NEIGHBOR_DELTAS_8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
# Placement/retries.
PLACEMENT_PADDING, PLACEMENT_CONNECTIVITY = 1, 8
GENERATION_RETRIES = 300


def _gen_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    coords = np.argwhere(mask)
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))


def _gen_dihedral_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    forms = []
    base = mask.astype(bool)
    for k in range(4):
        rot = np.rot90(base, k)
        forms.append(_gen_key(rot))
        forms.append(_gen_key(np.fliplr(rot)))
    return min(forms)


def _gen_random_shape() -> np.ndarray:
    h = random.randint(*SHAPE_HEIGHT_RANGE)
    w = random.randint(*SHAPE_WIDTH_RANGE)
    area = random.randint(max(SHAPE_AREA_RANGE[0], h, w), min(SHAPE_AREA_RANGE[1], h * w))

    path_len = random.randint(max(h, w), min(h + w - 1, area))
    diag_count = h + w - 1 - path_len
    steps = (
        [(1, 1)] * diag_count
        + [(1, 0)] * (h - 1 - diag_count)
        + [(0, 1)] * (w - 1 - diag_count)
    )
    random.shuffle(steps)

    mask = np.zeros((h, w), dtype=bool)
    r = c = 0
    mask[r, c] = True
    for dr, dc in steps:
        r += dr
        c += dc
        mask[r, c] = True

    while int(mask.sum()) < area:
        frontier = set()
        for rr, cc in np.argwhere(mask):
            for dr, dc in NEIGHBOR_DELTAS_8:
                nr = int(rr) + dr
                nc = int(cc) + dc
                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
                    frontier.add((nr, nc))
        if not frontier:
            break
        nr, nc = random.choice(tuple(frontier))
        mask[nr, nc] = True

    if random.random() < SHAPE_FLIP_PROB:
        mask = np.fliplr(mask)
    if random.random() < SHAPE_FLIP_PROB:
        mask = np.flipud(mask)
    return mask


def _gen_pair_shapes() -> tuple[np.ndarray, np.ndarray] | None:
    shape_a = _gen_random_shape()
    key_a = _gen_dihedral_key(shape_a)
    for _ in range(SHAPE_PAIR_RETRIES):
        shape_b = _gen_random_shape()
        if _gen_dihedral_key(shape_b) != key_a:
            return shape_a, shape_b
    return None


def _render_candidate(shape_a: np.ndarray, shape_b: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    inp = np.zeros(GEN_GRID_SHAPE, dtype=int)
    expected = np.zeros(GEN_GRID_SHAPE, dtype=int)
    pieces = [
        (shape_a, GEN_OUT_REPEATED),
        (shape_a, GEN_OUT_REPEATED),
        (shape_b, GEN_OUT_SINGLETON),
    ]
    random.shuffle(pieces)

    for mask, out_color in pieces:
        in_patch = np.where(mask, GEN_FG, GEN_BG)
        out_patch = np.where(mask, out_color, GEN_BG)
        r, c = random_free_location(
            inp,
            in_patch,
            transparent=GEN_BG,
            padding=PLACEMENT_PADDING,
            padding_connectivity=PLACEMENT_CONNECTIVITY,
        )
        paste(inp, in_patch, r, c, transparent=GEN_BG)
        paste(expected, out_patch, r, c, transparent=GEN_BG)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    pair = _gen_pair_shapes()
    if pair is None:
        return None
    try:
        inp, expected = _render_candidate(*pair)
        actual = main(inp)
    except Exception:
        return None

    return inp if np.array_equal(actual, expected) else None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("failed to generate a valid b230c067 input")
import numpy as np
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Expand the whole grid into a 2x2 reflection pattern with the input in the lower-right quadrant.

    Input structure
    - The input is a non-empty rectangular 2D grid.
    - Every input pixel belongs to the pattern; there is no separate background object.

    Rule
    - Keep the input unchanged as the lower-right quadrant.
    - Put the left-right reflection in the lower-left quadrant.
    - Put the top-bottom reflection in the upper-right quadrant.
    - Put the reflection across both axes in the upper-left quadrant.

    Key insight
    - The output completes four-way mirror symmetry around the input's upper-left corner.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert g.shape[0] > 0 and g.shape[1] > 0, "expected a non-empty grid"

    return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)], [np.fliplr(g), g]])

# --------------- generator (o5x) ---------------

# Canvas and palette bounds.
GEN_SIDE_MIN, GEN_SIDE_MAX = 3, 8
GEN_PALETTE, GEN_COLOR_COUNT = range(1, 10), 3
# Fill, asymmetry, and retry controls.
GEN_BLACK_FRAC_MIN, GEN_BLACK_FRAC_MAX = 0.33, 0.56
GEN_FORCED_COLOR_CELLS, GEN_EMPTY = 4, -1
GEN_MAX_ATTEMPTS = 300


def _gen_expected_output(grid: np.ndarray) -> np.ndarray:
    return np.block([[np.flipud(np.fliplr(grid)), np.flipud(grid)], [np.fliplr(grid), grid]])


def _gen_black_count(total: int) -> int:
    min_black = int(np.ceil(total * GEN_BLACK_FRAC_MIN))
    max_black = int(np.floor(total * GEN_BLACK_FRAC_MAX))
    return random.randint(min_black, min(total - GEN_FORCED_COLOR_CELLS, max_black))


def _gen_disjoint_mirror_pairs(n: int):
    lr_pairs = [((r, c), (r, n - 1 - c)) for r in range(n) for c in range(n // 2)]
    ud_pairs = [((r, c), (n - 1 - r, c)) for r in range(n // 2) for c in range(n)]

    random.shuffle(lr_pairs)
    random.shuffle(ud_pairs)
    for lr_pair in lr_pairs:
        lr_cells = set(lr_pair)
        for ud_pair in ud_pairs:
            if lr_cells.isdisjoint(ud_pair):
                return lr_pair, ud_pair
    return None, None


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GEN_SIDE_MIN, GEN_SIDE_MAX)
    total = n * n
    colors = random.sample(GEN_PALETTE, GEN_COLOR_COUNT)
    black_count = _gen_black_count(total)
    colored_count = total - black_count

    lr_pair, ud_pair = _gen_disjoint_mirror_pairs(n)
    if lr_pair is None:
        return None

    grid = np.full((n, n), GEN_EMPTY, dtype=int)
    forced = {
        lr_pair[0]: colors[0],
        lr_pair[1]: colors[1],
        ud_pair[0]: colors[1],
        ud_pair[1]: colors[2],
    }
    for (r, c), value in forced.items():
        grid[r, c] = value

    remaining_cells = [(r, c) for r in range(n) for c in range(n) if grid[r, c] == GEN_EMPTY]
    remaining_values = [0] * black_count
    remaining_values.extend(
        random.choice(colors) for _ in range(colored_count - GEN_FORCED_COLOR_CELLS)
    )
    random.shuffle(remaining_values)

    for (r, c), value in zip(remaining_cells, remaining_values):
        grid[r, c] = value

    if np.array_equal(grid, np.fliplr(grid)) or np.array_equal(grid, np.flipud(grid)):
        return None

    expected = _gen_expected_output(grid)
    return grid if np.array_equal(main(grid), expected) else None


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input for 833dafe3")
import numpy as np

import random
from arc_utils import Color, bbox, crop_bbox, draw_line, first_free_location, paste, random_sprite

# concepts:
# cropping

# description:
# In the input you will see a single colored shape, around 4x6 in size, floating in a 12x12 grid of black.
# To make the output, crop the background out of the image - so the output grid has the same dimensions as the shape.

def main(input_grid):
    """
    Crop away the black background and return the tight box around the single colored object.

    Input structure:
    - The grid has a black background.
    - Exactly one non-black sprite is placed somewhere inside the grid.
    - The sprite may use any non-black color.

    Rule:
    - Find the bounding box of all non-black cells.
    - Crop the input grid to that bounding box.
    - Return the cropped sprite with its original colors.

    Key insight:
    - The output is determined only by the non-black support; the surrounding black margin is discarded.
    """
    b = bbox(input_grid != Color.BLACK)
    assert b is not None
    return crop_bbox(input_grid, b)

def generate_input():
    # create a roughly 12x12 input grid
    n = np.random.randint(10, 15)
    m = np.random.randint(10, 15)
    grid = np.full((n, m), Color.BLACK, dtype=int)

    # create a small random sprite with shape (2-7)x(2-7)
    w = np.random.randint(2, 8)
    h = np.random.randint(2, 8)
