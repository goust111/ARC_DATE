+    seen = np.zeros((H, W), dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(H):
+        for c in range(W):
+            if g[r, c] != GREEN or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and g[nr, nc] == GREEN:
