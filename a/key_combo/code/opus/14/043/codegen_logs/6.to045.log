+                "mask": obj["mask"].copy(),
+                "score": obj["score"],
+                "bbox": obj["bbox"],
+            }
+        )
+    return _render_objects(logical)
+
+
+def _validate_candidate(grid: np.ndarray, objects: list[dict], expected: np.ndarray) -> bool:
+    if grid.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
