+        return False
+
+    extracted = _extract_green_objects(grid)
+    if len(extracted) != len(objects):
+        return False
+
+    found_scores = Counter(obj["score"] for obj in extracted)
+    expected_scores = Counter(obj["score"] for obj in objects)
