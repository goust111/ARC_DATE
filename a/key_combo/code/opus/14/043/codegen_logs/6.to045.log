    """Grow an 8-connected mask from a line seed to the target area."""
    mask = _line_mask(h, w)
    while int(mask.sum()) < area:
        frontier = set()
        for r, c in np.argwhere(mask):
            for dr, dc in _NEIGHBORS8:
                nr, nc = int(r) + dr, int(c) + dc
                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
                    frontier.add((nr, nc))
        pick = list(frontier)
        nr, nc = pick[int(_RNG.integers(0, len(pick)))]
        mask[nr, nc] = True
    return mask


def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
    """Paint a boolean mask into a colored patch on a bg-filled array."""
    pat = np.full(mask.shape, bg, dtype=int)
    pat[mask] = color
    return pat


def _make_component(area: int, color: int, bg: int) -> dict:
    """Generate a random 8-connected component with the given area and color."""
    dims = _feasible_dims(area)
    irregular_dims = [d for d in dims if d[0] * d[1] > area]
    if irregular_dims and _RNG.random() < IRREGULAR_PROB:
        dims = irregular_dims
    h, w = dims[int(_RNG.integers(0, len(dims)))]
    mask = _make_mask(h, w, area)
    return {"area": area, "color": color, "h": h, "w": w,
            "mask": mask, "pat": _mask_to_pat(mask, color, bg),
            "shape_key": canonical_shape_key(mask)}


def _random_transform(mask: np.ndarray) -> np.ndarray:
    """Apply a random rotation (0-3) and optional horizontal flip to a mask."""
    mask = np.rot90(mask, int(_RNG.integers(0, 4)))
    if bool(_RNG.integers(0, 2)):
        mask = np.fliplr(mask)
    return mask


def _clone_component(template: dict, color: int, bg: int) -> dict:
    """Create a duplicate of template's shape with a new color and random transform."""
    mask = _random_transform(template["mask"].copy())
    h, w = mask.shape
    return {"area": template["area"], "color": color, "h": h, "w": w,
            "mask": mask, "pat": _mask_to_pat(mask, color, bg),
            "shape_key": canonical_shape_key(mask)}


def _assign_columns(widths: list[int], W: int) -> list[int] | None:
    """Distribute components horizontally with random spacing (min gap = MIN_COL_GAP)."""
    n = len(widths)
    total = sum(widths) + MIN_COL_GAP * (n - 1)
    if total > W:
        return None
    slack = W - total
    extras = _RNG.multinomial(slack, np.ones(n + 1) / (n + 1))
    cols = []
    c = int(extras[0])
    for i, w in enumerate(widths):
        cols.append(c)
        c += w
        if i < n - 1:
            c += MIN_COL_GAP + int(extras[i + 1])
    return cols


def _dilate_occupied(occupied: np.ndarray) -> np.ndarray:
    """Return a mask that is True wherever occupied or any 8-neighbor is occupied."""
    dilated = occupied.copy()
    dilated[1:, :] |= occupied[:-1, :]
    dilated[:-1, :] |= occupied[1:, :]
    dilated[:, 1:] |= occupied[:, :-1]
    dilated[:, :-1] |= occupied[:, 1:]
    dilated[1:, 1:] |= occupied[:-1, :-1]
    dilated[1:, :-1] |= occupied[:-1, 1:]
    dilated[:-1, 1:] |= occupied[1:, :-1]
    dilated[:-1, :-1] |= occupied[1:, 1:]
    return dilated


def _can_place(dilated: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
    """Check if mask placed at (r0, c0) overlaps any dilated-occupied cell."""
    h, w = mask.shape
    return not bool((dilated[r0:r0 + h, c0:c0 + w] & mask).any())


def _build_output(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray:
    """Paint all components at their output positions."""
    out = np.full((H, W), bg, dtype=int)
    for comp in comps:
        paste(out, comp["pat"], comp["out_r0"], comp["c0"], transparent=bg)
    return out


def _derive_input(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray | None:
    """Place components at random non-output rows without 8-neighbor overlap."""
    inp = np.full((H, W), bg, dtype=int)
    occupied = np.zeros((H, W), dtype=bool)
    order = list(range(len(comps)))
    _RNG.shuffle(order)
    order.sort(key=lambda i: comps[i]["h"] * comps[i]["w"], reverse=True)

    for i in order:
        comp = comps[i]
        h, c0 = comp["h"], comp["c0"]
        rows = [r for r in range(H - h + 1) if r != comp["out_r0"]]
        if not rows:
            rows = list(range(H - h + 1))
        _RNG.shuffle(rows)

        dilated = _dilate_occupied(occupied)
        valid = [r for r in rows if _can_place(dilated, comp["mask"], r, c0)]
        if not valid:
            valid = [r for r in range(H - h + 1)
                     if _can_place(dilated, comp["mask"], r, c0)]
        if not valid:
            return None

        r0 = valid[int(_RNG.integers(0, len(valid)))]
        comp["in_r0"] = r0
        paste(inp, comp["pat"], r0, c0, transparent=bg)
        mh, mw = comp["mask"].shape
        occupied[r0:r0 + mh, c0:c0 + mw] |= comp["mask"]
    return inp


def _build_groups(bg: int) -> tuple[list[dict], list[dict]]:
    """Create duplicate-shape (top) and unique-shape (bottom) component groups."""
    dup_layout = DUP_LAYOUTS[int(_RNG.integers(0, len(DUP_LAYOUTS)))]
    n_singletons = 2 if sum(dup_layout) == 4 else int(_RNG.integers(2, 4))

    colors = [c for c in range(NUM_COLORS) if c != bg]
    _RNG.shuffle(colors)

    used_shape_keys: set[tuple[bytes, tuple[int, int]]] = set()
    top, ci = [], 0
    for count in dup_layout:
        for _ in range(200):
            area = int(_RNG.integers(*AREA_RANGE))
            template = _make_component(area, colors[ci], bg)
            if template["shape_key"] not in used_shape_keys:
                used_shape_keys.add(template["shape_key"])
                break
        else:
            raise RuntimeError("failed to create a new duplicate template shape")
        top.append(template)
        ci += 1
        for _ in range(count - 1):
            top.append(_clone_component(template, colors[ci], bg))
            ci += 1

    bottom = []
    while len(bottom) < n_singletons:
        area = int(_RNG.integers(*AREA_RANGE))
        comp = _make_component(area, colors[ci], bg)
        if comp["shape_key"] in used_shape_keys:
            continue
        used_shape_keys.add(comp["shape_key"])
        bottom.append(comp)
        ci += 1
    return top, bottom


def _gen_attempt() -> np.ndarray | None:
    """Single attempt: build output-first, derive input, validate with oracle."""
    H = int(_RNG.integers(*GRID_H_RANGE))
    W = int(_RNG.integers(*GRID_W_RANGE))
    bg = int(_RNG.integers(0, NUM_COLORS))

    top, bottom = _build_groups(bg)
    _RNG.shuffle(top)
    _RNG.shuffle(bottom)

    if H - max(c["h"] for c in top) - max(c["h"] for c in bottom) < MIN_VERTICAL_GAP:
        return None

    top_cols = _assign_columns([c["w"] for c in top], W)
    bottom_cols = _assign_columns([c["w"] for c in bottom], W)
    if top_cols is None or bottom_cols is None:
        return None

    for comp, c0 in zip(top, top_cols):
        comp["c0"], comp["out_r0"] = c0, 0
    for comp, c0 in zip(bottom, bottom_cols):
        comp["c0"], comp["out_r0"] = c0, H - comp["h"]

    comps = top + bottom
    expected = _build_output(comps, H, W, bg)
    inp = _derive_input(comps, H, W, bg)
    if inp is None:
        return None
    if int(get_bg(inp)) != bg:
        return None

    found = find_components(inp, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    if len(found) != len(comps):
        return None
    if Counter(len(c["coords"]) for c in found) != Counter(c["area"] for c in comps):
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 62593bfd sample")
from collections import Counter

import numpy as np

from arc_utils import find_components, get_bg
import random


def _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:
    H, W = shape
    if corner == "TL":
        return int(r), int(c)
    if corner == "TR":
        return int(r), int(W - 1 - c)
    if corner == "BL":
        return int(H - 1 - r), int(c)
    assert corner == "BR"
    return int(H - 1 - r), int(W - 1 - c)


def _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:
    H, W = out.shape
    assert side > 0, "triangle side length must be positive"
    for r in range(H):
        for c in range(W):
            a, b = _corner_distances((H, W), corner, r, c)
            if a + b < side:
                out[r, c] = int(color)


def _diagonal_direction(coords: set[tuple[int, int]]) -> str | None:
    r0 = min(r for r, _ in coords)
    r1 = max(r for r, _ in coords)
    c0 = min(c for _, c in coords)
    c1 = max(c for _, c in coords)
    height = r1 - r0 + 1
    width = c1 - c0 + 1
    if height != width:
        return None
    n = height
    local = {(r - r0, c - c0) for r, c in coords}
    main_ok = all((c, r) in local for r, c in local)
    anti_ok = all((n - 1 - c, n - 1 - r) in local for r, c in local)
    if main_ok:
        if (0, 0) in local and (n - 1, n - 1) not in local:
            return "TL"
        if (n - 1, n - 1) in local and (0, 0) not in local:
            return "BR"
    if anti_ok:
        if (0, n - 1) in local and (n - 1, 0) not in local:
            return "TR"
        if (n - 1, 0) in local and (0, n - 1) not in local:
            return "BL"
    return None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Keep the largest 8-connected motif and replace the corner/control pixels with a solid corner triangle.

    Input structure
    - The background is the dominant color.
    - Exactly one grid corner contains a foreground control pixel; it gives the
      corner from which the triangle is painted.
    - There is one unique largest 8-connected monochrome foreground object, the
      motif that remains in the output; all other foreground pixels are controls.
    - Every foreground component outside that motif is a singleton control pixel.
    - The fill color is the unique control color that appears in at least two
      non-corner control pixels.

    Rule
    - Start from a blank background canvas and redraw only the largest motif.
    - Count the non-corner control pixels; that count is the triangle side.
    - Paint the fill color on the right-triangle region where those two distances
      from the marked corner's edges sum to less than the side length.

    Key insight
    - The scattered singleton controls are counted into a compact triangular
      stack at the marked corner; only the largest motif is not part of the count.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape

    corners = {
        "TL": (0, 0),
        "TR": (0, W - 1),
        "BL": (H - 1, 0),
        "BR": (H - 1, W - 1),
    }
    marked_corners = [
        (name, rc) for name, rc in corners.items() if int(g[rc]) != int(bg)
    ]
    assert len(marked_corners) == 1, "expected exactly one foreground corner marker"
    corner, (corner_r, corner_c) = marked_corners[0]

    comps = find_components(g, bg=bg, connectivity=8, monochromatic=True)
    assert comps, "expected at least one foreground component"
    max_area = max(int(comp["area"]) for comp in comps)
    motif_candidates = [comp for comp in comps if int(comp["area"]) == max_area]
    assert len(motif_candidates) == 1, "expected a unique largest motif"
    motif = motif_candidates[0]
    motif_color = int(motif["color"])
    motif_coords = {tuple(map(int, coord)) for coord in motif["coords"]}
    motif_direction = _diagonal_direction(motif_coords)
    assert motif_direction is not None, "motif must be square and diagonal-symmetric"
    assert motif_direction == corner, "corner marker must match motif diagonal direction"

    control_coords = [
        (int(r), int(c))
        for r, c in np.argwhere(g != bg)
        if (int(r), int(c)) not in motif_coords
    ]
    assert (corner_r, corner_c) in control_coords, "corner marker must be a control pixel"
    assert len(control_coords) > 1, "expected non-corner control pixels"

    control_components = [comp for comp in comps if comp is not motif]
    assert all(int(comp["area"]) == 1 for comp in control_components), "controls must be singleton components"

    control_counts = Counter(
        int(g[r, c])
        for r, c in control_coords
        if (int(r), int(c)) != (corner_r, corner_c)
    )
    fill_candidates = [
        int(color) for color, count in control_counts.items() if int(count) >= 2
    ]
    assert len(fill_candidates) == 1, "expected one repeated non-corner fill color"
    fill_color = fill_candidates[0]
    side = len(control_coords) - 1

    out = np.full_like(g, bg)
    for r, c in motif_coords:
        out[r, c] = motif_color
    _paint_corner_triangle(out, corner, int(side), fill_color)
    return out

# --------------- generator (att2) ---------------

_GEN_ATTEMPTS = 300

# Canvas and triangle bounds.
_GEN_ROW_BOUNDS = (6, 15)
_GEN_COL_BOUNDS = (9, 14)
_GEN_TRIANGLE_SIDE_BOUNDS = (2, 5)

# Color and control-pixel sampling.
_GEN_COLORS = tuple(range(1, 10))
_GEN_MARKER_AVOID_FILL_PROB = 0.8
_GEN_FILL_COUNT_BOUNDS = (2, 3)

# Sparse square motifs observed in the task examples.
_GEN_MOTIF_TEMPLATES = [
    ("..#.", ".#..", "#.#.", "...#"),
    (".#...", "..#..", "..##.", ".#..#", "#...."),
    (
        "...###...",
        "..#......",
        ".##......",
        "#..#.....",
        "#...#....",
        "#....#...",
        "......#..",
        ".......#.",
        "........#",
    ),
    ("#...", ".#.#", "..#.", ".#.."),
    ("...#", "#.#.", "##..", ".##."),
]


def _gen_triangle_mask(shape, corner, side):
    H, W = shape
    rr, cc = np.indices((H, W))
    if corner == "TL":
        return rr + cc < side
    if corner == "TR":
        return rr + (W - 1 - cc) < side
    if corner == "BL":
        return (H - 1 - rr) + cc < side
    return (H - 1 - rr) + (W - 1 - cc) < side


def _gen_dilate8(mask):
    out = mask.copy()
    out[1:, :] |= mask[:-1, :]
    out[:-1, :] |= mask[1:, :]
    out[:, 1:] |= mask[:, :-1]
    out[:, :-1] |= mask[:, 1:]
    out[1:, 1:] |= mask[:-1, :-1]
    out[1:, :-1] |= mask[:-1, 1:]
    out[:-1, 1:] |= mask[1:, :-1]
    out[:-1, :-1] |= mask[1:, 1:]
    return out


def _gen_patch_from_lines(lines):
    return np.array([[ch == "#" for ch in row] for row in lines], dtype=bool)


def _gen_patch_variants(patch):
    variants = []
    seen = set()
    for k in range(4):
        rotated = np.rot90(patch, k)
        for variant in (rotated, np.fliplr(rotated)):
            key = tuple(map(tuple, variant.astype(int)))
            if key not in seen:
                seen.add(key)
                variants.append(variant.copy())
    return variants


def _gen_reflect_anti_diagonal(patch):
    return np.flipud(np.fliplr(patch.T))


def _gen_is_diagonal_symmetric_patch(patch):
    if patch.shape[0] != patch.shape[1]:
        return False
    main_ok = np.array_equal(patch, patch.T)
    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))


def _gen_patch_direction(patch):
    if patch.shape[0] != patch.shape[1]:
        return None
    n = patch.shape[0]
    main_ok = np.array_equal(patch, patch.T)
    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))
    if main_ok:
        if patch[0, 0] and not patch[n - 1, n - 1]:
            return "TL"
        if patch[n - 1, n - 1] and not patch[0, 0]:
            return "BR"
    if anti_ok:
        if patch[0, n - 1] and not patch[n - 1, 0]:
            return "TR"
        if patch[n - 1, 0] and not patch[0, n - 1]:
            return "BL"
    return None


def _gen_symmetric_motif_patch(max_h, max_w):
    candidates = []
    for lines in _GEN_MOTIF_TEMPLATES:
        patch = _gen_patch_from_lines(lines)
        for variant in _gen_patch_variants(patch):
            h, w = variant.shape
            direction = _gen_patch_direction(variant)
            if (
                h <= max_h
                and w <= max_w
                and _gen_is_diagonal_symmetric_patch(variant)
                and direction is not None
            ):
                candidates.append((variant, direction))
    if not candidates:
        return None
    patch, direction = random.choice(candidates)
    return patch.copy(), direction


def _gen_place_patch(forbidden, patch):
    H, W = forbidden.shape
    m, n = patch.shape
    cells = np.argwhere(patch)
    placements = []
    for r0 in range(H - m + 1):
        for c0 in range(W - n + 1):
            if all(not forbidden[r0 + r, c0 + c] for r, c in cells):
                placements.append((r0, c0))
    if not placements:
        return None
    r0, c0 = random.choice(placements)
    return {(int(r0 + r), int(c0 + c)) for r, c in cells}


def _gen_corner_cells(shape):
    H, W = shape
    return {
        "TL": (0, 0),
        "TR": (0, W - 1),
        "BL": (H - 1, 0),
        "BR": (H - 1, W - 1),
    }


def _gen_control_pool(grid, motif_mask, blocked_mask):
    H, W = grid.shape
    near_motif = _gen_dilate8(motif_mask)
    pool = []
    corners = set(_gen_corner_cells((H, W)).values())
    for r in range(H):
        for c in range(W):
            if (r, c) in corners:
                continue
            if grid[r, c] != 0 or near_motif[r, c] or blocked_mask[r, c]:
                continue
            pool.append((r, c))
    return pool


def _gen_choose_scene():
    H = random.randint(*_GEN_ROW_BOUNDS)
    W = random.randint(*_GEN_COL_BOUNDS)
    side = random.randint(*_GEN_TRIANGLE_SIDE_BOUNDS)
    colors = list(_GEN_COLORS)
    fill_color = random.choice(colors)
    motif_color = random.choice([c for c in colors if c != fill_color])
    return H, W, side, colors, fill_color, motif_color


def _gen_place_motif(H, W, side, fill_color, motif_color, motif_patch, corner):
    triangle_mask = _gen_triangle_mask((H, W), corner, side)
    output = np.zeros((H, W), dtype=int)
    output[triangle_mask] = fill_color

    forbidden = _gen_dilate8(triangle_mask)
    for rc in _gen_corner_cells((H, W)).values():
        forbidden[rc] = True
    motif_coords = _gen_place_patch(forbidden, motif_patch)
    if motif_coords is None:
        return None

    motif_mask = np.zeros((H, W), dtype=bool)
    for r, c in motif_coords:
        motif_mask[r, c] = True
        output[r, c] = motif_color
    return output, triangle_mask, motif_mask


def _gen_marker_choices(colors, motif_color, fill_color):
    marker_choices = [c for c in colors if c != motif_color]
    if random.random() < _GEN_MARKER_AVOID_FILL_PROB and len(marker_choices) > 1:
        marker_choices = [c for c in marker_choices if c != fill_color]
    return marker_choices


def _gen_control_colors(colors, side, fill_color):
    fill_count = random.randint(_GEN_FILL_COUNT_BOUNDS[0], min(_GEN_FILL_COUNT_BOUNDS[1], side))
    distractor_count = side - fill_count
    distractor_choices = [c for c in colors if c != fill_color]
    random.shuffle(distractor_choices)
    control_colors = [fill_color] * fill_count + distractor_choices[:distractor_count]
    random.shuffle(control_colors)
    return control_colors


def _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):
    H, W = inp.shape
    corner_rc = _gen_corner_cells((H, W))[corner]
    inp[corner_rc] = random.choice(_gen_marker_choices(colors, motif_color, fill_color))
    control_colors = _gen_control_colors(colors, side, fill_color)

    occupied_controls = np.zeros((H, W), dtype=bool)
    occupied_controls[corner_rc] = True
    blocked_controls = triangle_mask.copy()
    for color in control_colors:
        blocked = blocked_controls | _gen_dilate8(occupied_controls)
        pool = _gen_control_pool(inp, motif_mask, blocked)
        if not pool:
            return False
        r, c = random.choice(pool)
        inp[r, c] = color
        occupied_controls[r, c] = True
    return True


def _gen_attempt():
    H, W, side, colors, fill_color, motif_color = _gen_choose_scene()
    motif_result = _gen_symmetric_motif_patch(H, W)
    if motif_result is None:
        return None
    motif_patch, corner = motif_result

    placed = _gen_place_motif(H, W, side, fill_color, motif_color, motif_patch, corner)
    if placed is None:
        return None
    output, triangle_mask, motif_mask = placed

    inp = output.copy()
    inp[triangle_mask] = 0

    if not _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):
        return None

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, output):
        return None
    return inp


def generate_input():
    for _ in range(_GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 902510d5 input")

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_anchor, crop_bbox, draw_line, find_components, first_free_location, paste

# concepts:
# pixel patterns, expansion, color sequence

# description:
# In the input you will see a grid with a cross pattern. Each pixel in the cross has a different color.
# To make the output, you should expand the cross right/left/top/bottom following the original color sequence of the cross.

def main(input_grid):
    """
    Extend a multicolor cross across the canvas by repeating its color sequences.

    Input structure:
    - The grid contains one connected multicolor cross on a black background.
    - One full row and one full column of the cropped sprite meet at the cross center.
    - The row and column colors form the sequences to repeat.

    Rule:
    - Crop the cross and locate the row and column that pass through its center.
    - Copy the input grid as the output canvas.
    - Paste the center column and center row sequences repeatedly in both directions.

    Key insight:
    - The cross is a seed for periodic extension: its central row and column are reused
      at intervals equal to their own lengths.
    """
    # Plan:
    # 1. Parse the input and create output canvas to draw on top of
    # 2. Extract the vertical and horizontal parts of the cross, and make note of the coordinate of the middle
    # 3. Expand the horizontal part to the right and left, aligned with the middle y coordinate
    # 4. Expand the vertical part to the top and bottom, aligned with the middle x coordinate    

    # 1. Input parsing
    # Extract the cross, which has many colors and so is not monochromatic.
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
    assert len(objects) == 1, "exactly one cross expected"
    obj = objects[0]
    _b = bbox(obj != Color.BLACK)
    assert _b is not None
    cross_r, cross_c = bbox_anchor(_b, anchor="upper left")

    # Create output grid, which we are going to draw on top of, so we start with the input grid
    output_grid = input_grid.copy()
    width, height = input_grid.shape

    # 2. Cross analysis: Extract subsprites, get the middle
    # Extract the horizontal/vertical parts of the cross sprite by figuring out where its middle is (where the horizontal and vertical lines meet)
    _b = bbox(obj != Color.BLACK)
    assert _b is not None
    sprite = crop_bbox(obj, _b)
    cross_width, cross_height = sprite.shape
    # Middle is where they meet
    cross_middle_r = next( r for r in range(cross_width) if np.all(sprite[r, :] != Color.BLACK) )
    cross_middle_c = next( c for c in range(cross_height) if np.all(sprite[:, c] != Color.BLACK) )
    # Extract the horizontal and vertical parts of the cross
    vertical_sprite = sprite[cross_middle_r:cross_middle_r+1, :]
    horizontal_sprite = sprite[:, cross_middle_c:cross_middle_c+1]

    # 3. Expand the horizontal line to the right and left
    r_start, c_start, len_line = cross_r, cross_c + cross_middle_c, cross_width
    for i in range(r_start, width, len_line):
        paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
    for i in range(r_start, -(len_line), -len_line):
        paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
    
    # 4. Expand the vertical line to the top and bottom
    r_start, c_start, len_line = cross_r + cross_middle_r, cross_c, cross_height
    for i in range(c_start, height, len_line):
        paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
    for i in range(c_start, -(len_line), -len_line):
        paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
        
    return output_grid

def generate_input():
    # Generate the background grid
    width, height = np.random.randint(20, 30, size=2)
    grid = np.full((width, height), Color.BLACK)

    # Randomly choose the number of colors
    num_colors = np.random.randint(2, 5)
    colors = np.random.choice(Color.NOT_BLACK, size=num_colors, replace=False)

    # Generate a line with these colors in sequence
    line = np.full((num_colors, 1), Color.BLACK)
    for i in range(num_colors):
        line[i, 0] = colors[i]

    # form a cross pattern randomly
    cross_points = random.randint(0, num_colors - 1)
    sprite = np.full((num_colors, num_colors), Color.BLACK)
    line_t = np.transpose(line)
    paste(sprite, line, 0, cross_points, transparent=Color.BLACK, clip=True)
    paste(sprite, line_t, cross_points, 0, transparent=Color.BLACK, clip=True)

    # Randomly rotate the pattern
    sprite = np.rot90(sprite, k=-(np.random.randint(4)))

    # Randomly place the pattern on the grid
    _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)

    return grid

