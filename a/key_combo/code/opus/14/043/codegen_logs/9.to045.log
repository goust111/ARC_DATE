+def _paint_tiling(
+    out: np.ndarray,
+    region_coords: np.ndarray,
+    template_mask: np.ndarray,
+) -> None:
+    if region_coords.size == 0:
+        return
+    box = _bbox(np.zeros(out.shape, dtype=bool))
+    del box
+    region_mask = np.zeros(out.shape, dtype=bool)
+    region_mask[region_coords[:, 0], region_coords[:, 1]] = True
