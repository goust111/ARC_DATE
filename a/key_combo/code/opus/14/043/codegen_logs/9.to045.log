+    blue_shapes.sort(key=lambda arr: arr.shape[0] * arr.shape[1], reverse=True)
+    for shape in blue_shapes:
+        pos = _place_random(occupied, shape, PADDING)
+        if pos is None:
+            return None
+        _paste(grid, shape, pos[0], pos[1])
