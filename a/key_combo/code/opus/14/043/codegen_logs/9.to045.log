+        if shape is None:
+            return None
+        blue_shapes.append(shape)
+
+    for _ in range(open_count):
+        shape = _shape_with_min_interior(
+            template_box,
+            closed=False,
+            irregular=random.random() < 0.5,
+        )
+        if shape is None:
+            return None
+        blue_shapes.append(shape)
