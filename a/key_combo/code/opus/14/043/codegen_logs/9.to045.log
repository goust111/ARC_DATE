+    if np.array_equal(_naive_bbox_fill(grid), out):
+        return None
+    return {"out": out, "closed": len(closed), "open": len(open_)}
+
+
+def _generate_attempt() -> np.ndarray | None:
+    H = random.randint(21, 29)
+    W = random.randint(21, 29)
