+
+        active = [i for i, s in enumerate(stopped) if not s]
+        active.sort(key=lambda i: (-int(settled[i][:, 0].max()), -int(settled[i][:, 0].min()), int(settled[i][:, 1].min())))
+
+        for idx in active:
+            shifted = settled[idx] + np.array([1, 0], dtype=int)
+            blocked = (
