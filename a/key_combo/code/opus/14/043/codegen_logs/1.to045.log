+import hashlib
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+GREEN = 3
+FLOOR = 5
+
+GRID_H_RANGE = (13, 19)
+GRID_W_RANGE = (13, 19)
+SPRITE_SIZE_RANGE = (3, 6)
+OBJECT_COUNT_RANGE = (4, 5)
