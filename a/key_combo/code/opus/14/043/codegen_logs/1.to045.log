+                or np.any(shifted[:, 1] < 0)
+                or np.any(shifted[:, 1] >= w)
+                or np.any(floor_mask[shifted[:, 0], shifted[:, 1]])
+                or np.any(stopped_mask[shifted[:, 0], shifted[:, 1]])
+            )
+            if blocked:
+                stopped[idx] = True
+                stopped_mask[settled[idx][:, 0], settled[idx][:, 1]] = True
+            else:
