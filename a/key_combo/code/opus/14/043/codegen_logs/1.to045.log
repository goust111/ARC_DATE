+            or np.any(hole[:, 0] == grid.shape[0] - 1)
+            or np.any(hole[:, 1] == 0)
+            or np.any(hole[:, 1] == grid.shape[1] - 1)
+        )
+        if touches_edge:
+            continue
+        adjacent = set()
+        for r, c in hole:
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
+                    label = int(blue_labels[nr, nc])
+                    if label > 0:
+                        adjacent.add(label)
