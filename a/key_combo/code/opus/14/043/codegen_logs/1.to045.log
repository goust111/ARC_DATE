+
+
+def _closed_blue_labels(grid: np.ndarray) -> tuple[np.ndarray, list[np.ndarray], set[int]]:
+    blue_labels = np.zeros(grid.shape, dtype=int)
+    blue_parts = _components(grid == BLUE)
+    for idx, coords in enumerate(blue_parts, start=1):
