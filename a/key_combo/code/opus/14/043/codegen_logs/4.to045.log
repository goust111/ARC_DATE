+def _fits_with_gap(occupied: np.ndarray, sprite: np.ndarray, top: int, left: int, gap: int = 1) -> bool:
+    h, w = occupied.shape
+    sh, sw = sprite.shape
+    if top < 0 or left < 0 or top + sh > h or left + sw > w:
+        return False
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
