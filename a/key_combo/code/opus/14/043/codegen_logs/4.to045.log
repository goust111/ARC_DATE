+        top = np.zeros((height, width), dtype=int)
+        bottom = np.zeros((height, width), dtype=int)
+        for r, c in top_cells:
+            top[r, c] = 1
+        for r, c in bottom_cells:
+            bottom[r, c] = 1
+
+        if _component_sizes(top.astype(bool)) != [int(top.sum())]:
