+                break
+            for rr, cc in reflected:
+                if rr == axis_r or cc == axis_c or not (0 <= rr < h and 0 <= cc < w) or grid[rr, cc] != BLACK:
+                    ok = False
+                    break
+            if not ok:
+                break
+
+            for rr, cc in source:
+                grid[rr, cc] = GREEN
+            placed.append(
+                {
+                    "source": source,
+                    "reflected": reflected,
+                    "hole_count": hole_count,
+                    "quadrant": quadrant,
+                }
+            )
+
+        if not ok:
+            continue
+
+        seen = set()
+        for item in placed:
+            for coord in item["reflected"]:
+                if coord in seen:
+                    ok = False
+                    break
+                seen.add(coord)
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        try:
+            _validate_sample(grid, placed)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid sample")

