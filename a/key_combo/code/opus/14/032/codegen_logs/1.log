+        hole_counts.append(holes)
+    assert 1 in hole_counts and 2 in hole_counts
+
+    by_hole = {1: set(), 2: set()}
+    for item in placed[:4]:
+        by_hole[item["hole_count"]].add(item["quadrant"])
+    assert len(by_hole[1]) == 2 and len(by_hole[2]) == 2
+
+    expected = inp.copy()
+    for item in placed:
+        color = YELLOW if item["hole_count"] == 1 else GRAY
+        for rr, cc in item["reflected"]:
+            assert expected[rr, cc] == BLACK
+            expected[rr, cc] = color
+    actual = main(inp)
+    assert np.array_equal(actual, expected)
+
+    yellow = int(np.sum(actual == YELLOW))
+    gray = int(np.sum(actual == GRAY))
+    assert yellow > 0 and gray > 0
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        h = int(_RNG.integers(17, 24))
+        w = int(_RNG.integers(17, 24))
+        if h % 2 == 0:
+            h += 1
+        if w % 2 == 0:
+            w += 1
+        axis_r = h // 2
+        axis_c = w // 2
+
+        grid = np.zeros((h, w), dtype=int)
+        grid[:, axis_c] = RED
+        grid[axis_r, :] = BLUE
+        if _RNG.random() < 0.5:
+            grid[axis_r, axis_c] = RED
+
+        blocked = np.zeros((h, w), dtype=bool)
+        blocked[:, axis_c] = True
+        blocked[axis_r, :] = True
+
+        quadrants = ["TL", "TR", "BL", "BR"]
+        hole_pattern = [1, 1, 2, 2]
+        _RNG.shuffle(quadrants)
+        _RNG.shuffle(hole_pattern)
+
+        placed = []
+        ok = True
+        for quadrant, hole_count in zip(quadrants, hole_pattern):
+            result = _place_object(grid, blocked, axis_r, axis_c, quadrant, hole_count, _RNG)
+            if result is None:
+                ok = False
+                break
+            grid = result["grid"]
+            blocked = result["blocked"]
+            placed.append(result)
+        if not ok:
+            continue
+
+        if _RNG.random() < 0.45:
+            extra_quadrants = quadrants.copy()
+            _RNG.shuffle(extra_quadrants)
+            for quadrant in extra_quadrants:
+                extra_holes = int(_RNG.choice([1, 2]))
+                result = _place_object(grid, blocked, axis_r, axis_c, quadrant, extra_holes, _RNG)
+                if result is None:
+                    continue
+                grid = result["grid"]
+                blocked = result["blocked"]
+                placed.append(result)
+                break
+
+        try:
+            _validate_sample(grid, placed)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid sample")

