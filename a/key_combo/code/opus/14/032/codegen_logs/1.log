+    h, w = inp.shape
+    assert max(h, w) <= 30
+    axis_r, axis_c = _axis_row_col(inp)
+    assert 0 < axis_r < h - 1
+    assert 0 < axis_c < w - 1
+
+    comps = _components(inp == GREEN)
