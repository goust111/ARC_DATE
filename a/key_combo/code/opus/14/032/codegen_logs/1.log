+            obj_h, obj_w = mask.shape
+            r0, c0 = _slot_origin(h, w, axis_r, axis_c, quadrant, hole_count, obj_h, obj_w, _RNG)
+            source = _coords_from_mask(mask, r0, c0)
+            reflected = _mirror_coords(source, axis_r, axis_c, hole_count)
