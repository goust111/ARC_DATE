+    if side in {"top", "bottom"}:
+        depth = int(rng.integers(1, min(3, h)))
+        width = int(rng.integers(1, min(4, w + 1)))
+        c0 = int(rng.integers(0, w - width + 1))
+        if side == "top":
+            mask[:depth, c0 : c0 + width] = False
+        else:
+            mask[h - depth :, c0 : c0 + width] = False
