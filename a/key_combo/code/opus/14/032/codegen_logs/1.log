+    axis_r = max(row_candidates)[1]
+
+    col_candidates = []
+    for c in range(w):
+        col = g[:, c]
+        if set(map(int, np.unique(col))) <= {BLUE, RED}:
+            red_count = int(np.sum(col == RED))
+            blue_count = int(np.sum(col == BLUE))
