+
+def _count_enclosed_black_holes(crop):
+    black = np.asarray(crop == BLACK, dtype=bool)
+    h, w = black.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not black[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_border = False
+            while stack:
+                cr, cc = stack.pop()
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
