+                break
+            if not placed_here:
+                ok = False
+                break
+
+        if not ok:
+            continue
+
+        seen = set()
+        for item in placed:
+            for coord in item["reflected"]:
+                if coord in seen:
+                    ok = False
+                    break
+                seen.add(coord)
+            if not ok:
