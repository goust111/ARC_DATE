+            h = int(rng.integers(5, 8))
+            w = int(rng.integers(5, 8))
+        else:
+            h = int(rng.integers(5, 8))
+            w = int(rng.integers(6, 9))
+
+        mask = np.ones((h, w), dtype=bool)
