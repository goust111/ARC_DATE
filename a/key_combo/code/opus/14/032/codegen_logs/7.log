def _place_bar(canvas: np.ndarray, patch: np.ndarray) -> tuple[int, int]:
    r, c = random_free_location(
        canvas,
        patch,
        transparent=BG,
        padding=PLACEMENT_PADDING,
        padding_connectivity=PLACEMENT_CONNECTIVITY,
    )
    paste(canvas, patch, r, c)
