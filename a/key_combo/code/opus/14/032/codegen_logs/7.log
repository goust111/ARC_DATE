+import numpy as np
+
+
+BG = 0
+GREY = 5
+TOKEN = 9
+INDICATOR_COLORS = (1, 2, 3, 4)
+BOARD_SIZE = 17
+BLOCK_SIZE = 5
+STRIDE = 6
+TOKEN_SIZE = 3
+MAX_RETRIES = 600
+
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+SOLID_PATCH = {(r, c) for r in range(3) for c in range(3)}
+X_PATCH = {(0, 0), (0, 2), (1, 1), (2, 0), (2, 2)}
+DIAMOND_PATCH = {(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)}
+CARDINAL_PATCH = {(0, 1), (1, 0), (1, 2), (2, 1)}
+
+SHAPE_TO_PATCH = {
+    "solid": SOLID_PATCH,
+    "x": X_PATCH,
+    "diamond": DIAMOND_PATCH,
