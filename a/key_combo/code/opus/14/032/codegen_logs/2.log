+def _build_full_shape() -> tuple[np.ndarray, tuple[int, int], list[int]]:
+    radii = _choose_radii()
+    outer = radii[-1]
+    outer_tabs = random.randint(0, 2)
+    local_size = 2 * (outer + outer_tabs) + 1
+    center = (local_size // 2, local_size // 2)
+    shape_cells: set[tuple[int, int]] = set()
+    for radius in radii:
