+    bbox_r, bbox_c = _bbox_center(grid == BLUE)
+    dist = (center[0] - bbox_r) ** 2 + (center[1] - bbox_c) ** 2
+    score = 8 * same + 2 * fillable - 30 * off - 60 * conflict
+    return score, same, -off, -conflict, -dist
