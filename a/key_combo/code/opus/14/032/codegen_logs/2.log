+    cavity_components: list[np.ndarray],
+    marker_positions: set[tuple[int, int]],
+    center: tuple[int, int],
+) -> bool:
+    if len(cavity_components) < 2 or not marked_cavities or len(marked_cavities) >= len(cavity_components):
