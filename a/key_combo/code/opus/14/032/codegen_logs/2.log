+def _bbox_center(mask: np.ndarray) -> tuple[float, float]:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return (r0 + r1) / 2.0, (c0 + c1) / 2.0
