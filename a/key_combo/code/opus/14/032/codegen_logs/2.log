+    center = _detect_rotation_center(g)
+    out = _complete_shape(g, center)
+    shape = (out == BLUE) | (out == RED)
+    passable = (out == BLACK) | (out == ORANGE)
+    exterior = _flood_exterior(passable)
+    closed = passable & ~exterior
