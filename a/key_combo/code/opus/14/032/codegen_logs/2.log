    shape: contiguous vertical line in a single column, length 3-6
  yellow_object:
    connectivity: 8-connected, one per red segment, touching axis on one side (left or right)
    row_span: identical to its red segment's row span
    width: 2-5 cols, density 40-75% within bounding box
    shape: irregular blob, not necessarily adjacent on every segment row
  marker:
    count: exactly 1 per segment, located in the reflected footprint of the yellow object
    color: unique non-{BLACK, RED, YELLOW} color per segment; all markers use distinct colors
    position: distance 2-4 cols from axis; rest of reflected footprint is BLACK
  isolation: full extents (yellow + red + reflected) of all segments are non-overlapping
  transform: reflect yellow object across red axis column, paint reflected copy with marker color

generation_strategy:
