+def _score_center(grid: np.ndarray, center: tuple[float, float]) -> tuple[int, int, int, int, float]:
+    blues = np.argwhere(grid == BLUE)
+    if blues.size == 0:
+        return (-10**9, 0, 0, 0, 0.0)
