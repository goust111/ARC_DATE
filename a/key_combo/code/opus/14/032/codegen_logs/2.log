+            blue_shape=blue_shape,
+            marked_cavities=marked_cavities,
+            cavity_components=cavity_components,
+            marker_positions=marker_positions,
+            center=center,
+        ):
+            return input_grid
+
+    raise RuntimeError("generate_input: failed to construct a valid sample")

