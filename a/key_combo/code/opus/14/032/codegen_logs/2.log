+
+def _rotate_coord(r: int, c: int, center: tuple[float, float], turns: int) -> tuple[int, int]:
+    rr = float(r) - center[0]
+    cc = float(c) - center[1]
+    turns %= 4
+    for _ in range(turns):
+        rr, cc = cc, -rr
+    return int(round(rr + center[0])), int(round(cc + center[1]))
+
