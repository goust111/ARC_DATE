+    exterior_before = _flood_exterior(passable_before)
+    if not all(exterior_before[r, c] for r, c in marker_positions):
+        return False
+
+    exterior_after = _flood_exterior(~full_shape)
+    if any(exterior_after[r, c] for r, c in marker_positions):
+        return False
