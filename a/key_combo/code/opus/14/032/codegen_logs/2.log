+    return cells
+
+
+def _axis_tabs(center: tuple[int, int], radius: int, length: int) -> set[tuple[int, int]]:
+    cr, cc = center
+    cells: set[tuple[int, int]] = set()
+    for step in range(1, length + 1):
+        cells.add((cr - radius - step, cc))
+        cells.add((cr + radius + step, cc))
+        cells.add((cr, cc - radius - step))
+        cells.add((cr, cc + radius + step))
+    return cells
