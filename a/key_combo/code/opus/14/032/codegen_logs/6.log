+
+        tiled = _tile_cell(tile, cell_h, cell_w)
+        out[r0 : r1 + 1, c0 : c1 + 1] = tiled
+        inp[r0 : r1 + 1, c0 : c1 + 1] = tiled
+
+        missing = []
