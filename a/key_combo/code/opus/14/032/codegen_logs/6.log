+                    continue
+                choices.append(tile)
+    if not choices:
+        return None
+    return random.choice(choices).copy()
+
+
+def _choose_missing_positions(cell_h: int, cell_w: int, tile_h: int, tile_w: int) -> list[tuple[int, int]]:
+    residues: dict[tuple[int, int], list[tuple[int, int]]] = {}
