+            inner_r1 = r1 - 1
+            inner_c0 = c0 + 1
+            inner_c1 = c1 - 1
+            if inner_r0 <= inner_r1 and inner_c0 <= inner_c1:
+                boxes.append((inner_r0, inner_c0, inner_r1, inner_c1))
