+_TILE_CACHE: dict[tuple[int, int], list[np.ndarray]] = {}
+
+
+def _has_adjacent_pair(values: np.ndarray, color: int) -> bool:
+    return bool(np.any((values[:-1] == color) & (values[1:] == color)))
