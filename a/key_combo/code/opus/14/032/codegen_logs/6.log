+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+PINK = 6
+
+MAX_GENERATION_ATTEMPTS = 400
+_TILE_CACHE: dict[tuple[int, int], list[np.ndarray]] = {}
+
