+    best = h * w
+    for row_period in range(1, h + 1):
+        for col_period in range(1, w + 1):
+            ok = True
+            for r in range(h):
+                for c in range(w):
+                    if int(tile[r, c]) != int(tile[r % row_period, c % col_period]):
