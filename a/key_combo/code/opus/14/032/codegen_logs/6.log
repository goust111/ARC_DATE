    off_rows = [r for r in range(box_h) if r not in set(marked_rows)]
    off_total = len(off_rows) * len(marked_cols)
    off_blue = int(np.count_nonzero(patch_in[np.ix_(off_rows, marked_cols)] == _GEN_BLUE))
