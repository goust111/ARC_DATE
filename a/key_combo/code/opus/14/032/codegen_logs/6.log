+
+        sig = _tile_signature(tile)
+        if sig not in signatures:
+            signatures.add(sig)
+            distinct_ensured += 1
+
+        spec["tile"] = tile
+        spec["missing"] = missing
+        cell_specs.append(spec)
+
+    if not _validate_instance(inp, out, line_rows, line_cols, cell_specs, gap_mask):
+        return None
+    return inp
+
