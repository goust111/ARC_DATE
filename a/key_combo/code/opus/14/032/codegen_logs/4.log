+        valid = True
+        for rr, cc in arms:
+            grey_neighbors = 0
+            for dr, dc in DIRS.values():
+                nr, nc = rr + dr, cc + dc
+                if _in_bounds(g.shape, nr, nc) and g[nr, nc] == GREY:
+                    grey_neighbors += 1
