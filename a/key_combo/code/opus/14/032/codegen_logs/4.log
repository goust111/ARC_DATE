+        rays = _extract_rays(g)
+    planned: dict[tuple[int, int], list[int]] = defaultdict(list)
+    for ray_id, ray in enumerate(rays):
+        dr, dc = ray["direction"]
+        rr = ray["marker"][0] + dr
+        cc = ray["marker"][1] + dc
+        while _in_bounds(g.shape, rr, cc):
+            if g[rr, cc] == BLACK:
+                planned[(rr, cc)].append(ray_id)
+            rr += dr * ray["period"]
+            cc += dc * ray["period"]
+    return planned
