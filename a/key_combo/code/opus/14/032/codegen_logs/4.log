+        _place_plus(grid, center_b)
+
+        ray_colors: dict[tuple[tuple[int, int], str], int] = {
+            (center_a, "down"): a_down_color,
+            (center_b, "left"): b_left_color,
+        }
+        if two_intersections:
+            ray_colors[(center_a, "right")] = a_right_color
