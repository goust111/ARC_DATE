+    out = g.copy()
+    rays = _extract_rays(g)
+    planned = _planned_coverage(g, rays)
+    for cell, ray_ids in planned.items():
+        if len(ray_ids) >= 2:
+            out[cell] = YELLOW
+        else:
+            ray = rays[ray_ids[0]]
+            out[cell] = ray["color"]
+    return out
