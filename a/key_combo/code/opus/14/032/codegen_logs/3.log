+    c_lo = max(3, w // 2 - sw // 2 - 1)
+    c_hi = min(w - sw - 4, w // 2 - sw // 2 + 1)
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    r0 = rng.randint(r_lo, r_hi)
+    c0 = rng.randint(c_lo, c_hi)
+    return [(r0 + r, c0 + c) for r, c in shape]
