+    row_runs = _row_runs(np.any(g != BG, axis=1))
+    assert len(row_runs) == 2
+    (top_r0, top_r1), (graph_r0, graph_r1) = row_runs
+    top = g[top_r0 : top_r1 + 1]
+    graph = g[graph_r0 : graph_r1 + 1]
