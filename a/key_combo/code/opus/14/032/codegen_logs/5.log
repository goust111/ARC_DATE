+    assert len(terminals) == 2
+    terminals.sort(key=lambda node: (node["bbox"][1], node["bbox"][0]))
+    left, right = terminals
+    if left["bbox"][1] == right["bbox"][1]:
+        terminals.sort(key=lambda node: (node["bbox"][0], node["bbox"][1]))
+        left, right = terminals
