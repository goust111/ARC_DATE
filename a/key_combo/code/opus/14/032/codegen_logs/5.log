+
+
+def _legend_templates(top: np.ndarray) -> dict[int, np.ndarray]:
+    swatches = _find_solid_blocks(top, SWATCH_ORDER)
+    assert len(swatches) == 3
+    swatches.sort(key=lambda block: (block["bbox"][1], block["bbox"][0]))
