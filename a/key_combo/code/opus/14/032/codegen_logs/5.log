+    templates = _legend_templates(top)
+    nodes, adj, _edge_pixels = _graph_from_region(graph)
+    start, goal = _ordered_terminals(nodes)
+    node_path, _edge_path, _ = _unique_shortest_path(adj, int(start), int(goal))
