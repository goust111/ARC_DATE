+    mapping: dict[int, np.ndarray] = {}
+    for swatch in swatches:
+        r0, c0, r1, c1 = swatch["bbox"]
+        assert r0 == 0 and r1 == 1
+        t0 = c1 + 2
+        t1 = t0 + TEMPLATE_SIZE
+        assert t1 <= top.shape[1]
+        patch = top[:, t0:t1]
+        assert patch.shape == (TEMPLATE_SIZE, TEMPLATE_SIZE)
+        mask = patch == TRACK
