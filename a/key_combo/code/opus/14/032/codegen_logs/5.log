+            c0 = min(ac, bc) + NODE_SIZE
+            c1 = max(ac, bc)
+            grid[row, c0:c1] = TRACK
+        else:
+            col = ac + 1
+            r0 = min(ar, br) + NODE_SIZE
+            r1 = max(ar, br)
