+        prev, edge_id = pred_options[0]
+        edge_path.append(int(edge_id))
+        node_path.append(int(prev))
+        cur = int(prev)
+    node_path.reverse()
+    edge_path.reverse()
+    return node_path, edge_path, int(dist[int(goal)])
