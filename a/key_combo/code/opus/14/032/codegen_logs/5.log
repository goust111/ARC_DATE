    stencil_start = count * SWATCH_STRIDE
    for i, mask in enumerate(stencils):
        patch = np.where(mask, NEUTRAL_COLOR, BACKGROUND)
        paste(grid, patch, 0, stencil_start + i * (size + STENCIL_GAP))
