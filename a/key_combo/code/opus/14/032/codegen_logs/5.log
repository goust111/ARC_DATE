+def _count_simple_paths(adj: dict[int, set[int]], start: int, goal: int, limit: int = 3) -> int:
+    count = 0
+    stack = [(int(start), {int(start)})]
+    while stack:
+        node, seen = stack.pop()
+        if node == int(goal):
+            count += 1
+            if count >= limit:
+                return count
+            continue
+        for nxt in adj[node]:
+            if int(nxt) not in seen:
+                stack.append((int(nxt), seen | {int(nxt)}))
+    return count
+
