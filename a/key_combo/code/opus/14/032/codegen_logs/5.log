+def _unique_shortest_path(
+    adj: dict[int, list[tuple[int, int]]],
+    start: int,
+    goal: int,
+) -> tuple[list[int], list[int], int]:
+    dist, count = _bfs_shortest(adj, int(start))
+    assert int(goal) in dist and int(count[int(goal)]) == 1
+
+    node_path = [int(goal)]
+    edge_path: list[int] = []
+    cur = int(goal)
+    while cur != int(start):
+        pred_options = [
+            (int(v), int(edge_id))
+            for v, edge_id in adj[cur]
