+def _bfs_shortest(adj: dict[int, list[tuple[int, int]]], start: int) -> tuple[dict[int, int], dict[int, int]]:
+    dist = {int(start): 0}
+    count = {int(start): 1}
+    q = deque([int(start)])
+    while q:
+        u = int(q.popleft())
+        for v, _edge_id in adj[u]:
+            nd = int(dist[u]) + 1
+            if int(v) not in dist:
