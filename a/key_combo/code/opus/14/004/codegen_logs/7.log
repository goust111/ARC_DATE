+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (11, 16)
+GRID_W_RANGE = (11, 16)
+PATTERN_SIZES = [(3, 3), (3, 4), (4, 3), (4, 4), (5, 3), (3, 5), (5, 4), (4, 5), (5, 5)]
+GREY_COUNTS = (2, 3, 4)
+PATTERN_CORNERS = ("tl", "tr", "bl", "br")
