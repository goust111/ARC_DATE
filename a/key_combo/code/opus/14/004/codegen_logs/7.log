+    block_h, block_w = src.shape
+
+    outside = np.ones(g.shape, dtype=bool)
+    outside[src_r0 : src_r1 + 1, src_c0 : src_c1 + 1] = False
+    sprite_colors = [int(c) for c in np.unique(g[outside]) if int(c) != BLACK]
