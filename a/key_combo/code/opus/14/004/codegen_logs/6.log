+    out = g.copy()
+    active = _active_cells(g)
+
+    active_by_row: list[set[int]] = [set() for _ in range(g.shape[0])]
+    for r, c in active:
+        active_by_row[r].add(c)
+
+    for r, cols in enumerate(active_by_row):
+        if not cols:
+            continue
