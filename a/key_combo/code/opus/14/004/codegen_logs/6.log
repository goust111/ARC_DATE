+def _band_starts(width: int, turn_counts: list[int]) -> list[int] | None:
+    band_widths = [turns + 1 for turns in turn_counts]
+    min_gaps = [1] + [2] * (len(turn_counts) - 1) + [1]
+    min_total = sum(band_widths) + sum(min_gaps)
