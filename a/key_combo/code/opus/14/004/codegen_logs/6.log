+    available = [c for c in range(width) if c not in fixed]
+    if len(available) < 5:
+        return None
+
+    for _ in range(ROW_ATTEMPTS):
+        main_color = random.choice(SAFE_ROW_COLORS)
+        other_choices = [color for color in SAFE_ROW_COLORS if color != main_color]
