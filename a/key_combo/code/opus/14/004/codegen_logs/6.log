+def _route_active_cells(height: int, start_col: int, turn_rows_desc: list[int]) -> list[tuple[int, int]]:
+    turn_rows = set(turn_rows_desc)
+    cells: list[tuple[int, int]] = []
+    r = height - 1
+    c = start_col
+    while r > 0:
+        next_r = r - 1
+        if next_r in turn_rows:
+            c += 1
+            r = next_r
+            cells.append((r, c))
+        else:
+            r = next_r
+            cells.append((r, c))
+    return cells
+
+
+def _generate_row(
+    width: int,
+    fixed: dict[int, int],
+    active_cols: list[int],
+    require_tie: bool,
