    if along_dims is None:
        return None

    frame_along = sum(along_dims) + FRAME_MARGIN_DIMS
    min_cross = max(FRAME_DIM_MIN, cross_dim + 1)
    possible_cross = [v for v in range(min_cross, FRAME_DIM_MAX + 1) if v != frame_along]
