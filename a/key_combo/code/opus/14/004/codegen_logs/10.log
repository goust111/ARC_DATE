+    for sp in placements:
+        sprite_mask = np.asarray(sp["mask"], dtype=bool)
+        top = int(sp["top"])
+        left = int(sp["left"])
+        rows, cols = np.where(sprite_mask)
+        mask[top + rows, left + cols] = True
+    return mask
+
