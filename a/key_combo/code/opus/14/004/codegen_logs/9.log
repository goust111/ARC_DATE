+
+
+def _extract_pieces(grid: np.ndarray, frame_box: tuple[int, int, int, int]) -> list[dict]:
+    fr0, fc0, fr1, fc1 = frame_box
+    pieces = []
+    for comp in _find_foreground_components(grid, connectivity=8):
+        colors = comp["colors"]
+        if colors == [GREEN]:
+            continue
+        if GREEN not in colors or len(colors) != 2:
