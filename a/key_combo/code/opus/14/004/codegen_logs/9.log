+            if out[r, c] != BLACK:
+                continue
+            if any(_in_bounds(out.shape, r + dr, c + dc) and out[r + dr, c + dc] == GREEN for dr, dc in ORTHOGONALS):
+                continue
+            candidates = []
+            for piece in per_piece_green:
+                if any(
+                    _in_bounds(out.shape, r + dr, c + dc) and piece["green"][r + dr, c + dc]
+                    for dr, dc in DIAGONALS
