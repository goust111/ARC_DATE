+        placements: list[dict] = []
+        occupied_slot: set[tuple[int, int]] = set()
+        ok = True
+        for mask in random.sample(masks, len(masks)):
+            h, w = mask.shape
+            options = []
+            for r0 in range(1, crop_h - h - 1):
+                for c0 in range(1, crop_w - w - 1):
