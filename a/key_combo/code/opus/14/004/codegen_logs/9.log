+        r0, c0 = random.choice(options)
+        _paste(canvas, patch, r0, c0, transparent=BLACK)
+
+    try:
+        out, meta = _solve(canvas, return_meta=True)
+    except Exception:
+        return None
+    if meta["halo_pixels"] == 0:
+        return None
+    if want_conflict and meta["conflict_pixels"] == 0:
+        return None
+    if max(out.shape) > 30:
+        return None
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _build_candidate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

