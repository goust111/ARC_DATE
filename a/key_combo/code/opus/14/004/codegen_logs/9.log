        remaining = [mask for mask in mod.MASK_LIBRARY if all(mask is not picked for picked in masks)]
        masks.extend(random.sample(remaining, count - 1))
    else:
        masks = random.sample(mod.MASK_LIBRARY, count)
    placed = mod._place_slots(crop_h, crop_w, masks)
    if placed is None:
        stats['place_slots']=stats.get('place_slots',0)+1; continue
    frame_crop, slot_placements = placed
    pieces = mod._random_piece_variants(slot_placements, k, [1,2,4,6,7,8,9])
    total_piece_width = sum(piece.shape[1] for piece in pieces) + len(pieces) + 2
    total_piece_height = max(piece.shape[0] for piece in pieces) + 2
    canvas_h = min(30, max(18, crop_h + total_piece_height + 4 + random.randint(0, 4)))
    canvas_w = min(30, max(18, crop_w + total_piece_width + 4 + random.randint(0, 4)))
    canvas = np.zeros((canvas_h, canvas_w), dtype=int)
    frame_top = random.randint(1, canvas_h - crop_h - 1)
    frame_left = random.randint(1, canvas_w - crop_w - 1)
    canvas[frame_top : frame_top + crop_h, frame_left : frame_left + crop_w] = frame_crop
    fail=False
    for index in random.sample(list(range(len(pieces))), len(pieces)):
        patch = pieces[index]
        options=[]
        for r0 in range(canvas_h - patch.shape[0] + 1):
            for c0 in range(canvas_w - patch.shape[1] + 1):
                if frame_top - 1 <= r0 + patch.shape[0] - 1 and r0 <= frame_top + crop_h and frame_left - 1 <= c0 + patch.shape[1] - 1 and c0 <= frame_left + crop_w:
                    continue
                if mod._can_place_patch(canvas, patch, r0, c0):
                    options.append((r0,c0))
        if not options:
            stats['piece_place']=stats.get('piece_place',0)+1
            fail=True
            break
        r0,c0=random.choice(options)
        mod._paste(canvas, patch, r0, c0, transparent=0)
    if fail:
        continue
    try:
        out, meta = mod._solve(canvas, return_meta=True)
    except Exception as e:
        key='solve:'+type(e).__name__+':'+str(e)
        stats[key]=stats.get(key,0)+1
        continue
    if meta['halo_pixels']==0:
        stats['no_halo']=stats.get('no_halo',0)+1
        continue
    if want_conflict and meta['conflict_pixels']==0:
        stats['need_conflict']=stats.get('need_conflict',0)+1
        continue
    print('success',meta,'k',k,'count',count,'in',canvas.shape,'out',out.shape)
    break
else:
    print(stats)
