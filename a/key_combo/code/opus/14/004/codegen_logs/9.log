+    h, w = mask.shape
+    shell = {
+        (rr, cc)
+        for rr in range(r0 - 1, r0 + h + 1)
+        for cc in range(c0 - 1, c0 + w + 1)
+        if (rr, cc) not in cells
+    }
+    return cells, shell
