+    [".#.", "###", ".#."],
+    [".#.", "###", ".#.", ".#."],
+    ["##.", "###", ".#.", ".#."],
+    [".#.", "##.", "###", ".#."],
+    ["##.", "###", "##."],
+    [".#.", "###", ".#.", "##."],
