+    out = []
+    for coords in _components(mask, connectivity=connectivity):
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+        rr = coords[:, 0] - r0
+        cc = coords[:, 1] - c0
+        patch[rr, cc] = grid[coords[:, 0], coords[:, 1]]
