+                                "patch": patch,
+                                "mask": mask,
+                                "inner": piece["inner"],
+                                "slot_area": slot["area"],
+                            }
+                        )
+            if not slot_cands:
+                candidate_lists = []
+                break
+            candidate_lists.append(slot_cands)
+        if not candidate_lists:
+            continue
+        order = sorted(range(len(slots)), key=lambda i: len(candidate_lists[i]))
+        used: set[int] = set()
+        current: list[dict | None] = [None] * len(slots)
+
+        def backtrack(pos: int) -> None:
+            if len(solutions) > 1:
+                return
+            if pos == len(order):
