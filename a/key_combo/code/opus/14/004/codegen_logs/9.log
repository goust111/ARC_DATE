+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ORTHOGONALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SHAPE_PATTERNS = [
+    [".#.", "###", ".#."],
+    [".#.", "###", ".#.", ".#."],
+    ["##.", "###", ".#.", ".#."],
+    [".#.", "##.", "###", ".#."],
+    ["##.", "###", "##."],
+    [".#.", "###", ".#.", "##."],
+]
