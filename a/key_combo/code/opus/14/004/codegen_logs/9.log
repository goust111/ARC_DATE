+    moat = set()
+    for r, c in cells:
+        for dr, dc in ORTHOGONALS:
+            p = (r + dr, c + dc)
+            if p not in cells:
+                moat.add(p)
+    return cells, moat
+
+
+def _place_slots(crop_h: int, crop_w: int, masks: list[np.ndarray]) -> tuple[np.ndarray, list[dict]] | None:
