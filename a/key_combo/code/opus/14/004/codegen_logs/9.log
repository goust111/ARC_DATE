+                conflict_pixels += 1
+            chosen = min(candidates, key=lambda item: item["area"])
+            out[r, c] = int(chosen["inner"])
+            halo_pixels += 1
+
+    if return_meta:
+        return out, {"k": k, "halo_pixels": halo_pixels, "conflict_pixels": conflict_pixels}
+    return out
