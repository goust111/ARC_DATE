+
+
+def _shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:
+    keys = []
+    for rot in range(4):
+        rm = np.rot90(mask, rot)
+        for vm in (rm, np.fliplr(rm)):
+            keys.append((vm.tobytes(), tuple(map(int, vm.shape))))
