+        for c in range(k, out_w - k):
+            if out[r, c] != BLACK:
+                continue
+            if any(_in_bounds(out.shape, r + dr, c + dc) and out[r + dr, c + dc] == GREEN for dr, dc in ORTHOGONALS):
