+        pieces.append({"patch": comp["patch"], "mask": comp["mask"], "inner": int(inner)})
+    assert 2 <= len(pieces) <= 3, "expected 2-3 external pieces"
+    return pieces
+
+
+def _match_slots_and_pieces(slots: list[dict], pieces: list[dict]) -> tuple[int, list[dict]]:
