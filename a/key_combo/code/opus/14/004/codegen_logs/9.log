+    out_h, out_w = frame_crop.shape[0] * k, frame_crop.shape[1] * k
+    out = np.zeros((out_h, out_w), dtype=int)
+    out[:k, :] = GREEN
+    out[-k:, :] = GREEN
+    out[:, :k] = GREEN
+    out[:, -k:] = GREEN
+
+    per_piece_green = []
+    for slot, match in zip(slots, matching):
+        top = slot["r0"] * k
+        left = slot["c0"] * k
