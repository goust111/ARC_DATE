+def _pattern_to_mask(rows: list[str]) -> np.ndarray:
+    grid = np.array([[ch == "#" for ch in row] for row in rows], dtype=bool)
+    coords = np.argwhere(grid)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
