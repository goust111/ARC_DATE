+                for c0 in range(1, crop_w - w - 1):
+                    cells, moat = _slot_with_offset(mask, r0, c0)
+                    if any(r <= 0 or c <= 0 or r >= crop_h - 1 or c >= crop_w - 1 for r, c in cells | moat):
+                        continue
+                    if cells & occupied_slot:
+                        continue
+                    options.append((r0, c0, cells, moat))
+            if not options:
+                ok = False
+                break
+            r0, c0, cells, moat = random.choice(options)
+            placements.append({"mask": mask, "r0": r0, "c0": c0, "cells": cells, "moat": moat})
+            occupied_slot |= cells
+        if not ok:
+            continue
+
+        grid = np.zeros((crop_h, crop_w), dtype=int)
+        grid[0, :] = GREEN
+        grid[-1, :] = GREEN
+        grid[:, 0] = GREEN
+        grid[:, -1] = GREEN
+        for item in placements:
+            for rr, cc in item["moat"]:
+                grid[rr, cc] = GREEN
+
+        black_comps = _components(grid == BLACK, connectivity=4)
+        if len(black_comps) != len(masks) + 1:
+            continue
+        areas = sorted(len(comp) for comp in black_comps)
+        if areas[-1] <= areas[-2]:
+            continue
+        placements.sort(key=lambda item: (item["r0"], item["c0"]))
+        return grid, placements
+    return None
+
+
+def _random_piece_variants(slot_placements: list[dict], k: int, palette: list[int]) -> list[np.ndarray]:
+    colors = random.sample(palette, len(slot_placements))
+    pieces = []
+    for slot, color in zip(slot_placements, colors):
+        mask = slot["mask"]
+        rot = random.randrange(4)
+        oriented = np.rot90(mask, rot)
+        if random.random() < 0.5:
+            oriented = np.fliplr(oriented)
+        piece = _piece_from_slot_mask(oriented, k, color)
+        pieces.append(piece)
+    return pieces
+
+
+def _can_place_patch(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + h > canvas.shape[0] or c0 + w > canvas.shape[1]:
+        return False
+    occ = patch != BLACK
+    rs = range(max(0, r0 - 1), min(canvas.shape[0], r0 + h + 1))
+    cs = range(max(0, c0 - 1), min(canvas.shape[1], c0 + w + 1))
+    if np.any(canvas[np.ix_(list(rs), list(cs))] != BLACK):
+        return False
+    return not np.any(canvas[r0 : r0 + h, c0 : c0 + w][occ] != BLACK)
+
+
+def _build_candidate() -> np.ndarray | None:
+    k = random.choice([2, 3])
+    crop_h = random.randint(8, 11 if k == 2 else 10)
+    crop_w = random.randint(8, 11 if k == 2 else 10)
+    if crop_h * k > 30 or crop_w * k > 30:
+        return None
+
+    want_conflict = random.random() < 0.2
+    count = 3 if k == 2 and min(crop_h, crop_w) >= 10 and random.random() < 0.25 else 2
+    if k == 2:
+        tall = [mask for mask in MASK_LIBRARY if 4 in mask.shape]
+        masks = [random.choice(tall)]
+        remaining = [mask for mask in MASK_LIBRARY if all(mask is not picked for picked in masks)]
+        masks.extend(random.sample(remaining, count - 1))
+    else:
+        masks = random.sample(MASK_LIBRARY, count)
+    placed = _place_slots(crop_h, crop_w, masks)
+    if placed is None:
+        return None
+    frame_crop, slot_placements = placed
+
+    piece_palette = [1, 2, 4, 6, 7, 8, 9]
+    pieces = _random_piece_variants(slot_placements, k, piece_palette)
+
+    total_piece_width = sum(piece.shape[1] for piece in pieces) + len(pieces) + 2
+    total_piece_height = max(piece.shape[0] for piece in pieces) + 2
+    canvas_h = min(30, max(18, crop_h + total_piece_height + 4 + random.randint(0, 4)))
+    canvas_w = min(30, max(18, crop_w + total_piece_width + 4 + random.randint(0, 4)))
+    canvas = np.zeros((canvas_h, canvas_w), dtype=int)
+
+    frame_top = random.randint(1, canvas_h - crop_h - 1)
+    frame_left = random.randint(1, canvas_w - crop_w - 1)
+    canvas[frame_top : frame_top + crop_h, frame_left : frame_left + crop_w] = frame_crop
+
+    piece_order = list(range(len(pieces)))
+    random.shuffle(piece_order)
+    for index in piece_order:
+        patch = pieces[index]
+        options = []
+        for r0 in range(canvas_h - patch.shape[0] + 1):
+            for c0 in range(canvas_w - patch.shape[1] + 1):
+                if frame_top - 1 <= r0 + patch.shape[0] - 1 and r0 <= frame_top + crop_h and frame_left - 1 <= c0 + patch.shape[1] - 1 and c0 <= frame_left + crop_w:
+                    continue
+                if _can_place_patch(canvas, patch, r0, c0):
+                    options.append((r0, c0))
+        if not options:
+            return None
+        r0, c0 = random.choice(options)
+        _paste(canvas, patch, r0, c0, transparent=BLACK)
+
+    try:
+        out, meta = _solve(canvas, return_meta=True)
+    except Exception:
+        return None
+    if meta["halo_pixels"] == 0:
+        return None
+    if want_conflict and meta["conflict_pixels"] == 0:
+        return None
+    if max(out.shape) > 30:
+        return None
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid = _build_candidate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

