随机拒样的成本太高了。我改用更工程化的做法：先离线找到若干个稳定有效的框内槽位模板，再让 `generate_input()` 在这些有效模板上随机颜色、朝向、缩放和外部散布位置。这样既保留多样性，也能把 100 次自检速度拉回到可接受范围。
exec
/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import random, numpy as np
p=Path('/home/lixinyu/snap/a/key_combo/code/opus/14/004/9.py')
mod=SourceFileLoader('m15',str(p)).load_module()

for t in range(500):
    k = random.choice([2,3])
    crop_h = random.randint(8, 11 if k == 2 else 10)
    crop_w = random.randint(8, 11 if k == 2 else 10)
    if crop_h * k > 30 or crop_w * k > 30:
        continue
    count = 2
    if k == 2:
        tall = [mask for mask in mod.MASK_LIBRARY if 4 in mask.shape]
        masks = [random.choice(tall)]
        remaining = [mask for mask in mod.MASK_LIBRARY if all(mask is not picked for picked in masks)]
        masks.extend(random.sample(remaining, count - 1))
    else:
        masks = random.sample(mod.MASK_LIBRARY, count)
    placed = mod._place_slots(crop_h, crop_w, masks)
    if placed is None:
        continue
    frame_crop, slot_placements = placed
    pieces = mod._random_piece_variants(slot_placements, k, [1,2,4,6,7,8,9])
    total_piece_width = sum(piece.shape[1] for piece in pieces) + len(pieces) + 2
    total_piece_height = max(piece.shape[0] for piece in pieces) + 2
    canvas_h = min(30, max(18, crop_h + total_piece_height + 4))
    canvas_w = min(30, max(18, crop_w + total_piece_width + 4))
    canvas = np.zeros((canvas_h, canvas_w), dtype=int)
    frame_top = 1
    frame_left = 1
    canvas[frame_top:frame_top+crop_h, frame_left:frame_left+crop_w] = frame_crop
    cur_c = crop_w + 3
    for patch in pieces:
        if cur_c + patch.shape[1] > canvas_w:
            break
        r0 = 1
        mod._paste(canvas, patch, r0, cur_c, transparent=0)
        cur_c += patch.shape[1] + 1
    else:
        try:
            out, meta = mod._solve(canvas, return_meta=True)
        except Exception:
            continue
        if meta['halo_pixels'] == 0:
            continue
        print('SUCCESS')
        print('k', k, 'crop', crop_h, crop_w, 'meta', meta)
        print('slot placements', [(s['r0'], s['c0'], s['mask'].shape, int(s['mask'].sum())) for s in slot_placements])
        print('frame crop')
        print('\\n'.join(''.join(str(x) for x in row) for row in frame_crop))
        break
