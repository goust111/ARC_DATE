+                                "patch": patch,
+                                "mask": mask,
+                                "inner": piece["inner"],
+                                "slot_area": slot["area"],
+                            }
+                        )
+            if not slot_cands:
+                candidate_lists = []
+                break
+            candidate_lists.append(slot_cands)
