+def _ranges_from_sizes(sizes: list[int]) -> list[tuple[int, int]]:
+    ranges: list[tuple[int, int]] = []
+    start = 0
+    for i, size in enumerate(sizes):
+        ranges.append((start, start + size))
+        start += size
+        if i != len(sizes) - 1:
+            start += 1
+    return ranges
