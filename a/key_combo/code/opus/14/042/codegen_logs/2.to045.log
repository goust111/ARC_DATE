0095: 
0096:     # Each triangle emits a projectile. The visible effect is at the collision location only.
0097:     # From training, the collision location is 5 cells away from the apex in its emission direction.
0098:     dest_to_shooters: dict[tuple[int, int], list[int]] = {}
0099:     for cid, comp in enumerate(comps):
0100:         ad = _triangle_apex_and_dir(comp)
0101:         if ad is None:
0102:             continue
0103:         (ar, ac), (dr, dc) = ad
0104:         rr = ar + 5 * dr
0105:         cc = ac + 5 * dc
0106:         if 0 <= rr < h and 0 <= cc < w:
0107:             dest_to_shooters.setdefault((rr, cc), []).append(cid)
0108: 
0109:     hit_components: set[int] = set()
0110:     for dest in dest_to_shooters:
0111:         if dest in cell_to_comp:
0112:             hit_components.add(cell_to_comp[dest])
0113: 
0114:     out = g.copy()
0115: 
0116:     # Projectile hitting a sprite recolors the entire sprite to maroon (9).
0117:     for cid in hit_components:
