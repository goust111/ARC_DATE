0088:     cell_to_comp: dict[tuple[int, int], int] = {}
0089:     for col in sorted(set(int(v) for v in np.unique(g)) - {bg}):
0090:         for comp in _cc8(g == col):
0091:             cid = len(comps)
0092:             comps.append(comp)
0093:             for rc in comp:
