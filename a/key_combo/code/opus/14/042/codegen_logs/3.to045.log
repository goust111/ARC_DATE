+        _add_mask(opts, h, w, [(0, w - 1), (cr, cc)])
+        _add_mask(opts, h, w, [(h - 1, 0), (cr, cc)])
+        _add_mask(opts, h, w, [(h - 1, w - 1), (cr, cc)])
+        _add_mask(opts, h, w, [(0, 0), (h - 1, w - 1)])
+        _add_mask(opts, h, w, [(0, w - 1), (h - 1, 0)])
