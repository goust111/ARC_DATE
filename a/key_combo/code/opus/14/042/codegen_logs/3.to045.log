+    patch_top = _choose_patch(top_h, top_w, pairs[0][0], pairs[0][1], used_patterns)
+    patch_bot = _choose_patch(bot_h, bot_w, pairs[1][0], pairs[1][1], used_patterns)
+    if patch_top is None or patch_bot is None:
