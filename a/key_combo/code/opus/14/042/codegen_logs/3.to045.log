+def _add_mask(options: dict[tuple[int, ...], np.ndarray], h: int, w: int, cells: list[tuple[int, int]]) -> None:
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        if 0 <= r < h and 0 <= c < w:
+            mask[r, c] = True
