        for w in range(2,5):
          for pos in range(1,H-h):
            box=source_bbox(side,h,w,pos)
            if touch_one(box):
              params.append((side,h,w,pos,box,area(side,h,w,pos)))
  grouped={s:[p for p in params if p[0]==s] for s in chosen}
  for combo in product(*(grouped[s] for s in chosen)):
    boxes=[x[4] for x in combo]
    if any(overlap(boxes[i],boxes[j]) for i in range(3) for j in range(i+1,3)):
      continue
    areas=[x[5] for x in combo]
    if any(areas[i]&areas[j] for i in range(3) for j in range(i+1,3)):
      continue
    print('found',chosen,[(x[0],x[1],x[2],x[3],x[4]) for x in combo])
    found=True
    raise SystemExit
