+    top_c = _random_interval(w, top_w, [])
+    if top_c is None:
+        return None
+    bot_c = _random_interval(w, bot_w, [(top_c - 1, top_c + top_w)], margin=1)
+    if bot_c is None:
+        return None
+
+    used_patterns: set[tuple[int, ...]] = set()
