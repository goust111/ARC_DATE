def area(side,h,w,pos):
    cells=set()
    if side=='top':
        c=pos
        for r in range(H-h):
            for cc in range(c,c+w):
                cells.add((r,cc))
        for r in range(H-h,H):
            for cc in range(c,c+w):
                cells.add((r,cc))
    elif side=='bottom':
        c=pos
        for r in range(h,H):
            for cc in range(c,c+w):
                cells.add((r,cc))
        for r in range(0,h):
            for cc in range(c,c+w):
                cells.add((r,cc))
    elif side=='left':
        r=pos
        for rr in range(r,r+h):
            for c in range(W-w):
                cells.add((rr,c))
        for rr in range(r,r+h):
            for c in range(W-w,W):
                cells.add((rr,c))
    else:
        r=pos
        for rr in range(r,r+h):
            for c in range(w,W):
                cells.add((rr,c))
        for rr in range(r,r+h):
            for c in range(0,w):
                cells.add((rr,c))
    return cells

def source_bbox(side,h,w,pos):
    if side=='top': return (0,pos,h-1,pos+w-1)
    if side=='bottom': return (H-h,pos,H-1,pos+w-1)
    if side=='left': return (pos,0,pos+h-1,w-1)
    return (pos,W-w,pos+h-1,W-1)

def touch_one(box):
    r0,c0,r1,c1=box
    cnt=sum([r0==0,r1==H-1,c0==0,c1==W-1])
    return cnt==1

def overlap(a,b):
    ar0,ac0,ar1,ac1=a; br0,bc0,br1,bc1=b
    return not (ar1<br0 or br1<ar0 or ac1<bc0 or bc1<ac0)

found=False
for chosen in combinations(sides,3):
  params=[]
  for side in chosen:
    if side in ('top','bottom'):
      for h in range(2,5):
        for w in range(2,5):
          for pos in range(1,W-w):
            box=source_bbox(side,h,w,pos)
            if touch_one(box):
