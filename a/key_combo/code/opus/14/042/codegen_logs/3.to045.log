+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        rect_h = obj["h"]
+        rect_w = obj["w"]
+        trail = obj["minority"]
+        if obj["side"] == "top":
+            out[: h - rect_h, c0 : c1 + 1] = trail
+            dr0, dc0 = h - rect_h, c0
+        elif obj["side"] == "bottom":
+            out[rect_h:, c0 : c1 + 1] = trail
+            dr0, dc0 = 0, c0
+        elif obj["side"] == "left":
