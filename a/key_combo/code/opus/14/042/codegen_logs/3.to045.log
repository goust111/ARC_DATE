+
+
+def _pattern_signature(mask: np.ndarray) -> tuple[int, ...]:
+    return tuple(mask.astype(int).ravel().tolist())
+
+
+def _choose_patch(h: int, w: int, minority: int, majority: int, used: set[tuple[int, ...]]) -> np.ndarray | None:
