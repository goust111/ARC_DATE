+    if w >= 2:
+        _add_mask(opts, h, w, [(0, 0), (0, w - 1)])
+        _add_mask(opts, h, w, [(h - 1, 0), (h - 1, w - 1)])
+    if h >= 2:
+        _add_mask(opts, h, w, [(0, 0), (h - 1, 0)])
