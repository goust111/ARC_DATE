+        left = mover if direction == 1 else mover - 1
+        row0 = int(rng.integers(2, height - 4))
+        bridges[(row0, left)] = _random_bridge_color(rng)
+        protected.add((row0, left))
+        if num_pipes == 4 and 0 < mover < num_pipes - 1 and rng.random() < 0.5 and row0 + 2 < height - 2:
+            row1 = int(rng.integers(row0 + 2, height - 2))
+            left2 = mover if direction == 1 else mover - 2
+            if 0 <= left2 < num_pipes - 1 and _bridge_ok(bridges, row1, left2):
+                bridges[(row1, left2)] = _random_bridge_color(rng)
+                protected.add((row1, left2))
+
+    _add_random_extras(bridges, num_pipes, height, blocked_mode, protected, rng)
+
+    for (row, left), color in bridges.items():
+        if not _bridge_ok({k: v for k, v in bridges.items() if k != (row, left)}, row, left):
+            return None
+        _add_bridge(grid, pipe_cols, row, left, color)
+
+    out, meta = _simulate(grid, return_meta=True)
+    if out is None or not meta["valid"]:
+        return None
+    if not _semantic_checks(grid, out, blocked_mode):
+        return None
+
+    in_sig = _grid_sig(grid)
+    out_sig = _grid_sig(out)
+    if in_sig in _SEEN_INPUTS or out_sig in _SEEN_OUTPUTS:
+        return None
+    _SEEN_INPUTS.add(in_sig)
+    _SEEN_OUTPUTS.add(out_sig)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid routed-pipe input")

