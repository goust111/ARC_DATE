+def _build_canvas(height: int, num_pipes: int, left_margin: int, right_margin: int) -> tuple[np.ndarray, list[int]]:
+    width = left_margin + (4 * num_pipes - 1) + right_margin
+    grid = np.full((height, width), BLACK, dtype=int)
