+        return False
+    for pipe in (left, left + 1):
+        for delta_left in (-1, 0):
+            key = (row, pipe + delta_left)
+            if key in existing and pipe in (key[1], key[1] + 1):
+                return False
+    return True
+
+
+def _add_random_extras(
+    existing: dict[tuple[int, int], int],
+    num_pipes: int,
+    height: int,
+    blocked_mode: bool,
+    protected: set[tuple[int, int]],
+    rng: np.random.Generator,
+) -> None:
+    target = int(rng.integers(1, num_pipes + 2))
+    attempts = 0
+    while len(existing) < target + len(protected) and attempts < 200:
+        attempts += 1
+        row = int(rng.integers(1, height - 2))
+        left = int(rng.integers(0, num_pipes - 1))
