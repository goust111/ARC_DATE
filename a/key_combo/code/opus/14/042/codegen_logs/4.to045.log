+            return None
+        row_ab = int(rng.integers(2, height // 2))
+        row_bc = int(rng.integers(row_ab + 2, height - 3))
+        bridges[(row_ab, trio_start)] = _random_bridge_color(rng)
+        bridges[(row_bc, trio_start + 1)] = _random_bridge_color(rng)
+        protected.update({(row_ab, trio_start), (row_bc, trio_start + 1)})
+
+        if num_pipes == 4 and rng.random() < 0.55 and trio_start + 3 < num_pipes:
+            row_cd = int(rng.integers(row_bc + 2, height - 2))
+            if _bridge_ok(bridges, row_cd, trio_start + 2):
+                bridges[(row_cd, trio_start + 2)] = _random_bridge_color(rng)
+                protected.add((row_cd, trio_start + 2))
