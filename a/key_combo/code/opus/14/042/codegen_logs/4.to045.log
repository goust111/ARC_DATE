+    if len(meta["used_bridges"]) == 0:
+        return False
+    if meta["same_tick_conflicts"] != 0:
+        return False
+    if meta["unused_count"] <= 0:
+        return False
+    if blocked_mode and meta["blocked_attempts"] <= 0:
+        return False
