0131: def generate_input():
0132:     # Generate a random background grid
0133:     # Make sure the grid's width is greater than its height
0134:     width, height = random.randint(15, 20), random.randint(10, 15)
0135:     grid = np.zeros((width, height), dtype=int)
0136: 
0137:     # Get the color of two pixels
0138:     colors = np.random.choice(Color.NOT_BLACK, 2, replace=False)
0139:     color1, color2 = colors
0140: 
0141:     # Place the two pixels on the grid horizontally (randomly rotate at the end to get a variety of orientations)
0142:     x1 = np.random.randint(0, width)
0143:     x2 = np.random.randint(0, width)
0144:     c = np.random.randint(0, height)
0145: 
0146:     # Ensure there is enough horizontal distance to place the 4x5 rectangle
0147:     distance = abs(x2 - x1)
0148:     rectangle_width, rectangle_height = 4, 5
0149:     if distance < rectangle_width+1: return generate_input()
0150: 
0151:     # Ensure the remaining distance is odd, so that we can split the pixel colors in half between them
0152:     if (distance - rectangle_width) % 2 != 1: return generate_input()
0153: 
0154:     # Ensure there is enough vertical space to place the rectangle
0155:     if c < rectangle_height // 2 or c + rectangle_height // 2 >= height: return generate_input()    
0156: 
0157:     # Place the two pixels on the grid
0158:     grid[x1, c] = color1
0159:     grid[x2, c] = color2
0160: 
0161:     # Randomly rotate the whole grid
0162:     if np.random.rand() < 0.5:
0163:         grid = np.rot90(grid, k=-1)
0164: 
0165:     return grid

