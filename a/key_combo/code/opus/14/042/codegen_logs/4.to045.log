+    grid = np.full((height, width), BLACK, dtype=int)
+    pipe_cols = [left_margin + 1 + 4 * idx for idx in range(num_pipes)]
+    for c in pipe_cols:
+        grid[: height - 1, c] = PIPE
+    return grid, pipe_cols
+
+
+def _add_bridge(grid: np.ndarray, pipe_cols: list[int], row: int, left: int, color: int) -> None:
+    c0 = pipe_cols[left]
+    c1 = pipe_cols[left + 1]
+    grid[row, c0 + 1 : c1] = color
+
+
+def _random_bridge_color(rng: np.random.Generator) -> int:
+    return int(rng.choice(np.array(BRIDGE_COLORS)))
+
+
+def _reserve_token_pipes(num_pipes: int, blocked_mode: bool, rng: np.random.Generator) -> list[int]:
+    token_count = int(rng.integers(2, min(4, num_pipes) + 1))
+    pipes = list(rng.choice(np.arange(num_pipes), size=token_count, replace=False).tolist())
+    if blocked_mode:
+        trio_start = int(rng.integers(0, num_pipes - 2))
+        required = {trio_start, trio_start + 1}
+        missing = list(required - set(pipes))
+        available = [pipe for pipe in range(num_pipes) if pipe not in required]
+        for miss in missing:
+            if len(pipes) < token_count:
+                pipes.append(miss)
+            else:
+                for idx, pipe in enumerate(pipes):
+                    if pipe in available:
+                        pipes[idx] = miss
+                        available.remove(pipe)
+                        break
