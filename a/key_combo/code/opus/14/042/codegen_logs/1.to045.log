+    legend_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    rows, cols = np.indices((h, w))
+    for sr, sc, color in sorted(seeds, key=lambda item: (item[0], item[1])):
+        seq = _color_sequence(color, pairs)
+        distance = np.maximum(np.abs(rows - sr), np.abs(cols - sc))
