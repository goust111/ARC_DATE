+def _build_pairs() -> tuple[list[tuple[int, int]], list[int]]:
+    n_rows = random.randint(3, 5)
+    colors = random.sample(range(1, 10), n_rows)
+    a, b, c = colors[:3]
+    pairs = [(a, b), (c, a), (b, c)]
+    if n_rows >= 4:
+        d = colors[3]
