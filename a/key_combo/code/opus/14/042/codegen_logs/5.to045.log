+                    "kind": "holey",
+                    "holes": hole_count,
+                    "patch": patch,
+                    "out_shape": (ph * 2, pw * 2),
+                }
+            )
+
+        for idx in range(solid_count):
+            patch = _make_solid_patch(rng, spread=(idx == 0))
+            ph, pw = patch.shape
+            entries.append(
+                {
+                    "kind": "solid",
+                    "holes": 0,
+                    "patch": patch,
+                    "out_shape": (ph, pw),
+                }
+            )
+    except RuntimeError:
+        return None
+
+    placed = _place_entries(rng, shape, entries)
+    if placed is None:
+        return None
+
+    grid = _build_grid(shape, placed)
+    if not _validate_layout(grid, placed):
+        return None
+    return grid
+
