+def _component_output_patch(component_mask: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray] | None:
+    box, local, holes = _local_holes(component_mask)
+    if not holes:
+        return None
+    return box, _colored_scaled_patch(local)
