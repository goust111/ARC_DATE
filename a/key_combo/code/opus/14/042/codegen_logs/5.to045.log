+    assert bg == BLACK
+
+    out = np.full_like(g, BLACK)
+    components = find_components(
+        g,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        colors=[BLUE],
+        return_format="dict",
+    )
+
+    for comp in components:
+        comp_mask = _coords_mask(g.shape, comp["coords"])
+        transformed = _component_output_patch(comp_mask)
+        if transformed is None:
+            out[comp_mask] = BLUE
