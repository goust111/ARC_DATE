+            in_box = (r0, c0, r0 + ih - 1, c0 + iw - 1)
+            out_box = (r0, c0, r0 + oh - 1, c0 + ow - 1)
+            if any(_rect_overlap(in_box, other["in_box"], pad=2) for other in placed):
+                continue
+            if any(_rect_overlap(out_box, other["out_box"], pad=1) for other in placed):
