0013: def main(input_grid):
0014:     """
0015:     Draw a green marker rectangle below each 2x2 square sized by its color count.
0016: 
0017:     Input structure:
0018:     - The input is a 10x10 black grid with separated 2x2 colored squares.
0019:     - Each square may contain one to four non-black colors.
0020:     - The generated placement leaves room around squares for added markers.
0021: 
0022:     Rule:
0023:     - Detect each multicolor square object.
0024:     - Count the distinct non-black colors inside it.
0025:     - Paste a green rectangle directly below the square with height equal to that count and matching square width.
0026: 
0027:     Key insight:
0028:     - The added green shape encodes diversity inside each square: more distinct colors
0029:       produce a taller marker.
0030:     """
0031:     # copy the input grid to the output grid
0032:     output_grid = input_grid.copy()
0033:     # find all connected components in the input grid
0034:     bg = Color.BLACK
0035:     objects = find_components(
0036:         input_grid,
0037:         bg=bg,
0038:         connectivity=4,
0039:         monochromatic=False,
0040:         return_format="objects",
0041:     )
0042: 
0043:     # for each object, draw a green rectangle below it of shape 2xL, where L is the number of colors in the square
0044:     for obj in objects:
0045:         b = bbox(obj != bg)
0046:         if b is None:
0047:             continue
0048:         r0, c0 = bbox_anchor(b, anchor="upper left")
0049:         h = bbox_h(b)
0050:         w = bbox_w(b)
0051:         num_colors = len(colors_present(obj, exclude={bg}))
0052:         # Place a green rectangle just below the square.
0053:         # In canonical (r,c), the rectangle extends downward with height = (#colors in the square)
0054:         # and width = (square width).
0055:         green_rectangle = np.full((num_colors, w), Color.GREEN)
0056:         output_grid = paste(output_grid, green_rectangle, r0 + h, c0, clip=True)
0057: 
0058:     return output_grid
