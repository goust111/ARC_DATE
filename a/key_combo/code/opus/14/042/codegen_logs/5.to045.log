+
+def _make_solid_patch(rng: random.Random, spread: bool) -> np.ndarray:
+    for _ in range(300):
+        if spread:
+            h = rng.randint(4, 5)
+            w = rng.randint(4, 5)
+            cells = rng.randint(5, 8)
+        else:
+            h = rng.randint(2, 5)
+            w = rng.randint(2, 5)
+            cells = rng.randint(3, 8)
