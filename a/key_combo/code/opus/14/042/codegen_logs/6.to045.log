            candidates.append((r0, c0, r1, c1))

    assert len(candidates) == 1
    return candidates[0]


def _full_separator_lines(g: np.ndarray, bg: int, legend_bbox: tuple[int, int, int, int]) -> list[tuple[str, int, int]]:
