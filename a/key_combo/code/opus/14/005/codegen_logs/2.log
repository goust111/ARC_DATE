+
+DIVIDER = 0
+REGION_BG = 5
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+LAYOUTS = ((2, 2), (2, 3), (3, 2), (2, 4), (4, 2))
+CELL_SIZES = (3, 4)
