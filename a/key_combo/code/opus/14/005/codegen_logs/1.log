+def _place_vertical_bars(
+    h: int,
+    w: int,
+    red_cells: set[tuple[int, int]],
+    green_cells: set[tuple[int, int]],
+    active_rows: set[int],
+    trunk_span_rows: set[int],
+    forbidden_rows: set[int],
+) -> list[tuple[int, int, list[int], list[int]]] | None:
