  "path": "paint the spine between the aligned red pair, then cast each remaining red pixel perpendicularly to the spine along its row or column",
  "trajectory": "paint every background pixel on these straight connector segments green",
  "transform": "preserve all red control pixels and leave other background cells unchanged"
}
</annotation>
