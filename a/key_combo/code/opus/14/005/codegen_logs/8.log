    colors = random.sample(_NON_LATTICE_COLORS, non_count)
    if include_lattice:
        colors.append(_LATTICE)

    assignments = colors[:]
    assignments.extend(random.choice(colors) for _ in range(marker_count - len(assignments)))
    random.shuffle(assignments)
    return assignments


