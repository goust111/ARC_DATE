+        for c2 in range(c1 + 1, col_count):
+            for w1 in range(1, max_widths[c1] + 1):
+                for w2 in range(1, max_widths[c2] + 1):
+                    dst1 = (c1 + w1) % col_count
+                    if dst1 == (c2 + w2) % col_count:
+                        options.append((c1, w1, c2, w2, dst1))
