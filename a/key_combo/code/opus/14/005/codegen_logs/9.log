+                return None
+        else:
+            if not (area2 > area1 and int(expected[row, dst]) == int(colors[row, c2])):
+                return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid puzzle input")

