+    col_margin = 1 if region_w - shape_w >= 2 else 0
+    top_min = row_margin
+    top_max = region_h - shape_h - row_margin
+    left_min = col_margin
+    left_max = region_w - shape_w - col_margin
+    if top_max < top_min:
+        top_min, top_max = 0, region_h - shape_h
+    if left_max < left_min:
