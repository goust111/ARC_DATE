+def _color_grid(row_count: int, col_count: int) -> np.ndarray:
+    total = row_count * col_count
+    pool: list[int] = []
+    while len(pool) < total:
+        chunk = list(PALETTE)
+        random.shuffle(chunk)
+        pool.extend(chunk)
+    return np.array(pool[:total], dtype=int).reshape(row_count, col_count)
