+
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+LAYOUTS = ((3, 4), (4, 3))
+REGION_SIZE_RANGE = (4, 6)
+MAX_ATTEMPTS = 400
+
+SHAPES_BY_WIDTH = {
+    1: [
