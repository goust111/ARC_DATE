+            if roles[r][c][0] != "random":
+                return None
+            roles[r][c] = ("col_cover", side)
+
+    widths = np.zeros((row_count, col_count), dtype=int)
+    for r in range(row_count):
+        for c in range(col_count):
+            role, _side = roles[r][c]
+            if role == "row_cover":
