+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if int(grid[r, c]) != BLACK or forbidden[r, c]:
+                continue
+            if any(_chebyshev((r, c), obstacle) < 2 for obstacle in obstacle_cells):
+                continue
+
+            blocked = 0
+            free_black = 0
+            for rr, cc in neighbors8(r, c):
