+    markers: list[tuple[int, int]],
+    forbidden: np.ndarray,
+    marker: tuple[int, int],
+) -> set[tuple[int, int]]:
+    marker_set = set(markers)
+    targets: set[tuple[int, int]] = set()
+    r, c = marker
+    for rr, cc in neighbors8(r, c):
+        if not in_bounds(grid.shape, rr, cc):
