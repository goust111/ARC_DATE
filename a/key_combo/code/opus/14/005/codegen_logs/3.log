+
+def _marker_candidates(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    forbidden: np.ndarray,
+    obstacle_cells: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame_bbox
