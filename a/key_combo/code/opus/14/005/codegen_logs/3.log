+    random.shuffle(near)
+    random.shuffle(far)
+    chosen: list[tuple[int, int]] = []
+    for cand in near + far:
+        if any(_chebyshev(cand, other) < 2 for other in chosen):
+            continue
+        chosen.append(cand)
+        if len(chosen) == count:
