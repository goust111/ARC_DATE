+    rr -= r0
+    rc -= c0
+    tr -= r0
+    tc -= c0
+
+    c_step = 1 if rc <= tc else -1
+    for c in range(rc, tc + c_step, c_step):
+        mask[rr, c] = True
+
+    r_step = 1 if rr <= tr else -1
+    for r in range(rr, tr + r_step, r_step):
+        mask[r, tc] = True
