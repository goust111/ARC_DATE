149: GRID_ROWS = 12
150: GRID_COL_CHOICES = [12, 13]
151: COLORS = list(range(1, 10))
152: 
153: # L-sprite geometry.
154: LEG_LEN_MIN = 2
155: LEG_LEN_MAX = 4
156: MIN_BODY_PIXELS = 4
157: ORIENTATION_COUNT = 4
158: LEG_PAIRS = [
159:     (v_len, h_len)
160:     for v_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)
161:     for h_len in range(LEG_LEN_MIN, LEG_LEN_MAX + 1)
162:     if v_len + h_len - 1 >= MIN_BODY_PIXELS
163: ]
164: 
165: # Sprite/control counts and rates.
166: SPRITE_COUNT_MIN = 2
167: SPRITE_COUNT_MAX = 4
168: MIN_MOVED_SPRITES = 1
169: MAX_MOVED_SPRITES = 2
170: MAX_STATIONARY_SPRITES = 2
171: DISTRACTOR_PROBABILITY = 0.5
172: 
173: # Placement constraints and retry limits.
174: PLACEMENT_PADDING = 1
175: PLACEMENT_PADDING_CONNECTIVITY = 4
176: MIN_DIAGONAL_DISTANCE = 1
177: GENERATION_RETRIES = 300
