291: # ---------------------------------------------------------------------------
292: # Frame attachment
293: # ---------------------------------------------------------------------------
294: 
295: def _halo_offsets(fh, fw):
296:     """Compute offsets around a frame bbox that lie outside it (the halo)."""
297:     return [(dr, dc) for dr in range(-1, fh + 1) for dc in range(-1, fw + 1)
298:             if not (0 <= dr < fh and 0 <= dc < fw)]
299: 
300: 
301: def _try_attach_frame(canvas, line_path, line_col, frame_col, rng, max_tries=FRAME_ATTACH_TRIES):
302:     """Try to place a frame loop 8-adjacent to some line pixel.
303: 
304:     canvas is modified in place; returns (ring, cavity) or None on failure.
305:     """
306:     h, w = canvas.shape
307:     pad = FRAME_PLACEMENT_PAD
308:     for _ in range(max_tries):
309:         ch = rng.choice(CAVITY_SIZE_WEIGHTS)
310:         cw = rng.choice(CAVITY_SIZE_WEIGHTS)
311:         lp = rng.choice(line_path)
312:         fh, fw = ch + 2, cw + 2
313:         offsets = _halo_offsets(fh, fw)
314:         rng.shuffle(offsets)
315:         for dr, dc in offsets:
316:             r0 = lp[0] - dr
317:             c0 = lp[1] - dc
318:             if r0 < pad or c0 < pad or r0 + fh > h - pad or c0 + fw > w - pad:
319:                 continue
320:             ring, cavity = _frame_ring_coords(r0, c0, ch, cw)
321:             if not _validate_frame_placement(canvas, ring, cavity, line_col, h, w):
322:                 continue
323:             for rr, cc in ring:
324:                 canvas[rr, cc] = frame_col
325:             return ring, cavity
326:     return None
327: 
328: 
329: def _try_attach_distractor_frame(canvas, frame_col, rng, max_tries=DISTRACTOR_FRAME_TRIES):
330:     """Place a loop in empty space, not touching any non-bg pixel."""
331:     h, w = canvas.shape
332:     for _ in range(max_tries):
333:         ch = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)
334:         cw = rng.choice(DISTRACTOR_CAVITY_WEIGHTS)
335:         fh, fw = ch + 2, cw + 2
336:         r0 = rng.randint(1, h - fh - 1)
337:         c0 = rng.randint(1, w - fw - 1)
338:         # Check the full bbox + 1-cell margin is empty
339:         ok = True
340:         for rr in range(r0 - 1, r0 + fh + 1):
341:             for cc in range(c0 - 1, c0 + fw + 1):
342:                 if _in_bounds(h, w, rr, cc) and canvas[rr, cc] != -1:
343:                     ok = False
344:                     break
345:             if not ok:
346:                 break
347:         if not ok:
348:             continue
349:         ring, _ = _frame_ring_coords(r0, c0, ch, cw)
350:         for rr, cc in ring:
351:             canvas[rr, cc] = frame_col
352:         return True
353:     return None
354: 
355: 
356: def _try_place_distractor_network(canvas, line_col, frame_colors_pool, rng):
357:     """Place a disconnected line+frame distractor (no seed)."""
358:     h, w = canvas.shape
359:     for _ in range(DISTRACTOR_NETWORK_TRIES):
360:         r = rng.randint(2, h - 3)
361:         c = rng.randint(2, w - 3)
362:         if any(canvas[r + dr, c + dc] != -1 for dr in range(-1, 2) for dc in range(-1, 2)):
363:             continue
364:         canvas[r, c] = line_col
365:         target_len = rng.randint(*DISTRACTOR_LINE_LEN)
366:         path = _grow_line(canvas, (r, c), line_col, target_len, rng)
367:         if len(path) < 3:
368:             for pr, pc in path:
369:                 canvas[pr, pc] = -1
370:             continue
371:         attached = 0
372:         for _ in range(rng.randint(*DISTRACTOR_NETWORK_FRAMES)):
373:             fc = rng.choice(frame_colors_pool)
374:             if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:
375:                 attached += 1
376:         if attached > 0:
377:             return True
378:         for pr, pc in path:
379:             canvas[pr, pc] = -1
380:     return False
381: 
