132: # ========================== CFG ==========================
133: # Canvas / grid
134: GRID_H_RANGE = (8, 30)             # grid height bounds
135: GRID_W_RANGE = (8, 30)             # grid width bounds
136: BG_COLORS = [0, 5]                 # background color choices
137: 
138: # Seeds
139: SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)
140: MIN_LINE_LEN = 4                   # discard attempt if line shorter than this
141: LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)
142: 
143: # Frame loops
144: FRAME_COLORS_MAX = 4               # max distinct frame colors
145: TOTAL_LOOPS_MAX = 9                # max total loops per grid
146: CAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)
147: DISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)
148: FRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge
149: FRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt
150: DISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement
151: 
152: # Line growth
153: DIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps
154: DIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps
155: ORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps
156: ORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps
157: BORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells
158: BIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck
159: 
160: # Distractor network
161: DISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames
162: DISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network
163: DISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range
164: DISTRACTOR_SOLO_MAX = 2            # max solo distractor frames
165: DISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network
166: 
167: # Generation
168: GEN_RETRIES = 300                  # outer retry budget in generate_input()
169: # =========================================================
170: 
171: DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
172: ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
173: 
174: 
175: def _in_bounds(h, w, r, c):
176:     return 0 <= r < h and 0 <= c < w
177: 
178: 
179: # ---------------------------------------------------------------------------
180: # Frame geometry
181: # ---------------------------------------------------------------------------
182: 
183: def _frame_ring_coords(r0, c0, ch, cw):
184:     """Return (ring_coords, cavity_coords) for a rounded-rect frame.
185: 
186:     Frame bbox is [r0, r0+ch+1] x [c0, c0+cw+1] (inclusive).
187:     Ring = bbox boundary minus 4 corners.
188:     """
189:     H, W = ch + 2, cw + 2
190:     ring = []
191:     for dr in range(H):
192:         for dc in range(W):
193:             on_bdr = (dr == 0 or dr == H - 1 or dc == 0 or dc == W - 1)
194:             corner = (dr in (0, H - 1)) and (dc in (0, W - 1))
195:             if on_bdr and not corner:
196:                 ring.append((r0 + dr, c0 + dc))
197:     cavity = [(r0 + 1 + dr, c0 + 1 + dc) for dr in range(ch) for dc in range(cw)]
198:     return ring, cavity
199: 
200: 
201: def _validate_frame_placement(canvas, ring, cavity, line_col, h, w):
202:     """Check that ring+cavity can be placed on canvas without conflicts.
203: 
204:     Returns True if: ring and cavity cells are empty, no cavity cell is
205:     8-adjacent to line_col, ring is not 8-adjacent to foreign colors, and
206:     at least one ring cell is 8-adjacent to a line_col pixel.
207:     """
208:     # Ring and cavity cells must all be empty
209:     for rr, cc in ring:
210:         if canvas[rr, cc] != -1:
211:             return False
212:     for rr, cc in cavity:
213:         if canvas[rr, cc] != -1:
214:             return False
215: 
216:     # No cavity cell may be 8-adjacent to any line_col pixel
217:     for cr, cc in cavity:
218:         for nr, nc in neighbors8(cr, cc):
219:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
220:                 return False
221: 
222:     # Ring must not be 8-adjacent to any non-bg, non-line_col pixel
223:     ring_set = set(ring)
224:     for rr, cc in ring:
225:         for nr, nc in neighbors8(rr, cc):
226:             if not _in_bounds(h, w, nr, nc) or (nr, nc) in ring_set:
227:                 continue
228:             v = canvas[nr, nc]
229:             if v != -1 and v != line_col:
230:                 return False
231: 
232:     # At least one ring cell must be 8-adjacent to a line_col pixel
233:     for rr, cc in ring:
234:         for nr, nc in neighbors8(rr, cc):
235:             if _in_bounds(h, w, nr, nc) and canvas[nr, nc] == line_col:
236:                 return True
237:     return False
238: 
