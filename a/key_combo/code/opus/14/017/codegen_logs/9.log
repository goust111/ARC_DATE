383: # ---------------------------------------------------------------------------
384: # Main generator
385: # ---------------------------------------------------------------------------
386: 
387: def _corner_config(corner_kind, h, w, rng):
388:     """Return (seed_rc, first_line_rc) for corner_kind in {TL,TR,BL,BR}."""
389:     if corner_kind == 'TL':
390:         seed = (0, 0)
391:         first = rng.choice([(0, 1), (1, 0)])
392:     elif corner_kind == 'TR':
393:         seed = (0, w - 1)
394:         first = rng.choice([(0, w - 2), (1, w - 1)])
395:     elif corner_kind == 'BL':
396:         seed = (h - 1, 0)
397:         first = rng.choice([(h - 1, 1), (h - 2, 0)])
398:     elif corner_kind == 'BR':
399:         seed = (h - 1, w - 1)
400:         first = rng.choice([(h - 1, w - 2), (h - 2, w - 1)])
401:     else:
402:         raise ValueError(corner_kind)
403:     return seed, first
404: 
405: 
406: def _distribute_loop_budget(num_seeds, num_attached_target, rng):
407:     """Distribute attached-loop budget across seeds, guaranteeing >= 1 each."""
408:     seed_order = list(range(num_seeds))
409:     rng.shuffle(seed_order)
410:     per_seed = [0] * num_seeds
411:     remaining = num_attached_target
412:     # Guarantee at least 1 per seed
413:     while remaining > 0 and any(per_seed[i] == 0 for i in range(num_seeds)):
414:         for i in seed_order:
415:             if per_seed[i] == 0 and remaining > 0:
416:                 per_seed[i] += 1
417:                 remaining -= 1
418:     # Distribute remainder randomly
419:     while remaining > 0:
420:         per_seed[rng.choice(seed_order)] += 1
421:         remaining -= 1
422:     return per_seed
423: 
424: 
425: def _gen_attempt(rng: random.Random) -> np.ndarray | None:
426:     h = rng.randint(*GRID_H_RANGE)
427:     w = rng.randint(*GRID_W_RANGE)
428:     bg = rng.choice(BG_COLORS)
429:     palette = [c for c in range(10) if c != bg]
430:     rng.shuffle(palette)
431: 
432:     num_seeds = rng.choice(SEED_COUNT_WEIGHTS)
433:     if num_seeds * 2 > len(palette):
434:         return None
435: 
436:     canvas = -np.ones((h, w), dtype=int)
437: 
438:     seed_colors = [palette.pop() for _ in range(num_seeds)]
439:     line_colors = [palette.pop() for _ in range(num_seeds)]
440: 
441:     all_corners = ['TL', 'TR', 'BL', 'BR']
442:     rng.shuffle(all_corners)
443:     corners_used = all_corners[:num_seeds]
444: 
445:     num_frame_cols = rng.randint(1, min(FRAME_COLORS_MAX, len(palette)))
446:     frame_colors_pool = [palette.pop() for _ in range(num_frame_cols)]
447: 
448:     # Grow seed lines
449:     lines_info = []
450:     for i in range(num_seeds):
451:         seed_rc, first_rc = _corner_config(corners_used[i], h, w, rng)
452:         if canvas[seed_rc] != -1 or canvas[first_rc] != -1:
453:             return None
454:         canvas[seed_rc] = seed_colors[i]
455:         canvas[first_rc] = line_colors[i]
456:         target_len = rng.randint(LINE_LEN_RANGE[0], min(LINE_LEN_RANGE[1], h + w))
457:         path = _grow_line(canvas, first_rc, line_colors[i], target_len, rng)
458:         if len(path) < MIN_LINE_LEN:
459:             return None
460:         lines_info.append((seed_colors[i], seed_rc, line_colors[i], path))
461: 
462:     # Decide loop counts and distribute across seeds
463:     total_loops_target = rng.randint(num_seeds, TOTAL_LOOPS_MAX)
464:     num_distractors_target = rng.randint(0, max(0, total_loops_target - num_seeds))
465:     num_attached_target = total_loops_target - num_distractors_target
466:     per_seed = _distribute_loop_budget(num_seeds, num_attached_target, rng)
467: 
468:     # Attach frames to each seed's line
469:     for i, (_, _, line_col, path) in enumerate(lines_info):
470:         attached = 0
471:         for _ in range(per_seed[i]):
472:             fc = rng.choice(frame_colors_pool)
473:             if _try_attach_frame(canvas, path, line_col, fc, rng) is not None:
474:                 attached += 1
475:         if attached == 0:
476:             return None
477: 
478:     # Place distractors
479:     if rng.random() < DISTRACTOR_NETWORK_PROB:
480:         _try_place_distractor_network(canvas, rng.choice(line_colors), frame_colors_pool, rng)
481:     else:
482:         for _ in range(rng.randint(0, DISTRACTOR_SOLO_MAX)):
483:             _try_attach_distractor_frame(canvas, rng.choice(frame_colors_pool), rng)
484: 
485:     # Finalize grid
486:     grid = np.where(canvas == -1, bg, canvas).astype(int)
487: 
488:     # Validate bg is most common color
489:     vals, cnts = np.unique(grid, return_counts=True)
490:     if int(vals[np.argmax(cnts)]) != bg:
491:         return None
492: 
493:     # Validate each seed color appears exactly once
494:     for seed_col, _, _, _ in lines_info:
495:         if int((grid == seed_col).sum()) != 1:
496:             return None
497: 
498:     # Oracle check: solver must change at least one cell
499:     try:
500:         out = main(grid)
501:     except Exception:
502:         return None
503:     if np.array_equal(out, grid):
504:         return None
505:     return grid
506: 
507: 
508: def generate_input() -> np.ndarray:
509:     rng = random.Random()
510:     for _ in range(GEN_RETRIES):
511:         g = _gen_attempt(rng)
512:         if g is not None:
513:             return g
514:     raise RuntimeError("generate_input: exhausted attempts")

