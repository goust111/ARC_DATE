157: 
158: def _gen_place_frame(
159:     grid: np.ndarray, r: int, c: int, direction: tuple[int, int]
160: ) -> tuple[tuple[int, int], tuple[int, int]]:
161:     dr, dc = direction
162:     gap = (r + dr, c + dc)
163:     exterior = (r + GEN_EXTERIOR_STEP * dr, c + GEN_EXTERIOR_STEP * dc)
164: 
165:     r0, r1 = r - GEN_FRAME_RADIUS, r + GEN_FRAME_RADIUS + 1
166:     c0, c1 = c - GEN_FRAME_RADIUS, c + GEN_FRAME_RADIUS + 1
167:     grid[r0:r1, c0:c1] = GEN_FRAME
168:     grid[r, c] = GEN_MARKER
169:     grid[gap] = GEN_BG
170:     return gap, exterior
