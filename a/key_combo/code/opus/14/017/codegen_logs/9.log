+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+MARKER_COLORS = (1, 2, 3)
+BODY_COLORS = (6, 7, 9)
+MARKER_SET = set(MARKER_COLORS)
+
+GEN_RETRIES = 400
+PLACE_RETRIES = 300
