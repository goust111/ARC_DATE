+                    "coords": comp,
+                    "marker": marker_color,
+                    "body": body_color,
+                    "inside_legend": inside_legend,
+                }
+            )
+            if not inside_legend:
+                marker_pixels_outside[marker_color] += 1
+                bodies_by_marker[marker_color].add(body_color)
+                markers_by_body[body_color].add(marker_color)
