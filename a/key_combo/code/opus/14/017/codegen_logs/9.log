309: def _place_aligned_input_sprite(grid: np.ndarray, sprite: dict) -> tuple[int, int] | None:
310:     patch = sprite["patch"]
311:     bend = sprite["bend"]
312:     marker_dr, marker_dc = sprite["marker_offset"]
313:     target_r, target_c = sprite["target"]
314:     rows, cols = grid.shape
315:     blocked = _blocked_cells(grid)
316: 
317:     candidates = []
318:     for dist in range(MIN_DIAGONAL_DISTANCE, max(rows, cols) + 1):
319:         bend_r = target_r + marker_dr * dist
