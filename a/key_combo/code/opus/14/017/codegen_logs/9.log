+    out = g.copy()
+    out[r0 + 1 : r1, c0 + 1 : c1] = BG
+    for row, color in info["keys"]:
+        out[row, key_col] = color
+        count = int(info["sprite_counts"][color])
+        for idx in range(count):
+            col = key_col + 2 * (idx + 1)
+            assert col < c1, "legend width is insufficient for the tally"
+            out[row, col] = color
+    return out
