204: def _draw_frame(g: np.ndarray, *, r0: int, c0: int, outer: int, t: int, border: int, inner_col: int) -> None:
205:     g[int(r0) : int(r0 + outer), int(c0) : int(c0 + outer)] = int(border)
206:     g[int(r0 + t) : int(r0 + outer - t), int(c0 + t) : int(c0 + outer - t)] = int(inner_col)
