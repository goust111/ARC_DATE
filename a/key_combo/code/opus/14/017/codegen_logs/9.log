180: def _make_l_sprite(body_color: int, marker_color: int) -> tuple[np.ndarray, tuple[int, int]]:
181:     v_len, h_len = random.choice(LEG_PAIRS)
182:     orient = random.randrange(ORIENTATION_COUNT)
183:     patch = np.zeros((v_len, h_len), dtype=int)
184: 
185:     bend_r = 0 if orient in (0, 1) else v_len - 1
186:     bend_c = 0 if orient in (0, 2) else h_len - 1
187:     patch[bend_r, :] = body_color
188:     patch[:, bend_c] = body_color
189: 
190:     marker_r = bend_r + (1 if bend_r == 0 else -1)
191:     marker_c = bend_c + (1 if bend_c == 0 else -1)
192:     patch[marker_r, marker_c] = marker_color
193:     return patch, (bend_r, bend_c)
194: 
195: 
196: def _marker_offset(
197:     patch: np.ndarray, bend: tuple[int, int], marker_color: int
198: ) -> tuple[int, int]:
199:     marker_cells = np.argwhere(patch == marker_color)
200:     assert len(marker_cells) == 1
201:     mr, mc = map(int, marker_cells[0])
202:     return mr - bend[0], mc - bend[1]
203: 
204: 
205: def _erase_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
206:     h, w = patch.shape
207:     mask = patch != BG_COLOR
208:     grid[r0 : r0 + h, c0 : c0 + w][mask] = BG_COLOR
209: 
210: 
211: def _blocked_cells(grid: np.ndarray) -> np.ndarray:
212:     """Return cells where a foreground patch pixel would violate the gap rule."""
213:     blocked = grid != BG_COLOR
214:     for _ in range(PLACEMENT_PADDING):
215:         expanded = blocked.copy()
216:         expanded[1:, :] |= blocked[:-1, :]
217:         expanded[:-1, :] |= blocked[1:, :]
218:         expanded[:, 1:] |= blocked[:, :-1]
219:         expanded[:, :-1] |= blocked[:, 1:]
220:         if PLACEMENT_PADDING_CONNECTIVITY == 8:
221:             expanded[1:, 1:] |= blocked[:-1, :-1]
222:             expanded[1:, :-1] |= blocked[:-1, 1:]
223:             expanded[:-1, 1:] |= blocked[1:, :-1]
224:             expanded[:-1, :-1] |= blocked[1:, 1:]
225:         elif PLACEMENT_PADDING_CONNECTIVITY != 4:
226:             raise ValueError("placement padding connectivity must be 4 or 8")
227:         blocked = expanded
228:     return blocked
229: 
230: 
231: def _patch_fits(blocked: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
232:     rows, cols = blocked.shape
233:     h, w = patch.shape
234:     if r0 < 0 or c0 < 0 or r0 + h > rows or c0 + w > cols:
235:         return False
236:     patch_mask = patch != BG_COLOR
237:     return not bool((blocked[r0 : r0 + h, c0 : c0 + w] & patch_mask).any())
238: 
239: 
240: def _place_component(grid: np.ndarray, patch: np.ndarray) -> tuple[int, int] | None:
241:     try:
242:         r, c = random_free_location(
243:             grid,
244:             patch,
245:             transparent=BG_COLOR,
246:             padding=PLACEMENT_PADDING,
247:             padding_connectivity=PLACEMENT_PADDING_CONNECTIVITY,
248:         )
249:     except ValueError:
250:         return None
251:     paste(grid, patch, r, c, transparent=BG_COLOR)
252:     return r, c
253: 
254: 
255: def _choose_moved_indices(n_sprites: int) -> set[int]:
256:     min_moves = max(MIN_MOVED_SPRITES, n_sprites - MAX_STATIONARY_SPRITES)
257:     max_moves = min(MAX_MOVED_SPRITES, n_sprites)
258:     n_moves = random.randint(min_moves, max_moves)
259:     return set(random.sample(range(n_sprites), n_moves))
260: 
261: 
262: def _choose_marker_colors(body_colors: list[int]) -> list[int]:
263:     marker_colors = []
264:     for body in body_colors:
265:         choices = [c for c in COLORS if c != body and c not in marker_colors]
266:         marker_colors.append(random.choice(choices))
267:     return marker_colors
268: 
269: 
270: def _build_sprites(n_sprites: int) -> tuple[list[dict], list[int]]:
271:     body_colors = random.sample(COLORS, n_sprites)
272:     marker_colors = _choose_marker_colors(body_colors)
273:     sprites = []
274:     for body, marker in zip(body_colors, marker_colors):
275:         patch, bend = _make_l_sprite(body, marker)
276:         sprites.append(
277:             {
278:                 "patch": patch,
279:                 "bend": bend,
280:                 "marker": marker,
281:                 "marker_offset": _marker_offset(patch, bend, marker),
282:             }
283:         )
284:     return sprites, marker_colors
285: 
