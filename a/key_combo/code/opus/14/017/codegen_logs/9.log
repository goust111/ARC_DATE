8: def main(grid: np.ndarray) -> np.ndarray:
9:     """Return the three foreground colors as a vertical list ordered by decreasing pixel count.
10: 
11:     Input structure
12:     A dominant background contains exactly three foreground color masks.
13: 
14:     Rule
15:     Count the pixels of each foreground color, sort the colors from largest mask
16:     to smallest mask, and emit those colors as a 3x1 column.
17: 
18:     Key insight
19:     The input positions and mask shapes are distractors; the output is the size
20:     ranking of the color masks.
21:     """
22:     g = np.asarray(grid, dtype=int)
23:     bg = get_bg(g)
24:     colors = colors_present(g, exclude={bg})
25:     assert len(colors) == 3
26: 
27:     counts = [(int(np.count_nonzero(g == color)), color) for color in colors]
28:     assert len({count for count, _ in counts}) == len(counts)
29: 
30:     ranked_colors = [color for count, color in sorted(counts, key=lambda item: item[0], reverse=True)]
31:     return np.array(ranked_colors, dtype=int).reshape(3, 1)
32: 
