73: def _gen_seed_sets(h, w, k):
74:     cells = [(r, c) for r in range(h) for c in range(w)]
75:     out = []
76:     for combo in itertools.combinations(cells, k):
77:         rows = [p[0] for p in combo]
78:         cols = [p[1] for p in combo]
79:         if min(rows) != 0 or max(rows) != h - 1 or min(cols) != 0 or max(cols) != w - 1:
80:             continue
81:         if any(abs(a[0] - b[0]) + abs(a[1] - b[1]) == 1 for a, b in itertools.combinations(combo, 2)):
82:             continue
83:         out.append(combo)
84:     return out
85: 
