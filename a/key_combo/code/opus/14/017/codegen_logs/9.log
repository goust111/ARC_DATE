87: def _gen_shape_options(count):
88:     options = []
89:     for k in range(COMPONENT_MIN, min(COMPONENT_MAX, count) + 1):
90:         for h in range(BBOX_SIZE_MIN, BBOX_SIZE_MAX_EXCLUSIVE):
91:             for w in range(BBOX_SIZE_MIN, BBOX_SIZE_MAX_EXCLUSIVE):
92:                 fill = count / (h * w)
93:                 if not (FILL_RATIO_MIN <= fill <= FILL_RATIO_MAX):
94:                     continue
95:                 if k == 1:
96:                     if count >= h + w - 1:
97:                         options.append((k, h, w))
98:                 elif _gen_seed_sets(h, w, k):
99:                     options.append((k, h, w))
100:     return options
101: 
