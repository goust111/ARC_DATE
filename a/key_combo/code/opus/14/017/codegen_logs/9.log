127: def main(grid: np.ndarray) -> np.ndarray:
128:     """
129:     Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.
130: 
131:     Input structure
132:     - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.
133:     - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.
134: 
135:     Rule
136:     - Treat wall pixels as blocked and every other pixel as passable.
137:     - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.
138:     - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.
139: 
140:     Key insight
141:     - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.
142:     """
143:     g = np.asarray(grid, dtype=int)
144:     assert g.ndim == 2
145: 
146:     bg = get_bg(g)
147:     counts = Counter(map(int, g.flat))
148: 
149:     non_bg = colors_present(g, exclude={bg})
150:     assert len(non_bg) == 2
151:     assert counts[bg] > max(counts[color] for color in non_bg)
152:     non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}
153:     wall_count = max(non_bg_counts.values())
154:     wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]
155:     assert len(wall_candidates) == 1
156:     wall = wall_candidates[0]
157:     paint_candidates = [color for color in non_bg if color != wall]
158:     assert len(paint_candidates) == 1
159:     paint = paint_candidates[0]
160:     assert non_bg_counts[wall] > non_bg_counts[paint]
161: 
162:     endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)
163:     assert len(endpoints) == 2
164:     endpoint_coords = [component["coords"] for component in endpoints]
165: 
166:     room_sizes: set[int] = set()
167:     for coords in endpoint_coords:
168:         r0, c0, r1, c1 = bbox_coords(coords)
169:         bh = r1 - r0 + 1
170:         bw = c1 - c0 + 1
171:         assert coords.shape[0] == bh * bw
172:         room_sizes.add(max(bh, bw))
173: 
174:     passable = g != wall
175:     dist0 = _distances_from(endpoint_coords[0], passable)
176:     dist1 = _distances_from(endpoint_coords[1], passable)
177:     endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]
178:     reachable_distances = [d for d in endpoint_distances if d >= 0]
179:     assert len(reachable_distances) == len(endpoint_distances)
180:     shortest = min(reachable_distances)
181: 
182:     route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)
183:     assert np.any(route)
184: 
185:     fill = route.copy()
186:     rooms = _framed_square_rooms(g, wall, room_sizes)
187:     assert rooms
188:     for r, c, n in rooms:
189:         if np.any(route[r : r + n, c : c + n]):
190:             fill[r : r + n, c : c + n] = True
191: 
192:     room_mask = np.zeros_like(fill, dtype=bool)
193:     for r, c, n in rooms:
194:         room_mask[r : r + n, c : c + n] = True
195:     open_fill = fill & (g == bg) & ~room_mask
196:     for r0, c0, r1, c1, area in _component_bboxes(open_fill):
197:         if r1 > r0 and c1 > c0 and area >= 20:
198:             assert _middle_fill_bounded_by_side_rooms(
199:                 (r0, c0, r1, c1),
200:                 rooms,
201:             ), "middle fill must stay within the facing room-frame spans"
202: 
203:     H, W = g.shape
204:     for r, c, n in rooms:
205:         has_doorway = False
206:         if r > 0:
207:             has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)
208:         if r + n < H:
209:             has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)
210:         if c > 0:
211:             has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)
212:         if c + n < W:
213:             has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)
214:         if has_doorway:
215:             assert np.any(fill[r : r + n, c : c + n]), "rooms with doorways must be on the shortest path"
216: 
217:     out = g.copy()
218:     out[fill & (g == bg)] = paint
219:     return out
220: 
221: # --------------- generator (attempt 2 refined middle-fill) ---------------
222: 
223: BG = 0
224: WALL = 8
225: PAINT_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
226: 
227: # Canvas bounds used by the observed evaluation examples.
228: ROW_MIN = 22
229: ROW_MAX = 29
230: COL_MIN = 24
231: COL_MAX = 28
232: 
233: # Room-grid geometry and room-count filters.
234: ROOM_SIZE_RANGE = range(3, 6)
235: ROOM_GRID_RANGE = range(1, 8)
236: BLOCK_ROOM_MIN = 3
237: BLOCK_ROOM_MAX = 14
238: TOTAL_ROOM_MIN = 7
239: TOTAL_ROOM_MAX = 22
240: GAP_RANGE = range(3, 8)
241: ORIENTATIONS = ("vertical", "horizontal")
242: 
243: # Coarse layout and final route validation thresholds.
244: LAYOUT_DISTANCE_MIN = 36
245: LAYOUT_DISTANCE_FLOORS = [36, 42, 48, 54, 60]
246: SHORTEST_DISTANCE_MIN = 36
247: SHORTEST_DISTANCE_MAX = 72
248: TURN_MIN = 8
249: TURN_MAX = 21
250: ON_ROUTE_ROOM_MIN = 6
251: ON_ROUTE_ROOM_MAX = 14
252: OFF_ROUTE_ROOM_MIN = 1
253: OFF_ROUTE_ROOM_MAX = 8
254: 
255: # Connector sampling: offset connectors create the observed middle fill region.
256: OFFSET_CONNECTOR_PROB = 0.60
257: CONNECTOR_CHOICE_TRIES = 300
258: CONNECTOR_DELTA_MAX = 12
259: CONNECTOR_DELTA_MIN_CAP = 5
260: 
261: # Endpoint room selection favors far rooms, with a minority near-exit branch.
262: NEAR_EXIT_ENDPOINT_PROB = 0.30
263: NEAR_EXIT_STEPS = [-1, 0, 1]
264: 
265: # Full-example rejection retries.
266: GENERATE_ATTEMPTS = 300
267: 
268: _NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
269: _LAYOUTS = None
270: _LAST_META = None
271: 
272: 
273: def _block_shape(rows, cols, size):
274:     return rows * (size + 1) + 1, cols * (size + 1) + 1
275: 
276: 
277: def _room_topleft(room_r, room_c, size):
278:     return 1 + room_r * (size + 1), 1 + room_c * (size + 1)
279: 
280: 
281: def _layout_distance_estimate(r1, c1, s1, r2, c2, s2, gap):
282:     return (r1 + c1 - 2) * (s1 + 1) + (r2 + c2 - 2) * (s2 + 1) + s1 + s2 + gap
283: 
284: 
285: def _layout_fits(orientation, bh1, bw1, bh2, bw2, gap):
286:     if orientation == "vertical":
287:         return bh1 + gap + bh2 <= ROW_MAX and max(bw1, bw2) <= COL_MAX
288:     return bw1 + gap + bw2 <= COL_MAX and max(bh1, bh2) <= ROW_MAX
289: 
290: 
291: def _build_layouts():
292:     """Enumerate all layout parameter tuples before random sampling."""
293:     layouts = []
294:     for orientation in ORIENTATIONS:
295:         for s1 in ROOM_SIZE_RANGE:
296:             for s2 in ROOM_SIZE_RANGE:
297:                 for r1 in ROOM_GRID_RANGE:
298:                     for c1 in ROOM_GRID_RANGE:
299:                         n1 = r1 * c1
300:                         if not BLOCK_ROOM_MIN <= n1 <= BLOCK_ROOM_MAX:
301:                             continue
302:                         bh1, bw1 = _block_shape(r1, c1, s1)
303:                         for r2 in ROOM_GRID_RANGE:
304:                             for c2 in ROOM_GRID_RANGE:
305:                                 n2 = r2 * c2
306:                                 total_rooms = n1 + n2
307:                                 valid_block2 = BLOCK_ROOM_MIN <= n2 <= BLOCK_ROOM_MAX
308:                                 valid_total = TOTAL_ROOM_MIN <= total_rooms <= TOTAL_ROOM_MAX
309:                                 if not (valid_block2 and valid_total):
310:                                     continue
311:                                 bh2, bw2 = _block_shape(r2, c2, s2)
312:                                 for gap in GAP_RANGE:
313:                                     approx = _layout_distance_estimate(r1, c1, s1, r2, c2, s2, gap)
314:                                     if approx < LAYOUT_DISTANCE_MIN:
315:                                         continue
316:                                     if _layout_fits(orientation, bh1, bw1, bh2, bw2, gap):
317:                                         layouts.append((orientation, s1, s2, r1, c1, r2, c2, gap, approx))
318:     return layouts
319: 
320: 
321: def _layouts():
322:     global _LAYOUTS
323:     if _LAYOUTS is None:
324:         _LAYOUTS = _build_layouts()
325:     return _LAYOUTS
326: 
327: 
328: def _choose_layout():
329:     layouts = _layouts()
330:     lo = random.choice(LAYOUT_DISTANCE_FLOORS)
331:     candidates = [layout for layout in layouts if layout[-1] >= lo]
332:     if not candidates:
333:         candidates = layouts
334:     return random.choice(candidates)
335: 
336: 
337: def _side_positions(count, size):
338:     positions = []
339:     for index in range(count):
340:         for offset in range(size):
341:             positions.append((1 + index * (size + 1) + offset, index, offset))
342:     return positions
343: 
344: 
345: def _connector_delta(span, offset_connector):
346:     if not offset_connector:
347:         return 0
348:     max_delta = min(CONNECTOR_DELTA_MAX, span - 1)
349:     min_delta = min(CONNECTOR_DELTA_MIN_CAP, max_delta)
350:     if min_delta <= 1:
351:         return None
352:     return random.choice((-1, 1)) * random.randint(min_delta, max_delta)
353: 
354: 
355: def _side_connector_choice(span_lo, span_hi, size1, side_positions1, size2, side_positions2, offset_connector):
356:     """Pick compatible starts and exit offsets along the shared span."""
357:     for _ in range(CONNECTOR_CHOICE_TRIES):
358:         span = random.randint(span_lo, span_hi)
359:         local1, index1, offset1 = random.choice(side_positions1)
360:         local2, index2, offset2 = random.choice(side_positions2)
361:         delta = _connector_delta(span, offset_connector)
362:         if delta is None:
363:             continue
364: 
365:         shift = local1 + delta - local2
366:         lo = max(0, -shift)
367:         hi = min(span - size1, span - size2 - shift)
368:         if lo > hi:
369:             continue
370:         start1 = random.randint(lo, hi)
371:         start2 = start1 + shift
372:         exit1 = start1 + local1
373:         exit2 = start2 + local2
374:         common_lo = max(start1 + 1, start2 + 1)
375:         common_hi = min(start1 + size1 - 2, start2 + size2 - 2)
376:         if min(exit1, exit2) < common_lo or max(exit1, exit2) > common_hi:
377:             continue
378:         return span, start1, start2, exit1, exit2, index1, offset1, index2, offset2
379:     return None
380: 
381: 
382: def _make_block(rows, cols, size, exit_side, exit_index=None, exit_offset=None):
383:     h, w = _block_shape(rows, cols, size)
384:     block = np.full((h, w), BG, dtype=int)
385:     block[:: size + 1, :] = WALL
386:     block[:, :: size + 1] = WALL
387: 
388:     for i in range(1, rows):
389:         wr = i * (size + 1)
390:         for j in range(cols):
391:             c0 = 1 + j * (size + 1)
392:             block[wr, c0 + random.randrange(size)] = BG
393:     for j in range(1, cols):
394:         wc = j * (size + 1)
395:         for i in range(rows):
396:             r0 = 1 + i * (size + 1)
397:             block[r0 + random.randrange(size), wc] = BG
398: 
399:     if exit_side == "bottom":
400:         side_index = random.randrange(cols) if exit_index is None else int(exit_index)
401:         offset = random.randrange(size) if exit_offset is None else int(exit_offset)
402:         room = (rows - 1, side_index)
403:         rr = h - 1
404:         cc = 1 + room[1] * (size + 1) + offset
405:     elif exit_side == "top":
406:         side_index = random.randrange(cols) if exit_index is None else int(exit_index)
407:         offset = random.randrange(size) if exit_offset is None else int(exit_offset)
408:         room = (0, side_index)
409:         rr = 0
410:         cc = 1 + room[1] * (size + 1) + offset
411:     elif exit_side == "right":
412:         side_index = random.randrange(rows) if exit_index is None else int(exit_index)
413:         offset = random.randrange(size) if exit_offset is None else int(exit_offset)
414:         room = (side_index, cols - 1)
415:         rr = 1 + room[0] * (size + 1) + offset
416:         cc = w - 1
417:     else:
418:         side_index = random.randrange(rows) if exit_index is None else int(exit_index)
419:         offset = random.randrange(size) if exit_offset is None else int(exit_offset)
420:         room = (side_index, 0)
421:         rr = 1 + room[0] * (size + 1) + offset
422:         cc = 0
423:     block[rr, cc] = BG
424:     return block, (rr, cc), room
425: 
426: 
427: def _choose_endpoint_axis(length, exit_index):
428:     if length == 1:
429:         return 0
430:     if random.random() < NEAR_EXIT_ENDPOINT_PROB:
431:         return min(length - 1, max(0, exit_index + random.choice(NEAR_EXIT_STEPS)))
432:     far = max(abs(i - exit_index) for i in range(length))
433:     return random.choice([i for i in range(length) if abs(i - exit_index) == far])
434: 
435: 
436: def _choose_endpoint_room(rows, cols, exit_room, exit_side):
437:     er, ec = exit_room
438:     if exit_side == "bottom":
439:         return (0 if rows > 1 else er), _choose_endpoint_axis(cols, ec)
440:     if exit_side == "top":
441:         return (rows - 1 if rows > 1 else er), _choose_endpoint_axis(cols, ec)
442:     if exit_side == "right":
443:         return _choose_endpoint_axis(rows, er), (0 if cols > 1 else ec)
444:     return _choose_endpoint_axis(rows, er), (cols - 1 if cols > 1 else ec)
445: 
446: 
447: def _room_interiors(rows, cols, size, origin_r, origin_c):
448:     rooms = []
449:     for rr in range(rows):
450:         for cc in range(cols):
451:             lr, lc = _room_topleft(rr, cc, size)
452:             rooms.append((origin_r + lr, origin_c + lc, size))
453:     return rooms
454: 
455: 
456: def _paint_endpoint(grid, origin_r, origin_c, room, size, paint):
457:     lr, lc = _room_topleft(*room, size)
458:     grid[origin_r + lr : origin_r + lr + size, origin_c + lc : origin_c + lc + size] = paint
459: 
460: 
461: def _place_vertical(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector):
462:     bh1, bw1 = _block_shape(r1, c1, s1)
463:     bh2, bw2 = _block_shape(r2, c2, s2)
464:     hmin = bh1 + gap + bh2
465:     h = random.randint(max(ROW_MIN, hmin), ROW_MAX)
466:     choice = _side_connector_choice(
467:         max(COL_MIN, bw1, bw2),
468:         COL_MAX,
469:         bw1,
470:         _side_positions(c1, s1),
471:         bw2,
472:         _side_positions(c2, s2),
473:         offset_connector,
474:     )
475:     if choice is None:
476:         return None
477:     w, c_1, c_2, exit_col1, exit_col2, index1, offset1, index2, offset2 = choice
478:     b1, exit1, exit_room1 = _make_block(r1, c1, s1, "bottom", index1, offset1)
479:     b2, exit2, exit_room2 = _make_block(r2, c2, s2, "top", index2, offset2)
480:     top = random.randint(0, h - hmin)
481:     r_1 = top
482:     r_2 = top + bh1 + gap
483:     grid = np.full((h, w), BG, dtype=int)
484:     paste(grid, b1, r_1, c_1)
485:     paste(grid, b2, r_2, c_2)
486:     if exit_col1 == exit_col2:
487:         draw_line(grid, r_1 + exit1[0], exit_col1, end_r=r_2 + exit2[0], end_c=exit_col1, color=BG)
488: 
489:     ep1 = _choose_endpoint_room(r1, c1, exit_room1, "bottom")
490:     ep2 = _choose_endpoint_room(r2, c2, exit_room2, "top")
491:     rooms = _room_interiors(r1, c1, s1, r_1, c_1) + _room_interiors(r2, c2, s2, r_2, c_2)
492:     _paint_endpoint(grid, r_1, c_1, ep1, s1, paint)
493:     _paint_endpoint(grid, r_2, c_2, ep2, s2, paint)
494:     meta = {
495:         "orientation": "vertical",
496:         "gap": gap,
497:         "connector_delta": abs(exit_col2 - exit_col1),
498:         "blocks": [{"rows": r1, "cols": c1, "size": s1}, {"rows": r2, "cols": c2, "size": s2}],
499:     }
500:     return grid, rooms, meta
501: 
502: 
503: def _place_horizontal(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector):
504:     bh1, bw1 = _block_shape(r1, c1, s1)
505:     bh2, bw2 = _block_shape(r2, c2, s2)
506:     wmin = bw1 + gap + bw2
507:     w = random.randint(max(COL_MIN, wmin), COL_MAX)
508:     choice = _side_connector_choice(
509:         max(ROW_MIN, bh1, bh2),
510:         ROW_MAX,
511:         bh1,
512:         _side_positions(r1, s1),
513:         bh2,
514:         _side_positions(r2, s2),
515:         offset_connector,
516:     )
517:     if choice is None:
518:         return None
519:     h, r_1, r_2, exit_row1, exit_row2, index1, offset1, index2, offset2 = choice
520:     b1, exit1, exit_room1 = _make_block(r1, c1, s1, "right", index1, offset1)
521:     b2, exit2, exit_room2 = _make_block(r2, c2, s2, "left", index2, offset2)
522:     left = random.randint(0, w - wmin)
523:     c_1 = left
524:     c_2 = left + bw1 + gap
525:     grid = np.full((h, w), BG, dtype=int)
526:     paste(grid, b1, r_1, c_1)
527:     paste(grid, b2, r_2, c_2)
528:     if exit_row1 == exit_row2:
529:         draw_line(grid, exit_row1, c_1 + exit1[1], end_r=exit_row1, end_c=c_2 + exit2[1], color=BG)
530: 
531:     ep1 = _choose_endpoint_room(r1, c1, exit_room1, "right")
532:     ep2 = _choose_endpoint_room(r2, c2, exit_room2, "left")
533:     rooms = _room_interiors(r1, c1, s1, r_1, c_1) + _room_interiors(r2, c2, s2, r_2, c_2)
534:     _paint_endpoint(grid, r_1, c_1, ep1, s1, paint)
535:     _paint_endpoint(grid, r_2, c_2, ep2, s2, paint)
536:     meta = {
537:         "orientation": "horizontal",
538:         "gap": gap,
539:         "connector_delta": abs(exit_row2 - exit_row1),
540:         "blocks": [{"rows": r1, "cols": c1, "size": s1}, {"rows": r2, "cols": c2, "size": s2}],
541:     }
542:     return grid, rooms, meta
543: 
544: 
545: def _place_layout(layout, paint, offset_connector):
546:     orientation, s1, s2, r1, c1, r2, c2, gap, _ = layout
547:     if orientation == "vertical":
548:         return _place_vertical(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector)
549:     return _place_horizontal(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector)
550: 
551: 
552: def _bfs_path_stats(grid, paint):
553:     """Return one shortest path's distance and turn count between paint components."""
554:     comps = find_components(grid, bg=BG, colors=[paint], connectivity=4)
555:     if len(comps) != 2:
556:         return None
557:     passable = grid != WALL
558:     h, w = grid.shape
559:     dist = np.full((h, w), -1, dtype=int)
560:     parent = np.full((h, w, 2), -2, dtype=int)
561:     q = deque()
562:     for r, c in comps[0]["coords"]:
563:         rr = int(r)
564:         cc = int(c)
565:         if dist[rr, cc] < 0:
566:             dist[rr, cc] = 0
567:             parent[rr, cc] = (-1, -1)
568:             q.append((rr, cc))
569: 
570:     while q:
571:         r, c = q.popleft()
572:         for dr, dc in _NEIGHBORS4:
573:             nr = r + dr
574:             nc = c + dc
575:             if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:
576:                 dist[nr, nc] = dist[r, c] + 1
577:                 parent[nr, nc] = (r, c)
578:                 q.append((nr, nc))
579: 
580:     targets = [(int(r), int(c)) for r, c in comps[1]["coords"] if dist[int(r), int(c)] >= 0]
581:     if len(targets) != len(comps[1]["coords"]):
582:         return None
583:     target = min(targets, key=lambda rc: int(dist[rc]))
584:     shortest = int(dist[target])
585:     path = []
586:     cur = target
587:     while cur != (-1, -1):
588:         path.append(cur)
589:         pr, pc = parent[cur]
590:         cur = (int(pr), int(pc))
591:     path.reverse()
592: 
593:     dirs = []
594:     for (r0, c0), (r1, c1) in zip(path, path[1:]):
595:         dirs.append((r1 - r0, c1 - c0))
596:     turns = sum(1 for a, b in zip(dirs, dirs[1:]) if a != b)
597:     return shortest, turns
598: 
599: 
600: def _shortest_route_mask(grid, comps):
601:     """Return the all-shortest-path mask and distance between endpoint components."""
602:     passable = grid != WALL
603:     dist0 = _distances_from(comps[0]["coords"], passable)
604:     dist1 = _distances_from(comps[1]["coords"], passable)
605:     target_dists = [int(dist0[int(r), int(c)]) for r, c in comps[1]["coords"]]
606:     if any(d < 0 for d in target_dists):
607:         return None
608:     shortest = min(target_dists)
609:     route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)
610:     if not np.any(route):
611:         return None
612:     return route, shortest
613: 
614: 
615: def _endpoint_room_sizes(comps):
616:     sizes = set()
617:     for coords in [comps[0]["coords"], comps[1]["coords"]]:
618:         r0, c0, r1, c1 = bbox_coords(coords)
619:         sizes.add(max(r1 - r0 + 1, c1 - c0 + 1))
620:     return sizes
621: 
622: 
623: def _fill_route_rooms(grid, route, comps):
624:     fill = route.copy()
625:     for r, c, n in _framed_square_rooms(grid, WALL, _endpoint_room_sizes(comps)):
626:         if np.any(route[r : r + n, c : c + n]):
627:             fill[r : r + n, c : c + n] = True
628:     return fill
629: 
630: 
631: def _route_room_set(fill, rooms):
632:     on_route_rooms = set()
633:     for r, c, n in rooms:
634:         if np.any(fill[r : r + n, c : c + n]):
635:             on_route_rooms.add((r, c, n))
636:     return on_route_rooms
637: 
638: 
639: def _room_boundary_cells(r, c, n):
640:     for cc in range(c, c + n):
641:         yield r - 1, cc
642:     for cc in range(c, c + n):
643:         yield r + n, cc
644:     for rr in range(r, r + n):
645:         yield rr, c - 1
646:     for rr in range(r, r + n):
647:         yield rr, c + n
648: 
649: 
650: def _seal_off_route_rooms(grid, rooms, on_route_rooms):
651:     h, w = grid.shape
652:     for r, c, n in rooms:
653:         if (r, c, n) in on_route_rooms:
654:             continue
655:         for rr, cc in _room_boundary_cells(r, c, n):
656:             if 0 <= rr < h and 0 <= cc < w and grid[rr, cc] != WALL:
657:                 grid[rr, cc] = WALL
658: 
659: 
660: def _path_stats_valid(shortest, turns):
661:     return SHORTEST_DISTANCE_MIN <= shortest <= SHORTEST_DISTANCE_MAX and TURN_MIN <= turns <= TURN_MAX
662: 
663: 
664: def _room_counts_valid(on_route, off_route):
665:     return ON_ROUTE_ROOM_MIN <= on_route <= ON_ROUTE_ROOM_MAX and OFF_ROUTE_ROOM_MIN <= off_route <= OFF_ROUTE_ROOM_MAX
666: 
667: 
668: def _solver_accepts(grid):
669:     try:
670:         main(grid)
671:     except Exception:
672:         return False
673:     return True
674: 
675: 
676: def _gen_attempt():
677:     global _LAST_META
678:     layout = _choose_layout()
679:     paint = random.choice(PAINT_COLORS)
680:     placed = _place_layout(layout, paint, random.random() < OFFSET_CONNECTOR_PROB)
681:     if placed is None:
682:         return None
