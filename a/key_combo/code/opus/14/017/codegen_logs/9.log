287: def _place_output_layout(
288:     rows: int, cols: int, sprites: list[dict], marker_colors: list[int]
289: ) -> np.ndarray | None:
290:     """Place final sprites and annotate each with output location and target bend."""
291:     out = np.zeros((rows, cols), dtype=int)
292:     for idx in random.sample(range(len(sprites)), len(sprites)):
293:         loc = _place_component(out, sprites[idx]["patch"])
294:         if loc is None:
295:             return None
296:         r, c = loc
297:         br, bc = sprites[idx]["bend"]
298:         sprites[idx]["out_loc"] = loc
299:         sprites[idx]["target"] = (r + br, c + bc)
300: 
301:     if random.random() < DISTRACTOR_PROBABILITY:
302:         distractor_choices = [c for c in COLORS if c not in marker_colors]
303:         distractor = np.array([[random.choice(distractor_choices)]], dtype=int)
304:         if _place_component(out, distractor) is None:
305:             return None
306:     return out
307: 
