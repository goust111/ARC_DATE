116:     """Return connected masks that span all four sides of the sprite bbox."""
117:     masks = []
118:     for cells in combinations(range(h * w), area):
119:         mask = np.zeros((h, w), dtype=bool)
120:         for cell in cells:
121:             mask[cell // w, cell % w] = True
122:         spans_edges = mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()
123:         if not spans_edges:
