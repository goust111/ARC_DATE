48: BBOX_SIZE_MIN, BBOX_SIZE_MAX_EXCLUSIVE = 2, 6
49: FILL_RATIO_MIN, FILL_RATIO_MAX = 0.4, 0.85
50: SHAPE_OPTION_LIMIT = 12
51: 
52: # Placement constraints.
53: PLACEMENT_BORDER, PLACEMENT_PADDING = 1, 1
