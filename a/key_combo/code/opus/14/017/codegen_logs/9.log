111: def _gen_connected_full_bbox_mask(h, w, count):
112:     corners = [
113:         ((0, 0), (h - 1, w - 1)),
114:         ((0, w - 1), (h - 1, 0)),
115:         ((h - 1, 0), (0, w - 1)),
116:         ((h - 1, w - 1), (0, 0)),
117:     ]
118:     (r, c), (er, ec) = random.choice(corners)
119:     steps = []
120:     steps.extend([(1 if er > r else -1, 0)] * abs(er - r))
121:     steps.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
122:     random.shuffle(steps)
123: 
124:     mask = np.zeros((h, w), dtype=bool)
125:     mask[r, c] = True
126:     for dr, dc in steps:
127:         r += dr
128:         c += dc
129:         mask[r, c] = True
130: 
131:     while int(mask.sum()) < count:
132:         frontier = []
133:         for rr, cc in np.argwhere(mask):
134:             for nr, nc in _gen_neighbors4(int(rr), int(cc), h, w):
135:                 if not mask[nr, nc]:
136:                     frontier.append((nr, nc))
137:         if not frontier:
138:             return None
139:         nr, nc = random.choice(frontier)
140:         mask[nr, nc] = True
141:     return mask
142: 
143: 
144: def _gen_multi_component_mask(h, w, count, k):
145:     seed_sets = _gen_seed_sets(h, w, k)
146:     if not seed_sets:
147:         return None
148: 
149:     labels = np.full((h, w), -1, dtype=int)
150:     for i, (r, c) in enumerate(random.choice(seed_sets)):
151:         labels[r, c] = i
152: 
153:     targets = _gen_split_sizes(count, k)
154:     sizes = [1] * k
155: 
156:     while sizes != targets:
157:         progressed = False
158:         order = [i for i in range(k) if sizes[i] < targets[i]]
159:         random.shuffle(order)
160:         for i in order:
161:             frontier = []
162:             for rr, cc in np.argwhere(labels == i):
163:                 for nr, nc in _gen_neighbors4(int(rr), int(cc), h, w):
164:                     if labels[nr, nc] != -1:
165:                         continue
166:                     touching_other = any(labels[ar, ac] not in (-1, i) for ar, ac in _gen_neighbors4(nr, nc, h, w))
167:                     if not touching_other:
168:                         frontier.append((nr, nc))
169:             if frontier:
170:                 nr, nc = random.choice(frontier)
171:                 labels[nr, nc] = i
172:                 sizes[i] += 1
173:                 progressed = True
174:         if not progressed:
175:             return None
176: 
177:     return labels >= 0
178: 
179: 
180: def _gen_mask(count):
181:     options = _gen_shape_options(count)
182:     random.shuffle(options)
183:     for k, h, w in options[:SHAPE_OPTION_LIMIT]:
184:         if k == 1:
185:             mask = _gen_connected_full_bbox_mask(h, w, count)
186:         else:
187:             mask = _gen_multi_component_mask(h, w, count, k)
188:         if mask is None:
189:             continue
190:         if int(mask.sum()) != count:
191:             continue
192:         if bbox(mask) != (0, 0, h - 1, w - 1):
193:             continue
194:         if len(components_mask(mask, connectivity=4)) != k:
195:             continue
196:         return mask
197:     return None
198: 
