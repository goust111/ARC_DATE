12: def _l_bend(body_coords: np.ndarray) -> tuple[int, int]:
13:     """Return the corner cell where the two one-cell-wide L legs meet."""
14:     coords = [tuple(map(int, rc)) for rc in body_coords]
15:     assert coords, "body must contain pixels"
16:     coord_set = set(coords)
17:     r0, c0, r1, c1 = bbox_coords(np.array(coords, dtype=int))
18:     corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
19: 
20:     bends = []
21:     for r, c in coords:
22:         if (r, c) not in corners:
23:             continue
24:         nbr_dirs = [(dr, dc) for dr, dc in _DIRS4 if (r + dr, c + dc) in coord_set]
25:         has_vertical = any(dc == 0 for dr, dc in nbr_dirs)
26:         has_horizontal = any(dr == 0 for dr, dc in nbr_dirs)
27:         if has_vertical and has_horizontal:
28:             bends.append((r, c))
29: 
30:     assert len(bends) == 1, f"expected one L bend, got {bends}"
31:     return bends[0]
32: 
