240: # ---------------------------------------------------------------------------
241: # Line growth
242: # ---------------------------------------------------------------------------
243: 
244: def _grow_line(grid, start, line_col, target_len, rng):
245:     """Grow a meandering 8-connected 1px-wide path of line_col from start."""
246:     h, w = grid.shape
247:     path = [start]
248:     dr_bias = 1 if start[0] < h // 2 else -1
249:     dc_bias = 1 if start[1] < w // 2 else -1
250:     cur = start
251:     path_set = {start}
252:     while len(path) < target_len:
253:         # Build weighted direction list: diagonals preferred, bias-aligned boosted
254:         dirs = []
255:         for ddr, ddc in DIAG_DIRS:
256:             aligned = (ddr == dr_bias or ddc == dc_bias)
257:             w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER
258:             dirs.extend([(ddr, ddc)] * w_d)
259:         for ddr, ddc in ORTHO_DIRS:
260:             aligned = (ddr == dr_bias and ddc == 0) or (ddc == dc_bias and ddr == 0)
261:             w_d = ORTHO_WEIGHT_ALIGNED if aligned else ORTHO_WEIGHT_OTHER
262:             dirs.extend([(ddr, ddc)] * w_d)
263:         rng.shuffle(dirs)
264:         placed = False
265:         for ddr, ddc in dirs:
266:             nr, nc = cur[0] + ddr, cur[1] + ddc
267:             if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:
268:                 continue
269:             # Keep path thin: reject if 8-adjacent to existing path (except cur)
270:             if any((nnr, nnc) != cur and (nnr, nnc) in path_set
271:                    for nnr, nnc in neighbors8(nr, nc)):
272:                 continue
273:             # Strongly avoid grid border
274:             if (nr == 0 or nc == 0 or nr == h - 1 or nc == w - 1) and rng.random() < BORDER_AVOIDANCE_PROB:
275:                 continue
276:             cur = (nr, nc)
277:             path.append(cur)
278:             path_set.add(cur)
279:             grid[nr, nc] = line_col
280:             placed = True
281:             break
282:         if not placed:
283:             if rng.random() < BIAS_FLIP_PROB:
284:                 dr_bias *= -1
285:             if rng.random() < BIAS_FLIP_PROB:
286:                 dc_bias *= -1
287:             break
288:     return path
289: 
