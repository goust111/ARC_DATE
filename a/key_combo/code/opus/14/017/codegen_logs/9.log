235:             allowed = {(ar, ac)}
236:             if idx > 0:
237:                 allowed.add(path[idx - 1])
238:             if idx + 1 < len(path):
239:                 allowed.add(path[idx + 1])
240:             for nr, nc in neighbors4(r, c):
241:                 if (
242:                     in_bounds(g.shape, nr, nc)
243:                     and g[nr, nc] == _GEN_BLUE
244:                     and (nr, nc) not in allowed
245:                 ):
246:                     ok = False
247:                     break
248:                 if (nr, nc) in path_set and (nr, nc) not in allowed:
249:                     ok = False
250:                     break
251:             if not ok:
252:                 break
253:         if ok:
254:             out.append(path)
255:     return out
256: 
257: 
258: def _gen_add_tail_lengths(
259:     g: np.ndarray, boxes: list[tuple[int, int, int, int]], tail_lengths: tuple[int, ...]
260: ) -> bool:
261:     if not tail_lengths:
262:         return True
263:     configs = []
264:     for box_order in permutations(range(len(boxes)), len(tail_lengths)):
265:         for length_order in set(permutations(tail_lengths)):
266:             configs.append((box_order, length_order))
267:     random.shuffle(configs)
268: 
269:     for box_order, length_order in configs:
270:         temp = g.copy()
271:         ok = True
272:         for box_idx, length in zip(box_order, length_order):
273:             paths = _gen_tail_candidates(temp, boxes[box_idx], length)
274:             if not paths:
275:                 ok = False
276:                 break
277:             for r, c in random.choice(paths):
278:                 temp[r, c] = _GEN_BLUE
279:         if ok:
280:             g[:, :] = temp
281:             return True
282:     return False
283: 
284: 
285: def _gen_integer_parts(total: int, count: int, minimum: int) -> list[tuple[int, ...]]:
286:     if count == 0:
287:         return [()] if total == 0 else []
288:     out = []
289:     max_first = total - minimum * (count - 1)
290:     for first in range(minimum, max_first + 1):
291:         for rest in _gen_integer_parts(total - first, count - 1, minimum):
292:             out.append((first,) + rest)
293:     return out
294: 
295: 
296: def _gen_appendage_plans(
297:     loop_count: int, append_total: int, target_blue: int
298: ) -> list[tuple[tuple[int, ...], tuple[int, ...]]]:
299:     plans = []
300:     max_open = _GEN_MAX_BLUE_COMPONENTS - loop_count
301:     for tail_count in range(0, min(_GEN_MAX_TAILS, loop_count, append_total) + 1):
302:         min_tail_total = tail_count * _GEN_MIN_TAIL_LENGTH
303:         for tail_total in range(min_tail_total, append_total + 1):
304:             for tail_lengths in _gen_integer_parts(
305:                 tail_total, tail_count, _GEN_MIN_TAIL_LENGTH
306:             ):
307:                 remaining = append_total - sum(tail_lengths)
308:                 for open_count in range(
309:                     0, min(max_open, remaining // _GEN_MIN_OPEN_PATH_LENGTH) + 1
310:                 ):
311:                     for open_lengths in _gen_integer_parts(
312:                         remaining, open_count, _GEN_MIN_OPEN_PATH_LENGTH
313:                     ):
314:                         endpoints = tail_count + 2 * open_count
315:                         branches = tail_count
316:                         degree2 = (target_blue - endpoints - branches) / target_blue
317:                         if (
318:                             _GEN_MIN_ENDPOINTS <= endpoints <= _GEN_MAX_ENDPOINTS
319:                             and branches <= _GEN_MAX_BRANCHES
320:                             and _GEN_DEGREE2_MIN <= degree2 <= _GEN_DEGREE2_MAX
321:                         ):
322:                             plans.append((tail_lengths, open_lengths))
323:     return plans
324: 
325: 
326: def _gen_open_path_candidates(g: np.ndarray, length: int) -> list[list[tuple[int, int]]]:
327:     black_labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
328:     if n_labels == 0:
329:         return []
330:     exterior = max(
331:         range(1, n_labels + 1), key=lambda label_id: int(np.sum(black_labels == label_id))
332:     )
333:     eligible = black_labels == exterior
334: 
335:     def cell_ok(r: int, c: int) -> bool:
336:         if not (
337:             _GEN_LOOP_MARGIN <= r < _GEN_H - _GEN_LOOP_MARGIN
338:             and _GEN_LOOP_MARGIN <= c < _GEN_W - _GEN_LOOP_MARGIN
339:         ):
340:             return False
341:         if not eligible[r, c] or g[r, c] != _GEN_BLACK:
342:             return False
343:         return all(
344:             not (in_bounds(g.shape, nr, nc) and g[nr, nc] == _GEN_BLUE)
345:             for nr, nc in neighbors4(r, c)
346:         )
347: 
348:     starts = [(int(r), int(c)) for r, c in np.argwhere(eligible)]
349:     random.shuffle(starts)
350:     out: list[list[tuple[int, int]]] = []
351: 
352:     def extend(path: list[tuple[int, int]]) -> None:
353:         if len(out) >= _GEN_MAX_PATH_CANDIDATES:
354:             return
355:         if len(path) == length:
356:             out.append(path.copy())
357:             return
358:         last_r, last_c = path[-1]
359:         next_cells = list(neighbors4(last_r, last_c))
360:         random.shuffle(next_cells)
361:         used = set(path)
362:         for nr, nc in next_cells:
363:             if not in_bounds(g.shape, nr, nc) or not cell_ok(nr, nc) or (nr, nc) in used:
364:                 continue
365:             if any(
366:                 (ar, ac) in used and (ar, ac) != path[-1]
367:                 for ar, ac in neighbors4(nr, nc)
368:             ):
369:                 continue
370:             path.append((nr, nc))
371:             extend(path)
372:             path.pop()
373: 
374:     for start in starts:
375:         if len(out) >= _GEN_MAX_PATH_CANDIDATES:
376:             break
377:         if cell_ok(*start):
378:             extend([start])
379:     return out
380: 
381: 
382: def _gen_add_open_paths(g: np.ndarray, lengths: tuple[int, ...]) -> bool:
383:     lengths = tuple(sorted(lengths, reverse=True))
384:     for length in lengths:
385:         paths = _gen_open_path_candidates(g, length)
386:         if not paths:
387:             return False
388:         for r, c in random.choice(paths):
389:             g[r, c] = _GEN_BLUE
390:     return True
391: 
392: 
393: def _gen_add_appendages(
394:     g: np.ndarray,
395:     boxes: list[tuple[int, int, int, int]],
396:     append_total: int,
397:     target_blue: int,
398: ) -> bool:
399:     plans = _gen_appendage_plans(len(boxes), append_total, target_blue)
400:     by_endpoint: dict[int, list[tuple[tuple[int, ...], tuple[int, ...]]]] = {}
401:     for plan in plans:
402:         endpoint_count = len(plan[0]) + 2 * len(plan[1])
403:         by_endpoint.setdefault(endpoint_count, []).append(plan)
404: 
405:     endpoint_order = sorted(by_endpoint)
406:     if endpoint_order:
407:         first = random.choices(endpoint_order, weights=[ep * ep for ep in endpoint_order], k=1)[0]
408:         endpoint_order.remove(first)
409:         random.shuffle(endpoint_order)
410:         endpoint_order.insert(0, first)
411: 
412:     for endpoint_count in endpoint_order:
413:         endpoint_plans = by_endpoint[endpoint_count]
414:         random.shuffle(endpoint_plans)
415:         for tail_lengths, open_lengths in endpoint_plans:
416:             temp = g.copy()
417:             if not _gen_add_tail_lengths(temp, boxes, tail_lengths):
418:                 continue
419:             if not _gen_add_open_paths(temp, open_lengths):
420:                 continue
421:             g[:, :] = temp
422:             return True
423:     return False
424: 
425: 
426: def _gen_marker_cells(g: np.ndarray) -> set[tuple[int, int]]:
427:     return {
428:         (int(r), int(c))
429:         for r, c in np.argwhere(_gen_marker_mask(g))
430:     }
431: 
432: 
433: def _gen_no_marker_neighbor(
434:     r: int, c: int, markers: list[tuple[int, int]]
435: ) -> bool:
436:     for mr, mc in markers:
437:         if max(abs(int(r) - mr), abs(int(c) - mc)) <= _GEN_MARKER_NEIGHBOR_RADIUS:
438:             return False
439:     return True
440: 
441: 
442: def _gen_component_after_marker_ok(mask: np.ndarray, r: int, c: int) -> tuple[bool, int]:
443:     rest = mask.copy()
444:     rest[r, c] = False
445:     labels, n_labels = label_mask(rest, connectivity=4)
446:     if n_labels == 0:
447:         return False, 0
448:     for label_id in range(1, n_labels + 1):
449:         coords = np.argwhere(labels == label_id)
450:         if len(coords) < _GEN_BLACK_COMPONENT_MIN_AREA:
451:             return False, n_labels
452:         touches = False
453:         for nr, nc in neighbors4(r, c):
454:             if in_bounds(mask.shape, nr, nc) and labels[nr, nc] == label_id:
455:                 touches = True
456:                 break
457:         if not touches:
458:             return False, n_labels
459:     return True, n_labels
460: 
461: 
462: def _gen_required_marker_candidates(
463:     g: np.ndarray,
464:     labels: np.ndarray,
465:     label_id: int,
466:     markers: list[tuple[int, int]],
467: ) -> list[tuple[int, int]]:
468:     comp_mask = labels == label_id
469:     candidates = []
470:     for r, c in np.argwhere(comp_mask):
471:         r = int(r)
472:         c = int(c)
473:         if g[r, c] != _GEN_BLACK or not _gen_no_marker_neighbor(r, c, markers):
474:             continue
475:         blue_adj = _gen_count_blue_neighbors(g, r, c)
476:         if blue_adj == 0:
477:             continue
478:         ok, split_count = _gen_component_after_marker_ok(comp_mask, r, c)
479:         if ok:
480:             candidates.append((split_count, -blue_adj, r, c))
481:     random.shuffle(candidates)
482:     candidates.sort()
483:     return [(r, c) for _, _, r, c in candidates]
484: 
485: 
486: def _gen_coords_touch_markers(coords: np.ndarray, markers: set[tuple[int, int]]) -> bool:
487:     for r, c in coords:
488:         for nr, nc in neighbors4(int(r), int(c)):
489:             if (nr, nc) in markers:
490:                 return True
491:     return False
492: 
493: 
494: def _gen_components_touch_markers(g: np.ndarray) -> bool:
495:     markers = _gen_marker_cells(g)
496:     if not markers:
497:         return False
498:     for color in _GEN_BASE_COLORS:
499:         labels, n_labels = label_mask(g == color, connectivity=4)
500:         if n_labels == 0:
501:             return False
502:         for label_id in range(1, n_labels + 1):
503:             coords = np.argwhere(labels == label_id)
504:             if color == _GEN_BLACK and not (
505:                 _GEN_BLACK_COMPONENT_MIN_AREA <= len(coords) <= _GEN_BLACK_COMPONENT_MAX_AREA
506:             ):
507:                 return False
508:             if not _gen_coords_touch_markers(coords, markers):
509:                 return False
510:     return True
511: 
512: 
513: def _gen_black_side_ok(g: np.ndarray) -> bool:
514:     markers = _gen_marker_cells(g)
515:     labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
516:     if not (_GEN_BLACK_COMPONENT_MIN_COUNT <= n_labels <= _GEN_BLACK_COMPONENT_MAX_COUNT):
517:         return False
518:     for label_id in range(1, n_labels + 1):
519:         coords = np.argwhere(labels == label_id)
520:         if not (
521:             _GEN_BLACK_COMPONENT_MIN_AREA <= len(coords) <= _GEN_BLACK_COMPONENT_MAX_AREA
522:         ):
523:             return False
524:         if not _gen_coords_touch_markers(coords, markers):
525:             return False
526:     return True
527: 
528: 
529: def _gen_blue_component_touched(
530:     g: np.ndarray, labels: np.ndarray, label_id: int
531: ) -> bool:
532:     markers = _gen_marker_cells(g)
533:     return _gen_coords_touch_markers(np.argwhere(labels == label_id), markers)
534: 
535: 
536: def _gen_cover_blue_components(
537:     g: np.ndarray, markers: list[tuple[int, int]]
538: ) -> list[tuple[int, int]] | None:
539:     for _ in range(_GEN_COVER_BLUE_RETRIES):
540:         labels, n_labels = label_mask(g == _GEN_BLUE, connectivity=4)
541:         uncovered = [
542:             label_id
543:             for label_id in range(1, n_labels + 1)
544:             if not _gen_blue_component_touched(g, labels, label_id)
545:         ]
546:         if not uncovered:
547:             return markers
548:         label_id = random.choice(uncovered)
549:         candidates = set()
550:         for r, c in np.argwhere(labels == label_id):
551:             for nr, nc in neighbors4(int(r), int(c)):
552:                 if in_bounds(g.shape, nr, nc) and g[nr, nc] == _GEN_BLACK:
553:                     candidates.add((nr, nc))
554:         scored = []
555:         for r, c in candidates:
556:             if not _gen_no_marker_neighbor(r, c, markers):
557:                 continue
558:             temp = g.copy()
559:             temp[r, c] = _GEN_TEMP_MARKER
560:             if _gen_black_side_ok(temp):
561:                 blue_adj = _gen_count_blue_neighbors(temp, r, c)
562:                 scored.append((blue_adj, r, c))
563:         if not scored or len(markers) >= _GEN_MARKER_MAX_COUNT:
564:             return None
565:         random.shuffle(scored)
566:         scored.sort(reverse=True)
567:         _, r, c = random.choice(_gen_top_choices(scored, _GEN_BLUE_COVER_TOP_K))
568:         g[r, c] = _GEN_TEMP_MARKER
569:         markers.append((r, c))
570:     return None
571: 
572: 
573: def _gen_blue_stats(g: np.ndarray) -> tuple[int, int, float]:
574:     blue = g == _GEN_BLUE
575:     if not np.any(blue):
576:         return 0, 0, 0.0
577:     degrees = np.zeros(g.shape, dtype=int)
578:     degrees[1:, :] += blue[:-1, :]
579:     degrees[:-1, :] += blue[1:, :]
580:     degrees[:, 1:] += blue[:, :-1]
581:     degrees[:, :-1] += blue[:, 1:]
582:     blue_degrees = degrees[blue]
583:     endpoints = int(np.sum(blue_degrees == 1))
584:     branches = int(np.sum(blue_degrees >= 3))
585:     degree2 = float(np.sum(blue_degrees == 2) / len(blue_degrees))
586:     return endpoints, branches, degree2
587: 
588: 
589: def _gen_base_ok(g: np.ndarray) -> bool:
590:     if g.shape != _GEN_SHAPE:
591:         return False
592:     blue_total = int(np.sum(g == _GEN_BLUE))
593:     if not (_GEN_BLUE_TOTAL_MIN <= blue_total <= _GEN_BLUE_TOTAL_MAX):
594:         return False
595: 
596:     black_labels, black_count = label_mask(g == _GEN_BLACK, connectivity=4)
597:     _, blue_count = label_mask(g == _GEN_BLUE, connectivity=4)
598:     if not (
599:         _GEN_BLACK_COMPONENT_MIN_COUNT <= black_count <= _GEN_BLACK_COMPONENT_MAX_COUNT
600:         and _GEN_BLUE_COMPONENT_MIN_COUNT <= blue_count <= _GEN_BLUE_COMPONENT_MAX_COUNT
601:     ):
602:         return False
603: 
604:     for label_id in range(1, black_count + 1):
605:         area = int(np.sum(black_labels == label_id))
606:         if not (_GEN_BLACK_COMPONENT_MIN_AREA <= area <= _GEN_BLACK_COMPONENT_MAX_AREA):
607:             return False
608: 
609:     endpoints, branches, degree2 = _gen_blue_stats(g)
610:     if not (
611:         _GEN_MIN_ENDPOINTS <= endpoints <= _GEN_MAX_ENDPOINTS
612:         and 0 <= branches <= _GEN_MAX_BRANCHES
613:         and _GEN_DEGREE2_MIN <= degree2 <= _GEN_DEGREE2_MAX
614:     ):
615:         return False
616: 
617:     return _gen_components_touch_markers(g)
618: 
619: 
620: def _gen_place_required_markers(g: np.ndarray) -> list[tuple[int, int]] | None:
621:     labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
622:     component_ids = list(range(1, n_labels + 1))
623:     random.shuffle(component_ids)
624:     component_ids.sort(key=lambda i: int(np.sum(labels == i)))
625: 
626:     markers: list[tuple[int, int]] = []
627:     for label_id in component_ids:
628:         candidates = _gen_required_marker_candidates(g, labels, label_id, markers)
629:         if not candidates:
630:             return None
631:         r, c = random.choice(_gen_top_choices(candidates, _GEN_REQUIRED_MARKER_TOP_K))
632:         g[r, c] = _GEN_TEMP_MARKER
633:         markers.append((r, c))
634:     markers = _gen_cover_blue_components(g, markers)
635:     if markers is None or len(markers) > _GEN_MARKER_MAX_COUNT:
636:         return None
637:     if not _gen_base_ok(g):
638:         return None
639:     return markers
640: 
641: 
642: def _gen_extra_marker_candidates(
643:     g: np.ndarray, markers: list[tuple[int, int]]
644: ) -> list[tuple[int, int]]:
645:     candidates = []
646:     for r, c in np.argwhere(g == _GEN_BLACK):
647:         r = int(r)
648:         c = int(c)
649:         if not _gen_no_marker_neighbor(r, c, markers):
650:             continue
651:         blue_adj = _gen_count_blue_neighbors(g, r, c)
652:         if blue_adj == 0:
653:             continue
654:         temp = g.copy()
655:         temp[r, c] = _GEN_TEMP_MARKER
656:         if _gen_base_ok(temp):
657:             candidates.append((blue_adj, r, c))
658:     random.shuffle(candidates)
659:     candidates.sort(reverse=True)
660:     return [(r, c) for _, r, c in candidates]
661: 
662: 
663: def _gen_assign_marker_colors(
664:     g: np.ndarray, markers: list[tuple[int, int]]
665: ) -> None:
666:     n_markers = len(markers)
667:     if n_markers == _GEN_MARKER_MAX_COUNT:
668:         colors = list(random.sample(_GEN_MARKER_COLORS, _GEN_MARKER_MAX_DISTINCT))
669:         colors.append(random.choice(colors))
670:     elif (
671:         n_markers >= _GEN_MARKER_MIN_COUNT + 1
672:         and random.random() < _GEN_DUPLICATE_MARKER_PROB
673:     ):
674:         colors = list(random.sample(_GEN_MARKER_COLORS, n_markers - 1))
675:         colors.append(random.choice(colors))
676:     else:
677:         colors = list(random.sample(_GEN_MARKER_COLORS, n_markers))
678:     random.shuffle(colors)
679:     for (r, c), color in zip(markers, colors):
680:         g[r, c] = color
681: 
682: 
683: def _gen_final_ok(g: np.ndarray) -> bool:
684:     if not _gen_base_ok(g):
685:         return False
686: 
687:     marker_values = [
688:         int(g[r, c])
689:         for r, c in np.argwhere(_gen_marker_mask(g))
690:     ]
691:     marker_count = len(marker_values)
692:     distinct = len(set(marker_values))
693:     counts = Counter(marker_values)
694:     if not (
695:         _GEN_MARKER_MIN_COUNT <= marker_count <= _GEN_MARKER_MAX_COUNT
696:         and _GEN_MARKER_MIN_DISTINCT <= distinct <= _GEN_MARKER_MAX_DISTINCT
697:     ):
698:         return False
699:     if (
700:         any(v > _GEN_MAX_DUPLICATES_PER_COLOR for v in counts.values())
701:         or sum(1 for v in counts.values() if v == _GEN_MAX_DUPLICATES_PER_COLOR)
702:         > _GEN_MAX_DUPLICATED_COLORS
703:     ):
704:         return False
705: 
706:     markers = _gen_marker_cells(g)
707:     for r, c in markers:
708:         for dr in range(-_GEN_MARKER_NEIGHBOR_RADIUS, _GEN_MARKER_NEIGHBOR_RADIUS + 1):
709:             for dc in range(-_GEN_MARKER_NEIGHBOR_RADIUS, _GEN_MARKER_NEIGHBOR_RADIUS + 1):
710:                 if dr == 0 and dc == 0:
711:                     continue
712:                 if (r + dr, c + dc) in markers:
713:                     return False
714: 
715:     try:
716:         out = main(g)
717:     except Exception:
718:         return False
719:     out_colors = set(map(int, np.unique(out)))
720:     if (
721:         _GEN_BLACK in out_colors
722:         or _GEN_BLUE in out_colors
723:         or len(out_colors) < _GEN_MIN_OUTPUT_COLORS
724:     ):
725:         return False
726:     return out_colors <= set(marker_values)
727: 
728: 
729: def _gen_select_loop_design() -> tuple[int, list[tuple[int, int]], int] | None:
730:     """Choose blue target, loop sizes, and appendage cell budget."""
731:     target_blue = random.randint(_GEN_BLUE_TOTAL_MIN, _GEN_BLUE_TOTAL_MAX)
732:     combo_options = list(_GEN_COMBOS_BY_TOTAL[target_blue])
733:     if not combo_options:
734:         return None
735:     loop_counts = sorted({len(combo) for combo in combo_options})
736:     loop_count = random.choice(loop_counts)
737:     count_options = [combo for combo in combo_options if len(combo) == loop_count]
738:     sizes = list(random.choice(count_options))
739:     random.shuffle(sizes)
740:     base_blue = sum(_gen_perimeter(size) for size in sizes)
741:     append_total = target_blue - base_blue
742:     return target_blue, sizes, append_total
743: 
744: 
745: def _gen_build_blue_walls(
746:     target_blue: int, sizes: list[tuple[int, int]], append_total: int
747: ) -> np.ndarray | None:
748:     """Render loop walls and appendages before marker placement."""
749:     boxes = _gen_place_rectangles(sizes)
750:     if boxes is None:
751:         return None
752: 
753:     g = np.zeros(_GEN_SHAPE, dtype=int)
754:     for box in boxes:
755:         _gen_draw_loop(g, box)
756:     if not _gen_add_appendages(g, boxes, append_total, target_blue):
757:         return None
758:     if int(np.sum(g == _GEN_BLUE)) != target_blue:
759:         return None
760:     return g
761: 
762: 
763: def _gen_add_extra_markers(g: np.ndarray, markers: list[tuple[int, int]]) -> bool:
764:     desired_markers = random.randint(
765:         max(_GEN_MARKER_MIN_COUNT, len(markers)), _GEN_MARKER_MAX_COUNT
766:     )
767:     while len(markers) < desired_markers:
768:         candidates = _gen_extra_marker_candidates(g, markers)
769:         if not candidates:
770:             return False
771:         r, c = random.choice(_gen_top_choices(candidates, _GEN_EXTRA_MARKER_TOP_K))
772:         g[r, c] = _GEN_TEMP_MARKER
773:         markers.append((r, c))
774:     return True
775: 
776: 
777: def _gen_attempt() -> np.ndarray | None:
778:     design = _gen_select_loop_design()
779:     if design is None:
780:         return None
781:     target_blue, sizes, append_total = design
782: 
783:     g = _gen_build_blue_walls(target_blue, sizes, append_total)
784:     if g is None:
785:         return None
786: 
