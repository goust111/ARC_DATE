34: def _outer_diagonal_distance(
35:     anchor: tuple[int, int], marker: tuple[int, int], target: tuple[int, int]
36: ) -> int:
37:     """Return distance when target is on the outer 45-degree ray from the L bend."""
38:     mr = marker[0] - anchor[0]
39:     mc = marker[1] - anchor[1]
40:     assert abs(mr) == 1 and abs(mc) == 1, "marker must be diagonally adjacent to L bend"
41: 
42:     tr = target[0] - anchor[0]
43:     tc = target[1] - anchor[1]
44:     dist = -tr * mr
45:     assert dist >= 1 and tr == -mr * dist and tc == -mc * dist, (
46:         "control must lie on the outer 45-degree ray from the L bend"
47:     )
48:     return dist
