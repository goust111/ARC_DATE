56: def _gen_neighbors4(r, c, h, w):
57:     for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
58:         if 0 <= rr < h and 0 <= cc < w:
59:             yield rr, cc
60: 
61: 
62: def _gen_count_triplet():
63:     triples = [
64:         (a, b, c)
65:         for a, b, c in itertools.combinations(range(COUNT_MIN, COUNT_MAX_EXCLUSIVE), COLOR_COUNT)
66:         if TOTAL_COUNT_MIN <= a + b + c <= TOTAL_COUNT_MAX
67:     ]
68:     counts = list(random.choice(triples))
69:     random.shuffle(counts)
70:     return counts
71: 
