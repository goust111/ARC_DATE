208: def _bridge_cells(fa: dict, fb: dict) -> set[tuple[int, int]]:
209:     (r0a, c0a, r1a, c1a) = map(int, fa["bbox"])
210:     (r0b, c0b, r1b, c1b) = map(int, fb["bbox"])
211:     ia = fa["inner_bbox"]
212:     ib = fb["inner_bbox"]
213:     # same-row band
214:     if int(ia[0]) == int(ib[0]) and int(ia[2]) == int(ib[2]):
215:         rr0, rr1 = int(ia[0]), int(ia[2])
216:         if int(c1a) < int(c0b):
217:             cc0, cc1 = int(c1a + 1), int(c0b - 1)
218:         else:
219:             cc0, cc1 = int(c1b + 1), int(c0a - 1)
220:         assert int(cc0) <= int(cc1), "horizontal bridge gap must be non-empty"
221:         return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}
222:     # same-col band
223:     if int(ia[1]) == int(ib[1]) and int(ia[3]) == int(ib[3]):
224:         cc0, cc1 = int(ia[1]), int(ia[3])
225:         if int(r1a) < int(r0b):
226:             rr0, rr1 = int(r1a + 1), int(r0b - 1)
227:         else:
228:             rr0, rr1 = int(r1b + 1), int(r0a - 1)
229:         assert int(rr0) <= int(rr1), "vertical bridge gap must be non-empty"
230:         return {(int(r), int(c)) for r in range(int(rr0), int(rr1) + 1) for c in range(int(cc0), int(cc1) + 1)}
231:     return set()
