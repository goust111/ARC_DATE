+        "sprite_counts": sprite_counts,
+        "distractors_outside": distractors_outside,
+        "marker_pixels_outside": marker_pixels_outside,
+        "bodies_by_marker": bodies_by_marker,
+        "markers_by_body": markers_by_body,
+    }
