41: def main(grid: np.ndarray) -> np.ndarray:
42:     """
43:     Fill enclosed regions along a line seeded by unique border pixels.
44: 
45:     Input structure:
46:     - bg = most common color.
47:     - Colored lines/drawings on the grid.
48:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.
49: 
50:     Rule:
51:     - Each border seed pixel connects (8-connected) to a line drawing.
52:     - Find closed bg cavities whose boundary touches that line.
53:     - Flood-fill each such cavity with the seed pixel's color.
54: 
55:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.
56:     """
57:     g = np.asarray(grid, dtype=int)
58:     h, w = g.shape
59:     bg = get_bg(g)
60: 
61:     out = g.copy()
62: 
63:     # Precompute background regions (4-connected). Exclude those containing background corners as "outside".
64:     bg_comps = _components_mask(g == bg, conn8=False)
65:     regions = []  # list of (set_pts, boundary_set, touches_border, size)
66:     for pts in bg_comps:
67:         region = set(pts)
68:         touches = _touches_border(pts, h, w)
69:         boundary = set()
70:         for r, c in region:
71:             for nr, nc in neighbors4(r, c):
72:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:
73:                     boundary.add((nr, nc))
74:         regions.append((region, boundary, touches, len(region)))
75: 
76:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
77:     outside_idxs = set()
78:     for i, (reg, _, _, _) in enumerate(regions):
79:         if any(p in reg for p in corners if int(g[p]) == bg):
80:             outside_idxs.add(i)
81: 
82:     cavities = []
83:     for i, (reg, bnd, _, _) in enumerate(regions):
84:         if i in outside_idxs or not bnd:
85:             continue
86:         bcols = {int(g[p]) for p in bnd}
87:         cavities.append((reg, bnd, bcols))
88: 
89:     for sr, sc in _seed_pixels(g, bg):
90:         seed_col = int(g[sr, sc])
91: 
92:         neigh_cols = []
93:         for nr, nc in neighbors4(sr, sc):
94:             if 0 <= nr < h and 0 <= nc < w:
95:                 v = int(g[nr, nc])
96:                 if v != bg:
97:                     neigh_cols.append(v)
98:         assert neigh_cols, "seed pixel must have at least one non-bg neighbor"
99:         line_col = Counter(neigh_cols).most_common(1)[0][0]
100: 
101:         # Trace the connected "drawing" reachable from the seed (8-connected, non-background).
102:         traced = _nonbg_component8_from(g, (sr, sc), bg)
103: 
104:         for cav, boundary, bcols in cavities:
105:             if len(bcols) != 1:
106:                 continue
107:             boundary_in_traced = boundary & traced
108:             if not boundary_in_traced:
109:                 continue
110: 
111:             # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.
112:             # This prevents filling regions that are only connected through other structures, not the line itself.
113:             ok = False
114:             for r, c in boundary_in_traced:
115:                 for nr, nc in neighbors8(r, c):
116:                     if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:
117:                         ok = True
118:                         break
119:                 if ok:
120:                     break
121:             if not ok:
122:                 continue
123: 
124:             for r, c in cav:
125:                 if int(out[r, c]) == bg:
126:                     out[r, c] = seed_col
127: 
128:     return out
