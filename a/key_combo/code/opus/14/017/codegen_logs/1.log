+def _assemble_input(left_mask: np.ndarray, right_mask: np.ndarray) -> np.ndarray:
+    grid = np.zeros(INPUT_SHAPE, dtype=int)
+    grid[:, SEPARATOR_COL] = RED
+    grid[:, :MASK_SIZE][left_mask] = ORANGE
+    grid[:, SEPARATOR_COL + 1 :][right_mask] = ORANGE
+    return grid
