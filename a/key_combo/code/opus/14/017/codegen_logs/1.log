+        wall[-1, prongs[0] : prongs[-1] + 1] = True
+        shared[-1, prongs[0] : prongs[-1] + 1] = True
+        for c in prongs:
+            wall[:, c] = True
+    elif attach == "left":
+        wall[prongs[0] : prongs[-1] + 1, 0] = True
+        shared[prongs[0] : prongs[-1] + 1, 0] = True
+        for r in prongs:
+            wall[r, :] = True
+    else:
+        assert attach == "right"
+        wall[prongs[0] : prongs[-1] + 1, -1] = True
+        shared[prongs[0] : prongs[-1] + 1, -1] = True
+        for r in prongs:
+            wall[r, :] = True
