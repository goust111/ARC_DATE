+def _split_wall_masks(attach: str, prongs: tuple[int, ...], shared: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    left_mask = shared.copy()
+    right_mask = shared.copy()
+    start_left = 0 if attach in {"top", "left"} else 1
