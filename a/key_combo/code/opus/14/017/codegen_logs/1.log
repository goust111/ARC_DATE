+    for r, c in np.argwhere(wall):
+        if 0 < r < h - 1:
+            a = int(labels[r - 1, c])
+            b = int(labels[r + 1, c])
+            if a > 0 and b > 0 and a != b:
+                graph[a].add(b)
+                graph[b].add(a)
+        if 0 < c < w - 1:
+            a = int(labels[r, c - 1])
+            b = int(labels[r, c + 1])
+            if a > 0 and b > 0 and a != b:
