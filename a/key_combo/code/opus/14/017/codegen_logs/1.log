+    if attach in {"top", "bottom"}:
+        for index, c in enumerate(prongs):
+            owner_left = (index + start_left) % 2 == 0
+            if owner_left:
+                left_mask[:, c] = True
+            else:
+                right_mask[:, c] = True
+    else:
