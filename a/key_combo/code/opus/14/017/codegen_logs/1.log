+def _build_comb_wall(attach: str, prongs: tuple[int, ...]) -> tuple[np.ndarray, np.ndarray]:
+    wall = np.zeros((MASK_SIZE, MASK_SIZE), dtype=bool)
+    shared = np.zeros_like(wall)
+
