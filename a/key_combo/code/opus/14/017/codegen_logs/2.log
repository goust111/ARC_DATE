+
+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+MAROON = 9
+
+MAX_GENERATE_ATTEMPTS = 1200
+HEIGHT_RANGE = (13, 19)
+WIDTH_RANGE = (13, 19)
