+    return {
+        "color": color,
+        "orientation": orientation,
+        "endpoint": endpoint,
+        "hinge": hinge,
+        "fixed_cells": fixed_cells,
+        "tail_cells": tail_cells,
+        "fixed_step": fixed_step,
+        "tail_step": tail_step,
+        "fold_step": fold_step,
+    }
