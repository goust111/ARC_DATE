+        assert endpoint[0] == hinge[0] == r, "horizontal rod markers must share one row"
+        assert endpoint[1] in (min_c, max_c), "endpoint must sit at one end of the rod"
+        assert min_c < hinge[1] < max_c, "hinge must be interior"
