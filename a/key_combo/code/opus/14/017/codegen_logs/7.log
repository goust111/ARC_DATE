+    bboxes: list[tuple[int, int, int, int]] = [first_bbox]
+    cell_sets: list[set[tuple[int, int]]] = [_frame_pixels(first_bbox)]
+
+    for _ in range(1, len(order)):
+        placed = _place_next_bbox(h, w, bboxes[-1], cell_sets)
