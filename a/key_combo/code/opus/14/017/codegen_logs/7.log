+    isolated: list[tuple[int, int]] = []
+    other: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if union_mask[r, c]:
+                continue
+            clear = True
+            for rr in range(max(0, r - 1), min(h, r + 2)):
+                for cc in range(max(0, c - 1), min(w, c + 2)):
+                    if union_mask[rr, cc]:
+                        clear = False
+                        break
+                if not clear:
+                    break
+            if clear:
+                isolated.append((r, c))
+            else:
