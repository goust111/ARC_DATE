+import numpy as np
+
+
+FRAME_COLORS = (1, 2, 3, 6)
+TARGET_COLOR = 4
+BACKGROUND = 0
+
+GRID_H_RANGE = (14, 17)
+GRID_W_RANGE = (14, 17)
+FRAME_COUNT_CHOICES = (3, 4)
+FRAME_SIZE_RANGE = (4, 8)
+PLACEMENT_TRIES = 240
+GENERATION_TRIES = 500
+TARGET_TRIES = 200
