def _gen_neighbors4(r: int, c: int, h: int, w: int) -> list[Cell]:
    out: list[Cell] = []
    for dr, dc in NEIGHBORS4:
        rr, cc = r + dr, c + dc
        if 0 <= rr < h and 0 <= cc < w:
            out.append((rr, cc))
