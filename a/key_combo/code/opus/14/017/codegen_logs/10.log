  colors: bg=0, line_color and marker_color are two distinct non-bg colors [observed: line=3, marker=6]
  line_drawing:
    structure: rectilinear grid of full horizontal and vertical bars within a bounding box
    h_bars: 2-3 total (0-1 interior); v_bars: 2-3 total (0-1 interior)
    bar_gaps: 2-3 cells between consecutive bars
    original_bbox_size: 3-6 rows x 3-6 cols
    line_color pixel count >> marker_color pixel count
  markers:
    count: 2-3 isolated single pixels of marker_color
    placement: each marker outside the original bbox, at distance 2-7 from the nearest bbox edge
    sides_controlled: 2-3 of {left, right, bottom}; top is never expanded [observed]
    one marker per expanded side; each marker ends up exactly 1 cell outside its side of the new bbox
    a marker may be diagonal from original bbox (outside on two axes) but controls only one side
  transform:
    find unique expanded bbox containing original where every marker is 1 cell outside exactly one side
    move boundary bars to new bbox edges; interior bars stay at their original row/col
    redraw all bars spanning the new bbox width/height; markers preserved
  constraints:
    new bbox fits within grid with >=1 cell margin on all sides
    expansion per side: 1-6 cells (non-zero only for sides with markers)
    no bar collisions after expansion (interior bars must not coincide with new boundary bars)

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size (8-16 x 15-17). Choose line_color and marker_color (two distinct non-bg).
    2. Decide expanded (output) bbox with >=1 cell margin to all grid edges.
    3. Choose 2-3 sides from {left, right, bottom} to expand. Pick interior bar positions
