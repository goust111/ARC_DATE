+    r0, c0, r1, c1 = box
+    out = np.zeros(shape, dtype=int)
+    for r in rows:
+        out[r, c0 : c1 + 1] = LINE
+    for c in cols:
+        out[r0 : r1 + 1, c] = LINE
+    return out
