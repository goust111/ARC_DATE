+import numpy as np
+
+
+BG = 0
+LINE = 1
+SEP = 2
+MASK = 7
+SIDE = 11
+MAX_ATTEMPTS = 600
+
+_SEEN_OUTPUT_SIGS: set[str] = set()
+
+
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
