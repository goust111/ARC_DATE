+) -> set[tuple[int, int]] | None:
+    shape_h = max(r for r, _ in shape) + 1
+    shape_w = max(c for _, c in shape) + 1
+    placements = []
+    for r0 in range(h - shape_h + 1):
+        for c0 in range(w - shape_w + 1):
