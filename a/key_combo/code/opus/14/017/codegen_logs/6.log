+    assert max_count > mid_count > min_count
+
+    out_h = 2 * mid_count - 1
+    out_w = mid_count
+    mid_row = mid_count - 1
+    out = np.zeros((out_h, out_w), dtype=int)
+
+    for r in range(mid_row):
+        distance = mid_row - r
+        fill_width = min(out_w, mid_count + distance)
+        out[r, :fill_width] = cmax
