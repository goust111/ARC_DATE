+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+BACKGROUND = 0
+INPUT_COLORS = (BLUE, RED, GREEN)
+
+GEN_ATTEMPTS = 400
+GEN_SIZE_RANGE = (12, 15)
+GEN_COUNTS_DESC_OPTIONS: list[tuple[int, int, int]] = []
+GEN_OUTPUT_COMBOS: list[tuple[int, int, int, int]] = []
+GEN_OUTPUT_QUEUE: list[tuple[int, int, int, int]] = []
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _count_triplet_options() -> list[tuple[int, int, int]]:
+    options = []
+    for hi in range(5, 11):
+        for mid in range(3, 8):
+            if mid == hi:
+                continue
+            for lo in range(2, 10):
+                if len({hi, mid, lo}) != 3:
+                    continue
+                if hi > mid > lo:
+                    options.append((hi, mid, lo))
+    return options
+
+
+def _output_combos() -> list[tuple[int, int, int, int]]:
+    combos = []
+    for hi, mid, _lo in GEN_COUNTS_DESC_OPTIONS:
+        for cmax, cmid, cmin in (
+            (BLUE, RED, GREEN),
+            (BLUE, GREEN, RED),
+            (RED, BLUE, GREEN),
+            (RED, GREEN, BLUE),
+            (GREEN, BLUE, RED),
+            (GREEN, RED, BLUE),
+        ):
