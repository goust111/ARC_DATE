+def _project_to_ring(r: int, c: int, block_bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = block_bbox
+    assert not (r0 <= r <= r1 and c0 <= c <= c1), "marker cannot start inside the block"
