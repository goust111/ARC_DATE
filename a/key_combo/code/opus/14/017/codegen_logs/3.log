        "blocks": [{"rows": r1, "cols": c1, "size": s1}, {"rows": r2, "cols": c2, "size": s2}],
    }
    return grid, rooms, meta


def _place_horizontal(s1, s2, r1, c1, r2, c2, gap, paint, offset_connector):
    bh1, bw1 = _block_shape(r1, c1, s1)
