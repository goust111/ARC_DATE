        r, c = int(r_raw), int(c_raw)
        marker_color = int(g[r, c])
        assert marker_color in OUTLINE_COLOR, "unexpected marker color"
        assert 1 <= r < h - 1 and 1 <= c < w - 1, "3x3 outline must fit"

