+            for segment in _boundary_segments_through(shape, adj, side):
+                if not _segment_ok_for_input(segment, existing_walls, anchor, shape):
+                    continue
+                if _segment_contact_count(segment, stair_set) != 1:
+                    continue
+                candidates.append(segment)
