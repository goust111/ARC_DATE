+
+def _build_input(shape: tuple[int, int], anchor: tuple[int, int], segments: list[list[tuple[int, int]]]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for r, c in _wall_cells(segments):
+        grid[r, c] = RED
