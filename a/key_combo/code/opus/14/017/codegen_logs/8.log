+def _empty_trace(shape: tuple[int, int], anchor: tuple[int, int], direction: str) -> dict[str, object]:
+    wall_mask = np.zeros(shape, dtype=bool)
+    return _trace_direction(shape, anchor, wall_mask, direction)
