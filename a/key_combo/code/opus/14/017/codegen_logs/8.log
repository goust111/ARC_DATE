+
+    traces = {
+        direction: _trace_direction(g.shape, anchor, wall_mask, direction)
+        for direction in ("ur", "ld")
+    }
+
+    out = g.copy()
+    stair_cells: list[tuple[int, int]] = []
+    for trace in traces.values():
+        for r, c in trace["path"]:
+            out[r, c] = GREY
+            stair_cells.append((r, c))
