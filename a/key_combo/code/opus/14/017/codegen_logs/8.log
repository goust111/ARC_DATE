+def _region_count_from_barrier(barrier_mask: np.ndarray) -> int:
+    _labels, count = _label_mask(~barrier_mask)
+    return count
+
+
+def _stairs_only_region_count(shape: tuple[int, int], anchor: tuple[int, int]) -> int:
