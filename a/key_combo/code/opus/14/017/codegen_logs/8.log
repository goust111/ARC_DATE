+                keep_stops = True
+                for check_dir in ("ur", "ld"):
+                    trace = trial_info["traces"][check_dir]
+                    if len(trace["path"]) < MIN_STAIR_PIXELS:
+                        keep_stops = False
+                        break
+                    if direction_modes[check_dir] == "wall":
