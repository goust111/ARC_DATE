+        trace = _trace_direction(shape, anchor, wall_mask, direction)
+        for cell in trace["path"]:
+            barrier[cell] = True
+    return _region_count_from_barrier(barrier)
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    mode: str,
+    stop_targets: dict[str, set[tuple[int, int]]],
+) -> bool:
+    try:
