+                valid_candidates.append((segment, trial_info))
+            if not valid_candidates:
+                if placed_extra == 0:
+                    failed = True
+                break
+            segment, trial_info = random.choice(valid_candidates)
+            segments.append(segment)
+            info = trial_info
+            placed_extra += 1
+        if failed or placed_extra < 1:
+            continue
+
+        grid = _build_input(shape, anchor, segments)
+        if _validate_generated(grid, "wall_wall", stop_targets):
+            return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid staircase-wall separator puzzle")

