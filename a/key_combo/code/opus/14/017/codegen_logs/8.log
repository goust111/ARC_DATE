+        return False
+
+    if not np.any(out == BLUE):
+        return False
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randrange(*GRID_HEIGHT_RANGE)
+    width = random.randrange(*GRID_WIDTH_RANGE)
