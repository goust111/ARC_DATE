+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+
+UR_PATTERN = [(-1, 0), (-1, 0), (0, 1), (0, 1)]
+LD_PATTERN = [(1, 0), (1, 0), (0, -1), (0, -1)]
+PATTERNS = {"ur": UR_PATTERN, "ld": LD_PATTERN}
