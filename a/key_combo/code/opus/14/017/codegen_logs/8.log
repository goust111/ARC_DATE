+    candidates: list[list[tuple[int, int]]] = []
+    side_specs = {
+        "top": (-1, 0),
+        "bottom": (1, 0),
+        "left": (0, -1),
+        "right": (0, 1),
+    }
+    for r, c in stair_cells:
