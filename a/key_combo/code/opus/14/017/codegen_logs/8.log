+            return False
+        if mode == "ur_boundary" and direction == "ur":
+            if trace["stop_reason"] != "boundary":
+                return False
+        elif mode == "ld_boundary" and direction == "ld":
+            if trace["stop_reason"] != "boundary":
+                return False
+        else:
+            if trace["stop_reason"] != "wall":
+                return False
+            if tuple(trace["stop_next"]) not in stop_targets[direction]:
