+    anchor_rows = range(6, height - 6)
+    anchor_cols = range(5, width - 5)
+    anchors = [(r, c) for r in anchor_rows for c in anchor_cols]
+    random.shuffle(anchors)
+    mode = random.choices(MODE_OPTIONS, weights=MODE_WEIGHTS, k=1)[0]
