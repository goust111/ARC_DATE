+            if not _segment_ok_for_input(segment, existing_walls, anchor, (10**9, 10**9)):
+                continue
+            if _segment_contact_count(segment, stair_set) != 1:
+                continue
+            if _segment_contact_count(segment, stop_set) != 1:
