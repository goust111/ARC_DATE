+MIN_STAIR_PIXELS = MIN_COMPLETE_STEPS * 4
+MODE_OPTIONS = ("wall_wall", "ur_boundary", "ld_boundary")
+MODE_WEIGHTS = (6, 2, 2)
+OPTIONAL_BRANCH_PROBABILITY = 0.45
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    height, width = shape
+    return 0 <= r < height and 0 <= c < width
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _label_mask(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    labels = np.zeros(mask.shape, dtype=int)
+    label_id = 0
+    height, width = mask.shape
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            label_id += 1
+            labels[r, c] = label_id
+            queue = deque([(r, c)])
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = label_id
+                        queue.append((nr, nc))
+    return labels, label_id
+
+
+def _trace_direction(
+    shape: tuple[int, int],
+    anchor: tuple[int, int],
+    wall_mask: np.ndarray,
+    direction: str,
+) -> dict[str, object]:
+    pattern = PATTERNS[direction]
+    r, c = anchor
+    path: list[tuple[int, int]] = []
+    move_index = 0
+    while True:
+        dr, dc = pattern[move_index % len(pattern)]
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return {
+                "path": path,
+                "stop_reason": "boundary",
+                "stop_next": (nr, nc),
+                "full_steps": len(path) // 4,
+            }
+        if wall_mask[nr, nc]:
+            return {
+                "path": path,
+                "stop_reason": "wall",
+                "stop_next": (nr, nc),
+                "full_steps": len(path) // 4,
+            }
+        path.append((nr, nc))
+        r, c = nr, nc
+        move_index += 1
+
+
+def _region_graph(barrier_mask: np.ndarray) -> tuple[np.ndarray, int, dict[int, set[int]]]:
+    labels, region_count = _label_mask(~barrier_mask)
+    graph = {region_id: set() for region_id in range(1, region_count + 1)}
+    height, width = barrier_mask.shape
+    for r in range(height):
+        for c in range(width):
+            if not barrier_mask[r, c]:
+                continue
+            for (r1, c1), (r2, c2) in (((r - 1, c), (r + 1, c)), ((r, c - 1), (r, c + 1))):
+                if not (_in_bounds(barrier_mask.shape, r1, c1) and _in_bounds(barrier_mask.shape, r2, c2)):
+                    continue
+                a = int(labels[r1, c1])
+                b = int(labels[r2, c2])
+                if a > 0 and b > 0 and a != b:
+                    graph[a].add(b)
+                    graph[b].add(a)
+    return labels, region_count, graph
+
+
+def _bipartite_coloring(graph: dict[int, set[int]], start: int) -> dict[int, int]:
+    parity = {start: 0}
+    queue = deque([start])
+    while queue:
+        cur = queue.popleft()
+        for nxt in graph[cur]:
+            expected = 1 - parity[cur]
+            if nxt in parity:
+                assert parity[nxt] == expected, "region graph must be bipartite"
+            else:
+                parity[nxt] = expected
+                queue.append(nxt)
+    return parity
+
