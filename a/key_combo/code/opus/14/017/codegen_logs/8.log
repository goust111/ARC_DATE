+                valid_candidates.append(segment)
+            if not valid_candidates:
+                continue
+            segments.append(random.choice(valid_candidates))
+            grid = _build_input(shape, anchor, segments)
+            try:
+                _out, info = _transform_details(grid)
+            except AssertionError:
+                failed = True
+                break
+            placed_loops += 1
+            if placed_loops >= loop_goal:
+                break
+        if failed or placed_loops < 1:
+            continue
+        if failed:
+            continue
+
+        grid = _build_input(shape, anchor, segments)
+        if _validate_generated(grid, mode, stop_targets):
+            return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
