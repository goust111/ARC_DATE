+
+
+def _wall_cells(segments: list[list[tuple[int, int]]]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for segment in segments:
+        cells.update(segment)
+    return cells
+
+
+def _segment_ok_for_input(
