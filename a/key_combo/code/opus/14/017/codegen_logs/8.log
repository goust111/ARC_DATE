+        segments: list[list[tuple[int, int]]] = []
+        stop_targets: dict[str, set[tuple[int, int]]] = {"ur": set(), "ld": set()}
+        direction_modes = {
+            "ur": "boundary" if mode == "ur_boundary" else "wall",
+            "ld": "boundary" if mode == "ld_boundary" else "wall",
+        }
+
+        failed = False
+        for direction in ("ur", "ld"):
+            if direction_modes[direction] == "boundary":
+                continue
+            candidates = _stop_candidates(shape, anchor, direction, _wall_cells(segments))
