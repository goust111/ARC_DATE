+                b = _single_region([(r + 1, c), (r + 1, c + 1)])
+                if a is not None and b is not None and a != b:
+                    graph[a].add(b)
+                    graph[b].add(a)
+            if barrier_mask[r, c] and r + 1 < height and barrier_mask[r + 1, c]:
+                a = _single_region([(r, c - 1), (r + 1, c - 1)])
+                b = _single_region([(r, c + 1), (r + 1, c + 1)])
+                if a is not None and b is not None and a != b:
+                    graph[a].add(b)
+                    graph[b].add(a)
