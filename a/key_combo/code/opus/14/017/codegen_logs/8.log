+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randrange(*GRID_HEIGHT_RANGE)
+    width = random.randrange(*GRID_WIDTH_RANGE)
+    shape = (height, width)
+
+    anchor_rows = range(6, height - 6)
+    anchor_cols = range(5, width - 5)
+    anchors = [(r, c) for r in anchor_rows for c in anchor_cols]
+    random.shuffle(anchors)
+    mode = random.choices(MODE_OPTIONS, weights=MODE_WEIGHTS, k=1)[0]
+
+    for anchor in anchors:
+        if len(_empty_trace(shape, anchor, "ur")["path"]) < MIN_STAIR_PIXELS:
+            continue
+        if len(_empty_trace(shape, anchor, "ld")["path"]) < MIN_STAIR_PIXELS:
+            continue
+
+        segments: list[list[tuple[int, int]]] = []
+        stop_targets: dict[str, set[tuple[int, int]]] = {"ur": set(), "ld": set()}
+        direction_modes = {"ur": "wall", "ld": "wall"}
+
+        failed = False
+        for direction in ("ur", "ld"):
+            candidates = _stop_candidates(shape, anchor, direction, _wall_cells(segments))
+            if not candidates:
+                failed = True
+                break
+            segment, target = random.choice(candidates)
+            segments.append(segment)
+            stop_targets[direction] = target
+        if failed:
+            continue
+
+        grid = _build_input(shape, anchor, segments)
+        try:
+            _out, info = _transform_details(grid)
+        except AssertionError:
+            continue
+
+        extra_goal = 1 + int(random.random() < OPTIONAL_BRANCH_PROBABILITY)
+        placed_extra = 0
+        for _ in range(extra_goal):
+            valid_candidates = []
+            for segment in _free_segment_candidates(shape, anchor, _wall_cells(segments)):
+                trial_segments = segments + [segment]
+                trial_grid = _build_input(shape, anchor, trial_segments)
+                try:
+                    _trial_out, trial_info = _transform_details(trial_grid)
+                except AssertionError:
