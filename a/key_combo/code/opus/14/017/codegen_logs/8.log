+        if wall_mask[nr, nc]:
+            return {
+                "path": path,
+                "stop_reason": "wall",
+                "stop_next": (nr, nc),
+                "full_steps": len(path) // 4,
+            }
+        path.append((nr, nc))
+        r, c = nr, nc
+        move_index += 1
