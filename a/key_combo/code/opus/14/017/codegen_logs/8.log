+
+def _segment_contact_count(segment: list[tuple[int, int]], contact_cells: set[tuple[int, int]]) -> int:
+    count = 0
+    for r, c in segment:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in contact_cells:
