+        return False
+
+    for direction in ("ur", "ld"):
+        trace = info["traces"][direction]
+        if len(trace["path"]) < MIN_STAIR_PIXELS:
+            return False
+        if mode == "ur_boundary" and direction == "ur":
+            if trace["stop_reason"] != "boundary":
