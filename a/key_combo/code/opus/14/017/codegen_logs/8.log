+                    continue
+                if int(trial_info["region_count"]) < int(info["region_count"]):
+                    continue
+                valid_candidates.append((segment, trial_info))
+            if not valid_candidates:
+                if placed_branches == 0:
+                    failed = True
+                break
+            segment, trial_info = random.choice(valid_candidates)
+            segments.append(segment)
+            info = trial_info
+            placed_branches += 1
+        if failed or placed_branches < 1:
+            continue
