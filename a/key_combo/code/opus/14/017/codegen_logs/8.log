+    colored = out.copy()
+    for region_id, region_parity in parity.items():
+        colored[labels == region_id] = GREEN if region_parity == 0 else BLUE
+
+    info = {
+        "anchor": anchor,
+        "traces": traces,
+        "stair_cells": tuple(stair_cells),
+        "barrier_mask": barrier_mask,
+        "labels": labels,
+        "region_count": region_count,
+        "graph": graph,
+        "parity": parity,
+    }
+    return colored, info
