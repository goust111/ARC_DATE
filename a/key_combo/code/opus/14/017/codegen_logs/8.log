+        branch_goal = 2 if mode != "wall_wall" else 1 + int(random.random() < OPTIONAL_BRANCH_PROBABILITY)
+        for _ in range(branch_goal):
+            candidates = _branch_candidates(shape, anchor, _wall_cells(segments), list(info["stair_cells"]))
+            if not candidates:
+                failed = True
+                break
+            segments.append(random.choice(candidates))
+            grid = _build_input(shape, anchor, segments)
+            try:
+                _out, info = _transform_details(grid)
+            except AssertionError:
+                failed = True
+                break
+        if failed:
+            continue
+
+        grid = _build_input(shape, anchor, segments)
+        if _validate_generated(grid, mode, stop_targets):
+            return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid staircase-wall separator puzzle")

