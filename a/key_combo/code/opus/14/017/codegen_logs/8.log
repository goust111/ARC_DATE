+
+def _trace_direction(
+    shape: tuple[int, int],
+    anchor: tuple[int, int],
+    wall_mask: np.ndarray,
+    direction: str,
+) -> dict[str, object]:
+    pattern = PATTERNS[direction]
+    r, c = anchor
+    path: list[tuple[int, int]] = []
+    move_index = 0
+    while True:
+        dr, dc = pattern[move_index % len(pattern)]
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return {
+                "path": path,
+                "stop_reason": "boundary",
+                "stop_next": (nr, nc),
+                "full_steps": len(path) // 4,
+            }
+        if wall_mask[nr, nc]:
+            return {
+                "path": path,
+                "stop_reason": "wall",
+                "stop_next": (nr, nc),
+                "full_steps": len(path) // 4,
+            }
+        path.append((nr, nc))
+        r, c = nr, nc
+        move_index += 1
