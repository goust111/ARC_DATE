+    height, width = barrier_mask.shape
+
+    def _single_region(cells: list[tuple[int, int]]) -> int | None:
+        region_ids = {
+            int(labels[r, c])
+            for r, c in cells
+            if _in_bounds(barrier_mask.shape, r, c) and int(labels[r, c]) > 0
