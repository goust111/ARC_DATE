+
+
+def _validate_generated(
+    grid: np.ndarray,
+    mode: str,
+    stop_targets: dict[str, set[tuple[int, int]]],
+) -> bool:
+    try:
+        out, info = _transform_details(grid)
+    except AssertionError:
+        return False
+
