+    height, width = shape
+
+    def contact_positions(segment: list[tuple[int, int]]) -> list[int]:
+        positions = []
+        for idx, (r, c) in enumerate(segment):
+            hits = 0
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in stair_set:
+                    hits += 1
+            if hits:
