+        chosen = random.sample(cells, int(count))
+        for r, c in chosen:
+            grid[r, c] = int(color)
+
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

