+def _base_pattern(target_k: int) -> tuple[list[tuple[int, int]], list[list[tuple[int, int]]]]:
+    reds = [(-3, 0), (3, 0), (0, -3)]
+    if target_k == 1:
+        barriers = [[(-1, 2), (0, 2)]]
+    elif target_k == 2:
+        barriers = [[(-1, 2), (0, 2), (1, 2)]]
+    elif target_k == 3:
