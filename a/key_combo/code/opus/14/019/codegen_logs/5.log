spec:
  grid: 13-14 rows x 12-15 cols
  colors:
    bg: 0 [observed]
    dense: 1 [observed]
    marker: 8 [observed]
  objects:
    count: 6-7 solid rectangles (100% fill)
    height: 2-4
    width: 2-6
    pixels: each cell is dense or marker color
    marker_per_object: 0-4; kept objects have 0 or 1, removed have 2-4
    separation: min Chebyshev distance >= 2 between any two objects
    may_touch_border: true
  transform:
    rule: erase (set to bg) every object containing >= 2 marker pixels
    kept_count: 3 [observed]
    removed_count: 3-4
    both_kept_and_removed: required
  totals:
    marker_pixels: 9-14
    dense_to_marker_ratio: 4-8x [observed]

generation_strategy:
  approach: direct construction (simple placement task)
  steps:
    1. Pick grid size in range 13-14 x 12-15.
    2. Decide object count (6-7). For each, pick random rectangle dims h in [2,4], w in [2,6].
    3. Assign each object a marker count -- 3 objects get 0 or 1 (kept), rest get 2-4 (removed).
    4. Place rectangles on grid with Chebyshev gap >= 2 between all pairs. Use greedy random placement with rejection.
    5. Fill each rectangle with dense color, then randomly replace marker_count cells with marker color.
    6. Verify total marker pixels in 9-14 and dense/marker ratio reasonable; retry assignment if not.
```
