spec:
  grid: 20-29 rows x 20-29 cols, background black (0)
  segments:
    count: 3-4 monochrome straight bars (H or V), each a contiguous 4-connected line
    colors: distinct non-zero colors, all different from each other
    lengths: all distinct; max length N determines output side (N = 5-8)
    num_segments: exactly ceil(N/2) = (N+1)//2
    length_values: any distinct positive integers whose max is N; need not follow N,N-2,N-4,... [observed 3/4 examples do follow that pattern]
    placement: scattered on the grid, non-overlapping, well-separated (min pairwise distance >= 3)
    orientation: mix of H and V per example [observed]
  output:
    shape: N x N square
    structure: concentric square rings; layer 0 (outermost) gets color of longest segment, layer 1 gets next longest, etc.
    innermost: 1x1 if N odd, 2x2 if N even

generation_strategy:
  approach: output-first
  steps:
    1. Pick N in 5-8; set num_segments K = ceil(N/2)
    2. Pick K distinct non-zero colors (1-9)
    3. Pick K distinct lengths with max = N (e.g. sample K-1 values from 1..N-1 without replacement, add N)
    4. Build NxN output by filling concentric layers sorted by length descending
    5. Choose input grid size H x W each in 20-29, ensuring H*W >> sum of segment lengths
    6. For each segment, pick random orientation (H/V) and place on the grid at a random position, ensuring no overlap and min pairwise distance >= 3
