+    dr, dc = step
+    out = [(int(r0), int(c0))]
+    rr = r0 + dr
+    cc = c0 + dc
+    while 0 <= rr and rr + 1 < h and 0 <= cc and cc + 1 < draw_w:
+        out.append((int(rr), int(cc)))
+        rr += dr
+        cc += dc
+    return out
