+    candidates: list[dict] = []
+    step = CORNER_TO_STEP[corner]
+    for r0 in row_range:
+        for c0 in col_range:
+            positions = _ray_positions((r0, c0), step, h, draw_w)
+            length = len(positions) - 1
+            if length < 2:
