        rr += step_r
        cc += step_c
    return length


def _gen_valid_positions(red_corners: list[tuple[int, int]]) -> list[tuple[int, int]]:
    """Return top-left seed positions whose selected rays match length bounds."""
    min_len, max_len = _GEN_RAY_LEN_RANGE
