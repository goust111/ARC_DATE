+def _corner_candidate_positions(
+    h: int, draw_w: int, corner: tuple[int, int]
+) -> list[dict]:
+    mid_r = h // 2
+    mid_c = draw_w // 2
+    if corner == (0, 0):
+        row_range = range(mid_r, h - 3)
+        col_range = range(mid_c, draw_w - 2)
+    elif corner == (0, 1):
+        row_range = range(mid_r, h - 3)
+        col_range = range(2, max(3, mid_c))
+    elif corner == (1, 0):
+        row_range = range(2, max(3, mid_r))
+        col_range = range(mid_c, draw_w - 2)
+    else:
+        row_range = range(2, max(3, mid_r))
+        col_range = range(2, max(3, mid_c))
