+                "top_left": (int(r0), int(c0)),
+                "color": int(color),
+                "corner": corner,
+                "step": step,
+                "positions": positions,
+                "length": len(positions) - 1,
+                "footprint": _footprint((r0, c0), step, h, draw_w),
+            }
+        )
+    assert 3 <= len(seeds) <= 4
+    lengths = [seed["length"] for seed in seeds]
+    assert len(lengths) == len(set(lengths))
+    for i in range(len(seeds)):
