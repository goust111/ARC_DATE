+    if not _semantic_checks(grid, out, rect, row_configs, compare_rows, phase_row):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid shear-periodic-fill input")

