        'bottom': lambda r, c: r == H - 1,
        'left': lambda r, c: c == 0,
        'right': lambda r, c: c == W - 1,
    }
    counts = {}
    for oe in _EDGES:
        if oe == edge:
            continue
        check = boundary[oe]
        counts[oe] = sum(1 for r, c in dots_rc if check(r, c))
    return counts


