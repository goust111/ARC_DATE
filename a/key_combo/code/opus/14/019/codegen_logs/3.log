+AREA_VALUES = tuple(range(3, 9))
+SHAPE_CANVAS = 5
+GRID_SIDE_RANGE = (18, 25)
+MARGIN = 1
+MIN_BBOX_DISTANCE = 4
+MAX_SHAPE_ATTEMPTS = 500
+MAX_PLACEMENT_ATTEMPTS = 500
+MAX_GENERATION_ATTEMPTS = 800
