+    if not _is_connected(mask):
+        return False
+    crop = _crop_mask(mask)
+    h, w = crop.shape
+    if min(h, w) < 2 or h == w:
+        return False
+    if int(crop.sum()) == h * w:
+        return False
+    if np.unique(np.argwhere(crop)[:, 0]).size == 1 or np.unique(np.argwhere(crop)[:, 1]).size == 1:
+        return False
+    for turns in (1, 2, 3):
+        if np.array_equal(crop, _rotate_cw(crop, turns)):
+            return False
+    return True
