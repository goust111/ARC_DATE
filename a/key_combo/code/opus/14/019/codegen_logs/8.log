+
+
+def _output_from_order(infos: list[dict]) -> np.ndarray:
+    return _layered_output([info["color"] for info in infos])
+
+
+def _semantic_instance_ok(grid: np.ndarray) -> bool:
+    try:
+        infos = _analyze_objects(grid)
