+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "color": int(base_color),
+                "red_count": red_count,
+                "area": int(len(coords)),
+                "bbox_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+            }
+        )
+    return infos
+
+
