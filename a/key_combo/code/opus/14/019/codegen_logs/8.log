+        return None
+    markers = _choose_markers(shape, marker_count)
+    if markers is None:
+        return None
+    h = int(shape[:, 0].max()) + 1
+    w = int(shape[:, 1].max()) + 1
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in shape:
