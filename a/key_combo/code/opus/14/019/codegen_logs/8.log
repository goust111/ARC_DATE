+        shape = _normalize_shape(cells)
+        h = int(shape[:, 0].max()) + 1
+        w = int(shape[:, 1].max()) + 1
+        if h < 2 or w < 2:
+            continue
+        if area == h * w and random.random() < 0.8:
+            continue
+        return shape
+    return None
+
+
+def _choose_markers(shape: np.ndarray, marker_count: int) -> set[tuple[int, int]] | None:
+    cells = [tuple(map(int, rc)) for rc in shape]
+    cell_set = set(cells)
