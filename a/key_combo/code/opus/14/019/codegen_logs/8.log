+            random.shuffle(frontier)
+            added = False
+            for candidate in frontier:
+                trial = cells | {candidate}
+                shape = _normalize_shape(trial)
+                h = int(shape[:, 0].max()) + 1
+                w = int(shape[:, 1].max()) + 1
+                if h <= 5 and w <= 5:
+                    cells = trial
+                    added = True
+                    break
+            if not added:
+                break
+        if len(cells) != area:
+            continue
