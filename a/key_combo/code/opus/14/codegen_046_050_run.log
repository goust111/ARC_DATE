            r = random.randint(0, _GEN_QUAD_SIZE - 1)
            c = random.randint(r, _GEN_QUAD_SIZE - 1)
            _gen_set_q_orbit(q, r, c, bg if random.random() < _GEN_NOISE_BG_PROB else random.choice(fg))

