+    for coords in _component_coords(mask):
+        pts = [tuple(map(int, rc)) for rc in coords]
+        vals = [int(g[r, c]) for r, c in pts]
+        marker_pts = [(r, c) for (r, c), v in zip(pts, vals) if v == ORANGE]
+        if len(marker_pts) != 1:
+            continue
+        bbox = _bbox_from_coords(pts)
+        sprites.append(
