+    naive = g.copy()
+    for direction, path in structural_paths.items():
+        for r, c in path:
+            naive[r, c] = BLUE
+    for r, c in walls:
+        naive[r, c] = RED
+    assert not np.array_equal(out, naive), "mirrored walls must change at least one ray length"
