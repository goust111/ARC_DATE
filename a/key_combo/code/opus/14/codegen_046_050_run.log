+        b_overlap = np.zeros_like(b_mask, dtype=bool)
+        a_overlap[overlap_top_a : overlap_top_a + oh, overlap_left_a : overlap_left_a + ow] = True
+        b_overlap[overlap_top_b : overlap_top_b + oh, overlap_left_b : overlap_left_b + ow] = True
