def _gen_attempt():
    H = random.randint(*GEN_GRID_ROWS)
    W = random.randint(*GEN_GRID_COLS)
    closed_count = random.randint(*CLOSED_OUTLINE_COUNT)
    open_count = random.randint(*OPEN_OUTLINE_COUNT)
