+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+ORANGE = 7
+
+INPUT_BODY_COLORS = (3, 5, 6, 9)
+GRID_SIDE_RANGE = (14, 18)
+SPRITE_SIDE_RANGE = (4, 5)
+OVERLAP_SIZE_OPTIONS = (
+    (2, 3),
+    (3, 2),
+    (2, 4),
+    (4, 2),
+    (3, 3),
+    (3, 4),
+    (4, 3),
