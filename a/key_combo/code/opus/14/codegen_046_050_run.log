+    top_anchor, right_anchor = _find_anchors(inp)
+    sprites = _find_sprite_components(inp)
+    dists = [
+        abs(sprite["marker"][0] - top_anchor[0]) + abs(sprite["marker"][1] - top_anchor[1])
+        for sprite in sprites
+    ]
+    if dists[0] == dists[1]:
+        return False
+    a_idx = 0 if dists[0] < dists[1] else 1
+    b_idx = 1 - a_idx
+    sprite_a = sprites[a_idx]
+    sprite_b = sprites[b_idx]
+
+    if np.array_equal(_compare_sprites(sprite_a, sprite_b, top_anchor[1], right_anchor[0], False, True), expected):
+        return False
+    if np.array_equal(_compare_sprites(sprite_a, sprite_b, top_anchor[1], right_anchor[0], True, False), expected):
+        return False
+    if np.array_equal(_compare_sprites(sprite_b, sprite_a, top_anchor[1], right_anchor[0], True, True), expected):
+        return False
+
+    for dc in (-1, 1):
+        col = top_anchor[1] + dc
+        if 0 < col < inp.shape[1] - 1 and np.array_equal(
+            _compare_sprites(sprite_a, sprite_b, col, right_anchor[0], True, True), expected
+        ):
+            return False
+    for dr in (-1, 1):
+        row = right_anchor[0] + dr
+        if 0 < row < inp.shape[0] - 1 and np.array_equal(
+            _compare_sprites(sprite_a, sprite_b, top_anchor[1], row, True, True), expected
+        ):
+            return False
+    return True
+
+
+def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
+    oh, ow = random.choice(OVERLAP_SIZE_OPTIONS)
+    h_a = random.randint(max(SPRITE_SIDE_RANGE[0], oh + 1), SPRITE_SIDE_RANGE[1])
+    w_a = random.randint(max(SPRITE_SIDE_RANGE[0], ow + 1), SPRITE_SIDE_RANGE[1])
+    h_b = random.randint(max(SPRITE_SIDE_RANGE[0], oh + 1), SPRITE_SIDE_RANGE[1])
+    w_b = random.randint(max(SPRITE_SIDE_RANGE[0], ow + 1), SPRITE_SIDE_RANGE[1])
