+def _sample_source(shape: tuple[int, int]) -> tuple[int, int] | None:
+    h, w = shape
+    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+    candidates: list[tuple[int, int]] = []
