+    left_margin = random.randint(1, 3)
+    gaps = [random.randint(3, 5) for _ in range(3)]
+    right_margin = random.randint(4, 7)
+    slot_cols = [left_margin]
+    for gap in gaps:
+        slot_cols.append(slot_cols[-1] + gap)
+    width = slot_cols[-1] + right_margin + 1
