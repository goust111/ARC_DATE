+def _make_patches(h_a: int, w_a: int, h_b: int, w_b: int, oh: int, ow: int) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(MASK_ATTEMPTS):
+        a_mask = _random_mask(h_a, w_a)
