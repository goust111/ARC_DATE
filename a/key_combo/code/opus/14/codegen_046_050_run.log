+def _diag_order(
+    coords: list[tuple[int, int]],
+    source: tuple[int, int],
+    shape: tuple[int, int],
+    *,
+    prefer_clipped: bool,
+    prefer_near: bool,
+) -> list[tuple[int, int]]:
