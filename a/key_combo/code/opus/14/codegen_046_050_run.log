+    r0 = max(a_bbox[0], b_bbox[0])
+    c0 = max(a_bbox[1], b_bbox[1])
+    r1 = min(a_bbox[2], b_bbox[2])
+    c1 = min(a_bbox[3], b_bbox[3])
+    assert r0 <= r1 and c0 <= c1, "translated sprite bboxes must overlap"
