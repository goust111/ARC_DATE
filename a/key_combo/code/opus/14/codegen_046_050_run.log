+    assert source not in {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+
+    sr, sc = source
+    survivors: list[tuple[int, int]] = []
+    distractors: list[tuple[int, int]] = []
+    main_hits = 0
+    anti_hits = 0
+    for r, c in coords:
