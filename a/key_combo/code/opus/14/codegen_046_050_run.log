+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        sample = _gen_attempt()
+        if sample is None:
+            continue
+        inp, out = sample
+        sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest()
+        if sig in _SEEN_OUTPUT_SIGS:
+            continue
+        _SEEN_OUTPUT_SIGS.add(sig)
+        return inp
