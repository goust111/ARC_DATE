from collections import Counter

def bounce(h,w,start):
    r,c=start
    dr,dc=-1,1
    pts=[start]
    for step in range(1,1000):
        nr,nc=r+dr,c+dc
        if nr<0 or nr>=h:
            dr=-dr
            nr=r+dr
        if nc<0 or nc>=w:
            dc=-dc
            nc=c+dc
        r,c=nr,nc
        pts.append((r,c))
        if (r,c)==start:
            return 'return', pts
        if r in (0,h-1) and c in (0,w-1):
            return 'corner', pts
    return 'loop', pts

for n in range(4,7):
    counts=Counter()
    examples={}
    for r in range(n):
        for c in range(n):
            if (r,c) in {(0,0),(0,n-1),(n-1,0),(n-1,n-1)}:
                continue
            term,pts=bounce(n,n,(r,c))
            counts[term]+=1
            examples.setdefault(term, (r,c,len(set(pts)),pts[-1]))
    print('n',n,counts,examples)
