    patch = g[r0 : r1 + 1, src_c0 : src_c1 + 1][:, ::-1].copy()
    assert patch.shape == (3, 3), "expected reflected source to be 3x3"
    assert not np.any(patch == Color.BLACK), "reflected source patch must be fully colored"
    return patch

