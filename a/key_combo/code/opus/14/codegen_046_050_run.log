def bounce(h,w,start):
    r,c=start
    dr,dc=-1,1
    pts=[start]
    reflected=False
    for step in range(1,1000):
        nr,nc=r+dr,c+dc
        hit=False
        if nr<0 or nr>=h:
            dr=-dr
            nr=r+dr
            hit=True
        if nc<0 or nc>=w:
            dc=-dc
            nc=c+dc
            hit=True
        reflected = reflected or hit
        r,c=nr,nc
        pts.append((r,c))
        if (r,c)==start:
            return 'return', reflected, pts
        if r in (0,h-1) and c in (0,w-1):
            return 'corner', reflected, pts

for n in range(4,11):
    found=[]
