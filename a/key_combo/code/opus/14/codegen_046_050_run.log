+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SEP = 9
+
+PANEL_H_RANGE = (8, 12)
+PANEL_W_RANGE = (8, 12)
+PALETTE_LENGTHS = (2, 3, 4)
