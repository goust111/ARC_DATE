+    sorted_heights = sorted(slot["height"] for slot in slots)
+    bars_grid = _render_bars(g.shape, base_r, slot_cols, sorted_heights)
+
+    color_to_col = {color: col for color, col in zip(SLOT_COLORS, slot_cols)}
