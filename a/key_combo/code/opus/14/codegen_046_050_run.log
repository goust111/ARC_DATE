+    framed_centers: list[tuple[int, int, int]] = []
+    for r, c in np.argwhere(grid != BLACK):
+        rr = int(r)
+        cc = int(c)
+        if (rr, cc) == (sr, sc):
+            continue
+        if _on_diagonal(sr, sc, rr, cc):
+            framed_centers.append((rr, cc, int(grid[rr, cc])))
+
