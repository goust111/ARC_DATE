+        stop_idx = _nearest_wall_distance(path, walls)
+        if stop_idx is None:
+            free_dirs.append(direction)
+            assert ray_cells[direction] == path, "unblocked rays must reach their structural limit"
+        else:
+            blocker_dirs.append(direction)
