+    if bottom is None:
+        return None
+
+    inp = top.copy()
+    inp[hole_rs, hole_cs] = 0
+    grid = np.vstack([inp, np.full((1, inp.shape[1]), SEP_COLOR, dtype=int), bottom])
+
+    try:
+        _validate_generated(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
