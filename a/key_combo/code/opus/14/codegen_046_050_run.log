+def _compare_sprites(sprite_a: dict, sprite_b: dict, top_anchor_col: int, right_anchor_row: int,
+                     move_a: bool = True, move_b: bool = True) -> np.ndarray:
+    a_mr, a_mc = sprite_a["marker"]
+    b_mr, b_mc = sprite_b["marker"]
