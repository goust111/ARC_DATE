+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    components: list[np.ndarray] = []
+    next_id = 0
+    neigh_fn = _neighbors8 if conn8 else _neighbors4
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            next_id += 1
+            q = deque([(r, c)])
+            labels[r, c] = next_id
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in neigh_fn(cr, cc):
