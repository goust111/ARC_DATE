+            seeds.append((r, c))
+    seeds.sort()
+    return seeds
+
+
+def _analyze(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    palette = _read_palette(g)
