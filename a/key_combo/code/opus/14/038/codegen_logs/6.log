+    if np.array_equal(out, _fill_global_palette(grid, info)):
+        return None
+    if np.array_equal(out, _fill_reverse_sorted(grid, info)):
+        return None
+
+    palette_set = set(info["palette"])
+    seed_color_set = {int(grid[seed]) for seed in info["seeds"]}
