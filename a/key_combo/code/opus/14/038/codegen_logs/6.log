+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+NON_BLACK_NON_GREY = [1, 2, 3, 4, 6, 7, 8, 9]
+ZONE_WIDTH = 6
+ZONE_GAP = 2
+RING_HEIGHT = 4
+RING_STEP = 5
+GENERATE_ATTEMPTS = 400
