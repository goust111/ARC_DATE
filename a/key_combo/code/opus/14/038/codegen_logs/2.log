+def _trace_path(grid: np.ndarray, start: tuple[int, int]) -> dict:
+    """Trace one control path using only the puzzle's upward-then-right rule."""
+    h, w = grid.shape
+    r, c = start
+    path = [(r, c)]
+    up_moves = 0
+    grey_turns = []
+    top_rights = 0
