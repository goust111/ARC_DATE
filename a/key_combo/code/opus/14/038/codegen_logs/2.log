+def _stamp_output(grid: np.ndarray, mask: np.ndarray) -> np.ndarray:
+    out = np.zeros((OUTPUT_SIZE, OUTPUT_SIZE), dtype=int)
+    for r, c in zip(*np.where(mask)):
+        out[r * GRID_SIZE : (r + 1) * GRID_SIZE, c * GRID_SIZE : (c + 1) * GRID_SIZE] = grid
+    return out
+
