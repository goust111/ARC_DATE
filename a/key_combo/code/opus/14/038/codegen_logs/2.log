+    while True:
+        nr = r - 1
+        if nr >= 0 and grid[nr, c] != GREY:
+            r = nr
+            path.append((r, c))
+            up_moves += 1
+            continue
+
+        nc = c + 1
+        if nc < w and grid[r, nc] != GREY:
+            if nr >= 0 and grid[nr, c] == GREY:
+                grey_turns.append((nr, c))
+            else:
+                top_rights += 1
+            c = nc
+            path.append((r, c))
+            continue
+
+        stop_reason = "grey" if nr >= 0 and grid[nr, c] == GREY else "top"
+        return {
+            "start": start,
+            "path": path,
+            "up_moves": up_moves,
+            "grey_turns": grey_turns,
+            "top_rights": top_rights,
+            "stop_reason": stop_reason,
+        }
+
