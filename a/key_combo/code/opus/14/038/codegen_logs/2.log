        if min_turns <= max_turns:
            feasible.append((up_steps, min_turns, max_turns))
    if not feasible:
        return None

    up_steps, min_turns, max_turns = feasible[int(rng.integers(len(feasible)))]
    turn_count = _gen_weighted_turn_count(min_turns, max_turns, rng)
