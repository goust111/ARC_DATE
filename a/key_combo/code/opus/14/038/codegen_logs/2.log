+        return None
+
+    eligible = [
+        (r, c)
+        for r in range(GRID_SIZE - 1)
+        for c in range(GRID_SIZE)
+        if (r, c) not in protected
+        and (r, c) != forced_blocker
+        and (r, c) != forced_target
+    ]
