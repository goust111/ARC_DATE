    for up_steps in possible_up:
        min_turns = max(0, _GEN_PATH_MIN_CELLS - up_steps) if blocked else 0
        max_turns = min(
            _GEN_MAX_TURNS,
            max_shift,
            _GEN_PATH_MAX_CELLS - up_steps,
            _GEN_MAX_RIGHT_PER_UP_STEP * up_steps,
