    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "input must be a 2D grid"
    h, w = g.shape
    assert h > 0 and w > 0, "input grid must be nonempty"

    top = np.concatenate((g, np.fliplr(g)), axis=1)
    return np.concatenate((top, np.flipud(top)), axis=0)

