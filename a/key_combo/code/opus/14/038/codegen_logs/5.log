    """Draw five-cell plus frames on a blank square canvas."""
    grid = np.zeros((n, n), dtype=int)
    for (r, c), color in zip(centers, colors):
        grid[r, c] = int(color)
        grid[(r - 1, r + 1), c] = PLUS_ARM_COLOR
        grid[r, (c - 1, c + 1)] = PLUS_ARM_COLOR
