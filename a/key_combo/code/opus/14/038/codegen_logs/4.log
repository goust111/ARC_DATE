+                "area": region_area,
+                "color": color,
+                "sprite_bbox": global_box,
+                "sprite_mask": sprite_template,
+            }
+        )
+
+    assert len(templates_by_color[BLUE]) >= 2 and len(templates_by_color[GREEN]) >= 2, "need at least two sprites of each color"
