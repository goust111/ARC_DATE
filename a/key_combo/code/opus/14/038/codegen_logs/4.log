+def _mask_spans_bbox(mask: np.ndarray) -> bool:
+    return bool(mask.any() and mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _connected_mask(mask: np.ndarray) -> bool:
