+    if parity_sets[0] != set(SPRITE_COLORS) or parity_sets[1] != set(SPRITE_COLORS):
+        return False
+
+    area_rank_coords = []
+    n_cols = len({region["bbox"][1] for region in regions})
+    for idx in rank_order:
+        box = regions[idx]["bbox"]
+        area_rank_coords.append((box[0], box[1]))
