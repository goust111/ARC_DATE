+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+SPRITE_COLORS = (BLUE, GREEN)
+LAYOUT_CHOICES = ((2, 2), (2, 3), (3, 2))
+SPRITE_BOX_CHOICES = ((2, 2), (2, 3), (3, 2), (3, 3))
