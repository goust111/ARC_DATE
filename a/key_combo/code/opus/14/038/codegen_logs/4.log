+    for box, color in zip(boxes, colors_by_region):
+        r0, c0, r1, c1 = box
+        mask = templates[color]
+        h, w = mask.shape
+        top_min = r0 + 1
+        left_min = c0 + 1
+        top_max = r1 - h
+        left_max = c1 - w
+        if top_min > top_max or left_min > left_max:
+            return None
