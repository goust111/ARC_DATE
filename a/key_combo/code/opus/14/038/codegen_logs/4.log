+
+
+def _validate_generated_instance(inp: np.ndarray) -> bool:
+    parsed = _parse_input(inp)
+    out = main(inp)
+    regions = parsed["regions"]
+    templates = parsed["templates"]
+
+    rank_order = sorted(range(len(regions)), key=lambda idx: regions[idx]["area"])
