+
+    col_major = sorted(ordered, key=lambda region: (region["top_left"][1], region["top_left"][0], region["area"]))
+    col_major_mask = _region_mask(inp.shape, col_major, actual_selected)
+    if np.array_equal(actual_mask, col_major_mask):
