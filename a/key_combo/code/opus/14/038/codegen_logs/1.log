import random, numpy as np
from collections import deque

TYPES={
'top':[(-1,-1),(-1,1)],
'bottom':[(1,-1),(1,1)],
'left':[(-1,-1),(1,-1)],
'right':[(-1,1),(1,1)],
'nw':[(-1,-1)],'ne':[(-1,1)],'sw':[(1,-1)],'se':[(1,1)]}

def inb(shape,r,c):
    h,w=shape
    return 0<=r<h and 0<=c<w

def seed_from(square,dr,dc):
    r,c=square
    cr = r if dr<0 else r+1
    cc = c if dc<0 else c+1
    return cr+dr, cc+dc

def ray_cells(shape,sr,sc,dr,dc):
    out=[]; r,c=sr+dr,sc+dc
    while inb(shape,r,c): out.append((r,c)); r+=dr; c+=dc
    return out

def comps(mask):
    h,w=mask.shape; seen=np.zeros_like(mask,dtype=bool); metas=[]
    for r in range(h):
      for c in range(w):
        if not mask[r,c] or seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; area=0; mr,mc=r,c
        while q:
          rr,cc=q.popleft(); area+=1
          if (rr,cc)<(mr,mc): mr,mc=rr,cc
          for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=rr+dr,cc+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; q.append((nr,nc))
        metas.append((area,mr,mc))
    return sorted(metas)

def valid_layout(H,W,items):
    occ=set(); raycells=[]; diag_ids=set(); seeds=[]
    squares=[(r,c) for r,c,_ in items]
    for r,c,_ in items:
        for rr in [r,r+1]:
            for cc in [c,c+1]: occ.add((rr,cc))
    for r,c,dirs in items:
        for dr,dc in dirs:
            sr,sc=seed_from((r,c),dr,dc)
            if not inb((H,W),sr,sc) or not inb((H,W),sr+dr,sc+dc): return None
            if (sr,sc) in occ: return None
            key=('m',sr-sc) if dr==dc else ('a',sr+sc)
            if key in diag_ids: return None
            diag_ids.add(key)
            path=ray_cells((H,W),sr,sc,dr,dc)
            if any(cell in occ for cell in [(sr,sc)]+path): return None
            if any(cell in rc for cell in [(sr,sc)]+path for rc in raycells): return None
            seeds.append((sr,sc,dr,dc))
            raycells.append(set([(sr,sc)]+path))
            occ.add((sr,sc))
            occ.update(path)
    g=np.zeros((H,W),int)
    for r,c,_ in items:g[r:r+2,c:c+2]=1
    for sr,sc,dr,dc in seeds:
        g[sr,sc]=1
        for rr,cc in ray_cells((H,W),sr,sc,dr,dc): g[rr,cc]=5
    return g, comps(g==0)

for trial in range(30):
    H=W=15
    items=[]
    # choose one top wedge and one bottom wedge and maybe side single
    types=['top','bottom',random.choice(['left','right','nw','ne','sw','se'])]
    pos=[]
    for t in types:
        for _ in range(500):
            r=random.randint(3,H-5); c=random.randint(3,W-5)
            if all(abs(r-r2)>=4 and abs(c-c2)>=4 for r2,c2,_ in items):
                items.append((r,c,TYPES[t])); break
    out=valid_layout(H,W,items)
    print(items, None if out is None else out[1])
