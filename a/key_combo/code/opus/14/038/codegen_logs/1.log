+    items = core[:]
+
+    target_count = random.choices([2, 3, 4], weights=[2, 4, 3], k=1)[0]
+    extras_pool = ["left", "right", "nw", "ne", "sw", "se"]
+    random.shuffle(extras_pool)
+
+    for template_name in extras_pool:
