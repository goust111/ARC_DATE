+
+
+def _region_mask(shape: tuple[int, int], regions: list[dict], selected_indices: set[int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for idx, region in enumerate(regions):
+        if idx in selected_indices:
