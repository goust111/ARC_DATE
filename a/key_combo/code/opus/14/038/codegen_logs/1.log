+    row_major = sorted(ordered, key=lambda region: (region["top_left"][0], region["top_left"][1], region["area"]))
+    row_major_mask = _region_mask(inp.shape, row_major, actual_selected)
+    if np.array_equal(actual_mask, row_major_mask):
