                if any(cell in occ for cell in path): bad=True; break
                if any(cell in p for cell in path+[ (sr,sc) ] for p in [set(x) for x in rays]):
                    bad=True; break
                rays.append([(sr,sc)]+path)
                occ.add((sr,sc))
                for cell in path: occ.add(cell)
