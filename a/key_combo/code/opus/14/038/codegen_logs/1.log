                r=random.randint(2,H-4)
                c=random.randint(2,W-4)
                if all(abs(r-r2)>=3 and abs(c-c2)>=3 for r2,c2,_ in sq):
                    dset=random.sample([(-1,-1),(-1,1),(1,-1),(1,1)], random.randint(1,2))
                    sq.append((r,c,dset)); break
            else:
                ok=False; break
        if not ok: continue
        occ=set(); bad=False; diag_ids=set(); rays=[]
        for r,c,dset in sq:
            for rr in [r,r+1]:
                for cc in [c,c+1]:
                    occ.add((rr,cc))
        for r,c,dset in sq:
