+
+
+def _validate_sample(inp: np.ndarray, out: np.ndarray, items: list[tuple[int, int, str]], rays: list[tuple[int, int, int, int]]) -> bool:
+    if max(inp.shape) > 30 or max(out.shape) > 30:
