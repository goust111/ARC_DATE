                cr = r if dr<0 else r+1
                cc = c if dc<0 else c+1
                sr,sc = cr+dr,cc+dc
                if not inb((H,W),sr,sc): bad=True; break
                # min ray len 2
                if not inb((H,W),sr+dr,sc+dc): bad=True; break
                if (sr,sc) in occ: bad=True; break
                key=('d1',sr-sc) if dr==dc else ('d2',sr+sc)
                if key in diag_ids: bad=True; break
