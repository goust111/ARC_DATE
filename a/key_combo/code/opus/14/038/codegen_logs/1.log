import random, numpy as np
from collections import deque

def inb(shape,r,c):
    h,w=shape
    return 0<=r<h and 0<=c<w

def ray_cells(shape,sr,sc,dr,dc):
    out=[]
    r,c=sr+dr,sc+dc
    while inb(shape,r,c):
        out.append((r,c))
        r+=dr;c+=dc
    return out

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    areas=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]);seen[r,c]=1;area=0
            while q:
                rr,cc=q.popleft();area+=1
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=1;q.append((nr,nc))
            areas.append(area)
    return sorted(areas)

def test_once():
