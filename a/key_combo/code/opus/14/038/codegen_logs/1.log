+    top_r = random.randint(2, height - 5)
+    bot_r = random.randint(2, height - 5)
+    return [(top_r, top_c, "top"), (bot_r, bot_c, "bottom")]
+
+
+def _extra_position(height: int, width: int, template_name: str) -> tuple[int, int]:
+    mid_r = height // 2
