+    assert g.ndim == 2
+    height, width = g.shape
+
+    row_period, col_period, tile = _infer_unique_period_and_tile(g)
+    out = g.copy()
+    completed = np.zeros_like(g, dtype=bool)
+
+    for r in range(height):
