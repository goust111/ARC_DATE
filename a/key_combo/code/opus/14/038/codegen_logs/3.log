+    height, width = grid.shape
+    for r in range(height):
+        for c in range(width):
+            color = int(grid[r, c])
+            if color in (0, MARKER):
+                continue
+            key = (r % row_period, c % col_period)
+            prev = tile.get(key)
+            if prev is not None and prev != color:
+                return None
+            tile[key] = color
+    return tile
+
