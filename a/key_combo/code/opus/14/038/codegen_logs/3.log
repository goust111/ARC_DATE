+def _pick_distinct_zone_rows(
+    zero_by_row_zone: dict[int, dict[str, list[int]]], fg_by_row: dict[int, list[int]]
+) -> dict[str, int] | None:
+    rows = list(fg_by_row)
+    for _ in range(200):
+        used: set[int] = set()
+        picked: dict[str, int] = {}
+        zones = list(ZONE_NAMES)
+        random.shuffle(zones)
+        ok = True
+        for zone in zones:
+            candidates = [
+                row
+                for row in rows
+                if row not in used
+                and len(fg_by_row[row]) >= 2
+                and zero_by_row_zone[row][zone]
+            ]
+            if not candidates:
+                ok = False
+                break
+            row = random.choice(candidates)
+            used.add(row)
+            picked[zone] = row
+        if ok:
+            return picked
+    return None
