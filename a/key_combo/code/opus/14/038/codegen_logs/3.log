+    min_area = min(row_period * col_period for row_period, col_period, _ in candidates)
+    best = [
+        candidate
+        for candidate in candidates
+        if candidate[0] * candidate[1] == min_area
+    ]
+    assert len(best) == 1, "expected a unique smallest period"
+    return best[0]
