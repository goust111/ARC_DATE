+    return None
+
+
+def _sample_dims(max_side: int = 5) -> tuple[int, int]:
+    h = random.randint(3, max_side)
+    w = random.randint(3, max_side)
+    return h, w
+
+
+def _build_plan(total_rects: int) -> list[str]:
