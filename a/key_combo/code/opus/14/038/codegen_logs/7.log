+def _collect_grey_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    visited = np.zeros((H, W), dtype=bool)
+    rects: list[dict] = []
