+
+GREY = 5
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+_GEN_ATTEMPTS = 600
+_PLACEMENT_ATTEMPTS = 300
+
+
+def _bbox_dims(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _mirror_bbox(bbox: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return c0, r0, c1, r1
+
+
+def _bboxes_touch_or_overlap(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    *,
+    margin: int = 0,
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + margin < br0
+        or br1 + margin < ar0
+        or ac1 + margin < bc0
+        or bc1 + margin < ac0
+    )
+
+
+def _collect_grey_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    visited = np.zeros((H, W), dtype=bool)
+    rects: list[dict] = []
+
+    for r in range(H):
+        for c in range(W):
+            if visited[r, c] or int(g[r, c]) != GREY:
+                continue
+
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < H and 0 <= nc < W and not visited[nr, nc] and int(g[nr, nc]) == GREY:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
