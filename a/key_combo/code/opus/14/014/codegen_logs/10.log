+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        rr, cc = random.choice(frontier)
+        mask[rr, cc] = True
+    return mask
+
+
+def _mask_subsets(mask: np.ndarray) -> list[tuple[tuple[int, int], ...]]:
+    cells = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    subsets: list[tuple[tuple[int, int], ...]] = []
