+        ("tl", range(0, 4), (0, 1)),
+        ("tr", range(0, 4), (w - 2, w - 1)),
+        ("bl", range(h - 1, max(-1, h - 5), -1), (0, 1)),
+        ("br", range(h - 1, max(-1, h - 5), -1), (w - 2, w - 1)),
