+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+PINK = 6
+ORANGE = 7
+
+OBJECT_COLORS = (BLUE, RED, GREEN, ORANGE)
+AXIS_FROM_INDICATOR = {BLUE: "lr", RED: "ud"}
+INDICATOR_FROM_AXIS = {"lr": BLUE, "ud": RED}
+MASK = PINK
+
+CANVAS_HEIGHTS = tuple(range(13, 18))
+CANVAS_WIDTHS = tuple(range(13, 18))
+OBJECT_COUNTS = (3, 4)
+PARTIAL_DIMS = ((3, 3), (3, 4), (4, 3), (4, 4))
+GEN_ATTEMPTS = 600
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    return len(_components(mask)) == 1
+
+
+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
