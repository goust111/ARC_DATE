+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    crop = mask[r0 : r1 + 1, c0 : c1 + 1]
+    completed = _complete_crop(crop, axis)
+    out = np.zeros_like(mask, dtype=bool)
+    out[r0 : r1 + 1, c0 : c1 + 1] = completed
+    return out
+
