+        return None
+
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    legend_rows, legend_cols = _legend_layout(h, w, count, corner)
+    row_min, row_max = _reserve_rows(h, count, corner)
+    if row_min > row_max:
