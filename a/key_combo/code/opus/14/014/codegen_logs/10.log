+    out = np.zeros_like(mask, dtype=bool)
+    out[r0 : r1 + 1, c0 : c1 + 1] = completed
+    return out
+
+
+def _detect_legend(grid: np.ndarray) -> tuple[dict[int, str], set[tuple[int, int]]]:
+    h, w = grid.shape
+    corners = (
+        ("tl", range(0, 4), (0, 1)),
