+
+
+def _random_partial_spec() -> tuple[np.ndarray, dict[str, list[tuple[tuple[int, int], ...]]], dict[str, np.ndarray]] | None:
+    for _ in range(200):
+        h, w = random.choice(PARTIAL_DIMS)
