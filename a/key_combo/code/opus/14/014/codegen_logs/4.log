        for c0 in _GEN_FRAME_ORIGINS:
            grid[r0 : r0 + _GEN_FRAME_SIZE, c0 : c0 + _GEN_FRAME_SIZE] = _GEN_SCAFFOLD
            grid[r0 + 1, c0 + 1] = _GEN_BG
    return grid


