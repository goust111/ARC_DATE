+                [(r0, c0), (r1, c0), (r1, c1)],
+            ]
+        )
+
+    random.shuffle(patterns)
+    patterns = patterns[mode % len(patterns) :] + patterns[: mode % len(patterns)]
+    for base in patterns:
+        unique = []
+        seen = set()
+        for cell in base:
+            if cell not in seen:
+                unique.append(cell)
+                seen.add(cell)
+        if any(cell in occupied for cell in unique):
+            continue
+
+        wanted = random.randint(max(2, len(unique)), min(4, len(all_cells)))
