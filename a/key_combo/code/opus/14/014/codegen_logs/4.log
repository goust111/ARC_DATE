+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+CELL_PITCH = 4
+FRAME_SIZE = 3
+CENTER_OFFSET = 1
+MIN_CELLS = 3
+MAX_CELLS = 7
+MAX_ATTEMPTS = 400
+
+_USED_OUTPUT_SIGNATURES: set[str] = set()
+_GEN_COUNTER = 0
