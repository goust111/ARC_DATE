+def _place_markers(payload: np.ndarray, color: int, markers: Iterable[tuple[int, int]]) -> None:
+    for br, bc in markers:
+        rr = br * CELL_PITCH + CENTER_OFFSET
+        cc = bc * CELL_PITCH + CENTER_OFFSET
+        payload[rr, cc] = color
