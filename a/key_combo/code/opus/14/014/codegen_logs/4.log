        max_span = min(4, n_cells)
        height = random.randint(2, max_span)
        width = random.randint(2, max_span)
        r0 = random.randint(0, n_cells - height)
        c0 = random.randint(0, n_cells - width)
        rect = (r0, c0, r0 + height - 1, c0 + width - 1)
        if kind == "box":
