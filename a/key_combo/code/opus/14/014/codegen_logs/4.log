+
+def _rect_markers(rect: tuple[int, int, int, int], occupied: set[tuple[int, int]], mode: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    all_cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+    extremes = {
+        (r0, c0),
+        (r0, c1),
+        (r1, c0),
+        (r1, c1),
+    }
+    edge_cells = [(r, c) for (r, c) in all_cells if r in (r0, r1) or c in (c0, c1)]
+    inner_cells = [(r, c) for (r, c) in all_cells if (r, c) not in extremes]
+
+    patterns = []
+    if r0 == r1:
