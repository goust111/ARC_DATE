+def _build_scaffold(n_cells: int) -> np.ndarray:
+    payload = np.zeros((CELL_PITCH * n_cells, CELL_PITCH * n_cells), dtype=int)
+    for br in range(n_cells):
+        for bc in range(n_cells):
+            r0 = br * CELL_PITCH
+            c0 = bc * CELL_PITCH
