+    payload[r0 : r0 + FRAME_SIZE, c0] = color
+    payload[r0 : r0 + FRAME_SIZE, c0 + FRAME_SIZE - 1] = color
+
+
+def _expand_color(payload: np.ndarray, color: int) -> None:
