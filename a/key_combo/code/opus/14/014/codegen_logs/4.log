+    assert _scaffold_like(payload), "payload does not match the scaffold layout"
+    shifted = _roll_payload(payload, shift_h, shift_v)
+
+    out = shifted.copy()
+    for color in (GREEN, BLUE):
+        _expand_color(out, color)
+    return out
