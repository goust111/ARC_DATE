    return int(np.sum(out == Color.YELLOW)) == path_len - 2


def _gen_candidate_ok(g: np.ndarray, target_turn: int | None) -> bool:
    """Run structural and oracle checks shared by all layout variants."""
    reds = np.argwhere(g == Color.RED)
    if reds.shape != (2, 2):
