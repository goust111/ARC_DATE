+    return expected
+
+
+def _validate_instance(
+    sparse_input: np.ndarray,
+    compact_input: np.ndarray,
+    compact_output: np.ndarray,
+    sprite_patch: np.ndarray,
+    source_pos: tuple[int, int],
+    fragment_records: list[dict[str, object]],
+) -> bool:
