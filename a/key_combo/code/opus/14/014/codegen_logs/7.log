+
+
+def _choose_positions(height: int, width: int, count: int) -> list[tuple[int, int]] | None:
+    all_positions = [(r, c) for r in range(COMPACT_SIZE - height + 1) for c in range(COMPACT_SIZE - width + 1)]
+    for _ in range(250):
