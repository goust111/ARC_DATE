  grid: 12-27 rows x 14-25 cols
  colors:
    background: always BLACK (0)
    foreground: one non-red, non-black color (observed: azure, blue, green, yellow)
    red: absent from input, used only in output
  blank_lines:
    definition: rows/columns consisting entirely of background color
    blank_rows: 0-3
    blank_cols: 1-2
    total: 2-5 (at least 1 blank row or 1 blank col)
    position: never at grid edges [observed]
    segment_size: >=1 rows/cols between consecutive blanks and edges
  foreground_pattern:
    density_in_non_blank_area: 0.68-0.72 (randomly scattered)
    every non-blank row has >=1 foreground pixel
    every non-blank column has >=1 foreground pixel
  output_transform:
    recolor all cells in blank rows and blank columns to RED
    all other cells unchanged

generation_strategy:
