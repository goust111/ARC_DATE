+def _normalize_shape(cells: Iterable[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = np.array(list(cells), dtype=int)
+    pts[:, 0] -= int(pts[:, 0].min())
+    pts[:, 1] -= int(pts[:, 1].min())
+    return tuple(sorted((int(r), int(c)) for r, c in pts))
