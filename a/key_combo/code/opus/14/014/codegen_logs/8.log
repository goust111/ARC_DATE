+    for flip in (1, -1):
+        cur = pts.copy()
+        cur[:, 1] *= flip
+        for _ in range(4):
+            variants.add(_normalize_shape(cur))
+            cur = np.column_stack((-cur[:, 1], cur[:, 0]))
+    return list(variants)
