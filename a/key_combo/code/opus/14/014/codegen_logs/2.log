+    class Color:
+        BLACK = 0
+        BLUE = 1
+        RED = 2
+        GREEN = 3
+        YELLOW = 4
+        GREY = 5
+
+    def bbox(mask: np.ndarray):
+        coords = np.argwhere(mask)
+        if coords.size == 0:
+            return None
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        return int(r0), int(c0), int(r1), int(c1)
+
+    def crop_bbox(grid: np.ndarray, box):
+        r0, c0, r1, c1 = box
+        return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
