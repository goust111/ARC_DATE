+
+def _lr_symmetric(mask: np.ndarray) -> bool:
+    box = bbox(mask)
+    assert box is not None, "shape mask must be non-empty"
+    tight = crop_bbox(mask.astype(int), box).astype(bool)
+    return bool(np.array_equal(tight, np.fliplr(tight)))
