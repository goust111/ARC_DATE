+ROWCOL_FILL = int(Color.GREEN)
+SHAPE_COLORS = (int(Color.BLUE), int(Color.RED), int(Color.GREEN), int(Color.YELLOW))
+
+GRID_SIDE_MIN = 3
+GRID_SIDE_MAX = 6
