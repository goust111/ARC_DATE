+        for r0 in range(4 - h):
+            for c0 in range(4 - w):
+                patch = np.zeros((3, 3), dtype=bool)
+                patch[r0 : r0 + h, c0 : c0 + w] = proto
+                key = tuple(map(int, patch.flatten()))
+                if key in seen:
