   168	        if int(nxt[:, 1].min()) < left_wall or int(nxt[:, 1].max()) > right_wall:
   169	            return cur
   170	        if np.any(occupied[nxt[:, 0], nxt[:, 1]]):
   171	            return cur
   172	        cur = nxt
   173	
   174	
   175	def _render_moved_items(
   176	    crop_shape: tuple[int, int],
   177	    top_h: int,
   178	    items: list[dict[str, Any]],
   179	    *,
   180	    reverse_same_band: bool = False,
   181	    ignore_blockers: bool = False,
   182	) -> tuple[np.ndarray, list[dict[str, Any]]]:
   183	    out = _band_background(crop_shape, top_h)
   184	    occupied = np.zeros(crop_shape, dtype=bool)
   185	    moved_items: list[dict[str, Any]] = []
   186	    left_wall = 1
   187	    right_wall = crop_shape[1] - 2
   188	
   189	    for band in (BLUE, TEAL):
   190	        band_items = [item for item in items if item["band"] == band]
   191	        band_items.sort(key=lambda item: (-item["distance"], item["anchor"][0], item["anchor"][1], item["src"]))
   192	        if reverse_same_band and len(band_items) > 1:
   193	            band_items.reverse()
   194	        local_occupied = occupied if not ignore_blockers else np.zeros_like(occupied)
   195	        direction = 1 if band == BLUE else -1
   196	        for item in band_items:
   197	            moved = _slide_coords(item["coords"], direction, left_wall, right_wall, local_occupied)
   198	            if ignore_blockers:
   199	                assert not np.any(occupied[moved[:, 0], moved[:, 1]]), "independent flush collided unexpectedly"
   200	            assert not np.any(occupied[moved[:, 0], moved[:, 1]]), "moved sprites must not overlap"
   201	            occupied[moved[:, 0], moved[:, 1]] = True
   202	            out[moved[:, 0], moved[:, 1]] = int(item["tgt"])
   203	            moved_item = dict(item)
   204	            moved_item["final_coords"] = moved
   205	            moved_items.append(moved_item)
   206	    return out, moved_items
   207	
   208	
   209	def _solve(grid: np.ndarray, *, return_meta: bool = False):
   210	    g = np.asarray(grid, dtype=int)
   211	    assert g.ndim == 2, "expected a 2D grid"
   212	
   213	    fr0, fc0, fr1, fc1 = _find_frame_bbox(g)
   214	    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
   215	    inner = crop[1:-1, 1:-1]
