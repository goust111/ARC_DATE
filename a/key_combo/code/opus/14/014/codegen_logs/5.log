+
+def _random_shape(rng: random.Random) -> np.ndarray:
+    for _ in range(50):
+        arr = _coords_to_mask(BASE_SHAPES[rng.randrange(len(BASE_SHAPES))])
+        if rng.random() < 0.5:
+            arr = np.fliplr(arr)
