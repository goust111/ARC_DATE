   217	
   218	    placeholders = []
   219	    for r in range(1, crop.shape[0] - 1):
   220	        for c in range(1, crop.shape[1] - 1):
   221	            color = int(crop[r, c])
   222	            if color in PLACEHOLDER_COLORS:
