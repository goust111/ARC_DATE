+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+PLACEHOLDER_COLORS = (RED, GREEN)
+FRAME_COLOR = GREY
+LEGEND_OUTPUT_POOL = (YELLOW, PINK, ORANGE, MAROON)
