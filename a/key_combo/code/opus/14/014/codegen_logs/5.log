+        use_extra_legend = rng.random() < 0.45
+        extra_src = rng.choice(LEGEND_OUTPUT_POOL) if use_extra_legend else None
+        available_tgts = [c for c in LEGEND_OUTPUT_POOL if c != extra_src]
