+def _band_background(crop_shape: tuple[int, int], top_h: int) -> np.ndarray:
+    h, w = crop_shape
+    out = np.full((h, w), BLACK, dtype=int)
+    out[0, :] = FRAME_COLOR
+    out[-1, :] = FRAME_COLOR
+    out[:, 0] = FRAME_COLOR
+    out[:, -1] = FRAME_COLOR
+    out[1 : 1 + top_h, 1:-1] = BLUE
+    out[1 + top_h : -1, 1:-1] = TEAL
+    return out
