+        arr = _coords_to_mask(BASE_SHAPES[rng.randrange(len(BASE_SHAPES))])
+        if rng.random() < 0.5:
+            arr = np.fliplr(arr)
+        arr = np.rot90(arr, k=rng.randrange(4))
