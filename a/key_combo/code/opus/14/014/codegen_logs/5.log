+) -> dict[int, int] | None:
+    order = sorted(range(len(specs)), key=lambda i: len(specs[i]["shape"]), reverse=True)
+    cols: dict[int, int] = {}
+    occupied: set[tuple[int, int]] = set()
+
+    def backtrack(k: int) -> bool:
+        if k == len(order):
+            return True
+        idx = order[k]
+        options = _column_options(specs[idx]["shape"], inner_w, specs[idx]["band"])
+        rng.shuffle(options)
