+def _slide_coords(
+    coords: np.ndarray,
+    direction: int,
+    left_wall: int,
+    right_wall: int,
+    occupied: np.ndarray,
+) -> np.ndarray:
+    cur = coords.copy()
+    while True:
+        nxt = cur.copy()
+        nxt[:, 1] += int(direction)
+        if int(nxt[:, 1].min()) < left_wall or int(nxt[:, 1].max()) > right_wall:
+            return cur
+        if np.any(occupied[nxt[:, 0], nxt[:, 1]]):
