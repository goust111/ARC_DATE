+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    inner_h = rng.randint(8, 11)
+    inner_w = rng.randint(11, 14)
+    top_h = rng.randint(3, inner_h - 3)
+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+
+    red_shape = _random_shape(rng)
+    green_shape = _random_shape(rng)
