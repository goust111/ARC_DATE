+    fr0, fc0, fr1, fc1 = _find_frame_bbox(g)
+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    inner = crop[1:-1, 1:-1]
+    top_h = _find_top_band_height(inner)
