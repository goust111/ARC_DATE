+        if lane_count == 3:
+            sym_seq.append(rng.choice(("lr", "rot")))
+        rng.shuffle(sym_seq)
+
+        lanes: list[dict[str, object]] = []
+        for carrier, sym in zip(carrier_seq, sym_seq):
+            choices = [tpl for tpl in TEMPLATES if tpl["sym"] == sym]
+            info = _lane_info(rng.choice(choices), carrier, rng)
+            lanes.append(info)
