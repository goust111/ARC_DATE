+
+BACKGROUND = 0
+ANCHOR_COLOR = 5
+OBJECT_COLOR_POOL = (1, 2, 3, 7)
+QUADRANT_COLOR_POOL = (4, 6, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
