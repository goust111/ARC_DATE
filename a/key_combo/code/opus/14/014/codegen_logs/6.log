+    upper_quad = _quadrant(*_centroid(abs_upper), *anchor_center)
+    lower_quad = _quadrant(*_centroid(abs_lower), *anchor_center)
+    upper_color = singleton_colors[upper_quad]
+    lower_color = singleton_colors[lower_quad]
