+    out = inp.copy()
+    for r, c in abs_object:
+        out[r, c] = BACKGROUND
+    for r, c in abs_lower:
+        out[r, c] = lower_color
+    for r, c in abs_shifted_upper:
+        out[r, c] = upper_color
+    return inp, out
