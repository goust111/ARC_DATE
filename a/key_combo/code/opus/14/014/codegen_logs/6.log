+
+
+def _render_case(
+    h: int,
+    w: int,
+    anchor_r: int,
+    anchor_c: int,
+    singleton_colors: dict[str, int],
+    singleton_positions: dict[str, tuple[int, int]],
+    shape: dict,
+    row0: int,
+    col0: int,
+) -> tuple[np.ndarray, np.ndarray]:
