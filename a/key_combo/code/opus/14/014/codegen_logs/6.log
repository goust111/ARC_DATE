+    reserved.update(singleton_positions.values())
+    forbidden = _padded_mask(h, w, reserved)
+    groups = _feasible_positions(h, w, (anchor_r + 0.5, anchor_c + 0.5), forbidden, shape)
+    if not groups:
+        return None
