+    key = random.choice(sorted(groups))
+    row0, col0 = random.choice(groups[key])
+    inp, expected = _render_case(
+        h,
+        w,
+        anchor_r,
+        anchor_c,
+        singleton_colors,
+        singleton_positions,
+        shape,
+        row0,
+        col0,
+    )
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if not _semantic_shortcut_checks(inp, expected):
+        return None
+    return inp
