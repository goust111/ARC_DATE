+            abs_upper = _absolute_coords(shape["upper"], row0, col0)
+            abs_lower = _absolute_coords(shape["lower"], row0, col0)
+            upper_centroid = _centroid(abs_upper)
+            lower_centroid = _centroid(abs_lower)
+            try:
