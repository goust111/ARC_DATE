+        out[r, c] = BACKGROUND
+    for r, c in abs_lower:
+        out[r, c] = lower_color
+    for r, c in abs_shifted_upper:
+        out[r, c] = upper_color
+    return inp, out
+
+
+def _semantic_shortcut_checks(inp: np.ndarray, expected: np.ndarray) -> bool:
+    info = _analyze(inp)
