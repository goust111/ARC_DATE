+        valid_dls = []
+        for dl in (-1, 0, 1):
+            dr = dl + delta_w
+            if -1 <= dr <= 1:
+                valid_dls.append(dl)
+        if not valid_dls:
+            return None
+        dl = int(valid_dls[int(rng.integers(len(valid_dls)))])
+        lefts.append(lefts[-1] + dl)
+        rights.append(lefts[-1] + widths[idx] - 1)
