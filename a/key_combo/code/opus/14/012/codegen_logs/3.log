    return grey


def _gen_render_pair(squares, grey):
    out = np.full(_GEN_SHAPE, Color.BLACK, dtype=int)
    for r, c in grey:
        out[r, c] = Color.GREY
    for r, c, side in squares:
        out[r : r + side, c : c + side] = Color.BLUE

    inp = out.copy()
    inp[inp == Color.BLUE] = Color.BLACK
    return inp, out


