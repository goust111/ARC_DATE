+
+
+def _place_shapes(shape_masks: list[np.ndarray], grid_shape: tuple[int, int], rng: np.random.Generator) -> list[dict] | None:
+    height, width = grid_shape
+    blocked: set[tuple[int, int]] = set()
+    placed: list[dict] = []
