+                "index": idx,
+                "top": int(top),
+                "left": int(left),
+                "filled_coords": coords,
+                "filled_mask_local": mask,
+                "outline_local": _outline_from_filled(mask),
+                "area": int(mask.sum()),
+                "height": int(mask.shape[0]),
+                "width": int(mask.shape[1]),
+            }
+        )
