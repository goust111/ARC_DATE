+
+BG = 5
+OUTLINE_PALETTE = (1, 2, 3, 4)
+BAND_PALETTE = (6, 7, 8, 9)
+NEIGHBORS8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
