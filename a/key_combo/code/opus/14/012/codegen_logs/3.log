+        top = int(obj["top"])
+        left = int(obj["left"])
+        for row, col in np.argwhere(outline_local):
+            grid[top + int(row), left + int(col)] = int(color)
+    for col, color in zip(band_cols, band_colors):
+        grid[-1, int(col)] = int(color)
+    return grid
