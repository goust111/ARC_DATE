+    out = np.full_like(np.asarray(grid, dtype=int), BG)
+    ranked = sorted(objects, key=lambda obj: -int(obj["area"]))
+    for band_color, obj in zip(band_colors, ranked):
+        out[obj["filled_mask"]] = int(band_color)
+    out[-1, :] = BG
+    return out
