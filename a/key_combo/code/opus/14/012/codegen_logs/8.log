+    if len({hole["base_color"] for hole in details["holes"]}) < 2:
+        return None
+    if sum(hole["ignored_count"] for hole in details["holes"]) == 0:
+        return None
+    if sum(int(hole["applied_marker"].sum()) for hole in details["holes"]) == 0:
