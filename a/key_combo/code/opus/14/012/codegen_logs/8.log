+        mask[min(h - 1, 1), min(w - 1, 1)] = True
+        mask[h - 1, w - 1] = True
+        mask[max(0, h - 2), 0] = True
+        mask[0, max(0, w - 2)] = True
+    else:
+        mask[0, w // 2] = True
+        mask[h // 2, 0] = True
+        mask[h - 1, w // 2] = True
