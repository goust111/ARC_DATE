+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+SPRITE_COLORS = (BLUE, RED, YELLOW)
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+FRAME_H_RANGE = (12, 14)
