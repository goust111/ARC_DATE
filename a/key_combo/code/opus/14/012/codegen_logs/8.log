+    right_band_w = max(src_w, dst_w, max_sprite_w) + (dst_w + 2 if distractor_overlap > 0 else 0) + 4
+    min_grid_h = max(GRID_H_RANGE[0], frame_h + bottom_extension + 4)
+    min_grid_w = max(GRID_W_RANGE[0], frame_w + right_band_w + 4)
+    if min_grid_h > GRID_H_RANGE[1] or min_grid_w > GRID_W_RANGE[1]:
+        return None
