+    sys.path.append(str(ARC_UTILS_DIR))
+
+from arc_utils import bbox_coords, components_mask, crop_bbox, find_components, get_bg
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+SPRITE_COLORS = (BLUE, RED, YELLOW)
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (20, 30)
+GRID_W_RANGE = (20, 30)
+FRAME_H_RANGE = (12, 14)
+FRAME_W_RANGE = (11, 13)
+RECT_H_RANGE = (4, 6)
+RECT_W_RANGE = (4, 6)
