+def _place_holes(rng: random.Random, frame_h: int, frame_w: int, count: int) -> list[dict] | None:
+    chosen = rng.sample(SHAPE_LIBRARY, count)
+    holes: list[dict] = []
+    slots = [
+        (1, 1, 4, 4),
+        (1, frame_w - 5, 4, 4),
+        (frame_h - 5, 2, 4, 4),
