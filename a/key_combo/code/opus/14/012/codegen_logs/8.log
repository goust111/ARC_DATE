+        shape = next((variant for variant in variants if variant.shape[0] <= slot_h and variant.shape[1] <= slot_w), None)
+        if shape is None:
+            return None
+        sh, sw = shape.shape
+        top = slot_r0 + rng.randint(0, slot_h - sh)
+        left = slot_c0 + rng.randint(0, slot_w - sw)
