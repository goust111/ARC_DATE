+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        if not (r1 < fr0 or r0 > fr1 or c1 < fc0 or c0 > fc1):
+            continue
+        _, mask = _coords_to_mask(comp["coords"])
+        sprites.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "mask": mask,
+                "key": _canonical_key(mask),
+                "color": int(comp["color"]),
+            }
