+def _extract_sprites(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> list[dict]:
+    fr0, fc0, fr1, fc1 = map(int, frame_bbox)
+    sprites: list[dict] = []
+    for comp in find_components(
