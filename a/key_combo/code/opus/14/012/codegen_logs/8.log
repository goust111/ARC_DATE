+def _place_holes(rng: random.Random, frame_h: int, frame_w: int, count: int) -> list[dict] | None:
+    chosen = rng.sample(SHAPE_LIBRARY, count)
+    holes: list[dict] = []
+    reserved = np.zeros((frame_h, frame_w), dtype=bool)
+    transformed_count = 0
+    for base_shape in chosen:
+        variants = _all_variants(base_shape)
+        rng.shuffle(variants)
+        placed = False
+        for shape in variants:
+            sh, sw = shape.shape
+            rows = list(range(1, frame_h - sh))
+            cols = list(range(1, frame_w - sw))
+            rng.shuffle(rows)
+            rng.shuffle(cols)
+            for top in rows:
+                for left in cols:
+                    if not _can_place_hole(reserved, shape, top, left, (frame_h, frame_w)):
+                        continue
+                    reserved[max(0, top - 1) : min(frame_h, top + sh + 1), max(0, left - 1) : min(frame_w, left + sw + 1)] = True
+                    if not np.array_equal(shape, base_shape):
+                        transformed_count += 1
+                    holes.append(
+                        {
+                            "shape": shape.copy(),
+                            "bbox": (top, left, top + sh - 1, left + sw - 1),
+                            "key": _canonical_key(shape),
+                        }
+                    )
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
+                break
+        if not placed:
+            return None
+    if len({hole["key"] for hole in holes}) != count:
+        return None
+    if transformed_count == 0:
+        return None
+    return holes
