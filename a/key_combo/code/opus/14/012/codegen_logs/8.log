+        bbox, _ = _coords_to_mask(coords)
+        sub = crop_bbox(grid, bbox)
+        if not np.all(np.isin(sub, [GREY, ORANGE])):
+            continue
+        if ORANGE not in set(map(int, sub.flat)):
+            continue
+        rects.append({"bbox": bbox, "sub": sub})
+    return rects
