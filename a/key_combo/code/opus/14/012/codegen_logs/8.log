+        details["holes"].append(
+            {
+                "bbox": hole["bbox"],
+                "mask": hole["mask"],
+                "base_color": base_color,
+                "sprite_bbox": matches[0]["bbox"],
+                "mapped_marker": mapped,
+                "applied_marker": applied,
+                "ignored_count": int(mapped.sum() - applied.sum()),
