+    for rect in rects:
+        r0, c0, r1, c1 = rect["bbox"]
+        if r0 < 1 or c0 < 1 or r1 >= grid_h - 1 or c1 >= grid_w - 1:
+            return None
+
+    occupied = np.zeros((grid_h, grid_w), dtype=bool)
+    fr0, fc0, fr1, fc1 = frame_bbox
+    occupied[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
+    for (sr0, sc0), sprite in zip(sprite_positions, sprites):
+        sh, sw = sprite["shape"].shape
+        if occupied[max(0, sr0 - 1) : min(grid_h, sr0 + sh + 1), max(0, sc0 - 1) : min(grid_w, sc0 + sw + 1)].any():
