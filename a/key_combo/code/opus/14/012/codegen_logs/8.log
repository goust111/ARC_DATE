+    if kind == 0:
+        mask[0, 0] = True
+        mask[0, w - 1] = True
+        mask[h - 1, 0] = True
+        mask[h - 1, w - 1] = True
+        mask[h // 2, min(1, w - 1)] = True
+    elif kind == 1:
+        mask[0, : min(3, w)] = True
+        mask[: min(3, h), 0] = True
+        mask[h - 1, w - 1] = True
+    elif kind == 2:
+        mask[: min(3, h), w - 1] = True
+        mask[h - 1, max(0, w - 3) : w] = True
+        mask[min(h - 1, 1), 0] = True
+    elif kind == 3:
+        mask[0, 0] = True
+        mask[min(h - 1, 1), min(w - 1, 1)] = True
+        mask[h - 1, w - 1] = True
+        mask[max(0, h - 2), 0] = True
+        mask[0, max(0, w - 2)] = True
+    else:
+        mask[0, w // 2] = True
+        mask[h // 2, 0] = True
+        mask[h - 1, w // 2] = True
+        mask[h // 2, w - 1] = True
+        mask[h - 1, w - 1] = True
