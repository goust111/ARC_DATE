+    source_r0 = frame_bbox[2] - source_overlap + 1
+    if distractor_overlap == 0:
+        distractor_r0 = source_r0 + src_h + distractor_gap
+    else:
+        distractor_r0 = frame_bbox[2] - distractor_overlap + 1
+
+    source_c0 = frame_bbox[3] + 3
