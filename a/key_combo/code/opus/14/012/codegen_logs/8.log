+        bbox, mask = _coords_to_mask(coords)
+        holes.append(
+            {
+                "bbox": bbox,
+                "mask": mask,
+                "key": _canonical_key(mask),
+            }
+        )
+    holes.sort(key=lambda hole: hole["bbox"])
