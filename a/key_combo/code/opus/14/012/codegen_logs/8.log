+            hole_shape = holes[sprite["hole_index"]]["shape"]
+            alternatives = [variant for variant in _all_variants(hole_shape) if not np.array_equal(variant, hole_shape)]
+            if alternatives:
+                sprite["shape"] = rng.choice(alternatives).copy()
+                changed = 1
