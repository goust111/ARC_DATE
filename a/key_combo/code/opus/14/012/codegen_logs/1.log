+            region[depth == 0] = frame_color
+            region[(depth > 0) & (depth % 2 == 1)] = RING_RED
+            region[(depth > 0) & (depth % 2 == 0)] = RING_GREEN
+        else:
+            region = out[r0 + 1 : r1, c0 + 1 : c1]
+            region[region == BG] = motif_color
