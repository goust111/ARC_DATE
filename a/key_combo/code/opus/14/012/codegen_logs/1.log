+        inner[spec["motif_mask"]] = spec["motif_color"]
+
+    out = _expected_from_plan(inp, placements)
+    if not _validate_plan(inp, out, placements):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
