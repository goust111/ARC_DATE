+
+def _build_panel(
+    panel_h: int,
+    panel_w: int,
+    anchor: tuple[int, int],
+    path: list[tuple[int, int]],
+    red_count: int,
+) -> np.ndarray:
+    panel = np.full((panel_h, panel_w), BG, dtype=int)
+    ar, ac = anchor
+    for idx, (r, c) in enumerate(path):
+        panel[ar + r, ac + c] = RED if idx < red_count else BLUE
+    return panel
