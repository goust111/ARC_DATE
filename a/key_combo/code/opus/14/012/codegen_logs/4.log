+        added = list(cur - prev)
+        assert len(added) == 1, "exactly one red cell must be added each frame"
+        ar, ac = added[0]
+        assert any((ar, ac) == nb for cell in prev for nb in _neighbors4(*cell)), (
+            "new red cell must touch the previous red region"
+        )
+        sequence.append(added[0])
