+    assert red_coords | blue_coords == {
+        tuple(map(int, rc)) for rc in np.argwhere(local_mask)
+    }
+    return {
+        "anchor": (r0, c0),
+        "crop": crop,
+        "mask": local_mask,
+        "red": red_coords,
+        "blue": blue_coords,
+    }
