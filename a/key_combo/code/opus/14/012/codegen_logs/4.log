+def _normalize_path(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    r0 = min(r for r, _ in path)
+    c0 = min(c for _, c in path)
+    return [(r - r0, c - c0) for r, c in path]
+
+
+def _has_turn(path: list[tuple[int, int]]) -> bool:
