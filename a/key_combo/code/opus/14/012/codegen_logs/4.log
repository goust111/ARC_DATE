+    anchors = [frame["anchor"] for frame in frames]
+    deltas = [
+        (anchors[i + 1][0] - anchors[i][0], anchors[i + 1][1] - anchors[i][1])
+        for i in range(3)
+    ]
+    assert len(set(deltas)) == 1, "sprite translation must be constant"
+    dr, dc = deltas[0]
+    assert (dr, dc) != (0, 0), "translation must be non-zero"
