+    candidates: list[list[np.ndarray]] = []
+
+    if len(row_seps) == 3:
+        panel_h = row_seps[0]
+        expected = [panel_h + i * (panel_h + 1) for i in range(3)]
+        sep_colors = [int(g[r, 0]) for r in row_seps]
+        if (
+            panel_h > 0
+            and row_seps == expected
+            and g.shape[0] == 4 * panel_h + 3
+            and len(set(sep_colors)) == 1
+        ):
+            panels = []
+            start = 0
+            for sep in row_seps:
+                panels.append(g[start:sep, :].copy())
+                start = sep + 1
+            panels.append(g[start:, :].copy())
+            if len({p.shape for p in panels}) == 1 and all(
+                not np.any(panel == sep_colors[0]) for panel in panels
+            ):
+                candidates.append(panels)
