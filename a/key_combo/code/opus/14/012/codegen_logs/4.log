+def _path_neighbors(mask: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    coords = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    neighbors: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in coords:
+        here = []
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in coords:
+                here.append((nr, nc))
+        neighbors[(r, c)] = here
+    return neighbors
