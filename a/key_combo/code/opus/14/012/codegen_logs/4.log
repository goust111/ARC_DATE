        _next_by_repeated_increment,
        _next_by_fixed_mask_prefix,
    ):
        out = model(panels, bg)
        if out is not None:
            matches.append(out)

    assert len(matches) == 1, "expected exactly one panel extrapolation model"
    return matches[0]

