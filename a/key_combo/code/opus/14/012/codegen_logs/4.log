+def _walk_path(
+    neighbors: dict[tuple[int, int], list[tuple[int, int]]],
+    start: tuple[int, int],
+) -> list[tuple[int, int]]:
+    path = [start]
+    prev = None
+    cur = start
+    while True:
+        nxts = [n for n in neighbors[cur] if n != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "path walk became ambiguous"
+        nxt = nxts[0]
+        path.append(nxt)
+        prev, cur = cur, nxt
