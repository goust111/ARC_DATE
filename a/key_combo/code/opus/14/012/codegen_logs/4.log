+
+def _has_turn(path: list[tuple[int, int]]) -> bool:
+    dirs = []
+    for (r1, c1), (r2, c2) in zip(path, path[1:]):
+        dirs.append((r2 - r1, c2 - c1))
+    return any(dirs[i] != dirs[i - 1] for i in range(1, len(dirs)))
+
+
+def _generate_induced_path(
+    canvas_h: int,
+    canvas_w: int,
+    length: int,
+    require_turn: bool,
