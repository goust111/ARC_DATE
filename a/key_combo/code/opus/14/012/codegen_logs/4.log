+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+SEP = 4
+
+GEN_ATTEMPTS = 400
+PATH_ATTEMPTS = 300
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size > 0, "expected a non-empty mask"
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q = deque([start])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _translate_non_bg(panel: np.ndarray, dr: int, dc: int, bg: int) -> np.ndarray:
+    out = np.full_like(panel, bg)
+    h, w = panel.shape
+    for r, c in np.argwhere(panel != bg):
+        nr = int(r) + dr
+        nc = int(c) + dc
+        assert 0 <= nr < h and 0 <= nc < w, "translated sprite must stay in bounds"
+        out[nr, nc] = int(panel[r, c])
+    return out
+
+
+def _split_panels(grid: np.ndarray) -> tuple[list[np.ndarray], int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = int(g[0, 0])
+    row_seps = [
+        r
+        for r in range(g.shape[0])
+        if np.all(g[r, :] == int(g[r, 0])) and int(g[r, 0]) != bg
+    ]
+    col_seps = [
+        c
+        for c in range(g.shape[1])
+        if np.all(g[:, c] == int(g[0, c])) and int(g[0, c]) != bg
+    ]
+
+    candidates: list[list[np.ndarray]] = []
+
+    if len(row_seps) == 3:
+        panel_h = row_seps[0]
+        expected = [panel_h + i * (panel_h + 1) for i in range(3)]
+        if (
+            panel_h > 0
+            and row_seps == expected
+            and g.shape[0] == 4 * panel_h + 3
+        ):
+            panels = []
+            start = 0
+            for sep in row_seps:
+                panels.append(g[start:sep, :].copy())
+                start = sep + 1
+            panels.append(g[start:, :].copy())
+            if len({p.shape for p in panels}) == 1:
+                candidates.append(panels)
+
+    if len(col_seps) == 3:
+        panel_w = col_seps[0]
+        expected = [panel_w + i * (panel_w + 1) for i in range(3)]
+        if (
+            panel_w > 0
+            and col_seps == expected
+            and g.shape[1] == 4 * panel_w + 3
+        ):
+            panels = []
+            start = 0
+            for sep in col_seps:
+                panels.append(g[:, start:sep].copy())
+                start = sep + 1
+            panels.append(g[:, start:].copy())
+            if len({p.shape for p in panels}) == 1:
+                candidates.append(panels)
