+import hashlib
+from typing import Literal
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+
+GEN_RETRY_LIMIT = 400
+GRID_MIN = 10
+GRID_MAX = 16
+PERIOD_CHOICES = (2, 3, 4)
