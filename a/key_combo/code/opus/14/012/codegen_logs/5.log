        if preferred:
            choices = preferred
    gap, ray = choices[int(np.random.randint(len(choices)))]
    return side, gap, ray


def _gen_paint_output(shape, bboxes, gaps):
    out = np.full(shape, BACKGROUND_COLOR, dtype=int)

