            dc = -1 if c < grey_c else 1
            draw_line(output_grid, r, c, length=None, color=Color.BLUE, direction=(0, dc), stop_at={Color.GREY})

    else:
        raise ValueError("Expected a single straight grey line (one row or one column).")

    return output_grid

