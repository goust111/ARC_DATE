+    out = g.copy()
+    for item in sorted(info, key=lambda x: (-int(x["d"]), -int(x["pos"][0]), -int(x["pos"][1]))):
+        color = int(item["color"])
+        for rr, cc in item["cells"]:
+            out[int(rr), int(cc)] = color
+
+    out[g == GREY] = GREY
+    for r, c, color in seeds:
+        out[r, c] = color
+    return out, info
