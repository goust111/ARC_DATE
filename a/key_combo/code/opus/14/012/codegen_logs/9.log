  "type": "move_to_match",
  "src": "hollow 3x3 square sprite s",
  "dst": "sparse guide-mask bbox d",
  "match_cond": "s.bbox is fully contained in d.bbox",
  "transform": "return the tight bbox crop of matched s",
  "grid_shape": "3x3 crop"
}
</annotation>
