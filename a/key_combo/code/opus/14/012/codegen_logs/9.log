+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _sample_guide_pixels(box: tuple[int, int, int, int], rng: random.Random) -> list[tuple[int, int]]:
