+VALID_MASKS = _precompute_masks()
+SELECTED_MASKS = [mask for mask in VALID_MASKS if int(mask.sum()) <= 8]
+
+
+def _random_sprite(n_colors: int, *, require_black: bool, rng: random.Random) -> np.ndarray:
