+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GUIDE = 6
+SPRITE_PALETTE = (1, 2, 3, 4, 5)
+
+GRID_H_RANGE = (16, 20)
+GRID_W_RANGE = (16, 20)
+SPRITE_COUNT_CHOICES = (3, 4)
+SELECTED_COLOR_COUNT_CHOICES = (3, 4)
