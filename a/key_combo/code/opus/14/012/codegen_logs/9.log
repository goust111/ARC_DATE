+def bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    row_gap = max(0, max(b[0] - a[2] - 1, a[0] - b[2] - 1))
+    col_gap = max(0, max(b[1] - a[3] - 1, a[1] - b[3] - 1))
+    if row_gap == 0:
+        return col_gap
+    if col_gap == 0:
+        return row_gap
+    return min(row_gap, col_gap)
