+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in _neighbors8(rr, cc):
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
