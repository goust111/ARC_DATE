+def _neighbors8(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
