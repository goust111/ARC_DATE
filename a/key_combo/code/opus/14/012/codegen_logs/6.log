+
+
+def _sample_extra_centers(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    placed: list[dict],
+    ks: list[int],
+) -> list[tuple[int, int]] | None:
+    h, w = shape
+    candidates = [(r, c) for r in range(4, h - 4) for c in range(4, w - 4)]
