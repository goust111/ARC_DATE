+def _rotation_assignment() -> tuple[int, int, int]:
+    perms = list(permutations((1, 2, 3)))
+    noncanonical = [perm for perm in perms if perm != GEN_CANONICAL_ASSIGNMENT]
+    if random.random() < 0.8:
