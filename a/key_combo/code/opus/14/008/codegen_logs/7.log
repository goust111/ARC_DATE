    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)
    assert height == width, "rotation mosaic requires a square grid"

    return np.block(
        [
            [g, np.rot90(g, -1)],
            [np.rot90(g, 1), np.rot90(g, 2)],
        ]
    )

