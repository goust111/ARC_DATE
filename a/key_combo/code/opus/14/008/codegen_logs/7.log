+    while len(cells) < area:
+        frontier = set()
+        for r, c in cells:
+            frontier.update(_neighbors4(r, c, n))
+        frontier.difference_update(cells)
+        if not frontier:
+            return None
+        frontier_list = sorted(frontier)
+        weights = []
+        for r, c in frontier_list:
