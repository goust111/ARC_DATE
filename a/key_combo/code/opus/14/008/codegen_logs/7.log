+
+def _neighbors4(r: int, c: int, n: int) -> list[Coord]:
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < n:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < n:
+        out.append((r, c + 1))
+    return out
+
