+        if size >= len(target):
+            continue
+        for combo in combinations(target, size):
+            fragment = frozenset(combo)
+            if not _fragment_visual_ok(fragment):
+                continue
+            match_count = sum(fragment.issubset(rotations[other]) for other in (1, 2, 3))
+            if match_count == 1:
