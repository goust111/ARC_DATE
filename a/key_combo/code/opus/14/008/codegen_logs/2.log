+        prev = cols[0]
+        for c in cols[1:] + [None]:
+            if c is None or c != prev + 1:
+                platforms.append({"row": int(r), "c0": int(start), "c1": int(prev)})
+                if c is not None:
+                    start = c
+            if c is not None:
+                prev = c
+    return platforms
