+def _placed_cells(mask: np.ndarray, r0: int, c0: int) -> set[Coord]:
+    return {(r0 + r, c0 + c) for r, c in _mask_coords(mask)}
+
+
+def _build_expected(
+    grid: np.ndarray, fragments: list[dict[str, object]], legend_cols: slice
