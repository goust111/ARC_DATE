+TEMPLATE_W_RANGE = (4, 5)
+TEMPLATE_AREA_RANGE = (6, 8)
+LEGEND_COUNT_CHOICES = (2, 3)
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+PLACEMENT_GAP = 2
+GEN_RETRIES = 400
+TEMPLATE_RETRIES = 120
+PLACEMENT_RETRIES = 120
