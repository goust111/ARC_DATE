  34:         by_color[int(comp["color"])].append(comp)
  35: 
  36:     moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
  37:     assert len(moving_colors) == 1
  38:     moving_color = int(moving_colors[0])
  39:     moving_objects = by_color[moving_color]
