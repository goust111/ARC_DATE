  80: def main(grid: np.ndarray) -> np.ndarray:
  81:     """Complete each colored corner frame by mirroring its internal blue pixels to the opposite side and remove blue pixels outside all frames.
  82: 
  83:     Input structure
  84:     A black background contains blue pixels and one non-blue marker color. The marker
  85:     color appears only as 2x2 L-corner triominoes, grouped into rectangular frames
  86:     with exactly one top-left, top-right, bottom-left, and bottom-right corner.
  87: 
  88:     Rule
  89:     Keep every non-blue pixel fixed. For each marker frame, keep the blue pixels
  90:     inside its bounding rectangle and also paint their reflected copies: wide
  91:     frames reflect left/right, while tall frames reflect top/bottom. Clear all
  92:     blue pixels that are outside every marker frame.
  93: 
  94:     Key insight
  95:     The colored L-corners define the frame bbox; the frame aspect ratio determines
  96:     which pair of opposite sides the blue motif must be copied between.
  97:     """
  98:     g = np.asarray(grid, dtype=int)
  99:     bg = get_bg(g)
 100:     marker_colors = colors_present(g, exclude={bg, BLUE})
 101:     assert len(marker_colors) == 1
 102:     marker = int(marker_colors[0])
 103:     frames = _find_frames(g, marker)
 104: 
 105:     out = g.copy()
 106:     out[g == BLUE] = bg
 107:     rr, cc = np.indices(g.shape)
 108: 
 109:     for top, left, bottom, right in frames:
 110:         height = bottom - top + 1
 111:         width = right - left + 1
 112:         assert height != width
 113: 
 114:         in_frame = (top <= rr) & (rr <= bottom) & (left <= cc) & (cc <= right)
 115:         blue_coords = np.argwhere((g == BLUE) & in_frame)
 116:         assert len(blue_coords) > 0
 117: 
 118:         for r, c in blue_coords:
 119:             r = int(r)
 120:             c = int(c)
 121:             if width > height:
 122:                 mr, mc = r, left + right - c
 123:             else:
 124:                 mr, mc = top + bottom - r, c
 125:             assert g[mr, mc] != marker
 126:             out[r, c] = BLUE
 127:             out[mr, mc] = BLUE
 128: 
 129:     return out
