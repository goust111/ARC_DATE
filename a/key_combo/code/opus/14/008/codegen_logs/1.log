  11: def main(grid: np.ndarray) -> np.ndarray:
  12:     """
  13:     Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.
  14: 
  15:     Input structure:
  16:     - The background is the most common color.
  17:     - Foreground objects are solid monochrome rectangles touching a grid corner.
  18:     - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.
  19: 
  20:     Rule:
  21:     - Clear the multiple objects of the repeated color from their original positions.
  22:     - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
  23:     - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.
  24: 
  25:     Key insight:
  26:     - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
  27:     """
  28:     g = np.asarray(grid, dtype=int)
  29:     H, W = g.shape
  30:     bg = int(get_bg(g))
  31: 
  32:     by_color: dict[int, list[dict]] = defaultdict(list)
