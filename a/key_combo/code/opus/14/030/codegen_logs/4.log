+            dists = [_dist(marker, rect) for _, rect in rects]
+            has_tie = len(set(dists)) < len(dists)
+            if desire_tie and not has_tie:
+                continue
+            if not desire_tie and has_tie and random.random() < 0.65:
+                continue
