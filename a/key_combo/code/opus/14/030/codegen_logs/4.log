+def _area(rect: Rect) -> int:
+    r0, c0, r1, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _center(rect: Rect) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect
+    return (r0 + r1 + 1) // 2, (c0 + c1 + 1) // 2
