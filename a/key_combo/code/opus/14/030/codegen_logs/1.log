+        if 0 <= r < h and 0 <= c < w:
+            blocked[r, c] = True
+    return blocked
+
+
+def _place_shape(
+    shape: tuple[tuple[int, int], ...],
+    board_shape: tuple[int, int],
+    blocked: np.ndarray,
+    predicate,
+) -> list[tuple[int, int]] | None:
+    h, w = board_shape
+    sh, sw = _shape_dims(shape)
+    options: list[list[tuple[int, int]]] = []
