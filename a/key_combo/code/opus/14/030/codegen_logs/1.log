+def _generate_blue_patch(axis_kind: str) -> tuple[tuple[int, int], ...]:
+    base = _generate_vertical_blue_patch()
+    if axis_kind == "vertical":
+        return base
+    return _normalize((c, r) for r, c in base)
+
+
+def _build_blocked(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+) -> np.ndarray:
+    h, w = shape
+    blocked = np.zeros((h, w), dtype=bool)
+    for r, c in occupied:
+        for dr, dc in DIR8 + [(0, 0)]:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                blocked[rr, cc] = True
+    for r, c in reserved:
+        if 0 <= r < h and 0 <= c < w:
+            blocked[r, c] = True
+    return blocked
+
+
+def _place_shape(
+    shape: tuple[tuple[int, int], ...],
+    board_shape: tuple[int, int],
+    blocked: np.ndarray,
+    predicate,
+) -> list[tuple[int, int]] | None:
+    h, w = board_shape
+    sh, sw = _shape_dims(shape)
+    options: list[list[tuple[int, int]]] = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            placed = [(r0 + r, c0 + c) for r, c in shape]
+            if any(blocked[r, c] for r, c in placed):
+                continue
+            if predicate(placed):
+                options.append(placed)
+    if not options:
+        return None
+    return random.choice(options)
+
