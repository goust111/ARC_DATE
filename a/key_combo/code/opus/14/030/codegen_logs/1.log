+def _line_only_output(grid: np.ndarray, ray: set[tuple[int, int]]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for r, c in ray:
+        if out[r, c] == GREEN:
+            out[r, c] = BG
+    return out
