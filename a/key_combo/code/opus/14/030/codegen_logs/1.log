+        if require_non_rect and len(shape) == h * w:
+            continue
+        if require_multirow and len(rows) < 2:
+            continue
+        if require_multicol and len(cols) < 2:
+            continue
+        return shape
+    raise RuntimeError("failed to generate connected shape")
