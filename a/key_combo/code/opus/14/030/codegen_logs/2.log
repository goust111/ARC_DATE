+    top_h = r0 - 2
+    bottom_h = h - (r0 + barrier_h) - 1
+    if top_h < 4 or bottom_h < 4:
+        return None
+
+    rects = [barrier]
+    if n_rects == 2:
+        side = random.choice(["top", "bottom"])
