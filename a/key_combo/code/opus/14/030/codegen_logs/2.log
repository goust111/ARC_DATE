+        side_r1 = r0 - 2 if side == "top" else h - 2
+        max_h = side_r1 - side_r0 + 1
+        if max_h < 4:
+            return None
+        rh = random.randint(4, min(6, max_h))
+        rw = random.randint(4, min(6, w - 2))
+        rr0 = random.randint(side_r0, side_r1 - rh + 1)
+        cc0 = random.randint(1, w - rw - 1)
