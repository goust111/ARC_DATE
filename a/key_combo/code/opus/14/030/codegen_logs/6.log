+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+INDICATOR = 4
+DECORATION = 7
+INNER_COLORS = (1, 2, 3, 6, 8, 9)
