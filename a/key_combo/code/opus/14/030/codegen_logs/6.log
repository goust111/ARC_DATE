+    assert len(indicators) == 1, "expected exactly one yellow indicator"
+    start = tuple(map(int, indicators[0]))
+    wall = grid == WALL
+    outside = _flood_from_seeds(~wall, [start])
+    inside = (~wall) & (~outside)
+    assert np.any(inside), "expected a non-empty enclosed interior"
