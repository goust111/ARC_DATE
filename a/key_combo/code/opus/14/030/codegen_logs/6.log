  "transform": "fill d: inside the region choose pixels from tile1; outside choose pixels from tile2; for row/col boundaries, allow tile2 pixels on the boundary line",
  "grid_shape": "same canvas (only tile4 changes)"
}
</annotation>
<generation_spec>
