+def _add_segment(cells: set[tuple[int, int]], r0: int, c0: int, r1: int, c1: int) -> None:
+    if r0 == r1:
+        a, b = sorted((c0, c1))
+        for c in range(a, b + 1):
+            cells.add((r0, c))
+    else:
+        a, b = sorted((r0, r1))
+        for r in range(a, b + 1):
+            cells.add((r, c0))
+
+
+def _rect_perimeter(h: int, w: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for c in range(w):
+        cells.add((0, c))
+        cells.add((h - 1, c))
+    for r in range(h):
+        cells.add((r, 0))
+        cells.add((r, w - 1))
+    return cells
+
+
+def _apply_notch(
+    cells: set[tuple[int, int]],
+    h: int,
+    w: int,
+    side: str,
+    start: int,
+    span: int,
+    depth: int,
+) -> None:
+    end = start + span
+    if side == "top":
+        for c in range(start + 1, end):
+            cells.discard((0, c))
+        _add_segment(cells, 0, start, depth, start)
+        _add_segment(cells, 0, end, depth, end)
+        _add_segment(cells, depth, start, depth, end)
+    elif side == "bottom":
+        base = h - 1
+        inner = base - depth
+        for c in range(start + 1, end):
