+
+def _hit_bands(start: int, end: int) -> list[tuple[int, int]]:
+    if end - start < 5:
+        return []
+    first_end = min(start + 1, end - 5)
+    second_start = max(start + 5, end - 1)
+    if first_end < start or second_start > end:
+        return []
+    return [(start, first_end), (second_start, end)]
