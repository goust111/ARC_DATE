+
+def _sample_cross_line_band(
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    step: tuple[int, int],
+    *,
+    half: str,
+    band: tuple[int, int],
+    reserved: np.ndarray,
+) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    for _ in range(250):
+        if step[0] != 0:
+            fh = 3
+            fw = random.randint(4, 5)
+            r_min, r_max = _start_interval(shape, center, step, half)
+            r_min = max(r_min, band[0])
+            r_max = min(r_max, band[1])
+            if r_min > r_max:
