+def _split_interval(start: int, end: int, parts: int) -> list[tuple[int, int]]:
+    length = end - start + 1
+    if length < parts:
+        return []
+    bands: list[tuple[int, int]] = []
+    cursor = start
+    base = length // parts
+    extra = length % parts
+    for idx in range(parts):
+        span = base + (1 if idx < extra else 0)
+        band_end = cursor + span - 1
+        bands.append((cursor, band_end))
+        cursor = band_end + 1
