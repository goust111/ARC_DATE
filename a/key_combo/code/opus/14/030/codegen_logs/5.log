+    if not np.array_equal(out, expected):
+        return False
+
+    changed = out != inp
+    if not np.any(changed):
+        return False
+
+    allowed = np.zeros(inp.shape, dtype=bool)
+    for frame in hit_frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        allowed[r0 + 1 : r1, c0 + 1 : c1] = True
+        color = int(frame["color"])
