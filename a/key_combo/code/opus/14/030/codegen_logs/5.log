+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLOR = 5
+FRAME_SIZE_RANGE = (3, 6)
+GRID_H_RANGE = (16, 19)
+GRID_W_RANGE = (16, 20)
+GEN_ATTEMPTS = 400
