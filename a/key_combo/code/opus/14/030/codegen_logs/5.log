+                c_min = c_max = random.choice(starts)
+
+            r0 = random.randint(r_min, r_max)
+            if crosses_line:
+                if c_min > c_max:
+                    continue
+                c0 = random.randint(c_min, c_max)
+            else:
+                c0 = c_min
+        else:
+            line = center[0]
+            left = (step[1] < 0 and half == "forward") or (step[1] > 0 and half == "opposite")
+            if left:
+                c_min = 1
+                c_max = center[1] - fw - 1
+            else:
+                c_min = center[1] + 2
+                c_max = w - fw - 1
+            if c_min > c_max:
