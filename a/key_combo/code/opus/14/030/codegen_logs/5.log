+    total_frames = random.randint(4, 6)
+    hit_count = random.randint(2, min(3, total_frames - 2))
+    extra_misses = total_frames - hit_count - 2
+
+    categories = [("forward", True)] * hit_count
+    categories.append(("forward", False))
+    categories.append(("opposite", True))
+    categories.extend(random.choice([[("opposite", False)], [("forward", False)], [("opposite", False), ("forward", False)]])[:extra_misses])
+    if len(categories) != total_frames:
+        categories = categories[:total_frames]
+
+    include_grey_frame = random.random() < 0.4
