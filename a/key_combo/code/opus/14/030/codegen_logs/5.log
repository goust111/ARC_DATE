+
+def _ray_cells(shape: tuple[int, int], center: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r = center[0] + step[0]
+    c = center[1] + step[1]
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        cells.append((r, c))
+        r += step[0]
+        c += step[1]
