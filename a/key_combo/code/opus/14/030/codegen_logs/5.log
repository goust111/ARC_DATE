+def _marker_layout(
+    h: int,
+    w: int,
+) -> tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]], tuple[int, int]]:
+    step = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
