+        if bbox is None:
+            return None
+        _draw_frame(grid, bbox, color)
+        r0, c0, r1, c1 = bbox
+        reserved[max(0, r0 - 1) : r1 + 2, max(0, c0 - 1) : c1 + 2] = True
