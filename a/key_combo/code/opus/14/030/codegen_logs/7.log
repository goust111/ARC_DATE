+        r0, c0 = _corner_position(prev_bbox, cur_h, cur_w, corners[idx - 1], overlap_h, overlap_w)
+        rects.append({"r0": r0, "c0": c0, "h": cur_h, "w": cur_w, "color": colors[idx]})
