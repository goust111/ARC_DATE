+
+
+def _visible_bbox_matches(grid: np.ndarray, rect: dict[str, int]) -> bool:
+    color = int(rect["color"])
+    coords = np.argwhere(grid == color)
+    if coords.size == 0:
+        return False
+    visible_bbox = _bbox_from_coords(coords)
+    full_bbox = (
+        int(rect["r0"]),
+        int(rect["c0"]),
+        int(rect["r0"] + rect["h"] - 1),
+        int(rect["c0"] + rect["w"] - 1),
