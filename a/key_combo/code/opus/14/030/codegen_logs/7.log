+        r0 = int(rect["r0"])
+        c0 = int(rect["c0"])
+        h = int(rect["h"])
+        w = int(rect["w"])
+        color = int(rect["color"])
+        grid[r0 : r0 + h, c0 : c0 + w] = color
+    return grid
+
+
+def _visible_bbox_matches(grid: np.ndarray, rect: dict[str, int]) -> bool:
+    color = int(rect["color"])
