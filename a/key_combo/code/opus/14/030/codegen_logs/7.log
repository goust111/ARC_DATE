+def _kahn_unique_order(nodes: list[int], edges: set[tuple[int, int]]) -> list[int]:
+    succ = {node: set() for node in nodes}
+    indeg = {node: 0 for node in nodes}
+    for low, high in edges:
+        if high not in succ[low]:
+            succ[low].add(high)
+            indeg[high] += 1
