+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+RECT_COUNT_CHOICES = (4, 5)
+SIZE_RANGE = range(3, 7)
+PAD_VALUES = (1, 2, 3)
+MAX_GENERATION_ATTEMPTS = 400
+CORNER_NAMES = ("TL", "TR", "BL", "BR")
