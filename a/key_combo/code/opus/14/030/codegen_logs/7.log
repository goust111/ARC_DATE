+
+
+def _nontrivial_visibility(rects: list[dict[str, int]], grid: np.ndarray) -> bool:
+    for rect in rects:
+        color = int(rect["color"])
+        visible = int(np.count_nonzero(grid == color))
+        if visible < 3:
+            return False
+        if not _visible_bbox_matches(grid, rect):
+            return False
