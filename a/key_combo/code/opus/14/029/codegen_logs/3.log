+def _random_path_between(a: tuple[int, int], b: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    r, c = a
+    rr, cc = b
+    cells = [(r, c)]
+    axes = ["r", "c"]
+    while (r, c) != (rr, cc):
+        rng.shuffle(axes)
+        moved = False
+        for axis in axes:
+            if axis == "r" and r != rr:
+                r += 1 if rr > r else -1
+                cells.append((r, c))
+                moved = True
+                break
+            if axis == "c" and c != cc:
+                c += 1 if cc > c else -1
+                cells.append((r, c))
+                moved = True
+                break
+        if not moved:
+            break
