+
+BG = 0
+CTRL = 2
+SPRITE = 5
+MARKER_POOL = (1, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 600
