+        row_bridge = rng.randint(max(0, cut_r - 1), cut_r)
+        col_bridge = rng.randint(max(0, cut_c - 1), cut_c)
+
+        req_tl = {(cut_r, cut_c), (row_bridge, cut_c), (cut_r, col_bridge)}
+        req_tr = {(row_bridge, cut_c + 1)}
