spec:
  grid:
    input: 10-16 rows x 10-16 cols (need not be square) [observed range 15-16]
    output: always 16x16
  background: any color except RED(2) or YELLOW(4); always 7 (orange) [observed]
  markers:
    count_of_colors: exactly 2 foreground colors scattered on background
    color_identity: any colors except bg; may include RED or YELLOW (train_1 uses 4)
    pixel_counts: two distinct counts h < w where h=height, w=width of output rectangle
    h_range: 3-14 [observed 5-12]
    w_range: 5-16 [observed 7-14]
    constraint: h < w, w <= 16, h + w = total marker pixels on grid, h + w <= grid_area
    scatter: pixels placed at arbitrary positions; mostly non-adjacent [observed]
  output_rectangle:
    position: bottom-left corner of 16x16 canvas
    size: h rows x w cols, filled with RED(2)
    diagonals: two 45-degree rising diagonals from bottom-left (0,0) and bottom-right (0,w-1) corners of the rectangle, painted YELLOW(4) over the red
    overlap: when 2*h > w, diagonals cross and share cells (yellow overwrites yellow, reducing total yellow pixel count)
    remaining_canvas: background color

generation_strategy:
  approach: output-first
  steps:
    1. Pick bg color (use 7 or any color not in {2, 4}).
    2. Pick h in [3, 14] and w in [h+1, 16] (ensures h < w, both fit in 16x16).
    3. Build 16x16 output: fill bottom-left h x w rectangle with RED, paint yellow diagonals.
    4. Pick input grid size H x W where H, W in [10, 16] and H * W >= h + w.
    5. Pick two distinct foreground colors (both != bg).
    6. Scatter h pixels of color_A and w pixels of color_B randomly on an H x W bg grid (no cell gets two markers).
