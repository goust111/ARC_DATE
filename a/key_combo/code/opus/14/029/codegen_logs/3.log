+        stop = max(row_hits)
+        for c in range(0, stop + 1):
+            if not sprite_mask[h_row, c]:
+                out[h_row, c] = CTRL
+    else:
+        stop = min(row_hits)
+        for c in range(w - 1, stop - 1, -1):
+            if not sprite_mask[h_row, c]:
+                out[h_row, c] = CTRL
+
+    if v_side == "T":
+        stop = max(col_hits)
+        for r in range(0, stop + 1):
+            if not sprite_mask[r, v_col]:
+                out[r, v_col] = CTRL
+    else:
+        stop = min(col_hits)
+        for r in range(h - 1, stop - 1, -1):
