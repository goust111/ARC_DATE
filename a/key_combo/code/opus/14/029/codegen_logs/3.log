+def _border_positions(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    pts = {(0, c) for c in range(w)}
+    pts |= {(h - 1, c) for c in range(w)}
+    pts |= {(r, 0) for r in range(h)}
+    pts |= {(r, w - 1) for r in range(h)}
+    return sorted(pts)
