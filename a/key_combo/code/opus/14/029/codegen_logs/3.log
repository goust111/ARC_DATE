+def _quadrant_label(r: int, c: int, h_row: int, v_col: int, h_side: str, v_side: str) -> str:
+    vert = "T" if (r < h_row or (r == h_row and v_side == "T")) else "B"
+    horiz = "L" if (c < v_col or (c == v_col and h_side == "L")) else "R"
