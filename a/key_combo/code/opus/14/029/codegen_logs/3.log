+
+def _random_path_between(a: tuple[int, int], b: tuple[int, int], rng: random.Random) -> list[tuple[int, int]]:
+    r, c = a
+    rr, cc = b
+    cells = [(r, c)]
+    axes = ["r", "c"]
+    while (r, c) != (rr, cc):
+        rng.shuffle(axes)
+        moved = False
+        for axis in axes:
+            if axis == "r" and r != rr:
+                r += 1 if rr > r else -1
+                cells.append((r, c))
+                moved = True
+                break
+            if axis == "c" and c != cc:
+                c += 1 if cc > c else -1
+                cells.append((r, c))
+                moved = True
+                break
+        if not moved:
+            break
+    return cells
+
+
+def _connected_subset(
+    allowed: set[tuple[int, int]],
+    area: int,
+    required: set[tuple[int, int]],
+    rng: random.Random,
+) -> set[tuple[int, int]] | None:
+    if not required or not required.issubset(allowed):
+        return None
+    req = list(required)
+    current = {req[0]}
+    for target in req[1:]:
+        path = _random_path_between(next(iter(current)), target, rng)
+        if any(cell not in allowed for cell in path):
+            return None
+        current.update(path)
+    if len(current) > area:
+        return None
+
+    while len(current) < area:
+        frontier = []
+        for r, c in current:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in allowed and (nr, nc) not in current:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        current.add(rng.choice(frontier))
