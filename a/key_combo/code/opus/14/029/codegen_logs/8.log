+    return out
+
+
+def _all_candidates(h: int, w: int, bar_r: int) -> list[PixelPlan]:
+    plans: list[PixelPlan] = []
+    for r in range(1, h - 1):
+        if r == bar_r or abs(r - bar_r) == 1:
+            continue
+        for c in range(1, w - 1):
+            try:
+                plan = _plan_pixel(h, w, bar_r, (r, c))
+            except AssertionError:
