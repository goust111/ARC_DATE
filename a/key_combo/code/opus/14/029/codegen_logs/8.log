+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    grid[bar_r, :] = BAR
+    for plan in chosen:
+        grid[plan.src] = MOVING
+
+    if not _semantic_check(grid):
+        return None
+    return grid
