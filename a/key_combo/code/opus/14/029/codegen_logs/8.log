+    for plan in plans:
+        for r, c in plan.footprint:
+            if r == bar_r:
+                continue
+            out[r, c] = MOVING
+
+    out[bar_r, :] = BAR
+    return out
+
+
+def _always_down_reference(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bar_r = _find_bar_row(g)
+    out = g.copy()
+    out[g == MOVING] = BG
+    for r, c in np.argwhere(g == MOVING):
+        nr = int(r) + 1
+        if nr >= h or nr == bar_r:
+            continue
