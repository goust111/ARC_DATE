+        "bottom_nontrigger": lambda p: p.edge == "bottom" and not p.trigger,
+        "left_nontrigger": lambda p: p.edge == "left" and not p.trigger,
+        "right_nontrigger": lambda p: p.edge == "right" and not p.trigger,
