  "path": "from each s, one straight ray along s.column to the nearer top/bottom grid edge and one straight ray along s.row to the nearer left/right grid edge",
  "trajectory": "paint every cell on both rays with s.color, including s",
  "transform": "keep all markers and combine the independently painted L shapes on the same canvas"
}
</annotation>
<generation_spec>
