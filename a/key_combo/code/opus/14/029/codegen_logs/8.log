+    h: int,
+    w: int,
+    bar_r: int,
+    start: tuple[int, int],
+    edge: str,
+) -> set[tuple[int, int]]:
+    cells = {start}
+    for dr, dc in SPLASH_TOWARD[edge]:
+        rr = start[0] + dr
+        cc = start[1] + dc
+        while 0 <= rr < h and 0 <= cc < w:
