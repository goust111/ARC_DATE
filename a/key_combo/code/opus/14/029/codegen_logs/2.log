    del g

    template_mask = (left == bg) & (middle == bg)
    assert np.any(template_mask), "derived template must be non-empty"

    out = np.full((n * n, n * n), bg, dtype=int)
    for r in range(n):
        for c in range(n):
            color = int(source[r, c])
            if color == bg:
                continue
            block = out[r * n : (r + 1) * n, c * n : (c + 1) * n]
            block[template_mask] = color
    return out


