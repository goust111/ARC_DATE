+    if len(set(source_colors)) != len(source_colors):
+        return False
+    if set(source_colors) & {bg, LEFT_COLOR, MIDDLE_COLOR, sep_color}:
+        return False
+    if any(abs(r1 - r2) + abs(c1 - c2) == 1 for (r1, c1), (r2, c2) in combinations(source_positions, 2)):
