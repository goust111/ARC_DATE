+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+LEFT_COLOR = 1
+SEPARATOR_COLOR = 2
+MIDDLE_COLOR = 3
+SOURCE_COLOR_POOL = (4, 6, 7, 8, 9)
+PANEL_SIZE = 5
+MAX_RETRIES = 500
+
