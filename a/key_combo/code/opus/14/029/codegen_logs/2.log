+def _is_connected(mask: np.ndarray) -> bool:
+    coords = _mask_coords(mask)
+    if not coords:
+        return False
+    shape = mask.shape
+    seen = {coords[0]}
+    queue = deque([coords[0]])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c, shape):
+            if not mask[nr, nc] or (nr, nc) in seen:
+                continue
+            seen.add((nr, nc))
+            queue.append((nr, nc))
