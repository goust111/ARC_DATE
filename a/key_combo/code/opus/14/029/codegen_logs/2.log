+    n = int(g.shape[0])
+    h, w = map(int, g.shape)
+    assert n >= 3 and w == 3 * n + 1, "expected n x (3n+1) layout: left | sep | middle | source"
+    assert n * n <= 30, "output must stay within ARC size limits"
