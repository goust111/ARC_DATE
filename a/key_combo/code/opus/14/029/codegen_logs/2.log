+    if shared is None:
+        return None
+
+    left_mask = _grow_connected_mask(left_size, shape=shape, seed_mask=shared)
+    if left_mask is None:
+        return None
+
+    left_only = left_mask & ~shared
+    middle_mask = _grow_connected_mask(
