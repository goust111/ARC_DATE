+
+def _assemble_input(left: np.ndarray, middle: np.ndarray, source: np.ndarray) -> np.ndarray:
+    return np.concatenate(
+        [left, np.full((PANEL_SIZE, 1), SEPARATOR_COLOR, dtype=int), middle, source],
+        axis=1,
+    )
