+            for nr, nc in _neighbors4(r, c, shape):
+                if mask[nr, nc] or blocked[nr, nc]:
+                    continue
+                frontier.add((nr, nc))
+        if not frontier:
+            return None
+        mask[random.choice(sorted(frontier))] = True
+
