+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+TILE_FG = 1
+INVERTED_BG = 2
+KEY_FG = 3
+SEP = 5
+
+TILE_SIZE = 4
+ROW_BANDS = 2
+COL_BANDS = 3
+ROW_SEPARATOR = 1
+COL_SEPARATOR = 1
+KEY_SEPARATOR = 2
+
+GRID_H = ROW_BANDS * TILE_SIZE + ROW_SEPARATOR
+GRID_W = COL_BANDS * TILE_SIZE + (COL_BANDS - 1) * COL_SEPARATOR + KEY_SEPARATOR + TILE_SIZE
+MAX_GENERATION_ATTEMPTS = 300
