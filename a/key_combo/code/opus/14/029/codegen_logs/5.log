+            idx += 1
+    return out
+
+
+def _render_case(
+    key_coords: frozenset[tuple[int, int]],
+    key_row_index: int,
+    tile_payloads: list[tuple[str | None, frozenset[tuple[int, int]]]],
+) -> tuple[np.ndarray, list[str | None]]:
+    grid = np.zeros((GRID_H, GRID_W), dtype=int)
+    grid[4, :] = SEP
+    for c in (4, 9, 14, 15):
+        grid[:, c] = SEP
