+    for dr in range(TILE_SIZE):
+        for dc in range(TILE_SIZE):
+            if dr == 0 and dc == 0:
+                continue
+            moved = _translate(key_coords, dr, dc)
+            if _fits_tile(moved):
+                shifts.append(moved)
