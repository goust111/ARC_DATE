+
+
+def _normalize(coords: frozenset[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    min_r = min(r for r, _ in coords)
+    min_c = min(c for _, c in coords)
+    return frozenset((r - min_r, c - min_c) for r, c in coords)
+
+
