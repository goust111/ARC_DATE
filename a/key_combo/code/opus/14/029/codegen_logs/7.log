+
+
+def _paint_canonical_from_tile(size: int, offsets: tuple[int, ...], tile: np.ndarray) -> np.ndarray:
+    out = np.full((2 * size, 2 * size), BG, dtype=int)
+    period = tile.shape[0]
+    for r in range(2 * size):
