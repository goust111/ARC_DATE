+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _canonicalize_band(band_grid: np.ndarray) -> tuple[np.ndarray, bool]:
+    coords = np.argwhere(band_grid != BG)
