+
+def _paint_band(
+    height: int,
+    width: int,
+    offsets: list[int],
+    period: int,
+    pattern: dict[tuple[int, int], int],
+) -> np.ndarray:
+    out = np.full((2 * height, 2 * width), BG, dtype=int)
+    for r in range(2 * height):
+        for off in offsets:
+            c = r + off
+            if 0 <= c < 2 * width:
+                color = int(pattern[(off, r % period)])
+                if color != BG:
+                    out[r, c] = color
+    return out
+
