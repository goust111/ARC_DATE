+                tile[r, 0] = random.choice(colors)
+                continue
+            row = [random.choice(colors), random.choice(colors)]
+            if use_gaps and random.random() < 0.7:
+                row[random.randrange(2)] = BG
+            if row[0] == BG and row[1] == BG:
+                row[random.randrange(2)] = random.choice(colors)
+            tile[r] = row
+
