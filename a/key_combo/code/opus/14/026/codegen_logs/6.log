+    out = g.copy()
+    opened: set[int] = set()
+    seen_segments: set[tuple[int, int, str, int]] = set()
+    pending: list[tuple[int, int, str, int]] = [(start_r, start_c, "h", RED)]
+
+    trace = {
+        "opened_order": [],
+        "hit_counts": {int(marker["id"]): 0 for marker in markers},
+        "hits": [],
+    }
