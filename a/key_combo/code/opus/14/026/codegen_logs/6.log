+            if marker is None:
+                continue
+            trace["hit_counts"][int(marker["id"])] += 1
+            trace["hits"].append(
+                {
+                    "from": (r, c, axis, color),
+                    "dir": (dr, dc),
+                    "marker_id": int(marker["id"]),
+                    "stop": stop,
+                }
+            )
+            if int(marker["id"]) in opened:
+                continue
+            opened.add(int(marker["id"]))
+            trace["opened_order"].append(int(marker["id"]))
