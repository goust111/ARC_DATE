+    dr, dc = direction
+    rr, cc = start
+    painted: list[tuple[int, int]] = []
+    while True:
+        nr, nc = rr + dr, cc + dc
+        if not _in_bounds(shape, nr, nc):
+            return None, None, painted
+        marker = _marker_at(markers, nr, nc)
+        if marker is not None:
