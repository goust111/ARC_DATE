+def _group_cells(group: dict) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for piece in group["pieces"]:
+        cells.update(piece["cells"])
+    return cells
+
+
+def _shift_group_up(group: dict, amount: int) -> dict:
+    return _group(
+        [
+            _piece(
+                _translate(piece["cells"], -amount, 0),
+                piece["input_color"],
+                piece["output_color"],
+            )
