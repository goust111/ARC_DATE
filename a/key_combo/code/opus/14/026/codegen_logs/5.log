+
+
+def _random_ground_shape(width_hint: int) -> list[tuple[int, int]]:
+    options = [
+        [(0, 0), (0, 1)],
+        [(0, 0), (0, 1), (0, 2)],
+        [(0, 0), (1, 0)],
