+        occupied: list[set[tuple[int, int]]] = []
+        ok = True
+        for idx in order:
+            group = groups[idx]
+            max_shift = min(r for r, _c in group_cells_cache[idx]) - 3
+            if max_shift < 1:
+                ok = False
