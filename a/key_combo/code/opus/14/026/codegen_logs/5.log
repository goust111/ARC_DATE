+
+
+def _groups_to_input(
+    h: int,
+    w: int,
+    groups: list[dict],
+    legends: list[tuple[int, int]],
+    corner: str,
+) -> np.ndarray | None:
+    shifted: list[dict] = []
+    attempts = 120
+    legend_occ = set()
+    for r, c in _legend_positions(h, w, corner, len(legends)):
+        legend_occ.add((r, c))
+        legend_occ.add((r, c + 1))
