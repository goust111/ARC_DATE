+        if marker_coords.shape[0] not in (2, 3):
+            return False
+        full_markers = _mirrored_marker_set(marker_coords, crop.shape[1])
+        orig_cols = {int(c) for _, c in marker_coords}
+        mirror_cols = {crop.shape[1] - 1 - int(c) for _, c in marker_coords}
