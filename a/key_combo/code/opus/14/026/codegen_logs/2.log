+    grid = np.zeros(grid_shape, dtype=int)
+    r0, c0, r1, c1 = rect_bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = BASE
+    for r, c in markers:
+        grid[r0 + r, c0 + c] = MARKER
+    return grid
+
