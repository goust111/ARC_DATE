def _gen_place_distractor_color(grid: np.ndarray, color: int, count: int) -> bool:
    remaining = count
    while remaining:
        use_domino = remaining >= 2 and random.random() < _GEN_DOMINO_PROBABILITY
        if use_domino:
            dominoes = _gen_domino_candidates(grid, color)
            if dominoes:
