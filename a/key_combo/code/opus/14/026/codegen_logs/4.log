+    order: list[int] = []
+    queue = deque(sorted(i for i in range(n) if indeg[i] == 0))
+    while queue:
+        cur = queue.popleft()
+        order.append(cur)
+        for nxt in children[cur]:
+            indeg[nxt] -= 1
+            if indeg[nxt] == 0:
+                queue.append(nxt)
+
+    if len(order) != n:
+        return None
+
+    for k in range(n):
+        for i in range(n):
+            if not reach[i, k]:
+                continue
+            for j in range(n):
+                if reach[k, j]:
+                    reach[i, j] = True
+    return order, reach
