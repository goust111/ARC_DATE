+def _topological_order(edges: set[tuple[int, int]], n: int) -> tuple[list[int], np.ndarray] | None:
+    reach = np.zeros((n, n), dtype=bool)
+    indeg = [0] * n
+    children = [[] for _ in range(n)]
+    for i, j in edges:
+        if reach[j, i]:
+            return None
+        children[i].append(j)
+        indeg[j] += 1
+        reach[i, j] = True
