+    if found != intended:
+        return False
+    if len({spec["hole_count"] for spec in specs}) != len(specs):
+        return False
+    if len({spec["fg_area"] for spec in specs}) != 1:
+        return False
+    if force_clip and not any(bool(spec["clipped"]) for spec in specs):
+        return False
+    if np.any(expected[:3, :3] != BG):
+        return False
