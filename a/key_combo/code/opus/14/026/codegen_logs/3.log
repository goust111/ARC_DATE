+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLOR = 1
+OBJECT_COLOR = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    """Count 4-connected enclosed background regions inside a foreground mask."""
+    padded_bg = np.pad(~mask.astype(bool), 1, constant_values=True)
+    h, w = padded_bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if padded_bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if padded_bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and padded_bg[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not padded_bg[r, c] or seen[r, c]:
+                continue
+            holes += 1
+            seen[r, c] = True
+            q.append((r, c))
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
