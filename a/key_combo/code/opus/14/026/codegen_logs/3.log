+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and padded_bg[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not padded_bg[r, c] or seen[r, c]:
