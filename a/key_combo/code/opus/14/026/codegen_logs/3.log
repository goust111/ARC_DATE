def _gen_marker_points(crop: np.ndarray, colors: list[int]) -> dict[int, tuple[int, int]]:
    points = {}
    for color in colors:
        locs = np.argwhere(crop == int(color))
        if len(locs) != 1:
            return {}
        points[int(color)] = (int(locs[0, 0]), int(locs[0, 1]))
    return points


