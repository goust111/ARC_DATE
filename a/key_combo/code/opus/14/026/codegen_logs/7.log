0020:                 rel.append((int(rr - r), int(cc - c)))
0021: 
0022:     assert len(rel) == 7
0023:     row_bias = sum(dr for dr, _dc in rel)
0024:     col_bias = sum(dc for _dr, dc in rel)
0025:     assert (row_bias == 0) != (col_bias == 0)
0026: 
0027:     if row_bias != 0:
0028:         assert abs(row_bias) == 3 and col_bias == 0
0029:         return (-1 if row_bias > 0 else 1, 0)
0030: 
0031:     assert abs(col_bias) == 3 and row_bias == 0
0032:     return (0, -1 if col_bias > 0 else 1)
