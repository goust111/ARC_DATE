0013: def main(input_grid):
0014:     """
0015:     Drop a yellow marker to the bottom row under each object's horizontal center.
0016: 
0017:     Input structure:
0018:     - The grid contains separated monochromatic objects on a black background.
0019:     - Each object has a bounding box with a well-defined center column.
0020:     - The bottom row is available for the dropped markers.
0021: 
0022:     Rule:
0023:     - Detect each foreground object.
0024:     - Compute the center column of its bounding box.
0025:     - Paint a yellow pixel in the last row at that center column.
0026: 
0027:     Key insight:
0028:     - Only the object's horizontal center matters; the marker falls all the way to the
0029:       canvas bottom rather than stopping at other objects.
0030:     """
0031:     # Plan:
0032:     # 1. Detect the objects
0033:     # 2. Drop yellow pixels which land in the final row of the grid, centered with the middle of the object
0034: 
0035:     bg = Color.BLACK
0036:     objects = find_components(input_grid, bg=bg, connectivity=4, monochromatic=True, return_format="objects")
0037: 
0038:     output_grid = input_grid.copy()
0039: 
0040:     for obj in objects:
0041:         b = bbox(obj != bg)
0042:         if b is None:
0043:             continue
0044:         _r, c = bbox_anchor(b, anchor="center")
0045:         bottom_r = output_grid.shape[0] - 1
0046:         output_grid[bottom_r, c] = Color.YELLOW
0047:     
0048:     return output_grid
0049: 
0050: 
