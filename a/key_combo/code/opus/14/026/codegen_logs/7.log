0144: def _sprite_cells(direction: tuple[int, int], r: int, c: int) -> set[tuple[int, int]]:
0145:     """Return the set of (row, col) occupied by the full sprite (body + marker)."""
0146:     return {(r, c)} | {(r + dr, c + dc) for dr, dc in BODY_REL[direction]}
