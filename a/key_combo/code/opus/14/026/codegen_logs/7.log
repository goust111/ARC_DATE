0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """Recolor each foreground object according to how many enclosed background regions it contains.
0024: 
0025:     Input structure
0026:     - A background canvas with one foreground color forming several 4-connected objects.
0027:     - Each object is a filled rectangular blob with one to four enclosed background holes.
0028: 
0029:     Rule
0030:     - Preserve the background.
0031:     - Count the 4-connected enclosed background components inside each object's bounding box.
0032:     - Recolor the whole object by the learned hole palette: one hole -> blue, two -> red, three -> green, four -> orange.
0033: 
0034:     Key insight
0035:     - The internal holes are the only varying symbol; object size and absolute position do not determine the output color.
0036:     """
0037:     g = np.asarray(grid, dtype=int)
0038:     bg = get_bg(g)
0039:     fg_colors = colors_present(g, exclude={bg})
0040:     assert len(fg_colors) == 1
0041:     src_color = fg_colors[0]
0042: 
0043:     components = find_components(
0044:         g,
0045:         bg=bg,
0046:         connectivity=4,
0047:         monochromatic=True,
0048:         colors=[src_color],
0049:     )
0050:     assert len(components) > 0
0051: 
0052:     out = np.full_like(g, bg)
0053:     for comp in components:
0054:         assert comp["color"] == src_color
0055:         obj_mask = crop_bbox(g == src_color, comp["bbox"])
0056:         holes = _hole_count(obj_mask)
0057:         assert holes in HOLE_COLOR
0058:         rr, cc = comp["coords"].T
0059:         out[rr, cc] = HOLE_COLOR[holes]
0060: 
0061:     return out
0062: 
