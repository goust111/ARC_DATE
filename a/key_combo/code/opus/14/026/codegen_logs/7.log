0132:         dims = []
0133:         min_height, max_height = _GEN_OBJECT_HEIGHT_RANGE
0134:         min_width, max_width = _GEN_OBJECT_WIDTH_RANGE
0135:         for height in range(min_height, max_height + 1):
0136:             for width in range(min_width, max_width + 1):
0137:                 options = _gen_hole_options(height, width)
0138:                 if _gen_search_holes(options, n_holes, (), shuffled=False) is not None:
0139:                     dims.append((height, width))
0140:         cache[n_holes] = dims
0141:         _gen_feasible_dims._cache = cache
0142:     return cache[n_holes]
