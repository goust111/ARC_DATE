0017: def main(input_grid):
0018:     """
0019:     Scale the whole grid by its number of non-black colors and draw red diagonals from the enlarged square's corners.
0020: 
0021:     Input structure:
0022:     - The grid has non-black color runs on the bottom row and right column.
0023:     - A separate non-black square sits away from those border runs.
0024:     - The number of distinct non-black colors determines the scale factor.
0025: 
0026:     Rule:
0027:     - Count distinct non-black colors and magnify every input pixel by that factor.
0028:     - Find the enlarged square component in the scaled output.
0029:     - Draw red diagonal rays outward from the four corners until they meet non-black cells or the edge.
0030: 
0031:     Key insight:
0032:     - Border colors encode the numeric scale, while the isolated square anchors the added
0033:       diagonal construction after scaling.
0034:     """
0035:     # count the number of colors that aren't black
0036:     num_colors = len(set(map(int, np.unique(input_grid))) - {Color.BLACK})
0037:     if num_colors <= 0:
0038:         return np.copy(input_grid)
0039: 
0040:     # magnify the pixels in input grid onto the output grid
0041:     output_grid = np.repeat(np.repeat(input_grid, num_colors, axis=0), num_colors, axis=1)
0042: 
0043:     # find the square in the output grid
0044:     objects = find_components(output_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
0045:     square = next(obj for obj in objects if int(obj[-1, -1]) == Color.BLACK)
0046:     
0047:     # find the bounding box of the square
0048:     b = bbox(square != Color.BLACK)
0049:     assert b is not None
0050:     r0, c0, r1, c1 = b
0051: 
0052:     # draw the diagonal red lines
0053:     stop_at = set(Color.NOT_BLACK)
0054:     L = max(output_grid.shape) * 3
0055:     draw_line(output_grid, r0 - 1, c0 - 1, length=L, color=Color.RED, direction=(-1, -1), stop_at=stop_at, clip=True)
0056:     draw_line(output_grid, r1 + 1, c1 + 1, length=L, color=Color.RED, direction=(1, 1), stop_at=stop_at, clip=True)
0057:     draw_line(output_grid, r0 - 1, c1 + 1, length=L, color=Color.RED, direction=(-1, 1), stop_at=stop_at, clip=True)
0058:     draw_line(output_grid, r1 + 1, c0 - 1, length=L, color=Color.RED, direction=(1, -1), stop_at=stop_at, clip=True)
0059: 
0060:     return output_grid
0061: 
0062: def generate_input():
0063:     # make a 5x5 black grid for the background
0064:     n = m = 5
0065:     grid = np.zeros((n,m), dtype=int)
0066: 
0067:     # pick the colors for the bottom and right of the grid
0068:     colors = list(Color.NOT_BLACK)
0069: 
0070:     # construct a random sequence of colors for the bottom and right of the grid
0071:     # don't repeat a color in the sequence
0072:     sequence = []
0073:     while len(sequence) < 5:
0074:         # select a color
0075:         color = np.random.choice(colors)
0076:         # remove the color from the array of remaining colors
0077:         colors = np.delete(colors, np.where(colors == color))
0078:         length = np.random.randint(1, 6 - len(sequence))
0079:         sequence.extend([color] * length)
0080: 
0081:     # put the same sequence on the bottom and right of the grid
0082:     grid[-1, :] = sequence
0083:     grid[:, -1] = sequence
0084: 
0085:     # pick the color of the square
0086:     square_color = np.random.choice(list(Color.NOT_BLACK))
0087:     
0088:     # make the square
0089:     square_sprite = random_sprite(2, 2, density=1, color_palette=[square_color])
0090: 
0091:     # put the square on the grid so it doesn't touch the bottom or right
0092:     _loc = first_free_location(grid, square_sprite, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
