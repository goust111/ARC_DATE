0035: def main(grid: np.ndarray) -> np.ndarray:
0036:     """
0037:     Extend each colored marker from its directional sprite to a grid edge, painting a dotted ray and the whole edge side.
0038: 
0039:     Input structure:
0040:     - The background is the dominant color.
0041:     - One repeated body color forms small 8-connected directional sprites.
0042:     - Each marker is a singleton non-background, non-body color embedded in one sprite.
0043: 
0044:     Rule:
0045:     - The body pixels around a marker lie mostly behind it; the opposite direction is the marker's ray direction.
0046:     - Paint every second pixel from the marker along that ray, then paint the entire boundary side reached by the ray.
0047:     - If two painted boundary sides meet at a corner, make that shared corner black.
0048: 
0049:     Key insight:
0050:     - The same seven-pixel body sprite rotates to encode the direction; its local center-of-mass bias points away from the ray.
0051:     """
0052:     g = np.asarray(grid, dtype=int)
0053:     H, W = g.shape
0054:     bg = int(get_bg(g))
0055:     counts = Counter(map(int, g.ravel()))
0056: 
0057:     body_candidates = [color for color, count in counts.items() if int(color) != bg and int(count) > 1]
0058:     assert len(body_candidates) == 1
0059:     body_color = int(body_candidates[0])
0060: 
0061:     markers: list[tuple[int, int, int]] = []
0062:     for color, count in counts.items():
0063:         color = int(color)
0064:         if color == bg or color == body_color:
0065:             continue
0066:         assert int(count) == 1
0067:         coords = np.argwhere(g == color)
0068:         assert coords.shape == (1, 2)
0069:         r, c = map(int, coords[0])
0070:         markers.append((color, r, c))
0071: 
0072:     assert markers
0073:     out = g.copy()
0074:     directions: dict[tuple[int, int], int] = {}
0075: 
0076:     for color, r, c in markers:
0077:         direction = _marker_direction(g, body_color, r, c)
0078:         assert direction in VALID_DIRECTIONS
0079:         assert direction not in directions
0080:         directions[direction] = int(color)
0081: 
0082:         dr, dc = direction
0083:         rr, cc = int(r + 2 * dr), int(c + 2 * dc)
0084:         while 0 <= rr < H and 0 <= cc < W:
0085:             assert int(g[rr, cc]) == bg
0086:             out[rr, cc] = int(color)
0087:             rr += int(2 * dr)
0088:             cc += int(2 * dc)
0089: 
0090:         if direction == (-1, 0):
0091:             assert np.all(g[0, :] == bg)
0092:             out[0, :] = int(color)
0093:         elif direction == (1, 0):
0094:             assert np.all(g[H - 1, :] == bg)
0095:             out[H - 1, :] = int(color)
0096:         elif direction == (0, -1):
0097:             assert np.all(g[:, 0] == bg)
0098:             out[:, 0] = int(color)
0099:         elif direction == (0, 1):
0100:             assert np.all(g[:, W - 1] == bg)
0101:             out[:, W - 1] = int(color)
0102: 
0103:     if (-1, 0) in directions and (0, -1) in directions:
0104:         out[0, 0] = 0
0105:     if (-1, 0) in directions and (0, 1) in directions:
0106:         out[0, W - 1] = 0
0107:     if (1, 0) in directions and (0, -1) in directions:
0108:         out[H - 1, 0] = 0
0109:     if (1, 0) in directions and (0, 1) in directions:
0110:         out[H - 1, W - 1] = 0
0111: 
0112:     return out
0113: 
