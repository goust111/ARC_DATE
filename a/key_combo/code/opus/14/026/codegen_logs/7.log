0149: def _ray_cells(H: int, W: int, r: int, c: int, direction: tuple[int, int]) -> set[tuple[int, int]]:
0150:     """Return every cell from the marker outward along *direction* to the grid edge."""
0151:     dr, dc = direction
0152:     cells = set()
0153:     rr, cc = r + dr, c + dc
0154:     while 0 <= rr < H and 0 <= cc < W:
0155:         cells.add((rr, cc))
0156:         rr += dr
0157:         cc += dc
0158:     return cells
0159: 
0160: 
0161: def _center_ranges(H: int, W: int, direction: tuple[int, int]) -> tuple[range, range]:
0162:     """Valid marker-center row/col ranges ensuring EDGE_GAP from all grid edges."""
0163:     min_r, max_r, min_c, max_c = _SPRITE_EXTENT[direction]
0164:     return (range(EDGE_GAP - min_r, H - EDGE_GAP - max_r),
0165:             range(EDGE_GAP - min_c, W - EDGE_GAP - max_c))
0166: 
0167: 
0168: def _choose_center(
0169:     H: int, W: int, direction: tuple[int, int],
0170:     occupied: set[tuple[int, int]], reserved_rays: set[tuple[int, int]],
0171: ) -> tuple[int, int] | None:
0172:     """Pick a random valid marker center that avoids *occupied* and *reserved_rays*."""
0173:     candidates: list[tuple[int, int]] = []
0174:     rows, cols = _center_ranges(H, W, direction)
