+        if not interior:
+            raise ValueError("cup interior is empty")
+        cups.append(
+            {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "opening": opening,
+                "direction": _direction_from_opening(opening),
+                "opening_cells": _opening_cells((r0, c0, r1, c1), opening),
