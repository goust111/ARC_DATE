+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+    if opening == "top":
+        grid[r0, c0 : c1 + 1] = BG
+    elif opening == "bottom":
+        grid[r1, c0 : c1 + 1] = BG
+    elif opening == "left":
+        grid[r0 : r1 + 1, c0] = BG
+    elif opening == "right":
