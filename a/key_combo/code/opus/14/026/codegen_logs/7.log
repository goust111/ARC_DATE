0160: def _gen_apply_available_openings(grid, available, remaining, opened, next_axis, depth):
0161:     new_segments = []
0162:     added = 0
0163:     if remaining <= 0 or not available:
0164:         return new_segments, added
0165: 
0166:     max_add = min(remaining, len(available))
0167:     add_count = 1
0168:     if max_add >= 2 and random.random() < _GEN_BRANCH_TWO_PROB:
0169:         add_count = 2
0170:     selected = set(random.sample([x[0] for x in available], add_count))
0171: 
0172:     for dir_i, dr, dc, candidates in available:
0173:         if dir_i not in selected:
0174:             continue
0175:         mr, mc, prev_r, prev_c, valid_colors = random.choice(candidates)
0176:         grid[mr, mc] = random.choice(valid_colors)
0177:         opened.add((mr, mc))
0178:         added += 1
0179:         new_segments.append((prev_r, prev_c, next_axis, depth + 1))
0180:     return new_segments, added
