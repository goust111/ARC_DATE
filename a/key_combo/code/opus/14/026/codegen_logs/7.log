0001: from __future__ import annotations
0002: from collections import Counter, defaultdict
0003: import numpy as np
0004: from arc_utils import get_bg, in_bounds, neighbors4, label_mask
0005: 
0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Connect framed squares via colored bridges following a control-pixel sequence.
0009: 
0010:     Input structure:
0011:     - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.
0012:     - Control row below squares: colored pixels read left-to-right encode visitation order.
0013: 
0014:     Rule:
0015:     - Start at the square matching first control color c0.
0016:     - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.
0017:     - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.
0018: 
0019:     Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.
0020:     """
0021:     g = np.array(grid, dtype=int)
0022:     H, W = g.shape
0023:     bg = int(get_bg(g))
0024: 
0025:     # border color = most common non-bg color
0026:     cnt = Counter(map(int, g.flatten()))
0027:     border = None
0028:     for col, _k in cnt.most_common():
0029:         if int(col) != int(bg):
