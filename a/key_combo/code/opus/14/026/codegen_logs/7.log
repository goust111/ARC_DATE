+        if len(missing) != 1:
+            raise ValueError("expected exactly one missing side")
+        opening = missing[0]
+        interior = [
+            (r, c)
+            for r in range(r0 + 1, r1)
+            for c in range(c0 + 1, c1)
+            if int(grid[r, c]) == BG
+        ]
+        if not interior:
+            raise ValueError("cup interior is empty")
