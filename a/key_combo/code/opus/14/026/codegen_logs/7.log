+def _project_from_opening(
+    blockers: np.ndarray,
+    opening_cells: list[tuple[int, int]],
+    direction: tuple[int, int],
+) -> set[tuple[int, int]]:
+    h, w = blockers.shape
+    dr, dc = direction
+    cells: set[tuple[int, int]] = set()
+    for r, c in opening_cells:
+        rr = r
+        cc = c
+        while 0 <= rr < h and 0 <= cc < w and int(blockers[rr, cc]) == BG:
+            cells.add((rr, cc))
+            rr += dr
+            cc += dc
