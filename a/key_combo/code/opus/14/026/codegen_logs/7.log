0493: def _gen_layout():
0494:     """Choose lattice line counts and dimensions compatible with gap bounds."""
0495:     n_v, n_h = _gen_random_choice(LAYOUT_LINE_COMBOS)
0496:     valid_h = [
0497:         h
0498:         for h in range(GRID_H_MIN, GRID_H_MAX + 1)
0499:         if CUT_GAP_MIN * (n_h + 1) <= h - 1 <= CUT_GAP_MAX * (n_h + 1)
0500:     ]
0501:     valid_w = [
0502:         w
0503:         for w in range(GRID_W_MIN, GRID_W_MAX + 1)
0504:         if CUT_GAP_MIN * (n_v + 1) <= w - 1 <= CUT_GAP_MAX * (n_v + 1)
0505:     ]
0506:     if not valid_h or not valid_w:
0507:         return None
0508:     h = _gen_random_choice(valid_h)
0509:     w = _gen_random_choice(valid_w)
0510:     return h, w, n_v, n_h
0511: 
