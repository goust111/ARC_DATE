0470: 
0471:     expected = g.copy()
0472:     blocked = set()
0473:     order = sorted(range(n_regions), key=lambda i: len(candidates[i]) / dot_counts[i])
0474:     for idx in order:
0475:         np.random.shuffle(candidates[idx])
0476:         placed = 0
0477:         while placed < dot_counts[idx]:
0478:             avail = [p for p in candidates[idx] if p not in blocked]
0479:             if not avail:
0480:                 return None
0481:             pos = avail[int(np.random.randint(len(avail)))]
0482:             r, c = pos
0483:             g[r, c] = Color.BLUE
0484:             expected[r, c] = majorities[idx]
0485:             blocked.add(pos)
0486:             for nr, nc in neighbors4(r, c):
0487:                 if in_bounds(g.shape, nr, nc):
0488:                     blocked.add((nr, nc))
0489:             placed += 1
0490:     return expected
0491: 
