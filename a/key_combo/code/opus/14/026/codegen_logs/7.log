+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+INPUT_COLORS = (RED, GREEN, ORANGE, MAROON)
+COUNT_TO_FILL = {0: BLUE, 1: RED, 2: YELLOW, 3: PINK}
+GEN_RETRIES = 400
