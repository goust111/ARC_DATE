0015: def main(input_grid):
0016:     """
0017:     Fill the inside of a cup and extend teal outward through its opening.
0018: 
0019:     Input structure:
0020:     - The grid contains one non-black cup-shaped object on a black background.
0021:     - The cup is an almost closed rectangular outline with one boundary opening.
0022:     - Black cells inside the cup and at the opening define the fill and exit path.
0023: 
0024:     Rule:
0025:     - Find the cup's bounding box and mark the black cells inside it.
0026:     - Fill those interior cells with teal.
0027:     - Detect the opening side and draw teal straight outward from every opening cell.
0028: 
0029:     Key insight:
0030:     - The only boundary gap identifies both the cup interior and the direction for the
0031:       emitted teal line.
0032:     """
0033:     # Plan:
0034:     # 1. Detect the cup
0035:     # 2. Find the mask of the inside of the cup
0036:     # 3. Find the mask of the opening of the cup (on one of its sides)
0037:     # 4. Fill the cup with teal
0038:     # 5. Shoot pixels outward from the opening (straight out)
0039:     
0040:     # 1. Detect cup
0041:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0042:     assert len(objects) == 1, "There should be exactly one cup"
0043:     obj = list(objects)[0]
0044: 
0045:     output_grid = input_grid.copy()
0046: 
0047:     # 2. Extract what's inside the cup (as its own object), which is everything in the bounding box that is not the object itself
0048:     _b = bbox(obj != Color.BLACK)
0049:     assert _b is not None
0050:     cup_r0, cup_c0, cup_r1, cup_c1 = _b
0051:     inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
0052:     inside_cup_mask[cup_r0 : cup_r1 + 1, cup_c0 : cup_c1 + 1] = True
0053:     inside_cup_mask = inside_cup_mask & (obj == Color.BLACK)
0054: 
0055:     # 3. Extract the hole in the cup, which is what's inside and on the boundary of the bounding box
0056:     # what's inside...
0057:     hole_mask = inside_cup_mask.copy()
0058:     # ...and then we need to remove anything not on the boundary
0059:     hole_mask[cup_r0 + 1 : cup_r1, cup_c0 + 1 : cup_c1] = False
0060: 
0061:     # 4. Fill the cup with teal
0062:     output_grid[inside_cup_mask] = Color.TEAL
0063: 
0064:     # 5. Shoot pixels outward from the opening (straight out)
0065:     # Find the direction of the opening, which is the unit vector that points away from the interior
0066:     hole_bbox = bbox(hole_mask)
0067:     assert hole_bbox is not None
0068:     hole_r, hole_c = bbox_anchor(hole_bbox, anchor="center")
0069: 
0070:     direction: tuple[int, int] | None = None
0071:     for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
0072:         rr = hole_r - dr
0073:         cc = hole_c - dc
0074:         if 0 <= rr < input_grid.shape[0] and 0 <= cc < input_grid.shape[1] and inside_cup_mask[rr, cc]:
0075:             direction = (dr, dc)
0076:             break
0077:     assert direction is not None
0078:     # Loop over every boundary pixel and shoot outward
0079:     for r, c in np.argwhere(hole_mask):
0080:         draw_line(output_grid, int(r), int(c), direction=direction, color=Color.TEAL)
0081:     return output_grid
0082: 
0083: def generate_input():
0084:     # Generate the grid with random size
0085:     width = np.random.randint(12, 30)
0086:     height = np.random.randint(12, 30)
0087:     grid = np.full((width, height), Color.BLACK)
0088: 
0089:     # Pick a random width/height for this cup
0090:     cup_width = np.random.randint(4, 8)
0091:     cup_height = np.random.randint(3, 8)
0092: 
0093:     # Make a sprite, which is just going to be a grey outline of a rectangle with a hole on one of its sides
0094:     sprite = np.full((cup_width, cup_height), Color.BLACK)
0095:     color = random.choice([ color for color in Color.NOT_BLACK if color != Color.TEAL ])
0096:     sprite[0, :] = color
0097:     sprite[-1, :] = color
0098:     sprite[:, 0] = color
0099:     sprite[:, -1] = color
0100: 
0101:     # Make the hole randomly somewhere on the edges (but not in the corners)
0102:     edges_but_not_corners = [ (0, c) for c in range(1, cup_height-1) ] + [ (cup_width-1, c) for c in range(1, cup_height-1) ] + [ (r, 0) for r in range(1, cup_width-1) ] + [ (r, cup_height-1) for r in range(1, cup_width-1) ]
0103:     hole_r, hole_c = random.choice(edges_but_not_corners)
0104:     sprite[hole_r, hole_c] = Color.BLACK
0105: 
0106:     # Find a random free location for it
0107:     free_r, free_c = random_free_location(grid, sprite, transparent=Color.BLACK, border=1, padding=1, padding_connectivity=8)
0108:     paste(grid, sprite, free_r, free_c, transparent=Color.BLACK, clip=True)
0109: 
0110:     return grid    
