0063:             r, c = random_free_location(grid, sprite, transparent=Color.BLACK, border=2, padding=2, padding_connectivity=8)
0064:         except ValueError:
0065:             break
0066:         # Put it down
0067:         paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
0068: 
