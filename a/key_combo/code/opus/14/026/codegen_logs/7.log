0127: def _gen_first_blocker(grid, r, c, dr, dc):
0128:     H, W = grid.shape
0129:     prev_r, prev_c = r, c
0130:     rr, cc = r + dr, c + dc
0131:     while 0 <= rr < H and 0 <= cc < W:
0132:         if grid[rr, cc] not in (_GEN_BLACK, _GEN_RED):
0133:             return int(rr), int(cc), int(prev_r), int(prev_c)
0134:         prev_r, prev_c = rr, cc
0135:         rr += dr
0136:         cc += dc
0137:     return None
