+def _paint_specs(specs: list[dict]) -> np.ndarray:
+    max_r = max(int(spec["r0"]) + int(spec["h"]) for spec in specs)
+    max_c = max(int(spec["c0"]) + int(spec["w"]) for spec in specs)
+    grid = np.zeros((max_r + 1, max_c + 1), dtype=int)
