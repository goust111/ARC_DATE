+def _stamp_cup(grid: np.ndarray, spec: dict) -> None:
+    r0 = int(spec["r0"])
+    c0 = int(spec["c0"])
+    h = int(spec["h"])
+    w = int(spec["w"])
+    color = int(spec["color"])
+    opening = str(spec["opening"])
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
