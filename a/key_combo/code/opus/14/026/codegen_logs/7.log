+    b = {"r0": a["r0"] + ha + row_gap1, "c0": left_margin, "h": hb, "w": wb, "opening": "right"}
+    c = {"r0": b["r0"] + hb + row_gap2, "c0": a["c0"] + wa + col_gap2, "h": hc, "w": wc, "opening": "top"}
