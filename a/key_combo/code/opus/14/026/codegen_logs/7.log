0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Extend the red start pixel into a recursive rectilinear ray network that turns at colored marker pixels.
0012: 
0013:     Input structure
0014:     - The canvas has black background, one red start pixel on the left edge, and isolated colored marker pixels.
0015:     - Original non-red, non-background marker pixels are blockers and are preserved.
0016:     - Marker colors are green, pink, orange, and teal; orange markers on the lower border are terminal when hit from above.
0017: 
0018:     Rule
0019:     - Start with a horizontal red ray from the red edge pixel.
0020:     - A ray paints background cells red until it reaches the first original marker in each direction of its row or column.
0021:     - The first time a marker opens, emit the perpendicular row or column from the red cell immediately before that marker; later hits on the same marker only stop the ray.
0022:     - Process emitted rows/columns depth-first, with right/down emissions taking priority over left/up emissions when both are discovered together.
0023:     - If a downward vertical ray reaches an orange marker on the lower border, stop there without opening a new horizontal ray.
0024: 
0025:     Key insight
0026:     - The output is not a global fill: it is the depth-first closure of marker-triggered perpendicular ray turns, with marker pixels acting as one-time controls.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     bg = get_bg(g)
0030:     assert bg == Color.BLACK, "expected black background"
0031: 
0032:     starts = np.argwhere(g == Color.RED)
0033:     assert len(starts) == 1, "expected exactly one red start pixel"
0034:     start_r, start_c = map(int, starts[0])
0035:     assert start_c == 0, "red start pixel must be on the left edge"
0036: 
0037:     marker_mask = (g != bg) & (g != Color.RED)
0038:     assert np.any(marker_mask), "expected colored marker pixels"
0039:     marker_colors = set(map(int, np.unique(g[marker_mask])))
0040:     assert marker_colors <= {Color.GREEN, Color.PINK, Color.ORANGE, Color.TEAL}
0041: 
0042:     H, W = g.shape
0043:     out = g.copy()
0044:     blockers = marker_mask
0045:     pending: list[tuple[int, int, str]] = [(start_r, start_c, "h")]
0046:     seen_segments: set[tuple[int, int, str]] = set()
0047:     opened_markers: set[tuple[int, int]] = set()
0048: 
0049:     while pending:
0050:         r, c, axis = pending.pop()
0051:         segment_key = (r, c, axis)
0052:         if segment_key in seen_segments:
0053:             continue
0054:         seen_segments.add(segment_key)
0055:         out[r, c] = Color.RED
0056: 
0057:         if axis == "h":
0058:             directions = [(0, -1), (0, 1)]
0059:             next_axis = "v"
0060:         else:
0061:             directions = [(-1, 0), (1, 0)]
0062:             next_axis = "h"
0063: 
0064:         new_segments: list[tuple[int, int, str]] = []
0065:         for dr, dc in directions:
0066:             prev_r, prev_c = r, c
0067:             rr, cc = r + dr, c + dc
0068:             while 0 <= rr < H and 0 <= cc < W:
0069:                 if blockers[rr, cc]:
0070:                     marker = (int(rr), int(cc))
0071:                     terminal_orange = (
0072:                         axis == "v"
0073:                         and dr == 1
0074:                         and rr == H - 1
0075:                         and int(g[rr, cc]) == Color.ORANGE
0076:                     )
0077:                     if marker not in opened_markers and not terminal_orange:
0078:                         opened_markers.add(marker)
0079:                         new_segments.append((prev_r, prev_c, next_axis))
0080:                     break
0081: 
0082:                 out[rr, cc] = Color.RED
0083:                 prev_r, prev_c = rr, cc
0084:                 rr += dr
0085:                 cc += dc
0086: 
0087:         pending.extend(new_segments)
0088: 
0089:     return out
0090: 
0091: # --------------- generator (o5x) ---------------
0092: 
0093: # Colors and marker palette.
0094: _GEN_BLACK, _GEN_RED, _GEN_ORANGE, _GEN_MARKER_COLORS = 0, 2, 7, (3, 6, 7, 8)
0095: 
0096: # Canvas and start placement bounds.
0097: _GEN_HEIGHT_RANGE, _GEN_WIDTH_RANGE = (4, 12), (6, 12)
0098: _GEN_START_ROW_LO_DIVISOR, _GEN_START_ROW_HI_DIVISOR, _GEN_START_ROW_HI_OFFSET = 5, 2, 1
