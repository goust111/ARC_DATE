0140: def _gen_opening_candidates(grid, r, c, axis, dr, dc, color_pool):
0141:     H, W = grid.shape
0142:     ans = []
0143:     rr, cc = r + dr, c + dc
0144:     dist = 1
0145:     while 0 <= rr < H and 0 <= cc < W:
0146:         if grid[rr, cc] not in (_GEN_BLACK, _GEN_RED):
0147:             break
0148:         if dist >= _GEN_MIN_OPENING_DIST and grid[rr, cc] == _GEN_BLACK:
0149:             valid_colors = list(color_pool)
0150:             if axis == "v" and dr == 1 and rr == H - 1:
0151:                 valid_colors = [x for x in valid_colors if x != _GEN_ORANGE]
0152:             if valid_colors:
0153:                 ans.append((int(rr), int(cc), int(rr - dr), int(cc - dc), valid_colors))
0154:         rr += dr
0155:         cc += dc
0156:         dist += 1
0157:     return ans
