0171: def _gen_build_object_specs(hole_counts: list[int], fg: int, remaining_fg_budget: int) -> list[tuple[np.ndarray, int]] | None:
0172:     """Build all objects while reserving enough foreground budget for later ones."""
0173:     specs = []
