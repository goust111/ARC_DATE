0116: # ── CFG ──────────────────────────────────────────────────────────────────
0117: H_RANGE = (11, 15)         # grid height bounds (inclusive)
0118: W_RANGE = (12, 17)         # grid width bounds (inclusive)
0119: MARKER_COUNT_RANGE = (1, 3)  # number of marker sprites per grid
0120: EDGE_GAP = 1               # min cells between sprite bbox and grid edge
0121: GEN_RETRIES = 300           # max attempts before raising RuntimeError
0122: 
0123: # ── Sprite geometry ──────────────────────────────────────────────────────
0124: DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
0125: 
0126: # 7 body-pixel offsets relative to the marker center, keyed by ray direction.
0127: BODY_REL = {
0128:     (-1, 0): [(0, -2), (0, -1), (0, 1), (0, 2), (1, -1), (1, 0), (1, 1)],
0129:     (1, 0): [(-1, -1), (-1, 0), (-1, 1), (0, -2), (0, -1), (0, 1), (0, 2)],
0130:     (0, -1): [(-2, 0), (-1, 0), (-1, 1), (0, 1), (1, 0), (1, 1), (2, 0)],
0131:     (0, 1): [(-2, 0), (-1, -1), (-1, 0), (0, -1), (1, -1), (1, 0), (2, 0)],
0132: }
0133: 
0134: # Pre-computed sprite bbox extents (min_r, max_r, min_c, max_c) per direction.
0135: _SPRITE_EXTENT: dict[tuple[int, int], tuple[int, int, int, int]] = {}
0136: for _d, _rels in BODY_REL.items():
0137:     _all = _rels + [(0, 0)]
0138:     _SPRITE_EXTENT[_d] = (
0139:         min(dr for dr, _ in _all), max(dr for dr, _ in _all),
0140:         min(dc for _, dc in _all), max(dc for _, dc in _all),
0141:     )
