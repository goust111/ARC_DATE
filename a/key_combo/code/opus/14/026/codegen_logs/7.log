0109:     used: tuple[tuple[int, int], ...],
0110:     *,
0111:     shuffled: bool,
0112: ) -> list[tuple[tuple[int, int], ...]] | None:
0113:     if remaining == 0:
0114:         return []
0115: 
0116:     pool = options[:]
0117:     if shuffled:
0118:         random.shuffle(pool)
0119: 
0120:     for cells in pool:
0121:         if not _gen_separated(cells, used):
0122:             continue
0123:         tail = _gen_search_holes(options, remaining - 1, used + cells, shuffled=shuffled)
0124:         if tail is not None:
0125:             return [cells] + tail
0126:     return None
0127: 
