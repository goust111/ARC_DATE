+def _ray_cells(shape: tuple[int, int], origin: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = origin
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    rr, cc = r + dr, c + dc
+    while 0 <= rr < h and 0 <= cc < w:
