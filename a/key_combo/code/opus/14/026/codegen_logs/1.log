+        "origin": (top + 1, left + 1),
+        "direction": direction,
+        "color": color,
+    }
+    for rr in range(3):
+        for cc in range(3):
+            r = top + rr
+            c = left + cc
+            if (rr, cc) == (1, 1):
+                grid[r, c] = color
+            elif (rr, cc) == (gap_r, gap_c):
+                grid[r, c] = BACKGROUND
+            else:
