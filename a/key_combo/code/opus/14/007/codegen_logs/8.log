+    candidates = []
+    for r in range(rows):
+        for c in range(cols):
+            if not _outside_of_all_frames(r, c, frames):
+                continue
+            if _min_wall_distance(r, c, wall_cells) < 3:
+                continue
+            candidates.append((r, c))
+    return candidates
+
+
+def _choose_outside_anchors(
+    grid_frames: np.ndarray,
+    frames: list[tuple[int, int, int, int]],
