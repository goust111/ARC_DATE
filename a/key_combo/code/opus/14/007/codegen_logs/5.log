import itertools, math
import numpy as np

# motif cells relative to center
cells=[]
for dr,dc in [(0,0),(0,1),(0,-1),(1,0),(-1,0),(0,2),(0,-2),(2,0),(-2,0),(1,1),(1,-1),(-1,1),(-1,-1)]:
    cells.append((dr,dc))

def analyze(centers, H=25, W=25):
    g=np.zeros((H,W),dtype=int)
    owner=-np.ones((H,W),dtype=int)
    for i,(r,c) in enumerate(centers):
        for dr,dc in cells:
            rr,cc=r+dr,c+dc
            if not (0<=rr<H and 0<=cc<W):
                return None
            if g[rr,cc]:
                return None
            g[rr,cc]=1
            owner[rr,cc]=i
    # black comps
    seen=np.zeros_like(g,bool)
    regs=[]
    for r in range(H):
      for c in range(W):
        if g[r,c] or seen[r,c]:
          continue
        st=[(r,c)]; seen[r,c]=1; pts=[]; touch=False
        while st:
          rr,cc=st.pop(); pts.append((rr,cc))
          if rr in (0,H-1) or cc in (0,W-1): touch=True
          for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=rr+dr,cc+dc
            if 0<=nr<H and 0<=nc<W and not g[nr,nc] and not seen[nr,nc]:
              seen[nr,nc]=1; st.append((nr,nc))
        if not touch:
          adj=set()
          for rr,cc in pts:
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
              nr,nc=rr+dr,cc+dc
              if 0<=nr<H and 0<=nc<W and g[nr,nc]: adj.add(owner[nr,nc])
          regs.append((len(pts),tuple(sorted(adj)),pts))
    return regs

# search among hand-picked lattice
origin=(12,12)
# candidate around origin within 8
cand=[(12,12),(12,18),(18,12),(18,18),(12,6),(6,12),(18,6),(6,18),(6,6),(9,15),(15,9),(9,9),(15,15),(12,24),(24,12)]
for k in [4,5]:
  found=0
  for centers in itertools.combinations(cand,k):
    regs=analyze(centers)
    if not regs or len(regs)<2: continue
    ks=sorted({len(a) for _,a,_ in regs})
    if {x%2 for x in ks}=={0,1}:
      print('k',k,'centers',centers,'regions',[(sz,len(adj),adj) for sz,adj,_ in regs][:5])
      found+=1
      if found>=20: raise SystemExit
print('done')
