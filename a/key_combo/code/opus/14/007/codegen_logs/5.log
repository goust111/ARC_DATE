+    cr, cc = center
+    this_cells = {(cr + dr, cc + dc) for dr, dc in _MOTIF_DELTAS}
+    for orow, ocol in others:
+        other_cells = {(orow + dr, ocol + dc) for dr, dc in _MOTIF_DELTAS}
+        if this_cells & other_cells:
