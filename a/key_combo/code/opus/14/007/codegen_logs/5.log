          ctr=(sum(p[0] for p in pts)/len(pts), sum(p[1] for p in pts)/len(pts))
          ds=sorted(((cr-ctr[0])**2+(cc-ctr[1])**2, i) for i,(cr,cc) in enumerate(centers))
          unique=ds[0][0] < ds[1][0]-1e-9
          for rr,cc in pts:
