              nr,nc=rr+dr,cc+dc
              if g[nr,nc]: adj.add(own[nr,nc])
          regs.append((len(pts),len(adj),unique,ctr,ds[:2],pts))
    return regs,g

def score(centers):
    res=analyze(centers)
    if res is None: return -10**9,None
    regs,g=res
    s=0
    if len(regs)>=2: s+=200
    s+=30*len(regs)
    par={k%2 for _,k,_,_,_,_ in regs}
    if par=={0,1}: s+=300
    s+=sum(sz for sz,_,_,_,_,_ in regs)
    s+=20*max([sz for sz,_,_,_,_,_ in regs] or [0])
    s-=400*sum(not u for _,_,u,_,_,_ in regs)
    return s,(regs,g)

def ok_pair(a,b):
    return abs(a[0]-b[0])>4 or abs(a[1]-b[1])>4

def mutate(centers):
    centers=centers[:]
    i=random.randrange(len(centers))
    for _ in range(30):
      nr=centers[i][0]+random.choice([-2,-1,1,2])
      nc=centers[i][1]+random.choice([-2,-1,1,2])
