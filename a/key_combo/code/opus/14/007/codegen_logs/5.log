+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_border = False
+            adjacent: set[int] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in _NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w:
