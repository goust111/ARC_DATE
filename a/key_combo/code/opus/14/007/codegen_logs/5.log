    g=np.zeros((H,W),dtype=int); own=-np.ones((H,W),dtype=int)
    for i,(r,c) in enumerate(centers):
      r+=shift[0]; c+=shift[1]
      for dr,dc in S:
        rr,cc=r+dr,c+dc
        if not (0<=rr<H and 0<=cc<W): return None
        if g[rr,cc]: return None
        g[rr,cc]=1; own[rr,cc]=i
    seen=np.zeros_like(g,bool)
    regs=[]
    for r in range(H):
      for c in range(W):
        if g[r,c] or seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; pts=[]; touch=False
        while q:
