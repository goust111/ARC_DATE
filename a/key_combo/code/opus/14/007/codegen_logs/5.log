import itertools
S={(0,0),(0,1),(0,-1),(1,0),(-1,0),(0,2),(0,-2),(2,0),(-2,0),(1,1),(1,-1),(-1,1),(-1,-1)}

def motif_cells(center):
  cr,cc=center
  return {(cr+dr,cc+dc) for dr,dc in S}

def nonoverlap(centers):
  sets=[motif_cells(c) for c in centers]
  for i in range(len(sets)):
    for j in range(i+1,len(sets)):
      if sets[i]&sets[j]: return False
  return True

def analyze_hole(centers,hole):
  ring=[(hole[0]-1,hole[1]),(hole[0]+1,hole[1]),(hole[0],hole[1]-1),(hole[0],hole[1]+1)]
  sets=[motif_cells(c) for c in centers]
  union=set().union(*sets)
  if hole in union: return None
  if not all(p in union for p in ring): return None
  k=sum(any(p in s for p in ring) for s in sets)
  return k

cands=[(r,c) for r in range(-6,10) for c in range(-6,10)]
# exclude centers too near holes occupying them later per-hole checked.
holes=[(0,0),(0,4)]
for k in [4,5]:
  found=0
  for centers in itertools.combinations(cands,k):
    if not nonoverlap(centers):
      continue
    ks=[]
    for h in holes:
      kk=analyze_hole(centers,h)
      ks.append(kk)
    if None in ks: continue
    if {kk%2 for kk in ks}=={0,1}:
      print('found',k,centers,'ks',ks)
      found=1
      raise SystemExit
print('none')
