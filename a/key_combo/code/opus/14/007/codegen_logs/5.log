      regs,_=best[2]
      print('best',best[0],best[1],[(sz,k,u,ctr,ds[:2]) for sz,k,u,ctr,ds,_ in regs],flush=True)
      if cur_score>700:
        raise SystemExit
print('final',best[0],best[1])
