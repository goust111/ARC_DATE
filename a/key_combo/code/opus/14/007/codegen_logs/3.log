/bin/bash -lc "python - <<'PY'
import random, math
from collections import defaultdict
import numpy as np

BG=7
COLORS=[2,3,1,6]

def outline(shape, cr, cc, r):
    H,W=shape
    pts=[]
    for rr in range(H):
        for cc2 in range(W):
            if abs(rr-cr)+abs(cc2-cc)==r:
                pts.append((rr,cc2))
    return set(pts)

def inside(shape, cr, cc, r):
    H,W=shape
    pts=[]
    for rr in range(H):
        for cc2 in range(W):
            if abs(rr-cr)+abs(cc2-cc)<r:
                pts.append((rr,cc2))
    return set(pts)

def build(shape, ds):
    claims={}
    for i,d in enumerate(ds):
        for rr,cc in outline(shape,d['cr'],d['cc'],d['r'])|outline(shape,d['cr'],d['cc'],d['r']+1):
            prev=claims.get((rr,cc))
            cur=(d['r'],i)
            if prev is None or cur<prev:
                claims[(rr,cc)]=cur
    outline_owner={p:i for p,(_,i) in claims.items()}
    outline_mask=set(claims)
    fills=[]
    for i,d in sorted(list(enumerate(ds)), key=lambda x:-x[1]['r']):
        region=inside(shape,d['cr'],d['cc'],d['r'])-outline_mask
        fill_color=4 if len(region)%2==0 else d['color']
        fills.append((i,len(region),fill_color,region))
    return fills, outline_mask

def fits(shape, cr, cc, r):
    H,W=shape
    return r+1<=cr<H-(r+1) and r+1<=cc<W-(r+1)

def gen_once():
    H=W=random.randint(17,20)
    n=random.choice([3,4])
    radii=sorted(random.sample([2,3,4,5], n))
    adjacent=[(a,b) for a,b in zip(radii,radii[1:]) if b==a+1]
    if not adjacent:
        return None
    r_small,r_big=random.choice(adjacent)
    base_center=(random.randint(r_big+1,H-r_big-2), random.randint(r_big+1,W-r_big-2))
    colors=random.sample(COLORS,n)
    ds=[{'r':r_small,'cr':base_center[0],'cc':base_center[1],'color':colors[0]}, {'r':r_big,'cr':base_center[0],'cc':base_center[1],'color':colors[1]}]
    used=outline((H,W),*base_center,r_small)|outline((H,W),*base_center,r_big)
    for r,color in zip([x for x in radii if x not in (r_small,r_big)], colors[2:]):
        ok=False
        for _ in range(200):
            cr=random.randint(r+1,H-r-2)
            cc=random.randint(r+1,W-r-2)
            pts=outline((H,W),cr,cc,r)
            if pts & used:
                continue
            # encourage interaction
            if min(abs(pr-cr)+abs(pc-cc) for pr,pc in [base_center]) > r_big+r+2:
                continue
            ds.append({'r':r,'cr':cr,'cc':cc,'color':color})
            used|=pts
            ok=True
            break
        if not ok:
            return None
    # original outlines disjoint
    outlines=[]
    for d in ds:
        o=outline((H,W),d['cr'],d['cc'],d['r'])
        outlines.append(o)
    for i in range(len(outlines)):
