    for radius in radii:
        if radius in used_radii:
            continue
        candidate = _try_place_extra(shape, radius, diamonds, base_center)
        if candidate is None:
            return None
        candidate["color"] = colors[color_index]
        diamonds.append(candidate)
        color_index += 1

    return diamonds


