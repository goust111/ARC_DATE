+def _frontier(mask: np.ndarray) -> list[tuple[int, int]]:
+    pts = set()
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 1 <= nr <= 3 and 1 <= nc <= 3 and not mask[nr, nc]:
