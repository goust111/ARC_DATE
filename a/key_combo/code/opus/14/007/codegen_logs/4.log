+def _render_strip(blocks: list[np.ndarray], bg: int) -> np.ndarray:
+    width = len(blocks) * BLOCK + (len(blocks) - 1)
+    out = np.full((BLOCK, width), int(bg), dtype=int)
+    col = 0
+    for idx, block in enumerate(blocks):
+        out[:, int(col) : int(col) + BLOCK] = block
+        col += BLOCK
+        if idx != len(blocks) - 1:
+            out[:, int(col)] = SEP
+            col += 1
+    return out
