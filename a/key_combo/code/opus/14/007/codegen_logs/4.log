+
+BG = 0
+SEP = 5
+BLOCK = 5
+GEN_RETRIES = 400
+CHAIN_ORIENTATIONS = ("h", "v")
+RUN_LENGTHS = (1, 2, 3)
+PALETTE_SIZES = (2, 3)
+BLOCK_COUNTS = (3, 4, 5)
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+EDGE_OFFSETS = (1, 2, 3)
