+def _separator_cols(grid: np.ndarray, bg: int) -> list[int]:
+    cols = []
+    for c in range(grid.shape[1]):
+        col = grid[:, int(c)]
+        if int(np.sum(col == SEP)) >= BLOCK and bool(np.all((col == int(bg)) | (col == SEP))):
+            cols.append(int(c))
+    return cols
