+def _separator_rows(grid: np.ndarray, bg: int) -> list[int]:
+    rows = []
+    for r in range(grid.shape[0]):
+        row = grid[int(r)]
+        if int(np.sum(row == SEP)) >= BLOCK and bool(np.all((row == int(bg)) | (row == SEP))):
+            rows.append(int(r))
+    return rows
+
