+    for c in range(W):
+        rows = np.where(grid[:, c] != int(bg))[0]
+        if not (3 <= len(rows) <= 6):
+            continue
+        if not np.array_equal(rows, np.arange(int(rows[0]), int(rows[0]) + len(rows))):
