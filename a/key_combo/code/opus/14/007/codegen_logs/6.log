+def _sample_inner_height(run_len: int) -> int:
+    divisible = [h for h in range(6, 11) if h % run_len == 0]
+    non_divisible = [h for h in range(6, 11) if h % run_len != 0]
+    if non_divisible and _RNG.random() < 0.5:
