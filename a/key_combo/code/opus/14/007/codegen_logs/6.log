  grid: square, 7-20 rows/cols; only black(0) + red(2) in input
  frames:
    count: 1-4 hollow red square frames
    side_lengths: from {5, 7, 9} (repeats allowed)
    structure: complete 1-pixel-wide red border, interior all black except centered marker
    marker: single red pixel at exact center of interior ((side-2)//2, (side-2)//2)
  placement:
    frames do not overlap; min bbox gap >= 1 cell in at least one axis
    frames may touch grid boundary [observed]
    grid large enough to fit all frames with gaps; ~2-4 extra cells of padding [observed]
  transform:
    fill each frame interior (excluding marker) with size-dependent color
    5x5 -> teal(8), 7x7 -> yellow(4), 9x9 -> green(3)
    red border and marker pixels unchanged

generation_strategy:
