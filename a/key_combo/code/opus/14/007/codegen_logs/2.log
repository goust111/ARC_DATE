+
+def _infer_vertical_axis(sprite: np.ndarray) -> int:
+    h, w = sprite.shape
+    known = sprite != BLACK
+    best_a2 = w - 1
+    best_key = None
+    for a2 in range(0, 2 * (w - 1) + 1):
+        mismatches = 0
+        paired = 0
+        in_bounds = 0
+        for r in range(h):
+            for c in np.where(known[r])[0]:
+                c2 = a2 - int(c)
+                if 0 <= c2 < w:
+                    in_bounds += 1
+                    if known[r, c2]:
+                        paired += 1
+                        if int(sprite[r, c]) != int(sprite[r, c2]):
+                            mismatches += 1
+        key = (mismatches, -paired, -in_bounds, abs(a2 - (w - 1)))
+        if best_key is None or key < best_key:
+            best_key = key
+            best_a2 = a2
+    return int(best_a2)
+
+
+def _infer_horizontal_axis(sprite: np.ndarray) -> int:
+    h, w = sprite.shape
+    known = sprite != BLACK
+    best_b2 = h - 1
+    best_key = None
+    for b2 in range(0, 2 * (h - 1) + 1):
+        mismatches = 0
+        paired = 0
+        in_bounds = 0
+        for r in range(h):
+            r2 = b2 - r
+            if not (0 <= r2 < h):
+                continue
+            for c in np.where(known[r])[0]:
+                in_bounds += 1
+                if known[r2, c]:
+                    paired += 1
+                    if int(sprite[r, c]) != int(sprite[r2, c]):
+                        mismatches += 1
+        key = (mismatches, -paired, -in_bounds, abs(b2 - (h - 1)))
+        if best_key is None or key < best_key:
+            best_key = key
+            best_b2 = b2
+    return int(best_b2)
