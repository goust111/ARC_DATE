+    center_r = h // 2
+    center_c = w // 2
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(1, center_r + 1):
+        if r == center_r:
+            continue
+        for c in range(1, center_c + 1):
+            if c == center_c:
+                continue
+            orbit = _orbit_coords(h, w, r, c)
+            if len(orbit) != 4:
+                continue
+            if all(int(template[rr, cc]) != BLACK for rr, cc in orbit):
+                orbits.append(orbit)
+    return orbits
