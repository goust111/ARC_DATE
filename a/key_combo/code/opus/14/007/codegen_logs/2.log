+        if v == h:
+            return int(v)
+        if d_nonblack:
+            return int(d)
+        return int(v)
+    if v_nonblack:
+        return int(v)
+    if h_nonblack:
+        return int(h)
+    if d_nonblack:
+        return int(d)
+    return BLACK
