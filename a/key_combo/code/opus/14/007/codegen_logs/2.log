+
+
+def _expected_output(template: np.ndarray, bottom_shape: tuple[int, int], anchors: list[tuple[int, int]]) -> np.ndarray:
+    out = np.zeros(bottom_shape, dtype=int)
+    for r, c in anchors:
+        _stamp(out, template, int(r), int(c))
