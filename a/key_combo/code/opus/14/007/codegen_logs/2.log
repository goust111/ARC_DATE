+def _stamp(out: np.ndarray, template: np.ndarray, anchor_r: int, anchor_c: int) -> None:
+    th, tw = template.shape
+    cr = th // 2
+    cc = tw // 2
+    r0 = anchor_r - cr
+    c0 = anchor_c - cc
+    for tr in range(th):
+        for tc in range(tw):
+            color = int(template[tr, tc])
+            if color != BLACK:
