+def _choose_fill_color(v: int, h: int, d: int) -> int:
+    v_nonblack = v != BLACK
+    h_nonblack = h != BLACK
+    d_nonblack = d != BLACK
+
+    if v_nonblack and h_nonblack:
+        if v == h:
+            return int(v)
+        if d_nonblack:
+            return int(d)
+        return int(v)
+    if v_nonblack:
+        return int(v)
+    if h_nonblack:
+        return int(h)
+    if d_nonblack:
+        return int(d)
+    return BLACK
