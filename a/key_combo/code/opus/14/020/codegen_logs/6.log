+def _extend_line(shape: tuple[int, int], first_marker: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = step
+    r, c = first_marker
+    while _in_bounds(shape, r - dr, c - dc):
+        r -= dr
+        c -= dc
+
