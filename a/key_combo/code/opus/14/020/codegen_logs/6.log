+
+def _backtrack_pick(
+    side_records: dict[int, list[dict[str, int]]],
+    needed: dict[int, int],
+) -> list[dict[str, int]] | None:
+    ordered_sides = [1, -1] if needed[1] <= needed[-1] else [-1, 1]
