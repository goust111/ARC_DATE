spec:
  grid: 15x15 [observed]
  background: BLACK (0) [observed]
  markers:
    count: exactly 3
    color: single non-RED foreground color; BLUE in all eval [observed]
    arrangement: equally spaced on a straight arithmetic line
    step_vector: (dr, dc) with dr=dc>0 (diagonal down-right) [observed]; solver allows any nonzero equal-step direction
    step_magnitude_per_component: 2-4 [observed]
    first_marker_position: row 0-1, col 0-1 [observed]
  continuation:
