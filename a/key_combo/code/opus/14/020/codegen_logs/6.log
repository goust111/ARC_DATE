+
+BACKGROUND = 0
+LINE_COLOR = 1
+SIDE_B_COLOR = 2
+SIDE_A_COLOR = 3
+INPUT_COLORS = (2, 3, 4, 5, 6, 7, 8, 9)
+
+STEP_OPTIONS = (
+    (1, 1),
+    (1, -1),
+    (1, 2),
+    (1, -2),
+    (2, 1),
+    (2, -1),
+    (1, 3),
+    (1, -3),
+    (3, 1),
+    (3, -1),
+)
+
+GRID_SIDE_RANGE = (10, 15)
+SINGLETON_COUNT_OPTIONS = (4, 5, 6)
+GENERATION_ATTEMPTS = 800
