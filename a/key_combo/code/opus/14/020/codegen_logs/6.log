+                break
+        if rejected:
+            continue
+
+        rec["chosen"] = True
+        snapshot.append(rec)
+        result = _backtrack_pick(side_records, next_needed)
+        if result is not None:
+            return [rec] + result
+        for item in snapshot:
+            item.pop("chosen", None)
+    return None
+
+
