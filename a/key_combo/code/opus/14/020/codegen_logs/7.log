+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((int(cr), int(cc)))
+                for dr, dc in dirs:
