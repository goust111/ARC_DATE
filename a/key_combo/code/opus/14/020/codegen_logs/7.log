+def assign_input_colors(rng: random.Random, count: int) -> list[int]:
+    mandatory = [1, 2, 3]
+    rest = [color for color in INPUT_COLOR_POOL if color not in mandatory]
+    colors = mandatory + rng.sample(rest, count - len(mandatory))
+    rng.shuffle(colors)
