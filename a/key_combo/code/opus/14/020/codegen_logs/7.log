+    dc = abs(source[1] - target[1])
+    if dr == 0 or dc == 0:
+        return "orth"
+    if dr == dc:
+        return "pure_diag"
+    return "mixed"
+
+
+def compute_candidate_options(shape: tuple[int, int], anchors: list[BBox]) -> dict[tuple[int, int], list[dict]]:
