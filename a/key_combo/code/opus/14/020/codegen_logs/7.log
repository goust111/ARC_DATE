+                "source": source,
+                "target": target,
+                "anchor_idx": anchor_idx,
+                "distance": distance,
+                "block_distance": distance_to_block(source, anchor),
+                "tie_target": tied,
+                "target_kind": frame_kind(anchor, target),
+                "move_mode": move_mode(source, target),
