+from collections import Counter
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+OUTPUT_COLOR_BY_DISTANCE = {
+    "near": 3,   # D <= 2
+    "mid": 2,    # 3 <= D <= 4
+    "far": 1,    # D >= 5
+}
+INPUT_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
