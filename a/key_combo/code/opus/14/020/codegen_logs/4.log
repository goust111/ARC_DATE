+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 0
+MOTIF_COLOR = 5
+MAX_ATTEMPTS = 400
+
+MOTIF_TEMPLATES = [
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 1]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1], [0, 0, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0], [1, 0, 0]], dtype=bool),
