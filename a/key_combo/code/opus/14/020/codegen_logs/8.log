+    options = FRAME_CANDIDATES[:]
+    rng.shuffle(options)
+    for cand in options:
+        bbox = cand["bbox"]
+        assert isinstance(bbox, tuple)
+        if any(not _boxes_separated(bbox, other, gap=1) for other in reserved_boxes):
