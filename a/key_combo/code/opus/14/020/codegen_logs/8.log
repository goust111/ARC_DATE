+    enclosed_dists = {int(distances[r, c]) for r, c in np.argwhere(enclosed)}
+    for dist in enclosed_dists:
+        same_ring_reachable = np.any((distances == dist) & reachable)
+        if not same_ring_reachable:
+            return False
