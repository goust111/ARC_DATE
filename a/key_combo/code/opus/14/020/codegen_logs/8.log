0638: def translate(obj: np.ndarray, dr: int, dc: int, *, background: int = Color.BLACK) -> np.ndarray:
0639:     """Translate a full-grid object by (dr,dc), filling empty with background."""
0640:     dr = int(dr)
0641:     dc = int(dc)
0642:     bg = int(background)
0643:     H, W = obj.shape
0644:     out = np.full_like(obj, bg)
0645:     rr, cc = np.nonzero(obj != bg)
0646:     rr2 = rr + dr
0647:     cc2 = cc + dc
0648:     inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
0649:     out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
0650:     return out
