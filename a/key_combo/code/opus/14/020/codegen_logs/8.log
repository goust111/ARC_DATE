0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """Fill each centered square ring with the color of the marker at that ring distance.
0008: 
0009:     Input structure
0010:     The input is an odd square grid with a dominant background color and one
0011:     non-background marker for every Chebyshev distance from the grid center.
0012:     Rule
0013:     The output replaces the background with concentric square rings centered on
0014:     the middle cell; every cell at distance d from the center takes the color of
0015:     the unique marker whose distance from the center is d.
0016:     Key insight
0017:     The scattered markers are not objects to move; their Chebyshev distances
0018:     form a palette for the centered square rings.
0019:     """
0020:     g = np.asarray(grid, dtype=int)
0021:     h, w = g.shape
0022:     assert h == w and h % 2 == 1
0023: 
0024:     bg = get_bg(g)
0025:     _, counts = np.unique(g, return_counts=True)
0026:     max_count = int(counts.max())
0027:     assert int(np.count_nonzero(counts == max_count)) == 1
0028:     assert int(np.count_nonzero(g == bg)) == max_count
