+    return candidates
+
+
+FRAME_CANDIDATES = _all_frame_candidates()
+
+
+def _place_open_distractor(
+    rng: np.random.Generator,
+    occupied: set[tuple[int, int]],
+    reserved_boxes: list[tuple[int, int, int, int]],
