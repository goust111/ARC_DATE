+
+def _all_frame_candidates() -> list[dict[str, object]]:
+    candidates: list[dict[str, object]] = []
+    dist_grid = _distance_grid(SIZE)
+    for r0 in range(1, SIZE - 3):
+        for c0 in range(1, SIZE - 3):
+            for height in range(4, 7):
+                for width in range(4, 7):
