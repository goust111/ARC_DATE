+    out = _ring_fill_from_colors(h, ring_colors)
+    wall_mask = g == RED
+    out[wall_mask] = RED
+
+    reachable = _reachable_non_walls(wall_mask)
+    enclosed = (~wall_mask) & (~reachable)
