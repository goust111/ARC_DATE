0306: def _decompose_to_crossovers(perm):
0307:     """Decompose permutation into sequential crossover moves using bypass for cycles.
0308:     Returns list of (src_slot, dst_slot) where -1 means bypass column."""
0309:     N = len(perm)
0310:     visited = [False] * N
0311:     crossovers = []
0312:     for start in range(N):
0313:         if visited[start] or perm[start] == start:
0314:             visited[start] = True
0315:             continue
0316:         cycle = []
0317:         i = start
0318:         while not visited[i]:
0319:             visited[i] = True
0320:             cycle.append(i)
0321:             i = perm[i]
0322:         if len(cycle) < 2:
0323:             continue
0324:         crossovers.append((cycle[0], -1))
0325:         for k in range(len(cycle) - 1, 0, -1):
0326:             crossovers.append((cycle[k], cycle[(k + 1) % len(cycle)]))
0327:         crossovers.append((-1, cycle[1]))
0328:     return crossovers
