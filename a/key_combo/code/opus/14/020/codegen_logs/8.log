0547: def draw_line(
0548:     grid: np.ndarray,
0549:     r: int,
0550:     c: int,
0551:     *,
0552:     end_r: int | None = None,
0553:     end_c: int | None = None,
0554:     length: int | None = None,
0555:     direction: tuple[int, int] | None = None,
0556:     color: int,
0557:     stop_at: set[int] | None = None,
0558:     clip: bool = False,
0559: ) -> Coord:
0560:     """
0561:     Draw a line starting at (r,c) either to an endpoint or by (length,direction).
0562:     Modifies grid in-place. Returns (r_end,c_end) last drawn.
0563: 
0564:     Compatibility note (seed helpers):
0565:       - If you provide `direction` and leave `length=None`, the line extends until
0566:         it would leave the grid (implemented by using a sufficiently large length).
0567:     """
0568:     rr = int(r)
0569:     cc = int(c)
0570:     H, W = grid.shape
0571:     col = int(color)
0572:     stop_at = set() if stop_at is None else set(map(int, stop_at))
0573: 
0574:     if (end_r is None) != (end_c is None):
0575:         raise ValueError("draw_line: either provide both end_r and end_c, or neither")
0576: 
0577:     if end_r is not None and end_c is not None:
0578:         er = int(end_r)
0579:         ec = int(end_c)
0580:         dr = er - rr
0581:         dc = ec - cc
0582:         length = max(abs(dr), abs(dc)) + 1
0583:         dr = 0 if dr == 0 else int(dr / abs(dr))
0584:         dc = 0 if dc == 0 else int(dc / abs(dc))
0585:     else:
0586:         if direction is None:
0587:             raise ValueError("draw_line: must provide endpoint or direction")
0588:         dr, dc = map(int, direction)
0589:         dr = 0 if dr == 0 else int(dr / abs(dr))
0590:         dc = 0 if dc == 0 else int(dc / abs(dc))
0591:         if length is None:
0592:             # Extend until the edge (seed-style behavior). This uses a bound that is
0593:             # certainly long enough even if the start is out-of-bounds and clip=True.
0594:             length = max(H, W) * 2
0595:         length = int(length)
0596: 
0597:     last_r, last_c = rr, cc
0598:     for i in range(int(length)):
0599:         r2 = rr + i * dr
0600:         c2 = cc + i * dc
0601:         if not (0 <= r2 < H and 0 <= c2 < W):
0602:             if bool(clip):
0603:                 continue
0604:             break
0605:         if int(grid[r2, c2]) in stop_at:
0606:             break
0607:         grid[r2, c2] = col
0608:         last_r, last_c = r2, c2
0609:     return int(last_r), int(last_c)
