+    if distractor_bbox is not None:
+        r0, c0, r1, c1 = distractor_bbox
+        interior = np.zeros_like(grid, dtype=bool)
+        interior[r0 + 1 : r1, c0 + 1 : c1] = True
+        if np.any(interior & enclosed):
+            return False
+        if not np.any(interior & reachable):
+            return False
