+    queue: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not wall_mask[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
