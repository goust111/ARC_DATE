+    out = _ring_fill_from_colors(grid.shape[0], ring_colors)
+    wall_mask = grid == RED
+    out[wall_mask] = RED
+    reachable = _reachable_non_walls(wall_mask)
+    enclosed = (~wall_mask) & (~reachable)
+    out[enclosed] = GREY
+    return out, reachable, enclosed
