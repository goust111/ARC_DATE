spec:
  grid: 11x11 fixed
  background: 7 (orange)
  separator: full-width row at row 5, color 4 (yellow)
  upper_panel: rows 0-4, all background in input
  lower_panel: rows 6-10, contains marker + sprite
  marker:
    color: 6 (magenta), always
    shape: |
      . . X
      . . X
      X . X
      . X .
    normalized_rel: "{(0,2),(1,2),(2,0),(2,2),(3,1)}"
    bbox: 4x3, top row always row 6 (immediately below separator)
    pixels: 5
    anchor: lower-left branch at relative (2,0)
    col_range: left col 0-8 (must fit 3 cols and leave room for sprite)
  sprite:
