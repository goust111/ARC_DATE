+def _find_separators(grid: np.ndarray) -> tuple[int, int]:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == SEP)]
+    assert len(rows) == 2, "expected exactly two full-width gray separator rows"
+    return rows[0], rows[1]
