        choices = [i for i, size in enumerate(sizes) if size < hi]
        i = int(np.random.choice(choices))
        add = np.random.randint(1, min(hi - sizes[i], extra) + 1)
        sizes[i] += int(add)
        extra -= int(add)
    np.random.shuffle(sizes)
    return sizes


