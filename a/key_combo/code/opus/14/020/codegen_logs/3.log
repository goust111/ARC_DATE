  "dst": "translated guide marker branch anchor d in the upper panel",
  "match_cond": "s.bbox bottom-right aligns to d, the guide marker's lower-left branch after the marker shifts upward",
  "transform": "clear the lower panel; shift the five-pixel guide marker to the top; stamp s without rotation or recolor",
  "multi_step": "paint the shifted guide marker first, then stamp s so sprite pixels overwrite guide pixels on overlap"
}
</annotation>
<generation_spec>
