def _gen_choose_sizes(n, lo, hi, max_sum):
    min_sum = n * lo
    max_sum = min(max_sum, n * hi)
    if max_sum < min_sum:
        return None
    total = np.random.randint(min_sum, max_sum + 1)
    sizes = [lo] * n
    extra = total - min_sum
