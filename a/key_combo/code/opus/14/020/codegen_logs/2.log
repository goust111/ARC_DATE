+
+        return order_tuple
+
+    return None
+
+
+def _generate_case() -> np.ndarray | None:
+    mode = random.choice(("nested", "cross"))
+    builder = _try_make_nested_case if mode == "nested" else _try_make_cross_case
+    built = builder()
+    if built is None:
