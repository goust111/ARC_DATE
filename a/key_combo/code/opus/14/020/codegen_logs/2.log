+
+    frames = [_infer_frame(g, color) for color in colors]
+    areas = [int(frame["area"]) for frame in frames]
+    assert len(set(areas)) == 3, "frame interior areas must be pairwise distinct"
+
+    analysis = _analyze_layout(frames, g.shape)
