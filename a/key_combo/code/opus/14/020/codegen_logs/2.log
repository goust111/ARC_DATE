+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    mask = sub == int(color)
+    border = np.zeros_like(mask, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
