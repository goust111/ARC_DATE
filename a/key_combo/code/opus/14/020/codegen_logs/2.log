+def _on_border(frame: dict, r: int, c: int) -> bool:
+    r0, c0, r1, c1 = frame["bbox"]
+    return r0 <= r <= r1 and c0 <= c <= c1 and (r == r0 or r == r1 or c == c0 or c == c1)
