+            if analysis["border_interior"] <= 0:
+                continue
+            if len(analysis["overlap_winners"]) < 2:
+                continue
+            return frames, (h, w)
+    return None
+
+
+def _try_make_cross_case() -> tuple[list[dict], tuple[int, int]] | None:
+    h = random.randint(12, 16)
+    w = random.randint(12, 16)
+
+    for _ in range(200):
