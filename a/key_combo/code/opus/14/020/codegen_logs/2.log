+        large_r0 = random.randint(1, h - large_h - 3)
+        large_c0 = random.randint(1, w - large_w - 3)
+        large = (large_r0, large_c0, large_r0 + large_h - 1, large_c0 + large_w - 1)
+        lr0, lc0, lr1, lc1 = large
+
+        if lr1 - lr0 < 5 or lc1 - lc0 < 5:
