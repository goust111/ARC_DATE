+        for _ in range(random.randint(*SHAPE_COUNT_RANGE)):
+            _apply_shape(mask)
+        if random.random() < 0.5:
+            _apply_shape(mask)
+        active = int(mask.sum())
+        if not (min_active <= active <= max_active):
+            continue
+        if np.array_equal(mask, np.fliplr(mask)):
+            continue
+        comp_count = len(_components(mask))
+        if not (1 <= comp_count <= 4):
