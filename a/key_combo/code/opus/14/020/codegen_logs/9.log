+        lower = _toggle_random_cells(base, toggle_count)
+        if np.array_equal(lower, base):
+            continue
+        comp_count = len(_components(lower))
+        if not (1 <= comp_count <= 5):
+            continue
+        if _pair_is_interesting(upper_mask, lower, expect_match=False):
