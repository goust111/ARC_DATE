+            components.append(comp)
+    return components
+
+
+def _active_bounds(h: int, w: int) -> tuple[int, int]:
+    cells = h * w
+    lo = max(2, int(np.ceil(ACTIVE_RATIO_RANGE[0] * cells)))
+    hi = min(cells - 2, int(np.floor(ACTIVE_RATIO_RANGE[1] * cells)))
