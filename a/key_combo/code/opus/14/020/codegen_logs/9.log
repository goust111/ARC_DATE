        upper_mask = upper == UPPER_COLOR
        lower_mask = lower == LOWER_COLOR
        if np.array_equal(upper_mask, np.fliplr(upper_mask)):
            return False
        if not _pair_is_interesting(upper_mask, lower_mask, expect_match):
