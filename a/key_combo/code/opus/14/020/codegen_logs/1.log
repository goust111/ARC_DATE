+
+
+def _outside_expanded_box(
+    r: int, c: int, box: tuple[int, int, int, int], margin: int
+) -> bool:
+    r0, c0, r1, c1 = box
+    return not (r0 - margin <= r <= r1 + margin and c0 - margin <= c <= c1 + margin)
+
+
+def _isolated_from_nonblack(grid: np.ndarray, r: int, c: int) -> bool:
