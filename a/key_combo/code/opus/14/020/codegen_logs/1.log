0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Continue the equally spaced marker line past its last blue marker, painting the continuation red.
0009: 
0010:     Input structure
0011:     - The grid has a dominant background color.
0012:     - Exactly one foreground color marks three pixels on a straight arithmetic line.
0013:     - The three marker pixels are equally spaced.
0014: 
0015:     Rule
0016:     - Order the markers along the line in row-major direction.
0017:     - Use the vector between consecutive markers as the step.
0018:     - Starting one step beyond the last marker, paint each in-bounds background cell red.
0019:     - Stop before the next step would leave the grid.
0020: 
0021:     Key insight
0022:     - The three blue pixels are not copied; they define the spacing and direction of a line continuation.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
