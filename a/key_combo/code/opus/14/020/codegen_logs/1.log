import numpy as np
from collections import deque

def rays(grid, markers):
    g=grid.copy()
    H,W=g.shape
    out=g.copy()
    marker_set={(r,c):g[r,c] for r,c in markers}
    painted=[]
    for r,c in markers:
        color=g[r,c]
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                nr,nc=rr+dr,cc+dc
                if nr<0 or nr>=H or nc<0 or nc>=W:
                    painted.append((rr,cc,color)); break
                if g[nr,nc]==2 or ((nr,nc) in marker_set):
                    painted.append((rr,cc,color)); break
                painted.append((rr,cc,color))
                rr,cc=nr,nc
    for r,c,color in painted:
        if out[r,c]==0:
            out[r,c]=color
    return out

def fill(out):
    H,W=out.shape
    reach=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if out[r,c]==0 and not reach[r,c]:
                reach[r,c]=True;q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if out[r,c]==0 and not reach[r,c]:
                reach[r,c]=True;q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and out[rr,cc]==0 and not reach[rr,cc]:
                reach[rr,cc]=True;q.append((rr,cc))
    enclosed=(out==0)&~reach
    return enclosed

