+    for c in control_cols:
+        color = int(g[0, c])
+        assert color not in (BLACK, RED), "control pixels must be non-black and non-red"
+        for r in range(1, h):
+            cell = int(out[r, c])
+            if cell == BLACK:
+                out[r, c] = color
+                continue
+            if cell == RED:
+                if component_sizes[(r, c)] == 1:
+                    out[r, c] = color
+                    break
+                continue
+            break
+
+    return out
