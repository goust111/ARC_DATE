+    comps: list[set[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != RED:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                comp.add((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == RED:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+            size = len(comp)
+            for cell in comp:
