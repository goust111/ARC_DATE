+    w = random.randint(*GRID_W_RANGE)
+    top = random.randint(MIN_PADDING, h - (REGION_SIDE + 1 + MASK_SIDE) - MIN_PADDING)
+    left = random.randint(MIN_PADDING, w - REGION_SIDE - MIN_PADDING)
