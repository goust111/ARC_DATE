# Token count and wide-span placement.
TOKEN_COUNT_MIN, TOKEN_COUNT_MAX = 5, 7
POSITION_EDGE_MARGIN = 1
WIDE_SPAN_RATIO = 0.8

# Source/reference match weighting and retries.
MATCH_WEIGHTS = {1: 2, 2: 4}
DEFAULT_MATCH_WEIGHT = 1
GEN_RETRIES = 300

ORIENTATIONS = ("h", "v")
