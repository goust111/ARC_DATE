+    grid = np.zeros((h, w), dtype=int)
+    region = np.kron(mask.astype(int), np.ones((TILE, TILE), dtype=int)) * MASK_COLOR
+    grid[top : top + REGION_SIDE, left : left + REGION_SIDE] = region
