+    return mask, palette
+
+
+def _render_output(mask: np.ndarray, palette: np.ndarray) -> np.ndarray:
+    out = np.zeros((REGION_SIDE, REGION_SIDE), dtype=int)
+    for br in range(MASK_SIDE):
