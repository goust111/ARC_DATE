+    if idx == 1:
+        return slice(0, mid), slice(mid + 1, 2 * mid + 1)
+    if idx == 2:
+        return slice(mid + 1, 2 * mid + 1), slice(0, mid)
+    return slice(mid + 1, 2 * mid + 1), slice(mid + 1, 2 * mid + 1)
