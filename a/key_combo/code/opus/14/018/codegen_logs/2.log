        for r in range(q):
            for c in range(r, q):
                neighbor_values: list[int] = []
                for nr, nc in ((r - 1, c), (r, c - 1), (r - 1, c - 1), (r - 1, c + 1)):
                    if nr < 0 or nc < 0 or nr >= q or nc >= q or nr > nc:
