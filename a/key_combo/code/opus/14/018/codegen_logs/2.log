+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+SEPARATOR = 5
+MARKER = 7
+FOREGROUND_POOL = (1, 2, 3, 4, 6, 8, 9)
+QUADRANT_SIZE_OPTIONS = (5, 6)
+GENERATION_ATTEMPTS = 500
+QUADRANT_ATTEMPTS = 180
+LOCAL_RECT_MAX = 4
