+def _d4_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:
+    last = n - 1
+    return {
+        (r, c),
+        (r, last - c),
+        (last - r, c),
+        (last - r, last - c),
+        (c, r),
+        (c, last - r),
+        (last - c, r),
+        (last - c, last - r),
+    }
