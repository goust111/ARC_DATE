+    size_c = c1 - c0 + 1
+    if size_r != size_c or size_r < 2:
+        return False
+    coord_set = set(obj["coords"])
+    for c in range(c0, c1 + 1):
+        if (r0, c) not in coord_set or (r1, c) not in coord_set:
+            return False
+    for r in range(r0, r1 + 1):
+        if (r, c0) not in coord_set or (r, c1) not in coord_set:
+            return False
+    return True
