+        cr, cc = cur
+        for dr, dc in NEIGHBORS4:
+            nr, nc = cr + dr, cc + dc
+            if _in_bounds((h, w), nr, nc) and dist[nr, nc] == dist[cr, cc] - 1:
+                preds.append((nr, nc))
+        if len(preds) != 1:
+            return None
+        cur = preds[0]
+        path.append(cur)
