+    inside = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    candidates = border + inside
+    usable = []
+    for r, c in candidates:
+        if bool(blocked[r, c]) or int(grid[r, c]) != BLACK:
