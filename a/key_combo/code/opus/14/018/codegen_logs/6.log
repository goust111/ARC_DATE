+    elif kind == "lshape":
+        h = rng.choice([2, 3, 4] if prefer_small else [2, 3, 4, 5])
+        w = rng.choice([2, 3, 4] if prefer_small else [2, 3, 4, 5])
+        patch = np.zeros((h, w), dtype=int)
