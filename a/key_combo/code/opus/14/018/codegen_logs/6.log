+
+
+def _random_non_square_patch(rng: random.Random, prefer_small: bool = False) -> np.ndarray:
+    kind = rng.choice(["rect", "lshape", "broken_frame", "tshape"])
+    if prefer_small and rng.random() < 0.55:
