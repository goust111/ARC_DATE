+
+def _unique_shortest_path(
+    blocked: np.ndarray, start: tuple[int, int], goal: tuple[int, int]
+) -> list[tuple[int, int]] | None:
+    if bool(blocked[start]) or bool(blocked[goal]):
+        return None
+
+    h, w = blocked.shape
+    dist = np.full((h, w), -1, dtype=int)
+    ways = np.zeros((h, w), dtype=np.uint8)
+    q = deque([start])
+    dist[start] = 0
+    ways[start] = 1
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if not _in_bounds((h, w), nr, nc) or bool(blocked[nr, nc]):
+                continue
+            nd = dist[r, c] + 1
+            if dist[nr, nc] == -1:
+                dist[nr, nc] = nd
+                ways[nr, nc] = ways[r, c]
+                q.append((nr, nc))
+            elif dist[nr, nc] == nd:
+                ways[nr, nc] = min(2, int(ways[nr, nc]) + int(ways[r, c]))
+
+    if dist[goal] == -1 or ways[goal] != 1:
+        return None
+
+    path = [goal]
+    cur = goal
+    while cur != start:
+        preds = []
+        cr, cc = cur
+        for dr, dc in NEIGHBORS4:
+            nr, nc = cr + dr, cc + dc
+            if _in_bounds((h, w), nr, nc) and dist[nr, nc] == dist[cr, cc] - 1:
+                preds.append((nr, nc))
+        if len(preds) != 1:
+            return None
+        cur = preds[0]
+        path.append(cur)
+    path.reverse()
+    return path
