+            [
+                [0, BLUE, 0],
+                [BLUE, BLUE, BLUE],
+                [0, BLUE, 0],
+            ],
+            dtype=int,
+        )
+        if rng.random() < 0.5:
+            patch[0, 1] = BLUE
+            patch[2, 1] = BLACK
