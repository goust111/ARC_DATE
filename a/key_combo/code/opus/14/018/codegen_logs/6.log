+    return patch
+
+
+def _can_place_patch(
+    grid: np.ndarray,
+    forbidden: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    endpoints: tuple[tuple[int, int], tuple[int, int]] | None = None,
