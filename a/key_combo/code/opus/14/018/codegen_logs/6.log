+        patch[-1, :] = BLUE
+        patch[:, 0] = BLUE
+        patch[:, -1] = BLUE
+        side = rng.choice(["top", "bottom", "left", "right"])
+        idx = rng.randrange(1, size - 1)
+        if side == "top":
+            patch[0, idx] = BLACK
+        elif side == "bottom":
+            patch[-1, idx] = BLACK
+        elif side == "left":
+            patch[idx, 0] = BLACK
+        else:
