+    gh, gw = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > gh or c0 + w > gw:
+        return False
+    if np.any((patch == BLUE) & (grid[r0 : r0 + h, c0 : c0 + w] != BLACK)):
