+                c0 = anchor[1] - pc
+                if not _can_place_patch(grid, forbidden, patch, r0, c0, endpoints):
+                    continue
+                placed = [(r0 + rr, c0 + cc) for rr, cc in shape_cells]
+                if not any(cell in path_cells for cell in placed):
