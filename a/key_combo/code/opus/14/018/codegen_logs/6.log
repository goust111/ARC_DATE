+def _eligible_endpoints(grid: np.ndarray, blocked: np.ndarray) -> list[tuple[int, int]]:
+    blue_cells = {tuple(map(int, rc)) for rc in np.argwhere(grid == BLUE)}
+    h, w = grid.shape
+    border = (
+        [(0, c) for c in range(w)]
