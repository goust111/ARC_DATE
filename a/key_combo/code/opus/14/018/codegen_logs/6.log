+    non_square_cells: set[tuple[int, int]] = set()
+    complete_count = 0
+
+    for obj in _find_blue_objects(grid):
+        if _is_complete_square(obj):
+            complete_count += 1
+            for r, c in obj["coords"]:
+                blocked[r, c] = True
+                square_blocked[r, c] = True
