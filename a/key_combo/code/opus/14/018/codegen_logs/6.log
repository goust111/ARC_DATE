+        np.array([[BLUE, BLUE, BLUE], [BLUE, BLACK, BLACK]], dtype=int),
+        np.array([[BLUE, BLUE], [BLUE, BLUE], [BLUE, BLACK]], dtype=int),
+        np.array([[BLUE, BLUE, BLUE], [BLACK, BLUE, BLACK]], dtype=int),
