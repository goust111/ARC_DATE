+        start, goal, path = endpoint_choice
+
+        if not _place_path_non_square(rng, grid, forbidden, path, (start, goal)):
+            continue
+        if non_square_count > 1 and not _place_extra_non_squares(rng, grid, forbidden, (start, goal), non_square_count - 1):
+            continue
+
+        grid = grid.copy()
+        grid[start] = ORANGE
+        grid[goal] = ORANGE
+
+        try:
+            _validate_generated_input(grid)
+        except AssertionError:
