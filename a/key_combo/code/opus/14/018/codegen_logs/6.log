+        grid = grid.copy()
+        grid[start] = ORANGE
+        grid[goal] = ORANGE
+
+        try:
+            _validate_generated_input(grid)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError(f"failed to generate a valid puzzle input after {GEN_RETRY_LIMIT} attempts")

