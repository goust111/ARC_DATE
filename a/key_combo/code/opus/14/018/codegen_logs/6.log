+def _stamp_patch(grid: np.ndarray, forbidden: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> list[tuple[int, int]]:
+    h, w = patch.shape
+    coords = []
+    for pr, pc in np.argwhere(patch == BLUE):
