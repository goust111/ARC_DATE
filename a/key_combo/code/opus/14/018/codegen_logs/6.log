+def _marker_target_bboxes(cell: tuple[int, int], size: int) -> list[tuple[int, int]]:
+    r, c = cell
+    candidates = [
+        (r + 1, c),
+        (r, c + 1),
+        (r + 1, c - size + 1),
+        (r, c - size),
+        (r - size, c),
+        (r - size + 1, c + 1),
+        (r - size, c - size + 1),
+        (r - size + 1, c - size),
+    ]
+    dedup = []
+    seen = set()
+    for item in candidates:
+        if item not in seen:
+            seen.add(item)
+            dedup.append(item)
