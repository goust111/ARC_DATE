+            patch[-1, :] = BLUE
+    elif kind == "broken_frame":
+        size = rng.choice([3, 4] if prefer_small else [3, 4, 5])
+        patch = np.zeros((size, size), dtype=int)
+        patch[0, :] = BLUE
+        patch[-1, :] = BLUE
+        patch[:, 0] = BLUE
+        patch[:, -1] = BLUE
+        side = rng.choice(["top", "bottom", "left", "right"])
+        idx = rng.randrange(1, size - 1)
