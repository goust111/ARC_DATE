+
+def _place_anywhere(grid: np.ndarray, shape, color: int, row_range: range, col_range: range, placed: list[tuple[int, int, int, int]], gap: int = 1):
+    h, w = _shape_hw(shape)
+    candidates = []
+    for top in row_range:
