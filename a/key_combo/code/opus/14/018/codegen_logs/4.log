+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+TEMPLATE_COLORS = (BLUE, GREEN, YELLOW, ORANGE)
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
