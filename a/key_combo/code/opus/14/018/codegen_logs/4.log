+            template["shape"],
+            color,
+            range(0, H),
+            range(0, divider),
+            legend_boxes,
+            gap=1,
+        )
+        if placed is None:
+            return None
+        template["color"] = int(color)
+
+    out = np.full((H, W), BG, dtype=int)
+    out[:, divider] = GREY
+    out[:, :divider] = legend
