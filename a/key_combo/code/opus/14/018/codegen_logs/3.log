        return False
    height, width = _shape_dimensions(pixels)
    if height < SHAPE_HEIGHT_BOUNDS[0] or height > SHAPE_HEIGHT_BOUNDS[1]:
        return False
    if width < SHAPE_WIDTH_BOUNDS[0] or width > SHAPE_WIDTH_BOUNDS[1]:
        return False
    if not _is_8_connected(pixels):
