    min_c = min(c for _, c in pixels)
    return {(r, c - min_c) for r, c in pixels}


def _build_funnel_shape(target_cavity):
    h = random.randint(SHAPE_HEIGHT_BOUNDS[0], SHAPE_HEIGHT_BOUNDS[1])
