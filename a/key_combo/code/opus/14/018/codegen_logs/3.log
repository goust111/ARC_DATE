+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return False
+    want = set()
+    for c in range(c0, c1 + 1):
+        want.add((r0, c))
+        want.add((r1, c))
+    for r in range(r0, r1 + 1):
+        want.add((r, c0))
+        want.add((r, c1))
+    return set(coords) == want
