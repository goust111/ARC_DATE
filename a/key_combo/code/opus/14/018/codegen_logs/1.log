+    path = [goal]
+    cur = goal
+    while cur != start:
+        r, c = cur
+        preds = [
+            (nr, nc)
+            for nr, nc in neighbors4(r, c)
+            if in_bounds(grid.shape, nr, nc) and dist[nr, nc] == dist[r, c] - 1
+        ]
+        assert len(preds) == 1, "expected a unique predecessor chain"
+        cur = preds[0]
+        path.append(cur)
+    path.reverse()
+    return path
