+BLACK = 0
+BLUE = 1
+RED = 2
+CONTROL_PALETTE = (3, 4, 7)
+
+GEN_RETRIES = 400
+GRID_HEIGHT_RANGE = (11, 14)
+GRID_WIDTH_RANGE = (11, 14)
