+    path_by_col: dict[int, list[tuple[int, int]]] = {}
+    for r, c in path:
+        if r > 0:
+            path_by_col.setdefault(c, []).append((r, c))
+
+    out = g.copy()
+    for c, color in controls:
+        for r, cc in path_by_col.get(c, []):
