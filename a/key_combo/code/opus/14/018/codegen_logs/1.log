+        path = _unique_shortest_path(grid, start, goal)
+        if any(r == 0 for r, _ in path):
+            return False
+        if any(int(grid[r, c]) != BLACK for r, c in path[1:-1]):
+            return False
+        path_cols = {c for _, c in path}
+        if path_cols & control_cols != control_cols:
