# Palette and object size choices.
MAIN_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW)
STAMP_SIZES = (3, 4)
PATTERN_CELL_SIZES = (1, 2)

# Macro stencil size and density ranges.
MACRO_H_RANGE = (2, 3)
MACRO_W_RANGE = (3, 6)
STAMP_TEAL_FRACTION = (0.40, 0.60)
SELECTOR_TEAL_FRACTION = (0.25, 0.50)

