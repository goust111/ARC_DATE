+def _generate_attempt() -> np.ndarray | None:
+    n = random.choice((2, 3, 4))
+    colors = random.sample(list(CONTROL_COLORS), n)
+    row_colors = colors[:]
+    random.shuffle(row_colors)
+
+    areas = random.sample(range(3, 9), n)
