TOP_PAD_RANGE = (1, 2)
LEFT_PAD_RANGE = (1, 2)
RIGHT_PAD_RANGE = (1, 3)
BOTTOM_PAD_RANGE = (1, 3)
OBJECT_GAP = 1

# Validity retry budget.
