+        sprite_infos.append(
+            {
+                "color": int(color),
+                "coords": sprite,
+                "area": len(sprite),
+                "bbox": (r0, c0, r1, c1),
+                "bbox_area": (r1 - r0 + 1) * (c1 - c0 + 1),
+                "height": r1 - r0 + 1,
+                "width": c1 - c0 + 1,
+                "shape": _shape_signature(sprite),
+            }
+        )
+    areas = [info["area"] for info in sprite_infos]
+    assert len(set(areas)) == len(areas), "sprite areas must be distinct"
+    return control_rows, row_colors, sprite_infos
