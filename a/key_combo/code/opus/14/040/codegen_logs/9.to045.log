+    if active_colors is None:
+        active_colors = set(analysis["active_colors"])
+    final_boxes, move_steps, order = _simulate_boxes(
+        g.shape,
+        analysis["objects"],
+        active_colors,
+        analysis["priority_color"],
+        order_override=order_override,
+    )
