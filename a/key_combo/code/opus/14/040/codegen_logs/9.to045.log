+        row = r0 + attach_index
+        rod = {(row, c1 + d) for d in range(1, rod_len + 1)}
+    elif direction == "left":
+        row = r0 + attach_index
+        rod = {(row, c0 - d) for d in range(1, rod_len + 1)}
+    elif direction == "down":
+        col = c0 + attach_index
+        rod = {(r1 + d, col) for d in range(1, rod_len + 1)}
+    else:
+        col = c0 + attach_index
+        rod = {(r0 - d, col) for d in range(1, rod_len + 1)}
