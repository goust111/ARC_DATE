+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+BODY_COLORS = (1, 2, 3, 6, 7)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_FROM_VEC = {v: k for k, v in DIRS.items()}
