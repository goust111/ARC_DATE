+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(grid == color):
+        cell = (int(r), int(c))
+        if cell in seen:
+            continue
+        q = deque([cell])
+        seen.add(cell)
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == color and (nr, nc) not in seen:
