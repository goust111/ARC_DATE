+    out = g.copy()
+    for color in active_colors:
+        for r, c in analysis["objects"][color]["component_cells"]:
+            out[r, c] = BG
+    for color in active_colors:
+        for r, c in _bbox_cells(final_boxes[color]):
+            out[r, c] = color
+    return out, move_steps, order
