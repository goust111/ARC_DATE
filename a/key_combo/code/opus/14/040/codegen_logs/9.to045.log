+    obj = {
+        "color": color,
+        "body_bbox": body_bbox,
+        "body_cells": _bbox_cells(body_bbox),
+        "rod_cells": rod,
+        "component_cells": _bbox_cells(body_bbox) | rod,
+        "dir": DIRS[direction],
+        "rod_len": rod_len,
+        "top_left": body_bbox[:2],
+    }
