  "path": "straight one-cell-wide connector stem toward the separate solid rectangular anchor; move by the stem length",
  "dst": "slot adjacent to the anchor at the stem end",
  "trajectory": "paint only the final translated rectangle",
  "transform": "erase the original moving-color object including the stem; keep the anchor unchanged"
}
</annotation>
