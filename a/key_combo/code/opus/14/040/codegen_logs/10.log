+    colors = [random.choice(SEED_COLORS) for _ in range(seed_count)]
+    if len(set(colors)) == 1:
+        colors[-1] = random.choice([c for c in SEED_COLORS if c != colors[0]])
+    for (r, c), color in zip(positions, colors):
+        seed_grid[r, c] = color
+    return seed_grid
+
