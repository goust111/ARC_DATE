+            ownership[idx] += 1
+            if distance % 2 == 1:
+                odd_ownership[idx] += 1
+
+    info = {
+        "tie_count": int(np.count_nonzero(tie & walkable)),
+        "ownership": ownership,
+        "odd_ownership": odd_ownership,
+        "seed_specs": seed_specs,
+        "centers": centers,
+    }
+    return out, info
+
+
+def _connected_walkable(region: np.ndarray) -> bool:
+    walkable = region != TEAL
