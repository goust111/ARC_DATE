+        count = int(np.count_nonzero(coarse == color))
+        if count:
+            freq[int(color)] = count
+    return freq
+
+
+def _extract_segments(grid: np.ndarray, start_row: int, stripe_row: int) -> list[dict[str, int]]:
+    segments: list[dict[str, int]] = []
