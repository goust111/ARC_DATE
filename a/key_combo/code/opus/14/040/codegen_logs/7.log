+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+BLOCK = 3
+TILE_COLORS = (BLUE, RED, GREEN, ORANGE)
+
+
+def _nonempty_rows(grid: np.ndarray) -> np.ndarray:
