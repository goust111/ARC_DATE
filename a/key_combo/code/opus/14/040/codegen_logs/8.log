def _gen_wall_components_ok(g: np.ndarray) -> bool:
    n = int(g.shape[0])
    min_len, max_len = _gen_wall_len_bounds(n)
    comps = find_components(g == Color.BLUE, bg=False, connectivity=4, monochromatic=False, return_format="dict")
