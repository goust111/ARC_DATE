+
+def _inside(box: tuple[int, int, int, int], r: int, c: int) -> bool:
+    r0, c0, r1, c1 = box
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _intersect(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> tuple[int, int, int, int] | None:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
