+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PATTERN_COLORS = (1, 2, 3, 4, 6, 7, 8)
+
+GEN_ATTEMPTS = 400
+SELECTION_ATTEMPTS = 2500
+TILE_ATTEMPTS = 200
+OCCLUSION_ATTEMPTS = 150
