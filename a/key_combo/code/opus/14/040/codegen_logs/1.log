+        return None
+
+    chosen = {root}
+    while len(chosen) < target_size:
+        frontier = [
+            loc
+            for loc in info["reachable"]
+            if loc not in chosen
+            and any(nei in chosen for nei in graph[loc])
+            and not _touches_existing(locals_to_abs[loc], occupied)
