+
+WALL = 8
+CORRIDOR = 0
+START = 9
+SPRITE_COLORS = (1, 2, 3, 6, 7)
+
+GEN_CELL_ROWS = (7, 9)
+GEN_CELL_COLS = (7, 9)
+GEN_SPRITE_COUNT = (3, 5)
+GEN_SHAPE_SIZE = (3, 6)
