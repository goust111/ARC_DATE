+
+        leaves.append(
+            {
+                "leaf": (rr, cc),
+                "dist": int(dist[rr, cc]),
+                "outward": outward,
+                "root": root,
+                "graph": graph,
+                "locals_to_abs": locals_to_abs,
+                "reachable": reachable,
+                "max_size": max_size,
+            }
