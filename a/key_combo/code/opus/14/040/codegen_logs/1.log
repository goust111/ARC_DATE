+def _corridor_distances(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    starts = np.argwhere(grid == START)
+    assert len(starts) == 1, "expected exactly one maroon start pixel"
+    start = tuple(int(v) for v in starts[0])
