+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == CORRIDOR and dist[nr, nc] < 0:
+                dist[nr, nc] = nd
+                q.append((nr, nc))
+    return dist, start
+
+
+def _sprite_distance_key(grid: np.ndarray, dist: np.ndarray, coords: list[tuple[int, int]]) -> int:
+    options: list[int] = []
