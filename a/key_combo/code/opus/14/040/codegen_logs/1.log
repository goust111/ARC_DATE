+        if coords is None:
+            return None
+        color = colors[idx]
+        for r, c in coords:
+            grid[r, c] = color
+            occupied.add((r, c))
+        sprites[idx] = {
+            "coords": coords,
+            "color": color,
+            "dist": leaves[idx]["dist"],
+            "leaf": leaves[idx]["leaf"],
+        }
