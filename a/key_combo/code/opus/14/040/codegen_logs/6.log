+                continue
+            q: deque[tuple[int, int]] = deque([(r0, c0)])
+            seen[r0, c0] = True
+            cells: list[tuple[int, int]] = []
+            touches_border = False
+            orange_boundary: set[tuple[int, int]] = set()
+            blue_boundary: set[tuple[int, int]] = set()
+            while q:
+                r, c = q.popleft()
+                cells.append((r, c))
+                if r in (0, h - 1) or c in (0, w - 1):
+                    touches_border = True
+                for dr, dc in DIRS4:
