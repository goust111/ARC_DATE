+                        q.append((nr, nc))
+                    elif value == ORANGE:
+                        orange_boundary.add((nr, nc))
+                    elif value == BLUE:
+                        blue_boundary.add((nr, nc))
+            orange_count = len(orange_boundary)
+            blue_count = len(blue_boundary)
+            if orange_count > blue_count:
+                fill = ORANGE
+            elif orange_count < blue_count:
+                fill = BLUE
+            else:
+                fill = RED
+            regions.append(
