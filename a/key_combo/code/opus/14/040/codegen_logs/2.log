+            for rr in range(r0, r0 + h)
+            for cc in range(c0, c0 + w)
+            if rr != keep_r and cc != keep_c
+        ]
+        if candidates:
+            rr, cc = rng.choice(candidates)
+            lattice[rr, cc] = BG
