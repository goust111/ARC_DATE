+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                area += 1
+                r0 = min(r0, rr)
+                c0 = min(c0, cc)
+                r1 = max(r1, rr)
+                c1 = max(c1, cc)
