+    c0: int,
+    h: int,
+    w: int,
+    color: int,
+    rng: random.Random,
+    force_holes: bool,
+) -> None:
+    lattice[r0 : r0 + h, c0 : c0 + w] = int(color)
+    keep_r = r0 + rng.randrange(h)
+    keep_c = c0 + rng.randrange(w)
+    hole_prob = rng.choice((0.0, 0.0, 0.1, 0.15, 0.2, 0.25))
