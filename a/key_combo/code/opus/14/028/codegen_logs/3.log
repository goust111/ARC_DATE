+
+def _orientations(mask: np.ndarray) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen = set()
+    for turns in range(4):
+        rotated = np.rot90(mask, turns)
+        for variant in (rotated, np.fliplr(rotated)):
+            key = _mask_key(variant)
+            if key not in seen:
