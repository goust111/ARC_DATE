+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+DIR_BY_COLOR = {
+    GREEN: "left",
+    YELLOW: "down",
+    PINK: "up",
+    TEAL: "right",
+}
