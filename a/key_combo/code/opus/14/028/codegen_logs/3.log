+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+DIR_BY_COLOR = {
+    GREEN: "left",
+    YELLOW: "down",
+    PINK: "up",
+    TEAL: "right",
+}
+COLOR_ORDER = (GREEN, YELLOW, PINK, TEAL)
+DIR_STEP = {
+    "left": (0, -1),
+    "right": (0, 1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
+
+PROTOTYPE_SLOTS = (
+    {"name": "A", "origin": (0, 0), "limit": (2, 3)},
+    {"name": "B", "origin": (0, 4), "limit": (3, 2)},
+    {"name": "C", "origin": (3, 0), "limit": (3, 2)},
+    {"name": "D", "origin": (4, 3), "limit": (2, 3)},
