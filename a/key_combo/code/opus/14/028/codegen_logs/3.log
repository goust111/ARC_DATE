    return random.choice(cells)


def _gen_bfs_path(
    shape: tuple[int, int],
    start: tuple[int, int],
    goal: tuple[int, int],
    forbidden: tuple[int, int],
) -> list[tuple[int, int]] | None:
    h, w = shape
    q: deque[tuple[int, int]] = deque([start])
    parent: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
    while q:
        cur = q.popleft()
        if cur == goal:
            path = []
            while cur is not None:
                path.append(cur)
                cur = parent[cur]
