+
+def _stretch_options(mask: np.ndarray, mode: str) -> list[np.ndarray]:
+    options: list[np.ndarray] = []
+    seen = set()
+    row_products = list(itertools.product(STRETCH_FACTORS, repeat=mask.shape[0]))
+    col_products = list(itertools.product(STRETCH_FACTORS, repeat=mask.shape[1]))
+    for row_factors in row_products:
