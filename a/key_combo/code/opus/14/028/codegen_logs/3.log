+            rs0 = max(0, -dr)
+            rs1 = mask.shape[0] - max(0, dr)
+            cs0 = max(0, -dc)
+            cs1 = mask.shape[1] - max(0, dc)
+            out[rs0 + dr : rs1 + dr, cs0 + dc : cs1 + dc] |= mask[rs0:rs1, cs0:cs1]
+    return out
+
+
+def _parse_grid(grid: np.ndarray) -> tuple[dict[int, dict], list[dict]]:
+    prototypes: dict[int, dict] = {}
