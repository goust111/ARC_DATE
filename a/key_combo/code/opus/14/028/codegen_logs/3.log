+    if np.array_equal(inp, out):
+        return False
+    if RED not in set(map(int, np.unique(out))):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_SIZE_RANGE)
+    w = random.randint(*GRID_SIZE_RANGE)
+    base = np.zeros((h, w), dtype=int)
