+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+DIR_BY_COLOR = {
+    GREEN: "left",
+    YELLOW: "down",
+    PINK: "up",
+    TEAL: "right",
+}
+COLOR_ORDER = (GREEN, YELLOW, PINK, TEAL)
+DIR_STEP = {
+    "left": (0, -1),
+    "right": (0, 1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
+
+PROTOTYPE_SLOTS = (
+    {"name": "A", "origin": (0, 0), "limit": (2, 3)},
+    {"name": "B", "origin": (0, 4), "limit": (3, 2)},
+    {"name": "C", "origin": (3, 0), "limit": (3, 2)},
+    {"name": "D", "origin": (4, 3), "limit": (2, 3)},
+)
+
+# Four compression-stable prototype classes. Their run-compressed masks stay
+# informative under every allowed rotation/reflection.
+SHAPE_LIBRARY = {
+    "l3": np.array([[1, 0], [1, 1]], dtype=bool),
+    "t4": np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    "s4": np.array([[0, 1, 1], [1, 1, 0]], dtype=bool),
+    "l4": np.array([[1, 0], [1, 0], [1, 1]], dtype=bool),
+}
+
+GRID_SIZE_RANGE = (20, 26)
+NUM_CANDIDATES_RANGE = (4, 6)
+STRETCH_FACTORS = (1, 2, 3)
