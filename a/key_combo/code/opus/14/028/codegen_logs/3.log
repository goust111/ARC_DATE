+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+DIR_BY_COLOR = {
+    GREEN: "left",
+    YELLOW: "down",
+    PINK: "up",
+    TEAL: "right",
+}
+COLOR_ORDER = (GREEN, YELLOW, PINK, TEAL)
+DIR_STEP = {
+    "left": (0, -1),
+    "right": (0, 1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
+
+PROTOTYPE_SLOTS = (
+    {"name": "A", "origin": (0, 0), "limit": (2, 3)},
+    {"name": "B", "origin": (0, 4), "limit": (3, 2)},
+    {"name": "C", "origin": (3, 0), "limit": (3, 2)},
+    {"name": "D", "origin": (4, 3), "limit": (2, 3)},
+)
+
+# Four compression-stable prototype classes. Their run-compressed masks stay
+# informative under every allowed rotation/reflection.
+SHAPE_LIBRARY = {
+    "l3": np.array([[1, 0], [1, 1]], dtype=bool),
+    "t4": np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    "s4": np.array([[0, 1, 1], [1, 1, 0]], dtype=bool),
+    "l4": np.array([[1, 0], [1, 0], [1, 1]], dtype=bool),
+}
+
+GRID_SIZE_RANGE = (20, 26)
+NUM_CANDIDATES_RANGE = (4, 6)
+STRETCH_FACTORS = (1, 2, 3)
+MIN_CANDIDATE_AREA = 6
+MAX_CANDIDATE_AREA = 20
+GEN_ATTEMPTS = 400
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _coords_to_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out
+
+
+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    return tuple(tuple(int(v) for v in row) for row in mask.astype(int))
+
+
+def _compress_runs(mask: np.ndarray) -> np.ndarray:
