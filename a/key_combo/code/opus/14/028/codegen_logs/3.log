+
+def _prototype_variants_for_slot(base_mask: np.ndarray, limit: tuple[int, int]) -> list[np.ndarray]:
+    max_h, max_w = limit
+    return [variant for variant in _orientations(base_mask) if variant.shape[0] <= max_h and variant.shape[1] <= max_w]
