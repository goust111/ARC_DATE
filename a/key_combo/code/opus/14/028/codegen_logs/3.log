BBOX_GAP = 2

# Shape construction choices.
MIRROR_ORBIT_SINGLE_WEIGHT = 1
MIRROR_ORBIT_PAIR_WEIGHT = 2
CONNECT_START_LIMIT = 5
RANDOM_FLIP_PROB = 0.5
CARDINAL_DELTAS = ((1, 0), (-1, 0), (0, 1), (0, -1))
