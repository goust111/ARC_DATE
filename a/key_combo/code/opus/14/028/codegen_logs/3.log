+    _prototypes, candidates = _parse_grid(g)
+    out = g.copy()
+    for candidate in candidates:
+        for r, c in _ray_cells(candidate["centroid"], candidate["direction"], g.shape):
+            if out[r, c] == BG:
+                out[r, c] = RED
