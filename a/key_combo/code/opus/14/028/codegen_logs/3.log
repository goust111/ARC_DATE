+        cell_set = {tuple(map(int, rc)) for rc in coords}
+        for cell in _ray_cells(candidate["centroid"], candidate["direction"], inp.shape):
+            if cell in cell_set:
+                continue
+            rr, cc = cell
+            if occupied[rr, cc]:
