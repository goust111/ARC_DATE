+    assigned_colors = colors + extras
+    random.shuffle(assigned_colors)
+
+    stretch_modes = ["row", "col", "both"] + [random.choice(("row", "col", "both")) for _ in range(count - 3)]
+    random.shuffle(stretch_modes)
