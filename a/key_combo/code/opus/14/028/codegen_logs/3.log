+    "l3": np.array([[1, 0], [1, 1]], dtype=bool),
+    "t4": np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    "s4": np.array([[0, 1, 1], [1, 1, 0]], dtype=bool),
