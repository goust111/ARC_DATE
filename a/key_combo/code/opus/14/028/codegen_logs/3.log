+def _ray_cells(start: tuple[int, int], direction: str, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = DIR_STEP[direction]
+    r, c = start
+    out: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        out.append((r, c))
+        r += dr
+        c += dc
+    return out
