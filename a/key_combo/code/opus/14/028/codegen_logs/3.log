+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rs0 = max(0, -dr)
+            rs1 = mask.shape[0] - max(0, dr)
+            cs0 = max(0, -dc)
+            cs1 = mask.shape[1] - max(0, dc)
+            out[rs0 + dr : rs1 + dr, cs0 + dc : cs1 + dc] |= mask[rs0:rs1, cs0:cs1]
+    return out
