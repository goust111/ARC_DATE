+    if specs is None:
+        return None
+
+    inp = _place_candidates(base, specs)
+    if inp is None:
+        return None
+
+    out = main(inp)
+    if not _semantic_checks(inp, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for ARC task 3")

