+def _slot_set_fits(slots: list[tuple[str, int, int]], grid_shape: tuple[int, int], sprite_bbox: tuple[int, int, int, int]) -> bool:
+    h, w = grid_shape
+    sr0, sc0, sr1, sc1 = sprite_bbox
