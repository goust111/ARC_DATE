+
+
+def _candidate_marker_slots(sr: int, sc: int, sh: int, sw: int) -> list[tuple[str, int, int]]:
+    mid_r = sr + max(0, sh // 2 - 1)
+    mid_c = sc + max(0, sw // 2 - 1)
+    return [
+        ("nw", sr - 4, sc - 4),
