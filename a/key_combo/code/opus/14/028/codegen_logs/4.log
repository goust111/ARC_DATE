+    sr, sc = sprite_top_left
+    sh, sw = sprite_patch.shape
+    sprite_mask = sprite_patch == GREY
+    out[sr : sr + sh, sc : sc + sw][sprite_mask] = GREY
+    for marker in marker_layout:
