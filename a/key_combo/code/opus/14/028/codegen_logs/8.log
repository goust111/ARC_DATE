+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+DIR_BY_COLOR = {
+    3: (0, -1),   # left
+    4: (1, 0),    # down
+    6: (-1, 0),   # up
+    8: (0, 1),    # right
+}
+DIR_COLORS = tuple(DIR_BY_COLOR)
+TREE_GAP_CHOICES = (1, 2, 3, 4, 5, 6)
+GRID_MIN = 18
+GRID_MAX = 30
+GEN_ATTEMPTS = 500
+MARKER_ATTEMPTS = 400
