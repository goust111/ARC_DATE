+                c0 = max(upper[1] + 1, lower[1] + 1)
+                c1 = min(upper[3] - 1, lower[3] - 1)
+                r0 = upper[2] + 1
+                r1 = lower[0] - 1
+                if c0 <= c1 and r0 <= r1 and np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == BG):
