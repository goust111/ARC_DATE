+def _reachable_passable_component(network: np.ndarray, rects: list[tuple[int, int, int, int]]) -> set[tuple[int, int]]:
+    start = (rects[0][0] + 1, rects[0][1] + 1)
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
