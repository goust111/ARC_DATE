+def _shift_rects(rects: list[tuple[int, int, int, int]]) -> tuple[list[tuple[int, int, int, int]], tuple[int, int]] | None:
+    min_r = min(r0 for r0, _, _, _ in rects)
+    min_c = min(c0 for _, c0, _, _ in rects)
