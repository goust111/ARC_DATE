+        "color": color,
+        "final": final,
+        "path": path,
+        "reason": reason,
+        "rect_idx": rect_idx,
+        "final_rect_idx": final_rect_idx,
+        "uses_corridor": any(cell in corridor_cells for cell in path),
+        "leaves_room": any(not _point_in_rect_interior(cell, rects[rect_idx]) for cell in path),
