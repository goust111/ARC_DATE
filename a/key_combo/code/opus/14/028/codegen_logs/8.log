+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+DIR_BY_COLOR = {
+    3: (0, -1),   # left
+    4: (1, 0),    # down
+    6: (-1, 0),   # up
+    8: (0, 1),    # right
