+                            "a": upper_i,
+                            "b": lower_i,
+                            "gap": r1 - r0 + 1,
+                            "r0": r0,
+                            "r1": r1,
+                            "c0": c0,
+                            "c1": c1,
+                        }
+                    )
+    edges.sort(key=lambda e: (e["gap"], e["kind"], e["r0"], e["c0"], e["a"], e["b"]))
+    return edges
+
+
+def _spanning_edges(edges: list[dict], n_rects: int) -> list[dict]:
+    parent = list(range(n_rects))
+
+    def find(x: int) -> int:
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+
+    def union(a: int, b: int) -> None:
+        ra = find(a)
+        rb = find(b)
+        if ra != rb:
+            parent[rb] = ra
+
