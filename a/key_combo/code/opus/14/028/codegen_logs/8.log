+                    edge_pairs = {(edge["a"], edge["b"]) for edge in temp_edges}
+                    if not {(0, 1), (0, 2), (1, 3), (2, 3)} <= edge_pairs:
+                        continue
+                    if n_rooms == 4:
+                        rects_unshifted = placed4
