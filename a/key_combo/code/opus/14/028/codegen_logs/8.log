+        w = c1 - c0 + 1
+        assert h >= 4 and w >= 4, "expected hollow rectangles"
+
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        frame = np.zeros((h, w), dtype=bool)
+        frame[0, :] = True
+        frame[-1, :] = True
+        frame[:, 0] = True
+        frame[:, -1] = True
