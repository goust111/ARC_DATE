+def _slide_on_grid(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    color: int,
+) -> tuple[tuple[int, int], list[tuple[int, int]], str]:
+    dr, dc = DIR_BY_COLOR[color]
+    r, c = start
+    path: list[tuple[int, int]] = []
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not _in_bounds(grid.shape, nr, nc):
