+
+def _describe_candidate(
+    rects: list[tuple[int, int, int, int]],
+    corridor_cells: set[tuple[int, int]],
+    start: tuple[int, int],
+    color: int,
+    final: tuple[int, int],
+    path: list[tuple[int, int]],
+    reason: str,
