+    shift_r = random.randint(sr_lo, sr_hi)
+    shift_c = random.randint(sc_lo, sc_hi)
+    shifted = [(r0 + shift_r, c0 + shift_c, r1 + shift_r, c1 + shift_c) for r0, c0, r1, c1 in rects]
