+def _rect_clear(rect: tuple[int, int, int, int], others: list[tuple[int, int, int, int]]) -> bool:
+    r0, c0, r1, c1 = rect
+    for or0, oc0, or1, oc1 in others:
+        if not (r1 + 1 < or0 or or1 + 1 < r0 or c1 + 1 < oc0 or oc1 + 1 < c0):
+            return False
+    return True
