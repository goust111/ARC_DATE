+
+    out = list(candidates)
+    random.shuffle(out)
+    return out
+
+
+def _child_candidates_fixed_side(
+    parent_rect: tuple[int, int, int, int],
+    child_size: tuple[int, int],
+    orientation: str,
+    side: int,
+    gap: int,
+    existing: list[tuple[int, int, int, int]],
