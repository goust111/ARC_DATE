+def _slide_markers(
+    network: np.ndarray,
+    markers: list[tuple[int, int, int]],
+    rects: list[tuple[int, int, int, int]],
+) -> tuple[np.ndarray, list[dict]]:
+    out = np.asarray(network, dtype=int).copy()
+    ordered = sorted(markers)
+    for r, c, color in ordered:
+        out[r, c] = color
+
+    details: list[dict] = []
+    for r, c, color in ordered:
+        assert int(out[r, c]) == color
+        out[r, c] = BG
