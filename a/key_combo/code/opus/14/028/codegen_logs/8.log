+def _temp_grid_from_rects(rects: list[tuple[int, int, int, int]]) -> tuple[np.ndarray, list[tuple[int, int, int, int]]]:
+    min_r = min(r0 for r0, _, _, _ in rects)
+    min_c = min(c0 for _, c0, _, _ in rects)
