+                    room4_orientation = random.choice(["h", "v"])
+                    room4_side = random.choice((-1, 1))
+                    room4_parent_idx = random.choice([2, 3])
+                    room4_parent = placed4[room4_parent_idx]
+                    rect4_candidates = _child_candidates_fixed_side(
+                        room4_parent,
