+        inside_markers = []
+        for rr in range(r0 + 1, r1):
+            for cc in range(c0 + 1, c1):
+                v = int(g[rr, cc])
+                assert v == BG or v in DIR_BY_COLOR, "rectangle interiors may only contain background or one marker"
