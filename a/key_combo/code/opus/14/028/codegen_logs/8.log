        def temp_find(x: int) -> int:
            temp_parent.setdefault(x, x)
            while temp_parent[x] != x:
                temp_parent[x] = temp_parent[temp_parent[x]]
                x = temp_parent[x]
            return x

        for edge in eligible:
            ra = find(edge["a"])
            rb = find(edge["b"])
            ta = temp_find(ra)
            tb = temp_find(rb)
            assert ta != tb
            temp_parent[tb] = ta

        for edge in eligible:
            union(edge["a"], edge["b"])
            chosen.append(edge)

        if len(chosen) == n_rects - 1:
            break

    assert len(chosen) == n_rects - 1
    root = find(0)
    assert all(find(i) == root for i in range(n_rects))
    return chosen


def _apply_edge(
    out: np.ndarray,
    bg: int,
    color: int,
    rects: list[tuple[int, int, int, int]],
    edge: dict,
) -> None:
    r0 = edge["r0"]
    r1 = edge["r1"]
    c0 = edge["c0"]
    c1 = edge["c1"]
    if edge["kind"] == "h":
        left = rects[edge["a"]]
        right = rects[edge["b"]]
