+def _apply_edge(
+    out: np.ndarray,
+    rects: list[tuple[int, int, int, int]],
+    edge: dict,
+) -> None:
+    r0 = edge["r0"]
+    r1 = edge["r1"]
+    c0 = edge["c0"]
+    c1 = edge["c1"]
+    if edge["kind"] == "h":
+        left = rects[edge["a"]]
+        right = rects[edge["b"]]
+        out[r0, c0 : c1 + 1] = WALL
+        out[r1, c0 : c1 + 1] = WALL
+        if r0 + 1 <= r1 - 1:
+            out[r0 + 1 : r1, left[3]] = BG
+            out[r0 + 1 : r1, right[1]] = BG
+    else:
+        upper = rects[edge["a"]]
+        lower = rects[edge["b"]]
+        out[r0 : r1 + 1, c0] = WALL
+        out[r0 : r1 + 1, c1] = WALL
+        if c0 + 1 <= c1 - 1:
+            out[upper[2], c0 + 1 : c1] = BG
+            out[lower[0], c0 + 1 : c1] = BG
+
+
+def _build_network(grid: np.ndarray, rects: list[tuple[int, int, int, int]], edges: list[dict]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    out[np.isin(out, DIR_COLORS)] = BG
+    for edge in edges:
+        _apply_edge(out, rects, edge)
+    return out
+
