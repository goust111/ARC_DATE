+                        {
+                            "kind": "h",
+                            "a": left_i,
+                            "b": right_i,
+                            "gap": c1 - c0 + 1,
+                            "r0": r0,
+                            "r1": r1,
+                            "c0": c0,
+                            "c1": c1,
+                        }
+                    )
+
+            if a[2] < b[0] or b[2] < a[0]:
+                if a[2] < b[0]:
+                    upper_i, lower_i, upper, lower = i, j, a, b
+                else:
+                    upper_i, lower_i, upper, lower = j, i, b, a
+                c0 = max(upper[1] + 1, lower[1] + 1)
+                c1 = min(upper[3] - 1, lower[3] - 1)
+                r0 = upper[2] + 1
+                r1 = lower[0] - 1
