+def _edge_passable_cells(edge: dict, rects: list[tuple[int, int, int, int]]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    if edge["kind"] == "h":
+        left = rects[edge["a"]]
+        right = rects[edge["b"]]
+        for r in range(edge["r0"] + 1, edge["r1"]):
+            for c in range(left[3], right[1] + 1):
