+            start_parent = random.randint(pr0 + 1, pr1 - overlap)
+            child_inner_offset = random.randint(0, ci_h - overlap)
+            r0 = start_parent - 1 - child_inner_offset
+            c0 = pc1 + gap + 1 if side > 0 else pc0 - gap - cw
