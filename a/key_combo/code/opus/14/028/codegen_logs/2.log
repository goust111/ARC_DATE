+        variants = _corner_mutation_variants(patch, color, target_area)
+        patch = variants[int(RNG.integers(0, len(variants)))]
+        patch = np.rot90(patch, int(RNG.integers(0, 4)))
+        if int(RNG.integers(0, 2)):
+            patch = np.fliplr(patch)
