+    if max(grid.shape) > 30:
+        return None
+    if not _validate_sample(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to construct a valid sample")

