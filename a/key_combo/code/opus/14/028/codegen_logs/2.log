+from __future__ import annotations
+
+from itertools import combinations
+import numpy as np
+
+
+BG = 0
+SHAPE_COLORS = (1, 2, 3)
+WALL = 5
+MAX_ATTEMPTS = 400
+RNG = np.random.default_rng()
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _find_components(grid: np.ndarray, colors: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _enclosed_bg_count(grid: np.ndarray, comp: dict) -> int:
+    r0, c0, r1, c1 = comp["bbox"]
+    crop = grid[r0 : r1 + 1, c0 : c1 + 1]
+    empty = crop == BG
+    h, w = crop.shape
+    outside = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if empty[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if empty[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and empty[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                stack.append((nr, nc))
+
+    return int(np.count_nonzero(empty & ~outside))
+
+
+def _is_u_container_patch(patch: np.ndarray) -> bool:
+    h, w = patch.shape
+    if h < 3 or w < 3:
+        return False
+    mask = np.zeros_like(patch, dtype=bool)
+    mask[:, 0] = True
+    mask[:, -1] = True
+    mask[-1, :] = True
+    return bool(np.all(patch[mask] == WALL) and np.all(patch[~mask] == BG))
+
+
+def _detect_u_containers(grid: np.ndarray) -> list[dict]:
+    comps = _find_components(grid, {WALL})
+    containers = []
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if _is_u_container_patch(patch):
+            containers.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "width": int(c1 - c0 - 1),
+                }
+            )
+    return containers
