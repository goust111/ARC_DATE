+def _build_shape_patch(target_area: int, color: int) -> tuple[np.ndarray, bool]:
+    candidates = []
+    for h in range(3, 5):
+        for w in range(3, 6):
+            interior = (h - 2) * (w - 2)
+            extra = interior - target_area
+            pixels = 2 * h + 2 * w - 4 + extra
+            if extra >= 0 and 8 <= pixels <= 16:
+                candidates.append((h, w, extra))
+    assert candidates
