+def _build_docked_tool_patch(cavity_h: int, cavity_w: int, side: str, offset: int, body_color: int, anchor_color: int) -> np.ndarray:
+    if side == "top":
+        patch = np.full((cavity_h + 1, cavity_w), BG, dtype=int)
+        patch[1:, :] = int(body_color)
