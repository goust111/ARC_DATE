+BODY_COLORS = (4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+FRAME_SIDES = ("top", "bottom", "left", "right")
+OUTER_SIZE_RANGE = range(4, 9)
