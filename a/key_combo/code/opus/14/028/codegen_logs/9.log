+        for r in rows:
+            for c in cols:
+                positions.append((r, c))
+    elif side == "right":
+        cols = [c for c in (grid_w - frame_w, grid_w - frame_w - 1, grid_w - frame_w - 2) if c >= 0]
+        rows = list(range(0, grid_h - frame_h + 1))
+        for r in rows:
+            for c in cols:
