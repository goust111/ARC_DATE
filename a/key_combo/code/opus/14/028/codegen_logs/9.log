+def _gen_attempt() -> np.ndarray | None:
+    num_pairs = random.choice([2, 3])
+    grid_h = random.randint(18, 24) if num_pairs == 2 else random.randint(21, 28)
+    grid_w = random.randint(18, 24) if num_pairs == 2 else random.randint(21, 28)
