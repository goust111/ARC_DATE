  "type": "move_along_path",
  "src": "singleton top-row marker pixel",
  "path": "vertical drop down the marker column; a closed U-shaped wall container catches the drop when the marker column lies within its horizontal footprint, otherwise the path reaches the bottom edge",
  "dst": "closed U-shaped container interior, or the bottom row if no closed container catches the drop",
  "trajectory": "fill the caught container's background interior with the marker color; if uncaught, fill the whole bottom row",
  "transform": "erase the original marker pixel and keep all wall pixels unchanged"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10x10 [observed]
  background: 0
  colors: marker (singleton, any non-bg color) + wall (one other non-bg color); always 1 and 2 [observed]
  marker:
    count: exactly 1 pixel, on row 0
  wall_structures:
    total_components: 1-3 connected components of wall color
    closed_U: 0 or 1 U-shaped container; two vertical side-bars + continuous bottom segment, empty bg interior
    broken_U: 0-1 incomplete sibling branch; two vertical sides or a side-bar fragment with a bottom segment that has a gap or missing side, so it cannot hold the falling marker
    interior_size: 2-3 rows x 1-5 cols
    distractors: 0-2 extra wall components, preferably U-like broken branches rather than arbitrary shapes
  layout:
    bottom_row: always entirely bg in input
    wall_structures_below_marker: wall top row >= 2 (gap of >=1 empty rows between marker and walls)
    marker_column: avoid placing the falling marker directly above a U side wall; it may be adjacent to a wall column
  rule:
    - erase marker pixel
    - if marker column falls within (left..right inclusive) of the single closed U, fill its interior with marker color
    - if no closed U catches the marker column, fill entire bottom row with marker color
  outcome_mix: ~67% fill-container, ~33% fill-bottom-row

generation_strategy:
  approach: output-first
  steps:
    1. pick grid 10x10, choose bg=0, marker_color, wall_color (two distinct non-bg colors)
    2. decide outcome - fill-container or fill-bottom-row (aim ~60-70% container)
    3. if fill-container - build the closed U first (pick top, bottom, left, right with interior 2-3h x 1-5w); ensure >=2 empty rows above U top for marker row gap; place marker on row 0 at an interior column within (left, right), never directly above a side wall; optionally add 0-1 broken U-like sibling branch that does NOT form another closed U and does NOT enclose the marker column in a second U
    4. if fill-bottom-row - either (a) build a closed U whose horizontal span does NOT include the marker column, or (b) build only a broken U-like branch with a bottom gap or missing side and no closed U at all; place marker on row 0 outside any closed U footprint; ensure bottom row is all bg
    5. verify exactly one singleton marker pixel on row 0, 0 or 1 closed U containers, and bottom row all bg
