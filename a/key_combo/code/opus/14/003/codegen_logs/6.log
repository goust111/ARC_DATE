NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

def _gen_neighbors4(r: int, c: int, h: int, w: int) -> list[Cell]:
    out: list[Cell] = []
    for dr, dc in NEIGHBORS4:
        rr, cc = r + dr, c + dc
        if 0 <= rr < h and 0 <= cc < w:
            out.append((rr, cc))
    return out


def _gen_grow_source(
    seed: set[Cell],
    blocked: set[Cell],
    h: int,
    w: int,
    target_n: int,
) -> set[Cell] | None:
    cells = set(seed)
    while len(cells) < target_n:
        frontier = sorted(
            {
                nbr
                for r, c in cells
                for nbr in _gen_neighbors4(r, c, h, w)
                if nbr not in cells and nbr not in blocked
            }
        )
        if not frontier:
            return None
        cells.add(random.choice(frontier))
    return cells


def _gen_is_connected(cells: set[Cell]) -> bool:
    if not cells:
        return False
    seen = {next(iter(cells))}
    stack = list(seen)
    while stack:
        r, c = stack.pop()
        for dr, dc in NEIGHBORS4:
            nbr = (r + dr, c + dc)
            if nbr in cells and nbr not in seen:
                seen.add(nbr)

