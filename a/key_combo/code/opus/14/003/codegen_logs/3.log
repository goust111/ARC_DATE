+    for dist, color in zip(config["dists"], config["colors"]):
+        if config["corner"] == "nw":
+            pos = (r0 + dist, c0 + dist)
+        elif config["corner"] == "ne":
+            pos = (r0 + dist, c1 - dist)
+        elif config["corner"] == "sw":
+            pos = (r1 - dist, c0 + dist)
+        else:
+            pos = (r1 - dist, c1 - dist)
+        placed.append((pos[0], pos[1], color))
+    return placed
