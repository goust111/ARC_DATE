+            return None
+        if not any(v == 1 for v in info_freq.values()):
+            return None
+        starts = {info["marker_dists"][0] if info["marker_dists"] else 999 for info in infos}
+        if 0 not in starts or not any(d > 0 for d in starts if d != 999):
+            return None
