+        abs_cells = {(tr + int(rr), tc + int(cc)) for rr, cc in transformed}
+        if abs_cells & forbidden:
+            continue
+        for rr, cc in abs_cells:
+            if not (r0 <= rr <= r1 and c0 <= cc <= c1):
