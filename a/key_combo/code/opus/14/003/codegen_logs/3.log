+    "tee4": ((0, 0), (0, 1), (0, 2), (1, 1)),
+    "zig4": ((0, 0), (0, 1), (1, 1), (1, 2)),
+    "plus5": ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+    "p5": ((0, 0), (0, 1), (1, 0), (1, 1), (2, 0)),
