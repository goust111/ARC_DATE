+    if layout_kind == "6v":
+        heights = list(map(int, rng.integers(7, 9, size=3)))
+        widths = list(map(int, rng.integers(7, 10, size=2)))
+        H = sum(heights) + len(heights) + 1
+        W = sum(widths) + len(widths) + 1
+        grid = np.full((H, W), BASE, dtype=int)
