+    max_count = 4 - start
+    count = int(rng.integers(2, max_count + 1))
+    dists = list(range(start, start + count))
+    colors = list(map(int, rng.choice(MARKER_COLORS, size=count, replace=False)))
+    return {"corner": corner, "dists": dists, "colors": colors}
