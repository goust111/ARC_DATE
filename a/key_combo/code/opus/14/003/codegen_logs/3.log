+        marker_cells = _marker_positions(bbox, config)
+        used = set()
+        for r, c, color in marker_cells:
+            if (r, c) in used or grid[r, c] != BASE:
+                return None
+            used.add((r, c))
+            grid[r, c] = color
+        if not _place_sprite(grid, bbox, marker_cells, template_name, rng):
+            return None
+
+    try:
+        infos = _region_infos(grid)
