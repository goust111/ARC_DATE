 128:             path = _ray_path(g, start, DIAGONAL_DIRS[corner], block_color)
 129:             rays.append((start, color, path))
 130: 
 131:     starts_by_color: dict[int, set[tuple[int, int]]] = {}
 132:     path_len: dict[tuple[int, tuple[int, int]], int] = {}
 133:     for start, color, path in rays:
 134:         starts_by_color.setdefault(color, set()).add(start)
 135:         path_len[(color, start)] = len(path)
 136: 
 137:     planned: dict[tuple[int, int], int] = {}
