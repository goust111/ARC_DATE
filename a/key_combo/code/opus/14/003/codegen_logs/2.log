+def _paste_mask(dst: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    h, w = mask.shape
+    dst_slice = dst[r0 : r0 + h, c0 : c0 + w]
+    dst_slice[mask] = int(color)
