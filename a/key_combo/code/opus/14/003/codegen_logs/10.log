+    size = 2 * q + 1
+    grid = np.full((size, size), BG, dtype=int)
+    grid[q, :] = GREY
+    grid[:, q] = GREY
+
+    for rr, cc in np.argwhere(mask):
+        abs_r, abs_c = _absolute_cell(q, 0, rect_r0 + int(rr), rect_c0 + int(cc))
+        grid[abs_r, abs_c] = RED
