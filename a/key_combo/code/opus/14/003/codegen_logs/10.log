+    assert 5 <= len(source) <= 10, "upper-left red mask size must be 5..10"
+    for r, c in source:
+        rr = int(r)
+        cc = int(c)
+        out[rr, cc] = GREY
+        out[rr, 2 * mid - cc] = GREY
+        out[2 * mid - rr, cc] = GREY
+        out[2 * mid - rr, 2 * mid - cc] = GREY
+    return out
