+    nonmask_cells = [(r, c) for r in range(rect_h) for c in range(rect_w) if not mask[r, c]]
+    interior_nonmask = [(r, c) for r, c in nonmask_cells if 0 < r < rect_h - 1 and 0 < c < rect_w - 1]
+    if not interior_nonmask:
