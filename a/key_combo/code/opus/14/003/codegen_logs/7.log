+    filled: dict[tuple[int, int], set[int]] = defaultdict(set)
+    for color, cells in markers_by_color.items():
+        by_row: dict[int, list[int]] = defaultdict(list)
+        by_col: dict[int, list[int]] = defaultdict(list)
+        for rr, cc in cells:
