+        shape_h = max(r for r, _ in shape) + 1
+        shape_w = max(c for _, c in shape) + 1
+        off_r = random.randint(0, cell_h - shape_h)
+        off_c = random.randint(0, cell_w - shape_w)
+        cell_r0, _ = row_ranges[rr]
+        cell_c0, _ = col_ranges[cc]
