+    def cell_center(rr: int, cc: int) -> tuple[int, int]:
+        r0, r1 = row_ranges[rr]
+        c0, c1 = col_ranges[cc]
+        return r0 + (r1 - r0) // 2, c0 + (c1 - c0) // 2
+
+    for rr, cc in red_cells:
+        r, c = cell_center(rr, cc)
+        g[r, c] = RED
+    for rr, cc in green_cells:
+        r, c = cell_center(rr, cc)
+        g[r, c] = GREEN
+
+    for (rr, cc), base_shape in sprite_plan:
