+
+def _coarse_layout(n_rows: int, n_cols: int):
+    y0 = random.randint(1, n_rows - 2)
+    x_left = 1
+    x_right = n_cols - 2
+
+    red = {
+        (y0, 0),
+        (y0, x_left),
+        (y0 - 1, x_right),
+        (y0 + 1, x_right),
+    }
+    green = {
