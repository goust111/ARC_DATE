+def _cell_ranges(length: int, wall_indices: list[int]) -> list[tuple[int, int]]:
+    bounds = [-1, *sorted(int(x) for x in wall_indices), int(length)]
+    ranges: list[tuple[int, int]] = []
+    for a, b in zip(bounds, bounds[1:]):
+        if a + 1 <= b - 1:
+            ranges.append((a + 1, b - 1))
