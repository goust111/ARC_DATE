+    variants: list[tuple[bytes, tuple[int, int]]] = []
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for candidate in (rot, np.fliplr(rot)):
+            variants.append((candidate.tobytes(), tuple(map(int, candidate.shape))))
+    return min(variants)
