+def _find_teal_lattice(g: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = g.shape
+    wall_rows = [r for r in range(h) if np.all(g[r, :] == TEAL)]
+    wall_cols = [c for c in range(w) if np.all(g[:, c] == TEAL)]
