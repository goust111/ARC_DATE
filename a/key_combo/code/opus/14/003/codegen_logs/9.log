+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(13, 18)
+    width = random.randint(13, 18)
+    grid = np.full((height, width), BACKGROUND, dtype=int)
+    grid[0, :] = FRAME
+    grid[-1, :] = FRAME
+    grid[:, 0] = FRAME
+    grid[:, -1] = FRAME
