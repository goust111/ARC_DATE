+    assignments: dict[tuple[int, int], int] = {}
+    for arrow in arrow_components:
+        blocked = False
+        r, c = arrow["tip"]
+        dr, dc = DIRS[arrow["direction"]]
+        while True:
+            r += dr
+            c += dc
+            if r <= 0 or r >= height - 1 or c <= 0 or c >= width - 1:
+                hit = (r, c)
