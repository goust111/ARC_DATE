+        max_r0 = height - 5 - min_forward
+        if max_r0 < 1:
+            return None
+        r0 = random.randint(1, max_r0)
+        c0 = random.randint(1, width - 4)
+    else:
+        assert direction == "up"
+        min_r0 = 1 + min_forward
+        max_r0 = height - 5
