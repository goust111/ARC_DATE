+        | (np.indices(grid.shape)[0] == grid.shape[0] - 1)
+        | (np.indices(grid.shape)[1] == 0)
+        | (np.indices(grid.shape)[1] == grid.shape[1] - 1)
+    ))
+    if changed_border.shape[0] < 2:
+        return None
+    return grid
+
