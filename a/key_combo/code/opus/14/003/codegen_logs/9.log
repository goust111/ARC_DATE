+        c0 = random.randint(1, max_c0)
+    elif direction == "left":
+        min_c0 = 1 + min_forward
+        max_c0 = width - 5
+        if min_c0 > max_c0:
+            return None
+        r0 = random.randint(1, height - 4)
+        c0 = random.randint(min_c0, max_c0)
