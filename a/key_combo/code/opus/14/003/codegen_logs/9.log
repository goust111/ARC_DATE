+def _candidate_arrow(direction: str, shape: tuple[int, int], min_forward: int) -> dict | None:
+    height, width = shape
+    if direction == "right":
+        max_c0 = width - 5 - min_forward
+        if max_c0 < 1:
+            return None
+        r0 = random.randint(1, height - 4)
+        c0 = random.randint(1, max_c0)
+    elif direction == "left":
+        min_c0 = 1 + min_forward
+        max_c0 = width - 5
+        if min_c0 > max_c0:
