+        for r in range(tip_r + 1, state.shape[0] - 1):
+            if state[r, col] == MAROON:
+                positions.append((r, col))
+        positions.sort(key=lambda pos: pos[0], reverse=True)
+    else:
+        col = tip_c
+        for r in range(1, tip_r):
