+def _opposite_border(arrow: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    height, width = shape
+    r, c = arrow["tip"]
+    if arrow["direction"] == "right":
+        return r, 0
+    if arrow["direction"] == "left":
+        return r, width - 1
+    if arrow["direction"] == "down":
+        return 0, c
+    return height - 1, c
+
+
+def _border_hit(arrow: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    height, width = shape
+    r, c = arrow["tip"]
+    if arrow["direction"] == "right":
