+            return False
+        if _opposite_border(candidate, shape) in {_border_hit(other, shape), _opposite_border(other, shape)}:
+            return False
+        other_cells = {tuple(pos) for pos in other["coords"]}
+        cand_cells = {tuple(pos) for pos in candidate["coords"]}
