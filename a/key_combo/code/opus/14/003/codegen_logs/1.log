+    h, w = grid.shape
+    out = np.full((h, w), bg, dtype=int)
+    out[-1, :] = baseline
+    for c in range(w):
+        falling = [int(grid[r, c]) for r in range(h) if int(grid[r, c]) not in (bg, baseline)]
