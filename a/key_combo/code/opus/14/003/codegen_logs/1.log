+        return [extra]
+    bins = [0] * count
+    for _ in range(extra):
+        bins[random.randrange(count)] += 1
+    return bins
+
+
+def _layout_segments(width: int, segments: list[dict]) -> tuple[list[list[int]], list[tuple[int, dict]]] | None:
