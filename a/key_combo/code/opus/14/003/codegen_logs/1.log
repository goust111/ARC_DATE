+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+GEN_HEIGHT_RANGE = (10, 15)
+GEN_WIDTH_RANGE = (10, 15)
