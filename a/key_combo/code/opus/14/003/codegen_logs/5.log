+def _adjacent_with_color(panel: np.ndarray, cell: tuple[int, int], color: int) -> list[tuple[int, int]]:
+    return [
+        (rr, cc)
+        for rr, cc in _neighbors4(cell[0], cell[1], panel.shape)
+        if int(panel[rr, cc]) == int(color)
+    ]
