+def _process_panel(panel: np.ndarray) -> tuple[np.ndarray, int]:
+    out = np.asarray(panel, dtype=int).copy()
+    pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    used_reds: set[tuple[int, int]] = set()
+    used_greens: set[tuple[int, int]] = set()
