+def _overlay_processed_panels(panels: list[np.ndarray], counts: list[int]) -> tuple[np.ndarray, np.ndarray]:
+    height, width = panels[0].shape
+    out = np.zeros((height, width), dtype=int)
+    winners = np.full((height, width), -1, dtype=int)
