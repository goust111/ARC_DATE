+def _marker_origins(patch: np.ndarray) -> list[tuple[int, int]]:
+    H, W = patch.shape
+    out = []
+    for r in range(H - 1):
+        for c in range(W - 1):
+            block = patch[r : r + 2, c : c + 2]
+            if not np.all(block):
+                continue
