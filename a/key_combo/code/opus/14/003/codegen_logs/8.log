+    r1, c1 = shape_coords.max(axis=0)
+    patch = local_shape[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+    ph, pw = patch.shape
+
+    if pw >= W or ph >= H:
+        return None
+    if H - ph < 2:
+        return None
+
+    top = random.randint(1, H - ph - 1)
