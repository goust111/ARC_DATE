        marker = candidates[0]
        used_marker_bboxes.add(tuple(map(int, marker["bbox"])))
        out[obj["coords"][:, 0], obj["coords"][:, 1]] = _color_for_marker(g, marker, bg)

    assert len(used_marker_bboxes) == len(markers), "all markers must be assigned"
    return out

