+BACKGROUND = int(Color.BLACK)
+BASELINE = int(Color.BLUE)
+SOURCE_COLOR = int(Color.GREEN)
+MIRROR_COLOR = int(Color.RED)
+COLLISION_COLOR = int(Color.YELLOW)
