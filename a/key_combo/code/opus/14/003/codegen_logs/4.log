  colors: exactly 2 non-bg colors — object_color (blue/1) and marker_color (orange/7)
  num_groups: 1-4 marker+object pairs
  marker:
    shape: 2x2 L-triomino (3 cells of a 2x2 box, one corner missing)
    all 4 orientations must be representable; missing corner encodes output color
    color_map: top-left missing -> green(3), bottom-left -> yellow(4), bottom-right -> pink(6), top-right -> teal(8)
  object:
    connectivity: 8-connected (must have diagonal-only joins, so 4-connected component count > 8-connected count)
