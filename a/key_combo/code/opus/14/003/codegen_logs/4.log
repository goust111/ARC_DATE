+    bboxes = []
+    for obj in objects:
+        patch = obj["patch"]
+        r0 = obj["green_top"]
+        c0 = obj["green_left"]
+        h, w = patch.shape
+        if r0 < 0 or c0 < 0 or r0 + h > height - 1 or c0 + w > width:
+            return None
+        bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+        if bbox[2] >= height - 1:
+            return None
+        for other_bbox in bboxes:
+            if not _bbox_separated(bbox, other_bbox, INPUT_GAP):
+                return None
+        patch_mask = patch == SOURCE_COLOR
+        target = grid[r0 : r0 + h, c0 : c0 + w]
