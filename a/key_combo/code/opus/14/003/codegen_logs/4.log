+    if bbox is None:
+        return False
+    r0, c0, r1, c1 = bbox
+    if r1 >= height - 1 or c1 >= width:
+        return False
+    for other_bbox in placed_bboxes:
+        if not _bbox_separated(bbox, other_bbox, INPUT_GAP):
+            return False
+    return True
+
