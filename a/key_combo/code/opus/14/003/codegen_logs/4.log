def _interval_adjacent(a_left: int, a_width: int, b_left: int, b_width: int) -> bool:
    return a_left + a_width == b_left or b_left + b_width == a_left


def _random_pair_red_positions(width: int, info_a: dict, info_b: dict) -> tuple[int, int] | None:
    wa = int(info_a["shape"][1])
