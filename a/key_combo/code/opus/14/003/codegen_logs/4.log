+GRID_ROWS = (14, 18)
+GRID_COLS = (17, 22)
+OBJECT_COUNTS = (3, 4)
+FRAME_OPTIONS = ((3, 3), (3, 4), (4, 3), (4, 4))
+ALL_SIDES = ("left", "right", "top", "bottom")
+INPUT_GAP = 2
+MAX_ATTEMPTS = 500
