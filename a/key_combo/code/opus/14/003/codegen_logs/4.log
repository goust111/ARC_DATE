+
+def _analyze(grid: np.ndarray, *, with_details: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    height, width = g.shape
+
+    bg = int(get_bg(g))
+    baseline_row = g[height - 1, :]
