+                obj["red_left"] = random.randint(1, max_left)
+                obj["green_top"], obj["green_left"] = _green_from_red(
+                    int(obj["red_top"]),
+                    int(obj["red_left"]),
+                    obj["patch"],
+                    obj["side"],
+                )
+                if not _fits_green(obj, shape, placed_bboxes):
+                    continue
+                placed_bboxes.append(_green_bbox_for(obj))
+                placed = True
+                break
+            if not placed:
+                ok = False
