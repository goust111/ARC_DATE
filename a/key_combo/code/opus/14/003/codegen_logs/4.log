+        ordered = sorted(column_entries[col], key=lambda item: item[0])
+        count = len(ordered)
+        for idx, (_row, source_id) in enumerate(ordered):
+            dest_row = height - count + idx
+            settled_by_source[source_id].append((dest_row, col))
