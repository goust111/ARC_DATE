+def _boundary_cells(coords: list[tuple[int, int]], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = direction
+    if dr == 1:
+        edge = min(r for r, _ in coords)
+        return [(r, c) for r, c in coords if r == edge]
+    if dr == -1:
