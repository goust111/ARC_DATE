+    g = np.asarray(grid, dtype=int)
+    objects = _analyze_objects(g)
+    out = np.full_like(g, BG)
+
+    for obj in objects:
+        for r, c in _ring_pixels(obj["center"], obj["layers"], g.shape):
+            out[r, c] = obj["color"]
+
+    for obj in objects:
+        for r, c in obj["moved_coords"]:
+            out[r, c] = obj["color"]
+
+    return out
