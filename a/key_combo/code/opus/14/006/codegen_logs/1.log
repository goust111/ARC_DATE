+    for obj in objects:
+        assert obj["marker"] is not None and obj["direction"] is not None
+        dr, dc = obj["direction"]
+        dist = _slide_distance(obj["coords"], (dr, dc), (h, w))
+        obj["distance"] = dist
+        obj["layers"] = dist // 2
+        obj["moved_coords"] = [(r + dr * dist, c + dc * dist) for r, c in obj["coords"]]
