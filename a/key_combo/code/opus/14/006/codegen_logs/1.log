+def _normalize(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = sorted((r - r0, c - c0) for r, c in coords)
+    assert _bbox(out) == (0, 0, r1 - r0, c1 - c0)
+    return out
