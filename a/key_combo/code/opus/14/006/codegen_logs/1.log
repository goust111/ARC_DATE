+        return [(r, c) for r, c in coords if r == edge]
+    if dc == 1:
+        edge = min(c for _, c in coords)
+        return [(r, c) for r, c in coords if c == edge]
+    edge = max(c for _, c in coords)
+    return [(r, c) for r, c in coords if c == edge]
