+    seen: set[tuple[int, int]] = set()
+
+    def add(r: int, c: int) -> None:
+        if (r, c) not in seen:
+            picks.append((r, c))
+            seen.add((r, c))
+
+    if preferred_center is not None:
+        base_r = preferred_center[0] - center_offset[0]
+        base_c = preferred_center[1] - center_offset[1]
+        for _ in range(18):
