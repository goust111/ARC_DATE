+def _compute_output_and_info(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seeds = _find_seeds(g)
+    seed_pos = {(r, c) for r, c, _color in seeds}
+    arrivals: dict[tuple[int, int], list[tuple[int, int, int, int]]] = {}
+
