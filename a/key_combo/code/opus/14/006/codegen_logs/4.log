+    if info["multi_count"] < 2:
+        return False
+    if mode == "distinct":
+        return bool(info["unique_shortest_multi"])
+    if mode == "row_priority":
+        return bool(info["row_priority_tie"])
+    return bool(info["col_priority_tie"])
