+    dc = abs(cells[0][1] - cells[1][1])
+    if (dr, dc) not in {(1, 0), (0, 1)}:
+        return False
+    seed_set = set(seeds)
+    if any(cell in seed_set for cell in cells):
+        return False
+    if any(not _seed_clear_of_bar(seed, cells) for seed in seeds):
+        return False
+    occupied = set()
+    for other in existing:
+        occupied.update(other)
