+    comps: list[list[tuple[int, int]]] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != 5 or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            comp: list[tuple[int, int]] = []
+            seen.add((r, c))
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds((h, w), nr, nc) and grid[nr, nc] == 5 and (nr, nc) not in seen:
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+            comps.append(comp)
+    if len(comps) not in {2, 3}:
+        return False
+    for comp in comps:
+        if len(comp) != 2:
+            return False
+        dr = abs(comp[0][0] - comp[1][0])
+        dc = abs(comp[0][1] - comp[1][1])
+        if (dr, dc) not in {(1, 0), (0, 1)}:
+            return False
+    return True
