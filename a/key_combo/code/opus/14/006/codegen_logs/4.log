+    mode = random.choices(
+        ["distinct", "row_priority", "col_priority"],
+        weights=[4, 3, 3],
+        k=1,
+    )[0]
+
+    if mode == "distinct":
+        pts = _sample_distinct_positions(h, w)
+    elif mode == "row_priority":
+        pts = _sample_row_priority_positions(h, w)
+    else:
+        pts = _sample_col_priority_positions(h, w)
+    if pts is None:
+        return None
+
