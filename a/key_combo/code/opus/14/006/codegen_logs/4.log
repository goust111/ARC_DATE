+def _find_seeds(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    pts = np.argwhere((grid != 0) & (grid != 5))
+    seeds = [(int(r), int(c), int(grid[r, c])) for r, c in pts]
+    seeds.sort(key=lambda item: (item[0], item[1], item[2]))
+    return seeds
+
