+    target_count = random.choice([2, 3])
+    random.shuffle(all_candidates)
+
+    chosen: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    current_grid = base_grid.copy()
+    current_info = base_info
+    changed = False
+
+    for idx in range(target_count):
+        found = False
