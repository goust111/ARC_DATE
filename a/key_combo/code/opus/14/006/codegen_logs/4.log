+        if min(abs(a[0] - b[0]) + abs(a[1] - b[1]) for i, a in enumerate(pts) for b in pts[i + 1 :]) < 4:
+            continue
+        return pts
+    return None
+
+
+def _sample_col_priority_positions(h: int, w: int) -> list[tuple[int, int]] | None:
+    if h < 11 or w < 11:
