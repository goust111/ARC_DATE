+        far = random.randint(d + 1, max_far)
+        c3 = c + side * far
+        if not (2 <= c3 <= w - 3):
+            continue
+        pts = [(r1, c), (r2, c), (rmid, c3)]
+        if min(abs(a[0] - b[0]) + abs(a[1] - b[1]) for i, a in enumerate(pts) for b in pts[i + 1 :]) < 4:
