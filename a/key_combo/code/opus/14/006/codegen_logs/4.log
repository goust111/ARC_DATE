+    for (r, c), claims in arrivals.items():
+        if len(claims) > 1:
+            multi_cells.append((r, c))
+        claims_sorted = sorted(claims, key=lambda item: (item[0], item[1], item[2]))
+        min_dist = claims_sorted[0][0]
