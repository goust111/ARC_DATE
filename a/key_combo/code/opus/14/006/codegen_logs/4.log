+        rmid = random.randint(2 + d, h - 3 - d)
+        r1, r2 = rmid - d, rmid + d
+        side = random.choice([-1, 1])
+        far = random.randint(d + 1, min(4, w - 3 if side == 1 else c - 2))
+        c3 = c + side * far
+        if not (2 <= c3 <= w - 3):
