+    bars: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    for r, c in arrivals:
+        for bar in [
+            ((r, c), (r + 1, c)),
+            ((r - 1, c), (r, c)),
+            ((r, c), (r, c + 1)),
+            ((r, c - 1), (r, c)),
+        ]:
+            ordered = tuple(sorted(bar))
+            if _bar_is_valid(shape, seeds, ordered, []):
+                bars.add(ordered)
+    result = list(bars)
+    random.shuffle(result)
+    return result
