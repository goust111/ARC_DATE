+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SPRITE_COLOR = 1
+MARKER_ORDER = (2, 3, 4)
+MARKER_RANK = {color: idx for idx, color in enumerate(MARKER_ORDER)}
+DIAGONAL_TO_ROT_K = {
+    (-1, 1): 0,   # NE -> 0 deg
+    (1, 1): 3,    # SE -> 90 deg clockwise
+    (1, -1): 2,   # SW -> 180 deg
+    (-1, -1): 1,  # NW -> 270 deg clockwise
