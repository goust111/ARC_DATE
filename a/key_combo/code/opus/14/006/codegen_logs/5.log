import numpy as np

from arc_utils import Color, colors_present, get_bg


def _paint_dash_gap(out: np.ndarray, fixed: int, start: int, end: int, axis: str) -> None:
    assert start <= end
    assert axis in {"h", "v"}
    n = end - start + 1
    for i, pos in enumerate(range(start, end + 1)):
        if min(i, n - 1 - i) % 2 == 0:
            if axis == "h":
                out[fixed, pos] = Color.GREY
            else:
