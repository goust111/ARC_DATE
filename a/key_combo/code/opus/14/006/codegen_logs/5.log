+    for color in MARKER_ORDER:
+        coords = np.argwhere(g == color)
+        assert len(coords) == 1
+        marker_positions[color] = tuple(map(int, coords[0]))
+
+    sprite_mask = (g != BG) & ~np.isin(g, MARKER_ORDER)
+    components = _components(sprite_mask)
+    assert len(components) == 3
+
