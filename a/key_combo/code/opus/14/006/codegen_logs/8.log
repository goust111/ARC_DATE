+    min_h = max(8, side + 2)
+    max_h = max(min_h, side + 7)
+    min_w = max(8, side + 2)
+    max_w = max(min_w, side + 7)
+    return random.randint(min_h, max_h), random.randint(min_w, max_w)
+
+
+def _oracle_checks(grid: np.ndarray, copy_count: int, blue_count: int) -> bool:
