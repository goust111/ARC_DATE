+def ring_overlap_count(seed: tuple[int, int], cells: list[tuple[int, int]], layers: int) -> int:
+    sr, sc = seed
+    overlap = 0
+    for r, c in cells:
+        dist = max(abs(r - sr), abs(c - sc))
+        if 1 <= dist <= layers:
