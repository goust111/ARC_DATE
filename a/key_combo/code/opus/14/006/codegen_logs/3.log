spec:
  grid: 10x10 [observed]
  background: GREY (5), fills ~72-75% of cells
  foreground: only BLACK (0) in input; only GREEN/RED/BLUE in output
  components:
    definition: 4-connected components of black cells
    count: 15-16 total
    size_1: 6-8 single-pixel components -> recolored GREEN in output
    size_2: 5-6 domino components (horizontal or vertical) -> recolored RED in output
    size_3: 2-4 triomino components (any 4-connected shape) -> recolored BLUE in output
    allowed_sizes: exactly {1, 2, 3}; no other sizes
    total_black_pixels: 25-28
