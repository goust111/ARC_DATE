  "dst": "plug into base sprite d in top-left corner with a connector",
  "match_cond": "s.connector.color/shape == d.connector.color/shape and s.connector above d.connector",
  "type2": "transform_in_place",
  "src2": "s.connector and d.connector",
  "transform2": "recolor connector pixels to body color",
  "grid_shape": "expand if needed then tight crop"
}
</annotation>
<generation_spec>
```yaml
spec:
  colors:
    fixed: bg=1, obj=4, ctrl=7
    output: only bg + obj (ctrl recolored to obj)
  grid:
    input: 7-11 rows x 3-13 cols
    output: 5-8 rows x 3-12 cols (tight crop of merged result)
  sprites:
    count: 2 main 8-connected foreground components (obj+ctrl);
      0-2 tiny (<4 px) detached obj fragments assigned to nearest sprite
    structure: thin-walled shape made of obj pixels enclosing 0-27 bg holes;
      not strictly single-pixel-wide everywhere [observed]
    bbox: 2-7 rows x 3-10 cols, 5-29 pixels per sprite
    body_components: obj-only pixels form 1-2 8-connected components;
      ctrl pixels may bridge disjoint obj parts
  connector:
    shape: horizontal bar of 1-3 ctrl pixels, all on a single row
    count: exactly 1 connector per sprite (2 total)
    matching: both connectors identical in normalized shape (same length)
    vertical_adjacency: |
      each ctrl pixel has an obj pixel directly above (base) or below (plug);
      the opposite side (below for base, above for plug) has no body pixel
    cols: connector columns lie within the sprite body's column range
  roles:
    base: sprite whose bbox top-left satisfies r+c == 0 (grid origin)
    plug: the other sprite; Manhattan gap 1-5 from base bbox
  transformation: |
    translate plug so its connector row sits 1 row above base connector (same cols);
    stamp plug onto base; overlap zone = 2 x conn_length pixels where ctrl meets obj;
    base and plug sprites are joined at a horizontal seam where their boundaries may interlock (concavities in one fit into convexities of the other);
    plug must not extend above or left of base (base stays at output top-left after crop);
    recolor all ctrl to obj; tight-crop to non-bg bounding box.

generation_strategy:
  approach: output-first (build assembled state, then separate)
  steps:
    - Colors fixed: bg=1, obj=4, ctrl=7
    - Build base sprite body (thin-walled, 8-connected, grow then thin interior pixels)
    - Choose connector length 1-3; place connector (ctrl bar) on base at a valid
      row (can be edge or interior — needs obj on body side above, free side below)
    - Grow plug sprite body from connector downward, avoiding overlap with base body;
      thin plug interior for wall-thickness ~1
    - Record assembled state (base + plug docked) as expected output
    - Detach plug; crop both sprites to tight bbox
    - Place base at grid origin (r+c=0) on bg canvas 7-11 x 3-13;
      place plug elsewhere with gap 1-5
    - Oracle-verify: main(input) == expected output
  constraints:
    - connectors must match in normalized shape (same length)
    - base connector free side faces down; plug free side faces up
    - overlap during docking only at connector zone (ctrl vs obj)
    - plug must not extend above or left of base
