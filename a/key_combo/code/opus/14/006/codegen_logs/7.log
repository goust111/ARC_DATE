+        c_lo, c_hi = 1, max(1, W // 3 - w)
+        r_lo, r_hi = 1, H - h - 2
+    elif direction == "left":
+        c_lo, c_hi = max(1, 2 * W // 3 - w), W - w - 2
+        r_lo, r_hi = 1, H - h - 2
+    elif direction == "down":
+        r_lo, r_hi = 1, max(1, H // 3 - h)
+        c_lo, c_hi = 1, W - w - 2
+    else:
+        r_lo, r_hi = max(1, 2 * H // 3 - h), H - h - 2
+        c_lo, c_hi = 1, W - w - 2
+
+    if r_lo > r_hi or c_lo > c_hi:
+        return False
+    r0 = random.randint(r_lo, r_hi)
+    c0 = random.randint(c_lo, c_hi)
