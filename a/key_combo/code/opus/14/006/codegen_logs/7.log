+    if direction == (0, -1):
+        return r0 < tip[0] < r1 and c1 < tip[1]
+    if direction == (1, 0):
+        return c0 < tip[1] < c1 and r0 > tip[0]
+    return c0 < tip[1] < c1 and r1 < tip[0]
