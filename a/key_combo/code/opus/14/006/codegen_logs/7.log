+    patch[sprite != BLACK] = sprite[sprite != BLACK]
+    return True
+
+
+def _draw_frame(grid: np.ndarray, r0: int, c0: int, inner_h: int, inner_w: int) -> dict:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    r1 = r0 + outer_h - 1
+    c1 = c0 + outer_w - 1
