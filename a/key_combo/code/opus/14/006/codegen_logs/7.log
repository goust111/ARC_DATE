        inp[inp == GEN_FILL] = GEN_BG
        if not np.array_equal(main(inp), expected):
            return None
        return inp
    except Exception:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
