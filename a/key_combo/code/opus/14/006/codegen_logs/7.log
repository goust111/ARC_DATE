+            continue
+        want = {(r, c0) for r in range(r0, r1 + 1)}
+        want |= {(r, c1) for r in range(r0, r1 + 1)}
+        want |= {(r0, c) for c in range(c0, c1 + 1)}
+        want |= {(r1, c) for c in range(c0, c1 + 1)}
+        if set(comp) != want:
