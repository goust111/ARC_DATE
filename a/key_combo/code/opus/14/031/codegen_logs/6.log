+    return cell
+
+
+def _render_expected(
+    grid: np.ndarray,
+    n: int,
+    cell_side: int,
+    reachable_cells: set[Cell],
+    source_color: int,
+) -> np.ndarray:
+    row_bands = [(r * (cell_side + 1), r * (cell_side + 1) + cell_side) for r in range(n)]
