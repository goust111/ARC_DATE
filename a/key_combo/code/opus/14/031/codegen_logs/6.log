+    all_fg_colors = set()
+    for br, bc in _all_cells(n):
+        r0, c0 = _cell_origin((br, bc), cell_side)
+        inp_cell = grid[r0 : r0 + cell_side, c0 : c0 + cell_side]
+        out_cell = expected[r0 : r0 + cell_side, c0 : c0 + cell_side]
+        fg_colors = _cell_foreground_colors(inp_cell)
