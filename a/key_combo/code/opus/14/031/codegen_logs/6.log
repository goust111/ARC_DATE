+            fg_colors = _cell_foreground_colors(grid[r0 : r0 + cell_side, c0 : c0 + cell_side])
+            if not fg_colors:
+                return None
+            if len(fg_colors) == 1:
+                hits.append(((br, bc), next(iter(fg_colors))))
+    if len(hits) != 1:
+        return None
+    return hits[0]
+
+
+def _infer_open_edges(grid: np.ndarray, n: int, cell_side: int) -> set[Edge]:
+    edges: set[Edge] = set()
+    for br in range(n):
+        for bc in range(n - 1):
