+
+
+BG = 0
+LINE = 1
+NOISE_COLORS = (2, 3, 4, 5)
+
+N_RANGE = (3, 5)
+CELL_SIDE_RANGE = (3, 4)
+FG_COUNT_MIN = 2
+FG_COUNT_MAX = 4
+EXTRA_REACHABLE_EDGE_PROB = 0.35
+EXTRA_UNREACHABLE_EDGE_PROB = 0.22
+MAX_GENERATION_ATTEMPTS = 400
+
+
+Cell = tuple[int, int]
+Edge = tuple[Cell, Cell]
+
+
+def _normalize_edge(a: Cell, b: Cell) -> Edge:
+    return (a, b) if a <= b else (b, a)
