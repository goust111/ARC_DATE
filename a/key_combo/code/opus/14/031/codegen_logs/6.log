+def _build_graph(
+    grid: np.ndarray, row_bands: list[tuple[int, int]], col_bands: list[tuple[int, int]]
+) -> dict[Cell, set[Cell]]:
+    n_rows = len(row_bands)
+    n_cols = len(col_bands)
+    graph = {(r, c): set() for r in range(n_rows) for c in range(n_cols)}
