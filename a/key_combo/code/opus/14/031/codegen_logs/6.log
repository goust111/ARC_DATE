+    source_color = int(NOISE_COLORS[int(rng.integers(0, len(NOISE_COLORS)))])
+    grid = _blank_partitioned_grid(n, cell_side)
+    for edge in open_edges:
+        _carve_gap(grid, edge, cell_side, rng)
