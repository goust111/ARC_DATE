+        cell_side=cell_side,
+        source=source,
+        source_color=source_color,
+        open_edges=open_edges,
+        reachable_cells=reachable_cells,
+    ):
+        return None
+
+    try:
+        solved = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
