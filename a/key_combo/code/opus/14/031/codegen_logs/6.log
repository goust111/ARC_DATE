+    unreachable_set = set(unreachable_cells)
+    for edge in _all_lattice_edges(n):
+        if edge in open_edges:
+            continue
+        a, b = edge
+        if a in unreachable_set and b in unreachable_set and rng.random() < EXTRA_UNREACHABLE_EDGE_PROB:
