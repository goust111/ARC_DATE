    if not (
        TEMPLATE_HEIGHT_RANGE[0] <= th <= TEMPLATE_HEIGHT_RANGE[1]
        and TEMPLATE_WIDTH_RANGE[0] <= tw <= TEMPLATE_WIDTH_RANGE[1]
        and TEMPLATE_AREA_RANGE[0] <= np.count_nonzero(template) <= TEMPLATE_AREA_RANGE[1]
    ):
