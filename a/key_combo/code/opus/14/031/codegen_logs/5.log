+    copies = _find_copy_origins(g, sep_col, template, template_origin)
+    assert 2 <= len(copies) <= 3, "expected 2-3 incomplete copies"
+
+    out = g.copy()
+    for r0, c0 in copies:
+        for dr in range(3):
