        g[r,:l+1]=3
        g[r,v:]=3

def closed_regions(arr):
    H,W=arr.shape
    blocked=arr==3
    seen=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if not blocked[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if not blocked[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and not blocked[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; q.append((nr,nc))
    regions=[]
    for r in range(H):
        for c in range(W):
            if blocked[r,c] or seen[r,c]: continue
            reg=[]; seen[r,c]=1; q.append((r,c))
            while q:
                rr,cc=q.popleft(); reg.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and not blocked[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; q.append((nr,nc))
            regions.append(reg)
    return regions

def solve(inp):
    out=np.tile(inp,(2,2)).copy()
    H,W=out.shape
