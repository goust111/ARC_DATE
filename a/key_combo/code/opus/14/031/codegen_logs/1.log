+
+    inp = expected.copy()
+    for r, c in polluted:
+        inp[r, c] = ORANGE
+
+    if not _semantic_ok(inp, expected, polluted):
+        return None
+    SEEN_OUTPUT_SIGNATURES.add(out_sig)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
