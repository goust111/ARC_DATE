def _gen_attempt() -> np.ndarray | None:
    """Single attempt: build output-first, derive input, validate with oracle."""
    H = int(_RNG.integers(*GRID_H_RANGE))
    W = int(_RNG.integers(*GRID_W_RANGE))
    bg = int(_RNG.integers(0, NUM_COLORS))

