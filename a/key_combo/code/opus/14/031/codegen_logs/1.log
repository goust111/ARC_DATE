+def _axis_orbit(r: int, c: int, row_axis: int, col_axis: int) -> tuple[tuple[int, int], ...]:
+    pts = {
+        (r, c),
+        (row_axis - r, c),
+        (r, col_axis - c),
+        (row_axis - r, col_axis - c),
+    }
