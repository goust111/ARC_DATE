+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 400
+SEEN_OUTPUT_SIGNATURES: set[tuple[tuple[int, int], bytes]] = set()
