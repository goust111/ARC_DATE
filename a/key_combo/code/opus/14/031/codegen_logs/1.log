+def _best_axis_sum(grid: np.ndarray, *, along_rows: bool) -> int:
+    limit = grid.shape[0] if along_rows else grid.shape[1]
+    candidates: list[tuple[int, int]] = []
+    for axis_sum in range(2 * limit - 1):
