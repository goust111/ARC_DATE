+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+SEED_STRIDE = 4
+GEN_ATTEMPTS = 500
+GEN_SIZE_RANGE = (15, 22)
+GEN_OBSTACLE_COUNT_RANGE = (3, 5)
