+    h, w = grid.shape
+    q = deque([(0, 0)])
+    seen = {(0, 0)}
+    coords: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        if int(grid[r, c]) != GREEN:
+            continue
+        coords.append((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and int(grid[nr, nc]) == GREEN:
