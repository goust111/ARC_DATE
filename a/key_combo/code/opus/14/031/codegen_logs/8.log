+    for r0, c0, hh, ww in rects:
+        grid[r0 : r0 + hh, c0 : c0 + ww] = GREY
+    return grid
+
+
+def _zone_for_merge(origin: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, c0 = origin
