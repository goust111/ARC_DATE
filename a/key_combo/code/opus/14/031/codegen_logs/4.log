 134: def _gen_balance_bg(q: np.ndarray, bg: int, fg: list[int]) -> None:
 135:     for _ in range(_GEN_BG_BALANCE_STEPS):
 136:         counts = {color: int(np.count_nonzero(q == color)) for color in [bg] + fg}
 137:         if counts[bg] >= max(counts[color] for color in fg) + _GEN_BG_DOMINANCE_MARGIN:
 138:             return
 139:         color = max(fg, key=lambda x: counts[x])
 140:         coords = [(int(r), int(c)) for r, c in np.argwhere(q == color) if counts[color] > _GEN_MIN_COLOR_CELLS_TO_REPAINT]
 141:         if not coords:
 142:             return
 143:         r, c = random.choice(coords)
 144:         _gen_set_q_orbit(q, r, c, bg)
 145: 
