+    source_row = source_rows.pop()
+    source_col = source_cols.pop()
+    source_r0 = row_cells[source_row][0]
+    source_c0 = col_cells[source_col][0]
+    offsets = _cell_offsets(template_coords, source_r0, source_c0)
