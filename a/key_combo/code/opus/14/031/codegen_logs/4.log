 101: # --------------- generator (o5x) ---------------
 102: # Canvas/scaffold geometry.
 103: BACKGROUND_COLOR = 0
 104: CELL_SIZE, CELL_STRIDE, TRUNCATED_CROP = 3, 4, 2
 105: SEPARATOR_COUNT_RANGE, TRUNCATION_COIN_RANGE = (5, 8), (0, 2)
 106: FORCE_FULL_SEP_COUNT, FORCE_TRUNCATED_SEP_COUNT = 5, 7
 107: # Palette.
 108: FOREGROUND_COLORS, FOREGROUND_PAIR_SIZE = np.arange(1, 10), 2
 109: # Motif shape.
 110: MOTIF_PIXEL_RANGE, MOTIF_COORD_RANGE = (4, 7), (0, CELL_SIZE)
 111: MOTIF_EDGE_COORDS = (0, CELL_SIZE - 1)
 112: # Retry limit.
 113: MAX_GENERATION_ATTEMPTS = 300
 114: 
 115: def _gen_open_cells(side: int, separators: np.ndarray) -> list[tuple[int, int]]:
 116:     starts = [0] + [int(sep) + 1 for sep in separators]
 117:     ends = [int(sep) - 1 for sep in separators] + [side - 1]
 118:     return [(lo, hi) for lo, hi in zip(starts, ends) if lo <= hi]
 119: 
 120: 
 121: def _sample_scaffold_layout() -> tuple[int, np.ndarray, list[tuple[int, int]]]:
 122:     """Sample side length, separator coordinates, and square open-cell runs."""
 123:     n_seps = int(np.random.randint(*SEPARATOR_COUNT_RANGE))
 124:     if n_seps == FORCE_FULL_SEP_COUNT:
 125:         truncated = False
 126:     elif n_seps == FORCE_TRUNCATED_SEP_COUNT:
 127:         truncated = True
 128:     else:
 129:         truncated = bool(np.random.randint(*TRUNCATION_COIN_RANGE))
 130:     side = CELL_SIZE + n_seps * CELL_STRIDE - (TRUNCATED_CROP if truncated else 0)
 131:     separators = CELL_SIZE + CELL_STRIDE * np.arange(n_seps)
 132:     return side, separators, _gen_open_cells(side, separators)
 133: 
 134: 
 135: def _sample_full_cell_index(cells: list[tuple[int, int]]) -> int:
 136:     full_indices = [idx for idx, (lo, hi) in enumerate(cells) if hi - lo + 1 == CELL_SIZE]
 137:     return int(full_indices[int(np.random.randint(len(full_indices)))])
 138: 
 139: 
 140: def _gen_motif_offsets(pixel_count: int) -> list[tuple[int, int]]:
 141:     """Return offsets that span the full cell bbox with the requested pixel count."""
 142:     edge_lo, edge_hi = MOTIF_EDGE_COORDS
 143:     offsets = {
 144:         (edge_lo, int(np.random.randint(*MOTIF_COORD_RANGE))),
 145:         (edge_hi, int(np.random.randint(*MOTIF_COORD_RANGE))),
 146:         (int(np.random.randint(*MOTIF_COORD_RANGE)), edge_lo),
 147:         (int(np.random.randint(*MOTIF_COORD_RANGE)), edge_hi),
 148:     }
 149:     remaining = [(r, c) for r in range(CELL_SIZE) for c in range(CELL_SIZE) if (r, c) not in offsets]
 150:     needed = pixel_count - len(offsets)
 151:     if needed > 0:
 152:         for idx in np.random.permutation(len(remaining))[:needed]:
 153:             offsets.add(remaining[int(idx)])
 154:     return sorted(offsets)
 155: 
 156: 
 157: def _stamp_same_parity_motif(grid, cells, source_row, source_col, offsets, motif_color) -> None:
 158:     """Stamp motif offsets into same-parity cells, clipping truncated edge cells."""
 159:     for row_idx, (r0, r1) in enumerate(cells):
 160:         if row_idx % 2 != source_row % 2:
 161:             continue
 162:         for col_idx, (c0, c1) in enumerate(cells):
 163:             if col_idx % 2 != source_col % 2:
 164:                 continue
 165:             for dr, dc in offsets:
 166:                 r = r0 + dr
 167:                 c = c0 + dc
 168:                 if r <= r1 and c <= c1:
 169:                     grid[r, c] = motif_color
