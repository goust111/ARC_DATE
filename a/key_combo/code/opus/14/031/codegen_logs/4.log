 123: def _gen_force_palette(q: np.ndarray, colors: list[int]) -> None:
 124:     used = set(int(x) for x in q.flat)
 125:     spots = [(r, c) for r in range(_GEN_QUAD_SIZE) for c in range(r, _GEN_QUAD_SIZE)]
 126:     random.shuffle(spots)
 127:     for color in colors:
 128:         if color not in used and spots:
 129:             r, c = spots.pop()
 130:             _gen_set_q_orbit(q, r, c, color)
 131:             used.add(color)
