  16: def main(input_grid):
  17:     """
  18:     Connect two aligned colored pixels through a centered split-color hollow rectangle.
  19: 
  20:     Input structure:
  21:     - Two single pixels of different colors are aligned horizontally or vertically.
  22:     - The background is black.
  23:     - There is enough space between the pixels for the hollow rectangle bridge.
  24: 
  25:     Rule:
  26:     - Rotate vertical cases into a horizontal canonical form.
  27:     - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
  28:     - Paste it midway between the pixels and connect each pixel to the nearest side.
  29: 
  30:     Key insight:
  31:     - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
  32:     """
  33:     # Plan (from the original seed solver):
  34:     # 1. Parse the input
  35:     # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
  36:     # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
  37:     # 4. Place the rectangle in the middle of the two pixels
  38:     # 5. Draw lines to connect the original two pixels with the rectangle
  39:     # 6. Rotate the grid back if it was not originally horizontal
  40:     #
  41:     # Implementation note:
  42:     # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
  43:     #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
  44:     comps = find_components(
  45:         input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
  46:     )
  47:     if len(comps) != 2:
  48:         return input_grid.copy()
  49: 
  50:     p0 = tuple(map(int, comps[0]["coords"][0]))
  51:     p1 = tuple(map(int, comps[1]["coords"][0]))
  52: 
  53:     rotated = False
  54:     grid = input_grid
  55:     if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
  56:         grid = np.rot90(grid)
  57:         rotated = True
  58: 
  59:     comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
  60:     if len(comps) != 2:
  61:         out = grid.copy()
  62:         return np.rot90(out, k=-1) if rotated else out
  63: 
  64:     p0 = tuple(map(int, comps[0]["coords"][0]))
  65:     p1 = tuple(map(int, comps[1]["coords"][0]))
  66:     c0 = int(comps[0]["color"])
  67:     c1 = int(comps[1]["color"])
  68: 
  69:     # Should now be horizontally aligned
  70:     if p0[0] != p1[0]:
  71:         out = grid.copy()
  72:         return np.rot90(out, k=-1) if rotated else out
  73: 
  74:     # Sort left->right by column
  75:     if p0[1] <= p1[1]:
  76:         left_pos, right_pos = p0, p1
  77:         left_color, right_color = c0, c1
  78:     else:
  79:         left_pos, right_pos = p1, p0
  80:         left_color, right_color = c1, c0
  81: 
  82:     r = left_pos[0]
  83:     c_left = left_pos[1]
  84:     c_right = right_pos[1]
  85: 
  86:     output_grid = grid.copy()
  87: 
  88:     # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
  89:     # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
  90:     rect_h, rect_w = 5, 4
  91:     rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
  92:     rect[:, 0] = left_color
  93:     rect[:, -1] = right_color
  94:     rect[0, : rect_w // 2] = left_color
  95:     rect[0, rect_w // 2 :] = right_color
  96:     rect[-1, : rect_w // 2] = left_color
  97:     rect[-1, rect_w // 2 :] = right_color
  98: 
  99:     middle_c = (c_left + c_right + 1) // 2
 100:     paste(
 101:         output_grid,
 102:         rect,
 103:         r - rect_h // 2,
 104:         middle_c - rect_w // 2,
 105:         transparent=Color.BLACK,
 106:         clip=True,
 107:     )
 108: 
 109:     # Connect left/right pixels to the rectangle via horizontal lines
 110:     draw_line(
 111:         grid=output_grid,
 112:         r=r,
 113:         c=c_left + 1,
 114:         direction=(0, 1),
 115:         color=left_color,
 116:         stop_at=Color.NOT_BLACK,
 117:     )
 118:     draw_line(
 119:         grid=output_grid,
 120:         r=r,
 121:         c=c_right - 1,
 122:         direction=(0, -1),
 123:         color=right_color,
 124:         stop_at=Color.NOT_BLACK,
 125:     )
 126: 
 127:     if rotated:
 128:         output_grid = np.rot90(output_grid, k=-1)
 129:     return output_grid
 130: 
 131: def generate_input():
 132:     # Generate a random background grid
 133:     # Make sure the grid's width is greater than its height
 134:     width, height = random.randint(15, 20), random.randint(10, 15)
 135:     grid = np.zeros((width, height), dtype=int)
 136: 
 137:     # Get the color of two pixels
 138:     colors = np.random.choice(Color.NOT_BLACK, 2, replace=False)
 139:     color1, color2 = colors
 140: 
 141:     # Place the two pixels on the grid horizontally (randomly rotate at the end to get a variety of orientations)
 142:     x1 = np.random.randint(0, width)
 143:     x2 = np.random.randint(0, width)
 144:     c = np.random.randint(0, height)
 145: 
 146:     # Ensure there is enough horizontal distance to place the 4x5 rectangle
 147:     distance = abs(x2 - x1)
 148:     rectangle_width, rectangle_height = 4, 5
 149:     if distance < rectangle_width+1: return generate_input()
 150: 
 151:     # Ensure the remaining distance is odd, so that we can split the pixel colors in half between them
 152:     if (distance - rectangle_width) % 2 != 1: return generate_input()
 153: 
 154:     # Ensure there is enough vertical space to place the rectangle
 155:     if c < rectangle_height // 2 or c + rectangle_height // 2 >= height: return generate_input()    
 156: 
 157:     # Place the two pixels on the grid
 158:     grid[x1, c] = color1
 159:     grid[x2, c] = color2
 160: 
 161:     # Randomly rotate the whole grid
 162:     if np.random.rand() < 0.5:
 163:         grid = np.rot90(grid, k=-1)
 164: 
 165:     return grid
