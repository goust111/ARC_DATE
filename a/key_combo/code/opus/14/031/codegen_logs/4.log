+def _open_runs(length: int, separators: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    prev = -1
+    for sep in sorted(int(x) for x in separators):
+        if prev + 1 <= sep - 1:
+            runs.append((prev + 1, sep - 1))
+        prev = sep
+    if prev + 1 <= length - 1:
+        runs.append((prev + 1, length - 1))
+    return runs
+
