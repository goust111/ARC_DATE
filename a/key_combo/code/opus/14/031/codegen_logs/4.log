  37: 
  38:     Rule
  39:     - Split rows and columns into open cells between the full scaffold separator lines.
  40:     - Find the open cell containing all motif pixels and record those pixels as offsets from that cell's upper-left corner.
  41:     - Stamp those offsets into every open cell whose row-cell index and column-cell index have the same parity as the source cell, clipping at truncated edge cells.
  42: 
  43:     Key insight
  44:     - The scaffold turns the grid into a checkerboard of cells; the seed motif marks which parity class should receive copies.
  45:     """
  46:     g = np.asarray(grid, dtype=int)
  47:     assert g.ndim == 2, "expected a 2D grid"
  48:     height, width = map(int, g.shape)
  49: 
  50:     bg = int(get_bg(g))
  51:     colors = colors_present(g, exclude={bg})
  52:     assert len(colors) == 2, "expected exactly one scaffold color and one motif color"
  53: 
  54:     scaffold_candidates: list[tuple[int, np.ndarray, np.ndarray]] = []
  55:     for color in colors:
  56:         color = int(color)
  57:         row_lines = np.flatnonzero(np.all(g == color, axis=1))
  58:         col_lines = np.flatnonzero(np.all(g == color, axis=0))
  59:         if len(row_lines) > 0 and len(col_lines) > 0:
  60:             scaffold_candidates.append((color, row_lines, col_lines))
  61: 
  62:     assert len(scaffold_candidates) == 1, "expected one color to define full scaffold lines"
  63:     scaffold_color, row_lines, col_lines = scaffold_candidates[0]
  64:     motif_colors = [color for color in colors if int(color) != scaffold_color]
  65:     assert len(motif_colors) == 1, "expected one non-scaffold motif color"
  66:     motif_color = int(motif_colors[0])
  67: 
  68:     row_cells = _open_runs(height, row_lines)
  69:     col_cells = _open_runs(width, col_lines)
  70:     assert row_cells and col_cells, "scaffold must leave open cells"
  71: 
  72:     motif_coords = np.argwhere(g == motif_color)
  73:     assert len(motif_coords) > 0, "expected a nonempty motif"
  74:     source_row_indices = {_run_index(row_cells, int(r)) for r, _c in motif_coords}
  75:     source_col_indices = {_run_index(col_cells, int(c)) for _r, c in motif_coords}
  76:     assert len(source_row_indices) == 1, "motif must occupy one row cell"
  77:     assert len(source_col_indices) == 1, "motif must occupy one column cell"
  78: 
  79:     source_row = source_row_indices.pop()
  80:     source_col = source_col_indices.pop()
  81:     source_r0 = row_cells[source_row][0]
  82:     source_c0 = col_cells[source_col][0]
  83:     offsets = [(int(r - source_r0), int(c - source_c0)) for r, c in motif_coords]
  84: 
  85:     out = g.copy()
  86:     for row_idx, (r0, r1) in enumerate(row_cells):
  87:         if row_idx % 2 != source_row % 2:
  88:             continue
  89:         for col_idx, (c0, c1) in enumerate(col_cells):
  90:             if col_idx % 2 != source_col % 2:
  91:                 continue
  92:             for dr, dc in offsets:
  93:                 r = r0 + dr
  94:                 c = c0 + dc
  95:                 if r <= r1 and c <= c1:
  96:                     assert out[r, c] in (bg, motif_color), "motif copies must land in open cells"
  97:                     out[r, c] = motif_color
  98: 
  99:     return out
