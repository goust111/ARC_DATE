 113: def _gen_set_q_orbit(q: np.ndarray, r: int, c: int, color: int) -> None:
 114:     q[r, c] = color
 115:     q[c, r] = color
 116: 
 117: 
 118: def _gen_paint_q_rect(q: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> None:
 119:     q[r0 : r0 + h, c0 : c0 + w] = color
 120:     q[c0 : c0 + w, r0 : r0 + h] = color
