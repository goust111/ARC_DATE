+
+    return grid, row_cells, col_cells
+
+
+def _expected_changed_cells(
+    row_cells: list[tuple[int, int]],
+    col_cells: list[tuple[int, int]],
+    source_cell: tuple[int, int],
+    offsets: list[tuple[int, int]],
