 147: def _gen_break_uniform_5x5(q: np.ndarray, colors: list[int]) -> bool:
 148:     for _ in range(_GEN_UNIFORM_BREAK_STEPS):
 149:         scene = _gen_expand_q(q)
 150:         changed = False
 151:         for r0 in range(_GEN_GRID_SIZE - _GEN_OCCLUDER_SIZE + 1):
 152:             for c0 in range(_GEN_GRID_SIZE - _GEN_OCCLUDER_SIZE + 1):
 153:                 patch = scene[r0 : r0 + _GEN_OCCLUDER_SIZE, c0 : c0 + _GEN_OCCLUDER_SIZE]
 154:                 color = int(patch[0, 0])
 155:                 if np.all(patch == color):
 156:                     rr = r0 + _GEN_OCCLUDER_SIZE // 2
 157:                     cc = c0 + _GEN_OCCLUDER_SIZE // 2
 158:                     qr = rr if rr < _GEN_QUAD_SIZE else _GEN_GRID_SIZE - 1 - rr
 159:                     qc = cc if cc < _GEN_QUAD_SIZE else _GEN_GRID_SIZE - 1 - cc
 160:                     choices = [x for x in colors if x != color]
 161:                     _gen_set_q_orbit(q, qr, qc, random.choice(choices))
 162:                     changed = True
 163:                     break
 164:             if changed:
 165:                 break
 166:         if not changed:
 167:             return True
 168:     return False
