  20: def main(grid: np.ndarray) -> np.ndarray:
  21:     """Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.
  22: 
  23:     Input structure
  24:     - The grid has a dominant background color.
  25:     - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.
  26: 
  27:     Rule
  28:     - For each ring, move corner colors one step around the four corners.
  29:     - Move side-center colors one step around the four side centers in the opposite direction.
  30:     - Leave the background center and all other background pixels unchanged.
  31: 
  32:     Key insight
  33:     - Corners and side centers form two separate four-cycles on the same 3x3 ring.
  34:     """
  35:     g = np.asarray(grid, dtype=int)
  36:     bg = get_bg(g)
  37:     out = g.copy()
  38: 
  39:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
  40:     assert components
  41: 
  42:     for comp in components:
  43:         bbox = comp["bbox"]
  44:         r0, c0, r1, c1 = map(int, bbox)
  45:         assert bbox_h(bbox) == 3
  46:         assert bbox_w(bbox) == 3
  47:         assert int(comp["area"]) == 8
  48:         assert g[r0 + 1, c0 + 1] == bg
  49: 
  50:         ring_coords = {
  51:             (r0 + dr, c0 + dc)
  52:             for dr in range(3)
  53:             for dc in range(3)
  54:             if (dr, dc) != (1, 1)
  55:         }
  56:         component_coords = {tuple(map(int, coord)) for coord in comp["coords"]}
  57:         assert component_coords == ring_coords
  58:         assert r1 == r0 + 2
  59:         assert c1 == c0 + 2
  60: 
  61:         _rotate_ring(out, g, r0, c0)
  62: 
  63:     return out
  64: 
  65: # --------------- generator (att2, o5x) ---------------
  66: 
  67: # Color and canvas bounds.
  68: BG_COLOR = 7
  69: COLOR_IDS = tuple(range(10))
  70: GRID_SIDE_MIN, GRID_SIDE_MAX = 6, 10
  71: MIN_BACKGROUND_PCT = 67
  72: 
  73: # Ring geometry, counts, and placement spacing.
  74: RING_SIZE, RING_AREA, RING_GAP = 3, 8, 1
  75: RING_COUNT_MIN, RING_COUNT_MAX = 1, 2
  76: RING_UNIQUE_MIN, RING_UNIQUE_MAX = 2, RING_AREA
  77: RING_CELLS = (
  78:     (0, 0),
  79:     (0, 1),
  80:     (0, 2),
  81:     (1, 0),
  82:     (1, 2),
  83:     (2, 0),
  84:     (2, 1),
  85:     (2, 2),
  86: )
  87: 
  88: # Retry budget for rejection through the solver oracle.
  89: GENERATION_RETRIES = 300
  90: 
  91: 
  92: def _bbox_at(r: int, c: int) -> tuple[int, int, int, int]:
  93:     return r, c, r + RING_SIZE - 1, c + RING_SIZE - 1
  94: 
  95: 
  96: def _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
  97:     return (
  98:         a[2] + RING_GAP < b[0]
  99:         or b[2] + RING_GAP < a[0]
 100:         or a[3] + RING_GAP < b[1]
 101:         or b[3] + RING_GAP < a[1]
 102:     )
 103: 
 104: 
 105: def _valid_position_sets(rows: int, cols: int, count: int) -> list[tuple[tuple[int, int], ...]]:
 106:     positions = [(r, c) for r in range(rows - RING_SIZE + 1) for c in range(cols - RING_SIZE + 1)]
 107:     if count == 1:
 108:         return [(pos,) for pos in positions]
 109: 
 110:     pairs = []
 111:     for i, first in enumerate(positions):
 112:         box1 = _bbox_at(*first)
 113:         for second in positions[i + 1 :]:
 114:             if _separated(box1, _bbox_at(*second)):
 115:                 pairs.append((first, second))
 116:     return pairs
 117: 
 118: 
 119: def _compatible_sizes(count: int) -> list[tuple[int, int]]:
 120:     sizes = []
 121:     for rows in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):
 122:         for cols in range(GRID_SIDE_MIN, GRID_SIDE_MAX + 1):
 123:             area = rows * cols
 124:             if (area - RING_AREA * count) * 100 < MIN_BACKGROUND_PCT * area:
 125:                 continue
 126:             if _valid_position_sets(rows, cols, count):
 127:                 sizes.append((rows, cols))
 128:     return sizes
 129: 
 130: 
 131: _SIZES = {count: _compatible_sizes(count) for count in range(RING_COUNT_MIN, RING_COUNT_MAX + 1)}
 132: _POSITION_SETS = {
 133:     count: {size: _valid_position_sets(*size, count) for size in _SIZES[count]}
 134:     for count in _SIZES
 135: }
 136: 
 137: 
 138: def _make_ring(bg: int) -> np.ndarray:
 139:     ring = np.full((RING_SIZE, RING_SIZE), bg, dtype=int)
 140:     palette = [color for color in COLOR_IDS if color != bg]
 141:     unique_count = random.randint(RING_UNIQUE_MIN, RING_UNIQUE_MAX)
 142:     chosen = random.sample(palette, unique_count)
 143:     values = chosen + [random.choice(chosen) for _ in range(RING_AREA - unique_count)]
 144:     random.shuffle(values)
 145:     for (dr, dc), color in zip(RING_CELLS, values):
 146:         ring[dr, dc] = color
 147:     return ring
 148: 
 149: 
 150: def _rotated_output(grid: np.ndarray, positions: tuple[tuple[int, int], ...]) -> np.ndarray:
 151:     out = grid.copy()
 152:     for r0, c0 in positions:
 153:         _rotate_ring(out, grid, r0, c0)
 154:     return out
 155: 
 156: 
 157: def _render_grid(rows: int, cols: int, positions: tuple[tuple[int, int], ...], bg: int) -> np.ndarray:
 158:     grid = np.full((rows, cols), bg, dtype=int)
 159:     for r0, c0 in positions:
 160:         paste(grid, _make_ring(bg), r0, c0)
 161:     return grid
