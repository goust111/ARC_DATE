+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+GRID_SIDE_RANGE = (12, 16)
+SOURCE_COUNT_RANGE = (2, 4)
+DEFLECTOR_COUNT_RANGE = (4, 8)
+GENERATION_RETRIES = 500
