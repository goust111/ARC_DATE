+            boundary = [(h - 1, c) for c in range(w)]
+        elif side == "bottom":
+            boundary = [(0, c) for c in range(w)]
+        elif side == "left":
+            boundary = [(r, w - 1) for r in range(h)]
+        else:
+            boundary = [(r, 0) for r in range(h)]
