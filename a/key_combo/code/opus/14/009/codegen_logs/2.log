+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+TEMPLATE = 3
+FRAME = 7
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 0),
+    (0, 1),
+    (1, -1),
+    (1, 0),
+    (1, 1),
+]
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _is_rect_frame_component(coords: list[tuple[int, int]]) -> tuple[bool, tuple[int, int, int, int] | None]:
+    if not coords:
+        return False, None
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False, None
+    coord_set = set(coords)
+    expected = set()
+    for rr in range(r0, r1 + 1):
+        expected.add((rr, c0))
+        expected.add((rr, c1))
+    for cc in range(c0, c1 + 1):
+        expected.add((r0, cc))
+        expected.add((r1, cc))
+    if coord_set != expected:
+        return False, None
+    return True, (r0, c0, r1, c1)
+
