+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+
+        trimmed, th, tw = _trim_coords(cells)
+        area = th * tw
+        if len(trimmed) < 2:
+            continue
+        if area == len(trimmed) and area > 2:
+            continue
