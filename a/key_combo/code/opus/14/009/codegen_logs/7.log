+        dedup = {}
+        assert best_moves is not None
+        for idx, top, left, overlap in best_moves:
+            key = (idx, top, left)
+            dedup[key] = max(dedup.get(key, 0), overlap)
+        moves = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]
