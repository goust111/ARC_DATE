+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+BODY_COLORS = (BLUE, GREEN, ORANGE)
+
+GEN_RETRIES = 400
+ASSEMBLY_SOLUTION_CAP = 2
