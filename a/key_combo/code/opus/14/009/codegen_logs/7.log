+    for coords, (dr, dc) in zip(comps, shifts):
+        for r, c in coords:
+            rr = int(r + dr)
+            cc = int(c + dc)
+            assert 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]
+            color = int(residual[r, c])
+            assert out[rr, cc] in (BG, color)
+            out[rr, cc] = color
