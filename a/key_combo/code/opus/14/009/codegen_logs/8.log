+    target_single = _pick_single_cell(
+        h,
+        w,
+        occupied,
+        rows,
+        cols,
+        must_hit=target_line,
+    )
+    if target_single is None:
+        return None
+    _paint_cells(grid, occupied, [target_single], random.choice(SINGLE_COLORS))
