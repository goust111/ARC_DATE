+MULTI_COLORS = (1, 2, 3, 6, 8, 9)
+SINGLE_COLORS = (1, 2, 3, 4, 6, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = (
