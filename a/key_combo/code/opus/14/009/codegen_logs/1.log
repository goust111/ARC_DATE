    for num_multi in MULTI_COMPONENT_COUNTS:
        for num_single in SINGLE_COMPONENT_COUNTS:
            if not (COMPONENT_COUNT_MIN <= num_multi + num_single <= COMPONENT_COUNT_MAX):
                continue
