        grid[coords[:, 0], coords[:, 1]] = color
        occupied[coords[:, 0], coords[:, 1]] = True
        _gen_mark_neighbors(same_color_blocked, coords)
        placed.extend((int(r), int(c)) for r, c in coords)
    return placed


