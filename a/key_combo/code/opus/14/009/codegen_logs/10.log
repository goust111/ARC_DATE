+    height, width = _sample_canvas(len(corner_counts))
+    grid = np.zeros((height, width), dtype=int)
+    grid[:, -1] = GREY
+
+    center_rows = _sample_center_rows(height, len(corner_counts))
+    for corner_count, center_row in zip(corner_counts, center_rows):
