+    r0, c0, r1, c1 = bbox
+    interior = g[r0 + 1 : r1, c0 + 1 : c1]
+    markers: list[tuple[str, tuple[int, int], int]] = []
+    stretches = {side: 0 for side in SIDE_ORDER}
