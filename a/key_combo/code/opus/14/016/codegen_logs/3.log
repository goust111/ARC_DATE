+BG = 0
+TOP = 1
+LEFT = 2
+BOTTOM = 3
+RIGHT = 4
+
+SIDE_ORDER = ("top", "bottom", "left", "right")
+SIDE_COLOR = {"top": TOP, "bottom": BOTTOM, "left": LEFT, "right": RIGHT}
