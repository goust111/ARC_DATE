+    for side, cell in placements:
+        grid[cell] = SIDE_COLOR[side]
+    return grid
+
+
+def _expected_bbox(
+    bbox: tuple[int, int, int, int],
+    distances: dict[str, int],
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return (
