+        c0 - distances["left"],
+        r1 + distances["bottom"],
+        c1 + distances["right"],
+    )
+
+
+def _validate_generated_case(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    placements: list[tuple[str, tuple[int, int]]],
