+
+def _choose_active_sides() -> list[str]:
+    count = random.choice([1, 2, 2, 3, 3, 4])
+    return random.sample(list(SIDE_ORDER), count)
+
+
+def _max_distance_for_side(
+    side: str,
+    bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
+) -> int:
+    r0, c0, r1, c1 = bbox
