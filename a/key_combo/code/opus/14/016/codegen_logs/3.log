+    r0, c0, r1, c1 = bbox
+    r, c = cell
+    if side == "top":
+        return int(r - r0)
+    if side == "bottom":
+        return int(r1 - r)
+    if side == "left":
+        return int(c - c0)
+    if side == "right":
+        return int(c1 - c)
+    raise ValueError(f"unknown side: {side}")
+
+
+def _edge_distances(bbox: tuple[int, int, int, int], cell: tuple[int, int]) -> dict[str, int]:
+    r0, c0, r1, c1 = bbox
+    r, c = cell
+    return {
+        "top": int(r - r0),
+        "bottom": int(r1 - r),
+        "left": int(c - c0),
+        "right": int(c1 - c),
+    }
+
+
+def _draw_frame(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
