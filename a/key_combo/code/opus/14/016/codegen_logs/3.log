  "type": "move_to_match",
  "src": "lower-panel 4-connected foreground object s",
  "dst": "top-strip pixel d in the same-color marker row",
  "match_cond": "s.color == d.row_marker_color",
  "transform": "s -> one pixel; unmatched lower-panel foreground -> panel background"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 20 rows x 10 cols [observed]
  top_strip:
    height: 7 rows [observed]; rows 0,2,4,6 are all-black spacers
    markers: 3 single-pixel cells at (1,0),(3,0),(5,0) with distinct non-zero colors
  lower_panel:
    starts: at row 7 [observed]; first row is entirely panel_bg
    background: a single non-zero color filling ~80-85% of cells; never 0
    foreground_objects: 6-11 4-connected rectangular blobs, each 2-4 cells
    marker_colors: 2-3 of the 3 marker colors appear as objects; 0-1 markers absent from panel (bar=0)
    distractor_colors: 1-2 extra non-zero, non-bg, non-marker colors present as objects
    objects_per_marker_color: 1-5 objects; max count <= grid width
    no_objects_touch: all objects separated by >=1 bg cell (4-conn components are single-color)
    border_margin: no fg cell on panel first/last row or first/last col [observed]
  transformation:
    panel: erase distractor objects (replace with panel_bg); keep marker-color objects
    strip: extend each marker pixel into a horizontal bar of length = object count of that color

generation_strategy:
  approach: output-first
  steps:
    1. Pick panel_bg (non-zero), 3 distinct marker colors (non-zero, != panel_bg, != 0).
    2. Decide per-marker object counts c1,c2,c3 in 0-5 (at least two > 0, sum <= 10, each <= width).
    3. Build the output lower panel (13x10): fill with panel_bg, randomly place c1+c2+c3 rectangular
       2-4 cell blobs for marker colors; ensure no two objects 4-adjacent and 1-cell border margin.
    4. Build the output top strip: rows 0,2,4,6 all-black; rows 1,3,5 get horizontal bars of
       length c1,c2,c3 starting at col 0 in the respective marker color.
    5. Derive input from output — copy output, then in the panel add 1-3 distractor-color blobs
       (pick 1-2 new colors not in {0, panel_bg, marker colors}) in empty bg regions.
       In the top strip, shrink each bar back to a single pixel at col 0.
