+
+def _max_distance_for_side(
+    side: str,
+    bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
+) -> int:
+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    H, W = shape
+    if side == "top":
+        return min(r0, h - 2, 6)
+    if side == "bottom":
+        return min(H - 1 - r1, h - 2, 6)
+    if side == "left":
+        return min(c0, w - 2, 6)
+    if side == "right":
+        return min(W - 1 - c1, w - 2, 6)
+    raise ValueError(f"unknown side: {side}")
+
