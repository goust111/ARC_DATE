+    if side == "left":
+        return [(r, c0 + d) for r in range(r0 + 1, r1)]
+    if side == "right":
+        return [(r, c1 - d) for r in range(r0 + 1, r1)]
+    raise ValueError(f"unknown side: {side}")
+
