def _gen_attempt() -> np.ndarray | None:
    panel_bg = random.choice(_GEN_COLORS)
    marker_colors = random.sample([c for c in _GEN_COLORS if c != panel_bg], len(_GEN_MARKER_ROWS))
    counts, distractor_total = _gen_color_counts()
