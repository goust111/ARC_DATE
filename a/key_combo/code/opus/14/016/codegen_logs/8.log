+    grid = np.zeros((height, width), dtype=int)
+    column_modes: list[int] = []
+    c0 = 0
+    for band_width, color in zip(band_widths, band_colors):
+        grid[:-1, c0 : c0 + band_width] = int(color)
+        column_modes.extend([int(color)] * band_width)
+        c0 += band_width
