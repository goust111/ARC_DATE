def _gen_output(panel_bg, marker_colors, counts, marker_objects, marker_specs):
    panel = np.full((_GEN_PANEL_H, _GEN_WIDTH), panel_bg, dtype=int)
    if not _gen_place_blobs(panel, marker_objects, marker_specs):
