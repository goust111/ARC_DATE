+    def rec(remaining: int, slots: int, prefix: tuple[int, ...]) -> None:
+        if slots == 0:
+            if remaining == 0:
+                options.append(prefix)
+            return
+        max_width = remaining - min_width * (slots - 1)
+        for width in range(min_width, max_width + 1):
