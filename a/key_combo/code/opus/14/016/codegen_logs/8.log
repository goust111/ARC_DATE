+        color = int(random.choice(choices))
+        if color == column_modes[c] or color in legend_set:
+            continue
+        grid[r, c] = color
+        col_noise_counts[c] += 1
+        placed += 1
+        if placed >= target:
+            break
+    return placed >= 1
+
+
+def _validate_semantics(inp: np.ndarray, out: np.ndarray) -> bool:
