+
+
+TEMPLATE_VARIANTS = {name: _template_variants(name) for name in TEMPLATE_MASKS}
+
+
+def _candidate_bundles(square_count: int, half: int) -> list[list[str]]:
+    bundles = {
+        0: [
+            ["rr_el"],
+            ["rr_el", random.choice(["rect_h", "rect_v"])],
+            ["rect_h", "rect_v"],
