        bottom[start : end + 1] = [height - 1 - depth] * (end - start + 1)


def _gen_interval_sets(width, count, side):
    if count == 0:
        return [[]]
    intervals = []
    rule = GEN_NOTCH_INTERVAL_RULES[side]
    start_range = range(rule["start_min"], width - rule["start_stop_margin"])
