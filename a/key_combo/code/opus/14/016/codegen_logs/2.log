+            ["rr_el", random.choice(["rect_h", "rect_v"])],
+            ["rect_h", "rect_v"],
+        ],
+        1: [
+            ["sr_compact"],
+            ["sr_long"],
+            ["sr_compact", random.choice(["rect_h", "rect_v"])],
