+
+def _can_place(mask: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int = 1) -> bool:
+    h, w = patch.shape
+    H, W = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
