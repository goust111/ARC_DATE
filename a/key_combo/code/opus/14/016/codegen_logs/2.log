+
+
+def _mirror_from_source(tile: np.ndarray, source_idx: int) -> np.ndarray:
+    half = tile.shape[0]
+    out = np.full((half * 2, half * 2), BLACK, dtype=int)
+    src_row = 0 if source_idx < 2 else 1
+    src_col = source_idx % 2
