+            [1, 1, 1, 1],
+            [1, 1, 1, 1],
+        ],
+        dtype=bool,
+    ),
+}
+
+TEMPLATE_SQUARES = {
+    "rect_h": 0,
+    "rect_v": 0,
+    "rr_el": 0,
+    "sr_compact": 1,
+    "sr_long": 1,
+    "ss_domino": 2,
