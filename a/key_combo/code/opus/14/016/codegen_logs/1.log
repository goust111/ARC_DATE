+_ROW_COUNTS = (4,)
+_NOISE_COUNTS_BY_ROWS = {
+    4: (0, 1, 2, 3),
+}
+_GEN_ATTEMPTS = 400
+_COLORS = tuple(range(1, 10))
+_NOISE_COLORS = tuple(range(10))
