/bin/bash -lc "python - <<'PY'
from itertools import product
W=10

def shift(row,dx):
    out=[0]*W
    for c,v in enumerate(row):
        if v:
            nc=c+dx
            if 0<=nc<W: out[nc]=1
    return tuple(out)

def valid_candidates(rows):
    H=len(rows)
    out=[]
    for p in (2,3):
        if p>=H: continue
        for dx in range(-4,5):
            if all(shift(rows[r],dx)==rows[r+p] for r in range(H-p)):
                out.append((p,dx))
    return out

def rowset(axis):
    rows=[]
    if axis==4:
        for s in product([0,1], repeat=5):
            f=(s[3],s[2],s[1],s[0],0,s[0],s[1],s[2],s[3],s[4])
            rows.append((s,f))
    else:
        for s in product([0,1], repeat=5):
            f=(s[0],s[1],s[2],s[3],s[4],0,s[4],s[3],s[2],s[1])
            rows.append((s,f))
    F={f:s for s,f in rows}
    trans={}
    for dx in range(-4,5):
        vals=[]
        if dx==0: continue
        for s,f in rows:
            g=shift(f,dx)
            if g in F and sum(f)>=2 and sum(g)>=1:
                vals.append((f,g))
        if vals:
            trans[dx]=vals
    return trans
for axis in [4,5]:
  print('AXIS',axis)
  trans=rowset(axis)
  p,h=(2,4)
  found=[]
  for dx,vals in trans.items():
    fs=[v[0] for v in vals]
    gs=set(g for _,g in vals)
    for choice in product(range(len(fs)), repeat=p):
      base=[fs[i] for i in choice]
      rows=list(base)
      ok=True
      for r in range(p,h):
        nr=shift(rows[r-p],dx)
        if nr not in gs:
          ok=False;break
        rows.append(nr)
      if ok and valid_candidates(rows)==[(p,dx)]:
        found.append((dx,choice,rows))
  print('found',len(found))
  for item in found[:20]:
    print(item[0],item[1],[sum(r) for r in item[2]])
    for rr in item[2]: print(' ',rr)
