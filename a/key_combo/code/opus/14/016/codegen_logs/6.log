from __future__ import annotations
import random
import numpy as np

BG=0; Y=4; MASK=5
FG_CHOICES=[1,2,3,6,7,8,9]


def shift_row(row, dx, bg=BG):
    row=np.asarray(row)
    out=np.full(row.shape, bg, dtype=int)
    cols=np.flatnonzero(row"'!=bg)
    dst=cols+dx
    keep=(0<=dst)&(dst<row.size)
    out[dst[keep]]=row[cols[keep]]
    return out


def candidate_period_shifts(rows, periods=(2,3)):
    rows=np.asarray(rows)
    H,W=rows.shape
    cands=[]
    for p in periods:
        if p>=H:
            continue
        for dx in range(-(W-1), W):
            if all(np.array_equal(shift_row(rows[r], dx), rows[r+p]) for r in range(H-p)):
                cands.append((p, dx))
    return cands


def find_period_shift(rows):
    by_period={}
    for p,dx in candidate_period_shifts(rows):
        by_period.setdefault(p,set()).add(dx)
    for p in (2,3):
        if p not in by_period:
            continue
        dxs=sorted(by_period[p])
        assert len(dxs)==1
        return p,dxs[0]
    raise AssertionError


def layout(width, axis, source_side):
    if source_side=='"'left':
        source_cols=list(range(axis))
        pair=min(len(source_cols), width-axis-1)
        paired_source=list(range(axis-1, axis-pair-1, -1))
        target_cols=list(range(axis+1, axis+pair+1))
    else:
        source_cols=list(range(axis+1,width))
        pair=min(len(source_cols), axis)
        paired_source=list(range(axis+1, axis+pair+1))
        target_cols=list(range(axis-1, axis-pair-1, -1))
    return source_cols, paired_source, target_cols


def render(source_rows, width, axis, source_side):
    source_cols, paired_source, target_cols = layout(width, axis, source_side)
    source_rows=np.asarray(source_rows)
    out=np.zeros((source_rows.shape[0], width), dtype=int)
    out[:, source_cols]=source_rows
    pos={c:i for i,c in enumerate(source_cols)}
    for src_c,dst_c in zip(paired_source, target_cols):
        out[:, dst_c]=source_rows[:, pos[src_c]]
    return out


def repair(inp):
    g=np.array(inp, dtype=int)
    H,W=g.shape
    axis_cols=np.flatnonzero(np.all(g==Y, axis=0))
    assert len(axis_cols)==1
    axis=int(axis_cols[0])
    extra=[tuple(map(int, rc)) for rc in np.argwhere(g==Y) if int(rc[1])"'!=axis]
    assert len(extra)==1
    control=extra[0]
    source_side='"'left' if control[1] < axis else 'right'
    source_cols, paired_source, target_cols = layout(W, axis, source_side)
    repaired=g.copy()
    repaired[repaired==Y]=BG
    pos={c:i for i,c in enumerate(source_cols)}
    # overwrite target from clean source
    for src_c,dst_c in zip(paired_source, target_cols):
        repaired[:, dst_c]=repaired[:, src_c]
    source_rows=repaired[:, source_cols]
    return repaired, source_rows, axis, source_side


def main(grid):
    g=np.asarray(grid, dtype=int)
    H,W=g.shape
    repaired, source_rows, axis, source_side = repair(g)
    p,dx=find_period_shift(source_rows)
    out_source=np.zeros((10, source_rows.shape[1]), dtype=int)
    out_source[:H]=source_rows
    for r in range(H,10):
        out_source[r]=shift_row(out_source[r-p], dx)
    return render(out_source, W, axis, source_side)


def gen_base_rows(period, dx, color):
    width=5
    base=np.zeros((period,width),dtype=int)
    counts=[random.randint(1,3) for _ in range(period)]
    if period==2 and counts[0]==counts[1] and random.random()<0.7:
        counts[1]=1 if counts[0]>1 else 2
    survive_steps=[max(1, (9-r)//period) for r in range(period)]
    survivor_idx=random.randrange(period)
    for r in range(period):
        count=counts[r]
        cols=set()
        if dx>0:
            hi=max(0, width-1-dx)
