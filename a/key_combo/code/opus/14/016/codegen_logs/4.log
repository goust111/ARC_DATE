+    for period in range(1, width + 1):
+        phase_colors = [-1] * period
+        seen = [False] * period
+        valid = True
+        for c, value in enumerate(row):
+            value = int(value)
+            if value == MISSING:
+                continue
+            phase = c % period
+            if not seen[phase]:
+                phase_colors[phase] = value
+                seen[phase] = True
+            elif phase_colors[phase] != value:
+                valid = False
+                break
+        if not valid or not all(seen):
