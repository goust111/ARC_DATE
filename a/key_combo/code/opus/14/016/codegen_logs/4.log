+def _infer_periodic_legend(damaged_row: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    row = np.asarray(damaged_row, dtype=int)
+    width = int(row.shape[0])
+    candidates: list[tuple[int, tuple[int, ...]]] = []
