+
+def _count_even_cells(height: int, width: int, mr: int, mc: int) -> int:
+    count = 0
+    for r in range(height):
+        for c in range(width):
+            if max(abs(r - mr), abs(c - mc)) % 2 == 0:
+                count += 1
+    return count
