+def _generate_once() -> np.ndarray | None:
+    row_count, col_count = random.choice(LAYOUTS)
+    row_sizes = _sample_segments(row_count)
+    col_sizes = _sample_segments(col_count)
+    if row_sizes is None or col_sizes is None:
