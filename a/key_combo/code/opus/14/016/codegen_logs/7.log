+def _sample_segments(count: int) -> list[int] | None:
+    sizes = [random.randint(SEGMENT_MIN, SEGMENT_MAX) for _ in range(count)]
+    total = sum(sizes) + count - 1
+    if total > 30:
+        return None
+    return sizes
+
