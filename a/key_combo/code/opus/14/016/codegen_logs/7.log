+
+    split_r = 0
+    for size in row_sizes[:-1]:
+        split_r += size
+        grid[split_r, :] = RED
+        split_r += 1
+
+    split_c = 0
+    for size in col_sizes[:-1]:
+        split_c += size
+        grid[:, split_c] = RED
+        split_c += 1
