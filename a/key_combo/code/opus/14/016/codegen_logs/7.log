+        left = 0
+        for cw in col_sizes:
+            local_r, local_c = markers[region_idx]
+            color = marker_colors[region_idx]
+            grid[top + local_r, left + local_c] = int(color)
+            left += cw + 1
+            region_idx += 1
+        top += rh + 1
+    return grid
