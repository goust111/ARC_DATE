+    region_idx = 0
+    top = 0
+    for rh in row_sizes:
+        left = 0
+        for cw in col_sizes:
+            local_r, local_c = markers[region_idx]
+            color = marker_colors[region_idx]
+            grid[top + local_r, left + local_c] = int(color)
+            left += cw + 1
+            region_idx += 1
+        top += rh + 1
+    return grid
+
+
+def _validate_input(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
