+    assert np.all(coords[:, 1] == 0), "marker pixels must sit in column 0"
+    rows = [int(r) for r in coords[:, 0]]
+    assert len(rows) == len(set(rows)), "expected at most one marker per row"
+    markers = [(int(r), int(top[r, 0])) for r in sorted(rows)]
