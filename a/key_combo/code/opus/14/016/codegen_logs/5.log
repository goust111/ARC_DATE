+    assert valid
+    branch = random.choices(
+        ["low", "middle", "high"],
+        weights=[2, 3, 2],
+        k=1,
+    )[0]
+    if branch == "low":
+        pool = valid[: max(1, min(2, len(valid)))]
+    elif branch == "high":
+        pool = valid[-max(1, min(2, len(valid))):]
+    else:
+        lo = len(valid) // 3
+        hi = max(lo + 1, len(valid) - len(valid) // 3)
+        pool = valid[lo:hi] or valid
+    return int(random.choice(pool))
+
+
