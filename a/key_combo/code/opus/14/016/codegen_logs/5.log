+    if kept_pixels % panel_h != shift and np.array_equal(np.roll(filtered, shift=kept_pixels % panel_h, axis=0), out):
+        return False
+    if marker_count != shift and np.array_equal(np.roll(filtered, shift=marker_count % panel_h, axis=0), out):
+        return False
