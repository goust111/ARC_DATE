+    info = {
+        "panel_start": panel_start,
+        "scene": scene,
+        "panel_bg": panel_bg,
+        "markers": markers,
+        "counts": counts,
+        "filtered": filtered,
+        "shift": shift,
+    }
+    return np.roll(filtered, shift=shift, axis=0), info
