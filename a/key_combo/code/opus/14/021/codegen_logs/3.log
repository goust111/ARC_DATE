+        r0, c0 = slot["pos"]
+        for dr, dc in np.argwhere(rotated):
+            out[r0 + dr, c0 + dc] = RED
+    return out
+
+
+def _reachable_slots_by_labels(
+    grid: np.ndarray,
+    template_pos: tuple[int, int],
+    slots: list[dict],
+    connectivity: int,
+) -> set[int]:
+    labels, _ = _label_components(grid == GREY, connectivity=connectivity)
