+        return None
+    return (r0, c0, r1, c1), MISSING_TO_ROT[missing]
+
+
+def _bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    dr = 0
