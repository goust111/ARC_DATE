+
+
+def _choose_template_endpoint(
+    shape: tuple[int, int],
+    box_top_left: tuple[int, int],
+    reserved_boxes: set[tuple[int, int]],
+    require_diag: bool | None,
+) -> dict | None:
+    r0, c0 = box_top_left
+    corner_names = list(CORNER_LAYOUTS)
