+            if nxt in blocked and nxt != target:
+                continue
+            parents[nxt] = cur
+            q.append(nxt)
+    return None
+
+
+def _expected_output(
+    grid: np.ndarray,
+    red_mask: np.ndarray,
+    template_pos: tuple[int, int],
+    slots: list[dict],
+    path_cells: set[tuple[int, int]],
+    marker_cells: set[tuple[int, int]],
+) -> np.ndarray:
