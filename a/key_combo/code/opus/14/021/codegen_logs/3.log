+        dr = br0 - ar1 - 1
+    elif br1 < ar0:
+        dr = ar0 - br1 - 1
+    dc = 0
+    if ac1 < bc0:
+        dc = bc0 - ac1 - 1
+    elif bc1 < ac0:
+        dc = ac0 - bc1 - 1
