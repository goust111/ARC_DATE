+
+
+def _inside(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _choose_layout(
+    shape: tuple[int, int],
+    box_top_left: tuple[int, int],
+    rotation: int,
+    reserved_boxes: set[tuple[int, int]],
+    require_diag: bool | None,
