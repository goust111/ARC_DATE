+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+ORANGE = 7
+
+BOX = 4
+SUPPORT_RELS = ((0, 0), (0, 3), (3, 0), (3, 3))
+
+# A 4x4 connected stamp whose four quarter-turns are all distinct and which never
+# touches a corner, so corner supports remain valid under every rotation.
+BASE_RED_MASK = np.array(
