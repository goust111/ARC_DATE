+
+
+def _route_path(
+    shape: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    existing: set[tuple[int, int]],
+    target: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    h, w = shape
+    q = deque(existing)
+    parents: dict[tuple[int, int], tuple[int, int] | None] = {cell: None for cell in existing}
+    dirs = list(_neighbors(8))
+    random.shuffle(dirs)
