+        labels = {int(grey_labels[r, c]) for r, c in support_cells if int(grey_labels[r, c]) != 0}
+        slot = {"origin": (r0, c0), "labels": labels}
+        if labels & source_labels:
+            reachable.append(slot)
+        else:
+            unreachable.append(slot)
+
