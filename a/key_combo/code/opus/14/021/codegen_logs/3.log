+    r0, c0 = box_top_left
+    corner_names = list(CORNER_LAYOUTS)
+    random.shuffle(corner_names)
+    for name in corner_names:
+        layout = CORNER_LAYOUTS[name]
+        sr, sc = layout["support"]
+        endpoint_offsets = list(layout["diag"])
+        if require_diag is not True:
