+    reachable_indices = set(random.sample(range(SLOT_COUNT), reachable_count))
+    slot_data = []
+    for i, pos in enumerate(slot_positions):
+        rotation = rotations[i] if i < 4 else random.randint(0, 3)
+        slot_data.append({"pos": pos, "rotation": rotation, "reachable": i in reachable_indices})
