  grid: 10x10 [observed]
  colors: black(0)=background, gray(5)=structure, red(2)=stamp
  gray_pattern:
    density: 0.43-0.61 of grid cells
    layout: scattered across grid forming irregular structure with black holes
  sprite:
    bbox: 1-3 rows x 2-4 cols, area 2-9 cells
    red_cells: 4-6 per stamp; form a connected shape within bbox
    composition: red + optional gray + optional black within bbox
    two_variants:
      supported: gray cells present in bbox act as anchor signature; slots must have matching gray at those positions
      unsupported: bbox entirely red (solid); slots must touch grid border
  slots:
    count: 1-4 empty slots in input that match the stamp pattern
    match_rule_supported: at each candidate position, all red-offset cells are black AND all gray-support-offset cells are gray
    match_rule_unsupported: all red-offset cells are black AND bbox touches grid border
    non_overlapping: stamp placements never share cells
  output:
    same grid with each matched slot filled in red; original red sprite preserved; gray unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid size 10x10. Choose sprite bbox size (1-3 x 2-4).
    2. Design sprite pattern within bbox — pick red cells (connected, 4-6 cells) and optionally gray support cells. Decide supported vs unsupported variant.
    3. Pick 2-5 non-overlapping placement origins for the sprite bbox on the grid. For unsupported, all placements must touch grid border. Verify bbox windows do not overlap.
    4. Build output grid — fill gray randomly across all non-stamp cells (density ~0.43-0.61), ensuring support-offset positions at each placement are gray and stamp-offset positions are red.
    5. Derive input — pick one placement as the original sprite (keep red), erase red from all other placements (set to black). Gray stays.
    6. Verify solver reproduces the output from the derived input.
