+)
+
+CORNER_LAYOUTS = {
+    "tl": {
+        "support": (0, 0),
+        "diag": [(-1, -1)],
+        "orth": [(-1, 0), (0, -1)],
+        "marker_boxes": [(-2, 0), (0, -2)],
