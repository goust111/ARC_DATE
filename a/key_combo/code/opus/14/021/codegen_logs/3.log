+    "tr": {
+        "support": (0, 3),
+        "diag": [(-1, 1)],
+        "orth": [(-1, 0), (0, 1)],
+        "marker_boxes": [(-2, 2), (0, 4)],
+    },
+    "br": {
+        "support": (3, 3),
+        "diag": [(1, 1)],
+        "orth": [(1, 0), (0, 1)],
+        "marker_boxes": [(4, 2), (2, 4)],
+    },
+    "bl": {
