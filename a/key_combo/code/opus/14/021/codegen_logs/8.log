+    edges = [bool(sym[r, c]) for r, c in ((0, 1), (0, 2), (1, 0), (2, 0), (1, 3), (2, 3), (3, 1), (3, 2))]
+    interiors = [bool(sym[r, c]) for r, c in ((1, 1), (1, 2), (2, 1), (2, 2))]
