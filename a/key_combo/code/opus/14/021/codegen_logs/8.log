    for r in range(1, n - 1):
        for c in range(r):
            candidates.append(((r, c), (r + 1, c)))
    return candidates


def _gen_place_segments(n, color_sizes):
    """Place all sampled segments without overlap using randomized backtracking."""
    items = list(color_sizes)
    random.shuffle(items)
