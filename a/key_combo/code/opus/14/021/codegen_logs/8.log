+
+
+def _random_mask_with_count(cell_size: int, count: int, rng: np.random.Generator) -> np.ndarray:
+    mask = np.zeros((cell_size, cell_size), dtype=bool)
+    picks = rng.choice(cell_size * cell_size, size=count, replace=False)
