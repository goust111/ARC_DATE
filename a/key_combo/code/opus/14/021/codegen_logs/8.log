+def _generate_attempt(rng: np.random.Generator) -> np.ndarray:
+    cell_size = int(rng.choice(CELL_SIZE_OPTIONS))
+    sym = _random_status_matrix(rng)
+    patterns = _build_patterns(sym, cell_size, rng)
