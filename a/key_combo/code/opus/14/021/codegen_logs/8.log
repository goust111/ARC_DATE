+def _cell_fill_color(is_symmetric: bool, row_i: int, col_i: int) -> int:
+    if not is_symmetric:
+        return BLUE
+    if row_i in (0, TABLE_SIZE - 1) and col_i in (0, TABLE_SIZE - 1):
+        return RED
+    if 0 < row_i < TABLE_SIZE - 1 and 0 < col_i < TABLE_SIZE - 1:
