+    wall_comps: list[int] = []
+    wall_areas: list[int] = []
+    output_signatures: list[bytes] = []
+
+    solved = main(g)
+    assert np.array_equal(main(g.copy()), solved)
+    assert not np.any(solved == BLUE)
