+        for i in range(6)
+        for j in range(i + 1, 6)
+    )
+    assert any(
+        counts[i] == counts[j] and (wall_comps[i] != wall_comps[j] or wall_areas[i] != wall_areas[j])
+        for i in range(6)
+        for j in range(i + 1, 6)
+    )
+
+
+def generate_input() -> np.ndarray:
