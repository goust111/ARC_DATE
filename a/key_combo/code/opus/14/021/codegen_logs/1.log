+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    dirs = DIR4 if int(connectivity) == 4 else DIR8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _draw_segment(mask: np.ndarray, p0: tuple[int, int], p1: tuple[int, int]) -> None:
+    (r0, c0), (r1, c1) = p0, p1
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            mask[int(r0), int(c)] = True
+    elif c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        for r in range(r0, r1 + step, step):
+            mask[int(r), int(c0)] = True
+    else:
+        raise ValueError("segments must be axis-aligned")
+
