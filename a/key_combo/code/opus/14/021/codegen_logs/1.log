+    assert set(counts) == {1, 2, 3, 4}
+    assert counts.count(3) >= 2
+    assert len(set(output_signatures)) == 6
+    assert any(
+        counts[i] != counts[j] and wall_comps[i] == wall_comps[j]
+        for i in range(6)
