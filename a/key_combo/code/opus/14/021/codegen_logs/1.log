+    elif variant == "2_split_h":
+        _draw_segment(mask, (mid, 0), (mid, s - 1))
+    elif variant == "2_bent":
+        _draw_polyline(mask, [(0, q1), (mid, q1), (mid, q2), (s - 1, q2)])
+    elif variant == "3_tee":
