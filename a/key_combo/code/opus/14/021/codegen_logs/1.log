+            wall_comps.append(len(_components(blue_mask, connectivity=4)))
+            wall_areas.append(int(blue_mask.sum()))
+            out_cell = solved[r0 : r1 + 1, c0 : c1 + 1]
+            output_signatures.append((out_cell == RED).astype(np.uint8).tobytes())
