+                    break
+            if not ok:
+                continue
+            for rr, cc in np.argwhere(sprite):
+                cell[r0 + int(rr), c0 + int(cc)] = RED
+            if _black_region_count(cell) != int(target_regions):
+                continue
+            boundary_score = 0
+            for rr, cc in np.argwhere(sprite):
+                r = r0 + int(rr)
+                c = c0 + int(cc)
+                if r in (0, s - 1) or c in (0, s - 1):
+                    boundary_score += 1
+            candidates.append((boundary_score, r0, c0))
