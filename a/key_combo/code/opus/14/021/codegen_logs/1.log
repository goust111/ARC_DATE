+            if built is None:
+                ok = False
+                break
+            cell, info, _sprite_id = built
+            metas.append(info)
+            r0 = 1 + rr * (cell_size + 1)
+            c0 = 1 + cc * (cell_size + 1)
+            grid[r0 : r0 + cell_size, c0 : c0 + cell_size] = cell
+        if not ok:
+            continue
+
+        try:
+            _validate_puzzle(grid)
+        except Exception:
+            continue
