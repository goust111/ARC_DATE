+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _draw_segment(mask: np.ndarray, p0: tuple[int, int], p1: tuple[int, int]) -> None:
+    (r0, c0), (r1, c1) = p0, p1
