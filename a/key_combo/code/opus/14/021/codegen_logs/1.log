+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1], [0, 1]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0], [0, 0, 0]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 1], [0, 0, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1], [0, 0, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 0, 0], [1, 0, 0], [1, 1, 1]], dtype=bool),
+]
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    dirs = DIR4 if int(connectivity) == 4 else DIR8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
