+
+WALL_VARIANTS = {
+    1: ("1_dangle_v", "1_hook"),
+    2: ("2_split_v", "2_split_h", "2_bent"),
+    3: ("3_parallel", "3_tee"),
+    4: ("4_cross", "4_ladder"),
