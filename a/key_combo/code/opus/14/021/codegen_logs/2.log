    frame: Frame, side: str, size: tuple[int, int]
) -> Frame:
    r, c, h, w = frame
    nh, nw = size
    if side == "top":
        nr = r - nh + 1
        lo, hi = c - nw + SHARED_WALL_INSET, c + w - SHARED_WALL_INSET
        nc = random.randint(lo, hi)
    elif side == "bottom":
        nr = r + h - 1
        lo, hi = c - nw + SHARED_WALL_INSET, c + w - SHARED_WALL_INSET
        nc = random.randint(lo, hi)
    elif side == "left":
        nc = c - nw + 1
        lo, hi = r - nh + SHARED_WALL_INSET, r + h - SHARED_WALL_INSET
        nr = random.randint(lo, hi)
    else:
