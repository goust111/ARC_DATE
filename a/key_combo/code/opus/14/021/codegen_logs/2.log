+ROW_MAJOR_ORDER = (0, 1, 2, 3)
+
+PRIORITY_TO_GAP = {
+    1: (0, 0),  # missing top-left
+    2: (0, 1),  # missing top-right
+    3: (1, 0),  # missing bottom-left
+    4: (1, 1),  # missing bottom-right
