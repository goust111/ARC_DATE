FRAME_COUNTS_BY_GRID = {8: [1, 2], 9: [1, 2], 10: [2, 3], 11: [2, 3], 12: [3]}
# Frame construction and sharing.
INITIAL_FRAME = (0, 0, 5, 5)
FRAME_SIZES = [(5, 5), (5, 5), (4, 5), (5, 4)]
FRAME_SIDES = ("top", "bottom", "left", "right")
