+GAP_TO_PRIORITY = {gap: priority for priority, gap in PRIORITY_TO_GAP.items()}
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_ATTEMPTS = 400
