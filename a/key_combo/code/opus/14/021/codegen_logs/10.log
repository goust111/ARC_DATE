    return sprites, out

def _scatter_sprites(shape, sprites, axis_starts, cross_starts, horizontal):
    inp = np.zeros(shape, dtype=int)
    for sprite, a0, x0 in zip(sprites, axis_starts, cross_starts):
        if horizontal:
