+def _growth_layers(seed_mask: np.ndarray) -> list[np.ndarray]:
+    layers: list[np.ndarray] = []
+    active = seed_mask.copy()
+    while True:
+        children = _children_between_gapped_pairs(active)
+        if not np.any(children):
+            break
+        layers.append(children)
+        active = children
+    return layers
+
