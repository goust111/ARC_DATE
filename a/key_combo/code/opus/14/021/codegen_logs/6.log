    structure: 3-9 consecutive runs of orange separated by exactly 1 green gap each
    run_lengths: 1-7 each
    total_orange_pixels: 9-12
    span: may start/end at grid edge or have 0-3 cell margins on each side
  output_rule:
    below_seed: every 2 rows, place children at midpoints of active-bg-active triplets
    color_alternation: pink (6), orange (7), pink, orange, ...
