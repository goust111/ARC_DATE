+        walls = np.zeros((h, w), dtype=bool)
+        for r in row_lines:
+            walls[r, :] = True
+        for c in col_lines:
+            walls[:, c] = True
+
+        if _count_enclosed_regions(walls) != room_count:
+            continue
+
+        return {
+            "walls": walls,
+            "row_lines": row_lines,
