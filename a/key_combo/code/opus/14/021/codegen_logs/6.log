+from __future__ import annotations
+
+import math
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+FRAME_COLOR_POOL = (BLUE, RED, PINK, ORANGE)
+GEN_RETRIES = 400
