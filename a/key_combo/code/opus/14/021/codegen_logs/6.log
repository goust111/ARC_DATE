+        if len(vals) != 1:
+            return False
+        generated_colors.append(vals[0])
+    if generated_colors[: len(cycle)] != cycle:
+        return False
+    if len(set(generated_colors[: len(cycle)])) != len(cycle):
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    frame_count = random.choice([3, 4])
+    room_counts = [1, 2, 3, 4]
