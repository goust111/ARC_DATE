+    walls = np.zeros_like(mask, dtype=bool)
+
+    for r in hrows:
+        for c0, c1 in zip(vcols, vcols[1:]):
+            seg = mask[r, c0 : c1 + 1]
+            need = max(2, int(math.ceil(0.6 * seg.size)))
+            if int(seg.sum()) >= need:
+                walls[r, c0 : c1 + 1] = True
+
+    for c in vcols:
+        for r0, r1 in zip(hrows, hrows[1:]):
+            seg = mask[r0 : r1 + 1, c]
+            need = max(2, int(math.ceil(0.6 * seg.size)))
+            if int(seg.sum()) >= need:
