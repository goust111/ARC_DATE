        if groupings:
            groups = groupings[int(np.random.randint(len(groupings)))]
            np.random.shuffle(groups)
            return groups
    return [(dim,) for dim in dims]


def _gen_mask_from_rects(dims):
    mask = np.zeros((_GEN_N, _GEN_N), dtype=bool)
