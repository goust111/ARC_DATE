+        if chosen is None:
+            return None
+        _place_patch(grid, forbidden, sprite["patch"], chosen[0], chosen[1])
+
+    if not _valid_scene(grid, answer_direction, require_near_contrast, require_bbox_contrast):
+        return None
+    return grid
+
+
