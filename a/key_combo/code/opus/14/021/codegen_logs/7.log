+def _dim_choices(area: int) -> list[tuple[int, int]]:
+    dims: list[tuple[int, int]] = []
+    for height in (2, 3):
+        for width in (2, 3):
+            if area > height * width:
+                continue
+            if area < height + width - 1:
+                continue
+            dims.append((height, width))
+    return dims
