    pattern = _gen_pattern(selector, main_color, cell_size)
    canvas = np.full(expected.shape, main_color, dtype=int)
    inp = _gen_assemble_input(stamp, pattern, canvas)

    if np.array_equal(main(inp), expected):
        return inp
    return None


