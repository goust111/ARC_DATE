spec:
  grid: 10-19 rows x 10-19 cols, background 0 (black)
  lattice:
    color: 2 (red) [observed]
    pitch: 5 in both dimensions (odd, >=3 required by solver)
    marker_rows: 3-4 evenly spaced rows of single-pixel markers
    marker_cols: 2-4 evenly spaced columns of single-pixel markers
    first_marker: row 0-2, col 0-2
    grid_sized_so: each non-boundary marker has pitch rows and cols of space below-right
  cells:
    definition: a marker (r,c) defines a cell if r+pitch <= H and c+pitch <= W
    count: 6 [observed]; cell_rows x cell_cols in {2x3, 3x2} [observed]
    boundary_markers: last marker row/col may lack room for cells; they serve as visual boundary
  sprites:
    color: 1 (blue) [observed]
    count: one per cell (= 6 [observed])
    bbox: always 2x2
    pixels: 3 (L-triomino, 4 orientations) or 4 (full square); 4-6 triominoes + 0-2 squares per example
    input_offset: top-left of bbox at (1-3, 1-3) relative to cell marker; not all at center
    output_offset: all moved to center (pitch//2, pitch//2) = (2,2), shape preserved
  transform: clear each sprite from input position, repaint at cell center; markers unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick cell_rows x cell_cols from {2x3, 3x2}; set pitch=5
    2. Pick first_marker position (row 0-2, col 0-2)
    3. Compute marker grid; add 0-1 extra boundary marker rows and cols beyond last cell marker
    4. Set grid size = last_marker + 1 + random(0-4) padding per axis, ensuring cell validity
    5. For each cell, pick a random 2x2-bbox sprite (3 or 4 pixels); place at center (2,2) -> this is the output
    6. To build input, copy output and for each sprite, move it from center to a random non-center offset (1-3, 1-3) within the cell; ensure >=4 sprites are off-center
