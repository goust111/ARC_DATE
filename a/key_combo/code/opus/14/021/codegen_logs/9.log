+                break
+            extras.append(cell)
+            blocked_for_extra.add(cell)
+        if len(extras) != extra_needed:
+            continue
+
+        distractors.extend(extras)
+        all_markers = list(layout["valid_markers"]) + distractors
+        if len(set(all_markers)) != len(all_markers):
