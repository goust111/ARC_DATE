  "src": "three single-pixel foreground markers occupying three corners of an axis-aligned square",
  "transform": "preserve the markers, paint grey at the square center, and copy each marker color to the cell one diagonal step from the center toward that marker"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10-14 rows x 10-14 cols, background black (0)
  markers:
    count: exactly 3 single-pixel foreground markers
    placement: occupy exactly 3 of 4 corners of an axis-aligned square
    colors: 3 distinct non-black, non-grey colors
    square_side: even, 6-10, so center is an integer cell
    square_side_min: 4 (room for inward miniature)
    center_cell: must be background in input
    center_neighbors: the 4 diagonal neighbors of center must also be background
  output:
    unchanged: all input pixels preserved
    center: painted grey (5) at square center
    inner_markers: for each of the 3 markers, paint its color at the diagonal neighbor of center toward that marker

generation_strategy:
  approach: direct construction (simple enough, no inversion needed)
  steps:
    1. Pick grid H in [10,14], W in [10,14].
    2. Pick even side S in {6,8,10} and top-left corner (r0,c0) so the square fits with >=1 cell margin on all sides and center + its 4 diagonal neighbors are in-bounds.
    3. Compute 4 corners; remove 1 at random to get 3 marker positions.
    4. Assign 3 distinct colors from {1,2,3,4,6,7,8,9} (exclude black=0, grey=5) to the 3 markers.
    5. Place markers on an all-black grid. Verify center and its diagonal neighbors are background (guaranteed by construction).
```
</generation_spec>
