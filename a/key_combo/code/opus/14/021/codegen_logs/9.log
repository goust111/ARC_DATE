+
+def _build_square_from_anchor(anchor_kind: str, anchor: tuple[int, int], side: int) -> dict[str, tuple[int, int]]:
+    ar, ac = anchor
+    return {
+        label: (ar + side * dr, ac + side * dc)
+        for label, (dr, dc) in CORNER_OFFSETS[anchor_kind].items()
+    }
