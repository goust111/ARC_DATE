+    selected_coords = [tuple(map(int, rc)) for rc in np.argwhere(selected)]
+    outside_coords = [
+        tuple(map(int, rc))
+        for rc in np.argwhere(np.ones((h, w), dtype=bool) & ~selected)
+        if 0 < rc[0] < h - 1 and 0 < rc[1] < w - 1
