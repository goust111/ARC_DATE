+    top_margin = 1
+    left_margin = int(rng.integers(1, 4))
+    row_gaps = [int(rng.integers(1, 3)), int(rng.integers(1, 3))]
+    col_gap = int(rng.integers(1, 3))
+    upper_h = 12 + sum(row_gaps)
+    upper_w = 8 + col_gap
+
+    region_h = int(rng.integers(7, 10))
+    region_w = int(rng.integers(7, 11))
