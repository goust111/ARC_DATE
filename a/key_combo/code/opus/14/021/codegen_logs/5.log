+
+def _build_region(
+    h: int,
+    w: int,
+    color_a: int,
+    color_b: int,
+    row_pairs: list[int],
+    col_pairs: list[int],
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray]:
+    extra_count = int(rng.integers(2, 5))
+    extras = [c for c in SPRITE_PALETTE if c not in {color_a, color_b}]
+    rng.shuffle(extras)
