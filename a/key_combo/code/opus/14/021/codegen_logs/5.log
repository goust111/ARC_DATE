+    for r in row_pairs:
+        region[r, 0] = MARKER_COLOR
+        region[r, w - 1] = MARKER_COLOR
+    for c in col_pairs:
+        region[0, c] = MARKER_COLOR
+        region[h - 1, c] = MARKER_COLOR
