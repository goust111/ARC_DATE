+    row_pairs, col_pairs = [], []
+    if mode == 0:
+        row_pairs = _sample_axis_pairs(region_h, (2, 3), rng)
+    elif mode == 1:
+        col_pairs = _sample_axis_pairs(region_w, (2, 3), rng)
+    else:
