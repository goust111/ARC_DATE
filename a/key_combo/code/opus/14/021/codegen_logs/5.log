+    assert len(candidates) == 1, "expected exactly one 3x2 sprite array"
+    return candidates[0]
+
+
+def _extract_sprite_masks_and_colors(
+    grid: np.ndarray,
+) -> tuple[list[tuple[int, int, int, int]], list[np.ndarray], list[int], int]:
