+def _active_runs(active: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start: int | None = None
+    for idx, value in enumerate(active):
+        if bool(value) and start is None:
+            start = idx
+        elif not bool(value) and start is not None:
