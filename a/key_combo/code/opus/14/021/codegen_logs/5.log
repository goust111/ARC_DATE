+    region[outside_coords[1]] = color_b
+    return region, selected
+
+
+def _build_expected_output(
+    grid: np.ndarray,
+    region_bbox: tuple[int, int, int, int],
+    selected: np.ndarray,
+    color_a: int,
+    color_b: int,
+) -> np.ndarray:
