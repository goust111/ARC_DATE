+    expected_markers = {(r, 0) for r in row_pairs} | {(r, w - 1) for r in row_pairs}
+    expected_markers |= {(0, c) for c in col_pairs} | {(h - 1, c) for c in col_pairs}
+    actual_markers = {
+        (int(r), int(c))
+        for r, c in np.argwhere(region == MARKER_COLOR)
