+    region_out = out[r0 : r1 + 1, c0 : c1 + 1]
+    swap_a = selected & (region == color_a)
+    swap_b = selected & (region == color_b)
+    region_out[swap_a] = color_b
+    region_out[swap_b] = color_a
+    return out
