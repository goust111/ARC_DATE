+        if any(c1 - c0 + 1 != 4 for c0, c1 in col_runs):
+            continue
+        if col_runs[1][0] - col_runs[0][1] - 1 not in (1, 2):
+            continue
+
+        windows = _window_from_runs(trio, col_runs)
