+    src_a, src_b, _dst = _find_union_triple(masks)
+    color_a = colors[src_a]
+    color_b = colors[src_b]
+
+    r0, c0, r1, c1 = _lower_region_bbox(g, sprite_bottom)
+    region = g[r0 : r1 + 1, c0 : c1 + 1]
+    selected = _selected_segment_mask(region)
