+
+def _find_union_triple(masks: list[np.ndarray]) -> tuple[int, int, int]:
+    candidates: list[tuple[int, int, int]] = []
+    for dst in range(len(masks)):
+        for i, j in combinations([k for k in range(len(masks)) if k != dst], 2):
+            mask_i = masks[i]
+            mask_j = masks[j]
