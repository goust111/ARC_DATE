+
+
+def _sample_marker_layout(h: int, w: int, rng: np.random.Generator) -> tuple[list[int], list[int]]:
+    mode = int(rng.integers(3))
+    row_pairs: list[int] = []
+    col_pairs: list[int] = []
+    if mode == 0:
