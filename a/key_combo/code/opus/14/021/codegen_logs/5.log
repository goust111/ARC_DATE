+    region = grid[r0 : r1 + 1, c0 : c1 + 1]
+    region_out = out[r0 : r1 + 1, c0 : c1 + 1]
+    mask_a = selected & (region == color_a)
+    mask_b = selected & (region == color_b)
+    region_out[mask_a] = color_b
+    region_out[mask_b] = color_a
+    return out
