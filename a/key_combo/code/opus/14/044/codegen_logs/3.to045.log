GEN_BACKGROUND, GEN_FOREGROUND, GEN_FRAME = Color.BLACK, Color.RED, Color.GREEN
GEN_NEIGHBOR4_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))
GEN_ORIENTATION_COUNT = 2
GEN_MAX_ATTEMPTS = 300


def _gen_neighbors4(r: int, c: int, h: int, w: int):
