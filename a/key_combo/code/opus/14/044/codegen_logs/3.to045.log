def ring_pixels(b):
    r0,c0,r1,c1=b
    pts=[]
    for c in range(c0,c1+1): pts.append((r0,c)); pts.append((r1,c))
    for r in range(r0+1,r1): pts.append((r,c0)); pts.append((r,c1))
