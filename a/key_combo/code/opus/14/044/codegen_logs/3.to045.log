def search(gap, inner=5):
    step=gap+1
    outer=inner+6*step
    H=W=outer+4
    top=left=2
    boxes=[]
    for i in range(4):
        off=i*step
        boxes.append((top+off,left+off,top+outer-1-off,left+outer-1-off))
    rings=[ring_pixels(b) for b in boxes]
    ring_sets=[set(r) for r in rings]
