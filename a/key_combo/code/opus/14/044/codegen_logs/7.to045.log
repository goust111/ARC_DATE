+        elif side == "bottom":
+            candidates = [(row, visible_proj) for row in layout[side]["depth"]]
+        elif side == "left":
+            candidates = [(visible_proj, col) for col in layout[side]["depth"]]
+        else:
+            candidates = [(visible_proj, col) for col in layout[side]["depth"]]
+        rr, cc = _place_scatter(occupied, candidates)
