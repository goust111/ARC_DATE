+    if side == "top":
+        assert c0 < cc < c1
+        cells = []
+        for cur_r in range(min(rr, r0), max(rr, r0) + 1):
+            if r0 <= cur_r <= r1:
+                if cur_r == r1 and rr > r1:
+                    continue
+                cells.append((cur_r, cc))
+        return cells
+    if side == "bottom":
+        assert c0 < cc < c1
+        cells = []
+        for cur_r in range(min(rr, r1), max(rr, r1) + 1):
