+    out = line_only.copy()
+    h, w = out.shape
+    inner_h = h - 2
+    inner_w = w - 2
+    assert inner_h >= 6 and inner_w >= 8
+    bar_cols = _bar_columns(out.shape)
+    base_row = h - 2
+    for side in SIDE_ORDER:
+        height = counts[side]
+        if height == 0:
+            continue
+        col = bar_cols[side]
