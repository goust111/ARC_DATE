+def _row_candidate(grid: np.ndarray, r: int) -> tuple[int, int, int] | None:
+    cols = np.flatnonzero(grid[r] != BG)
+    if cols.size < 10:
+        return None
+    if not np.all(np.diff(cols) == 1):
