+                if cur_r == r0 and rr < r0:
+                    continue
+                cells.append((cur_r, cc))
+        return cells
+    if side == "left":
+        assert r0 < rr < r1
+        cells = []
+        for cur_c in range(min(cc, c0), max(cc, c0) + 1):
+            if c0 <= cur_c <= c1:
+                if cur_c == c1 and cc > c1:
+                    continue
+                cells.append((rr, cur_c))
+        return cells
