+    color_to_side = {color: side for side, color in side_colors.items()}
+
+    scatters = []
+    for r, c in np.argwhere((g != BG) & ~border):
+        color = int(g[r, c])
+        assert color in color_to_side, f"unexpected scatter color {color}"
