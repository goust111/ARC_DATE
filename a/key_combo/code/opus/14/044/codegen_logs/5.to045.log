+SHAPE_LIBRARY = [
+    _parse_mask(["111"]),
+    _parse_mask(["10", "11"]),
+    _parse_mask(["111", "010"]),
+    _parse_mask(["110", "011"]),
+    _parse_mask(["10", "10", "11"]),
+    _parse_mask(["11", "11", "10"]),
+    _parse_mask(["111", "110"]),
+    _parse_mask(["010", "111", "001"]),
