+    def mark(box: tuple[int, int, int, int]) -> None:
+        r0, c0, r1, c1 = box
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(h - 1, r1 + 1)
+        cc1 = min(w - 1, c1 + 1)
+        blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+    order = sorted(range(len(items)), key=lambda i: (-int(items[i]["mask"].sum()), -items[i]["mask"].shape[0], -items[i]["mask"].shape[1]))
+    for idx in order:
+        mask = items[idx]["mask"]
+        ph, pw = mask.shape
+        candidates = [
