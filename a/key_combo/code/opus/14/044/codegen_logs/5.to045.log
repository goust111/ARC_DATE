+    panel_w = int(_RNG.integers(max(6, max(mask.shape[1] for mask in display_masks.values()) + 2), 9))
+
+    H = int(_RNG.integers(max(20, panel_h + 2), 27))
+    W = int(_RNG.integers(max(22, panel_w + 13), 29))
