+    r0, c0, r1, c1 = box
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    shifted = coords - np.array([r0, c0])
+    out[shifted[:, 0], shifted[:, 1]] = True
+    return out
