+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+
+LEGEND_COLORS = (BLUE, RED, GREEN)
+VALID_COUNT_TRIPLETS = (
+    (1, 2, 4),
+    (1, 2, 5),
