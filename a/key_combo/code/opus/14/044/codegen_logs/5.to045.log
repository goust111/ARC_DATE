+    bins = [min_each] * parts
+    if spare == 0:
+        return bins
+    extras = _RNG.multinomial(spare, np.full(parts, 1 / parts))
+    return [bins[i] + int(extras[i]) for i in range(parts)]
+
+
+def _same_mask(a: np.ndarray, b: np.ndarray) -> bool:
