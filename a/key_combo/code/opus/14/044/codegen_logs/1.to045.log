+    for group in placed_groups:
+        for r, c in group["grey"]:
+            grid[r, c] = GREY
+        for center in group["centers"]:
+            for r, c in _plus_cells(center):
+                if grid[r, c] != BLACK:
+                    raise ValueError("overlapping plus/grey placement")
+                grid[r, c] = GREEN
+        for seg in group["segments"]:
