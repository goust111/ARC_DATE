+
+        h = random.randint(min_dim, 30)
+        w = random.randint(min_dim, 30)
+        placed = _place_groups(groups, h, w)
+        if placed is None:
+            continue
+
+        grid, intended_pairs = _build_input_from_groups(h, w, placed)
