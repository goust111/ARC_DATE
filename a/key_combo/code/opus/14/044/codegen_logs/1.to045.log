+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
