+    return {_area_fill_color(_segment_area(n)) for n in segment_ns}
+
+
+def _validate_instance(grid: np.ndarray, intended_pairs: set, segment_ns: list[int]) -> bool:
+    centers = _detect_plus_centers(grid)
+    if not (4 <= len(centers) <= 6):
