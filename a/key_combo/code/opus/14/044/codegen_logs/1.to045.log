+    for pair in actual_pairs:
+        weaker_grid, gap_map = _draw_connectors(grid, skip_pair=pair)
+        if set(gap_map) != actual_pairs:
+            return False
+        weaker_output = _fill_enclosed_regions(weaker_grid)
+        if np.array_equal(weaker_output, full_output):
+            return False
