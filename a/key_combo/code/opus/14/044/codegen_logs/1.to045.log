+        random.shuffle(segment_ns)
+        chains = [segment_ns]
+    elif pattern == "chain3_pair":
+        segment_ns = [small_n, 4, 5]
+        random.shuffle(segment_ns)
+        chains = [segment_ns[:2], segment_ns[2:]]
+    else:
+        extra_n = random.choice((2, 3, 4, 5))
