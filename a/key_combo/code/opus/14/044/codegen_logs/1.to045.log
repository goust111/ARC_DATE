import numpy as np
from collections import deque

def enclosed(g):
    H,W=g.shape;seen=np.zeros((H,W),bool);out=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]"'!=0 or seen[r,c]:continue
            q=deque([(r,c)]);seen[r,c]=1;comp=[];touch=False
            while q:
                x,y=q.popleft();comp.append((x,y))
                if x in (0,H-1) or y in (0,W-1): touch=True
                for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not seen[nx,ny]: seen[nx,ny]=1;q.append((nx,ny))
            if not touch: out.append(comp)
    return out

def plus(g,r,c):
    for dr,dc in [(0,0),(-1,0),(1,0),(0,-1),(0,1)]: g[r+dr,c+dc]=3

for n in [2,3,4,5]:
    H=W=25;g=np.zeros((H,W),int)
    s=3; d=n+5
    plus(g,s,s); plus(g,s+d,s+d)
    # frame around subsegment starting at k=3 len n
    base=s+2
    for c in range(base+1, base+n+3): g[base, c]=5
    for r in range(base+1, base+n+2): g[r, base]=5
    for r in range(base, base+n+1): g[r, base+n+1]=5
    for c in range(base, base+n+1): g[base+n+1, c]=5
    print('"'n',n,'prem',sorted(len(c) for c in enclosed(g)))
    for k in range(1,d): g[s+k,s+k]=2
    print(' after',sorted(len(c) for c in enclosed(g)))
