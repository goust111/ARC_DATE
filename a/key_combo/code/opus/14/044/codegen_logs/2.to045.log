{
  "type": "transform_in_place",
  "src": "4-connected red foreground objects on a black background",
  "transform": "preserve all pixels; for each two-pixel horizontal/vertical red object, paint green on the perimeter of its bbox expanded by one cell and clipped to the grid; leave single red pixels unframed"
}
</annotation>
