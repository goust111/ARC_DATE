    ec0 = max(0, c0 - 1)
    er1 = min(h - 1, r1 + 1)
    ec1 = min(w - 1, c1 + 1)
    assert er0 <= er1 and ec0 <= ec1

    for r in range(er0, er1 + 1):
        for c in range(ec0, ec1 + 1):
            if r in (er0, er1) or c in (ec0, ec1):
                if out[r, c] == Color.BLACK:
                    out[r, c] = Color.GREEN


