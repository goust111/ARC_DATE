+                        expected = np.ones((order, order), dtype=bool)
+                        expected[tile_r, tile_c] = False
+                        if not np.array_equal(sub, expected):
+                            valid = False
+                            break
+                        present_tiles.add((tile_r, tile_c))
+                        row_seen[tile_r] = True
+                        col_seen[tile_c] = True
+                    if not valid:
