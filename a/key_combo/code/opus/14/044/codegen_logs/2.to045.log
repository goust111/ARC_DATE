    return canvas


def _gen_build_output_groups(colors):
    groups = []
    left_row = random.randrange(GEN_HEIGHT)
    for color in colors:
        group = _gen_random_group(left_row, color)
        groups.append(group)
        left_row = _gen_endpoint_row(group, "right")

