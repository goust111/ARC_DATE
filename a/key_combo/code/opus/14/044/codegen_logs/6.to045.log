+    for i, (color, width, height) in enumerate(zip(colors, slot_widths, final_heights)):
+        key = (color * 13 + width * 7 + height * axis_term + i * 17) % 97
+        keys.append((int(key), i))
+    return [idx for _key, idx in sorted(keys)]
