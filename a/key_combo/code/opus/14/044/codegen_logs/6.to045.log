+
+def _transform_rectangles(rects: list[dict], blue_vertical: bool) -> list[dict]:
+    out: list[dict] = []
+    for rect in rects:
+        patch = np.rot90(rect["patch"], 1) if blue_vertical else rect["patch"].copy()
+        h, w = patch.shape
+        out.append(
+            {
+                "source_bbox": rect["bbox"],
+                "color": rect["color"],
+                "patch": patch,
+                "height": int(h),
+                "width": int(w),
+            }
+        )
+    return out
