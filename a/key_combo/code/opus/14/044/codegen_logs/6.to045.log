+from __future__ import annotations
+
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREY = 5
+MAROON = 9
+RECT_PALETTE = (3, 4, 6, 7)
+STRUCTURAL = {BG, BLUE, RED, GREY, MAROON}
+MAX_GEN_ATTEMPTS = 400
+WIDTH_SETS = {
+    3: [2, 3, 4],
+    4: [1, 2, 3, 4],
+}
