+    return {
+        "height": height,
+        "width": width,
+        "blue_vertical": bool(blue_vertical),
+        "frame_r0": frame_r0,
+        "frame_c0": frame_c0,
+        "frame_h": frame_h,
+        "frame_w": frame_w,
+        "inner_h": inner_h,
+        "rect_specs": rect_specs,
+        "rect_positions": rect_positions,
+        "slot_specs": slot_specs,
+    }
