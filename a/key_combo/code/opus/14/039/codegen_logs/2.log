+import random
+from collections import deque
+
+import numpy as np
+
+
+Color = type(
+    "Color",
+    (),
+    {
+        "BLACK": 0,
+        "BLUE": 1,
+        "RED": 2,
+        "GREEN": 3,
+        "YELLOW": 4,
+        "GREY": 5,
+        "PINK": 6,
+        "ORANGE": 7,
