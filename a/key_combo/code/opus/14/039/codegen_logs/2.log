0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Extend the central bottom bar color into the flanking columns as an upward stepped outline.
0016: 
0017:     Input structure
0018:     - The grid has a background and exactly two foreground colors.
0019:     - The bottom row is all foreground: one color forms a single interior contiguous bar, and the other color flanks it.
0020:     - The interior bottom bar color is the color that gets extended; the flanking color remains unchanged.
0021: 
0022:     Rule
0023:     - Keep the input unchanged, then add one bottom-bar-colored pixel in every bottom-row flanking column.
0024:     - For each flanking column, compute its horizontal distance to the nearest end of the interior bar.
0025:     - Place the new pixel in that same column, one row above the bottom for each distance step, with an additional one-row gap above the bottom row.
0026: 
0027:     Key insight
0028:     - The bottom row is a ruler: distance from the central bar determines how high the matching color is lifted in each side column.
0029:     """
0030:     g = np.asarray(grid, dtype=int)
0031:     assert g.ndim == 2, "expected a 2D grid"
0032:     height, width = map(int, g.shape)
0033: 
0034:     bg = get_bg(g)
0035:     colors = colors_present(g, exclude={bg})
0036:     assert len(colors) == 2, "expected exactly two foreground colors"
0037: 
0038:     bottom = g[height - 1, :]
0039:     assert np.all(bottom != bg), "expected a fully foreground bottom row"
0040: 
0041:     extension_candidates = []
0042:     for color in colors:
0043:         cols = np.flatnonzero(bottom == color)
0044:         if _is_contiguous(cols) and 0 < int(cols[0]) and int(cols[-1]) < width - 1:
0045:             extension_candidates.append(int(color))
0046: 
0047:     assert len(extension_candidates) == 1, "expected exactly one interior bottom bar color"
0048:     extension_color = extension_candidates[0]
0049:     flanking_color = [int(color) for color in colors if int(color) != extension_color]
0050:     assert len(flanking_color) == 1, "expected one flanking color"
0051:     flanking_color = flanking_color[0]
0052: 
0053:     bar_cols = np.flatnonzero(bottom == extension_color)
0054:     assert _is_contiguous(bar_cols), "extension color must form one bottom bar"
0055:     left = int(bar_cols[0])
0056:     right = int(bar_cols[-1])
0057: 
0058:     out = g.copy()
0059:     for col_raw in np.flatnonzero(bottom == flanking_color):
0060:         col = int(col_raw)
