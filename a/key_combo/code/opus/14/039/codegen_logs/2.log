+
+            sweep = _sweep_set(coords, direction, shift)
+            moved_set = _coord_set(moved)
+            conflict = False
+            for other_final, other_sweep in zip(existing_finals, existing_sweeps):
+                if sweep & other_final or other_sweep & moved_set:
+                    conflict = True
+                    break
+            if conflict:
