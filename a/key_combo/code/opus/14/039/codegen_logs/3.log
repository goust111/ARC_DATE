+        objects.append(
+            {
+                "bar_bbox": (r0, c0, r1, c1),
+                "orientation": orient,
+                "length": int(length),
+                "motif_bbox": motif_box,
+                "motif": motif,
+                "normalized": normalized,
+                "union_bbox": union_box,
