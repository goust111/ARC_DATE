+    assert np.any(patch[-1] != BG) and np.any(patch[:, -1] != BG), "motif must use its full bbox"
+    return patch
+
+
+def _build_local_object(spec: dict) -> np.ndarray:
+    motif = spec["motif"]
+    length = int(spec["length"])
+    mh, mw = map(int, motif.shape)
+    if spec["orientation"] == "h":
