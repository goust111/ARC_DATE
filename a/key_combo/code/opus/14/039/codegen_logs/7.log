+GRID_HEIGHT_RANGE = (13, 19)
+GRID_WIDTH_MAX = 26
+INPUT_RECT_HEIGHT_RANGE = (2, 6)
+INPUT_RECT_WIDTH_RANGE = (1, 4)
+INPUT_COLOR_POOL = tuple(range(1, 10))
