+    cols = random.randint(cols_min, cols_max)
+
+    if not _place_rectangles(rectangles, rows, cols):
+        return None
+
+    grid = _paint_input(rectangles, rows, cols)
+    if not _semantic_checks(grid):
+        return None
+    return grid
