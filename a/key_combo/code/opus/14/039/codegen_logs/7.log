+    if np.array_equal(_build_output(kept, swap=False, order_key=lambda rect: rect["x"]), expected):
+        return False
+    if np.array_equal(_build_output(_row_major_order(kept), swap=True, order_key=lambda rect: (rect["y"], rect["x"])), expected):
