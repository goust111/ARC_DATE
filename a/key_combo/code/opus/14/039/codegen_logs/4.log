+    n = out.shape[0]
+    inset = (n - size) // 2
+    lo = inset
+    hi = inset + size - 1
+    out[lo, lo : hi + 1] = color
+    out[hi, lo : hi + 1] = color
+    out[lo : hi + 1, lo] = color
+    out[lo : hi + 1, hi] = color
+
+
+def _build_output_from_layers(layers: list[tuple[int, int]]) -> np.ndarray:
