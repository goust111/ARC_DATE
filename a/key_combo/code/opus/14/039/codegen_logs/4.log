+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _analyze_grid(grid: np.ndarray) -> dict[int, dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    info: dict[int, dict[str, object]] = {}
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != BACKGROUND):
+        mask = g == color
+        coords = np.argwhere(mask)
+        comps = _components_mask(mask)
+        bbox = _bbox_from_coords(coords)
+        h = bbox[2] - bbox[0] + 1
+        w = bbox[3] - bbox[1] + 1
+        info[color] = {
+            "color": color,
+            "coords": coords,
+            "components": comps,
+            "areas": [int(comp.shape[0]) for comp in comps],
+            "count": len(comps),
+            "bbox": bbox,
+            "height": h,
+            "width": w,
+            "size": max(h, w),
+            "pixels": int(coords.shape[0]),
