9:def main(grid: np.ndarray) -> np.ndarray:
10-    """
11-    Summarize the largest foreground object-size class as solid vertical color bars.
12-
13-    Input structure:
14-    - The input has a dominant background color and several monochromatic
15-      4-connected foreground objects.
16-    - Each foreground color appears as exactly one object.
17-    - The largest objects have distinct left edges, giving a unique left-to-right
18-      ordering.
19-
20-    Rule:
21-    - Find the maximum foreground object area.
22-    - Keep exactly the objects with that area.
23-    - Build an output whose height is that maximum area and whose columns are
24-      filled with the kept object colors in left-to-right input order.
25-
26-    Key insight:
27-    - The original shapes are distractors; only object area and horizontal order
28-      survive, so each selected object collapses to a same-color vertical bar.
29-    """
30-    g = np.asarray(grid, dtype=int)
31-    assert g.ndim == 2, "expected a 2D grid"
32-
33-    bg = get_bg(g)
34-    objects = find_components(
35-        g,
36-        bg=bg,
37-        connectivity=4,
38-        monochromatic=True,
39-        return_format="dict",
40-    )
41-    assert objects, "expected at least one foreground object"
42-
43-    colors = [int(obj["color"]) for obj in objects]
44-    assert len(colors) == len(set(colors)), "each foreground color must form one object"
45-
46-    max_area = max(int(obj["area"]) for obj in objects)
47-    largest = [obj for obj in objects if int(obj["area"]) == max_area]
48-
49-    left_edges = [int(obj["bbox"][1]) for obj in largest]
50-    assert len(left_edges) == len(
51-        set(left_edges)
52-    ), "largest objects need unique left-to-right order"
53-    largest.sort(key=lambda obj: int(obj["bbox"][1]))
54-
55-    out = np.empty((max_area, len(largest)), dtype=int)
56-    for col, obj in enumerate(largest):
57-        out[:, col] = int(obj["color"])
58-    return out
