14:def main(input_grid):
15-    """
16-    Output a vertical list of rectangle colors ordered by frequency after skipping the most common.
17-
18-    Input structure:
19-    - The grid contains separated monochromatic rectangle objects on a black background.
20-    - Rectangles are arranged in an array and colored from several non-black colors.
21-    - Color frequency is measured by object count, not pixel count.
22-
23-    Rule:
24-    - Detect each rectangle object and record its non-black color.
25-    - Sort colors by how many rectangles have that color.
26-    - Drop the most frequent color and write the remaining colors top to bottom in a one-column grid.
27-
28-    Key insight:
29-    - The output is a rank summary of object colors, so rectangle positions and dimensions
30-      are discarded after counting.
31-    """
32-    # Plan:
33-    # 1. Extract the objects, arranged into the array
34-    # 2. Count the colors
35-    # 3. Sort the colors by count
36-    # 4. Create the output grid, remembering to skip the most common color
37-
38-    background = Color.BLACK
39-    
40-    objects = find_components(input_grid, bg=background, monochromatic=True, connectivity=4, return_format="objects")
41-
42-    # Count colors per rectangle object (each object is monochromatic).
43-    obj_colors = []
44-    for obj in objects:
45-        cols = set(map(int, np.unique(obj))) - {background}
46-        if cols:
47-            obj_colors.append(next(iter(cols)))
48-
49-    color_counts = {c: obj_colors.count(c) for c in set(obj_colors)}
50-    sorted_colors = sorted(color_counts, key=lambda c: color_counts[c], reverse=True)
51-
52-    # Skip the most common color.
53-    sorted_colors = sorted_colors[1:]
54-
55-    # Output is a vertical stripe: one pixel per remaining color.
