+
+
+def _sample_retained_sizes(rng: np.random.Generator, retained_count: int) -> list[int]:
+    need_tight = bool(rng.integers(2))
+    need_gap = bool(rng.integers(2))
+    if not need_tight and not need_gap:
+        need_tight = True
+        need_gap = True
