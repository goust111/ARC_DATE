+        if not exact_match:
+            return None
+
+    out = _assemble_output(base, schedule)
+    for i in range(TILE_ROWS):
+        for j in range(TILE_COLS):
+            block = grid[
+                i * TILE_SIZE : (i + 1) * TILE_SIZE,
+                j * TILE_SIZE : (j + 1) * TILE_SIZE,
+            ]
+            target = out[
+                i * TILE_SIZE : (i + 1) * TILE_SIZE,
+                j * TILE_SIZE : (j + 1) * TILE_SIZE,
+            ]
+            if np.any((block != BG) & (block != target)):
+                return None
+    return base, out
+
+
