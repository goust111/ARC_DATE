    """Sample RECT_COUNT sizes with total area in the configured coverage band."""
    memo = {}
    def can_fill(count, total):
        key = (count, total)
        if key not in memo:
            if count == 0:
                memo[key] = total == 0
            elif total < RECT_MIN_AREA * count or total > RECT_MAX_AREA * count:
