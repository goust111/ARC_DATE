+        return None
+    return tile
+
+
+def _parity_positions() -> list[list[tuple[int, int]]]:
+    groups = [[] for _ in range(4)]
+    for i in range(TILE_ROWS):
+        for j in range(TILE_COLS):
+            groups[_parity_index(i, j)].append((i, j))
+    return groups
+
+
