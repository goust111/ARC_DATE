    assert get_bg(template) == bg
    rr = np.arange(g.shape[0]) % template.shape[0]
    cc = np.arange(g.shape[1]) % template.shape[1]
    out = template[np.ix_(rr, cc)]
    assert np.array_equal(out[g != UNKNOWN], g[g != UNKNOWN])
    return out

