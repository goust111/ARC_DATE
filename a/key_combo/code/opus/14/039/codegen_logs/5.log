+    normalized_by_parity: list[list[np.ndarray]] = [[] for _ in range(4)]
+
+    for i in range(TILE_ROWS):
+        for j in range(TILE_COLS):
+            p = _parity_index(i, j)
+            normalized_by_parity[p].append(_rotate(tiles[i][j], -schedule[p]))
