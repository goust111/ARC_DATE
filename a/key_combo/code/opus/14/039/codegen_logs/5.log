+    full_parity = [0, 0, 0, 0]
+    choices = [pos for pos in positions if pos not in protected]
+    random.shuffle(choices)
+    for pos in choices:
+        p = _parity_index(*pos)
+        if full_parity[p] >= 2:
+            continue
+        full_tiles.append(pos)
+        full_parity[p] += 1
+        if len(full_tiles) == full_count:
+            break
