+            out[
+                i * TILE_SIZE : (i + 1) * TILE_SIZE,
+                j * TILE_SIZE : (j + 1) * TILE_SIZE,
+            ] = _rotate(base, k)
+    return out
+
+
+def _infer_candidate(
+    grid: np.ndarray, schedule: tuple[int, int, int, int]
+) -> tuple[np.ndarray, np.ndarray] | None:
