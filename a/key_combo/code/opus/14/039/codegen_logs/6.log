        pr, pc = path[i - 1]
        nr, nc = path[(i + 1) % n]
        incoming = (r - pr, c - pc)
        outgoing = (nr - r, nc - c)
        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
        if cross:
            counts[1 if cross > 0 else -1] += 1
    convex = max(counts.values())
    concave = min(counts.values())
    return len(path), convex, concave


