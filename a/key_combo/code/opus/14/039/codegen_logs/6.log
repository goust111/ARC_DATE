+        return None
+
+    colors = [int(scene["template"]["color"])] + [int(comp["color"]) for comp in scene["outside"]]
+    if len(colors) != len(set(colors)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
