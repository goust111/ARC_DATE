+    obj_bbox = _bbox_from_coords(coords)
+    distance = _distance_key(obj_bbox, frame_bbox)
+    if distance < 2:
+        return False, distance
+    h, w = grid_shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
