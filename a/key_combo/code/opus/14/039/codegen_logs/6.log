+
+
+def _candidate_positions(
+    shape: tuple[tuple[int, int], ...],
+    occupied: np.ndarray,
+) -> list[tuple[int, int, np.ndarray]]:
+    h, w = occupied.shape
+    sh, sw = _shape_dims(shape)
+    out = []
+    for top in range(h - sh + 1):
+        for left in range(w - sw + 1):
