+def _is_connected_shape(shape_cells: tuple[tuple[int, int], ...]) -> bool:
+    cells = set(shape_cells)
+    seen = {next(iter(cells))}
+    q = deque(seen)
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
