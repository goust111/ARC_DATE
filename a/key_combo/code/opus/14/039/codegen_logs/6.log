+        cc = int(c)
+        for k in range(1, distance + 1):
+            for nr, nc in ((rr - k, cc), (rr + k, cc), (rr, cc - k), (rr, cc + k)):
+                if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1] and (nr, nc) not in protected:
+                    out[nr, nc] = RAY_COLOR
