+    return coords
+
+
+def _cells_clear(coords: np.ndarray, occupied: np.ndarray, gap: int = 1) -> bool:
+    h, w = occupied.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        for nr in range(max(0, rr - gap), min(h, rr + gap + 1)):
+            for nc in range(max(0, cc - gap), min(w, cc + gap + 1)):
+                if occupied[nr, nc]:
