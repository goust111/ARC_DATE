    shape: solid filled rectangle, single non-bg color (grey/5 [observed])
    size: 3-17 wide x 4-9 tall
    position: bottom row always touches grid bottom; >=1 row of bg above for markers
    side_clearance: >=1 col of bg on exit side (so teal can land outside the rect)
  markers:
    count: exactly 1 red (2) and 1 teal (8), each a single cell
