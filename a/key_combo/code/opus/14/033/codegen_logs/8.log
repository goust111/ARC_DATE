+
+    heights = _sample_frame_sizes(rng, count)
+    widths = _sample_frame_sizes(rng, count)
+    usable_cols = w - 2
+    need = sum(widths) + LANE_GAP * (count - 1)
+    if need > usable_cols:
+        return None
+    slack = usable_cols - need
+    col_extras = _random_partition(rng, slack, count + 1)
+
+    frames = []
+    cur = 1 + col_extras[0]
+    for i in range(count):
