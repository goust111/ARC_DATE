+import numpy as np
+
+
+BLACK = 0
+RED = 2
+ORANGE = 7
+TEAL = 8
+
+EDGE_SIDES = ("top", "bottom", "left", "right")
+EDGE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+TOUCH_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+
+GRID_MIN = 17
+GRID_MAX = 22
+FRAME_SIZE_MIN = 5
+FRAME_SIZE_MAX = 7
+FRAME_COUNT_CHOICES = (2, 3)
+LANE_GAP = 2
+GEN_ATTEMPTS = 400
