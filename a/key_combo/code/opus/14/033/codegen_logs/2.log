+    r1, c1 = map(int, grey_coords.max(axis=0))
+
+    sep_rows = [r for r in range(r0, r1 + 1) if np.all(grid[r, c0 : c1 + 1] == GREY)]
+    sep_cols = [c for c in range(c0, c1 + 1) if np.all(grid[r0 : r1 + 1, c] == GREY)]
