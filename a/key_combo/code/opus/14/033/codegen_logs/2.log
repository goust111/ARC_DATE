+
+BLACK = 0
+BLUE = 1
+GREY = 5
+PALETTE = (2, 3, 4, 6, 7, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATE_ATTEMPTS = 400
