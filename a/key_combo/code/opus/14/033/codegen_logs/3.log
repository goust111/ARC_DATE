+    mask = np.zeros((H, W), dtype=bool)
+    for r, c in full_cells:
+        mask[r, c] = True
+
+    if axis == "horizontal":
+        assert np.all(mask[r0 : r1 + 1, c0 : c1 + 1])
+        assert np.all(mask[mirror_r0 : mirror_r0 + occ_h, c0 : c1 + 1])
+        if np.array_equal(mask, np.fliplr(mask)):
