                continue
            for sr, sc in ((mirror_sum - r, c), (r, mirror_sum - c)):
                if not (0 <= sr < height and 0 <= sc < width):
                    continue
                if int(g[sr, sc]) == marker:
                    continue
                assert int(g[sr, sc]) == int(g[r, c]), "visible cells must obey the virtual fold"


