+            return None
+        h = int(rng.integers(min_h, min(25, min_h + 6)))
+        min_w = max(12, sw + 3)
+        w = int(rng.integers(min_w, min(21, max(min_w + 1, min_w + 7))))
+    else:
+        min_w = max(10, span + gap + sw + 1)
+        if min_w > 24:
