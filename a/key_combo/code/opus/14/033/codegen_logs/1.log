  grid: 6-12 rows x 10-13 cols, background=0 [observed]
  colors: exactly 2 foreground colors; one is the sprite (color 4 [observed]), one is the marker (color 6 [observed])
  sprite:
    bbox: 3-5 rows x 3-7 cols
    density: 50-61% of bbox filled
    symmetry: neither LR nor UD symmetric (required for non-trivial output)
    connectivity: 1-3 connected components allowed
  marker:
    shape: T or + with exactly 1 junction cell (degree >= 3)
    arms: all pixels lie on same row or column as junction (axis-aligned cross)
    longest_arm: exactly 1 arm of length 2 (uniquely longest)
    other_arms: each length 0 or 1; the two perpendicular arms are always 1; opposite arm is 0 or 1
    pixel_count: 5 (T-shape) or 6 (+-shape)
  layout:
    sprite and marker bboxes do not overlap
    min pixel distance between them >= 2
    grid has enough space adjacent to sprite bbox in the copy direction for the reflected copy (>= sprite height or width)
  transform:
    stem = direction of longest marker arm
    copy_direction = rotate stem 90 degrees via (dr,dc)->(-dc,dr)
    mirror sprite with flipud (if copy is up/down) or fliplr (if copy is left/right)
    paste reflected copy adjacent to sprite on that side; erase marker

generation_strategy:
