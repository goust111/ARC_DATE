+    sh, sw = sprite.shape
+    if edge == "top":
+        r0 = stripe_span + gap
+        c0 = int(rng.integers(1, w - sw))
+    elif edge == "bottom":
+        r0 = h - stripe_span - gap - sh
+        c0 = int(rng.integers(1, w - sw))
+    elif edge == "left":
