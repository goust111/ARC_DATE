+import numpy as np
+
+
+BLACK = 0
+RED = 2
+STRIPE_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+_SEEN_INPUT_SIGS: set[str] = set()
+_SEEN_OUTPUT_SIGS: set[str] = set()
