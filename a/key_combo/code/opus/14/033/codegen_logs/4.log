+    for frame in frame_specs:
+        frame["count"] = random.randint(1, min(frame["inner_h"] - 1, 4))
+
+    full_candidates = [frame for frame in frame_specs if frame["inner_h"] <= 4]
+    if full_candidates and random.random() < 0.45:
