        r += band_h
        if band_i + 1 < len(groups):
            r += MIN_BBOX_GAP + row_gaps[band_i + 1]
    return bboxes


def _gen_col_layout(rows, cols, count):
    groups = _gen_group_counts(count)
    col_plan = _gen_partition_axis(cols, len(groups), *FRAME_WIDTH_RANGE)
