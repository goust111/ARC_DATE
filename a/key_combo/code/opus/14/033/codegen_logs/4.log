+    bottom_sizes = [(random.randint(5, 7), random.randint(5, 7)) for _ in range(bottom_n)]
+
+    max_top_h = max(h for h, _w in top_sizes)
+    max_bottom_h = max(h for h, _w in bottom_sizes)
