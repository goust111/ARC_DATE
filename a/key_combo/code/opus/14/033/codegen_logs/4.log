+    cell: tuple[int, int], bbox: tuple[int, int, int, int]
+) -> tuple[int, int]:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    dr = 0 if r0 <= r <= r1 else min(abs(r - r0), abs(r - r1))
+    dc = 0 if c0 <= c <= c1 else min(abs(c - c0), abs(c - c1))
+    return dr, dc
+
