        for r, c in pts:
            marker = (r, c)
            in_bounds = 0 <= r < _GEN_GRID_SIZE and 0 <= c < _GEN_GRID_SIZE
            if not in_bounds or marker in marker_seen:
                return None
            marker_seen.add(marker)
            inp[marker] = color
    return inp, out

