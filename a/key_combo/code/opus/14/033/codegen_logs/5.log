+    active_group = random.choice([False, True])
+    active_cells = [
+        (i, j) for i in range(rows) for j in range(cols) if bool(mask[i, j]) == active_group
+    ]
+    inactive_cells = [
+        (i, j) for i in range(rows) for j in range(cols) if bool(mask[i, j]) != active_group
+    ]
+    if len(active_cells) < 2 or len(inactive_cells) < 2:
