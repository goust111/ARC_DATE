+RING: tuple[tuple[int, int], ...] = (
+    (0, 2),
+    (0, 3),
+    (1, 1),
+    (1, 4),
+    (2, 0),
+    (2, 5),
+    (3, 0),
+    (3, 5),
+    (4, 1),
+    (4, 4),
+    (5, 2),
+    (5, 3),
+)
