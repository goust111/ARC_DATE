+def _find_fragments(
+    grid: np.ndarray,
+) -> dict[int, tuple[tuple[int, int], set[tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
+    fragments: dict[int, tuple[tuple[int, int], set[tuple[int, int]]]] = {}
+    for color in np.unique(g):
+        color = int(color)
