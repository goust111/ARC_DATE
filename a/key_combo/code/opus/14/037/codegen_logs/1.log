+def _is_connected(coords_set: set[tuple[int, int]]) -> bool:
+    if not coords_set:
+        return False
+    start = next(iter(coords_set))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nbr in _neighbors4(r, c):
