+        movable = _objects_that_can_shift_down(objects, occ, static_mask)
+        if not movable:
+            break
+        for idx in movable:
+            objects[idx]["coords"][:, 0] += 1
+    else:
+        raise AssertionError("downward gravity did not settle")
