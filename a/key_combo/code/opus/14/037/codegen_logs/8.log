+    palette = random.sample(SOURCE_COLORS, color_count)
+    patch = np.zeros(mask.shape, dtype=int)
+
+    mandatory_indices = random.sample(range(len(coords)), color_count)
+    for color, idx in zip(palette, mandatory_indices):
