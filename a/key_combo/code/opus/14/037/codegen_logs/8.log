+def _occupancy(shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    occ = np.full(shape, -1, dtype=int)
+    for idx, obj in enumerate(objects):
+        coords = obj["coords"]
+        assert np.all(occ[coords[:, 0], coords[:, 1]] == -1), "moving objects must not overlap"
