+    out = np.full(shape, BG, dtype=int)
+    for obstacle in obstacles:
+        out[obstacle["coords"][:, 0], obstacle["coords"][:, 1]] = OBSTACLE
+
+    for obj in objects:
+        coords = obj["coords"]
+        values = obj["values"]
+        assert not np.any(static_mask[coords[:, 0], coords[:, 1]]), "settled object overlaps an obstacle"
