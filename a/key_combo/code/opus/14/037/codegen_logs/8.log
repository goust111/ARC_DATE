+def _spans_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return not (a1 < b0 or b1 < a0)
+
+
+def _bbox_overlap(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = box_a
