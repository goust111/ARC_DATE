  grid: 5-12 rows x 9-12 cols
  background: black (0)
  foreground_colors: exactly 2 distinct non-black colors (color_A = ring, color_B = center)
  frame:
    shape: 3x3 with all 8 border pixels = color_A, center pixel = color_B
    count: exactly 1 valid frame in the entire grid
    placement: at least 1 cell from every grid edge (center at rows 1..H-2, cols 1..W-2)
  scattered_pixels:
    color_A: 0-12 additional pixels beyond the 8 in the frame [observed]
    color_B: 7-12 additional pixels beyond the 1 in the frame
    no subset of scattered pixels may form another valid 3x3 monochrome-ring frame
  fg_density: 0.20-0.36 of total cells [observed]
  output: 1x1 grid containing color_B (the frame center color)

generation_strategy:
  approach: direct construction (simple task, low rejection risk)
