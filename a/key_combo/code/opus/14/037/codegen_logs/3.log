0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """Tile each rectangular non-wall cavity with the colored seed pattern it already contains.
0019: 
0020:     Input structure
0021:     - The dominant color forms solid walls around one or more rectangular cavities.
0022:     - A unique most common non-wall color is the empty cavity color.
0023:     - Each cavity contains exactly one other color, arranged as one copy of a repeat tile.
0024: 
0025:     Rule
0026:     - For each 4-connected non-wall cavity, take the bbox of its seed color as the tile.
0027:     - Repeat that tile across the entire cavity, preserving the phase set by the seed's current position.
0028:     - Leave wall cells unchanged and leave tile-empty positions as the empty cavity color.
0029: 
0030:     Key insight
0031:     - The colored pixels are not moved objects; they are one visible instance of a periodic mask that fills its containing rectangle.
0032:     """
0033:     g = np.asarray(grid, dtype=int)
0034:     wall = get_bg(g)
0035:     non_wall_colors = colors_present(g, exclude={wall})
0036:     assert len(non_wall_colors) >= 2
0037:     empty = _unique_most_common(g, non_wall_colors)
0038: 
0039:     out = g.copy()
0040:     labels, n_regions = label_mask(g != wall, connectivity=4)
0041:     assert n_regions >= 1
0042: 
0043:     for region_id in range(1, n_regions + 1):
0044:         region_mask = labels == region_id
0045:         region_bbox = bbox(region_mask)
0046:         assert region_bbox is not None
0047:         r0, c0, r1, c1 = region_bbox
0048:         assert region_mask[r0 : r1 + 1, c0 : c1 + 1].all()
0049: 
0050:         region_colors = set(map(int, g[region_mask]))
0051:         assert empty in region_colors
0052:         seed_colors = region_colors - {empty}
0053:         assert len(seed_colors) == 1
0054:         seed_color = seed_colors.pop()
0055: 
0056:         seed_bbox = bbox((g == seed_color) & region_mask)
0057:         assert seed_bbox is not None
0058:         sr0, sc0, sr1, sc1 = seed_bbox
0059:         tile = g[sr0 : sr1 + 1, sc0 : sc1 + 1]
0060:         assert set(map(int, tile.ravel())) <= {empty, seed_color}
0061: 
0062:         tile_h, tile_w = tile.shape
0063:         region_h, region_w = r1 - r0 + 1, c1 - c0 + 1
0064:         assert region_h % tile_h == 0
0065:         assert region_w % tile_w == 0
0066:         assert (sr0 - r0) % tile_h == 0
0067:         assert (sc0 - c0) % tile_w == 0
0068: 
0069:         rr = np.arange(r0, r1 + 1)[:, None]
0070:         cc = np.arange(c0, c1 + 1)[None, :]
0071:         out[r0 : r1 + 1, c0 : c1 + 1] = tile[(rr - sr0) % tile_h, (cc - sc0) % tile_w]
0072: 
0073:     return out
0074: 
