+    other = VERTICAL if start == HORIZONTAL else HORIZONTAL
+    seq = [start if i % 2 == 0 else other for i in range(h_count + v_count)]
+    assert seq.count(HORIZONTAL) == h_count
+    assert seq.count(VERTICAL) == v_count
+    return seq
