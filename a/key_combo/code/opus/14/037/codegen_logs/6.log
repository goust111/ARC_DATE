+
+    residue_counts = np.zeros((p, p), dtype=int)
+    for r, c in np.argwhere(base):
+        residue_counts[r % p, c % p] += 1
+    for r, c in np.argwhere(tile):
+        if residue_counts[r, c] < 2:
+            return False
+
+    rescued = 0
+    deleted = 0
+    deleted_legal = 0
+    for r, c in np.argwhere(suspects):
+        if clean_mask[r, c]:
+            if out[r, c] != fg:
