+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+MAX_GENERATION_ATTEMPTS = 400
+PERIOD_CHOICES = (3, 4)
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (12, 18)
+FG_CHOICES = tuple(range(1, 10))
+NOISE_LENGTHS = (2, 3, 4)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
