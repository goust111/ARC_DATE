+
+
+def _grid_from_mask(mask: np.ndarray, fg: int) -> np.ndarray:
+    out = np.zeros(mask.shape, dtype=int)
+    out[mask] = fg
+    return out
+
+
+def _validate_case(inp: np.ndarray, clean_mask: np.ndarray, tile: np.ndarray, p: int) -> bool:
+    fg = _fg_color(inp)
+    out = main(inp)
