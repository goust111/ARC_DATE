    if not _gen_add_extra_markers(g, markers):
        return None

    _gen_assign_marker_colors(g, markers)
    if _gen_final_ok(g):
        return g
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_GENERATION_ATTEMPTS):
        g = _gen_attempt()
        if g is not None:
            return g
    raise RuntimeError("failed to generate valid input")

