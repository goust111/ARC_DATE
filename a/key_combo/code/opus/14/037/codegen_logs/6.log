+
+    legal_count = sum(1 for r, c in cells if tile[r % p, c % p])
+    if require_legal and legal_count == 0:
+        return False
+
+    temp = mask.copy()
+    for r, c in cells:
+        temp[r, c] = True
+
+    suspects = _suspect_mask(temp)
+    for r, c in cells:
+        if not suspects[r, c]:
