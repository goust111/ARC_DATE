    for color in colors_present(g, exclude={bg, frame_color}):
        coords = np.argwhere(g[r0 : r1 + 1, c0 : c1 + 1] == color)
        if coords.shape[0] != 3:
            continue

        coords = coords + np.array([r0, c0])
        on_border = (
            (coords[:, 0] == r0)
            | (coords[:, 0] == r1)
            | (coords[:, 1] == c0)
            | (coords[:, 1] == c1)
        )
        tri_r0, tri_c0 = coords.min(axis=0)
        tri_r1, tri_c1 = coords.max(axis=0)
