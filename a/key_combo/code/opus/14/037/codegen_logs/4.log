        rect_h,
        rect_w,
        r0,
        c0,
        outer_color,
        inner_color,
        selected_rows,
        selected_cols,
        row_sides,
        col_sides,
    )

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        inp = _gen_attempt()
        if inp is not None:
