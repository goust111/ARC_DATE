+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+ORANGE = 7
+FRAME_COLORS = (1, 2, 3, 4)
+
+GEN_GRID_RANGE = (16, 22)
+GEN_OBJECT_COUNT_CHOICES = (3, 4)
+GEN_RECT_SHORT = 5
+GEN_RECT_LONG_RANGE = (4, 6)
