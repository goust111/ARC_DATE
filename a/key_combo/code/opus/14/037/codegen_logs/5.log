+
+        v_obj = _make_object(v_color, "vertical", v_side, v_r0, v_c0, v_h, GEN_RECT_SHORT)
+        if int(v_obj["protrusion"][1]) in used_vertical_cols:
+            continue
+        if not _can_place(v_obj, blocked | _expanded_cells(_object_input_cells(h_obj)), shape):
