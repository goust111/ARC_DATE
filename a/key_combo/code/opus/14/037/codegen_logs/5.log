+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (BACKGROUND, ORANGE) or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
