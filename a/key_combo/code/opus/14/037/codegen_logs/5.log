+
+def _make_object(
+    color: int,
+    branch: str,
+    side: str,
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+) -> dict:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if side == "left":
+        protrusion = (r0 + h // 2, c0 - 1)
+        ray_dir = (0, -1)
+    elif side == "right":
+        protrusion = (r0 + h // 2, c1 + 1)
+        ray_dir = (0, 1)
+    elif side == "top":
+        protrusion = (r0 - 1, c0 + w // 2)
+        ray_dir = (-1, 0)
+    else:
+        protrusion = (r1 + 1, c0 + w // 2)
+        ray_dir = (1, 0)
+
+    return {
+        "color": int(color),
+        "branch": branch,
+        "side": side,
+        "bbox": (r0, c0, r1, c1),
+        "protrusion": protrusion,
+        "ray_dir": ray_dir,
+    }
+
+
+def _object_input_cells(obj: dict) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = obj["bbox"]
+    cells = set(_frame_cells(r0, c0, r1, c1))
+    cells.add(tuple(obj["protrusion"]))
+    return cells
