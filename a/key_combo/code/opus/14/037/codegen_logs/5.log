+        protrusion = (r0 + h // 2, c0 - 1)
+        ray_dir = (0, -1)
+    elif side == "right":
+        protrusion = (r0 + h // 2, c1 + 1)
+        ray_dir = (0, 1)
+    elif side == "top":
