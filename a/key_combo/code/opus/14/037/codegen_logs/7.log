def _gen_render_output(sprites: list[dict]) -> np.ndarray | None:
    out = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=int)
    for sp in sprites:
        if not _gen_place(out, sp["patch"], sp["r"], sp["c"]):
