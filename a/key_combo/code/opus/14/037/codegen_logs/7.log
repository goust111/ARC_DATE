+BACKGROUND = 5
+MOVE_BY_COLOR = {
+    2: (0, 2),   # red -> right 2
+    1: (2, 0),   # blue -> down 2
+    3: (0, -2),  # green -> left 2
+    7: (-2, 0),  # orange -> up 2
