+        grid[coords[:, 0], coords[:, 1]] = int(color)
+    return grid
+
+
+def _recolor_without_translation(grid: np.ndarray) -> np.ndarray:
+    bg = _background_color(grid)
+    out = np.full_like(grid, bg)
