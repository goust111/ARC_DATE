+    "H": 4,  # horizontal only
+    "V": 6,  # vertical only
+    "B": 8,  # both horizontal and vertical
+    "N": 9,  # no reflection symmetry
+}
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GENERATION_ATTEMPTS = 400
