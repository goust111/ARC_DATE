+    seen = set()
+    for full_mask, grey_mask, cavity in candidates:
+        key = (full_mask.shape, full_mask.tobytes(), grey_mask.tobytes(), cavity)
+        if key not in seen:
+            seen.add(key)
+            uniq.append((full_mask, grey_mask, cavity))
