+
+def _fits(scene: np.ndarray, patch: np.ndarray, r0: int, c0: int, pad: int = 1) -> bool:
+    h, w = scene.shape
+    ph, pw = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
