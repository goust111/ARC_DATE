+
+
+def _matched_transform(sprite: dict, slot: dict) -> tuple[np.ndarray, np.ndarray, tuple[int, int]]:
+    candidates = []
+    for full_mask, grey_mask in _paired_transforms(sprite["full_mask"], sprite["grey_mask"]):
