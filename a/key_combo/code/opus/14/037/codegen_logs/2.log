+    bottom_band = random.randint(0, max(0, bottom_h - max(obj["patch"].shape[0] for obj in slots)))
+    for obj, c0 in zip(slots, bottom_cols):
+        patch = obj["patch"]
+        r0 = bottom_band
+        assert _fits(bottom_region, patch, r0, c0, pad=1)
