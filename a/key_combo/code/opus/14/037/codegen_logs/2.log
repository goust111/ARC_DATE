+
+def _parse_upper(grid: np.ndarray) -> list[dict]:
+    objects = []
+    for coords in _components(grid != BG):
+        r0, c0, r1, c1 = _bbox(coords)
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        mask = patch != BG
+        colors = sorted(set(map(int, patch[mask])))
