+def _build_example() -> np.ndarray:
+    signature_palette = random.sample([1, 2, 3, 4, 6, 7, 8, 9], 6)
+    signature_colors = signature_palette[:3]
+    slot_colors = signature_palette[3:]
+
+    sprites = []
+    slots = []
