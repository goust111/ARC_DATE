+    top_cols = _sample_positions([obj["patch"].shape[1] for obj in sprites], width)
+    bottom_cols = _sample_positions([obj["patch"].shape[1] for obj in slots], width)
+    grid = np.zeros((top_h + 1 + bottom_h, width), dtype=int)
