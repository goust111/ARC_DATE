+        cr, cc = cavity
+        rr = bottom_offset + r0 + cr
+        cc_abs = c0 + cc
+        h, w = grey_mask.shape
+        patch = out[rr : rr + h, cc_abs : cc_abs + w]
+        patch[grey_mask] = int(slot["color"])
+
+    return out
