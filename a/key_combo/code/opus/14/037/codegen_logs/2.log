+    rev_top = tuple(map(int, mask[0, ::-1]))
+    assert top != rev_top, "mask must expose a horizontal orientation preference"
+    return top > rev_top
+
+
+def _col_pref(mask: np.ndarray) -> bool:
+    left = tuple(map(int, mask[:, 0]))
+    rev_left = tuple(map(int, mask[::-1, 0]))
