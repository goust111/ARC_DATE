+            _full_mask, grey_mask, _ = _matched_transform(sprite, slot)
+            all_matches += int(grey_mask.sum() > 0)
+    assert all_matches == 3, "expected one valid match per slot"
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
