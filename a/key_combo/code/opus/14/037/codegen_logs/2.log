+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(h, r0 + ph + pad)
+    cc1 = min(w, c0 + pw + pad)
+    return not np.any(scene[rr0:rr1, cc0:cc1] != BG)
