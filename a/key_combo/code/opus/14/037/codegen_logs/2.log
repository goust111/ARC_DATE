+
+def _transforms(arr: np.ndarray) -> list[np.ndarray]:
+    out = []
+    for k in range(4):
+        rot = np.rot90(arr, k)
+        out.append(rot)
+        out.append(np.fliplr(rot))
+    uniq = []
+    seen = set()
+    for candidate in out:
+        key = (candidate.shape, candidate.tobytes())
+        if key not in seen:
+            seen.add(key)
+            uniq.append(candidate.copy())
+    return uniq
