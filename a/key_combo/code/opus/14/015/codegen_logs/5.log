+
+
+def _hole_component_is_valid(region: np.ndarray, cells: list[tuple[int, int]], main_color: int) -> bool:
+    h, w = map(int, region.shape)
+    comp = set(cells)
+    if any(r in (0, h - 1) or c in (0, w - 1) for r, c in comp):
+        return False
