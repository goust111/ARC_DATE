+def _has_internal_hole(region: np.ndarray, main_color: int) -> bool:
+    h, w = map(int, region.shape)
+    zeros = region == 0
+    seen = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not zeros[r, c] or seen[r, c]:
