+    return flags
+
+
+def _render_input(region_colors: list[int], hole_flags: list[bool]) -> np.ndarray:
+    grid = np.zeros((GRID_SIZE, GRID_SIZE), dtype=int)
+    for r in SEPARATOR_ROWS:
