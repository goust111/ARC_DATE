+
+def _next_cycle(values: list[int], store_name: str) -> int:
+    global SLOT_CYCLE, PATTERN_CYCLE
+    store = SLOT_CYCLE if store_name == "slot" else PATTERN_CYCLE
+    if not store:
+        store.extend(values)
+        random.shuffle(store)
+    return store.pop()
