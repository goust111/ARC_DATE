+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+HORIZONTAL_BARS = [(RED, 2), (GREEN, 3)]
+VERTICAL_BARS = [(BLUE, 3), (ORANGE, 4)]
+BASE_CROSS_DIMS = [(2, 3), (2, 4), (3, 3), (3, 4)]
+ROTATABLE_KEYS = {(2, 3), (2, 4), (3, 4)}
+
+GEN_RETRIES = 400
+SLOT_CYCLE: list[int] = []
+PATTERN_CYCLE: list[int] = []
+GEN_CALLS = 0
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _bands(indices: np.ndarray) -> list[tuple[int, int]]:
+    if indices.size == 0:
+        return []
+    groups: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for idx in map(int, indices[1:]):
+        if idx == prev + 1:
+            prev = idx
+            continue
+        groups.append((start, prev))
+        start = prev = idx
+    groups.append((start, prev))
+    return groups
+
+
+def _analysis(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
