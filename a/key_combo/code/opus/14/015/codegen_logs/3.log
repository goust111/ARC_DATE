            for s1, s2 in itertools.product(_GAP_SHAPES, repeat=2):
                gap_area = s1[0] * s1[1] + s2[0] * s2[1]
                fill_ratio = (h * w - gap_area) / (h * w)
                if not _TARGET_FILL_RATIO_MIN <= fill_ratio <= _TARGET_FILL_RATIO_MAX:
                    continue
