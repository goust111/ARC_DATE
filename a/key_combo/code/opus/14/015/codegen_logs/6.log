+from __future__ import annotations
+
+from collections import Counter
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+OFFSETS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 400
+BOX_PAD = 2
