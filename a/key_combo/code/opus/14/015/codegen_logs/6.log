+        target_patch, target_holes = target_built
+
+        distractor_patches = []
+        distractor_hole_coords = []
+        ok = True
+        for color, masks in zip(distractor_colors, distractor_shape_groups):
+            built = _object_patch(color, masks)
+            if built is None:
+                ok = False
