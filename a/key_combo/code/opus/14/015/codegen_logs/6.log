+        place_ok = True
+        for patch in patches:
+            if not _place_patch(grid, patch, placed):
+                place_ok = False
+                break
+        if not place_ok:
+            continue
+        for patch in marker_patches:
+            if not _place_patch(grid, patch, placed):
+                place_ok = False
+                break
+        if not place_ok:
+            continue
