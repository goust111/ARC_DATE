+    if not _critical_barrier_exists(grid, expected_pairs):
+        return False
+
+    final_by_col = Counter(int(c) for _r, c in final_positions)
+    if max(final_by_col.values(), default=0) > 2:
+        return False
+    for c, count in final_by_col.items():
+        if count != 2:
+            continue
