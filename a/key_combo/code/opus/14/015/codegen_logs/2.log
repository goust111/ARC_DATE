+        grid[r, random.choice(valid_cols)] = GREY
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    target_pairs, call_index = _next_target_pair_count()
+    for _ in range(GENERATION_RETRIES):
+        grid = _compose_candidate(target_pairs, call_index)
+        if grid is None:
