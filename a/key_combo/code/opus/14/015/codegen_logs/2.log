+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+TEAL = 8
+
+ENCODE_ORDER = [(0, 0), (0, 2), (1, 1), (2, 0), (2, 2)]
+
+GENERATION_RETRIES = 400
+ROW_SAMPLE_RETRIES = 200
