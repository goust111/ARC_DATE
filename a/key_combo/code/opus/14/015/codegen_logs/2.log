+    h, w = g.shape
+    out = g.copy()
+    out[out == RED] = BLACK
+
+    final_positions: list[tuple[int, int]] = []
+    occupied: set[tuple[int, int]] = set()
+
+    for r, _c in _sorted_red_pixels(g):
