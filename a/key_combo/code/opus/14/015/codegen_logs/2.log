+    global PAIR_CYCLE, GENERATION_CALLS
+    if not PAIR_CYCLE:
+        PAIR_CYCLE = [1, 2, 3, 4, 5]
+        random.shuffle(PAIR_CYCLE)
+    GENERATION_CALLS += 1
+    return PAIR_CYCLE.pop(), GENERATION_CALLS
+
