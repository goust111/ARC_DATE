+def _barrier_rows(grid: np.ndarray) -> dict[int, int]:
+    rows: dict[int, int] = {}
+    for r in range(grid.shape[0]):
+        cols = [int(c) for c in np.flatnonzero(grid[r] == GREY)]
+        assert len(cols) <= 1
+        if cols:
+            rows[int(r)] = cols[0]
+    return rows
