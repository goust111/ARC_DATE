+        return None
+    top_extra, gap1_extra, gap2_extra, bottom_extra = _distribute_extra(total - base, 4)
+    top = MIN_MARGIN + top_extra
+    gap1 = MIN_GAP + gap1_extra
+    gap2 = MIN_GAP + gap2_extra
+    _bottom = MIN_MARGIN + bottom_extra
