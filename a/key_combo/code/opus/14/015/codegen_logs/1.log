+def _distribute_extra(extra: int, slots: int) -> list[int]:
+    parts = [0] * slots
+    for _ in range(extra):
+        parts[random.randrange(slots)] += 1
+    return parts
+
+
+def _sample_band_starts(total: int, sizes: list[int]) -> list[int] | None:
