def _gen_padded_region(r0: int, c0: int, r1: int, c1: int) -> tuple[slice, slice]:
    return (
        slice(max(0, r0 - _GEN_CLEARANCE), min(_GEN_H, r1 + _GEN_CLEARANCE + 1)),
        slice(max(0, c0 - _GEN_CLEARANCE), min(_GEN_W, c1 + _GEN_CLEARANCE + 1)),
    )


