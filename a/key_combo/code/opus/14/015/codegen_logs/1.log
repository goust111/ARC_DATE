+def _trace_ray(
+    grid: np.ndarray, start: tuple[int, int], dr: int, dc: int
+) -> tuple[list[tuple[int, int]], tuple[int, int] | None, int | None]:
+    r, c = start
+    rr, cc = r + dr, c + dc
+    path: list[tuple[int, int]] = []
+    while _in_bounds(grid.shape, rr, cc):
+        value = int(grid[rr, cc])
+        if value != BG:
