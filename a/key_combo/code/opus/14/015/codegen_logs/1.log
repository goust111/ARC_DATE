+            counts = [0, 0, 0]
+            free_counts = [0, 0, 0]
+            specs: list[dict[str, object]] = []
+            for (row_slot, col_slot), mode in zip(chosen_pairs, chosen_modes):
+                free_counts[row_slot] += 1
+                free_counts[col_slot] += 1
+                if mode in ("both", "row_only"):
