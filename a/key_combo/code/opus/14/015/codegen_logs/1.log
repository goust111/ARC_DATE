+
+    for _ in range(random.randint(1, 3)):
+        _try_place_decoy_segment(grid, boxes)
+
+    if not _semantic_checks(grid, boxes, path_info):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
