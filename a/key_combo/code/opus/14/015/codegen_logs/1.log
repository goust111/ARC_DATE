+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        assert np.all(patch == color), "each region must be a solid monochrome rectangle"
+        infos.append(
+            {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "mask": grid == color,
+            }
