+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+REGION_COLORS = (BLUE, RED, GREEN)
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_RANGE = (18, 22)
+REGION_SIDE_RANGE = (3, 4)
+MIN_GAP = 3
+MIN_MARGIN = 1
