+    marker_votes: dict[tuple[int, int], int] = {}
+    ray_details: dict[tuple[int, int], dict[tuple[int, int], dict[str, object]]] = {}
+
+    markers = [tuple(map(int, pos)) for pos in np.argwhere(grid == ORANGE)]
+    for marker in markers:
