+    path: list[tuple[int, int]] = []
+    while _in_bounds(grid.shape, rr, cc):
+        value = int(grid[rr, cc])
+        if value != BG:
+            return path, (rr, cc), value
+        path.append((rr, cc))
+        rr += dr
+        cc += dc
