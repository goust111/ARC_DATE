+    boxes: list[tuple[int, int, int, int]] = []
+    for slot in range(3):
+        r0 = row_starts[slot]
+        c_band = col_perm[slot]
+        c0 = col_starts[c_band]
+        boxes.append(
+            (
+                r0,
+                c0,
+                r0 + row_sizes[slot] - 1,
+                c0 + col_sizes[c_band] - 1,
+            )
+        )
