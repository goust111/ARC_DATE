    crossing = t_h * t_v
    bg_count = H * W - (t_h * W + t_v * H - crossing)
    h_count = t_h * W - (0 if top_is_h else crossing)
    v_count = t_v * H - (crossing if top_is_h else 0)
    return bg_count > max(h_count, v_count)


GEN_VALID_PARAMS = [
