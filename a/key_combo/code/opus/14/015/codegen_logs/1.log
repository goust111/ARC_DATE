+            chosen_pairs = random.sample(base_pairs, marker_count)
+            chosen_modes = [random.choice(modes) for _ in range(marker_count)]
+            if not any(mode == "both" for mode in chosen_modes):
+                continue
+            if not any(mode != "both" for mode in chosen_modes):
+                continue
