        r0, c0 = random.choice(choices)
        r1 = r0 + height - 1
        c1 = c0 + width - 1
        rows, cols = _gen_padded_region(r0, c0, r1, c1)
        occupied[rows, cols] = True
        rects.append((r0, c0, r1, c1, color))
