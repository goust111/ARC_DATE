+def _winner_region(
+    votes: dict[int, int], infos: list[dict[str, object]]
+) -> dict[str, object]:
+    return min(
+        infos,
+        key=lambda info: (
+            -votes[int(info["color"])],
+            int(info["bbox"][0]),
+            int(info["bbox"][1]),
