42:def main(grid: np.ndarray) -> np.ndarray:
43:    """
44:    Fill each enclosed outline with the majority marker color inside it, while removing stray marker pixels.
45:
46:    Input structure
47:    - The background is the dominant color.
48:    - Foreground consists of 4-connected monochrome outline objects and isolated one-pixel marker/control pixels.
49:    - Some outline objects enclose interior regions; open outlines have no enclosed region.
50:
51:    Rule
52:    - Keep every multi-pixel outline object.
53:    - Remove all isolated marker pixels from the canvas.
54:    - For each enclosed interior region, fill all of its cells with the unique most frequent marker color found inside it.
55:
56:    Key insight
57:    - The target to fill is the set of cells unreachable from the outline bbox boundary without crossing that outline.
58:    """
59:    g = np.asarray(grid, dtype=int)
60:    assert g.ndim == 2, "expected a 2D grid"
61:
62:    bg = get_bg(g)
63:    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
64:    assert components, "expected foreground components"
65:
66:    out = np.full_like(g, bg)
67:    marker_mask = np.zeros(g.shape, dtype=bool)
68:    outlines: list[dict] = []
69:
70:    for comp in components:
71:        coords = comp["coords"]
72:        if comp["area"] == 1:
73:            marker_mask[coords[0, 0], coords[0, 1]] = True
74:        else:
75:            outlines.append(comp)
76:            out[coords[:, 0], coords[:, 1]] = int(comp["color"])
77:
78:    assert outlines, "expected at least one outline object"
79:
80:    filled_regions = 0
81:    for outline in outlines:
82:        for region_coords in _enclosed_region_coords(outline["coords"], outline["bbox"]):
83:            rr, cc = region_coords[:, 0], region_coords[:, 1]
84:            inside_markers = marker_mask[rr, cc]
85:            marker_values = g[rr[inside_markers], cc[inside_markers]]
86:            assert marker_values.size > 0, "expected enclosed region to contain marker pixels"
87:
88:            counts = Counter(map(int, marker_values))
89:            ranked = counts.most_common()
90:            assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique majority marker color"
91:
92:            out[rr, cc] = int(ranked[0][0])
