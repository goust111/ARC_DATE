+    for idx, (shape, color, bend_count) in enumerate(zip(shapes, colors, turns)):
+        band_top = top_margin + idx * 8
+        rec = _place_instance(shape, color, bend_count, band_top, width)
+        if rec is None:
+            return None
+        records.append(rec)
