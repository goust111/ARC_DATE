150:def _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:
151:    area = block_size * block_size
152:    min_num, min_den = SPRITE_FG_MIN_RATIO
153:    max_num, max_den = SPRITE_FG_MAX_RATIO
154:    fg_min = math.ceil(area * min_num / min_den)
155:    fg_max = math.floor(area * max_num / max_den)
156:    if fg_min > fg_max:
157:        fg_min = fg_max = round(area * min_num / min_den)
158:    fg_count = random.randint(fg_min, fg_max)
159:    blank_count = area - fg_count
160:
161:    for _ in range(SPRITE_ATTEMPTS):
162:        mask = np.ones((block_size, block_size), dtype=bool)
163:        if block_size == TINY_BLOCK_SIZE:
164:            blanks = [random.randrange(area)]
165:        else:
166:            cols = list(range(block_size))
167:            random.shuffle(cols)
168:            blanks = [r * block_size + cols[r] for r in range(block_size)]
169:            extra = blank_count - block_size
170:            if extra > 0:
171:                pool = [i for i in range(area) if i not in blanks]
172:                blanks.extend(random.sample(pool, extra))
173:
174:        for idx in blanks:
175:            mask[idx // block_size, idx % block_size] = False
176:
177:        if block_size > TINY_BLOCK_SIZE:
178:            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))
179:            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))
180:            if not row_mixed or not col_mixed:
181:                continue
182:        if _has_symmetry(mask):
183:            continue
184:
185:        sprite = np.where(mask, foreground, blank).astype(int)
186:        return sprite
