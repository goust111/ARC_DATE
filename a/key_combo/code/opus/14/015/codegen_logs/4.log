45:def main(grid: np.ndarray) -> np.ndarray:
46:    """
47:    Copy the color of the unique complete rectangular frame onto the matching empty rectangle elsewhere.
48:
49:    Input structure:
50:    - The grid contains one complete monochrome rectangular frame.
51:    - That frame's interior is a single empty color.
52:    - Elsewhere, exactly one same-size rectangle has the same empty-colored interior
53:      but a non-frame-colored perimeter.
54:
55:    Rule:
56:    - Find the complete source frame and infer its color, size, and empty interior color.
57:    - Find the unique same-size non-source window whose interior is entirely the
58:      empty color.
59:    - Recolor that window's perimeter to the source frame color, preserving every
60:      other pixel.
61:
62:    Key insight:
63:    - The source frame is a template for completing the camouflaged rectangle:
64:      its interior identifies the empty color, while its bbox gives the destination
65:      size and perimeter shape.
66:    """
67:    g = np.asarray(grid, dtype=int)
68:    assert g.ndim == 2, "expected a 2D grid"
69:    frame_color, empty_color, source_bbox = _find_source_frame(g)
70:    sr0, sc0, sr1, sc1 = source_bbox
71:    height = sr1 - sr0 + 1
72:    width = sc1 - sc0 + 1
73:    border = _border_mask(height, width)
74:
75:    targets: list[tuple[int, int]] = []
76:    grid_h, grid_w = map(int, g.shape)
77:    for r0 in range(grid_h - height + 1):
78:        for c0 in range(grid_w - width + 1):
79:            bbox = (r0, c0, r0 + height - 1, c0 + width - 1)
80:            if bbox == source_bbox:
81:                continue
82:            sub = g[r0 : r0 + height, c0 : c0 + width]
83:            if not np.all(sub[~border] == empty_color):
84:                continue
85:            perimeter = sub[border]
86:            if np.any(perimeter == frame_color):
87:                continue
88:            if not np.any(perimeter != empty_color):
89:                continue
90:            targets.append((r0, c0))
91:
92:    assert len(targets) == 1, "expected exactly one same-size empty-interior target"
93:    target_r0, target_c0 = targets[0]
94:
95:    out = g.copy()
96:    window = out[target_r0 : target_r0 + height, target_c0 : target_c0 + width]
97:    window[border] = frame_color
98:    return out
