+import numpy as np
+
+
+BG = 0
+FRAME = 5
+CORRIDOR = 7
+SPRITE_COLORS = (1, 2, 3, 6, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TURN_PATTERNS = [
+    (0, 2),
+    (1, 3),
+    (0, 1, 3),
+    (0, 2, 3),
