+
+
+SHAPE_POOL = _build_shape_pool()
+
+
+def _facing_rows(shape, side):
+    col = 2 if side == "right" else 0
+    return [r for r in range(3) if int(shape[r, col]) == 1]
+
+
+def _path_from_waypoints(points):
