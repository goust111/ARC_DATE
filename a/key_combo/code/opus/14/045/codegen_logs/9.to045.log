+    arr = np.asarray(coords, dtype=int)
+    h = int(arr[:, 0].max()) + 1
+    out = np.zeros_like(arr)
+    out[:, 0] = arr[:, 1]
+    out[:, 1] = h - 1 - arr[:, 0]
+    return normalize_coords(out)
+
+
+def _rot180(coords: np.ndarray) -> np.ndarray:
