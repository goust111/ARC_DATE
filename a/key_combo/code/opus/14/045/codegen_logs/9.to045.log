+    r0 = random.randint(r0_min, r0_max)
+    c0 = random.randint(c0_min, c0_max)
+    return (r0, c0, r0 + side - 1, c0 + side - 1)
+
+
+def _build_generator_pieces() -> list[dict] | None:
