+        non_rect = 0
+        for coords in coords_list:
+            h = int(coords[:, 0].max()) + 1
+            w = int(coords[:, 1].max()) + 1
+            if h * w != len(coords):
+                non_rect += 1
+        if non_rect >= 2:
+            return coords_list
