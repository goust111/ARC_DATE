+    rot270 = _rot270cw(base)
+    return [
+        base,
+        _hflip(base),
+        _vflip(base),
+        rot90,
+        _hflip(rot90),
+        _rot180(base),
+        rot270,
+        _hflip(rot270),
+    ]
