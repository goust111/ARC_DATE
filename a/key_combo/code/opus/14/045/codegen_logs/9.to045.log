    background: 0
    border: all background [observed]
    fragments: 3-5 monochromatic 4-connected polyominoes, exactly 3 distinct non-zero colors
    total_area: 12 (= 3x4)
    individual_areas: range 1-7; largest fragment 5-7 cells [observed]
    same_color_fragments: a color may appear in 2 separate fragments (each small, area 1-2)
    separation: min L1 distance between any two fragments >= 2
    density: foreground ~10-12% of grid [observed]
    no_bbox_overlap: fragment bounding boxes do not overlap [observed]
  transform:
    sort_fragments: by decreasing area, ties broken left-to-right in input
    packing: for each fragment try all 8 orientations (identity/rot/reflect), scan placements top-left to bottom-right; backtrack until rectangle is filled
    colors_preserved: each fragment keeps its original color

generation_strategy:
  approach: output-first
