+
+def _enumerate_candidates(
+    coords: np.ndarray,
+    grid_shape: tuple[int, int],
+    frame_mask: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    dist_map: np.ndarray,
+    region: str,
+) -> list[dict]:
+    H, W = grid_shape
+    r0f, c0f, r1f, c1f = frame_bbox
