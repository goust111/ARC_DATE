+    mask[r0 : r1 + 1, c0] = True
+    mask[r0 : r1 + 1, c1] = True
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
+    return mask
+
+
+def _sample_frame_bbox(grid_shape: tuple[int, int]) -> tuple[int, int, int, int] | None:
