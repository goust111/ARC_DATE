+    if not _anti_shortcut_ok(pieces, truth, meta):
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, truth):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
