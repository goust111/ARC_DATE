0227: def _gen_rows_for_rects(
0228:     safe_r0: int, safe_r1: int, rects: list[tuple[int, int]], rng: np.random.Generator
0229: ) -> list[int]:
0230:     used = sum(h for h, _ in rects)
0231:     min_between = _GEN_MIN_ROW_GAP * (len(rects) - 1)
0232:     extra = safe_r1 - safe_r0 + 1 - used - min_between
0233:     slots = rng.multinomial(extra, np.full(len(rects) + 1, 1 / (len(rects) + 1)))
0234: 
0235:     rows = []
0236:     r = safe_r0 + int(slots[0])
0237:     for i, (h, _) in enumerate(rects):
0238:         rows.append(r)
0239:         r += h
0240:         if i < len(rects) - 1:
0241:             r += _GEN_MIN_ROW_GAP + int(slots[i + 1])
0242:     return rows
