0198: def _gen_choose_rects(
0199:     region: dict[str, int | str], count: int, split_type: str, rng: np.random.Generator
0200: ) -> list[tuple[int, int]] | None:
0201:     safe = _gen_safe_rows(region, split_type)
0202:     if safe is None:
0203:         return None
0204:     row_budget = safe[1] - safe[0] + 1 - _GEN_MIN_ROW_GAP * (count - 1)
0205:     if row_budget < count * _GEN_MIN_RECT_HEIGHT:
0206:         return None
0207: 
0208:     rects = []
0209:     for i in range(count):
0210:         remaining = count - i - 1
0211:         choices = []
0212:         remaining_min_height = remaining * _GEN_MIN_RECT_HEIGHT
0213:         for h, w in _GEN_RECT_SIZES:
0214:             fits_rows = h <= row_budget - remaining_min_height
0215:             fits_gap = _gen_max_gap(region, int(region["color"]), w, split_type) >= 1
0216:             if fits_rows and fits_gap:
0217:                 choices.append((h, w))
0218:         if not choices:
0219:             return None
0220:         h, w = choices[int(rng.integers(0, len(choices)))]
0221:         rects.append((h, w))
0222:         row_budget -= h
0223:     rng.shuffle(rects)
0224:     return rects
