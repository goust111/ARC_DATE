0261: def main(grid: np.ndarray) -> np.ndarray:
0262:     """
0263:     Assemble and place enlarged sprites on a canvas using legend-panel instructions.
0264: 
0265:     Input structure:
0266:     - Color-6 separators divide the grid into a left legend column and a main canvas.
0267:     - Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.
0268: 
0269:     Rule:
0270:     - Tile the unit sprite into each active cell of the frame to build an enlarged composite.
0271:     - Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).
0272:     - Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.
0273: 
0274:     Key insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).
0275:     """
0276:     g = np.asarray(grid, dtype=int)
0277:     h, w = g.shape
0278:     assert w >= 2, "grid width must be >= 2"
0279: 
0280:     # Output canvas is the region between the left separator run and (optionally) a
0281:     # right-side separator run near the far edge (right legend panel).
0282:     left_sep, right_sep = _split_canvas(g)
0283:     left_sep_c1 = left_sep[1]
0284:     canvas_c0 = left_sep_c1 + 1
0285:     canvas_c1 = right_sep[0] if right_sep is not None else w
0286:     main = g[:, canvas_c0:canvas_c1].copy()
0287: 
0288:     # Paint one constructed sprite per marker panel that lies outside the output canvas.
0289:     marker_squares = _all_marker_panel_squares(g)
0290:     assert marker_squares, "no marker panel found"
