0088: def _gen_area_bounds(h: int, w: int) -> tuple[int, int]:
0089:     cells = int(h) * int(w)
0090:     lo = max(SPRITE_AREA_MIN, math.ceil(SPRITE_FILL_MIN * cells))
0091:     hi = min(SPRITE_AREA_MAX, math.floor(SPRITE_FILL_MAX * cells))
