0307:             continue
0308: 
0309:         if marker_c0 + 5 > w:
0310:             continue
0311:         panel = g[:, marker_c0 : marker_c0 + 5]
0312: 
0313:         unit = _extract_unit_sprite(panel)
0314:         if unit is None:
0315:             continue
0316:         unit_sprite, unit_bb = unit
0317: 
0318:         frame_bb = _extract_frame_bbox(panel, unit_bb, marker_r0)
0319:         if frame_bb is None:
0320:             continue
0321:         fr0, fc0, fr1, fc1 = frame_bb
0322:         frame = panel[fr0 : fr1 + 1, fc0 : fc1 + 1]
