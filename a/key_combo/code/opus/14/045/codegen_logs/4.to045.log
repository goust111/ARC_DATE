0055: def main(grid: np.ndarray) -> np.ndarray:
0056:     """
0057:     Recolor each gray candidate object red when it can rotate to cover a lower black pocket in the blue structure without overlapping blue.
0058: 
0059:     Input structure
0060:     - A black background contains one upper blue 4-connected structure and gray 4-connected candidate objects below it.
0061:     - The blue structure's bbox is a three-row band whose internal black components form candidate cavities.
0062: 
0063:     Rule
0064:     - The pockets are the black 4-connected components inside the blue bbox that touch the bbox's bottom edge.
0065:     - For each gray object, try every rotation and translation; if it covers every pixel of any pocket, stays on the grid, and does not overlap a blue pixel, recolor that original gray object red.
0066: 
0067:     Key insight
0068:     - Matching is by fitting a whole lower cavity, not by the gray object's current position; extra cells may stick out only through surrounding black space.
0069:     """
0070:     g = np.asarray(grid, dtype=int)
0071:     bg = get_bg(g)
0072:     assert bg == Color.BLACK
0073:     assert set(np.unique(g)).issubset({Color.BLACK, Color.BLUE, Color.GREY})
0074: 
0075:     blue_objects = find_components(
0076:         g,
0077:         bg=bg,
0078:         colors=[Color.BLUE],
0079:         connectivity=4,
0080:         return_format="dict",
0081:     )
0082:     assert len(blue_objects) == 1
0083:     blue_box = bbox(g == Color.BLUE)
0084:     assert blue_box is not None
0085:     r0, c0, r1, c1 = blue_box
0086: 
0087:     blue_band = g[r0 : r1 + 1, c0 : c1 + 1] == Color.BLUE
0088:     assert blue_band.shape[0] == 3
0089:     pocket_components = components_mask(~blue_band, connectivity=4)
0090:     pockets = [
0091:         coords + np.array([r0, c0])
0092:         for coords in pocket_components
0093:         if np.any(coords[:, 0] == blue_band.shape[0] - 1)
0094:     ]
0095:     assert pockets
0096: 
0097:     gray_objects = find_components(
0098:         g,
0099:         bg=bg,
0100:         colors=[Color.GREY],
0101:         connectivity=4,
0102:         return_format="dict",
0103:     )
0104:     assert gray_objects
0105: 
0106:     out = g.copy()
0107:     blue_cells = {tuple(map(int, rc)) for rc in np.argwhere(g == Color.BLUE)}
0108:     for obj in gray_objects:
0109:         coords = obj["coords"]
0110:         shape = _component_mask(coords)
0111:         if any(_can_cover_pocket(shape, pocket, blue_cells, g.shape) for pocket in pockets):
0112:             out[coords[:, 0], coords[:, 1]] = Color.RED
0113:     return out
