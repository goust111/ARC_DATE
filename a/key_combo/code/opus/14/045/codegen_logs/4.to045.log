0386: def _allocate_colors(num_legends):
0387:     """Pick unit colors (2 per legend), 2 background colors, and 1 frame color per legend."""
0388:     pool = list(USABLE_COLORS)
0389:     random.shuffle(pool)
0390: 
0391:     unit_color_sets = []
0392:     used_unit = set()
0393:     for _ in range(num_legends):
0394:         if len(pool) < 2:
0395:             return None
0396:         c1, c2 = pool.pop(), pool.pop()
0397:         unit_color_sets.append((c1, c2))
0398:         used_unit.update([c1, c2])
0399: 
0400:     bg_cands = [c for c in pool if c not in used_unit]
0401:     if len(bg_cands) < 2:
0402:         return None
0403:     random.shuffle(bg_cands)
0404:     bg_colors = (bg_cands[0], bg_cands[1])
0405: 
0406:     frame_colors = []
