0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Create a four-quadrant mirror pattern from the whole input grid.
0009: 
0010:     Input structure:
0011:     - The entire rectangular input grid is the seed tile.
0012: 
0013:     Rule:
0014:     - Place the input tile in the upper-left quadrant.
0015:     - Place its left-to-right reflection in the upper-right quadrant.
0016:     - Reflect that full top strip top-to-bottom to make the lower half.
0017: 
0018:     Key insight:
0019:     - The output is a 2x2 reflection tiling, not a pixelwise scale-up.
0020:     """
0021:     g = np.asarray(grid, dtype=int)
0022:     assert g.ndim == 2, "expected a 2-D grid"
0023:     assert g.shape[0] > 0 and g.shape[1] > 0, "expected a non-empty grid"
0024: 
0025:     top = np.concatenate((g, np.fliplr(g)), axis=1)
0026:     return np.concatenate((top, np.flipud(top)), axis=0)
0027: 
0028: # --------------- generator (o5x) ---------------
0029: # Tile shape bounds.
0030: TILE_SIZE_MIN = 2
0031: TILE_SIZE_MAX_EXCLUSIVE = 6
0032: # Palette sampling.
0033: COLOR_VALUES = np.arange(10, dtype=int)
0034: COLOR_COUNT_MIN = 3
0035: COLOR_COUNT_MAX_EXCLUSIVE = 5
0036: # Retry limit.
0037: MAX_GENERATION_ATTEMPTS = 300
0038: 
0039: def _gen_expected_output(tile: np.ndarray) -> np.ndarray:
0040:     top = np.concatenate((tile, np.fliplr(tile)), axis=1)
0041:     return np.concatenate((top, np.flipud(top)), axis=0)
0042: 
0043: 
0044: def _gen_attempt() -> np.ndarray | None:
0045:     rng = np.random.default_rng()
0046:     height = int(rng.integers(TILE_SIZE_MIN, TILE_SIZE_MAX_EXCLUSIVE))
0047:     width = int(rng.integers(TILE_SIZE_MIN, TILE_SIZE_MAX_EXCLUSIVE))
0048:     color_count = int(rng.integers(COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE))
0049:     palette = rng.choice(COLOR_VALUES, size=color_count, replace=False)
0050: 
0051:     tile = rng.choice(palette, size=(height, width), replace=True).astype(int)
0052: 
0053:     # These anchors make the seed non-symmetric in both axes by construction.
0054:     tile[0, 0] = palette[0]
0055:     tile[0, width - 1] = palette[1]
0056:     tile[height - 1, 0] = palette[2]
0057: 
0058:     if color_count == COLOR_COUNT_MAX_EXCLUSIVE - 1:
0059:         anchor_positions = {(0, 0), (0, width - 1), (height - 1, 0)}
0060:         free_positions = [
0061:             (r, c)
0062:             for r in range(height)
0063:             for c in range(width)
0064:             if (r, c) not in anchor_positions
0065:         ]
0066:         r, c = free_positions[int(rng.integers(0, len(free_positions)))]
0067:         tile[r, c] = palette[3]
0068: 
0069:     if np.array_equal(tile, np.fliplr(tile)) or np.array_equal(tile, np.flipud(tile)):
0070:         return None
0071: 
0072:     expected = _gen_expected_output(tile)
0073:     if not np.array_equal(main(tile), expected):
0074:         return None
0075:     return tile
0076: 
0077: 
0078: def generate_input() -> np.ndarray:
0079:     for _ in range(MAX_GENERATION_ATTEMPTS):
0080:         grid = _gen_attempt()
0081:         if grid is not None:
0082:             return grid
0083:     raise RuntimeError("failed to generate a valid input")

