+        if max(ha, hb) <= 28 and wa + wb + sep <= 28:
+            layouts.append(("side", (sep, 0)))
+        if max(wa, wb) <= 28 and ha + hb + sep <= 28:
+            layouts.append(("stack", (sep, 0)))
+    return layouts
