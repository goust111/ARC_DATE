+        rows = {int(r) for r, _c in coords}
+        cols = {int(c) for _r, c in coords}
+        assert len(rows) == 1 or len(cols) == 1
+        touched = set()
+        for r, c in coords:
+            teal_degree = 0
+            for nr, nc in _neighbors4(int(r), int(c)):
