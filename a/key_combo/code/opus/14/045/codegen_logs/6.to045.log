+
+def _tip_of(cells: set[tuple[int, int]], direction: str) -> tuple[int, int]:
+    if direction == "right":
+        edge = max(c for _r, c in cells)
+        tips = [(r, c) for r, c in cells if c == edge]
+    elif direction == "left":
+        edge = min(c for _r, c in cells)
+        tips = [(r, c) for r, c in cells if c == edge]
+    elif direction == "down":
