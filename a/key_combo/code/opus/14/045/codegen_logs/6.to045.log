+        "shift": shift,
+        "start": start_cells,
+        "final": final_cells,
+        "trail": trail,
+        "swept": swept,
+        "marker_options": marker_options,
+        "tip": _tip_of(start_cells, direction),
+        "bbox": (min(rows), min(cols), max(rows), max(cols)),
+    }
+
+
