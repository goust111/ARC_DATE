+from arc_utils import Color, find_components, get_bg
+
+
+BG = int(Color.BLACK)
+MARKER = int(Color.RED)
+TRAIL = int(Color.YELLOW)
+BORDER = int(Color.GREY)
+SPRITE_COLORS = [1, 3, 6, 7, 8, 9]
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
