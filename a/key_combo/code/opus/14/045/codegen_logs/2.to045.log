+    grid = _render((grid_h, grid_w), placed)
+    if not _validate_constructed_sample(grid, pattern, frame_color, frame_outer):
+        return None
+    sig = _output_signature(grid)
+    if sig in _SEEN_OUTPUT_SIGNATURES:
