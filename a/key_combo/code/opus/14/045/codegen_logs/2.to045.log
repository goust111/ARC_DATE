+        (bbox[2] - bbox[0] + 1) * (bbox[3] - bbox[1] + 1)
+        for bbox in [c["bbox"] for c in components if c["bbox"] != comp["bbox"]]
+    ]
+    if not any(area >= frame_area for area in other_box_areas):
+        return False
+    h, w = grid.shape
+    for r in range(h):
