+def _render(shape: tuple[int, int], placed: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for item in placed:
+        patch = item["patch"]
+        r0, c0 = item["origin"]
+        ph, pw = patch.shape
+        view = grid[r0 : r0 + ph, c0 : c0 + pw]
+        mask = patch != 0
+        assert not np.any(view[mask] != 0)
+        view[mask] = patch[mask]
