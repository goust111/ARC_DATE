+    for r in range(h):
+        for c in range(w):
+            if int(region[r, c]) != 0 or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                cr, cc = q.popleft()
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(region[nr, nc]) == 0:
