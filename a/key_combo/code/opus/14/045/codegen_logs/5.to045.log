+        end += 1
+    if end == 0:
+        return np.array([], dtype=int)
+    tail = np.asarray(row[end:], dtype=int)
+    if np.any((tail != BLACK) & (tail != TEAL)):
+        raise AssertionError("partial rows may only have a left non-teal prefix")
+    return np.arange(end, dtype=int)
