+        if lid and int(g[TEMPLATE_A_ROW, c]) in (RED, BLUE):
+            comp_has_a[lid] = True
+        lid = int(labels[TEMPLATE_B_ROW, c])
+        if lid and int(g[TEMPLATE_B_ROW, c]) in (GREEN, YELLOW):
