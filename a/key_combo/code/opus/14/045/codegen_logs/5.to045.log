+    if len(set(meta["targets"])) != 2:
+        return False
+
+    # Non-overlapping lanes and B holes exactly on A lanes.
+    a_lanes = {lane for lane, target in zip(meta["lanes"], meta["targets"]) if target == "A"}
+    if not a_lanes.issubset(set(meta["holes_b"])):
