+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+TEMPLATE_A_ROW = 0
+TEMPLATE_B_ROW = 2
+PARTIAL_START_ROW = 5
+
+PREFIX_COLORS = [BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, MAROON]
+ROW_COLOR_PAIRS = [
+    (GREY, PINK),
+    (GREY, ORANGE),
+    (GREY, MAROON),
+    (PINK, ORANGE),
+    (PINK, MAROON),
+    (ORANGE, MAROON),
+    (BLUE, GREY),
+    (RED, PINK),
+    (GREEN, ORANGE),
+    (YELLOW, MAROON),
+]
+
+GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components4(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    comp_id = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            comp_id += 1
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            labels[r, c] = comp_id
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = comp_id
+                        q.append((nr, nc))
