+        touches_b = np.any((labels[TEMPLATE_B_ROW] == comp_id) & (grid[TEMPLATE_B_ROW] != BLACK))
+        if target == "A" and (not touches_a or touches_b):
+            return False
+        if target == "B" and (touches_a or not touches_b):
+            return False
+
