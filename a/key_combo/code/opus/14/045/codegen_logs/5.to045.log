+
+def _render_template(roles: list[int], colors: tuple[int, int], holes: set[int] | None = None) -> np.ndarray:
+    holes = holes or set()
+    row = np.zeros(len(roles), dtype=int)
+    for c, role in enumerate(roles):
+        if c in holes:
