+    for c in range(min(attach_col, lane_col), max(attach_col, lane_col) + 1):
+        grid[bridge_row, c] = TEAL
+    top_row = 1 if target == "A" else 3
+    for r in range(top_row, bridge_row + 1):
+        grid[r, lane_col] = TEAL
