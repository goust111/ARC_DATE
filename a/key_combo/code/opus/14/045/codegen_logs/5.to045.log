+
+
+def _decode_mapping(template: np.ndarray, row: np.ndarray, prefix_cols: np.ndarray) -> dict[int, int]:
+    mapping: dict[int, int] = {}
+    seen_template_colors = {int(template[c]) for c in prefix_cols}
