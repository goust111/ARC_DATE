+
+def _build_role_sequences(width: int, shared_len: int, rng: random.Random) -> tuple[list[int], list[int]]:
+    prefix = [0, 1]
+    while len(prefix) < shared_len:
+        prefix.append(rng.randrange(2))
+    if len(set(prefix)) != 2:
+        prefix[1] = 1 - prefix[0]
