+
+    solved = main(grid)
+    if solved.shape != grid.shape:
+        return False
+
+    template_a = np.asarray(grid[TEMPLATE_A_ROW], dtype=int)
+    template_b = np.asarray(grid[TEMPLATE_B_ROW], dtype=int)
