+    template_b = np.asarray(grid[TEMPLATE_B_ROW], dtype=int).copy()
+    template_a[template_a == TEAL] = BLACK
+    template_b[template_b == TEAL] = BLACK
+    return template_a, template_b
+
+
+def _partial_rows(grid: np.ndarray) -> list[int]:
