+TEAL = 8
+MAROON = 9
+
+TEMPLATE_A_ROW = 0
+TEMPLATE_B_ROW = 2
+PARTIAL_START_ROW = 5
+
+PREFIX_COLORS = [BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, MAROON]
+ROW_COLOR_PAIRS = [
+    (GREY, PINK),
+    (GREY, ORANGE),
+    (GREY, MAROON),
+    (PINK, ORANGE),
+    (PINK, MAROON),
+    (ORANGE, MAROON),
+    (BLUE, GREY),
+    (RED, PINK),
+    (GREEN, ORANGE),
+    (YELLOW, MAROON),
+]
+
+GEN_ATTEMPTS = 400
