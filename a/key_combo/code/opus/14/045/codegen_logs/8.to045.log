+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(
+        np.any(rows == 0)
+        or np.any(rows == h - 1)
+        or np.any(cols == 0)
+        or np.any(cols == w - 1)
+    )
+
+
+def _tight_mask(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    coords = np.argwhere(mask)
+    bbox = _bbox_from_coords(coords)
+    return mask[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1].copy(), bbox
+
+
+def _apply_transform(mask: np.ndarray, transform_idx: int) -> np.ndarray:
+    if transform_idx == 0:
+        return mask.copy()
+    if transform_idx == 1:
+        return np.fliplr(mask)
+    if transform_idx == 2:
+        return np.flipud(mask)
+    if transform_idx == 3:
+        return np.rot90(mask, -1)
+    if transform_idx == 4:
+        return np.fliplr(np.rot90(mask, -1))
+    if transform_idx == 5:
+        return np.rot90(mask, 2)
+    if transform_idx == 6:
+        return np.rot90(mask, 1)
+    if transform_idx == 7:
+        return np.fliplr(np.rot90(mask, 1))
+    raise ValueError(f"unknown transform index: {transform_idx}")
+
