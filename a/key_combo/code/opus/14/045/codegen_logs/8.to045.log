+
+def _bbox_gap_ok(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int) -> bool:
+    return (
+        a[2] + pad < b[0]
+        or b[2] + pad < a[0]
+        or a[3] + pad < b[1]
+        or b[3] + pad < a[1]
+    )
+
+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> None:
+    coords = np.argwhere(mask)
