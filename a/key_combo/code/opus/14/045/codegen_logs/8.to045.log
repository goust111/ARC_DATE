+    source_mask, earliest = random.choice(variants)
+    return {
+        "name": name,
+        "hole_mask": hole_mask,
+        "target_mask": target_mask,
+        "source_mask": source_mask,
+        "earliest_transform": earliest,
+        "template_patch_shape": patch.shape,
+        "render_info": patch_info,
+    }
+
