    h,w=mask.shape
    return 0 in rs and h-1 in rs and 0 in cs and w-1 in cs

def bbox(mask):
    coords=np.argwhere(mask)
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
    return mask[r0:r1+1,c0:c1+1]

def tf(mask,i):
    if i==0:return mask
    if i==1:return np.fliplr(mask)
    if i==2:return np.flipud(mask)
    if i==3:return np.rot90(mask,-1)
    if i==4:return np.fliplr(np.rot90(mask,-1))
    if i==5:return np.rot90(mask,2)
    if i==6:return np.rot90(mask,1)
    if i==7:return np.fliplr(np.rot90(mask,1))

def orbit(mask):
    vals=[]
    for i in range(8):
      m=tf(mask,i)
      vals.append((m.shape,m.tobytes(),m))
    out=[]
    seen=set()
    for sh,b,m in vals:
      if (sh,b) not in seen:
        seen.add((sh,b)); out.append(m)
    return out

