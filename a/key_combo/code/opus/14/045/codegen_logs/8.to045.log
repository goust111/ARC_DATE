GEN_MATCH_SHAPE_MAX_SPAN = 4
GEN_EXTRA_NONMATCH_PROB = 0.45

# --- CFG: generation retry budget ---
GEN_MAX_ATTEMPTS = 300

GEN_NONMATCH_SEED_SHAPES = (
