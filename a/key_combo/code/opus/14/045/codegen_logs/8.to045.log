GEN_SINGLE_BOTTOM_GAP_WIDTH = 3
GEN_WIDE_ARCH_SINGLE_GAP_PROB = 0.5
GEN_POCKET_CELLS_MIN, GEN_POCKET_CELLS_MAX = 2, 4

