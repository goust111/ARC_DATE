+        "kind": "template",
+        "color": int(color),
+        "coords": coords,
+        "bbox": bbox,
+        "hole_coords_local": hole_coords,
+        "hole_bbox_global": hole_global_bbox,
+        "hole_area": int(len(hole_coords)),
+        "target_mask": target_mask,
+        "target_bbox_global": target_global_bbox,
