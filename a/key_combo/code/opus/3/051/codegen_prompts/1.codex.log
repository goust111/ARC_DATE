    if n_labels == 0:
        return set()
    vals = set(map(int, labels[0, :]))
    vals.update(map(int, labels[-1, :]))
    vals.update(map(int, labels[:, 0]))
    vals.update(map(int, labels[:, -1]))
    vals.discard(0)
