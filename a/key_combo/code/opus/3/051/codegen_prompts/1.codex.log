    opts: list[DistractorOption] = []
    for r, c, h, w in frames:
        r1, c1 = r + h - 1, c + w - 1

        if r >= DISTRACTOR_MIN_BORDER_GAP:
            for a, b in _gen_span_pairs(c, c1):
                if np.all(g[:r, a : b + 1] == GEN_BLACK):
                    opts.append((DISTRACTOR_REDS_PER_EXTENSION * r, (r, a, r, b, "top")))

