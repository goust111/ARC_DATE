+        row_lines[slot_r] + 1,
+        row_lines[slot_r + 1] - 1,
+        col_lines[slot_c] + 1,
+        col_lines[slot_c + 1] - 1,
+    )
+
+
+def _slot_index(slot_r: int, slot_c: int, slot_cols: int) -> int:
+    return slot_r * slot_cols + slot_c
+
+
+def _slot_rc(slot_idx: int, slot_cols: int) -> tuple[int, int]:
