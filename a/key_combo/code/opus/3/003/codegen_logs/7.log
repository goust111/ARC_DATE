+def _erase_decorations(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    cleaned = np.asarray(grid, dtype=int).copy()
+    frame_mask = _boundary_frame_mask(cleaned)
+    cleaned[(cleaned == FRAME) & (~frame_mask)] = BG
