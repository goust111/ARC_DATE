+        r, c = queue.popleft()
+        for nr, nc in neighbors4(r, c):
+            if in_bounds((h, w), nr, nc) and grey[nr, nc] and not frame_mask[nr, nc]:
+                frame_mask[nr, nc] = True
+                queue.append((nr, nc))
+    return frame_mask
