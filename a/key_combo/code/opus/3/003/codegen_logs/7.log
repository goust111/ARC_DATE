+def _bfs_distances(graph: list[list[int]], start: int) -> dict[int, int]:
+    dist = {int(start): 0}
+    queue: deque[int] = deque([int(start)])
+    while queue:
+        node = queue.popleft()
+        for nxt in graph[node]:
+            if nxt not in dist:
+                dist[nxt] = dist[node] + 1
+                queue.append(nxt)
+    return dist
+
