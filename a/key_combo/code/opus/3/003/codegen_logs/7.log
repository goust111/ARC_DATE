+            wall_c = col_lines[max(cu, cv)]
+            candidates = list(range(row_lines[ru] + 1, row_lines[ru + 1]))
+            gaps[edge] = (rng.choice(candidates), wall_c)
+        else:
+            wall_r = row_lines[max(ru, rv)]
