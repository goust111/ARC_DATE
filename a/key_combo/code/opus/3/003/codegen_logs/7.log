+        for slot_r in rows[:family_count]:
+            safe_rows, safe_cols = _slot_safe_cells(row_lines, col_lines, slot_r, slot_c)
+            if len(safe_rows) < 2 or not safe_cols:
+                return None
+            cc = rng.choice(safe_cols)
+            for rr in safe_rows:
