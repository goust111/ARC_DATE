+    slot_rows = len(row_lines) - 1
+    slot_cols = len(col_lines) - 1
+    graph = [set() for _ in range(slot_rows * slot_cols)]
+
+    for slot_r in range(slot_rows):
+        for slot_c in range(slot_cols - 1):
