+FRAME = Color.GREY
+TIE = Color.RED
+SEED_COLORS = [Color.BLUE, Color.GREEN, Color.YELLOW, Color.ORANGE, Color.MAROON]
+GEN_ATTEMPTS = 400
+GRAPH_ATTEMPTS = 120
+SEED_ATTEMPTS = 100
+GAP_ATTEMPTS = 50
