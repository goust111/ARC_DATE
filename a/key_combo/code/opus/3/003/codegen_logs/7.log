+def _boundary_frame_mask(grid: np.ndarray) -> np.ndarray:
+    comps = find_components(
+        np.asarray(grid, dtype=int),
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[FRAME],
+        return_format="dict",
+    )
+    frame_mask = np.zeros(grid.shape, dtype=bool)
+    h, w = grid.shape
+    for comp in comps:
+        coords = comp["coords"]
+        touches_border = np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 0] == h - 1)
+            | (coords[:, 1] == 0)
+            | (coords[:, 1] == w - 1)
+        )
+        if touches_border:
+            frame_mask[coords[:, 0], coords[:, 1]] = True
+    return frame_mask
