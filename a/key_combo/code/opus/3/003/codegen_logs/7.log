+    if not family_slots:
+        candidate_cols = [
+            slot_c
+            for slot_c in range(slot_cols)
+            if sum(_slot_index(slot_r, slot_c, slot_cols) not in seed_slots for slot_r in range(slot_rows)) >= 2
