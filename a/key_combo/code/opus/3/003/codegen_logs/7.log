+
+def _coord_to_slot(r: int, c: int, row_lines: list[int], col_lines: list[int]) -> int:
+    slot_r = slot_c = None
+    for i in range(len(row_lines) - 1):
+        if row_lines[i] < r < row_lines[i + 1]:
+            slot_r = i
+            break
+    for j in range(len(col_lines) - 1):
+        if col_lines[j] < c < col_lines[j + 1]:
+            slot_c = j
+            break
