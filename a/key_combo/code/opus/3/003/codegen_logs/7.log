+def _make_gap_positions(meta: dict, rng: random.Random) -> dict[tuple[int, int], tuple[int, int]]:
+    row_lines = meta["row_lines"]
+    col_lines = meta["col_lines"]
+    slot_cols = meta["slot_cols"]
