+def _adj_from_edges(node_count: int, edges: set[tuple[int, int]]) -> list[list[int]]:
+    graph = [set() for _ in range(node_count)]
+    for u, v in edges:
+        graph[u].add(v)
+        graph[v].add(u)
+    return [sorted(neigh) for neigh in graph]
