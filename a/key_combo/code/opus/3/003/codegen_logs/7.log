+    for slot_r in range(slot_rows):
+        for slot_c in range(slot_cols - 1):
+            wall_c = col_lines[slot_c + 1]
+            r0 = row_lines[slot_r] + 1
+            r1 = row_lines[slot_r + 1] - 1
