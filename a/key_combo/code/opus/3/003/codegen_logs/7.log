+
+def _norm_edge(u: int, v: int) -> tuple[int, int]:
+    return (u, v) if u < v else (v, u)
+
+
+def _grid_size(slot_rows: int, slot_cols: int, cell_h: int, cell_w: int) -> tuple[int, int]:
+    return slot_rows * (cell_h + 1) + 1, slot_cols * (cell_w + 1) + 1
