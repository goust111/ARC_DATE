+            u = _slot_index(slot_r, slot_c, slot_cols)
+            if slot_c + 1 < slot_cols:
+                edges.append((u, _slot_index(slot_r, slot_c + 1, slot_cols)))
+            if slot_r + 1 < slot_rows:
+                edges.append((u, _slot_index(slot_r + 1, slot_c, slot_cols)))
+    return edges
