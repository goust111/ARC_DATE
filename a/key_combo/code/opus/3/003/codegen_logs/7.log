+    for edge in shuffled:
+        u, v = edge
+        if find(u) != find(v):
+            union(u, v)
+            tree_edges.add(edge)
+
+    open_edges = set(tree_edges)
+    extra_prob = rng.uniform(0.18, 0.5)
+    for edge in shuffled:
+        if edge not in open_edges and rng.random() < extra_prob:
+            open_edges.add(edge)
