+        r0, _r1, c0, _c1 = _slot_bounds(row_lines, col_lines, slot_r, slot_c)
+        seed_pixels[slot] = (
+            rng.choice(_slot_center_choices(r0, cell_h)),
+            rng.choice(_slot_center_choices(c0, cell_w)),
+        )
+    return seed_pixels
