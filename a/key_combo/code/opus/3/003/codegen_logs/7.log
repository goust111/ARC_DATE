+            (coords[:, 0] == 0)
+            | (coords[:, 0] == h - 1)
+            | (coords[:, 1] == 0)
+            | (coords[:, 1] == w - 1)
+        )
+        if touches_border:
+            frame_mask[coords[:, 0], coords[:, 1]] = True
