+    r0, r1, c0, c1 = _slot_bounds(row_lines, col_lines, slot_r, slot_c)
+    safe_rows = list(range(r0 + 1, r1))
+    safe_cols = list(range(c0 + 1, c1))
+    return safe_rows, safe_cols
+
