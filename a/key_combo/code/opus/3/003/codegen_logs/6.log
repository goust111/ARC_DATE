+def _corner_mark_positions(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return [
+        (r0 - 1, c0),
+        (r0, c0 - 1),
+        (r0 - 1, c1),
+        (r0, c1 + 1),
+        (r1 + 1, c0),
+        (r1, c0 - 1),
+        (r1 + 1, c1),
+        (r1, c1 + 1),
+    ]
