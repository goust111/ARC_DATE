+    if not {"solid", "hollow", "irregular"} <= {obj["kind"] for obj in objects}:
+        return False
+    if not any(obj["pseudo_square"] for obj in objects if obj["kind"] == "irregular"):
+        return False
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+
