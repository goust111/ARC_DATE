+                    red_positions.add((int(r), int(c)))
+            continue
+
+        for r, c in _outline_positions(info["shape"], out.shape):
+            if int(out[r, c]) == int(bg):
+                red_positions.add((int(r), int(c)))
+
+    for r, c in red_positions:
+        out[r, c] = RED
+    return out
