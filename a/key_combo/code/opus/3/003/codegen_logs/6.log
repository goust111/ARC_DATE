+    active_colors = rng.sample(INPUT_COLORS, rng.randint(2, min(5, len(INPUT_COLORS))))
+    for spec in specs:
+        spec["color"] = int(rng.choice(active_colors))
+
+    placed = _place_objects(specs, grid_shape, rng)
+    if placed is None:
+        return None
+    return _render_case(placed, grid_shape)
