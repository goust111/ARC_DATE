+            rect = _expanded_rect(r0, c0, h, w, grid_shape)
+            if any(_rects_overlap(rect, other) for other in reserved):
+                continue
+            placed_spec = {
+                **spec,
+                "r0": r0,
+                "c0": c0,
+                "bbox": (r0, c0, r0 + h - 1, c0 + w - 1),
+                "reserved": rect,
+            }
+            done = placed_spec
+            break
+        if done is None:
+            return None
+        reserved.append(done["reserved"])
+        placed.append(done)
+    return placed
