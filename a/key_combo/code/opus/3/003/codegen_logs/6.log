+            branch = "hollow"
+            shape = set(info["coords"]) | hole_coords
+        elif is_square:
+            branch = "solid"
+            shape = set(info["coords"])
+        else:
+            branch = "irregular"
+            shape = set(info["coords"])
+
+        annotated.append(
