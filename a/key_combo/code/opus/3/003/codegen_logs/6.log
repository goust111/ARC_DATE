+    outline: set[tuple[int, int]] = set()
+    for r, c in shape:
+        for nr, nc in neighbors8(r, c):
+            if in_bounds(grid_shape, nr, nc) and (nr, nc) not in shape:
+                outline.add((int(nr), int(nc)))
+    return outline
