   376	        for _ in range(PLACE_ATTEMPTS):
   377	            r0 = rng.randint(0, grid_shape[0] - h)
   378	            c0 = rng.randint(0, grid_shape[1] - w)
   379	            rect = _expanded_rect(r0, c0, h, w, grid_shape)
   380	            if any(_rects_overlap(rect, other) for other in reserved):
   381	                continue
   382	            placed_spec = {
   383	                **spec,
   384	                "r0": r0,
   385	                "c0": c0,
   386	                "bbox": (r0, c0, r0 + h - 1, c0 + w - 1),
   387	                "reserved": rect,
   388	            }
   389	            done = placed_spec
   390	            break
   391	        if done is None:
   392	            return None
   393	        reserved.append(done["reserved"])
   394	        placed.append(done)
   395	    return placed
   396	
   397	
   398	def _render_case(placed: list[dict], grid_shape: tuple[int, int]) -> dict:
   399	    grid = np.full(grid_shape, BLACK, dtype=int)
   400	    rendered: list[dict] = []
   401	    for spec in placed:
   402	        mask = spec["mask"]
   403	        hole_mask = spec["hole_mask"]
   404	        color = int(spec["color"])
   405	        r0 = int(spec["r0"])
   406	        c0 = int(spec["c0"])
   407	        coords = {(r0 + int(r), c0 + int(c)) for r, c in np.argwhere(mask)}
   408	        hole_coords = {(r0 + int(r), c0 + int(c)) for r, c in np.argwhere(hole_mask)}
   409	        for r, c in coords:
   410	            grid[r, c] = color
   411	        rendered.append(
   412	            {
   413	                **spec,
   414	                "coords": coords,
   415	                "hole_coords": hole_coords,
   416	            }
   417	        )
   418	    return {"grid": grid, "objects": rendered}
   419	
   420	
   421	def _expected_output(case: dict) -> np.ndarray:
   422	    grid = case["grid"]
   423	    out = grid.copy()
   424	    red_positions: set[tuple[int, int]] = set()
   425	    for obj in case["objects"]:
   426	        if obj["kind"] != "hollow":
   427	            continue
   428	        for r, c in obj["coords"]:
   429	            out[r, c] = TEAL
   430	        for r, c in obj["hole_coords"]:
   431	            out[r, c] = PINK
   432	
   433	    for obj in case["objects"]:
   434	        if obj["kind"] == "solid":
   435	            for r, c in _corner_mark_positions(obj["bbox"]):
   436	                if in_bounds(out.shape, r, c) and int(out[r, c]) == BLACK:
   437	                    red_positions.add((int(r), int(c)))
   438	            continue
   439	        if obj["kind"] == "hollow":
   440	            shape = set(obj["coords"]) | set(obj["hole_coords"])
   441	        else:
   442	            shape = set(obj["coords"])
   443	        for r, c in _outline_positions(shape, out.shape):
   444	            if int(out[r, c]) == BLACK:
   445	                red_positions.add((int(r), int(c)))
   446	
   447	    for r, c in red_positions:
   448	        out[r, c] = RED
   449	    return out
   450	
   451	
   452	def _shortcut_bbox_square_only(grid: np.ndarray) -> np.ndarray:
   453	    return _solve_with_mode(grid, square_mode="bbox", hollow_mode="true")
   454	
   455	
   456	def _shortcut_ignore_holes(grid: np.ndarray) -> np.ndarray:
   457	    return _solve_with_mode(grid, square_mode="complete", hollow_mode="ignore")
   458	
   459	
   460	def _visible_outline_pixels(grid: np.ndarray, shape: set[tuple[int, int]]) -> set[tuple[int, int]]:
   461	    return {coord for coord in _outline_positions(shape, grid.shape) if int(grid[coord]) == BLACK}
   462	
   463	
   464	def _validate_case(case: dict) -> bool:
   465	    grid = case["grid"]
   466	    objects = case["objects"]
   467	    if not (4 <= len(objects) <= 6):
   468	        return False
   469	    if not {"solid", "hollow", "irregular"} <= {obj["kind"] for obj in objects}:
   470	        return False
   471	    if not any(obj["pseudo_square"] for obj in objects if obj["kind"] == "irregular"):
   472	        return False
   473	    if grid.ndim != 2 or max(grid.shape) > 30:
   474	        return False
   475	
   476	    actual_components = find_components(grid, bg=BLACK, connectivity=4, monochromatic=True, return_format="dict")
   477	    if len(actual_components) != len(objects):
   478	        return False
   479	
   480	    expected_signature = sorted((obj["bbox"], len(obj["coords"]), int(obj["color"])) for obj in objects)
   481	    actual_signature = sorted((tuple(map(int, comp["bbox"])), int(comp["area"]), int(comp["color"])) for comp in actual_components)
   482	    if expected_signature != actual_signature:
   483	        return False
   484	
   485	    owner = {coord: idx for idx, obj in enumerate(objects) for coord in obj["coords"]}
   486	    for idx, obj in enumerate(objects):
   487	        for r, c in obj["coords"]:
   488	            for nr, nc in neighbors8(r, c):
   489	                other = owner.get((int(nr), int(nc)))
   490	                if other is not None and other != idx:
