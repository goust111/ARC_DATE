+
+    return {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "bbox_square": h == w,
+        "color": color,
+        "coords": coords,
+        "local_mask": local,
+        "complete_square": complete_square,
+        "hole_coords": hole_coords,
