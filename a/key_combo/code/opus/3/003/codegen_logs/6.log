   498	        elif obj["kind"] == "hollow":
   499	            if not obj["hole_coords"]:
   500	                return False
   501	            outline = _visible_outline_pixels(grid, set(obj["coords"]) | set(obj["hole_coords"]))
   502	            if not outline:
