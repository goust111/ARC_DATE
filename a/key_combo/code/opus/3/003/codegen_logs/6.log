+    coords = {(int(r), int(c)) for r, c in comp["coords"]}
+    for r, c in coords:
+        local[r - r0, c - c0] = True
+
+    complete_square = _mask_has_complete_square_border(local)
+    hole_coords: set[tuple[int, int]] = set()
+    if complete_square and h >= 3:
