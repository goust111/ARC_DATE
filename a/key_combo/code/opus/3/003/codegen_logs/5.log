+import math
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+_LINE_SPECS = ((3, 3), (3, 5), (5, 3))  # (square_size, square_count)
+_ISOLATED_SIZES = (3, 5, 7)
+_GRID_RANGE = (19, 30)  # exclusive upper bound
+_GEN_ATTEMPTS = 400
