+def _make_square(r0: int, c0: int, size: int) -> dict:
+    r1 = r0 + size - 1
+    c1 = c0 + size - 1
+    return {
+        "r0": r0,
+        "c0": c0,
+        "r1": r1,
+        "c1": c1,
+        "size": size,
+        "center": ((r0 + r1) / 2.0, (c0 + c1) / 2.0),
+    }
