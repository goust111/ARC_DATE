+def _prefix_sum(mask: np.ndarray) -> np.ndarray:
+    ps = mask.astype(np.int32).cumsum(axis=0).cumsum(axis=1)
+    return np.pad(ps, ((1, 0), (1, 0)), constant_values=0)
