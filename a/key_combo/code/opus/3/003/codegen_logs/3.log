+    g = np.asarray(grid, dtype=int)
+    analysis = _analyze(g)
+    out = g.copy()
+    for group, slot_colors in zip(analysis["groups"], analysis["group_colors"]):
+        for idx in group:
+            _fill_frame_slots(out, analysis["frames"][idx], slot_colors)
+    return out
