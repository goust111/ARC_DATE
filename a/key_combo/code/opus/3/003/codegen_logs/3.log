+            rr1 = analysis["frames"][idx]["rows"][slot[0] + 1]
+            cc0 = analysis["frames"][idx]["cols"][slot[1]] + 1
+            cc1 = analysis["frames"][idx]["cols"][slot[1] + 1]
+            region = inp[rr0:rr1, cc0:cc1]
