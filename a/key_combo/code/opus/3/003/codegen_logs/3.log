+        if any(len(mask) == 0 or len(mask) == len(slots) for mask in masks):
+            continue
+        if not all(
+            any(slot in masks[idx] and all(slot not in masks[j] for j in range(size) if j != idx) for slot in slots)
+            for idx in range(size)
