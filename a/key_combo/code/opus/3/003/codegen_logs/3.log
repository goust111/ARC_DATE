+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+FRAME = 5
+FILL_COLORS = [1, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 500
