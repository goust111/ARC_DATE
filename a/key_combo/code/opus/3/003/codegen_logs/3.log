+    if analysis["slot_shape"] != meta["slot_shape"]:
+        return False
+    if analysis["corridor_rows"] != meta["corridor_rows"]:
+        return False
+    if analysis["corridor_cols"] != meta["corridor_cols"]:
+        return False
+    if analysis["groups"] != meta["groups_expected"]:
+        return False
