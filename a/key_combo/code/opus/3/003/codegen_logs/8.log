+import numpy as np
+
+
+BG = 0
+TRACK = 9
+STRIPE_COLORS = (1, 2, 3, 8)
+SPRITE_COLORS = (4, 5, 6, 7)
+
+DIR_LEFT = "left"
+DIR_RIGHT = "right"
+DIR_UP = "up"
+DIR_DOWN = "down"
+
+SHAPES = (
+    np.array(
+        [
+            [0, 1, 2],
+            [2, 2, 0],
+            [0, 2, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 1, 0],
+            [0, 2, 2],
+            [2, 2, 0],
+        ],
+        dtype=int,
