+    tiers: list[list[np.ndarray]] = []
+    for ops in _transform_tiers():
+        seen: dict[tuple[tuple[int, int], bytes], np.ndarray] = {}
+        for family, rot_k in ops:
+            out = _transform_patch(patch, family, rot_k)
