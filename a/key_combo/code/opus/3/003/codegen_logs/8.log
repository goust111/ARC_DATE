+    directions = _direction_plan(n_sprites)
+    main_colors = random.sample(list(SPRITE_COLORS), n_sprites)
+
+    specs: list[dict] = []
+    nontrivial = False
+    for main_color, direction in zip(main_colors, directions):
+        marker_color = boundary_colors[direction]
+        made = None
+        for _ in range(60):
