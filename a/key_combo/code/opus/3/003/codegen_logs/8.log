+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+TRACK = 9
+STRIPE_COLORS = (1, 2, 3, 8)
+SPRITE_COLORS = (4, 5, 6, 7)
+
+DIR_LEFT = "left"
+DIR_RIGHT = "right"
+DIR_UP = "up"
+DIR_DOWN = "down"
+
+SHAPES = (
+    np.array(
