+
+def _expand_cells(
+    cells: Iterable[tuple[int, int]], shape: tuple[int, int], radius: int = 1
+) -> set[tuple[int, int]]:
+    h, w = shape
+    expanded: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
