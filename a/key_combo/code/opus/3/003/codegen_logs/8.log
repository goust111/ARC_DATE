+    assert not np.array_equal(grid, out), "output must differ from input"
+
+
+def _generate_horizontal_case(n_sprites: int, n_stripes: int) -> np.ndarray | None:
+    layout = _build_horizontal_layout(n_sprites, n_stripes)
+    if layout is None:
