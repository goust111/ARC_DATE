+            [0, 1, 2],
+            [2, 2, 0],
+            [0, 2, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 1, 0],
+            [0, 2, 2],
+            [2, 2, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 1, 0],
+            [2, 2, 2],
+            [0, 0, 2],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1, 2],
+            [2, 2, 2],
+            [2, 0, 0],
+        ],
+        dtype=int,
