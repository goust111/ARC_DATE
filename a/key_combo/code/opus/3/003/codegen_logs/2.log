+        for rr, cc, color in _copy_abs_pixels(rel, item["anchor"]):
+            if not in_bounds(base.shape, rr, cc) or protected[rr, cc]:
+                continue
+            key = (rr, cc)
+            current = claims.get(key)
+            if current is None or priority < current[0]:
+                claims[key] = (priority, int(color))
