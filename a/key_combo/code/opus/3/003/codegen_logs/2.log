+
+    rects: list[dict] = []
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        sub = crop_bbox(grid, comp["bbox"])
+        h, w = sub.shape
+        if h < 5 or w < 5:
