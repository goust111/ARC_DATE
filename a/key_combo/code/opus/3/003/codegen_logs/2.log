+def _source_bbox_at(sprite: dict, top_left: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, c0 = top_left
+    h, w = sprite["patch"].shape
+    return r0, c0, r0 + h - 1, c0 + w - 1
