+        r0, c0, r1, c1 = rect["bbox"]
+        grid[r0, c0 : c1 + 1] = FRAME
+        grid[r1, c0 : c1 + 1] = FRAME
+        grid[r0 : r1 + 1, c0] = FRAME
+        grid[r0 : r1 + 1, c1] = FRAME
+        mr = (r0 + r1) // 2
+        mc = c0 if rect["direction"] == "left" else c1
+        grid[mr, mc] = DIR_MARK
