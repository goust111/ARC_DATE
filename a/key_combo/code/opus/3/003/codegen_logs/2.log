+    h, w = shape
+    sh, sw = sprite["patch"].shape
+    candidates = []
+    for r0 in range(0, h - sh + 1):
+        for c0 in range(0, w - sw + 1):
+            box = _source_bbox_at(sprite, (r0, c0))
+            if all(_boxes_far_enough(box, rect["bbox"], gap=2) for rect in rects):
