+    visible = set()
+    masked = set()
+    for rr, cc, color in abs_pixels:
+        if not (r0 <= rr <= r1 and c0 <= cc <= c1):
+            return {"ok": False}
+        item = (int(rr), int(cc), int(color))
+        if rr in (r0, r1) or cc in (c0, c1):
