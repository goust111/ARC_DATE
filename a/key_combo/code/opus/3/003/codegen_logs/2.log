+        if r0 <= r <= r1 and c0 <= c <= c1:
+            return False
+    for rr in range(r - 1, r + 2):
+        for cc in range(c - 1, c + 2):
+            if in_bounds(grid.shape, rr, cc) and grid[rr, cc] != BG:
