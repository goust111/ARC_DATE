+    r0, c0, r1, c1 = rect["bbox"]
+    min_dr, max_dr, min_dc, max_dc = _rel_extents(rel_pixels)
+    row_lo = max(r0 + 1, r0 - min_dr)
+    row_hi = min(r1 - 1, r1 - max_dr)
+    col_lo = max(c0 + 1, c0 - min_dc)
+    col_hi = min(c1 - 1, c1 - max_dc)
