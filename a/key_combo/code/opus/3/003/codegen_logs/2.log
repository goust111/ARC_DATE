+def _rel_extents(rel_pixels: list[tuple[int, int, int]]) -> tuple[int, int, int, int]:
+    rows = [dr for dr, _dc, _color in rel_pixels]
+    cols = [dc for _dr, dc, _color in rel_pixels]
+    return min(rows), max(rows), min(cols), max(cols)
