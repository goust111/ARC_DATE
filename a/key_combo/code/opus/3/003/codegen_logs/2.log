+    scene["invalid_targets"] = candidates[:invalid_count]
+
+    if not _validate_scene(scene):
+        return None
+    return _render_input(scene)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
