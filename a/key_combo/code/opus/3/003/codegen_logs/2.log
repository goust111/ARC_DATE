+    source = candidates[0]
+    coords = source["coords"]
+    vals = grid[coords[:, 0], coords[:, 1]]
+    anchor = tuple(map(int, coords[vals == ANCHOR][0]))
+    sr, sc = anchor
+
+    rel_pixels = []
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        color = int(grid[rr, cc])
+        if color == ANCHOR:
+            continue
+        rel_pixels.append((rr - sr, cc - sc, color))
