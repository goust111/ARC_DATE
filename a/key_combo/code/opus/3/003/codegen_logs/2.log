+def _rectangle_data(grid: np.ndarray) -> list[dict]:
+    frame_mask = np.isin(grid, [FRAME, DIR_MARK]).astype(int)
+    comps = find_components(
+        frame_mask,
+        bg=0,
+        colors=[1],
+        connectivity=4,
+        monochromatic=True,
