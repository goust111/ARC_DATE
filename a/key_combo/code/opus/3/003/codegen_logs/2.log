+    for item in items:
+        rect = item["rect"]
+        rel = _mirror_rel_pixels(rel_pixels) if rect["direction"] == "left" else rel_pixels
+        priority = (
+            int(rect["area"]),
+            int(rect["bbox"][0]),
+            int(rect["bbox"][1]),
+            int(item["anchor"][0]),
+            int(item["anchor"][1]),
