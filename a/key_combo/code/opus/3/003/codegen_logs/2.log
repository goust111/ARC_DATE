+def _render_output_from_parts(
+    base: np.ndarray, rel_pixels: list[tuple[int, int, int]], targets: list[dict], rects: list[dict]
+) -> np.ndarray:
+    out = base.copy()
+    protected = _protected_mask(base.shape, rects)
