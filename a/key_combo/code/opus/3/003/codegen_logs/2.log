+        return False
+    if len(valid_targets) + len(invalid_targets) < 3 or len(valid_targets) + len(invalid_targets) > 6:
+        return False
+
+    directions = {scene["rects"][item["rect_index"]]["direction"] for item in valid_targets}
+    if directions != {"left", "right"}:
