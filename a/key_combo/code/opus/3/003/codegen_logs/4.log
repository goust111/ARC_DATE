+        "reach": reach,
+        "effective": effective,
+        "delta": (dr, dc),
+        "output": out,
+    }
+
+
+def _decor_allowed_mask(
+    grid: np.ndarray,
+    region_mask: np.ndarray,
+    blocked_coords: set[tuple[int, int]],
+) -> np.ndarray:
+    allowed = region_mask & (grid == BLACK)
