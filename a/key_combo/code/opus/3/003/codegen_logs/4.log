+        positions = sorted({int(c) for c in greens[:, 1]} | {anchor_c})
+        mk = lambda p: (line, p)
+    elif len(cols) == 1:
+        axis = "v"
+        line = cols[0]
+        assert anchor_c == line, "first red pixel must lie on the track column"
