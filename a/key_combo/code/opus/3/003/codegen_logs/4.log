+    allowed[0, :] = False
+    allowed[-1, :] = False
+    allowed[:, 0] = False
+    allowed[:, -1] = False
+
+    crowded = np.zeros_like(allowed, dtype=bool)
+    for r, c in blocked_coords:
+        if in_bounds(allowed.shape, r, c):
+            crowded[r, c] = True
+        for nr, nc in neighbors4(r, c):
