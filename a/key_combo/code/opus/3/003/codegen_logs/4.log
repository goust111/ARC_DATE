+    marker_left = rng.choice([True, False])
+    marker_top = rng.choice([True, False])
+    marker = (0 if marker_top else h - 1, 0 if marker_left else w - 1)
+    reachable_left = marker_left
+
+    use_pocket = rng.random() < 0.7
