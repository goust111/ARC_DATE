+            c0, c1 = sorted((pocket_c, split_c))
+            structural[branch_r, c0:c1 + 1] = True
+        else:
+            structural[branch_r:, pocket_c] = True
+            c0, c1 = sorted((pocket_c, split_c))
+            structural[branch_r, c0:c1 + 1] = True
