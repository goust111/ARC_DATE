+
+
+def _render_output(
+    shape: tuple[int, int],
+    structural: np.ndarray,
+    track_slots: list[tuple[int, int]],
+    effective_slots: set[tuple[int, int]],
+    red_coords: set[tuple[int, int]],
+    dr: int,
+    dc: int,
