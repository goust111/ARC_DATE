+    sources = np.full((PANEL_SIZE, PANEL_SIZE), -1, dtype=int)
+    for panel_index, layer in enumerate(layers):
+        mask = layer != BACKGROUND
+        out[mask] = layer[mask]
+        sources[mask] = panel_index
