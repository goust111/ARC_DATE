+
+def _layer_from_metadata(panel_objects: list[dict], keep_pred) -> np.ndarray:
+    layer = np.full((PANEL_SIZE, PANEL_SIZE), BACKGROUND, dtype=int)
+    for obj in panel_objects:
+        if keep_pred(obj):
+            rows, cols = zip(*obj["cells"])
+            layer[rows, cols] = obj["color"]
+    return layer
