+BACKGROUND = 0
+SEPARATOR = 5
+PANEL_SIZE = 10
+INPUT_SHAPE = (PANEL_SIZE, PANEL_SIZE * 3 + 2)
+AREA_MIN = 3
+AREA_MAX = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
