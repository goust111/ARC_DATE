+    panels = _split_panels(grid)
+    size = panels[0].shape[0]
+    out = np.full((size, size), BACKGROUND, dtype=int)
+    for panel in panels:
+        paste(out, _filtered_panel(panel), 0, 0, transparent=BACKGROUND)
+    return out
