+def _can_place(cells: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in cells:
+        if not (0 <= r < PANEL_SIZE and 0 <= c < PANEL_SIZE):
+            return False
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) in occupied:
+                    return False
+    return True
