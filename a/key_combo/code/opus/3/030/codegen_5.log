+def _render_input(panels: list[np.ndarray]) -> np.ndarray:
+    grid = np.full(INPUT_SHAPE, BACKGROUND, dtype=int)
+    grid[:, PANEL_SIZE] = SEPARATOR
+    grid[:, 2 * PANEL_SIZE + 1] = SEPARATOR
