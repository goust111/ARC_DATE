+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PANEL_BUILD_RETRIES = 120
+PLACEMENT_RETRIES = 160
+GEN_ATTEMPTS = 500
+PANEL_AREA_BUDGET = 26
