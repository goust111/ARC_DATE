def _sample_patch(H: int, segs: list[tuple[int, int]], obj_i: int, color: int, budget: int, remaining: int):
    area = _choose_area(H, segs[obj_i], budget, remaining)
    if area is None:
        return None
    patch = _object_patch(H, segs[obj_i], color, area)
    if patch is None:
