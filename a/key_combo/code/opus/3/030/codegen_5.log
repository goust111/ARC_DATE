+    return {
+        "count": count,
+        "modal_area": int(modal_area),
+        "modal_count": int(modal_count),
+        "areas": [int(area) for area in areas],
+        "retained_indices": retained_indices,
+        "anchor_index": random.choice(retained_indices),
+        "relation": relation,
