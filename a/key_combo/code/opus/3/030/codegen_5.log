+def _split_panels(grid: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert tuple(map(int, g.shape)) == INPUT_SHAPE, "expected a 10x32 grid with three 10x10 panels"
+    assert bool(np.all(g[:, PANEL_SIZE] == SEPARATOR)), "first separator column must be solid gray"
+    assert bool(np.all(g[:, 2 * PANEL_SIZE + 1] == SEPARATOR)), "second separator column must be solid gray"
+    return [
+        g[:, :PANEL_SIZE].copy(),
+        g[:, PANEL_SIZE + 1 : 2 * PANEL_SIZE + 1].copy(),
