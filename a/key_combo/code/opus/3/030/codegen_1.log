+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+OUTPUT_HOLE_COLOR = 2
+INPUT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+BLOCK_SIZE = 5
+INTERIOR_CELLS = tuple((r, c) for r in range(1, 4) for c in range(1, 4))
+HOLE_COUNTS = (1, 2, 3, 4)
+MIN_GAP = 1
+
+LAYOUTS_BY_BLOCK_COUNT = {
+    4: ((2, 2), (2, 3), (3, 2)),
+    5: ((2, 3), (3, 2)),
+    6: ((2, 3), (3, 2)),
+}
+
+MAX_GENERATION_ATTEMPTS = 400
+MIN_CANVAS_DIM = 14
+CANVAS_EXTRA = 6
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    colors, counts = np.unique(grid, return_counts=True)
+    return int(colors[np.argmax(counts)])
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+
+    return components
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    height, width = grid.shape
+    seen = np.zeros_like(grid, dtype=bool)
+    objects: list[dict] = []
+
+    for r in range(height):
+        for c in range(width):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            coords_arr = np.array(coords, dtype=int)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": _bbox_coords(coords_arr),
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
+
+    return objects
+
+
+def _is_contiguous(block: np.ndarray, fg: int = 1) -> bool:
+    return len(_components_from_mask(block == fg)) == 1
+
+
+def _build_pattern_catalog() -> dict[int, list[tuple[tuple[int, int], ...]]]:
+    catalog: dict[int, list[tuple[tuple[int, int], ...]]] = {count: [] for count in HOLE_COUNTS}
+    for hole_count in HOLE_COUNTS:
+        for cells in combinations(INTERIOR_CELLS, hole_count):
+            block = np.ones((BLOCK_SIZE, BLOCK_SIZE), dtype=int)
+            for r, c in cells:
+                block[r, c] = BG
+            if _is_contiguous(block, fg=1):
