+
+    for r in range(height):
+        for c in range(width):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        0 <= nr < height
+                        and 0 <= nc < width
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            coords_arr = np.array(coords, dtype=int)
+            objects.append(
