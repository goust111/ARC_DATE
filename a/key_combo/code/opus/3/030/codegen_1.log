  99: def _object_patch(H: int, cols: tuple[int, int], color: int, area: int) -> np.ndarray | None:
 100:     c0, c1 = cols
 101:     W = c1 - c0 + 1
 102:     target = int(area)
 103:     if target < 1 or target > H * W:
 104:         return None
 105: 
 106:     start = (random.randrange(H), random.randrange(W))
 107:     cells = {start}
 108:     frontier: set[tuple[int, int]] = set()
 109: 
 110:     def add_frontier(r: int, c: int) -> None:
 111:         for dr, dc in _NEIGHBOR_DELTAS:
 112:             rr, cc = r + dr, c + dc
 113:             if 0 <= rr < H and 0 <= cc < W and (rr, cc) not in cells:
 114:                 frontier.add((rr, cc))
 115: 
 116:     add_frontier(*start)
 117:     while len(cells) < target:
 118:         if not frontier:
 119:             return None
 120:         if random.random() < _FRONTIER_COMPACT_BIAS:
 121:             options = sorted(
 122:                 frontier,
 123:                 key=lambda rc: sum(
 124:                     (rc[0] + dr, rc[1] + dc) in cells for dr, dc in _NEIGHBOR_DELTAS
 125:                 ),
 126:                 reverse=True,
 127:             )
 128:             top_k = max(1, min(_FRONTIER_COMPACT_TOP_K, len(options)))
 129:             cell = random.choice(options[:top_k])
 130:         else:
 131:             cell = random.choice(tuple(frontier))
 132:         frontier.remove(cell)
 133:         cells.add(cell)
 134:         add_frontier(*cell)
 135: 
 136:     patch = np.full((H, H), _BG, dtype=int)
 137:     for r, c in cells:
 138:         patch[r, c0 + c] = int(color)
 139:     return patch
