+    if base > total:
+        return None
+
+    extras = [0] * (slots + 1)
+    for _ in range(total - base):
+        extras[random.randrange(slots + 1)] += 1
+
+    positions: list[int] = []
+    cursor = extras[0]
+    for idx in range(slots):
+        positions.append(cursor)
