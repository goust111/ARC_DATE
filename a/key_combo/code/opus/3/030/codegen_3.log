+    seen: set[tuple[int, int]] = set()
+    for point in ordered:
+        if point not in seen:
+            seen.add(point)
+            points.append(point)
+    return points
+
+
+def _render_input(shape: tuple[int, int], boxes: list[BBox], colors: list[int]) -> np.ndarray:
+    grid = np.full(shape, Color.BLACK, dtype=int)
