+    child = boxes[0]
+    child_h = bbox_h(child)
+    child_w = bbox_w(child)
+
+    if side == "right":
+        parent_h, parent_w = child_h + 2, child_w + int(gap) + 2
+        dr, dc = 1, 1
+    elif side == "left":
+        parent_h, parent_w = child_h + 2, child_w + int(gap) + 2
+        dr, dc = 1, 1 + int(gap)
+    elif side == "top":
+        parent_h, parent_w = child_h + int(gap) + 2, child_w + 2
+        dr, dc = 1 + int(gap), 1
