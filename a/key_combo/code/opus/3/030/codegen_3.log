+def _wrap_boxes(boxes: list[BBox], side: str, gap: int) -> list[BBox]:
+    child = boxes[0]
+    child_h = bbox_h(child)
+    child_w = bbox_w(child)
+
+    if side == "right":
+        parent_h, parent_w = child_h + 2, child_w + int(gap) + 2
+        dr, dc = 1, 1
+    elif side == "left":
+        parent_h, parent_w = child_h + 2, child_w + int(gap) + 2
