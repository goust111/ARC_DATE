+        "h": h,
+        "w": w,
+        "tops": tops,
+        "bottoms": bottoms,
+        "lefts": lefts,
+        "rights": rights,
+        "path_cols": path_cols,
+        "door_cols": door_cols,
+    }
+
+
+def _build_grid(layout: dict) -> np.ndarray:
+    grid = np.full((layout["h"], layout["w"]), BLACK, dtype=int)
