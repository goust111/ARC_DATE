+
+LOOP_H_RANGE = (8, 12)
+LOOP_W_RANGE = (10, 16)
+NOTCH_COUNT_CHOICES = [2, 2, 3, 3, 4]
+NOTCH_WIDTH_RANGE = (2, 4)
+EDGE_MARGIN = 2
+SAME_SIDE_GAP = 2
+MAX_NOTCH_DEPTH = 3
+GEN_RETRIES = 500
+LOOP_ATTEMPTS = 120
+SEPARATOR_GAP_RANGE = (1, 4)
+SEPARATOR_MARGIN_RANGE = (0, 3)
