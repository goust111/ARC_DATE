+            if not _apply_notch(top, bottom, side, start, end):
+                ok = False
+                break
+        if not ok:
+            continue
+
+        patch = _build_loop_patch(top, bottom)
+        if patch is None:
+            continue
+        patch = np.rot90(patch, random.randrange(4)).copy()
+        if random.random() < 0.5:
+            patch = np.fliplr(patch).copy()
+        if random.random() < 0.5:
+            patch = np.flipud(patch).copy()
+        return patch
