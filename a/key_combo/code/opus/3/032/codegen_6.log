+    out: list[tuple[int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if not np.all(interior[r : r + 2, c : c + 2]):
+                continue
+            r0 = max(0, r - 1)
+            r1 = min(h, r + 3)
+            c0 = max(0, c - 1)
+            c1 = min(w, c + 3)
+            if np.any(loop_mask[r0:r1, c0:c1]):
