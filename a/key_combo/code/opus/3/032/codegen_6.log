+
+def _marker_clear(raw: np.ndarray) -> bool:
+    marker = np.argwhere(raw == PINK)
+    loop = raw == TEAL
+    for r, c in marker:
+        for dr, dc in DIRS8:
+            nr = int(r + dr)
+            nc = int(c + dc)
+            if 0 <= nr < raw.shape[0] and 0 <= nc < raw.shape[1] and loop[nr, nc]:
+                return False
+    return True
