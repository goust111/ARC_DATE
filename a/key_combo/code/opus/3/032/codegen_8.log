+                mask = np.array(
+                    [(bits >> i) & 1 for i in range(h * w)],
+                    dtype=bool,
+                ).reshape(h, w)
+                area = int(mask.sum())
+                if not 3 <= area <= 6:
+                    continue
+                if area == mask.size:
+                    continue
+                if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+                    continue
+                if len(components_mask(mask, connectivity=4)) != 1:
+                    continue
+                all_masks.append(mask.copy())
+
+                if not 4 <= area <= 5:
+                    continue
+                if int(mask[:, -1].sum()) <= int(mask[:, 0].sum()):
+                    continue
