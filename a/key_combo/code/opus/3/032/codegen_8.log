+    dr, dc = map(int, direction)
+    for _ in range(int(turns) % 4):
+        dr, dc = -dc, dr
+    if flip:
+        dc = -dc
+    return int(dr), int(dc)
+
+
+def _candidate_direction_for_transform(turns: int, flip: bool) -> tuple[int, int]:
