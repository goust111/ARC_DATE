50: def main(grid: np.ndarray) -> np.ndarray:
51:     """
52:     Assemble scattered jigsaw sprites around a central yellow anchor by pairing red connector pixels.
53: 
54:     Input structure:
55:     - bg = black (0). Several colored sprites scattered on the grid.
56:     - One anchor sprite contains a 3×3 yellow (4) block.
57:     - Each sprite has red (2) connector pixels along its edges.
58: 
59:     Rule:
60:     - The anchor stays in place; remaining sprites attach one at a time.
61:     - Each sprite is translated so that one of its red pixels overlaps an unpaired red pixel on the growing assembly.
62:     - Every red connector must pair with exactly one other, forming a complete joined structure.
63: 
64:     Key insight: Red pixels act as jigsaw pegs — each must match exactly one counterpart, and the assembly order is determined by which unpaired connectors remain.
65:     """
66:     g = np.asarray(grid, dtype=int)
67:     h, w = g.shape
68:     bg = 0
69: 
70:     pieces = _extract_pieces(g, bg)
71:     assert pieces, "input must have at least one colored piece"
72: 
73:     # Anchor is the unique piece containing the 3x3 yellow (color 4) block.
74:     anchors = [p for p in pieces if np.any(p["arr"] == 4)]
75:     assert len(anchors) == 1, "input must have exactly one yellow (4) anchor piece"
76:     anchor = anchors[0]
77:     rest = [p for p in pieces if p is not anchor]
78: 
79:     canvas = np.full((h, w), bg, dtype=int)
80:     ar0, ac0, _, _ = anchor["bbox"]
81:     placed = _try_place(canvas, anchor["arr"], ar0, ac0, bg)
82:     assert placed is not None, "anchor piece must fit on canvas at its original position"
83: 
84:     total_ports = int(sum(len(p["reds"]) for p in pieces))
85:     assert total_ports % 2 == 0, "total red connector ports must be even for complete pairing"
86:     target_unique_red = total_ports // 2
87: 
88:     # Track how many original red pixels map to each assembled red coordinate.
89:     red_counts: dict[tuple[int, int], int] = {}
90:     for rr, cc in anchor["reds"]:
91:         red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1
92: 
93:     # Backtracking assembly by pairing up red connector pixels.
94:     solutions: list[np.ndarray] = []
95: 
96:     def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:
97:         if len(solutions) >= 2:
98:             return
99: 
100:         if not remaining:
101:             if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):
102:                 solutions.append(cur)
103:             return
104: 
105:         if len(rc) > target_unique_red:
106:             return
107: 
108:         # Unpaired reds are exactly those with count==1; always pair one of them next.
109:         unpaired = [k for k, v in rc.items() if v == 1]
110:         if not unpaired:
111:             return
112: 
113:         rc1 = {k for k, v in rc.items() if v == 1}
114: 
115:         # Pick the most constrained unpaired red coordinate: fewest ways to cover it.
116:         best_moves = None
117:         for t in unpaired:
118:             moves = []
119:             tr, tc = t
120:             for idx, p in enumerate(remaining):
121:                 ph, pw = p["shape"]
122:                 for pr, pc in p["reds"]:
123:                     top = tr - pr
124:                     left = tc - pc
125:                     if top < 0 or left < 0 or top + ph > h or left + pw > w:
126:                         continue
127:                     # quick red-count feasibility
128:                     bad = False
129:                     overlap = 0
130:                     for rr, cc in p["reds"]:
131:                         gr, gc = top + rr, left + cc
132:                         prev = rc.get((gr, gc), 0)
133:                         if prev >= 2:
134:                             bad = True
135:                             break
136:                         if (gr, gc) in rc1:
137:                             overlap += 1
138:                     if bad:
139:                         continue
140:                     # must overlap at least the target (guaranteed), but keep for scoring
141:                     moves.append((idx, top, left, overlap))
142:             if not moves:
143:                 return
144:             if best_moves is None or len(moves) < len(best_moves):
145:                 best_moves = moves
146:                 if len(best_moves) == 1:
147:                     break
148: 
149:         assert best_moves is not None, "there must be at least one feasible connector move"
150: 
151:         # Deduplicate moves by (piece, top, left) keeping max overlap score.
152:         dedup: dict[tuple[int, int, int], int] = {}
153:         for idx, top, left, ov in best_moves:
154:             k = (idx, top, left)
155:             dedup[k] = max(dedup.get(k, 0), ov)
156:         moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]
157:         moves2.sort(key=lambda x: (-x[3], -remaining[x[0]]["area"], x[1], x[2], x[0]))
158: 
159:         for idx, top, left, _ov in moves2:
160:             p = remaining[idx]
