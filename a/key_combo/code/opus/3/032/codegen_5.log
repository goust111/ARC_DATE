+def _endpoint_outward_direction(path: dict, which: str) -> tuple[tuple[int, int], tuple[int, int]]:
+    points = path["points"]
+    if which == "start":
+        a, b = points[0], points[1]
+        step = (_sgn(b[0] - a[0]), _sgn(b[1] - a[1]))
+        return a, (-step[0], -step[1])
