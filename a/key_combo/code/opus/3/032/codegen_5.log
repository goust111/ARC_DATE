+def _axis_spans(length: int, vertices: list[int], anchors: list[int]) -> list[tuple[int, int]]:
+    assert len(vertices) == len(anchors)
+    anchor_by_vertex = dict(zip(vertices, anchors))
+    spans: list[tuple[int, int]] = []
