+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LINE_COLORS = (Color.BLUE, Color.RED)
+GEN_ATTEMPTS = 400
+WORK_H_RANGE = (6, 8)
+WORK_W_RANGE = (6, 9)
+BASE_PATH_COUNT_RANGE = (2, 3)
+EXTRA_SEGMENT_COUNT_RANGE = (1, 2)
+REPAIR_SEGMENT_COUNT_CHOICES = (1, 2, 2, 3)
+PATH_PADDING = 1
+ANCHOR_STEP_MIN = 2
+ANCHOR_STEP_MAX = 4
