+def _render_paths(shape: tuple[int, int], paths: list[dict]) -> np.ndarray:
+    proto = np.zeros(shape, dtype=int)
+    for path in paths:
+        color = int(path["color"])
+        for r, c in path["cells"]:
+            proto[r, c] = color
+    return proto
