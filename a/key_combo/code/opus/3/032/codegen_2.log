+    h, w = out.shape
+    col = 0
+    for group in groups:
+        side = int(group["side"])
+        if col + side > w or side > h:
+            raise ValueError("repacked squares do not fit in the canvas")
+        out[h - side : h, col : col + side] = ARROW
+        col += side + 1
+    return out
+
+
+def _sample_square_sides(count: int) -> list[int]:
+    for _ in range(200):
