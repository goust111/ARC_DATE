+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_ARC_UTILS_DIR))
+
+from arc_utils import Color, crop_bbox, find_components, get_bg, paste
+
+
+BG = Color.BLACK
