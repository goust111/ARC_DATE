+def _extract_groups(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    comps = find_components(
+        g,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[ARROW],
+        return_format="dict",
+    )
+    groups: list[dict] = []
+    for comp in sorted(comps, key=lambda item: tuple(map(int, item["bbox"]))):
