+    "U": "R",
+    "R": "D",
+    "D": "L",
+    "L": "U",
+}
+ALL_DIRS = tuple(DIRS)
+
+GEN_RETRIES = 500
+GRID_H_RANGE = (18, 26)
+GRID_W_MAX = 26
