+
+def _sample_directions(count: int) -> list[str]:
+    distinct = random.randint(2, min(4, count))
+    picks = random.sample(ALL_DIRS, distinct)
+    while len(picks) < count:
+        picks.append(random.choice(ALL_DIRS))
+    random.shuffle(picks)
+    return picks
