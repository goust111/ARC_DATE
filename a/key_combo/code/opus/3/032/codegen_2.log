+    reserved_steps: set[tuple[int, int]],
+    visible_halo: set[tuple[int, int]],
+    occupied_visible: set[tuple[int, int]],
+    arrow_halo: set[tuple[int, int]],
+    global_obstacles: set[tuple[int, int]],
+) -> dict | None:
+    extra = int(side * side - 5)
+    variants = [0, 1]
