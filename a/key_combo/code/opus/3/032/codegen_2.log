+        if sum(sides) + count - 1 <= GRID_W_MAX:
+            return [int(v) for v in sides]
+    raise RuntimeError("failed to sample square sides")
+
+
+def _sample_directions(count: int) -> list[str]:
+    distinct = random.randint(2, min(4, count))
