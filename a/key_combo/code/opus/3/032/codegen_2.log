+        return False
+    for comp in comps:
+        area = int(comp["area"])
+        side = math.isqrt(area)
+        if side * side != area:
+            return False
+        r0, _c0, r1, _c1 = map(int, comp["bbox"])
+        if r1 != h - 1 or r0 != h - side:
+            return False
+    return True
