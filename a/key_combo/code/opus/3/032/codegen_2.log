+
+    for variant in variants:
+        patch = _arrow_patch(direction, variant)
+        ph, pw = patch.shape
+        positions = [
+            (r, c)
+            for r in range(1, shape[0] - ph)
+            for c in range(1, shape[1] - pw)
+        ]
+        random.shuffle(positions)
+
+        for top, left in positions[:PLACEMENT_TRIALS]:
