+def _mark_halo(mask: np.ndarray, center: tuple[int, int]) -> None:
+    r, c = center
+    h, w = mask.shape
+    r0 = max(0, r - 1)
+    r1 = min(h, r + 2)
+    c0 = max(0, c - 1)
+    c1 = min(w, c + 2)
+    mask[r0:r1, c0:c1] = True
+
