+# --------------- generator ---------------
+
+GRID_H_RANGE = (15, 24)
+GRID_W_RANGE = (15, 24)
+LOOP_COUNT_CHOICES = [1, 2, 2, 3]
+PATCH_ATTEMPTS = 80
+GEN_RETRIES = 400
+
+MIN_PATCH_H = 5
+MAX_PATCH_H_SINGLE = 11
+MAX_PATCH_H_MULTI = 9
+MIN_PATCH_W = 6
+MAX_PATCH_W_SINGLE = 13
+MAX_PATCH_W_MULTI = 10
