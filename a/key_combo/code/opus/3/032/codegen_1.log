+    bg = get_bg(g)
+    colors = sorted(set(map(int, g.reshape(-1))) - {bg})
+    assert len(colors) == 1
+    fg = int(colors[0])
+
+    convex_cover = np.zeros_like(g, dtype=bool)
+    concave_cover = np.zeros_like(g, dtype=bool)
