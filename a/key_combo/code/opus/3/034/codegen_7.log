# Canvas bounds.
_GEN_GRID_ROWS_RANGE = (13, 15)
_GEN_GRID_COLS_RANGE = (13, 15)

# Motif structure.
_GEN_MOTIF_COUNT_RANGE = (3, 4)
_GEN_SKELETON_SIZE_RANGE = (5, 6)
_GEN_SKELETON_BBOX_MAX = (5, 5)
_GEN_MARKER_COUNT_RANGE = (3, 5)
