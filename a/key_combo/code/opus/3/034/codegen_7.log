+def _crop_mask(mask: np.ndarray) -> np.ndarray | None:
+    box = _bbox(mask)
+    if box is None:
+        return None
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _expand_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros((2 * h - 1, w), dtype=bool)
+    out[:h, :] |= mask
+    out[h - 1 :, :] |= mask[::-1, :]
+    return out
+
