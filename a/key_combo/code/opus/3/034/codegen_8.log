+    source_extra_abs = []
+    source_interior = _interior_patch(g, containers[source_idx])
+    ir0, ic0, _ir1, _ic1 = containers[source_idx]["interior_bbox"]
+    for r, c in np.argwhere(source_interior != int(bg)):
