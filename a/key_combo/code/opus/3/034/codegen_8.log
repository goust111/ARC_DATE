+        if not frame.issubset(coords):
+            continue
+        tail = coords - frame
+        if _matches_tail(core_bbox, tail_side, tail):
+            candidates.append(
+                {
+                    "color": int(comp["color"]),
+                    "core_bbox": core_bbox,
+                    "tail": tuple(sorted(tail)),
+                    "tail_side": tail_side,
+                    "open_side": OPPOSITE_SIDE[tail_side],
+                    "interior_bbox": (cr0 + 1, cc0 + 1, cr1 - 1, cc1 - 1),
