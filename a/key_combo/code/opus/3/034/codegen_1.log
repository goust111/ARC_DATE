+def _shape_dims(shape: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    return 1 + max(r for r, _ in shape), 1 + max(c for _, c in shape)
+
+
+def _cells_by_col(cells: list[tuple[int, int]]) -> dict[int, list[int]]:
