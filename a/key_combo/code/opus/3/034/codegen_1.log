+    sep_adj = sep_r - 1 if fill_from_top else sep_r + 1
+    overlap_edge = out[sep_adj, overlap_c0 : overlap_c1 + 1] == int(FILL)
+    if not overlap_edge.any() or overlap_edge.all():
