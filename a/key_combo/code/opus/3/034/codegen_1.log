+
+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randint(*GRID_HEIGHT_RANGE)
+    width = random.randint(*GRID_WIDTH_RANGE)
+    fill_from_top = bool(random.getrandbits(1))
+    sep_r = random.randint(5, height - 6)
