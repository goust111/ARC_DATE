+    if bg is None:
+        bg = get_bg(g)
+    bg = int(bg)
+    allowed = None if colors is None else {int(color) for color in colors}
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            if allowed is not None and color not in allowed:
+                continue
+
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords = []
+            root_color = color
+
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w) or seen[nr, nc]:
+                        continue
+                    neighbor_color = int(g[nr, nc])
+                    if neighbor_color == bg:
