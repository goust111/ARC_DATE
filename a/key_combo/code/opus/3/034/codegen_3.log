+            if seen[r, c] or color == bg:
+                continue
+            if allowed is not None and color not in allowed:
+                continue
+
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords = []
+            root_color = color
+
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
