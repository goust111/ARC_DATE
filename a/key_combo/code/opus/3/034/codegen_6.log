+                cells.append((r, c))
+                for dr, dc in deltas:
+                    nr, nc = r + dr, c + dc
+                    if not (0 <= nr < h and 0 <= nc < w) or seen[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
