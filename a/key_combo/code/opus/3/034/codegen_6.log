        if rect["height"] > 2 and rect["width"] > 2:
            out[rect["r0"] + 1 : rect["r1"], rect["c0"] + 1 : rect["c1"]] = BG

    out[-1, :] = _summary_row(rectangles, g.shape[1])
    return out


