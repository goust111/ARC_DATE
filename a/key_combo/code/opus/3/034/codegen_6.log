+    dest_c = top_c0 + 1 + (top_span - scaled.shape[1]) // 2
+    dest_r = height - scaled.shape[0]
+    assert 0 <= dest_r <= height - scaled.shape[0]
+    assert 0 <= dest_c <= width - scaled.shape[1]
