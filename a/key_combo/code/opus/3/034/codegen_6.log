+
+def _scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
+    if _arc_scale_sprite is not None:
+        return _arc_scale_sprite(sprite, factor)
+    return np.kron(sprite, np.ones((int(factor), int(factor)), dtype=sprite.dtype))
