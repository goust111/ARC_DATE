+            coords = np.array(cells, dtype=int)
+            r1, c1 = coords.max(axis=0)
+            rmin, cmin = coords.min(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (int(rmin), int(cmin), int(r1), int(c1)),
+                    "area": int(len(cells)),
