+    for r in range(bh):
+        for c in range(bw):
+            if not base_mask[r, c]:
+                continue
+            cr = r * k + center
+            cc = c * k + center
+            if c + 1 < bw and base_mask[r, c + 1]:
+                out[cr, cc : (c + 1) * k + center + 1] = True
