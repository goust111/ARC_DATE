+            row_max=height - patch.shape[0] - 1,
+            col_min=1,
+            col_max=width - patch.shape[1] - 1,
+        )
+        if placed is None:
+            return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if out.shape != grid.shape or max(out.shape) > 30:
+        return None
+    return grid
