+def _random_connected_cells(height, width, target, start):
+    cells = {start}
+    frontier = set()
+    for dr, dc in NEIGHBORS4:
+        nr, nc = start[0] + dr, start[1] + dc
+        if 0 <= nr < height and 0 <= nc < width:
+            frontier.add((nr, nc))
