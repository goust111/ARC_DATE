+
+
+def _expected_output(base_mask, missing_mask, kind):
+    out = np.full(base_mask.shape, BG, dtype=int)
+    out[base_mask] = OUTPUT_COLOR_BY_KIND[kind]
+    out[missing_mask] = DIVIDER
+    return out
