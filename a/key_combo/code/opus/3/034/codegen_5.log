+    tile_cols = 3
+    tile_h = random.randint(4, 6)
+    tile_w = random.randint(4, 6)
+    kind = random.choice(["H", "V", "D", "HV"])
+    shape_color = random.choice(INPUT_COLORS)
+
+    base_mask = _generate_base_mask(tile_h, tile_w, kind)
+    if base_mask is None:
