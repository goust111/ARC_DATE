+
+def _generate_hv_patch(height, width):
+    seed_h, seed_w = (height + 1) // 2, (width + 1) // 2
+    start = (seed_h - 1, seed_w - 1)
+    limit = max(3, min(seed_h * seed_w, seed_h + seed_w + 1))
+    target = random.randint(2, limit)
