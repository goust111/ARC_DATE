+    consensus_mask = consensus != bg
+    kind = _symmetry_kind(consensus_mask)
+    out = np.full(consensus.shape, bg, dtype=int)
+    out[consensus_mask] = OUTPUT_COLOR_BY_KIND[kind]
+    out[missing_mask] = DIVIDER
+    return out
