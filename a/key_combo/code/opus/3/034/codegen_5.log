+    for r, c in cells:
+        mirrored.add((r, c))
+        mirrored.add((r, width - 1 - c))
+    return mirrored
+
+
+def _generate_h_or_v_patch(height, width, kind):
+    if kind == "H":
+        seed_h, seed_w = (height + 1) // 2, width
+        start = (seed_h - 1, random.randrange(seed_w))
