+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        for dr, dc in NEIGHBORS4:
+            nr, nc = cell[0] + dr, cell[1] + dc
+            if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
