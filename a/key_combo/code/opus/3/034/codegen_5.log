+def _cells_to_mask(shape, cells):
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _mirror_horizontal(cells, height):
+    mirrored = set()
+    for r, c in cells:
+        mirrored.add((r, c))
+        mirrored.add((height - 1 - r, c))
+    return mirrored
+
+
+def _mirror_vertical(cells, width):
