+    covering = [rect for rect in rectangles if rect["c0"] <= col <= rect["c1"]]
+    if not covering:
+        return BG
+    best = max(
+        covering,
+        key=lambda rect: (
+            rect["inner_area"],
+            rect["height"] * rect["width"],
+            rect["width"],
+            rect["height"],
+            -rect["r0"],
+            -rect["c0"],
