+                "color": color,
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "height": int(height),
+                "width": int(width),
+                "inner_area": int((height - 2) * (width - 2)),
+            }
+        )
+    rectangles.sort(key=lambda rect: (rect["r0"], rect["c0"], rect["color"]))
+    return rectangles
