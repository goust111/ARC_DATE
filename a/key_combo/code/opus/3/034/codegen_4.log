+def _extract_rectangles(grid: np.ndarray) -> list[dict]:
+    rectangles = []
+    for comp in find_components(
+        grid,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    ):
+        color = int(comp["color"])
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
