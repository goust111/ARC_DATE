+def _overlap_pairs(intervals: list[tuple[int, int]]) -> int:
+    pairs = 0
+    for idx, (a0, a1) in enumerate(intervals):
+        for b0, b1 in intervals[idx + 1 :]:
+            if max(a0, b0) <= min(a1, b1):
+                pairs += 1
+    return pairs
