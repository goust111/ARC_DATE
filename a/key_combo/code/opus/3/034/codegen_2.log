+        alignments[idx] = "col" if bend_counts[idx] % 2 == 1 else "row"
+
+    if "row" not in alignments:
+        idx = random.randrange(len(alignments))
+        alignments[idx] = "row"
+    if "col" not in alignments:
+        idx = random.randrange(len(alignments))
+        alignments[idx] = "col"
+
+    if not any(is_mismatch(b, a) for b, a in zip(bend_counts, alignments)):
