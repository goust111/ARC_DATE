+
+BACKGROUND = 0
+SOURCE_COLOR = 3
+RECOLOR_BY_BENDS = {1: 1, 2: 6, 3: 2}
+MARKER_COLORS = (4, 5, 7, 8, 9)
+
+GRID_ROWS_RANGE = (18, 25)
+GRID_COLS_RANGE = (18, 25)
