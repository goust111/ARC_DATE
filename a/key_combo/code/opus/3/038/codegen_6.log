  42:     assert divider_color != bg
  43:     expected_divider = np.zeros(g.shape, dtype=bool)
  44:     expected_divider[:, cc] = True
  45:     expected_divider[cr, cc] = False
  46:     assert np.array_equal(g == divider_color, expected_divider)
