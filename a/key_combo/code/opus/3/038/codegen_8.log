 177: def _gen_growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
 178:     adjacent = np.zeros_like(mask, dtype=bool)
 179:     adjacent[1:, :] |= mask[:-1, :]
 180:     adjacent[:-1, :] |= mask[1:, :]
 181:     adjacent[:, 1:] |= mask[:, :-1]
 182:     adjacent[:, :-1] |= mask[:, 1:]
 183:     adjacent[1:, 1:] |= mask[:-1, :-1]
 184:     adjacent[1:, :-1] |= mask[:-1, 1:]
 185:     adjacent[:-1, 1:] |= mask[1:, :-1]
 186:     adjacent[:-1, :-1] |= mask[1:, 1:]
 187: 
 188:     return [(int(r), int(c)) for r, c in np.argwhere(adjacent & ~mask)]
