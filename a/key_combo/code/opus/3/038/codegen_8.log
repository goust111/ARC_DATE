  15: def main(input_grid):
  16:     """
  17:     Fill the cup interior with yellow and emit yellow rays from its opening.
  18: 
  19:     Input structure:
  20:     - The grid contains one non-black cup shape on black background.
  21:     - The cup encloses black interior cells and has an opening on one side.
  22:     - The cup may be rotated to face any direction.
  23: 
  24:     Rule:
  25:     - Find the cup bounding box and the black cells inside it.
  26:     - Fill those interior cells yellow.
  27:     - Draw yellow straight out through the opening and diagonally from the opening endpoints until blocked.
  28: 
  29:     Key insight:
  30:     - The opening position relative to the cup center determines the outward direction of the fill.
  31:     """
  32:     # Plan:
  33:     # 1. Detect the cup
  34:     # 2. Find the mask of the inside of the cup
  35:     # 3. Find the mask of the opening of the cup (on one of its sides)
  36:     # 4. Fill the cup with yellow
  37:     # 5. Shoot pixels outward from the opening (straight out)
  38:     # 6. Shoot pixels outward from the opening (diagonally out, from the edges)
  39:     
  40:     # 1. Detect cup
  41:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  42:     assert len(objects) == 1, "There should be exactly one cup"
  43:     obj = list(objects)[0]
  44: 
  45:     output_grid = input_grid.copy()
  46: 
  47:     # 2. Extract what's inside the cup (as its own object), which is everything in the bounding box that is not the object itself
  48:     _b = bbox(obj != Color.BLACK)
  49:     assert _b is not None
  50:     cup_r, cup_c, _r1, _c1 = _b
  51:     cup_width = _r1 - cup_r + 1
  52:     cup_height = _c1 - cup_c + 1
  53:     inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
  54:     inside_cup_mask[cup_r:cup_r+cup_width, cup_c:cup_c+cup_height] = True
  55:     inside_cup_mask = inside_cup_mask & (obj == Color.BLACK)
  56: 
  57:     # 3. Extract the hole in the cup, which is what's inside and on the boundary of the bounding box
  58:     # what's inside...
  59:     hole_mask = inside_cup_mask.copy()
  60:     # ...and then we need to remove anything not on the boundary
  61:     hole_mask[cup_r+1 : cup_r+cup_width-1, cup_c+1 : cup_c+cup_height-1] = False
  62: 
  63:     # 4. Fill the cup with yellow
  64:     output_grid[inside_cup_mask] = Color.YELLOW
  65: 
  66:     # 5. Shoot pixels outward from the opening (straight out)
  67:     # Find the direction of the opening, which is the unit vector that points from the center of the cup to the hole
  68:     _b = bbox(hole_mask != Color.BLACK)
  69:     assert _b is not None
  70:     hole_r, hole_c = bbox_anchor(_b, anchor='center')
  71:     _b = bbox(obj != Color.BLACK)
  72:     assert _b is not None
  73:     cup_r, cup_c = bbox_anchor(_b, anchor='center')
  74:     direction = (int(np.sign(hole_r - cup_r)), int(np.sign(hole_c - cup_c)))
  75:     # Loop over every boundary pixel and shoot outward
  76:     for r, c in np.argwhere(hole_mask):
  77:         draw_line(output_grid, r, c, direction=direction, color=Color.YELLOW)
  78: 
  79:     # 6. Shoot pixels outward from the opening (diagonally out, from the edges)
  80:     # Find the two extremal points on the boundary of the hole, which are the points farthest away from each other
  81:     points_on_boundary = np.argwhere(hole_mask)
  82:     pt1, pt2 = max({ ( (x1,y1), (x2,y2) ) for x1,y1 in points_on_boundary for x2,y2 in points_on_boundary },
  83:                    key=lambda pair: np.linalg.norm(np.array(pair[0]) - np.array(pair[1])))
  84:     
  85:     # For each of those points, shoot diagonal lines in all directions, but stop as soon as you hit something that's not black
  86:     for pt in [pt1, pt2]:
  87:         for direction in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:
  88:             draw_line(output_grid, pt[0]+direction[0], pt[1]+direction[1], direction=direction, color=Color.YELLOW, stop_at=Color.NOT_BLACK)
  89:     
  90:     return output_grid
