 161: def _gen_ladder_mask(h: int, w: int) -> np.ndarray:
 162:     mask = np.zeros((h, w), dtype=bool)
 163:     start_c = random.choice([0, w - 1])
 164:     step = 1 if start_c == 0 else -1
 165:     moves = [step] * (w - 1) + [0] * (h - w)
 166:     random.shuffle(moves)
 167: 
 168:     c = start_c
 169:     mask[0, c] = True
 170:     for r, move in enumerate(moves, start=1):
 171:         c += move
 172:         mask[r, c] = True
 173: 
 174:     return mask
