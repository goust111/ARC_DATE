_LAYER_MIN_COUNT = 3
_LAYER_MAX_COUNT = 5
_LAYER_MAX_THICKNESS = 2
_COLOR_MIN, _COLOR_MAX = 1, 9
_COLOR_BALANCE_CANDIDATES = 4
_GEN_COLORS = list(range(_COLOR_MIN, _COLOR_MAX + 1))

