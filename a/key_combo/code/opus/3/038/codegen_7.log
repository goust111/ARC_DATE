+
+    for patch in patches:
+        if not _reserve_and_place(reserve, body, patch):
+            return None
+
+    grid[1:, :] = body
+    if not _input_is_valid(grid, pair_count, total_components, motif_len):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
