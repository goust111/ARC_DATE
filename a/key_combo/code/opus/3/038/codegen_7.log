# brute force search for outer connected shapes size 5-8 in small bboxes

def comps(cells):
    cells=set(cells)
    start=next(iter(cells))
    q=deque([start]); vis={start}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nb=(r+dr,c+dc)
            if nb in cells and nb not in vis:
