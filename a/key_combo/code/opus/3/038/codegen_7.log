+        colors=[Color.ORANGE],
+        connectivity=4,
+        monochromatic=True,
+    )
+    comps: list[dict[str, object]] = []
+    for comp in raw:
+        coords = comp["coords"].copy()
+        coords[:, 0] += 1
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        comps.append(
