    adjacent[1:, :] |= mask[:-1, :]
    adjacent[:-1, :] |= mask[1:, :]
    adjacent[:, 1:] |= mask[:, :-1]
    adjacent[:, :-1] |= mask[:, 1:]
    adjacent[1:, 1:] |= mask[:-1, :-1]
    adjacent[1:, :-1] |= mask[:-1, 1:]
    adjacent[:-1, 1:] |= mask[1:, :-1]
