+
+
+_MOTIF_COLOR_POOL = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.TEAL,
+    Color.MAROON,
+]
+_MAX_GENERATION_ATTEMPTS = 300
+
