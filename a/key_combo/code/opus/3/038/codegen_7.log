+    frontier = {(1, 0), (-1, 0), (0, 1), (0, -1)}
+    while len(cells) < size:
+        if not frontier:
+            return None
+        r, c = random.choice(tuple(frontier))
+        frontier.remove((r, c))
+        cells.add((r, c))
