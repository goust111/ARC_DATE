# Canvas and rectangle placement bounds.
_GRID_ROW_RANGE = (16, 20)
_GRID_COL_RANGE = (16, 19)
_RECT_SIZE_RANGE = (6, 13)
_RECT_COUNT_RANGE = (1, 3)
_MIN_RECT_GAP = 1

