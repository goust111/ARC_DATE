def _gen_bridge_mask(h: int, w: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    bridge_r = random.randrange(h)
    mask[bridge_r, :] = True

    c = random.randrange(w)
    for r in range(bridge_r - 1, -1, -1):
        c = min(w - 1, max(0, c + random.choice(_GEN_WALK_STEPS)))
