+    required = [chain_head]
+    if chain_mid != chain_head:
+        required.append(chain_mid)
+
+    first_patch = _make_object_patch(
+        object_colors,
+        required_colors=required,
+        force_multicolor=True,
+    )
+    if first_patch is None:
