    areas: list[int] = []
    h, w = int(rect_h), int(rect_w)
    for t in thicks:
        inner_h, inner_w = h - 2 * t, w - 2 * t
        areas.append(h * w - inner_h * inner_w)
        h, w = inner_h, inner_w
    areas.append(h * w)
