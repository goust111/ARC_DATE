+                if (rr, cc) in cell_set:
+                    continue
+                if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) != BG:
+                    return False
+    return True
+
+
+def _domino_candidates(grid: np.ndarray, patch_shape: tuple[int, int], used_top_rows: set[int]) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    ph, pw = map(int, patch_shape)
