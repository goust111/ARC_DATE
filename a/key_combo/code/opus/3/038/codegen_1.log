+    mask[start] = True
+    frontier = set(_neighbors4(mask.shape, *start))
+
+    while int(mask.sum()) < int(area):
+        frontier = {cell for cell in frontier if not mask[cell]}
+        if not frontier:
+            return None
+        cell = random.choice(tuple(frontier))
+        mask[cell] = True
+        frontier.update(_neighbors4(mask.shape, *cell))
