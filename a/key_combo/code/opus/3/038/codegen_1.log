+def _count_non_domino_changes(grid: np.ndarray, out: np.ndarray) -> tuple[int, int]:
+    _rules, domino_mask = _extract_domino_rules(grid)
+    changed = int(np.count_nonzero((grid != out) & (~domino_mask)))
+    multi_step = 0
