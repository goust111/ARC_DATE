+        for color in available_colors:
+            if len(chosen) >= n_colors:
+                break
+            if color not in chosen:
+                chosen.append(color)
+    chosen = chosen[:n_colors]
+    random.shuffle(chosen)
+
+    counts = [1] * len(chosen)
+    for idx, extra in enumerate(_composition(len(coords) - len(chosen), len(chosen))):
+        counts[idx] += extra
