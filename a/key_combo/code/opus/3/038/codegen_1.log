+    if force_multicolor:
+        min_colors = max(2, len(required))
+    else:
+        min_colors = max(1, len(required))
+    max_colors = min(4, len(available_colors), len(coords))
+    if max_colors < min_colors:
+        min_colors = max_colors
+    n_colors = random.randint(min_colors, max_colors)
