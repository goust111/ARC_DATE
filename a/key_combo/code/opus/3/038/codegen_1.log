    options = _gen_count_options(area)
    if not options:
        return None

    chosen = []
    for index in range(len(options[0])):
        values = sorted({opt[index] for opt in options})
        value = int(np.random.choice(values))
        chosen.append(value)
        options = [opt for opt in options if opt[index] == value]
    return tuple(chosen)


