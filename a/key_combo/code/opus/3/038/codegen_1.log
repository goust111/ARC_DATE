+    return int(r0), int(c0)
+
+
+def _is_isolated_placement(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    cell_set = set(cells)
+    h, w = grid.shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
