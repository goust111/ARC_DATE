 136: def _gen_pick_thicknesses(rect_h: int, rect_w: int, n_layers: int) -> list[int] | None:
 137:     """Choose legal ring thicknesses while reserving room for later layers."""
 138:     thicks: list[int] = []
 139:     h, w = int(rect_h), int(rect_w)
