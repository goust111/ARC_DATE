+    blue_totals = [int(info["blue_total"]) for info in infos]
+    spans = [int(info["span"]) for info in infos]
+    gap_order = tuple(np.argsort(gap_counts, kind="stable"))
+    if tuple(np.argsort(blue_totals, kind="stable")) == gap_order:
+        return False
