0013: def main(input_grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Compute the logical NOR of two maroon masks separated by a blue bar.
0016: 
0017:     Input structure:
0018:     - The input contains two same-sized maroon/black masks.
0019:     - A full-height blue vertical bar separates the masks.
0020:     - Maroon marks active cells and black marks inactive cells.
0021: 
0022:     Rule:
0023:     - Locate the blue separator column.
0024:     - Compare the left and right masks cell by cell.
0025:     - Output teal exactly where neither corresponding mask cell is maroon; output black elsewhere.
0026: 
0027:     Key insight:
0028:     - After the separator identifies the two aligned masks, the transformation is a pixelwise NOR.
0029:     """
0030:     # Find the blue vertical bar (a full column of BLUE).
0031:     H, W = input_grid.shape
0032:     c_bar = None
0033:     for c in range(W):
0034:         if np.all(input_grid[:, c] == Color.BLUE):
0035:             c_bar = c
0036:             break
0037:     assert c_bar is not None
0038: 
0039:     left_mask = input_grid[:, :c_bar]
0040:     right_mask = input_grid[:, c_bar + 1 :]
0041: 
0042:     output_grid = np.zeros_like(left_mask)
0043:     output_grid[(left_mask != Color.MAROON) & (right_mask != Color.MAROON)] = Color.TEAL
0044:     
0045:     return output_grid
0046: 
0047: 
