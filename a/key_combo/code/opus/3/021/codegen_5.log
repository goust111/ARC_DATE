+def _place_noise(reserved: np.ndarray, count: int) -> list[tuple[int, int]]:
+    H, W = reserved.shape
+    candidates = []
+    for r in range(H):
+        for c in range(W):
+            if reserved[r, c]:
+                continue
+            r0 = max(0, r - 1)
+            r1 = min(H, r + 2)
