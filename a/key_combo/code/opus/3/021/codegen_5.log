+    random.shuffle(same_one_dim)
+    random.shuffle(other)
+    for bucket in (same_area, same_one_dim, other):
+        for shape in bucket:
+            if shape in seen:
+                continue
+            shapes.append(shape)
+            seen.add(shape)
+            if len(shapes) == count:
+                return shapes
