+def _generate_pattern(h: int, w: int, colors: tuple[int, int], marker_side: str) -> np.ndarray:
+    axis = "horizontal" if marker_side in {"left", "right"} else "vertical"
+    total = h * w
+    linear = list(range(total))
+    for _ in range(400):
