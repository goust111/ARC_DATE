+def _detect_frames(grid: np.ndarray) -> list[dict]:
+    components = find_components(
+        grid,
+        bg=Color.BLACK,
+        connectivity=4,
+        monochromatic=False,
+        return_format="dict",
+    )
+    frames = []
+    for component in components:
+        frame = _frame_from_component(grid, component)
+        if frame is not None:
+            frames.append(frame)
+    return frames
