+
+def _available_positions(occupied: np.ndarray, h: int, w: int, padding: int = 1) -> list[tuple[int, int]]:
+    H, W = occupied.shape
+    positions = []
+    for r0 in range(H - h + 1):
+        r_lo = max(0, r0 - padding)
+        r_hi = min(H, r0 + h + padding)
+        for c0 in range(W - w + 1):
