+
+def _three_pair_template(h: int, w: int, colors: list[int]) -> list[dict] | None:
+    row_span = random.randint(12, h - 2)
+    col_span = random.randint(12, w - 2)
+    r0 = random.randint(1, h - row_span - 1)
+    c0 = random.randint(1, w - col_span - 1)
