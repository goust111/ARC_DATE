+
+    row_gaps = _sample_gaps(row_span, 5, 2)
+    col_gaps = _sample_gaps(col_span, 5, 2)
+
+    r1 = r0 + row_gaps[0]
+    r2 = r1 + row_gaps[1]
+    r3 = r2 + row_gaps[2]
+    r4 = r3 + row_gaps[3]
+
+    c1 = c0 + col_gaps[0]
+    c2 = c1 + col_gaps[1]
+    c3 = c2 + col_gaps[2]
+    c4 = c3 + col_gaps[3]
+
+    rects = [
+        (r0, r5, c0, c5),
+        (r1, r4, c2, c3),
+        (r2, r3, c1, c4),
+    ]
+    pairs = _orient_pairs(rects, colors[:3])
+    if pairs is None or not _pair_areas_distinct(pairs):
+        return None
+    return pairs
+
+
