+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+MIN_HALF_SIZE = 9
+MAX_HALF_SIZE = 13
+MIN_RED_COUNT = 8
+MAX_RED_COUNT = 15
