+    canvas: np.ndarray, seed: tuple[int, int]
+) -> dict[str, object]:
+    h, w = canvas.shape
+    r, c = map(int, seed)
+    dirs = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+    leg_len = 2
+    dir_idx = 0
+    max_attempts = 20 * h * w
+
