+            dr, dc = dirs[dir_idx]
+            for _step in range(leg_len):
+                max_attempts -= 1
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(canvas.shape, nr, nc):
+                    oob_count += 1
+                    continue
+
+                value = int(canvas[nr, nc])
+                if value == BLACK:
+                    canvas[nr, nc] = GREEN
+                    r, c = nr, nc
+                    path_cells.append((r, c))
+                    continue
+
+                return {
