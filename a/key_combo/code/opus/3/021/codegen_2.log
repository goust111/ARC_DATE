+) -> dict[str, object]:
+    h, w = canvas.shape
+    r, c = map(int, seed)
+    dirs = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+    leg_len = 2
+    dir_idx = 0
+    max_attempts = 20 * h * w
+
+    path_cells: list[tuple[int, int]] = []
+    oob_count = 0
+
+    while max_attempts > 0:
+        for _ in range(2):
+            dr, dc = dirs[dir_idx]
+            for _step in range(leg_len):
+                max_attempts -= 1
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(canvas.shape, nr, nc):
+                    oob_count += 1
+                    continue
+
+                value = int(canvas[nr, nc])
+                if value == BLACK:
+                    canvas[nr, nc] = GREEN
+                    r, c = nr, nc
+                    path_cells.append((r, c))
+                    continue
+
+                return {
+                    "path_cells": path_cells,
+                    "stopper": (int(nr), int(nc)),
+                    "stop_value": value,
+                    "oob_count": oob_count,
+                }
+            dir_idx = (dir_idx + 1) % 4
+        leg_len += 2
+
+    raise AssertionError("spiral did not reach a blocker within the safety bound")
+
+
