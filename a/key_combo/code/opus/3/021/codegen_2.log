+    metadata: dict[str, object] = {
+        "n": n,
+        "mode": mode,
+        "seed": seed,
+        "path_cells": path_cells,
+        "stopper": stopper,
+        "oob_before_stop": oob_before_stop,
+        "left_reds": left_reds,
+        "right_reds": right_reds,
+    }
+    return grid, metadata
+
