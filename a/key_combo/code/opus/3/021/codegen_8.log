+    return _all_shift_outputs_differ(mask, shift)
+
+
+@lru_cache(maxsize=None)
+def _candidate_masks(n: int, shift: int) -> tuple[np.ndarray, ...]:
+    candidates: list[np.ndarray] = []
+    seen: set[bytes] = set()
+
