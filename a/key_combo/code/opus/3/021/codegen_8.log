+    out = np.full((n + 2, n + 2), BLACK, dtype=int)
+    out[0, 1:-1] = GREEN
+    out[-1, 1:-1] = BLUE
+    out[1:-1, 0] = YELLOW
+    out[1:-1, -1] = ORANGE
+    out[1:-1, 1:-1] = recolored
+    return out
+
+
+def _classification_counts(mask: np.ndarray) -> dict[str, int]:
+    n = int(mask.shape[0])
+    counts = {side: 0 for side in SIDE_ORDER}
+    counts["tie"] = 0
+    for r, c in np.argwhere(mask):
