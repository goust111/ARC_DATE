            mirror_r = mx
        if mirror_c is None and my is not None:
            if used_my == "mirror_y":
                warnings.warn("MirrorSymmetry: 'mirror_y' is deprecated; use 'mirror_c'", DeprecationWarning, stacklevel=2)
            mirror_c = my
