+
+
+def bbox_w(bbox: tuple[int, int, int, int]) -> int:
+    _r0, c0, _r1, c1 = bbox
+    return int(c1 - c0 + 1)
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert connectivity in (4, 8)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
