+
+
+def _reflect_coords_across_frame(
+    coords: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    side: str,
+) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
