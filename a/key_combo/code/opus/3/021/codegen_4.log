        if not seed_far(seed, min(gray_cells, key=lambda cell: abs(cell[0]-seed[0])+abs(cell[1]-seed[1]))):
            continue
        actual = trace_actual(grid)
        if actual['"'stop'] "'!= stop_kind:
            continue
        if stop_kind == '"'gray':
            expected_blocker = plan['free']['path'][plan['blocker_index']]
            if actual['stop_cell'] "'!= expected_blocker:
                continue
            if actual['"'path'] "'!= plan['"'free']['path'][: plan['blocker_index']]:
                continue
            stop_index = plan['blocker_index']
        else:
            if actual['path'] "'!= plan['"'free']['path']:
                continue
            stop_index = len(actual['path'])
        if not profile_matches(actual['reflections'], stop_index, profile):
            continue
        return grid
    raise RuntimeError('failed')

for i in range(50):
    g = generate_input()
    print(i, g.shape, np.count_nonzero(g==GRAY), np.count_nonzero(g==GREEN))
