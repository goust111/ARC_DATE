            return {'path': path, 'reflections': reflections, 'stop': 'boundary', 'stop_cell': None}
        hit_row = nr in er
        hit_col = nc in ec
        if hit_row or hit_col:
            reflections.append({'row': hit_row, 'col': hit_col, 'index_before': len(path)})
            if hit_row:
                dr = -dr
            if hit_col:
                dc = -dc
            continue
        cell = int(grid[nr, nc])
        if cell == GRAY:
            return {'path': path, 'reflections': reflections, 'stop': 'gray', 'stop_cell': (nr, nc)}
        if cell "'!= BLACK:
            raise AssertionError(cell)
        if (nr, nc) in seen_cells:
            raise AssertionError('"'self-cross')
        seen_cells.add((nr, nc))
        path.append((nr, nc))
        r, c = nr, nc


def generate_input():
    scenarios = [
        ('gray', 'row'),
        ('gray', 'col'),
        ('gray', 'both'),
        ('gray', 'mixed'),
        ('boundary', 'row'),
        ('boundary', 'col'),
        ('boundary', 'mixed'),
    ]
    for _ in range(GEN_ATTEMPTS):
        H = random.randint(11, 15)
        W = random.randint(11, 15)
        empty_rows = set(random.sample(range(1, H - 1), random.randint(2, 3)))
        empty_cols = set(random.sample(range(1, W - 1), random.randint(2, 3)))
        stop_kind, profile = random.choice(scenarios)
        plan = find_path_plan(H, W, empty_rows, empty_cols, profile, stop_kind)
        if plan is None:
            continue
        seed = plan['seed']
