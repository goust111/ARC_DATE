import random
import numpy as np

BLACK = 0
RED = 2
GREEN = 3
GRAY = 5
GEN_ATTEMPTS = 800


def in_bounds(shape, r, c):
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def event_kind(ev):
    if ev['row'] and ev['col']:
        return 'both'
    if ev['row']:
        return 'row'
    return 'col'


def profile_matches(reflections, stop_index, mode):
    kinds = [event_kind(ev) for ev in reflections if ev['index_before'] <= stop_index]
    if not kinds:
        return False
    unique = set(kinds)
    if mode == 'row':
        return unique == {'row'}
    if mode == 'col':
        return unique == {'col'}
    if mode == 'both':
        return unique == {'both'}
    if mode == 'mixed':
        return unique == {'row', 'col'}
    raise ValueError(mode)


def seed_far(seed, cell):
    return abs(seed[0] - cell[0]) + abs(seed[1] - cell[1]) >= 3


def trace_free(shape, seed, empty_rows, empty_cols):
    r, c = seed
    dr = dc = 1
    path = []
    reflections = []
    seen_states = set()
    seen_cells = {seed}
    while True:
        state = (r, c, dr, dc)
        if state in seen_states:
            return None
        seen_states.add(state)
        nr, nc = r + dr, c + dc
        if not in_bounds(shape, nr, nc):
            return {'path': path, 'reflections': reflections, 'stop': 'boundary'}
        hit_row = nr in empty_rows
        hit_col = nc in empty_cols
        if hit_row or hit_col:
            reflections.append({'row': hit_row, 'col': hit_col, 'index_before': len(path), 'from': (r, c), 'next': (nr, nc)})
            if hit_row:
                dr = -dr
            if hit_col:
                dc = -dc
            continue
        if (nr, nc) in seen_cells:
            return None
        seen_cells.add((nr, nc))
        path.append((nr, nc))
        r, c = nr, nc


def find_path_plan(H, W, empty_rows, empty_cols, profile, stop_kind):
    seeds = [(r, c) for r in range(H) for c in range(W) if r not in empty_rows and c not in empty_cols]
    random.shuffle(seeds)
    plans = []
    for seed in seeds:
        free = trace_free((H, W), seed, empty_rows, empty_cols)
        if free is None:
            continue
        path = free['path']
        refl = free['reflections']
        if len(path) < 3 or not refl:
            continue
        if stop_kind == 'gray':
            for k, blocker in enumerate(path):
                if k < 2 or not seed_far(seed, blocker):
                    continue
                if profile_matches(refl, k, profile):
                    plans.append({'seed': seed, 'stop': 'gray', 'blocker_index': k, 'free': free})
        else:
            if len(path) >= 4 and profile_matches(refl, len(path), profile):
                plans.append({'seed': seed, 'stop': 'boundary', 'blocker_index': None, 'free': free})
    return random.choice(plans) if plans else None


def build_gray_cells(H, W, empty_rows, empty_cols, seed, stop_kind, free, blocker_index):
    free_path = free['path']
    if stop_kind == 'gray':
        blocker = free_path[blocker_index]
        reserved_black = set(free_path[:blocker_index])
    else:
        blocker = None
        reserved_black = set(free_path)
    reserved_black.add(seed)

    def allowed(cell):
        r, c = cell
        if r in empty_rows or c in empty_cols:
            return False
        if cell in reserved_black:
            return False
        if not seed_far(seed, cell):
            return False
        return True

    gray_cells = set()
    if blocker is not None:
        gray_cells.add(blocker)
    covered_rows = {r for r, _ in gray_cells}
    covered_cols = {c for _, c in gray_cells}
    req_rows = {r for r in range(H) if r not in empty_rows and r "'!= seed[0]}
    req_cols = {c for c in range(W) if c not in empty_cols and c != seed[1]}

    universe = [(r, c) for r in range(H) for c in range(W) if allowed((r, c))]
    if blocker is not None and not allowed(blocker):
        # blocker can sit on the future path, but still must satisfy the seed-distance rule.
        if blocker in reserved_black or blocker[0] in empty_rows or blocker[1] in empty_cols or not seed_far(seed, blocker):
            return None
        universe.append(blocker)

    occupied = set(gray_cells)
    while not req_rows <= covered_rows or not req_cols <= covered_cols:
        best = []
        best_gain = 0
        for cell in universe:
            if cell in occupied:
                continue
            r, c = cell
            gain = int(r in req_rows and r not in covered_rows) + int(c in req_cols and c not in covered_cols)
            if gain > best_gain:
                best_gain = gain
                best = [cell]
            elif gain == best_gain and gain > 0:
                best.append(cell)
        if best_gain == 0:
            return None
        cell = random.choice(best)
        gray_cells.add(cell)
        occupied.add(cell)
        covered_rows.add(cell[0])
        covered_cols.add(cell[1])
        if len(gray_cells) > 20:
            return None

    extras = [cell for cell in universe if cell not in occupied]
    min_total = max(10, len(gray_cells))
    max_total = min(20, len(gray_cells) + len(extras))
    if min_total > max_total:
        return None
    target_total = random.randint(min_total, max_total)
    random.shuffle(extras)
    gray_cells.update(extras[: target_total - len(gray_cells)])
    return gray_cells


def empty_lines(grid):
    H, W = grid.shape
    er = {r for r in range(H) if np.all(grid[r] == BLACK)}
    ec = {c for c in range(W) if np.all(grid[:, c] == BLACK)}
    return er, ec


