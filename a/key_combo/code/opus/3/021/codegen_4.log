+        best_cells: list[tuple[int, int]] = []
+        for cell in universe:
+            if cell in occupied:
+                continue
+            r, c = cell
+            gain = int(r in rows_needed and r not in covered_rows) + int(c in cols_needed and c not in covered_cols)
