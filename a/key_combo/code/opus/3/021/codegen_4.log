+    out = g.copy()
+    empty_rows, empty_cols = _empty_lines(g)
+    for r in empty_rows:
+        out[int(r), :] = RED
+    for c in empty_cols:
+        out[:, int(c)] = RED
+
+    trace = _trace_input(g)
+    for r, c in trace["path"]:
+        out[int(r), int(c)] = GREEN
