+
+BLACK = 0
+RED = 2
+GREEN = 3
+GRAY = 5
+
+GEN_ATTEMPTS = 800
+GEN_SCENARIOS = [
+    ("gray", "row"),
+    ("gray", "col"),
+    ("gray", "both"),
