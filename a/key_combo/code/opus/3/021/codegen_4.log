/bin/bash -lc "python - <<'PY'
import random
import numpy as np
from collections import Counter

BLACK = 0
RED = 2
GREEN = 3
GRAY = 5
GEN_ATTEMPTS = 800


def in_bounds(shape, r, c):
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def event_kind(ev):
    if ev['row'] and ev['col']:
        return 'both'
    if ev['row']:
        return 'row'
    return 'col'


def profile_of(reflections, stop_index):
    kinds = [event_kind(ev) for ev in reflections if ev['index_before'] <= stop_index]
    if set(kinds) == {'row'}:
        return 'row'
    if set(kinds) == {'col'}:
        return 'col'
    if set(kinds) == {'both'}:
        return 'both'
    if set(kinds) == {'row', 'col'}:
        return 'mixed'
    return 'other'


def profile_matches(reflections, stop_index, mode):
    return profile_of(reflections, stop_index) == mode


def seed_far(seed, cell):
    return abs(seed[0] - cell[0]) + abs(seed[1] - cell[1]) >= 3


def trace_free(shape, seed, empty_rows, empty_cols):
    r, c = seed
    dr = dc = 1
    path = []
    reflections = []
    seen_states = set()
    seen_cells = {seed}
    while True:
        state = (r, c, dr, dc)
        if state in seen_states:
            return None
        seen_states.add(state)
        nr, nc = r + dr, c + dc
        if not in_bounds(shape, nr, nc):
            return {'path': path, 'reflections': reflections, 'stop': 'boundary'}
        hit_row = nr in empty_rows
        hit_col = nc in empty_cols
        if hit_row or hit_col:
            reflections.append({'row': hit_row, 'col': hit_col, 'index_before': len(path)})
            if hit_row:
                dr = -dr
            if hit_col:
                dc = -dc
            continue
        if (nr, nc) in seen_cells:
            return None
        seen_cells.add((nr, nc))
        path.append((nr, nc))
        r, c = nr, nc


def find_path_plan(H, W, empty_rows, empty_cols, profile, stop_kind):
    seeds = [(r, c) for r in range(H) for c in range(W) if r not in empty_rows and c not in empty_cols]
    random.shuffle(seeds)
    plans = []
    for seed in seeds:
        free = trace_free((H, W), seed, empty_rows, empty_cols)
        if free is None:
            continue
        path = free['path']
        refl = free['reflections']
        if len(path) < 3 or not refl:
            continue
        if stop_kind == 'gray':
            for k, blocker in enumerate(path):
                if k < 2 or not seed_far(seed, blocker):
                    continue
                if profile_matches(refl, k, profile):
                    plans.append({'seed': seed, 'stop': 'gray', 'blocker_index': k, 'free': free})
        else:
            if len(path) >= 4 and profile_matches(refl, len(path), profile):
                plans.append({'seed': seed, 'stop': 'boundary', 'blocker_index': None, 'free': free})
    return random.choice(plans) if plans else None


