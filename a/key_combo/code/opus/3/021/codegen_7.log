+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[list[Coord]] = []
+    for r, c in np.argwhere(g == int(color)):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
