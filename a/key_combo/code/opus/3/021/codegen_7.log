+    r0, c0, _r1, _c1 = bbox_coords(pts)
+    return sorted((int(r - r0), int(c - c0)) for r, c in pts)
+
+
+def shift_coords(coords: Iterable[Coord], dr: int, dc: int) -> list[Coord]:
