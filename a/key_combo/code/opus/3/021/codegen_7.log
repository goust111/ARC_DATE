+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        comp: list[Coord] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((int(cr), int(cc)))
+            for nr, nc in neighbors4(cr, cc):
+                if not in_bounds(g.shape, nr, nc):
