def _gen_fill_missing_edges(mask: np.ndarray, n: int) -> None:
    """Mutate mask until at least one selected cell touches each frame side."""
    missing_edges = set(GEN_REQUIRED_EDGES)
    for r, c in np.argwhere(mask):
