+        if tuple(vec) != tuple(guide["vector"]):
+            return False
+        tl_guess = (
+            int(guide["partial_bbox"][0] - case["center_bbox_abs"][0]),
+            int(guide["partial_bbox"][1] - case["center_bbox_abs"][1]),
