    return mask


def _gen_frame_patch(n: int, side_colors: tuple[int, int, int, int]) -> np.ndarray:
    top_color, left_color, bottom_color, right_color = side_colors
    frame = np.full((n + 2, n + 2), GEN_BACKGROUND, dtype=int)
