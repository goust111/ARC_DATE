+
+def bbox_intersection(a: BBox, b: BBox) -> BBox | None:
+    r0 = max(int(a[0]), int(b[0]))
+    c0 = max(int(a[1]), int(b[1]))
+    r1 = min(int(a[2]), int(b[2]))
+    c1 = min(int(a[3]), int(b[3]))
+    if r0 > r1 or c0 > c1:
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
