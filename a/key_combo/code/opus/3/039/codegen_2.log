+DEPTH_TO_COLOR = {
+    1: Color.BLUE,
+    2: Color.RED,
+    3: Color.GREEN,
+}
+
+GEN_RETRIES = 300
+MANDATORY_DEPTHS = (1, 2, 3)
+EXTRA_DEPTH_CHOICES = (1, 1, 2)
