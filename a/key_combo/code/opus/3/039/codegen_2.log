+    mask = SPRITE_TEMPLATES[rng.randrange(len(SPRITE_TEMPLATES))].copy()
+    mask = np.rot90(mask, k=rng.randrange(4))
+    if rng.random() < 0.5:
+        mask = np.flipud(mask)
+    if rng.random() < 0.5:
