+def _sprite_depth(component: np.ndarray, frames: list[tuple[int, int, int, int]]) -> int:
+    r0, c0, r1, c1 = bbox_coords(component)
+    return sum(fr0 < r0 and r1 < fr1 and fc0 < c0 and c1 < fc1 for fr0, fc0, fr1, fc1 in frames)
