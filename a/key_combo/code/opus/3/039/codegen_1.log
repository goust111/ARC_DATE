    for (br, bc), defect_count in grey_counts.items():
        if defect_count == 0:
            continue
        r0, c0 = br * BLOCK_SIZE, bc * BLOCK_SIZE
        for cell in random.sample(range(BLOCK_SIZE * BLOCK_SIZE), defect_count):
            inp[r0 + cell // BLOCK_SIZE, c0 + cell % BLOCK_SIZE] = GREY_COLOR

