+def _pick_by_topleft(objects: list[dict]) -> np.ndarray:
+    return min(objects, key=lambda obj: (obj["bbox"][0], obj["bbox"][1], obj["patch"].shape[0] * obj["patch"].shape[1]))["patch"]
+
