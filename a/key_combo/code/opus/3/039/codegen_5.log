+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SEP = 5
+FILL_COLORS = (1, 2, 3, 4, 7)
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+PANEL_H_RANGE = (8, 11)
+WIDTH_RANGE = (10, 15)
+RECT_SIDE_RANGE = (3, 5)
+OBJECT_COUNT_CHOICES = (2, 2, 3)
