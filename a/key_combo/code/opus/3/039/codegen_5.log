+        max_count = int(counts.max())
+        if int(np.count_nonzero(counts == max_count)) != 1:
+            continue
+        if int(vals[int(np.argmax(counts))]) != fill:
+            continue
+        if _score_patch(patch)[1] != marker_count:
+            continue
+        return patch
+    raise RuntimeError("failed to build a valid patch")
