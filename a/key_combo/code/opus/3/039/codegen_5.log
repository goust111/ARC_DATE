+    winner_idx = next(idx for idx, obj in enumerate(objects) if obj["patch"] is winner_patch)
+    return objects, winner_idx
+
+
+def _render_grid(
+    panel_h: int,
+    width: int,
+    top_objects: list[dict],
+    bottom_objects: list[dict],
+) -> np.ndarray:
