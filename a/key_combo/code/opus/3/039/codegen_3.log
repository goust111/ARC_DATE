    patch = _make_sprite(color, orientation, direction)
    view = grid[top : top + patch.shape[0], left : left + patch.shape[1]]
    mask = patch != TRANSPARENT
    if view.shape != patch.shape or np.any(view[mask] != BACKGROUND_COLOR):
