ORIENTATIONS, DIRECTIONS = ("H", "V"), {"H": ("left", "right"), "V": ("up", "down")}
BAR_LENGTH, CROSSBAR_LENGTH = 4, 3
CROSSBAR_MID, NEAR_END_OFFSET, FAR_END_OFFSET = 1, 1, 2
TRANSPARENT = -1

