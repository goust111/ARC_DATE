def _gen_attempt() -> np.ndarray | None:
    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
    grid[0, :] = grid[-1, :] = grid[:, 0] = grid[:, -1] = FRAME_COLOR
    colors, orientations, axes_by_orientation, order = _sample_plan()
