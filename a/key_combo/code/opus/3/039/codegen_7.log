+def _palindromic_column_from_count(n_rows: int, count: int, rng: np.random.Generator) -> np.ndarray:
+    half = n_rows // 2
+    col = np.zeros(n_rows, dtype=bool)
+    pair_count = count // 2
+    if pair_count:
+        chosen = rng.choice(half, size=pair_count, replace=False)
+        col[chosen] = True
+        col[n_rows - 1 - chosen] = True
+    if count % 2 == 1:
+        col[half] = True
+    return col
+
