  10: def main(grid: np.ndarray) -> np.ndarray:
  11:     """
  12:     Summarize each 3x3 input block as one output pixel, ignoring grey marks.
  13:     Input structure
  14:     - The grid dimensions are multiples of 3, forming a lattice of 3x3 blocks.
  15:     - Background is the dominant color, and grey pixels are marker/noise cells.
  16:     - Each real block contains one non-background, non-grey color in at least
  17:       eight of its nine cells.
  18:     Rule
  19:     - Replace each 3x3 block by background if it contains only background and grey.
  20:     - Otherwise replace it by the unique non-background, non-grey color in that block.
  21:     Key insight
  22:     - The large grid is an enlarged low-resolution picture; grey cells are defects
  23:       within or between blocks and should not become output colors.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     bg = get_bg(g)
  27:     h, w = g.shape
  28:     assert h % BLOCK == 0 and w % BLOCK == 0, "grid must split into 3x3 blocks"
  29: 
  30:     out = np.full((h // BLOCK, w // BLOCK), bg, dtype=int)
  31:     ignored = {bg, Color.GREY}
  32: 
  33:     for br in range(h // BLOCK):
  34:         for bc in range(w // BLOCK):
  35:             r0 = br * BLOCK
  36:             c0 = bc * BLOCK
  37:             block = g[r0 : r0 + BLOCK, c0 : c0 + BLOCK]
  38:             colors = [int(c) for c in np.unique(block) if int(c) not in ignored]
  39:             assert len(colors) <= 1, "each block has at most one real color"
  40: 
  41:             if colors:
  42:                 color = colors[0]
  43:                 assert np.count_nonzero(block == color) >= 8, "real blocks are full except grey damage"
  44:                 assert np.all((block == color) | (block == Color.GREY)), "real block damage must be grey"
  45:                 out[br, bc] = color
  46:             else:
  47:                 assert np.all((block == bg) | (block == Color.GREY)), "empty blocks contain only bg/grey"
  48: 
  49:     return out
  50: 
