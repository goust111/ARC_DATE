+def _orient_grid(grid: np.ndarray, edge: str) -> np.ndarray:
+    if edge == "top":
+        return grid.copy()
+    if edge == "bottom":
+        return np.flipud(grid).copy()
+    if edge == "left":
+        return grid.T.copy()
+    if edge == "right":
+        return np.fliplr(grid.T).copy()
+    raise ValueError(f"unknown edge: {edge}")
+
