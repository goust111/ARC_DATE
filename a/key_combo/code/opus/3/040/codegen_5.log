+from __future__ import annotations
+
+import heapq
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 8
+GREEN = 3
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L
+OBSTACLE_COLORS = (1, 2, 4, 5, 6, 7, 9)
