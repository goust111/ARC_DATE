+        r0, c0, r1, c1 = _bbox(coords)
+        rel = coords - np.array([r0, c0], dtype=int)
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BLACK, dtype=int)
+        patch[rel[:, 0], rel[:, 1]] = values
+        objects.append(
