        grid = np.concatenate(panels, axis=1)

        if not _valid_rendered_input(grid, fill, marker, frames):
            continue
        out = main(grid)
        if out.shape != (3, 3):
            continue
        return grid

    raise RuntimeError("failed to generate a valid input for puzzle 2")

