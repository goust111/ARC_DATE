    if not all(np.array_equal(a, b) for a, b in zip(recompressed, frames)):
        return False
    panels = [grid[:, idx * panel_w : (idx + 1) * panel_w] for idx in range(3)]
    if any(np.array_equal(panels[i], panels[j]) for i in range(3) for j in range(i + 1, 3)):
        return False
    return True


