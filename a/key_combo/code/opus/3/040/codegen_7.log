def center(start, size):
    return start + (size - 1) // 2

def spans(sizes):
    out=[]
    cur=0
    for i,s in enumerate(sizes):
        out.append((cur, cur+s))
        cur += s
        if i "'!= len(sizes)-1:
            cur += 1
