from itertools import product

def center(start, size):
    return start + (size - 1) // 2

def spans(sizes):
    out=[]
    cur=0
    for i,s in enumerate(sizes):
        out.append((cur, cur+s))
        cur += s
        if i "'!= len(sizes)-1:
            cur += 1
    return out

def analyze(row_sizes, col_sizes, hub):
    n=4
    rs=spans(row_sizes)
    cs=spans(col_sizes)
    hr,hc=hub
    hub_r=center(rs[hr][0], row_sizes[hr])
    hub_c=center(cs[hc][0], col_sizes[hc])
    divider_rows={r1 for _,r1 in rs[:-1]}
    divider_cols={c1 for _,c1 in cs[:-1]}
    orient=[]
    overlaps=[]
    claims={}
    for r in range(n):
        for c in range(n):
            if (r,c)==hub:
                continue
            cr=center(rs[r][0], row_sizes[r])
            cc=center(cs[c][0], col_sizes[c])
            dr=abs(cr-hub_r)
            dc=abs(cc-hub_c)
            cells=[]
