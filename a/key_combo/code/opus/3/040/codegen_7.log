                kind='"'V' if dr else 'ZV'
                step=1 if hub_r>cr else -1
                for rr in range(cr, hub_r, step):
                    if rr not in divider_rows:
                        cells.append((rr, cc))
            else:
                kind='H' if dc else 'ZH'
                step=1 if hub_c>cc else -1
                for xx in range(cc, hub_c, step):
                    if xx not in divider_cols:
                        cells.append((cr, xx))
            orient.append(((r,c), kind, dr, dc, tuple(cells)))
            for cell in cells:
                if cell in claims:
                    overlaps.append((cell, claims[cell], (r,c)))
                claims[cell]=(r,c)
    return orient, overlaps

for row_sizes in product(range(3,7), repeat=4):
    for col_sizes in product(range(3,7), repeat=4):
        for hub in [(1,1),(1,2),(2,1),(2,2)]:
