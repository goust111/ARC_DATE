+            return None
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if not np.any((grid == FRAME) & (out == BG)):
+        return None
+    if not np.any((grid == BG) & (out != BG)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
