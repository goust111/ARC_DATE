+def _match_anchor(body_box: BBox, direction: Direction, stem_len: int, anchors: list[dict]) -> tuple[dict, int]:
+    r0, c0, r1, c1 = body_box
+    body_h, body_w = _bbox_h(body_box), _bbox_w(body_box)
+    dr, dc = direction
+    candidates: list[tuple[int, dict]] = []
