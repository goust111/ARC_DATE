+    movers = [comp for comp in comps if not _component_is_solid_rectangle(comp)]
+    assert anchors and movers and len(anchors) == len(movers), "expected paired anchors and movers"
+
+    out = g.copy()
+    for mover in movers:
+        coords = mover["coords"]
+        out[coords[:, 0], coords[:, 1]] = bg
