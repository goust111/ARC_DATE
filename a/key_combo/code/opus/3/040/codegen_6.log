+
+
+def _choose_directions(pair_count: int) -> list[str]:
+    if pair_count == 2 and random.random() < 0.7:
+        dirs = [random.choice(("left", "right")), random.choice(("up", "down"))]
+        random.shuffle(dirs)
+        return dirs
+    return random.sample(DIRS, k=pair_count)
+
+
+def _build_pair_layout(
+    top: int,
+    left: int,
+    h: int,
+    w: int,
+    direction_name: str,
+    stem_len: int,
+    gap: int,
+    anchor_color: int,
