+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": (
+                        int(arr[:, 0].min()),
+                        int(arr[:, 1].min()),
+                        int(arr[:, 0].max()),
+                        int(arr[:, 1].max()),
+                    ),
+                    "area": int(arr.shape[0]),
