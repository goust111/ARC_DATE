)


def neighbors4(r, c):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def components_of_color(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or grid[r, c] "'!= color:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            arr = np.array(coords, dtype=int)
            comps.append({
                '"'color': int(color),
                'coords': arr,
                'bbox': (int(arr[:,0].min()), int(arr[:,1].min()), int(arr[:,0].max()), int(arr[:,1].max())),
                'area': int(arr.shape[0]),
            })
    return comps


def find_observer(grid):
    comps = components_of_color(grid, OBSERVER)
    assert len(comps) == 1
    comp = comps[0]
    assert comp['area'] == 4
    assert comp['bbox'][2] - comp['bbox'][0] == 1 and comp['bbox'][3] - comp['bbox'][1] == 1
    return [tuple(map(int, rc)) for rc in comp['coords']], comp['bbox']


def ray_clear(grid, a, b):
    ar, ac = a
    br, bc = b
    if ar == br:
        lo, hi = sorted((ac, bc))
        return bool(np.all(grid[ar, lo + 1:hi] == BACKGROUND))
    if ac == bc:
        lo, hi = sorted((ar, br))
        return bool(np.all(grid[lo + 1:hi, ac] == BACKGROUND))
    return False


def is_visible(grid, observer_cells, comp):
    coords = [tuple(map(int, rc)) for rc in comp['coords']]
    return any(ray_clear(grid, o, p) for o in observer_cells for p in coords)


def visible_summary(grid):
    observer_cells, _ = find_observer(grid)
    colors = [c for c in np.unique(grid) if c not in (BACKGROUND, OBSERVER)]
    visible = []
