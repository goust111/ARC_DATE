+    has_left_direction = any(any(_horizontal_step(col, width) == -1 for col in cols) for cols in by_cat.values())
+    must_left_cat = None
+    if not has_left_direction and single_cats:
+        must_left_cat = single_cats[int(rng.integers(len(single_cats)))]
