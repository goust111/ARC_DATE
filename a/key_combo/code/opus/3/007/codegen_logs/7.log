+        target_row = divider_row - 1 if r < divider_row else divider_row + 1
+        path_color = TEAL
+    else:
+        vertical_step = -1 if r < divider_row else 1
+        target_row = 0 if r < divider_row else height - 1
+        path_color = YELLOW
