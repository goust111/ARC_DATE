+    if not any(len(actual) < len(free) for actual, free in zip(actual_paths, free_paths)):
+        return False
+
+    directions = {_horizontal_step(marker["c"], grid.shape[1]) for marker in markers}
+    if directions != {-1, 1}:
+        return False
