+
+    reversed_order, _ = _simulate(grid, reverse=True)
+    if np.array_equal(out_sim, reversed_order):
+        return False
+
+    swapped_mapping, _ = _simulate(grid, swapped=True)
+    if np.array_equal(out_sim, swapped_mapping):
