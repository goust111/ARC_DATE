+            preferred.append(secondary)
+        candidates = [cat for cat in preferred if counts[cat] < 3]
+        if not candidates:
+            candidates = [cat for cat in CATEGORIES if counts[cat] < 3]
+        chosen = candidates[int(rng.integers(len(candidates)))]
+        counts[chosen] += 1
+        extras -= 1
