    r0 = int(r0)
    c0 = int(c0)
    h, w = map(int, patch.shape)

    if not clip:
        if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
            raise ValueError("paste: patch out of bounds (set clip=True to allow clipping)")
        rr0, cc0 = r0, c0
        rr1, cc1 = r0 + h, c0 + w
        pr0, pc0 = 0, 0

