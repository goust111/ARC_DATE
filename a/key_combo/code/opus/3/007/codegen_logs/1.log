+                c += dc
+            ray_meta.append(
+                {
+                    "source_kind": source_kind,
+                    "piece_kind": piece["kind"],
+                    "piece_anchor": (int(piece["r0"]), int(piece["c0"])),
+                    "direction": (int(dr), int(dc)),
+                    "cells": tuple(painted_cells),
+                    "colors": tuple(painted_colors),
