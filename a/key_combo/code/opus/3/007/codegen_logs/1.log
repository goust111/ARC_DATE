+
+
+def _candidate_miss_segment(
+    shape: tuple[int, int],
+    route_cells: set[tuple[int, int]],
+    blocked_for_obstacles: set[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    h, w = shape
+    candidates = []
