+                "r0": int(piece["r0"]) + r0,
+                "c0": int(piece["c0"]) + c0,
+            }
+            shifted.append(shifted_piece)
+            all_pieces.append(shifted_piece)
+        pieces_by_component.append(shifted)
+    return all_pieces, pieces_by_component
