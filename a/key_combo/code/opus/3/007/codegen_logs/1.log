+    full = (1 << len(cells)) - 1
+
+    @lru_cache(None)
+    def dfs(remaining: int) -> tuple[int, tuple[int, ...]]:
+        if remaining == 0:
+            return 1, ()
+
+        best_options: tuple[int, ...] | None = None
+        probe = remaining
+        while probe:
+            lsb = probe & -probe
+            cell_idx = lsb.bit_length() - 1
+            valid = tuple(
+                placement_idx
+                for placement_idx in cell_to_placements[cell_idx]
