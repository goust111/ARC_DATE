+                    painted_cells.append((r, c))
+                    painted_colors.append(BLUE)
+                elif value == ORANGE:
+                    out[r, c] = YELLOW
+                    painted_cells.append((r, c))
+                    painted_colors.append(YELLOW)
+                else:
