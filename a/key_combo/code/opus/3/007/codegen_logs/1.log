    rows, cols, total_lo, total_hi = layout
    grid = np.full((rows, cols), BG_COLOR, dtype=int)

    sizes = _gen_sizes(n_objects, random.randint(total_lo, total_hi))
    if not _place_blobs(grid, sizes, FG_COLOR, BG_COLOR):
