+
+def _piece_emitters(piece: dict) -> list[tuple[int, int, int, int]]:
+    r0 = int(piece["r0"])
+    c0 = int(piece["c0"])
+    kind = piece["kind"]
+    if kind == "square":
+        return [
+            (r0 - 1, c0 - 1, -1, -1),
+            (r0 - 1, c0 + 2, -1, 1),
+            (r0 + 2, c0 - 1, 1, -1),
+            (r0 + 2, c0 + 2, 1, 1),
