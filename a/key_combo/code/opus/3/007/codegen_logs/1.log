+    if kind == "bar_h":
+        return [(r0, c0 - 1, 0, -1), (r0, c0 + 3, 0, 1)]
+    if kind == "bar_v":
+        return [(r0 - 1, c0, -1, 0), (r0 + 3, c0, 1, 0)]
