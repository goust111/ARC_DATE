+    out = np.zeros(shape, dtype=int)
+    out[obstacle_mask] = ORANGE
+
+    for piece in pieces:
+        color = TEAL if piece["kind"] == "square" else RED
+        for r, c in _piece_cells(piece["kind"], int(piece["r0"]), int(piece["c0"])):
+            out[r, c] = color
