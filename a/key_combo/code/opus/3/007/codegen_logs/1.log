+            )
+            if not valid:
+                return 0, ()
+            if best_options is None or len(valid) < len(best_options):
+                best_options = valid
+                if len(best_options) == 1:
+                    break
+            probe ^= lsb
+
+        total = 0
+        example: tuple[int, ...] = ()
+        assert best_options is not None
+        for placement_idx in best_options:
