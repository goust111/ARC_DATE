+
+def _sample_variant(
+    base_shape: tuple[tuple[int, int], ...],
+    rng: np.random.Generator,
+    *,
+    require_height: int | None = None,
+    require_floor_centroid_mismatch: bool = False,
+) -> tuple[tuple[int, int], ...] | None:
