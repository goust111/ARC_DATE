def placeable(forbidden, key, r0,c0,H,W):
    for r,c in key:
        rr=r0+r; cc=c0+c
        if not (0<=rr<H and 0<=cc<W): return False
        if (rr,cc) in forbidden: return False
    return True

def add_forbidden(forbidden, key, r0,c0):
    for r,c in key:
        rr=r0+r; cc=c0+c
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                forbidden.add((rr+dr,cc+dc))


