+                    continue
+
+                names = tuple(name for name, _ in solution[0])
+                catalog[k].append(
+                    {
+                        "key": key,
+                        "patch": _key_to_patch(key),
+                        "height": h,
+                        "width": w,
+                        "area": area,
+                        "primitive_names": names,
