                        for c0 in cs:
                            if placeable(forbidden,key,r0,c0,H,W):
                                paste(grid,key_to_patch(key),r0,c0,transparent=0)
                                add_forbidden(forbidden,key,r0,c0)
                                placements.append((orig_k,merged,key,names,r0,c0))
                                success=True; extra=True; break
                        if success: break
                    if success: break
                if success: break
        # analyze
        ext=np.concatenate([grid, np.flipud(grid)], axis=0)
        infos=[]; ks=[]; merged_count=0; prims=set()
