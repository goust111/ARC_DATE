+BACKGROUND = Color.BLACK
+INPUT_COLOR = Color.GREY
+PRIMITIVES = {
+    "square": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "hbar": ((0, 0), (0, 1), (0, 2)),
+    "vbar": ((0, 0), (1, 0), (2, 0)),
+}
+COLOR_BY_COUNT = {
+    1: Color.BLUE,
+    2: Color.RED,
+    3: Color.GREEN,
+    4: Color.YELLOW,
+}
+
+HEIGHT_RANGE = (7, 10)
+WIDTH_RANGE = (8, 11)
+GENERATION_RETRIES = 400
