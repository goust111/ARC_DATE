+def _normalize_key(cells) -> tuple[tuple[int, int], ...]:
+    arr = np.asarray(list(cells), dtype=int)
+    assert arr.ndim == 2 and arr.shape[1] == 2 and len(arr) > 0
+    r0 = int(arr[:, 0].min())
+    c0 = int(arr[:, 1].min())
