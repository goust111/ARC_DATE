def patch(key):
    arr=np.asarray(key); h=arr[:,0].max()+1; w=arr[:,1].max()+1
    out=np.zeros((h,w),dtype=int); out[arr[:,0],arr[:,1]]=5; return out

def placeable(forbidden,key,r0,c0,H,W):
    return all(0<=r0+r<H and 0<=c0+c<W and (r0+r,c0+c) not in forbidden for r,c in key)

def addf(forbidden,key,r0,c0):
    for r,c in key:
        rr=r0+r; cc=c0+c
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                forbidden.add((rr+dr,cc+dc))

def gen():
    rng=np.random.default_rng()
    for _ in range(500):
        H=int(rng.integers(7,10)); W=int(rng.integers(8,11))
        grid=np.zeros((H,W),dtype=int); forbidden=set(); specs=[(1,True),(2,True),(1,False),(2,False)]
        placements=[]
        for orig_k,merged in specs:
            items=catalog[orig_k].copy(); rng.shuffle(items)
            done=False
            for key,names,h,w in items:
                rows=[H-h] if merged else list(range(0,H-h-1))
                cols=list(range(0,W-w+1)); rng.shuffle(rows); rng.shuffle(cols)
                for r0 in rows:
                    if not merged and r0+h-1>H-3: continue
                    for c0 in cols:
                        if placeable(forbidden,key,r0,c0,H,W):
                            paste(grid,patch(key),r0,c0,transparent=0)
                            addf(forbidden,key,r0,c0); done=True; placements.append((orig_k,merged,names,(h,w),(r0,c0)))
                            break
                    if done: break
                if done: break
            if not done: break
        else:
            ext=np.concatenate([grid,np.flipud(grid)])
            comps=find_components(ext,bg=0,connectivity=4,monochromatic=True,colors=[5])
            ks=[]; merged_count=0; prims=set()
            for comp in comps:
                sols=exact(normalize(map(tuple,comp['"'coords'])))
                if len(sols)"'!=1: break
                ks.append(len(sols[0])); prims.update(name for name,_ in sols[0])
                if comp['"'bbox'][0]<H<=comp['bbox'][2]: merged_count+=1
            else:
                if {1,2,4}.issubset(set(ks)) and merged_count>=2 and 'square' in prims and ({'hbar','vbar'}&prims):
                    return H,W,placements,ks,merged_count,prims
    return None
for i in range(30):
    x=gen()
    print(i, bool(x), x[0:2] if x else None, x[2] if x else None)
