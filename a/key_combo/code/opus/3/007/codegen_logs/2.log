+    order = sorted(range(len(pieces)), key=lambda i: (-count_pattern[i], len(candidate_lists[i])))
+    picked_by_piece: list[list[tuple[int, int]]] = [[] for _ in pieces]
+    orange_coords: list[tuple[int, int]] = []
