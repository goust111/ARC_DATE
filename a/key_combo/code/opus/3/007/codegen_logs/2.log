+                    extra_candidates.append(coord)
+
+        random.shuffle(extra_candidates)
+        max_extra = min(2, 8 - len(orange_coords))
+        extra_count = 0
+        if max_extra > 0 and random.random() < 0.6:
+            extra_count = random.randint(0, max_extra)
+
+        extras = []
+        for coord in extra_candidates:
