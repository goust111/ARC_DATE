+RED = Color.RED
+GREY = Color.GREY
+ORANGE = Color.ORANGE
+CYAN = Color.TEAL
+
+FRAME_SIZE_RANGE = (11, 13)
+MARGIN_RANGE = (7, 8)
+SIDE_GAP_RANGE = (4, 5)
