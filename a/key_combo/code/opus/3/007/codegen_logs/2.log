+from arc_utils import Color, bbox_coords, components_mask, crop_bbox, find_components, paste
+
+
+BLACK = Color.BLACK
+RED = Color.RED
+GREY = Color.GREY
+ORANGE = Color.ORANGE
+CYAN = Color.TEAL
+
+FRAME_SIZE_RANGE = (11, 13)
+MARGIN_RANGE = (7, 8)
+SIDE_GAP_RANGE = (4, 5)
+HOLE_COUNT_OPTIONS = (3, 4)
+GENERATION_RETRY_LIMIT = 500
+MAX_LOCAL_TRIES = 200
+SIDES = ("top", "bottom", "left", "right")
+COUNT_PATTERNS = {
+    3: [
+        (0, 1, 2),
+        (0, 1, 3),
+        (0, 2, 3),
+        (1, 1, 2),
+        (1, 2, 2),
+        (1, 2, 3),
+    ],
+    4: [
+        (0, 0, 1, 2),
+        (0, 1, 1, 2),
+        (0, 1, 2, 2),
+        (0, 1, 2, 3),
+        (0, 1, 1, 3),
+        (1, 1, 2, 2),
