+        if not any(count % 2 == 0 for count in pattern):
+            continue
+        if not any(count % 2 == 1 for count in pattern):
+            continue
+        return picked_by_piece, all_oranges
+
+    return None
+
+
+def _render_case(
+    grid_shape: tuple[int, int],
+    frame_box: tuple[int, int, int, int],
