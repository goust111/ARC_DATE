+    for obj in ordered:
+        coords = np.asarray(obj["coords"], dtype=int)
+        landing = coords.copy()
+        landing[:, 0] += int(obj["area"])
+        keep = landing[:, 0] < height
+        if bool(keep.any()):
+            visible = landing[keep]
+            out[visible[:, 0], visible[:, 1]] = int(obj["color"])
+
+    return out
+
