+def _pick_collision_pair(i: int, j: int, allowed: list[list[dict]], areas: list[int]) -> tuple[dict, dict] | None:
+    left = allowed[i][:]
+    right = allowed[j][:]
+    random.shuffle(left)
+    random.shuffle(right)
+    max_pair_overlap = min(MAX_PAIR_OVERLAP, min(int(areas[i]), int(areas[j])) - 1)
