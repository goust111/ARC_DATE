+        return False
+    if _overlap_position_count(placements) > MAX_TOTAL_OVERLAP:
+        return False
+    if min(_visible_counts(placements, areas).values()) < 1:
+        return False
+
+    out = main(grid)
+    if out.shape != grid.shape or np.array_equal(out, grid):
+        return False
+    return True
