+def _overlap_position_count(selected: dict[int, dict]) -> int:
+    hits: Counter[tuple[int, int]] = Counter()
+    for placement in selected.values():
+        hits.update(placement["landing_set"])
+    return sum(count > 1 for count in hits.values())
