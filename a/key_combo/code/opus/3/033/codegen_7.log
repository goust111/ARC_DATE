+def _apply_role_fills(
+    out: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    bg: int,
+    corner_colors: dict[tuple[int, int], int],
+    weave_a: int,
+    weave_b: int,
