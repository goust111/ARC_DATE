+def _read_weave_colors(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    bg: int,
+    line_color: int,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    coords = np.argwhere((grid != bg) & (grid != line_color))
