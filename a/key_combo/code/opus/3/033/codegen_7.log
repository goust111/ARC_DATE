    assert r1 - r0 + 1 >= 3
    assert c1 - c0 + 1 >= 3

    frame = g[r0 : r1 + 1, c0 : c1 + 1]
    h, w = frame.shape
    edge_mask = np.zeros((h, w), dtype=bool)
    edge_mask[0, :] = True
    edge_mask[-1, :] = True
    edge_mask[:, 0] = True
    edge_mask[:, -1] = True

    border_colors = set(map(int, frame[edge_mask]))
    interior_colors = set(map(int, frame[~edge_mask]))
