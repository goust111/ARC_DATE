        keep = target[:, 0] < H
        target = target[keep]
        if target.size == 0:
            continue

        rr = target[:, 0]
        cc = target[:, 1]
        assert not painted[rr, cc].any(), "moved objects must not overlap"
        out[rr, cc] = color
        painted[rr, cc] = True

    return out

