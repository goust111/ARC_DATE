+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+GRID_LINE_COLOR = 3
+CORNER_MARKER_COLORS = {
+    (0, 0): 2,
+    (0, 1): 4,
+    (1, 0): 1,
+    (1, 1): 7,
+}
+WEAVE_COLOR_POOL = [5, 6, 8, 9]
+GRID_COUNT_CHOICES = [3, 4]
+CELL_SIZE_RANGE = (2, 5)
+TOP_MARGIN_RANGE = (2, 4)
+RIGHT_MARGIN_RANGE = (2, 4)
+SIDE_MARGIN_RANGE = (0, 4)
