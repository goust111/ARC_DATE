    for n in range(2,nmax+1):
        out=set()
        for sh in shapes[n-1]:
            s=set(sh)
            frontier=set()
            for cell in sh:
                for nb in neighbors(cell):
                    if nb not in s:
                        frontier.add(nb)
            for nb in frontier:
                out.add(normalize(s|{nb}))
        shapes[n]=out
    return shapes

def to_mask(shape):
    h=max(r for r,c in shape)+1
    w=max(c for r,c in shape)+1
    m=[[0]*w for _ in range(h)]
    for r,c in shape:
        m[r][c]=1
    return m

def syms(shape):
    m=to_mask(shape)
    h=len(m);w=len(m[0])
    vert=all(m[r][c]==m[r][w-1-c] for r in range(h) for c in range(w))
    horiz=all(m[r][c]==m[h-1-r][c] for r in range(h) for c in range(w))
    rot=all(m[r][c]==m[h-1-r][w-1-c] for r in range(h) for c in range(w))
    return vert,horiz,rot,(h,w)

shapes=gen(6)
for n in range(3,7):
    counts=defaultdict(int)
    dims=defaultdict(int)
    for sh in shapes[n]:
        s=syms(sh)
        counts[s[:3]]+=1
        dims[s[3]]+=1
    print('n',n,'total',len(shapes[n]))
    for k,v in sorted(counts.items(), key=lambda kv:(sum(kv[0]),kv[0])):
        print(' ',k,v)
