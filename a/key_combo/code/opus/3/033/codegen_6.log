0274: def main(grid: np.ndarray) -> np.ndarray:
0275:     """
0276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.
0277: 
0278:     Input structure:
0279:     - bg = most common color. Several hollow sprites with distinct border colors.
0280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.
0281: 
0282:     Rule:
0283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.
0284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.
0285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.
0286: 
0287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.
0288:     """
0289:     g = np.asarray(grid, dtype=int)
0290:     bg = _bg_boundary(g)
0291: 
0292:     mapping, pal_mask = _palette_mapping(g, bg)
0293:     assert mapping, "main: palette mapping must be non-empty"
0294: 
0295:     out = g.copy()
0296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
0297: 
0298:     return out
