0231: def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
0232:     """
0233:     Find background regions (excluding the palette area) that do NOT touch the grid boundary,
