0462: 
0463:     # Sprite dimension bounds
0464:     max_sh = min(_SPRITE_H_MAX, H)
0465:     max_sw = min(_SPRITE_W_MAX, W)
0466:     if H <= _TINY_H_THRESHOLD:
0467:         max_sh = 3
0468: 
0469:     # Sprite counts
0470:     num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))
0471:     total_sprites = num_filled + 1
0472: 
0473:     # Generate sprite shapes
0474:     shapes = []
0475:     for _ in range(total_sprites):
0476:         sh = rng.randint(3, max_sh)
0477:         sw = rng.randint(3, max_sw)
0478:         if sh + sw > _SPRITE_DIM_SUM_CAP:
0479:             sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
0480:         if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
0481:             mask = _make_diamond()
0482:         else:
0483:             mask = _make_hollow_sprite(sh, sw, rng)
0484:         if mask is None:
0485:             return None
0486:         shapes.append(mask)
0487: 
0488:     # Colors and palette
0489:     border_keys, fill_values, distractor_color, mapping, filled_keys = \
0490:         _choose_colors(rng, N, num_filled)
0491:     pal = _build_palette(side, border_keys, fill_values)
0492: 
0493:     grid = np.full((H, W), bg, dtype=int)
0494:     occ = np.zeros((H, W), dtype=bool)
0495:     _place_palette(grid, occ, pal, side, rng)
0496: 
0497:     # Assign colors to sprites: filled sprites use palette keys, last one is distractor
0498:     infos = []
0499:     for i, mask in enumerate(shapes):
0500:         if i < num_filled:
0501:             c, f = filled_keys[i], mapping[filled_keys[i]]
0502:         else:
0503:             c, f = distractor_color, None
0504:         infos.append((mask, c, f))
