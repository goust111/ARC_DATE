0506:     # Place sprites
0507:     placed = []
0508:     for mask, color, fill in infos:
0509:         holes = _get_enclosed_holes(mask)
0510:         positions = _find_valid_positions(H, W, occ, mask, holes)
0511:         if not positions:
0512:             return None
0513:         r0, c0 = rng.choice(positions)
0514:         _paint_sprite(grid, r0, c0, mask, color, fill, holes)
0515:         placed.append((r0, c0, mask, fill))
0516:         sh, sw = mask.shape
0517:         occ[max(0, r0 - 1):min(H, r0 + sh + 1),
0518:             max(0, c0 - 1):min(W, c0 + sw + 1)] = True
0519: 
0520:     # Derive input from output by clearing filled holes
0521:     output = grid.copy()
0522:     inp = grid.copy()
