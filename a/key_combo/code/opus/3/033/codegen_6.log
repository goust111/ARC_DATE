+    try:
+        output = main(grid)
+    except Exception:
+        return None
+    expected = output_patches[winner_index]
+    if not np.array_equal(output, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
