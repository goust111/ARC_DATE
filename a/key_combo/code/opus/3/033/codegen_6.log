0418:         pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w
0419:     grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal
0420:     occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),
0421:         max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True
