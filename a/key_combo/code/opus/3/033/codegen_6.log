0063: def main(grid: np.ndarray) -> np.ndarray:
0064:     """
0065:     Render the lower grey slot array by replacing each colored control pixel with the matching legend template.
0066: 
0067:     Input structure
0068:     A background grid has a top legend: each colored marker sits one row above and one column left of a
0069:     2x2 template drawn in a shared template ink color.  Below it is a rectangular array of 2x2 grey slots,
0070:     where a slot may contain one colored control pixel in place of grey.
0071: 
0072:     Rule
0073:     Read the legend as color -> 2x2 template mask.  Convert the lower slot array into a compact array with
0074:     the same row/column layout and one background separator row/column between neighboring tiles.  Empty
0075:     grey slots become blank tiles; a colored slot becomes that color's legend mask recolored with the
0076:     control color.
0077: 
0078:     Key insight
0079:     The colored pixel in a grey slot names which top legend template to stamp; its position inside the slot
0080:     is irrelevant.
0081:     """
0082:     g = np.asarray(grid, dtype=int)
0083:     bg = get_bg(g)
0084:     slot_color = _unique_most_common_non_bg(g, bg)
0085:     blocks = _slot_blocks(g, slot_color)
0086:     templates = _legend_templates(g, bg, slot_color, blocks)
0087: 
0088:     row_starts = sorted({r0 for r0, _c0, _r1, _c1 in blocks})
0089:     col_starts = sorted({c0 for _r0, c0, _r1, _c1 in blocks})
0090:     block_by_start = {(r0, c0): (r0, c0, r1, c1) for r0, c0, r1, c1 in blocks}
0091:     assert len(block_by_start) == len(row_starts) * len(col_starts), "slot blocks must form a full array"
0092: 
0093:     out_h = len(row_starts) * 2 + max(0, len(row_starts) - 1)
0094:     out_w = len(col_starts) * 2 + max(0, len(col_starts) - 1)
0095:     out = np.full((out_h, out_w), bg, dtype=int)
0096: 
0097:     for br, r0 in enumerate(row_starts):
