0524:         if fill is not None:
0525:             for hpts in _get_enclosed_holes(mask):
0526:                 for hr, hc in hpts:
0527:                     inp[r0 + hr, c0 + hc] = bg
0528: 
0529:     # Validate bg is dominant on border
0530:     border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
0531:     vals, cnts = np.unique(border, return_counts=True)
0532:     if int(vals[cnts.argmax()]) != bg:
0533:         return None
0534: 
0535:     # Oracle check
0536:     try:
0537:         if np.array_equal(main(inp), output):
0538:             return inp
0539:     except Exception:
0540:         pass
0541:     return None
