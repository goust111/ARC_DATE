0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """
0012:     Select the 3x3 sprite with the most pixels of the rare foreground color.
0013: 
0014:     Input structure
0015:     - A dominant background contains several separated 4-connected foreground sprites.
0016:     - Exactly two foreground colors fill each sprite, and every sprite is a solid 3x3 rectangle.
0017:     - One foreground color is globally rarer; it acts as the marked color.
0018: 
0019:     Rule
0020:     - Infer the marked color as the unique least frequent non-background color.
0021:     - Extract each foreground component as its 3x3 sprite.
0022:     - Return the unique sprite with the largest count of marked-color pixels.
0023: 
0024:     Key insight
0025:     - The output is a crop of one existing sprite, selected by marker density rather than by location.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     assert g.ndim == 2, "expected a 2D grid"
0029: 
0030:     bg = int(get_bg(g))
0031:     fg_colors = colors_present(g, exclude={bg})
