+_MAX_GEN_ATTEMPTS = 400
+
+
+def _bounded_partitions(total: int, parts: int, lo: int, hi: int) -> list[tuple[int, ...]]:
+    if parts == 1:
+        return [(total,)] if lo <= total <= hi else []
+
+    out: list[tuple[int, ...]] = []
+    remaining_lo = lo * (parts - 1)
