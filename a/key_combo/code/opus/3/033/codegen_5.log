+                rr1 = min(h_total, r0 + h + 1)
+                cc0 = max(0, c0 - 1)
+                cc1 = min(w_total, c0 + w + 1)
+                if occupied[rr0:rr1, cc0:cc1].any():
+                    continue
+                candidates.append((r0, c0))
+        if not candidates:
+            return False
