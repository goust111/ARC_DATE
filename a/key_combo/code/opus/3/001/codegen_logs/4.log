+    if not objects:
+        raise AssertionError("expected at least one foreground object")
+    return sorted(objects, key=lambda obj: (obj.bbox[0], obj.bbox[1], obj.base_color))
+
+
+def _shear_pixels(
+    obj: ParsedObject,
+    shape: tuple[int, int],
+    *,
+    anchor_policy: str = "control",
+    apply_shear: bool = True,
