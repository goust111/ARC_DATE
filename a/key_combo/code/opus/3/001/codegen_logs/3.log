+    col_stop = width - SPRITE_MARGIN - sprite_width
+    return [
+        (r0, c0)
+        for r0 in range(SPRITE_MARGIN, row_stop + 1)
+        for c0 in range(SPRITE_MARGIN, col_stop + 1)
