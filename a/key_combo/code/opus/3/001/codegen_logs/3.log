+    ranked.sort(key=lambda item: (item["center_metric"], item["row_metric"], item["col_metric"], item["index"]))
+    order = tuple(int(item["index"]) for item in ranked)
+    patches: list[np.ndarray] = []
+    for item, scale in zip(ranked, SCALE_BY_RANK):
