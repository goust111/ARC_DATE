+            chosen = None
+            for r0, c0 in candidates:
+                box = _box_from_origin(r0, c0, widths[idx])
+                if all(_boxes_clear(box, other) for other in boxes):
+                    chosen = (r0, c0, box)
+                    break
+            if chosen is None:
+                ok = False
+                break
+            r0, c0, box = chosen
+            patch = _make_patch(masks[idx], colors[idx])
+            placed[idx] = {
