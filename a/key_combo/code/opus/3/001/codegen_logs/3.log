+    # Rotation must matter whenever the blue axis is vertical.
+    if blue_vertical:
+        unrotated = _config_output(specs, correct_order, SCALE_BY_RANK, False)
+        if unrotated.shape == expected.shape and np.array_equal(unrotated, expected):
+            return False
+
+    return True
+
