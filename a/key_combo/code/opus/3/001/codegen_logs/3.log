# Sprite shape sampling.
OBJECT_AREA_MIN, OBJECT_AREA_MAX = 11, 13
SPRITE_GROW_RETRIES = 30

# Source placement.
OFFSET_MIN_L1, OFFSET_MAX_L1 = 1, 2

