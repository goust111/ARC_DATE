    out = np.zeros(GEN_OUTPUT_SHAPE, dtype=int)
    for r, c in np.argwhere(grid == marker):
        r0 = int(r) * GEN_SIDE
        c0 = int(c) * GEN_SIDE
        out[r0 : r0 + GEN_SIDE, c0 : c0 + GEN_SIDE] = grid
    return out


