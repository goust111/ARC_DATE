+
+def _build_input(
+    shape: tuple[int, int],
+    targets: dict[tuple[int, int], Target],
+    object_origins: dict[tuple[int, int], tuple[int, int]],
+    objects: dict[tuple[int, int], Obj],
+) -> np.ndarray:
