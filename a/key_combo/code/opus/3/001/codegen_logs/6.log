+    grid = np.zeros(shape, dtype=int)
+    for target in targets.values():
+        for r, c in target.corners:
+            grid[r, c] = MARKER
+    for size, origin in object_origins.items():
+        obj = objects[size]
+        _paste_nonzero(grid, obj.patch, origin[0], origin[1])
+    return grid
