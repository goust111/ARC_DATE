+
+BBox = tuple[int, int, int, int]
+
+
+@dataclass(frozen=True)
+class Target:
+    outer_bbox: BBox
+    corners: tuple[tuple[int, int], ...]
+    inner_top_left: tuple[int, int]
+    size: tuple[int, int]
+
+
+@dataclass(frozen=True)
+class Obj:
+    bbox: BBox
+    patch: np.ndarray
+    size: tuple[int, int]
