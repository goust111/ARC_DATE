+        assert size not in seen_sizes, "target interior sizes must be unique"
+        seen_sizes.add(size)
+        parsed.append(
+            Target(
+                outer_bbox=(r0, c0, r1, c1),
+                corners=tuple(cand["corners"]),
+                inner_top_left=(r0 + 1, c0 + 1),
+                size=size,
+            )
+        )
+    parsed.sort(key=lambda t: t.outer_bbox)
+    return parsed
