+    solutions: list[list[dict]] = []
+    used: set[int] = set()
+    chosen: list[dict] = []
+
+    def rec() -> None:
+        if len(used) == len(coords):
+            if len(chosen) == 4:
+                solutions.append(chosen.copy())
+            return
+        if len(chosen) >= 4 or len(solutions) > 1:
+            return
+        first = next(i for i in range(len(coords)) if i not in used)
+        for cand in by_first.get(first, []):
