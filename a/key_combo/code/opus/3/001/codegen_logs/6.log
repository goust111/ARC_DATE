+        occupied[r0 : r0 + h, c0 : c0 + w] = True
+        if kind == "target":
+            corners = (
+                (r0, c0),
+                (r0, c0 + w - 1),
+                (r0 + h - 1, c0),
+                (r0 + h - 1, c0 + w - 1),
+            )
