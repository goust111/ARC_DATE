+        for c0 in range(border, w - border - width + 1):
+            rr0 = max(0, r0 - padding)
+            cc0 = max(0, c0 - padding)
+            rr1 = min(h, r0 + height + padding)
+            cc1 = min(w, c0 + width + padding)
