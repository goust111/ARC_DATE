+from __future__ import annotations
+
+from dataclasses import dataclass
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+MARKER = 3
+GRAY = 5
+OBJECT_COLORS = (1, 2, 4, 7)
+SIZE_CANDIDATES = (
+    (2, 3),
+    (3, 2),
+    (2, 4),
+    (4, 2),
+    (2, 5),
+    (5, 2),
+    (2, 6),
