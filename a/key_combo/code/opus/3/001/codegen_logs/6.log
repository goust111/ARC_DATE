+        rows = sorted({r for r, _ in pts})
+        cols = sorted({c for _, c in pts})
+        if len(rows) != 2 or len(cols) != 2:
+            continue
+        corners = {
+            (rows[0], cols[0]),
+            (rows[0], cols[1]),
+            (rows[1], cols[0]),
+            (rows[1], cols[1]),
