+            sizes = pair + random.sample(pool, 2)
+        else:
+            sizes = random.sample(list(SIZE_CANDIDATES), 4)
+        if any(h > w for h, w in sizes) and any(h < w for h, w in sizes):
+            return sizes
+    raise RuntimeError("failed to choose sizes")
+
