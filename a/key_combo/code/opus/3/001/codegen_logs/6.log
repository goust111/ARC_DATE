+) -> tuple[dict[tuple[int, int], Target], dict[tuple[int, int], tuple[int, int]]] | None:
+    occupied = np.zeros(shape, dtype=bool)
+    items = []
+    for size in sizes:
+        h, w = size
+        items.append(("target", size, h + 2, w + 2))
+        items.append(("object", size, h, w))
