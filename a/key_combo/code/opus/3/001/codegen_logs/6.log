+
+def _build_input(
+    shape: tuple[int, int],
+    targets: dict[tuple[int, int], Target],
+    object_origins: dict[tuple[int, int], tuple[int, int]],
+    objects: dict[tuple[int, int], Obj],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for target in targets.values():
+        for r, c in target.corners:
