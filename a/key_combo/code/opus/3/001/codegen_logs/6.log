+    targets: dict[tuple[int, int], Target] = {}
+    objects: dict[tuple[int, int], tuple[int, int]] = {}
+    for kind, size, h, w in items:
+        candidates = _candidate_positions(occupied, h, w)
+        if not candidates:
+            return None
+        r0, c0 = candidates[0]
+        occupied[r0 : r0 + h, c0 : c0 + w] = True
+        if kind == "target":
+            corners = (
+                (r0, c0),
+                (r0, c0 + w - 1),
+                (r0 + h - 1, c0),
+                (r0 + h - 1, c0 + w - 1),
