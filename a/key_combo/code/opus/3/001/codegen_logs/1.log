+
+
+def _build_specs(n_rects: int) -> list[dict]:
+    areas = sorted(random.sample(list(AREA_DIMS), n_rects))
+    colors = random.sample(BODY_COLORS, n_rects)
+
+    dir0 = random.choice(DIRECTIONS)
+    verticals = [UP, DOWN]
+    if dir0 in verticals:
+        dir1 = DOWN if dir0 == UP else UP
+    else:
+        dir1 = random.choice(verticals)
+    d0 = random.choice((2, 3))
+    d2 = 2 if d0 == 3 else 3
+
+    raw_specs = [
+        {
+            "area": areas[0],
+            "body_color": colors[0],
+            "direction": dir0,
+            "distance": d0,
+            "move": d0,
+            "stop": "distance",
+            "prefer_tie": False,
+        },
+        {
+            "area": areas[1],
+            "body_color": colors[1],
+            "direction": dir1,
+            "distance": d0,
+            "move": d0,
+            "stop": "distance",
+            "prefer_tie": True,
+        },
+        {
+            "area": areas[2],
+            "body_color": colors[2],
+            "direction": dir0,
+            "distance": d2,
+            "move": random.randint(1, d2 - 1),
+            "stop": "object",
+            "prefer_tie": False,
+        },
+    ]
+
+    for i in range(3, n_rects):
+        direction = random.choice(DIRECTIONS)
+        distance = random.randint(1, 3)
+        if distance >= 2 and random.random() < 0.4:
+            move = random.randint(1, distance - 1)
+            stop = "boundary"
+        else:
+            move = distance
+            stop = "distance"
+        raw_specs.append(
+            {
+                "area": areas[i],
+                "body_color": colors[i],
+                "direction": direction,
+                "distance": distance,
+                "move": move,
+                "stop": stop,
+                "prefer_tie": False,
+            }
+        )
+
+    for spec in raw_specs:
+        spec["dims"] = _choose_dims(
+            spec["area"],
+            spec["direction"],
+            spec["distance"],
+            prefer_tie=bool(spec["prefer_tie"]),
