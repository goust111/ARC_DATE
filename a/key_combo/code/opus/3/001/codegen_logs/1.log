+MARKER = 2
+BODY_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRECTIONS = (UP, DOWN, LEFT, RIGHT)
