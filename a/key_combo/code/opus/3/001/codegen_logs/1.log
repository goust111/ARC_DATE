+    lo = max(0, fixed0 - moving_len + 1)
+    hi = min(limit - moving_len, fixed0 + fixed_len - 1)
+    if lo > hi:
+        return []
+    out = list(range(lo, hi + 1))
+    random.shuffle(out)
+    return out
