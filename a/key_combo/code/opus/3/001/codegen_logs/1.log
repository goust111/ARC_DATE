+    if len({obj["area"] for obj in objects}) != len(objects):
+        return False
+    if len({obj["body_color"] for obj in objects}) != len(objects):
+        return False
+    if len({obj["direction"] for obj in objects}) < 2:
+        return False
+    if len({obj["distance"] for obj in objects}) < 2:
+        return False
