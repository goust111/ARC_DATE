    (n_colors, marker_count)
    for n_colors in GEN_N_COLORS
    for marker_count in GEN_MARKER_COUNTS
    if GEN_CELL_COUNT - marker_count >= (n_colors - 1) * (marker_count + GEN_OTHER_MIN_EXTRA)
)

