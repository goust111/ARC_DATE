+def _all_center_sets(h: int, w: int, count: int) -> list[tuple[tuple[int, int], ...]]:
+    centers = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    if count == 0:
+        return [tuple()]
