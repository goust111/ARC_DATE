+        fill = COUNT_TO_FILL[cup["cross_count"]]
+        r0, c0, r1, c1 = cup["bbox"]
+        interior_view = out[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all(interior_view[cup["interior_mask"]] == fill):
