+
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    for top, left, spec in zip(tops, lefts, specs):
+        _render_cup(grid, top, left, spec)
+
+    if not _validate_semantics(grid):
+        return None
+    return grid
