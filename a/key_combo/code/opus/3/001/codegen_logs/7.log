+        cap_row = cup["top_row"] - 1
+        cap_c0, cap_c1 = cup["opening_abs"]
+        if not np.all(out[cap_row, cap_c0 : cap_c1 + 1] == fill):
+            return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    specs = _specs_for_attempt()
+    if not specs:
+        return None
+
+    widths = [int(spec["w"]) for spec in specs]
