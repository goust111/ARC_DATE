+        cap_row = int(cup["top_row"] - 1)
+        assert cap_row >= 0, "cups need one row of headroom for the cap layer"
+        cap_c0, cap_c1 = map(int, cup["opening_abs"])
+        assert np.all(out[cap_row, cap_c0 : cap_c1 + 1] == BG_COLOR)
