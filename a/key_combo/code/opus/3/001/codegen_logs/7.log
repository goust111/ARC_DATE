+        need = total_yellow - int(mask.sum())
+        if need <= 0:
+            continue
+        free_cells = [(r, c) for r in range(h) for c in range(w) if not mask[r, c]]
+
+        for _ in range(MASK_ATTEMPTS):
+            trial = mask.copy()
+            order = random.sample(free_cells, len(free_cells))
+            picked = 0
