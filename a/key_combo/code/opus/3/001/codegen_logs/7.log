+    if sorted({cup["cross_count"] for cup in cups}) != [0, 1, 2]:
+        return False
+
+    for cup in cups:
+        if cup["cross_count"] not in COUNT_TO_FILL:
+            return False
+        if not cup["extra_coords_rel"]:
+            return False
+        if not cup["isolated_extra_rel"]:
+            return False
