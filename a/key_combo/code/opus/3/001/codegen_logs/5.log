+    order = sorted(range(len(boxes)), key=lambda i: boxes[i][0] * boxes[i][1], reverse=True)
+    for idx in order:
+        h, w = boxes[idx]
+        candidates = _candidate_positions(occupied, h, w, top_start)
+        if not candidates:
+            return None
