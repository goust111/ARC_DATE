+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GRAY = 5
+PINK = 6
+KEY_COLORS = (1, 2, 3, 7, 8, 9)
+
+GEN_ATTEMPTS = 500
+OUTER_SIZE_2 = (9, 12)
+OUTER_SIZE_3 = (9, 11)
