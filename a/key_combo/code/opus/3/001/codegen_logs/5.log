+    extra_pool = off_path[:]
+    if random.random() < 0.35:
+        extra_pool.extend(cell for cell in frame if cell not in chosen)
+    random.shuffle(extra_pool)
+    extra_count = random.randint(0, min(INNER_DECOR_MAX, len(extra_pool)))
