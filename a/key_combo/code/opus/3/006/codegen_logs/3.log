+    plan: dict[tuple[int, int], int] = {}
+    h_vals = _dash_plan_1d(left + 1, right - 1)
+    for offset, c in enumerate(range(left + 1, right)):
+        plan[(top, c)] = h_vals[offset]
+        plan[(bottom, c)] = h_vals[offset]
