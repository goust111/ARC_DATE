+        h_start, h_end = ul[3] + 1, br[1] - 1
+        v_start, v_end = ul[2] + 1, br[0] - 1
+    elif marker_a[0] < marker_b[0] and marker_a[1] > marker_b[1]:
+        ur, bl = bbox_a, bbox_b
+        top_row, bottom_row = ur[0], bl[2]
+        left_col, right_col = bl[1], ur[3]
