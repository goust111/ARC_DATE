+
+def _locate_source_and_target(grid: np.ndarray) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]]:
+    rects = _grey_frame_rects(grid)
+    assert len(rects) == 2, "expected exactly two grey frames"
