+        v_start, v_end = ur[2] + 1, bl[0] - 1
+    elif marker_b[0] < marker_a[0] and marker_b[1] > marker_a[1]:
+        ur, bl = bbox_b, bbox_a
+        top_row, bottom_row = ur[0], bl[2]
