+    return {
+        "marker": (int(marker[0]), int(marker[1])),
+        "coords": visible_coords,
+        "colors": visible_colors,
+        "coords_set": {tuple(map(int, rc)) for rc in visible_coords},
+        "bbox": bbox,
+        "top_left": (top, left),
