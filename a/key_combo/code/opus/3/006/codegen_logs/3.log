+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_RETRIES = 500
+SOURCE_H_RANGE = (9, 12)
+SOURCE_W_RANGE = (9, 10)
+TARGET_H_RANGE = (9, 12)
+TARGET_W_RANGE = (9, 11)
+FRAME_GAP = 2
+OUTER_MARGIN = 1
