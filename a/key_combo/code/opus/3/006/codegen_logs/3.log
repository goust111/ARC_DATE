+        sprites.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "patch": patch,
+                "coords": np.argwhere(patch != BACKGROUND).astype(int),
+                "colors": patch[patch != BACKGROUND].astype(int),
+                "anchor_color": anchor_color,
+                "anchor_local": (ar, ac),
+            }
+        )
+    return sprites
