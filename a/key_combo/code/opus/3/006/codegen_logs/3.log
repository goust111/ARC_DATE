+def _instance_from_marker(sprite: dict, marker: tuple[int, int], shape: tuple[int, int]) -> dict:
+    h, w = shape
+    ar, ac = sprite["anchor_local"]
+    top = int(marker[0] - ar)
+    left = int(marker[1] - ac)
