+
+def _dash_plan_1d(start: int, end: int) -> list[int]:
+    assert start <= end
+    n = end - start + 1
+    vals = []
+    for i in range(n):
+        vals.append(GREY if min(i, n - 1 - i) % 2 == 0 else BACKGROUND)
