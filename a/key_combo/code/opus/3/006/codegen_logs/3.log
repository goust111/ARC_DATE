+def _marker_only_plan(marker_a: tuple[int, int], marker_b: tuple[int, int]) -> dict[tuple[int, int], int] | None:
+    top, bottom = sorted((int(marker_a[0]), int(marker_b[0])))
+    left, right = sorted((int(marker_a[1]), int(marker_b[1])))
