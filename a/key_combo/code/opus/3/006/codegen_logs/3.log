+    v_vals = _dash_plan_1d(v_start, v_end)
+    for offset, r in enumerate(range(v_start, v_end + 1)):
+        plan[(r, left_col)] = v_vals[offset]
+        plan[(r, right_col)] = v_vals[offset]
