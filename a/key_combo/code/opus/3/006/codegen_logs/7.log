        yield (H - 1, c), {(H - 1, c - 1), (H - 1, c + 1)}, (-1, 0), ((0, -1), (0, 1))
    for r in range(1, H - 1):
        yield (r, 0), {(r - 1, 0), (r + 1, 0)}, (0, 1), ((-1, 0), (1, 0))
