+                    "rc": (r, c),
+                    "color": cell_color,
+                    "first": c < tile_w,
+                    "later": c >= tile_w,
+                    "seam": 0 < c < w - 1 and (c % tile_w in (0, tile_w - 1)),
+                    "tie": tie,
+                    "local_counts": local_counts,
+                }
+            )
+    return candidates
