+def _add_vertical_bar(mask: np.ndarray) -> None:
+    h, w = mask.shape
+    thickness = 1 if w <= 5 else random.choice((1, 1, 2))
+    c0 = random.randint(0, w - thickness)
+    r0 = random.randint(0, max(0, h - 2))
+    r1 = random.randint(r0 + 2, h)
