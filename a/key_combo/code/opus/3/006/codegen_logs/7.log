+    rect_w = random.randint(2, min(max(3, w - 1), w))
+    r0 = random.randint(0, h - rect_h)
+    c0 = random.randint(0, w - rect_w)
+    mask[r0 : r0 + rect_h, c0 : c0 + rect_w] = True
