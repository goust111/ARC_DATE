+def _naive_fill(grid: np.ndarray, main_colors: tuple[int, int], noise_coords: list[tuple[int, int]], fill_color: int) -> np.ndarray:
+    naive = np.asarray(grid, dtype=int).copy()
+    for r, c in noise_coords:
+        naive[r, c] = fill_color
+    return naive
