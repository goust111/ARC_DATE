+
+    counts = [1, 1]
+    for _ in range(noise_count - 2):
+        counts[random.randrange(2)] += 1
+    assignment = [chosen[0]] * counts[0] + [chosen[1]] * counts[1]
+    random.shuffle(assignment)
+    return assignment
+
