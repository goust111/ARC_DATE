+
+def _erase_noise(grid: np.ndarray, noise_coords: list[tuple[int, int]]) -> np.ndarray:
+    erased = np.asarray(grid, dtype=int).copy()
+    for r, c in noise_coords:
+        erased[r, c] = 0
+    return erased
