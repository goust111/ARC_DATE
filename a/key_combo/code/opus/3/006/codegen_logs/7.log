+
+def _global_main_counts(grid: np.ndarray, main_colors: tuple[int, int]) -> tuple[int, int]:
+    counts = Counter(int(v) for v in grid.ravel())
+    return counts[main_colors[0]], counts[main_colors[1]]
+
