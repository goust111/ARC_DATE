+
+
+def _add_horizontal_bar(mask: np.ndarray) -> None:
+    h, w = mask.shape
+    thickness = 1 if h <= 5 else random.choice((1, 1, 2))
+    r0 = random.randint(0, h - thickness)
+    c0 = random.randint(0, max(0, w - 2))
+    c1 = random.randint(c0 + 2, w)
