+        ("first", lambda cand: bool(cand["first"])),
+        ("later", lambda cand: bool(cand["later"])),
+    ]
+    if require_seam:
+        requirements.append(("seam", lambda cand: bool(cand["seam"])))
+    if require_tie:
+        requirements.append(("tie", lambda cand: bool(cand["tie"])))
+    if require_secondary_first:
