+    width = int(g.shape[1])
+    for candidate_w in range(1, width + 1):
+        if width % candidate_w != 0:
+            continue
+        first_block = g[:, :candidate_w]
+        flipped = np.fliplr(first_block)
+        ok = True
+        for c0 in range(0, width, candidate_w):
