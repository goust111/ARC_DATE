+from __future__ import annotations
+
+from collections import Counter
+import importlib.util
+from pathlib import Path
+import random
+
+import numpy as np
+
+
+def _load_arc_utils():
+    candidates = [
+        Path("/home/lixinyu/snap/new/solvers/arc_utils.py"),
+    ]
+    for path in candidates:
+        if not path.is_file():
