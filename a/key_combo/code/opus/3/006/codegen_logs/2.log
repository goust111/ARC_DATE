+def _ray_cells(start: tuple[int, int], direction: tuple[int, int], blocked: np.ndarray) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    r, c = start
+    dr, dc = direction
+    cells = []
+    while in_bounds((h, w), r, c) and not bool(blocked[r, c]):
+        cells.append((int(r), int(c)))
+        r += dr
+        c += dc
+    return cells
