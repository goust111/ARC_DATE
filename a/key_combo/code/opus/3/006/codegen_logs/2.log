+
+def _gen_attempt(rng: random.Random) -> tuple[np.ndarray, dict] | None:
+    (h, w), slots = _make_slots(rng)
+    n = len(slots)
+    palettes, meta = _palette_family(n, rng)
+    grid = np.zeros((h, w), dtype=int)
