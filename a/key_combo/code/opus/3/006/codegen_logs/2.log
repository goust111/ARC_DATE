+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+GREY = 5
+PATH_COLORS = (1, 2, 3, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MIN_SLOT = 9
+MAX_ATTEMPTS = 400
