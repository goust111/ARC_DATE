+        boundary = np.array(coords, dtype=int)
+        outlines.append(
+            {
+                "id": idx,
+                "coords": boundary,
+                "coord_set": {tuple(map(int, xy)) for xy in boundary},
+                "cavity": np.array(cavity, dtype=int),
+            }
+        )
