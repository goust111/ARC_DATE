+                continue
+            if _is_path_color(int(grid[nr, nc])):
+                nxt.append((int(nr), int(nc)))
+        if not nxt:
+            break
+        assert len(nxt) == 1, "path must be unbranched"
+        prev, curr = curr, nxt[0]
