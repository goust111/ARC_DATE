+            start2 = (corner1[0] + dir2[0], corner1[1] + dir2[1])
+            avail2 = _ray_cells(start2, dir2, blocked2)
+            len2_opts = [k for k in range(2, min(4, len(avail2)) + 1)]
+            rng.shuffle(len2_opts)
