+        assert all(int(grid[r, c]) == GREY for r, c in [obj["marker"]])
+        assert all(_is_path_color(int(grid[r, c])) for r, c in obj["path"])
+        assert all(int(out[r, c]) == BG for r, c in obj["path"])
+        assert int(out[obj["marker"]]) == BG
