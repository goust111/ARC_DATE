+    for obj in parsed["objects"]:
+        marker = obj["marker"]
+        path = obj["path"]
+        palette = obj["palette"]
+        outline = parsed["outlines"][obj["outline_id"]]
+        boundary = outline["coords"]
+        cavity = outline["cavity"]
