+    assert 2 <= len(markers) <= 3
+
+    path_cells = {tuple(map(int, xy)) for xy in np.argwhere((g != BG) & (g != YELLOW) & (g != GREY))}
+    used_path = set()
+    objects = []
+    seen_outlines = set()
