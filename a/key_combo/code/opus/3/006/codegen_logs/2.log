+    cuts = sorted(rng.sample(range(total - n * minimum + n - 1), n - 1)) if n > 1 else []
+    parts = []
+    prev = -1
+    for cut in cuts + [total - n * minimum + n - 1]:
+        parts.append(cut - prev - 1 + minimum)
+        prev = cut
