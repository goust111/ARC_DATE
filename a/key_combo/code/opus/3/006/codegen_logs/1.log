+def _too_close(pos: tuple[int, int], occupied: set[tuple[int, int]], gap: int) -> bool:
+    if gap <= 0:
+        return False
+    r, c = pos
+    for rr, cc in occupied:
+        if max(abs(r - rr), abs(c - cc)) <= gap:
+            return True
+    return False
+
+
+def _sample_positions(
+    height: int,
