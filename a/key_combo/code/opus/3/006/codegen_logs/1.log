+    assert len(set(pair_counts.values())) == len(pair_counts)
+    assert len(set(global_counts.values())) == len(global_counts)
+    assert same_pairs >= 1
+    assert diff_pairs >= 1
+    assert isolated_pixels >= 1
+    assert conflicting_pairs >= 1
