+    assert not np.array_equal(out, wrong_keep), "generator must require isolated-pixel erasure"
+    assert not np.any(out[_isolated_mask(g)]), "isolated pixels must be erased"
+    assert 2 <= len(colors_present(out, exclude={0}))
