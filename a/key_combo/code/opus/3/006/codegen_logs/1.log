+                winner = left
+            else:
+                left_count = int(counts[left])
+                right_count = int(counts[right])
+                assert left_count != right_count, "paired-color frequencies must be distinct"
+                winner = left if left_count > right_count else right
+            out[r, c] = winner
+            out[r, mc] = winner
+    return out
