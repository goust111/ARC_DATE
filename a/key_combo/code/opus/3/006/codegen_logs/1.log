+    pair_total = sum(pair_counts.values())
+    min_isolated = max(4, INPUT_FG_RANGE[0] - pair_total)
+    max_isolated = min(10, INPUT_FG_RANGE[1] - pair_total)
+    assert min_isolated <= max_isolated
