+    rng.shuffle(isolated_positions)
+    rng.shuffle(isolated_colors)
+    for pos, color in zip(isolated_positions, isolated_colors):
+        grid[pos] = int(color)
+
+    return grid
+
+
+def _validate_generated_case(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
