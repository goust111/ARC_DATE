+    a, b = random.sample(palette, 2)
+    low, high = min(a, b), max(a, b)
+    if winner_bias == "high":
+        winner_color, loser_color = high, low
+    elif winner_bias == "low":
+        winner_color, loser_color = low, high
+    else:
+        winner_color, loser_color = (a, b) if random.random() < 0.5 else (b, a)
