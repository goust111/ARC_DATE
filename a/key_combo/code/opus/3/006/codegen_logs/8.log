+            BLUE = 1
+            RED = 2
+            GREEN = 3
+            YELLOW = 4
+            PINK = 6
+            ORANGE = 7
+            TEAL = 8
+            MAROON = 9
+
+        def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+            h, w = shape
