    objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
    assert objects, "expected at least one foreground outline"

    out = g.copy()
    for obj in objects:
        color = int(obj["color"])
        coords = obj["coords"]
