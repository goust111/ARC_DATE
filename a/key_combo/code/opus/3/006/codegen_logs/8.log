    r, c = pos
    if zone == "top":
        return int(r + c)
    return int((h - 1 - r) + c)


def _not_edge_adjacent(a: tuple[int, int], b: tuple[int, int]) -> bool:
    return abs(a[0] - b[0]) + abs(a[1] - b[1]) > 1


