+
+def _validate_instance(grid: np.ndarray, require_tie: bool) -> bool:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    if g.ndim != 2 or h > 30 or w > 30 or w % 2 != 0:
+        return False
