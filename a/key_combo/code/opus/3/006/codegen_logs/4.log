+    if out.shape != (2 * active_len, 2 * active_len):
+        return False
+    if len(np.unique(out)) < 2:
+        return False
+    if out.shape == extracted.shape and np.array_equal(out, extracted):
+        return False
+
+    oracle = main(grid)
+    return np.array_equal(oracle, out)
+
