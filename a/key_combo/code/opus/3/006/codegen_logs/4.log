+def _semantic_checks(
+    grid: np.ndarray,
+    *,
+    block: np.ndarray,
+    active_len: int,
+    require_trailing_zeros: bool,
+    require_internal_black: bool,
+) -> bool:
+    try:
+        extracted = _extract_solid_grid(grid)
+    except AssertionError:
+        return False
+
+    if not np.array_equal(extracted, block):
+        return False
+
+    header = extracted[0]
+    try:
+        active = _active_header(header)
+    except AssertionError:
+        return False
