+def _diag_tile_from_header(header: np.ndarray) -> np.ndarray:
+    active = _active_header(header)
+    doubled = np.resize(active, active.size * 2)
+    index = np.maximum.outer(np.arange(doubled.size), np.arange(doubled.size))
