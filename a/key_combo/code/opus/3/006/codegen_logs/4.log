+    colors = np.array(random.sample(palette, k), dtype=int)
+    phase = (tag + random.randrange(k)) % k
+    mode = (tag + random.randrange(5)) % 5
+
+    if mode == 0:
+        idx = rr + cc + phase
+    elif mode == 1:
+        idx = cc + phase
+    elif mode == 2:
+        idx = rr + phase
+    elif mode == 3:
+        idx = rr + 2 * cc + phase
+    else:
+        idx = 2 * rr + cc + phase
