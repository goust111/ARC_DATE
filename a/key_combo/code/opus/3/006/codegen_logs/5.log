# Symmetric core placement.
MIRROR_LAST_COL, CORE_START_COL, CORE_START_ROW_RANGE = GEN_WIDTH - 1, 4, (1, 9)
INNER_CORE_COLS, ALL_LEFT_CORE_COLS, ISOLATED_PAIR_COLS = range(1, 5), range(0, 5), range(0, 4)
