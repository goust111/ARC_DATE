+            return None
+        if out.shape != (OBJ_SIZE, OBJ_SIZE * len(hollows)):
+            return None
+        if set(map(int, np.unique(out))) != {Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK}:
