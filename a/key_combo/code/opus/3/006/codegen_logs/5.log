+) -> list[tuple[int, int]] | None:
+    if not row_slots or len(col_slots) < n_hollow - int(require_tie):
+        return None
+
+    row_pool_size = 2 if require_tie else rng.choice((2, 3))
+    if row_pool_size > len(row_slots):
