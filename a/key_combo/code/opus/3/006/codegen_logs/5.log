+def _render_strip(count: int) -> np.ndarray:
+    out = np.zeros((OBJ_SIZE, OBJ_SIZE * int(count)), dtype=int)
+    for idx in range(int(count)):
+        paste(out, FRAME_PATTERN, 0, OBJ_SIZE * idx)
+    return out
