UNPAIRED_COUNTS_FOR_MIN_PAIRS, UNPAIRED_COUNTS_DEFAULT = (6, 7), (5, 6, 7)
MIN_CORE_PAIR_CELLS, MAX_ISOLATED_PAIR_CELLS = 3, 4
BASE_CORE_COMPONENTS, ISOLATED_PAIR_COMPONENTS = 1, 2
