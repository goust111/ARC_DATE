+
+def generate_input() -> np.ndarray:
+    case = _next_case()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(case)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input for case {case}")

