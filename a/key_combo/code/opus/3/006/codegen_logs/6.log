+
+def _transform_chars(template: tuple[str, ...], transform_id: int) -> np.ndarray:
+    arr = np.array([list(row) for row in template], dtype="<U1")
+    transform_id = int(transform_id)
+    if transform_id >= 4:
+        arr = np.fliplr(arr)
+        transform_id -= 4
