+    ("AB.", "BBB", ".BB"),
+    (".AB.", "BBBB", ".BB.", ".BB."),
+    ("..A..", ".BBB.", "BBBBB", ".BCB.", ".CCC."),
+    ("ABB..", "BBBB.", ".BCBB", "..CCB"),
+    (".A..", "BBB.", ".BCB", ".CCB", "..BB"),
+    ("..A.", ".BBB", "BBCB", ".CCC"),
