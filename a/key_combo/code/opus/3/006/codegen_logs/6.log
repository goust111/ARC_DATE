+def _groups_of_consecutive(rows: list[int]) -> list[list[int]]:
+    if not rows:
+        return []
+    groups = [[int(rows[0])]]
+    for row in rows[1:]:
+        row = int(row)
+        if row == groups[-1][-1] + 1:
+            groups[-1].append(row)
+        else:
