+def _separator_col(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == SEP)]
+    assert len(cols) == 1, "expected exactly one full-height grey separator column"
+    return int(cols[0])
