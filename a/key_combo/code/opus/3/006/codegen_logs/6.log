+        paste(left, patch, top, left_c, transparent=BG)
+        ar, ac = sprite["anchor"]
+        placed.append(
+            {
+                **sprite,
+                "top": int(top),
+                "left": int(left_c),
+                "anchor_global": (int(top + ar), int(left_c + ac)),
+            }
