+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            out = main(grid)
+            sig = (tuple(map(int, out.shape)), out.tobytes())
+            if sig in _GEN_SEEN_OUTPUTS:
