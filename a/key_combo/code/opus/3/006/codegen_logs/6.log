+    grid = _render_input_grid(left, right_width, panel_starts, panel_colors)
+    meta = {
+        "panel_starts": panel_starts,
+        "panel_colors": panel_colors,
+        "source_order": source_order,
+    }
+    return grid if _validate_instance(grid, meta) else None
+
