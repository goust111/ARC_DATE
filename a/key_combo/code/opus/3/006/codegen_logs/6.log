+    ((1, 1, 1), (0, 1, 0), (0, 1, 0)): Color.RED,
+    ((1, 0, 0), (1, 1, 0), (1, 1, 1)): Color.YELLOW,
+    ((1, 0, 1), (0, 1, 0), (1, 0, 1)): Color.TEAL,
