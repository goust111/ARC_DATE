+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+GEN_MAX_ATTEMPTS = 300
+CELL_SIZE_CHOICES = (3, 4)
+CELL_COUNT_RANGE = (5, 7)
