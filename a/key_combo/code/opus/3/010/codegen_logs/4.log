+def _cell_runs_from_sizes(sizes: list[int]) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = 1
+    for size in sizes:
+        runs.append((start, start + int(size) - 1))
+        start += int(size) + 1
+    return runs
