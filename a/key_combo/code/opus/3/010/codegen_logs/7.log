BACKGROUND = 0
PLACEMENT_BORDER = 1
PLACEMENT_PADDING = 1

# Palette and band counts.
COLOR_RANGE = range(1, 10)
PALETTE_SIZE_BOUNDS = (3, 4)
ROW_RUN_COUNT_BOUNDS = (2, 5)
COL_RUN_COUNT_BOUNDS = (3, 7)

# Exemplar and run-size bounds.
EXEMPLAR_HEIGHT_BOUNDS = (9, 11)
