+    for half, mask in ((top, top_mask), (bottom, bottom_mask)):
+        for r, c in np.argwhere(~mask):
+            value = int(half[int(r), int(c)])
+            assert value in PATTERN_COLORS
+            obs.append((int(r), int(c), value))
