    return int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)


def _rect_mask(shape: tuple[int, int], rects: list[Rect]) -> np.ndarray:
    out = np.zeros(shape, dtype=bool)
    for r0, c0, h, w in rects:
        out[r0 : r0 + h, c0 : c0 + w] = True
