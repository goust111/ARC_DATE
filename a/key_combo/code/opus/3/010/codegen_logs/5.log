    min_distinct: int,
    avoid_adjacent: bool = True,
) -> list[int] | None:
    fixed = {int(k): int(v) for k, v in fixed.items()}
    if any(k < 0 or k >= n for k in fixed):
        return None

    seq: list[int | None] = [None] * n

    def rec(i: int) -> bool:
        if i == n:
            return len(set(int(v) for v in seq if v is not None)) >= int(min_distinct)

        choices = [fixed[i]] if i in fixed else list(colors)
        random.shuffle(choices)
        for val in choices:
            val = int(val)
            if avoid_adjacent and i > 0 and seq[i - 1] == val:
                continue
            if avoid_adjacent and i + 1 in fixed and fixed[i + 1] == val:
                continue
            seq[i] = val
            if rec(i + 1):
                return True
            seq[i] = None
        return False

    if rec(0):
        return [int(v) for v in seq if v is not None]
    return None


def _gen_distribute(total: int, count: int, lo: int, hi: int) -> list[int] | None:
    vals: list[int] = []
    remaining = int(total)
    for i in range(int(count)):
        slots = int(count) - i - 1
        a = max(int(lo), remaining - slots * int(hi))
        b = min(int(hi), remaining - slots * int(lo))
        if a > b:
            return None
        val = random.randint(a, b)
        vals.append(val)
        remaining -= val
    return vals if remaining == 0 else None


def _gen_run_widths(count: int, total_lo: int, total_hi: int, stretch_i: int) -> list[int] | None:
    run_lo, run_hi = RUN_WIDTH_BOUNDS
    stretch_options: list[tuple[int, int, int]] = []
    for stretch_w in range(STRETCH_WIDTH_MIN, run_hi + 1):
        lo = stretch_w + (count - 1) * run_lo
        hi = stretch_w + (count - 1) * (stretch_w - 1)
        a = max(int(total_lo), lo)
        b = min(int(total_hi), hi)
        if a <= b:
            stretch_options.append((stretch_w, a, b))
    if not stretch_options:
        return None

    stretch_w, a, b = random.choice(stretch_options)
    total = random.randint(a, b)
    rest = _gen_distribute(total - stretch_w, count - 1, run_lo, stretch_w - 1)
    if rest is None:
        return None

    widths: list[int] = []
    rest_i = 0
    for i in range(count):
        if i == stretch_i:
            widths.append(stretch_w)
        else:
            widths.append(rest[rest_i])
            rest_i += 1
    return widths


def _fill_seed_stretch_lines(
    seed: np.ndarray,
    colors: list[int],
    outer: int,
    non_outer: list[int],
    row_stretch: int,
    col_stretch: int,
) -> bool:
    row_count, col_count = seed.shape

    row_fixed: dict[int, int] = {}
    if row_stretch in (0, row_count - 1):
        row_fixed[0] = int(outer)
        row_fixed[col_count - 1] = int(outer)
    if not (row_stretch in (0, row_count - 1) and col_stretch in (0, col_count - 1)):
        row_fixed[col_stretch] = int(random.choice(non_outer))

    row_seq = _gen_sequence(
        col_count,
        colors,
        fixed=row_fixed,
        min_distinct=MIN_STRETCH_LINE_COLORS,
    )
    if row_seq is None:
        return False
    seed[row_stretch, :] = row_seq

    col_fixed: dict[int, int] = {row_stretch: int(row_seq[col_stretch])}
    if col_stretch in (0, col_count - 1):
        col_fixed[0] = int(outer)
        col_fixed[row_count - 1] = int(outer)

    col_seq = _gen_sequence(
        row_count,
        colors,
        fixed=col_fixed,
        min_distinct=MIN_STRETCH_LINE_COLORS,
    )
    if col_seq is None:
        col_seq = _gen_sequence(
            row_count,
            colors,
            fixed=col_fixed,
            min_distinct=MIN_STRETCH_LINE_COLORS,
            avoid_adjacent=False,
        )
    if col_seq is None:
        return False
    seed[:, col_stretch] = col_seq
    return True


def _is_valid_banded_exemplar(
    exemplar: np.ndarray,
    colors: list[int],
    row_count: int,
    col_count: int,
    row_stretch: int,
    col_stretch: int,
) -> bool:
    ex_h_lo, ex_h_hi = EXEMPLAR_HEIGHT_BOUNDS
    ex_w_lo, ex_w_hi = EXEMPLAR_WIDTH_BOUNDS
    if not (ex_h_lo <= exemplar.shape[0] <= ex_h_hi):
        return False
    if not (ex_w_lo <= exemplar.shape[1] <= ex_w_hi):
        return False
    if len(set(map(int, exemplar.ravel()))) != len(colors):
        return False

    row_runs = _line_runs(exemplar, 0)
    col_runs = _line_runs(exemplar, 1)
    if len(row_runs) != row_count or len(col_runs) != col_count:
        return False
    if _stretch_run_index(row_runs) != row_stretch:
        return False
    if _stretch_run_index(col_runs) != col_stretch:
        return False
    return True


def _gen_banded_exemplar() -> tuple[np.ndarray, int, int, int] | None:
    colors = random.sample(COLOR_RANGE, random.randint(*PALETTE_SIZE_BOUNDS))
    outer = int(random.choice(colors))
    non_outer = [c for c in colors if c != outer]

    run_hi = RUN_WIDTH_BOUNDS[1]
    row_count_options = [
        n
        for n in range(ROW_RUN_COUNT_BOUNDS[0], ROW_RUN_COUNT_BOUNDS[1] + 1)
        if n * run_hi >= EXEMPLAR_HEIGHT_BOUNDS[0] and n <= EXEMPLAR_HEIGHT_BOUNDS[1]
    ]
    row_count = random.choice(row_count_options)
    col_count = random.randint(*COL_RUN_COUNT_BOUNDS)

    row_stretch = random.randrange(row_count)
    if row_count == ROW_RUN_COUNT_BOUNDS[0]:
        col_stretch = random.randrange(1, col_count - 1)
    else:
        col_stretch = random.randrange(col_count)

    row_widths = _gen_run_widths(row_count, *EXEMPLAR_HEIGHT_BOUNDS, row_stretch)
    col_widths = _gen_run_widths(col_count, *EXEMPLAR_WIDTH_BOUNDS, col_stretch)
    if row_widths is None or col_widths is None:
        return None

    seed = np.full((row_count, col_count), int(outer), dtype=int)
    if not _fill_seed_stretch_lines(seed, colors, outer, non_outer, row_stretch, col_stretch):
        return None
    for r, c in ((0, 0), (0, -1), (-1, 0), (-1, -1)):
        seed[r, c] = int(outer)

    exemplar = np.repeat(np.repeat(seed, row_widths, axis=0), col_widths, axis=1)
    if not _is_valid_banded_exemplar(exemplar, colors, row_count, col_count, row_stretch, col_stretch):
        return None

    fixed_rows = sum(w for i, w in enumerate(row_widths) if i != row_stretch)
    fixed_cols = sum(w for i, w in enumerate(col_widths) if i != col_stretch)
    return exemplar, int(outer), int(fixed_rows), int(fixed_cols)


def _gen_target_shapes(fixed_rows: int, fixed_cols: int) -> list[tuple[int, int]] | None:
    min_target_h = max(TARGET_HEIGHT_BOUNDS[0], fixed_rows + 1)
    min_target_w = max(TARGET_WIDTH_BOUNDS[0], fixed_cols + 1)
    if min_target_h > TARGET_HEIGHT_BOUNDS[1] or min_target_w > TARGET_WIDTH_BOUNDS[1]:
        return None

    target_count = 1 if random.random() < SINGLE_TARGET_PROB else 2
    return [
        (random.randint(min_target_h, TARGET_HEIGHT_BOUNDS[1]), random.randint(min_target_w, TARGET_WIDTH_BOUNDS[1]))
        for _ in range(target_count)
    ]


def _place_objects(
    objects: list[tuple[np.ndarray, np.ndarray]],
    height: int,
    width: int,
) -> tuple[np.ndarray, np.ndarray] | None:
    out = np.zeros((height, width), dtype=int)
    inp = np.zeros((height, width), dtype=int)

    random.shuffle(objects)
    objects.sort(key=lambda item: item[0].size, reverse=True)
    try:
        for out_patch, in_patch in objects:
            r, c = random_free_location(
                out,
                out_patch,
                transparent=BACKGROUND,
                border=PLACEMENT_BORDER,
                padding=PLACEMENT_PADDING,
            )
            paste(out, out_patch, r, c)
            paste(inp, in_patch, r, c)
    except ValueError:
        return None
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    built = _gen_banded_exemplar()
    if built is None:
        return None
    exemplar, outer, fixed_rows, fixed_cols = built

    target_shapes = _gen_target_shapes(fixed_rows, fixed_cols)
    if target_shapes is None:
        return None

    height = random.randint(*GRID_HEIGHT_BOUNDS)
    objects: list[tuple[np.ndarray, np.ndarray]] = [(exemplar, exemplar)]
    for shape in target_shapes:
        stretched = _stretch_pattern(exemplar, shape)
        solid = np.full(shape, int(outer), dtype=int)
        objects.append((stretched, solid))

    placed = _place_objects(objects, height, GRID_WIDTH)
    if placed is None:
        return None

    inp, out = placed
    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 40f6cd08 input")


def _reconstruct_rect(
    values: dict[tuple[int, int], int], row_period: int, col_period: int, rect: Rect
) -> np.ndarray:
    _, _, r0, c0, r1, c1 = rect
    out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    for rr, r in enumerate(range(r0, r1 + 1)):
        for cc, c in enumerate(range(c0, c1 + 1)):
            key = (r % row_period, c % col_period)
            assert key in values, "period residue must be visible outside the rectangles"
            out[rr, cc] = values[key]
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recover the repeating background pattern hidden under the largest solid rectangle.

    Input structure:
    - The grid is covered by a small row/column periodic pattern.
    - Several non-pattern colors form solid rectangular foreground objects that
      overwrite the pattern.
    - The requested output region is the largest of those solid rectangles.

    Rule:
    - Find every 4-connected monochromatic object whose bounding box is a filled
      rectangle with both dimensions greater than one.
    - Treat those rectangles as masks, infer the smallest repeating tile that is
      consistent with all remaining visible pixels, and repaint the largest
      rectangle's coordinates with that tile.

    Key insight: The rectangle colors are occluders; the visible pixels outside
    them are enough to reconstruct the original periodic background underneath.
    """
    g = np.asarray(grid, dtype=int)
    rects = _solid_rectangles(g)
    assert rects, "expected at least one solid rectangular occluder"

    max_area = max(area for area, *_ in rects)
    targets = [rect for rect in rects if rect[0] == max_area]
    assert len(targets) == 1, "largest rectangle must be unique"
    target = targets[0]

    blocked = np.zeros(g.shape, dtype=bool)
    for _, _, r0, c0, r1, c1 in rects:
        blocked[r0 : r1 + 1, c0 : c1 + 1] = True

    h, w = g.shape
    period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []
    for row_period in range(1, h + 1):
        for col_period in range(1, w + 1):
            values = _period_values(g, blocked, row_period, col_period)
            if values is not None:
                period_candidates.append((row_period, col_period, values))
    assert period_candidates, "visible pixels must define a periodic pattern"

    min_period_area = min(rp * cp for rp, cp, _ in period_candidates)
    outputs = [
        _reconstruct_rect(values, row_period, col_period, target)
        for row_period, col_period, values in period_candidates
        if row_period * col_period == min_period_area
    ]
    assert outputs, "expected at least one minimal period"
    first = outputs[0]
    assert all(np.array_equal(first, out) for out in outputs), "minimal periods must agree"
    return first

# --------------- generator (att2) ---------------

# Tile palette and period choices.
_GEN_COLOR_RANGE = range(10)
_GEN_TILE_SIZES = [3, 4]
_GEN_TILE_COLOR_COUNTS = [3, 4]
_GEN_STEP_CHOICES = {3: [1, 2], 4: [1, 3]}
# Canvas dimensions from the observed task family.
_GEN_HEIGHT_RANGE = (19, 23)
_GEN_WIDTH_RANGE = (19, 22)
# Occluder rectangle count, size, and coverage constraints.
_GEN_RECT_COUNTS = [2, 3]
_GEN_RECT_SIDE_RANGE = range(3, 13)
_GEN_AREA_RANGE = (9, 100)
_GEN_TARGET_AREA_RANGE = (36, 100)
_GEN_COVERAGE_RANGE = (0.18, 0.33)
# Rejection sampling budget.
_GEN_ATTEMPT_LIMIT = 300

_GEN_DIMS_BY_AREA = {
    h * w: [(hh, ww) for hh in _GEN_RECT_SIDE_RANGE for ww in _GEN_RECT_SIDE_RANGE if hh * ww == h * w]
    for h in _GEN_RECT_SIDE_RANGE
    for w in _GEN_RECT_SIDE_RANGE
}


def _gen_tile() -> np.ndarray:
    size = random.choice(_GEN_TILE_SIZES)
    n_colors = random.choice(_GEN_TILE_COLOR_COUNTS) if size == 3 else 4
    colors = random.sample(_GEN_COLOR_RANGE, n_colors)
    step_choices = _GEN_STEP_CHOICES[n_colors]
    row_step = random.choice(step_choices)
    col_step = random.choice(step_choices)
    offset = random.randrange(n_colors)
    tile = np.empty((size, size), dtype=int)
    for r in range(size):
        for c in range(size):
            tile[r, c] = colors[(offset + row_step * r + col_step * c) % n_colors]
    return tile


def _gen_periodic_grid(tile: np.ndarray, height: int, width: int) -> np.ndarray:
    rows = np.arange(height)[:, None] % tile.shape[0]
    cols = np.arange(width)[None, :] % tile.shape[1]
    return tile[rows, cols].astype(int, copy=True)


def _gen_choose_areas(height: int, width: int, count: int) -> tuple[int, ...] | None:
    min_total = int(np.ceil(_GEN_COVERAGE_RANGE[0] * height * width))
    max_total = int(np.floor(_GEN_COVERAGE_RANGE[1] * height * width))
    area_min, area_max = _GEN_AREA_RANGE
    target_min, target_max = _GEN_TARGET_AREA_RANGE
    small_areas = sorted(a for a in _GEN_DIMS_BY_AREA if area_min <= a <= area_max)
    target_areas = [a for a in small_areas if target_min <= a <= target_max]
    possible: dict[int, list[tuple[int, ...]]] = {}
    for total in range(min_total, max_total + 1):
        tuples: list[tuple[int, ...]] = []
        for target in target_areas:
            if count == 2:
                small = total - target
                if small in _GEN_DIMS_BY_AREA and area_min <= small < target:
                    tuples.append((target, small))
            else:
                rem = total - target
                for small1 in small_areas:
                    small2 = rem - small1
                    if (
                        area_min <= small1 < target
                        and area_min <= small2 < target
                        and small2 in _GEN_DIMS_BY_AREA
                    ):
                        tuples.append((target, small1, small2))
        if tuples:
            possible[total] = tuples
    if not possible:
        return None
    total = random.choice(list(possible))
    return random.choice(possible[total])


def _gen_place_rectangles(shape: tuple[int, int], dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
    occupied = np.zeros(shape, dtype=int)
    placed: list[tuple[int, int, int, int]] = []
    for rect_h, rect_w in dims:
        patch = np.ones((rect_h, rect_w), dtype=int)
        try:
            row, col = random_free_location(occupied, patch, transparent=0)
        except ValueError:
            return None
        paste(occupied, patch, row, col)
        placed.append((row, col, rect_h, rect_w))
    return placed


def _gen_all_residues_visible(occupied: np.ndarray, row_period: int, col_period: int) -> bool:
    seen = np.zeros((row_period, col_period), dtype=bool)
    for residue_r in range(row_period):
        for residue_c in range(col_period):
            seen[residue_r, residue_c] = np.any(
                occupied[residue_r::row_period, residue_c::col_period] == 0
            )
    return bool(seen.all())


def _gen_attempt() -> np.ndarray | None:
    tile = _gen_tile()
    height = random.randint(*_GEN_HEIGHT_RANGE)
    width = random.randint(*_GEN_WIDTH_RANGE)
    base = _gen_periodic_grid(tile, height, width)

    count = random.choice(_GEN_RECT_COUNTS)
    areas = _gen_choose_areas(height, width, count)
    if areas is None:
        return None

    dims = [random.choice(_GEN_DIMS_BY_AREA[area]) for area in areas]
    placed = _gen_place_rectangles((height, width), dims)
    if placed is None:
        return None

    occupied = np.zeros((height, width), dtype=int)
    for row, col, rect_h, rect_w in placed:
        occupied[row : row + rect_h, col : col + rect_w] = 1
    if not _gen_all_residues_visible(occupied, tile.shape[0], tile.shape[1]):
        return None

    target_row, target_col, target_h, target_w = placed[0]
    expected = base[target_row : target_row + target_h, target_col : target_col + target_w].copy()
    tile_colors = set(map(int, tile.ravel()))
    occluder_colors = random.sample([c for c in _GEN_COLOR_RANGE if c not in tile_colors], count)

    grid = base.copy()
    for color, (row, col, rect_h, rect_w) in zip(occluder_colors, placed):
        patch = np.full((rect_h, rect_w), color, dtype=int)
        paste(grid, patch, row, col)

    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(_GEN_ATTEMPT_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {_GEN_ATTEMPT_LIMIT} attempts")

