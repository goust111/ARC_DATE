+
+
+def _random_layout() -> tuple[list[int], list[int], tuple[int, int]]:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        mode = random.choices(["full", "edge"], weights=[3, 1], k=1)[0]
+        n_rows = random.randint(4, 5)
