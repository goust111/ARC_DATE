+    seed_r, seed_c = seed_pos
+    seed_parity = (seed_r + seed_c) % 2 if parity is None else int(parity)
+    out = np.array(grid, dtype=int, copy=True)
+    for rr, (r0, r1) in enumerate(row_spans):
+        for cc, (c0, c1) in enumerate(col_spans):
