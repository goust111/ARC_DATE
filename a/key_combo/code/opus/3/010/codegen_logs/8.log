+def _path_cells(start: tuple[int, int], target: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = start
+    tr, tc = target
+    path = {(r, c)}
+    while (r, c) != (tr, tc):
+        moves: list[tuple[int, int]] = []
+        if r < tr:
+            moves.append((1, 0))
+        elif r > tr:
+            moves.append((-1, 0))
+        if c < tc:
+            moves.append((0, 1))
+        elif c > tc:
+            moves.append((0, -1))
