+        top_extra = random.randint(0, slack)
+        array_r = 1 + top_extra
+        sprite_r = array_r + array_h + gap
+        sprite_c = random.randint(1, grid_w - w - 1)
+        array_c = random.randint(1, grid_w - array_w - 1)
+    elif side == "left":
