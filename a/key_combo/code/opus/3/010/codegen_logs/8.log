+            array_r,
+            array_c,
+            rows,
+            cols,
+            row_step,
+            col_step,
+            lambda ri, ci, rr, cc: ri in (0, rr - 1),
+        ),
+        _render_output(
+            grid.shape,
+            sprite,
+            array_r,
+            array_c,
