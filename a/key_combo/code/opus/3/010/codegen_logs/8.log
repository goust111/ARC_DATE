+def _is_asymmetric(mask: np.ndarray) -> bool:
+    same_shape_variants = [
+        np.flipud(mask),
+        np.fliplr(mask),
+        np.rot90(mask, 2),
+    ]
+    if mask.shape[0] == mask.shape[1]:
+        same_shape_variants.extend([np.rot90(mask, 1), np.rot90(mask, 3), mask.T, np.fliplr(mask.T)])
