+
+    for _ in range(SHAPE_ATTEMPTS):
+        cells = {center}
+        targets = [
+            (0, random.randrange(w)),
+            (h - 1, random.randrange(w)),
+            (random.randrange(h), 0),
+            (random.randrange(h), w - 1),
+        ]
+        for target in targets:
+            cells |= _path_cells(center, target)
