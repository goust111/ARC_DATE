+    low_blue = 2 if n >= 4 else 1
+    high_blue = n - low_blue
+    n_blue = random.randint(low_blue, high_blue)
+    colors = [BLUE] * n_blue + [RED] * (n - n_blue)
+    random.shuffle(colors)
