+def _extract_holes(grid: np.ndarray) -> list[dict]:
+    holes = []
+    for comp in _components_mask(grid == GREY):
+        r0, c0, r1, c1 = _bbox_coords(comp)
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
