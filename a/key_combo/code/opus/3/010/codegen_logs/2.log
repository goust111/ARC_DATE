+                reserved = temp_reserved
+                reserved[sr0 : sr0 + sh, sc0 : sc0 + sw] = True
+                removed_ids = {id(primary_spec), id(secondary_spec)}
+                sprite_specs = [spec for spec in sprite_specs if id(spec) not in removed_ids]
