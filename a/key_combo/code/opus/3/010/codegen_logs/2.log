+    placed["merge_abs"] = tuple(sorted((r0 + r, c0 + c) for r, c in spec["merge_rel"]))
+    placed["delete_abs"] = tuple(sorted((r0 + r, c0 + c) for r, c in spec["delete_rel"]))
+    return placed
