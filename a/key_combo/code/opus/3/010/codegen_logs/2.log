+                continue
+            if np.any(hole[:, 1] == 0) or np.any(hole[:, 1] == patch.shape[1] - 1):
+                continue
+            internal.append(hole)
+        if len(internal) != 1:
+            continue
+        hole = internal[0]
+        hole_abs = tuple(sorted((r0 + int(r), c0 + int(c)) for r, c in hole))
