+        black = patch == BLACK
+        internal = []
+        for hole in _components_mask(black):
+            if np.any(hole[:, 0] == 0) or np.any(hole[:, 0] == patch.shape[0] - 1):
+                continue
+            if np.any(hole[:, 1] == 0) or np.any(hole[:, 1] == patch.shape[1] - 1):
