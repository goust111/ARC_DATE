+            total = sum(counts.values())
+            assert total >= 2
+            best = max(counts.values())
+            assert list(counts.values()).count(best) == 1
+            assert max(counts, key=counts.get) == sprite["color"]
+            seen_merge = True
+        for r, c in sprite["delete_abs"]:
