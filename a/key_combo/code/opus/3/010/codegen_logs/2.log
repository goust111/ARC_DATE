+
+def _bbox_coords(coords) -> tuple[int, int, int, int]:
+    arr = np.asarray(list(coords), dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
