+
+def _count_sprite_neighbors(grid: np.ndarray, r: int, c: int) -> dict[int, int]:
+    counts = {color: 0 for color in SPRITE_COLORS}
+    h, w = grid.shape
+    for nr, nc in _neighbors4(r, c):
+        if 0 <= nr < h and 0 <= nc < w:
+            color = int(grid[nr, nc])
+            if color in counts:
