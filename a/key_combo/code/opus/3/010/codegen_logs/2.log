+
+def _random_connected_shape(area: int, *, max_side: int = 4) -> tuple[tuple[int, int], ...] | None:
+    cells = {(0, 0)}
+    while len(cells) < area:
+        frontier = {
+            nb
+            for r, c in cells
+            for nb in _neighbors4(r, c)
+            if nb not in cells
