+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+SPRITE_COLORS = (BLUE, RED, GREEN)
+
+GRID_SIDE_RANGE = (24, 29)
+RECT_SIDE_RANGE = (6, 8)
+TARGET_AREA_PATTERNS = (
+    (5, 5, 6),
+    (5, 6, 6),
+    (5, 5, 7),
+    (6, 6, 7),
+    (4, 5, 5),
+    (4, 6, 6),
+)
+GEN_ATTEMPTS = 400
