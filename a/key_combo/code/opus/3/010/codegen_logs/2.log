+            if not _is_connected(source):
+                continue
+            ok = True
+            for cell in subset:
+                if sum((nb in source) for nb in _neighbors4(*cell)) < 2:
+                    ok = False
+                    break
+            if ok:
+                out.append(tuple(sorted(subset)))
+    return out
