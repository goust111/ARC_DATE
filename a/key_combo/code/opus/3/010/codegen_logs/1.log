+def _interior_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = map(int, box)
+    if r1 - r0 >= 2 and c1 - c0 >= 2:
+        mask[r0 + 1 : r1, c0 + 1 : c1] = True
+    return mask
