   326	def _zigzag_frame(H):
   327	    """Generate frame bitmap (Hx2 left-half) via zigzag path from top to bottom.
   328	    Returns (cells, start_c, end_c) where start_c/end_c are the column at top/bottom."""
   329	    cells = set()
   330	    start_c = random.randint(0, 1)
   331	    c = start_c
   332	    for r in range(H):
   333	        cells.add((r, c))
   334	        if r == H - 1:
   335	            break
   336	        move = random.choice(['down', 'horiz', 'diag'])
   337	        if move == 'down':
   338	            pass
   339	        elif move == 'horiz':
   340	            cells.add((r, 1 - c))
   341	            c = 1 - c
   342	        else:
   343	            c = 1 - c
   344	    return cells, start_c, c
