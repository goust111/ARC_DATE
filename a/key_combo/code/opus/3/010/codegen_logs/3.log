   224	def _gen_attempt() -> np.ndarray | None:
   225	    """Single attempt: pick colors, build template + lattice, place stamps + singletons."""
   226	    bg, T, O = random.sample(range(10), 3)
   227	
   228	    h = random.choice(TEMPLATE_H_CHOICES)
   229	    w = TEMPLATE_W
   230	    templ_cells = _gen_template(h, w)
   231	    if templ_cells is None:
   232	        return None
   233	
   234	    n_sing = random.randint(*SINGLETON_COUNT_RANGE)
   235	    lat = _gen_lattice(n_sing)
   236	    if lat is None:
   237	        return None
   238	    lattice_cells, origin = lat
   239	    deltas = [(r - origin[0], c - origin[1]) for r, c in lattice_cells]
   240	    min_dr, max_dr, min_dc, max_dc = _delta_bounds(deltas)
   241	
   242	    # Compute valid placement window for the template origin
   243	    r0_lo, r0_hi = -min_dr * h, GRID_SIZE - max_dr * h - h
   244	    c0_lo, c0_hi = -min_dc * w, GRID_SIZE - max_dc * w - w
   245	    if r0_lo > r0_hi or c0_lo > c0_hi:
   246	        return None
   247	
   248	    r0 = random.randint(r0_lo, r0_hi)
   249	    c0 = random.randint(c0_lo, c0_hi)
   250	
   251	    # Verify no pixel overlap between stamps
   252	    occupied = set()
   253	    for dr, dc in deltas:
   254	        for tr, tc in templ_cells:
   255	            pt = (r0 + dr * h + tr, c0 + dc * w + tc)
   256	            if pt in occupied:
   257	                return None
   258	            occupied.add(pt)
   259	
   260	    return _place_singletons(
   261	        deltas, min_dr, max_dr, min_dc, max_dc,
   262	        templ_cells, r0, c0, h, w, bg, T, O, occupied,
   263	    )
   264	
   265	
   266	def generate_input() -> np.ndarray:
   267	    for _ in range(GENERATE_RETRIES):
   268	        result = _gen_attempt()
   269	        if result is not None:
   270	            return result
   271	    raise RuntimeError("Failed to generate input after %d attempts" % GENERATE_RETRIES)

