import random, itertools, numpy as np
H,W=5,4

def gen_mask():
    area=random.randint(3,6)
    cells=[(random.randrange(H),random.randrange(W))]
    s=set(cells)
    while len(s)<area:
        r,c=random.choice(tuple(s))
        opts=[(r+1,c),(r-1,c),(r,c+1),(r,c-1)]
        opts=[p for p in opts if 0<=p[0]<H and 0<=p[1]<W and p not in s]
        if not opts:
            continue
        s.add(random.choice(opts))
    m=np.zeros((H,W),dtype=int)
    for r,c in s:m[r,c]=1
    return m

def overlay(masks,perm):
    out=np.zeros((H,W),dtype=int)
    for idx in perm:
        out[masks[idx]>0]=idx+1
    return out

success=0
for t in range(2000):
    masks=[gen_mask() for _ in range(4)]
    outs={overlay(masks,p).tobytes() for p in itertools.permutations(range(4))}
    if len(outs)==24:
        success+=1
print('success',success)
