   191	def _gen_run_widths(count: int, total_lo: int, total_hi: int, stretch_i: int) -> list[int] | None:
   192	    run_lo, run_hi = RUN_WIDTH_BOUNDS
   193	    stretch_options: list[tuple[int, int, int]] = []
   194	    for stretch_w in range(STRETCH_WIDTH_MIN, run_hi + 1):
   195	        lo = stretch_w + (count - 1) * run_lo
   196	        hi = stretch_w + (count - 1) * (stretch_w - 1)
   197	        a = max(int(total_lo), lo)
   198	        b = min(int(total_hi), hi)
   199	        if a <= b:
   200	            stretch_options.append((stretch_w, a, b))
   201	    if not stretch_options:
   202	        return None
   203	
   204	    stretch_w, a, b = random.choice(stretch_options)
   205	    total = random.randint(a, b)
   206	    rest = _gen_distribute(total - stretch_w, count - 1, run_lo, stretch_w - 1)
   207	    if rest is None:
   208	        return None
   209	
   210	    widths: list[int] = []
   211	    rest_i = 0
   212	    for i in range(count):
   213	        if i == stretch_i:
   214	            widths.append(stretch_w)
   215	        else:
   216	            widths.append(rest[rest_i])
   217	            rest_i += 1
   218	    return widths
