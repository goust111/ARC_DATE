   122	    half_h = (data_rs.stop - data_rs.start) // QUADRANT_AXIS_COUNT
   123	    half_w = (data_cs.stop - data_cs.start) // QUADRANT_AXIS_COUNT
   124	    for qr, qc in QUADRANT_POSITIONS:
   125	        rs = slice(data_rs.start + qr * half_h, data_rs.start + (qr + 1) * half_h)
   126	        cs = slice(data_cs.start + qc * half_w, data_cs.start + (qc + 1) * half_w)
