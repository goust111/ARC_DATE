   219	def _choose_frame_shape(horizontal: bool, n_sprites: int) -> tuple[int, int, list[tuple[int, int]]] | None:
   220	    cross_dim = random.randint(SPRITE_DIM_MIN, SPRITE_DIM_MAX)
   221	    along_dims = _choose_along_dims(n_sprites)
   222	    if along_dims is None:
   223	        return None
   224	
   225	    frame_along = sum(along_dims) + FRAME_MARGIN_DIMS
   226	    min_cross = max(FRAME_DIM_MIN, cross_dim + 1)
   227	    possible_cross = [v for v in range(min_cross, FRAME_DIM_MAX + 1) if v != frame_along]
   228	    if not possible_cross:
   229	        return None
   230	
   231	    frame_cross = random.choice(possible_cross)
   232	    if horizontal:
   233	        return frame_cross, frame_along, [(cross_dim, w_l) for w_l in along_dims]
   234	    return frame_along, frame_cross, [(h_l, cross_dim) for h_l in along_dims]
