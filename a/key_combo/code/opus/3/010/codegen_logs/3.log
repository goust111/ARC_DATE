   206	def _choose_along_dims(n_sprites: int) -> list[int] | None:
   207	    along_dims = []
   208	    for i in range(n_sprites):
   209	        remaining = n_sprites - i - 1
   210	        current_sum = sum(along_dims)
   211	        lo = max(SPRITE_DIM_MIN, ALONG_SUM_MIN - current_sum - SPRITE_DIM_MAX * remaining)
   212	        hi = min(SPRITE_DIM_MAX, ALONG_SUM_MAX - current_sum - SPRITE_DIM_MIN * remaining)
   213	        if lo > hi:
   214	            return None
   215	        along_dims.append(random.randint(lo, hi))
   216	    return along_dims
