+def _apply_symmetry(arr: np.ndarray, mode: int) -> np.ndarray:
+    out = np.array(arr, dtype=bool, copy=True)
+    if mode >= 4:
+        out = np.fliplr(out)
+    out = np.rot90(out, mode % 4)
+    return np.array(out, dtype=bool, copy=True)
