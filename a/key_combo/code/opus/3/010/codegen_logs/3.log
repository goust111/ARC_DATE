    10	def main(grid: np.ndarray) -> np.ndarray:
    11	    """
    12	    Copy the single colored sprite so its bounding-box center lands on the gray marker.
    13	
    14	    Input structure:
    15	    - A background grid containing one non-gray foreground sprite.
    16	    - Exactly one gray marker pixel sits in an otherwise empty region.
    17	    - The sprite's bounding box has odd height and odd width, so it has a center cell.
    18	
    19	    Rule:
    20	    - Keep the original sprite unchanged.
    21	    - Extract the full bounding box of the non-gray sprite, treating background cells inside the box as transparent.
    22	    - Paste that sprite box centered on the gray marker, replacing the marker.
    23	
    24	    Key insight:
    25	    The gray pixel is not a color to preserve; it marks the center of a second copy of the existing sprite.
    26	    """
    27	    g = np.asarray(grid, dtype=int)
    28	    bg = get_bg(g)
    29	    assert bg != Color.GREY
    30	
    31	    marker_coords = np.argwhere(g == Color.GREY)
    32	    assert len(marker_coords) == 1
    33	    marker_r, marker_c = map(int, marker_coords[0])
    34	
    35	    sprite_mask = (g != bg) & (g != Color.GREY)
    36	    sprite_components = components_mask(sprite_mask, connectivity=4)
    37	    assert len(sprite_components) == 1
    38	
    39	    sprite_bbox = bbox(sprite_mask)
    40	    assert sprite_bbox is not None
    41	    r0, c0, r1, c1 = sprite_bbox
    42	    h = bbox_h(sprite_bbox)
    43	    w = bbox_w(sprite_bbox)
    44	    assert h % 2 == 1 and w % 2 == 1
    45	
    46	    patch = g[r0 : r1 + 1, c0 : c1 + 1]
    47	    assert int(patch[h // 2, w // 2]) != bg
    48	
    49	    paste_r = marker_r - h // 2
    50	    paste_c = marker_c - w // 2
    51	    assert 0 <= paste_r and 0 <= paste_c
    52	    assert paste_r + h <= g.shape[0] and paste_c + w <= g.shape[1]
    53	
    54	    target = g[paste_r : paste_r + h, paste_c : paste_c + w]
    55	    assert bool(np.all((target == bg) | (target == Color.GREY)))
    56	
    57	    out = g.copy()
    58	    out[marker_r, marker_c] = bg
    59	    paste(out, patch, paste_r, paste_c, transparent=bg)
    60	    return out
