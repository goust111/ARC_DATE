   434	def _extract_non_frame_patches(out, bg, fcs):
   435	    """Extract non-frame piece patches from the output grid, sorted largest-first."""
   436	    patches = []
   437	    for col in sorted(map(int, np.unique(out))):
   438	        if col in fcs:
   439	            continue
   440	        for pts in components_mask(out == col, connectivity=4):
   441	            r0, c0, r1, c1 = bbox_coords(pts)
   442	            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
   443	            for r, c in pts:
   444	                patch[int(r) - r0, int(c) - c0] = col
   445	            patches.append(patch)
   446	    random.shuffle(patches)
   447	    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
   448	    return patches
