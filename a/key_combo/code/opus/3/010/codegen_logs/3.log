   178	def _place_singletons(
   179	    deltas, min_dr, max_dr, min_dc, max_dc,
   180	    templ_cells, r0, c0, h, w, bg, T, O, occupied,
   181	) -> np.ndarray | None:
   182	    """Try to find a valid singleton cluster position and build the input grid."""
   183	    orr_lo, orr_hi = -min_dr * GUNIT, GRID_SIZE - 1 - max_dr * GUNIT
   184	    orc_lo, orc_hi = -min_dc * GUNIT, GRID_SIZE - 1 - max_dc * GUNIT
   185	    if orr_lo > orr_hi or orc_lo > orc_hi:
   186	        return None
   187	
   188	    # Template bbox edges
   189	    tr0, tr1 = r0, r0 + h - 1
   190	    tc0, tc1 = c0, c0 + w - 1
   191	
   192	    for _ in range(SINGLETON_RETRIES):
   193	        orr = random.randint(orr_lo, orr_hi)
   194	        orc = random.randint(orc_lo, orc_hi)
   195	
   196	        # Singleton cluster bbox -- must be disjoint from template with >=1 bg cell gap
   197	        sr0 = orr + min_dr * GUNIT
   198	        sr1 = orr + max_dr * GUNIT
   199	        sc0 = orc + min_dc * GUNIT
   200	        sc1 = orc + max_dc * GUNIT
   201	        if not (sr1 + 1 < tr0 or tr1 + 1 < sr0 or sc1 + 1 < tc0 or tc1 + 1 < sc0):
   202	            continue
   203	
   204	        # Singletons must not land on stamp pixels
   205	        if any((orr + dr * GUNIT, orc + dc * GUNIT) in occupied for dr, dc in deltas):
   206	            continue
   207	
   208	        # Build input grid
   209	        grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)
   210	        for tr, tc in templ_cells:
   211	            grid[r0 + tr, c0 + tc] = T
   212	        for dr, dc in deltas:
   213	            grid[orr + dr * GUNIT, orc + dc * GUNIT] = T if (dr == 0 and dc == 0) else O
   214	
   215	        try:
   216	            main(grid)
   217	        except Exception:
   218	            return None
   219	        return grid
   220	
   221	    return None
   222	
