   308	def _valid_dims():
   309	    """Precompute valid (H, W) pairs: unique closest-to-square portrait factorization with W=5."""
   310	    results = []
   311	    for area in range(_AREA_MIN, _AREA_MAX + 1):
   312	        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
   313	        best_gap = min(abs(h - w) for h, w in dims)
   314	        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
   315	        if len(best) == 1:
   316	            h, w = best[0]
   317	            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
   318	                results.append((h, w))
   319	    return results
   320	
   321	
   322	_VALID_DIMS = _valid_dims()
   323	_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]
