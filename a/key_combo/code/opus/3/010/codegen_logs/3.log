    21	def main(grid: np.ndarray) -> np.ndarray:
    22	    """
    23	    Recolor the data pixels in each quadrant using the matching entry of the 2x2 legend.
    24	
    25	    Input structure:
    26	    - The grid has a dominant background, a thick divider color, one 2x2 corner legend,
    27	      and an opposite rectangular data region.
    28	    - The data region contains background plus one foreground data color.
    29	
    30	    Rule:
    31	    - Split the data region into four equal quadrants.
    32	    - For every data-colored pixel, replace it with the color in the same top/bottom and
    33	      left/right position of the 2x2 legend.
    34	    - Keep the background, divider, and legend unchanged.
    35	
    36	    Key insight:
    37	    - The 2x2 legend is not moved or copied as a shape; its cells are a quadrant color
    38	      key for the separated data field.
    39	    """
    40	    g = np.asarray(grid, dtype=int)
    41	    assert g.ndim == 2, "expected a 2D grid"
    42	    h, w = g.shape
    43	
    44	    bg = get_bg(g)
    45	    divider = _unique_divider_color(g, bg)
    46	
    47	    non_field_mask = (g != bg) & (g != divider)
    48	    legend_boxes = []
    49	    for coords in components_mask(non_field_mask, connectivity=4):
    50	        r0, c0, r1, c1 = bbox_coords(coords)
    51	        is_corner = (r0 == 0 or r1 == h - 1) and (c0 == 0 or c1 == w - 1)
    52	        if coords.shape[0] == 4 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2) and is_corner:
    53	            legend_boxes.append((r0, c0, r1, c1))
    54	    assert len(legend_boxes) == 1, "expected exactly one 2x2 legend"
    55	    lr0, lc0, lr1, lc1 = legend_boxes[0]
    56	    legend = g[lr0 : lr1 + 1, lc0 : lc1 + 1]
    57	    assert np.all((legend != bg) & (legend != divider)), "legend should contain only paint colors"
    58	
    59	    at_top = lr0 == 0
    60	    at_bottom = lr1 == h - 1
    61	    at_left = lc0 == 0
    62	    at_right = lc1 == w - 1
    63	    assert at_top != at_bottom and at_left != at_right, "legend must sit in one corner"
    64	
    65	    data_r0, data_r1 = (lr1 + 1, h - 1) if at_top else (0, lr0 - 1)
    66	    data_c0, data_c1 = (lc1 + 1, w - 1) if at_left else (0, lc0 - 1)
    67	    assert data_r0 <= data_r1 and data_c0 <= data_c1, "expected a nonempty data region"
    68	
    69	    assert np.all(g[lr0 : lr1 + 1, data_c0 : data_c1 + 1] == divider)
    70	    assert np.all(g[data_r0 : data_r1 + 1, lc0 : lc1 + 1] == divider)
    71	
    72	    data = g[data_r0 : data_r1 + 1, data_c0 : data_c1 + 1]
    73	    data_colors = [int(color) for color in set(map(int, data.ravel())) if color != bg]
    74	    assert len(data_colors) == 1, "data region should contain one foreground color"
    75	    data_color = data_colors[0]
    76	    assert data_color != divider, "divider should not appear inside the data region"
    77	
    78	    data_h, data_w = data.shape
    79	    assert data_h % 2 == 0 and data_w % 2 == 0, "data region must split into four equal quadrants"
    80	    half_h, half_w = data_h // 2, data_w // 2
    81	
    82	    out = g.copy()
    83	    for qr in range(2):
    84	        for qc in range(2):
    85	            rs = slice(data_r0 + qr * half_h, data_r0 + (qr + 1) * half_h)
    86	            cs = slice(data_c0 + qc * half_w, data_c0 + (qc + 1) * half_w)
    87	            mask = g[rs, cs] == data_color
    88	            block = out[rs, cs]
    89	            block[mask] = int(legend[qr, qc])
    90	    return out
