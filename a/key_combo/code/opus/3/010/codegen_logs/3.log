   451	def _scatter(out: np.ndarray, bg: int, fcs: set[int]) -> np.ndarray:
   452	    """Place pieces onto a canvas: frame as a group, non-frame scattered with padding."""
   453	    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
   454	    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
   455	    canvas = np.full((rows, cols), bg, dtype=int)
   456	    oh, ow = out.shape
   457	
   458	    max_r = rows - oh - 2
   459	    max_c = cols - ow - 2
   460	    if max_r < 1 or max_c < 1:
   461	        raise ValueError
   462	    off_r = random.randint(1, max_r)
   463	    off_c = random.randint(1, max_c)
   464	
   465	    # Block the entire frame bbox so fill pieces stay outside the outline
   466	    canvas[off_r:off_r + oh, off_c:off_c + ow] = -1
   467	
   468	    # Scatter non-frame pieces into the area OUTSIDE the blocked bbox
   469	    for patch in _extract_non_frame_patches(out, bg, fcs):
   470	        r, c = random_free_location(canvas, patch, transparent=bg,
   471	                                    padding=_SCATTER_PADDING, padding_connectivity=8)
   472	        paste(canvas, patch, r, c, transparent=bg)
   473	
   474	    # Replace blocked bbox with frame cells (non-frame positions revert to bg)
   475	    frame_mask = np.zeros((oh, ow), dtype=bool)
   476	    for col in fcs:
   477	        frame_mask |= (out == col)
   478	    bbox_region = canvas[off_r:off_r + oh, off_c:off_c + ow]
   479	    bbox_region[:] = bg
