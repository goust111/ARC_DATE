   132	def _gen_quadrant_counts(data_area: int) -> list[int]:
   133	    min_total = max(LEGEND_CELL_COUNT * MIN_PIXELS_PER_QUADRANT, (MIN_DENSITY_PERCENT * data_area + 99) // 100)
   134	    max_total = min(MAX_TOTAL_DATA_PIXELS, (MAX_DENSITY_PERCENT * data_area) // 100)
   135	    total = random.randint(min_total, max_total)
   136	    counts = [MIN_PIXELS_PER_QUADRANT] * LEGEND_CELL_COUNT
   137	    for _ in range(total - LEGEND_CELL_COUNT):
   138	        choices = [i for i, count in enumerate(counts) if count < MAX_PIXELS_PER_QUADRANT]
