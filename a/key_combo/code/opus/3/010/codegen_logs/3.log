def connected(sub):
    sub=set(sub)
    stack=[next(iter(sub))]
    seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for nr,nc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):
            if (nr,nc) in sub and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
