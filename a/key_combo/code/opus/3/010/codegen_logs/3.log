+    arrays: list[np.ndarray] = []
+    for panel in family:
+        arr = np.zeros((max_r + 1, max_c + 1), dtype=bool)
+        for r, c in panel:
+            arr[int(r), int(c)] = True
+        arrays.append(arr)
+    return arrays
+
+
+def _materialize_panel_masks() -> list[np.ndarray]:
+    family = random.choice(BASE_FAMILIES)
+    base_arrays = _family_to_arrays(family)
