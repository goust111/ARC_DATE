   169	def _delta_bounds(deltas: list[tuple[int, int]]):
   170	    """Return (min_dr, max_dr, min_dc, max_dc) for a list of (dr, dc) offsets."""
   171	    min_dr = min(dr for dr, dc in deltas)
   172	    max_dr = max(dr for dr, dc in deltas)
   173	    min_dc = min(dc for dr, dc in deltas)
   174	    max_dc = max(dc for dr, dc in deltas)
   175	    return min_dr, max_dr, min_dc, max_dc
