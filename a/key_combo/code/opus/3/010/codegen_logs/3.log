   168	    grid = np.full((n, n), BACKGROUND_COLOR, dtype=int)
   169	    grid[legend_rs, data_cs] = DIVIDER_COLOR
   170	    grid[data_rs, legend_cs] = DIVIDER_COLOR
   171	    colors = random.sample(PAINT_COLORS, LEGEND_CELL_COUNT)
   172	    legend = np.array(colors, dtype=int).reshape(LEGEND_SIZE, LEGEND_SIZE)
   173	    data_color = random.choice(colors)
   174	    grid[legend_rs, legend_cs] = legend
   175	
   176	    _paint_data_region(grid, data_rs, data_cs, data_color)
   177	
   178	    expected = _gen_expected_output(grid, legend, data_color, data_rs, data_cs)
   179	    if not np.array_equal(main(grid), expected):
