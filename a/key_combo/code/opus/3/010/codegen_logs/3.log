   140	    lattice_candidates = [c for c in non_bg if counts[c] == max_non_bg_count]
   141	    assert len(lattice_candidates) == 1, "lattice color must be uniquely most frequent"
   142	    lattice_color = lattice_candidates[0]
   143	
   144	    special_colors = [c for c in non_bg if c != lattice_color]
   145	    assert len(special_colors) >= 2, "expected one frame and at least one sprite"
   146	
   147	    coords_by_color = {c: np.argwhere(g == c) for c in special_colors}
   148	    frame_candidates = []
   149	    for color, coords in coords_by_color.items():
   150	        if _is_sparse_rect_perimeter(coords):
