   110	def _gen_regions(n: int, corner: int) -> tuple[slice, slice, slice, slice]:
   111	    top = corner < QUADRANT_AXIS_COUNT
   112	    left = corner % QUADRANT_AXIS_COUNT == 0
   113	    legend_rs = slice(0, LEGEND_SIZE) if top else slice(n - LEGEND_SIZE, n)
   114	    legend_cs = slice(0, LEGEND_SIZE) if left else slice(n - LEGEND_SIZE, n)
   115	    data_rs = slice(LEGEND_SIZE, n) if top else slice(0, n - LEGEND_SIZE)
   116	    data_cs = slice(LEGEND_SIZE, n) if left else slice(0, n - LEGEND_SIZE)
   117	    return legend_rs, legend_cs, data_rs, data_cs
