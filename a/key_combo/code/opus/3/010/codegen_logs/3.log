   371	def _build_output(H, W):
   372	    """Build an abstract LR-symmetric output grid with zigzag frame and filled holes.
   373	    Returns (grid, frame_colors_set) or (None, set()) on failure."""
   374	    half = W // 2
   375	    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
   376	    palette = list(range(n_colors))
   377	    random.shuffle(palette)
   378	
   379	    use_two_frames = (H >= _TWO_FRAME_MIN_H and n_colors >= _TWO_FRAME_MIN_COLORS
   380	                      and random.random() < _TWO_FRAME_PROB)
   381	    ci = 0
   382	    frame1 = palette[ci]; ci += 1
   383	    frame2 = frame1
   384	    if use_two_frames:
   385	        frame2 = palette[ci]; ci += 1
   386	    fill_pool = palette[ci:]
   387	    if not fill_pool:
   388	        return None, set()
   389	
   390	    frame_half, start_c, end_c = _zigzag_frame(H)
   391	    split = H // 2 if frame1 != frame2 else H
   392	
   393	    grid = np.full((H, W), -1, dtype=int)
   394	
   395	    # Paint frame cells (mirror left half to right)
   396	    for r, c in frame_half:
   397	        fc = frame1 if r < split else frame2
   398	        grid[r, c] = fc
   399	        grid[r, W - 1 - c] = fc
   400	
   401	    # Cap center column at top/bottom when zigzag endpoint is adjacent
   402	    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
   403	        grid[0, half] = frame1
   404	    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
   405	        grid[H - 1, half] = frame2
   406	
   407	    _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool)
   408	
   409	    if np.any(grid < 0):
   410	        return None, set()
   411	    frame_set = {frame1}
   412	    if frame2 != frame1:
   413	        frame_set.add(frame2)
   414	    return grid, frame_set
