   347	def _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool):
   348	    """Fill non-frame cells by assigning colors to 4-conn hole regions.
   349	    Large holes are split into chunks of <= _MAX_CHUNK_SIZE cells."""
   350	    holes = components_mask(grid == -1, connectivity=4)
   351	    prev_col = None
   352	    for hole in holes:
   353	        cells = sorted((int(r), int(c)) for r, c in hole)
   354	        # Split into chunks of bounded size
   355	        chunks = [cells[i:i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
   356	        for chunk in chunks:
   357	            # Determine which frame colors are adjacent to this chunk
   358	            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
   359	            # Pick a fill color avoiding frame and previous neighbor
   360	            avoid = fc_set | ({prev_col} if prev_col else set())
   361	            opts = [f for f in fill_pool if f not in avoid]
   362	            if not opts:
   363	                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
   364	            col = random.choice(opts)
   365	            for r, c in chunk:
   366	                grid[r, c] = col
   367	                grid[r, W - 1 - c] = col
   368	            prev_col = col
