   132	        if cells is None:
   133	            continue
   134	        rs = [r for r, c in cells]
   135	        cs = [c for r, c in cells]
   136	        if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:
   137	            return cells
