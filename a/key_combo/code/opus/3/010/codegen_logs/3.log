   176	def _gen_distribute(total: int, count: int, lo: int, hi: int) -> list[int] | None:
   177	    vals: list[int] = []
   178	    remaining = int(total)
   179	    for i in range(int(count)):
   180	        slots = int(count) - i - 1
   181	        a = max(int(lo), remaining - slots * int(hi))
   182	        b = min(int(hi), remaining - slots * int(lo))
   183	        if a > b:
   184	            return None
   185	        val = random.randint(a, b)
   186	        vals.append(val)
   187	        remaining -= val
   188	    return vals if remaining == 0 else None
   189	
