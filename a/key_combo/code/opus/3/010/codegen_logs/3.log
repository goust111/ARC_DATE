    11	def _unique_divider_color(g: np.ndarray, bg: int) -> int:
    12	    counts = Counter(map(int, g.ravel()))
    13	    foreground = [color for color in counts if color != bg]
    14	    assert foreground, "expected non-background divider and legend colors"
    15	    max_count = max(counts[color] for color in foreground)
    16	    candidates = [color for color in foreground if counts[color] == max_count]
    17	    assert len(candidates) == 1, "expected a unique most common non-background divider color"
    18	    return int(candidates[0])
