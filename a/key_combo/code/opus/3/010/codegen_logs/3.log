   139	def _gen_sequence(
   140	    n: int,
   141	    colors: list[int],
   142	    *,
   143	    fixed: dict[int, int],
   144	    min_distinct: int,
   145	    avoid_adjacent: bool = True,
   146	) -> list[int] | None:
   147	    fixed = {int(k): int(v) for k, v in fixed.items()}
   148	    if any(k < 0 or k >= n for k in fixed):
   149	        return None
   150	
   151	    seq: list[int | None] = [None] * n
   152	
   153	    def rec(i: int) -> bool:
   154	        if i == n:
   155	            return len(set(int(v) for v in seq if v is not None)) >= int(min_distinct)
   156	
   157	        choices = [fixed[i]] if i in fixed else list(colors)
   158	        random.shuffle(choices)
   159	        for val in choices:
   160	            val = int(val)
   161	            if avoid_adjacent and i > 0 and seq[i - 1] == val:
   162	                continue
   163	            if avoid_adjacent and i + 1 in fixed and fixed[i + 1] == val:
   164	                continue
   165	            seq[i] = val
   166	            if rec(i + 1):
   167	                return True
   168	            seq[i] = None
   169	        return False
   170	
   171	    if rec(0):
   172	        return [int(v) for v in seq if v is not None]
   173	    return None
