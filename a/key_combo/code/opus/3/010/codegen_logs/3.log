   417	def _make_output() -> tuple[np.ndarray | None, int, set[int]]:
   418	    """Select dims, build abstract output, then remap to real ARC colors."""
   419	    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
   420	    out, abstract_fcs = _build_output(H, W)
   421	    if out is None:
   422	        return None, 0, set()
   423	    bg = random.randint(0, 9)
   424	    abstract = sorted(np.unique(out))
   425	    available = [c for c in range(10) if c != bg]
   426	    random.shuffle(available)
   427	    if len(available) < len(abstract):
   428	        return None, 0, set()
   429	    cmap = {int(a): available[i] for i, a in enumerate(abstract)}
   430	    real_fcs = {cmap[a] for a in abstract_fcs}
   431	    return np.vectorize(lambda x: cmap[int(x)])(out), bg, real_fcs
