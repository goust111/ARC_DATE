   144	def _paint_data_region(grid: np.ndarray, data_rs: slice, data_cs: slice, data_color: int) -> None:
   145	    """Place data-color pixels in all quadrants while avoiding the outer data corner."""
   146	    data_h = data_rs.stop - data_rs.start
   147	    data_w = data_cs.stop - data_cs.start
   148	    half_h = data_h // QUADRANT_AXIS_COUNT
   149	    half_w = data_w // QUADRANT_AXIS_COUNT
   150	    outer_r = 0 if data_rs.start == 0 else data_h - 1
   151	    outer_c = 0 if data_cs.start == 0 else data_w - 1
   152	    forbidden_corner_cell = (outer_r, outer_c)
   153	    quadrant_counts = _gen_quadrant_counts(data_h * data_w)
   154	    for q_index, (qr, qc) in enumerate(QUADRANT_POSITIONS):
   155	        r0 = qr * half_h
   156	        c0 = qc * half_w
   157	        cells = [(r0 + dr, c0 + dc) for dr in range(half_h) for dc in range(half_w)]
   158	        if forbidden_corner_cell in cells:
   159	            cells.remove(forbidden_corner_cell)
   160	        for rr, cc in random.sample(cells, quadrant_counts[q_index]):
   161	            grid[data_rs.start + rr, data_cs.start + cc] = data_color
