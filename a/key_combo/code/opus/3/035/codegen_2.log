import random, numpy as np
from importlib.machinery import SourceFileLoader
mod = SourceFileLoader('arc_utils_tmp9', '/home/lixinyu/snap/new/solvers/arc_utils.py').load_module()
Color=mod.Color
DIRS={Color.GREEN:'left',Color.YELLOW:'down',Color.PINK:'up',Color.TEAL:'right'}

def place_ok(H,W,pl):
    occ=np.zeros((H,W),bool)
    for r0,c0 in pl.values():
        if r0<0 or c0<0 or r0+3>H or c0+3>W: return False
        if occ[r0:r0+3,c0:c0+3].any(): return False
        occ[r0:r0+3,c0:c0+3]=True
    return True

def random_init(H,W,final_pl):
    items=list(final_pl.items())
    for _ in range(200):
        random.shuffle(items)
        pl={}
        for color,(fr,fc) in items:
            side=DIRS[color]
            opts=[]
            if side=='left':
                for c0 in range(2,W-4):
                    if c0"'!=fc:
                        opts.append((fr,c0))
            elif side=='"'right':
                for c0 in range(2,W-4):
                    if c0"'!=fc:
                        opts.append((fr,c0))
            elif side=='"'up':
                for r0 in range(2,H-4):
                    if r0"'!=fr:
                        opts.append((r0,fc))
            else:
                for r0 in range(2,H-4):
                    if r0!=fr:
                        opts.append((r0,fc))
            random.shuffle(opts)
            chosen=None
            for p in opts:
                test=pl|{color:p}
                if place_ok(H,W,test):
                    chosen=p; break
            if chosen is None:
