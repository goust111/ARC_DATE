def _plus_cells(shape: tuple[int, int], row: int, col: int) -> list[tuple[int, int]]:
    height, width = map(int, shape)
    cells: list[tuple[int, int]] = []
    for dr, dc in [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)]:
        r = int(row) + dr
        c = int(col) + dc
        if 0 <= r < height and 0 <= c < width:
            cells.append((r, c))
    return cells


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete each yellow-marked plus motif by recoloring its grey cells red.

    Input structure
    - The grid contains black empty cells plus grey and yellow foreground cells.
    - Each 8-connected yellow object is a subset of one clipped five-cell plus
      made from yellow and grey cells.

    Rule
    - For every 8-connected yellow object, find the unique plus center whose
      in-bounds center/up/down/left/right cells contain the yellow object and no
      black cells.
    - Recolor the grey cells of that plus red; keep yellow and black cells fixed.

    Key insight
    - The yellow pixels are partial cross markers, and the surrounding grey cells
      in the same cross are the missing cells to highlight.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)
    assert height > 0 and width > 0, "expected a nonempty grid"

    empty = Color.BLACK
    marker = Color.YELLOW
    grey = Color.GREY
    red = Color.RED
    assert set(map(int, np.unique(g))) <= {empty, marker, grey}, "expected only black, yellow, and grey input colors"

    out = g.copy()
    yellow_objects = components_mask(g == marker, connectivity=8)
    assert yellow_objects, "expected at least one yellow marker object"

    for coords in yellow_objects:
        component = {tuple(map(int, coord)) for coord in coords}
        r0, c0, r1, c1 = bbox_coords(coords)
        candidates: list[list[tuple[int, int]]] = []
        for row in range(max(0, r0 - 1), min(height, r1 + 2)):
            for col in range(max(0, c0 - 1), min(width, c1 + 2)):
                cells = _plus_cells(g.shape, row, col)
                cell_set = set(cells)
                if not component <= cell_set:
                    continue
                values = [int(g[r, c]) for r, c in cells]
                if all(value in {marker, grey} for value in values) and grey in values:
                    candidates.append(cells)

        assert len(candidates) == 1, "expected each yellow object to imply one plus motif"
        for r, c in candidates[0]:
            if g[r, c] == grey:
                out[r, c] = red

    return out

# --------------- generator (o5x) ---------------

# Canvas and retry bounds; ranges use numpy's upper-exclusive integers.
GRID_HEIGHT_RANGE = (14, 20)
GRID_WIDTH_RANGE = (15, 20)
MOTIF_COUNT_RANGE = (4, 8)
GEN_RETRY_LIMIT = 300

# Motif geometry and yellow-subset constraints.
MIN_CENTER_DISTANCE = 6
EDGE_CENTER_PROBABILITY = 0.25
YELLOW_COUNT_RANGE = (2, 4)
YELLOW_CONNECTIVITY = 8

# Background noise and post-render density guard.
GREY_PROBABILITY_RANGE = (0.45, 0.50)
GREY_DENSITY_RANGE = (0.40, 0.55)

# ARC colors used by the generator.
GEN_BLACK = Color.BLACK
GEN_RED = Color.RED
GEN_YELLOW = Color.YELLOW
GEN_GREY = Color.GREY

Shape = tuple[int, int]
Cell = tuple[int, int]
CellList = list[Cell]
Motif = tuple[CellList, CellList]
MotifChoice = tuple[CellList, CellList, CellList]
MotifPlan = tuple[list[Motif], CellList, list[CellList]]
Rng = np.random.Generator


def _gen_is_edge(row: int, col: int, height: int, width: int) -> bool:
    return row in {0, height - 1} or col in {0, width - 1}


def _gen_is_yellow_connected(shape: Shape, cells: CellList) -> bool:
    mask = np.zeros(shape, dtype=bool)
    rows, cols = zip(*cells)
    mask[rows, cols] = True
    return len(components_mask(mask, connectivity=YELLOW_CONNECTIVITY)) == 1


def _gen_pattern_blockers(shape: Shape, center: Cell, yellow_cells: CellList, rng: Rng) -> CellList | None:
    height, width = shape
    yellow_set = set(yellow_cells)
    true_set = set(_plus_cells(shape, center[0], center[1]))
    blockers: list[tuple[int, int]] = []

    for row in range(height):
        for col in range(width):
            if (row, col) == center:
                continue
            cells = _plus_cells(shape, row, col)
            if not yellow_set <= set(cells):
                continue
            options = [cell for cell in cells if cell not in true_set]
            if not options:
                return None
            blockers.append(options[int(rng.integers(len(options)))])
    return blockers


def _gen_choose_motif(shape: Shape, center: Cell, rng: Rng) -> MotifChoice | None:
    cells = _plus_cells(shape, center[0], center[1])
    choices: list[MotifChoice] = []
    min_yellow, max_yellow = YELLOW_COUNT_RANGE

    for bits in range(1, 1 << len(cells)):
        yellow_cells = [cells[i] for i in range(len(cells)) if bits & (1 << i)]
        yellow_count = len(yellow_cells)
        if not min_yellow <= yellow_count <= max_yellow or yellow_count == len(cells):
            continue
        if not _gen_is_yellow_connected(shape, yellow_cells):
            continue
        blockers = _gen_pattern_blockers(shape, center, yellow_cells, rng)
        if blockers is None:
            continue
        yellow_set = set(yellow_cells)
        grey_cells = [cell for cell in cells if cell not in yellow_set]
        choices.append((yellow_cells, grey_cells, blockers))

    if not choices:
        return None
    return choices[int(rng.integers(len(choices)))]


def _gen_extend_centers(candidates: CellList, chosen: CellList, count: int, start: int) -> CellList | None:
    if len(chosen) == count:
        return chosen

    remaining = count - len(chosen)
    for idx in range(start, len(candidates)):
        row, col = candidates[idx]
        if any(abs(row - r) + abs(col - c) < MIN_CENTER_DISTANCE for r, c in chosen):
            continue
        if len(candidates) - idx < remaining:
            return None
        result = _gen_extend_centers(candidates, chosen + [(row, col)], count, idx + 1)
        if result is not None:
            return result
    return None


def _gen_pick_centers(height: int, width: int, count: int, rng: Rng) -> CellList | None:
    use_edge = bool(rng.random() < EDGE_CENTER_PROBABILITY)
    interiors = [
        (row, col)
        for row in range(1, height - 1)
        for col in range(1, width - 1)
    ]
    edges = [
        (row, col)
        for row in range(height)
        for col in range(width)
        if _gen_is_edge(row, col, height, width)
    ]
    rng.shuffle(interiors)
    rng.shuffle(edges)

    if not use_edge:
        return _gen_extend_centers(interiors, [], count, 0)

    for edge in edges:
        remaining = [
            point
            for point in interiors
            if abs(point[0] - edge[0]) + abs(point[1] - edge[1]) >= MIN_CENTER_DISTANCE
        ]
        result = _gen_extend_centers(remaining, [edge], count, 0)
        if result is not None:
            return result
    return None


def _gen_build_motif_plan(shape: Shape, centers: CellList, rng: Rng) -> MotifPlan | None:
    """Select motif colors and blocker pixels for the already-chosen centers."""
    motifs: list[Motif] = []
    all_blockers: CellList = []
    grey_cells_by_motif: list[CellList] = []
    for center in centers:
        motif = _gen_choose_motif(shape, center, rng)
        if motif is None:
            return None
        yellow_cells, grey_cells, blockers = motif
        motifs.append((yellow_cells, grey_cells))
import numpy as np

from arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste
import random


def _center(obj: dict, axis: int) -> float:
    r0, c0, r1, c1 = obj["bbox"]
    return ((r0 + r1) / 2, (c0 + c1) / 2)[axis]


def _span(obj: dict, axis: int) -> int:
    return bbox_h(obj["bbox"]) if axis == 0 else bbox_w(obj["bbox"])


def _is_solid_rectangle(g: np.ndarray, obj: dict) -> bool:
    r0, c0, r1, c1 = obj["bbox"]
    color = int(obj["color"])
    return (
        int(obj["area"]) == (r1 - r0 + 1) * (c1 - c0 + 1)
        and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color)
    )


def main(grid: np.ndarray) -> np.ndarray:
    """
    Push the central solid rectangle to the grid edge, splitting the perpendicular target rectangle around its path.

    Input structure
    - The background is the dominant color.
    - There are exactly three monochrome foreground objects arranged on one
      horizontal or vertical axis.
    - The middle object on that axis is a solid rectangular moving object.
    - One end object is a solid rectangle or bar whose long side is perpendicular
      to the movement axis; this is the target to split.

    Rule
    - Move the middle rectangle along the axis toward the target until it is
      flush with the grid edge in that direction.
    - Clear the original middle rectangle and the original target.
    - Split the target through the moving rectangle's two-cell-wide path and
      shift the two halves one cell outward perpendicular to the movement.
    - Keep the other end object unchanged.

    Key insight
    - The non-target end object acts as a pusher; the central rectangle travels
      away from it through the perpendicular target, opening a matching gap.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    H, W = g.shape

    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
    assert len(objects) == 3, "expected exactly three foreground objects"

    row_centers = [_center(obj, 0) for obj in objects]
    col_centers = [_center(obj, 1) for obj in objects]
    row_spread = max(row_centers) - min(row_centers)
    col_spread = max(col_centers) - min(col_centers)
    assert min(row_spread, col_spread) <= 0.5, "objects must share a row or column axis"
    axis = 0 if col_spread <= 0.5 else 1
    perp = 1 - axis

    ordered = sorted(objects, key=lambda obj: _center(obj, axis))
    axis_centers = [_center(obj, axis) for obj in ordered]
    assert axis_centers[0] < axis_centers[1] < axis_centers[2], "expected a unique middle object"

    source = ordered[1]
    end_objects = [ordered[0], ordered[2]]
    assert _is_solid_rectangle(g, source), "moving object must be a solid rectangle"

    target_candidates = [
        obj
        for obj in end_objects
        if _is_solid_rectangle(g, obj) and _span(obj, perp) > _span(obj, axis)
    ]
    assert len(target_candidates) == 1, "expected one perpendicular solid target"
    target = target_candidates[0]

    direction = -1 if _center(target, axis) < _center(source, axis) else 1

    sr0, sc0, sr1, sc1 = source["bbox"]
    tr0, tc0, tr1, tc1 = target["bbox"]
    source_lo = [sr0, sc0]
    source_hi = [sr1, sc1]
    target_lo = [tr0, tc0]
    target_hi = [tr1, tc1]

    source_perp_len = source_hi[perp] - source_lo[perp] + 1
    assert source_perp_len == 2, "moving object path must be two cells wide"
    assert target_lo[perp] <= source_lo[perp] <= source_hi[perp] <= target_hi[perp]
    assert (
        source_lo[perp] - target_lo[perp] == target_hi[perp] - source_hi[perp]
    ), "moving object must be centered across the target"

    out = g.copy()
    for r, c in source["coords"]:
        out[int(r), int(c)] = bg
    for r, c in target["coords"]:
        out[int(r), int(c)] = bg

    shift = source_perp_len // 2
    for r, c in target["coords"]:
        new_rc = [int(r), int(c)]
        if new_rc[perp] <= source_lo[perp]:
            new_rc[perp] -= shift
        else:
            assert new_rc[perp] >= source_hi[perp]
            new_rc[perp] += shift
        assert 0 <= new_rc[0] < H and 0 <= new_rc[1] < W, "shifted target must stay in bounds"
        out[new_rc[0], new_rc[1]] = int(target["color"])

    source_patch = crop_bbox(g, source["bbox"])
    if axis == 0:
        new_r = 0 if direction < 0 else H - source_patch.shape[0]
        new_c = source_lo[1]
    else:
        new_r = source_lo[0]
        new_c = 0 if direction < 0 else W - source_patch.shape[1]
    dest = out[new_r : new_r + source_patch.shape[0], new_c : new_c + source_patch.shape[1]]
    assert np.all(dest == bg), "moving object destination must be clear"
    paste(out, source_patch, new_r, new_c)
    return out

# --------------- generator (att2) ---------------

GEN_GRID_SIZE = 10
GEN_BG = 7
GEN_FG_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
GEN_SOURCE_PERP = 2
GEN_SOURCE_ALONG_CHOICES = [2, 3]
GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX = 1, 4
GEN_TARGET_OVERHANG_CHOICES = (1, 2)
GEN_SOURCE_TARGET_GAP_RANGE = range(5)
GEN_OTHER_WIDTH_CHOICES = (2, 4, 6)
GEN_OTHER_MIN_STAIR_WIDTH = 4
GEN_OTHER_MIN_STAIR_HEIGHT = 2
GEN_ORIENTATION_COUNT, GEN_RETRY_LIMIT = 4, 300


def _gen_transform(grid: np.ndarray, orientation: int) -> np.ndarray:
    if orientation == 0:
        return grid.copy()
    if orientation == 1:
        return np.flipud(grid).copy()
    if orientation == 2:
        return np.rot90(grid, 1).copy()
    return np.rot90(grid, -1).copy()


def _gen_even_centered_start(center_left: int, width: int) -> int:
    return center_left - (width // 2 - 1)


def _gen_stair_patch(h: int, w: int, color: int, bg: int) -> np.ndarray:
    patch = np.full((h, w), bg, dtype=int)
    max_extra = w // 2 - 1
    thresholds = sorted(random.randint(1, h - 1) for _ in range(max_extra))
    for r in range(h):
        extra = sum(r >= threshold for threshold in thresholds)
        c0 = w // 2 - 1 - extra
        c1 = w // 2 + extra
        patch[r, c0 : c1 + 1] = color
    return patch


def _gen_place_other(grid: np.ndarray, r0: int, center_left: int, color: int, bg: int) -> None:
    h = grid.shape[0] - r0
    in_bounds_widths = [
        w
        for w in GEN_OTHER_WIDTH_CHOICES
        if 0 <= _gen_even_centered_start(center_left, w)
        and _gen_even_centered_start(center_left, w) + w <= grid.shape[1]
    ]
    solid_widths = [w for w in in_bounds_widths if w <= h]
    stair_widths = [w for w in in_bounds_widths if w >= GEN_OTHER_MIN_STAIR_WIDTH and h >= GEN_OTHER_MIN_STAIR_HEIGHT]

    kinds = []
    if solid_widths:
        kinds.append("solid")
    if stair_widths:
        kinds.append("stair")
    kind = random.choice(kinds)

    if kind == "solid":
        w = random.choice(solid_widths)
        patch = np.full((h, w), color, dtype=int)
    else:
        w = random.choice(stair_widths)
        patch = _gen_stair_patch(h, w, color, bg)
    paste(grid, patch, r0, _gen_even_centered_start(center_left, w), transparent=bg)


def _gen_choose_layout() -> tuple[int, int, int, int, int, int] | None:
    s_h = random.choice(GEN_SOURCE_ALONG_CHOICES)
    t_h = random.randint(GEN_TARGET_ALONG_MIN, GEN_TARGET_ALONG_MAX)
    overhangs = [k for k in GEN_TARGET_OVERHANG_CHOICES if 2 * k + GEN_SOURCE_PERP > t_h]
    k = random.choice(overhangs)
    gap_options = [g for g in GEN_SOURCE_TARGET_GAP_RANGE if t_h + g + s_h <= GEN_GRID_SIZE - GEN_SOURCE_PERP]
    if not gap_options:
        return None
    gap = random.choice(gap_options)
    t0_max = GEN_GRID_SIZE - GEN_SOURCE_PERP - t_h - gap - s_h
    t0 = random.randint(0, t0_max)
    center_left = random.randint(k + 1, GEN_GRID_SIZE - k - 3)
    return s_h, t_h, k, gap, t0, center_left


def _gen_canonical_pair(s_h: int, t_h: int, k: int, gap: int, t0: int, center_left: int, colors: list[int]) -> tuple[np.ndarray, np.ndarray]:
    source_color, target_color, other_color = colors
    source_patch = np.full((s_h, GEN_SOURCE_PERP), source_color, dtype=int)
    target_patch = np.full((t_h, 2 * k + GEN_SOURCE_PERP), target_color, dtype=int)
    split_half = np.full((t_h, k + 1), target_color, dtype=int)

    out = np.full((GEN_GRID_SIZE, GEN_GRID_SIZE), GEN_BG, dtype=int)
    paste(out, source_patch, 0, center_left)
    paste(out, split_half, t0, center_left - k - 1)
    paste(out, split_half, t0, center_left + GEN_SOURCE_PERP)

    source_in_r = t0 + t_h + gap

