+    return boxes
+
+
+def _move_box_to_edge(box: dict, shape: tuple[int, int]) -> dict:
+    height, width = map(int, shape)
+    color = int(box["color"])
+    r0 = int(box["r0"])
+    c0 = int(box["c0"])
+    edge = EDGE_BY_COLOR[color]
