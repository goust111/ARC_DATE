def _plus_cells(shape: tuple[int, int], row: int, col: int) -> list[tuple[int, int]]:
    height, width = map(int, shape)
    cells: list[tuple[int, int]] = []
    for dr, dc in [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)]:
        r = int(row) + dr
