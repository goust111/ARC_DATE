from importlib.machinery import SourceFileLoader
import numpy as np, hashlib
arc = SourceFileLoader('arc','/home/lixinyu/snap/new/solvers/arc_utils.py').load_module()
Color = arc.Color
components_mask = arc.components_mask

GT = {
    5: np.array([
        [0,0,0,0,0],
        [5,0,5,5,5],
        [5,5,0,0,0],
        [5,0,0,5,5],
        [5,0,0,5,0],
    ], dtype=int),
    6: np.array([
        [0,5,5,5,5,5],
        [0,5,0,0,0,0],
        [0,5,5,5,0,0],
        [0,5,0,0,0,0],
        [0,5,0,5,5,5],
        [0,5,0,0,5,0],
    ], dtype=int),
    7: np.array([
        [0,0,0,0,0,0,0],
        [0,5,0,0,0,0,0],
        [0,5,0,0,0,5,5],
        [0,5,0,0,0,5,0],
        [0,5,0,0,0,5,0],
        [0,5,5,5,5,5,5],
        [0,5,0,0,0,5,0],
    ], dtype=int),
}

def pinwheel(g):
    return np.block([[g,np.rot90(g,-1)],[np.rot90(g,1),np.rot90(g,2)]])

def comps(g):
    return components_mask(g "'!= Color.GREY, connectivity=4)

def lt(n):
    g=np.zeros((n,n),int)
    g[:,1]=5
    mid=n//2
    g[mid:,n-2]=5
    g[min(mid+1,n-2),n-2:]=5
    return g

def d4(g, code):
    k = code % 4
    out=np.rot90(g,k)
    if code >= 4:
        out=np.fliplr(out)
    return out.copy()

def ok(base):
    src=len(comps(base))
    mg=pinwheel(base)
    outc=comps(mg)
    areas=sorted(len(c) for c in outc)
    uniq=len(areas)>=2 and areas[0] < areas[1] and areas[-2] < areas[-1]
    return 3<=src<=5 and len(outc)!=src and uniq

def gen():
    for _ in range(500):
        n=np.random.randint(5,8)
        branch=np.random.choice(['"'lt','gt'])
        base=lt(n) if branch=='lt' else GT[n].copy()
        base=d4(base, int(np.random.randint(8)))
        if not ok(base):
            continue
        comps_in=comps(base)
        blue_comp=comps_in[int(np.random.randint(len(comps_in)))]
        idx=int(np.random.randint(len(blue_comp)))
        r,c = map(int, blue_comp[idx])
        grid=base.copy(); grid[r,c]=1
        if ok(grid):
            return grid
    raise RuntimeError

def main(grid):
    g=np.asarray(grid,int)
    out=pinwheel(g)
    cs=comps(out)
    areas=np.array([len(c) for c in cs])
    mx=int(np.argmax(areas)); mn=int(np.argmin(areas))
    res=out.copy()
    for idx,col in [(mx,8),(mn,7)]:
        coords=cs[idx]
        res[coords[:,0], coords[:,1]] = col
    res[out==1]=1
    return res

s=set(); branches={'lt':0,'gt':0}
for i in range(100):
    inp=gen(); out=main(inp)
    s.add(hashlib.md5(inp.tobytes()+str(inp.shape).encode()).hexdigest())
    base=inp.copy(); base[base==1]=0
    if len(comps(pinwheel(base))) < len(comps(base)): branches['lt']+=1
    else: branches['gt']+=1
    assert inp.ndim==out.ndim==2 and max(inp.shape)<=30 and max(out.shape)<=30
print('variants',len(s),'branches',branches)
