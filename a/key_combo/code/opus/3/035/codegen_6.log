        chosen[r, g] = True
        area += group_sizes[g]

    mask = np.zeros((height, width), dtype=bool)
    for g in range(group_count):
        rows = chosen[:, g]
        mask[rows, g] = True
        mask[rows, width - 1 - g] = True
    return mask

