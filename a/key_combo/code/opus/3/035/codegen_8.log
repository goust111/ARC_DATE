+    RNG.shuffle(steps)
+    path = [(r, c)]
+    for step in steps:
+        if step == 0:
+            r += dr
+        else:
+            c += dc
+        path.append((r, c))
+    return path
+
+
+def _make_object_mask(height: int, width: int) -> np.ndarray:
+    for _ in range(200):
+        anchors = [
+            (0, int(RNG.integers(0, width))),
