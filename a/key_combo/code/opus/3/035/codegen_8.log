+    if len(objects) != count:
+        return None
+    if [obj["center_col"] for obj in objects] != centers:
+        return None
+    if any(obj["bbox"][2] >= height // 2 for obj in objects):
+        return None
+    if np.any(grid[height // 2 :, :] != BG):
+        return None
+
+    depths = _seed_depths(centers)
+    if min(depths) < 3 or max(depths) > 8:
+        return None
+
+    out = main(grid)
