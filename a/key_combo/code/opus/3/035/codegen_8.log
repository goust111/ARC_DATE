+def _sample_centers(width: int, count: int) -> list[int] | None:
+    for _ in range(200):
+        gaps = [int(x) for x in RNG.integers(3, 7, size=count - 1)]
+        if len(set(gaps)) == 1 and RNG.random() < 0.7:
+            continue
