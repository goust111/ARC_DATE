+        color = values.pop()
+        bbox = _bbox_coords(coords)
+        center_col = bbox[1] + (bbox[3] - bbox[1]) // 2
+        objects.append(
+            {
+                "coords": coords,
+                "color": int(color),
+                "bbox": bbox,
+                "center_col": int(center_col),
+            }
+        )
+    objects.sort(key=lambda obj: obj["center_col"])
