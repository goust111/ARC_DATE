+        rows, cols = zip(*cells)
+        mask[rows, cols] = True
+        if not mask[0].any() or not mask[-1].any() or not mask[:, 0].any() or not mask[:, -1].any():
+            continue
+        if not (4 <= int(mask.sum()) <= 10):
+            continue
+        return mask
+    raise RuntimeError("failed to build a connected object mask")
