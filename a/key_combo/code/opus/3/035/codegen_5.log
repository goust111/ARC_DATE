+    motifs: list[dict[str, object]] = []
+    used_centers: list[tuple[int, int]] = []
+
+    for _ in range(topo_count):
+        motif = _try_place_topological_plus(rng, grid, rows, cols, used_centers)
+        if motif is None:
+            return None
+        motifs.append(motif)
+        used_centers.append(tuple(motif["center"]))
