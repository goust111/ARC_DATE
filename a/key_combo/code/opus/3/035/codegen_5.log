+
+def _try_place_topological_plus(
+    rng: random.Random,
+    grid: np.ndarray,
+    rows: list[int],
+    cols: list[int],
+    used_centers: list[tuple[int, int]],
+) -> dict[str, object] | None:
+    height, width = map(int, grid.shape)
