+    remaining = set(cells)
+    stack = [cells[0]]
+    seen = {cells[0]}
+    while stack:
+        row, col = stack.pop()
+        for other in list(remaining - seen):
+            if max(abs(row - other[0]), abs(col - other[1])) <= 1:
