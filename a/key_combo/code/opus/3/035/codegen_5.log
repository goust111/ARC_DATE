    return [(r+dr,c+dc) for dr,dc in PLUS_DELTAS]

def detect(grid):
    H,W=grid.shape
    comps=components_mask(grid==YELLOW, connectivity=8)
    centers=[]
    cross_cells=[]
    for coords in comps:
        comp={tuple(map(int,x)) for x in coords}
        cand=[]
        r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
        for r in range(max(1,int(r0)-1), min(H-1,int(r1)+2)):
            for c in range(max(1,int(c0)-1), min(W-1,int(c1)+2)):
                cells=plus_cells((r,c))
                cellset=set(cells)
                if comp <= cellset and {int(grid[rr,cc]) for rr,cc in cells} <= {GREY,YELLOW} and {p for p in cellset if grid[p]==YELLOW}==comp:
                    cand.append((r,c))
        if len(cand)"'!=1:
            return None
        centers.append(cand[0]); cross_cells.append(set(plus_cells(cand[0])))
    return centers,cross_cells

def main(grid):
    grid=np.array(grid)
    det=detect(grid)
    assert det is not None
    centers,crosses=det
    out=grid.copy()
    allcross=set()
    for cells in crosses:
        allcross |= cells
        for r,c in cells:
            if out[r,c]==GREY:
                out[r,c]=RED
    comps=components_mask(out==BLACK, connectivity=4)
    for coords in comps:
        marked=False
        for r,c in coords:
            for rr,cc in neighbors4(int(r),int(c)):
                if 0<=rr<out.shape[0] and 0<=cc<out.shape[1] and (rr,cc) in allcross:
                    marked=True; break
            if marked: break
        if marked:
            out[coords[:,0],coords[:,1]] = ORANGE
    return out

def black_cc_count(grid):
    return len(components_mask(grid==BLACK, connectivity=4))

def wall_connected(grid):
    comps=components_mask(grid==GREY, connectivity=4)
    return len(comps)==1

def pick_spaced(vals,k,min_gap):
    vals=list(vals)
    random.shuffle(vals)
    chosen=[]
    for v in sorted(vals):
        pass
    # backtracking
    vals=sorted(vals)
    out=[]
    def bt(start):
        if len(out)==k:
            return True
        remain=k-len(out)
        for i in range(start, len(vals)):
            v=vals[i]
            if out and v-out[-1]<min_gap: continue
            out.append(v)
            if bt(i+1): return True
            out.pop()
        return False
    for _ in range(50):
        random.shuffle(vals)
        vals2=sorted(vals)
        out=[]
        def bt2(start):
            if len(out)==k: return True
            idxs=list(range(start,len(vals2)))
            random.shuffle(idxs)
            for i in idxs:
                v=vals2[i]
                if out and v-out[-1]<min_gap: continue
                out.append(v)
                if bt2(i+1): return True
                out.pop()
            return False
        if bt2(0): return sorted(out)
    return None


