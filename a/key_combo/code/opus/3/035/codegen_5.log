+from arc_utils import Color, components_mask
+
+
+BLACK = Color.BLACK
+RED = Color.RED
+YELLOW = Color.YELLOW
+GREY = Color.GREY
+ORANGE = Color.ORANGE
+PLUS_DELTAS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+
+GEN_RETRIES = 400
