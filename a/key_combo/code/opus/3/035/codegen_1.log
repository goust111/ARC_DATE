+        for dr in range(hole_h):
+            for dc in range(hole_w):
+                rr = r0 + dr
+                cc = c0 + dc
+                local_holes.extend(
+                    [
+                        (rr, cc),
+                        (height - 1 - rr, cc),
+                        (rr, width - 1 - cc),
+                        (height - 1 - rr, width - 1 - cc),
+                    ]
+                )
+        for rr, cc in local_holes:
+            mask[rr, cc] = False
+
+    components = _components(mask)
+    if len(components) != 1:
