+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    mask = np.zeros((max(rows) + 1, max(cols) + 1), dtype=bool)
+    for r, c in shape:
+        mask[r, c] = True
+    return mask
+
+
