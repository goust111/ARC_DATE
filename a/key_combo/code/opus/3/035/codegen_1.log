+        arr = coords.astype(int, copy=True)
+    else:
+        arr = np.array(sorted(coords), dtype=int)
+    if arr.size == 0:
+        return tuple()
+    arr -= arr.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in arr))
