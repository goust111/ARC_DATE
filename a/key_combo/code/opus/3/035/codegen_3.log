+    runs: list[tuple[int, int]] = []
+    start = int(values[0])
+    prev = int(values[0])
+    for raw in values[1:]:
+        value = int(raw)
+        if value == prev + 1:
+            prev = value
+            continue
+        runs.append((start, prev))
+        start = prev = value
+    runs.append((start, prev))
+    return runs
