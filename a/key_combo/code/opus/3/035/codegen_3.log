+        if coords.size == 0:
+            continue
+        r0, c0, r1, c1 = bbox_coords(coords)
+        span = max(int(r1 - r0), int(c1 - c0))
+        hints.append(
+            {
+                "coords": {(int(r), int(c)) for r, c in coords},
+                "span": max(1, span),
+            }
+        )
+    return hints
