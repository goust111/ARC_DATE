+    if side == "top":
+        for step in range(length + 1):
+            col = start + step if orient == 0 else start + length - 1 - step
+            coords.append((r0 - 1 - step, col))
+        return coords
+    if side == "bottom":
+        for step in range(length + 1):
+            col = start + step if orient == 0 else start + length - 1 - step
+            coords.append((r1 + 1 + step, col))
+        return coords
+    if side == "left":
+        for step in range(length + 1):
