+
+def _diagonal_hint_mask(mask: np.ndarray) -> np.ndarray:
+    diag = np.zeros_like(mask, dtype=bool)
+    for row, col in np.argwhere(mask):
+        row = int(row)
+        col = int(col)
+        if _orth_degree(mask, row, col) == 0 and _has_diagonal_neighbor(mask, row, col):
+            diag[row, col] = True
+    return diag
