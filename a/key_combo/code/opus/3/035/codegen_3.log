+def _boxes_too_close(a: Frame, b: Frame, pad: int) -> bool:
+    return not (
+        a[2] + pad < b[0] - pad
+        or b[2] + pad < a[0] - pad
+        or a[3] + pad < b[1] - pad
+        or b[3] + pad < a[1] - pad
+    )
