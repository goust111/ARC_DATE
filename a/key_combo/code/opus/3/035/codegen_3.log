+    local = np.zeros((height, width), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = np.zeros_like(local, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    if not np.array_equal(local, border):
