    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is None:
            continue
        expected = _gen_expected_output(grid)
        if np.array_equal(main(grid), expected):
            return grid
    raise RuntimeError("failed to generate a valid 62c24649 input")

