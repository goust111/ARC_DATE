+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _connected_components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _extract_objects(grid: np.ndarray, body_color: int, side: str) -> list[dict]:
+    h, w = grid.shape
+    objects = []
+    for coords in _connected_components_of_color(grid, body_color):
+        bbox = _bbox_coords(coords)
+        r0, c0, r1, c1 = bbox
