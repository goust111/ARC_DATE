+    return objects
+
+
+def _analyze_scene(grid: np.ndarray) -> tuple[list[dict], list[dict], list[tuple[int, int]]]:
+    blues = _extract_objects(grid, BLUE, "right")
+    greens = _extract_objects(grid, GREEN, "left")
