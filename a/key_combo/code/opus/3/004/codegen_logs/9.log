NON_BG_GRID_FRAC_RANGE = (0.27, 0.40)
CLUSTERED_NOISE_FRAC_RANGE = (0.70, 0.80)
MIN_CLUSTERED_NOISE_CELLS = 2
BLACK_NOISE_MIN_FRAC = 0.70

