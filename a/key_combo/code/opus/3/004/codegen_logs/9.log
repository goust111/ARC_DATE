+        splits.append(max(1, len(coords) // 7))
+    cursor = 0
+    for color, count in zip(alt_colors, splits):
+        block = coords[cursor : cursor + count]
+        cursor += count
+        for r, c in block:
+            patch[r, c] = int(color)
+    return patch
