+def _edge_rows(mask: np.ndarray, side: str) -> set[int]:
+    if side == "left":
+        return {int(r) for r in np.where(mask[:, 0])[0]}
+    if side == "right":
+        return {int(r) for r in np.where(mask[:, -1])[0]}
+    raise ValueError(f"bad side: {side}")
