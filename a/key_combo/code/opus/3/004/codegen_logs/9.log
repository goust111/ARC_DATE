+def _find_separator_row(grid: np.ndarray) -> int:
+    rows = [int(r) for r in range(grid.shape[0]) if bool((grid[r] == SEP).all())]
+    assert len(rows) == 1, "expected exactly one full gray separator row"
+    return rows[0]
