+
+def _placement_bits(mask: np.ndarray, r0: int, c0: int, width: int) -> int:
+    bits = 0
+    for r, c in _mask_coords(mask):
+        idx = (int(r0) + int(r)) * width + int(c0) + int(c)
+        bits |= 1 << idx
+    return bits
