GEN_BLACK, GEN_YELLOW, GEN_TRANSPARENT = 0, 4, -1

MARKER_COUNT_RANGE = (3, 7)  # marker count, spacing, and plus geometry.
MARKER_MIN_CHEB_DISTANCE = 5
MARKER_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
