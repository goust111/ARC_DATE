+        ok = True
+        for _idx in range(n):
+            placed = False
+            for _ in range(200):
+                r0 = random.randint(0, upper_h - SPRITE_SIZE)
+                c0 = random.randint(0, width - SPRITE_SIZE)
+                if any(_rectangles_overlap((r0, c0), prev) for prev in positions):
