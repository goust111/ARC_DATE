+def _manhattan_path(start: tuple[int, int], goal: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = map(int, start)
+    gr, gc = map(int, goal)
+    path = [(r, c)]
+    while (r, c) != (gr, gc):
+        moves = []
+        if r < gr:
+            moves.append((r + 1, c))
+        elif r > gr:
+            moves.append((r - 1, c))
+        if c < gc:
+            moves.append((r, c + 1))
+        elif c > gc:
+            moves.append((r, c - 1))
+        r, c = random.choice(moves)
+        path.append((int(r), int(c)))
+    return path
