+        for _r0, _c0, cand_bits in candidates[order[pos]]:
+            bits |= cand_bits
+        suffix_possible[pos] = suffix_possible[pos + 1] | bits
+
+    placements: list[tuple[int, int] | None] = [None] * len(sprite_masks)
+    solutions: list[list[tuple[int, int]]] = []
