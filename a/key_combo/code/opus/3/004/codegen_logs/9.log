+def _extract_sprites(upper: np.ndarray) -> list[dict]:
+    comps = find_components(
+        upper,
+        bg=BG,
+        connectivity=4,
+        monochromatic=False,
+        return_format="dict",
+    )
+    sprites = []
+    for comp in comps:
+        patch = _crop_component(upper, comp["bbox"])
