+    for r0 in range(h - sh + 1):
+        rr = coords[:, 0] + int(r0)
+        for c0 in range(w - sw + 1):
+            cc = coords[:, 1] + int(c0)
+            if bool(lower_mask[rr, cc].all()):
+                candidates.append((int(r0), int(c0), _placement_bits(sprite_mask, r0, c0, w)))
+    candidates.sort()
+    return candidates
