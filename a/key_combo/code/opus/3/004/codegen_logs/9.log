+    if 0 not in {left_row, right_row}:
+        for r in range(0, hub_r + 1):
+            mask[int(r), 2] = True
+    if SPRITE_SIZE - 1 not in {left_row, right_row}:
+        for r in range(hub_r, SPRITE_SIZE):
