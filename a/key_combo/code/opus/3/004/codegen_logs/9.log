+def _sample_sprite_patches(n: int) -> list[np.ndarray] | None:
+    rows = random.sample(range(SPRITE_SIZE), SPRITE_SIZE)
+    link_rows = rows[: n - 1]
+    head_row = rows[n - 1]
+    tail_row = rows[n]
