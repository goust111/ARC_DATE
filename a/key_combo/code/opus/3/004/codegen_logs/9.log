+def _sample_placeholder_positions(masks: list[np.ndarray], lower_h: int, width: int) -> list[tuple[int, int]] | None:
+    n = len(masks)
+    pair = random.sample(range(n), 2)
+    a, b = pair
+    offsets = _possible_overlap_offsets(masks[a], masks[b])
+    if not offsets:
