+            count_ij = _mask_overlap_count(masks[i], placements[i], masks[j], placements[j])
+            if count_ij > 0:
+                overlaps.append((i, j, count_ij))
+    if not overlaps or any(count_ij > 4 for _i, _j, count_ij in overlaps):
+        return False
