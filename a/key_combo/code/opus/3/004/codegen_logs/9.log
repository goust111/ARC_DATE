+
+def _crop_component(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
