+def _rectangles_overlap(a: tuple[int, int], b: tuple[int, int], *, size: int = SPRITE_SIZE, gap: int = 1) -> bool:
+    ar, ac = a
+    br, bc = b
+    return not (
+        ar + size + gap <= br
+        or br + size + gap <= ar
+        or ac + size + gap <= bc
+        or bc + size + gap <= ac
