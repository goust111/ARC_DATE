+        for comp in _extract_sprites(upper):
+            sprites.append(comp["patch"])
+
+        # Rebuild generation metadata from the placed sprites' bboxes, sorted by chain order in the case builder.
+        # The semantic check below uses the original builder data instead, so regenerate it directly here.
+        # This keeps the public API small and leaves the oracle logic inside the generator.
+        n = len(_extract_legend_pairs(inp[_split_regions(inp)[0].shape[0] + 1 :, :]))
