+def _border_hole_free(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    stack = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not seen[r, c]:
+                stack.append((r, c))
+                seen[r, c] = True
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not seen[r, c]:
+                stack.append((r, c))
+                seen[r, c] = True
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
