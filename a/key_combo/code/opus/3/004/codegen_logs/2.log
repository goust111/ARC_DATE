+def _semantic_checks(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    sprites: list[np.ndarray],
+    positions: list[tuple[int, int]],
+    mappings: list[tuple[int, int]],
+) -> bool:
+    try:
+        actual = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+
+    upper, lower = _split_regions(inp)
