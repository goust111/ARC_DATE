+def _semantic_checks(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    sprites: list[np.ndarray],
+    positions: list[tuple[int, int]],
+    mappings: list[tuple[int, int]],
+) -> bool:
+    try:
+        actual = main(inp)
