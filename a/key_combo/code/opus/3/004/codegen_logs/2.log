+    mask[left_row, 0] = True
+    mask[left_row, 1] = True
+    r0, r1 = sorted((left_row, 2))
+    mask[r0 : r1 + 1, 1] = True
+
+    mask[right_row, 4] = True
+    mask[right_row, 3] = True
+    r0, r1 = sorted((right_row, 2))
+    mask[r0 : r1 + 1, 3] = True
