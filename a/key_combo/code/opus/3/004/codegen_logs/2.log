+        upper_h = UPPER_BASE_H + y_shift
+        x_shift = random.randint(0, width - max(c + SPRITE_SIZE for _r, c in BASE_SLOTS[n]))
+        positions = _pick_positions(n, width, y_shift, x_shift)
+
+        shared_source = random.choice(PALETTE)
