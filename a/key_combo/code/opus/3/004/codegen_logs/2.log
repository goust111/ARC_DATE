+def _colorize_mask(mask: np.ndarray, source_color: int, target_color: int) -> np.ndarray:
+    coords = [tuple(int(v) for v in coord) for coord in np.argwhere(mask)]
+    area = len(coords)
+    n_colors = random.choice((2, 3))
