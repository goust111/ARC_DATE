+    _ = get_bg(g)
+    upper, lower = _split_regions(g)
+    sprites = _extract_sprites(upper)
+    mappings = _extract_legend_pairs(lower)
+    assert sprites and len(sprites) == len(mappings), "sprite count must match legend count"
