+BG = 0
+SEP = 5
+SPRITE_SIZE = 5
+LEGEND_BLOCK = 3
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+# A literal 5-pair legend would need width 6*5 + 4 = 34, which exceeds ARC's 30-cell cap.
+N_CHOICES = (3, 4)
+WIDTH_CHOICES = {3: (22, 23, 24), 4: (28, 29, 30)}
