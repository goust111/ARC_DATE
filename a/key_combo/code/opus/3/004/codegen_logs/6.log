+
+    if np.array_equal(grid, expected):
+        return False
+
+    if not np.array_equal(grid[:, : divider_col + 1], expected[:, : divider_col + 1]):
+        return False
+
+    if len(set(ranked_colors)) != len(ranked_colors):
+        return False
+    return True
+
+
+def _attempt_case() -> np.ndarray | None:
