+
+def _small_frame_patch(max_area: int) -> np.ndarray | None:
+    for _ in range(80):
+        h = random.randint(4, 9)
+        w = random.randint(4, 10)
+        area = h * w
+        if area >= max_area:
+            continue
+        if area > max_area - 8:
+            continue
+        return np.full((h, w), FRAME_COLOR, dtype=int)
+    return None
+
+
+def _build_instance() -> tuple[np.ndarray, np.ndarray, dict] | None:
