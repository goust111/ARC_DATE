+
+def _build_shape_library() -> list[np.ndarray]:
+    shapes: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for raw in RAW_SHAPES:
+        mask = np.array(raw, dtype=bool)
+        if not (3 <= int(mask.sum()) <= 8):
+            continue
+        key = _canonical_key(mask)
+        if key in seen:
+            continue
+        seen.add(key)
+        shapes.append(mask)
+    return shapes
