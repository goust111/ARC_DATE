+def _extract_holes(crop: np.ndarray, *, bg: int = BG) -> list[dict]:
+    holes: list[dict] = []
+    for coords in components_mask(crop == int(bg), connectivity=4):
+        if coords.size == 0:
+            continue
+        if (
+            np.any(coords[:, 0] == 0)
+            or np.any(coords[:, 0] == crop.shape[0] - 1)
+            or np.any(coords[:, 1] == 0)
+            or np.any(coords[:, 1] == crop.shape[1] - 1)
