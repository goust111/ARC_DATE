+                "mask": mask,
+                "key": _canonical_key(mask),
+                "area": int(mask.sum()),
+            }
+        )
+    holes.sort(key=lambda hole: (hole["origin"][0], hole["origin"][1]))
+    return holes
+
+
+def _extract_sprites_outside(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    *,
+    bg: int = BG,
+    frame_color: int = FRAME_COLOR,
