+    for hole in holes:
+        patch = np.full(hole["mask"].shape, BG, dtype=int)
+        paste(crop, patch, hole["origin"][0], hole["origin"][1], mask=hole["mask"])
+    return crop
+
+
+def _render_expected_output(frame_h: int, frame_w: int, holes: list[dict], color_by_key: dict) -> np.ndarray:
