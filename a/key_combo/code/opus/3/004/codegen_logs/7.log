+
+def _pick_hole_bases(n_holes: int) -> list[np.ndarray]:
+    pair_areas = [area for area, shapes in SHAPES_BY_AREA.items() if len(shapes) >= 2]
+    assert pair_areas, "shape library must contain at least one same-area pair"
