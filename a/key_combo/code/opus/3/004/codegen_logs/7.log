+    r0, c0, r1, c1 = map(int, frame_bbox)
+    outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
+    sprites: list[dict] = []
+    comps = find_components(
+        outside,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
