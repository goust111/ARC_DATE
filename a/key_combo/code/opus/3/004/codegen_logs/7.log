+                "bbox": bbox,
+                "color": color,
+                "mask": mask,
+                "key": _canonical_key(mask),
+                "area": int(mask.sum()),
+            }
+        )
+    sprites.sort(key=lambda sprite: (sprite["bbox"][0], sprite["bbox"][1], sprite["color"]))
+    return sprites
