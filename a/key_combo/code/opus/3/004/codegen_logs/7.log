+def _semantic_checks(grid: np.ndarray, expected: np.ndarray, metadata: dict) -> bool:
+    if grid.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
