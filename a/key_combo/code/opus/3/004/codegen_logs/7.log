+        if not np.all(sub[-1, :] == int(frame_color)):
+            continue
+        if not np.all(sub[:, 0] == int(frame_color)):
+            continue
+        if not np.all(sub[:, -1] == int(frame_color)):
+            continue
+        item = dict(comp)
+        item["bbox"] = bbox
+        item["bbox_area"] = _bbox_area(bbox)
+        candidates.append(item)
+    return candidates
+
