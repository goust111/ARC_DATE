+
+def _find_frame_candidates(grid: np.ndarray, *, bg: int, frame_color: int = FRAME_COLOR) -> list[dict]:
+    candidates: list[dict] = []
+    comps = find_components(
+        grid,
+        bg=bg,
+        colors=[frame_color],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    for comp in comps:
+        bbox = tuple(map(int, comp["bbox"]))
+        sub = crop_bbox(grid, bbox)
