+                "mask": mask,
+                "key": _canonical_key(mask),
+                "area": int(mask.sum()),
+            }
+            for rr, cc in coords + np.array([r0, c0], dtype=int):
+                r_lo = max(0, int(rr) - 1)
+                r_hi = min(frame_h, int(rr) + 2)
+                c_lo = max(0, int(cc) - 1)
+                c_hi = min(frame_w, int(cc) + 2)
+                blocked[r_lo:r_hi, c_lo:c_hi] = True
