+        return None, np.zeros((0, 2), dtype=int)
+    region = grid[gr0 : gr1 + 1, gc0 : gc1 + 1]
+    if region.shape != (3, 3) or not np.all(np.isin(region, [BG, GLYPH])):
+        return None, np.zeros((0, 2), dtype=int)
+    rel = np.argwhere(region == GLYPH)
+    if rel.size == 0:
+        return None, np.zeros((0, 2), dtype=int)
+    return int(rel.shape[0]), rel + np.array([gr0, gc0])
