+
+def _sample_distractor_anchor(
+    grid_shape: tuple[int, int],
+    sprite_shape: tuple[int, int],
+    reserved_rects: list[tuple[int, int, int, int]],
+    blocked_bboxes: list[tuple[int, int, int, int]],
