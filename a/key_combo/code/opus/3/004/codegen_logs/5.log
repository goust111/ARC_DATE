+def _normalized_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0])
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
