+            rect = (r, c, r + sh - 1, c + sw - 1)
+            if any(_rects_overlap(rect, other, gap=1) for other in reserved_rects):
+                continue
+            if any(_rects_overlap(rect, other, gap=0) for other in blocked_bboxes):
+                continue
+            cands.append((int(r), int(c)))
