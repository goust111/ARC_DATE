+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return tuple(map(int, mask.shape)), mask.astype(np.uint8).tobytes()
+
+
+def _component_signature(comp: dict) -> tuple[tuple[int, int], bytes]:
