+
+def _cells_key(coords: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, rc)) for rc in coords}
+
+
+def _glyph_region(bbox: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
