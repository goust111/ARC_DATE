+        "teaching_idx": int(teaching_idx),
+        "change_band": int(change_band),
+        "unchanged_band": int(unchanged_band),
+        "left_colors": [int(v) for v in left_colors],
+        "right_colors": [int(v) for v in right_colors],
+        "gaps": gaps,
+        "mid_c": int(mid_c),
+        "middle_tiles": middle_tiles,
+    }
