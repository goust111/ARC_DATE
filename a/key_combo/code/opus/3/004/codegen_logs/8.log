+
+
+def _expected_output(inp: np.ndarray, middle_tiles: list[np.ndarray], mid_c: int, selected_a: int, selected_b: int) -> np.ndarray:
+    out = np.array(inp, copy=True)
+    for band_i, tile in enumerate(middle_tiles):
