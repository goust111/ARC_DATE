+
+        choice = rng.choice(choices)
+        got_clipping |= bool(choice["clipped"])
+
+        marker = choice["marker"]
+        inp[marker] = int(spec["color"])
+        input_occ.add(marker)
+        output_occ.add(marker)
+
+        for obstacle in choice["obstacles"]:
+            inp[obstacle] = OBSTACLE
