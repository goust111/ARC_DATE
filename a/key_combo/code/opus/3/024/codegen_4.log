+
+def _legend_starts(width: int, legends: list[tuple[int, ...]], rng: random.Random) -> list[int] | None:
+    if len(legends) == 1:
+        return [rng.randint(0, width - len(legends[0]))]
+
+    left, right = legends
+    min_gap = 2
+    total = len(left) + len(right) + min_gap
