+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+try:
+    from arc_utils import components_mask, get_bg, paste
+except ImportError:
+    utils_dir = Path("/home/lixinyu/snap/new/solvers")
+    if str(utils_dir) not in sys.path:
