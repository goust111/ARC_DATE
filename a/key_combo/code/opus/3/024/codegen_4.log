+    h, w = map(int, g.shape)
+    legends = []
+    markers = []
+    obstacles = []
+
+    for coords in components_mask(g != bg, connectivity=4):
+        if coords.shape[0] == 1:
+            r, c = map(int, coords[0])
+            color = int(g[r, c])
+            if color == OBSTACLE:
+                obstacles.append((r, c))
+            else:
+                markers.append((r, c, color))
+            continue
+
+        rows = coords[:, 0]
+        cols = coords[:, 1]
