+def _is_isolated(cell: tuple[int, int], occupied: set[tuple[int, int]], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    r, c = cell
+    if not (0 <= r < h and 0 <= c < w):
+        return False
+    if cell in occupied:
+        return False
+    for nr, nc in _neighbors4(cell):
+        if 0 <= nr < h and 0 <= nc < w and (nr, nc) in occupied:
+            return False
+    return True
