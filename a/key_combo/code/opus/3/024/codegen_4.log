+    for step, idx in enumerate(indices, start=1):
+        target_col = col + direction * step
+        if not (0 <= target_col < w):
+            clipped = True
+            break
+        if fold_step is not None and step >= fold_step:
+            target_row = row + 1
+            value = int(seq[len(seq) - 1 - idx])
+            folded = True
+        else:
+            target_row = row
+            value = int(seq[idx])
+            folded = False
+        cells.append(
+            {
+                "r": int(target_row),
+                "c": int(target_col),
+                "value": value,
+                "idx": int(idx),
+                "folded": folded,
+            }
+        )
