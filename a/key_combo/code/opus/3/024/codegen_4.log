+    right_steps = [None]
+    if pattern["right"]:
+        right_steps = [
+            step
+            for step in range(2, len(right_indices) + 1)
+            if _fold_visible(spec["seq"], right_indices[step - 1 :])
+        ]
+
+    if not left_steps or not right_steps:
+        return []
+
+    candidates = []
+    for col in range(w):
