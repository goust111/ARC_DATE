+def _sample_rows(height: int, count: int, rng: random.Random) -> list[int] | None:
+    rows = list(range(2, height - 1))
+    for _ in range(200):
+        picked = sorted(rng.sample(rows, count))
+        if all(b - a >= 3 for a, b in zip(picked, picked[1:])):
+            return picked
+    return None
+
