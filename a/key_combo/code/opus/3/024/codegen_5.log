+        shifted = [(r, c + delta) for r, c in cells]
+        sb = bbox_from_cells(shifted)
+        for ob in shifted_boxes:
+            if not (sb[2] < ob[0] or ob[2] < sb[0] or sb[3] < ob[1] or ob[3] < sb[1]):
