+        delta = (sep - 1) - b[3]
+        moved_hole = [(r, c + delta) for r, c in holes[0]]
+        hole_bbox = bbox_from_cells(moved_hole)
+        if hole_bbox[3] in (sep - 1, sep - 2):
+            seen_active += 1
+        else:
+            seen_inactive += 1
