+    claimed = np.zeros(out.shape, dtype=bool)
+    right_start = sep + 1
+    h, w = out.shape
+    for tpl in sorted(active_templates, key=lambda x: x["priority"]):
+        top = tpl["top"]
+        mask = tpl["mask"]
+        th, tw = mask.shape
+        col = right_start
+        while col < w:
+            for rr in range(th):
