+    if seen_active != expected_active or seen_inactive != expected_inactive:
+        return False
+    if seen_active == 0 or seen_inactive == 0:
+        return False
+    if np.count_nonzero(actual[:, sep + 1 :] == RED) == 0:
+        return False
+    return True
