+
+    input_occ: set[tuple[int, int]] = set()
+    path_occ: set[tuple[int, int]] = set()
+    output_occ: set[tuple[int, int]] = set()
+    used_directions: set[tuple[int, int]] = set()
+    groups: list[dict] = []
+
