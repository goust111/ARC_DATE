+        quarter_turns = len(ray) % 4 if rotate else 0
+        rotated = np.rot90(group["sprite"], -quarter_turns)
+        end_r, end_c = ray[-1]
+        paste(out, rotated, end_r - 1, end_c - 1, transparent=Color.BLACK, clip=True)
