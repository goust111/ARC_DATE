+    dr, dc = map(int, step)
+    r, c = map(int, last_marker)
+    out: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not in_bounds(shape, r, c):
+            return out
+        out.append((r, c))
+
