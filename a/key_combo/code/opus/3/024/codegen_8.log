+
+def _touches4(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r1, c1 in a:
+        for r2, c2 in b:
+            if abs(r1 - r2) + abs(c1 - c2) == 1:
+                return True
+    return False
