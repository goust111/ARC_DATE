+                                "n_steps": len(ray),
+                                "sprite_top_left": top_left,
+                                "input_cells": marker_cells | input_cells,
+                                "marker_cells": marker_cells,
+                                "path_cells": path_cells,
+                                "output_cells": output_cells,
