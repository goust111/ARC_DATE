+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 26)
+    w = random.randint(18, 26)
+    n_groups = 3 if random.random() < 0.65 else 2
+    colors = random.sample(list(LINE_COLORS), n_groups)
