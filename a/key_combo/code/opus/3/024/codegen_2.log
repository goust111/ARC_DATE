+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _box(r0: int, c0: int, h: int, w: int, pad: int = 0) -> tuple[int, int, int, int]:
+    return r0 - pad, c0 - pad, r0 + h + pad, c0 + w + pad
