    grey_objects = [ obj for obj in objects if Color.GREY in colors_present(obj, exclude={ Color.BLACK }) ]
    other_objects = [ obj for obj in objects if Color.GREY not in colors_present(obj, exclude={ Color.BLACK }) ]

