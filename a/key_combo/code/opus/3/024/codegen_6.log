+    for rect_info, degree in zip(info["rectangles"], info["degrees"]):
+        rect = rect_info["bbox"]
+        center_r, center_c = _rect_center(rect)
+        symbol = info["legend_map"][int(degree)]
+        patch = np.where(symbol.astype(bool), int(rect_info["color"]), BG).astype(int)
