+            assert np.all(work[r0 : r1 + 1, c0 : c1 + 1] == color), "rectangle interior must be solid"
+            rectangles.append({"color": int(color), "bbox": rect})
+    assert rectangles, "expected at least one rectangle outside the legend"
+    return rectangles
