+
+
+def _shape_cells(signature: tuple[tuple[int, int], ...], top: int, left: int) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in signature]
+
+
+def _place_source(
+    grid: np.ndarray,
+    signature: tuple[tuple[int, int], ...],
