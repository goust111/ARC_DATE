+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SEED = 7
+SOURCE_COLORS = (1, 2, 3, 4)
+
+BOTTOM_GAP_KINDS = (
+    {"name": "single", "orient": "h", "length": 1},
+    {"name": "h2", "orient": "h", "length": 2},
+    {"name": "h3", "orient": "h", "length": 3},
