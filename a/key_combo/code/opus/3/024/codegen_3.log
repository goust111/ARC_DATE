+    source_row_max = height - 3
+    if source_row_min > source_row_max:
+        return None
+
+    preferred_seed_col = max(seed_cols)
+    special_source = next(
+        (src for src in sources if frame_kinds[src["frame_id"]]["orient"] == "v"),
+        max(sources, key=lambda src: len(src["signature"])),
