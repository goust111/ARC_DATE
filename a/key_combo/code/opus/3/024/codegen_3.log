+
+
+def _build_scene() -> dict | None:
+    n_frames = 4 if random.random() < 0.78 else 3
+    frame_kinds = list(BOTTOM_GAP_KINDS)
+    if n_frames == 4:
+        frame_kinds.append(random.choice(VERTICAL_GAP_KINDS))
