+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    frames = [_frame_from_component(grid, coords) for coords in _components_mask(grid == FRAME)]
+    assert 3 <= len(frames) <= 4, "expected 3-4 grey frames"
