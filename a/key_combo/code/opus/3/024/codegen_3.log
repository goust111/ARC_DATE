+        "bbox": (r0, c0, r1, c1),
+        "h": h,
+        "w": w,
+        "gap_coords": gap,
+        "gap_signature": gap_signature,
+        "gap_size": len(gap),
+        "gap_rows": sorted({int(r) for r, _ in gap}),
+        "gap_cols": sorted({int(c) for _, c in gap}),
+        "is_bottom_gap": all(r == r1 for r, _ in gap),
