+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SEED = 7
+SOURCE_COLORS = (1, 2, 3, 4)
+
+BOTTOM_GAP_KINDS = (
