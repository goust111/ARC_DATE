+def _validate_generated(grid: np.ndarray, info: dict):
+    objects = info["objects"]
+    moved = info["moved"]
+    groups = info["groups"]
+    attractor_cells = set(info["attractor"]["cells"])
+
+    assert 6 <= len(objects) <= 8
+    assert len(groups) >= 2
+    assert any(group["tie"] for group in groups) or True
