+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            cells = tuple(sorted(cells))
+            bbox = _bbox(cells)
+            objects.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "bbox": bbox,
+                    "area": len(cells),
+                }
+            )
