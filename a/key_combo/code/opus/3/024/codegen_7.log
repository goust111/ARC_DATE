+    if r1 < ar0:
+        options.append(("down", ar0 - r1 - 1))
+    if r0 > ar1:
+        options.append(("up", r0 - ar1 - 1))
+    if c1 < ac0:
+        options.append(("right", ac0 - c1 - 1))
+    if c0 > ac1:
+        options.append(("left", c0 - ac1 - 1))
