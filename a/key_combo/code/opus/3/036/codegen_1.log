+    for r, c in source_cells:
+        for dr, dc in DIAGONALS:
+            rr, cc = r + dr, c + dc
+            while in_bounds(grid.shape, rr, cc):
+                idx = cell_to_outline.get((rr, cc))
+                if idx is not None:
+                    counts[idx] += 1
+                rr += dr
+                cc += dc
+    return counts
