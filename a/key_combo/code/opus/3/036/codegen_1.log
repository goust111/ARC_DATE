+                score = 0
+                if outlines[target_idx]["area"] != n:
+                    score += 2
+                if non_target_area_match:
+                    score += 1
+                candidates.append(
+                    {
+                        "cells": tuple(sorted(zip(rows.tolist(), cols.tolist(), strict=False))),
+                        "target_idx": target_idx,
+                        "size": n,
+                        "score": score,
