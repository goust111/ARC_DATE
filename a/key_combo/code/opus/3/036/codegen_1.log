+    for r in range(h):
+        for c in range(w):
+            if not allowed[r, c]:
+                continue
+            for idx, (diff_counts, sum_counts) in enumerate(tables):
+                contrib[r, c, idx] = diff_counts.get(r - c, 0) + sum_counts.get(r + c, 0)
