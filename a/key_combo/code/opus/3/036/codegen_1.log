+    components_mask = _ARC_UTILS.components_mask
+    in_bounds = _ARC_UTILS.in_bounds
+else:
+    class Color:
+        BLACK = 0
+        RED = 2
+
+    def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
