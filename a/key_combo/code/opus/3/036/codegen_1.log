+
+def _outline_clearance_mask(grid: np.ndarray, outlines: list[dict]) -> np.ndarray:
+    allowed = grid == Color.BLACK
+    h, w = grid.shape
+    for outline in outlines:
+        for r, c in outline["interior"]:
+            allowed[r, c] = False
+        for r, c in outline["coords"]:
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < h and 0 <= cc < w:
