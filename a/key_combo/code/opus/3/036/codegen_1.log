+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+GEN_RETRY_LIMIT = 300
+GRID_MIN = 18
+GRID_MAX = 24
+OBJECT_COUNT_RANGE = (3, 5)
