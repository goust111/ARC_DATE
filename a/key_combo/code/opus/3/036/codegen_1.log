+        rr, cc = np.where(mask)
+        for r0 in range(h - mask.shape[0] + 1):
+            for c0 in range(w - mask.shape[1] + 1):
+                rows = r0 + rr
+                cols = c0 + cc
+                if not np.all(allowed[rows, cols]):
+                    continue
+                counts = contrib[rows, cols].sum(axis=0)
+                matches = np.flatnonzero(counts == n)
+                if len(matches) != 1:
