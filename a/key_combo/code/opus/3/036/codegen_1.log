+    expected = grid.copy()
+    for r, c in choice["cells"]:
+        expected[r, c] = Color.BLACK
+    for r, c in outlines[choice["target_idx"]]["interior"]:
+        expected[r, c] = Color.RED
+
+    if not np.array_equal(out, expected):
