+    ):
+        return None
+
+    expected = _render_output(grid.shape, horizontals, verticals, BG)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
