    blob = _gen_coords_to_mask(coords)
    if bool(rng.integers(_GEN_FLIP_VARIANTS)):
        blob = np.flipud(blob)
    if bool(rng.integers(_GEN_FLIP_VARIANTS)):
        blob = np.fliplr(blob)
    return np.rot90(blob, int(rng.integers(_GEN_ROTATION_VARIANTS)))

