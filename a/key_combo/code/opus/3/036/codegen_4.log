# Canvas/platform geometry.
BG = 0
GRID_HEIGHTS = tuple(range(4, 10))
GRID_WIDTH_MIN, GRID_WIDTH_MAX = 5, 12
SHELF_FROM_BOTTOM, OPEN_ROWS_RESERVED = 2, 3

