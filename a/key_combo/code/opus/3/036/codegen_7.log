+def _plus_cells(shape: tuple[int, int], r: int, c: int, radius: int) -> tuple[tuple[int, int], ...]:
+    h, w = map(int, shape)
+    cells: list[tuple[int, int]] = []
+    for dc in range(-radius, radius + 1):
+        cc = c + dc
+        if 0 <= cc < w:
+            cells.append((r, cc))
