        start = left_end + 1
        end = right_start - 1
        assert start <= end
        assert np.all(g[shelf, start : end + 1] == bg)
        slots.append((start, end, end - start + 1))

    colors = sorted(set(map(int, g.ravel())) - {bg, platform})
    components = find_components(g, bg=bg, colors=colors, connectivity=4, monochromatic=True)

