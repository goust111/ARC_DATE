+    if mode == "vertical_wave":
+        lo = 2
+        hi = height - 3
+        if lo > hi:
+            return None
+        boundary = _clamped_walk(width, lo, hi)
+        for c, b in enumerate(boundary):
+            pattern[: b + 1, c] = base_a
