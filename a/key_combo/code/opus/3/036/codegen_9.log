        mask = np.flipud(mask)
    if random.choice(BOOL_CHOICES):
        mask = np.fliplr(mask)
    if random.choice(BOOL_CHOICES):
        mask = mask.T
    return np.array(mask, dtype=bool)


def _colored_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.full(mask.shape, BACKGROUND_COLOR, dtype=int)
