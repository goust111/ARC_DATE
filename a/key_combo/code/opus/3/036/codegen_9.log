+TOP_MARGIN_RANGE = (1, 3)
+BOTTOM_MARGIN_RANGE = (1, 3)
+MARKER_GAP = 3
+EXTRA_MARKER_PROBABILITY = 0.6
+GENERATION_ATTEMPTS = 500
+MIN_CHANGED_CELLS = 16
