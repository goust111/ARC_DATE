+
+def _base_to_marker_map(
+    grid: np.ndarray,
+    base_colors: set[int],
+    markers: list[tuple[int, int, int]],
+) -> dict[int, int]:
+    base_to_marker: dict[int, int] = {}
+    marker_to_base: dict[int, int] = {}
