+    split = rng.choice(["tb", "lr"])
+    stack_axis = "h" if split == "tb" else "v"
+    outline_in, outline_out = _render_outline_region(rng, color_to_count, stack_axis=stack_axis)
+
+    if rng.random() < 0.5:
