+        shape = rng.choice(CLUTTER_SHAPES)
+        sh, sw = shape.shape
+        r0 = rng.randint(0, h - sh)
+        c0 = rng.randint(0, w - sw)
+        if not _can_place_clutter(noisy, shape, r0, c0):
+            continue
+        color = int(rng.choice(clutter_colors))
