+
+def _factor_shapes(area: int) -> list[tuple[int, int]]:
+    options: set[tuple[int, int]] = set()
+    for h in range(1, area + 1):
+        if area % h != 0:
+            continue
+        w = area // h
+        if max(h, w) <= 8:
+            options.add((h, w))
+            options.add((w, h))
