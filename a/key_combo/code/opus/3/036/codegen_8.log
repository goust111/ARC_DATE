+
+def _make_frame(area: int, border_color: int, fill_color: int | None) -> tuple[np.ndarray, np.ndarray]:
+    interior_h, interior_w = random.choice(_factor_shapes(area))
+    patch = np.zeros((interior_h + 2, interior_w + 2), dtype=int)
+    patch[0, :] = border_color
+    patch[-1, :] = border_color
+    patch[:, 0] = border_color
+    patch[:, -1] = border_color
