+def _band_extents(rng: random.Random, count: int) -> list[tuple[int, int]]:
+    pos = rng.randint(0, 1)
+    extents: list[tuple[int, int]] = []
+    for idx in range(count):
+        if idx > 0:
+            pos += rng.randint(1, 2)
+        length = rng.randint(3, 5)
+        extents.append((pos, pos + length - 1))
+        pos += length
