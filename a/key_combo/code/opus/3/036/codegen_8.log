    return None


def _build_u_shape(target_cavity):
    min_arm_h, max_arm_h = U_ARM_HEIGHT_BOUNDS
    factors = [(g, target_cavity // g) for g in range(1, min(U_MAX_FACTOR_GAP, target_cavity) + 1)
