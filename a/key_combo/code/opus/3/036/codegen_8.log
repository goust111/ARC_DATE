+
+def _can_place_clutter(grid: np.ndarray, shape: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = grid.shape
+    sh, sw = shape.shape
+    coords = np.argwhere(shape)
+    occupied = {(r0 + int(dr), c0 + int(dc)) for dr, dc in coords}
+    for rr, cc in occupied:
