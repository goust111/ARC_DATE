        "U": _build_u_shape,
        "bridge": _build_bridge_shape,
    }
    for _ in range(SHAPE_RETRY_LIMIT):
        pixels = builders[random.choice(SHAPE_STRATEGIES)](target_cavity)
        if pixels is not None:
            return list(_maybe_flip(pixels))

    return None


