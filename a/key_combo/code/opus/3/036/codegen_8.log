+    noisy = clean.copy()
+    clutter_goal = rng.randint(5, 10)
+    clutter_colors = list({int(v) for v in compact.ravel().tolist()})
+    attempts = 0
+    placed = 0
+    while placed < clutter_goal and attempts < 200:
