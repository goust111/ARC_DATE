+    inp, out = pair
+    if inp.shape[0] > 30 or inp.shape[1] > 30 or out.shape[0] > 30 or out.shape[1] > 30:
+        return None
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    seed = random.randrange(1 << 30)
