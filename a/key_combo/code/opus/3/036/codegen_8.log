+    top = rng.randint(1, 2)
+    bottom = rng.randint(1, 2)
+    left = rng.randint(1, 2)
+    right = rng.randint(1, 2)
+    gaps = [rng.randint(2, 4) for _ in range(max(0, len(frames) - 1))]
+    h = top + sum(frame[0].shape[0] for frame in frames) + sum(gaps) + bottom
