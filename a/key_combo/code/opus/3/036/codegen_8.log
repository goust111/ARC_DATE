+RECT_COLOR_POOL = [1, 2, 3, 4, 7, 8, 9]
+OUTLINE_COLOR_POOL = [5, 6]
+CLUTTER_SHAPES = [
+    np.array([[1]], dtype=bool),
+    np.array([[1, 1]], dtype=bool),
+    np.array([[1], [1]], dtype=bool),
