+        grid,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        colors=[ANCHOR],
+    ):
+        r0, c0, r1, c1 = comp["bbox"]
+        size = int(r1 - r0 + 1)
+        if size != int(c1 - c0 + 1):
+            continue
+        patch = crop_bbox(grid, comp["bbox"])
+        if not np.all(patch == ANCHOR):
+            continue
+        anchors.append(
+            {
+                "coords": comp["coords"],
+                "bbox": comp["bbox"],
+                "size": size,
+                "center2": (int(r0 + r1), int(c0 + c1)),
+            }
+        )
+    anchors.sort(key=lambda item: (item["size"], item["bbox"][0], item["bbox"][1]))
+    return anchors
+
+
