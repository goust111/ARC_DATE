+
+
+def _round_half_up(value: float) -> int:
+    return int(np.floor(float(value) + 0.5))
+
+
+def _scale_signed_offset(value: int, source_size: int, target_size: int) -> int:
+    sign = 1 if int(value) >= 0 else -1
