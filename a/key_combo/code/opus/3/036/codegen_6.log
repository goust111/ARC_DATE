+
+    bg = int(get_bg(g))
+    anchors = _square_anchor_components(g, bg)
+    assert len(anchors) == 3, "expected exactly three red square anchors"
+
+    sizes = [anchor["size"] for anchor in anchors]
+    ds = int(sizes[1] - sizes[0])
