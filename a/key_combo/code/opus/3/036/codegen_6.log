+ANCHOR = 2
+MOTIF_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+GRID_MIN = 24
+GRID_MAX = 30
+SIZE_STEP = 1
+MAX_GENERATION_ATTEMPTS = 400
+LAYOUT_ATTEMPTS = 80
