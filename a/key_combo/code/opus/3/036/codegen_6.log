+    center2 = [anchor["center2"] for anchor in anchors]
+    delta = (
+        int(center2[1][0] - center2[0][0]),
+        int(center2[1][1] - center2[0][1]),
+    )
+    assert center2[2][0] - center2[1][0] == delta[0]
+    assert center2[2][1] - center2[1][1] == delta[1]
