+    h, w = map(int, grid_shape)
+    coords = []
+    for rr, cc in spec["coords"].tolist():
+        gr = patch_r0 + int(rr)
+        gc = patch_c0 + int(cc)
+        if 0 <= gr < h and 0 <= gc < w:
+            coords.append((gr, gc))
