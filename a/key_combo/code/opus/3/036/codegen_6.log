+        "source_size": int(source_size),
+        "motif_patch": crop_bbox(source_patch, motif_box),
+        "motif_offset": (
+            int(motif_box[0] - red_box[0]),
+            int(motif_box[1] - red_box[1]),
+        ),
+    }
