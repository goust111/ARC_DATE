+def _anchor_top_left_from_center2(center2: tuple[int, int], size: int) -> tuple[int, int]:
+    r_num = int(center2[0] - size + 1)
+    c_num = int(center2[1] - size + 1)
+    assert r_num % 2 == 0 and c_num % 2 == 0
