+            if not (0 <= top3 and top3 + lengths[3] <= grid_len):
+                continue
+        elif mode == "partial_pos":
+            if not (top3 < grid_len and top3 + lengths[3] > grid_len):
+                continue
+            if not (top4 >= grid_len):
