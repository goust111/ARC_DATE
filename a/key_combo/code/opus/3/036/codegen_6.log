+                "coords": comp["coords"],
+                "bbox": comp["bbox"],
+                "size": size,
+                "center2": (int(r0 + r1), int(c0 + c1)),
+            }
+        )
+    anchors.sort(key=lambda item: (item["size"], item["bbox"][0], item["bbox"][1]))
+    return anchors
+
+
+def _extract_source_patch(grid: np.ndarray, anchor: dict, bg: int) -> np.ndarray:
