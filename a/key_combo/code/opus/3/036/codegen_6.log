+def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
+    src_h, src_w = map(int, img.shape)
+    new_h = int(new_h)
+    new_w = int(new_w)
+    assert new_h >= 1 and new_w >= 1
