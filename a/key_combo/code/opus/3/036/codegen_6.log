+def _transform_mask(mask: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = mask.copy()
+    if rng.integers(2):
+        out = np.fliplr(out)
+    out = np.rot90(out, int(rng.integers(4)))
+    return out
