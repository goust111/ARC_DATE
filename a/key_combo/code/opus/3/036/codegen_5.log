+    H = random.randint(side + 5, min(20, side + 8))
+    W = random.randint(side + 5, min(20, side + 8))
+    pr0 = random.randint(2, H - side - 2)
+    pc0 = random.randint(2, W - side - 2)
+    pattern_box = (pr0, pc0, pr0 + side - 1, pc0 + side - 1)
