            blocked[pad_rows, pad_cols] = True
            removable[:] -= removed

            if place_one(i + 1):
                return True

            removable[:] += removed
            blocked[pad_rows, pad_cols] = old_block
            hole_mask[r : r + h, c : c + w] = False
        return False

    if place_one(0):
        return hole_mask
    return None


