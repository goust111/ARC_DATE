+    extend_all = _render_full_output(
+        grid.shape,
+        red_seeds,
+        blue_seeds,
+        {c for _r, c in red_seeds},
+        {r for r, _c in blue_seeds},
+        keep_inactive_seeds=True,
+        blend_intersections=True,
+    )
