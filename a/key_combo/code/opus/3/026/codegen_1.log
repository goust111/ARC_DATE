    return [(start, fixed), (end, fixed)]


def _gen_red_corner_markers(axis_len: int, max_span: int) -> list[tuple[int, int]]:
    h_span = random.randint(MIN_RUN_SPAN, max_span)
    v_span = random.randint(MIN_RUN_SPAN, max_span)
