+    n_indices = int(n_indices)
+    border_size = int(border_size)
+    padding = int(padding)
+    if n_indices < 0:
+        raise ValueError("n_indices must be non-negative")
+    if n_indices == 0:
+        return np.zeros(0, dtype=int)
