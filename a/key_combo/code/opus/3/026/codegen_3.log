+        color = int(component["color"])
+        if color == BG or not _is_complete_frame(component):
+            continue
+        r0, c0, r1, c1 = map(int, component["bbox"])
+        inner_bbox = (r0 + 1, c0 + 1, r1 - 1, c1 - 1)
+        frames.append(
