+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "inner_bbox": inner_bbox,
+                "inner": crop_bbox(grid, inner_bbox),
+                "inner_area": int((r1 - r0 - 1) * (c1 - c0 - 1)),
