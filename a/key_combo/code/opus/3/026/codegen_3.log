                                    (row_idx, end),
                                    (left_row, start),
                                    (right_row, end),
                                ]
                            )
    return random.choice(choices)


def _gen_red_markers(axis_len: int, max_span: int) -> list[tuple[int, int]]:
    """Sample red endpoints as a line, corner, or two-branch shape."""
    red_count = random.choice(RED_MARKER_COUNTS)
