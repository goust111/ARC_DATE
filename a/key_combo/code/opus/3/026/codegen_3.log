+    top_small_c = left_pad + top_shift
+    top_large_c = top_small_c + small_top.shape[1] + top_gap
+    bottom_large_c = left_pad + bottom_shift
+    bottom_small_c = bottom_large_c + large_bottom.shape[1] + bottom_gap
