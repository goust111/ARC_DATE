+    if int(component["area"]) != 2 * (h + w) - 4:
+        return False
+    for r_raw, c_raw in component["coords"]:
+        r = int(r_raw)
+        c = int(c_raw)
+        if r not in (r0, r1) and c not in (c0, c1):
+            return False
+    return True
