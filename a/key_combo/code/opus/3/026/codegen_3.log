+def _sample_tile_pair(rng: np.random.Generator, shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray, tuple[int, int]]:
+    coords = [(r, c) for r in range(shape[0]) for c in range(shape[1])]
+    for _ in range(300):
