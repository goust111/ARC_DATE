+    for pair in pairs:
+        target = pair["target"]
+        tile = pair["source"]["inner"]
+        if absolute_phase:
+            phase = (
+                int(target["inner_bbox"][0]) % tile.shape[0],
+                int(target["inner_bbox"][1]) % tile.shape[1],
