+def _random_tile(rng: np.random.Generator, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    for _ in range(200):
+        tile = np.where(rng.integers(0, 2, size=(h, w)) == 0, PATTERN_COLORS[0], PATTERN_COLORS[1]).astype(int)
