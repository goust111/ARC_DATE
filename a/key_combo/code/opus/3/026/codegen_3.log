+def _has_smaller_period(tile: np.ndarray) -> bool:
+    h, w = tile.shape
+    for ph in range(1, h + 1):
+        for pw in range(1, w + 1):
+            if ph == h and pw == w:
+                continue
+            ok = True
+            for r in range(h):
+                for c in range(w):
+                    if int(tile[r, c]) != int(tile[r % ph, c % pw]):
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                return True
+    return False
+
+
+def _has_shift_symmetry(tile: np.ndarray) -> bool:
+    h, w = tile.shape
+    for dr in range(h):
+        for dc in range(w):
+            if dr == 0 and dc == 0:
+                continue
+            shifted = np.roll(np.roll(tile, dr, axis=0), dc, axis=1)
+            if np.array_equal(tile, shifted):
+                return True
+    return False
