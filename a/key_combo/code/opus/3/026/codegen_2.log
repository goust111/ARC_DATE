+
+def _bbox_trick_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    shapes = [
+        (bh, bw)
+        for bh in range(1, h + 1)
+        for bw in range(1, w)
+        if bh * bw <= MAX_FOREGROUND_PIXELS
