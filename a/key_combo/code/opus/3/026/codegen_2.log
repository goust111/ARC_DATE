+    cell_h = row_heights.pop()
+    cell_w = col_widths.pop()
+    assert cell_w % 2 == 1, "cell width must be odd for a unique vertical symmetry axis"
+    return row_ranges, col_ranges, int(cell_h), int(cell_w)
