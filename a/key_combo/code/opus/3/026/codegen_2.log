+BACKGROUND = 0
+MATCHED_COLOR = 1
+UNMATCHED_COLOR = 2
+SYMMETRIC_COLOR = 3
+INPUT_FOREGROUND = 7
+LATTICE_COLOR = 8
+
+CELL_COUNT_OPTIONS = (3, 4)
+CELL_SIZE_OPTIONS = (3, 5)
