+    for _ in range(MAX_ROLE_ATTEMPTS):
+        count = rng.randint(1, min(MAX_FOREGROUND_PIXELS, len(coords)))
+        chosen = rng.sample(coords, count)
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+        if not _is_cell_symmetric(mask):
+            return mask
