+def _symmetric_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    axis = w // 2
+    pair_positions = [(r, c) for r in range(h) for c in range(axis)]
+    center_positions = [(r, axis) for r in range(h)]
