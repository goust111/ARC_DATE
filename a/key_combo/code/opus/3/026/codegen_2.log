    total_cells = n_walls + (1 if tail else 0)
    return size, cell_size, n_walls, tail, total_cells


def _gen_base_lattice(size: int, cell_size: int, n_walls: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
