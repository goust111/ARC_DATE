+        for _ in range(MAX_ROLE_ATTEMPTS):
+            candidate = _mask_for_role(role, r1 - r0 + 1, c1 - c0 + 1, rng)
+            key = candidate.tobytes()
+            if role == ROLE_EMPTY or key not in used_nonempty_masks or rng.random() < 0.25:
