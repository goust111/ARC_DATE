+def _parse_lattice(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]], int, int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    H, W = g.shape
