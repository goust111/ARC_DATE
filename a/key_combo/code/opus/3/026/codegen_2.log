+    row_walls = [r for r in range(H) if np.all(g[r, :] == LATTICE_COLOR)]
+    col_walls = [c for c in range(W) if np.all(g[:, c] == LATTICE_COLOR)]
+    assert len(row_walls) >= 2 and len(col_walls) >= 2, "expected full teal lattice rows and columns"
