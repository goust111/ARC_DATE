+    used_nonempty_masks: set[bytes] = set()
+    for index, role in enumerate(roles):
+        r_band = index // n_cells
+        c_band = index % n_cells
+        r0, r1 = row_ranges[r_band]
+        c0, c1 = col_ranges[c_band]
+
