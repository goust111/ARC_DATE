+    grid = np.full((size, size), BACKGROUND, dtype=int)
+    walls = [k * (cell_size + 1) for k in range(n_cells + 1)]
+    grid[walls, :] = LATTICE_COLOR
+    grid[:, walls] = LATTICE_COLOR
+    ranges = [(walls[i] + 1, walls[i + 1] - 1) for i in range(n_cells)]
+    return grid, ranges, ranges
