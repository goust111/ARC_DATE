+
+def _tile_seed(seed: np.ndarray, total_rows: int, top: int) -> np.ndarray:
+    seed_h = int(seed.shape[0])
+    out = np.empty((total_rows, seed.shape[1]), dtype=int)
+    for r in range(total_rows):
+        out[r] = seed[(r - top) % seed_h]
+    return out
