+def _filter_seed(seed: np.ndarray) -> np.ndarray:
+    keep = np.zeros_like(seed, dtype=bool)
+    for r_raw, c_raw in np.argwhere(seed != BACKGROUND):
+        r = int(r_raw)
+        c = int(c_raw)
+        if _same_color_support(seed, r, c) >= 2:
+            keep[r, c] = True
+    out = np.full_like(seed, BACKGROUND)
+    out[keep] = seed[keep]
+    return out
