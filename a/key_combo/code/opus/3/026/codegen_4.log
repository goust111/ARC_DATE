   186	def _gen_max_span(marker_axis: int, total_cells: int) -> int:
   187	    return min(MAX_RUN_SPAN, marker_axis, (MAX_RUN_SPAN_PERCENT * total_cells) // PERCENT_DENOMINATOR)
