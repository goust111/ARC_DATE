   190	def _gen_oriented_endpoint(span: int, axis_len: int) -> tuple[int, int]:
   191	    direction = random.choice(DIRECTIONS)
   192	    if direction < 0:
   193	        start = random.randint(span - 1, axis_len - 1)
   194	        return start, start - span + 1
   195	    start = random.randint(0, axis_len - span)
   196	    return start, start + span - 1
