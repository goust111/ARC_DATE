   171	def _gen_lattice_params() -> tuple[int, int, int, int, int]:
   172	    size = random.choice(sorted(LATTICE_CHOICES_BY_SIZE))
   173	    cell_size, n_walls, tail = random.choice(LATTICE_CHOICES_BY_SIZE[size])
   174	    total_cells = n_walls + (1 if tail else 0)
   175	    return size, cell_size, n_walls, tail, total_cells
