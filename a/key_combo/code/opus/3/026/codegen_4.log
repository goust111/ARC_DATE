    36	def main(grid: np.ndarray) -> np.ndarray:
    37	    """
    38	    Fill whole lattice cells along straight red and green marker runs, coloring red/green intersections pink.
    39	
    40	    Input structure
    41	    - A teal lattice divides the canvas into rectangular background cells.
    42	    - Red and green marker pixels sit inside some cells of that lattice.
    43	    - Markers of the same color are paired by sharing a lattice row or a lattice column.
    44	
    45	    Rule
    46	    - For each color, any lattice row with at least two same-color markers is filled between the leftmost and rightmost marker cells.
    47	    - Likewise, any lattice column with at least two same-color markers is filled between the topmost and bottommost marker cells.
    48	    - Fill entire cells, preserve the teal lattice, and color cells reached by both red and green runs pink.
    49	
    50	    Key insight
    51	    - The marker pixels are not expanded locally; they are endpoints in a coarser grid whose rows and columns are the lattice cells.
    52	    """
    53	    g = np.asarray(grid, dtype=int)
    54	    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
    55	    H, W = g.shape
    56	
    57	    colors = [int(color) for color in np.unique(g)]
    58	    lattice_candidates = []
    59	    for color in colors:
    60	        wall_rows = [r for r in range(H) if np.all(g[r, :] == color)]
    61	        wall_cols = [c for c in range(W) if np.all(g[:, c] == color)]
    62	        if wall_rows and wall_cols:
    63	            lattice_candidates.append((color, wall_rows, wall_cols))
    64	    assert len(lattice_candidates) == 1, "expected one color to form complete lattice rows and columns"
    65	    wall_color, wall_rows, wall_cols = lattice_candidates[0]
    66	    assert wall_color == Color.TEAL, "expected a teal lattice"
    67	
    68	    counts = Counter(map(int, g.ravel()))
    69	    empty_color = _unique_dominant_color([color for color in colors if color != wall_color], counts)
    70	    assert empty_color == Color.BLACK, "expected black empty cells"
    71	
    72	    marker_colors = {color for color in colors if color not in {wall_color, empty_color}}
    73	    assert marker_colors == {Color.RED, Color.GREEN}, "expected red and green markers"
    74	
    75	    row_bands = _cell_ranges(H, wall_rows)
    76	    col_bands = _cell_ranges(W, wall_cols)
    77	    assert row_bands and col_bands, "lattice must enclose at least one cell band"
    78	
    79	    markers_by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)
    80	    for r_raw, c_raw in np.argwhere((g != wall_color) & (g != empty_color)):
    81	        r = int(r_raw)
    82	        c = int(c_raw)
    83	        color = int(g[r, c])
    84	        markers_by_color[color].append((_band_index(r, row_bands), _band_index(c, col_bands)))
    85	
    86	    filled: dict[tuple[int, int], set[int]] = defaultdict(set)
    87	    for color, marker_cells in markers_by_color.items():
    88	        by_row: dict[int, list[int]] = defaultdict(list)
    89	        by_col: dict[int, list[int]] = defaultdict(list)
    90	        for row_idx, col_idx in marker_cells:
    91	            by_row[row_idx].append(col_idx)
    92	            by_col[col_idx].append(row_idx)
    93	
    94	        used_marker_cells: set[tuple[int, int]] = set()
    95	        for row_idx, col_indices in by_row.items():
    96	            if len(col_indices) < 2:
    97	                continue
    98	            for col_idx in range(min(col_indices), max(col_indices) + 1):
    99	                filled[(row_idx, col_idx)].add(color)
   100	            used_marker_cells.update((row_idx, col_idx) for col_idx in col_indices)
   101	
   102	        for col_idx, row_indices in by_col.items():
   103	            if len(row_indices) < 2:
   104	                continue
   105	            for row_idx in range(min(row_indices), max(row_indices) + 1):
   106	                filled[(row_idx, col_idx)].add(color)
   107	            used_marker_cells.update((row_idx, col_idx) for row_idx in row_indices)
   108	
   109	        assert set(marker_cells) <= used_marker_cells, "every marker must have a row or column mate"
   110	
   111	    out = g.copy()
   112	    for (row_idx, col_idx), cell_colors in filled.items():
   113	        if len(cell_colors) == 1:
   114	            fill_color = next(iter(cell_colors))
   115	        else:
   116	            assert cell_colors == {Color.RED, Color.GREEN}, "only red/green intersections are supported"
   117	            fill_color = Color.PINK
   118	
   119	        r0, r1 = row_bands[row_idx]
   120	        c0, c1 = col_bands[col_idx]
   121	        out[r0 : r1 + 1, c0 : c1 + 1] = fill_color
   122	
   123	    return out
