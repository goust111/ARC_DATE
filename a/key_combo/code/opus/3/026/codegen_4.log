  1086	def _gen_attempt() -> np.ndarray | None:
  1087	    rng = random.Random()
  1088	    s = rng.choice(FRAME_SIZE_CHOICES)
  1089	    n = s - 2
  1090	
  1091	    kind, setup_params, color_count = choose_rule_setup(n, rng)
  1092	    p1 = choose_palette(rng, color_count, set())
  1093	    p2 = choose_palette(rng, color_count, set(p1))
  1094	
  1095	    built = _build_sprites(kind, setup_params, n, p1, p2, rng)
  1096	    if built is None:
  1097	        return None
  1098	    train_src, train_dst, test_src, test_dst = built
  1099	
  1100	    frame_color, bg_palette = _choose_frame_and_bg(set(p1) | set(p2), rng)
  1101	
  1102	    positions = quadrant_positions(s, rng)
  1103	    train_slots, test_slot = _assign_slots(positions, rng)
  1104	
  1105	    sprites = [np.zeros((n, n), dtype=int) for _ in range(4)]
  1106	    sprites[train_slots[0]] = train_src
  1107	    sprites[train_slots[1]] = train_dst
  1108	    sprites[test_slot] = test_src
  1109	    # The fourth slot keeps its all-zero sprite (blank interior).
  1110	
  1111	    grid = _render_scene(s, positions, sprites, frame_color, bg_palette, rng)
  1112	    if not validate_scene(grid, test_dst):
  1113	        return None
  1114	    return grid
