    11	def _cell_ranges(length: int, wall_indices: list[int]) -> list[tuple[int, int]]:
    12	    ranges = []
    13	    start = 0
    14	    for wall in sorted(wall_indices):
    15	        if start <= wall - 1:
    16	            ranges.append((start, wall - 1))
    17	        start = wall + 1
    18	    if start <= length - 1:
    19	        ranges.append((start, length - 1))
    20	    return ranges
