    22	
    23	def _band_index(pos: int, bands: list[tuple[int, int]]) -> int:
    24	    matches = [i for i, (lo, hi) in enumerate(bands) if lo <= pos <= hi]
    25	    assert len(matches) == 1, "marker must lie in exactly one lattice cell band"
    26	    return matches[0]
    27	
