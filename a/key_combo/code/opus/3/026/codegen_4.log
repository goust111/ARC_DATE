   133	# Marker topology and run spans.
   134	MIN_RUN_SPAN = 3
   135	MAX_RUN_SPAN = 7
   136	MAX_RUN_SPAN_PERCENT = 88
   137	PERCENT_DENOMINATOR = 100
   138	RED_MARKER_COUNTS = (2, 3, 4)
   139	DIRECTIONS = (-1, 1)
   140	LINE_ORIENTATION_FLAGS = (True, False)
