    29	def _unique_dominant_color(colors: list[int], counts: Counter[int]) -> int:
    30	    max_count = max(counts[color] for color in colors)
    31	    candidates = [color for color in colors if counts[color] == max_count]
    32	    assert len(candidates) == 1, "expected a unique dominant empty color"
    33	    return candidates[0]
