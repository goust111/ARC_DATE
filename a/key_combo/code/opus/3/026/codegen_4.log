    49	            continue
    50	        sprites.append((int(component["area"]), _component_sprite(component, bg)))
    51	
    52	    assert sprites
    53	    areas = [area for area, _sprite in sprites]
    54	    assert len(areas) == len(set(areas))
    55	
    56	    out = np.full_like(g, bg)
    57	    c = 0
    58	    for _area, sprite in sorted(sprites, key=lambda item: item[0]):
    59	        h, w = sprite.shape
    60	        assert h <= H and c + w <= W
    61	        paste(out, sprite, H - h, c, transparent=bg)
    62	        c += w
    63	    return out
    64	
    65	# --------------- generator (att1, Claude) ---------------
    66	
    67	BG = 7
    68	ALL_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
    69	
    70	# Canvas and sprite bounds.
    71	GRID_HEIGHT, GRID_WIDTH = 10, 10
    72	SPRITE_MIN_AREA, SPRITE_MAX_AREA = 1, 12
    73	SPRITE_MAX_HEIGHT, SPRITE_MAX_WIDTH = 6, 4
    74	MIN_SPRITE_DENSITY = 0.5
    75	
    76	# Sprite sampling and validation.
    77	SPRITE_COUNT_CHOICES = [3, 4]
    78	SPRITE_CONNECTIVITY = 4
    79	SPRITE_SYMMETRY = 'not_symmetric'
    80	SPRITE_RETRY_LIMIT = 20
    81	
    82	# Frame, placement, and generation retries.
    83	FRAME_PROBABILITY = 0.3
    84	FRAME_BORDER, NO_FRAME_BORDER = 1, 0
    85	GENERATION_RETRY_LIMIT = 300
    86	
    87	VALID_SPRITE_SHAPES = {
    88	    area: [(h, w) for h in range(1, SPRITE_MAX_HEIGHT + 1)
    89	           for w in range(1, SPRITE_MAX_WIDTH + 1)
    90	           if h * w >= area and area / (h * w) >= MIN_SPRITE_DENSITY]
    91	    for area in range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1)
    92	}
    93	
    94	
    95	def _make_sprite(area, color):
    96	    valid_shapes = list(VALID_SPRITE_SHAPES.get(area, []))
    97	    if not valid_shapes:
    98	        return None
    99	
   100	    random.shuffle(valid_shapes)
   101	    for h, w in valid_shapes:
   102	        bbox_area = h * w
   103	        if bbox_area == area:
   104	            return np.full((h, w), color, dtype=int)
   105	        try:
   106	            sprite = random_sprite(h, w, density=area / bbox_area,
   107	                                   color_palette=[color], connectivity=SPRITE_CONNECTIVITY,
   108	                                   background=BG, symmetry=SPRITE_SYMMETRY)
   109	            actual_area = int(np.sum(sprite != BG))
   110	            if actual_area == area and is_contiguous(sprite, background=BG,
   111	                                                     connectivity=SPRITE_CONNECTIVITY):
   112	                return sprite
   113	        except Exception:
   114	            continue
   115	    return None
   116	
   117	
   118	def _sample_sprite_specs():
   119	    n_sprites = random.choice(SPRITE_COUNT_CHOICES)
   120	    possible_areas = list(range(SPRITE_MIN_AREA, SPRITE_MAX_AREA + 1))
   121	    random.shuffle(possible_areas)
   122	    areas = sorted(possible_areas[:n_sprites])
   123	    colors = [random.choice(ALL_COLORS) for _ in range(n_sprites)]
   124	    return areas, colors
   125	
   126	
   127	def _make_sprites(areas, colors):
   128	    """Build all sprites, preserving area order; return None if any shape fails."""
   129	    sprites = []
   130	    for area, color in zip(areas, colors):
   131	        sprite = None
   132	        for _ in range(SPRITE_RETRY_LIMIT):
