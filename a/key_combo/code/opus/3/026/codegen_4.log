   156	def _gen_lattice_choices_by_size() -> dict[int, list[tuple[int, int, int]]]:
   157	    choices_by_size: dict[int, list[tuple[int, int, int]]] = {}
   158	    for cell_size in range(CELL_SIZE_BOUNDS[0], CELL_SIZE_BOUNDS[1] + 1):
   159	        for n_walls in range(WALL_COUNT_BOUNDS[0], WALL_COUNT_BOUNDS[1] + 1):
   160	            for tail in range(cell_size):
   161	                size = n_walls * (cell_size + LATTICE_WALL_WIDTH) + tail
   162	                total_cells = n_walls + (1 if tail else 0)
   163	                if GRID_SIZE_BOUNDS[0] <= size <= GRID_SIZE_BOUNDS[1] and TOTAL_CELLS_BOUNDS[0] <= total_cells <= TOTAL_CELLS_BOUNDS[1]:
   164	                    choices_by_size.setdefault(size, []).append((cell_size, n_walls, tail))
   165	    return choices_by_size
   166	
   167	
   168	LATTICE_CHOICES_BY_SIZE = _gen_lattice_choices_by_size()
