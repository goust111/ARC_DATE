  1057	def _choose_frame_and_bg(used: set[int], rng: random.Random) -> tuple[int, list[int]]:
  1058	    """Pick a single frame color and a bg palette disjoint from sprite + frame colors."""
  1059	    frame_color = rng.choice([c for c in ALL_COLORS if c not in used])
  1060	    bg_pool = [c for c in ALL_COLORS if c not in used and c != frame_color]
  1061	    bg_palette = rng.sample(bg_pool, rng.choice(BG_PERIOD_CHOICES))
  1062	    return frame_color, bg_palette
