   136	        if sprite is None:
   137	            return None
   138	        sprites.append(sprite)
   139	    return sprites
   140	
   141	
   142	def _fits_packed_output(sprites):
   143	    total_width = sum(sprite.shape[1] for sprite in sprites)
   144	    max_height = max(sprite.shape[0] for sprite in sprites)
   145	    return total_width <= GRID_WIDTH and max_height <= GRID_HEIGHT
   146	
   147	
   148	def _pack_output(sprites):
   149	    output = np.full((GRID_HEIGHT, GRID_WIDTH), BG, dtype=int)
   150	    col = 0
   151	    for sprite in sprites:
   152	        sprite_height, sprite_width = sprite.shape
   153	        paste(output, sprite, GRID_HEIGHT - sprite_height, col, transparent=BG)
   154	        col += sprite_width
   155	    return output
   156	
   157	
   158	def _maybe_add_frame(grid, sprites):
   159	    """Mutate grid with an optional perimeter frame; return the active border."""
   160	    use_frame = random.random() < FRAME_PROBABILITY
   161	    if not use_frame:
   162	        return NO_FRAME_BORDER
   163	
   164	    sprite_colors = set(int(sprite[sprite != BG].flat[0]) for sprite in sprites)
   165	    frame_candidates = [color for color in ALL_COLORS if color not in sprite_colors]
   166	    if not frame_candidates:
   167	        return NO_FRAME_BORDER
   168	
   169	    frame_color = random.choice(frame_candidates)
   170	    grid[0, :] = frame_color
   171	    grid[-1, :] = frame_color
   172	    grid[:, 0] = frame_color
   173	    grid[:, -1] = frame_color
   174	    return FRAME_BORDER
