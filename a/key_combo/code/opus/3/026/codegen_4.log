  1028	def _build_sprites(kind: str, setup_params: dict, n: int, p1: list[int], p2: list[int],
  1029	                   rng: random.Random):
  1030	    """Build (train_src, train_dst, test_src, test_dst) or return None on failure.
  1031	
  1032	    Verifies: rule is self-consistent (inferable from training pair), test output is
  1033	    non-degenerate, pixel counts in bounds, and color signatures match the spec.
  1034	    """
  1035	    train_src, train_dst = build_training_pair(kind, setup_params, n, p1, rng)
  1036	    inferred = infer_template(train_src, train_dst)
  1037	    if inferred is None or inferred[0] != kind:
  1038	        return None
  1039	    inferred_kind, inferred_params = inferred
  1040	
  1041	    test_src, _test_pair_dst = build_training_pair(kind, setup_params, n, p2, rng)
  1042	    test_dst = apply_template(inferred_kind, inferred_params, test_src)
  1043	
  1044	    if np.array_equal(test_dst, test_src):
  1045	        return None
  1046	    for arr in (train_src, train_dst, test_src, test_dst):
  1047	        if not _valid_nz(arr):
  1048	            return None
  1049	    train_sig = tuple(colors_present(train_src, exclude={0}))
  1050	    if train_sig != tuple(colors_present(train_dst, exclude={0})):
  1051	        return None
  1052	    if tuple(colors_present(test_src, exclude={0})) == train_sig:
  1053	        return None
  1054	    return train_src, train_dst, test_src, test_dst
