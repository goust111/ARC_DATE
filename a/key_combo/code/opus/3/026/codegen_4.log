   178	def _gen_base_lattice(size: int, cell_size: int, n_walls: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
   179	    grid = np.full((size, size), BACKGROUND_COLOR, dtype=int)
   180	    wall_indices = [cell_size + i * (cell_size + LATTICE_WALL_WIDTH) for i in range(n_walls)]
   181	    grid[wall_indices, :] = LATTICE_COLOR
   182	    grid[:, wall_indices] = LATTICE_COLOR
   183	    return grid, _cell_ranges(size, wall_indices)
