+    mask = np.zeros((h, w), dtype=bool)
+    if h < 3 or w < 3:
+        return mask
+    mask[0, 1 : w - 1] = True
+    mask[h - 1, 1 : w - 1] = True
+    mask[1 : h - 1, 0] = True
+    mask[1 : h - 1, w - 1] = True
+    return mask
+
+
+def _is_rot180_symmetric(sprite: np.ndarray) -> bool:
+    return bool(np.array_equal(sprite, np.rot90(sprite, 2)))
+
+
+def _normalize_to_3x3(crop: np.ndarray) -> np.ndarray:
