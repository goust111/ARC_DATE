+def _rounded_frame_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    if h < 3 or w < 3:
+        return mask
+    mask[0, 1 : w - 1] = True
+    mask[h - 1, 1 : w - 1] = True
+    mask[1 : h - 1, 0] = True
+    mask[1 : h - 1, w - 1] = True
+    return mask
+
