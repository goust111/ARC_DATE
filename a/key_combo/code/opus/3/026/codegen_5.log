+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PATTERN_COLORS = (BLUE, RED, GREEN, YELLOW)
+
+FRAME_COUNT_RANGE = (4, 6)
+GRID_SIDE_RANGE = (18, 24)
+MAX_GENERATION_ATTEMPTS = 400
+
+SYMMETRIC_DIMS = ((1, 3), (3, 1), (3, 3))
+EVEN_AXIS_DIMS = ((1, 2), (2, 1), (2, 2), (2, 3), (3, 2))
