+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PATTERN_COLORS = (BLUE, RED, GREEN, YELLOW)
+
+FRAME_COUNT_RANGE = (4, 6)
