+def _draw_frame(grid: np.ndarray, r0: int, c0: int, interior: np.ndarray) -> None:
+    ih, iw = interior.shape
+    h = ih + 2
+    w = iw + 2
+    mask = _rounded_frame_mask(h, w)
+    sub = grid[r0 : r0 + h, c0 : c0 + w]
+    sub[mask] = GREY
+    sub[1:-1, 1:-1] = interior
