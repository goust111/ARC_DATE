+}
+
+
+def _available_isolated_points(existing: list[tuple[int, int]], rows: int, cols: int) -> list[tuple[int, int]]:
+    used_rows = {int(r) for r, _ in existing}
+    used_cols = {int(c) for _, c in existing}
