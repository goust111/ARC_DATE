+        for c in range(1, cols - 1):
+            if c in used_cols:
+                continue
+            point = (r, c)
+            if _pairwise_clear(existing + [point]):
+                candidates.append(point)
+    return candidates
+
+
+def _add_isolated_points(
+    points: list[tuple[int, int]], target_count: int, rows: int, cols: int
