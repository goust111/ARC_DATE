+    r_high = rows - 2 - (vert_step if direction > 0 else 0)
+    c_low = 1 + left_step
+    c_high = cols - 2 - right_step
+    if r_low > r_high or c_low > c_high:
+        return None
+
+    r = random.randint(r_low, r_high)
+    c = random.randint(c_low, c_high)
