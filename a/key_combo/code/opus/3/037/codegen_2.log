124:def _build_grid(needed: int, separator: int) -> tuple[np.ndarray, list[tuple[int, int]], int]:
125:    """Create the separator grid and return usable cell origins plus expected count."""
126:    layouts = [(r, c) for r in TABLE_ROWS for c in TABLE_COLS if r * c > needed]
127:    table_rows, table_cols = random.choice(layouts)
128:    height, width = HEIGHT_BY_TABLE_ROWS[table_rows], random.choice(WIDTHS_BY_TABLE_COLS[table_cols])
129:    col_bars = np.arange(BAR_START, width, BAR_SPACING)
130:    grid = np.zeros((height, width), dtype=int)
131:    grid[ROW_BARS, :] = separator
132:    grid[:, col_bars] = separator
133:    usable = [
134:        (r0, c0)
135:        for r0, r1 in _spans(height, ROW_BARS)
136:        if r1 - r0 >= MIN_USABLE_SPAN
137:        for c0, c1 in _spans(width, col_bars)
138:        if c1 - c0 >= MIN_USABLE_SPAN
139:    ]
140:    return grid, usable, table_rows * table_cols
141:
142:def _fill_cells(grid, usable, counted_colors, counts, separator) -> None:
143:    """Place counted sprites, then fill remaining usable cells with separator sprites."""
144:    cell_colors = [color for color, count in zip(counted_colors, counts) for _ in range(count)]
145:    cell_colors.extend([separator] * (len(usable) - len(cell_colors)))
146:    random.shuffle(cell_colors)
147:    dr, dc = SPRITE_OFFSET
148:    for (r0, c0), color in zip(usable, cell_colors):
149:        paste(grid, SPRITE * color, r0 + dr, c0 + dc)
150:
151:def _gen_attempt() -> np.ndarray | None:
152:    separator, counted_colors, counts, out = _sample_case()
153:    inp, usable, expected_cells = _build_grid(sum(counts), separator)
154:    if len(usable) != expected_cells:
155:        return None
156:    _fill_cells(inp, usable, counted_colors, counts, separator)
157:    if not np.array_equal(main(inp), out):
158:        return None
159:    return inp
