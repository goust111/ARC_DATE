112:def _sample_case() -> tuple[int, list[int], list[int], np.ndarray]:
113:    """Choose colors/counts and render the matching histogram output."""
114:    n_colors = random.randint(*N_COLORS_RANGE)
115:    max_count = random.randint(max(MAX_COUNT_RANGE[0], n_colors), MAX_COUNT_RANGE[1])
116:    counts = sorted(random.sample(range(COUNT_SAMPLE_START, max_count), n_colors - 1) + [max_count])
117:    palette = random.sample(COLOR_POOL, n_colors + 1)
118:    separator, counted_colors = palette[0], palette[1:]
119:    out = np.zeros((n_colors, max_count), dtype=int)
120:    for r, (color, count) in enumerate(zip(counted_colors, counts)):
121:        out[r, :count] = color
122:    return separator, counted_colors, counts, out
