+def _make_chain_pair(rows: int, cols: int, lengths: tuple[int, ...]) -> list[tuple[int, int]] | None:
+    h0_len, h1_len, v_len = random.sample(list(lengths), 3)
+    h0_step, h1_step, v_step = h0_len + 3, h1_len + 3, v_len + 3
