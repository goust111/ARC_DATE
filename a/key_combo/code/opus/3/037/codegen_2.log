51:def main(grid: np.ndarray) -> np.ndarray:
52:    """Move each marked L-shaped sprite onto the separate pixel matching its marker color.
53:
54:    Input structure
55:    - The background is the dominant color.
56:    - Foreground has 4-connected multicolor sprites and isolated one-pixel controls.
57:    - Each sprite has one repeated body color in an L shape plus one embedded marker
58:      pixel of a different color.
59:
60:    Rule
61:    - If the embedded marker color also appears as a separate isolated control pixel,
62:      translate the whole sprite so the body L-bend lands on that control pixel.
63:    - Clear each moved sprite from its old position, clear its consumed control pixel,
64:      then paste all translated sprites; sprites without a matching control stay put.
65:
66:    Key insight
67:    - The marker color pairs a sprite with its destination control, while the L-bend
68:      gives the orientation-independent anchor cell to place on that destination.
69:    """
70:    g = np.asarray(grid, dtype=int)
71:    bg = get_bg(g)
72:    components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
73:
74:    controls_by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)
75:    sprites = []
76:    for comp in components:
77:        coords = comp["coords"]
78:        if len(coords) == 1:
79:            r, c = map(int, coords[0])
80:            controls_by_color[int(g[r, c])].append((r, c))
81:        else:
82:            sprites.append(comp)
83:
84:    moves = []
85:    for sprite in sprites:
86:        coords = sprite["coords"]
87:        counts = Counter(int(g[r, c]) for r, c in coords)
88:        marker_colors = [color for color, count in counts.items() if count == 1]
89:        body_colors = [color for color, count in counts.items() if count > 1]
90:        assert len(counts) == 2, f"sprite must have two colors, got {counts}"
91:        assert len(marker_colors) == 1, f"sprite must have one embedded marker, got {counts}"
92:        assert len(body_colors) == 1, f"sprite must have one body color, got {counts}"
93:
94:        body_color = body_colors[0]
95:        body_coords = np.array(
96:            [(int(r), int(c)) for r, c in coords if int(g[r, c]) == body_color],
97:            dtype=int,
98:        )
99:        anchor = _l_bend(body_coords)
100:
101:        marker_color = marker_colors[0]
102:        marker = next(
103:            (int(r), int(c)) for r, c in coords if int(g[r, c]) == marker_color
104:        )
105:        controls = controls_by_color.get(marker_color, [])
106:        if not controls:
107:            continue
108:        assert len(controls) == 1, f"marker color {marker_color} must have one control"
109:        target = controls[0]
110:        _outer_diagonal_distance(anchor, marker, target)
111:
112:        dr = target[0] - anchor[0]
113:        dc = target[1] - anchor[1]
114:
115:        translated = []
116:        for r, c in coords:
117:            nr = int(r) + dr
118:            nc = int(c) + dc
119:            assert 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1], "move must stay in bounds"
120:            translated.append((nr, nc, int(g[r, c])))
121:        moves.append((coords, target, translated))
122:
123:    assert moves, "expected at least one marker-controlled move"
124:
125:    out = g.copy()
126:    cleared = set()
127:    for coords, target, _translated in moves:
128:        for r, c in coords:
129:            cleared.add((int(r), int(c)))
130:        cleared.add(target)
131:    for r, c in cleared:
132:        out[r, c] = bg
133:
134:    occupied = set()
135:    for _coords, _target, translated in moves:
136:        for r, c, _color in translated:
137:            assert out[r, c] == bg, "translated sprite must land on cleared/background cells"
138:            assert (r, c) not in occupied, "translated sprites must not overlap"
139:            occupied.add((r, c))
140:        for r, c, color in translated:
