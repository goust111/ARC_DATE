+def _cells_have_gap(cells: np.ndarray, occupied: set[Coord], h: int, w: int) -> bool:
+    for r, c in cells:
+        rr = int(r)
+        cc = int(c)
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (rr + dr, cc + dc) in occupied:
