+    placements = meta["placements"]
+    if not (OBJECT_COUNT_RANGE[0] <= len(objects) <= OBJECT_COUNT_RANGE[1]):
+        return False
+
+    lower = grid[sep + 1 :]
+    walls = find_components(lower, bg=BACKGROUND, colors=[WALL_COLOR])
+    if not (2 <= len(walls) <= 4):
