+    placements = []
+    for obj in objects:
+        mirror = _mirror_coords(obj["coords"], sep)
+        wall_hit = any(int(g[r, c]) == WALL_COLOR for r, c in mirror)
+        target_center = _rounded_centroid(mirror)
