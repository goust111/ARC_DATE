+    cc0 = max(0, c0 - pad)
+    rr1 = min(blocked.shape[0] - 1, r1 + pad)
+    cc1 = min(blocked.shape[1] - 1, c1 + pad)
+    blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
