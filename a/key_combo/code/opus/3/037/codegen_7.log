+
+
+BG = Color.BLACK
+GREY = Color.GREY
+TRAIL = Color.ORANGE
+RECT_COLORS = (Color.BLUE, Color.RED, Color.GREEN)
+
+RECT_DIM_POOL = ((2, 3), (2, 4), (3, 3), (3, 4), (4, 4))
+GRID_MIN = 18
+GRID_MAX = 24
+RECT_GAP = 2
+GEN_ATTEMPTS = 400
