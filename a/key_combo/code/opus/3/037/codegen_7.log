+            for cell in cells
+            for nbr in _neighbors_in_bbox(cell[0], cell[1], h, w)
+            if nbr not in cells
+        }
+        while len(cells) < target and frontier:
+            nxt = random.choice(tuple(frontier))
+            cells.add(nxt)
+            frontier = {
+                nbr
+                for cell in cells
+                for nbr in _neighbors_in_bbox(cell[0], cell[1], h, w)
+                if nbr not in cells
+            }
