+def _manhattan_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    rr, cc = b
+    cells = [(r, c)]
+    if random.random() < 0.5:
+        axes = (0, 1)
+    else:
+        axes = (1, 0)
+    for axis in axes:
+        if axis == 0:
+            step = 1 if rr >= r else -1
+            while r != rr:
+                r += step
+                cells.append((r, c))
+        else:
+            step = 1 if cc >= c else -1
+            while c != cc:
+                c += step
+                cells.append((r, c))
+    return cells
