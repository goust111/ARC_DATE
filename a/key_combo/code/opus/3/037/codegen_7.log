+        if len(cells) != target or len(cells) >= h * w:
+            continue
+        rows = [r for r, _c in cells]
+        cols = [c for _r, c in cells]
+        if min(rows) != 0 or max(rows) != h - 1 or min(cols) != 0 or max(cols) != w - 1:
