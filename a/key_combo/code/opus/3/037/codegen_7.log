+    for dims in _orientations(canon):
+        h, w = dims
+        if mode == "vertical" and w <= rect["w"]:
+            feasible.append(dims)
+        if mode == "horizontal" and h <= rect["h"]:
+            feasible.append(dims)
+    return feasible
