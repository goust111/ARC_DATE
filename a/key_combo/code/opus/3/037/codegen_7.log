+
+def _paint_background_only(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    bg: int,
+    color: int,
+) -> None:
+    r0, c0, r1, c1 = bbox
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    patch[patch == bg] = int(color)
