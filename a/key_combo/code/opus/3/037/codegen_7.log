+def _touch_side(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> str | None:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    sides = []
+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    return sides[0] if len(sides) == 1 else None
+
