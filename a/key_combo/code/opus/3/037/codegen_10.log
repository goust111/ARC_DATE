    center2 = int(source_lo) + int(source_hi)
    lo = (center2 - (int(length) - 1)) // 2
    hi = (center2 + (int(length) - 1)) // 2
    return lo, hi


def _gen_mark_row(mask: np.ndarray, row: int, c0: int, c1: int) -> bool:
    rows, cols = mask.shape
