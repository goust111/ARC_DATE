+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+    bg = get_bg(g)
+    rect = _find_rectangle(g)
+    sprites, controls = _parse_scene(g, rect)
+
+    moved_sources: set[tuple[int, int]] = set()
+    used_controls: set[tuple[int, int]] = set()
