+    h, w = patch.shape
+    if br1 - br0 + 1 < h or bc1 - bc0 + 1 < w:
+        return []
+
+    spots = []
+    for r in range(br0, br1 - h + 2):
+        for c in range(bc0, bc1 - w + 2):
+            anchor = (r + bend[0], c + bend[1])
+            if _control_ok(side, anchor, rect_bbox):
+                spots.append((r, c))
+    random.shuffle(spots)
+    return spots
+
+
