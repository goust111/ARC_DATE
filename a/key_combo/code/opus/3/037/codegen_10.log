+def _parse_scene(g: np.ndarray, rect: dict) -> tuple[list[dict], dict[int, list[tuple[int, int]]]]:
+    bg = get_bg(g)
+    scene = g.copy()
+    r0, c0, r1, c1 = rect["bbox"]
+    scene[r0 : r1 + 1, c0 : c1 + 1] = bg
