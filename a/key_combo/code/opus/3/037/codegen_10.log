+    inp = np.zeros((rows, cols), dtype=int)
+    r0, c0, r1, c1 = rect_bbox
+    inp[r0 : r1 + 1, c0 : c1 + 1] = RECT_COLOR
+
+    for spec in planned:
+        cr, cc = spec["control"]
