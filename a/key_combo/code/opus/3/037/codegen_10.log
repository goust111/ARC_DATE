+    bottom = top + h - 1
+    right = left + w - 1
+    r0, c0, r1, c1 = rect_bbox
+    near_edge = (
+        top <= EDGE_MARGIN
+        or left <= EDGE_MARGIN
+        or bottom >= rows - 1 - EDGE_MARGIN
+        or right >= cols - 1 - EDGE_MARGIN
+    )
+    clear_of_rect = (
+        bottom < r0 - RECT_CLEARANCE
+        or top > r1 + RECT_CLEARANCE
+        or right < c0 - RECT_CLEARANCE
