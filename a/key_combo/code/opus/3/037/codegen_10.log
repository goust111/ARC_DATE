+def _make_sprite_patch(body_color: int, marker_color: int) -> tuple[np.ndarray, tuple[int, int]]:
+    v_len = random.choice(SPRITE_LEG_SIZES)
+    h_len = random.choice(SPRITE_LEG_SIZES)
