+            assert int(out[r, c]) == bg, "translated sprite must land on cleared background"
+            assert (r, c) not in occupied, "translated sprites must not overlap"
+            occupied.add((r, c))
+        for r, c, color in sprite:
+            out[r, c] = int(color)
