+    r0 = max(0, int(r) - padding)
+    c0 = max(0, int(c) - padding)
+    r1 = min(canvas.shape[0], int(r) + int(h) + padding)
+    c1 = min(canvas.shape[1], int(c) + int(w) + padding)
