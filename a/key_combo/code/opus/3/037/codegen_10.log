+def _find_rectangle(g: np.ndarray) -> dict:
+    bg = get_bg(g)
+    comps = find_components(
+        g,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        colors=[RECT_COLOR],
+        return_format="dict",
+    )
+    candidates = []
+    center = np.array([(g.shape[0] - 1) / 2.0, (g.shape[1] - 1) / 2.0])
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        if comp["area"] != (r1 - r0 + 1) * (c1 - c0 + 1):
+            continue
