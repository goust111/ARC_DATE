+        (-dc, -dr),
+        (-dr, dc),
+        (dc, dr),
+    ]
+    pts = {
+        (int(cr + rr), int(cc + cc2))
+        for rr, cc2 in rels
+        if in_bounds(shape, int(cr + rr), int(cc + cc2))
+    }
+    return sorted(pts)
+
+
+def _quadrant(coord: Coord, center: Coord) -> str:
+    r, c = coord
+    cr, cc = center
+    if r < cr and c < cc:
+        return "NW"
+    if r < cr and c > cc:
+        return "NE"
+    if r > cr and c < cc:
+        return "SW"
+    if r > cr and c > cc:
+        return "SE"
