+def _validate_generated_example(inp: np.ndarray, seeds: list[tuple[int, int, int]]) -> bool:
+    out = main(inp)
+    added = int(((inp == BACKGROUND) & (out != BACKGROUND)).sum())
+    if not 3 <= added <= 28:
+        return False
