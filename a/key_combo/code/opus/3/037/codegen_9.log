+    has_even = False
+    has_odd = False
+    center = (GEN_CENTER, GEN_CENTER)
+    for r, c, color in seeds:
+        orbit = _d4_orbit((r, c), center, inp.shape)
+        if _chebyshev(center, (r, c)) % 2 == 0:
+            has_even = True
+        else:
+            has_odd = True
+
+        expected = {
