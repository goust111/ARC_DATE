+
+
+def _ray_seed_rows(marker_row: int, step: Coord, band: tuple[int, int]) -> list[int]:
+    lo, hi = band
+    if step[0] < 0:
+        return list(range(lo + 1, marker_row))
+    return list(range(marker_row + 1, hi))
+
+
+def _object_band_index(obj: tuple[Coord, ...], bands: list[tuple[int, int]]) -> int:
+    rows = {r for r, _c in obj}
+    for idx, (lo, hi) in enumerate(bands):
+        if all(lo <= row <= hi for row in rows):
