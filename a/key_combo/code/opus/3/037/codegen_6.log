+    for start_r, start_c in np.argwhere(mask):
+        sr = int(start_r)
+        sc = int(start_c)
+        if visited[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        visited[sr, sc] = True
+        coords: list[Coord] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not visited[nr, nc]:
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+        arr = np.array(sorted(coords), dtype=int)
+        components.append(
+            {
+                "color": int(color),
+                "coords": arr,
+                "bbox": _bbox_coords(arr),
+                "area": int(arr.shape[0]),
+            }
+        )
+    components.sort(key=lambda comp: tuple(map(int, comp["bbox"][:2])))
+    return components
