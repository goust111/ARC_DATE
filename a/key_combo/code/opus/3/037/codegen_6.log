+    metadata = {
+        "markers": markers,
+        "bands": bands,
+        "same_band_hit": same_band_hit,
+        "same_band_unhit": same_band_unhit,
+        "cross_source": cross_source,
+        "cross_target": cross_target,
+        "cross_object": cross_object,
+        "extras": extras,
