+            continue
+        return rows, bands
+    return None
+
+
+def _choose_marker_cols(width: int, n_markers: int) -> list[int] | None:
+    for _ in range(200):
+        pool = list(range(2, width - 2))
+        random.shuffle(pool)
+        chosen: list[int] = []
+        for col in pool:
+            if all(abs(col - other) >= 3 for other in chosen):
+                chosen.append(col)
+                if len(chosen) == n_markers:
+                    random.shuffle(chosen)
+                    return chosen
+    return None
+
+
+def _band_mask(
+    shape: tuple[int, int],
+    band: tuple[int, int],
+    forbidden_rows: set[int],
+    forbidden_cols: set[int],
+) -> np.ndarray:
+    height, width = shape
+    lo, hi = band
+    mask = np.zeros(shape, dtype=bool)
+    r0 = max(1, lo + 1)
+    r1 = min(height - 2, hi - 1)
+    if r0 > r1 or width < 3:
+        return mask
+    mask[r0 : r1 + 1, 1 : width - 1] = True
+    for row in forbidden_rows:
+        if 0 <= row < height:
+            mask[row, :] = False
+    for col in forbidden_cols:
+        if 0 <= col < width:
+            mask[:, col] = False
+    return mask
+
+
+def _pattern_cells(seed: Coord, pattern: tuple[Coord, ...]) -> list[Coord]:
+    return [(int(seed[0]) + dr, int(seed[1]) + dc) for dr, dc in pattern]
+
+
+def _place_object(
