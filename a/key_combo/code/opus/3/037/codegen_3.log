+GEN_FRAME_COUNT_CHOICES = (3, 4)
+GEN_GRID_ROWS = tuple(range(20, 29))
+GEN_GRID_COLS = tuple(range(20, 29))
+GEN_FRAME_BORDER = 1
+GEN_FRAME_GAP = 2
+GEN_MAX_ATTEMPTS = 300
