+def _corner_coords_from_bbox(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {
+        "NW": (int(r0), int(c0)),
+        "NE": (int(r0), int(c1)),
+        "SW": (int(r1), int(c0)),
+        "SE": (int(r1), int(c1)),
+    }
