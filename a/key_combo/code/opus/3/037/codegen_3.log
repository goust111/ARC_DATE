def _gen_centered_span(source_lo: int, source_hi: int, length: int) -> tuple[int, int]:
    center2 = int(source_lo) + int(source_hi)
    lo = (center2 - (int(length) - 1)) // 2
    hi = (center2 + (int(length) - 1)) // 2
    return lo, hi

