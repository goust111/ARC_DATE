+    inner[1 : 1 + SPRITE_SIZE, 1 : 1 + SPRITE_SIZE] = sprite
+    sr, sc = CORNER_TO_INNER[source_corner]
+    inner[sr, sc] = YELLOW
+    for r, c in _l_marker_coords_for_corner((1, 1, 3, 3), l_corner):
+        inner[r, c] = YELLOW
+    return inner
