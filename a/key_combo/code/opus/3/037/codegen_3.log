+    frame[0, :] = GREY
+    frame[-1, :] = GREY
+    frame[:, 0] = GREY
+    frame[:, -1] = GREY
+    mr, mc = {
+        "NW": (0, 0),
+        "NE": (0, FRAME_SIZE - 1),
+        "SW": (FRAME_SIZE - 1, 0),
+        "SE": (FRAME_SIZE - 1, FRAME_SIZE - 1),
+    }[target_corner]
