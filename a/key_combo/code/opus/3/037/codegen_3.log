+        "NW": int(frame[0, 0]),
+        "NE": int(frame[0, -1]),
+        "SW": int(frame[-1, 0]),
+        "SE": int(frame[-1, -1]),
+    }
+    missing = [corner for corner, value in corners.items() if value == bg]
+    assert len(missing) == 1, "expected one missing frame corner"
