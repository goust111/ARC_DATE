+        return False
+    border_mask = np.zeros_like(frame, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    border = frame[border_mask]
+    if np.count_nonzero(border == bg) != 1:
+        return False
+    if np.any((border != GREY) & (border != bg)):
+        return False
+    if np.any(frame[1:-1, 1:-1] == GREY):
+        return False
+    return True
