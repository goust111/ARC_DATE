from __future__ import annotations

from collections import Counter
import random

import numpy as np


BLACK = 0
YELLOW = 4
GREY = 5

FRAME_SIZE = 7
INNER_SIZE = 5
SPRITE_SIZE = 3

ALL_CORNERS = ("NW", "NE", "SE", "SW")
FRAME_CORNERS = ("NW", "NE", "SW", "SE")
CORNER_ORDER_CW = ("NW", "NE", "SE", "SW")
CORNER_TO_INNER = {
    "NW": (0, 0),
    "NE": (0, INNER_SIZE - 1),
    "SW": (INNER_SIZE - 1, 0),
    "SE": (INNER_SIZE - 1, INNER_SIZE - 1),
