def _bar_cells(axis: str, center: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = center
    if axis == AXIS_HORIZONTAL:
        return [(r, c - 1), (r, c), (r, c + 1)]
    return [(r - 1, c), (r, c), (r + 1, c)]


