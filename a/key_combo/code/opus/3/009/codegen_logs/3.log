+def _box_mask(cells: set[tuple[int, int]], box: Box) -> np.ndarray:
+    mask = np.zeros((box.height, box.width), dtype=bool)
+    for r, c in cells:
+        if box.top <= r <= box.bottom and box.left <= c <= box.right:
+            mask[r - box.top, c - box.left] = True
+    return mask
+
