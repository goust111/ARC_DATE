+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+ORANGE = 7
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 8, 9]
+MODES = ("ab", "bc", "both")
+MODE_WEIGHTS = (3, 3, 2)
