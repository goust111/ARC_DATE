+    for color in colors.values():
+        area = int(np.count_nonzero(scene == color))
+        if not (6 <= area <= 12):
+            return False
+        coords = np.argwhere(scene == color)
+        bbox = _bbox_coords(coords)
+        box = Box(bbox[0], bbox[1], bbox[2] - bbox[0] + 1, bbox[3] - bbox[1] + 1)
