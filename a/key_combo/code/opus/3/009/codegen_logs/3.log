+@dataclass(frozen=True)
+class Box:
+    top: int
+    left: int
+    height: int
+    width: int
+
+    @property
+    def bottom(self) -> int:
+        return self.top + self.height - 1
+
+    @property
+    def right(self) -> int:
+        return self.left + self.width - 1
+
+    @property
+    def rows(self) -> range:
+        return range(self.top, self.bottom + 1)
+
+    @property
+    def cols(self) -> range:
+        return range(self.left, self.right + 1)
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, np.unique(grid)))
+    if exclude is not None:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _flip_color_masks_vertical(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    out = np.full_like(g, bg)
+    for color in _colors_present(g, exclude={bg}):
+        coords = np.argwhere(g == color)
+        r0, _c0, r1, _c1 = _bbox_coords(coords)
+        rr = r0 + r1 - coords[:, 0]
+        cc = coords[:, 1]
+        out[rr, cc] = int(color)
+    return out
+
+
+def _adjacent_pairs(grid: np.ndarray, bg: int = BG) -> set[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    pairs: set[tuple[int, int]] = set()
+    for r in range(h):
+        for c in range(w):
+            a = int(g[r, c])
+            if a == bg:
+                continue
+            for rr, cc in ((r + 1, c), (r, c + 1)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    b = int(g[rr, cc])
+                    if b != bg and b != a:
+                        pairs.add(tuple(sorted((a, b))))
+    return pairs
+
+
+def _shared_black_cells_for_pair(
+    grid: np.ndarray, pair: tuple[int, int], bg: int = BG
+) -> set[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    a, b = map(int, pair)
+    cells: set[tuple[int, int]] = set()
+    for r in range(h):
+        for c in range(w):
+            if int(g[r, c]) != bg:
+                continue
+            neigh = set()
+            for rr, cc in _neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w:
+                    color = int(g[rr, cc])
+                    if color != bg:
