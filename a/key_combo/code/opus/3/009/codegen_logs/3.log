+def _make_boxes(mode: str) -> tuple[dict[str, Box], int, int]:
+    widths = {name: random.randint(3, 4) for name in ("a", "b", "c")}
+    heights = {name: random.randint(5, 6) for name in ("a", "b", "c")}
