+def _orange_targets(grid: np.ndarray, bg: int = BG) -> set[tuple[int, int]]:
+    targets: set[tuple[int, int]] = set()
+    for pair in _adjacent_pairs(grid, bg=bg):
+        targets |= _shared_black_cells_for_pair(grid, pair, bg=bg)
+    return targets
