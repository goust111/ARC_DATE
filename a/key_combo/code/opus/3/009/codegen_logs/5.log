GEN_PANEL_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
GEN_PANEL_COLOR_COUNTS = [1, 2]
GEN_PREFERRED_SEPARATOR_COLOR = 5
GEN_SEPARATOR_COLORS = list(range(1, 10))

# Animation counts and allowed motion.
GEN_FRAME_COUNT = 5
GEN_OBSERVED_FRAME_COUNT = 4

