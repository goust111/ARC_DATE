+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(mask.shape, r, c):
+            if mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
