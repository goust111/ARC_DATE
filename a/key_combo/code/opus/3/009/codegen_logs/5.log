+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+SEPARATOR = 6
+BITS = (1, 2, 4)
+PAIR_LABELS = {3: (0, 1), 5: (0, 2), 6: (1, 2)}
