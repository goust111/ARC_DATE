+
+    solid_rows = [
+        (r, int(g[r, 0]))
+        for r in range(h)
+        if np.all(g[r, :] == int(g[r, 0])) and int(g[r, 0]) != bg
+    ]
+    matches = []
+    for i in range(len(solid_rows)):
+        for j in range(i + 1, len(solid_rows)):
+            r0, color0 = solid_rows[i]
+            r1, color1 = solid_rows[j]
+            if color0 != color1:
