+def _labels_to_panels(labels: np.ndarray, colors: list[int]) -> list[np.ndarray]:
+    panels = []
+    for bit, color in zip(BITS, colors):
+        panel = np.full(labels.shape, BG, dtype=int)
+        panel[(labels & bit) != 0] = color
+        panels.append(panel)
+    return panels
+
