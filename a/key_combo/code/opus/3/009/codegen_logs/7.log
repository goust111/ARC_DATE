+
+
+def _extra_candidates(tile: np.ndarray) -> dict[str, list[tuple[int, int]]]:
+    tile_h, tile_w = tile.shape
+    reds = {tuple(map(int, rc)) for rc in np.argwhere(tile == RED)}
+    row_has_red = {r for r, _ in reds}
