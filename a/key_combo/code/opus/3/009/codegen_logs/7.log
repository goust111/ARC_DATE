+    elif mode == "pair_col":
+        col = random.randrange(3)
+        rows = sorted(random.sample(range(3), 2))
+        shared = random.choice(candidates["vert"])
+        extras_by_tile[(rows[0], col)] = {shared}
+        extras_by_tile[(rows[1], col)] = {shared}
