        endpoints.extend([(row, c0, color), (row, c1, color)])
    for color, col, r0, r1 in vertical:
        endpoints.extend([(r0, col, color), (r1, col, color)])
    if len({(r, c) for r, c, _ in endpoints}) != len(endpoints):
