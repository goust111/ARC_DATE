+        for meta, (r0, c0) in zip(sprite_meta, positions):
+            h, w = meta["shape"]
+            inp[r0 : r0 + h, c0 : c0 + w] = meta["raw"]
+
+        global_holes = {
+            dim: (tr0 + r0, tc0 + c0, tr0 + r1, tc0 + c1)
+            for dim, (r0, c0, r1, c1) in hole_boxes.items()
+        }
+        expected = _build_expected_output(
+            inp.shape,
+            template_bbox,
+            template_patch,
+            global_holes,
+            sprite_meta,
+            use_processed=True,
