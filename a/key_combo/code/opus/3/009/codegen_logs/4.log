+    candidate_c = int(pos[1] + delta[1])
+    final_r = _resolve_against_bounds(candidate_r, row_low, row_high, closed["top"], closed["bottom"])
+    final_c = _resolve_against_bounds(candidate_c, col_low, col_high, closed["left"], closed["right"])
