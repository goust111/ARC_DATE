    available_colors = [c for c in Color.NOT_BLACK if c != Color.GREEN and c != Color.TEAL]

    # Generate the 6x6 green sprite with random pattern.
    green_pattern = random_sprite(m=6, n=6, color_palette=[Color.GREEN], density=0.3)

