+        for idx in range(3)
+    ]
+    if not (deltas[0] == deltas[1] == deltas[2] == tuple(meta["delta"])):
+        return False
+
+    candidate = (positions[-1][0] + deltas[0][0], positions[-1][1] + deltas[0][1])
+    if candidate != tuple(meta["candidate"]):
