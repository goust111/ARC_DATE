+        return False
+    panels = _split_panels(inp)
+    if len(panels) != 4 or panels[0].shape[0] != PANEL_H:
+        return False
+    closed = [_closed_sides(panel) for panel in panels]
+    if len({_gap_side(side_flags) for side_flags in closed}) != 1:
