+def generate_input() -> np.ndarray:
+    family_specs = [
+        ("horizontal_bounce", ["left", "right"], [16, 18]),
+        ("vertical_bounce", ["top", "bottom"], list(range(12, 25))),
+        ("gap_and_bounce", ["top", "bottom"], list(range(12, 25))),
+    ]
