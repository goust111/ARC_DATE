+def _reflect_between(pos: int, low: int, high: int) -> int:
+    if low == high:
+        return int(low)
+    span = int(high - low)
+    period = 2 * span
+    phase = (int(pos) - int(low)) % period
+    if phase > span:
+        phase = period - phase
+    return int(low + phase)
+
+
+def _resolve_against_bounds(pos: int, low: int, high: int, closed_low: bool, closed_high: bool) -> int:
