+    next_pos = _predict_next_position(frame, sprites[-1], positions[-1], deltas[0])
+
+    output = frame.copy()
+    output[output == Color.RED] = Color.BLACK
+    paste(output, sprites[-1], next_pos[0], next_pos[1], transparent=Color.BLACK, clip=True)
+    return output
+
