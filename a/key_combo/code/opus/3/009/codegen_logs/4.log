+            delta = (int(row_seq["delta"]), int(col_seq["delta"]))
+            if delta == (0, 0):
+                continue
+            positions = [
+                (int(row_seq["positions"][step]), int(col_seq["positions"][step]))
+                for step in range(4)
+            ]
+            if len(set(positions)) != 4:
