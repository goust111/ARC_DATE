+        panel,
+        bg=Color.BLACK,
+        colors=[Color.RED],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    assert len(red_components) == 1, "expected exactly one red sprite"
+    red_box = bbox(panel == Color.RED)
+    assert red_box is not None and tuple(red_box) == tuple(red_components[0]["bbox"])
