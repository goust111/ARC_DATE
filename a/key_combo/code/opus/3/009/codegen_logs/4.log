+
+def _stack_panels(panels: list[np.ndarray]) -> np.ndarray:
+    rows = []
+    for idx, panel in enumerate(panels):
+        rows.append(panel)
+        if idx < len(panels) - 1:
+            rows.append(np.full((1, panel.shape[1]), SEPARATOR, dtype=int))
+    return np.vstack(rows)
