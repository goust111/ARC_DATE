+
+
+def _extract_sprite(panel: np.ndarray) -> tuple[np.ndarray, tuple[int, int]]:
+    red_components = find_components(
+        panel,
+        bg=Color.BLACK,
+        colors=[Color.RED],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
