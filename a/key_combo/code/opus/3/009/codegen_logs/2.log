+            rr, cc = random.choice(removable)
+            mask[rr, cc] = False
+        if (
+            8 <= int(mask.sum()) <= 20
+            and _touches_all_sides(mask)
+            and _is_connected(mask)
+            and _edge_anchor_candidates(mask)
