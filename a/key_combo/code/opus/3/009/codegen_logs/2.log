+            for r, c in np.argwhere(mask):
+                candidate = mask.copy()
+                candidate[int(r), int(c)] = False
+                if not _touches_all_sides(candidate):
+                    continue
+                if not _is_connected(candidate):
+                    continue
+                removable.append((int(r), int(c)))
+            if not removable:
