+
+def _extract_sprites(
+    grid: np.ndarray, template_bbox: tuple[int, int, int, int]
+) -> list[dict]:
+    r0, c0, r1, c1 = template_bbox
+    masked = np.array(grid, copy=True)
+    masked[r0 : r1 + 1, c0 : c1 + 1] = Color.BLACK
+    comps = find_components(
+        masked,
+        bg=Color.BLACK,
+        connectivity=4,
+        monochromatic=False,
+        return_format="dict",
