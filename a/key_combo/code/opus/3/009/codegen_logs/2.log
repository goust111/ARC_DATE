+                    candidates.append((r, c))
+        if not candidates:
+            return None
+        r, c = random.choice(candidates)
+        positions[idx] = (r, c)
+        blocked[max(0, r - 1) : min(template_h, r + h + 1), max(0, c - 1) : min(template_w, c + w + 1)] = True
