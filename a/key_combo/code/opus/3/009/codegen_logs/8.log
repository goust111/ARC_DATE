+        if not np.array_equal(out[half_h + 1 :, 1:], right_expected):
+            return False
+        if not np.all(out[half_h, :] == SEP):
+            return False
+        if not np.all(out[:half_h, width] == SEP):
+            return False
+        if not np.all(out[half_h + 1 :, 0] == SEP):
