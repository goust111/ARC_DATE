+    half_h = height // 2
+    top = _analyze_half(g[:half_h, :])
+    bottom = _analyze_half(g[half_h:, :])
+    if top["gap_side"] == bottom["gap_side"]:
+        raise ValueError("the two halves must have opposite notch sides")
