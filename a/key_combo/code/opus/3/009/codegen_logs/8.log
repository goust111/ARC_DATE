+        if _analyze_half(out[:half_h, :width])["bbox"][1] != 0:
+            return False
+        if _analyze_half(out[half_h + 1 :, 1:])["bbox"][3] != width - 1:
+            return False
+    except Exception:
+        return False
+    return True
