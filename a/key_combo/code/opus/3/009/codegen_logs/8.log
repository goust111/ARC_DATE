+    right_spans = _edge_gap_spans(mask[:, -1])
+    left_has = len(left_spans) == 1
+    right_has = len(right_spans) == 1
+    if left_has == right_has:
+        raise ValueError("gap side is not uniquely determined")
+    return "left" if left_has else "right"
+
+
