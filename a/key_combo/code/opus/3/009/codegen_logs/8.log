+def _edge_gap_spans(edge: np.ndarray) -> list[tuple[int, int]]:
+    ones = np.flatnonzero(edge == FG)
+    if len(ones) < 2:
+        return []
+    spans: list[tuple[int, int]] = []
+    start = int(ones[0])
+    end = int(ones[-1])
+    idx = start
+    while idx <= end:
