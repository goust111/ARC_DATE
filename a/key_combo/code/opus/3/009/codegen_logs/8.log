+    _, c0, _, c1 = info["bbox"]
+    dc = -c0 if gap_side == "left" else (width - 1 - c1)
+    out = np.array(half, dtype=int, copy=True)
+    coords = info["coords"]
+    out[coords[:, 0], coords[:, 1]] = BG
+    out[coords[:, 0], coords[:, 1] + dc] = FG
+    return out
+
