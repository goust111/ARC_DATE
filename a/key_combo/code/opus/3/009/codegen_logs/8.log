+def _generate_attempt() -> np.ndarray | None:
+    top_side = random.choice(["left", "right"])
+    bottom_side = "right" if top_side == "left" else "left"
+    top_patch = _sample_object(top_side)
+    bottom_patch = _sample_object(bottom_side)
