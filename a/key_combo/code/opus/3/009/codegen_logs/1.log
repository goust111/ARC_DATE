+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid_h = random.randint(*GRID_SIDE_RANGE)
+        grid_w = random.randint(*GRID_SIDE_RANGE)
+        n_objects = 4 if random.random() < 0.65 else 3
