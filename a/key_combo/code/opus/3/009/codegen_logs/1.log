+def _cells_from_mask(mask: np.ndarray, top_left: tuple[int, int]) -> frozenset[tuple[int, int]]:
+    r0, c0 = top_left
+    return frozenset((r0 + int(r), c0 + int(c)) for r, c in np.argwhere(mask))
