+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_SIDE_RANGE = (15, 20)
+MAX_GENERATION_ATTEMPTS = 800
+MAX_SHAPE_ATTEMPTS = 300
