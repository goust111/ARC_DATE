+            continue
+        if np.array_equal(full, _mirror_horizontal(full)):
+            continue
+        info = _analyze_sprite(full)
+        if info["axis"] != "vertical":
+            continue
+        if info["scores"]["vertical"] <= info["scores"]["horizontal"]:
