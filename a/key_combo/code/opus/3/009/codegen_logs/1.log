+    mask = spec["input_mask"]
+    h, w = mask.shape
+    side = spec["defect_side"]
+    candidates = []
+    for r0 in range(grid_h - h + 1):
+        if side == "top" and r0 > grid_h - h - 2:
+            continue
+        if side == "bottom" and r0 < 2:
+            continue
+        for c0 in range(grid_w - w + 1):
+            if side == "left" and c0 > grid_w - w - 2:
+                continue
+            if side == "right" and c0 < 2:
