+def _chebyshev_halo(cells: frozenset[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    halo = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                halo.add((r + dr, c + dc))
+    return frozenset(halo)
