    mid = w // 2
    patterns = []
    for bits in range(1 << (mid + 1)):
        left = [bool(bits & (1 << c)) for c in range(mid + 1)]
        row = np.array(left + left[:-1][::-1], dtype=bool)
        if not (row[0] and row[-1]):
