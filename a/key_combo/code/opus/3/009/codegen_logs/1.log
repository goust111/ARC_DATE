+def _analyze_sprite(mask: np.ndarray) -> dict:
+    vertical = _axis_stats(mask, "vertical")
+    horizontal = _axis_stats(mask, "horizontal")
+    ranked = sorted(
+        [vertical, horizontal],
+        key=lambda item: (item["overlap"], -item["mismatch"], item["imbalance"]),
+        reverse=True,
