+
+        dst = out[
+            dst_top_left[0] : dst_top_left[0] + sprite.shape[0],
+            dst_top_left[1] : dst_top_left[1] + sprite.shape[1],
+        ]
+        assert np.all(dst[completed] == bg)
+        dst[completed] = color
