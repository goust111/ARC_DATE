    return [(r, c), (r, cc)]


def _gen_orbit_blocked(cells, blocked):
    return any((r, c) in blocked for r, c in cells)


def _gen_has_neighbor(mask, cells):
    h, w = mask.shape
    for r, c in cells:
        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
                return True
    return False


