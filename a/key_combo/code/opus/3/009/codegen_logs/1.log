+        base = _build_vertical_base()
+        if base is None:
+            continue
+        full = base.T
+        info = _analyze_sprite(full)
+        if info["axis"] != "horizontal":
+            continue
+        if info["scores"]["horizontal"] <= info["scores"]["vertical"]:
+            continue
+        return full
+    return None
+
