+        top, left, bottom, right = box
+        height = int(bottom - top + 1)
+        width = int(right - left + 1)
+        if _region_branch(height, width) != spec["branch"]:
+            return False
+
+        patch = np.asarray(spec["patch"], dtype=int)
+        if not (5 <= int(np.count_nonzero(patch)) <= 12):
