  46: COLOR_COUNT_CHOICES = range(3, 6)
  47: COLOR_POOL = range(1, 10)
  48: 
  49: # Vertical band and mask dimensions.
  50: BORDER_SIZE = 1
  51: BAND_HEIGHT_RANGE = range(1, 5)
  52: MASK_WIDTH_MIN = 3
  53: MASK_WIDTH_MAX = 11
  54: MASK_WIDTH_STEP = 2
  55: 
  56: # Mask density, symmetry, and connectivity constraints.
  57: MIN_MASK_DENSITY = 0.39
  58: MAX_MASK_DENSITY = 1.0
  59: COMPONENT_COUNT_CHOICES = range(1, 6)
  60: COMPONENT_CONNECTIVITY = 4
  61: NONVERTICAL_MIN_HEIGHT = 2
  62: 
  63: # Retry limits.
  64: MASK_ATTEMPTS = 20
  65: GENERATE_ATTEMPTS = 300
