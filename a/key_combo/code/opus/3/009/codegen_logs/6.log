 109: def _nearby(r: int, c: int, dist: int, ref: set) -> bool:
 110:     """Return True if any pixel in `ref` is within Chebyshev distance `dist`."""
 111:     for dr in range(-dist, dist + 1):
 112:         for dc in range(-dist, dist + 1):
 113:             if (r + dr, c + dc) in ref:
 114:                 return True
 115:     return False
 116: 
 117: 
 118: def _exclusion_zone(pixels, dist: int) -> set:
 119:     """Return the set of all coords within Chebyshev `dist` of any pixel."""
 120:     zone = set()
 121:     for r, c in pixels:
 122:         for dr in range(-dist, dist + 1):
 123:             for dc in range(-dist, dist + 1):
 124:                 zone.add((r + dr, c + dc))
 125:     return zone
