+    used = np.zeros((grid_height, grid_width), dtype=bool)
+    positions: list[tuple[int, int] | None] = [None] * len(block_sizes)
+    order = sorted(range(len(block_sizes)), key=lambda idx: block_sizes[idx][0] * block_sizes[idx][1], reverse=True)
+    for idx in order:
