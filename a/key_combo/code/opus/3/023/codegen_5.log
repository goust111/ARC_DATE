+def generate_input() -> np.ndarray:
+    desired_n = _preferred_counter_value()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _build_candidate(desired_n)
+        if grid is not None and _semantic_checks(grid, desired_n):
