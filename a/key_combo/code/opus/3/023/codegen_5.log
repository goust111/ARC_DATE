        if placed >= target_cells:
            break
        options = _gen_cluster_options(grid, bg, frame_color, sprite_mask, 1, False)
        if not options:
            return False
        coords = random.choice(options)
        _gen_place_clutter_cluster(grid, coords, frame_color)
        placed += 1

