    if touch_sprite is True and not touches_sprite:
        return False
    return True


def _gen_cluster_options(grid, bg, frame_color, sprite_mask, size, touch_sprite):
    h, w = grid.shape
    options = set()
    bg_cells = [tuple(x) for x in np.argwhere(grid == bg)]

    if size == 1:
        options = {(cell,) for cell in bg_cells}
    elif size == 2:
