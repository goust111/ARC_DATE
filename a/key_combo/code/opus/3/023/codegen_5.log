+
+def _semantic_checks(grid: np.ndarray, n: int) -> bool:
+    if grid is None or grid.shape != (GRID_SIZE, GRID_SIZE):
+        return False
+    if not np.all(grid[:n, -1] == COUNTER_COLOR):
+        return False
+    if np.any(grid[n:, -1] == COUNTER_COLOR):
