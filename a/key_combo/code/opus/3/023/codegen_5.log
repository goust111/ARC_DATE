GRID_SIZE = 12
BG = int(Color.BLACK)
COUNTER_COLOR = int(Color.GREY)
CROSS_COLOR = int(Color.RED)
SPRITE_COLORS = [int(c) for c in (Color.BLUE, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON)]
MAX_GEN_ATTEMPTS = 500

