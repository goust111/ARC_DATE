+            strip_box,
+            rng,
+            style="tall",
+            left=col_shifted + 1,
+        )
+        if not ok:
+            return None
+        color_idx += 1
+        deep_needed = selected_count - 1
+    else:
+        deep_needed = selected_count
+
+    deep_box = (row_shifted + 1, col + 1, GRID_SIZE - 1, GRID_SIZE - 1)
+    if deep_needed <= 0:
