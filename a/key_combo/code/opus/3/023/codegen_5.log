+    crops = [crop_bbox(clean, tuple(map(int, comp["bbox"]))) for comp in selected]
+    max_h = max(int(crop.shape[0]) for crop in crops)
+    total_w = sum(int(crop.shape[1]) for crop in crops)
+    out = np.full((max_h, total_w), BG, dtype=int)
