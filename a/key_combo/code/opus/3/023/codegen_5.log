+    if not base_sig:
+        return False
+
+    no_shift_sig = _selection_signature(grid, row_shift=0, col_shift=0)
+    if no_shift_sig == base_sig:
+        return False
+
+    neighbor_counts = [k for k in {0, n - 1, n + 1} if 0 <= k <= 3 and k != n]
+    if not neighbor_counts:
+        return False
+    for k in neighbor_counts:
