+def _scene_without_guides(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    clean = g.copy()
+    clean[clean[:, -1] == COUNTER_COLOR, -1] = BG
+    cross = _locate_cross(clean)
+    _, row, col = cross
+    clean[row, :] = BG
+    clean[:, col] = BG
+    return clean, cross
