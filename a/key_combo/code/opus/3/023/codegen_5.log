+    width = c1 - c0 + 1
+    if width < 2:
+        return False
+    lengths = [L for L in (2, 3, 4) if L <= width]
+    rng.shuffle(lengths)
+    for length in lengths:
+        starts = list(range(c0, c1 - length + 2))
+        rng.shuffle(starts)
+        for start in starts:
+            mask = np.ones((1, length), dtype=bool)
