+    rows = [int(top)] if top is not None else list(range(r0, r1 - h + 2))
+    cols = [int(left)] if left is not None else list(range(c0, c1 - w + 2))
+    return [(r, c) for r in rows for c in cols if r0 <= r <= r1 - h + 1 and c0 <= c <= c1 - w + 1]
