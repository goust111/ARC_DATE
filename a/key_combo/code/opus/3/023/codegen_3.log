  "dst": "color layers d inside the tight-cropped board",
  "match_cond": "s.color == d.color",
  "transform": "np.rot90(d, -s.size) (clockwise)",
  "grid_shape": "tight-crop of the main board cluster"
}
</annotation>
</reference_puzzle>

