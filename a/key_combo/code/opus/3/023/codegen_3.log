+    raise RuntimeError(f"failed to find a same-signature non-rotational pair for side={side}")
+
+
+def _rotation_schedule(base_count: int) -> list[int]:
+    rots = [0, 1, 2, 3]
+    while len(rots) < base_count:
+        rots.append(random.randrange(4))
+    random.shuffle(rots)
