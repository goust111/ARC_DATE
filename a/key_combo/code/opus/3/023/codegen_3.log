+    size_hi = min(26, size_lo + 5 + (side - 4))
+    h = random.randint(size_lo, size_hi)
+    w = random.randint(size_lo, size_hi)
+
+    grid = _place_sprites((h, w), sprites)
+    if grid is None:
+        return None
+    return grid, odd_sprite, base_count
