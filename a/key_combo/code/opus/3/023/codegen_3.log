+            weights = []
+            for r, c in frontier_list:
+                weight = 1
+                if r in (0, side - 1):
+                    weight += 2
+                if c in (0, side - 1):
+                    weight += 2
+                if (r, c) in ((0, 0), (0, side - 1), (side - 1, 0), (side - 1, side - 1)):
+                    weight += 1
+                weights.append(weight)
+
+            nr, nc = random.choices(frontier_list, weights=weights, k=1)[0]
+            mask[nr, nc] = True
+
+        if int(mask.sum()) != area:
+            continue
+        if _is_valid_shape(mask):
