            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w:
                yield nr, nc


def _gen_random_interior_mask(d):
    n = d * d
    fill_count = random.randint(MIN_FILL_CELLS, n - 1)
    mask = np.zeros(n, dtype=bool)
    mask[random.sample(range(n), fill_count)] = True
