+def _solve_logical_grid(logical: np.ndarray) -> np.ndarray:
+    out = logical.copy()
+    components = find_components(
+        logical,
+        bg=BG,
+        colors=[MARKER],
+        connectivity=4,
+        monochromatic=True,
