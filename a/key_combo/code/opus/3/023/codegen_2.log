+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        plan = random.choice(PLANS)
+        orientation = random.choice(("vertical", "horizontal"))
+        grid, meta = _place_case(plan, orientation)
+        if _validate_case(grid, meta):
