+            anchor_axis = 2 + 4 * idx
+            span = tuple(range(anchor_axis - 1, anchor_axis + 2))
+            touches = [idx]
+    else:
+        if kind == "bridge":
+            anchor_axis = 4 * idx
+            span = tuple(range(anchor_axis - 1, anchor_axis + 2))
+            touches = [idx - 1, idx]
+        else:
+            anchor_axis = 2 + 4 * idx
+            span = tuple(range(anchor_axis - 1, anchor_axis + 2))
+            touches = [idx]
+
+    return {
+        "kind": kind,
+        "index": int(idx),
+        "anchor_axis": int(anchor_axis),
+        "span": span,
