+    {"name": "k4_tie3", "chambers": 4, "slots": (("bridge", 1), ("bridge", 2), ("bridge", 3)), "kind": "tie"},
+    {"name": "k4_major3", "chambers": 4, "slots": (("bridge", 1), ("single", 2), ("bridge", 3)), "kind": "majority"},
