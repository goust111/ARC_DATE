+
+
+def _import_arc_utils():
+    here = Path(__file__).resolve()
+    for parent in [here.parent, *here.parents]:
+        candidate = parent / "new" / "solvers" / "arc_utils.py"
+        if candidate.exists():
+            sys.path.insert(0, str(candidate.parent))
