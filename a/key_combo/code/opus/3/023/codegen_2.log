FOUR_WALL_ROWS = (0, 3, 6, 9)
WALL_COL_MIN = 1
WALL_COL_MAX = 8
WALL_COL_GAP_MIN = 3
WALL_COL_GAP_MAX = 5
WALL_COL_PAIRS = tuple(
