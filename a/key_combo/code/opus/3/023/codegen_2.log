def _gen_col_candidates(col_idx, wall_cols, row_bands, target):
    out = []
    for i, rows in enumerate(row_bands):
        if target[i][col_idx] != target[i][col_idx + 1]:
            continue
        color = target[i][col_idx]
        for r in rows:
            out.append((r, wall_cols[col_idx], color))
    random.shuffle(out)
