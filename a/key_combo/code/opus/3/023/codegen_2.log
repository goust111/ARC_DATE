+        return False
+    if {tuple(item["slot"]) for item in assignments} != {tuple(slot["slot_cell"]) for slot in meta["slots"]}:
+        return False
+
+    return np.array_equal(main(grid), expected)
+
+
+def generate_input() -> np.ndarray:
