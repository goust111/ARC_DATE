+        rec = dict(tmpl)
+        rec["side"] = side
+        rec["distance"] = int(dist)
+        rec["anchor_rel"] = anchor
+        rec["final_rel"] = final_rel
+        rec["direction"] = direction
+        assigned.append(rec)
