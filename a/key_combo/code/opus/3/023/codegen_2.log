+def _choose_fill_color(grid: np.ndarray, chamber: np.ndarray) -> int:
+    chamber_pts = [(int(r), int(c)) for r, c in chamber]
+    top_left = min(chamber_pts)
+    adjacent: dict[tuple[int, int], int] = {}
+    for r, c in chamber_pts:
