+        elif dr == 1 and dc == 0:
+            shift_r, shift_c = int(sr - r0), 0
+        elif dr == 0 and dc == -1:
+            shift_r, shift_c = 0, int(sc - c1)
+        else:
+            shift_r, shift_c = 0, int(sc - c0)
