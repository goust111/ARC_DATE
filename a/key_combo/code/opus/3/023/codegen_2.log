+    counts = Counter(adjacent.values())
+    top = max(counts.values())
+    winners = {color for color, count in counts.items() if count == top}
+    if len(winners) == 1:
+        return next(iter(winners))
+
+    best = min(
+        (
+            abs(r - top_left[0]) + abs(c - top_left[1]),
+            int(r),
+            int(c),
+            int(color),
