+        steps = int(max(abs(shift_r), abs(shift_c)))
+        step_r = _sign(shift_r)
+        step_c = _sign(shift_c)
+        for step in range(steps):
+            off_r = int(step * step_r)
+            off_c = int(step * step_c)
+            for r, c in comp["coords"]:
+                rr = int(r + off_r)
+                cc = int(c + off_c)
+                if in_bounds(out.shape, rr, cc):
+                    out[rr, cc] = BLACK
+
+        for r, c in comp["coords"]:
+            rr = int(r + shift_r)
+            cc = int(c + shift_c)
+            if in_bounds(out.shape, rr, cc):
