+def _bounce_ray(shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    coords = [(int(r), int(c))]
