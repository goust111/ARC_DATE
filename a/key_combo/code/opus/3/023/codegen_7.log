+    ar, ac = a
+    br, bc = b
+    dr = br - ar
+    dc = bc - ac
+    assert dr != 0 and abs(dr) == abs(dc)
+    sr, sc = _sign(dr), _sign(dc)
+    return [(ar + i * sr, ac + i * sc) for i in range(abs(dr) + 1)], (sr, sc)
