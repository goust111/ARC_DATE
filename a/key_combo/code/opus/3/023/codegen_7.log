+GEN_HEIGHT_RANGE = (12, 18)
+GEN_WIDTH_RANGE = (12, 18)
+GEN_SEGMENT_LEN_RANGE = (7, 11)
+GEN_BLOCKER_COUNTS = (2, 3)
+BLOCKER_COLORS = (Color.RED, Color.GREEN, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON)
+GEN_RETRY_LIMIT = 800
