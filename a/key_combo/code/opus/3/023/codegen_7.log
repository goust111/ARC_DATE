+
+
+def _render_straight_variant(g: np.ndarray, info: dict) -> np.ndarray:
+    out = np.array(g, dtype=int, copy=True)
+    for coord in info["segment"]:
+        if int(out[coord]) in (int(Color.BLACK), int(Color.BLUE)):
