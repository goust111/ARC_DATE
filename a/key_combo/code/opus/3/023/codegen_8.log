+        row_stop = height - h - margin
+        col_start = margin
+        col_stop = width - w - margin
+        if row_stop < row_start or col_stop < col_start:
+            return None
+        r_values = list(range(row_start, row_stop + 1))
+        c_values = list(range(col_start, col_stop + 1))
+
+    for r0 in r_values:
+        for c0 in c_values:
