+def _build_example(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
+    height = int(rng.integers(GRID_H_RANGE[0], GRID_H_RANGE[1] + 1))
+    width = int(rng.integers(GRID_W_RANGE[0], GRID_W_RANGE[1] + 1))
