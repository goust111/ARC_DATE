+def _apply_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    grid[int(r0) : int(r0) + h, int(c0) : int(c0) + w] = patch
+
+
+def _build_example(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
