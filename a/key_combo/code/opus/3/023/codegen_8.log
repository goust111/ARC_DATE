+BG = int(Color.BLACK)
+BLUE = int(Color.BLUE)
+RED = int(Color.RED)
+GREEN = int(Color.GREEN)
+YELLOW = int(Color.YELLOW)
+GREY = int(Color.GREY)
+PINK = int(Color.PINK)
+ORANGE = int(Color.ORANGE)
+TEAL = int(Color.TEAL)
+MAROON = int(Color.MAROON)
+
+PALETTE_POOL = (BLUE, RED, GREEN, YELLOW, TEAL, MAROON)
+SOURCE_MIN = 4
+SOURCE_MAX = 5
+GRID_H_RANGE = (19, 24)
+GRID_W_RANGE = (19, 24)
+MATCH_COUNT_RANGE = (3, 6)
