+    rect_interior_bbox = (rect_bbox[0] + 1, rect_bbox[1] + 1, rect_bbox[2] - 1, rect_bbox[3] - 1)
+    rect_interior_shape = (
+        rect_interior_bbox[2] - rect_interior_bbox[0] + 1,
+        rect_interior_bbox[3] - rect_interior_bbox[1] + 1,
