+def _draw_l_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
