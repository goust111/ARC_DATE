+    assert np.all(produced[case["rect_coords"][:, 0], case["rect_coords"][:, 1]] == ORANGE)
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    last_error: Exception | None = None
+    for _ in range(500):
