+    ir0, ic0, ir1, ic1 = case["rect_interior_bbox"]
+    stretched = _stretch_mask(case["matched"]["mask"], (ir1 - ir0 + 1, ic1 - ic0 + 1))
+    out[ir0 : ir1 + 1, ic0 : ic1 + 1][stretched] = int(case["matched"]["color"])
+    return out
