+
+def _draw_rect_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0] = ORANGE
+    grid[r0 : r1 + 1, c1] = ORANGE
+    grid[r0, c0 : c1 + 1] = ORANGE
+    grid[r1, c0 : c1 + 1] = ORANGE
