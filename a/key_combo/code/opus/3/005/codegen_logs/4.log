+def _boundary_ring(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    ring: list[tuple[int, int]] = []
+    for c in range(w):
+        ring.append((0, c))
+    for r in range(1, h):
+        ring.append((r, w - 1))
+    for c in range(w - 2, -1, -1):
+        ring.append((h - 1, c))
+    for r in range(h - 2, 0, -1):
+        ring.append((r, 0))
+    return ring
