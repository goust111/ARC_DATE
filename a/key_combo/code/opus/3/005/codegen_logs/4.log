+def _validate_case(grid: np.ndarray, meta: dict[str, Any]) -> bool:
+    expected = _render_from_parameters(
+        grid,
+        start=int(meta["start"]),
+        segment_len=int(meta["segment_len"]),
+        gap=2 * int(meta["marker_len"]),
