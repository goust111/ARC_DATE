+    return grid, {
+        "rows": rows,
+        "gaps": gaps,
+        "spans": spans,
+        "placements": placements,
+        "effects": effects,
+    }
+
+
+def _random_transform(grid: np.ndarray) -> np.ndarray:
+    out = grid
+    if random.random() < 0.5:
