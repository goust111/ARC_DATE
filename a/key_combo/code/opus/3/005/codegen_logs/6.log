+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+WALL = 5
+MAROON = 9
+
+CARDINAL_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAGONAL_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+ALL_PROJECTILE_DIRS = DIAGONAL_DIRS + CARDINAL_DIRS
+SPRITE_COLORS = (2, 3, 4, 7)
