+    else:
+        increment_choices = [(1, 1, 1), (1, 1, 2), (1, 2, 1), (2, 1, 1)]
+
+    g0 = random.choice([2, 3])
+    incs = list(random.choice(increment_choices))
+    gaps = [g0]
+    for inc in incs:
