+    height_max = max(height_min, min(17, height_min + 2))
+    height = random.randint(height_min, height_max)
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[0, g0] = MARKER
+
+    spans: list[tuple[int, int, tuple[int, ...]]] = []
+    for i, row in enumerate(rows):
+        if i == 0:
