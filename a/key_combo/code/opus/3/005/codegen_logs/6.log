+    maroons: set[Coord] = set()
+    closed_gaps: list[Coord] = []
+    wall_hits: list[Coord] = []
+    sprite_hits: list[Coord] = []
+    projectile_info: list[dict] = []
+
+    for sprite in sprites:
+        ar, ac = sprite["apex"]
+        dr, dc = sprite["dir"]
+        rr = ar + 5 * dr
