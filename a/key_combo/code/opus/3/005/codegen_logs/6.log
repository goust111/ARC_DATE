+
+    h, w = g.shape
+    out = g.copy()
+    stack: list[Coord] = [start]
+    seen: set[Coord] = set()
+    wall_hits = 0
+    openings_used = 0
+
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        out[r, c] = MARKER
+        cr, cc = r, c
+
+        while True:
+            nr, nc = cr + dr, cc + dc
+            if not _in_bounds(g.shape, nr, nc):
+                break
+            nxt = int(g[nr, nc])
+            if nxt == MAROON:
+                break
+            if nxt != WALL:
+                out[nr, nc] = MARKER
+                cr, cc = nr, nc
+                continue
+
+            wall_hits += 1
+            if dr != 0:
+                wall_r = nr
+                lo = hi = nc
+                while lo - 1 >= 0 and g[wall_r, lo - 1] == WALL:
+                    lo -= 1
+                while hi + 1 < w and g[wall_r, hi + 1] == WALL:
+                    hi += 1
+
+                for x in range(max(0, lo - 1), min(w - 1, hi + 1) + 1):
