+                    hi += 1
+
+                for y in range(max(0, lo - 1), min(h - 1, hi + 1) + 1):
+                    if g[y, cc] != WALL and g[y, cc] != MAROON:
+                        out[y, cc] = MARKER
+                for y in (lo - 1, hi + 1):
