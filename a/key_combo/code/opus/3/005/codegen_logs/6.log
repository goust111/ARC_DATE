+        if _in_bounds(g.shape, rr, cc):
+            cell = int(g[rr, cc])
+            if cell == BG:
+                new_walls.add((rr, cc))
+                info["kind"] = "new_wall"
+                # In this task all intentional background landings are wall gaps or open space.
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(g.shape, nr, nc) and g[nr, nc] == WALL:
