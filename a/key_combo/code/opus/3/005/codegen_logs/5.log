+    if not active_ring_indices:
+        return new_colors
+    for i, ring_idx in enumerate(active_ring_indices):
+        next_idx = active_ring_indices[(i + 1) % len(active_ring_indices)]
+        new_colors[ring_idx] = rings[next_idx]["color"]
+    return new_colors
