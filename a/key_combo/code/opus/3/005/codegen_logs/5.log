+    prev = pos
+    cur = pos
+    while True:
+        cur = (cur[0] + dr, cur[1] + dc)
+        if not in_bounds(shape, cur[0], cur[1]):
+            return None
+        if cur in target_cells:
+            return prev
+        prev = cur
+        if (dr and cur[0] == center[0]) or (dc and cur[1] == center[1]):
