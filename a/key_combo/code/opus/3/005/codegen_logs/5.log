+        if not any(group["side"] in HORIZONTAL_SIDES for group in groups):
+            groups.append(
+                {
+                    "ring_idx": random.choice(active_ring_indices),
+                    "side": random.choice(HORIZONTAL_SIDES),
+                    "count": 1,
+                }
