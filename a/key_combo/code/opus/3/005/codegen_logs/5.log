+        lanes = list(range(r0, r1 + 1))
+    else:
+        lanes = list(range(c0, c1 + 1))
+    random.shuffle(lanes)
+    return lanes
+
+
+def _place_group(
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    outer_margin: int,
+    ring_bbox: tuple[int, int, int, int],
