+                    "color": int(comp["color"]),
+                    "bbox": ring_bbox,
+                    "cells": cells,
+                }
+            )
+            continue
+
+        if int(comp["area"]) == 1:
+            r, c = map(int, comp["coords"][0])
+            pixels.append({"pos": (r, c), "color": int(comp["color"])})
+
+    rings.sort(
+        key=lambda ring: (
+            ring["bbox"][0],
+            ring["bbox"][1],
+            -(ring["bbox"][2] - ring["bbox"][0]),
