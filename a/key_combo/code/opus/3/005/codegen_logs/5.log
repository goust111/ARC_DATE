+    for pixel in meta["pixels"]:
+        out[pixel["start"]] = Color.BLACK
+    rotated_colors = _rotated_ring_colors(meta["rings"], meta["active_ring_indices"])
+    for ring_idx, ring in enumerate(meta["rings"]):
