+def _movement_step(pos: tuple[int, int], center: tuple[int, int]) -> tuple[int, int]:
+    r, c = pos
+    cr, cc = center
+    if abs(c - cc) >= abs(r - cr):
+        return (0, 1 if c < cc else -1)
+    return (1 if r < cr else -1, 0)
