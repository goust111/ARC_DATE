+RING_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW]
+HORIZONTAL_SIDES = ("left", "right")
+VERTICAL_SIDES = ("top", "bottom")
+ALL_SIDES = HORIZONTAL_SIDES + VERTICAL_SIDES
