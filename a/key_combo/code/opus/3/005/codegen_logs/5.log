+            if not in_bounds(shape, stop[0], stop[1]):
+                stop = None
+                break
+        if stop is None:
+            continue
+        occupied.add(stop)
+        activated.add(ring_idx)
+        settled.append(
+            {
+                "start": pixel["pos"],
+                "stop": stop,
+                "color": pixel["color"],
+                "ring_idx": ring_idx,
+            }
