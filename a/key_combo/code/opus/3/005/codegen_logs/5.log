+def _extract_structure(grid: np.ndarray) -> tuple[list[dict], list[dict], int]:
+    bg = int(get_bg(grid))
+    comps = find_components(grid, bg=bg, connectivity=4, monochromatic=True)
+    rings: list[dict] = []
+    pixels: list[dict] = []
