+    target_cells: set[tuple[int, int]],
+    center: tuple[int, int],
+) -> tuple[int, int] | None:
+    dr, dc = _movement_step(pos, center)
+    prev = pos
+    cur = pos
+    while True:
+        cur = (cur[0] + dr, cur[1] + dc)
+        if not in_bounds(shape, cur[0], cur[1]):
+            return None
+        if cur in target_cells:
