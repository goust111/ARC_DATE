+        return False
+    ring_cells = set().union(*(ring["cells"] for ring in meta["rings"]))
+    if len({pixel["stop"] for pixel in meta["pixels"]}) != len(meta["pixels"]):
+        return False
+    for pixel in meta["pixels"]:
+        if pixel["stop"] in ring_cells:
