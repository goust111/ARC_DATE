+    used_starts: set[tuple[int, int]],
+    used_lanes: set[tuple[int, str, int]],
+) -> tuple[list[tuple[int, int]], int] | None:
+    for lane in _candidate_lanes(ring_bbox, side):
+        if (ring_idx, side, lane) in used_lanes:
+            continue
