+def _rect_ring_bbox(comp: dict) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return None
+    expected_area = 2 * (h + w) - 4
+    if int(comp["area"]) != expected_area:
+        return None
+    coords = comp["coords"]
+    if not np.all(
+        (coords[:, 0] == r0)
+        | (coords[:, 0] == r1)
+        | (coords[:, 1] == c0)
+        | (coords[:, 1] == c1)
+    ):
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
