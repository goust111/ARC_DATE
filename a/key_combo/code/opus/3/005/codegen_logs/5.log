+    for lane in _candidate_lanes(ring_bbox, side):
+        starts: list[tuple[int, int]] = []
+        for slot in _side_slots(side, shape, outer_margin):
+            if side == "left":
+                candidate = (lane, slot)
+            elif side == "right":
+                candidate = (lane, slot)
+            elif side == "top":
