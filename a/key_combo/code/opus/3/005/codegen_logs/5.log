+        target_ring = rings[ring_idx]
+        base_stop = _scan_base_stop(shape, pixel["pos"], target_ring["cells"], center)
+        if base_stop is None:
+            continue
+        dr, dc = _movement_step(pixel["pos"], center)
+        stop = base_stop
