+    settled: list[dict] = []
+    occupied: set[tuple[int, int]] = set()
+    activated: set[int] = set()
+
+    ordered_pixels = sorted(pixels, key=lambda pixel: (abs(pixel["pos"][0] - center[0]) + abs(pixel["pos"][1] - center[1]), pixel["pos"][0], pixel["pos"][1]))
