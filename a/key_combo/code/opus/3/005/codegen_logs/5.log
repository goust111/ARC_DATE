+        return False
+    for pixel in meta["pixels"]:
+        if pixel["stop"] in ring_cells:
+            return False
+        if tuple(pixel["start"]) == tuple(pixel["stop"]):
+            continue
+        if int(out[pixel["start"]]) != Color.BLACK:
+            return False
+        if int(out[pixel["stop"]]) != pixel["color"]:
+            return False
+    return True
+
+
+def _generate_case() -> tuple[np.ndarray, dict]:
+    for _ in range(400):
