+def _candidate_lanes(ring_bbox: tuple[int, int, int, int], side: str) -> list[int]:
+    r0, c0, r1, c1 = ring_bbox
+    if side in HORIZONTAL_SIDES:
+        lanes = list(range(r0, r1 + 1))
+    else:
+        lanes = list(range(c0, c1 + 1))
