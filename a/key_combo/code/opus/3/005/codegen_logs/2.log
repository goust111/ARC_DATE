+    g = info["grid"]
+    sep = int(info["sep"])
+    tall_height = int(info["tall_height"])
+    short_height = int(info["short_height"])
+    tall_bar = info["tall_bar"]
+    short_bar = info["short_bar"]
+    tall_cols = info["tall_cols"]
+    short_cols = info["short_cols"]
