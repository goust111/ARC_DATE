+BLUE = 1
+RED = 2
+GRAY = 5
+SEPARATOR = 7
+ENCODING_PALETTE = (1, 2, 3, 4, 6)
+BAR_HEIGHTS = tuple(range(3, 11))
+MIN_BARS = 5
+MAX_BARS = 7
+MAX_SIZE = 30
+RETRY_LIMIT = 400
