+    out = g.copy()
+    out[:sep] = np.where(out[:sep] == GRAY, BG, out[:sep])
+    out[sep - tall_height : sep, int(tall_bar["col"])] = BLUE
+    out[sep - short_height : sep, int(short_bar["col"])] = RED
