+
+    try:
+        encoding = _layout_encoding_row(width, counts, tall_colors, short_colors, bar_cols, tall_col, short_col)
+    except Exception:
+        return None
+
+    top_margin = random.randint(0, 4)
+    sep = tall_height + top_margin
+    height = sep + 2 + random.randint(1, 4)
+    if height > MAX_SIZE:
