+        if c + 1 < grid.shape[1]:
+            assert not np.any(grid[row0:sep, c + 1] == GRAY), "bars must be one column wide"
+        gray_pixels += height
+        bars.append({"col": c, "height": height, "row0": row0})
+
+    assert int(np.count_nonzero(top == GRAY)) == gray_pixels, "unexpected stray gray pixels"
