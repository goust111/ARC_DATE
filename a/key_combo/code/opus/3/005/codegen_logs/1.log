+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+TEAL = 8
+
+GEN_PIXEL_COLORS = (BLUE, GREEN, YELLOW)
+DIR_DOWN = "down"
+DIR_RIGHT = "right"
+ORIENT_NWSE = "nwse"
+ORIENT_NESW = "nesw"
