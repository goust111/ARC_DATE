+    meta = {
+        "direction": DIR_DOWN,
+        "colors": {"a": color_a, "b": color_b, "c": color_c},
+        "source_a": src_a,
+        "source_b": src_b,
+        "source_c": src_c,
+        "a_final": a_final,
+        "b_final": b_final,
+        "row_a": row_a,
+        "row_b": row_b,
+        "col_a": col_a,
+        "major_cells": major_cells,
+        "minor_cells": minor_cells,
+    }
+    return grid, meta
+
+
+def _build_right_case(rng: random.Random, h: int, w: int) -> tuple[np.ndarray, dict]:
