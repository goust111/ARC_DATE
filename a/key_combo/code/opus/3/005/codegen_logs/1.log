+        "colors": {"a": color_a, "b": color_b, "c": color_c},
+        "source_a": src_a,
+        "source_b": src_b,
+        "source_c": src_c,
+        "a_final": a_final,
+        "b_final": b_final,
+        "row_a": row_a,
+        "col_a": col_a,
+        "col_b": col_b,
