+        c = int(c)
+        has_nwse = (
+            (_in_bounds(g.shape, r - 1, c - 1) and g[r - 1, c - 1] == GRAY)
+            or (_in_bounds(g.shape, r + 1, c + 1) and g[r + 1, c + 1] == GRAY)
+        )
+        has_nesw = (
+            (_in_bounds(g.shape, r - 1, c + 1) and g[r - 1, c + 1] == GRAY)
+            or (_in_bounds(g.shape, r + 1, c - 1) and g[r + 1, c - 1] == GRAY)
+        )
+        assert has_nwse != has_nesw, "every gray pixel must belong to exactly one diagonal orientation"
+        if has_nwse:
