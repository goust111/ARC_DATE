+    grid[:, col_a] = color_a
+    grid[row_b, :] = color_b
+
+    src_a = (src_a_row, shared_col)
+    src_b = (src_b_row, shared_col)
+    src_c = (src_c_row, src_c_col)
+    grid[src_a] = color_a
+    grid[src_b] = color_b
+    grid[src_c] = color_c
+
+    a_final = (row_a - 1, shared_col)
+    b_final = (row_a - 2, shared_col)
+    protected = _halo([src_a, src_b, src_c, a_final, b_final], grid.shape)
