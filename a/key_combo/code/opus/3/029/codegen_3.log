+        rect_h = random.choice(RECT_HEIGHT_CHOICES)
+        rect_w = random.choice(RECT_WIDTH_CHOICES)
+        candidates: list[tuple[int, int]] = []
+        for r0 in range(zr0, zr1 - rect_h + 2):
