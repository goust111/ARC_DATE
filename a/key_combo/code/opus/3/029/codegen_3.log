+def _scene_attempt() -> np.ndarray | None:
+    frame_count = random.choice(FRAME_COUNT_CHOICES)
+    layout = _row_layout(frame_count) if random.random() < 0.5 else _column_layout(frame_count)
+    if layout is None:
+        return None
+    height, width, frames, zone = layout
