+def _gap_direction(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r, c = gap
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return -1, 0
+    if r == r1:
+        return 1, 0
+    if c == c0:
+        return 0, -1
+    if c == c1:
+        return 0, 1
+    raise ValueError("gap is not on the frame border")
