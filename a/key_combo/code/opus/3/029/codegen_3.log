+        for other in frames[idx + 1 :]:
+            br0, bc0, br1, bc1 = other["bbox"]
+            row_sep = ar1 < br0 - 1 or br1 < ar0 - 1
+            col_sep = ac1 < bc0 - 1 or bc1 < ac0 - 1
