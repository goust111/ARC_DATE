+def _frame_bbox_mask(shape: tuple[int, int], frames: list[dict]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
