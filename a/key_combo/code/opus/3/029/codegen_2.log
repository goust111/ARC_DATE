+def _random_tile(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        tile_h, tile_w = ((2, 2), (2, 3), (3, 2))[int(rng.integers(0, 3))]
+        area = tile_h * tile_w
