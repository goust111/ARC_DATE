+def _aligned_starts(start: int, span: int, tile_len: int, phase: int) -> list[int]:
+    out = []
+    end = start + span - tile_len
+    for pos in range(start, end + 1):
+        if (pos - phase) % tile_len == 0:
+            out.append(pos)
+    return out
+
