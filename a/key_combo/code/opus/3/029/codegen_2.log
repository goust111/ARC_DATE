+    queue = deque([0])
+    while queue:
+        idx = queue.popleft()
+        base_r, base_c = placements[idx]
+        for nbr, (dr, dc), _order_idx in sorted(adjacency[idx], key=lambda item: item[2]):
+            pos = (base_r + dr, base_c + dc)
+            if nbr in placements:
