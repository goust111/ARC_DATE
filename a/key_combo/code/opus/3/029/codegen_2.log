+    first_occurrence: dict[int, tuple[int, int]] = {}
+    for rr, cc in np.argwhere(np.isin(g, CONNECTOR_COLORS)):
+        color = int(g[int(rr), int(cc)])
+        first_occurrence.setdefault(color, (int(rr), int(cc)))
