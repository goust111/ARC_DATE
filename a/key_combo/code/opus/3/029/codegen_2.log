+from __future__ import annotations
+
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BG = 5
+BLUE = 1
+WALL = 2
+CONNECTOR_COLORS = (3, 4, 7)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDE_TO_DIR = {"T": (-1, 0), "B": (1, 0), "L": (0, -1), "R": (0, 1)}
+OPPOSITE = {"T": "B", "B": "T", "L": "R", "R": "L"}
+TREE_SHAPES = {
+    3: [
