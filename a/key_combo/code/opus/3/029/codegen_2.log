+        [(0, 1), (0, 2)],
+    ],
+    4: [
+        [(0, 1), (1, 2), (2, 3)],
+        [(0, 1), (0, 2), (2, 3)],
+        [(0, 1), (1, 2), (0, 3)],
+    ],
+}
