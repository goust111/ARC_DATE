+def _interior_regions(grid: np.ndarray, blockers: tuple[int, ...]) -> list[np.ndarray]:
+    mask = ~np.isin(grid, blockers)
+    return [coords for coords in _components(mask) if not _touches_edge(coords, grid.shape)]
