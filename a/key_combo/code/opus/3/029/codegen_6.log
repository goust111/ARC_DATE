+def _rect_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 0) -> bool:
+    ar0, ac0, ar1, ac1 = map(int, a)
+    br0, bc0, br1, bc1 = map(int, b)
+    return not (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
