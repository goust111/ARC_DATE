+def _gap_choice(side: str, inner_shape: tuple[int, int], idx: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    inner_h, inner_w = map(int, inner_shape)
+    if side == "top":
+        return (0, idx), (0, idx)
+    if side == "bottom":
+        return (inner_h - 1, idx), (inner_h - 1, idx)
+    if side == "left":
