+    ir0, ic0, ir1, ic1 = frame["inner_bbox"]
+    out[ir0 : ir1 + 1, ic0 : ic1 + 1] = assembled
+    dr, dc = frame["outward"]
+    r, c = frame["gap"]
+    while 0 <= r < out.shape[0] and 0 <= c < out.shape[1]:
