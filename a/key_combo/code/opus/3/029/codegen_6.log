+    ir0, ic0, ir1, ic1 = frame["inner_bbox"]
+    out[ir0 : ir1 + 1, ic0 : ic1 + 1] = solution["assembled"]
+
+    spill_r, spill_c = frame["inner_cell"]
+    spill_color = int(out[spill_r, spill_c])
+    assert spill_color in (BLUE, RED)
