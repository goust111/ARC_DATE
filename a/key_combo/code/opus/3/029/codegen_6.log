+def _ray_cells(frame_bbox: tuple[int, int, int, int], gap: tuple[int, int], outward: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    r, c = map(int, gap)
+    dr, dc = map(int, outward)
+    cells = []
+    while 0 <= r < h and 0 <= c < w:
+        cells.append((r, c))
+        r += dr
+        c += dc
+    return cells
+
