+def _neighbor_cells(cell: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    h, w = shape
+    result = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            result.append((rr, cc))
+    return result
+
