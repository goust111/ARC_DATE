+    elif side == "bottom":
+        gap = (top + frame_h - 1, left + 1 + gap_idx)
+    elif side == "left":
+        gap = (top + 1 + gap_idx, left)
+    else:
+        gap = (top + 1 + gap_idx, left + frame_w - 1)
+    frame = {
+        "bbox": frame_bbox,
+        "inner_bbox": inner_bbox,
+        "gap": gap,
