+def _solve_instance(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    frame = _find_frame(g)
+    blue = _extract_sprite(g, BLUE, frame["bbox"])
+    red = _extract_sprite(g, RED, frame["bbox"])
