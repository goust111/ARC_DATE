+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+def _ensure_arc_utils_on_path() -> None:
+    try:
+        import arc_utils  # noqa: F401
+        return
+    except ModuleNotFoundError:
+        pass
+
+    here = Path(__file__).resolve()
