+        "shape": (h, w),
+        "pairs": pairs,
+        "selected_rows": (r0, r1),
+        "selected_cols": (c0, c1),
+        "controls": controls,
+    }
+
+    band_mask = np.zeros(g.shape, dtype=bool)
+    band_mask[r0 : r1 + 1, :] = True
+    band_mask[:, c0 : c1 + 1] = True
