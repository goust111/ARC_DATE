+        if SOURCE_COLORS[0] not in controls.values()
+        else SOURCE_COLORS[1]
+    )
+    controls[inactive_cols[0]] = int(other_source)
+    controls[inactive_cols[1]] = int(rng.choice(SOURCE_COLORS))
