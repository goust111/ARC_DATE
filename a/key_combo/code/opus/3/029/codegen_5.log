+        active_color = int(rng.choice(SOURCE_COLORS))
+        controls[active_col] = active_color
+
+    inactive_cols = [int(rng.choice(nonselected_lattice_cols)), int(rng.choice(nonselected_non_lattice_cols))]
+    other_source = (
