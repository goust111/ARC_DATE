+    g = info["grid"]
+    r0, r1 = info["selected_rows"]
+    c0, c1 = info["selected_cols"]
+    controls = info["controls"]
+
+    out = g.copy()
+    selected_mask = np.zeros(g.shape, dtype=bool)
