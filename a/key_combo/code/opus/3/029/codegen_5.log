+        for c, _src, _fill, _priority in controls
+    )
+    if not inactive_lattice or not inactive_non_lattice:
+        return False
+
+    if np.array_equal(truth, bands_only):
+        return False
+    if np.array_equal(truth, all_controls):
+        return False
+    if np.array_equal(truth, identity_rays):
