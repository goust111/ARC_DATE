import random, collections
TARGET_COUNTS=list(range(9))
BAR_HEIGHTS=(2,3,4)

def out_offset(row, r0, r1, h):
    if row < r0:
        return ((r0 - 1 - row)//h)+1
    if row > r1:
        return ((row - r1 - 1)//h)+1
    return 0

def render(tile_size,pairs):
    claims={}
    for idx,(h,r0,lc,rc) in enumerate(pairs, start=1):
        r1=r0+h-1
        for row in range(tile_size):
            off=out_offset(row,r0,r1,h)
            for col,d in ((lc,-1),(rc,1)):
                cc=col+d*off
                if 0<=cc<tile_size:
                    claims.setdefault((row,cc), set()).add(idx)
    return sum(len(v)>1 for v in claims.values())

def sample(tile_size):
    h1,h2=random.sample(BAR_HEIGHTS,2)
    r01=random.randint(0,tile_size-h1)
    r02=random.randint(0,tile_size-h2)
    cols=random.sample(range(tile_size),4)
    lc1,rc1=sorted(cols[:2])
    lc2,rc2=sorted(cols[2:])
    return ((h1,r01,lc1,rc1),(h2,r02,lc2,rc2))

def meta(p):
    (h1,r1,l1,rcol1),(h2,r2,l2,rcol2)=p
    a=(r1,r1+h1-1); b=(r2,r2+h2-1)
    row_overlap=max(0, min(a[1],b[1])-max(a[0],b[0])+1)
    return {
        'height_sig': tuple(sorted((h1,h2))),
        'gap_sig': tuple(sorted((rcol1-l1, rcol2-l2))),
        'row_sig': row_overlap,
    }

def build(tile_size):
    pools=collections.defaultdict(list)
    attempts=0
    while attempts<50000 and any(len(pools[c])<25 for c in TARGET_COUNTS):
        attempts+=1
        p=sample(tile_size)
        c=render(tile_size,p)
        if c in TARGET_COUNTS:
            m=meta(p)
            key=(p,m['height_sig'],m['gap_sig'],m['row_sig'])
            if key not in {(x['pairs'],x['height_sig'],x['gap_sig'],x['row_sig']) for x in pools[c]}:
                pools[c].append({'pairs':p,'count':c,**m})
    print('tile',tile_size,{c:len(pools[c]) for c in TARGET_COUNTS},'attempts',attempts)
    return pools

def valid(sel):
    def has_dup(key):
        seen={}
        for item in sel:
            v=item[key]
            if v in seen and seen[v]"'!=item['"'count']:
                return True
            seen[v]=item['count']
        return False
    def has_pair(*keys):
        seen={}
        for item in sel:
            v=tuple(item[k] for k in keys)
            if v in seen and seen[v]"'!=item['"'count']:
                return True
