+    ordered_tiles = [tile for _count, tile in sorted(zip(counts, expanded_tiles, strict=False), key=lambda item: item[0])]
+    out_tiles = [out[r0:r1, c0:c1] for r0, r1 in row_segments for c0, c1 in col_segments]
