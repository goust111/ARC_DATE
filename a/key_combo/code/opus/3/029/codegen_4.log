+            tile[row, col] = next(iter(claim_colors))
+        else:
+            tile[row, col] = MAGENTA
+            overlap += 1
+    return tile, overlap
+
+
+def _render_input_tile(
+    tile_size: int,
+    pair_specs: tuple[tuple[int, int, int, int], tuple[int, int, int, int]],
+    colors: tuple[int, int],
