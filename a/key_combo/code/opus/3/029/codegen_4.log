+        "gap_sig": tuple(sorted((pair_a[3] - pair_a[2], pair_b[3] - pair_b[2]))),
+        "row_sig": _interval_overlap_len(pair_a[0], pair_a[1], pair_b[0], pair_b[1]),
+        "pixel_count": 2 * (h1 + h2),
