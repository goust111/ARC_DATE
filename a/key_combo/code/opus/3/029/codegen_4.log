+        lambda item: item["pixel_count"],
+    )
+    assert _has_duplicate_signature(
+        [{"count": count, **feature} for count, feature in zip(counts, features, strict=False)],
+        lambda item: item["height_sig"],
+    )
+    assert _has_duplicate_signature(
+        [{"count": count, **feature} for count, feature in zip(counts, features, strict=False)],
+        lambda item: (item["height_sig"], item["gap_sig"]),
