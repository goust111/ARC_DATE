+    return pools
+
+
+def _has_duplicate_signature(
+    candidates: list[dict[str, object]],
+    key_fn,
+) -> bool:
+    seen: dict[object, int] = {}
+    for candidate in candidates:
+        key = key_fn(candidate)
+        count = int(candidate["count"])
+        if key in seen and seen[key] != count:
