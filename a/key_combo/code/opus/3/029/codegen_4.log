+            r0, r1 = row_segments[slot_index // 3]
+            c0, c1 = col_segments[slot_index % 3]
+            grid[r0:r1, c0:c1] = tile
+
+        try:
+            _validate_instance(grid)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid tile-overlap sorting input")

