+    repaired_walls = _render_walls((grid_h, total_w), basins, show_holes=False)
+    broken_walls = _render_walls((grid_h, total_w), basins, show_holes=False)
+    input_walls = _render_walls((grid_h, total_w), basins, show_holes=True)
