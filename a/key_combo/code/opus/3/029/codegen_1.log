+            return False
+
+        expected = repaired_walls.copy()
+        for pos, color in zip(fixed_positions, final_colors, strict=True):
+            expected[pos] = int(color)
+        if not np.array_equal(out, expected):
+            return False
+        return True
+    except Exception:
+        return False
+
+
+def generate_input() -> np.ndarray:
