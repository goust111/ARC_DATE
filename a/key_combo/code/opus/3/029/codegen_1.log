+
+    holes_global = tuple((int(top + r), int(left + c)) for r, c in holes_local)
+    return Basin(
+        color=int(color),
+        top=int(top),
+        left=int(left),
+        mask=mask,
+        left_profile=tuple(map(int, left_profile)),
+        holes=holes_global,
+    )
+
