+
+
+def _candidate_holes(mask: np.ndarray, left_profile: tuple[int, ...]) -> tuple[list[Coord], list[Coord]]:
+    height, width = mask.shape
+    left_cells: list[Coord] = []
+    right_cells: list[Coord] = []
