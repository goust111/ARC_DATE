+def _touch_color(walls: np.ndarray, pos: Coord) -> int:
+    r, c = map(int, pos)
+    colors = {
+        int(walls[nr, nc])
+        for nr, nc in _neighbors4(r, c)
+        if _in_bounds(walls.shape, nr, nc) and int(walls[nr, nc]) != BG
