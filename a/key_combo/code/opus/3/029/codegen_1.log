+    if total_w > 30:
+        return None
+
+    height_min = max(16, max(heights) + 7)
+    height_max = min(28, max(heights) + 12)
+    grid_h = int(rng.integers(height_min, height_max + 1))
+    bottom = int(grid_h - rng.integers(2, 4))
