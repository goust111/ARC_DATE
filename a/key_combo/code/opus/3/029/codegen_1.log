        basins.append(basin)
        if idx < basin_count-1:
            cursor += int(widths[idx] + gaps[idx])
    repaired = mod._render_walls((grid_h,total_w), basins, show_holes=False)
    broken = mod._render_walls((grid_h,total_w), basins, show_holes=False)
    input_walls = mod._render_walls((grid_h,total_w), basins, show_holes=True)
    for basin in basins:
        for r,c in basin.holes:
            broken[r,c]=0
    for b in basins:
        starts = mod._isolated_bg_cells(input_walls, b)
        print(' basin', b.color, b.bbox, 'holes', b.holes, 'isolated starts', len(starts))
        good=diag=repair=0
        for s in starts:
            cand = mod._single_drop_candidate(repaired, broken, b, s)
            if cand is not None:
                good += 1
                diag += int(cand['diag'])
                repair += int(cand['repair_needed'])
        print('   good', good, 'diag', diag, 'repair', repair)
    print()
