+from __future__ import annotations
+
+from dataclasses import dataclass
+import itertools
+
+import numpy as np
+
+
+BG = 0
+WATER = 1
+HOLE = 9
+BASIN_COLORS = (1, 3, 7)
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+@dataclass(frozen=True)
+class Basin:
+    color: int
+    top: int
+    left: int
+    mask: np.ndarray
