+            expected[pos] = int(color)
+        if not np.array_equal(out, expected):
+            return False
+        return True
+    except Exception:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        inp = _build_scene(rng)
+        if inp is not None and _validate_scene(inp):
