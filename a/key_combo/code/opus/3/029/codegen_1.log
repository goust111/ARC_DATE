+    return inp
+
+
+def _validate_scene(inp: np.ndarray) -> bool:
+    if inp is None or inp.ndim != 2 or max(inp.shape) > 30:
+        return False
+    try:
+        out = main(inp)
+    except Exception:
+        return False
+
+    if not np.any(inp == HOLE):
+        return False
+    if np.any(out == HOLE):
