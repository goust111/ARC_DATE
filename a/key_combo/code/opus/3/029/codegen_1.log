+        diag_idx = int((diag_idx + 1) % basin_count)
+    for idx, color in enumerate(colors):
+        top = int(bottom - heights[idx] + 1)
+        basin = _make_basin(
+            int(color),
+            int(top),
+            int(cursor),
+            int(heights[idx]),
+            int(widths[idx]),
