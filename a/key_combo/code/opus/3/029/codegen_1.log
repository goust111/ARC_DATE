+    assert len(colors) == 1
+    return next(iter(colors))
+
+
+def _is_empty(walls: np.ndarray, water_mask: np.ndarray, r: int, c: int) -> bool:
+    return _in_bounds(walls.shape, r, c) and int(walls[r, c]) == BG and not bool(water_mask[r, c])
