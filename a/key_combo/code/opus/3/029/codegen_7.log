+    height, width = grid.shape
+    for rr, cc in np.argwhere(grid == HOLE):
+        r = int(rr)
+        c = int(cc)
+        mirror_c = axis_sum - c
+        mirror_known = 0 <= mirror_c < width and int(grid[r, mirror_c]) != HOLE
