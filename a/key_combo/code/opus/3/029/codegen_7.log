+    return _solve_grid(np.asarray(grid, dtype=int), use_symmetry=True, use_tiling=True)
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    inp, _out = _generate_case(rng)
+    return inp

