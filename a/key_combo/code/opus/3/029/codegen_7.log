+    for tile_h in range(1, height + 1):
+        for tile_w in range(1, width + 1):
+            area = tile_h * tile_w
+            if best_area is not None and area > best_area:
+                continue
+            if _valid_period(grid, tile_h, tile_w, hole):
+                if best_area is None:
+                    best_area = area
