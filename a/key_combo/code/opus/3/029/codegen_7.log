                        missing.append((r, c))
                else:
                    assert g[r, c] == bg

        assert len(missing) in (0, 1)
        assert frame["area"] == border_area - len(missing)

        out[r0 + 1 : r1, c0 + 1 : c1] = Color.TEAL

        if missing:
            dr, dc = _gap_direction(missing[0], frame["bbox"])
            r, c = missing[0]
            while 0 <= r < h_grid and 0 <= c < w_grid:
                assert g[r, c] == bg
                out[r, c] = Color.TEAL
                r += dr
                c += dc

    return out

