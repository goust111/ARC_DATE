+        return None
+    density = float(np.count_nonzero(tile)) / float(tile.size)
+    if not (0.33 <= density <= 0.67):
+        return None
+    if _min_row_period(tile) != tile_h or _min_col_period(tile) != tile_w:
+        return None
+    return tile, orbits
