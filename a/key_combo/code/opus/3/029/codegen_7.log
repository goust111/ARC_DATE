+    shape: tuple[int, int], r: int, c: int, tile_h: int, tile_w: int
+) -> Iterable[tuple[int, int]]:
+    height, width = shape
+    row0 = r % tile_h
+    col0 = c % tile_w
+    for rr in range(row0, height, tile_h):
+        for cc in range(col0, width, tile_w):
+            yield rr, cc
