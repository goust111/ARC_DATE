+        evidence = 0
+        conflicts = 0
+        for r in range(height):
+            for c in range(width):
+                mirror_c = axis_sum - c
+                if not (0 <= mirror_c < width) or c >= mirror_c:
+                    continue
+                left = int(grid[r, c])
+                right = int(grid[r, mirror_c])
+                if left == hole or right == hole:
