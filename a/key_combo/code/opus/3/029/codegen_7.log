+
+def _propagate(
+    grid: np.ndarray,
+    tile_h: int,
+    tile_w: int,
+    axis_sum: int,
+    *,
+    use_symmetry: bool,
+    use_tiling: bool,
+    max_rounds: int | None = None,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    height, width = out.shape
+    rounds = 0
