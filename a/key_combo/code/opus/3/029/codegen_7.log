            v=int(grid[r,c])
            if v==hole:
                continue
            key=(r%th,c%tw)
            if key in seen and seen[key]"'!=v:
                return False
            seen[key]=v
    return True


def infer_period(grid, hole=HOLE):
    H,W=grid.shape
    cands=[]
    for area in range(1,H*W+1):
        for th in range(1,H+1):
            if area%th:
                continue
            tw=area//th
            if tw<1 or tw>W:
                continue
            if valid_period(grid,th,tw,hole):
                cands.append((th,tw))
        if cands:
            return sorted(cands, key=lambda x:(x[0]*x[1],x[0],x[1]))
    return []


def axis_candidates(grid,hole=HOLE):
    H,W=grid.shape
    out=[]
    for s in range(2*W-1):
        evidence=0
        conflicts=0
        for r in range(H):
            for c in range(W):
                mc=s-c
                if not (0<=mc<W) or c>=mc:
                    continue
                a=int(grid[r,c]); b=int(grid[r,mc])
                if a==hole or b==hole:
                    continue
                evidence+=1
                if a!=b:
                    conflicts+=1
        if evidence>0 and conflicts==0:
            out.append((evidence,s))
    out.sort(reverse=True)
    return out


def infer_axis(grid,hole=HOLE):
    cands=axis_candidates(grid,hole)
    if not cands:
        return None
    best=cands[0][0]
    axes=[s for ev,s in cands if ev==best]
    return axes


def same_class(shape,r,c,th,tw):
    H,W=shape
    rr=list(range(r%th,H,th))
    cc=list(range(c%tw,W,tw))
    return [(r2,c2) for r2 in rr for c2 in cc]


def solve(grid,use_sym=True,use_tile=True,hole=HOLE):
    g=grid.copy()
    H,W=g.shape
    pcs=infer_period(g,hole)
    if not pcs:
        return g,None,None
    th,tw=pcs[0]
    axes=infer_axis(g,hole)
    if not axes:
        return g,(th,tw),None
    axis=axes[0]
    changed=True
    while changed:
        changed=False
        if use_sym:
            updates=[]
            for r,c in np.argwhere(g==hole):
                r=int(r); c=int(c); mc=axis-c
                if 0<=mc<W and g[r,mc]!=hole:
                    updates.append((r,c,int(g[r,mc])))
            for r,c,v in updates:
                if g[r,c]==hole:
                    g[r,c]=v; changed=True
        if use_tile:
            updates=[]
            for r,c in np.argwhere(g==hole):
                r=int(r); c=int(c)
                vals={int(g[r2,c2]) for r2,c2 in same_class(g.shape,r,c,th,tw) if g[r2,c2]!=hole}
                if vals:
                    if len(vals)!=1:
                        return g,(th,tw),axis
                    updates.append((r,c,vals.pop()))
            for r,c,v in updates:
                if g[r,c]==hole:
                    g[r,c]=v; changed=True
    return g,(th,tw),axis


def classify(grid,th,tw,axis,hole=HOLE):
    H,W=grid.shape
    counts={'"'A':0,'B':0,'C':0,'both':0,'dead':0}
    for r,c in np.argwhere(grid==hole):
        r=int(r); c=int(c)
        mc=axis-c
        mirror_known=0<=mc<W and grid[r,mc]"'!=hole
        tile_known=any(grid[r2,c2]!=hole for r2,c2 in same_class(grid.shape,r,c,th,tw) if (r2,c2)!=(r,c))
        if mirror_known and not tile_known:
            counts['"'A']+=1
        elif tile_known and not mirror_known:
            counts['B']+=1
        elif not mirror_known and not tile_known:
            counts['C']+=1
        elif mirror_known and tile_known:
            counts['both']+=1
        else:
            counts['dead']+=1
    return counts


def min_row_period(tile):
    h,w=tile.shape
    for p in range(1,h+1):
        if h%p: continue
        ok=True
        for r in range(h):
            if not np.array_equal(tile[r], tile[r%p]):
                ok=False; break
        if ok: return p
    return h


def min_col_period(tile):
    h,w=tile.shape
    for p in range(1,w+1):
        if w%p: continue
        ok=True
        for c in range(w):
            if not np.array_equal(tile[:,c], tile[:,c%p]):
