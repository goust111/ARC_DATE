+
+def _axis_candidates(grid: np.ndarray, hole: int = HOLE) -> list[int]:
+    height, width = grid.shape
+    scored: list[tuple[int, int]] = []
+    center = width - 1
+    for axis_sum in range(2 * width - 1):
+        evidence = 0
+        conflicts = 0
