+    reps_c = math.ceil(width / tile.shape[1])
+    return np.tile(tile, (reps_r, reps_c))[:height, :width].copy()
+
+
+def _class_candidates(
+    tile: np.ndarray, height: int, width: int, orbits: list[tuple[int, int]]
+) -> list[list[tuple[int, int, int]]]:
