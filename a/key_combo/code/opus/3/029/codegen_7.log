+        return []
+    best_evidence = max(score for score, _axis_sum in scored)
+    return sorted(
+        [axis_sum for score, axis_sum in scored if score == best_evidence],
+        key=lambda axis_sum: (abs(axis_sum - center), axis_sum),
+    )
+
