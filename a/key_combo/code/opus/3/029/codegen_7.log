+def _balanced_counts(counts: dict[str, int]) -> bool:
+    abc = [counts["A"], counts["B"], counts["C"]]
+    return min(abc) >= 3 and max(abc) <= 3 * min(abc)
+
+
+def _validated_case(
+    inp: np.ndarray, out: np.ndarray, tile_h: int, tile_w: int, axis_sum: int
