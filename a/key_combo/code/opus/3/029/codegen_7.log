+        if use_symmetry:
+            updates: list[tuple[int, int, int]] = []
+            for rr, cc in np.argwhere(out == HOLE):
+                r = int(rr)
+                c = int(cc)
+                mirror_c = axis_sum - c
+                if 0 <= mirror_c < width and out[r, mirror_c] != HOLE:
