+def _valid_period(grid: np.ndarray, tile_h: int, tile_w: int, hole: int = HOLE) -> bool:
+    seen: dict[tuple[int, int], int] = {}
+    height, width = grid.shape
+    for r in range(height):
+        for c in range(width):
+            value = int(grid[r, c])
+            if value == hole:
+                continue
+            key = (r % tile_h, c % tile_w)
+            prev = seen.get(key)
+            if prev is None:
