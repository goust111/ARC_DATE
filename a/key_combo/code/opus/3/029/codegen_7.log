+
+    combined_one_round = _propagate(
+        inp,
+        tile_h,
+        tile_w,
+        axis_sum,
+        use_symmetry=True,
+        use_tiling=True,
+        max_rounds=1,
+    )
+    if not np.any(combined_one_round == HOLE):
