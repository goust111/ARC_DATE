                sprite[r, c] = color
                sprite[r, w - 1 - c] = color
                sprite[h - 1 - r, c] = color
                sprite[h - 1 - r, w - 1 - c] = color

    sprite[cr, cc] = color

    from arc_utils import is_contiguous
    mask = (sprite != 0)

