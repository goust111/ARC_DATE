+def _neighbors4(cell: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    r, c = cell
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr = r + dr
+        nc = c + dc
+        if 0 <= nr < h and 0 <= nc < w:
+            out.append((nr, nc))
+    return out
+
+
