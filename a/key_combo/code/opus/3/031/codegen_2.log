+
+
+def _generate_symmetric_mask(h: int) -> np.ndarray:
+    return random.choice(_SYMMETRIC_MASKS[h]).copy()
+
+
+def _generate_asymmetric_mask(h: int) -> np.ndarray:
+    return random.choice(_ASYMMETRIC_MASKS[h]).copy()
+
+
