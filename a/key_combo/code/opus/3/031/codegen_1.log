+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+MIN_RECT_GAP = 5
+GRID_MIN = 20
+GRID_MAX = 28
+RECT_DIMS = tuple((h, w) for h in range(2, 5) for w in range(2, 5))
+
+
+BBox = tuple[int, int, int, int]
+Rect = tuple[int, int, int, int]
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, clip: bool = False) -> None:
+    h, w = patch.shape
+    dh, dw = dst.shape
+    if not clip:
+        dst[r0 : r0 + h, c0 : c0 + w] = patch
+        return
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(dh, int(r0) + h)
+    cc1 = min(dw, int(c0) + w)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return
+    pr0 = rr0 - int(r0)
+    pc0 = cc0 - int(c0)
+    dst[rr0:rr1, cc0:cc1] = patch[pr0 : pr0 + (rr1 - rr0), pc0 : pc0 + (cc1 - cc0)]
+
+
+def _rect_gap(a0: int, a1: int, b0: int, b1: int) -> int:
+    if a1 < b0:
+        return b0 - a1 - 1
+    if b1 < a0:
+        return a0 - b1 - 1
+    return 0
+
+
+def _boxes_far_enough(a: Rect, b: Rect, gap: int = MIN_RECT_GAP) -> bool:
+    ar0, ac0, ah, aw = a
+    br0, bc0, bh, bw = b
+    ar1 = ar0 + ah - 1
+    ac1 = ac0 + aw - 1
+    br1 = br0 + bh - 1
+    bc1 = bc0 + bw - 1
+    row_gap = _rect_gap(ar0, ar1, br0, br1)
+    col_gap = _rect_gap(ac0, ac1, bc0, bc1)
+    return row_gap >= gap or col_gap >= gap
+
+
+def _solid_rectangles(grid: np.ndarray) -> list[Rect]:
+    comps = _components(grid == BLUE)
+    rects: list[Rect] = []
