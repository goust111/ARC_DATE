  91: def _frame_patch(color: int, bg: int, n_dots: int) -> np.ndarray:
  92:     """Build a FRAME_H x FRAME_W hollow rectangle with n_dots on the center row."""
  93:     patch = np.full((FRAME_H, FRAME_W), bg, dtype=int)
  94:     patch[0, :] = color
  95:     patch[-1, :] = color
  96:     patch[:, 0] = color
  97:     patch[:, -1] = color
  98:     mid_r = FRAME_H // 2
  99:     dot_cols = [FRAME_W - 3 - 2 * i for i in range(n_dots)]
 100:     patch[mid_r, dot_cols] = color
 101:     return patch
