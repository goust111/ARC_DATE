 104: def _sample_counts(rng: np.random.Generator, n_frames: int, total_match: int) -> list[int]:
 105:     """Distribute total_match sprites across n_frames, each capped at MAX_DOTS_PER_FRAME."""
 106:     counts = [0] * n_frames
 107:     order = rng.permutation(n_frames)
 108:     remaining = total_match
 109:     for pos, idx in enumerate(order):
 110:         frames_left = n_frames - pos - 1
 111:         lo = max(0, remaining - MAX_DOTS_PER_FRAME * frames_left)
 112:         hi = min(MAX_DOTS_PER_FRAME, remaining)
 113:         val = int(rng.integers(lo, hi + 1))
 114:         counts[int(idx)] = val
 115:         remaining -= val
 116:     return counts
