        if not (0<=r<H and 0<=c<W) or vis[r,c] or out[r,c]"'!=0: continue
        vis[r,c]=True
        st.extend([(r-1,c),(r+1,c),(r,c-1),(r,c+1)])
    holes=np.argwhere((out==0)&(~vis))
    return out, holes

# search some patterns with 2 rects same size top row
for h,w in [(2,2),(2,3),(3,2),(3,3),(4,2),(2,4),(4,3),(3,4)]:
