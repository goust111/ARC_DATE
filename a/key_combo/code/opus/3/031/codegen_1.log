import numpy as np
from itertools import combinations, product

H=W=22

def paste(dst, patch, r0, c0):
    h,w=patch.shape
    rr0=max(0,r0); cc0=max(0,c0); rr1=min(H,r0+h); cc1=min(W,c0+w)
    if rr0>=rr1 or cc0>=cc1: return
    dst[rr0:rr1,cc0:cc1]=patch[rr0-r0:rr1-r0,cc0-c0:cc1-c0]

def out(rects):
    g=np.zeros((H,W),int)
    for r,c,h,w in rects:
        g[r:r+h,c:c+w]=1
    out=g.copy()
    for r,c,h,w in rects:
        patch=np.ones((h,w),int)
        for dc in (-w,w):
            rr=r+h; cc=c+dc
            while rr < H and cc < W and cc+w > 0:
                paste(out,patch,rr,cc)
                rr += h; cc += dc
    # flood outside black
    vis=np.zeros((H,W),bool)
    st=[]
    for r in range(H):
        for c in [0,W-1]:
            if out[r,c]==0 and not vis[r,c]: st.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if out[r,c]==0 and not vis[r,c]: st.append((r,c))
    while st:
