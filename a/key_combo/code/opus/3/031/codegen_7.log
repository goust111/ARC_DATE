+def _weighted_choice(cells: list[Coord], anchor: Coord) -> Coord:
+    weights = []
+    for r, c in cells:
+        dist = abs(r - anchor[0]) + abs(c - anchor[1])
+        weights.append(1.0 / (1.0 + dist))
+    return random.choices(cells, weights=weights, k=1)[0]
