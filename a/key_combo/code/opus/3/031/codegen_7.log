+def _symmetric_area(domain: set[Coord], axis_c: int) -> int:
+    return sum(1 if c == axis_c else 2 for _r, c in domain)
+
+
+def _symmetric_frontier(domain: set[Coord], h: int, w: int, axis_c: int) -> list[Coord]:
+    frontier: set[Coord] = set()
