+    box = _bbox(mask)
+    assert box is not None, "panel pattern must be non-empty"
+    cropped = _crop_bbox(mask.astype(np.uint8), box).astype(bool)
+    return bool(np.array_equal(cropped, np.fliplr(cropped)))
+
+
