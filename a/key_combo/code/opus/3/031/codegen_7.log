GEN_EDGE_ROW_LEFT_PATH_PROB = 0.5
GEN_SOURCE_FLIP_PROB = 0.5
GEN_RETRY_LIMIT = 300


def _gen_add_path(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
    r, c = start
    er, ec = end
    mask[r, c] = True

    if random.random() < GEN_PATH_HORIZONTAL_FIRST_PROB:
        while c != ec:
            c += 1 if ec > c else -1
            mask[r, c] = True
        while r != er:
            r += 1 if er > r else -1
            mask[r, c] = True
    else:
        while r != er:
            r += 1 if er > r else -1
            mask[r, c] = True
        while c != ec:
            c += 1 if ec > c else -1
            mask[r, c] = True


def _gen_frontier(mask: np.ndarray) -> list[tuple[int, int]]:
    h, w = mask.shape
    cells: set[tuple[int, int]] = set()
    for r, c in np.argwhere(mask):
        r = int(r)
        c = int(c)
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr = r + dr
            nc = c + dc
