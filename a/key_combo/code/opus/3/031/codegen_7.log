+def _panel_info(panel: np.ndarray) -> dict:
+    colors = sorted(set(map(int, np.unique(panel))) - {BACKGROUND})
+    assert len(colors) == 1, "each panel must contain exactly one foreground color"
+    color = colors[0]
+    mask = panel == color
