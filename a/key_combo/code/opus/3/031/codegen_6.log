+    left_pad = random.randint(0, min(1, c0))
+    bottom_pad = random.randint(0, min(2, grid.shape[0] - 1 - r1))
+    right_pad = random.randint(0, min(2, grid.shape[1] - 1 - c1))
+    crop_box = (r0 - top_pad, c0 - left_pad, r1 + bottom_pad, c1 + right_pad)
