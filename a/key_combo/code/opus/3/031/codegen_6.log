+)
+
+
+TEMPLATE_SIZE = 3
+CANVAS_SIZE = 30
+FRAME_COUNT_CHOICES = (2, 3)
+SCALE_CHOICES = (1, 2, 3)
+TEMPLATE_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
