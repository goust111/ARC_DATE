+    bg = int(get_bg(g))
+    clean = _erase_noise(g, bg)
+    template_box, template, template_colors = _find_template(clean, bg)
+    frames = _find_frames(clean, bg, template_box, template_colors)
+
+    out = clean.copy()
+    return _paint_frame_contents(out, template, frames, bg)
