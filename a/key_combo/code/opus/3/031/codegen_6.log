+def _find_frames(
+    grid: np.ndarray,
+    bg: int,
+    template_box: tuple[int, int, int, int],
+    template_colors: tuple[int, ...],
+) -> list[dict]:
+    frames: list[dict] = []
+    for color in template_colors:
