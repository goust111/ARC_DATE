+        filtered = np.where(scaled == int(frame["color"]), int(frame["color"]), int(bg))
+        patch = filtered[: frame["inner_h"], : frame["inner_w"]]
+        paste(out, patch, frame["inner_r"], frame["inner_c"], transparent=bg)
+    return out
