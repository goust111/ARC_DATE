+
+# --------------- generator helpers ---------------
+
+
+GRID_H_RANGE = (15, 22)
+GRID_W_RANGE = (15, 22)
+CARRIER_COUNT_CHOICES = (2, 3)
+CARRIER_H_RANGE = (4, 7)
+CARRIER_W_RANGE = (5, 8)
+PLACEMENT_RETRIES = 120
+GEN_RETRIES = 400
+
+
+def _overlaps_with_gap(a: BBox, b: BBox, gap: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
+
+
+def _place_rectangles(height: int, width: int, count: int) -> list[BBox] | None:
+    dims = [
+        (random.randint(*CARRIER_H_RANGE), random.randint(*CARRIER_W_RANGE))
+        for _ in range(int(count))
+    ]
