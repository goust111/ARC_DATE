+def _region_parity(labels: np.ndarray, graph: dict[int, set[int]], order: list[int]) -> dict[int, int]:
+    parity: dict[int, int] = {}
+    for root in order:
+        if root in parity:
+            continue
+        parity[root] = 0
+        queue = deque([root])
+        while queue:
+            region_id = queue.popleft()
+            for neighbor in graph[region_id]:
+                wanted = 1 - parity[region_id]
+                if neighbor in parity:
