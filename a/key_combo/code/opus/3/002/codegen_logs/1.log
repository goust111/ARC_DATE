+from __future__ import annotations
+
+from collections import defaultdict, deque
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if _ARC_UTILS_DIR.exists():
