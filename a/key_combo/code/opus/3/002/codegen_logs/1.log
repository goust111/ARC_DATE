+    placed: list[BBox | None] = [None] * count
+
+    for idx in order:
+        h, w = dims[idx]
+        if height - h - 1 < 1 or width - w - 1 < 1:
+            return None
+
+        choices = [
+            (r0, c0)
+            for r0 in range(1, height - h)
+            for c0 in range(1, width - w)
