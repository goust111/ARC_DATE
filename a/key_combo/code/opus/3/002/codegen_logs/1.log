+        marker_rows = [r for r, _c in markers]
+        assert len(marker_rows) == len(set(marker_rows)), "carrier markers must lie on distinct rows"
+
+        carriers.append(
+            {
+                "bbox": box,
+                "color": carrier_color,
+                "markers": markers,
+                "obstacles": obstacles,
+            }
+        )
+
+    carriers.sort(key=lambda carrier: carrier["bbox"])
