MAX_ALIGNED_MARKERS = 4
MAX_UNALIGNED_MARKERS = 6
MARKER_COLOR_COUNT_RANGE = (1, 3)
MARKER_COLORS = np.array([1, 2, 4, 5, 6, 7, 8, 9], dtype=int)

# Line layout and retry limits.
