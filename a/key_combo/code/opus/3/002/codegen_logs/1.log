+def _region_order(labels: np.ndarray) -> list[int]:
+    order: list[int] = []
+    seen: set[int] = set()
+    for r in range(labels.shape[0]):
+        for c in range(labels.shape[1]):
+            label_id = int(labels[r, c])
+            if label_id > 0 and label_id not in seen:
+                seen.add(label_id)
+                order.append(label_id)
+    return order
