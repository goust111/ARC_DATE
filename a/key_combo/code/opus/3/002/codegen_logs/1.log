+def _region_graph(crop: np.ndarray, carrier_color: int) -> tuple[np.ndarray, dict[int, set[int]], list[int], list[int]]:
+    h, w = crop.shape
+    boundary = np.zeros((h, w), dtype=bool)
+    boundary[0, :] = True
+    boundary[-1, :] = True
+    boundary[:, 0] = True
+    boundary[:, -1] = True
