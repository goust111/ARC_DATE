+
+def _extend_carrier_rays(out: np.ndarray, carrier: dict[str, object]) -> None:
+    r0, c0, r1, c1 = carrier["bbox"]
+    step = _direction_for_color(int(carrier["color"]))
+    for r, c in carrier["markers"]:
+        cc = c + step
+        while c0 < cc < c1:
+            if int(out[r, cc]) == Color.YELLOW:
+                break
+            out[r, cc] = Color.RED
+            cc += step
