GRID_SIZE = 10
BG_COLOR = 0
ANCHOR_COLOR = 3
ANCHOR_SIZE = 2
ANCHOR_ROW_RANGE = (2, 7)
ANCHOR_COL_RANGE = (2, 6)

# Marker counts and palette choices.
