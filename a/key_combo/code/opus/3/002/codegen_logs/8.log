+            and inside[row, COLOR_TO_TARGET_COLUMN[color]]
+        )
+        drop_partial_count = sum(
+            1
+            for row, color in chosen
+            if 0 < _row_target_count(inside, row) < len(COLOR_TO_TARGET_COLUMN)
+            and not inside[row, COLOR_TO_TARGET_COLUMN[color]]
