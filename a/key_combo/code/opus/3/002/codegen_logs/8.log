        ec = int(end_c)
        dr = er - rr
        dc = ec - cc
        length = max(abs(dr), abs(dc)) + 1
        dr = 0 if dr == 0 else int(dr / abs(dr))
        dc = 0 if dc == 0 else int(dc / abs(dc))
    else:
