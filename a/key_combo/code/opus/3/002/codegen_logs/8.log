+
+def _make_patch_from_rows(rows: list[tuple[int, int]], width: int) -> np.ndarray:
+    patch = np.zeros((len(rows), width), dtype=int)
+    for r, (left, right) in enumerate(rows):
+        patch[r, left : right + 1] = 1
+    return patch
