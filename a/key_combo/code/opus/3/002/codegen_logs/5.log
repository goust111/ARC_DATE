+    r0, c0, _r1, _c1 = region_bbox
+    tile_h, tile_w = tile_mask.shape
+    out[region_mask] = BG
+    for rr, cc in np.argwhere(region_mask):
+        if tile_mask[(int(rr) - r0) % tile_h, (int(cc) - c0) % tile_w]:
+            out[int(rr), int(cc)] = SPRITE
+
+
