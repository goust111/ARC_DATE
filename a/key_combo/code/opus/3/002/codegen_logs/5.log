    if bool(np.random.randint(0, 2)):
        local = np.flipud(local)
    if bool(np.random.randint(0, 2)):
        local = np.fliplr(local)
    if bool(np.random.randint(0, 2)):
        local = local.T

    coords = [(int(r), int(c)) for r, c in np.argwhere(local)]
    return coords, int(local.shape[0]), int(local.shape[1])


