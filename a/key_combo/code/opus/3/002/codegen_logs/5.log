+    r0, c0, r1, c1 = bbox
+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
+    row_mid = (shape[0] - 1) / 2.0
+    col_mid = (shape[1] - 1) / 2.0
+    top = center_r < row_mid
+    left = center_c < col_mid
+    if top and left:
+        return "UL"
+    if top and not left:
+        return "UR"
+    if not top and left:
+        return "LL"
+    return "LR"
+
+
+def _tile_mask_over_region(
+    out: np.ndarray,
+    region_mask: np.ndarray,
+    region_bbox: tuple[int, int, int, int],
+    tile_mask: np.ndarray,
