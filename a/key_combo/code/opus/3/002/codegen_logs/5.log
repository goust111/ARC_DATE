+def _place_region(
+    grid: np.ndarray,
+    quadrant: str,
+    sprite: np.ndarray,
+    container: dict,
+) -> dict | None:
+    ranges = _placement_ranges(quadrant, grid.shape, container["box"].shape)
+    if ranges is None:
+        return None
+    row_range, col_range = ranges
+    top = random.choice(list(row_range))
+    left = random.choice(list(col_range))
+
+    box = container["box"]
+    box_h, box_w = box.shape
