+
+BG = 0
+SPRITE = 1
+WALL = 2
+
+_QUADRANTS = ("UL", "UR", "LL", "LR")
+_ROTATION_K = {"UL": 2, "UR": 3, "LL": 1, "LR": 0}
+
+_GRID_MIN = 20
+_GRID_MAX = 26
+_REGION_COUNT_WEIGHTS = ((3, 0.4), (4, 0.6))
+_GEN_ATTEMPTS = 400
