+    region_signatures = set()
+    for spec in specs:
+        rotated = np.rot90(spec["sprite"], _ROTATION_K[spec["quadrant"]])
+        region_signatures.add((spec["quadrant"], _tile_signature(rotated)))
+    assert len(region_signatures) >= 3
