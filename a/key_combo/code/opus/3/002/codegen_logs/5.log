+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    return _bbox_from_coords(coords)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _component_dicts(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            touches_border = False
+
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            comp_mask = np.zeros((h, w), dtype=bool)
+            comp_mask[coords[:, 0], coords[:, 1]] = True
+            out.append(
+                {
+                    "coords": coords,
+                    "mask": comp_mask,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": int(coords.shape[0]),
+                    "touches_border": touches_border,
+                }
+            )
+    return out
+
+
+def _find_enclosed_regions(grid: np.ndarray) -> list[dict]:
+    comps = _component_dicts(np.asarray(grid) != WALL)
+    return [comp for comp in comps if not comp["touches_border"]]
+
+
