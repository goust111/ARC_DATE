+    (0, 0): RED,
+    (0, 1): GREEN,
+    (1, 0): YELLOW,
+    (1, 1): BLUE,
+}
+PAIR_ORDER = ((0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3))
+QUADRANT_TO_PAIR_IDS = {
+    0: (0, 1, 2),
+    1: (0, 3, 4),
+    2: (1, 3, 5),
+    3: (2, 4, 5),
