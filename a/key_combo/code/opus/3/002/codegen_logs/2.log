+        1: (mid0, 1),       # pair (0,2): left center
+        2: (mid0, mid0),    # pair (0,3): main diagonal center
+        3: (mid0, mid1),    # pair (1,2): anti-diagonal center
+        4: (mid1, s - 2),   # pair (1,3): right center
+        5: (s - 2, mid1),   # pair (2,3): bottom center
