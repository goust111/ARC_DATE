+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+QUADRANTS = ((0, 0), (0, 1), (1, 0), (1, 1))
+QUADRANT_COLORS = {
+    (0, 0): RED,
+    (0, 1): GREEN,
+    (1, 0): YELLOW,
+    (1, 1): BLUE,
+}
+PAIR_ORDER = ((0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3))
+QUADRANT_TO_PAIR_IDS = {
