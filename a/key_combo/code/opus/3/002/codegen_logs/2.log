+
+def _split_quadrants(grid: np.ndarray) -> tuple[int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] == g.shape[1], "input must be a square grid"
+    side = int(g.shape[0])
