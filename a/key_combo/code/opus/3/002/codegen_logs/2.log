+    counts_perm = random.sample([1, 2, 3, 4], 4)
+    counts = {idx: counts_perm[idx] for idx in range(4)}
+    grid = _render_input(masks, counts)
+    if grid is None:
+        return None
+    if _validate_generated(grid):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
