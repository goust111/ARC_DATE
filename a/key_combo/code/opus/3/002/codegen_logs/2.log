+def _random_shortest_path(
+    side: int,
+    start: tuple[int, int],
+    goals: set[tuple[int, int]],
+    allowed: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    if start in goals:
+        return [start]
+
+    queue = deque([start])
+    parent = {start: None}
+    goal_hit = None
+
+    while queue and goal_hit is None:
+        cell = queue.popleft()
+        nbrs = list(neighbors4(*cell))
+        random.shuffle(nbrs)
+        for rr, cc in nbrs:
+            nxt = (int(rr), int(cc))
+            if nxt in parent:
+                continue
+            if not (0 <= rr < side and 0 <= cc < side):
+                continue
+            if nxt not in allowed:
+                continue
+            if nxt in blocked and nxt not in goals:
+                continue
+            parent[nxt] = cell
+            if nxt in goals:
+                goal_hit = nxt
+                break
+            queue.append(nxt)
+
+    if goal_hit is None:
+        return None
+
+    path = [goal_hit]
+    cur = goal_hit
+    while parent[cur] is not None:
+        cur = parent[cur]
+        path.append(cur)
