+def _local_corner_clusters(box_size: int) -> dict[int, set[tuple[int, int]]]:
+    s = int(box_size)
+    return {
+        0: {(0, 0), (0, 1), (1, 0)},
+        1: {(0, s - 1), (0, s - 2), (1, s - 1)},
+        2: {(s - 1, 0), (s - 2, 0), (s - 1, 1)},
+        3: {(s - 1, s - 1), (s - 2, s - 1), (s - 1, s - 2)},
+    }
