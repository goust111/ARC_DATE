+        1: {(0, s - 1), (0, s - 2), (1, s - 1)},
+        2: {(s - 1, 0), (s - 2, 0), (s - 1, 1)},
+        3: {(s - 1, s - 1), (s - 2, s - 1), (s - 1, s - 2)},
