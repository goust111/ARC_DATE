+    g = scene["grid"]
+    bg = int(scene["bg"])
+    palette_cols = scene["palette_cols"]
+    palette_bbox = scene["palette_bbox"]
+    template_sig = scene["template"]["sig"]
+
+    out = g.copy()
+    for obj in scene["objects"]:
+        if obj["sig"] != template_sig:
+            continue
