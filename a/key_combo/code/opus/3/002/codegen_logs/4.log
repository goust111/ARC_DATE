+
+BG = Color.BLACK
+TEMPLATE_COLOR = Color.TEAL
+OBJECT_COLORS = (Color.BLUE, Color.RED)
+PALETTE_COLORS = (Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE)
+PALETTE_BASE = Color.GREY
+
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (18, 24)
