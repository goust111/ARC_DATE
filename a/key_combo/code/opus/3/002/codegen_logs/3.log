0139: def _choose_endpoints(H: int, W: int, n_walls: int) -> tuple[tuple[int, ...], tuple[int, ...]] | None:
0140:     rows = _spaced_combos(list(range(1, H - 1)), n_walls)
0141:     cols = _spaced_combos(list(range(1, W - 1)), n_walls)
0142:     valid: list[tuple[tuple[int, ...], tuple[int, ...]]] = []
0143:     for start_rows in rows:
0144:         for cols_asc in cols:
0145:             end_cols = tuple(reversed(cols_asc))
0146:             lengths = [c + (H - 1 - r) + 1 for r, c in zip(start_rows, end_cols)]
0147:             if all(_contains(WALL_LENGTH_RANGE, length) for length in lengths):
0148:                 valid.append((start_rows, end_cols))
0149:     return random.choice(valid) if valid else None
