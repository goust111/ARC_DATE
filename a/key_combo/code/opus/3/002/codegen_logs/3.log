0131: def _spaced_combos(values: list[int], n: int) -> list[tuple[int, ...]]:
0132:     return [
0133:         combo
0134:         for combo in itertools.combinations(values, n)
0135:         if all(combo[i + 1] - combo[i] >= ENDPOINT_SPACING for i in range(len(combo) - 1))
0136:     ]
