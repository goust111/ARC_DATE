+    for r, c in grey_coords:
+        mask[r - r0, c - c0] = True
+    if len(grey_coords) == 5 and mask.shape == (3, 3):
+        if np.array_equal(mask, _GLYPH_CROSS):
+            return BLUE
+        if np.array_equal(mask, _GLYPH_X):
