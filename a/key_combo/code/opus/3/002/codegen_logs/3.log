+def _partition_lengths(n_regions: int) -> list[tuple[int, ...]]:
+    if n_regions == 2:
+        return [(2,), (1, 1)]
+    if n_regions == 3:
+        return [(3,), (2, 1), (1, 2)]
+    return [(2, 2), (3, 1), (1, 3)]
+
+
+def _sample_region_kinds(n_regions: int) -> list[str]:
+    if n_regions == 2:
+        return random.sample(["cross", "x", "block"], 2)
