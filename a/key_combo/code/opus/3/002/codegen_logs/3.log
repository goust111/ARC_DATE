0152: def _stair_path_lb(H: int, W: int, start_r: int, end_c: int, min_first_col: int) -> list[tuple[int, int]] | None:
0153:     down = H - 1 - int(start_r)
0154:     right = int(end_c)
0155:     max_parts = min(MAX_STAIR_PARTS, down, right)
0156:     feasible = [k for k in range(1, max_parts + 1) if right >= int(min_first_col) + k - 1]
0157:     if not feasible:
0158:         return None
0159:     weights = [k * k for k in feasible]
0160:     k = random.choices(feasible, weights=weights, k=1)[0]
0161: 
0162:     if k == 1:
0163:         horiz = [right]
0164:     else:
0165:         first = random.randint(int(min_first_col), right - (k - 1))
0166:         horiz = [first] + _split_positive(right - first, k - 1)
0167:     vert = _split_positive(down, k)
0168: 
0169:     r, c = int(start_r), 0
0170:     cells = [(r, c)]
0171:     for h_run, v_run in zip(horiz, vert):
0172:         for _ in range(h_run):
0173:             c += 1
0174:             cells.append((r, c))
0175:         for _ in range(v_run):
0176:             r += 1
0177:             cells.append((r, c))
0178: 
0179:     if (r, c) != (H - 1, int(end_c)):
0180:         return None
0181:     return cells
0182: 
0183: 
0184: def _build_lower_left_grid(H: int, W: int, n_walls: int) -> np.ndarray | None:
0185:     endpoints = _choose_endpoints(H, W, n_walls)
0186:     if endpoints is None:
0187:         return None
0188:     start_rows, end_cols = endpoints
