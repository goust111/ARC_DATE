+def _gen_attempt() -> np.ndarray | None:
+    height = int(RNG.integers(*HEIGHT_RANGE))
+    left_width = int(RNG.integers(*LEFT_WIDTH_RANGE))
+    right_width = int(RNG.integers(*RIGHT_WIDTH_RANGE))
