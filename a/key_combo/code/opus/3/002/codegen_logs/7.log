+        return options[int(RNG.integers(len(options)))]
+
+    widths = np.array([min(option[1][2], option[1][3]) for option in options], dtype=float)
+    weights = 1.0 / widths
+    weights /= weights.sum()
+    choice = int(RNG.choice(len(options), p=weights))
+    return options[choice]
