+    height, width = left_panel.shape
+    for r, c in np.argwhere(left_panel == WALL):
+        r = int(r)
+        c = int(c)
+        if 0 < r < height - 1:
+            a = int(region_labels[r - 1, c])
+            b = int(region_labels[r + 1, c])
+            if a > 0 and b > 0 and a != b:
+                graph[a].add(b)
+                graph[b].add(a)
