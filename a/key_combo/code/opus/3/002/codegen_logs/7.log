+def _split_candidates(
+    region: tuple[int, int, int, int],
+    min_region_area: int,
+) -> list[tuple[str, int, int, int]]:
+    r0, c0, r1, c1 = region
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
