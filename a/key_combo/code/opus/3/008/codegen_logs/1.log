+    *,
+    require_unique_sparse: bool = True,
+) -> tuple[np.ndarray | None, str | None, tuple[int, int] | None]:
+    n_rows = len(line_rows) - 1
+    n_cols = len(line_cols) - 1
+    axis_idx = n_rows // 2 if axis_kind == "horizontal" else n_cols // 2
+
+    out = grid.copy()
