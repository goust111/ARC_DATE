+                    source = grid[bottom_sl]
+                    target = grid[top_sl]
+                    out[top_sl] = _mirror_patch(source, axis_kind)
+                else:
+                    source = grid[top_sl]
+                    target = grid[bottom_sl]
+                    out[bottom_sl] = _mirror_patch(source, axis_kind)
+                if not np.array_equal(target, _mirror_patch(source, axis_kind)):
+                    changed_pairs += 1
