+
+    dense_cols = range(axis_idx, n_cols) if sparse_side == "left" else range(axis_idx)
+    assert all(
+        _foreground_count(_cell_patch(grid, line_rows, line_cols, rr, cc)) > 0
+        for rr in range(n_rows)
+        for cc in dense_cols
