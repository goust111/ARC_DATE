+
+
+def _mirror_side(
+    marker: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+    obj_mask: np.ndarray,
+) -> str:
+    mr, mc = marker
+    r0, c0, r1, c1 = bbox
+    sides: list[str] = []
+    if mc == c0 - 1 and r0 <= mr <= r1 and obj_mask[mr, c0]:
+        sides.append("left")
+    if mc == c1 + 1 and r0 <= mr <= r1 and obj_mask[mr, c1]:
+        sides.append("right")
+    if mr == r0 - 1 and c0 <= mc <= c1 and obj_mask[r0, mc]:
