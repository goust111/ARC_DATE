+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+SEED_PALETTE = (BLUE, RED, GREEN, ORANGE)
+SIDES = ("up", "down", "left", "right")
+GEN_RETRIES = 400
