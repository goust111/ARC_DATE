  15: def main(input_grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Isolate the uniquely colored cell and surround it with a red 3 by 3 frame.
  18: 
  19:     Input structure:
  20:     - The background is black.
  21:     - Exactly one non-black color occurs once.
  22:     - Other non-black colors occur zero times or more than once.
  23: 
  24:     Rule:
  25:     - Find the first non-black color with exactly one cell.
  26:     - Create a black output grid.
  27:     - Fill the 3 by 3 neighborhood around that cell red, then restore the unique cell's original color.
  28: 
  29:     Key insight:
  30:     - Frequency, not position or shape, identifies the target cell; all non-target input pixels are discarded.
  31:     """
  32:     # Plan:
  33:     # 1. Create a blank new canvas (so that the non-unique colors don't get copied)
  34:     # 2. Find the unique cell
  35:     # 3. Surround the unique cell with red pixels
  36: 
  37:     output_grid = np.zeros_like(input_grid)
  38: 
  39:     # 2. Find the unique cell
  40:     unique_color = None
  41:     for color in Color.NOT_BLACK:
  42:         if np.count_nonzero(input_grid == color) == 1:
  43:             unique_color = color
  44:             break
  45:     assert unique_color is not None
  46:     
  47:     # 3. Surround the unique cell with red pixels
  48:     # First get the coordinates of the unique cell
  49:     _b = bbox(input_grid == unique_color)
  50:     assert _b is not None
  51:     r, c, _r1, _c1 = _b
  52:     # Copy red over the region around the unique cell (but this will accidentally delete the unique cell, so be copied back)
  53:     for rr in range(r - 1, r + 2):
  54:         for cc in range(c - 1, c + 2):
  55:             if 0 <= rr < len(input_grid) and 0 <= cc < len(input_grid[0]):
  56:                 output_grid[rr, cc] = Color.RED
  57:     # Copy the unique cell back
  58:     output_grid[r, c] = unique_color
  59: 
  60:     return output_grid
  61: 
