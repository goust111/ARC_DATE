 170:         for j in range(cols):
 171:             rr = lat_r + i * _GEN_CELL_STRIDE
 172:             cc = lat_c + j * _GEN_CELL_STRIDE
 173:             paste(out, np.where(template, control[i, j], _GEN_BACKGROUND_COLOR), rr, cc)
 174:             paste(inp, input_cell, rr, cc)
 175:     paste(out, control, ctl_r, ctl_c)
 176:     paste(inp, control, ctl_r, ctl_c)
 177:     return inp, out
