+
+def _stripe_color_at_cell(row: int, col: int, seg_c0: int, seg_c1: int) -> int:
+    if row % 2 == 1:
+        return BG
+    base = STRIPE_PATTERN[(row // 2) % len(STRIPE_PATTERN)]
+    if base == GREEN:
