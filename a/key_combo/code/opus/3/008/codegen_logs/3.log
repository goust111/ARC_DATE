 105:     top_count, bottom_count, overlap = COUNT_CHOICES[
 106:         np.random.randint(len(COUNT_CHOICES))
 107:     ]
 108:     top_mask, bottom_mask = _gen_sample_masks(top_count, bottom_count, overlap)
 109:     top_components = _gen_num_components(top_mask)
 110:     bottom_components = _gen_num_components(bottom_mask)
 111:     top_ok = TOP_COMPONENT_BOUNDS[0] <= top_components <= TOP_COMPONENT_BOUNDS[1]
 112:     bottom_ok = BOTTOM_COMPONENT_BOUNDS[0] <= bottom_components <= BOTTOM_COMPONENT_BOUNDS[1]
 113:     if not (top_ok and bottom_ok):
 114:         return None
 115: 
 116:     inp, expected = _gen_render(top_mask, bottom_mask)
 117:     if not np.array_equal(main(inp), expected):
 118:         return None
 119:     return inp
