 148:     lattice_h = rows * _GEN_CELL_STRIDE - _GEN_CELL_GAP
 149:     lattice_w = cols * _GEN_CELL_STRIDE - _GEN_CELL_GAP
 150:     choices: list[tuple[int, int, int, int]] = []
 151:     for lat_r in range(_GEN_BORDER, _GEN_GRID_SIZE - lattice_h):
 152:         for lat_c in range(_GEN_BORDER, _GEN_GRID_SIZE - lattice_w):
 153:             for ctl_r in range(_GEN_BORDER, _GEN_GRID_SIZE - rows):
 154:                 for ctl_c in range(_GEN_BORDER, lat_c - cols - _GEN_LAYOUT_GAP + 1):
 155:                     choices.append((lat_r, lat_c, ctl_r, ctl_c))
 156:             for ctl_r in range(lat_r + lattice_h + _GEN_LAYOUT_GAP, _GEN_GRID_SIZE - rows):
