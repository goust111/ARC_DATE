 162: def _gen_scene(template: np.ndarray, control: np.ndarray, layout: tuple[int, int, int, int]) -> tuple[np.ndarray, np.ndarray]:
 163:     """Return paired input/output grids for one sampled template, control matrix, and layout."""
 164:     lat_r, lat_c, ctl_r, ctl_c = layout
 165:     out = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)
 166:     inp = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)
 167:     input_cell = np.where(template, _GEN_TEMPLATE_COLOR, _GEN_BACKGROUND_COLOR)
 168:     rows, cols = control.shape
