  34: def main(grid: np.ndarray) -> np.ndarray:
  35:     """
  36:     Complete the four inner quadrants as flipped, recolored copies of the top-left template.
  37: 
  38:     Input structure:
  39:     - A one-cell background border surrounds a square interior split into a 2x2 block grid.
  40:     - The upper-left block is a complete two-color template.
  41:     - The other blocks contain sparse control pixels placed where their corresponding
  42:       flipped template symbols should take those colors.
  43: 
  44:     Rule:
  45:     - Use the upper-left block unchanged for the first quadrant.
  46:     - Horizontally flip the template for the upper-right quadrant, vertically flip it
  47:       for the lower-left quadrant, and flip both axes for the lower-right quadrant.
  48:     - In each quadrant, every non-background input pixel maps the transformed
  49:       template symbol under it to that pixel's color; symbols without a control
  50:       pixel become background.
  51: 
  52:     Key insight: The control pixels are not objects to move; they are a local
  53:     recoloring legend for the transformed template underneath each quadrant.
  54:     """
  55:     g = np.asarray(grid, dtype=int)
  56:     bg = get_bg(g)
  57:     h, w = g.shape
  58:     assert h >= 4 and w >= 4, "grid must have an interior"
  59:     assert (h - 2) % 2 == 0 and (w - 2) % 2 == 0, "interior must split into 2x2 blocks"
  60:     block_h = (h - 2) // 2
  61:     block_w = (w - 2) // 2
  62:     assert block_h == block_w, "template blocks must be square"
  63: 
  64:     assert np.all(g[0, :] == bg) and np.all(g[-1, :] == bg), "top/bottom border must be background"
  65:     assert np.all(g[:, 0] == bg) and np.all(g[:, -1] == bg), "left/right border must be background"
  66: 
  67:     n = block_h
  68:     base = g[1 : 1 + n, 1 : 1 + n]
  69:     assert not np.any(base == bg), "upper-left template must be complete"
