+    protected = np.zeros_like(g, dtype=bool)
+    protected[ctl_r0 : ctl_r1 + 1, ctl_c0 : ctl_c1 + 1] = True
+    for comp in by_anchor.values():
+        coords = comp["coords"]
+        protected[coords[:, 0], coords[:, 1]] = True
