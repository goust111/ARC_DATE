   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """Compare the two stacked half-size masks and emit pink where exactly one mask is filled.
   8: 
   9:     Input structure
  10:     - The input has even height and is vertically partitioned into two equal-size regions.
  11:     - The two regions share one background color, and each region has exactly one foreground color.
  12:     Rule
  13:     - Align the top and bottom regions by position.
  14:     - Output pink at positions where exactly one corresponding input cell is foreground.
  15:     - Output the shared background at positions where both cells agree as background or foreground.
  16:     Key insight
  17:     - The result is the symmetric difference of the two stacked foreground masks.
  18:     """
  19:     g = np.asarray(grid, dtype=int)
  20:     assert g.ndim == 2
  21:     height, width = g.shape
  22:     assert height % 2 == 0
  23: 
  24:     half = height // 2
  25:     top = g[:half, :]
  26:     bottom = g[half:, :]
  27: 
  28:     common_colors = set(colors_present(top)) & set(colors_present(bottom))
  29:     assert len(common_colors) == 1
  30:     bg = common_colors.pop()
  31: 
  32:     top_colors = colors_present(top, exclude={bg})
  33:     bottom_colors = colors_present(bottom, exclude={bg})
  34:     assert len(top_colors) == 1
  35:     assert len(bottom_colors) == 1
  36:     assert top_colors[0] != bottom_colors[0]
  37: 
  38:     out = np.full((half, width), bg, dtype=int)
  39:     out[(top != bg) ^ (bottom != bg)] = Color.PINK
  40:     return out
  41: 
  42: # --------------- generator (o5x) ---------------
  43: # Fixed canvas and colors observed in all task examples.
  44: HALF_HEIGHT, WIDTH = 3, 5
  45: TOTAL_CELLS = HALF_HEIGHT * WIDTH
  46: BACKGROUND_COLOR, TOP_COLOR, BOTTOM_COLOR = Color.BLACK, Color.MAROON, Color.YELLOW
  47: 
  48: # Foreground/overlap ranges and inclusive XOR size bounds.
  49: TOP_COUNT_RANGE, BOTTOM_COUNT_RANGE, OVERLAP_RANGE = range(5, 10), range(8, 11), range(3, 8)
  50: PINK_COUNT_BOUNDS = (5, 9)
  51: 
  52: # Inclusive connected-component filters and retry cap.
  53: TOP_COMPONENT_BOUNDS, BOTTOM_COMPONENT_BOUNDS = (2, 5), (1, 4)
  54: GENERATION_ATTEMPTS = 300
  55: 
  56: 
  57: def _gen_count_choices():
  58:     choices = []
  59:     for top_count in TOP_COUNT_RANGE:
  60:         for bottom_count in BOTTOM_COUNT_RANGE:
  61:             for overlap in OVERLAP_RANGE:
  62:                 if overlap > top_count or overlap > bottom_count:
  63:                     continue
  64:                 bottom_only_count = bottom_count - overlap
  65:                 if bottom_only_count > TOTAL_CELLS - top_count:
  66:                     continue
  67:                 pink_count = top_count + bottom_count - 2 * overlap
  68:                 if PINK_COUNT_BOUNDS[0] <= pink_count <= PINK_COUNT_BOUNDS[1]:
  69:                     choices.append((top_count, bottom_count, overlap))
  70:     return choices
  71: 
  72: 
  73: COUNT_CHOICES = _gen_count_choices()
  74: 
  75: 
  76: def _gen_num_components(mask):
  77:     return len(components_mask(mask, connectivity=4))
  78: 
  79: 
  80: def _gen_sample_masks(top_count, bottom_count, overlap):
  81:     all_cells = np.arange(TOTAL_CELLS)
  82:     top_cells = np.random.choice(all_cells, size=top_count, replace=False)
  83:     overlap_cells = np.random.choice(top_cells, size=overlap, replace=False)
  84:     free_cells = np.setdiff1d(all_cells, top_cells, assume_unique=False)
  85:     bottom_only_cells = np.random.choice(
  86:         free_cells, size=bottom_count - overlap, replace=False
  87:     )
  88: 
  89:     top_mask = np.zeros(TOTAL_CELLS, dtype=bool)
  90:     bottom_mask = np.zeros(TOTAL_CELLS, dtype=bool)
  91:     top_mask[top_cells] = True
  92:     bottom_mask[overlap_cells] = True
  93:     bottom_mask[bottom_only_cells] = True
  94:     return top_mask.reshape(HALF_HEIGHT, WIDTH), bottom_mask.reshape(HALF_HEIGHT, WIDTH)
  95: 
  96: 
  97: def _gen_render(top_mask, bottom_mask):
  98:     top = np.where(top_mask, TOP_COLOR, BACKGROUND_COLOR)
  99:     bottom = np.where(bottom_mask, BOTTOM_COLOR, BACKGROUND_COLOR)
 100:     expected = np.where(top_mask ^ bottom_mask, Color.PINK, BACKGROUND_COLOR)
 101:     return np.vstack([top, bottom]).astype(int), expected.astype(int)
 102: 
