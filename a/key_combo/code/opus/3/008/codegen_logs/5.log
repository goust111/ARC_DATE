+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(grid == BLUE):
+        cell = (int(r), int(c))
+        if cell in seen:
+            continue
+        q = deque([cell])
+        seen.add(cell)
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for dr, dc in DIR4:
+                nr, nc = rr + dr, cc + dc
+                nxt = (nr, nc)
+                if _in_bounds((h, w), nr, nc) and nxt not in seen and int(grid[nr, nc]) == BLUE:
