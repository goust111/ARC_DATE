+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+GREEN = 3
+YELLOW = 4
+MAROON = 9
+
+ARM_OFFSETS = (
+    (0, -3),
+    (0, -2),
+    (0, 2),
+    (0, 3),
+    (-3, 0),
+    (-2, 0),
+    (2, 0),
+    (3, 0),
+)
+GAP_OFFSETS = ((0, -1), (0, 1), (-1, 0), (1, 0))
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR_TO_BAR = {
+    "left": ((0, -3), (0, -2)),
+    "right": ((0, 2), (0, 3)),
+    "up": ((-3, 0), (-2, 0)),
+    "down": ((2, 0), (3, 0)),
