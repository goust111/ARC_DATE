+        cell = (int(r), int(c))
+        if cell in seen:
+            continue
+        q = deque([cell])
+        seen.add(cell)
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
