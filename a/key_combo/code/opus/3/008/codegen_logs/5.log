+        if step % 2 == 0:
+            left += 1
+        else:
+            right -= 1
+        step += 1
+    return rows
+
+
+def _paint_black_only(out: np.ndarray, rr: int, left: int, right: int, color: int) -> None:
+    segment = out[rr, left : right + 1]
+    segment[segment == BG] = color
