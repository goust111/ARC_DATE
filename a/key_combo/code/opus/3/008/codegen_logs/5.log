+def _down_rows(center: tuple[int, int], width: int, shape: tuple[int, int]) -> list[tuple[int, int, int]]:
+    h, w = shape
+    r, c = center
+    left, right = _base_interval(c, width)
+    rows: list[tuple[int, int, int]] = []
+    rr = r
+    step = 0
+    while 0 <= rr < h and 0 <= left and right < w and left <= right:
