+    for r, c in np.argwhere(g == BLUE):
+        cell = (int(r), int(c))
+        if cell not in participating:
+            out[cell] = BG
+
+    for cross in crosses:
+        r, c = cross["center"]
+        out[r, c] = YELLOW
+
+    return out
+
+
+def _cells_isolated(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    own = set(cells)
+    for r, c in cells:
+        if not _in_bounds((h, w), r, c) or int(grid[r, c]) != BG:
