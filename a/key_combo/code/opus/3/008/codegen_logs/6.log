+                        if 0 <= nr < height and 0 <= nc < width and bool(occupied[nr, nc]):
+                            ok = False
+                            break
+                    if not ok:
+                        break
+                if not ok:
+                    break
+            if ok:
+                positions.append((int(row), int(col)))
+    return positions
+
+
+def _scene_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    height = int(rng.integers(GRID_MIN, GRID_MAX_EXCLUSIVE))
