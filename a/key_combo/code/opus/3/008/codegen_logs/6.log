+
+from arc_utils import Color, crop_bbox, find_components, paste, scale_sprite
+
+
+GRID_MIN = 14
+GRID_MAX_EXCLUSIVE = 23
+SMALL_SIDE_CHOICES = (3, 4, 5)
+DISTRACTOR_SIDE_CHOICES = (3, 4, 5, 6)
+TARGET_RARE_COUNT_BOUNDS = (1, 5)
+GEN_RETRY_LIMIT = 600
