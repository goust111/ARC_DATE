+def _extract_main_and_bar(grid: np.ndarray) -> tuple[np.ndarray, list[int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] >= 2, "expected a main grid plus one extra color-bar row"
