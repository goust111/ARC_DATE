+    order = sorted(range(len(regions)), key=lambda idx: areas[idx])
+    out = np.asarray(wall_grid, dtype=int).copy()
+    for rank, idx in enumerate(order):
+        out[regions[idx][:, 0], regions[idx][:, 1]] = int(bar[rank])
+    return out, regions, areas, order
+
+
