+            bar_start = random.randint(0, W - region_count)
+            return {
+                "template": template,
+                "region_count": region_count,
+                "H": H,
+                "W": W,
+                "r1": r1,
+                "r2": r2,
+                "c1": c1,
+                "c2": c2,
+                "line": line,
+                "bar": bar,
+                "bar_start": bar_start,
+            }
+    return None
