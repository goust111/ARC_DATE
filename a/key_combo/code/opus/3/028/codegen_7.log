+def _paint_segment(grid: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int) -> None:
+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    value = int(color)
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        grid[r0, lo : hi + 1] = value
+        return
+    assert c0 == c1, "segments must be axis-aligned"
+    lo, hi = sorted((r0, r1))
+    grid[lo : hi + 1, c0] = value
+
