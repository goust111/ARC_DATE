+        "sprites": sprites,
+        "piece_shapes": piece_shapes,
+        "piece_colors": piece_colors,
+        "hole_box": hole_box,
+        "solution": solutions[0],
+    }
+
+
+def render_solution(grid: np.ndarray, info) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for coords in info["sprites"]:
+        for r, c in coords:
