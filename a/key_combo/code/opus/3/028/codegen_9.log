+        min_h = max(GRID_HEIGHT_RANGE[0], outer_h + 2)
+        max_h = GRID_HEIGHT_RANGE[1]
+        if min_h > max_h:
+            continue
+        grid_h = rng.randint(min_h, max_h)
+
+        blue_top = rng.randint(1, grid_h - outer_h - 1)
