+            if shape == mirrored:
+                ok = False
+                break
+            if shape in all_shapes or mirrored in all_shapes:
+                ok = False
+                break
+            all_shapes.add(shape)
+            all_shapes.add(mirrored)
+        if ok:
+            return chosen
+    raise RuntimeError("failed to choose non-conflicting sprite shapes")
