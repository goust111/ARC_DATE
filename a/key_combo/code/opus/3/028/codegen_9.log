+def choose_sprite_shapes(rng: random.Random, sprite_count: int) -> list[Shape]:
+    for _ in range(200):
+        chosen = rng.sample(SHAPE_CATALOG, sprite_count)
+        all_shapes = set()
+        ok = True
+        for shape in chosen:
