+def find_rect_hole(grid: np.ndarray, blue_mask: np.ndarray) -> tuple[tuple[int, int, int, int], set[Coord]]:
+    h, w = grid.shape
+    bg_components = components_mask(grid == BLACK, connectivity=4)
+    hole_box = None
+    hole_cells_abs = None
+    for coords in bg_components:
