+            c0 = random.randint(0, w - notch_w)
+            rr = slice(0, depth) if side == "top" else slice(h - depth, h)
+            candidate = np.zeros_like(obj, dtype=bool)
+            candidate[rr, c0 : c0 + notch_w] = True
+        else:
+            notch_h = random.randint(2, max(2, h // 3))
