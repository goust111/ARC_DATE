        int(np.floor(WALL_LENGTH_FRAC_RANGE[1] * n)),
    )


def _gen_transform(g: np.ndarray) -> np.ndarray:
    out = np.rot90(g, random.randrange(ROTATION_COUNT))
    if random.random() < FLIP_PROB:
        out = np.fliplr(out)
    if random.random() < FLIP_PROB:
        out = np.flipud(out)
    return out.copy()


