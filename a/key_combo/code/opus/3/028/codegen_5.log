+def _attempt_generate() -> np.ndarray | None:
+    panel_count = random.choices((2, 3), weights=(2, 3))[0]
+    panel_w = random.randint(4, 6)
+    upper_h = random.randint(6, 8)
+    upper, tile_rows, panels = _build_panels(panel_count, panel_w, upper_h)
