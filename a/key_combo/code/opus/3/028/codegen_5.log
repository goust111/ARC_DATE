+    rows_keep_empty = _collect_rows(upper, panels, right_to_left=True, discard_empty=False)
+    no_tri = _fill_holes(grid, holes, _collect_rows(upper, panels, right_to_left=True, discard_empty=True), triangular_mode="none")
