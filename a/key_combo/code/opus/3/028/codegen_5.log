+    if hole_count == 1:
+        min_obj_w = panel_w + 4
+    else:
+        min_obj_w = 2 * panel_w + 5
+    assert min_obj_w <= grid_w
+    obj_w = grid_w - random.randint(0, min(2, grid_w - min_obj_w))
