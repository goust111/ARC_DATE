+
+def _alternate_outputs(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    _mask, green_box = _largest_green_component(grid)
+    upper_h = green_box[0]
+    panels = _panel_slices(grid, upper_h)
