+    assert len({tuple(map(int, row)) for row in rows}) >= 2, "compressed tile must have at least two distinct rows"
+    assert any(np.all(upper[:, c0:c1] == Color.BLACK, axis=1).any() for c0, c1 in panels), "need empty rows to discard"
