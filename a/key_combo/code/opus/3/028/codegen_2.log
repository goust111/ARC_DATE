+def _runs(cols: list[int]) -> list[tuple[int, int]]:
+    assert cols
+    runs: list[tuple[int, int]] = []
+    start = prev = int(cols[0])
+    for c in cols[1:]:
+        c = int(c)
+        if c == prev + 1:
+            prev = c
+            continue
+        runs.append((start, prev))
+        start = prev = c
+    runs.append((start, prev))
+    return runs
+
