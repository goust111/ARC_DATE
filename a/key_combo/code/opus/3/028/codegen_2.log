+def _resolve_movers(segments: list[dict]) -> set[int]:
+    claims: dict[tuple[int, int], list[int]] = {}
+    for idx, seg in enumerate(segments):
+        for cell in seg["target"]:
+            claims.setdefault(cell, []).append(idx)
