+        cols = sorted(int(c) for _r, c in coords)
+        runs = _runs(cols)
+        lengths = [c1 - c0 + 1 for c0, c1 in runs]
+        max_len = max(lengths)
+        keep = [run for run, run_len in zip(runs, lengths) if run_len == max_len]
