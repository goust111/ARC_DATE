+        else:
+            blocked_lengths.append(int(recovered[i]["length"]))
+    for i in range(len(recovered)):
+        for j in range(i + 1, len(recovered)):
+            if _target_overlap(recovered[i], recovered[j]):
+                overlap_pairs += 1
+
+    if scenario == "none":
+        if overlap_pairs != 0 or len(movers) != len(recovered):
+            return False
+    else:
+        if overlap_pairs != 1:
+            return False
+        if len(movers) != len(recovered) - 1:
+            return False
+        if not blocked_lengths or not moved_lengths:
