+            return False
+        if len(movers) != len(recovered) - 1:
+            return False
+        i, j = overlap_pairs[0]
+        winner = min((i, j), key=lambda idx: _priority_key(recovered[idx]))
+        loser = j if winner == i else i
+        if winner not in movers or loser in movers:
