+    if out.shape != grid.shape:
+        return False
+    if np.array_equal(out, grid):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
+    count = random.choice(SEGMENT_COUNT_CHOICES)
