+        if len(group) < 2:
+            continue
+        for i in range(len(group)):
+            for j in range(i + 1, len(group)):
+                a = group[i]
+                b = group[j]
+                if a["s"] == b["s"]:
+                    continue
+                if a["length"] == b["length"]:
