+    if not pairs:
+        return None
+    return random.choice(pairs)
+
+
+def _pick_segments(candidates: list[dict], count: int, scenario: str) -> list[dict] | None:
+    chosen: list[dict] = []
+    pair = _pick_pair(candidates, scenario)
+    if pair is None and scenario != "none":
+        return None
+    if pair is not None:
+        chosen.extend(pair)
+
+    pool = candidates[:]
+    random.shuffle(pool)
+    for seg in pool:
+        if len(chosen) == count:
+            break
+        if any(seg["s"] == other["s"] for other in chosen):
+            continue
+        if any(not _cells_are_clear(seg["cells"], other["cells"]) for other in chosen):
+            continue
+        if any(not _source_target_clear(seg, other) for other in chosen):
+            continue
+
+        overlaps = [other for other in chosen if _target_overlap(seg, other)]
+        if overlaps:
+            if scenario == "none":
+                continue
+            pair_ids = {id(obj) for obj in pair} if pair is not None else set()
+            if id(seg) in pair_ids:
+                continue
+            if any(id(other) not in pair_ids for other in overlaps):
+                continue
+            if len(overlaps) > 0:
+                continue
