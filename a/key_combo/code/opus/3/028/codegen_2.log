+def _segment_info(shape: tuple[int, int], s: int, color: int, c0: int, c1: int) -> dict:
+    length = int(c1 - c0 + 1)
+    bottom_row = int(s - c0)
+    top_row = int(s - c1)
+    cells = [(int(s - c), int(c)) for c in range(c0, c1 + 1)]
