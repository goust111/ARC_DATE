+
+    for _ in range(80):
+        chosen = _pick_segments(candidates, count, scenario)
+        if chosen is None:
+            continue
+
+        colors = random.sample(COLOR_POOL, count)
+        segments = []
+        grid = np.full((h, w), Color.BLACK, dtype=int)
