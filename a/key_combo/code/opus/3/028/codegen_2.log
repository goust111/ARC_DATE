+def _can_place_noise(
+    cell: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    foreign_cells: set[tuple[int, int]],
+) -> bool:
+    if cell in occupied:
+        return False
+    r, c = cell
+    for rr, cc in occupied | foreign_cells:
+        if abs(rr - r) + abs(cc - c) <= 1:
+            return False
+    return True
