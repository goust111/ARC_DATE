+
+    if len(chosen) != count:
+        return None
+
+    overlap_pairs = 0
+    for i in range(len(chosen)):
+        for j in range(i + 1, len(chosen)):
+            if _target_overlap(chosen[i], chosen[j]):
+                overlap_pairs += 1
