+            claims.setdefault(cell, []).append(idx)
+
+    blocked: set[int] = set()
+    for idxs in claims.values():
+        if len(idxs) <= 1:
+            continue
+        winner = min(idxs, key=lambda idx: _priority_key(segments[idx]))
+        for idx in idxs:
+            if idx != winner:
+                blocked.add(idx)
+    return {idx for idx in range(len(segments)) if idx not in blocked}
