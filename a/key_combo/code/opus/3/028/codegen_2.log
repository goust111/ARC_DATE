+        "color": int(color),
+        "c0": int(c0),
+        "c1": int(c1),
+        "length": int(length),
+        "top_row": int(top_row),
+        "bottom_row": int(bottom_row),
+        "cells": cells,
+        "target": target,
+        "target_sum": int(bottom_row + c1 + 1),
