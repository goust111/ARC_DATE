+def _ensure_arc_utils_on_path() -> None:
+    here = Path(__file__).resolve()
+    for parent in [here.parent, *here.parents]:
+        candidate = parent / "new" / "solvers"
+        if candidate.is_dir():
+            path = str(candidate)
+            if path not in sys.path:
