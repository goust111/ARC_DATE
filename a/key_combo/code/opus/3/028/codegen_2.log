+def _segment_summary(seg: dict) -> tuple[int, int, int]:
+    return int(seg["s"]), int(seg["c0"]), int(seg["length"])
+
+
+def _validate_generated(grid: np.ndarray, scenario: str, source_segments: list[dict]) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
