+
+def _cells_are_clear(cells_a: list[tuple[int, int]], cells_b: list[tuple[int, int]]) -> bool:
+    for ra, ca in cells_a:
+        for rb, cb in cells_b:
+            if abs(ra - rb) + abs(ca - cb) <= 1:
+                return False
+    return True
+
