+def _interval_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return max(a0, b0) <= min(a1, b1)
+
+
+def _target_overlap(a: dict, b: dict) -> bool:
+    return bool(set(a["target"]) & set(b["target"]))
+
