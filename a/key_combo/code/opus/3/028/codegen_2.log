+    blocked: set[int] = set()
+    for idxs in claims.values():
+        if len(idxs) <= 1:
+            continue
+        winner = min(idxs, key=lambda idx: _priority_key(segments[idx]))
+        for idx in idxs:
+            if idx != winner:
