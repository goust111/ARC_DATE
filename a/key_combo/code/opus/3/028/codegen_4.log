print('valid count',len(valid))
# summarize
from collections import Counter
print('corner count dist', Counter(v[1] for v in valid))
print('raycell total dist', Counter(v[2] for v in valid).most_common(10))
print('tie count', sum(1 for v in valid if v[3]))
# show some examples with tie
