+    for br in range(MASK_SIDE):
+        for bc in range(MASK_SIDE):
+            tile = g[br * TILE_SIDE : (br + 1) * TILE_SIDE, bc * TILE_SIDE : (bc + 1) * TILE_SIDE]
+            on = bool(tile[0, 0] == FRACTAL_COLOR)
