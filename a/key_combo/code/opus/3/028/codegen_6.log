+        expected,
+        template_cells,
+        display_shape,
+        blue_defects,
+        blue_matched,
+        red_defects,
+        red_matched,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input grid")

