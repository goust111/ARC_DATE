+    grid = np.zeros((H, W), dtype=int)
+
+    template_r, template_c = _corner_position(template_shape, grid_shape, template_corner)
+    template_cells = {(template_r + r, template_c + c) for r, c in template_shape}
+    for r, c in template_cells:
+        grid[r, c] = Color.TEAL
+
