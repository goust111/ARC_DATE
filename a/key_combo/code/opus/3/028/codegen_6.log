+    matches: list[tuple[tuple[int, int], frozenset[Coord]]] = []
+    seen: set[frozenset[Coord]] = set()
+    for variant in variants:
+        h, w = _shape_size(variant)
+        for r0 in range(H - h + 1):
+            for c0 in range(W - w + 1):
