+    crop = crop_bbox(grid == Color.TEAL, box)
+    return tuple(sorted((int(r), int(c)) for r, c in np.argwhere(crop)))
+
+
+def _shape_cells(shape: Shape, r0: int, c0: int) -> frozenset[Coord]:
