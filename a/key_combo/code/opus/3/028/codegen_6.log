+    if not (MIN_REGION_FILL_AREA <= red_fill_area <= MAX_REGION_FILL_AREA):
+        return None
+
+    expected = _oracle_output(grid, template_cells, blue_matched, blue_noise, red_matched, red_noise)
+    if not _validate_generated(
