+    template_shape: Shape,
+    template_corner: str,
+    blue_mask: np.ndarray,
+    blue_pos: tuple[int, int],
+    blue_defects: set[Coord],
+    red_mask: np.ndarray,
+    red_pos: tuple[int, int],
+    red_defects: set[Coord],
