+    return placements
+
+
+def _noise_choices(pool: list[Coord], count: int, matched: set[Coord]) -> list[tuple[Coord, ...]]:
+    far = [
+        cell
+        for cell in pool
+        if all(abs(cell[0] - mr) + abs(cell[1] - mc) >= 2 for mr, mc in matched)
