+        outline: set[Coord] = set()
+        for r, c in matched:
+            for nr, nc in neighbors4(r, c):
+                if in_bounds(g.shape, nr, nc) and int(g[nr, nc]) == int(region_color):
+                    outline.add((nr, nc))
+        opposite = _other_region_color(region_color)
+        for r, c in outline:
+            out[r, c] = opposite
