+        for r, c in cells:
+            for nr, nc in neighbors4(r, c):
+                if (nr, nc) not in cells:
+                    boundary_colors.add(int(grid[nr, nc]))
+        if boundary_colors == {int(region_color)}:
+            defects.update(cells)
+    return defects
