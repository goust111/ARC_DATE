+        for reflected in (False, True):
+            candidate = transformed.copy()
+            if reflected:
+                candidate[:, 1] = -candidate[:, 1]
+            normalized = _normalize(candidate)
+            if normalized not in seen:
+                seen.add(normalized)
+                variants.append(normalized)
