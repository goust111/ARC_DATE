+        grid[r, c] = Color.BLUE
+    for r, c in red_cells:
+        grid[r, c] = Color.RED
+
+    for r, c in _globalize(blue_defects, *blue_pos):
+        grid[r, c] = Color.BLACK
+    for r, c in _globalize(red_defects, *red_pos):
+        grid[r, c] = Color.BLACK
