+    if corner == "tr":
+        return 0, W - w
+    if corner == "bl":
+        return H - h, 0
+    return H - h, W - w
+
+
+def _globalize(cells: set[Coord] | frozenset[Coord], r0: int, c0: int) -> set[Coord]:
