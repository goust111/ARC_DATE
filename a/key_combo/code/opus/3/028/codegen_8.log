+def _tile_pinwheel(pinwheel: np.ndarray) -> np.ndarray:
+    tile_h, tile_w = map(int, pinwheel.shape)
+    out = np.zeros((2 * tile_h, 2 * tile_w), dtype=int)
+    for r0 in (0, tile_h):
