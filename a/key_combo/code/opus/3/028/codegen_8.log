+    active = pattern != Color.BLACK
+    center = (int(pattern.shape[0]) - 1) / 2.0
+    rr, cc = np.indices(pattern.shape)
+    chebyshev = np.maximum(np.abs(rr - center), np.abs(cc - center))
+    layers = _round_half_up(chebyshev)
