                critical.append((rr,cc))
    assert critical
    noise_count = 2 + ((idx + area) % 3)
    grey_count = 1 + ((idx + N) % 2)
    noise = [critical[idx % len(critical)]]
    def far_ok(cell, selected):
        r, c = cell
        if cell in blocked or cell in selected:
            return False
        for sr, sc in sprite_set:
            if abs(sr-r)+abs(sc-c)==1:
                return False
        for rr, cc in selected:
            if abs(rr-r)+abs(cc-c)==1:
                return False
        return True
    all_cells = [(r,c) for r in range(h) for c in range(w)]
    start = (idx * 7 + area) % len(all_cells)
    ordered = all_cells[start:] + all_cells[:start]
    for cell in ordered:
        if len(noise) == noise_count:
            break
        if far_ok(cell, noise):
            noise.append(cell)
    assert len(noise) == noise_count
    for cell in noise:
        g[cell] = Color.ORANGE
        blocked.add(cell)
    greys = []
    start2 = (idx * 11 + N) % len(all_cells)
    ordered2 = all_cells[start2:] + all_cells[:start2]
    for cell in ordered2:
        if len(greys) == grey_count:
