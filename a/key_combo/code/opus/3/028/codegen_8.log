    outs.add((out.shape, out.tobytes()))
    all_box = bbox_coords(np.argwhere(g == Color.ORANGE))
    assert all_box != box
print('"'catalog', len(catalog), 'unique outputs', len(outs))
print('sample shapes', [build_input(catalog[i], i).shape for i in range(10)])
