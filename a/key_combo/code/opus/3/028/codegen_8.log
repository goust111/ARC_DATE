def choose_positions(shape, blocked, required_gap_to_orange=False, need=1, start=0):
    H, W = shape
    blocked = set(blocked)
    selected = []
    # rotate row-major order by start
    all_cells = [(r,c) for r in range(H) for c in range(W)]
    start %= len(all_cells)
    ordered = all_cells[start:] + all_cells[:start]
    orange = {p for p in blocked if isinstance(p, tuple)}
