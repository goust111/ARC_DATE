+    paste(pinwheel, sprite, 0, 0)
+    paste(pinwheel, np.rot90(sprite, 1), 0, size)
+    paste(pinwheel, np.rot90(sprite, 2), size, 0)
+    paste(pinwheel, np.rot90(sprite, -1), size, size)
+    return pinwheel
+
