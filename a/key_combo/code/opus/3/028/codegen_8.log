+    _validate_generated_grid(_INPUT_CATALOG[catalog_id], sprite)
+
+
+def generate_input() -> np.ndarray:
+    size = random.choice((2, 3))
+    catalog_id = random.choice(_CATALOG_IDS_BY_SIZE[size])
+    return _INPUT_CATALOG[catalog_id].copy()

