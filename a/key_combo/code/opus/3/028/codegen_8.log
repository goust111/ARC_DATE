TEMPLATE_SIZES = (4, 5)
TEMPLATE_BBOX_MAX = 3
TEMPLATE_FLAT_CELLS = range(TEMPLATE_BBOX_MAX * TEMPLATE_BBOX_MAX)
TEMPLATE_CONNECTIVITY = 8

# Copy placement and local green-noise requirements.
COPY_COUNT_MIN, COPY_COUNT_MAX_EXCL = 1, 4
