        r, c = cell
        if cell in blocked or cell in greys:
            continue
        if any(abs(r-orr)+abs(c-occ) == 0 for orr,occ in sprite_set):
            continue
        if any(abs(r-nr)+abs(c-nc) == 0 for nr,nc in noise):
            continue
        greys.append(cell)
    assert len(greys) == grey_count
    for cell in greys:
        g[cell] = Color.GREY
    return g

outs = set()
for idx, mask in enumerate(catalog):
