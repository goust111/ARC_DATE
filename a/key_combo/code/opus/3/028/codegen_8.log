        sprite_cells.append((rr, cc))
    sprite_set = set(sprite_cells)
    blocked = set(sprite_set) | {(h-1,w-2), (h-1,w-1)}
    critical = []
    for dr, dc in [(-1,-1), (-1,N), (N,-1), (N,N), (-1,0), (0,-1), (N,0), (0,N)]:
