+        patch = panel.copy()
+        if panel_id == 0:
+            patch[:2, :2] = legend
+        grid[:, c0 : c0 + PANEL_WIDTH] = patch
+        if panel_id < PANEL_COUNT - 1:
+            grid[:, c0 + PANEL_WIDTH] = int(Color.GREY)
