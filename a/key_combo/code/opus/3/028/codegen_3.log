+def _oracle_output(clean_panels: list[np.ndarray], keys: tuple[tuple[int, ...], ...], legend_pairs) -> tuple[np.ndarray, tuple[int, ...]]:
+    order = _sorted_order(keys)
+    stitched = np.concatenate([clean_panels[idx] for idx in order], axis=1)
