+KEY_CATALOG = {
+    panel_id: [
+        key
+        for length in MARKER_LENGTHS
+        for key in itertools.permutations([other for other in range(PANEL_COUNT) if other != panel_id], length)
+    ]
+    for panel_id in range(PANEL_COUNT)
