+    H, W = g.shape
+    if center_r - k < 0 or center_r + k >= H or center_c - k < 0 or center_c + k >= W:
+        return None
+
+    if not np.all(g[center_r, center_c - k : center_c + k + 1] == BLACK):
+        return None
+    if not np.all(g[center_r - k : center_r + k + 1, center_c] == BLACK):
+        return None
+
