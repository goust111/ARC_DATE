+    for motif in motifs:
+        box = (motif.r - motif.k, motif.c - motif.k, motif.r + motif.k, motif.c + motif.k)
+        for r0, c0, r1, c1 in boxes:
+            if not (box[2] < r0 or r1 < box[0] or box[3] < c0 or c1 < box[1]):
+                return False
+        boxes.append(box)
+    return True
+
+
