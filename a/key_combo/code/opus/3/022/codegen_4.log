+        r0, c0 = _corner_top_left(center_r, center_c, motif.k, corner)
+        rr0 = max(0, r0)
+        cc0 = max(0, c0)
+        rr1 = min(H, r0 + motif.k)
+        cc1 = min(W, c0 + motif.k)
