+BLUE = int(Color.BLUE)
+RED = int(Color.RED)
+GREEN = int(Color.GREEN)
+CYAN = int(Color.TEAL)
+
+NWSE = "nwse"
+NESW = "nesw"
+CORNERS = ("NW", "NE", "SW", "SE")
+GUIDE_MARGIN = 4
+GUIDE_GAP = 6
+RETRY_LIMIT = 400
