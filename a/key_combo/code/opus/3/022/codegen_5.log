+def _make_candidate(shape: tuple[int, int], walls: set[Coord], blue: Coord, red: Coord) -> dict:
+    cells = _cells_toward_target(blue, red)
+    current = blue
+    stop = blue
+    reason = ""
+    wall_index: int | None = None
+
+    for idx, nxt in enumerate(cells):
+        if nxt == red:
+            stop = current
+            reason = "red"
+            break
+        if nxt in walls:
+            stop = current
+            reason = "orange"
+            wall_index = idx
