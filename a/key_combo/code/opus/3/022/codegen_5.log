+    candidates = _enumerate_candidates(shape, projectors)
+    blocked = [pair for pair in candidates if pair["reason0"] == "orange"]
+    clear = [pair for pair in candidates if pair["reason0"] == "red"]
+    if not blocked or not clear:
+        return None
+
