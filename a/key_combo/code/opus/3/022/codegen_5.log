+
+def _cells_toward_target(start: Coord, target: Coord) -> list[Coord]:
+    sr, sc = start
+    tr, tc = target
+    dr = int(np.sign(tr - sr))
+    dc = int(np.sign(tc - sc))
+    assert (dr == 0) ^ (dc == 0), "blue and red must share exactly one axis"
+
+    cells: list[Coord] = []
+    r, c = sr, sc
