+
+
+BG = int(Color.BLACK)
+SPRITE = int(Color.GREY)
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+MARK_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_SIDE_MIN = 15
+GRID_SIDE_MAX = 24
+MARK_COUNT_CHOICES = (3, 4)
