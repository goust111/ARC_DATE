    else:
        fg_blocks = [(r0, c0 + s), (r0 + s, c0)]
        target_blocks = [(r0 - s, c0 - s), (r0 + span, c0 + span)]
    return fg_blocks, target_blocks


def _gen_motif_parts(
    shape: tuple[int, int], r0: int, c0: int, size: int, diagonal: int
) -> dict | None:
    s = int(size)
