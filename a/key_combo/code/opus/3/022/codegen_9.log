                cc = c + dc
                if 0 <= rr < H and 0 <= cc < W:
                    out.add((rr, cc))
    return out


def _gen_block_origins(
    r0: int, c0: int, size: int, diagonal: int
) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
