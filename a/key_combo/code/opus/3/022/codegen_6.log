    for r in range(h):
        for c in range(col_stop):
            coords = ((r, c), (r, c + 1)) if horizontal else ((r, c), (r + 1, c))
            if coords[-1][0] < h and _gen_object_fits(grid, coords):
                placements.append(coords)
    return placements


