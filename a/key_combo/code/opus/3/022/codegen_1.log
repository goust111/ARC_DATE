+        panel_h = sum(row_sizes) + GAP * (slot_rows - 1)
+        panel_w = sum(col_sizes) + GAP * (slot_cols - 1)
+        return panel_h, panel_w, row_sizes, col_sizes
+    return None
+
+
+def _slot_boxes(row_sizes: list[int], col_sizes: list[int]) -> list[tuple[int, int, int, int]]:
