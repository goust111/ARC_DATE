+        chosen.add(cell)
+        for nb in _neighbors4(*cell):
+            if 0 <= nb[0] < h and 0 <= nb[1] < w and not rect_mask[nb] and nb not in chosen:
+                frontier.append(nb)
+
+    return sorted(chosen)
+
+
+def _build_mask(
+    shape: tuple[int, int],
+    rects: list[tuple[int, int, int, int]],
+    hit_flags: list[bool],
+) -> np.ndarray:
