+    rects.sort()
+    return rects
+
+
+def _paint_rectangles(
+    shape: tuple[int, int],
+    rects: list[tuple[int, int, int, int]],
+) -> np.ndarray:
+    panel = np.zeros(shape, dtype=int)
+    for r0, c0, r1, c1 in rects:
+        panel[r0 : r1 + 1, c0 : c1 + 1] = BLUE
