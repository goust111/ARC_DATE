+PANEL_WIDTH_RANGE = (6, 14)
+RECT_COUNT_CHOICES = (2, 3, 4)
+SLOT_COUNT_CHOICES = (1, 2, 3)
+GAP = 1
+GENERATION_ATTEMPTS = 400
