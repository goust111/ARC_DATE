+        parts[random.randrange(slot_count)] += 1
+    random.shuffle(parts)
+    return parts
+
+
+def _sample_layout(rect_count: int) -> tuple[int, int, list[int], list[int]] | None:
+    layouts = [
+        (slot_rows, slot_cols)
+        for slot_rows in SLOT_COUNT_CHOICES
+        for slot_cols in SLOT_COUNT_CHOICES
