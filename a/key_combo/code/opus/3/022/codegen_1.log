+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+DIVIDER = 5
+
+PANEL_HEIGHT_RANGE = (8, 14)
+PANEL_WIDTH_RANGE = (6, 14)
+RECT_COUNT_CHOICES = (2, 3, 4)
+SLOT_COUNT_CHOICES = (1, 2, 3)
+GAP = 1
+GENERATION_ATTEMPTS = 400
+VALIDATION_ATTEMPTS = 200
