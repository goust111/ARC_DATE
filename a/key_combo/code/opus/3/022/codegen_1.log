+
+
+def _paint_fragment(mask: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    for r, c in cells:
+        mask[r, c] = RED
+
+
+def _background_anchor_cells(
+    shape: tuple[int, int],
+    rects: list[tuple[int, int, int, int]],
