+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+
+    left, right = _extract_panels(g)
+    rects = _extract_rectangles(left)
+    out, _hit_flags = _render_expected(left, right, rects)
+    return out
