+    bottom_margin = random.randint(1, 4)
+    height = top_margin + frame_h + bottom_margin
+    frame_r0 = top_margin
+    frame_c0 = left_width
+    frame_bbox = (frame_r0, frame_c0, frame_r0 + frame_h - 1, frame_c0 + frame_w - 1)
