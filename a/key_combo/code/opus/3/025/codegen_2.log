+def _sprite_infos(grid: np.ndarray) -> list[dict]:
+    bg = int(get_bg(grid))
+    comps = find_components(
+        grid,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        colors=[GREY],
+        return_format="dict",
