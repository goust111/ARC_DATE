+def _ray_cells(
+    shape: tuple[int, int],
+    sprite_mask: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    holes: int,
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = HOLE_TO_DIRECTION[holes]
+    r, c = _ray_start(bbox, holes)
+    cells: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        if bool(sprite_mask[r, c]):
+            break
+        cells.append((int(r), int(c)))
+        r += dr
+        c += dc
+    return cells
