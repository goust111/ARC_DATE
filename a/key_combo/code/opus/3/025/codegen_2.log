        patch = spec["patch"]
        r0 = int(spec["bbox"][0])
        c0 = int(spec["bbox"][1])
        colored = np.where(patch, HOLE_TO_COLOR[int(spec["holes"])], background)
        paste(out, colored, r0, c0, transparent=background)
        paste(sprite_mask, patch, r0, c0, transparent=False)

