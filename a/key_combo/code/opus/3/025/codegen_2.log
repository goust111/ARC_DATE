   228	    bg = int(get_bg(g))
   229	    infos = _sprite_infos(g)
   230	    assert infos, "expected at least one grey sprite"
   231	    for info in infos:
   232	        assert int(info["holes"]) in HOLE_TO_DIRECTION, "hole count must be in 0..3"
   233	    out, _visits = _render_output(g.shape, infos, background=bg)
   234	    return out
