   251	    slots = [OUTER_MARGIN]
   252	    for _ in range(len(lengths) - 1):
   253	        slots.append(random.randint(*GAP_RANGE))
   254	    slots.append(OUTER_MARGIN)
   255	    base = sum(lengths) + sum(slots)
   256	    min_size = max(GRID_MIN, base)
   257	    if min_size > GRID_MAX:
