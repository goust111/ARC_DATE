# CFG: hole and marker-color sampling.
HOLE_COUNT_BOUNDS, MIN_HOLE_FRACTION, MAX_HOLE_FRACTION = (3, 5), (1, 2), (5, 6)
MARKER_COLOR_BOUNDS = (3, 4)
