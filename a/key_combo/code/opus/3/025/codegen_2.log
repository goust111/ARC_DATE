+    infos: list[dict] = []
+    for comp in comps:
+        bbox = tuple(map(int, comp["bbox"]))
+        patch = crop_bbox(grid, bbox) == GREY
+        holes = _hole_count(patch)
+        infos.append(
+            {
+                "bbox": bbox,
+                "coords": comp["coords"],
+                "holes": int(holes),
+                "patch": patch,
