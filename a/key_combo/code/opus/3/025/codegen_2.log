   150	    if (dr, dc) == (0, 1):
   151	        r, c = bbox_anchor(bbox, anchor="right center")
   152	        return int(r), int(c + 1)
   153	    if (dr, dc) == (0, -1):
   154	        r, c = bbox_anchor(bbox, anchor="left center")
