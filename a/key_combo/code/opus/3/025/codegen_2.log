   240	    if random.random() < 0.5:
   241	        mask = np.flipud(mask)
   242	    if random.random() < 0.5:
   243	        mask = np.fliplr(mask)
   244	    assert _hole_count(mask) == hole_count
   245	    patch = np.full(mask.shape, BG, dtype=int)
   246	    patch[mask] = GREY
   247	    return patch
