    for spec in sprite_specs:
        for cell in _ray_cells(shape, sprite_mask, spec["bbox"], int(spec["holes"])):
            visits[cell] = visits.get(cell, 0) + 1

    for (r, c), count in visits.items():
        out[r, c] = ORANGE if count >= 2 else GREY
    return out, visits


