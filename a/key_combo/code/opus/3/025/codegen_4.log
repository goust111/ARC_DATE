            rr0 = max(0, r - 1)
            cc0 = max(0, c - 1)
            rr1 = min(panel_h, r + h + 1)
            cc1 = min(panel_w, c + w + 1)
            blocked[rr0:rr1, cc0:cc1] = True
            positions[idx] = (r, c)
            if search(depth + 1):
                return True
            positions[idx] = None
            blocked[rr0:rr1, cc0:cc1] = False
        return False

