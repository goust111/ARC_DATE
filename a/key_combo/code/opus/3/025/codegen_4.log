+BG = Color.BLACK
+DIVIDER = Color.GREY
+DIFF = Color.RED
+COLOR_POOL = (Color.BLUE, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON)
+MAX_GENERATION_ATTEMPTS = 400
