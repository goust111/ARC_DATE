+    "sym": {
+        (2, 2): [["11", "11"]],
+        (2, 3): [["110", "011"]],
+        (2, 4): [["1110", "0111"]],
+        (3, 3): [["010", "111", "010"], ["110", "111", "011"]],
+        (3, 4): [["1100", "1111", "0011"], ["1000", "1111", "0001"]],
+    },
+    "asym": {
+        (2, 2): [["11", "10"]],
+        (2, 3): [["111", "100"], ["111", "101"]],
+        (2, 4): [["1111", "1000"], ["1111", "1010"]],
+        (3, 3): [["110", "100", "111"], ["111", "101", "100"]],
+        (3, 4): [["1111", "1001", "1000"], ["1110", "1000", "1111"]],
