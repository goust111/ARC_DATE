0071: def main(grid: np.ndarray) -> np.ndarray:
0072:     """
0073:     Crop the largest object and overlay each smaller sprite where its shared marker pattern matches.
0074: 
0075:     Input structure
0076:     - The background is the most common color, and the foreground has one largest destination object plus smaller source sprites.
0077:     - Each source sprite shares exactly one marker color with the destination object.
0078: 
0079:     Rule
0080:     - Output the tight bbox crop of the largest object.
0081:     - Translate each source sprite so every connected marker component of the shared color exactly matches destination marker components.
0082:     - Paste source sprites in decreasing area order, so smaller sprites can sit on top of larger ones when they overlap.
0083: 
0084:     Key insight
0085:     - The shared-color marker components are alignment keys; matching whole marker components distinguishes singleton slots from larger same-color marker blocks.
0086:     """
0087:     g = np.asarray(grid, dtype=int)
0088:     bg = int(get_bg(g))
0089: 
0090:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
0091:     assert len(comps) >= 2, "must have a destination object and at least one source sprite"
0092: 
0093:     areas = [int(comp["area"]) for comp in comps]
0094:     max_area = max(areas)
0095:     assert areas.count(max_area) == 1, "largest destination object must be unique"
0096:     dst_index = areas.index(max_area)
0097:     dst_comp = comps[dst_index]
0098:     dst_patch, dst_mask, dst_colors = _component_data(g, dst_comp)
0099: 
0100:     sources = [comp for idx, comp in enumerate(comps) if idx != dst_index]
0101:     source_areas = [int(comp["area"]) for comp in sources]
0102:     assert len(set(source_areas)) == len(source_areas), "source sprites must have distinct areas for layering"
0103:     sources.sort(key=lambda comp: -int(comp["area"]))
0104: 
0105:     out = dst_patch.copy()
0106:     out_h, out_w = out.shape
0107: 
0108:     for src_comp in sources:
0109:         src_patch, src_mask, src_colors = _component_data(g, src_comp)
0110:         common_colors = src_colors & dst_colors
0111:         assert len(common_colors) == 1, "each source must share exactly one marker color with the destination"
0112:         marker_color = next(iter(common_colors))
0113: 
0114:         src_marker = (src_patch == marker_color) & src_mask
0115:         dst_marker = (dst_patch == marker_color) & dst_mask
0116:         assert bool(src_marker.any()) and bool(dst_marker.any()), "marker pixels must exist in source and destination"
0117: 
0118:         top, left = _unique_marker_offset(src_marker, dst_marker)
0119:         src_h, src_w = src_patch.shape
0120:         assert 0 <= top and 0 <= left, "translated sprite must fit inside destination crop"
0121:         assert top + src_h <= out_h and left + src_w <= out_w, "translated sprite must fit inside destination crop"
0122:         paste(out, src_patch, top, left, mask=src_mask, overwrite=True)
0123: 
