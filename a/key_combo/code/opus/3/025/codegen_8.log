0011: def main(grid: np.ndarray) -> np.ndarray:
0012:     """
0013:     Crop the large filled rectangle and stamp each external red sprite onto the matching marker inside it.
0014: 
0015:     Input structure
0016:     - The background is the dominant color.
0017:     - One large 8-connected foreground component is a filled rectangle whose fill color contains isolated marker pixels.
0018:     - Each smaller 8-connected component is a sprite made from a shared stamp color plus exactly one marker color.
0019: 
0020:     Rule
0021:     - Use the largest foreground component as the target rectangle and crop to its bounding box.
0022:     - Infer the stamp color as the only color common to all smaller source sprites.
0023:     - For every marker pixel inside the target rectangle, find the source sprite with the same marker color.
0024:     - Copy that sprite's stamp-color offsets relative to its marker onto the cropped target, preserving the target marker.
0025: 
0026:     Key insight
0027:     - The isolated marker color is a key: it tells which off-rectangle sprite mask should be aligned to that same-colored marker in the filled rectangle.
0028:     """
0029:     g = np.asarray(grid, dtype=int)
