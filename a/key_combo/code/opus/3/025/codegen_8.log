0139:             continue
0140:         cells = _completed_cells(g, bg, color, template)
0141:         assert not (cells & painted), "completed copies of different colors must not overlap"
0142:         for r, c in cells:
0143:             out[r, c] = color
0144:         painted = painted | cells
0145: 
0146:     return out
