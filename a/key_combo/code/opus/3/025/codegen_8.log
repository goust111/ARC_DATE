+    if clear_even_segments is None:
+        return None
+    clear_odd_segments = _place_piece(grid, occupied, used_diagonals, clear_odd_piece, tail_min=2)
+    if clear_odd_segments is None:
+        return None
+
+    extra_count = int(np.random.randint(0, 3))
