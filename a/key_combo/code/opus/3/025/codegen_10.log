)

# Marker component counts, shape library, and spacing.
MARKER_COUNT_RANGE, MARKER_AREA_RANGE = (2, 4), (1, 8)
MARKER_SHAPE_BOX, MARKER_BORDER, MARKER_CLEARANCE = 3, 1, 1
MIN_GROUPS_SINGLE_SOURCE, MIN_GROUPS_TWO_SOURCES = 1, 2

