+        return False
+    best_area = min(area for area, _pr, _pc in candidates)
+    if sum(area == best_area for area, _pr, _pc in candidates) != 1:
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    H = random.randint(*GRID_SIDE_RANGE)
+    W = random.randint(*GRID_SIDE_RANGE)
+
