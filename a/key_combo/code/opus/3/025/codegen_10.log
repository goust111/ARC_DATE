+def _tile_has_full_period(tile: np.ndarray) -> bool:
+    h, w = tile.shape
+    for pr in range(1, h + 1):
+        for pc in range(1, w + 1):
+            probe = np.zeros_like(tile)
+            _apply_tile(probe, (0, 0, h - 1, w - 1), tile[:pr, :pc])
+            if np.array_equal(probe, tile):
