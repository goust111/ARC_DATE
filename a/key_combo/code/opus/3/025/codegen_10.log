+        top = random.randint(r0 + 1, r1 - h)
+        left = random.randint(c0 + 1, c1 - w)
+        occ = (top, left, top + h - 1, left + w - 1)
+        if legend_on_pattern and _bbox_overlap(occ, legend_bbox):
+            continue
+        return occ
+    return None
+
