+    return pattern_bbox, legend_bbox
+
+
+def _choose_occlusion(pattern_bbox: BBox, legend_bbox: BBox, legend_on_pattern: bool) -> BBox | None:
+    r0, c0, r1, c1 = pattern_bbox
+    pat_h, pat_w = _bbox_dims(pattern_bbox)
+    for _ in range(200):
