+    axis = random.choice(OUTSIDE_AXES)
+    if axis == "h":
+        if corner in ("tl", "tr"):
+            pattern_bbox = (legend_h + 1, 0, H - 1, W - 1)
+        else:
+            pattern_bbox = (0, 0, H - legend_h - 2, W - 1)
+    else:
+        if corner in ("tl", "bl"):
