+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    expected: np.ndarray,
+    pattern_bbox: BBox,
+    legend_bbox: BBox,
+    occlusion_bbox: BBox,
+    mapping: dict[int, int],
+    legend_on_pattern: bool,
+) -> bool:
