+        allowed = lambda c: c < w // 2
+    else:
+        allowed = lambda c: c > (w - 1) // 2
+
+    candidates: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(mask):
