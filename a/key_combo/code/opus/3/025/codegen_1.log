+            if not candidates:
+                break
+            rr, cc = rng.choice(candidates)
+            shape[rr, cc] = True
+            extras += 1
+            if extras >= 1 and int(shape.sum()) >= AREA_RANGE[0] and rng.random() < 0.25:
+                break
+
+        if extras == 0:
