+
+
+def _patch_cells(sprite: Sprite) -> frozenset[Coord]:
+    return sprite.cells | {sprite.indicator}
+
+
+def _conflicts(sprite: Sprite, blocked: set[Coord]) -> bool:
+    return any(cell in blocked for cell in _patch_cells(sprite))
