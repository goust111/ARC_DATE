+
+def _all_candidates(
+    shape: tuple[Coord, ...],
+    direction: str,
+    color: int,
+    area: int,
+    grid_shape: tuple[int, int],
+) -> list[Sprite]:
+    h, w = map(int, grid_shape)
+    shape_h, shape_w = _shape_dims(shape)
+    top_start, top_stop = 0, h - shape_h
+    left_start, left_stop = 0, w - shape_w
