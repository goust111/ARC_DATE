+Coord = tuple[int, int]
+
+BG = Color.BLACK
+INDICATOR = Color.MAROON
+OBJECT_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW)
+DIRECTIONS = ("up", "right", "down", "left")
+
+GRID_SIDE_RANGE = (20, 28)
+OBJECT_COUNT_RANGE = (3, 4)
+AREA_VALUES = tuple(range(4, 11))
+MAX_SHAPE_SIDE = 5
+SHAPE_RETRIES = 200
+GEN_RETRIES = 500
