+from __future__ import annotations
+
+import random
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+
+
+for parent in Path(__file__).resolve().parents:
+    for candidate in (parent / "new" / "solvers", parent / "new"):
