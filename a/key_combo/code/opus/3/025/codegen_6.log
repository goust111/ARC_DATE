+Coord = tuple[int, int]
+
+BG = Color.BLACK
+INDICATOR = Color.MAROON
+OBJECT_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW)
+DIRECTIONS = ("up", "right", "down", "left")
