+    for area in areas:
+        choices: list[tuple[Coord, ...]] = []
+        for _ in range(25):
+            shape = _generate_shape(area)
+            if shape is None:
+                continue
+            if shape in seen:
+                continue
+            choices.append(shape)
+        if not choices:
+            return None
+        shape = random.choice(choices)
+        seen.add(shape)
+        shapes.append(shape)
+    return shapes
+
