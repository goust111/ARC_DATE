+    ir, ic = map(int, indicator)
+    if ir == r0 - 1 and c0 <= ic <= c1:
+        return "up"
+    if ic == c1 + 1 and r0 <= ir <= r1:
+        return "right"
+    if ir == r1 + 1 and c0 <= ic <= c1:
