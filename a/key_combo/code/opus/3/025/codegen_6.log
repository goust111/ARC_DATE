+    options: list[Coord] = []
+    if direction == "up":
+        for c in range(c0, c1 + 1):
+            if (r0, c) in cell_set:
+                options.append((r0 - 1, c))
+    elif direction == "down":
+        for c in range(c0, c1 + 1):
+            if (r1, c) in cell_set:
+                options.append((r1 + 1, c))
+    elif direction == "left":
+        for r in range(r0, r1 + 1):
+            if (r, c0) in cell_set:
