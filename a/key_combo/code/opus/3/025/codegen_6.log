+    shape_h, shape_w = _shape_dims(shape)
+    top_start, top_stop = 0, h - shape_h
+    left_start, left_stop = 0, w - shape_w
+    if direction == "up":
+        top_start = 1
+    elif direction == "down":
+        top_stop = h - shape_h - 1
+    elif direction == "left":
+        left_start = 1
+    elif direction == "right":
