+def _normalize(cells: set[Coord] | list[Coord] | tuple[Coord, ...]) -> tuple[Coord, ...]:
+    arr = np.array(sorted(cells), dtype=int)
+    r0, c0, _r1, _c1 = bbox_coords(arr)
