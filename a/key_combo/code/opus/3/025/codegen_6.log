+                    offsets = _normalize(trial)
+                    h, w = _shape_dims(offsets)
+                    if h > MAX_SHAPE_SIDE or w > MAX_SHAPE_SIDE:
+                        continue
+                    seen_frontier.add((int(nr), int(nc)))
+                    frontier.append((int(nr), int(nc)))
