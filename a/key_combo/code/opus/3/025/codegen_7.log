+    markers = []
+    for idx, ((slot_row, slot_col), quadrant) in enumerate(zip(chosen_slots, quadrants)):
+        rel_r, rel_c = _choose_marker_cell(
+            rng,
+            sprite,
+            quadrant,
+            force_overlap=(idx == force_overlap_index),
+        )
+        r0, c0 = _slot_origin(slot_row, slot_col, left_width, h, w)
