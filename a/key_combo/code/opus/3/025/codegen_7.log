+
+def _quadrant_cells(h: int, w: int, quadrant: str) -> list[tuple[int, int]]:
+    cells = []
+    for r in range(h):
+        for c in range(w):
+            if _quadrant_of(r, c, h, w) == quadrant:
+                cells.append((r, c))
