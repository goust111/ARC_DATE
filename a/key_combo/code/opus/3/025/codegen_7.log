+    empty = [(r, c) for r, c in candidates if int(sprite[r, c]) == BG]
+    edge = [
+        (r, c)
+        for r, c in candidates
+        if (h % 2 == 1 and r == h // 2) or (w % 2 == 1 and c == w // 2)
+    ]
