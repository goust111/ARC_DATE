+
+def _random_path(rng: np.random.Generator, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    moves = []
+    if er != r:
+        moves.extend([(1 if er > r else -1, 0)] * abs(er - r))
+    if ec != c:
+        moves.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
+    rng.shuffle(moves)
+    out = [(r, c)]
+    for dr, dc in moves:
+        r += dr
+        c += dc
+        out.append((r, c))
+    return out
+
+
+def _frontier_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    frontier = set()
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                frontier.add((nr, nc))
+    return list(frontier)
+
+
+def _sprite_ok(mask: np.ndarray) -> bool:
+    box = bbox(mask)
+    if box is None:
+        return False
+    h, w = mask.shape
+    if box != (0, 0, h - 1, w - 1):
+        return False
+    if np.all(mask):
+        return False
+    for quadrant in QUADRANTS:
+        row_slice, col_slice = _quadrant_slices(h, w, quadrant)
+        sub = mask[row_slice, col_slice]
+        if not np.any(sub):
+            return False
+        if np.all(sub):
+            return False
