+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+import sys
+
+import numpy as np
+
+
+def _load_arc_utils():
+    here = Path(__file__).resolve()
+    for parent in here.parents:
+        candidate = parent / "new" / "solvers" / "arc_utils.py"
+        if not candidate.exists():
+            continue
+        util_dir = str(candidate.parent)
+        if util_dir not in sys.path:
+            sys.path.insert(0, util_dir)
+        try:
+            import arc_utils  # type: ignore
+        except Exception:
+            return None
+        return arc_utils
+    return None
+
+
+_ARC = _load_arc_utils()
+
+
+if _ARC is not None:
+    bbox = _ARC.bbox
+    crop_bbox = _ARC.crop_bbox
+    find_components = _ARC.find_components
+    get_bg = _ARC.get_bg
+else:
+    def get_bg(grid: np.ndarray) -> int:
+        values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+        return int(values[np.argmax(counts)])
+
+    def bbox(mask: np.ndarray):
+        coords = np.argwhere(mask)
+        if coords.size == 0:
+            return None
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        return int(r0), int(c0), int(r1), int(c1)
+
+    def crop_bbox(grid: np.ndarray, box):
+        r0, c0, r1, c1 = map(int, box)
+        return np.asarray(grid)[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors=None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ):
+        if bg is None:
+            bg = get_bg(grid)
+        if connectivity != 4:
+            raise ValueError("fallback find_components only supports 4-connectivity")
+        if return_format != "dict":
+            raise ValueError("fallback find_components only supports return_format='dict'")
+
+        g = np.asarray(grid, dtype=int)
+        if colors is None:
+            color_list = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+        else:
+            color_list = [int(c) for c in colors if int(c) != int(bg)]
+
+        if not monochromatic:
+            raise ValueError("fallback find_components only supports monochromatic=True")
+
+        h, w = g.shape
+        seen = np.zeros((h, w), dtype=bool)
+        out = []
+        for color in color_list:
+            coords = np.argwhere(g == color)
+            for r, c in coords:
+                r = int(r)
+                c = int(c)
+                if seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                comp = []
+                while stack:
+                    rr, cc = stack.pop()
+                    comp.append((rr, cc))
+                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                        nr = rr + dr
+                        nc = cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                if len(comp) < int(min_area):
+                    continue
+                comp_coords = np.array(comp, dtype=int)
+                r0, c0 = comp_coords.min(axis=0)
+                r1, c1 = comp_coords.max(axis=0)
+                out.append(
+                    {
+                        "color": color,
+                        "coords": comp_coords,
+                        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                        "area": int(len(comp)),
+                    }
+                )
+        return out
+
+
+BG = 0
+SOURCE = 1
+MARKER = 2
+DIVIDER = 5
+ROW_COUNT = 2
+QUADRANTS = ("TL", "TR", "BL", "BR")
+GEN_RETRIES = 400
+
+
+@dataclass(frozen=True)
+class MarkerSpec:
+    slot_row: int
+    slot_col: int
+    rel_r: int
+    rel_c: int
+    quadrant: str
