+            for r, c in coords:
+                r = int(r)
+                c = int(c)
+                if seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                comp = []
+                while stack:
+                    rr, cc = stack.pop()
+                    comp.append((rr, cc))
+                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
