+    stamp_colors = random.sample(STAMP_COLORS, sprite_count)
+    sprites: list[dict] = []
+    current_areas: list[int] = []
+    for marker_color, marker_cells, stamp_color in zip(marker_colors, marker_groups, stamp_colors):
