+def _connected(cells: set[Coord], shape: tuple[int, int]) -> bool:
+    if not cells:
+        return False
+    seen = {next(iter(cells))}
+    queue = deque(seen)
+    while queue:
+        cell = queue.popleft()
+        for nxt in _neighbors8(shape, cell):
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
+    return len(seen) == len(cells)
+
+
+def _bfs_path(
+    shape: tuple[int, int],
+    start: Coord,
+    goals: set[Coord],
+    blocked: set[Coord],
