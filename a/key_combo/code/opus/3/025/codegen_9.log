+def _neighbors8(shape: tuple[int, int], cell: Coord) -> list[Coord]:
+    h, w = shape
+    r, c = cell
+    out: list[Coord] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                out.append((int(rr), int(cc)))
+    return out
