        pattern = tuple(SPRITE_OFFSETS[i] for i in range(len(SPRITE_OFFSETS)) if bits & (1 << i))
        if min_cells <= len(pattern) <= max_cells and _pattern_reaches_all_sides(pattern):
            pool.append(pattern)
    random.shuffle(pool)
    return pool


