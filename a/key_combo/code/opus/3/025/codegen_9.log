+        return None
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    sprite_count = random.choice([2, 3])
+    h = random.choice([5, 6])
+    w = random.choice([7, 8])
+
+    marker_colors = random.sample(MARKER_COLORS, sprite_count)
+    marker_counts = random.sample([1, 2, 3], sprite_count)
