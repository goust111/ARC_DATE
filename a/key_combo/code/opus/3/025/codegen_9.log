    return_format = str(return_format).lower().strip()
    if return_format not in {"dict", "objects"}:
        raise ValueError("find_components: return_format must be 'dict' or 'objects'")

    if colors is None:
        colors_set = None
        colors_iter = sorted(set(map(int, grid.flatten())) - {bg})
    else:
