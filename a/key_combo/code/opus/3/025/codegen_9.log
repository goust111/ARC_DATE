+
+        indices = list(range(len(sprites)))
+        random.shuffle(indices)
+        for idx in indices:
+            patch = patches[idx]
+            sr, sc = random_free_location(grid, patch, transparent=BG, border=1, padding=2, padding_connectivity=8)
+            paste(grid, patch, sr, sc, transparent=BG)
