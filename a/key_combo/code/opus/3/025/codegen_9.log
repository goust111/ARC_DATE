        for w in range(GRID_W_RANGE[0], GRID_W_RANGE[1] + 1):
            if h < rect_h + 2 * COMPONENT_BORDER or w < rect_w + 2 * COMPONENT_BORDER:
                continue
            if h * w <= min_area:
                continue
            valid.append((h, w))
    if not valid:
        return None
    return random.choice(valid)


def _render_target(
    rect_h: int,
