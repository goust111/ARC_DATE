+                "rotation": rot,
+                "color": int(color),
+                "shape_offsets": picked["shape_offsets"],
+                "fragment_offsets": picked["fragment_offsets"],
+                "side": picked["side"],
+                "cross_matches": picked["cross_matches"],
+                "indicator_local": random.choice(picked["indicator_options"]),
+            }
+        )
+    return fragments
+
