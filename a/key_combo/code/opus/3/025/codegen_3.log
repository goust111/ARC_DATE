+        for rr, cc in _translated(full_offsets, origin):
+            base = int(g[rr, cc])
+            assert base in (bg, frag_color, INDICATOR_COLOR), "completed fragment overlaps another object"
+            out[rr, cc] = frag_color
+
+    return out
+
