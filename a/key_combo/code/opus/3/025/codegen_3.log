+        offsets = _normalize(cells)
+        arr = np.array(offsets, dtype=int)
+        _r0, _c0, r1, c1 = bbox_coords(arr)
+        h = int(r1 + 1)
+        w = int(c1 + 1)
+        if h < 3 or w < 3:
+            continue
+        if len(offsets) == h * w:
