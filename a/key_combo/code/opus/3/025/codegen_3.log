+def _normalize(coords) -> tuple[tuple[int, int], ...]:
+    arr = np.array(list(coords), dtype=int)
+    r0, c0, _r1, _c1 = bbox_coords(arr)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in arr))
