+    for r, c in fragment_offsets:
+        input_patch[r - r0, c - c0] = int(fragment["color"])
+    reserve[indicator_local[0] - r0, indicator_local[1] - c0] = 9
+    input_patch[indicator_local[0] - r0, indicator_local[1] - c0] = INDICATOR_COLOR
