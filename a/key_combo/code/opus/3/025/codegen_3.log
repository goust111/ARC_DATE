+    all_cells = list(shape_offsets) + [indicator_local]
+    rs = [r for r, _c in all_cells]
+    cs = [c for _r, c in all_cells]
+    r0, c0, r1, c1 = min(rs), min(cs), max(rs), max(cs)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
