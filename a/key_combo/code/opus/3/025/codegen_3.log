+    shape_cells = set(shape_offsets)
+    clean = sorted(pos for pos in options if pos not in shape_cells)
+    return clean if clean else sorted(options)
+
+
+def _fragment_candidates(
+    template_offsets: tuple[tuple[int, int], ...]
+) -> dict[int, list[dict]]:
