+    assert len(comps) >= 2, "expected one template and at least one fragment"
+    comps.sort(key=lambda comp: int(comp["area"]), reverse=True)
+    assert int(comps[0]["area"]) > int(comps[1]["area"]), "template must be uniquely largest"
+    return comps[0]
