+                coords = np.array(cells, dtype=int)
+                out.append(
+                    {
+                        "color": int(color),
+                        "coords": coords,
+                        "bbox": _fallback_bbox_coords(coords),
+                        "area": int(coords.shape[0]),
+                    }
+                )
+    return out
+
+
+try:
