+
+
+BG = 0
+TARGET = 5
+OBSTACLE_COLORS = (1, 2, 3, 4)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 400
+SCENARIOS = ("two_color", "three_color_left", "three_color_right")
+_GEN_CALLS = 0
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
