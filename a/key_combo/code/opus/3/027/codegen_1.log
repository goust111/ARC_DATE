+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    for comp in _open_regions(g):
+        info = _region_info(g, comp)
+        assert len(info["greens"]) <= 1 and len(info["yellows"]) <= 1
+        if len(info["greens"]) != 1 or len(info["yellows"]) != 1:
+            continue
