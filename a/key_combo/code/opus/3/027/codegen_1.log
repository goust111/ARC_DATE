+        green = info["greens"][0]
+        yellow = info["yellows"][0]
+        dr, dc = _aligned_delta(green, yellow)
+        step = (_sign(dr), _sign(dc))
+        nr = int(green[0] + step[0])
+        nc = int(green[1] + step[1])
+        assert int(g[nr, nc]) == Color.BLACK, "green must advance into background"
