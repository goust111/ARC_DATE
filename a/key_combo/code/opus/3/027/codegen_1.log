+def _bounded_partition(total: int, parts: int, lo: int) -> list[int] | None:
+    if total < parts * lo:
+        return None
+    vals = [lo] * parts
+    extra = total - parts * lo
+    while extra > 0:
+        idx = random.randrange(parts)
+        vals[idx] += 1
+        extra -= 1
+    random.shuffle(vals)
+    return vals
