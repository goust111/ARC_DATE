+
+
+def _cells_in_box(box: Box) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+
+
+def _pair_candidates(box: Box) -> list[dict]:
