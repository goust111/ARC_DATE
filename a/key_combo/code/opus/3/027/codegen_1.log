+from __future__ import annotations
+
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+
+def _ensure_arc_utils() -> None:
+    here = Path(__file__).resolve()
+    for parent in [here.parent, *here.parents]:
+        candidate = parent / "new" / "solvers" / "arc_utils.py"
+        if candidate.exists():
