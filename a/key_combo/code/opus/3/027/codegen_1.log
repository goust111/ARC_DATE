+def _aligned_delta(src: tuple[int, int], dst: tuple[int, int]) -> tuple[int, int]:
+    dr = int(dst[0] - src[0])
+    dc = int(dst[1] - src[1])
+    assert (dr, dc) != (0, 0)
+    assert dr == 0 or dc == 0 or abs(dr) == abs(dc), "marker and target must share a straight ARC line"
+    return dr, dc
+
