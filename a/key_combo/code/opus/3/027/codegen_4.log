+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comp_coords = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": comp_coords,
+                    "bbox": _bbox_coords(comp_coords),
+                    "area": int(comp_coords.shape[0]),
+                }
+            )
