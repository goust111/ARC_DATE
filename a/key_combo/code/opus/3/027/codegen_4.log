+    def backtrack(i: int, used: set[int]) -> bool:
+        if i == len(order):
+            return True
+        group_idx = order[i]
+        feasible = [
+            col
+            for col in range(col_count)
+            if col not in used and row_count * (col_count - col) >= counts[group_idx]
