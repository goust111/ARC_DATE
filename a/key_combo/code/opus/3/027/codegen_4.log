+        unique = len(set(frozen))
+        has_proper_subset = any(subset != full_motif for subset in frozen)
+        if union == full_motif and unique >= 2 and has_proper_subset:
+            return frozen
+
+    raise RuntimeError("failed to sample non-degenerate motif subsets")
+
