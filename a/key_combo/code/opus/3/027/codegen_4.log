+
+    for _ in range(200):
+        subsets = [set() for _ in range(count)]
+        for cell in motif_cells:
+            owners = [i for i in range(count) if random.random() < 0.6]
+            if not owners:
+                owners = [random.randrange(count)]
+            for idx in owners:
+                subsets[idx].add(cell)
+
+        frozen = [frozenset(subset) for subset in subsets]
