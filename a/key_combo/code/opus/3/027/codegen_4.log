+    lead = random.choice((1, 1, 2, 3))
+    tail = random.choice((1, 1, 2, 3))
+    positions = [lead]
+    for gap in gaps:
+        positions.append(positions[-1] + span + gap)
+    size = positions[-1] + span + tail
+    return positions, gaps, lead, size
