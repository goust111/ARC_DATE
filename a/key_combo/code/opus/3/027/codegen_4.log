+    tie_cols = {}
+    for group in groups:
+        tie_cols.setdefault(int(group["count"]), []).append(int(group["first_col"]))
+    for cols in tie_cols.values():
+        assert len(cols) == len(set(cols)), "equal-sized groups need distinct leftmost columns"
