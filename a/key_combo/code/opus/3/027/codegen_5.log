+        assert not np.any(occupied[r0 : r1 + 1, c0 : c1 + 1]), "slid rectangles must not overlap"
+        _paint_rect(out, obj["final_bbox"], int(obj["color"]))
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
