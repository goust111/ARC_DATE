+
+        body = mask[: h - tail_len, :]
+        tail = mask[h - tail_len :, :]
+        if body.shape[0] >= 2 and body.shape[1] >= 2 and _filled_rect(body) and np.all(tail.sum(axis=1) == 1):
+            cols = np.argmax(tail, axis=1)
+            if np.all(cols == cols[0]):
