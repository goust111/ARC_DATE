+    rows: list[list[np.ndarray]] = []
+    idx = 0
+    for size in row_sizes:
+        rows.append(patches[idx : idx + size])
+        idx += size
+
+    for _ in range(40):
+        h_gap = random.randint(2, 4)
+        v_gap = random.randint(2, 4)
+        margins = [random.randint(0, 2) for _ in range(4)]
