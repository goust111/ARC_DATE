+    inp = _build_input_from_plan(plan)
+    out = main(inp)
+    _validate_semantics(plan, inp, out)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
