+
+def _mask_coords(mask: np.ndarray, r0: int, c0: int) -> list[tuple[int, int]]:
+    coords = np.argwhere(mask != 0)
+    return [(int(r0 + r), int(c0 + c)) for r, c in coords]
+
+
+def _clipped_rect_cells(
+    shape: tuple[int, int],
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+    *,
+    pad: int = 0,
