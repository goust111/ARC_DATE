+def _gen_attempt() -> np.ndarray | None:
+    plan = {
+        "shape": (
+            random.randint(*GRID_H_RANGE),
+            random.randint(*GRID_W_RANGE),
+        ),
+        "color": random.randint(1, 9),
+        "template_mask": _random_dihedral(random.choice(TEMPLATE_MASKS)),
+        "template_origin": None,
+        "middles": [],
+        "single_centers": [],
+    }
