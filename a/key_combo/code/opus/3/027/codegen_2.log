+    row_hi = h - mh - 2
+    col_lo = 2
+    col_hi = w - mw - 2
+    if row_lo > row_hi:
+        row_lo, row_hi = 1, h - mh - 1
+    if col_lo > col_hi:
+        col_lo, col_hi = 1, w - mw - 1
+    if row_lo > row_hi or col_lo > col_hi:
+        return False
