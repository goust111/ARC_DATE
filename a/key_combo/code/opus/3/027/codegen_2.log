+]
+
+GRID_H_RANGE = (14, 18)
+GRID_W_RANGE = (14, 18)
+SINGLE_COUNT_RANGE = (2, 4)
+MIDDLE_COUNT_RANGE = (1, 3)
+GEN_ATTEMPTS = 500
