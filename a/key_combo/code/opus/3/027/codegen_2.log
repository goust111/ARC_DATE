+    masks = [_random_dihedral(random.choice(DIAGONAL_MIDDLE_MASKS))]
+    for _ in range(middle_count - 1):
+        masks.append(_random_dihedral(random.choice(DIAGONAL_MIDDLE_MASKS + OTHER_MIDDLE_MASKS)))
