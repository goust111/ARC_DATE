+    np.array([[1, 1]], dtype=int),
+    np.array([[1], [1]], dtype=int),
+    np.array([[1, 1, 1]], dtype=int),
+    np.array([[1], [1], [1]], dtype=int),
+    np.array([[1, 1], [0, 1]], dtype=int),
