+    anchor_c = w // 2
+    for pr in range(h):
+        for pc in range(w):
+            value = int(patch[pr, pc])
+            if value == transparent:
+                continue
+            rr = center_r + pr - anchor_r
+            cc = center_c + pc - anchor_c
