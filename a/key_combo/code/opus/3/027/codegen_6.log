+    markers = [tuple(map(int, rc)) for rc in np.argwhere(g == RED)]
+    for (r1, c1), (r2, c2) in combinations(markers, 2):
+        assert max(abs(r1 - r2), abs(c1 - c2)) >= 2, "markers must be 8-neighborhood separated"
