+def _paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    top: int,
+    left: int,
+    *,
+    transparent: int | None = None,
+    clip: bool = False,
+) -> np.ndarray:
+    h, w = patch.shape
+    H, W = dst.shape
+    if not clip:
+        if top < 0 or left < 0 or top + h > H or left + w > W:
+            raise ValueError("patch is out of bounds")
+        rr0, cc0, rr1, cc1 = top, left, top + h, left + w
+        pr0, pc0 = 0, 0
+    else:
+        rr0 = max(0, top)
+        cc0 = max(0, left)
+        rr1 = min(H, top + h)
+        cc1 = min(W, left + w)
+        if rr0 >= rr1 or cc0 >= cc1:
+            return dst
+        pr0 = rr0 - top
+        pc0 = cc0 - left
+    pr1 = pr0 + (rr1 - rr0)
+    pc1 = pc0 + (cc1 - cc0)
+    view = patch[pr0:pr1, pc0:pc1]
+    if transparent is None:
+        dst[rr0:rr1, cc0:cc1] = view
+    else:
+        mask = view != int(transparent)
+        dst_view = dst[rr0:rr1, cc0:cc1]
+        dst_view[mask] = view[mask]
+    return dst
+
