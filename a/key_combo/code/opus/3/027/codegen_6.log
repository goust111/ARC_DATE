+    return {
+        "grid": g,
+        "sprite": sprite,
+        "sprite_box": sprite_box,
+        "sprite_coords": [tuple(map(int, rc)) for rc in sprite_coords],
+        "markers": markers,
+    }
+
+
+def _transform(grid: np.ndarray, quarter_turns: int | None = None) -> np.ndarray:
+    parsed = _parse_input(grid)
