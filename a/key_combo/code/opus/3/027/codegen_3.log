+def _paint_ring(grid: np.ndarray, inset: int, color: int) -> None:
+    r0 = int(inset)
+    c0 = int(inset)
+    r1 = int(grid.shape[0] - 1 - inset)
+    c1 = int(grid.shape[1] - 1 - inset)
