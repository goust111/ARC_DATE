+def _next_scenario() -> str:
+    global _GENERATION_CALLS
+    scenario = SCENARIO_CYCLE[_GENERATION_CALLS % len(SCENARIO_CYCLE)]
+    _GENERATION_CALLS += 1
+    return scenario
+
