+def _fallback_find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    connectivity: int = 4,
+    monochromatic: bool = True,
+    colors: list[int] | None = None,
+    min_area: int = 1,
+    return_format: str = "dict",
+):
