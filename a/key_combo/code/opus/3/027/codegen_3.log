+def _render_rings(size: int, ordered_segments: list[dict]) -> np.ndarray:
+    out = np.zeros((int(size), int(size)), dtype=int)
+    max_layers = (int(size) + 1) // 2
+    for inset, segment in enumerate(ordered_segments[:max_layers]):
