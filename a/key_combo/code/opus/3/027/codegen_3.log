+    h, w = grid.shape
+    if colors is None:
+        colors_iter = sorted(set(map(int, grid.ravel())) - {int(bg)})
+    else:
+        colors_iter = [int(color) for color in colors if int(color) != int(bg)]
+
+    out = []
+    for color in colors_iter:
+        mask = grid == color
+        seen = np.zeros((h, w), dtype=bool)
+        for r in range(h):
+            for c in range(w):
+                if not mask[r, c] or seen[r, c]:
