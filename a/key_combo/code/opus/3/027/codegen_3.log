+        remaining_evens = [value for value in (2, 4, 6) if value != mandatory_even]
+        extra_count = random.randint(0, len(remaining_evens))
+        lengths = [7, 5, 3, mandatory_even, *random.sample(remaining_evens, k=extra_count)]
