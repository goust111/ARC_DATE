    cols = random.randint(max(GRID_SIDE_MIN, w + GRID_EXTRA_MIN), min(GRID_SIDE_MAX, w + GRID_EXTRA_MAX))
    grid = np.full((rows, cols), BG_COLOR, dtype=int)
