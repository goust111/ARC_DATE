+        center_r = (r0 + r1) / 2.0
+        center_c = (c0 + c1) / 2.0
+        rel_rows.append(center_r < sr0 or center_r > sr1)
+        rel_cols.append(center_c < sc0 or center_c > sc1)
+    if not any(rel_rows) or not any(rel_cols):
+        return False
