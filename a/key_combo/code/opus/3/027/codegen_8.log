+    expected = _expected_from_parts(sprite, segments)
+    if expected.shape != (h + 2 * w, h + 2 * w):
+        return False
+
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
