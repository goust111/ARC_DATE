/bin/bash -lc "python - <<'PY'
import random
from collections import Counter
import numpy as np


def active_width(grid):
    cols = np.where(np.any(grid "'!= 0, axis=0))[0]
    assert cols.size > 0
    return int(cols[-1]) + 1


def minimal_period(observed):
    h, w = observed.shape
    for p in range(1, w + 1):
        ok = True
        for c in range(w):
            if not np.array_equal(observed[:, c], observed[:, c % p]):
                ok = False
                break
        if ok:
            return p
    raise AssertionError


def tile_right(observed, full_width, period):
    tile = observed[:, :period]
    reps = (full_width + period - 1) // period
    return np.tile(tile, (1, reps))[:, :full_width]


def least_color(full):
    counts = Counter(map(int, full[full != 0].ravel()))
    assert counts
    m = min(counts.values())
    winners = [c for c, v in counts.items() if v == m]
    assert len(winners) == 1
    return winners[0]


def first_col(grid, color):
    cols = np.where(np.any(grid == color, axis=0))[0]
    assert cols.size > 0
    return int(cols[0])


def main(grid):
    g = np.asarray(grid, dtype=int)
    aw = active_width(g)
    observed = g[:, :aw]
    p = minimal_period(observed)
    full = tile_right(observed, g.shape[1], p)
    phc = least_color(full)
    parity = first_col(full, phc) % 2
    out = full.copy()
    for c in range(g.shape[1]):
        if c % 2 != parity:
            out[:, c] = 0
    return out


def nonzero_counts(grid):
    return Counter(map(int, grid[grid != 0].ravel()))


def build_tile(h, p, palette, phase_color, phase_col):
    others = [c for c in palette if c != phase_color]
    for _ in range(400):
        tile = np.zeros((h, p), dtype=int)
        phase_rows = random.sample(range(h), random.randint(1, min(2, h)))
        for r in phase_rows:
            tile[r, phase_col] = phase_color
        later = [(r, c) for c in range(phase_col, p) for r in range(h) if tile[r, c] == 0]
        random.shuffle(later)
        for r, c in later[: random.randint(0, min(1, len(later)) )]:
            tile[r, c] = phase_color
        for color in others:
            need = random.randint(max(2, len(phase_rows) + 1), max(3, h))
            cells = [(r, c) for r in range(h) for c in range(p) if tile[r, c] == 0]
            if len(cells) < need:
                break
            for r, c in random.sample(cells, need):
                tile[r, c] = color
        else:
            for r in range(h):
                for c in range(p):
                    if tile[r, c] != 0:
                        continue
                    roll = random.random()
                    if roll < 0.45:
                        tile[r, c] = random.choice(others)
                    elif roll < 0.55 and c >= phase_col:
                        tile[r, c] = phase_color
            counts = nonzero_counts(tile)
            if set(counts) != set(palette):
                continue
            if counts[phase_color] != min(counts.values()) or list(counts.values()).count(counts[phase_color]) != 1:
                continue
            if any(counts[color] <= counts[phase_color] for color in others):
                continue
            if first_col(tile, phase_color) != phase_col:
                continue
            if minimal_period(tile) != p:
                continue
            fg = int(np.count_nonzero(tile))
            if not (h * p * 0.25 <= fg <= h * p * 0.75):
                continue
            if not np.any(tile[:, ::2] != 0):
                continue
            if not np.any(tile[:, 1::2] != 0):
                continue
            return tile
    return None


def gen():
    for _ in range(2000):
        h = random.randint(5, 8)
        w = random.randint(10, 18)
        p = random.randint(2, min(4, w - 2))
