+    if not np.any(full[:, visible_width:] != 0):
+        return False
+    if not np.any(expected[:, visible_width:] != 0):
+        return False
+    if not np.any(full[:, :visible_width][:, (np.arange(visible_width) % 2) != phase_parity] != 0):
+        return False
+    if not np.any(full[:, :visible_width][:, (np.arange(visible_width) % 2) == phase_parity] != 0):
