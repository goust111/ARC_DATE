def _occupied_set(placements: list[tuple]) -> set[tuple[int, int]]:
    """Collect all cells covered by already-placed sprites."""
    cells: set[tuple[int, int]] = set()
    for r0, c0, sub, *_ in placements:
        h, w = sub.shape
        for r in range(h):
            for c in range(w):
                cells.add((r0 + r, c0 + c))
    return cells


