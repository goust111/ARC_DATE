+            {"kind": "horizontal", "cells": seg_a},
+            {"kind": "vertical", "cells": seg_b},
+            {"kind": "point", "cells": {point_hit}},
+        ]
+        occupied_markers: set[tuple[int, int]] = set()
+        occupied_halo: set[tuple[int, int]] = set()
+        ok = True
+        for marker in marker_specs:
