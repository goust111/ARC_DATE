        reasons['seed_vs_seed'] += 1; continue
    colors = rng.sample(mod.RAY_COLORS, 3)
    grid = mod.build_input_grid(shape, marker_specs, [seed_a, seed_b], colors[:2])
    try:
        _, traces = mod.render_output(grid)
    except AssertionError:
        reasons['render_assert'] += 1; continue
    if {trace['reflections'][0] for trace in traces} "'!= {'"'horizontal','vertical'}:
        reasons['wrong_first'] += 1; continue
    if 'point' not in traces[0]['reflections'] or 'point' not in traces[1]['reflections']:
        reasons['no_point'] += 1; continue
    if not (traces[0]['post_first'] & traces[1]['post_first']):
        reasons['no_overlap'] += 1; continue
    reasons['success'] += 1
print(direction, reasons)
