+    pos = seed["start"]
+    direction = seed["dir"]
+    path = [pos]
+    path_set = {pos}
+    post_first: set[tuple[int, int]] = set()
+    reflections: list[str] = []
+    seen_states: set[tuple[int, int, int, int]] = set()
