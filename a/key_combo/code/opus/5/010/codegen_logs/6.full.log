+    assert 3 <= len(markers) <= 5, "grid must contain 3 to 5 red markers"
+    return markers, seed_components, seed_cells
+
+
+def reflect(direction: tuple[int, int], kind: str) -> tuple[int, int]:
+    dr, dc = direction
+    if kind == "horizontal":
+        return -dr, dc
+    if kind == "vertical":
+        return dr, -dc
+    if kind == "point":
+        return -dr, -dc
+    raise AssertionError("unknown marker type")
+
+
+def trace_ray(
