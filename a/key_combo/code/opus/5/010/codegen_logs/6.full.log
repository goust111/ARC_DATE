+        "path": path,
+        "path_set": path_set,
+        "post_first": post_first,
+        "reflections": reflections,
+    }
+
+
+def render_output(grid: np.ndarray, kind_override: str | None = None) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    markers, seeds, seed_cells = extract_scene(g)
