+    w = c1 - c0 + 1
+    if h == 1 and w == 1:
+        return "point"
+    if h == 1 and w in (3, 4) and len(coords) == w:
+        return "horizontal"
+    if w == 1 and h in (3, 4) and len(coords) == h:
+        return "vertical"
