+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+RAY_COLORS = [3, 4, 5, 6, 7, 8, 9]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+MAX_GEN_ATTEMPTS = 500
