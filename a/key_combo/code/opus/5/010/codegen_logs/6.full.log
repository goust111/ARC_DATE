+                    if not all(in_bounds(shape, rr, cc) for rr, cc in cells):
+                        continue
+                    tail = (r - (length - 1) * direction[0], c - (length - 1) * direction[1])
+                    pred = (tail[0] - direction[0], tail[1] - direction[1])
+                    if in_bounds(shape, pred[0], pred[1]):
