+        "cells": {tuple(map(int, rc)) for rc in coords},
+        "start": start,
+        "dir": direction,
+    }
+
+
+def extract_scene(grid: np.ndarray) -> tuple[list[dict], list[dict], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
