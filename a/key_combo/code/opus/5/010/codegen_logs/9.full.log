+def _build_base_cells(row_sizes: list[int], col_sizes: list[int], solid_mask: np.ndarray, orientation: str, bands: list[int], line_offsets: dict[int, int]) -> tuple[dict[tuple[int, int], np.ndarray], dict[tuple[int, int], int]]:
