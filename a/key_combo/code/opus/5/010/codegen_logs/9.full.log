+    sep_rows = [row_sizes[0], row_sizes[0] + 1 + row_sizes[1]]
+    sep_cols = [col_sizes[0], col_sizes[0] + 1 + col_sizes[1]]
+    row_bands = _bands(grid.shape[0], sep_rows)
+    col_bands = _bands(grid.shape[1], sep_cols)
