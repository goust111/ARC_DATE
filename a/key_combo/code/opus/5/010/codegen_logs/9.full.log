+
+def _segments_1d(indices: Iterable[int]) -> list[tuple[int, int]]:
+    pts = [int(x) for x in indices]
+    if not pts:
+        return []
+    segs: list[tuple[int, int]] = []
+    start = prev = pts[0]
+    for x in pts[1:]:
+        if x == prev + 1:
+            prev = x
+        else:
+            segs.append((start, prev))
+            start = prev = x
+    segs.append((start, prev))
+    return segs
