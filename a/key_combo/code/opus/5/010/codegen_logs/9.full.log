+def _sample_solid_layout() -> np.ndarray:
+    while True:
+        n_solid = random.randint(4, 6)
+        flat = np.array([True] * n_solid + [False] * (9 - n_solid), dtype=bool)
+        np.random.shuffle(flat)
+        solid_mask = flat.reshape(3, 3)
