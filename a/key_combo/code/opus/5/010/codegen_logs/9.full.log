+        spans.append(max(r1 - r0 + 1, c1 - c0 + 1))
+    work[orange_mask] = base_color
+    if spans:
+        cap = max(spans)
+        for r in range(work.shape[0]):
+            cols = np.where(work[r, :] == YELLOW)[0]
+            for (a0, a1), (b0, b1) in zip(_segments_1d(cols), _segments_1d(cols)[1:]):
