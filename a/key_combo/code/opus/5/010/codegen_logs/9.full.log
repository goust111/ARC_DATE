+def _complete_solid_cell(cell: np.ndarray, base_color: int) -> np.ndarray:
+    work = cell.copy()
+    orange_mask = work == ORANGE
+    spans: list[int] = []
+    for comp in _components_mask(orange_mask, connectivity=8):
