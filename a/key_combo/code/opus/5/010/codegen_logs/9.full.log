+            cell_w = c1 - c0 + 1
+            gap_len = random.randint(2, cell_w - 2)
+            start = random.randint(1, cell_w - gap_len - 1)
+            grid[rr, c0 + start : c0 + start + gap_len] = base = grid[rr, c0 + start : c0 + start + gap_len]
+            grid[rr, c0 + start : c0 + start + gap_len] = BG if BG != YELLOW else 0
+            chain = _noise_chain_h(row_sizes[ri], line_offsets[ri], start, gap_len)
+            assert chain is not None
+            for dr, dc in chain:
+                grid[r0 + dr, c0 + dc] = ORANGE
