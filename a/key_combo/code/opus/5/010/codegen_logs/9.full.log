+def _mixed_band_indices(mask: np.ndarray, axis: int) -> list[int]:
+    mixed: list[int] = []
+    for idx in range(3):
+        vals = mask[idx, :] if axis == 0 else mask[:, idx]
+        if vals.any() and (~vals).any():
+            mixed.append(idx)
