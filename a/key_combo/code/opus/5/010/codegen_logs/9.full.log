+def _pattern_restorable(pattern: np.ndarray, axis: str, line_pos: int) -> bool:
+    masked = pattern.copy()
+    if axis == "h":
+        masked[line_pos, :] = YELLOW
+    else:
+        masked[:, line_pos] = YELLOW
+    restored = _restore_pattern_cell(masked)
+    return np.array_equal(restored, pattern)
