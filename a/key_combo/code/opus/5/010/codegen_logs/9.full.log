+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+SOLID_COLORS = [1, 2, 3, 6, 8, 9]
+PATTERN_COLORS = [1, 2, 3, 6, 8, 9]
