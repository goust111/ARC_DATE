+    for ri, (r0, r1) in enumerate(row_bands):
+        for ci, (c0, c1) in enumerate(col_bands):
+            cell_in = inp[r0 : r1 + 1, c0 : c1 + 1]
+            cell_out = expected[r0 : r1 + 1, c0 : c1 + 1]
+            if solid_mask[ri, ci]:
+                if not np.all(cell_out == cell_out[0, 0]):
+                    return False
+                if ORANGE in cell_in:
