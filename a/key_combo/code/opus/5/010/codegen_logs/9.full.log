+def _solid_cell_color(cell: np.ndarray) -> int | None:
+    mask = ~np.isin(cell, [GREY, YELLOW, ORANGE])
+    vals = sorted(set(int(v) for v in cell[mask].flatten()))
+    if len(vals) == 1:
