+                gap1 = b0 - 1
+                if gap1 >= gap0 and gap1 - gap0 + 1 <= cap:
+                    work[r, gap0 : gap1 + 1] = YELLOW
+        for c in range(work.shape[1]):
+            rows = np.where(work[:, c] == YELLOW)[0]
+            for (a0, a1), (b0, b1) in zip(_segments_1d(rows), _segments_1d(rows)[1:]):
+                gap0 = a1 + 1
+                gap1 = b0 - 1
+                if gap1 >= gap0 and gap1 - gap0 + 1 <= cap:
