+def _is_full_width_bar(comp: dict, h: int, w: int) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    return (
+        int(comp["area"]) == int(w)
+        and r0 == r1
+        and c0 == 0
+        and c1 == w - 1
+        and r0 in {0, h - 1}
+    )
