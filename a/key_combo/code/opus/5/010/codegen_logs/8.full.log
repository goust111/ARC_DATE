+        back_r0 = back_r1 - back_patch.shape[0] + 1
+        if back_r0 < 1:
+            return None
+        frames = [
+            {"patch": back_patch, "r0": back_r0, "c0": col0, "holes": back_h, "color": color},
+            {"patch": front_patch, "r0": front_r0, "c0": col0, "holes": front_h, "color": color},
+        ]
+    return frames
+
