+                "color": color,
+                "bbox": bbox,
+                "patch": patch,
+                "rel_coords": rel.astype(int),
+                "values": vals,
+                "holes": _hole_count_from_patch(patch),
+                "distance": int(dist),
+                "pos": (r0, c0),
+            }
+        )
+    return frames
