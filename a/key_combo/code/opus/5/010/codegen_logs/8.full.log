+def _sample_patch(hole_count: int, color: int) -> np.ndarray:
+    patch = _colorize(random.choice(_TEMPLATE_LIBRARY[int(hole_count)]), color)
+    assert _hole_count_from_patch(patch) == int(hole_count)
