+                {"color": GREEN, "front_h": 1, "back_h": 2, "blocked": False},
+            ]
+        },
+        {
+            "pairs": [
+                {"color": RED, "front_h": 1, "back_h": 3, "blocked": True},
+                {"color": GREEN, "front_h": 0, "back_h": 2, "blocked": False},
