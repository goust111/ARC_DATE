+def _validate_generated(inp: np.ndarray) -> bool:
+    frames = _extract_frames(inp)
+    if len(frames) != 4:
+        return False
+    holes = sorted(int(f["holes"]) for f in frames)
+    if holes != [0, 1, 2, 3]:
+        return False
+    bboxes = [tuple(map(int, f["bbox"])) for f in frames]
+    for i, a in enumerate(bboxes):
