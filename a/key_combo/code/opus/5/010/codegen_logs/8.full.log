+    if not any(0 < int(t["moved"]) < int(t["holes"]) for t in trace):
+        return False
+
+    frame_by_start = {tuple(map(int, t["start_bbox"])): t for t in trace}
+    blocked_colors = set()
+    for f in frames:
+        tr = frame_by_start[tuple(map(int, f["bbox"]))]
+        if 0 < int(tr["moved"]) < int(tr["holes"]):
