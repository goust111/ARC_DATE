+    state = g.copy()
+    trace: list[dict] = []
+    for idx in order:
+        frame = frames[idx]
+        cur_r0, cur_c0 = frame["pos"]
+        rel = frame["rel_coords"]
+        vals = frame["values"]
+        abs_coords = rel + np.array([cur_r0, cur_c0], dtype=int)
+        state[abs_coords[:, 0], abs_coords[:, 1]] = BG
