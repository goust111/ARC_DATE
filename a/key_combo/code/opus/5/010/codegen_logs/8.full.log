+            return False
+        for b in bboxes[i + 1 :]:
+            if _bboxes_overlap(
+                (a[0] - 1, a[1] - 1, a[2] + 1, a[3] + 1),
+                (b[0] - 1, b[1] - 1, b[2] + 1, b[3] + 1),
