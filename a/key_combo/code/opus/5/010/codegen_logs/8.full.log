+def _hole_count_from_patch(patch: np.ndarray) -> int:
+    if patch.shape[0] < 3 or patch.shape[1] < 3:
+        return 0
+    inner = patch[1:-1, 1:-1]
+    return len(components_mask(inner == BG, connectivity=4))
