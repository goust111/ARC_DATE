+def _render_input(height: int, width: int, frames: list[dict]) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    grid[0, :] = RED
+    grid[-1, :] = GREEN
+    for item in frames:
+        paste(grid, item["patch"], int(item["r0"]), int(item["c0"]), transparent=BG)
+    return grid
+
