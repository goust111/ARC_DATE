+    hh = r1 - r0 + 1
+    ww = c1 - c0 + 1
+    if hh < 3 or ww < 3:
+        return False
+    if int(comp["area"]) != 2 * hh + 2 * ww - 4:
+        return False
+    mask = np.zeros((hh, ww), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    if not np.all(mask[0, :]) or not np.all(mask[-1, :]):
+        return False
+    if not np.all(mask[:, 0]) or not np.all(mask[:, -1]):
+        return False
+    return not bool(mask[1:-1, 1:-1].any())
