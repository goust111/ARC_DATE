+
+        seen_turns_by_color: dict[int, set[int]] = {color: set() for color in colors}
+        for r in range(3):
+            for c in range(3):
+                seen_turns_by_color[int(index_grid[r, c])].add(int(row_turns[r]))
+        if not any(len(turns) >= 2 for turns in seen_turns_by_color.values()):
