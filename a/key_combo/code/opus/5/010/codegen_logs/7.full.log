+def _make_index_grid(rng: random.Random, colors: list[int], row_turns: list[int]) -> np.ndarray:
+    while True:
+        cells = [rng.choice(colors) for _ in range(9)]
+        for color, pos in zip(colors, rng.sample(range(9), len(colors)), strict=True):
+            cells[pos] = color
