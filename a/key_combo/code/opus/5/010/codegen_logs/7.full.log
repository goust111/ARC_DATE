+    markers.sort(key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))
+
+    row_turns: list[int] = []
+    for comp in markers:
+        r0, c0, r1, c1 = comp["bbox"]
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert comp["area"] == 2, "each marker must be a two-pixel domino"
