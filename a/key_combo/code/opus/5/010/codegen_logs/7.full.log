+def _occupied_row_bands(grid: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    rows = [r for r in range(grid.shape[0]) if np.any(grid[r] != bg)]
+    if not rows:
+        return []
+    bands: list[tuple[int, int]] = []
+    start = rows[0]
+    prev = rows[0]
+    for r in rows[1:]:
+        if r == prev + 1:
+            prev = r
+            continue
+        bands.append((start, prev))
+        start = prev = r
+    bands.append((start, prev))
+    return bands
