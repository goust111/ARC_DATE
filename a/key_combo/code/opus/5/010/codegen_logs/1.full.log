+        visible = int(grid[r, c])
+        assert visible in rects, "overlap pixel must display a foreground color"
+        for lower in colors:
+            lower = int(lower)
+            if lower == visible or visible in edges[lower]:
+                continue
+            edges[lower].add(visible)
+            indeg[visible] += 1
