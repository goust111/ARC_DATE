+def _choose_start_rect(h: int, w: int) -> Rect:
+    rh = random.randint(5, min(MAX_SIDE, h - 6))
+    rw = random.randint(5, min(MAX_SIDE, w - 6))
+    r0 = random.randint(1, max(1, h // 4))
+    c0 = random.randint(1, max(1, w // 4))
+    return r0, c0, r0 + rh - 1, c0 + rw - 1
