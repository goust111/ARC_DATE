+def _infer_occlusion_order(rects: dict[int, Rect], grid: np.ndarray) -> list[int]:
+    cover_map: dict[tuple[int, int], list[int]] = defaultdict(list)
+    for color, rect in rects.items():
+        for rc in _rect_perimeter(rect):
