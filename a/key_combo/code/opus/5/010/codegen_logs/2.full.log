+            max_top = min(h - h2 - 5, h - h1 - 5)
+            min_top = 1
+            if min_top > max_top:
+                return None
+            final_top = random.randint(min_top, max_top)
+            d1 = random.randint(2, min(4, h - (final_top + h1) - 2))
+            d2_low = d1 + h1 + 1
+            d2_high = min(d2_low + 3, h - (final_top + h2) - 1)
+            if d2_low > d2_high:
