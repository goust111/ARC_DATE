+    count = 0
+
+    def search(i: int, used: set[int]) -> None:
+        nonlocal count
+        if count > 1:
+            return
+        if i == len(ordered):
+            count += 1
+            return
+        sprite_idx = ordered[i]
+        for pivot_idx, _axis in candidates[sprite_idx]:
+            if pivot_idx in used:
+                continue
+            used.add(pivot_idx)
+            search(i + 1, used)
+            used.remove(pivot_idx)
+
+    search(0, set())
+    return count
