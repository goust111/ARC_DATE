+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ARC_ROOT = Path("/home/lixinyu/snap/new")
+if str(ARC_ROOT) not in sys.path:
+    sys.path.append(str(ARC_ROOT))
+
+from solvers.arc_utils import find_components, get_bg
+
+
+BG = 0
+PIVOT = 1
+SPRITE_COLORS = [2, 3, 4, 6, 7, 8, 9]
