+    pair1 = {"cells": cells1, "pivot": p1, "color": colors[0]}
+    pair2 = {"cells": cells2, "pivot": p2, "color": colors[1]}
+    if not _can_place(pair2["cells"], pair2["pivot"], [pair1], h, w):
+        return None
+    return [pair1, pair2]
