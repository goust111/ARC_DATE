+
+def _shift_coords(coords: np.ndarray, axis: str, delta: int) -> np.ndarray:
+    if axis == "h":
+        return coords + np.array([0, int(delta)], dtype=int)
+    return coords + np.array([int(delta), 0], dtype=int)
