+        m1 = _random_connected_mask(h1, 2, area1, require_cols={0, 1})
+        m2 = _random_connected_mask(h2, 2, area2, require_cols={0, 1})
+        if m1 is None or m2 is None or not bool(m1[:, 0].any()) or not bool(m2[:, 1].any()):
+            return None
