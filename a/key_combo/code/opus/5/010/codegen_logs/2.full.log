+def _target_shift(pair: dict) -> int:
+    pr, pc = pair["pivot"]
+    r0, c0, r1, c1 = pair["bbox"]
+    if pair["axis"] == "h":
+        if pc < c0:
+            return int(pc + 1 - c0)
+        return int(pc - 1 - c1)
+    if pr < r0:
+        return int(pr + 1 - r0)
+    return int(pr - 1 - r1)
