+
+def _can_place(cells: set[tuple[int, int]], pivot: tuple[int, int], placed: list[dict], h: int, w: int) -> bool:
+    bundle = set(cells) | {pivot}
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in bundle):
