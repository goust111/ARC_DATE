+    bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+    out = dict(spec)
+    out["coords"] = coords_arr
+    out["bbox"] = bbox
+    return out
+
+
+def _can_place(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    H, W = grid.shape
+    for dr in range(h):
+        for dc in range(w):
+            if not bool(mask[dr, dc]):
+                continue
+            rr = r0 + dr
+            cc = c0 + dc
+            if rr < 0 or rr >= H or cc < 0 or cc >= W:
+                return False
