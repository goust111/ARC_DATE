+def _infer_period(indices: list[int]) -> int:
+    diffs = [b - a for a, b in zip(indices, indices[1:])]
+    assert diffs and all(d > 0 for d in diffs)
+    period = diffs[0]
+    assert period > 1 and all(d == period for d in diffs)
