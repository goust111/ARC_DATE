+    filtered = out.copy()
+    filtered[0, :] = BG
+    filtered[filtered == GRAY] = BG
+    filtered[filtered == ORANGE] = BG
+    survivors = find_components(
+        filtered,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
