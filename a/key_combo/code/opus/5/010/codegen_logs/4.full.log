+def _draw_frame(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    grid[r0, c0 : c1 + 1] = GRAY
+    grid[r1, c0 : c1 + 1] = GRAY
+    grid[r0 : r1 + 1, c0] = GRAY
+    grid[r0 : r1 + 1, c1] = GRAY
