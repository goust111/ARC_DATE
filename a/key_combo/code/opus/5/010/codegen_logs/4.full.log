+            for c in range(w):
+                if out[row, c] == BG:
+                    out[row, c] = color
+        else:
+            col = c0 + (width - 1) // 2
+            if active_cols is not None and col not in active_cols:
+                continue
+            for r in range(h):
+                if out[r, col] == BG:
+                    out[r, col] = color
+
