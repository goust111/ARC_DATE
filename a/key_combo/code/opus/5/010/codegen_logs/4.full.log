+    if not candidates:
+        return None
+
+    r0, c0 = random.choice(candidates)
+    color = int(spec["color"])
+    coords = []
+    for dr in range(h):
+        for dc in range(w):
+            if not bool(mask[dr, dc]):
+                continue
+            rr = r0 + dr
+            cc = c0 + dc
+            grid[rr, cc] = color
+            coords.append((rr, cc))
