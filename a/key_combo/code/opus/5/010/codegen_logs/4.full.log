+
+def _choose_period_and_phase(length: int) -> tuple[int, int]:
+    options = []
+    for period in (2, 3):
+        for phase in range(period):
+            idx = [i for i in range(length) if i % period == phase]
+            if 2 <= len(idx) < length:
+                options.append((period, phase))
+    return random.choice(options)
