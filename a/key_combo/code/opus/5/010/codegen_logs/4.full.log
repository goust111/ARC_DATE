+    for comp in survivors:
+        color = int(comp["color"])
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        assert height != width, "emitter bbox must be non-square"
