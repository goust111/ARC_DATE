+    else:
+        options = [(3, 1), (4, 1), (3, 2), (4, 2)]
+    h, w = random.choice(options)
+    mask = np.ones((h, w), dtype=bool)
+    if h > 1 and w > 1 and random.random() < 0.7:
+        rr = random.choice([0, h - 1])
+        cc = random.choice([0, w - 1])
+        mask[rr, cc] = False
