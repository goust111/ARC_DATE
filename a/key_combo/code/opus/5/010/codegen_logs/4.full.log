+
+def _drawable_cells(scene: np.ndarray, obj: dict) -> set[tuple[int, int]]:
+    if not obj["visible"]:
+        return set()
+    h, w = scene.shape
+    r0, c0, r1, c1 = map(int, obj["bbox"])
+    cells: set[tuple[int, int]] = set()
+    if obj["orientation"] == "H":
+        row = r0 + (r1 - r0) // 2
+        for c in range(w):
+            if int(scene[row, c]) == BG:
+                cells.add((row, c))
+    else:
