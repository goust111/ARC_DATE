+    out = g.copy()
+    for anchor in anchors:
+        patch = _transformed_patch(motif_patch, anchor["direction"], anchor["color"], anchor["size"])
+        r0, c0 = _stamp_origin(anchor["bbox"], anchor["direction"], anchor["size"])
