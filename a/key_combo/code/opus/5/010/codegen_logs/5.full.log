+
+    return {
+        "h": int(h),
+        "w": int(w),
+        "motif": motif,
+        "motif_bbox": motif_bbox,
+        "anchors": anchors,
+    }
+
+
+def _semantic_validate(spec: dict) -> bool:
+    inp = _render_input(spec)
+    out = _expected_output(spec)
+
+    if not np.array_equal(main(inp), out):
+        return False
