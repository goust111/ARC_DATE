+    sizes = _sample_sizes(directions)
+    if sizes is None:
+        return None
+
+    req_top = 7 * sizes.get("up", 0)
+    req_bottom = 7 * sizes.get("down", 0)
+    req_left = 7 * sizes.get("left", 0)
+    req_right = 7 * sizes.get("right", 0)
