+
+def _stamp_origin(anchor_bbox: tuple[int, int, int, int], direction: str, scale: int) -> tuple[int, int]:
+    ar0, ac0, ar1, ac1 = anchor_bbox
+    k = int(scale)
+    if direction == "right":
+        return ar0 - k, ac1 + 1
+    if direction == "left":
+        return ar0 - k, ac0 - 3 * k
+    if direction == "down":
