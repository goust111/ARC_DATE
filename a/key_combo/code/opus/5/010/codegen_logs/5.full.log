+    min_w = max(23, req_left + 3 + req_right)
+    if min_h > 30 or min_w > 30:
+        return None
+
+    h = random.randint(min_h, 30)
+    w = random.randint(min_w, 30)
+    motif_r0 = random.randint(req_top, h - 3 - req_bottom)
+    motif_c0 = random.randint(req_left, w - 3 - req_right)
