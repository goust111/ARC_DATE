+    grid_w = rng.randint(min_w, 30)
+    grid = np.full((grid_h, grid_w), BG, dtype=int)
+
+    frame_r = rng.randint(1, grid_h - frame_h - 1)
+    frame_c = rng.randint(1, grid_w - frame_w - 1)
