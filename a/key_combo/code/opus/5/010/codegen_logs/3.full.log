+    occ[frame_r : frame_r + frame_h, frame_c : frame_c + frame_w] = 11
+
+    sprite_colors = rng.sample(SPRITE_COLORS, len(shapes))
+    items = list(zip(shapes, sprite_colors, strict=False))
+    rng.shuffle(items)
+    for shape, color in items:
