+    if len(ordered) == 1:
+        return ordered[0], 1
+    gaps = [(ordered[(i + 1) % len(ordered)] - ordered[i]) % int(period) for i in range(len(ordered))]
+    wide = [i for i, gap in enumerate(gaps) if gap != 1]
