+def _choose_row_gaps(target_row: int, target_gap: int) -> list[int]:
+    while True:
+        row_gaps = [random.choice((1, 2)) for _ in range(3)]
+        row_gaps[target_row] = int(target_gap)
+        if len(set(row_gaps)) == 2:
