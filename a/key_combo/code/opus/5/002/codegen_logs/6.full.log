+def _distinct_row_permutations() -> list[tuple[int, int, int, int]]:
+    perms = list({tuple(p) for p in random.sample(list(__import__("itertools").permutations(GLYPH_COLORS)), 3)})
+    while len(perms) < 3:
+        candidate = tuple(random.sample(GLYPH_COLORS, 4))
+        if candidate not in perms:
+            perms.append(candidate)
+    random.shuffle(perms)
+    return perms
