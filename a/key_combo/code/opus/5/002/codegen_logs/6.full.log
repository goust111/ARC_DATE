+        pool = [i for i, cols in enumerate(PATTERN_COLSETS) if common_col in cols]
+        chosen = random.sample(pool, 4)
+    else:
+        while True:
+            chosen = random.sample(indices, 4)
+            common = set.intersection(*(set(PATTERN_COLSETS[i]) for i in chosen))
