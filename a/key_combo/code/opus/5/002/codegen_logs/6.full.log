+def _draw_table(width: int, left_margin: int, row_perms: list[tuple[int, int, int, int]], row_gaps: list[int]) -> np.ndarray:
+    top = np.full((9, width), Color.TEAL, dtype=int)
+    table_left = int(left_margin)
