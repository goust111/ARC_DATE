+def _pick_hub_and_sizes(mode: str):
+    for _ in range(400):
+        h = random.choice([19, 21, 23, 25, 27])
+        w = random.choice([19, 21, 23, 25, 27])
+        base_r = h // 2
+        base_c = w // 2
