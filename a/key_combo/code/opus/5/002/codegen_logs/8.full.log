+BACKGROUND = 0
+HUB_COLOR = 5
+SEED_COLORS = (1, 2, 3, 4)
+SECTORS = ("up", "right", "down", "left")
+
+# Minimal helpers adapted from arc_utils.py so this file stays SourceFileLoader-safe.
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
