rs = ('hit your usage limit', 'try again at', 'usage limit')  def append_manifest(rec: dict) -> None:     with lock:         with MANIFEST.open('a', encoding='utf-8') as f:             f.write(json.dumps(rec, ensure_ascii=False) + '\n')  def run_one(task: str, prompt: Path, target: Path) -> None:     start = time.time()     log_dir = prompt.parents[1] / 'codegen_logs'     log_dir.mkdir(exist_ok=True)     log_path = log_dir / f'{prompt.stem}.full.log'     cmd = [         'codex', 'exec', '--skip-git-repo-check',         '-s', 'danger-full-access',         '--add-dir', '/home/lixinyu/snap',         '-m', MODEL,         '-c', 'reasoning.effort="high"',         '-',     ]     rc = None     err = None     try:         text = PREFIX + prompt.read_text(encoding='utf-8')         with log_path.open('w', encoding='utf-8') as log:             log.write(f'[prompt] {prompt}\n[target] {target}\n[start] {datetime.now().isoformat()}\n')             log.write('[cmd] codex exec --skip-git-repo-check -s danger-full-access --add-dir /home/lixinyu/snap -m gpt-5.4 -c reasoning.effort="high" -\n\n')             log.flush()             proc = subprocess.run(cmd, input=text, cwd='/home/lixinyu/snap/new', stdout=log, stderr=subprocess.STDOUT, text=True, timeout=TIMEOUT)             rc = proc.returncode             log.write(f'\n[end] {datetime.now().isoformat()} rc={rc}\n')     except subprocess.TimeoutExpired:         rc = 124         err = 'timeout'         with log_path.open('a', encoding='utf-8') as log:             log.write(f'\n[TIMEOUT after {TIMEOUT}s]\n')     except Exception as exc:         rc = 125         err = repr(exc)         with log_path.open('a', encoding='utf-8') as log:             log.write(f'\n[EXCEPTION] {err}\n')     elapsed = round(time.time() - start, 1)     try:         tail = log_path.read_text(encoding='utf-8', errors='replace')[-8000:].lower()     except Exception:         tail = ''     usage = any(marker in tail for marker in usage_markers)     ok = rc == 0 and target.exists() and target.stat().st_size > 0     rec = {         'task': task,         'prompt': str(prompt),         'target': str(target),         'log': str(log_path),         'model': MODEL,         'returncode': rc,         'ok': ok,         'target_exists': target.exists(),         'target_size': target.stat().st_size if target.exists() else 0,         'usage_limited': usage,         'elapsed': elapsed,     }     if err:         rec['error'] = err     append_manifest(rec)     if usage:         stop_event.set()     with lock:         progress['done'] += 1         if not ok:             progress['fail'] += 1         print(f"[progress] {progress['done']}/{len(jobs)} {task}/{target.name} ok={ok} rc={rc} size={rec['target_size']} usage={usage} elapsed={elapsed}s fail={progress['fail']}", flush=True)  def worker() -> None:     while not stop_event.is_set():         try:             task, prompt, target = q.get_nowait()         except queue.Empty:             return         try:             if not (target.exists() and target.stat().st_size > 0):                 run_one(task, prompt, target)         finally:             q.task_done()  threads = [threading.Thread(target=worker, daemon=False) for _ in range(MAX_AGENTS)] for t in threads:     t.start() for t in threads:     t.join() print(f'[done] {datetime.now().isoformat()} manifest={MANIFEST} stop={stop_event.is_set()} remaining={q.qsize()} fail={progress["fail"]}', flush=True) raise SystemExit(2 if stop_event.is_set() else (1 if progress['fail'] else 0)) PY
