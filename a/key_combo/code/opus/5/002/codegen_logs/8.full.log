+def _find_hub(grid: np.ndarray) -> tuple[int, int]:
+    candidates = []
+    for comp in _components_of_color(grid, HUB_COLOR):
+        if len(comp) != 9:
+            continue
+        r0, c0, r1, c1 = bbox_coords(comp)
+        if (r1 - r0 + 1, c1 - c0 + 1) != (3, 3):
+            continue
