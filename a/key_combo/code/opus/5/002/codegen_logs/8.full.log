+
+def _draw_rays(out: np.ndarray, hr: int, hc: int) -> None:
+    for dr, dc in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:
+        r, c = hr, hc
+        while in_bounds(out.shape, r, c):
