+def _sector_of(r: int, c: int, hr: int, hc: int) -> str | None:
+    if _is_hub_cell(r, c, hr, hc):
+        return None
+    dr = r - hr
+    dc = c - hc
+    if abs(dr) == abs(dc):
+        return None
+    if r < hr and abs(dc) < hr - r:
+        return "up"
+    if c > hc and abs(dr) < c - hc:
+        return "right"
+    if r > hr and abs(dc) < r - hr:
+        return "down"
+    if c < hc and abs(dr) < hc - c:
+        return "left"
+    return None
+
