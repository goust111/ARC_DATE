.exists() else 0, 'error': 'timeout', 'usage_limited': False})     except Exception as exc:         rec.update({'returncode': None, 'ok': False, 'target_exists': target.exists(), 'target_size': target.stat().st_size if target.exists() else 0, 'error': repr(exc), 'usage_limited': False})     rec['elapsed'] = round(time.time() - start, 1)     append_manifest(rec)     with progress_lock:         progress['done'] += 1         if not rec.get('ok'):             progress['fail'] += 1         print(f"[progress] {progress['done']}/{len(jobs)} {task}/{target.name} ok={rec.get('ok')} rc={rec.get('returncode')} size={rec.get('target_size')} usage={rec.get('usage_limited')} elapsed={rec['elapsed']}s fail={progress['fail']}", flush=True)  def worker():     while not stop_event.is_set():         try:             task, prompt, target = q.get_nowait()         except queue.Empty:             return         try:             if not (target.exists() and target.stat().st_size > 0):                 run_one(task, prompt, target)         finally:             q.task_done()  threads = [threading.Thread(target=worker) for _ in range(MAX_AGENTS)] for t in threads:     t.start() for t in threads:     t.join() print(f'[done] {datetime.now().isoformat()} manifest={MANIFEST} stop={stop_event.is_set()} remaining={q.qsize()} fail={progress["fail"]}', flush=True) if stop_event.is_set():     raise SystemExit(2) if progress['fail']:     raise SystemExit(1) PY
