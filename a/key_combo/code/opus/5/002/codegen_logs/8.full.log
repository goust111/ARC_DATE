+ALL_SHAPE_VARIANTS = {size: _shape_variants(size) for size in SHAPES_BY_SIZE}
+_GEN_COUNTER = 0
+_GEOMETRY_CACHE: dict[str, list[tuple[int, int, int, int, dict, dict, dict]]] = {}
