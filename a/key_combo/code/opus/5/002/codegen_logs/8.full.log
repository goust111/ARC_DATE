+
+
+def _validate_instance(inp: np.ndarray, mode: str) -> bool:
+    out, details = _solve_with_details(inp)
+    hr, hc = details["hub"]
+    if (hr, hc) == (inp.shape[0] // 2, inp.shape[1] // 2):
+        return False
+    if np.array_equal(inp, out):
+        return False
+    if int(out[hr, hc]) == HUB_COLOR:
+        return False
