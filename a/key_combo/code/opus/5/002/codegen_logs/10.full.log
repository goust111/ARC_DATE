+    else:
+        h_gap_c = _pick_gap("right", sep_c, w - 1)
+    if layout["v_side"] == "top":
+        v_gap_r = _pick_gap("top", 0, sep_r)
+    else:
+        v_gap_r = _pick_gap("bottom", sep_r, h - 1)
+
