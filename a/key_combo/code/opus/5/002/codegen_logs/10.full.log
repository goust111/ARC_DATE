+
+def _analyze(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    sep_r, sep_c, h_gap_c, v_gap_r = _find_separator(g)
+    specs = _quadrant_specs(g.shape, sep_r, sep_c)
+    edges = _gap_edges(sep_r, sep_c, h_gap_c, v_gap_r)
