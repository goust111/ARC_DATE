+    "tl": {"h_side": "left", "v_side": "top", "sources": ("tr", "bl")},
+    "tr": {"h_side": "right", "v_side": "top", "sources": ("tl", "br")},
+    "bl": {"h_side": "left", "v_side": "bottom", "sources": ("tl", "br")},
+    "br": {"h_side": "right", "v_side": "bottom", "sources": ("tr", "bl")},
+}
