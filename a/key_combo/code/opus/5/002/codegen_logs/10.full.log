+    for attempt in analysis["attempts"]:
+        attempts_by_target[attempt["target_quadrant"]].append(attempt)
+
+    winners = []
+    for target, group in attempts_by_target.items():
+        assert target in analysis["specs"], "unknown target quadrant"
