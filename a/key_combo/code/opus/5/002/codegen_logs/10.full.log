+        "sep_r": sep_r,
+        "sep_c": sep_c,
+        "h_gap_c": h_gap_c,
+        "v_gap_r": v_gap_r,
+        "specs": specs,
+        "edges": edges,
+        "tokens": tokens,
+        "attempts": attempts,
+    }
