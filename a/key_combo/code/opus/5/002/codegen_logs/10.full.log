+    "solid": {(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)},
+    "x": {(-1, -1), (-1, 1), (0, 0), (1, -1), (1, 1)},
+    "diamond": {(-1, 0), (0, -1), (0, 0), (0, 1), (1, 0)},
