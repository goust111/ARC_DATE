+def _gen_attempt() -> np.ndarray | None:
+    areas = random.sample(AREAS, 3)
+    colors = random.sample(TEMPLATE_COLORS, 3)
+
+    templates: list[dict] = []
+    outlines: list[dict] = []
+    for area, color in zip(areas, colors):
