+def _row_interior_info(grid: np.ndarray, coords: np.ndarray) -> dict:
+    rows: dict[int, list[int]] = {}
+    for r, c in coords:
+        rows.setdefault(int(r), []).append(int(c))
+
+    interior: list[tuple[int, int]] = []
+    for r, cols in rows.items():
