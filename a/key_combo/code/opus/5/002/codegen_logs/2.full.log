+def _shape_to_patch(cells: set[tuple[int, int]], color: int) -> np.ndarray:
+    coords = np.array(sorted(cells), dtype=int)
+    r0, c0, r1, c1 = bbox_coords(coords)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in cells:
+        patch[r - r0, c - c0] = int(color)
+    return patch
