+def _extract_bars(grid: np.ndarray) -> tuple[list[dict], dict[tuple[int, int], int]]:
+    bars: list[dict] = []
+    cell_to_bar: dict[tuple[int, int], int] = {}
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in (BG, WIRE)):
