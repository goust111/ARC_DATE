+
+def _turn_count(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    for i in range(2, len(path)):
+        dr1 = path[i - 1][0] - path[i - 2][0]
+        dc1 = path[i - 1][1] - path[i - 2][1]
+        dr2 = path[i][0] - path[i - 1][0]
+        dc2 = path[i][1] - path[i - 1][1]
+        if (dr1, dc1) != (dr2, dc2):
+            turns += 1
+    return turns
