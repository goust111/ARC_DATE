+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+BG = 0
+BAR_COLORS = (1, 2, 3)
+STRIPE_CYCLE = (2, 4, 1)
+WIRE = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+GEN_RETRIES = 300
