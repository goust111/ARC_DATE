                    "c0": int(c0),
                    "c1": int(c1),
                    "color": int(color),
                    "length": int(c1 - c0 + 1),
                }
            )
            c += 1

    if np.any((g != BACKGROUND) & ~covered):
        raise ValueError("all foreground pixels must belong to horizontal bars")

    return bars


