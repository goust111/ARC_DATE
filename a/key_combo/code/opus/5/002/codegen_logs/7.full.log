+            random.shuffle(candidates)
+            placed = False
+            for r0, c0 in candidates:
+                box = (r0, c0, r0 + patch_h - 1, c0 + patch_w - 1)
+                if any(rects_intersect(box, (rr, cc, rr + patch_h - 1, cc + patch_w - 1), pad=1) for rr, cc in final_tl.values()):
