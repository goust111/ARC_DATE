+                    edge_row = random.choice([0, h - 1])
+                    anchor = (edge_row, c0 + mc)
+                else:
+                    if not (1 <= r0 + mr <= h - 2):
+                        continue
+                    edge_col = random.choice([0, w - 1])
+                    anchor = (r0 + mr, edge_col)
+                if anchor in anchors.values():
