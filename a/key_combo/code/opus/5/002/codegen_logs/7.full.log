+        input_tl: dict[int, tuple[int, int]] = {}
+        delta_choices = [d for d in range(-6, 7) if abs(d) >= 2]
+        random.shuffle(colors)
+        for color in colors:
+            fr, fc = final_tl[color]
+            motion = motion_by_color[color]
+            choices = delta_choices[:]
