+
+def gen_attempt() -> np.ndarray | None:
+    height = random.randint(18, 24)
+    width = random.randint(18, 24)
+    motion_by_color = {}
+    if random.random() < 0.5:
+        motion_by_color[BLUE] = "horizontal"
