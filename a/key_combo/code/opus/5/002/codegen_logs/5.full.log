+                        "pairs": pairs,
+                        "dist": min(dists),
+                    }
+                )
+    random.shuffle(out)
+    return out
+
+
+def _pick_seed_pair(candidates: list[dict], mode: str) -> tuple[dict, dict] | None:
+    valid: list[tuple[dict, dict]] = []
