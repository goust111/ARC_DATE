+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "coord_set": set(coords),
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
