+
+
+def _place_case(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    *,
+    orient: str,
+    axis: int,
+    tangential_span: tuple[int, int],
+    side: int,
+    mode: str,
+) -> dict | None:
+    h, w = grid.shape
+    band_len = tangential_span[1] - tangential_span[0] + 1
+    for _ in range(SHAPE_ATTEMPTS):
+        depth = random.randint(2, 4)
+        width = random.randint(3, min(6, band_len))
