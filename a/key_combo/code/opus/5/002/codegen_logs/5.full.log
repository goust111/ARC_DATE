+                if any(cell in mirror_set for cell in cells):
+                    continue
+                if orient == "horizontal":
+                    dists = [abs(r - axis) for r, _ in cells]
+                else:
+                    dists = [abs(c - axis) for _, c in cells]
+                if min(dists) < 1 or min(dists) > 3:
+                    continue
+                pairs = 0
+                for r, c in cells:
+                    for nr, nc in _neighbors4(r, c):
