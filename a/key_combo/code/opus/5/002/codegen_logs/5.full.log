+        if mirror_set & all_mirror:
+            return False
+        all_mirror |= mirror_set
+        if any(int(grid[r, c]) != BG for r, c in mirror_set):
+            return False
+        counts = info["counts"]
+        dists = info["dists"]
+        fill = int(info["fill_color"])
+        seen_fill_colors.add(fill)
+        if counts[RED] == counts[GREEN]:
+            tie_seen = True
+            if dists[RED] == dists[GREEN]:
+                return False
+        else:
+            win_seen = True
+        if fill not in SEED_COLORS:
+            return False
+        for color in SEED_COLORS:
+            region = expected["seeds"][color]
+            actual_pairs = 0
+            for r, c in region["cells"]:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) in mirror_set:
+                        actual_pairs += 1
+            if actual_pairs != region["pairs"]:
+                return False
+            if region["dist"] != min(_axis_distance(key[0], key[1], cell) for cell in region["cells"]):
+                return False
+
+    if not tie_seen and not win_seen:
+        return False
+    if len(seen_fill_colors) < 1:
+        return False
+    return True
+
+
+def _generate_one() -> np.ndarray | None:
+    h = random.randint(GRID_MIN, GRID_MAX)
+    w = random.randint(GRID_MIN, GRID_MAX)
+    grid = np.zeros((h, w), dtype=int)
+
+    h_axis = random.randint(4, h - 5)
+    v_axis = random.randint(4, w - 5)
+    grid[h_axis, :] = GREY
+    grid[:, v_axis] = GREY
+    occupied = {(h_axis, c) for c in range(w)} | {(r, v_axis) for r in range(h)}
+
+    left_cols = (1, v_axis - 4)
+    right_cols = (v_axis + 4, w - 2)
+    top_rows = (1, h_axis - 4)
+    bottom_rows = (h_axis + 4, h - 2)
+    if left_cols[0] > left_cols[1] or right_cols[0] > right_cols[1]:
+        return None
+    if top_rows[0] > top_rows[1] or bottom_rows[0] > bottom_rows[1]:
+        return None
+
+    h_span = random.choice([left_cols, right_cols])
+    v_span = random.choice([top_rows, bottom_rows])
+    h_side = random.choice([-1, 1])
+    v_side = random.choice([-1, 1])
+
+    modes = random.sample(CASE_MODES, 2)
+    meta: list[dict] = []
+
+    first = _place_case(
+        grid,
+        occupied,
+        orient="horizontal",
+        axis=h_axis,
+        tangential_span=h_span,
+        side=h_side,
+        mode=modes[0],
+    )
+    if first is None:
+        return None
+    meta.append(first)
+
+    second = _place_case(
+        grid,
+        occupied,
+        orient="vertical",
+        axis=v_axis,
+        tangential_span=v_span,
+        side=v_side,
+        mode=modes[1],
+    )
+    if second is None:
+        return None
+    meta.append(second)
+
+    if not _semantic_checks(grid, meta):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GRID_ATTEMPTS):
+        grid = _generate_one()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid mirror-complete seed-color input")

diff --git a//home/lixinyu/snap/a/key_combo/code/opus/5/002/5.py b//home/lixinyu/snap/a/key_combo/code/opus/5/002/5.py
new file mode 100644
