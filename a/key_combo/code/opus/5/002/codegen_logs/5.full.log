+                valid.append((a, b))
+            elif mode == "tie_red_close" and a["pairs"] == b["pairs"] and a["dist"] < b["dist"]:
+                valid.append((a, b))
+            elif mode == "tie_green_close" and a["pairs"] == b["pairs"] and b["dist"] < a["dist"]:
+                valid.append((a, b))
