import random, numpy as np
from collections import Counter, deque
H=W=29
DIRS=[(-1,-1),(-1,1),(1,-1),(1,1)]

def border(b):
    r0,c0,r1,c1=b
    s=set()
    for c in range(c0,c1+1): s.add((r0,c)); s.add((r1,c))
    for r in range(r0+1,r1): s.add((r,c0)); s.add((r,c1))
    return s

def valid_path(boxes):
    Bs=[border(b) for b in boxes]
    cov=Counter()
    for s in Bs:
        for p in s: cov[p]+=1
    if max(cov.values(), default=0)>2:
        return False
    got=set()
    for i in range(4):
        for j in range(i+1,4):
            inter=Bs[i]&Bs[j]
            if inter:
                # no shared edge segments
                if any((r+1,c) in inter for r,c in inter): return False
                if any((r,c+1) in inter for r,c in inter): return False
                got.add((i,j))
    return got=={(0,1),(1,2),(2,3)}

def analyze(boxes, rev=False):
    colors=[1,2,3,4]
    if rev: colors=colors[::-1]
    Bs=[border(b) for b in boxes]
    scene=np.zeros((H,W),int)
    for i in range(4):
      for p in Bs[i]: scene[p]=colors[i]
    ray=np.zeros((H,W),bool)
    for i,(r0,c0,r1,c1) in enumerate(boxes):
      cr=(r0+r1)//2; cc=(c0+c1)//2
      for dr,dc in DIRS:
        r=cr+dr; c=cc+dc
        while 0<=r<H and 0<=c<W and not ray[r,c]:
          ray[r,c]=1; scene[r,c]=colors[i]; r+=dr; c+=dc
    vis=np.zeros((H,W),bool)
    multi=False
    ties=0
    maxk=0
    for r in range(H):
      for c in range(W):
        if scene[r,c]"'!=0 or vis[r,c]: continue
        q=deque([(r,c)]); vis[r,c]=1; comp=[]
        while q:
          rr,cc=q.popleft(); comp.append((rr,cc))
          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<H and 0<=nc<W and not vis[nr,nc] and scene[nr,nc]==0:
              vis[nr,nc]=1; q.append((nr,nc))
        cnt=Counter()
        for rr,cc in comp:
          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<H and 0<=nc<W and ray[nr,nc]: cnt[scene[nr,nc]]+=1
        if not cnt: return False, '"'no contact'
        vals=cnt.most_common()
        if len(vals)>1 and vals[0][1]==vals[1][1]: ties += 1
        if len(cnt)>1: multi=True
        maxk=max(maxk,len(cnt))
    return True, (ties,multi,maxk)

