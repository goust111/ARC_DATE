def border_coords(b):
    r0,c0,r1,c1=b
    pts=[]
    for c in range(c0,c1+1): pts.append((r0,c)); pts.append((r1,c))
    for r in range(r0+1,r1): pts.append((r,c0)); pts.append((r,c1))
    return pts

def render(order):
    grid=np.zeros((H,W),int)
    colors=[1,2,3,4]
    # input visible by order bottom->top in order list of box indices?
    for layer,idx in enumerate(order):
        for r,c in border_coords(boxes[idx]): grid[r,c]=colors[idx]
    # solve-like from recovered full boxes and this same order for rays/fill
    work=grid.copy(); ray=np.zeros((H,W),bool)
    for idx in order:
        r0,c0,r1,c1=boxes[idx]; cr=(r0+r1)//2; cc=(c0+c1)//2
        for dr,dc in DIRS:
            r=cr+dr; c=cc+dc
            while 0<=r<H and 0<=c<W and not ray[r,c]:
