          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<H and 0<=nc<W and not vis[nr,nc] and work[nr,nc]==0:
              vis[nr,nc]=1; q.append((nr,nc))
        cnt=Counter()
        for rr,cc in comp:
          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<H and 0<=nc<W and ray[nr,nc]: cnt[work[nr,nc]] += 1
        color=cnt.most_common(1)[0][0]
        for rr,cc in comp: work[rr,cc]=color
    # restore visible full borders in order
    out=np.array(work)
    out[:]=work
    for idx in order:
        for r,c in border_coords(boxes[idx]): out[r,c]=colors[idx]
    return out

