            if 0<=nr<H and 0<=nc<W and ray[nr,nc]: cnt[scene[nr,nc]] += 1
        if not cnt: return None
        vals=cnt.most_common()
        if len(vals)>1 and vals[0][1]==vals[1][1]: t += 1
        if len(cnt)>1: multi += 1
    return t,multi

