+def _scanline_fill(grid: np.ndarray, wall_mask: np.ndarray, marker_col: int) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    out = g.copy()
+    wall_rows = np.flatnonzero(np.any(wall_mask, axis=1))
