+            terminal, step = (r, c0 - 1), (0, 1)
+            dist = c0 - 1 - c
+        elif r0 <= r <= r1 and c > c1:
+            terminal, step = (r, c1 + 1), (0, -1)
+            dist = c - (c1 + 1)
+        elif c0 <= c <= c1 and r < r0:
