+        elif side == "up":
+            col = c0 + lane_index
+            for dist in chosen:
+                cells.add((r0 - dist, col))
+        elif side == "down":
+            col = c0 + lane_index
+            for dist in chosen:
+                cells.add((r1 + dist, col))
+        else:
+            raise ValueError("invalid side")
+    return cells
+
+
+def _marker_column_candidates(
+    width: int,
+    anchor: BBox,
+    green_cols: set[int],
+    horizontal_side: str,
+    wall_mask: np.ndarray,
+) -> list[int]:
