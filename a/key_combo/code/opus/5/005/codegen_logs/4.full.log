+    for r, c in loose:
+        if r0 <= r <= r1 and c < c0:
+            counts["left"] += 1
+        elif r0 <= r <= r1 and c > c1:
+            counts["right"] += 1
+        elif c0 <= c <= c1 and r < r0:
+            counts["up"] += 1
+        elif c0 <= c <= c1 and r > r1:
+            counts["down"] += 1
+        else:
+            raise AssertionError("loose green pixels must stay on orthogonal rays")
+    return counts
+
