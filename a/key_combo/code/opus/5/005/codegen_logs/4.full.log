+    for lane_index, amount in enumerate(counts):
+        if amount == 0:
+            continue
+        chosen = random.sample(EDGE_DISTANCES, amount)
+        if side == "left":
+            row = r0 + lane_index
+            for dist in chosen:
+                cells.add((row, c0 - dist))
+        elif side == "right":
+            row = r0 + lane_index
+            for dist in chosen:
+                cells.add((row, c1 + dist))
+        elif side == "up":
+            col = c0 + lane_index
+            for dist in chosen:
