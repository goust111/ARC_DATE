+    return candidates[-1]
+
+
+def _bresenham(a: Coord, b: Coord) -> list[Coord]:
+    r0, c0 = a
+    r1, c1 = b
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dr - dc
+    cells: list[Coord] = []
+    r, c = r0, c0
+    while True:
+        cells.append((r, c))
+        if r == r1 and c == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dc:
+            err -= dc
+            r += sr
+        if e2 < dr:
+            err += dr
+            c += sc
+    return cells
+
+
+def _make_line_records(anchors: list[Coord]) -> list[dict]:
+    records: list[dict] = []
+    for i, j in combinations(range(len(anchors)), 2):
+        a = anchors[i]
+        b = anchors[j]
+        dr = a[0] - b[0]
+        dc = a[1] - b[1]
+        d2 = dr * dr + dc * dc
+        records.append(
+            {
+                "i": i,
+                "j": j,
+                "d2": int(d2),
+                "cells": _bresenham(a, b),
+            }
+        )
+    records.sort(key=lambda rec: (rec["d2"], rec["i"], rec["j"]))
