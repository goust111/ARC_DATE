+    anchors, band_colors = sampled
+    inp = _render_input_from_layout(shape, anchors, shape_cells, local_anchor, band_colors)
+    if not _validate_instance(inp):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
