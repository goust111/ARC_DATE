+
+
+def _sample_four_anchor_layout(
+    shape: tuple[int, int],
+    shape_cells: tuple[Coord, ...],
+    local_anchor: Coord,
+    k: int,
+    *,
+    require_filtered: bool,
+) -> list[Coord] | None:
+    h, w = shape
+    row_candidates = range(3, h - 5)
+    col_candidates = range(3, w - 3)
+    points = [(r, c) for r in row_candidates for c in col_candidates]
