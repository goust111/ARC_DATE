+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+# All prototypes are 4-connected, asymmetric, and include the bbox center pixel.
+PROTOTYPES = [
+    ((0, 1), (1, 0), (1, 1), (2, 1), (2, 2)),
+    ((0, 0), (1, 0), (1, 1), (2, 1), (2, 2)),
+    ((0, 2), (1, 0), (1, 1), (1, 2), (2, 0)),
+    ((0, 0), (0, 1), (1, 1), (2, 1), (2, 2)),
