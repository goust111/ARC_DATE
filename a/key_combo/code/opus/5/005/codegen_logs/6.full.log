+        "grid": g,
+        "shape": (h, w),
+        "bg": bg,
+        "band_row": band_row,
+        "band_colors": band_colors,
+        "sprites": sprite_comps,
+        "sprite_sets": sprite_sets,
+        "anchors": anchors,
+        "edges": edge_records,
