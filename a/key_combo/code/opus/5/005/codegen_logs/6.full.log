+def _make_line_records(anchors: list[Coord]) -> list[dict]:
+    records: list[dict] = []
+    for i, j in combinations(range(len(anchors)), 2):
+        a = anchors[i]
+        b = anchors[j]
+        dr = a[0] - b[0]
+        dc = a[1] - b[1]
+        d2 = dr * dr + dc * dc
+        records.append(
+            {
+                "i": i,
+                "j": j,
+                "d2": int(d2),
+                "cells": _bresenham(a, b),
