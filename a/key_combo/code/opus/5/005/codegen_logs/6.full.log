+def _render_input_from_layout(
+    shape: tuple[int, int],
+    anchors: list[Coord],
+    shape_cells: tuple[Coord, ...],
+    local_anchor: Coord,
+    band_colors: list[int],
+) -> np.ndarray:
+    h, w = shape
+    grid = np.zeros((h, w), dtype=int)
+    for anchor in anchors:
+        for r, c in _sprite_cells_for_anchor(anchor, shape_cells, local_anchor):
+            grid[r, c] = GREY
