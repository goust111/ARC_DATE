+def _is_asymmetric(shape_cells: tuple[Coord, ...]) -> bool:
+    patch = _grid_from_cells((3, 3), list(shape_cells), 1)
+    variants = [
+        patch,
+        np.flipud(patch),
+        np.fliplr(patch),
+        np.rot90(patch, 1),
+        np.rot90(patch, 2),
+        np.rot90(patch, 3),
+        np.transpose(patch),
+        np.fliplr(np.transpose(patch)),
