+        np.flipud(patch),
+        np.fliplr(patch),
+        np.rot90(patch, 1),
+        np.rot90(patch, 2),
+        np.rot90(patch, 3),
+        np.transpose(patch),
+        np.fliplr(np.transpose(patch)),
