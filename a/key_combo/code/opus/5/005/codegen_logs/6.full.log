+    for cells in sprite_sets:
+        if occupied & cells:
+            return False
+        occupied |= cells
+
+    for i, j in combinations(range(len(all_sprite_cells)), 2):
+        if _min_pixel_gap(all_sprite_cells[i], all_sprite_cells[j]) < 5:
+            return False
