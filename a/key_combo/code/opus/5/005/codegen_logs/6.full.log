+def _sprite_cells_for_anchor(anchor: Coord, shape_cells: tuple[Coord, ...], local_anchor: Coord) -> list[Coord]:
+    ar, ac = anchor
+    lr, lc = local_anchor
+    return [(ar + dr - lr, ac + dc - lc) for dr, dc in shape_cells]
