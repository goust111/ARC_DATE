+    reach_regions = {_wall_region_of_sprite(labels, sprite) for sprite in info["reachable"]}
+    unreach_regions = {_wall_region_of_sprite(labels, sprite) for sprite in info["unreachable"]}
+    if reach_regions != {src_region}:
