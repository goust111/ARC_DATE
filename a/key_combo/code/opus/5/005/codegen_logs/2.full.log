+        random.shuffle(order)
+        chosen: list[tuple[int, int]] = []
+        for r, c in order:
+            if all(abs(r - rr) > 4 or abs(c - cc) > 4 for rr, cc in chosen):
+                chosen.append((r, c))
+                if len(chosen) == count:
