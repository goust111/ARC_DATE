+def _region_label_grid(wall_mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    regions = _wall_regions(wall_mask)
+    labels = np.full(wall_mask.shape, -1, dtype=int)
+    for idx, coords in enumerate(regions):
