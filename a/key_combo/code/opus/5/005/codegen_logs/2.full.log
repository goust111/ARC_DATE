+def _draw_path(points: list[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    h, w = shape
+    for (r0, c0), (r1, c1) in zip(points, points[1:], strict=False):
