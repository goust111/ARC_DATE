+BG = 7
+WALL = 6
+SOURCE = 4
+PROTO_COLOR = {"A": 1, "B": 2}
+TOGGLE = {"A": "B", "B": "A"}
+OFFSETS = {
+    "A": [(-1, 0), (0, -1), (0, 0), (0, 1), (1, 0)],
+    "B": [(-1, -1), (-1, 1), (0, 0), (1, -1), (1, 1)],
