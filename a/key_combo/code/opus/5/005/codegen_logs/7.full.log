+        return (rows[0], c), (rows[-1], c)
+    raise AssertionError("blue object must be a horizontal or vertical segment")
+
+
+def _bresenham_line(a: Coord, b: Coord) -> list[Coord]:
+    r0, c0 = a
+    r1, c1 = b
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dr - dc
+    cells: list[Coord] = []
+    while True:
+        cells.append((r0, c0))
+        if (r0, c0) == (r1, c1):
+            return cells
+        e2 = 2 * err
+        if e2 > -dc:
+            err -= dc
+            r0 += sr
+        if e2 < dr:
+            err += dr
+            c0 += sc
