+
+    max_r = max(anchor["center"][0] for anchor in anchors)
+    max_c = max(anchor["center"][1] for anchor in anchors)
+    h_min = max_r + 5
+    w_min = max_c + 5
+    if h_min > 30 or w_min > 30:
+        return None
+    h = random.randint(h_min, min(30, h_min + 3))
+    w = random.randint(w_min, min(30, w_min + 3))
