def _candidate_boxes(n: int, h: int, w: int, dr: int, dc: int) -> list[tuple[_BBox, _BBox]]:
    r0_min = 0 if dr == -1 else 1
    r0_max = n - h - 1 if dr == -1 else n - h
    c0_min = 0 if dc == -1 else 1
    c0_max = n - w - 1 if dc == -1 else n - w
