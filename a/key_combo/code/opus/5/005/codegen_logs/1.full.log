    if len(set(target_indices)) < min(3, len(hole_counts)):
        return False
    if not all(np.any(grid[:, c0 : c1 + 1] == BG) for c0, c1 in band_ranges):
        return False
    actual = main(grid)
    return np.array_equal(actual, expected)


def _generate_case() -> np.ndarray | None:
    n = random.choice([4, 5])
