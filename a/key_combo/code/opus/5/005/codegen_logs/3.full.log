          wm=np.zeros_like(m)
          for a,l,h in walls: wm[l:h+1,a]=1
        regs=comps(m & ~wm)
        if len(regs)==3:
          markers=[marker_ok(r,wm,mode) for r in regs]
          print(' ',L,d,ori,[len(r) for r in regs],markers)
