+    return spans
+
+
+def _wall_candidates(domain: np.ndarray, grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    candidates = []
+    for orientation in ("H", "V"):
+        for span in _domain_spans(domain, orientation):
