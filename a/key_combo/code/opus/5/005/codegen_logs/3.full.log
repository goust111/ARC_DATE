+        c0 = random.randint(pad, w - side - pad)
+
+        top = _make_segment(r0, c0, length)
+        bottom = [(r + delta, c + delta) for r, c in top]
+        dvals = tuple(sorted(r - c for r, c in top))
+        if dvals in used_dsets:
+            continue
+
