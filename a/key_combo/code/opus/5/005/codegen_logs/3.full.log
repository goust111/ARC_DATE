+def _evaluate_wall_set(domain: np.ndarray, grid: np.ndarray, walls: list[dict]) -> dict | None:
+    wall_mask = np.zeros_like(domain, dtype=bool)
+    for wall in walls:
+        for r, c in wall["cells"]:
+            if wall_mask[r, c] or int(grid[r, c]) != BG:
+                return None
+            wall_mask[r, c] = True
