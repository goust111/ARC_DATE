/bin/bash -lc "python - <<'PY'
import numpy as np
from collections import deque

def neighbors4(r,c): return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]
def neighbors8(r,c): return [(r+dr,c+dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]
def comps(mask):
  h,w=mask.shape; seen=np.zeros_like(mask,bool); out=[]
  for r in range(h):
    for c in range(w):
      if mask[r,c] and not seen[r,c]:
        q=deque([(r,c)]); seen[r,c]=1; cur=[]
        while q:
          x,y=q.popleft(); cur.append((x,y))
          for nx,ny in neighbors4(x,y):
            if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]:
              seen[nx,ny]=1; q.append((nx,ny))
        out.append(cur)
  return out

def domain(length,delta,H=40,W=40,r0=10,c0=10):
  s1=r0+c0+length-1; s2=s1+2*delta
  dvals=[r0+i-(c0+length-1-i) for i in range(length)]
  d0,d1=min(dvals),max(dvals)
  rr,cc=np.indices((H,W))
  return (rr+cc>s1)&(rr+cc<s2)&(rr-cc>d0-1)&(rr-cc<d1+1)

def marker_ok(region, barriers):
  h,w=barriers.shape
  reg=np.zeros_like(barriers,bool)
  for r,c in region: reg[r,c]=1
  cands=[]
  for r,c in region:
    if any(not(0<=nr<h and 0<=nc<w and reg[nr,nc]) for nr,nc in neighbors4(r,c)): continue
    if any(0<=nr<h and 0<=nc<w and barriers[nr,nc] for nr,nc in neighbors8(r,c)): continue
    cands.append((r,c))
  return len(cands)

for L in [3,4,5]:
  for d in [3,4]:
    m=domain(L,d)
    rows=np.where(m.any(axis=1))[0]
    cols=np.where(m.any(axis=0))[0]
    print('\\nL',L,'d',d,'area',m.sum(),'rows',rows,'cols',cols)
    for ori in 'HV':
      if ori=='H':
        spans=[(r,np.where(m[r])[0][0],np.where(m[r])[0][-1]) for r in rows]
      else:
        spans=[(c,np.where(m[:,c])[0][0],np.where(m[:,c])[0][-1]) for c in cols]
      mid=len(spans)//2
      choices=[]
      if len(spans)>=3:
        choices.append([spans[mid]])
      if len(spans)>=5:
        choices.append([spans[mid-1],spans[mid+1]])
      for walls in choices:
        wm=np.zeros_like(m)
        for axis,lo,hi in walls:
          if ori=='H': wm[axis,lo:hi+1]=1
          else: wm[lo:hi+1,axis]=1
        regs=comps(m & ~wm)
        areas=[len(r) for r in regs]
        markers=[marker_ok(r,wm) for r in regs]
        print(' ',ori,'walls',[(a,l,h) for a,l,h in walls],'areas',areas,'marker_opts',markers)
