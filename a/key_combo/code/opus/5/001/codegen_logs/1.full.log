+    def get_bg(grid: np.ndarray) -> int:
+        vals, counts = np.unique(grid, return_counts=True)
+        return int(vals[np.argmax(counts)])
+
+    def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+        r0, c0, r1, c1 = bbox
+        return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        if bg is None:
+            bg = get_bg(grid)
+        bg = int(bg)
+        if connectivity != 4 or not monochromatic or return_format != "dict":
+            raise ValueError("fallback find_components only supports 4-connected monochrome dict mode")
+        if colors is None:
+            colors = [int(v) for v in np.unique(grid) if int(v) != bg]
+        out = []
+        h, w = grid.shape
+        seen = np.zeros((h, w), dtype=bool)
+        for color in colors:
+            for r, c in np.argwhere(grid == int(color)):
+                r = int(r)
+                c = int(c)
+                if seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                arr = np.array(coords, dtype=int)
+                r0, c0 = arr.min(axis=0)
+                r1, c1 = arr.max(axis=0)
+                out.append(
+                    {
+                        "color": int(color),
+                        "coords": arr,
+                        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                        "area": int(len(coords)),
+                    }
+                )
+        return out
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+RNG = np.random.default_rng()
