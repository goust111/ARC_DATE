            else:
                small.append(hole)
    return small, large


def _has_tie_effect(work: np.ndarray, legend: list[dict], source_pixels: dict[int, np.ndarray], keep_black: np.ndarray) -> bool:
    dists = _distance_arrays(work.shape, legend, source_pixels)
