+    _mask(("##.", "#..", "###")),
+    _mask(("###", ".#.", "##.")),
+    _mask(("####", ".#..", ".###")),
+    _mask((".##.", "##..", ".###")),
+    _mask(("###.", "..#.", "###.")),
