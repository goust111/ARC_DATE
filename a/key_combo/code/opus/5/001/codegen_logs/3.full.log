    return False


def _semantic_check(grid: np.ndarray, expect: dict) -> bool:
    try:
        actual = main(grid)
        expected = _expected_by_rules(grid)
    except Exception:
        return False
    if not np.array_equal(actual, expected):
        return False

    work, bg, legend, objects, source_pixels = _collect_scene(grid)
