+PLAIN_SHAPES = (
+    _mask(("##.", "#..", "###")),
+    _mask(("###", ".#.", "##.")),
+    _mask(("####", ".#..", ".###")),
+    _mask((".##.", "##..", ".###")),
+    _mask(("###.", "..#.", "###.")),
+    _mask(("###", "##.", ".#.")),
+)
+
+SMALL_HOLE_SHAPES = (
+    _mask(("###", "#.#", "###")),
+    _mask(("####", "#..#", "####")),
+    _mask(("###", "#.#", "#.#", "###")),
+)
+
+LARGE_HOLE_SHAPES = (
+    _mask(("#####", "#...#", "#####")),
+    _mask(("####", "#..#", "#..#", "####")),
+    _mask(("#####", "#...#", "#...#", "#####")),
+)
