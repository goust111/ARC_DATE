+        idx = random.choice(indices)
+        kinds[idx] = "large"
+    if expect["small_hole"]:
+        choices = [idx for idx in indices if kinds[idx] == "plain"]
+        if not choices:
+            choices = indices
+        idx = random.choice(choices)
+        kinds[idx] = "small"
