+    lengths = [2, 3]
+    if num_sources == 3:
+        lengths.append(random.choice((2, 3)))
+    random.shuffle(lengths)
+    if len(set(lengths)) == 1:
+        lengths[0] = 2
+        lengths[1] = 3
