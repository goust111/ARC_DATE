+    used_first_colors: set[int] = set()
+    legend: list[dict] = []
+    for order, (source, length) in enumerate(zip(sources, lengths)):
+        palette = _make_palette(int(source), int(length), used_first_colors)
+        used_first_colors.add(int(palette[0]))
