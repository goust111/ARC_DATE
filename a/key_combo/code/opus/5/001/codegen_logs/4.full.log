+def _center_distance_fill(shape: tuple[int, int], depth: int) -> np.ndarray:
+    h, w = shape
+    rr, cc = np.indices((h, w))
+    center_r = (h - 1) // 2
+    center_c = (w - 1) // 2
+    dist = np.abs(rr - center_r) + np.abs(cc - center_c)
+    return PALETTE[(dist + depth - 1) % len(PALETTE)]
