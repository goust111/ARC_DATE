+def _build_cup_patch(
+    border_color: int,
+    content_color: int,
+    direction: str,
+    tail_len: int,
+    body_h: int,
+    width: int,
+    content_count: int,
+) -> dict:
+    patch = np.full((tail_len + body_h, width), BG, dtype=int)
+    mid = width // 2
