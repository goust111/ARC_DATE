+        if len(cup["path"]) <= cup["content_count"]:
+            return None
+        if not _path_has_visible_turn(cup["path"], cup["content_count"]):
+            return None
+
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
