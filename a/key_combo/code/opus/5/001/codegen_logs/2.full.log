+                "U": [cell for cell in cells if cell[0] == r0],
+                "D": [cell for cell in cells if cell[0] == r1],
+                "L": [cell for cell in cells if cell[1] == c0],
+                "R": [cell for cell in cells if cell[1] == c1],
