+    random.shuffle(patterns)
+    for dirs in patterns:
+        candidates: list[list[int]] = []
+        if len(dirs) == 2:
+            max_l1 = min(visible_len - 1, total_len - 1)
+            for l1 in range(1, max_l1 + 1):
