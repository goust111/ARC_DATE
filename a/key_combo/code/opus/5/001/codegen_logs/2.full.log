+    r, c = start
+    for idx, direction in enumerate(dirs):
+        dr, dc = DIRS[direction]
+        steps = lengths[idx] - 1 if idx == 0 else lengths[idx]
+        for _ in range(steps):
+            r += dr
+            c += dc
