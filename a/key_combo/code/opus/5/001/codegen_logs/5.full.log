 179: def _build_column(n: int, colors: list[int], majority: int, dominant: int) -> list[int]:
 180:     """Build a column of length *n* with *dominant* appearing exactly *majority* times."""
 181:     col = [dominant] * majority
 182:     others = [c for c in colors if c != dominant]
 183:     fill = others if others else colors
 184:     for _ in range(n - majority):
 185:         col.append(random.choice(fill))
 186:     random.shuffle(col)
