  13: def main(grid: np.ndarray) -> np.ndarray:
  14:     """
  15:     Merge same-sized filled rectangular objects by overlaying their internal marker pixels.
  16: 
  17:     Input structure:
  18:     - A dominant background surrounds two or more separated 4-connected foreground objects.
  19:     - Every object is a filled rectangle of the same size.
  20:     - Each rectangle has the same majority base color plus one or more non-base marker pixels.
  21: 
  22:     Rule:
  23:     - Create one output rectangle with the shared object size, filled with the shared base color.
  24:     - For each input rectangle, copy every non-base marker pixel to the same relative location
  25:       in the output.
  26:     - Marker overlays must either land on base color or agree in color with an existing marker.
  27: 
  28:     Key insight:
  29:     The separated rectangles are layers of the same template; their colored marker pixels
  30:     combine by local coordinates while the repeated base fill is just the output canvas.
  31:     """
  32:     g = np.asarray(grid, dtype=int)
  33:     bg = int(get_bg(g))
  34: 
  35:     objects: list[tuple[np.ndarray, int]] = []
  36:     for coords in components_mask(g != bg, connectivity=4):
  37:         r0, c0, r1, c1 = bbox_coords(coords)
  38:         patch = crop_bbox(g, (r0, c0, r1, c1))
  39:         assert np.all(patch != bg)
  40: 
  41:         counts = Counter(map(int, patch.ravel()))
  42:         ranked = counts.most_common()
  43:         assert len(ranked) >= 2
  44:         assert ranked[0][1] > ranked[1][1]
  45:         objects.append((patch, int(ranked[0][0])))
