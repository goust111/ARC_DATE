+    patch = crop_bbox(grid, (r0, c0, r1, c1))
+    color = int(comp["color"])
+    if patch.shape[1] != 3 or patch.shape[0] < 3:
+        return None
+    expected = np.zeros_like(patch)
+    expected[:, 0] = color
+    expected[0, :] = color
+    expected[-1, :] = color
