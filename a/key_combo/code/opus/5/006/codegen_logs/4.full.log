+    return _build_output(rects, rotate_key="panel_rotate", order_key="blue_dist")
+
+
+def _sample_counts() -> list[int]:
+    return random.choice(([2, 2, 1], [1, 2, 2], [2, 2, 2]))
+
+
+def _random_partition(total: int, parts: int) -> list[int]:
