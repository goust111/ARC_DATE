+
+    blue_dists = [rect["blue_dist"] for rect in rects]
+    if len(set(blue_dists)) != len(blue_dists):
+        return None
+
+    counts_by_panel = [sum(rect["panel_index"] == idx for rect in rects) for idx in range(3)]
