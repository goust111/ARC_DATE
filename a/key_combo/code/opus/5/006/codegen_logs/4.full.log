+            rr1 = rr0 + rect["h"]
+            cc0 = c0 + rect["left"]
+            cc1 = cc0 + rect["w"]
+            grid[rr0:rr1, cc0:cc1] = rect["color"]
+    return grid
+
+
+def _make_attempt() -> np.ndarray | None:
+    h = random.randint(12, 18)
