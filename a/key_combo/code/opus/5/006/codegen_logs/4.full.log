+                "bbox": bbox,
+                "arr": arr,
+                "color": color,
+                "h": int(arr.shape[0]),
+                "w": int(arr.shape[1]),
+            }
+        )
+    rects.sort(key=lambda rect: (rect["bbox"][0], rect["bbox"][1]))
+    return rects
+
+
+def _build_output(rects: list[dict], rotate_key: str, order_key: str) -> np.ndarray:
+    ordered = sorted(
+        rects,
+        key=lambda rect: (
+            rect[order_key],
+            rect["panel_index"],
+            rect["bbox_global"][0],
+            rect["bbox_global"][1],
+            rect["color"],
+        ),
+    )
+    patches: list[np.ndarray] = []
+    for rect in ordered:
+        arr = rect["arr"]
+        if rect[rotate_key]:
+            arr = np.rot90(arr, 1)
+        patches.append(arr)
+    out_h = int(sum(arr.shape[0] for arr in patches))
+    out_w = int(max(arr.shape[1] for arr in patches))
+    out = np.full((out_h, out_w), BG, dtype=int)
+    cursor = 0
+    for arr in patches:
+        h, w = arr.shape
+        left = (out_w - w) // 2
+        out[cursor : cursor + h, left : left + w] = arr
+        cursor += h
+    return out
+
+
+def _analyze(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    assert h >= 6 and w >= 10
+    assert int(g[0, 0]) == MAGENTA
+    assert np.all(g[1:, 0] == RED)
+
