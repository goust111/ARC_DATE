from itertools import combinations
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
SIDES={(-1,0):'N',(0,1):'E',(1,0):'S',(0,-1):'W'}

def right(d): return DIRS[(DIRS.index(d)+1)%4]
def left(d): return DIRS[(DIRS.index(d)-1)%4]

def starts(R,C):
    out=[]
    for c in range(C): out.append(('T'+str(c),(0,c),(1,0),'top',c))
    for r in range(R): out.append(('R'+str(r),(r,C-1),(0,-1),'right',r))
    for c in range(C): out.append(('B'+str(c),(R-1,c),(-1,0),'bottom',c))
    for r in range(R): out.append(('L'+str(r),(r,0),(0,1),'left',r))
    return out

def distkey(R,C,lab,side,idx):
    # slot size 3, frame top-left (1,1), markers on outer border
    if side=='top': return 1 + (1 + idx*4 + 1 -1) # row diff 1 plus col offset center
    if side=='left': return (1 + idx*4 + 1 -1) + 1
    if side=='right': return (1 + idx*4 + 1 -1) + (3*C+1)
    if side=='bottom': return (3*R+1) + (1 + idx*4 + 1 -1)

def trace(R,C,start,d):
    slot=start; dist=1; seen=set(); arr={}; rights=lefts=0
    while True:
        state=(slot,d)
        if state in seen: break
        seen.add(state)
        arr.setdefault(slot, dist)
        nr=slot[0]+d[0]; nc=slot[1]+d[1]
        if 0<=nr<R and 0<=nc<C:
            slot=(nr,nc); dist+=1; continue
        rd=right(d); rr=slot[0]+rd[0]; rc=slot[1]+rd[1]
        if 0<=rr<R and 0<=rc<C:
            rights += 1
            slot=(rr,rc); d=rd; dist+=1; continue
        ld=left(d); lr=slot[0]+ld[0]; lc=slot[1]+ld[1]
        if 0<=lr<R and 0<=lc<C:
            lefts += 1
            slot=(lr,lc); d=ld; dist+=1; continue
        break
    return arr, rights, lefts

def evalset(R,C,picks):
    info=[]
    for lab,start,d,side,idx in picks:
        arr,r,l=trace(R,C,start,d)
        info.append((lab,arr,distkey(R,C,lab,side,idx),r,l))
    slots=[(r,c) for r in range(R) for c in range(C)]
    if any(len(arr)<2 for _,arr,_,_,_ in info): return False, 'short'
    if set().union(*[set(arr) for _,arr,_,_,_ in info]) "'!= set(slots): return False,'"'cover'
    contested=[s for s in slots if sum(s in arr for _,arr,_,_,_ in info)>=2]
    if not contested: return False,'contest'
    winners={}
    ties=[]
    for s in slots:
        cand=[]
        for lab,arr,dist,_,_ in info:
            if s in arr: cand.append((arr[s],dist,lab))
        cand.sort()
        if len(cand)>=2 and cand[0][:2]==cand[1][:2]: return False,'ambig'
        winners[s]=cand[0][2]
        if len(cand)>=2 and cand[0][0]==cand[1][0]: ties.append(s)
    if not ties: return False,'notie'
    if any(sum(1 for w in winners.values() if w==lab)==0 for lab,_,_,_,_ in info): return False,'nowin'
    if sum(r for _,_,_,r,_ in info)==0 or sum(l for _,_,_,_,l in info)==0: return False,'turns'
    return True, (ties,winners)

for R,C in [(3,3),(4,3)]:
    sts=starts(R,C)
    ok=0
    for m in [3,4]:
        for comb in combinations(sts,m):
            per={}
            good=True
            dists=[]
            for lab,_,_,side,idx in comb:
                per[side]=per.get(side,0)+1
                if per[side]>2: good=False
                d=distkey(R,C,lab,side,idx)
                dists.append(d)
            if len(set(dists))<len(dists): good=False
            if not good: continue
            res=evalset(R,C,comb)
            if res[0]:
                ok+=1
                if ok<8:
                    print('grid',R,C,'m',m,[x[0] for x in comb],res[1][0][:3])
    print('total ok',R,C,ok)
