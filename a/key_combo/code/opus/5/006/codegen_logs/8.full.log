+        return int(mr), int(c0)
+    if side == (0, 1):
+        return int(mr), int(c1)
+    raise AssertionError("invalid side")
+
+
+def _paint_segment(out: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int) -> None:
