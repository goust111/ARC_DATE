+    for info in path_infos:
+        for step in info["steps"]:
+            if slot_winner.get(step["slot"]) != info["marker_id"]:
+                continue
+            _paint_slot_path(out, row_lines, col_lines, step["slot"], step["entry"], step["exit"], info["color"])
