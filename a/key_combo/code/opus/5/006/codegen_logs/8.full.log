def _gen_marker(color: int, bg: int, corner: str) -> np.ndarray:
    marker = np.full(_GEN_MARKER_SHAPE, int(bg), dtype=int)
    for r, c in _GEN_MARKERS[corner]:
        marker[r, c] = int(color)
    return marker


