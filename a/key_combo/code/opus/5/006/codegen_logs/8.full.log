+        if 0 <= nr < n_rows and 0 <= nc < n_cols:
+            exit_side = direction
+            next_slot = (int(nr), int(nc))
+            next_dir = direction
+        else:
+            right_dir = _right(direction)
+            rr = int(slot[0] + right_dir[0])
+            rc = int(slot[1] + right_dir[1])
+            if 0 <= rr < n_rows and 0 <= rc < n_cols:
+                saw_right = True
+                exit_side = right_dir
+                next_slot = (int(rr), int(rc))
+                next_dir = right_dir
