+def _geometry(n_rows: int, n_cols: int, slot_h: int = 3, slot_w: int = 3) -> tuple[int, int, list[int], list[int]]:
+    fr0 = fc0 = 1
+    row_lines = [int(fr0 + i * (slot_h + 1)) for i in range(n_rows + 1)]
+    col_lines = [int(fc0 + j * (slot_w + 1)) for j in range(n_cols + 1)]
