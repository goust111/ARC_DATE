+    col_lines: list[int],
+    slot: tuple[int, int],
+    entry_side: tuple[int, int],
+    exit_side: tuple[int, int] | None,
+    color: int,
+) -> None:
+    center = (
+        (row_lines[slot[0]] + row_lines[slot[0] + 1]) // 2,
+        (col_lines[slot[1]] + col_lines[slot[1] + 1]) // 2,
