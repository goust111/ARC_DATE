+    }
+    return grid, meta
+
+
+def _render_output(inp: np.ndarray, n_rows: int, n_cols: int, marker_specs: list[dict], outcome: dict) -> np.ndarray:
+    out = np.array(inp, dtype=int, copy=True)
+    _, _, row_lines, col_lines = _geometry(n_rows, n_cols)
