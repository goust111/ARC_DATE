+
+def _valid_combinations(n_rows: int, n_cols: int, count: int) -> list[tuple[dict, ...]]:
+    starts = _boundary_starts(n_rows, n_cols)
+    combos = []
+    for combo in itertools.combinations(starts, count):
+        side_counts = {side: 0 for side in SIDE_TO_DIR}
+        for item in combo:
