+        return int(row_lines[0]), int((col_lines[index] + col_lines[index + 1]) // 2)
+    if side == "bottom":
+        return int(row_lines[-1]), int((col_lines[index] + col_lines[index + 1]) // 2)
+    if side == "left":
+        return int((row_lines[index] + row_lines[index + 1]) // 2), int(col_lines[0])
+    if side == "right":
