+def _run_lengths(mask: np.ndarray) -> list[int]:
+    out: list[int] = []
+    for seq in list(mask.astype(int)) + list(mask.astype(int).T):
+        count = 0
+        for v in seq:
+            if int(v):
+                count += 1
+            elif count:
+                out.append(int(count))
+                count = 0
+        if count:
+            out.append(int(count))
+    return out
