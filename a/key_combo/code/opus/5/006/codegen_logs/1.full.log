+def _parse_start(grid: np.ndarray) -> dict:
+    ys = np.argwhere(grid == YELLOW)
+    assert ys.shape == (1, 2)
+    yr, yc = map(int, ys[0])
+    red_neighbors = []
+    for dr, dc in DIRS:
+        rr, cc = int(yr + dr), int(yc + dc)
+        if in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == RED:
