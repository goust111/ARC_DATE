+for idx, tmpl in enumerate(TEMPLATE_LIBRARY):
+    assert len(_orbit_keys(tmpl["mask"])) == 8
+    assert bool(tmpl["mask"][tmpl["port_cell"]])
+    gr = tmpl["port_cell"][0] + tmpl["port_dir"][0]
