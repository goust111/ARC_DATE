        out.append(b)
        out.append(np.fliplr(b))
    uniq=[]; seen=set()
    for x in out:
        key=(x.shape,x.tobytes())
        if key not in seen:
            seen.add(key); uniq.append(x)
    return uniq

def key(a):
    ks=[]
    for x in vars(a): ks.append((x.shape,x.tobytes()))
    return min(ks)

