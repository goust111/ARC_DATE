+    paste,
+    random_free_location,
+)
+
+
+BG = Color.BLACK
+RED = Color.RED
+GREEN = Color.GREEN
+YELLOW = Color.YELLOW
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ORIENTATIONS = [(rot, flip) for rot in range(4) for flip in (False, True)]
+GEN_RETRIES = 400
