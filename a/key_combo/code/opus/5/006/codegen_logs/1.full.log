+    start_positions = [(int(start_info["tip"][0] - 1), int(start_info["tip"][1]))]
+    rays, order = _simulate_network(
+        active_shapes,
+        grid_shape,
+        start_positions,
+        start_info["dir"],
+        blocker_mask=np.zeros(grid_shape, dtype=bool),
