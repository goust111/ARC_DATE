+        "template": template,
+        "orient": orient,
+        "base_dir": template["port_dir"],
+        "actual_dir": actual_dir,
+        "port_cell_t": port_cell_t,
+        "mask_small": oriented_mask,
+        "mask": large_mask,
+        "patch": patch,
+        "color": int(color),
+        "k": int(k),
+    }
