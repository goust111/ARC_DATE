+                "port_cell_t": cand["port_cell_t"],
+                "actual_dir": cand["actual_dir"],
+                "base_dir": tmpl["port_dir"],
+            }
+        )
+
+    blocker = (g != bg) & (g != RED) & (g != YELLOW) & (g != GREEN)
+    for obj in large_infos:
+        for r, c in obj["coords"]:
