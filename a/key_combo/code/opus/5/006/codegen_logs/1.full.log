+    gr = tmpl["port_cell"][0] + tmpl["port_dir"][0]
+    gc = tmpl["port_cell"][1] + tmpl["port_dir"][1]
+    assert not in_bounds(tmpl["mask"].shape, gr, gc) or not bool(tmpl["mask"][gr, gc])
+    for jdx in range(idx):
