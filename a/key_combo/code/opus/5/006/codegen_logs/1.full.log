+    {
+        "coords": [(0, 0), (0, 1), (0, 2), (1, 0), (1, 1)],
+        "port_cell": (1, 1),
+        "port_dir": (1, 0),
+    },
+    {
+        "coords": [(0, 0), (0, 1), (0, 2), (1, 2), (1, 3)],
+        "port_cell": (1, 3),
+        "port_dir": (1, 0),
+    },
+    {
+        "coords": [(0, 0), (0, 1), (1, 1), (1, 2), (2, 1)],
+        "port_cell": (0, 0),
+        "port_dir": (0, -1),
+    },
+]
