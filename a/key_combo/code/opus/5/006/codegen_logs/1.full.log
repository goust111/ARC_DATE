+    for patch in template_patches:
+        r0, c0 = random_free_location(
+            occ.astype(int),
+            patch,
+            transparent=BG,
+            border=1,
+            padding=1,
+        )
+        paste(grid, patch, r0, c0, transparent=BG)
+        occ = grid != BG
