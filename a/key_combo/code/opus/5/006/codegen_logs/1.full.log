+                    "orient": orient,
+                    "mask": _apply_orientation(tmpl["mask"], orient),
+                    "port_cell_t": _transform_point(tmpl["mask"].shape, tmpl["port_cell"], orient),
+                    "actual_dir": _transform_dir(tmpl["port_dir"], orient),
