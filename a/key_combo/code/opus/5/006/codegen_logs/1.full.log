import itertools, numpy as np

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0,c0=min(rs),min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

def connected(cells):
    cells=set(cells); stack=[next(iter(cells))]; seen=set()
    while stack:
        p=stack.pop();
        if p in seen: continue
        seen.add(p)
        r,c=p
        for q in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]:
            if q in cells and q not in seen: stack.append(q)
    return len(seen)==len(cells)

def arr(cells):
    cells=norm(cells)
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    a=np.zeros((max(rs)+1,max(cs)+1),dtype=int)
    for r,c in cells: a[r,c]=1
    return a

def vars(a):
    out=[]
    for k in range(4):
