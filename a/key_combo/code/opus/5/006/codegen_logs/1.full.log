+    for spec in active_specs[1:]:
+        prev = active_shapes[-1]
+        starts = _port_starts(prev["bbox"], prev["port_cell_t"], prev["actual_dir"], k)
+        loc = _find_target_placement(occ, spec, starts, prev["actual_dir"], grid_shape)
+        if loc is None:
