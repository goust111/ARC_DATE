+def _instance_is_semantic(grid: np.ndarray) -> bool:
+    info = _analyze_input(grid)
+    start = info["start"]
+    start_positions = [(int(start["tip"][0] + start["dir"][0]), int(start["tip"][1] + start["dir"][1]))]
+    red_cells, order = _simulate_network(
