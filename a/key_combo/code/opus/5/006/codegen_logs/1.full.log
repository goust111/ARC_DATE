+    h, w = map(int, shape)
+    blocker_mask = (
+        np.zeros((h, w), dtype=bool) if blocker_mask is None else blocker_mask.astype(bool)
+    )
+    obj_id = np.full((h, w), -1, dtype=int)
+    for idx, obj in enumerate(shape_infos):
+        for r, c in obj["coords"]:
