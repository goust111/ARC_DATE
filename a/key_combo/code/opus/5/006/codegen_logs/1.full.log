+TEMPLATE_LIBRARY: list[dict] = []
+for spec in RAW_TEMPLATE_SPECS:
+    mask = _mask_from_coords(spec["coords"])
+    TEMPLATE_LIBRARY.append(
+        {
+            "mask": mask,
+            "port_cell": tuple(map(int, spec["port_cell"])),
+            "port_dir": tuple(map(int, spec["port_dir"])),
