+            hit_ids = {int(obj_id[r, c]) for r, c in inb if int(obj_id[r, c]) >= 0}
+            blocked = [(r, c) for r, c in inb if int(obj_id[r, c]) < 0 and blocker_mask[r, c]]
+            assert not (hit_ids and blocked)
+            for r, c in inb:
