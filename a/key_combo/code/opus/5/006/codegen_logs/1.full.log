+        patch, start_info = _start_patch(grid_shape, start_col, seg_len)
+        start_cells = {(int(r), int(start_col)) for r in range(h - seg_len - 1, h)}
+        if any((r, c) in start_cells for r, c in candidate["coords"]):
+            continue
+        placed_first = candidate
