 504: def _gen_attempt() -> np.ndarray | None:
 505:     """Single attempt to generate a valid input grid. Returns None on placement failure."""
 506:     H = random.randint(H_MIN, H_MAX)
 507:     W = random.randint(W_MIN, W_MAX)
 508:     inp = np.full((H, W), BG, dtype=int)
 509:     out = np.full((H, W), BG, dtype=int)
 510:     occupied = np.zeros((H, W), dtype=bool)
 511:     blue_mask = np.zeros((H, W), dtype=bool)
 512:     ray_mask = np.zeros((H, W), dtype=bool)
 513: 
 514:     # Place start segment (yellow cap + red column at bottom)
 515:     start_h = random.randint(START_H_MIN, START_H_MAX)
 516:     cap_r = H - start_h - 1
 517:     start_col = random.randint(START_COL_PAD, W - START_COL_PAD - 1)
 518:     inp[cap_r, start_col] = YELLOW
 519:     out[cap_r, start_col] = RED
 520:     ray_mask[cap_r, start_col] = True
 521:     occupied[cap_r, start_col] = True
 522:     for r in range(cap_r + 1, H):
 523:         inp[r, start_col] = RED
 524:         out[r, start_col] = RED
 525:         occupied[r, start_col] = True
 526: 
 527:     # Decide chain length and distractor count
 528:     chain_len = random.choices(range(len(CHAIN_LEN_WEIGHTS)), weights=CHAIN_LEN_WEIGHTS)[0]
 529:     min_dist = 1 if chain_len == 0 else 0
 530:     max_dist = min(MAX_DISTRACTORS, MAX_BLOB_COUNT - chain_len)
 531:     num_distractors = random.randint(min_dist, max_dist)
 532: 
 533:     # Build cascade chain
 534:     starts = [(cap_r, start_col)]
 535:     direction = UP
 536:     include_origin = True
 537:     for _ in range(chain_len):
 538:         blob = _candidate_next_blob(H, W, starts, direction, include_origin, occupied, blue_mask, ray_mask)
 539:         if blob is None:
 540:             return None
 541:         _mark_ray(out, ray_mask, blob["path"])
 542:         _place_blob(inp, occupied, blue_mask, blob)
 543:         paint_coords(out, blob["blue"], RED)
 544:         starts = blob["ports"]
 545:         direction = blob["spec"]["port_dir"]
 546:         include_origin = False
 547: 
 548:     # Final ray to grid boundary
 549:     final_path = _path_to_boundary(starts, direction, include_origin, H, W)
 550:     if any(blue_mask[r, c] for r, c in final_path):
 551:         return None
 552:     _mark_ray(out, ray_mask, final_path)
 553: 
 554:     # Place distractors
 555:     for _ in range(num_distractors):
 556:         if not _place_distractor(inp, occupied, blue_mask, ray_mask):
 557:             return None
 558: 
 559:     # Oracle check
 560:     if not np.array_equal(main(inp), out):
 561:         return None
 562:     return inp
 563: 
