 199: # --- layout generation -------------------------------------------------------
 200: 
 201: def _canonical_shape_key(mask: np.ndarray) -> bytes:
 202:     """Canonical bytes representation under D4 for a bool mask (tight-cropped)."""
 203:     variants = []
 204:     for kk in range(4):
 205:         r = np.rot90(mask, kk)
 206:         variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))
 207:         fr = np.fliplr(r)
 208:         variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))
 209:     return min(variants)
 210: 
 211: 
 212: def _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:
 213:     """Grow a 4-conn slot of given size starting from a random free cell.
 214:     `forbidden` marks cells that must not be used. Returns coords array or None.
 215:     """
 216:     H, W = forbidden.shape
 217:     free_cells = np.argwhere(~forbidden)
 218:     if free_cells.size == 0:
 219:         return None
 220:     random.shuffle(free_cells)
 221:     for start in free_cells[:GROW_SEED_TRIES]:
 222:         r0, c0 = int(start[0]), int(start[1])
 223:         chosen = {(r0, c0)}
 224:         frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}
 225:         while len(chosen) < target_size and frontier:
 226:             cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W
 227:                      and not forbidden[p[0], p[1]] and p not in chosen]
 228:             if not cands:
 229:                 break
 230:             nr, nc = random.choice(cands)
 231:             chosen.add((nr, nc))
 232:             frontier.discard((nr, nc))
 233:             frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})
 234:         if len(chosen) == target_size:
 235:             return np.array(sorted(chosen))
 236:     return None
 237: 
 238: 
 239: def _dilate8(mask: np.ndarray) -> np.ndarray:
 240:     """Dilate a bool mask by 1 cell (8-connectivity)."""
 241:     out = mask.copy()
 242:     out[:-1, :] |= mask[1:, :]
 243:     out[1:, :] |= mask[:-1, :]
 244:     out[:, :-1] |= mask[:, 1:]
 245:     out[:, 1:] |= mask[:, :-1]
 246:     out[:-1, :-1] |= mask[1:, 1:]
 247:     out[1:, 1:] |= mask[:-1, :-1]
 248:     out[:-1, 1:] |= mask[1:, :-1]
 249:     out[1:, :-1] |= mask[:-1, 1:]
 250:     return out
 251: 
 252: 
 253: def _forbid_coords(forbidden: np.ndarray, coords: np.ndarray) -> None:
 254:     """Mark coords and their 8-neighbors as forbidden (in-place)."""
 255:     cell_mask = np.zeros_like(forbidden)
 256:     cell_mask[coords[:, 0], coords[:, 1]] = True
 257:     forbidden |= _dilate8(cell_mask)
 258: 
 259: 
 260: def _gen_layout(h: int, w: int, n_slots: int, n_units: int) -> list[dict] | None:
 261:     """Generate a layout grid with n_slots 4-connected slots (including n_units unit slots).
 262:     Returns list of {coords, area, mask, shape_key} or None on failure.
 263:     Unit slots appear first in the returned list.
 264:     """
 265:     forbidden = np.zeros((h, w), dtype=bool)
 266:     slots: list[dict] = []
 267:     used_shape_keys: set[bytes] = set()
 268: 
 269:     # Place unit slots first (trivially small, easy to fit)
 270:     for _ in range(n_units):
 271:         for _ in range(UNIT_SLOT_RETRIES):
 272:             coords = _grow_slot(forbidden, 1)
 273:             if coords is not None:
 274:                 slots.append({"coords": coords, "area": 1})
 275:                 _forbid_coords(forbidden, coords)
 276:                 break
 277:         else:
 278:             return None
 279: 
 280:     # Place non-unit slots with distinct D4 shapes
 281:     for _ in range(n_slots - n_units):
 282:         size = random.choice(NON_UNIT_SIZE_CHOICES)
 283:         for _ in range(NON_UNIT_SLOT_RETRIES):
 284:             coords = _grow_slot(forbidden, size)
 285:             if coords is None:
 286:                 continue
 287:             r0, c0 = coords.min(axis=0)
 288:             r1, c1 = coords.max(axis=0)
 289:             sm = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
 290:             sm[coords[:, 0] - r0, coords[:, 1] - c0] = True
 291:             key = _canonical_shape_key(sm)
 292:             if key in used_shape_keys:
 293:                 continue
 294:             used_shape_keys.add(key)
 295:             slots.append({"coords": coords, "area": size, "mask": sm, "shape_key": key})
 296:             _forbid_coords(forbidden, coords)
 297:             break
 298:         else:
 299:             return None
 300: 
 301:     # Validate hole density
 302:     density = sum(s["area"] for s in slots) / (h * w)
 303:     lo, hi = HOLE_DENSITY_RANGE
 304:     if not (lo <= density <= hi):
 305:         return None
 306: 
 307:     return slots
 308: 
 309: 
 310: # --- piece construction ------------------------------------------------------
 311: 
 312: def _make_piece(slot: dict, color: int, k: int, apply_dihedral: bool) -> dict:
 313:     """Build output and input patches for one slot.
 314:     For unit slots (area=1), the piece is a solid k*k square with no dihedral
 315:     transform needed. For non-unit slots, a random dihedral is applied to the
 316:     input-side patch.
 317:     """
 318:     if slot["area"] == 1:
 319:         patch = np.full((k, k), color, dtype=int)
 320:         mask = np.ones((k, k), dtype=bool)
 321:         return {"color": color, "slot": slot,
 322:                 "out_patch": patch, "out_mask": mask,
 323:                 "in_patch": patch, "in_mask": mask}
 324: 
 325:     out_mask = np.kron(slot["mask"], np.ones((k, k), dtype=bool))
 326:     out_patch = np.where(out_mask, color, 0).astype(int)
 327: 
 328:     if apply_dihedral:
 329:         rot = random.randint(0, 3)
 330:         in_mask = np.rot90(out_mask, rot)
 331:         in_patch = np.rot90(out_patch, rot)
 332:         if random.random() < 0.5:
 333:             in_mask = np.fliplr(in_mask)
 334:             in_patch = np.fliplr(in_patch)
 335:     else:
 336:         in_mask, in_patch = out_mask, out_patch
 337: 
 338:     return {"color": color, "slot": slot,
 339:             "out_patch": out_patch, "out_mask": out_mask,
 340:             "in_patch": in_patch, "in_mask": in_mask}
 341: 
 342: 
 343: # --- output assembly ---------------------------------------------------------
 344: 
 345: def _build_expected_output(pieces: list[dict], layout_h: int, layout_w: int,
 346:                            k: int, frame_color: int) -> np.ndarray:
 347:     """Assemble the expected output grid: frame_color background with pieces placed."""
 348:     out = np.full(((layout_h + 2) * k, (layout_w + 2) * k), frame_color, dtype=int)
 349:     for p in pieces:
 350:         coords = p["slot"]["coords"]
 351:         top = (int(coords[:, 0].min()) + 1) * k
 352:         left = (int(coords[:, 1].min()) + 1) * k
 353:         paste(out, p["out_patch"], top, left, mask=p["out_mask"], overwrite=True)
 354:     return out
 355: 
 356: 
 357: # --- input canvas assembly ---------------------------------------------------
 358: 
 359: def _build_input_canvas(pieces: list[dict], layout_mask: np.ndarray,
 360:                         layout_h: int, layout_w: int, k: int,
 361:                         frame_color: int, distractor_color: int) -> np.ndarray | None:
 362:     """Build the input grid: frame + scattered pieces + distractor noise.
 363:     Returns canvas or None if placement fails.
 364:     """
 365:     frame_h, frame_w = layout_h + 2, layout_w + 2
 366:     total_piece_area = sum(int(p["in_mask"].sum()) for p in pieces)
 367:     needed_cells = frame_h * frame_w + AREA_BUFFER_MULT * total_piece_area + AREA_BUFFER_CONST
 368: 
 369:     # Canvas dimensions: start random within spec range, grow if area insufficient
 370:     min_h = max(CANVAS_DIM_RANGE[0], frame_h + 2)
 371:     min_w = max(CANVAS_DIM_RANGE[0], frame_w + 2)
 372:     canvas_h = random.randint(min_h, CANVAS_DIM_RANGE[1])
 373:     canvas_w = random.randint(min_w, CANVAS_DIM_RANGE[1])
 374:     while canvas_h * canvas_w < needed_cells and (canvas_h < CANVAS_DIM_RANGE[1] or canvas_w < CANVAS_DIM_RANGE[1]):
 375:         if canvas_h <= canvas_w and canvas_h < CANVAS_DIM_RANGE[1]:
 376:             canvas_h += 1
 377:         elif canvas_w < CANVAS_DIM_RANGE[1]:
 378:             canvas_w += 1
 379:         else:
 380:             break
 381:     if canvas_h * canvas_w < needed_cells:
 382:         return None
 383: 
 384:     canvas = np.zeros((canvas_h, canvas_w), dtype=int)
 385: 
 386:     # Build and place the frame (1-cell border of frame_color around the layout)
 387:     frame_img = np.full((frame_h, frame_w), frame_color, dtype=int)
 388:     frame_img[1:-1, 1:-1] = np.where(layout_mask, 0, frame_color)
 389:     fr_max, fc_max = canvas_h - frame_h - 1, canvas_w - frame_w - 1
 390:     if fr_max < 1 or fc_max < 1:
 391:         return None
 392:     paste(canvas, frame_img, random.randint(1, fr_max), random.randint(1, fc_max))
 393: 
 394:     # Place pieces outside the frame, largest-first for better packing
 395:     for p in sorted(pieces, key=lambda p: -int(p["in_mask"].sum())):
 396:         try:
 397:             pr, pc = random_free_location(
 398:                 canvas, p["in_patch"],
 399:                 transparent=0, border=0, padding=1, padding_connectivity=8,
 400:             )
 401:         except ValueError:
 402:             return None
 403:         paste(canvas, p["in_patch"], pr, pc, mask=p["in_mask"], overwrite=True)
 404: 
 405:     # Scatter distractor singletons (isolated single pixels in a dedicated color)
 406:     n_distractors = random.randint(*DISTRACTOR_RANGE)
 407:     placed = 0
 408:     for _ in range(n_distractors * DISTRACTOR_RETRY_MULT):
 409:         if placed >= n_distractors:
 410:             break
 411:         rr, cc = random.randint(0, canvas_h - 1), random.randint(0, canvas_w - 1)
 412:         if canvas[rr, cc] != 0:
 413:             continue
 414:         r_lo, r_hi = max(0, rr - 1), min(canvas_h, rr + 2)
 415:         c_lo, c_hi = max(0, cc - 1), min(canvas_w, cc + 2)
 416:         if np.any(canvas[r_lo:r_hi, c_lo:c_hi] != 0):
 417:             continue
 418:         canvas[rr, cc] = distractor_color
 419:         placed += 1
 420:     if placed < MIN_DISTRACTORS:
 421:         return None
 422: 
 423:     # bg=0 must remain the most common color for solver's get_bg
 424:     vals, counts = np.unique(canvas, return_counts=True)
 425:     if int(vals[np.argmax(counts)]) != 0:
 426:         return None
 427: 
 428:     return canvas
 429: 
 430: 
 431: # --- main generator attempt --------------------------------------------------
 432: 
 433: def _gen_attempt() -> np.ndarray | None:
 434:     k = random.choice(K_CHOICES)
 435:     layout_h = random.randint(*LAYOUT_H_RANGE)
 436:     layout_w = random.randint(*LAYOUT_W_RANGE)
 437:     n_slots = random.randint(*N_SLOTS_RANGE)
 438:     n_units = random.randint(1, min(N_UNITS_MAX, n_slots - 1))
 439: 
 440:     # Allocate colors: frame, distractor, then per-piece
 441:     palette = list(range(1, 10))
 442:     random.shuffle(palette)
 443:     frame_color = palette.pop()
 444:     distractor_color = palette.pop()
 445:     needed_piece_colors = (n_slots - n_units) + 1  # +1 shared unit color
 446:     if len(palette) < needed_piece_colors:
 447:         return None
 448:     non_unit_colors = palette[:n_slots - n_units]
 449:     unit_color = palette[n_slots - n_units]
 450: 
 451:     # Build layout
 452:     slots = _gen_layout(layout_h, layout_w, n_slots, n_units)
 453:     if slots is None:
 454:         return None
 455:     unit_slots = slots[:n_units]
 456:     non_unit_slots = slots[n_units:]
 457: 
 458:     # Validate that holes touch all 4 borders (so solver's tight-crop matches our layout)
 459:     layout_mask = np.zeros((layout_h, layout_w), dtype=bool)
 460:     for s in slots:
 461:         layout_mask[s["coords"][:, 0], s["coords"][:, 1]] = True
 462:     if not (layout_mask[0].any() and layout_mask[-1].any()
 463:             and layout_mask[:, 0].any() and layout_mask[:, -1].any()):
 464:         return None
 465: 
 466:     # Build pieces
 467:     pieces = [_make_piece(s, non_unit_colors[i], k, apply_dihedral=True)
 468:               for i, s in enumerate(non_unit_slots)]
 469:     pieces += [_make_piece(s, unit_color, k, apply_dihedral=False)
 470:                for s in unit_slots]
 471: 
 472:     # Build expected output
 473:     expected_out = _build_expected_output(pieces, layout_h, layout_w, k, frame_color)
 474: 
 475:     # Build input canvas
 476:     canvas = _build_input_canvas(pieces, layout_mask, layout_h, layout_w, k,
 477:                                  frame_color, distractor_color)
 478:     if canvas is None:
 479:         return None
 480: 
 481:     # Oracle check
 482:     try:
 483:         produced = main(canvas)
 484:     except Exception:
 485:         return None
 486:     if not np.array_equal(produced, expected_out):
 487:         return None
 488: 
 489:     return canvas
 490: 
 491: 
 492: def generate_input() -> np.ndarray:
 493:     for _ in range(GENERATE_MAX_RETRIES):
 494:         res = _gen_attempt()
 495:         if res is not None:
 496:             return res
 497:     raise RuntimeError("generate_input: failed to generate after %d attempts" % GENERATE_MAX_RETRIES)

