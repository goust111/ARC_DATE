  59: 
  60: # Canvas and palette.
  61: GRID_SIZE = 16
  62: BACKGROUND_COLOR = 7
  63: FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
  64: INPUT_SIDE_FROM_OUTPUT = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
  65: # Object and side sampling.
  66: SQUARE_COUNT_RANGE = (3, 5)
  67: BASE_OUTPUT_SIDE_CHOICES = [1, 3, 5]
  68: OUTPUT_SIDE_7_PROB = 0.45
  69: OUTPUT_SIDE_9_PROB = 0.35
  70: # Placement and retry policy.
