 469: def _place_blob(
 470:     inp: np.ndarray, occupied: np.ndarray, blue_mask: np.ndarray, blob: dict,
 471: ) -> None:
 472:     """Paste a blob's patch onto the input grid and update tracking masks."""
 473:     paste(inp, blob["spec"]["patch"], blob["r0"], blob["c0"], transparent=BG)
 474:     for r, c in blob["full"]:
 475:         occupied[r, c] = True
 476:     for r, c in blob["blue"]:
 477:         blue_mask[r, c] = True
 478: 
