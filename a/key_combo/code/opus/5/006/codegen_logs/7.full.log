 347: def _path_to_boundary(
 348:     starts: list[tuple[int, int]], d: tuple[int, int],
 349:     include_origin: bool, H: int, W: int,
 350: ) -> list[tuple[int, int]]:
 351:     """Trace ray lanes from starts to grid boundary."""
 352:     dr, dc = d
 353:     cells: list[tuple[int, int]] = []
 354:     for r, c in starts:
 355:         if include_origin:
 356:             cells.append((r, c))
 357:         while True:
 358:             r, c = r + dr, c + dc
 359:             if not (0 <= r < H and 0 <= c < W):
 360:                 break
 361:             cells.append((r, c))
 362:     return cells
