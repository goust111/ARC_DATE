 189: def _sprite_patch(
 190:     direction: tuple[int, int], body_color: int, marker_color: int,
 191: ) -> tuple[np.ndarray, int, int]:
 192:     """Build a small patch array for the sprite; returns (patch, row_offset, col_offset)."""
 193:     min_r, max_r, min_c, max_c = _SPRITE_EXTENT[direction]
 194:     patch = np.full((max_r - min_r + 1, max_c - min_c + 1), -1, dtype=int)
 195:     for dr, dc in BODY_REL[direction]:
 196:         patch[dr - min_r, dc - min_c] = body_color
 197:     patch[-min_r, -min_c] = marker_color
 198:     return patch, min_r, min_c
