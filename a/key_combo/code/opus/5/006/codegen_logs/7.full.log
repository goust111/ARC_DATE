  35: def main(grid: np.ndarray) -> np.ndarray:
  36:     """
  37:     Extend each colored marker from its directional sprite to a grid edge, painting a dotted ray and the whole edge side.
  38: 
  39:     Input structure:
  40:     - The background is the dominant color.
  41:     - One repeated body color forms small 8-connected directional sprites.
  42:     - Each marker is a singleton non-background, non-body color embedded in one sprite.
  43: 
  44:     Rule:
  45:     - The body pixels around a marker lie mostly behind it; the opposite direction is the marker's ray direction.
  46:     - Paint every second pixel from the marker along that ray, then paint the entire boundary side reached by the ray.
  47:     - If two painted boundary sides meet at a corner, make that shared corner black.
  48: 
  49:     Key insight:
  50:     - The same seven-pixel body sprite rotates to encode the direction; its local center-of-mass bias points away from the ray.
  51:     """
  52:     g = np.asarray(grid, dtype=int)
  53:     H, W = g.shape
  54:     bg = int(get_bg(g))
  55:     counts = Counter(map(int, g.ravel()))
  56: 
  57:     body_candidates = [color for color, count in counts.items() if int(color) != bg and int(count) > 1]
  58:     assert len(body_candidates) == 1
  59:     body_color = int(body_candidates[0])
  60: 
  61:     markers: list[tuple[int, int, int]] = []
  62:     for color, count in counts.items():
  63:         color = int(color)
  64:         if color == bg or color == body_color:
  65:             continue
  66:         assert int(count) == 1
  67:         coords = np.argwhere(g == color)
  68:         assert coords.shape == (1, 2)
  69:         r, c = map(int, coords[0])
  70:         markers.append((color, r, c))
  71: 
  72:     assert markers
  73:     out = g.copy()
  74:     directions: dict[tuple[int, int], int] = {}
  75: 
  76:     for color, r, c in markers:
  77:         direction = _marker_direction(g, body_color, r, c)
  78:         assert direction in VALID_DIRECTIONS
  79:         assert direction not in directions
  80:         directions[direction] = int(color)
  81: 
  82:         dr, dc = direction
  83:         rr, cc = int(r + 2 * dr), int(c + 2 * dc)
  84:         while 0 <= rr < H and 0 <= cc < W:
  85:             assert int(g[rr, cc]) == bg
  86:             out[rr, cc] = int(color)
  87:             rr += int(2 * dr)
  88:             cc += int(2 * dc)
  89: 
  90:         if direction == (-1, 0):
  91:             assert np.all(g[0, :] == bg)
  92:             out[0, :] = int(color)
  93:         elif direction == (1, 0):
  94:             assert np.all(g[H - 1, :] == bg)
  95:             out[H - 1, :] = int(color)
  96:         elif direction == (0, -1):
  97:             assert np.all(g[:, 0] == bg)
  98:             out[:, 0] = int(color)
  99:         elif direction == (0, 1):
 100:             assert np.all(g[:, W - 1] == bg)
 101:             out[:, W - 1] = int(color)
 102: 
 103:     if (-1, 0) in directions and (0, -1) in directions:
 104:         out[0, 0] = 0
 105:     if (-1, 0) in directions and (0, 1) in directions:
 106:         out[0, W - 1] = 0
 107:     if (1, 0) in directions and (0, -1) in directions:
 108:         out[H - 1, 0] = 0
 109:     if (1, 0) in directions and (0, 1) in directions:
 110:         out[H - 1, W - 1] = 0
 111: 
 112:     return out
