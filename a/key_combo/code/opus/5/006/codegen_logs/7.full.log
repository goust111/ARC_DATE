 116: # ── CFG ──────────────────────────────────────────────────────────────────
 117: H_RANGE = (11, 15)         # grid height bounds (inclusive)
 118: W_RANGE = (12, 17)         # grid width bounds (inclusive)
 119: MARKER_COUNT_RANGE = (1, 3)  # number of marker sprites per grid
 120: EDGE_GAP = 1               # min cells between sprite bbox and grid edge
 121: GEN_RETRIES = 300           # max attempts before raising RuntimeError
 122: 
 123: # ── Sprite geometry ──────────────────────────────────────────────────────
 124: DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
 125: 
 126: # 7 body-pixel offsets relative to the marker center, keyed by ray direction.
 127: BODY_REL = {
 128:     (-1, 0): [(0, -2), (0, -1), (0, 1), (0, 2), (1, -1), (1, 0), (1, 1)],
 129:     (1, 0): [(-1, -1), (-1, 0), (-1, 1), (0, -2), (0, -1), (0, 1), (0, 2)],
 130:     (0, -1): [(-2, 0), (-1, 0), (-1, 1), (0, 1), (1, 0), (1, 1), (2, 0)],
 131:     (0, 1): [(-2, 0), (-1, -1), (-1, 0), (0, -1), (1, -1), (1, 0), (2, 0)],
 132: }
 133: 
 134: # Pre-computed sprite bbox extents (min_r, max_r, min_c, max_c) per direction.
 135: _SPRITE_EXTENT: dict[tuple[int, int], tuple[int, int, int, int]] = {}
 136: for _d, _rels in BODY_REL.items():
 137:     _all = _rels + [(0, 0)]
 138:     _SPRITE_EXTENT[_d] = (
 139:         min(dr for dr, _ in _all), max(dr for dr, _ in _all),
 140:         min(dc for _, dc in _all), max(dc for _, dc in _all),
 141:     )
