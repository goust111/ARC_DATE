  76: def _bbox(center_r, center_c, side):
  77:     d = side // 2
  78:     return center_r - d, center_c - d, center_r + d, center_c + d
  79: 
  80: 
  81: def _separated(a, b, gap=0):
  82:     return (
  83:         a[2] + gap + 1 <= b[0]
  84:         or b[2] + gap + 1 <= a[0]
  85:         or a[3] + gap + 1 <= b[1]
  86:         or b[3] + gap + 1 <= a[1]
  87:     )
  88: 
  89: 
  90: def _clear(rect, rects, gap=0):
  91:     return all(_separated(rect, other, gap) for other in rects)
