 100: def _choose_output_sides(count):
 101:     sides = [random.choice(BASE_OUTPUT_SIDE_CHOICES) for _ in range(count)]
 102:     slots = list(range(count))
 103:     random.shuffle(slots)
 104: 
 105:     if random.random() < OUTPUT_SIDE_7_PROB:
 106:         sides[slots.pop()] = 7
 107:     if slots and random.random() < OUTPUT_SIDE_9_PROB:
 108:         sides[slots.pop()] = 9
 109: 
 110:     random.shuffle(sides)
 111:     return sides
