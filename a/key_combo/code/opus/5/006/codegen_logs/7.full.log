 170:         marker = _gen_marker(colors_by_corner[corner], bg, corner)
 171:         locs = _gen_valid_locations(inp, marker, bg)
 172:         if not locs:
 173:             return False
 174:         r0, c0 = random.choice(locs)
 175:         paste(inp, marker, r0, c0, transparent=bg)
 176:     return True
