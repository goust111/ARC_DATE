 162: def _render_grid(placed, box_index):
 163:     """Render one phase from placed tuples: 1 for output boxes, 2 for input boxes."""
 164:     grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
 165:     for item in placed:
