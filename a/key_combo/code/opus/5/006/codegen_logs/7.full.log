 231: def _shape_mask(h: int, w: int) -> np.ndarray:
 232:     """Build a boolean diamond/octagon mask for the given (h, w) shape."""
 233:     widths = _SHAPE_WIDTHS[(h, w)]
 234:     mask = np.zeros((h, w), dtype=bool)
 235:     for r, ww in enumerate(widths):
 236:         c0 = (w - ww) // 2
 237:         mask[r, c0 : c0 + ww] = True
 238:     return mask
 239: 
 240: 
 241: def _perp_value(rc: tuple[int, int], d: tuple[int, int]) -> int:
 242:     """Coordinate perpendicular to direction d (column for vertical, row for horizontal)."""
 243:     return rc[1] if d[0] else rc[0]
 244: 
 245: 
 246: def _along_value(rc: tuple[int, int], d: tuple[int, int]) -> int:
 247:     """Coordinate along direction d (row for vertical, column for horizontal)."""
 248:     return rc[0] if d[0] else rc[1]
 249: 
 250: 
 251: def _sort_on_ray(coords: list[tuple[int, int]], d: tuple[int, int]) -> list[tuple[int, int]]:
 252:     """Sort coordinates by their perpendicular value relative to direction d."""
 253:     return sorted(coords, key=lambda p: _perp_value(p, d))
 254: 
 255: 
 256: def _edge_offsets(mask: np.ndarray, d: tuple[int, int]) -> list[tuple[int, int]]:
 257:     """Return sorted mask-local coordinates on the edge facing direction d."""
 258:     pts = np.argwhere(mask)
 259:     axis = 0 if d in (UP, DOWN) else 1
 260:     extreme = pts[:, axis].min() if d in (UP, LEFT) else pts[:, axis].max()
 261:     keep = pts[:, axis] == extreme
 262:     return _sort_on_ray([(int(r), int(c)) for r, c in pts[keep]], d)
 263: 
