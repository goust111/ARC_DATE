 480: def _place_distractor(
 481:     inp: np.ndarray, occupied: np.ndarray, blue_mask: np.ndarray, ray_mask: np.ndarray,
 482: ) -> bool:
 483:     """Try to place a single distractor blob in free space. Return success."""
 484:     H, W = inp.shape
 485:     occ_pad = _dilate8(occupied)
 486:     candidates: list[dict] = []
 487:     for spec in _all_specs():
 488:         h, w = spec["mask"].shape
 489:         for r0 in range(H - h + 1):
 490:             for c0 in range(W - w + 1):
 491:                 full = _offset(spec["full"], r0, c0)
 492:                 if any(occ_pad[r, c] or ray_mask[r, c] for r, c in full):
 493:                     continue
 494:                 candidates.append({
 495:                     "spec": spec, "r0": r0, "c0": c0,
 496:                     "full": full, "blue": _offset(spec["blue"], r0, c0),
 497:                 })
 498:     if not candidates:
 499:         return False
 500:     _place_blob(inp, occupied, blue_mask, random.choice(candidates))
 501:     return True
