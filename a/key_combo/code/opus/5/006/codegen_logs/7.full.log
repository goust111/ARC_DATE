 106: def _gen_output(n: int, bg: int, colors_by_corner: dict[str, int]) -> np.ndarray:
 107:     out = np.full((n, n), int(bg), dtype=int)
 108:     arm = n // 2
 109:     out[0, :arm] = colors_by_corner["top_left"]
 110:     out[:arm, 0] = colors_by_corner["top_left"]
 111:     out[0, n - arm :] = colors_by_corner["top_right"]
 112:     out[:arm, n - 1] = colors_by_corner["top_right"]
 113:     out[n - arm :, 0] = colors_by_corner["bottom_left"]
 114:     out[n - 1, :arm] = colors_by_corner["bottom_left"]
 115:     out[n - arm :, n - 1] = colors_by_corner["bottom_right"]
 116:     out[n - 1, n - arm :] = colors_by_corner["bottom_right"]
 117:     return out
