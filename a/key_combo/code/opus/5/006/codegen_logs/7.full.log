 298: def _all_specs(port_dir: tuple[int, int] | None = None) -> list[dict]:
 299:     """Generate all valid blob specs, optionally filtered by port direction, in shuffled order."""
 300:     dirs = [port_dir] if port_dir is not None else list(DIRS)
 301:     out = [s for size in SHAPES for d in dirs if (s := _blob_spec(size, d)) is not None]
 302:     random.shuffle(out)
 303:     return out
