 151: def _gen_corner_colors(bg: int) -> dict[str, int]:
 152:     palette = [c for c in _GEN_COLOR_VALUES if c != int(bg)]
 153: 
 154:     if random.random() < _GEN_ALL_DISTINCT_COLOR_PROB:
 155:         colors = random.sample(palette, _GEN_DISTINCT_CORNER_COUNT)
 156:     else:
 157:         base = random.sample(palette, _GEN_REUSED_COLOR_BASE_COUNT)
 158:         repeated = random.choice(base)
 159:         colors = base + [repeated]
 160:         random.shuffle(colors)
 161:     return dict(zip(_GEN_CORNERS, colors))
