 128:     (-1, 0): [(0, -2), (0, -1), (0, 1), (0, 2), (1, -1), (1, 0), (1, 1)],
 129:     (1, 0): [(-1, -1), (-1, 0), (-1, 1), (0, -2), (0, -1), (0, 1), (0, 2)],
 130:     (0, -1): [(-2, 0), (-1, 0), (-1, 1), (0, 1), (1, 0), (1, 1), (2, 0)],
 131:     (0, 1): [(-2, 0), (-1, -1), (-1, 0), (0, -1), (1, -1), (1, 0), (2, 0)],
 132: }
 133: 
 134: # Pre-computed sprite bbox extents (min_r, max_r, min_c, max_c) per direction.
 135: _SPRITE_EXTENT: dict[tuple[int, int], tuple[int, int, int, int]] = {}
 136: for _d, _rels in BODY_REL.items():
 137:     _all = _rels + [(0, 0)]
 138:     _SPRITE_EXTENT[_d] = (
 139:         min(dr for dr, _ in _all), max(dr for dr, _ in _all),
 140:         min(dc for _, dc in _all), max(dc for _, dc in _all),
 141:     )
 142: 
 143: 
 144: def _sprite_cells(direction: tuple[int, int], r: int, c: int) -> set[tuple[int, int]]:
 145:     """Return the set of (row, col) occupied by the full sprite (body + marker)."""
 146:     return {(r, c)} | {(r + dr, c + dc) for dr, dc in BODY_REL[direction]}
 147: 
 148: 
 149: def _ray_cells(H: int, W: int, r: int, c: int, direction: tuple[int, int]) -> set[tuple[int, int]]:
 150:     """Return every cell from the marker outward along *direction* to the grid edge."""
 151:     dr, dc = direction
 152:     cells = set()
 153:     rr, cc = r + dr, c + dc
 154:     while 0 <= rr < H and 0 <= cc < W:
 155:         cells.add((rr, cc))
 156:         rr += dr
 157:         cc += dc
 158:     return cells
 159: 
 160: 
 161: def _center_ranges(H: int, W: int, direction: tuple[int, int]) -> tuple[range, range]:
 162:     """Valid marker-center row/col ranges ensuring EDGE_GAP from all grid edges."""
 163:     min_r, max_r, min_c, max_c = _SPRITE_EXTENT[direction]
 164:     return (range(EDGE_GAP - min_r, H - EDGE_GAP - max_r),
 165:             range(EDGE_GAP - min_c, W - EDGE_GAP - max_c))
 166: 
 167: 
 168: def _choose_center(
 169:     H: int, W: int, direction: tuple[int, int],
 170:     occupied: set[tuple[int, int]], reserved_rays: set[tuple[int, int]],
 171: ) -> tuple[int, int] | None:
 172:     """Pick a random valid marker center that avoids *occupied* and *reserved_rays*."""
 173:     candidates: list[tuple[int, int]] = []
 174:     rows, cols = _center_ranges(H, W, direction)
 175:     for r in rows:
 176:         for c in cols:
 177:             sprite = _sprite_cells(direction, r, c)
 178:             if sprite & occupied or sprite & reserved_rays:
 179:                 continue
 180:             ray = _ray_cells(H, W, r, c, direction)
 181:             if ray & occupied or ray & reserved_rays:
 182:                 continue
 183:             candidates.append((r, c))
 184:     if not candidates:
 185:         return None
 186:     return random.choice(candidates)
 187: 
 188: 
 189: def _sprite_patch(
 190:     direction: tuple[int, int], body_color: int, marker_color: int,
 191: ) -> tuple[np.ndarray, int, int]:
 192:     """Build a small patch array for the sprite; returns (patch, row_offset, col_offset)."""
 193:     min_r, max_r, min_c, max_c = _SPRITE_EXTENT[direction]
 194:     patch = np.full((max_r - min_r + 1, max_c - min_c + 1), -1, dtype=int)
 195:     for dr, dc in BODY_REL[direction]:
 196:         patch[dr - min_r, dc - min_c] = body_color
 197:     patch[-min_r, -min_c] = marker_color
 198:     return patch, min_r, min_c
 199: 
 200: 
 201: def _stamp_sprite(
 202:     grid: np.ndarray, keep: np.ndarray, direction: tuple[int, int],
 203:     r: int, c: int, body_color: int, marker_color: int,
 204: ) -> None:
 205:     """Render sprite onto *grid* and mark its cells in *keep*."""
 206:     patch, off_r, off_c = _sprite_patch(direction, body_color, marker_color)
 207:     paste(grid, patch, r + off_r, c + off_c, transparent=-1)
 208:     for rr, cc in _sprite_cells(direction, r, c):
 209:         keep[rr, cc] = True
