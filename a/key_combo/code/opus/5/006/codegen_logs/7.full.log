 114: def _sample_objects():
 115:     """Sample color and side specs, returning larger required footprints first."""
 116:     count = random.randint(*SQUARE_COUNT_RANGE)
 117:     colors = random.sample(FOREGROUND_COLORS, count)
 118:     out_sides = _choose_output_sides(count)
 119:     in_sides = [INPUT_SIDE_FROM_OUTPUT[s] for s in out_sides]
 120: 
 121:     # Keep the configured background as the solver's dominant color.
 122:     areas = [s * s for s in in_sides]
 123:     if GRID_SIZE * GRID_SIZE - sum(areas) <= max(areas):
 124:         return None
 125: 
 126:     objects = [
 127:         {"color": color, "out_side": out_side, "in_side": in_side}
 128:         for color, out_side, in_side in zip(colors, out_sides, in_sides)
 129:     ]
 130:     random.shuffle(objects)
 131:     objects.sort(key=lambda obj: (max(obj["out_side"], obj["in_side"]), obj["out_side"]), reverse=True)
 132:     return objects
