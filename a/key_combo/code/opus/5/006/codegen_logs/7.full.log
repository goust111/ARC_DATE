 182: from arc_utils import paint_coords
 183: 
 184: # --- Colors ---
 185: BG = 8
 186: BLUE = 1
 187: RED = 2
 188: GREEN = 3
 189: YELLOW = 4
 190: 
 191: # --- Directions ---
 192: UP = (-1, 0)
 193: DOWN = (1, 0)
 194: LEFT = (0, -1)
 195: RIGHT = (0, 1)
 196: DIRS = (UP, DOWN, LEFT, RIGHT)
 197: OPP = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}
 198: 
 199: # --- Diamond/octagon shapes (h, w) ---
 200: SHAPES = ((3, 4), (4, 4), (5, 4), (5, 6), (6, 6), (8, 8))
 201: _SHAPE_WIDTHS = {
 202:     (3, 4): (2, 4, 2),
 203:     (4, 4): (2, 4, 4, 2),
 204:     (5, 4): (2, 4, 4, 4, 2),
 205:     (5, 6): (2, 4, 6, 4, 2),
 206:     (6, 6): (2, 4, 6, 6, 4, 2),
 207:     (8, 8): (2, 4, 6, 8, 8, 6, 4, 2),
 208: }
 209: 
 210: # --- Canvas bounds ---
 211: H_MIN, H_MAX = 13, 27
 212: W_MIN, W_MAX = 15, 27
 213: START_COL_PAD = 2        # min distance from start column to grid edge
