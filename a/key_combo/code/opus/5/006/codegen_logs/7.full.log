 201: def _stamp_sprite(
 202:     grid: np.ndarray, keep: np.ndarray, direction: tuple[int, int],
 203:     r: int, c: int, body_color: int, marker_color: int,
 204: ) -> None:
 205:     """Render sprite onto *grid* and mark its cells in *keep*."""
 206:     patch, off_r, off_c = _sprite_patch(direction, body_color, marker_color)
 207:     paste(grid, patch, r + off_r, c + off_c, transparent=-1)
 208:     for rr, cc in _sprite_cells(direction, r, c):
 209:         keep[rr, cc] = True
