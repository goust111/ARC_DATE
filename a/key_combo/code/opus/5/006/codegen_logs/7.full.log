   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Cycle each solid odd-sided square to the next smaller centered square, wrapping a single pixel to a 9x9 square.
  10: 
  11:     Input structure:
  12:     - The grid has one dominant background color.
  13:     - Every foreground object is a separated 4-connected monochrome solid square.
  14:     - Square side lengths are odd and belong to the cycle 1, 3, 5, 7, 9.
  15: 
  16:     Rule:
  17:     - Clear the canvas to the background.
  18:     - Keep each square's color and center.
  19:     - Replace side length n by n - 2 when n > 1; replace side length 1 by side length 9.
  20: 
  21:     Key insight:
  22:     - The visible operation is on square size, not color: side lengths cycle 1 -> 9 -> 7 -> 5 -> 3 -> 1.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     bg = get_bg(g)
  26:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
  27:     assert components, "expected at least one foreground square"
  28: 
  29:     out = np.full_like(g, bg)
  30:     painted = np.zeros(g.shape, dtype=bool)
  31:     H, W = g.shape
  32: 
  33:     for obj in components:
  34:         color = int(obj["color"])
  35:         r0, c0, r1, c1 = obj["bbox"]
  36:         side = int(r1 - r0 + 1)
  37:         assert side == int(c1 - c0 + 1), "foreground object must have a square bbox"
  38:         assert side in {1, 3, 5, 7, 9}, "square side length must be in the odd-size cycle"
  39:         assert int(obj["area"]) == side * side, "foreground object must fill its bbox"
  40:         assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "foreground object must be solid"
  41: 
  42:         new_side = 9 if side == 1 else side - 2
  43:         center_r = int((r0 + r1) // 2)
  44:         center_c = int((c0 + c1) // 2)
  45:         nr0 = center_r - new_side // 2
  46:         nc0 = center_c - new_side // 2
  47:         nr1 = nr0 + new_side
  48:         nc1 = nc0 + new_side
  49:         assert 0 <= nr0 < nr1 <= H and 0 <= nc0 < nc1 <= W, "transformed square must fit in the grid"
  50: 
  51:         region = (slice(nr0, nr1), slice(nc0, nc1))
  52:         assert not painted[region].any(), "transformed squares must not overlap"
  53:         out[region] = color
  54:         painted[region] = True
  55: 
