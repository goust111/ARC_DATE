 239:     if (-1, 0) in directions and (0, 1) in directions:
 240:         out[0, W - 1] = 0
 241:     if (1, 0) in directions and (0, -1) in directions:
 242:         out[H - 1, 0] = 0
 243:     if (1, 0) in directions and (0, 1) in directions:
 244:         out[H - 1, W - 1] = 0
