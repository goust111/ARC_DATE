 212: def _paint_output(
 213:     out: np.ndarray, marker_color: int, r: int, c: int, direction: tuple[int, int],
 214: ) -> None:
 215:     """Paint the dotted ray and fill the target boundary row/col."""
 216:     H, W = out.shape
 217:     dr, dc = direction
 218:     rr, cc = r + 2 * dr, c + 2 * dc
 219:     while 0 <= rr < H and 0 <= cc < W:
 220:         out[rr, cc] = marker_color
 221:         rr += 2 * dr
 222:         cc += 2 * dc
 223: 
 224:     if direction == (-1, 0):
 225:         out[0, :] = marker_color
 226:     elif direction == (1, 0):
 227:         out[H - 1, :] = marker_color
 228:     elif direction == (0, -1):
 229:         out[:, 0] = marker_color
 230:     else:
 231:         out[:, W - 1] = marker_color
