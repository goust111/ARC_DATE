 141: # --------------- generator (att2) ---------------
 142: 
 143: # Palette and object mix.
 144: COLOR_COUNT = 10
 145: OBJECT_COUNT_CHOICES = (4, 5)
 146: L_COUNTS_BY_OBJECT_COUNT = {4: (2, 3), 5: (3,)}
 147: 
 148: # Border arc and sprite shape bounds.
 149: ARC_MIN_LEN, ARC_MAX_LEN = 1, 7
 150: BAR_MIN_AREA, BAR_MAX_AREA = 1, 7
 151: L_MIN_AREA, L_MAX_AREA = 3, 7
 152: L_MIN_HEIGHT, L_MAX_HEIGHT = 2, 6
 153: L_MIN_WIDTH, L_MAX_WIDTH = 2, 5
 154: MIN_LENGTH_VARIETY_BY_COUNT = {4: 2, 5: 3}
 155: 
 156: # Frame, input canvas, and placement bounds.
 157: FRAME_MIN_SIDE, FRAME_MAX_SIDE = 4, 8
 158: FRAME_SIZE_OFFSETS = ((0, 0), (0, 1), (1, 0))
 159: INPUT_MIN_SIDE, INPUT_MAX_SIDE, INPUT_FRAME_MARGIN = 6, 16, 2
 160: PLACEMENT_BORDER, PLACEMENT_PADDING = 0, 0
 161: GENERATION_ATTEMPTS = 300
 162: 
 163: 
 164: def _border_coords(h: int, w: int) -> tuple[tuple[int, int], ...]:
 165:     coords = [(0, c) for c in range(w)]
 166:     coords += [(r, w - 1) for r in range(1, h)]
 167:     coords += [(h - 1, c) for c in range(w - 2, -1, -1)]
 168:     coords += [(r, 0) for r in range(h - 2, 0, -1)]
 169:     return tuple(coords)
 170: 
 171: 
 172: def _compositions(total: int, parts: int) -> list[tuple[int, ...]]:
 173:     out: list[tuple[int, ...]] = []
 174: 
 175:     def rec(remaining: int, n: int, prefix: list[int]) -> None:
 176:         if n == 1:
 177:             if ARC_MIN_LEN <= remaining <= ARC_MAX_LEN:
 178:                 out.append(tuple(prefix + [remaining]))
 179:             return
 180:         lo = max(ARC_MIN_LEN, remaining - ARC_MAX_LEN * (n - 1))
 181:         hi = min(ARC_MAX_LEN, remaining - ARC_MIN_LEN * (n - 1))
 182:         for x in range(lo, hi + 1):
 183:             rec(remaining - x, n - 1, prefix + [x])
 184: 
 185:     rec(total, parts, [])
 186:     return out
 187: 
 188: 
 189: def _coord_bounds(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
 190:     rows, cols = zip(*coords)
 191:     return min(rows), min(cols), max(rows), max(cols)
 192: 
 193: 
 194: def _arc_kind(coords: tuple[tuple[int, int], ...]) -> str | None:
 195:     r0, c0, r1, c1 = _coord_bounds(coords)
 196:     h, w = r1 - r0 + 1, c1 - c0 + 1
 197:     area = len(coords)
 198: 
 199:     if h == 1 or w == 1:
 200:         return "bar" if BAR_MIN_AREA <= area <= BAR_MAX_AREA else None
 201: 
 202:     if not (
 203:         L_MIN_AREA <= area <= L_MAX_AREA
 204:         and L_MIN_HEIGHT <= h <= L_MAX_HEIGHT
 205:         and L_MIN_WIDTH <= w <= L_MAX_WIDTH
 206:     ):
 207:         return None
 208:     if area != h + w - 1:
 209:         return None
 210: 
 211:     actual = {(r - r0, c - c0) for r, c in coords}
 212:     for elbow_r, elbow_c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)):
 213:         expected = {
 214:             (r, c)
 215:             for r in range(h)
 216:             for c in range(w)
 217:             if r == elbow_r or c == elbow_c
 218:         }
 219:         if actual == expected:
 220:             return "L"
 221:     return None
 222: 
 223: 
 224: @lru_cache(maxsize=None)
 225: def _valid_plans(h: int, w: int, count: int, l_count: int):
 226:     border = _border_coords(h, w)
 227:     perimeter = len(border)
 228:     plans: list[tuple[tuple[tuple[int, int], ...], ...]] = []
 229: 
 230:     for start in range(perimeter):
 231:         for lengths in _compositions(perimeter, count):
 232:             pos = start
 233:             arcs: list[tuple[tuple[int, int], ...]] = []
 234:             kinds: list[str] = []
 235:             for length in lengths:
 236:                 coords = tuple(border[(pos + i) % perimeter] for i in range(length))
 237:                 kind = _arc_kind(coords)
 238:                 if kind is None:
 239:                     break
 240:                 arcs.append(coords)
 241:                 kinds.append(kind)
 242:                 pos = (pos + length) % perimeter
 243:             else:
 244:                 if pos != start:
 245:                     continue
 246:                 if kinds.count("L") != l_count or kinds.count("bar") != count - l_count:
 247:                     continue
 248:                 if len(set(lengths)) < MIN_LENGTH_VARIETY_BY_COUNT[count]:
 249:                     continue
 250:                 plans.append(tuple(arcs))
 251: 
 252:     return tuple(plans)
 253: 
 254: 
 255: def _patch_from_arc(coords: tuple[tuple[int, int], ...], bg: int, color: int) -> np.ndarray:
 256:     r0, c0, r1, c1 = _coord_bounds(coords)
 257:     patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
 258:     for r, c in coords:
 259:         patch[r - r0, c - c0] = color
 260:     return patch
 261: 
 262: 
 263: _FRAME_SIZES = tuple(
 264:     dict.fromkeys(
 265:         (n + dr, n + dc)
 266:         for n in range(FRAME_MIN_SIDE, FRAME_MAX_SIDE + 1)
 267:         for dr, dc in FRAME_SIZE_OFFSETS
 268:         if n + dr <= FRAME_MAX_SIDE and n + dc <= FRAME_MAX_SIDE
 269:     )
 270: )
 271: 
 272: 
 273: def _render_plan(h: int, w: int, bg: int, plans, colors: list[int]) -> tuple[np.ndarray, list[np.ndarray]]:
 274:     arcs = list(random.choice(plans))
 275:     random.shuffle(colors)
 276:     out = np.full((h, w), bg, dtype=int)
 277:     patches: list[np.ndarray] = []
 278:     for coords, color in zip(arcs, colors):
 279:         for r, c in coords:
 280:             out[r, c] = color
 281:         patches.append(_patch_from_arc(coords, bg, color))
 282:     return out, patches
 283: 
 284: 
 285: def _gen_attempt() -> np.ndarray | None:
 286:     count = random.choice(OBJECT_COUNT_CHOICES)
 287:     l_choices = list(L_COUNTS_BY_OBJECT_COUNT[count])
 288:     random.shuffle(l_choices)
 289: 
 290:     sizes = list(_FRAME_SIZES)
 291:     random.shuffle(sizes)
 292:     bg = random.randrange(COLOR_COUNT)
 293:     colors = random.sample([c for c in range(COLOR_COUNT) if c != bg], count)
 294: 
 295:     for h, w in sizes:
 296:         for l_count in l_choices:
 297:             plans = _valid_plans(h, w, count, l_count)
 298:             if not plans:
 299:                 continue
 300: 
 301:             out, patches = _render_plan(h, w, bg, plans, colors)
 302:             H = random.randint(max(INPUT_MIN_SIDE, h + INPUT_FRAME_MARGIN), INPUT_MAX_SIDE)
 303:             W = random.randint(max(INPUT_MIN_SIDE, w + INPUT_FRAME_MARGIN), INPUT_MAX_SIDE)
 304:             inp = np.full((H, W), bg, dtype=int)
 305:             try:
 306:                 for patch in random.sample(patches, len(patches)):
 307:                     r, c = random_free_location(
 308:                         inp,
 309:                         patch,
 310:                         transparent=bg,
 311:                         border=PLACEMENT_BORDER,
 312:                         padding=PLACEMENT_PADDING,
 313:                     )

 328: def generate_input() -> np.ndarray:
 329:     for _ in range(GENERATION_ATTEMPTS):
 330:         grid = _gen_attempt()
 331:         if grid is not None:
 332:             return grid
 333:     raise RuntimeError("failed to generate a valid 83b6b474 input")


