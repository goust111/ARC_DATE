+    cleared = np.array(inp, copy=True)
+    for line in lines:
+        r0, c0, _r1, c1 = line["bbox"]
+        cleared[r0, c0 : c1 + 1] = BG
+    if np.array_equal(cleared, out):
+        return False
+    return True
