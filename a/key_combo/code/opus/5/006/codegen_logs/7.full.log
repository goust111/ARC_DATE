 190: def _distribute_band_widths(count: int, used_target: int) -> list[int]:
 191:     extra_units = (used_target - (4 * count - 2)) // 2
 192:     order = np.random.permutation(count)
 193:     units = np.zeros(count, dtype=int)
 194:     remaining = int(extra_units)
 195:     for i, idx in enumerate(order):
 196:         slots_left = count - i - 1
 197:         lo = max(0, remaining - 3 * slots_left)
 198:         hi = min(3, remaining)
 199:         take = int(np.random.randint(lo, hi + 1))
 200:         units[int(idx)] = take
 201:         remaining -= take
 202:     return [2 + 2 * int(u) for u in units]
