 135: def _place_objects(objects):
 136:     """Place each object at a center valid for both input and output squares."""
 137:     placed = []
 138:     output_boxes = []
 139:     input_boxes = []
 140: 
 141:     for obj in objects:
 142:         out_side = obj["out_side"]
 143:         in_side = obj["in_side"]
 144:         margin = max(out_side // 2, in_side // 2)
 145:         rows = range(margin, GRID_SIZE - margin)
 146:         centers = [(r, c) for r in rows for c in rows]
 147:         random.shuffle(centers)
 148: 
 149:         for r, c in centers:
 150:             out_box = _bbox(r, c, out_side)
 151:             in_box = _bbox(r, c, in_side)
 152:             if _clear(out_box, output_boxes, OUTPUT_CLEARANCE_GAP) and _clear(in_box, input_boxes, INPUT_CLEARANCE_GAP):
 153:                 placed.append((obj["color"], out_box, in_box))
 154:                 output_boxes.append(out_box)
 155:                 input_boxes.append(in_box)
 156:                 break
 157:         else:
 158:             return None
 159:     return placed
