  94: def _draw_square(grid, color, box):
  95:     r0, c0, r1, c1 = box
  96:     shape = (r1 - r0 + 1, c1 - c0 + 1)
  97:     paste(grid, np.full(shape, int(color), dtype=int), r0, c0)
