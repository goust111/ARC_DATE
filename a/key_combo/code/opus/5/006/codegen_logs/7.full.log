+    if not np.array_equal(solved, expected):
+        return None
+    if not _semantic_check(inp, expected, objects, lines, l_med):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
