  87: def main(grid: np.ndarray) -> np.ndarray:
  88:     """
  89:     Fill every lattice slot from the color assigned to that slot position by the other lattices.
  90: 
  91:     Input structure:
  92:     - The background is the dominant color.
  93:     - The largest foreground color forms several one-pixel-thick rectangular lattice frames.
  94:     - The frame lines divide each lattice into the same row-by-column set of rectangular slots; some slots already contain one non-frame color.
  95: 
  96:     Rule:
  97:     - Infer a color for each logical slot position from the colored slots across all lattice frames.
  98:     - Repaint every slot interior in every lattice with the inferred color for its row/column position.
  99:     - Keep the frame lines and all background outside frames unchanged.
 100: 
 101:     Key insight:
 102:     - Slot sizes vary by frame, but the complete color pattern is indexed by lattice slot position rather than by absolute pixel size or location.
 103:     """
 104:     g = np.asarray(grid, dtype=int)
 105:     bg = int(get_bg(g))
 106:     frame_color = _dominant_foreground_color(g, bg)
 107:     frames = _parse_frames(g, bg, frame_color)
 108:     slot_colors = _infer_slot_colors(g, bg, frame_color, frames)
 109: 
 110:     out = g.copy()
 111:     for rows, cols in frames:
 112:         for sr in range(len(rows) - 1):
 113:             for sc in range(len(cols) - 1):
 114:                 out[rows[sr] + 1 : rows[sr + 1], cols[sc] + 1 : cols[sc + 1]] = slot_colors[
 115:                     (sr, sc)
 116:                 ]
 117:     return out
