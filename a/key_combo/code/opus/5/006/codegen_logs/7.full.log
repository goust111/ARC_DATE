 265: def _blob_spec(size: tuple[int, int], port_dir: tuple[int, int]) -> dict | None:
 266:     """Build a blob specification dict for a given shape and port direction, or None if invalid."""
 267:     h, w = size
 268:     mask = _shape_mask(h, w)
 269:     green = _edge_offsets(mask, port_dir)
 270:     if len(green) not in (1, 2):
 271:         return None
 272: 
 273:     green_set = set(green)
 274:     patch = np.full((h, w), BG, dtype=int)
 275:     patch[mask] = BLUE
 276:     for r, c in green:
 277:         patch[r, c] = GREEN
 278: 
 279:     port_pixels: list[tuple[int, int]] = []
 280:     for gr, gc in green:
 281:         br, bc = gr - port_dir[0], gc - port_dir[1]
 282:         if not (0 <= br < h and 0 <= bc < w):
 283:             return None
 284:         if not mask[br, bc] or (br, bc) in green_set:
 285:             return None
 286:         port_pixels.append((br, bc))
 287: 
 288:     blue = [(int(r), int(c)) for r, c in np.argwhere(mask) if (int(r), int(c)) not in green_set]
 289:     full = [(int(r), int(c)) for r, c in np.argwhere(mask)]
 290:     return {
 291:         "size": (h, w), "mask": mask, "patch": patch,
 292:         "blue": blue, "full": full,
 293:         "port_dir": port_dir,
 294:         "port_pixels": _sort_on_ray(port_pixels, port_dir),
 295:     }
