 234: def _black_shared_corners(out: np.ndarray, directions: set[tuple[int, int]]) -> None:
 235:     """Set corner to black where two painted boundary sides meet."""
 236:     H, W = out.shape
 237:     if (-1, 0) in directions and (0, -1) in directions:
 238:         out[0, 0] = 0
 239:     if (-1, 0) in directions and (0, 1) in directions:
 240:         out[0, W - 1] = 0
 241:     if (1, 0) in directions and (0, -1) in directions:
 242:         out[H - 1, 0] = 0
 243:     if (1, 0) in directions and (0, 1) in directions:
 244:         out[H - 1, W - 1] = 0
