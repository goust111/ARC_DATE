   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Build a red ray network by activating blue blobs via directional green ports.
  10: 
  11:     Input structure:
  12:     - bg = most common color. Large blue blobs with adjacent green pixels marking port directions.
  13:     - Start marker: yellow pixel atop a short red segment at grid bottom.
  14: 
  15:     Rule:
  16:     - Extend a ray upward from start; on hitting a blue blob, recolor it red.
  17:     - Activated blobs emit thick rays through green ports until boundary or another blob.
  18:     - Cascade until no new blobs are reached.
  19: 
  20:     Key insight: Green pixels encode ray direction and width; the network activates as a chain reaction from one start point.
  21:     """
  22:     g = np.array(grid, dtype=int)
  23:     H, W = g.shape
  24:     bg = int(get_bg(g))
  25: 
  26:     # --- STEP 1) Detect the start "port" (red vertical segment with a non-red cap above) ---
  27:     start_candidates: list[tuple[int, int, int, list[tuple[int, int]]]] = []
  28: 
  29:     for col in colors_present(g, exclude={bg}):
  30:         for coords in components_mask(g == int(col), connectivity=8):
  31:             if coords.size == 0:
  32:                 continue
  33:             r0, c0 = coords.min(axis=0)
  34:             r1, c1 = coords.max(axis=0)
  35:             r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
  36: 
  37:             # thin vertical segment, height>=2, touches bottom
  38:             if c0 != c1 or (r1 - r0 + 1) < 2:
  39:                 continue
  40:             if r1 != int(H - 1):
  41:                 continue
  42:             # solid vertical segment
  43:             if any(int(g[rr, c0]) != int(col) for rr in range(int(r0), int(r1) + 1)):
  44:                 continue
  45:             if int(r0) - 1 < 0:
  46:                 continue
  47:             cap = int(g[int(r0) - 1, int(c0)])
  48:             if cap == int(bg) or cap == int(col):
  49:                 continue
  50: 
  51:             start_candidates.append(
  52:                 (
  53:                     int(col),
  54:                     int(cap),
  55:                     int(c0),
  56:                     [(int(rr), int(c0)) for rr in range(int(r0), int(r1) + 1)],
  57:                 )
  58:             )
  59: 
  60:     assert len(start_candidates) == 1
  61:     red_col, yellow_col, start_col, start_seg = start_candidates[0]
  62: 
  63:     # --- STEP 2) Identify blob colors ---
  64:     # Blue = dominant remaining color by pixel count (excluding bg/start colors).
  65:     counts = Counter(map(int, g.flatten()))
  66:     other_cols = [(int(cnt), int(col)) for col, cnt in counts.items() if int(col) not in (bg, red_col, yellow_col)]
  67:     assert other_cols
  68:     max_count = max(cnt for cnt, _col in other_cols)
  69:     blue_candidates = [int(col) for cnt, col in other_cols if cnt == max_count]
  70:     assert len(blue_candidates) == 1
  71:     blue_col = int(blue_candidates[0])
  72: 
  73:     # Green = the unique other color that is 4-adjacent to blue.
  74:     green_candidates: list[int] = []
  75:     for col in colors_present(g, exclude={bg, red_col, yellow_col, blue_col}):
  76:         pts = np.argwhere(g == int(col))
  77:         if pts.size == 0:
  78:             continue
  79:         ok = False
  80:         for r, c in pts:
  81:             r = int(r)
  82:             c = int(c)
  83:             for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
  84:                 rr = int(r + dr)
  85:                 cc = int(c + dc)
  86:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(blue_col):
  87:                     ok = True
  88:                     break
  89:             if ok:
  90:                 break
  91:         if ok:
  92:             green_candidates.append(int(col))
  93: 
  94:     assert len(green_candidates) == 1
  95:     green_col = int(green_candidates[0])
  96: 
  97:     out = np.full_like(g, int(bg))
  98: 
  99:     # --- STEP 3) Extract blue blobs as connected components, and build a pixel->blob map ---
 100:     blob_id = np.full((H, W), -1, dtype=int)
 101:     blobs: list[dict] = []
 102: 
 103:     for coords in components_mask(g == int(blue_col), connectivity=8):
 104:         pts = [(int(r), int(c)) for r, c in coords]
 105:         bi = int(len(blobs))
 106:         for r, c in pts:
 107:             blob_id[int(r), int(c)] = bi
 108:         blobs.append({"pts": pts, "ports": []})
 109: 
 110:     # --- STEP 4) For each blob, find its ports from adjacent green markers ---
 111:     for blob in blobs:
 112:         pts = blob["pts"]
 113:         seen_dirs: set[tuple[int, int]] = set()
 114:         for r, c in pts:
 115:             for ddr, ddc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
 116:                 rr = int(r + ddr)
 117:                 cc = int(c + ddc)
 118:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(green_col):
 119:                     seen_dirs.add((int(ddr), int(ddc)))
 120:         for ddr, ddc in seen_dirs:
 121:             port_pixels = [
 122:                 (int(r), int(c))
 123:                 for (r, c) in pts
 124:                 if 0 <= int(r + ddr) < H and 0 <= int(c + ddc) < W and int(g[int(r + ddr), int(c + ddc)]) == int(green_col)
 125:             ]
 126:             assert port_pixels
 127:             blob["ports"].append({"dir": (int(ddr), int(ddc)), "pixels": port_pixels})
 128: 
 129:     activated: set[int] = set()
 130:     queue: list[int] = []
 131: 
 132:     def activate_blob_at(r: int, c: int) -> None:
 133:         """Recolor a blob to red when first hit by a ray; enqueue it to emit its ports."""
 134:         bi = int(blob_id[int(r), int(c)])
 135:         assert bi >= 0
 136:         if bi in activated:
 137:             return
 138:         activated.add(int(bi))
 139:         queue.append(int(bi))
 140:         for pr, pc in blobs[bi]["pts"]:
 141:             out[int(pr), int(pc)] = int(red_col)
 142: 
 143:     # --- STEP 5) Draw the start ray upward (thin) and stop at the first blob hit ---
 144:     for r, c in start_seg:
 145:         out[int(r), int(c)] = int(red_col)
 146:     top_r = min(int(r) for r, _c in start_seg)
 147:     assert int(top_r) > 0 and int(g[int(top_r) - 1, int(start_col)]) == int(yellow_col)
 148:     out[int(top_r) - 1, int(start_col)] = int(red_col)
 149:     for r in range(int(top_r) - 1, -1, -1):
 150:         out[int(r), int(start_col)] = int(red_col)
 151:         if int(g[int(r), int(start_col)]) == int(blue_col):
 152:             activate_blob_at(int(r), int(start_col))
 153:             break
 154: 
 155:     def extend_thick(port_pixels: list[tuple[int, int]], d: tuple[int, int]) -> None:
 156:         """Extend a ray from each port pixel until boundary or blob hit."""
 157:         ddr, ddc = map(int, d)
 158:         for pr, pc in port_pixels:
 159:             r, c = int(pr), int(pc)
 160:             while True:
 161:                 r += int(ddr)
 162:                 c += int(ddc)
 163:                 if not (0 <= r < H and 0 <= c < W):
 164:                     break
 165:                 out[int(r), int(c)] = int(red_col)
 166:                 if int(g[int(r), int(c)]) == int(blue_col):
 167:                     activate_blob_at(int(r), int(c))
 168:                     break
 169: 
 170:     # --- STEP 6) Propagate (BFS): activated blob -> emit rays -> activate more blobs ---
 171:     while queue:
 172:         bi = int(queue.pop(0))
 173:         for port in blobs[bi]["ports"]:
 174:             extend_thick(port["pixels"], port["dir"])
 175: 
 176:     assert len(blobs) - len(activated) <= 1, "at most 1 distractor blob"
 177: 
 178:     return out
