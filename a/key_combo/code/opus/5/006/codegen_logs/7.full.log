 371: def _try_place_along_axis(
 372:     spec: dict, window: list[tuple[int, int]], d: tuple[int, int],
 373:     lane_vals: list[int], starts: list[tuple[int, int]],
 374:     include_origin: bool, min_gap: int,
 375:     occ_pad: np.ndarray, blue_mask: np.ndarray, ray_mask: np.ndarray,
 376:     H: int, W: int,
 377: ) -> list[dict]:
 378:     """Find all valid placements for a blob spec along the ray's travel axis.
 379: 
 380:     Unifies the vertical/horizontal branches: the 'fixed' perpendicular coordinate
 381:     is determined by lane alignment, while the 'along' coordinate is iterated.
 382:     """
 383:     h, w = spec["mask"].shape
 384:     win_vals = [_perp_value(p, d) for p in window]
 385:     edge_line = _along_value(window[0], d)
 386:     start_line = _along_value(starts[0], d)
 387:     is_vertical = bool(d[0])
 388: 
 389:     # Fixed coordinate on the perpendicular axis
 390:     fixed = lane_vals[0] - win_vals[0]
 391:     # Range on the along axis
 392:     extent = H - h if is_vertical else W - w
 393:     low = edge_line
 394:     high = extent + edge_line
 395:     if d in (UP, LEFT):
 396:         high = min(high, start_line - min_gap)
 397:     else:
 398:         low = max(low, start_line + min_gap)
 399: 
 400:     entry_lines = list(range(low, high + 1))
 401:     random.shuffle(entry_lines)
 402:     candidates: list[dict] = []
 403: 
 404:     for entry_line in entry_lines:
 405:         origin_along = entry_line - edge_line
 406:         r0 = origin_along if is_vertical else fixed
 407:         c0 = fixed if is_vertical else origin_along
 408:         if is_vertical:
 409:             entry_cells = [(entry_line, c0 + c) for _, c in window]
 410:         else:
 411:             entry_cells = [(r0 + r, entry_line) for r, _ in window]
 412:         full = _offset(spec["full"], r0, c0)
 413:         if not _in_bounds(full, H, W):
 414:             continue
 415:         if any(occ_pad[r, c] or ray_mask[r, c] for r, c in full):
 416:             continue
 417:         path = _path_to_entries(starts, d, entry_cells, include_origin, H, W)
 418:         if path is None:
 419:             continue
 420:         entry_set = set(entry_cells)
 421:         if any(blue_mask[r, c] for r, c in path if (r, c) not in entry_set):
 422:             continue
 423:         candidates.append({
 424:             "spec": spec, "r0": r0, "c0": c0,
 425:             "entry": entry_cells, "path": path,
 426:             "blue": _offset(spec["blue"], r0, c0),
 427:             "full": full,
 428:             "ports": _sort_on_ray(_offset(spec["port_pixels"], r0, c0), spec["port_dir"]),
 429:         })
 430: 
 431:     return candidates
 432: 
 433: 
 434: def _candidate_next_blob(
 435:     H: int, W: int,
 436:     starts: list[tuple[int, int]], d: tuple[int, int],
 437:     include_origin: bool,
 438:     occupied: np.ndarray, blue_mask: np.ndarray, ray_mask: np.ndarray,
 439: ) -> dict | None:
 440:     """Find a random valid placement for the next blob in the cascade chain."""
 441:     starts = _sort_on_ray(starts, d)
 442:     thickness = len(starts)
 443:     lane_vals = [_perp_value(p, d) for p in starts]
 444:     lane_delta = [v - lane_vals[0] for v in lane_vals]
 445:     entry_side = OPP[d]
 446:     occ_pad = _dilate8(occupied)
 447:     min_gap = MIN_GAP_FIRST if include_origin else MIN_GAP_CHAIN
 448:     candidates: list[dict] = []
 449: 
 450:     for spec in _all_specs():
 451:         if spec["port_dir"] == entry_side:
 452:             continue
 453:         edge = _edge_offsets(spec["mask"], entry_side)
 454:         if len(edge) < thickness:
 455:             continue
 456:         for k in range(len(edge) - thickness + 1):
 457:             window = edge[k : k + thickness]
 458:             win_delta = [_perp_value(p, d) - _perp_value(window[0], d) for p in window]
 459:             if win_delta != lane_delta:
 460:                 continue
 461:             candidates.extend(_try_place_along_axis(
 462:                 spec, window, d, lane_vals, starts, include_origin, min_gap,
 463:                 occ_pad, blue_mask, ray_mask, H, W,
 464:             ))
 465: 
 466:     return random.choice(candidates) if candidates else None
 467: 
