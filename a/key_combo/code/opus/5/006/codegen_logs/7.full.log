 120: def _gen_same_color_touch(
 121:     canvas: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int, color: int
 122: ) -> bool:
 123:     h, w = canvas.shape
 124:     for pr, pc in np.argwhere(patch_mask):
 125:         r = int(r0 + pr)
 126:         c = int(c0 + pc)
 127:         for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
 128:             if 0 <= nr < h and 0 <= nc < w and int(canvas[nr, nc]) == int(color):
 129:                 return True
 130:     return False
 131: 
 132: 
 133: def _gen_valid_locations(canvas: np.ndarray, patch: np.ndarray, bg: int) -> list[tuple[int, int]]:
 134:     h, w = canvas.shape
 135:     ph, pw = patch.shape
 136:     patch_mask = patch != int(bg)
 137:     color = int(patch[patch_mask][0])
 138:     locs: list[tuple[int, int]] = []
 139: 
 140:     for r0 in range(h - ph + 1):
 141:         for c0 in range(w - pw + 1):
 142:             region = canvas[r0 : r0 + ph, c0 : c0 + pw]
 143:             if bool((region != int(bg))[patch_mask].any()):
 144:                 continue
 145:             if _gen_same_color_touch(canvas, patch_mask, r0, c0, color):
 146:                 continue
 147:             locs.append((r0, c0))
 148:     return locs
