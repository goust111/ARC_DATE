 327: def _path_to_entries(
 328:     starts: list[tuple[int, int]], d: tuple[int, int],
 329:     entries: list[tuple[int, int]], include_origin: bool, H: int, W: int,
 330: ) -> list[tuple[int, int]] | None:
 331:     """Trace ray lanes from starts to entries; return cell list or None on failure."""
 332:     dr, dc = d
 333:     cells: list[tuple[int, int]] = []
 334:     for (r, c), (er, ec) in zip(starts, entries):
 335:         if include_origin:
 336:             cells.append((r, c))
 337:         guard = H + W + 10
 338:         while (r, c) != (er, ec):
 339:             r, c = r + dr, c + dc
 340:             guard -= 1
 341:             if guard < 0 or not (0 <= r < H and 0 <= c < W):
 342:                 return None
 343:             cells.append((r, c))
 344:     return cells
