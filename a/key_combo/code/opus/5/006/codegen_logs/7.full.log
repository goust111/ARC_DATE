 144: def _sprite_cells(direction: tuple[int, int], r: int, c: int) -> set[tuple[int, int]]:
 145:     """Return the set of (row, col) occupied by the full sprite (body + marker)."""
 146:     return {(r, c)} | {(r + dr, c + dc) for dr, dc in BODY_REL[direction]}
 147: 
 148: 
 149: def _ray_cells(H: int, W: int, r: int, c: int, direction: tuple[int, int]) -> set[tuple[int, int]]:
 150:     """Return every cell from the marker outward along *direction* to the grid edge."""
 151:     dr, dc = direction
 152:     cells = set()
 153:     rr, cc = r + dr, c + dc
 154:     while 0 <= rr < H and 0 <= cc < W:
 155:         cells.add((rr, cc))
 156:         rr += dr
 157:         cc += dc
 158:     return cells
 159: 
 160: 
 161: def _center_ranges(H: int, W: int, direction: tuple[int, int]) -> tuple[range, range]:
 162:     """Valid marker-center row/col ranges ensuring EDGE_GAP from all grid edges."""
 163:     min_r, max_r, min_c, max_c = _SPRITE_EXTENT[direction]
 164:     return (range(EDGE_GAP - min_r, H - EDGE_GAP - max_r),
 165:             range(EDGE_GAP - min_c, W - EDGE_GAP - max_c))
 166: 
