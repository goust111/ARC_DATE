+    l_med, lengths, _depths = chosen
+
+    lines = _place_lines(rows, cols, lengths)
+    if lines is None:
+        return None
+
+    inp = _render_input(rows, cols, objects, lines)
+    expected = _expected_from_spec(inp, objects, lines, l_med)
+
+    try:
