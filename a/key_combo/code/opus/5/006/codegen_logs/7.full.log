 306: def _dilate8(mask: np.ndarray) -> np.ndarray:
 307:     """Dilate a boolean mask by 1 pixel in all 8 directions."""
 308:     H, W = mask.shape
 309:     out = mask.copy()
 310:     for dr in (-1, 0, 1):
 311:         for dc in (-1, 0, 1):
 312:             r0, r1 = max(0, dr), H + min(0, dr)
 313:             c0, c1 = max(0, dc), W + min(0, dc)
 314:             out[r0:r1, c0:c1] |= mask[r0 - dr : r1 - dr, c0 - dc : c1 - dc]
 315:     return out
