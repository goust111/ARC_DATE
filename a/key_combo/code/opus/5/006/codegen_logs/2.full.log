+
+    base_r = random.randint(7, H - 8)
+    base_c = random.randint(7, W - 8)
+
+    sprites: list[dict] = []
+    for idx, (h, w) in enumerate(dims):
+        placed = None
+        for _ in range(60):
+            dr = random.randint(-2, 2)
