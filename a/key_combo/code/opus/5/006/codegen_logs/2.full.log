# Canvas and palette.
GRID_SIZE = 16
BACKGROUND_COLOR = 7
FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
INPUT_SIDE_FROM_OUTPUT = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
# Object and side sampling.
SQUARE_COUNT_RANGE = (3, 5)
BASE_OUTPUT_SIDE_CHOICES = [1, 3, 5]
OUTPUT_SIDE_7_PROB = 0.45
OUTPUT_SIDE_9_PROB = 0.35
# Placement and retry policy.
OUTPUT_CLEARANCE_GAP = 1
INPUT_CLEARANCE_GAP = 0
MAX_GENERATION_ATTEMPTS = 300


def _bbox(center_r, center_c, side):
    d = side // 2
    return center_r - d, center_c - d, center_r + d, center_c + d


def _separated(a, b, gap=0):
    return (
        a[2] + gap + 1 <= b[0]
        or b[2] + gap + 1 <= a[0]
        or a[3] + gap + 1 <= b[1]
        or b[3] + gap + 1 <= a[1]
    )


def _clear(rect, rects, gap=0):
    return all(_separated(rect, other, gap) for other in rects)


def _draw_square(grid, color, box):
    r0, c0, r1, c1 = box
    shape = (r1 - r0 + 1, c1 - c0 + 1)
    paste(grid, np.full(shape, int(color), dtype=int), r0, c0)


def _choose_output_sides(count):
    sides = [random.choice(BASE_OUTPUT_SIDE_CHOICES) for _ in range(count)]
    slots = list(range(count))
    random.shuffle(slots)

    if random.random() < OUTPUT_SIDE_7_PROB:
        sides[slots.pop()] = 7
    if slots and random.random() < OUTPUT_SIDE_9_PROB:
        sides[slots.pop()] = 9

    random.shuffle(sides)
    return sides


def _sample_objects():
    """Sample color and side specs, returning larger required footprints first."""
    count = random.randint(*SQUARE_COUNT_RANGE)
    colors = random.sample(FOREGROUND_COLORS, count)
    out_sides = _choose_output_sides(count)
    in_sides = [INPUT_SIDE_FROM_OUTPUT[s] for s in out_sides]

    # Keep the configured background as the solver's dominant color.
    areas = [s * s for s in in_sides]
    if GRID_SIZE * GRID_SIZE - sum(areas) <= max(areas):
        return None

    objects = [
        {"color": color, "out_side": out_side, "in_side": in_side}
        for color, out_side, in_side in zip(colors, out_sides, in_sides)
    ]
    random.shuffle(objects)
    objects.sort(key=lambda obj: (max(obj["out_side"], obj["in_side"]), obj["out_side"]), reverse=True)
    return objects


def _place_objects(objects):
    """Place each object at a center valid for both input and output squares."""
    placed = []
    output_boxes = []
    input_boxes = []

    for obj in objects:
        out_side = obj["out_side"]
        in_side = obj["in_side"]
        margin = max(out_side // 2, in_side // 2)
        rows = range(margin, GRID_SIZE - margin)
        centers = [(r, c) for r in rows for c in rows]
        random.shuffle(centers)

        for r, c in centers:
            out_box = _bbox(r, c, out_side)
            in_box = _bbox(r, c, in_side)
            if _clear(out_box, output_boxes, OUTPUT_CLEARANCE_GAP) and _clear(in_box, input_boxes, INPUT_CLEARANCE_GAP):
                placed.append((obj["color"], out_box, in_box))
                output_boxes.append(out_box)
                input_boxes.append(in_box)
                break
        else:
            return None
    return placed


def _render_grid(placed, box_index):
    """Render one phase from placed tuples: 1 for output boxes, 2 for input boxes."""
    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
    for item in placed:
        _draw_square(grid, item[0], item[box_index])
    return grid


def _gen_attempt():
    objects = _sample_objects()
    if objects is None:
        return None

    placed = _place_objects(objects)
    if placed is None:
        return None

    out = _render_grid(placed, 1)
    inp = _render_grid(placed, 2)
    return inp if np.array_equal(main(inp), out) else None


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 522fdd07 input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
from functools import lru_cache
import random


def _border(shape: tuple[int, int]) -> frozenset[tuple[int, int]]:
    h, w = shape
    return frozenset(
        (r, c)
        for r in range(h)
        for c in range(w)
        if r == 0 or r == h - 1 or c == 0 or c == w - 1
    )


def _candidate_outputs(
    bg: int, objects: list[dict], total_area: int
) -> list[np.ndarray]:
    outputs: list[tuple[int, np.ndarray]] = []

    for h in range(2, total_area + 1):
        for w in range(2, total_area + 1):
            if 2 * h + 2 * w - 4 != total_area:
                continue

            border = _border((h, w))
            placements_by_object: list[list[frozenset[tuple[int, int]]]] = []
            for obj in objects:
                placements: list[frozenset[tuple[int, int]]] = []
                for r0 in range(h - obj["h"] + 1):
                    for c0 in range(w - obj["w"] + 1):
                        cells = frozenset(
                            (r0 + r, c0 + c) for r, c in obj["rel"]
                        )
                        if cells <= border:
                            placements.append(cells)
                if not placements:
                    break
                placements_by_object.append(placements)
            else:
                order = sorted(
                    range(len(objects)),
                    key=lambda i: (
                        len(placements_by_object[i]),
                        -objects[i]["area"],
                        objects[i]["bbox"][0],
                        objects[i]["bbox"][1],
                    ),
                )
                solved: list[np.ndarray] = []

                def search(
                    k: int,
                    used: frozenset[tuple[int, int]],
                    chosen: list[tuple[int, frozenset[tuple[int, int]]]],
                ) -> None:
                    if k == len(order):
                        if used == border:
                            out = np.full((h, w), bg, dtype=int)
                            for obj_idx, cells in chosen:
                                for r, c in cells:
                                    out[r, c] = objects[obj_idx]["color"]
                            solved.append(out)
                        return

                    obj_idx = order[k]
                    for cells in placements_by_object[obj_idx]:
                        if cells & used:
                            continue
                        search(k + 1, used | cells, chosen + [(obj_idx, cells)])

                search(0, frozenset(), [])

                seen: set[tuple[int, ...]] = set()
                for out in solved:
                    key = tuple(map(int, out.ravel()))
                    if key in seen:
                        continue
                    seen.add(key)
                    outputs.append((abs(h - w), out))

    assert outputs, "the objects must assemble into at least one rectangular frame"
    best_balance = min(balance for balance, _out in outputs)
    best = [out for balance, out in outputs if balance == best_balance]
    unique = {(out.shape, tuple(map(int, out.ravel()))) for out in best}
    assert len(unique) == 1, "the most balanced frame assembly must be unique"
    return best


def main(grid: np.ndarray) -> np.ndarray:
    """Translate the colored objects into the most balanced complete rectangular frame.

    Input structure
    A grid with one dominant background color and several monochromatic
    4-connected foreground objects that are straight bars or corner-like line
    sprites.

    Rule
    Preserve every foreground object exactly, allowing translation only, and
    place the objects so they cover every pixel of a one-cell-thick rectangular
    frame exactly once; the frame interior is the background color.

    Key insight
    The output shape is not copied from the input: the foreground pixel count
    determines possible frame sizes, and the intended output is the valid frame
    assembly with the least difference between height and width.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    components = find_components(
        g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"
    )
    assert components, "at least one foreground object is required"

    objects: list[dict] = []
    for comp in components:
        r0, c0, r1, c1 = comp["bbox"]
        rel = tuple(
            sorted((int(r - r0), int(c - c0)) for r, c in comp["coords"])
        )
        objects.append(
            {
                "color": int(comp["color"]),
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "rel": rel,
                "h": int(r1 - r0 + 1),
                "w": int(c1 - c0 + 1),
                "area": int(comp["area"]),
            }
        )

    objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1], -obj["area"]))
    total_area = sum(obj["area"] for obj in objects)
    best = _candidate_outputs(bg, objects, total_area)
    return best[0]

