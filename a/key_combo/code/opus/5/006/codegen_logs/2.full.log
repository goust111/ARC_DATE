def parse(g):
    sprites=[]
    for color in sorted(set(map(int,g.ravel()))-{0}):
        pts=np.argwhere(g==color)
        if len(pts)==0: continue
        r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
        h=r1-r0+1; w=c1-c0+1
