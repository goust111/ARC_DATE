+
+
+def _place_marker(grid: np.ndarray, color: int, corner: str, occupied: set[tuple[int, int]]) -> bool:
+    n = grid.shape[0]
+    rows = list(range(2, n - 3))
+    cols = list(range(2, n - 3))
