+    if choice == "opposite_pair":
+        return list(random.choice([("top_left", "bottom_right"), ("top_right", "bottom_left")]))
+    if choice == "triple":
+        missing = random.choice(CORNER_ORDER)
+        return [corner for corner in CORNER_ORDER if corner != missing]
