+
+def _parse_markers(grid: np.ndarray) -> list[tuple[str, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    comps = _find_components(g, bg)
+    assert 2 <= len(comps) <= 4
