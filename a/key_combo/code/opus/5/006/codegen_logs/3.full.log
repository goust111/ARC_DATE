+
+
+def _scenario_corners() -> list[str]:
+    scenarios = list(SCENARIO_WEIGHTS)
+    weights = [SCENARIO_WEIGHTS[name] for name in scenarios]
+    choice = random.choices(scenarios, weights=weights, k=1)[0]
