+                assert new_dir in DIR_SET
+                colors = _ordered_union(group[0].colors, group[1].colors, group[0], group[1])
+                next_active.append(Beam(cell, new_dir, colors, 0))
+                continue
+
+            continue
+
+        active = next_active
+
+    return out
