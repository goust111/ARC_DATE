+    frozenset({(0, 0), (0, 1), (1, 1)}): "top_right",
+    frozenset({(0, 0), (1, 0), (1, 1)}): "bottom_left",
+    frozenset({(0, 1), (1, 0), (1, 1)}): "bottom_right",
+}
+
