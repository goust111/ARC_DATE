+            arm_mask[:arm, 0] = True
+        elif corner == "top_right":
+            arm_mask[0, n - arm :] = True
+            arm_mask[:arm, n - 1] = True
+        elif corner == "bottom_left":
+            arm_mask[n - 1, :arm] = True
+            arm_mask[n - arm :, 0] = True
+        else:
+            arm_mask[n - 1, n - arm :] = True
+            arm_mask[n - arm :, n - 1] = True
