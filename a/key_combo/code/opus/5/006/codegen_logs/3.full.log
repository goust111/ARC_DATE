+    random.shuffle(cols)
+
+    offsets = MARKER_SHAPES[corner]
+    halo = [(-1, -1), (-1, 0), (-1, 1), (-1, 2), (0, -1), (0, 2), (1, -1), (1, 2), (2, -1), (2, 0), (2, 1), (2, 2)]
