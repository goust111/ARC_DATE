+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+PALETTE = (1, 2, 3, 4, 7)
+GREY = 5
+BLACK = 0
+CELL = 3
+
+TEMPLATE_3 = np.array(
+    [
+        [0, 0, 2, 2, 1, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 2, 2, 2, 2, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 2, 2, 2, 2, 1],
+    ],
+    dtype=int,
+)
+
+TEMPLATE_4 = np.array(
+    [
+        [0, 0, 2, 2, 1, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 2, 2, 2, 2, 1],
+        [0, 0, 3, 3, 1, 1],
+        [0, 0, 3, 3, 1, 1],
+        [0, 3, 3, 3, 3, 1],
+    ],
+    dtype=int,
+)
+
+TEMPLATE_SPECS = (
+    {
+        "board": TEMPLATE_3,
+        "connector_cells": ((2, 0), (2, 5)),
+        "extra_masks": ((2, 2),),
+        "n_colors": 3,
+    },
+    {
+        "board": TEMPLATE_4,
+        "connector_cells": ((2, 0), (2, 5)),
+        "extra_masks": ((1, 2),),
+        "n_colors": 4,
+    },
