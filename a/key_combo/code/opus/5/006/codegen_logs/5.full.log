  "path": "cast from each marker in the direction opposite the sprite body bias to a grid boundary side",
  "trajectory": "paint every second pixel along the ray, then paint the full reached boundary side in the marker color",
  "transform": "shared corners where two painted boundary sides meet -> black; original sprites remain unchanged"
}
</annotation>
</reference_puzzle>

