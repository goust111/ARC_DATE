+TEMPLATE_3 = np.array(
+    [
+        [0, 0, 2, 2, 1, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 2, 2, 2, 2, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 0, 2, 2, 1, 1],
+        [0, 2, 2, 2, 2, 1],
+    ],
