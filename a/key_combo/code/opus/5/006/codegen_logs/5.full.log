+        [0, 0, 2, 2, 1, 1],
+        [0, 2, 2, 2, 2, 1],
+        [0, 0, 3, 3, 1, 1],
+        [0, 0, 3, 3, 1, 1],
+        [0, 3, 3, 3, 3, 1],
+    ],
+    dtype=int,
+)
+
+TEMPLATE_SPECS = (
+    {
+        "board": TEMPLATE_3,
+        "connector_cells": ((2, 0), (2, 5)),
+        "extra_masks": ((2, 2),),
+        "n_colors": 3,
+    },
+    {
+        "board": TEMPLATE_4,
