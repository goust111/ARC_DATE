+    if _get_bg(inp) != BG:
+        return None
+    if np.array_equal(inp, _render_from_specs(specs, shape)):
+        return None
+    if not _validate_scene(inp, specs, overlap_pair, crop_index):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
