+
+def _boxes_overlap(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]) -> bool:
+    return not (
+        int(box_a[2]) < int(box_b[0])
+        or int(box_b[2]) < int(box_a[0])
+        or int(box_a[3]) < int(box_b[1])
+        or int(box_b[3]) < int(box_a[1])
