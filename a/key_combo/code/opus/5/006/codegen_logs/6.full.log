+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[:-1, :] |= mask[1:, :]
+    out[1:, :] |= mask[:-1, :]
+    out[:, :-1] |= mask[:, 1:]
+    out[:, 1:] |= mask[:, :-1]
+    out[:-1, :-1] |= mask[1:, 1:]
+    out[:-1, 1:] |= mask[1:, :-1]
+    out[1:, :-1] |= mask[:-1, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
+    return out
+
+
+def _place_markers(inp: np.ndarray, specs: list[dict]) -> bool:
+    h, w = inp.shape
+    occupied = inp != BG
+    blocked = _dilate8(occupied)
+    todo = [int(spec["color"]) for spec in specs for _ in range(int(spec["count"]))]
+    random.shuffle(todo)
+    for color in todo:
+        candidates = np.argwhere(~occupied & ~blocked)
+        if candidates.size == 0:
+            return False
+        idx = random.randrange(len(candidates))
+        r, c = map(int, candidates[idx])
+        inp[r, c] = color
+        single = np.zeros((h, w), dtype=bool)
+        single[r, c] = True
+        occupied[r, c] = True
+        blocked |= _dilate8(single)
+        blocked[r, c] = True
+    return True
