+BG = 0
+SQUARE_COLORS = (7, 2, 9, 1)
+ALLOWED_SIDES = (1, 3, 5, 7, 9)
+GEN_INPUT_SIDES = (3, 5, 7, 9)  # avoid singleton-square ambiguity in generated inputs
+SIDE_CYCLE = (1, 9, 7, 5, 3)
+DISPLACEMENTS = {
+    7: (-2, 0),  # orange -> up
+    2: (0, -2),  # red -> left
+    9: (2, 0),   # maroon -> down
+    1: (0, 1),   # blue -> right
