+        for center in centers:
+            if can_place(idx, center):
+                commit(idx, center)
+                break
+        else:
+            return False
+    return True
+
+
+def _validate_scene(
+    inp: np.ndarray,
+    specs: list[dict],
+    overlap_pair: tuple[int, int] | None,
+    crop_index: int | None,
+) -> bool:
