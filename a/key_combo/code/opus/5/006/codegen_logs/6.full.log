+
+def _candidate_centers(spec: dict, shape: tuple[int, int], require_crop: bool) -> list[tuple[int, int]]:
+    h, w = shape
+    half = int(spec["side"]) // 2
+    centers = [(r, c) for r in range(half, h - half) for c in range(half, w - half)]
