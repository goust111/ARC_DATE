+        for _ in range(rot):
+            q = np.stack([q[:, 1], -q[:, 0]], axis=1)
+        for flip in (False, True):
+            t = q.copy()
+            if flip:
+                t[:, 1] *= -1
+            norm = _normalize_coords(t)
+            key = tuple(map(tuple, norm.tolist()))
+            if key not in seen:
