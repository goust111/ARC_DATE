+def _normalize_coords(coords: np.ndarray) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    arr = arr - arr.min(axis=0, keepdims=True)
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
