+            if any(_coords_set(cand["input_coords"]) & _coords_set(obj["input_coords"]) for obj in placed):
+                continue
+            if any(_coords_set(cand["dropped_coords"]) & _coords_set(obj["dropped_coords"]) for obj in placed):
