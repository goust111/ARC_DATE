+            objects = base_objects + [obj2a, obj2b]
+            input_sets = [_coords_set(obj["input_coords"]) for obj in objects]
+            dropped_sets = [_coords_set(obj["dropped_coords"]) for obj in objects]
+            if any(input_sets[i] & input_sets[j] for i in range(4) for j in range(i + 1, 4)):
