+        shifted = coords + np.array([dr, 0], dtype=int)
+        keep = (0 <= shifted[:, 0]) & (shifted[:, 0] < H) & (0 <= shifted[:, 1]) & (shifted[:, 1] < W)
+        kept = shifted[keep]
+        if kept.size == 0:
+            continue
+        rr = kept[:, 0]
+        cc = kept[:, 1]
+        if strict:
