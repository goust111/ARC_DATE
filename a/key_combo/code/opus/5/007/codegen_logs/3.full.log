+        rel_b = _quadrant_coords(shape_b, qb)
+        row_lo = max(-int(rel_a[:, 0].min()), -int(rel_b[:, 0].min()))
+        row_hi = min(H - 1 - int(rel_a[:, 0].max()), H - 1 - int(rel_b[:, 0].max()))
