+
+def _quadrant_coords(base: np.ndarray, quadrant: str) -> np.ndarray:
+    if quadrant == "NW":
+        return np.column_stack((-1 - base[:, 0], -1 - base[:, 1]))
+    if quadrant == "NE":
+        return np.column_stack((-1 - base[:, 0], 1 + base[:, 1]))
+    if quadrant == "SW":
+        return np.column_stack((1 + base[:, 0], -1 - base[:, 1]))
+    if quadrant == "SE":
