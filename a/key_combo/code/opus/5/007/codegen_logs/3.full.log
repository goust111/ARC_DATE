+    if np.array_equal(no_drop, out):
+        return False
+    if np.array_equal(bottom_drop, out):
+        return False
+    if np.array_equal(loose, out):
+        return False
+    if not _false_positive_gap_exists(expected_dropped):
+        return False
+    if len({int(obj["area"]) for obj in objects}) < 2:
+        return False
+    return True
