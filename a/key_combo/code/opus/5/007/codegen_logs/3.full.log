+
+    pair1 = random.choice([(color1, color2), (color2, color1)])
+    pair2 = random.choice([(color1, color2), (color2, color1)])
+    cand1 = _seam_candidates(H, W, pair1[0], pair1[1])
+    cand2 = _seam_candidates(H, W, pair2[0], pair2[1])
