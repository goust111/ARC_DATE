+
+
+def _shape_variants(shape: tuple[tuple[int, int], ...]) -> list[np.ndarray]:
+    pts = np.asarray(shape, dtype=int)
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    variants: list[np.ndarray] = []
