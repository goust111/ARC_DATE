+    extra_colors = [color1] * (counts[0] - 2) + [color2] * (counts[1] - 2)
+    random.shuffle(extra_colors)
+    require_clip = bool(extra_colors) and random.random() < 0.55
+
+    pair1 = random.choice([(color1, color2), (color2, color1)])
+    pair2 = random.choice([(color1, color2), (color2, color1)])
+    cand1 = _seam_candidates(H, W, pair1[0], pair1[1])
+    cand2 = _seam_candidates(H, W, pair2[0], pair2[1])
+    if not cand1 or not cand2:
+        return None
+
+    for obj1a, obj1b, seam1 in cand1[:40]:
+        base_objects = [obj1a, obj1b]
+        for obj2a, obj2b, seam2 in cand2[:60]:
+            seam_dist = abs(seam1[0] - seam2[0]) + abs(seam1[1] - seam2[1])
+            if seam_dist < 6:
+                continue
+            objects = base_objects + [obj2a, obj2b]
+            input_sets = [_coords_set(obj["input_coords"]) for obj in objects]
+            dropped_sets = [_coords_set(obj["dropped_coords"]) for obj in objects]
+            if any(input_sets[i] & input_sets[j] for i in range(4) for j in range(i + 1, 4)):
+                continue
+            if any(dropped_sets[i] & dropped_sets[j] for i in range(4) for j in range(i + 1, 4)):
+                continue
+            if not _input_boxes_are_separate(objects):
+                continue
+            full_objects = _place_extras(H, W, objects, extra_colors, require_clip=require_clip)
+            if full_objects is None:
+                continue
+            inp = _object_grid((H, W), full_objects, dropped=False)
+            if _validate_semantics(inp, full_objects, [seam1, seam2]):
+                return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        candidate = _build_candidate()
+        if candidate is not None:
+            return candidate
+    raise RuntimeError(f"failed to generate a valid sample after {MAX_GEN_ATTEMPTS} attempts")

