+_SHAPES_BY_AREA: dict[int, list[np.ndarray]] = {}
+for _shape in _BASE_SHAPES:
+    for _variant in _shape_variants(_shape):
+        _SHAPES_BY_AREA.setdefault(int(len(_variant)), []).append(_variant)
+
+
