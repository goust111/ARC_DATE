+    if quadrant == "NE":
+        return np.column_stack((-1 - base[:, 0], 1 + base[:, 1]))
+    if quadrant == "SW":
+        return np.column_stack((1 + base[:, 0], -1 - base[:, 1]))
+    if quadrant == "SE":
