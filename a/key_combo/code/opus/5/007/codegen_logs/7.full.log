+_GEN_COUNTER = 0
+_SIDE_CACHE: dict[tuple[str, tuple[int, int], tuple[int, int, int, int]], dict[tuple[int, int], list[tuple[tuple[tuple[int, int], ...], ...]]]] = {}
+_SIDE_TARGETS = ((1, 2), (2, 2), (2, 3), (2, 4))
