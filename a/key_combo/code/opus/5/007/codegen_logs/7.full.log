+        payload = np.array(
+            [[random.choice(PAYLOAD_COLORS) for _ in range(w)] for _ in range(h)],
+            dtype=int,
+        )
+        if len(set(map(int, payload.ravel()))) < 4:
+            continue
+        periodic = False
+        for dr in range(h):
