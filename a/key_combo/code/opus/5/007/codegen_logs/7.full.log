+        for src, other in ((p0, p1), (p1, p0)):
+            dr = int(np.sign(src[0] - other[0]))
+            dc = int(np.sign(src[1] - other[1]))
+            rr, cc = src[0] + dr, src[1] + dc
+            while _in_bounds(out.shape, rr, cc) and not blocked[rr, cc]:
