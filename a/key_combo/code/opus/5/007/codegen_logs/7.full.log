+    assert payload.size > 0, "payload missing"
+    rolled = np.roll(payload, shift=v % payload.shape[0], axis=0)
+    rolled = np.roll(rolled, shift=h % payload.shape[1], axis=1)
+    return rolled, v, h, painted
