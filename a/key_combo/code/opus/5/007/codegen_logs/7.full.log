+def _pick_segments_for_target(
+    kind: str,
+    shape: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+    target: tuple[int, int],
+) -> tuple[tuple[int, int], ...] | tuple[tuple[tuple[int, int], ...], ...]:
