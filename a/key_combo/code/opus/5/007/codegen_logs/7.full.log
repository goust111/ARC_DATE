+    seen = set()
+    for seg in candidates:
+        if seg not in seen:
+            seen.add(seg)
+            unique.append(seg)
+    return unique
+
+
+def _build_side_catalog(
+    kind: str,
+    shape: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+) -> dict[tuple[int, int], list[tuple[tuple[tuple[int, int], ...], ...]]]:
+    key = (kind, shape, frame_bbox)
+    if key in _SIDE_CACHE:
+        return _SIDE_CACHE[key]
