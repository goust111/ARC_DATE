+        if not placed:
+            return False
+    return True
+
+
+def _quadrant_of_point(center_r: int, center_c: int, r: int, c: int) -> str:
+    if r < center_r and c < center_c:
+        return "TL"
+    if r < center_r and c > center_c:
+        return "TR"
+    if r > center_r and c > center_c:
+        return "BR"
+    if r > center_r and c < center_c:
+        return "BL"
+    return "AXIS"
+
+
+def _can_place_marker(grid: np.ndarray, shape, origin_r: int, origin_c: int) -> bool:
