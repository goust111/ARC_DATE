+    if not _place_markers(grid, center_r, center_c, rng):
+        return None
+    if not _validate_candidate(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
