+    g = np.asarray(grid, dtype=int)
+    orientation, axis, grey_coords = _helper_info(g)
+
+    work = g.copy()
+    work[grey_coords[:, 0], grey_coords[:, 1]] = BG
+    return _complete_by_axis(work, orientation, axis)
