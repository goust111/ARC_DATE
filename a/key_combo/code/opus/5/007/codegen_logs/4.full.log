+    if orientation == "vertical":
+        if np.any(expected[:, axis] != BG):
+            return False
+        if not np.array_equal(expected, expected[:, ::-1] if axis * 2 == expected.shape[1] - 1 else expected):
+            pass
+        for c in range(expected.shape[1]):
