+def _render_vertical_pattern(shape: tuple[int, int], half: np.ndarray, axis: int, top: int) -> np.ndarray:
+    H, W = shape
+    out = np.zeros((H, W), dtype=int)
+    ph, pw = half.shape
+    for rr in range(ph):
+        for jj in range(pw):
+            color = int(half[rr, jj])
+            if color == BG:
+                continue
+            gr = int(top + rr)
+            left_c = int(axis - (jj + 1))
+            right_c = int(axis + (jj + 1))
+            out[gr, left_c] = color
+            out[gr, right_c] = color
+    return out
