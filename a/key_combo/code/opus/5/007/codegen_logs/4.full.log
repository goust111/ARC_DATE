+        return False
+
+    if true_orientation == "vertical":
+        if (bbox[1] + bbox[3]) % 2 != 0:
+            return True
+        wrong_axis = (bbox[1] + bbox[3]) // 2
+    else:
+        if (bbox[0] + bbox[2]) % 2 != 0:
+            return True
+        wrong_axis = (bbox[0] + bbox[2]) // 2
