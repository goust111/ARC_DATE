+
+    bbox = _bbox(clean != BG)
+    if bbox is None:
+        return False
+    if orientation == "vertical":
+        if bbox[1] + bbox[3] == 2 * axis:
+            return False
+    else:
+        if bbox[0] + bbox[2] == 2 * axis:
+            return False
+
+    if not _wrong_bbox_axis_differs(inp, expected, orientation, axis):
+        return False
+
+    colors = sorted(int(v) for v in np.unique(expected) if v != BG)
