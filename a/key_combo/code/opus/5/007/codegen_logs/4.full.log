+        out[0:2, axis] = GREY
+        return out, "top"
+    out[-2:, axis] = GREY
+    return out, "bottom"
+
+
+def _wrong_bbox_axis_differs(inp: np.ndarray, expected: np.ndarray, true_orientation: str, true_axis: int) -> bool:
+    clean = inp.copy()
+    clean[clean == GREY] = BG
