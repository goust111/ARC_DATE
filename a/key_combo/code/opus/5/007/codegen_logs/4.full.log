            return True
        wrong_axis = (bbox[0] + bbox[2]) // 2

    if wrong_axis == true_axis:
        return False
    wrong = _complete_by_axis(clean, true_orientation, int(wrong_axis))
    return not np.array_equal(wrong, expected)


