+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PATTERN_COLORS = (1, 2, 3, 4)
+GREY = 5
+
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (14, 20)
+MAX_GENERATION_ATTEMPTS = 500
