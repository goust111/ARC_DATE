+            mirror_c = 2 * int(axis) - int(c)
+            if mirror_c < 0 or mirror_c >= W or c > mirror_c:
+                continue
+            for r in range(H):
+                a = int(g[r, c])
+                b = int(g[r, mirror_c])
+                if a != BG and b != BG:
+                    assert a == b, f"conflicting mirrored colors at ({r},{c}) and ({r},{mirror_c})"
+                elif a == BG and b != BG:
