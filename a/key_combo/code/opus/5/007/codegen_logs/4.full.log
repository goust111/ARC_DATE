        grid[r0:r1+1, c0:c1+1] = fg
    else:
        grid[r0, c0:c1+1] = fg
        grid[r1, c0:c1+1] = fg
        grid[r0:r1+1, c0] = fg
        grid[r0:r1+1, c1] = fg
