+        if np.any(expected[axis, :] != BG):
+            return False
+        for r in range(expected.shape[0]):
+            mr = 2 * axis - r
+            if 0 <= mr < expected.shape[0]:
+                if not np.array_equal(expected[r, :], expected[mr, :]):
+                    return False
