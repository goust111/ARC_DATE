+def _validate_example(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    orientation: str,
+    axis: int,
+    hole_side: str,
+    hole_rect: tuple[int, int, int, int],
+) -> bool:
+    try:
+        solved = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(solved, expected):
