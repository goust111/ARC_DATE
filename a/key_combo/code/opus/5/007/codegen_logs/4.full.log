+                rw = random.randint(1, min(3, width))
+                rr = random.randint(0, height - rh)
+                cc = random.randint(0, width - rw)
+                region = patch[rr : rr + rh, cc : cc + rw]
+                if np.count_nonzero(region) > (2 * rh * rw) // 3:
+                    continue
+                patch[rr : rr + rh, cc : cc + rw] = int(color)
