+        return None
+    area_values = sorted(rng.choice(possible_areas, size=n, replace=False).tolist())
+
+    colors = rng.choice(np.array(SPRITE_COLORS, dtype=int), size=n, replace=False).tolist()
+    masks: list[np.ndarray] = []
+    for area in area_values:
