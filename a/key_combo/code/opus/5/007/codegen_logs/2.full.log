+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        inp = _gen_attempt(rng)
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid sparse-sprite tiling input")

