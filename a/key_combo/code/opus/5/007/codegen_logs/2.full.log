+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    n = int(rng.integers(2, 5))
+    feasible_sizes = [s for s in (3, 4, 5) if max(4, 5) * s <= 30 and 2 * s - 1 <= 9]
