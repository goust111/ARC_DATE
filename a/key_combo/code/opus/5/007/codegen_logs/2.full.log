+    br0, bc0, br1, bc1 = b
+    return ar0 - margin <= br1 and br0 - margin <= ar1 and ac0 - margin <= bc1 and bc0 - margin <= ac1
+
+
+def _render_scene(
+    sparse_patches: list[np.ndarray],
