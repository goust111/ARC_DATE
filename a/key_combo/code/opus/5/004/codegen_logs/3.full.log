+
+    bars = [(POS, height) for height in pos_heights] + [(NEG, height) for height in neg_heights]
+    random.shuffle(bars)
+
+    grid = np.zeros((h, width), dtype=int)
+    grid[:, sep_col] = SEP
+    c = left_pad
+    for color, height in bars:
