+import random
+
+import numpy as np
+
+
+BG = 0
+NEG = 2
+GREEN = 3
+SEP = 5
+POS = 8
+
+MAX_GENERATE_ATTEMPTS = 500
+REPEAT_CHOICES = [1, 2, 3]
+REPEAT_WEIGHTS = [2, 5, 3]
