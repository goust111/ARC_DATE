+    start = next(iter(coords))
+    stack = [start]
+    seen = {start}
+    while stack:
+        p = stack.pop()
+        for q in neighbors4(*p):
+            q = (int(q[0]), int(q[1]))
+            if q in coords and q not in seen:
+                seen.add(q)
+                stack.append(q)
