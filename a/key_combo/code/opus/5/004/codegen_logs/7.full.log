+        return int(values[counts.argmax()])
+
+
+    def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+        h, w = shape
+        return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+    def neighbors4(r: int, c: int):
+        yield int(r) - 1, int(c)
+        yield int(r) + 1, int(c)
+        yield int(r), int(c) - 1
+        yield int(r), int(c) + 1
+
+
+    def find_components(
+        grid: np.ndarray,
