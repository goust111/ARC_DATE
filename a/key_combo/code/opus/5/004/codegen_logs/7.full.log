+def _path_shape(mode: str, outward: Coord, axis: Coord) -> tuple[list[Coord], Coord, int]:
+    turn = axis if random.random() < 0.5 else _neg(axis)
+    cells = [outward]
+    current = cells[0]
+    bends = 0
