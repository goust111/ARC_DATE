+
+    square = {_add(_add((0, 0), proj, depth), axis, side) for depth in (1, 2, 3) for side in (-1, 0, 1)}
+    gate = (0, 0)
+    gate_ends = {_add(gate, axis, -1), _add(gate, axis, 1)}
+
+    colored: dict[Coord, int] = {p: PATH for p in path_cells}
+    colored[gate] = PATH
+    for p in gate_ends:
+        colored[p] = GATE_END
+    for p in square:
+        colored[p] = SQUARE
+    colored[marker] = MARKER
