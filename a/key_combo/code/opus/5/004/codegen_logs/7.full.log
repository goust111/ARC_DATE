+
+
+def _project_target(square_bbox: tuple[int, int, int, int], proj: Coord) -> Coord:
+    r0, c0, r1, c1 = square_bbox
+    if proj[0] != 0:
+        return (r0 if proj[0] > 0 else r1), c0 + 1
+    return r0 + 1, (c0 if proj[1] > 0 else c1)
