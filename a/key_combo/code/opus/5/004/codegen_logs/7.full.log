+    sq_r0, sq_c0, sq_r1, sq_c1 = rec["square_bbox"]
+
+    offsets: list[Coord] = []
+    for dr in range(-min_r, h - max_r):
+        for dc in range(-min_c, w - max_c):
+            if dr + sq_r0 <= 0 or dr + sq_r1 >= h - 1:
+                continue
+            if dc + sq_c0 <= 0 or dc + sq_c1 >= w - 1:
