+
+
+BG = 0
+PATH = 3
+MARKER = 5
+SQUARE = 6
+GATE_END = 9
+
+Coord = tuple[int, int]
+
+PROJ_DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
