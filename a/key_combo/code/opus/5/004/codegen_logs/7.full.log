+        "parking": shift(rec["parking"]),
+        "path_cells": path_cells,
+        "marker": shift(rec["marker"]),
+        "square_cells": square_cells,
+        "square_bbox": _bbox(square_cells),
+        "bends": rec["bends"],
+    }
