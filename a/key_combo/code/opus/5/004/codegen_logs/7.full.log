+def _add(a: Coord, b: Coord, k: int = 1) -> Coord:
+    return int(a[0] + b[0] * k), int(a[1] + b[1] * k)
+
+
+def _neg(v: Coord) -> Coord:
+    return -int(v[0]), -int(v[1])
