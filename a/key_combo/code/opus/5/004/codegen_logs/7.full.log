+            current = _add(current, outward)
+            cells.append(current)
+        for _ in range(random.randint(2, 5)):
+            current = _add(current, turn)
+            cells.append(current)
+        last_dir = turn
+        bends = 1
+    else:
+        for _ in range(random.randint(1, 3)):
+            current = _add(current, outward)
+            cells.append(current)
+        for _ in range(random.randint(1, 3)):
+            current = _add(current, turn)
+            cells.append(current)
+        for _ in range(random.randint(1, 3)):
+            current = _add(current, outward)
+            cells.append(current)
+        last_dir = outward
+        bends = 2
+
+    assert len(set(cells)) == len(cells)
