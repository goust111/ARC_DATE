+    rec = {
+        "colored": colored,
+        "proj": proj,
+        "axis": axis,
+        "gate": gate,
+        "parking": path_cells[0],
+        "path_cells": set(path_cells),
+        "marker": marker,
+        "square_cells": square,
+        "square_bbox": _bbox(square),
+        "bends": bends,
+    }
+
+    path_set = set(path_cells)
+    assert _connected(path_set)
+    assert sum(abs(marker[0] - p[0]) + abs(marker[1] - p[1]) == 1 for p in path_set) == 1
