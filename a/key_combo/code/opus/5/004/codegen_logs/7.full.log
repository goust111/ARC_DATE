+    rec = {
+        "colored": colored,
+        "proj": proj,
+        "axis": axis,
+        "gate": gate,
+        "parking": path_cells[0],
+        "path_cells": set(path_cells),
+        "marker": marker,
+        "square_cells": square,
+        "square_bbox": _bbox(square),
+        "bends": bends,
+    }
