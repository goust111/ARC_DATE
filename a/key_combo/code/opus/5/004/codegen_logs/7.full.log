+    local_records = [_make_component(PROJ_DIRS[name], base_modes[i]) for i, name in enumerate(selected)]
+    placed: list[dict[str, object]] = []
+    occupied: set[Coord] = set()
+
+    order = list(range(n))
+    random.shuffle(order)
+    for idx in order:
