+    r0, c0, r1, c1 = square_bbox
+    assert (r1 - r0, c1 - c0) == (2, 2), "square must be exactly 3x3"
+    assert magentas == {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
