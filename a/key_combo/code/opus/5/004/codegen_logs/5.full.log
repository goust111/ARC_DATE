+            order[color] = idx
+            idx += 1
+    return order
+
+
+def _run_sequence(color: int, count: int) -> list[int]:
+    values: list[int] = []
+    lengths = list(range(1, count + 1)) + list(range(count - 1, 0, -1))
+    for idx, seg_len in enumerate(lengths):
