+    return dict(counts)
+
+
+def _appearance_order(grid: np.ndarray) -> dict[int, int]:
+    order: dict[int, int] = {}
+    idx = 0
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
