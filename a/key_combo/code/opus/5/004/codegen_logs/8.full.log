+            valid = set(int(v) for v in np.unique(grid) if int(v) != bg)
+        else:
+            valid = {int(v) for v in colors if int(v) != bg}
+        out = []
+        for r in range(grid.shape[0]):
+            for c in range(grid.shape[1]):
+                color = int(grid[r, c])
+                if seen[r, c] or color == bg or color not in valid:
+                    continue
+                q = deque([(r, c)])
+                seen[r, c] = True
+                coords = []
+                while q:
