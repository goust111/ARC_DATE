+            return None
+
+    extra_target = random.randint(0, EXTRA_BAR_MAX)
+    for _ in range(extra_target):
+        bar = _sample_extra_bar(shape, bars)
+        if bar is not None:
+            bars.append(bar)
+
+    if not _semantic_ok(shape, bars):
+        return None
+
+    grid = np.full(shape, BG, dtype=int)
+    for bar in bars:
+        for r, c in _bar_cells(bar):
+            grid[r, c] = INPUT_FG
+    return grid
+
