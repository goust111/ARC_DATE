+                color = int(grid[r, c])
+                if seen[r, c] or color == bg or color not in valid:
+                    continue
+                q = deque([(r, c)])
+                seen[r, c] = True
+                coords = []
+                while q:
+                    cr, cc = q.popleft()
+                    coords.append((cr, cc))
+                    for dr, dc in dirs:
+                        nr, nc = cr + dr, cc + dc
+                        if not in_bounds(grid.shape, nr, nc) or seen[nr, nc]:
+                            continue
