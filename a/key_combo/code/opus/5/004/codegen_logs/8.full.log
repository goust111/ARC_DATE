+INPUT_FG = 8
+GREEN = 3
+RED = 2
+ODD_LENGTHS = (3, 5, 7)
+GRID_SIZE_RANGE = (11, 15)
+CORE_PAIR_COUNT_OPTIONS = (2, 2, 3)
