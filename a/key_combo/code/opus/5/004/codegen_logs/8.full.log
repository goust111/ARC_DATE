+    return False
+
+
+def _semantic_ok(shape: tuple[int, int], bars: list[Bar]) -> bool:
+    if sum(bar.orient == "H" for bar in bars) < 2:
+        return False
+    if sum(bar.orient == "V" for bar in bars) < 2:
