+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+MARKER_COLORS = (4, 6, 8, 9)
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+NEIGHBORS8 = [
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+]
+
+MAX_GENERATE_ATTEMPTS = 400
+ANGLE_EPS = 1e-6
