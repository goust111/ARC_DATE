+        _line_points((size, size + gap_h + mid), (size + gap_v - 1, size + gap_h + mid)),
+        _line_points((size + gap_v + mid, size + gap_h - 1), (size + gap_v + mid, size)),
+        _line_points((size + gap_v - 1, mid), (size, mid)),
