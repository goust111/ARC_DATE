+    r0, c0, r1, c1 = bbox
+    out: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        out.add((r0, c))
+        out.add((r1, c))
+    for r in range(r0, r1 + 1):
+        out.add((r, c0))
+        out.add((r, c1))
+    return out
+
+
+def _validate_blue_cycle(grid: np.ndarray, frame_infos: list[dict]) -> None:
+    blue_comps = _components(grid == BLUE, connectivity=8)
