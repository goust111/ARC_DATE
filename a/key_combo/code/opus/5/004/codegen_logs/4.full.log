    """Generate an 8-connected mask for frame interior with fill 30-56%."""
    n = interior_size
    total = n * n
    min_fill = max(MIN_INTERIOR_CELLS, int(math.ceil(MIN_INTERIOR_FILL * total)))
    max_fill = int(math.floor(MAX_INTERIOR_FILL * total))
