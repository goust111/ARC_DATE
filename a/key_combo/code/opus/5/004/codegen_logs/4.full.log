+            patterns.append({"axis": "h", "endpoint_side": "right", "hinge": (n - 1 - h, h)})
+            patterns.append({"axis": "v", "endpoint_side": "top", "hinge": (h, h)})
+            patterns.append({"axis": "v", "endpoint_side": "bottom", "hinge": (h, n - 1 - h)})
