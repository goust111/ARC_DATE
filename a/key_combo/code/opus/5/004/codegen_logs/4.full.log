+            local = np.zeros((n, n), dtype=int)
+            rod, endpoint, hinge = _build_input_rod(n, pat)
+            for r, c in rod:
+                local[r, c] = GREEN
+            local[endpoint] = GREY
+            local[hinge] = ORANGE
