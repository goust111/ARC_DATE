+    assert 3 <= len(frame_infos) <= 4, "expected 3 or 4 valid frames"
+    marker_colors = [info["marker_color"] for info in frame_infos]
+    assert len(set(marker_colors)) == len(marker_colors), "frame marker colors must be distinct"
