+        rod = [(row, c) for c in range(n)]
+        endpoint = (row, 0) if endpoint_side == "left" else (row, n - 1)
+    else:
+        col = hinge[1]
+        rod = [(r, col) for r in range(n)]
+        endpoint = (0, col) if endpoint_side == "top" else (n - 1, col)
+    return rod, endpoint, hinge
