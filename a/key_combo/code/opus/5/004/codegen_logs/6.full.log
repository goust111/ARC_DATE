+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        rng = random.Random()
+        grid = _vertical_attempt(rng)
+        if grid is None:
+            continue
+        grid = _augment_and_orient(grid, rng)
+        if _validate_generated(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid mirrored-safe-path puzzle")

