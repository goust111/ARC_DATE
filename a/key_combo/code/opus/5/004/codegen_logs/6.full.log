+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _in_bounds(shape, r, c):
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r, c):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _reflect(coord, axis_kind, axis_idx):
+    r, c = coord
+    if axis_kind == "row":
+        return 2 * axis_idx - r, c
+    return r, 2 * axis_idx - c
+
+
+def _line(a, b):
+    r0, c0 = a
+    r1, c1 = b
+    if r0 != r1 and c0 != c1:
+        raise ValueError("polyline segments must be axis-aligned")
+    out = []
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            out.append((r0, c))
+    else:
+        step = 1 if r1 >= r0 else -1
+        for r in range(r0, r1 + step, step):
+            out.append((r, c0))
+    return out
+
+
+def _polyline(points):
+    cells = []
+    for idx in range(len(points) - 1):
+        seg = _line(points[idx], points[idx + 1])
+        if idx:
+            seg = seg[1:]
+        cells.extend(seg)
+    return cells
+
+
+def _build_graph_nodes(grid, forbidden):
+    nodes = set()
+    for r, c in np.argwhere((grid == TEAL) | (grid == MAROON)):
+        rr = int(r)
+        cc = int(c)
+        if not forbidden[rr, cc]:
+            nodes.add((rr, cc))
+    return nodes
+
+
+def _endpoints(grid, forbidden):
+    pts = []
+    for r, c in np.argwhere(grid == MAROON):
+        rr = int(r)
+        cc = int(c)
+        if not forbidden[rr, cc]:
+            pts.append((rr, cc))
+    return pts
+
+
+def _adjacent_nodes(nodes, cell, blocked_edge=None):
+    out = []
+    for nxt in _neighbors4(*cell):
+        if nxt not in nodes:
+            continue
+        if blocked_edge is not None and ((cell, nxt) == blocked_edge or (nxt, cell) == blocked_edge):
+            continue
+        out.append(nxt)
+    return out
+
+
+def _bfs_path(nodes, start, goal):
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for nxt in _adjacent_nodes(nodes, cur):
+            if nxt in parent:
+                continue
+            parent[nxt] = cur
+            q.append(nxt)
+    if goal not in parent:
+        return None
+    path = []
+    cur = goal
+    while cur is not None:
