+    r0, c0 = a
+    r1, c1 = b
+    if r0 != r1 and c0 != c1:
+        raise ValueError("polyline segments must be axis-aligned")
+    out = []
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        for c in range(c0, c1 + step, step):
+            out.append((r0, c))
+    else:
+        step = 1 if r1 >= r0 else -1
+        for r in range(r0, r1 + step, step):
+            out.append((r, c0))
+    return out
