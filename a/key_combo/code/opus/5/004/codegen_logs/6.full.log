+def _bfs_path(nodes, start, goal):
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for nxt in _adjacent_nodes(nodes, cur):
+            if nxt in parent:
+                continue
+            parent[nxt] = cur
+            q.append(nxt)
