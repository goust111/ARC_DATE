+
+
+def _select_side_spec(minority: str) -> dict[str, tuple[int, ...]]:
+    if not _SIDE_SPEC_CACHE:
+        cache = {
+            NW_SE: defaultdict(list),
+            NE_SW: defaultdict(list),
+        }
