+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+AXIS = 5
+SOURCE = 7
+MIRROR_NW_SE = 2
+MIRROR_NE_SW = 8
+
+NW_SE = "nw_se"
+NE_SW = "ne_sw"
+ORIENTATIONS = (NW_SE, NE_SW)
+SIDES = (0, 1)
+
+GRID_MIN = 13
+GRID_MAX = 19
+MAX_ATTEMPTS = 400
+
+_SIDE_SPEC_CACHE: dict[str, dict[str, list[dict[str, tuple[int, ...]]]]] = {}
