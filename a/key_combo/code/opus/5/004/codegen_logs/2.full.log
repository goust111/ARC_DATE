+        if chosen_mirror is not None:
+            _mark_buffer(blocked, chosen_mirror)
+        placed.append(
+            {
+                "side": int(req["side"]),
+                "orientation": str(req["orientation"]),
+                "cells": chosen,
+                "reflect": bool(req["reflect"]),
+            }
+        )
