+def _parse_scene(grid: np.ndarray) -> tuple[tuple[str, int], list[dict[str, object]], dict[int, dict[str, dict[str, int]]]]:
+    axis = _find_axis(grid)
+    orange_comps = _components(grid == SOURCE)
