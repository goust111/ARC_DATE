+def _component_side(axis_kind: str, axis_index: int, coords: np.ndarray) -> int:
+    if axis_kind == "row":
+        rows = coords[:, 0]
+        if int(rows.max()) < axis_index:
+            return 0
+        if int(rows.min()) > axis_index:
+            return 1
+    else:
+        cols = coords[:, 1]
+        if int(cols.max()) < axis_index:
+            return 0
+        if int(cols.min()) > axis_index:
+            return 1
