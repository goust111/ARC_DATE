+    h0, w0 = patch.shape
+
+    def rotate_coord(coord: tuple[int, int], k: int) -> tuple[int, int]:
+        r, c = coord
+        hh, ww = h0, w0
+        for _ in range(k):
+            r, c, hh, ww = ww - 1 - c, r, ww, hh
