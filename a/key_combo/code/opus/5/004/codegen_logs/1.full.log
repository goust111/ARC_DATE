+def _notch_gap_index(line: np.ndarray) -> int | None:
+    idx = np.flatnonzero(line)
+    if idx.size < 2:
+        return None
+    lo = int(idx[0])
+    hi = int(idx[-1])
+    missing = np.flatnonzero(~line[lo : hi + 1]) + lo
+    if missing.size != 1:
+        return None
+    return int(missing[0])
