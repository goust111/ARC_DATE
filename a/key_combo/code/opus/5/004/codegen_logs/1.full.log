+        )
+
+    gap = _notch_gap_index(patch[-1, :])
+    if gap is not None:
+        candidates.append(
+            {"direction": "down", "start": (r1 + 1, c0 + gap), "step": DIR_TO_STEP["down"]}
+        )
+
+    gap = _notch_gap_index(patch[:, 0])
+    if gap is not None:
+        candidates.append(
