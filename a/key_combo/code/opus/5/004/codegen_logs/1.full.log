+
+
+def _ray_path_to_edge(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    step: tuple[int, int],
+    ray_reserved: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    r, c = start
+    dr, dc = step
+    path: list[tuple[int, int]] = []
