+def _component_notch(grid: np.ndarray, coords: np.ndarray) -> dict[str, object] | None:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1] == BLUE
+
+    candidates: list[dict[str, object]] = []
+
+    gap = _notch_gap_index(patch[0, :])
+    if gap is not None:
