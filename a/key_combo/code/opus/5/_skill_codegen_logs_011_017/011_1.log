+    out = g.copy()
+
+    objects: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(g) if v not in (BG, SEED)):
+        mask = g == color
+        for comp in _components_mask(mask):
+            area = int(comp.shape[0])
+            if area == 1:
