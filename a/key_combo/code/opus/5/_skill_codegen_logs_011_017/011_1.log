+                if _raw_symmetry(mask) != "horizontal":
+                    continue
+                seeds = []
+                for r in range(h):
+                    for c in range(w):
+                        if mask[r, c]:
+                            continue
+                        seed = (r, c)
+                        if not _seed_off_axis(seed, "horizontal", mask.shape):
+                            continue
+                        reached = _reachable_local(mask, seed, "horizontal")
+                        if 2 <= len(reached) < area:
+                            seeds.append(seed)
+                if len(seeds) >= 2:
