+
+
+def _validate_generated_scene(inp: np.ndarray, metadata: dict) -> None:
+    assert inp.ndim == 2 and max(inp.shape) <= 30
+    assert len(metadata["objects"]) == metadata["count"]
+    colors = [obj["color"] for obj in metadata["objects"]]
