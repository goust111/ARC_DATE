+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SEED = 5
+FILL = 7
+OBJECT_COLORS = [1, 2, 3, 4, 6, 8, 9]
+
+GEN_ATTEMPTS = 400
+GRID_SIDE_RANGE = (15, 20)
+OBJECT_COUNT_RANGE = (3, 5)
+NOISE_COUNT_RANGE = (1, 3)
+MIN_OBJECT_AREA = 5
+MAX_OBJECT_AREA = 12
