+    for color in sorted(int(v) for v in np.unique(g) if v not in (BG, SEED)):
+        mask = g == color
+        for comp in _components_mask(mask):
+            area = int(comp.shape[0])
+            if area == 1:
+                r, c = map(int, comp[0])
+                out[r, c] = BG
+                continue
+
+            r0, c0, r1, c1 = _bbox(comp)
+            local_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
