+    return None
+
+
+def _expected_from_metadata(inp: np.ndarray, metadata: dict) -> np.ndarray:
+    out = inp.copy()
+    for r, c in metadata["noise"]:
+        out[r, c] = BG
+
+    for obj in metadata["objects"]:
