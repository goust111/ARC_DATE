+def _seed_off_axis(seed: tuple[int, int], symmetry: str, shape: tuple[int, int]) -> bool:
+    r, c = seed
+    h, w = shape
+    if symmetry == "horizontal":
+        return not (h % 2 == 1 and r == h // 2)
+    if symmetry == "vertical":
