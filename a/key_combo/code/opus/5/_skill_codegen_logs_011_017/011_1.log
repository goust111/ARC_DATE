+                for nc in range(cc - 1, cc + 2):
+                    if 0 <= nr < gh and 0 <= nc < gw and occupied[nr, nc]:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+
