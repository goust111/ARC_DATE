+
+def _place_patch(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    reserved: np.ndarray,
+    mask: np.ndarray,
+    seed: tuple[int, int],
+    color: int,
+) -> tuple[int, int] | None:
+    h, w = mask.shape
+    gh, gw = grid.shape
+    candidates = [(r0, c0) for r0 in range(gh - h + 1) for c0 in range(gw - w + 1)]
+    random.shuffle(candidates)
+
+    fg_local = {(int(r), int(c)) for r, c in np.argwhere(mask)}
+    fg_local.add((int(seed[0]), int(seed[1])))
+    for r0, c0 in candidates:
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(gh, r0 + h + 1)
+        cc1 = min(gw, c0 + w + 1)
+        if reserved[rr0:rr1, cc0:cc1].any():
+            continue
+        ok = True
+        for dr, dc in fg_local:
+            rr = r0 + dr
+            cc = c0 + dc
+            for nr in range(rr - 1, rr + 2):
+                for nc in range(cc - 1, cc + 2):
+                    if 0 <= nr < gh and 0 <= nc < gw and occupied[nr, nc]:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        for dr, dc in np.argwhere(mask):
+            grid[r0 + int(dr), c0 + int(dc)] = int(color)
+            occupied[r0 + int(dr), c0 + int(dc)] = True
+        sr, sc = seed
+        grid[r0 + sr, c0 + sc] = SEED
+        occupied[r0 + sr, c0 + sc] = True
+        reserved[rr0:rr1, cc0:cc1] = True
+        return r0, c0
+    return None
+
+
+def _place_noise(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    reserved: np.ndarray,
+    color: int,
+) -> tuple[int, int] | None:
+    gh, gw = grid.shape
+    candidates = [(r, c) for r in range(gh) for c in range(gw)]
+    random.shuffle(candidates)
+    for r, c in candidates:
+        if reserved[r, c]:
+            continue
+        ok = True
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if 0 <= nr < gh and 0 <= nc < gw and occupied[nr, nc]:
+                    ok = False
+                    break
+            if not ok:
+                break
+        if ok:
+            grid[r, c] = int(color)
+            occupied[r, c] = True
+            return r, c
+    return None
+
