+def _generate_attempt() -> tuple[np.ndarray, dict] | None:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
+    count = random.randint(*OBJECT_COUNT_RANGE)
