+
+
+def _place_noise(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    reserved: np.ndarray,
+    color: int,
+) -> tuple[int, int] | None:
+    gh, gw = grid.shape
+    candidates = [(r, c) for r in range(gh) for c in range(gw)]
+    random.shuffle(candidates)
+    for r, c in candidates:
+        if reserved[r, c]:
+            continue
+        ok = True
+        for nr in range(r - 1, r + 2):
