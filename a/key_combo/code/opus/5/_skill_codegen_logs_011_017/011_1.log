+
+def _build_diagonal_library() -> list[dict]:
+    library: list[dict] = []
+    for n in range(3, 6):
+        tri = n * (n + 1) // 2
+        positions = [(r, c) for r in range(n) for c in range(r, n)]
+        for bits in range(1 << tri):
