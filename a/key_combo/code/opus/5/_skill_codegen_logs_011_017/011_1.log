+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        result = _generate_attempt()
+        if result is not None:
+            return result[0]
+    raise RuntimeError("failed to generate a valid symmetry-gated flood-fill puzzle")

