+            local_seed_cells = np.argwhere(g[r0 : r1 + 1, c0 : c1 + 1] == SEED)
+            assert local_seed_cells.shape[0] == 1, "each object bbox must contain exactly one seed"
+            sr, sc = map(int, local_seed_cells[0])
