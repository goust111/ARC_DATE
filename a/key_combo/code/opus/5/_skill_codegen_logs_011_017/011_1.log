+
+
+def _place_patch(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    reserved: np.ndarray,
+    mask: np.ndarray,
+    seed: tuple[int, int],
+    color: int,
+) -> tuple[int, int] | None:
+    h, w = mask.shape
+    gh, gw = grid.shape
+    candidates = [(r0, c0) for r0 in range(gh - h + 1) for c0 in range(gw - w + 1)]
