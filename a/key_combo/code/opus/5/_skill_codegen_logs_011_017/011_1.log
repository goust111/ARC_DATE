+    candidates = [(r, c) for r in range(gh) for c in range(gw)]
+    random.shuffle(candidates)
+    for r, c in candidates:
+        if reserved[r, c]:
+            continue
+        ok = True
+        for nr in range(r - 1, r + 2):
