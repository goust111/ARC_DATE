+                        ok = False
+                        break
+                if not ok:
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        for dr, dc in np.argwhere(mask):
+            grid[r0 + int(dr), c0 + int(dc)] = int(color)
+            occupied[r0 + int(dr), c0 + int(dc)] = True
+        sr, sc = seed
+        grid[r0 + sr, c0 + sc] = SEED
+        occupied[r0 + sr, c0 + sc] = True
+        return r0, c0
+    return None
+
+
+def _place_noise(grid: np.ndarray, occupied: np.ndarray, color: int) -> tuple[int, int] | None:
+    gh, gw = grid.shape
+    candidates = [(r, c) for r in range(gh) for c in range(gw)]
+    random.shuffle(candidates)
+    for r, c in candidates:
+        ok = True
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
