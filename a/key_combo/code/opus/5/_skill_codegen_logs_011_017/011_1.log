+        reached = _reachable_local(obj["mask"], obj["seed"], obj["symmetry"])
+        for dr, dc in reached:
+            out[r0 + dr, c0 + dc] = FILL
+        sr, sc = obj["seed"]
+        out[r0 + sr, c0 + sc] = FILL
