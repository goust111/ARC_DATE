+
+def _build_horizontal_library() -> list[dict]:
+    library: list[dict] = []
+    for h in range(3, 6):
+        half = (h + 1) // 2
+        for w in range(3, 6):
+            for bits in range(1 << (half * w)):
+                top = np.array([(bits >> i) & 1 for i in range(half * w)], dtype=bool).reshape(half, w)
+                if h % 2 == 0:
+                    mask = np.vstack([top, top[::-1]])
+                else:
