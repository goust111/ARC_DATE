+def _render(rects: list[dict], refs: list[dict]) -> np.ndarray:
+    placed: list[tuple[int, int, int, bool]] = []
+    total_w = 0
+    for rect, ref in zip(rects, refs):
+        r0, c0, r1, c1 = rect["bbox"]
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
