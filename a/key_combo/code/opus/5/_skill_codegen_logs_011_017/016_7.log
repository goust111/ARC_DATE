+    refs = find_components(grid, allowed_colors=obj_colors, col_range=(sep_col + 1, grid.shape[1]))
+    refs = [ref for ref in refs if ref["area"] == 1]
+    refs.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
