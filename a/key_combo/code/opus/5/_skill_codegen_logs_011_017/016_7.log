    match_flags: list[bool],
) -> np.ndarray:
    rows, height = _layout_rows(dims, colors)
    max_width = max(w for _, w in dims)
    left_span = max_width + 3 + (sum(colors) % 2)
    sep_col = left_span
    ref_col = sep_col + 2 + (sum(w for _, w in dims) % 2)
    width = ref_col + 2

