+BG = 0
+SEP = 5
+OUTPUT_HEIGHT = 10
+GAP = 1
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MIN_RECTS = 3
+MAX_RECTS = 5
+MAX_GEN_ATTEMPTS = 400
