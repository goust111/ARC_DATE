+    row_gaps = {rows[i + 1] - rows[i] for i in range(len(rows) - 1)}
+    col_gaps = {cols[i + 1] - cols[i] for i in range(len(cols) - 1)}
+    assert row_gaps.issubset({3, 4}) and col_gaps.issubset({3, 4})
+    return rows, cols
