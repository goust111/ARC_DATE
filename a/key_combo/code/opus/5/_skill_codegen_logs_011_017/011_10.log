+    crop_rows_choices = [n for n in (4, 5) if n <= total_row_cells and total_row_cells - n >= 1]
+    crop_cols_choices = [n for n in (4, 6) if n <= total_col_cells - 1]
+    if not crop_rows_choices or not crop_cols_choices:
