+
+    horiz_cells, horiz_pairs, vert_allowed, vert_blocked = _analyze_pairs(nodes, cell_rows, cell_cols)
+    assert len(horiz_pairs) >= 2
+    assert vert_allowed
+    assert vert_blocked
+    assert horiz_cells
