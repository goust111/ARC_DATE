+    cols = sorted({c for _r, c in missing})
+    assert len(rows) == 2 and len(cols) == 2
+    expected = {(rows[0], cols[0]), (rows[0], cols[1]), (rows[1], cols[0]), (rows[1], cols[1])}
+    assert set(missing) == expected
+    return rows[0], cols[0], rows[1], cols[1]
