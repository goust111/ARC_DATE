+import random
+from typing import Any
+
+import numpy as np
+
+
+COLORS = (1, 2, 3)
+PATTERNS = (
+    ("valid", "single", "valid"),
+    ("valid", "uniform", "valid"),
+    ("single", "valid", "uniform", "valid"),
+    ("uniform", "valid", "single", "valid"),
+    ("valid", "uniform", "valid", "single"),
+)
+GEN_RETRIES = 400
