+    candidates = [(r0, c0) for r0 in range(0, h - ph + 1) for c0 in range(col_min, col_max + 1)]
+    random.shuffle(candidates)
+    for r0, c0 in candidates:
+        if not np.any(blocked[r0 : r0 + ph, c0 : c0 + pw] & patch):
