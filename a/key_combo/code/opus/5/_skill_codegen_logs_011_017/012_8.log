+        frontier = set()
+        for r, c in cells:
+            for dr, dc in DIRS8:
+                nr, nc = r + dr, c + dc
+                if abs(nr) <= 2 and abs(nc) <= 2 and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
