+import math
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_mask(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if int(connectivity) == 4:
+        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        dirs = DIRS8
+
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _shape_patch_from_coords(coords: set[tuple[int, int]]) -> np.ndarray:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, c0 = min(rows), min(cols)
+    r1, c1 = max(rows), max(cols)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        patch[r - r0, c - c0] = True
+    return patch
+
+
+def _random_component_patch(size: int) -> np.ndarray:
+    size = int(size)
+    cells = {(0, 0)}
+    while len(cells) < size:
+        frontier = set()
+        for r, c in cells:
+            for dr, dc in DIRS8:
+                nr, nc = r + dr, c + dc
+                if abs(nr) <= 2 and abs(nc) <= 2 and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        cells.add(random.choice(tuple(frontier)))
+    patch = _shape_patch_from_coords(cells)
+    if random.choice([False, True]):
+        patch = np.flipud(patch)
+    if random.choice([False, True]):
+        patch = np.fliplr(patch)
+    if random.choice([False, True]):
+        patch = patch.T.copy()
+    return patch.astype(bool)
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for dr, dc in DIRS8:
+        rs0 = max(0, -dr)
+        rs1 = min(h, h - dr)
+        cs0 = max(0, -dc)
+        cs1 = min(w, w - dc)
+        out[rs0:rs1, cs0:cs1] |= mask[rs0 + dr : rs1 + dr, cs0 + dc : cs1 + dc]
+    return out
