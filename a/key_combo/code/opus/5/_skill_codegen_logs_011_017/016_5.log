+            r1 = _rotate_mask(m1, turns[pair_i])
+            r2 = _rotate_mask(m2, turns[pair_j])
+            inter = int((r1 & r2).sum())
+            if inter < 1:
+                continue
+            if not (r1 & ~r2).any():
+                continue
+            if not (r2 & ~r1).any():
+                continue
+            masks[pair_i] = m1
+            masks[pair_j] = m2
+            occupied |= m1 | m2
+            ok_pair = True
+            break
+        if not ok_pair:
+            continue
+
+        ok = True
+        for idx in range(k):
+            if masks[idx] is not None:
+                continue
+            size = rng.randint(2, min(6, n))
+            picked = None
+            for _ in range(120):
