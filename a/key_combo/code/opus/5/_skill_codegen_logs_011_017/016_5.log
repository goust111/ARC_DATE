+    for r, c in chosen:
+        mask[r, c] = True
+    return mask
+
+
+def _build_instruction_masks(n: int, turns: list[int], rng: random.Random) -> list[np.ndarray] | None:
+    k = len(turns)
+    pair_i, pair_j = rng.sample(range(k), 2)
+    for _ in range(300):
