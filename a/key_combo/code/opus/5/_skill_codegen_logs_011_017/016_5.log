+        grid = _build_grid(square, instruction_colors, areas, rng)
+        if max(grid.shape) > 30:
+            continue
+        try:
+            _validate_generated(grid)
+        except Exception:
+            continue
+        return grid
+    raise RuntimeError("failed to generate valid input for dual-channel color-layer rotation task")

