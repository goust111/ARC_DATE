+    for dr, dc in DIRS4:
+        rr = int(r + dr)
+        cc = int(c + dc)
+        if in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):
+            dirs.append((dr, dc))
+    return dirs
