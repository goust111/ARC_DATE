+
+    marker_dists = [int(marker["dist"]) for marker in info["markers"]]
+    assert len(marker_dists) == len(set(marker_dists)), "marker distances must be unique"
+
+    for marker in info["markers"]:
+        r, c = marker["pos"]
+        out[int(r), int(c)] = _EMPTY
+
