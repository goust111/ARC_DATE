+            for r, c in cells:
+                grid[r, c] = GREY
+                occupied[r, c] = True
+                gray_mask[r, c] = True
+    return grid
+
+
+def _apply_random_transform(grid: np.ndarray) -> np.ndarray:
+    out = np.rot90(grid, random.randint(0, 3))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    return np.array(out, dtype=int, copy=True)
