+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    base = _build_canonical_base()
+    if base is None:
+        return None
+    with_regions = _add_regions(base)
+    if with_regions is None:
+        return None
+    transformed = _apply_random_transform(with_regions)
+    if not _validate_semantics(transformed):
+        return None
+    return transformed
