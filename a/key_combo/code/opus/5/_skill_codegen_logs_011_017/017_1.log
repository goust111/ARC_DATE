+
+    current_row = 1
+    current_col = cols[0]
+    for i, turn_row in enumerate(rows):
+        vertical = [(r, current_col) for r in range(current_row + 1, turn_row + 1)]
+        if len(vertical) < 2:
+            return None
+        if any(cell in occupied for cell in vertical):
+            return None
+        for cell in vertical:
+            occupied.add(cell)
+        path_cells.extend(vertical)
+
