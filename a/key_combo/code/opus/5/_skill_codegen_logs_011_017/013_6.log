+BAR = Color.GREEN
+SEED = Color.YELLOW
+TRACE = Color.PINK
+
+ARM_OFFSETS = (
+    (0, -3),
+    (0, -2),
+    (0, 2),
+    (0, 3),
+    (-3, 0),
+    (-2, 0),
+    (2, 0),
+    (3, 0),
+)
+GAP_OFFSETS = ((0, -1), (0, 1), (-1, 0), (1, 0))
+HELPER_MAGNITUDES = ((1, 1), (1, 2), (2, 1), (2, 2))
