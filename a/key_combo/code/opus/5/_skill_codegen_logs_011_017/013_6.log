+
+def _place_distractors(
+    grid: np.ndarray, groups: list[dict], rng: np.random.Generator
+) -> None:
+    forbidden = set()
+    for group in groups:
+        center = group["center"]
+        forbidden.update(_center_bar_cells(center))
+        forbidden.add(center)
+        forbidden.add(group["helper"])
