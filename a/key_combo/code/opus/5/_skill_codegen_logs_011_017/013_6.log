+def _path_cells_from_seed(seed: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    dr, dc = direction
+    cells = set()
+    step = 1
+    while True:
+        rr = seed[0] + 2 * step * dr
+        cc = seed[1] + 2 * step * dc
+        if not in_bounds(shape, rr, cc):
+            break
+        cells.add((int(rr), int(cc)))
+        step += 1
+    return cells
+
