+    out = main(grid)
+    sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest()
+    if sig in _SEEN_OUTPUT_SIGS:
+        return None
+    _SEEN_OUTPUT_SIGS.add(sig)
