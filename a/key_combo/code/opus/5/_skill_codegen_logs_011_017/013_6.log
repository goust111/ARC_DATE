+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+
+    phase = _GEN_CALL_COUNT % 4
+    _GEN_CALL_COUNT += 1
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(phase)
+        if grid is not None:
