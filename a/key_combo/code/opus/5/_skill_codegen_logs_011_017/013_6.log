+        for c in range(3, w - 3):
+            if _is_implied_plus_center(grid, r, c):
+                centers.append((r, c))
+    return centers
+
+
+def _helper_candidates(grid: np.ndarray, center: tuple[int, int]) -> list[tuple[int, int]]:
