+            dc = cc - c0
+            if dr == 0 or dc == 0:
+                continue
+            if 1 <= abs(dr) <= 2 and 1 <= abs(dc) <= 2 and int(grid[rr, cc]) == HELPER:
+                coords.append((rr, cc))
+    return coords
+
+
+def _detect_centers_and_directions(
+    grid: np.ndarray,
+) -> tuple[list[tuple[int, int]], dict[tuple[int, int], tuple[int, int]], dict[tuple[int, int], tuple[int, int]]]:
