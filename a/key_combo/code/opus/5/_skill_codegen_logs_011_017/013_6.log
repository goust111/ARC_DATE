+    exact_idx = int(rng.integers(0, len(groups))) if force_exact_helper else None
+    offpath_idx = int(rng.integers(0, len(groups)))
+    for idx, group in enumerate(groups):
+        if idx == exact_idx:
+            mode = "exact"
+        elif offpath_only or idx == offpath_idx:
+            mode = "offpath"
+        else:
+            mode = "any"
