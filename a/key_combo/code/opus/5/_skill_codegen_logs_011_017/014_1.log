+def _marker_cells(center: tuple[int, int], step: tuple[int, int]) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    r, c = center
+    if step[0] != 0:
+        bar = [(r, c - 1), (r, c), (r, c + 1)]
+    else:
