11: def _find_marker_bar(g: np.ndarray, bg: int) -> tuple[int, str, tuple[int, int]]:
12:     colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
13:     candidates: list[tuple[int, str, tuple[int, int]]] = []
14: 
15:     for color in colors:
16:         coords = np.argwhere(g == int(color))
17:         if coords.shape[0] != 3:
18:             continue
19: 
20:         rows = sorted(set(map(int, coords[:, 0])))
21:         cols = sorted(set(map(int, coords[:, 1])))
22:         if len(rows) == 1 and len(cols) == 3 and cols == list(range(cols[0], cols[0] + 3)):
23:             candidates.append((int(color), "horizontal", (rows[0], cols[1])))
24:         elif len(cols) == 1 and len(rows) == 3 and rows == list(range(rows[0], rows[0] + 3)):
25:             candidates.append((int(color), "vertical", (rows[1], cols[0])))
26: 
27:     assert len(candidates) == 1, "expected a unique three-pixel marker bar"
28:     return candidates[0]
