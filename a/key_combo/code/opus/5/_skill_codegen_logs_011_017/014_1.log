31: def _roles(g: np.ndarray) -> tuple[int, int, tuple[int, int], tuple[int, int]]:
32:     bg = get_bg(g)
33:     colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
34:     assert len(colors) == 3, "expected target color, marker bar color, and control-pixel color"
35: 
36:     bar_color, axis, center = _find_marker_bar(g, bg)
