258: def main(grid: np.ndarray) -> np.ndarray:
259:     """
260:     Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.
261: 
262:     Input structure:
263:     - bg = most common color.
264:     - Several monochrome non-bg sprites (the "pieces"), scattered across the grid.
265:     - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.
266: 
267:     Rule:
268:     - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.
269:     - The legend's k×k color patch defines a spatial color map over the rectangle.
270:     - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.
271: 
272:     Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.
273:     """
274:     g = np.asarray(grid, dtype=int)
275:     bg = get_bg(g)
276: 
277:     comps = components_mask(g != bg, connectivity=4)
278:     assert comps, 'grid must contain at least one non-background component'
279: 
280:     # Identify legend component (most distinct colors) and infer k from number of pieces.
281:     k = int(round(len(comps) ** 0.5))
282:     assert k * k == len(comps), 'piece count must be a perfect square to determine k'
283: 
284:     comp_colors = []
285:     for pts in comps:
286:         cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)
287:         comp_colors.append(cols)
288: 
289:     max_distinct = max(len(cols) for cols in comp_colors)
290:     legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]
291:     assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'
292:     legend_idx = legend_candidates[0]
293:     legend_map = _extract_legend_map(g, comps[legend_idx], k)
294: 
295:     # Build piece masks (coords in bbox space), including filled holes.
296:     pieces: list[dict] = []
297:     for pts in comps:
298:         filled_abs, _ = _fill_holes_in_component(g, pts, bg)
299:         r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))
300:         rel = tuple((r - r0, c - c0) for r, c in filled_abs)
301:         rel_norm, _, _ = _normalize_coords(rel)
302:         oris = _dihedral_orientations(rel_norm)
303:         pieces.append({"oris": oris, "area": len(filled_abs)})
