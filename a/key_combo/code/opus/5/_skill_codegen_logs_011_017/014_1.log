+    cols = sorted(set(int(v) for v in grey[:, 1]))
+
+    if len(rows) == 1 and len(cols) == 3 and cols == list(range(cols[0], cols[0] + 3)):
+        center = (rows[0], cols[1])
+        axis = "horizontal"
+    elif len(cols) == 1 and len(rows) == 3 and rows == list(range(rows[0], rows[0] + 3)):
