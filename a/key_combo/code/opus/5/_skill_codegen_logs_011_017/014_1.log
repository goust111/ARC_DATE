+    corners = _corners(shape)
+    dists = [abs(point[0] - r) + abs(point[1] - c) for r, c in corners]
+    best = min(dists)
+    assert dists.count(best) == 1, "foreground point must have a unique nearest corner"
+    return corners[dists.index(best)]
