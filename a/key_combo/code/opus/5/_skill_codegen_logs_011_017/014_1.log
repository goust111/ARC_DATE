65: def main(grid: np.ndarray) -> np.ndarray:
66:     """
67:     Erase each target-color object crossed by the ray pointed by the bar-and-control marker.
68: 
69:     Input structure:
70:     - The background is the dominant color.
71:     - There is one three-pixel straight marker bar and one singleton control pixel adjacent to the bar center.
72:     - The remaining non-background color forms multiple 4-connected target objects.
73: 
74:     Rule:
75:     - Cast a straight ray from the marker bar center in the direction away from the adjacent control pixel.
76:     - Find every 4-connected target-color object that intersects that ray.
77:     - Recolor all pixels of those hit target objects to the background; all other pixels stay unchanged.
78: 
79:     Key insight:
80:     - The whole object is erased when the center ray touches any of its pixels; the full marker bar width is not swept.
81:     """
82:     g = np.asarray(grid, dtype=int)
83:     bg, target_color, center, step = _roles(g)
84:     height, width = g.shape
85: 
86:     ray: set[tuple[int, int]] = set()
87:     r = center[0] + step[0]
88:     c = center[1] + step[1]
89:     while 0 <= r < height and 0 <= c < width:
90:         ray.add((int(r), int(c)))
91:         r += step[0]
92:         c += step[1]
93: 
94:     target_objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[target_color])
95:     hit_objects = [
96:         obj
97:         for obj in target_objects
98:         if any(tuple(map(int, coord)) in ray for coord in obj["coords"])
99:     ]
100:     assert hit_objects, "expected at least one target object intersecting the marker ray"
101: 
102:     out = g.copy()
103:     for obj in hit_objects:
104:         coords = obj["coords"]
105:         out[coords[:, 0], coords[:, 1]] = int(bg)
106:     return out
