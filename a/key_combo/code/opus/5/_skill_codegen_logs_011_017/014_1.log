+def _rect_area(rect: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = rect
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _rects_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
