+
+
+def _points_well_spaced(points: list[tuple[int, int]]) -> bool:
+    for (r1, c1), (r2, c2) in itertools.combinations(points, 2):
+        if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+            return False
