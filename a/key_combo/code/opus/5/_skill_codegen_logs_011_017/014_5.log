+
+# --------------- generator ---------------
+
+BAR_COUNT_CHOICES = (5, 6, 7)
+GRID_H_MIN, GRID_H_MAX = 16, 24
+BAR_HEIGHTS = (4, 6, 8, 10, 12)
+BAR_GAPS = (4, 5)
