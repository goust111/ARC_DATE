+    return _half_rows(bar, opposite)
+
+
+def _route_pair(bar_a: dict, bar_b: dict) -> tuple[set[tuple[int, int]], dict]:
+    left, right = sorted((bar_a, bar_b), key=lambda bar: bar["col"])
