+    return bar["r0"] - 1 <= r <= bar["r1"] + 1
+
+
+def _path_endpoints(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:
+    adj = {cell: [nbr for nbr in neighbors8(*cell) if nbr in cells] for cell in cells}
