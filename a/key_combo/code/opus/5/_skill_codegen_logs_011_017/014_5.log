+    incoming: dict[int, list[tuple[int, int, str]]] = defaultdict(list)
+    for a_idx, b_idx in pairs:
+        a = bars[a_idx]
+        b = bars[b_idx]
+        if a["height"] == b["height"]:
+            continue
