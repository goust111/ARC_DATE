+    return pairs
+
+
+def _apply_rule_from_bars(grid: np.ndarray, bars: list[dict], pairs: list[tuple[int, int]]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for bar in bars:
+        out[bar["r0"] : bar["r1"] + 1, bar["col"]] = BAR
