+    if not all(src["mark_half"] is not None for src in conv_sources):
+        return False
+    if len({src["height"] for src in conv_sources}) != 2:
+        return False
+    if conv_sources[0]["mark_half"] == conv_sources[1]["mark_half"]:
+        return False
