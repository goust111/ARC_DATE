+def _detect_path_pairs(grid: np.ndarray, bars: list[dict]) -> list[dict]:
+    grey_comps = components_mask(grid == PATH, connectivity=8)
+    pairs: list[dict] = []
+    for pts in grey_comps:
+        cells = {tuple(map(int, pt)) for pt in pts}
+        endpoint_hits = []
+        for cell in sorted(cells):
