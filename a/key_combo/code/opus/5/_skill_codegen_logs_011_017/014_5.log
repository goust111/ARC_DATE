+    def bfs(start: tuple[int, int]) -> dict[tuple[int, int], int]:
+        dist = {start: 0}
+        queue = [start]
+        head = 0
+        while head < len(queue):
+            cur = queue[head]
+            head += 1
+            for nbr in adj[cur]:
+                if nbr not in dist:
+                    dist[nbr] = dist[cur] + 1
+                    queue.append(nbr)
