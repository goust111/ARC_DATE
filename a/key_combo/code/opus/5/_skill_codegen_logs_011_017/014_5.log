+    best_dist = -1
+    best_pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    ordered = sorted(cells)
+    for start in ordered:
+        dist = bfs(start)
+        for end in ordered:
+            if end <= start:
+                continue
+            cur_dist = dist[end]
+            if cur_dist > best_dist:
+                best_dist = cur_dist
+                best_pairs = [(start, end)]
+            elif cur_dist == best_dist:
+                best_pairs.append((start, end))
