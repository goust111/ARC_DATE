+    spec_sig = [(bar["col"], bar["r0"], bar["r1"], bar["mark_half"]) for bar in bars]
+    parsed_sig = [(bar["col"], bar["r0"], bar["r1"], bar["mark_half"]) for bar in parsed_bars]
