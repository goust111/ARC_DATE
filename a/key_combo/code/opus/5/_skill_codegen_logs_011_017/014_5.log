+        elif np.all(top == BAR) and np.all(bottom == MARK):
+            mark_half = "bottom"
+        else:
+            raise AssertionError("marked segment must occupy exactly one half of a bar")
+        bars.append(
+            {
+                "index": -1,
+                "coords": pts,
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "col": c0,
+                "height": height,
+                "mark_half": mark_half,
