+    assert floor_hits >= 1
+    assert discard_hits >= 1
+    assert sum(counts.values()) == len(markers)
+    assert 4 <= len(markers) <= 6
+    assert 3 <= len(containers) <= 4
+    assert len({box["area"] for box in containers}) == len(containers)
