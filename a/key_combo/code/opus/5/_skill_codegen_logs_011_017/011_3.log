+    if len(chosen) != n_containers:
+        raise ValueError("failed to choose unique container areas")
+    random.shuffle(chosen)
+    return chosen
+
+
+def _build_containers() -> tuple[int, int, list[dict], int]:
+    pattern = random.choice(COUNT_PATTERNS)
