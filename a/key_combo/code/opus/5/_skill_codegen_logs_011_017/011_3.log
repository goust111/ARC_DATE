+    outside_cols = [c for c in range(max(box["c1"] for box in containers) + 2) if c not in covered]
+    full_outside_cols = [c for c in range(max(box["c1"] for box in containers) + 2)]
+    del full_outside_cols
+
+    grid_w = max(box["c1"] for box in containers) + 1
