+def _make_container_patch(height: int, width: int) -> np.ndarray:
+    patch = np.zeros((height, width), dtype=int)
+    patch[:, 0] = CONTAINER_COLOR
+    patch[:, -1] = CONTAINER_COLOR
+    patch[-1, :] = CONTAINER_COLOR
+    return patch
+
