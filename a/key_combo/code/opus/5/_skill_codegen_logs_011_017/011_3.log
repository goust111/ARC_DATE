0020:     assert g.ndim == 2
0021:     h, w = g.shape
0022:     assert h > 0 and w > 0
0023: 
0024:     out = np.zeros((h, w + h - 1), dtype=int)
0025:     for r in range(h):
0026:         start = h - 1 - r
0027:         out[r, start : start + w] = g[r]
0028:     return out
