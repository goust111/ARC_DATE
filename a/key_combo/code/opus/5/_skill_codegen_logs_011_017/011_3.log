0021: def main(grid: np.ndarray) -> np.ndarray:
0022:     """
0023:     Paint an inner border around the region reachable from a corner marker pixel.
0024: 
0025:     Input structure:
0026:     - bg = most common color; wall color (blue) forms barriers dividing the grid.
0027:     - A unique single pixel (magenta) sits on one corner — the start marker.
0028:     - Some wall-colored pixels are structural (border-touching, enclosing regions); others are decorations.
0029: 
0030:     Rule:
0031:     - Flood-fill from the marker corner to find all reachable bg cells, blocked by structural walls.
0032:     - Erase wall-colored decorations hidden behind structural walls (not reachable from marker side).
0033:     - Paint orange (color 7) on every reachable bg cell adjacent to a wall or grid edge — forming a 1-cell inner border.
0034: 
0035:     Key insight: Only border-connected wall components act as real barriers; interior wall fragments are decorations to be removed.
0036:     """
0037:     g = np.asarray(grid, dtype=int)
0038:     h, w = g.shape
0039:     bg = get_bg(g)
0040: 
0041:     out = g.copy()
0042: 
0043:     # Marker pixel is a unique (count==1) non-bg pixel on a corner.
