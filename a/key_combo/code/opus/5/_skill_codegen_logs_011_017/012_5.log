+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = int(r) + dr, int(c) + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
+    return out
+
