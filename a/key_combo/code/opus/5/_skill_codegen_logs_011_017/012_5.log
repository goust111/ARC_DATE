+def _rounded_centroid(coords: np.ndarray) -> tuple[int, int]:
+    rows = coords[:, 0].astype(float)
+    cols = coords[:, 1].astype(float)
+    return _round_half_up(rows.mean()), _round_half_up(cols.mean())
