+    groups: dict[int, list[int]] = defaultdict(list)
+    for idx, anchor_idx in enumerate(assignments):
+        groups[int(anchor_idx)].append(idx)
+
+    shapes: list[np.ndarray | None] = [None] * len(areas)
+    for anchor_idx, indices in groups.items():
