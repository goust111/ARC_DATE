+def _union_best_anchor(coords_list: list[np.ndarray], anchors: list[dict]) -> int:
+    merged = np.concatenate(coords_list, axis=0)
+    idx, dists = _nearest_anchor_index(merged, anchors)
+    best = min(dists)
+    if dists.count(best) != 1:
+        return -1
+    return int(idx)
