0025: def main(grid: np.ndarray) -> np.ndarray:
0026:     """Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.
0027: 
0028:     Input structure
0029:     The grid has a dominant background color and several 4-connected multicolor foreground
0030:     objects.  One foreground color is the body color; the less frequent foreground colors are
0031:     boundary connector markers, and each marker color appears once as a free end or twice as a
0032:     matched docking pair.
0033: 
0034:     Rule
0035:     Crop each foreground object to its bounding box and translate the objects so that the two
0036:     occurrences of every paired connector color touch on their exposed boundary sides.  Preserve
0037:     each object's orientation and colors, then return the tight crop around the assembled
0038:     foreground on the original background color.
0039: 
0040:     Key insight
0041:     The colored marker pixels are ports: matching colors specify which objects must touch, and
0042:     the marker's side of its object determines the direction of the translation.
0043:     """
0044:     g = np.asarray(grid, dtype=int)
0045:     bg = get_bg(g)
0046: 
0047:     fg = g[g != bg]
0048:     assert fg.size > 0
0049:     values, counts = np.unique(fg, return_counts=True)
0050:     max_count = int(counts.max())
0051:     body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]
0052:     assert len(body_candidates) == 1
0053:     body = body_candidates[0]
0054:     marker_colors = {int(v) for v in values if int(v) != body}
0055:     assert marker_colors
