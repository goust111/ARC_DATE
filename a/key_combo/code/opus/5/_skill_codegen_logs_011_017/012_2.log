0128:     out_w = int(dc1 - dc + 1)
0129:     out = np.full((out_h, out_w), int(dst_bg), dtype=int)
0130:     out[0, :] = int(dst_bc)
0131:     out[-1, :] = int(dst_bc)
0132:     out[:, 0] = int(dst_bc)
0133:     out[:, -1] = int(dst_bc)
0134: 
0135:     # Destination markers are singleton pixels (color != dst_bg) in the interior.
0136:     inner = g[int(dr) + 1 : int(dr1), int(dc) + 1 : int(dc1)]
0137:     for rr, cc in np.argwhere(inner != int(dst_bg)):
0138:         mr = int(dr + 1 + int(rr))
0139:         mc = int(dc + 1 + int(cc))
0140:         mcol = int(g[mr, mc])
