0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Stamp source sprites into a destination frame via color-matched singleton markers.
0010: 
0011:     Input structure:
0012:     - Two bordered rectangles: source (multi-cell sprites) and destination (singleton markers).
0013:     - Each sprite has an anchor pixel — its least-frequent color. Markers share these colors.
0014: 
0015:     Rule:
0016:     - Match each destination marker to the source sprite with the same anchor color.
0017:     - Translate the sprite so its anchor overlaps the marker position.
0018:     - Output is the destination rectangle, interior cleared before stamping.
0019: 
0020:     Key insight: The rarest color per sprite doubles as a template key and positioning anchor.
0021:     """
0022:     g = np.array(grid, dtype=int)
0023:     H, W = g.shape
0024: 
0025:     # --- find all uniform-border rectangles (brute force, small grid) ---
0026:     def interior_bg(rect: tuple[int, int, int, int]) -> int:
0027:         r0, c0, r1, c1 = map(int, rect)
0028:         inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]
0029:         return int(Counter(map(int, inner.flatten())).most_common(1)[0][0])
0030: 
0031:     def rect_components(rect: tuple[int, int, int, int]) -> tuple[int, list[dict]]:
0032:         r0, c0, r1, c1 = map(int, rect)
0033:         inner = g[int(r0) + 1 : int(r1), int(c0) + 1 : int(c1)]
0034:         ibg = int(Counter(map(int, inner.flatten())).most_common(1)[0][0])
0035:         comps = []
0036: 
0037:         for coords in components_mask(inner != int(ibg), connectivity=4):
0038:             if coords.size == 0:
0039:                 continue
0040:             rr0, cc0, rr1, cc1 = bbox_coords(coords)
0041:             mask = np.zeros((int(rr1 - rr0 + 1), int(cc1 - cc0 + 1)), dtype=bool)
0042:             mask[coords[:, 0] - int(rr0), coords[:, 1] - int(cc0)] = True
0043:             patch = inner[int(rr0) : int(rr1) + 1, int(cc0) : int(cc1) + 1].copy()
0044:             patch[~mask] = 0
0045: 
0046:             vals = [int(inner[int(r), int(c)]) for r, c in coords]
0047:             cols = Counter(vals)
0048:             comps.append(
0049:                 {
0050:                     "size": int(coords.shape[0]),
0051:                     "colors": dict(cols),
0052:                     "bbox": (int(rr0), int(cc0), int(rr1), int(cc1)),
0053:                     "mask": mask,
0054:                     "patch": patch,
0055:                 }
0056:             )
0057: 
0058:         comps.sort(key=lambda d: -int(d["size"]))
0059:         return int(ibg), comps
0060: 
0061:     rects: list[tuple[int, tuple[int, int, int, int], int, int]] = []
0062:     min_h = 6
0063:     min_w = 6
0064:     for r0 in range(int(H)):
0065:         for c0 in range(int(W)):
0066:             bc = int(g[int(r0), int(c0)])
0067:             for r1 in range(int(r0 + min_h - 1), int(H)):
0068:                 for c1 in range(int(c0 + min_w - 1), int(W)):
0069:                     # corners
0070:                     if int(g[int(r0), int(c1)]) != int(bc) or int(g[int(r1), int(c0)]) != int(bc) or int(
0071:                         g[int(r1), int(c1)]
0072:                     ) != int(bc):
0073:                         continue
0074:                     # border uniformity
0075:                     if not bool((g[int(r0), int(c0) : int(c1) + 1] == int(bc)).all()):
0076:                         continue
0077:                     if not bool((g[int(r1), int(c0) : int(c1) + 1] == int(bc)).all()):
0078:                         continue
0079:                     if not bool((g[int(r0) : int(r1) + 1, int(c0)] == int(bc)).all()):
0080:                         continue
0081:                     if not bool((g[int(r0) : int(r1) + 1, int(c1)] == int(bc)).all()):
0082:                         continue
0083:                     # interior bg must differ from border
0084:                     ibg = interior_bg((int(r0), int(c0), int(r1), int(c1)))
0085:                     if int(ibg) == int(bc):
0086:                         continue
0087:                     area = int((int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1))
0088:                     rects.append((int(area), (int(r0), int(c0), int(r1), int(c1)), int(bc), int(ibg)))
0089: 
0090:     assert not (not rects)
0091: 
0092:     rects.sort(reverse=True, key=lambda x: int(x[0]))
0093:     rects = rects[:6]
0094: 
0095:     src = None
0096:     dst = None
0097:     for _area, rect, bc, _ibg in rects:
0098:         ibg2, comps = rect_components(rect)
0099:         max_sz = max([int(c["size"]) for c in comps], default=0)
0100:         if max_sz > 1 and src is None:
0101:             src = (rect, bc, ibg2, comps)
0102:         if max_sz == 1 and len(comps) > 0 and dst is None:
0103:             dst = (rect, bc, ibg2, comps)
0104: 
0105:     assert src is not None and dst is not None, 'must find both source (multi-cell) and destination (singleton) rectangles'
0106: 
0107:     (sr, sc, sr1, sc1), _src_bc, src_bg, src_comps = src
0108:     (dr, dc, dr1, dc1), dst_bc, dst_bg, _dst_comps = dst
0109: 
0110:     # --- build templates keyed by anchor color ---
0111:     templates: dict[int, tuple[np.ndarray, np.ndarray, tuple[int, int]]] = {}
0112:     for comp in src_comps:
0113:         cols = {k: int(v) for k, v in comp["colors"].items() if int(k) != 0}
0114:         if not cols:
0115:             continue
0116:         anchor_col = int(min(cols.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
0117:         patch = comp["patch"]
0118:         mask = comp["mask"]
0119:         anchors = np.argwhere((patch == int(anchor_col)) & mask)
0120:         if anchors.size == 0:
0121:             continue
0122:         ar, ac = map(int, anchors[0])
0123:         if int(anchor_col) not in templates or int(mask.sum()) > int(templates[int(anchor_col)][1].sum()):
0124:             templates[int(anchor_col)] = (patch.copy(), mask.copy(), (int(ar), int(ac)))
0125: 
0126:     # --- create destination canvas and stamp ---
