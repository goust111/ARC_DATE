0056: def main(grid: np.ndarray) -> np.ndarray:
0057:     """
0058:     Let the largest center-pointing object grow outward while every other object loses its inward tip.
0059: 
0060:     Input structure
0061:     - The grid has a single dominant background color and four 8-connected monochromatic foreground objects.
0062:     - The objects surround a central background gap and point toward it from cardinal directions.
0063:     - Exactly one object has the largest area.
0064: 
0065:     Rule
0066:     - Find the central background gap by minimizing aggregate distance to the four objects.
0067:     - Recolor the nearest-to-center pixel of each non-largest object to background.
0068:     - Add a three-pixel cap in the largest object's color on the side away from the center, centered on the shared row or column.
0069: 
0070:     Key insight
0071:     - The edit is a transfer of prominence around a common center: losers retract at their tips, and the unique largest object extends outward from the center.
0072:     """
0073:     g = np.asarray(grid, dtype=int)
0074:     assert g.ndim == 2, "expected a 2D grid"
0075: 
0076:     bg = get_bg(g)
0077:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
0078:     assert len(objects) == 4, "expected four colored objects around the center"
0079: 
0080:     center_r, center_c = _central_background_cell(g, bg, objects)
0081: 
0082:     areas = [int(obj["area"]) for obj in objects]
0083:     max_area = max(areas)
0084:     assert areas.count(max_area) == 1, "expected a unique largest object"
0085:     winner = objects[areas.index(max_area)]
0086: 
0087:     out = g.copy()
0088:     for obj in objects:
0089:         if obj is winner:
0090:             continue
0091:         r, c = _inward_tip(obj, center_r, center_c)
0092:         out[r, c] = bg
0093: 
0094:     for r, c in _outward_cap(winner, center_r, center_c):
0095:         assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1], "outward cap must stay in bounds"
0096:         assert int(g[r, c]) == bg, "outward cap must be painted on background"
0097:         out[r, c] = int(winner["color"])
0098: 
0099:     return out
