+ENDPOINT_MASK = np.array([[1, 1, 1], [0, 1, 0]], dtype=bool)
+STRAIGHT_MASK = np.array([[1, 1, 1], [1, 1, 1]], dtype=bool)
+CORNER_MASK = np.array([[1, 1, 1], [1, 1, 0], [1, 0, 0]], dtype=bool)
+
