+def _tile_fill(shape: tuple[int, int], tile: np.ndarray) -> np.ndarray:
+    h, w = map(int, shape)
+    th, tw = tile.shape
+    out = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
