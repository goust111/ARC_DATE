+    final_rel = set(sprite["coords"]) | stamp_rel
+    if not (stamp_rel - set(sprite["coords"])):
+        return None
+    max_r = max(r for r, _ in final_rel)
+    max_c = max(c for _, c in final_rel)
+
+    candidates = []
+    for r0 in range(shape[0] - max(max_r + 1, ph) + 1):
