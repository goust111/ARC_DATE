+    placed = dict(sprite)
+    placed["top_left"] = (r0, c0)
+    placed["input_cells"] = sprite_cells
+    placed["final_cells"] = final_cells
+    placed["stamp_cells"] = {(r0 + r, c0 + c) for r, c in stamp_rel}
