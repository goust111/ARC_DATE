+    if corner == "tr":
+        return range(1, min(4, h - 1)), range(max(1, w - 4), w - 1)
+    if corner == "bl":
+        return range(max(1, h - 4), h - 1), range(1, min(4, w - 1))
+    return range(max(1, h - 4), h - 1), range(max(1, w - 4), w - 1)
