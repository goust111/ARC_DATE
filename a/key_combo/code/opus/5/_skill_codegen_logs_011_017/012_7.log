+        for sr in rows:
+            for sc in cols:
+                if side == "right":
+                    tr, tc = sr, sc + 1
+                    for gap in (1, 2):
+                        for offset in range(h):
+                            top = sr - offset
+                            left = tc + 1 + gap
+                            cells = {
+                                (top + r, left + c)
+                                for r, c in np.argwhere(template)
+                            }
+                            pair = {(sr, sc), (tr, tc)}
+                            if all(_in_bounds(shape, r, c) for r, c in cells | pair):
+                                out.append({"side": side, "pair": pair, "template": cells})
+                elif side == "left":
+                    tr, tc = sr, sc - 1
+                    for gap in (1, 2):
+                        for offset in range(h):
+                            top = sr - offset
+                            left = tc - gap - w
+                            cells = {
+                                (top + r, left + c)
+                                for r, c in np.argwhere(template)
+                            }
+                            pair = {(sr, sc), (tr, tc)}
+                            if all(_in_bounds(shape, r, c) for r, c in cells | pair):
+                                out.append({"side": side, "pair": pair, "template": cells})
+                elif side == "down":
+                    tr, tc = sr + 1, sc
+                    for gap in (1, 2):
+                        for offset in range(w):
+                            top = tr + 1 + gap
+                            left = sc - offset
+                            cells = {
+                                (top + r, left + c)
+                                for r, c in np.argwhere(template)
+                            }
+                            pair = {(sr, sc), (tr, tc)}
+                            if all(_in_bounds(shape, r, c) for r, c in cells | pair):
+                                out.append({"side": side, "pair": pair, "template": cells})
+                else:
+                    tr, tc = sr - 1, sc
+                    for gap in (1, 2):
+                        for offset in range(w):
+                            top = tr - gap - h
+                            left = sc - offset
+                            cells = {
+                                (top + r, left + c)
+                                for r, c in np.argwhere(template)
+                            }
+                            pair = {(sr, sc), (tr, tc)}
+                            if all(_in_bounds(shape, r, c) for r, c in cells | pair):
+                                out.append({"side": side, "pair": pair, "template": cells})
+    random.shuffle(out)
+    return out
+
+
+def _stamp_cells(relative_marker: tuple[int, int], stamp: np.ndarray) -> set[tuple[int, int]]:
+    mr, mc = relative_marker
+    return {(mr + int(r), mc + int(c)) for r, c in np.argwhere(stamp)}
