+
+def _place_sprite(
+    shape: tuple[int, int],
+    sprite: dict,
+    rule_template: np.ndarray,
+    occupied_input: set[tuple[int, int]],
+    occupied_output: set[tuple[int, int]],
+    forbidden_output: set[tuple[int, int]],
