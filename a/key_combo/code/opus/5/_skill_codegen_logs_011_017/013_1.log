+def _can_scatter(board: np.ndarray, arr: np.ndarray, top: int, left: int, gap: int = 1) -> bool:
+    ph, pw = arr.shape
+    h, w = board.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return False
+    rr0 = max(0, top - gap)
+    cc0 = max(0, left - gap)
+    rr1 = min(h, top + ph + gap)
+    cc1 = min(w, left + pw + gap)
+    if np.any(board[rr0:rr1, cc0:cc1] != BG):
+        return False
+    return True
