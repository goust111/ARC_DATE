+
+def _place_opaque(board: np.ndarray, arr: np.ndarray, top: int, left: int) -> None:
+    ph, pw = arr.shape
+    mask = arr != BG
+    sub = board[top : top + ph, left : left + pw]
+    assert not np.any(mask & (sub != BG))
+    sub[mask] = arr[mask]
+    board[top : top + ph, left : left + pw] = sub
+
