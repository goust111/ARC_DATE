+def _independent_hole_dirs(grid: np.ndarray) -> list[str]:
+    mask = grid != BG
+    dirs = []
+    for hole in _find_holes(mask):
+        dirs.append(_hole_direction(hole, mask))
+    return sorted(dirs)
