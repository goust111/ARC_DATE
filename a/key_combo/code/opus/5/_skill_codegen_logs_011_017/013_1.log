+    try:
+        _validate_generated(inp, family["holes"], expect_cross=expect_cross)
+    except AssertionError:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
