+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _extract_pieces(grid: np.ndarray) -> list[dict]:
+    comps = _components_mask(grid != BG)
+    pieces: list[dict] = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        arr = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+        reds = np.argwhere(arr == RED)
+        piece = {
+            "bbox": (r0, c0, r1, c1),
+            "arr": arr,
+            "shape": arr.shape,
+            "reds": [(int(r), int(c)) for r, c in reds],
+            "nonred_count": int(np.count_nonzero((arr != BG) & (arr != RED))),
+            "size": int(np.count_nonzero(arr != BG)),
+        }
+        pieces.append(piece)
+    return pieces
+
+
+def _try_place(canvas: np.ndarray, arr: np.ndarray, top: int, left: int) -> np.ndarray | None:
+    h, w = canvas.shape
+    ph, pw = arr.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return None
+    sub = canvas[top : top + ph, left : left + pw]
+    mask = arr != BG
+    conflict = mask & (sub != BG) & ~((arr == RED) & (sub == RED))
+    if np.any(conflict):
+        return None
+    out = canvas.copy()
+    out_sub = out[top : top + ph, left : left + pw]
+    out_sub[mask] = arr[mask]
+    out[top : top + ph, left : left + pw] = out_sub
+    return out
+
