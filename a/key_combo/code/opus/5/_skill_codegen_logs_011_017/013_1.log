+            {
+                "reds": {(3, 2)},
+                "cells": {(3, 0), (3, 1), (3, 2), (4, 0), (5, 0), (5, 1), (6, 1)},
+            },
+            {
+                "reds": {(3, 2), (3, 3)},
+                "cells": {(3, 2), (3, 3), (4, 2), (5, 2)},
+            },
+            {
+                "reds": {(3, 8)},
+                "cells": {(3, 7), (3, 8), (3, 9), (4, 7), (4, 9), (5, 7), (5, 8), (5, 9)},
