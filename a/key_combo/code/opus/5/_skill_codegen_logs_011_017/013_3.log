MIN_PALETTE_SIZE = 5                  # min sprite colors (excluding bg, base)
BICHROMATIC_FRAC = 0.3                # fraction of shape-groups with 2 colors
WIDTH_TOLERANCE = 2                   # near-optimal tolerance for width selection
