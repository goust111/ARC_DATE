+            cand
+            for cand in extras
+            if cand is not primary
+            and _compatible(primary, cand)
+            and primary["visible_set"] & cand["visible_set"]
+            and int(primary["bbox_area"]) != int(cand["bbox_area"])
+        ]
+        random.shuffle(overlap_pool)
+        for overlap in overlap_pool:
+            outside_pool = [
