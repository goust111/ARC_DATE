+
+def _enumerate_candidates(channel: np.ndarray, path_mask: np.ndarray) -> list[dict]:
+    h, w = channel.shape
+    reserved = binary_dilation(path_mask, structure=STRUCT8)
+    out = []
+    for shape in SHAPES:
+        for direction in (-1, 1):
