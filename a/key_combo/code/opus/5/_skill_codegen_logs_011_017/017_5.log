+    if n != 1:
+        return False
+    cells = set(map(tuple, np.argwhere(labels == 1)))
+    for r, c in cells:
+        degree = sum((rr, cc) in cells for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)))
+        if degree > 2:
+            return False
+    return True
+
+
+def _generate_channel_path(h: int, w: int) -> list[tuple[int, int]] | None:
+    total_down = h - 3
+    if total_down < 10 or w < 16:
+        return None
+
+    n_segments = random.randint(4, 6)
+    v_max = max(6, total_down - 2 * (n_segments - 1))
+    v_steps = _partition_total(total_down, n_segments, 2, v_max)
+    if v_steps is None:
+        return None
+
+    min_col = 3
+    max_col = w - 4
+    cols = [random.randint(5, w - 6)]
+    prev_shift = 0
+    for _ in range(n_segments - 1):
+        options = []
+        for mag in (1, 2, 3):
+            for sign in (-1, 1):
+                shift = sign * mag
+                new_col = cols[-1] + shift
+                if min_col <= new_col <= max_col:
