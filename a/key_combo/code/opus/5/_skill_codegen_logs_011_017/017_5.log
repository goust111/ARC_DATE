+        visible = []
+        r = int(start[0] + 1)
+        c = int(start[1] + dc)
+        while (r, c) != end:
+            if bool(channel[r, c]):
+                assert int(g[r, c]) == bg, "channel-filtered diagonal cells must be background in the input"
