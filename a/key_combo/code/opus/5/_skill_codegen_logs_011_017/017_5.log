+        for r, c in cand["diag"]:
+            if not bool(channel[r, c]):
+                continue
+            current = claims.get((r, c))
+            key = (int(cand["bbox_area"]), int(cand["color"]))
+            if current is None or key < current:
+                claims[(r, c)] = key
+    for (r, c), (_area, color) in claims.items():
+        out[r, c] = int(color)
+    return out
+
+
+def _validate_generated(inp: np.ndarray, expected: np.ndarray, selected: list[dict], info: dict) -> bool:
+    if not np.array_equal(main(inp), expected):
+        return False
+    if np.array_equal(inp, expected):
