+    partial = info["partial"]
+    outside = info["outside"]
+    overlap_cells = info["overlap_cells"]
+    if partial["kind"] != "partial_discontinuous":
+        return False
+    if outside["kind"] != "outside":
+        return False
+    if not overlap_cells:
+        return False
+
+    vis_idx = [idx for idx, cell in enumerate(partial["diag"]) if cell in partial["visible_set"]]
+    if not vis_idx or len(vis_idx) == len(partial["diag"]):
