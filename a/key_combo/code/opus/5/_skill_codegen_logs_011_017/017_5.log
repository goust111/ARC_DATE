+    visible = [diag[idx] for idx in visible_idx]
+    if not visible:
+        return [], "outside"
+    if len(visible) == len(diag):
+        return visible, "full"
+    if any(b - a > 1 for a, b in zip(visible_idx, visible_idx[1:])):
+        return visible, "partial_discontinuous"
+    return visible, "partial_contiguous"
