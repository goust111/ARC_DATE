+
+def _pair_candidate(
+    h: int,
+    w: int,
+    shape: tuple[int, int],
+    direction: int,
+    gap: int,
+    ur: int,
+    uc: int,
+) -> dict | None:
+    rh, rw = shape
+    upper = (ur, uc, ur + rh - 1, uc + rw - 1)
+    if direction == 1:
+        start = (upper[2], upper[3])
+        end = (start[0] + gap + 1, start[1] + gap + 1)
+        lower = (end[0], end[1], end[0] + rh - 1, end[1] + rw - 1)
+    else:
+        start = (upper[2], upper[1])
+        end = (start[0] + gap + 1, start[1] - (gap + 1))
