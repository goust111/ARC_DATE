        counts['build'] += 1
        continue
    left,right,channel = built
    path_mask = mod._cells_to_mask((h,w), left|right)
    chosen = mod._find_primary_and_overlap(channel, path_mask)
    if chosen is None:
        counts['primary'] += 1
        continue
    primary, overlap, blocker_cell, overlap_cells = chosen
    occupied = set().union(primary['box_cells'], overlap['box_cells'], left, right)
    outside = mod._find_occluder_pair(blocker_cell, (h,w), occupied, channel, path_mask)
    if outside is None:
        counts['outside'] += 1
        continue
    selected=[primary, overlap, outside]
    colors = mod.random.sample(mod.RECT_COLORS, len(selected))
    inp = mod.np.full((h,w), mod.BG, dtype=int)
    for r,c in left|right:
        inp[r,c]=mod.PATH_COLOR
    for cand,color in zip(selected, colors):
        cand['color']=int(color)
        mod._paint_boxes(inp, cand['upper'], color)
        mod._paint_boxes(inp, cand['lower'], color)
    expected = mod._expected_output(inp, selected, channel)
    smaller, larger = sorted((primary, overlap), key=lambda item: int(item['bbox_area']))
    info = {'partial':primary,'outside':outside,'smaller_overlap':smaller,'larger_overlap':larger,'overlap_cells':overlap_cells,'channel':channel}
    if not mod._validate_generated(inp, expected, selected, info):
        counts['validate'] += 1
        continue
    counts['ok'] += 1
print(counts)
