+BG = 0
+PATH_COLOR = 7
+RECT_COLORS = [1, 2, 3, 4, 6, 8, 9]
+SHAPES = [(1, 1), (1, 2), (2, 1), (2, 2)]
+MAX_GEN_ATTEMPTS = 500
