+                        if cand["diag_set"] & path_cells:
+                            continue
+                        visible, kind = _classify_visible(cand["diag"], channel)
+                        cand["visible"] = visible
+                        cand["visible_set"] = set(visible)
+                        cand["kind"] = kind
