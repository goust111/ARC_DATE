+
+
+def _generate_channel_path(h: int, w: int) -> list[tuple[int, int]] | None:
+    return None
+
+
+def _build_paths(h: int, w: int) -> tuple[set[tuple[int, int]], set[tuple[int, int]], np.ndarray] | None:
