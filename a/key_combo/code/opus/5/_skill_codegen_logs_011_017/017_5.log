+    reserved = path_mask | channel
+    path_cells = set(map(tuple, np.argwhere(path_mask)))
+    out = []
+    for shape in SHAPES:
+        for direction in (-1, 1):
+            for gap in range(2, min(h, w) - 4):
+                for ur in range(0, h - shape[0] + 1):
+                    for uc in range(0, w - shape[1] + 1):
