+    return {
+        "upper": upper,
+        "lower": lower,
+        "diag": diag,
+        "diag_set": set(diag),
+        "box_cells": box_cells,
+        "bbox_area": bbox_area(union_bbox(upper, lower)),
+        "shape": shape,
+        "direction": int(direction),
