+    channel = np.ones_like(path_mask, dtype=bool)
+    for cid in range(1, n_paths + 1):
+        channel &= binary_dilation(labels == cid, structure=STRUCT8)
+    channel &= ~path_mask
+    assert np.any(channel), "expected a non-empty overlap channel"
