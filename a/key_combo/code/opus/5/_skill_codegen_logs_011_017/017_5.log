+    comps = []
+    labels, n = label_mask(grid == int(color), connectivity=connectivity)
+    for cid in range(1, n + 1):
+        coords = np.argwhere(labels == cid)
+        comps.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": bbox_coords(coords),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return comps
