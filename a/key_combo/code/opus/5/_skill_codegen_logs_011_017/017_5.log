+            r += 1
+            c += 1
+        lines.append(line)
+    for r0 in range(1, h):
+        line = []
+        r, c = r0, 0
+        while 0 <= r < h and 0 <= c < w:
+            line.append((r, c))
+            r += 1
+            c += 1
+        lines.append(line)
+
+    for c0 in range(w):
+        line = []
+        r, c = 0, c0
+        while 0 <= r < h and 0 <= c < w:
+            line.append((r, c))
+            r += 1
+            c -= 1
+        lines.append(line)
+    for r0 in range(1, h):
+        line = []
+        r, c = r0, w - 1
+        while 0 <= r < h and 0 <= c < w:
