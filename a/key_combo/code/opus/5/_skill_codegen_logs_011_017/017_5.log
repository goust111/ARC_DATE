+    path_labels, n_paths = label_mask(inp == PATH_COLOR, connectivity=4)
+    if n_paths != 2:
+        return False
+    del path_labels
+
+    partial = info["partial"]
+    outside = info["outside"]
+    overlap_cells = info["overlap_cells"]
+    if partial["kind"] != "partial_discontinuous":
+        return False
+    if outside["kind"] != "outside":
+        return False
+    if not overlap_cells:
+        return False
+
+    vis_idx = [idx for idx, cell in enumerate(partial["diag"]) if cell in partial["visible_set"]]
+    if not vis_idx or len(vis_idx) == len(partial["diag"]):
+        return False
+    if not any(b - a > 1 for a, b in zip(vis_idx, vis_idx[1:])):
+        return False
+    if outside["visible"]:
+        return False
+
+    winner = info["smaller_overlap"]
+    loser = info["larger_overlap"]
+    if int(winner["bbox_area"]) >= int(loser["bbox_area"]):
+        return False
+    sample_cell = min(overlap_cells)
+    if int(expected[sample_cell]) != int(winner["color"]):
+        return False
+
+    colors = [int(cand["color"]) for cand in selected]
+    if len(colors) != len(set(colors)):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 24)
+    w = random.randint(18, 26)
+
+    built = _build_paths(h, w)
+    if built is None:
+        return None
