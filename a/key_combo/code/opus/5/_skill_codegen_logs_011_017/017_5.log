+                "lower": (end[0], end[1], end[0], end[1]),
+                "box_cells": {target, end},
+                "diag": diag,
+                "diag_set": set(diag),
+                "bbox_area": bbox_area(union_bbox((tr, tc, tr, tc), (end[0], end[1], end[0], end[1]))),
