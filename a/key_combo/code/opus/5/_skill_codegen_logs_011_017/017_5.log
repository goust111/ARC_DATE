+        for dr, dc in dirs:
+            lr, lc = _left_normal(dr, dc)
+            if (r + lr, c + lc) not in channel_cells:
+                left.add((r + lr, c + lc))
+            if (r - lr, c - lc) not in channel_cells:
+                right.add((r - lr, c - lc))
