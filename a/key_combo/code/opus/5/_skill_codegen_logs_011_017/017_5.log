+
+def _cells_to_mask(shape: tuple[int, int], cells: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    if cells:
+        rows, cols = zip(*cells)
+        mask[rows, cols] = True
