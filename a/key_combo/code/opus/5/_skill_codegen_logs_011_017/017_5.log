+def _buffered_cells(shape: tuple[int, int], cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    mask = _cells_to_mask(shape, cells)
+    dilated = binary_dilation(mask, structure=STRUCT8)
+    return set(map(tuple, np.argwhere(dilated)))
