+                and all(_compatible(cand, other) for other in selected)
+                and not (cand["visible_set"] & visible_union)
+            ]
+            chosen_extra = None
+            visible_extra = [cand for cand in extra_pool if cand["kind"] in {"full", "partial_contiguous"} and cand["visible"]]
