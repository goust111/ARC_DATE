+        if len(dirs) == 2 and dirs[0] != dirs[1]:
+            for side in (1, -1):
+                offsets = []
+                for dr, dc in dirs:
+                    lr, lc = _left_normal(dr, dc)
+                    offsets.append((side * lr, side * lc))
+                direct = [(r + dr0, c + dc0) for dr0, dc0 in offsets]
+                if all(cell not in channel_cells for cell in direct):
