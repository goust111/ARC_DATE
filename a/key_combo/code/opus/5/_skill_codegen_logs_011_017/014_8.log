+    hole_center = (int(top_left[0] + 2), int(top_left[1] + 2))
+    return {
+        "mask": mask.copy(),
+        "top_left": tuple(map(int, top_left)),
+        "coords": np.asarray(coords, dtype=int),
+        "direction": direction,
+        "hole_center": hole_center,
+        "distance": _distance_to_wall(coords, frame, direction),
