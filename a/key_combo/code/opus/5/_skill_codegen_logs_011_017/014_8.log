+def _distance_to_wall(coords: np.ndarray, frame: tuple[int, int, int, int], direction: str) -> int:
+    r0, c0, r1, c1 = frame
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    if direction == "up":
+        return int(rows.min() - (r0 + 1))
+    if direction == "down":
+        return int((r1 - 1) - rows.max())
+    if direction == "left":
+        return int(cols.min() - (c0 + 1))
+    return int((c1 - 1) - cols.max())
