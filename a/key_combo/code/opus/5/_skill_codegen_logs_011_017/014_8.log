+
+def _canonical_mask_open_up() -> np.ndarray:
+    mask = np.ones((5, 5), dtype=bool)
+    center = (2, 2)
+    cross = [center, (1, 2), (3, 2), (2, 1), (2, 3)]
+    for rc in cross:
+        mask[rc] = False
+    mask[0, 2] = False
+    return mask
+
+
+def _rotate_from_up(mask: np.ndarray, direction: str) -> np.ndarray:
