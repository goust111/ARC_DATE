+
+def _shift_coords(coords: np.ndarray, step: tuple[int, int], amount: int = 1) -> np.ndarray:
+    dr, dc = step
+    delta = np.array([dr * amount, dc * amount], dtype=int)
+    return np.asarray(coords, dtype=int) + delta
