+
+
+def _dominant_non_bg(values: np.ndarray, bg: int) -> int:
+    vals = [int(v) for v in values.tolist() if int(v) != bg]
+    assert vals, "expected a colored frame edge"
+    counts = np.bincount(vals, minlength=10)
+    return int(np.argmax(counts))
