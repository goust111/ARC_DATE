+    grid[r0, c1] = SIDE_COLORS[random.choice(("up", "right"))]
+    grid[r1, c0] = SIDE_COLORS[random.choice(("down", "left"))]
+    grid[r1, c1] = SIDE_COLORS[random.choice(("down", "right"))]
