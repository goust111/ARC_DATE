+
+
+def _build_spec(
+    mask: np.ndarray,
+    top_left: tuple[int, int],
+    direction: str,
+    frame: tuple[int, int, int, int],
+) -> dict:
+    coords = _coords_from_mask(mask, top_left)
+    hole_center = (int(top_left[0] + 2), int(top_left[1] + 2))
+    return {
+        "mask": mask.copy(),
+        "top_left": tuple(map(int, top_left)),
+        "coords": np.asarray(coords, dtype=int),
