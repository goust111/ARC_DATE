+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not visible[r, c]:
+                continue
+            key = (r % row_period, c % col_period)
+            value = int(grid[r, c])
+            prev = values.get(key)
+            if prev is not None and prev != value:
+                return None
+            values[key] = value
+    if len(values) != row_period * col_period:
+        return None
+    return values
