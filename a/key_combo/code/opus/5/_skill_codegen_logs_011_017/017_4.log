+    pattern, _rp, _cp = _infer_periodic_grid(g, visible)
+
+    out = g.copy()
+    for obj in objects:
+        kind = _classify_object(g, pattern, obj)
+        r0, c0, r1, c1 = obj["bbox"]
+        if kind == "solid":
+            out[r0 : r1 + 1, c0 : c1 + 1] = pattern[r0 : r1 + 1, c0 : c1 + 1]
+        else:
+            h = int(r1 - r0 + 1)
+            w = int(c1 - c0 + 1)
+            border = _border_mask(h, w)
+            sub = out[r0 : r1 + 1, c0 : c1 + 1]
+            sub[border] = 0
+    return out
+
