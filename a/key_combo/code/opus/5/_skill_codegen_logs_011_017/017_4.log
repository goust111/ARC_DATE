+
+def _random_tile() -> np.ndarray:
+    for _ in range(200):
+        h = random.choice([2, 3])
+        w = random.choice([2, 3])
+        tile = np.random.choice([1, 3], size=(h, w)).astype(int)
+        if len(set(map(int, tile.ravel()))) < 2:
