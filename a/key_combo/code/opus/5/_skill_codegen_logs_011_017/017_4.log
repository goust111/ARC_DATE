+    out = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = int(values[(r % row_period, c % col_period)])
+    return out
+
+
+def _infer_periodic_grid(grid: np.ndarray, visible: np.ndarray) -> tuple[np.ndarray, int, int]:
+    h, w = grid.shape
