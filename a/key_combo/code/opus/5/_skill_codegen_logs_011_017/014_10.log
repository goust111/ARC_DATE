+    sides: list[str] = []
+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
+    assert len(sides) == 1, "grey marker must lie on exactly one edge"
+    side = sides[0]
+    gravity = {
+        "top": "down",
+        "bottom": "up",
+        "left": "right",
+        "right": "left",
+    }[side]
+    step = {
+        "up": (-1, 0),
+        "down": (1, 0),
+        "left": (0, -1),
+        "right": (0, 1),
