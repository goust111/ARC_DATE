+
+
+def _apply_swaps(grid: np.ndarray, pairs: list[dict], bg: int) -> tuple[np.ndarray, np.ndarray]:
+    out = grid.copy()
+    activated = np.zeros_like(grid, dtype=bool)
+
+    for pair in pairs:
+        ra, ca = pair["src_a"]
+        rb, cb = pair["src_b"]
+        out[ra, ca] = bg
