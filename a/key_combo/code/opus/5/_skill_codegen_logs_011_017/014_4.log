+def _is_l_legend(mask: np.ndarray) -> tuple[bool, int]:
+    box = bbox(mask)
+    if box is None:
+        return False, -1
+    r0, c0, r1, c1 = box
+    if r0 != 0 or c0 != 0 or r1 != c1 or r1 < 2:
+        return False, -1
+    k = int(r1)
+    expected = np.zeros_like(mask, dtype=bool)
