+GAP_COLOR = Color.MAROON
+A_CROSS_COLOR = Color.PINK
+B_CROSS_COLOR = Color.TEAL
+
+BG_PAIRS = ((Color.GREY, Color.ORANGE), (Color.ORANGE, Color.GREY))
+TOP_FG_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW)
