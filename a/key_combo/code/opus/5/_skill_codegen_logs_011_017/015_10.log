+
+    if len(info_b["marker_rows"]) > 1:
+        wrong_b = _assemble_output(
+            _compress_panel(info_a, info_b["mask"], A_CROSS_COLOR),
+            _compress_panel(info_b, info_a["mask"], B_CROSS_COLOR, marker_row=info_b["marker_rows"][-1]),
