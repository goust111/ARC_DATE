+        lengths = [random.randint(2, 5) for _ in range(seg_count)]
+        total_south = sum(length for length, d in zip(lengths, dirs) if d == (1, 0))
+        total_east = sum(length for length, d in zip(lengths, dirs) if d == (0, 1))
