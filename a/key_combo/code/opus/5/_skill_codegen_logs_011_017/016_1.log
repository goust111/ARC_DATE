+        for dr, dc in MOVE_DIRS:
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(mask.shape, nr, nc) or (nr, nc) in visited:
+                continue
+            s = int(cap_map[nr, nc])
+            if s <= 0:
+                continue
+            new_count = _square_new_count(covered, nr, nc, s)
+            if new_count <= 0:
