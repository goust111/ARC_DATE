+            budget -= 1
+        occupied[r : r + s, c : c + s] = True
+        final_objects.append(
+            {
+                **obj,
+                "start_key": (int(obj["r"]) + int(obj["c"]), int(obj["r"]), int(obj["c"])),
+                "final_key": (int(r) + int(c), int(r), int(c)),
+                "final_r": int(r),
+                "final_c": int(c),
+                "stop_reason": stop_reason if budget > 0 else "budget",
