+
+def _squares_are_separate(placed: list[dict], cand_idx: int, path: list[tuple[int, int]], size: int) -> bool:
+    cr, cc = path[cand_idx]
+    r0 = cr - 1
+    c0 = cc - 1
+    r1 = cr + size
+    c1 = cc + size
+    for obj in placed:
+        or0 = obj["r"] - 1
+        oc0 = obj["c"] - 1
+        or1 = obj["r"] + obj["size"]
+        oc1 = obj["c"] + obj["size"]
+        if not (r1 < or0 or or1 < r0 or c1 < oc0 or oc1 < c0):
+            return False
