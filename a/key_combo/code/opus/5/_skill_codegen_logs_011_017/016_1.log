+            raise ValueError("object is not on a valid channel placement")
+        enriched.append({**obj, "order_key": (int(obj["r"]) + int(obj["c"]), int(obj["r"]), int(obj["c"]))})
+    enriched.sort(key=lambda obj: obj["order_key"])
+
