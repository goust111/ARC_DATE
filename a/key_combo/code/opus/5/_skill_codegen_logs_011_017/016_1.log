+    occupied = np.zeros(grid_shape, dtype=bool)
+    final_objects: list[dict] = []
+    for obj in enriched:
+        s = int(obj["size"])
+        budget = int(s * s)
+        idx = int(obj["start_idx"])
+        stop_reason = "budget"
+        while budget > 0:
+            if idx + 1 >= len(path):
+                stop_reason = "end"
+                break
+            next_idx = idx + 1
+            if int(caps[next_idx]) < s:
+                stop_reason = "width"
+                break
+            nr, nc = path[next_idx]
+            if bool(occupied[nr : nr + s, nc : nc + s].any()):
+                stop_reason = "collision"
+                break
+            idx = next_idx
+            budget -= 1
+        fr, fc = path[idx]
+        occupied[fr : fr + s, fc : fc + s] = True
+        final_objects.append(
+            {
+                **obj,
+                "final_idx": int(idx),
+                "final_r": int(fr),
+                "final_c": int(fc),
+                "stop_reason": stop_reason if budget > 0 or idx + 1 >= len(path) else "budget",
+            }
+        )
+
+    out = np.zeros(grid_shape, dtype=int)
+    out[channel_mask] = int(channel_color)
+    for obj in final_objects:
+        _paint_square(out, obj["final_r"], obj["final_c"], obj["size"], obj["color"])
