+
+def _plan_objects(path: list[tuple[int, int]], caps: list[int]) -> list[dict] | None:
+    sizes: list[int] = [2, 3]
+    if random.random() < 0.75:
+        sizes.append(1)
+    count = random.randint(3, 5)
+    while len(sizes) < count:
+        sizes.append(random.choice(SQUARE_SIZES))
+    random.shuffle(sizes)
