+    g = np.asarray(grid, dtype=int)
+    non_bg = [int(v) for v in g.flatten() if int(v) != BG]
+    if not non_bg:
+        return g.copy()
+    channel_color = int(Counter(non_bg).most_common(1)[0][0])
