    return grid


def _semantic_checks(inp: np.ndarray, out: np.ndarray, finals: list[dict], path: list[tuple[int, int]], caps: list[int]) -> bool:
    if np.array_equal(inp, out):
        return False
    if len({obj["size"] for obj in finals}) < 2:
        return False
    if len({obj["stop_reason"] for obj in finals}) < 2:
        return False
    moved = sum((obj["start_idx"] != obj["final_idx"]) for obj in finals)
    if moved < 2:
        return False
    if max(obj["size"] for obj in finals) < 3:
        return False
    if 2 not in caps:
        return False
    if len(path) < 12:
        return False
    return True


def _gen_attempt() -> np.ndarray | None:
    for _ in range(200):
        path = _build_monotone_path()
        caps = _build_caps(path)
        channel_mask = _render_channel(path, caps)
        if max(channel_mask.shape) > 30:
            continue

        channel_color = random.choice(CHANNEL_COLORS)
        objects = _plan_objects(path, caps)
        if objects is None:
            continue

        inp = _build_grid(channel_mask, channel_color, objects)
        try:
            out, finals = _simulate(inp.shape, channel_mask, channel_color, objects)
        except Exception:
            continue
        try:
            solver_out = main(inp)
        except Exception:
            continue
        if not np.array_equal(out, solver_out):
            continue

        try:
            rec_path, rec_caps = _recover_anchor_path(channel_mask)
        except Exception:
            continue
        if rec_path != path or rec_caps != caps:
            continue
        if not _semantic_checks(inp, out, finals, path, caps):
            continue
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(400):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid sample")

