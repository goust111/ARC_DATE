+    lim_r = h - size + 1
+    lim_c = w - size + 1
+    for r in range(max(0, lim_r)):
+        for c in range(max(0, lim_c)):
+            out[r, c] = bool(channel_mask[r : r + size, c : c + size].all())
+    return out
