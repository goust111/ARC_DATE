+    def square_sum(r: int, c: int, k: int) -> int:
+        r1 = r + k
+        c1 = c + k
+        return int(sat[r1, c1] - sat[r, c1] - sat[r1, c] + sat[r, c])
+
+    out = np.zeros((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            lim = min(max_size, h - r, w - c)
+            best = 0
+            for k in range(1, lim + 1):
+                if square_sum(r, c, k) == k * k:
+                    best = k
+                else:
+                    break
+            out[r, c] = best
