+    if len({obj["size"] for obj in finals}) < 2:
+        return False
+    if len({obj["stop_reason"] for obj in finals}) < 2:
+        return False
+    moved = sum((obj["start_key"] != obj["final_key"]) for obj in finals)
+    if moved < 2:
+        return False
+    if max(obj["size"] for obj in finals) < 3:
+        return False
+    if 2 not in caps:
