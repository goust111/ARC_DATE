+    non_bg = [int(v) for v in g.flatten() if int(v) != BG]
+    if not non_bg:
+        return g.copy()
+    channel_color = int(Counter(non_bg).most_common(1)[0][0])
+    objects = _detect_objects(g, channel_color)
+    channel_mask = g != BG
+    out, _finals = _simulate(g.shape, channel_mask, channel_color, objects)
+    return out
