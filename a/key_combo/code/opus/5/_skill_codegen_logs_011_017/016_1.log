+            if not feasible[r, c]:
+                continue
+            best = 1
+            if c + 1 < w and score[r, c + 1] >= 0:
+                best = max(best, 1 + int(score[r, c + 1]))
+            if r + 1 < h and score[r + 1, c] >= 0:
