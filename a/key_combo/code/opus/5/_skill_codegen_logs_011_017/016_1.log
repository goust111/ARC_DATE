+        try:
+            solver_out = main(inp)
+        except Exception:
+            continue
+        if not np.array_equal(out, solver_out):
+            continue
+        if not _semantic_checks(inp, out, finals, path, caps):
+            continue
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
