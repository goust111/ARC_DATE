+        mask = grid == int(color)
+        for coords in _find_components(mask):
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            h = int(r1 - r0 + 1)
+            w = int(c1 - c0 + 1)
