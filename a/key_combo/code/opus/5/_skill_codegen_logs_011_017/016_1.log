+def _simulate(
+    grid_shape: tuple[int, int],
+    channel_mask: np.ndarray,
+    channel_color: int,
+    objects: list[dict],
+) -> tuple[np.ndarray, list[dict]]:
+    path, caps = _recover_anchor_path(channel_mask)
+    index_of = {pos: i for i, pos in enumerate(path)}
+
+    enriched = []
+    for obj in objects:
+        pos = (int(obj["r"]), int(obj["c"]))
+        if pos not in index_of:
+            raise ValueError("object is not anchored on the channel spine")
+        enriched.append({**obj, "start_idx": int(index_of[pos])})
+    enriched.sort(key=lambda obj: obj["start_idx"])
