+def _gen_attempt() -> np.ndarray | None:
+    for _ in range(200):
+        path = _build_monotone_path()
+        caps = _build_caps(path)
+        channel_mask = _render_channel(path, caps)
+        if max(channel_mask.shape) > 30:
