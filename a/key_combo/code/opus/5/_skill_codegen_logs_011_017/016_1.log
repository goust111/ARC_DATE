+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MOVE_DIRS = ((0, 1), (1, 0))  # generator uses a monotone east/south winding spine
+SQUARE_SIZES = (1, 2, 3)
+CHANNEL_WIDTHS = (1, 2, 3)
+CHANNEL_COLORS = (5, 8)
