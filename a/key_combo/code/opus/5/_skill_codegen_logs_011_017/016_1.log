+
+def _segment_ranges(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    if len(path) <= 1:
+        return [(0, 0)]
+    out: list[tuple[int, int]] = []
+    seg_start = 0
+    prev_dir = (path[1][0] - path[0][0], path[1][1] - path[0][1])
+    for i in range(1, len(path) - 1):
