+    if 3 not in internal_widths:
+        internal_widths[random.randrange(len(internal_widths))] = 3
+
+    seg_widths = [1] + internal_widths + [1]
+    for seg_i, ((a, b), width) in enumerate(zip(segs, seg_widths)):
+        start = a if seg_i == 0 else a + 1
