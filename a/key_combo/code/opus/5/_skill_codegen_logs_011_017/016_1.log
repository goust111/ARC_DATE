+    for obj in objects:
+        _paint_square(grid, obj["r"], obj["c"], obj["size"], obj["color"])
+    return grid
+
+
+def _semantic_checks(inp: np.ndarray, out: np.ndarray, finals: list[dict], path: list[tuple[int, int]], caps: list[int]) -> bool:
+    if np.array_equal(inp, out):
