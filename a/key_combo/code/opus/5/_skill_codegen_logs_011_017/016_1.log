+    occupied = np.zeros(grid_shape, dtype=bool)
+    final_objects: list[dict] = []
+    for obj in enriched:
+        s = int(obj["size"])
+        budget = int(s * s)
+        r = int(obj["r"])
+        c = int(obj["c"])
+        feasible = feasible_by_size[s]
+        score = score_by_size[s]
+        stop_reason = "budget"
+        while budget > 0:
+            nxt = _choose_next(r, c, feasible, score)
+            if nxt is None:
