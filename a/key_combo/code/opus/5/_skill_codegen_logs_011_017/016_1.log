+                stop_reason = "collision"
+                break
+            idx = next_idx
+            budget -= 1
+        fr, fc = path[idx]
+        occupied[fr : fr + s, fc : fc + s] = True
+        final_objects.append(
+            {
+                **obj,
+                "final_idx": int(idx),
+                "final_r": int(fr),
+                "final_c": int(fc),
+                "stop_reason": stop_reason if budget > 0 or idx + 1 >= len(path) else "budget",
+            }
+        )
+
+    out = np.zeros(grid_shape, dtype=int)
+    out[channel_mask] = int(channel_color)
