+        oc0 = obj["c"] - 1
+        or1 = obj["r"] + obj["size"]
+        oc1 = obj["c"] + obj["size"]
+        if not (r1 < or0 or or1 < r0 or c1 < oc0 or oc1 < c0):
+            return False
+    return True
