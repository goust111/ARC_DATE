+    return int(h), int(w), [(int(r), int(c)) for r, c in anchors]
+
+
+def _render_case(rects: dict[int, tuple[int, int, int, int]], order: list[int]) -> np.ndarray:
+    h = max(b[2] for b in rects.values()) + 1
