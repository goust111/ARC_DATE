# Canvas and palette.
HEIGHT_RANGE = (4, 8)
WIDTH_CHOICES = (6, 8, 10, 12)
FOREGROUND_COLOR = 2

# Gap-level and row sampling.
MAX_GAP_LEVELS = 3
