+
+
+def _build_case() -> tuple[np.ndarray, list[int], dict[int, tuple[int, int, int, int]], list[int]] | None:
+    n = random.choice((4, 5))
+    group_sizes = [2, 2] if n == 4 else random.choice(([2, 1, 2], [2, 2, 1], [1, 2, 2]))
