+    color_idx = 0
+    for group_index, (group, anchor) in enumerate(zip(groups, anchors)):
+        local_colors = colors[color_idx : color_idx + group["size"]]
+        color_idx += group["size"]
+        ar, ac = anchor
+        local_rects = []
+        for local_box, local_rank in group["locals"]:
