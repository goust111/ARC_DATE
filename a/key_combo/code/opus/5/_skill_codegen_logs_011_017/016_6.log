+def _canonical_shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:
+    best = None
+    cur = np.asarray(mask, dtype=bool)
+    for k in range(4):
+        rot = np.rot90(cur, k)
+        for variant in (rot, np.fliplr(rot)):
+            key = (variant.tobytes(), tuple(map(int, variant.shape)))
+            if best is None or key < best:
+                best = key
+    assert best is not None
+    return best
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            mask, bbox = _tight_mask(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "mask": mask,
+                    "shape_key": _canonical_shape_key(mask),
+                    "area": len(coords),
