+        overlaps = _count_overlaps(c0, width, canvas_cols)
+        if overlaps == [target]:
+            candidates.append(c0)
+    return candidates
+
+
+def _multi_overlap_cols(width: int, canvas_cols: list[int], target: int) -> list[int]:
+    candidates = []
+    max_c0 = canvas_cols[-1] + 4
+    for c0 in range(0, max_c0 + 1):
+        overlaps = _count_overlaps(c0, width, canvas_cols)
+        if len(overlaps) < 2 or target not in overlaps:
+            continue
+        if _nearest_canvas_index(c0, width, canvas_cols) == target:
+            candidates.append(c0)
+    return candidates
+
+
+def _assign_template_columns(template_masks: list[np.ndarray], width: int, canvas_cols: list[int]) -> list[tuple[int, int]] | None:
+    columns: list[tuple[int, int]] = []
+    target_pool = [0, 1, 2, 3]
+    _RNG.shuffle(target_pool)
+    used_targets: list[int] = []
+    force_multi = _RNG.random() < 0.45
+    multi_done = False
+    for idx, mask in enumerate(template_masks):
+        tw = int(mask.shape[1])
+        candidate_targets = target_pool.copy()
+        if idx >= len(candidate_targets):
+            candidate_targets = [0, 1, 2, 3]
+            _RNG.shuffle(candidate_targets)
+        chosen = None
+        for target in candidate_targets:
+            modes = ["single", "multi"] if force_multi and not multi_done else ["single", "multi"]
+            if idx == 0 and force_multi and not multi_done:
+                modes = ["multi", "single"]
+            for mode in modes:
+                if mode == "single":
+                    cands = _single_overlap_cols(tw, canvas_cols, target)
+                else:
+                    cands = _multi_overlap_cols(tw, canvas_cols, target)
+                cands = [c0 for c0 in cands if c0 + tw <= width]
+                if not cands:
