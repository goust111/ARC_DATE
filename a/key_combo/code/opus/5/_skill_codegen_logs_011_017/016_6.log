+    if not canvases:
+        raise ValueError("expected at least one repeated-shape canvas")
+    tiles = _carve_canvases(bg, canvases, templates)
+    out = np.full((7, 1 + len(tiles) * 5 + max(0, len(tiles) - 1) + 1), int(bg), dtype=int)
