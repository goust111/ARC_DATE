+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
