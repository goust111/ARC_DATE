+        if th > 5 or tw > 5:
+            raise ValueError("template bbox must fit inside a 5x5 canvas")
+        off_r = (5 - th) // 2
+        off_c = (5 - tw) // 2
+        window = tiles[idx][off_r : off_r + th, off_c : off_c + tw]
+        window[mask] = int(bg)
