+    grid[legend_r0 : legend_r1 + 1, legend_c1] = LEGEND_FRAME
+    grid[legend_r0, legend_c0 : legend_c1 + 1] = LEGEND_FRAME
+    grid[legend_r1, legend_c0 : legend_c1 + 1] = LEGEND_FRAME
+
+    target_count = random.choice((2, 3))
