+    if Counter(grid.ravel())[BG] <= (h * w) // 2:
+        return None
+    if not semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

