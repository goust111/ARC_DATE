+GEN_ATTEMPTS = 500
+GEN_H_RANGE = (15, 20)
+GEN_W_RANGE = (15, 20)
+GEN_OBJECT_COUNT = (5, 8)
+GEN_SHAPE_SIZE = (3, 7)
+GEN_LEGEND_OUTER = (4, 5)
