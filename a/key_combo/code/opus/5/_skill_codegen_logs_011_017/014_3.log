+                "coords": final_coords,
+                "colors": obj["colors"],
+                "bbox": bbox_coords(final_coords),
+                "color_set": set(obj["color_set"]),
+                "moved": tuple(map(int, final_coords[0] - obj["coords"][0])),
+            }
