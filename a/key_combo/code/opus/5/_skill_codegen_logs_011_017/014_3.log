+def _shift_until_blocked(
+    coords: np.ndarray, step: tuple[int, int], occupied: set[tuple[int, int]], shape: tuple[int, int]
+) -> np.ndarray:
+    h, w = shape
+    cur = coords.copy()
+    while True:
+        nxt = cur + np.asarray(step, dtype=int)
+        ok = True
+        for nr, nc in nxt:
+            rr = int(nr)
+            cc = int(nc)
+            if rr < 0 or rr >= h or cc < 0 or cc >= w or (rr, cc) in occupied:
+                ok = False
+                break
+        if not ok:
+            return cur
+        cur = nxt
