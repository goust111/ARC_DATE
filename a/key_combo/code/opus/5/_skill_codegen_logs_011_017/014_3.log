+    else:
+        fixed_value = random.randint(max(3, legend_r1 + 2), max(3, min(h - 6, h // 2 + 2)))
+
+    objects = []
+    for idx, is_match in enumerate(labels):
+        size = random.randint(*GEN_SHAPE_SIZE)
