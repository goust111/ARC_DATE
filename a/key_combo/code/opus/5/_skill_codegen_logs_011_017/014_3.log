+        objects,
+        key=lambda obj: (
+            edge_distance(obj["bbox"], step, shape),
+            obj["bbox"][0],
+            obj["bbox"][1],
+            obj["bbox"][2],
+            obj["bbox"][3],
+        ),
+        reverse=reverse,
+    )
+    occupied: set[tuple[int, int]] = set()
+    placed = []
+    for obj in ordered:
+        final_coords = _shift_until_blocked(obj["coords"], step, occupied, shape)
+        for r, c in final_coords:
+            occupied.add((int(r), int(c)))
+        placed.append(
