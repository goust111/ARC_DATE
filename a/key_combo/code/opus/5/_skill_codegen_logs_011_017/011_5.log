+    exterior_bg = _exterior_background(grid, bg)
+    totals: dict[int, int] = defaultdict(int)
+    for comp in shapes:
+        totals[int(comp["color"])] += _shape_outer_count(grid, comp["coords"], bg, exterior_bg)
+    return totals
