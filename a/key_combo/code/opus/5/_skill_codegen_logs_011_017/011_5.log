+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        candidate = _generate_candidate()
+        if candidate is None:
+            continue
+        grid, plans, placements = candidate
+        if _validate_candidate(grid, plans, placements):
