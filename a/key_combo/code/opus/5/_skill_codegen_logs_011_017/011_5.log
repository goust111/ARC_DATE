+def _count_mask_outer(mask: np.ndarray) -> int:
+    grid = np.zeros((mask.shape[0] + 4, mask.shape[1] + 4), dtype=int)
+    grid[2 : 2 + mask.shape[0], 2 : 2 + mask.shape[1]][mask] = 1
