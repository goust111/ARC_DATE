+    out = g.copy()
+    for comp in shapes:
+        for r, c in comp["coords"]:
+            out[int(r), int(c)] = int(bg)
+
+    for frame in frames:
+        color = int(frame["color"])
+        r0, c0, r1, c1 = map(int, frame["bbox"])
+        center_r = (r0 + r1) // 2
+        cols = list(range(c1 - 1, c0, -2))
+        for c in cols[: min(len(cols), int(totals.get(color, 0)))]:
