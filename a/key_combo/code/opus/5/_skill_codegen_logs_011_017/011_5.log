+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if grid[r, c] == int(bg) and not seen[r, c]:
+                seen[r, c] = True
+                q.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if grid[r, c] == int(bg) and not seen[r, c]:
+                seen[r, c] = True
+                q.append((int(r), int(c)))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
