+    h, w = grid.shape
+    outline: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for nr, nc in neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == int(bg) and exterior_bg[nr, nc]:
+                outline.add((int(nr), int(nc)))
+    return int(len(outline))
