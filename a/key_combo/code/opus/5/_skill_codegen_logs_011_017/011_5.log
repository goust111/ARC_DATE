+def _reserve_bbox(mask: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> None:
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, int(r0) - pad)
+    cc0 = max(0, int(c0) - pad)
+    rr1 = min(mask.shape[0] - 1, int(r1) + pad)
+    cc1 = min(mask.shape[1] - 1, int(c1) + pad)
