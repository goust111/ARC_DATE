+    cc0 = max(0, int(c0) - pad)
+    rr1 = min(mask.shape[0] - 1, int(r1) + pad)
+    cc1 = min(mask.shape[1] - 1, int(c1) + pad)
+    mask[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
