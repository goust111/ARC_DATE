+
+def _naive_adjacent_bg_count(grid: np.ndarray, coords: np.ndarray, bg: int) -> int:
+    h, w = grid.shape
+    outline: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for nr, nc in neighbors4(int(r), int(c)):
