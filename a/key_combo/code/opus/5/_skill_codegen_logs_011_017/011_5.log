+    height, width = _bbox_size(comp["bbox"])
+    if height < 5 or width < 5:
+        return False
+    border = np.zeros((height, width), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.array_equal(sub == color, border):
+        return False
+    return bool(np.all(sub[1:-1, 1:-1] == int(bg)))
