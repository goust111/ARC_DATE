+    for i, plan in enumerate(plans):
+        height = heights[i]
+        width = widths[i]
+        c0_min = 1
+        c0_max = w - width - 1
+        if c0_max < c0_min:
+            return None
+        c0 = random.randint(c0_min, c0_max)
+        r0 = row
+        bbox = (r0, c0, r0 + height - 1, c0 + width - 1)
