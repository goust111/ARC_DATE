    for color, total in totals.items():
        if int(total) != int(plan_by_color[int(color)]["total"]):
            return False

    output = main(grid)
    if output.shape != grid.shape:
        return False

    for comp in shapes:
        for r, c in comp["coords"]:
            if output[int(r), int(c)] != int(bg):
