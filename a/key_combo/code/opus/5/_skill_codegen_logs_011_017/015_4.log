+    ends = [i for i in range(n) if outdeg[i] == 0]
+    assert len(starts) == 1
+    assert len(ends) == 1
+    for i in range(n):
+        if i in starts:
+            assert outdeg[i] == 1
+        elif i in ends:
+            assert indeg[i] == 1
+        else:
