+    candidates = []
+    for k in range(4):
+        rotated = np.rot90(block, k)
+        conflict = (rotated != BLACK) & (ref != BLACK) & (rotated != ref)
+        if np.any(conflict):
+            continue
+        matches = int(np.sum(rotated == ref))
+        missing = int(np.sum(rotated == BLACK))
+        candidates.append((matches, -missing, k))
