                    # 8-disconnect check: no 8-neighbor of (nr,nc) should be a different blob
                    conflict = False
                    for dr2 in (-1, 0, 1):
                        for dc2 in (-1, 0, 1):
                            if dr2 == 0 and dc2 == 0:
