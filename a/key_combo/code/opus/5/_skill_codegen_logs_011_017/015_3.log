+    g = np.asarray(grid, dtype=int)
+    sep_rows = [r for r in range(g.shape[0]) if bool(np.all(g[r, :] == SEP))]
+    sep_cols = [c for c in range(g.shape[1]) if bool(np.all(g[:, c] == SEP))]
