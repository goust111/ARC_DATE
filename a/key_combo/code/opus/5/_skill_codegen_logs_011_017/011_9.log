+    region_specs: list[dict] = []
+    for wall_color in wall_colors:
+        built = _build_region_patch(wall_color)
+        if built is None:
+            return None
+        clean, noisy = built
+        region_specs.append({"wall_color": wall_color, "clean": clean, "noisy": noisy})
