+            wall_info[(r, c1)] = (color, True, False)
+        wall_info[(r0, c0)] = (color, True, True)
+        wall_info[(r0, c1)] = (color, True, True)
+        wall_info[(r1, c0)] = (color, True, True)
+        wall_info[(r1, c1)] = (color, True, True)
