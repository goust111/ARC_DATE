+    if tile_size == 2:
+        h = tile_size * random.choice((3, 4))
+        w = tile_size * random.choice((3, 4))
+    else:
+        h = tile_size * random.choice((2, 3))
+        w = tile_size * random.choice((2, 3))
+
+    clean = _tile_fill((h, w), tile)
+    noisy = _add_noise(clean, tile_size)
