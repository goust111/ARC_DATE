+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+
+    if connectivity == 8:
+        nbrs = _neighbors8
+    else:
+        def nbrs(r: int, c: int):
+            yield r - 1, c
+            yield r + 1, c
+            yield r, c - 1
+            yield r, c + 1
