+def _add_noise(clean: np.ndarray, tile_size: int) -> np.ndarray | None:
+    noisy = clean.copy()
+    h, w = clean.shape
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    target = random.randint(2, 4)
+    chosen: list[tuple[int, int]] = []
+    residue_hits = Counter()
+
+    for r, c in cells:
+        rr = r % tile_size
+        cc = c % tile_size
