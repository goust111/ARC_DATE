+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+WALL_COLORS = (BLUE, RED)
+TILE_COLORS = (GREEN, YELLOW, ORANGE)
+WALL_TO_TILE = {BLUE: 3, RED: 2}
+
+GEN_ATTEMPTS = 600
+GEN_GRID_RANGE = (22, 29)
