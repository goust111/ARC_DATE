+    out = np.array(grid, dtype=int, copy=True)
+    terminal_set = set(scene["terminals"])
+    for idx in path:
+        if idx in terminal_set:
+            continue
+        nd = scene["nodes"][idx]
+        for r, c in nd["cells"]:
+            out[int(r), int(c)] = GREEN
+    return out
+
+
+def _place_node(grid: np.ndarray, r0: int, c0: int, color: int, dir_name: str) -> None:
