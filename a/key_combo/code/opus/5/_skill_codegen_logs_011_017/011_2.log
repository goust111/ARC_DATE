    for i,n in enumerate(nodes):
        stuff=node_cells(n)|arrow_cells(n,dirs[i])|{start(n,dirs[i])}
        if not all(inb(p) for p in stuff): return None
        if used & stuff: return None
        used |= stuff
    if set(walls)&used: return None
    sim=simulate(nodes,dirs,walls)
    if any(x is None for x in sim): return None
    pr={'direct':0,'yellow':1,'green':2}
    kinds={}
