DIRS=[(-1,-1),(-1,1),(1,-1),(1,1)]
regions={0:[(r,c) for r in range(13,18) for c in range(3,8)],
         1:[(r,c) for r in range(8,13) for c in range(10,16)],
         2:[(r,c) for r in range(3,9) for c in range(3,9)],
         3:[(r,c) for r in range(3,9) for c in range(11,18)],
         4:[(r,c) for r in range(6,11) for c in range(15,20)]}
TEMPLATE={0:(3,'green'),1:(0,'direct'),2:(1,'yellow'),3:(4,'green'),4:(2,'direct')}

def node_cells(node):
    r,c=node
    return {(r+i,c+j) for i in range(2) for j in range(2)}

def arrow_cells(node,d):
    r,c=node
    if d==(-1,-1): ar,ac=r-2,c-2; miss=(0,0)
    elif d==(-1,1): ar,ac=r-2,c+2; miss=(0,1)
    elif d==(1,-1): ar,ac=r+2,c-2; miss=(1,0)
    else: ar,ac=r+2,c+2; miss=(1,1)
    return {(ar+i,ac+j) for i in range(2) for j in range(2) if (i,j)"'!=miss}

def start(node,d):
    r,c=node
    return {(-1,-1):(r-3,c-3),(-1,1):(r-3,c+4),(1,-1):(r+4,c-3),(1,1):(r+4,c+4)}[d]

def ring(node):
    r,c=node
    return {(r-1,c),(r-1,c+1),(r+2,c),(r+2,c+1),(r,c-1),(r+1,c-1),(r,c+2),(r+1,c+2)}

def inb(p): return 0<=p[0]<H and 0<=p[1]<W

def simulate(nodes,dirs,walls):
    rings=[ring(n) for n in nodes]
    out=[]
    for i in range(5):
        pos=start(nodes[i],dirs[i]); d=dirs[i]; last=None; seen=set()
        for _ in range(200):
            st=(pos,d,last)
            if st in seen:
                out.append(None); break
            seen.add(st)
            dr,dc=d
            front=(pos[0]+dr,pos[1]+dc)
            vr=(pos[0]+dr,pos[1])
            hc=(pos[0],pos[1]+dc)
            if front in walls:
                d=(-dr,-dc); last=walls[front]
            else:
                flip_r=vr in walls; flip_c=hc in walls
                if flip_r or flip_c:
                    if flip_r:
                        dr=-dr; last=walls[vr]
                    if flip_c:
                        dc=-dc; last=walls[hc]
                    d=(dr,dc)
                pos=(pos[0]+d[0],pos[1]+d[1])
                if not inb(pos):
                    out.append(None); break
                for j in range(5):
                    if j!=i and pos in rings[j]:
                        out.append((j,'"'direct' if last is None else last)); break
                else:
                    continue
                break
        else:
            out.append(None)
    return out


def route_options(nodes,dirs,src_i,tgt_i,kind,walls):
    occ=set()
    for i in range(5):
        occ |= node_cells(nodes[i]) | arrow_cells(nodes[i],dirs[i])
    rings=[ring(n) for n in nodes]
    S=start(nodes[src_i],dirs[src_i])
    out=[]
    d0=dirs[src_i]; dr0,dc0=d0
    if not inb(S) or S in occ or S in walls: return out
    for T in rings[tgt_i]:
        if kind=='direct':
            diff=(T[0]-S[0],T[1]-S[1])
            if diff[0]*dr0>0 and diff[1]*dc0>0 and diff[0]==diff[1]*dr0*dc0:
                k=abs(diff[0])
                pts=[(S[0]+t*dr0,S[1]+t*dc0) for t in range(0,k+1)]
                if any((not inb(p)) or p in occ or p in walls for p in pts): continue
                bad=False
                for p in pts[:-1]:
                    for j in range(5):
                        if j"'!=src_i and j!=tgt_i and p in rings[j]: bad=True
                if not bad: out.append({})
        else:
            for axis in ['"'r','c']:
                d1=(-dr0,dc0) if axis=='r' else (dr0,-dc0)
                for a in range(0,16):
                    P=(S[0]+a*dr0,S[1]+a*dc0)
                    if not inb(P) or P in occ or P in walls: break
                    diff=(T[0]-P[0],T[1]-P[1])
                    if diff[0]*d1[0] <=0 or diff[1]*d1[1] <=0 or diff[0]"'!=diff[1]*d1[0]*d1[1]: continue
                    b=abs(diff[0])
                    wall=(P[0]+dr0,P[1]) if axis=='"'r' else (P[0],P[1]+dc0)
                    front=(P[0]+dr0,P[1]+dc0)
                    other=(P[0],P[1]+dc0) if axis=='r' else (P[0]+dr0,P[1])
                    if not inb(wall) or wall in occ or (wall in walls and walls[wall]"'!=kind): continue
                    if front in occ or front in walls or other in occ or other in walls: continue
                    pts1=[(S[0]+t*dr0,S[1]+t*dc0) for t in range(0,a+1)]
                    pts2=[(P[0]+t*d1[0],P[1]+t*d1[1]) for t in range(1,b+1)]
                    if any((not inb(p)) or p in occ or p in walls for p in pts1): continue
                    if any((not inb(p)) or p in occ or p in ({wall}|set(walls)) for p in pts2): continue
                    bad=False
                    for p in pts1[:-1]+pts2[:-1]:
                        for j in range(5):
                            if j!=src_i and j!=tgt_i and p in rings[j]: bad=True
                    if not bad: out.append({wall:kind})
    return out

for attempt in range(200000):
    nodes=[random.choice(regions[i]) for i in range(5)]
    if len(set(nodes))<5: continue
    # spacing
    bad=False
    for a,b in itertools.combinations(nodes,2):
        if abs(a[0]-b[0])<4 and abs(a[1]-b[1])<4:
            bad=True
    if bad: continue
    for dirs in [tuple(random.choice(DIRS) for _ in range(5)) for _ in range(12)]:
        # occupancy
        used=set(); ok=True
        for i in range(5):
            ac=arrow_cells(nodes[i],dirs[i]); nc=node_cells(nodes[i])
            if any(not inb(p) for p in ac) or used & (ac|nc) or ac & nc:
                ok=False; break
            used |= ac|nc
        if not ok: continue
        order=[0,2,3,1,4]  # green/yellow first
        def back(k,walls):
            if k==len(order):
                sim=simulate(nodes,dirs,walls)
                return walls if all(sim[i]==TEMPLATE[i] for i in range(5)) else None
            i=order[k]
            tgt,kind=TEMPLATE[i]
            opts=route_options(nodes,dirs,i,tgt,kind,walls)
            random.shuffle(opts)
            for add in opts[:20]:
                nw=dict(walls)
                good=True
                for p,col in add.items():
                    if p in nw and nw[p]!=col: good=False
                    nw[p]=col
                if not good: continue
                ans=back(k+1,nw)
                if ans is not None: return ans
            return None
        ans=back(0,{})
        if ans is not None:
            print('"'FOUND',attempt)
            print('nodes',nodes)
            print('dirs',dirs)
            print('walls',ans)
            print('sim',simulate(nodes,dirs,ans))
            raise SystemExit
print('none')
