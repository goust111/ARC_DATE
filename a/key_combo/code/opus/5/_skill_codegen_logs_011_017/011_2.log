                continue
            break
        else:
            out.append(None)
    return out

def bfs(adj, n=5):
    q=deque([0]); dist={0:0}; cnt={0:1}; par={0:None}
    while q:
        u=q.popleft()
        for v in adj[u]:
            if v not in dist:
                dist[v]=dist[u]+1; cnt[v]=cnt[u]; par[v]=u; q.append(v)
            elif dist[v]==dist[u]+1:
                cnt[v]+=cnt[u]
    return dist,cnt,par

def analyze(nodes,dirs,walls):
