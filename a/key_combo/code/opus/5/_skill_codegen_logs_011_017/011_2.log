                        if flip_r:
                            dr=-dr; last=walls[vr]
                        if flip_c:
                            dc=-dc; last=walls[hc]
                        d=(dr,dc)
                    pos=(pos[0]+d[0],pos[1]+d[1])
                    if not inb(pos):
