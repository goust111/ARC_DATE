        adj_all[a].add(b); adj_all[b].add(a)
        if k"'!='"'green': adj_allow[a].add(b); adj_allow[b].add(a)
    dist,cnt,par=bfs(adj_allow)
    if 4 not in dist or cnt[4]"'!=1 or dist[4]<2: return None
    dist_all,cnt_all,_=bfs(adj_all)
    if 4 not in dist_all: return None
    # green must matter
    if not (dist_all[4] < dist[4] or (dist_all[4]==dist[4] and cnt_all.get(4,0) > cnt[4])):
        return None
    if min(counts.values()) < 1:
