+    return _bbox_center(anchor)
+
+
+def _mark_box(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 0) -> None:
+    h, w = mask.shape
+    rr0 = max(0, int(r0) - int(pad))
+    cc0 = max(0, int(c0) - int(pad))
+    rr1 = min(h - 1, int(r1) + int(pad))
+    cc1 = min(w - 1, int(c1) + int(pad))
