+
+BG = 0
+BORDER = 5
+EXAMPLE = 6
+ACTIVE_COLORS = (1, 2, 3)
+
+RATIO_SQUARE = (1, 1)
+RATIO_TALL = (1, 2)
+RATIO_WIDE = (2, 1)
+RATIOS = (RATIO_SQUARE, RATIO_TALL, RATIO_WIDE)
