+    if len(groups_meta) not in (2, 3):
+        return False
+    if len({g["ratio"] for g in groups_meta}) != len(groups_meta):
+        return False
+    if len({g["color"] for g in groups_meta}) != len(groups_meta):
+        return False
+    if len(example_cells) != len(_glyph_cells(random.choice(RATIOS))):
