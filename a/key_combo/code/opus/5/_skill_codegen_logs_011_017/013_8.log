+def _glyph_cells(ratio: tuple[int, int]) -> list[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    if ratio == RATIO_SQUARE:
+        for i in range(5):
+            cells.add((2, i))
+            cells.add((i, 2))
+    elif ratio == RATIO_TALL:
+        for i in range(5):
+            cells.add((0, i))
+            cells.add((i, 2))
+    elif ratio == RATIO_WIDE:
+        for i in range(5):
