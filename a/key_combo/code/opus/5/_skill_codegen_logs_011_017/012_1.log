+def _gen_attempt() -> np.ndarray | None:
+    shape = (random.choice(GRID_CHOICES), random.choice(GRID_CHOICES))
+    local_limit = min(shape[0] // 2, shape[1] // 2)
+    colors = list(INPUT_COLORS)
