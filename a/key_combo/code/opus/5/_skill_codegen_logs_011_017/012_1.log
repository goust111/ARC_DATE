153:         min_hw = max(prev_hw, 1) if layer == 1 else max(prev_hw - 1, 0)
154:         max_hw = prev_hw + MAX_HALF_WIDTH_STEP
155:         feasible_hws = [hw for hw in range(min_hw, max_hw + 1) if 2 * hw + 1 <= remaining]
156:         if not feasible_hws:
157:             needed_hw = (remaining - 1) // 2
158:             if needed_hw >= min_hw and remaining == 2 * needed_hw + 1:
159:                 feasible_hws = [needed_hw]
160:             else:
161:                 break
162: 
163:         hw = rng.choice(feasible_hws)
164:         layer_pixels = [_perp_coord(direction, br, bc, off) for off in range(-hw, hw + 1)]
165:         coords.extend(layer_pixels)
166:         remaining -= len(layer_pixels)
167:         prev_hw = hw
