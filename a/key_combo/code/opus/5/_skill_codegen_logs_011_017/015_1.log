+    rng.shuffle(placements)
+    for r0, c0 in placements:
+        abs_cells = [(r0 + r, c0 + c) for r, c in cells]
+        ok = True
+        for rr, cc in abs_cells:
+            if not _cell_is_free(blocked, rr, cc):
