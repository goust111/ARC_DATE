+    cells: list[tuple[int, int]],
+    colors: list[int],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    arr = np.array(cells, dtype=int)
+    h = int(arr[:, 0].max()) + 1
+    w = int(arr[:, 1].max()) + 1
