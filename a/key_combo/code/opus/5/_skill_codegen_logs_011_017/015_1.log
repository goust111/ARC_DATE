+
+    true_sequence = [col for seq in chain_sequences for col in seq]
+    target_rect_colors = true_sequence[:n_rects]
+    rect_colors = _choose_distinct_rectangle_colors(n_rects, target_rect_colors, rng)
+    if rect_colors is None:
+        return None
+
