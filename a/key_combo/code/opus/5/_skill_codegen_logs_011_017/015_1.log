+    for shape, color in zip(rect_shapes, rect_colors):
+        placed = _place_object(grid, blocked, shape, [color] * len(shape), rng)
+        if placed is None:
+            return None
+
+    if not _validate_instance(grid):
+        return None
+    return grid
+
