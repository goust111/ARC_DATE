+    row_colors = [seq[i] for i in range(len(rects))]
+    col_colors = row_colors[:]
+    alt = grid.copy()
+    for snake in snakes:
+        for r, c in snake["coords"]:
+            alt[r, c] = 0
+    for i, rect_idx in enumerate(col_order):
