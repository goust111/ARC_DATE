+        cc = left + int(c)
+        for nr, nc in [(rr, cc), (rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1), (rr - 1, cc - 1), (rr - 1, cc + 1), (rr + 1, cc - 1), (rr + 1, cc + 1)]:
