+
+    out = np.full_like(g, bg)
+    placements = []
+    for rank, src in enumerate(ordered, start=1):
+        scaled = scale_sprite(src["patch"], rank)
+        ar, ac = src["anchor_rel"]
+        marker_r, marker_c = markers[src["anchor_color"]]
