+    assert bg == BG
+
+    spec_by_anchor = {int(spec["anchor_color"]): spec for spec in specs}
+    assert set(markers) == set(spec_by_anchor)
+    parsed_areas = sorted(src["area"] for src in sources)
+    expected_areas = sorted(int(spec["area"]) for spec in specs)
