+            top = random.randint(0, h - sh)
+            left = random.randint(target_left, w - sw)
+            marker = (top + ar * spec["rank"], left + ac * spec["rank"])
+            if any(abs(marker[0] - mr) + abs(marker[1] - mc) <= 1 for mr, mc in marker_positions):
