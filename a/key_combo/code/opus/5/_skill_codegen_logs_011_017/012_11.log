+        top, left = spec["stamp_top_left"]
+        paste(out, spec["scaled_patch"], top, left, transparent=BG)
+    return out
+
+
+def _validate_generated_case(grid: np.ndarray, specs: list[dict], allow_overlap: bool) -> None:
