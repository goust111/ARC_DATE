+
+def _normalize(coords: set[tuple[int, int]]) -> np.ndarray:
+    min_r = min(r for r, _ in coords)
+    min_c = min(c for _, c in coords)
+    arr = np.array(sorted((r - min_r, c - min_c) for r, c in coords), dtype=int)
+    return arr
+
