+
+def _valid_example(grid: np.ndarray) -> bool:
+    if grid.shape[0] > 30 or grid.shape[1] > 30:
+        return False
+    if int(grid[0, 0]) != RED or int(grid[0, 1]) != GREEN:
+        return False
+    if len(_components_of_color(grid, MAROON)) != 1:
