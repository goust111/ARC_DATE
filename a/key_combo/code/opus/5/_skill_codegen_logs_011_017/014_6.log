+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    comps = find_components(
+        grid,
+        bg=_get_bg(grid),
+        connectivity=4,
+        monochromatic=True,
+        colors=[color],
+        return_format="dict",
+    )
+    return [comp["coords"].astype(int, copy=False) for comp in comps]
