+
+def _steps_to_edge(coords: np.ndarray, move_side: str, shape: tuple[int, int]) -> int:
+    if move_side == "up":
+        return int(coords[:, 0].min())
+    if move_side == "down":
+        return int(shape[0] - 1 - coords[:, 0].max())
+    if move_side == "left":
+        return int(coords[:, 1].min())
+    return int(shape[1] - 1 - coords[:, 1].max())
