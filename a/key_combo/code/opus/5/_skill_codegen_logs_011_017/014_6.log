+def _path_clear(grid: np.ndarray, coords: np.ndarray, move_side: str, steps: int) -> bool:
+    own = _coords_set(coords)
+    dr, dc = SIDES[move_side]
+    for step in range(1, steps + 1):
+        for r, c in coords:
+            nr = int(r) + dr * step
+            nc = int(c) + dc * step
