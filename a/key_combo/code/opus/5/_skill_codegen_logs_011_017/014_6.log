+def _place_marker(grid: np.ndarray, rng: random.Random) -> set[tuple[int, int]] | None:
+    area = rng.randint(4, 8)
+    shape = _random_polyomino(area, rng, h_max=4, w_max=4)
+    if shape is None:
+        return None
+    h = max(r for r, _ in shape) + 1
+    w = max(c for _, c in shape) + 1
