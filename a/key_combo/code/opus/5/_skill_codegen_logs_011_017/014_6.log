+            cc = int(c)
+            assert 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]
+            assert int(out[rr, cc]) == BG, "moved objects must not overlap markers, legend, or each other"
+        out[coords[:, 0], coords[:, 1]] = int(color)
+
+    return out
