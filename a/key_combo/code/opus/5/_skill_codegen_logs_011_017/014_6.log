+    r0_hi = min(grid.shape[0] - h - 3, grid.shape[0] // 2 + 1)
+    c0_lo = max(3, grid.shape[1] // 2 - 2)
+    c0_hi = min(grid.shape[1] - w - 3, grid.shape[1] // 2 + 1)
+    if r0_lo > r0_hi or c0_lo > c0_hi:
+        return None
+    r0 = rng.randint(r0_lo, r0_hi)
+    c0 = rng.randint(c0_lo, c0_hi)
