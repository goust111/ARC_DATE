+
+    expected = _expected_output(inp, bbox, markers)
+    if not _validate_case(inp, expected, bbox, color_to_thickness, markers):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
