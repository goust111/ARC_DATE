+        "r": int(r),
+        "c": int(c),
+        "dr": int(dr),
+        "dc": int(dc),
+        "color": int(marker["color"]),
+        "steps": int(marker["thickness"]),
+    }
+
+
+def _expected_output(inp: np.ndarray, bbox: tuple[int, int, int, int], markers: list[dict]) -> np.ndarray:
