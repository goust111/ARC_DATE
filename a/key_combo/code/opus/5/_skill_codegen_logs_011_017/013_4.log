+
+def _gen_attempt() -> np.ndarray | None:
+    layers = _sample_layers()
+    total_radius = sum(thickness for _color, thickness in layers)
+    side = 1 + 2 * total_radius
+    h = random.randint(max(17, side + 10), min(29, side + 12))
