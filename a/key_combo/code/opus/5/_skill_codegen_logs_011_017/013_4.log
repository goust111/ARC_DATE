+
+def _spec_from_marker(marker: dict, bbox: tuple[int, int, int, int]) -> dict:
+    r0, c0, r1, c1 = bbox
+    r, c = int(marker["r"]), int(marker["c"])
+    if marker["side"] == "L":
+        dr, dc = 0, 1
+    elif marker["side"] == "R":
+        dr, dc = 0, -1
+    elif marker["side"] == "T":
+        dr, dc = 1, 0
+    else:
+        dr, dc = -1, 0
