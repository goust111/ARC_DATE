167:            for s1, s2 in itertools.product(_GAP_SHAPES, repeat=2):
168:                gap_area = s1[0] * s1[1] + s2[0] * s2[1]
169:                fill_ratio = (h * w - gap_area) / (h * w)
170:                if not _TARGET_FILL_RATIO_MIN <= fill_ratio <= _TARGET_FILL_RATIO_MAX:
171:                    continue
172:                for r1 in range(h - s1[0] + 1):
173:                    for c1 in range(w - s1[1] + 1):
174:                        m1 = _rect_mask((h, w), (r1, c1, *s1))
175:                        for r2 in range(h - s2[0] + 1):
176:                            for c2 in range(w - s2[1] + 1):
177:                                m2 = _rect_mask((h, w), (r2, c2, *s2))
178:                                if np.any(m1 & m2):
179:                                    continue
180:                                gaps = m1 | m2
181:                                target = ~gaps
182:                                if not _valid_target_masks(gaps, target):
183:                                    continue
184:                                same_shape = s1 == s2
185:                                configs.setdefault((h, w, same_shape), []).append(
186:                                    ((r1, c1, *s1), (r2, c2, *s2))
187:                                )
