+def _parse_diamond(coords: np.ndarray) -> tuple[int, int, int]:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    if (r1 - r0) != (c1 - c0) or ((r1 - r0) % 2) != 0:
+        raise AssertionError("diamond bbox must be odd square")
