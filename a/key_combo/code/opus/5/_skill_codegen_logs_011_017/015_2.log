+        count = len(_components((g == BLACK) & obj["interior"], connectivity=4))
+        if count == 0:
+            new_radius = obj["radius"]
+        elif count % 2 == 1:
+            new_radius = obj["radius"] + 1
+        else:
+            new_radius = obj["radius"] - 1
+        transformed.append(
+            {
+                "color": obj["color"],
+                "center": obj["center"],
+                "radius": obj["radius"],
+                "new_radius": int(new_radius),
+            }
+        )
