+def _spot_allowed_rel_cells(radius: int) -> set[tuple[int, int]]:
+    if radius < 2:
+        return set()
+    out = set()
+    inner = radius - 2
+    for dr in range(-inner, inner + 1):
+        span = inner - abs(dr)
+        for dc in range(-span, span + 1):
+            out.add((dr, dc))
+    return out
