7:def main(grid: np.ndarray) -> np.ndarray:
8:    """
9:    Assemble scattered rectangular pieces into a rectangle at an L-marker corner.
10:
11:    Input structure:
12:    - bg = most common color. Non-bg rectangular pieces scattered on the grid.
13:    - 3-pixel L-marker (2x2 minus one cell) tags the corner; the gap is the corner cell.
14:
15:    Rule:
16:    - rect_col = most common color across all piece pixels; all outer rectangle edges must be rect_col.
17:    - Translate pieces (no rotation) to tile the rectangle; touching edges must match, with rect_col as wildcard.
18:
19:    Key insight: rect_col acts as wildcard during edge matching — only non-rect_col pixels at shared boundaries must agree.
20:    """
21:    inp = grid
22:    g = np.array(inp, dtype=int)
23:    GH, GW = g.shape
24:
25:    bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])
26:
27:    # Find marker: a color appearing exactly 3 times forming an L in a 2x2 bbox.
28:    cnt = Counter(map(int, g.flatten()))
29:    mark = None
30:    missing = None
31:    mb = None  # marker bbox
32:    for col in sorted([c for c, n in cnt.items() if int(c) != int(bg) and int(n) == 3]):
33:        pts = [(int(r), int(c)) for r, c in np.argwhere(g == int(col))]
34:        rs = [r for r, _ in pts]
35:        cs = [c for _, c in pts]
36:        r0, r1 = min(rs), max(rs)
37:        c0, c1 = min(cs), max(cs)
38:        if (r1 - r0) == 1 and (c1 - c0) == 1:
39:            all4 = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
40:            miss = list(all4 - set(pts))
41:            if len(miss) == 1:
42:                mark = int(col)
43:                missing = miss[0]
44:                mb = (r0, c0, r1, c1)
45:                break
46:
47:    assert not (mark is None or missing is None or mb is None)
48:
49:    r0, c0, r1, c1 = mb
50:    # Rectangle corner is opposite the marker bulk.
51:    if missing == (r0, c0):
52:        corner = "BR"
53:    elif missing == (r0, c1):
54:        corner = "BL"
55:    elif missing == (r1, c0):
56:        corner = "TR"
57:    else:
58:        corner = "TL"
59:
60:    # Decompose occupied mask (non-bg and non-marker) into rectangles.
61:    occ = (g != int(bg)) & (g != int(mark))
62:    used = np.zeros_like(occ, dtype=bool)
63:    rects = []  # (r, c, h, w, arr)
64:    while True:
65:        idx = np.argwhere(occ & (~used))
66:        if idx.size == 0:
67:            break
68:        rr, cc = map(int, idx[0])
69:        w = 0
70:        while cc + w < GW and bool(occ[rr, cc + w]) and (not bool(used[rr, cc + w])):
71:            w += 1
72:        h = 0
73:        while rr + h < GH and bool((occ[rr + h, cc : cc + w] & (~used[rr + h, cc : cc + w])).all()):
74:            h += 1
75:        used[rr : rr + h, cc : cc + w] = True
76:        rects.append((rr, cc, h, w, g[rr : rr + h, cc : cc + w].copy()))
77:
78:    total_area = int(sum(int(h) * int(w) for _r, _c, h, w, _a in rects))
79:
80:    # The final rectangle's border/background color.
81:    allpix = []
82:    for _r, _c, _h, _w, a in rects:
83:        allpix.extend(map(int, a.flatten()))
84:    rect_col = int(Counter(allpix).most_common(1)[0][0])
85:
86:    mr, mc = map(int, missing)
87:
88:    # Anchor piece: the rectangle containing the corner cell.
89:    anchor_idx = None
90:    for i, (rr, cc, h, w, _a) in enumerate(rects):
91:        if rr <= mr < rr + h and cc <= mc < cc + w:
92:            anchor_idx = i
93:            break
94:
95:    pieces = [a for _r, _c, _h, _w, a in rects]
96:    ph = [int(p.shape[0]) for p in pieces]
97:    pw = [int(p.shape[1]) for p in pieces]
98:
99:    # Candidate rectangle dimensions are factor pairs of total_area that fit in the grid
100:    # when anchored at (mr, mc) as the specified corner.
101:    dims = []
102:    for hh in range(1, int(total_area**0.5) + 1):
103:        if total_area % hh == 0:
104:            dims.append((hh, total_area // hh))
105:            if hh * hh != total_area:
106:                dims.append((total_area // hh, hh))
107:
108:    def fits(H, W):
109:        if corner == "TL":
110:            tr, tc = mr, mc
111:        elif corner == "TR":
112:            tr, tc = mr, mc - W + 1
113:        elif corner == "BL":
114:            tr, tc = mr - H + 1, mc
115:        else:  # "BR"
116:            tr, tc = mr - H + 1, mc - W + 1
117:        return 0 <= tr and 0 <= tc and (tr + H) <= GH and (tc + W) <= GW
118:
119:    dims = [(int(H), int(W)) for H, W in dims if fits(int(H), int(W))]
120:    dims = sorted(dims, key=lambda t: (-t[0] * t[1], -t[0], -t[1]))
121:
122:    def compat(v1, v2):
123:        v1 = np.array(v1, dtype=int)
124:        v2 = np.array(v2, dtype=int)
125:        m = (v1 != int(rect_col)) & (v2 != int(rect_col))
126:        return bool((v1[m] == v2[m]).all())
