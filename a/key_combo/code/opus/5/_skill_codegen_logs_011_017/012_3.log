+def _legend_layout(width: int, sprites: list[dict], colors: list[int]) -> tuple[list[dict], np.ndarray] | None:
+    sprite_widths = [int(item["mask"].shape[1]) for item in sprites]
+    min_total = sum(sprite_widths) + (len(sprites) - 1)
+    if min_total > width:
