+    c_lo, c_hi = sorted((int(c0), int(c1)))
+    stroke[int(r0), c_lo : c_hi + 1] = True
+    r_lo, r_hi = sorted((int(r0), int(r1)))
+    stroke[r_lo : r_hi + 1, int(c1)] = True
