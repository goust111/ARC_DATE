+
+
+def _find_separator_row(grid: np.ndarray) -> int:
+    g = np.asarray(grid, dtype=int)
+    rows = [r for r in range(g.shape[0]) if np.all(g[r] == 6)]
+    assert len(rows) == 1, "expected a unique full-width magenta separator row"
+    return int(rows[0])
