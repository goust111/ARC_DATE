+        "points": {k: v for k, v in mapped.items()},
+        "stroke": stroke,
+        "filled": filled,
+        "point_count": point_count,
+        "stroke_count": int(stroke.sum()),
+        "fill_count": int(filled.sum()),
+    }
+
+
+def _find_separator_row(grid: np.ndarray) -> int:
