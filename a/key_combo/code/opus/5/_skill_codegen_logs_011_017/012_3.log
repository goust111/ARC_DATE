+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    cols = sorted(set(map(int, np.asarray(grid).ravel())))
+    if exclude is None:
+        return cols
+    return [c for c in cols if c not in exclude]
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.asarray(grid)[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    colors: list[int] | tuple[int, ...] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = get_bg(g)
+    if colors is None:
+        colors = colors_present(g, exclude={int(bg)})
+    out = []
+    for color in colors:
+        for coords in components_mask(g == int(color)):
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return out
+
+
+def _rect_frame_bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0, r1, c1 = bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+    expected = np.zeros_like(mask, dtype=bool)
+    expected[r0 : r1 + 1, c0] = True
+    expected[r0 : r1 + 1, c1] = True
+    expected[r0, c0 : c1 + 1] = True
+    expected[r1, c0 : c1 + 1] = True
+    if not np.array_equal(mask, expected):
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _scaled_index(i: int, src_len: int, dst_len: int) -> int:
+    if src_len == 1:
+        return int((dst_len - 1) // 2)
+    return int(np.floor((int(i) * (dst_len - 1) / (src_len - 1)) + 0.5))
