+        cols_with_pixels = np.where(mask.any(axis=0))[0]
+        marker_c = x + int(random.choice(list(cols_with_pixels)))
+        legend[3, marker_c] = int(color)
+        layout.append({"color": int(color), "mask": mask, "x": int(x), "marker_c": int(marker_c)})
