+
+def _parse_legend(legend: np.ndarray) -> list[dict]:
+    g = np.asarray(legend, dtype=int)
+    assert g.shape[0] >= 4, "legend must contain sprites plus marker row"
+    marker_row = g.shape[0] - 1
