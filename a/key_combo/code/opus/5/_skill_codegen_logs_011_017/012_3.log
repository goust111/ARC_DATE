+    min_total = sum(sprite_widths) + (len(sprites) - 1)
+    if min_total > width:
+        return None
+    slack = width - min_total
+    gaps = _random_composition(slack, len(sprites) + 1)
+    x = gaps[0]
+    layout = []
+    legend = np.zeros((4, width), dtype=int)
+    for idx, (sprite, color) in enumerate(zip(sprites, colors)):
+        mask = sprite["mask"]
+        h, w = mask.shape
+        top = 3 - h
