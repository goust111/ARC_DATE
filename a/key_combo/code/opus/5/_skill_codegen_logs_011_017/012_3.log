+
+    legend_data = _legend_layout(work_w, sprites, colors)
+    if legend_data is None:
+        return None
+    _layout, legend = legend_data
+
+    grid = np.zeros((5 + work_h, work_w), dtype=int)
+    grid[:4] = legend
+    grid[4, :] = 6
+    for item in placed:
