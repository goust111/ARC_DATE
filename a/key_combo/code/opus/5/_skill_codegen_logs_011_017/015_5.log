+        shifted = row_cells[-anomaly_col:] + row_cells[:-anomaly_col] if anomaly_col else list(row_cells)
+        new_idx = (2 * anomaly_col) % ncols
+        extracted.append(shifted[new_idx])
+    return _render_column(extracted, SEP)
+
