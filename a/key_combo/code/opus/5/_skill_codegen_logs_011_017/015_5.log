+    assert len(row_heights) == 1 and len(col_widths) == 1
+    cell_h = next(iter(row_heights))
+    cell_w = next(iter(col_widths))
+    assert cell_h == cell_w == CELL_SIZE
+    cells: list[list[np.ndarray]] = []
+    for r0, r1 in row_bands:
