+def _bands_from_separators(length: int, separators: list[int]) -> list[tuple[int, int]]:
+    separators = sorted(set(int(x) for x in separators))
+    bands = []
+    prev = -1
+    for cur in separators + [length]:
+        if cur - prev > 1:
+            bands.append((prev + 1, cur))
+        prev = cur
+    return bands
