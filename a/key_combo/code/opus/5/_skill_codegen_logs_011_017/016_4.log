+
+    parity_flipped = {}
+    for agent in actual_agents:
+        parity_flipped[int(agent["index"])] = "line" if agent["kind"] == "spiral" else "spiral"
+    flipped_out, _ = _simulate(grid, behavior_override=parity_flipped)
+    if np.array_equal(out, flipped_out):
+        return False
+
+    return True
