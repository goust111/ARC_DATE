+    shape: tuple[int, int],
+    center: tuple[int, int],
+    lengths: list[int],
+) -> np.ndarray:
+    h, w = map(int, shape)
+    cr, cc = map(int, center)
+    g = np.zeros((h, w), dtype=int)
+    g[cr, cc] = CROSS
+    for arm_idx, (dr, dc) in enumerate(DIRS_URDL):
+        for step in range(1, int(lengths[arm_idx]) + 1):
+            rr = int(cr + dr * step)
+            cc2 = int(cc + dc * step)
+            g[rr, cc2] = CROSS
+    return g
