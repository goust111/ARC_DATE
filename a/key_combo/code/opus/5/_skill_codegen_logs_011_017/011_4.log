+    err = dc - dr
+    r, c = r0, c0
+    while True:
+        points.append((r, c))
+        if r == r1 and c == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dr:
+            err -= dr
+            c += sc
+        if e2 < dc:
+            err += dc
+            r += sr
+    return points
+
+
+def _apply_corner_transform(mask: np.ndarray, corner: str) -> np.ndarray:
+    out = mask
+    if corner in ("bl", "br"):
+        out = np.flipud(out)
+    if corner in ("tr", "br"):
+        out = np.fliplr(out)
+    return out
+
+
+def _phase_offset(corner: str, size: int) -> tuple[int, int]:
+    if corner == "tl":
+        return 0, 0
+    if corner == "tr":
+        return 0, size - 3
+    if corner == "bl":
+        return size - 3, 0
+    if corner == "br":
+        return size - 3, size - 3
+    raise AssertionError("invalid corner")
