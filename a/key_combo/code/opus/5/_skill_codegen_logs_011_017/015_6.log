+    r0 = rng.randint(0, panel_h - rect_h)
+    c0 = rng.randint(1, width - total_w - 1)
+    panel[r0 : r0 + rect_h, c0 : c0 + left_w] = left_color
+    panel[r0 : r0 + rect_h, c0 + left_w + gap : c0 + total_w] = right_color
+    return panel
