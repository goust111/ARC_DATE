+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _flood_mask(passable: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = passable.shape
+    sr, sc = start
+    inside = np.zeros((h, w), dtype=bool)
+    stack = [(int(sr), int(sc))]
+    while stack:
+        r, c = stack.pop()
+        if not (0 <= r < h and 0 <= c < w):
+            continue
+        if inside[r, c] or not passable[r, c]:
+            continue
+        inside[r, c] = True
+        for nr, nc in neighbors4(r, c):
+            stack.append((nr, nc))
+    return inside
+
+
+def _split_segments(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    sep_rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == BLUE)]
+    assert len(sep_rows) == 2
