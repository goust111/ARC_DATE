+    assert len(sep_rows) == 2
+    r0, r1 = sep_rows
+    assert r0 > 0 and r1 > r0 + 1 and r1 < grid.shape[0] - 1
+    return grid[:r0, :], grid[r0 + 1 : r1, :], grid[r1 + 1 :, :]
