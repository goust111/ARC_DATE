+def _validate_grid(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    top, mid, bottom = _split_segments(grid)
+    if np.count_nonzero(top == RED) != 1:
+        return False
+    if len(_components_from_mask(top == GREY)) != 1:
