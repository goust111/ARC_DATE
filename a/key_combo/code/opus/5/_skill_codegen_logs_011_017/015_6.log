+        lower_count = branch_count - upper_count
+        upper_cols = _sample_positions(rng, upper_count, width)
+        lower_cols = _sample_positions(rng, lower_count, width)
+        if upper_cols is None or lower_cols is None:
+            return None
+        top[spine_r, :] = GREY
+        for c in upper_cols:
+            top[: spine_r + 1, c] = GREY
+        for c in lower_cols:
+            top[spine_r:, c] = GREY
