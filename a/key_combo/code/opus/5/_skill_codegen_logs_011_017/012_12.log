+    quadrant: str,
+    center: tuple[float, float],
+    far: tuple[int, int],
+    growth_dir: tuple[int, int],
+) -> list[tuple[int, int]]:
+    far_d2 = _dist2_to_point(far, center)
+    candidates = []
+    blocked = {far, (far[0] + growth_dir[0], far[1] + growth_dir[1]), (far[0] + 2 * growth_dir[0], far[1] + 2 * growth_dir[1])}
+    for dr, dc in (
+        (1, 0),
+        (-1, 0),
+        (0, 1),
+        (0, -1),
+        (1, 1),
+        (-1, -1),
+    ):
+        nxt = (far[0] + dr, far[1] + dc)
