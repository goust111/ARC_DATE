+def _in_quadrant(rc: tuple[int, int], square: tuple[int, int, int, int], quadrant: str) -> bool:
+    r, c = rc
+    r0, c0, r1, c1 = square
+    if quadrant == "nw":
+        return r < r0 and c < c0
+    if quadrant == "ne":
+        return r < r0 and c > c1
+    if quadrant == "sw":
+        return r > r1 and c < c0
+    if quadrant == "se":
+        return r > r1 and c > c1
+    return False
+
