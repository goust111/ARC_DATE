+    w: int,
+    square: tuple[int, int, int, int],
+    quadrant: str,
+    target_area: int,
+    rng: random.Random,
+    *,
+    allow_far_special: bool,
+) -> set[tuple[int, int]] | None:
+    center = _square_center(square)
+    for _ in range(200):
+        base_len_max = min(5, target_area)
+        base_len_min = max(3, target_area - 3)
+        if allow_far_special:
