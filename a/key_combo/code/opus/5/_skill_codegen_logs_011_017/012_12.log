+def _winner_growth_cells(obj: dict, gap_square: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    pivot = _choose_growth_pivot(obj, gap_square)
+    dr, dc = _growth_dir(obj, pivot, gap_square)
+    pr, pc = pivot
+    return [(pr + dr, pc + dc), (pr + 2 * dr, pc + 2 * dc)]
