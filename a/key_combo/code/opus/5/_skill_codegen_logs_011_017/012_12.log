+    scored = []
+    for square in _all_bg_squares(grid, bg):
+        gap_center = _square_center(square)
+        obj_d2 = []
+        for obj in objects:
+            coords = obj["coords"]
+            d2 = min(_dist2_to_point((int(r), int(c)), gap_center) for r, c in coords)
+            obj_d2.append(d2)
