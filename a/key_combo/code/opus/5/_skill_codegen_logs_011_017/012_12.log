+            if not _in_quadrant((r, c), gap_square, quadrant):
+                return None
+        all_cells |= obj
+
+    for quadrant in QUADRANTS:
+        _paint_object(grid, objects[quadrant], colors_by_quadrant[quadrant])
+
+    if not _semantic_check(grid):
+        return None
