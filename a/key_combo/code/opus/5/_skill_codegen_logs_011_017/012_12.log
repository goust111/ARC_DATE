+def _square_center(square: tuple[int, int, int, int]) -> tuple[float, float]:
+    r0, c0, r1, c1 = square
+    return (r0 + r1) / 2.0, (c0 + c1) / 2.0
+
+
+def _dist2_to_point(rc: tuple[int, int], center: tuple[float, float]) -> float:
+    r, c = rc
+    cr, cc = center
+    return (r - cr) ** 2 + (c - cc) ** 2
+
