+    assert scored, "expected at least one 2x2 or 3x3 background square"
+    scored.sort(key=lambda item: item[:4])
+    best_key = scored[0][:4]
+    assert sum(item[:4] == best_key for item in scored) == 1, "expected a unique central gap square"
+    return scored[0][4]
