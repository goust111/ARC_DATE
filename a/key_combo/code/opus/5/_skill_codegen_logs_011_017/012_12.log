+
+def _special_far_candidates(
+    cells: set[tuple[int, int]],
+    square: tuple[int, int, int, int],
+    quadrant: str,
+    center: tuple[float, float],
+    far: tuple[int, int],
+    growth_dir: tuple[int, int],
