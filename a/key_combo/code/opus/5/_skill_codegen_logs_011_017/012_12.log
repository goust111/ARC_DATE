+def _connected8(cells: set[tuple[int, int]]) -> bool:
+    todo = [next(iter(cells))]
+    seen = {todo[0]}
+    while todo:
+        r, c = todo.pop()
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nxt = (r + dr, c + dc)
+                if nxt in cells and nxt not in seen:
+                    seen.add(nxt)
+                    todo.append(nxt)
+    return seen == cells
