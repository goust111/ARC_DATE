+def _corner_anchor(square: tuple[int, int, int, int], quadrant: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = square
+    if quadrant == "nw":
+        return r0, c0
+    if quadrant == "ne":
+        return r0, c1
+    if quadrant == "sw":
+        return r1, c0
+    if quadrant == "se":
+        return r1, c1
