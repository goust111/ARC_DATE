+
+
+def _square_cells(r0: int, c0: int, size: int) -> set[tuple[int, int]]:
+    return {(r, c) for r in range(r0, r0 + size) for c in range(c0, c0 + size)}
+
+
+def _build_pair(
+    H: int,
+    W: int,
