+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    colors: list[int] | None = None,
+    connectivity: int = 4,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    if connectivity != 4:
+        raise ValueError("this solver uses 4-connectivity only")
+
+    if colors is None:
+        colors = sorted(set(map(int, g.ravel())) - {int(bg)})
+
+    seen = np.zeros(g.shape, dtype=bool)
+    out: list[dict] = []
+    for color in colors:
+        mask = g == int(color)
+        for r0, c0 in np.argwhere(mask & (~seen)):
+            stack = [(int(r0), int(c0))]
+            coords: list[tuple[int, int]] = []
+            seen[int(r0), int(c0)] = True
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for dr, dc in STRUCT4_DIRS:
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and not seen[rr, cc] and mask[rr, cc]:
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            arr = np.array(coords, dtype=int)
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return out
