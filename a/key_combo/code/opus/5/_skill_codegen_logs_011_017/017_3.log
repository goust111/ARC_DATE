+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+ORANGE = 7
+EDGE_COLORS = {YELLOW, ORANGE}
+PAIR_COLORS = [1, 2, 3, 6, 8, 9]
+STRUCT4_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
