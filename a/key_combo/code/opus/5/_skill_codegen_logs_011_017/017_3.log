+        parts = by_color[int(color)]
+        assert len(parts) == 2
+        boxes = [_assert_solid_square(g, int(color), part) for part in parts]
+        boxes.sort(key=lambda b: (b[0], b[1]))
+        upper, lower = boxes
+        start, end, slope = _pair_geometry(upper, lower)
