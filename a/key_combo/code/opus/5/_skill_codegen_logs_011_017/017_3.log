+        ur0, uc0, ur1, uc1 = pair["upper"]
+        lr0, lc0, lr1, lc1 = pair["lower"]
+        grid[ur0 : ur1 + 1, uc0 : uc1 + 1] = int(color)
+        grid[lr0 : lr1 + 1, lc0 : lc1 + 1] = int(color)
