+        dr = 1
+        dc = 1 if slope == 1 else -1
+        line_cells = []
+        r, c = int(start[0] + dr), int(start[1] + dc)
+        while (r, c) != end:
+            assert g[r, c] == bg
+            out[r, c] = int(color)
+            assert (r, c) not in painted_line_cells
+            painted_line_cells.add((r, c))
+            line_cells.append((r, c))
