+def _region_depths(grid: np.ndarray, coords: np.ndarray) -> dict[tuple[int, int], int]:
+    h, w = grid.shape
+    wall_mask = grid == WALL
+    boundary: list[tuple[int, int]] = []
+    for r, c in coords:
+        rr, cc = int(r), int(c)
+        if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+            boundary.append((rr, cc))
+            continue
+        hit_wall = False
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and bool(wall_mask[nr, nc]):
+                    hit_wall = True
+                    break
+            if hit_wall:
+                break
+        if hit_wall:
+            boundary.append((rr, cc))
+    assert boundary
+
