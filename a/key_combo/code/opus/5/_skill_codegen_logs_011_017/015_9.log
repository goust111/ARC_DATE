+def _simulate_settling(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int).copy()
+    starts = [(int(r), int(c), int(g[r, c])) for r, c in np.argwhere((g != BG) & (g != WALL))]
+    starts.sort()
+    for r, c, _color in starts:
+        g[r, c] = BG
