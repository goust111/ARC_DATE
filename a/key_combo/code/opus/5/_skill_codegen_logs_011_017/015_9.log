+        grid,
+        top=top,
+        left_wall=inner_ws[0] + 1,
+        right_wall=w - 1,
+        style=rng.choice(["left", "right"]),
+        platform_row=platform_row,
+        colors=right_colors,
+        start_rows=start_rows,
+    )
+    return grid
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    top, regions = _find_regions(grid)
+    if len(regions) != 2:
+        return False
