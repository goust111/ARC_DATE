import numpy as np
WALL=9

def choose_side(wall,r,c):
    H,W=wall.shape
    cc=c-1
    while cc>=0 and not wall[r,cc]:
        cc-=1
    left = c-cc if cc>=0 else c+1
    cc=c+1
    while cc<W and not wall[r,cc]:
        cc+=1
    right = cc-c if cc<W else W-c
    return -1 if left<=right else 1, left==right

def drop(occ, wall, start):
    H,W=occ.shape
    r,c=start
    lat=0
    tie=False
    while True:
        while r+1<H and occ[r+1,c]==0:
            r+=1
        if r+1>=H:
            return (r,c,lat,tie)
        dl = r+1<H and c-1>=0 and occ[r+1,c-1]==0
        dr = r+1<H and c+1<W and occ[r+1,c+1]==0
        if dl "'^ dr:
            r += 1; c += -1 if dl else 1; lat += 1; continue
        if dl and dr:
            side,t = choose_side(wall,r,c); tie |= t; r += 1; c += side; lat += 1; continue
        slips=[]
        for side in (-1,1):
            nc=c+side
            if 0<=nc<W and occ[r,nc]==0 and r+1<H and occ[r+1,nc]==0:
                slips.append(side)
        if len(slips)==1:
            c += slips[0]; lat += 1; continue
        if len(slips)==2:
            side,t = choose_side(wall,r,c); tie |= t; c += side; lat += 1; continue
        return (r,c,lat,tie)

def sim(g):
    g=g.copy()
    pts=[(r,c,int(g[r,c])) for r,c in np.argwhere((g!=0)&(g!=WALL))]
    pts.sort()
    for r,c,_ in pts:
        g[r,c]=0
    wall = g==WALL
    ends=[]
    for r,c,col in pts:
        rr,cc,lat,tie=drop(g,wall,(r,c))
        g[rr,cc]=col
        ends.append(((r,c,col),(rr,cc,lat,tie)))
    return g,ends

def dist_map(g):
    H,W=g.shape
    walls=np.argwhere(g==WALL)
    out=np.zeros((H,W),int)
    for r in range(H):
        for c in range(W):
            d=min(r,c,H-1-r,W-1-c)
            for wr,wc in walls:
                d=min(d,max(abs(r-int(wr)),abs(c-int(wc))))
            out[r,c]=d
    return out

def show(g):
    print('"'\\n'.join(''.join(str(int(x)) for x in row) for row in g))

# candidate board
H,W=16,19
top=4
g=np.zeros((H,W),dtype=int)
g[top,:]=WALL
g[-1,:]=WALL
for c in [0,6,12,18]:
    g[top:,c]=WALL
# holes
for c in [2,9,15]:
