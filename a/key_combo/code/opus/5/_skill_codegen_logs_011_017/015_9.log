+    out = main(grid)
+    if out.shape != grid.shape:
+        return False
+    if np.array_equal(out, settled_grid):
+        return False
+    if not np.all(out[:top, :] != WALL):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_attempt(rng)
+        try:
+            if _semantic_checks(grid):
