        if len(slips)==1:
            c += slips[0]; lat += 1; continue
        if len(slips)==2:
            side,t=choose_side(wall,r,c); tie|=t; c += side; lat += 1; continue
        return (r,c,lat,tie)

def sim(g):
    g=g.copy(); pts=[(r,c,int(g[r,c])) for r,c in np.argwhere((g!=0)&(g!=WALL))]; pts.sort();
    for r,c,_ in pts: g[r,c]=0
    wall = g==WALL
    res=[]
    for r,c,col in pts:
        rr,cc,lat,tie=drop(g,wall,(r,c)); g[rr,cc]=col; res.append(((r,c,col),(rr,cc,lat,tie)))
    return g,res

def components(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,dtype=bool); comps=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            stack=[(r,c)]; seen[r,c]=True; pts=[]
            while stack:
                rr,cc=stack.pop(); pts.append((rr,cc))
