+def _rand_comp(n: int, total: int) -> list[int]:
+    cuts = sorted(random.sample(range(total + n - 1), n - 1))
+    parts = []
+    prev = -1
+    for cut in cuts + [total + n - 1]:
+        parts.append(cut - prev - 1)
+        prev = cut
+    return parts
+
+
+def _choose_types(n_sprites: int) -> list[str]:
