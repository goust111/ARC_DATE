+            used = set()
+            for idx in sorted(wide_indices, key=lambda i: limits[i]):
+                choices = [row for row in range(limits[idx] + 1) if row not in used]
+                if not choices:
+                    break
+                row = random.choice(choices)
+                used.add(row)
+                tops[idx] = row
+            else:
