+        return None
+    extra = width - (sum(widths) + len(types) - 1)
+    if extra < 0:
+        return None
+    slack = _rand_comp(len(types) + 1, extra)
+    intervals = []
+    c = slack[0]
+    for i, sprite_w in enumerate(widths):
+        intervals.append((c, c + sprite_w - 1))
+        c += sprite_w
+        if i < len(types) - 1:
+            c += 1 + slack[i + 1]
