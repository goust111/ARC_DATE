+
+def _rect_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    vr = max(0, max(a[0], b[0]) - min(a[2], b[2]) - 1)
+    vc = max(0, max(a[1], b[1]) - min(a[3], b[3]) - 1)
+    if vr == 0:
+        return vc
+    if vc == 0:
+        return vr
+    return max(vr, vc)
