+    else:
+        left = c1 + 2
+        if left + aw > w:
+            return positions
+        lo = max(0, r0 - ah + 2)
+        hi = min(h - ah, r1 - 1)
+        for top in range(lo, hi + 1):
+            positions.append((top, left))
+    random.shuffle(positions)
+    return positions
