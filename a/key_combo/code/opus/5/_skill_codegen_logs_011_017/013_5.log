+    "UR": ("top", "right"),
+    "LL": ("bottom", "left"),
+    "LR": ("bottom", "right"),
+}
+OTHER_ZONE_POS = {
+    "UL": ((0, 0), (0, 1), (1, 0)),
+    "UR": ((0, 1), (0, 0), (1, 1)),
