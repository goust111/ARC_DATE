+    if exit_side == "top":
+        side_mask[:r0, :] = True
+    elif exit_side == "bottom":
+        side_mask[r1 + 1 :, :] = True
+    elif exit_side == "left":
+        side_mask[:, :c0] = True
+    else:
+        side_mask[:, c1 + 1 :] = True
