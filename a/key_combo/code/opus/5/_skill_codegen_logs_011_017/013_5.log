+def _candidate_arrow_positions(
+    grid_shape: tuple[int, int],
+    wall_bbox: tuple[int, int, int, int],
+    arrow_shape: tuple[int, int],
+    placement_side: str,
+) -> list[tuple[int, int]]:
+    h, w = grid_shape
+    r0, c0, r1, c1 = wall_bbox
+    ah, aw = arrow_shape
+    positions: list[tuple[int, int]] = []
+    if placement_side == "top":
+        top = r0 - ah - 1
+        if top < 0:
+            return positions
+        lo = max(0, c0 - aw + 2)
+        hi = min(w - aw, c1 - 1)
+        for left in range(lo, hi + 1):
+            positions.append((top, left))
+    elif placement_side == "bottom":
+        top = r1 + 2
+        if top + ah > h:
+            return positions
+        lo = max(0, c0 - aw + 2)
+        hi = min(w - aw, c1 - 1)
+        for left in range(lo, hi + 1):
+            positions.append((top, left))
+    elif placement_side == "left":
+        left = c0 - aw - 1
+        if left < 0:
+            return positions
+        lo = max(0, r0 - ah + 2)
+        hi = min(h - ah, r1 - 1)
+        for top in range(lo, hi + 1):
+            positions.append((top, left))
+    else:
+        left = c1 + 2
+        if left + aw > w:
+            return positions
+        lo = max(0, r0 - ah + 2)
+        hi = min(h - ah, r1 - 1)
+        for top in range(lo, hi + 1):
+            positions.append((top, left))
+    random.shuffle(positions)
+    return positions
