+def _fill_from_wall(
+    grid: np.ndarray,
+    walls: list[dict],
+    wall_idx: int,
+    exit_side: str,
+) -> np.ndarray:
+    wall = walls[wall_idx]
+    assert exit_side in wall["openings"]
+    passable = grid == BG
+    sr, sc = wall["seed"]
+    passable[sr, sc] = True
