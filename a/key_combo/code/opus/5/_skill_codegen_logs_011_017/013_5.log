+def _sqdist(a: np.ndarray, b: np.ndarray) -> int:
+    dr = a[:, None, 0] - b[None, :, 0]
+    dc = a[:, None, 1] - b[None, :, 1]
+    return int(np.min(dr * dr + dc * dc))
