+        lo = max(0, c0 - aw + 2)
+        hi = min(w - aw, c1 - 1)
+        for left in range(lo, hi + 1):
+            positions.append((top, left))
+    elif placement_side == "left":
+        left = c0 - aw - 1
+        if left < 0:
+            return positions
+        lo = max(0, r0 - ah + 2)
+        hi = min(h - ah, r1 - 1)
+        for top in range(lo, hi + 1):
