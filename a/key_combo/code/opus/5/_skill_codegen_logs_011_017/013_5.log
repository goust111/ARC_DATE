+            )
+        elif area == 1:
+            r, c = map(int, comp["coords"][0])
+            seeds.append({"pos": (r, c), "color": color})
+
+    assert 2 <= len(seeds) <= 3
+    assert len(arrows) == len(seeds)
+    assert len(grey_comps) >= len(seeds)
+    walls: list[dict] = []
