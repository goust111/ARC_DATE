+
+        coords = np.vstack([grey_comps[idx]["coords"] for idx in member_idxs])
+        r0 = int(coords[:, 0].min())
+        c0 = int(coords[:, 1].min())
+        r1 = int(coords[:, 0].max())
+        c1 = int(coords[:, 1].max())
+        temp = np.zeros_like(grid)
+        temp[coords[:, 0], coords[:, 1]] = WALL
+        openings = _openings_from_seed_region(temp, (r0, c0, r1, c1), seed["pos"])
+        assert len(openings) == 2
+        walls.append(
+            {
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "seed": seed["pos"],
+                "openings": openings,
+            }
+        )
