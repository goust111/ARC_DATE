+def _fill_from_wall(
+    grid: np.ndarray,
+    walls: list[dict],
+    wall_idx: int,
+    exit_side: str,
+) -> np.ndarray:
+    wall = walls[wall_idx]
+    assert exit_side in wall["openings"]
+    passable = grid == BG
+    sr, sc = wall["seed"]
+    passable[sr, sc] = True
+
+    for idx, other in enumerate(walls):
+        for side, cells in other["openings"].items():
+            if idx == wall_idx and side == exit_side:
+                continue
+            for r, c in cells:
+                passable[r, c] = False
