+    for arrow in arrows:
+        distances = [_sqdist(arrow["coords"], wall["coords"]) for wall in walls]
+        best = min(distances)
+        assert distances.count(best) == 1
+        arrow["wall_idx"] = distances.index(best)
+
+    paired = [arrow["wall_idx"] for arrow in arrows]
+    assert sorted(paired) == list(range(len(walls)))
+    return walls, arrows
+
+
+def _fill_from_wall(
+    grid: np.ndarray,
+    walls: list[dict],
+    wall_idx: int,
+    exit_side: str,
+) -> np.ndarray:
+    wall = walls[wall_idx]
+    assert exit_side in wall["openings"]
+    passable = grid == BG
+    sr, sc = wall["seed"]
+    passable[sr, sc] = True
+
+    for idx, other in enumerate(walls):
+        for side, cells in other["openings"].items():
+            if idx == wall_idx and side == exit_side:
+                continue
+            for r, c in cells:
+                passable[r, c] = False
+
+    seen = np.zeros_like(grid, dtype=bool)
+    stack = [wall["seed"]]
+    seen[sr, sc] = True
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return seen
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each seeded enclosure and let it flood outward only through the arrow-selected opening.
+
+    Input structure:
+    - Black background contains 2 or 3 grey wall components, each a small rectangular frame with multiple border gaps.
+    - Every wall encloses exactly one single-pixel seed, and every nearby colored 6-pixel arrow sprite has a 4-cell shaft plus an offset 3-cell crossbar.
+    - Arrow colors differ from the grey walls and act as the eventual fill colors.
+
+    Rule:
+    - Decode each arrow direction from which end of its shaft the crossbar is closer to.
+    - Pair each arrow with the unique nearest grey wall component.
+    - For that wall, keep only the opening on the side matching the arrow direction; treat all other wall openings as temporarily blocked.
+    - Starting from the enclosed seed, 4-neighbor flood through background cells and recolor the reached region, including the seed, with the arrow color.
+    - Keep walls and arrows unchanged.
+
+    Key insight:
+    The wall geometry alone is ambiguous because each enclosure has several exits; the arrow's internal geometry selects the one usable opening, while its color supplies the paint.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert int(get_bg(g)) == BG
+
+    walls, arrows = _parse_scene(g)
+    out = g.copy()
+    painted = np.zeros_like(g, dtype=bool)
+
+    for arrow in arrows:
+        wall_idx = int(arrow["wall_idx"])
+        exit_side = DIR_TO_SIDE[arrow["direction"]]
+        fill_mask = _fill_from_wall(g, walls, wall_idx, exit_side)
+        assert not np.any(painted & fill_mask)
+        out[fill_mask] = int(arrow["color"])
+        painted |= fill_mask
+
+    return out
+
+
+def _zone_origin(zone: str, shape: tuple[int, int], size: int) -> tuple[int, int] | None:
+    h, w = shape
+    ranges = {
+        "UL": ((3, 5), (3, 5)),
+        "UR": ((3, 5), (w - size - 5, w - size - 3)),
+        "LL": ((h - size - 5, h - size - 3), (3, 5)),
+        "LR": ((h - size - 5, h - size - 3), (w - size - 5, w - size - 3)),
+    }
+    (rlo, rhi), (clo, chi) = ranges[zone]
+    if rlo > rhi or clo > chi:
+        return None
+    return random.randint(rlo, rhi), random.randint(clo, chi)
+
+
+def _seed_pos(size: int) -> tuple[int, int]:
+    return random.randint(2, size - 3), random.randint(2, size - 3)
+
+
+def _carve_l_corridor(patch: np.ndarray, side: str) -> None:
+    size = patch.shape[0]
+    if side == "top":
+        start_c = random.randint(2, size - 3)
+        end_c = random.randint(1, size - 2)
+        patch[2, min(start_c, end_c) : max(start_c, end_c) + 1] = BG
+        patch[0:3, end_c] = BG
+    elif side == "bottom":
+        start_c = random.randint(2, size - 3)
+        end_c = random.randint(1, size - 2)
+        patch[size - 3, min(start_c, end_c) : max(start_c, end_c) + 1] = BG
+        patch[size - 3 : size, end_c] = BG
+    elif side == "left":
+        start_r = random.randint(2, size - 3)
+        end_r = random.randint(1, size - 2)
+        patch[min(start_r, end_r) : max(start_r, end_r) + 1, 2] = BG
+        patch[end_r, 0:3] = BG
+    else:
+        start_r = random.randint(2, size - 3)
+        end_r = random.randint(1, size - 2)
+        patch[min(start_r, end_r) : max(start_r, end_r) + 1, size - 3] = BG
+        patch[end_r, size - 3 : size] = BG
+
+
+def _make_wall_patch(size: int, side_a: str, side_b: str) -> tuple[np.ndarray, tuple[int, int]] | None:
+    for _ in range(100):
+        patch = np.full((size, size), WALL, dtype=int)
+        patch[2 : size - 2, 2 : size - 2] = BG
+        _carve_l_corridor(patch, side_a)
+        _carve_l_corridor(patch, side_b)
+        seed_local = _seed_pos(size)
+        if int(patch[seed_local]) != BG:
+            continue
+        comps = find_components(
+            patch, bg=BG, connectivity=4, monochromatic=True, return_format="dict"
+        )
+        wall_comps = [comp for comp in comps if int(comp["color"]) == WALL]
+        if len(wall_comps) != 1:
+            continue
+        openings = _openings_from_seed_region(
+            np.where(patch == WALL, WALL, BG), (0, 0, size - 1, size - 1), seed_local
+        )
+        if set(openings) == {side_a, side_b}:
+            return patch, seed_local
+    return None
+
+
+def _candidate_arrow_positions(
+    grid_shape: tuple[int, int],
+    wall_bbox: tuple[int, int, int, int],
+    arrow_shape: tuple[int, int],
+    placement_side: str,
+) -> list[tuple[int, int]]:
+    h, w = grid_shape
+    r0, c0, r1, c1 = wall_bbox
+    ah, aw = arrow_shape
+    positions: list[tuple[int, int]] = []
+    if placement_side == "top":
+        top = r0 - ah - 1
+        if top < 0:
+            return positions
+        lo = max(0, c0 - aw + 2)
+        hi = min(w - aw, c1 - 1)
+        for left in range(lo, hi + 1):
+            positions.append((top, left))
+    elif placement_side == "bottom":
+        top = r1 + 2
+        if top + ah > h:
+            return positions
+        lo = max(0, c0 - aw + 2)
+        hi = min(w - aw, c1 - 1)
+        for left in range(lo, hi + 1):
+            positions.append((top, left))
+    elif placement_side == "left":
+        left = c0 - aw - 1
+        if left < 0:
+            return positions
+        lo = max(0, r0 - ah + 2)
+        hi = min(h - ah, r1 - 1)
+        for top in range(lo, hi + 1):
+            positions.append((top, left))
+    else:
+        left = c1 + 2
+        if left + aw > w:
+            return positions
+        lo = max(0, r0 - ah + 2)
+        hi = min(h - ah, r1 - 1)
+        for top in range(lo, hi + 1):
