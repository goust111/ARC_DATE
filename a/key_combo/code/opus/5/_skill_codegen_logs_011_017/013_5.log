+def _wall_patch(size: int, openings: dict[str, int]) -> np.ndarray:
+    patch = np.zeros((size, size), dtype=int)
+    patch[0:2, :] = WALL
+    patch[-2:, :] = WALL
+    patch[:, 0:2] = WALL
+    patch[:, -2:] = WALL
+    for side, offset in openings.items():
+        if side == "top":
+            patch[0, offset] = BG
+            patch[1, offset] = BG
+        elif side == "bottom":
+            patch[-1, offset] = BG
+            patch[-2, offset] = BG
+        elif side == "left":
+            patch[offset, 0] = BG
+            patch[offset, 1] = BG
+        elif side == "right":
+            patch[offset, -1] = BG
+            patch[offset, -2] = BG
