+    assert exit_side in wall["openings"]
+    r0, c0, r1, c1 = wall["bbox"]
+    inside_bbox = np.zeros_like(grid, dtype=bool)
+    inside_bbox[r0 : r1 + 1, c0 : c1 + 1] = True
