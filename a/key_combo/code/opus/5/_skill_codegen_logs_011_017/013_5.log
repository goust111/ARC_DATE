+            grey_comps.append({"coords": comp["coords"], "bbox": tuple(map(int, comp["bbox"]))})
+        elif area == 6:
+            arrows.append(
+                {
+                    "coords": comp["coords"],
+                    "bbox": tuple(map(int, comp["bbox"])),
+                    "color": color,
