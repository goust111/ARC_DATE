+    neighbors4 = _ARC_UTILS.neighbors4
+
+
+BG = 0
+WALL = 5
+SEED = 9
+ARROW_COLORS = (1, 2, 3)
+SIDES = ("top", "right", "bottom", "left")
+DIR_TO_SIDE = {(-1, 0): "top", (0, 1): "right", (1, 0): "bottom", (0, -1): "left"}
+SIDE_TO_DIR = {v: k for k, v in DIR_TO_SIDE.items()}
+OUTWARD_BY_ZONE = {
+    "UL": ("top", "left"),
+    "UR": ("top", "right"),
+    "LL": ("bottom", "left"),
+    "LR": ("bottom", "right"),
+}
+OTHER_ZONE_POS = {
+    "UL": ((0, 0), (0, 1), (1, 0)),
+    "UR": ((0, 1), (0, 0), (1, 1)),
+    "LL": ((1, 0), (0, 0), (1, 1)),
+    "LR": ((1, 1), (0, 1), (1, 0)),
+}
+GEN_RETRIES = 400
