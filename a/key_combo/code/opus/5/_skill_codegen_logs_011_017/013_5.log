+    for side, offset in openings.items():
+        if side == "top":
+            patch[0:3, offset] = BG
+        elif side == "bottom":
+            patch[size - 3 : size, offset] = BG
+        elif side == "left":
+            patch[offset, 0:3] = BG
+        elif side == "right":
+            patch[offset, size - 3 : size] = BG
+    return patch
+
