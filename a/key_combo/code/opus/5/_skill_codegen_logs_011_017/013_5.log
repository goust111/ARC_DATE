+GEN_RETRIES = 400
+
+
+def _arrow_patch(direction: tuple[int, int], color: int) -> np.ndarray:
+    if direction == (-1, 0):
+        arr = np.zeros((4, 3), dtype=int)
+        arr[:, 1] = color
+        arr[1, :] = color
+        return arr
+    if direction == (1, 0):
+        arr = np.zeros((4, 3), dtype=int)
+        arr[:, 1] = color
+        arr[2, :] = color
+        return arr
+    if direction == (0, -1):
+        arr = np.zeros((3, 4), dtype=int)
+        arr[1, :] = color
+        arr[:, 1] = color
+        return arr
+    if direction == (0, 1):
+        arr = np.zeros((3, 4), dtype=int)
+        arr[1, :] = color
+        arr[:, 2] = color
+        return arr
+    raise ValueError(direction)
+
+
+def _extract_wall_openings(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> dict[str, list[tuple[int, int]]]:
+    r0, c0, r1, c1 = bbox
+    openings: dict[str, list[tuple[int, int]]] = {}
+    top = [(r0, c) for c in range(c0 + 1, c1) if int(grid[r0, c]) != WALL]
+    right = [(r, c1) for r in range(r0 + 1, r1) if int(grid[r, c1]) != WALL]
+    bottom = [(r1, c) for c in range(c0 + 1, c1) if int(grid[r1, c]) != WALL]
+    left = [(r, c0) for r in range(r0 + 1, r1) if int(grid[r, c0]) != WALL]
+    if top:
+        openings["top"] = top
+    if right:
+        openings["right"] = right
+    if bottom:
+        openings["bottom"] = bottom
+    if left:
+        openings["left"] = left
+    return openings
+
+
+def _decode_arrow_direction(comp: dict) -> tuple[int, int]:
+    coords = comp["coords"]
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    local = coords - np.array([[r0, c0]], dtype=int)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if (h, w) == (4, 3):
+        row_counts = [int(np.sum(local[:, 0] == rr)) for rr in range(4)]
+        col_counts = [int(np.sum(local[:, 1] == cc)) for cc in range(3)]
+        cross_rows = [rr for rr, cnt in enumerate(row_counts) if cnt == 3]
+        assert col_counts == [1, 4, 1]
+        assert len(cross_rows) == 1 and cross_rows[0] in (1, 2)
+        return (-1, 0) if cross_rows[0] == 1 else (1, 0)
+    if (h, w) == (3, 4):
+        row_counts = [int(np.sum(local[:, 0] == rr)) for rr in range(3)]
+        col_counts = [int(np.sum(local[:, 1] == cc)) for cc in range(4)]
+        cross_cols = [cc for cc, cnt in enumerate(col_counts) if cnt == 3]
+        assert row_counts == [1, 4, 1]
+        assert len(cross_cols) == 1 and cross_cols[0] in (1, 2)
+        return (0, -1) if cross_cols[0] == 1 else (0, 1)
+    raise AssertionError(f"unexpected arrow bbox: {(h, w)}")
+
+
+def _sqdist(a: np.ndarray, b: np.ndarray) -> int:
+    dr = a[:, None, 0] - b[None, :, 0]
+    dc = a[:, None, 1] - b[None, :, 1]
+    return int(np.min(dr * dr + dc * dc))
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    comps = find_components(grid, bg=BG, connectivity=4, monochromatic=True, return_format="dict")
+    walls: list[dict] = []
+    arrows: list[dict] = []
+    seeds: list[dict] = []
+    for comp in comps:
+        color = int(comp["color"])
+        area = int(comp["area"])
+        if color == WALL:
+            walls.append(
+                {
+                    "coords": comp["coords"],
+                    "bbox": tuple(map(int, comp["bbox"])),
+                    "openings": _extract_wall_openings(grid, tuple(map(int, comp["bbox"]))),
+                }
+            )
+        elif area == 6:
+            arrows.append(
+                {
+                    "coords": comp["coords"],
+                    "bbox": tuple(map(int, comp["bbox"])),
+                    "color": color,
+                    "direction": _decode_arrow_direction(comp),
+                }
+            )
+        elif area == 1:
+            r, c = map(int, comp["coords"][0])
+            seeds.append({"pos": (r, c), "color": color})
+
+    assert 2 <= len(walls) <= 3
+    assert len(arrows) == len(walls)
+    assert len(seeds) == len(walls)
+    for wall in walls:
+        assert len(wall["openings"]) >= 2
+
+    used_walls: set[int] = set()
+    for seed in seeds:
+        matches = []
+        r, c = seed["pos"]
+        for idx, wall in enumerate(walls):
+            r0, c0, r1, c1 = wall["bbox"]
+            if r0 < r < r1 and c0 < c < c1:
+                matches.append(idx)
+        assert len(matches) == 1
+        idx = matches[0]
+        assert idx not in used_walls
+        walls[idx]["seed"] = seed["pos"]
+        used_walls.add(idx)
+
+    for arrow in arrows:
+        distances = [_sqdist(arrow["coords"], wall["coords"]) for wall in walls]
+        best = min(distances)
+        assert distances.count(best) == 1
+        arrow["wall_idx"] = distances.index(best)
+
+    paired = [arrow["wall_idx"] for arrow in arrows]
+    assert sorted(paired) == list(range(len(walls)))
+    return walls, arrows
+
+
+def _fill_from_wall(
+    grid: np.ndarray,
+    walls: list[dict],
+    wall_idx: int,
+    exit_side: str,
+) -> np.ndarray:
+    wall = walls[wall_idx]
+    assert exit_side in wall["openings"]
+    passable = grid == BG
+    sr, sc = wall["seed"]
+    passable[sr, sc] = True
+
+    for idx, other in enumerate(walls):
+        for side, cells in other["openings"].items():
+            if idx == wall_idx and side == exit_side:
+                continue
+            for r, c in cells:
