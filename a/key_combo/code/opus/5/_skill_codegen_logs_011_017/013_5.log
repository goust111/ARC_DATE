+def _arrow_patch(direction: tuple[int, int], color: int) -> np.ndarray:
+    if direction == (-1, 0):
+        arr = np.zeros((4, 3), dtype=int)
+        arr[:, 1] = color
+        arr[1, :] = color
+        return arr
+    if direction == (1, 0):
+        arr = np.zeros((4, 3), dtype=int)
+        arr[:, 1] = color
+        arr[2, :] = color
+        return arr
+    if direction == (0, -1):
+        arr = np.zeros((3, 4), dtype=int)
+        arr[1, :] = color
+        arr[:, 1] = color
+        return arr
+    if direction == (0, 1):
+        arr = np.zeros((3, 4), dtype=int)
+        arr[1, :] = color
+        arr[:, 2] = color
+        return arr
+    raise ValueError(direction)
