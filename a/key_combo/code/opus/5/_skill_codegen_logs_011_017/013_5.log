+    if out.shape != grid.shape:
+        return False
+
+    for arrow in arrows:
+        color = int(arrow["color"])
+        idx = int(arrow["wall_idx"])
+        fill_mask = fill_masks[idx]
+        if not np.all(out[fill_mask] == color):
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        case = _build_case()
+        if case is None:
