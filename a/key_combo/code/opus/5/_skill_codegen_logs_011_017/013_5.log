+        exit_side = DIR_TO_SIDE[arrow["direction"]]
+        fill_mask = _fill_from_wall(g, walls, wall_idx, exit_side)
+        assert not np.any(painted & fill_mask)
+        out[fill_mask] = int(arrow["color"])
+        painted |= fill_mask
