+                rects.pop()
+                chosen.pop(off)
+            return False
+
+        if backtrack(0):
+            return anchor, chosen
+    return None
+
+
+def validate_generated(grid: np.ndarray) -> None:
+    details = solve_details(grid)
+    out = details["output"]
+    point_infos = details["point_infos"]
+    template_patch = details["template_patch"]
+    cover = details["cover"]
