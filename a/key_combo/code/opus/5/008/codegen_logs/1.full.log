+def random_connected_cells(rows: int, cols: int, n: int) -> list[tuple[int, int]] | None:
+    start = (random.randrange(rows), random.randrange(cols))
+    cells = {start}
+    frontier = set()
+    for nr, nc in neighbors4(*start):
+        if 0 <= nr < rows and 0 <= nc < cols:
+            frontier.add((nr, nc))
