+    assert np.any(out == BLUE), "non-origin copies must remain visible"
+    assert np.any(out == YELLOW), "overlap recolor must be visible"
+    assert np.sum(out == YELLOW) <= np.sum(out != BG) // 2, "overlap should stay a minority"
