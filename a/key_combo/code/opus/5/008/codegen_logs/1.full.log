+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
