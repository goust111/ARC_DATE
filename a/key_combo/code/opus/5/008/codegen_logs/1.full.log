+        dr = int(info["point"][0] - origin[0])
+        dc = int(info["point"][1] - origin[1])
+        assert dr % templ_h == 0 and dc % templ_w == 0, "layout must use template bbox spacing"
+        info["delta"] = (int(dr // templ_h), int(dc // templ_w))
