+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+# Missing-corner encoding for clockwise quarter turns.
+ROT_TO_MISSING = {
+    0: (1, 1),  # upper-left missing
+    1: (1, 3),  # upper-right missing
+    2: (3, 3),  # lower-right missing
+    3: (3, 1),  # lower-left missing
