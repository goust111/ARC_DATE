+def _ray_trace(grid: np.ndarray, center: Coord, direction: Coord) -> tuple[list[tuple[int, int, int]], str]:
+    h, w = map(int, grid.shape)
+    r, c = center
+    dr, dc = direction
+    rr, cc = int(r + dr), int(c + dc)
