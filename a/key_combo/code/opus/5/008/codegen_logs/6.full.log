+    if not chosen:
+        return None
+
+    pool = candidates[:]
+    random.shuffle(pool)
+    for candidate in pool:
+        if len(chosen) >= n_obstacles:
+            break
+        if candidate in chosen:
+            continue
+        if not _obstacles_compatible(candidate, chosen):
