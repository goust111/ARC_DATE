+    control_label = _row_letter(v_edge) + _col_letter(h_edge)
+    vanish_label = _opposite_row(control_label[0]) + _opposite_col(control_label[1])
+    keep_labels = [lab for lab in ("TL", "TR", "BL", "BR") if lab != vanish_label]
