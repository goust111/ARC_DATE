+        best_d = min(abs(r - center[0]) + abs(c - center[1]) for r, c in frontier)
+        candidates = [pt for pt in frontier if abs(pt[0] - center[0]) + abs(pt[1] - center[1]) <= best_d + 1]
+        seed_r0 = min(r for r, _ in region)
+        seed_c0 = min(c for _, c in region)
+        seed_r1 = max(r for r, _ in region)
+        seed_c1 = max(c for _, c in region)
