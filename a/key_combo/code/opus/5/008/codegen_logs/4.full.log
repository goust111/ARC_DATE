+def _grow_region(shape: tuple[int, int], allowed: set[tuple[int, int]], seed: tuple[int, int],
+                 count: int, occupied: set[tuple[int, int]], center: tuple[int, int]):
+    if seed not in allowed or seed in occupied:
+        return None
+    region = {seed}
+    while len(region) < count:
+        frontier = set()
+        for r, c in region:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in allowed and (nr, nc) not in occupied and (nr, nc) not in region:
+                    frontier.add((nr, nc))
+        if not frontier:
+            return None
