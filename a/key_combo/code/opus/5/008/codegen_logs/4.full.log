+        while q:
+            cr, cc = q.popleft()
+            comp.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
