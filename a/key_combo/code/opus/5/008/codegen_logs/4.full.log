+def _component_coords(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            comp.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+    if not coords:
+        return False
+    r0, c0, r1, c1 = _bbox(coords)
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    hh, ww = sub.shape
+    padded = np.zeros((hh + 2, ww + 2), dtype=bool)
+    padded[1:-1, 1:-1] = ~sub
+    seen = np.zeros_like(padded, dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(padded.shape, nr, nc) and padded[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
