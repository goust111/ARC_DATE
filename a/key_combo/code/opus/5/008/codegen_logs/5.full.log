+
+def _ordered_neighbors(cur: Coord, goal_hint: Coord) -> list[Coord]:
+    out = list(neighbors4(cur[0], cur[1]))
+    out.sort(key=lambda p: (abs(p[0] - goal_hint[0]) + abs(p[1] - goal_hint[1]), p[0], p[1]))
+    return out
