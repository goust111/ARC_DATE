+    colors, color_to_comps = _ordered_components(inp)
+    if len(colors) not in (2, 3):
+        return False
+    for color in colors:
+        comps = color_to_comps[color]
+        if not (2 <= len(comps) <= 3):
+            return False
+        if any(not (2 <= len(comp) <= 5) for comp in comps):
+            return False
