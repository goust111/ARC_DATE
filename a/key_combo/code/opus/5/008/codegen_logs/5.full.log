+    if mode == "identity":
+        return g.copy()
+    if mode == "mirror":
+        return g[:, ::-1].copy()
+    if mode == "transpose":
+        return g.T.copy()
+    if mode == "transpose_mirror":
+        return g.T[:, ::-1].copy()
+    raise ValueError(mode)
