+    except AssertionError:
+        order_matters = True
+    if not order_matters:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for seed in range(800):
+        rng = random.Random(random.randrange(1 << 30) ^ (seed * 1315423911))
+        grid = _build_canonical_input(rng)
+        if grid is None:
