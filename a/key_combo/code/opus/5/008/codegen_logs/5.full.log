+    cell_set = set(cells)
+    for r, c in cell_set:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(grid[r, c]) != BG:
+            return False
+    for r, c in cell_set:
+        for nr, nc in neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in cell_set:
+                continue
+            if int(grid[nr, nc]) != BG:
