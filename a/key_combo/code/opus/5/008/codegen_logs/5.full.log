+            (h - 7, h - 5),
+            (wall_col + 2, min(w - 8, wall_col + 5)),
+        ) is None:
+            return None
+        if _place_component_in_box(
+            grid,
+            rng,
+            color_c,
+            (h - 5, h - 3),
+            (w - 7, w - 4),
+        ) is None:
+            return None
+        if rng.random() < 0.5:
+            if _place_component_in_box(
+                grid,
+                rng,
