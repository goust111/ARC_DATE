+
+def _gapped_wall_cells(
+    orientation: str,
+    start: Coord,
+    len_a: int,
+    len_b: int,
+) -> tuple[list[Coord], Coord]:
+    r0, c0 = start
+    cells: list[Coord] = []
+    if orientation == "v":
+        for rr in range(r0, r0 + len_a):
+            cells.append((rr, c0))
+        gap = (r0 + len_a, c0)
+        for rr in range(r0 + len_a + 1, r0 + len_a + 1 + len_b):
+            cells.append((rr, c0))
+        return cells, gap
+    for cc in range(c0, c0 + len_a):
+        cells.append((r0, cc))
+    gap = (r0, c0 + len_a)
+    for cc in range(c0 + len_a + 1, c0 + len_a + 1 + len_b):
+        cells.append((r0, cc))
+    return cells, gap
+
+
+def _can_place_wall(grid: np.ndarray, cells: list[Coord]) -> bool:
+    h, w = grid.shape
+    cell_set = set(cells)
+    for r, c in cell_set:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(grid[r, c]) != BG:
+            return False
+    return True
+
+
+def _paint_wall(grid: np.ndarray, cells: list[Coord]) -> bool:
+    if not _can_place_wall(grid, cells):
+        return False
+    for r, c in cells:
+        grid[r, c] = WALL
+    return True
