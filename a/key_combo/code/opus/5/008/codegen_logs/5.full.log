+                    gap = path[idx]
+                    orientation = gaps.get(gap)
+                    if orientation is None:
+                        continue
+                    prev_pt = path[idx - 1]
+                    next_pt = path[idx + 1]
+                    if orientation == "v":
+                        if not (prev_pt[0] == gap[0] == next_pt[0] and prev_pt[1] != next_pt[1]):
+                            continue
+                        forward = (0, 1 if next_pt[1] > gap[1] else -1)
+                    else:
+                        if not (prev_pt[1] == gap[1] == next_pt[1] and prev_pt[0] != next_pt[0]):
+                            continue
