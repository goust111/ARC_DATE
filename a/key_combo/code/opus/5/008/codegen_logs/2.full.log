  "type": "move_to_match",
  "src": "two-tone sprite s (outer color + inner color)",
  "dst": "dock into horizontal bar sprite d (fill + border)",
  "match_cond": "s.outer_color == d.fill_color",
  "transform": "place at same x near bottom of d; swap: s.outer→d.border, s.inner→d.fill"
}
</annotation>
</reference_puzzle>

