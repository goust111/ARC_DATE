+def _shape_sig(cells: set[tuple[int, int]] | list[tuple[int, int]] | np.ndarray) -> tuple[tuple[int, int], ...]:
+    if isinstance(cells, np.ndarray):
+        pts = [(int(r), int(c)) for r, c in cells]
+    else:
+        pts = [(int(r), int(c)) for r, c in cells]
