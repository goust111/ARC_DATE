+                left_lo, left_hi = chain["root_bbox"][3] + 4, w - pw - 2
+                if top_hi < top_lo or left_hi < left_lo:
+                    continue
+                top = rng.randint(top_lo, top_hi)
+                left = rng.randint(left_lo, left_hi)
