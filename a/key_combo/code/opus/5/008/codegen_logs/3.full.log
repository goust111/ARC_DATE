+        edge = min(r for r, _ in sig)
+        return tuple(sorted(c for r, c in sig if r == edge))
+    if direction == "down":
+        edge = max(r for r, _ in sig)
+        return tuple(sorted(c for r, c in sig if r == edge))
+    if direction == "left":
+        edge = min(c for _, c in sig)
+        return tuple(sorted(r for r, c in sig if c == edge))
