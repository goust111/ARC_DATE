+            seg = _segment_to_marker(marker, root["direction"], front_coord, root["strip"])
+            current |= seg
+            segments.append(seg)
+        chain_info.append(
+            {
+                "color": color,
+                "direction": root["direction"],
+                "strip": root["strip"],
