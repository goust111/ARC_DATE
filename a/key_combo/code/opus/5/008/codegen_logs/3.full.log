+def _connected(cells: set[tuple[int, int]] | list[tuple[int, int]]) -> bool:
+    pts = set(cells)
+    if not pts:
+        return False
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in D4:
+            nb = (r + dr, c + dc)
