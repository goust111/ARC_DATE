+            inp[r, c] = int(chain["color"])
+
+    expected = _render_expected(h, w, bar_cells, chains)
+    _validate_semantics(inp, expected, chains)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        rng = random.Random()
+        grid = _gen_attempt(rng)
+        if grid is not None:
