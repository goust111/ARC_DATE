 336:         # Choose an obstacle pixel so that the translated endpoint (p_near + offset) lies OUTSIDE the obstacle,
 337:         # i.e. the segment connects to the obstacle "skin" rather than landing inside the obstacle and wasting length.
 338:         def pick_p_near() -> tuple[int, int]:
