+    assert max(expected.shape) <= 30
+    assert max(inp.shape) <= 30
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(18, 25)
+    w = rng.randint(22, 28)
