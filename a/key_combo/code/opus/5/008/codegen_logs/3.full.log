+
+def _can_place(cells: set[tuple[int, int]], occupied: set[tuple[int, int]], h: int, w: int, gap: bool = True) -> bool:
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied:
+            return False
+        if gap:
+            for dr, dc in D4:
+                if (r + dr, c + dc) in occupied:
+                    return False
+    return True
+
+
+def _place_sprites(
+    rng: random.Random,
+    h: int,
+    w: int,
+    bar_cells: set[tuple[int, int]],
+    marker_cells: set[tuple[int, int]],
+    chains: list[dict],
+) -> list[dict] | None:
+    occupied = set(bar_cells) | set(marker_cells)
+    placed: list[dict] = []
+    for chain in rng.sample(chains, len(chains)):
+        shape = chain["shape"]
+        sig = shape.cells
+        ph, pw = shape.h, shape.w
+        placed_ok = False
+        for _ in range(250):
+            zone = rng.choice(["top", "bottom", "left", "right"])
+            if zone == "top":
+                top = rng.randint(1, max(1, min(h - ph - 1, chain["root_bbox"][0] - 4)))
+                left = rng.randint(1, w - pw - 2)
+            elif zone == "bottom":
+                top = rng.randint(max(1, chain["root_bbox"][2] + 4), h - ph - 2)
+                left = rng.randint(1, w - pw - 2)
+            elif zone == "left":
+                top = rng.randint(1, h - ph - 2)
+                left = rng.randint(1, max(1, chain["root_bbox"][1] - pw - 4))
+            else:
+                top = rng.randint(1, h - ph - 2)
+                left = rng.randint(max(1, chain["root_bbox"][3] + 4), w - pw - 2)
+            cells = _translate(sig, top, left)
+            if not _can_place(cells, occupied, h, w, gap=True):
+                continue
+            occupied |= cells
+            placed.append({"color": chain["color"], "cells": cells})
+            placed_ok = True
+            break
