+        lanes = tuple(sorted(c for r, c in cells if r == coord))
+        return coord, lanes
+    if direction == "down":
+        coord = max(r for r, _ in cells)
+        lanes = tuple(sorted(c for r, c in cells if r == coord))
+        return coord, lanes
+    if direction == "left":
+        coord = min(c for _, c in cells)
+        lanes = tuple(sorted(r for r, c in cells if c == coord))
