+def _can_place(cells: set[tuple[int, int]], occupied: set[tuple[int, int]], h: int, w: int, gap: bool = True) -> bool:
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if (r, c) in occupied:
+            return False
+        if gap:
+            for dr, dc in D4:
+                if (r + dr, c + dc) in occupied:
+                    return False
+    return True
+
