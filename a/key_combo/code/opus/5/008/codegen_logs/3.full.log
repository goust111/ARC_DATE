+            zone = rng.choice(["top", "bottom", "left", "right"])
+            if zone == "top":
+                top_hi = min(h - ph - 2, chain["root_bbox"][0] - 4)
+                left_lo, left_hi = 1, w - pw - 2
+                if top_hi < 1 or left_hi < left_lo:
+                    continue
