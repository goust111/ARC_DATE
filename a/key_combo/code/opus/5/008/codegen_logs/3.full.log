+        assert not (touches_top and touches_bottom), "notch cannot touch both bar sides"
+        side = "top" if touches_top else "bottom"
+        hole = {(br0 + int(r), bc0 + int(c)) for r, c in pts}
+        sig = _shape_sig(pts)
+        hr0, hc0, hr1, hc1 = _bbox_of_cells(hole)
+        notches.append(
