+        if first_col <= 0:
+            return None
+        markers_reachable.append((first_row, first_col))
+        current = first_col
+        for _ in range(count - 1):
+            gap = rng.randint(2, 4)
+            col = current - gap
+            if col < 1:
+                break
+            row = rng.choice(full_rows)
+            markers_reachable.append((row, col))
+            current = col
