+        r0, c0, r1, c1 = notch["bbox"]
+        if direction in ("up", "down"):
+            strip = (c0, c1)
+        else:
+            strip = (r0, r1)
+        roots.append(
+            {
+                "color": int(sprite["color"]),
+                "direction": direction,
+                "root_cells": set(notch["cells"]),
+                "root_bbox": (r0, c0, r1, c1),
+                "strip": strip,
+                "sprite_sig": sprite["sig"],
+            }
+        )
