+    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
+    sprites: list[dict] = []
+    markers_by_color: dict[int, set[tuple[int, int]]] = {}
+    for comp in comps:
+        color = int(comp["color"])
+        if color == BAR:
+            continue
+        area = int(comp["area"])
+        cells = {(int(r), int(c)) for r, c in comp["coords"]}
+        if area == 1:
