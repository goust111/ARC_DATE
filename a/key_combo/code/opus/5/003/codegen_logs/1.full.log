+    param_for_kind = {"h": layout["h"], "v": layout["v"], "d": layout["d"], "a": layout["a"]}
+    heights = dict(zip(colors, RNG.permutation(np.array([2, 3, 4, 5], dtype=int)).tolist()))
+
