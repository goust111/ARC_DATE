+
+def _sample_bar_columns(width: int) -> list[int] | None:
+    choices = np.arange(1, width - 1, dtype=int)
+    if choices.size < 4:
+        return None
+    for _ in range(100):
+        cols = sorted(int(x) for x in RNG.choice(choices, size=4, replace=False))
+        if min(cols[i + 1] - cols[i] for i in range(3)) >= 2:
+            return cols
+    return None
