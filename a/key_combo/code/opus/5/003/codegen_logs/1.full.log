+def _desc_support(shape: tuple[int, int], diff: int) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    out: list[tuple[int, int]] = []
+    for c in range(w):
+        r = c + int(diff)
+        if 0 <= r < h:
+            out.append((int(r), int(c)))
+    return out
