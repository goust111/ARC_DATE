+def _find_separator_row(grid: np.ndarray) -> int:
+    h = int(grid.shape[0])
+    candidates = [
+        r
+        for r in range(1, h - 1)
+        if np.all(grid[r] == BG) and np.any(grid[:r] != BG) and np.any(grid[r + 1 :] != BG)
