+    diffs = {int(r - c) for r, c in coords}
+    sums = {int(r + c) for r, c in coords}
+
+    kinds: list[tuple[str, int]] = []
+    if len(rows) == 1:
+        kinds.append(("h", next(iter(rows))))
+    if len(cols) == 1:
