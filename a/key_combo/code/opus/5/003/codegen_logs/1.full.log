+
+    for color in depth_chain:
+        kind = orientation_for_color[int(color)]
+        for r, c in _line_cells(upper_shape, kind, int(param_for_kind[kind])):
+            inp[r, c] = int(color)
+
+    sep = upper_h
+    for color, col in zip(bars_left_to_right, cols):
+        height = int(heights[int(color)])
