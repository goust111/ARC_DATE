+BODY_COLORS = (RED, GREEN, YELLOW, PINK, TEAL)
+CONTROL_COLORS = {BLUE, MAROON}
+SPECIAL_COLORS = {BG, GREY, ORANGE}
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
