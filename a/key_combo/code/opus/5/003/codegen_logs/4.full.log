+def _collect_candidates(
+    shape: tuple[int, int],
+    markers: list[dict],
+    protected: set[tuple[int, int]],
+    obstacles: set[tuple[int, int]],
+) -> tuple[dict[tuple[int, int], tuple[int, int]], list[tuple[int, int, int, int]]]:
+    h, w = shape
+    chosen: dict[tuple[int, int], tuple[int, int]] = {}
