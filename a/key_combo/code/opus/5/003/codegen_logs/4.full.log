+                    "cross_index": cross_index,
+                    "center": cross["center"],
+                    "direction": direction,
+                    "dir_vec": DIRS[direction],
+                    "coords": tuple(sorted(marker_cells)),
+                    "body_color": body_color,
+                    "control_color": control_color,
+                    "control_pos": control_pos,
