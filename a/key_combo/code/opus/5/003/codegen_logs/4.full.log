+def _parse_scene(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    crosses = _find_crosses(g)
+    claimed: set[tuple[int, int]] = set()
+    allowed = set(range(10)) - SPECIAL_COLORS
+    markers: list[dict] = []
