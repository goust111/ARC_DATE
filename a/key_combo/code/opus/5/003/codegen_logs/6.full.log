+    anchor_hits = []
+    for seed_pos in seed_positions:
+        dists = [_bbox_distance_to_point(bbox, seed_pos) for bbox in anchor_bboxes]
+        best = min(dists)
+        if best > 2 or sum(int(d == best) for d in dists) != 1:
+            return False
+        anchor_hits.append(int(dists.index(best)))
