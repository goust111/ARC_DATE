+def _bbox_distance_to_point(bbox: tuple[int, int, int, int], point: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = map(int, bbox)
+    r, c = map(int, point)
+    if r < r0:
+        dr = r0 - r
+    elif r > r1:
+        dr = r - r1
+    else:
+        dr = 0
+    if c < c0:
+        dc = c0 - c
+    elif c > c1:
+        dc = c - c1
+    else:
+        dc = 0
+    return int(dr + dc)
+
