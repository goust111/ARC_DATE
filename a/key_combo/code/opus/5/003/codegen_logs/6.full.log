+        _unique_pairing(sprites, anchors)
+    except Exception:
+        return None
+
+    expected = _build_expected_output(shape, 0, records, seeds)
+    if not _validate_scene(inp, expected, records, seeds):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
