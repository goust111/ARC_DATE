+        rect = spec["rect"]
+        size = spec["size"]
+        rect_area = _bbox_area(rect)
+        if rect_area <= 4 * size[0] * size[1]:
+            return False
+        for box in _corner_boxes(rect, size):
+            r0, c0, r1, c1 = box
+            if not (0 <= r0 <= r1 < shape[0] and 0 <= c0 <= c1 < shape[1]):
+                return False
+            corner_boxes.append(box)
