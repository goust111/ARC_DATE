+            row = int(spec["priority"])
+            out[row, 0] = int(spec["anchor_color"])
+            out[row, 1] = int(spec["fill_color"])
+            for box in spec["input_corners"]:
+                _paint_rect(out, box, int(spec["anchor_color"]))
+        return out
