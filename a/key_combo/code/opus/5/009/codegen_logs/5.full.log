0068:             if (br, bc) == (1, 1):
0069:                 continue
0070:             src = crop_bbox(
0071:                 g,
0072:                 (
0073:                     int(r0) + br * block,
0074:                     int(c0) + bc * block,
0075:                     int(r0) + (br + 1) * block - 1,
0076:                     int(c0) + (bc + 1) * block - 1,
0077:                 ),
0078:             )
0079:             dst_r = expanded_r0 + (4 - 2 * br) * block
0080:             dst_c = expanded_c0 + (4 - 2 * bc) * block
0081:             paste(out, src, dst_r, dst_c)
