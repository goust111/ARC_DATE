0057:     h = int(r1 - r0 + 1)
0058:     w = int(c1 - c0 + 1)
0059:     assert h == w and h % 3 == 0, "motif must be a square 3x3 block grid"
0060:     block = h // 3
0061: 
0062:     out = g.copy()
0063:     expanded_r0 = int(r0) - block
0064:     expanded_c0 = int(c0) - block
0065: 
0066:     for br in range(3):
