+
+ANCHOR_COLORS = (Color.RED, Color.GREEN, Color.YELLOW)
+FILL_COLOR_POOL = (Color.BLUE, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON)
+GENERATE_RETRIES = 400
