+    touch_edge = rng.random() < 0.45
+    touch_anchor = int(rng.choice(ANCHOR_COLORS)) if touch_edge else None
+    touch_axis = rng.choice(("bottom", "right", "both")) if touch_edge else None
+
+    specs: list[dict] = []
+    for i, anchor_color in enumerate(ANCHOR_COLORS):
