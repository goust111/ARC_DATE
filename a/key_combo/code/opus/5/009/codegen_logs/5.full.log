+def _corner_boxes(rect: tuple[int, int, int, int], size: tuple[int, int]) -> list[tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = map(int, rect)
+    h, w = map(int, size)
+    return [
+        (r0, c0, r0 + h - 1, c0 + w - 1),
+        (r0, c1 - w + 1, r0 + h - 1, c1),
+        (r1 - h + 1, c0, r1, c0 + w - 1),
+        (r1 - h + 1, c1 - w + 1, r1, c1),
