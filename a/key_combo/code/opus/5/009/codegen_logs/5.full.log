0129: def _major_orbits(orbits, forced_minor, target_count):
0130:     """Enumerate all orbit subsets whose total pixel count equals target_count,
0131:     excluding orbits that contain any forced_minor coordinate, then pick one."""
0132:     forced_minor = set(forced_minor)
0133:     usable = [
0134:         idx for idx, orbit in enumerate(orbits)
0135:         if all(coord not in forced_minor for coord in orbit)
0136:     ]
0137:     choices = []
0138:     for mask in range(1 << len(usable)):
0139:         selected = set()
0140:         total = 0
0141:         for bit, idx in enumerate(usable):
0142:             if mask & (1 << bit):
0143:                 selected.add(idx)
0144:                 total += len(orbits[idx])
0145:         if total == target_count:
0146:             choices.append(selected)
0147:     assert choices, "unreachable symmetric majority count"
0148:     return random.choice(choices)
