+                    row += 1 + band_heights[idx + 1]
+            else:
+                height = rng.randint(9, 15)
+                width = rng.randint(max(10, 3 * n_lines + 2), 15)
+                local = np.full((height, width), BLUE, dtype=int)
+                band_widths = _split_lengths(rng, width - n_lines, n_lines + 1, minimum=2)
+                col = band_widths[0]
