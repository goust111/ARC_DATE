+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != target_area:
+            continue
