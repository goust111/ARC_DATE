+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TOP_COLORS = (GREEN, YELLOW, ORANGE)
+
+MAX_GEN_ATTEMPTS = 600
