+        right_shape = other_shape if matched_side == "left" else match_shape
+        lh, lw = _shape_dims(left_shape)
+        rh, rw = _shape_dims(right_shape)
+        width = lw + 1 + rw
+        min_height = max(lh, rh)
+        if min_height > width - 1:
