+    if int(comp["area"]) != 2 * (h + w) - 4:
+        return False
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1] == int(comp["color"])
+    want = np.zeros((h, w), dtype=bool)
+    want[0, :] = True
+    want[-1, :] = True
+    want[:, 0] = True
+    want[:, -1] = True
+    return bool(np.array_equal(patch, want))
