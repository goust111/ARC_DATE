+    survivor_placed = 1 + (1 if contained_count == 2 else 0)
+    survivors_needed = survivor_target - survivor_placed
+    while survivors_needed > 0:
+        bbox = _place_free_frame(h, w, reserved, min_h=4, max_h=8, min_w=4, max_w=8, min_c0=5)
