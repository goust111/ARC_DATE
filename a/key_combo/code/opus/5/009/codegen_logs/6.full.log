+    survivor_mask, ghost_mask = _build_masks((h, g.shape[1]), survivors, ghost_bboxes)
+    ray_details: dict[int, list[tuple[int, str, int]]] = {}
+    for color in sorted(structure["marker_rows"]):
+        rows = sorted(structure["marker_rows"][color])
