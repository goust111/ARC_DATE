+
+    reasons, _ghost_mask = _row_reasons(grid)
+    used_marker_rows: set[int] = set()
+    used_emitted_rows: set[int] = set()
+
+    ghost_pair = _find_marker_pair(
+        grid,
+        reasons,
+        require_ghost=True,
+        used_marker_rows=used_marker_rows,
+        used_emitted_rows=used_emitted_rows,
