+
+
+def _first_blocker(row: int, survivor_mask: np.ndarray, ghost_mask: np.ndarray) -> tuple[str, int]:
+    _h, w = survivor_mask.shape
+    for c in range(1, w):
+        if ghost_mask[row, c]:
+            return "ghost", c
+        if survivor_mask[row, c]:
+            return "object", c
