+        grid[r2, 0] = marker_colors[2]
+        used_marker_rows.update({r1, r2})
+        used_emitted_rows.update(seq)
+
+    if not _semantic_checks(grid):
+        return None
+
+    if np.array_equal(grid, out0):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid = _generate_case()
+        if grid is not None:
