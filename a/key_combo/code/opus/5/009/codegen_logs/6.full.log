+
+    return True
+
+
+def _generate_case() -> np.ndarray | None:
+    h = random.randint(19, 28)
+    w = random.randint(19, 28)
+    grid = np.zeros((h, w), dtype=int)
+
+    total_frames = random.choice([4, 5, 5, 6])
