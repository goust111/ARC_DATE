+    no_ghost = _render(grid, erase_contained=True, use_ghost=False)[0]
+    if np.array_equal(out, no_ghost):
+        return False
+
+    no_erase = _render(grid, erase_contained=False, use_ghost=False)[0]
+    if np.array_equal(out, no_erase):
+        return False
