+    if not backtrack(0):
+        return None
+
+    result = []
+    for idx, cand in enumerate(chosen):
+        assert cand is not None
+        result.append(
+            {
+                "color": int(colors[idx]),
+                "patch": np.asarray(masks[idx], dtype=bool),
+                "period": int(cand["period"]),
+                "ox": int(cand["ox"]),
+                "c1": int(cand["ox"]),
+            }
+        )
+    return result
