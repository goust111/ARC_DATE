+        return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int).copy()
+
+    def _components_from_mask(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+        h, w = mask.shape
+        seen = np.zeros_like(mask, dtype=bool)
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        if connectivity == 8:
+            steps += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+        comps: list[np.ndarray] = []
+        for r in range(h):
+            for c in range(w):
+                if not mask[r, c] or seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for dr, dc in steps:
+                        nr, nc = rr + dr, cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                comps.append(np.array(coords, dtype=int))
+        return comps
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        bg = int(bg)
+        palette = sorted(set(map(int, g.flatten())) - {bg}) if colors is None else [int(c) for c in colors if int(c) != bg]
+        out = []
+        if monochromatic:
+            for color in palette:
+                for coords in _components_from_mask(g == color, connectivity):
+                    if coords.shape[0] < int(min_area):
+                        continue
+                    r0 = int(coords[:, 0].min())
+                    c0 = int(coords[:, 1].min())
+                    r1 = int(coords[:, 0].max())
+                    c1 = int(coords[:, 1].max())
+                    out.append({"color": int(color), "coords": coords, "bbox": (r0, c0, r1, c1), "area": int(coords.shape[0])})
+            return out
+        for coords in _components_from_mask(g != bg, connectivity):
+            if coords.shape[0] < int(min_area):
+                continue
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
+            color = int(g[coords[0, 0], coords[0, 1]])
+            out.append({"color": color, "coords": coords, "bbox": (r0, c0, r1, c1), "area": int(coords.shape[0])})
+        return out
