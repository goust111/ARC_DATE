+            return None
+        r0, c0, r1, c1 = spec["bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = patch
+
+    if rng.random() < 0.5:
+        grid = np.fliplr(grid).copy()
+
+    _validate_generated(grid)
+    return grid
