+        touches_side = bool(np.any(cc == 0) or np.any(cc == w - 1))
+        touches_bottom = bool(np.any(rr == h - 1))
+        if touches_top and not touches_side and not touches_bottom:
+            regions.append({(int(r + r0), int(c + c0)) for r, c in pts})
+    return regions
+
