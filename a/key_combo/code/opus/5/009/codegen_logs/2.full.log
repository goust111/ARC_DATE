+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+MAGENTA = 6
+CYAN = 8
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
