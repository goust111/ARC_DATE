+def cavity_patch(height: int, width: int, neck_width: int, shift: int) -> tuple[np.ndarray, list[int], int]:
+    patch = np.zeros((height, width), dtype=int)
+    patch[:, 0] = BLUE
+    patch[:, -1] = BLUE
+    patch[-1, :] = BLUE
+    patch[0, :] = BLUE
