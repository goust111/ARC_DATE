+                    return False
+        else:
+            if body_vals != {BLUE}:
+                return False
+
+    if np.array_equal(grid, solved):
+        return False
+    if np.array_equal(raw_solved, solved):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = build_attempt()
