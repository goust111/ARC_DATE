+def gravity_drop(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    yellow_positions = [tuple(map(int, rc)) for rc in np.argwhere(out == YELLOW)]
+    out[out == YELLOW] = BG
