+    if not np.any(solved == CYAN):
+        return False
+    if not np.any(solved == MAGENTA):
+        return False
+
+    for i, info in enumerate(infos):
+        body_cells = [tuple(map(int, rc)) for rc in info["coords"]]
+        body_vals = {int(solved[r, c]) for r, c in body_cells}
+        if hits[i]:
+            if body_vals != {CYAN}:
