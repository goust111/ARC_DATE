+    for r, c in yellow_positions:
+        by_col.setdefault(c, []).append(r)
+    for c, rows in by_col.items():
+        for start_r in sorted(rows, reverse=True):
+            rr = int(start_r)
+            while rr + 1 < h and out[rr + 1, c] == BG:
+                rr += 1
+            out[rr, c] = YELLOW
+    return out
