+    hit_ids: set[int] = set()
+    bottom_cols: set[int] = set()
+    seen_starts: set[tuple[int, int]] = set()
+    q = deque((0, int(c)) for c in source_cols if 0 <= int(c) < W)
+
+    while q:
+        r, c = q.popleft()
+        state = (int(r), int(c))
+        if state in seen_starts:
+            continue
+        seen_starts.add(state)
+
+        rr = int(r)
+        cc = int(c)
+        if 0 <= rr < H and 0 <= cc < W:
+            water_mask[rr, cc] = True
+
+        while True:
