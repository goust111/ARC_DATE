+    if not np.array_equal(actual_out[grid == SHELF], grid[grid == SHELF]):
+        return False
+    if not np.array_equal(actual_out[grid == MARKER], grid[grid == MARKER]):
+        return False
+    if not np.all((actual_out == grid) | ((grid == BG) & (actual_out == WATER))):
