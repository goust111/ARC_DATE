+            if nr >= H:
+                bottom_cols.add(cc)
+                break
+
+            shelf = shelf_by_row.get(nr)
+            if shelf is not None and int(shelf["c0"]) <= cc <= int(shelf["c1"]):
+                sid = int(shelf["id"])
+                hit_ids.add(sid)
+                marker_count = int(shelf["marker_count"])
