+
+def _validate_grid(grid: np.ndarray) -> bool:
+    """Check explicit puzzle constraints plus non-degenerate parity semantics."""
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2:
+        return False
+    H, W = grid.shape
+    if max(H, W) > 30:
+        return False
