+    g = np.array(grid, dtype=int)
+    source_cols, shelves = _parse_model(g)
+    water_mask, _hit_ids, _bottom_cols = _simulate_model(g.shape, source_cols, shelves)
+    out = g.copy()
+    out[(g == BG) & water_mask] = WATER
+    return out
