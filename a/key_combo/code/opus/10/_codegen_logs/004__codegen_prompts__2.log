+def _interior_rows_overlap(r0a: int, h1: int, r0b: int, h2: int) -> bool:
+    return max(r0a + 1, r0b + 1) <= min(r0a + h1 - 2, r0b + h2 - 2)
+
+
+def _interior_cols_overlap(c0a: int, w1: int, c0b: int, w2: int) -> bool:
