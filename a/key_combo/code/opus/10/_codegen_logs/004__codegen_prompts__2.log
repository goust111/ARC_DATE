+        order = sorted((tuple(map(int, rc)) for rc in greens), key=lambda rc: (-rc[0], rc[1]))
+        delta = (1, 0)
+    elif direction == "up":
+        order = sorted((tuple(map(int, rc)) for rc in greens), key=lambda rc: (rc[0], rc[1]))
