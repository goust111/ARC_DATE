+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+SIDE_TO_DIR = {
+    "top": "right",
+    "right": "down",
+    "bottom": "left",
+    "left": "up",
+}
+
+OPPOSITE_DIR = {
+    "right": "left",
+    "left": "right",
+    "up": "down",
+    "down": "up",
+}
+
+GEN_ROWS_RANGE = (15, 20)
+GEN_COLS_RANGE = (15, 20)
+GEN_FRAME_COUNTS = (2, 3, 4)
+GEN_FRAME_SIDE_RANGE = (3, 7)
+GEN_MAX_ATTEMPTS = 500
