+    widths = [random.randint(1, axis - 1)]
+    for _ in range(active_h - 1):
+        step = random.choice((-2, -1, 0, 1, 2))
+        widths.append(max(1, min(axis - 1, widths[-1] + step)))
+    if all(w == axis - 1 for w in widths):
+        widths[random.randrange(active_h)] = axis - 2
+    return widths
