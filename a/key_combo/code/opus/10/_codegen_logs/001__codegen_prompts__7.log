+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+FRAME = 9
+PALETTE = (1, 2, 3, 5, 6, 7, 8)
+NEIGHBORS8 = [
+    (-1, -1), (-1, 0), (-1, 1),
+    (0, -1),           (0, 1),
