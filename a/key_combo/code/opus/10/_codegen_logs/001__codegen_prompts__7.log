+def _draw_plus(grid: np.ndarray, center: tuple[int, int], color: int) -> None:
+    r, c = center
+    grid[r, c] = YELLOW
+    grid[r - 1, c] = color
+    grid[r + 1, c] = color
+    grid[r, c - 1] = color
+    grid[r, c + 1] = color
+
+
+def _draw_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    target = grid[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BG
+    target[mask] = patch[mask]
