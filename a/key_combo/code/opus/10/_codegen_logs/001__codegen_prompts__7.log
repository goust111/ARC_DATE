+
+def _rect_free(used: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int) -> bool:
+    H, W = used.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(H, r0 + h + pad)
+    cc1 = min(W, c0 + w + pad)
