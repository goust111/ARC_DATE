+
+
+def _gen_attempt() -> np.ndarray | None:
+    H = random.randint(24, 30)
+    W = random.randint(24, 30)
+    grid = np.zeros((H, W), dtype=int)
+    used = np.zeros((H, W), dtype=bool)
+
+    sprite_count = random.choice((2, 3))
+    frame_count = random.choice((2, 3, 3, 4))
