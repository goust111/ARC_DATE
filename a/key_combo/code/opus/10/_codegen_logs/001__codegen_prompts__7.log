+        missing_map = {
+            "tl": (pos[0], pos[1]),
+            "tr": (pos[0], pos[1] + n - 1),
+            "bl": (pos[0] + n - 1, pos[1]),
+            "br": (pos[0] + n - 1, pos[1] + n - 1),
+        }
+        frames.append({"pos": pos, "missing_kind": missing_kind, "missing": missing_map[missing_kind]})
+
+    centers: list[tuple[int, int]] = []
+    for color in marker_colors:
