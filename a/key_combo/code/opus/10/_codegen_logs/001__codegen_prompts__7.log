+def _frame_patch(n: int, missing_kind: str) -> np.ndarray:
+    patch = np.zeros((n, n), dtype=int)
+    corners = {
+        "tl": (0, 0),
+        "tr": (0, n - 1),
+        "bl": (n - 1, 0),
+        "br": (n - 1, n - 1),
+    }
