+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _component_patch(comp: dict, color: int) -> np.ndarray:
