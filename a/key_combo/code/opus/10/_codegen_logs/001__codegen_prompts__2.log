+    painted = base.copy()
+    for r in range(h):
+        for c in range(w):
+            if base[r, c] == GREY:
+                continue
+            if (r, c) in marker_colors:
+                painted[r, c] = marker_colors[(r, c)]
+                continue
+            if not coverage[r][c]:
+                continue
+            painted[r, c] = RED if len(coverage[r][c]) >= 2 else next(iter(coverage[r][c]))
