+GRID_SIZE_RANGE = (13, 16)
+MARKER_COUNT_OPTIONS = (3, 4)
+MARKER_MARGIN = 2
+MARKER_MIN_GAP = 3
+WALL_COUNT_RANGE = (3, 4)
