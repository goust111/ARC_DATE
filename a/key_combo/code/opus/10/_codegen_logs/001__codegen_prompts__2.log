+                "size": len(cells),
+                "boundary_colors": set(boundary_colors) - ({RED} if red_counts_as_owner else set()),
+                "touches_red": touches_red,
+                "touches_grey": touches_grey,
+                "touches_edge": touches_edge,
+                "fill_color": None if fill_color == RED else fill_color,
+            }
+        )
