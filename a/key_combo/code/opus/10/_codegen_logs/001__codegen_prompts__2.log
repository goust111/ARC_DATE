+
+def _try_place_wall(
+    grid: np.ndarray,
+    markers: list[tuple[int, int, int]],
+    marker_index: int,
+    orientation: str,
+    side: str,
+    rng: random.Random,
+    preferred_values: list[int] | None = None,
+) -> bool:
+    h, w = grid.shape
+    r, c, _color = markers[marker_index]
+    marker_positions = {(mr, mc) for mr, mc, _ in markers}
