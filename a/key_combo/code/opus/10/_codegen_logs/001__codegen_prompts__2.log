+    marker_colors = {(r, c): color for r, c, color in markers}
+    coverage = [[set() for _ in range(w)] for _ in range(h)]
+    blocked_ray_count = 0
+
+    for r, c, color in markers:
+        for dr, dc in DIRS4:
+            rr, cc = r + dr, c + dc
+            while _in_bounds(base.shape, rr, cc):
+                if base[rr, cc] == GREY:
