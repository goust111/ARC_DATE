+
+
+def _cells_clear_for_wall(
+    grid: np.ndarray,
+    cells: list[tuple[int, int]],
+    marker_positions: set[tuple[int, int]],
+) -> bool:
+    h, w = grid.shape
+    wall_cells = set(map(tuple, np.argwhere(grid == GREY)))
+    for r, c in cells:
+        if not _in_bounds((h, w), r, c) or grid[r, c] != BLACK:
