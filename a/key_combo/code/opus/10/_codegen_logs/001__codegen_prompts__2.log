+    out = ray_grid.copy()
+    regions = []
+
+    for cells in _components(ray_grid == BLACK):
+        region_set = set(cells)
+        boundary_colors: set[int] = set()
+        touches_red = False
+        touches_grey = False
+        touches_edge = any(
+            r == 0 or c == 0 or r == ray_grid.shape[0] - 1 or c == ray_grid.shape[1] - 1
+            for r, c in cells
