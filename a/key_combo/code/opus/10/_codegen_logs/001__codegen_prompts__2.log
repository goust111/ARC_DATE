+        for r, c in cells:
+            for dr, dc in DIRS8:
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(ray_grid.shape, nr, nc) or (nr, nc) in region_set:
+                    continue
+                value = int(ray_grid[nr, nc])
+                if value == RED:
+                    touches_red = True
+                    if red_counts_as_owner:
