+from __future__ import annotations
+
+from collections import deque
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+MARKER_COLORS = (1, 3, 4, 6, 7, 8, 9)
