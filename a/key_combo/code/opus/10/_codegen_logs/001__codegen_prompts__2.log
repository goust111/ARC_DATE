+def _extract_markers(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    markers = []
+    for r, c in np.argwhere((grid != BLACK) & (grid != GREY) & (grid != RED)):
+        markers.append((int(r), int(c), int(grid[r, c])))
+    markers.sort()
