        out[:, c] = color
        out[r, c] = color

    for r1, _c1, _color1 in markers:
        for _r2, c2, _color2 in markers:
            if (r1, c2) not in marker_positions:
                out[r1, c2] = _GEN_CROSSING_COLOR

    for r, c, color in markers:
