+        cols = {c for _, c in comp}
+        if len(comp) < 2 or len(comp) > 4:
+            return False
+        if len(rows) != 1 and len(cols) != 1:
+            return False
+        if len(rows) == 1:
+            ordered = sorted(c for _, c in comp)
+            if ordered != list(range(ordered[0], ordered[-1] + 1)):
+                return False
+        if len(cols) == 1:
+            ordered = sorted(r for r, _ in comp)
+            if ordered != list(range(ordered[0], ordered[-1] + 1)):
