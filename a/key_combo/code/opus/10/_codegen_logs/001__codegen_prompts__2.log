+
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(*GRID_SIZE_RANGE)
+    w = rng.randint(*GRID_SIZE_RANGE)
+    marker_count = rng.choice(MARKER_COUNT_OPTIONS)
