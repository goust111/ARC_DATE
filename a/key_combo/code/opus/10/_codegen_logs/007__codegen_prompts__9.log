def _gen_paint_cell(r, c, orientation, H, W, color_a, color_b):
    if orientation == ORIENTATION_ROWS:
        top_dist = r
        bottom_dist = H - 1 - r
        if top_dist == bottom_dist:
            return None
        if top_dist < bottom_dist:
