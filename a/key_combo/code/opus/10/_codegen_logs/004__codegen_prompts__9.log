+        inner = patch[1:-1, 1:-1]
+        marker = np.argwhere(inner == MARKER)
+        assert marker.shape == (1, 2), "expected exactly one grey marker per frame"
+        mr, mc = map(int, marker[0])
+        h, w = inner.shape
+        corner_to_shift = {
