+
+    require_mismatch = (call_index % 3) != 1 or any(
+        meta[q]["count"] > 0 and meta[q]["contact_side"] != FILL_START_EDGE[q] for q in QUADRANT_ORDER
+    )
+    if not _metadata_ok(grid, meta, require_mismatch=require_mismatch):
