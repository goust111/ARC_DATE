0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """Overlay the colored contents of same-sized blank panels after removing the dominant separator color.
0012: 
0013:     Input structure
0014:     - The most common color is a separator surrounding several rectangular
0015:       panels made from a common blank color plus sparse colored marks.
0016:     - The panels are 4-connected regions of non-separator cells, and all panel
0017:       bounding boxes have the same shape.
0018:     Rule
0019:     - Create one blank panel of that common shape.
0020:     - For each input panel, copy every non-blank mark to the same relative
0021:       position in the output panel.
0022:     Key insight
0023:     - The large separator color is not part of the answer; the answer is the
0024:       transparent overlay of the small drawings inside its panels.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027: 
0028:     separator = get_bg(g)
0029:     panel_values = g[g != separator]
0030:     assert panel_values.size > 0
0031: 
0032:     counts = Counter(map(int, panel_values))
0033:     blank, blank_count = counts.most_common(1)[0]
0034:     assert all(blank_count > count for color, count in counts.items() if color != blank)
0035: 
0036:     panels = find_components(g, bg=separator, connectivity=4, monochromatic=False)
0037:     assert panels
0038: 
0039:     boxes = [panel["bbox"] for panel in panels]
0040:     panel_shapes = {(r1 - r0 + 1, c1 - c0 + 1) for r0, c0, r1, c1 in boxes}
0041:     assert len(panel_shapes) == 1
0042:     height, width = next(iter(panel_shapes))
0043: 
0044:     out = np.full((height, width), blank, dtype=int)
0045:     for r0, c0, r1, c1 in boxes:
0046:         patch = g[r0 : r1 + 1, c0 : c1 + 1]
0047:         assert patch.shape == (height, width)
0048:         assert np.all(patch != separator)
0049: 
0050:         mark_mask = patch != blank
0051:         assert np.any(mark_mask)
0052:         assert not np.any((out != blank) & mark_mask)
0053:         out[mark_mask] = patch[mark_mask]
0054: 
0055:     return out
