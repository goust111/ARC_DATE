+
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        count = 0
+        bar_cells: list[tuple[int, int]] = []
+        if active:
+            max_count = min(_fill_capacity(quadrant, height, width), width if orientation == "horizontal" else height)
