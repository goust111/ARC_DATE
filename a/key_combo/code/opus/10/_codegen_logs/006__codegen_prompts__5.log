+from __future__ import annotations
+
+import hashlib
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GRAY = 5
+ORANGE = 7
+
+QUADRANT_ORDER = ("TL", "TR", "BL", "BR")
+FILL_START_EDGE = {
+    "TL": "top",
+    "TR": "right",
+    "BL": "left",
+    "BR": "bottom",
+}
+
+_RNG = np.random.default_rng()
