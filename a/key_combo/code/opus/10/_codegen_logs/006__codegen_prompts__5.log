+
+        if expected["orientation"] == "horizontal":
+            horizontal_bars += 1
+            if expected["count"] > (c1 - c0 + 1):
+                return False
+        elif expected["orientation"] == "vertical":
+            vertical_bars += 1
+            if expected["count"] > (r1 - r0 + 1):
+                return False
+        else:
