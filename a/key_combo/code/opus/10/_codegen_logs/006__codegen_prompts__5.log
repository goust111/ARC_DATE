+
+
+def _generate_attempt(call_index: int) -> np.ndarray | None:
+    h = int(_RNG.choice(np.array([14, 16, 18, 20], dtype=int)))
+    w = int(_RNG.choice(np.array([14, 16, 18, 20], dtype=int)))
