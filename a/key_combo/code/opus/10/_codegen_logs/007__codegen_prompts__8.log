                cc=comps(holes)
                if len(cc)"'!=2: continue
                if any(any(r in (0,h-1) or c in (0,w-1) for r,c in comp) for comp in cc): continue
                bodymask=outer & ~holes
                if len(comps(bodymask))!=1: continue
                valid.append((h,w,key(np.argwhere(m1)),key(np.argwhere(m2)),a1,a2))
print('"'valid',len(valid))
# unique by full pattern
uniq={}
for item in valid:
    uniq.setdefault(item[:4], item)
print('unique',len(uniq))
# same-area/diff-area counts
same=sum(1 for v in uniq.values() if v[4]==v[5])
diff=sum(1 for v in uniq.values() if v[4]"'!=v[5])
