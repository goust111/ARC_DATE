+from __future__ import annotations
+
+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_MAX_ATTEMPTS = 400
