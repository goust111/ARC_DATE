import numpy as np
from itertools import product

def comps(mask):
    H,W=mask.shape
    seen=set(); out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or (r,c) in seen: continue
            stack=[(r,c)]; seen.add((r,c)); cur=[]
            while stack:
                x,y=stack.pop(); cur.append((x,y))
                for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and (nx,ny) not in seen:
                        seen.add((nx,ny)); stack.append((nx,ny))
            out.append(cur)
    return out

def key(coords):
    a=np.array(coords)
    a=a-a.min(0)
    return tuple(sorted(map(tuple,a)))

def variants(mask):
    outs=[]
    for k in range(4):
        m=np.rot90(mask,k)
        for cand in [m, np.fliplr(m)]:
            coords=np.argwhere(cand)
            coords=coords-coords.min(0)
            h,w=coords.max(0)+1
            arr=np.zeros((h,w),dtype=bool)
            arr[coords[:,0],coords[:,1]]=1
            if not any(np.array_equal(arr,o) for o in outs):
                outs.append(arr)
    return outs

base=[
    np.array([[1,1]],bool),
    np.array([[1,1,1]],bool),
    np.array([[1,0],[1,1]],bool),
    np.array([[1,1],[1,1]],bool),
    np.array([[1,1,1],[0,1,0]],bool),
    np.array([[1,0],[1,0],[1,1]],bool),
    np.array([[1,1,0],[0,1,1]],bool),
]
shapes=[]
for b in base:
    for v in variants(b):
        if not any(np.array_equal(v,s) for s in shapes):
            shapes.append(v)
print('shape count',len(shapes), 'areas', sorted({int(s.sum()) for s in shapes}))
valid=[]
for h in range(4,7):
  for w in range(4,7):
    if h*w>30: continue
    outer=np.ones((h,w),dtype=bool)
    for i,s1 in enumerate(shapes):
      for j,s2 in enumerate(shapes):
