+def _pack_items(items: list[dict], axis: str, bg: int) -> np.ndarray:
+    if axis == "horizontal":
+        ordered = sorted(items, key=lambda item: (item["marker_c"], item["marker_r"]))
+        return np.concatenate([item["piece"] for item in ordered], axis=1)
