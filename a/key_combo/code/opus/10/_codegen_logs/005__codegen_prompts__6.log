+        if seen_legend_idxs != {0, 1}:
+            return None
+
+    clip_width = _clip_visible_width(len(clip_entry["seq"]), int(clip_entry["anchor_idx"]), clip_side)
+    if not (2 <= clip_width < len(clip_entry["seq"])):
