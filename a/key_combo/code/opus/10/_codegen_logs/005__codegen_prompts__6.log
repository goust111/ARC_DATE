+    return grid
+
+
+def _validate_scene(grid: np.ndarray) -> bool:
+    try:
+        analysis = _analyze(grid)
+        out = _pack_items(analysis["items"], analysis["axis"], analysis["bg"])
+        if not np.array_equal(out, main(grid)):
+            return False
+    except Exception:
+        return False
