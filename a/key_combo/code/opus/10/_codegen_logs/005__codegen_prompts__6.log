+    if legend_count == 1:
+        lengths = (random.randint(4, 6),)
+    else:
+        lengths = random.choice(((3, 3), (3, 4), (4, 3), (3, 5), (5, 3), (4, 4), (4, 5), (5, 4)))
+    if sum(lengths) > len(PALETTE):
