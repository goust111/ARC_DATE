+    return _crop_non_bg(patch, bg)
+
+
+def _analyze(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _get_bg(g)
+    legends, markers = _parse_legends_and_markers(g, bg)
+    lookup = _legend_lookup(legends)
