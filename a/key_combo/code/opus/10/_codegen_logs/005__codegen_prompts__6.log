+    forced_vals = sorted(set(int(v) for v in forced))
+    if any(v < lo or v > hi for v in forced_vals):
+        return None
+    if len(forced_vals) > count:
+        return None
+    if any(b - a < min_gap for a, b in zip(forced_vals, forced_vals[1:])):
+        return None
