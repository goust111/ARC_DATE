+    for cell in mismatches:
+        r0, r1 = cell["row_region"]
+        c0, c1 = cell["col_region"]
+        region_in = grid[r0 : r1 + 1, c0 : c1 + 1]
+        region_out = out[r0 : r1 + 1, c0 : c1 + 1]
+        if np.any((region_in == BLACK) & (region_out != RED)):
