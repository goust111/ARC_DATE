    last_r, last_c = rr, cc
    for i in range(int(length)):
        r2 = rr + i * dr
        c2 = cc + i * dc
        if not (0 <= r2 < H and 0 <= c2 < W):
            if bool(clip):
                continue
            break
        if int(grid[r2, c2]) in stop_at:
            break
        grid[r2, c2] = col
        last_r, last_c = r2, c2
