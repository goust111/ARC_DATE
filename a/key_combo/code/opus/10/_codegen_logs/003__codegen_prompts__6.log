+def paste_transparent(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int = BG) -> None:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = patch.shape
+    dst_view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != int(transparent)
+    dst_view[mask] = patch[mask]
+
