+def _ray_cells(
+    node: Node,
+    direction: str,
+    by_row: dict[int, list[Node]],
+    by_col: dict[int, list[Node]],
+    shape: tuple[int, int],
+    row_pos: dict[int, int],
+    col_pos: dict[int, int],
