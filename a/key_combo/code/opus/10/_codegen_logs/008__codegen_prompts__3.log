+
+TEMPLATE_7 = {
+    "points": ((0, 0), (0, 1), (0, 2), (0, 3), (1, 0), (1, 1), (1, 3)),
+    "terminal_pairs": ((0, 2), (0, 3), (2, 5), (3, 5)),
